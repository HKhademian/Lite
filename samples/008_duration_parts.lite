/* A recording lasts 3661 seconds. How many hours, minutes, and seconds is that?
   Whole-number division finds complete units; remainder keeps what is left. */

total_seconds := 3661;

hours := total_seconds // 3600;           /* 1 hour */
seconds_after_hours := total_seconds % 3600;
minutes := seconds_after_hours // 60;     /* 1 minute */
seconds := seconds_after_hours % 60;      /* 1 second */
