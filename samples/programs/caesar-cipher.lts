/* ASCII Caesar cipher encoding and decoding through explicit alphabet lookup. */

io := import "core/io";
text := import "core/text";

upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
lower := "abcdefghijklmnopqrstuvwxyz";

shiftChar := fn(ch: String, shift: Int): String {
    ui := text.indexOfText(upper, ch, 0);
    if ui >= 0 {
        return text.at(upper, (ui + shift) % 26);
    }
    li := text.indexOfText(lower, ch, 0);
    if li >= 0 {
        return text.at(lower, (li + shift) % 26);
    }
    ch
}

caesar := fn(input: String, shift: Int): String {
    norm := ((shift % 26) + 26) % 26;
    size := text.length(input);
    var out := "";
    var i := 0;
    loop i < size {
        out = out + shiftChar(text.at(input, i), norm);
        i += 1;
    }
    out
}

plain := "Lite compiles cleanly!";
encoded := caesar(plain, 7);
decoded := caesar(encoded, -7);
io.outputLine("plain:", plain);
io.outputLine("shift +7:", encoded);
io.outputLine("decoded:", decoded);
