/* Deduplicate a sequence in O(n) using Set<String> and core/set. */
io := import "core/io";
set := import "core/set";

items := ["alpha", "beta", "alpha", "gamma", "beta", "delta"];
unique: mut Set<String>;
loop items as item {
    set.add(mut unique, item);
}

io.outputLine("count:", unique.size);
loop unique as item {
    io.outputLine(item);
}
