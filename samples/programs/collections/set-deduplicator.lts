/* Deduplicate a sequence in O(n) using Set<String> and type/set. */
io := import "core/io";

items := ["alpha", "beta", "alpha", "gamma", "beta", "delta"];
mut unique: Set<String>;
loop items as item {
    mut unique.add(item);
}

io.outputLine("count:", unique.size());
loop unique as item {
    io.outputLine(item);
}
