/* Word frequency counter using Map<String, Int> and core/map lookups. */
io := import "core/io";

words := ["lite", "map", "lite", "code", "map", "lite"];
mut counts: Map<String, Int>;
loop words as word {
    prev := counts.getOr(word, 0);
    counts[word] = prev + 1;
}

io.outputLine("unique:", counts.size());
loop counts as entry {
    io.outputLine(entry.key, entry.value);
}
