/* Prime generator filtering each candidate against previously found primes. */

io := import "core/io";
list := import "core/list";

primes: mut List<Int> = [];
var n := 2;
var count := 0;
loop n <= 50 {
    var prime := true;
    loop primes as p {
        if p * p > n { break; }
        if n % p == 0 {
            prime = false;
            break;
        }
    }
    if prime {
        list.pushBack(mut primes, n);
        count += 1;
    }
    n += 1;
}

io.outputLine("primes <= 50:", count);
io.outputLine("first:", primes[0], "last:", primes[count - 1]);
