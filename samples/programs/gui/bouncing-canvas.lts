/** Interactive desktop canvas demo with live vitals HUD (FPS, UPS, frame time, CPU time, RSS memory)
 * and runtime frame-cap controls (1=30fps, 2=60fps, 3=120fps, 0/u=uncapped, Esc/q=quit).
 *
 * Run natively (C11 macOS AppKit window):
 *   ./bin/lite run --target c samples/programs/gui/bouncing-canvas.lts
 *
 * Benchmark N frames uncapped:
 *   LITE_CANVAS_HEADLESS=1 ./bin/lite run --target c samples/programs/gui/bouncing-canvas.lts -- --bench 300 --uncapped
 */

canvas := import "extra/surface";
color := import "extra/color";
io := import "core/io";
proc := import "core/process";

roundInt := fn(v: Float): Int {
    if v <= 0.0 { return 0; }
    var hi := 1;
    loop hi < 1000000000 and hi <= v { hi = hi * 2; }
    var lo := 0;
    loop lo < hi {
        mid := (lo + hi + 1) / 2;
        if mid <= v + 0.5 { lo = mid; } else { hi = mid - 1; }
    }
    lo
};

fmt1 := fn(v: Float): String {
    tenths := roundInt(v * 10.0);
    whole := tenths / 10;
    frac := tenths - whole * 10;
    whole.toText() + "." + frac.toText()
};

args := io.inputArgs();
var capturePath := "";
var benchFrames := 0;
var initTargetFps := 60.0;
var i := 0;
loop i < args.length() {
    arg := args[i];
    if arg == "--capture" and i + 1 < args.length() {
        capturePath = args[i + 1];
        i = i + 2;
    } else if arg == "--bench" and i + 1 < args.length() {
        parsed := args[i + 1].toInt();
        if parsed.ok and parsed.value > 0 { benchFrames = parsed.value; }
        i = i + 2;
    } else if arg == "--fps" and i + 1 < args.length() {
        parsed := args[i + 1].toInt();
        if parsed.ok { initTargetFps = parsed.value * 1.0; }
        i = i + 2;
    } else if arg == "--uncapped" {
        initTargetFps = 0.0;
        i = i + 1;
    } else {
        i = i + 1;
    }
}
hlEnv := proc.envGet("LITE_CANVAS_HEADLESS");
if hlEnv.found and hlEnv.value == "1" and benchFrames == 0 and capturePath == "" {
    benchFrames = 1;
}

w := 640;
h := 400;
surface := canvas.open("LiteScript Canvas Demo", w, h);
if initTargetFps =!= 60.0 {
    canvas.setTargetFps(surface, initTargetFps);
}

bg := canvas.rgb(0.07, 0.09, 0.14);
grid := canvas.rgba(1.0, 1.0, 1.0, 0.08);
panel := canvas.rgba(0.11, 0.14, 0.22, 0.88);
accent := canvas.hsl(198.0, 0.85, 0.58);
warm := canvas.hsl(342.0, 0.82, 0.62);
mint := canvas.hsl(152.0, 0.72, 0.58);

var x1 := 140.0;
var y1 := 150.0;
var vx1 := 156.0;
var vy1 := 126.0;

var x2 := 460.0;
var y2 := 240.0;
var vx2 := -132.0;
var vy2 := -108.0;

/* Fixed-timestep simulation at 120 UPS decoupled from render FPS */
stepDt := 1.0 / 120.0;
var accumSec := 0.0;
var updateCount := 0;
var totalTimeSec := 0.0;
var hudTimerSec := 1.0;
var line1 := "FPS:0.0  UPS:0.0  FT:0.0MS  CAP:60";
var line2 := "CPU:0.0MS  MEM:0.0MB  KEYS:1/2/3/0";
var frame := 0;

loop true {
    inp := canvas.poll(surface);
    if not inp.open or inp.key == "Escape" or inp.key == "q" {
        break;
    }
    if inp.key == "1" { canvas.setTargetFps(surface, 30.0); hudTimerSec = 1.0; }
    else if inp.key == "2" { canvas.setTargetFps(surface, 60.0); hudTimerSec = 1.0; }
    else if inp.key == "3" { canvas.setTargetFps(surface, 120.0); hudTimerSec = 1.0; }
    else if inp.key == "0" or inp.key == "u" { canvas.uncapFrameRate(surface); hudTimerSec = 1.0; }

    vit := canvas.vitals(surface);
    frameSec := if vit.frameTimeMs > 0.0 {
        if vit.frameTimeMs > 100.0 { 0.1 } else { vit.frameTimeMs / 1000.0 }
    } else {
        stepDt
    };
    accumSec = accumSec + frameSec;
    totalTimeSec = totalTimeSec + frameSec;
    hudTimerSec = hudTimerSec + frameSec;
    var subSteps := 0;
    loop accumSec >= stepDt and subSteps < 8 {
        x1 = x1 + vx1 * stepDt;
        y1 = y1 + vy1 * stepDt;
        if x1 < 36.0 { x1 = 36.0; vx1 = 0.0 - vx1; }
        if x1 > 604.0 { x1 = 604.0; vx1 = 0.0 - vx1; }
        if y1 < 100.0 { y1 = 100.0; vy1 = 0.0 - vy1; }
        if y1 > 364.0 { y1 = 364.0; vy1 = 0.0 - vy1; }

        x2 = x2 + vx2 * stepDt;
        y2 = y2 + vy2 * stepDt;
        if x2 < 32.0 { x2 = 32.0; vx2 = 0.0 - vx2; }
        if x2 > 608.0 { x2 = 608.0; vx2 = 0.0 - vx2; }
        if y2 < 100.0 { y2 = 100.0; vy2 = 0.0 - vy2; }
        if y2 > 368.0 { y2 = 368.0; vy2 = 0.0 - vy2; }

        accumSec = accumSec - stepDt;
        updateCount = updateCount + 1;
        subSteps = subSteps + 1;
    }

    canvas.clear(surface, bg);

    var gx := 40.0;
    loop gx < 640.0 {
        canvas.strokeLine(surface, canvas.point(gx, 0.0), canvas.point(gx, 400.0), 1.0, grid);
        gx = gx + 40.0;
    }
    var gy := 40.0;
    loop gy < 400.0 {
        canvas.strokeLine(surface, canvas.point(0.0, gy), canvas.point(640.0, gy), 1.0, grid);
        gy = gy + 40.0;
    }

    /* Connecting beam and bouncing orbs */
    canvas.strokeLine(surface, canvas.point(x1, y1), canvas.point(x2, y2), 3.0, canvas.mix(accent, warm, 0.5));
    canvas.fillCircle(surface, canvas.point(x1, y1), 36.0, canvas.withAlpha(accent, 0.25));
    canvas.fillCircle(surface, canvas.point(x1, y1), 22.0, accent);
    canvas.fillCircle(surface, canvas.point(x2, y2), 32.0, canvas.withAlpha(warm, 0.25));
    canvas.fillCircle(surface, canvas.point(x2, y2), 18.0, warm);

    if inp.pointerX > 0.0 or inp.pointerY > 0.0 {
        pColor := if inp.pointerDown { color.YELLOW } else { canvas.withAlpha(canvas.WHITE, 0.7) };
        pRadius := if inp.pointerDown { 18.0 } else { 10.0 };
        canvas.fillCircle(surface, canvas.point(inp.pointerX, inp.pointerY), pRadius, pColor);
    }

    /* Live Vitals HUD (refreshed at 4 Hz to avoid per-frame string churn) */
    canvas.fillRect(surface, canvas.rect(14.0, 12.0, 612.0, 68.0), panel);
    canvas.strokeRect(surface, canvas.rect(14.0, 12.0, 612.0, 68.0), 2.0, accent);
    if hudTimerSec >= 0.25 {
        hudTimerSec = 0.0;
        ups := if totalTimeSec > 0.0 { updateCount / totalTimeSec } else { 0.0 };
        capLabel := if vit.targetFps <= 0.0 { "UNCAP" } else { roundInt(vit.targetFps).toText() };
        memMb := vit.memoryBytes / 1048576.0;
        line1 = "FPS:" + fmt1(vit.fps) + "  UPS:" + fmt1(ups) + "  FT:" + fmt1(vit.avgFrameTimeMs) + "MS  CAP:" + capLabel;
        line2 = "CPU:" + fmt1(vit.cpuTimeMs) + "MS  MEM:" + fmt1(memMb) + "MB  KEYS:1/2/3/0";
    }
    canvas.drawText(surface, line1, canvas.point(26.0, 24.0), 14.0, canvas.WHITE);
    canvas.drawText(surface, line2, canvas.point(26.0, 50.0), 14.0, mint);

    canvas.present(surface);
    frame = frame + 1;

    if capturePath =!= "" {
        cap := canvas.capture(surface, capturePath);
        if not cap.ok {
            io.errorLine("capture failed: " + cap.error);
            canvas.close(surface);
            io.exit(1);
        }
        io.outputLine("captured: " + capturePath);
        break;
    }
    if benchFrames > 0 and frame >= benchFrames {
        fin := canvas.vitals(surface);
        finUps := if totalTimeSec > 0.0 { updateCount / totalTimeSec } else { 0.0 };
        finCap := if fin.targetFps <= 0.0 { "uncapped" } else { fmt1(fin.targetFps) };
        io.outputLine("frames=" + fin.frameCount.toText() + " updates=" + updateCount.toText() +
        " fps=" + fmt1(fin.fps) + " ups=" + fmt1(finUps) +
        " frameMs=" + fmt1(fin.avgFrameTimeMs) + " cap=" + finCap +
        " cpuMs=" + fmt1(fin.cpuTimeMs) + " rssMb=" + fmt1(fin.memoryBytes / 1048576.0));
        break;
    }
}

canvas.close(surface);
