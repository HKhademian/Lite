/* Word frequency counter scanning tokens into a Map<String, Int>. */

io := import "core/io";

corpus := "lite is light and lite is explicit and clear";
size := corpus.length();
mut counts: Map<String, Int>;

var start := 0;
var pos := 0;
loop pos <= size {
    atEnd := pos == size;
    sep := if atEnd { true } else { corpus.at(pos) == " " };
    if sep {
        if pos > start {
            word := corpus.slice(start, pos);
            counts[word] = counts.getOr(word, 0) + 1;
        }
        start = pos + 1;
    }
    pos += 1;
}

loop counts as entry {
    io.outputLine(entry.key, ":", entry.value);
}
