/* Iterative Fibonacci sequence collected with loop `.collected` metadata. */

io := import "core/io";
tb := import "util/text-builder";

fibIter := fn(n: Int): Int {
    if n <= 1 { return n; }
    var prev := 0;
    var curr := 1;
    var step := 2;
    loop step <= n {
        next := prev + curr;
        prev = curr;
        curr = next;
        step += 1;
    }
    curr
}

terms := loop .count < 10 { fibIter(.count - 1) }.collected;

b: mut tb.TextBuilder;
loop terms {
    tb.append(mut b, (.item).toText());
}
io.outputLine("fib(0..9):", tb.buildJoined(b, ", "));
io.outputLine("fib(12):", fibIter(12));
