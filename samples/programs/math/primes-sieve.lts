/* Prime generator filtering each candidate against previously found primes. */

io := import "core/io";
list := import "core/list";

primes: mut List<Int> = [];
var n := 2;
loop n <= 50 {
    var prime := true;
    loop primes as p {
        if p * p > n { break; }
        if n % p == 0 {
            prime = false;
            break;
        }
    }
    if prime {
        list.pushBack(mut primes, n);
    }
    n += 1;
}

io.outputLine("primes <= 50:", primes.length());
io.outputLine("first:", primes[0], "last:", primes[primes.length() - 1]);
