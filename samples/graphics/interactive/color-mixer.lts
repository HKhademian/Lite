/* Interactive RGBA mixer: click/drag horizontal channel sliders or use Keys 1-4 + Arrows. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
map := import "core/map";
math := import "core/math";

ctx := canvas.play(width = 320, height = 200, title = "RGBA Color Mixer");
bg := canvas.rgb(13, 15, 24);

MixerState := record {
    activeChannel: Int;
    dragging: Bool;
};

channelKeys: Map<String, Int> = ["1" = 0, "2" = 1, "3" = 2, "4" = 3];
var channels: [Int; 4] = [110, 196, 230, 215];
var mixer := MixerState { activeChannel = 0, dragging = false };

setChannelFromX := fn(ch: Int, col: Int): Unit {
    channels[ch] = math.clampInt(((col - 26) * 255) / 160, 0, 255);
};

renderSlider := fn(idx: Int, y: Int, value: Int, barColor: canvas.Color): Unit {
    canvas.fillRect(26, y, 160, 14, canvas.rgba(255, 255, 255, 22));
    fillW := (value * 160) / 255;
    if fillW > 0 {
        canvas.fillRect(26, y, fillW, 14, barColor);
    }
    outline := if idx == mixer.activeChannel { canvas.rgb(255, 255, 255) } else { canvas.rgba(255, 255, 255, 48) };
    board.drawRect(26, y, 160, 14, outline);
    knobX := 26 + fillW;
    canvas.fillRect(knobX - 2, y - 3, 5, 20, canvas.rgb(248, 250, 252));
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(8, 8, ctx.width - 16, ctx.height - 16, canvas.rgba(255, 255, 255, 26));
    renderSlider(0, 32, channels[0], canvas.rgb(235, 108, 118));
    renderSlider(1, 68, channels[1], canvas.rgb(130, 210, 142));
    renderSlider(2, 104, channels[2], canvas.rgb(104, 186, 238));
    renderSlider(3, 140, channels[3], canvas.rgba(220, 226, 240, channels[3]));

    /* Checkerboard backdrop under preview swatch to visualize alpha blending */
    var cy := 32;
    loop cy < 154 {
        var cx := 208;
        loop cx < 292 {
            dark := ((cx / 14) + (cy / 14)) % 2 == 0;
            cell := if dark { canvas.rgb(34, 38, 52) } else { canvas.rgb(66, 72, 92) };
            canvas.fillRect(cx, cy, 14, 14, cell);
            cx += 14;
        }
        cy += 14;
    }
    mixed := canvas.rgba(channels[0], channels[1], channels[2], channels[3]);
    canvas.fillRect(208, 32, 84, 122, mixed);
    board.fillCircle(250, 93, 30, canvas.rgba(channels[0], channels[1], channels[2], 255));
    board.drawRect(208, 32, 84, 122, canvas.rgba(255, 255, 255, 90));
};

onCanvasInit := fn(): Unit {
    render();
};

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    _unusedBtn := button;
    if col >= 20 and col <= 194 {
        if row >= 26 and row <= 50 { mixer.activeChannel = 0; }
        else if row >= 62 and row <= 86 { mixer.activeChannel = 1; }
        else if row >= 98 and row <= 122 { mixer.activeChannel = 2; }
        else if row >= 134 and row <= 158 { mixer.activeChannel = 3; }
        mixer.dragging = true;
        setChannelFromX(mixer.activeChannel, col);
        render();
        audio.tone(frequency = 320 + (mixer.activeChannel * 80), durationMs = 45, volume = 12);
    }
};

onCanvasPointerMove := fn(col: Int, row: Int): Unit {
    _unusedRow := row;
    if mixer.dragging {
        setChannelFromX(mixer.activeChannel, col);
        render();
    }
};

onCanvasPointerUp := fn(col: Int, row: Int, button: Int): Unit {
    _unusedCol := col;
    _unusedRow := row;
    _unusedBtn := button;
    mixer.dragging = false;
};

onCanvasKeyDown := fn(key: String): Unit {
    hit := map.get(channelKeys, key);
    if hit.found {
        mixer.activeChannel = hit.value;
    } else if key == "ArrowUp" {
        mixer.activeChannel = (mixer.activeChannel + 3) % 4;
    } else if key == "ArrowDown" {
        mixer.activeChannel = (mixer.activeChannel + 1) % 4;
    } else if key == "ArrowLeft" or key == "ArrowRight" {
        delta := if key == "ArrowRight" { 16 } else { -16 };
        ch := mixer.activeChannel;
        channels[ch] = math.clampInt(channels[ch] + delta, 0, 255);
        audio.tone(frequency = 360 + (ch * 70), durationMs = 40, volume = 12);
    }
    render();
};

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
