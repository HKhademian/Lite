/* Zero-churn interactive particle fountain powered by ds/pool, ds/sparse, ds/arena, extra/canvas, and extra/audio. */

arena := import "ds/arena";
audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
pool := import "ds/pool";
sparse := import "ds/sparse";

ctx := canvas.play(width = 320, height = 200, title = "Particle Pool · Click/Space Burst");
bg := canvas.rgb(10, 14, 24);
MAX_PARTICLES := 128;

mut slots := pool.createSlots(MAX_PARTICLES);
mut active := sparse.create(MAX_PARTICLES);
mut frameScratch := arena.createTyped<Int>(MAX_PARTICLES);

/* Parallel component arrays indexed by SlotPool handle index (zero heap churn after startup). */
var hGen: mut List<Int> = [];
var px: mut List<Int> = [];
var py: mut List<Int> = [];
var vx: mut List<Int> = [];
var vy: mut List<Int> = [];
var life: mut List<Int> = [];
var maxLife: mut List<Int> = [];
var hueIdx: mut List<Int> = [];

var initIdx := 0;
loop initIdx < MAX_PARTICLES {
    mut hGen.pushBack(0);
    mut px.pushBack(0);
    mut py.pushBack(0);
    mut vx.pushBack(0);
    mut vy.pushBack(0);
    mut life.pushBack(0);
    mut maxLife.pushBack(1);
    mut hueIdx.pushBack(0);
    initIdx += 1;
}

var rng := 2463534242;
var acc := 0.0;
var tick := 0;

nextRand := fn(): Int {
    rng = ((rng * 1103515245) + 12345) % 2147483647;
    if rng < 0 { rng = 0 - rng; }
    rng
};

paletteColor := fn(idx: Int, alpha: Int): canvas.Color {
    c := idx % 4;
    if c == 0 { canvas.rgba(104, 196, 224, alpha) }
    else if c == 1 { canvas.rgba(240, 180, 90, alpha) }
    else if c == 2 { canvas.rgba(116, 220, 168, alpha) }
    else { canvas.rgba(238, 118, 134, alpha) }
};

spawnOne := fn(x: Int, y: Int, dx: Int, dy: Int, ttl: Int, colorIdx: Int): Unit {
    h := mut slots.acquire();
    if not h.isValid() { return; }
    i := h.index;
    mut hGen.setAt(i, h.generation);
    mut px.setAt(i, (x * 16) + (dx * 4));
    mut py.setAt(i, (y * 16) + (dy * 4));
    mut vx.setAt(i, dx);
    mut vy.setAt(i, dy);
    mut life.setAt(i, ttl);
    mut maxLife.setAt(i, if ttl < 1 { 1 } else { ttl });
    mut hueIdx.setAt(i, colorIdx);
    _ins := mut active.insert(i);
};

spawnBurst := fn(cx: Int, cy: Int, count: Int, chime: Bool): Unit {
    var k := 0;
    loop k < count {
        dx := (nextRand() % 49) - 24;
        dy := 0 - ((nextRand() % 38) + 12);
        ttl := 35 + (nextRand() % 45);
        spawnOne(cx, cy, dx, dy, ttl, k + tick);
        k += 1;
    }
    if chime {
        freqs: [Int; 5] = [392, 440, 523, 587, 659];
        audio.tone(frequency = freqs[nextRand() % 5], durationMs = 55, volume = 18);
    }
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(4, 4, ctx.width - 8, ctx.height - 8, canvas.rgba(255, 255, 255, 24));

    /* Pool occupancy bar at top */
    live := active.count();
    barW := (live * (ctx.width - 24)) / MAX_PARTICLES;
    canvas.fillRect(12, 10, ctx.width - 24, 5, canvas.rgba(255, 255, 255, 20));
    if barW > 0 {
        canvas.fillRect(12, 10, barW, 5, canvas.rgb(104, 196, 224));
    }

    /* Dense cache-friendly iteration over only active particle slots */
    loop 0..live as di {
        slotIdx := active.denseAt(di);
        x := px[slotIdx] / 16;
        y := py[slotIdx] / 16;
        alpha := 40 + ((life[slotIdx] * 215) / maxLife[slotIdx]);
        sz := if life[slotIdx] > (maxLife[slotIdx] / 2) { 4 } else { 3 };
        canvas.fillRect(x, y, sz, sz, paletteColor(hueIdx[slotIdx], alpha));
    }
};

onCanvasInit := fn(): Unit {
    if active.count() == 0 {
        spawnBurst(ctx.width / 2, ctx.height - 28, 36, false);
    }
    render();
};

onCanvasUpdate := fn(dt: Float): Int {
    acc += dt;
    if acc < 0.016 { return 0; }
    acc = 0.0;
    tick += 1;

    /* Continuous gentle fountain from bottom center */
    if (tick % 3) == 0 {
        spawnBurst(ctx.width / 2, ctx.height - 24, 3, false);
    }

    /* Reset O(1) frame scratch arena to record expiring slots */
    mut frameScratch.reset();
    live := active.count();
    loop 0..live as di {
        i := active.denseAt(di);
        nx := px[i] + vx[i];
        ny := py[i] + vy[i];
        nvy := vy[i] + 2;
        nl := life[i] - 1;
        if nl <= 0 or nx < 96 or nx > ((ctx.width - 10) * 16) or ny > ((ctx.height - 10) * 16) {
            _dead := mut frameScratch.alloc(i);
        } else {
            mut px.setAt(i, nx);
            mut py.setAt(i, ny);
            mut vy.setAt(i, nvy);
            mut life.setAt(i, nl);
        }
    }

    /* Reclaim expired slots back into SlotPool + SparseSet */
    deadCount := frameScratch.used();
    loop 0..deadCount as k {
        slotIdx := frameScratch.get(k);
        _rm := mut active.remove(slotIdx);
        _rel := mut slots.release(pool.Handle { index = slotIdx, generation = hGen[slotIdx] });
    }

    render();
    0
};

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    _btn := button;
    spawnBurst(col, row, 18, true);
    render();
};

onCanvasKeyDown := fn(key: String): Unit {
    if key == " " {
        spawnBurst(ctx.width / 2, ctx.height / 2, 28, true);
        render();
    }
};

spawnBurst(ctx.width / 2, ctx.height - 28, 36, false);
render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
