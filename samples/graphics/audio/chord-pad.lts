/* Polyphonic chord pad: click cards or press Keys 1-4 to sound C, F, G, or Am triads. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.play(width = 320, height = 180, title = "Chord Pad (320x180) · Click Cards or Keys 1-4");
bg := canvas.rgb(11, 14, 24);
padColors: List<canvas.Color> = [
canvas.rgb(104, 196, 224),
canvas.rgb(137, 206, 142),
canvas.rgb(240, 180, 92),
canvas.rgb(198, 152, 232),
];
roots: List<Int> = [262, 349, 392, 220];
thirds: List<Int> = [330, 440, 494, 262];
fifths: List<Int> = [392, 523, 587, 330];

var selected := 0;

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(8, 8, ctx.width - 16, ctx.height - 16, canvas.rgba(255, 255, 255, 26));
    var idx := 0;
    loop idx < 4 {
        x := 22 + (idx * 71);
        isSel := idx == selected;
        cardY := if isSel { 26 } else { 36 };
        cardH := if isSel { 126 } else { 116 };
        canvas.fillRect(x, cardY, 61, cardH, canvas.rgba(255, 255, 255, 18));
        canvas.fillRect(x + 4, cardY + 12, 53, 24, padColors[idx]);
        canvas.fillRect(x + 4, cardY + 46, 53, 24, padColors[idx]);
        canvas.fillRect(x + 4, cardY + 80, 53, 24, padColors[idx]);
        if isSel {
            board.drawRect(x, cardY, 61, cardH, canvas.rgb(255, 255, 255));
            canvas.fillRect(x + 8, 160, 45, 4, canvas.rgba(255, 255, 255, 210));
        } else {
            board.drawRect(x, cardY, 61, cardH, canvas.rgba(255, 255, 255, 40));
        }
        idx += 1;
    }
}

playChord := fn(idx: Int): Unit {
    selected = idx;
    render();
    audio.playNote((frequency = roots[idx], durationMs = 280, volume = 14));
    audio.playNote((frequency = thirds[idx], durationMs = 280, volume = 13));
    audio.playNote((frequency = fifths[idx], durationMs = 280, volume = 13));
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    voidBtn := button;
    if row >= 22 and row <= 160 {
        var idx := 0;
        loop idx < 4 {
            x := 22 + (idx * 71);
            if col >= x and col < x + 61 {
                playChord(idx);
                return;
            }
            idx += 1;
        }
    }
}

onCanvasKeyDown := fn(key: String): Unit {
    if key == "1" { playChord(0); }
    else if key == "2" { playChord(1); }
    else if key == "3" { playChord(2); }
    else if key == "4" { playChord(3); }
    else if key == "ArrowRight" { playChord((selected + 1) % 4); }
    else if key == "ArrowLeft" { playChord((selected + 3) % 4); }
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
