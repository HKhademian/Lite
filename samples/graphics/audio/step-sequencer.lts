/* 4x4 step sequencer: click pads to toggle notes on/off, Space pauses or resumes playhead. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
list := import "core/list";

ctx := canvas.play(width = 320, height = 200, title = "Step Sequencer (320x200) · Click Cells, Space Pause");
bg := canvas.rgb(10, 12, 22);
rowFreqs: List<Int> = [523, 392, 330, 262];
rowColors: List<canvas.Color> = [
canvas.rgb(240, 180, 90),
canvas.rgb(198, 152, 232),
canvas.rgb(137, 206, 142),
canvas.rgb(104, 196, 224),
];

/* Flattened 4 rows x 4 steps active pattern */
var cells: mut List<Bool> = [
true, false, false, true,
false, true, false, false,
false, false, true, false,
true, false, true, true,
];
var step := 0;
var playing := true;
var acc := 0.0;

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(8, 8, ctx.width - 16, ctx.height - 16, canvas.rgba(255, 255, 255, 26));
    var r := 0;
    loop r < 4 {
        y := 24 + (r * 38);
        var c := 0;
        loop c < 4 {
            x := 36 + (c * 64);
            active := cells[(r * 4) + c];
            isHead := c == step;
            fill := if active { rowColors[r] } else { canvas.rgba(255, 255, 255, 20) };
            canvas.fillRect(x, y, 52, 30, fill);
            if isHead {
                board.drawRect(x - 2, y - 2, 56, 34, canvas.rgba(255, 255, 255, 200));
            }
            c += 1;
        }
        r += 1;
    }
    statusCol := if playing { canvas.rgb(137, 206, 142) } else { canvas.rgba(255, 255, 255, 64) };
    board.fillCircle(20, 24, 5, statusCol);
}

toggleCell := fn(targetIdx: Int): Unit {
    next: mut List<Bool> = [];
    var i := 0;
    loop cells as val {
        list.pushBack(mut next, if i == targetIdx { not val } else { val });
        i += 1;
    }
    cells = next;
    render();
}

triggerColumn := fn(c: Int): Unit {
    var r := 0;
    loop r < 4 {
        if cells[(r * 4) + c] {
            audio.tone(frequency = rowFreqs[r], durationMs = 110, volume = 14);
        }
        r += 1;
    }
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasUpdate := fn(dt: Float): Int {
    if not playing { return 0; }
    acc = acc + dt;
    if acc >= 0.24 {
        acc = 0.0;
        step = (step + 1) % 4;
        triggerColumn(step);
        render();
    }
    0
}

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    voidBtn := button;
    var r := 0;
    loop r < 4 {
        y := 24 + (r * 38);
        if row >= y and row < y + 30 {
            var c := 0;
            loop c < 4 {
                x := 36 + (c * 64);
                if col >= x and col < x + 52 {
                    toggleCell((r * 4) + c);
                    audio.tone(frequency = rowFreqs[r], durationMs = 70, volume = 12);
                    return;
                }
                c += 1;
            }
        }
        r += 1;
    }
}

onCanvasKeyDown := fn(key: String): Unit {
    if key == " " {
        playing = not playing;
        render();
    }
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
