/* Interactive one-octave C-major keyboard: click keys or press 1-8 to sound pitches & glow bars. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.play(width = 320, height = 180, title = "Tone Keyboard · Click Keys or 1-8");
bg := canvas.rgb(12, 14, 24);
freqs: List<Int> = [262, 294, 330, 349, 392, 440, 494, 523];
var activeKey := 0;

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(8, 8, ctx.width - 16, ctx.height - 16, canvas.rgba(255, 255, 255, 24));
    /* Pitch bar meter across top */
    var i := 0;
    loop i < 8 {
        x := 20 + (i * 35);
        barH := 18 + (i * 5);
        barColor := if i == activeKey { canvas.rgb(240, 180, 92) } else { canvas.rgba(104, 196, 224, 90) };
        canvas.fillRect(x + 4, 62 - barH, 23, barH, barColor);

        /* Piano key below */
        keyColor := if i == activeKey { canvas.rgb(252, 236, 174) } else { canvas.rgb(232, 238, 248) };
        canvas.fillRect(x, 76, 31, 86, keyColor);
        board.drawRect(x, 76, 31, 86, canvas.rgb(42, 48, 66));
        if i == activeKey {
            canvas.fillRect(x + 6, 144, 19, 10, canvas.rgb(240, 152, 72));
        }
        i += 1;
    }
}

playNoteIdx := fn(idx: Int): Unit {
    activeKey = idx;
    render();
    audio.tone(frequency = freqs[idx], durationMs = 200, volume = 18);
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    voidBtn := button;
    if row >= 72 and row <= 168 {
        var i := 0;
        loop i < 8 {
            x := 20 + (i * 35);
            if col >= x and col < x + 31 {
                playNoteIdx(i);
                return;
            }
            i += 1;
        }
    }
}

onCanvasKeyDown := fn(key: String): Unit {
    if key == "1" { playNoteIdx(0); }
    else if key == "2" { playNoteIdx(1); }
    else if key == "3" { playNoteIdx(2); }
    else if key == "4" { playNoteIdx(3); }
    else if key == "5" { playNoteIdx(4); }
    else if key == "6" { playNoteIdx(5); }
    else if key == "7" { playNoteIdx(6); }
    else if key == "8" { playNoteIdx(7); }
    else if key == "ArrowRight" { playNoteIdx((activeKey + 1) % 8); }
    else if key == "ArrowLeft" { playNoteIdx((activeKey + 7) % 8); }
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
