/* High-res synth arpeggio: press Space to toggle playback, Arrows or Click pads to step. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.play(width = 320, height = 180, title = "Synth Arpeggio · Space or Click Pads");
bg := canvas.rgb(10, 12, 20);
frame := canvas.rgba(255, 255, 255, 28);
dimPad := canvas.rgba(255, 255, 255, 24);
specular := canvas.rgba(255, 255, 255, 65);
activeGlow := canvas.rgba(255, 255, 255, 220);
padColors: List<canvas.Color> = [
canvas.rgb(110, 196, 216),
canvas.rgb(137, 201, 131),
canvas.rgb(240, 180, 90),
canvas.rgb(198, 154, 232),
];
notes: List<audio.Note> = [
(frequency = 262, durationMs = 160, volume = 20),
(frequency = 330, durationMs = 160, volume = 20),
(frequency = 392, durationMs = 160, volume = 20),
(frequency = 523, durationMs = 200, volume = 22),
];

var stepIndex := 0;
var playing := false;
var elapsed := 0.0;
var spaceHeld := false;

drawPads := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(8, 8, ctx.width - 16, ctx.height - 16, frame);
    if playing {
        board.fillCircle(28, 26, 6, canvas.rgb(137, 201, 131));
    } else {
        board.fillCircle(28, 26, 6, canvas.rgba(255, 255, 255, 50));
    }
    var idx := 0;
    loop idx < 4 {
        x := 26 + (idx * 70);
        canvas.fillRect(x, 46, 54, 96, dimPad);
        if idx == stepIndex {
            canvas.fillRect(x, 42, 54, 100, padColors[idx]);
            canvas.fillRect(x + 4, 46, 46, 8, specular);
            canvas.fillRect(x + 6, 150, 42, 5, activeGlow);
        } else {
            canvas.fillRect(x, 66, 54, 76, padColors[idx]);
            canvas.fillRect(x + 4, 70, 46, 5, specular);
        }
        idx += 1;
    }
}

triggerStep := fn(): Unit {
    audio.playNote(notes[stepIndex]);
    drawPads();
}

onCanvasInit := fn(): Unit {
    drawPads();
}

onCanvasUpdate := fn(dt: Float): Int {
    if playing {
        elapsed = elapsed + dt;
        if elapsed >= 0.28 {
            elapsed = 0.0;
            stepIndex = (stepIndex + 1) % 4;
            triggerStep();
        }
    }
    0
}

onCanvasKeyDown := fn(key: String): Unit {
    if key == " " and not spaceHeld {
        spaceHeld = true;
        playing = not playing;
        elapsed = 0.0;
        if playing { triggerStep(); } else { drawPads(); }
    } else if key == "ArrowRight" or key == "d" {
        stepIndex = (stepIndex + 1) % 4;
        triggerStep();
    } else if key == "ArrowLeft" or key == "a" {
        stepIndex = (stepIndex + 3) % 4;
        triggerStep();
    }
}

onCanvasKeyUp := fn(key: String): Unit {
    if key == " " { spaceHeld = false; }
}

onCanvasPointerDown := fn(col: Int, row: Int, button: Int): Unit {
    voidBtn := button;
    if row >= 42 and row <= 156 {
        var idx := 0;
        loop idx < 4 {
            px := 26 + (idx * 70);
            if col >= px and col < px + 54 {
                stepIndex = idx;
                triggerStep();
                return;
            }
            idx += 1;
        }
    }
}

drawPads();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
