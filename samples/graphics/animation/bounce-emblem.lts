/* High-resolution bouncing ℓite emblem with RGBA halo and wall-bounce chimes. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.play(width = 320, height = 200, title = "Bounce · ℓite Mark");
bg := canvas.rgb(11, 14, 24);
gridTint := canvas.rgba(255, 255, 255, 10);
border := canvas.rgba(255, 255, 255, 36);
shadow := canvas.rgba(0, 0, 0, 115);
haloColors: List<canvas.Color> = [
canvas.rgba(240, 180, 90, 32),
canvas.rgba(110, 196, 216, 32),
canvas.rgba(137, 201, 131, 32),
canvas.rgba(198, 154, 232, 32),
];
palette: List<canvas.Color> = [
canvas.rgb(240, 180, 90),
canvas.rgb(110, 196, 216),
canvas.rgb(137, 201, 131),
canvas.rgb(198, 154, 232),
];
notes: List<Int> = [330, 392, 494, 587];
sprite: List<String> = [
"...##..",
"..#..#.",
"..#..#.",
".###...",
".#..#..",
".#..#..",
"..###..",
];
scale := 6;
spriteW := 7 * scale;
spriteH := 7 * scale;

var px := 32;
var py := 28;
var dx := 2;
var dy := 2;
var colorIdx := 0;
var acc := 0.0;

render := fn(): Unit {
    canvas.clear(bg);
    var gx := 40;
    loop gx < ctx.width {
        canvas.fillRect(gx, 2, 1, ctx.height - 4, gridTint);
        gx += 40;
    }
    var gy := 40;
    loop gy < ctx.height {
        canvas.fillRect(2, gy, ctx.width - 4, 1, gridTint);
        gy += 40;
    }
    board.drawRect(0, 0, ctx.width, ctx.height, border);
    board.fillCircle(px + (spriteW / 2), py + (spriteH / 2), 34, haloColors[colorIdx]);
    board.drawSpriteScaled(px + 4, py + 4, sprite, "#", scale, shadow);
    board.drawSpriteScaled(px, py, sprite, "#", scale, palette[colorIdx]);
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasUpdate := fn(dt: Float): Int {
    acc = acc + dt;
    if acc >= 0.016 {
        acc = 0.0;
        nx := px + dx;
        ny := py + dy;
        var bounced := false;
        if nx < 4 or nx > ctx.width - spriteW - 4 {
            dx = 0 - dx;
            bounced = true;
        } else {
            px = nx;
        }
        if ny < 4 or ny > ctx.height - spriteH - 4 {
            dy = 0 - dy;
            bounced = true;
        } else {
            py = ny;
        }
        if bounced {
            colorIdx = (colorIdx + 1) % 4;
            audio.tone(frequency = notes[colorIdx], durationMs = 70, volume = 14);
        }
        render();
    }
    0
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
