/* Grid snake mini-game: steer with Arrows or WASD, collect glowing fruit, Space restarts. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
rand := import "math/random";

tile := 16;
cols := 20;
rows := 12;
ctx := canvas.play(width = cols * tile, height = rows * tile, title = "Grid Snake · Arrows/WASD");
bg := canvas.rgb(10, 15, 22);

Cell := record {
    x: Int;
    y: Int;
};

Direction := enum {
    Up;
    Down;
    Left;
    Right;
};

GameStatus := enum {
    Playing;
    GameOver;
};

GameState := record {
    dir: Direction;
    food: Cell;
    rng: rand.Rng;
    status: GameStatus;
    acc: Float;
};

cellKey := fn(c: Cell): Int { (c.y * cols) + c.x };

dirDelta := fn(d: Direction): (dx: Int, dy: Int) {
    match d {
        .Up { (dx = 0, dy = -1) }
        .Down { (dx = 0, dy = 1) }
        .Left { (dx = -1, dy = 0) }
        .Right { (dx = 1, dy = 0) }
    }
};

isOpposite := fn(a: Direction, b: Direction): Bool {
    da := dirDelta(a);
    db := dirDelta(b);
    (da.dx + db.dx == 0) and (da.dy + db.dy == 0)
};

keyBindings: Map<String, Direction> = [
"ArrowUp" = .Up,
"w" = .Up,
"ArrowDown" = .Down,
"s" = .Down,
"ArrowLeft" = .Left,
"a" = .Left,
"ArrowRight" = .Right,
"d" = .Right,
];

snake: mut List<Cell> = [];
occupied: mut Set<Int>;

var state := GameState {
    dir = .Right,
    food = Cell { x = 14, y = 6 },
    rng = rand.Rng.create(7),
    status = .Playing,
    acc = 0.0
};

resetGame := fn(): Unit {
    mut snake.clear();
    mut occupied.clear();
    initial: List<Cell> = [Cell { x = 8, y = 6 }, Cell { x = 7, y = 6 }, Cell { x = 6, y = 6 }];
    loop initial as c {
        mut snake.pushBack(c);
        mut occupied.add(cellKey(c));
    }
    state = GameState {
        dir = .Right,
        food = Cell { x = 14, y = 6 },
        rng = state.rng,
        status = .Playing,
        acc = 0.0
    };
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(0, 0, ctx.width, ctx.height, canvas.rgba(255, 255, 255, 28));

    fx := (state.food.x * tile) + (tile / 2);
    fy := (state.food.y * tile) + (tile / 2);
    board.fillCircle(fx, fy, 7, canvas.rgba(240, 118, 128, 60));
    board.fillCircle(fx, fy, 5, canvas.rgb(240, 118, 128));

    var idx := 0;
    loop snake as seg {
        col := match state.status {
            .GameOver { canvas.rgb(214, 110, 118) }
            .Playing {
                if idx == 0 { canvas.rgb(154, 232, 162) } else { canvas.rgb(98, 186, 126) }
            }
        };
        canvas.fillRect((seg.x * tile) + 1, (seg.y * tile) + 1, tile - 2, tile - 2, col);
        idx += 1;
    }
};

endGame := fn(): Unit {
    state.status = .GameOver;
    state.acc = 0.0;
    audio.tone(frequency = 170, durationMs = 180, volume = 18);
    render();
};

onCanvasInit := fn(): Unit {
    render();
};

onCanvasUpdate := fn(dt: Float): Int {
    if state.status == .GameOver { return 0; }
    state.acc += dt;
    if state.acc < 0.14 { return 0; }
    state.acc = 0.0;

    head := snake[0];
    delta := dirDelta(state.dir);
    next := Cell { x = head.x + delta.dx, y = head.y + delta.dy };
    if next.x < 0 or next.x >= cols or next.y < 0 or next.y >= rows {
        endGame();
        return 0;
    }
    if occupied.has(cellKey(next)) {
        endGame();
        return 0;
    }

    ate := next.x == state.food.x and next.y == state.food.y;
    mut snake.pushFront(next);
    mut occupied.add(cellKey(next));
    if ate {
        rx := state.rng.rangeInt(1, cols - 1);
        ry := rx.next.rangeInt(1, rows - 1);
        state.food = Cell { x = rx.value, y = ry.value };
        state.rng = ry.next;
        audio.tone(frequency = 587, durationMs = 80, volume = 16);
    } else {
        tail := mut snake.popBack();
        _removed := mut occupied.remove(cellKey(tail));
    }
    render();
    0
};

onCanvasKeyDown := fn(key: String): Unit {
    if key == " " {
        resetGame();
        render();
        audio.tone(frequency = 440, durationMs = 60, volume = 14);
        return;
    }
    hit := keyBindings.get(key);
    if hit.found and not isOpposite(state.dir, hit.value) {
        state.dir = hit.value;
    }
};

resetGame();
render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
