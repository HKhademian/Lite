/* Classic two-paddle Pong: move left paddle with Up/Down, W/S, or pointer; Space resets scores. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
math := import "math/scalar";

ctx := canvas.play(width = 320, height = 200, title = "Paddle Pong · W/S or Arrows");
bg := canvas.rgb(10, 14, 24);
padW := 8;
padH := 42;

ServeSide := enum : Int {
    Left = -1;
    Right = 1;
};

Ball := record {
    x: Int;
    y: Int;
    dx: Int;
    dy: Int;
};

Score := record {
    left: Int;
    right: Int;
};

GameState := record {
    leftY: Int;
    rightY: Int;
    ball: Ball;
    score: Score;
    acc: Float;
};

serveBall := fn(side: ServeSide, prevDy: Int): Ball {
    Ball {
        x = ctx.width / 2,
        y = ctx.height / 2,
        dx = 3 * side.value,
        dy = if prevDy >= 0 { 2 } else { -2 }
    }
};

var state := GameState {
    leftY = 78,
    rightY = 78,
    ball = serveBall(.Right, 2),
    score = Score { left = 0, right = 0 },
    acc = 0.0
};

clampPad := fn(y: Int): Int {
    math.clampInt(y, 10, ctx.height - padH - 10)
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(4, 4, ctx.width - 8, ctx.height - 8, canvas.rgba(255, 255, 255, 28));

    /* Center dashed net */
    var ny := 12;
    loop ny < ctx.height - 12 {
        canvas.fillRect((ctx.width / 2) - 1, ny, 2, 8, canvas.rgba(255, 255, 255, 42));
        ny += 14;
    }

    /* Score pips */
    var s := 0;
    loop s < state.score.left and s < 8 {
        canvas.fillRect(40 + (s * 12), 14, 8, 5, canvas.rgb(104, 196, 224));
        s += 1;
    }
    s = 0;
    loop s < state.score.right and s < 8 {
        canvas.fillRect(ctx.width - 48 - (s * 12), 14, 8, 5, canvas.rgb(240, 180, 90));
        s += 1;
    }

    /* Paddles & ball */
    canvas.fillRect(18, state.leftY, padW, padH, canvas.rgb(104, 196, 224));
    canvas.fillRect(ctx.width - 18 - padW, state.rightY, padW, padH, canvas.rgb(240, 180, 90));
    board.fillCircle(state.ball.x, state.ball.y, 5, canvas.rgb(248, 250, 252));
};

onCanvasInit := fn(): Unit {
    render();
};

onCanvasUpdate := fn(dt: Float): Int {
    state.acc += dt;
    if state.acc < 0.02 { return 0; }
    state.acc = 0.0;

    var bx := state.ball.x + state.ball.dx;
    var by := state.ball.y + state.ball.dy;
    var bdx := state.ball.dx;
    var bdy := state.ball.dy;

    if by <= 10 or by >= ctx.height - 10 {
        bdy = -bdy;
        audio.tone(frequency = 320, durationMs = 30, volume = 10);
    }

    /* AI tracks ball vertically */
    target := by - (padH / 2);
    if target > state.rightY + 2 { state.rightY = clampPad(state.rightY + 2); }
    else if target < state.rightY - 2 { state.rightY = clampPad(state.rightY - 2); }

    if bdx < 0 and bx <= 18 + padW + 4 and bx >= 16 and by >= state.leftY - 4 and by <= state.leftY + padH + 4 {
        state.ball = Ball { x = bx, y = by, dx = -bdx, dy = bdy };
        audio.tone(frequency = 480, durationMs = 45, volume = 14);
    } else if bdx > 0 and bx >= ctx.width - 18 - padW - 4 and bx <= ctx.width - 16 and by >= state.rightY - 4 and by <= state.rightY + padH + 4 {
        state.ball = Ball { x = bx, y = by, dx = -bdx, dy = bdy };
        audio.tone(frequency = 420, durationMs = 45, volume = 14);
    } else if bx < 6 {
        state.score.right += 1;
        audio.tone(frequency = 220, durationMs = 120, volume = 16);
        state.ball = serveBall(.Right, bdy);
    } else if bx > ctx.width - 6 {
        state.score.left += 1;
        audio.tone(frequency = 660, durationMs = 120, volume = 16);
        state.ball = serveBall(.Left, bdy);
    } else {
        state.ball = Ball { x = bx, y = by, dx = bdx, dy = bdy };
    }

    render();
    0
};

onCanvasKeyDown := fn(key: String): Unit {
    if key == "ArrowUp" or key == "w" {
        state.leftY = clampPad(state.leftY - 14);
        render();
    } else if key == "ArrowDown" or key == "s" {
        state.leftY = clampPad(state.leftY + 14);
        render();
    } else if key == " " {
        state.ball = serveBall(.Right, state.ball.dy);
        state.score = Score { left = 0, right = 0 };
        state.acc = 0.0;
        render();
    }
};

onCanvasPointerMove := fn(col: Int, row: Int): Unit {
    _unusedCol := col;
    state.leftY = clampPad(row - (padH / 2));
};

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
