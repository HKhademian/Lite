/* Brick breaker game: move paddle with Left/Right or pointer; clear all 18 RGBA bricks! */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
math := import "core/math";

ctx := canvas.play(width = 320, height = 200, title = "Brick Breaker · Arrows or Pointer");
bg := canvas.rgb(11, 13, 24);
padW := 68;
brickRows := 3;
brickCols := 6;
brickCount := brickRows * brickCols;

brickColors: List<canvas.Color> = [
canvas.rgb(235, 114, 126),
canvas.rgb(240, 180, 92),
canvas.rgb(132, 210, 148),
];

Ball := record {
    x: Int;
    y: Int;
    dx: Int;
    dy: Int;
};

GameState := record {
    padX: Int;
    ball: Ball;
    acc: Float;
};

var bricks: mut List<Bool> = [];

resetBricks := fn(): Unit {
    bricks = loop .count < brickCount { true }.collected;
};

defaultBall := fn(): Ball {
    Ball { x = ctx.width / 2, y = 148, dx = 2, dy = -2 }
};

var state := GameState {
    padX = 126,
    ball = defaultBall(),
    acc = 0.0
};

clampPad := fn(x: Int): Int {
    math.clampInt(x, 10, ctx.width - padW - 10)
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(4, 4, ctx.width - 8, ctx.height - 8, canvas.rgba(255, 255, 255, 26));
    var r := 0;
    loop r < brickRows {
        var c := 0;
        loop c < brickCols {
            if bricks[(r * brickCols) + c] {
                x := 18 + (c * 48);
                y := 22 + (r * 20);
                canvas.fillRect(x, y, 42, 13, brickColors[r]);
                canvas.fillRect(x + 2, y + 2, 38, 3, canvas.rgba(255, 255, 255, 55));
            }
            c += 1;
        }
        r += 1;
    }
    canvas.fillRect(state.padX, 178, padW, 8, canvas.rgb(104, 196, 224));
    board.fillCircle(state.ball.x, state.ball.y, 5, canvas.rgb(248, 250, 252));
};

onCanvasInit := fn(): Unit {
    render();
};

onCanvasUpdate := fn(dt: Float): Int {
    state.acc += dt;
    if state.acc < 0.02 { return 0; }
    state.acc = 0.0;

    var bx := state.ball.x + state.ball.dx;
    var by := state.ball.y + state.ball.dy;
    var bdx := state.ball.dx;
    var bdy := state.ball.dy;

    if bx <= 10 or bx >= ctx.width - 10 {
        bdx = -bdx;
        audio.tone(frequency = 340, durationMs = 30, volume = 10);
    }
    if by <= 10 {
        bdy = -bdy;
        audio.tone(frequency = 380, durationMs = 30, volume = 10);
    }

    /* Check brick collision */
    var hitIdx := -1;
    var remaining := 0;
    var r := 0;
    loop r < brickRows {
        var c := 0;
        loop c < brickCols {
            idx := (r * brickCols) + c;
            if bricks[idx] {
                x := 18 + (c * 48);
                y := 22 + (r * 20);
                if hitIdx < 0 and bx >= x - 4 and bx <= x + 46 and by >= y - 4 and by <= y + 17 {
                    hitIdx = idx;
                    bdy = -bdy;
                    audio.tone(frequency = 440 + ((2 - r) * 110), durationMs = 60, volume = 15);
                } else {
                    remaining += 1;
                }
            }
            c += 1;
        }
        r += 1;
    }
    if hitIdx >= 0 {
        if remaining == 0 {
            resetBricks();
            audio.tone(frequency = 784, durationMs = 180, volume = 18);
        } else {
            bricks[hitIdx] = false;
        }
    }

    /* Paddle bounce or miss reset */
    if bdy > 0 and by >= 174 and by <= 184 and bx >= state.padX - 4 and bx <= state.padX + padW + 4 {
        bdy = -2;
        audio.tone(frequency = 300, durationMs = 40, volume = 13);
    } else if by > ctx.height - 6 {
        bx = ctx.width / 2;
        by = 148;
        bdy = -2;
        audio.tone(frequency = 196, durationMs = 110, volume = 14);
    }

    state.ball = Ball { x = bx, y = by, dx = bdx, dy = bdy };
    render();
    0
};

onCanvasKeyDown := fn(key: String): Unit {
    if key == "ArrowLeft" or key == "a" {
        state.padX = clampPad(state.padX - 18);
        render();
    } else if key == "ArrowRight" or key == "d" {
        state.padX = clampPad(state.padX + 18);
        render();
    } else if key == " " {
        resetBricks();
        state.ball = defaultBall();
        state.acc = 0.0;
        render();
    }
};

onCanvasPointerMove := fn(col: Int, row: Int): Unit {
    _unusedRow := row;
    state.padX = clampPad(col - (padW / 2));
};

resetBricks();
render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
