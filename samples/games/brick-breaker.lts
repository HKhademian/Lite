/* Brick breaker game: move paddle with Left/Right or pointer; clear all 18 RGBA bricks! */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";
list := import "core/list";

ctx := canvas.play(width = 320, height = 200, title = "Brick Breaker · Arrows or Pointer");
bg := canvas.rgb(11, 13, 24);
brickColors: List<canvas.Color> = [
canvas.rgb(235, 114, 126),
canvas.rgb(240, 180, 92),
canvas.rgb(132, 210, 148),
];

initBricks := fn(): List<Bool> {
    grid: mut List<Bool> = [];
    var i := 0;
    loop i < 18 {
        list.pushBack(mut grid, true);
        i += 1;
    }
    grid
}

var bricks := initBricks();
var padX := 126;
padW := 68;
var bx := 160;
var by := 148;
var bdx := 2;
var bdy := -2;
var acc := 0.0;

clampPad := fn(x: Int): Int {
    if x < 10 { 10 } else if x > ctx.width - padW - 10 { ctx.width - padW - 10 } else { x }
}

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(4, 4, ctx.width - 8, ctx.height - 8, canvas.rgba(255, 255, 255, 26));
    var r := 0;
    loop r < 3 {
        var c := 0;
        loop c < 6 {
            if bricks[(r * 6) + c] {
                x := 18 + (c * 48);
                y := 22 + (r * 20);
                canvas.fillRect(x, y, 42, 13, brickColors[r]);
                canvas.fillRect(x + 2, y + 2, 38, 3, canvas.rgba(255, 255, 255, 55));
            }
            c += 1;
        }
        r += 1;
    }
    canvas.fillRect(padX, 178, padW, 8, canvas.rgb(104, 196, 224));
    board.fillCircle(bx, by, 5, canvas.rgb(248, 250, 252));
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasUpdate := fn(dt: Float): Int {
    acc = acc + dt;
    if acc >= 0.02 {
        acc = 0.0;
        bx += bdx;
        by += bdy;
        if bx <= 10 or bx >= ctx.width - 10 {
            bdx = 0 - bdx;
            audio.tone(frequency = 340, durationMs = 30, volume = 10);
        }
        if by <= 10 {
            bdy = 0 - bdy;
            audio.tone(frequency = 380, durationMs = 30, volume = 10);
        }
        /* Check brick collision */
        var hitIdx := -1;
        var remaining := 0;
        var r := 0;
        loop r < 3 {
            var c := 0;
            loop c < 6 {
                idx := (r * 6) + c;
                if bricks[idx] {
                    x := 18 + (c * 48);
                    y := 22 + (r * 20);
                    if hitIdx < 0 and bx >= x - 4 and bx <= x + 46 and by >= y - 4 and by <= y + 17 {
                        hitIdx = idx;
                        bdy = 0 - bdy;
                        audio.tone(frequency = 440 + ((2 - r) * 110), durationMs = 60, volume = 15);
                    } else {
                        remaining += 1;
                    }
                }
                c += 1;
            }
            r += 1;
        }
        if hitIdx >= 0 {
            if remaining == 0 {
                bricks = initBricks();
                audio.tone(frequency = 784, durationMs = 180, volume = 18);
            } else {
                next: mut List<Bool> = [];
                var i := 0;
                loop bricks as alive {
                    list.pushBack(mut next, if i == hitIdx { false } else { alive });
                    i += 1;
                }
                bricks = next;
            }
        }
        /* Paddle bounce or miss reset */
        if bdy > 0 and by >= 174 and by <= 184 and bx >= padX - 4 and bx <= padX + padW + 4 {
            bdy = -2;
            audio.tone(frequency = 300, durationMs = 40, volume = 13);
        } else if by > ctx.height - 6 {
            bx = ctx.width / 2;
            by = 148;
            bdy = -2;
            audio.tone(frequency = 196, durationMs = 110, volume = 14);
        }
        render();
    }
    0
}

onCanvasKeyDown := fn(key: String): Unit {
    if key == "ArrowLeft" or key == "a" { padX = clampPad(padX - 18); render(); }
    else if key == "ArrowRight" or key == "d" { padX = clampPad(padX + 18); render(); }
    else if key == " " {
        bricks = initBricks();
        bx = ctx.width / 2;
        by = 148;
        bdy = -2;
        render();
    }
}

onCanvasPointerMove := fn(col: Int, row: Int): Unit {
    voidRow := row;
    padX = clampPad(col - (padW / 2));
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
