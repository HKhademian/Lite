/** Verifies every built HTML link, `#fragment` target, `search-index.json`, and `link-graph.json` in `dist/site/`. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
text := import "core/text";
intern := import "ds/intern";
challenges := import "util/challenges";
json := import "data/json";

replaceAllText := fn(source: String, needle: String, replacement: String): String {
    if source.indexOf(needle, 0) < 0 { return source; }
    nLen := needle.length();
    if nLen == 0 { return source; }
    sLen := source.length();
    mut out: List<String> = [];
    var pos := 0;
    loop pos < sLen {
        found := source.indexOf(needle, pos);
        if found < 0 {
            mut out.pushBack(source.slice(pos, sLen));
            break;
        }
        if found > pos {
            mut out.pushBack(source.slice(pos, found));
        }
        (mut out).pushBack(replacement);
        pos = found + nLen;
    }
    out.join("")
};

unescapeAttrEntities := fn(raw: String): String {
    if raw.indexOf("&", 0) < 0 { return raw; }
    var s := replaceAllText(raw, "&quot;", "\"");
    s = replaceAllText(s, "&#39;", "'");
    s = replaceAllText(s, "&gt;", ">");
    s = replaceAllText(s, "&lt;", "<");
    replaceAllText(s, "&amp;", "&")
};

hexVal := fn(ch: String): Int {
    idx := "0123456789abcdefABCDEF".indexOf(ch, 0);
    if idx < 0 { return -1; }
    if idx < 16 { idx } else { idx - 6 }
};

decodePercent := fn(raw: String, plusAsSpace: Bool): (ok: Bool, value: String) {
    if raw.indexOf("%", 0) < 0 and (not plusAsSpace or raw.indexOf("+", 0) < 0) {
        return (ok = true, value = raw);
    }
    n := raw.length();
    mut bytes: List<Int> = [];
    var i := 0;
    loop i < n {
        ch := raw.at(i);
        if ch == "%" {
            if i + 2 >= n { return (ok = false, value = ""); }
            hi := hexVal(raw.at(i + 1));
            lo := hexVal(raw.at(i + 2));
            if hi < 0 or lo < 0 { return (ok = false, value = ""); }
            (mut bytes).pushBack(hi * 16 + lo);
            i = i + 3;
        } else if plusAsSpace and ch == "+" {
            mut bytes.pushBack(32);
            i = i + 1;
        } else {
            enc := ch.utf8Encode();
            loop enc as b {
                mut bytes.pushBack(b);
            }
            i = i + 1;
        }
    }
    dec := String.fromUtf8Strict(bytes);
    if not dec.ok { return (ok = false, value = ""); }
    (ok = true, value = dec.text)
};

isWordChar := fn(ch: String): Bool {
    if ch == "_" { return true; }
    ch.isAsciiLetter() or ch.isDigit()
};

isSpaceChar := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
};

isExternalHref := fn(href: String): Bool {
    href.startsWithAt(0, "http://")
    or href.startsWithAt(0, "https://")
    or href.startsWithAt(0, "//")
    or href.startsWithAt(0, "mailto:")
    or href.startsWithAt(0, "tel:")
    or href.startsWithAt(0, "javascript:")
    or href.startsWithAt(0, "data:")
    or href.startsWithAt(0, "blob:")
};

/** Removes `<script ...>...</script>` and `<style ...>...</style>` blocks in O(n) without lowercasing clean HTML. */
stripScriptAndStyleBlocks := fn(html: String): String {
    hasUpper := html.indexOf("<S", 0) >= 0 or html.indexOf("</S", 0) >= 0;
    scan := if hasUpper { html.toLowerAscii() } else { html };
    if scan.indexOf("<script", 0) < 0 and scan.indexOf("<style", 0) < 0 {
        return html;
    }
    n := html.length();
    mut out: List<String> = [];
    var pos := 0;
    loop pos < n {
        sIdx := scan.indexOf("<script", pos);
        stIdx := scan.indexOf("<style", pos);
        var nextIdx := -1;
        var isScript := false;
        if sIdx >= 0 and (stIdx < 0 or sIdx < stIdx) {
            nextIdx = sIdx;
            isScript = true;
        } else if stIdx >= 0 {
            nextIdx = stIdx;
            isScript = false;
        }
        if nextIdx < 0 {
            mut out.pushBack(html.slice(pos, n));
            break;
        }
        tagLen := if isScript { 7 } else { 6 };
        afterTagPos := nextIdx + tagLen;
        /* Word boundary check: `<script\b` / `<style\b`. */
        if afterTagPos < n and isWordChar(scan.at(afterTagPos)) {
            mut out.pushBack(html.slice(pos, afterTagPos));
            pos = afterTagPos;
            continue;
        }
        openEnd := scan.indexOf(">", afterTagPos);
        if openEnd < 0 {
            mut out.pushBack(html.slice(pos, n));
            break;
        }
        closeTag := if isScript { "</script>" } else { "</style>" };
        closeIdx := scan.indexOf(closeTag, openEnd + 1);
        if closeIdx < 0 {
            mut out.pushBack(html.slice(pos, afterTagPos));
            pos = afterTagPos;
            continue;
        }
        if nextIdx > pos {
            mut out.pushBack(html.slice(pos, nextIdx));
        }
        pos = closeIdx + closeTag.length();
    }
    out.join("")
};

/** Collects all `\bid="([^"]+)"` values in `html` into a `\n`-delimited lookup blob. */
collectHtmlIdBlob := fn(html: String): String {
    mut out: List<String> = [];
    n := html.length();
    var pos := 0;
    loop pos < n {
        idx := html.indexOf("id=\"", pos);
        if idx < 0 { break; }
        if idx == 0 or not isWordChar(html.at(idx - 1)) {
            valStart := idx + 4;
            valEnd := html.indexOf("\"", valStart);
            if valEnd > valStart {
                mut out.pushBack(html.slice(valStart, valEnd));
                pos = valEnd + 1;
                continue;
            }
        }
        pos = idx + 4;
    }
    if out.length() == 0 { return ""; }
    "\n" + out.join("\n") + "\n"
};

/** Fast relative POSIX path resolution within site root (returns `(escaped: Bool, relPath: String)`). */
resolveRelInSite := fn(fromRelDir: String, noQuery: String): (escaped: Bool, relPath: String) {
    raw := if noQuery.startsWithAt(0, "/") {
        noQuery.slice(1, noQuery.length())
    } else if fromRelDir == "" {
        noQuery
    } else {
        fromRelDir + "/" + noQuery
    };
    rawWithIndex := if noQuery == "." or noQuery.endsWith("/") {
        if raw.endsWith("/") { raw + "index.html" } else { raw + "/index.html" }
    } else {
        raw
    };
    /* Fast path: no `.` segments and no `//` */
    if rawWithIndex.indexOf("..", 0) < 0 and rawWithIndex.indexOf("./", 0) < 0 and rawWithIndex.indexOf("//", 0) < 0 and not rawWithIndex.endsWith("/.") and rawWithIndex =!= "." {
        return (escaped = false, relPath = rawWithIndex);
    }
    mut segs: List<String> = [];
    rLen := rawWithIndex.length();
    var p := 0;
    loop p <= rLen {
        sl := rawWithIndex.indexOf("/", p);
        segEnd := if sl < 0 { rLen } else { sl };
        seg := rawWithIndex.slice(p, segEnd);
        if seg == "" or seg == "." {
            /* skip */
        } else if seg == ".." {
            if segs.length() == 0 {
                return (escaped = true, relPath = "");
            }
            _pop := mut segs.popBack();
        } else {
            mut segs.pushBack(seg);
        }
        if sl < 0 { break; }
        p = sl + 1;
    }
    (escaped = false, relPath = segs.join("/"))
};

parentRelDir := fn(relFile: String): String {
    n := relFile.length();
    var i := n - 1;
    loop i >= 0 {
        if relFile.at(i) == "/" {
            return relFile.slice(0, i);
        }
        i = i - 1;
    }
    ""
};

findSortedTextIndex := fn(sortedItems: List<String>, target: String): Int {
    var lo := 0;
    var hi := sortedItems.length() - 1;
    loop lo <= hi {
        mid := lo + (hi - lo) :/ 2;
        item := sortedItems[mid];
        if item == target { return mid; }
        if compareLex(item, target) < 0 { lo = mid + 1; } else { hi = mid - 1; }
    }
    -1
};

/** Extracts query parameter `key` (first occurrence) using URLSearchParams rules. */
getQueryParam := fn(queryStr: String, key: String): (found: Bool, value: String) {
    n := queryStr.length();
    var pos := 0;
    loop pos <= n {
        amp := queryStr.indexOf("&", pos);
        segEnd := if amp < 0 { n } else { amp };
        if segEnd > pos {
            seg := queryStr.slice(pos, segEnd);
            eq := seg.indexOf("=", 0);
            rawK := if eq < 0 { seg } else { seg.slice(0, eq) };
            rawV := if eq < 0 { "" } else { seg.slice(eq + 1, seg.length()) };
            decK := decodePercent(rawK, true);
            if decK.ok and decK.value == key {
                decV := decodePercent(rawV, true);
                if decV.ok {
                    return (found = true, value = decV.value);
                }
                return (found = true, value = rawV);
            }
        }
        if amp < 0 { break; }
        pos = amp + 1;
    }
    (found = false, value = "")
};

/** Collects all files under `absSiteDir` (relative POSIX paths). */
collectAllSiteFiles := fn(absSiteDir: String): List<String> {
    mut out: List<String> = [];
    if fs.kind(absSiteDir) =!= fs.FILE_KIND_DIR { return out; }
    mut stack: List<String> = [""];
    loop stack.length() > 0 {
        relDir := mut stack.popBack();
        absDir := if relDir == "" { absSiteDir } else { path.join(absSiteDir, relDir) };
        entries := fs.listDir(absDir);
        loop entries as entry {
            relPath := if relDir == "" { entry } else { relDir + "/" + entry };
            absPath := path.join(absSiteDir, relPath);
            if fs.kind(absPath) == fs.FILE_KIND_DIR {
                mut stack.pushBack(relPath);
            } else {
                mut out.pushBack(relPath);
            }
        }
    }
    out.sortTexts()
};

readOptStr := fn(src: String, objPos: Int, key: String): String {
    res := json.readFieldString(src, objPos, key);
    if res.found and res.ok { res.value } else { "" }
};

compareLex := fn(a: String, b: String): Int {
    la := a.length();
    lb := b.length();
    lim := if la < lb { la } else { lb };
    var i := 0;
    loop i < lim {
        ca := a.at(i);
        cb := b.at(i);
        if ca =!= cb {
            ba := ca.utf8Encode();
            bb := cb.utf8Encode();
            var k := 0;
            blim := if ba.length() < bb.length() { ba.length() } else { bb.length() };
            loop k < blim {
                if ba[k] < bb[k] { return -1; }
                if ba[k] > bb[k] { return 1; }
                k = k + 1;
            }
            return if ba.length() < bb.length() { -1 } else { 1 };
        }
        i = i + 1;
    }
    if la < lb { -1 } else if la > lb { 1 } else { 0 }
};

findSortedKeyIndex := fn(keys: List<String>, order: List<Int>, target: String): Int {
    var lo := 0;
    var hi := order.length() - 1;
    loop lo <= hi {
        mid := lo + (hi - lo) :/ 2;
        cmp := compareLex(keys[order[mid]], target);
        if cmp == 0 { return order[mid]; }
        if cmp < 0 { lo = mid + 1; } else { hi = mid - 1; }
    }
    -1
};

violationJson := fn(source: String, target: String, reason: String): String {
    "{\"source\":" + json.quoteString(source)
    + ",\"target\":" + json.quoteString(target)
    + ",\"reason\":" + json.quoteString(reason) + "}"
};

/** Validates all built site references in `siteDirRaw` and returns a JSON `SiteReferenceReport`. */
pub validateBuiltSiteReferencesJson := fn(siteDirRaw: String): String {
    absSiteDir := path.resolve(proc.cwd(), siteDirRaw);

    sortedSiteFiles := collectAllSiteFiles(absSiteDir);
    mut siteFileTable := intern.Interner.create();
    mut htmlFiles: List<String> = [];
    loop sortedSiteFiles as relFile {
        _sfId := mut siteFileTable.intern(relFile);
        if relFile.endsWith(".html") {
            mut htmlFiles.pushBack(relFile);
        }
    }

    /* Pre-read and strip all HTML files once, and store one `\n`-delimited ID blob per HTML file. */
    mut strippedHtmls: List<String> = [];
    mut htmlIdBlobs: List<String> = [];
    loop htmlFiles as relHtml {
        readRes := fs.readText(path.join(absSiteDir, relHtml));
        stripped := if readRes.ok { stripScriptAndStyleBlocks(readRes.text) } else { "" };
        mut strippedHtmls.pushBack(stripped);
        mut htmlIdBlobs.pushBack(collectHtmlIdBlob(stripped));
    }

    /* Load playground library targets if present. */
    hasSampleFilesDir := fs.kind(path.join(absSiteDir, "playground/samples")) == fs.FILE_KIND_DIR;
    hasPlayTargets := siteFileTable.has("playground/library.json");
    mut playAllIds := intern.Interner.create();
    mut playCatSample := intern.Interner.create();
    mut playCatExample := intern.Interner.create();
    mut playCatCase := intern.Interner.create();
    mut playCatPiece := intern.Interner.create();
    if hasPlayTargets {
        libRead := fs.readText(path.join(absSiteDir, "playground/library.json"));
        if libRead.ok {
            loop json.arrayOffsets(libRead.text, 0) as itemPos {
                itId := readOptStr(libRead.text, itemPos, "id");
                itSlug := readOptStr(libRead.text, itemPos, "slug");
                itCat := readOptStr(libRead.text, itemPos, "category");
                itSampleId := readOptStr(libRead.text, itemPos, "sampleId");
                if itId =!= "" { _a := mut playAllIds.intern(itId); }
                if itSlug =!= "" { _b := mut playAllIds.intern(itSlug); }
                if itSampleId =!= "" { _c := mut playCatSample.intern(itSampleId); }
                if itSlug =!= "" {
                    if itCat == "sample" { _d := mut playCatSample.intern(itSlug); }
                    else if itCat == "example" { _e := mut playCatExample.intern(itSlug); }
                    else if itCat == "case" { _f := mut playCatCase.intern(itSlug); }
                    else if itCat == "piece" { _g := mut playCatPiece.intern(itSlug); }
                }
            }
        }
    }

    mut violations: List<String> = [];
    var localLinksChecked := 0;
    var fragmentsChecked := 0;
    var searchEntriesChecked := 0;
    var graphNodesChecked := 0;
    var graphEdgesChecked := 0;

    hasHtmlFrag := fn(relHtml: String, rawFrag: String): Bool {
        hPos := findSortedTextIndex(htmlFiles, relHtml);
        if hPos < 0 { return false; }
        blob := htmlIdBlobs[hPos];
        if blob == "" { return false; }
        if blob.indexOf("\n" + rawFrag + "\n", 0) >= 0 {
            return true;
        }
        if rawFrag.indexOf("%", 0) >= 0 {
            dec := decodePercent(rawFrag, false);
            if dec.ok and blob.indexOf("\n" + dec.value + "\n", 0) >= 0 {
                return true;
            }
        }
        false
    };

    checkLocalTarget := fn(
    source: String,
    rawTarget: String,
    fromRelFile: String,
    fromRelDir: String,
    missingFileReason: String,
    missingFragReason: String
    ): Int {
        decoded := unescapeAttrEntities(rawTarget.trim());
        if decoded == "" or isExternalHref(decoded) { return 0; }

        hashIdx := decoded.indexOf("#", 0);
        pathAndQuery := if hashIdx >= 0 { decoded.slice(0, hashIdx) } else { decoded };
        rawFrag := if hashIdx >= 0 { decoded.slice(hashIdx + 1, decoded.length()) } else { "" };
        if pathAndQuery.indexOf("playground?", 0) >= 0 {
            mut violations.pushBack(violationJson(source, rawTarget, "bad-playground-href"));
        }

        qIdx := pathAndQuery.indexOf("?", 0);
        noQuery := if qIdx >= 0 { pathAndQuery.slice(0, qIdx) } else { pathAndQuery };
        resolved := if noQuery == "" {
            (escaped = false, relPath = fromRelFile)
        } else {
            resolveRelInSite(fromRelDir, noQuery)
        };
        relToSite := resolved.relPath;
        exists := if resolved.escaped {
            false
        } else if siteFileTable.has(relToSite) {
            true
        } else {
            fs.kind(path.join(absSiteDir, relToSite)) =!= fs.FILE_KIND_MISSING
        };
        if not exists {
            mut violations.pushBack(violationJson(source, rawTarget, missingFileReason));
            return 0;
        }

        var fragHit := 0;
        if rawFrag =!= "" and relToSite.endsWith(".html") {
            fragHit = 1;
            if not hasHtmlFrag(relToSite, rawFrag) {
                mut violations.pushBack(violationJson(source, rawTarget, missingFragReason));
            }
        }

        if relToSite == "playground/index.html" and qIdx >= 0 {
            queryStr := pathAndQuery.slice(qIdx + 1, pathAndQuery.length());
            sampleParam := getQueryParam(queryStr, "sample");
            if sampleParam.found and sampleParam.value =!= "" {
                sampleJsonOk := hasSampleFilesDir and siteFileTable.has("playground/samples/" + sampleParam.value + ".json");
                libSampleOk := hasPlayTargets and playCatSample.has(sampleParam.value);
                if (hasSampleFilesDir or hasPlayTargets) and not sampleJsonOk and not libSampleOk {
                    mut violations.pushBack(violationJson(source, rawTarget, "missing-play-target"));
                }
            }
            if hasPlayTargets {
                exParam := getQueryParam(queryStr, "example");
                if exParam.found and exParam.value =!= "" and not playCatExample.has(exParam.value) {
                    mut violations.pushBack(violationJson(source, rawTarget, "missing-play-target"));
                }
                caseParam := getQueryParam(queryStr, "case");
                if caseParam.found and caseParam.value =!= "" and not playCatCase.has(caseParam.value) {
                    mut violations.pushBack(violationJson(source, rawTarget, "missing-play-target"));
                }
                pieceParam := getQueryParam(queryStr, "piece");
                if pieceParam.found and pieceParam.value =!= "" and not playCatPiece.has(pieceParam.value) {
                    mut violations.pushBack(violationJson(source, rawTarget, "missing-play-target"));
                }
                itemParam := getQueryParam(queryStr, "item");
                if itemParam.found and itemParam.value =!= "" and not playAllIds.has(itemParam.value) {
                    mut violations.pushBack(violationJson(source, rawTarget, "missing-play-target"));
                }
            }
        }
        fragHit
    };

    /* 1. Scan all HTML files for unresolved attributes, href="...", and data-play-href="...". */
    htmlCount := htmlFiles.length();
    var hIdx := 0;
    loop hIdx < htmlCount {
        relSource := htmlFiles[hIdx];
        relDir := parentRelDir(relSource);
        stripped := strippedHtmls[hIdx];

        if stripped.indexOf(" data-md-href=", 0) >= 0 {
            mut violations.pushBack(violationJson(relSource, "data-md-href", "unresolved-md-href"));
        }
        if stripped.indexOf(" data-lite-uri=", 0) >= 0 {
            mut violations.pushBack(violationJson(relSource, "data-lite-uri", "unresolved-lite-uri"));
        }

        sLen := stripped.length();
        var pos := 0;
        loop pos < sLen {
            idx := stripped.indexOf("href=\"", pos);
            if idx < 0 { break; }
            okPrev := if idx == 0 {
                true
            } else {
                prevCh := stripped.at(idx - 1);
                isSpaceChar(prevCh) or prevCh == "<"
            };
            valStart := idx + 6;
            valEnd := stripped.indexOf("\"", valStart);
            if valEnd < 0 { break; }
            if okPrev {
                rawHref := stripped.slice(valStart, valEnd);
                trimmed := rawHref.trim();
                if trimmed =!= "" and trimmed =!= "#" and not isExternalHref(trimmed) {
                    localLinksChecked = localLinksChecked + 1;
                    fragmentsChecked = fragmentsChecked + checkLocalTarget(relSource, rawHref, relSource, relDir, "missing-file", "missing-fragment");
                }
            }
            pos = valEnd + 1;
        }

        var pPos := 0;
        loop pPos < sLen {
            idx := stripped.indexOf("data-play-href=\"", pPos);
            if idx < 0 { break; }
            valStart := idx + 16;
            valEnd := stripped.indexOf("\"", valStart);
            if valEnd < 0 { break; }
            rawPlayHref := stripped.slice(valStart, valEnd);
            trimmed := rawPlayHref.trim();
            if trimmed =!= "" and not isExternalHref(trimmed) {
                localLinksChecked = localLinksChecked + 1;
                fragmentsChecked = fragmentsChecked + checkLocalTarget(relSource, rawPlayHref, relSource, relDir, "missing-file", "missing-fragment");
            }
            pPos = valEnd + 1;
        }

        hIdx = hIdx + 1;
    }

    /* 2. Check search-index.json. */
    if not siteFileTable.has("search-index.json") {
        mut violations.pushBack(violationJson("search-index.json", "search-index.json", "missing-file"));
    } else {
        searchRead := fs.readText(path.join(absSiteDir, "search-index.json"));
        if searchRead.ok {
            loop json.arrayOffsets(searchRead.text, 0) as ePos {
                href := readOptStr(searchRead.text, ePos, "href");
                if href == "" { continue; }
                searchEntriesChecked = searchEntriesChecked + 1;
                fragmentsChecked = fragmentsChecked + checkLocalTarget("search-index.json", href, "index.html", "", "missing-file", "missing-fragment");
            }
        }
    }

    /* 3. Check link-graph.json. */
    if not siteFileTable.has("link-graph.json") {
        mut violations.pushBack(violationJson("link-graph.json", "link-graph.json", "missing-file"));
    } else {
        graphRead := fs.readText(path.join(absSiteDir, "link-graph.json"));
        if graphRead.ok {
            gText := graphRead.text;
            mut nodeUris: List<String> = [];
            mut nodeOutPaths: List<String> = [];
            nodesField := json.findField(gText, 0, "nodes");
            if nodesField.found {
                loop json.arrayOffsets(gText, nodesField.valuePos) as nPos {
                    uri := readOptStr(gText, nPos, "uri");
                    outPath := readOptStr(gText, nPos, "outPath");
                    graphNodesChecked = graphNodesChecked + 1;
                    if uri == "" or outPath == "" {
                        tName := if uri =!= "" { uri } else { "(unnamed-node)" };
                        mut violations.pushBack(violationJson("link-graph.json", tName, "missing-graph-node"));
                        continue;
                    }
                    (mut nodeUris).pushBack(uri);
                    mut nodeOutPaths.pushBack(outPath);
                    fragmentsChecked = fragmentsChecked + checkLocalTarget("link-graph.json (" + uri + ")", outPath, "index.html", "", "missing-graph-node", "missing-graph-fragment");
                }
            }
            nodeOrder := challenges.sortIndexByKeys(nodeUris);

            edgesField := json.findField(gText, 0, "edges");
            if edgesField.found {
                loop json.arrayOffsets(gText, edgesField.valuePos) as ePos {
                    graphEdgesChecked = graphEdgesChecked + 1;
                    fromUri := readOptStr(gText, ePos, "from");
                    toUri := readOptStr(gText, ePos, "to");
                    if findSortedKeyIndex(nodeUris, nodeOrder, fromUri) < 0 {
                        mut violations.pushBack(violationJson("link-graph.json", fromUri, "dangling-graph-edge"));
                    }
                    toIdx := findSortedKeyIndex(nodeUris, nodeOrder, toUri);
                    if toIdx < 0 {
                        mut violations.pushBack(violationJson("link-graph.json", toUri, "dangling-graph-edge"));
                        continue;
                    }
                    frag := readOptStr(gText, ePos, "fragment");
                    toOut := nodeOutPaths[toIdx];
                    hPos := toOut.indexOf("#", 0);
                    baseOut := if hPos >= 0 { toOut.slice(0, hPos) } else { toOut };
                    if frag =!= "" and baseOut =!= "" {
                        fragmentsChecked = fragmentsChecked + checkLocalTarget("link-graph.json (" + fromUri + " -> " + toUri + ")", baseOut + "#" + frag, "index.html", "", "missing-graph-node", "missing-graph-fragment");
                    }
                }
            }
        }
    }

    "{"
    + "\"htmlFiles\":" + htmlCount.toText() + ","
    + "\"localLinksChecked\":" + localLinksChecked.toText() + ","
    + "\"fragmentsChecked\":" + fragmentsChecked.toText() + ","
    + "\"searchEntriesChecked\":" + searchEntriesChecked.toText() + ","
    + "\"graphNodesChecked\":" + graphNodesChecked.toText() + ","
    + "\"graphEdgesChecked\":" + graphEdgesChecked.toText() + ","
    + "\"violations\":[" + violations.join(",") + "]"
    + "}"
};
