/** Collects Samples, Examples, Cases, and Pieces into Playground `library.json` (`site/playground-library.ts`). */

fs := import "core/file";
path := import "core/path";
text := import "core/text";
challenges := import "util/challenges";
json := import "util/json";

hostModuleIdentity := fn(identities: List<String>, texts: List<String>, candidate: String): String {
    var i := 0;
    n := identities.length();
    loop i < n {
        if candidate == texts[i] {
            return identities[i];
        }
        i = i + 1;
    }
    ""
};

isWhitespaceChar := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
};

/** Detects whether Lite source requires CLI or Play runtime features beyond universal stdlib. */
pub detectSourceEnvironment := fn(source: String): String {
    len := source.length();
    var pos := 0;
    loop pos < len {
        impPos := source.indexOf("import", pos);
        if impPos < 0 { break; }
        var p := impPos + 6;
        if p < len and isWhitespaceChar(source.at(p)) {
            loop p < len and isWhitespaceChar(source.at(p)) { p = p + 1; }
            if source.startsWithAt(p, "\"core/file\"")
            or source.startsWithAt(p, "\"core/path\"")
            or source.startsWithAt(p, "\"core/process\"")
            or source.startsWithAt(p, "\"core/time\"") {
                return "cli";
            }
            if source.startsWithAt(p, "\"extra/canvas\"")
            or source.startsWithAt(p, "\"extra/audio\"")
            or source.startsWithAt(p, "\"extra/board\"") {
                return "play";
            }
        }
        pos = impPos + 6;
    }
    "universal"
};

walkFilesWithSuffix := fn(absDir: String, relBase: String, suffix: String): List<String> {
    out: mut List<String> = [];
    if fs.kind(absDir) =!= fs.FILE_KIND_DIR { return out; }
    names := challenges.sortTexts(fs.listDir(absDir));
    loop names as name {
        full := path.join(absDir, name);
        rel := relBase + "/" + name;
        if fs.kind(full) == fs.FILE_KIND_DIR {
            loop walkFilesWithSuffix(full, rel, suffix) as sub {
                mut out.pushBack(sub);
            }
        } else if name.endsWith(suffix) {
            mut out.pushBack(rel);
        }
    }
    out
};

/** Returns directory component of a POSIX path. */
pub posixDirname := fn(relPath: String): String {
    var lastSlash := -1;
    var i := 0;
    loop i < relPath.length() {
        if relPath.at(i) == "/" { lastSlash = i; }
        i = i + 1;
    }
    if lastSlash < 0 { "." } else if lastSlash == 0 { "/" } else { relPath.slice(0, lastSlash) }
};

/** Extracts filename from a POSIX path, optionally stripping a trailing extension. */
pub posixBasename := fn(relPath: String, ext: String): String {
    var lastSlash := -1;
    var i := 0;
    loop i < relPath.length() {
        if relPath.at(i) == "/" { lastSlash = i; }
        i = i + 1;
    }
    name := if lastSlash >= 0 { relPath.slice(lastSlash + 1, relPath.length()) } else { relPath };
    if ext =!= "" and name.endsWith(ext) {
        name.slice(0, name.length() - ext.length())
    } else {
        name
    }
};

/** Splits `value` by non-empty separator `sep`, preserving empty segments. */
pub splitByDelimiter := fn(value: String, sep: String): List<String> {
    out: mut List<String> = [];
    sepLen := sep.length();
    var pos := 0;
    loop {
        hit := value.indexOf(sep, pos);
        if hit < 0 {
            mut out.pushBack(value.slice(pos, value.length()));
            break;
        }
        (mut out).pushBack(value.slice(pos, hit));
        pos = hit + sepLen;
    }
    out
};

/** Joins and normalizes a POSIX base directory and relative path. */
pub posixJoinAndNormalize := fn(dir: String, spec: String): String {
    joined := if dir == "." or dir == "" { spec } else { dir + "/" + spec };
    parts := splitByDelimiter(joined, "/");
    var stack: mut List<String> = [];
    loop parts as part {
        if part == "" or part == "." {
            continue;
        } else if part == ".." {
            n := stack.length();
            if n > 0 and stack[n - 1] =!= ".." {
                _popped := mut stack.popBack();
            } else {
                mut stack.pushBack("..");
            }
        } else {
            mut stack.pushBack(part);
        }
    }
    if stack.length() == 0 { "." } else { text.joinTexts(stack, "/") }
};

collectRelativeModulesJson := fn(
rootDir: String, hostIds: List<String>, hostTexts: List<String>, entryRelFile: String, entrySource: String
): String {
    var queueFiles: mut List<String> = [entryRelFile];
    var queueTexts: mut List<String> = [entrySource];
    seenFiles: mut Set<String>;
    mut seenFiles.add(entryRelFile);
    modSpecs: mut Set<String>;
    modJsonEntries: mut List<String> = [];
    var qi := 0;
    loop qi < queueFiles.length() {
        fromFile := queueFiles[qi];
        curText := queueTexts[qi];
        qi = qi + 1;
        curDir := posixDirname(fromFile);
        tLen := curText.length();
        var pos := 0;
        loop pos < tLen {
            impPos := curText.indexOf("import", pos);
            if impPos < 0 { break; }
            var p := impPos + 6;
            if p < tLen and isWhitespaceChar(curText.at(p)) {
                loop p < tLen and isWhitespaceChar(curText.at(p)) { p = p + 1; }
                if p + 1 < tLen and curText.at(p) == "\"" and curText.at(p + 1) == "." {
                    qEnd := curText.indexOf("\"", p + 1);
                    if qEnd > p + 1 {
                        spec := curText.slice(p + 1, qEnd);
                        resolvedRel := posixJoinAndNormalize(curDir, spec);
                        fullPath := path.join(rootDir, resolvedRel);
                        if fs.kind(fullPath) == fs.FILE_KIND_FILE {
                            modText := fs.readText(fullPath).text;
                            ident := hostModuleIdentity(hostIds, hostTexts, modText);
                            entryJson := json.quoteString(spec) + ":{\"path\":" + json.quoteString(resolvedRel)
                            + ",\"display\":" + json.quoteString(resolvedRel)
                            + ",\"identity\":" + json.quoteString(ident)
                            + ",\"text\":" + json.quoteString(modText) + "}";
                            if not modSpecs.has(spec) {
                                mut modSpecs.add(spec);
                                mut modJsonEntries.pushBack(entryJson);
                            }
                            if not seenFiles.has(resolvedRel) {
                                mut seenFiles.add(resolvedRel);
                                mut queueFiles.pushBack(resolvedRel);
                                mut queueTexts.pushBack(modText);
                            }
                        }
                        pos = qEnd + 1;
                        continue;
                    }
                }
            }
            pos = impPos + 6;
        }
    }
    if modJsonEntries.length() == 0 { "" } else { "{" + text.joinTexts(modJsonEntries, ",") + "}" }
};

capitalizeWord := fn(word: String): String {
    if word == "" { return ""; }
    upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    lower := "abcdefghijklmnopqrstuvwxyz";
    first := word.at(0);
    idx := lower.indexOf(first, 0);
    lead := if idx >= 0 { upper.at(idx) } else { first };
    lead + word.slice(1, word.length())
};

/** Formats a source path's filename stem as a human-readable title. */
pub slugToTitle := fn(relPath: String): String {
    base := posixBasename(relPath, ".lts");
    words: mut List<String> = [];
    var cur := "";
    var i := 0;
    loop i < base.length() {
        ch := base.at(i);
        if ch == "-" or ch == "_" {
            if cur =!= "" {
                mut words.pushBack(capitalizeWord(cur));
                cur = "";
            }
        } else {
            cur = cur + ch;
        }
        i = i + 1;
    }
    if cur =!= "" { mut words.pushBack(capitalizeWord(cur)); }
    text.joinTexts(words, " ")
};

cleanSlugBase := fn(preferred: String): String {
    lowered := challenges.asciiLower(preferred);
    out: mut List<String> = [];
    var prevDash := true;
    var i := 0;
    loop i < lowered.length() {
        ch := lowered.at(i);
        isOk := "abcdefghijklmnopqrstuvwxyz0123456789._-".indexOf(ch, 0) >= 0;
        if isOk {
            mut out.pushBack(ch);
            prevDash = false;
        } else if not prevDash {
            mut out.pushBack("-");
            prevDash = true;
        }
        i = i + 1;
    }
    joined := text.joinTexts(out, "");
    var s := 0;
    var e := joined.length();
    loop s < e and joined.at(s) == "-" { s = s + 1; }
    loop e > s and joined.at(e - 1) == "-" { e = e - 1; }
    if e <= s { "item" } else { joined.slice(s, e) }
};

nextAvailableSlug := fn(used: mut Set<String>, preferred: String): String {
    base := cleanSlugBase(preferred);
    if not used.has(base) {
        mut used.add(base);
        return base;
    }
    var suffix := 2;
    loop {
        cand := base + "-" + suffix.toText();
        if not used.has(cand) {
            mut used.add(cand);
            return cand;
        }
        suffix = suffix + 1;
    }
    base
};

quoteStringList := fn(items: List<String>): String {
    quoted: mut List<String> = [];
    loop items as it { mut quoted.pushBack(json.quoteString(it)); }
    "[" + text.joinTexts(quoted, ",") + "]"
};

stripBackticksAndTrim := fn(s: String): String {
    out: mut List<String> = [];
    var i := 0;
    loop i < s.length() {
        ch := s.at(i);
        if ch =!= "`" { mut out.pushBack(ch); }
        i = i + 1;
    }
    text.joinTexts(out, "").trim()
};

extractHeadingForLine := fn(lines: List<String>, lineIdx: Int, fallback: String): String {
    var i := if lineIdx < lines.length() { lineIdx } else { lines.length() - 1 };
    loop i >= 0 {
        line := lines[i];
        var hashes := 0;
        loop hashes < line.length() and hashes < 5 and line.at(hashes) == "#" {
            hashes = hashes + 1;
        }
        if hashes >= 1 and hashes <= 4 and hashes < line.length() and (line.at(hashes) == " " or line.at(hashes) == "\t") {
            rest := line.slice(hashes + 1, line.length());
            if rest.trim() =!= "" {
                return stripBackticksAndTrim(rest);
            }
        }
        i = i - 1;
    }
    fallback
};

buildItemJson := fn(
id: String, slug: String, category: String, badge: String, title: String,
file: String, source: String, stdinVal: String, argsList: List<String>,
environment: String, extraModulesJson: String, sampleId: String
): String {
    envField := if environment =!= "" and environment =!= "universal" { ",\"environment\":" + json.quoteString(environment) } else { "" };
    extraField := if extraModulesJson =!= "" { ",\"extraModules\":" + extraModulesJson } else { "" };
    sampleField := if sampleId =!= "" { ",\"sampleId\":" + json.quoteString(sampleId) } else { "" };
    "{\"id\":" + json.quoteString(id)
    + ",\"slug\":" + json.quoteString(slug)
    + ",\"category\":" + json.quoteString(category)
    + ",\"badge\":" + json.quoteString(badge)
    + ",\"title\":" + json.quoteString(title)
    + ",\"file\":" + json.quoteString(file)
    + ",\"source\":" + json.quoteString(source)
    + ",\"stdin\":" + json.quoteString(stdinVal)
    + ",\"args\":" + quoteStringList(argsList)
    + envField + extraField + sampleField + "}"
};

/** Builds Playground library items JSON array for Samples, Examples, Cases, and Pieces. */
pub collectPlaygroundLibraryJson := fn(rootDir: String, samplesJson: String): (ok: Bool, jsonText: String, error: String) {
    hostSpecIds: List<String> = [
    "lite.core.io.v1", "lite.core.int.v1", "lite.core.list.v1", "lite.core.text.v1",
    "lite.core.file.v1", "lite.core.process.v1", "lite.core.crypto.v1", "lite.core.time.v1",
    "lite.core.unicode.v1", "lite.compiler.modules.v1"
    ];
    hostSpecStems: List<String> = [
    "lib/core/io", "lib/core/int", "lib/core/list", "lib/core/text",
    "lib/core/file", "lib/core/process", "lib/core/crypto", "lib/core/time",
    "lib/core/unicode", "compiler/src/modules"
    ];
    hostIds: mut List<String> = [];
    hostTexts: mut List<String> = [];
    var hi := 0;
    loop hi < hostSpecIds.length() {
        ltFull := path.join(rootDir, hostSpecStems[hi] + ".lt");
        ltsFull := path.join(rootDir, hostSpecStems[hi] + ".lts");
        hRead := fs.readText(if fs.kind(ltFull) == fs.FILE_KIND_FILE { ltFull } else { ltsFull });
        if hRead.ok {
            mut hostIds.pushBack(hostSpecIds[hi]);
            mut hostTexts.pushBack(hRead.text);
        }
        hi = hi + 1;
    }

    items: mut List<String> = [];
    usedSamples: mut Set<String>;
    usedExamples: mut Set<String>;
    usedCases: mut Set<String>;
    usedPieces: mut Set<String>;

    trimmedSamples := samplesJson.trim();
    if trimmedSamples =!= "" and challenges.isJsonArrayAt(trimmedSamples, 0) {
        loop json.arrayElementOffsets(trimmedSamples, 0) as sp {
            sid := json.readObjectString(trimmedSamples, sp, "id").value;
            ttl := json.readObjectString(trimmedSamples, sp, "title").value;
            relFile := json.readObjectString(trimmedSamples, sp, "file").value;
            stdinR := json.readObjectString(trimmedSamples, sp, "stdin");
            stdinVal := if stdinR.found and stdinR.ok { stdinR.value } else { "" };
            argsList := challenges.readStringArray(trimmedSamples, sp, "args");
            srcRead := fs.readText(path.join(rootDir, relFile));
            if not srcRead.ok {
                return (ok = false, jsonText = "", error = "missing sample file " + relFile + ": " + srcRead.error);
            }
            isPlay := relFile.startsWithAt(0, "samples/graphics/") or relFile.startsWithAt(0, "samples/games/");
            slug := nextAvailableSlug(mut usedSamples, sid);
            mut items.pushBack(buildItemJson(
            "sample/" + slug, slug, "sample", if isPlay { "Play" } else { "Sample" }, ttl,
            relFile, srcRead.text, stdinVal, argsList, "", "", sid
            ));
        }
    }

    emptyArgs: List<String> = [];
    exampleFiles: mut List<String> = [];
    loop walkFilesWithSuffix(path.join(rootDir, "language/examples"), "language/examples", ".lts") as f {
        mut exampleFiles.pushBack(f);
    }
    loop walkFilesWithSuffix(path.join(rootDir, "language/showcases"), "language/showcases", ".lts") as f {
        mut exampleFiles.pushBack(f);
    }
    loop exampleFiles as relFile {
        if relFile.indexOf("/helpers/", 0) >= 0 { continue; }
        base := posixBasename(relFile, ".lts");
        isShowcase := relFile.startsWithAt(0, "language/showcases/");
        preferred := if isShowcase { "showcase-" + base } else { base };
        slug := nextAvailableSlug(mut usedExamples, preferred);
        src := fs.readText(path.join(rootDir, relFile)).text;
        extraJson := collectRelativeModulesJson(rootDir, hostIds, hostTexts, relFile, src);
        envVal := detectSourceEnvironment(src);
        mut items.pushBack(buildItemJson(
        "example/" + slug, slug, "example", if isShowcase { "Showcase" } else { "Example" },
        slugToTitle(relFile), relFile, src, "", emptyArgs, envVal, extraJson, ""
        ));
    }

    loop walkFilesWithSuffix(path.join(rootDir, "language/cases"), "language/cases", ".lts") as relFile {
        base := posixBasename(relFile, ".lts");
        slug := nextAvailableSlug(mut usedCases, base);
        src := fs.readText(path.join(rootDir, relFile)).text;
        badge := if base.startsWithAt(0, "reject-") { "Reject Case" } else { "Case" };
        mut items.pushBack(buildItemJson(
        "case/" + slug, slug, "case", badge, slugToTitle(relFile), relFile, src, "", emptyArgs, "", "", ""
        ));
    }

    learnPath := path.join(rootDir, "language/learn/catalog.json");
    if fs.kind(learnPath) == fs.FILE_KIND_FILE {
        lText := fs.readText(learnPath).text;
        tracksF := json.findObjectField(lText, 0, "tracks");
        tOffsets := json.arrayElementOffsets(lText, tracksF.valuePos);
        tCount := tOffsets.length();
        tSortKeys: mut List<String> = [];
        var ti := 0;
        loop ti < tCount {
            ordR := json.readObjectInt(lText, tOffsets[ti], "order");
            ordVal := if ordR.found and ordR.ok { ordR.value } else { 0 };
            mut tSortKeys.pushBack(challenges.padLeftZero(ordVal + 1000000, 9) + ":" + challenges.padLeftZero(ti, 6));
            ti = ti + 1;
        }
        sortedIdx := challenges.sortIndexByKeys(tSortKeys);
        loop sortedIdx as sIdx {
            tp := tOffsets[sIdx];
            lessonsF := json.findObjectField(lText, tp, "lessons");
            loop json.arrayElementOffsets(lText, lessonsF.valuePos) as lp {
                lSlug := json.readObjectString(lText, lp, "slug").value;
                kindV := json.readObjectString(lText, lp, "kind").value;
                ttl := json.readObjectString(lText, lp, "title").value;
                srcFile := json.readObjectString(lText, lp, "sourceFile").value;
                stdinR := json.readObjectString(lText, lp, "stdin");
                stdinVal := if stdinR.found and stdinR.ok { stdinR.value } else { "" };
                envR := json.readObjectString(lText, lp, "environment");
                envVal := if envR.found and envR.ok { envR.value } else { "universal" };
                argsList := challenges.readStringArray(lText, lp, "args");
                slug := nextAvailableSlug(mut usedPieces, lSlug);
                src := fs.readText(path.join(rootDir, srcFile)).text;
                extraJson := collectRelativeModulesJson(rootDir, hostIds, hostTexts, srcFile, src);
                mut items.pushBack(buildItemJson(
                "piece/" + slug, slug, "piece", if kindV == "tutorial" { "Tutorial" } else { "Lesson" },
                ttl, srcFile, src, stdinVal, argsList, envVal, extraJson, ""
                ));
            }
        }
    }

    gymPath := path.join(rootDir, "language/gym/catalog.json");
    if fs.kind(gymPath) == fs.FILE_KIND_FILE {
        gText := fs.readText(gymPath).text;
        exF := json.findObjectField(gText, 0, "exercises");
        loop json.arrayElementOffsets(gText, exF.valuePos) as ep {
            gSlug := json.readObjectString(gText, ep, "slug").value;
            gMode := json.readObjectString(gText, ep, "mode").value;
            gTitle := json.readObjectString(gText, ep, "title").value;
            starterFile := json.readObjectString(gText, ep, "starterFile").value;
            vcF := json.findObjectField(gText, ep, "visibleCases");
            vcOffs := if vcF.found { json.arrayElementOffsets(gText, vcF.valuePos) } else {
                emptyInts: List<Int> = [];
                emptyInts
            };
            var firstStdin := "";
            var firstArgs: List<String> = emptyArgs;
            if vcOffs.length() > 0 {
                fcPos := vcOffs[0];
                fsR := json.readObjectString(gText, fcPos, "stdin");
                if fsR.found and fsR.ok { firstStdin = fsR.value; }
                firstArgs = challenges.readStringArray(gText, fcPos, "args");
            }
            slug := nextAvailableSlug(mut usedPieces, "gym-" + gSlug);
            src := fs.readText(path.join(rootDir, starterFile)).text;
            mut items.pushBack(buildItemJson(
            "piece/" + slug, slug, "piece", if gMode == "drill" { "Drill" } else { "Workout" },
            gTitle + " (Starter)", starterFile, src, firstStdin, firstArgs, "", "", ""
            ));
        }
    }

    hbDir := path.join(rootDir, "language/learn/handbook");
    loop walkFilesWithSuffix(hbDir, "language/learn/handbook", ".md") as relPath {
        raw := fs.readText(path.join(rootDir, relPath)).text;
        norm := challenges.collapseCrLf(raw);
        lines := splitByDelimiter(norm, "\n");
        chapterSlug := posixBasename(relPath, ".md");
        fallbackHeading := slugToTitle(chapterSlug + ".lts");
        var fenceIdx := 0;
        var li := 0;
        nLines := lines.length();
        loop li < nLines {
            line := lines[li];
            if line == "```lite" or line == "```lts" {
                var endLi := li + 1;
                codeLines: mut List<String> = [];
                loop endLi < nLines and not lines[endLi].startsWithAt(0, "```") {
                    mut codeLines.pushBack(lines[endLi]);
                    endLi = endLi + 1;
                }
                if endLi < nLines {
                    code := text.joinTexts(codeLines, "\n");
                    if code.trim() =!= "" {
                        heading := extractHeadingForLine(lines, li, fallbackHeading);
                        slug := nextAvailableSlug(mut usedPieces, chapterSlug + "-" + fenceIdx.toText());
                        mut items.pushBack(buildItemJson(
                        "piece/" + slug, slug, "piece", "Handbook",
                        heading, relPath, code, "", emptyArgs, "", "", ""
                        ));
                    }
                    fenceIdx = fenceIdx + 1;
                    li = endLi + 1;
                    continue;
                }
            }
            li = li + 1;
        }
    }

    (ok = true, jsonText = "[" + text.joinTexts(items, ",") + "]", error = "")
};
