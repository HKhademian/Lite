/** Discovers `/docs/` Handbook/Spec documents, renders Markdown JSON, and builds portal pages (`site/docs-pages.ts`). */

fs := import "core/file";
list := import "core/list";
path := import "core/path";
text := import "core/text";
challenges := import "util/challenges";
json := import "util/json";
mdHtml := import "util/markdown-html";
siteLib := import "./library.lts";
siteTools := import "./tools.lts";

escapeHtml := siteTools.escapeSiteHtml;

/** Computes a POSIX relative link between two output paths inside `dist/site/`. */
pub relativeHref := fn(fromOutPath: String, toOutPath: String): String {
    fromDir := siteLib.posixDirname(fromOutPath);
    fromPartsRaw := if fromDir == "." {
        emptyP: List<String> = [];
        emptyP
    } else {
        siteLib.splitByDelimiter(fromDir, "/")
    };
    toPartsRaw := siteLib.splitByDelimiter(toOutPath, "/");
    fromParts: mut List<String> = [];
    toParts: mut List<String> = [];
    loop fromPartsRaw as fp { if fp =!= "" and fp =!= "." { mut fromParts.pushBack(fp); } }
    loop toPartsRaw as tp { if tp =!= "" and tp =!= "." { mut toParts.pushBack(tp); } }

    fnLen := fromParts.length();
    tnLen := toParts.length();
    var common := 0;
    loop common < fnLen and common < tnLen and fromParts[common] == toParts[common] {
        common = common + 1;
    }
    ups: mut List<String> = [];
    var ui := common;
    loop ui < fnLen {
        mut ups.pushBack("..");
        ui = ui + 1;
    }
    var ti := common;
    loop ti < tnLen {
        mut ups.pushBack(toParts[ti]);
        ti = ti + 1;
    }
    joined := text.joinTexts(ups, "/");
    base := if joined == "" { siteLib.posixBasename(toOutPath, "") } else { joined };
    if toOutPath.endsWith("/") and not base.endsWith("/") {
        base + "/"
    } else {
        base
    }
};

listSortedMdInDir := fn(dirPath: String): List<String> {
    out: mut List<String> = [];
    if fs.kind(dirPath) =!= fs.FILE_KIND_DIR { return out; }
    loop challenges.sortTexts(fs.listDir(dirPath)) as name {
        full := path.join(dirPath, name);
        if fs.kind(full) == fs.FILE_KIND_FILE and name.endsWith(".md") {
            mut out.pushBack(name);
        }
    }
    out
};

claimOutPath := fn(usedOut: mut Set<String>, preferred: String): String {
    if not usedOut.has(preferred) {
        mut usedOut.add(preferred);
        return preferred;
    }
    stem := if preferred.endsWith(".html") {
        preferred.slice(0, preferred.length() - 5)
    } else {
        preferred
    };
    ext := if preferred.endsWith(".html") { ".html" } else { "" };
    var idx := 2;
    loop {
        cand := stem + "-" + idx.toText() + ext;
        if not usedOut.has(cand) {
            mut usedOut.add(cand);
            return cand;
        }
        idx = idx + 1;
    }
    preferred
};

loadVerifiedDocsSet := fn(rootDir: String): Set<String> {
    out: mut Set<String>;
    mut out.add("docs/start-here.md");
    mut out.add("docs/tour.md");
    catalogPath := path.join(rootDir, "language/showcases/catalog.json");
    if fs.kind(catalogPath) =!= fs.FILE_KIND_FILE { return out; }
    catRead := fs.readText(catalogPath);
    if not catRead.ok { return out; }
    catJson := catRead.text;
    chF := json.findObjectField(catJson, 0, "chapters");
    if not chF.found { return out; }
    loop json.arrayElementOffsets(catJson, chF.valuePos) as cp {
        topF := json.findObjectField(catJson, cp, "topics");
        if not topF.found { continue; }
        loop json.arrayElementOffsets(catJson, topF.valuePos) as tp {
            loop challenges.readStringArray(catJson, tp, "docs") as dPath {
                mut out.add(dPath);
            }
        }
    }
    out
};

loadSnippetsJson := fn(rootDir: String): String {
    cfgPath := path.join(rootDir, "config/documentation.json");
    if fs.kind(cfgPath) =!= fs.FILE_KIND_FILE { return "[]"; }
    cfgRead := fs.readText(cfgPath);
    if not cfgRead.ok { return "[]"; }
    cfgJson := cfgRead.text;
    snF := json.findObjectField(cfgJson, 0, "snippets");
    if not snF.found { return "[]"; }
    entries: mut List<String> = [];
    loop json.arrayElementOffsets(cfgJson, snF.valuePos) as sp {
        docR := json.readObjectString(cfgJson, sp, "document");
        srcR := json.readObjectString(cfgJson, sp, "source");
        fenR := json.readObjectInt(cfgJson, sp, "fence");
        if docR.found and docR.ok and srcR.found and srcR.ok and fenR.found and fenR.ok {
            key := docR.value + "#" + fenR.value.toText();
            mut entries.pushBack("{\"key\":" + json.quoteString(key) + ",\"sourcePath\":" + json.quoteString(srcR.value) + "}");
        }
    }
    "[" + text.joinTexts(entries, ",") + "]"
};

/** Discovers docs metadata, source->out map, snippets, and optionally rendered Markdown JSON. */
pub discoverDocsPayloadJson := fn(rootDir: String, includeRendered: Bool): (ok: Bool, jsonText: String, error: String) {
    hbSources: List<String> = [
    "language/learn/handbook/getting-started/overview-and-setup.md",
    "language/learn/handbook/foundations/bindings-and-mutability.md",
    "language/learn/handbook/foundations/numbers-operators-and-strings.md",
    "language/learn/handbook/control/conditionals-match-and-loops.md",
    "language/learn/handbook/types/tuples-arrays-lists-and-aliases.md",
    "language/learn/handbook/execution/blocks-wiring-and-closures.md",
    "language/learn/handbook/modules/imports-visibility-and-io.md",
    "language/learn/handbook/extra/graphics-surfaces-and-play.md",
    "language/learn/handbook/extra/math-vectors-and-matrices.md",
    "language/learn/handbook/extra/data-structures-and-memory.md",
    "language/learn/handbook/tooling/native-c11-and-optimization.md"
    ];
    hbSlugs: List<String> = [
    "overview-and-setup", "bindings-and-mutability", "numbers-operators-and-strings",
    "conditionals-match-and-loops", "tuples-arrays-lists-and-aliases",
    "blocks-wiring-and-closures", "imports-visibility-and-io",
    "graphics-surfaces-and-play", "math-vectors-and-matrices",
    "data-structures-and-memory", "native-c11-and-optimization"
    ];
    hbNavs: List<String> = [
    "1. Overview & Setup", "2. Bindings & Mutability", "3. Numbers, Operators & Strings",
    "4. Conditionals, Match & Loops", "5. Tuples, Arrays, Lists & Aliases",
    "6. Blocks, Wiring & Closures", "7. Imports, Visibility & I/O",
    "8. Graphics, Surfaces & Lite Play", "9. Math, Vectors, Matrices & Grids",
    "10. Data Structures & Memory Pools", "11. Native C11, Optimization & Tooling"
    ];
    hbSums: List<String> = [
    "Explicit imports, dual-target TS & C11 toolchain, ./bin/lite commands, file kinds, and nestable comments.",
    "Immutable := defaults, zero-value storage, reserved = ?, var updates, and mut lists.",
    "Int8..Int64, Float/Float32, / % vs :/ :%, **, =!=, chained comparisons, core/text, core/math, and core/random.",
    "Expression if/else, subjectless match, sequence loops, .index/.count/.value/.collected, then, @tag, and finally.",
    "Unnamed/named/mixed tuples, records, enums, [T; N] arrays, List<T>, Map<K, V>, Set<T>, and type aliases.",
    "Final-item block values, DCE pruning, parallel wiring, execution trace safety, self, and closures.",
    "Namespace imports, pub boundaries, all 37 core/* and extra/* modules, and core/io streams.",
    "extra/canvas, extra/surface desktop windows, extra/color, extra/audio, extra/board, extra/timer, and ./bin/lite play.",
    "core/math, core/random, 2D/3D/4D extra/vector, 2x2..4x4 extra/matrix transforms, and flat 2D extra/grid.",
    "extra/arena, extra/pool, extra/intern, extra/lru, extra/ring, extra/deque, extra/heap, extra/bitset, and extra/sparse.",
    "Dual-target TS & C11 parity, 3-generation self-hosting, ./bin/lite build, -O0..-O3/-Os, and ./bin/lite ignite."
    ];

    metaSrcs: mut List<String> = [];
    metaOuts: mut List<String> = [];
    metaLayers: mut List<String> = [];
    metaGroups: mut List<String> = [];
    metaNavs: mut List<String> = [];
    metaSums: mut List<String> = [];
    metaChSlugs: mut List<String> = [];
    metaVerified: mut List<Bool> = [];

    var hi := 0;
    loop hi < hbSources.length() {
        mut metaSrcs.pushBack(hbSources[hi]);
        mut metaOuts.pushBack("docs/handbook/" + hbSlugs[hi] + ".html");
        mut metaLayers.pushBack("handbook");
        mut metaGroups.pushBack("handbook");
        mut metaNavs.pushBack(hbNavs[hi]);
        mut metaSums.pushBack(hbSums[hi]);
        mut metaChSlugs.pushBack(hbSlugs[hi]);
        mut metaVerified.pushBack(true);
        hi = hi + 1;
    }

    verifiedDocs := loadVerifiedDocsSet(rootDir);
    usedOut: mut Set<String>;

    startOrder: List<String> = [
    "docs/README.md", "docs/start-here.md", "docs/tour.md", "docs/white-paper.md",
    "docs/principles.md", "docs/decisions-and-open-questions.md", "docs/spec/README.md",
    "docs/normative-pages.md", "docs/grammar-sketch.md"
    ];
    startSeen: mut Set<String>;
    loop startOrder as src {
        if fs.kind(path.join(rootDir, src)) == fs.FILE_KIND_FILE {
            mut startSeen.add(src);
            base := if src == "docs/README.md" { "overview.html" }
            else if src == "docs/spec/README.md" { "spec-overview.html" }
            else { siteLib.posixBasename(src, ".md") + ".html" };
            outPath := claimOutPath(mut usedOut, "docs/design/" + base);
            mut metaSrcs.pushBack(src);
            mut metaOuts.pushBack(outPath);
            mut metaLayers.pushBack("spec");
            mut metaGroups.pushBack("start");
            mut metaNavs.pushBack(siteLib.posixBasename(src, ".md"));
            mut metaSums.pushBack("");
            mut metaChSlugs.pushBack("");
            mut metaVerified.pushBack(verifiedDocs.has(src));
        }
    }

    loop listSortedMdInDir(path.join(rootDir, "docs")) as file {
        src := "docs/" + file;
        if startSeen.has(src) { continue; }
        outPath := claimOutPath(mut usedOut, "docs/design/" + siteLib.posixBasename(src, ".md") + ".html");
        mut metaSrcs.pushBack(src);
        mut metaOuts.pushBack(outPath);
        mut metaLayers.pushBack("spec");
        mut metaGroups.pushBack("design");
        mut metaNavs.pushBack(siteLib.posixBasename(src, ".md"));
        mut metaSums.pushBack("");
        mut metaChSlugs.pushBack("");
        mut metaVerified.pushBack(verifiedDocs.has(src));
    }

    loop listSortedMdInDir(path.join(rootDir, "docs/spec")) as file {
        src := "docs/spec/" + file;
        if startSeen.has(src) { continue; }
        stem := siteLib.posixBasename(file, ".md");
        outPath := claimOutPath(mut usedOut, "docs/design/spec-" + stem + ".html");
        mut metaSrcs.pushBack(src);
        mut metaOuts.pushBack(outPath);
        mut metaLayers.pushBack("spec");
        mut metaGroups.pushBack("design");
        mut metaNavs.pushBack("spec/" + stem);
        mut metaSums.pushBack("");
        mut metaChSlugs.pushBack("");
        mut metaVerified.pushBack(verifiedDocs.has(src));
    }

    loop listSortedMdInDir(path.join(rootDir, "docs/research")) as file {
        src := "docs/research/" + file;
        stem := siteLib.posixBasename(file, ".md");
        outPath := claimOutPath(mut usedOut, "docs/design/research-" + stem + ".html");
        mut metaSrcs.pushBack(src);
        mut metaOuts.pushBack(outPath);
        mut metaLayers.pushBack("spec");
        mut metaGroups.pushBack("design");
        mut metaNavs.pushBack("research/" + stem);
        mut metaSums.pushBack("");
        mut metaChSlugs.pushBack("");
        mut metaVerified.pushBack(verifiedDocs.has(src));
    }

    loop listSortedMdInDir(path.join(rootDir, "docs/proposals")) as file {
        src := "docs/proposals/" + file;
        stem := siteLib.posixBasename(file, ".md");
        outPath := claimOutPath(mut usedOut, "docs/proposals/" + stem + ".html");
        mut metaSrcs.pushBack(src);
        mut metaOuts.pushBack(outPath);
        mut metaLayers.pushBack("spec");
        mut metaGroups.pushBack("proposals");
        mut metaNavs.pushBack(stem);
        mut metaSums.pushBack("");
        mut metaChSlugs.pushBack("");
        mut metaVerified.pushBack(verifiedDocs.has(src));
    }

    compOrder: List<String> = ["compiler/README.md", "compiler/transition-plan.md", "compiler/parity.md", "compiler/gaps.md"];
    compAll: mut List<String> = [];
    loop compOrder as cp {
        if fs.kind(path.join(rootDir, cp)) == fs.FILE_KIND_FILE { mut compAll.pushBack(cp); }
    }
    loop listSortedMdInDir(path.join(rootDir, "compiler")) as file {
        cp := "compiler/" + file;
        if not list.listContainsText(compOrder, cp) { mut compAll.pushBack(cp); }
    }
    compSeen: mut Set<String>;
    loop compAll as src {
        if compSeen.has(src) { continue; }
        (mut compSeen).add(src);
        outName := if src == "compiler/README.md" { "overview.html" } else { siteLib.posixBasename(src, ".md") + ".html" };
        navLbl := if src == "compiler/README.md" { "compiler overview" } else { siteLib.posixBasename(src, ".md") };
        outPath := claimOutPath(mut usedOut, "docs/compiler/" + outName);
        mut metaSrcs.pushBack(src);
        mut metaOuts.pushBack(outPath);
        mut metaLayers.pushBack("spec");
        mut metaGroups.pushBack("compiler");
        mut metaNavs.pushBack(navLbl);
        mut metaSums.pushBack("");
        mut metaChSlugs.pushBack("");
        mut metaVerified.pushBack(verifiedDocs.has(src));
    }

    extraSrcs: List<String> = ["compiler/bootstrap/README.md", "compiler/manifests/README.md", "igniter/tests/README.md", "CONTRIBUTING.md"];
    extraOuts: List<String> = ["bootstrap-readme.html", "manifests-readme.html", "igniter-tests.html", "contributing.html"];
    extraLbls: List<String> = ["compiler/bootstrap", "compiler/manifests", "igniter/tests", "CONTRIBUTING"];
    var ei := 0;
    loop ei < 4 {
        src := extraSrcs[ei];
        if fs.kind(path.join(rootDir, src)) == fs.FILE_KIND_FILE {
            outPath := claimOutPath(mut usedOut, "docs/compiler/" + extraOuts[ei]);
            mut metaSrcs.pushBack(src);
            mut metaOuts.pushBack(outPath);
            mut metaLayers.pushBack("spec");
            mut metaGroups.pushBack("compiler");
            mut metaNavs.pushBack(extraLbls[ei]);
            mut metaSums.pushBack("");
            mut metaChSlugs.pushBack("");
            mut metaVerified.pushBack(verifiedDocs.has(src));
        }
        ei = ei + 1;
    }

    brandSrcs: List<String> = ["brand/README.md", "brand/name.md", "brand/investigation/README.md"];
    brandOuts: List<String> = ["overview.html", "name.html", "investigation.html"];
    brandLbls: List<String> = ["brand overview", "name", "investigation"];
    var bi := 0;
    loop bi < 3 {
        src := brandSrcs[bi];
        if fs.kind(path.join(rootDir, src)) == fs.FILE_KIND_FILE {
            outPath := claimOutPath(mut usedOut, "docs/brand/" + brandOuts[bi]);
            mut metaSrcs.pushBack(src);
            mut metaOuts.pushBack(outPath);
            mut metaLayers.pushBack("spec");
            mut metaGroups.pushBack("brand");
            mut metaNavs.pushBack(brandLbls[bi]);
            mut metaSums.pushBack("");
            mut metaChSlugs.pushBack("");
            mut metaVerified.pushBack(verifiedDocs.has(src));
        }
        bi = bi + 1;
    }

    metasJson: mut List<String> = [];
    mapJson: mut List<String> = [];
    renderedJson: mut List<String> = [];
    var mi := 0;
    loop mi < metaSrcs.length() {
        src := metaSrcs[mi];
        outPath := metaOuts[mi];
        sumField := if metaSums[mi] =!= "" { ",\"summary\":" + json.quoteString(metaSums[mi]) } else { "" };
        slugField := if metaChSlugs[mi] =!= "" { ",\"chapterSlug\":" + json.quoteString(metaChSlugs[mi]) } else { "" };
        mut metasJson.pushBack("{\"sourcePath\":" + json.quoteString(src)
        + ",\"outPath\":" + json.quoteString(outPath)
        + ",\"layer\":" + json.quoteString(metaLayers[mi])
        + ",\"group\":" + json.quoteString(metaGroups[mi])
        + ",\"navLabel\":" + json.quoteString(metaNavs[mi])
        + sumField + slugField
        + ",\"verifiedInTs\":" + (if metaVerified[mi] { "true" } else { "false" }) + "}");
        mut mapJson.pushBack("{\"sourcePath\":" + json.quoteString(src) + ",\"outPath\":" + json.quoteString(outPath) + "}");
        if includeRendered {
            rRead := fs.readText(path.join(rootDir, src));
            if not rRead.ok { return (ok = false, jsonText = "", error = src + ": " + rRead.error); }
            (mut renderedJson).pushBack(mdHtml.renderMarkdownJson(rRead.text, src));
        }
        mi = mi + 1;
    }

    snippetsJson := loadSnippetsJson(rootDir);
    out := "{\"metas\":[" + text.joinTexts(metasJson, ",") + "],\"docOutMap\":[" + text.joinTexts(mapJson, ",") + "],\"snippets\":" + snippetsJson + ",\"rendered\":[" + text.joinTexts(renderedJson, ",") + "]}";
    (ok = true, jsonText = out, error = "")
};

statusPillLabel := fn(layer: String, group: String, rawStatus: String): String {
    if layer == "handbook" { return "Verified in TS"; }
    eff := if group == "proposals" { "proposal" } else { rawStatus };
    if eff == "historical" { "Historical" }
    else if eff == "proposal" { "Working Proposal" }
    else if eff == "open" { "Open Question" }
    else { "Selected Design" }
};

statusPillClass := fn(layer: String, group: String, rawStatus: String): String {
    if layer == "handbook" { return "status-pill-shipped"; }
    eff := if group == "proposals" { "proposal" } else { rawStatus };
    if eff == "historical" { "status-pill-historical" }
    else if eff == "proposal" { "status-pill-proposal" }
    else if eff == "open" { "status-pill-open" }
    else { "status-pill-selected" }
};

stripChapterNumPrefix := fn(nav: String): String {
    dotPos := nav.indexOf(". ", 0);
    if dotPos >= 1 and dotPos <= 3 {
        nav.slice(dotPos + 2, nav.length())
    } else {
        nav
    }
};

handbookPartName := fn(chIdx: Int): String {
    if chIdx == 0 { "Start" }
    else if chIdx <= 3 { "Core Language" }
    else if chIdx <= 5 { "Data & Execution" }
    else if chIdx == 6 { "Modules & I/O" }
    else if chIdx <= 9 { "Extra Libraries" }
    else { "Native & Tooling" }
};

estimateReadMinutes := fn(html: String): Int {
    n := html.length();
    if n < 2600 { 2 }
    else if n < 4600 { 3 }
    else if n < 6800 { 4 }
    else if n < 9000 { 5 }
    else { 6 }
};

injectBeforeFirstH2 := fn(html: String, block: String): String {
    if block == "" { return html; }
    h2Pos := html.indexOf("<h2", 0);
    if h2Pos < 0 { return html + "\n" + block; }
    html.slice(0, h2Pos) + block + "\n" + html.slice(h2Pos, html.length())
};

renderChapterRoadmap := fn(
chIdx: Int, hbSubChIdx: List<Int>, hbSubIds: List<String>, hbSubLabels: List<String>
): String {
    items: mut List<String> = [];
    var si := 0;
    var num := 1;
    totalSubs := hbSubChIdx.length();
    loop si < totalSubs {
        if hbSubChIdx[si] == chIdx {
            mut items.pushBack("<li><a href=\"#" + escapeHtml(hbSubIds[si]) + "\">"
            + "<span class=\"hb-roadmap-num\">" + num.toText() + "</span>"
            + "<span>" + hbSubLabels[si] + "</span>"
            + "</a></li>");
            num = num + 1;
        }
        si = si + 1;
    }
    if items.length() == 0 { return ""; }
    "<nav class=\"hb-roadmap\" aria-label=\"In this chapter\">\n"
    + "      <div class=\"hb-roadmap-head\">\n"
    + "        <span class=\"hb-roadmap-title\">In This Chapter</span>\n"
    + "        <span class=\"code-card-meta\">" + items.length().toText() + " sections</span>\n"
    + "      </div>\n"
    + "      <ol class=\"hb-roadmap-list\">\n"
    + "        " + text.joinTexts(items, "\n        ") + "\n"
    + "      </ol>\n"
    + "    </nav>"
};

renderDocsSidebar := fn(
layer: String, activeOutPath: String,
hbOuts: List<String>, hbNavs: List<String>, hbSlugs: List<String>, hbSums: List<String>,
hbSubChIdx: List<Int>, hbSubIds: List<String>, hbSubTexts: List<String>, hbSubLabels: List<String>,
spOuts: List<String>, spGroups: List<String>, spNavs: List<String>, spTitles: List<String>, spVerified: List<Bool>
): String {
    hbIndexHref := relativeHref(activeOutPath, "docs/handbook/overview-and-setup.html");
    specHref := relativeHref(activeOutPath, "docs/spec/index.html");

    if layer == "handbook" {
        isSinglePage := activeOutPath == "docs/handbook/single-page.html";
        treeParts: mut List<String> = [];
        totalSubs := hbSubChIdx.length();
        var hi := 0;
        loop hi < hbOuts.length() {
            if hi == 0 {
                mut treeParts.pushBack("<p class=\"hb-part-label\">Start</p>");
            } else if hi == 1 {
                mut treeParts.pushBack("<p class=\"hb-part-label\">Core Language</p>");
            } else if hi == 4 {
                mut treeParts.pushBack("<p class=\"hb-part-label\">Data &amp; Execution</p>");
            } else if hi == 6 {
                mut treeParts.pushBack("<p class=\"hb-part-label\">Modules &amp; I/O</p>");
            }

            tOut := hbOuts[hi];
            slug := if hbSlugs.length() > hi and hbSlugs[hi] =!= "" { hbSlugs[hi] } else { siteLib.posixBasename(tOut, ".html") };
            sumTxt := if hbSums.length() > hi { hbSums[hi] } else { "" };
            isActive := tOut == activeOutPath;
            chHref := if isSinglePage {
                "#chapter-" + slug
            } else if isActive {
                siteLib.posixBasename(tOut, "")
            } else {
                relativeHref(activeOutPath, tOut)
            };
            cls := if isActive { "hb-chapter-link active" } else { "hb-chapter-link" };
            itemCls := if isActive { "hb-chapter-item is-active" } else { "hb-chapter-item" };
            cleanTitle := stripChapterNumPrefix(hbNavs[hi]);
            subLis: mut List<String> = [];
            var si := 0;
            loop si < totalSubs {
                if hbSubChIdx[si] == hi {
                    subHref := if isSinglePage {
                        "#h" + (hi + 1).toText() + "-" + hbSubIds[si]
                    } else if isActive {
                        "#" + hbSubIds[si]
                    } else {
                        relativeHref(activeOutPath, tOut) + "#" + hbSubIds[si]
                    };
                    mut subLis.pushBack("<li data-hb-topic-search=\"" + escapeHtml(challenges.asciiLower(hbSubTexts[si])) + "\">"
                    + "<a href=\"" + escapeHtml(subHref) + "\">" + hbSubLabels[si] + "</a>"
                    + "</li>");
                }
                si = si + 1;
            }
            subListHtml := if subLis.length() > 0 {
                "\n          <ul class=\"hb-subtopics\">\n            " + text.joinTexts(subLis, "\n            ") + "\n          </ul>"
            } else { "" };
            searchBlob := challenges.asciiLower(hbNavs[hi] + " " + sumTxt);
            mut treeParts.pushBack("<div class=\"" + itemCls + "\" data-hb-chapter=\"" + escapeHtml(slug) + "\" data-hb-search=\"" + escapeHtml(searchBlob) + "\">\n"
            + "          <a class=\"" + cls + "\" href=\"" + escapeHtml(chHref) + "\" data-handbook-nav-slug=\"" + escapeHtml(slug) + "\">\n"
            + "            <span class=\"hb-num\">" + (hi + 1).toText() + "</span>\n"
            + "            <span class=\"hb-chapter-title\">" + escapeHtml(cleanTitle) + "</span>\n"
            + "            <span class=\"learn-done-dot\" aria-hidden=\"true\"></span>\n"
            + "          </a>" + subListHtml + "\n"
            + "        </div>");
            hi = hi + 1;
        }

        singleOut := "docs/handbook/single-page.html";
        singleHref := if isSinglePage { "single-page.html" } else { relativeHref(activeOutPath, singleOut) };
        singleCls := if isSinglePage { " class=\"active\"" } else { "" };
        modulesHref := relativeHref(activeOutPath, "modules/");
        learnHref := relativeHref(activeOutPath, "learn/");
        gymHref := relativeHref(activeOutPath, "gym/");
        playHref := relativeHref(activeOutPath, "playground/");

        return "<aside class=\"portal-sidebar hb-sidebar\" aria-label=\"Handbook navigation\">\n"
        + "      <div class=\"docs-layer-tabs\" role=\"tablist\" aria-label=\"Documentation layer\">\n"
        + "        <span class=\"docs-layer-tab active\" aria-selected=\"true\">Handbook</span>\n"
        + "        <a class=\"docs-layer-tab\" href=\"" + escapeHtml(specHref) + "\">Design Spec</a>\n"
        + "      </div>\n"
        + "      <input id=\"handbook-sidebar-filter\" class=\"docs-sidebar-filter\" type=\"search\" placeholder=\"Filter topics (match, record, :=)...\" aria-label=\"Filter handbook chapters and topics\">\n"
        + "      <button class=\"docs-quick-search-btn\" type=\"button\" data-open-search><span>Search all docs</span><kbd>&#8984;K</kbd></button>\n"
        + "      <div class=\"hb-progress-strip\">\n"
        + "        <div class=\"hb-progress-head\">\n"
        + "          <span id=\"hb-progress-label\" class=\"code-card-meta\">0 / " + hbOuts.length().toText() + " chapters read</span>\n"
        + "          <button id=\"hb-toggle-topics\" class=\"hb-compact-btn\" type=\"button\" aria-pressed=\"false\" title=\"Collapse or expand topic trees\">Compact</button>\n"
        + "        </div>\n"
        + "        <div class=\"learn-bar-track\" style=\"height: 4px;\"><div id=\"hb-progress-fill\" class=\"learn-bar-fill\" style=\"width: 0%;\"></div></div>\n"
        + "      </div>\n"
        + "      <div id=\"hb-nav-tree\" class=\"hb-tree\">\n"
        + "        " + text.joinTexts(treeParts, "\n        ") + "\n"
        + "        <p id=\"hb-filter-empty\" class=\"code-card-meta hb-filter-empty\" hidden>No matching handbook topics. <button class=\"hb-inline-link\" type=\"button\" data-open-search>Search all docs &rarr;</button></p>\n"
        + "      </div>\n"
        + "      <div class=\"hb-sidebar-foot\">\n"
        + "        <p class=\"portal-toc-title\" style=\"margin-bottom: 0.35rem;\">Academy &amp; Reference</p>\n"
        + "        <ul class=\"portal-nav-list\">\n"
        + "          <li><a href=\"" + escapeHtml(singleHref) + "\"" + singleCls + ">Single-Page Edition</a></li>\n"
        + "          <li><a href=\"" + escapeHtml(modulesHref) + "\">Standard Modules</a></li>\n"
        + "          <li><a href=\"" + escapeHtml(learnHref) + "\">Interactive Learn</a></li>\n"
        + "          <li><a href=\"" + escapeHtml(gymHref) + "\">Lite Gym</a></li>\n"
        + "          <li><a href=\"" + escapeHtml(playHref) + "\">Play Studio</a></li>\n"
        + "        </ul>\n"
        + "      </div>\n"
        + "    </aside>";
    }

    grpIds: List<String> = ["start", "design", "proposals", "compiler", "brand"];
    grpTitles: List<String> = ["Start & Overview", "Design Reference", "Proposals (LP)", "Compiler & Contribute", "Brand & Identity"];
    grpBlocks: mut List<String> = [];
    var gi := 0;
    loop gi < 5 {
        gid := grpIds[gi];
        lis: mut List<String> = [];
        var hasActive := gid == "start";
        var si := 0;
        loop si < spOuts.length() {
            if spGroups[si] == gid {
                tOut := spOuts[si];
                if tOut == activeOutPath { hasActive = true; }
                href := if tOut == activeOutPath { siteLib.posixBasename(tOut, "") } else { relativeHref(activeOutPath, tOut) };
                cls := if tOut == activeOutPath { " class=\"active\"" } else { "" };
                verStr := if spVerified[si] { "true" } else { "false" };
                dispLabel := if spTitles.length() > si and spTitles[si] =!= "" { spTitles[si] } else { spNavs[si] };
                mut lis.pushBack("<li data-verified=\"" + verStr + "\"><a href=\"" + escapeHtml(href) + "\"" + cls + ">" + escapeHtml(dispLabel) + "</a></li>");
            }
            si = si + 1;
        }
        cnt := lis.length();
        if cnt > 0 {
            openAttr := if hasActive { " open" } else { "" };
            mut grpBlocks.pushBack("<details class=\"portal-nav-group\"" + openAttr + ">\n"
            + "        <summary>" + escapeHtml(grpTitles[gi]) + " (" + cnt.toText() + ")</summary>\n"
            + "        <ul class=\"portal-nav-list\">\n"
            + "          " + text.joinTexts(lis, "\n            ") + "\n"
            + "        </ul>\n"
            + "      </details>");
        }
        gi = gi + 1;
    }

    "<aside class=\"portal-sidebar\" aria-label=\"Specification navigation\">\n"
    + "      <div class=\"docs-layer-tabs\" role=\"tablist\" aria-label=\"Documentation layer\">\n"
    + "        <a class=\"docs-layer-tab\" href=\"" + escapeHtml(hbIndexHref) + "\">Handbook</a>\n"
    + "        <span class=\"docs-layer-tab active\" aria-selected=\"true\">Design Spec</span>\n"
    + "      </div>\n"
    + "      <input id=\"docs-sidebar-filter\" class=\"docs-sidebar-filter\" type=\"search\" placeholder=\"Filter spec docs...\" aria-label=\"Filter specification documents\">\n"
    + "      <button class=\"docs-quick-search-btn\" type=\"button\" data-open-search><span>Search all docs</span><kbd>&#8984;K</kbd></button>\n"
    + "      <div class=\"docs-sidebar-head\">\n"
    + "        <label class=\"docs-verified-toggle\">\n"
    + "          <input id=\"docs-verified-only\" type=\"checkbox\">\n"
    + "          <span>Verified in TS only</span>\n"
    + "        </label>\n"
    + "        <span id=\"docs-sidebar-count\" class=\"code-card-meta\"></span>\n"
    + "      </div>\n"
    + "      " + text.joinTexts(grpBlocks, "\n      ") + "\n"
    + "    </aside>"
};

replaceFirst := fn(haystack: String, needle: String, replacement: String): String {
    hit := haystack.indexOf(needle, 0);
    if hit < 0 { return haystack; }
    haystack.slice(0, hit) + replacement + haystack.slice(hit + needle.length(), haystack.length())
};

buildSpecGroupTemplates := fn(
dirOutSample: String, spOuts: List<String>, spGroups: List<String>, spNavs: List<String>, spTitles: List<String>, spVerified: List<Bool>
): List<String> {
    grpIds: List<String> = ["start", "design", "proposals", "compiler", "brand"];
    grpTitles: List<String> = ["Start & Overview", "Design Reference", "Proposals (LP)", "Compiler & Contribute", "Brand & Identity"];
    out: mut List<String> = [];
    var gi := 0;
    loop gi < 5 {
        gid := grpIds[gi];
        lis: mut List<String> = [];
        var si := 0;
        loop si < spOuts.length() {
            if spGroups[si] == gid {
                tOut := spOuts[si];
                href := relativeHref(dirOutSample, tOut);
                verStr := if spVerified[si] { "true" } else { "false" };
                dispLabel := if spTitles.length() > si and spTitles[si] =!= "" { spTitles[si] } else { spNavs[si] };
                mut lis.pushBack("<li data-verified=\"" + verStr + "\"><a href=\"" + escapeHtml(href) + "\">" + escapeHtml(dispLabel) + "</a></li>");
            }
            si = si + 1;
        }
        cnt := lis.length();
        if cnt > 0 {
            openAttr := if gid == "start" { " open" } else { "" };
            mut out.pushBack("<details class=\"portal-nav-group\"" + openAttr + ">\n"
            + "        <summary>" + escapeHtml(grpTitles[gi]) + " (" + cnt.toText() + ")</summary>\n"
            + "        <ul class=\"portal-nav-list\">\n"
            + "          " + text.joinTexts(lis, "\n            ") + "\n"
            + "        </ul>\n"
            + "      </details>");
        } else {
            mut out.pushBack("");
        }
        gi = gi + 1;
    }
    out
};

renderSpecSidebarFromTemplates := fn(
activeOutPath: String, activeGroup: String, tmpls: List<String>, baseIdx: Int
): String {
    hbIndexHref := relativeHref(activeOutPath, "docs/handbook/overview-and-setup.html");
    grpIds: List<String> = ["start", "design", "proposals", "compiler", "brand"];
    activeHref := escapeHtml(siteLib.posixBasename(activeOutPath, ""));
    activeNeedle := "<a href=\"" + activeHref + "\">";
    activeRepl := "<a href=\"" + activeHref + "\" class=\"active\">";
    grpBlocks: mut List<String> = [];
    var gi := 0;
    loop gi < 5 {
        blk := tmpls[baseIdx + gi];
        if blk =!= "" {
            if grpIds[gi] == activeGroup {
                var patched := blk;
                if activeGroup =!= "start" {
                    patched = replaceFirst(patched, "<details class=\"portal-nav-group\">", "<details class=\"portal-nav-group\" open>");
                }
                patched = replaceFirst(patched, activeNeedle, activeRepl);
                mut grpBlocks.pushBack(patched);
            } else {
                mut grpBlocks.pushBack(blk);
            }
        }
        gi = gi + 1;
    }
    "<aside class=\"portal-sidebar\" aria-label=\"Specification navigation\">\n"
    + "      <div class=\"docs-layer-tabs\" role=\"tablist\" aria-label=\"Documentation layer\">\n"
    + "        <a class=\"docs-layer-tab\" href=\"" + escapeHtml(hbIndexHref) + "\">Handbook</a>\n"
    + "        <span class=\"docs-layer-tab active\" aria-selected=\"true\">Design Spec</span>\n"
    + "      </div>\n"
    + "      <input id=\"docs-sidebar-filter\" class=\"docs-sidebar-filter\" type=\"search\" placeholder=\"Filter spec docs...\" aria-label=\"Filter specification documents\">\n"
    + "      <button class=\"docs-quick-search-btn\" type=\"button\" data-open-search><span>Search all docs</span><kbd>&#8984;K</kbd></button>\n"
    + "      <div class=\"docs-sidebar-head\">\n"
    + "        <label class=\"docs-verified-toggle\">\n"
    + "          <input id=\"docs-verified-only\" type=\"checkbox\">\n"
    + "          <span>Verified in TS only</span>\n"
    + "        </label>\n"
    + "        <span id=\"docs-sidebar-count\" class=\"code-card-meta\"></span>\n"
    + "      </div>\n"
    + "      " + text.joinTexts(grpBlocks, "\n      ") + "\n"
    + "    </aside>"
};

rewriteSinglePageChapterHtml := fn(html: String, anchorPrefix: String, hbOutIndex: Map<String, Int>, hbChapterIds: List<String>): String {
    withIds: mut List<String> = [];
    len := html.length();
    var pos := 0;
    loop pos < len {
        idPos := html.indexOf("id=\"", pos);
        if idPos < 0 {
            mut withIds.pushBack(html.slice(pos, len));
            break;
        }
        atBoundary := idPos == 0 or isBoundaryBeforeId(html.at(idPos - 1));
        if atBoundary {
            qEnd := html.indexOf("\"", idPos + 4);
            if qEnd > idPos + 4 {
                mut withIds.pushBack(html.slice(pos, idPos + 4) + anchorPrefix + html.slice(idPos + 4, qEnd + 1));
                pos = qEnd + 1;
                continue;
            }
        }
        (mut withIds).pushBack(html.slice(pos, idPos + 4));
        pos = idPos + 4;
    }
    step1 := text.joinTexts(withIds, "");

    withLinks: mut List<String> = [];
    sLen := step1.length();
    pos = 0;
    needle := "href=\"";
    nLen := needle.length();
    loop pos < sLen {
        aPos := step1.indexOf(needle, pos);
        if aPos < 0 {
            mut withLinks.pushBack(step1.slice(pos, sLen));
            break;
        }
        atBoundary := aPos == 0 or isBoundaryBeforeId(step1.at(aPos - 1));
        valStart := aPos + nLen;
        if not atBoundary {
            mut withLinks.pushBack(step1.slice(pos, valStart));
            pos = valStart;
            continue;
        }
        qEnd := step1.indexOf("\"", valStart);
        if qEnd < 0 {
            mut withLinks.pushBack(step1.slice(pos, sLen));
            break;
        }
        (mut withLinks).pushBack(step1.slice(pos, valStart));
        rawVal := step1.slice(valStart, qEnd);
        if rawVal.startsWithAt(0, "#") and rawVal.length() > 1 {
            mut withLinks.pushBack("#" + anchorPrefix + rawVal.slice(1, rawVal.length()) + "\"");
        } else if not rawVal.startsWithAt(0, "#") and rawVal.length() > 0 {
            hashPos := rawVal.indexOf("#", 0);
            filePart := if hashPos >= 0 { rawVal.slice(0, hashPos) } else { rawVal };
            resolved := siteLib.posixJoinAndNormalize("docs/handbook", filePart);
            hit := hbOutIndex.getOr(resolved, -1);
            if hit >= 0 {
                if hashPos >= 0 and hashPos + 1 < rawVal.length() {
                    fragPart := rawVal.slice(hashPos + 1, rawVal.length());
                    mut withLinks.pushBack("#h" + (hit + 1).toText() + "-" + fragPart + "\"");
                } else {
                    mut withLinks.pushBack(escapeHtml("#" + hbChapterIds[hit]) + "\"");
                }
            } else {
                mut withLinks.pushBack(rawVal + "\"");
            }
        } else {
            mut withLinks.pushBack(rawVal + "\"");
        }
        pos = qEnd + 1;
    }
    text.joinTexts(withLinks, "")
};

isBoundaryBeforeId := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\n" or ch == "\r" or ch == "<"
};

/** Builds `/docs/` landing, spec index, single-page handbook, per-doc bodies & search entries JSON. */
pub buildDocsPayloadJson := fn(inputJson: String): (ok: Bool, jsonText: String, error: String) {
    repoUrlR := json.readObjectString(inputJson, 0, "repoUrl");
    repoUrl := if repoUrlR.found and repoUrlR.ok { repoUrlR.value } else { "" };

    entriesF := json.findObjectField(inputJson, 0, "entries");
    if not entriesF.found { return (ok = false, jsonText = "", error = "missing entries field"); }
    entryOffs := json.arrayElementOffsets(inputJson, entriesF.valuePos);

    hbSrcs: mut List<String> = [];
    hbOuts: mut List<String> = [];
    hbNavs: mut List<String> = [];
    hbSums: mut List<String> = [];
    hbSlugs: mut List<String> = [];
    hbTitles: mut List<String> = [];
    hbStatuses: mut List<String> = [];
    hbHtmls: mut List<String> = [];
    hbRelated: mut List<String> = [];
    hbTocHtmls: mut List<String> = [];
    hbTocSearchJson: mut List<String> = [];
    hbSubChIdx: mut List<Int> = [];
    hbSubIds: mut List<String> = [];
    hbSubTexts: mut List<String> = [];
    hbSubLabels: mut List<String> = [];

    spSrcs: mut List<String> = [];
    spOuts: mut List<String> = [];
    spGroups: mut List<String> = [];
    spNavs: mut List<String> = [];
    spSums: mut List<String> = [];
    spVerified: mut List<Bool> = [];
    spTitles: mut List<String> = [];
    spStatuses: mut List<String> = [];
    spHtmls: mut List<String> = [];
    spRelated: mut List<String> = [];
    spTocHtmls: mut List<String> = [];
    spTocL2Ids: mut List<String> = [];

    emptyStrs: List<String> = [];

    loop entryOffs as ep {
        mF := json.findObjectField(inputJson, ep, "meta");
        mp := mF.valuePos;
        mSrc := json.readObjectString(inputJson, mp, "sourcePath").value;
        mOut := json.readObjectString(inputJson, mp, "outPath").value;
        mLayer := json.readObjectString(inputJson, mp, "layer").value;
        mGroup := json.readObjectString(inputJson, mp, "group").value;
        mNav := json.readObjectString(inputJson, mp, "navLabel").value;
        sumR := json.readObjectString(inputJson, mp, "summary");
        mSum := if sumR.found and sumR.ok { sumR.value } else { "" };
        slugR := json.readObjectString(inputJson, mp, "chapterSlug");
        mSlug := if slugR.found and slugR.ok { slugR.value } else { "" };
        mVer := json.readObjectBool(inputJson, mp, "verifiedInTs").value;

        dTitleR := json.readObjectString(inputJson, ep, "title");
        dTitle := if dTitleR.found and dTitleR.ok { dTitleR.value } else { "" };
        dStatR := json.readObjectString(inputJson, ep, "status");
        dStatus := if dStatR.found and dStatR.ok { dStatR.value } else { "draft" };
        pHtml := json.readObjectString(inputJson, ep, "processedHtml").value;
        relHtmlR := json.readObjectString(inputJson, ep, "relatedHtml");
        mRel := if relHtmlR.found and relHtmlR.ok { relHtmlR.value } else { "" };

        curHbIdx := hbOuts.length();
        tocItemsHtml: mut List<String> = [];
        tocL2Parts: mut List<String> = [];
        tocF := json.findObjectField(inputJson, ep, "toc");
        if tocF.found {
            loop json.arrayElementOffsets(inputJson, tocF.valuePos) as tp {
                lvl := json.readObjectInt(inputJson, tp, "level").value;
                tid := json.readObjectString(inputJson, tp, "id").value;
                ttxt := json.readObjectString(inputJson, tp, "text").value;
                labelHtmlR := json.readObjectString(inputJson, tp, "labelHtml");
                tocLabel := if labelHtmlR.found and labelHtmlR.ok and labelHtmlR.value =!= "" { labelHtmlR.value } else { escapeHtml(ttxt) };
                skipNextChapter := mLayer == "handbook" and ttxt == "Next Chapter";
                if (lvl == 2 or lvl == 3) and not skipNextChapter {
                    mut tocItemsHtml.pushBack("<li class=\"toc-l" + lvl.toText() + "\"><a href=\"#" + escapeHtml(tid) + "\">" + tocLabel + "</a></li>");
                }
                if lvl == 2 and not skipNextChapter {
                    if mLayer == "handbook" {
                        mut hbSubChIdx.pushBack(curHbIdx);
                        mut hbSubIds.pushBack(tid);
                        mut hbSubTexts.pushBack(ttxt);
                        mut hbSubLabels.pushBack(tocLabel);
                    }
                    dispTitle := if dTitle =!= "" { dTitle } else { mNav };
                    mut tocL2Parts.pushBack("{\"kind\":" + json.quoteString(if mLayer == "handbook" { "handbook" } else { "doc" })
                    + ",\"title\":" + json.quoteString(dispTitle + " § " + ttxt)
                    + ",\"subtitle\":" + json.quoteString(mSrc)
                    + ",\"href\":" + json.quoteString(mOut + "#" + tid)
                    + ",\"keywords\":" + json.quoteString(dTitle + " " + ttxt + " " + mSrc)
                    + ",\"badge\":\"section\"}");
                }
            }
        }
        tocHtml := if tocItemsHtml.length() > 0 { text.joinTexts(tocItemsHtml, "\n      ") } else { "<li><a href=\"#top\">Top of page</a></li>" };

        if mLayer == "handbook" {
            mut hbSrcs.pushBack(mSrc);
            mut hbOuts.pushBack(mOut);
            mut hbNavs.pushBack(mNav);
            mut hbSums.pushBack(mSum);
            mut hbSlugs.pushBack(mSlug);
            mut hbTitles.pushBack(dTitle);
            mut hbStatuses.pushBack(dStatus);
            mut hbHtmls.pushBack(pHtml);
            mut hbRelated.pushBack(mRel);
            mut hbTocHtmls.pushBack(tocHtml);
            loop tocL2Parts as part { mut hbTocSearchJson.pushBack(part); }
        } else {
            mut spSrcs.pushBack(mSrc);
            mut spOuts.pushBack(mOut);
            mut spGroups.pushBack(mGroup);
            mut spNavs.pushBack(mNav);
            mut spSums.pushBack(mSum);
            mut spVerified.pushBack(mVer);
            mut spTitles.pushBack(dTitle);
            mut spStatuses.pushBack(dStatus);
            mut spHtmls.pushBack(pHtml);
            mut spRelated.pushBack(mRel);
            mut spTocHtmls.pushBack(tocHtml);
            loop tocL2Parts as part { mut spTocL2Ids.pushBack(part); }
        }
    }

    hbCount := hbOuts.length();
    spCount := spOuts.length();

    pagesJson: mut List<String> = [];
    searchEntriesJson: mut List<String> = [
    "{\"kind\":\"handbook\",\"title\":\"Single-Page Lite Handbook\",\"subtitle\":\"All " + hbCount.toText() + " Shipped Handbook chapters on one searchable page\",\"href\":\"docs/handbook/single-page.html\",\"keywords\":\"handbook single page complete shipped guide\",\"badge\":\"Handbook\"}",
    "{\"kind\":\"doc\",\"title\":\"Design Specification Index\",\"subtitle\":\"All design documents, LP proposals, and compiler architecture pages\",\"href\":\"docs/spec/\",\"keywords\":\"design spec proposals compiler index\",\"badge\":\"Spec\"}"
    ];

    hbCards: mut List<String> = [];
    var hi := 0;
    loop hi < hbCount {
        href := relativeHref("docs/index.html", hbOuts[hi]);
        mut hbCards.pushBack("<article class=\"portal-card\">\n"
        + "      <div class=\"portal-card-head\">\n"
        + "        <h3><a href=\"" + escapeHtml(href) + "\">" + escapeHtml(hbNavs[hi]) + "</a></h3>\n"
        + "        <span class=\"status-pill status-pill-shipped\">Verified in TS</span>\n"
        + "      </div>\n"
        + "      <p>" + escapeHtml(hbSums[hi]) + "</p>\n"
        + "      <div class=\"portal-card-foot\">\n"
        + "        <span class=\"code-card-meta\">Handbook</span>\n"
        + "        <a href=\"" + escapeHtml(href) + "\">Read &rarr;</a>\n"
        + "      </div>\n"
        + "    </article>");
        hi = hi + 1;
    }

    specHighlights: mut List<String> = [];
    var si := 0;
    loop si < spCount {
        if (spGroups[si] == "start" or spSrcs[si] == "compiler/README.md") and specHighlights.length() < 6 {
            lbl := statusPillLabel("spec", spGroups[si], spStatuses[si]);
            cls := statusPillClass("spec", spGroups[si], spStatuses[si]);
            href := relativeHref("docs/index.html", spOuts[si]);
            ttl := if spTitles[si] =!= "" { spTitles[si] } else { spNavs[si] };
            noteTxt := if spVerified[si] { "Backed by showcased cases" } else { "Reference document" };
            mut specHighlights.pushBack("<article class=\"portal-card\">\n"
            + "      <div class=\"portal-card-head\">\n"
            + "        <h3><a href=\"" + escapeHtml(href) + "\">" + escapeHtml(ttl) + "</a></h3>\n"
            + "        <span class=\"status-pill " + cls + "\">" + escapeHtml(lbl) + "</span>\n"
            + "      </div>\n"
            + "      <p><code>" + escapeHtml(spSrcs[si]) + "</code></p>\n"
            + "      <div class=\"portal-card-foot\">\n"
            + "        <span class=\"code-card-meta\">" + noteTxt + "</span>\n"
            + "        <a href=\"" + escapeHtml(href) + "\">Open &rarr;</a>\n"
            + "      </div>\n"
            + "    </article>");
        }
        si = si + 1;
    }

    docsLandingBody := "<section class=\"page-hero\">\n"
    + "  <h1>Documentation</h1>\n"
    + "  <p class=\"hero-lead\">\n"
    + "    Structured into two clear layers: the <strong>Shipped Lite Handbook</strong> (100% runnable today) and the full\n"
    + "    <strong>Design Specification &amp; Proposals</strong> archive (" + spCount.toText() + " documents).\n"
    + "  </p>\n"
    + "  <div class=\"hero-actions\">\n"
    + "    <a class=\"btn btn-primary\" href=\"handbook/overview-and-setup.html\">Start Handbook</a>\n"
    + "    <a class=\"btn\" href=\"handbook/single-page.html\">Single-Page Handbook</a>\n"
    + "    <a class=\"btn\" href=\"spec/\">Browse Design Spec (" + spCount.toText() + " docs)</a>\n"
    + "  </div>\n"
    + "</section>\n\n"
    + "<section class=\"section\" id=\"handbook\">\n"
    + "  <div class=\"section-head\">\n"
    + "    <h2>Layer 1 — Shipped Lite Handbook</h2>\n"
    + "    <span class=\"status-pill status-pill-shipped\">Verified in TS</span>\n"
    + "  </div>\n"
    + "  <p class=\"section-note\">Seven sequential chapters covering every language feature, collection type, and module supported by the compiler right now.</p>\n"
    + "  <div class=\"portal-grid\">\n"
    + "    " + text.joinTexts(hbCards, "\n") + "\n"
    + "  </div>\n"
    + "</section>\n\n"
    + "<section class=\"section\" id=\"design-spec\">\n"
    + "  <div class=\"section-head\">\n"
    + "    <h2>Layer 2 — Design Specification, Proposals &amp; Compiler</h2>\n"
    + "    <a href=\"spec/\">All " + spCount.toText() + " spec docs &rarr;</a>\n"
    + "  </div>\n"
    + "  <p class=\"section-note\">\n"
    + "    Normative language contracts (<span class=\"status-pill status-pill-selected\">Selected Design</span>),\n"
    + "    pending designs (<span class=\"status-pill status-pill-proposal\">Working Proposal</span>),\n"
    + "    open questions (<span class=\"status-pill status-pill-open\">Open Question</span>), and dated archives (<span class=\"status-pill status-pill-historical\">Historical</span>).\n"
    + "  </p>\n"
    + "  <div class=\"portal-grid\">\n"
    + "    " + text.joinTexts(specHighlights, "\n") + "\n"
    + "  </div>\n"
    + "</section>";
    mut pagesJson.pushBack("{\"relPath\":\"docs/index.html\",\"title\":\"Docs — Lite\",\"description\":\"Two-layer Lite documentation portal: Shipped Lite Handbook and full Design Specification & Proposals.\",\"basePath\":\"../\",\"body\":" + json.quoteString(docsLandingBody) + "}");

    startCards: mut List<String> = [];
    si = 0;
    loop si < spCount {
        if spGroups[si] == "start" {
            lbl := statusPillLabel("spec", spGroups[si], spStatuses[si]);
            cls := statusPillClass("spec", spGroups[si], spStatuses[si]);
            href := relativeHref("docs/spec/index.html", spOuts[si]);
            ttl := if spTitles[si] =!= "" { spTitles[si] } else { spNavs[si] };
            vTag := if spVerified[si] { "<span class=\"status-pill status-pill-shipped\">Verified in TS</span>" } else { "" };
            mut startCards.pushBack("<article class=\"portal-card\">\n"
            + "        <div class=\"portal-card-head\">\n"
            + "          <h3><a href=\"" + escapeHtml(href) + "\">" + escapeHtml(ttl) + "</a></h3>\n"
            + "          <div>" + vTag + " <span class=\"status-pill " + cls + "\">" + escapeHtml(lbl) + "</span></div>\n"
            + "        </div>\n"
            + "        <p><code>" + escapeHtml(spSrcs[si]) + "</code></p>\n"
            + "      </article>");
        }
        si = si + 1;
    }
    specLandingBody := "<div class=\"portal-layout-2col\">\n"
    + "  " + renderDocsSidebar("spec", "docs/spec/index.html", emptyStrs, emptyStrs, emptyStrs, emptyStrs, hbSubChIdx, emptyStrs, emptyStrs, emptyStrs, spOuts, spGroups, spNavs, spTitles, spVerified) + "\n"
    + "  <article class=\"md-prose\">\n"
    + "    <div class=\"portal-mobile-bar\">\n"
    + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"sidebar\">Spec Menu</button>\n"
    + "    </div>\n"
    + "    <h1>Full Design Specification, Proposals &amp; Compiler Docs</h1>\n"
    + "    <p class=\"hero-lead\">\n"
    + "      Browse all " + spCount.toText() + " design documents, language proposals (<code>LP-0001..LP-0010</code>),\n"
    + "      and compiler architecture guides with explicit status labels distinguishing shipped TS behavior from selected design and open proposals.\n"
    + "    </p>\n"
    + "    <div class=\"portal-grid-2\">\n"
    + "      " + text.joinTexts(startCards, "\n") + "\n"
    + "    </div>\n"
    + "  </article>\n"
    + "</div>";
    mut pagesJson.pushBack("{\"relPath\":\"docs/spec/index.html\",\"title\":\"Design Specification — Docs — Lite\",\"description\":\"LiteLang design specification, proposals, and compiler documentation index.\",\"basePath\":\"../../\",\"body\":" + json.quoteString(specLandingBody) + "}");

    hbChapterIds: mut List<String> = [];
    hbOutIndex: mut Map<String, Int>;
    hi = 0;
    loop hi < hbCount {
        chSlug := if hbSlugs[hi] =!= "" { hbSlugs[hi] } else { hbNavs[hi] };
        mut hbChapterIds.pushBack("chapter-" + chSlug);
        mut hbOutIndex.set(hbOuts[hi], hi);
        hi = hi + 1;
    }
    chBlocks: mut List<String> = [];
    singleTocItems: mut List<String> = [];
    hi = 0;
    loop hi < hbCount {
        chSlug := if hbSlugs[hi] =!= "" { hbSlugs[hi] } else { "ch-" + (hi + 1).toText() };
        anchorPrefix := "h" + (hi + 1).toText() + "-";
        rewritten := rewriteSinglePageChapterHtml(hbHtmls[hi], anchorPrefix, hbOutIndex, hbChapterIds);
        mut chBlocks.pushBack("<section class=\"section handbook-single-chapter\" id=\"chapter-" + escapeHtml(chSlug) + "\">\n"
        + "      <div class=\"portal-card-head\" style=\"margin-bottom: 0.5rem;\">\n"
        + "        <span class=\"code-card-meta\">Chapter " + (hi + 1).toText() + "</span>\n"
        + "        <span class=\"status-pill status-pill-shipped\">Verified in TS</span>\n"
        + "      </div>\n"
        + "      " + rewritten + "\n"
        + "    </section>");
        mut singleTocItems.pushBack("<li><a href=\"#chapter-" + escapeHtml(chSlug) + "\">" + escapeHtml(hbNavs[hi]) + "</a></li>");
        hi = hi + 1;
    }
    emptyBools: List<Bool> = [];
    singleBody := "<div class=\"portal-layout\" id=\"top\">\n"
    + "  " + renderDocsSidebar("handbook", "docs/handbook/single-page.html", hbOuts, hbNavs, hbSlugs, hbSums, hbSubChIdx, hbSubIds, hbSubTexts, hbSubLabels, emptyStrs, emptyStrs, emptyStrs, emptyStrs, emptyBools) + "\n"
    + "  <article class=\"md-prose\">\n"
    + "    <div class=\"portal-mobile-bar\">\n"
    + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"sidebar\">Chapters &amp; Topics</button>\n"
    + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"toc\">Chapters Jump</button>\n"
    + "    </div>\n"
    + "    <div class=\"hb-kicker-bar\">\n"
    + "      <nav class=\"hb-breadcrumbs\" aria-label=\"Breadcrumb\">\n"
    + "        <a href=\"../\">Docs</a>\n"
    + "        <span aria-hidden=\"true\">&rsaquo;</span>\n"
    + "        <a href=\"overview-and-setup.html\">Handbook</a>\n"
    + "        <span aria-hidden=\"true\">&rsaquo;</span>\n"
    + "        <span class=\"hb-kicker-chapter\">Single-Page View</span>\n"
    + "      </nav>\n"
    + "      <div class=\"docs-badge-row\"><span class=\"status-pill status-pill-shipped\">100% Runnable in TS</span></div>\n"
    + "    </div>\n"
    + "    <h1>The Lite Handbook (Single-Page Edition)</h1>\n"
    + "    <p class=\"hero-lead\">All seven Shipped Handbook chapters on one page for fast reading, search, or printing.</p>\n"
    + "    " + text.joinTexts(chBlocks, "\n") + "\n"
    + "  </article>\n"
    + "  <aside class=\"portal-toc\" aria-label=\"Chapters\">\n"
    + "    <p class=\"portal-toc-title\">Chapters</p>\n"
    + "    <ul>\n"
    + "      " + text.joinTexts(singleTocItems, "\n      ") + "\n"
    + "    </ul>\n"
    + "    <div class=\"portal-toc-foot\">\n"
    + "      <a href=\"overview-and-setup.html\">Chapter-by-chapter &rarr;</a>\n"
    + "      <a href=\"#top\">&uarr; Back to top</a>\n"
    + "    </div>\n"
    + "  </aside>\n"
    + "</div>";
    mut pagesJson.pushBack("{\"relPath\":\"docs/handbook/single-page.html\",\"title\":\"Single-Page Handbook — Docs — Lite\",\"description\":\"Complete Shipped Lite Handbook on a single searchable page.\",\"basePath\":\"../../\",\"body\":" + json.quoteString(singleBody) + "}");

    hi = 0;
    loop hi < hbCount {
        mSrc := hbSrcs[hi];
        mOut := hbOuts[hi];
        mNav := hbNavs[hi];
        mSum := hbSums[hi];
        dTitle := hbTitles[hi];
        chSlug := if hbSlugs.length() > hi and hbSlugs[hi] =!= "" { hbSlugs[hi] } else { siteLib.posixBasename(mOut, ".html") };
        readMins := estimateReadMinutes(hbHtmls[hi]);
        roadmapHtml := renderChapterRoadmap(hi, hbSubChIdx, hbSubIds, hbSubLabels);
        chapterBodyHtml := injectBeforeFirstH2(hbHtmls[hi], roadmapHtml);
        prevCard := if hi > 0 {
            prevTitle := stripChapterNumPrefix(hbNavs[hi - 1]);
            prevSum := if hbSums.length() > hi - 1 { hbSums[hi - 1] } else { "" };
            "<a class=\"docs-pager-card docs-pager-prev\" href=\"" + escapeHtml(relativeHref(mOut, hbOuts[hi - 1])) + "\" data-pager-prev>\n"
            + "          <span class=\"docs-pager-kicker\">&larr; Previous &middot; Chapter " + hi.toText() + "</span>\n"
            + "          <strong>" + escapeHtml(prevTitle) + "</strong>\n"
            + "          <span class=\"docs-pager-summary\">" + escapeHtml(prevSum) + "</span>\n"
            + "        </a>"
        } else { "<span class=\"docs-pager-spacer\"></span>" };
        nextCard := if hi + 1 < hbCount {
            nextTitle := stripChapterNumPrefix(hbNavs[hi + 1]);
            nextSum := if hbSums.length() > hi + 1 { hbSums[hi + 1] } else { "" };
            "<a class=\"docs-pager-card docs-pager-next\" href=\"" + escapeHtml(relativeHref(mOut, hbOuts[hi + 1])) + "\" data-pager-next>\n"
            + "          <span class=\"docs-pager-kicker\">Next &middot; Chapter " + (hi + 2).toText() + " &rarr;</span>\n"
            + "          <strong>" + escapeHtml(nextTitle) + "</strong>\n"
            + "          <span class=\"docs-pager-summary\">" + escapeHtml(nextSum) + "</span>\n"
            + "        </a>"
        } else {
            "<a class=\"docs-pager-card docs-pager-next\" href=\"" + escapeHtml(relativeHref(mOut, "learn/")) + "\" data-pager-next>\n"
            + "          <span class=\"docs-pager-kicker\">Continue Learning &rarr;</span>\n"
            + "          <strong>Interactive Learn Studio</strong>\n"
            + "          <span class=\"docs-pager-summary\">Practice all " + hbCount.toText() + " Handbook chapters in live browser exercises and tutorials.</span>\n"
            + "        </a>"
        };
        editLink := if repoUrl =!= "" {
            "<a href=\"" + escapeHtml(repoUrl + "/blob/main/" + mSrc) + "\">View source (<code>" + escapeHtml(mSrc) + "</code>) &rarr;</a>"
        } else {
            "<code>" + escapeHtml(mSrc) + "</code>"
        };
        tocEditLink := if repoUrl =!= "" {
            "\n      <a href=\"" + escapeHtml(repoUrl + "/blob/main/" + mSrc) + "\">View source</a>"
        } else { "" };
        relBlock := if hbRelated[hi] =!= "" { "\n    " + hbRelated[hi] } else { "" };
        body := "<div class=\"portal-layout\" id=\"top\">\n"
        + "  " + renderDocsSidebar("handbook", mOut, hbOuts, hbNavs, hbSlugs, hbSums, hbSubChIdx, hbSubIds, hbSubTexts, hbSubLabels, spOuts, spGroups, spNavs, spTitles, spVerified) + "\n"
        + "  <article class=\"md-prose\" data-handbook-slug=\"" + escapeHtml(chSlug) + "\">\n"
        + "    <div class=\"portal-mobile-bar\">\n"
        + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"sidebar\">Chapters &amp; Topics</button>\n"
        + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"toc\">On This Page</button>\n"
        + "    </div>\n"
        + "    <div class=\"hb-kicker-bar\">\n"
        + "      <nav class=\"hb-breadcrumbs\" aria-label=\"Breadcrumb\">\n"
        + "        <a href=\"" + escapeHtml(relativeHref(mOut, "docs/index.html")) + "\">Docs</a>\n"
        + "        <span aria-hidden=\"true\">&rsaquo;</span>\n"
        + "        <a href=\"" + escapeHtml(relativeHref(mOut, "docs/handbook/overview-and-setup.html")) + "\">Handbook</a>\n"
        + "        <span aria-hidden=\"true\">&rsaquo;</span>\n"
        + "        <span class=\"hb-kicker-chapter\">Chapter " + (hi + 1).toText() + " of " + hbCount.toText() + " &middot; " + escapeHtml(handbookPartName(hi)) + "</span>\n"
        + "      </nav>\n"
        + "      <div class=\"docs-badge-row\">\n"
        + "        <span class=\"code-card-meta\">~" + readMins.toText() + " min read</span>\n"
        + "        <span class=\"status-pill status-pill-shipped\">Verified in TS</span>\n"
        + "      </div>\n"
        + "    </div>\n"
        + "    " + chapterBodyHtml
        + relBlock + "\n"
        + "    <footer class=\"docs-page-footer\">\n"
        + "      <div class=\"docs-source-row\">" + editLink + " <span class=\"code-card-meta\">&middot; Shortcuts: <kbd>[</kbd> Prev &middot; <kbd>]</kbd> Next &middot; <kbd>/</kbd> Search</span></div>\n"
        + "      <nav class=\"docs-pager docs-pager-cards\" aria-label=\"Previous and next chapter\">\n"
        + "        " + prevCard + "\n"
        + "        " + nextCard + "\n"
        + "      </nav>\n"
        + "    </footer>\n"
        + "  </article>\n"
        + "  <aside class=\"portal-toc\" aria-label=\"On this page\">\n"
        + "    <p class=\"portal-toc-title\">On This Page</p>\n"
        + "    <ul>\n"
        + "      " + hbTocHtmls[hi] + "\n"
        + "    </ul>\n"
        + "    <div class=\"portal-toc-foot\">\n"
        + "      <a href=\"single-page.html\">Single-page view</a>" + tocEditLink + "\n"
        + "      <a href=\"#top\">&uarr; Back to top</a>\n"
        + "    </div>\n"
        + "  </aside>\n"
        + "</div>";
        dispTitle := if dTitle =!= "" { dTitle } else { mNav };
        pTitle := dispTitle + " — Handbook — Lite";
        pDesc := if mSum =!= "" { mSum } else { dTitle + " (" + mSrc + ")" };
        mut pagesJson.pushBack("{\"relPath\":" + json.quoteString(mOut) + ",\"title\":" + json.quoteString(pTitle) + ",\"description\":" + json.quoteString(pDesc) + ",\"basePath\":\"../../\",\"body\":" + json.quoteString(body) + "}");
        mut searchEntriesJson.pushBack("{\"kind\":\"handbook\",\"title\":" + json.quoteString(dispTitle) + ",\"subtitle\":" + json.quoteString(if mSum =!= "" { mSum } else { mSrc }) + ",\"href\":" + json.quoteString(mOut) + ",\"keywords\":" + json.quoteString(mSrc + " " + mNav + " " + dTitle) + ",\"badge\":\"Verified in TS\"}");
        hi = hi + 1;
    }

    specDirIndex: mut Map<String, Int>;
    var specDirCount := 0;
    specDirTmpls: mut List<String> = [];
    si = 0;
    loop si < spCount {
        mSrc := spSrcs[si];
        mOut := spOuts[si];
        mGrp := spGroups[si];
        mNav := spNavs[si];
        mSum := spSums[si];
        dTitle := spTitles[si];
        mDir := siteLib.posixDirname(mOut);
        var dirIdx := specDirIndex.getOr(mDir, -1);
        if dirIdx < 0 {
            dirIdx = specDirCount;
            specDirCount = specDirCount + 1;
            mut specDirIndex.set(mDir, dirIdx);
            builtTmpls := buildSpecGroupTemplates(mOut, spOuts, spGroups, spNavs, spTitles, spVerified);
            var ti := 0;
            loop ti < 5 {
                mut specDirTmpls.pushBack(builtTmpls[ti]);
                ti = ti + 1;
            }
        }
        lbl := statusPillLabel("spec", mGrp, spStatuses[si]);
        cls := statusPillClass("spec", mGrp, spStatuses[si]);
        vBadge := if spVerified[si] { "<span class=\"status-pill status-pill-shipped\">Verified in TS</span>" } else { "" };
        prevLink := if si > 0 {
            "<a class=\"btn\" href=\"" + escapeHtml(relativeHref(mOut, spOuts[si - 1])) + "\" data-pager-prev>&larr; " + escapeHtml(spNavs[si - 1]) + "</a>"
        } else { "<span></span>" };
        nextLink := if si + 1 < spCount {
            "<a class=\"btn\" href=\"" + escapeHtml(relativeHref(mOut, spOuts[si + 1])) + "\" data-pager-next>" + escapeHtml(spNavs[si + 1]) + " &rarr;</a>"
        } else { "<span></span>" };
        editLink := if repoUrl =!= "" {
            "<a href=\"" + escapeHtml(repoUrl + "/blob/main/" + mSrc) + "\">View source (<code>" + escapeHtml(mSrc) + "</code>) &rarr;</a>"
        } else {
            "<code>" + escapeHtml(mSrc) + "</code>"
        };
        relBlock := if spRelated[si] =!= "" { "\n    " + spRelated[si] } else { "" };
        body := "<div class=\"portal-layout\" id=\"top\">\n"
        + "  " + renderSpecSidebarFromTemplates(mOut, mGrp, specDirTmpls, dirIdx * 5) + "\n"
        + "  <article class=\"md-prose\">\n"
        + "    <div class=\"portal-mobile-bar\">\n"
        + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"sidebar\">Spec Menu</button>\n"
        + "      <button class=\"btn\" type=\"button\" data-drawer-toggle=\"toc\">On This Page</button>\n"
        + "    </div>\n"
        + "    <div class=\"portal-card-head\" style=\"margin-bottom: 0.65rem;\">\n"
        + "      <span class=\"code-card-meta\"><a href=\"" + escapeHtml(relativeHref(mOut, "docs/index.html")) + "\">Docs</a> / Design Spec</span>\n"
        + "      <div class=\"docs-badge-row\">" + vBadge + "<span class=\"status-pill " + cls + "\">" + escapeHtml(lbl) + "</span></div>\n"
        + "    </div>\n"
        + "    " + spHtmls[si]
        + relBlock + "\n"
        + "    <footer class=\"docs-page-footer\">\n"
        + "      <div class=\"docs-source-row\">" + editLink + "</div>\n"
        + "      <nav class=\"docs-pager\" aria-label=\"Previous and next document\">\n"
        + "        " + prevLink + "\n"
        + "        " + nextLink + "\n"
        + "      </nav>\n"
        + "    </footer>\n"
        + "  </article>\n"
        + "  <aside class=\"portal-toc\" aria-label=\"On this page\">\n"
        + "    <p class=\"portal-toc-title\">On This Page</p>\n"
        + "    <ul>\n"
        + "      " + spTocHtmls[si] + "\n"
        + "    </ul>\n"
        + "  </aside>\n"
        + "</div>";
        dispTitle := if dTitle =!= "" { dTitle } else { mNav };
        pTitle := dispTitle + " — Design Spec — Lite";
        pDesc := if mSum =!= "" { mSum } else { dTitle + " (" + mSrc + ")" };
        mut pagesJson.pushBack("{\"relPath\":" + json.quoteString(mOut) + ",\"title\":" + json.quoteString(pTitle) + ",\"description\":" + json.quoteString(pDesc) + ",\"basePath\":\"../../\",\"body\":" + json.quoteString(body) + "}");
        mut searchEntriesJson.pushBack("{\"kind\":\"doc\",\"title\":" + json.quoteString(dispTitle) + ",\"subtitle\":" + json.quoteString(if mSum =!= "" { mSum } else { mSrc }) + ",\"href\":" + json.quoteString(mOut) + ",\"keywords\":" + json.quoteString(mSrc + " " + mNav + " " + dTitle) + ",\"badge\":" + json.quoteString(lbl) + "}");
        si = si + 1;
    }

    loop hbTocSearchJson as hse { mut searchEntriesJson.pushBack(hse); }
    loop spTocL2Ids as sse { mut searchEntriesJson.pushBack(sse); }

    docsPageCount := pagesJson.length();
    (ok = true, jsonText = "{\"docsPageCount\":" + docsPageCount.toText() + ",\"handbookCount\":" + hbCount.toText() + ",\"specCount\":" + spCount.toText() + ",\"pages\":[" + text.joinTexts(pagesJson, ",") + "],\"searchEntries\":[" + text.joinTexts(searchEntriesJson, ",") + "]}", error = "")
};
