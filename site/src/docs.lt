        if spRelated[si] =!= "" {
            mut spBodyOut.append("\n    ");
            mut spBodyOut.append(spRelated[si]);
        }
        mut spBodyOut.append("\n    <footer class=\"docs-page-footer\">\n      <div class=\"docs-source-row\">");
        mut spBodyOut.append(editLink);
        mut spBodyOut.append("</div>\n      <nav class=\"docs-pager\" aria-label=\"Previous and next document\">\n        ");
        mut spBodyOut.append(prevLink);
        mut spBodyOut.append("\n        ");
        mut spBodyOut.append(nextLink);
        mut spBodyOut.append("\n      </nav>\n    </footer>\n  </article>\n  <aside class=\"portal-toc\" aria-label=\"On this page\">\n    <p class=\"portal-toc-title\">On This Page</p>\n    <ul>\n      ");
        mut spBodyOut.append(spTocHtmls[si]);
        mut spBodyOut.append("\n    </ul>\n  </aside>\n</div>");
        dispTitle := if dTitle =!= "" { dTitle } else { mNav };
        pTitle := dispTitle + (if isGuide { " — Guide — Lite" } else { " — Design Spec — Lite" });
        pDesc := if mSum =!= "" { mSum } else { dTitle + " (" + mSrc + ")" };
        mut spPageEntry: tb.TextBuilder;
        mut spPageEntry.append("{\"relPath\":");
        mut spPageEntry.append(json.quoteString(mOut));
        mut spPageEntry.append(",\"title\":");
        mut spPageEntry.append(json.quoteString(pTitle));
        mut spPageEntry.append(",\"description\":");
        mut spPageEntry.append(json.quoteString(pDesc));
        mut spPageEntry.append(",\"basePath\":\"../../\",\"body\":");
        mut spPageEntry.append(json.quoteString(spBodyOut.build()));
        mut spPageEntry.append("}");
        mut pagesJson.pushBack(spPageEntry.build());

        mut spSearchEntry: tb.TextBuilder;
        mut spSearchEntry.append("{\"kind\":\"doc\",\"title\":");
        mut spSearchEntry.append(json.quoteString(dispTitle));
        mut spSearchEntry.append(",\"subtitle\":");
        mut spSearchEntry.append(json.quoteString(if mSum =!= "" { mSum } else { mSrc }));
        mut spSearchEntry.append(",\"href\":");
        mut spSearchEntry.append(json.quoteString(mOut));
        mut spSearchEntry.append(",\"keywords\":");
        mut spSearchEntry.append(json.quoteString(mSrc + " " + mNav + " " + dTitle));
        mut spSearchEntry.append(",\"badge\":");
        mut spSearchEntry.append(json.quoteString(lbl));
        mut spSearchEntry.append("}");
        mut searchEntriesJson.pushBack(spSearchEntry.build());
        si = si + 1;
    }

    loop hbTocSearchJson as hse { mut searchEntriesJson.pushBack(hse); }
    loop spTocL2Ids as sse { mut searchEntriesJson.pushBack(sse); }

    docsPageCount := pagesJson.length();
    mut payloadOut: tb.TextBuilder;
    mut payloadOut.append("{\"docsPageCount\":");
    mut payloadOut.append(docsPageCount.toText());
    mut payloadOut.append(",\"handbookCount\":");
    mut payloadOut.append(hbCount.toText());
    mut payloadOut.append(",\"specCount\":");
    mut payloadOut.append(spCount.toText());
    mut payloadOut.append(",\"pages\":[");
    mut payloadOut.append(pagesJson.join(","));
    mut payloadOut.append("],\"searchEntries\":[");
    mut payloadOut.append(searchEntriesJson.join(","));
    mut payloadOut.append("]}");
    (ok = true, jsonText = payloadOut.build(), error = "")
};
