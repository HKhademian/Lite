/* Bouncing Lite mark with RGBA shadow and wall-bounce chimes. */

audio := import "extra/audio";
board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.play(width = 48, height = 32, title = "Bounce · ℓite Mark");
bg := canvas.rgb(11, 14, 24);
shadow := canvas.rgba(0, 0, 0, 110);
border := canvas.rgba(255, 255, 255, 28);
palette: List<canvas.Color> = [
canvas.rgb(240, 180, 90),
canvas.rgb(110, 196, 216),
canvas.rgb(137, 201, 131),
canvas.rgb(198, 154, 232),
];
notes: List<Int> = [330, 392, 494, 587];
sprite: List<String> = [
"...##..",
"..#..#.",
"..#..#.",
".###...",
".#..#..",
".#..#..",
"..###..",
];
spriteW := 7;
spriteH := 7;

var px := 4;
var py := 4;
var dx := 1;
var dy := 1;
var colorIdx := 0;
var acc := 0.0;

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(0, 0, ctx.width, ctx.height, border);
    board.drawSprite(px + 1, py + 1, sprite, "#", shadow);
    board.drawSprite(px, py, sprite, "#", palette[colorIdx]);
}

onCanvasInit := fn(): Unit {
    render();
}

onCanvasUpdate := fn(dt: Float): Int {
    acc = acc + dt;
    if acc >= 0.05 {
        acc = 0.0;
        nx := px + dx;
        ny := py + dy;
        var bounced := false;
        if nx < 1 or nx > ctx.width - spriteW - 1 {
            dx = 0 - dx;
            bounced = true;
        } else {
            px = nx;
        }
        if ny < 1 or ny > ctx.height - spriteH - 1 {
            dy = 0 - dy;
            bounced = true;
        } else {
            py = ny;
        }
        if bounced {
            colorIdx = (colorIdx + 1) % 4;
            audio.tone(frequency = notes[colorIdx], durationMs = 70, volume = 14);
        }
        render();
    }
    0
}

render();
io.outputLine("Canvas:", ctx.title, ctx.width, "x", ctx.height);
