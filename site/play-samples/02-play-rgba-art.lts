/* Static RGBA canvas composition with layered translucent geometry. */

board := import "extra/board";
canvas := import "extra/canvas";
io := import "core/io";

ctx := canvas.create(width = 36, height = 24, title = "Layered RGBA Composition");
backdrop := canvas.rgb(13, 17, 28);
gridTint := canvas.rgba(255, 255, 255, 16);
amberGlass := canvas.rgba(240, 180, 90, 190);
cyanGlass := canvas.rgba(110, 196, 216, 175);
plumGlass := canvas.rgba(198, 154, 232, 165);
frameTint := canvas.rgba(240, 180, 90, 220);

canvas.clear(backdrop);
var x := 0;
loop x < ctx.width {
    canvas.fillRect(x, 0, 1, ctx.height, gridTint);
    x += 4;
}
var y := 0;
loop y < ctx.height {
    canvas.fillRect(0, y, ctx.width, 1, gridTint);
    y += 4;
}

board.fillCircle(12, 11, 7, cyanGlass);
board.fillCircle(20, 10, 7, amberGlass);
board.fillCircle(17, 15, 6, plumGlass);
board.drawRect(1, 1, ctx.width - 2, ctx.height - 2, frameTint);
board.drawLine(3, 20, 32, 3, canvas.rgba(255, 255, 255, 110));

io.outputLine("Rendered:", ctx.title, ctx.width, "x", ctx.height);
