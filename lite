#!/bin/sh
# lite CLI: dispatcher for run, check, compile, docs and help.

lite_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd) || exit 1

usage() {
    printf '%s\n' 'Usage: ./lite <command> [options]'
    printf '%s\n' ''
    printf '%s\n' 'Commands:'
    printf '%s\n' '  run [--check] file.lts [-- argument ...]  Run a Lite source'
    printf '%s\n' '  check file.lts                            Check source only'
    printf '%s\n' '  compile --target ts|c file.lts            Compile to TS or C'
    printf '%s\n' '  verify [--all|--update|--coverage]        Verify changed cases (--all for everything)'
    printf '%s\n' '  test [--fast|--full]                      Run the project test suite'
    printf '%s\n' '  docs                                      Show documentation paths'
    printf '%s\n' '  help                                      Show this help'
    printf '%s\n' ''
    printf '%s\n' 'Compiler entry points: ./ltc, ./litec, ./lite compile'
    printf '%s\n' 'Reserved names: ./ltl/lite link, lite fmt'
}

docs() {
    printf '%s\n' 'Lite documentation:'
    printf '  %s\n' "$lite_dir/docs/README.md"
    printf '  %s\n' "$lite_dir/docs/spec/README.md"
    printf '  %s\n' "$lite_dir/compiler/README.md"
    printf '  %s\n' "$lite_dir/examples/README.md"
    printf '  %s\n' "$lite_dir/samples/list.md"
    printf '  %s\n' "$lite_dir/igniter/README.md"
    printf '  %s\n' "$lite_dir/igniter/tests/README.md"
    printf '  %s\n' "$lite_dir/verifications/README.md"
    printf '  %s\n' "$lite_dir/investigations/TOPICS.md"
}

case "${1-}" in
    help|--help|-h)
        usage
        exit 0
        ;;
    docs)
        shift
        if [ "$#" -gt 0 ]; then
            printf '%s\n' "lite docs: unknown topic $1" >&2
            printf '%s\n' 'Run ./lite docs for the complete list.' >&2
            exit 2
        fi
        docs
        exit 0
        ;;
    compile)
        shift
        exec "$lite_dir/litec" "$@"
        ;;
    verify)
        shift
        exec node "$lite_dir/igniter/verify.ts" "$@"
        ;;
    test)
        shift
        test_mode=full
        case "${1-}" in
            --fast) test_mode=fast; shift ;;
            --full) test_mode=full; shift ;;
            "") ;;
            *) printf '%s\n' "lite test: unknown option $1" >&2; exit 2 ;;
        esac
        if [ "$#" -ne 0 ]; then
            printf '%s\n' 'Usage: ./lite test [--fast|--full]' >&2
            exit 2
        fi
        cd "$lite_dir/igniter" || exit 1
        if [ "$test_mode" = fast ]; then
            LITE_SKIP_NATIVE=1 exec node --test test.ts
        else
            exec node --test test.ts
        fi
        ;;
    check)
        shift
        if [ "$#" -lt 1 ]; then
            printf '%s\n' 'Usage: ./lite check file.lts' >&2
            exit 2
        fi
        exec node "$lite_dir/igniter/cli.ts" --check "$@"
        ;;
    run)
        shift
        if [ "$#" -lt 1 ]; then
            usage >&2
            exit 2
        fi
        exec node "$lite_dir/igniter/cli.ts" "$@"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
