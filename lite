#!/bin/sh

lite_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd) || exit 1

if [ "${1-}" = compile ]; then
    shift
    exec "$lite_dir/litec" "$@"
fi

if [ "${1-}" != run ] || [ "$#" -lt 2 ]; then
    printf '%s\n' 'Usage: ./lite run [--check] file.lts [-- argument ...]' >&2
    printf '%s\n' '       ./lite compile --target ts|c file.lts' >&2
    exit 2
fi

shift
exec node "$lite_dir/igniter/cli.ts" "$@"
