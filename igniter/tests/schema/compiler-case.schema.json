{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite.local/schema/compiler-case.schema.json",
  "title": "Lite compiler verification case",
  "description": "One compiler fixture manifest under igniter/tests/compiler/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "source", "cases"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "oneOf": [
        { "required": ["file"] },
        { "required": ["text"] },
        { "required": ["bytes"] }
      ]
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": {
        "text": { "type": "string" },
        "bytes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "file": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "oneOf": [
        { "required": ["text"] },
        { "required": ["bytes"] },
        { "required": ["file"] }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exitCode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "stdin": { "$ref": "#/$defs/stream" },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    }
  }
}
