io := import "core/io";

tokens := [
    (kind = "number", text = "12"),
    (kind = "symbol", text = "+"),
    (kind = "number", text = "30"),
];
loop tokens as token {
    io.outputLine(token.kind, token.text);
}
index := io.inputInt("Token index: ");
io.outputLine(tokens[index].text);

sum := fn(values: [Int; 3]): Int {
    var total := 0;
    loop values as value {
        total += value;
    }
    total
}
io.outputLine("sum:", sum([10, 20, 30]));
