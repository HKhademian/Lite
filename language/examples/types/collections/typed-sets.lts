io := import "core/io";

mut tags: Set<String> = ["lite", "typed"];
mut tags.add("lite");

snapshot: Set<String> = tags;
mut tags.remove("lite");

io.outputLine("live:", tags, "has lite:", tags.has("lite"));
io.outputLine("snapshot size:", snapshot.size(), "values:", snapshot.values());
loop snapshot as tag {
    io.outputLine(tag);
}
