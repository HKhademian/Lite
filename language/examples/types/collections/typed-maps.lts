io := import "core/io";

mut scores: Map<String, Int> = ["alice" = 10];
mut scores.set("bob", 25);
scores["alice"] += 8;

snapshot: Map<String, Int> = scores;
mut scores.remove("bob");

io.outputLine("alice:", scores["alice"], "has bob:", scores.has("bob"));
io.outputLine("fallback:", scores.getOr("bob", 0), "snapshot size:", snapshot.size());
loop snapshot as entry {
    io.outputLine(entry.key, entry.value);
}
