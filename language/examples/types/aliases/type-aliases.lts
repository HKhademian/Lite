/* Type aliases: transparent named contracts with zero runtime memory. */

io := import "core/io";

Token := alias (kind: String, text: String);
Tokens := alias List<Token>;

describe := fn(token: Token): String {
    token.kind + ": " + token.text
}

mut tokens: Tokens = [];
mut tokens.pushBack((kind = "ident", text = "total"));
mut tokens.pushBack((kind = "op", text = "+="));
mut tokens.pushBack((kind = "num", text = "100"));

loop tokens as token {
    io.outputLine(describe(token));
}
