/* A small integer calculator, written entirely in the supported Lite subset. */

io := import "core/io";
text := import "core/text";

list := import "core/list";
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

tokenize := fn(line: String): List<(kind: String, text: String)> {
    tokens: mut List<(kind: String, text: String)> = [];
    size := text.length(line);
    var position := 0;
    loop position < size {
        ch := text.at(line, position);
        if ch == " " or ch == "\t" {
            position = position + 1;
            continue;
        }
        if isDigit(ch) {
            start := position;
            position = position + 1;
            loop position < size and isDigit(text.at(line, position)) {
                position = position + 1;
            }
            list.pushBack(mut tokens, (kind = "number", text = text.slice(line, start, position)));
            continue;
        }
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "(" or ch == ")" {
            list.pushBack(mut tokens, (kind = "symbol", text = ch));
            position = position + 1;
            continue;
        }
        io.errorLine("unsupported symbol: " + ch);
        io.exit(2);
    }
    tokens
}

digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    if text == "9" { return 9; }
    io.errorLine("expected a decimal digit");
    io.exit(2);
}

numberValue := fn(text: String): Int {
    size := text.length(text);
    var position := 0;
    var value := 0;
    loop position < size {
        value = value * 10 + digitValue(text.at(text, position));
        position = position + 1;
    }
    value
}

precedence := fn(operator: String): Int {
    if operator == "+" or operator == "-" { return 10; }
    if operator == "*" or operator == "/" { return 20; }
    0
}

/* Returns the calculated value and the first unconsumed token position. */
parse := fn(tokens: List<(kind: String, text: String)>, count: Int, start: Int, minimum: Int): (:Int, :Int) {
    if start >= count {
        io.errorLine("expected a number or '('");
        io.exit(2);
    }
    token := tokens[start];
    var position := start + 1;
    var value := 0;
    if token.kind == "number" {
        value = numberValue(token.text);
    } else if token.text == "+" or token.text == "-" {
        parsed := self(tokens, count, position, 30);
        value = if token.text == "-" { -parsed.0 } else { parsed.0 }
        position = parsed.1;
    } else if token.text == "(" {
        parsed := self(tokens, count, position, 0);
        value = parsed.0;
        position = parsed.1;
        if position >= count or tokens[position].text =!= ")" {
            io.errorLine("expected ')'");
            io.exit(2);
        }
        position = position + 1;
    } else {
        io.errorLine("expected a number or '('");
        io.exit(2);
    }
    loop position < count {
        operator := tokens[position].text;
        level := precedence(operator);
        if level == 0 or level < minimum { break; }
        right := self(tokens, count, position + 1, level + 1);
        value = if operator == "+" { value + right.0 }
            else if operator == "-" { value - right.0 }
            else if operator == "*" { value * right.0 }
            else { value / right.0 }
        position = right.1;
    }
    (value, position)
}

io.outputLine("Arithmetic expression:");
tokens := tokenize(io.inputLine());
var count := 0;
loop tokens { count = count + 1; }
parsed := parse(tokens, count, 0, 0);
if parsed.1 =!= count {
    io.errorLine("unexpected trailing token: " + tokens[parsed.1].text);
    io.exit(2);
}
io.outputLine("result:", parsed.0);
