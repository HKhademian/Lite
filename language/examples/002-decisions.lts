/* Supply an integer. Try -4, 0, 5, and 12. */

io := import "core/io";

number := io.inputInt("Integer: ");

description := if number < 0 {
    "negative"
} else if number == 0 {
    "zero"
} else {
    "positive"
}
io.outputLine(description);

if 0 <= number < 10 {
    io.outputLine("between zero and nine");
}

/* The division is skipped when number is zero. */
if number =!= 0 and 100 / number > 5 {
    io.outputLine("quotient exceeds five");
}
