/* Supply an integer. Try -4, 0, 5, and 12. */
number := inputInt("Integer: ");

description := if number < 0 {
    "negative"
} else if number == 0 {
    "zero"
} else {
    "positive"
}
outputLine(description);

if 0 <= number < 10 {
    outputLine("between zero and nine");
}

/* The division is skipped when number is zero. */
if number =!= 0 and 100 / number > 5 {
    outputLine("quotient exceeds five");
}
