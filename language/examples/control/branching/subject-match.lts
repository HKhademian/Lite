io := import "core/io";

Reading := record {
    sensor: String;
    level: Int = 0;
    online: Bool = true;
};

classifyLevel := fn(level: Int): String {
    match level {
        0 { "idle" }
        1 or 2 or 3 { "low" }
        >= 90 { "critical" }
        v if 50 <= v < 90 { "elevated" }
        _ { "normal" }
    }
};

summarize := fn(r: Reading): String {
    match r {
        { online == false, = sensor } { sensor + ":offline" }
        { = sensor, = level } { sensor + ":" + classifyLevel(level) }
    }
};

io.outputLine(
    summarize(Reading { sensor = "A", level = 95 }),
    summarize(Reading { sensor = "B", level = 64 }),
    summarize(Reading { sensor = "C", level = 2 }),
    summarize(Reading { sensor = "D", level = 50, online = false })
);

pair := ("warn", code = 429);
action := match pair {
    ("warn", 429 or 503 = code) { "backoff" }
    _ { "continue" }
};
io.outputLine("action:", action);
