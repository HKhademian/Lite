/* Tokenize first, then traverse the retained tokens. */

io := import "core/io";

isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

tokenize := fn(line: String): List<(kind: String, text: String)> {
    mut tokens: List<(kind: String, text: String)> = [];
    size := line.length();
    var position := 0;
    loop position < size {
        ch := line.at(position);
        if ch == " " or ch == "\t" {
            position += 1;
            continue;
        }
        if isDigit(ch) {
            start := position;
            position += 1;
            loop position < size and isDigit(line.at(position)) {
                position += 1;
            }
            (mut tokens).pushBack((kind = "number", text = line.slice(start, position)));
            continue;
        }
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "(" or ch == ")" {
            mut tokens.pushBack((kind = "symbol", text = ch));
            position += 1;
            continue;
        }
        io.errorLine("unsupported symbol: " + ch);
        io.exit(2);
    }
    tokens
}

io.outputLine("Arithmetic expression:");
tokens := tokenize(io.inputLine());
loop tokens as token {
    io.outputLine(token.kind, token.text);
}
