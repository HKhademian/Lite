/* Type aliases: transparent named contracts with zero runtime memory. */

io := import "core/io";
list := import "core/list";

Token := type (kind: String, text: String);
Tokens := type List<Token>;

describe := fn(token: Token): String {
    token.kind + ": " + token.text
}

tokens: mut Tokens = [];
list.pushBack(mut tokens, (kind = "ident", text = "total"));
list.pushBack(mut tokens, (kind = "op", text = "+="));
list.pushBack(mut tokens, (kind = "num", text = "100"));

loop tokens as token {
    io.outputLine(describe(token));
}
