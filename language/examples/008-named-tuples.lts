io := import "core/io";

makeToken := fn(kind: String, text: String): (kind: String, text: String) {
    (= kind, = text)
}

describe := fn(token: (kind: String, text: String)): String {
    token.kind + ": " + token.text
}

token := makeToken("number", "12");
io.outputLine(token.kind, token.text);
io.outputLine(describe(token));
(first, second) := token;
io.outputLine(first, second);

one := (value = 42);
io.outputLine(one.value);
