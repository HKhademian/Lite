/* Select by ordered Boolean conditions with a final _ fallback. */

io := import "core/io";

classify := fn(score: Int): String {
    match {
        score >= 90 { "excellent" }
        score >= 70 { "pass" }
        _ { "retry" }
    }
}

values := [95, 72, 40];
loop values as value {
    label := classify(value);
    tier := match {
        value >= 90 { 3 }
        value >= 70 { 2 }
        _ { 1 }
    };
    var note := "";
    match {
        tier == 3 {
            note = "top tier";
        }
        tier == 2 {
            note = "on track";
        }
        _ {
            note = "review needed";
        }
    }
    io.outputLine(value, "->", label, note);
}
