/* Example 028: Sibling module imports, pub symbols, table formatting, and SHA-256 digests. */

io := import "core/io";
crypto := import "core/crypto";
stats := import "./helpers/stats-module.lts";

alpha: stats.Bucket = stats.makeBucket("alpha", [12, 18, 24]);
beta: stats.Bucket = stats.makeBucket("beta", [7, -5, 19, 14]);

rowA := alpha.name.padRight(7) + " sum=" + alpha.total.toText().padLeft(3) + " avg=" + stats.meanInt(alpha).toText().padLeft(2);
rowB := beta.name.padRight(7) + " sum=" + beta.total.toText().padLeft(3) + " avg=" + stats.meanInt(beta).toText().padLeft(2);
payload := stats.LABEL + "|" + rowA + "|" + rowB;

io.outputLine(stats.LABEL);
io.outputLine(rowA);
io.outputLine(rowB);
io.outputLine("sha256:", crypto.sha256Text(payload));
