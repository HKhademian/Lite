makeToken := fn(kind: String, text: String): (:String, :String) {
    (kind, text)
}

describe := fn(token: (:String, :String)): String {
    token.0 + ": " + token.1
}

token := makeToken("number", "12");
(kind, text) := token;
outputLine(kind);
outputLine(text);
outputLine(describe(token));

one := (42,);
(value,) := one;
outputLine(value);
() := ();
