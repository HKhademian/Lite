io := import "core/io";
/* A recording lasts 3661 seconds. How many hours, minutes, and seconds is that?
   Whole-number division finds complete units; remainder keeps what is left. */

total_seconds: Int16 = 3661;
sec_per_hour: Int16 = 3600;
sec_per_min: Int8 = 60;

hours := total_seconds / sec_per_hour;           /* 1 hour */
seconds_after_hours := total_seconds % sec_per_hour;
minutes := seconds_after_hours / sec_per_min;     /* 1 minute */
seconds := seconds_after_hours % sec_per_min;      /* 1 second */
