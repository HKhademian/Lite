/* Save 100 euros at 5 percent interest per year for 3 years.
   Earn interest only on the original savings. Round once at the end. */

savings_cents := 10000;
annual_percent := 5;
years := 3;

interest_hundredths := (savings_cents * annual_percent) * years;
/* Round to the nearest cent; half a cent rounds up. */
interest_cents := (interest_hundredths + 50) / 100; /* 1500 cents earned */
balance_cents := savings_cents + interest_cents;   /* 11500 cents = 115 euros */
