io := import "core/io";

mut scores: Map<String, Int>;
scores["ada"] = 42;
scores["lin"] = 37;
scores["sam"] = 51;

var bestName := "";
var bestScore := 0;
loop scores as entry {
    if entry.value > bestScore {
        bestName = entry.key;
        bestScore = entry.value;
    }
}
io.outputLine(bestName, bestScore, scores.size());
