io := import "core/io";
/* A warm day is 25 degrees Celsius. What is that in Fahrenheit?
   Then convert 77 degrees Fahrenheit back to Celsius. */

scale_num: Float32 = 9.0;
scale_den: Float32 = 5.0;
freezing: Float32 = 32.0;

celsius: Float32 = 25.0;
fahrenheit := ((celsius * scale_num) / scale_den) + freezing; /* 77 degrees Fahrenheit */

fahrenheit_to_convert: Float32 = 77.0;
celsius_again := ((fahrenheit_to_convert - freezing) * scale_den) / scale_num; /* 25 degrees Celsius */
