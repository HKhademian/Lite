/* Project Tutorial 1: Recursive-descent integer expression evaluator reading lines from stdin. */

integer := import "core/int";
io := import "core/io";
list := import "core/list";
text := import "core/text";

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := text.length(raw);
    var pos := 0;
    loop pos <= n {
        nl := text.indexOfText(raw, "\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and text.at(raw, cleanEnd - 1) == "\r" {
            cleanEnd -= 1;
        }
        list.pushBack(mut out, text.slice(raw, pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

skipSpaces := fn(src: String, start: Int): Int {
    var pos := start;
    n := text.length(src);
    loop pos < n and text.isWhitespace(text.at(src, pos)) {
        pos += 1;
    }
    pos
};

/* Mutually recursive tuple-returning parser (`value`, `next`, `ok`, `error`). */
ParseRes := type (ok: Bool, value: Int, next: Int, error: String);

parseExpr := fn(src: String, pos: Int): ParseRes {
    leftInit := parseTerm(src, pos);
    if not leftInit.ok { return leftInit; }
    var acc := leftInit.value;
    var cursor := skipSpaces(src, leftInit.next);
    n := text.length(src);
    loop cursor < n {
        op := text.at(src, cursor);
        if op =!= "+" and op =!= "-" { break; }
        right := parseTerm(src, cursor + 1);
        if not right.ok { return right; }
        acc = if op == "+" { acc + right.value } else { acc - right.value };
        cursor = skipSpaces(src, right.next);
    }
    (ok = true, value = acc, next = cursor, error = "")
};

parseTerm := fn(src: String, pos: Int): ParseRes {
    leftInit := parseFactor(src, pos);
    if not leftInit.ok { return leftInit; }
    var acc := leftInit.value;
    var cursor := skipSpaces(src, leftInit.next);
    n := text.length(src);
    loop cursor < n {
        op := text.at(src, cursor);
        if op =!= "*" and op =!= "/" and op =!= "%" { break; }
        right := parseFactor(src, cursor + 1);
        if not right.ok { return right; }
        if (op == "/" or op == "%") and right.value == 0 {
            return (ok = false, value = 0, next = cursor, error = "division by zero");
        }
        acc = match {
            op == "*" { acc * right.value }
            op == "/" { acc / right.value }
            _ { acc % right.value }
        };
        cursor = skipSpaces(src, right.next);
    }
    (ok = true, value = acc, next = cursor, error = "")
};

parseFactor := fn(src: String, pos: Int): ParseRes {
    p := skipSpaces(src, pos);
    n := text.length(src);
    if p >= n {
        return (ok = false, value = 0, next = p, error = "unexpected end of input");
    }
    ch := text.at(src, p);
    if ch == "-" {
        inner := self(src, p + 1);
        if not inner.ok { return inner; }
        return (ok = true, value = 0 - inner.value, next = inner.next, error = "");
    }
    if ch == "(" {
        inner := parseExpr(src, p + 1);
        if not inner.ok { return inner; }
        closeAt := skipSpaces(src, inner.next);
        if closeAt >= n or text.at(src, closeAt) =!= ")" {
            return (ok = false, value = 0, next = closeAt, error = "missing ')'");
        }
        return (ok = true, value = inner.value, next = closeAt + 1, error = "");
    }
    if text.isDigit(ch) {
        var endAt := p;
        loop endAt < n and text.isDigit(text.at(src, endAt)) {
            endAt += 1;
        }
        parsed := text.textToInt(text.slice(src, p, endAt));
        if not parsed.ok {
            return (ok = false, value = 0, next = p, error = "integer overflow");
        }
        return (ok = true, value = parsed.value, next = endAt, error = "");
    }
    (ok = false, value = 0, next = p, error = "unexpected token '" + ch + "'")
};

evalLine := fn(line: String): String {
    res := parseExpr(line, 0);
    if not res.ok { return "ERR: " + res.error; }
    rest := skipSpaces(line, res.next);
    if rest < text.length(line) {
        return "ERR: trailing '" + text.at(line, rest) + "'";
    }
    "OK: " + line + " = " + integer.intText(res.value)
};

raw := io.inputAll();
lines := splitLines(raw);
loop lines as line {
    trimmed := text.trim(line);
    if trimmed =!= "" {
        io.outputLine(evalLine(trimmed));
    }
}
