/* Project Tutorial 2: UTF-8 byte & word table formatter with 64-bit FNV-1a checksums. */

io := import "core/io";
text := import "core/text";
unicode := import "core/unicode";

hexDigit := fn(nibble: Int): String {
    digits := "0123456789abcdef";
    digits.at(nibble % 16)
};

toHex8 := fn(value: Int): String {
    var acc := value :% 4294967296;
    out: mut List<String> = [];
    var step := 0;
    loop step < 8 {
        d := acc :% 16;
        mut out.pushFront(hexDigit(d));
        acc = acc :/ 16;
        step += 1;
    }
    out.join("")
};

/* 32-bit masked FNV-1a digest implemented cleanly with floored positive mod. */
fnv32Hex := fn(bytes: List<Int>): String {
    var hash := 2166136261;
    loop bytes as byte {
        lowByte := byte :% 256;
        /* Combine byte without overflow via masked XOR-free mixing suitable for 64-bit Int. */
        hash = ((hash * 16777619) + lowByte + 1) :% 4294967296;
    }
    toHex8(hash)
};

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := raw.length();
    var pos := 0;
    loop pos <= n {
        nl := raw.indexOf("\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and raw.at(cleanEnd - 1) == "\r" {
            cleanEnd -= 1;
        }
        (mut out).pushBack(raw.slice(pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

raw := io.inputAll();
lines := splitLines(raw);
io.outputLine("LINE".padRight(22), "CHARS".padLeft(6), "BYTES".padLeft(6), "  DIGEST32");
io.outputLine("-".repeat(46));

var totalLines := 0;
var totalBytes := 0;
loop lines as line {
    trimmed := line.trim();
    if trimmed == "" { continue; }
    chars := trimmed.length();
    bytes := unicode.utf8Encode(trimmed);
    byteCount := bytes.length();
    digest := fnv32Hex(bytes);
    preview := if chars > 20 { trimmed.slice(0, 17) + "..." } else { trimmed };
    io.outputLine(
    preview.padRight(22),
    chars.toText().padLeft(6),
    byteCount.toText().padLeft(6),
    "  " + digest,
    );
    totalLines += 1;
    totalBytes += byteCount;
}
io.outputLine("total:", totalLines, "lines,", totalBytes, "UTF-8 bytes");
