/* Project Tutorial 3: Play Canvas & Audio mini-game — catch falling orbs with A/D, Arrows, or mouse. */

audio := import "media/audio";
board := import "gfx/board";
canvas := import "gfx/canvas";

ctx := canvas.play(width = 240, height = 160, title = "Orb Catcher · Move: Arrows / Pointer · Space: Reset");
bg := canvas.rgb(12, 16, 28);
paddleW := 36;
paddleH := 7;
paddleY := 142;

var paddleX := 102;
var orbX := 120;
var orbY := 14;
var orbSpeed := 1.4;
var score := 0;
var misses := 0;
var tickCount := 0;
var acc := 0.0;

clampPaddle := fn(x: Int): Int {
    if x < 6 { 6 } else if x > ctx.width - paddleW - 6 { ctx.width - paddleW - 6 } else { x }
};

spawnOrb := fn(seed: Int): Unit {
    orbY = 12;
    orbX = 16 + ((seed * 53 + 29) :% (ctx.width - 32));
};

render := fn(): Unit {
    canvas.clear(bg);
    board.drawRect(3, 3, ctx.width - 6, ctx.height - 6, canvas.rgba(255, 255, 255, 36));
    /* Score pips along top-left */
    var i := 0;
    loop i < score and i < 12 {
        canvas.fillRect(10 + (i * 10), 10, 7, 4, canvas.rgb(104, 212, 168));
        i += 1;
    }
    /* Miss pips along top-right */
    var m := 0;
    loop m < misses and m < 5 {
        canvas.fillRect(ctx.width - 18 - (m * 10), 10, 7, 4, canvas.rgb(240, 108, 108));
        m += 1;
    }
    /* Falling orb + glowing core */
    board.fillCircle(orbX, orbY, 6, canvas.rgb(244, 188, 82));
    board.fillCircle(orbX, orbY, 3, canvas.rgb(255, 244, 204));
    /* Catcher paddle */
    canvas.fillRect(paddleX, paddleY, paddleW, paddleH, canvas.rgb(98, 192, 232));
};

onCanvasInit := fn(): Unit {
    render();
};

onCanvasUpdate := fn(dt: Float): Int {
    acc += dt;
    if acc >= 0.025 {
        acc = 0.0;
        tickCount += 1;
        orbY += 2;
        if tickCount % 40 == 0 and orbY < paddleY - 4 {
            orbY += 1;
        }
        /* Paddle catch check */
        if orbY + 6 >= paddleY and orbY - 6 <= paddleY + paddleH and orbX + 5 >= paddleX and orbX - 5 <= paddleX + paddleW {
            score += 1;
            audio.tone(frequency = 520 + (score * 25), durationMs = 55, volume = 16);
            spawnOrb(tickCount + score * 7);
        } else if orbY > ctx.height - 8 {
            misses += 1;
            audio.tone(frequency = 210, durationMs = 110, volume = 16);
            spawnOrb(tickCount + misses * 13);
        }
        render();
    }
    0
};

onCanvasKeyDown := fn(key: String): Unit {
    if key == "ArrowLeft" or key == "a" or key == "A" {
        paddleX = clampPaddle(paddleX - 16);
        render();
    } else if key == "ArrowRight" or key == "d" or key == "D" {
        paddleX = clampPaddle(paddleX + 16);
        render();
    } else if key == " " {
        score = 0;
        misses = 0;
        spawnOrb(tickCount + 3);
        render();
    }
};

onCanvasPointerMove := fn(col: Int, row: Int): Unit {
    _unusedRow := row;
    paddleX = clampPaddle(col - (paddleW / 2));
    render();
};
