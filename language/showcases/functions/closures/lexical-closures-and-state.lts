/* Showcase 05.03 — Lexical closures capturing var storage, mut Lists, loop items, and escaping frames. */

io := import "core/io";

/* Each invocation of `makeCounter` allocates an independent mutable `current` state. */
makeCounter := fn(start: Int, step: Int): fn(): Int {
    var current := start;
    fn(): Int {
        current = current + step;
        current
    }
};

cFast := makeCounter(0, 5);
cOffset := makeCounter(100, 1);

/* Closures can capture and update a surrounding `mut List` across inner scopes. */
mut events: List<Int> = [];
{
    threshold := 10;
    pushScaled := fn(raw: Int): Unit {
        if raw >= threshold {
            mut events.pushBack(raw * 2);
        }
    };
    pushScaled(7);
    pushScaled(12);
    pushScaled(20);
}

/* Loop-body closures capture each iteration's own `item` value independently. */
mut getters: List<fn(): Int> = [];
scale := 10;
loop [1, 2, 3] as item {
    mut getters.pushBack(fn(): Int { item * scale });
}

io.outputLine("counters:", cFast(), cFast(), cOffset(), cFast());
io.outputLine("events:", events.map(fn(x: Int): String { x.toText() }).join(","));
io.outputLine("loopClosures:", getters[0](), getters[1](), getters[2]());
