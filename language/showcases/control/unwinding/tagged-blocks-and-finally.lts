/* Showcase 02.03 — Labeled @tag exits, conditional then, and LIFO finally cleanup. */

io := import "core/io";

mut log: List<String> = [];

/* Nested `@tag` blocks guarantee inner `finally` unwinds before outer `finally` on non-local exits. */
selected := @pick {
    {
        mut log.pushBack("open-outer");
        {
            mut log.pushBack("open-inner");
            @grid loop [2, 4, 6] as row {
                @col loop [1, 3, 5] as col {
                    if row == 2 and col == 5 { continue @grid; }
                    if row * col >= 12 { return @pick row * col; }
                }
            }
            0
        } finally {
            mut log.pushBack("close-inner");
        }
    } finally {
        mut log.pushBack("close-outer");
    }
};

summary := @tagIf if selected == 12 { "exact-12" } else { "other" } then {
    @tagIf.value + "-checked"
};

io.outputLine("selected:", selected, "summary:", summary);
loop log as entry {
    io.outputLine("trace:", entry);
}
