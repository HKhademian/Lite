/* Showcase 03.03 — Transparent type aliases, static Alias.PROP, scoped Alias.op, and block scoping. */

io := import "core/io";

Point := alias (x: Int, y: Int);
Point.ORIGIN := (x = 3, y = 4);
Point.stepY := fn(p: Self, dy: Int): Self { (x = p.x + 1, y = dy) };
ScoreList := alias List<Int>;

origin: Point = .ORIGIN;
scores: ScoreList = [10, 20, 30];

/* Inner blocks support their own `alias` declarations, including forward references and shadowed names. */
blockSum := do {
    Alias := alias RawPair;
    RawPair := alias (left: Int, right: Int);
    Point := alias String;

    label: Point = "inner";
    pair: Alias = (left = origin.x * 2, right = scores[2]);
    if label == "inner" { pair.left + pair.right } else { 0 }
};

/* The outer `Point` alias and its scoped operation remain intact after the inner block ends. */
nextPoint := origin.stepY(blockSum);
io.outputLine("origin:", origin, "nextPoint:", nextPoint);
