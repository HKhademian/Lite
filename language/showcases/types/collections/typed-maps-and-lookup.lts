io := import "core/io";

/* Map literal initializer with [key = value, ...] entries (empty maps also zero-init) */
prices: mut Map<String, Int> = ["apple" = 3];
mut prices.set("bread", 5);
prices["apple"] += 1;

/* Safe lookups with get / getOr and independent value snapshots */
frozen: Map<String, Int> = prices;
foundBread := prices.get("bread");
missingTea := prices.getOr("tea", 0);

/* Mutation requires mut; frozen snapshot stays untouched */
removed := mut prices.remove("bread");
io.outputLine("apple:", prices["apple"], "bread:", foundBread.found, foundBread.value, "tea:", missingTea);
io.outputLine("removed:", removed, "live size:", prices.size(), "frozen size:", frozen.size());

/* Iterate entries in insertion order */
var total := 0;
loop frozen as entry {
    total += entry.value;
}
io.outputLine("frozen total:", total, "keys:", frozen.keys());
