/* Showcase 06.01 — Namespace and destructured imports of pub types, values, and functions. */

io := import "core/io";
stats := import "./helpers/math-stats.lts";
{ summarize, =span } := import "./helpers/math-stats.lts";

report: stats.RangeStats = summarize([4, 9, 2, 15, 7], 0);

io.outputLine("module:", stats.VERSION);
io.outputLine("min:", report.min, "max:", report.max, "sum:", report.sum, "span:", span(report));
