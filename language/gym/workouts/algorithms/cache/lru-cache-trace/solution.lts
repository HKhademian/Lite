io := import "core/io";
list := import "core/list";
text := import "core/text";

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := raw.length();
    var pos := 0;
    loop pos <= n {
        nl := raw.indexOf("\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and raw.at(cleanEnd - 1) == "\r" { cleanEnd -= 1; }
        (mut out).pushBack(raw.slice(pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

splitSpace := fn(line: String): List<String> {
    out: mut List<String> = [];
    n := line.length();
    var p := 0;
    loop p < n {
        loop p < n and line.at(p).isWhitespace() { p += 1; }
        if p >= n { break; }
        s := p;
        loop p < n and not line.at(p).isWhitespace() { p += 1; }
        (mut out).pushBack(line.slice(s, p));
    }
    out
};

withTextAt := fn(xs: List<String>, idx: Int, val: String): List<String> {
    out: mut List<String> = [];
    len := xs.length();
    var k := 0;
    loop k < len {
        mut out.pushBack(if k == idx { val } else { xs[k] });
        k += 1;
    }
    out
};

raw := io.inputAll();
lines := splitLines(raw);
var cap := 0;
var haveCap := false;
emptyTexts: List<String> = [];
var mut keys := emptyTexts;
var mut vals := emptyTexts;
var size := 0;

loop lines as line {
    trimmed := line.trim();
    if trimmed == "" { continue; }
    parts := splitSpace(trimmed);
    if not haveCap {
        parsed := parts[0].toInt();
        cap = if parsed.ok and parsed.value > 0 { parsed.value } else { 1 };
        haveCap = true;
        continue;
    }

    op := parts[0];
    if op == "GET" and parts.length() >= 2 {
        k := parts[1];
        idx := keys.indexOf(k);
        if idx < 0 {
            io.outputLine("MISS");
        } else {
            v := vals[idx];
            var shift := idx;
            loop shift > 0 {
                keys = withTextAt(keys, shift, keys[shift - 1]);
                vals = withTextAt(vals, shift, vals[shift - 1]);
                shift -= 1;
            }
            keys = withTextAt(keys, 0, k);
            vals = withTextAt(vals, 0, v);
            io.outputLine(v);
        }
    } else if op == "SET" and parts.length() >= 3 {
        k := parts[1];
        v := parts[2];
        idx := keys.indexOf(k);
        if idx >= 0 {
            var shift := idx;
            loop shift > 0 {
                keys = withTextAt(keys, shift, keys[shift - 1]);
                vals = withTextAt(vals, shift, vals[shift - 1]);
                shift -= 1;
            }
            keys = withTextAt(keys, 0, k);
            vals = withTextAt(vals, 0, v);
        } else {
            if size == cap {
                _dk := mut keys.popBack();
                _dv := mut vals.popBack();
                size -= 1;
            }
            (mut keys).pushFront(k);
            mut vals.pushFront(v);
            size += 1;
        }
    }
}

io.outputLine("ORDER:" + if size == 0 { "EMPTY" } else { keys.join(",") });
