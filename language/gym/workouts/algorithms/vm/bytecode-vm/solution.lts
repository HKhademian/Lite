io := import "core/io";
list := import "core/list";
text := import "core/text";

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := text.length(raw);
    var pos := 0;
    loop pos <= n {
        nl := text.indexOfText(raw, "\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and text.at(raw, cleanEnd - 1) == "\r" { cleanEnd -= 1; }
        list.pushBack(mut out, text.slice(raw, pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

splitSpace := fn(line: String): List<String> {
    out: mut List<String> = [];
    n := text.length(line);
    var p := 0;
    loop p < n {
        loop p < n and text.isWhitespace(text.at(line, p)) { p += 1; }
        if p >= n { break; }
        s := p;
        loop p < n and not text.isWhitespace(text.at(line, p)) { p += 1; }
        list.pushBack(mut out, text.slice(line, s, p));
    }
    out
};

ops: mut List<String> = [];
args: mut List<Int> = [];
var instrCount := 0;
var badParse := false;

loop splitLines(io.inputAll()) as rawLine {
    trimmed := text.trim(rawLine);
    if trimmed == "" { continue; }
    parts := splitSpace(trimmed);
    op := parts[0];
    if op == "PUSH" or op == "JNZ" {
        if list.listCountText(parts) < 2 {
            badParse = true;
            break;
        }
        parsed := text.textToInt(parts[1]);
        if not parsed.ok {
            badParse = true;
            break;
        }
        list.pushBack(mut ops, op);
        list.pushBack(mut args, parsed.value);
    } else {
        list.pushBack(mut ops, op);
        list.pushBack(mut args, 0);
    }
    instrCount += 1;
}

if badParse {
    io.outputLine("ERR");
} else {
    stack: mut List<Int> = [];
    var depth := 0;
    var pc := 0;
    var steps := 0;
    var status := "OK";

    loop pc >= 0 and pc < instrCount {
        if steps >= 1000 {
            status = "ERR:LOOP";
            break;
        }
        steps += 1;
        op := ops[pc];
        arg := args[pc];
        if op == "PUSH" {
            list.pushBack(mut stack, arg);
            depth += 1;
            pc += 1;
        } else if op == "ADD" or op == "SUB" or op == "MUL" {
            if depth < 2 {
                status = "ERR";
                break;
            }
            right := list.popBack(mut stack);
            left := list.popBack(mut stack);
            depth -= 2;
            val := match {
                op == "ADD" { left + right }
                op == "SUB" { left - right }
                _ { left * right }
            };
            list.pushBack(mut stack, val);
            depth += 1;
            pc += 1;
        } else if op == "DUP" {
            if depth < 1 {
                status = "ERR";
                break;
            }
            list.pushBack(mut stack, stack[depth - 1]);
            depth += 1;
            pc += 1;
        } else if op == "SWAP" {
            if depth < 2 {
                status = "ERR";
                break;
            }
            a := list.popBack(mut stack);
            b := list.popBack(mut stack);
            list.pushBack(mut stack, a);
            list.pushBack(mut stack, b);
            pc += 1;
        } else if op == "JNZ" {
            if depth < 1 or arg < 0 or arg >= instrCount {
                status = "ERR";
                break;
            }
            cond := list.popBack(mut stack);
            depth -= 1;
            pc = if cond =!= 0 { arg } else { pc + 1 };
        } else if op == "HALT" {
            break;
        } else {
            status = "ERR";
            break;
        }
    }

    if status =!= "OK" {
        io.outputLine(status);
    } else if depth == 0 {
        io.outputLine("EMPTY");
    } else {
        io.outputLine(stack[depth - 1]);
    }
}
