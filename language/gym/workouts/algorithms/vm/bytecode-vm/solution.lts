io := import "core/io";

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := raw.length();
    var pos := 0;
    loop pos <= n {
        nl := raw.indexOf("\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and raw.at(cleanEnd - 1) == "\r" { cleanEnd -= 1; }
        (mut out).pushBack(raw.slice(pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

splitSpace := fn(line: String): List<String> {
    out: mut List<String> = [];
    n := line.length();
    var p := 0;
    loop p < n {
        loop p < n and line.at(p).isWhitespace() { p += 1; }
        if p >= n { break; }
        s := p;
        loop p < n and not line.at(p).isWhitespace() { p += 1; }
        (mut out).pushBack(line.slice(s, p));
    }
    out
};

ops: mut List<String> = [];
args: mut List<Int> = [];
var instrCount := 0;
var badParse := false;

loop splitLines(io.inputAll()) as rawLine {
    trimmed := rawLine.trim();
    if trimmed == "" { continue; }
    parts := splitSpace(trimmed);
    op := parts[0];
    if op == "PUSH" or op == "JNZ" {
        if parts.length() < 2 {
            badParse = true;
            break;
        }
        parsed := parts[1].toInt();
        if not parsed.ok {
            badParse = true;
            break;
        }
        (mut ops).pushBack(op);
        mut args.pushBack(parsed.value);
    } else {
        mut ops.pushBack(op);
        mut args.pushBack(0);
    }
    instrCount += 1;
}

if badParse {
    io.outputLine("ERR");
} else {
    stack: mut List<Int> = [];
    var depth := 0;
    var pc := 0;
    var steps := 0;
    var status := "OK";

    loop pc >= 0 and pc < instrCount {
        if steps >= 1000 {
            status = "ERR:LOOP";
            break;
        }
        steps += 1;
        op := ops[pc];
        arg := args[pc];
        if op == "PUSH" {
            mut stack.pushBack(arg);
            depth += 1;
            pc += 1;
        } else if op == "ADD" or op == "SUB" or op == "MUL" {
            if depth < 2 {
                status = "ERR";
                break;
            }
            right := mut stack.popBack();
            left := mut stack.popBack();
            depth -= 2;
            val := match {
                op == "ADD" { left + right }
                op == "SUB" { left - right }
                _ { left * right }
            };
            mut stack.pushBack(val);
            depth += 1;
            pc += 1;
        } else if op == "DUP" {
            if depth < 1 {
                status = "ERR";
                break;
            }
            (mut stack).pushBack(stack[depth - 1]);
            depth += 1;
            pc += 1;
        } else if op == "SWAP" {
            if depth < 2 {
                status = "ERR";
                break;
            }
            a := mut stack.popBack();
            b := mut stack.popBack();
            mut stack.pushBack(a);
            mut stack.pushBack(b);
            pc += 1;
        } else if op == "JNZ" {
            if depth < 1 or arg < 0 or arg >= instrCount {
                status = "ERR";
                break;
            }
            cond := mut stack.popBack();
            depth -= 1;
            pc = if cond =!= 0 { arg } else { pc + 1 };
        } else if op == "HALT" {
            break;
        } else {
            status = "ERR";
            break;
        }
    }

    if status =!= "OK" {
        io.outputLine(status);
    } else if depth == 0 {
        io.outputLine("EMPTY");
    } else {
        io.outputLine(stack[depth - 1]);
    }
}
