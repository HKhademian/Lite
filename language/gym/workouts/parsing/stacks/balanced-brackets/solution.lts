io := import "core/io";

matchingClose := fn(openCh: String): String {
    match {
        openCh == "(" { ")" }
        openCh == "[" { "]" }
        _ { "}" }
    }
};

line := io.inputLine();
stack: mut List<String> = [];
var depth := 0;
n := line.length();
var i := 0;
var mismatchIdx := -1;

loop i < n {
    ch := line.at(i);
    if ch == "(" or ch == "[" or ch == "{" {
        mut stack.pushBack(ch);
        depth += 1;
    } else if ch == ")" or ch == "]" or ch == "}" {
        if depth == 0 {
            mismatchIdx = i;
            break;
        }
        top := mut stack.popBack();
        depth -= 1;
        if matchingClose(top) =!= ch {
            mismatchIdx = i;
            break;
        }
    }
    i += 1;
}

if mismatchIdx >= 0 {
    io.outputLine("mismatch:" + mismatchIdx.toText());
} else if depth > 0 {
    io.outputLine("mismatch:" + n.toText());
} else {
    io.outputLine("balanced");
}
