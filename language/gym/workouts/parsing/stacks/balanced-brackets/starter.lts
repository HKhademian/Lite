io := import "core/io";

line := io.inputLine();
var balance := 0;
n := line.length();
var i := 0;
var badAt := -1;
loop i < n {
    ch := line.at(i);
    if ch == "(" or ch == "[" or ch == "{" {
        balance += 1;
    } else if ch == ")" or ch == "]" or ch == "}" {
        if balance == 0 {
            badAt = i;
            break;
        }
        balance -= 1;
    }
    i += 1;
}
if badAt >= 0 {
    io.outputLine("mismatch:" + badAt.toText());
} else if balance > 0 {
    io.outputLine("mismatch:" + n.toText());
} else {
    io.outputLine("balanced");
}
