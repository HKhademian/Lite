io := import "core/io";

splitTokens := fn(line: String): List<String> {
    tokens: mut List<String> = [];
    n := line.length();
    var pos := 0;
    loop pos < n {
        loop pos < n and line.at(pos).isWhitespace() {
            pos += 1;
        }
        if pos >= n { break; }
        start := pos;
        loop pos < n and not line.at(pos).isWhitespace() {
            pos += 1;
        }
        (mut tokens).pushBack(line.slice(start, pos));
    }
    tokens
};

line := io.inputLine();
tokens := splitTokens(line);
stack: mut List<Int> = [];
var depth := 0;
var failed := false;

loop tokens as tok {
    if tok == "+" or tok == "-" or tok == "*" or tok == "/" {
        if depth < 2 {
            failed = true;
            break;
        }
        right := mut stack.popBack();
        left := mut stack.popBack();
        depth -= 2;
        if tok == "/" and right == 0 {
            failed = true;
            break;
        }
        res := match {
            tok == "+" { left + right }
            tok == "-" { left - right }
            tok == "*" { left * right }
            _ { left / right }
        };
        mut stack.pushBack(res);
        depth += 1;
    } else {
        parsed := tok.toInt();
        if not parsed.ok {
            failed = true;
            break;
        }
        (mut stack).pushBack(parsed.value);
        depth += 1;
    }
}

if failed or depth =!= 1 {
    io.outputLine("ERR");
} else {
    io.outputLine(stack[0]);
}
