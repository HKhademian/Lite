integer := import "core/int";
io := import "core/io";
list := import "core/list";
text := import "core/text";

EvalRes := type (ok: Bool, value: Int, next: Int);

skipSp := fn(src: String, start: Int): Int {
    var p := start;
    n := text.length(src);
    loop p < n and text.isWhitespace(text.at(src, p)) { p += 1; }
    p
};

intPow := fn(base: Int, exp: Int): (ok: Bool, value: Int) {
    if exp < 0 { return (ok = false, value = 0); }
    var res := 1;
    var i := 0;
    loop i < exp {
        res *= base;
        i += 1;
    }
    (ok = true, value = res)
};

splitLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    n := text.length(raw);
    var pos := 0;
    loop pos <= n {
        nl := text.indexOfText(raw, "\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and text.at(raw, cleanEnd - 1) == "\r" { cleanEnd -= 1; }
        list.pushBack(mut out, text.slice(raw, pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

parseExpr := fn(src: String, pos: Int): EvalRes {
    left := parseTerm(src, pos);
    if not left.ok { return left; }
    var acc := left.value;
    var p := skipSp(src, left.next);
    n := text.length(src);
    loop p < n {
        op := text.at(src, p);
        if op =!= "+" and op =!= "-" { break; }
        right := parseTerm(src, p + 1);
        if not right.ok { return right; }
        acc = if op == "+" { acc + right.value } else { acc - right.value };
        p = skipSp(src, right.next);
    }
    (ok = true, value = acc, next = p)
};

parseTerm := fn(src: String, pos: Int): EvalRes {
    left := parseUnary(src, pos);
    if not left.ok { return left; }
    var acc := left.value;
    var p := skipSp(src, left.next);
    n := text.length(src);
    loop p < n {
        var op := "";
        var after := p;
        if text.startsWithAt(src, p, ":/") {
            op = ":/";
            after = p + 2;
        } else if text.startsWithAt(src, p, ":%") {
            op = ":%";
            after = p + 2;
        } else {
            ch := text.at(src, p);
            if ch == "*" and not text.startsWithAt(src, p, "**") {
                op = "*";
                after = p + 1;
            } else if ch == "/" or ch == "%" {
                op = ch;
                after = p + 1;
            }
        }
        if op == "" { break; }
        right := parseUnary(src, after);
        if not right.ok { return right; }
        if op =!= "*" and right.value == 0 {
            return (ok = false, value = 0, next = p);
        }
        acc = match {
            op == "*" { acc * right.value }
            op == "/" { acc / right.value }
            op == "%" { acc % right.value }
            op == ":/" { (acc :/ right.value) }
            _ { (acc :% right.value) }
        };
        p = skipSp(src, right.next);
    }
    (ok = true, value = acc, next = p)
};

parseUnary := fn(src: String, pos: Int): EvalRes {
    p := skipSp(src, pos);
    n := text.length(src);
    if p < n and text.at(src, p) == "-" {
        inner := self(src, p + 1);
        if not inner.ok { return inner; }
        return (ok = true, value = 0 - inner.value, next = inner.next);
    }
    parsePow(src, p)
};

parsePow := fn(src: String, pos: Int): EvalRes {
    left := parsePrimary(src, pos);
    if not left.ok { return left; }
    p := skipSp(src, left.next);
    if text.startsWithAt(src, p, "**") {
        right := parseUnary(src, p + 2);
        if not right.ok { return right; }
        pw := intPow(left.value, right.value);
        if not pw.ok { return (ok = false, value = 0, next = p); }
        return (ok = true, value = pw.value, next = right.next);
    }
    left
};

parsePrimary := fn(src: String, pos: Int): EvalRes {
    p := skipSp(src, pos);
    n := text.length(src);
    if p >= n { return (ok = false, value = 0, next = p); }
    ch := text.at(src, p);
    if ch == "(" {
        inner := parseExpr(src, p + 1);
        if not inner.ok { return inner; }
        closeP := skipSp(src, inner.next);
        if closeP >= n or text.at(src, closeP) =!= ")" {
            return (ok = false, value = 0, next = closeP);
        }
        return (ok = true, value = inner.value, next = closeP + 1);
    }
    if text.isDigit(ch) {
        var e := p;
        loop e < n and text.isDigit(text.at(src, e)) { e += 1; }
        parsed := text.textToInt(text.slice(src, p, e));
        if not parsed.ok { return (ok = false, value = 0, next = p); }
        return (ok = true, value = parsed.value, next = e);
    }
    (ok = false, value = 0, next = p)
};

raw := io.inputAll();
loop splitLines(raw) as line {
    trimmed := text.trim(line);
    if trimmed == "" { continue; }
    res := parseExpr(trimmed, 0);
    rest := skipSp(trimmed, res.next);
    if not res.ok or rest < text.length(trimmed) {
        io.outputLine("ERR");
    } else {
        io.outputLine(integer.intText(res.value));
    }
}
