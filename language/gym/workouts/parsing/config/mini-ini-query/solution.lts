io := import "core/io";
list := import "type/list";

splitLines := fn(raw: String): List<String> {
    mut out: List<String> = [];
    n := raw.length();
    var pos := 0;
    loop pos <= n {
        nl := raw.indexOf("\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and raw.at(cleanEnd - 1) == "\r" {
            cleanEnd -= 1;
        }
        (mut out).pushBack(raw.slice(pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

withTextAt := fn(xs: List<String>, idx: Int, val: String): List<String> {
    mut out: List<String> = [];
    len := xs.length();
    var k := 0;
    loop k < len {
        mut out.pushBack(if k == idx { val } else { xs[k] });
        k += 1;
    }
    out
};

raw := io.inputAll();
lines := splitLines(raw);
emptyTexts: List<String> = [];
mut keys: List<String> = [];
var mut vals := emptyTexts;
var section := "";

loop lines as line {
    trimmed := line.trim();
    n := trimmed.length();
    if n == 0 { continue; }
    first := trimmed.at(0);
    if first == ";" or first == "#" { continue; }

    if trimmed.startsWithAt(0, "QUERY ") {
        qKey := trimmed.slice(6, n).trim();
        idx := keys.indexOf(qKey);
        io.outputLine(if idx >= 0 { vals[idx] } else { "MISSING" });
        continue;
    }

    if first == "[" and trimmed.endsWith("]") {
        section = trimmed.slice(1, n - 1).trim();
        continue;
    }

    eq := trimmed.indexOf("=", 0);
    if eq >= 0 {
        k := trimmed.slice(0, eq).trim();
        v := trimmed.slice(eq + 1, n).trim();
        fullKey := if section == "" { k } else { section + "." + k };
        existing := keys.indexOf(fullKey);
        if existing >= 0 {
            vals = withTextAt(vals, existing, v);
        } else {
            mut keys.pushBack(fullKey);
            mut vals.pushBack(v);
        }
    }
}
