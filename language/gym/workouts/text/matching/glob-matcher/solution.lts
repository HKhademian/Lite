io := import "core/io";

splitLines := fn(raw: String): List<String> {
    mut out: List<String> = [];
    n := raw.length();
    var pos := 0;
    loop pos <= n {
        nl := raw.indexOf("\n", pos);
        endPos := if nl < 0 { n } else { nl };
        var cleanEnd := endPos;
        if cleanEnd > pos and raw.at(cleanEnd - 1) == "\r" { cleanEnd -= 1; }
        (mut out).pushBack(raw.slice(pos, cleanEnd));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

globMatch := fn(pat: String, src: String): Bool {
    pn := pat.length();
    sn := src.length();
    var pi := 0;
    var si := 0;
    var starP := -1;
    var matchS := 0;

    loop si < sn {
        if pi < pn and (pat.at(pi) == "?" or pat.at(pi) == src.at(si)) {
            pi += 1;
            si += 1;
        } else if pi < pn and pat.at(pi) == "*" {
            starP = pi;
            matchS = si;
            pi += 1;
        } else if starP >= 0 {
            pi = starP + 1;
            matchS += 1;
            si = matchS;
        } else {
            return false;
        }
    }

    loop pi < pn and pat.at(pi) == "*" {
        pi += 1;
    }
    pi == pn
};

raw := io.inputAll();
lines := splitLines(raw);
var havePattern := false;
var pattern := "";

loop lines as line {
    trimmed := line.trim();
    if trimmed == "" { continue; }
    if not havePattern {
        pattern = trimmed;
        havePattern = true;
    } else {
        io.outputLine(if globMatch(pattern, trimmed) { "MATCH" } else { "NO" });
    }
}
