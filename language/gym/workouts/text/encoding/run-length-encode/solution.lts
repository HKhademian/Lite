io := import "core/io";
text := import "core/text";

line := io.inputLine();
n := line.length();
if n == 0 {
    io.outputLine("");
} else {
    mut parts: List<String> = [];
    var cur := line.at(0);
    var run := 1;
    var i := 1;
    loop i < n {
        ch := line.at(i);
        if ch == cur {
            run += 1;
        } else {
            mut parts.pushBack(cur + run.toText());
            cur = ch;
            run = 1;
        }
        i += 1;
    }
    (mut parts).pushBack(cur + run.toText());
    io.outputLine(parts.join(""));
}
