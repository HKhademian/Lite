io := import "core/io";
list := import "type/list";

textLessThan := fn(a: String, b: String): Bool {
    la := a.length();
    lb := b.length();
    order := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz";
    minLen := if la < lb { la } else { lb };
    var i := 0;
    loop i < minLen {
        ca := a.at(i);
        cb := b.at(i);
        if ca =!= cb {
            pa := order.indexOf(ca, 0);
            pb := order.indexOf(cb, 0);
            return pa < pb;
        }
        i += 1;
    }
    la < lb
};

withTextAt := fn(xs: List<String>, idx: Int, val: String): List<String> {
    mut out: List<String> = [];
    len := xs.length();
    var k := 0;
    loop k < len {
        mut out.pushBack(if k == idx { val } else { xs[k] });
        k += 1;
    }
    out
};

withIntAt := fn(xs: List<Int>, idx: Int, val: Int): List<Int> {
    mut out: List<Int> = [];
    len := xs.length();
    var k := 0;
    loop k < len {
        mut out.pushBack(if k == idx { val } else { xs[k] });
        k += 1;
    }
    out
};

raw := io.inputAll();
n := raw.length();
emptyTexts: List<String> = [];
emptyInts: List<Int> = [];
var mut words := emptyTexts;
var mut counts := emptyInts;
var uniqueCount := 0;
var pos := 0;

loop pos < n {
    loop pos < n and not raw.at(pos).isNameContinue() {
        pos += 1;
    }
    if pos >= n { break; }
    start := pos;
    loop pos < n and raw.at(pos).isNameContinue() {
        pos += 1;
    }
    word := raw.slice(start, pos).toLowerAscii();
    idx := words.indexOf(word);
    if idx >= 0 {
        counts = withIntAt(counts, idx, counts[idx] + 1);
    } else {
        mut words.pushBack(word);
        mut counts.pushBack(1);
        uniqueCount += 1;
    }
}

if uniqueCount == 0 {
    io.outputLine("EMPTY");
} else {
    var i := 1;
    loop i < uniqueCount {
        wKey := words[i];
        cKey := counts[i];
        var j := i - 1;
        loop j >= 0 {
            swap := counts[j] < cKey or (counts[j] == cKey and textLessThan(wKey, words[j]));
            if not swap { break; }
            words = withTextAt(words, j + 1, words[j]);
            counts = withIntAt(counts, j + 1, counts[j]);
            j -= 1;
        }
        words = withTextAt(words, j + 1, wKey);
        counts = withIntAt(counts, j + 1, cKey);
        i += 1;
    }

    var outIdx := 0;
    loop outIdx < uniqueCount {
        io.outputLine(words[outIdx] + ":", counts[outIdx].toText());
        outIdx += 1;
    }
}
