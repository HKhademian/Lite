io := import "core/io";
list := import "core/list";
unicode := import "core/unicode";

line := io.inputLine();
shift := io.inputInt();
k := shift :% 26;
points := unicode.toCodePoints(line);
out: mut List<Int> = [];

loop points as cp {
    nextCp := match {
        65 <= cp <= 90 { 65 + ((cp - 65 + k) :% 26) }
        97 <= cp <= 122 { 97 + ((cp - 97 + k) :% 26) }
        _ { cp }
    };
    list.pushBack(mut out, nextCp);
}

decoded := unicode.fromCodePoints(out);
io.outputLine(decoded.text);
