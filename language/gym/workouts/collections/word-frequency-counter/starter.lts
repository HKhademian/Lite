io := import "core/io";

n := io.inputInt();
_eol := io.inputLine();
counts: mut Map<String, Int>;
var i := 0;
loop i < n {
    word := io.inputLine();
    /* TODO: increment counts[word] using map.getOr */
    _ignored := word;
    i += 1;
}
query := io.inputLine();
io.outputLine(counts.size(), counts.getOr(query, 0));
