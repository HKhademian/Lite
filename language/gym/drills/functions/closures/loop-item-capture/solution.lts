io := import "core/io";

makeCounter := fn(start: Int, step: Int): fn(): Int {
    var current := start;
    fn(): Int {
        current += step;
        current
    }
};

s1 := io.inputInt();
s2 := io.inputInt();
c1 := makeCounter(s1, 2);
c2 := makeCounter(s2, 5);
io.outputLine(c1(), c2(), c1(), c2());
