io := import "core/io";
list := import "core/list";

n := io.inputInt();
raw: mut List<Int> = [];
var i := 0;
loop i < n {
    list.pushBack(mut raw, io.inputInt());
    i += 1;
}

/* TODO: filter positive items and double them using `loop raw { if .item > 0 { .item * 2 } }.collected` */
doubled: List<Int> = [];

if doubled.isEmpty {
    io.outputLine(0, "empty");
} else {
    io.outputLine(doubled.length, doubled[0], doubled[doubled.length - 1]);
}
