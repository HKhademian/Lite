io := import "core/io";

word := io.inputLine();
n := io.inputInt();
_eol := io.inputLine();
mut tags: List<String> = [];
mut unique: Set<String>;
var i := 0;
loop i < n {
    t := io.inputLine();
    mut tags.pushBack(t);
    mut unique.add(t);
    i += 1;
}

/* TODO: replace the placeholders using word.length(), word.isEmpty(), tags.length(), unique.size(), unique.isEmpty() */
io.outputLine(0, false, 0, 0, false);
