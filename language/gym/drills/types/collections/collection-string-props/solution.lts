io := import "core/io";

word := io.inputLine();
n := io.inputInt();
_eol := io.inputLine();
tags: mut List<String> = [];
unique: mut Set<String>;
var i := 0;
loop i < n {
    t := io.inputLine();
    mut tags.pushBack(t);
    mut unique.add(t);
    i += 1;
}

io.outputLine(word.length(), word.isEmpty(), tags.length(), unique.size(), unique.isEmpty());
