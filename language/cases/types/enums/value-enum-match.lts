io := import "core/io";

Role := enum : Int {
    Guest = 0;
    Member = 10;
    Admin;
};

describe := fn(r: Role): String {
    match r {
        .Guest { "guest" }
        .Member { "member" }
        .Admin { "admin" }
    }
};

a: Role = .Admin;
io.outputLine(a, a.value, describe(a), describe(.Guest));
