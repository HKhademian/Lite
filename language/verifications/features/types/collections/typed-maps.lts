io := import "core/io";

scores: mut Map<String, Int>;
scores["alice"] = 10;
mut scores.set("bob", 20);
scores["alice"] = 15;
saved: Map<String, Int> = scores;
mut scores.remove("bob");
hit := saved.get("bob");
miss := scores.getOr("bob", 99);
io.outputLine(scores["alice"], scores.size(), hit.found, hit.value, miss);
