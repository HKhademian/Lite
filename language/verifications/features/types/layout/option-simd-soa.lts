io := import "core/io";
opt := import "type/option";
rc := import "type/rc";
simd := import "type/simd";
soa := import "type/soa";

Pkt := record #packed { tag: UInt4; len: UInt4; };
p := Pkt { tag = 3, len = 9 };
ov: opt.Option<Int> = .Some(cast<Int>(p.len));

mut swarm: soa.SoA<Pkt> = soa.SoA.create();
mut swarm.pushBack(p);
v := simd.Float32x4.splat(cast<Float32>(1.5)).add(simd.Float32x4.splat(cast<Float32>(0.5)));
rcVal := rc.Rc.create(50);

io.outputLine(if .Some(n) := ov { n } else { 0 }, swarm[0].tag, v.reduceAdd(), rcVal.get());
