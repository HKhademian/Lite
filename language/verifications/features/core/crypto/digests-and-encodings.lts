io := import "core/io";
crypto := import "core/crypto";

msg := io.inputLine("msg: ");
bytes := msg.utf8Encode();
digest256 := crypto.sha256Text(msg);
digest512 := crypto.sha512Text(msg);
hmac := crypto.hmacSha256Bytes("lite-key".utf8Encode(), bytes);
hexStr := crypto.hexEncode(bytes);
hexBack := crypto.hexDecode(hexStr);
b64Str := crypto.base64Encode(bytes);
b64Back := crypto.base64Decode(b64Str);
hexDec := String.fromUtf8Strict(hexBack);
b64Dec := String.fromUtf8Strict(b64Back);

io.outputLine(digest256);
io.outputLine(digest512);
io.outputLine(hmac);
io.outputLine(hexStr, b64Str, hexDec.text == msg, b64Dec.text == msg);
io.outputLine(crypto.isValidHex(hexStr), crypto.isValidHex("zz"), crypto.isValidBase64(b64Str), crypto.isValidBase64("?"));
