io := import "core/io";
tm := import "core/time";
proc := import "core/process";
path := import "core/path";

m0 := tm.monotonicNs();
tm.sleepMs(2);
m1 := tm.monotonicNs();
ms := tm.epochMs();
dateText := tm.localDate();
isoText := tm.utcIsoNow();

cwdOk := path.isDirectory(proc.cwd());
execOk := path.isFile(proc.execPath());
platOk := proc.platform().length() > 0;
archOk := proc.arch().length() > 0;

io.outputLine(m0 >= 0, m1 >= m0, ms > 1700000000000, dateText.length() == 10, dateText.at(4) == "-", dateText.at(7) == "-", isoText.endsWith("Z"));
io.outputLine(cwdOk, execOk, platOk, archOk);
