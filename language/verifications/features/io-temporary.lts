io := import "core/io";

io.output(); io.outputLine();
line := io.inputLine("Line: ");
number := io.inputInt("Int: ");
fraction := io.inputFloat("Float: ");
rest := io.inputAll("All: ");
io.output("values:", line, number, fraction); io.outputLine();
io.outputLine([1, 2], (left = number, right = line), true);
io.outputLine(rest);
