{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite.local/schema/verification.schema.json",
  "title": "Lite verification case",
  "description": "One feature or artifact verification manifest consumed by igniter/verify.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "source",
    "features",
    "cases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "feature",
        "example",
        "sample",
        "showcase"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guideline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "append": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feature"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "guideline"
        ]
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "bytes"
          ],
          "properties": {
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "exitCode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdin": {
          "$ref": "#/$defs/stream"
        },
        "stdout": {
          "$ref": "#/$defs/stream"
        },
        "stderr": {
          "$ref": "#/$defs/stream"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
