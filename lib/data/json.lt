/** Pure RFC-8259 JSON scanner, typed reader, and O(N) string serializer (`data/json`) across TS and C11. */

text := import "core/text";
unicode := import "core/unicode";

/** Top-level value classification at a JSON token offset. */
pub JsonKind := enum {
    Null;
    Bool;
    Number;
    String;
    Array;
    Object;
    Invalid;
}

/** Result of scanning one complete JSON value (`next` points immediately after it). */
pub JsonScan := record {
    ok: Bool;
    next: Int;
    error: String;
}

/** Result of decoding one JSON string literal. */
pub JsonString := record {
    ok: Bool;
    value: String;
    next: Int;
    error: String;
}

/** Result of reading one signed 64-bit JSON integer token. */
pub JsonInt := record {
    ok: Bool;
    value: Int;
    next: Int;
    error: String;
}

/** Result of reading one JSON boolean token. */
pub JsonBool := record {
    ok: Bool;
    value: Bool;
    next: Int;
    error: String;
}

/** Result of locating a direct object property's value offset. */
pub JsonField := record {
    found: Bool;
    valuePos: Int;
}

isJsonSpace := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
};

skipSpaces := fn(source: String, start: Int): Int {
    size := source.length();
    var pos := if start < 0 { 0 } else { start };
    loop pos < size and isJsonSpace(source.at(pos)) {
        pos += 1;
    }
    pos
};

isHexDigit := fn(ch: String): Bool {
    ch.isDigit() or
    ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or
    ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F"
};

hexDigitVal := fn(ch: String): Int {
    if ch.isDigit() { return ch.digitValue(); }
    lower := ch.toLowerAscii();
    if lower == "a" { return 10; }
    if lower == "b" { return 11; }
    if lower == "c" { return 12; }
    if lower == "d" { return 13; }
    if lower == "e" { return 14; }
    15
};

hexCharLower := fn(nibble: Int): String {
    "0123456789abcdef".at(nibble)
};

parseHex4 := fn(source: String, start: Int): (ok: Bool, value: Int) {
    if start + 3 >= source.length() { return (ok = false, value = 0); }
    h0 := source.at(start);
    h1 := source.at(start + 1);
    h2 := source.at(start + 2);
    h3 := source.at(start + 3);
    if not isHexDigit(h0) or not isHexDigit(h1) or not isHexDigit(h2) or not isHexDigit(h3) {
        return (ok = false, value = 0);
    }
    value := ((hexDigitVal(h0) * 16 + hexDigitVal(h1)) * 16 + hexDigitVal(h2)) * 16 + hexDigitVal(h3);
    (ok = true, value = value)
};

scanStringToken := fn(source: String, start: Int, decode: Bool): JsonString {
    size := source.length();
    if start < 0 or start >= size or source.at(start) =!= "\"" {
        return JsonString { ok = false, value = "", next = start, error = "expected JSON string" };
    }
    var pos := start + 1;
    parts: mut List<String> = [];
    var runStart := pos;
    loop pos < size {
        ch := source.at(pos);
        if ch == "\"" {
            if not decode {
                return JsonString { ok = true, value = "", next = pos + 1, error = "" };
            }
            if runStart == start + 1 {
                return JsonString { ok = true, value = source.slice(runStart, pos), next = pos + 1, error = "" };
            }
            if pos > runStart {
                mut parts.pushBack(source.slice(runStart, pos));
            }
            return JsonString { ok = true, value = parts.join(""), next = pos + 1, error = "" };
        }
        if ch == "\\" {
            if decode and pos > runStart {
                mut parts.pushBack(source.slice(runStart, pos));
            }
            if pos + 1 >= size {
                return JsonString { ok = false, value = "", next = pos, error = "unterminated string escape" };
            }
            esc := source.at(pos + 1);
            if esc == "\"" or esc == "\\" or esc == "/" {
                if decode { mut parts.pushBack(esc); }
                pos += 2;
                runStart = pos;
            } else if esc == "n" {
                if decode { mut parts.pushBack("\n"); }
                pos += 2;
                runStart = pos;
            } else if esc == "r" {
                if decode { mut parts.pushBack("\r"); }
                pos += 2;
                runStart = pos;
            } else if esc == "t" {
                if decode { mut parts.pushBack("\t"); }
                pos += 2;
                runStart = pos;
            } else if esc == "b" {
                if decode { mut parts.pushBack(unicode.fromCodePoint(8).text); }
                pos += 2;
                runStart = pos;
            } else if esc == "f" {
                if decode { mut parts.pushBack(unicode.fromCodePoint(12).text); }
                pos += 2;
                runStart = pos;
            } else if esc == "u" {
                if pos + 5 >= size {
                    return JsonString { ok = false, value = "", next = pos, error = "incomplete unicode escape" };
                }
                firstHex := parseHex4(source, pos + 2);
                if not firstHex.ok {
                    return JsonString { ok = false, value = "", next = pos, error = "invalid unicode escape" };
                }
                code := firstHex.value;
                var consumed := 6;
                if decode {
                    if code >= 55296 and code <= 56319 and pos + 11 < size and source.at(pos + 6) == "\\" and source.at(pos + 7) == "u" {
                        secondHex := parseHex4(source, pos + 8);
                        if secondHex.ok and secondHex.value >= 56320 and secondHex.value <= 57343 {
                            pair: List<Int> = [code, secondHex.value];
                            pairRes := unicode.utf16DecodeStrict(pair);
                            if pairRes.ok {
                                mut parts.pushBack(pairRes.text);
                                consumed = 12;
                            } else {
                                mut parts.pushBack(source.slice(pos, pos + 6));
                            }
                        } else {
                            mut parts.pushBack(source.slice(pos, pos + 6));
                        }
                    } else if code >= 55296 and code <= 57343 {
                        mut parts.pushBack(source.slice(pos, pos + 6));
                    } else {
                        cpRes := unicode.fromCodePoint(code);
                        if cpRes.ok {
                            mut parts.pushBack(cpRes.text);
                        } else {
                            mut parts.pushBack(source.slice(pos, pos + 6));
                        }
                    }
                }
                pos += consumed;
                runStart = pos;
            } else {
                return JsonString { ok = false, value = "", next = pos, error = "invalid string escape" };
            }
        } else {
            if ch == "\n" or ch == "\r" or ch == "\t" {
                return JsonString { ok = false, value = "", next = pos, error = "unescaped control character in string" };
            }
            pos += 1;
        }
    }
    JsonString { ok = false, value = "", next = pos, error = "unterminated string literal" }
};

scanNumberToken := fn(source: String, start: Int): JsonScan {
    size := source.length();
    var pos := start;
    if pos < size and source.at(pos) == "-" {
        pos += 1;
    }
    if pos >= size or not source.at(pos).isDigit() {
        return JsonScan { ok = false, next = pos, error = "expected JSON number digit" };
    }
    if source.at(pos) == "0" {
        pos += 1;
        if pos < size and source.at(pos).isDigit() {
            return JsonScan { ok = false, next = pos, error = "leading zero in JSON number" };
        }
    } else {
        loop pos < size and source.at(pos).isDigit() {
            pos += 1;
        }
    }
    if pos < size and source.at(pos) == "." {
        pos += 1;
        if pos >= size or not source.at(pos).isDigit() {
            return JsonScan { ok = false, next = pos, error = "expected fraction digit in JSON number" };
        }
        loop pos < size and source.at(pos).isDigit() {
            pos += 1;
        }
    }
    if pos < size and (source.at(pos) == "e" or source.at(pos) == "E") {
        pos += 1;
        if pos < size and (source.at(pos) == "+" or source.at(pos) == "-") {
            pos += 1;
        }
        if pos >= size or not source.at(pos).isDigit() {
            return JsonScan { ok = false, next = pos, error = "expected exponent digit in JSON number" };
        }
        loop pos < size and source.at(pos).isDigit() {
            pos += 1;
        }
    }
    JsonScan { ok = true, next = pos, error = "" }
};

/** Classifies the JSON value starting at or after `start`. */
pub kindAt := fn(source: String, start: Int): JsonKind {
    pos := skipSpaces(source, start);
    size := source.length();
    if pos >= size { return .Invalid; }
    ch := source.at(pos);
    if ch == "\"" { .String }
    else if ch == "{" { .Object }
    else if ch == "[" { .Array }
    else if ch == "-" or ch.isDigit() { .Number }
    else if source.startsWithAt(pos, "true") or source.startsWithAt(pos, "false") { .Bool }
    else if source.startsWithAt(pos, "null") { .Null }
    else { .Invalid }
};

/** Skips one valid JSON value starting at or after `start`, returning the index immediately after it. */
pub skipValue := fn(source: String, start: Int): JsonScan {
    size := source.length();
    stack: mut List<String> = [];
    var stackCount := 0;
    var pos := start;
    var expectKey := false;

    loop true {
        pos = skipSpaces(source, pos);
        if expectKey {
            keyRes := scanStringToken(source, pos, false);
            if not keyRes.ok {
                return JsonScan { ok = false, next = pos, error = "expected JSON object key" };
            }
            pos = skipSpaces(source, keyRes.next);
            if pos >= size or source.at(pos) =!= ":" {
                return JsonScan { ok = false, next = pos, error = "expected ':' after JSON object key" };
            }
            pos = skipSpaces(source, pos + 1);
            expectKey = false;
        }

        if pos >= size {
            return JsonScan { ok = false, next = pos, error = "unexpected end of JSON input" };
        }

        ch := source.at(pos);
        var valueCompleted := false;
        if ch == "{" {
            afterOpen := skipSpaces(source, pos + 1);
            if afterOpen < size and source.at(afterOpen) == "}" {
                pos = afterOpen + 1;
                valueCompleted = true;
            } else {
                mut stack.pushBack("obj");
                stackCount += 1;
                pos = afterOpen;
                expectKey = true;
            }
        } else if ch == "[" {
            afterOpen := skipSpaces(source, pos + 1);
            if afterOpen < size and source.at(afterOpen) == "]" {
                pos = afterOpen + 1;
                valueCompleted = true;
            } else {
                mut stack.pushBack("arr");
                stackCount += 1;
                pos = afterOpen;
            }
        } else if ch == "\"" {
            strRes := scanStringToken(source, pos, false);
            if not strRes.ok {
                return JsonScan { ok = false, next = strRes.next, error = strRes.error };
            }
            pos = strRes.next;
            valueCompleted = true;
        } else if source.startsWithAt(pos, "true") {
            pos += 4;
            valueCompleted = true;
        } else if source.startsWithAt(pos, "false") {
            pos += 5;
            valueCompleted = true;
        } else if source.startsWithAt(pos, "null") {
            pos += 4;
            valueCompleted = true;
        } else if ch == "-" or ch.isDigit() {
            numRes := scanNumberToken(source, pos);
            if not numRes.ok { return numRes; }
            pos = numRes.next;
            valueCompleted = true;
        } else {
            return JsonScan { ok = false, next = pos, error = "unexpected token in JSON value" };
        }

        if valueCompleted {
            if stackCount == 0 {
                return JsonScan { ok = true, next = pos, error = "" };
            }
            loop stackCount > 0 {
                pos = skipSpaces(source, pos);
                if pos >= size {
                    return JsonScan { ok = false, next = pos, error = "unterminated JSON container" };
                }
                sep := source.at(pos);
                top := stack[stackCount - 1];
                if top == "arr" {
                    if sep == "]" {
                        _p := mut stack.popBack();
                        stackCount -= 1;
                        pos += 1;
                    } else if sep == "," {
                        pos += 1;
                        break;
                    } else {
                        return JsonScan { ok = false, next = pos, error = "expected ',' or ']' in JSON array" };
                    }
                } else {
                    if sep == "}" {
                        _p := mut stack.popBack();
                        stackCount -= 1;
                        pos += 1;
                    } else if sep == "," {
                        pos += 1;
                        expectKey = true;
                        break;
                    } else {
                        return JsonScan { ok = false, next = pos, error = "expected ',' or '}' in JSON object" };
                    }
                }
            }
            if stackCount == 0 {
                return JsonScan { ok = true, next = pos, error = "" };
            }
        }
    }
    JsonScan { ok = false, next = pos, error = "unexpected end of JSON input" }
};

/** Validates that `source` is a complete single JSON value followed only by whitespace. */
pub validate := fn(source: String): (ok: Bool, error: String) {
    skipped := skipValue(source, 0);
    if not skipped.ok {
        return (ok = false, error = skipped.error);
    }
    rest := skipSpaces(source, skipped.next);
    if rest < source.length() {
        return (ok = false, error = "unexpected trailing JSON content");
    }
    (ok = true, error = "")
};

/** Returns the trimmed slice bounds `(start, end)` of one JSON value at or after `start`. */
pub valueSpan := fn(source: String, start: Int): (ok: Bool, start: Int, end: Int, error: String) {
    valStart := skipSpaces(source, start);
    skipped := skipValue(source, valStart);
    (ok = skipped.ok, start = valStart, end = skipped.next, error = skipped.error)
};

/** Decodes a JSON string literal at or after `start`. */
pub readStringAt := fn(source: String, start: Int): JsonString {
    pos := skipSpaces(source, start);
    scanStringToken(source, pos, true)
};

/** Reads a JSON signed 64-bit integer token at or after `start`. */
pub readIntAt := fn(source: String, start: Int): JsonInt {
    size := source.length();
    pos := skipSpaces(source, start);
    var end := pos;
    if end < size and (source.at(end) == "-" or source.at(end) == "+") {
        end += 1;
    }
    loop end < size and source.at(end).isDigit() {
        end += 1;
    }
    if end == pos {
        return JsonInt { ok = false, value = 0, next = pos, error = "expected integer value" };
    }
    if end < size and (source.at(end) == "." or source.at(end) == "e" or source.at(end) == "E") {
        return JsonInt { ok = false, value = 0, next = pos, error = "expected integer value, got float" };
    }
    parsed := source.slice(pos, end).toInt();
    if not parsed.ok {
        return JsonInt { ok = false, value = 0, next = pos, error = "invalid integer value" };
    }
    JsonInt { ok = true, value = parsed.value, next = end, error = "" }
};

/** Reads a JSON boolean literal (`true` or `false`) at or after `start`. */
pub readBoolAt := fn(source: String, start: Int): JsonBool {
    pos := skipSpaces(source, start);
    if source.startsWithAt(pos, "true") {
        return JsonBool { ok = true, value = true, next = pos + 4, error = "" };
    }
    if source.startsWithAt(pos, "false") {
        return JsonBool { ok = true, value = false, next = pos + 5, error = "" };
    }
    JsonBool { ok = false, value = false, next = pos, error = "expected boolean value" }
};

/** Finds direct property `key` inside the JSON object at or after `objectStart`. */
pub findField := fn(source: String, objectStart: Int, key: String): JsonField {
    size := source.length();
    var pos := skipSpaces(source, objectStart);
    if pos >= size or source.at(pos) =!= "{" {
        return JsonField { found = false, valuePos = -1 };
    }
    pos = skipSpaces(source, pos + 1);
    if pos < size and source.at(pos) == "}" {
        return JsonField { found = false, valuePos = -1 };
    }
    loop pos < size {
        keyRes := scanStringToken(source, pos, true);
        if not keyRes.ok { return JsonField { found = false, valuePos = -1 }; }
        pos = skipSpaces(source, keyRes.next);
        if pos >= size or source.at(pos) =!= ":" { return JsonField { found = false, valuePos = -1 }; }
        valStart := skipSpaces(source, pos + 1);
        if keyRes.value == key {
            return JsonField { found = true, valuePos = valStart };
        }
        valEnd := skipValue(source, valStart);
        if not valEnd.ok { return JsonField { found = false, valuePos = -1 }; }
        pos = skipSpaces(source, valEnd.next);
        if pos < size and source.at(pos) == "," {
            pos = skipSpaces(source, pos + 1);
        } else {
            return JsonField { found = false, valuePos = -1 };
        }
    }
    JsonField { found = false, valuePos = -1 }
};

/** Reads direct string property `key` from JSON object at `objectStart`. */
pub readFieldString := fn(source: String, objectStart: Int, key: String): (found: Bool, ok: Bool, value: String) {
    field := findField(source, objectStart, key);
    if not field.found { return (found = false, ok = false, value = ""); }
    str := readStringAt(source, field.valuePos);
    (found = true, ok = str.ok, value = str.value)
};

/** Reads direct `Int` property `key` from JSON object at `objectStart`. */
pub readFieldInt := fn(source: String, objectStart: Int, key: String): (found: Bool, ok: Bool, value: Int) {
    field := findField(source, objectStart, key);
    if not field.found { return (found = false, ok = false, value = 0); }
    num := readIntAt(source, field.valuePos);
    (found = true, ok = num.ok, value = num.value)
};

/** Reads direct `Bool` property `key` from JSON object at `objectStart`. */
pub readFieldBool := fn(source: String, objectStart: Int, key: String): (found: Bool, ok: Bool, value: Bool) {
    field := findField(source, objectStart, key);
    if not field.found { return (found = false, ok = false, value = false); }
    b := readBoolAt(source, field.valuePos);
    (found = true, ok = b.ok, value = b.value)
};

/** Returns starting value offsets of elements inside a JSON array at or after `arrayStart`. */
pub arrayOffsets := fn(source: String, arrayStart: Int): List<Int> {
    offsets: mut List<Int> = [];
    size := source.length();
    var pos := skipSpaces(source, arrayStart);
    if pos >= size or source.at(pos) =!= "[" { return offsets; }
    pos = skipSpaces(source, pos + 1);
    if pos < size and source.at(pos) == "]" { return offsets; }
    loop pos < size {
        mut offsets.pushBack(pos);
        skipped := skipValue(source, pos);
        if not skipped.ok { return offsets; }
        pos = skipSpaces(source, skipped.next);
        if pos < size and source.at(pos) == "," {
            pos = skipSpaces(source, pos + 1);
        } else {
            return offsets;
        }
    }
    offsets
};

/** Returns decoded property names of a JSON object at or after `objectStart`. */
pub objectKeys := fn(source: String, objectStart: Int): List<String> {
    keys: mut List<String> = [];
    size := source.length();
    var pos := skipSpaces(source, objectStart);
    if pos >= size or source.at(pos) =!= "{" { return keys; }
    pos = skipSpaces(source, pos + 1);
    if pos < size and source.at(pos) == "}" { return keys; }
    loop pos < size {
        keyRes := scanStringToken(source, pos, true);
        if not keyRes.ok { return keys; }
        (mut keys).pushBack(keyRes.value);
        pos = skipSpaces(source, keyRes.next);
        if pos >= size or source.at(pos) =!= ":" { return keys; }
        skipped := skipValue(source, pos + 1);
        if not skipped.ok { return keys; }
        pos = skipSpaces(source, skipped.next);
        if pos < size and source.at(pos) == "," {
            pos = skipSpaces(source, pos + 1);
        } else {
            return keys;
        }
    }
    keys
};

/** Encodes `value` as a quoted RFC-8259 JSON string literal in O(N) time. */
pub quoteString := fn(value: String): String {
    cps := unicode.toCodePoints(value);
    size := cps.length();
    parts: mut List<String> = ["\""];
    var runStart := 0;
    var i := 0;
    loop i < size {
        cp := cps[i];
        var esc := "";
        if cp == 34 { esc = "\\\""; }
        else if cp == 92 { esc = "\\\\"; }
        else if cp == 8 { esc = "\\b"; }
        else if cp == 9 { esc = "\\t"; }
        else if cp == 10 { esc = "\\n"; }
        else if cp == 12 { esc = "\\f"; }
        else if cp == 13 { esc = "\\r"; }
        else if cp < 32 {
            esc = "\\u00" + hexCharLower(cp / 16) + hexCharLower(cp % 16);
        }
        if esc =!= "" {
            if i > runStart { mut parts.pushBack(value.slice(runStart, i)); }
            mut parts.pushBack(esc);
            runStart = i + 1;
        }
        i += 1;
    }
    if runStart < size { mut parts.pushBack(value.slice(runStart, size)); }
    mut parts.pushBack("\"");
    parts.join("")
};

/** Encodes a `Bool` as `"true"` or `"false"`. */
pub encodeBool := fn(value: Bool): String {
    if value { "true" } else { "false" }
};

/** Encodes a signed `Int` as a JSON number token. */
pub encodeInt := fn(value: Int): String {
    value.toText()
};

/** Encodes a `"key":rawJsonValue` object member fragment. */
pub encodeField := fn(key: String, rawJsonValue: String): String {
    quoteString(key) + ":" + rawJsonValue
};

/** Joins encoded `"k":v` field fragments into a JSON object `{...}`. */
pub encodeObject := fn(fields: List<String>): String {
    "{" + fields.join(",") + "}"
};

/** Joins raw JSON element fragments into a JSON array `[...]`. */
pub encodeArray := fn(rawItems: List<String>): String {
    "[" + rawItems.join(",") + "]"
};

/** Encodes a `List<String>` as a JSON string array. */
pub encodeStringList := fn(items: List<String>): String {
    encoded: mut List<String> = [];
    loop items as item {
        mut encoded.pushBack(quoteString(item));
    }
    "[" + encoded.join(",") + "]"
};

/** Encodes a `List<Int>` as a JSON integer array. */
pub encodeIntList := fn(items: List<Int>): String {
    encoded: mut List<String> = [];
    loop items as item {
        mut encoded.pushBack(item.toText());
    }
    "[" + encoded.join(",") + "]"
};
