/* Beginner pixel-graphics canvas layered on top of `gfx/surface` and `media/audio`. */

audioLib := import "media/audio";
colorLib := import "./color";
surfLib := import "./surface";

/** Packed 32-bit ARGB color (`0xAARRGGBB`) stored inside Int. */
pub Color := alias Int;

/** Canvas dimensions and window title returned by setup and query calls. */
pub Context := alias (width: Int, height: Int, title: String);

/** Encoded canvas draw command opcode matching the Play stage wire format. */
CanvasOp := enum: Int {
    Clear = 1;
    FillRect = 2;
};

decodeCanvasOp := fn(raw: Int): Option<CanvasOp> {
    if raw == CanvasOp.Clear.value {
        .Some(CanvasOp.Clear)
    } else if raw == CanvasOp.FillRect.value {
        .Some(CanvasOp.FillRect)
    } else {
        .None
    }
};

/** Maximum 8-bit color channel intensity (`0..255`). */
COLOR_CHANNEL_MAX := 255;

/** Fully opaque 8-bit alpha channel value. */
OPAQUE_ALPHA := 255;

/** Default opaque black ARGB background (`0xFF000000`). */
DEFAULT_BG := 4278190080;

var canvasWidth := 0;
var canvasHeight := 0;
var canvasTitle := "";
var canvasPlaying := false;
var canvasDrawCount := 0;
var canvasBg := DEFAULT_BG;
var mut canvasPixels: List<Int> = [];
var mut canvasOps: List<Int> = [];

clampByte := fn(value: Int): Int {
    if value < 0 { 0 } else if value > COLOR_CHANNEL_MAX { COLOR_CHANNEL_MAX } else { value }
}

clampSize := fn(value: Int): Int {
    if value < 0 { 0 } else { value }
}

/** Packs RGBA color channels (each clamped to 0..255) into one Color integer. */
pub rgba := fn(red: Int, green: Int, blue: Int, alpha: Int): Color {
    r := clampByte(red);
    g := clampByte(green);
    b := clampByte(blue);
    a := clampByte(alpha);
    (a * 16777216) + (r * 65536) + (g * 256) + b
}

/** Packs opaque RGB color channels (each clamped to 0..255) into one Color integer. */
pub rgb := fn(red: Int, green: Int, blue: Int): Color {
    rgba(=red, =green, =blue, alpha = OPAQUE_ALPHA)
}

/** Configures a static canvas context using `width`, `height`, and `title`. */
pub create := fn(width: Int, height: Int, title: String): Context {
    canvasWidth = clampSize(width);
    canvasHeight = clampSize(height);
    canvasTitle = title;
    canvasPlaying = false;
    canvasBg = DEFAULT_BG;
    canvasPixels = [];
    canvasOps = [];
    canvasDrawCount += 1;
    (width = canvasWidth, height = canvasHeight, title = canvasTitle)
}

/** Configures an interactive animated canvas context and starts Play mode. */
pub play := fn(width: Int, height: Int, title: String): Context {
    canvasWidth = clampSize(width);
    canvasHeight = clampSize(height);
    canvasTitle = title;
    canvasPlaying = true;
    canvasBg = DEFAULT_BG;
    canvasPixels = [];
    canvasOps = [];
    canvasDrawCount += 1;
    (width = canvasWidth, height = canvasHeight, title = canvasTitle)
}

/** Resizes the active canvas while keeping its play mode and title. */
pub resize := fn(width: Int, height: Int): Context {
    canvasWidth = clampSize(width);
    canvasHeight = clampSize(height);
    canvasPixels = [];
    canvasOps = [];
    canvasDrawCount += 1;
    (width = canvasWidth, height = canvasHeight, title = canvasTitle)
}

/** Returns the active canvas context snapshot. */
pub context := fn(): Context {
    (width = canvasWidth, height = canvasHeight, title = canvasTitle)
}

/** Clears the active canvas using its latest configured dimensions and `color`. */
pub clear := fn(color: Color): Unit {
    canvasBg = color;
    canvasPixels = [];
    canvasOps = [CanvasOp.Clear.value, color];
}

/** Draws a single pixel at `(x, y)` on the active canvas. */
pub setPixel := fn(x: Int, y: Int, color: Color): Unit {
    if canvasWidth <= 0 or canvasHeight <= 0 { return; }
    if x < 0 or x >= canvasWidth or y < 0 or y >= canvasHeight { return; }
    (mut canvasOps).pushBack(CanvasOp.FillRect.value);
    mut canvasOps.pushBack(x);
    mut canvasOps.pushBack(y);
    mut canvasOps.pushBack(1);
    mut canvasOps.pushBack(1);
    mut canvasOps.pushBack(color);
}

/** Erases a single pixel at `(x, y)` back to the active canvas background color. */
pub unsetPixel := fn(x: Int, y: Int): Unit {
    setPixel(x, y, canvasBg);
}

/** Fills an axis-aligned rectangle `(x, y, width, height)` using alpha blending. */
pub fillRect := fn(x: Int, y: Int, width: Int, height: Int, color: Color): Unit {
    if canvasWidth <= 0 or canvasHeight <= 0 or width <= 0 or height <= 0 { return; }
    (mut canvasOps).pushBack(CanvasOp.FillRect.value);
    mut canvasOps.pushBack(x);
    mut canvasOps.pushBack(y);
    mut canvasOps.pushBack(width);
    mut canvasOps.pushBack(height);
    mut canvasOps.pushBack(color);
}

/** Submits a row-major `width * height` pixel list for the latest canvas dimensions. */
pub draw := fn(pixels: List<Color>): Unit {
    canvasPixels = pixels;
    canvasOps = [];
    canvasDrawCount += 1;
}

/** Returns the latest canvas width in pixels. */
pub getWidth := fn(): Int { canvasWidth }

/** Returns the latest canvas height in pixels. */
pub getHeight := fn(): Int { canvasHeight }

/** Returns the latest canvas title. */
pub getTitle := fn(): String { canvasTitle }

/** True when interactive Play mode was started with `play(...)`. */
pub isPlaying := fn(): Bool { canvasPlaying }

/** Returns a snapshot of the most recently drawn row-major pixel buffer. */
pub getPixels := fn(): List<Int> { canvasPixels }

/** Returns pending draw commands without clearing them. */
pub getOps := fn(): List<Int> { canvasOps }

/** Returns pending draw commands and clears the internal command queue. */
pub takeOps := fn(): List<Int> {
    out := canvasOps;
    canvasOps = [];
    out
}

/** Host bridge: returns current canvas metadata for the browser Play stage. */
pub litePlayCanvasSnapshot := fn(): (width: Int, height: Int, title: String, playing: Bool, drawCount: Int) {
    (width = canvasWidth, height = canvasHeight, title = canvasTitle, playing = canvasPlaying, drawCount = canvasDrawCount)
}

/** Host bridge: returns current pixel buffer for the browser Play stage. */
pub litePlayCanvasPixels := fn(): List<Int> { canvasPixels }

/** Host bridge: drains queued draw ops for the browser Play stage. */
pub litePlayCanvasTakeOps := fn(): List<Int> { takeOps() }

decodeColor := fn(argb: Color): colorLib.Color {
    a0 := (argb / 16777216) % 256;
    r0 := (argb / 65536) % 256;
    g0 := (argb / 256) % 256;
    b0 := argb % 256;
    a := if a0 < 0 { a0 + 256 } else { a0 };
    r := if r0 < 0 { r0 + 256 } else { r0 };
    g := if g0 < 0 { g0 + 256 } else { g0 };
    b := if b0 < 0 { b0 + 256 } else { b0 };
    colorLib.Color.fromRgba8(r, g, b, a)
}

defaultScale := fn(width: Int): Int {
    if width <= 240 { 3 } else if width <= 480 { 2 } else { 1 }
}

/** Renders any queued `gfx/canvas` pixel buffer, draw ops, and `media/audio` tones onto `win`, returning the updated draw count. */
pub flushToSurface := fn(win: surfLib.Surface, scale: Int, lastDrawCount: Int, muted: Bool): Int {
    effScale := if scale < 1 { 1 } else { scale };
    scaleF := effScale * 1.0;
    var nextDraw := lastDrawCount;
    pxLen := canvasPixels.length();
    if pxLen > 0 and pxLen == canvasWidth * canvasHeight and canvasDrawCount =!= lastDrawCount {
        nextDraw = canvasDrawCount;
        var py := 0;
        loop py < canvasHeight {
            rowOff := py * canvasWidth;
            var pxIdx := 0;
            loop pxIdx < canvasWidth {
                colVal := canvasPixels[rowOff + pxIdx];
                var runEnd := pxIdx + 1;
                loop runEnd < canvasWidth and canvasPixels[rowOff + runEnd] == colVal {
                    runEnd += 1;
                }
                win.fillRect(surfLib.rect(pxIdx * scaleF, py * scaleF, (runEnd - pxIdx) * scaleF, scaleF), decodeColor(colVal));
                pxIdx = runEnd;
            }
            py += 1;
        }
    }
    ops := takeOps();
    n := ops.length();
    var i := 0;
    loop i < n {
        match decodeCanvasOp(ops[i]) {
            .Some(op) {
                match op {
                    .Clear {
                        if i + 1 < n {
                            win.fillRect(surfLib.rect(0.0, 0.0, canvasWidth * scaleF, canvasHeight * scaleF), decodeColor(ops[i + 1]));
                            i += 2;
                        } else {
                            break;
                        }
                    }
                    .FillRect {
                        if i + 5 < n {
                            win.fillRect(surfLib.rect(ops[i + 1] * scaleF, ops[i + 2] * scaleF, ops[i + 3] * scaleF, ops[i + 4] * scaleF), decodeColor(ops[i + 5]));
                            i += 6;
                        } else {
                            break;
                        }
                    }
                }
            }
            .None {
                break;
            }
        }
    }
    tones := audioLib.drain();
    if not muted {
        tn := tones.length();
        var ti := 0;
        loop ti + 2 < tn {
            win.playTone(tones[ti], tones[ti + 1], tones[ti + 2]);
            ti += 3;
        }
    }
    nextDraw
}

/** Presents a static `gfx/canvas` composition through `gfx/surface`. */
pub show := fn(): Unit {
    if canvasWidth <= 0 or canvasHeight <= 0 { return; }
    scale := defaultScale(canvasWidth);
    win := surfLib.Surface.open(canvasTitle, canvasWidth * scale, canvasHeight * scale);
    _d := flushToSurface(win, scale, -1, false);
    win.present();
    win.close();
}

/** Runs an animated `gfx/canvas` update callback through `gfx/surface` until closed or `onUpdate` returns non-zero. */
pub start := fn(onUpdate: fn(Float): Int): Unit {
    if canvasWidth <= 0 or canvasHeight <= 0 { return; }
    scale := defaultScale(canvasWidth);
    win := surfLib.Surface.open(canvasTitle, canvasWidth * scale, canvasHeight * scale);
    var lastDraw := flushToSurface(win, scale, -1, false);
    win.run(fn(inp: surfLib.FrameInput): Bool {
        if not inp.open or inp.key == "Escape" { return false; }
        rawDt := inp.deltaMs / 1000.0;
        dt := if rawDt > 0.05 { 0.05 } else if rawDt <= 0.0 { 0.016 } else { rawDt };
        st := onUpdate(dt);
        lastDraw = flushToSurface(win, scale, lastDraw, false);
        st == 0
    });
    win.close();
}
