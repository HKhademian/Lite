/** Abstract, encoding-independent color values and color-space helpers. */

RawColor := alias (r: Float, g: Float, b: Float, a: Float);

/** Opaque nominal color value; zero-initialized `Color` is transparent black. */
pub Color := distinct RawColor;

clampUnit := fn(value: Float): Float {
    if value < 0.0 { return 0.0; }
    if value > 1.0 { return 1.0; }
    value
};

clampByte := fn(value: Int): Int {
    if value < 0 { return 0; }
    if value > 255 { return 255; }
    value
};

/** Constructs a color from normalized RGBA channel values in `0.0..1.0`. */
pub Color.fromRgba := fn(r: Float, g: Float, b: Float, a: Float): Self {
    cast((r = r, g = g, b = b, a = a))
};

/** Constructs an opaque color from normalized RGB channel values in `0.0..1.0`. */
pub Color.fromRgb := fn(r: Float, g: Float, b: Float): Self {
    cast((r = r, g = g, b = b, a = 1.0))
};

/** Constructs a color from 8-bit integer RGBA channel values in `0..255`. */
pub Color.fromRgba8 := fn(r: Int, g: Int, b: Int, a: Int): Self {
    cast((
        r = clampByte(r) / 255.0,
        g = clampByte(g) / 255.0,
        b = clampByte(b) / 255.0,
        a = clampByte(a) / 255.0
    ))
};

/** Constructs an opaque color from 8-bit integer RGB channel values in `0..255`. */
pub Color.fromRgb8 := fn(r: Int, g: Int, b: Int): Self {
    Color.fromRgba8(r, g, b, 255)
};

hueToRgb := fn(p: Float, q: Float, rawT: Float): Float {
    var t := rawT;
    if t < 0.0 { t = t + 1.0; }
    if t > 1.0 { t = t - 1.0; }
    if t < 1.0 / 6.0 { return p + (q - p) * 6.0 * t; }
    if t < 0.5 { return q; }
    if t < 2.0 / 3.0 { return p + (q - p) * (2.0 / 3.0 - t) * 6.0; }
    p
};

/** Constructs a color from hue (`0.0..360.0` degrees), saturation (`0.0..1.0`), lightness (`0.0..1.0`), and alpha (`0.0..1.0`). */
pub Color.fromHsla := fn(hueDeg: Float, saturation: Float, lightness: Float, alpha: Float): Self {
    s := clampUnit(saturation);
    l := clampUnit(lightness);
    a := clampUnit(alpha);
    if s == 0.0 {
        return cast((r = l, g = l, b = l, a = a));
    }
    var h := hueDeg / 360.0;
    loop h < 0.0 { h = h + 1.0; }
    loop h >= 1.0 { h = h - 1.0; }
    q := if l < 0.5 { l * (1.0 + s) } else { l + s - l * s };
    p := 2.0 * l - q;
    cast((
        r = hueToRgb(p, q, h + 1.0 / 3.0),
        g = hueToRgb(p, q, h),
        b = hueToRgb(p, q, h - 1.0 / 3.0),
        a = a
    ))
};

/** Constructs an opaque color from hue (`0.0..360.0` degrees), saturation (`0.0..1.0`), and lightness (`0.0..1.0`). */
pub Color.fromHsl := fn(hueDeg: Float, saturation: Float, lightness: Float): Self {
    Color.fromHsla(hueDeg, saturation, lightness, 1.0)
};

/** Reads the red channel as a normalized `Float` (`0.0..1.0`). */
pub Color.redFloat := fn(c: Self): Float { cast<RawColor>(c).r };

/** Reads the green channel as a normalized `Float` (`0.0..1.0`). */
pub Color.greenFloat := fn(c: Self): Float { cast<RawColor>(c).g };

/** Reads the blue channel as a normalized `Float` (`0.0..1.0`). */
pub Color.blueFloat := fn(c: Self): Float { cast<RawColor>(c).b };

/** Reads the alpha channel as a normalized `Float` (`0.0..1.0`). */
pub Color.alphaFloat := fn(c: Self): Float { cast<RawColor>(c).a };

toByte := fn(v: Float): Int {
    scaled := clampUnit(v) * 255.0 + 0.5;
    var lo := 0;
    var hi := 255;
    loop lo < hi {
        mid := (lo + hi + 1) / 2;
        if mid <= scaled {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
};

/** Reads the red channel quantized to `0..255`. */
pub Color.red8 := fn(c: Self): Int { toByte(c.redFloat()) };

/** Reads the green channel quantized to `0..255`. */
pub Color.green8 := fn(c: Self): Int { toByte(c.greenFloat()) };

/** Reads the blue channel quantized to `0..255`. */
pub Color.blue8 := fn(c: Self): Int { toByte(c.blueFloat()) };

/** Reads the alpha channel quantized to `0..255`. */
pub Color.alpha8 := fn(c: Self): Int { toByte(c.alphaFloat()) };

/** Returns a copy of `c` with its red channel replaced. */
pub Color.withRedFloat := fn(c: Self, r: Float): Self {
    raw := cast<RawColor>(c);
    cast((r = r, g = raw.g, b = raw.b, a = raw.a))
};

/** Returns a copy of `c` with its green channel replaced. */
pub Color.withGreenFloat := fn(c: Self, g: Float): Self {
    raw := cast<RawColor>(c);
    cast((r = raw.r, g = g, b = raw.b, a = raw.a))
};

/** Returns a copy of `c` with its blue channel replaced. */
pub Color.withBlueFloat := fn(c: Self, b: Float): Self {
    raw := cast<RawColor>(c);
    cast((r = raw.r, g = raw.g, b = b, a = raw.a))
};

/** Returns a copy of `c` with its alpha channel replaced. */
pub Color.withAlphaFloat := fn(c: Self, a: Float): Self {
    raw := cast<RawColor>(c);
    cast((r = raw.r, g = raw.g, b = raw.b, a = a))
};

/** Linearly interpolates between `a` and `b` by factor `t` (`0.0..1.0`). */
pub Color.mix := fn(a: Self, b: Color, t: Float): Self {
    k := clampUnit(t);
    inv := 1.0 - k;
    ra := cast<RawColor>(a);
    rb := cast<RawColor>(b);
    cast((
        r = ra.r * inv + rb.r * k,
        g = ra.g * inv + rb.g * k,
        b = ra.b * inv + rb.b * k,
        a = ra.a * inv + rb.a * k
    ))
};

/** Transparent black (`0, 0, 0, 0`). */
pub TRANSPARENT := Color.fromRgba(0.0, 0.0, 0.0, 0.0);

/** Opaque black. */
pub BLACK := Color.fromRgb(0.0, 0.0, 0.0);

/** Opaque white. */
pub WHITE := Color.fromRgb(1.0, 1.0, 1.0);

/** Pure red. */
pub RED := Color.fromRgb(1.0, 0.0, 0.0);

/** Pure green. */
pub GREEN := Color.fromRgb(0.0, 1.0, 0.0);

/** Pure blue. */
pub BLUE := Color.fromRgb(0.0, 0.0, 1.0);

/** Pure yellow. */
pub YELLOW := Color.fromRgb(1.0, 1.0, 0.0);

/** Pure cyan. */
pub CYAN := Color.fromRgb(0.0, 1.0, 1.0);

/** Pure magenta. */
pub MAGENTA := Color.fromRgb(1.0, 0.0, 1.0);
