/* Internal host-discovery helpers shared by `lite/builder` and `lite/runner` with zero repo-tool dependencies. */

hostFs := import "../compiler/host-fs";
fs := import "core/file";
path := import "core/path";
proc := import "core/process";
json := import "data/json";

/** Resolves the Node executable path from `LITE_NODE`, `proc.execPath()`, or `"node"`. */
pub nodeExecPath := fn(): String {
    envNode := proc.envGet("LITE_NODE");
    if envNode.found and envNode.value =!= "" { return envNode.value; }
    exec := proc.execPath();
    base := path.baseName(exec);
    if base == "node" or base == "node.exe" { return exec; }
    "node"
};

/** Locates the canonical Lite repository or distribution root from entry script or cwd. */
pub findRepoRoot := fn(): String {
    hostFs.findProjectRoot(proc.entryPath(), "", proc.cwd())
};

/** Resolves the selected JS-hosted compiler entrypoint (`ts` or `c`) for `root`. */
pub selectCompilerPath := fn(root: String, target: String): (ok: Bool, path: String, error: String) {
    if root == "" {
        return (ok = true, path = "dist/bootstrap/compiler.ts", error = "");
    }
    emptyEnv: List<String> = [];
    nativeTool := path.join(root, "dist/tools/compiler-build");
    tsTool := path.join(root, "dist/tools/compiler-build.ts");
    res := if fs.kind(nativeTool) == fs.FILE_KIND_FILE {
        proc.run(nativeTool, ["--root", root, "--target", target], root, emptyEnv, true, "")
    } else if fs.kind(tsTool) == fs.FILE_KIND_FILE {
        proc.run(nodeExecPath(), [tsTool, "--root", root, "--target", target], root, emptyEnv, true, "")
    } else {
        if target == "ts" {
            return (ok = true, path = path.join(root, "dist/bootstrap/compiler.ts"), error = "");
        }
        return (ok = false, path = "", error = "missing compiler-build tool for target " + target);
    };
    if res.error =!= "" {
        return (ok = false, path = "", error = res.error);
    }
    if res.status =!= 0 {
        return (ok = false, path = "", error = res.stderr);
    }
    pField := json.readFieldString(res.stdout, 0, "path");
    if not pField.found or not pField.ok or pField.value == "" {
        return (ok = false, path = "", error = "invalid compiler-build response");
    }
    (ok = true, path = pField.value, error = "")
};
