diagLib := import "core/diag";
collections := import "core/list";
tb := import "core/text-builder";
frontend := import "./frontend";
types := import "./frontend-types";
interfaces := import "./interfaces";
contexts := import "./contexts";
overloads := import "./overloads";
generics := import "./generics";
hostFs := import "./host-fs";
comptimeEval := import "./comptime-eval";
/* Initial source graph traversal for the generated TypeScript compiler. */

/** True when the graph has entered one canonical source path. */
moduleVisited := fn(graph: frontend.Items, path: String): Bool {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_VISITED and item.name == path { return true; }
    }
    false
}

/** True when the graph completed parsing one canonical source path. */
moduleProcessed := fn(graph: frontend.Items, path: String): Bool {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_PROCESSED and item.name == path { return true; }
    }
    false
}

/** Returns true when `values` already contains integer `needle`. */
listContainsInt := fn(values: List<Int>, needle: Int): Bool {
    loop values as value {
        if value == needle { return true; }
    }
    false
}

/** Returns ASCII code point for printable ASCII and standard whitespace, or -1 for non-ASCII. */
asciiCode := fn(ch: String): Int {
    if ch.length() =!= 1 { return -1; }
    printable := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    found := printable.indexOf(ch, 0);
    if found >= 0 { return found + 32; }
    if ch == "\t" { return 9; }
    if ch == "\n" { return 10; }
    if ch == "\r" { return 13; }
    -1
}

/** Strict weak lexicographic comparison of two strings via ASCII codes (-1, 0, or 1). */
compareText := fn(left: String, right: String): Int {
    leftLen := left.length();
    rightLen := right.length();
    limit := if leftLen < rightLen { leftLen } else { rightLen };
    var index := 0;
    loop index < limit {
        leftCh := left.at(index);
        rightCh := right.at(index);
        if leftCh =!= rightCh {
            leftCode := asciiCode(leftCh);
            rightCode := asciiCode(rightCh);
            if leftCode < rightCode { return -1; }
            if leftCode > rightCode { return 1; }
        }
        index = index + 1;
    }
    if leftLen < rightLen { -1 } else if leftLen > rightLen { 1 } else { 0 }
}

/** Converts Windows backslashes to forward slashes so path slugs are platform-uniform. */
normalizeSlashes := fn(path: String): String {
    if path.indexOf("\\", 0) < 0 { return path; }
    mut result: tb.TextBuilder;
    var index := 0;
    size := path.length();
    loop index < size {
        ch := path.at(index);
        mut result.append(if ch == "\\" { "/" } else { ch });
        index = index + 1;
    }
    result.build()
}

/** Drops one trailing `.lt` or `.lts` suffix when a non-empty stem precedes it. */
stripLtsExtension := fn(name: String): String {
    size := name.length();
    if size > 4 and name.startsWithAt(size - 4, ".lts") {
        return name.slice(0, size - 4);
    }
    if size > 3 and name.startsWithAt(size - 3, ".lt") {
        return name.slice(0, size - 3);
    }
    name
}

/** Returns the directory component of `path` without trailing slash (or `"/"`, or `""`). */
dirnameOfPath := fn(path: String): String {
    var index := path.length() - 1;
    loop index >= 0 {
        if path.at(index) == "/" {
            if index == 0 { return "/"; }
            return path.slice(0, index);
        }
        index = index - 1;
    }
    ""
}

/** Returns the final path segment of `path`. */
basenameOfPath := fn(path: String): String {
    size := path.length();
    var index := size - 1;
    loop index >= 0 {
        if path.at(index) == "/" {
            return path.slice(index + 1, size);
        }
        index = index - 1;
    }
    path
}

/** Computes `path` relative to `rootDir` when they share a non-root tree, else `""`. */
relativeFromDir := fn(rootDir: String, path: String): String {
    normPath := normalizeSlashes(path);
    if rootDir == "" {
        if normPath == "" or normPath.startsWithAt(0, "/") { return ""; }
        return normPath;
    }
    if rootDir == "/" {
        if normPath.startsWithAt(0, "/") {
            return normPath.slice(1, normPath.length());
        }
        return "";
    }
    rootIsAbs := rootDir.startsWithAt(0, "/");
    pathIsAbs := normPath.startsWithAt(0, "/");
    if rootIsAbs =!= pathIsAbs { return ""; }
    rootSlash := rootDir + "/";
    rootLen := rootSlash.length();
    pathLen := normPath.length();
    limit := if rootLen < pathLen { rootLen } else { pathLen };
    var index := 0;
    var commonSlash := -1;
    loop index < limit {
        ch := rootSlash.at(index);
        if ch =!= normPath.at(index) { break; }
        if ch == "/" { commonSlash = index; }
        index = index + 1;
    }
    if rootIsAbs and commonSlash <= 0 { return ""; }
    var prefix := "";
    var scan := commonSlash + 1;
    loop scan < rootLen {
        if rootSlash.at(scan) == "/" { prefix = prefix + "../"; }
        scan = scan + 1;
    }
    prefix + normPath.slice(commonSlash + 1, pathLen)
}

/** Derives a repo-location-independent logical name for one module. */
logicalModuleName := fn(rootDir: String, path: String, display: String): String {
    normDisplay := normalizeSlashes(display);
    if normDisplay.startsWithAt(0, "lib/") {
        cleanedStd := stripLtsExtension(normDisplay);
        if cleanedStd =!= "" { return cleanedStd; }
    }
    relative := relativeFromDir(rootDir, path);
    if relative =!= "" {
        cleanedRel := stripLtsExtension(relative);
        if cleanedRel =!= "" { return cleanedRel; }
    }
    cleanedDisp := stripLtsExtension(normDisplay);
    if cleanedDisp =!= "" { return cleanedDisp; }
    cleanedBase := stripLtsExtension(basenameOfPath(normalizeSlashes(path)));
    if cleanedBase =!= "" { return cleanedBase; }
    "module"
}

/** Prefix-free, injective target identifier slug for one logical module path. */
encodeModuleSlug := fn(target: String, logical: String): String {
    mut result: tb.TextBuilder;
    var index := 0;
    size := logical.length();
    loop index < size {
        ch := logical.at(index);
        if ch.isAsciiLetter() or ch.isDigit() {
            mut result.append(ch);
        } else if ch == "/" {
            mut result.append(if target == frontend.TARGET_TS { "$" } else { "_s_" });
        } else if ch == "-" {
            mut result.append(if target == frontend.TARGET_TS { "__" } else { "_d_" });
        } else if ch == "_" {
            mut result.append("_u_");
        } else if ch == "." {
            mut result.append("_p_");
        } else {
            code := asciiCode(ch);
            mut result.append(if code >= 0 { "_a" + code.toText() + "_" } else { "_z_" });
        }
        index = index + 1;
    }
    built := result.build();
    if built == "" { return "module"; }
    built
}

/** Returns true if any visited module already reserves `moduleKey`. */
graphUsesModuleKey := fn(graph: frontend.Items, moduleKey: String): Bool {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_VISITED and item.textValue == moduleKey { return true; }
    }
    false
}

/** Assigns a unique module key, disambiguating rare non-ASCII `_z_` collisions cleanly. */
uniqueModuleKey := fn(graph: frontend.Items, target: String, baseSlug: String): String {
    if not graphUsesModuleKey(graph, baseSlug) { return baseSlug; }
    var suffix := 2;
    loop true {
        candidate := if target == frontend.TARGET_TS { baseSlug + "$" + suffix.toText() }
        else { baseSlug + "_k" + suffix.toText() + "_" };
        if not graphUsesModuleKey(graph, candidate) { return candidate; }
        suffix = suffix + 1;
    }
    baseSlug
}

/** Returns the entry module's directory recorded on the root visit record. */
rootDirForGraph := fn(graph: frontend.Items): String {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_VISITED and item.intValue == 1 { return item.runtime; }
    }
    ""
}

/** Returns the unique encoded module key assigned to `path`. */
moduleKeyForPath := fn(graph: frontend.Items, path: String): String {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_VISITED and item.name == path { return item.textValue; }
    }
    ""
}

/** Returns the module identity recorded on `ITEM_KIND_MODULE_PROCESSED` for `path`, or `""`. */
moduleIdentityForPath := fn(graph: frontend.Items, path: String): String {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_PROCESSED and item.name == path { return item.textValue; }
    }
    ""
}

/** Returns the computed topological DAG level of a processed module `path`. */
moduleLevelForPath := fn(graph: frontend.Items, path: String): Int {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_PROCESSED and item.name == path { return item.intValue; }
    }
    0
}

/** Returns direct dependency indices `[0..count)` sorted deterministically by `(logical, path)`. */
sortedDepIndices := fn(logicals: List<String>, paths: List<String>, count: Int): List<Int> {
    collections.sortIndicesBy(count, fn(a: Int, b: Int): Bool {
        cmpLogical := compareText(logicals[a], logicals[b]);
        if cmpLogical =!= 0 { cmpLogical < 0 } else { compareText(paths[a], paths[b]) <= 0 }
    })
}

/** Resolves the imported canonical module path recorded for `(importerPath, spec)` in `graph`, or `""`. */
importEdgeTargetPath := fn(graph: frontend.Items, importerPath: String, spec: String): String {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_IMPORT_EDGE and item.name == importerPath and item.code == spec {
            return item.runtime;
        }
    }
    ""
};

/** Returns the leading unqualified symbol or module alias segment before any `.`. */
topLevelHeadName := fn(name: String): String {
    dotIdx := name.indexOf(".", 0);
    if dotIdx >= 0 { name.slice(0, dotIdx) } else { name }
};

/** Collects public declarations for one module, expanding `pub import` and `pub alias := import` recursively without cycles. */
collectPublicDeclsWithVisited := fn(graph: frontend.Items, path: String, seenPaths: Set<String>): frontend.Items {
    mut result: frontend.Items = [];
    if seenPaths.has(path) { return result; }
    var mut nextSeen := seenPaths;
    mut nextSeen.add(path);
    var inside := false;
    var mut reexportImports: frontend.Items = [];
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START { inside = item.name == path; }
        else if item.kind == frontend.ITEM_KIND_MODULE_END and inside { break; }
        else if inside {
            if item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or
            (item.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP and frontend.isAliasOpKey(item.name)) {
                mut result.pushBack(item);
            } else if item.kind == frontend.ITEM_KIND_IMPORT and (item.code == "pub_unpack" or item.code == "pub_alias" or item.code == "pub_destruct") {
                mut reexportImports.pushBack(item);
            }
        }
    }
    loop reexportImports as imp {
        depPath := importEdgeTargetPath(graph, path, imp.textValue);
        if depPath =!= "" {
            subDecls := self(graph, depPath, nextSeen);
            if imp.code == "pub_unpack" {
                loop subDecls as sd { mut result.pushBack(sd); }
            } else if imp.code == "pub_destruct" {
                destrDecls := selectDestructuredExports(subDecls, imp.name, imp.textValue, path);
                loop destrDecls as dd { mut result.pushBack(dd); }
            } else {
                mut result.pushBack((kind = frontend.ITEM_KIND_MODULE_ALIAS, name = imp.name, runtime = moduleKeyForPath(graph, depPath),
                code = moduleIdentityForPath(graph, depPath), intValue = 0, textValue = depPath));
                loop subDecls as sd {
                    mut result.pushBack((kind = sd.kind, name = imp.name + "." + sd.name, runtime = sd.runtime,
                    code = sd.code, intValue = sd.intValue, textValue = sd.textValue));
                }
            }
        }
    }
    result
};

/** Returns synthetic `$BuiltinFamily:` exports when an in-progress core owner module is imported cyclically during root core preloading. */
coreCycleFamilyExports := fn(depPath: String, modAlias: String): frontend.Items {
    normDep := normalizeSlashes(depPath);
    if normDep.endsWith("/lib/type/slice.lt") or normDep.endsWith("/lib/core/slice.lt") {
        return [
        (kind = frontend.ITEM_KIND_MODULE_ALIAS, name = modAlias, runtime = "", code = "lite.type.slice.v1", intValue = 0, textValue = depPath),
        (kind = frontend.ITEM_KIND_PUBLIC_TYPE, name = modAlias + ".Slice", runtime = "", code = "$BuiltinFamily:Slice", intValue = 0, textValue = "")
        ];
    }
    if normDep.endsWith("/lib/type/rc.lt") or normDep.endsWith("/lib/core/rc.lt") {
        return [
        (kind = frontend.ITEM_KIND_MODULE_ALIAS, name = modAlias, runtime = "", code = "lite.type.rc.v1", intValue = 0, textValue = depPath),
        (kind = frontend.ITEM_KIND_PUBLIC_TYPE, name = modAlias + ".Rc", runtime = "", code = "$BuiltinFamily:Rc", intValue = 0, textValue = "")
        ];
    }
    if normDep.endsWith("/lib/type/simd.lt") or normDep.endsWith("/lib/core/simd.lt") {
        return [
        (kind = frontend.ITEM_KIND_MODULE_ALIAS, name = modAlias, runtime = "", code = "lite.type.simd.v1", intValue = 0, textValue = depPath),
        (kind = frontend.ITEM_KIND_PUBLIC_TYPE, name = modAlias + ".Simd", runtime = "", code = "$BuiltinFamily:Simd", intValue = 0, textValue = ""),
        (kind = frontend.ITEM_KIND_PUBLIC_TYPE, name = modAlias + ".SimdNative", runtime = "", code = "$BuiltinFamily:SimdNative", intValue = 0, textValue = "")
        ];
    }
    if normDep.endsWith("/lib/type/soa.lt") or normDep.endsWith("/lib/core/soa.lt") {
        return [
        (kind = frontend.ITEM_KIND_MODULE_ALIAS, name = modAlias, runtime = "", code = "lite.type.soa.v1", intValue = 0, textValue = depPath),
        (kind = frontend.ITEM_KIND_PUBLIC_TYPE, name = modAlias + ".SoA", runtime = "", code = "$BuiltinFamily:SoA", intValue = 0, textValue = "")
        ];
    }
    empty: frontend.Items = [];
    empty
};

/** Returns public declaration records for one completed source module. */
modulePublicDeclarations := fn(graph: frontend.Items, path: String): frontend.Items {
    emptySeen: Set<String>;
    collectPublicDeclsWithVisited(graph, path, emptySeen)
}
/** Appends an import interface, rejecting alias, value, and duplicate-runtime collisions while allowing overloaded functions. */
appendModuleExports := fn(existing: frontend.Items, incoming: frontend.Items, prefix: String): frontend.Items {
    var mut result: frontend.Items = existing;
    mut seenValueOrAlias: Set<String>;
    mut seenFnNames: Set<String>;
    mut seenFnRuntimes: Set<String>;
    mut seenTypes: Set<String>;
    loop existing as previous {
        if previous.kind == frontend.ITEM_KIND_MODULE_ALIAS or previous.kind == frontend.ITEM_KIND_PUBLIC_VALUE {
            mut seenValueOrAlias.add(previous.name);
        } else if previous.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION {
            mut seenFnNames.add(previous.name);
            mut seenFnRuntimes.add(previous.name + "|" + previous.runtime);
        } else if previous.kind == frontend.ITEM_KIND_PUBLIC_TYPE {
            mut seenTypes.add(previous.name);
        }
    }
    loop incoming as item {
        if item.kind == frontend.ITEM_KIND_MODULE_ALIAS {
            if seenValueOrAlias.has(item.name) or seenFnNames.has(item.name) {
                diagLib.fail(prefix, "duplicate module alias " + item.name);
            }
            (mut seenValueOrAlias).add(item.name);
        } else if item.kind == frontend.ITEM_KIND_PUBLIC_VALUE {
            if seenValueOrAlias.has(item.name) or seenFnNames.has(item.name) {
                diagLib.fail(prefix, "duplicate imported public name " + item.name);
            }
            (mut seenValueOrAlias).add(item.name);
        } else if item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION {
            if seenValueOrAlias.has(item.name) or seenFnRuntimes.has(item.name + "|" + item.runtime) {
                diagLib.fail(prefix, "duplicate imported public name " + item.name);
            }
            (mut seenFnNames).add(item.name);
            (mut seenFnRuntimes).add(item.name + "|" + item.runtime);
        } else if item.kind == frontend.ITEM_KIND_PUBLIC_TYPE {
            if seenTypes.has(item.name) {
                diagLib.fail(prefix, "duplicate imported public type " + item.name);
            }
            (mut seenTypes).add(item.name);
        }
        (mut result).pushBack(item);
    }
    result
}

/** Collects all `PublicTypeOp` declarations across already-processed modules in `graph` (excluding `skipModPath`), deduplicated by canonical key+runtime. */
appendTransitiveTypeOps := fn(graph: frontend.Items, existing: frontend.Items, skipModPath: String): frontend.Items {
    var mut result: frontend.Items = existing;
    mut seenOps: Set<String>;
    loop existing as prev {
        if prev.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP or prev.kind == frontend.ITEM_KIND_PUBLIC_IMPL or
        (prev.kind == frontend.ITEM_KIND_PUBLIC_VALUE and prev.textValue.startsWithAt(0, "$typeprop:")) {
            mut seenOps.add(prev.kind + "|" + prev.name + "|" + prev.runtime);
        }
    }
    var insideSkip := false;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            insideSkip = skipModPath =!= "" and item.name == skipModPath;
        } else if item.kind == frontend.ITEM_KIND_MODULE_END {
            insideSkip = false;
        } else if not insideSkip and (
        (item.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP and not frontend.isAliasOpKey(item.name)) or
        item.kind == frontend.ITEM_KIND_PUBLIC_IMPL or
        (item.kind == frontend.ITEM_KIND_PUBLIC_VALUE and item.textValue.startsWithAt(0, "$typeprop:"))) {
            opDedupKey := item.kind + "|" + item.name + "|" + item.runtime;
            if not seenOps.has(opDedupKey) {
                mut seenOps.add(opDedupKey);
                mut result.pushBack(item);
            }
        }
    }
    result
}

/** Selects and renames requested `(localName, exportedName)` declarations from `subDecls`, failing if any export is missing. */
selectDestructuredExports := fn(subDecls: frontend.Items, encodedBindings: String, importSpec: String, prefix: String): frontend.Items {
    mut out: frontend.Items = [];
    var pos := 0;
    loop pos < encodedBindings.length() {
        locDec := types.decodeLengthPrefixedAt(encodedBindings, pos);
        if locDec.next < 0 { break; }
        expDec := types.decodeLengthPrefixedAt(encodedBindings, locDec.next);
        if expDec.next < 0 { break; }
        pos = expDec.next;
        localName := locDec.text;
        exportedName := expDec.text;
        var matched := false;
        loop subDecls as sd {
            if sd.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP and frontend.isAliasOpKey(sd.name) {
                ak := frontend.parseAliasOpKey(sd.name);
                if ak.ok and ak.aliasName == exportedName {
                    matched = true;
                    nextOpName := if localName =!= exportedName { frontend.renameAliasOpKey(sd.name, localName) } else { sd.name };
                    mut out.pushBack((kind = sd.kind, name = nextOpName, runtime = sd.runtime,
                    code = sd.code, intValue = sd.intValue, textValue = sd.textValue));
                }
            } else if sd.name == exportedName {
                matched = true;
                mut out.pushBack((kind = sd.kind, name = localName, runtime = sd.runtime,
                code = sd.code, intValue = sd.intValue, textValue = sd.textValue));
            } else if sd.name.startsWithAt(0, exportedName + ".") {
                matched = true;
                suffix := sd.name.slice(exportedName.length(), sd.name.length());
                mut out.pushBack((kind = sd.kind, name = localName + suffix, runtime = sd.runtime,
                code = sd.code, intValue = sd.intValue, textValue = sd.textValue));
            }
        }
        if not matched {
            diagLib.fail(prefix, "module " + importSpec + " has no public export " + exportedName);
        }
    }
    out
};

/** Builds selectively imported declarations from `path` using encoded `(localName, exportedName)` bindings. */
moduleDestructuredExports := fn(graph: frontend.Items, path: String, encodedBindings: String, importSpec: String, prefix: String): frontend.Items {
    selectDestructuredExports(modulePublicDeclarations(graph, path), encodedBindings, importSpec, prefix)
};

/** Builds one aliased module namespace from its source-declared public interface. */
moduleAliasExports := fn(graph: frontend.Items, path: String, modAlias: String): frontend.Items {
    mut result: frontend.Items = [(kind = frontend.ITEM_KIND_MODULE_ALIAS, name = modAlias, runtime = moduleKeyForPath(graph, path), code = moduleIdentityForPath(graph, path),
    intValue = 0, textValue = path)];
    loop modulePublicDeclarations(graph, path) as item {
        if item.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP and frontend.isAliasOpKey(item.name) {
            mut result.pushBack(item);
        } else {
            mut result.pushBack((kind = item.kind, name = modAlias + "." + item.name, runtime = item.runtime,
            code = item.code, intValue = item.intValue, textValue = item.textValue));
        }
    }
    result
}

/** Function runtime prefix used for `moduleKey` in `target` output. */
coreFnPrefix := fn(target: String, moduleKey: String): String {
    if target == frontend.TARGET_TS { return "liteFn$" + moduleKey + "$"; }
    "lt_fn_" + moduleKey + "__"
}

/** True when `token` names a compiled function owned directly by `moduleKey` (not a nested submodule). */
tokenBelongsToModuleFn := fn(target: String, moduleKey: String, prefix: String, token: String): Bool {
    tokLen := token.length();
    if tokLen == 0 or token.at(tokLen - 1) =!= "(" { return false; }
    if not token.startsWithAt(0, prefix) { return false; }
    sep := if target == frontend.TARGET_TS { "$" } else { "__" };
    token.indexOf(sep, prefix.length()) < 0
}

/** True when `reachable` references at least one function owned by `moduleKey` not yet in `compiledFns`. */
coreModuleNeedsReparse := fn(target: String, moduleKey: String, reachable: String, compiledFns: frontend.TokenBuckets): Bool {
    prefix := coreFnPrefix(target, moduleKey);
    needle := "|" + prefix;
    var pos := 0;
    loop true {
        hit := reachable.indexOf(needle, pos);
        if hit < 0 { return false; }
        tokStart := hit + 1;
        nextBar := reachable.indexOf("|", tokStart);
        tokEnd := if nextBar >= 0 { nextBar } else { reachable.length() };
        if tokEnd > tokStart and reachable.at(tokEnd - 1) == "(" {
            token := reachable.slice(tokStart, tokEnd);
            if tokenBelongsToModuleFn(target, moduleKey, prefix, token) and
            not frontend.tokenBucketHas(compiledFns, token) {
                return true;
            }
        }
        pos = tokEnd;
    }
    false
}

/** Inserts `<fnRuntime>(` for every `FunctionStart` present in `items` into `compiled` in place. */
addCompiledFnsSet := fn(items: frontend.Items, compiled: mut frontend.TokenBuckets): Unit {
    loop items as item {
        if item.kind == frontend.ITEM_KIND_FUNCTION_START and item.runtime =!= "" {
            frontend.tokenBucketAdd(mut compiled, item.runtime + "(");
        }
    }
}

/** Adds identifier/call tokens referenced by one emitted item into `tokens` in place. */
scanItemTokens := fn(item: frontend.Item, tokens: mut frontend.TokenBuckets): Unit {
    frontend.codeReachableTokensSet(item.code, mut tokens);
    if item.kind.startsWithAt(0, "Assign") and item.runtime =!= "" {
        frontend.tokenBucketAdd(mut tokens, item.runtime);
    }
}

/** Adds top-level non-pure item tokens from `items` into `seed` in place. */
scanTopLevelTokens := fn(items: frontend.Items, seed: mut frontend.TokenBuckets): Unit {
    var fnDepth := 0;
    var blockDepth := 0;
    var nextIsPure := false;
    loop items as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            fnDepth = 0;
            blockDepth = 0;
            nextIsPure = false;
            continue;
        }
        if item.kind == frontend.ITEM_KIND_MODULE_END or item.kind == frontend.ITEM_KIND_MODULE_VISITED or item.kind == frontend.ITEM_KIND_MODULE_PROCESSED or
        item.kind == frontend.ITEM_KIND_CORE_MODULE_META or item.kind == frontend.ITEM_KIND_CORE_MODULE_SOURCE or item.kind == frontend.ITEM_KIND_CORE_MODULE_IMPORT {
            nextIsPure = false;
            continue;
        }
        if item.kind == frontend.ITEM_KIND_PURE_GLOBAL {
            nextIsPure = true;
            continue;
        }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            fnDepth = fnDepth + 1;
            nextIsPure = false;
            continue;
        }
        if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
            nextIsPure = false;
            continue;
        }
        if fnDepth > 0 {
            nextIsPure = false;
            continue;
        }
        isPureDecl := blockDepth == 0 and nextIsPure;
        nextIsPure = false;
        if item.kind == frontend.ITEM_KIND_SCOPE or item.kind == frontend.ITEM_KIND_IF or item.kind == frontend.ITEM_KIND_LOOP or item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            blockDepth = blockDepth + 1;
            frontend.codeReachableTokensSet(item.code, mut seed);
        } else if item.kind == frontend.ITEM_KIND_END_SCOPE or item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_LOOP {
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if not isPureDecl and item.kind =!= frontend.ITEM_KIND_IMPORT and item.kind =!= frontend.ITEM_KIND_PUBLIC_FUNCTION and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE_OP and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_VALUE and item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE and item.kind =!= frontend.ITEM_KIND_PUBLIC_IMPL and item.kind =!= frontend.ITEM_KIND_PUBLIC_CONTEXT and item.kind =!= frontend.ITEM_KIND_NOOP and item.kind =!= frontend.ITEM_KIND_SOURCE_LOC and item.kind =!= frontend.ITEM_KIND_COMMENT {
            scanItemTokens(item, mut seed);
        }
    }
}

/** Propagates reachable tokens through compiled functions and pure globals in `graph` in place via an O(V + E) BFS worklist. */
closeReachableTokens := fn(graph: frontend.Items, reachable: mut frontend.TokenBuckets,
scanned: mut frontend.TokenBuckets): Unit {
    frontend.closeReachableGraph(graph, mut reachable, mut scanned);
}

/** Collects `ModuleStart`..`ModuleEnd` slices for modules whose path is in `metaPaths`. */
collectCoreGraphSlice := fn(graph: frontend.Items, metaPaths: List<String>): frontend.Items {
    mut metaSet: Set<String>;
    loop metaPaths as mp { mut metaSet.add(mp); }
    mut slice: frontend.Items = [];
    var keep := false;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            keep = metaSet.has(item.name);
        }
        if keep {
            mut slice.pushBack(item);
            if item.kind == frontend.ITEM_KIND_MODULE_END { keep = false; }
        }
    }
    slice
}

/** Collects non-core top-level `FunctionStart` tokens present in `graph` that are not yet in `scanned`. */
collectUnscannedNonCoreFns := fn(graph: frontend.Items, metaPaths: List<String>, scanned: frontend.TokenBuckets): List<String> {
    mut metaSet: Set<String>;
    loop metaPaths as mp { mut metaSet.add(mp); }
    mut result: List<String> = [];
    var inCore := false;
    var fnDepth := 0;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            inCore = metaSet.has(item.name);
            fnDepth = 0;
        } else if item.kind == frontend.ITEM_KIND_MODULE_END {
            inCore = false;
            fnDepth = 0;
        } else if not inCore {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                if fnDepth == 0 and item.runtime =!= "" {
                    tok := item.runtime + "(";
                    if not frontend.tokenBucketHas(scanned, tok) {
                        mut result.pushBack(tok);
                    }
                }
                fnDepth = fnDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END and fnDepth > 0 {
                fnDepth = fnDepth - 1;
            }
        }
    }
    result
}

/** True when any token in `candidates` became reachable and has not been scanned yet. */
hasNewlyReachableToken := fn(candidates: List<String>, reachable: frontend.TokenBuckets, scanned: frontend.TokenBuckets): Bool {
    loop candidates as tok {
        if frontend.tokenBucketHas(reachable, tok) and not frontend.tokenBucketHas(scanned, tok) {
            return true;
        }
    }
    false
}

/** Replaces the body items between `ModuleStart` and `ModuleEnd` for canonical `path`. */
replaceModuleItems := fn(graph: frontend.Items, path: String, replacement: frontend.Items): frontend.Items {
    mut updated: frontend.Items = [];
    var skipping := false;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START and item.name == path {
            mut updated.pushBack(item);
            loop replacement as rep { mut updated.pushBack(rep); }
            skipping = true;
        } else if skipping {
            if item.kind == frontend.ITEM_KIND_MODULE_END {
                mut updated.pushBack(item);
                skipping = false;
            }
        } else {
            mut updated.pushBack(item);
        }
    }
    updated
}

/** Strips temporary `CoreModuleMeta`, `CoreModuleSource`, and `CoreModuleImport` bookkeeping records. */
stripCoreMeta := fn(graph: frontend.Items): frontend.Items {
    mut cleaned: frontend.Items = [];
    loop graph as item {
        if item.kind =!= frontend.ITEM_KIND_CORE_MODULE_META and item.kind =!= frontend.ITEM_KIND_CORE_MODULE_SOURCE and item.kind =!= frontend.ITEM_KIND_CORE_MODULE_IMPORT {
            mut cleaned.pushBack(item);
        }
    }
    cleaned
}

/** Prepends preload exports wrapped in `PRELOAD_MARK` markers without colliding with explicit imports. */
appendPreloadExports := fn(graph: frontend.Items, preloadPath: String, explicitExports: frontend.Items, prefix: String): frontend.Items {
    if preloadPath == "" or not moduleProcessed(graph, preloadPath) {
        return explicitExports;
    }
    mut explicitHeadNames: Set<String>;
    loop explicitExports as expItem {
        mut explicitHeadNames.add(topLevelHeadName(expItem.name));
    }
    rawPreloadExports := modulePublicDeclarations(graph, preloadPath);
    mut filteredPreload: frontend.Items = [];
    loop rawPreloadExports as pItem {
        if not explicitHeadNames.has(topLevelHeadName(pItem.name)) {
            mut filteredPreload.pushBack(pItem);
        }
    }
    if filteredPreload.length() == 0 {
        return explicitExports;
    }
    combinedWithPreload := appendModuleExports(explicitExports, filteredPreload, prefix);
    expCount := explicitExports.length();
    var mut rebuiltExports: frontend.Items = [];
    mut rebuiltExports.pushBack((kind = frontend.ITEM_KIND_PRELOAD_MARK, name = "start", runtime = "", code = "", intValue = 0, textValue = ""));
    var ci := expCount;
    loop ci < combinedWithPreload.length() {
        mut rebuiltExports.pushBack(combinedWithPreload[ci]);
        ci = ci + 1;
    }
    mut rebuiltExports.pushBack((kind = frontend.ITEM_KIND_PRELOAD_MARK, name = "end", runtime = "", code = "", intValue = 0, textValue = ""));
    var ei := 0;
    loop ei < expCount {
        mut rebuiltExports.pushBack(combinedWithPreload[ei]);
        ei = ei + 1;
    }
    rebuiltExports
};

/** Collects cached import exports for core module `modPath` from `CoreModuleImport` records. */
coreModuleExports := fn(graph: frontend.Items, modPath: String): frontend.Items {
    var mut importedExports: frontend.Items = [];
    var preloadPath := "";
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_CORE_MODULE_IMPORT and item.name == modPath {
            if item.textValue == "$preload" {
                preloadPath = item.code;
            } else if moduleProcessed(graph, item.code) {
                incoming := if item.textValue == "unpack" or item.textValue == "pub_unpack" {
                    modulePublicDeclarations(graph, item.code)
                } else if item.textValue == "destruct" or item.textValue == "pub_destruct" {
                    moduleDestructuredExports(graph, item.code, item.runtime, item.code, modPath)
                } else {
                    moduleAliasExports(graph, item.code, item.runtime)
                };
                importedExports = appendModuleExports(importedExports, incoming, modPath);
            }
        }
    }
    appendPreloadExports(graph, preloadPath, importedExports, modPath)
}

/** Splices compiled generic monomorphization items (grouped by `ITEM_KIND_MONO_OWNER` markers) right before their owning module's `ModuleEnd`. */
spliceGenericItems := fn(graph: frontend.Items, monoItems: frontend.Items): frontend.Items {
    if monoItems.length() == 0 { return graph; }
    mut result: frontend.Items = [];
    var currentModKey := "";
    var insideMod := false;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            currentModKey = item.runtime;
            insideMod = true;
            mut result.pushBack(item);
        } else if item.kind == frontend.ITEM_KIND_MODULE_END and insideMod {
            var ownerMatches := false;
            loop monoItems as mi {
                if mi.kind == frontend.ITEM_KIND_MONO_OWNER {
                    ownerMatches = mi.runtime == currentModKey;
                } else if ownerMatches {
                    mut result.pushBack(mi);
                }
            }
            insideMod = false;
            mut result.pushBack(item);
        } else {
            mut result.pushBack(item);
        }
    }
    result
}

/** Re-parses verified core modules incrementally until every needed callee function body is present, and drains generic monomorphizations. */
resolveCoreModules := fn(target: String, initialGraph: frontend.Items, builtinSpecs: List<String>): frontend.Items {
    var graph := initialGraph;
    mut allMonoItems: frontend.Items = [];
    initMono := frontend.drainGenericInstances(target);
    loop initMono as mi { mut allMonoItems.pushBack(mi); }

    mut metaPaths: List<String> = [];
    mut metaKeys: List<String> = [];
    mut metaDisplays: List<String> = [];
    mut metaIdentities: List<String> = [];
    mut metaSources: List<String> = [];
    var metaCount := 0;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_CORE_MODULE_META {
            mut metaPaths.pushBack(item.name);
            mut metaKeys.pushBack(item.runtime);
            mut metaDisplays.pushBack(item.code);
            mut metaIdentities.pushBack(item.textValue);
            metaCount = metaCount + 1;
        } else if item.kind == frontend.ITEM_KIND_CORE_MODULE_SOURCE {
            mut metaSources.pushBack(item.code);
        }
    }
    if metaCount == 0 { return spliceGenericItems(graph, allMonoItems); }

    mut compiledFns: Set<String>;
    addCompiledFnsSet(graph, mut compiledFns);
    mut reachableTokens: Set<String>;
    scanTopLevelTokens(graph, mut reachableTokens);
    addCompiledFnsSet(allMonoItems, mut compiledFns);
    loop allMonoItems as mi {
        if mi.kind =!= frontend.ITEM_KIND_MONO_OWNER { scanItemTokens(mi, mut reachableTokens); }
    }
    mut scannedTokens: Set<String>;
    closeReachableTokens(graph, mut reachableTokens, mut scannedTokens);
    var coreGraph := collectCoreGraphSlice(graph, metaPaths);
    var unscannedNonCore := collectUnscannedNonCoreFns(graph, metaPaths, scannedTokens);
    loop true {
        reachable := frontend.flattenTokenBuckets(reachableTokens);
        var anyReparsed := false;
        var index := 0;
        loop index < metaCount {
            modPath := metaPaths[index];
            modKey := metaKeys[index];
            if coreModuleNeedsReparse(target, modKey, reachable, compiledFns) {
                importedExports := appendTransitiveTypeOps(graph, coreModuleExports(graph, modPath), modPath);
                beforeCount := compiledFns.size();
                reparsed := frontend.parseProgramWithModuleSelectiveSpecs(=target, source = metaSources[index],
                prefix = metaDisplays[index], exports = importedExports, moduleKey = modKey,
                moduleIdentity = metaIdentities[index], neededFns = reachable,
                skipSoftBuiltins = target == frontend.TARGET_TS, =builtinSpecs);
                graph = replaceModuleItems(graph, modPath, reparsed);
                coreGraph = replaceModuleItems(coreGraph, modPath, reparsed);
                addCompiledFnsSet(reparsed, mut compiledFns);
                scanTopLevelTokens(reparsed, mut reachableTokens);
                if compiledFns.size() > beforeCount { anyReparsed = true; }
            }
            index = index + 1;
        }
        moreMono := frontend.drainGenericInstances(target);
        if moreMono.length() > 0 {
            addCompiledFnsSet(moreMono, mut compiledFns);
            loop moreMono as mi {
                mut allMonoItems.pushBack(mi);
                if mi.kind =!= frontend.ITEM_KIND_MONO_OWNER { scanItemTokens(mi, mut reachableTokens); }
            }
            anyReparsed = true;
        }
        if not anyReparsed { break; }
        closeReachableTokens(coreGraph, mut reachableTokens, mut scannedTokens);
        if hasNewlyReachableToken(unscannedNonCore, reachableTokens, scannedTokens) {
            closeReachableTokens(graph, mut reachableTokens, mut scannedTokens);
            unscannedNonCore = collectUnscannedNonCoreFns(graph, metaPaths, scannedTokens);
        }
    }
    stripCoreMeta(spliceGenericItems(graph, allMonoItems))
}

/** Records missing `ImportEdge` and `ModuleLoaded` trace records for already-visited core owner modules when imported by a traced module. */
recordTransitiveCoreTraces := fn(
target: String, initialGraph: frontend.Items, modPath: String, projectRoot: String, cwd: String, seen: mut Set<String>
): frontend.Items {
    if seen.has(modPath) { return initialGraph; }
    mut seen.add(modPath);
    var src := "";
    var foundSrc := false;
    loop initialGraph as item {
        if item.kind == frontend.ITEM_KIND_CORE_MODULE_SOURCE and item.name == modPath {
            src = item.code;
            foundSrc = true;
            break;
        }
    }
    if not foundSrc { return initialGraph; }
    var mut graph: frontend.Items = initialGraph;
    clauses := frontend.collectImportClauses(target, src, modPath);
    loop clauses as clause {
        loaded := hostFs.readImportedSource(importerPath = modPath, importerDisplay = modPath, spec = clause.textValue,
        =projectRoot, =cwd);
        if not importEdgeRecorded(graph, modPath, clause.textValue, loaded.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_IMPORT_EDGE, name = modPath, runtime = loaded.path,
            code = clause.textValue, intValue = 0, textValue = ""));
        }
        if not moduleLoadRecorded(graph, loaded.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_LOADED, name = loaded.path, runtime = "",
            code = "", intValue = 0, textValue = ""));
        }
        graph = self(=target, initialGraph = graph, modPath = loaded.path, =projectRoot, =cwd, seen = mut seen);
    }
    graph
};

/** True if `path` already has a `ModuleLoaded` trace record in `graph`. */
moduleLoadRecorded := fn(graph: frontend.Items, path: String): Bool {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_LOADED and item.name == path { return true; }
    }
    false
}

/** True if `(importer, spec, targetPath)` already has an `ImportEdge` trace record in `graph`. */
importEdgeRecorded := fn(graph: frontend.Items, importer: String, spec: String, targetPath: String): Bool {
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_IMPORT_EDGE and item.name == importer and item.code == spec and item.runtime == targetPath {
            return true;
        }
    }
    false
}

/** Reads and parses each canonical source once, recursing into dependencies in canonical `(logical, path)` order and recording topological levels. */
pub visitSourceModule := fn(target: String, path: String, display: String, identity: String, source: String,
initialGraph: frontend.Items, projectRoot: String, cwd: String, builtinSpecs: List<String>): frontend.Items {
    if moduleVisited(initialGraph, path) { return initialGraph; }
    var hasVisited := false;
    loop initialGraph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_VISITED {
            hasVisited = true;
            break;
        }
    }
    isRoot := not hasVisited;
    if isRoot { frontend.resetTypeStates(); generics.resetAll(); interfaces.resetAll(); contexts.resetAll(); overloads.resetAll(); comptimeEval.resetComptimeState(); }
    normPath := normalizeSlashes(path);
    rootDir := if isRoot { dirnameOfPath(normPath) } else { rootDirForGraph(initialGraph) };
    logical := logicalModuleName(rootDir, path, display);
    moduleKey := if isRoot { "" } else { uniqueModuleKey(initialGraph, target, encodeModuleSlug(target, logical)) };
    var mut graph: frontend.Items = initialGraph;
    mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_VISITED, name = path, runtime = rootDir, code = logical,
    intValue = if isRoot { 1 } else { 0 }, textValue = moduleKey));

    if isRoot and projectRoot =!= "" {
        hasLegacyCoreSlice := hostFs.tryReadCoreOwner(projectRoot, "lib/core/slice.lt").ok;
        coreOwnerRels: List<String> = if hasLegacyCoreSlice {
            ["lib/core/int.lt", "lib/core/text.lt", "lib/core/list.lt", "lib/core/array.lt", "lib/core/map.lt", "lib/core/set.lt", "lib/core/rc.lt", "lib/core/slice.lt", "lib/core/simd.lt", "lib/core/soa.lt"]
        } else {
            ["lib/type/int.lt", "lib/type/float.lt", "lib/type/bool.lt", "lib/type/string.lt", "lib/type/list.lt", "lib/type/array.lt", "lib/type/map.lt", "lib/type/set.lt", "lib/type/rc.lt", "lib/type/slice.lt", "lib/type/simd.lt", "lib/type/soa.lt"]
        };
        loop coreOwnerRels as ownerRel {
            loadedOwner := hostFs.tryReadCoreOwner(projectRoot, ownerRel);
            if loadedOwner.ok and not moduleVisited(graph, loadedOwner.path) {
                graph = self(=target, path = loadedOwner.path, display = loadedOwner.display,
                identity = loadedOwner.identity, source = loadedOwner.text, initialGraph = graph,
                =projectRoot, =cwd, =builtinSpecs);
            }
        }
    }

    pkgCtxMod := if not frontend.isHostModuleIdentity(identity) {
        hostFs.findPackageContext(path, rootDir, projectRoot)
    } else {
        (found = false, path = "", display = "", identity = "", text = "")
    };
    if pkgCtxMod.found and pkgCtxMod.path =!= path {
        if not importEdgeRecorded(graph, path, "$context", pkgCtxMod.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_IMPORT_EDGE, name = path, runtime = pkgCtxMod.path,
            code = "$context", intValue = 0, textValue = ""));
        }
        if not moduleLoadRecorded(graph, pkgCtxMod.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_LOADED, name = pkgCtxMod.path, runtime = "",
            code = "", intValue = 0, textValue = ""));
        }
        if not moduleVisited(graph, pkgCtxMod.path) {
            graph = self(=target, path = pkgCtxMod.path, display = pkgCtxMod.display, identity = pkgCtxMod.identity,
            source = pkgCtxMod.text, initialGraph = graph, =projectRoot, =cwd, =builtinSpecs);
        }
    }

    skipPreload := frontend.isHostModuleIdentity(identity) or normPath.endsWith("/$preload.lt") or normPath.contains("/lib/core/") or display.startsWithAt(0, "lib/core/") or normPath.contains("/lib/type/") or display.startsWithAt(0, "lib/type/");
    pkgPreloadMod := if not skipPreload {
        hostFs.findPackagePreload(path, rootDir, projectRoot)
    } else {
        (found = false, path = "", display = "", identity = "", text = "")
    };
    if pkgPreloadMod.found and pkgPreloadMod.path =!= path {
        if not importEdgeRecorded(graph, path, "$preload", pkgPreloadMod.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_IMPORT_EDGE, name = path, runtime = pkgPreloadMod.path,
            code = "$preload", intValue = 0, textValue = ""));
        }
        if not moduleLoadRecorded(graph, pkgPreloadMod.path) {
            mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_LOADED, name = pkgPreloadMod.path, runtime = "",
            code = "", intValue = 0, textValue = ""));
        }
        if not moduleVisited(graph, pkgPreloadMod.path) {
            graph = self(=target, path = pkgPreloadMod.path, display = pkgPreloadMod.display, identity = pkgPreloadMod.identity,
            source = pkgPreloadMod.text, initialGraph = graph, =projectRoot, =cwd, =builtinSpecs);
        }
    }

    traceActive := isRoot or moduleLoadRecorded(graph, path);
    clauses := frontend.collectImportClauses(target, source, path);
    mut clausePaths: List<String> = [];
    mut depPaths: List<String> = [];
    mut depDisplays: List<String> = [];
    mut depIdentities: List<String> = [];
    mut depTexts: List<String> = [];
    mut depLogicals: List<String> = [];
    var depCount := 0;
    mut depPathSet: Set<String>;
    loop clauses as clause {
        loaded := hostFs.readImportedSource(importerPath = path, importerDisplay = display, spec = clause.textValue,
        =projectRoot, =cwd);
        if traceActive {
            if not importEdgeRecorded(graph, path, clause.textValue, loaded.path) {
                mut graph.pushBack((kind = frontend.ITEM_KIND_IMPORT_EDGE, name = path, runtime = loaded.path,
                code = clause.textValue, intValue = 0, textValue = ""));
            }
            if not moduleLoadRecorded(graph, loaded.path) {
                mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_LOADED, name = loaded.path, runtime = "",
                code = "", intValue = 0, textValue = ""));
            }
            if moduleVisited(graph, loaded.path) {
                mut coreSeen: Set<String>;
                graph = recordTransitiveCoreTraces(=target, initialGraph = graph, modPath = loaded.path, =projectRoot, =cwd, seen = mut coreSeen);
            }
        }
        (mut clausePaths).pushBack(loaded.path);
        if not depPathSet.has(loaded.path) {
            mut depPathSet.add(loaded.path);
            mut depPaths.pushBack(loaded.path);
            mut depDisplays.pushBack(loaded.display);
            mut depIdentities.pushBack(loaded.identity);
            mut depTexts.pushBack(loaded.text);
            mut depLogicals.pushBack(logicalModuleName(rootDir, loaded.path, loaded.display));
            depCount = depCount + 1;
        }
    }

    sortedOrder := sortedDepIndices(depLogicals, depPaths, depCount);
    loop sortedOrder as depIdx {
        depPath := depPaths[depIdx];
        if not moduleVisited(graph, depPath) {
            graph = self(=target, path = depPath, display = depDisplays[depIdx], identity = depIdentities[depIdx],
            source = depTexts[depIdx], initialGraph = graph, =projectRoot, =cwd, =builtinSpecs);
        }
    }

    var maxChildLevel := -1;
    loop sortedOrder as depIdx {
        depPath := depPaths[depIdx];
        if moduleProcessed(graph, depPath) {
            childLevel := moduleLevelForPath(graph, depPath);
            if childLevel > maxChildLevel { maxChildLevel = childLevel; }
        }
    }
    if pkgCtxMod.found and pkgCtxMod.path =!= path and moduleProcessed(graph, pkgCtxMod.path) {
        ctxChildLevel := moduleLevelForPath(graph, pkgCtxMod.path);
        if ctxChildLevel > maxChildLevel { maxChildLevel = ctxChildLevel; }
    }
    if pkgPreloadMod.found and pkgPreloadMod.path =!= path and moduleProcessed(graph, pkgPreloadMod.path) {
        preChildLevel := moduleLevelForPath(graph, pkgPreloadMod.path);
        if preChildLevel > maxChildLevel { maxChildLevel = preChildLevel; }
    }
    if isRoot {
        loop graph as pItem {
            if pItem.kind == frontend.ITEM_KIND_MODULE_PROCESSED and pItem.intValue > maxChildLevel {
                maxChildLevel = pItem.intValue;
            }
        }
    }
    level := maxChildLevel + 1;

    var mut importedExports: frontend.Items = [];
    var clauseIndex := 0;
    loop clauses as clause {
        depPath := clausePaths[clauseIndex];
        if moduleProcessed(graph, depPath) {
            incomingClauseExports := if clause.code == "unpack" or clause.code == "pub_unpack" {
                modulePublicDeclarations(graph, depPath)
            } else if clause.code == "destruct" or clause.code == "pub_destruct" {
                moduleDestructuredExports(graph, depPath, clause.name, clause.textValue, path)
            } else {
                moduleAliasExports(graph, depPath, clause.name)
            };
            importedExports = appendModuleExports(importedExports, incomingClauseExports, path);
        } else if clause.code =!= "unpack" and clause.code =!= "pub_unpack" and clause.code =!= "destruct" and clause.code =!= "pub_destruct" {
            cyclicFamily := coreCycleFamilyExports(depPath, clause.name);
            if cyclicFamily.length() > 0 {
                importedExports = appendModuleExports(importedExports, cyclicFamily, path);
            }
        }
        clauseIndex = clauseIndex + 1;
    }
    if pkgPreloadMod.found and pkgPreloadMod.path =!= path {
        importedExports = appendPreloadExports(graph, pkgPreloadMod.path, importedExports, path);
    }
    importedExports = appendTransitiveTypeOps(graph, importedExports, path);
    if pkgCtxMod.found and pkgCtxMod.path =!= path and moduleProcessed(graph, pkgCtxMod.path) {
        var inCtxMod := false;
        loop graph as gItem {
            if gItem.kind == frontend.ITEM_KIND_MODULE_START {
                inCtxMod = gItem.name == pkgCtxMod.path;
            } else if gItem.kind == frontend.ITEM_KIND_MODULE_END and inCtxMod {
                break;
            } else if inCtxMod and gItem.kind == frontend.ITEM_KIND_PUBLIC_CONTEXT {
                mut importedExports.pushBack(gItem);
            }
        }
    }

    isCoreMod := not isRoot and frontend.isHostModuleIdentity(identity);
    localItems := if isCoreMod {
        frontend.parseProgramWithModuleSelectiveSpecs(=target, =source, prefix = display, exports = importedExports,
        =moduleKey, moduleIdentity = identity, neededFns = "|", skipSoftBuiltins = target == frontend.TARGET_TS, =builtinSpecs)
    } else {
        frontend.parseProgramWithModule(=target, =source, prefix = display, exports = importedExports,
        =moduleKey, moduleIdentity = identity)
    };
    mut graph.pushBack((kind = frontend.ITEM_KIND_MODULE_START, name = path, runtime = moduleKey, code = logical,
    intValue = level, textValue = display));
    loop localItems as item { mut graph.pushBack(item); }
    (mut graph).pushBack((kind = frontend.ITEM_KIND_MODULE_END, name = path, runtime = moduleKey, code = logical,
    intValue = level, textValue = ""));
    if isCoreMod {
        mut graph.pushBack((kind = frontend.ITEM_KIND_CORE_MODULE_META, name = path, runtime = moduleKey, code = display,
        intValue = 0, textValue = identity));
        mut graph.pushBack((kind = frontend.ITEM_KIND_CORE_MODULE_SOURCE, name = path, runtime = "", code = source,
        intValue = 0, textValue = ""));
        var importIndex := 0;
        loop clauses as clause {
            mut graph.pushBack((kind = frontend.ITEM_KIND_CORE_MODULE_IMPORT, name = path, runtime = clause.name,
            code = clausePaths[importIndex], intValue = 0, textValue = clause.code));
            importIndex = importIndex + 1;
        }
        if pkgPreloadMod.found and pkgPreloadMod.path =!= path {
            mut graph.pushBack((kind = frontend.ITEM_KIND_CORE_MODULE_IMPORT, name = path, runtime = "",
            code = pkgPreloadMod.path, intValue = 0, textValue = "$preload"));
        }
    }
    (mut graph).pushBack((kind = frontend.ITEM_KIND_MODULE_PROCESSED, name = path, runtime = moduleKey, code = logical,
    intValue = level, textValue = identity));
    if isRoot {
        mut outGraph := resolveCoreModules(target, graph, builtinSpecs);
        loop comptimeEval.getTracedFiles() as ctFile {
            mut outGraph.pushBack((kind = frontend.ITEM_KIND_COMPTIME_DEP, name = ctFile, runtime = "", code = "", intValue = 0, textValue = ""));
        }
        return outGraph;
    }
    graph
}

/** Emits all parsed modules in canonical `(level, logical, path)` topological order, with root last. */
pub moduleItems := fn(graph: frontend.Items): frontend.Items {
    mut startIndices: List<Int> = [];
    mut startLevels: List<Int> = [];
    mut startLogicals: List<String> = [];
    mut startPaths: List<String> = [];
    var moduleCount := 0;
    var index := 0;
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_START {
            mut startIndices.pushBack(index + 1);
            mut startLevels.pushBack(item.intValue);
            mut startLogicals.pushBack(item.code);
            mut startPaths.pushBack(item.name);
            moduleCount = moduleCount + 1;
        }
        index = index + 1;
    }
    order := collections.sortIndicesBy(moduleCount, fn(a: Int, b: Int): Bool {
        if startLevels[a] =!= startLevels[b] {
            startLevels[a] < startLevels[b]
        } else {
            cmpLogical := compareText(startLogicals[a], startLogicals[b]);
            if cmpLogical =!= 0 { cmpLogical < 0 } else { compareText(startPaths[a], startPaths[b]) <= 0 }
        }
    });
    mut result: frontend.Items = [];
    loop order as best {
        var itemIndex := startIndices[best];
        loop true {
            entry := graph[itemIndex];
            if entry.kind == frontend.ITEM_KIND_MODULE_END { break; }
            (mut result).pushBack(entry);
            itemIndex = itemIndex + 1;
        }
    }
    result
}
