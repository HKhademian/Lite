/** Frontend canonical type-kind algebra, type/alias parsing, compatibility checks, TypeScript type formatting, and non-failing header pre-resolution. */

integer := import "core/int";
listLib := import "core/list";
textLib := import "core/text";
numeric := import "./numeric-literals";
tsLiteral := import "./ts-literals";
ir := import "./frontend-ir";
interfaces := import "./interfaces";
contexts := import "./contexts";
sym := import "./symbol-table";
syntax := import "./frontend-syntax";
tb := import "core/text-builder";

/** One transparent type alias matching `frontend-ir.AliasDecl`. */
AliasDecl := alias (name: String, target: String, at: Int, end: Int, depth: Int);

/** Canonical built-in `core/error.Error` record kind used by `T!` and implicit error values. */
pub CORE_ERROR_KIND := "Record<core/error#0#Error;kind:String,message:String,code:Int>";

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
pub isUnsupportedAliasTarget := fn(name: String): Bool {
    name == "List" or name == "Float" or name == "Double" or name == "Array" or
    name == "Option" or name == "Result" or name == "record" or name == "fn"
};

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
pub unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit {
    syntax.failAt(source, position, prefix, "unsupported type alias " + target +
    "; only Int, Float, String, Bool, Unit, List<T>, flat named tuples and aliases are supported");
};

/** Returns the index of the first visible alias named `name` at the innermost active block depth, or -1 when absent. */
pub findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    sym.findAlias(aliases, name)
};

/** Reads one local or module-qualified type name. */
pub typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) {
    firstEnd := source.skipName(position);
    first := source.slice(position, firstEnd);
    afterFirst := syntax.skipTrivia(source, firstEnd, prefix);
    if afterFirst < source.length() and source.at(afterFirst) == "." {
        memberStart := syntax.skipTrivia(source, afterFirst + 1, prefix);
        if memberStart >= source.length() or not source.at(memberStart).isNameStart() {
            syntax.failAt(source, memberStart, prefix, "expected a type name after .");
        }
        memberEnd := source.skipName(memberStart);
        member := source.slice(memberStart, memberEnd);
        return (name = first + "." + member, next = memberEnd);
    }
    (name = first, next = firstEnd)
};

/** Returns the index of the alias declared at `position`, or -1 when absent. */
pub aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int {
    var index := 0;
    loop aliases as aliasItem {
        if aliasItem.at == position { return index; }
        index = index + 1;
    }
    -1
};

/** Returns the highest block depth present in `aliases`, or 0 when `aliases` is empty. */
pub maxAliasDepth := fn(aliases: List<AliasDecl>): Int {
    var highest := 0;
    loop aliases as aliasItem {
        if aliasItem.depth > highest { highest = aliasItem.depth; }
    }
    highest
};

/** Drops aliases declared at block depth `depth` or deeper when exiting a block. */
pub popBlockAliases := fn(aliases: List<AliasDecl>, depth: Int): List<AliasDecl> {
    var firstDrop := -1;
    var idx := 0;
    loop aliases as aliasItem {
        if aliasItem.depth >= depth {
            firstDrop = idx;
            break;
        }
        idx = idx + 1;
    }
    if firstDrop < 0 { return aliases; }
    sym.rewindAliasesTo(firstDrop);
    mut kept: List<AliasDecl> = [];
    loop aliases as aliasItem {
        if aliasItem.depth < depth { mut kept.pushBack(aliasItem); }
    }
    kept
};

/** Filters `aliases` to declarations at or above `maxDepth` for lexical outer-alias expansion. */
pub aliasesUpToDepth := fn(aliases: List<AliasDecl>, maxDepth: Int): List<AliasDecl> {
    var hasDeeper := false;
    loop aliases as aliasItem {
        if aliasItem.depth > maxDepth {
            hasDeeper = true;
            break;
        }
    }
    if not hasDeeper { return aliases; }
    mut kept: List<AliasDecl> = [];
    loop aliases as aliasItem {
        if aliasItem.depth <= maxDepth { mut kept.pushBack(aliasItem); }
    }
    kept
};

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool {
    kind.length() > 0 and kind.at(0) == "("
};

/** Returns the runtime JS property name for a tuple field (`_0` when unnamed, otherwise the field label). */
pub tupleRuntimeProp := fn(label: String, index: Int): String {
    if label == "" { "_" + index.toText() } else { label }
};

/** Returns the JS/TS object-literal property key for a tuple field, quoting `__proto__` to avoid prototype mutation. */
pub tupleObjectKey := fn(label: String, index: Int): String {
    if label == "" { "_" + index.toText() }
    else if label == "__proto__" { "[\"__proto__\"]" }
    else { label }
};

/** Advances past one canonical type-kind token starting at `start` (scalar, `List<...>`, `[T;N]`, tuple, or `fn(...)`). */
pub skipKindToken := fn(kind: String, start: Int): Int {
    size := kind.length();
    if start >= size { return start; }
    if kind.startsWithAt(start, "mut ") {
        return self(kind, start + 4);
    }
    if kind.startsWithAt(start, "fn(") {
        var cursor := start + 2;
        var depth := 0;
        loop cursor < size {
            ch := kind.at(cursor);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == ">" {
                depth = depth - 1;
                if depth == 0 { cursor = cursor + 1; break; }
            }
            cursor = cursor + 1;
        }
        if kind.startsWithAt(cursor, "@ctx(") {
            var cCur := cursor + 4;
            var cDepth := 0;
            loop cCur < size {
                cCh := kind.at(cCur);
                if cCh == "(" or cCh == "[" or cCh == "<" { cDepth = cDepth + 1; }
                else if cCh == ")" or cCh == "]" or cCh == ">" {
                    cDepth = cDepth - 1;
                    if cDepth == 0 { cursor = cCur + 1; break; }
                }
                cCur = cCur + 1;
            }
        }
        if cursor < size and kind.at(cursor) == ":" {
            return self(kind, cursor + 1);
        }
        return cursor;
    }
    first := kind.at(start);
    if first == "(" or first == "[" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := kind.at(cursor);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == ">" {
                depth = depth - 1;
                if depth == 0 { return cursor + 1; }
            }
            cursor = cursor + 1;
        }
        return cursor;
    }
    var cursor := kind.skipName(start);
    if cursor < size and kind.at(cursor) == "<" {
        var depth := 0;
        loop cursor < size {
            ch := kind.at(cursor);
            if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
            else if ch == ">" or ch == ")" or ch == "]" {
                depth = depth - 1;
                if depth == 0 { return cursor + 1; }
            }
            cursor = cursor + 1;
        }
    }
    cursor
};

/** True when `kind` is a canonical context projection `Ctx<...>`. */
pub isCtxKind := fn(kind: String): Bool {
    contexts.isCtxKind(kind)
};

/** Maps a canonical `Ctx<...>` kind to its C11 projection struct typedef `lt_ctx_<hash>`. */
pub cCtxTag := fn(kind: String): String {
    if not isCtxKind(kind) { return ""; }
    "lt_ctx_" + cStructHash(kind)
};

/** Builds canonical `@ctx(...)` suffix from `Ctx<...>` for embedding in `fn` kinds. */
fnAtCtxSuffix := fn(ctxKind: String): String {
    if isCtxKind(ctxKind) { "@ctx(" + ctxKind.slice(4, ctxKind.length() - 1) + ")" } else { "" }
};

/** Returns the index of the closing `)` matching the parameter tuple in `fn(...)` or `fn(...)@ctx(...):Ret`, or -1 when `kind` is not canonical. */
fnCloseParenIndex := fn(kind: String): Int {
    if not kind.startsWithAt(0, "fn(") { return -1; }
    size := kind.length();
    var cursor := 2;
    var depth := 0;
    loop cursor < size {
        ch := kind.at(cursor);
        if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
        else if ch == ")" or ch == "]" or ch == ">" {
            depth = depth - 1;
            if depth == 0 {
                if cursor + 1 < size and kind.at(cursor + 1) == ":" { return cursor; }
                if kind.startsWithAt(cursor + 1, "@ctx(") {
                    var cCur := cursor + 5;
                    var cDepth := 0;
                    loop cCur < size {
                        cCh := kind.at(cCur);
                        if cCh == "(" or cCh == "[" or cCh == "<" { cDepth = cDepth + 1; }
                        else if cCh == ")" or cCh == "]" or cCh == ">" {
                            cDepth = cDepth - 1;
                            if cDepth == 0 {
                                if cCur + 1 < size and kind.at(cCur + 1) == ":" { return cursor; }
                                return -1;
                            }
                        }
                        cCur = cCur + 1;
                    }
                }
                return -1;
            }
        }
        cursor = cursor + 1;
    }
    -1
};

/** Returns the `:` index before the return kind in canonical `fn(...)[:Ret]` or `fn(...)@ctx(...):Ret`, or -1. */
fnColonIndex := fn(kind: String): Int {
    close := fnCloseParenIndex(kind);
    if close < 2 { return -1; }
    if close + 1 < kind.length() and kind.at(close + 1) == ":" { return close + 1; }
    if kind.startsWithAt(close + 1, "@ctx(") {
        size := kind.length();
        var cur := close + 5;
        var depth := 0;
        loop cur < size {
            ch := kind.at(cur);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == ">" {
                depth = depth - 1;
                if depth == 0 {
                    if cur + 1 < size and kind.at(cur + 1) == ":" { return cur + 1; }
                    return -1;
                }
            }
            cur = cur + 1;
        }
    }
    -1
};

/** Returns canonical `Ctx<...>` requirement of a callable kind, or `""` when none. */
pub fnContextKind := fn(kind: String): String {
    close := fnCloseParenIndex(kind);
    colon := fnColonIndex(kind);
    if close >= 2 and colon > close + 6 and kind.startsWithAt(close + 1, "@ctx(") {
        return "Ctx<" + kind.slice(close + 6, colon - 1) + ">";
    }
    ""
};

/** True when `kind` is a canonical callable kind `fn(...)[@ctx(...)]:ResultKind`. */
pub isFnKind := fn(kind: String): Bool {
    fnCloseParenIndex(kind) >= 2
};

/** Returns the canonical return kind from `fn(...)[@ctx(...)]:ResultKind`. */
pub fnResultKind := fn(kind: String): String {
    colon := fnColonIndex(kind);
    if colon < 0 { return ""; }
    kind.slice(colon + 1, kind.length())
};

/** Parses `label[?]:Kind` components inside a parameter list `fn(...)`; returns parameter count. */
pub fnParamCount := fn(kind: String): Int {
    close := fnCloseParenIndex(kind);
    if close <= 3 { return 0; }
    var cursor := 3;
    var count := 0;
    loop cursor < close {
        if kind.at(cursor) =!= ":" and kind.at(cursor) =!= "?" { cursor = kind.skipName(cursor); }
        if cursor < close and kind.at(cursor) == "?" { cursor = cursor + 1; }
        if cursor < close and kind.at(cursor) == ":" { cursor = cursor + 1; }
        cursor = skipKindToken(kind, cursor);
        count = count + 1;
        if cursor < close and kind.at(cursor) == "," { cursor = cursor + 1; }
    }
    count
};

/** Returns `(label, kind)` for parameter `targetIndex` of a canonical `fn(...):Ret` kind. */
pub fnParamComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String) {
    close := fnCloseParenIndex(kind);
    if close <= 3 { return (label = "", kind = ""); }
    var cursor := 3;
    var index := 0;
    loop cursor < close {
        var label := "";
        if kind.at(cursor) =!= ":" and kind.at(cursor) =!= "?" {
            nameStart := cursor;
            cursor = kind.skipName(cursor);
            label = kind.slice(nameStart, cursor);
        }
        if cursor < close and kind.at(cursor) == "?" { cursor = cursor + 1; }
        if cursor < close and kind.at(cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        if index == targetIndex {
            return (label = label, kind = kind.slice(typeStart, cursor));
        }
        index = index + 1;
        if cursor < close and kind.at(cursor) == "," { cursor = cursor + 1; }
    }
    (label = "", kind = "")
};

/** True when parameter `targetIndex` of canonical `fn(...):Ret` kind is omittable (`n?:T` or `?:T`). */
pub fnParamIsOptional := fn(kind: String, targetIndex: Int): Bool {
    close := fnCloseParenIndex(kind);
    if close <= 3 or targetIndex < 0 { return false; }
    var cursor := 3;
    var index := 0;
    loop cursor < close {
        if kind.at(cursor) =!= ":" and kind.at(cursor) =!= "?" {
            cursor = kind.skipName(cursor);
        }
        var isOpt := false;
        if cursor < close and kind.at(cursor) == "?" {
            isOpt = true;
            cursor = cursor + 1;
        }
        if cursor < close and kind.at(cursor) == ":" { cursor = cursor + 1; }
        cursor = skipKindToken(kind, cursor);
        if index == targetIndex { return isOpt; }
        index = index + 1;
        if cursor < close and kind.at(cursor) == "," { cursor = cursor + 1; }
    }
    false
};

/** True when any parameter of canonical `fn(...):Ret` kind is omittable. */
pub fnHasOptionalParams := fn(kind: String): Bool {
    n := fnParamCount(kind);
    var i := 0;
    loop i < n {
        if fnParamIsOptional(kind, i) { return true; }
        i = i + 1;
    }
    false
};

/** Converts a canonical `fn(...):Ret` kind into `name[?]=kind` parameter entries compatible with call routing. */
pub fnParamEntries := fn(kind: String): List<String> {
    mut entries: List<String> = [];
    close := fnCloseParenIndex(kind);
    if close <= 3 { return entries; }
    var cursor := 3;
    loop cursor < close {
        var label := "";
        if kind.at(cursor) =!= ":" and kind.at(cursor) =!= "?" {
            nameStart := cursor;
            cursor = kind.skipName(cursor);
            label = kind.slice(nameStart, cursor);
        }
        var optSuffix := "";
        if cursor < close and kind.at(cursor) == "?" {
            optSuffix = "?";
            cursor = cursor + 1;
        }
        if cursor < close and kind.at(cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        mut entries.pushBack(label + optSuffix + "=" + kind.slice(typeStart, cursor));
        if cursor < close and kind.at(cursor) == "," { cursor = cursor + 1; }
    }
    entries
};

/** Removes parameter labels (preserving `?` omission markers) from a canonical `fn` kind when joining differently labeled callable branches. */
pub fnStripLabels := fn(kind: String): String {
    if not isFnKind(kind) { return kind; }
    count := fnParamCount(kind);
    mut out: tb.TextBuilder;
    mut out.append("fn(");
    var idx := 0;
    loop idx < count {
        if idx > 0 { mut out.append(","); }
        comp := fnParamComponent(kind, idx);
        if fnParamIsOptional(kind, idx) { mut out.append("?"); }
        mut out.append(":");
        mut out.append(if isFnKind(comp.kind) { self(comp.kind) } else { comp.kind });
        idx = idx + 1;
    }
    mut out.append(")");
    ctxK := fnContextKind(kind);
    if ctxK =!= "" {
        mut strippedSlots: List<contexts.CtxSlot> = [];
        loop contexts.parseCtxKindSlots(ctxK) as cs {
            sk := if isFnKind(cs.kind) { self(cs.kind) } else { cs.kind };
            mut strippedSlots.pushBack(contexts.CtxSlot { name = cs.name, isMut = cs.isMut, kind = sk });
        }
        mut out.append(fnAtCtxSuffix(contexts.buildCanonicalCtxKind(strippedSlots)));
    }
    res := fnResultKind(kind);
    mut out.append(":");
    mut out.append(if isFnKind(res) { self(res) } else { res });
    out.build()
};

/* Cached parsed component lists for tuple and nominal record kinds. */
ComponentInfo := record { label: String; kind: String; prop: String; };
mut componentsCache: Map<String, List<ComponentInfo>>;

/** Parses and caches all components of a canonical flat tuple kind `(...)`. */
cachedTupleComponents := fn(kind: String): List<ComponentInfo> {
    cached := componentsCache.get(kind);
    if cached.found { return cached.value; }
    mut out: List<ComponentInfo> = [];
    if isTupleKind(kind) {
        size := kind.length();
        var cursor := 1;
        var index := 0;
        loop cursor < size and kind.at(cursor) =!= ")" {
            var label := "";
            if kind.at(cursor) =!= ":" {
                nameStart := cursor;
                cursor = kind.skipName(cursor);
                label = kind.slice(nameStart, cursor);
            }
            if cursor < size and kind.at(cursor) == ":" { cursor = cursor + 1; }
            typeStart := cursor;
            cursor = skipKindToken(kind, cursor);
            fieldKind := kind.slice(typeStart, cursor);
            mut out.pushBack(ComponentInfo { label = label, kind = fieldKind, prop = tupleRuntimeProp(label, index) });
            index = index + 1;
            if cursor < size and kind.at(cursor) == "," { cursor = cursor + 1; }
        }
    }
    (mut componentsCache).set(kind, out);
    out
};

/** Returns the number of components in one canonical flat tuple kind. */
pub tupleComponentCount := fn(kind: String): Int {
    if not isTupleKind(kind) { return 0; }
    cachedTupleComponents(kind).length()
};

/** Returns the label, scalar kind and runtime property name of component `targetIndex` in a canonical tuple kind. */
pub tupleComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) {
    comps := cachedTupleComponents(kind);
    if targetIndex < 0 or targetIndex >= comps.length() {
        return (label = "", kind = "", prop = "");
    }
    c := comps[targetIndex];
    (label = c.label, kind = c.kind, prop = c.prop)
};

/** Returns the 0-based index of the component with `label` inside canonical flat tuple `kind`, or -1 when absent. */
pub tupleComponentIndexByLabel := fn(kind: String, label: String): Int {
    if label == "" or not isTupleKind(kind) { return -1; }
    comps := cachedTupleComponents(kind);
    n := comps.length();
    var index := 0;
    loop index < n {
        if comps[index].label == label { return index; }
        index = index + 1;
    }
    -1
};

/** Converts one tuple expression to `expectedKind` by copying positional components into the receiving labels. */
pub convertTupleValue := fn(expectedKind: String, actualKind: String, actualCode: String): String {
    count := tupleComponentCount(expectedKind);
    mut fieldsBuf: tb.TextBuilder;
    var index := 0;
    loop index < count {
        expectedComp := tupleComponent(expectedKind, index);
        actualComp := tupleComponent(actualKind, index);
        if index > 0 { mut fieldsBuf.append(", "); }
        mut fieldsBuf.append(tupleObjectKey(expectedComp.label, index));
        mut fieldsBuf.append(": lite$t.");
        mut fieldsBuf.append(actualComp.prop);
        index = index + 1;
    }
    "(() => { const lite$t = " + actualCode + "; return { " + fieldsBuf.build() + " }; })()"
};

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
pub isListKind := fn(kind: String): Bool {
    kind.length() > 5 and kind.startsWithAt(0, "List<") and kind.at(kind.length() - 1) == ">"
};

/** Returns the canonical element kind from `List<ElementKind>`. */
pub listElementKind := fn(kind: String): String {
    if not isListKind(kind) { return ""; }
    kind.slice(5, kind.length() - 1)
};

/** Finds the top-level `;` inside `[ElementKind;Extent]`, or -1 when `kind` is not a canonical fixed-array kind. */
arraySemiIndex := fn(kind: String): Int {
    size := kind.length();
    if size < 5 or kind.at(0) =!= "[" or kind.at(size - 1) =!= "]" { return -1; }
    var cursor := 1;
    var depth := 0;
    loop cursor < size - 1 {
        ch := kind.at(cursor);
        if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
        else if ch == ")" or ch == "]" or ch == ">" { depth = depth - 1; }
        else if ch == ";" and depth == 0 { return cursor; }
        cursor = cursor + 1;
    }
    -1
};

/** True when `kind` is this compiler's canonical fixed-array kind, written `[ElementKind;Extent]`. */
pub isArrayKind := fn(kind: String): Bool {
    arraySemiIndex(kind) > 1
};

/** Returns the canonical element kind from `[ElementKind;Extent]`. */
pub arrayElementKind := fn(kind: String): String {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return ""; }
    kind.slice(1, semi)
};

/** Returns the raw extent token from `[ElementKind;Extent]` (`"4"`, `"*"`, or symbolic `"N"`). */
pub arrayExtentText := fn(kind: String): String {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return ""; }
    kind.slice(semi + 1, kind.length() - 1)
};

/** Returns the integer extent from `[ElementKind;Extent]`, -1 for wildcard `[ElementKind;*]`, or -2 for symbolic comptime extent. */
pub arrayExtent := fn(kind: String): Int {
    extText := arrayExtentText(kind);
    if extText == "" { return 0; }
    if extText == "*" { return -1; }
    var i := 0;
    loop i < extText.length() {
        if not extText.at(i).isDigit() { return -2; }
        i = i + 1;
    }
    syntax.parseDigits(extText, 0, extText.length())
};

/** True when `kind` is this compiler's canonical map kind `Map<K,V>`. */
pub isMapKind := fn(kind: String): Bool {
    size := kind.length();
    size > 6 and kind.startsWithAt(0, "Map<") and kind.at(size - 1) == ">"
};

/** Finds the top-level comma separating `K` and `V` inside canonical `Map<K,V>`, or -1 when malformed. */
mapCommaPos := fn(kind: String): Int {
    if not isMapKind(kind) { return -1; }
    end := kind.length() - 1;
    keyEnd := skipKindToken(kind, 4);
    if keyEnd < end and kind.at(keyEnd) == "," { keyEnd } else { -1 }
};

/** Returns the key kind `K` of canonical `Map<K,V>`. */
pub mapKeyKind := fn(kind: String): String {
    comma := mapCommaPos(kind);
    if comma < 0 { "" } else { kind.slice(4, comma) }
};

/** Returns the value kind `V` of canonical `Map<K,V>`. */
pub mapValueKind := fn(kind: String): String {
    comma := mapCommaPos(kind);
    if comma < 0 { "" } else { kind.slice(comma + 1, kind.length() - 1) }
};

/** Index of the first `<` separating base identity from generic type arguments in a nominal header, or `hdr.length()`. */
headerBaseEnd := fn(hdr: String): Int {
    lt := hdr.indexOf("<", 0);
    if lt >= 0 { lt } else { hdr.length() }
};

/** Splits comma-separated canonical type kinds at top level using `skipKindToken`. */
splitTopLevelKinds := fn(csv: String): List<String> {
    mut out: List<String> = [];
    size := csv.length();
    var cursor := 0;
    loop cursor < size {
        end := skipKindToken(csv, cursor);
        if end <= cursor { break; }
        mut out.pushBack(csv.slice(cursor, end));
        cursor = end;
        if cursor < size and csv.at(cursor) == "," {
            cursor = cursor + 1;
        } else {
            break;
        }
    }
    out
};

/** Extracts canonical type arguments from a nominal identity header `mod#at#Name<A,B>`, or `[]`. */
headerTypeArgs := fn(hdr: String): List<String> {
    size := hdr.length();
    lt := headerBaseEnd(hdr);
    if lt >= size - 1 or hdr.at(size - 1) =!= ">" {
        empty: List<String> = [];
        return empty;
    }
    splitTopLevelKinds(hdr.slice(lt + 1, size - 1))
};

/** Formats a nominal identity header `mod#at#Name[~attrs][<A,B>]` into `Name[<A, B>]`. */
headerDisplayName := fn(hdr: String): String {
    baseEnd := headerBaseEnd(hdr);
    tilde := hdr.indexOf("~", 0);
    nameEnd := if tilde >= 0 and tilde < baseEnd { tilde } else { baseEnd };
    base := hdr.slice(0, nameEnd);
    var hashPos := nameEnd - 1;
    loop hashPos >= 0 and base.at(hashPos) =!= "#" {
        hashPos = hashPos - 1;
    }
    shortName := if hashPos >= 0 { base.slice(hashPos + 1, nameEnd) } else { base };
    args := headerTypeArgs(hdr);
    if args.length() == 0 { return shortName; }
    mut dispArgs: List<String> = [];
    loop args as a {
        mut dispArgs.pushBack(displayKind(a));
    }
    shortName + "<" + dispArgs.join(", ") + ">"
};

isPowerOfTwoAlign := fn(n: Int): Bool {
    if n < 1 or n > 4096 { return false; }
    var p := 1;
    loop p < n {
        p = p * 2;
    }
    p == n
};

/** Returns the builtin generic family (`Rc`, `Slice`, `Simd`, `SimdNative`, `SoA`) if `name` resolves via an imported or preloaded `$BuiltinFamily:` alias, else `""`. */
pub builtinFamilyFromAlias := fn(aliases: List<AliasDecl>, name: String): String {
    var cur := name;
    var steps := 0;
    loop steps < 8 {
        dotPos := cur.indexOf(".", 0);
        if dotPos > 0 {
            head := cur.slice(0, dotPos);
            tail := cur.slice(dotPos + 1, cur.length());
            modIdx := findAlias(aliases, "$modalias:" + head);
            if modIdx >= 0 {
                cur = aliases[modIdx].target + "." + tail;
            }
        }
        idx := findAlias(aliases, cur);
        if idx < 0 { return ""; }
        t := aliases[idx].target;
        if t.startsWithAt(0, "$BuiltinFamily:") {
            return t.slice(15, t.length());
        }
        if t == "" or t.startsWithAt(0, "$") or t.startsWithAt(0, "@") or not t.at(0).isNameStart() {
            return "";
        }
        cur = t;
        steps = steps + 1;
    }
    ""
};

/** Reports that a builtin generic family requires importing its owning `core/` module. */
pub failMissingBuiltinFamily := fn(source: String, position: Int, prefix: String, name: String): Unit {
    modSpec := if name == "Rc" {
        "core/rc"
    } else if name == "Slice" {
        "core/slice"
    } else if name == "Simd" or name == "SimdNative" {
        "core/simd"
    } else {
        "core/soa"
    };
    shortAlias := if name == "Rc" {
        "rc"
    } else if name == "Slice" {
        "slice"
    } else if name == "Simd" or name == "SimdNative" {
        "simd"
    } else {
        "soa"
    };
    syntax.failAt(source, position, prefix, "generic type " + name + " requires importing \"" + modSpec + "\" (e.g. " + shortAlias + " := import \"" + modSpec + "\"; " + shortAlias + "." + name + "<...>)");
};

/** Decodes optional `~P~A<n>~N` layout attributes from a canonical record or enum header. */
pub parseLayoutAttrSuffix := fn(rawHeader: String): (packed: Bool, align: Int, noNiche: Bool) {
    baseEnd := headerBaseEnd(rawHeader);
    tilde := rawHeader.indexOf("~", 0);
    if tilde < 0 or tilde >= baseEnd {
        return (packed = false, align = 0, noNiche = false);
    }
    var packed := false;
    var align := 0;
    var noNiche := false;
    var cur := tilde;
    loop cur < baseEnd {
        if rawHeader.at(cur) =!= "~" { break; }
        cur = cur + 1;
        if cur >= baseEnd { break; }
        ch := rawHeader.at(cur);
        if ch == "P" {
            packed = true;
            cur = cur + 1;
        } else if ch == "N" {
            noNiche = true;
            cur = cur + 1;
        } else if ch == "A" {
            cur = cur + 1;
            dStart := cur;
            loop cur < baseEnd and rawHeader.at(cur).isDigit() {
                cur = cur + 1;
            }
            if cur > dStart {
                align = syntax.parseDigits(rawHeader, dStart, cur);
            }
        } else {
            break;
        }
    }
    (=packed, =align, =noNiche)
};

/** Returns layout attributes (`packed`, `align`, `noNiche`) attached to canonical record `kind`. */
pub recordLayoutAttrs := fn(kind: String): (packed: Bool, align: Int, noNiche: Bool) {
    semi := recordHeaderSemi(kind);
    if semi <= 7 { return (packed = false, align = 0, noNiche = false); }
    parseLayoutAttrSuffix(kind.slice(7, semi))
};

/** Returns layout attributes (`packed`, `align`, `noNiche`) attached to canonical enum `kind`. */
pub enumLayoutAttrs := fn(kind: String): (packed: Bool, align: Int, noNiche: Bool) {
    if not isEnumKind(kind) { return (packed = false, align = 0, noNiche = false); }
    hdr := decodeLengthPrefixedAt(kind, 5);
    if hdr.next < 0 { return (packed = false, align = 0, noNiche = false); }
    parseLayoutAttrSuffix(hdr.text)
};

/** Parses zero or more inline type layout attributes (`#packed`, `#align(N)`, `#no_niche`) on a record or enum declaration. */
pub parseTypeLayoutAttrs := fn(source: String, startPos: Int, prefix: String): (
ok: Bool, hasAttrs: Bool, packed: Bool, align: Int, noNiche: Bool, encoded: String, next: Int, errPos: Int, errMsg: String
) {
    emptyRes := (ok = true, hasAttrs = false, packed = false, align = 0, noNiche = false, encoded = "", next = startPos, errPos = -1, errMsg = "");
    size := source.length();
    if startPos >= size or source.at(startPos) =!= "#" { return emptyRes; }
    var cur := startPos;
    var packed := false;
    var align := 0;
    var noNiche := false;
    loop cur < size and source.at(cur) == "#" {
        attrStart := cur;
        tagPos := syntax.skipTrivia(source, cur + 1, prefix);
        if tagPos >= size or not source.at(tagPos).isNameStart() {
            return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "expected layout attribute name after #");
        }
        tagEnd := source.skipName(tagPos);
        attrName := source.slice(tagPos, tagEnd);
        afterName := syntax.skipTrivia(source, tagEnd, prefix);
        if attrName == "packed" {
            if afterName < size and source.at(afterName) == "(" {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = afterName, errMsg = "#packed does not take arguments");
            }
            if packed {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "duplicate #packed attribute");
            }
            if align > 0 {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "#packed cannot be combined with #align");
            }
            packed = true;
            cur = afterName;
        } else if attrName == "no_niche" {
            if afterName < size and source.at(afterName) == "(" {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = afterName, errMsg = "#no_niche does not take arguments");
            }
            if noNiche {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "duplicate #no_niche attribute");
            }
            noNiche = true;
            cur = afterName;
        } else if attrName == "align" {
            if align > 0 {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "duplicate #align attribute");
            }
            if packed {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "#align cannot be combined with #packed");
            }
            if afterName >= size or source.at(afterName) =!= "(" {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = afterName, errMsg = "#align requires a power-of-two byte alignment argument");
            }
            numPos := syntax.skipTrivia(source, afterName + 1, prefix);
            var numEnd := numPos;
            loop numEnd < size and source.at(numEnd).isDigit() {
                numEnd = numEnd + 1;
            }
            if numEnd == numPos {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = numPos, errMsg = "#align requires a positive integer power-of-two in 1..4096");
            }
            parsedAlign := syntax.parseDigits(source, numPos, numEnd);
            closePos := syntax.skipTrivia(source, numEnd, prefix);
            if closePos >= size or source.at(closePos) =!= ")" {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = closePos, errMsg = "expected ) after #align argument");
            }
            if not isPowerOfTwoAlign(parsedAlign) {
                return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = numPos, errMsg = "#align(" + parsedAlign.toText() + ") must be a power of two in 1..4096");
            }
            align = parsedAlign;
            cur = syntax.skipTrivia(source, closePos + 1, prefix);
        } else {
            return (ok = false, hasAttrs = true, =packed, =align, =noNiche, encoded = "", next = cur, errPos = attrStart, errMsg = "unknown type layout attribute #" + attrName);
        }
    }
    encoded := (if packed { "~P" } else { "" }) + (if align > 0 { "~A" + align.toText() } else { "" }) + (if noNiche { "~N" } else { "" });
    (ok = true, hasAttrs = true, =packed, =align, =noNiche, =encoded, next = cur, errPos = -1, errMsg = "")
};

/** True when `kind` is this compiler's canonical nominal distinct kind `Distinct<lp(id#at#Name[<...>])Underlying>`. */
pub isDistinctKind := fn(kind: String): Bool {
    size := kind.length();
    size > 10 and kind.startsWithAt(0, "Distinct<") and kind.at(size - 1) == ">"
};

/** Parses the header metadata and direct underlying kind of canonical `Distinct<lp(id#at#Name[<...>])Underlying>`. */
distinctMeta := fn(kind: String): (ok: Bool, header: String, rawHeader: String, displayName: String, underlying: String) {
    if not isDistinctKind(kind) { return (ok = false, header = "", rawHeader = "", displayName = "", underlying = ""); }
    hdr := decodeLengthPrefixedAt(kind, 9);
    if hdr.next < 0 or hdr.next >= kind.length() - 1 {
        return (ok = false, header = "", rawHeader = "", displayName = "", underlying = "");
    }
    baseHdr := hdr.text.slice(0, headerBaseEnd(hdr.text));
    dName := headerDisplayName(hdr.text);
    base := kind.slice(hdr.next, kind.length() - 1);
    (ok = base =!= "", header = baseHdr, rawHeader = hdr.text, displayName = dName, underlying = base)
};

/** Returns the user-facing display name from canonical `Distinct<...>`. */
pub distinctDisplayName := fn(kind: String): String {
    distinctMeta(kind).displayName
};

/** Returns the declaration family identity header (`modId#at#Name`) from canonical `Distinct<...>`. */
distinctIdentityHeader := fn(kind: String): String {
    distinctMeta(kind).header
};

/** Returns the direct 1-step underlying kind wrapped by canonical `Distinct<...>`, or `""`. */
pub distinctUnderlyingKind := fn(kind: String): String {
    distinctMeta(kind).underlying
};

/** Unwraps nested `Distinct<...>` layers to the concrete representation kind. */
pub distinctBaseKind := fn(kind: String): String {
    var cur := kind;
    loop isDistinctKind(cur) {
        nextKind := distinctUnderlyingKind(cur);
        if nextKind == "" { break; }
        cur = nextKind;
    }
    cur
};

/** True when `kind` (or its distinct base representation) is a mutable List, Array, Map, Set, Rc, Slice, SoA, dyn Interface, or nominal record. */
pub isMutContainerKind := fn(kind: String): Bool {
    base := distinctBaseKind(kind);
    isListKind(base) or isArrayKind(base) or isMapKind(base) or isSetKind(base) or isRcKind(base) or isSliceKind(base) or isSoaKind(base) or isDynKind(base) or isRecordKind(base)
};

/** True when `kind` is a nominal record or distinct type whose base representation is a nominal record. */
pub isRecordOrDistinctRecord := fn(kind: String): Bool {
    isRecordKind(distinctBaseKind(kind))
};

/** True when `kind` is a value-comparable scalar or payload-free nominal enum kind admissible as a `Map<K, V>` key. */
pub isMapKeyKind := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    numeric.isIntKind(kind) or numeric.isFloatKind(kind) or kind == ir.VALUE_KIND_STRING or
    kind == ir.VALUE_KIND_BOOL or (isEnumKind(kind) and not isPayloadEnumKind(kind))
};

/** True when `kind` is canonical `Set<T>`. */
pub isSetKind := fn(kind: String): Bool {
    size := kind.length();
    size > 5 and kind.startsWithAt(0, "Set<") and kind.at(size - 1) == ">"
};

/** Returns the element type `T` from canonical `Set<T>`, or `""` otherwise. */
pub setElementKind := fn(kind: String): String {
    if not isSetKind(kind) { return ""; }
    kind.slice(4, kind.length() - 1)
};

/** True when `kind` is canonical `Rc<T>`. */
pub isRcKind := fn(kind: String): Bool {
    size := kind.length();
    size > 4 and kind.startsWithAt(0, "Rc<") and kind.at(size - 1) == ">"
};

/** Returns the payload element type `T` from canonical `Rc<T>`, or `""` otherwise. */
pub rcElementKind := fn(kind: String): String {
    if not isRcKind(kind) { return ""; }
    kind.slice(3, kind.length() - 1)
};

/** True when `kind` is canonical `Slice<T>`. */
pub isSliceKind := fn(kind: String): Bool {
    size := kind.length();
    size > 7 and kind.startsWithAt(0, "Slice<") and kind.at(size - 1) == ">"
};

/** Returns the element type `T` from canonical `Slice<T>`, or `""` otherwise. */
pub sliceElementKind := fn(kind: String): String {
    if not isSliceKind(kind) { return ""; }
    kind.slice(6, kind.length() - 1)
};

/** True when `kind` is canonical `Simd<T,N>`. */
pub isSimdKind := fn(kind: String): Bool {
    size := kind.length();
    size > 7 and kind.startsWithAt(0, "Simd<") and kind.at(size - 1) == ">"
};

/** Finds top-level comma in `Simd<T,N>`, or -1. */
simdCommaPos := fn(kind: String): Int {
    if not isSimdKind(kind) { return -1; }
    end := kind.length() - 1;
    tEnd := skipKindToken(kind, 5);
    if tEnd < end and kind.at(tEnd) == "," { tEnd } else { -1 }
};

/** Returns element type `T` of canonical `Simd<T,N>`, or `""`. */
pub simdElementKind := fn(kind: String): String {
    comma := simdCommaPos(kind);
    if comma < 0 { "" } else { kind.slice(5, comma) }
};

/** Returns raw lane count text `N` of canonical `Simd<T,N>`, or `""`. */
pub simdLaneCountText := fn(kind: String): String {
    comma := simdCommaPos(kind);
    if comma < 0 { "" } else { kind.slice(comma + 1, kind.length() - 1) }
};

/** Returns integer lane count `N` of canonical `Simd<T,N>`, or -2 if symbolic generic param. */
pub simdLaneCount := fn(kind: String): Int {
    nTxt := simdLaneCountText(kind);
    if nTxt == "" { return 0; }
    var i := 0;
    loop i < nTxt.length() {
        if not nTxt.at(i).isDigit() { return -2; }
        i = i + 1;
    }
    syntax.parseDigits(nTxt, 0, nTxt.length())
};

/** True when `kind` is generic placeholder `SimdNative<T>`. */
pub isSimdNativeKind := fn(kind: String): Bool {
    size := kind.length();
    size > 12 and kind.startsWithAt(0, "SimdNative<") and kind.at(size - 1) == ">"
};

/** Returns element kind `T` from generic `SimdNative<T>`, or `""`. */
pub simdNativeElementKind := fn(kind: String): String {
    if not isSimdNativeKind(kind) { return ""; }
    kind.slice(11, kind.length() - 1)
};

/** True when `kind` is an admitted byte-aligned fixed SIMD scalar lane type (`Int8..Int`, `UInt8..UInt64`, `Float32`, `Float`). */
pub isSimdElemKind := fn(kind: String): Bool {
    kind == ir.VALUE_KIND_INT8 or kind == ir.VALUE_KIND_INT16 or kind == ir.VALUE_KIND_INT32 or kind == ir.VALUE_KIND_INT or
    kind == ir.VALUE_KIND_UINT8 or kind == ir.VALUE_KIND_UINT16 or kind == ir.VALUE_KIND_UINT32 or kind == ir.VALUE_KIND_UINT64 or
    kind == ir.VALUE_KIND_FLOAT32 or kind == ir.VALUE_KIND_FLOAT
};

/** Returns byte width of an admitted `Simd` lane scalar type, or 0 otherwise. */
pub simdElemByteWidth := fn(kind: String): Int {
    if kind == ir.VALUE_KIND_INT8 or kind == ir.VALUE_KIND_UINT8 { 1 }
    else if kind == ir.VALUE_KIND_INT16 or kind == ir.VALUE_KIND_UINT16 { 2 }
    else if kind == ir.VALUE_KIND_INT32 or kind == ir.VALUE_KIND_UINT32 or kind == ir.VALUE_KIND_FLOAT32 { 4 }
    else if kind == ir.VALUE_KIND_INT or kind == ir.VALUE_KIND_UINT64 or kind == ir.VALUE_KIND_FLOAT { 8 }
    else { 0 }
};

/** Returns true when `(elemKind, lanes)` is a valid fixed power-of-two SIMD shape (`2..64` lanes, total `<= 64` bytes). */
pub isValidSimdLaneCount := fn(elemKind: String, lanes: Int): Bool {
    if not isSimdElemKind(elemKind) { return false; }
    if lanes =!= 2 and lanes =!= 4 and lanes =!= 8 and lanes =!= 16 and lanes =!= 32 and lanes =!= 64 {
        return false;
    }
    bw := simdElemByteWidth(elemKind);
    bw > 0 and lanes * bw <= 64
};

/** Returns the compile-time 128-bit baseline target lane count for `SimdNative<T>`. */
pub simdNativeLaneCount := fn(elemKind: String): Int {
    bw := simdElemByteWidth(elemKind);
    if bw <= 0 { 0 } else { 16 / bw }
};

/** True when `kind` is canonical parallel-column `SoA<R>`. */
pub isSoaKind := fn(kind: String): Bool {
    size := kind.length();
    size > 5 and kind.startsWithAt(0, "SoA<") and kind.at(size - 1) == ">"
};

/** Returns underlying record kind `R` from canonical `SoA<R>`, or `""`. */
pub soaRecordKind := fn(kind: String): String {
    if not isSoaKind(kind) { return ""; }
    kind.slice(4, kind.length() - 1)
};

/** Maps a C-supported `Simd<T,N>` kind to its C11 typedef name `lt_simd_<tag>_<n>`, or `""`. */
pub cSimdTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isSimdKind(kind) { return ""; }
    el := simdElementKind(kind);
    n := simdLaneCount(kind);
    if not isValidSimdLaneCount(el, n) { return ""; }
    s := cScalarTag(el);
    if s =!= "" { "lt_simd_" + s + "_" + n.toText() } else { "" }
};

/** Maps a C-supported `SoA<R>` kind to its C11 typedef name `lt_soa_<hash>`, or `""`. */
pub cSoaTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isSoaKind(kind) { return ""; }
    rec := soaRecordKind(kind);
    if not isRecordKind(rec) or recordComponentCount(rec) == 0 or not cIsSupportedElem(rec) { return ""; }
    "lt_soa_" + cStructHash(rec)
};

/** True when `kind` is or transitively contains a borrowed `Slice<T>` type. */
pub containsSliceKind := fn(kind: String): Bool {
    if kind.indexOf("Slice<", 0) < 0 { return false; }
    if isSliceKind(kind) { return true; }
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if isListKind(kind) { return self(listElementKind(kind)); }
    if isArrayKind(kind) { return self(arrayElementKind(kind)); }
    if isMapKind(kind) { return self(mapKeyKind(kind)) or self(mapValueKind(kind)); }
    if isSetKind(kind) { return self(setElementKind(kind)); }
    if isRcKind(kind) { return self(rcElementKind(kind)); }
    if isSimdKind(kind) { return self(simdElementKind(kind)); }
    if isSimdNativeKind(kind) { return self(simdNativeElementKind(kind)); }
    if isSoaKind(kind) { return self(soaRecordKind(kind)); }
    if isTupleKind(kind) {
        var i := 0;
        n := tupleComponentCount(kind);
        loop i < n {
            if self(tupleComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isRecordKind(kind) {
        var i := 0;
        n := recordComponentCount(kind);
        loop i < n {
            if self(recordComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isPayloadEnumKind(kind) {
        var ci := 0;
        cc := enumCaseCount(kind);
        loop ci < cc {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { return true; }
            }
            ci = ci + 1;
        }
        return false;
    }
    if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(um) { return true; }
        }
        return false;
    }
    if isResultKind(kind) {
        return self(resultOkKind(kind)) or self(resultErrKind(kind));
    }
    if isFnKind(kind) {
        var pi := 0;
        pc := fnParamCount(kind);
        loop pi < pc {
            if self(fnParamComponent(kind, pi).kind) { return true; }
            pi = pi + 1;
        }
        fnCtx := fnContextKind(kind);
        if fnCtx =!= "" and self(fnCtx) { return true; }
        return self(fnResultKind(kind));
    }
    if isCtxKind(kind) {
        loop contexts.parseCtxKindSlots(kind) as cs {
            if self(cs.kind) { return true; }
        }
        return false;
    }
    false
};

/** Active module key for interface conformance visibility checks (`""` allows global/all public lookup). */
var activeImplModuleKey := "";

/** Sets the active module key used for private-vs-public `impl` conformance lookup. */
pub setActiveImplModuleKey := fn(moduleKey: String): Unit {
    activeImplModuleKey = moduleKey;
};

/** True when `kind` is a canonical interface reference `Iface<key>` or `Iface<key;Arg1,...>`. */
pub isInterfaceKind := fn(kind: String): Bool {
    size := kind.length();
    size > 7 and kind.startsWithAt(0, "Iface<") and kind.at(size - 1) == ">" and skipKindToken(kind, 0) == size
};

/** Returns the canonical `moduleKey#Name` of an `Iface<...>` kind. */
pub ifaceKeyOf := fn(kind: String): String {
    if not isInterfaceKind(kind) { return ""; }
    inner := kind.slice(6, kind.length() - 1);
    semi := inner.indexOf(";", 0);
    if semi < 0 { inner } else { inner.slice(0, semi) }
};

/** Returns instantiated type argument kinds of `Iface<key;Arg1,...>`, or `[]`. */
pub ifaceArgsOf := fn(kind: String): List<String> {
    if not isInterfaceKind(kind) {
        empty: List<String> = [];
        return empty;
    }
    inner := kind.slice(6, kind.length() - 1);
    semi := inner.indexOf(";", 0);
    if semi < 0 {
        empty: List<String> = [];
        return empty;
    }
    splitTopLevelKinds(inner.slice(semi + 1, inner.length()))
};

/** Builds canonical `Iface<key>` or `Iface<key;Arg1,...>`. */
pub buildInterfaceKind := fn(key: String, args: List<String>): String {
    if args.length() == 0 { "Iface<" + key + ">" } else { "Iface<" + key + ";" + args.join(",") + ">" }
};

/** True when `kind` is a canonical dynamic borrowed interface view `Dyn<Iface<...>>`. */
pub isDynKind := fn(kind: String): Bool {
    size := kind.length();
    size > 11 and kind.startsWithAt(0, "Dyn<") and kind.at(size - 1) == ">" and skipKindToken(kind, 0) == size and isInterfaceKind(kind.slice(4, size - 1))
};

/** Extracts the inner `Iface<...>` from canonical `Dyn<Iface<...>>`. */
pub dynInterfaceKind := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isDynKind(kind) { return ""; }
    kind.slice(4, kind.length() - 1)
};

/** Maps a `Dyn<Iface<...>>` kind to its C11 16-byte fat-pointer struct typedef `lt_dyn_<hash>`. */
pub cDynTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isDynKind(kind) { return ""; }
    "lt_dyn_" + cStructHash(dynInterfaceKind(kind))
};

/** Maps a `Dyn<Iface<...>>` kind to its C11 vtable struct typedef `lt_vt_<hash>`. */
pub cVtableTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isDynKind(kind) { return ""; }
    "lt_vt_" + cStructHash(dynInterfaceKind(kind))
};

/** Returns unique C11 vtable instance identifier `lt_vtbl_<hash>` for `(dynKind, concreteKind, implKey)`. */
pub cVtableInstanceSym := fn(dynKind: String, concreteKind: String, implKey: String): String {
    "lt_vtbl_" + cStructHash(dynKind + "|" + concreteKind + "|" + implKey)
};

/** True when `kind` is or transitively contains a borrowed `Dyn<Iface<...>>` type. */
pub containsDynKind := fn(kind: String): Bool {
    if kind.indexOf("Dyn<", 0) < 0 { return false; }
    if isDynKind(kind) { return true; }
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if isListKind(kind) { return self(listElementKind(kind)); }
    if isArrayKind(kind) { return self(arrayElementKind(kind)); }
    if isMapKind(kind) { return self(mapKeyKind(kind)) or self(mapValueKind(kind)); }
    if isSetKind(kind) { return self(setElementKind(kind)); }
    if isRcKind(kind) { return self(rcElementKind(kind)); }
    if isSliceKind(kind) { return self(sliceElementKind(kind)); }
    if isSimdKind(kind) { return self(simdElementKind(kind)); }
    if isSimdNativeKind(kind) { return self(simdNativeElementKind(kind)); }
    if isSoaKind(kind) { return self(soaRecordKind(kind)); }
    if isTupleKind(kind) {
        var i := 0;
        n := tupleComponentCount(kind);
        loop i < n {
            if self(tupleComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isRecordKind(kind) {
        var i := 0;
        n := recordComponentCount(kind);
        loop i < n {
            if self(recordComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isPayloadEnumKind(kind) {
        var ci := 0;
        cc := enumCaseCount(kind);
        loop ci < cc {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { return true; }
            }
            ci = ci + 1;
        }
        return false;
    }
    if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(um) { return true; }
        }
        return false;
    }
    if isResultKind(kind) {
        return self(resultOkKind(kind)) or self(resultErrKind(kind));
    }
    if isFnKind(kind) {
        var pi := 0;
        pc := fnParamCount(kind);
        loop pi < pc {
            if self(fnParamComponent(kind, pi).kind) { return true; }
            pi = pi + 1;
        }
        fnCtx := fnContextKind(kind);
        if fnCtx =!= "" and self(fnCtx) { return true; }
        return self(fnResultKind(kind));
    }
    if isCtxKind(kind) {
        loop contexts.parseCtxKindSlots(kind) as cs {
            if self(cs.kind) { return true; }
        }
        return false;
    }
    false
};

/** Returns a diagnostic message when `kind` contains borrowed `Slice<T>` or `dyn Interface` forbidden in owning containers, or `""`. */
pub borrowedStorageError := fn(kind: String): String {
    if containsSliceKind(kind) { return "borrowed Slice<T> cannot be stored in owning container or type definition"; }
    if containsDynKind(kind) { return "borrowed dyn Interface cannot be stored in owning container or type definition"; }
    ""
};

/** True when `kind` is a multi-bound `Type<...>` conjunction `All<B1,B2,...>`. */
pub isAllConstraintKind := fn(kind: String): Bool {
    size := kind.length();
    size > 5 and kind.startsWithAt(0, "All<") and kind.at(size - 1) == ">" and skipKindToken(kind, 0) == size
};

/** Splits an `All<...>` conjunction (or singleton) into its constraint members. */
pub allConstraintMembers := fn(kind: String): List<String> {
    if kind == "" {
        empty: List<String> = [];
        return empty;
    }
    if isAllConstraintKind(kind) {
        return splitTopLevelKinds(kind.slice(4, kind.length() - 1));
    }
    single: List<String> = [kind];
    single
};

/** True when `elemKind` is stored in bit-packed sub-byte lanes (`Bool`, `Int1..Int4`, `UInt1..UInt4`). */
pub isBitPackedElemKind := fn(elemKind: String): Bool {
    base := distinctBaseKind(elemKind);
    base == ir.VALUE_KIND_BOOL or
    base == ir.VALUE_KIND_INT1 or base == ir.VALUE_KIND_INT2 or base == ir.VALUE_KIND_INT4 or
    base == ir.VALUE_KIND_UINT1 or base == ir.VALUE_KIND_UINT2 or base == ir.VALUE_KIND_UINT4
};

/** True when `kind` is a concrete `[T; N]` fixed array backed by bit-packed sub-byte storage. */
pub isBitPackedArrayKind := fn(kind: String): Bool {
    base := distinctBaseKind(kind);
    isArrayKind(base) and cArrayTag(base) =!= "" and isBitPackedElemKind(arrayElementKind(base))
};

/** True when `kind` is a canonical closed-union type set `Union<K1,K2,...>`. */
pub isUnionKind := fn(kind: String): Bool {
    size := kind.length();
    size > 7 and kind.startsWithAt(0, "Union<") and kind.at(size - 1) == ">"
};

/** Returns flat canonical members of `kind` (`Union<...>` splits top-level members; single non-union returns `[kind]`). */
pub unionMembers := fn(kind: String): List<String> {
    if kind == "" {
        empty: List<String> = [];
        return empty;
    }
    if isUnionKind(kind) {
        return splitTopLevelKinds(kind.slice(6, kind.length() - 1));
    }
    single: List<String> = [kind];
    single
};

/** Flattens nested `Union<...>` entries, deduplicates, and sorts lexicographically (`""` -> `""`, 1 -> `flat[0]`, 2+ -> `Union<...>`). */
pub buildUnionKind := fn(members: List<String>): String {
    mut flat: List<String> = [];
    loop members as m {
        loop unionMembers(m) as sub {
            if sub =!= "" and not flat.contains(sub) {
                mut flat.pushBack(sub);
            }
        }
    }
    n := flat.length();
    if n == 0 { return ""; }
    if n == 1 { return flat[0]; }
    var i := 1;
    loop i < n {
        key := flat[i];
        var j := i - 1;
        loop j >= 0 and key.compare(flat[j]) < 0 {
            flat[j + 1] = flat[j];
            j = j - 1;
        }
        flat[j + 1] = key;
        i = i + 1;
    }
    "Union<" + flat.join(",") + ">"
};

/** True when `kind` is a canonical fallible result type `Result<OkKind,ErrKind>`. */
pub isResultKind := fn(kind: String): Bool {
    size := kind.length();
    size > 8 and kind.startsWithAt(0, "Result<") and kind.at(size - 1) == ">" and skipKindToken(kind, 0) == size and splitTopLevelKinds(kind.slice(7, size - 1)).length() == 2
};

/** Returns the success type `T` of canonical `Result<T,E>`. */
pub resultOkKind := fn(kind: String): String {
    if not isResultKind(kind) { return ""; }
    splitTopLevelKinds(kind.slice(7, kind.length() - 1))[0]
};

/** Returns the error type `E` of canonical `Result<T,E>`. */
pub resultErrKind := fn(kind: String): String {
    if not isResultKind(kind) { return ""; }
    splitTopLevelKinds(kind.slice(7, kind.length() - 1))[1]
};

/** Builds canonical `Result<OkKind,ErrKind>` while preserving its success/error boundary. */
pub buildResultKind := fn(okKind: String, errKind: String): String {
    "Result<" + okKind + "," + errKind + ">"
};

/** Returns the zero-based tag index of exact `member` inside normalized `uKind`, or -1. */
pub unionMemberIndex := fn(uKind: String, member: String): Int {
    if uKind == member and member =!= "" and not isUnionKind(uKind) { return 0; }
    if not isUnionKind(uKind) { return -1; }
    mems := unionMembers(uKind);
    var i := 0;
    loop i < mems.length() {
        if mems[i] == member { return i; }
        i = i + 1;
    }
    -1
};

/** True when every normalized union member of `subKind` is also a member of `supKind`. */
pub unionContainsAll := fn(supKind: String, subKind: String): Bool {
    supMems := unionMembers(supKind);
    loop unionMembers(subKind) as m {
        if not supMems.contains(m) { return false; }
    }
    true
};

/** Intersects union members of `aKind` and `bKind`, returning normalized `Union<...>`, single kind, or `""`. */
pub unionIntersect := fn(aKind: String, bKind: String): String {
    bMems := unionMembers(bKind);
    mut inter: List<String> = [];
    loop unionMembers(aKind) as m {
        if bMems.contains(m) { mut inter.pushBack(m); }
    }
    buildUnionKind(inter)
};

/** Subtracts members of `removeKind` from `baseKind`, returning normalized remaining kind or `""`. */
pub unionSubtract := fn(baseKind: String, removeKind: String): String {
    remMems := unionMembers(removeKind);
    mut rem: List<String> = [];
    loop unionMembers(baseKind) as m {
        if not remMems.contains(m) { mut rem.pushBack(m); }
    }
    buildUnionKind(rem)
};

/** True when a parameter spec kind represents a constrained `Type<...>` parameter. */
pub isTypeConstraintKind := fn(kind: String): Bool {
    size := kind.length();
    size > 6 and kind.startsWithAt(0, "Type<") and kind.at(size - 1) == ">"
};

/** True when a parameter spec kind represents any comptime `Type` parameter (`""` unconstrained or `"Type<...>"` constrained). */
pub isTypeParamKind := fn(kind: String): Bool {
    kind == "" or isTypeConstraintKind(kind)
};

/** Extracts the inner canonical constraint kind (`Union<...>` or single concrete kind) from `"Type<...>"`. */
pub typeConstraintUnion := fn(specKind: String): String {
    if not isTypeConstraintKind(specKind) { return ""; }
    specKind.slice(5, specKind.length() - 1)
};

/** Splits comma-separated items inside raw `Type<A, B>` at top-level `,` while skipping `<...>`, `(...)`, `[...]`, strings, and comments. */
splitTopLevelCommaRaw := fn(raw: String, prefix: String): List<String> {
    mut out: List<String> = [];
    size := raw.length();
    var cursor := 0;
    var segStart := 0;
    var angleDepth := 0;
    var parenDepth := 0;
    var bracketDepth := 0;
    loop cursor < size {
        ch := raw.at(cursor);
        if ch == "\"" {
            cursor = syntax.skipAliasString(raw, cursor);
        } else if ch == "/" and raw.startsWithAt(cursor, "/*") {
            cursor = syntax.skipComment(raw, cursor, prefix);
        } else if ch == "<" {
            angleDepth = angleDepth + 1;
            cursor = cursor + 1;
        } else if ch == ">" {
            if angleDepth > 0 { angleDepth = angleDepth - 1; }
            cursor = cursor + 1;
        } else if ch == "(" {
            parenDepth = parenDepth + 1;
            cursor = cursor + 1;
        } else if ch == ")" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            cursor = cursor + 1;
        } else if ch == "[" {
            bracketDepth = bracketDepth + 1;
            cursor = cursor + 1;
        } else if ch == "]" {
            if bracketDepth > 0 { bracketDepth = bracketDepth - 1; }
            cursor = cursor + 1;
        } else if ch == "," and angleDepth == 0 and parenDepth == 0 and bracketDepth == 0 {
            part := raw.slice(segStart, cursor);
            mut out.pushBack(part);
            cursor = cursor + 1;
            segStart = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    if segStart <= size {
        tail := raw.slice(segStart, size);
        if tail =!= "" or out.length() > 0 { mut out.pushBack(tail); }
    }
    out
};

/** True when every member allowed by `subConstraint` is also allowed by `superConstraint`. */
pub constraintIsSubset := fn(subConstraint: String, superConstraint: String): Bool {
    if subConstraint == "" or superConstraint == "" { return false; }
    subItems := allConstraintMembers(subConstraint);
    supItems := allConstraintMembers(superConstraint);
    var supUnion := "";
    mut supIfaces: List<String> = [];
    loop supItems as si {
        if isInterfaceKind(si) {
            mut supIfaces.pushBack(si);
        } else {
            supUnion = si;
        }
    }
    /* Every required interface in superConstraint must appear in subConstraint. */
    loop supIfaces as reqI {
        if not subItems.contains(reqI) { return false; }
    }
    /* If superConstraint also restricts closed union members, subConstraint's closed union must be a subset. */
    if supUnion =!= "" {
        var subUnion := "";
        loop subItems as si2 {
            if not isInterfaceKind(si2) { subUnion = si2; }
        }
        if subUnion == "" { return false; }
        supMembers := unionMembers(supUnion);
        loop unionMembers(subUnion) as m {
            if not supMembers.contains(m) { return false; }
        }
    }
    true
};

/** Computes the intersection of multiple `Type<A, B, ...>` constraint bounds (closed unions and/or interfaces), returning `ok = false` when empty. */
pub intersectConstraintBounds := fn(boundKinds: List<String>): (ok: Bool, kind: String) {
    if boundKinds.length() == 0 { return (ok = false, kind = ""); }
    mut unionBounds: List<String> = [];
    mut ifaceBounds: List<String> = [];
    loop boundKinds as bk {
        loop allConstraintMembers(bk) as part {
            if isInterfaceKind(part) {
                if not ifaceBounds.contains(part) { mut ifaceBounds.pushBack(part); }
            } else {
                mut unionBounds.pushBack(part);
            }
        }
    }
    var intersectedUnion := "";
    if unionBounds.length() > 0 {
        var current := unionMembers(unionBounds[0]);
        var i := 1;
        loop i < unionBounds.length() {
            nextMembers := unionMembers(unionBounds[i]);
            mut filtered: List<String> = [];
            loop current as m {
                if nextMembers.contains(m) {
                    mut filtered.pushBack(m);
                }
            }
            current = filtered;
            i = i + 1;
        }
        if current.length() == 0 { return (ok = false, kind = ""); }
        intersectedUnion = buildUnionKind(current);
    }
    mut allParts: List<String> = [];
    if intersectedUnion =!= "" { mut allParts.pushBack(intersectedUnion); }
    loop ifaceBounds as ib { mut allParts.pushBack(ib); }
    if allParts.length() == 0 { return (ok = false, kind = ""); }
    if allParts.length() == 1 { return (ok = true, kind = allParts[0]); }
    (ok = true, kind = "All<" + allParts.join(",") + ">")
};

/** Parses `genericParams` CSV (e.g. `"T,T2=Type<...>,N=Int,C=Enum<...>"`) into `(name, kind)` pairs. */
pub splitParamSpecs := fn(csv: String): List<(name: String, kind: String)> {
    mut out: List<(name: String, kind: String)> = [];
    size := csv.length();
    var cursor := 0;
    loop cursor < size {
        eq := csv.indexOf("=", cursor);
        var comma := -1;
        var scan := cursor;
        var depth := 0;
        loop scan < size {
            ch := csv.at(scan);
            if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
            else if ch == ">" or ch == ")" or ch == "]" {
                if depth > 0 { depth = depth - 1; }
            } else if ch == "," and depth == 0 {
                comma = scan;
                break;
            }
            scan = scan + 1;
        }
        end := if comma < 0 { size } else { comma };
        if eq > cursor and eq < end {
            pName := csv.slice(cursor, eq);
            pKind := csv.slice(eq + 1, end);
            normKind := if pKind == "Type" { "" } else { pKind };
            if pName =!= "" { mut out.pushBack((name = pName, kind = normKind)); }
        } else {
            pName := csv.slice(cursor, end);
            if pName =!= "" { mut out.pushBack((name = pName, kind = "")); }
        }
        if comma < 0 { break; }
        cursor = comma + 1;
    }
    out
};

/** Returns the resolved constraint union kind for constrained `Type<...>` parameter `name` in `genericType`, or `""` when unconstrained or absent. */
pub typeParamConstraintKind := fn(genericType: String, name: String): String {
    if genericType == "" or name == "" { return ""; }
    loop splitParamSpecs(genericType) as spec {
        if spec.name == name and isTypeConstraintKind(spec.kind) { return typeConstraintUnion(spec.kind); }
    }
    ""
};

/** True when `name` matches an active comptime `Type` parameter in `genericType` (constrained or unconstrained). */
pub isGenericParamName := fn(genericType: String, name: String): Bool {
    if genericType == "" or name == "" { return false; }
    loop splitParamSpecs(genericType) as spec {
        if spec.name == name and isTypeParamKind(spec.kind) { return true; }
    }
    false
};

/** Returns the canonical value type of comptime value parameter `name` in `genericType`, or `""` when absent or a `Type` param. */
pub valueParamKind := fn(genericType: String, name: String): String {
    if genericType == "" or name == "" { return ""; }
    loop splitParamSpecs(genericType) as spec {
        if spec.name == name and not isTypeParamKind(spec.kind) { return spec.kind; }
    }
    ""
};

/** True when `name` matches any comptime parameter (`Type` or value) in `genericType`. */
pub isAnyParamName := fn(genericType: String, name: String): Bool {
    if genericType == "" or name == "" { return false; }
    loop splitParamSpecs(genericType) as spec {
        if spec.name == name { return true; }
    }
    false
};

/** True when `genericType` declares at least one discrete comptime value parameter. */
pub hasComptimeValueParam := fn(genericType: String): Bool {
    if genericType == "" { return false; }
    loop splitParamSpecs(genericType) as spec {
        if not isTypeParamKind(spec.kind) { return true; }
    }
    false
};

/** True when `kind` is this compiler's canonical nominal enum kind `Enum<lp(id#at#Name)lp(Backing)count;...>`. */
pub isEnumKind := fn(kind: String): Bool {
    size := kind.length();
    size > 6 and kind.startsWithAt(0, "Enum<") and kind.at(size - 1) == ">"
};

/** Parses the header metadata of canonical `Enum<lp(id#at#Name)lp(Backing)count;...>`. */
enumHeaderInfo := fn(kind: String): (ok: Bool, displayName: String, backing: String, count: Int, casesStart: Int) {
    if not isEnumKind(kind) { return (ok = false, displayName = "", backing = "", count = 0, casesStart = -1); }
    hdr := decodeLengthPrefixedAt(kind, 5);
    if hdr.next < 0 { return (ok = false, displayName = "", backing = "", count = 0, casesStart = -1); }
    bk := decodeLengthPrefixedAt(kind, hdr.next);
    if bk.next < 0 { return (ok = false, displayName = "", backing = "", count = 0, casesStart = -1); }
    size := kind.length();
    var cur := bk.next;
    var countEnd := cur;
    loop countEnd < size and kind.at(countEnd).isDigit() {
        countEnd = countEnd + 1;
    }
    if countEnd == cur or countEnd >= size or kind.at(countEnd) =!= ";" {
        return (ok = false, displayName = "", backing = "", count = 0, casesStart = -1);
    }
    count := syntax.parseDigits(kind, cur, countEnd);
    disp := headerDisplayName(hdr.text);
    (ok = true, displayName = disp, backing = bk.text, count = count, casesStart = countEnd + 1)
};

/** Returns the display name of canonical enum kind `kind`. */
pub enumDisplayName := fn(kind: String): String {
    info := enumHeaderInfo(kind);
    if not info.ok { kind } else { info.displayName }
};

/** Returns the full module-scoped family identity header (`id#at#Name`) of canonical enum `kind`, or `""`. */
pub enumIdentityHeader := fn(kind: String): String {
    if not isEnumKind(kind) { return ""; }
    hdr := decodeLengthPrefixedAt(kind, 5);
    if hdr.next < 0 { return ""; }
    hdr.text.slice(0, headerBaseEnd(hdr.text))
};

/** Returns the canonical nominal type-operation owner key for `kind`, or `""` for non-nominal types. */
pub typeOpOwnerKey := fn(kind: String): String {
    if isAnonRecordKind(kind) { return ""; }
    if isRecordKind(kind) {
        semi := recordHeaderSemi(kind);
        if semi <= 7 { return ""; }
        hdr := kind.slice(7, semi);
        return "Record:" + hdr.slice(0, headerBaseEnd(hdr));
    }
    if isEnumKind(kind) {
        hdr := enumIdentityHeader(kind);
        if hdr == "" { return ""; }
        return "Enum:" + hdr;
    }
    if isDistinctKind(kind) {
        hdr := distinctIdentityHeader(kind);
        if hdr == "" { return ""; }
        return "Distinct:" + hdr;
    }
    if isListKind(kind) { return "List"; }
    if isMapKind(kind) { return "Map"; }
    if isSetKind(kind) { return "Set"; }
    if isRcKind(kind) { return "Rc"; }
    if isSliceKind(kind) { return "Slice"; }
    if isSimdKind(kind) { return "Simd"; }
    if isSoaKind(kind) { return "SoA"; }
    if isArrayKind(kind) { return "Array"; }
    if kind == ir.VALUE_KIND_STRING or kind == ir.VALUE_KIND_BOOL or numeric.isNumericKind(kind) {
        return kind;
    }
    ""
};

/** Returns canonical type arguments attached to a generic `Record`, `Distinct`, or `Enum`, or `[]`. */
pub nominalTypeArgs := fn(kind: String): List<String> {
    if isRecordKind(kind) {
        semi := recordHeaderSemi(kind);
        if semi <= 7 {
            empty: List<String> = [];
            return empty;
        }
        return headerTypeArgs(kind.slice(7, semi));
    }
    if isDistinctKind(kind) {
        return headerTypeArgs(distinctMeta(kind).rawHeader);
    }
    if isEnumKind(kind) {
        hdr := decodeLengthPrefixedAt(kind, 5);
        if hdr.next < 0 {
            empty: List<String> = [];
            return empty;
        }
        return headerTypeArgs(hdr.text);
    }
    empty: List<String> = [];
    empty
};

/** Returns the built-in nominal type family owned by core/type `moduleIdentity` when it matches `typeName`, else `""`. */
pub coreBuiltinOwnerType := fn(moduleIdentity: String, typeName: String): String {
    if (moduleIdentity == "lite.core.list.v1" or moduleIdentity == "lite.type.list.v1") and typeName == "List" { return "List"; }
    if (moduleIdentity == "lite.core.map.v1" or moduleIdentity == "lite.type.map.v1") and typeName == "Map" { return "Map"; }
    if (moduleIdentity == "lite.core.set.v1" or moduleIdentity == "lite.type.set.v1") and typeName == "Set" { return "Set"; }
    if (moduleIdentity == "lite.core.rc.v1" or moduleIdentity == "lite.type.rc.v1") and typeName == "Rc" { return "Rc"; }
    if (moduleIdentity == "lite.core.slice.v1" or moduleIdentity == "lite.type.slice.v1") and typeName == "Slice" { return "Slice"; }
    if (moduleIdentity == "lite.core.simd.v1" or moduleIdentity == "lite.type.simd.v1") and typeName == "Simd" { return "Simd"; }
    if (moduleIdentity == "lite.core.soa.v1" or moduleIdentity == "lite.type.soa.v1") and typeName == "SoA" { return "SoA"; }
    if (moduleIdentity == "lite.core.text.v1" or moduleIdentity == "lite.type.string.v1") and typeName == "String" { return "String"; }
    if (moduleIdentity == "lite.core.text.v1" or moduleIdentity == "lite.type.bool.v1") and typeName == "Bool" { return "Bool"; }
    if (moduleIdentity == "lite.core.text.v1" or moduleIdentity == "lite.type.float.v1") {
        if typeName == "Float64" or typeName == "Double" { return "Float"; }
        if numeric.isFloatKind(typeName) { return typeName; }
    }
    if (moduleIdentity == "lite.core.int.v1" or moduleIdentity == "lite.type.int.v1") {
        if typeName == "Int64" { return "Int"; }
        if numeric.isIntKind(typeName) { return typeName; }
    }
    if (moduleIdentity == "lite.core.array.v1" or moduleIdentity == "lite.type.array.v1") and typeName == "Array" { return "Array"; }
    ""
};

/** True when `typeName` is a generic built-in type family requiring explicit `Self<...>` arguments. */
pub isGenericCoreOwner := fn(typeName: String): Bool {
    typeName == "List" or typeName == "Map" or typeName == "Set" or typeName == "Rc" or typeName == "Slice" or typeName == "Simd" or typeName == "SoA" or typeName == "Array"
};

/** Returns the backing scalar kind of canonical enum kind `kind`, or `""` for a plain or payload enum. */
pub enumBackingKind := fn(kind: String): String {
    info := enumHeaderInfo(kind);
    if not info.ok or info.backing == "$payload" { "" } else { info.backing }
};

/** True when `kind` is a canonical payload-bearing enum `Enum<lp(hdr)lp("$payload")count;...>`. */
pub isPayloadEnumKind := fn(kind: String): Bool {
    isEnumKind(kind) and enumHeaderInfo(kind).backing == "$payload"
};

/** Returns the number of cases in canonical enum kind `kind`. */
pub enumCaseCount := fn(kind: String): Int {
    info := enumHeaderInfo(kind);
    if not info.ok { 0 } else { info.count }
};

/** Returns the 0-based case index matching `caseName` in canonical enum `kind`, or -1 when absent. */
pub enumCaseIndex := fn(kind: String, caseName: String): Int {
    info := enumHeaderInfo(kind);
    if not info.ok or caseName == "" { return -1; }
    var cur := info.casesStart;
    var idx := 0;
    loop idx < info.count {
        nDec := decodeLengthPrefixedAt(kind, cur);
        if nDec.next < 0 { return -1; }
        vDec := decodeLengthPrefixedAt(kind, nDec.next);
        if vDec.next < 0 { return -1; }
        if nDec.text == caseName { return idx; }
        cur = vDec.next;
        idx = idx + 1;
    }
    -1
};

/** Returns the case name and encoded TS backing value code at 0-based `targetIndex` in canonical enum `kind`. */
pub enumCaseAt := fn(kind: String, targetIndex: Int): (name: String, valueCode: String) {
    info := enumHeaderInfo(kind);
    if not info.ok or targetIndex < 0 or targetIndex >= info.count {
        return (name = "", valueCode = "");
    }
    var cur := info.casesStart;
    var idx := 0;
    loop idx < info.count {
        nDec := decodeLengthPrefixedAt(kind, cur);
        if nDec.next < 0 { return (name = "", valueCode = ""); }
        vDec := decodeLengthPrefixedAt(kind, nDec.next);
        if vDec.next < 0 { return (name = "", valueCode = ""); }
        if idx == targetIndex { return (name = nDec.text, valueCode = vDec.text); }
        cur = vDec.next;
        idx = idx + 1;
    }
    (name = "", valueCode = "")
};

/** Returns canonical payload type kinds for case `index` of payload enum `kind`, or `[]`. */
pub enumCasePayloads := fn(kind: String, index: Int): List<String> {
    if not isPayloadEnumKind(kind) {
        empty: List<String> = [];
        return empty;
    }
    csv := enumCaseAt(kind, index).valueCode;
    if csv == "" {
        empty: List<String> = [];
        return empty;
    }
    splitTopLevelKinds(csv)
};

/** Returns the number of payload fields attached to case `index` of enum `kind` (0 for plain/payload-free cases). */
pub enumCasePayloadCount := fn(kind: String, index: Int): Int {
    enumCasePayloads(kind, index).length()
};

/** Returns canonical payload kind at `(caseIndex, payloadIndex)` of payload enum `kind`, or `""`. */
pub enumCasePayloadKind := fn(kind: String, caseIndex: Int, payloadIndex: Int): String {
    ps := enumCasePayloads(kind, caseIndex);
    if payloadIndex < 0 or payloadIndex >= ps.length() { return ""; }
    ps[payloadIndex]
};

/** Pre-validates raw `@enumraw:` case pairs before resolution, reporting payload-enum presence and mixed backing/value errors. */
enumRawPreCheck := fn(rawSource: String, explicitBacking: String, casesStart: Int, caseCount: Int): (ok: Bool, hasPayload: Bool, error: String) {
    if caseCount <= 0 {
        return (ok = false, hasPayload = false, error = "enum must declare at least one case");
    }
    mut names: List<String> = [];
    var cur := casesStart;
    var hasPayload := false;
    var hasNonPayVal := false;
    var idx := 0;
    loop idx < caseCount {
        nDec := decodeLengthPrefixedAt(rawSource, cur);
        if nDec.next < 0 { return (ok = false, hasPayload = hasPayload, error = "malformed enum case name"); }
        vDec := decodeLengthPrefixedAt(rawSource, nDec.next);
        if vDec.next < 0 { return (ok = false, hasPayload = hasPayload, error = "malformed enum case value"); }
        if names.contains(nDec.text) {
            return (ok = false, hasPayload = hasPayload, error = "duplicate enum case " + nDec.text);
        }
        (mut names).pushBack(nDec.text);
        if vDec.text.startsWithAt(0, "@pay:") or vDec.text.startsWithAt(0, "@paymix:") {
            hasPayload = true;
            if vDec.text.startsWithAt(0, "@paymix:") { hasNonPayVal = true; }
        } else if vDec.text =!= "" {
            hasNonPayVal = true;
        }
        cur = vDec.next;
        idx = idx + 1;
    }
    if hasPayload and (explicitBacking =!= "" or hasNonPayVal) {
        return (ok = false, hasPayload = true, error = "payload-bearing enum cannot declare a backing type or assigned case values");
    }
    (ok = true, hasPayload = hasPayload, error = "")
};

/** Splits comma-separated raw payload type texts into `items`, allowing one trailing comma and rejecting empty payloads. */
splitPayloadTypeTexts := fn(rawPay: String, prefix: String, items: mut List<String>): Bool {
    segs := splitTopLevelCommaRaw(rawPay, prefix);
    var i := 0;
    loop i < segs.length() {
        seg := segs[i];
        tStart := syntax.skipTrivia(seg, 0, prefix);
        if tStart >= seg.length() {
            if i == segs.length() - 1 and items.length() > 0 { break; }
            return false;
        }
        mut items.pushBack(seg);
        i = i + 1;
    }
    items.length() > 0
};

/** Escapes angle/paren/bracket characters inside a JS/TS string literal so `Enum<...>` never contains unbalanced delimiters. */
escapeEnumStringLiteral := fn(code: String): String {
    size := code.length();
    mut parts: List<String> = [];
    var segStart := 0;
    var i := 0;
    loop i < size {
        ch := code.at(i);
        repl := match {
            ch == "<" { "\\u003c" }
            ch == ">" { "\\u003e" }
            ch == "(" { "\\u0028" }
            ch == ")" { "\\u0029" }
            ch == "[" { "\\u005b" }
            ch == "]" { "\\u005d" }
            _ { "" }
        };
        if repl =!= "" {
            if i > segStart { mut parts.pushBack(code.slice(segStart, i)); }
            (mut parts).pushBack(repl);
            segStart = i + 1;
        }
        i = i + 1;
    }
    if segStart == 0 { return code; }
    if segStart < size { mut parts.pushBack(code.slice(segStart, size)); }
    parts.join("")
};

/** Decodes an encoded TS string literal `valueCode` from `Enum<...>` back to its runtime String text. */
pub decodeEnumCaseString := fn(valueCode: String): String {
    size := valueCode.length();
    if size < 2 or valueCode.at(0) =!= "\"" or valueCode.at(size - 1) =!= "\"" {
        return valueCode;
    }
    mut out: tb.TextBuilder;
    var i := 1;
    limit := size - 1;
    loop i < limit {
        ch := valueCode.at(i);
        if ch == "\\" and i + 1 < limit {
            esc := valueCode.at(i + 1);
            if esc == "n" { mut out.append("\n"); i += 2; continue; }
            if esc == "r" { mut out.append("\r"); i += 2; continue; }
            if esc == "t" { mut out.append("\t"); i += 2; continue; }
            if esc == "\"" { mut out.append("\""); i += 2; continue; }
            if esc == "\\" { mut out.append("\\"); i += 2; continue; }
            if esc == "u" and i + 5 < limit {
                hex := valueCode.slice(i + 2, i + 6);
                uCh := match {
                    hex == "003c" { "<" }
                    hex == "003e" { ">" }
                    hex == "0028" { "(" }
                    hex == "0029" { ")" }
                    hex == "005b" { "[" }
                    hex == "005d" { "]" }
                    _ { "" }
                };
                if uCh =!= "" {
                    mut out.append(uCh);
                    i += 6;
                    continue;
                }
            }
            mut out.append(esc);
            i += 2;
        } else {
            mut out.append(ch);
            i += 1;
        }
    }
    out.build()
};

/** Decodes a canonical enum integer backing `valueCode` (`10n`, `(-2n)`, etc.) into its sign, digit string, and signed Int value. */
pub decodeEnumCaseInt := fn(valueCode: String): (ok: Bool, neg: Bool, digits: String, value: Int) {
    var s := valueCode;
    var neg := false;
    if s.startsWithAt(0, "(-") and s.endsWith("n)") and s.length() >= 4 {
        s = s.slice(2, s.length() - 2);
        neg = true;
    } else if s.endsWith("n") and s.length() >= 2 {
        s = s.slice(0, s.length() - 1);
        if s.startsWithAt(0, "-") {
            s = s.slice(1, s.length());
            neg = true;
        }
    } else {
        return (ok = false, neg = false, digits = "", value = 0);
    }
    if s == "" { return (ok = false, neg = false, digits = "", value = 0); }
    val := if neg and s == "9223372036854775808" {
        -9223372036854775808
    } else {
        mag := syntax.parseDigits(s, 0, s.length());
        if neg { 0 - mag } else { mag }
    };
    (ok = true, neg = neg, digits = s, value = val)
};

/** Extracts `(neg, digits)` from an encoded enum Float* backing `valueCode`. */
pub decodeEnumCaseFloatToken := fn(valueCode: String): (neg: Bool, digits: String) {
    var s := valueCode;
    var neg := false;
    if s.startsWithAt(0, "(") and s.endsWith(")") {
        s = s.slice(1, s.length() - 1);
    }
    if s.startsWithAt(0, "-") {
        neg = true;
        s = s.slice(1, s.length());
    }
    if s.startsWithAt(0, "Math.fround(") and s.endsWith(")") {
        s = s.slice(12, s.length() - 1);
    } else if s.startsWithAt(0, "Math.f16round(") and s.endsWith(")") {
        s = s.slice(14, s.length() - 1);
    } else if s.startsWithAt(0, "lite$f8Round(") and s.endsWith(", 0)") {
        s = s.slice(13, s.length() - 4);
    }
    if s.startsWithAt(0, "Number(\"") and s.endsWith("\")") {
        s = s.slice(8, s.length() - 2);
    }
    (neg = neg, digits = s)
};

/** True when `kind` is this compiler's canonical nominal or structural anonymous record kind `Record<...;...>`. */
pub isRecordKind := fn(kind: String): Bool {
    size := kind.length();
    size > 8 and kind.startsWithAt(0, "Record<") and kind.at(size - 1) == ">"
};

/** True when `kind` is a standalone structural anonymous record `Record<$anon;...>`. */
pub isAnonRecordKind := fn(kind: String): Bool {
    isRecordKind(kind) and kind.startsWithAt(7, "$anon;")
};

/** True when `label` can appear directly as a clean unescaped canonical record field key. */
pub isSimpleRecordFieldIdent := fn(label: String): Bool {
    if label == "" or label.startsWithAt(0, "$") { return false; }
    if not label.at(0).isNameStart() { return false; }
    label.skipName(0) == label.length()
};

hexByte2 := fn(b: Int): String {
    hex := "0123456789abcdef";
    hi := (b / 16) % 16;
    lo := b % 16;
    hex.at(hi) + hex.at(lo)
};

hexVal1 := fn(ch: String): Int {
    if ch == "0" { 0 } else if ch == "1" { 1 } else if ch == "2" { 2 } else if ch == "3" { 3 }
    else if ch == "4" { 4 } else if ch == "5" { 5 } else if ch == "6" { 6 } else if ch == "7" { 7 }
    else if ch == "8" { 8 } else if ch == "9" { 9 } else if ch == "a" { 10 } else if ch == "b" { 11 }
    else if ch == "c" { 12 } else if ch == "d" { 13 } else if ch == "e" { 14 } else if ch == "f" { 15 }
    else { -1 }
};

/** Encodes a record field label into a delimiter-safe canonical field key (`raw` or `$k_<utf8hex>`). */
pub encodeRecordFieldLabel := fn(rawLabel: String): String {
    if isSimpleRecordFieldIdent(rawLabel) { return rawLabel; }
    mut out: tb.TextBuilder;
    mut out.append("$k_");
    loop rawLabel.utf8Encode() as b {
        mut out.append(hexByte2(b));
    }
    out.build()
};

/** Decodes an encoded record field key back into its source field label. */
pub decodeRecordFieldLabel := fn(encLabel: String): String {
    if not encLabel.startsWithAt(0, "$k_") { return encLabel; }
    mut bytes: List<Int> = [];
    var i := 3;
    len := encLabel.length();
    loop i + 1 < len {
        hi := hexVal1(encLabel.at(i));
        lo := hexVal1(encLabel.at(i + 1));
        if hi < 0 or lo < 0 { return encLabel; }
        mut bytes.pushBack(hi * 16 + lo);
        i = i + 2;
    }
    res := String.fromUtf8Strict(bytes);
    if res.ok { res.text } else { encLabel }
};

/** Builds a canonical key-sorted structural anonymous record kind `Record<$anon;f1:K1,...>`. */
pub buildAnonRecordKind := fn(fields: List<(label: String, kind: String)>): String {
    n := fields.length();
    if n == 0 { return "Record<$anon;>"; }
    mut sorted := fields;
    var i := 0;
    loop i < n {
        var minIdx := i;
        var j := i + 1;
        loop j < n {
            if sorted[j].label.compare(sorted[minIdx].label) < 0 {
                minIdx = j;
            }
            j = j + 1;
        }
        if minIdx =!= i {
            tmp := sorted[i];
            mut sorted.setAt(i, sorted[minIdx]);
            mut sorted.setAt(minIdx, tmp);
        }
        i = i + 1;
    }
    mut parts: List<String> = [];
    loop sorted as f {
        mut parts.pushBack(encodeRecordFieldLabel(f.label) + ":" + f.kind);
    }
    "Record<$anon;" + parts.join(",") + ">"
};

/** Returns true when `label` is safe to write unquoted as a JS/TS property name (`obj.label`). */
isJsSimpleIdent := fn(label: String): Bool {
    if label == "" or label == "__proto__" or label == "constructor" { return false; }
    c0 := label.at(0);
    if not (c0.isAsciiLetter() or c0 == "_") { return false; }
    var i := 1;
    len := label.length();
    loop i < len {
        ch := label.at(i);
        if not (ch.isAsciiLetter() or ch.isDigit() or ch == "_") { return false; }
        i = i + 1;
    }
    true
};

/** Formats a record field label as a TS object-literal or interface property key. */
pub tsRecordPropKey := fn(label: String): String {
    if isJsSimpleIdent(label) { label } else { tsLiteral.textLiteralCode(label) }
};

/** Formats a TS property read expression for field `label` on `objCode`. */
pub tsRecordFieldAccess := fn(objCode: String, label: String): String {
    if isJsSimpleIdent(label) { objCode + "." + label } else { objCode + "[" + tsLiteral.textLiteralCode(label) + "]" }
};

/** Finds the top-level `;` separating header metadata from fields in `Record<id#at#Name[<...>];...>`, or -1 when malformed. */
recordHeaderSemi := fn(kind: String): Int {
    if not isRecordKind(kind) { return -1; }
    size := kind.length();
    var cursor := 7;
    var depth := 0;
    loop cursor < size - 1 {
        ch := kind.at(cursor);
        if ch == "<" or ch == "(" or ch == "[" {
            depth = depth + 1;
        } else if ch == ">" or ch == ")" or ch == "]" {
            if depth > 0 { depth = depth - 1; }
        } else if ch == ";" and depth == 0 {
            return cursor;
        }
        cursor = cursor + 1;
    }
    -1
};

/** Returns the source declaration display name from canonical `Record<id#at#DisplayName[<...>];...>`, or anonymous record shape. */
pub recordDisplayName := fn(kind: String): String {
    if isAnonRecordKind(kind) {
        fc := recordComponentCount(kind);
        if fc == 0 { return "{}"; }
        mut parts: List<String> = [];
        var fi := 0;
        loop fi < fc {
            comp := recordComponent(kind, fi);
            keyTxt := if isSimpleRecordFieldIdent(comp.label) { comp.label } else { "\"" + comp.label + "\"" };
            mut parts.pushBack(keyTxt + ": " + displayKind(comp.kind));
            fi = fi + 1;
        }
        return "{ " + parts.join(", ") + " }";
    }
    semi := recordHeaderSemi(kind);
    if semi <= 7 { return kind; }
    headerDisplayName(kind.slice(7, semi))
};

/** Returns the source declaration character offset encoded inside `Record<id#at#DisplayName[<...>];...>`, or -1 when absent. */
pub recordDeclAt := fn(kind: String): Int {
    semi := recordHeaderSemi(kind);
    if semi <= 7 { return -1; }
    hdr := kind.slice(7, semi);
    baseEnd := headerBaseEnd(hdr);
    var secondHash := baseEnd - 1;
    loop secondHash >= 0 and hdr.at(secondHash) =!= "#" {
        secondHash = secondHash - 1;
    }
    if secondHash <= 0 { return -1; }
    var firstHash := secondHash - 1;
    loop firstHash >= 0 and hdr.at(firstHash) =!= "#" {
        firstHash = firstHash - 1;
    }
    if firstHash < 0 or firstHash + 1 >= secondHash { return -1; }
    syntax.parseDigits(hdr, firstHash + 1, secondHash)
};

/** Parses and caches all declared fields of a canonical nominal record kind `Record<...>`. */
cachedRecordComponents := fn(kind: String): List<ComponentInfo> {
    cached := componentsCache.get(kind);
    if cached.found { return cached.value; }
    mut out: List<ComponentInfo> = [];
    semi := recordHeaderSemi(kind);
    if semi >= 0 {
        end := kind.length() - 1;
        var cursor := semi + 1;
        var index := 0;
        loop cursor < end {
            nameStart := cursor;
            cursor = if kind.at(cursor) == "$" { kind.skipName(cursor + 1) } else { kind.skipName(cursor) };
            encLabel := kind.slice(nameStart, cursor);
            label := decodeRecordFieldLabel(encLabel);
            if cursor < end and kind.at(cursor) == ":" { cursor = cursor + 1; }
            typeStart := cursor;
            cursor = skipKindToken(kind, cursor);
            fieldKind := kind.slice(typeStart, cursor);
            propName := if encLabel.startsWithAt(0, "$k_") { encLabel } else { tupleRuntimeProp(label, index) };
            mut out.pushBack(ComponentInfo { label = label, kind = fieldKind, prop = propName });
            index = index + 1;
            if cursor < end and kind.at(cursor) == "," { cursor = cursor + 1; }
        }
    }
    (mut componentsCache).set(kind, out);
    out
};

/** Returns the runtime JS property name for field `label` inside nominal record `kind`, or `""` when absent. */
pub recordComponentProp := fn(kind: String, label: String): String {
    if label == "" or not isRecordKind(kind) { return ""; }
    comps := cachedRecordComponents(kind);
    n := comps.length();
    var i := 0;
    loop i < n {
        c := comps[i];
        if c.label == label { return c.prop; }
        i = i + 1;
    }
    ""
};

/** Returns the number of declared fields in canonical record kind `kind`. */
pub recordComponentCount := fn(kind: String): Int {
    if not isRecordKind(kind) { return 0; }
    cachedRecordComponents(kind).length()
};

/** Returns `(label, kind, prop)` for field `targetIndex` in canonical record kind `kind`. */
pub recordComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) {
    comps := cachedRecordComponents(kind);
    if targetIndex < 0 or targetIndex >= comps.length() {
        return (label = "", kind = "", prop = "");
    }
    c := comps[targetIndex];
    (label = c.label, kind = c.kind, prop = c.prop)
};

/** Returns the canonical field kind for `label` inside nominal record `kind`, or `""` when absent. */
pub recordFieldKind := fn(kind: String, label: String): String {
    if label == "" or not isRecordKind(kind) { return ""; }
    comps := cachedRecordComponents(kind);
    n := comps.length();
    var i := 0;
    loop i < n {
        c := comps[i];
        if c.label == label { return c.kind; }
        i = i + 1;
    }
    ""
};

/** Prefixes a tuple/record runtime property name with `f_` for C11 struct members so C keywords and non-ASCII names never collide. */
pub cFieldName := fn(prop: String): String {
    "f_" + ir.cSafeIdent(prop)
};

/** Deterministic dual-prime hash of canonical kind string `kind` for C11 struct typedef names. */
cStructHash := fn(kind: String): String {
    table := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_():,;<>#[]!@$-./=";
    var h1 := 5381;
    var h2 := 216613626;
    size := kind.length();
    var i := 0;
    loop i < size {
        ch := kind.at(i);
        idx := table.indexOf(ch, 0);
        v := if idx >= 0 { idx + 1 } else { 97 + ch.codePointAt(0) };
        h1 = (h1 * 131 + v) % 1000000007;
        h2 = (h2 * 137 + v) % 1000000009;
        i = i + 1;
    }
    h1.toText() + "_" + h2.toText()
};

/* Canonical type metadata memoization caches (keyed by canonical kind string). */
mut cSupportedCache: Map<String, Bool>;
mut cFnTagCache: Map<String, String>;
mut cStructTagCache: Map<String, String>;
mut cArrayTagCache: Map<String, String>;
mut cHasListCache: Map<String, Bool>;
mut cNeedsDropCache: Map<String, Bool>;
mut cValueTypeCache: Map<String, String>;
mut containsFnCache: Map<String, Bool>;
mut tsTypeCache: Map<String, String>;

/** True when `kind` is a C11-supported value kind (scalar, enum, struct, map, set, or list/array of supported elements). */
cIsSupportedElem := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if numeric.isIntKind(kind) or (isEnumKind(kind) and not isPayloadEnumKind(kind)) or numeric.isFloatKind(kind) or
    kind == ir.VALUE_KIND_BOOL or kind == ir.VALUE_KIND_STRING { return true; }
    cached := cSupportedCache.get(kind);
    if cached.found { return cached.value; }
    var ok := false;
    if isListKind(kind) { ok = self(listElementKind(kind)); }
    else if isArrayKind(kind) { ok = self(arrayElementKind(kind)); }
    else if isMapKind(kind) { ok = isMapKeyKind(mapKeyKind(kind)) and self(mapValueKind(kind)); }
    else if isSetKind(kind) { ok = isMapKeyKind(setElementKind(kind)); }
    else if isRcKind(kind) { ok = self(rcElementKind(kind)); }
    else if isSliceKind(kind) { ok = cListTag(sliceElementKind(kind)) =!= ""; }
    else if isDynKind(kind) { ok = true; }
    else if isSimdKind(kind) { ok = isValidSimdLaneCount(simdElementKind(kind), simdLaneCount(kind)); }
    else if isSoaKind(kind) {
        rk := soaRecordKind(kind);
        ok = isRecordKind(rk) and recordComponentCount(rk) > 0 and self(rk);
    }
    else if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        ok = true;
        var i := 0;
        loop i < count {
            if not self(tupleComponent(kind, i).kind) { ok = false; break; }
            i = i + 1;
        }
    } else if isRecordKind(kind) {
        count := recordComponentCount(kind);
        ok = true;
        var i := 0;
        loop i < count {
            if not self(recordComponent(kind, i).kind) { ok = false; break; }
            i = i + 1;
        }
    } else if isPayloadEnumKind(kind) {
        count := enumCaseCount(kind);
        ok = true;
        var ci := 0;
        loop ci < count and ok {
            loop enumCasePayloads(kind, ci) as pk {
                if not self(pk) { ok = false; break; }
            }
            ci = ci + 1;
        }
    } else if isUnionKind(kind) {
        ok = true;
        loop unionMembers(kind) as um {
            if um =!= ir.VALUE_KIND_UNIT and not self(um) { ok = false; break; }
        }
    } else if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        ok = (okK == ir.VALUE_KIND_UNIT or self(okK)) and (errK == ir.VALUE_KIND_UNIT or self(errK));
    } else if isFnKind(kind) {
        pCount := fnParamCount(kind);
        var paramsOk := true;
        var pi := 0;
        loop pi < pCount {
            rawPK := fnParamComponent(kind, pi).kind;
            basePK := if rawPK.startsWithAt(0, "mut ") { rawPK.slice(4, rawPK.length()) } else { rawPK };
            if not self(basePK) { paramsOk = false; break; }
            pi = pi + 1;
        }
        fnCtx := fnContextKind(kind);
        if paramsOk and fnCtx =!= "" {
            paramsOk = self(fnCtx);
        }
        if paramsOk {
            rKind := fnResultKind(kind);
            ok = rKind == ir.VALUE_KIND_UNIT or rKind == ir.VALUE_KIND_NEVER or self(rKind);
        }
    } else if isCtxKind(kind) {
        ok = true;
        loop contexts.parseCtxKindSlots(kind) as cs {
            if not self(cs.kind) { ok = false; break; }
        }
    }
    (mut cSupportedCache).set(kind, ok);
    ok
};

/** Maps a C-supported function value kind to its parameter-name-erased C11 typedef name `lt_fnv_...`, or `""` if unsupported. */
pub cFnTag := fn(kind: String): String {
    if not isFnKind(kind) { return ""; }
    cached := cFnTagCache.get(kind);
    if cached.found { return cached.value; }
    if not cIsSupportedElem(kind) {
        mut cFnTagCache.set(kind, "");
        return "";
    }
    pCount := fnParamCount(kind);
    mut sigBuf: tb.TextBuilder;
    mut sigBuf.append("fn(");
    var i := 0;
    loop i < pCount {
        if i > 0 { mut sigBuf.append(","); }
        if fnParamIsOptional(kind, i) { mut sigBuf.append("?"); }
        mut sigBuf.append(fnParamComponent(kind, i).kind);
        i = i + 1;
    }
    mut sigBuf.append(")");
    fnCtx := fnContextKind(kind);
    if fnCtx =!= "" { mut sigBuf.append(fnAtCtxSuffix(fnCtx)); }
    mut sigBuf.append(":");
    mut sigBuf.append(fnResultKind(kind));
    sig := sigBuf.build();
    tag := "lt_fnv_" + cStructHash(sig);
    mut cFnTagCache.set(kind, tag);
    tag
};

/** Maps a C-supported tuple, nominal record, payload enum, union, or result kind to its deterministic C11 typedef name `lt_s_...`, or `""` if unsupported. */
pub cStructTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isTupleKind(kind) and not isRecordKind(kind) and not isPayloadEnumKind(kind) and not isUnionKind(kind) and not isResultKind(kind) { return ""; }
    cached := cStructTagCache.get(kind);
    if cached.found { return cached.value; }
    tag := if cIsSupportedElem(kind) { "lt_s_" + cStructHash(kind) } else { "" };
    mut cStructTagCache.set(kind, tag);
    tag
};

/** True when `kind` is a list/wildcard-array/map/set/rc/soa or a fixed array/tuple/record/payload-enum/union/result transitively containing one. */
pub cTypeHasListField := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if isListKind(kind) or isMapKind(kind) or isSetKind(kind) or isRcKind(kind) or isSoaKind(kind) { return true; }
    if isArrayKind(kind) {
        return if arrayExtent(kind) < 0 { true } else { self(arrayElementKind(kind)) };
    }
    if not isTupleKind(kind) and not isRecordKind(kind) and not isPayloadEnumKind(kind) and not isUnionKind(kind) and not isResultKind(kind) { return false; }
    cached := cHasListCache.get(kind);
    if cached.found { return cached.value; }
    var res := false;
    if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var i := 0;
        loop i < count {
            if self(tupleComponent(kind, i).kind) { res = true; break; }
            i = i + 1;
        }
    } else if isRecordKind(kind) {
        count := recordComponentCount(kind);
        var i := 0;
        loop i < count {
            if self(recordComponent(kind, i).kind) { res = true; break; }
            i = i + 1;
        }
    } else if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(um) { res = true; break; }
        }
    } else if isResultKind(kind) {
        res = self(resultOkKind(kind)) or self(resultErrKind(kind));
    } else {
        count := enumCaseCount(kind);
        var ci := 0;
        loop ci < count and not res {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { res = true; break; }
            }
            ci = ci + 1;
        }
    }
    (mut cHasListCache).set(kind, res);
    res
};

/** True when C11 representation of `kind` owns heap memory or closure environments requiring drop/copy (`List`, `Map`, `Set`, `Rc`, `SoA`, `fn`, or composites containing them). */
pub cTypeNeedsDrop := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if isListKind(kind) or isMapKind(kind) or isSetKind(kind) or isRcKind(kind) or isSoaKind(kind) or isFnKind(kind) { return true; }
    if isArrayKind(kind) {
        return if arrayExtent(kind) < 0 { true } else { self(arrayElementKind(kind)) };
    }
    if not isTupleKind(kind) and not isRecordKind(kind) and not isPayloadEnumKind(kind) and not isUnionKind(kind) and not isResultKind(kind) { return false; }
    cached := cNeedsDropCache.get(kind);
    if cached.found { return cached.value; }
    var res := false;
    if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var i := 0;
        loop i < count {
            if self(tupleComponent(kind, i).kind) { res = true; break; }
            i = i + 1;
        }
    } else if isRecordKind(kind) {
        count := recordComponentCount(kind);
        var i := 0;
        loop i < count {
            if self(recordComponent(kind, i).kind) { res = true; break; }
            i = i + 1;
        }
    } else if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if um =!= ir.VALUE_KIND_UNIT and self(um) { res = true; break; }
        }
    } else if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        res = (okK =!= ir.VALUE_KIND_UNIT and self(okK)) or (errK =!= ir.VALUE_KIND_UNIT and self(errK));
    } else {
        count := enumCaseCount(kind);
        var ci := 0;
        loop ci < count and not res {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { res = true; break; }
            }
            ci = ci + 1;
        }
    }
    (mut cNeedsDropCache).set(kind, res);
    res
};

/** True when a non-`mut` parameter of `kind` is passed by `const *` borrow in C11. */
pub cParamIsConstPtr := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    isListKind(kind) or (isArrayKind(kind) and cArrayTag(kind) == "") or isMapKind(kind) or isSetKind(kind) or isSoaKind(kind) or cStructTag(kind) =!= ""
};

/** Returns the C11 `_drop` helper name for `kind`, or `""` when `kind` has trivial value semantics. */
pub cDropFnForKind := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if isListKind(kind) or (isArrayKind(kind) and cArrayTag(kind) == "") {
        elKind := if isListKind(kind) { listElementKind(kind) } else { arrayElementKind(kind) };
        lt := cListTag(elKind);
        if lt =!= "" { "lt_list_" + lt + "_drop" } else { "" }
    } else if cMapTag(kind) =!= "" {
        cMapTag(kind) + "_drop"
    } else if cSetTag(kind) =!= "" {
        cSetTag(kind) + "_drop"
    } else if cRcTag(kind) =!= "" {
        cRcTag(kind) + "_drop"
    } else if cSoaTag(kind) =!= "" {
        cSoaTag(kind) + "_drop"
    } else if cArrayTag(kind) =!= "" and cTypeNeedsDrop(kind) {
        cArrayTag(kind) + "_drop"
    } else if cStructTag(kind) =!= "" and cTypeNeedsDrop(kind) {
        cStructTag(kind) + "_drop"
    } else if cFnTag(kind) =!= "" {
        cFnTag(kind) + "_drop"
    } else {
        ""
    }
};

/** Returns the C11 `_move` helper name for `kind`, or `""` when `kind` has trivial value semantics. */
pub cMoveFnForKind := fn(kind: String): String {
    d := cDropFnForKind(kind);
    if d.endsWith("_drop") { d.slice(0, d.length() - 5) + "_move" } else { "" }
};

/** Returns the C11 `_copy` helper name for `kind`, or `""` when `kind` is trivially copyable. */
pub cCopyFnForKind := fn(kind: String): String {
    d := cDropFnForKind(kind);
    if d.endsWith("_drop") { d.slice(0, d.length() - 5) + "_copy" } else { "" }
};

/** Maps a plain `enum` kind to its C11 backing storage type, tag, and maximum representable case count (`maxCases`). */
pub plainEnumCStorage := fn(kind: String): (cType: String, cTag: String, maxCases: Int) {
    if not isEnumKind(kind) or isPayloadEnumKind(kind) {
        return (cType = "int64_t", cTag = "i64", maxCases = 9223372036854775807);
    }
    bk := enumBackingKind(kind);
    if bk == ir.VALUE_KIND_INT1 or bk == ir.VALUE_KIND_UINT1 { (cType = "uint8_t", cTag = "u8", maxCases = 2) }
    else if bk == ir.VALUE_KIND_INT2 or bk == ir.VALUE_KIND_UINT2 { (cType = "uint8_t", cTag = "u8", maxCases = 4) }
    else if bk == ir.VALUE_KIND_INT4 or bk == ir.VALUE_KIND_UINT4 { (cType = "uint8_t", cTag = "u8", maxCases = 16) }
    else if bk == ir.VALUE_KIND_INT8 or bk == ir.VALUE_KIND_UINT8 { (cType = "uint8_t", cTag = "u8", maxCases = 256) }
    else if bk == ir.VALUE_KIND_INT16 or bk == ir.VALUE_KIND_UINT16 { (cType = "uint16_t", cTag = "u16", maxCases = 65536) }
    else if bk == ir.VALUE_KIND_INT32 or bk == ir.VALUE_KIND_UINT32 { (cType = "uint32_t", cTag = "u32", maxCases = 4294967296) }
    else if bk == ir.VALUE_KIND_BOOL { (cType = "int64_t", cTag = "i64", maxCases = 2) }
    else { (cType = "int64_t", cTag = "i64", maxCases = 9223372036854775807) }
};

/** Maps a scalar or payload-free enum kind to its canonical C11 width tag (`i1..i64`, `u1..u64`, `f8..f64`, `bool`, `str`), or `""`. */
cScalarTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if kind == ir.VALUE_KIND_INT1 { "i1" }
    else if kind == ir.VALUE_KIND_INT2 { "i2" }
    else if kind == ir.VALUE_KIND_INT4 { "i4" }
    else if kind == ir.VALUE_KIND_INT8 { "i8" }
    else if kind == ir.VALUE_KIND_INT16 { "i16" }
    else if kind == ir.VALUE_KIND_INT32 { "i32" }
    else if isEnumKind(kind) and not isPayloadEnumKind(kind) { plainEnumCStorage(kind).cTag }
    else if kind == ir.VALUE_KIND_INT { "i64" }
    else if kind == ir.VALUE_KIND_UINT1 { "u1" }
    else if kind == ir.VALUE_KIND_UINT2 { "u2" }
    else if kind == ir.VALUE_KIND_UINT4 { "u4" }
    else if kind == ir.VALUE_KIND_UINT8 { "u8" }
    else if kind == ir.VALUE_KIND_UINT16 { "u16" }
    else if kind == ir.VALUE_KIND_UINT32 { "u32" }
    else if kind == ir.VALUE_KIND_UINT64 { "u64" }
    else if kind == ir.VALUE_KIND_FLOAT8 { "f8" }
    else if kind == ir.VALUE_KIND_FLOAT16 { "f16" }
    else if kind == ir.VALUE_KIND_FLOAT32 { "f32" }
    else if kind == ir.VALUE_KIND_FLOAT { "f64" }
    else if kind == ir.VALUE_KIND_BOOL { "bool" }
    else if kind == ir.VALUE_KIND_STRING { "str" }
    else { "" }
};

/** Maps a C-supported `Rc<T>` kind to its C11 pointer-sized typedef name `lt_rc_<tag>`, or `""`. */
pub cRcTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isRcKind(kind) { return ""; }
    el := rcElementKind(kind);
    if not cIsSupportedElem(el) { return ""; }
    elBase := distinctBaseKind(el);
    s := cScalarTag(elBase);
    if s =!= "" { "lt_rc_" + s } else { "lt_rc_" + cStructHash(elBase) }
};

/** Maps a C-supported `Slice<T>` kind to its C11 16-byte view struct typedef `lt_slice_<tag>`, or `""`. */
pub cSliceTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isSliceKind(kind) { return ""; }
    el := sliceElementKind(kind);
    lt := cListTag(el);
    if lt =!= "" { "lt_slice_" + lt } else { "" }
};

/** Maps a non-array C-supported list element kind (scalar, enum, tuple, record, payload enum, rc, or fn) to its canonical C11 tag. */
cNonArrayListTag := fn(elemKind: String): String {
    if isDistinctKind(elemKind) { return self(distinctBaseKind(elemKind)); }
    sTag := cScalarTag(elemKind);
    if sTag =!= "" { sTag }
    else if isRcKind(elemKind) { cRcTag(elemKind) }
    else if isSimdKind(elemKind) { cSimdTag(elemKind) }
    else if isSoaKind(elemKind) { cSoaTag(elemKind) }
    else if isTupleKind(elemKind) or isRecordKind(elemKind) or isPayloadEnumKind(elemKind) or isUnionKind(elemKind) or isResultKind(elemKind) { cStructTag(elemKind) }
    else if isFnKind(elemKind) { cFnTag(elemKind) }
    else { "" }
};

/** Maps a C-supported map/set key kind to its C11 tag (`i1..i64`, `u1..u64`, `f8..f64`, `bool`, `str`), or `""`. */
pub cMapKeyTag := fn(kKind: String): String {
    if isDistinctKind(kKind) { return self(distinctBaseKind(kKind)); }
    cScalarTag(kKind)
};

/** Maps a concrete fixed-size `[T; N]` array kind to its inline C11 struct typedef name `lt_arr_<elemTag>_<N>`, or `""` for non-arrays, `[T; *]`, or unsupported element types. */
pub cArrayTag := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if not isArrayKind(kind) { return ""; }
    ext := arrayExtent(kind);
    if ext < 0 { return ""; }
    cached := cArrayTagCache.get(kind);
    if cached.found { return cached.value; }
    elKind := arrayElementKind(kind);
    baseTag := cNonArrayListTag(elKind);
    elTag := if baseTag =!= "" { baseTag }
    else if isArrayKind(elKind) { self(elKind) }
    else if isListKind(elKind) {
        inK := listElementKind(elKind);
        inTag := if isArrayKind(inK) { self(inK) } else { cNonArrayListTag(inK) };
        if inTag =!= "" { "lt_list_" + inTag } else { "" }
    } else if isSetKind(elKind) {
        kTag := cMapKeyTag(setElementKind(elKind));
        if kTag =!= "" { "lt_set_" + kTag } else { "" }
    } else if isMapKind(elKind) {
        kTag := cMapKeyTag(mapKeyKind(elKind));
        vKind := mapValueKind(elKind);
        vBase := cNonArrayListTag(vKind);
        vTag := if vBase =!= "" { vBase }
        else if isArrayKind(vKind) and self(vKind) =!= "" { self(vKind) }
        else if isListKind(vKind) {
            vin := listElementKind(vKind);
            vinTag := if isArrayKind(vin) { self(vin) } else { cNonArrayListTag(vin) };
            if vinTag =!= "" { "list_" + vinTag } else { "" }
        } else if isArrayKind(vKind) {
            vin := arrayElementKind(vKind);
            vinTag := if isArrayKind(vin) { self(vin) } else { cNonArrayListTag(vin) };
            if vinTag =!= "" { "list_" + vinTag } else { "" }
        } else { "" };
        if kTag =!= "" and vTag =!= "" { "lt_map_" + kTag + "_" + vTag } else { "" }
    } else { "" };
    tag := if elTag =!= "" { "lt_arr_" + elTag + "_" + ext.toText() } else { "" };
    mut cArrayTagCache.set(kind, tag);
    tag
};

/** Maps a C-supported list element kind (scalar, enum, tuple, record, payload enum, fn, or fixed array) to its canonical C11 list tag, or `""` if unsupported. */
pub cListTag := fn(elemKind: String): String {
    if isDistinctKind(elemKind) { return self(distinctBaseKind(elemKind)); }
    base := cNonArrayListTag(elemKind);
    if base =!= "" { base }
    else if isArrayKind(elemKind) { cArrayTag(elemKind) }
    else { "" }
};

/** Maps a canonical C11 list/scalar tag (`i1..i64`, `u1..u64`, `f8..f64`, `bool`, `str`, `lt_s_...`, or `lt_arr_...`) to its C11 element type name. */
pub cListElemType := fn(tag: String): String {
    if tag == "i1" or tag == "i2" or tag == "i4" or tag == "i8" { "int8_t" }
    else if tag == "i16" { "int16_t" }
    else if tag == "i32" { "int32_t" }
    else if tag == "i64" { "int64_t" }
    else if tag == "u1" or tag == "u2" or tag == "u4" or tag == "u8" { "uint8_t" }
    else if tag == "u16" { "uint16_t" }
    else if tag == "u32" { "uint32_t" }
    else if tag == "u64" { "uint64_t" }
    else if tag == "f8" { "uint8_t" }
    else if tag == "f16" { "lt_f16" }
    else if tag == "f32" { "float" }
    else if tag == "f64" { "double" }
    else if tag == "bool" { "bool" }
    else if tag == "str" { "lt_str" }
    else { tag }
};

/** Maps a C-supported map value kind to its C11 value tag, or `""`. */
pub cMapValTag := fn(vKind: String): String {
    lt := cListTag(vKind);
    if lt =!= "" { return lt; }
    if isListKind(vKind) and cListTag(listElementKind(vKind)) =!= "" { return "list_" + cListTag(listElementKind(vKind)); }
    if isArrayKind(vKind) and cArrayTag(vKind) == "" and cListTag(arrayElementKind(vKind)) =!= "" { return "list_" + cListTag(arrayElementKind(vKind)); }
    ""
};

/** Maps a C-supported `Map<K, V>` kind to its C11 typedef name `lt_map_<kt>_<vt>`, or `""`. */
pub cMapTag := fn(kind: String): String {
    if not isMapKind(kind) { return ""; }
    kt := cMapKeyTag(mapKeyKind(kind));
    vt := cMapValTag(mapValueKind(kind));
    if kt =!= "" and vt =!= "" { "lt_map_" + kt + "_" + vt } else { "" }
};

/** Maps a C-supported `Set<T>` kind to its C11 typedef name `lt_set_<kt>`, or `""`. */
pub cSetTag := fn(kind: String): String {
    if not isSetKind(kind) { return ""; }
    kt := cMapKeyTag(setElementKind(kind));
    if kt =!= "" { "lt_set_" + kt } else { "" }
};

/** Maps any C11-supported Lite value kind to its C11 type name. */
pub cValueType := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    sTag := cScalarTag(kind);
    if sTag =!= "" { return cListElemType(sTag); }
    if kind == ir.VALUE_KIND_UNIT or kind == ir.VALUE_KIND_NEVER { return "void"; }
    cached := cValueTypeCache.get(kind);
    if cached.found { return cached.value; }
    res := if isListKind(kind) { "lt_list_" + cListTag(listElementKind(kind)) }
    else if cArrayTag(kind) =!= "" { cArrayTag(kind) }
    else if isArrayKind(kind) { "lt_list_" + cListTag(arrayElementKind(kind)) }
    else if cMapTag(kind) =!= "" { cMapTag(kind) }
    else if cSetTag(kind) =!= "" { cSetTag(kind) }
    else if cRcTag(kind) =!= "" { cRcTag(kind) }
    else if cSliceTag(kind) =!= "" { cSliceTag(kind) }
    else if cDynTag(kind) =!= "" { cDynTag(kind) }
    else if cSimdTag(kind) =!= "" { cSimdTag(kind) }
    else if cSoaTag(kind) =!= "" { cSoaTag(kind) }
    else if cStructTag(kind) =!= "" { cStructTag(kind) }
    else if cCtxTag(kind) =!= "" { cCtxTag(kind) }
    else if cFnTag(kind) =!= "" { cFnTag(kind) }
    else { "lt_str" };
    mut cValueTypeCache.set(kind, res);
    res
};

/** Returns the C11 tuple-label conversion helper name for converting `actualKind` to `expectedKind`. */
pub cTupleConvertName := fn(expectedKind: String, actualKind: String): String {
    "lt_conv_" + cStructTag(expectedKind) + "_from_" + cStructTag(actualKind)
};

/** Converts one tuple expression to `expectedKind` for the given backend `target`. */
pub convertTupleValueForTarget := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    if target == ir.TARGET_C and cStructTag(expectedKind) =!= "" and cStructTag(actualKind) =!= "" {
        "/*@C:" + expectedKind + "|" + actualKind + "@*/" + cTupleConvertName(expectedKind, actualKind) + "(" + actualCode + ")"
    } else {
        convertTupleValue(expectedKind, actualKind, actualCode)
    }
};

/** Encodes `text` using `<length>:<text>` so serialized record defaults and raw types never collide with delimiters. */
pub encodeLengthPrefixedText := fn(text: String): String {
    text.length().toText() + ":" + text
};

/** Reads one `<length>:<text>` chunk starting at `start` inside `encoded`. */
pub decodeLengthPrefixedAt := fn(encoded: String, start: Int): (text: String, next: Int) {
    size := encoded.length();
    var cursor := start;
    loop cursor < size and encoded.at(cursor).isDigit() {
        cursor = cursor + 1;
    }
    if cursor == start or cursor >= size or encoded.at(cursor) =!= ":" {
        return (text = "", next = -1);
    }
    textLen := syntax.parseDigits(encoded, start, cursor);
    textStart := cursor + 1;
    textEnd := textStart + textLen;
    if textEnd > size { return (text = "", next = -1); }
    (text = encoded.slice(textStart, textEnd), next = textEnd)
};

/** Encodes parallel field names and values into `<count>;<len:k><len:v>...`. */
pub encodeRecordPairs := fn(keys: List<String>, values: List<String>): String {
    var count := 0;
    loop keys { count = count + 1; }
    if count == 0 { return ""; }
    mut out: tb.TextBuilder;
    mut out.append(count.toText());
    mut out.append(";");
    var idx := 0;
    loop idx < count {
        mut out.append(encodeLengthPrefixedText(keys[idx]));
        mut out.append(encodeLengthPrefixedText(values[idx]));
        idx = idx + 1;
    }
    out.build()
};

/** Looks up resolved declared default code for `field` of canonical `recordKind` inside `aliases`, or `""` when absent. */
pub findRecordDefaultCode := fn(aliases: List<AliasDecl>, recordKind: String, field: String): String {
    idx := findAlias(aliases, "$recdef:" + recordKind + "#" + field);
    if idx >= 0 { return aliases[idx].target; }
    ownerKey := typeOpOwnerKey(recordKind);
    if ownerKey =!= "" {
        ownerIdx := findAlias(aliases, "$recdef:" + ownerKey + "#" + field);
        if ownerIdx >= 0 { return aliases[ownerIdx].target; }
    }
    ""
};

/** Appends `$recpop:<recordKind>` and decoded `$recdef:<recordKind>#<field>` entries from serialized `encoded` defaults onto `aliases`. */
pub appendEncodedRecordDefaults := fn(aliases: List<AliasDecl>, recordKind: String, encoded: String, depth: Int): List<AliasDecl> {
    mut out: List<AliasDecl> = aliases;
    mut out.pushBack((name = "$recpop:" + recordKind, target = "1", at = -1, end = 0, depth = depth));
    if encoded == "" { return out; }
    size := encoded.length();
    var semi := 0;
    loop semi < size and encoded.at(semi).isDigit() {
        semi = semi + 1;
    }
    if semi == 0 or semi >= size or encoded.at(semi) =!= ";" { return out; }
    count := syntax.parseDigits(encoded, 0, semi);
    var cur := semi + 1;
    var idx := 0;
    loop idx < count {
        fName := decodeLengthPrefixedAt(encoded, cur);
        fCode := decodeLengthPrefixedAt(encoded, fName.next);
        if fName.next < 0 or fCode.next < 0 { break; }
        (mut out).pushBack((name = "$recdef:" + recordKind + "#" + fName.text, target = fCode.text, at = -1, end = 0, depth = depth));
        cur = fCode.next;
        idx = idx + 1;
    }
    out
};

/** Collects serialized `$recdef:<recordKind>#<field>` defaults currently in `aliases` for re-export via `pub Alias := alias Rec`. */
pub encodeRecordDefaultsFromAliases := fn(aliases: List<AliasDecl>, recordKind: String): String {
    if not isRecordKind(recordKind) { return ""; }
    count := recordComponentCount(recordKind);
    mut keys: List<String> = [];
    mut values: List<String> = [];
    var idx := 0;
    loop idx < count {
        comp := recordComponent(recordKind, idx);
        defCode := findRecordDefaultCode(aliases, recordKind, comp.label);
        if defCode =!= "" {
            mut keys.pushBack(comp.label);
            mut values.pushBack(defCode);
        }
        idx = idx + 1;
    }
    encodeRecordPairs(keys, values)
};

/** True when TS local/var declarations of `kind` require an explicit type annotation (empty lists, maps, arrays, records, enums, or callables). */
pub needsTsTypeAnnotation := fn(kind: String): Bool {
    isListKind(kind) or isMapKind(kind) or isSetKind(kind) or isSliceKind(kind) or isSimdKind(kind) or isSoaKind(kind) or isArrayKind(kind) or isRecordKind(kind) or isEnumKind(kind) or isDistinctKind(kind) or isUnionKind(kind) or isResultKind(kind) or containsFnKind(kind)
};

/** True when `expectedKind` and `actualKind` represent structurally identical kinds modulo callable/tuple parameter labels. */
pub exactShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if expectedKind == actualKind { return true; }
    if isCtxKind(expectedKind) and isCtxKind(actualKind) {
        eSlots := contexts.parseCtxKindSlots(expectedKind);
        aSlots := contexts.parseCtxKindSlots(actualKind);
        if eSlots.length() =!= aSlots.length() { return false; }
        var si := 0;
        loop si < eSlots.length() {
            es := eSlots[si];
            asSlot := aSlots[si];
            if es.name =!= asSlot.name or es.isMut =!= asSlot.isMut or not self(es.kind, asSlot.kind) {
                return false;
            }
            si = si + 1;
        }
        return true;
    }
    if isFnKind(expectedKind) and isFnKind(actualKind) {
        eCtx := fnContextKind(expectedKind);
        aCtx := fnContextKind(actualKind);
        if (eCtx == "" and aCtx =!= "") or (eCtx =!= "" and aCtx == "") { return false; }
        if eCtx =!= "" and not self(eCtx, aCtx) { return false; }
        count := fnParamCount(expectedKind);
        if count =!= fnParamCount(actualKind) { return false; }
        var idx := 0;
        loop idx < count {
            if fnParamIsOptional(expectedKind, idx) =!= fnParamIsOptional(actualKind, idx) { return false; }
            eComp := fnParamComponent(expectedKind, idx);
            aComp := fnParamComponent(actualKind, idx);
            if not self(eComp.kind, aComp.kind) { return false; }
            idx = idx + 1;
        }
        return self(fnResultKind(expectedKind), fnResultKind(actualKind));
    }
    if isListKind(expectedKind) and isListKind(actualKind) {
        return self(listElementKind(expectedKind), listElementKind(actualKind));
    }
    if isMapKind(expectedKind) and isMapKind(actualKind) {
        return self(mapKeyKind(expectedKind), mapKeyKind(actualKind)) and
        self(mapValueKind(expectedKind), mapValueKind(actualKind));
    }
    if isSetKind(expectedKind) and isSetKind(actualKind) {
        return self(setElementKind(expectedKind), setElementKind(actualKind));
    }
    if isArrayKind(expectedKind) and isArrayKind(actualKind) {
        return arrayExtent(expectedKind) == arrayExtent(actualKind) and
        self(arrayElementKind(expectedKind), arrayElementKind(actualKind));
    }
    if isUnionKind(expectedKind) and isUnionKind(actualKind) {
        eMems := unionMembers(expectedKind);
        aMems := unionMembers(actualKind);
        if eMems.length() =!= aMems.length() { return false; }
        var idx := 0;
        loop idx < eMems.length() {
            if not self(eMems[idx], aMems[idx]) { return false; }
            idx = idx + 1;
        }
        return true;
    }
    if isResultKind(expectedKind) and isResultKind(actualKind) {
        return self(resultOkKind(expectedKind), resultOkKind(actualKind)) and
        self(resultErrKind(expectedKind), resultErrKind(actualKind));
    }
    if isTupleKind(expectedKind) and isTupleKind(actualKind) {
        count := tupleComponentCount(expectedKind);
        if count =!= tupleComponentCount(actualKind) { return false; }
        var idx := 0;
        loop idx < count {
            if not self(tupleComponent(expectedKind, idx).kind, tupleComponent(actualKind, idx).kind) { return false; }
            idx = idx + 1;
        }
        return true;
    }
    false
};

/** True when `expectedKind` and `actualKind` are callable kinds with matching parameter and return shapes. */
pub fnShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    isFnKind(expectedKind) and isFnKind(actualKind) and exactShapeMatches(expectedKind, actualKind)
};

/** True when `expectedKind` and `actualKind` share identical runtime ABI shapes (modulo labels). */
pub fnRuntimeSameShape := fn(expectedKind: String, actualKind: String): Bool {
    fnShapeMatches(expectedKind, actualKind)
};

/** Subtype relation permitted during callable input contravariance and result covariance (no implicit numeric or record coercions). */
isCallableVarianceSubkind := fn(superKind: String, subKind: String): Bool {
    if superKind == subKind or exactShapeMatches(superKind, subKind) { return true; }
    if superKind =!= "" and subKind == ir.VALUE_KIND_NEVER { return true; }
    if isFnKind(superKind) and isFnKind(subKind) {
        return fnVarianceCompatible(superKind, subKind);
    }
    if isUnionKind(superKind) {
        eMems := unionMembers(superKind);
        loop unionMembers(subKind) as am {
            var matched := false;
            loop eMems as em {
                if self(em, am) { matched = true; break; }
            }
            if not matched { return false; }
        }
        return true;
    }
    if isResultKind(superKind) and isResultKind(subKind) {
        return self(resultOkKind(superKind), resultOkKind(subKind)) and
        self(resultErrKind(superKind), resultErrKind(subKind));
    }
    false
};

/** True when `actualKind` can be safely adapted into destination callable view `expectedKind`. */
pub fnVarianceCompatible := fn(expectedKind: String, actualKind: String): Bool {
    if not isFnKind(expectedKind) or not isFnKind(actualKind) { return false; }
    if exactShapeMatches(expectedKind, actualKind) { return true; }
    eCtx := fnContextKind(expectedKind);
    aCtx := fnContextKind(actualKind);
    if (eCtx == "" and aCtx =!= "") or (eCtx =!= "" and aCtx == "") { return false; }
    if eCtx =!= "" and not exactShapeMatches(eCtx, aCtx) { return false; }
    count := fnParamCount(expectedKind);
    if count =!= fnParamCount(actualKind) { return false; }
    var idx := 0;
    loop idx < count {
        eOpt := fnParamIsOptional(expectedKind, idx);
        aOpt := fnParamIsOptional(actualKind, idx);
        if eOpt and not aOpt { return false; }
        eRaw := fnParamComponent(expectedKind, idx).kind;
        aRaw := fnParamComponent(actualKind, idx).kind;
        eMut := eRaw.startsWithAt(0, "mut ");
        aMut := aRaw.startsWithAt(0, "mut ");
        if eMut or aMut {
            if not eMut or not aMut { return false; }
            eBase := eRaw.slice(4, eRaw.length());
            aBase := aRaw.slice(4, aRaw.length());
            if not exactShapeMatches(eBase, aBase) { return false; }
        } else if not isCallableVarianceSubkind(aRaw, eRaw) {
            return false;
        }
        idx = idx + 1;
    }
    isCallableVarianceSubkind(fnResultKind(expectedKind), fnResultKind(actualKind))
};

/** True when `kind` is or contains a callable function kind (for display and backend checks). */
pub containsFnKind := fn(kind: String): Bool {
    if kind.indexOf("fn(", 0) < 0 { return false; }
    if isFnKind(kind) { return true; }
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    cached := containsFnCache.get(kind);
    if cached.found { return cached.value; }
    var res := false;
    if isListKind(kind) { res = self(listElementKind(kind)); }
    else if isMapKind(kind) { res = self(mapKeyKind(kind)) or self(mapValueKind(kind)); }
    else if isSetKind(kind) { res = self(setElementKind(kind)); }
    else if isRcKind(kind) { res = self(rcElementKind(kind)); }
    else if isSliceKind(kind) { res = self(sliceElementKind(kind)); }
    else if isSoaKind(kind) { res = self(soaRecordKind(kind)); }
    else if isArrayKind(kind) { res = self(arrayElementKind(kind)); }
    else if isCtxKind(kind) {
        loop contexts.parseCtxKindSlots(kind) as cs {
            if self(cs.kind) { res = true; break; }
        }
    } else if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var idx := 0;
        loop idx < count {
            if self(tupleComponent(kind, idx).kind) { res = true; break; }
            idx = idx + 1;
        }
    } else if isRecordKind(kind) {
        count := recordComponentCount(kind);
        var idx := 0;
        loop idx < count {
            if self(recordComponent(kind, idx).kind) { res = true; break; }
            idx = idx + 1;
        }
    } else if isPayloadEnumKind(kind) {
        count := enumCaseCount(kind);
        var ci := 0;
        loop ci < count and not res {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { res = true; break; }
            }
            ci = ci + 1;
        }
    } else if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(um) { res = true; break; }
        }
    } else if isResultKind(kind) {
        res = self(resultOkKind(kind)) or self(resultErrKind(kind));
    }
    (mut containsFnCache).set(kind, res);
    res
};

/** Encodes characters in a comptime String value so canonical `ValS<...>` never collides with delimiters or binding separators. */
encodeComptimeStr := fn(text: String): String {
    size := text.length();
    mut parts: List<String> = [];
    var segStart := 0;
    var i := 0;
    loop i < size {
        ch := text.at(i);
        repl := match {
            ch == "%" { "%25" }
            ch == "<" { "%3C" }
            ch == ">" { "%3E" }
            ch == "(" { "%28" }
            ch == ")" { "%29" }
            ch == "[" { "%5B" }
            ch == "]" { "%5D" }
            ch == "," { "%2C" }
            ch == ";" { "%3B" }
            ch == ":" { "%3A" }
            ch == "|" { "%7C" }
            ch == "\"" { "%22" }
            ch == "\n" { "%0A" }
            ch == "\r" { "%0D" }
            ch == "\t" { "%09" }
            _ { "" }
        };
        if repl =!= "" {
            if i > segStart { mut parts.pushBack(text.slice(segStart, i)); }
            (mut parts).pushBack(repl);
            segStart = i + 1;
        }
        i = i + 1;
    }
    if segStart == 0 { return text; }
    if segStart < size { mut parts.pushBack(text.slice(segStart, size)); }
    parts.join("")
};

/** Decodes percent-escaped canonical payload from `ValS<...>`. */
decodeComptimeStr := fn(encoded: String): String {
    size := encoded.length();
    mut parts: List<String> = [];
    var segStart := 0;
    var i := 0;
    loop i < size {
        if encoded.at(i) == "%" and i + 2 < size {
            code := encoded.slice(i + 1, i + 3);
            ch := match {
                code == "25" { "%" }
                code == "3C" { "<" }
                code == "3E" { ">" }
                code == "28" { "(" }
                code == "29" { ")" }
                code == "5B" { "[" }
                code == "5D" { "]" }
                code == "2C" { "," }
                code == "3B" { ";" }
                code == "3A" { ":" }
                code == "7C" { "|" }
                code == "22" { "\"" }
                code == "0A" { "\n" }
                code == "0D" { "\r" }
                code == "09" { "\t" }
                _ { "" }
            };
            if ch =!= "" {
                if i > segStart { mut parts.pushBack(encoded.slice(segStart, i)); }
                (mut parts).pushBack(ch);
                i = i + 3;
                segStart = i;
                continue;
            }
        }
        i = i + 1;
    }
    if segStart == 0 { return encoded; }
    if segStart < size { mut parts.pushBack(encoded.slice(segStart, size)); }
    parts.join("")
};

/** Encodes a canonical comptime `Int` argument token (`ValI<n>`). */
pub comptimeIntToken := fn(value: Int): String {
    "ValI<" + value.toText() + ">"
};

/** True when `tok` is a canonical `ValI<...>` comptime integer token. */
pub isComptimeIntToken := fn(tok: String): Bool {
    size := tok.length();
    if size < 7 or not tok.startsWithAt(0, "ValI<") or tok.at(size - 1) =!= ">" { return false; }
    var i := 5;
    if i < size - 1 and tok.at(i) == "-" { i = i + 1; }
    if i >= size - 1 { return false; }
    loop i < size - 1 {
        if not tok.at(i).isDigit() { return false; }
        i = i + 1;
    }
    true
};

/** Extracts the signed `Int` value from `ValI<...>`. */
pub comptimeIntValue := fn(tok: String): Int {
    if not isComptimeIntToken(tok) { return 0; }
    inner := tok.slice(5, tok.length() - 1);
    if inner.startsWithAt(0, "-") {
        if inner == "-9223372036854775808" { return -9223372036854775808; }
        return 0 - syntax.parseDigits(inner, 1, inner.length());
    }
    syntax.parseDigits(inner, 0, inner.length())
};

/** Encodes a canonical comptime `Bool` argument token (`ValB<1>` / `ValB<0>`). */
pub comptimeBoolToken := fn(value: Bool): String {
    if value { "ValB<1>" } else { "ValB<0>" }
};

/** True when `tok` is a canonical `ValB<...>` comptime boolean token. */
pub isComptimeBoolToken := fn(tok: String): Bool {
    tok == "ValB<1>" or tok == "ValB<0>"
};

/** Extracts the `Bool` value from `ValB<...>`. */
pub comptimeBoolValue := fn(tok: String): Bool {
    tok == "ValB<1>"
};

/** Encodes a canonical comptime `String` argument token (`ValS<...>`). */
pub comptimeStringToken := fn(value: String): String {
    "ValS<" + encodeComptimeStr(value) + ">"
};

/** True when `tok` is a canonical `ValS<...>` comptime string token. */
pub isComptimeStringToken := fn(tok: String): Bool {
    size := tok.length();
    size >= 6 and tok.startsWithAt(0, "ValS<") and tok.at(size - 1) == ">"
};

/** Extracts the decoded `String` value from `ValS<...>`. */
pub comptimeStringValue := fn(tok: String): String {
    if not isComptimeStringToken(tok) { return ""; }
    decodeComptimeStr(tok.slice(5, tok.length() - 1))
};

/** Encodes a canonical comptime enum case argument token (`ValE<lp(EnumKind)caseIdx>`). */
pub comptimeEnumToken := fn(enumKind: String, caseIdx: Int): String {
    "ValE<" + encodeLengthPrefixedText(enumKind) + caseIdx.toText() + ">"
};

/** True when `tok` is a canonical `ValE<...>` comptime enum case token. */
pub isComptimeEnumToken := fn(tok: String): Bool {
    size := tok.length();
    size > 6 and tok.startsWithAt(0, "ValE<") and tok.at(size - 1) == ">"
};

/** Returns the canonical `Enum<...>` type encoded inside `ValE<...>`. */
pub comptimeEnumKind := fn(tok: String): String {
    if not isComptimeEnumToken(tok) { return ""; }
    dec := decodeLengthPrefixedAt(tok, 5);
    dec.text
};

/** Returns the 0-based case index encoded inside `ValE<...>`. */
pub comptimeEnumCaseIndex := fn(tok: String): Int {
    if not isComptimeEnumToken(tok) { return -1; }
    dec := decodeLengthPrefixedAt(tok, 5);
    if dec.next < 0 or dec.next >= tok.length() - 1 { return -1; }
    syntax.parseDigits(tok, dec.next, tok.length() - 1)
};

/** True when `tok` is any canonical comptime value argument token (`ValI`, `ValB`, `ValS`, or `ValE`). */
pub isComptimeValueToken := fn(tok: String): Bool {
    isComptimeIntToken(tok) or isComptimeBoolToken(tok) or isComptimeStringToken(tok) or isComptimeEnumToken(tok)
};

/** Returns the canonical value type (`Int`, `Bool`, `String`, or `Enum<...>`) of comptime value token `tok`. */
pub comptimeValueTokenKind := fn(tok: String): String {
    if isComptimeIntToken(tok) { return ir.VALUE_KIND_INT; }
    if isComptimeBoolToken(tok) { return ir.VALUE_KIND_BOOL; }
    if isComptimeStringToken(tok) { return ir.VALUE_KIND_STRING; }
    if isComptimeEnumToken(tok) { return comptimeEnumKind(tok); }
    ""
};

/** Splits comma-separated comptime parameter specs (`"T,N=Int"` or `"T,C=Enum<...>"`) into parameter names. */
pub splitCommaNames := fn(csv: String): List<String> {
    mut out: List<String> = [];
    loop splitParamSpecs(csv) as spec {
        (mut out).pushBack(spec.name);
    }
    out
};

/** True when `kind` mentions any comptime parameter name listed in comma-separated `genericParams`. */
pub kindHasAnyGenericParam := fn(genericParams: String, kind: String): Bool {
    if genericParams == "" or kind == "" { return false; }
    if isAnyParamName(genericParams, kind) { return true; }
    if isListKind(kind) { return self(genericParams, listElementKind(kind)); }
    if isSetKind(kind) { return self(genericParams, setElementKind(kind)); }
    if isRcKind(kind) { return self(genericParams, rcElementKind(kind)); }
    if isSliceKind(kind) { return self(genericParams, sliceElementKind(kind)); }
    if isSimdKind(kind) {
        return self(genericParams, simdElementKind(kind)) or valueParamKind(genericParams, simdLaneCountText(kind)) =!= "";
    }
    if isSimdNativeKind(kind) { return self(genericParams, simdNativeElementKind(kind)); }
    if isSoaKind(kind) { return self(genericParams, soaRecordKind(kind)); }
    if isDynKind(kind) { return self(genericParams, dynInterfaceKind(kind)); }
    if isInterfaceKind(kind) {
        loop ifaceArgsOf(kind) as ia {
            if self(genericParams, ia) { return true; }
        }
        return false;
    }
    if isAllConstraintKind(kind) {
        loop allConstraintMembers(kind) as am {
            if self(genericParams, am) { return true; }
        }
        return false;
    }
    if isMapKind(kind) { return self(genericParams, mapKeyKind(kind)) or self(genericParams, mapValueKind(kind)); }
    if isArrayKind(kind) {
        return self(genericParams, arrayElementKind(kind)) or valueParamKind(genericParams, arrayExtentText(kind)) =!= "";
    }
    if isTupleKind(kind) {
        n := tupleComponentCount(kind);
        var i := 0;
        loop i < n {
            if self(genericParams, tupleComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isFnKind(kind) {
        n := fnParamCount(kind);
        var i := 0;
        loop i < n {
            if self(genericParams, fnParamComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        fnCtx := fnContextKind(kind);
        if fnCtx =!= "" and self(genericParams, fnCtx) { return true; }
        return self(genericParams, fnResultKind(kind));
    }
    if isCtxKind(kind) {
        loop contexts.parseCtxKindSlots(kind) as cs {
            if self(genericParams, cs.kind) { return true; }
        }
        return false;
    }
    if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(genericParams, um) { return true; }
        }
        return false;
    }
    if isResultKind(kind) {
        return self(genericParams, resultOkKind(kind)) or self(genericParams, resultErrKind(kind));
    }
    if isAssocKind(kind) {
        ap := parseAssocKind(kind);
        return self(genericParams, ap.owner) or self(genericParams, ap.ifaceKind);
    }
    args := nominalTypeArgs(kind);
    loop args as a {
        if self(genericParams, a) { return true; }
    }
    if isRecordKind(kind) {
        fc := recordComponentCount(kind);
        var fi := 0;
        loop fi < fc {
            if self(genericParams, recordComponent(kind, fi).kind) { return true; }
            fi = fi + 1;
        }
    } else if isDistinctKind(kind) {
        return self(genericParams, distinctUnderlyingKind(kind));
    } else if isPayloadEnumKind(kind) {
        cc := enumCaseCount(kind);
        var ci := 0;
        loop ci < cc {
            loop enumCasePayloads(kind, ci) as pk {
                if self(genericParams, pk) { return true; }
            }
            ci = ci + 1;
        }
    } else if isEnumKind(kind) {
        bk := enumBackingKind(kind);
        if bk =!= "" and self(genericParams, bk) { return true; }
    }
    false
};

/** Substitutes comptime parameter bindings atomically across canonical collections, tuples, fns, records, distincts, and enums. */
pub substCanonicalKind := fn(genericParams: String, pattern: String, bindings: Map<String, String>): String {
    if isAnyParamName(genericParams, pattern) {
        return bindings.getOr(pattern, pattern);
    }
    if isListKind(pattern) {
        return "List<" + self(genericParams, listElementKind(pattern), bindings) + ">";
    }
    if isSetKind(pattern) {
        return "Set<" + self(genericParams, setElementKind(pattern), bindings) + ">";
    }
    if isRcKind(pattern) {
        return "Rc<" + self(genericParams, rcElementKind(pattern), bindings) + ">";
    }
    if isSliceKind(pattern) {
        return "Slice<" + self(genericParams, sliceElementKind(pattern), bindings) + ">";
    }
    if isSimdKind(pattern) {
        var lanesStr := simdLaneCountText(pattern);
        if valueParamKind(genericParams, lanesStr) =!= "" and bindings.has(lanesStr) {
            bound := bindings.getOr(lanesStr, "");
            if isComptimeIntToken(bound) {
                lanesStr = comptimeIntValue(bound).toText();
            } else if bound =!= "" {
                lanesStr = bound;
            }
        }
        return "Simd<" + self(genericParams, simdElementKind(pattern), bindings) + "," + lanesStr + ">";
    }
    if isSimdNativeKind(pattern) {
        subEl := self(genericParams, simdNativeElementKind(pattern), bindings);
        if isSimdElemKind(subEl) {
            return "Simd<" + subEl + "," + simdNativeLaneCount(subEl).toText() + ">";
        }
        return "SimdNative<" + subEl + ">";
    }
    if isSoaKind(pattern) {
        return "SoA<" + self(genericParams, soaRecordKind(pattern), bindings) + ">";
    }
    if isDynKind(pattern) {
        return "Dyn<" + self(genericParams, dynInterfaceKind(pattern), bindings) + ">";
    }
    if isAssocKind(pattern) {
        ap := parseAssocKind(pattern);
        if ap.owner == "Self" and bindings.has("$assoc:" + ap.assocName) {
            return bindings.getOr("$assoc:" + ap.assocName, pattern);
        }
        subOwner := self(genericParams, ap.owner, bindings);
        subIface := self(genericParams, ap.ifaceKind, bindings);
        if not kindHasAnyGenericParam(genericParams, subOwner) and not kindHasAnyGenericParam(genericParams, subIface) and
        subOwner =!= "Self" and not kindHasAnyGenericParam("Self", subOwner) {
            resolved := resolveAssocKind(subOwner, subIface, ap.assocName);
            if resolved =!= "" { return resolved; }
        }
        return "$Assoc<" + subOwner + ";" + subIface + ";" + ap.assocName + ">";
    }
    if isInterfaceKind(pattern) {
        iKey := ifaceKeyOf(pattern);
        oldArgs := ifaceArgsOf(pattern);
        if oldArgs.length() == 0 { return pattern; }
        mut newArgs: List<String> = [];
        loop oldArgs as oa {
            mut newArgs.pushBack(self(genericParams, oa, bindings));
        }
        return buildInterfaceKind(iKey, newArgs);
    }
    if isAllConstraintKind(pattern) {
        mut newMembers: List<String> = [];
        loop allConstraintMembers(pattern) as am {
            mut newMembers.pushBack(self(genericParams, am, bindings));
        }
        return "All<" + newMembers.join(",") + ">";
    }
    if isMapKind(pattern) {
        return "Map<" + self(genericParams, mapKeyKind(pattern), bindings) + "," +
        self(genericParams, mapValueKind(pattern), bindings) + ">";
    }
    if isArrayKind(pattern) {
        var extStr := arrayExtentText(pattern);
        if valueParamKind(genericParams, extStr) =!= "" and bindings.has(extStr) {
            bound := bindings.getOr(extStr, "");
            if isComptimeIntToken(bound) {
                extStr = comptimeIntValue(bound).toText();
            } else if bound =!= "" {
                extStr = bound;
            }
        }
        return "[" + self(genericParams, arrayElementKind(pattern), bindings) + ";" + extStr + "]";
    }
    if isTupleKind(pattern) {
        n := tupleComponentCount(pattern);
        mut parts: List<String> = [];
        var i := 0;
        loop i < n {
            comp := tupleComponent(pattern, i);
            mut parts.pushBack(comp.label + ":" + self(genericParams, comp.kind, bindings));
            i = i + 1;
        }
        return "(" + parts.join(",") + ")";
    }
    if isFnKind(pattern) {
        n := fnParamCount(pattern);
        mut parts: List<String> = [];
        var i := 0;
        loop i < n {
            comp := fnParamComponent(pattern, i);
            optTok := if fnParamIsOptional(pattern, i) { "?:" } else { ":" };
            mut parts.pushBack(comp.label + optTok + self(genericParams, comp.kind, bindings));
            i = i + 1;
        }
        rawCtx := fnContextKind(pattern);
        substCtx := if rawCtx =!= "" { self(genericParams, rawCtx, bindings) } else { "" };
        return "fn(" + parts.join(",") + ")" + fnAtCtxSuffix(substCtx) + ":" + self(genericParams, fnResultKind(pattern), bindings);
    }
    if isCtxKind(pattern) {
        mut sSlots: List<contexts.CtxSlot> = [];
        loop contexts.parseCtxKindSlots(pattern) as cs {
            mut sSlots.pushBack(contexts.CtxSlot { name = cs.name, isMut = cs.isMut, kind = self(genericParams, cs.kind, bindings) });
        }
        return contexts.buildCanonicalCtxKind(sSlots);
    }
    if isUnionKind(pattern) {
        mut subMems: List<String> = [];
        loop unionMembers(pattern) as um {
            mut subMems.pushBack(self(genericParams, um, bindings));
        }
        return buildUnionKind(subMems);
    }
    if isResultKind(pattern) {
        return buildResultKind(self(genericParams, resultOkKind(pattern), bindings), self(genericParams, resultErrKind(pattern), bindings));
    }
    if isRecordKind(pattern) {
        if not kindHasAnyGenericParam(genericParams, pattern) { return pattern; }
        semi := recordHeaderSemi(pattern);
        if semi <= 7 { return pattern; }
        hdr := pattern.slice(7, semi);
        baseHdr := hdr.slice(0, headerBaseEnd(hdr));
        oldArgs := headerTypeArgs(hdr);
        mut newArgs: List<String> = [];
        loop oldArgs as oa {
            mut newArgs.pushBack(self(genericParams, oa, bindings));
        }
        newHdr := if newArgs.length() > 0 { baseHdr + "<" + newArgs.join(",") + ">" } else { baseHdr };
        fc := recordComponentCount(pattern);
        mut fieldParts: List<String> = [];
        var fi := 0;
        loop fi < fc {
            comp := recordComponent(pattern, fi);
            mut fieldParts.pushBack(encodeRecordFieldLabel(comp.label) + ":" + self(genericParams, comp.kind, bindings));
            fi = fi + 1;
        }
        return "Record<" + newHdr + ";" + fieldParts.join(",") + ">";
    }
    if isDistinctKind(pattern) {
        if not kindHasAnyGenericParam(genericParams, pattern) { return pattern; }
        meta := distinctMeta(pattern);
        if not meta.ok { return pattern; }
        baseHdr := meta.header;
        oldArgs := headerTypeArgs(meta.rawHeader);
        mut newArgs: List<String> = [];
        loop oldArgs as oa {
            mut newArgs.pushBack(self(genericParams, oa, bindings));
        }
        newHdr := if newArgs.length() > 0 { baseHdr + "<" + newArgs.join(",") + ">" } else { baseHdr };
        newUnder := self(genericParams, meta.underlying, bindings);
        return "Distinct<" + encodeLengthPrefixedText(newHdr) + newUnder + ">";
    }
    if isEnumKind(pattern) {
        if not kindHasAnyGenericParam(genericParams, pattern) { return pattern; }
        hdr := decodeLengthPrefixedAt(pattern, 5);
        if hdr.next < 0 { return pattern; }
        bk := decodeLengthPrefixedAt(pattern, hdr.next);
        if bk.next < 0 { return pattern; }
        baseHdr := hdr.text.slice(0, headerBaseEnd(hdr.text));
        oldArgs := headerTypeArgs(hdr.text);
        mut newArgs: List<String> = [];
        loop oldArgs as oa {
            mut newArgs.pushBack(self(genericParams, oa, bindings));
        }
        newHdr := if newArgs.length() > 0 { baseHdr + "<" + newArgs.join(",") + ">" } else { baseHdr };
        if bk.text == "$payload" {
            info := enumHeaderInfo(pattern);
            mut encodedPairsBuf: tb.TextBuilder;
            var ci := 0;
            loop ci < info.count {
                cName := enumCaseAt(pattern, ci).name;
                mut newPayloads: List<String> = [];
                loop enumCasePayloads(pattern, ci) as pk {
                    mut newPayloads.pushBack(self(genericParams, pk, bindings));
                }
                mut encodedPairsBuf.append(encodeLengthPrefixedText(cName));
                mut encodedPairsBuf.append(encodeLengthPrefixedText(newPayloads.join(",")));
                ci = ci + 1;
            }
            return "Enum<" + encodeLengthPrefixedText(newHdr) + encodeLengthPrefixedText("$payload") + info.count.toText() + ";" + encodedPairsBuf.build() + ">";
        }
        newBk := if bk.text == "" { "" } else { self(genericParams, bk.text, bindings) };
        tail := pattern.slice(bk.next, pattern.length() - 1);
        return "Enum<" + encodeLengthPrefixedText(newHdr) + encodeLengthPrefixedText(newBk) + tail + ">";
    }
    pattern
};

/** True when `kind` contains strings, heap containers, handles, or closures forbidden inside `@packed` structs. */
packedRecordFieldUnsafe := fn(kind: String): Bool {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if kind == ir.VALUE_KIND_STRING or cTypeNeedsDrop(kind) or isSimdKind(kind) or isSimdNativeKind(kind) or isDynKind(kind) { return true; }
    if isArrayKind(kind) { return self(arrayElementKind(kind)); }
    if isTupleKind(kind) {
        var i := 0;
        n := tupleComponentCount(kind);
        loop i < n {
            if self(tupleComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isRecordKind(kind) {
        var i := 0;
        n := recordComponentCount(kind);
        loop i < n {
            if self(recordComponent(kind, i).kind) { return true; }
            i = i + 1;
        }
        return false;
    }
    if isPayloadEnumKind(kind) {
        var ci := 0;
        cc := enumCaseCount(kind);
        loop ci < cc {
            loop enumCasePayloads(kind, ci) as pk {
                if self(pk) { return true; }
            }
            ci = ci + 1;
        }
        return false;
    }
    if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if self(um) { return true; }
        }
        return false;
    }
    if isResultKind(kind) {
        return self(resultOkKind(kind)) or self(resultErrKind(kind));
    }
    false
};

/** Validates map-key, set-element, nested-list, tuple, record-field, and distinct constraints on a canonical kind, returning `""` if valid. */
pub validateCanonicalKind := fn(kind: String, allowGenericParams: String): String {
    if isAssocKind(kind) {
        if kindHasAnyGenericParam(allowGenericParams, kind) { return ""; }
        ap := parseAssocKind(kind);
        resolved := resolveAssocKind(ap.owner, ap.ifaceKind, ap.assocName);
        if resolved == "" { return "unresolved associated type " + displayKind(kind); }
        return self(resolved, allowGenericParams);
    }
    if isListKind(kind) {
        elem := listElementKind(kind);
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        if isListKind(elem) { return "nested list types are not supported"; }
        if elem == ir.VALUE_KIND_UNIT { return "unsupported list element type Unit"; }
        return self(elem, allowGenericParams);
    }
    if isSetKind(kind) {
        elem := setElementKind(kind);
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        if not isGenericParamName(allowGenericParams, distinctBaseKind(elem)) and not (isAssocKind(elem) and kindHasAnyGenericParam(allowGenericParams, elem)) and not isMapKeyKind(elem) {
            return "unsupported set element type " + displayKind(elem);
        }
        return self(elem, allowGenericParams);
    }
    if isRcKind(kind) {
        elem := rcElementKind(kind);
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        if elem == ir.VALUE_KIND_UNIT or elem == ir.VALUE_KIND_NEVER {
            return "unsupported Rc element type " + displayKind(elem);
        }
        return self(elem, allowGenericParams);
    }
    if isSliceKind(kind) {
        elem := sliceElementKind(kind);
        if elem == ir.VALUE_KIND_UNIT or elem == ir.VALUE_KIND_NEVER {
            return "unsupported Slice element type " + displayKind(elem);
        }
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        return self(elem, allowGenericParams);
    }
    if isSimdKind(kind) {
        elem := simdElementKind(kind);
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        isGenSimd := isGenericParamName(allowGenericParams, distinctBaseKind(elem)) or (isAssocKind(elem) and kindHasAnyGenericParam(allowGenericParams, elem));
        if not isGenSimd and not isSimdElemKind(elem) {
            return "unsupported Simd lane type " + displayKind(elem);
        }
        lanesText := simdLaneCountText(kind);
        if valueParamKind(allowGenericParams, lanesText) =!= ir.VALUE_KIND_INT {
            lanes := simdLaneCount(kind);
            if lanes =!= 2 and lanes =!= 4 and lanes =!= 8 and lanes =!= 16 and lanes =!= 32 and lanes =!= 64 {
                return "Simd lane count must be a power of two (2..64), got " + lanesText;
            }
            if not isGenSimd and not isValidSimdLaneCount(elem, lanes) {
                return "unsupported Simd shape " + displayKind(kind) + " (total width must be <= 64 bytes)";
            }
        }
        return self(elem, allowGenericParams);
    }
    if isSimdNativeKind(kind) {
        elem := simdNativeElementKind(kind);
        if not isGenericParamName(allowGenericParams, distinctBaseKind(elem)) and not (isAssocKind(elem) and kindHasAnyGenericParam(allowGenericParams, elem)) and not isSimdElemKind(elem) {
            return "unsupported Simd lane type " + displayKind(elem);
        }
        return self(elem, allowGenericParams);
    }
    if isSoaKind(kind) {
        rec := soaRecordKind(kind);
        bErr := borrowedStorageError(rec);
        if bErr =!= "" { return bErr; }
        if not isGenericParamName(allowGenericParams, distinctBaseKind(rec)) and not (isAssocKind(rec) and kindHasAnyGenericParam(allowGenericParams, rec)) {
            if not isRecordKind(rec) or recordComponentCount(rec) == 0 {
                return "SoA<R> requires a non-empty record type, got " + displayKind(rec);
            }
            if not cIsSupportedElem(rec) {
                return "unsupported SoA record type " + displayKind(rec);
            }
        }
        return self(rec, allowGenericParams);
    }
    if isMapKind(kind) {
        k := mapKeyKind(kind);
        kBErr := borrowedStorageError(k);
        if kBErr =!= "" { return kBErr; }
        if not isGenericParamName(allowGenericParams, distinctBaseKind(k)) and not (isAssocKind(k) and kindHasAnyGenericParam(allowGenericParams, k)) and not isMapKeyKind(k) {
            return "unsupported map key type " + displayKind(k);
        }
        v := mapValueKind(kind);
        vBErr := borrowedStorageError(v);
        if vBErr =!= "" { return vBErr; }
        if v == ir.VALUE_KIND_UNIT or v == ir.VALUE_KIND_NEVER {
            return "unsupported map value type " + displayKind(v);
        }
        kErr := self(k, allowGenericParams);
        if kErr =!= "" { return kErr; }
        return self(v, allowGenericParams);
    }
    if isArrayKind(kind) {
        elem := arrayElementKind(kind);
        bErr := borrowedStorageError(elem);
        if bErr =!= "" { return bErr; }
        if elem == ir.VALUE_KIND_UNIT { return "unsupported array element type Unit"; }
        extText := arrayExtentText(kind);
        if extText =!= "*" and valueParamKind(allowGenericParams, extText) =!= ir.VALUE_KIND_INT {
            if arrayExtent(kind) <= 0 {
                return "array extent must be a positive integer";
            }
        }
        return self(elem, allowGenericParams);
    }
    if isTupleKind(kind) {
        n := tupleComponentCount(kind);
        var i := 0;
        loop i < n {
            ck := tupleComponent(kind, i).kind;
            if isTupleKind(ck) { return "nested tuple types are not supported"; }
            if isListKind(ck) { return "list types inside tuples are not supported"; }
            if ck == ir.VALUE_KIND_UNIT { return "unsupported tuple component type Unit"; }
            if containsDynKind(ck) { return "borrowed dyn Interface cannot be stored in owning container or type definition"; }
            err := self(ck, allowGenericParams);
            if err =!= "" { return err; }
            i = i + 1;
        }
        return "";
    }
    if isFnKind(kind) {
        n := fnParamCount(kind);
        var i := 0;
        loop i < n {
            err := self(fnParamComponent(kind, i).kind, allowGenericParams);
            if err =!= "" { return err; }
            i = i + 1;
        }
        fnCtx := fnContextKind(kind);
        if fnCtx =!= "" {
            loop contexts.parseCtxKindSlots(fnCtx) as cs {
                if cs.kind == ir.VALUE_KIND_UNIT { return "context slot " + cs.name + " cannot have type Unit"; }
                cErr := self(cs.kind, allowGenericParams);
                if cErr =!= "" { return cErr; }
            }
        }
        rk := fnResultKind(kind);
        if containsDynKind(rk) { return "borrowed dyn Interface cannot escape via function return type"; }
        if rk =!= ir.VALUE_KIND_UNIT and rk =!= ir.VALUE_KIND_NEVER {
            return self(rk, allowGenericParams);
        }
        return "";
    }
    if isRecordKind(kind) {
        if recordLayoutAttrs(kind).packed and packedRecordFieldUnsafe(kind) {
            return "#packed record cannot contain heap-owned or drop-requiring fields";
        }
        fc := recordComponentCount(kind);
        var fi := 0;
        loop fi < fc {
            fk := recordComponent(kind, fi).kind;
            if fk == ir.VALUE_KIND_UNIT { return "unsupported record field type Unit"; }
            bErr := borrowedStorageError(fk);
            if bErr =!= "" { return bErr; }
            err := self(fk, allowGenericParams);
            if err =!= "" { return err; }
            fi = fi + 1;
        }
        return "";
    }
    if isUnionKind(kind) {
        loop unionMembers(kind) as um {
            if um == ir.VALUE_KIND_NEVER {
                return "unsupported union member " + displayKind(um);
            }
            if isInterfaceKind(um) {
                return "interface " + displayKind(um) + " cannot appear in union value type";
            }
            bErr := borrowedStorageError(um);
            if bErr =!= "" { return bErr; }
            if um =!= ir.VALUE_KIND_UNIT {
                err := self(um, allowGenericParams);
                if err =!= "" { return err; }
            }
        }
        return "";
    }
    if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        if okK == ir.VALUE_KIND_NEVER { return "unsupported fallible success type Never"; }
        if errK == ir.VALUE_KIND_NEVER { return "unsupported fallible error type Never"; }
        if isInterfaceKind(okK) { return "interface " + displayKind(okK) + " cannot be used as fallible success type"; }
        if isInterfaceKind(errK) { return "interface " + displayKind(errK) + " cannot be used as fallible error type"; }
        okBErr := borrowedStorageError(okK);
        if okBErr =!= "" { return okBErr; }
        errBErr := borrowedStorageError(errK);
        if errBErr =!= "" { return errBErr; }
        if okK =!= ir.VALUE_KIND_UNIT {
            okErr := self(okK, allowGenericParams);
            if okErr =!= "" { return okErr; }
        }
        if errK =!= ir.VALUE_KIND_UNIT {
            eErr := self(errK, allowGenericParams);
            if eErr =!= "" { return eErr; }
        }
        return "";
    }
    if isInterfaceKind(kind) {
        return "interface " + displayKind(kind) + " cannot be used directly as a value type; use T: Type<" + displayKind(kind) + "> for static dispatch or dyn " + displayKind(kind) + " for dynamic dispatch";
    }
    if isDynKind(kind) {
        inner := dynInterfaceKind(kind);
        loop ifaceArgsOf(inner) as ia {
            err := self(ia, allowGenericParams);
            if err =!= "" { return err; }
        }
        return "";
    }
    if isDistinctKind(kind) {
        uk := distinctUnderlyingKind(kind);
        if uk == ir.VALUE_KIND_UNIT or uk == ir.VALUE_KIND_NEVER {
            return "unsupported distinct underlying type " + displayKind(uk);
        }
        bErr := borrowedStorageError(uk);
        if bErr =!= "" { return bErr; }
        return self(uk, allowGenericParams);
    }
    if isPayloadEnumKind(kind) {
        cc := enumCaseCount(kind);
        var ci := 0;
        loop ci < cc {
            loop enumCasePayloads(kind, ci) as pk {
                if pk == ir.VALUE_KIND_UNIT or pk == ir.VALUE_KIND_NEVER {
                    return "unsupported enum payload type " + displayKind(pk);
                }
                bErr := borrowedStorageError(pk);
                if bErr =!= "" { return bErr; }
                err := self(pk, allowGenericParams);
                if err =!= "" { return err; }
            }
            ci = ci + 1;
        }
        return "";
    }
    ""
};

/** Parses optional `<T: Type, N: Int, ...>` comptime parameter list (allowing omitted `: Type` for compatibility) non-destructively. */
pub scanComptimeTypeParams := fn(source: String, start: Int, prefix: String): (ok: Bool, hasParams: Bool, paramsCsv: String, next: Int, errPos: Int, errMsg: String) {
    size := source.length();
    var cursor := syntax.skipTrivia(source, start, prefix);
    if cursor >= size or source.at(cursor) =!= "<" {
        return (ok = true, hasParams = false, paramsCsv = "", next = cursor, errPos = -1, errMsg = "");
    }
    cursor = syntax.skipTrivia(source, cursor + 1, prefix);
    if cursor >= size or source.at(cursor) == ">" {
        return (ok = false, hasParams = true, paramsCsv = "", next = cursor, errPos = cursor, errMsg = "expected at least one type parameter inside <...>");
    }
    var paramsCsv := "";
    loop cursor < size {
        if not source.at(cursor).isNameStart() {
            return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = cursor, errPos = cursor, errMsg = "expected a comptime parameter name");
        }
        nameStart := cursor;
        nameEnd := source.skipName(nameStart);
        pName := source.slice(nameStart, nameEnd);
        if syntax.isReservedWord(pName) {
            return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = nameStart, errPos = nameStart, errMsg = "unsupported feature \"" + pName + "\"");
        }
        if isAnyParamName(paramsCsv, pName) {
            return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = nameStart, errPos = nameStart, errMsg = "duplicate comptime parameter " + pName);
        }
        var entry := pName;
        cursor = syntax.skipTrivia(source, nameEnd, prefix);
        if cursor < size and source.at(cursor) == ":" {
            kindStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if kindStart >= size or not source.at(kindStart).isNameStart() or source.wordAt(kindStart, "fn") {
                return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = kindStart, errPos = kindStart, errMsg = "expected comptime parameter kind after :");
            }
            kindEnd0 := source.skipName(kindStart);
            var kindText := source.slice(kindStart, kindEnd0);
            var kindEnd := kindEnd0;
            afterK0 := syntax.skipTrivia(source, kindEnd0, prefix);
            if afterK0 < size and source.at(afterK0) == "." {
                mStart := syntax.skipTrivia(source, afterK0 + 1, prefix);
                if mStart >= size or not source.at(mStart).isNameStart() {
                    return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = mStart, errPos = mStart, errMsg = "expected a type name after .");
                }
                kindEnd = source.skipName(mStart);
                kindText = kindText + "." + source.slice(mStart, kindEnd);
            }
            afterKind := syntax.skipTrivia(source, kindEnd, prefix);
            if afterKind < size and source.at(afterKind) == "<" {
                if kindText =!= "Type" {
                    return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = kindStart, errPos = kindStart, errMsg = "unsupported comptime parameter kind " + kindText + "<...>; only Type, Int, Bool, String, and payload-free enums are supported");
                }
                innerStart := syntax.skipTrivia(source, afterKind + 1, prefix);
                if innerStart >= size or source.at(innerStart) == ">" {
                    return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = innerStart, errPos = innerStart, errMsg = "expected at least one type constraint inside Type<...>");
                }
                var cScan := afterKind;
                var cDepth := 0;
                var cClose := -1;
                loop cScan < size {
                    ch2 := source.at(cScan);
                    if ch2 == "\"" {
                        cScan = syntax.skipAliasString(source, cScan);
                    } else if ch2 == "/" and source.startsWithAt(cScan, "/*") {
                        cScan = syntax.skipComment(source, cScan, prefix);
                    } else if ch2 == "<" {
                        cDepth = cDepth + 1;
                        cScan = cScan + 1;
                    } else if ch2 == ">" {
                        cDepth = cDepth - 1;
                        if cDepth == 0 {
                            cClose = cScan;
                            break;
                        }
                        cScan = cScan + 1;
                    } else {
                        cScan = cScan + 1;
                    }
                }
                if cClose < 0 {
                    return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = afterKind, errPos = afterKind, errMsg = "expected >");
                }
                rawBounds := source.slice(innerStart, cClose);
                entry = pName + "=Type<" + rawBounds + ">";
                cursor = syntax.skipTrivia(source, cClose + 1, prefix);
            } else if kindText == "Type" {
                entry = pName;
                cursor = afterKind;
            } else if kindText == ir.VALUE_KIND_FLOAT or kindText == ir.VALUE_KIND_FLOAT32 or kindText == "Float64" or
            kindText == ir.VALUE_KIND_UNIT or kindText == ir.VALUE_KIND_NEVER or kindText == "List" or
            kindText == "Map" or kindText == "Set" or kindText == "Rc" or kindText == "Slice" or kindText == "Simd" or kindText == "SimdNative" or kindText == "SoA" or kindText == "Array" or syntax.isReservedWord(kindText) or
            numeric.isNarrowNumericKind(kindText) or numeric.numericAliasKind(kindText) =!= "" {
                return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = kindStart, errPos = kindStart, errMsg = "unsupported comptime parameter kind " + kindText + "; only Type, Int, Bool, String, and payload-free enums are supported");
            } else {
                entry = pName + "=" + kindText;
                cursor = afterKind;
            }
        }
        paramsCsv = if paramsCsv == "" { entry } else { paramsCsv + "," + entry };
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ">" { break; }
        } else {
            break;
        }
    }
    if cursor >= size or source.at(cursor) =!= ">" {
        return (ok = false, hasParams = true, paramsCsv = paramsCsv, next = cursor, errPos = cursor, errMsg = "expected >");
    }
    (ok = true, hasParams = true, paramsCsv = paramsCsv, next = cursor + 1, errPos = -1, errMsg = "")
};

/** True when `expectedKind` and `actualKind` are tuples with identical component counts and positional component types. */
pub tupleShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if not isTupleKind(expectedKind) or not isTupleKind(actualKind) { return false; }
    expectedSize := expectedKind.length();
    actualSize := actualKind.length();
    var eCursor := 1;
    var aCursor := 1;
    loop eCursor < expectedSize and aCursor < actualSize {
        eChar := expectedKind.at(eCursor);
        aChar := actualKind.at(aCursor);
        if eChar == ")" or aChar == ")" {
            return eChar == ")" and aChar == ")";
        }
        if eChar =!= ":" { eCursor = expectedKind.skipName(eCursor); }
        if eCursor < expectedSize and expectedKind.at(eCursor) == ":" { eCursor = eCursor + 1; }
        eTypeStart := eCursor;
        eCursor = skipKindToken(expectedKind, eCursor);
        if aChar =!= ":" { aCursor = actualKind.skipName(aCursor); }
        if aCursor < actualSize and actualKind.at(aCursor) == ":" { aCursor = aCursor + 1; }
        aTypeStart := aCursor;
        aCursor = skipKindToken(actualKind, aCursor);
        eComp := expectedKind.slice(eTypeStart, eCursor);
        aComp := actualKind.slice(aTypeStart, aCursor);
        if eComp =!= aComp and not fnShapeMatches(eComp, aComp) {
            return false;
        }
        if eCursor < expectedSize and expectedKind.at(eCursor) == "," { eCursor = eCursor + 1; }
        if aCursor < actualSize and actualKind.at(aCursor) == "," { aCursor = aCursor + 1; }
    }
    eCursor >= expectedSize and aCursor >= actualSize
};

/** True when `actualKind` is directly `expectedKind`, `Never` into a known target, losslessly widens numerically, or matches a compatible tuple/callable shape. */
pub isCompatibleKind := fn(expectedKind: String, actualKind: String): Bool {
    if (expectedKind =!= "" and actualKind == ir.VALUE_KIND_NEVER) or expectedKind == actualKind or
    numeric.numericWidens(expectedKind, actualKind) or tupleShapeMatches(expectedKind, actualKind) or
    exactShapeMatches(expectedKind, actualKind) or
    (isArrayKind(expectedKind) and arrayExtent(expectedKind) == -1 and isArrayKind(actualKind) and self(arrayElementKind(expectedKind), arrayElementKind(actualKind))) {
        return true;
    }
    if isFnKind(expectedKind) and isFnKind(actualKind) {
        return fnVarianceCompatible(expectedKind, actualKind);
    }
    if isUnionKind(expectedKind) {
        if unionContainsAll(expectedKind, actualKind) { return true; }
        eMems := unionMembers(expectedKind);
        loop unionMembers(actualKind) as am {
            var matched := false;
            loop eMems as em {
                if em == am or exactShapeMatches(em, am) or (isFnKind(em) and isFnKind(am) and fnVarianceCompatible(em, am)) { matched = true; break; }
            }
            if not matched { return false; }
        }
        return true;
    }
    if isResultKind(expectedKind) {
        okExp := resultOkKind(expectedKind);
        errExp := resultErrKind(expectedKind);
        if not isResultKind(actualKind) {
            return self(okExp, actualKind);
        }
        return self(okExp, resultOkKind(actualKind)) and self(errExp, resultErrKind(actualKind));
    }
    false
};

/** Encodes a `Map<String, String>` binding table into `name=kind|...` in `paramCsv` order. */
encodeImplBindings := fn(paramCsv: String, bindings: Map<String, String>): String {
    mut parts: List<String> = [];
    loop splitParamSpecs(paramCsv) as sp {
        mut parts.pushBack(sp.name + "=" + bindings.getOr(sp.name, ""));
    }
    parts.join("|")
};

/** Decodes `"name=kind|..."` into a lookup map. */
pub decodeImplBindings := fn(encoded: String): Map<String, String> {
    mut out: Map<String, String>;
    if encoded == "" { return out; }
    var start := 0;
    size := encoded.length();
    loop start <= size {
        bar := encoded.indexOf("|", start);
        end := if bar < 0 { size } else { bar };
        entry := encoded.slice(start, end);
        eq := entry.indexOf("=", 0);
        if eq > 0 {
            mut out.set(entry.slice(0, eq), entry.slice(eq + 1, entry.length()));
        }
        if bar < 0 { break; }
        start = bar + 1;
    }
    out
};

/** Unifies generic `impl` target `pattern` against concrete `actual`, mutating `bindings`. */
unifyImplPatternMut := fn(genericParams: String, pattern: String, actual: String, bindings: mut Map<String, String>): Bool {
    if actual == ir.VALUE_KIND_NEVER { return false; }
    if isGenericParamName(genericParams, pattern) or valueParamKind(genericParams, pattern) =!= "" {
        if valueParamKind(genericParams, pattern) =!= "" {
            if not isComptimeValueToken(actual) { return false; }
            if bindings.has(pattern) { return bindings.getOr(pattern, "") == actual; }
            (mut bindings).set(pattern, actual);
            return true;
        }
        if bindings.has(pattern) {
            return isCompatibleKind(bindings.getOr(pattern, ""), actual);
        }
        (mut bindings).set(pattern, actual);
        return true;
    }
    if isListKind(pattern) {
        return isListKind(actual) and self(genericParams, listElementKind(pattern), listElementKind(actual), mut bindings);
    }
    if isSetKind(pattern) {
        return isSetKind(actual) and self(genericParams, setElementKind(pattern), setElementKind(actual), mut bindings);
    }
    if isRcKind(pattern) {
        return isRcKind(actual) and self(genericParams, rcElementKind(pattern), rcElementKind(actual), mut bindings);
    }
    if isSliceKind(pattern) {
        return isSliceKind(actual) and self(genericParams, sliceElementKind(pattern), sliceElementKind(actual), mut bindings);
    }
    if isSimdKind(pattern) {
        if not isSimdKind(actual) { return false; }
        pLanesText := simdLaneCountText(pattern);
        aLanes := simdLaneCount(actual);
        if valueParamKind(genericParams, pLanesText) == ir.VALUE_KIND_INT {
            laneTok := comptimeIntToken(aLanes);
            if bindings.has(pLanesText) {
                if bindings.getOr(pLanesText, "") =!= laneTok { return false; }
            } else {
                (mut bindings).set(pLanesText, laneTok);
            }
        } else if simdLaneCount(pattern) =!= aLanes {
            return false;
        }
        return self(genericParams, simdElementKind(pattern), simdElementKind(actual), mut bindings);
    }
    if isSoaKind(pattern) {
        return isSoaKind(actual) and self(genericParams, soaRecordKind(pattern), soaRecordKind(actual), mut bindings);
    }
    if isMapKind(pattern) {
        return isMapKind(actual) and self(genericParams, mapKeyKind(pattern), mapKeyKind(actual), mut bindings) and self(genericParams, mapValueKind(pattern), mapValueKind(actual), mut bindings);
    }
    if isArrayKind(pattern) {
        if not isArrayKind(actual) { return false; }
        pExtText := arrayExtentText(pattern);
        if pExtText == "*" {
            /* wildcard extent */
        } else if valueParamKind(genericParams, pExtText) == ir.VALUE_KIND_INT {
            aExt := arrayExtent(actual);
            if aExt <= 0 { return false; }
            extTok := comptimeIntToken(aExt);
            if bindings.has(pExtText) {
                if bindings.getOr(pExtText, "") =!= extTok { return false; }
            } else {
                (mut bindings).set(pExtText, extTok);
            }
        } else if arrayExtent(pattern) =!= arrayExtent(actual) {
            return false;
        }
        return self(genericParams, arrayElementKind(pattern), arrayElementKind(actual), mut bindings);
    }
    if isTupleKind(pattern) {
        if not isTupleKind(actual) or tupleComponentCount(pattern) =!= tupleComponentCount(actual) { return false; }
        n := tupleComponentCount(pattern);
        var i := 0;
        loop i < n {
            pc := tupleComponent(pattern, i);
            ac := tupleComponent(actual, i);
            if pc.label =!= ac.label { return false; }
            if not self(genericParams, pc.kind, ac.kind, mut bindings) { return false; }
            i = i + 1;
        }
        return true;
    }
    if isFnKind(pattern) {
        if not isFnKind(actual) or fnParamCount(pattern) =!= fnParamCount(actual) { return false; }
        n := fnParamCount(pattern);
        var i := 0;
        loop i < n {
            if fnParamIsOptional(pattern, i) =!= fnParamIsOptional(actual, i) { return false; }
            if not self(genericParams, fnParamComponent(pattern, i).kind, fnParamComponent(actual, i).kind, mut bindings) { return false; }
            i = i + 1;
        }
        return self(genericParams, fnResultKind(pattern), fnResultKind(actual), mut bindings);
    }
    if isAnonRecordKind(pattern) {
        if not isAnonRecordKind(actual) or recordComponentCount(pattern) =!= recordComponentCount(actual) { return false; }
        fc := recordComponentCount(pattern);
        var fi := 0;
        loop fi < fc {
            pc := recordComponent(pattern, fi);
            ac := recordComponent(actual, fi);
            if pc.label =!= ac.label { return false; }
            if not self(genericParams, pc.kind, ac.kind, mut bindings) { return false; }
            fi = fi + 1;
        }
        return true;
    }
    if isUnionKind(pattern) {
        if not isUnionKind(actual) { return false; }
        pMems := unionMembers(pattern);
        aMems := unionMembers(actual);
        if pMems.length() =!= aMems.length() { return false; }
        var ui := 0;
        loop ui < pMems.length() {
            if not self(genericParams, pMems[ui], aMems[ui], mut bindings) { return false; }
            ui = ui + 1;
        }
        return true;
    }
    if isResultKind(pattern) {
        return isResultKind(actual) and
        self(genericParams, resultOkKind(pattern), resultOkKind(actual), mut bindings) and
        self(genericParams, resultErrKind(pattern), resultErrKind(actual), mut bindings);
    }
    if isAssocKind(pattern) {
        pp := parseAssocKind(pattern);
        if isAssocKind(actual) {
            ap := parseAssocKind(actual);
            return pp.assocName == ap.assocName and self(genericParams, pp.owner, ap.owner, mut bindings) and self(genericParams, pp.ifaceKind, ap.ifaceKind, mut bindings);
        }
        if not kindHasAnyGenericParam(genericParams, pattern) {
            resP := resolveAssocKind(pp.owner, pp.ifaceKind, pp.assocName);
            if resP =!= "" { return isCompatibleKind(resP, actual); }
        }
        return false;
    }
    pArgs := nominalTypeArgs(pattern);
    if pArgs.length() > 0 {
        pOwner := typeOpOwnerKey(pattern);
        aOwner := typeOpOwnerKey(actual);
        aArgs := nominalTypeArgs(actual);
        if pOwner =!= aOwner or pArgs.length() =!= aArgs.length() { return false; }
        var ai := 0;
        loop ai < pArgs.length() {
            if not self(genericParams, pArgs[ai], aArgs[ai], mut bindings) { return false; }
            ai = ai + 1;
        }
        return true;
    }
    pattern == actual
};

/** True when `kind` is an encoded associated-type reference `$Assoc<Owner;IfaceKind;Name>`. */
pub isAssocKind := fn(kind: String): Bool {
    kind.startsWithAt(0, "$Assoc<") and kind.endsWith(">")
};

/** Splits an encoded `$Assoc<Owner;IfaceKind;Name>` at depth-0 `;` delimiters. */
pub parseAssocKind := fn(kind: String): (owner: String, ifaceKind: String, assocName: String) {
    if not isAssocKind(kind) { return (owner = "", ifaceKind = "", assocName = ""); }
    inner := kind.slice(7, kind.length() - 1);
    var depth := 0;
    var semi1 := -1;
    var semi2 := -1;
    var i := 0;
    n := inner.length();
    loop i < n {
        ch := inner.at(i);
        if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
        else if ch == ">" or ch == ")" or ch == "]" { if depth > 0 { depth = depth - 1; } }
        else if ch == ";" and depth == 0 {
            if semi1 < 0 { semi1 = i; }
            else if semi2 < 0 { semi2 = i; break; }
        }
        i = i + 1;
    }
    if semi1 <= 0 or semi2 <= semi1 { return (owner = "", ifaceKind = "", assocName = ""); }
    (owner = inner.slice(0, semi1), ifaceKind = inner.slice(semi1 + 1, semi2), assocName = inner.slice(semi2 + 1, n))
};

/** Resolves `assocName` for concrete `ownerKind` implementing `ifaceKind`, falling back to any interface default. */
pub resolveAssocKind := fn(ownerKind: String, ifaceKind: String, assocName: String): String {
    if ownerKind == "" or not isInterfaceKind(ifaceKind) or assocName == "" { return ""; }
    impHit := findImplForConcrete(ownerKind, ifaceKind);
    if impHit.found {
        imp := interfaces.getImpl(impHit.implIdx);
        ab := interfaces.findAssocInImpl(imp, assocName);
        if ab.found {
            if imp.genericParams =!= "" and impHit.bindingsEncoded =!= "" {
                return substCanonicalKind(imp.genericParams, ab.kind, decodeImplBindings(impHit.bindingsEncoded));
            }
            return ab.kind;
        }
    }
    iIdx := interfaces.findInterface(ifaceKeyOf(ifaceKind));
    if iIdx >= 0 {
        def := interfaces.getInterface(iIdx);
        aHit := interfaces.findAssocInInterface(def, assocName);
        if aHit.found and aHit.assoc.defaultKind =!= "" {
            args := ifaceArgsOf(ifaceKind);
            paramSpecs := splitParamSpecs(def.genericParams);
            mut bindings: Map<String, String>;
            var bi := 0;
            loop bi < paramSpecs.length() and bi < args.length() {
                mut bindings.set(paramSpecs[bi].name, args[bi]);
                bi = bi + 1;
            }
            mut bindings.set("Self", ownerKind);
            effParams := if def.genericParams =!= "" { def.genericParams + ",Self:Type" } else { "Self:Type" };
            return substCanonicalKind(effParams, aHit.assoc.defaultKind, bindings);
        }
    }
    ""
};

/** Searches visible `impl`s of concrete `ownerKind` for an associated type `assocName`. */
pub tryResolveConcreteAssoc := fn(ownerKind: String, assocName: String): (found: Bool, ambiguous: Bool, kind: String) {
    emptyRet := (found = false, ambiguous = false, kind = "");
    if ownerKind == "" or assocName == "" { return emptyRet; }
    owner := typeOpOwnerKey(ownerKind);
    if owner == "" { return emptyRet; }
    candidates := interfaces.implIndicesForOwner(owner);
    mut distinctKinds: List<String> = [];
    loop candidates as ci {
        imp := interfaces.getImpl(ci);
        if not imp.isPub and activeImplModuleKey =!= "" and imp.declModule =!= activeImplModuleKey { continue; }
        mut bindings: Map<String, String>;
        if not unifyImplPatternMut(imp.genericParams, imp.targetPattern, ownerKind, mut bindings) { continue; }
        var allBound := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if not bindings.has(sp.name) { allBound = false; break; }
        }
        if not allBound { continue; }
        var boundsOk := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if isTypeConstraintKind(sp.kind) {
                cKind := substCanonicalKind(imp.genericParams, typeConstraintUnion(sp.kind), bindings);
                if not typeSatisfiesConstraint(bindings.getOr(sp.name, ""), cKind) {
                    boundsOk = false;
                    break;
                }
            }
        }
        if not boundsOk { continue; }
        impArgs := if imp.ifaceArgsCsv == "" {
            empty: List<String> = [];
            empty
        } else {
            splitTopLevelKinds(imp.ifaceArgsCsv)
        };
        mut subArgs: List<String> = [];
        loop impArgs as ia {
            mut subArgs.pushBack(if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, ia, bindings) } else { ia });
        }
        instIface := buildInterfaceKind(imp.ifaceKey, subArgs);
        var resolved := "";
        ab := interfaces.findAssocInImpl(imp, assocName);
        if ab.found {
            resolved = if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, ab.kind, bindings) } else { ab.kind };
        } else {
            iIdx := interfaces.findInterface(imp.ifaceKey);
            if iIdx >= 0 {
                def := interfaces.getInterface(iIdx);
                aHit := interfaces.findAssocInInterface(def, assocName);
                if aHit.found and aHit.assoc.defaultKind =!= "" {
                    pSpecs := splitParamSpecs(def.genericParams);
                    mut dBind: Map<String, String>;
                    var bi := 0;
                    loop bi < pSpecs.length() and bi < subArgs.length() {
                        mut dBind.set(pSpecs[bi].name, subArgs[bi]);
                        bi = bi + 1;
                    }
                    mut dBind.set("Self", ownerKind);
                    effP := if def.genericParams =!= "" { def.genericParams + ",Self:Type" } else { "Self:Type" };
                    resolved = substCanonicalKind(effP, aHit.assoc.defaultKind, dBind);
                }
            }
        }
        if resolved =!= "" and not distinctKinds.contains(resolved) {
            mut distinctKinds.pushBack(resolved);
        }
    }
    if distinctKinds.length() == 0 { return emptyRet; }
    if distinctKinds.length() > 1 { return (found = false, ambiguous = true, kind = ""); }
    (found = true, ambiguous = false, kind = distinctKinds[0])
};

/** Resolves `genericParam.assocName` via `genericParam`'s interface bounds in `genericType`. */
findGenericParamAssocIface := fn(genericType: String, paramName: String, assocName: String): (ok: Bool, ifaceKind: String, errMsg: String) {
    cKind := typeParamConstraintKind(genericType, paramName);
    if cKind == "" {
        return (ok = false, ifaceKind = "", errMsg = "type parameter " + paramName + " has no interface bound declaring associated type " + assocName);
    }
    mut matches: List<String> = [];
    loop allConstraintMembers(cKind) as req {
        if isInterfaceKind(req) {
            iIdx := interfaces.findInterface(ifaceKeyOf(req));
            if iIdx >= 0 and interfaces.findAssocInInterface(interfaces.getInterface(iIdx), assocName).found {
                if not matches.contains(req) { mut matches.pushBack(req); }
            }
        }
    }
    if matches.length() == 0 {
        return (ok = false, ifaceKind = "", errMsg = "type parameter " + paramName + " has no associated type " + assocName + " in its interface bounds");
    }
    if matches.length() > 1 {
        return (ok = false, ifaceKind = "", errMsg = "ambiguous associated type " + paramName + "." + assocName + "; multiple interface bounds declare " + assocName);
    }
    (ok = true, ifaceKind = matches[0], errMsg = "")
};

/** Substitutes `InterfaceDef.genericParams` (from `ifaceKind`) and `"Self"` into an `InterfaceMethod`'s non-self params & result. */
pub instantiatedInterfaceMethods := fn(ifaceKind: String): List<interfaces.InterfaceMethod> {
    mut out: List<interfaces.InterfaceMethod> = [];
    if not isInterfaceKind(ifaceKind) { return out; }
    iIdx := interfaces.findInterface(ifaceKeyOf(ifaceKind));
    if iIdx < 0 { return out; }
    def := interfaces.getInterface(iIdx);
    args := ifaceArgsOf(ifaceKind);
    paramSpecs := splitParamSpecs(def.genericParams);
    mut bindings: Map<String, String>;
    var bi := 0;
    loop bi < paramSpecs.length() and bi < args.length() {
        mut bindings.set(paramSpecs[bi].name, args[bi]);
        bi = bi + 1;
    }
    loop def.methods as m {
        if def.genericParams == "" {
            mut out.pushBack(m);
        } else {
            newRes := substCanonicalKind(def.genericParams, m.result, bindings);
            mut newPList: List<String> = [];
            if m.paramCount > 0 {
                var pStart := 0;
                pLen := m.params.length();
                loop pStart <= pLen {
                    bar := m.params.indexOf("|", pStart);
                    pEnd := if bar < 0 { pLen } else { bar };
                    entry := m.params.slice(pStart, pEnd);
                    eq := entry.indexOf("=", 0);
                    if eq > 0 {
                        pName := entry.slice(0, eq);
                        rawPK := entry.slice(eq + 1, entry.length());
                        pAccess := if rawPK.startsWithAt(0, "mut ") { "mut " } else { "" };
                        pKind := if pAccess =!= "" { rawPK.slice(4, rawPK.length()) } else { rawPK };
                        mut newPList.pushBack(pName + "=" + pAccess + substCanonicalKind(def.genericParams, pKind, bindings));
                    }
                    if bar < 0 { break; }
                    pStart = bar + 1;
                }
            }
            mut out.pushBack(interfaces.InterfaceMethod {
                name = m.name,
                recvName = m.recvName,
                recvMut = m.recvMut,
                params = newPList.join("|"),
                paramCount = m.paramCount,
                result = newRes,
                hasDefault = m.hasDefault,
                defaultBody = m.defaultBody,
                defaultPrefix = m.defaultPrefix
            });
        }
    }
    out
};

/** Instantiates interface methods for a concrete/generic `impl` target by substituting `Self` and `Self.Assoc`. */
pub instantiatedInterfaceMethodsForTarget := fn(ifaceKind: String, targetKind: String, assocMap: Map<String, String>): List<interfaces.InterfaceMethod> {
    baseMethods := instantiatedInterfaceMethods(ifaceKind);
    iIdx := if isInterfaceKind(ifaceKind) { interfaces.findInterface(ifaceKeyOf(ifaceKind)) } else { -1 };
    defGP := if iIdx >= 0 { interfaces.getInterface(iIdx).genericParams } else { "" };
    effGP := if defGP =!= "" { defGP + ",Self:Type" } else { "Self:Type" };
    mut bindings: Map<String, String>;
    mut bindings.set("Self", targetKind);
    loop assocMap as kv {
        mut bindings.set("$assoc:" + kv.key, kv.value);
    }
    mut out: List<interfaces.InterfaceMethod> = [];
    loop baseMethods as m {
        newRes := substCanonicalKind(effGP, m.result, bindings);
        mut newPList: List<String> = [];
        if m.paramCount > 0 {
            var pStart := 0;
            pLen := m.params.length();
            loop pStart <= pLen {
                bar := m.params.indexOf("|", pStart);
                pEnd := if bar < 0 { pLen } else { bar };
                entry := m.params.slice(pStart, pEnd);
                eq := entry.indexOf("=", 0);
                if eq > 0 {
                    pName := entry.slice(0, eq);
                    rawPK := entry.slice(eq + 1, entry.length());
                    pAccess := if rawPK.startsWithAt(0, "mut ") { "mut " } else { "" };
                    pKind := if pAccess =!= "" { rawPK.slice(4, rawPK.length()) } else { rawPK };
                    mut newPList.pushBack(pName + "=" + pAccess + substCanonicalKind(effGP, pKind, bindings));
                }
                if bar < 0 { break; }
                pStart = bar + 1;
            }
        }
        mut out.pushBack(interfaces.InterfaceMethod {
            name = m.name,
            recvName = m.recvName,
            recvMut = m.recvMut,
            params = newPList.join("|"),
            paramCount = m.paramCount,
            result = newRes,
            hasDefault = m.hasDefault,
            defaultBody = m.defaultBody,
            defaultPrefix = m.defaultPrefix
        });
    }
    out
};

/** Finds a visible `impl` binding `actualKind` to `ifaceKind`, returning bound generic arguments when matched. */
pub findImplForConcrete := fn(actualKind: String, ifaceKind: String): (found: Bool, implIdx: Int, bindingsEncoded: String) {
    if actualKind == "" or not isInterfaceKind(ifaceKind) {
        return (found = false, implIdx = -1, bindingsEncoded = "");
    }
    reqKey := ifaceKeyOf(ifaceKind);
    reqArgs := ifaceArgsOf(ifaceKind);
    owner := typeOpOwnerKey(actualKind);
    candidates := interfaces.implIndicesForOwner(owner);
    loop candidates as ci {
        imp := interfaces.getImpl(ci);
        if not imp.isPub and activeImplModuleKey =!= "" and imp.declModule =!= activeImplModuleKey { continue; }
        if imp.ifaceKey =!= reqKey { continue; }
        mut bindings: Map<String, String>;
        if not unifyImplPatternMut(imp.genericParams, imp.targetPattern, actualKind, mut bindings) { continue; }
        var allBound := true;
        var constraintsOk := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if not bindings.has(sp.name) {
                allBound = false;
                break;
            }
        }
        if not allBound { continue; }
        /* Validate any conditional conformance bounds on imp.genericParams (excluding recursion via simple union/interface check). */
        loop splitParamSpecs(imp.genericParams) as sp {
            if isTypeConstraintKind(sp.kind) {
                cKind := substCanonicalKind(imp.genericParams, typeConstraintUnion(sp.kind), bindings);
                boundK := bindings.getOr(sp.name, "");
                /* Defer to constraint check after args check below via recursive self-safe helper if needed */
                if not isAllConstraintKind(cKind) and not isInterfaceKind(cKind) {
                    if not unionMembers(cKind).contains(boundK) { constraintsOk = false; break; }
                }
            }
        }
        if not constraintsOk { continue; }
        impArgs := if imp.ifaceArgsCsv == "" {
            empty: List<String> = [];
            empty
        } else {
            splitTopLevelKinds(imp.ifaceArgsCsv)
        };
        if impArgs.length() =!= reqArgs.length() { continue; }
        var argsMatch := true;
        var ai := 0;
        loop ai < impArgs.length() {
            subArg := if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, impArgs[ai], bindings) } else { impArgs[ai] };
            if subArg =!= reqArgs[ai] {
                argsMatch = false;
                break;
            }
            ai = ai + 1;
        }
        if not argsMatch { continue; }
        /* Check interface bounds on imp.genericParams (if any conditional impl<T: Type<I>>). */
        var ifaceBoundsOk := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if isTypeConstraintKind(sp.kind) {
                cKind := substCanonicalKind(imp.genericParams, typeConstraintUnion(sp.kind), bindings);
                boundK := bindings.getOr(sp.name, "");
                loop allConstraintMembers(cKind) as reqM {
                    if isInterfaceKind(reqM) {
                        if not self(boundK, reqM).found { ifaceBoundsOk = false; break; }
                    } else if not unionMembers(reqM).contains(boundK) {
                        ifaceBoundsOk = false;
                        break;
                    }
                }
                if not ifaceBoundsOk { break; }
            }
        }
        if not ifaceBoundsOk { continue; }
        return (found = true, implIdx = ci, bindingsEncoded = encodeImplBindings(imp.genericParams, bindings));
    }
    (found = false, implIdx = -1, bindingsEncoded = "")
};

/** Finds all visible 2-arg interface `impl`s (such as `Index<K, V>` / `IndexMut<K, V>`) matching `actualKind` and `reqKey`. */
pub findMatchingImplsByKey := fn(actualKind: String, reqKey: String): List<(implIdx: Int, bindingsEncoded: String, arg0: String, arg1: String)> {
    mut out: List<(implIdx: Int, bindingsEncoded: String, arg0: String, arg1: String)> = [];
    if actualKind == "" or reqKey == "" { return out; }
    owner := typeOpOwnerKey(actualKind);
    if owner == "" { return out; }
    candidates := interfaces.implIndicesForOwner(owner);
    loop candidates as ci {
        imp := interfaces.getImpl(ci);
        if not imp.isPub and activeImplModuleKey =!= "" and imp.declModule =!= activeImplModuleKey { continue; }
        if imp.ifaceKey =!= reqKey { continue; }
        mut bindings: Map<String, String>;
        if not unifyImplPatternMut(imp.genericParams, imp.targetPattern, actualKind, mut bindings) { continue; }
        var allBound := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if not bindings.has(sp.name) { allBound = false; break; }
        }
        if not allBound { continue; }
        var constraintsOk := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if isTypeConstraintKind(sp.kind) {
                cKind := substCanonicalKind(imp.genericParams, typeConstraintUnion(sp.kind), bindings);
                boundK := bindings.getOr(sp.name, "");
                loop allConstraintMembers(cKind) as reqM {
                    if isInterfaceKind(reqM) {
                        if not findImplForConcrete(boundK, reqM).found { constraintsOk = false; break; }
                    } else if not unionMembers(reqM).contains(boundK) {
                        constraintsOk = false; break;
                    }
                }
                if not constraintsOk { break; }
            }
        }
        if not constraintsOk { continue; }
        impArgs := if imp.ifaceArgsCsv == "" {
            empty: List<String> = [];
            empty
        } else {
            splitTopLevelKinds(imp.ifaceArgsCsv)
        };
        if impArgs.length() =!= 2 { continue; }
        arg0 := if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, impArgs[0], bindings) } else { impArgs[0] };
        arg1 := if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, impArgs[1], bindings) } else { impArgs[1] };
        mut out.pushBack((implIdx = ci, bindingsEncoded = encodeImplBindings(imp.genericParams, bindings), arg0 = arg0, arg1 = arg1));
    }
    out
};

/** Finds a visible conformance from `actualKind` to `type/error.ToError` (or legacy `core/error.ToError`) on `target`. */
pub findToErrorImpl := fn(target: String, actualKind: String): (found: Bool, implIdx: Int, bindingsEncoded: String) {
    typeModKey := if target == ir.TARGET_TS { "lib$type$error" } else { "lib_s_type_s_error" };
    typeRes := findImplForConcrete(actualKind, "Iface<" + typeModKey + "#ToError>");
    if typeRes.found { return typeRes; }
    legacyModKey := if target == ir.TARGET_TS { "lib$core$error" } else { "lib_s_core_s_error" };
    findImplForConcrete(actualKind, "Iface<" + legacyModKey + "#ToError>")
};

/** True when concrete `actualKind` satisfies closed-union, single-interface, or multi-bound `All<...>` constraint `constraintKind`. */
pub typeSatisfiesConstraint := fn(actualKind: String, constraintKind: String): Bool {
    if actualKind == "" or constraintKind == "" { return false; }
    loop allConstraintMembers(constraintKind) as req {
        if isInterfaceKind(req) {
            if not findImplForConcrete(actualKind, req).found { return false; }
        } else {
            if not unionMembers(req).contains(actualKind) { return false; }
        }
    }
    true
};

/** Finds a unique visible conformance method `methodName` on concrete `actualKind` (among all impls or restricted to `allowedIfaceKinds` when non-empty). */
pub findImplMethodForConcrete := fn(actualKind: String, methodName: String, allowedIfaceKinds: List<String>): (found: Bool, ambiguous: Bool, ifaceName: String, fnKey: String, implIdx: Int, bindingsEncoded: String, recvMut: Bool) {
    emptyRet := (found = false, ambiguous = false, ifaceName = "", fnKey = "", implIdx = -1, bindingsEncoded = "", recvMut = false);
    if actualKind == "" or methodName == "" { return emptyRet; }
    owner := typeOpOwnerKey(actualKind);
    candidates := interfaces.implIndicesForOwner(owner);
    var matchCount := 0;
    var bestIface := "";
    var bestFnKey := "";
    var bestImplIdx := -1;
    var bestBindings := "";
    var bestRecvMut := false;
    loop candidates as ci {
        imp := interfaces.getImpl(ci);
        if not imp.isPub and activeImplModuleKey =!= "" and imp.declModule =!= activeImplModuleKey { continue; }
        mut bindings: Map<String, String>;
        if not unifyImplPatternMut(imp.genericParams, imp.targetPattern, actualKind, mut bindings) { continue; }
        var allBound := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if not bindings.has(sp.name) { allBound = false; break; }
        }
        if not allBound { continue; }
        impArgs := if imp.ifaceArgsCsv == "" {
            empty: List<String> = [];
            empty
        } else {
            splitTopLevelKinds(imp.ifaceArgsCsv)
        };
        mut subArgs: List<String> = [];
        loop impArgs as ia {
            mut subArgs.pushBack(if imp.genericParams =!= "" { substCanonicalKind(imp.genericParams, ia, bindings) } else { ia });
        }
        instIface := buildInterfaceKind(imp.ifaceKey, subArgs);
        if allowedIfaceKinds.length() > 0 and not allowedIfaceKinds.contains(instIface) { continue; }
        var boundsOk := true;
        loop splitParamSpecs(imp.genericParams) as sp {
            if isTypeConstraintKind(sp.kind) {
                cKind := substCanonicalKind(imp.genericParams, typeConstraintUnion(sp.kind), bindings);
                if not typeSatisfiesConstraint(bindings.getOr(sp.name, ""), cKind) {
                    boundsOk = false;
                    break;
                }
            }
        }
        if not boundsOk { continue; }
        mb := interfaces.findBindingInImpl(imp, methodName);
        if not mb.found { continue; }
        if matchCount == 0 or mb.binding.fnKey =!= bestFnKey {
            matchCount = matchCount + 1;
            iIdx := interfaces.findInterface(imp.ifaceKey);
            bestIface = if iIdx >= 0 { interfaces.getInterface(iIdx).name } else { imp.ifaceKey };
            bestFnKey = mb.binding.fnKey;
            bestImplIdx = ci;
            bestBindings = encodeImplBindings(imp.genericParams, bindings);
            bestRecvMut = mb.binding.recvMut;
        }
    }
    if matchCount == 0 { return emptyRet; }
    if matchCount > 1 {
        return (found = false, ambiguous = true, ifaceName = bestIface, fnKey = "", implIdx = -1, bindingsEncoded = "", recvMut = false);
    }
    (found = true, ambiguous = false, ifaceName = bestIface, fnKey = bestFnKey, implIdx = bestImplIdx, bindingsEncoded = bestBindings, recvMut = bestRecvMut)
};

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array, List or callable kind to its TypeScript type. */
pub tsFunctionType := fn(kind: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind)); }
    if numeric.isIntKind(kind) { return "bigint"; }
    if kind == ir.VALUE_KIND_STRING { return "string"; }
    if kind == ir.VALUE_KIND_BOOL { return "boolean"; }
    if kind == ir.VALUE_KIND_UNIT { return "void"; }
    if kind == ir.VALUE_KIND_NEVER { return "never"; }
    if numeric.isFloatKind(kind) or (isEnumKind(kind) and not isPayloadEnumKind(kind)) { return "number"; }
    cached := tsTypeCache.get(kind);
    if cached.found { return cached.value; }
    var out := "";
    if isPayloadEnumKind(kind) {
        cc := enumCaseCount(kind);
        mut variants: List<String> = [];
        var ci := 0;
        loop ci < cc {
            ps := enumCasePayloads(kind, ci);
            mut vFieldsBuf: tb.TextBuilder;
            mut vFieldsBuf.append("readonly _t: ");
            mut vFieldsBuf.append(ci.toText());
            var pi := 0;
            loop pi < ps.length() {
                mut vFieldsBuf.append("; readonly _");
                mut vFieldsBuf.append(pi.toText());
                mut vFieldsBuf.append(": ");
                mut vFieldsBuf.append(self(ps[pi]));
                pi = pi + 1;
            }
            mut variants.pushBack("{ " + vFieldsBuf.build() + " }");
            ci = ci + 1;
        }
        out = "(" + variants.join(" | ") + ")";
    } else if isListKind(kind) { out = self(listElementKind(kind)) + "[]"; }
    else if isMapKind(kind) { out = "Map<" + self(mapKeyKind(kind)) + ", " + self(mapValueKind(kind)) + ">"; }
    else if isSetKind(kind) { out = "Set<" + self(setElementKind(kind)) + ">"; }
    else if isRcKind(kind) { out = "{ box: { count: number; value: " + self(rcElementKind(kind)) + " } | null }"; }
    else if isSliceKind(kind) { out = "{ readonly data: " + self(sliceElementKind(kind)) + "[]; readonly off: number; readonly len: number }"; }
    else if isDynKind(kind) {
        ifaceK := dynInterfaceKind(kind);
        methods := instantiatedInterfaceMethods(ifaceK);
        mut vtFields: List<String> = [];
        loop methods as m {
            mut pParts: List<String> = ["lite$ds: { v: unknown }"];
            if m.paramCount > 0 {
                var pStart := 0;
                pLen := m.params.length();
                var pIdx := 0;
                loop pStart <= pLen {
                    bar := m.params.indexOf("|", pStart);
                    pEnd := if bar < 0 { pLen } else { bar };
                    entry := m.params.slice(pStart, pEnd);
                    eq := entry.indexOf("=", 0);
                    if eq > 0 {
                        rawPK := entry.slice(eq + 1, entry.length());
                        pMut := rawPK.startsWithAt(0, "mut ");
                        pKind := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                        pTs := if pMut and isRecordOrDistinctRecord(pKind) { "{ v: " + self(pKind) + " }" } else { self(pKind) };
                        mut pParts.pushBack("a" + pIdx.toText() + ": " + pTs);
                        pIdx = pIdx + 1;
                    }
                    if bar < 0 { break; }
                    pStart = bar + 1;
                }
            }
            mut vtFields.pushBack("readonly " + m.name + ": (" + pParts.join(", ") + ") => " + self(m.result));
        }
        vtType := if vtFields.length() == 0 { "{}" } else { "{ " + vtFields.join("; ") + " }" };
        out = "{ readonly data: { v: unknown }; readonly vt: " + vtType + " }";
    }
    else if isSimdKind(kind) { out = self(simdElementKind(kind)) + "[]"; }
    else if isSoaKind(kind) {
        recK := soaRecordKind(kind);
        count := recordComponentCount(recK);
        if count == 0 {
            out = "{}";
        } else {
            mut soaBuf: tb.TextBuilder;
            mut soaBuf.append("{ ");
            var index := 0;
            loop index < count {
                comp := recordComponent(recK, index);
                if index > 0 { mut soaBuf.append("; "); }
                mut soaBuf.append(tupleObjectKey(comp.label, index));
                mut soaBuf.append(": ");
                mut soaBuf.append(self(comp.kind));
                mut soaBuf.append("[]");
                index = index + 1;
            }
            mut soaBuf.append(" }");
            out = soaBuf.build();
        }
    }
    else if isArrayKind(kind) { out = self(arrayElementKind(kind)) + "[]"; }
    else if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        mut resultBuf: tb.TextBuilder;
        mut resultBuf.append("{ ");
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            if index > 0 { mut resultBuf.append("; "); }
            mut resultBuf.append(tupleObjectKey(comp.label, index));
            mut resultBuf.append(": ");
            mut resultBuf.append(self(comp.kind));
            index = index + 1;
        }
        mut resultBuf.append(" }");
        out = resultBuf.build();
    }
    else if isRecordKind(kind) {
        count := recordComponentCount(kind);
        if count == 0 {
            out = "{}";
        } else {
            mut resultBuf: tb.TextBuilder;
            mut resultBuf.append("{ ");
            var index := 0;
            loop index < count {
                comp := recordComponent(kind, index);
                if index > 0 { mut resultBuf.append("; "); }
                mut resultBuf.append(tsRecordPropKey(comp.label));
                mut resultBuf.append(": ");
                mut resultBuf.append(self(comp.kind));
                index = index + 1;
            }
            mut resultBuf.append(" }");
            out = resultBuf.build();
        }
    } else if isCtxKind(kind) {
        mut ctxFieldsBuf: tb.TextBuilder;
        mut ctxFieldsBuf.append("{ ");
        var ci := 0;
        loop contexts.parseCtxKindSlots(kind) as cs {
            if ci > 0 { mut ctxFieldsBuf.append("; "); }
            mut ctxFieldsBuf.append("readonly ");
            mut ctxFieldsBuf.append(cs.name);
            mut ctxFieldsBuf.append(": ");
            fieldT := self(cs.kind);
            if cs.isMut and not isDynKind(cs.kind) and not isSliceKind(cs.kind) {
                mut ctxFieldsBuf.append("{ v: ");
                mut ctxFieldsBuf.append(fieldT);
                mut ctxFieldsBuf.append(" }");
            } else {
                mut ctxFieldsBuf.append(fieldT);
            }
            ci = ci + 1;
        }
        mut ctxFieldsBuf.append(" }");
        out = ctxFieldsBuf.build();
    } else if isUnionKind(kind) {
        mems := unionMembers(kind);
        mut uParts: List<String> = [];
        var ui := 0;
        loop ui < mems.length() {
            m := mems[ui];
            if m == ir.VALUE_KIND_UNIT {
                mut uParts.pushBack("{ readonly _u: " + ui.toText() + " }");
            } else {
                mut uParts.pushBack("{ readonly _u: " + ui.toText() + "; readonly _v: " + self(m) + " }");
            }
            ui = ui + 1;
        }
        out = "(" + uParts.join(" | ") + ")";
    } else if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        okPart := if okK == ir.VALUE_KIND_UNIT {
            "{ readonly _r: 0 }"
        } else {
            "{ readonly _r: 0; readonly _v: " + self(okK) + " }"
        };
        errPart := if errK == ir.VALUE_KIND_UNIT {
            "{ readonly _r: 1 }"
        } else {
            "{ readonly _r: 1; readonly _e: " + self(errK) + " }"
        };
        out = "(" + okPart + " | " + errPart + ")";
    } else if isFnKind(kind) {
        count := fnParamCount(kind);
        mut paramsBuf: tb.TextBuilder;
        var index := 0;
        loop index < count {
            comp := fnParamComponent(kind, index);
            if index > 0 { mut paramsBuf.append(", "); }
            paramLabel := if comp.label =!= "" { "lite_" + comp.label } else { "lite_arg" + index.toText() };
            isMutP := comp.kind.startsWithAt(0, "mut ");
            basePK := if isMutP { comp.kind.slice(4, comp.kind.length()) } else { comp.kind };
            tsPT := if isMutP and isRecordOrDistinctRecord(basePK) { "{ v: " + self(basePK) + " }" } else { self(basePK) };
            if fnParamIsOptional(kind, index) {
                mut paramsBuf.append(paramLabel);
                mut paramsBuf.append("?: ");
                mut paramsBuf.append(tsPT);
            } else {
                mut paramsBuf.append(paramLabel);
                mut paramsBuf.append(": ");
                mut paramsBuf.append(tsPT);
            }
            index = index + 1;
        }
        fnCtx := fnContextKind(kind);
        if fnCtx =!= "" {
            if count > 0 { mut paramsBuf.append(", "); }
            mut paramsBuf.append("lite$ctx: ");
            mut paramsBuf.append(self(fnCtx));
        }
        out = "((" + paramsBuf.build() + ") => " + self(fnResultKind(kind)) + ")";
    } else {
        out = tsLiteral.tsScalarType(kind);
    }
    (mut tsTypeCache).set(kind, out);
    out
};

/** Formats one canonical flat tuple kind as a TypeScript object type. */
pub tsTupleType := fn(kind: String): String {
    tsFunctionType(kind)
};

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
pub tsDisplayValueCode := fn(kind: String, code: String): String {
    if isDistinctKind(kind) { return self(distinctBaseKind(kind), code); }
    if ir.isIntScalarKind(kind) or ir.isFloatScalarKind(kind) { return "(" + code + ").toString()"; }
    if kind == ir.VALUE_KIND_BOOL { return "((" + code + ") ? \"true\" : \"false\")"; }
    if kind == ir.VALUE_KIND_UNIT { return "((value: unknown): string => { void value; return \"Unit\"; })(" + code + ")"; }
    if isListKind(kind) or isArrayKind(kind) {
        element := if isListKind(kind) { listElementKind(kind) } else { arrayElementKind(kind) };
        return "(\"[\" + (" + code + ").map((value: " + tsFunctionType(element) + ") => " + self(element, "value") + ").join(\", \") + \"]\")";
    }
    if isMapKind(kind) {
        keyKind := mapKeyKind(kind);
        valKind := mapValueKind(kind);
        return "(\"{\" + Array.from((" + code + ").entries()).map(([k, v]: [" + tsFunctionType(keyKind) + ", " + tsFunctionType(valKind) + "]) => " +
        self(keyKind, "k") + " + \": \" + " + self(valKind, "v") + ").join(\", \") + \"}\")";
    }
    if isSetKind(kind) {
        elemKind := setElementKind(kind);
        return "(\"{\" + Array.from((" + code + ").values()).map((v: " + tsFunctionType(elemKind) + ") => " +
        self(elemKind, "v") + ").join(\", \") + \"}\")";
    }
    if isRcKind(kind) {
        elemKind := rcElementKind(kind);
        return "((r: " + tsFunctionType(kind) + "): string => r.box === null ? \"Rc(empty)\" : (\"Rc(\" + ((v: " + tsFunctionType(elemKind) + "): string => " + self(elemKind, "v") + ")(r.box.value) + \")\"))(" + code + ")";
    }
    if isSliceKind(kind) {
        elemKind := sliceElementKind(kind);
        return "((s: " + tsFunctionType(kind) + "): string => \"[\" + s.data.slice(s.off, s.off + s.len).map((value: " + tsFunctionType(elemKind) + ") => " + self(elemKind, "value") + ").join(\", \") + \"]\")(" + code + ")";
    }
    if isDynKind(kind) {
        return tsLiteral.textLiteralCode("dyn " + displayKind(dynInterfaceKind(kind)));
    }
    if isSimdKind(kind) {
        elemKind := simdElementKind(kind);
        return "(\"Simd(\" + (" + code + ").map((value: " + tsFunctionType(elemKind) + ") => " + self(elemKind, "value") + ").join(\", \") + \")\")";
    }
    if isSoaKind(kind) {
        recK := soaRecordKind(kind);
        firstProp := if recordComponentCount(recK) > 0 { recordComponent(recK, 0).prop } else { "" };
        if firstProp == "" { return "\"SoA(len=0)\""; }
        return "(\"SoA(len=\" + (" + code + ")." + firstProp + ".length + \")\")";
    }
    if isPayloadEnumKind(kind) {
        enumName := enumDisplayName(kind);
        count := enumCaseCount(kind);
        mut casesBuf: tb.TextBuilder;
        var idx := 0;
        loop idx < count {
            cName := enumCaseAt(kind, idx).name;
            ps := enumCasePayloads(kind, idx);
            if ps.length() == 0 {
                mut casesBuf.append("case ");
                mut casesBuf.append(idx.toText());
                mut casesBuf.append(": return ");
                mut casesBuf.append(tsLiteral.textLiteralCode(enumName + "." + cName));
                mut casesBuf.append("; ");
            } else {
                mut dispExprBuf: tb.TextBuilder;
                mut dispExprBuf.append(tsLiteral.textLiteralCode(enumName + "." + cName + "("));
                var pi := 0;
                loop pi < ps.length() {
                    if pi > 0 { mut dispExprBuf.append(" + \", \""); }
                    mut dispExprBuf.append(" + ");
                    mut dispExprBuf.append(self(ps[pi], "value._" + pi.toText()));
                    pi = pi + 1;
                }
                mut dispExprBuf.append(" + \")\"");
                mut casesBuf.append("case ");
                mut casesBuf.append(idx.toText());
                mut casesBuf.append(": return ");
                mut casesBuf.append(dispExprBuf.build());
                mut casesBuf.append("; ");
            }
            idx = idx + 1;
        }
        return "((value: " + tsFunctionType(kind) + "): string => { switch (value._t) { " + casesBuf.build() + "default: return \"\"; } })(" + code + ")";
    }
    if isEnumKind(kind) {
        enumName := enumDisplayName(kind);
        count := enumCaseCount(kind);
        mut labels: List<String> = [];
        var idx := 0;
        loop idx < count {
            cInfo := enumCaseAt(kind, idx);
            mut labels.pushBack(tsLiteral.textLiteralCode(enumName + "." + cInfo.name));
            idx = idx + 1;
        }
        return "([" + labels.join(", ") + "][" + code + "]!)";
    }
    if isRecordKind(kind) {
        isAnon := isAnonRecordKind(kind);
        recName := if isAnon { "" } else { recordDisplayName(kind) };
        count := recordComponentCount(kind);
        if count == 0 {
            emptyDisp := if isAnon { "{}" } else { recName + " {}" };
            return "((value: {}): string => { void value; return " + tsLiteral.textLiteralCode(emptyDisp) + "; })(" + code + ")";
        }
        mut resultBuf: tb.TextBuilder;
        mut resultBuf.append(tsLiteral.textLiteralCode(if isAnon { "{ " } else { recName + " { " }));
        var index := 0;
        loop index < count {
            comp := recordComponent(kind, index);
            separator := if index == 0 { "" } else { ", " };
            keyDisp := if isAnon and not isSimpleRecordFieldIdent(comp.label) { "\"" + comp.label + "\"" } else { comp.label };
            mut resultBuf.append(" + ");
            mut resultBuf.append(tsLiteral.textLiteralCode(separator + keyDisp + " = "));
            mut resultBuf.append(" + ");
            mut resultBuf.append(self(comp.kind, tsRecordFieldAccess("value", comp.label)));
            index = index + 1;
        }
        return "((value: " + tsFunctionType(kind) + "): string => " + resultBuf.build() + " + " + tsLiteral.textLiteralCode(" }") + ")(" + code + ")";
    }
    if isUnionKind(kind) {
        mems := unionMembers(kind);
        mut casesBuf: tb.TextBuilder;
        var ui := 0;
        loop ui < mems.length() {
            m := mems[ui];
            mut casesBuf.append("case ");
            mut casesBuf.append(ui.toText());
            mut casesBuf.append(": return ");
            if m == ir.VALUE_KIND_UNIT {
                mut casesBuf.append("\"Unit\"");
            } else {
                mut casesBuf.append(self(m, "value._v"));
            }
            mut casesBuf.append("; ");
            ui = ui + 1;
        }
        return "((value: " + tsFunctionType(kind) + "): string => { switch (value._u) { " + casesBuf.build() + "default: return \"\"; } })(" + code + ")";
    }
    if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        okExpr := if okK == ir.VALUE_KIND_UNIT { "\".ok\"" } else { "(\".ok(\" + " + self(okK, "value._v") + " + \")\")" };
        errExpr := if errK == ir.VALUE_KIND_UNIT { "\".err\"" } else { "(\".err(\" + " + self(errK, "value._e") + " + \")\")" };
        return "((value: " + tsFunctionType(kind) + "): string => value._r === 0 ? " + okExpr + " : " + errExpr + ")(" + code + ")";
    }
    if isTupleKind(kind) {
        mut resultBuf: tb.TextBuilder;
        mut resultBuf.append(tsLiteral.textLiteralCode("("));
        count := tupleComponentCount(kind);
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            separator := if index == 0 { "" } else { ", " };
            prefixText := if comp.label == "" { separator } else { separator + comp.label + "=" };
            mut resultBuf.append(" + ");
            mut resultBuf.append(tsLiteral.textLiteralCode(prefixText));
            mut resultBuf.append(" + ");
            mut resultBuf.append(self(comp.kind, "value." + comp.prop));
            index = index + 1;
        }
        ending := if count == 1 { ",)" } else { ")" };
        return "((value: " + tsFunctionType(kind) + "): string => " + resultBuf.build() + " + " + tsLiteral.textLiteralCode(ending) + ")(" + code + ")";
    }
    code
};

/** Returns the canonical field type for `label` inside flat tuple `kind`, or `""` when absent. */
pub tupleFieldKind := fn(kind: String, label: String): String {
    if label == "" or kind.indexOf(label + ":", 0) < 0 { return ""; }
    size := kind.length();
    var cursor := 1;
    loop cursor < size and kind.at(cursor) =!= ")" {
        var fieldLabel := "";
        if kind.at(cursor) =!= ":" {
            nameStart := cursor;
            cursor = kind.skipName(cursor);
            fieldLabel = kind.slice(nameStart, cursor);
        }
        if cursor < size and kind.at(cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        if fieldLabel =!= "" and fieldLabel == label {
            return kind.slice(typeStart, cursor);
        }
        if cursor < size and kind.at(cursor) == "," { cursor = cursor + 1; }
    }
    ""
};

/** Renders one canonical kind or comptime value token for diagnostics, adding spaces inside flat tuples, lists, and callable signatures. */
pub displayKind := fn(kind: String): String {
    if isComptimeIntToken(kind) { return comptimeIntValue(kind).toText(); }
    if isComptimeBoolToken(kind) { return if comptimeBoolValue(kind) { "true" } else { "false" }; }
    if isComptimeStringToken(kind) { return "\"" + comptimeStringValue(kind) + "\""; }
    if isComptimeEnumToken(kind) {
        ek := comptimeEnumKind(kind);
        cName := enumCaseAt(ek, comptimeEnumCaseIndex(kind)).name;
        return enumDisplayName(ek) + "." + cName;
    }
    if isEnumKind(kind) { return enumDisplayName(kind); }
    if isUnionKind(kind) {
        mut parts: List<String> = [];
        loop unionMembers(kind) as m {
            mut parts.pushBack(self(m));
        }
        return parts.join(" | ");
    }
    if isResultKind(kind) {
        okK := resultOkKind(kind);
        errK := resultErrKind(kind);
        okStr := if isUnionKind(okK) or isResultKind(okK) { "(" + self(okK) + ")" } else { self(okK) };
        if errK == CORE_ERROR_KIND {
            return okStr + "!";
        }
        errStr := if isUnionKind(errK) or isResultKind(errK) { "(" + self(errK) + ")" } else { self(errK) };
        return okStr + " ! " + errStr;
    }
    if isRecordKind(kind) { return recordDisplayName(kind); }
    if isDistinctKind(kind) { return distinctDisplayName(kind); }
    if isListKind(kind) { return "List<" + self(listElementKind(kind)) + ">"; }
    if isMapKind(kind) { return "Map<" + self(mapKeyKind(kind)) + ", " + self(mapValueKind(kind)) + ">"; }
    if isSetKind(kind) { return "Set<" + self(setElementKind(kind)) + ">"; }
    if isRcKind(kind) { return "Rc<" + self(rcElementKind(kind)) + ">"; }
    if isSliceKind(kind) { return "Slice<" + self(sliceElementKind(kind)) + ">"; }
    if isInterfaceKind(kind) {
        iKey := ifaceKeyOf(kind);
        iIdx := interfaces.findInterface(iKey);
        iName := if iIdx >= 0 { interfaces.getInterface(iIdx).name } else {
            hashPos := iKey.indexOf("#", 0);
            if hashPos >= 0 { iKey.slice(hashPos + 1, iKey.length()) } else { iKey }
        };
        args := ifaceArgsOf(kind);
        if args.length() == 0 { return iName; }
        mut dArgs: List<String> = [];
        loop args as a { mut dArgs.pushBack(self(a)); }
        return iName + "<" + dArgs.join(", ") + ">";
    }
    if isDynKind(kind) { return "dyn " + self(dynInterfaceKind(kind)); }
    if isAssocKind(kind) {
        ap := parseAssocKind(kind);
        return self(ap.owner) + "." + ap.assocName;
    }
    if isAllConstraintKind(kind) {
        mut dParts: List<String> = [];
        loop allConstraintMembers(kind) as am { mut dParts.pushBack(self(am)); }
        return dParts.join(", ");
    }
    if isSimdKind(kind) { return "Simd<" + self(simdElementKind(kind)) + ", " + simdLaneCountText(kind) + ">"; }
    if isSimdNativeKind(kind) { return "SimdNative<" + self(simdNativeElementKind(kind)) + ">"; }
    if isSoaKind(kind) { return "SoA<" + self(soaRecordKind(kind)) + ">"; }
    if isArrayKind(kind) { return "[" + self(arrayElementKind(kind)) + "; " + arrayExtentText(kind) + "]"; }
    if isCtxKind(kind) {
        mut cParts: List<String> = [];
        loop contexts.parseCtxKindSlots(kind) as cs {
            mut cParts.pushBack((if cs.isMut { "mut " } else { "" }) + cs.name + ": " + self(cs.kind));
        }
        return "context(" + cParts.join(", ") + ")";
    }
    if isFnKind(kind) {
        count := fnParamCount(kind);
        mut resultBuf: tb.TextBuilder;
        mut resultBuf.append("fn(");
        var index := 0;
        loop index < count {
            comp := fnParamComponent(kind, index);
            isOpt := fnParamIsOptional(kind, index);
            if index > 0 { mut resultBuf.append(", "); }
            if comp.label == "" {
                if isOpt { mut resultBuf.append("?:"); }
                mut resultBuf.append(self(comp.kind));
            } else {
                mut resultBuf.append(comp.label);
                mut resultBuf.append(if isOpt { "?: " } else { ": " });
                mut resultBuf.append(self(comp.kind));
            }
            index = index + 1;
        }
        fnCtx := fnContextKind(kind);
        ctxDisp := if fnCtx =!= "" { " " + self(fnCtx) } else { "" };
        return resultBuf.build() + ")" + ctxDisp + ": " + self(fnResultKind(kind));
    }
    if not isTupleKind(kind) { return kind; }
    count := tupleComponentCount(kind);
    mut resultBuf: tb.TextBuilder;
    mut resultBuf.append("(");
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { mut resultBuf.append(", "); }
        if comp.label == "" {
            mut resultBuf.append(self(comp.kind));
        } else {
            mut resultBuf.append(comp.label);
            mut resultBuf.append(": ");
            mut resultBuf.append(self(comp.kind));
        }
        index = index + 1;
    }
    if count == 1 and tupleComponent(kind, 0).label == "" { mut resultBuf.append(","); }
    resultBuf.build() + ")"
};

/** True when `kind` is an admissible scalar enum backing type. */
isEnumBackingKind := fn(kind: String): Bool {
    numeric.isIntKind(kind) or numeric.isFloatKind(kind) or kind == ir.VALUE_KIND_STRING or kind == ir.VALUE_KIND_BOOL
};

/** Parses one enum case backing literal from `rawText` (signed Int/Float, String, or Bool) and returns its kind, TS code, and integer value. */
parseEnumCaseLiteral := fn(rawText: String, expectedBacking: String, prefix: String): (ok: Bool, kind: String, code: String, intValue: Int, error: String) {
    size := rawText.length();
    pos := syntax.skipTrivia(rawText, 0, prefix);
    if pos >= size {
        return (ok = false, kind = "", code = "", intValue = 0, error = "expected constant value for enum case");
    }
    ch := rawText.at(pos);
    if rawText.wordAt(pos, "true") or rawText.wordAt(pos, "false") {
        isTrue := rawText.wordAt(pos, "true");
        endPos := pos + (if isTrue { 4 } else { 5 });
        if syntax.skipTrivia(rawText, endPos, prefix) < size {
            return (ok = false, kind = "", code = "", intValue = 0, error = "unexpected text after enum case value");
        }
        return (ok = true, kind = ir.VALUE_KIND_BOOL, code = if isTrue { "true" } else { "false" }, intValue = if isTrue { 1 } else { 0 }, error = "");
    }
    if ch == "\"" {
        lit := syntax.parseText(ir.TARGET_TS, rawText, pos, prefix);
        if syntax.skipTrivia(rawText, lit.next, prefix) < size {
            return (ok = false, kind = "", code = "", intValue = 0, error = "unexpected text after enum case value");
        }
        return (ok = true, kind = ir.VALUE_KIND_STRING, code = escapeEnumStringLiteral(lit.code), intValue = 0, error = "");
    }
    isNeg := ch == "-";
    isSign := ch == "-" or ch == "+";
    numPos := if isSign { syntax.skipTrivia(rawText, pos + 1, prefix) } else { pos };
    if numPos < size and rawText.at(numPos).isDigit() {
        hintKind := if isNeg and numeric.isIntKind(expectedBacking) {
            ir.VALUE_KIND_INT
        } else if numeric.isNumericKind(expectedBacking) {
            expectedBacking
        } else {
            ""
        };
        lit := syntax.parseNumber(ir.TARGET_TS, rawText, numPos, prefix, hintKind, 10);
        if syntax.skipTrivia(rawText, lit.next, prefix) < size {
            return (ok = false, kind = "", code = "", intValue = 0, error = "unexpected text after enum case value");
        }
        if numeric.isFloatKind(lit.kind) {
            fCode := if isNeg { "-" + lit.code } else { lit.code };
            return (ok = true, kind = lit.kind, code = fCode, intValue = 0, error = "");
        }
        if numeric.isIntKind(lit.kind) {
            finalInt := if isNeg {
                neg := lit.intValue.checkedNeg();
                if not neg.ok {
                    return (ok = false, kind = "", code = "", intValue = 0, error = "enum case integer value out of range");
                }
                neg.value
            } else {
                lit.intValue
            };
            targetIntKind := if numeric.isIntKind(expectedBacking) { expectedBacking } else { lit.kind };
            if not numeric.intKindFits(targetIntKind, finalInt) {
                return (ok = false, kind = "", code = "", intValue = 0, error = "enum case value does not fit " + displayKind(targetIntKind));
            }
            if numeric.isFloatKind(expectedBacking) {
                fLit := finalInt.toText();
                return (ok = true, kind = expectedBacking, code = if expectedBacking == ir.VALUE_KIND_FLOAT32 { "Math.fround(" + fLit + ")" } else { fLit }, intValue = 0, error = "");
            }
            intCode := if finalInt < 0 { "(-" + (0 - finalInt).toText() + "n)" } else { finalInt.toText() + "n" };
            return (ok = true, kind = targetIntKind, code = intCode, intValue = finalInt, error = "");
        }
    }
    (ok = false, kind = "", code = "", intValue = 0, error = "enum case value must be a scalar constant literal")
};

/** Builds canonical `Enum<...>` from decoded `@enumraw:` header, resolved optional backing kind, and length-prefixed `(name, rawVal)` pairs. */
buildCanonicalEnumKind := fn(hdrText: String, explicitBacking: String, rawSource: String, casesStart: Int, caseCount: Int, prefix: String): (ok: Bool, kind: String, next: Int, error: String) {
    if caseCount <= 0 {
        return (ok = false, kind = "", next = casesStart, error = "enum must declare at least one case");
    }
    if explicitBacking =!= "" and not isEnumBackingKind(explicitBacking) {
        return (ok = false, kind = "", next = casesStart, error = "unsupported enum backing type " + displayKind(explicitBacking));
    }
    mut names: List<String> = [];
    mut rawVals: List<String> = [];
    var cur := casesStart;
    var hasAnyVal := false;
    var firstValText := "";
    var idx := 0;
    loop idx < caseCount {
        nDec := decodeLengthPrefixedAt(rawSource, cur);
        if nDec.next < 0 { return (ok = false, kind = "", next = casesStart, error = "malformed enum case name"); }
        vDec := decodeLengthPrefixedAt(rawSource, nDec.next);
        if vDec.next < 0 { return (ok = false, kind = "", next = casesStart, error = "malformed enum case value"); }
        if names.contains(nDec.text) {
            return (ok = false, kind = "", next = casesStart, error = "duplicate enum case " + nDec.text);
        }
        (mut names).pushBack(nDec.text);
        mut rawVals.pushBack(vDec.text);
        if vDec.text =!= "" and not hasAnyVal {
            hasAnyVal = true;
            firstValText = vDec.text;
        }
        cur = vDec.next;
        idx = idx + 1;
    }
    var backingKind := explicitBacking;
    if backingKind == "" and hasAnyVal {
        probe := parseEnumCaseLiteral(firstValText, "", prefix);
        if not probe.ok {
            return (ok = false, kind = "", next = casesStart, error = probe.error);
        }
        backingKind = probe.kind;
    }
    mut encodedPairsBuf: tb.TextBuilder;
    var nextInt := 0;
    var cIdx := 0;
    loop cIdx < caseCount {
        cName := names[cIdx];
        cRaw := rawVals[cIdx];
        var valCode := "";
        if backingKind == "" {
            valCode = "";
        } else if cRaw =!= "" {
            lit := parseEnumCaseLiteral(cRaw, backingKind, prefix);
            if not lit.ok {
                return (ok = false, kind = "", next = casesStart, error = lit.error);
            }
            if lit.kind =!= backingKind {
                return (ok = false, kind = "", next = casesStart, error = "enum case " + cName + " value has type " + displayKind(lit.kind) + ", expected " + displayKind(backingKind));
            }
            valCode = lit.code;
            if numeric.isIntKind(backingKind) {
                nextInt = lit.intValue + 1;
            }
        } else if numeric.isIntKind(backingKind) {
            if not numeric.intKindFits(backingKind, nextInt) {
                return (ok = false, kind = "", next = casesStart, error = "enum case " + cName + " auto-assigned value does not fit " + displayKind(backingKind));
            }
            valCode = if nextInt < 0 { "(-" + (0 - nextInt).toText() + "n)" } else { nextInt.toText() + "n" };
            nextInt = nextInt + 1;
        } else {
            return (ok = false, kind = "", next = casesStart, error = "enum case " + cName + " requires an explicit " + displayKind(backingKind) + " backing value");
        }
        mut encodedPairsBuf.append(encodeLengthPrefixedText(cName));
        mut encodedPairsBuf.append(encodeLengthPrefixedText(valCode));
        cIdx = cIdx + 1;
    }
    canonical := "Enum<" + encodeLengthPrefixedText(hdrText) + encodeLengthPrefixedText(backingKind) + caseCount.toText() + ";" + encodedPairsBuf.build() + ">";
    (ok = true, kind = canonical, next = cur, error = "")
};

/** Resolves a scalar backing type name through non-generic aliases (`Int`, `Float`, `String`, `Bool`, etc.) without calling `failAt`. */
resolveScalarAliasKind := fn(aliases: List<AliasDecl>, rawName: String, prefix: String): String {
    var cur := rawName;
    var activeAliases := aliases;
    var hops := 0;
    loop hops < 32 {
        clean := syntax.skipTrivia(cur, 0, prefix);
        var end := cur.length();
        loop end > clean and (cur.at(end - 1) == " " or cur.at(end - 1) == "\t" or cur.at(end - 1) == "\n" or cur.at(end - 1) == "\r") {
            end = end - 1;
        }
        name := cur.slice(clean, end);
        if name == ir.VALUE_KIND_INT or name == ir.VALUE_KIND_FLOAT or name == "Double" {
            idx := findAlias(activeAliases, name);
            if idx >= 0 {
                item := activeAliases[idx];
                cur = if (item.target).startsWithAt(0, "$Kind:") { (item.target).slice(6, (item.target).length()) } else { item.target };
                activeAliases = aliasesUpToDepth(activeAliases, item.depth);
                hops = hops + 1;
                continue;
            }
        }
        if name == ir.VALUE_KIND_INT or name == ir.VALUE_KIND_FLOAT or name == ir.VALUE_KIND_STRING or
        name == ir.VALUE_KIND_BOOL or numeric.isNarrowNumericKind(name) {
            return name;
        }
        nk := numeric.numericAliasKind(name);
        if nk =!= "" { return nk; }
        idx := findAlias(activeAliases, name);
        if idx < 0 { return ""; }
        item := activeAliases[idx];
        if (item.target).startsWithAt(0, "$Kind:") {
            cur = (item.target).slice(6, (item.target).length());
        } else {
            cur = item.target;
        }
        activeAliases = aliasesUpToDepth(activeAliases, item.depth);
        hops = hops + 1;
    }
    ""
};

/** Resolves the lexical `Int` alias in scope to its underlying integer kind, defaulting to `"Int"`. */
pub defaultIntKind := fn(aliases: List<AliasDecl>, prefix: String): String {
    resolved := resolveScalarAliasKind(aliases, ir.VALUE_KIND_INT, prefix);
    if resolved =!= "" and numeric.isIntKind(resolved) { resolved } else { ir.VALUE_KIND_INT }
};

/** Resolves the lexical `Float` alias in scope to its underlying float kind, defaulting to `"Float"`. */
pub defaultFloatKind := fn(aliases: List<AliasDecl>, prefix: String): String {
    resolved := resolveScalarAliasKind(aliases, ir.VALUE_KIND_FLOAT, prefix);
    if resolved =!= "" and numeric.isFloatKind(resolved) { resolved } else { ir.VALUE_KIND_FLOAT }
};

/** Resolves a raw discrete comptime parameter type (`Int`, `Bool`, `String`, or payload-free `Enum`) non-destructively. */
resolveDiscreteType := fn(aliases: List<AliasDecl>, rawTypeName: String, prefix: String): (ok: Bool, kind: String, error: String) {
    var cur := rawTypeName;
    var activeAliases := aliases;
    var hops := 0;
    loop hops < 32 {
        if cur == ir.VALUE_KIND_INT or cur == ir.VALUE_KIND_BOOL or cur == ir.VALUE_KIND_STRING {
            return (ok = true, kind = cur, error = "");
        }
        if isEnumKind(cur) {
            if isPayloadEnumKind(cur) {
                return (ok = false, kind = "", error = "unsupported comptime parameter type " + enumDisplayName(cur) + "; payload-bearing enums cannot be comptime value parameters");
            }
            return (ok = true, kind = cur, error = "");
        }
        if cur.startsWithAt(0, "@enumraw:") {
            hdr := decodeLengthPrefixedAt(cur, 9);
            bkRaw := decodeLengthPrefixedAt(cur, hdr.next);
            if hdr.next < 0 or bkRaw.next < 0 {
                return (ok = false, kind = "", error = "malformed enum declaration");
            }
            var curPos := bkRaw.next;
            var countEnd := curPos;
            loop countEnd < cur.length() and cur.at(countEnd).isDigit() { countEnd = countEnd + 1; }
            caseCount := if countEnd > curPos { syntax.parseDigits(cur, curPos, countEnd) } else { 0 };
            curPos = if countEnd < cur.length() and cur.at(countEnd) == ";" { countEnd + 1 } else { countEnd };
            preChk := enumRawPreCheck(cur, bkRaw.text, curPos, caseCount);
            if preChk.hasPayload {
                return (ok = false, kind = "", error = "unsupported comptime parameter type " + headerDisplayName(hdr.text) + "; payload-bearing enums cannot be comptime value parameters");
            }
            var resolvedBacking := "";
            if bkRaw.text =!= "" {
                resolvedBacking = resolveScalarAliasKind(activeAliases, bkRaw.text, prefix);
                if resolvedBacking == "" {
                    return (ok = false, kind = "", error = "unsupported enum backing type " + bkRaw.text);
                }
            }
            built := buildCanonicalEnumKind(hdr.text, resolvedBacking, cur, curPos, caseCount, prefix);
            if not built.ok { return (ok = false, kind = "", error = built.error); }
            return (ok = true, kind = built.kind, error = "");
        }
        if cur == ir.VALUE_KIND_FLOAT or cur == ir.VALUE_KIND_FLOAT32 or cur == ir.VALUE_KIND_UNIT or
        cur == ir.VALUE_KIND_NEVER or numeric.isNarrowNumericKind(cur) or numeric.numericAliasKind(cur) =!= "" {
            return (ok = false, kind = "", error = "unsupported comptime parameter type " + cur + "; only Int, Bool, String, and payload-free enums are supported");
        }
        idx := findAlias(activeAliases, cur);
        if idx < 0 {
            return (ok = false, kind = "", error = "unknown comptime parameter type " + cur);
        }
        item := activeAliases[idx];
        tgt := item.target;
        if tgt == "" or tgt.startsWithAt(0, "@recraw:") or tgt.startsWithAt(0, "@distraw:") or
        tgt.startsWithAt(0, "@genraw:") or tgt.startsWithAt(0, "@gentpl:") or tgt.startsWithAt(0, "$Val:") or
        isRecordKind(tgt) or isDistinctKind(tgt) or isTupleKind(tgt) or isListKind(tgt) or
        isArrayKind(tgt) or isMapKind(tgt) or isSetKind(tgt) or isRcKind(tgt) or isSliceKind(tgt) or isSimdKind(tgt) or isSimdNativeKind(tgt) or isSoaKind(tgt) or isFnKind(tgt) or
        tgt.startsWithAt(0, "(") or tgt.startsWithAt(0, "[") or tgt.startsWithAt(0, "fn") {
            return (ok = false, kind = "", error = "unsupported comptime parameter type " + rawTypeName + "; only Int, Bool, String, and payload-free enums are supported");
        }
        cur = if tgt.startsWithAt(0, "$Kind:") { tgt.slice(6, tgt.length()) } else { tgt };
        activeAliases = aliasesUpToDepth(activeAliases, item.depth);
        hops = hops + 1;
    }
    (ok = false, kind = "", error = "recursive type alias " + rawTypeName)
};

/** Validates that a double-quoted string literal at `position` closes cleanly with supported escapes so `parseText` cannot throw. */
canScanValidStringLiteral := fn(source: String, position: Int, prefix: String): Bool {
    size := source.length();
    var cursor := position + 1;
    loop cursor < size {
        ch := source.at(cursor);
        if ch == "\"" {
            next := syntax.skipTrivia(source, cursor + 1, prefix);
            if next < size and source.at(next) == "\"" {
                cursor = next + 1;
                continue;
            }
            return true;
        }
        if ch == "\\" {
            if cursor + 1 >= size { return false; }
            esc := source.at(cursor + 1);
            if esc =!= "n" and esc =!= "t" and esc =!= "r" and esc =!= "\"" and esc =!= "\\" {
                return false;
            }
            cursor = cursor + 2;
        } else {
            cursor = cursor + 1;
        }
    }
    false
};

/** Parses one comptime value argument inside `<...>` (`Int`, `Bool`, `String`, payload-free `enum`, param, or `$Val:` alias) without throwing. */
pub parseComptimeValueArg := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, expectedKind: String): (ok: Bool, token: String, next: Int, errPos: Int, errMsg: String) {
    size := source.length();
    start := syntax.skipTrivia(source, position, prefix);
    if start >= size {
        return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value");
    }
    ch := source.at(start);
    if ch == "\"" {
        if not canScanValidStringLiteral(source, start, prefix) {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "invalid string literal in comptime argument");
        }
        lit := syntax.parseText(ir.TARGET_TS, source, start, prefix);
        if expectedKind =!= ir.VALUE_KIND_STRING {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got String");
        }
        return (ok = true, token = comptimeStringToken(lit.textValue), next = lit.next, errPos = -1, errMsg = "");
    }
    if ch == "-" or ch == "+" or ch.isDigit() {
        isNeg := ch == "-";
        isSign := ch == "-" or ch == "+";
        numPos := if isSign { syntax.skipTrivia(source, start + 1, prefix) } else { start };
        if numPos >= size or not source.at(numPos).isDigit() {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected integer literal in comptime argument");
        }
        scanned := numeric.scanNumericLiteral(source, numPos);
        if scanned.floating {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "floating values are not supported as comptime arguments");
        }
        if scanned.exponentMissingAt >= 0 or scanned.outsideInt or (not isNeg and scanned.magnitude == -9223372036854775808) {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "integer comptime argument outside signed 64-bit range");
        }
        if expectedKind =!= ir.VALUE_KIND_INT {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got Int");
        }
        val := if isNeg { scanned.magnitude } else { 0 - scanned.magnitude };
        return (ok = true, token = comptimeIntToken(val), next = scanned.next, errPos = -1, errMsg = "");
    }
    if source.wordAt(start, "true") or source.wordAt(start, "false") {
        isTrue := source.wordAt(start, "true");
        endPos := start + (if isTrue { 4 } else { 5 });
        if expectedKind =!= ir.VALUE_KIND_BOOL {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got Bool");
        }
        return (ok = true, token = comptimeBoolToken(isTrue), next = endPos, errPos = -1, errMsg = "");
    }
    if source.wordAt(start, "not") {
        subStart := syntax.skipTrivia(source, start + 3, prefix);
        sub := self(source, subStart, prefix, aliases, genericType, ir.VALUE_KIND_BOOL);
        if not sub.ok { return sub; }
        if expectedKind =!= ir.VALUE_KIND_BOOL {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got Bool");
        }
        if not isComptimeBoolToken(sub.token) {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "comptime argument negation requires a concrete Bool constant");
        }
        return (ok = true, token = comptimeBoolToken(not comptimeBoolValue(sub.token)), next = sub.next, errPos = -1, errMsg = "");
    }
    if not ch.isNameStart() {
        return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value");
    }
    firstEnd := source.skipName(start);
    first := source.slice(start, firstEnd);
    if syntax.isReservedWord(first) {
        return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value");
    }
    afterFirst := syntax.skipTrivia(source, firstEnd, prefix);
    if afterFirst < size and source.at(afterFirst) == "." {
        secondStart := syntax.skipTrivia(source, afterFirst + 1, prefix);
        if secondStart >= size or not source.at(secondStart).isNameStart() {
            return (ok = false, token = "", next = secondStart, errPos = secondStart, errMsg = "expected case name after .");
        }
        secondEnd := source.skipName(secondStart);
        second := source.slice(secondStart, secondEnd);
        afterSecond := syntax.skipTrivia(source, secondEnd, prefix);
        if afterSecond >= size or source.at(afterSecond) =!= "." {
            ctDotAlias := findAlias(aliases, "$ctv:" + first + "." + second);
            if ctDotAlias >= 0 and (aliases[ctDotAlias].target).startsWithAt(0, "$Val:") {
                tok := (aliases[ctDotAlias].target).slice(5, (aliases[ctDotAlias].target).length());
                actualKind := comptimeValueTokenKind(tok);
                if actualKind =!= expectedKind {
                    return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got " + displayKind(actualKind));
                }
                return (ok = true, token = tok, next = secondEnd, errPos = -1, errMsg = "");
            }
        }
        var typeName := first;
        var caseName := second;
        var finalEnd := secondEnd;
        if afterSecond < size and source.at(afterSecond) == "." {
            thirdStart := syntax.skipTrivia(source, afterSecond + 1, prefix);
            if thirdStart >= size or not source.at(thirdStart).isNameStart() {
                return (ok = false, token = "", next = thirdStart, errPos = thirdStart, errMsg = "expected case name after .");
            }
            thirdEnd := source.skipName(thirdStart);
            typeName = first + "." + second;
            caseName = source.slice(thirdStart, thirdEnd);
            finalEnd = thirdEnd;
        }
        resolved := resolveDiscreteType(aliases, typeName, prefix);
        if not resolved.ok or not isEnumKind(resolved.kind) {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected an enum type before ." + caseName);
        }
        if resolved.kind =!= expectedKind {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got " + displayKind(resolved.kind));
        }
        caseIdx := enumCaseIndex(resolved.kind, caseName);
        if caseIdx < 0 {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "enum " + enumDisplayName(resolved.kind) + " has no case " + caseName);
        }
        return (ok = true, token = comptimeEnumToken(resolved.kind, caseIdx), next = finalEnd, errPos = -1, errMsg = "");
    }
    vpKind := valueParamKind(genericType, first);
    if vpKind =!= "" {
        if vpKind =!= expectedKind {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got " + displayKind(vpKind));
        }
        return (ok = true, token = first, next = firstEnd, errPos = -1, errMsg = "");
    }
    aliasIdx := findAlias(aliases, first);
    ctAliasIdx := if aliasIdx >= 0 { aliasIdx } else { findAlias(aliases, "$ctv:" + first) };
    if ctAliasIdx >= 0 and (aliases[ctAliasIdx].target).startsWithAt(0, "$Val:") {
        tok := (aliases[ctAliasIdx].target).slice(5, (aliases[ctAliasIdx].target).length());
        actualKind := comptimeValueTokenKind(tok);
        if actualKind =!= expectedKind {
            return (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got " + displayKind(actualKind));
        }
        return (ok = true, token = tok, next = firstEnd, errPos = -1, errMsg = "");
    }
    (ok = false, token = "", next = start, errPos = start, errMsg = "expected comptime " + displayKind(expectedKind) + " value, got " + first)
};

/** Parses a fixed-array extent token (comptime `Int` param name, `$Val:` integer alias, or positive integer digits) followed by `closeSym`. */
parseArrayExtentWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, extentStart: Int, closeSym: String, closeErrMsg: String, prefix: String, aliases: List<AliasDecl>, genericType: String): (extText: String, next: Int) {
    size := source.length();
    var extText := "";
    var extentEnd := extentStart;
    if extentStart < size and source.at(extentStart).isNameStart() {
        extentEnd = source.skipName(extentStart);
        extName := source.slice(extentStart, extentEnd);
        afterExtDot := syntax.skipTrivia(source, extentEnd, prefix);
        if afterExtDot < size and source.at(afterExtDot) == "." {
            subStart := syntax.skipTrivia(source, afterExtDot + 1, prefix);
            if subStart < size and source.at(subStart).isNameStart() {
                subEnd := source.skipName(subStart);
                subName := source.slice(subStart, subEnd);
                ctDotIdx := findAlias(aliases, "$ctv:" + extName + "." + subName);
                if ctDotIdx >= 0 and (aliases[ctDotIdx].target).startsWithAt(0, "$Val:") {
                    tok := (aliases[ctDotIdx].target).slice(5, (aliases[ctDotIdx].target).length());
                    if not isComptimeIntToken(tok) {
                        syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent must be an Int, got " + displayKind(comptimeValueTokenKind(tok)));
                    }
                    nVal := comptimeIntValue(tok);
                    if nVal <= 0 {
                        syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent must be a positive integer, got " + nVal.toText());
                    }
                    extText = nVal.toText();
                    extentEnd = subEnd;
                } else {
                    syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "expected positive integer or Int comptime parameter extent in array type");
                }
            } else {
                syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "expected positive integer or Int comptime parameter extent in array type");
            }
        } else {
            vpKind := valueParamKind(genericType, extName);
            if vpKind == ir.VALUE_KIND_INT {
                extText = extName;
            } else if vpKind =!= "" {
                syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent must be an Int, got " + displayKind(vpKind));
            } else if isGenericParamName(genericType, extName) {
                syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent cannot be Type parameter " + extName);
            } else {
                aliasIdx := findAlias(aliases, extName);
                ctAliasIdx := if aliasIdx >= 0 { aliasIdx } else { findAlias(aliases, "$ctv:" + extName) };
                if ctAliasIdx >= 0 and (aliases[ctAliasIdx].target).startsWithAt(0, "$Val:") {
                    tok := (aliases[ctAliasIdx].target).slice(5, (aliases[ctAliasIdx].target).length());
                    if not isComptimeIntToken(tok) {
                        syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent must be an Int, got " + displayKind(comptimeValueTokenKind(tok)));
                    }
                    nVal := comptimeIntValue(tok);
                    if nVal <= 0 {
                        syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "array extent must be a positive integer, got " + nVal.toText());
                    }
                    extText = nVal.toText();
                } else {
                    syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "expected positive integer or Int comptime parameter extent in array type");
                }
            }
        }
    } else {
        loop extentEnd < size and source.at(extentEnd).isDigit() {
            extentEnd = extentEnd + 1;
        }
        if extentEnd == extentStart {
            syntax.failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "expected positive integer extent in array type");
        }
        extent := syntax.parseDigits(source, extentStart, extentEnd);
        extText = extent.toText();
    }
    afterExtent := syntax.skipTrivia(source, extentEnd, prefix);
    if afterExtent >= size or source.at(afterExtent) =!= closeSym {
        syntax.failAt(errSource, if useLocalErr { afterExtent } else { errPos }, prefix, if useLocalErr { "expected " + closeSym } else { closeErrMsg });
    }
    (extText = extText, next = afterExtent + 1)
};

/** Parses `context([mut] name: [mut] Type, ...)` using caller's type-atom parser callback, returning canonical `Ctx<...>`. */
parseContextClauseWith := fn(
parseAtom: fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int),
errSource: String, errPos: Int, useLocalErr: Bool, source: String, kwPos: Int, prefix: String,
aliases: List<AliasDecl>, genericType: String, seen: List<String>
): (ctxKind: String, next: Int) {
    size := source.length();
    var cursor := syntax.skipTrivia(source, kwPos + 7, prefix);
    cursor = syntax.expectSymbol(source, cursor, "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    if cursor < size and source.at(cursor) == ")" {
        syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "context requirement list cannot be empty");
    }
    mut slots: List<contexts.CtxSlot> = [];
    mut slotNames: List<String> = [];
    loop cursor < size and source.at(cursor) =!= ")" {
        if source.wordAt(cursor, "mut") {
            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "place mut on the context slot type (e.g. context(name: mut Type))");
        }
        var isMut := false;
        if cursor >= size or not source.at(cursor).isNameStart() {
            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected context slot name");
        }
        nameStart := cursor;
        nameEnd := source.skipName(nameStart);
        slotName := source.slice(nameStart, nameEnd);
        if syntax.isReservedWord(slotName) {
            syntax.unsupportedFeature(errSource, if useLocalErr { nameStart } else { errPos }, slotName, prefix);
        }
        if slotNames.contains(slotName) {
            syntax.failAt(errSource, if useLocalErr { nameStart } else { errPos }, prefix, "duplicate context slot " + slotName);
        }
        mut slotNames.pushBack(slotName);
        cursor = syntax.skipTrivia(source, nameEnd, prefix);
        cursor = syntax.expectSymbol(source, cursor, ":", prefix);
        cursor = syntax.skipTrivia(source, cursor, prefix);
        if source.wordAt(cursor, "mut") {
            if isMut {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "duplicate mut qualifier on context slot " + slotName);
            }
            isMut = true;
            cursor = syntax.skipTrivia(source, cursor + 3, prefix);
        }
        typed := parseAtom(errSource, errPos, useLocalErr, source, cursor, prefix, aliases, "context", genericType, seen);
        if typed.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "context slot " + slotName + " cannot have type Unit");
        }
        mut slots.pushBack(contexts.CtxSlot { name = slotName, isMut = isMut, kind = typed.kind });
        cursor = syntax.skipTrivia(source, typed.next, prefix);
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ")" {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected context slot name");
            }
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    (ctxKind = contexts.buildCanonicalCtxKind(slots), next = cursor)
};

/** True when `pos` starts a syntactically valid type atom or leading `|` union marker (not `=`, `{`, `}`, `,`, `)`, `>`, `]`, `;`, or reserved non-type keyword). */
startsTypeTokenAt := fn(source: String, pos: Int, prefix: String): Bool {
    size := source.length();
    if pos >= size { return false; }
    ch := source.at(pos);
    if ch == "(" or ch == "[" { return true; }
    if ch == "|" and not source.startsWithAt(pos, "||") { return true; }
    if not ch.isNameStart() { return false; }
    end := source.skipName(pos);
    w := source.slice(pos, end);
    not syntax.isReservedWord(w) or w == "fn" or w == "dyn"
};

/** Internal helper parsing one base atomic source or alias type (before `.Assoc` projections). */
parseTypeBaseAtomWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int) {
    size := source.length();
    start := syntax.skipTrivia(source, position, prefix);
    if not useLocalErr and start < size and source.startsWithAt(start, "Union<") {
        end := skipKindToken(source, start);
        if end > start + 7 and source.at(end - 1) == ">" {
            uKind := source.slice(start, end);
            return (kind = uKind, next = end);
        }
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "Result<") {
        end := skipKindToken(source, start);
        if end > start + 8 and source.at(end - 1) == ">" {
            rKind := source.slice(start, end);
            if isResultKind(rKind) {
                return (kind = rKind, next = end);
            }
        }
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "$Assoc<") {
        end := skipKindToken(source, start);
        if end > start + 8 and source.at(end - 1) == ">" {
            aKind := source.slice(start, end);
            if isAssocKind(aKind) {
                return (kind = aKind, next = end);
            }
        }
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "@enumraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 9);
        bkRaw := decodeLengthPrefixedAt(source, hdr.next);
        var cur := bkRaw.next;
        var countEnd := cur;
        loop countEnd < size and source.at(countEnd).isDigit() {
            countEnd = countEnd + 1;
        }
        caseCount := if countEnd > cur { syntax.parseDigits(source, cur, countEnd) } else { 0 };
        cur = if countEnd < size and source.at(countEnd) == ";" { countEnd + 1 } else { countEnd };
        var resolvedBacking := "";
        if bkRaw.text =!= "" {
            bkParsed := self(errSource, errPos, false, bkRaw.text, 0, prefix, aliases, "enum backing", "", seen);
            if syntax.skipTrivia(bkRaw.text, bkParsed.next, prefix) < bkRaw.text.length() {
                syntax.failAt(errSource, errPos, prefix, "unexpected text after enum backing type");
            }
            resolvedBacking = bkParsed.kind;
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        preChk := enumRawPreCheck(source, resolvedBacking, cur, caseCount);
        if not preChk.ok {
            syntax.failAt(errSource, errPos, prefix, preChk.error);
        }
        if preChk.hasPayload {
            mut encodedPairsBuf: tb.TextBuilder;
            var pCur := cur;
            var ci := 0;
            loop ci < caseCount {
                nDec := decodeLengthPrefixedAt(source, pCur);
                vDec := decodeLengthPrefixedAt(source, nDec.next);
                pCur = vDec.next;
                var payCsv := "";
                if vDec.text.startsWithAt(0, "@pay:") {
                    rawPay := vDec.text.slice(5, vDec.text.length());
                    mut payItems: List<String> = [];
                    if not splitPayloadTypeTexts(rawPay, prefix, mut payItems) {
                        syntax.failAt(errSource, errPos, prefix, "enum case " + nDec.text + " payload requires at least one type");
                    }
                    mut pKinds: List<String> = [];
                    loop payItems as rp {
                        pRes := parseTypeWithSeen(errSource, errPos, false, rp, 0, prefix, aliases, "enum payload", genericType, seen);
                        if syntax.skipTrivia(rp, pRes.next, prefix) < rp.length() {
                            syntax.failAt(errSource, errPos, prefix, "unexpected text in enum case " + nDec.text + " payload");
                        }
                        if pRes.kind == ir.VALUE_KIND_UNIT or pRes.kind == ir.VALUE_KIND_NEVER {
                            syntax.failAt(errSource, errPos, prefix, "unsupported enum payload type " + displayKind(pRes.kind));
                        }
                        mut pKinds.pushBack(pRes.kind);
                    }
                    payCsv = pKinds.join(",");
                }
                mut encodedPairsBuf.append(encodeLengthPrefixedText(nDec.text));
                mut encodedPairsBuf.append(encodeLengthPrefixedText(payCsv));
                ci = ci + 1;
            }
            return (kind = "Enum<" + encodeLengthPrefixedText(effHdr) + encodeLengthPrefixedText("$payload") + caseCount.toText() + ";" + encodedPairsBuf.build() + ">", next = pCur);
        }
        built := buildCanonicalEnumKind(effHdr, resolvedBacking, source, cur, caseCount, prefix);
        if not built.ok {
            syntax.failAt(errSource, errPos, prefix, built.error);
        }
        return (kind = built.kind, next = built.next);
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "Enum<") {
        end := skipKindToken(source, start);
        if end > start + 6 and source.at(end - 1) == ">" {
            return (kind = source.slice(start, end), next = end);
        }
    }
    if not useLocalErr and start < size and (source.startsWithAt(start, "Iface<") or source.startsWithAt(start, "Dyn<")) {
        end := skipKindToken(source, start);
        if end > start + 4 and source.at(end - 1) == ">" {
            return (kind = source.slice(start, end), next = end);
        }
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "@recraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 8);
        var cur := hdr.next;
        var countEnd := cur;
        loop countEnd < size and source.at(countEnd).isDigit() {
            countEnd = countEnd + 1;
        }
        fieldCount := if countEnd > cur { syntax.parseDigits(source, cur, countEnd) } else { 0 };
        cur = if countEnd < size and source.at(countEnd) == ";" { countEnd + 1 } else { countEnd };
        mut parts: List<String> = [];
        var idx := 0;
        loop idx < fieldCount {
            fName := decodeLengthPrefixedAt(source, cur);
            fType := decodeLengthPrefixedAt(source, fName.next);
            cur = fType.next;
            resolvedField := parseTypeWithSeen(errSource, errPos, false, fType.text, 0, prefix, aliases, "record field", genericType, seen);
            if syntax.skipTrivia(fType.text, resolvedField.next, prefix) < fType.text.length() {
                syntax.failAt(errSource, errPos, prefix, "unexpected text after type");
            }
            if resolvedField.kind == ir.VALUE_KIND_UNIT {
                syntax.failAt(errSource, errPos, prefix, "unsupported record field type Unit");
            }
            bErr := borrowedStorageError(resolvedField.kind);
            if bErr =!= "" {
                syntax.failAt(errSource, errPos, prefix, bErr);
            }
            (mut parts).pushBack(fName.text + ":" + resolvedField.kind);
            idx = idx + 1;
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        return (kind = "Record<" + effHdr + ";" + parts.join(",") + ">", next = cur);
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "Record<") {
        end := skipKindToken(source, start);
        if end > start + 8 and source.at(end - 1) == ">" and recordHeaderSemi(source.slice(start, end)) > 7 {
            return (kind = source.slice(start, end), next = end);
        }
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "@distraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 9);
        rawTarget := decodeLengthPrefixedAt(source, hdr.next);
        if rawTarget.text == "" {
            syntax.failAt(errSource, errPos, prefix, "expected a type after distinct");
        }
        resolvedBase := parseTypeWithSeen(errSource, errPos, false, rawTarget.text, 0, prefix, aliases, "distinct", genericType, seen);
        if syntax.skipTrivia(rawTarget.text, resolvedBase.next, prefix) < rawTarget.text.length() {
            syntax.failAt(errSource, errPos, prefix, "unexpected text after type");
        }
        if resolvedBase.kind == ir.VALUE_KIND_UNIT or resolvedBase.kind == ir.VALUE_KIND_NEVER {
            syntax.failAt(errSource, errPos, prefix, "unsupported distinct underlying type " + displayKind(resolvedBase.kind));
        }
        if isUnionKind(resolvedBase.kind) {
            syntax.failAt(errSource, errPos, prefix, "cannot define distinct over union " + displayKind(resolvedBase.kind));
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        return (kind = "Distinct<" + encodeLengthPrefixedText(effHdr) + resolvedBase.kind + ">", next = rawTarget.next);
    }
    if not useLocalErr and start < size and source.startsWithAt(start, "Distinct<") {
        end := skipKindToken(source, start);
        if end > start + 10 and source.at(end - 1) == ">" {
            return (kind = source.slice(start, end), next = end);
        }
    }
    if start < size and source.at(start) == "(" {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        mut labels: List<String> = [];
        mut kindTextBuf: tb.TextBuilder;
        mut kindTextBuf.append("(");
        var count := 0;
        var hadComma := false;
        var singleLabel := "";
        var singleKind := "";
        var hadColon := false;
        if cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
            grouped := parseTypeWithSeen(errSource, errPos, useLocalErr, source, cursor, prefix, aliases, context, genericType, seen);
            closeG := syntax.skipTrivia(source, grouped.next, prefix);
            if closeG >= size or source.at(closeG) =!= ")" {
                syntax.failAt(errSource, if useLocalErr { closeG } else { errPos }, prefix, "expected ) in grouped union type");
            }
            return (kind = grouped.kind, next = closeG + 1);
        }
        loop true {
            if cursor >= size {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected ) in tuple type");
            }
            if source.at(cursor) == ")" {
                cursor = cursor + 1;
                break;
            }
            var label := "";
            var componentStart := cursor;
            if source.at(cursor) == ":" {
                hadColon = true;
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor >= size or not startsTypeTokenAt(source, cursor, prefix) {
                    syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field type");
                }
                componentStart = cursor;
            } else {
                if source.at(cursor).isNameStart() {
                    firstStart := cursor;
                    firstEnd := source.skipName(cursor);
                    firstName := source.slice(firstStart, firstEnd);
                    afterFirst := syntax.skipTrivia(source, firstEnd, prefix);
                    if afterFirst < size and source.at(afterFirst) == ":" {
                        label = firstName;
                        if syntax.isReservedWord(label) {
                            syntax.unsupportedFeature(errSource, if useLocalErr { firstStart } else { errPos }, label, prefix);
                        }
                        if labels.contains(label) {
                            syntax.failAt(errSource, if useLocalErr { firstStart } else { errPos }, prefix, "duplicate tuple field " + label);
                        }
                        (mut labels).pushBack(label);
                        cursor = syntax.skipTrivia(source, afterFirst + 1, prefix);
                        if cursor >= size or not startsTypeTokenAt(source, cursor, prefix) {
                            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field type");
                        }
                        componentStart = cursor;
                    }
                } else if not startsTypeTokenAt(source, cursor, prefix) {
                    syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field name");
                }
            }
            isSingleCandidate := count == 0 and label == "" and not hadColon;
            compCtx := if isSingleCandidate { context } else { "tuple field" };
            parsedComponent := parseTypeWithSeen(errSource, errPos, useLocalErr, source, componentStart, prefix, aliases, compCtx, genericType, seen);
            componentKind := parsedComponent.kind;
            cursor = syntax.skipTrivia(source, parsedComponent.next, prefix);
            diagPos := if useLocalErr { componentStart } else { errPos };
            willBeTuple := (count > 0) or hadColon or hadComma or (cursor < size and source.at(cursor) == ",");
            if willBeTuple {
                if isTupleKind(componentKind) {
                    syntax.failAt(errSource, diagPos, prefix, "nested tuple types are not supported");
                }
                if isListKind(componentKind) {
                    syntax.failAt(errSource, diagPos, prefix, "list types inside tuples are not supported");
                }
                if componentKind == ir.VALUE_KIND_UNIT {
                    syntax.failAt(errSource, diagPos, prefix, "unsupported tuple component type Unit");
                }
            }
            if containsDynKind(componentKind) {
                syntax.failAt(errSource, diagPos, prefix, "borrowed dyn Interface cannot be stored in owning container or type definition");
            }
            if count > 0 { mut kindTextBuf.append(","); }
            mut kindTextBuf.append(label);
            mut kindTextBuf.append(":");
            mut kindTextBuf.append(componentKind);
            if count == 0 { singleLabel = label; singleKind = componentKind; }
            count = count + 1;
            if cursor < size and source.at(cursor) == "," {
                hadComma = true;
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            }
        }
        if count == 0 {
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "tuple type needs at least one field");
        }
        if count == 1 and singleLabel == "" and not hadComma {
            if hadColon {
                syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "unnamed singleton tuple type needs trailing comma");
            }
            return (kind = singleKind, next = cursor);
        }
        mut kindTextBuf.append(")");
        return (kind = kindTextBuf.build(), next = cursor);
    }
    if start < size and source.at(start) == "{" {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        mut labels: List<String> = [];
        mut fields: List<(label: String, kind: String)> = [];
        loop cursor < size and source.at(cursor) =!= "}" {
            var label := "";
            labelAt := cursor;
            if source.at(cursor) == "\"" {
                qParsed := syntax.parseText(ir.TARGET_TS, source, cursor, prefix);
                label = qParsed.textValue;
                cursor = syntax.skipTrivia(source, qParsed.next, prefix);
            } else if source.at(cursor).isNameStart() {
                labelEnd := source.skipName(cursor);
                label = source.slice(cursor, labelEnd);
                if syntax.isReservedWord(label) {
                    syntax.unsupportedFeature(errSource, if useLocalErr { cursor } else { errPos }, label, prefix);
                }
                cursor = syntax.skipTrivia(source, labelEnd, prefix);
            } else {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected field name in structural record type");
            }
            if labels.contains(label) {
                syntax.failAt(errSource, if useLocalErr { labelAt } else { errPos }, prefix, "duplicate record field " + label);
            }
            mut labels.pushBack(label);
            if cursor >= size or source.at(cursor) =!= ":" {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected : after field name " + label + " in record type");
            }
            fTypeStart := syntax.skipTrivia(source, cursor + 1, prefix);
            fParsed := parseTypeWithSeen(errSource, errPos, useLocalErr, source, fTypeStart, prefix, aliases, "record field", genericType, seen);
            if fParsed.kind == ir.VALUE_KIND_UNIT {
                syntax.failAt(errSource, if useLocalErr { fTypeStart } else { errPos }, prefix, "unsupported record field type Unit");
            }
            bErr := borrowedStorageError(fParsed.kind);
            if bErr =!= "" {
                syntax.failAt(errSource, if useLocalErr { fTypeStart } else { errPos }, prefix, bErr);
            }
            mut fields.pushBack((label = label, kind = fParsed.kind));
            cursor = syntax.skipTrivia(source, fParsed.next, prefix);
            if cursor < size and (source.at(cursor) == "," or source.at(cursor) == ";") {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            } else if cursor < size and source.at(cursor) == "}" {
                break;
            } else {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected , or } in structural record type");
            }
        }
        if cursor >= size or source.at(cursor) =!= "}" {
            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected } in structural record type");
        }
        return (kind = buildAnonRecordKind(fields), next = cursor + 1);
    }
    if start < size and source.at(start) == "[" {
        elemStart := syntax.skipTrivia(source, start + 1, prefix);
        inner := parseTypeWithSeen(errSource, errPos, useLocalErr, source, elemStart, prefix, aliases, "array element", genericType, seen);
        if inner.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(errSource, if useLocalErr { elemStart } else { errPos }, prefix, "unsupported array element type Unit");
        }
        bErr := borrowedStorageError(inner.kind);
        if bErr =!= "" {
            syntax.failAt(errSource, if useLocalErr { elemStart } else { errPos }, prefix, bErr);
        }
        afterElem := syntax.skipTrivia(source, inner.next, prefix);
        if afterElem >= size or source.at(afterElem) =!= ";" {
            syntax.failAt(errSource, if useLocalErr { afterElem } else { errPos }, prefix, if useLocalErr { "expected ;" } else { "expected [Type; Extent] in array type" });
        }
