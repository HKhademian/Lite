    if source.wordAt(start, "fn") {
        afterFn := syntax.skipTrivia(source, start + 2, prefix);
        if afterFn < size and source.at(afterFn) == "(" {
            var cursor := syntax.skipTrivia(source, afterFn + 1, prefix);
            mut paramLabels: List<String> = [];
            mut encodedBuf: tb.TextBuilder;
            mut encodedBuf.append("fn(");
            var count := 0;
            loop true {
                if cursor >= size {
                    syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected ) in function type");
                }
                if source.at(cursor) == ")" {
