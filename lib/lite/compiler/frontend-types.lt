        seenKey := (aliasItem.depth).toText() + ":" + name;
        if aliasItem.target == "" {
            unsupportedAliasTarget(errSource, aliasItem.at, prefix, "target");
            return (kind = "", next = after);
        }
        if (aliasItem.target).startsWithAt(0, "$Kind:") {
            return (kind = (aliasItem.target).slice(6, (aliasItem.target).length()), next = after);
        }
        if (aliasItem.target).startsWithAt(0, "$BuiltinFamily:") {
            fam := (aliasItem.target).slice(15, (aliasItem.target).length());
            syntax.failAt(errSource, nameStart, prefix, "generic type " + fam + " requires explicit type arguments");
            return (kind = "", next = after);
        }
        isGenRaw := (aliasItem.target).startsWithAt(0, "@genraw:");
        isGenTpl := (aliasItem.target).startsWithAt(0, "@gentpl:");
        if isGenRaw or isGenTpl {
            pDec := decodeLengthPrefixedAt(aliasItem.target, 8);
            tplParamsCsv := pDec.text;
            tplBody := (aliasItem.target).slice(pDec.next, (aliasItem.target).length());
            if afterName >= size or source.at(afterName) =!= "<" {
                if name == "Self" {
                    famDisplay := if isRecordKind(tplBody) {
                        semi := recordHeaderSemi(tplBody);
                        hdr := if semi > 7 { tplBody.slice(7, semi) } else { "" };
                        headerDisplayName(hdr.slice(0, headerBaseEnd(hdr)))
                    } else if isDistinctKind(tplBody) {
                        headerDisplayName(distinctMeta(tplBody).header)
                    } else if isEnumKind(tplBody) {
                        headerDisplayName(enumIdentityHeader(tplBody))
                    } else {
                        "Self"
                    };
                    syntax.failAt(errSource, nameStart, prefix, "generic type " + famDisplay + " requires explicit type arguments on Self<...>");
                }
                syntax.failAt(errSource, nameStart, prefix, "generic type " + name + " requires explicit type arguments");
            }
            scopedTplAliases := aliasesUpToDepth(aliases, aliasItem.depth);
            var resolvedTplParamsCsv := tplParamsCsv;
            if isGenRaw and tplParamsCsv =!= "" {
                mut resSpecs: List<String> = [];
                emptySpecSeen: List<String> = [];
                loop splitParamSpecs(tplParamsCsv) as sp {
                    if sp.kind == "" {
                        mut resSpecs.pushBack(sp.name);
                    } else if isTypeConstraintKind(sp.kind) {
                        rawBounds := typeConstraintUnion(sp.kind);
                        mut boundList: List<String> = [];
                        loop splitTopLevelCommaRaw(rawBounds, prefix) as rb {
                            var bCur := syntax.skipTrivia(rb, 0, prefix);
                            bAtom0 := self(errSource, aliasItem.at, false, rb, bCur, prefix, scopedTplAliases, "constraint", "", emptySpecSeen);
                            if bAtom0.kind == ir.VALUE_KIND_UNIT or bAtom0.kind == ir.VALUE_KIND_NEVER {
                                syntax.failAt(errSource, aliasItem.at, prefix, "unsupported type constraint member " + displayKind(bAtom0.kind));
                            }
                            mut bMembers: List<String> = [bAtom0.kind];
                            bCur = syntax.skipTrivia(rb, bAtom0.next, prefix);
                            loop bCur < rb.length() and rb.at(bCur) == "|" and not rb.startsWithAt(bCur, "||") {
                                bNext := syntax.skipTrivia(rb, bCur + 1, prefix);
                                bAtom := self(errSource, aliasItem.at, false, rb, bNext, prefix, scopedTplAliases, "constraint", "", emptySpecSeen);
                                if bAtom.kind == ir.VALUE_KIND_UNIT or bAtom.kind == ir.VALUE_KIND_NEVER {
                                    syntax.failAt(errSource, aliasItem.at, prefix, "unsupported type constraint member " + displayKind(bAtom.kind));
                                }
                                mut bMembers.pushBack(bAtom.kind);
                                bCur = syntax.skipTrivia(rb, bAtom.next, prefix);
                            }
                            if bCur < rb.length() {
                                syntax.failAt(errSource, aliasItem.at, prefix, "unexpected text after type constraint");
                            }
                            mut boundList.pushBack(buildUnionKind(bMembers));
                        }
                        inter := intersectConstraintBounds(boundList);
                        if not inter.ok {
                            syntax.failAt(errSource, aliasItem.at, prefix, "unsatisfiable empty type constraint on parameter " + sp.name);
                        }
                        mut resSpecs.pushBack(sp.name + "=Type<" + inter.kind + ">");
                    } else {
                        dRes := resolveDiscreteType(scopedTplAliases, sp.kind, prefix);
                        if not dRes.ok { syntax.failAt(errSource, aliasItem.at, prefix, dRes.error); }
                        mut resSpecs.pushBack(sp.name + "=" + dRes.kind);
                    }
                }
                resolvedTplParamsCsv = resSpecs.join(",");
            }
            paramSpecs := splitParamSpecs(resolvedTplParamsCsv);
            var argCursor := syntax.skipTrivia(source, afterName + 1, prefix);
            if argCursor >= size or source.at(argCursor) == ">" {
                syntax.failAt(errSource, if useLocalErr { argCursor } else { errPos }, prefix, "expected at least one type argument in " + name + "<...>");
            }
            mut argKinds: List<String> = [];
            var argIdx := 0;
            loop true {
                if argIdx >= paramSpecs.length() {
                    syntax.failAt(errSource, if useLocalErr { argCursor } else { errPos }, prefix,
                    "generic type " + name + " expects " + paramSpecs.length().toText() + " comptime argument(s)");
                }
                pSpec := paramSpecs[argIdx];
                if isTypeParamKind(pSpec.kind) {
                    argParsed := parseTypeWithSeen(errSource, errPos, useLocalErr, source, argCursor, prefix, aliases, "type argument", genericType, seen);
                    mut argKinds.pushBack(argParsed.kind);
                    argCursor = syntax.skipTrivia(source, argParsed.next, prefix);
                } else {
                    valArg := parseComptimeValueArg(source, argCursor, prefix, aliases, genericType, pSpec.kind);
                    if not valArg.ok {
                        syntax.failAt(errSource, if useLocalErr { valArg.errPos } else { errPos }, prefix, valArg.errMsg);
                    }
                    mut argKinds.pushBack(valArg.token);
                    argCursor = syntax.skipTrivia(source, valArg.next, prefix);
                }
                argIdx = argIdx + 1;
                if argCursor < size and source.at(argCursor) == "," {
                    argCursor = syntax.skipTrivia(source, argCursor + 1, prefix);
                    if argCursor < size and source.at(argCursor) == ">" { break; }
                } else {
                    break;
                }
            }
            if argCursor >= size or source.at(argCursor) =!= ">" {
                syntax.failAt(errSource, if useLocalErr { argCursor } else { errPos }, prefix, if useLocalErr { "expected >" } else { "expected > in generic type " + name });
            }
            afterClose := argCursor + 1;
            if argKinds.length() =!= paramSpecs.length() {
                syntax.failAt(errSource, nameStart, prefix, "generic type " + name + " expects " + paramSpecs.length().toText() + " comptime argument(s), got " + argKinds.length().toText());
            }
            var chkIdx := 0;
            loop chkIdx < paramSpecs.length() {
                cSpec := paramSpecs[chkIdx];
                if isTypeConstraintKind(cSpec.kind) {
                    constraint := typeConstraintUnion(cSpec.kind);
                    argK := argKinds[chkIdx];
                    if isGenericParamName(genericType, argK) {
                        outerC := typeParamConstraintKind(genericType, argK);
                        if outerC == "" or not constraintIsSubset(outerC, constraint) {
                            syntax.failAt(errSource, nameStart, prefix, "type " + argK + " does not satisfy constraint " + displayKind(constraint) + " for parameter " + cSpec.name);
                        }
                    } else if not kindHasAnyGenericParam(genericType, argK) {
                        if not typeSatisfiesConstraint(argK, constraint) {
                            syntax.failAt(errSource, nameStart, prefix, "type " + displayKind(argK) + " does not satisfy constraint " + displayKind(constraint) + " for parameter " + cSpec.name);
                        }
                    }
                }
                chkIdx = chkIdx + 1;
            }
            var templateKind := tplBody;
            if isGenRaw {
                if seen.contains(seenKey) {
                    syntax.failAt(errSource, aliasItem.at, prefix, "recursive type alias " + name);
                    return (kind = "", next = afterClose);
                }
                mut nextSeen: List<String> = [];
                loop seen as sEntry { mut nextSeen.pushBack(sEntry); }
                (mut nextSeen).pushBack(seenKey);
                resolved := parseTypeWithSeen(errSource, aliasItem.at, false, tplBody, 0, prefix, scopedTplAliases, "alias", resolvedTplParamsCsv, nextSeen);
                trailing := syntax.skipTrivia(tplBody, resolved.next, prefix);
                if trailing < tplBody.length() {
                    syntax.failAt(errSource, aliasItem.at, prefix, "unexpected text after type");
                }
                templateKind = resolved.kind;
            }
            mut bindings: Map<String, String>;
            var bi := 0;
            loop bi < paramSpecs.length() {
                mut bindings.set(paramSpecs[bi].name, argKinds[bi]);
                bi = bi + 1;
            }
            instKind := substCanonicalKind(resolvedTplParamsCsv, templateKind, bindings);
            if isInterfaceKind(instKind) {
                if context =!= "alias" and context =!= "constraint" and context =!= "dyn" and context =!= "impl" {
                    syntax.failAt(errSource, nameStart, prefix, "interface " + displayKind(instKind) + " cannot be used directly as a value type; use T: Type<" + displayKind(instKind) + "> for static dispatch or dyn " + displayKind(instKind) + " for dynamic dispatch");
                }
                loop ifaceArgsOf(instKind) as ia {
                    iaErr := validateCanonicalKind(ia, genericType);
                    if iaErr =!= "" { syntax.failAt(errSource, nameStart, prefix, iaErr); }
                }
            } else {
                valErr := validateCanonicalKind(instKind, genericType);
                if valErr =!= "" {
                    syntax.failAt(errSource, nameStart, prefix, valErr);
                }
            }
            return (kind = instKind, next = afterClose);
        }
        if seen.contains(seenKey) {
            syntax.failAt(errSource, aliasItem.at, prefix, "recursive type alias " + name);
            return (kind = "", next = after);
        }
        mut nextSeen: List<String> = seen;
        mut nextSeen.pushBack(seenKey);
        scopedAliases := aliasesUpToDepth(aliases, aliasItem.depth);
        aliasCtx := if context == "constraint" { "constraint" } else { "alias" };
        resolved := parseTypeWithSeen(errSource, aliasItem.at, false, aliasItem.target, 0, prefix, scopedAliases, aliasCtx, "", nextSeen);
        trailing := syntax.skipTrivia(aliasItem.target, resolved.next, prefix);
        if trailing < (aliasItem.target).length() {
            syntax.failAt(errSource, aliasItem.at, prefix, "unexpected text after type");
        }
        return (kind = resolved.kind, next = after);
    }
    if name == "Rc" or name == "Slice" or name == "Simd" or name == "SimdNative" or name == "SoA" {
        failMissingBuiltinFamily(errSource, nameStart, prefix, name);
    }
    if not useLocalErr and isUnsupportedAliasTarget(name) {
        unsupportedAliasTarget(errSource, errPos, prefix, name);
        return (kind = "", next = after);
    }
    if name == "Error" {
        return (kind = CORE_ERROR_KIND, next = after);
    }
    if name.indexOf(".", 0) >= 0 or not useLocalErr {
        syntax.failAt(errSource, nameStart, prefix, "unknown type alias " + name);
    } else {
        syntax.failAt(errSource, nameStart, prefix, "unsupported " + context + " type " + name);
    }
    (kind = "", next = after)
};

/** Parses one atomic type (including trailing `.Assoc` projections on concrete, generic, or `Box<T>` types). */
parseTypeAtomWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int) {
    base := parseTypeBaseAtomWithSeen(errSource, errPos, useLocalErr, source, position, prefix, aliases, context, genericType, seen);
    var resKind := base.kind;
    var resNext := base.next;
    size := source.length();
    isExprOrPatCtx := context == "type expression" or context == "enum pattern" or context == "pattern type";
    var cursor := syntax.skipTrivia(source, resNext, prefix);
    loop cursor < size and source.at(cursor) == "." {
        assocStart := syntax.skipTrivia(source, cursor + 1, prefix);
        if assocStart >= size or not source.at(assocStart).isNameStart() {
            if isExprOrPatCtx { break; }
            syntax.failAt(errSource, assocStart, prefix, "expected associated type name after .");
        }
        assocEnd := source.skipName(assocStart);
        assocName := source.slice(assocStart, assocEnd);
        resolved := tryResolveConcreteAssoc(resKind, assocName);
        if resolved.ambiguous {
            syntax.failAt(errSource, assocStart, prefix, "ambiguous associated type " + displayKind(resKind) + "." + assocName);
        }
        if not resolved.found {
            if isExprOrPatCtx { break; }
            syntax.failAt(errSource, assocStart, prefix, "type " + displayKind(resKind) + " has no associated type " + assocName);
        }
        resKind = resolved.kind;
        resNext = assocEnd;
        cursor = syntax.skipTrivia(source, resNext, prefix);
    }
    (kind = resKind, next = resNext)
};

/** Parses one source or alias type (including `|` unions, optional leading `|`, `!` fallibles, and attached `T!`) with cycle tracking `seen`. */
pub parseTypeWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int) {
    size := source.length();
    var start := syntax.skipTrivia(source, position, prefix);
    var hadLeadingBar := false;
    if start < size and source.at(start) == "|" and not source.startsWithAt(start, "||") {
        hadLeadingBar = true;
        start = syntax.skipTrivia(source, start + 1, prefix);
    }
    first := parseTypeAtomWithSeen(errSource, errPos, useLocalErr, source, start, prefix, aliases, context, genericType, seen);
    var endBeforeTrivia := first.next;
    var cursor := syntax.skipTrivia(source, first.next, prefix);
    var leftKind := first.kind;
    if cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
        if leftKind == ir.VALUE_KIND_NEVER or (context == "constraint" and leftKind == ir.VALUE_KIND_UNIT) {
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, if context == "constraint" { "unsupported type set member " + displayKind(leftKind) } else { "unsupported union member " + displayKind(leftKind) });
        }
        if isInterfaceKind(leftKind) {
            msg := if context == "constraint" { "interface " + displayKind(leftKind) + " cannot appear in closed | type union; use comma-separated bounds Type<A, B>" } else { "interface " + displayKind(leftKind) + " cannot appear in union value type" };
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, msg);
        }
        if context =!= "constraint" {
            lbErr := borrowedStorageError(leftKind);
            if lbErr =!= "" { syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, lbErr); }
        } else if genericType =!= "" and kindHasAnyGenericParam(genericType, leftKind) {
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "type set union members must be concrete types");
        }
        mut members: List<String> = [leftKind];
        loop cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
            nextStart := syntax.skipTrivia(source, cursor + 1, prefix);
            atom := parseTypeAtomWithSeen(errSource, errPos, useLocalErr, source, nextStart, prefix, aliases, context, genericType, seen);
            if atom.kind == ir.VALUE_KIND_NEVER or (context == "constraint" and atom.kind == ir.VALUE_KIND_UNIT) {
                syntax.failAt(errSource, if useLocalErr { nextStart } else { errPos }, prefix, if context == "constraint" { "unsupported type set member " + displayKind(atom.kind) } else { "unsupported union member " + displayKind(atom.kind) });
            }
            if isInterfaceKind(atom.kind) {
                msg := if context == "constraint" { "interface " + displayKind(atom.kind) + " cannot appear in closed | type union; use comma-separated bounds Type<A, B>" } else { "interface " + displayKind(atom.kind) + " cannot appear in union value type" };
                syntax.failAt(errSource, if useLocalErr { nextStart } else { errPos }, prefix, msg);
            }
            if context =!= "constraint" {
                abErr := borrowedStorageError(atom.kind);
                if abErr =!= "" { syntax.failAt(errSource, if useLocalErr { nextStart } else { errPos }, prefix, abErr); }
            } else if genericType =!= "" and kindHasAnyGenericParam(genericType, atom.kind) {
                syntax.failAt(errSource, if useLocalErr { nextStart } else { errPos }, prefix, "type set union members must be concrete types");
            }
            mut members.pushBack(atom.kind);
            endBeforeTrivia = atom.next;
            cursor = syntax.skipTrivia(source, atom.next, prefix);
        }
        leftKind = buildUnionKind(members);
    } else if hadLeadingBar {
        if leftKind == ir.VALUE_KIND_NEVER or isInterfaceKind(leftKind) or (context == "constraint" and leftKind == ir.VALUE_KIND_UNIT) {
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "unsupported union member " + displayKind(leftKind));
        }
        if context =!= "constraint" {
            lbErr := borrowedStorageError(leftKind);
            if lbErr =!= "" { syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, lbErr); }
        }
    }
    if isInterfaceKind(leftKind) and context =!= "alias" and context =!= "constraint" and context =!= "dyn" and context =!= "impl" {
        syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "interface " + displayKind(leftKind) + " cannot be used directly as a value type; use T: Type<" + displayKind(leftKind) + "> for static dispatch or dyn " + displayKind(leftKind) + " for dynamic dispatch");
    }
    if cursor < size and source.at(cursor) == "!" {
        if context == "constraint" {
            syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "fallible ! type cannot be used inside Type<...> constraints");
        }
        if leftKind == ir.VALUE_KIND_NEVER {
            syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "unsupported fallible success type Never");
        }
        lbErr := borrowedStorageError(leftKind);
        if lbErr =!= "" { syntax.failAt(errSource, if useLocalErr { start } else { errPos }, prefix, lbErr); }
        isAttached := cursor == endBeforeTrivia;
        afterBang := syntax.skipTrivia(source, cursor + 1, prefix);
        if afterBang < size and source.at(afterBang) == "!" {
            syntax.failAt(errSource, if useLocalErr { afterBang } else { errPos }, prefix, "unexpected ! in fallible type; parenthesize as (T!) ! E if intended");
        }
        if not startsTypeTokenAt(source, afterBang, prefix) {
            if not isAttached {
                syntax.failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "detached fallible suffix ! requires an explicit error type; attach ! directly for T! shorthand");
            }
            return (kind = buildResultKind(leftKind, CORE_ERROR_KIND), next = cursor + 1);
        }
        var errStart := afterBang;
        if errStart < size and source.at(errStart) == "|" and not source.startsWithAt(errStart, "||") {
            errStart = syntax.skipTrivia(source, errStart + 1, prefix);
        }
        errFirst := parseTypeAtomWithSeen(errSource, errPos, useLocalErr, source, errStart, prefix, aliases, context, genericType, seen);
        if errFirst.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(errFirst.kind) {
            syntax.failAt(errSource, if useLocalErr { errStart } else { errPos }, prefix, "unsupported fallible error type " + displayKind(errFirst.kind));
        }
        eb0 := borrowedStorageError(errFirst.kind);
        if eb0 =!= "" { syntax.failAt(errSource, if useLocalErr { errStart } else { errPos }, prefix, eb0); }
        var errEnd := errFirst.next;
        var errCursor := syntax.skipTrivia(source, errFirst.next, prefix);
        var errKind := errFirst.kind;
        if errCursor < size and source.at(errCursor) == "|" and not source.startsWithAt(errCursor, "||") {
            mut errMembers: List<String> = [errFirst.kind];
            loop errCursor < size and source.at(errCursor) == "|" and not source.startsWithAt(errCursor, "||") {
                eNextStart := syntax.skipTrivia(source, errCursor + 1, prefix);
                eAtom := parseTypeAtomWithSeen(errSource, errPos, useLocalErr, source, eNextStart, prefix, aliases, context, genericType, seen);
                if eAtom.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(eAtom.kind) {
                    syntax.failAt(errSource, if useLocalErr { eNextStart } else { errPos }, prefix, "unsupported fallible error type " + displayKind(eAtom.kind));
                }
                eb := borrowedStorageError(eAtom.kind);
                if eb =!= "" { syntax.failAt(errSource, if useLocalErr { eNextStart } else { errPos }, prefix, eb); }
                mut errMembers.pushBack(eAtom.kind);
                errEnd = eAtom.next;
                errCursor = syntax.skipTrivia(source, eAtom.next, prefix);
            }
            errKind = buildUnionKind(errMembers);
        }
        if errCursor < size and source.at(errCursor) == "!" {
            syntax.failAt(errSource, if useLocalErr { errCursor } else { errPos }, prefix, "chained fallible ! types must be parenthesized");
        }
        return (kind = buildResultKind(leftKind, errKind), next = errEnd);
    }
    (kind = leftKind, next = endBeforeTrivia)
};

/** Resolves one scalar, flat named-tuple, array, list, or callable type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
pub resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String {
    parsed := parseTypeWithSeen(source, position, false, text, 0, prefix, aliases, "alias", "", seen);
    after := syntax.skipTrivia(text, parsed.next, prefix);
    if after < text.length() {
        syntax.failAt(source, position, prefix, "unexpected text after type");
    }
    parsed.kind
};

/** Resolves all `Type<...>` constraint bounds (including intersections) and discrete value parameter types in `rawParamsCsv` against `aliases`. */
pub resolveComptimeParamSpecs := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, rawParamsCsv: String): String {
    if rawParamsCsv == "" { return ""; }
    mut out: List<String> = [];
    emptySeen: List<String> = [];
    loop splitParamSpecs(rawParamsCsv) as spec {
        alreadyCsv := out.join(",");
        if spec.kind == "" {
            mut out.pushBack(spec.name);
        } else if isTypeConstraintKind(spec.kind) {
            rawBounds := typeConstraintUnion(spec.kind);
            mut boundKinds: List<String> = [];
            loop splitTopLevelCommaRaw(rawBounds, prefix) as rb {
                bParsed := parseTypeWithSeen(source, position, false, rb, 0, prefix, aliases, "constraint", alreadyCsv, emptySeen);
                if syntax.skipTrivia(rb, bParsed.next, prefix) < rb.length() {
                    syntax.failAt(source, position, prefix, "unexpected text after type constraint");
                }
                if bParsed.kind == ir.VALUE_KIND_UNIT or bParsed.kind == ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, position, prefix, "unsupported type constraint member " + displayKind(bParsed.kind));
                }
                mut boundKinds.pushBack(bParsed.kind);
            }
            inter := intersectConstraintBounds(boundKinds);
            if not inter.ok {
                syntax.failAt(source, position, prefix, "unsatisfiable empty type constraint on parameter " + spec.name);
            }
            mut out.pushBack(spec.name + "=Type<" + inter.kind + ">");
        } else {
            res := resolveDiscreteType(aliases, spec.kind, prefix);
            if not res.ok {
                syntax.failAt(source, position, prefix, res.error);
            }
            mut out.pushBack(spec.name + "=" + res.kind);
        }
    }
    out.join(",")
};

/** Resolves one generic type or template body under `genericParams` (`"T"` or `"A,B"`), validating there is no trailing text. */
pub resolveGenericTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, genericParams: String, seen: List<String>): String {
    parsed := parseTypeWithSeen(source, position, false, text, 0, prefix, aliases, "alias", genericParams, seen);
    after := syntax.skipTrivia(text, parsed.next, prefix);
    if after < text.length() {
        syntax.failAt(source, position, prefix, "unexpected text after type");
    }
    parsed.kind
};

/** Returns owned nominal owner metadata when `name` refers to a generic template (`record`, `distinct`, `enum`, or `alias`). */
pub genericAliasTemplateInfo := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String): (ownerKey: String, paramsCsv: String, tplKind: String) {
    idx := findAlias(aliases, name);
    if idx < 0 { return (ownerKey = "", paramsCsv = "", tplKind = ""); }
    aliasItem := aliases[idx];
    if aliasItem.target.startsWithAt(0, "@gentpl:") {
        pDec := decodeLengthPrefixedAt(aliasItem.target, 8);
        if pDec.next < 0 { return (ownerKey = "", paramsCsv = "", tplKind = ""); }
        tplBody := aliasItem.target.slice(pDec.next, aliasItem.target.length());
        return (ownerKey = typeOpOwnerKey(tplBody), paramsCsv = pDec.text, tplKind = tplBody);
    }
    if aliasItem.target.startsWithAt(0, "@genraw:") {
        pDec := decodeLengthPrefixedAt(aliasItem.target, 8);
        if pDec.next < 0 { return (ownerKey = "", paramsCsv = "", tplKind = ""); }
        innerRaw := aliasItem.target.slice(pDec.next, aliasItem.target.length());
        emptySeen: List<String> = [];
        scopedTplAliases := aliasesUpToDepth(aliases, aliasItem.depth);
        resolvedParams := resolveComptimeParamSpecs(source, position, prefix, scopedTplAliases, pDec.text);
        tplKind := resolveGenericTypeText(source, position, prefix, scopedTplAliases, innerRaw, resolvedParams, emptySeen);
        return (ownerKey = typeOpOwnerKey(tplKind), paramsCsv = resolvedParams, tplKind = tplKind);
    }
    (ownerKey = "", paramsCsv = "", tplKind = "")
};

/** Resolves active generic `Option<T>` template from `aliases` with `None` and `Some(T)` case indices. */
pub resolveOptionTemplate := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (ok: Bool, tplKind: String, paramsCsv: String, paramName: String, noneIdx: Int, someIdx: Int) {
    info := genericAliasTemplateInfo(source, position, prefix, aliases, "Option");
    if info.tplKind == "" or not isPayloadEnumKind(info.tplKind) {
        return (ok = false, tplKind = "", paramsCsv = "", paramName = "", noneIdx = -1, someIdx = -1);
    }
    specs := splitParamSpecs(info.paramsCsv);
    if specs.length() =!= 1 or not isTypeParamKind(specs[0].kind) {
        return (ok = false, tplKind = "", paramsCsv = "", paramName = "", noneIdx = -1, someIdx = -1);
    }
    noneIdx := enumCaseIndex(info.tplKind, "None");
    someIdx := enumCaseIndex(info.tplKind, "Some");
    if noneIdx < 0 or someIdx < 0 or enumCasePayloadCount(info.tplKind, noneIdx) =!= 0 or enumCasePayloadCount(info.tplKind, someIdx) =!= 1 {
        return (ok = false, tplKind = "", paramsCsv = "", paramName = "", noneIdx = -1, someIdx = -1);
    }
    (ok = true, tplKind = info.tplKind, paramsCsv = info.paramsCsv, paramName = specs[0].name, noneIdx = noneIdx, someIdx = someIdx)
};

/** Returns the owned nominal type-op owner key when `name` refers to a generic template, else `""`. */
pub genericAliasOwnerKey := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String): String {
    genericAliasTemplateInfo(source, position, prefix, aliases, name).ownerKey
};

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
pub resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String {
    resolveTypeText(source, position, prefix, aliases, name, seen)
};

/** Parses one source-level flat named-tuple type `(label: Type, ...)`. */
pub parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    emptySeen: List<String> = [];
    parseTypeWithSeen(source, position, true, source, position, prefix, aliases, "tuple field", "", emptySeen)
};

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple, an array, a `List<T>`, or `fn(...): Return`. */
pub parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String): (kind: String, next: Int) {
    emptySeen: List<String> = [];
    parseTypeWithSeen(source, position, true, source, position, prefix, aliases, context, genericType, emptySeen)
};

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
pub parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (kind: String, next: Int) {
    parseTypeAt(source, position, prefix, aliases, "function", genericType)
};

/** Parses `context([mut] name: [mut] Type, ...)` into canonical name-sorted `Ctx<...>` and next offset. */
pub parseContextClause := fn(source: String, kwPos: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (ctxKind: String, next: Int) {
    emptySeen: List<String> = [];
    parseContextClauseWith(parseTypeAtomWithSeen, source, kwPos, true, source, kwPos, prefix, aliases, genericType, emptySeen)
};

/** Source span for one optional parameter's default expression. */
pub FnDefaultSpan := record { idx: Int; start: Int; end: Int; };
mut fnDefaultSpansByKey: Map<String, List<FnDefaultSpan>>;

/** Clears cached parameter default spans across independent compiler invocations. */
pub resetAll := fn(): Unit {
    mut fnDefaultSpansByKey.clear();
};

/** Returns any scanned parameter default spans registered by `parseFunctionHeader` / `parseTypeOpHeader` for `(prefix, headerPos)`. */
pub getFnDefaultSpans := fn(prefix: String, headerPos: Int): List<FnDefaultSpan> {
    fnDefaultSpansByKey.getOr(prefix + ":" + headerPos.toText(), [])
};

/** Returns any scanned parameter default spans keyed by function body opening position `(prefix, bodyStart)`. */
pub getFnDefaultSpansByBodyStart := fn(prefix: String, bodyStart: Int): List<FnDefaultSpan> {
    fnDefaultSpansByKey.getOr(prefix + "@b:" + bodyStart.toText(), [])
};

/** Parses a function signature. The optional `T` binder is only enabled for the registered core list declarations. */
pub parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): (next: Int, result: String, params: String, count: Int, genericType: String) {
    size := source.length();
    var cursor := syntax.skipTrivia(source, position, prefix);
    var genericType := "";
    if listIntrinsic {
        cursor = syntax.expectSymbol(source, cursor, "<", prefix);
        binderStart := syntax.skipTrivia(source, cursor, prefix);
        binder := typeNameAt(source, binderStart, prefix);
        afterFirst := syntax.skipTrivia(source, binder.next, prefix);
        if binder.name == "K" and afterFirst < size and source.at(afterFirst) == "," {
            secondStart := syntax.skipTrivia(source, afterFirst + 1, prefix);
            second := typeNameAt(source, secondStart, prefix);
            if second.name =!= "V" { syntax.failAt(source, secondStart, prefix, "core map intrinsic type parameters must be <K, V>"); }
            genericType = "K,V";
            cursor = syntax.expectSymbol(source, second.next, ">", prefix);
        } else {
            if binder.name =!= "T" { syntax.failAt(source, binderStart, prefix, "core list intrinsic type parameter must be T"); }
            genericType = binder.name;
            cursor = syntax.expectSymbol(source, binder.next, ">", prefix);
        }
        cursor = syntax.skipTrivia(source, cursor, prefix);
    } else if cursor < size and source.at(cursor) == "<" {
        gp := scanComptimeTypeParams(source, cursor, prefix);
        if not gp.ok {
            syntax.failAt(source, gp.errPos, prefix, gp.errMsg);
        }
        genericType = resolveComptimeParamSpecs(source, cursor, prefix, aliases, gp.paramsCsv);
        cursor = syntax.skipTrivia(source, gp.next, prefix);
    }
    cursor = syntax.expectSymbol(source, cursor, "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    mut names: List<String> = [];
    mut defSpans: List<FnDefaultSpan> = [];
    var encoded := "";
    var count := 0;
    if source.startsWithAt(cursor, "...") {
        cursor = syntax.skipTrivia(source, cursor + 3, prefix);
        if cursor >= size or not source.at(cursor).isNameStart() {
            syntax.failAt(source, cursor, prefix, "expected a name after ... in host value-pack declaration");
        }
        nameStart := cursor;
        cursor = source.skipName(cursor);
        encoded = "..." + source.slice(nameStart, cursor);
        count = -1;
        cursor = syntax.skipTrivia(source, cursor, prefix);
        if cursor < size and source.at(cursor) == "," {
            syntax.failAt(source, cursor, prefix, "host value-pack declaration must be its only parameter");
        }
    } else if cursor < size and source.at(cursor) =!= ")" {
        mut encodedBuf: tb.TextBuilder;
        loop true {
            if cursor >= size or not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = source.skipName(cursor);
            parameterName := source.slice(nameStart, cursor);
            if syntax.isReservedWord(parameterName) { syntax.unsupportedFeature(source, nameStart, parameterName, prefix); }
            if names.contains(parameterName) {
                syntax.failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            (mut names).pushBack(parameterName);
            cursor = syntax.skipTrivia(source, cursor, prefix);
            if cursor < size and source.at(cursor) == "?" {
                syntax.failAt(source, cursor, prefix, "default parameters in function definitions must use = expression; ? is only for function type signatures");
            }
            var access := "";
            var paramKind := "";
            var isOpt := false;
            if cursor < size and syntax.isSingleEquals(source, cursor) {
                defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
                if defEnd <= defStart {
                    syntax.failAt(source, defStart, prefix, "expected default expression for parameter " + parameterName);
                }
                isOpt = true;
                paramKind = "$InferParam";
                mut defSpans.pushBack(FnDefaultSpan { idx = count, start = defStart, end = defEnd });
                cursor = syntax.skipTrivia(source, defEnd, prefix);
            } else {
                cursor = syntax.expectSymbol(source, cursor, ":", prefix);
                cursor = syntax.skipTrivia(source, cursor, prefix);
                if source.wordAt(cursor, "mut") {
                    access = "mut ";
                    cursor = syntax.skipTrivia(source, cursor + 3, prefix);
                }
                typed := parseFunctionType(source, cursor, prefix, aliases, genericType);
                if access =!= "" and not listIntrinsic and not isGenericParamName(genericType, typed.kind) and not isMutContainerKind(typed.kind) {
                    syntax.failAt(source, cursor, prefix, "mut parameter signatures are reserved for List, Map, Set, or record parameters or registered core declarations");
                }
                paramKind = typed.kind;
                cursor = syntax.skipTrivia(source, typed.next, prefix);
                if cursor < size and syntax.isSingleEquals(source, cursor) {
                    if access =!= "" {
                        syntax.failAt(source, cursor, prefix, "mut parameters cannot have default values");
                    }
                    if listIntrinsic {
                        syntax.failAt(source, cursor, prefix, "intrinsic parameter cannot have a default value");
                    }
                    defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                    defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
                    if defEnd <= defStart {
                        syntax.failAt(source, defStart, prefix, "expected default expression for parameter " + parameterName);
                    }
                    isOpt = true;
                    mut defSpans.pushBack(FnDefaultSpan { idx = count, start = defStart, end = defEnd });
                    cursor = syntax.skipTrivia(source, defEnd, prefix);
                }
            }
            if count > 0 { mut encodedBuf.append("|"); }
            mut encodedBuf.append(parameterName);
            if isOpt { mut encodedBuf.append("?"); }
            mut encodedBuf.append("=");
            mut encodedBuf.append(access);
            mut encodedBuf.append(paramKind);
            count = count + 1;
            if cursor < size and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor < size and source.at(cursor) == ")" { break; }
            } else {
                break;
            }
        }
        encoded = encodedBuf.build();
    }
    spanKey := prefix + ":" + position.toText();
    if defSpans.length() > 0 {
        mut fnDefaultSpansByKey.set(spanKey, defSpans);
    } else if fnDefaultSpansByKey.has(spanKey) {
        mut fnDefaultSpansByKey.set(spanKey, []);
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    var fnCtxKind := "";
    if cursor < size and source.wordAt(cursor, "context") {
        emptyCtxSeen: List<String> = [];
        ctxRes := parseContextClauseWith(parseTypeAtomWithSeen, source, cursor, true, source, cursor, prefix, aliases, genericType, emptyCtxSeen);
        fnCtxKind = ctxRes.ctxKind;
        cursor = syntax.skipTrivia(source, ctxRes.next, prefix);
    }
    cursor = syntax.expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, aliases, genericType);
    afterRetBrace := syntax.skipTrivia(source, resultType.next, prefix);
    if afterRetBrace < size and source.at(afterRetBrace) == "{" {
        bKey := prefix + "@b:" + (afterRetBrace + 1).toText();
        if defSpans.length() > 0 {
            mut fnDefaultSpansByKey.set(bKey, defSpans);
        } else if fnDefaultSpansByKey.has(bKey) {
            mut fnDefaultSpansByKey.set(bKey, []);
        }
    }
    (next = resultType.next, result = resultType.kind, params = contexts.appendCtxToParams(encoded, fnCtxKind), count = count, genericType = genericType)
};

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
pub parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) {
    start := syntax.skipTrivia(source, position, prefix);
    cursor := start;
    if source.wordAt(cursor, "mut") {
        syntax.failAt(source, cursor, prefix, "place mut before the variable name (e.g. mut name: Type)");
    }
    typed := parseTypeAt(source, cursor, prefix, aliases, "local", "");
    if typed.kind == ir.VALUE_KIND_UNIT {
        name := source.slice(cursor, source.skipName(cursor));
        syntax.failAt(source, cursor, prefix, "unsupported local type " + name);
    }
    (kind = typed.kind, writable = false, next = typed.next)
};

/** Returns a copy of `aliases` with `Self` bound at `depth` to `selfTarget` (`ownerKind` or `"$Family:<Name>"`). */
pub withSelfAlias := fn(aliases: List<AliasDecl>, selfTarget: String, depth: Int): List<AliasDecl> {
    mut out: List<AliasDecl> = [];
    loop aliases as existing {
        if existing.name =!= "Self" {
            mut out.pushBack(existing);
        }
    }
    (mut out).pushBack((name = "Self", target = selfTarget, at = -1, end = 0, depth = depth));
    out
};

/** Parses a `TypeName.op := fn[<TypeParams>](...): Ret` header, reporting `hasSelfRecv` when param 0 explicitly has `Self` type. */
pub parseTypeOpHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, typeName: String, opName: String, selfTarget: String, ownerKey: String, isGenericOwner: Bool): (next: Int, result: String, params: String, count: Int, genericType: String, hasSelfRecv: Bool) {
    size := source.length();
    var cursor := syntax.skipTrivia(source, position, prefix);
    var genericType := "";
    if cursor < size and source.at(cursor) == "<" {
        gp := scanComptimeTypeParams(source, cursor, prefix);
        if not gp.ok {
            syntax.failAt(source, gp.errPos, prefix, gp.errMsg);
        }
        genericType = resolveComptimeParamSpecs(source, cursor, prefix, aliases, gp.paramsCsv);
        cursor = syntax.skipTrivia(source, gp.next, prefix);
    }
    scopedAliases := withSelfAlias(aliases, selfTarget, 0);
    cursor = syntax.expectSymbol(source, cursor, "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    mut names: List<String> = [];
    mut defSpans: List<FnDefaultSpan> = [];
    mut encodedBuf: tb.TextBuilder;
    var count := 0;
    var hasSelfRecv := false;
    if cursor < size and source.at(cursor) =!= ")" {
        loop true {
            if cursor >= size or not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = source.skipName(cursor);
            parameterName := source.slice(nameStart, cursor);
            if syntax.isReservedWord(parameterName) { syntax.unsupportedFeature(source, nameStart, parameterName, prefix); }
            if names.contains(parameterName) {
                syntax.failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            (mut names).pushBack(parameterName);
            cursor = syntax.skipTrivia(source, cursor, prefix);
            if cursor < size and source.at(cursor) == "?" {
                syntax.failAt(source, cursor, prefix, "default parameters in function definitions must use = expression; ? is only for function type signatures");
            }
            var access := "";
            var paramKind := "";
            var isOpt := false;
            if cursor < size and syntax.isSingleEquals(source, cursor) {
                if count == 0 {
                    syntax.failAt(source, nameStart, prefix, "receiver parameter of type operation " + opName + " must have explicit type");
                }
                defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
                if defEnd <= defStart {
                    syntax.failAt(source, defStart, prefix, "expected default expression for parameter " + parameterName);
                }
                isOpt = true;
                paramKind = "$InferParam";
                mut defSpans.pushBack(FnDefaultSpan { idx = count, start = defStart, end = defEnd });
                cursor = syntax.skipTrivia(source, defEnd, prefix);
            } else {
                cursor = syntax.expectSymbol(source, cursor, ":", prefix);
                cursor = syntax.skipTrivia(source, cursor, prefix);
                if source.wordAt(cursor, "mut") {
                    access = "mut ";
                    cursor = syntax.skipTrivia(source, cursor + 3, prefix);
                }
                typeStart := cursor;
                typed := parseFunctionType(source, typeStart, prefix, scopedAliases, genericType);
                if count == 0 and source.wordAt(typeStart, "Self") and (typeOpOwnerKey(typed.kind) == ownerKey or ownerKey.startsWithAt(0, "$alias:")) {
                    hasSelfRecv = true;
                }
                if access =!= "" and not isGenericCoreOwner(typeName) and not isGenericParamName(genericType, distinctBaseKind(typed.kind)) and not isMutContainerKind(typed.kind) {
                    syntax.failAt(source, typeStart, prefix, "mut parameter signatures are reserved for List, Map, Set, or record parameters or registered core declarations");
                }
                paramKind = typed.kind;
                cursor = syntax.skipTrivia(source, typed.next, prefix);
                if cursor < size and syntax.isSingleEquals(source, cursor) {
                    if access =!= "" {
                        syntax.failAt(source, cursor, prefix, "mut parameters cannot have default values");
                    }
                    defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                    defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
                    if defEnd <= defStart {
                        syntax.failAt(source, defStart, prefix, "expected default expression for parameter " + parameterName);
                    }
                    isOpt = true;
                    mut defSpans.pushBack(FnDefaultSpan { idx = count, start = defStart, end = defEnd });
                    cursor = syntax.skipTrivia(source, defEnd, prefix);
                }
            }
            if count > 0 { mut encodedBuf.append("|"); }
            mut encodedBuf.append(parameterName);
            if isOpt { mut encodedBuf.append("?"); }
            mut encodedBuf.append("=");
            mut encodedBuf.append(access);
            mut encodedBuf.append(paramKind);
            count = count + 1;
            if cursor < size and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor < size and source.at(cursor) == ")" { break; }
            } else {
                break;
            }
        }
    }
    spanKey := prefix + ":" + position.toText();
    if defSpans.length() > 0 {
        mut fnDefaultSpansByKey.set(spanKey, defSpans);
    } else if fnDefaultSpansByKey.has(spanKey) {
        mut fnDefaultSpansByKey.set(spanKey, []);
    }
    encoded := encodedBuf.build();
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    var fnCtxKind := "";
    if cursor < size and source.wordAt(cursor, "context") {
        emptyCtxSeen: List<String> = [];
        ctxRes := parseContextClauseWith(parseTypeAtomWithSeen, source, cursor, true, source, cursor, prefix, scopedAliases, genericType, emptyCtxSeen);
        fnCtxKind = ctxRes.ctxKind;
        cursor = syntax.skipTrivia(source, ctxRes.next, prefix);
    }
    cursor = syntax.expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, scopedAliases, genericType);
    if opName == "$getIndex" {
        if count =!= 2 {
            syntax.failAt(source, position, prefix, "$getIndex on " + typeName + " must have exactly 2 parameters (receiver, index)");
        }
        firstSep := encoded.indexOf("|", 0);
        recvPart := if firstSep < 0 { encoded } else { encoded.slice(0, firstSep) };
        recvKind := paramKindOf(recvPart);
        if recvKind.startsWithAt(0, "mut ") {
            syntax.failAt(source, position, prefix, "$getIndex receiver on " + typeName + " must be read-only Self (not mut Self)");
        }
        if not hasSelfRecv {
            syntax.failAt(source, position, prefix, "$getIndex receiver on " + typeName + " must have Self type");
        }
        if resultType.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, position, prefix, "$getIndex on " + typeName + " must return a value (not Unit)");
        }
    } else if opName == "$setIndex" {
        if count =!= 3 {
            syntax.failAt(source, position, prefix, "$setIndex on " + typeName + " must have exactly 3 parameters (mut receiver, index, value)");
        }
        firstSep := encoded.indexOf("|", 0);
        recvPart := if firstSep < 0 { encoded } else { encoded.slice(0, firstSep) };
        recvKind := paramKindOf(recvPart);
        if not recvKind.startsWithAt(0, "mut ") {
            syntax.failAt(source, position, prefix, "$setIndex receiver on " + typeName + " must be mut Self");
        }
        if not hasSelfRecv {
            syntax.failAt(source, position, prefix, "$setIndex receiver on " + typeName + " must have Self type");
        }
        if resultType.kind =!= ir.VALUE_KIND_UNIT {
            syntax.failAt(source, position, prefix, "$setIndex on " + typeName + " must return Unit");
        }
    } else if opName == "$getSlice" or opName == "$getMutSlice" {
        if count =!= 3 {
            syntax.failAt(source, position, prefix, opName + " on " + typeName + " must have exactly 3 parameters (receiver, start, end)");
        }
        firstSep := encoded.indexOf("|", 0);
        recvPart := if firstSep < 0 { encoded } else { encoded.slice(0, firstSep) };
        recvKind := paramKindOf(recvPart);
        isMutHook := opName == "$getMutSlice";
        if isMutHook and not recvKind.startsWithAt(0, "mut ") {
            syntax.failAt(source, position, prefix, opName + " receiver on " + typeName + " must be mut Self");
        }
        if not isMutHook and recvKind.startsWithAt(0, "mut ") {
            syntax.failAt(source, position, prefix, opName + " receiver on " + typeName + " must be read-only Self (not mut Self)");
        }
        if not hasSelfRecv {
            syntax.failAt(source, position, prefix, opName + " receiver on " + typeName + " must have Self type");
        }
        if resultType.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, position, prefix, opName + " on " + typeName + " must return a Slice value");
        }
    }
    afterRetBrace := syntax.skipTrivia(source, resultType.next, prefix);
    if afterRetBrace < size and source.at(afterRetBrace) == "{" {
        bKey := prefix + "@b:" + (afterRetBrace + 1).toText();
        if defSpans.length() > 0 {
            mut fnDefaultSpansByKey.set(bKey, defSpans);
        } else if fnDefaultSpansByKey.has(bKey) {
            mut fnDefaultSpansByKey.set(bKey, []);
        }
    }
    (next = resultType.next, result = resultType.kind, params = contexts.appendCtxToParams(encoded, fnCtxKind), count = count, genericType = genericType, hasSelfRecv = hasSelfRecv)
};

/** Returns the source name from one encoded `name[?]=kind` function parameter entry. */
pub paramNameOf := fn(entry: String): String {
    separator := entry.indexOf("=", 0);
    if separator < 0 { return entry; }
    if separator > 0 and entry.at(separator - 1) == "?" {
        return entry.slice(0, separator - 1);
    }
    entry.slice(0, separator)
};

/** True when encoded parameter entry `name[?]=kind` carries a `?` optional marker. */
pub paramIsOptional := fn(entry: String): Bool {
    separator := entry.indexOf("=", 0);
    separator > 0 and entry.at(separator - 1) == "?"
};

/** Returns the kind from one encoded `name[?]=kind` function parameter entry. */
pub paramKindOf := fn(entry: String): String {
    separator := entry.indexOf("=", 0);
    if separator < 0 { return ""; }
    entry.slice(separator + 1, entry.length())
};

/** Joins `count` consecutive encoded parameter entries starting at `first` with `"|"`. */
pub slicePipeRange := fn(allParams: List<String>, first: Int, count: Int): String {
    if count <= 0 or first < 0 { return ""; }
    mut out: tb.TextBuilder;
    var i := 0;
    loop i < count {
        if i > 0 { mut out.append("|"); }
        mut out.append(allParams[first + i]);
        i = i + 1;
    }
    out.build()
};

/** Builds a canonical `fn(label[?]:Kind,...)[@ctx(...)]:ResultKind` string from encoded parameter entries, context kind, and return kind. */
pub fnCanonicalKindWithCtx := fn(params: List<String>, first: Int, count: Int, resultKind: String, ctxKind: String): String {
    mut out: tb.TextBuilder;
    mut out.append("fn(");
    var idx := 0;
    loop idx < count {
        if idx > 0 { mut out.append(","); }
        entry := params[first + idx];
        mut out.append(paramNameOf(entry));
        if paramIsOptional(entry) { mut out.append("?"); }
        mut out.append(":");
        mut out.append(paramKindOf(entry));
        idx = idx + 1;
    }
    mut out.append(")");
    if ctxKind =!= "" { mut out.append(fnAtCtxSuffix(ctxKind)); }
    mut out.append(":");
    mut out.append(resultKind);
    out.build()
};

/** Builds a canonical `fn(label:Kind,...):ResultKind` string from encoded parameter entries and a return kind. */
pub fnCanonicalKind := fn(params: List<String>, first: Int, count: Int, resultKind: String): String {
    fnCanonicalKindWithCtx(params, first, count, resultKind, "")
};

/** Reads one single raw alias target atom from `position`, capturing tuples, arrays, fns, or `Name<...>`. */
collectSingleTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := source.length();
    start := syntax.skipTrivia(source, position, prefix);
    if start < size and source.at(start) == "(" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := source.at(cursor);
            if ch == "\"" {
                cursor = syntax.skipAliasString(source, cursor);
            } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                cursor = syntax.skipComment(source, cursor, prefix);
            } else if ch == "(" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = source.slice(start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = source.slice(start, size), next = size)
    } else if start < size and source.at(start) == "[" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := source.at(cursor);
            if ch == "\"" {
                cursor = syntax.skipAliasString(source, cursor);
            } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                cursor = syntax.skipComment(source, cursor, prefix);
            } else if ch == "[" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "]" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = source.slice(start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = source.slice(start, size), next = size)
    } else if start < size and source.at(start) == "{" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := source.at(cursor);
            if ch == "\"" {
                cursor = syntax.skipAliasString(source, cursor);
            } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                cursor = syntax.skipComment(source, cursor, prefix);
            } else if ch == "{" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "}" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = source.slice(start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = source.slice(start, size), next = size)
    } else if source.wordAt(start, "fn") {
        afterFn := syntax.skipTrivia(source, start + 2, prefix);
        if afterFn < size and source.at(afterFn) == "(" {
            var cursor := afterFn;
            var depth := 0;
            var afterParen := -1;
            loop cursor < size {
                ch := source.at(cursor);
                if ch == "\"" {
                    cursor = syntax.skipAliasString(source, cursor);
                } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                    cursor = syntax.skipComment(source, cursor, prefix);
                } else if ch == "(" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ")" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        afterParen = cursor;
                        break;
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            if afterParen < 0 {
                return (text = source.slice(start, size), next = size);
            }
            var afterClose := syntax.skipTrivia(source, afterParen, prefix);
            if afterClose < size and source.wordAt(afterClose, "context") {
                afterCtxKw := syntax.skipTrivia(source, afterClose + 7, prefix);
                if afterCtxKw < size and source.at(afterCtxKw) == "(" {
                    var cCur := afterCtxKw;
                    var cDep := 0;
                    var cDone := -1;
                    loop cCur < size {
                        cCh := source.at(cCur);
                        if cCh == "\"" { cCur = syntax.skipAliasString(source, cCur); }
                        else if cCh == "/" and source.startsWithAt(cCur, "/*") { cCur = syntax.skipComment(source, cCur, prefix); }
                        else if cCh == "(" { cDep = cDep + 1; cCur = cCur + 1; }
                        else if cCh == ")" {
                            cDep = cDep - 1;
                            cCur = cCur + 1;
                            if cDep == 0 { cDone = cCur; break; }
                        } else { cCur = cCur + 1; }
                    }
                    if cDone > 0 { afterClose = syntax.skipTrivia(source, cDone, prefix); }
                }
            }
            if afterClose < size and source.at(afterClose) == ":" {
                retTarget := collectTypeTarget(source, afterClose + 1, prefix);
                return (text = source.slice(start, retTarget.next), next = retTarget.next);
            }
            return (text = source.slice(start, afterClose), next = afterClose);
        }
        parsedName := typeNameAt(source, start, prefix);
        (text = source.slice(start, parsedName.next), next = parsedName.next)
    } else if source.wordAt(start, "dyn") {
        afterDyn := syntax.skipTrivia(source, start + 3, prefix);
        if afterDyn < size and source.at(afterDyn).isNameStart() {
            inner := self(source, afterDyn, prefix);
            (text = source.slice(start, inner.next), next = inner.next)
        } else {
            parsedName := typeNameAt(source, start, prefix);
            (text = source.slice(start, parsedName.next), next = parsedName.next)
        }
    } else {
        parsedName := typeNameAt(source, start, prefix);
        after := parsedName.next;
        afterName := syntax.skipTrivia(source, after, prefix);
        if afterName < size and source.at(afterName) == "<" {
            var cursor := afterName;
            var depth := 0;
            loop cursor < size {
                ch := source.at(cursor);
                if ch == "\"" {
                    cursor = syntax.skipAliasString(source, cursor);
                } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                    cursor = syntax.skipComment(source, cursor, prefix);
                } else if ch == "<" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ">" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        return (text = source.slice(start, cursor), next = cursor);
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            (text = source.slice(start, size), next = size)
        } else {
            (text = source.slice(start, after), next = after)
        }
    }
};

/** Reads one raw alias/field target type (including leading `|`, `A | B`, `!`, and `T!`) from `position`. */
pub collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    start := syntax.skipTrivia(source, position, prefix);
    size := source.length();
    var firstStart := start;
    if firstStart < size and source.at(firstStart) == "|" and not source.startsWithAt(firstStart, "||") {
        firstStart = syntax.skipTrivia(source, firstStart + 1, prefix);
    }
    first := collectSingleTypeTarget(source, firstStart, prefix);
    var endPos := first.next;
    loop true {
        after := syntax.skipTrivia(source, endPos, prefix);
        if after < size and source.at(after) == "|" and not source.startsWithAt(after, "||") {
            nxt := collectSingleTypeTarget(source, after + 1, prefix);
            if nxt.next <= endPos { break; }
            endPos = nxt.next;
        } else {
            break;
        }
    }
    afterUnion := syntax.skipTrivia(source, endPos, prefix);
    if afterUnion < size and source.at(afterUnion) == "!" {
        afterBang := syntax.skipTrivia(source, afterUnion + 1, prefix);
        if not startsTypeTokenAt(source, afterBang, prefix) {
            endPos = afterUnion + 1;
        } else {
            var rhsStart := afterBang;
            if rhsStart < size and source.at(rhsStart) == "|" and not source.startsWithAt(rhsStart, "||") {
                rhsStart = syntax.skipTrivia(source, rhsStart + 1, prefix);
            }
            rhs0 := collectSingleTypeTarget(source, rhsStart, prefix);
            if rhs0.next > rhsStart {
                endPos = rhs0.next;
                loop true {
                    afterR := syntax.skipTrivia(source, endPos, prefix);
                    if afterR < size and source.at(afterR) == "|" and not source.startsWithAt(afterR, "||") {
                        nxtR := collectSingleTypeTarget(source, afterR + 1, prefix);
                        if nxtR.next <= endPos { break; }
                        endPos = nxtR.next;
                    } else {
                        break;
                    }
                }
            } else {
                endPos = afterUnion + 1;
            }
        }
    }
    (text = source.slice(start, endPos), next = endPos)
};

/** Skips one `= defaultExpr` inside `record { field: Type = defaultExpr; ... }`, honoring nested braces and omitted semicolons after closing `}`. */
skipRecordFieldDefault := fn(source: String, start: Int, limit: Int, prefix: String): Int {
    var cur := start;
    var braceDepth := 0;
    var parenDepth := 0;
    var bracketDepth := 0;
    loop cur < limit {
        ch := source.at(cur);
        if ch == "\"" {
            cur = syntax.skipAliasString(source, cur);
        } else if ch == "/" and source.startsWithAt(cur, "/*") {
            cur = syntax.skipComment(source, cur, prefix);
        } else if ch == "{" {
            braceDepth = braceDepth + 1;
            cur = cur + 1;
        } else if ch == "}" {
            if braceDepth > 0 {
                braceDepth = braceDepth - 1;
                cur = cur + 1;
                if braceDepth == 0 and parenDepth == 0 and bracketDepth == 0 {
                    afterClose := syntax.skipTrivia(source, cur, prefix);
                    if afterClose < limit and source.at(afterClose) == ";" {
                        return afterClose + 1;
                    }
                    if afterClose >= limit { return cur; }
                    if not source.wordAt(afterClose, "else") and not source.wordAt(afterClose, "then") and
                    not source.wordAt(afterClose, "finally") and source.at(afterClose) =!= "+" and
                    source.at(afterClose) =!= "-" and source.at(afterClose) =!= "*" and
                    source.at(afterClose) =!= "/" and source.at(afterClose) =!= "." and
                    source.at(afterClose) =!= "[" and source.at(afterClose) =!= "(" {
                        return cur;
                    }
                }
            } else {
                return cur;
            }
        } else if ch == "(" {
            parenDepth = parenDepth + 1;
            cur = cur + 1;
        } else if ch == ")" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            cur = cur + 1;
        } else if ch == "[" {
            bracketDepth = bracketDepth + 1;
            cur = cur + 1;
        } else if ch == "]" {
            if bracketDepth > 0 { bracketDepth = bracketDepth - 1; }
            cur = cur + 1;
        } else if ch == ";" and braceDepth == 0 and parenDepth == 0 and bracketDepth == 0 {
            return cur + 1;
        } else {
            cur = cur + 1;
        }
    }
    cur
};

/** Pre-scans `Name := enum [: BackingType] { Case [= val]; ... }` with layout attributes into an encoded `@enumraw:` target. */
pub collectEnumTargetWithAttrs := fn(source: String, afterEnumKw: Int, prefix: String, moduleIdentity: String, declAt: Int, enumName: String, attrSuffix: String): (text: String, next: Int) {
    size := source.length();
    var cursor := syntax.skipTrivia(source, afterEnumKw, prefix);
    var rawBacking := "";
    if cursor < size and source.at(cursor) == ":" {
        bkStart := syntax.skipTrivia(source, cursor + 1, prefix);
        bkRes := collectTypeTarget(source, bkStart, prefix);
        rawBacking = bkRes.text;
        cursor = syntax.skipTrivia(source, bkRes.next, prefix);
    }
    var effectiveAttrSuffix := attrSuffix;
    if effectiveAttrSuffix == "" and cursor < size and source.at(cursor) == "#" {
        inlineAttr := parseTypeLayoutAttrs(source, cursor, prefix);
        if not inlineAttr.ok {
            return (text = "", next = inlineAttr.next);
        }
        effectiveAttrSuffix = inlineAttr.encoded;
        cursor = syntax.skipTrivia(source, inlineAttr.next, prefix);
    }
    if cursor >= size or source.at(cursor) =!= "{" {
        return (text = "", next = cursor);
    }
    closeEnd := syntax.scanBraceEnd(source, cursor, prefix);
    if closeEnd < 0 {
        return (text = "", next = size);
    }
    bodyLimit := closeEnd - 1;
    cursor = cursor + 1;
    mut names: List<String> = [];
    mut vals: List<String> = [];
    var count := 0;
    loop cursor < bodyLimit {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= bodyLimit { break; }
        if source.at(cursor) == "," {
            cursor = cursor + 1;
            continue;
        }
        if not source.at(cursor).isNameStart() {
            return (text = "", next = closeEnd);
        }
        cStart := cursor;
        cEnd := source.skipName(cStart);
        cName := source.slice(cStart, cEnd);
        if syntax.isReservedWord(cName) {
            return (text = "", next = closeEnd);
        }
        afterName := syntax.skipTrivia(source, cEnd, prefix);
        var rawVal := "";
        if afterName < bodyLimit and source.at(afterName) == "(" {
            parenEnd := syntax.scanParenEnd(source, afterName, prefix);
            if parenEnd < 0 or parenEnd > bodyLimit {
                return (text = "", next = closeEnd);
            }
            payloadInner := source.slice(afterName + 1, parenEnd - 1);
            afterParen := syntax.skipTrivia(source, parenEnd, prefix);
            if syntax.isSingleEquals(source, afterParen) {
                var vCur := syntax.skipTrivia(source, afterParen + 1, prefix);
                loop vCur < bodyLimit {
                    vCh := source.at(vCur);
                    if vCh == ";" or vCh == "," or vCh == "\n" or vCh == "\r" { break; }
                    if vCh == "\"" {
                        sEnd := syntax.skipAliasString(source, vCur);
                        if sEnd <= vCur { break; }
                        vCur = sEnd;
                        continue;
                    }
                    if vCh == "/" and vCur + 1 < bodyLimit and source.at(vCur + 1) == "*" { break; }
                    vCur = vCur + 1;
                }
                rawVal = "@paymix:" + payloadInner;
                cursor = vCur;
            } else {
                rawVal = "@pay:" + payloadInner;
                cursor = afterParen;
            }
        } else if syntax.isSingleEquals(source, afterName) {
            valStart := syntax.skipTrivia(source, afterName + 1, prefix);
            var vCur := valStart;
            loop vCur < bodyLimit {
                vCh := source.at(vCur);
                if vCh == ";" or vCh == "," or vCh == "\n" or vCh == "\r" { break; }
                if vCh == "\"" {
                    sEnd := syntax.skipAliasString(source, vCur);
                    if sEnd <= vCur { break; }
                    vCur = sEnd;
                    continue;
                }
                if vCh == "/" and vCur + 1 < bodyLimit and source.at(vCur + 1) == "*" {
                    break;
                }
                vCur = vCur + 1;
            }
            rawVal = source.slice(valStart, vCur);
            cursor = vCur;
        } else {
            cursor = afterName;
        }
        if cursor < bodyLimit and (source.at(cursor) == ";" or source.at(cursor) == ",") {
            cursor = cursor + 1;
        }
        (mut names).pushBack(cName);
        mut vals.pushBack(rawVal);
        count = count + 1;
    }
    mut pairsBuf: tb.TextBuilder;
    var idx := 0;
    loop idx < count {
        mut pairsBuf.append(encodeLengthPrefixedText(names[idx]));
        mut pairsBuf.append(encodeLengthPrefixedText(vals[idx]));
        idx = idx + 1;
    }
    enumHeader := moduleIdentity + "#" + declAt.toText() + "#" + enumName + effectiveAttrSuffix;
    (text = "@enumraw:" + encodeLengthPrefixedText(enumHeader) + encodeLengthPrefixedText(rawBacking) + count.toText() + ";" + pairsBuf.build(), next = closeEnd)
};

/** Pre-scans `Name := enum [: BackingType] { Case [= val]; ... }` into an encoded `@enumraw:` target and end offset. */
pub collectEnumTarget := fn(source: String, afterEnumKw: Int, prefix: String, moduleIdentity: String, declAt: Int, enumName: String): (text: String, next: Int) {
    collectEnumTargetWithAttrs(source, afterEnumKw, prefix, moduleIdentity, declAt, enumName, "")
};

/** Pre-scans `Name := record { field: Type [= default]; ... }` with layout attributes into an encoded `@recraw:` target. */
pub collectRecordTargetWithAttrs := fn(source: String, bracePos: Int, prefix: String, moduleIdentity: String, declAt: Int, recName: String, attrSuffix: String): (text: String, next: Int) {
    size := source.length();
    var start := syntax.skipTrivia(source, bracePos, prefix);
    var effectiveAttrSuffix := attrSuffix;
    if effectiveAttrSuffix == "" and start < size and source.at(start) == "#" {
        inlineAttr := parseTypeLayoutAttrs(source, start, prefix);
        if not inlineAttr.ok {
            return (text = "", next = inlineAttr.next);
        }
        effectiveAttrSuffix = inlineAttr.encoded;
        start = syntax.skipTrivia(source, inlineAttr.next, prefix);
    }
    if start >= size or source.at(start) =!= "{" {
        return (text = "", next = start);
    }
    closeEnd := syntax.scanBraceEnd(source, start, prefix);
    if closeEnd < 0 {
        return (text = "", next = size);
    }
    bodyLimit := closeEnd - 1;
    var cursor := start + 1;
    mut names: List<String> = [];
    mut typesList: List<String> = [];
    var count := 0;
    loop cursor < bodyLimit {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= bodyLimit { break; }
        if not source.at(cursor).isNameStart() {
            return (text = "", next = closeEnd);
        }
        fStart := cursor;
        fEnd := source.skipName(fStart);
        fName := source.slice(fStart, fEnd);
        if syntax.isReservedWord(fName) or names.contains(fName) {
            return (text = "", next = closeEnd);
        }
        afterField := syntax.skipTrivia(source, fEnd, prefix);
        if afterField >= bodyLimit or source.at(afterField) =!= ":" {
            return (text = "", next = closeEnd);
        }
        typeStart := syntax.skipTrivia(source, afterField + 1, prefix);
        rawType := collectTypeTarget(source, typeStart, prefix);
        if rawType.text == "" {
            return (text = "", next = closeEnd);
        }
        (mut names).pushBack(fName);
        mut typesList.pushBack(rawType.text);
        count = count + 1;
        cursor = syntax.skipTrivia(source, rawType.next, prefix);
        if syntax.isSingleEquals(source, cursor) {
            defStart := syntax.skipTrivia(source, cursor + 1, prefix);
            cursor = skipRecordFieldDefault(source, defStart, bodyLimit, prefix);
        } else if cursor < bodyLimit and source.at(cursor) == ";" {
            cursor = cursor + 1;
        } else if cursor < bodyLimit {
            afterSep := syntax.skipTrivia(source, cursor, prefix);
            if afterSep < bodyLimit and rawType.next > 0 and source.at(rawType.next - 1) =!= "}" {
                /* Wait for explicit separator only if needed; check if next item could follow */
            }
        }
    }
    mut pairsBuf: tb.TextBuilder;
    var idx := 0;
    loop idx < count {
        mut pairsBuf.append(encodeLengthPrefixedText(names[idx]));
        mut pairsBuf.append(encodeLengthPrefixedText(typesList[idx]));
        idx = idx + 1;
    }
    recHeader := if (moduleIdentity == "lite.type.error.v1" or moduleIdentity == "lib$type$error" or moduleIdentity == "lib_s_type_s_error" or
    moduleIdentity == "lite.core.error.v1" or moduleIdentity == "lib$core$error" or moduleIdentity == "lib_s_core_s_error") and
    recName == "Error" and effectiveAttrSuffix == "" {
        "core/error#0#Error"
    } else {
        moduleIdentity + "#" + declAt.toText() + "#" + recName + effectiveAttrSuffix
    };
    (text = "@recraw:" + encodeLengthPrefixedText(recHeader) + count.toText() + ";" + pairsBuf.build(), next = closeEnd)
};

/** Pre-scans `Name := record { field: Type [= default]; ... }` into an encoded `@recraw:` target and end offset. */
pub collectRecordTarget := fn(source: String, bracePos: Int, prefix: String, moduleIdentity: String, declAt: Int, recName: String): (text: String, next: Int) {
    collectRecordTargetWithAttrs(source, bracePos, prefix, moduleIdentity, declAt, recName, "")
};

/** Pre-scans `Name := distinct TargetType` into an encoded `@distraw:` target and end offset. */
pub collectDistinctTarget := fn(source: String, afterDistinctKw: Int, prefix: String, moduleIdentity: String, declAt: Int, distName: String): (text: String, next: Int) {
    targetStart := syntax.skipTrivia(source, afterDistinctKw, prefix);
    rawTarget := collectTypeTarget(source, targetStart, prefix);
    distHeader := moduleIdentity + "#" + declAt.toText() + "#" + distName;
    (text = "@distraw:" + encodeLengthPrefixedText(distHeader) + encodeLengthPrefixedText(rawTarget.text), next = rawTarget.next)
};

/** Finds the nearest `"alias"`, `"distinct"`, `"record"`, or `"enum"` keyword offset at or after `cursor`, or -1 when none exists. */
pub nextAliasOrRecordHit := fn(source: String, cursor: Int): Int {
    aHit := source.indexOf("alias", cursor);
    dHit := source.indexOf("distinct", cursor);
    rHit := source.indexOf("record", cursor);
    eHit := source.indexOf("enum", cursor);
    var best := aHit;
    if dHit >= 0 and (best < 0 or dHit < best) { best = dHit; }
    if rHit >= 0 and (best < 0 or rHit < best) { best = rHit; }
    if eHit >= 0 and (best < 0 or eHit < best) { best = eHit; }
    best
};

/** Pre-collects shallow `Name := alias Target` and `Name := record { ... }` declarations inside the `{ ... }` block opening at `openBracePos`. */
pub collectBlockTypeAliases := fn(source: String, openBracePos: Int, prefix: String, blockDepth: Int, baseAliases: List<AliasDecl>): List<AliasDecl> {
    flags := syntax.scanBlockFastFlags(source, openBracePos, prefix);
    if not flags.hasAliasKw { return baseAliases; }
    limit := if flags.end >= 0 { flags.end } else { source.length() };
    mut found: List<AliasDecl> = [];
    var hasFound := false;
    var cursor := openBracePos + 1;
    var parenDepth := 0;
    loop cursor < limit {
        cursor = syntax.skipTrivia(source, cursor, prefix);
        if cursor >= limit { break; }
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = syntax.skipAliasString(source, cursor);
        } else if ch == "{" {
            closed := syntax.scanBraceEnd(source, cursor, prefix);
            if closed < 0 { break; }
            cursor = closed;
        } else if ch == "}" {
            if parenDepth == 0 { break; }
            parenDepth = parenDepth - 1;
            cursor = cursor + 1;
        } else if ch == "(" or ch == "[" {
            parenDepth = parenDepth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            cursor = cursor + 1;
        } else if parenDepth == 0 and ch.isNameStart() {
            nameStart := cursor;
            afterName := source.skipName(nameStart);
            name := source.slice(nameStart, afterName);
            opPos := syntax.skipTrivia(source, afterName, prefix);
            if name =!= "pub" and not syntax.isReservedWord(name) and source.startsWithAt(opPos, ":=") {
                typePos := syntax.skipTrivia(source, opPos + 2, prefix);
                if source.wordAt(typePos, "alias") {
                    gp := scanComptimeTypeParams(source, typePos + 5, prefix);
                    targetStart := syntax.skipTrivia(source, gp.next, prefix);
                    aliasTarget := collectTypeTarget(source, targetStart, prefix);
                    if gp.ok {
                        rawTxt := if gp.hasParams { "@genraw:" + encodeLengthPrefixedText(gp.paramsCsv) + aliasTarget.text } else { aliasTarget.text };
                        mut found.pushBack((name = name, target = rawTxt, at = nameStart, end = aliasTarget.next, depth = blockDepth));
                        hasFound = true;
                    }
                    cursor = if aliasTarget.next > typePos + 5 { aliasTarget.next } else { typePos + 5 };
                    continue;
                } else if source.wordAt(typePos, "distinct") {
                    gp := scanComptimeTypeParams(source, typePos + 8, prefix);
                    distTarget := collectDistinctTarget(source, gp.next, prefix, "b" + blockDepth.toText(), nameStart, name);
                    if gp.ok {
                        rawTxt := if gp.hasParams { "@genraw:" + encodeLengthPrefixedText(gp.paramsCsv) + distTarget.text } else { distTarget.text };
                        mut found.pushBack((name = name, target = rawTxt, at = nameStart, end = distTarget.next, depth = blockDepth));
                        hasFound = true;
                    }
                    cursor = if distTarget.next > typePos + 8 { distTarget.next } else { typePos + 8 };
                    continue;
                } else if source.wordAt(typePos, "record") {
                    gp := scanComptimeTypeParams(source, typePos + 6, prefix);
                    braceStart := syntax.skipTrivia(source, gp.next, prefix);
                    recTarget := collectRecordTarget(source, braceStart, prefix, "b" + blockDepth.toText(), nameStart, name);
                    if gp.ok {
                        rawTxt := if gp.hasParams { "@genraw:" + encodeLengthPrefixedText(gp.paramsCsv) + recTarget.text } else { recTarget.text };
                        mut found.pushBack((name = name, target = rawTxt, at = nameStart, end = recTarget.next, depth = blockDepth));
                        hasFound = true;
                    }
                    cursor = if recTarget.next > typePos + 6 { recTarget.next } else { typePos + 6 };
                    continue;
                } else if source.wordAt(typePos, "enum") {
                    gp := scanComptimeTypeParams(source, typePos + 4, prefix);
                    enumTarget := collectEnumTarget(source, gp.next, prefix, "b" + blockDepth.toText(), nameStart, name);
                    if gp.ok {
                        rawTxt := if gp.hasParams { "@genraw:" + encodeLengthPrefixedText(gp.paramsCsv) + enumTarget.text } else { enumTarget.text };
                        mut found.pushBack((name = name, target = rawTxt, at = nameStart, end = enumTarget.next, depth = blockDepth));
                        hasFound = true;
                    }
                    cursor = if enumTarget.next > typePos + 4 { enumTarget.next } else { typePos + 4 };
                    continue;
                }
            }
            cursor = opPos;
        } else {
            cursor = cursor + 1;
        }
    }
    if not hasFound { return baseAliases; }
    mut out: List<AliasDecl> = baseAliases;
    loop found as entry { mut out.pushBack(entry); }
    out
};

/** Non-failing parser for a fixed-array extent token followed by `closeSym`. */
canResolveArrayExtent := fn(source: String, extentStart: Int, closeSym: String, prefix: String, aliases: List<AliasDecl>, genericType: String): (ok: Bool, extText: String, next: Int) {
    size := source.length();
    var extText := "";
    var extentEnd := extentStart;
    if extentStart < size and source.at(extentStart).isNameStart() {
        extentEnd = source.skipName(extentStart);
        extName := source.slice(extentStart, extentEnd);
        if valueParamKind(genericType, extName) == ir.VALUE_KIND_INT {
            extText = extName;
        } else {
            aliasIdx := findAlias(aliases, extName);
            if aliasIdx >= 0 and (aliases[aliasIdx].target).startsWithAt(0, "$Val:") {
                tok := (aliases[aliasIdx].target).slice(5, (aliases[aliasIdx].target).length());
                if not isComptimeIntToken(tok) { return (ok = false, extText = "", next = extentStart); }
                nVal := comptimeIntValue(tok);
                if nVal <= 0 { return (ok = false, extText = "", next = extentStart); }
                extText = nVal.toText();
            } else {
                return (ok = false, extText = "", next = extentStart);
            }
        }
    } else {
        loop extentEnd < size and source.at(extentEnd).isDigit() {
            extentEnd = extentEnd + 1;
        }
        if extentEnd == extentStart { return (ok = false, extText = "", next = extentStart); }
        extent := syntax.parseDigits(source, extentStart, extentEnd);
        if extent < 0 { return (ok = false, extText = "", next = extentStart); }
        extText = extent.toText();
    }
    afterExtent := syntax.skipTrivia(source, extentEnd, prefix);
    if afterExtent >= size or source.at(afterExtent) =!= closeSym {
        return (ok = false, extText = "", next = afterExtent);
    }
    (ok = true, extText = extText, next = afterExtent + 1)
};

/** Non-failing base atom counterpart to `parseTypeBaseAtomWithSeen`. */
canResolveTypeBaseAtomAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int, allowUnion: Bool): (ok: Bool, kind: String, next: Int) {
    if depthLeft <= 0 { return (ok = false, kind = "", next = position); }
    size := source.length();
    start := syntax.skipTrivia(source, position, prefix);
    if start >= size { return (ok = false, kind = "", next = start); }
    if source.startsWithAt(start, "@enumraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 9);
        if hdr.next < 0 { return (ok = false, kind = "", next = start); }
        bkRaw := decodeLengthPrefixedAt(source, hdr.next);
        if bkRaw.next < 0 { return (ok = false, kind = "", next = start); }
        var cur := bkRaw.next;
        var countEnd := cur;
        loop countEnd < size and source.at(countEnd).isDigit() {
            countEnd = countEnd + 1;
        }
        caseCount := if countEnd > cur { syntax.parseDigits(source, cur, countEnd) } else { 0 };
        cur = if countEnd < size and source.at(countEnd) == ";" { countEnd + 1 } else { countEnd };
        var resolvedBacking := "";
        if bkRaw.text =!= "" {
            bkParsed := self(bkRaw.text, 0, prefix, aliases, "", seen, depthLeft - 1, false);
            if not bkParsed.ok or syntax.skipTrivia(bkRaw.text, bkParsed.next, prefix) < bkRaw.text.length() {
                return (ok = false, kind = "", next = start);
            }
            resolvedBacking = bkParsed.kind;
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        preChk := enumRawPreCheck(source, resolvedBacking, cur, caseCount);
        if not preChk.ok { return (ok = false, kind = "", next = start); }
        if preChk.hasPayload {
            mut encodedPairsBuf: tb.TextBuilder;
            var pCur := cur;
            var ci := 0;
            loop ci < caseCount {
                nDec := decodeLengthPrefixedAt(source, pCur);
                vDec := decodeLengthPrefixedAt(source, nDec.next);
                pCur = vDec.next;
                var payCsv := "";
                if vDec.text.startsWithAt(0, "@pay:") {
                    rawPay := vDec.text.slice(5, vDec.text.length());
                    mut payItems: List<String> = [];
                    if not splitPayloadTypeTexts(rawPay, prefix, mut payItems) { return (ok = false, kind = "", next = start); }
                    mut pKinds: List<String> = [];
                    loop payItems as rp {
                        pRes := canResolveTypeAt(rp, 0, prefix, aliases, genericType, seen, depthLeft - 1);
                        if not pRes.ok or pRes.kind == ir.VALUE_KIND_UNIT or pRes.kind == ir.VALUE_KIND_NEVER or
                        syntax.skipTrivia(rp, pRes.next, prefix) < rp.length() {
                            return (ok = false, kind = "", next = start);
                        }
                        mut pKinds.pushBack(pRes.kind);
                    }
                    payCsv = pKinds.join(",");
                }
                mut encodedPairsBuf.append(encodeLengthPrefixedText(nDec.text));
                mut encodedPairsBuf.append(encodeLengthPrefixedText(payCsv));
                ci = ci + 1;
            }
            return (ok = true, kind = "Enum<" + encodeLengthPrefixedText(effHdr) + encodeLengthPrefixedText("$payload") + caseCount.toText() + ";" + encodedPairsBuf.build() + ">", next = pCur);
        }
        built := buildCanonicalEnumKind(effHdr, resolvedBacking, source, cur, caseCount, prefix);
        if not built.ok { return (ok = false, kind = "", next = start); }
        return (ok = true, kind = built.kind, next = built.next);
    }
    if source.startsWithAt(start, "Enum<") {
        end := skipKindToken(source, start);
        if end > start + 6 and source.at(end - 1) == ">" {
            return (ok = true, kind = source.slice(start, end), next = end);
        }
    }
    if source.startsWithAt(start, "Union<") {
        end := skipKindToken(source, start);
        if end > start + 7 and source.at(end - 1) == ">" {
            uKind := source.slice(start, end);
            if not isUnionKind(uKind) { return (ok = false, kind = "", next = start); }
            return (ok = true, kind = uKind, next = end);
        }
    }
    if source.startsWithAt(start, "Result<") {
        end := skipKindToken(source, start);
        if end > start + 8 and source.at(end - 1) == ">" {
            rKind := source.slice(start, end);
            if not isResultKind(rKind) { return (ok = false, kind = "", next = start); }
            return (ok = true, kind = rKind, next = end);
        }
    }
    if source.startsWithAt(start, "@recraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 8);
        if hdr.next < 0 { return (ok = false, kind = "", next = start); }
        var cur := hdr.next;
        var countEnd := cur;
        loop countEnd < size and source.at(countEnd).isDigit() {
            countEnd = countEnd + 1;
        }
        fieldCount := if countEnd > cur { syntax.parseDigits(source, cur, countEnd) } else { 0 };
        cur = if countEnd < size and source.at(countEnd) == ";" { countEnd + 1 } else { countEnd };
        mut parts: List<String> = [];
        var idx := 0;
        loop idx < fieldCount {
            fName := decodeLengthPrefixedAt(source, cur);
            fType := decodeLengthPrefixedAt(source, fName.next);
            if fName.next < 0 or fType.next < 0 { return (ok = false, kind = "", next = start); }
            cur = fType.next;
            resolvedField := canResolveTypeAt(fType.text, 0, prefix, aliases, genericType, seen, depthLeft - 1);
            if not resolvedField.ok or resolvedField.kind == ir.VALUE_KIND_UNIT or
            syntax.skipTrivia(fType.text, resolvedField.next, prefix) < fType.text.length() {
                return (ok = false, kind = "", next = start);
            }
            (mut parts).pushBack(fName.text + ":" + resolvedField.kind);
            idx = idx + 1;
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        return (ok = true, kind = "Record<" + effHdr + ";" + parts.join(",") + ">", next = cur);
    }
    if source.startsWithAt(start, "Record<") and recordHeaderSemi(source.slice(start, skipKindToken(source, start))) > 7 {
        end := skipKindToken(source, start);
        if end > start + 8 and source.at(end - 1) == ">" {
            return (ok = true, kind = source.slice(start, end), next = end);
        }
    }
    if source.startsWithAt(start, "@distraw:") {
        hdr := decodeLengthPrefixedAt(source, start + 9);
        if hdr.next < 0 { return (ok = false, kind = "", next = start); }
        rawTarget := decodeLengthPrefixedAt(source, hdr.next);
        if rawTarget.next < 0 or rawTarget.text == "" { return (ok = false, kind = "", next = start); }
        resolvedBase := canResolveTypeAt(rawTarget.text, 0, prefix, aliases, genericType, seen, depthLeft - 1);
        if not resolvedBase.ok or resolvedBase.kind == ir.VALUE_KIND_UNIT or resolvedBase.kind == ir.VALUE_KIND_NEVER or isUnionKind(resolvedBase.kind) or
        syntax.skipTrivia(rawTarget.text, resolvedBase.next, prefix) < rawTarget.text.length() {
            return (ok = false, kind = "", next = start);
        }
        effHdr := if genericType =!= "" { hdr.text + "<" + splitCommaNames(genericType).join(",") + ">" } else { hdr.text };
        return (ok = true, kind = "Distinct<" + encodeLengthPrefixedText(effHdr) + resolvedBase.kind + ">", next = rawTarget.next);
    }
    if source.startsWithAt(start, "Distinct<") {
        end := skipKindToken(source, start);
        if end > start + 10 and source.at(end - 1) == ">" {
            return (ok = true, kind = source.slice(start, end), next = end);
        }
    }
    ch := source.at(start);
    if ch == "(" {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        if cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
            grouped := canResolveTypeAt(source, cursor, prefix, aliases, genericType, seen, depthLeft - 1);
            if not grouped.ok { return grouped; }
            closeG := syntax.skipTrivia(source, grouped.next, prefix);
            if closeG >= size or source.at(closeG) =!= ")" { return (ok = false, kind = "", next = closeG); }
            return (ok = true, kind = grouped.kind, next = closeG + 1);
        }
        mut labels: List<String> = [];
        mut parts: List<String> = [];
        var count := 0;
        var hasNamed := false;
        var hadComma := false;
        var singleKind := "";
        loop cursor < size and source.at(cursor) =!= ")" {
            var label := "";
            var fieldStart := cursor;
            if source.at(cursor).isNameStart() {
                afterName := source.skipName(cursor);
                colonPos := syntax.skipTrivia(source, afterName, prefix);
                if colonPos < size and source.at(colonPos) == ":" {
                    candidate := source.slice(cursor, afterName);
                    if syntax.isReservedWord(candidate) or labels.contains(candidate) {
                        return (ok = false, kind = "", next = cursor);
                    }
                    label = candidate;
                    hasNamed = true;
                    mut labels.pushBack(label);
                    fieldStart = syntax.skipTrivia(source, colonPos + 1, prefix);
                }
            }
            parsedField := canResolveTypeAt(source, fieldStart, prefix, aliases, genericType, seen, depthLeft - 1);
            if not parsedField.ok { return (ok = false, kind = "", next = fieldStart); }
            cursor = syntax.skipTrivia(source, parsedField.next, prefix);
            willBeTuple := (count > 0) or hasNamed or hadComma or (cursor < size and source.at(cursor) == ",");
            if willBeTuple and (isTupleKind(parsedField.kind) or isListKind(parsedField.kind) or parsedField.kind == ir.VALUE_KIND_UNIT) {
                return (ok = false, kind = "", next = fieldStart);
            }
            (mut parts).pushBack(label + ":" + parsedField.kind);
            if count == 0 { singleKind = parsedField.kind; }
            count = count + 1;
            if cursor < size and source.at(cursor) == "," {
                hadComma = true;
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            } else {
                hadComma = false;
                break;
            }
        }
        if cursor >= size or source.at(cursor) =!= ")" {
            return (ok = false, kind = "", next = cursor);
        }
        if count == 0 {
            return (ok = false, kind = "", next = start);
        }
        if count == 1 and not hasNamed and not hadComma {
            return (ok = true, kind = singleKind, next = cursor + 1);
        }
        return (ok = true, kind = "(" + parts.join(",") + ")", next = cursor + 1);
    }
    if ch == "{" {
        var bCursor := syntax.skipTrivia(source, start + 1, prefix);
        mut labels: List<String> = [];
        mut fields: List<(label: String, kind: String)> = [];
        loop bCursor < size and source.at(bCursor) =!= "}" {
            var label := "";
            if source.at(bCursor) == "\"" {
                if not canScanValidStringLiteral(source, bCursor, prefix) {
                    return (ok = false, kind = "", next = bCursor);
                }
                qLit := syntax.parseText(ir.TARGET_TS, source, bCursor, prefix);
                label = qLit.textValue;
                bCursor = syntax.skipTrivia(source, qLit.next, prefix);
            } else if source.at(bCursor).isNameStart() {
                lEnd := source.skipName(bCursor);
                label = source.slice(bCursor, lEnd);
                if syntax.isReservedWord(label) { return (ok = false, kind = "", next = bCursor); }
                bCursor = syntax.skipTrivia(source, lEnd, prefix);
            } else {
                return (ok = false, kind = "", next = bCursor);
            }
            if labels.contains(label) { return (ok = false, kind = "", next = bCursor); }
            mut labels.pushBack(label);
            if bCursor >= size or source.at(bCursor) =!= ":" {
                return (ok = false, kind = "", next = bCursor);
            }
            fTypeStart := syntax.skipTrivia(source, bCursor + 1, prefix);
            fRes := canResolveTypeAt(source, fTypeStart, prefix, aliases, genericType, seen, depthLeft - 1);
            if not fRes.ok or fRes.kind == ir.VALUE_KIND_UNIT or borrowedStorageError(fRes.kind) =!= "" {
                return (ok = false, kind = "", next = fTypeStart);
            }
            mut fields.pushBack((label = label, kind = fRes.kind));
            bCursor = syntax.skipTrivia(source, fRes.next, prefix);
            if bCursor < size and (source.at(bCursor) == "," or source.at(bCursor) == ";") {
                bCursor = syntax.skipTrivia(source, bCursor + 1, prefix);
            } else if bCursor < size and source.at(bCursor) == "}" {
                break;
            } else {
                return (ok = false, kind = "", next = bCursor);
            }
        }
        if bCursor >= size or source.at(bCursor) =!= "}" {
            return (ok = false, kind = "", next = bCursor);
        }
        return (ok = true, kind = buildAnonRecordKind(fields), next = bCursor + 1);
    }
    if ch == "[" {
        elem := canResolveTypeAt(source, start + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elem.ok or elem.kind == ir.VALUE_KIND_UNIT { return (ok = false, kind = "", next = start); }
        afterElem := syntax.skipTrivia(source, elem.next, prefix);
        if afterElem >= size or source.at(afterElem) =!= ";" {
            return (ok = false, kind = "", next = afterElem);
        }
        extentStart := syntax.skipTrivia(source, afterElem + 1, prefix);
        ext := canResolveArrayExtent(source, extentStart, "]", prefix, aliases, genericType);
        if not ext.ok { return (ok = false, kind = "", next = ext.next); }
        return (ok = true, kind = "[" + elem.kind + ";" + ext.extText + "]", next = ext.next);
    }
    if source.wordAt(start, "fn") {
        afterFn := syntax.skipTrivia(source, start + 2, prefix);
        if afterFn >= size or source.at(afterFn) =!= "(" {
            return (ok = false, kind = "", next = afterFn);
        }
        var pCursor := syntax.skipTrivia(source, afterFn + 1, prefix);
        mut paramLabels: List<String> = [];
        mut paramParts: List<String> = [];
        loop pCursor < size and source.at(pCursor) =!= ")" {
            var pLabel := "";
            var pOpt := false;
            var pTypeStart := pCursor;
            if pCursor < size and source.at(pCursor) == "?" {
                afterQ := syntax.skipTrivia(source, pCursor + 1, prefix);
                if afterQ >= size or source.at(afterQ) =!= ":" { return (ok = false, kind = "", next = afterQ); }
                pOpt = true;
                pTypeStart = syntax.skipTrivia(source, afterQ + 1, prefix);
            } else if source.at(pCursor).isNameStart() {
                afterPLabel := source.skipName(pCursor);
                pAfter := syntax.skipTrivia(source, afterPLabel, prefix);
                if pAfter < size and source.at(pAfter) == "?" {
                    afterQ := syntax.skipTrivia(source, pAfter + 1, prefix);
                    if afterQ < size and source.at(afterQ) == ":" {
                        candidate := source.slice(pCursor, afterPLabel);
                        if syntax.isReservedWord(candidate) or paramLabels.contains(candidate) {
                            return (ok = false, kind = "", next = pCursor);
                        }
                        pLabel = candidate;
                        mut paramLabels.pushBack(pLabel);
                        pOpt = true;
                        pTypeStart = syntax.skipTrivia(source, afterQ + 1, prefix);
                    }
                } else if pAfter < size and source.at(pAfter) == ":" {
                    candidate := source.slice(pCursor, afterPLabel);
                    if syntax.isReservedWord(candidate) or paramLabels.contains(candidate) {
                        return (ok = false, kind = "", next = pCursor);
                    }
                    pLabel = candidate;
                    mut paramLabels.pushBack(pLabel);
                    pTypeStart = syntax.skipTrivia(source, pAfter + 1, prefix);
                }
            }
            var pAccess := "";
            if source.wordAt(pTypeStart, "mut") {
                if pOpt { return (ok = false, kind = "", next = pTypeStart); }
                pAccess = "mut ";
                pTypeStart = syntax.skipTrivia(source, pTypeStart + 3, prefix);
            }
            parsedParam := canResolveTypeAt(source, pTypeStart, prefix, aliases, genericType, seen, depthLeft - 1);
            if not parsedParam.ok { return (ok = false, kind = "", next = pTypeStart); }
            if pAccess =!= "" and not isGenericParamName(genericType, parsedParam.kind) and not isMutContainerKind(parsedParam.kind) {
                return (ok = false, kind = "", next = pTypeStart);
            }
            optTok := if pOpt { "?:" } else { ":" };
            (mut paramParts).pushBack(pLabel + optTok + pAccess + parsedParam.kind);
            pCursor = syntax.skipTrivia(source, parsedParam.next, prefix);
            if pCursor < size and source.at(pCursor) == "," {
                pCursor = syntax.skipTrivia(source, pCursor + 1, prefix);
            } else {
                break;
            }
        }
        if pCursor >= size or source.at(pCursor) =!= ")" {
            return (ok = false, kind = "", next = pCursor);
        }
        var afterClose := syntax.skipTrivia(source, pCursor + 1, prefix);
        var fnCtxKind := "";
        if afterClose < size and source.wordAt(afterClose, "context") {
            var cCursor := syntax.skipTrivia(source, afterClose + 7, prefix);
            if cCursor >= size or source.at(cCursor) =!= "(" {
                return (ok = false, kind = "", next = cCursor);
            }
            cCursor = syntax.skipTrivia(source, cCursor + 1, prefix);
            if cCursor < size and source.at(cCursor) == ")" {
                return (ok = false, kind = "", next = cCursor);
            }
            mut ctxSlots: List<contexts.CtxSlot> = [];
            mut ctxNames: List<String> = [];
            loop cCursor < size and source.at(cCursor) =!= ")" {
                var cIsMut := false;
                if source.wordAt(cCursor, "mut") {
                    return (ok = false, kind = "", next = cCursor);
                }
                if cCursor >= size or not source.at(cCursor).isNameStart() {
                    return (ok = false, kind = "", next = cCursor);
                }
                cNameEnd := source.skipName(cCursor);
                cName := source.slice(cCursor, cNameEnd);
                if syntax.isReservedWord(cName) or ctxNames.contains(cName) {
                    return (ok = false, kind = "", next = cCursor);
                }
                mut ctxNames.pushBack(cName);
                cCursor = syntax.skipTrivia(source, cNameEnd, prefix);
                if cCursor >= size or source.at(cCursor) =!= ":" {
                    return (ok = false, kind = "", next = cCursor);
                }
                cCursor = syntax.skipTrivia(source, cCursor + 1, prefix);
                if source.wordAt(cCursor, "mut") {
                    if cIsMut { return (ok = false, kind = "", next = cCursor); }
                    cIsMut = true;
                    cCursor = syntax.skipTrivia(source, cCursor + 3, prefix);
                }
                cType := self(source, cCursor, prefix, aliases, genericType, seen, depthLeft - 1, false);
                if not cType.ok or cType.kind == ir.VALUE_KIND_UNIT {
                    return (ok = false, kind = "", next = cCursor);
                }
                mut ctxSlots.pushBack(contexts.CtxSlot { name = cName, isMut = cIsMut, kind = cType.kind });
                cCursor = syntax.skipTrivia(source, cType.next, prefix);
                if cCursor < size and source.at(cCursor) == "," {
                    cCursor = syntax.skipTrivia(source, cCursor + 1, prefix);
                } else {
                    break;
                }
            }
            if cCursor >= size or source.at(cCursor) =!= ")" {
                return (ok = false, kind = "", next = cCursor);
            }
            fnCtxKind = contexts.buildCanonicalCtxKind(ctxSlots);
            afterClose = syntax.skipTrivia(source, cCursor + 1, prefix);
        }
        if afterClose >= size or source.at(afterClose) =!= ":" {
            return (ok = false, kind = "", next = afterClose);
        }
        retType := canResolveTypeAt(source, afterClose + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not retType.ok { return (ok = false, kind = "", next = afterClose + 1); }
        return (ok = true, kind = "fn(" + paramParts.join(",") + ")" + fnAtCtxSuffix(fnCtxKind) + ":" + retType.kind, next = retType.next);
    }
    if not ch.isNameStart() { return (ok = false, kind = "", next = start); }
    if source.wordAt(start, "dyn") and findAlias(aliases, "dyn") < 0 and not isGenericParamName(genericType, "dyn") {
        ifaceStart := syntax.skipTrivia(source, start + 3, prefix);
        if ifaceStart >= size or not source.at(ifaceStart).isNameStart() {
            return (ok = false, kind = "", next = ifaceStart);
        }
        ifaceRes := self(source, ifaceStart, prefix, aliases, genericType, seen, depthLeft - 1, true);
        if not ifaceRes.ok or not isInterfaceKind(ifaceRes.kind) {
            return (ok = false, kind = "", next = ifaceStart);
        }
        iIdx := interfaces.findInterface(ifaceKeyOf(ifaceRes.kind));
        if iIdx >= 0 and not interfaces.getInterface(iIdx).isObjectSafe {
            return (ok = false, kind = "", next = ifaceStart);
        }
        return (ok = true, kind = "Dyn<" + ifaceRes.kind + ">", next = ifaceRes.next);
    }
    var afterName := source.skipName(start);
    var name := source.slice(start, afterName);
    dotCheck := syntax.skipTrivia(source, afterName, prefix);
    if dotCheck < size and source.at(dotCheck) == "." {
        memCheckStart := syntax.skipTrivia(source, dotCheck + 1, prefix);
        if memCheckStart < size and source.at(memCheckStart).isNameStart() {
            memCheckEnd := source.skipName(memCheckStart);
            memWord := source.slice(memCheckStart, memCheckEnd);
            rawModPart := name;
            modAliasIdx := findAlias(aliases, "$modalias:" + rawModPart);
            effModPart := if modAliasIdx >= 0 { aliases[modAliasIdx].target } else { rawModPart };
            qualCandidate := effModPart + "." + memWord;
            if findAlias(aliases, qualCandidate) >= 0 {
                name = qualCandidate;
                afterName = memCheckEnd;
            } else if name == "Self" {
                selfAssocIdx := findAlias(aliases, "$self_assoc:" + memWord);
                if selfAssocIdx >= 0 and aliases[selfAssocIdx].target.startsWithAt(0, "$Kind:") {
                    return (ok = true, kind = aliases[selfAssocIdx].target.slice(6, aliases[selfAssocIdx].target.length()), next = memCheckEnd);
                }
                return (ok = false, kind = "", next = memCheckStart);
            } else if isGenericParamName(genericType, name) {
                gHit := findGenericParamAssocIface(genericType, name, memWord);
                if gHit.ok {
                    return (ok = true, kind = "$Assoc<" + name + ";" + gHit.ifaceKind + ";" + memWord + ">", next = memCheckEnd);
                }
                return (ok = false, kind = "", next = memCheckStart);
            }
        }
    }
    var resolvedName := name;
    var resolvedBuiltinFamily := "";
    if name == "Self" {
        selfIdx := findAlias(aliases, "Self");
        if selfIdx >= 0 and aliases[selfIdx].target.startsWithAt(0, "$Family:") {
            fam := aliases[selfIdx].target.slice(8, aliases[selfIdx].target.length());
            resolvedName = fam;
            resolvedBuiltinFamily = fam;
        }
    } else {
        resolvedBuiltinFamily = builtinFamilyFromAlias(aliases, resolvedName);
    }
    if resolvedName == "List" {
        afterList := syntax.skipTrivia(source, afterName, prefix);
        if afterList >= size or source.at(afterList) =!= "<" {
            return (ok = false, kind = "", next = afterList);
        }
        elem := canResolveTypeAt(source, afterList + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elem.ok or isListKind(elem.kind) or elem.kind == ir.VALUE_KIND_UNIT {
            return (ok = false, kind = "", next = afterList + 1);
        }
        close := syntax.skipTrivia(source, elem.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "List<" + elem.kind + ">", next = close + 1);
    }
    if resolvedName == "Array" {
        afterArr := syntax.skipTrivia(source, afterName, prefix);
        if afterArr >= size or source.at(afterArr) =!= "<" {
            return (ok = false, kind = "", next = afterArr);
        }
        elem := canResolveTypeAt(source, afterArr + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elem.ok or elem.kind == ir.VALUE_KIND_UNIT {
            return (ok = false, kind = "", next = afterArr + 1);
        }
        afterElem := syntax.skipTrivia(source, elem.next, prefix);
        if afterElem < size and source.at(afterElem) == ">" {
            return (ok = false, kind = "", next = afterElem);
        }
        if afterElem >= size or source.at(afterElem) =!= "," {
            return (ok = false, kind = "", next = afterElem);
        }
        extentStart := syntax.skipTrivia(source, afterElem + 1, prefix);
        ext := canResolveArrayExtent(source, extentStart, ">", prefix, aliases, genericType);
        if not ext.ok { return (ok = false, kind = "", next = ext.next); }
        return (ok = true, kind = "[" + elem.kind + ";" + ext.extText + "]", next = ext.next);
    }
    if resolvedName == "Map" {
        afterMap := syntax.skipTrivia(source, afterName, prefix);
        if afterMap >= size or source.at(afterMap) =!= "<" {
            return (ok = false, kind = "", next = afterMap);
        }
        keyRes := self(source, afterMap + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not keyRes.ok or (not isGenericParamName(genericType, distinctBaseKind(keyRes.kind)) and not isMapKeyKind(keyRes.kind)) {
            return (ok = false, kind = "", next = afterMap + 1);
        }
        comma := syntax.skipTrivia(source, keyRes.next, prefix);
        if comma >= size or source.at(comma) =!= "," {
            return (ok = false, kind = "", next = comma);
        }
        valRes := canResolveTypeAt(source, comma + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not valRes.ok or valRes.kind == ir.VALUE_KIND_UNIT or valRes.kind == ir.VALUE_KIND_NEVER {
            return (ok = false, kind = "", next = comma + 1);
        }
        close := syntax.skipTrivia(source, valRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "Map<" + keyRes.kind + "," + valRes.kind + ">", next = close + 1);
    }
    if resolvedName == "Set" {
        afterSet := syntax.skipTrivia(source, afterName, prefix);
        if afterSet >= size or source.at(afterSet) =!= "<" {
            return (ok = false, kind = "", next = afterSet);
        }
        elemRes := self(source, afterSet + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not elemRes.ok or (not isGenericParamName(genericType, distinctBaseKind(elemRes.kind)) and not isMapKeyKind(elemRes.kind)) {
            return (ok = false, kind = "", next = afterSet + 1);
        }
        close := syntax.skipTrivia(source, elemRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "Set<" + elemRes.kind + ">", next = close + 1);
    }
    if resolvedBuiltinFamily == "Rc" {
        afterRc := syntax.skipTrivia(source, afterName, prefix);
        if afterRc >= size or source.at(afterRc) =!= "<" {
            return (ok = false, kind = "", next = afterRc);
        }
        elemRes := canResolveTypeAt(source, afterRc + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elemRes.ok or elemRes.kind == ir.VALUE_KIND_UNIT or elemRes.kind == ir.VALUE_KIND_NEVER {
            return (ok = false, kind = "", next = afterRc + 1);
        }
        close := syntax.skipTrivia(source, elemRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "Rc<" + elemRes.kind + ">", next = close + 1);
    }
    if resolvedBuiltinFamily == "Slice" {
        afterSl := syntax.skipTrivia(source, afterName, prefix);
        if afterSl >= size or source.at(afterSl) =!= "<" {
            return (ok = false, kind = "", next = afterSl);
        }
        elemRes := self(source, afterSl + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not elemRes.ok or elemRes.kind == ir.VALUE_KIND_UNIT or elemRes.kind == ir.VALUE_KIND_NEVER or containsSliceKind(elemRes.kind) or containsDynKind(elemRes.kind) {
            return (ok = false, kind = "", next = afterSl + 1);
        }
        close := syntax.skipTrivia(source, elemRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "Slice<" + elemRes.kind + ">", next = close + 1);
    }
    if resolvedBuiltinFamily == "Simd" {
        afterSm := syntax.skipTrivia(source, afterName, prefix);
        if afterSm >= size or source.at(afterSm) =!= "<" {
            return (ok = false, kind = "", next = afterSm);
        }
        elemRes := self(source, afterSm + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not elemRes.ok or (not isGenericParamName(genericType, distinctBaseKind(elemRes.kind)) and not isSimdElemKind(elemRes.kind)) {
            return (ok = false, kind = "", next = afterSm + 1);
        }
        comma := syntax.skipTrivia(source, elemRes.next, prefix);
        if comma >= size or source.at(comma) =!= "," {
            return (ok = false, kind = "", next = comma);
        }
        extPos := syntax.skipTrivia(source, comma + 1, prefix);
        var extEnd := extPos;
        var lanesTxt := "";
        if extPos < size and source.at(extPos).isNameStart() {
            extEnd = source.skipName(extPos);
            candName := source.slice(extPos, extEnd);
            if valueParamKind(genericType, candName) == ir.VALUE_KIND_INT {
                lanesTxt = candName;
            } else {
                aIdx := findAlias(aliases, candName);
                if aIdx >= 0 and (aliases[aIdx].target).startsWithAt(0, "$Val:") {
                    tok := (aliases[aIdx].target).slice(5, (aliases[aIdx].target).length());
                    if isComptimeIntToken(tok) and comptimeIntValue(tok) > 1 {
                        lanesTxt = comptimeIntValue(tok).toText();
                    }
                }
            }
        } else {
            loop extEnd < size and source.at(extEnd).isDigit() { extEnd = extEnd + 1; }
            if extEnd > extPos {
                nVal := syntax.parseDigits(source, extPos, extEnd);
                lanesTxt = nVal.toText();
            }
        }
        if lanesTxt == "" {
            return (ok = false, kind = "", next = extPos);
        }
        if valueParamKind(genericType, lanesTxt) =!= ir.VALUE_KIND_INT {
            nLanes := syntax.parseDigits(lanesTxt, 0, lanesTxt.length());
            if nLanes =!= 2 and nLanes =!= 4 and nLanes =!= 8 and nLanes =!= 16 and nLanes =!= 32 and nLanes =!= 64 {
                return (ok = false, kind = "", next = extPos);
            }
            if not isGenericParamName(genericType, distinctBaseKind(elemRes.kind)) and not isValidSimdLaneCount(elemRes.kind, nLanes) {
                return (ok = false, kind = "", next = extPos);
            }
        }
        close := syntax.skipTrivia(source, extEnd, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "Simd<" + elemRes.kind + "," + lanesTxt + ">", next = close + 1);
    }
    if resolvedBuiltinFamily == "SimdNative" {
        afterSn := syntax.skipTrivia(source, afterName, prefix);
        if afterSn >= size or source.at(afterSn) =!= "<" {
            return (ok = false, kind = "", next = afterSn);
        }
        elemRes := self(source, afterSn + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not elemRes.ok {
            return (ok = false, kind = "", next = afterSn + 1);
        }
        close := syntax.skipTrivia(source, elemRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        if isGenericParamName(genericType, distinctBaseKind(elemRes.kind)) {
            return (ok = true, kind = "SimdNative<" + elemRes.kind + ">", next = close + 1);
        }
        if not isSimdElemKind(elemRes.kind) {
            return (ok = false, kind = "", next = afterSn + 1);
        }
        return (ok = true, kind = "Simd<" + elemRes.kind + "," + simdNativeLaneCount(elemRes.kind).toText() + ">", next = close + 1);
    }
    if resolvedBuiltinFamily == "SoA" {
        afterSoa := syntax.skipTrivia(source, afterName, prefix);
        if afterSoa >= size or source.at(afterSoa) =!= "<" {
            return (ok = false, kind = "", next = afterSoa);
        }
        recRes := self(source, afterSoa + 1, prefix, aliases, genericType, seen, depthLeft - 1, false);
        if not recRes.ok or containsSliceKind(recRes.kind) or containsDynKind(recRes.kind) {
            return (ok = false, kind = "", next = afterSoa + 1);
        }
        if not isGenericParamName(genericType, distinctBaseKind(recRes.kind)) {
            if not isRecordKind(recRes.kind) or recordComponentCount(recRes.kind) == 0 or not cIsSupportedElem(recRes.kind) {
                return (ok = false, kind = "", next = afterSoa + 1);
            }
        }
        close := syntax.skipTrivia(source, recRes.next, prefix);
        if close >= size or source.at(close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "SoA<" + recRes.kind + ">", next = close + 1);
    }
    isOverridableNum := name == ir.VALUE_KIND_INT or name == ir.VALUE_KIND_FLOAT or name == "Double";
    if not (isOverridableNum and findAlias(aliases, name) >= 0) {
        if name == ir.VALUE_KIND_INT or name == ir.VALUE_KIND_FLOAT or name == ir.VALUE_KIND_STRING or name == ir.VALUE_KIND_BOOL or name == ir.VALUE_KIND_UNIT {
            return (ok = true, kind = name, next = afterName);
        }
        if numeric.numericAliasKind(name) =!= "" {
            return (ok = true, kind = numeric.numericAliasKind(name), next = afterName);
        }
        if numeric.isNarrowNumericKind(name) {
            return (ok = true, kind = name, next = afterName);
        }
    }
    if isGenericParamName(genericType, name) {
        return (ok = true, kind = name, next = afterName);
    }
    aliasIdx := findAlias(aliases, name);
    if aliasIdx < 0 {
        if name == "Error" { return (ok = true, kind = CORE_ERROR_KIND, next = afterName); }
        return (ok = false, kind = "", next = afterName);
    }
    aliasItem := aliases[aliasIdx];
    if aliasItem.target == "$symalias" {
        return (ok = false, kind = "", next = afterName);
    }
    seenKey := (aliasItem.depth).toText() + ":" + name;
    if aliasItem.target == "" {
        return (ok = false, kind = "", next = afterName);
    }
    if (aliasItem.target).startsWithAt(0, "$Kind:") {
        kindVal := (aliasItem.target).slice(6, (aliasItem.target).length());
        if (isUnionKind(kindVal) or isInterfaceKind(kindVal)) and not allowUnion {
            return (ok = false, kind = "", next = afterName);
        }
        return (ok = true, kind = kindVal, next = afterName);
    }
    if (aliasItem.target).startsWithAt(0, "$BuiltinFamily:") {
        return (ok = false, kind = "", next = afterName);
    }
    isGenRaw := (aliasItem.target).startsWithAt(0, "@genraw:");
    isGenTpl := (aliasItem.target).startsWithAt(0, "@gentpl:");
    if isGenRaw or isGenTpl {
        pDec := decodeLengthPrefixedAt(aliasItem.target, 8);
        if pDec.next < 0 { return (ok = false, kind = "", next = afterName); }
        tplParamsCsv := pDec.text;
        tplBody := (aliasItem.target).slice(pDec.next, (aliasItem.target).length());
        afterArgsOpen := syntax.skipTrivia(source, afterName, prefix);
        if afterArgsOpen >= size or source.at(afterArgsOpen) =!= "<" {
            return (ok = false, kind = "", next = afterName);
        }
        scopedTplAliases := aliasesUpToDepth(aliases, aliasItem.depth);
        var resolvedTplParamsCsv := tplParamsCsv;
        if isGenRaw {
            mut resSpecs: List<String> = [];
            emptySpecSeen: List<String> = [];
            loop splitParamSpecs(tplParamsCsv) as sp {
                if sp.kind == "" {
                    mut resSpecs.pushBack(sp.name);
                } else if isTypeConstraintKind(sp.kind) {
                    rawBounds := typeConstraintUnion(sp.kind);
                    mut boundList: List<String> = [];
                    loop splitTopLevelCommaRaw(rawBounds, prefix) as rb {
                        var bCur := syntax.skipTrivia(rb, 0, prefix);
                        bAtom0 := self(rb, bCur, prefix, scopedTplAliases, "", emptySpecSeen, depthLeft - 1, true);
                        if not bAtom0.ok or bAtom0.kind == ir.VALUE_KIND_UNIT or bAtom0.kind == ir.VALUE_KIND_NEVER {
                            return (ok = false, kind = "", next = afterArgsOpen);
                        }
                        mut bMembers: List<String> = [bAtom0.kind];
                        bCur = syntax.skipTrivia(rb, bAtom0.next, prefix);
                        loop bCur < rb.length() and rb.at(bCur) == "|" and not rb.startsWithAt(bCur, "||") {
                            bNext := syntax.skipTrivia(rb, bCur + 1, prefix);
                            bAtom := self(rb, bNext, prefix, scopedTplAliases, "", emptySpecSeen, depthLeft - 1, true);
                            if not bAtom.ok or bAtom.kind == ir.VALUE_KIND_UNIT or bAtom.kind == ir.VALUE_KIND_NEVER {
                                return (ok = false, kind = "", next = afterArgsOpen);
                            }
                            mut bMembers.pushBack(bAtom.kind);
                            bCur = syntax.skipTrivia(rb, bAtom.next, prefix);
                        }
                        if bCur < rb.length() { return (ok = false, kind = "", next = afterArgsOpen); }
                        mut boundList.pushBack(buildUnionKind(bMembers));
                    }
                    inter := intersectConstraintBounds(boundList);
                    if not inter.ok { return (ok = false, kind = "", next = afterArgsOpen); }
                    mut resSpecs.pushBack(sp.name + "=Type<" + inter.kind + ">");
                } else {
                    dRes := resolveDiscreteType(scopedTplAliases, sp.kind, prefix);
                    if not dRes.ok { return (ok = false, kind = "", next = afterArgsOpen); }
                    mut resSpecs.pushBack(sp.name + "=" + dRes.kind);
                }
            }
            resolvedTplParamsCsv = resSpecs.join(",");
        }
        paramSpecs := splitParamSpecs(resolvedTplParamsCsv);
        var argCursor := syntax.skipTrivia(source, afterArgsOpen + 1, prefix);
        if argCursor >= size or source.at(argCursor) == ">" {
            return (ok = false, kind = "", next = argCursor);
        }
        mut argKinds: List<String> = [];
        var argIdx := 0;
        loop true {
            if argIdx >= paramSpecs.length() {
                return (ok = false, kind = "", next = argCursor);
            }
            pSpec := paramSpecs[argIdx];
            if isTypeParamKind(pSpec.kind) {
                argParsed := canResolveTypeAt(source, argCursor, prefix, aliases, genericType, seen, depthLeft - 1);
                if not argParsed.ok { return (ok = false, kind = "", next = argCursor); }
                mut argKinds.pushBack(argParsed.kind);
                argCursor = syntax.skipTrivia(source, argParsed.next, prefix);
            } else {
                valArg := parseComptimeValueArg(source, argCursor, prefix, aliases, genericType, pSpec.kind);
                if not valArg.ok { return (ok = false, kind = "", next = argCursor); }
                mut argKinds.pushBack(valArg.token);
                argCursor = syntax.skipTrivia(source, valArg.next, prefix);
            }
            argIdx = argIdx + 1;
            if argCursor < size and source.at(argCursor) == "," {
                argCursor = syntax.skipTrivia(source, argCursor + 1, prefix);
                if argCursor < size and source.at(argCursor) == ">" { break; }
            } else {
                break;
            }
        }
        if argCursor >= size or source.at(argCursor) =!= ">" {
            return (ok = false, kind = "", next = argCursor);
        }
        afterClose := argCursor + 1;
        if argKinds.length() =!= paramSpecs.length() {
            return (ok = false, kind = "", next = afterClose);
        }
        var chkIdx := 0;
        loop chkIdx < paramSpecs.length() {
            cSpec := paramSpecs[chkIdx];
            if isTypeConstraintKind(cSpec.kind) {
                constraint := typeConstraintUnion(cSpec.kind);
                argK := argKinds[chkIdx];
                if isGenericParamName(genericType, argK) {
                    outerC := typeParamConstraintKind(genericType, argK);
                    if outerC == "" or not constraintIsSubset(outerC, constraint) {
                        return (ok = false, kind = "", next = afterClose);
                    }
                } else if not kindHasAnyGenericParam(genericType, argK) {
                    if not typeSatisfiesConstraint(argK, constraint) {
                        return (ok = false, kind = "", next = afterClose);
                    }
                }
            }
            chkIdx = chkIdx + 1;
        }
        var templateKind := tplBody;
        if isGenRaw {
            if seen.contains(seenKey) { return (ok = false, kind = "", next = afterClose); }
            mut nextSeen: List<String> = [];
            loop seen as sEntry { mut nextSeen.pushBack(sEntry); }
            (mut nextSeen).pushBack(seenKey);
            resolved := canResolveTypeAt(tplBody, 0, prefix, scopedTplAliases, resolvedTplParamsCsv, nextSeen, depthLeft - 1);
            if not resolved.ok or syntax.skipTrivia(tplBody, resolved.next, prefix) < tplBody.length() {
                return (ok = false, kind = "", next = afterClose);
            }
            templateKind = resolved.kind;
        }
        mut bindings: Map<String, String>;
        var bi := 0;
        loop bi < paramSpecs.length() {
            mut bindings.set(paramSpecs[bi].name, argKinds[bi]);
            bi = bi + 1;
        }
        instKind := substCanonicalKind(resolvedTplParamsCsv, templateKind, bindings);
        if isInterfaceKind(instKind) {
            if not allowUnion {
                return (ok = false, kind = "", next = afterClose);
            }
            loop ifaceArgsOf(instKind) as ia {
                if validateCanonicalKind(ia, genericType) =!= "" {
                    return (ok = false, kind = "", next = afterClose);
                }
            }
        } else {
            if validateCanonicalKind(instKind, genericType) =!= "" {
                return (ok = false, kind = "", next = afterClose);
            }
        }
        return (ok = true, kind = instKind, next = afterClose);
    }
    if seen.contains(seenKey) {
        return (ok = false, kind = "", next = afterName);
    }
    mut nextSeen: List<String> = [];
    loop seen as entry { mut nextSeen.pushBack(entry); }
    (mut nextSeen).pushBack(seenKey);
    scopedAliases := aliasesUpToDepth(aliases, aliasItem.depth);
    resolved := if allowUnion {
        canResolveConstraintTypeAt(aliasItem.target, 0, prefix, scopedAliases, "", nextSeen, depthLeft - 1)
    } else {
        canResolveTypeAt(aliasItem.target, 0, prefix, scopedAliases, "", nextSeen, depthLeft - 1)
    };
    if not resolved.ok { return (ok = false, kind = "", next = afterName); }
    trailing := syntax.skipTrivia(aliasItem.target, resolved.next, prefix);
    if trailing < (aliasItem.target).length() {
        return (ok = false, kind = "", next = afterName);
    }
    if isInterfaceKind(resolved.kind) and not allowUnion {
        return (ok = false, kind = "", next = afterName);
    }
    (ok = true, kind = resolved.kind, next = afterName)
};

/** Non-failing counterpart to `parseTypeAtomWithSeen`, consuming trailing `.Assoc` projections only when unambiguously resolved. */
canResolveTypeAtomAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int, allowUnion: Bool): (ok: Bool, kind: String, next: Int) {
    base := canResolveTypeBaseAtomAt(source, position, prefix, aliases, genericType, seen, depthLeft, allowUnion);
    if not base.ok { return base; }
    var resKind := base.kind;
    var resNext := base.next;
    size := source.length();
    var cursor := syntax.skipTrivia(source, resNext, prefix);
    loop cursor < size and source.at(cursor) == "." {
        assocStart := syntax.skipTrivia(source, cursor + 1, prefix);
        if assocStart >= size or not source.at(assocStart).isNameStart() { break; }
        assocEnd := source.skipName(assocStart);
        assocName := source.slice(assocStart, assocEnd);
        resolved := tryResolveConcreteAssoc(resKind, assocName);
        if not resolved.found or resolved.ambiguous { break; }
        resKind = resolved.kind;
        resNext = assocEnd;
        cursor = syntax.skipTrivia(source, resNext, prefix);
    }
    (ok = true, kind = resKind, next = resNext)
};

/** Non-failing type resolver permitting closed union `A | B` expressions (used inside `Type<...>` bounds). */
pub canResolveConstraintTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int): (ok: Bool, kind: String, next: Int) {
    size := source.length();
    var start := syntax.skipTrivia(source, position, prefix);
    if start < size and source.at(start) == "|" and not source.startsWithAt(start, "||") {
        start = syntax.skipTrivia(source, start + 1, prefix);
    }
    atom0 := canResolveTypeAtomAt(source, start, prefix, aliases, genericType, seen, depthLeft, true);
    if not atom0.ok { return atom0; }
    var endBeforeTrivia := atom0.next;
    var cursor := syntax.skipTrivia(source, atom0.next, prefix);
    if cursor >= size or source.at(cursor) =!= "|" or source.startsWithAt(cursor, "||") {
        return (ok = true, kind = atom0.kind, next = endBeforeTrivia);
    }
    if atom0.kind == ir.VALUE_KIND_UNIT or atom0.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(atom0.kind) {
        return (ok = false, kind = "", next = cursor);
    }
    mut members: List<String> = [atom0.kind];
    loop cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
        nextPos := syntax.skipTrivia(source, cursor + 1, prefix);
        elem := canResolveTypeAtomAt(source, nextPos, prefix, aliases, genericType, seen, depthLeft, true);
        if not elem.ok or elem.kind == ir.VALUE_KIND_UNIT or elem.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(elem.kind) {
            return (ok = false, kind = "", next = cursor);
        }
        mut members.pushBack(elem.kind);
        endBeforeTrivia = elem.next;
        cursor = syntax.skipTrivia(source, elem.next, prefix);
    }
    (ok = true, kind = buildUnionKind(members), next = endBeforeTrivia)
};

/** Non-failing type resolver mirroring `parseTypeAt` (supports runtime unions, optional leading `|`, `!`, and `T!`). */
pub canResolveTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int): (ok: Bool, kind: String, next: Int) {
    if depthLeft <= 0 { return (ok = false, kind = "", next = position); }
    size := source.length();
    var start := syntax.skipTrivia(source, position, prefix);
    var hadLeadingBar := false;
    if start < size and source.at(start) == "|" and not source.startsWithAt(start, "||") {
        hadLeadingBar = true;
        start = syntax.skipTrivia(source, start + 1, prefix);
    }
    atom0 := canResolveTypeAtomAt(source, start, prefix, aliases, genericType, seen, depthLeft, false);
    if not atom0.ok { return atom0; }
    var endBeforeTrivia := atom0.next;
    var cursor := syntax.skipTrivia(source, atom0.next, prefix);
    var leftKind := atom0.kind;
    if cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
        if leftKind == ir.VALUE_KIND_NEVER or isInterfaceKind(leftKind) or borrowedStorageError(leftKind) =!= "" {
            return (ok = false, kind = "", next = cursor);
        }
        mut members: List<String> = [leftKind];
        loop cursor < size and source.at(cursor) == "|" and not source.startsWithAt(cursor, "||") {
            nextPos := syntax.skipTrivia(source, cursor + 1, prefix);
            elem := canResolveTypeAtomAt(source, nextPos, prefix, aliases, genericType, seen, depthLeft, false);
            if not elem.ok or elem.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(elem.kind) or borrowedStorageError(elem.kind) =!= "" {
                return (ok = false, kind = "", next = cursor);
            }
            mut members.pushBack(elem.kind);
            endBeforeTrivia = elem.next;
            cursor = syntax.skipTrivia(source, elem.next, prefix);
        }
        leftKind = buildUnionKind(members);
    } else if hadLeadingBar {
        if leftKind == ir.VALUE_KIND_NEVER or isInterfaceKind(leftKind) or borrowedStorageError(leftKind) =!= "" {
            return (ok = false, kind = "", next = start);
        }
    }
    if cursor < size and source.at(cursor) == "!" {
        if leftKind == ir.VALUE_KIND_NEVER or isInterfaceKind(leftKind) or borrowedStorageError(leftKind) =!= "" {
            return (ok = false, kind = "", next = cursor);
        }
        isAttached := cursor == endBeforeTrivia;
        afterBang := syntax.skipTrivia(source, cursor + 1, prefix);
        if afterBang < size and source.at(afterBang) == "!" {
            return (ok = false, kind = "", next = afterBang);
        }
        if not startsTypeTokenAt(source, afterBang, prefix) {
            if not isAttached {
                return (ok = false, kind = "", next = cursor);
            }
            return (ok = true, kind = buildResultKind(leftKind, CORE_ERROR_KIND), next = cursor + 1);
        }
        var errStart := afterBang;
        if errStart < size and source.at(errStart) == "|" and not source.startsWithAt(errStart, "||") {
            errStart = syntax.skipTrivia(source, errStart + 1, prefix);
        }
        err0 := canResolveTypeAtomAt(source, errStart, prefix, aliases, genericType, seen, depthLeft, false);
        if not err0.ok or err0.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(err0.kind) or borrowedStorageError(err0.kind) =!= "" {
            return (ok = false, kind = "", next = cursor);
        }
        var errEnd := err0.next;
        var errCursor := syntax.skipTrivia(source, err0.next, prefix);
        var errKind := err0.kind;
        if errCursor < size and source.at(errCursor) == "|" and not source.startsWithAt(errCursor, "||") {
            mut errMems: List<String> = [err0.kind];
            loop errCursor < size and source.at(errCursor) == "|" and not source.startsWithAt(errCursor, "||") {
                eNext := syntax.skipTrivia(source, errCursor + 1, prefix);
                eAtom := canResolveTypeAtomAt(source, eNext, prefix, aliases, genericType, seen, depthLeft, false);
                if not eAtom.ok or eAtom.kind == ir.VALUE_KIND_NEVER or isInterfaceKind(eAtom.kind) or borrowedStorageError(eAtom.kind) =!= "" {
                    return (ok = false, kind = "", next = errCursor);
                }
                mut errMems.pushBack(eAtom.kind);
                errEnd = eAtom.next;
                errCursor = syntax.skipTrivia(source, eAtom.next, prefix);
            }
            errKind = buildUnionKind(errMems);
        }
        if errCursor < size and source.at(errCursor) == "!" {
            return (ok = false, kind = "", next = errCursor);
        }
        return (ok = true, kind = buildResultKind(leftKind, errKind), next = errEnd);
    }
    (ok = true, kind = leftKind, next = endBeforeTrivia)
};

/** Non-failing resolution and intersection of comptime `<...>` parameter specs for header guards. */
pub canResolveComptimeParamSpecs := fn(prefix: String, aliases: List<AliasDecl>, rawParamsCsv: String): (ok: Bool, csv: String) {
    if rawParamsCsv == "" { return (ok = true, csv = ""); }
    mut out: List<String> = [];
    emptySeen: List<String> = [];
    loop splitParamSpecs(rawParamsCsv) as spec {
        alreadyCsv := out.join(",");
        if spec.kind == "" {
            mut out.pushBack(spec.name);
        } else if isTypeConstraintKind(spec.kind) {
            rawBounds := typeConstraintUnion(spec.kind);
            mut boundKinds: List<String> = [];
            loop splitTopLevelCommaRaw(rawBounds, prefix) as rb {
                bParsed := canResolveConstraintTypeAt(rb, 0, prefix, aliases, alreadyCsv, emptySeen, 32);
                if not bParsed.ok or syntax.skipTrivia(rb, bParsed.next, prefix) < rb.length() {
                    return (ok = false, csv = "");
                }
                if bParsed.kind == ir.VALUE_KIND_UNIT or bParsed.kind == ir.VALUE_KIND_NEVER {
                    return (ok = false, csv = "");
                }
                mut boundKinds.pushBack(bParsed.kind);
            }
            inter := intersectConstraintBounds(boundKinds);
            if not inter.ok { return (ok = false, csv = ""); }
            mut out.pushBack(spec.name + "=Type<" + inter.kind + ">");
        } else {
            res := resolveDiscreteType(aliases, spec.kind, prefix);
            if not res.ok { return (ok = false, csv = ""); }
            mut out.pushBack(spec.name + "=" + res.kind);
        }
    }
    (ok = true, csv = out.join(","))
};

/** Non-failing guard checking whether `parseLocalType` can succeed at `position`. */
pub canPreResolveLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): Bool {
    cursor := syntax.skipTrivia(source, position, prefix);
    if source.wordAt(cursor, "mut") {
        return false;
    }
    emptySeen: List<String> = [];
    canResolveTypeAt(source, cursor, prefix, aliases, "", emptySeen, 32).ok
};

/** Non-failing guard checking whether `parseFunctionHeader` can succeed at `position` without triggering diagnostics. */
pub canPreParseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): Bool {
    size := source.length();
    var cursor := syntax.skipTrivia(source, position, prefix);
    var genericType := "";
    if cursor < size and source.at(cursor) == "<" {
        if listIntrinsic {
            binderStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if binderStart >= size or not source.at(binderStart).isNameStart() { return false; }
            binderEnd := source.skipName(binderStart);
            binder := source.slice(binderStart, binderEnd);
            afterBinder := syntax.skipTrivia(source, binderEnd, prefix);
            if binder == "K" and afterBinder < size and source.at(afterBinder) == "," {
                sStart := syntax.skipTrivia(source, afterBinder + 1, prefix);
                if sStart >= size or not source.at(sStart).isNameStart() { return false; }
                sEnd := source.skipName(sStart);
                if source.slice(sStart, sEnd) =!= "V" { return false; }
                afterSecond := syntax.skipTrivia(source, sEnd, prefix);
                if afterSecond >= size or source.at(afterSecond) =!= ">" { return false; }
                genericType = "K,V";
                cursor = syntax.skipTrivia(source, afterSecond + 1, prefix);
            } else {
                if binder =!= "T" { return false; }
                if afterBinder >= size or source.at(afterBinder) =!= ">" { return false; }
                genericType = "T";
                cursor = syntax.skipTrivia(source, afterBinder + 1, prefix);
            }
        } else {
            gp := scanComptimeTypeParams(source, cursor, prefix);
            if not gp.ok or not gp.hasParams { return false; }
            resGp := canResolveComptimeParamSpecs(prefix, aliases, gp.paramsCsv);
            if not resGp.ok { return false; }
            genericType = resGp.csv;
            cursor = syntax.skipTrivia(source, gp.next, prefix);
        }
    }
    if cursor >= size or source.at(cursor) =!= "(" { return false; }
    cursor = syntax.skipTrivia(source, cursor + 1, prefix);
    mut names: List<String> = [];
    emptySeen: List<String> = [];
    var paramCount := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        if source.startsWithAt(cursor, "...") {
            if not listIntrinsic or paramCount > 0 { return false; }
            packStart := syntax.skipTrivia(source, cursor + 3, prefix);
            if packStart >= size or not source.at(packStart).isNameStart() { return false; }
            packEnd := source.skipName(packStart);
            if syntax.isReservedWord(source.slice(packStart, packEnd)) { return false; }
            afterPack := syntax.skipTrivia(source, packEnd, prefix);
            if afterPack >= size or source.at(afterPack) =!= ":" { return false; }
            packType := canResolveTypeAt(source, afterPack + 1, prefix, aliases, genericType, emptySeen, 32);
            if not packType.ok { return false; }
            cursor = syntax.skipTrivia(source, packType.next, prefix);
            break;
        }
        if not source.at(cursor).isNameStart() { return false; }
        nameStart := cursor;
        nameEnd := source.skipName(nameStart);
        pName := source.slice(nameStart, nameEnd);
        if syntax.isReservedWord(pName) or names.contains(pName) { return false; }
        (mut names).pushBack(pName);
        afterPName := syntax.skipTrivia(source, nameEnd, prefix);
        if afterPName < size and syntax.isSingleEquals(source, afterPName) {
            if listIntrinsic { return false; }
            defStart := syntax.skipTrivia(source, afterPName + 1, prefix);
            defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
            if defEnd <= defStart { return false; }
            paramCount = paramCount + 1;
            cursor = syntax.skipTrivia(source, defEnd, prefix);
        } else {
            if afterPName >= size or source.at(afterPName) =!= ":" { return false; }
            cursor = syntax.skipTrivia(source, afterPName + 1, prefix);
            var isMutP := false;
            if source.wordAt(cursor, "mut") {
                isMutP = true;
                cursor = syntax.skipTrivia(source, cursor + 3, prefix);
            }
            pType := canResolveTypeAt(source, cursor, prefix, aliases, genericType, emptySeen, 32);
            if not pType.ok { return false; }
            if isMutP and not listIntrinsic and not isGenericParamName(genericType, pType.kind) and not isMutContainerKind(pType.kind) {
                return false;
            }
            paramCount = paramCount + 1;
            cursor = syntax.skipTrivia(source, pType.next, prefix);
            if cursor < size and syntax.isSingleEquals(source, cursor) {
                if isMutP or listIntrinsic { return false; }
                defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                defEnd := syntax.skipBalancedArgument(source, defStart, prefix);
                if defEnd <= defStart { return false; }
                cursor = syntax.skipTrivia(source, defEnd, prefix);
            }
        }
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ")" { break; }
        } else {
            break;
        }
    }
    if cursor >= size or source.at(cursor) =!= ")" { return false; }
    var afterParen := syntax.skipTrivia(source, cursor + 1, prefix);
    if afterParen < size and source.wordAt(afterParen, "context") {
        var cCur := syntax.skipTrivia(source, afterParen + 7, prefix);
        if cCur >= size or source.at(cCur) =!= "(" { return false; }
        cCur = syntax.skipTrivia(source, cCur + 1, prefix);
        if cCur < size and source.at(cCur) == ")" { return false; }
        mut cNames: List<String> = [];
        loop cCur < size and source.at(cCur) =!= ")" {
            if source.wordAt(cCur, "mut") {
                return false;
            }
            if cCur >= size or not source.at(cCur).isNameStart() { return false; }
            cnEnd := source.skipName(cCur);
            cn := source.slice(cCur, cnEnd);
            if syntax.isReservedWord(cn) or cNames.contains(cn) { return false; }
            mut cNames.pushBack(cn);
            cCur = syntax.skipTrivia(source, cnEnd, prefix);
            if cCur >= size or source.at(cCur) =!= ":" { return false; }
            cCur = syntax.skipTrivia(source, cCur + 1, prefix);
            if source.wordAt(cCur, "mut") {
                cCur = syntax.skipTrivia(source, cCur + 3, prefix);
            }
            cType := canResolveTypeAt(source, cCur, prefix, aliases, genericType, emptySeen, 32);
            if not cType.ok or cType.kind == ir.VALUE_KIND_UNIT { return false; }
            cCur = syntax.skipTrivia(source, cType.next, prefix);
            if cCur < size and source.at(cCur) == "," {
                cCur = syntax.skipTrivia(source, cCur + 1, prefix);
                if cCur < size and source.at(cCur) == ")" { return false; }
            } else {
                break;
            }
        }
        if cCur >= size or source.at(cCur) =!= ")" { return false; }
        afterParen = syntax.skipTrivia(source, cCur + 1, prefix);
    }
    if afterParen >= size or source.at(afterParen) =!= ":" { return false; }
    retType := canResolveTypeAt(source, afterParen + 1, prefix, aliases, genericType, emptySeen, 32);
    if not retType.ok { return false; }
    afterHeader := syntax.skipTrivia(source, retType.next, prefix);
    if afterHeader < size and source.at(afterHeader) == "@" { return false; }
    true
};

/** Extracts the loop context id encoded in a Pass 1 `"__loopVal:<id>"` placeholder kind, or returns -1. */
pub loopValMarkerId := fn(kind: String): Int {
    if not kind.startsWithAt(0, "__loopVal:") { return -1; }
    suffix := kind.slice(10, kind.length());
    if suffix == "" { return -1; }
    var value := 0;
    var index := 0;
    loop index < suffix.length() {
        ch := suffix.at(index);
        if not ch.isDigit() { return -1; }
        value = value * 10 + syntax.decimalDigit(ch);
        index = index + 1;
    }
    value
};

/** Unifies two conditional branch kinds when one is `Never`, both match, one is a Pass 1 loop `.value` placeholder, or one losslessly widens to the other. */
pub joinBranchKind := fn(current: String, nextKind: String): String {
    if current == "" or current == ir.VALUE_KIND_NEVER { return nextKind; }
    if nextKind == ir.VALUE_KIND_NEVER or nextKind == current { return current; }
    if loopValMarkerId(current) >= 0 { return nextKind; }
    if loopValMarkerId(nextKind) >= 0 { return current; }
    if numeric.numericWidens(current, nextKind) { return current; }
    if numeric.numericWidens(nextKind, current) { return nextKind; }
    if fnShapeMatches(current, nextKind) { return fnStripLabels(current); }
    ""
};

/** Joins two branch kinds allowing incompatible branches to widen into an expected `Union` or `Result`. */
pub joinBranchKindWithExpected := fn(expected: String, current: String, nextKind: String): String {
    direct := joinBranchKind(current, nextKind);
    if direct =!= "" { return direct; }
    normExp := if expected.startsWithAt(0, "Tail") { expected.slice(4, expected.length()) } else { expected };
    if normExp =!= "" and (isUnionKind(normExp) or isResultKind(normExp)) {
        if isCompatibleKind(normExp, current) and isCompatibleKind(normExp, nextKind) {
            return normExp;
        }
    }
    ""
};
