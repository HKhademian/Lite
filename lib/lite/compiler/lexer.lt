/* Lite-written lexer for the bootstrap source subset. */

sourceLib := import "core/source";
diag := import "core/diag";
numeric := import "./numeric-literals";
io := import "core/io";
tb := import "core/text-builder";

/** Lexical token classification. */
pub TokenKind := enum {
    Name;
    Keyword;
    Int;
    Float;
    String;
    Bool;
    Symbol;
    EOF;
};

/** Canonical display spelling for `k` used in deterministic token dumps. */
pub TokenKind.name := fn(k: Self): String {
    match k {
        .Name { "Name" }
        .Keyword { "Keyword" }
        .Int { "Int" }
        .Float { "Float" }
        .String { "String" }
        .Bool { "Bool" }
        .Symbol { "Symbol" }
        .EOF { "EOF" }
    }
};

/** One lexical token: kind, decoded text, source offset and 1-based line/column. */
pub Token := record {
    kind: TokenKind;
    text: String;
    offset: Int;
    line: Int;
    column: Int;
};

/** Tokens in source order, ending with one EOF token. */
pub Tokens := alias List<Token>;

/** Reports one source-positioned lexer diagnostic and exits 2. */
lexFail := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := sourceLib.lineColumn(source, position);
    diag.fail(prefix, place.line.toText() + ":" + place.column.toText() + ": " + message);
}

/** True for Lite lexical whitespace. */
isLexWhitespace := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
}

/** Advances line/lineStart over `start..end`, counting newlines. */
advanceLines := fn(source: String, start: Int, end: Int, line: Int, lineStart: Int): (line: Int, lineStart: Int) {
    var currentLine := line;
    var currentStart := lineStart;
    var index := start;
    loop index < end {
        if source.at(index) == "\n" {
            currentLine = currentLine + 1;
            currentStart = index + 1;
        }
        index = index + 1;
    }
    (line = currentLine, lineStart = currentStart)
}

/** Returns the number of `#` characters in a raw comment opener at `position`, or 0 for ordinary. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not source.startsWithAt(position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < source.length() and source.at(index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := source.length();
    var cursor := position + 2 + fence;
    loop cursor < size {
        if source.at(cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and source.at(runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and source.startsWithAt(runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    lexFail(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    size := source.length();
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop true {
        if cursor >= size {
            lexFail(source, position, prefix, "unterminated comment");
        }
        if source.startsWithAt(cursor, "/*") {
            innerFence := rawFenceLength(source, cursor);
            if innerFence > 0 {
                cursor = skipRawComment(source, cursor, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = cursor + 2;
            }
        } else if source.startsWithAt(cursor, "*/") {
            depth = depth - 1;
            cursor = cursor + 2;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Skips whitespace and comments, returning the next position and updated line state. */
skipTrivia := fn(source: String, position: Int, line: Int, lineStart: Int, prefix: String): (position: Int, line: Int, lineStart: Int) {
    size := source.length();
    var cursor := position;
    var currentLine := line;
    var currentStart := lineStart;
    loop cursor < size {
        ch := source.at(cursor);
        if isLexWhitespace(ch) {
            if ch == "\n" {
                currentLine = currentLine + 1;
                currentStart = cursor + 1;
            }
            cursor = cursor + 1;
        } else if source.startsWithAt(cursor, "/*") {
            end := skipComment(source, cursor, prefix);
            advanced := advanceLines(source, cursor, end, currentLine, currentStart);
            cursor = end;
            currentLine = advanced.line;
            currentStart = advanced.lineStart;
        } else {
            break;
        }
    }
    (position = cursor, line = currentLine, lineStart = currentStart)
}

/** True for a Lite keyword other than the Bool literals. */
isKeyword := fn(name: String): Bool {
    name == "pub" or name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or name == "do" or
    name == "import" or name == "using" or name == "record" or name == "enum" or name == "type" or
    name == "alias" or name == "distinct" or
    name == "and" or name == "or" or name == "not"
}

/** True for one selected single-character symbol. */
isSingleSymbol := fn(ch: String): Bool {
    ch == "(" or ch == ")" or ch == "{" or ch == "}" or ch == "[" or ch == "]" or
    ch == "," or ch == ";" or ch == ":" or ch == "." or ch == "?" or ch == "!" or
    ch == "=" or ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" or
    ch == "<" or ch == ">" or ch == "|" or ch == "&" or ch == "@" or ch == "#"
}

/** Reads the longest selected symbol at `position`, or empty text when none starts there. */
readSymbol := fn(source: String, position: Int): String {
    if source.startsWithAt(position, "=!=") { "=!=" }
    else if source.startsWithAt(position, "<!=") { "<!=" }
    else if source.startsWithAt(position, ">!=") { ">!=" }
    else if source.startsWithAt(position, ":/=") { ":/=" }
    else if source.startsWithAt(position, ":%=") { ":%=" }
    else if source.startsWithAt(position, "**=") { "**=" }
    else if source.startsWithAt(position, ":=") { ":=" }
    else if source.startsWithAt(position, "==") { "==" }
    else if source.startsWithAt(position, "<=") { "<=" }
    else if source.startsWithAt(position, ">=") { ">=" }
    else if source.startsWithAt(position, "<!") { "<!" }
    else if source.startsWithAt(position, ">!") { ">!" }
    else if source.startsWithAt(position, ":/") { ":/" }
    else if source.startsWithAt(position, ":%") { ":%" }
    else if source.startsWithAt(position, "+=") { "+=" }
    else if source.startsWithAt(position, "-=") { "-=" }
    else if source.startsWithAt(position, "*=") { "*=" }
    else if source.startsWithAt(position, "/=") { "/=" }
    else if source.startsWithAt(position, "%=") { "%=" }
    else if source.startsWithAt(position, "**") { "**" }
    else {
        ch := source.at(position);
        if isSingleSymbol(ch) { ch } else { "" }
    }
}

/** Scans one double-quoted String token, decoding n/t/r/quote/backslash escapes. */
scanString := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := source.length();
    var cursor := position + 1;
    var runStart := cursor;
    mut out: tb.TextBuilder;
    loop true {
        if cursor >= size {
            lexFail(source, position, prefix, "unterminated string literal");
        }
        ch := source.at(cursor);
        if ch == "\"" {
            if cursor > runStart { mut out.append(source.slice(runStart, cursor)); }
            return (text = out.build(), next = cursor + 1);
        }
        if ch == "\\" {
            if cursor > runStart { mut out.append(source.slice(runStart, cursor)); }
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= size {
                lexFail(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := source.at(cursor);
            if escaped == "n" { mut out.append("\n"); }
            else if escaped == "t" { mut out.append("\t"); }
            else if escaped == "r" { mut out.append("\r"); }
            else if escaped == "\"" { mut out.append("\""); }
            else if escaped == "\\" { mut out.append("\\"); }
            else {
                lexFail(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
            runStart = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    (text = out.build(), next = size)
}

/** Escapes one token's text for a one-line deterministic dump. */
pub escapedTokenText := fn(text: String): String {
    size := text.length();
    mut out: tb.TextBuilder;
    var runStart := 0;
    var index := 0;
    loop index < size {
        ch := text.at(index);
        var esc := "";
        if ch == "\\" { esc = "\\\\"; }
        else if ch == "\n" { esc = "\\n"; }
        else if ch == "\r" { esc = "\\r"; }
        else if ch == "\t" { esc = "\\t"; }
        if esc =!= "" {
            if index > runStart { mut out.append(text.slice(runStart, index)); }
            mut out.append(esc);
            runStart = index + 1;
        }
        index = index + 1;
    }
    if runStart == 0 { return text; }
    if runStart < size { mut out.append(text.slice(runStart, size)); }
    out.build()
}

/** Formats one token as `kind@line:column:offset text`. */
dumpToken := fn(token: Token): String {
    token.kind.name() + "@" + token.line.toText() + ":" + token.column.toText() + ":" +
    token.offset.toText() + " " + escapedTokenText(token.text)
}

/** Reports every token in order, one per line. */
pub dumpTokens := fn(tokens: Tokens): Unit {
    loop tokens as token {
        io.outputLine(dumpToken(token));
    }
}

/** Tokenizes one complete source, ending with an EOF token and exiting 2 on lexical failure. */
pub tokenize := fn(source: String, prefix: String): Tokens {
    size := source.length();
    mut tokens: List<Token> = [];
    var cursor := 0;
    var line := 1;
    var lineStart := 0;
    loop true {
        trivia := skipTrivia(source, cursor, line, lineStart, prefix);
        cursor = trivia.position;
        line = trivia.line;
        lineStart = trivia.lineStart;
        if cursor >= size {
            mut tokens.pushBack(Token { kind = TokenKind.EOF, text = "", offset = cursor, line = line, column = cursor - lineStart + 1 });
            break;
        }
        start := cursor;
        startLine := line;
        startColumn := cursor - lineStart + 1;
        ch := source.at(cursor);
        var kind := TokenKind.Symbol;
        var value := "";
        var next := cursor;
        if ch.isNameStart() {
            next = source.skipName(cursor);
            value = source.slice(cursor, next);
            if value == "true" or value == "false" { kind = TokenKind.Bool; }
            else if isKeyword(value) { kind = TokenKind.Keyword; }
            else { kind = TokenKind.Name; }
        } else if ch.isDigit() {
            scanned := numeric.scanNumericLiteral(source, cursor);
            next = scanned.next;
            value = source.slice(cursor, next);
            if scanned.exponentMissingAt >= 0 { lexFail(source, scanned.exponentMissingAt, prefix, "expected exponent digits"); }
            if scanned.floating {
                digits := source.slice(cursor, scanned.integerEnd) + source.slice(scanned.fractionStart, scanned.fractionEnd);
                if not numeric.finiteFloatDigits(digits, scanned.fractionEnd - scanned.fractionStart, scanned.exponent) {
                    lexFail(source, cursor, prefix, "floating literal is not finite");
                }
                kind = TokenKind.Float;
            } else {
                if scanned.outsideInt { lexFail(source, cursor, prefix, "integer literal outside signed 64-bit range"); }
                kind = TokenKind.Int;
            }
        } else if ch == "\"" {
            scanned := scanString(source, cursor, prefix);
            kind = TokenKind.String;
            value = scanned.text;
            next = scanned.next;
        } else {
            symbol := readSymbol(source, cursor);
            if symbol == "" {
                lexFail(source, cursor, prefix, "unsupported symbol: " + ch);
            }
            if source.startsWithAt(cursor, "=!") and not source.startsWithAt(cursor, "=!=") {
                lexFail(source, cursor, prefix, "incomplete operator =!; use =!=");
            }
            if source.startsWithAt(cursor, "&&") {
                lexFail(source, cursor, prefix, "unsupported operator &&; use and");
            }
            if source.startsWithAt(cursor, "||") {
                lexFail(source, cursor, prefix, "unsupported operator ||; use or");
            }
            kind = TokenKind.Symbol;
            value = symbol;
            next = cursor + symbol.length();
        }
        (mut tokens).pushBack(Token { kind = kind, text = value, offset = start, line = startLine, column = startColumn });
        advanced := advanceLines(source, start, next, line, lineStart);
        line = advanced.line;
        lineStart = advanced.lineStart;
        cursor = next;
    }
    tokens
}
