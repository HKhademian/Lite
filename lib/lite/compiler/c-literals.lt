/* C backend for the temporary Lite compiler. */

numeric := import "./numeric-literals";
tb := import "core/text-builder";

/** Formats a checked Int value as a C signed 64-bit literal (`INT64_C`, `INT64_MIN`). */
pub intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == -9223372036854775808 { "INT64_MIN" }
    else if value == 0 { "INT64_C(0)" }
    else if negative { "(-INT64_C(" + digits + "))" }
    else { "INT64_C(" + digits + ")" }
}

/** Escapes a String as a readable C literal, including trigraph-safe `?`. */
pub textLiteralCode := fn(value: String): String {
    size := value.length();
    mut out: tb.TextBuilder;
    mut out.append("\"");
    var runStart := 0;
    var position := 0;
    loop position < size {
        ch := value.at(position);
        var esc := "";
        if ch == "\\" { esc = "\\\\"; }
        else if ch == "\"" { esc = "\\\""; }
        else if ch == "?" { esc = "\\?"; }
        else if ch == "\n" { esc = "\\n"; }
        else if ch == "\r" { esc = "\\r"; }
        else if ch == "\t" { esc = "\\t"; }
        if esc =!= "" {
            if position > runStart { mut out.append(value.slice(runStart, position)); }
            mut out.append(esc);
            runStart = position + 1;
        }
        position += 1;
    }
    if runStart == 0 { return "\"" + value + "\""; }
    if runStart < size { mut out.append(value.slice(runStart, size)); }
    mut out.append("\"");
    out.build()
}

/** Formats a Lite String literal as a 16B SSO `lt_str` value (`<= 14` UTF-8 bytes) or static RODATA `LT_STR_LIT`. */
pub strLiteralCode := fn(value: String): String {
    if value.length() <= 14 {
        utf8Len := value.utf8Encode().length();
        if utf8Len <= 14 {
            return "LT_STR_SSO(" + textLiteralCode(value) + ", " + utf8Len.toText() + ")";
        }
    }
    "LT_STR_LIT(" + textLiteralCode(value) + ", " + value.length().toText() + ")"
}

/** Formats a checked unsigned Int value as a C unsigned 64-bit literal (`UINT64_C`). */
pub uintLiteralCode := fn(digits: String): String {
    if digits == "0" or digits == "" { "UINT64_C(0)" } else { "UINT64_C(" + digits + ")" }
}

/** Encodes a finite decimal Float token through the target's correctly rounded binary64 parser, preserving signed zero and gradual underflow. */
pub floatLiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "lt_float_literal(" + textLiteralCode(digits) + ")";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Encodes a finite decimal Float8 token parsed and encoded into OCP E4M3 uint8_t storage. */
pub float8LiteralCode := fn(digits: String, negative: Bool): String {
    "lt_float8_literal(" + textLiteralCode((if negative { "-" } else { "" }) + digits) + ")"
}

/** Encodes a finite decimal Float16 token parsed as IEEE binary16 `lt_f16`. */
pub float16LiteralCode := fn(digits: String, negative: Bool): String {
    "lt_float16_literal(" + textLiteralCode((if negative { "-" } else { "" }) + digits) + ")"
}

/** Encodes a finite decimal Float32 token parsed as binary32 float. */
pub float32LiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "lt_float32_literal(" + textLiteralCode(digits) + ")";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Evaluates a Unit expression's effects while suppressing any target builtin return payload. */
pub unitEvaluationCode := fn(code: String): String { "((void)(" + code + "), 0)" }

/** Inert Unit value for C expression evaluation. */
pub unitLiteralCode := "0";

/** Formats a checked Bool value as a C `stdbool.h` literal. */
pub boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Marks a list value copy for C reachability validation; reachable list values are rejected by `emitProgram`. */
pub listCopyCode := fn(code: String): String {
    "lt_list_copy(" + code + ")"
}

/** Emits a checked UTF-8 byte concatenation call; the bootstrap C backend intentionally leaks each result. */
pub concatCode := fn(left: String, right: String): String {
    "lite_concat(" + left + ", " + right + ")"
}

/** Emits a C logical negation around one Bool expression. */
pub notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a C short-circuit `and`/`or` expression around two Bool expressions. */
pub logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware C comparison; String equality uses `lt_text_eq` and not-less/not-more spellings invert the ordering. */
pub comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    if kind == numeric.KIND_STRING {
        if op == "==" { "lt_text_eq(" + left + ", " + right + ")" }
        else { "!lt_text_eq(" + left + ", " + right + ")" }
    } else {
        operator := if op == "==" { "==" }
        else if op == "=!=" { "!=" }
        else if op == "<" { "<" }
        else if op == "<!" { ">=" }
        else if op == "<=" { "<=" }
        else if op == "<!=" { ">" }
        else if op == ">" { ">" }
        else if op == ">!" { "<=" }
        else if op == ">=" { ">=" }
        else { "<" };
        "(" + left + ") " + operator + " (" + right + ")"
    }
}

/** Converts any numeric operand to `double` (`Float8`/`Float16` decode cleanly). */
pub floatOperandCode := fn(kind: String, code: String): String {
    if kind == numeric.KIND_FLOAT8 { "lt_f8_to_f64(" + code + ")" }
    else if kind == numeric.KIND_FLOAT16 { "lt_f16_to_f64(" + code + ")" }
    else if numeric.isIntKind(kind) or kind == numeric.KIND_FLOAT32 { "((double)(" + code + "))" }
    else { code }
}

/** Converts any numeric operand into OCP E4M3 `uint8_t` (`Float8`) representation. */
pub float8OperandCode := fn(kind: String, code: String): String {
    if kind == numeric.KIND_FLOAT8 { code }
    else { "((uint8_t)lt_f64_to_f8(" + floatOperandCode(kind, code) + ", 0))" }
}

/** Converts any numeric operand into IEEE binary16 `lt_f16` representation. */
pub float16OperandCode := fn(kind: String, code: String): String {
    if kind == numeric.KIND_FLOAT16 { code }
    else { "lt_f64_to_f16_unchecked(" + floatOperandCode(kind, code) + ")" }
}

/** Converts an Int* or Float operand into a binary32 value (`float`) when targeting Float32. */
pub float32OperandCode := fn(kind: String, code: String): String {
    if kind == numeric.KIND_FLOAT32 { code }
    else if kind == numeric.KIND_FLOAT8 or kind == numeric.KIND_FLOAT16 { "((float)" + floatOperandCode(kind, code) + ")" }
    else if numeric.isIntKind(kind) or kind == numeric.KIND_FLOAT { "((float)(" + code + "))" }
    else { code }
}

/** Emits one numeric comparison using the pair's common family. */
comparisonPairCode := fn(op: String, leftKind: String, rightKind: String, left: String, right: String): String {
    if numeric.isFloatKind(leftKind) or numeric.isFloatKind(rightKind) {
        comparisonCode(op, numeric.KIND_FLOAT, floatOperandCode(leftKind, left), floatOperandCode(rightKind, right))
    } else if numeric.isUnsignedIntKind(leftKind) or numeric.isUnsignedIntKind(rightKind) {
        comparisonCode(op, numeric.KIND_UINT64, "((uint64_t)(" + left + "))", "((uint64_t)(" + right + "))")
    } else {
        comparisonCode(op, leftKind, left, right)
    }
}

/** Encodes the arithmetic operator tag expected by runtime float helpers. */
floatOpTag := fn(op: String): String {
    if op == "+" { "0" } else if op == "-" { "1" } else if op == "*" { "2" } else { "3" }
}

/** Sequences operands into binary64 temporaries before the checked operation. */
floatBinaryCall := fn(helper: String, op: String, left: String, right: String, position: Int): String {
    id := position.toText();
    "(lt_arg_f_left_" + id + " = " + left + ", lt_arg_f_right_" + id + " = " + right + ", " + helper + "(lt_arg_f_left_" + id + ", lt_arg_f_right_" + id + ", " + floatOpTag(op) + ", " + id + "))"
}

/** Sequences operands into binary64 temporaries before the checked binary64 operation. */
pub floatBinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float_op", op, left, right, position)
}

/** Sequences operands into binary64 temporaries before the checked Float8 E4M3 operation. */
pub float8BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float8_op", op, floatOperandCode(numeric.KIND_FLOAT8, left), floatOperandCode(numeric.KIND_FLOAT8, right), position)
}

/** Sequences operands into binary64 temporaries before the checked Float16 operation. */
pub float16BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float16_op", op, floatOperandCode(numeric.KIND_FLOAT16, left), floatOperandCode(numeric.KIND_FLOAT16, right), position)
}

/** Sequences operands into temporaries before the checked binary32 operation. */
pub float32BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float32_op", op, floatOperandCode(numeric.KIND_FLOAT32, left), floatOperandCode(numeric.KIND_FLOAT32, right), position)
}

/** Sequences both operands before the selected Float-default power checkpoint. */
pub floatPowerCode := fn(left: String, right: String, position: Int): String {
    id := position.toText();
    "(lt_arg_f_left_" + id + " = " + left + ", lt_arg_f_right_" + id + " = " + right + ", lt_float_power(lt_arg_f_left_" + id + ", lt_arg_f_right_" + id + ", " + id + "))"
}

/** Emits an int64_t floor-division expression. */
pub floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? 1 : 0))"
}

/** Emits an int64_t floor-modulo expression. */
pub floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? " + right + " : 0))"
}

/** Emits a positioned Int helper call with operands evaluated once, from left to right. */
intBinaryCallCode := fn(name: String, left: String, right: String, position: Int): String {
    id := position.toText();
    "(lt_arg_left_" + id + " = " + left + ", lt_arg_right_" + id + " = " + right + ", " + name + "(lt_arg_left_" + id + ", lt_arg_right_" + id + ", " + id + "))"
}

/** Emits a checked int64_t truncating division call. */
pub intDivideCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_divide_int", left, right, position)
}

/** Emits a checked int64_t remainder call. */
pub intRemainderCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_remainder_int", left, right, position)
}

/** Emits a checked int64_t floor-division call. */
pub intFloorDivideCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_floor_divide_int", left, right, position)
}

/** Emits a checked int64_t floor-modulo call. */
pub intFloorModuloCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_floor_modulo_int", left, right, position)
}

/** Emits checked Int64 addition, evaluating both operands once in source order. */
pub intAddCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_add", left, right, position)
}

/** Emits checked Int64 subtraction, evaluating both operands once in source order. */
pub intSubtractCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_subtract", left, right, position)
}

/** Emits checked Int64 multiplication, evaluating both operands once in source order. */
pub intMultiplyCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_multiply", left, right, position)
}

/** Emits checked Int64 negation, evaluating the operand once. */
pub intNegateCode := fn(value: String, position: Int): String {
    "lt_checked_negate(" + value + ", " + position.toText() + ")"
}

/** Emits a positioned unsigned Int helper call with operands evaluated once, from left to right. */
uintBinaryCallCode := fn(name: String, left: String, right: String, position: Int): String {
    id := position.toText();
    "(lt_arg_u_left_" + id + " = (uint64_t)(" + left + "), lt_arg_u_right_" + id + " = (uint64_t)(" + right + "), " + name + "(lt_arg_u_left_" + id + ", lt_arg_u_right_" + id + ", " + id + "))"
}

/** Emits a checked uint64_t binary operation (`+`, `-`, `*`, `/`, `%`, `:/`, `:%`). */
pub uintBinaryCode := fn(operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { uintBinaryCallCode("lt_checked_uadd", left, right, position) }
    else if operator == "-" { uintBinaryCallCode("lt_checked_usub", left, right, position) }
    else if operator == "*" { uintBinaryCallCode("lt_checked_umul", left, right, position) }
    else if operator == "/" or operator == ":/" { uintBinaryCallCode("lt_checked_udiv", left, right, position) }
    else { uintBinaryCallCode("lt_checked_urem", left, right, position) }
}

/** Emits a checked signed range check for narrow integer arithmetic results. */
pub checkedNarrowIntCode := fn(kind: String, value: String, position: Int): String {
    bits: Int = numeric.narrowIntBits(kind);
    "lt_checked_narrow_int(" + value + ", " + bits.toText() + ", " + textLiteralCode(kind) + ", " + position.toText() + ")"
}

/** Emits a checked unsigned range check for narrow unsigned integer arithmetic results. */
pub checkedNarrowUIntCode := fn(kind: String, value: String, position: Int): String {
    bits: Int = numeric.narrowIntBits(kind);
    "lt_checked_narrow_uint(" + value + ", " + bits.toText() + ", " + textLiteralCode(kind) + ", " + position.toText() + ")"
}

/** Names a typed, source-position-hygienic C comparison operand temporary. */
comparisonTemp := fn(kind: String, position: Int, index: Int): String {
    tag := if kind == numeric.KIND_STRING { "s" }
    else if kind == numeric.KIND_BOOL { "b" }
    else if numeric.isFloatKind(kind) { "f" }
    else if numeric.isUnsignedIntKind(kind) { "u" }
    else { "i" };
    "lt_cmp_" + tag + "_" + position.toText() + "_" + index.toText()
}

/** Represents Unit as zero, retaining unsupported/effectful code for C validation instead of dropping it. */
comparisonValueCode := fn(kind: String, code: String): String {
    if kind =!= numeric.KIND_UNIT { return code; }
    var inner := code;
    loop inner.length() >= 2 and inner.at(0) == "(" and inner.at(inner.length() - 1) == ")" {
        inner = inner.slice(1, inner.length() - 1);
    }
    if inner == "undefined" { "0" } else { "(" + code + ", 0)" }
}

/** Emits portable comma/short-circuit sequencing so middle operands are evaluated once and later operands stay lazy. */
pub comparisonChainCode := fn(codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String {
    first := comparisonTemp(kinds[0], position, 0);
    second := comparisonTemp(kinds[1], position, 1);
    var result := "(" + first + " = " + comparisonValueCode(kinds[0], codes[0]) + ", " + second + " = " + comparisonValueCode(kinds[1], codes[1]) + ", " + comparisonPairCode(operators[0], kinds[0], kinds[1], first, second);
    var index := 2;
    loop index <= count {
        name := comparisonTemp(kinds[index], position, index);
        pair := comparisonPairCode(operators[index - 1], kinds[index - 1], kinds[index], comparisonTemp(kinds[index - 1], position, index - 1), name);
        result += " && (" + name + " = " + comparisonValueCode(kinds[index], codes[index]) + ", " + pair + ")";
        index += 1;
    }
    result + ")"
}


/** Returns the exact integer bit width for any signed or unsigned integer kind. */
castIntBits := fn(kind: String): Int {
    if kind == numeric.KIND_INT or kind == numeric.KIND_UINT64 { 64 }
    else { numeric.narrowIntBits(kind) }
}

/** Wraps an integer expression in the exact C scalar type for `kind`. */
cIntCastWrap := fn(kind: String, expr: String): String {
    if kind == numeric.KIND_INT1 or kind == numeric.KIND_INT2 or kind == numeric.KIND_INT4 or kind == numeric.KIND_INT8 { "((int8_t)(" + expr + "))" }
    else if kind == numeric.KIND_INT16 { "((int16_t)(" + expr + "))" }
    else if kind == numeric.KIND_INT32 { "((int32_t)(" + expr + "))" }
    else if kind == numeric.KIND_UINT1 or kind == numeric.KIND_UINT2 or kind == numeric.KIND_UINT4 or kind == numeric.KIND_UINT8 { "((uint8_t)(" + expr + "))" }
    else if kind == numeric.KIND_UINT16 { "((uint16_t)(" + expr + "))" }
    else if kind == numeric.KIND_UINT32 { "((uint32_t)(" + expr + "))" }
    else if numeric.isUnsignedIntKind(kind) { "((uint64_t)(" + expr + "))" }
    else { "((int64_t)(" + expr + "))" }
}

/** Emits a checked C numeric conversion `cast<Dst>(src)` for integers or floats. */
pub numericCastCode := fn(dstKind: String, srcKind: String, code: String, position: Int): String {
    if dstKind == srcKind { return code; }
    posText := position.toText();
    if numeric.isIntKind(dstKind) and numeric.isIntKind(srcKind) {
        dstUnsigned := numeric.isUnsignedIntKind(dstKind);
        srcUnsigned := numeric.isUnsignedIntKind(srcKind);
        dstBits := castIntBits(dstKind);
        if srcUnsigned and not dstUnsigned {
            return cIntCastWrap(dstKind, "lt_cast_u2i((uint64_t)(" + code + "), " + dstBits.toText() + ", " + textLiteralCode(dstKind) + ", " + posText + ")");
        }
        if not srcUnsigned and dstUnsigned {
            return cIntCastWrap(dstKind, "lt_cast_i2u((int64_t)(" + code + "), " + dstBits.toText() + ", " + textLiteralCode(dstKind) + ", " + posText + ")");
        }
        if numeric.numericWidens(dstKind, srcKind) {
            return cIntCastWrap(dstKind, code);
        }
        if dstUnsigned {
            return cIntCastWrap(dstKind, checkedNarrowUIntCode(dstKind, "((uint64_t)(" + code + "))", position));
        }
        return cIntCastWrap(dstKind, checkedNarrowIntCode(dstKind, "((int64_t)(" + code + "))", position));
    }
    asDouble := floatOperandCode(srcKind, code);
    if dstKind == numeric.KIND_FLOAT8 { return "((uint8_t)lt_f64_to_f8(" + asDouble + ", " + posText + "))"; }
    if dstKind == numeric.KIND_FLOAT16 { return "lt_f64_to_f16_checked(" + asDouble + ", " + posText + ")"; }
    if dstKind == numeric.KIND_FLOAT32 { return "lt_f64_to_f32_checked(" + asDouble + ", " + posText + ")"; }
    asDouble
}

/** Emits a checked C float-to-integer truncation `<IntType>.trunc(floatExpr)`. */
pub floatTruncCode := fn(dstIntKind: String, srcFloatKind: String, code: String, position: Int): String {
    asDouble := floatOperandCode(srcFloatKind, code);
    bitsText := castIntBits(dstIntKind).toText();
    posText := position.toText();
    if numeric.isUnsignedIntKind(dstIntKind) {
        cIntCastWrap(dstIntKind, "lt_trunc_f64_to_uint(" + asDouble + ", " + bitsText + ", " + textLiteralCode(dstIntKind) + ", " + posText + ")")
    } else {
        cIntCastWrap(dstIntKind, "lt_trunc_f64_to_int(" + asDouble + ", " + bitsText + ", " + textLiteralCode(dstIntKind) + ", " + posText + ")")
    }
}

/** Returns the unsigned C scalar type with the same storage width as integer `kind` (`uint8_t`/`uint16_t`/`uint32_t`/`uint64_t`). */
cUIntTypeForInt := fn(kind: String): String {
    bits := castIntBits(kind);
    if bits <= 8 { "uint8_t" } else if bits == 16 { "uint16_t" } else if bits == 32 { "uint32_t" } else { "uint64_t" }
}

/** Returns the exact signed/unsigned C scalar type for integer `kind`. */
cExactIntType := fn(kind: String): String {
    isU := numeric.isUnsignedIntKind(kind);
    bits := castIntBits(kind);
    if bits <= 8 { if isU { "uint8_t" } else { "int8_t" } }
    else if bits == 16 { if isU { "uint16_t" } else { "int16_t" } }
    else if bits == 32 { if isU { "uint32_t" } else { "int32_t" } }
    else { if isU { "uint64_t" } else { "int64_t" } }
}

/** Masks an unsigned expression to `bits` (`1`, `2`, `4`) when sub-byte, or returns it unchanged. */
cMaskSubByte := fn(kind: String, expr: String): String {
    bits := castIntBits(kind);
    if bits == 1 { "((" + expr + ") & UINT8_C(1))" }
    else if bits == 2 { "((" + expr + ") & UINT8_C(3))" }
    else if bits == 4 { "((" + expr + ") & UINT8_C(15))" }
    else { expr }
}

/** Returns the short C scalar tag for integer `kind` (`i1`..`i64`, `u1`..`u64`). */
cIntTag := fn(kind: String): String {
    prefix := if numeric.isUnsignedIntKind(kind) { "u" } else { "i" };
    prefix + castIntBits(kind).toText()
}

/** Emits C11 code for a hard-builtin integer or float method (`bit*`, `shift*`, `rotate*`, `wrapping*`, `saturating*`, `unchecked*`, bit manip, `wideningMul`, `fma`, `toBits`, `fromBits`). */
pub numericBuiltinCode := fn(kind: String, opName: String, a0: String, a1: String, a2: String, srcKind: String, position: Int, tupleStructTag: String): String {
    posText := position.toText();
    if numeric.isFloatKind(kind) {
        fTag := if kind == numeric.KIND_FLOAT8 { "f8" } else if kind == numeric.KIND_FLOAT16 { "f16" } else if kind == numeric.KIND_FLOAT32 { "f32" } else { "f64" };
        if opName == "uncheckedAdd" { return "lt_ufadd_" + fTag + "(" + a0 + ", " + a1 + ", " + posText + ")"; }
        if opName == "uncheckedSub" { return "lt_ufsub_" + fTag + "(" + a0 + ", " + a1 + ", " + posText + ")"; }
        if opName == "uncheckedMul" { return "lt_ufmul_" + fTag + "(" + a0 + ", " + a1 + ", " + posText + ")"; }
        if opName == "uncheckedDiv" { return "lt_ufdiv_" + fTag + "(" + a0 + ", " + a1 + ", " + posText + ")"; }
        if opName == "fma" {
            return "lt_fma_" + fTag + "(" + a0 + ", " + a1 + ", " + a2 + ", " + posText + ")";
        }
        if opName == "uncheckedFma" {
            return "lt_ufma_" + fTag + "(" + a0 + ", " + a1 + ", " + a2 + ", " + posText + ")";
        }
        if opName == "toBits" {
            return "lt_" + fTag + "_to_bits(" + a0 + ")";
        }
        if opName == "fromBits" {
            return "lt_" + fTag + "_from_bits(" + a0 + ", " + posText + ")";
        }
        if opName == "uncheckedFromBits" {
            return "lt_" + fTag + "_ufrom_bits(" + a0 + ", " + posText + ")";
        }
    }
    bits := castIntBits(kind);
    bitsText := bits.toText();
    isU := numeric.isUnsignedIntKind(kind);
    cT := cExactIntType(kind);
    uT := cUIntTypeForInt(kind);
    isSub := numeric.isSubByteIntKind(kind);
    if opName == "bitAnd" or opName == "bitOr" or opName == "bitXor" {
        bSym := if opName == "bitAnd" { "&" } else if opName == "bitOr" { "|" } else { "^" };
        return "((" + cT + ")(((" + uT + ")(" + a0 + ")) " + bSym + " ((" + uT + ")(" + a1 + "))))";
    }
    if opName == "bitNot" {
        rawNot := "(~((" + uT + ")(" + a0 + ")))";
        return "((" + cT + ")(" + (if isU and isSub { cMaskSubByte(kind, rawNot) } else { rawNot }) + "))";
    }
    if opName == "shiftLeft" or opName == "shiftRight" {
        dir := if opName == "shiftLeft" { "shl" } else { "shr" };
        fam := if isU { "u" } else { "s" };
        castArg := if isU { "(uint64_t)(" + a0 + ")" } else { "(int64_t)(" + a0 + ")" };
        return "((" + cT + ")lt_" + dir + "_" + fam + "(" + castArg + ", (int64_t)(" + a1 + "), " + bitsText + ", " + posText + "))";
    }
    if opName == "rotateLeft" or opName == "rotateRight" {
        dir := if opName == "rotateLeft" { "rotl" } else { "rotr" };
        if isU and bits == 32 { return "lt_" + dir + "_u32((uint32_t)(" + a0 + "), (int64_t)(" + a1 + "))"; }
        if isU and bits == 64 { return "lt_" + dir + "_u64((uint64_t)(" + a0 + "), (int64_t)(" + a1 + "))"; }
        fam := if isU { "u" } else { "s" };
        return "((" + cT + ")lt_" + dir + "_" + fam + "((uint64_t)(" + a0 + "), (int64_t)(" + a1 + "), " + bitsText + "))";
    }
    if opName == "wrappingAdd" or opName == "wrappingSub" or opName == "wrappingMul" {
        wSym := if opName == "wrappingAdd" { "+" } else if opName == "wrappingSub" { "-" } else { "*" };
        expr := "(((" + uT + ")(" + a0 + ")) " + wSym + " ((" + uT + ")(" + a1 + ")))";
        if isSub and not isU { return "lt_wrap_s(" + expr + ", " + bitsText + ")"; }
        if isSub and isU { return "((uint8_t)" + cMaskSubByte(kind, expr) + ")"; }
        return "((" + cT + ")" + expr + ")";
    }
    if opName == "wrappingNeg" {
        expr := "((" + uT + ")0u - ((" + uT + ")(" + a0 + ")))";
        if isSub and not isU { return "lt_wrap_s(" + expr + ", " + bitsText + ")"; }
        if isSub and isU { return "((uint8_t)" + cMaskSubByte(kind, expr) + ")"; }
        return "((" + cT + ")" + expr + ")";
    }
    if opName == "saturatingAdd" or opName == "saturatingSub" or opName == "saturatingMul" {
        sOp := if opName == "saturatingAdd" { "sadd" } else if opName == "saturatingSub" { "ssub" } else { "smul" };
        fam := if isU { "u" } else { "s" };
        castT := if isU { "uint64_t" } else { "int64_t" };
        return "((" + cT + ")lt_" + sOp + "_" + fam + "((" + castT + ")(" + a0 + "), (" + castT + ")(" + a1 + "), " + bitsText + "))";
    }
    iTag := cIntTag(kind);
    if opName == "uncheckedAdd" { return "lt_uadd_" + iTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedSub" { return "lt_usub_" + iTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedMul" { return "lt_umul_" + iTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedDiv" { return "lt_udiv_" + iTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedRem" { return "lt_urem_" + iTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedNeg" { return "lt_uneg_" + iTag + "((" + cT + ")(" + a0 + "), " + posText + ")"; }
    if opName == "uncheckedShiftLeft" { return "lt_ushl_" + iTag + "((" + cT + ")(" + a0 + "), (int64_t)(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedShiftRight" { return "lt_ushr_" + iTag + "((" + cT + ")(" + a0 + "), (int64_t)(" + a1 + "), " + posText + ")"; }
    if opName == "uncheckedTruncate" { return "lt_utrunc_" + iTag + "(" + floatOperandCode(srcKind, a0) + ", " + posText + ")"; }
    widthMask := if bits == 64 { "UINT64_MAX" } else { "((UINT64_C(1) << " + bitsText + ") - UINT64_C(1))" };
    masked := "(((uint64_t)(" + a0 + ")) & " + widthMask + ")";
    if opName == "countOnes" { return "lt_popcnt(" + masked + ")"; }
    if opName == "leadingZeros" { return "lt_clz(" + masked + ", " + bitsText + ")"; }
    if opName == "trailingZeros" { return "lt_ctz(" + masked + ", " + bitsText + ")"; }
    if opName == "byteSwap" {
        if bits == 8 { return a0; }
        return "((" + cT + ")lt_bswap" + bitsText + "((" + uT + ")(" + a0 + ")))";
    }
    if opName == "wideningMul" {
        tupleKind := "(lo:" + kind + ",hi:" + kind + ")";
        return "/*@T:" + tupleKind + "@*/lt_wmul_" + cIntTag(kind) + "__" + tupleStructTag + "((" + cT + ")(" + a0 + "), (" + cT + ")(" + a1 + "))";
    }
    a0
}
