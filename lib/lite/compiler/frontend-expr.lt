        } else if operator.text == "+" and left.kind == ir.VALUE_KIND_STRING and right.kind == ir.VALUE_KIND_STRING {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = ctx.textParsed(ir.targetTextLiteralCode(target, combined), combined, true, right.next);
            } else if left.constant and left.textValue == "" {
                left = ctx.textParsed(right.code, right.textValue, right.constant, right.next);
            } else if right.constant and right.textValue == "" {
                left = ctx.textParsed(left.code, left.textValue, left.constant, right.next);
            } else {
                strCode := if target == ir.TARGET_C and (left.code.startsWithAt(0, "/*@CBLK:") or right.code.startsWithAt(0, "/*@CBLK:")) {
                    prep := cPrepareBinaryCblkOperands(ir.VALUE_KIND_STRING, left.code, ir.VALUE_KIND_STRING, right.code);
                    rawStr := ir.targetConcatCode(target, prep.lExpr, prep.rExpr);
                    cWrapBinaryCblkExpr(ir.VALUE_KIND_STRING, prep.stmts, rawStr, prep.drops)
                } else {
                    ir.targetConcatCode(target, left.code, right.code)
                };
                left = ctx.textParsed(strCode, "", false, right.next);
            }
        } else if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
            if operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
            }
            promotedFloat := numeric.promoteNumericKind(left.kind, right.kind);
            floatKind := if promotedFloat =!= "" { promotedFloat } else if numeric.isFloatKind(left.kind) { left.kind } else { right.kind };
            code := if target == ir.TARGET_C and (left.code.startsWithAt(0, "/*@CBLK:") or right.code.startsWithAt(0, "/*@CBLK:")) {
                prep := cPrepareBinaryCblkOperands(left.kind, left.code, right.kind, right.code);
                rawFl := if floatKind == ir.VALUE_KIND_FLOAT8 {
                    ir.targetFloat8BinaryCode(target, operator.text, ir.targetFloat8OperandCode(target, left.kind, prep.lExpr), ir.targetFloat8OperandCode(target, right.kind, prep.rExpr), operatorPosition)
                } else if floatKind == ir.VALUE_KIND_FLOAT16 {
                    ir.targetFloat16BinaryCode(target, operator.text, ir.targetFloat16OperandCode(target, left.kind, prep.lExpr), ir.targetFloat16OperandCode(target, right.kind, prep.rExpr), operatorPosition)
                } else if floatKind == ir.VALUE_KIND_FLOAT32 {
                    ir.targetFloat32BinaryCode(target, operator.text, ir.targetFloat32OperandCode(target, left.kind, prep.lExpr), ir.targetFloat32OperandCode(target, right.kind, prep.rExpr), operatorPosition)
                } else {
                    ir.targetFloatBinaryCode(target, operator.text, ir.targetFloatOperandCode(target, left.kind, prep.lExpr), ir.targetFloatOperandCode(target, right.kind, prep.rExpr), operatorPosition)
                };
                cWrapBinaryCblkExpr(floatKind, prep.stmts, rawFl, prep.drops)
            } else if floatKind == ir.VALUE_KIND_FLOAT8 {
                ir.targetFloat8BinaryCode(target, operator.text, ir.targetFloat8OperandCode(target, left.kind, left.code), ir.targetFloat8OperandCode(target, right.kind, right.code), operatorPosition)
            } else if floatKind == ir.VALUE_KIND_FLOAT16 {
                ir.targetFloat16BinaryCode(target, operator.text, ir.targetFloat16OperandCode(target, left.kind, left.code), ir.targetFloat16OperandCode(target, right.kind, right.code), operatorPosition)
            } else if floatKind == ir.VALUE_KIND_FLOAT32 {
                ir.targetFloat32BinaryCode(target, operator.text, ir.targetFloat32OperandCode(target, left.kind, left.code), ir.targetFloat32OperandCode(target, right.kind, right.code), operatorPosition)
            } else {
                ir.targetFloatBinaryCode(target, operator.text, ir.targetFloatOperandCode(target, left.kind, left.code), ir.targetFloatOperandCode(target, right.kind, right.code), operatorPosition)
            };
            left = (kind = floatKind, code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if types.isListKind(left.kind) or types.isListKind(right.kind) {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if types.isMapKind(left.kind) or types.isMapKind(right.kind) {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for map values");
        } else if types.isSetKind(left.kind) or types.isSetKind(right.kind) {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for set values");
        } else if operator.text == "+" {
            syntax.failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
        if inferMode and opMarkers =!= "" { left = ctx.withMarkers(left, opMarkers); }
    }
    left
};

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`, with construct context tracking. */
pub parseBinaryCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    sourceSize := source.length();
    var start := syntax.skipTrivia(source, position, prefix);
    if start >= sourceSize {
        syntax.failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    effectiveMinimum := if minimum < 0 { 0 } else { minimum };
    var leaderStart := -1;
    var leaderText := "";
    if effectiveMinimum == 0 and (source.wordAt(start, "and") or source.wordAt(start, "or")) {
        leaderStart = start;
        leaderEnd := source.skipName(start);
        leaderText = source.slice(start, leaderEnd);
        start = syntax.skipTrivia(source, leaderEnd, prefix);
        if source.wordAt(start, "and") or source.wordAt(start, "or") {
            syntax.failAt(source, start, prefix, "leading " + leaderText + " may appear only once");
        }
    }
    var left := ctx.intParsed("", 0, true, start);
    ch := source.at(start);
    if ch == "(" {
        left = parseParenOrTupleExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "+" or ch == "-" {
        left = parseUnarySignExpr(target, source, start, ch, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch.isDigit() {
        left = syntax.parseNumberWithDefaults(target, source, start, prefix, expected, minimum, types.defaultIntKind(aliases, prefix), types.defaultFloatKind(aliases, prefix));
    } else if ch == "\"" {
        left = syntax.parseText(target, source, start, prefix);
    } else if ch == "[" {
        left = parseListOrArrayExpr(target, source, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "@" {
        left = parseTagPrefixExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "{" {
        if bodySink == "" and types.isRecordKind(expected) and not types.isAnonRecordKind(expected) {
            left = parseRecordLiteral(target, source, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
        } else if bodySink == "" {
            left = parseInferredRecordLiteral(target, source, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
        } else {
            blkLocMark := sym.localMark();
            blkAliasMark := sym.aliasMark();
            left = parseBlockExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, bodySink, aliases);
            sym.rewindLocalsTo(blkLocMark);
            sym.rewindAliasesTo(blkAliasMark);
        }
    } else if ch.isNameStart() {
        if bodySink == "exprOut" and source.wordAt(start, "do") and source.slice(start, source.skipName(start)) == "do" {
            afterDoExpr := syntax.skipTrivia(source, start + 2, prefix);
            if afterDoExpr >= source.length() or source.at(afterDoExpr) =!= "{" {
                syntax.failAt(source, afterDoExpr, prefix, "expected { after do");
            }
            blkLocMark := sym.localMark();
            blkAliasMark := sym.aliasMark();
            left = parseBlockExpr(target, source, afterDoExpr, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, bodySink, aliases);
            sym.rewindLocalsTo(blkLocMark);
            sym.rewindAliasesTo(blkAliasMark);
        } else {
            left = parseNamedPrimaryExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
        }
    } else if ch == "." {
        left = resolveLeadingDotExpr(target, source, start, prefix, expected, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    } else {
        syntax.failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    left = parsePostfixChain(target, source, start, left, expected, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    left = parseBinaryOperatorChain(target, source, start, left, prefix, locals, functions, params, currentName, effectiveMinimum, ctxs, iifeDepth, inferMode, aliases);
    if leaderStart >= 0 and left.kind =!= ir.VALUE_KIND_BOOL {
        syntax.failAt(source, leaderStart, prefix, "leading " + leaderText + " requires a Bool expression");
    }
    left
};

/** Parses one expression with an empty construct context stack. */
pub parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    emptyAliases: List<AliasDecl> = [];
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, minimum, [], 0, false, "", emptyAliases)
};

/** Parses one complete expression at the lowest precedence with construct contexts and an optional contextual kind. */
pub parseExpressionAsCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, 0, ctxs, 0, false, "", aliases)
};

/** Parses one statement-level expression with construct contexts, allowing unit-producing tagged conditionals without else. */
pub parseStatementExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, -2, ctxs, 0, false, "", aliases)
};

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
pub parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, 0)
};

/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
pub parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, "", 0, ctxs, 0, false, "", aliases)
};

/** Parses one complete expression at the lowest precedence without a contextual kind. */
pub parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, "", 0)
};

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
pub parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    sourceLen := source.length();
    var inner := syntax.skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < sourceLen and source.at(inner) == "(" {
        parenCount = parenCount + 1;
        inner = syntax.skipTrivia(source, inner + 1, prefix);
    }
    if not source.wordAt(inner, "if") { return []; }
    if syntax.ifChainHasPattern(source, inner, prefix) { return []; }
    if not syntax.ifChainIsPartialOrReserved(source, inner, prefix) { return []; }
    mut result: List<Item> = [];
    var cursor := syntax.skipTrivia(source, inner + 2, prefix);
    var isFirst := true;
    var condCount := 0;
    var pred0Rt := "";
    var pred0Neg := false;
    var arm0Res := false;
    var arm1Res := false;
    var arm1IsElse := false;
    loop true {
        syntax.rejectHeaderBlockTag(source, cursor, prefix, if isFirst { "if" } else { "else if" });
        conditionStart := cursor;
        condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, params, currentName, ctxs, aliases);
        if condition.kind =!= ir.VALUE_KIND_BOOL {
            syntax.failAt(source, conditionStart, prefix, "if condition must be Bool");
        }
        condCount = condCount + 1;
        if isFirst {
            pred0 := extractImmBoolPredicate(source, conditionStart, condition.next, prefix, locals);
            pred0Rt = pred0.rt;
            pred0Neg = pred0.negated;
        }
        conditionCode := if condition.constant {
            ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
        } else {
            condition.code
        };
        beforeOpen := syntax.skipTrivia(source, condition.next, prefix);
        syntax.rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in if");
        open := syntax.expectSymbol(source, beforeOpen, "{", prefix);
        resEnd := syntax.isReservedBranchBlock(source, open - 1, prefix);
        mut result.pushBack((kind = if isFirst { ir.ITEM_KIND_IF } else { ir.ITEM_KIND_ELSE_IF }, name = "", runtime = "", code = conditionCode,
        intValue = 0, textValue = ""));
        if resEnd >= 0 {
            if isFirst { arm0Res = true; }
            cursor = resEnd;
        } else {
            branchStart := syntax.skipTrivia(source, open, prefix);
            brLocMark := sym.localMark();
            brLocals := if isFirst and pred0Rt =!= "" { ctx.narrowLocalsForPredicate(locals, pred0Rt, not pred0Neg) } else { locals };
            branch := parseExpressionAsCtx(target, source, branchStart, prefix, brLocals, functions, params, currentName, targetKind, ctxs, aliases);
            sym.rewindLocalsTo(brLocMark);
            if not types.isCompatibleKind(targetKind, branch.kind) {
                syntax.failAt(source, targetAt, prefix, "cannot assign " + types.displayKind(branch.kind) + " to " + types.displayKind(targetKind) + " local " + targetName);
            }
            cursor = syntax.expectSymbol(source, syntax.skipTrivia(source, branch.next, prefix), "}", prefix);
            mut result.pushBack((kind = ir.ITEM_PREFIX_ASSIGN + ctx.storageKind(targetKind), name = targetName, runtime = targetRuntime,
            code = ctx.assignValueCode(target, targetKind, branch.kind, branch.code), intValue = branch.intValue, textValue = ctx.storageTextPayload(targetKind, branch.textValue)));
        }
        isFirst = false;
        afterBranch := syntax.skipTrivia(source, cursor, prefix);
        if not source.wordAt(afterBranch, "else") {
            var end := afterBranch;
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= source.length() or source.at(end) =!= ")" {
                    matched = false;
                    break;
                }
                end = syntax.skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            statementNext := if matched { syntax.consumeStatementEnd(source, end, prefix) } else { -1 };
            if statementNext < 0 {
                syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
            }
            meta := if condCount == 1 {
                if arm0Res { "$noop" }
                else if pred0Rt =!= "" { if pred0Neg { "$pred_f:" + pred0Rt } else { "$pred_t:" + pred0Rt } }
                else { "" }
            } else { "" };
            (mut result).pushBack((kind = ir.ITEM_KIND_END_IF, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            mut result.pushBack((kind = ir.ITEM_KIND_END, name = "", runtime = "", code = "", intValue = statementNext, textValue = meta));
            return result;
        }
        afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
        syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
        if not source.wordAt(afterElse, "if") {
            elseOpen := syntax.expectSymbol(source, afterElse, "{", prefix);
            elseResEnd := syntax.isReservedBranchBlock(source, elseOpen - 1, prefix);
            arm1IsElse = true;
            var endAfterElse := elseOpen;
            if elseResEnd >= 0 {
                arm1Res = true;
                endAfterElse = elseResEnd;
            } else {
                elseBrStart := syntax.skipTrivia(source, elseOpen, prefix);
                elseMark := sym.localMark();
                elseLocs := if condCount == 1 and pred0Rt =!= "" { ctx.narrowLocalsForPredicate(locals, pred0Rt, pred0Neg) } else { locals };
                elseBr := parseExpressionAsCtx(target, source, elseBrStart, prefix, elseLocs, functions, params, currentName, targetKind, ctxs, aliases);
                sym.rewindLocalsTo(elseMark);
                if not types.isCompatibleKind(targetKind, elseBr.kind) {
                    syntax.failAt(source, targetAt, prefix, "cannot assign " + types.displayKind(elseBr.kind) + " to " + types.displayKind(targetKind) + " local " + targetName);
                }
                endAfterElse = syntax.expectSymbol(source, syntax.skipTrivia(source, elseBr.next, prefix), "}", prefix);
                mut result.pushBack((kind = ir.ITEM_KIND_ELSE, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                mut result.pushBack((kind = ir.ITEM_PREFIX_ASSIGN + ctx.storageKind(targetKind), name = targetName, runtime = targetRuntime,
                code = ctx.assignValueCode(target, targetKind, elseBr.kind, elseBr.code), intValue = elseBr.intValue, textValue = ctx.storageTextPayload(targetKind, elseBr.textValue)));
            }
            var endE := syntax.skipTrivia(source, endAfterElse, prefix);
            var remE := parenCount;
            var okE := true;
            loop remE > 0 {
                if endE >= source.length() or source.at(endE) =!= ")" { okE = false; break; }
                endE = syntax.skipTrivia(source, endE + 1, prefix);
                remE = remE - 1;
            }
            stmtNextE := if okE { syntax.consumeStatementEnd(source, endE, prefix) } else { -1 };
            if stmtNextE < 0 {
                syntax.failAt(source, endAfterElse, prefix, "expected ; after conditional assignment");
            }
            metaE := if condCount == 1 and arm1IsElse {
                if arm0Res and arm1Res { "$noop" }
                else if (not arm0Res) and arm1Res {
                    if pred0Rt =!= "" { if pred0Neg { "$pred_f:" + pred0Rt } else { "$pred_t:" + pred0Rt } } else { "" }
                } else if arm0Res and (not arm1Res) {
                    if pred0Rt =!= "" { if pred0Neg { "$pred_t:" + pred0Rt } else { "$pred_f:" + pred0Rt } } else { "" }
                } else { "" }
            } else { "" };
            (mut result).pushBack((kind = ir.ITEM_KIND_END_IF, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            mut result.pushBack((kind = ir.ITEM_KIND_END, name = "", runtime = "", code = "", intValue = stmtNextE, textValue = metaE));
            return result;
        }
        cursor = syntax.skipTrivia(source, afterElse + 2, prefix);
    }
    []
};

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
pub parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    sourceLen := source.length();
    var inner := syntax.skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < sourceLen and source.at(inner) == "(" {
        parenCount = parenCount + 1;
        inner = syntax.skipTrivia(source, inner + 1, prefix);
    }
    ifKwPos := syntax.skipOptionalScanTag(source, inner, prefix, "if");
    if ifKwPos >= 0 and source.wordAt(ifKwPos, "if") {
        scannedEnd := syntax.scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := syntax.skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= source.length() or source.at(end) =!= ")" {
                    matched = false;
                    break;
                }
                end = syntax.skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and syntax.consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinaryCtx(target, source, inner, prefix, locals, functions, params, currentName, expected, -1, ctxs, 0, false, "", aliases);
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseExpressionAsCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
pub parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): (next: Int, returned: Bool, code: String, valueKind: String) {
    var isTailClose := false;
    if valueTail {
        end := syntax.scanExpressionItemEnd(source, position, prefix);
        nextCheck := syntax.skipItemSeparators(source, end, prefix);
        isTailClose = nextCheck < source.length() and source.at(nextCheck) == "}";
    }
    expected := if isTailClose {
        if types.isListKind(currentResult) { "Tail" + currentResult } else { currentResult }
    } else {
        ""
    };
    trimmedStart := syntax.skipTrivia(source, position, prefix);
    stmtSink := if trimmedStart < source.length() and (source.at(trimmedStart) == "{" or source.wordAt(trimmedStart, "do")) and (not isTailClose or currentResult == ir.VALUE_KIND_UNIT) { "exprOut" } else { "" };
    stmtMin := if not isTailClose or currentResult == ir.VALUE_KIND_UNIT { -2 } else { 0 };
    parsed := parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, stmtMin, ctxs, 0, false, stmtSink, aliases);
    ended := syntax.consumeStatementEnd(source, parsed.next, prefix);
    if ended < 0 { syntax.failAt(source, syntax.skipTrivia(source, parsed.next, prefix), prefix, "expected ; after expression statement"); }
    next := syntax.skipItemSeparators(source, ended, prefix);
    returned := currentName =!= "" and valueTail and next < source.length() and source.at(next) == "}";
    if returned and not types.isCompatibleKind(currentResult, parsed.kind) {
        syntax.failAt(source, position, prefix, "cannot return " + types.displayKind(parsed.kind) + " from function " + currentName +
        " returning " + types.displayKind(currentResult));
    }
    (next = next, returned = returned, code = if returned { if parsed.kind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, parsed.code) } else { ctx.assignValueCode(target, currentResult, parsed.kind, parsed.code) } } else { parsed.code }, valueKind = parsed.kind)
};

/** Pre-scans field names declared inside a `record { ... }` body before parsing field defaults. */
scanRecordDeclFieldNames := fn(source: String, bracePos: Int, prefix: String): List<String> {
    size := source.length();
    mut out: List<String> = [];
    var cursor := bracePos + 1;
    loop true {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= size or source.at(cursor) == "}" { break; }
        if not source.at(cursor).isNameStart() { break; }
        fEnd := source.skipName(cursor);
        mut out.pushBack(source.slice(cursor, fEnd));
        cursor = syntax.skipTrivia(source, fEnd, prefix);
        var depth := 0;
        loop cursor < size {
            ch := source.at(cursor);
            if ch == "\"" {
                cursor = syntax.skipAliasString(source, cursor);
            } else if ch == "/" and source.startsWithAt(cursor, "/*") {
                cursor = syntax.skipComment(source, cursor, prefix);
            } else if ch == "(" or ch == "[" or ch == "{" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" or ch == "]" {
                if depth > 0 { depth = depth - 1; }
                cursor = cursor + 1;
            } else if ch == "}" {
                if depth == 0 { break; }
                depth = depth - 1;
                cursor = cursor + 1;
            } else if ch == ";" and depth == 0 {
                cursor = cursor + 1;
                break;
            } else {
                cursor = cursor + 1;
            }
        }
    }
    out
};

/** Parses `Name := record[<T: Type>] { field: Type [= default]; ... }`, validating field names, types, defaults, and returning the canonical kind, encoded defaults, and generic parameter CSV. */
pub parseRecordDecl := fn(target: String, source: String, recPos: Int, nameStart: Int, recName: String, aliasDepth: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): (kind: String, encodedDefaults: String, genericParams: String, markers: String, next: Int) {
    size := source.length();
    gp := types.scanComptimeTypeParams(source, recPos + 6, prefix);
    if not gp.ok {
        syntax.failAt(source, gp.errPos, prefix, gp.errMsg);
    }
    attrStart := syntax.skipTrivia(source, gp.next, prefix);
    layoutAttr := types.parseTypeLayoutAttrs(source, attrStart, prefix);
    if not layoutAttr.ok {
        syntax.failAt(source, layoutAttr.errPos, prefix, layoutAttr.errMsg);
    }
    bracePos := syntax.skipTrivia(source, layoutAttr.next, prefix);
    if layoutAttr.hasAttrs and bracePos < size and source.at(bracePos) == "<" {
        syntax.failAt(source, attrStart, prefix, "layout attributes must follow type parameters (e.g. 'record<T> #packed { ... }')");
    }
    if bracePos >= size or source.at(bracePos) =!= "{" {
        syntax.failAt(source, bracePos, prefix, "expected { after record");
    }
    scopedAliases := types.aliasesUpToDepth(aliases, aliasDepth);
    resolvedRecParams := if gp.hasParams {
        types.resolveComptimeParamSpecs(source, recPos + 6, prefix, scopedAliases, gp.paramsCsv)
    } else {
        ""
    };
    allFieldNames := scanRecordDeclFieldNames(source, bracePos, prefix);
    mut defLocals: List<Local> = locals;
    fldDepth := ir.maxLocalLexDepth(locals) + 1;
    var fieldIdx := 0;
    mut seenRec: List<String> = [aliasDepth.toText() + ":" + recName];
    mut fieldNames: List<String> = [];
    mut defaultKeys: List<String> = [];
    mut defaultCodes: List<String> = [];
    var markers := "";
    var cursor := bracePos + 1;
    loop true {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= size {
            syntax.failAt(source, bracePos, prefix, "expected } after record fields");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        if not source.at(cursor).isNameStart() {
            syntax.failAt(source, cursor, prefix, "expected a record field name");
        }
        fStart := cursor;
        fEnd := source.skipName(fStart);
        fName := source.slice(fStart, fEnd);
        if syntax.isReservedWord(fName) {
            syntax.unsupportedFeature(source, fStart, fName, prefix);
        }
        if fieldNames.contains(fName) {
            syntax.failAt(source, fStart, prefix, "duplicate record field " + fName);
        }
        (mut fieldNames).pushBack(fName);
        afterField := syntax.skipTrivia(source, fEnd, prefix);
        if afterField >= size or source.at(afterField) =!= ":" {
            syntax.failAt(source, afterField, prefix, "expected : after record field " + fName);
        }
        typeStart := syntax.skipTrivia(source, afterField + 1, prefix);
        fieldType := types.parseTypeWithSeen(source, fStart, true, source, typeStart, prefix, scopedAliases, "record field", resolvedRecParams, seenRec);
        if fieldType.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, fStart, prefix, "unsupported record field type Unit");
        }
        afterType := syntax.skipTrivia(source, fieldType.next, prefix);
        var nextCursor := afterType;
        var lastTokenPos := fieldType.next;
        if syntax.isSingleEquals(source, afterType) {
            if gp.hasParams and types.kindHasAnyGenericParam(resolvedRecParams, fieldType.kind) {
                syntax.failAt(source, afterType, prefix, "default initializer on generic-typed field " + fName + " is not supported yet");
            }
            defStart := syntax.skipTrivia(source, afterType + 1, prefix);
            mut curDefLocals: List<Local> = defLocals;
            var laterIdx := fieldIdx;
            loop laterIdx < allFieldNames.length() {
                laterName := allFieldNames[laterIdx];
                mut curDefLocals.pushBack((name = laterName, runtime = "", kind = ir.VALUE_KIND_INT,
                mutable = false, writable = false, depth = fldDepth, constant = false, code = "",
                intValue = 0, textValue = "$recfld_fwd:" + fName + ":" + laterName, initState = ir.INIT_STATE_INIT));
                laterIdx = laterIdx + 1;
            }
            defParsed := parseBinaryCtx(target, source, defStart, prefix, curDefLocals, functions, params, currentName, fieldType.kind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, defParsed); }
            if not types.isCompatibleKind(fieldType.kind, defParsed.kind) {
                syntax.failAt(source, defStart, prefix, "cannot initialize " + types.displayKind(fieldType.kind) + " field " + fName + " with " + types.displayKind(defParsed.kind));
            }
            if defParsed.kind == ir.VALUE_KIND_NEVER {
                syntax.failAt(source, defStart, prefix, "record field default " + fName + " cannot diverge");
            }
            converted := ctx.assignValueCode(target, fieldType.kind, defParsed.kind, defParsed.code);
            mut defaultKeys.pushBack(fName);
            mut defaultCodes.pushBack(converted);
            lastTokenPos = defParsed.next;
            nextCursor = syntax.skipTrivia(source, defParsed.next, prefix);
        }
        recFldToken := "__LT_RECFLD_" + fieldIdx.toText() + "__";
        mut defLocals.pushBack((name = fName, runtime = recFldToken, kind = fieldType.kind,
        mutable = false, writable = false, depth = fldDepth, constant = false, code = recFldToken,
        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
        fieldIdx = fieldIdx + 1;
        if nextCursor < size and source.at(nextCursor) == ";" {
            cursor = nextCursor + 1;
        } else if nextCursor < size and source.at(nextCursor) == "}" {
            cursor = nextCursor;
        } else if lastTokenPos > 0 and source.at(lastTokenPos - 1) == "}" {
            cursor = nextCursor;
        } else {
            syntax.failAt(source, nextCursor, prefix, "expected ; or } after record field " + fName);
        }
    }
    afterDecl := syntax.consumeStatementEnd(source, cursor, prefix);
    if afterDecl < 0 {
        syntax.failAt(source, syntax.skipTrivia(source, cursor, prefix), prefix, "expected ; after record declaration " + recName);
    }
    canonicalKind := if gp.hasParams {
        tplSeen: List<String> = [aliasDepth.toText() + ":" + recName];
        aliasIdx := types.aliasIndexAt(aliases, nameStart);
        aliasTarget := if aliasIdx >= 0 { aliases[aliasIdx].target } else { "" };
        innerRaw := if aliasTarget.startsWithAt(0, "@genraw:") {
            pDec := types.decodeLengthPrefixedAt(aliasTarget, 8);
            if pDec.next >= 0 { aliasTarget.slice(pDec.next, aliasTarget.length()) } else { "" }
        } else {
            aliasTarget
        };
        types.resolveGenericTypeText(source, nameStart, prefix, scopedAliases, innerRaw, resolvedRecParams, tplSeen)
    } else {
        emptySeen: List<String> = [];
        types.resolveAliasKind(source, nameStart, prefix, aliases, recName, emptySeen)
    };
    if not gp.hasParams and types.recordLayoutAttrs(canonicalKind).packed {
        vErr := types.validateCanonicalKind(canonicalKind, "");
        if vErr =!= "" {
            syntax.failAt(source, nameStart, prefix, vErr);
        }
    }
    (kind = canonicalKind, encodedDefaults = types.encodeRecordPairs(defaultKeys, defaultCodes), genericParams = resolvedRecParams, markers = markers, next = afterDecl)
};
