                                rawVal.slice(0, rawVal.length() - 2) + ")"
                            } else if target == ir.TARGET_C and numeric.isFloatKind(backing) and rawVal.startsWithAt(0, "Number(\"") and rawVal.length() > 10 {
                                rawVal.slice(8, rawVal.length() - 2)
                            } else if target == ir.TARGET_C and numeric.isFloatKind(backing) and rawVal.startsWithAt(0, "Math.fround(Number(\"") and rawVal.length() > 23 {
