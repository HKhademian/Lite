                        wName := "lt_wrap_" + info.runtime;
                        wRet := types.cValueType(info.result);
                        mut wParamsBuf: tb.TextBuilder;
                        mut wParamsBuf.append("void *_env");
                        mut wArgsBuf: tb.TextBuilder;
                        var wi := 0;
                        loop wi < info.count {
                            pEnt := params[info.first + wi];
                            rawPK := types.paramKindOf(pEnt);
                            pIsOpt := types.paramIsOptional(pEnt);
                            pIsMut := rawPK.startsWithAt(0, "mut ");
                            pK := if pIsMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                            aName := "lt_a_" + wi.toText();
                            if pIsOpt {
                                hName := "lt_h_" + wi.toText();
                                mut wParamsBuf.append(", bool ");
                                mut wParamsBuf.append(hName);
                                mut wParamsBuf.append(", ");
                                mut wParamsBuf.append(types.cValueType(pK));
                                mut wParamsBuf.append(" ");
                                mut wParamsBuf.append(aName);
                                if wi > 0 { mut wArgsBuf.append(", "); }
                                mut wArgsBuf.append(hName);
                                mut wArgsBuf.append(", ");
                                mut wArgsBuf.append(aName);
                            } else {
                                cPT := if pIsMut and not types.isSliceKind(pK) and not types.isDynKind(pK) {
                                    types.cValueType(pK) + " *"
                                } else {
                                    types.cValueType(pK)
                                };
                                mut wParamsBuf.append(", ");
                                mut wParamsBuf.append(cPT);
                                mut wParamsBuf.append(" ");
                                mut wParamsBuf.append(aName);
                                if wi > 0 { mut wArgsBuf.append(", "); }
                                if not pIsMut and types.cParamIsConstPtr(pK) {
                                    mut wArgsBuf.append("&");
                                }
                                mut wArgsBuf.append(aName);
                            }
                            wi = wi + 1;
                        }
                        if fnCtx =!= "" {
                            mut wParamsBuf.append(", const ");
                            mut wParamsBuf.append(types.cCtxTag(fnCtx));
                            mut wParamsBuf.append(" *lite_ctx");
                            if info.count > 0 { mut wArgsBuf.append(", "); }
                            mut wArgsBuf.append("lite_ctx");
                        }
                        wParams := wParamsBuf.build();
                        wArgs := wArgsBuf.build();
                        wBody := if info.result == ir.VALUE_KIND_UNIT or info.result == ir.VALUE_KIND_NEVER {
                            info.runtime + "(" + wArgs + ");"
                        } else {
                            "return " + info.runtime + "(" + wArgs + ");"
                        };
                        wDef := "static " + wRet + " " + wName + "(" + wParams + ") { (void)_env; " + wBody + " }";
                        left = (kind = fnValKind, code = "/*@T:" + fnValKind + "@*//*@CFN_START:" + wName + "@*/" + wDef + "/*@CFN_END@*/((" + wTag + "){ " + wName + ", NULL })",
                        intValue = 0, textValue = "", constant = false, next = left.next);
                    } else {
                        left = (kind = fnValKind, code = info.runtime, intValue = 0, textValue = "", constant = false, next = left.next);
                    }
                } else if info.runtime.startsWithAt(0, "lite$") {
                    var cursor := syntax.skipTrivia(source, postPosition + 1, prefix);
                    mut argumentCodes: List<String> = [];
                    mut hostDrops: List<String> = [];
                    var callMarkers := "";
                    var argumentCount := 0;
                    size := source.length();
                    if cursor < size and source.at(cursor) =!= ")" {
                        loop true {
                            isNamed := if syntax.isSingleEquals(source, cursor) { true }
                            else if cursor < size and source.at(cursor).isNameStart() {
                                syntax.isSingleEquals(source, syntax.skipTrivia(source, source.skipName(cursor), prefix))
                            } else { false };
                            if isNamed {
                                syntax.failAt(source, cursor, prefix, "named arguments are not supported for host function " + calleeDisplay);
                            }
                            if argumentCount >= info.count {
                                suffix := if info.count == 1 { " argument" } else { " arguments" };
                                syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + info.count.toText() + suffix + ", got more");
                            }
                            argExpected := types.paramKindOf(params[info.first + argumentCount]);
                            argument := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                            if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, argument); }
                            if not types.isCompatibleKind(argExpected, argument.kind) {
                                syntax.failAt(source, cursor, prefix, "argument " + (argumentCount + 1).toText() + " of " + calleeDisplay +
                                " must be " + types.displayKind(argExpected) + ", got " + types.displayKind(argument.kind));
                            }
                            rawHostArg := ctx.assignReadOnlyArgCode(target, argExpected, argument.kind, argument.code);
                            if target == ir.TARGET_C and not argExpected.startsWithAt(0, "mut ") {
                                hb := cBorrowExprWithPostDrop(argExpected, rawHostArg, false);
                                if hb.drop =!= "" { mut hostDrops.pushBack(hb.drop); }
                                (mut argumentCodes).pushBack(hb.expr);
                            } else {
                                (mut argumentCodes).pushBack(rawHostArg);
                            }
                            argumentCount = argumentCount + 1;
                            cursor = syntax.skipTrivia(source, argument.next, prefix);
                            if cursor < size and source.at(cursor) == "," {
                                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                                if cursor < size and source.at(cursor) == ")" { break; }
                            } else {
                                break;
                            }
                        }
                    }
                    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
                    optionalPrompt := info.runtime == "lite$inputAll" or info.runtime == "lite$inputLine" or
                    info.runtime == "lite$inputInt" or info.runtime == "lite$inputFloat";
                    optionalExit := info.runtime == "lite$exit";
                    if argumentCount =!= info.count and not ((optionalPrompt or optionalExit) and argumentCount == 0) {
                        suffix := if info.count == 1 { " argument" } else { " arguments" };
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + info.count.toText() +
                        suffix + ", got " + argumentCount.toText());
                    }
                    if optionalExit and argumentCount == 0 {
                        mut argumentCodes.pushBack(ir.targetIntLiteralCode(target, 0, false, "0"));
                    }
                    if optionalPrompt {
                        if argumentCount == 0 { mut argumentCodes.pushBack(if target == ir.TARGET_C { "LT_NULL_STR" } else { "undefined" }); }
                        place := sourceLib.lineColumn(source, errPos);
                        location := (if prefix == "" { "" } else { prefix + ":" }) + place.line.toText() + ":" +
                        place.column.toText() + ": InputFault: ";
                        mut argumentCodes.pushBack(ir.targetTextLiteralCode(target, location));
                    }
                    if info.runtime == "lite$textAt" or info.runtime == "lite$textSlice" {
                        mut argumentCodes.pushBack(errPos.toText());
                    }
                    callResultKind := if optionalExit { ir.VALUE_KIND_NEVER } else { info.result };
                    rawHostCall := info.runtime + "(" + argumentCodes.join(", ") + ")";
                    hostCallCode := if target == ir.TARGET_C { cWrapExprWithPostDrops(callResultKind, rawHostCall, hostDrops) } else { rawHostCall };
                    left = ctx.withMarkers((kind = callResultKind, code = hostCallCode,
                    intValue = 0, textValue = "", constant = false, next = cursor), callMarkers);
                } else {
                    handleUserCall = true;
                    callFirst = info.first;
                    callCount = info.count;
                    callResult = info.result;
                    callRuntime = info.runtime;
                }
            } else {
                callParams = types.fnParamEntries(left.kind);
                callFirst = 0;
                callCount = types.fnParamCount(left.kind);
                callResult = types.fnResultKind(left.kind);
            }
            if handleUserCall {
                effCallCtxKind := if isModuleFn { contexts.fnContextFor(callRuntime) } else { types.fnContextKind(left.kind) };
                if preGenBindings =!= "" {
                    left = parseUserOrIndirectCallWithRecv(target, source, userCallOpenPos, errPos, isModuleFn, calleeDisplay, callRuntime,
                    callParams, callFirst, callCount, callResult, effCallCtxKind, false, "", "", "", "", "", "", preGenBindings, expected, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
                } else {
                    left = parseUserOrIndirectCall(target, source, userCallOpenPos, errPos, isModuleFn, calleeDisplay, callRuntime,
                    callParams, callFirst, callCount, callResult, effCallCtxKind, expected, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
                }
            }
        } else if postPosition < source.length() and source.at(postPosition) == "!" and not source.startsWithAt(postPosition, "!=") {
            if not types.isResultKind(left.kind) {
                syntax.failAt(source, postPosition, prefix, "postfix ! requires a Result value, got " + types.displayKind(left.kind));
            }
            okK := types.resultOkKind(left.kind);
            errK := types.resultErrKind(left.kind);
            fnIdxP := ctx.findCtxByKindIndex(ctxs, ir.CTX_KIND_FN);
            if fnIdxP < 0 {
                if ctx.hasFinallyAbove(ctxs, -1) {
                    syntax.failAt(source, postPosition, prefix, "cannot propagate error out of finally block");
                }
                syntax.failAt(source, postPosition, prefix, "postfix ! cannot be used outside a fallible function");
            }
            if ctx.hasFinallyAbove(ctxs, fnIdxP) {
                syntax.failAt(source, postPosition, prefix, "cannot propagate error out of finally block");
            }
            fnResultP := ctxs[fnIdxP].valKind;
            if not types.isResultKind(fnResultP) {
                syntax.failAt(source, postPosition, prefix, "postfix ! requires enclosing function to return a fallible type ! E, got " + types.displayKind(fnResultP));
            }
            fnErrK := types.resultErrKind(fnResultP);
            if inferMode {
                left = ctx.withMarkers((kind = okK, code = "", intValue = 0, textValue = "", constant = false, next = postPosition + 1),
                ctx.collectParsedMarkers("", left));
                continue;
            }
            if target == ir.TARGET_TS {
                errReadTS := if errK == ir.VALUE_KIND_UNIT {
                    ir.targetUnitLiteralCode(target)
                } else {
                    "(lite$p as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e"
                };
                convErrTS := convertResultErrorExpr(target, source, postPosition, prefix, fnErrK, errK, errReadTS, functions);
                if not convErrTS.ok {
                    syntax.failAt(source, postPosition, prefix, "error type " + types.displayKind(errK) + " cannot propagate into function error type " + types.displayKind(fnErrK));
                }
                okReadTS := if okK == ir.VALUE_KIND_UNIT {
                    "undefined"
                } else {
                    "(lite$p as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v"
                };
                propCodeTS := "((lite$p: " + types.tsFunctionType(left.kind) + "): " + types.tsFunctionType(okK) + " => (lite$p._r === 0 ? " + okReadTS + " : lite$throwProp(" + convErrTS.code + ")))(" + left.code + ")";
                left = (kind = okK, code = propCodeTS, intValue = 0, textValue = "", constant = false, next = postPosition + 1);
            } else {
                srcVar := freshCOwnedTemp("lt_pr_");
                actTag := types.cStructTag(left.kind);
                fnTag := types.cStructTag(fnResultP);
                isFreshSrc := left.code.startsWithAt(0, "/*@CBLK:") or ctx.isCFreshOwnedExpr(left.code);
                srcInitC := if left.code.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(srcVar, left.kind, left.code) } else { srcVar + " = " + left.code + ";" };
                errReadC := if errK == ir.VALUE_KIND_UNIT { "0" } else { srcVar + ".u.err" };
                convErrC := if errK == fnErrK and isFreshSrc {
                    (ok = true, code = errReadC)
                } else {
                    convertResultErrorExpr(target, source, postPosition, prefix, fnErrK, errK, errReadC, functions)
                };
                if not convErrC.ok {
                    syntax.failAt(source, postPosition, prefix, "error type " + types.displayKind(errK) + " cannot propagate into function error type " + types.displayKind(fnErrK));
                }
                actDropFn := types.cDropFnForKind(left.kind);
                errRetExpr := emitResultVariantExpr(target, fnResultP, true, fnErrK, convErrC.code);
                var errCleanup := "";
                if errK == fnErrK and isFreshSrc {
                    errCleanup = " " + srcVar + ".tag = -1;";
                } else if isFreshSrc and actDropFn =!= "" {
                    errCleanup = " " + actDropFn + "(&" + srcVar + ");";
                }
                errStmtC := if errRetExpr.startsWithAt(0, "/*@CBLK:") {
                    eRetTmp := freshCOwnedTemp("lt_per_");
                    types.cValueType(fnResultP) + " " + eRetTmp + "; " + ctx.cUnwrapIntoVar(eRetTmp, fnResultP, errRetExpr) + errCleanup + " return " + eRetTmp + ";"
                } else if fnErrK == errK and isFreshSrc {
                    if errK == ir.VALUE_KIND_UNIT {
                        errCleanup.trim() + " return " + errRetExpr + ";"
                    } else {
                        eMoveTmp := freshCOwnedTemp("lt_pem_");
                        types.cValueType(fnErrK) + " " + eMoveTmp + " = " + errReadC + ";" + errCleanup + " return /*@T:" + fnResultP + "@*/" + fnTag + "_err(" + eMoveTmp + ");"
                    }
                } else {
                    types.cValueType(fnResultP) + " lt_pe_" + srcVar + " = " + errRetExpr + ";" + errCleanup + " return lt_pe_" + srcVar + ";"
                };
                if okK == ir.VALUE_KIND_UNIT {
                    propCodeC := "/*@CBLK:0@*/{ " + actTag + " " + srcVar + "; " + srcInitC + " if (" + srcVar + ".tag != 0) { " + errStmtC + " } " + (if isFreshSrc { srcVar + ".tag = -1;" } else { "" }) + " }";
                    left = (kind = ir.VALUE_KIND_UNIT, code = propCodeC, intValue = 0, textValue = "", constant = false, next = postPosition + 1);
                } else {
                    outVar := freshCOwnedTemp("lt_po_");
                    okAssignC := if isFreshSrc {
                        outVar + " = " + srcVar + ".u.ok; " + srcVar + ".tag = -1;"
                    } else {
                        outVar + " = " + ctx.copiedValueCode(target, okK, srcVar + ".u.ok") + ";"
                    };
                    propCodeC := "/*@CBLK:" + outVar + "@*/" + types.cValueType(okK) + " " + outVar + "; { " + actTag + " " + srcVar + "; " + srcInitC + " if (" + srcVar + ".tag == 0) { " + okAssignC + " } else { " + errStmtC + " } }";
                    left = (kind = okK, code = propCodeC, intValue = 0, textValue = "", constant = false, next = postPosition + 1);
                }
            }
        } else if postPosition < source.length() and source.at(postPosition) == "(" {
            syntax.failAt(source, postPosition, prefix, "cannot call non-function value of type " + types.displayKind(left.kind));
        } else {
            break;
        }
    }
    left
};

/** Parses binary operators (`**`, `*`, `+`, comparisons and chains, `and`/`or`), `: Type` tests, and `else` Result recovery. */
parseBinaryOperatorChain := fn(target: String, source: String, exprStart: Int, initialLeft: Parsed, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, effectiveMinimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var left := initialLeft;
    loop true {
        sourceLen := source.length();
        operatorPosition := syntax.skipTrivia(source, left.next, prefix);
        allowAfterBraceElse := types.isResultKind(left.kind) and operatorPosition < sourceLen and source.wordAt(operatorPosition, "else");
        if left.next > 0 and source.at(left.next - 1) == "}" and not allowAfterBraceElse { break; }
        if operatorPosition >= sourceLen { break; }
        if effectiveMinimum <= 1 and types.isResultKind(left.kind) and source.wordAt(operatorPosition, "else") {
            afterElseKw := syntax.skipTrivia(source, operatorPosition + 4, prefix);
            if afterElseKw < sourceLen and (source.at(afterElseKw) == "(" or source.at(afterElseKw) == "{") {
                okK := types.resultOkKind(left.kind);
                errK := types.resultErrKind(left.kind);
                var errBindName := "";
                var handlerBraceSearch := afterElseKw;
                if source.at(afterElseKw) == "(" {
                    if errK == ir.VALUE_KIND_UNIT {
                        syntax.failAt(source, afterElseKw, prefix, "Result error type is Unit and has no payload to bind in else(...)");
                    }
                    errIdentStart := syntax.skipTrivia(source, afterElseKw + 1, prefix);
                    if errIdentStart >= sourceLen or not source.at(errIdentStart).isNameStart() {
                        syntax.failAt(source, errIdentStart, prefix, "expected error binding name after else(");
                    }
                    errIdentEnd := source.skipName(errIdentStart);
                    errBindName = source.slice(errIdentStart, errIdentEnd);
                    if errBindName =!= "_" and syntax.isReservedWord(errBindName) {
                        syntax.unsupportedFeature(source, errIdentStart, errBindName, prefix);
                    }
                    closeErrParen := syntax.expectSymbol(source, syntax.skipTrivia(source, errIdentEnd, prefix), ")", prefix);
                    handlerBraceSearch = syntax.skipTrivia(source, closeErrParen, prefix);
                }
                if handlerBraceSearch >= sourceLen or source.at(handlerBraceSearch) =!= "{" {
                    syntax.failAt(source, handlerBraceSearch, prefix, "expected { for else handler");
                }
                elVar := if target == ir.TARGET_C { freshCOwnedTemp("lt_el_") } else { "lite$el" + operatorPosition.toText() };
                mut handlerLocals: List<Local> = locals;
                handlerDepth := ir.maxLocalLexDepth(locals) + 1;
                if errBindName =!= "" and errBindName =!= "_" {
                    errBindExpr := if target == ir.TARGET_C {
                        "(" + elVar + ".u.err)"
                    } else {
                        "((" + elVar + " as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e)"
                    };
                    mut handlerLocals.pushBack((name = errBindName, runtime = errBindExpr, kind = errK,
                    mutable = false, writable = false, depth = handlerDepth, constant = false, code = errBindExpr,
                    intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                }
                hLocMark := sym.localMark();
                handler := parseBlockExpr(target, source, handlerBraceSearch, prefix, handlerLocals, functions, params, currentName, okK, 0, ctxs, iifeDepth, inferMode, "branch", aliases);
                sym.rewindLocalsTo(hLocMark);
                joinedKind := if handler.kind == ir.VALUE_KIND_NEVER {
                    okK
                } else if types.isCompatibleKind(okK, handler.kind) {
                    okK
                } else if types.isCompatibleKind(handler.kind, okK) {
                    handler.kind
                } else {
                    types.buildUnionKind([okK, handler.kind])
                };
                if inferMode {
                    left = ctx.withMarkers((kind = joinedKind, code = "", intValue = 0, textValue = "", constant = false, next = handler.next),
                    ctx.collectParsedMarkers(ctx.collectParsedMarkers("", left), handler));
                    continue;
                }
                if target == ir.TARGET_TS {
                    okExprTS := if okK == ir.VALUE_KIND_UNIT { ir.targetUnitLiteralCode(target) } else { "(" + elVar + " as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v" };
                    convOkTS := ctx.assignReadOnlyArgCode(target, joinedKind, okK, okExprTS);
                    convHdlTS := ctx.assignReadOnlyArgCode(target, joinedKind, handler.kind, handler.code);
                    elseCodeTS := "((" + elVar + ": " + types.tsFunctionType(left.kind) + "): " + types.tsFunctionType(joinedKind) + " => (" + elVar + "._r === 0 ? " + convOkTS + " : " + convHdlTS + "))(" + left.code + ")";
                    left = (kind = joinedKind, code = elseCodeTS, intValue = 0, textValue = "", constant = false, next = handler.next);
                    continue;
                }
                actTag := types.cStructTag(left.kind);
                isFreshSrc := left.code.startsWithAt(0, "/*@CBLK:") or ctx.isCFreshOwnedExpr(left.code);
                srcInitC := if left.code.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(elVar, left.kind, left.code) } else { elVar + " = " + left.code + ";" };
                actDropFn := types.cDropFnForKind(left.kind);
                srcDropC := if isFreshSrc and actDropFn =!= "" { actDropFn + "(&" + elVar + "); " } else { "" };
                fnIdxEl := ctx.findCtxByKindIndex(ctxs, ir.CTX_KIND_FN);
                fnRetKEl := if fnIdxEl >= 0 { ctxs[fnIdxEl].valKind } else { "" };
                if joinedKind == ir.VALUE_KIND_UNIT {
                    hdlRawC := ctx.cUnwrapIntoVar("", handler.kind, handler.code);
                    hdlSafeC := if srcDropC =!= "" { ctx.cRewriteExitDrops(hdlRawC, srcDropC, srcDropC, fnRetKEl, operatorPosition) } else { hdlRawC };
                    okBranchC := if isFreshSrc { elVar + ".tag = -1; " } else { "" };
                    elseCodeC := "/*@CBLK:0@*/{ " + actTag + " " + elVar + "; " + srcInitC + " if (" + elVar + ".tag == 0) { " + okBranchC + "} else { " + hdlSafeC + " " + srcDropC + "} }";
                    left = (kind = ir.VALUE_KIND_UNIT, code = elseCodeC, intValue = 0, textValue = "", constant = false, next = handler.next);
                    continue;
                }
                outElVar := freshCOwnedTemp("lt_eo_");
                okBranchC := if okK == joinedKind {
                    if isFreshSrc {
                        outElVar + " = " + elVar + ".u.ok; " + elVar + ".tag = -1;"
                    } else {
                        outElVar + " = " + ctx.copiedValueCode(target, okK, elVar + ".u.ok") + ";"
                    }
                } else {
                    convOkC := ctx.assignValueCode(target, joinedKind, okK, if okK == ir.VALUE_KIND_UNIT { ir.targetUnitLiteralCode(target) } else { elVar + ".u.ok" });
                    ctx.cUnwrapIntoVar(outElVar, joinedKind, convOkC) + (if srcDropC =!= "" { " " + srcDropC } else { "" })
                };
                hdlBranchC := if handler.kind == ir.VALUE_KIND_NEVER {
                    rawN := ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, handler.code);
                    if srcDropC =!= "" { ctx.cRewriteExitDrops(rawN, srcDropC, srcDropC, fnRetKEl, operatorPosition) } else { rawN }
                } else {
                    convHC := ctx.assignValueCode(target, joinedKind, handler.kind, handler.code);
                    rawHC := ctx.cUnwrapIntoVar(outElVar, joinedKind, convHC);
                    safeHC := if srcDropC =!= "" { ctx.cRewriteExitDrops(rawHC, srcDropC, srcDropC, fnRetKEl, operatorPosition) } else { rawHC };
                    safeHC + (if srcDropC =!= "" { " " + srcDropC } else { "" })
                };
                elseCodeC := "/*@CBLK:" + outElVar + "@*/" + types.cValueType(joinedKind) + " " + outElVar + "; { " + actTag + " " + elVar + "; " + srcInitC + " if (" + elVar + ".tag == 0) { " + okBranchC + " } else { " + hdlBranchC + " } }";
                left = (kind = joinedKind, code = elseCodeC, intValue = 0, textValue = "", constant = false, next = handler.next);
                continue;
            }
        }
        if effectiveMinimum <= 8 and source.at(operatorPosition) == ":" and not source.startsWithAt(operatorPosition, ":=") and
        not source.startsWithAt(operatorPosition, ":/") and not source.startsWithAt(operatorPosition, ":%") {
            tyStart := syntax.skipTrivia(source, operatorPosition + 1, prefix);
            if inferMode {
                emptySeenTT: List<String> = [];
                canResTT := types.canResolveTypeAt(source, tyStart, prefix, aliases, "", emptySeenTT, 32);
                if not canResTT.ok {
                    break;
                }
                left = ctx.withMarkers(ctx.boolParsed("", false, false, canResTT.next), ctx.collectParsedMarkers("", left));
                continue;
            }
            tyTT := types.parseTypeAt(source, tyStart, prefix, aliases, "type test", "");
            if tyTT.kind == ir.VALUE_KIND_NEVER {
                syntax.failAt(source, operatorPosition, prefix, "cannot test type against Never");
            }
            localIdentTT := extractSimpleLocalIdent(source, exprStart, left.next, prefix);
            localIdxTT := if localIdentTT =!= "" { sym.localIndex(locals, localIdentTT) } else { -1 };
            isPlainInitTT := localIdxTT >= 0 and locals[localIdxTT].depth >= -1 and locals[localIdxTT].initState == ir.INIT_STATE_INIT;
            interTT := types.unionIntersect(left.kind, tyTT.kind);
            remTT := types.unionSubtract(left.kind, tyTT.kind);
            var ttCode := "";
            var ttFacts := "";
            if isPlainInitTT {
                locTT := locals[localIdxTT];
                origTT := unwrapUnionOrigin(locTT);
                tFactTT := if interTT =!= "" and interTT =!= locTT.kind { origTT.rt + "\t" + origTT.kind + "\t" + interTT } else { "" };
                fFactTT := if remTT =!= "" and remTT =!= locTT.kind { origTT.rt + "\t" + origTT.kind + "\t" + remTT } else { "" };
                ttFacts = encodeNarrowMeta(tFactTT, fFactTT);
                if interTT == "" {
                    ttCode = ir.targetBoolLiteralCode(target, false);
                } else if remTT == "" or not types.isUnionKind(origTT.kind) {
                    ttCode = ir.targetBoolLiteralCode(target, true);
                } else {
                    interMemsTT := types.unionMembers(interTT);
                    mut condPartsTT: List<String> = [];
                    loop interMemsTT as im {
                        mi := types.unionMemberIndex(origTT.kind, im);
                        if mi >= 0 {
                            if target == ir.TARGET_C {
