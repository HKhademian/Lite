            else if runtime == "lite$core$simd$wrappingAdd:v1" { tPref + simTag + "_wadd(" + receiver.code + ", " + bArg.code + ")" }
            else if runtime == "lite$core$simd$wrappingSub:v1" { tPref + simTag + "_wsub(" + receiver.code + ", " + bArg.code + ")" }
            else if runtime == "lite$core$simd$wrappingMul:v1" { tPref + simTag + "_wmul(" + receiver.code + ", " + bArg.code + ")" }
            else if runtime == "lite$core$simd$bitAnd:v1" { tPref + simTag + "_band(" + receiver.code + ", " + bArg.code + ")" }
            else if runtime == "lite$core$simd$bitOr:v1" { tPref + simTag + "_bor(" + receiver.code + ", " + bArg.code + ")" }
            else if runtime == "lite$core$simd$bitXor:v1" { tPref + simTag + "_bxor(" + receiver.code + ", " + bArg.code + ")" }
            else { simTag + "_dot(" + receiver.code + ", " + bArg.code + ", " + labelStart.toText() + ")" }
        } else {
            tsEl := types.tsFunctionType(elKind);
            if isDot {
                mulBody := tsSimdBinOpCode(elKind, "*", "lite$la", "lite$lb", labelStart);
                redBody := tsSimdBinOpCode(elKind, "+", "lite$la", "lite$lb", labelStart);
                "lite$simdReduce(lite$simdMap2(" + receiver.code + ", " + bArg.code + ", (lite$la: " + tsEl + ", lite$lb: " + tsEl + "): " + tsEl + " => " + mulBody + "), (lite$la: " + tsEl + ", lite$lb: " + tsEl + "): " + tsEl + " => " + redBody + ")"
            } else {
                opBody := if runtime == "lite$core$simd$add:v1" { tsSimdBinOpCode(elKind, "+", "lite$la", "lite$lb", labelStart) }
                else if runtime == "lite$core$simd$sub:v1" { tsSimdBinOpCode(elKind, "-", "lite$la", "lite$lb", labelStart) }
                else if runtime == "lite$core$simd$mul:v1" { tsSimdBinOpCode(elKind, "*", "lite$la", "lite$lb", labelStart) }
                else if runtime == "lite$core$simd$div:v1" { tsSimdBinOpCode(elKind, "/", "lite$la", "lite$lb", labelStart) }
                else if runtime == "lite$core$simd$min:v1" { "(lite$la < lite$lb ? lite$la : lite$lb)" }
                else if runtime == "lite$core$simd$max:v1" { "(lite$la > lite$lb ? lite$la : lite$lb)" }
                else if runtime == "lite$core$simd$wrappingAdd:v1" { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "wrappingAdd", "lite$la", "lite$lb", "", elKind, labelStart, "") }
                else if runtime == "lite$core$simd$wrappingSub:v1" { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "wrappingSub", "lite$la", "lite$lb", "", elKind, labelStart, "") }
                else if runtime == "lite$core$simd$wrappingMul:v1" { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "wrappingMul", "lite$la", "lite$lb", "", elKind, labelStart, "") }
                else if runtime == "lite$core$simd$bitAnd:v1" { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "bitAnd", "lite$la", "lite$lb", "", elKind, labelStart, "") }
                else if runtime == "lite$core$simd$bitOr:v1" { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "bitOr", "lite$la", "lite$lb", "", elKind, labelStart, "") }
                else { ir.targetNumericBuiltinCode(ir.TARGET_TS, elKind, "bitXor", "lite$la", "lite$lb", "", elKind, labelStart, "") };
                "lite$simdMap2(" + receiver.code + ", " + bArg.code + ", (lite$la: " + tsEl + ", lite$lb: " + tsEl + "): " + tsEl + " => " + opBody + ")"
            }
        };
        return ctx.withMarkers((kind = retK, code = binCode, intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime.startsWithAt(0, "lite$core$soa$") {
        recK := types.soaRecordKind(receiver.kind);
        sTag := if target == ir.TARGET_C { types.cSoaTag(receiver.kind) } else { "" };
        firstProp := if types.recordComponentCount(recK) > 0 { types.recordComponent(recK, 0).prop } else { "" };
        if runtime == "lite$core$soa$length:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            lCode := if sTag =!= "" {
                rb := cBorrowExprWithPostDrop(receiver.kind, receiver.code, false);
                mut slDrops: List<String> = [];
                if rb.drop =!= "" { mut slDrops.pushBack(rb.drop); }
                cWrapExprWithPostDrops(ir.VALUE_KIND_INT, "((int64_t)(" + rb.expr + ").len)", slDrops)
            } else { "BigInt((" + receiver.code + ")." + firstProp + ".length)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$isEmpty:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            eCode := if sTag =!= "" {
                rb := cBorrowExprWithPostDrop(receiver.kind, receiver.code, false);
                mut seDrops: List<String> = [];
                if rb.drop =!= "" { mut seDrops.pushBack(rb.drop); }
                cWrapExprWithPostDrops(ir.VALUE_KIND_BOOL, "((" + rb.expr + ").len == 0)", seDrops)
            } else { "((" + receiver.code + ")." + firstProp + ".length === 0)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = eCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$clear:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            clrCode := if sTag =!= "" { sTag + "_clear(&" + mutRt + ")" } else { emitTsSoaClearCode(recK, mutRt) };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = clrCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$popBack:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            popCode := if sTag =!= "" {
                "/*@T:" + recK + "@*/" + sTag + "_pop(&" + mutRt + ", " + labelStart.toText() + ")"
            } else {
                emitTsSoaPopCode(recK, mutRt, labelStart)
            };
            return ctx.withMarkers((kind = recK, code = popCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$reserve:v1" {
            capArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, capArg); }
            if not numeric.isIntKind(capArg.kind) {
                syntax.failAt(source, cursor, prefix, "SoA.reserve expects Int, got " + types.displayKind(capArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, capArg.next, prefix);
            cCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, capArg.kind, capArg.code);
            rCode := if sTag =!= "" {
                sTag + "_reserve(&" + mutRt + ", " + cCode + ", " + labelStart.toText() + ")"
            } else {
                "lite$soaCheckCap(" + cCode + ", " + labelStart.toText() + ")"
            };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = rCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$pushBack:v1" {
            rowArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, recK, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, rowArg); }
            if not types.isCompatibleKind(recK, rowArg.kind) {
                syntax.failAt(source, cursor, prefix, "SoA.pushBack row must be " + types.displayKind(recK) + ", got " + types.displayKind(rowArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, rowArg.next, prefix);
            rowCode := ctx.assignValueCode(target, recK, rowArg.kind, rowArg.code);
            pCode := if sTag =!= "" {
                sTag + "_push(&" + mutRt + ", " + rowCode + ")"
            } else {
                emitTsSoaPushCode(recK, mutRt, rowCode)
            };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = pCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$swapRemove:v1" {
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, "SoA.swapRemove index must be Int, got " + types.displayKind(idxArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, idxArg.next, prefix);
            iCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
            srCode := if sTag =!= "" {
                "/*@T:" + recK + "@*/" + sTag + "_swap_remove(&" + mutRt + ", " + iCode + ", " + labelStart.toText() + ")"
            } else {
                emitTsSoaSwapRemoveCode(recK, mutRt, iCode, labelStart)
            };
            return ctx.withMarkers((kind = recK, code = srCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$get:v1" or runtime == "lite$core$soa$uncheckedGet:v1" {
            isUnchk := runtime == "lite$core$soa$uncheckedGet:v1";
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " index must be Int, got " + types.displayKind(idxArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, idxArg.next, prefix);
            iCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
            gCode := if sTag =!= "" {
                rb := cBorrowExprWithPostDrop(receiver.kind, receiver.code, false);
                mut sgDrops: List<String> = [];
                if rb.drop =!= "" { mut sgDrops.pushBack(rb.drop); }
                fnSuf := if isUnchk { "_uget(" } else { "_get(" };
                cWrapExprWithPostDrops(recK, "/*@T:" + receiver.kind + "@*/" + sTag + fnSuf + rb.expr + ", " + iCode + ", " + labelStart.toText() + ")", sgDrops)
            } else {
                emitTsSoaGetCode(recK, receiver.code, iCode, labelStart, isUnchk)
            };
            return ctx.withMarkers((kind = recK, code = gCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$soa$set:v1" or runtime == "lite$core$soa$uncheckedSet:v1" {
            isUnchk := runtime == "lite$core$soa$uncheckedSet:v1";
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " index must be Int, got " + types.displayKind(idxArg.kind));
            }
            comma := syntax.expectSymbol(source, syntax.skipTrivia(source, idxArg.next, prefix), ",", prefix);
            rStart := syntax.skipTrivia(source, comma, prefix);
            rowArg := parseBinaryCtx(target, source, rStart, prefix, locals, functions, params, currentName, recK, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, rowArg); }
            if not types.isCompatibleKind(recK, rowArg.kind) {
                syntax.failAt(source, rStart, prefix, opLabel + " row must be " + types.displayKind(recK) + ", got " + types.displayKind(rowArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, rowArg.next, prefix);
            iCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
            rowCode := ctx.assignValueCode(target, recK, rowArg.kind, rowArg.code);
            sCode := if sTag =!= "" {
                fnSuf := if isUnchk { "_uset(&" } else { "_set(&" };
                sTag + fnSuf + mutRt + ", " + iCode + ", " + rowCode + ", " + labelStart.toText() + ")"
            } else {
                emitTsSoaSetCode(recK, mutRt, iCode, rowCode, labelStart, isUnchk)
            };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = sCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
    }
    if runtime == "lite$core$text$bytes:v1" {
        close := syntax.expectSymbol(source, cursor, ")", prefix);
        bytesKind := "Slice<UInt8>";
        if receiver.constant {
            cStrLit := cLiteral.textLiteralCode(receiver.textValue);
            bytesCode := if target == ir.TARGET_C {
                "lt_str_bytes_lit(" + cStrLit + ", sizeof(" + cStrLit + ") - 1u)"
            } else {
                "lite$strBytes(" + receiver.code + ")"
            };
            return ctx.withMarkers((kind = bytesKind, code = bytesCode, intValue = 0, textValue = "ro_slice:", constant = false, next = close), markers);
        }
        strRootIdx := extractAddressableLocal(locals, receiver.code);
        if strRootIdx < 0 {
            syntax.failAt(source, labelStart, prefix, "String.bytes() requires an addressable String binding or string literal");
        }
        rEntry := locals[strRootIdx];
        bytesProv := sliceBorrows.makeSliceProvenance("ro_slice", rEntry.runtime, rEntry.depth, rEntry.name, rEntry.textValue);
        bytesCode := if target == ir.TARGET_C {
            "lt_str_bytes(&(" + receiver.code + "))"
        } else {
            "lite$strBytes(" + receiver.code + ")"
        };
        return ctx.withMarkers((kind = bytesKind, code = bytesCode, intValue = 0, textValue = bytesProv, constant = false, next = close), markers);
    }
    syntax.failAt(source, labelStart, prefix, "unsupported hard builtin type operation " + opLabel);
    ctx.intParsed("", 0, false, openParen)
};

/** True when `opName` is a hard-builtin numeric method on integer/float type `kind`. */
isNumericHardBuiltin := fn(kind: String, opName: String, isStatic: Bool): Bool {
    if numeric.isFloatKind(kind) {
        if opName == "toBits" { return kind == numeric.KIND_FLOAT32 or kind == numeric.KIND_FLOAT; }
        if opName == "fromBits" or opName == "uncheckedFromBits" { return isStatic and (kind == numeric.KIND_FLOAT32 or kind == numeric.KIND_FLOAT); }
        return opName == "uncheckedAdd" or opName == "uncheckedSub" or opName == "uncheckedMul" or opName == "uncheckedDiv" or opName == "fma" or opName == "uncheckedFma";
    }
    if not numeric.isIntKind(kind) { return false; }
    if opName == "uncheckedTruncate" { return isStatic; }
    opName == "bitAnd" or opName == "bitOr" or opName == "bitXor" or opName == "bitNot" or
    opName == "shiftLeft" or opName == "shiftRight" or opName == "rotateLeft" or opName == "rotateRight" or
    opName == "wrappingAdd" or opName == "wrappingSub" or opName == "wrappingMul" or opName == "wrappingNeg" or
    opName == "saturatingAdd" or opName == "saturatingSub" or opName == "saturatingMul" or
    opName == "uncheckedAdd" or opName == "uncheckedSub" or opName == "uncheckedMul" or opName == "uncheckedDiv" or
    opName == "uncheckedRem" or opName == "uncheckedNeg" or opName == "uncheckedShiftLeft" or opName == "uncheckedShiftRight" or
    opName == "countOnes" or opName == "leadingZeros" or opName == "trailingZeros" or
    opName == "byteSwap" or opName == "wideningMul"
};

/** Parses arguments and lowers one hard-builtin numeric static (`T.op(...)`) or instance (`x.op(...)`) call. */
parseNumericHardBuiltin := fn(
target: String, source: String, memberStart: Int, prefix: String,
kind: String, opName: String, hasReceiver: Bool, receiver: Parsed,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>
): Parsed {
    if not inferMode and opName == "byteSwap" and numeric.isSubByteIntKind(kind) {
        syntax.failAt(source, memberStart, prefix, "byteSwap requires an 8-, 16-, 32-, or 64-bit integer type, got " + types.displayKind(kind));
    }
    memberEnd := source.skipName(memberStart);
    openParen := syntax.expectSymbol(source, syntax.skipTrivia(source, memberEnd, prefix), "(", prefix);
    isBitsIn := opName == "fromBits" or opName == "uncheckedFromBits";
    bitsKind := if kind == numeric.KIND_FLOAT32 { numeric.KIND_UINT32 } else { numeric.KIND_UINT64 };
    isUnary := opName == "bitNot" or opName == "wrappingNeg" or opName == "uncheckedNeg" or opName == "uncheckedTruncate" or opName == "countOnes" or opName == "leadingZeros" or opName == "trailingZeros" or opName == "byteSwap" or opName == "toBits" or isBitsIn;
    isShift := opName == "shiftLeft" or opName == "shiftRight" or opName == "rotateLeft" or opName == "rotateRight" or opName == "uncheckedShiftLeft" or opName == "uncheckedShiftRight";
    isFma := opName == "fma" or opName == "uncheckedFma";
    var cursor := syntax.skipTrivia(source, openParen, prefix);
    var markers := if inferMode and hasReceiver { ctx.collectParsedMarkers("", receiver) } else { "" };
    var a0 := if hasReceiver { receiver } else { (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = cursor) };
    if not hasReceiver {
        exp0 := if opName == "uncheckedTruncate" { "" } else if isBitsIn { bitsKind } else { kind };
        p0 := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, exp0, 0, ctxs, iifeDepth, inferMode, "", aliases);
        a0 = p0;
        if inferMode { markers = ctx.collectParsedMarkers(markers, a0); }
        if not inferMode {
            if opName == "uncheckedTruncate" {
                if not numeric.isFloatKind(a0.kind) {
                    syntax.failAt(source, cursor, prefix, kind + ".uncheckedTruncate expects a Float operand, got " + types.displayKind(a0.kind));
                }
            } else if not types.isCompatibleKind(exp0, a0.kind) {
                syntax.failAt(source, cursor, prefix, kind + "." + opName + " expects " + types.displayKind(exp0) + ", got " + types.displayKind(a0.kind));
            }
        }
        cursor = syntax.skipTrivia(source, a0.next, prefix);
    }
    var a1 := (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = cursor);
    var a2 := (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = cursor);
    if not isUnary {
        if not hasReceiver {
            cursor = syntax.skipTrivia(source, syntax.expectSymbol(source, cursor, ",", prefix), prefix);
        }
        exp1 := if isShift { ir.VALUE_KIND_INT } else { kind };
        p1 := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, exp1, 0, ctxs, iifeDepth, inferMode, "", aliases);
        a1 = p1;
        if inferMode { markers = ctx.collectParsedMarkers(markers, a1); }
        if not inferMode {
            if isShift {
                if not numeric.isIntKind(a1.kind) {
                    syntax.failAt(source, cursor, prefix, opName + " shift amount must be Int, got " + types.displayKind(a1.kind));
                }
            } else if not types.isCompatibleKind(kind, a1.kind) {
                syntax.failAt(source, cursor, prefix, kind + "." + opName + " expects " + types.displayKind(kind) + ", got " + types.displayKind(a1.kind));
            }
        }
        cursor = syntax.skipTrivia(source, a1.next, prefix);
    }
    if isFma {
        cursor = syntax.skipTrivia(source, syntax.expectSymbol(source, cursor, ",", prefix), prefix);
        p2 := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, kind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        a2 = p2;
        if inferMode { markers = ctx.collectParsedMarkers(markers, a2); }
        if not inferMode and not types.isCompatibleKind(kind, a2.kind) {
            syntax.failAt(source, cursor, prefix, kind + "." + opName + " expects " + types.displayKind(kind) + ", got " + types.displayKind(a2.kind));
        }
        cursor = syntax.skipTrivia(source, a2.next, prefix);
    }
    closeParen := syntax.expectSymbol(source, cursor, ")", prefix);
    retKind := if opName == "countOnes" or opName == "leadingZeros" or opName == "trailingZeros" { ir.VALUE_KIND_INT }
    else if opName == "toBits" { bitsKind }
    else if opName == "wideningMul" { "(lo:" + kind + ",hi:" + kind + ")" }
    else { kind };
    if inferMode {
        return ctx.withMarkers((kind = retKind, code = "", intValue = 0, textValue = "", constant = false, next = closeParen), markers);
    }
    expCast0 := if isBitsIn { bitsKind } else { kind };
    a0Code := if opName == "uncheckedTruncate" or a0.kind == expCast0 or not numeric.isNumericKind(a0.kind) { a0.code }
    else { ir.targetNumericCastCode(target, expCast0, a0.kind, a0.code, memberStart) };
    a1Code := if isUnary or isShift or a1.kind == kind or not numeric.isNumericKind(a1.kind) { a1.code }
    else { ir.targetNumericCastCode(target, kind, a1.kind, a1.code, memberStart) };
    a2Code := if not isFma or a2.kind == kind or not numeric.isNumericKind(a2.kind) { a2.code }
    else { ir.targetNumericCastCode(target, kind, a2.kind, a2.code, memberStart) };
    tupleTag := if opName == "wideningMul" and target == ir.TARGET_C { types.cStructTag(retKind) } else { "" };
    outCode := ir.targetNumericBuiltinCode(target, kind, opName, a0Code, a1Code, a2Code, a0.kind, memberStart, tupleTag);
    (kind = retKind, code = outCode, intValue = 0, textValue = "", constant = false, next = closeParen)
};

/** Finds an instance or static type-attached operation registered for `ownerKey.opName`, or -1. */
findTypeOp := fn(functions: List<FunctionInfo>, ownerKey: String, opName: String): Int {
    inst := sym.findFunction(functions, "$typeop:" + ownerKey + "." + opName);
    if inst >= 0 { return inst; }
    sym.findFunction(functions, "$statictypeop:" + ownerKey + "." + opName)
};

/** Returns all instance and static type-operation candidate indices registered for `ownerKey.opName` (nominal and scoped aliases). */
findAllTypeOps := fn(functions: List<FunctionInfo>, ownerKey: String, opName: String): List<Int> {
    mut out: List<Int> = sym.findFunctions(functions, "$typeop:" + ownerKey + "." + opName);
    loop sym.findFunctions(functions, "$statictypeop:" + ownerKey + "." + opName) as si {
        mut out.pushBack(si);
    }
    out
};

/** Returns nominal type ops for `ownerKey` plus visible scoped alias ops matching concrete `targetKind` or generic `aliasTplKind`. */
findAllTypeOpsForKind := fn(functions: List<FunctionInfo>, ownerKey: String, targetKind: String, aliasTplKind: String, opName: String): List<Int> {
    mut out: List<Int> = if ownerKey =!= "" { findAllTypeOps(functions, ownerKey, opName) } else { [] };
    mut seenRts: List<String> = [];
    loop out as oi {
        if functions[oi].runtime =!= "" { mut seenRts.pushBack(functions[oi].runtime); }
    }
    tabOp := "\t" + opName;
    var fi := 0;
    loop functions as f {
        if ir.isAliasOpKey(f.name) and f.name.endsWith(tabOp) and not seenRts.contains(f.runtime) {
            ak := ir.parseAliasOpKey(f.name);
            if ak.ok and ak.opName == opName {
                var matched := false;
                if targetKind =!= "" {
                    if ak.targetKind == targetKind {
                        matched = true;
                    } else if ak.targetKind.startsWithAt(0, "@gentpl:") {
                        pDec := types.decodeLengthPrefixedAt(ak.targetKind, 8);
                        if pDec.next >= 0 {
                            tplBody := ak.targetKind.slice(pDec.next, ak.targetKind.length());
                            mut tmpB: Map<String, String>;
                            if generics.unifyKindMut(pDec.text, tplBody, targetKind, mut tmpB) == "" {
                                matched = true;
                            }
                        }
                    }
                } else if aliasTplKind =!= "" and ak.targetKind == aliasTplKind {
                    matched = true;
                } else if aliasTplKind =!= "" and ak.targetKind.startsWithAt(0, "@gentpl:") {
                    pDec2 := types.decodeLengthPrefixedAt(ak.targetKind, 8);
                    if pDec2.next >= 0 and ak.targetKind.slice(pDec2.next, ak.targetKind.length()) == aliasTplKind {
                        matched = true;
                    }
                }
                if matched {
                    if f.runtime =!= "" { mut seenRts.pushBack(f.runtime); }
                    mut out.pushBack(fi);
                }
            }
        }
        fi = fi + 1;
    }
    out
};

/** Looks up a static `Type.PROP` or `Alias.PROP` local entry by explicit qualified name, nominal owner key, or scoped alias target kind. */
findStaticTypeProperty := fn(source: String, errPos: Int, prefix: String, locals: List<Local>, qualName: String, ownerKey: String, targetKind: String, propName: String, inferMode: Bool): Int {
    if qualName =!= "" {
        qIdx := sym.localIndex(locals, qualName);
        if qIdx >= 0 { return qIdx; }
    }
    if ownerKey =!= "" {
        tIdx := sym.localIndex(locals, "$typeprop:" + ownerKey + "." + propName);
        if tIdx >= 0 { return tIdx; }
    }
    if targetKind =!= "" {
        suffix := "\t" + targetKind + "\t" + propName;
        var hitIdx := -1;
        var hitRuntime := "";
        var li := 0;
        loop locals as loc {
            if loc.name.startsWithAt(0, "$aliasprop:") and loc.name.endsWith(suffix) {
                if hitIdx < 0 {
                    hitIdx = li;
                    hitRuntime = loc.runtime;
                } else if loc.runtime =!= hitRuntime and not inferMode {
                    syntax.failAt(source, errPos, prefix, "ambiguous contextual ." + propName + "; qualify with explicit alias name");
                }
            }
            li = li + 1;
        }
        if hitIdx >= 0 { return hitIdx; }
    }
    -1
};

/** True when a type-attached operation is static/type-level (declared without an explicit `Self` receiver first parameter). */
isStaticTypeOp := fn(opInfo: FunctionInfo): Bool {
    opInfo.name.startsWithAt(0, "$statictypeop:") or opInfo.name.startsWithAt(0, "$staticaliasop:")
};

/** Validates a type-qualified `Type.op` or `Alias.op` reference and extracts pre-bound generic arguments. */
resolveTypeQualifiedOp := fn(
source: String, memberStart: Int, prefix: String,
opIdx: Int, memberName: String, typeOwnerKey: String,
resolvedType: String, aliasParamsCsv: String, aliasTplKind: String,
functions: List<FunctionInfo>, params: List<String>, inferMode: Bool
): (ok: Bool, initBindings: String) {
    opInfo := functions[opIdx];
    targetKind := if resolvedType =!= "" { resolvedType } else { aliasTplKind };
    targetParamsCsv := if resolvedType =!= "" { "" } else { aliasParamsCsv };
    if targetKind == "" { return (ok = true, initBindings = ""); }
    if opInfo.runtime == "lite$core$rc$create:v1" {
        return (ok = true, initBindings = types.rcElementKind(targetKind));
    }
    if opInfo.runtime.startsWithAt(0, "lite$core$simd$") or opInfo.runtime.startsWithAt(0, "lite$core$soa$") {
        return (ok = true, initBindings = targetKind);
    }
    isStatic := isStaticTypeOp(opInfo);
    if opInfo.runtime.startsWithAt(0, "$gen:") {
        tpl := generics.getTemplate(generics.findTemplate(opInfo.runtime.slice(5, opInfo.runtime.length())));
        mut rawB: Map<String, String>;
        if not isStatic {
            rawRecv := types.paramKindOf(params[opInfo.first]);
            baseRecv := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
            if generics.unifyKindMut(tpl.genericParams, baseRecv, targetKind, mut rawB) =!= "" {
                if targetParamsCsv == "" {
                    if inferMode { return (ok = false, initBindings = ""); }
                    syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(baseRecv) + ", got " + types.displayKind(targetKind));
                }
            }
        } else if types.typeOpOwnerKey(opInfo.result) == typeOwnerKey {
            if generics.unifyKindMut(tpl.genericParams, opInfo.result, targetKind, mut rawB) =!= "" {
                if targetParamsCsv == "" {
                    if inferMode { return (ok = false, initBindings = ""); }
                    syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(opInfo.result) + ", got " + types.displayKind(targetKind));
                }
            }
        } else if tpl.selfTarget.startsWithAt(0, "@gentpl:") {
            pDec := types.decodeLengthPrefixedAt(tpl.selfTarget, 8);
            ownerParamsCsv := pDec.text;
            ownerTplKind := tpl.selfTarget.slice(pDec.next, tpl.selfTarget.length());
            mut ownerB: Map<String, String>;
            _oErr := generics.unifyKindMut(ownerParamsCsv, ownerTplKind, targetKind, mut ownerB);
            loop types.splitParamSpecs(tpl.genericParams) as sp {
                if ownerB.has(sp.name) {
                    mut rawB.set(sp.name, ownerB.getOr(sp.name, ""));
                }
            }
        }
        mut cleanB: Map<String, String>;
        loop types.splitParamSpecs(tpl.genericParams) as sp {
            if rawB.has(sp.name) {
                boundVal := rawB.getOr(sp.name, "");
                if targetParamsCsv == "" or not types.kindHasAnyGenericParam(targetParamsCsv, boundVal) {
                    mut cleanB.set(sp.name, boundVal);
                }
            }
        }
        cErr := findGenericConstraintError(tpl.genericParams, cleanB, "");
        if cErr =!= "" {
            if inferMode { return (ok = false, initBindings = ""); }
            syntax.failAt(source, memberStart, prefix, cErr);
        }
        return (ok = true, initBindings = generics.encodePartialBindings(tpl.genericParams, cleanB));
    }
    if resolvedType =!= "" and not inferMode {
        if not isStatic {
            rawRecv := types.paramKindOf(params[opInfo.first]);
            baseRecv := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
            if not types.isCompatibleKind(baseRecv, resolvedType) {
                syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(baseRecv) + ", got " + types.displayKind(resolvedType));
            }
        } else if types.typeOpOwnerKey(opInfo.result) == typeOwnerKey and not types.isCompatibleKind(opInfo.result, resolvedType) {
            syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(opInfo.result) + ", got " + types.displayKind(resolvedType));
        }
    }
    (ok = true, initBindings = "")
};

/** True when a `lite$*` type-operation runtime is lowered inline by `parseCoreTypeOpHardCall` rather than called as a regular host function. */
isHardBuiltinTypeOpRuntime := fn(runtime: String): Bool {
    runtime == "lite$textLength" or runtime == "lite$textAt" or runtime == "lite$textSlice" or
    runtime == "lite$core$text$bytes:v1" or
    runtime.startsWithAt(0, "lite$core$array$") or
    runtime.startsWithAt(0, "lite$core$list$") or
    runtime.startsWithAt(0, "lite$core$map$") or
    runtime.startsWithAt(0, "lite$core$set$") or
    runtime.startsWithAt(0, "lite$core$rc$") or
    runtime.startsWithAt(0, "lite$core$slice$") or
    runtime.startsWithAt(0, "lite$core$simd$") or
    runtime.startsWithAt(0, "lite$core$soa$")
};

/** Parses a type-attached dot call `receiver.op(args...)`, validating explicit call-site `mut` lease, `mut Self` permission, unifying generic receivers, and forwarding receiver as argument 0. */
parseTypeOpDotCall := fn(target: String, source: String, labelStart: Int, openParen: Int, receiver: Parsed, recvLocalIdx: Int, opIdx: Int, opLabel: String, explicitMut: Bool, recvFieldPath: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    info := functions[opIdx];
    if isStaticTypeOp(info) {
        syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " is a type-level operation with no Self receiver; call it on the type instead");
    }
    recvExpected := types.paramKindOf(params[info.first]);
    isMutRecv := recvExpected.startsWithAt(0, "mut ");
    baseExpected := if isMutRecv { recvExpected.slice(4, recvExpected.length()) } else { recvExpected };
    isSplitAt := info.runtime == "lite$core$slice$splitAt:v1";
    if (isMutRecv or isSplitAt) and explicitMut {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
        }
    }
    if isMutRecv and not explicitMut {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
        }
        syntax.failAt(source, labelStart, prefix, "mutating operation " + types.displayKind(receiver.kind) + "." + opLabel + " requires mut at call site");
    }
    if not isMutRecv and not isSplitAt and explicitMut {
        syntax.failAt(source, labelStart, prefix, "operation " + types.displayKind(receiver.kind) + "." + opLabel + " does not mutate its receiver; remove mut");
    }
    if isHardBuiltinTypeOpRuntime(info.runtime) {
        return parseCoreTypeOpHardCall(target, source, labelStart, openParen, receiver, recvLocalIdx, info.runtime, opLabel, isMutRecv or (isSplitAt and explicitMut), prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    isGenOp := info.runtime.startsWithAt(0, "$gen:");
    var initGenBindings := "";
    var concreteRecvExpected := baseExpected;
    if isGenOp {
        tplKey := info.runtime.slice(5, info.runtime.length());
        tplIdx := generics.findTemplate(tplKey);
        if tplIdx < 0 {
            syntax.failAt(source, labelStart, prefix, "internal error: missing generic template " + tplKey);
        }
        tpl := generics.getTemplate(tplIdx);
        mut recvBindings: Map<String, String>;
        uErr := generics.unifyKindMut(tpl.genericParams, baseExpected, receiver.kind, mut recvBindings);
        if uErr =!= "" {
            syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " requires " + types.displayKind(baseExpected) + ", got " + types.displayKind(receiver.kind));
        }
        cErr := findGenericConstraintError(tpl.genericParams, recvBindings, "");
        if cErr =!= "" {
            if inferMode {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = labelStart);
            }
            syntax.failAt(source, labelStart, prefix, cErr);
        }
        initGenBindings = generics.encodePartialBindings(tpl.genericParams, recvBindings);
        concreteRecvExpected = generics.substKind(tpl.genericParams, baseExpected, recvBindings);
    } else {
        if not types.isCompatibleKind(baseExpected, receiver.kind) {
            syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " requires " + types.displayKind(baseExpected) + ", got " + types.displayKind(receiver.kind));
        }
    }
    var recvCode := "";
    var recvWritebackLocal := "";
    var recvWritebackBox := "";
    var recvWritebackStmt := "";
    var recvWritebackKind := "";
    var recvRootRt := "";
    if isMutRecv {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
        }
        locEntry := locals[recvLocalIdx];
        recvRootRt = locEntry.runtime;
        if target == ir.TARGET_C {
            recvCode = if recvFieldPath == "" { "&" + locEntry.runtime } else { "&(" + receiver.code + ")" };
        } else if types.isRecordOrDistinctRecord(receiver.kind) {
            if recvFieldPath =!= "" {
                recvWritebackBox = "lite$mb_recv";
                recvWritebackLocal = receiver.code;
                recvWritebackStmt = tsFieldWritebackStmt(locEntry.runtime, recvFieldPath, "lite$nv");
                recvWritebackKind = receiver.kind;
                recvCode = recvWritebackBox;
            } else if locEntry.runtime.endsWith(".v") {
                recvCode = locEntry.runtime.slice(0, locEntry.runtime.length() - 2);
            } else {
                recvWritebackBox = "lite$mb_recv";
                recvWritebackLocal = locEntry.runtime;
                recvWritebackKind = receiver.kind;
                recvCode = recvWritebackBox;
            }
        } else {
            recvCode = receiver.code;
        }
    } else {
        var recvParamHazard := localsHasLocalClosure(locals);
        var rpIdx := 1;
        loop rpIdx < info.count {
            rpKind := types.paramKindOf(params[info.first + rpIdx]);
            rpBase := if rpKind.startsWithAt(0, "mut ") { rpKind.slice(4, rpKind.length()) } else { rpKind };
            if rpKind.startsWithAt(0, "mut ") or types.containsFnKind(rpKind) or types.isDynKind(rpBase) {
                recvParamHazard = true;
                break;
            }
            rpIdx += 1;
        }
        emptyMutRts: List<String> = [];
        recvMutGlobalHazard := calleeCanMutateGlobals(true, info.runtime, contexts.fnContextFor(info.runtime));
        recvNeedsSnap := readOnlyArgNeedsSnapshot(receiver.code, locals, emptyMutRts, recvParamHazard, recvMutGlobalHazard);
        recvCode = ctx.readOnlyArgWithSnapshot(target, concreteRecvExpected, receiver.kind, receiver.code, recvNeedsSnap);
    }
    calleeDisp := types.displayKind(receiver.kind) + "." + opLabel;
    callRes := parseUserOrIndirectCallWithRecv(target, source, openParen, labelStart, true, calleeDisp, info.runtime, params, info.first + 1, info.count - 1, info.result, contexts.fnContextFor(info.runtime), true, recvCode, recvWritebackLocal, recvWritebackBox, recvWritebackStmt, recvWritebackKind, recvRootRt, initGenBindings, callExpectedRet, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    if inferMode {
        return ctx.withMarkers(callRes, ctx.collectParsedMarkers(ctx.collectParsedMarkers("", receiver), callRes));
    }
    callRes
};

/** Parses an explicit mutating dot call `mut receiver(.field)*.op(args...)` or `(mut receiver).op(args...)`, enforcing root receiver mutability and `mut Self` signature. */
parseMutReceiverCallExpr := fn(target: String, source: String, mutStart: Int, mNameStart: Int, mNameEnd: Int, afterRecv: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    rawRecvName := source.slice(mNameStart, mNameEnd);
    recvRes := resolveMutLeaseLocal(locals, ctxs, rawRecvName, source, mNameStart, prefix);
    recvName := recvRes.displayName;
    recvIdx := recvRes.idx;
    entry := locals[recvIdx];
    if entry.initState =!= ir.INIT_STATE_INIT {
        syntax.failAt(source, mNameStart, prefix, "cannot read uninitialized local " + recvName);
    }
    _mutPos := mutStart;
    var curKind := entry.kind;
    var curCode := entry.runtime;
    mut fieldPath: List<String> = [];
    var pos := afterRecv;
    loop true {
        dotPos := syntax.skipTrivia(source, pos, prefix);
        if dotPos < size and source.at(dotPos) == "[" and isBracketRangeSlice(source, dotPos, prefix) {
            if not types.isListKind(curKind) and not types.isArrayKind(curKind) and not types.isSliceKind(curKind) {
                syntax.failAt(source, dotPos, prefix, "mutable bracket slicing requires a List, fixed Array, or Slice, got " + types.displayKind(curKind));
            }
            canMutSlice := if types.isArrayKind(curKind) { entry.mutable or entry.writable } else { entry.writable };
            if not canMutSlice {
                syntax.failAt(source, mNameStart, prefix, "cannot take mutable slice of read-only binding " + recvName);
            }
            sliceBorrows.checkCanMutateBinding(locals, entry.runtime, recvName, source, mNameStart, prefix);
            bounds := parseBracketSliceBounds(target, source, dotPos, "", prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
            elKind := if types.isListKind(curKind) { types.listElementKind(curKind) }
            else if types.isArrayKind(curKind) { types.arrayElementKind(curKind) }
            else { types.sliceElementKind(curKind) };
            mutSliceCode := emitZeroCopySliceExpr(target, dotPos, curKind, curCode, bounds.hasEnd, bounds.startCode, bounds.endCode, bounds.indexStart, prefix, source);
            mutProv := sliceBorrows.makeSliceProvenance("mut_slice", entry.runtime, entry.depth, recvName, entry.textValue);
            return ctx.withMarkers((kind = "Slice<" + elKind + ">", code = mutSliceCode, intValue = 0, textValue = mutProv, constant = false, next = bounds.closeNext), bounds.markers);
        }
        if dotPos >= size or source.at(dotPos) =!= "." {
            if fieldPath.length() == 0 and types.isDynKind(normalizeExpectedValueKind(expected)) {
                if not entry.writable {
                    syntax.failAt(source, mNameStart, prefix, "cannot take mut dyn borrow of read-only binding " + recvName);
                }
                sliceBorrows.checkCanMutateBinding(locals, entry.runtime, recvName, source, mNameStart, prefix);
                rawIdProv := sliceBorrows.sliceIdentifierProvenance(entry.runtime, entry.depth, recvName, entry.textValue);
                prov := if types.isSliceKind(entry.kind) or types.isDynKind(entry.kind) {
                    "mut_dyn:" + rawIdProv.slice(9, rawIdProv.length())
                } else {
                    "mut_dyn:" + entry.runtime + "#" + entry.depth.toText() + "#" + recvName
                };
                return (kind = curKind, code = curCode, intValue = entry.intValue, textValue = prov, constant = false, next = pos);
            }
            if fieldPath.length() == 0 {
                syntax.failAt(source, dotPos, prefix, "expected .operation(...) after mut " + recvName);
            }
            syntax.failAt(source, dotPos, prefix, "expected .operation(...) after mut " + recvName + "." + fieldPath.join("."));
        }
        labelStart := syntax.skipTrivia(source, dotPos + 1, prefix);
        if labelStart < size and source.at(labelStart) == "$" {
            hookEnd := if labelStart + 1 < size and source.at(labelStart + 1).isNameStart() {
                source.skipName(labelStart + 1)
            } else {
                labelStart + 1
            };
            syntax.failAt(source, labelStart, prefix, "compiler hook " + source.slice(labelStart, hookEnd) + " cannot be called directly; use [...] indexing");
        }
        var label := "";
        var labelEnd := labelStart;
        if labelStart < size and source.at(labelStart) == "\"" and types.isRecordKind(curKind) {
            qLbl := syntax.parseText(target, source, labelStart, prefix);
            label = qLbl.textValue;
            labelEnd = qLbl.next;
        } else if labelStart < size and source.at(labelStart).isNameStart() {
            labelEnd = source.skipName(labelStart);
            label = source.slice(labelStart, labelEnd);
        } else {
            if fieldPath.length() == 0 {
                syntax.failAt(source, labelStart, prefix, "expected operation name after mut " + recvName + ".");
            }
            syntax.failAt(source, labelStart, prefix, "expected operation name after mut " + recvName + "." + fieldPath.join(".") + ".");
        }
        afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
        if afterLabel < size and source.at(afterLabel) == "." {
            if not types.isRecordKind(curKind) and not types.isTupleKind(curKind) {
                syntax.failAt(source, labelStart, prefix, "cannot access field " + label + " on " + types.displayKind(curKind));
            }
            nextKind := if types.isRecordKind(curKind) { types.recordFieldKind(curKind, label) } else { types.tupleFieldKind(curKind, label) };
            if nextKind == "" {
                syntax.failAt(source, labelStart, prefix, "type " + types.displayKind(curKind) + " has no field " + label);
            }
            if target == ir.TARGET_C and types.cStructTag(curKind) == "" {
                syntax.failAt(source, labelStart, prefix, "C backend does not support record field mutation on " + types.displayKind(curKind));
            }
            rawProp := if types.isRecordKind(curKind) { types.recordComponentProp(curKind, label) } else { label };
            fProp := if target == ir.TARGET_C { types.cFieldName(rawProp) } else { rawProp };
            curCode = if target == ir.TARGET_C { "(" + curCode + ")." + fProp } else { types.tsRecordFieldAccess(curCode, label) };
            curKind = nextKind;
            mut fieldPath.pushBack(label);
            pos = afterLabel;
            continue;
        }
        if types.isSoaKind(curKind) and (afterLabel >= size or source.at(afterLabel) =!= "(") {
            col := soaColInfo(curKind, label);
            if col.idx < 0 {
                syntax.failAt(source, labelStart, prefix, "SoA<" + types.recordDisplayName(types.soaRecordKind(curKind)) + "> has no field or operation " + label);
            }
            if not entry.writable {
                syntax.failAt(source, mNameStart, prefix, "cannot take mutable column slice of read-only binding " + recvName);
            }
            sliceBorrows.checkCanMutateColumn(locals, entry.runtime, label, recvName, source, mNameStart, prefix);
            colSliceCode := emitSoaColumnSliceCode(target, curKind, curCode, col.idx, col.prop, col.kind);
            colProv := sliceBorrows.makeColumnSliceProvenance("mut_slice", entry.runtime, entry.depth, recvName, entry.textValue, label);
            return (kind = "Slice<" + col.kind + ">", code = colSliceCode, intValue = 0, textValue = colProv, constant = false, next = labelEnd);
        }
        if types.isDynKind(curKind) {
            if afterLabel >= size or source.at(afterLabel) =!= "(" {
                syntax.failAt(source, labelStart, prefix, "dyn interface method " + label + " must be called with (...)");
            }
            recvParsed := (kind = curKind, code = curCode, intValue = entry.intValue, textValue = entry.textValue, constant = false, next = pos);
            return parseDynMethodDotCall(target, source, labelStart, afterLabel, recvParsed, recvIdx, label, true, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
        }
        ownerKey := types.typeOpOwnerKey(curKind);
        opCands := findAllTypeOpsForKind(functions, ownerKey, curKind, "", label);
        var opIdx := if opCands.length() > 0 { opCands[0] } else { -1 };
        if opIdx < 0 {
            emptyIfaces: List<String> = [];
            im := types.findImplMethodForConcrete(curKind, label, emptyIfaces);
            if im.ambiguous {
                syntax.failAt(source, labelStart, prefix, "ambiguous method " + label + " on " + types.displayKind(curKind) + "; multiple interface impls provide it");
            }
            if im.found {
                opIdx = if im.fnKey.startsWithAt(0, "$rt:") {
                    sym.findFunctionByRuntime(functions, im.fnKey.slice(4, im.fnKey.length()))
                } else {
                    sym.findFunction(functions, im.fnKey)
                };
            }
        }
        if opIdx < 0 {
            syntax.failAt(source, labelStart, prefix, "type " + types.displayKind(curKind) + " has no operation " + label);
        }
        if afterLabel >= size or source.at(afterLabel) =!= "(" {
            syntax.failAt(source, labelStart, prefix, "type operation " + types.displayKind(curKind) + "." + label + " must be called with (...)");
        }
        if opCands.length() > 1 {
            selOp := selectOverloadForCall(
            target, source, afterLabel, labelStart, prefix, types.displayKind(curKind) + "." + label,
            opCands, true, curKind, true,
            false, ownerKey, label, curKind, "", "", labelStart,
            locals, functions, params, currentName, ctxs, iifeDepth, aliases
            );
            opIdx = selOp.chosenIdx;
        }
        sliceBorrows.checkCanMutateBinding(locals, entry.runtime, recvName, source, mNameStart, prefix);
        recvParsed := (kind = curKind, code = curCode, intValue = entry.intValue, textValue = entry.textValue, constant = false, next = pos);
        return parseTypeOpDotCall(target, source, labelStart, afterLabel, recvParsed, recvIdx, opIdx, label, true, fieldPath.join("."), expected, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    ctx.intParsed("", 0, false, afterRecv)
};

/** Parses postfix `.field`, `[index]`, list-intrinsic operations, type-attached dot calls, and function/indirect calls on `initialLeft`. */
parsePostfixChain := fn(target: String, source: String, exprStart: Int, initialLeft: Parsed, expected: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var left := initialLeft;
    var recvLocalIdx := findLocalIndexByRuntime(locals, left.code);
    loop true {
        if left.next > 0 and source.at(left.next - 1) == "}" { break; }
        postPosition := syntax.skipTrivia(source, left.next, prefix);
        sourceLen := source.length();
        if postPosition < sourceLen and source.at(postPosition) == "." {
            curRecvLocalIdx := recvLocalIdx;
            recvLocalIdx = -1;
            labelStart := syntax.skipTrivia(source, postPosition + 1, prefix);
            if labelStart < sourceLen and source.at(labelStart).isDigit() {
                var end := labelStart;
                var fieldIndex := 0;
                loop end < sourceLen and source.at(end).isDigit() {
                    fieldIndex = fieldIndex * 10 + syntax.decimalDigit(source.at(end));
                    end = end + 1;
                }
                if types.isArrayKind(left.kind) {
                    if fieldIndex >= types.arrayExtent(left.kind) {
                        syntax.failAt(source, labelStart, prefix, "array index " + source.slice(labelStart, end) + " out of bounds");
                    }
                    arrElKind := types.arrayElementKind(left.kind);
                    arrElemCode := if target == ir.TARGET_C and types.cArrayTag(left.kind) =!= "" {
                        if numeric.isSubByteIntKind(arrElKind) {
                            types.cArrayTag(left.kind) + "_get_raw(" + left.code + ", " + fieldIndex.toText() + ")"
                        } else {
                            "((" + left.code + ").data[" + fieldIndex.toText() + "])"
                        }
                    } else if target == ir.TARGET_C and types.cListTag(arrElKind) =!= "" {
                        "lt_list_" + types.cListTag(arrElKind) + "_at(" + left.code + ", " + fieldIndex.toText() + ", " + postPosition.toText() + ")"
                    } else {
                        "(" + left.code + ")[" + fieldIndex.toText() + "]!"
                    };
                    left = ctx.withMarkers((kind = arrElKind, code = arrElemCode,
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                } else if types.isEnumKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "enum values do not support positional field access ." + source.slice(labelStart, end));
                } else if types.isRecordKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "record values do not support positional field access ." + source.slice(labelStart, end));
                } else if not types.isTupleKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "field access requires a tuple or module value");
                } else {
                    comp := types.tupleComponent(left.kind, fieldIndex);
                    if comp.kind == "" {
                        syntax.failAt(source, labelStart, prefix, "tuple has no field " + source.slice(labelStart, end));
                    }
                    tProp := if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop };
                    left = ctx.withMarkers((kind = comp.kind, code = "(" + left.code + ")." + tProp,
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                }
            } else if labelStart < source.length() and source.at(labelStart) == "$" {
                hookEnd := if labelStart + 1 < source.length() and source.at(labelStart + 1).isNameStart() {
                    source.skipName(labelStart + 1)
                } else {
                    labelStart + 1
                };
                syntax.failAt(source, labelStart, prefix, "compiler hook " + source.slice(labelStart, hookEnd) + " cannot be called directly; use [...] indexing");
            } else if labelStart < source.length() and source.at(labelStart) == "\"" and types.isRecordKind(left.kind) {
                qKey := syntax.parseText(target, source, labelStart, prefix);
                qLabel := qKey.textValue;
                qEnd := qKey.next;
                fieldKind := types.recordFieldKind(left.kind, qLabel);
                if fieldKind == "" {
                    syntax.failAt(source, labelStart, prefix, "type " + types.displayKind(left.kind) + " has no field \"" + qLabel + "\"");
                }
                prop := types.recordComponentProp(left.kind, qLabel);
                fieldCode := if target == ir.TARGET_C {
                    rProp := types.cFieldName(prop);
                    if types.cDropFnForKind(left.kind) =!= "" and
                    (ctx.isCFreshOwnedExpr(left.code) or left.code.startsWithAt(0, "/*@T:") or left.code.startsWithAt(0, "/*@CBLK:")) {
                        fb := cBorrowExprWithPostDrop(left.kind, left.code, false);
                        if fb.drop =!= "" {
                            mut fbDrops: List<String> = [fb.drop];
                            valExpr := ctx.copiedValueCode(target, fieldKind, "(" + fb.expr + ")." + rProp);
                            cWrapExprWithPostDrops(fieldKind, valExpr, fbDrops)
                        } else {
                            "(" + left.code + ")." + rProp
                        }
                    } else {
                        "(" + left.code + ")." + rProp
                    }
                } else {
                    types.tsRecordFieldAccess(left.code, qLabel)
                };
