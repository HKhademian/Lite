                    prep := cPrepareBinaryCblkOperands(left.kind, left.code, right.kind, right.code);
                    rawInt := ctx.runtimeTypedIntegerCode(target, promoted, operator.text, prep.lExpr, prep.rExpr, operatorPosition);
