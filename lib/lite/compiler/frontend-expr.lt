                            mi := types.unionMemberIndex(left.kind, im);
                            if mi >= 0 { mut condPartsTT.pushBack("(" + tmpL + ".tag == " + mi.toText() + ")"); }
                        }
                        condStr := if condPartsTT.length() == 0 { "false" } else { condPartsTT.join(" || ") };
                        lInit := if left.code.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(tmpL, left.kind, left.code) } else { tmpL + " = " + left.code + ";" };
                        dropLeft := types.cDropFnForKind(left.kind);
                        isFreshL := ctx.isCFreshOwnedExpr(left.code);
                        postDrop := if dropLeft =!= "" and (isFreshL or left.code.startsWithAt(0, "/*@CBLK:")) { " " + dropLeft + "(&" + tmpL + ");" } else { "" };
