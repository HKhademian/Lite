/** Expression, block, conditional, loop, call, and operator precedence parser and lowering for TS and C targets. */

listLib := import "type/list";
sourceLib := import "core/source";
numeric := import "./numeric-literals";
integer := import "type/int";
cLiteral := import "./c-literals";
tsLiteral := import "./ts-literals";
emitFmt := import "./emit-format";
ir := import "./frontend-ir";
sym := import "./symbol-table";
builtinsAbi := import "./builtins-abi";
syntax := import "./frontend-syntax";
types := import "./frontend-types";
interfaces := import "./interfaces";
contexts := import "./contexts";
overloads := import "./overloads";
generics := import "./generics";
trace := import "./trace-safety";
reach := import "./reachability";
infer := import "./frontend-inference";
ctx := import "./frontend-context";
sliceBorrows := import "./slice-borrows";
comptimeEval := import "./comptime-eval";
textLib := import "type/string";
tb := import "core/text-builder";

/** One parsed expression matching `frontend-ir.Parsed`. */
Parsed := alias (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);

/** One local visible to later statements matching `frontend-ir.Local`. */
Local := alias (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);

/** One program or module-graph item matching `frontend-ir.Item`. */
Item := alias (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := alias List<Item>;

/** One previously declared top-level function matching `frontend-ir.FunctionInfo`. */
FunctionInfo := alias (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);

/** A later top-level scalar definition matching `frontend-ir.FutureValue`. */
FutureValue := alias (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);

/** One transparent type alias matching `frontend-ir.AliasDecl`. */
AliasDecl := alias (name: String, target: String, at: Int, end: Int, depth: Int);

/** Lexical control-flow and metadata context matching `frontend-ir.ConstructCtx`. */
ConstructCtx := alias (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool, colVar: String);

/** Monotonic sequence for C11 owned temporary cleanup (`lt_ot_*` / `lt_or_*`). */
var cOwnedTempSeq := 0;

/** Returns a fresh hygienic C11 owned-temporary identifier with `prefix`. */
freshCOwnedTemp := fn(prefix: String): String {
    cOwnedTempSeq = cOwnedTempSeq + 1;
    prefix + cOwnedTempSeq.toText()
};

/** Strips leading internal `/*@...*/` compiler markers from a C11 expression snippet for inspection. */
stripCMarkersForInspect := fn(code: String): String {
    var cur := code.trim();
    loop cur.startsWithAt(0, "/*@") {
        endM := cur.indexOf("@*/", 3);
        if endM < 0 { break; }
        cur = cur.slice(endM + 3, cur.length()).trim();
    }
    cur
};

/** Returns the last starting index of `needle` inside `s`, or `-1` if absent. */
cLastIndexOf := fn(s: String, needle: String): Int {
    var pos := 0;
    var last := -1;
    loop true {
        hit := s.indexOf(needle, pos);
        if hit < 0 { break; }
        last = hit;
        pos = hit + needle.length();
    }
    last
};

/** True when C11 expression `code` is an addressable lvalue variable, deref cell/param, or `.f_*` field chain safe for `const *` borrowing. */
isCBorrowableLvalue := fn(code: String): Bool {
    c := stripCMarkersForInspect(code);
    if c == "" or c.indexOf("/*@CBLK:", 0) >= 0 or c.indexOf("{", 0) >= 0 { return false; }
    var cur := c;
    loop cur.length() > 0 {
        if cur.startsWithAt(0, "(*") and cur.endsWith(")") {
            inner := cur.slice(2, cur.length() - 1).trim();
            if (inner.startsWithAt(0, "lite_") or inner.startsWithAt(0, "lt_cell_")) and inner.skipName(0) == inner.length() {
                return true;
            }
            return false;
        }
        dotPos := cLastIndexOf(cur, ".f_");
        if dotPos > 0 {
            fPart := cur.slice(dotPos + 1, cur.length());
            if fPart.skipName(0) == fPart.length() {
                lhs := cur.slice(0, dotPos).trim();
                if lhs.startsWithAt(0, "(") and lhs.endsWith(")") {
                    cur = lhs.slice(1, lhs.length() - 1).trim();
                } else {
                    cur = lhs;
                }
                continue;
            }
        }
        break;
    }
    (cur.startsWithAt(0, "lite_") or cur.startsWithAt(0, "lt_") or cur.startsWithAt(0, "_")) and cur.skipName(0) == cur.length()
};

/** Replaces a heap-allocated `lt_mk_<cid>(...)` closure expression with its stack-allocated compound literal when `/*@CSTK:...*/` is present. */
promoteCStackClosure := fn(code: String): (ok: Bool, code: String) {
    sIdx := code.indexOf("/*@CSTK:", 0);
    if sIdx < 0 { return (ok = false, code = code); }
    eIdx := code.indexOf("@*/", sIdx + 8);
    if eIdx < 0 { return (ok = false, code = code); }
    (ok = true, code = code.slice(0, sIdx) + code.slice(sIdx + 8, eIdx))
};

/** Prepares C11 expression `code` of type `kind` for borrowing (`byPtr` => `const *`) and returns an optional post-call `_drop` statement. */
cBorrowExprWithPostDrop := fn(kind: String, code: String, byPtr: Bool): (expr: String, drop: String) {
    dropFn := types.cDropFnForKind(kind);
    if isCBorrowableLvalue(code) {
        return (expr = if byPtr { "&(" + code + ")" } else { code }, drop = "");
    }
    if dropFn == "" {
        if byPtr {
            t := freshCOwnedTemp("lt_ot_");
            cT := types.cValueType(kind);
            return (expr = "/*@LTMP:" + cT + ":" + t + "@*/((" + t + " = (" + code + ")), &" + t + ")", drop = "");
        }
        return (expr = code, drop = "");
    }
    if code.startsWithAt(0, "/*@CBLK:") {
        return (expr = code, drop = "");
    }
    t := freshCOwnedTemp("lt_ot_");
    cT := types.cValueType(kind);
    (expr = "/*@LTMP:" + cT + ":" + t + "@*/((" + t + " = (" + code + ")), " + (if byPtr { "&" + t } else { t }) + ")", drop = dropFn + "(&" + t + ")")
};

/** Sequences `drops` immediately after `expr` via hygienic `@LTMP` result capture when `drops` is non-empty. */
cWrapExprWithPostDrops := fn(retKind: String, expr: String, drops: List<String>): String {
    if drops.length() == 0 { return expr; }
    if retKind == ir.VALUE_KIND_UNIT or retKind == ir.VALUE_KIND_NEVER {
        return "(" + expr + ", " + drops.join(", ") + ")";
    }
    retVar := freshCOwnedTemp("lt_or_");
    retT := types.cValueType(retKind);
    "/*@LTMP:" + retT + ":" + retVar + "@*/((" + retVar + " = (" + expr + ")), " + drops.join(", ") + ", " + retVar + ")"
};

/** Unwraps C11 CBLK binary operands into hygienic temporaries and records post-op drops for fresh owned temporaries. */
cPrepareBinaryCblkOperands := fn(lKind: String, lCode: String, rKind: String, rCode: String): (stmts: String, lExpr: String, rExpr: String, drops: String) {
    var stmtStr := "";
    var dropStr := "";
    lExpr := if lCode.startsWithAt(0, "/*@CBLK:") {
        lv := freshCOwnedTemp("lt_bl_");
        stmtStr = stmtStr + types.cValueType(lKind) + " " + lv + "; " + ctx.cUnwrapIntoVar(lv, lKind, lCode) + " ";
        lDf := types.cDropFnForKind(lKind);
        if lDf =!= "" { dropStr = dropStr + " " + lDf + "(&" + lv + ");"; }
        lv
    } else { lCode };
    rExpr := if rCode.startsWithAt(0, "/*@CBLK:") {
        rv := freshCOwnedTemp("lt_br_");
        stmtStr = stmtStr + types.cValueType(rKind) + " " + rv + "; " + ctx.cUnwrapIntoVar(rv, rKind, rCode) + " ";
        rDf := types.cDropFnForKind(rKind);
        if rDf =!= "" { dropStr = dropStr + " " + rDf + "(&" + rv + ");"; }
        rv
    } else { rCode };
    (stmts = stmtStr, lExpr = lExpr, rExpr = rExpr, drops = dropStr)
};

/** Wraps a strict binary C11 expression in a CBLK block after evaluating prepared operand temporaries. */
cWrapBinaryCblkExpr := fn(resKind: String, stmts: String, exprCode: String, drops: String): String {
    resVar := freshCOwnedTemp("lt_bo_");
    "/*@CBLK:" + resVar + "@*/" + types.cValueType(resKind) + " " + resVar + "; { " + stmts + resVar + " = " + exprCode + ";" + drops + " }"
};

/** Normalizes expected contextual value kind by erasing non-value sentinels and unwrapping `TailList<T>`. */
normalizeExpectedValueKind := fn(expected: String): String {
    if expected == ir.VALUE_KIND_UNIT or expected == ir.VALUE_KIND_NEVER {
        ""
    } else if expected.startsWithAt(0, "TailList<") {
        "List<" + types.listElementKind(expected.slice(4, expected.length())) + ">"
    } else {
        expected
    }
};

/** Normalizes inferred block/conditional exit kind hints passed from an enclosing context. */
inferHintKind := fn(valKind: String): String {
    if valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":")) {
        valKind.slice(10, valKind.length())
    } else if valKind == ir.VAL_KIND_INFER or valKind == ir.VALUE_KIND_UNIT or valKind == ir.VALUE_KIND_NEVER {
        ""
    } else {
        valKind
    }
};

/** True when `valKind` is a Pass 1 placeholder awaiting exit type inference. */
isInferPlaceholderKind := fn(valKind: String): Bool {
    valKind == ir.VAL_KIND_INFER or valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":"))
};

/** Parses a trailing `finally { ... }` block and validates ordering against `then` and duplicate `finally`. */
parseFinallyClause := fn(target: String, source: String, afterFinWordPos: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ownerCtxs: List<ConstructCtx>, bodyDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    afterFinKw := syntax.skipTrivia(source, afterFinWordPos + 7, prefix);
    syntax.rejectMisplacedTag(source, afterFinKw, prefix, "block tag cannot appear after finally");
    finOpen := syntax.expectSymbol(source, afterFinKw, "{", prefix);
    finBarrierCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FINALLY, phase = ir.CTX_PHASE_FINALLY,
    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "",
    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
    finParsed := parseBinaryCtx(target, source, finOpen - 1, prefix, locals, functions, params, currentName,
    "", 0, ctx.appendCtx(ownerCtxs, finBarrierCtx), bodyDepth, inferMode, "finally", aliases);
    afterFinClose := syntax.skipTrivia(source, finParsed.next, prefix);
    size := source.length();
    if afterFinClose < size and source.wordAt(afterFinClose, "then") {
        syntax.failAt(source, afterFinClose, prefix, "then must appear before finally");
    }
    if afterFinClose < size and source.wordAt(afterFinClose, "finally") {
        syntax.failAt(source, afterFinClose, prefix, "duplicate finally block");
    }
    finParsed
};

/** Emits a `try { ... } finally { ... }` IIFE result for Pass 1 (marker-carrying) or Pass 2 codegen. */
finishFinallyIife := fn(tryBody: String, finParsed: Parsed, normalKind: String, leftForMarkers: Parsed, inferMode: Bool): Parsed {
    finalKind := if finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { normalKind };
    pinitText := if leftForMarkers.textValue.startsWithAt(0, "$pinit:") { leftForMarkers.textValue } else { "" };
    if inferMode {
        merged := ctx.collectParsedMarkers(ctx.collectParsedMarkers("", leftForMarkers), finParsed);
        return ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = pinitText, constant = false, next = finParsed.next), merged);
    }
    (kind = finalKind, code = "(() => { try { " + tryBody + " } finally { " + finParsed.code + " } })()",
    intValue = 0, textValue = pinitText, constant = false, next = finParsed.next)
};

/** Wraps a C11 expression/block with a `finally` clause, rewriting early `return` and outer `goto` exits to run `finParsed.code`. */
finishFinallyC := fn(tryCode: String, finParsed: Parsed, normalKind: String, leftForMarkers: Parsed, inferMode: Bool, ctxs: List<ConstructCtx>, finId: Int): Parsed {
    finalKind := if finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { normalKind };
    pinitText := if leftForMarkers.textValue.startsWithAt(0, "$pinit:") { leftForMarkers.textValue } else { "" };
    if inferMode {
        merged := ctx.collectParsedMarkers(ctx.collectParsedMarkers("", leftForMarkers), finParsed);
        return ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = pinitText, constant = false, next = finParsed.next), merged);
    }
    fnIdx := ctx.findCtxByKindIndex(ctxs, "fn");
    fnRetKind := if fnIdx >= 0 { ctxs[fnIdx].valKind } else { "" };
    if normalKind == ir.VALUE_KIND_UNIT or normalKind == ir.VALUE_KIND_NEVER {
        unwrapped := ctx.cUnwrapIntoVar("", normalKind, tryCode);
        rewritten := ctx.cRewriteFinallyExits(unwrapped, finParsed.code, fnRetKind, finId);
        return (kind = finalKind, code = "/*@CBLK:0@*/{ " + rewritten + " { " + finParsed.code + " } }",
        intValue = 0, textValue = "", constant = false, next = finParsed.next);
    }
    finVar := "lt_finv_" + finId.toText();
    unwrapped := ctx.cUnwrapIntoVar(finVar, normalKind, tryCode);
    rewritten := ctx.cRewriteFinallyExits(unwrapped, finParsed.code, fnRetKind, finId);
    finDecl := if pinitText =!= "" and types.cTypeNeedsDrop(normalKind) {
        types.cValueType(normalKind) + " " + finVar + "; memset(&" + finVar + ", 0, sizeof(" + finVar + "));"
    } else {
        types.cValueType(normalKind) + " " + finVar + " = " + ctx.zeroParsed(ir.TARGET_C, normalKind, 0).code + ";"
    };
    (kind = finalKind, code = "/*@CBLK:" + finVar + "@*/" + finDecl + " { " + rewritten + " { " + finParsed.code + " } }",
    intValue = 0, textValue = pinitText, constant = false, next = finParsed.next)
};

/** Attempts to parse an optionally parenthesized `mut` binding lease (`mut x`, `mut .item`, `(mut x)`, `(((((mut x)))))`, `mut (x)`). */
tryParseGroupedMutLease := fn(source: String, start: Int, prefix: String, requireOuterParen: Bool): (matched: Bool, sawMut: Bool, mutStart: Int, nameStart: Int, nameEnd: Int, next: Int) {
    sourceSize := source.length();
    var cur := start;
    var openCount := 0;
    loop cur < sourceSize and source.at(cur) == "(" {
        openCount += 1;
        cur = syntax.skipTrivia(source, cur + 1, prefix);
    }
    if requireOuterParen and openCount == 0 {
        return (matched = false, sawMut = false, mutStart = 0, nameStart = 0, nameEnd = 0, next = start);
    }
    if not source.wordAt(cur, "mut") {
        return (matched = false, sawMut = false, mutStart = 0, nameStart = 0, nameEnd = 0, next = start);
    }
    mutStart := cur;
    var nameCur := syntax.skipTrivia(source, cur + 3, prefix);
    var recvOpen := 0;
    loop nameCur < sourceSize and source.at(nameCur) == "(" {
        recvOpen += 1;
        nameCur = syntax.skipTrivia(source, nameCur + 1, prefix);
    }
    var mNameEnd := nameCur;
    if nameCur < sourceSize and source.at(nameCur) == "." {
        dotItemStart := syntax.skipTrivia(source, nameCur + 1, prefix);
        if dotItemStart < sourceSize and source.wordAt(dotItemStart, "item") {
            mNameEnd = dotItemStart + 4;
        } else {
            return (matched = false, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = nameCur, next = start);
        }
    } else if nameCur < sourceSize and source.at(nameCur).isNameStart() {
        mNameEnd = source.skipName(nameCur);
    } else {
        return (matched = false, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = nameCur, next = start);
    }
    var closeCur := syntax.skipTrivia(source, mNameEnd, prefix);
    needClose := recvOpen + openCount;
    var closed := 0;
    loop closed < needClose {
        if closeCur >= sourceSize or source.at(closeCur) =!= ")" {
            return (matched = false, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = mNameEnd, next = start);
        }
        closed += 1;
        closeCur = syntax.skipTrivia(source, closeCur + 1, prefix);
    }
    (matched = true, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = mNameEnd, next = closeCur)
};

/** Resolves an identifier or `.item` lease target in `mut <target>` to its local entry index and display name. */
resolveMutLeaseLocal := fn(locals: List<Local>, ctxs: List<ConstructCtx>, rawName: String, source: String, nameStart: Int, prefix: String): (idx: Int, displayName: String) {
    if rawName.startsWithAt(0, ".") {
        loopIdx := ctx.findLeadingDotLoopIdx(ctxs, true);
        if loopIdx == ir.DOT_LOOP_IN_FINALLY {
            syntax.failAt(source, nameStart, prefix, "loop metadata is not available in finally");
        } else if loopIdx < 0 {
            syntax.failAt(source, nameStart, prefix, ".item outside loop");
        }
        lCtx := ctxs[loopIdx];
        if lCtx.phase == ir.CTX_PHASE_THEN {
            syntax.failAt(source, nameStart, prefix, "cannot mutate .item in loop then block");
        }
        if lCtx.phase == ir.CTX_PHASE_HEADER {
            syntax.failAt(source, nameStart, prefix, ".item is not available in loop header");
        }
        itemLocIdx := sym.localIndex(locals, "$loop_item_" + lCtx.id.toText());
        if itemLocIdx < 0 or not locals[itemLocIdx].writable {
            syntax.failAt(source, nameStart, prefix, "cannot mutate .item in a read-only loop; use loop mut");
        }
        return (idx = itemLocIdx, displayName = ".item");
    }
    if syntax.isReservedWord(rawName) { syntax.unsupportedFeature(source, nameStart, rawName, prefix); }
    locIdx := sym.localIndex(locals, rawName);
    if locIdx < 0 { syntax.failAt(source, nameStart, prefix, "unknown value " + rawName); }
    (idx = locIdx, displayName = rawName)
};

/** Parses `()`, a parenthesized expression, or a named/positional flat tuple literal starting at `start`. */
parseParenOrTupleExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    sourceSize := source.length();
    if source.at(syntax.skipTrivia(source, start + 1, prefix)) == ")" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = syntax.skipTrivia(source, start + 1, prefix) + 1);
    }
    mutLease := tryParseGroupedMutLease(source, start, prefix, true);
    if mutLease.matched {
        return parseMutReceiverCallExpr(target, source, mutLease.mutStart, mutLease.nameStart, mutLease.nameEnd, mutLease.next, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if syntax.looksLikeTupleEntry(source, start + 1, prefix) {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        mut labels: List<String> = [];
        mut codes: List<String> = [];
        mut kinds: List<String> = [];
        var tupleMarkers := "";
        var count := 0;
        loop cursor < sourceSize and source.at(cursor) =!= ")" {
            var label := "";
            var valueStart := cursor;
            var value := ctx.intParsed("", 0, true, cursor);
            if syntax.isSingleEquals(source, cursor) {
                nameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if nameStart >= sourceSize or not source.at(nameStart).isNameStart() {
                    syntax.failAt(source, nameStart, prefix, "expected a tuple field name after =");
                }
                nameEnd := source.skipName(nameStart);
                label = source.slice(nameStart, nameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, nameStart, label, prefix); }
                if labels.contains(label) {
                    syntax.failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                }
                valueStart = nameStart;
                fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                value = parseBinaryCtx(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30, ctxs, iifeDepth, inferMode, "", aliases);
            } else if cursor < sourceSize and source.at(cursor).isNameStart() {
                nameEnd := source.skipName(cursor);
                afterName := syntax.skipTrivia(source, nameEnd, prefix);
                if syntax.isSingleEquals(source, afterName) {
                    label = source.slice(cursor, nameEnd);
                    if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, cursor, label, prefix); }
                    if labels.contains(label) {
                        syntax.failAt(source, cursor, prefix, "duplicate tuple field " + label);
                    }
                    valueStart = syntax.skipTrivia(source, afterName + 1, prefix);
                    fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                    value = parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                } else {
                    fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                    value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                }
            } else {
                fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
            }
            if inferMode { tupleMarkers = ctx.collectParsedMarkers(tupleMarkers, value); }
            if types.isTupleKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "nested tuple values are not supported");
            }
            if types.isListKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "list values inside tuples are not supported");
            }
            if value.kind == ir.VALUE_KIND_UNIT or value.kind == ir.VALUE_KIND_NEVER {
                failName := if label =!= "" { label } else { count.toText() };
                syntax.failAt(source, valueStart, prefix, "tuple field " + failName + " cannot be " + types.displayKind(value.kind));
            }
            (mut labels).pushBack(label);
            mut codes.pushBack(ctx.assignValueCode(target, value.kind, value.kind, value.code));
            mut kinds.pushBack(value.kind);
            count = count + 1;
            cursor = syntax.skipTrivia(source, value.next, prefix);
            if cursor < sourceSize and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = syntax.expectSymbol(source, cursor, ")", prefix);
        mut kindTextBuf: tb.TextBuilder;
        mut kindTextBuf.append("(");
        var index := 0;
        loop index < count {
            if index > 0 { mut kindTextBuf.append(","); }
            mut kindTextBuf.append(labels[index]);
            mut kindTextBuf.append(":");
            mut kindTextBuf.append(kinds[index]);
            index = index + 1;
        }
        mut kindTextBuf.append(")");
        tupleKind := kindTextBuf.build();
        if target == ir.TARGET_C and types.cStructTag(tupleKind) =!= "" {
            tag := types.cStructTag(tupleKind);
            if count == 0 {
                return ctx.withMarkers((kind = tupleKind, code = "/*@T:" + tupleKind + "@*/((" + tag + "){ ._empty = 0 })", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
            }
            var hasCBlkTup := false;
            mut tWrapStmts: List<String> = [];
            mut tWrapVars: List<String> = [];
            var tiChk := 0;
            loop tiChk < count {
                if codes[tiChk].startsWithAt(0, "/*@CBLK:") { hasCBlkTup = true; break; }
                tiChk = tiChk + 1;
            }
            if hasCBlkTup {
                var ti := 0;
                loop ti < count {
                    if codes[ti].startsWithAt(0, "/*@CBLK:") {
                        tElVar := freshCOwnedTemp("lt_te_");
                        mut tWrapStmts.pushBack(types.cValueType(kinds[ti]) + " " + tElVar + "; " + ctx.cUnwrapIntoVar(tElVar, kinds[ti], codes[ti]) + " (void)" + tElVar + ";");
                        mut tWrapVars.pushBack(tElVar);
                    } else {
                        mut tWrapVars.pushBack(codes[ti]);
                    }
                    ti = ti + 1;
                }
            } else {
                loop codes as tc { mut tWrapVars.pushBack(tc); }
            }
            mut cCodeBuf: tb.TextBuilder;
            var ci := 0;
            loop ci < count {
                if ci > 0 { mut cCodeBuf.append(", "); }
                mut cCodeBuf.append(".");
                mut cCodeBuf.append(types.cFieldName(types.tupleRuntimeProp(labels[ci], ci)));
                mut cCodeBuf.append(" = ");
                mut cCodeBuf.append(tWrapVars[ci]);
                ci = ci + 1;
            }
            tupLit := "/*@T:" + tupleKind + "@*/((" + tag + "){ " + cCodeBuf.build() + " })";
            tupCode := if hasCBlkTup {
                tRet := freshCOwnedTemp("lt_tr_");
                "/*@CBLK:" + tRet + "@*/" + tag + " " + tRet + "; { " + tWrapStmts.join(" ") + " " + tRet + " = " + tupLit + "; }"
            } else {
                tupLit
            };
            return ctx.withMarkers((kind = tupleKind, code = tupCode, intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
        }
        mut codeBuf: tb.TextBuilder;
        mut codeBuf.append("{ ");
        var ti := 0;
        loop ti < count {
            if ti > 0 { mut codeBuf.append(", "); }
            mut codeBuf.append(types.tupleObjectKey(labels[ti], ti));
            mut codeBuf.append(": ");
            mut codeBuf.append(codes[ti]);
            ti = ti + 1;
        }
        mut codeBuf.append(" }");
        return ctx.withMarkers((kind = tupleKind, code = codeBuf.build(), intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
    }
    var groupedExpected := expected;
    if numeric.isNumericKind(expected) {
        groupEnd := syntax.scanParenEnd(source, start, prefix);
        if groupEnd >= 0 and syntax.binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
    }
    inner := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
    next := syntax.expectSymbol(source, syntax.skipTrivia(source, inner.next, prefix), ")", prefix);
    groupedCode := if target == ir.TARGET_C and inner.code.startsWithAt(0, "/*@CBLK:") { inner.code } else { "(" + inner.code + ")" };
    ctx.withMarkers((kind = inner.kind, code = groupedCode, intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next),
    if inferMode { ctx.collectParsedMarkers("", inner) } else { "" })
};

/** Parses prefix unary `+` or `-` (numeric literals or general runtime operands). */
parseUnarySignExpr := fn(target: String, source: String, start: Int, ch: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    after := syntax.skipTrivia(source, start + 1, prefix);
    if after < source.length() and source.at(after).isDigit() {
        litExpected := if ch == "-" { expected } else { "" };
        return syntax.parseNumberWithDefaults(target, source, start, prefix, litExpected, minimum, types.defaultIntKind(aliases, prefix), types.defaultFloatKind(aliases, prefix));
    }
    operand := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, "", 30, ctxs, iifeDepth, inferMode, "", aliases);
    operandLoopId := types.loopValMarkerId(operand.kind);
    if inferMode and operandLoopId >= 0 {
        if expected =!= "" and expected =!= ir.VALUE_KIND_UNIT and expected =!= ir.VALUE_KIND_NEVER and numeric.isNumericKind(expected) {
            return ctx.withMarkers((kind = expected, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
            ctx.collectParsedMarkers("", operand) + operandLoopId.toText() + "=" + expected + "\n");
        }
        return ctx.withMarkers((kind = operand.kind, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
        ctx.collectParsedMarkers("", operand));
    }
    if not numeric.isNumericKind(operand.kind) {
        syntax.failAt(source, start, prefix, "unary " + ch + " requires an Int or Float operand");
    }
    if ch == "-" and numeric.isUnsignedIntKind(operand.kind) {
        syntax.failAt(source, start, prefix, "cannot negate unsigned integer " + types.displayKind(operand.kind));
    }
    if target == ir.TARGET_C and operand.code.startsWithAt(0, "/*@CBLK:") {
        if ch == "+" {
            if numeric.isFloatKind(operand.kind) {
                return ctx.withMarkers((kind = operand.kind, code = operand.code, intValue = 0, textValue = "", constant = false, next = operand.next),
                if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
            }
            return ctx.withMarkers(ctx.typedIntParsed(operand.kind, operand.code, 0, false, operand.next),
            if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
        }
        uVar := freshCOwnedTemp("lt_us_");
        resVar := freshCOwnedTemp("lt_neg_");
        cT := types.cValueType(operand.kind);
        uInit := ctx.cUnwrapIntoVar(uVar, operand.kind, operand.code);
        negExpr := if operand.kind == ir.VALUE_KIND_FLOAT8 { "lt_f8_neg(" + uVar + ")" }
        else if operand.kind == ir.VALUE_KIND_FLOAT16 { "lt_f16_neg(" + uVar + ")" }
        else if numeric.isFloatKind(operand.kind) { "(-" + uVar + ")" }
        else {
            rawNeg := ir.targetIntNegateCode(target, uVar, start);
            if numeric.isNarrowIntKind(operand.kind) { ir.targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start) } else { rawNeg }
        };
        cBlkNeg := "/*@CBLK:" + resVar + "@*/" + cT + " " + resVar + "; { " + cT + " " + uVar + "; " + uInit + " " + resVar + " = " + negExpr + "; }";
        if numeric.isFloatKind(operand.kind) {
            return ctx.withMarkers((kind = operand.kind, code = cBlkNeg, intValue = 0, textValue = "", constant = false, next = operand.next),
            if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
        }
        return ctx.withMarkers(ctx.typedIntParsed(operand.kind, cBlkNeg, 0, false, operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    code := if ch == "-" {
        if target == ir.TARGET_C and operand.kind == ir.VALUE_KIND_FLOAT8 { "lt_f8_neg(" + operand.code + ")" }
        else if target == ir.TARGET_C and operand.kind == ir.VALUE_KIND_FLOAT16 { "lt_f16_neg(" + operand.code + ")" }
        else { "(-" + operand.code + ")" }
    } else { "(" + operand.code + ")" };
    if numeric.isFloatKind(operand.kind) {
        return ctx.withMarkers((kind = operand.kind, code = code, intValue = 0, textValue = "", constant = false, next = operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if operand.constant {
        folded := if ch == "-" { operand.intValue.checkedNeg() } else { (value = operand.intValue, ok = true) };
        if folded.ok and numeric.intKindFits(operand.kind, folded.value) {
            return ctx.typedIntParsed(operand.kind, code, folded.value, true, operand.next);
        }
    }
    runtimeCode := if ch == "-" {
        rawNeg := ir.targetIntNegateCode(target, operand.code, start);
        if numeric.isNarrowIntKind(operand.kind) { ir.targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start) } else { rawNeg }
    } else {
        code
    };
    ctx.withMarkers(ctx.typedIntParsed(operand.kind, runtimeCode, 0, false, operand.next),
    if inferMode { ctx.collectParsedMarkers("", operand) } else { "" })
};

/** Parses `[a, b, ...]` list/array/set literals and `[k = v, ...]` map literals starting at `start`. */
parseListOrArrayExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var cursor := syntax.skipTrivia(source, start + 1, prefix);
    isTailList := expected.startsWithAt(0, "TailList<");
    isListAny := expected == "$ListAny";
    isMapTarget := types.isMapKind(expected);
    isSetTarget := types.isSetKind(expected);
    isListTarget := types.isListKind(expected) or isTailList or isListAny;

    /* Empty bracket literal `[]` with Map<K, V> or Set<T> expected type */
    if cursor < source.length() and source.at(cursor) == "]" {
        if isMapTarget {
            close := syntax.expectSymbol(source, cursor, "]", prefix);
            if target == ir.TARGET_C {
                mTag := types.cMapTag(expected);
                if mTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Map yet"); }
                return (kind = expected, code = "/*@T:" + expected + "@*/" + mTag + "_from(0, NULL)",
                intValue = 0, textValue = "", constant = false, next = close);
            }
            kKind := types.mapKeyKind(expected);
            vKind := types.mapValueKind(expected);
            return (kind = expected, code = "new Map<" + types.tsFunctionType(kKind) + ", " + types.tsFunctionType(vKind) + ">()",
            intValue = 0, textValue = "", constant = false, next = close);
        }
        if isSetTarget {
            close := syntax.expectSymbol(source, cursor, "]", prefix);
            if target == ir.TARGET_C {
                sTag := types.cSetTag(expected);
                if sTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Set yet"); }
                return (kind = expected, code = "/*@T:" + expected + "@*/" + sTag + "_from(0, NULL)",
                intValue = 0, textValue = "", constant = false, next = close);
            }
            eKind := types.setElementKind(expected);
            return (kind = expected, code = "new Set<" + types.tsFunctionType(eKind) + ">()",
            intValue = 0, textValue = "", constant = false, next = close);
        }
    }

    var elementKind := "";
    if types.isListKind(expected) { elementKind = types.listElementKind(expected); }
    else if isTailList { elementKind = types.listElementKind(expected.slice(4, expected.length())); }
    else if types.isArrayKind(expected) { elementKind = types.arrayElementKind(expected); }
    else if isSetTarget { elementKind = types.setElementKind(expected); }
    else if isMapTarget { elementKind = types.mapKeyKind(expected); }

    /* Non-empty bracket literal: peek after first element for `=` to distinguish Map `[k = v, ...]` from List/Array/Set `[a, b, ...]`. */
    if cursor < source.length() and source.at(cursor) =!= "]" {
        firstStart := cursor;
        firstElem := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        afterFirst := syntax.skipTrivia(source, firstElem.next, prefix);
        if afterFirst < source.length() and syntax.isSingleEquals(source, afterFirst) {
            var keyKind := if isMapTarget { types.mapKeyKind(expected) } else { "" };
            var valKind := if isMapTarget { types.mapValueKind(expected) } else { "" };
            mut entryCodes: List<String> = [];
            mut cEntryCodes: List<String> = [];
            var mapMarkers := "";
            var entryCount := 0;
            var curKeyStart := firstStart;
            var curKey := firstElem;
            var curEq := afterFirst;
            loop true {
                if inferMode { mapMarkers = ctx.collectParsedMarkers(mapMarkers, curKey); }
                if not types.isMapKeyKind(curKey.kind) {
                    syntax.failAt(source, curKeyStart, prefix, "unsupported map key type " + types.displayKind(curKey.kind));
                }
                if keyKind == "" {
                    keyKind = curKey.kind;
                } else if not types.isCompatibleKind(keyKind, curKey.kind) {
                    syntax.failAt(source, curKeyStart, prefix, "map entry " + (entryCount + 1).toText() + " key must be " +
                    types.displayKind(keyKind) + ", got " + types.displayKind(curKey.kind));
                }
                valStart := syntax.skipTrivia(source, curEq + 1, prefix);
                valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, valKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
                if inferMode { mapMarkers = ctx.collectParsedMarkers(mapMarkers, valParsed); }
                if valParsed.kind == ir.VALUE_KIND_UNIT or valParsed.kind == ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, valStart, prefix, "map entry " + (entryCount + 1).toText() + " value cannot be " + types.displayKind(valParsed.kind));
                }
                if valKind == "" {
                    valKind = valParsed.kind;
                } else if not types.isCompatibleKind(valKind, valParsed.kind) {
                    syntax.failAt(source, valStart, prefix, "map entry " + (entryCount + 1).toText() + " value must be " +
                    types.displayKind(valKind) + ", got " + types.displayKind(valParsed.kind));
                }
                kCode := ctx.assignValueCode(target, keyKind, curKey.kind, curKey.code);
                vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
                mut entryCodes.pushBack("[" + kCode + ", " + vCode + "]");
                mut cEntryCodes.pushBack("{ " + kCode + ", " + vCode + " }");
                entryCount = entryCount + 1;
                cursor = syntax.skipTrivia(source, valParsed.next, prefix);
                if cursor < source.length() and source.at(cursor) == "," {
                    cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                    if cursor < source.length() and source.at(cursor) == "]" { break; }
                    curKeyStart = cursor;
                    curKey = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, keyKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
                    curEq = syntax.skipTrivia(source, curKey.next, prefix);
                    if curEq >= source.length() or not syntax.isSingleEquals(source, curEq) {
                        syntax.failAt(source, curEq, prefix, "expected = after map key");
                    }
                } else {
                    break;
                }
            }
            cursor = syntax.expectSymbol(source, cursor, "]", prefix);
            mapKind := "Map<" + keyKind + "," + valKind + ">";
            if target == ir.TARGET_C {
                mTag := types.cMapTag(mapKind);
                if mTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Map yet"); }
                return ctx.withMarkers((kind = mapKind,
                code = "/*@T:" + mapKind + "@*/" + mTag + "_from(" + entryCount.toText() + ", (const " + mTag + "_entry[]){" + cEntryCodes.join(", ") + "})",
                intValue = 0, textValue = "", constant = false, next = cursor), mapMarkers);
            }
            return ctx.withMarkers((kind = mapKind,
            code = "new Map<" + types.tsFunctionType(keyKind) + ", " + types.tsFunctionType(valKind) + ">([" + entryCodes.join(", ") + "])",
            intValue = 0, textValue = "", constant = false, next = cursor), mapMarkers);
        }
        if isMapTarget {
            syntax.failAt(source, afterFirst, prefix, "expected = after map key in Map literal");
        }
    }

    mut elementCodes: List<String> = [];
    var listMarkers := "";
    var count := 0;
    loop true {
        if cursor >= source.length() {
            syntax.failAt(source, cursor, prefix, "expected ] in list literal");
        }
        if source.at(cursor) == "]" { break; }
        elementStart := cursor;
        element := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { listMarkers = ctx.collectParsedMarkers(listMarkers, element); }
        if element.kind == ir.VALUE_KIND_UNIT and elementKind =!= ir.VALUE_KIND_UNIT {
            syntax.failAt(source, elementStart, prefix, "list element " + (count + 1).toText() + " cannot be Unit");
        }
        if types.isListKind(element.kind) {
            syntax.failAt(source, elementStart, prefix, "nested list types are not supported");
        }
        if elementKind == "" {
            if element.kind =!= ir.VALUE_KIND_NEVER { elementKind = element.kind; }
        } else {
            compatible := if isListTarget or isSetTarget { types.isCompatibleKind(elementKind, element.kind) }
            else { element.kind == ir.VALUE_KIND_NEVER or element.kind == elementKind or types.fnShapeMatches(elementKind, element.kind) };
            if not compatible {
                syntax.failAt(source, elementStart, prefix, "list element " + (count + 1).toText() + " must be " +
                types.displayKind(elementKind) + ", got " + types.displayKind(element.kind));
            }
        }
        (mut elementCodes).pushBack(ctx.assignValueCode(target, elementKind, element.kind, element.code));
        count = count + 1;
        cursor = syntax.skipTrivia(source, element.next, prefix);
        if count == 1 and cursor < source.length() and source.at(cursor) == ";" {
            if isSetTarget {
                syntax.failAt(source, cursor, prefix, "repeat literal [val; N] is not valid for Set");
            }
            if elementKind == "" {
                syntax.failAt(source, elementStart, prefix, "repeat array element cannot be Never");
            }
            countStart := syntax.skipTrivia(source, cursor + 1, prefix);
            countExpr := parseBinaryCtx(target, source, countStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { listMarkers = ctx.collectParsedMarkers(listMarkers, countExpr); }
            if not countExpr.constant or not numeric.isIntKind(countExpr.kind) {
                syntax.failAt(source, countStart, prefix, "repeat array count must be a compile-time Int constant");
            }
            if countExpr.intValue < 0 {
                syntax.failAt(source, countStart, prefix, "repeat array count cannot be negative");
            }
            if countExpr.intValue > 65536 {
                syntax.failAt(source, countStart, prefix, "repeat array count exceeds maximum 65536");
            }
            repEnd := syntax.expectSymbol(source, syntax.skipTrivia(source, countExpr.next, prefix), "]", prefix);
            repeatCount := countExpr.intValue;
            repResultKind := if types.isListKind(expected) or isListAny {
                "List<" + elementKind + ">"
            } else {
                "[" + elementKind + ";" + repeatCount.toText() + "]"
            };
            elemValCode := elementCodes[0];
            repHasCBlk := target == ir.TARGET_C and elemValCode.startsWithAt(0, "/*@CBLK:");
            var repUnwrapStmt := "";
            var repArgExpr := elemValCode;
            if repHasCBlk {
                repTmp := freshCOwnedTemp("lt_le_");
                repUnwrapStmt = types.cValueType(elementKind) + " " + repTmp + "; " + ctx.cUnwrapIntoVar(repTmp, elementKind, elemValCode) + " (void)" + repTmp + "; ";
                repArgExpr = repTmp;
            }
            repCode := if target == ir.TARGET_C and types.isArrayKind(repResultKind) and types.cArrayTag(repResultKind) =!= "" {
                aTag := types.cArrayTag(repResultKind);
                if repeatCount == 0 {
                    if element.constant {
                        "((/*@T:" + repResultKind + "@*/" + aTag + "){ 0 })"
                    } else if repHasCBlk {
                        rVar := freshCOwnedTemp("lt_lr_");
                        "/*@CBLK:" + rVar + "@*/" + aTag + " " + rVar + "; { " + repUnwrapStmt + rVar + " = ((/*@T:" + repResultKind + "@*/" + aTag + "){ 0 }); }"
                    } else {
                        "((void)(" + elemValCode + "), (/*@T:" + repResultKind + "@*/" + aTag + "){ 0 })"
                    }
                } else {
                    baseRep := "/*@T:" + repResultKind + "@*/" + aTag + "_repeat(" + repArgExpr + ")";
                    if repHasCBlk {
                        rVar := freshCOwnedTemp("lt_lr_");
                        "/*@CBLK:" + rVar + "@*/" + aTag + " " + rVar + "; { " + repUnwrapStmt + rVar + " = " + baseRep + "; }"
                    } else { baseRep }
                }
            } else if target == ir.TARGET_C and types.cListTag(elementKind) =!= "" {
                cTag := types.cListTag(elementKind);
                if repeatCount == 0 {
                    if element.constant {
                        "/*@T:" + repResultKind + "@*/lt_list_" + cTag + "_from(0, NULL)"
                    } else if repHasCBlk {
                        rVar := freshCOwnedTemp("lt_lr_");
                        "/*@CBLK:" + rVar + "@*/lt_list_" + cTag + " " + rVar + "; { " + repUnwrapStmt + rVar + " = /*@T:" + repResultKind + "@*/lt_list_" + cTag + "_from(0, NULL); }"
                    } else {
                        "/*@T:" + repResultKind + "@*/((void)(" + elemValCode + "), lt_list_" + cTag + "_from(0, NULL))"
                    }
                } else {
                    baseRep := "/*@T:" + repResultKind + "@*/lt_list_" + cTag + "_repeat(" + repeatCount.toText() + ", " + repArgExpr + ")";
                    if repHasCBlk {
                        rVar := freshCOwnedTemp("lt_lr_");
                        "/*@CBLK:" + rVar + "@*/lt_list_" + cTag + " " + rVar + "; { " + repUnwrapStmt + rVar + " = " + baseRep + "; }"
                    } else { baseRep }
                }
            } else {
                tsElem := types.tsFunctionType(elementKind);
                tsSlot := ctx.tsDeepCloneValueCode(elementKind, "lite$v");
                if repeatCount == 0 {
                    if element.constant {
                        "[]"
                    } else {
                        "((lite$v: " + tsElem + "): " + tsElem + "[] => { void lite$v; return []; })(" + elemValCode + ")"
                    }
                } else if element.constant and tsSlot == "lite$v" and repeatCount <= 32 {
                    mut repBuf: tb.TextBuilder;
                    mut repBuf.append("[");
                    var ri := 0;
                    loop ri < repeatCount {
                        if ri > 0 { mut repBuf.append(", "); }
                        mut repBuf.append(elemValCode);
                        ri = ri + 1;
                    }
                    mut repBuf.append("]");
                    repBuf.build()
                } else {
                    "((lite$v: " + tsElem + "): " + tsElem + "[] => { const lite$a: " + tsElem + "[] = []; for (let lite$i = 0; lite$i < " + repeatCount.toText() + "; lite$i += 1) { lite$a.push(" + tsSlot + "); } return lite$a; })(" + elemValCode + ")"
                }
            };
            return ctx.withMarkers((kind = repResultKind, code = repCode, intValue = 0, textValue = "", constant = false, next = repEnd), listMarkers);
        }
        if cursor < source.length() and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, "]", prefix);
    var listHasCBlk := false;
    mut listWrapStmts: List<String> = [];
    mut listWrapExprs: List<String> = [];
    if target == ir.TARGET_C and count > 0 {
        var liChk := 0;
        loop liChk < elementCodes.length() {
            if elementCodes[liChk].startsWithAt(0, "/*@CBLK:") { listHasCBlk = true; break; }
            liChk = liChk + 1;
        }
        if listHasCBlk {
            var li := 0;
            loop li < elementCodes.length() {
                if elementCodes[li].startsWithAt(0, "/*@CBLK:") {
                    lElVar := freshCOwnedTemp("lt_le_");
                    mut listWrapStmts.pushBack(types.cValueType(elementKind) + " " + lElVar + "; " + ctx.cUnwrapIntoVar(lElVar, elementKind, elementCodes[li]) + " (void)" + lElVar + ";");
                    mut listWrapExprs.pushBack(lElVar);
                } else {
                    mut listWrapExprs.pushBack(elementCodes[li]);
                }
                li = li + 1;
            }
        } else {
            loop elementCodes as ec { mut listWrapExprs.pushBack(ec); }
        }
    } else {
        loop elementCodes as ec { mut listWrapExprs.pushBack(ec); }
    }
    if isSetTarget {
        if target == ir.TARGET_C {
            sTag := types.cSetTag(expected);
            if sTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Set yet"); }
            kTag := types.cMapKeyTag(elementKind);
            cArrType := "const " + types.cListElemType(kTag);
            sCode := if count == 0 {
                "/*@T:" + expected + "@*/" + sTag + "_from(0, NULL)"
            } else {
                baseS := "/*@T:" + expected + "@*/" + sTag + "_from(" + count.toText() + ", (" + cArrType + "[]){" + listWrapExprs.join(", ") + "})";
                if listHasCBlk {
                    rVar := freshCOwnedTemp("lt_lr_");
                    "/*@CBLK:" + rVar + "@*/" + sTag + " " + rVar + "; { " + listWrapStmts.join(" ") + " " + rVar + " = " + baseS + "; }"
                } else { baseS }
            };
            return ctx.withMarkers((kind = expected, code = sCode, intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
        }
        return ctx.withMarkers((kind = expected,
        code = "new Set<" + types.tsFunctionType(elementKind) + ">([" + elementCodes.join(", ") + "])",
        intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
    }
    if count > 0 and elementKind == "" {
        syntax.failAt(source, start, prefix, "list element 1 cannot be Never");
    }
    if count == 0 and not types.isListKind(expected) and not isTailList and not types.isArrayKind(expected) {
        syntax.failAt(source, start, prefix, "empty list literal requires a List element type");
    }
    resultKind := if types.isListKind(expected) or isListAny or (count == 0 and isTailList) {
        "List<" + elementKind + ">"
    } else {
        "[" + elementKind + ";" + count.toText() + "]"
    };
    listCode := if target == ir.TARGET_C and types.isArrayKind(resultKind) and types.cArrayTag(resultKind) =!= "" {
        aTag := types.cArrayTag(resultKind);
        elKind := types.arrayElementKind(resultKind);
        baseA := if count == 0 {
            "((/*@T:" + resultKind + "@*/" + aTag + "){ 0 })"
        } else if numeric.isSubByteIntKind(elKind) {
            "/*@T:" + resultKind + "@*/" + aTag + "_from((const " + types.cValueType(elKind) + "[]){ " + listWrapExprs.join(", ") + " })"
        } else {
            "((/*@T:" + resultKind + "@*/" + aTag + "){ { " + listWrapExprs.join(", ") + " } })"
        };
        if listHasCBlk {
            rVar := freshCOwnedTemp("lt_lr_");
            "/*@CBLK:" + rVar + "@*/" + aTag + " " + rVar + "; { " + listWrapStmts.join(" ") + " " + rVar + " = " + baseA + "; }"
        } else { baseA }
    } else if target == ir.TARGET_C and types.cListTag(elementKind) =!= "" {
        cTag := types.cListTag(elementKind);
        baseL := if count == 0 {
            "lt_list_" + cTag + "_from(0, NULL)"
        } else {
            cArrType := "const " + types.cListElemType(cTag);
            "lt_list_" + cTag + "_from(" + count.toText() + ", (" + cArrType + "[]){" + listWrapExprs.join(", ") + "})"
        };
        if listHasCBlk {
            rVar := freshCOwnedTemp("lt_lr_");
            "/*@CBLK:" + rVar + "@*/lt_list_" + cTag + " " + rVar + "; { " + listWrapStmts.join(" ") + " " + rVar + " = " + baseL + "; }"
        } else { baseL }
    } else {
        "[" + elementCodes.join(", ") + "]"
    };
    ctx.withMarkers((kind = resultKind, code = listCode,
    intValue = 0, textValue = "", constant = false, next = cursor), listMarkers)
};

/** Parses `@tag.field`, `@tag { ... }`, and `@tag if/match/loop` prefixes. */
parseTagPrefixExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    tagInfo := syntax.parseTagAt(source, start, prefix);
    afterTag := syntax.skipTrivia(source, tagInfo.next, prefix);
    tagSourceSize := source.length();
    if afterTag < tagSourceSize and source.at(afterTag) == "." {
        fieldStart := syntax.skipTrivia(source, afterTag + 1, prefix);
        if fieldStart >= tagSourceSize or not source.at(fieldStart).isNameStart() {
            syntax.failAt(source, fieldStart, prefix, "expected field name after @" + tagInfo.tag + ".");
        }
        fieldEnd := source.skipName(fieldStart);
        fieldName := source.slice(fieldStart, fieldEnd);
        ctxIdx := ctx.findTaggedCtxIndex(ctxs, tagInfo.tag);
        if ctxIdx < 0 {
            syntax.failAt(source, start, prefix, "unknown block tag @" + tagInfo.tag);
        }
        if ctx.hasFinallyAbove(ctxs, ctxIdx) {
            syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
        }
        c := ctxs[ctxIdx];
        if c.kind == ir.CTX_KIND_IF or c.kind == ir.CTX_KIND_MATCH {
            if fieldName =!= "value" {
                syntax.failAt(source, fieldStart, prefix, "conditional tag @" + tagInfo.tag + " only exposes .value, not ." + fieldName);
            }
            if c.phase =!= ir.CTX_PHASE_THEN {
                syntax.failAt(source, fieldStart, prefix, "@" + tagInfo.tag + ".value is only available inside that conditional's then block");
            }
            if c.itemKind == ir.VALUE_KIND_UNIT or c.itemKind == ir.VALUE_KIND_NEVER or c.itemKind == "" {
                syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose .value for " +
                types.displayKind(if c.itemKind == "" { ir.VALUE_KIND_UNIT } else { c.itemKind }) + " conditional");
            }
            return (kind = c.itemKind, code = c.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
        }
        if c.kind == ir.CTX_KIND_LOOP {
            if c.phase == ir.CTX_PHASE_FINALLY {
                syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
            }
            return ctx.resolveLoopField(target, c, fieldName, expected, source, fieldStart, fieldEnd, prefix);
        }
        syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose ." + fieldName);
    }
    var tagBlockBrace := -1;
    if afterTag < tagSourceSize and source.at(afterTag) == "{" {
        tagBlockBrace = afterTag;
    } else if afterTag < tagSourceSize and source.wordAt(afterTag, "do") {
        afterDoKw := syntax.skipTrivia(source, afterTag + 2, prefix);
        if afterDoKw >= tagSourceSize or source.at(afterDoKw) =!= "{" {
            syntax.failAt(source, afterDoKw, prefix, "expected { after do");
        }
        tagBlockBrace = afterDoKw;
    }
    if tagBlockBrace >= 0 {
        isCTagBlk := target == ir.TARGET_C;
        hintExpected := normalizeExpectedValueKind(expected);
        blockId := ctx.nextCtxId(ctxs);
        blockLabel := if isCTagBlk { "lt_b_" + blockId.toText() } else { "lite$b" + blockId.toText() };
        blockValVar := if isCTagBlk { "lt_bval_" + blockId.toText() } else { "lite$val" + blockId.toText() };
        tagDepth := if isCTagBlk { iifeDepth } else { iifeDepth + 1 };
        taggedLexDepthStr := (ir.maxLocalLexDepth(locals) + 1).toText();
        pass1ValKind := if hintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + hintExpected };
        pass1Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
        iifeDepth = tagDepth, valKind = pass1ValKind, valVar = blockValVar, label = blockLabel,
        iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        pass1 := parseBinaryCtx(target, source, tagBlockBrace, prefix, locals, functions, params, currentName,
        hintExpected, 0, ctx.appendCtx(ctxs, pass1Ctx), tagDepth, true, "tagged", aliases);
        var result := pass1;
        if not inferMode {
            inferredKind := pass1.kind;
            pass2Expected := if inferredKind == ir.VALUE_KIND_UNIT or inferredKind == ir.VALUE_KIND_NEVER { "" } else { inferredKind };
            pass2Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
            iifeDepth = tagDepth, valKind = inferredKind, valVar = blockValVar, label = blockLabel,
            iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
            result = parseBinaryCtx(target, source, tagBlockBrace, prefix, locals, functions, params, currentName,
            pass2Expected, 0, ctx.appendCtx(ctxs, pass2Ctx), tagDepth, false, "tagged", aliases);
        }
        afterTaggedClose := syntax.skipTrivia(source, result.next, prefix);
        if afterTaggedClose < tagSourceSize and source.wordAt(afterTaggedClose, "then") {
            syntax.failAt(source, afterTaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterTaggedClose < tagSourceSize and source.wordAt(afterTaggedClose, "finally") {
            taggedFinCtx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_FINALLY,
            iifeDepth = tagDepth, valKind = result.kind, valVar = blockValVar, label = blockLabel,
            iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
            finParsed := parseFinallyClause(target, source, afterTaggedClose, prefix, locals, functions, params, currentName,
            ctx.appendCtx(ctxs, taggedFinCtx), tagDepth, inferMode, aliases);
            if isCTagBlk {
                result = finishFinallyC(result.code, finParsed, result.kind, result, inferMode, ctxs, blockId);
            } else {
                taggedTryBody := if result.kind == ir.VALUE_KIND_UNIT {
                    "void (" + result.code + "); return undefined;"
                } else if result.kind == ir.VALUE_KIND_NEVER {
                    "(" + result.code + ");"
                } else {
                    "return " + result.code + ";"
                };
                result = finishFinallyIife(taggedTryBody, finParsed, result.kind, result, inferMode);
            }
        }
        return result;
    }
    if afterTag < tagSourceSize and (source.wordAt(afterTag, "if") or source.wordAt(afterTag, "match")) {
        condKind := if source.wordAt(afterTag, "if") { ir.CTX_KIND_IF } else { ir.CTX_KIND_MATCH };
        return parseCondExpr(target, source, condKind, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if afterTag < tagSourceSize and source.wordAt(afterTag, "loop") {
        return parseLoopExpr(target, source, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    syntax.failAt(source, afterTag, prefix, "expected {, do, if, match, loop or . after block tag @" + tagInfo.tag);
    ctx.intParsed("", 0, true, start)
};

/** Parsed entry of one `context (...) { ... }` lexical override block. */
pub ContextOverridePlan := record {
    afterOpenBrace: Int;
    slotNames: List<String>;
    mutFlags: List<Bool>;
    kinds: List<String>;
    runtimes: List<String>;
    provTexts: List<String>;
    borrowMarks: List<String>;
    borrowDeclsMut: List<Bool>;
    tempNames: List<String>;
    tempRuntimes: List<String>;
    tempKinds: List<String>;
    tempMuts: List<Bool>;
    tempCodes: List<String>;
    tempInts: List<Int>;
    tempTexts: List<String>;
};

/** Parses and validates `context (...) {` override entries against `locals`, enforcing mutability, borrow exclusivity, and alias uniqueness. */
pub parseContextOverrideHeader := fn(target: String, source: String, kwPos: Int, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): ContextOverridePlan {
    size := source.length();
    var cursor := syntax.skipTrivia(source, kwPos + 7, prefix);
    cursor = syntax.expectSymbol(source, cursor, "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    if cursor < size and source.at(cursor) == ")" {
        syntax.failAt(source, cursor, prefix, "context override list cannot be empty");
    }
    mut slotNames: List<String> = [];
    mut mutFlags: List<Bool> = [];
    mut kinds: List<String> = [];
    mut runtimes: List<String> = [];
    mut provTexts: List<String> = [];
    mut borrowMarks: List<String> = [];
    mut borrowDeclsMut: List<Bool> = [];
    mut tempNames: List<String> = [];
    mut tempRuntimes: List<String> = [];
    mut tempKinds: List<String> = [];
    mut tempMuts: List<Bool> = [];
    mut tempCodes: List<String> = [];
    mut tempInts: List<Int> = [];
    mut tempTexts: List<String> = [];
    mut mutBoundRts: List<String> = [];
    mut roBoundRts: List<String> = [];
    var slotIdx := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        var lhsMut := false;
        if source.wordAt(cursor, "mut") {
            lhsMut = true;
            cursor = syntax.skipTrivia(source, cursor + 3, prefix);
        }
        var slotName := "";
        var slotPos := cursor;
        var rhsStart := cursor;
        var isShorthand := false;
        if cursor < size and syntax.isSingleEquals(source, cursor) {
            idStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if idStart >= size or not source.at(idStart).isNameStart() {
                syntax.failAt(source, idStart, prefix, "expected identifier after = in context override");
            }
            idEnd := source.skipName(idStart);
            cand := source.slice(idStart, idEnd);
            if syntax.isReservedWord(cand) { syntax.unsupportedFeature(source, idStart, cand, prefix); }
            slotName = cand;
            slotPos = idStart;
            rhsStart = idStart;
            isShorthand = true;
        } else {
            if cursor >= size or not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected context slot name");
            }
            nEnd := source.skipName(cursor);
            slotName = source.slice(cursor, nEnd);
            if syntax.isReservedWord(slotName) { syntax.unsupportedFeature(source, cursor, slotName, prefix); }
            afterN := syntax.skipTrivia(source, nEnd, prefix);
            if not syntax.isSingleEquals(source, afterN) {
                syntax.failAt(source, afterN, prefix, "expected = after context slot " + slotName);
            }
            rhsStart = syntax.skipTrivia(source, afterN + 1, prefix);
        }
        if slotNames.contains(slotName) {
            syntax.failAt(source, slotPos, prefix, "duplicate context slot " + slotName);
        }
        rhsMut := if not isShorthand and rhsStart < size and source.wordAt(rhsStart, "mut") { true } else { false };
        valStart := if rhsMut { syntax.skipTrivia(source, rhsStart + 3, prefix) } else { rhsStart };
        isSlotMut := lhsMut or rhsMut;
        mut slotNames.pushBack(slotName);
        mut mutFlags.pushBack(isSlotMut);
        var bareIdent := "";
        var bareAfter := valStart;
        if valStart < size and source.at(valStart).isNameStart() {
            bEnd := source.skipName(valStart);
            bCand := source.slice(valStart, bEnd);
            bAfter := syntax.skipTrivia(source, bEnd, prefix);
            if not syntax.isReservedWord(bCand) and bAfter < size and (source.at(bAfter) == "," or source.at(bAfter) == ")") {
                bareIdent = bCand;
                bareAfter = bAfter;
            }
        }
        locIdx := if bareIdent =!= "" { sym.localIndex(locals, bareIdent) } else { -1 };
        if locIdx >= 0 and locals[locIdx].depth >= -1 {
            loc := locals[locIdx];
            if loc.initState =!= ir.INIT_STATE_INIT {
                syntax.failAt(source, valStart, prefix, "cannot read uninitialized local " + bareIdent);
            }
            if loc.textValue == "ctx_closure_forbidden" {
                syntax.failAt(source, valStart, prefix, "cannot capture borrowed or mut context '" + bareIdent + "' in a closure; declare context(...) on the closure instead");
            }
            if loc.textValue == "closure_forbidden" {
                msg := if types.containsDynKind(loc.kind) { "borrowed dyn Interface cannot be captured by closure" } else { "borrowed Slice<T> cannot be captured by closure" };
                syntax.failAt(source, valStart, prefix, msg);
            }
            if isSlotMut {
                if not loc.mutable and not loc.writable {
                    syntax.failAt(source, valStart, prefix, "cannot bind immutable binding " + bareIdent + " as mut context");
                }
                sliceBorrows.checkCanMutateBinding(locals, loc.runtime, bareIdent, source, valStart, prefix);
                if mutBoundRts.contains(loc.runtime) or roBoundRts.contains(loc.runtime) {
                    syntax.failAt(source, valStart, prefix, "cannot bind " + bareIdent + " multiple times in context override");
                }
                mut mutBoundRts.pushBack(loc.runtime);
                bProv := "borrow_mut:" + loc.runtime + "#" + loc.depth.toText() + "#" + bareIdent;
                mut borrowMarks.pushBack(bProv);
                mut borrowDeclsMut.pushBack(true);
                mut kinds.pushBack(loc.kind);
                mut runtimes.pushBack(loc.runtime);
                mut provTexts.pushBack(if loc.textValue.startsWithAt(0, "borrow_") { loc.textValue } else { bProv });
            } else {
                sliceBorrows.checkCanReadBinding(locals, loc.runtime, bareIdent, source, valStart, prefix);
                if mutBoundRts.contains(loc.runtime) {
                    syntax.failAt(source, valStart, prefix, "cannot bind " + bareIdent + " both immutably and as mut context");
                }
                mut roBoundRts.pushBack(loc.runtime);
                bProv := "borrow_ro:" + loc.runtime + "#" + loc.depth.toText() + "#" + bareIdent;
                mut borrowMarks.pushBack(bProv);
                mut borrowDeclsMut.pushBack(false);
                mut kinds.pushBack(loc.kind);
                mut runtimes.pushBack(loc.runtime);
                mut provTexts.pushBack(if loc.textValue.startsWithAt(0, "borrow_") { loc.textValue } else { bProv });
            }
            cursor = bareAfter;
        } else {
            if rhsMut {
                syntax.failAt(source, rhsStart, prefix, "expected a binding name after mut");
            }
            rhsParsed := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
            if rhsParsed.kind == ir.VALUE_KIND_UNIT {
                syntax.failAt(source, rhsStart, prefix, "context slot " + slotName + " cannot have type Unit");
            }
            tmpName := "$ctxtmp_" + slotName + "_" + slotIdx.toText();
            tmpRt := ir.freshScopeTemp(locals, "lt_ctxo" + slotIdx.toText());
            mut tempNames.pushBack(tmpName);
            mut tempRuntimes.pushBack(tmpRt);
            mut tempKinds.pushBack(rhsParsed.kind);
            mut tempMuts.pushBack(isSlotMut);
            mut tempCodes.pushBack(rhsParsed.code);
            mut tempInts.pushBack(rhsParsed.intValue);
            mut tempTexts.pushBack(rhsParsed.textValue);
            mut kinds.pushBack(rhsParsed.kind);
            mut runtimes.pushBack(tmpRt);
            mut provTexts.pushBack(rhsParsed.textValue);
            mut borrowMarks.pushBack("");
            mut borrowDeclsMut.pushBack(false);
            cursor = syntax.skipTrivia(source, rhsParsed.next, prefix);
        }
        slotIdx = slotIdx + 1;
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ")" {
                syntax.failAt(source, cursor, prefix, "expected context slot name");
            }
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    openBrace := syntax.skipTrivia(source, cursor, prefix);
    if openBrace >= size or source.at(openBrace) =!= "{" {
        syntax.failAt(source, openBrace, prefix, "expected { after context(...)");
    }
    ContextOverridePlan {
        afterOpenBrace = openBrace + 1,
        slotNames = slotNames,
        mutFlags = mutFlags,
        kinds = kinds,
        runtimes = runtimes,
        provTexts = provTexts,
        borrowMarks = borrowMarks,
        borrowDeclsMut = borrowDeclsMut,
        tempNames = tempNames,
        tempRuntimes = tempRuntimes,
        tempKinds = tempKinds,
        tempMuts = tempMuts,
        tempCodes = tempCodes,
        tempInts = tempInts,
        tempTexts = tempTexts
    }
};

/** Parses expression-position `context (...) { ... }` block with lexical overrides and deterministic cleanup. */
parseContextOverrideExpr := fn(target: String, source: String, kwPos: Int, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool,
bodySink: String, aliases: List<AliasDecl>): Parsed {
    ovPlan := parseContextOverrideHeader(target, source, kwPos, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    innerDepth := ir.maxLocalLexDepth(locals) + 1;
    mut innerLocals: List<Local> = locals;
    mut preDecls: List<String> = [];
    mut postDrops: List<String> = [];
    var ti := 0;
    loop ti < ovPlan.tempNames.length() {
        tName := ovPlan.tempNames[ti];
        tRt := ovPlan.tempRuntimes[ti];
        tKind := ovPlan.tempKinds[ti];
        tMut := ovPlan.tempMuts[ti];
        tCode := ovPlan.tempCodes[ti];
        mut innerLocals.pushBack((name = tName, runtime = tRt, kind = tKind,
        mutable = tMut, writable = tMut, depth = innerDepth, constant = false, code = tCode,
        intValue = ovPlan.tempInts[ti], textValue = ovPlan.tempTexts[ti], initState = ir.INIT_STATE_INIT));
        if not inferMode {
            copied := ctx.copiedValueCode(target, tKind, tCode);
            if target == ir.TARGET_C {
                cT := types.cValueType(tKind);
                mut preDecls.pushBack("/*@T:" + tKind + "@*/" + cT + " " + tRt + " = " + copied + "; (void)" + tRt + ";");
                dFn := types.cDropFnForKind(tKind);
                if dFn =!= "" { mut postDrops.pushBack(dFn + "(&" + tRt + ");"); }
            } else {
                mut preDecls.pushBack((if tMut { "let " } else { "const " }) + tRt + ": " + types.tsFunctionType(tKind) + " = " + copied + ";");
            }
        }
        ti = ti + 1;
    }
    var si := 0;
    loop si < ovPlan.slotNames.length() {
        sName := ovPlan.slotNames[si];
        sMut := ovPlan.mutFlags[si];
        sKind := ovPlan.kinds[si];
        sRt := ovPlan.runtimes[si];
        sProv := ovPlan.provTexts[si];
        bMark := ovPlan.borrowMarks[si];
        if bMark =!= "" {
            mut innerLocals.pushBack((name = "$ctxborrow:" + sName, runtime = "", kind = "CtxBorrow",
            mutable = false, writable = false, depth = innerDepth, constant = false, code = "",
            intValue = 0, textValue = bMark, initState = ir.INIT_STATE_INIT));
        }
        isBorrow := types.isSliceKind(sKind) or types.isDynKind(sKind);
        outerBareIdx := sym.localIndex(locals, sName);
        mut innerLocals.pushBack((name = "$ctxslot:" + sName, runtime = sRt, kind = sKind,
        mutable = sMut and not isBorrow, writable = sMut, depth = innerDepth, constant = false, code = "",
        intValue = 0, textValue = sProv, initState = ir.INIT_STATE_INIT));
        if outerBareIdx >= 0 and locals[outerBareIdx].textValue.startsWithAt(0, "ctx_param:") {
            shadowProv := if isBorrow { "ctx_param:borrow" } else if sMut { "ctx_param:mut" } else { "ctx_param:ro" };
            mut innerLocals.pushBack((name = sName, runtime = sRt, kind = sKind,
            mutable = sMut and not isBorrow, writable = sMut, depth = innerDepth, constant = false, code = sRt,
            intValue = 0, textValue = shadowProv, initState = ir.INIT_STATE_INIT));
        }
        si = si + 1;
    }
    hasTemps := preDecls.length() > 0;
    bodyDepth := if hasTemps and target == ir.TARGET_TS { iifeDepth + 1 } else { iifeDepth };
    blkRes := parseBlockExpr(target, source, ovPlan.afterOpenBrace - 1, prefix, innerLocals, functions, params, currentName, expected, minimum, ctxs, bodyDepth, inferMode, bodySink, aliases);
    if inferMode or not hasTemps {
        return blkRes;
    }
    if target == ir.TARGET_C {
        fnCtxIdxOv := ctx.findCtxByKindIndex(ctxs, "fn");
        fnRetKOv := if fnCtxIdxOv >= 0 { ctxs[fnCtxIdxOv].valKind } else { "" };
        dropsStr := postDrops.join(" ");
        if blkRes.kind == ir.VALUE_KIND_UNIT or blkRes.kind == ir.VALUE_KIND_NEVER {
            rawTail := ctx.cUnwrapIntoVar("", blkRes.kind, blkRes.code);
            rewrittenTail := if dropsStr =!= "" { ctx.cRewriteExitDrops(rawTail, dropsStr, dropsStr, fnRetKOv, ovPlan.afterOpenBrace) } else { rawTail };
            wrappedCode := "/*@CBLK:0@*/{ " + preDecls.join(" ") + " " + rewrittenTail + (if dropsStr =!= "" { " " + dropsStr } else { "" }) + " }";
            return (kind = blkRes.kind, code = wrappedCode, intValue = blkRes.intValue, textValue = blkRes.textValue, constant = false, next = blkRes.next);
        }
        ovVar := freshCOwnedTemp("lt_ov_");
        rawAssign := ctx.cUnwrapIntoVar(ovVar, blkRes.kind, ctx.copiedValueCode(target, blkRes.kind, blkRes.code));
        rewrittenAssign := if dropsStr =!= "" { ctx.cRewriteExitDrops(rawAssign, dropsStr, dropsStr, fnRetKOv, ovPlan.afterOpenBrace) } else { rawAssign };
        wrappedCode := "/*@CBLK:" + ovVar + "@*/" + types.cValueType(blkRes.kind) + " " + ovVar + "; { " + preDecls.join(" ") + " " + rewrittenAssign + (if dropsStr =!= "" { " " + dropsStr } else { "" }) + " }";
        return (kind = blkRes.kind, code = wrappedCode, intValue = blkRes.intValue, textValue = blkRes.textValue, constant = false, next = blkRes.next);
    }
    retStmt := if blkRes.kind == ir.VALUE_KIND_NEVER {
        "(" + blkRes.code + ");"
    } else if blkRes.kind == ir.VALUE_KIND_UNIT {
        "void (" + blkRes.code + "); return undefined;"
    } else {
        "return " + blkRes.code + ";"
    };
    (kind = blkRes.kind, code = "(() => { " + preDecls.join(" ") + " " + retStmt + " })()", intValue = blkRes.intValue, textValue = blkRes.textValue, constant = false, next = blkRes.next)
};

/** Parses a `fn(...) { ... }` anonymous/closure function literal expression starting after `fn`. */
parseFnLiteralExpr := fn(target: String, source: String, nameStart: Int, afterKw: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    isCFnLit := target == ir.TARGET_C;
    size := source.length();
    var cursor := syntax.expectSymbol(source, syntax.skipTrivia(source, afterKw, prefix), "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    hasExpectedFn := types.isFnKind(expected);
    expectedParamCount := if hasExpectedFn { types.fnParamCount(expected) } else { 0 };
    fnLexDepth := ir.maxLocalLexDepth(locals) + 1;
    selfRuntime := if isCFnLit { "lt_self_" + nameStart.toText() } else { ir.freshScopeTemp(locals, "lite$self") };
    mut fnLocals: List<Local> = [];
    mut fnLocals.pushBack((name = "$self", runtime = selfRuntime, kind = "",
    mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
    intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
    loop locals as outerEntry {
        if outerEntry.name =!= "$self" and outerEntry.name =!= "$self_fn_rt" and outerEntry.depth >= -1 {
            capturedInit := if outerEntry.initState == ir.INIT_STATE_UNINIT_ASSIGNED { ir.INIT_STATE_INIT }
            else if (outerEntry.initState == ir.INIT_STATE_UNINIT or ir.isInitStateMaybe(outerEntry.initState)) and not outerEntry.mutable { ir.INIT_STATE_MAYBE }
            else if ir.isInitStateMaybe(outerEntry.initState) { ir.INIT_STATE_MAYBE }
            else { outerEntry.initState };
            capturedConst := if outerEntry.mutable or outerEntry.writable { false } else { outerEntry.constant };
            isUnarrowMut := outerEntry.mutable and outerEntry.textValue.startsWithAt(0, "$unarrow:");
            effCapKind := if isUnarrowMut { unwrapUnionOrigin(outerEntry).kind } else { outerEntry.kind };
            effCapText := if isUnarrowMut { "" } else { outerEntry.textValue };
            isCtxEntry := outerEntry.name.startsWithAt(0, "$ctxslot:") or outerEntry.textValue.startsWithAt(0, "ctx_param:");
            isForbidden := types.containsSliceKind(effCapKind) or types.containsDynKind(effCapKind) or
            (isCtxEntry and (outerEntry.mutable or outerEntry.writable or effCapText == "closure_forbidden" or effCapText == "ctx_closure_forbidden"));
            capturedText := if isForbidden {
                if isCtxEntry and not types.containsSliceKind(effCapKind) and not types.containsDynKind(effCapKind) { "ctx_closure_forbidden" }
                else if isCtxEntry { "ctx_closure_forbidden" }
                else { "closure_forbidden" }
            } else { effCapText };
            mut fnLocals.pushBack((name = outerEntry.name, runtime = outerEntry.runtime, kind = effCapKind,
            mutable = outerEntry.mutable, writable = outerEntry.writable, depth = outerEntry.depth, constant = capturedConst,
            code = outerEntry.code, intValue = outerEntry.intValue, textValue = capturedText, initState = capturedInit));
        }
    }
    loop locals as outerEntry {
        if outerEntry.depth <= -2 {
            futLexDepth := 0 - 2 - outerEntry.depth;
            if trace.latestActiveLocalByRuntime(locals, outerEntry.runtime) < 0 and
            not ir.localsHasDeeperReachedName(locals, outerEntry.name, futLexDepth) {
                capturedFutText := if types.containsSliceKind(outerEntry.kind) or types.containsDynKind(outerEntry.kind) { "closure_forbidden" } else { "" };
                mut fnLocals.pushBack((name = outerEntry.name, runtime = outerEntry.runtime, kind = outerEntry.kind,
                mutable = outerEntry.mutable, writable = outerEntry.writable, depth = -1, constant = false,
                code = outerEntry.code, intValue = 0, textValue = capturedFutText, initState = outerEntry.initState));
            }
        }
    }
    mut rawParamNames: List<String> = [];
    var preScanCur := cursor;
    loop preScanCur < size and source.at(preScanCur) =!= ")" {
        if not source.at(preScanCur).isNameStart() { break; }
        pnEnd := source.skipName(preScanCur);
        mut rawParamNames.pushBack(source.slice(preScanCur, pnEnd));
        preScanCur = syntax.skipBalancedArgument(source, preScanCur, prefix);
        preScanCur = syntax.skipTrivia(source, preScanCur, prefix);
        if preScanCur < size and source.at(preScanCur) == "," {
            preScanCur = syntax.skipTrivia(source, preScanCur + 1, prefix);
            if preScanCur < size and source.at(preScanCur) == ")" { break; }
        } else { break; }
    }
    mut paramNames: List<String> = [];
    mut paramKinds: List<String> = [];
    mut paramOpts: List<Bool> = [];
    mut paramDefCodes: List<String> = [];
    mut paramRawRuntimes: List<String> = [];
    mut encodedKindBuf: tb.TextBuilder;
    mut encodedKindBuf.append("fn(");
    var paramIdx := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        pStart := cursor;
        if not source.at(pStart).isNameStart() {
            syntax.failAt(source, pStart, prefix, "expected a parameter name");
        }
        pEnd := source.skipName(pStart);
        pName := source.slice(pStart, pEnd);
        if syntax.isReservedWord(pName) { syntax.unsupportedFeature(source, pStart, pName, prefix); }
        if paramNames.contains(pName) {
            syntax.failAt(source, pStart, prefix, "duplicate parameter " + pName);
        }
        (mut paramNames).pushBack(pName);
        cursor = syntax.skipTrivia(source, pEnd, prefix);
        if cursor < size and source.at(cursor) == "?" {
            syntax.failAt(source, cursor, prefix, "default parameters in function definitions must use = expression; ? is only for function type signatures");
        }
        var pKind := "";
        var pOpt := false;
        var pDefCode := "";
        pRuntime := ir.localRuntimeName(target, fnLocals, pName, "", fnLexDepth);
        if cursor < size and syntax.isSingleEquals(source, cursor) {
            pOpt = true;
            defStart := syntax.skipTrivia(source, cursor + 1, prefix);
            defHint := if hasExpectedFn and paramIdx < expectedParamCount { types.fnParamComponent(expected, paramIdx).kind } else { "" };
            mut evalDefLocals: List<Local> = fnLocals;
            var fwi := paramIdx;
            loop fwi < rawParamNames.length() {
                fwNm := rawParamNames[fwi];
                mut evalDefLocals.pushBack((name = fwNm, runtime = "$param_fwd", kind = "", mutable = false, writable = false,
                depth = fnLexDepth + 1, constant = false, code = "", intValue = 0, textValue = "$param_fwd:" + pName + ":" + fwNm, initState = ir.INIT_STATE_INIT));
                fwi = fwi + 1;
            }
            sym.invalidateLocals();
            defParsed := parseBinaryCtx(target, source, defStart, prefix, evalDefLocals, functions, params, "<fn>", defHint, 0, ctxs, iifeDepth, inferMode, "", aliases);
            sym.invalidateLocals();
            if defHint =!= "" {
                pKind = defHint;
                if not inferMode and not types.isCompatibleKind(pKind, defParsed.kind) {
                    syntax.failAt(source, defStart, prefix, "default for parameter " + pName + " must be " + types.displayKind(pKind) + ", got " + types.displayKind(defParsed.kind));
                }
            } else {
                if defParsed.kind == "" {
                    syntax.failAt(source, defStart, prefix, "could not infer type for default parameter " + pName);
                }
                if defParsed.kind == ir.VALUE_KIND_UNIT or defParsed.kind == ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, defStart, prefix, "cannot infer parameter " + pName + " type from " + types.displayKind(defParsed.kind));
                }
                bErr := types.borrowedStorageError(defParsed.kind);
                if bErr =!= "" { syntax.failAt(source, defStart, prefix, bErr); }
                pKind = defParsed.kind;
            }
            pDefCode = if inferMode { "" } else { ctx.assignValueCode(target, pKind, defParsed.kind, defParsed.code) };
            cursor = syntax.skipTrivia(source, defParsed.next, prefix);
        } else {
            if cursor < size and source.at(cursor) == ":" {
                var pAccess := "";
                var tCursor := syntax.skipTrivia(source, cursor + 1, prefix);
                if source.wordAt(tCursor, "mut") {
                    pAccess = "mut ";
                    tCursor = syntax.skipTrivia(source, tCursor + 3, prefix);
                }
                typedParam := types.parseFunctionType(source, tCursor, prefix, aliases, "");
                if pAccess =!= "" and not types.isMutContainerKind(typedParam.kind) {
                    syntax.failAt(source, tCursor, prefix, "mut parameter signatures are reserved for List, Map, Set, or record parameters or registered core declarations");
                }
                pKind = pAccess + typedParam.kind;
                cursor = syntax.skipTrivia(source, typedParam.next, prefix);
            } else if hasExpectedFn and paramIdx < expectedParamCount {
                pKind = types.fnParamComponent(expected, paramIdx).kind;
            } else {
                syntax.failAt(source, pStart, prefix, "expected : Type for parameter " + pName);
            }
            pBaseChk := if pKind.startsWithAt(0, "mut ") { pKind.slice(4, pKind.length()) } else { pKind };
            if pBaseChk == ir.VALUE_KIND_UNIT {
                syntax.failAt(source, pStart, prefix, "function parameter " + pName + " cannot have type Unit");
            }
            if cursor < size and syntax.isSingleEquals(source, cursor) {
                if pKind.startsWithAt(0, "mut ") {
                    syntax.failAt(source, cursor, prefix, "mut parameters cannot have default values");
                }
                pOpt = true;
                defStart := syntax.skipTrivia(source, cursor + 1, prefix);
                mut evalDefLocals: List<Local> = fnLocals;
                var fwi := paramIdx;
                loop fwi < rawParamNames.length() {
                    fwNm := rawParamNames[fwi];
                    mut evalDefLocals.pushBack((name = fwNm, runtime = "$param_fwd", kind = "", mutable = false, writable = false,
                    depth = fnLexDepth + 1, constant = false, code = "", intValue = 0, textValue = "$param_fwd:" + pName + ":" + fwNm, initState = ir.INIT_STATE_INIT));
                    fwi = fwi + 1;
                }
                sym.invalidateLocals();
                defParsed := parseBinaryCtx(target, source, defStart, prefix, evalDefLocals, functions, params, "<fn>", pKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
                sym.invalidateLocals();
                if not inferMode and not types.isCompatibleKind(pKind, defParsed.kind) {
                    syntax.failAt(source, defStart, prefix, "default for parameter " + pName + " must be " + types.displayKind(pKind) + ", got " + types.displayKind(defParsed.kind));
                }
                pDefCode = if inferMode { "" } else { ctx.assignValueCode(target, pKind, defParsed.kind, defParsed.code) };
                cursor = syntax.skipTrivia(source, defParsed.next, prefix);
            }
        }
        (mut paramKinds).pushBack(pKind);
        (mut paramOpts).pushBack(pOpt);
        (mut paramDefCodes).pushBack(pDefCode);
        (mut paramRawRuntimes).pushBack(pRuntime);
        pIsMutL := pKind.startsWithAt(0, "mut ");
        pBaseKL := if pIsMutL { pKind.slice(4, pKind.length()) } else { pKind };
        isBorrowL := types.isSliceKind(pBaseKL) or types.isDynKind(pBaseKL);
        bindRuntime := if pIsMutL and not isBorrowL and isCFnLit { "(*" + pRuntime + ")" }
        else if pIsMutL and not isCFnLit and types.isRecordOrDistinctRecord(pBaseKL) { pRuntime + ".v" }
        else { pRuntime };
        mut fnLocals.pushBack((name = pName, runtime = bindRuntime, kind = pBaseKL,
        mutable = false, writable = pIsMutL, depth = fnLexDepth, constant = false, code = bindRuntime,
        intValue = 0, textValue = if isBorrowL { "borrow_param:" } else { "" }, initState = ir.INIT_STATE_INIT));
        if paramIdx > 0 { mut encodedKindBuf.append(","); }
        mut encodedKindBuf.append(pName);
        if pOpt { mut encodedKindBuf.append("?"); }
        mut encodedKindBuf.append(":");
        mut encodedKindBuf.append(pKind);
        paramIdx = paramIdx + 1;
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ")" { break; }
        } else {
            break;
        }
    }
    encodedKind := encodedKindBuf.build();
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    var fnCtxKind := "";
    if cursor < size and source.wordAt(cursor, "context") {
        ctxClause := types.parseContextClause(source, cursor, prefix, aliases, "");
        fnCtxKind = ctxClause.ctxKind;
        cursor = syntax.skipTrivia(source, ctxClause.next, prefix);
    }
    var retKind := "";
    if cursor < size and source.at(cursor) == ":" {
        typedRet := types.parseFunctionType(source, cursor + 1, prefix, aliases, "");
        retKind = typedRet.kind;
        cursor = syntax.skipTrivia(source, typedRet.next, prefix);
    } else if hasExpectedFn {
        retKind = types.fnResultKind(expected);
    } else {
        syntax.failAt(source, cursor, prefix, "expected : ReturnType in function expression");
    }
    if cursor < size and source.at(cursor) == "#" {
        tagPos := syntax.skipTrivia(source, cursor + 1, prefix);
        if tagPos < size and source.at(tagPos).isNameStart() {
            tagEnd := source.skipName(tagPos);
            tagName := source.slice(tagPos, tagEnd);
            if tagName == "host" {
                syntax.failAt(source, cursor, prefix, "#host declarations are only allowed as top-level pub declarations in core/type/external/gfx host modules");
            }
            syntax.failAt(source, cursor, prefix, "unknown function attribute #" + tagName);
        }
    }
    if cursor >= size or source.at(cursor) =!= "{" {
        syntax.failAt(source, cursor, prefix, "expected { for function body");
    }
    if retKind =!= "$InferRet" and types.containsSliceKind(retKind) {
        syntax.failAt(source, cursor, prefix, "borrowed Slice<T> cannot escape via function return type");
    }
    if retKind =!= "$InferRet" and types.containsDynKind(retKind) {
        syntax.failAt(source, cursor, prefix, "borrowed dyn Interface cannot escape via function return type");
    }
    fnAtCtx := if contexts.isCtxKind(fnCtxKind) { "@ctx(" + fnCtxKind.slice(4, fnCtxKind.length() - 1) + ")" } else { "" };
    var fnKind := encodedKind + ")" + fnAtCtx + ":" + retKind;
    fnLocals[0] = (name = "$self", runtime = selfRuntime, kind = fnKind,
    mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
    intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT);
    mut tsParamsBuf: tb.TextBuilder;
    mut cParamsBuf: tb.TextBuilder;
    mut cParamsBuf.append("void *_env");
    mut paramVoidBuf: tb.TextBuilder;
    mut optDropsBuf: tb.TextBuilder;
    mut paramRuntimes: List<String> = [];
    var pBindIdx := 0;
    loop pBindIdx < paramIdx {
        pName := paramNames[pBindIdx];
        pKind := paramKinds[pBindIdx];
        pOpt := paramOpts[pBindIdx];
        pDefCode := paramDefCodes[pBindIdx];
        pRuntime := paramRawRuntimes[pBindIdx];
        mut paramRuntimes.pushBack(pRuntime);
        pSafe := ir.safeTargetIdent(ir.TARGET_C, pName) + "_" + pBindIdx.toText();
        if pBindIdx > 0 { mut tsParamsBuf.append(", "); }
        if pOpt {
            mut tsParamsBuf.append("lite__opt_");
            mut tsParamsBuf.append(pRuntime);
            mut tsParamsBuf.append("?: ");
            mut tsParamsBuf.append(types.tsFunctionType(pKind));
            mut cParamsBuf.append(", bool lt_has_");
            mut cParamsBuf.append(pSafe);
            mut cParamsBuf.append(", ");
            mut cParamsBuf.append(types.cValueType(pKind));
            mut cParamsBuf.append(" ");
            mut cParamsBuf.append(pRuntime);
            if isCFnLit {
                mut paramVoidBuf.append("(void)lt_has_");
                mut paramVoidBuf.append(pSafe);
                mut paramVoidBuf.append("; (void)");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append("; ");
                if not inferMode {
                    dFn := types.cDropFnForKind(pKind);
                    unwrapDef := ctx.cUnwrapIntoVar(pRuntime, pKind, pDefCode);
                    if dFn =!= "" {
                        ownVar := "lt_own_" + pSafe;
                        mut paramVoidBuf.append("uint8_t ");
                        mut paramVoidBuf.append(ownVar);
                        mut paramVoidBuf.append(" = 0; (void)");
                        mut paramVoidBuf.append(ownVar);
                        mut paramVoidBuf.append("; if (!lt_has_");
                        mut paramVoidBuf.append(pSafe);
                        mut paramVoidBuf.append(") { ");
                        mut paramVoidBuf.append(unwrapDef);
                        mut paramVoidBuf.append(" ");
                        mut paramVoidBuf.append(ownVar);
                        mut paramVoidBuf.append(" = 1; } ");
                        mut optDropsBuf.append("if (");
                        mut optDropsBuf.append(ownVar);
                        mut optDropsBuf.append(") { ");
                        mut optDropsBuf.append(dFn);
                        mut optDropsBuf.append("(&");
                        mut optDropsBuf.append(pRuntime);
                        mut optDropsBuf.append("); ");
                        mut optDropsBuf.append(ownVar);
                        mut optDropsBuf.append(" = 0; } ");
                    } else {
                        mut paramVoidBuf.append("if (!lt_has_");
                        mut paramVoidBuf.append(pSafe);
                        mut paramVoidBuf.append(") { ");
                        mut paramVoidBuf.append(unwrapDef);
                        mut paramVoidBuf.append(" } ");
                    }
                }
            } else {
                mut paramVoidBuf.append("void lite__opt_");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append("; const ");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append(": ");
                mut paramVoidBuf.append(types.tsFunctionType(pKind));
                mut paramVoidBuf.append(" = lite__opt_");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append(" !== undefined ? lite__opt_");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append(" : (");
                mut paramVoidBuf.append(pDefCode);
                mut paramVoidBuf.append("); void ");
                mut paramVoidBuf.append(pRuntime);
                mut paramVoidBuf.append("; ");
            }
        } else {
            pIsMutB := pKind.startsWithAt(0, "mut ");
            pBaseB := if pIsMutB { pKind.slice(4, pKind.length()) } else { pKind };
            tsParamT := if pIsMutB and types.isRecordOrDistinctRecord(pBaseB) { "{ v: " + types.tsFunctionType(pBaseB) + " }" } else { types.tsFunctionType(pBaseB) };
            cParamT := if pIsMutB and not types.isSliceKind(pBaseB) and not types.isDynKind(pBaseB) { types.cValueType(pBaseB) + " *" } else { types.cValueType(pBaseB) };
            mut tsParamsBuf.append(pRuntime);
            mut tsParamsBuf.append(": ");
            mut tsParamsBuf.append(tsParamT);
            mut cParamsBuf.append(", ");
            mut cParamsBuf.append(cParamT);
            mut cParamsBuf.append(" ");
            mut cParamsBuf.append(pRuntime);
            mut paramVoidBuf.append(if isCFnLit { "(void)" } else { "void " });
            mut paramVoidBuf.append(pRuntime);
            mut paramVoidBuf.append("; ");
        }
        pBindIdx = pBindIdx + 1;
    }
    clIdSuffix := nameStart.toText() + "_" + paramIdx.toText();
    clCtxName := if isCFnLit { "lite_ctx_" + clIdSuffix } else { "lite$ctx_" + clIdSuffix };
    if fnCtxKind =!= "" {
        if paramIdx > 0 { mut tsParamsBuf.append(", "); }
        mut tsParamsBuf.append(clCtxName);
        mut tsParamsBuf.append(": ");
        mut tsParamsBuf.append(types.tsFunctionType(fnCtxKind));
        if isCFnLit and fnCtxKind =!= "" {
            mut cParamsBuf.append(", const ");
            mut cParamsBuf.append(types.cCtxTag(fnCtxKind));
            mut cParamsBuf.append(" *");
            mut cParamsBuf.append(clCtxName);
            mut paramVoidBuf.append("if (");
            mut paramVoidBuf.append(clCtxName);
            mut paramVoidBuf.append(" == NULL) { fprintf(stderr, \"ContextPanic: null context pointer passed to closure without ambient defaults\\n\"); exit(1); } (void)");
            mut paramVoidBuf.append(clCtxName);
            mut paramVoidBuf.append("; ");
        } else {
            mut cParamsBuf.append(", const ");
            mut cParamsBuf.append(types.cCtxTag(fnCtxKind));
            mut cParamsBuf.append(" *");
            mut cParamsBuf.append(clCtxName);
            mut paramVoidBuf.append(if isCFnLit { "(void)" } else { "void " });
            mut paramVoidBuf.append(clCtxName);
            mut paramVoidBuf.append("; ");
        }
        loop contexts.parseCtxKindSlots(fnCtxKind) as cs {
            if paramNames.contains(cs.name) {
                syntax.failAt(source, cursor, prefix, "context slot " + cs.name + " conflicts with parameter of the same name");
            }
            isSlice := types.isSliceKind(cs.kind);
            isDyn := types.isDynKind(cs.kind);
            isBorrowView := isSlice or isDyn;
            fieldName := if isCFnLit { "slot_" + ir.safeTargetIdent(ir.TARGET_C, cs.name) } else { cs.name };
            fieldAccess := clCtxName + (if isCFnLit { "->" } else { "." }) + fieldName;
            slotRuntime := if isCFnLit {
                if isBorrowView { fieldAccess }
                else if cs.isMut or types.cParamIsConstPtr(cs.kind) { "(*(" + fieldAccess + "))" }
                else { fieldAccess }
            } else {
                if isBorrowView or not cs.isMut { fieldAccess }
                else { fieldAccess + ".v" }
            };
            mut paramRuntimes.pushBack(slotRuntime);
            provText := if isBorrowView { "ctx_param:borrow" } else if cs.isMut { "ctx_param:mut" } else { "ctx_param:ro" };
            mut fnLocals.pushBack((name = "$ctxslot:" + cs.name, runtime = slotRuntime, kind = cs.kind,
            mutable = cs.isMut and not isBorrowView, writable = cs.isMut, depth = fnLexDepth, constant = false,
            code = "", intValue = 1, textValue = provText, initState = ir.INIT_STATE_INIT));
            mut fnLocals.pushBack((name = cs.name, runtime = slotRuntime, kind = cs.kind,
            mutable = cs.isMut and not isBorrowView, writable = cs.isMut, depth = fnLexDepth, constant = false,
            code = slotRuntime, intValue = 0, textValue = provText, initState = ir.INIT_STATE_INIT));
        }
    }
    tsParamsCode := tsParamsBuf.build();
    cParamsCode := cParamsBuf.build();
    paramVoidStmts := paramVoidBuf.build();
    optDropsStmt := optDropsBuf.build().trim();
    fnBodyDepth := if isCFnLit { iifeDepth } else { iifeDepth + 1 };
    if retKind == "$InferRet" {
        inferFnCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FN, phase = ir.CTX_PHASE_BODY, iifeDepth = fnBodyDepth,
        valKind = "", valVar = "", label = "", iterLabel = fnLexDepth.toText(), countVar = "", itemVar = "",
        itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        emptyInferCtxs: List<ConstructCtx> = [];
        inferCtxs := ctx.appendCtx(emptyInferCtxs, inferFnCtx);
        sym.invalidateLocals();
        inferredBody := parseBinaryCtx(target, source, cursor, prefix, fnLocals, functions, params, "<fn>",
        "", 0, inferCtxs, fnBodyDepth, true, "exprOut", aliases);
        sym.invalidateLocals();
        if inferredBody.kind == "" {
            syntax.failAt(source, cursor, prefix, "could not infer return type of function expression");
        }
        retKind = inferredBody.kind;
        if types.containsSliceKind(retKind) {
            syntax.failAt(source, cursor, prefix, "borrowed Slice<T> cannot escape via function return type");
        }
        if types.containsDynKind(retKind) {
            syntax.failAt(source, cursor, prefix, "borrowed dyn Interface cannot escape via function return type");
        }
        fnKind = encodedKind + ")" + fnAtCtx + ":" + retKind;
        fnLocals[0] = (name = "$self", runtime = selfRuntime, kind = fnKind,
        mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT);
    }
    fnCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FN, phase = ir.CTX_PHASE_BODY, iifeDepth = fnBodyDepth,
    valKind = retKind, valVar = "", label = "", iterLabel = fnLexDepth.toText(), countVar = "", itemVar = "",
    itemKind = "", indexVar = "", hasIndex = false, colVar = "");
    emptyFnCtxs: List<ConstructCtx> = [];
    fnCtxs := ctx.appendCtx(emptyFnCtxs, fnCtx);
    var fnBodySink := "fnBody";
    if paramIdx > 0 {
        fnBodySink = "fnBody:" + paramNames.join(",");
    }
    sym.invalidateLocals();
    fnBody := parseBinaryCtx(target, source, cursor, prefix, fnLocals, functions, params, "<fn>",
    retKind, 0, fnCtxs, fnBodyDepth, inferMode, fnBodySink, aliases);
    sym.invalidateLocals();
    combinedScanCode := paramVoidStmts + fnBody.code;
    if not inferMode and fnCtxKind =!= "" {
        loop contexts.parseCtxKindSlots(fnCtxKind) as ucs {
            if not ucs.name.startsWithAt(0, "_") {
                cNeed := clCtxName + "->slot_" + ir.safeTargetIdent(ir.TARGET_C, ucs.name);
                tsNeed := clCtxName + "." + ucs.name;
                needSlot := if isCFnLit { cNeed } else { tsNeed };
                if combinedScanCode.indexOf(needSlot, 0) < 0 {
                    syntax.failAt(source, nameStart, prefix, "unused context slot '" + ucs.name + "'; remove it or prefix with '_' if intentionally unused");
                }
            }
        }
    }
    usesSelf := reach.codeUsesTextCall(combinedScanCode, selfRuntime);
    if isCFnLit {
        if inferMode {
            return ctx.withMarkers((kind = fnKind, code = "", intValue = 0, textValue = fnKind, constant = false, next = fnBody.next),
            ctx.collectParsedMarkers("", fnBody));
        }
        cFnTag := types.cFnTag(fnKind);
        cid := nameStart.toText() + "_" + paramIdx.toText();
        clName := "lt_cl_" + cid;
        envType := "lt_env_" + cid;
        cRetType := types.cValueType(retKind);
        mut capRuntimes: List<String> = [];
        mut capKinds: List<String> = [];
        mut capMutables: List<Bool> = [];
        var locScanIdx := 0;
        loop locals as le { locScanIdx = locScanIdx + 1; }
        var ri := locScanIdx - 1;
        loop ri >= 0 {
            le := locals[ri];
            isCell := le.runtime.startsWithAt(0, "(*lt_cell_");
            isDerefParam := le.runtime.startsWithAt(0, "(*lite_") and not isCell;
            isCtxField := le.runtime.indexOf("->", 0) >= 0;
            scanTok := if isCell or isDerefParam { le.runtime.slice(2, le.runtime.length() - 1) } else { le.runtime };
            if (le.depth > 0 or isCell or isDerefParam or isCtxField) and le.name =!= "$self" and not le.name.startsWithAt(0, "$ctxslot:") and scanTok =!= "" and
            not paramRuntimes.contains(le.runtime) and
            not capRuntimes.contains(le.runtime) and
            (if isCtxField { combinedScanCode.indexOf(le.runtime, 0) >= 0 } else { reach.codeUsesTextCall(combinedScanCode, scanTok) }) {
                mut capRuntimes.pushBack(le.runtime);
                mut capKinds.pushBack(le.kind);
                mut capMutables.pushBack(le.mutable or le.writable);
            }
            ri = ri - 1;
        }
        bodyWithOptDrops := if optDropsStmt =!= "" {
            rwBody := ctx.cRewriteExitDrops(fnBody.code, optDropsStmt, "", retKind, nameStart);
            if retKind == ir.VALUE_KIND_UNIT or retKind == ir.VALUE_KIND_NEVER {
                rwBody + " " + optDropsStmt
            } else {
                rwBody
            }
        } else {
            fnBody.code
        };
        capCount := capRuntimes.length();
        selfBind := if usesSelf { cFnTag + " " + selfRuntime + " = { " + clName + ", _env }; (void)" + selfRuntime + "; " } else { "" };
        if capCount == 0 {
            cFnDef := "static " + cRetType + " " + clName + "(" + cParamsCode + ") { (void)_env; /*@CFN_TEMPS@*/" + selfBind + paramVoidStmts + bodyWithOptDrops + " }";
            cExpr := "/*@T:" + fnKind + "@*//*@CFN_START:" + clName + "@*/" + cFnDef + "/*@CFN_END@*/((" + cFnTag + "){ " + clName + ", NULL })";
            return (kind = fnKind, code = cExpr, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next);
        }
        mut envFieldsBuf: tb.TextBuilder;
        mut envFieldsBuf.append("lt_env_hdr hdr; ");
        mut envUnpackBuf: tb.TextBuilder;
        mut mkParamsBuf: tb.TextBuilder;
        mut mkInitsBuf: tb.TextBuilder;
        mut mkArgsBuf: tb.TextBuilder;
        mut stkInitsBuf: tb.TextBuilder;
        mut dropBodyBuf: tb.TextBuilder;
        mut cloneBodyBuf: tb.TextBuilder;
        var bodyRewritten := bodyWithOptDrops;
        var ci := 0;
        loop ci < capCount {
            cRt := capRuntimes[ci];
            cK := capKinds[ci];
            cM := capMutables[ci];
            cT := types.cValueType(cK);
            isCell := cRt.startsWithAt(0, "(*lt_cell_");
            fName := "f_" + ci.toText();
            pName := "a_" + ci.toText();
            if ci > 0 {
                mut mkParamsBuf.append(", ");
                mut mkArgsBuf.append(", ");
            }
            mut stkInitsBuf.append(", .");
            mut stkInitsBuf.append(fName);
            mut stkInitsBuf.append(" = ");
            if isCell {
                cellPtr := cRt.slice(2, cRt.length() - 1);
                mut envFieldsBuf.append(cT);
                mut envFieldsBuf.append(" *");
                mut envFieldsBuf.append(fName);
                mut envFieldsBuf.append("; ");
                mut mkParamsBuf.append(cT);
                mut mkParamsBuf.append(" *");
                mut mkParamsBuf.append(pName);
                mut mkArgsBuf.append(cellPtr);
                mut stkInitsBuf.append(cellPtr);
                mut mkInitsBuf.append("e->");
                mut mkInitsBuf.append(fName);
                mut mkInitsBuf.append(" = (");
                mut mkInitsBuf.append(cT);
                mut mkInitsBuf.append(" *)lt_box_retain(");
                mut mkInitsBuf.append(pName);
                mut mkInitsBuf.append("); ");
                cellDropFn := types.cDropFnForKind(cK);
                if cellDropFn =!= "" {
                    mut dropBodyBuf.append("if (lt_box_dec(e->");
                    mut dropBodyBuf.append(fName);
                    mut dropBodyBuf.append(")) { ");
                    mut dropBodyBuf.append(cellDropFn);
                    mut dropBodyBuf.append("(e->");
                    mut dropBodyBuf.append(fName);
                    mut dropBodyBuf.append("); lt_box_free_raw(e->");
                    mut dropBodyBuf.append(fName);
                    mut dropBodyBuf.append("); } ");
                } else {
                    mut dropBodyBuf.append("lt_box_release(e->");
                    mut dropBodyBuf.append(fName);
                    mut dropBodyBuf.append("); ");
                }
                mut cloneBodyBuf.append("dst->");
                mut cloneBodyBuf.append(fName);
                mut cloneBodyBuf.append(" = (");
                mut cloneBodyBuf.append(cT);
                mut cloneBodyBuf.append(" *)lt_box_retain(src->");
                mut cloneBodyBuf.append(fName);
                mut cloneBodyBuf.append("); ");
                mut envUnpackBuf.append(cT);
                mut envUnpackBuf.append(" *");
                mut envUnpackBuf.append(cellPtr);
                mut envUnpackBuf.append(" = ((");
                mut envUnpackBuf.append(envType);
                mut envUnpackBuf.append(" *)_env)->");
                mut envUnpackBuf.append(fName);
                mut envUnpackBuf.append("; (void)");
                mut envUnpackBuf.append(cellPtr);
                mut envUnpackBuf.append("; ");
            } else {
                isDerefParam := (cRt.startsWithAt(0, "(*lite_") and not isCell) or cRt.indexOf("->", 0) >= 0;
                unpackTok := if isDerefParam { "lt_cap_" + ci.toText() } else { cRt };
                if isDerefParam {
                    bodyRewritten = ctx.cReplaceExactToken(bodyRewritten, cRt, unpackTok);
                }
                mut envFieldsBuf.append(cT);
                mut envFieldsBuf.append(" ");
                mut envFieldsBuf.append(fName);
                mut envFieldsBuf.append("; ");
                mut mkParamsBuf.append(cT);
                mut mkParamsBuf.append(" ");
                mut mkParamsBuf.append(pName);
                mut mkArgsBuf.append(ctx.copiedValueCode(target, cK, cRt));
                mut stkInitsBuf.append(cRt);
                mut mkInitsBuf.append("e->");
                mut mkInitsBuf.append(fName);
                mut mkInitsBuf.append(" = ");
                mut mkInitsBuf.append(pName);
                mut mkInitsBuf.append("; ");
                valDropFn := types.cDropFnForKind(cK);
                if valDropFn =!= "" {
                    mut dropBodyBuf.append(valDropFn);
                    mut dropBodyBuf.append("(&e->");
                    mut dropBodyBuf.append(fName);
                    mut dropBodyBuf.append("); ");
                }
                valCopyFn := types.cCopyFnForKind(cK);
                if valCopyFn =!= "" {
                    mut cloneBodyBuf.append("dst->");
                    mut cloneBodyBuf.append(fName);
                    mut cloneBodyBuf.append(" = ");
                    mut cloneBodyBuf.append(valCopyFn);
                    mut cloneBodyBuf.append("(src->");
                    mut cloneBodyBuf.append(fName);
                    mut cloneBodyBuf.append("); ");
                } else {
                    mut cloneBodyBuf.append("dst->");
                    mut cloneBodyBuf.append(fName);
                    mut cloneBodyBuf.append(" = src->");
                    mut cloneBodyBuf.append(fName);
                    mut cloneBodyBuf.append("; ");
                }
                if cM {
                    bodyRewritten = ctx.cReplaceIdentToken(bodyRewritten, unpackTok, "(((" + envType + " *)_env)->" + fName + ")");
                } else {
                    mut envUnpackBuf.append(cT);
                    mut envUnpackBuf.append(" ");
                    mut envUnpackBuf.append(unpackTok);
                    mut envUnpackBuf.append(" = ((");
                    mut envUnpackBuf.append(envType);
                    mut envUnpackBuf.append(" *)_env)->");
                    mut envUnpackBuf.append(fName);
                    mut envUnpackBuf.append("; (void)");
                    mut envUnpackBuf.append(unpackTok);
                    mut envUnpackBuf.append("; ");
                }
            }
            ci = ci + 1;
        }
        envFields := envFieldsBuf.build();
        envUnpack := envUnpackBuf.build();
        mkParams := mkParamsBuf.build();
        mkInits := mkInitsBuf.build();
        mkArgs := mkArgsBuf.build();
        stkInits := stkInitsBuf.build();
        dropBody := dropBodyBuf.build();
        cloneBody := cloneBodyBuf.build();
        dropFnName := "lt_drop_" + cid;
        cloneFnName := "lt_clone_" + cid;
        mkName := "lt_mk_" + cid;
        cFnDef := "typedef struct { " + envFields + "} " + envType + ";\nstatic " + cRetType + " " + clName + "(" + cParamsCode + ") { (void)_env; /*@CFN_TEMPS@*/" + selfBind + envUnpack + paramVoidStmts + bodyRewritten + " }\nLT_INLINE void " + dropFnName + "(void *p) { " + envType + " *e = (" + envType + " *)p; (void)e; " + dropBody + "lt_heap_free(e); }\nLT_INLINE void *" + cloneFnName + "(void *p) { " + envType + " *src = (" + envType + " *)p; " + envType + " *dst = (" + envType + " *)lt_heap_alloc(sizeof(" + envType + ")); dst->hdr = (lt_env_hdr){ " + dropFnName + ", " + cloneFnName + " }; " + cloneBody + "return dst; }\nLT_INLINE " + cFnTag + " " + mkName + "(" + mkParams + ") { " + envType + " *e = (" + envType + " *)lt_heap_alloc(sizeof(" + envType + ")); e->hdr = (lt_env_hdr){ " + dropFnName + ", " + cloneFnName + " }; " + mkInits + "return (" + cFnTag + "){ " + clName + ", e }; }";
        stkMarker := "/*@CSTK:((" + cFnTag + "){ " + clName + ", &((" + envType + "){ .hdr = { NULL, " + cloneFnName + " }" + stkInits + " }) })@*/";
        cExpr := "/*@T:" + fnKind + "@*//*@CFN_START:" + clName + "@*/" + cFnDef + "/*@CFN_END@*/" + stkMarker + mkName + "(" + mkArgs + ")";
        return (kind = fnKind, code = cExpr, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next);
    }
    fnPrefix := if usesSelf { "(function " + selfRuntime } else { "(function " };
    fnFullCode := fnPrefix + "(" + tsParamsCode + "): " + types.tsFunctionType(retKind) + " { " + paramVoidStmts + fnBody.code + " })";
    ctx.withMarkers((kind = fnKind, code = fnFullCode, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next),
    if inferMode { ctx.collectParsedMarkers("", fnBody) } else { "" })
};

/** Returns an error diagnostic if any bound parameter in `bindings` violates its `Type<...>` constraint, or `""`. */
findGenericConstraintError := fn(genericParams: String, bindings: Map<String, String>, calleeSuffix: String): String {
    loop generics.splitGenericParams(genericParams) as gp {
        if bindings.has(gp) {
            gpConstraint := types.typeParamConstraintKind(genericParams, gp);
            if gpConstraint =!= "" {
                boundEntry := bindings.get(gp);
                boundKind := boundEntry.value;
                effConstraint := types.substCanonicalKind(genericParams, gpConstraint, bindings);
                if not types.typeSatisfiesConstraint(boundKind, effConstraint) {
                    return "type " + types.displayKind(boundKind) + " does not satisfy constraint " + types.displayKind(effConstraint) + " for parameter " + gp + calleeSuffix;
                }
            }
        }
    }
    ""
};

/** Resolves a non-type lexical alias (`val`, `mod`, `fn`, full or partial specialized generic `fn`) or reports `"type"` to fall through to type alias handling. */
pub resolveUnifiedAliasDecl := fn(
target: String, source: String, nameStart: Int, name: String, typePos: Int, aliasDepth: Int, locDepth: Int,
moduleKey: String, moduleIdentity: String, prefix: String, isPrepass: Bool,
locals: mut List<Local>, functions: mut List<FunctionInfo>, functionParams: mut List<String>, aliases: mut List<AliasDecl>
): (kind: String, next: Int, done: Bool) {
    size := source.length();
    gpStart := typePos + 5;
    gp := types.scanComptimeTypeParams(source, gpStart, prefix);
    if not gp.ok {
        if isPrepass { return (kind = "", next = typePos, done = false); }
        syntax.failAt(source, gp.errPos, prefix, gp.errMsg);
    }
    targetStart := syntax.skipTrivia(source, gp.next, prefix);
    if not isPrepass and targetStart < size and source.at(targetStart) == "#" {
        aliasAttr := types.parseTypeLayoutAttrs(source, targetStart, prefix);
        if aliasAttr.hasAttrs {
            syntax.failAt(source, targetStart, prefix, "layout attributes are only allowed on record and enum declarations");
        }
    }
    aliasIdx := types.aliasIndexAt(aliases, nameStart);
    if aliasIdx < 0 {
        if isPrepass { return (kind = "", next = typePos, done = false); }
        types.unsupportedAliasTarget(source, targetStart, prefix, "target");
    }
    aliasEntry := aliases[aliasIdx];
    if aliasEntry.target == "$symalias" {
        nextPos := syntax.consumeStatementEnd(source, aliasEntry.end, prefix);
        retKind := if sym.findFunctions(functions, name).length() > 0 { "fn" }
        else if sym.localIndex(locals, name) >= 0 and locals[sym.localIndex(locals, name)].kind == ir.VALUE_KIND_MODULE { "mod" }
        else { "val" };
        return (kind = retKind, next = if nextPos >= 0 { nextPos } else { aliasEntry.end }, done = true);
    }
    stmtNext := syntax.consumeStatementEnd(source, aliasEntry.end, prefix);
    if stmtNext < 0 {
        if isPrepass { return (kind = "", next = typePos, done = false); }
        afterBad := syntax.skipTrivia(source, aliasEntry.end, prefix);
        if afterBad < size and (source.at(afterBad) == "(" or source.at(afterBad) == "+" or source.at(afterBad) == "-" or
        source.at(afterBad) == "*" or source.at(afterBad) == "/" or source.at(afterBad) == "%" or source.at(afterBad) == "[") {
            syntax.failAt(source, targetStart, prefix, "alias target cannot be a computed expression");
        }
        types.unsupportedAliasTarget(source, aliasEntry.at, prefix, "target");
    }
    if aliasEntry.target == "" {
        if isPrepass { return (kind = "", next = typePos, done = false); }
        types.unsupportedAliasTarget(source, targetStart, prefix, "target");
    }
    if gp.hasParams {
        scopedAliasEnv := types.aliasesUpToDepth(aliases, aliasDepth);
        aliasParams := types.resolveComptimeParamSpecs(source, gpStart, prefix, scopedAliasEnv, gp.paramsCsv);
        if targetStart < size and source.at(targetStart).isNameStart() {
            calleeParsed := types.typeNameAt(source, targetStart, prefix);
            rawCalleeName := calleeParsed.name;
            var resolvedCallee := rawCalleeName;
            cDot := rawCalleeName.indexOf(".", 0);
            if cDot > 0 {
                mPart := rawCalleeName.slice(0, cDot);
                mIdx := sym.localIndex(locals, mPart);
                if mIdx >= 0 and locals[mIdx].kind == ir.VALUE_KIND_MODULE {
                    resolvedCallee = locals[mIdx].textValue + rawCalleeName.slice(cDot, rawCalleeName.length());
                }
            }
            fnCands := sym.findFunctions(functions, resolvedCallee);
            if fnCands.length() > 0 {
                afterCallee := syntax.skipTrivia(source, calleeParsed.next, prefix);
                if afterCallee >= size or source.at(afterCallee) =!= "<" {
                    syntax.failAt(source, targetStart, prefix, "partial generic function alias " + name + " requires explicit <...> arguments on " + rawCalleeName);
                }
                var matchedTplKey := "";
                var matchedBindingsEnc := "";
                var matchedCount := 0;
                var matchedAnyGen := false;
                loop fnCands as fiIdx {
                    fInfo := functions[fiIdx];
                    if not fInfo.runtime.startsWithAt(0, "$gen:") { continue; }
                    matchedAnyGen = true;
                    tKey := fInfo.runtime.slice(5, fInfo.runtime.length());
                    tpl := generics.getTemplate(generics.findTemplate(tKey));
                    tSpecs := types.splitParamSpecs(tpl.genericParams);
                    var tpCursor := syntax.skipTrivia(source, afterCallee + 1, prefix);
                    mut parsedVals: List<String> = [];
                    var tpIdx := 0;
                    var parseOk := true;
                    var failPos := tpCursor;
                    var failMsg := "";
                    loop tpCursor < size and source.at(tpCursor) =!= ">" {
                        if tpIdx >= tSpecs.length() {
                            parseOk = false;
                            failPos = tpCursor;
                            failMsg = "too many compile-time arguments for " + rawCalleeName;
                            break;
                        }
                        pSpec := tSpecs[tpIdx];
                        if types.isTypeParamKind(pSpec.kind) {
                            canT := types.canResolveTypeAt(source, tpCursor, prefix, scopedAliasEnv, aliasParams, [], 32);
                            if not canT.ok {
                                parseOk = false;
                                failPos = tpCursor;
                                failMsg = "cannot resolve type argument in partial generic alias " + name;
                                break;
                            }
                            mut parsedVals.pushBack(canT.kind);
                            tpCursor = syntax.skipTrivia(source, canT.next, prefix);
                        } else {
                            if tpCursor < size and source.at(tpCursor).isNameStart() {
                                vpEnd := source.skipName(tpCursor);
                                vpName := source.slice(tpCursor, vpEnd);
                                vpKind := types.valueParamKind(aliasParams, vpName);
                                if vpKind =!= "" {
                                    if not types.isCompatibleKind(pSpec.kind, vpKind) {
                                        parseOk = false;
                                        failPos = tpCursor;
                                        failMsg = "compile-time argument " + vpName + " of type " + types.displayKind(vpKind) + " does not match parameter " + pSpec.name + ": " + types.displayKind(pSpec.kind);
                                        break;
                                    }
                                    mut parsedVals.pushBack(vpName);
                                    tpCursor = syntax.skipTrivia(source, vpEnd, prefix);
                                } else {
                                    vArg := types.parseComptimeValueArg(source, tpCursor, prefix, scopedAliasEnv, "", pSpec.kind);
                                    if not vArg.ok {
                                        parseOk = false;
                                        failPos = vArg.errPos;
                                        failMsg = vArg.errMsg;
                                        break;
                                    }
                                    mut parsedVals.pushBack(vArg.token);
                                    tpCursor = syntax.skipTrivia(source, vArg.next, prefix);
                                }
                            } else {
                                vArg := types.parseComptimeValueArg(source, tpCursor, prefix, scopedAliasEnv, "", pSpec.kind);
                                if not vArg.ok {
                                    parseOk = false;
                                    failPos = vArg.errPos;
                                    failMsg = vArg.errMsg;
                                    break;
                                }
                                mut parsedVals.pushBack(vArg.token);
                                tpCursor = syntax.skipTrivia(source, vArg.next, prefix);
                            }
                        }
                        tpIdx = tpIdx + 1;
                        if tpCursor < size and source.at(tpCursor) == "," {
                            tpCursor = syntax.skipTrivia(source, tpCursor + 1, prefix);
                            if tpCursor < size and source.at(tpCursor) == ">" { break; }
                        } else {
                            break;
                        }
                    }
                    if not parseOk {
                        if fnCands.length() == 1 { syntax.failAt(source, failPos, prefix, failMsg); }
                        continue;
                    }
                    if tpCursor >= size or source.at(tpCursor) =!= ">" { continue; }
                    if parsedVals.length() =!= tSpecs.length() { continue; }
                    mut bMap: Map<String, String>;
                    mut concreteMap: Map<String, String>;
                    var bi := 0;
                    loop bi < tSpecs.length() {
                        mut bMap.set(tSpecs[bi].name, parsedVals[bi]);
                        if not generics.kindHasUnboundGeneric(aliasParams, parsedVals[bi], emptyStringMap()) and
                        types.valueParamKind(aliasParams, parsedVals[bi]) == "" {
                            mut concreteMap.set(tSpecs[bi].name, parsedVals[bi]);
                        }
                        bi = bi + 1;
                    }
                    cErr := findGenericConstraintError(tpl.genericParams, concreteMap, " in partial alias " + name);
                    if cErr =!= "" {
                        if fnCands.length() == 1 { syntax.failAt(source, targetStart, prefix, cErr); }
                        continue;
                    }
                    ovCount := sym.findFunctions(functions, name).length();
                    ovSuffix := if ovCount > 0 { "$ov" + ovCount.toText() } else { "" };
                    aliasTplKey := moduleKey + "#" + name + ovSuffix;
                    mut sParams: List<String> = [];
                    loop generics.splitPipeEntries(tpl.params, tpl.paramCount) as pEnt {
                        pNm := types.paramNameOf(pEnt);
                        rawPK := types.paramKindOf(pEnt);
                        pOpt := types.paramIsOptional(pEnt);
                        isMut := rawPK.startsWithAt(0, "mut ");
                        basePK := if isMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                        subPK := generics.substKind(tpl.genericParams, basePK, bMap);
                        qPref := if pOpt { "?" } else { "" };
                        mut sParams.pushBack(pNm + qPref + "=" + (if isMut { "mut " } else { "" }) + subPK);
                    }
                    tplCtx := contexts.extractCtxKindFromParams(tpl.params);
                    subParamsPipe := if tplCtx =!= "" {
                        contexts.appendCtxToParams(sParams.join("|"), generics.substKind(tpl.genericParams, tplCtx, bMap))
                    } else {
                        sParams.join("|")
                    };
                    subResult := generics.substKind(tpl.genericParams, tpl.result, bMap);
                    generics.registerTemplate((
                    key = aliasTplKey, qualName = name + ovSuffix, typeOpKey = "",
                    moduleKey = tpl.moduleKey, moduleIdentity = tpl.moduleIdentity,
                    prefix = tpl.prefix, source = tpl.source,
                    bodyStart = tpl.bodyStart, bodyEnd = tpl.bodyEnd, declAt = nameStart,
                    genericParams = aliasParams, params = subParamsPipe,
                    paramCount = tpl.paramCount, result = subResult,
                    selfTarget = tpl.selfTarget, isPub = tpl.isPub
                    ));
                    fixedEnc := generics.encodeBindings(tpl.genericParams, bMap);
                    generics.registerFnAliasTarget(aliasTplKey, tpl.key, fixedEnc, aliasParams);
                    genRuntime := "$gen:" + aliasTplKey;
                    firstParam := functionParams.length();
                    loop generics.splitPipeEntries(subParamsPipe, tpl.paramCount) as sp {
                        mut functionParams.pushBack(sp);
                    }
                    mut functions.pushBack((name = name, runtime = genRuntime, result = subResult,
                    first = firstParam, count = tpl.paramCount, declAt = nameStart));
                    contexts.registerFnContext(genRuntime, contexts.extractCtxKindFromParams(subParamsPipe));
                    overloads.registerFnSig(genRuntime, overloads.overloadSigKey(true, aliasParams, subParamsPipe, tpl.paramCount), aliasParams, subParamsPipe);
                    matchedTplKey = tKey;
                    matchedBindingsEnc = fixedEnc;
                    matchedCount = matchedCount + 1;
                    break;
                }
                if matchedCount > 0 {
                    _u1 := matchedTplKey;
                    _u2 := matchedBindingsEnc;
                    aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                    return (kind = "fn", next = stmtNext, done = true);
                }
                if not matchedAnyGen {
                    syntax.failAt(source, targetStart, prefix, rawCalleeName + " is not a generic function");
                }
                syntax.failAt(source, targetStart, prefix, "no overload of generic function " + rawCalleeName + " matches alias arguments in " + name);
            }
        }
        return (kind = "type", next = stmtNext, done = false);
    }

    if targetStart < size and source.at(targetStart).isNameStart() {
        calleeParsed := types.typeNameAt(source, targetStart, prefix);
        rawCalleeName := calleeParsed.name;
        afterCallee := syntax.skipTrivia(source, calleeParsed.next, prefix);
        if afterCallee < size and source.at(afterCallee) == "<" {
            var resolvedCallee := rawCalleeName;
            cDot := rawCalleeName.indexOf(".", 0);
            if cDot > 0 {
                mPart := rawCalleeName.slice(0, cDot);
                mIdx := sym.localIndex(locals, mPart);
                if mIdx >= 0 and locals[mIdx].kind == ir.VALUE_KIND_MODULE {
                    resolvedCallee = locals[mIdx].textValue + rawCalleeName.slice(cDot, rawCalleeName.length());
                }
            }
            fnCands := sym.findFunctions(functions, resolvedCallee);
            if fnCands.length() > 0 {
                scopedAliasEnv := types.aliasesUpToDepth(aliases, aliasDepth);
                var matchedAnyGen := false;
                var matchedOk := false;
                loop fnCands as fiIdx {
                    fInfo := functions[fiIdx];
                    if not fInfo.runtime.startsWithAt(0, "$gen:") { continue; }
                    matchedAnyGen = true;
                    tKey := fInfo.runtime.slice(5, fInfo.runtime.length());
                    tpl := generics.getTemplate(generics.findTemplate(tKey));
                    tSpecs := types.splitParamSpecs(tpl.genericParams);
                    var tpCursor := syntax.skipTrivia(source, afterCallee + 1, prefix);
                    mut parsedVals: List<String> = [];
                    var tpIdx := 0;
                    var parseOk := true;
                    var failPos := tpCursor;
                    var failMsg := "";
                    loop tpCursor < size and source.at(tpCursor) =!= ">" {
                        if tpIdx >= tSpecs.length() {
                            parseOk = false; failPos = tpCursor; failMsg = "too many compile-time arguments for " + rawCalleeName; break;
                        }
                        pSpec := tSpecs[tpIdx];
                        if types.isTypeParamKind(pSpec.kind) {
                            canT := types.canResolveTypeAt(source, tpCursor, prefix, scopedAliasEnv, "", [], 32);
                            if not canT.ok {
                                parseOk = false; failPos = tpCursor; failMsg = "cannot resolve type argument in alias " + name; break;
                            }
                            mut parsedVals.pushBack(canT.kind);
                            tpCursor = syntax.skipTrivia(source, canT.next, prefix);
                        } else {
                            vArg := types.parseComptimeValueArg(source, tpCursor, prefix, scopedAliasEnv, "", pSpec.kind);
                            if not vArg.ok {
                                parseOk = false; failPos = vArg.errPos; failMsg = vArg.errMsg; break;
                            }
                            mut parsedVals.pushBack(vArg.token);
                            tpCursor = syntax.skipTrivia(source, vArg.next, prefix);
                        }
                        tpIdx = tpIdx + 1;
                        if tpCursor < size and source.at(tpCursor) == "," {
                            tpCursor = syntax.skipTrivia(source, tpCursor + 1, prefix);
                            if tpCursor < size and source.at(tpCursor) == ">" { break; }
                        } else { break; }
                    }
                    if not parseOk {
                        if fnCands.length() == 1 { syntax.failAt(source, failPos, prefix, failMsg); }
                        continue;
                    }
                    if tpCursor >= size or source.at(tpCursor) =!= ">" or parsedVals.length() =!= tSpecs.length() { continue; }
                    mut bMap: Map<String, String>;
                    var bi := 0;
                    loop bi < tSpecs.length() {
                        mut bMap.set(tSpecs[bi].name, parsedVals[bi]);
                        bi = bi + 1;
                    }
                    cErr := findGenericConstraintError(tpl.genericParams, bMap, " in alias " + name);
                    if cErr =!= "" {
                        if fnCands.length() == 1 { syntax.failAt(source, targetStart, prefix, cErr); }
                        continue;
                    }
                    subResult := generics.substKind(tpl.genericParams, tpl.result, bMap);
                    rErr := generics.validateSubstitutedKind(subResult);
                    if rErr =!= "" { syntax.failAt(source, targetStart, prefix, rErr); }
                    mut sParams: List<String> = [];
                    loop generics.splitPipeEntries(tpl.params, tpl.paramCount) as pEnt {
                        pNm := types.paramNameOf(pEnt);
                        rawPK := types.paramKindOf(pEnt);
                        pOpt := types.paramIsOptional(pEnt);
                        isMut := rawPK.startsWithAt(0, "mut ");
                        basePK := if isMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                        subPK := generics.substKind(tpl.genericParams, basePK, bMap);
                        pValErr := generics.validateSubstitutedKind(subPK);
                        if pValErr =!= "" { syntax.failAt(source, targetStart, prefix, pValErr); }
                        qPref := if pOpt { "?" } else { "" };
                        mut sParams.pushBack(pNm + qPref + "=" + (if isMut { "mut " } else { "" }) + subPK);
                    }
                    tplCtx := contexts.extractCtxKindFromParams(tpl.params);
                    subCtx := if tplCtx =!= "" { generics.substKind(tpl.genericParams, tplCtx, bMap) } else { "" };
                    subParamsPipe := if subCtx =!= "" { contexts.appendCtxToParams(sParams.join("|"), subCtx) } else { sParams.join("|") };
                    bindingsEnc := generics.encodeBindings(tpl.genericParams, bMap);
                    instRuntime := generics.requestInstance(target, tpl.key, bindingsEnc, subParamsPipe, subResult);
                    contexts.registerFnContext(instRuntime, subCtx);
                    overloads.registerFnSig(instRuntime, overloads.overloadSigKey(true, "", subParamsPipe, tpl.paramCount), "", subParamsPipe);
                    firstParam := functionParams.length();
                    loop generics.splitPipeEntries(subParamsPipe, tpl.paramCount) as sp {
                        mut functionParams.pushBack(sp);
                    }
                    mut functions.pushBack((name = name, runtime = instRuntime, result = subResult,
                    first = firstParam, count = tpl.paramCount, declAt = nameStart));
                    matchedOk = true;
                    break;
                }
                if matchedOk {
                    aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                    return (kind = "fn", next = stmtNext, done = true);
                }
                if not matchedAnyGen {
                    syntax.failAt(source, targetStart, prefix, rawCalleeName + " is not a generic function");
                }
                syntax.failAt(source, targetStart, prefix, "no overload of generic function " + rawCalleeName + " matches alias arguments in " + name);
            }
        }
        if afterCallee == syntax.skipTrivia(source, aliasEntry.end, prefix) {
            cDot := rawCalleeName.indexOf(".", 0);
            if cDot < 0 {
                locIdx := sym.localIndex(locals, rawCalleeName);
                if locIdx >= 0 and locals[locIdx].depth >= -1 {
                    tgtLoc := locals[locIdx];
                    if tgtLoc.kind == ir.VALUE_KIND_MODULE {
                        aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                        mut aliases.pushBack((name = "$modalias:" + name, target = tgtLoc.textValue, at = nameStart, end = aliasEntry.end, depth = aliasDepth));
                        mut locals.pushBack((name = name, runtime = "", kind = ir.VALUE_KIND_MODULE, mutable = false, writable = false,
                        depth = locDepth, constant = false, code = "", intValue = tgtLoc.intValue, textValue = tgtLoc.textValue, initState = ir.INIT_STATE_INIT));
                        return (kind = "mod", next = stmtNext, done = true);
                    }
                    if isPrepass {
                        return (kind = "", next = typePos, done = false);
                    }
                    if tgtLoc.initState =!= ir.INIT_STATE_INIT or tgtLoc.textValue.startsWithAt(0, "$param_fwd:") {
                        syntax.failAt(source, targetStart, prefix, "cannot alias uninitialized variable " + rawCalleeName);
                    }
                    aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                    mut locals.pushBack((name = name, runtime = tgtLoc.runtime, kind = tgtLoc.kind, mutable = tgtLoc.mutable, writable = tgtLoc.writable,
                    depth = locDepth, constant = tgtLoc.constant, code = tgtLoc.code, intValue = tgtLoc.intValue, textValue = tgtLoc.textValue, initState = ir.INIT_STATE_INIT));
                    return (kind = "val", next = stmtNext, done = true);
                }
                if locIdx >= 0 and locals[locIdx].depth <= -2 {
                    if isPrepass { return (kind = "", next = typePos, done = false); }
                    syntax.failAt(source, targetStart, prefix, "cannot alias uninitialized variable " + rawCalleeName);
                }
                fnCands := sym.findFunctions(functions, rawCalleeName);
                if fnCands.length() > 0 {
                    aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                    loop fnCands as fiIdx {
                        fInfo := functions[fiIdx];
                        mut functions.pushBack((name = name, runtime = fInfo.runtime, result = fInfo.result,
                        first = fInfo.first, count = fInfo.count, declAt = nameStart));
                    }
                    return (kind = "fn", next = stmtNext, done = true);
                }
            } else {
                mPart := rawCalleeName.slice(0, cDot);
                memPart := rawCalleeName.slice(cDot + 1, rawCalleeName.length());
                mIdx := sym.localIndex(locals, mPart);
                if mIdx >= 0 and locals[mIdx].kind == ir.VALUE_KIND_MODULE {
                    qualName := locals[mIdx].textValue + "." + memPart;
                    fnCands := sym.findFunctions(functions, qualName);
                    if fnCands.length() > 0 {
                        aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                        loop fnCands as fiIdx {
                            fInfo := functions[fiIdx];
                            mut functions.pushBack((name = name, runtime = fInfo.runtime, result = fInfo.result,
                            first = fInfo.first, count = fInfo.count, declAt = nameStart));
                        }
                        return (kind = "fn", next = stmtNext, done = true);
                    }
                    vIdx := sym.localIndex(locals, qualName);
                    if vIdx >= 0 and locals[vIdx].depth >= -1 {
                        if isPrepass { return (kind = "", next = typePos, done = false); }
                        tgtV := locals[vIdx];
                        if tgtV.initState =!= ir.INIT_STATE_INIT {
                            syntax.failAt(source, targetStart, prefix, "cannot alias uninitialized variable " + rawCalleeName);
                        }
                        aliases[aliasIdx] = (name = aliasEntry.name, target = "$symalias", at = aliasEntry.at, end = aliasEntry.end, depth = aliasEntry.depth);
                        mut locals.pushBack((name = name, runtime = tgtV.runtime, kind = tgtV.kind, mutable = tgtV.mutable, writable = tgtV.writable,
                        depth = locDepth, constant = tgtV.constant, code = tgtV.code, intValue = tgtV.intValue, textValue = tgtV.textValue, initState = ir.INIT_STATE_INIT));
                        return (kind = "val", next = stmtNext, done = true);
                    }
                }
            }
        }
    }
    (kind = "type", next = stmtNext, done = false)
};

/** Helper returning an empty `Map<String, String>`. */
emptyStringMap := fn(): Map<String, String> {
    mut m: Map<String, String>;
    m
};

/** Result of resolving optional parameter defaults for a function header or generic instance. */
pub FnDefaultsResult := record {
    resolvedParams: String;
    optItems: Items;
    hasDefaults: Bool;
};

/** Resolves optional parameter defaults in declaration order, inferring `$InferParam` types, rejecting self/forward parameter refs, and producing `OPT_PARAM_INIT` prologue items. */
pub resolveFnParamDefaults := fn(
target: String, source: String, prefix: String, headerPos: Int, bodyStart: Int,
rawParamsEncoded: String, paramCount: Int, baseLocals: List<Local>, functions: List<FunctionInfo>,
fnParams: List<String>, currentName: String, aliases: List<AliasDecl>, ctxs: List<ConstructCtx>,
iifeDepth: Int, inferOnly: Bool
): FnDefaultsResult {
    emptyItemsOut: Items = [];
    if paramCount <= 0 {
        return FnDefaultsResult { resolvedParams = rawParamsEncoded, optItems = emptyItemsOut, hasDefaults = false };
    }
    entries := generics.splitPipeEntries(rawParamsEncoded, paramCount);
    var hasAnyOpt := false;
    loop entries as ent {
        if types.paramIsOptional(ent) { hasAnyOpt = true; break; }
    }
    if not hasAnyOpt {
        return FnDefaultsResult { resolvedParams = rawParamsEncoded, optItems = emptyItemsOut, hasDefaults = false };
    }
    defSpans := if headerPos >= 0 {
        types.getFnDefaultSpans(prefix, headerPos)
    } else {
        types.getFnDefaultSpansByBodyStart(prefix, bodyStart)
    };
    defDepth := ir.maxLocalLexDepth(baseLocals) + 2;
    mut defLocals: List<Local> = [];
    loop baseLocals as bl {
        mut defLocals.pushBack(bl);
    }
    mut resolvedEntries: List<String> = [];
    mut optItems: Items = [];
    var idx := 0;
    loop idx < paramCount {
        entry := entries[idx];
        pName := types.paramNameOf(entry);
        isOpt := types.paramIsOptional(entry);
        rawPK := types.paramKindOf(entry);
        isMut := rawPK.startsWithAt(0, "mut ");
        basePK := if isMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
        var pKind := basePK;
        var spanIdx := -1;
        var si := 0;
        loop si < defSpans.length() {
            if defSpans[si].idx == idx { spanIdx = si; break; }
            si = si + 1;
        }
        pRuntimeSafe := ir.safeTargetIdent(target, pName);
        isSliceP := types.isSliceKind(pKind);
        isDynP := types.isDynKind(pKind);
        isBorrowP := isSliceP or isDynP;
        isConstPtrP := not isOpt and target == ir.TARGET_C and not isMut and pKind =!= "$InferParam" and types.cParamIsConstPtr(pKind);
        pRtExpr := if (isMut and not isBorrowP and target == ir.TARGET_C) or isConstPtrP { "(*lite_" + pRuntimeSafe + ")" }
        else if isMut and pKind =!= "$InferParam" and types.isRecordOrDistinctRecord(pKind) { "lite_" + pRuntimeSafe + ".v" }
        else { "lite_" + pRuntimeSafe };
        if isOpt and spanIdx >= 0 {
            sp := defSpans[spanIdx];
            mut evalLocals: List<Local> = [];
            loop defLocals as dl { mut evalLocals.pushBack(dl); }
            var fi := idx;
            loop fi < paramCount {
                fName := types.paramNameOf(entries[fi]);
                mut evalLocals.pushBack((name = fName, runtime = "$param_fwd", kind = "", mutable = false, writable = false,
                depth = defDepth + 1, constant = false, code = "", intValue = 0, textValue = "$param_fwd:" + pName + ":" + fName, initState = ir.INIT_STATE_INIT));
                fi = fi + 1;
            }
            hintK := if basePK == "$InferParam" { "" } else { basePK };
            sym.invalidateLocals();
            defParsed := parseBinaryCtx(target, source, sp.start, prefix, evalLocals, functions, fnParams, currentName, hintK, 0, ctxs, iifeDepth, inferOnly, "", aliases);
            sym.invalidateLocals();
            if basePK == "$InferParam" {
                if defParsed.kind == "" {
                    syntax.failAt(source, sp.start, prefix, "could not infer type for default parameter " + pName);
                }
                if defParsed.kind == ir.VALUE_KIND_UNIT or defParsed.kind == ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, sp.start, prefix, "cannot infer parameter " + pName + " type from " + types.displayKind(defParsed.kind));
                }
                bErr := types.borrowedStorageError(defParsed.kind);
                if bErr =!= "" { syntax.failAt(source, sp.start, prefix, bErr); }
                pKind = defParsed.kind;
            } else if not inferOnly {
                if not types.isCompatibleKind(pKind, defParsed.kind) {
                    syntax.failAt(source, sp.start, prefix, "default for parameter " + pName + " must be " + types.displayKind(pKind) + ", got " + types.displayKind(defParsed.kind));
                }
            }
            defCode := if inferOnly { "" } else { ctx.assignValueCode(target, pKind, defParsed.kind, defParsed.code) };
            if not inferOnly {
                optRt := "lite_" + pRuntimeSafe;
                mut optItems.pushBack((kind = ir.ITEM_KIND_OPT_PARAM_INIT, name = pName, runtime = optRt,
                code = defCode, intValue = idx, textValue = pKind));
            }
        }
        qMark := if isOpt { "?" } else { "" };
        mutStr := if isMut { "mut " } else { "" };
        mut resolvedEntries.pushBack(pName + qMark + "=" + mutStr + pKind);
        isConstPtrFinal := not isOpt and target == ir.TARGET_C and not isMut and pKind =!= "$InferParam" and types.cParamIsConstPtr(pKind);
        finalRtExpr := if (isMut and not types.isSliceKind(pKind) and not types.isDynKind(pKind) and target == ir.TARGET_C) or isConstPtrFinal { "(*lite_" + pRuntimeSafe + ")" }
        else if isMut and pKind =!= "$InferParam" and types.isRecordOrDistinctRecord(pKind) { "lite_" + pRuntimeSafe + ".v" }
        else { "lite_" + pRuntimeSafe };
        _unused := pRtExpr;
        mut defLocals.pushBack((name = pName, runtime = finalRtExpr, kind = pKind, mutable = false, writable = isMut,
        depth = defDepth, constant = false, code = finalRtExpr, intValue = 0,
        textValue = if types.isSliceKind(pKind) or types.isDynKind(pKind) { "borrow_param:" } else { "" }, initState = ir.INIT_STATE_INIT));
        idx = idx + 1;
    }
    ctxKind := contexts.extractCtxKindFromParams(rawParamsEncoded);
    finalParams := if ctxKind =!= "" {
        contexts.appendCtxToParams(resolvedEntries.join("|"), ctxKind)
    } else {
        resolvedEntries.join("|")
    };
    FnDefaultsResult { resolvedParams = finalParams, optItems = optItems, hasDefaults = true }
};

/** Ensures `$recpop:<recordKind>` and `$recdef:...` entries exist in `aliases`, lazily resolving forward-declared local records when needed. */
ensureRecordDefaults := fn(target: String, source: String, recordKind: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): List<AliasDecl> {
    if types.findAlias(aliases, "$recpop:" + recordKind) >= 0 { return aliases; }
    ownerKey := types.typeOpOwnerKey(recordKind);
    if ownerKey =!= "" and types.findAlias(aliases, "$recpop:" + ownerKey) >= 0 { return aliases; }
    declAt := types.recordDeclAt(recordKind);
    if declAt < 0 { return aliases; }
    aliasIdx := types.aliasIndexAt(aliases, declAt);
    if aliasIdx < 0 { return aliases; }
    aliasEntry := aliases[aliasIdx];
    isRawRec := aliasEntry.target.startsWithAt(0, "@recraw:");
    isGenRawRec := aliasEntry.target.startsWithAt(0, "@genraw:") and aliasEntry.target.indexOf("@recraw:", 8) >= 0;
    if aliasEntry.at < 0 or (not isRawRec and not isGenRawRec) { return aliases; }
    afterName := source.skipName(aliasEntry.at);
    opPos := syntax.skipTrivia(source, afterName, prefix);
    if not source.startsWithAt(opPos, ":=") { return aliases; }
    recPos := syntax.skipTrivia(source, opPos + 2, prefix);
    if not source.wordAt(recPos, "record") { return aliases; }
    seedKey := if isGenRawRec and ownerKey =!= "" { ownerKey } else { recordKind };
    seeded := types.appendEncodedRecordDefaults(aliases, seedKey, "", aliasEntry.depth);
    parsedRec := parseRecordDecl(target, source, recPos, aliasEntry.at, aliasEntry.name, aliasEntry.depth, prefix, locals, functions, params, currentName, ctxs, iifeDepth, false, seeded);
    types.appendEncodedRecordDefaults(aliases, seedKey, parsedRec.encodedDefaults, aliasEntry.depth)
};

/** Replaces synthetic `__LT_RECFLD_<idx>__` references in a record field default with runtime temp names `rfVars`. */
substituteRecFieldRefs := fn(code: String, rfVars: List<String>, compCount: Int): String {
    if code.indexOf("__LT_RECFLD_", 0) < 0 { return code; }
    var out := code;
    var k := 0;
    loop k < compCount {
        needle := "__LT_RECFLD_" + k.toText() + "__";
        if out.indexOf(needle, 0) >= 0 {
            out = out.split(needle).join(rfVars[k]);
        }
        k = k + 1;
    }
    out
};

/** Parses `{ field = expr, ... }` or `{}` for an explicit or contextual nominal `recordKind`, resolving omitted fields from defaults then zero. */
parseRecordLiteral := fn(target: String, source: String, braceStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, recordKind: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    recAliases := ensureRecordDefaults(target, source, recordKind, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    recName := types.recordDisplayName(recordKind);
    mut suppliedKeys: List<String> = [];
    mut suppliedCodes: List<String> = [];
    var recMarkers := "";
    var cursor := syntax.skipTrivia(source, braceStart + 1, prefix);
    loop true {
        if cursor >= size {
            syntax.failAt(source, braceStart, prefix, "expected } in record construction");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        var labelStart := cursor;
        var label := "";
        var valStart := cursor;
        var valMin := 0;
        if syntax.isSingleEquals(source, cursor) {
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not source.at(shStart).isNameStart() {
                syntax.failAt(source, shStart, prefix, "expected field name after = in record construction");
            }
            shEnd := source.skipName(shStart);
            labelStart = shStart;
            label = source.slice(shStart, shEnd);
            valStart = shStart;
            valMin = 30;
        } else {
            if not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected field name in record construction");
            }
            labelEnd := source.skipName(labelStart);
            label = source.slice(labelStart, labelEnd);
            afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
            if not syntax.isSingleEquals(source, afterLabel) {
                syntax.failAt(source, afterLabel, prefix, "expected = after record field " + label);
            }
            valStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
        }
        if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, labelStart, label, prefix); }
        fieldKind := types.recordFieldKind(recordKind, label);
        if fieldKind == "" {
            syntax.failAt(source, labelStart, prefix, "record " + recName + " has no field " + label);
        }
        if suppliedKeys.contains(label) {
            syntax.failAt(source, labelStart, prefix, "duplicate record field " + label);
        }
        zeroEnd := syntax.isZeroInitLiteral(source, valStart, prefix);
        var valNext := valStart;
        var valCode := "";
        var checkZero := false;
        if valMin == 0 and zeroEnd >= 0 and not numeric.isNumericKind(fieldKind) {
            afterZero := syntax.skipTrivia(source, zeroEnd, prefix);
            if afterZero < size and (source.at(afterZero) == "," or source.at(afterZero) == "}") {
                checkZero = true;
            }
        }
        if checkZero {
            if types.isUnionKind(fieldKind) {
                syntax.failAt(source, valStart, prefix, "ambiguous 0 initializer for union " + types.displayKind(fieldKind));
            }
            z := ctx.zeroParsed(target, fieldKind, zeroEnd);
            valCode = z.code;
            valNext = z.next;
        } else {
            valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, fieldKind, valMin, ctxs, iifeDepth, inferMode, "", recAliases);
            if inferMode { recMarkers = ctx.collectParsedMarkers(recMarkers, valParsed); }
            if not types.isCompatibleKind(fieldKind, valParsed.kind) {
                syntax.failAt(source, valStart, prefix, "cannot initialize " + types.displayKind(fieldKind) + " field " + label + " with " + types.displayKind(valParsed.kind));
            }
            valCode = ctx.assignValueCode(target, fieldKind, valParsed.kind, valParsed.code);
            valNext = valParsed.next;
        }
        (mut suppliedKeys).pushBack(label);
        mut suppliedCodes.pushBack(valCode);
        afterVal := syntax.skipTrivia(source, valNext, prefix);
        if afterVal < size and source.at(afterVal) == "," {
            cursor = syntax.skipTrivia(source, afterVal + 1, prefix);
        } else if afterVal < size and source.at(afterVal) == "}" {
            cursor = afterVal + 1;
            break;
        } else {
            syntax.failAt(source, afterVal, prefix, "expected , or } after record field " + label);
        }
    }
    compCount := types.recordComponentCount(recordKind);
    cRecTag := if target == ir.TARGET_C { types.cStructTag(recordKind) } else { "" };
    if compCount == 0 {
        emptyRecCode := if cRecTag =!= "" { "/*@T:" + recordKind + "@*/((" + cRecTag + "){ ._empty = 0 })" } else { "{}" };
        return ctx.withMarkers((kind = recordKind, code = emptyRecCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers);
    }
    encodedSupplied := types.encodeRecordPairs(suppliedKeys, suppliedCodes);
    mut compDefCodes: List<String> = [];
    mut compSuppliedIdx: List<Int> = [];
    mut suppliedCompIndices: List<Int> = [];
    var needsScopedEval := false;
    var supLoopIdx := 0;
    var lastSupCompIdx := -1;
    loop suppliedKeys as sKey {
        var foundComp := -1;
        var ci := 0;
        loop ci < compCount {
            if types.recordComponent(recordKind, ci).label == sKey {
                foundComp = ci;
                break;
            }
            ci = ci + 1;
        }
        mut suppliedCompIndices.pushBack(foundComp);
        if foundComp < lastSupCompIdx { needsScopedEval = true; }
        lastSupCompIdx = foundComp;
        if target == ir.TARGET_C and suppliedCodes[supLoopIdx].indexOf("/*@CBLK:", 0) >= 0 {
            needsScopedEval = true;
        }
        supLoopIdx = supLoopIdx + 1;
    }
    var compIdx := 0;
    loop compIdx < compCount {
        comp := types.recordComponent(recordKind, compIdx);
        var supFoundIdx := -1;
        var si := 0;
        loop suppliedKeys as sKey {
            if sKey == comp.label { supFoundIdx = si; break; }
            si = si + 1;
        }
        mut compSuppliedIdx.pushBack(supFoundIdx);
        if supFoundIdx < 0 {
            var defCode := types.findRecordDefaultCode(recAliases, recordKind, comp.label);
            if defCode == "" and recordKind == types.CORE_ERROR_KIND and comp.label == "kind" {
                defCode = if target == ir.TARGET_C { cLiteral.strLiteralCode("Error") } else { tsLiteral.textLiteralCode("Error") };
            }
            mut compDefCodes.pushBack(defCode);
            if defCode.indexOf("__LT_RECFLD_", 0) >= 0 or (target == ir.TARGET_C and defCode.indexOf("/*@CBLK:", 0) >= 0) {
                needsScopedEval = true;
            }
        } else {
            mut compDefCodes.pushBack("");
        }
        compIdx = compIdx + 1;
    }
    if not needsScopedEval {
        mut fieldExprs: List<String> = [];
        compIdx = 0;
        loop compIdx < compCount {
            comp := types.recordComponent(recordKind, compIdx);
            supIdx := compSuppliedIdx[compIdx];
            chosen := if supIdx >= 0 {
                suppliedCodes[supIdx]
            } else if compDefCodes[compIdx] =!= "" {
                compDefCodes[compIdx]
            } else {
                ctx.zeroParsed(target, comp.kind, cursor).code
            };
            if cRecTag =!= "" {
                mut fieldExprs.pushBack("." + types.cFieldName(comp.prop) + " = " + chosen);
            } else {
                mut fieldExprs.pushBack(types.tupleObjectKey(comp.label, compIdx) + ": " + chosen);
            }
            compIdx = compIdx + 1;
        }
        _unused := encodedSupplied;
        recCode := if cRecTag =!= "" {
            "/*@T:" + recordKind + "@*/((" + cRecTag + "){ " + fieldExprs.join(", ") + " })"
        } else {
            "{ " + fieldExprs.join(", ") + " }"
        };
        return ctx.withMarkers((kind = recordKind, code = recCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers);
    }
    recId := ctx.nextCtxId(ctxs) + braceStart;
    mut rfVars: List<String> = [];
    mut declBuf: tb.TextBuilder;
    mut stmtBuf: tb.TextBuilder;
    mut litFields: List<String> = [];
    compIdx = 0;
    loop compIdx < compCount {
        comp := types.recordComponent(recordKind, compIdx);
        rfVar := if target == ir.TARGET_C {
            "lt_rf_" + recId.toText() + "_" + compIdx.toText()
        } else {
            "lite$rf" + recId.toText() + "_" + compIdx.toText()
        };
        mut rfVars.pushBack(rfVar);
        if target == ir.TARGET_C {
            mut declBuf.append(types.cValueType(comp.kind));
            mut declBuf.append(" ");
            mut declBuf.append(rfVar);
            mut declBuf.append("; ");
            mut litFields.pushBack("." + types.cFieldName(comp.prop) + " = " + rfVar);
        } else {
            tsTy := if types.needsTsTypeAnnotation(comp.kind) { ": " + types.tsFunctionType(comp.kind) } else { "" };
            mut declBuf.append("let ");
            mut declBuf.append(rfVar);
            mut declBuf.append(tsTy);
            mut declBuf.append("; ");
            mut litFields.pushBack(types.tupleObjectKey(comp.label, compIdx) + ": " + rfVar);
        }
        compIdx = compIdx + 1;
    }
    /* 1. Evaluate all explicitly supplied fields in written order. */
    var swIdx := 0;
    loop swIdx < suppliedCompIndices.length() {
        cTarget := suppliedCompIndices[swIdx];
        cKind := types.recordComponent(recordKind, cTarget).kind;
        rfTarget := rfVars[cTarget];
        if target == ir.TARGET_C {
            mut stmtBuf.append(ctx.cUnwrapIntoVar(rfTarget, cKind, suppliedCodes[swIdx]));
            mut stmtBuf.append(" (void)");
            mut stmtBuf.append(rfTarget);
            mut stmtBuf.append("; ");
        } else {
            mut stmtBuf.append(rfTarget);
            mut stmtBuf.append(" = ");
            mut stmtBuf.append(suppliedCodes[swIdx]);
            mut stmtBuf.append("; ");
        }
        swIdx = swIdx + 1;
    }
    /* 2. Evaluate all omitted fields in declaration order (dependent defaults first, else zero). */
    compIdx = 0;
    loop compIdx < compCount {
        if compSuppliedIdx[compIdx] < 0 {
            comp := types.recordComponent(recordKind, compIdx);
            rfTarget := rfVars[compIdx];
            omittedVal := if compDefCodes[compIdx] =!= "" {
                substituteRecFieldRefs(compDefCodes[compIdx], rfVars, compCount)
            } else {
                ctx.zeroParsed(target, comp.kind, cursor).code
            };
            if target == ir.TARGET_C {
                mut stmtBuf.append(ctx.cUnwrapIntoVar(rfTarget, comp.kind, omittedVal));
                mut stmtBuf.append(" (void)");
                mut stmtBuf.append(rfTarget);
                mut stmtBuf.append("; ");
            } else {
                mut stmtBuf.append(rfTarget);
                mut stmtBuf.append(" = ");
                mut stmtBuf.append(omittedVal);
                mut stmtBuf.append("; ");
            }
        }
        compIdx = compIdx + 1;
    }
    _unused := encodedSupplied;
    scopedRecCode := if target == ir.TARGET_C {
        ltRecVar := "lt_rec_" + recId.toText();
        "/*@CBLK:" + ltRecVar + "@*/" + cRecTag + " " + ltRecVar + "; { " + declBuf.build() + stmtBuf.build() + ltRecVar + " = /*@T:" + recordKind + "@*/((" + cRecTag + "){ " + litFields.join(", ") + " }); }"
    } else {
        "(((): " + types.tsFunctionType(recordKind) + " => { " + declBuf.build() + stmtBuf.build() + "return { " + litFields.join(", ") + " }; })())"
    };
    ctx.withMarkers((kind = recordKind, code = scopedRecCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers)
};

/** Parses an inferred structural record literal `{}` or `{ "k"[: T] = v, k[: T] = v, =shorthand }`, rejecting non-record bare brace blocks. */
parseInferredRecordLiteral := fn(target: String, source: String, braceStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    expRec := if types.isAnonRecordKind(expected) { expected } else { "" };
    mut fieldSpecs: List<(label: String, kind: String)> = [];
    mut suppliedKeys: List<String> = [];
    mut suppliedCodes: List<String> = [];
    mut suppliedKinds: List<String> = [];
    var recMarkers := "";
    var cursor := syntax.skipTrivia(source, braceStart + 1, prefix);
    if cursor < size and source.at(cursor) == "}" {
        emptyKind := types.buildAnonRecordKind(fieldSpecs);
        cTag := if target == ir.TARGET_C { types.cStructTag(emptyKind) } else { "" };
        emptyCode := if cTag =!= "" { "/*@T:" + emptyKind + "@*/((" + cTag + "){ ._empty = 0 })" } else { "{}" };
        return (kind = emptyKind, code = emptyCode, intValue = 0, textValue = "", constant = false, next = cursor + 1);
    }
    /* First entry disambiguates structural record literal vs illegal bare block `{ 1 }` / `{ y := 1; y }`. */
    if cursor >= size {
        syntax.failAt(source, braceStart, prefix, "expected } in record literal");
    }
    if not syntax.isSingleEquals(source, cursor) and source.at(cursor) =!= "\"" {
        var looksLikeRecField := false;
        if source.at(cursor).isNameStart() {
            fLblEnd := source.skipName(cursor);
            fLbl := source.slice(cursor, fLblEnd);
            fAfter := syntax.skipTrivia(source, fLblEnd, prefix);
            if not syntax.isReservedWord(fLbl) and fAfter < size and (syntax.isSingleEquals(source, fAfter) or (source.at(fAfter) == ":" and not source.startsWithAt(fAfter, ":="))) {
                looksLikeRecField = true;
            }
        }
        if not looksLikeRecField {
            syntax.failAt(source, braceStart, prefix, "standalone block expressions must use do { ... }");
        }
    }
    loop true {
        if cursor >= size {
            syntax.failAt(source, braceStart, prefix, "expected } in record literal");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        var labelStart := cursor;
        var label := "";
        var explicitKind := "";
        var valStart := cursor;
        var valMin := 0;
        if syntax.isSingleEquals(source, cursor) {
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not source.at(shStart).isNameStart() {
                syntax.failAt(source, shStart, prefix, "expected field name after = in record literal");
            }
            shEnd := source.skipName(shStart);
            labelStart = shStart;
            label = source.slice(shStart, shEnd);
            if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, labelStart, label, prefix); }
            valStart = shStart;
            valMin = 30;
        } else if source.at(cursor) == "\"" {
            strKey := syntax.parseText(target, source, cursor, prefix);
            label = strKey.textValue;
            afterKey := syntax.skipTrivia(source, strKey.next, prefix);
            if afterKey < size and source.at(afterKey) == ":" and not source.startsWithAt(afterKey, ":=") {
                tyStart := syntax.skipTrivia(source, afterKey + 1, prefix);
                tyRes := types.parseTypeAt(source, tyStart, prefix, aliases, "record field type", "");
                explicitKind = tyRes.kind;
                afterTy := syntax.skipTrivia(source, tyRes.next, prefix);
                if not syntax.isSingleEquals(source, afterTy) {
                    syntax.failAt(source, afterTy, prefix, "expected = after record field type");
                }
                valStart = syntax.skipTrivia(source, afterTy + 1, prefix);
            } else if syntax.isSingleEquals(source, afterKey) {
                valStart = syntax.skipTrivia(source, afterKey + 1, prefix);
            } else {
                syntax.failAt(source, afterKey, prefix, "expected = or : Type = after record field \"" + label + "\"");
            }
        } else {
            if not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected field name in record literal");
            }
            labelEnd := source.skipName(labelStart);
            label = source.slice(labelStart, labelEnd);
            if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, labelStart, label, prefix); }
            afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
            if afterLabel < size and source.at(afterLabel) == ":" and not source.startsWithAt(afterLabel, ":=") {
                tyStart := syntax.skipTrivia(source, afterLabel + 1, prefix);
                tyRes := types.parseTypeAt(source, tyStart, prefix, aliases, "record field type", "");
                explicitKind = tyRes.kind;
                afterTy := syntax.skipTrivia(source, tyRes.next, prefix);
                if not syntax.isSingleEquals(source, afterTy) {
                    syntax.failAt(source, afterTy, prefix, "expected = after record field type");
                }
                valStart = syntax.skipTrivia(source, afterTy + 1, prefix);
            } else if syntax.isSingleEquals(source, afterLabel) {
                valStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
            } else {
                syntax.failAt(source, afterLabel, prefix, "expected = or : Type = after record field " + label);
            }
        }
        if suppliedKeys.contains(label) {
            syntax.failAt(source, labelStart, prefix, "duplicate record field " + label);
        }
        if explicitKind =!= "" {
            if explicitKind == ir.VALUE_KIND_UNIT or explicitKind == ir.VALUE_KIND_NEVER {
                syntax.failAt(source, labelStart, prefix, "record field " + label + " cannot have type " + types.displayKind(explicitKind));
            }
            bErr := types.borrowedStorageError(explicitKind);
            if bErr =!= "" { syntax.failAt(source, labelStart, prefix, bErr); }
        }
        hintKind := if explicitKind =!= "" { explicitKind } else if expRec =!= "" { types.recordFieldKind(expRec, label) } else { "" };
        var valNext := valStart;
        var valCode := "";
        var valKind := explicitKind;
        zeroEnd := if explicitKind =!= "" { syntax.isZeroInitLiteral(source, valStart, prefix) } else { -1 };
        var checkZero := false;
        if valMin == 0 and zeroEnd >= 0 and explicitKind =!= "" and not numeric.isNumericKind(explicitKind) {
            afterZero := syntax.skipTrivia(source, zeroEnd, prefix);
            if afterZero < size and (source.at(afterZero) == "," or source.at(afterZero) == "}") {
                checkZero = true;
            }
        }
        if checkZero {
            if types.isUnionKind(explicitKind) {
                syntax.failAt(source, valStart, prefix, "ambiguous 0 initializer for union " + types.displayKind(explicitKind));
            }
            z := ctx.zeroParsed(target, explicitKind, zeroEnd);
            valCode = z.code;
            valNext = z.next;
            valKind = explicitKind;
        } else {
            valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, hintKind, valMin, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { recMarkers = ctx.collectParsedMarkers(recMarkers, valParsed); }
            if valParsed.kind == ir.VALUE_KIND_UNIT or valParsed.kind == ir.VALUE_KIND_NEVER {
                syntax.failAt(source, valStart, prefix, "cannot store " + types.displayKind(valParsed.kind) + " in record field " + label);
            }
            valBerr := types.borrowedStorageError(valParsed.kind);
            if valBerr =!= "" { syntax.failAt(source, valStart, prefix, valBerr); }
            if explicitKind =!= "" {
                if not types.isCompatibleKind(explicitKind, valParsed.kind) {
                    syntax.failAt(source, valStart, prefix, "cannot initialize " + types.displayKind(explicitKind) + " field " + label + " with " + types.displayKind(valParsed.kind));
                }
                valCode = ctx.assignValueCode(target, explicitKind, valParsed.kind, valParsed.code);
                valKind = explicitKind;
            } else {
                valCode = if valParsed.kind == ir.VALUE_KIND_INT or valParsed.kind == ir.VALUE_KIND_FLOAT or
                valParsed.kind == ir.VALUE_KIND_BOOL or valParsed.kind == ir.VALUE_KIND_STRING or
                numeric.isNumericKind(valParsed.kind) {
                    valParsed.code
                } else {
                    ctx.copiedValueCode(target, valParsed.kind, valParsed.code)
                };
                valKind = valParsed.kind;
            }
            valNext = valParsed.next;
        }
        mut fieldSpecs.pushBack((label = label, kind = valKind));
        (mut suppliedKeys).pushBack(label);
        mut suppliedCodes.pushBack(valCode);
        mut suppliedKinds.pushBack(valKind);
        afterVal := syntax.skipTrivia(source, valNext, prefix);
        if afterVal < size and source.at(afterVal) == "," {
            cursor = syntax.skipTrivia(source, afterVal + 1, prefix);
        } else if afterVal < size and source.at(afterVal) == "}" {
            cursor = afterVal + 1;
            break;
        } else {
            syntax.failAt(source, afterVal, prefix, "expected , or } after record field " + label);
        }
    }
    recordKind := types.buildAnonRecordKind(fieldSpecs);
    compCount := types.recordComponentCount(recordKind);
    cRecTag := if target == ir.TARGET_C { types.cStructTag(recordKind) } else { "" };
    mut suppliedCompIndices: List<Int> = [];
    mut compSuppliedIdx: List<Int> = [];
    var needsScopedEval := false;
    var supLoopIdx := 0;
    var lastSupCompIdx := -1;
    loop suppliedKeys as sKey {
        var foundComp := -1;
        var ci := 0;
        loop ci < compCount {
            if types.recordComponent(recordKind, ci).label == sKey {
                foundComp = ci;
                break;
            }
            ci = ci + 1;
        }
        mut suppliedCompIndices.pushBack(foundComp);
        if foundComp < lastSupCompIdx { needsScopedEval = true; }
        lastSupCompIdx = foundComp;
        if target == ir.TARGET_C and suppliedCodes[supLoopIdx].indexOf("/*@CBLK:", 0) >= 0 {
            needsScopedEval = true;
        }
        supLoopIdx = supLoopIdx + 1;
    }
    var ci2 := 0;
    loop ci2 < compCount {
        comp := types.recordComponent(recordKind, ci2);
        var si := 0;
        var hit := -1;
        loop suppliedKeys as sKey {
            if sKey == comp.label { hit = si; break; }
            si = si + 1;
        }
        mut compSuppliedIdx.pushBack(hit);
        ci2 = ci2 + 1;
    }
    if not needsScopedEval {
        mut fieldExprs: List<String> = [];
        var ci3 := 0;
        loop ci3 < compCount {
            comp := types.recordComponent(recordKind, ci3);
            chosen := suppliedCodes[compSuppliedIdx[ci3]];
            if cRecTag =!= "" {
                mut fieldExprs.pushBack("." + types.cFieldName(comp.prop) + " = " + chosen);
            } else {
                mut fieldExprs.pushBack(types.tsRecordPropKey(comp.label) + ": " + chosen);
            }
            ci3 = ci3 + 1;
        }
        recCode := if cRecTag =!= "" {
            "/*@T:" + recordKind + "@*/((" + cRecTag + "){ " + fieldExprs.join(", ") + " })"
        } else {
            "{ " + fieldExprs.join(", ") + " }"
        };
        return ctx.withMarkers((kind = recordKind, code = recCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers);
    }
    recId := ctx.nextCtxId(ctxs) + braceStart;
    mut rfVars: List<String> = [];
    mut declBuf: tb.TextBuilder;
    mut stmtBuf: tb.TextBuilder;
    mut litFields: List<String> = [];
    var ci4 := 0;
    loop ci4 < compCount {
        comp := types.recordComponent(recordKind, ci4);
        rfVar := if target == ir.TARGET_C {
            "lt_rf_" + recId.toText() + "_" + ci4.toText()
        } else {
            "lite$rf" + recId.toText() + "_" + ci4.toText()
        };
        mut rfVars.pushBack(rfVar);
        if target == ir.TARGET_C {
            mut declBuf.append(types.cValueType(comp.kind));
            mut declBuf.append(" ");
            mut declBuf.append(rfVar);
            mut declBuf.append("; ");
            mut litFields.pushBack("." + types.cFieldName(comp.prop) + " = " + rfVar);
        } else {
            tsTy := if types.needsTsTypeAnnotation(comp.kind) { ": " + types.tsFunctionType(comp.kind) } else { "" };
            mut declBuf.append("let ");
            mut declBuf.append(rfVar);
            mut declBuf.append(tsTy);
            mut declBuf.append("; ");
            mut litFields.pushBack(types.tsRecordPropKey(comp.label) + ": " + rfVar);
        }
        ci4 = ci4 + 1;
    }
    var swIdx := 0;
    loop swIdx < suppliedCompIndices.length() {
        cTarget := suppliedCompIndices[swIdx];
        cKind := types.recordComponent(recordKind, cTarget).kind;
        rfTarget := rfVars[cTarget];
        if target == ir.TARGET_C {
            mut stmtBuf.append(ctx.cUnwrapIntoVar(rfTarget, cKind, suppliedCodes[swIdx]));
            mut stmtBuf.append(" (void)");
            mut stmtBuf.append(rfTarget);
            mut stmtBuf.append("; ");
        } else {
            mut stmtBuf.append(rfTarget);
            mut stmtBuf.append(" = ");
            mut stmtBuf.append(suppliedCodes[swIdx]);
            mut stmtBuf.append("; ");
        }
        swIdx = swIdx + 1;
    }
    scopedRecCode := if target == ir.TARGET_C {
        ltRecVar := "lt_rec_" + recId.toText();
        "/*@CBLK:" + ltRecVar + "@*/" + cRecTag + " " + ltRecVar + "; { " + declBuf.build() + stmtBuf.build() + ltRecVar + " = /*@T:" + recordKind + "@*/((" + cRecTag + "){ " + litFields.join(", ") + " }); }"
    } else {
        "(((): " + types.tsFunctionType(recordKind) + " => { " + declBuf.build() + stmtBuf.build() + "return { " + litFields.join(", ") + " }; })())"
    };
    ctx.withMarkers((kind = recordKind, code = scopedRecCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers)
};

/** Detects a leading `(...) :=`, `{...} :=`, `[...] :=` (or `var ...`) destructuring pattern, rejecting construction-shaped `Name {...} :=` headers. */
pub scanDestructureStart := fn(source: String, cursor: Int, limit: Int, prefix: String): (openPos: Int, isMutable: Bool) {
    if cursor >= limit { return (openPos = -1, isMutable = false); }
    ch := source.at(cursor);
    if ch == "(" or ch == "{" or ch == "[" {
        endPos := if ch == "(" { syntax.scanParenEnd(source, cursor, prefix) } else if ch == "{" { syntax.scanBraceEnd(source, cursor, prefix) } else { syntax.scanBracketEnd(source, cursor, prefix) };
        afterEnd := if endPos >= 0 { syntax.skipTrivia(source, endPos, prefix) } else { -1 };
        if afterEnd >= 0 and afterEnd < limit and source.startsWithAt(afterEnd, ":=") {
            return (openPos = cursor, isMutable = false);
        }
        return (openPos = -1, isMutable = false);
    }
    if ch == "v" and source.wordAt(cursor, "var") {
        afterVar := syntax.skipTrivia(source, cursor + 3, prefix);
        if afterVar < limit {
            vCh := source.at(afterVar);
            if vCh == "(" or vCh == "{" or vCh == "[" {
                return (openPos = afterVar, isMutable = true);
            }
            if vCh.isNameStart() {
                varPatEnd := syntax.skipTrivia(source, source.skipName(afterVar), prefix);
                if varPatEnd < limit and source.at(varPatEnd) == "{" {
                    patBraceEnd := syntax.scanBraceEnd(source, varPatEnd, prefix);
                    afterPatBrace := if patBraceEnd >= 0 { syntax.skipTrivia(source, patBraceEnd, prefix) } else { -1 };
                    if afterPatBrace >= 0 and source.startsWithAt(afterPatBrace, ":=") {
                        syntax.failAt(source, afterVar, prefix, "construction-shaped record pattern is not allowed; omit the type name");
                    }
                }
            }
        }
    }
    (openPos = -1, isMutable = false)
};

/** Parses `{ ... }`, `( ... )`, or `[ ... ]` destructuring clauses uniformly, including `= name` shorthand, `bind = field`, `: Type`, and `_`. */
pub parseAggregatePattern := fn(source: String, openPos: Int, prefix: String, aliases: List<AliasDecl>): (shape: String, count: Int, grouped: Bool, groupedType: String, encodedClauses: String, next: Int) {
    size := source.length();
    openDelim := source.at(openPos);
    shape := if openDelim == "{" { "record" } else if openDelim == "(" { "tuple" } else { "array" };
    closeDelim := if openDelim == "{" { "}" } else if openDelim == "(" { ")" } else { "]" };
    var cursor := syntax.skipTrivia(source, openPos + 1, prefix);
    mut seenRecBinds: List<String> = [];
    mut encodedBuf: tb.TextBuilder;
    var count := 0;
    var hadComma := false;
    var lastMode := "pos";
    var lastExpected := "";
    loop cursor < size and source.at(cursor) =!= closeDelim {
        var bindName := "";
        var sourceField := "";
        var expectedKind := "";
        var clauseMode := "pos";
        var clauseEnd := cursor;
        if syntax.isSingleEquals(source, cursor) {
            if shape == "array" {
                syntax.failAt(source, cursor, prefix, "array destructuring does not support = selector");
            }
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not source.at(shStart).isNameStart() {
                syntax.failAt(source, shStart, prefix, "expected field name after = in " + shape + " destructuring");
            }
            shEnd := source.skipName(shStart);
            shName := source.slice(shStart, shEnd);
            if syntax.isReservedWord(shName) { syntax.unsupportedFeature(source, shStart, shName, prefix); }
            if shName == "_" {
                syntax.failAt(source, shStart, prefix, "use _ = sourceField to discard a field");
            }
            if shape == "record" and seenRecBinds.contains(shName) {
                syntax.failAt(source, shStart, prefix, "duplicate record pattern binding " + shName);
            }
            bindName = shName;
            sourceField = shName;
            clauseMode = "named";
            afterSh := syntax.skipTrivia(source, shEnd, prefix);
            clauseEnd = afterSh;
            if afterSh < size and source.at(afterSh) == ":" {
                typed := types.parseLocalType(source, afterSh + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterSh, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                clauseEnd = syntax.skipTrivia(source, typed.next, prefix);
            }
        } else {
            if not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, if shape == "record" { "expected binding name in record pattern" } else { "expected a binding name in " + shape + " destructuring" });
            }
            bindStart := cursor;
            bindEnd := source.skipName(bindStart);
            bindName = source.slice(bindStart, bindEnd);
            if syntax.isReservedWord(bindName) { syntax.unsupportedFeature(source, bindStart, bindName, prefix); }
            if shape == "record" and bindName =!= "_" and seenRecBinds.contains(bindName) {
                syntax.failAt(source, bindStart, prefix, "duplicate record pattern binding " + bindName);
            }
            afterBind := syntax.skipTrivia(source, bindEnd, prefix);
            var checkEqPos := afterBind;
            if afterBind < size and source.at(afterBind) == ":" {
                typed := types.parseLocalType(source, afterBind + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterBind, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                checkEqPos = syntax.skipTrivia(source, typed.next, prefix);
            }
            clauseEnd = checkEqPos;
            if syntax.isSingleEquals(source, checkEqPos) {
                if shape == "array" {
                    syntax.failAt(source, checkEqPos, prefix, "array destructuring patterns do not use =");
                }
                fieldStart := syntax.skipTrivia(source, checkEqPos + 1, prefix);
                if fieldStart >= size or not source.at(fieldStart).isNameStart() {
                    syntax.failAt(source, fieldStart, prefix, "expected source field name after =");
                }
                fieldEnd := source.skipName(fieldStart);
                sourceField = source.slice(fieldStart, fieldEnd);
                if syntax.isReservedWord(sourceField) { syntax.unsupportedFeature(source, fieldStart, sourceField, prefix); }
                clauseMode = "named";
                clauseEnd = syntax.skipTrivia(source, fieldEnd, prefix);
            } else if shape == "record" {
                if bindName == "_" {
                    syntax.failAt(source, bindStart, prefix, if expectedKind =!= "" { "expected = sourceField after _" } else { "use _ = sourceField to discard a field" });
                }
                sourceField = bindName;
                clauseMode = "named";
            }
        }
        if shape == "record" and bindName =!= "_" { mut seenRecBinds.pushBack(bindName); }
        mut encodedBuf.append(types.encodeLengthPrefixedText(bindName));
        mut encodedBuf.append(types.encodeLengthPrefixedText(sourceField));
        mut encodedBuf.append(types.encodeLengthPrefixedText(expectedKind));
        mut encodedBuf.append(types.encodeLengthPrefixedText(clauseMode));
        lastMode = clauseMode;
        lastExpected = expectedKind;
        count = count + 1;
        cursor = clauseEnd;
        if cursor < size and source.at(cursor) == "," {
            hadComma = true;
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    encoded := encodedBuf.build();
    next := syntax.expectSymbol(source, cursor, closeDelim, prefix);
    if count == 0 and shape == "record" {
        syntax.failAt(source, openPos, prefix, "record destructuring needs at least one field clause");
    }
    if count == 0 and shape == "array" {
        syntax.failAt(source, openPos, prefix, "array destructuring needs at least one binding");
    }
    grouped := shape == "tuple" and count == 1 and not hadComma and lastMode == "pos";
    (shape = shape, count = count, grouped = grouped, groupedType = if grouped { lastExpected } else { "" }, encodedClauses = encoded, next = next)
};

/** Validates `rhsKind` against a parsed aggregate destructuring pattern and resolves each clause to `(bindName, propExpr, srcKind, targetKind)`. */
pub resolveAggregateBindings := fn(target: String, shape: String, count: Int, encodedClauses: String, rhsKind: String, tempRuntime: String, source: String, openPos: Int, prefix: String): String {
    if shape == "record" and not types.isRecordKind(rhsKind) {
        syntax.failAt(source, openPos, prefix, "record destructuring requires a record value, got " + types.displayKind(rhsKind));
    }
    if shape == "tuple" {
        if not types.isTupleKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "tuple destructuring requires a tuple value, got " + types.displayKind(rhsKind));
        }
        if types.tupleComponentCount(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "tuple destructuring expected " + count.toText() +
            " fields, got " + types.tupleComponentCount(rhsKind).toText());
        }
    }
    if shape == "array" {
        if types.isListKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "cannot destructure runtime-sized List<" + types.displayKind(types.listElementKind(rhsKind)) + ">; fixed array required");
        }
        if not types.isArrayKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "array destructuring requires an array value, got " + types.displayKind(rhsKind));
        }
        if types.arrayExtent(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "array destructuring expected " + count.toText() +
            " elements, got " + types.arrayExtent(rhsKind).toText());
        }
    }
    var claimedBag := "";
    mut out: tb.TextBuilder;
    var clCursor := 0;
    var clIndex := 0;
    loop clIndex < count {
        bindPart := types.decodeLengthPrefixedAt(encodedClauses, clCursor);
        fieldPart := types.decodeLengthPrefixedAt(encodedClauses, bindPart.next);
        typePart := types.decodeLengthPrefixedAt(encodedClauses, fieldPart.next);
        modePart := types.decodeLengthPrefixedAt(encodedClauses, typePart.next);
        clCursor = modePart.next;
        bindName := bindPart.text;
        sourceField := fieldPart.text;
        expectedKind := typePart.text;
        clauseMode := modePart.text;
        var srcKind := "";
        var propExpr := "";
        if shape == "record" {
            srcKind = types.recordFieldKind(rhsKind, sourceField);
            if srcKind == "" {
                syntax.failAt(source, openPos, prefix, "record " + types.recordDisplayName(rhsKind) + " has no field " + sourceField);
            }
            recProp := types.recordComponentProp(rhsKind, sourceField);
            propExpr = tempRuntime + "." + (if target == ir.TARGET_C { types.cFieldName(recProp) } else { recProp });
        } else if shape == "tuple" {
            var compIdx := -1;
            if clauseMode == "named" {
                compIdx = types.tupleComponentIndexByLabel(rhsKind, sourceField);
                if compIdx < 0 {
                    syntax.failAt(source, openPos, prefix, "tuple has no field " + sourceField);
                }
                idxTok := compIdx.toText();
                if trace.tokenInPipeBag(claimedBag, idxTok) {
                    syntax.failAt(source, openPos, prefix, "duplicate selection of tuple field " + sourceField);
                }
                claimedBag = trace.appendPipeBag(claimedBag, idxTok);
            } else {
                var probe := 0;
                loop probe < count {
                    idxTok := probe.toText();
                    if not trace.tokenInPipeBag(claimedBag, idxTok) {
                        compIdx = probe;
                        claimedBag = trace.appendPipeBag(claimedBag, idxTok);
                        break;
                    }
                    probe = probe + 1;
                }
            }
            comp := types.tupleComponent(rhsKind, compIdx);
            srcKind = comp.kind;
            propExpr = tempRuntime + "." + (if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop });
        } else {
            srcKind = types.arrayElementKind(rhsKind);
            if target == ir.TARGET_C and types.cArrayTag(rhsKind) =!= "" {
                if numeric.isSubByteIntKind(srcKind) {
                    propExpr = types.cArrayTag(rhsKind) + "_get_raw(" + tempRuntime + ", " + clIndex.toText() + ")";
                } else {
                    propExpr = tempRuntime + ".data[" + clIndex.toText() + "]";
                }
            } else if target == ir.TARGET_C and types.cListTag(srcKind) =!= "" {
                propExpr = "lt_list_" + types.cListTag(srcKind) + "_at(" + tempRuntime + ", " + clIndex.toText() + ", " + openPos.toText() + ")";
            } else {
                propExpr = tempRuntime + "[" + clIndex.toText() + "]!";
            }
        }
        var targetKind := srcKind;
        if expectedKind =!= "" {
            if not types.isCompatibleKind(expectedKind, srcKind) {
                syntax.failAt(source, openPos, prefix, "cannot bind " + types.displayKind(srcKind) + " to " + types.displayKind(expectedKind));
            }
            targetKind = expectedKind;
        }
        mut out.append(types.encodeLengthPrefixedText(bindName));
        mut out.append(types.encodeLengthPrefixedText(propExpr));
        mut out.append(types.encodeLengthPrefixedText(srcKind));
        mut out.append(types.encodeLengthPrefixedText(targetKind));
        clIndex = clIndex + 1;
    }
    out.build()
};

/** Parses name-headed primaries: `Unit`, `true`/`false`, `not`, `if`/`match`/`loop`, `fn`, `self`, locals, module functions, and list intrinsics. */
parseNamedPrimaryExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    nameStart := start;
    next := source.skipName(start);
    name := source.slice(nameStart, next);
    if name == "Unit" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next);
    }
    if name == "true" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, true), true, true, next);
    }
    if name == "false" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, false), false, true, next);
    }
    if name == "not" {
        operand := parseBinaryCtx(target, source, next, prefix, locals, functions, params, currentName, "", 5, ctxs, iifeDepth, inferMode, "", aliases);
        operandLoopId := types.loopValMarkerId(operand.kind);
        if inferMode and operandLoopId >= 0 {
            return ctx.withMarkers(ctx.boolParsed("", false, false, operand.next),
            ctx.collectParsedMarkers("", operand) + operandLoopId.toText() + "=Bool\n");
        }
        if operand.kind =!= ir.VALUE_KIND_BOOL {
            syntax.failAt(source, nameStart, prefix, "not requires a Bool operand");
        }
        if operand.constant {
            value := operand.intValue == 0;
            return ctx.boolParsed(ir.targetBoolLiteralCode(target, value), value, true, operand.next);
        }
        swappedNarrow := if not inferMode { swapNarrowMeta(operand.textValue) } else { "" };
        notCode := if target == ir.TARGET_C and operand.code.startsWithAt(0, "/*@CBLK:") {
            uVar := freshCOwnedTemp("lt_un_");
            resVar := freshCOwnedTemp("lt_not_");
            uInit := ctx.cUnwrapIntoVar(uVar, ir.VALUE_KIND_BOOL, operand.code);
            "/*@CBLK:" + resVar + "@*/bool " + resVar + "; { bool " + uVar + "; " + uInit + " " + resVar + " = !" + uVar + "; }"
        } else {
            ir.targetNotCode(target, operand.code)
        };
        notRes := (kind = ir.VALUE_KIND_BOOL, code = notCode, intValue = 0, textValue = swappedNarrow, constant = false, next = operand.next);
        return ctx.withMarkers(notRes,
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if name == "if" or name == "match" {
        return parseCondExpr(target, source, name, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "loop" {
        return parseLoopExpr(target, source, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "do" {
        afterDo := syntax.skipTrivia(source, next, prefix);
        if afterDo >= source.length() or source.at(afterDo) =!= "{" {
            syntax.failAt(source, afterDo, prefix, "expected { after do");
        }
        blkLocMark := sym.localMark();
        blkAliasMark := sym.aliasMark();
        doRes := parseBlockExpr(target, source, afterDo, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, "", aliases);
        sym.rewindLocalsTo(blkLocMark);
        sym.rewindAliasesTo(blkAliasMark);
        return doRes;
    }
    if name == "comptime" {
        afterCt := syntax.skipTrivia(source, next, prefix);
        if afterCt >= source.length() or source.at(afterCt) =!= "{" {
            syntax.failAt(source, afterCt, prefix, "expected { after comptime");
        }
        ctDepth := ir.maxLocalLexDepth(locals);
        ctLocMark := sym.localMark();
        ctAliasMark := sym.aliasMark();
        mut ctLocs: List<Local> = locals;
        mut ctLocs.pushBack((name = "$inComptimeBlock", runtime = "", kind = ir.VALUE_KIND_BOOL, mutable = false, writable = false, depth = 0, constant = true, code = "", intValue = ctDepth, textValue = "", initState = ir.INIT_STATE_INIT));
        typedRes := parseBlockExpr(target, source, afterCt, prefix, ctLocs, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, "", aliases);
        sym.rewindLocalsTo(ctLocMark);
        sym.rewindAliasesTo(ctAliasMark);
        if inferMode { return typedRes; }
        if not comptimeEval.isMaterializableKind(typedRes.kind) {
            syntax.failAt(source, nameStart, prefix, "comptime block result type " + types.displayKind(typedRes.kind) + " cannot be materialized at compile time");
        }
        mut visBindings: List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)> = [];
        loop locals as vb {
            if vb.initState == ir.INIT_STATE_INIT and vb.name =!= "$inComptimeBlock" and vb.name =!= "$self_fn_rt" and
            vb.kind =!= ir.VALUE_KIND_MODULE and vb.kind =!= ir.VALUE_KIND_MODULE_FUNCTION and
            (vb.constant or comptimeEval.lookupLocalCtVal(vb.runtime) >= 0) {
                mut visBindings.pushBack((name = vb.name, runtime = vb.runtime, kind = vb.kind, constant = vb.constant, intValue = vb.intValue, textValue = vb.textValue));
            }
        }
        ev := comptimeEval.evalBlock(source, afterCt, prefix, comptimeEval.getActiveModule(), typedRes.kind, aliases, visBindings);
        if not ev.ok or ev.flow =!= comptimeEval.FlowKind.None {
            errMsg := if ev.error =!= "" { ev.error } else { "compile-time evaluation failed" };
            syntax.failAt(source, nameStart, prefix, errMsg);
        }
        mat := comptimeEval.materializeValue(target, typedRes.kind, ev.valId);
        comptimeEval.registerMaterializedCode(mat.code, ev.valId);
        return (kind = typedRes.kind, code = mat.code, intValue = mat.intValue, textValue = mat.textValue, constant = mat.constant, next = typedRes.next);
    }
    if name == "fn" {
        return parseFnLiteralExpr(target, source, nameStart, next, prefix, locals, functions, params, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "context" {
        afterCtxKw := syntax.skipTrivia(source, next, prefix);
        if afterCtxKw < source.length() and source.at(afterCtxKw) == "(" and
        sym.localIndex(locals, "context") < 0 and sym.findFunction(functions, "context") < 0 {
            return parseContextOverrideExpr(target, source, nameStart, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, "", aliases);
        }
    }
    if name == "mut" {
        mutLease := tryParseGroupedMutLease(source, nameStart, prefix, false);
        if not mutLease.matched {
            if mutLease.nameEnd > mutLease.nameStart {
                syntax.failAt(source, mutLease.nameEnd, prefix, "expected ) after mut " + source.slice(mutLease.nameStart, mutLease.nameEnd));
            }
            syntax.failAt(source, mutLease.nameStart, prefix, "expected a binding name after mut");
        }
        return parseMutReceiverCallExpr(target, source, mutLease.mutStart, mutLease.nameStart, mutLease.nameEnd, mutLease.next, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if syntax.isReservedWord(name) { syntax.unsupportedFeature(source, nameStart, name, prefix); }
    afterName := syntax.skipTrivia(source, next, prefix);
    isCallSite := afterName < source.length() and source.at(afterName) == "(";
    if name == "self" {
        selfLocalIdx := sym.localIndex(locals, "$self");
        if selfLocalIdx >= 0 {
            selfEntry := locals[selfLocalIdx];
            return (kind = selfEntry.kind, code = selfEntry.runtime, intValue = 0, textValue = "", constant = false, next = next);
        }
        paramSelfIdx := sym.localIndex(locals, "self");
        if paramSelfIdx < 0 or locals[paramSelfIdx].depth <= 0 {
            if currentName == "" { syntax.failAt(source, nameStart, prefix, "self is only available inside a function"); }
            selfRtIdx := sym.localIndex(locals, "$self_fn_rt");
            selfIndex := if selfRtIdx >= 0 and locals[selfRtIdx].runtime =!= "" {
                sym.findFunctionByRuntime(functions, locals[selfRtIdx].runtime)
            } else {
                sym.findFunction(functions, currentName)
            };
            if selfIndex >= 0 {
                return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = nameStart.toText(), intValue = selfIndex, textValue = currentName, constant = false, next = next);
            }
            syntax.failAt(source, nameStart, prefix, "unknown value " + name);
            return ctx.intParsed("", 0, true, start);
        }
    }
    index := sym.localIndex(locals, name);
    hasLocalShadow := index >= 0 and locals[index].depth >= -1;
    if hasLocalShadow {
        entry := locals[index];
        if entry.textValue.startsWithAt(0, "$recfld_fwd:") {
            restFwd := entry.textValue.slice(12, entry.textValue.length());
            sepFwd := restFwd.indexOf(":", 0);
            curFld := if sepFwd >= 0 { restFwd.slice(0, sepFwd) } else { "" };
            refFld := if sepFwd >= 0 { restFwd.slice(sepFwd + 1, restFwd.length()) } else { name };
            syntax.failAt(source, nameStart, prefix, "record field default for " + curFld + " cannot reference field " + refFld + " before it is initialized");
        }
        if entry.textValue.startsWithAt(0, "$param_fwd:") {
            restFwd := entry.textValue.slice(11, entry.textValue.length());
            sepFwd := restFwd.indexOf(":", 0);
            curP := if sepFwd >= 0 { restFwd.slice(0, sepFwd) } else { "" };
            refP := if sepFwd >= 0 { restFwd.slice(sepFwd + 1, restFwd.length()) } else { name };
            syntax.failAt(source, nameStart, prefix, "default for parameter " + curP + " cannot reference parameter " + refP);
        }
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        if entry.textValue == "ctx_closure_forbidden" {
            syntax.failAt(source, nameStart, prefix, "cannot capture borrowed or mut context '" + name + "' in a closure; declare context(...) on the closure instead");
        }
        if entry.textValue == "closure_forbidden" {
            msg := if types.containsDynKind(entry.kind) { "borrowed dyn Interface cannot be captured by closure" } else { "borrowed Slice<T> cannot be captured by closure" };
            syntax.failAt(source, nameStart, prefix, msg);
        }
        soaColPeek := if types.isSoaKind(entry.kind) {
            dotChk := syntax.skipTrivia(source, next, prefix);
            if dotChk < source.length() and source.at(dotChk) == "." {
                cSt := syntax.skipTrivia(source, dotChk + 1, prefix);
                if cSt < source.length() and source.at(cSt).isNameStart() {
                    cEnd := source.skipName(cSt);
                    cName := source.slice(cSt, cEnd);
                    afterC := syntax.skipTrivia(source, cEnd, prefix);
                    if (afterC >= source.length() or source.at(afterC) =!= "(") and
                    types.recordFieldKind(types.soaRecordKind(entry.kind), cName) =!= "" {
                        cName
                    } else { "" }
                } else { "" }
            } else { "" }
        } else { "" };
        if soaColPeek =!= "" {
            sliceBorrows.checkCanReadColumn(locals, entry.runtime, soaColPeek, name, source, nameStart, prefix);
        } else {
            sliceBorrows.checkCanReadBinding(locals, entry.runtime, name, source, nameStart, prefix);
        }
        idText := if types.isSliceKind(entry.kind) or types.isDynKind(entry.kind) {
            sliceBorrows.sliceIdentifierProvenance(entry.runtime, entry.depth, name, entry.textValue)
        } else {
            entry.textValue
        };
        return (kind = entry.kind, code = narrowedLocalReadCode(target, entry), intValue = entry.intValue, textValue = idText, constant = entry.constant, next = next);
    }
    fnCands := sym.findFunctions(functions, name);
    if fnCands.length() > 0 {
        callableIndex := fnCands[0];
        if currentName == "" and functions[callableIndex].declAt > nameStart {
            syntax.failAt(source, nameStart, prefix, "cannot access " + name + " before initialization");
        }
        fnCode := if fnCands.length() > 1 { "$ovfn:\n" + name + "\n" + nameStart.toText() } else { nameStart.toText() };
        return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = fnCode, intValue = callableIndex, textValue = name, constant = false, next = next);
    }
    if index >= 0 {
        entry := locals[index];
        ctSentinelIdx := sym.localIndex(locals, "$inComptimeBlock");
        if ctSentinelIdx >= 0 and entry.depth <= locals[ctSentinelIdx].intValue and
        entry.kind =!= ir.VALUE_KIND_MODULE and entry.kind =!= ir.VALUE_KIND_MODULE_FUNCTION and
        entry.name =!= "$inComptimeBlock" and entry.name =!= "$self_fn_rt" {
            if not entry.constant and comptimeEval.lookupLocalCtVal(entry.runtime) < 0 {
                syntax.failAt(source, nameStart, prefix, "comptime block cannot reference runtime value " + name);
            }
        }
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        if entry.textValue == "ctx_closure_forbidden" {
            syntax.failAt(source, nameStart, prefix, "cannot capture borrowed or mut context '" + name + "' in a closure; declare context(...) on the closure instead");
        }
        if entry.textValue == "closure_forbidden" {
            msg := if types.containsDynKind(entry.kind) { "borrowed dyn Interface cannot be captured by closure" } else { "borrowed Slice<T> cannot be captured by closure" };
            syntax.failAt(source, nameStart, prefix, msg);
        }
        soaColPeek := if types.isSoaKind(entry.kind) {
            dotChk := syntax.skipTrivia(source, next, prefix);
            if dotChk < source.length() and source.at(dotChk) == "." {
                cSt := syntax.skipTrivia(source, dotChk + 1, prefix);
                if cSt < source.length() and source.at(cSt).isNameStart() {
                    cEnd := source.skipName(cSt);
                    cName := source.slice(cSt, cEnd);
                    afterC := syntax.skipTrivia(source, cEnd, prefix);
                    if (afterC >= source.length() or source.at(afterC) =!= "(") and
                    types.recordFieldKind(types.soaRecordKind(entry.kind), cName) =!= "" {
                        cName
                    } else { "" }
                } else { "" }
            } else { "" }
        } else { "" };
        if soaColPeek =!= "" {
            sliceBorrows.checkCanReadColumn(locals, entry.runtime, soaColPeek, name, source, nameStart, prefix);
        } else {
            sliceBorrows.checkCanReadBinding(locals, entry.runtime, name, source, nameStart, prefix);
        }
        idText := if types.isSliceKind(entry.kind) or types.isDynKind(entry.kind) {
            sliceBorrows.sliceIdentifierProvenance(entry.runtime, entry.depth, name, entry.textValue)
        } else {
            entry.textValue
        };
        return (kind = entry.kind, code = narrowedLocalReadCode(target, entry), intValue = entry.intValue, textValue = idText, constant = entry.constant, next = next);
    }
    if name == "cast" and afterName < source.length() and (source.at(afterName) == "<" or source.at(afterName) == "(") {
        size := source.length();
        var targetKind := "";
        var openParen := afterName;
        if source.at(afterName) == "<" {
            typeStart := syntax.skipTrivia(source, afterName + 1, prefix);
            if inferMode {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, typeStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                targetKind = canRes.kind;
                afterTarget := syntax.skipTrivia(source, canRes.next, prefix);
                if afterTarget >= size or source.at(afterTarget) =!= ">" {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                openParen = syntax.skipTrivia(source, afterTarget + 1, prefix);
                if openParen >= size or source.at(openParen) =!= "(" {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
            } else {
                parsedTarget := types.parseTypeAt(source, typeStart, prefix, aliases, "cast target", "");
                targetKind = parsedTarget.kind;
                afterTarget := syntax.skipTrivia(source, parsedTarget.next, prefix);
                if afterTarget >= size or source.at(afterTarget) =!= ">" {
                    syntax.failAt(source, afterTarget, prefix, "expected > after cast target type");
                }
                openParen = syntax.skipTrivia(source, afterTarget + 1, prefix);
                if openParen >= size or source.at(openParen) =!= "(" {
                    syntax.failAt(source, openParen, prefix, "expected ( after cast<" + types.displayKind(targetKind) + ">");
                }
            }
        } else if expected =!= "" {
            targetKind = expected;
        }
        argStart := syntax.skipTrivia(source, openParen + 1, prefix);
        if argStart < size and source.at(argStart) == ")" {
            if inferMode {
                return (kind = targetKind, code = "", intValue = 0, textValue = "", constant = false, next = argStart + 1);
            }
            syntax.failAt(source, argStart, prefix, "cast expects exactly one argument");
        }
        argExpected := if targetKind =!= "" and types.isDistinctKind(targetKind) { types.distinctUnderlyingKind(targetKind) } else { "" };
        arg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
        argMarkers := if inferMode { ctx.collectParsedMarkers("", arg) } else { "" };
        afterArg := syntax.skipTrivia(source, arg.next, prefix);
        if afterArg < size and source.at(afterArg) == "," {
            if not inferMode {
                syntax.failAt(source, afterArg, prefix, "cast expects exactly one argument");
            }
        }
        closeParen := if inferMode and (afterArg >= size or source.at(afterArg) =!= ")") {
            next
        } else {
            syntax.expectSymbol(source, afterArg, ")", prefix)
        };
        if targetKind == "" {
            if inferMode {
                return ctx.withMarkers((kind = "", code = "", intValue = 0, textValue = "", constant = false, next = closeParen), argMarkers);
            }
            syntax.failAt(source, nameStart, prefix, "cast requires an explicit type argument cast<Type>(value) or an expected target type");
        }
        var castConst := false;
        if not inferMode {
            isWrap := types.isDistinctKind(targetKind) and types.distinctUnderlyingKind(targetKind) == arg.kind;
            isUnwrap := types.isDistinctKind(arg.kind) and types.distinctUnderlyingKind(arg.kind) == targetKind;
            isIntCast := numeric.isIntKind(targetKind) and numeric.isIntKind(arg.kind);
            isFloatCast := numeric.isFloatKind(targetKind) and numeric.isNumericKind(arg.kind);
            if not isWrap and not isUnwrap and not isIntCast and not isFloatCast {
                syntax.failAt(source, nameStart, prefix, "cannot cast " + types.displayKind(arg.kind) + " to " + types.displayKind(targetKind) + "; cast only converts directly between a distinct type and its underlying type");
            }
            castConst = (isWrap or isUnwrap) and arg.constant;
        }
        castCode := if numeric.isNumericKind(targetKind) and numeric.isNumericKind(arg.kind) {
            ir.targetNumericCastCode(target, targetKind, arg.kind, arg.code, nameStart)
        } else if target == ir.TARGET_C and (arg.code.startsWithAt(0, "/*@CBLK:") or arg.code.startsWithAt(0, "/*@T:")) {
            arg.code
        } else {
            "(" + arg.code + ")"
        };
        return ctx.withMarkers((kind = targetKind, code = castCode, intValue = if castConst { arg.intValue } else { 0 }, textValue = if castConst { arg.textValue } else { "" }, constant = castConst, next = closeParen), argMarkers);
    }
    if afterName < source.length() and (source.at(afterName) == "." or source.at(afterName) == "<") and
    (types.findAlias(aliases, name) >= 0 or name == "List" or name == "Map" or name == "Set" or name == "Array" or (source.at(afterName) == "." and (name == "String" or numeric.isNumericKind(name) or numeric.numericAliasKind(name) =!= ""))) {
        var resolvedType := "";
        var typeOwnerKey := "";
        var aliasParamsCsv := "";
        var aliasTplKind := "";
        var dotPos := afterName;
        isTypeApp := source.at(afterName) == "<";
        if isTypeApp {
            if inferMode {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                resolvedType = canRes.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
                dotPos = syntax.skipTrivia(source, canRes.next, prefix);
            } else {
                parsedType := types.parseTypeAt(source, nameStart, prefix, aliases, "type expression", "");
                resolvedType = parsedType.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
                dotPos = syntax.skipTrivia(source, parsedType.next, prefix);
            }
            if dotPos < source.length() and source.at(dotPos) == "{" {
                if not types.isRecordKind(resolvedType) {
                    if inferMode {
                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                    }
                    syntax.failAt(source, nameStart, prefix, "record construction requires a record type, got " + types.displayKind(resolvedType));
                }
                return parseRecordLiteral(target, source, dotPos, prefix, locals, functions, params, currentName, resolvedType, ctxs, iifeDepth, inferMode, aliases);
            }
            if dotPos >= source.length() or source.at(dotPos) =!= "." {
                if inferMode {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                syntax.failAt(source, dotPos, prefix, "expected { or . after type " + types.displayKind(resolvedType));
            }
        } else if name == "List" or name == "Map" or name == "Set" or name == "Array" or name == "String" or (types.findAlias(aliases, name) < 0 and (numeric.isNumericKind(name) or numeric.numericAliasKind(name) =!= "")) {
            numAlias := numeric.numericAliasKind(name);
            typeOwnerKey = if numAlias =!= "" { numAlias } else { name };
        } else if types.builtinFamilyFromAlias(aliases, name) =!= "" {
            bfFam := types.builtinFamilyFromAlias(aliases, name);
            typeOwnerKey = if bfFam == "SimdNative" { "Simd" } else { bfFam };
        } else if inferMode {
            genInfo := types.genericAliasTemplateInfo(source, nameStart, prefix, aliases, name);
            if genInfo.ownerKey =!= "" {
                typeOwnerKey = genInfo.ownerKey;
                aliasParamsCsv = genInfo.paramsCsv;
                aliasTplKind = genInfo.tplKind;
            } else {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                resolvedType = canRes.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
            }
        } else {
            genInfo := types.genericAliasTemplateInfo(source, nameStart, prefix, aliases, name);
            if genInfo.ownerKey =!= "" {
                typeOwnerKey = genInfo.ownerKey;
                aliasParamsCsv = genInfo.paramsCsv;
                aliasTplKind = genInfo.tplKind;
            } else {
                emptySeen: List<String> = [];
                resolvedType = types.resolveAliasKind(source, nameStart, prefix, aliases, name, emptySeen);
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
            }
        }
        memberStart := syntax.skipTrivia(source, dotPos + 1, prefix);
        if memberStart < source.length() and source.at(memberStart) == "$" {
            hookEnd := if memberStart + 1 < source.length() and source.at(memberStart + 1).isNameStart() {
                source.skipName(memberStart + 1)
            } else {
                memberStart + 1
            };
            syntax.failAt(source, memberStart, prefix, "compiler hook " + source.slice(memberStart, hookEnd) + " cannot be referenced directly; use [...] indexing");
        }
        if memberStart >= source.length() or not source.at(memberStart).isNameStart() {
            syntax.failAt(source, memberStart, prefix, "expected member name after " + name + ".");
        }
        memberEnd := source.skipName(memberStart);
        memberName := source.slice(memberStart, memberEnd);
        if types.isEnumKind(resolvedType) {
            caseIdx := types.enumCaseIndex(resolvedType, memberName);
            if caseIdx >= 0 {
                return parseEnumCaseConstruct(target, source, resolvedType, memberName, caseIdx, memberEnd, memberStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
            }
            if memberName == "from" and types.enumBackingKind(resolvedType) =!= "" {
                return parseEnumFromCall(target, source, resolvedType, memberEnd, memberStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
            }
        }
        propIdx := findStaticTypeProperty(source, memberStart, prefix, locals, if not isTypeApp { name + "." + memberName } else { "" }, typeOwnerKey, resolvedType, memberName, inferMode);
        if propIdx >= 0 {
            pEntry := locals[propIdx];
            afterMember := syntax.skipTrivia(source, memberEnd, prefix);
            if not inferMode and afterMember < source.length() and source.at(afterMember) == "(" and not types.isFnKind(pEntry.kind) {
                syntax.failAt(source, memberStart, prefix, "static property " + name + "." + memberName + " is not callable");
            }
            return (kind = pEntry.kind, code = pEntry.code, intValue = pEntry.intValue, textValue = pEntry.textValue, constant = pEntry.constant, next = memberEnd);
        }
        if numeric.isIntKind(typeOwnerKey) and memberName == "trunc" {
            openTrunc := syntax.expectSymbol(source, syntax.skipTrivia(source, memberEnd, prefix), "(", prefix);
            truncArg := parseBinaryCtx(target, source, openTrunc, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
            closeTrunc := syntax.expectSymbol(source, syntax.skipTrivia(source, truncArg.next, prefix), ")", prefix);
            if not inferMode and not numeric.isFloatKind(truncArg.kind) {
                syntax.failAt(source, memberStart, prefix, typeOwnerKey + ".trunc expects a Float operand, got " + types.displayKind(truncArg.kind));
            }
            truncCode := if inferMode or not numeric.isFloatKind(truncArg.kind) { "" } else {
                ir.targetFloatTruncCode(target, typeOwnerKey, truncArg.kind, truncArg.code, memberStart)
            };
            return ctx.withMarkers((kind = typeOwnerKey, code = truncCode, intValue = 0, textValue = "", constant = false, next = closeTrunc), if inferMode { ctx.collectParsedMarkers("", truncArg) } else { "" });
        }
        if isNumericHardBuiltin(typeOwnerKey, memberName, true) {
            return parseNumericHardBuiltin(
            target, source, memberStart, prefix, typeOwnerKey, memberName, false,
            ctx.intParsed("", 0, false, start),
            locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases
            );
        }
        opCands := findAllTypeOpsForKind(functions, typeOwnerKey, resolvedType, aliasTplKind, memberName);
        if opCands.length() > 1 {
            dispType := if resolvedType =!= "" { types.displayKind(resolvedType) } else { name };
            ovTopCode := ["$ovtop:", typeOwnerKey, memberName, resolvedType, aliasParamsCsv, aliasTplKind, nameStart.toText(), memberStart.toText()].join("\n");
            return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = ovTopCode, intValue = opCands[0],
            textValue = dispType + "." + memberName, constant = false, next = memberEnd);
        } else if opCands.length() == 1 {
            opIdx := opCands[0];
            opRes := resolveTypeQualifiedOp(
            source, memberStart, prefix, opIdx, memberName, typeOwnerKey,
            resolvedType, aliasParamsCsv, aliasTplKind, functions, params, inferMode
            );
            if not opRes.ok {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
            }
            dispType := if resolvedType =!= "" { types.displayKind(resolvedType) } else { name };
            opCode := nameStart.toText() + (if opRes.initBindings =!= "" { "|" + opRes.initBindings } else { "" });
            return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = opCode, intValue = opIdx,
            textValue = dispType + "." + memberName, constant = false, next = memberEnd);
        }
        if types.isEnumKind(resolvedType) {
            syntax.failAt(source, memberStart, prefix, "enum " + types.enumDisplayName(resolvedType) + " has no case " + memberName);
        }
        if not isTypeApp and typeOwnerKey.startsWithAt(0, "Enum:") {
            syntax.failAt(source, nameStart, prefix, "generic type " + name + " requires explicit type arguments");
        }
        syntax.failAt(source, memberStart, prefix, "type " + name + " has no operation " + memberName);
    }
    if afterName < source.length() and source.at(afterName) == "{" and (types.findAlias(aliases, name) >= 0 or name == "Error") {
        var resolvedRec := "";
        if inferMode {
            emptySeen: List<String> = [];
            canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
            if not canRes.ok or not types.isRecordKind(canRes.kind) {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
            }
            resolvedRec = canRes.kind;
        } else if types.findAlias(aliases, name) < 0 and name == "Error" {
            resolvedRec = types.CORE_ERROR_KIND;
        } else {
            emptySeen: List<String> = [];
            resolvedRec = types.resolveAliasKind(source, nameStart, prefix, aliases, name, emptySeen);
            if not types.isRecordKind(resolvedRec) {
                syntax.failAt(source, nameStart, prefix, "record construction requires a record type, got " + types.displayKind(resolvedRec));
            }
        }
        return parseRecordLiteral(target, source, afterName, prefix, locals, functions, params, currentName, resolvedRec, ctxs, iifeDepth, inferMode, aliases);
    }
    if afterName < source.length() and (source.at(afterName) == "." or source.at(afterName) == "<") and
    (name == "Rc" or name == "Slice" or name == "Simd" or name == "SimdNative" or name == "SoA") and
    types.findAlias(aliases, name) < 0 {
        types.failMissingBuiltinFamily(source, nameStart, prefix, name);
    }
    syntax.failAt(source, nameStart, prefix, "unknown value " + name);
    ctx.intParsed("", 0, true, start)
};

/** Emits TS or C11 tagged-union value code for payload-bearing enum case `caseIdx`. */
emitPayloadEnumValue := fn(target: String, enumKind: String, caseIdx: Int, argCodes: List<String>): String {
    if target == ir.TARGET_C {
        tag := types.cStructTag(enumKind);
        if argCodes.length() == 0 {
            return "/*@T:" + enumKind + "@*/" + tag + "_mk_" + caseIdx.toText() + "()";
        }
        var hasCBlkArg := false;
        loop argCodes as ac {
            if ac.startsWithAt(0, "/*@CBLK:") { hasCBlkArg = true; break; }
        }
        if hasCBlkArg {
            payloads := types.enumCasePayloads(enumKind, caseIdx);
            mut eStmts: List<String> = [];
            mut eVars: List<String> = [];
            var pi := 0;
            loop pi < argCodes.length() {
                if argCodes[pi].startsWithAt(0, "/*@CBLK:") and pi < payloads.length() {
                    epVar := freshCOwnedTemp("lt_ep_");
                    pk := payloads[pi];
                    mut eStmts.pushBack(types.cValueType(pk) + " " + epVar + "; " + ctx.cUnwrapIntoVar(epVar, pk, argCodes[pi]) + " (void)" + epVar + ";");
                    mut eVars.pushBack(epVar);
                } else {
                    mut eVars.pushBack(argCodes[pi]);
                }
                pi = pi + 1;
            }
            eRet := freshCOwnedTemp("lt_er_");
            return "/*@CBLK:" + eRet + "@*/" + tag + " " + eRet + "; { " + eStmts.join(" ") + " " + eRet + " = /*@T:" + enumKind + "@*/" + tag + "_mk_" + caseIdx.toText() + "(" + eVars.join(", ") + "); }";
        }
        return "/*@T:" + enumKind + "@*/" + tag + "_mk_" + caseIdx.toText() + "(" + argCodes.join(", ") + ")";
    }
    tsT := types.tsFunctionType(enumKind);
    mut objBuf: tb.TextBuilder;
    mut objBuf.append("_t: ");
    mut objBuf.append(caseIdx.toText());
    mut objBuf.append(" as const");
    var pi := 0;
    loop pi < argCodes.length() {
        mut objBuf.append(", _");
        mut objBuf.append(pi.toText());
        mut objBuf.append(": ");
        mut objBuf.append(argCodes[pi]);
        pi = pi + 1;
    }
    "({ " + objBuf.build() + " } as " + tsT + ")"
};

/** Parses plain or payload-bearing enum case construction (`Enum.Case` / `.Case(...)`), validating payload count and types. */
parseEnumCaseConstruct := fn(target: String, source: String, enumKind: String, caseName: String, caseIdx: Int, caseEnd: Int, errPos: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    afterCase := syntax.skipTrivia(source, caseEnd, prefix);
    isPayload := types.isPayloadEnumKind(enumKind);
    emptyPayloads: List<String> = [];
    payloads := if isPayload { types.enumCasePayloads(enumKind, caseIdx) } else { emptyPayloads };
    if payloads.length() == 0 {
        if afterCase < size and source.at(afterCase) == "(" {
            syntax.failAt(source, afterCase, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " takes no payload arguments");
        }
        if isPayload {
            emptyArgs: List<String> = [];
            return (kind = enumKind, code = emitPayloadEnumValue(target, enumKind, caseIdx, emptyArgs), intValue = caseIdx, textValue = "", constant = false, next = caseEnd);
        }
        return (kind = enumKind, code = caseIdx.toText(), intValue = caseIdx, textValue = "", constant = true, next = caseEnd);
    }
    if afterCase >= size or source.at(afterCase) =!= "(" {
        syntax.failAt(source, errPos, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " requires " + payloads.length().toText() + " payload argument(s)");
    }
    var cursor := syntax.skipTrivia(source, afterCase + 1, prefix);
    mut argCodes: List<String> = [];
    var markers := "";
    var ai := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        if ai >= payloads.length() {
            syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " expects " + payloads.length().toText() + " payload argument(s)");
        }
        expKind := payloads[ai];
        arg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, expKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, arg); }
        if not types.isCompatibleKind(expKind, arg.kind) {
            syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " argument " + (ai + 1).toText() + " must be " + types.displayKind(expKind) + ", got " + types.displayKind(arg.kind));
        }
        mut argCodes.pushBack(ctx.assignValueCode(target, expKind, arg.kind, arg.code));
        ai = ai + 1;
        cursor = syntax.skipTrivia(source, arg.next, prefix);
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if cursor >= size or source.at(cursor) =!= ")" {
        syntax.failAt(source, cursor, prefix, "expected ) after enum payload arguments");
    }
    if argCodes.length() =!= payloads.length() {
        syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " expects " + payloads.length().toText() + " payload argument(s), got " + argCodes.length().toText());
    }
    ctx.withMarkers((kind = enumKind, code = emitPayloadEnumValue(target, enumKind, caseIdx, argCodes), intValue = caseIdx, textValue = "", constant = false, next = cursor + 1), markers)
};

/** Parses and lowers `Enum.from(value)` on value enums into `Option<Enum>`, returning the first-declared matching case. */
parseEnumFromCall := fn(
target: String, source: String, enumKind: String, memberEnd: Int, errPos: Int, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>
): Parsed {
    size := source.length();
    backing := types.enumBackingKind(enumKind);
    optInfo := types.resolveOptionTemplate(source, errPos, prefix, aliases);
    if not optInfo.ok {
        syntax.failAt(source, errPos, prefix, types.enumDisplayName(enumKind) + ".from requires Option<T> to be in scope (import \"type/option\" or preload it)");
    }
    mut optBindings: Map<String, String>;
    mut optBindings.set(optInfo.paramName, enumKind);
    optKind := types.substCanonicalKind(optInfo.paramsCsv, optInfo.tplKind, optBindings);
    vErr := types.validateCanonicalKind(optKind, "");
    if vErr =!= "" {
        syntax.failAt(source, errPos, prefix, vErr);
    }
    openParen := syntax.skipTrivia(source, memberEnd, prefix);
    if openParen >= size or source.at(openParen) =!= "(" {
        syntax.failAt(source, errPos, prefix, types.enumDisplayName(enumKind) + ".from expects (value) argument");
    }
    var argStart := syntax.skipTrivia(source, openParen + 1, prefix);
    if argStart < size and source.at(argStart) == ")" {
        syntax.failAt(source, argStart, prefix, types.enumDisplayName(enumKind) + ".from expects a " + types.displayKind(backing) + " value argument");
    }
    if argStart < size and source.wordAt(argStart, "value") {
        afterLbl := syntax.skipTrivia(source, argStart + 5, prefix);
        if syntax.isSingleEquals(source, afterLbl) {
            argStart = syntax.skipTrivia(source, afterLbl + 1, prefix);
        }
    }
    arg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, backing, 0, ctxs, iifeDepth, inferMode, "", aliases);
    closeParen := ctx.expectNonemptyCallClose(source, arg.next, prefix);
    if inferMode {
        return ctx.withMarkers((kind = optKind, code = "", intValue = 0, textValue = "", constant = false, next = closeParen),
        ctx.collectParsedMarkers("", arg));
    }
    if not types.isCompatibleKind(backing, arg.kind) {
        syntax.failAt(source, argStart, prefix, types.enumDisplayName(enumKind) + ".from expected " + types.displayKind(backing) + ", got " + types.displayKind(arg.kind));
    }
    caseCount := types.enumCaseCount(enumKind);
    if arg.constant and (backing == ir.VALUE_KIND_BOOL or backing == ir.VALUE_KIND_STRING or numeric.isSignedIntKind(backing)) {
        var ci := 0;
        loop ci < caseCount {
            vc := types.enumCaseAt(enumKind, ci).valueCode;
            var matched := false;
            if backing == ir.VALUE_KIND_BOOL {
                matched = (arg.intValue =!= 0) == (vc == "true");
            } else if backing == ir.VALUE_KIND_STRING {
                matched = arg.textValue == types.decodeEnumCaseString(vc);
            } else {
                di := types.decodeEnumCaseInt(vc);
                matched = di.ok and arg.intValue == di.value;
            }
            if matched {
                caseArgCode := if target == ir.TARGET_C { "(" + types.cValueType(enumKind) + ")" + ci.toText() } else { ci.toText() };
                return (kind = optKind, code = emitPayloadEnumValue(target, optKind, optInfo.someIdx, [caseArgCode]),
                intValue = 0, textValue = "", constant = false, next = closeParen);
            }
            ci = ci + 1;
        }
        emptyConstArgs: List<String> = [];
        return (kind = optKind, code = emitPayloadEnumValue(target, optKind, optInfo.noneIdx, emptyConstArgs),
        intValue = 0, textValue = "", constant = false, next = closeParen);
    }
    argExpr := if numeric.isNumericKind(backing) { ctx.assignValueCode(target, backing, arg.kind, arg.code) } else { arg.code };
    mut seenKeys: Set<String>;
    mut branchCaseIdx: List<Int> = [];
    mut branchCondLit: List<String> = [];
    var bi := 0;
    loop bi < caseCount {
        vc := types.enumCaseAt(enumKind, bi).valueCode;
        var dedupKey := "";
        var litCode := "";
        if backing == ir.VALUE_KIND_BOOL {
            bStr := if vc == "true" { "true" } else { "false" };
            dedupKey = bStr;
            litCode = bStr;
        } else if backing == ir.VALUE_KIND_STRING {
            decStr := types.decodeEnumCaseString(vc);
            dedupKey = decStr;
            litCode = ir.targetTextLiteralCode(target, decStr);
        } else if numeric.isIntKind(backing) {
            di := types.decodeEnumCaseInt(vc);
            dedupKey = (if di.neg { "-" } else { "" }) + di.digits;
            litCode = if target == ir.TARGET_TS {
                vc
            } else if numeric.isSignedIntKind(backing) {
                "((" + types.cValueType(backing) + ")" + ir.targetIntLiteralCode(ir.TARGET_C, di.value, di.neg, di.digits) + ")"
            } else {
                "((" + types.cValueType(backing) + ")" + ir.targetUIntLiteralCode(ir.TARGET_C, di.digits) + ")"
            };
        } else {
            ft := types.decodeEnumCaseFloatToken(vc);
            dedupKey = if ft.digits == "0" or ft.digits == "0.0" { "0" } else { (if ft.neg { "-" } else { "" }) + ft.digits };
            litCode = if target == ir.TARGET_TS {
                vc
            } else if backing == ir.VALUE_KIND_FLOAT32 {
                ir.targetFloat32LiteralCode(ir.TARGET_C, ft.digits, ft.neg)
            } else {
                ir.targetFloatLiteralCode(ir.TARGET_C, ft.digits, ft.neg)
            };
        }
        if not seenKeys.has(dedupKey) {
            mut seenKeys.add(dedupKey);
            mut branchCaseIdx.pushBack(bi);
            mut branchCondLit.pushBack(litCode);
        }
        bi = bi + 1;
    }
    emptyResArgs: List<String> = [];
    if target == ir.TARGET_C {
        optTag := types.cStructTag(optKind);
        enumCType := types.cValueType(enumKind);
        argVar := freshCOwnedTemp("lt_efv_");
        retVar := freshCOwnedTemp("lt_efr_");
        argCType := types.cValueType(backing);
        argInit := if argExpr.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(argVar, backing, argExpr) } else { argVar + " = " + argExpr + ";" };
        dropFn := types.cDropFnForKind(backing);
        argDrop := if dropFn =!= "" and (argExpr.startsWithAt(0, "/*@CBLK:") or ctx.isCFreshOwnedExpr(argExpr) or argExpr.startsWithAt(0, "/*@T:")) {
            " " + dropFn + "(&" + argVar + ");"
        } else { "" };
        cmpVar := if backing == ir.VALUE_KIND_FLOAT8 {
            "lt_f8_to_f64(" + argVar + ")"
        } else if backing == ir.VALUE_KIND_FLOAT16 {
            "lt_f16_to_f64(" + argVar + ")"
        } else {
            argVar
        };
        cmpKind := if backing == ir.VALUE_KIND_FLOAT8 or backing == ir.VALUE_KIND_FLOAT16 { ir.VALUE_KIND_FLOAT } else { backing };
        mut cBranches: tb.TextBuilder;
        var ci := 0;
        loop ci < branchCaseIdx.length() {
            if ci > 0 { mut cBranches.append(" else "); }
            cmpC := ir.targetComparisonCode(ir.TARGET_C, "==", cmpKind, cmpVar, branchCondLit[ci]);
            someCall := "/*@T:" + optKind + "@*/" + optTag + "_mk_" + optInfo.someIdx.toText() + "((" + enumCType + ")" + branchCaseIdx[ci].toText() + ")";
            mut cBranches.append("if (" + cmpC + ") { " + retVar + " = " + someCall + "; }");
            ci = ci + 1;
        }
        noneCall := emitPayloadEnumValue(ir.TARGET_C, optKind, optInfo.noneIdx, emptyResArgs);
        if branchCaseIdx.length() > 0 {
            mut cBranches.append(" else { " + retVar + " = " + noneCall + "; }");
        } else {
            mut cBranches.append(retVar + " = " + noneCall + ";");
        }
        cBlock := "/*@CBLK:" + retVar + "@*/" + optTag + " " + retVar + "; { " + argCType + " " + argVar + "; " + argInit + " " + cBranches.build() + argDrop + " }";
        return (kind = optKind, code = cBlock, intValue = 0, textValue = "", constant = false, next = closeParen);
    }
    tsOptT := types.tsFunctionType(optKind);
    tsArgT := types.tsFunctionType(backing);
    mut tsBranches: tb.TextBuilder;
    var ti := 0;
    loop ti < branchCaseIdx.length() {
        cmpTs := ir.targetComparisonCode(ir.TARGET_TS, "==", backing, "lite$ev", branchCondLit[ti]);
        someTs := emitPayloadEnumValue(ir.TARGET_TS, optKind, optInfo.someIdx, [branchCaseIdx[ti].toText()]);
        mut tsBranches.append("if (" + cmpTs + ") return " + someTs + "; ");
        ti = ti + 1;
    }
    noneTs := emitPayloadEnumValue(ir.TARGET_TS, optKind, optInfo.noneIdx, emptyResArgs);
    tsCode := "((lite$ev: " + tsArgT + "): " + tsOptT + " => { " + tsBranches.build() + "return " + noneTs + "; })(" + argExpr + ")";
    (kind = optKind, code = tsCode, intValue = 0, textValue = "", constant = false, next = closeParen)
};

/** Converts an arbitrary error value implementing `ToError` into `type/error.Error` on TS or C11. */
buildToErrorConversion := fn(target: String, source: String, pos: Int, prefix: String, errKind: String, errCode: String, functions: List<FunctionInfo>): (ok: Bool, code: String) {
    imp := types.findToErrorImpl(target, errKind);
    if not imp.found { return (ok = false, code = ""); }
    implDef := interfaces.getImpl(imp.implIdx);
    fnRt := resolveImplBindingRuntime(target, source, pos, prefix, implDef, imp.bindingsEncoded, "toError", functions);
    if target == ir.TARGET_TS {
        return (ok = true, code = fnRt + "(" + errCode + ")");
    }
    byPtr := types.cParamIsConstPtr(errKind);
    dropFn := types.cDropFnForKind(errKind);
    isFresh := ctx.isCFreshOwnedExpr(errCode);
    if byPtr or errCode.startsWithAt(0, "/*@CBLK:") or (dropFn =!= "" and isFresh) {
        argVar := freshCOwnedTemp("lt_tea_");
        retVar := freshCOwnedTemp("lt_ter_");
        argInit := if errCode.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(argVar, errKind, errCode) } else { argVar + " = " + errCode + ";" };
        callArg := if byPtr { "&" + argVar } else { argVar };
        postDrop := if dropFn =!= "" and isFresh { " " + dropFn + "(&" + argVar + ");" } else { "" };
        return (ok = true, code = "/*@CBLK:" + retVar + "@*/" + types.cValueType(types.CORE_ERROR_KIND) + " " + retVar + "; { " + types.cValueType(errKind) + " " + argVar + "; " + argInit + " " + retVar + " = " + fnRt + "(" + callArg + ");" + postDrop + " }");
    }
    (ok = true, code = fnRt + "(" + errCode + ")")
};

/** Converts an error expression `errCode` of `actualErrKind` to `targetErrKind`, applying `ToError` when targeting `Error`. */
convertResultErrorExpr := fn(target: String, source: String, pos: Int, prefix: String, targetErrKind: String, actualErrKind: String, actualErrCode: String, functions: List<FunctionInfo>): (ok: Bool, code: String) {
    if types.isCompatibleKind(targetErrKind, actualErrKind) {
        return (ok = true, code = ctx.assignValueCode(target, targetErrKind, actualErrKind, actualErrCode));
    }
    if targetErrKind == types.CORE_ERROR_KIND {
        return buildToErrorConversion(target, source, pos, prefix, actualErrKind, actualErrCode, functions);
    }
    (ok = false, code = "")
};

/** Builds a `Result<T, E>` constructor expression wrapping `valCode` as `.ok` (`isErr = false`) or `.err` (`isErr = true`). */
emitResultVariantExpr := fn(target: String, resKind: String, isErr: Bool, payloadKind: String, payloadCode: String): String {
    if target == ir.TARGET_C {
        tag := types.cStructTag(resKind);
        ctor := tag + (if isErr { "_err" } else { "_ok" });
        if payloadKind == ir.VALUE_KIND_UNIT {
            return "/*@T:" + resKind + "@*/" + ctor + "()";
        }
        if payloadCode.startsWithAt(0, "/*@CBLK:") {
            pVar := freshCOwnedTemp("lt_rp_");
            dVar := freshCOwnedTemp("lt_rd_");
            return "/*@CBLK:" + dVar + "@*/" + tag + " " + dVar + "; { " + types.cValueType(payloadKind) + " " + pVar + "; " + ctx.cUnwrapIntoVar(pVar, payloadKind, payloadCode) + " " + dVar + " = /*@T:" + resKind + "@*/" + ctor + "(" + pVar + "); }";
        }
        return "/*@T:" + resKind + "@*/" + ctor + "(" + payloadCode + ")";
    }
    tsT := types.tsFunctionType(resKind);
    if isErr {
        if payloadKind == ir.VALUE_KIND_UNIT { "({ _r: 1 as const } as " + tsT + ")" }
        else { "({ _r: 1 as const, _e: " + payloadCode + " } as " + tsT + ")" }
    } else {
        if payloadKind == ir.VALUE_KIND_UNIT { "({ _r: 0 as const } as " + tsT + ")" }
        else { "({ _r: 0 as const, _v: " + payloadCode + " } as " + tsT + ")" }
    }
};

/** Resolves leading-dot enum cases (`.Case`), Result constructors (`.ok`/`.err`), contextual static calls (`.create(...)`), or loop metadata (`.count`, `.value`, `.item`, `.index`). */
resolveLeadingDotExpr := fn(target: String, source: String, start: Int, prefix: String, expected: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    fieldStart := syntax.skipTrivia(source, start + 1, prefix);
    size := source.length();
    if fieldStart >= size or not source.at(fieldStart).isNameStart() {
        syntax.failAt(source, fieldStart, prefix, "expected metadata field name after .");
    }
    fieldEnd := source.skipName(fieldStart);
    fieldName := source.slice(fieldStart, fieldEnd);
    afterField := syntax.skipTrivia(source, fieldEnd, prefix);
    isCallOrGen := afterField < size and (source.at(afterField) == "(" or source.at(afterField) == "<");
    allowThroughCond := fieldName == "item" or fieldName == "index" or fieldName == "count";
    loopIdx := ctx.findLeadingDotLoopIdx(ctxs, allowThroughCond);
    normExp := normalizeExpectedValueKind(expected);
    hasExpectedType := normExp =!= "" and not normExp.startsWithAt(0, "__loopVal:");
    if hasExpectedType {
        if types.isResultKind(normExp) and (fieldName == "ok" or fieldName == "err") {
            isErrVariant := fieldName == "err";
            payloadKind := if isErrVariant { types.resultErrKind(normExp) } else { types.resultOkKind(normExp) };
            if payloadKind == ir.VALUE_KIND_UNIT {
                var endUnit := fieldEnd;
                if afterField < size and source.at(afterField) == "(" {
                    emptyCheck := syntax.skipTrivia(source, afterField + 1, prefix);
                    if emptyCheck < size and source.at(emptyCheck) == ")" {
                        endUnit = emptyCheck + 1;
                    } else {
                        syntax.failAt(source, afterField, prefix, "." + fieldName + " takes no payload arguments when payload type is Unit");
                    }
                }
                return (kind = normExp, code = emitResultVariantExpr(target, normExp, isErrVariant, ir.VALUE_KIND_UNIT, ""), intValue = 0, textValue = "", constant = false, next = endUnit);
            }
            if afterField >= size or source.at(afterField) =!= "(" {
                syntax.failAt(source, fieldStart, prefix, "Result." + fieldName + " requires payload argument(...)");
            }
            openResArg := afterField + 1;
            argRes := parseBinaryCtx(target, source, openResArg, prefix, locals, functions, params, currentName, payloadKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            closeResArg := ctx.expectNonemptyCallClose(source, argRes.next, prefix);
            if inferMode {
                return ctx.withMarkers((kind = normExp, code = "", intValue = 0, textValue = "", constant = false, next = closeResArg),
                ctx.collectParsedMarkers("", argRes));
            }
            convRes := if isErrVariant {
                convertResultErrorExpr(target, source, fieldStart, prefix, payloadKind, argRes.kind, argRes.code, functions)
            } else if types.isCompatibleKind(payloadKind, argRes.kind) {
                (ok = true, code = ctx.assignValueCode(target, payloadKind, argRes.kind, argRes.code))
            } else {
                (ok = false, code = "")
            };
            if not convRes.ok {
                syntax.failAt(source, fieldStart, prefix, "Result." + fieldName + " expected " + types.displayKind(payloadKind) + ", got " + types.displayKind(argRes.kind));
            }
            return (kind = normExp, code = emitResultVariantExpr(target, normExp, isErrVariant, payloadKind, convRes.code), intValue = 0, textValue = "", constant = false, next = closeResArg);
        }
        ownerKey := types.typeOpOwnerKey(normExp);
        isEnumCase := types.isEnumKind(normExp) and types.enumCaseIndex(normExp, fieldName) >= 0;
        propIdx := findStaticTypeProperty(source, fieldStart, prefix, locals, "", ownerKey, normExp, fieldName, inferMode);
        hasStaticProp := propIdx >= 0;
        mut staticCands: List<Int> = [];
        var hasInstOp := false;
        loop findAllTypeOpsForKind(functions, ownerKey, normExp, "", fieldName) as ci {
            if isStaticTypeOp(functions[ci]) {
                mut staticCands.pushBack(ci);
            } else {
                hasInstOp = true;
            }
        }
        isNumStatic := ownerKey =!= "" and isNumericHardBuiltin(ownerKey, fieldName, true);
        isLoopMetaName := fieldName == "count" or fieldName == "value" or fieldName == "item" or fieldName == "index" or fieldName == "collected";
        hasLoopMeta := loopIdx >= 0 and isLoopMetaName;
        if isEnumCase and hasLoopMeta {
            syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + "; qualify as " +
            types.enumDisplayName(normExp) + "." + fieldName + " or @tag." + fieldName);
        }
        if (staticCands.length() > 0 or isNumStatic or hasStaticProp) and hasLoopMeta {
            syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + "; qualify as " +
            types.displayKind(normExp) + "." + fieldName + " or @tag." + fieldName);
        }
        if isEnumCase and (staticCands.length() > 0 or isNumStatic or hasStaticProp) {
            syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + " on " + types.displayKind(normExp) + "; both an enum case and a static member exist");
        }
        if hasStaticProp and (staticCands.length() > 0 or isNumStatic) {
            syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + " on " + types.displayKind(normExp) + "; both a static property and a static operation exist");
        }
        if isEnumCase {
            caseIdx := types.enumCaseIndex(normExp, fieldName);
            return parseEnumCaseConstruct(target, source, normExp, fieldName, caseIdx, fieldEnd, fieldStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
        }
        if hasStaticProp {
            pEntry := locals[propIdx];
            if not inferMode and isCallOrGen and not types.isFnKind(pEntry.kind) {
                syntax.failAt(source, fieldStart, prefix, "contextual static property ." + fieldName + " is not callable");
            }
            return (kind = pEntry.kind, code = pEntry.code, intValue = pEntry.intValue, textValue = pEntry.textValue, constant = pEntry.constant, next = fieldEnd);
        }
        if isNumStatic {
            if afterField >= size or source.at(afterField) =!= "(" {
                syntax.failAt(source, fieldStart, prefix, "contextual static operation ." + fieldName + " on " + types.displayKind(normExp) + " must be called with (...)");
            }
            return parseNumericHardBuiltin(
            target, source, fieldStart, prefix, normExp, fieldName, false,
            ctx.intParsed("", 0, false, start),
            locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases
            );
        }
        if staticCands.length() > 0 {
            if not isCallOrGen {
                syntax.failAt(source, fieldStart, prefix, "contextual static operation ." + fieldName + " on " + types.displayKind(normExp) + " must be called with (...)");
            }
            if staticCands.length() > 1 {
                ovStaticCode := ["$ovstatictop:", ownerKey, fieldName, normExp, "", "", start.toText(), fieldStart.toText()].join("\n");
                return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = ovStaticCode, intValue = staticCands[0],
                textValue = types.displayKind(normExp) + "." + fieldName, constant = false, next = fieldEnd);
            }
            opIdx := staticCands[0];
            opRes := resolveTypeQualifiedOp(
            source, fieldStart, prefix, opIdx, fieldName, ownerKey,
            normExp, "", "", functions, params, inferMode
            );
            if not opRes.ok {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
            }
            opCode := start.toText() + (if opRes.initBindings =!= "" { "|" + opRes.initBindings } else { "" });
            return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = opCode, intValue = opIdx,
            textValue = types.displayKind(normExp) + "." + fieldName, constant = false, next = fieldEnd);
        }
        if types.isEnumKind(normExp) {
            if hasLoopMeta {
                syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + "; qualify as " +
                types.enumDisplayName(normExp) + "." + fieldName + " or @tag." + fieldName);
            }
            syntax.failAt(source, fieldStart, prefix, "enum " + types.enumDisplayName(normExp) + " has no case " + fieldName);
        }
        if loopIdx < 0 {
            if hasInstOp {
                syntax.failAt(source, fieldStart, prefix, "operation " + types.displayKind(normExp) + "." + fieldName + " is an instance operation and cannot be called with leading-dot shorthand");
            }
            if isCallOrGen {
                syntax.failAt(source, fieldStart, prefix, "type " + types.displayKind(normExp) + " has no static operation " + fieldName);
            }
        }
    }
    if not hasExpectedType and loopIdx < 0 and isCallOrGen {
        syntax.failAt(source, fieldStart, prefix, "leading-dot static call ." + fieldName + "(...) requires an expected type");
    }
    if loopIdx == ir.DOT_LOOP_IN_CONDITIONAL {
        syntax.failAt(source, start, prefix, "leading-dot ." + fieldName + " is not available inside a conditional; use an explicit loop @tag");
    } else if loopIdx == ir.DOT_LOOP_IN_FINALLY {
        syntax.failAt(source, start, prefix, "loop metadata is not available in finally");
    } else if loopIdx < 0 {
        syntax.failAt(source, start, prefix, "." + fieldName + " outside loop");
    }
    if target =!= ir.TARGET_TS and target =!= ir.TARGET_C {
        syntax.failAt(source, start, prefix, "C backend does not support loop metadata yet");
    }
    ctx.resolveLoopField(target, ctxs[loopIdx], fieldName, expected, source, fieldStart, fieldEnd, prefix)
};

/** Parses `{ ... }` block expressions, statement blocks, function bodies, loop bodies, finally blocks, and conditional branches. */
/** Emits one local declaration statement for TS or C11, unwrapping `/*@CBLK:<ret>@*/<body>` cleanly on C11. */
blockDeclStmt := fn(target: String, declKw: String, runtime: String, kind: String, tsTypeAnn: String, initCode: String): String {
    if target == ir.TARGET_C {
        if runtime.startsWithAt(0, "(*lt_cell_") {
            if initCode.startsWithAt(0, "/*@CBLK:") {
                endHdr := initCode.indexOf("@*/", 8);
                retVar := initCode.slice(8, endHdr);
                blkBody := initCode.slice(endHdr + 3, initCode.length());
                "{ " + blkBody + " " + runtime + " = " + retVar + "; }"
            } else {
                runtime + " = " + initCode + ";"
            }
        } else {
            cType := types.cValueType(kind);
            if initCode.startsWithAt(0, "/*@CBLK:") {
                endHdr := initCode.indexOf("@*/", 8);
                retVar := initCode.slice(8, endHdr);
                blkBody := initCode.slice(endHdr + 3, initCode.length());
                cType + " " + runtime + "; { " + blkBody + " " + runtime + " = " + retVar + "; } (void)" + runtime + ";"
            } else {
                cType + " " + runtime + " = " + initCode + "; (void)" + runtime + ";"
            }
        }
    } else {
        declKw + runtime + tsTypeAnn + " = " + initCode + "; void " + runtime + ";"
    }
};

/** Emits one assignment statement inside a block for TS or C11, dropping any overwritten owned C11 value and optionally maintaining a 1-byte init guard. */
blockAssignStmtGuarded := fn(target: String, runtime: String, kind: String, valCode: String, initFlag: String): String {
    dropFn := if target == ir.TARGET_C and kind =!= "" { types.cDropFnForKind(kind) } else { "" };
    setFlag := if target == ir.TARGET_C and initFlag =!= "" { " " + initFlag + " = 1;" } else { "" };
    guardDrop := if dropFn =!= "" {
        if initFlag =!= "" { "if (" + initFlag + ") { " + dropFn + "(&(" + runtime + ")); } " }
        else { dropFn + "(&(" + runtime + ")); " }
    } else { "" };
    if target == ir.TARGET_C and valCode.startsWithAt(0, "/*@CBLK:") {
        endHdr := valCode.indexOf("@*/", 8);
        retVar := valCode.slice(8, endHdr);
        blkBody := valCode.slice(endHdr + 3, valCode.length());
        "{ " + blkBody + " " + guardDrop + runtime + " = " + retVar + ";" + setFlag + " }"
    } else if dropFn =!= "" {
        tVar := freshCOwnedTemp("lt_ow_");
        "{ " + types.cValueType(kind) + " " + tVar + " = " + valCode + "; " + guardDrop + runtime + " = " + tVar + ";" + setFlag + " }"
    } else {
        runtime + " = " + valCode + ";"
    }
};

/** Emits one assignment statement inside a block for TS or C11, dropping any overwritten owned C11 value and unwrapping `/*@CBLK:<ret>@*/<body>` cleanly. */
blockAssignStmt := fn(target: String, runtime: String, kind: String, valCode: String): String {
    blockAssignStmtGuarded(target, runtime, kind, valCode, "")
};

/** Pushes a local declaration into `stmts`, tracking C11 owned cleanup, optional 1-byte init/drop guard, and tagged block pre-decls. */
pushBlockDeclCFlagged := fn(
isTaggedBody: Bool, target: String, declKw: String, rt: String, kind: String, tsAnn: String, initCode: String,
needsInitFlag: Bool, isReserved: Bool,
preDecls: mut List<String>, stmts: mut List<String>, owned: mut List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>
): Unit {
    cNeedsDrop := target == ir.TARGET_C and not rt.startsWithAt(0, "(*lt_cell_") and types.cTypeNeedsDrop(kind);
    if cNeedsDrop and needsInitFlag {
        initFlag := "lt_init_" + rt;
        rewrittenInit := initCode.split("__LT_PINIT_FLAG__").join(initFlag);
        cType := types.cValueType(kind);
        flagDecl := "uint8_t " + initFlag + " = 0; (void)" + initFlag + ";";
        if isTaggedBody {
            mut preDecls.pushBack(flagDecl);
            mut preDecls.pushBack(cType + " " + rt + "; memset(&" + rt + ", 0, sizeof(" + rt + ")); (void)" + rt + ";");
            if not isReserved {
                if rewrittenInit.startsWithAt(0, "/*@CBLK:") {
                    endHdr := rewrittenInit.indexOf("@*/", 8);
                    retVar := rewrittenInit.slice(8, endHdr);
                    blkBody := rewrittenInit.slice(endHdr + 3, rewrittenInit.length());
                    mut stmts.pushBack("{ " + blkBody + " " + rt + " = " + retVar + "; }");
                } else {
                    mut stmts.pushBack(rt + " = " + rewrittenInit + "; " + initFlag + " = 1;");
                }
            }
            mut owned.pushBack((stmtIdx = -1, =rt, =kind, =initFlag));
        } else {
            if isReserved {
                mut stmts.pushBack(flagDecl + " " + cType + " " + rt + "; memset(&" + rt + ", 0, sizeof(" + rt + ")); (void)" + rt + ";");
            } else if rewrittenInit.startsWithAt(0, "/*@CBLK:") {
                endHdr := rewrittenInit.indexOf("@*/", 8);
                retVar := rewrittenInit.slice(8, endHdr);
                blkBody := rewrittenInit.slice(endHdr + 3, rewrittenInit.length());
                mut stmts.pushBack(flagDecl + " " + cType + " " + rt + "; memset(&" + rt + ", 0, sizeof(" + rt + ")); { " + blkBody + " " + rt + " = " + retVar + "; } (void)" + rt + ";");
            } else {
                mut stmts.pushBack("uint8_t " + initFlag + " = 1; (void)" + initFlag + "; " + cType + " " + rt + " = " + rewrittenInit + "; (void)" + rt + ";");
            }
            mut owned.pushBack((stmtIdx = stmts.length() - 1, =rt, =kind, =initFlag));
        }
        contexts.registerBlockInitFlag(rt, initFlag);
        return;
    }
    if target == ir.TARGET_C and isTaggedBody and not rt.startsWithAt(0, "(*lt_cell_") and types.cTypeNeedsDrop(kind) {
        mut preDecls.pushBack(types.cValueType(kind) + " " + rt + " = " + ctx.zeroParsed(target, kind, 0).code + "; (void)" + rt + ";");
        mut stmts.pushBack(blockAssignStmt(target, rt, "", initCode));
        mut owned.pushBack((stmtIdx = -1, =rt, =kind, initFlag = ""));
    } else {
        effInitCode := if target == ir.TARGET_C and needsInitFlag and isReserved {
            "memset_zero"
        } else { initCode };
        if effInitCode == "memset_zero" and target == ir.TARGET_C and not rt.startsWithAt(0, "(*lt_cell_") {
            cTypeZ := types.cValueType(kind);
            mut stmts.pushBack(cTypeZ + " " + rt + "; memset(&" + rt + ", 0, sizeof(" + rt + ")); (void)" + rt + ";");
        } else {
            mut stmts.pushBack(blockDeclStmt(target, declKw, rt, kind, tsAnn, initCode));
        }
        if cNeedsDrop {
            mut owned.pushBack((stmtIdx = stmts.length() - 1, =rt, =kind, initFlag = ""));
        }
    }
};

/** Pushes a local declaration into `stmts`, tracking C11 owned cleanup and pre-declaring zero-init slots for tagged blocks. */
pushBlockDeclC := fn(
isTaggedBody: Bool, target: String, declKw: String, rt: String, kind: String, tsAnn: String, initCode: String,
preDecls: mut List<String>, stmts: mut List<String>, owned: mut List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>
): Unit {
    pushBlockDeclCFlagged(isTaggedBody, target, declKw, rt, kind, tsAnn, initCode, false, false, mut preDecls, mut stmts, mut owned);
};

/** Builds C11 cleanup statements dropping `owned` locals declared before `beforeStmtIdx` (or all if `< 0`) and releasing `cells`. */
buildBlockDropStmt := fn(owned: List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>, cells: List<(ptr: String, kind: String)>, beforeStmtIdx: Int): String {
    mut buf: tb.TextBuilder;
    var oi := owned.length() - 1;
    loop oi >= 0 {
        o := owned[oi];
        if beforeStmtIdx < 0 or o.stmtIdx < beforeStmtIdx {
            dFn := types.cDropFnForKind(o.kind);
            if dFn =!= "" {
                if o.initFlag =!= "" {
                    mut buf.append("if (");
                    mut buf.append(o.initFlag);
                    mut buf.append(") { ");
                    mut buf.append(dFn);
                    mut buf.append("(&");
                    mut buf.append(o.rt);
                    mut buf.append("); ");
                    mut buf.append(o.initFlag);
                    mut buf.append(" = 0; } ");
                } else {
                    mut buf.append(dFn);
                    mut buf.append("(&");
                    mut buf.append(o.rt);
                    mut buf.append("); ");
                }
            }
        }
        oi = oi - 1;
    }
    var ci := cells.length() - 1;
    loop ci >= 0 {
        cell := cells[ci];
        dFn := types.cDropFnForKind(cell.kind);
        if dFn =!= "" {
            mut buf.append("if (lt_box_dec(");
            mut buf.append(cell.ptr);
            mut buf.append(")) { ");
            mut buf.append(dFn);
            mut buf.append("(");
            mut buf.append(cell.ptr);
            mut buf.append("); lt_box_free_raw(");
            mut buf.append(cell.ptr);
            mut buf.append("); } ");
        } else {
            mut buf.append("lt_box_release(");
            mut buf.append(cell.ptr);
            mut buf.append("); ");
        }
        ci = ci - 1;
    }
    buf.build().trim()
};

/** Applies C11 block-owned + boxed-cell exit-drop rewrites to `stmts` and appends `fullDrop` when not `blockExits`. */
finalizeCBlockStmts := fn(
stmts: List<String>,
owned: List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>,
cells: List<(ptr: String, kind: String)>,
fnRetKind: String,
startPos: Int,
blockExits: Bool
): String {
    if owned.length() == 0 and cells.length() == 0 {
        return stmts.join(" ");
    }
    mut parts: List<String> = [];
    var si := 0;
    sCount := stmts.length();
    loop si < sCount {
        st := stmts[si];
        exitDrop := buildBlockDropStmt(owned, cells, si);
        mut parts.pushBack(if exitDrop =!= "" { ctx.cRewriteExitDrops(st, exitDrop, exitDrop, fnRetKind, startPos + si) } else { st });
        si = si + 1;
    }
    if not blockExits {
        fullDrop := buildBlockDropStmt(owned, cells, -1);
        if fullDrop =!= "" { mut parts.pushBack(fullDrop); }
    }
    parts.join(" ")
};

/** Extracts the original `(rt, kind)` of an initialized or narrowed union local. */
pub unwrapUnionOrigin := fn(loc: Local): (rt: String, kind: String) {
    if loc.textValue.startsWithAt(0, "$unarrow:") {
        rest := loc.textValue.slice(9, loc.textValue.length());
        tab := rest.indexOf("\t", 0);
        if tab > 0 {
            return (rt = rest.slice(0, tab), kind = rest.slice(tab + 1, rest.length()));
        }
    }
    (rt = loc.runtime, kind = loc.kind)
};

/** Projects a single narrowed union member or converts a sub-union when reading an existing local. */
narrowedLocalReadCode := fn(target: String, entry: Local): String {
    if entry.textValue.startsWithAt(0, "$unarrow:") {
        orig := unwrapUnionOrigin(entry);
        if entry.kind == orig.kind { return orig.rt; }
        if types.isUnionKind(entry.kind) {
            return ctx.convertUnionNarrowCode(target, entry.kind, orig.kind, orig.rt);
        }
        idx := types.unionMemberIndex(orig.kind, entry.kind);
        if idx >= 0 {
            if entry.kind == ir.VALUE_KIND_UNIT {
                return ir.targetUnitLiteralCode(target);
            }
            if target == ir.TARGET_C {
                return "((" + orig.rt + ").u.m" + idx.toText() + ")";
            }
            return "((" + orig.rt + " as { _u: " + idx.toText() + "; _v: " + types.tsFunctionType(entry.kind) + " })._v)";
        }
    }
    entry.runtime
};

/** Encodes true-path and false-path union narrowing facts into `Parsed.textValue`. */
encodeNarrowMeta := fn(trueFacts: String, falseFacts: String): String {
    if trueFacts == "" and falseFacts == "" { "" }
    else { "$narrow2:" + trueFacts + "<<<F>>>" + falseFacts }
};

/** Extracts `(trueFacts, falseFacts)` from `Parsed.textValue`. */
extractNarrowMeta := fn(textVal: String): (trueFacts: String, falseFacts: String) {
    if not textVal.startsWithAt(0, "$narrow2:") { return (trueFacts = "", falseFacts = ""); }
    rest := textVal.slice(9, textVal.length());
    sep := rest.indexOf("<<<F>>>", 0);
    if sep < 0 { return (trueFacts = rest, falseFacts = ""); }
    (trueFacts = rest.slice(0, sep), falseFacts = rest.slice(sep + 7, rest.length()))
};

/** Swaps true-path and false-path narrowing facts when wrapping an operand in `not`. */
swapNarrowMeta := fn(textVal: String): String {
    nf := extractNarrowMeta(textVal);
    encodeNarrowMeta(nf.falseFacts, nf.trueFacts)
};

/** Returns the false-path union narrowing facts carried by a parsed condition expression. */
pub extractFalseNarrowFacts := fn(condText: String): String {
    extractNarrowMeta(condText).falseFacts
};

/** Merges union narrowing facts, retaining untouched variables from `prevFacts` and refining/replacing with `newFacts`. */
pub mergeUnionFacts := fn(prevFacts: String, newFacts: String): String {
    if prevFacts == "" { return newFacts; }
    if newFacts == "" { return prevFacts; }
    mut byRt: Map<String, String>;
    mut order: List<String> = [];
    loop [prevFacts, newFacts] as fBlock {
        var pos := 0;
        bLen := fBlock.length();
        loop pos < bLen {
            nl := fBlock.indexOf("\n", pos);
            end := if nl < 0 { bLen } else { nl };
            line := fBlock.slice(pos, end);
            t1 := line.indexOf("\t", 0);
            if t1 > 0 {
                rt := line.slice(0, t1);
                if not byRt.has(rt) { mut order.pushBack(rt); }
                mut byRt.set(rt, line);
            }
            pos = end + 1;
        }
    }
    mut lines: List<String> = [];
    loop order as rt {
        mut lines.pushBack(byRt.get(rt).value);
    }
    lines.join("\n")
};

/** Applies newline-separated `origRt\torigKind\ttargetKind` union narrowing facts to `locals`, preserving `Local.runtime = origRt`. */
pub applyUnionNarrowing := fn(target: String, locals: List<Local>, facts: String): List<Local> {
    if facts == "" { return locals; }
    mut out: List<Local> = locals;
    var pos := 0;
    fLen := facts.length();
    loop pos < fLen {
        nl := facts.indexOf("\n", pos);
        end := if nl < 0 { fLen } else { nl };
        line := facts.slice(pos, end);
        t1 := line.indexOf("\t", 0);
        t2 := if t1 >= 0 { line.indexOf("\t", t1 + 1) } else { -1 };
        if t1 > 0 and t2 > t1 {
            rt := line.slice(0, t1);
            origKind := line.slice(t1 + 1, t2);
            targetKind := line.slice(t2 + 1, end);
            if rt =!= "" and targetKind =!= "" and types.isUnionKind(origKind) {
                var latestIdx := -1;
                var scanIdx := 0;
                loop out as l {
                    if l.depth >= -1 and l.runtime == rt and l.initState == ir.INIT_STATE_INIT {
                        latestIdx = scanIdx;
                    }
                    scanIdx = scanIdx + 1;
                }
                if latestIdx >= 0 {
                    cur := out[latestIdx];
                    refined := types.unionIntersect(cur.kind, targetKind);
                    if refined =!= "" and refined =!= cur.kind {
                        mut out.pushBack((name = cur.name, runtime = rt, kind = refined,
                        mutable = cur.mutable, writable = cur.writable, depth = cur.depth, constant = false,
                        code = cur.code, intValue = 0, textValue = "$unarrow:" + rt + "\t" + origKind, initState = cur.initState));
                    }
                }
            }
        }
        pos = end + 1;
    }
    out
};

/** Applies both immutable Bool predicate narrowing and union type-test narrowing for one branch direction. */
pub narrowLocalsForBranch := fn(target: String, locals: List<Local>, predRt: String, predVal: Bool, condText: String, onTrue: Bool): List<Local> {
    afterBool := ctx.narrowLocalsForPredicate(locals, predRt, predVal);
    nf := extractNarrowMeta(condText);
    facts := if onTrue { nf.trueFacts } else { nf.falseFacts };
    applyUnionNarrowing(target, afterBool, facts)
};

/** Extracts the identifier name when `source[exprStart..exprEnd)` (modulo outer parens) is a bare local reference. */
extractSimpleLocalIdent := fn(source: String, exprStart: Int, exprEnd: Int, prefix: String): String {
    var lo := syntax.skipTrivia(source, exprStart, prefix);
    var hi := exprEnd;
    loop hi > lo {
        ch := source.at(hi - 1);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" { hi = hi - 1; } else { break; }
    }
    loop lo < hi and source.at(lo) == "(" and source.at(hi - 1) == ")" and syntax.scanParenEnd(source, lo, prefix) == hi {
        lo = syntax.skipTrivia(source, lo + 1, prefix);
        hi = hi - 1;
        loop hi > lo {
            c := source.at(hi - 1);
            if c == " " or c == "\t" or c == "\n" or c == "\r" { hi = hi - 1; } else { break; }
        }
    }
    if lo >= hi or not source.at(lo).isNameStart() { return ""; }
    nEnd := source.skipName(lo);
    if syntax.skipTrivia(source, nEnd, prefix) < hi { return ""; }
    ident := source.slice(lo, nEnd);
    if syntax.isReservedWord(ident) or ident == "Unit" or ident == "true" or ident == "false" { "" } else { ident }
};

/** Returns `(rt, negated)` when `source[condStart..condEnd)` (after stripping parens and leading `not`) is an immutable initialized `Bool` local. */
pub extractImmBoolPredicate := fn(source: String, condStart: Int, condEnd: Int, prefix: String, locals: List<Local>): (rt: String, negated: Bool) {
    var lo := syntax.skipTrivia(source, condStart, prefix);
    var hi := condEnd;
    loop hi > lo {
        ch := source.at(hi - 1);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            hi = hi - 1;
        } else {
            break;
        }
    }
    var neg := false;
    loop lo < hi {
        if source.at(lo) == "(" and source.at(hi - 1) == ")" and syntax.scanParenEnd(source, lo, prefix) == hi {
            lo = syntax.skipTrivia(source, lo + 1, prefix);
            hi = hi - 1;
            loop hi > lo {
                c := source.at(hi - 1);
                if c == " " or c == "\t" or c == "\n" or c == "\r" { hi = hi - 1; } else { break; }
            }
            continue;
        }
        if lo + 3 <= hi and source.wordAt(lo, "not") {
            afterNot := syntax.skipTrivia(source, lo + 3, prefix);
            if afterNot > lo + 3 {
                neg = not neg;
                lo = afterNot;
                continue;
            }
        }
        break;
    }
    if lo >= hi or not source.at(lo).isNameStart() { return (rt = "", negated = false); }
    nameEnd := source.skipName(lo);
    if syntax.skipTrivia(source, nameEnd, prefix) < hi { return (rt = "", negated = false); }
    ident := source.slice(lo, nameEnd);
    if syntax.isReservedWord(ident) or ident == "true" or ident == "false" { return (rt = "", negated = false); }
    idx := sym.localIndex(locals, ident);
    if idx < 0 { return (rt = "", negated = false); }
    loc := locals[idx];
    if loc.depth < 0 or loc.kind =!= ir.VALUE_KIND_BOOL or loc.mutable or loc.initState =!= ir.INIT_STATE_INIT {
        return (rt = "", negated = false);
    }
    (rt = loc.runtime, negated = neg)
};

/** Captures outer-local init updates above `outerLen` inside `blockLocals` into `contexts` when finishing a stmt/branch block. */
saveBlockExitBranchRows := fn(blockLocals: List<Local>, outerLen: Int, maxOuterDepth: Int): Unit {
    mut rows: List<String> = [];
    mut seenRts: List<String> = [];
    var rev := blockLocals.length() - 1;
    loop rev >= outerLen {
        l := blockLocals[rev];
        if l.depth >= 0 and l.depth <= maxOuterDepth and not seenRts.contains(l.runtime) {
            mut seenRts.pushBack(l.runtime);
            mut rows.pushBack(l.runtime + "\t" + l.initState + "\t" + l.code);
        }
        rev = rev - 1;
    }
    contexts.setLastBranchInitRows(rows);
};

/** Appends saved outer-local init updates from `contexts` into `updates` for `(blockDepth, armIdx)`. */
collectBlockExitBranchUpdates := fn(blockDepth: Int, armIdx: Int, updates: List<ir.BranchUpdate>): List<ir.BranchUpdate> {
    mut out: List<ir.BranchUpdate> = updates;
    loop contexts.getLastBranchInitRows() as row {
        t1 := row.indexOf("\t", 0);
        t2 := if t1 >= 0 { row.indexOf("\t", t1 + 1) } else { -1 };
        if t1 > 0 and t2 > t1 {
            mut out.pushBack((depth = blockDepth, arm = armIdx, runtime = row.slice(0, t1),
            initState = row.slice(t1 + 1, t2), code = row.slice(t2 + 1, row.length())));
        }
    }
    contexts.clearLastBranchInitRows();
    out
};

/** Looks up the 1-byte C11 init guard identifier tracked in `owned` (or enclosing active blocks) for `rt`, or `""`. */
findBlockOwnedInitFlag := fn(owned: List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>, rt: String): String {
    var i := owned.length() - 1;
    loop i >= 0 {
        if owned[i].rt == rt and owned[i].initFlag =!= "" {
            return owned[i].initFlag;
        }
        i = i - 1;
    }
    contexts.lookupBlockInitFlag(rt)
};

/** Unregisters active block-local C11 init guards registered by `owned` when leaving a block. */
unregisterBlockOwnedInitFlags := fn(owned: List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)>): Unit {
    loop owned as o {
        if o.initFlag =!= "" {
            contexts.unregisterBlockInitFlag(o.rt);
        }
    }
};

/** Parses a declaration initializer inside a block, allowing a direct or parenthesized partial if to yield `$pinit:` state. */
parseBlockInitExpr := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, bodyDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    sourceLen := source.length();
    var inner := syntax.skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < sourceLen and source.at(inner) == "(" {
        parenCount = parenCount + 1;
        inner = syntax.skipTrivia(source, inner + 1, prefix);
    }
    ifKwPos := syntax.skipOptionalScanTag(source, inner, prefix, "if");
    if ifKwPos >= 0 and source.wordAt(ifKwPos, "if") {
        scannedEnd := syntax.scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := syntax.skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= source.length() or source.at(end) =!= ")" {
                    matched = false;
                    break;
                }
                end = syntax.skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and syntax.consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinaryCtx(target, source, inner, prefix, locals, functions, params, currentName, expected, -1, ctxs, bodyDepth, inferMode, "", aliases);
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, 0, ctxs, bodyDepth, inferMode, "", aliases)
};

/** Parses a braced block expression `{ ... }` and returns its evaluated target expression. */
parseBlockExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functionsIn: List<FunctionInfo>, paramsIn: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    var mut functions: List<FunctionInfo> = functionsIn;
    var mut params: List<String> = paramsIn;
    isTaggedBody := bodySink == "tagged";
    isLoopBody := bodySink == "loopBody" or bodySink.startsWithAt(0, "loopBody:");
    isStmtBody := bodySink == "stmt" or bodySink.startsWithAt(0, "stmt:");
    isFinallyBody := bodySink == "finally";
    isBranchBody := bodySink == "branch";
    isFnBody := bodySink == "fnBody" or bodySink.startsWithAt(0, "fnBody:");
    isStandaloneBlock := not isTaggedBody and not isLoopBody and not isStmtBody and not isFinallyBody and not isBranchBody and not isFnBody;
    allowOutput := isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isBranchBody or isFnBody or (bodySink == "exprOut");
    bodyDepth := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { iifeDepth } else { iifeDepth + 1 };
    stmtReturnPrefix := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { "" } else { "return " };
    var mut blockLocals: List<Local> = locals;
    outerLocalsLen := ctx.localsCount(blockLocals);
    blockLexDepth := ir.maxLocalLexDepth(blockLocals) + 1;
    emptyFuturesHere: List<FutureValue> = [];
    emptyItemsHere: List<Item> = [];
    nextAliasDepth := types.maxAliasDepth(aliases) + 1;
    blkFlags := syntax.scanBlockFastFlags(source, start, prefix);
    var mut blockAliases := if blkFlags.hasAliasKw {
        types.collectBlockTypeAliases(source, start, prefix, nextAliasDepth, aliases)
    } else {
        aliases
    };
    mut declaredInBlock: List<String> = [];
    var seedBag := "";
    loop ctx.seedBlockDeclaredNames(bodySink) as seededName {
        mut declaredInBlock.pushBack(seededName);
        seedBag = trace.appendPipeBag(seedBag, seededName);
    }
    hasFnInBlock := blkFlags.hasFn;
    hasReservedInBlock := blkFlags.hasReserved;
    blockAssignedBag := if hasReservedInBlock or hasFnInBlock {
        infer.scanInnerBlockAssignedBag(target, source, start, prefix, seedBag)
    } else {
        ""
    };
    mut statements: List<String> = [];
    mut blockCells: List<(ptr: String, kind: String)> = [];
    mut blockOwned: List<(stmtIdx: Int, rt: String, kind: String, initFlag: String)> = [];
    mut taggedPreDecls: List<String> = [];
    if hasFnInBlock {
        preScannedLocals := infer.appendBlockFutureLocals(target, source, start, prefix, blockLexDepth, seedBag, blockAssignedBag, blockAliases, functions, params, blockLocals);
        if target == ir.TARGET_C {
            placeholderDepthC := 0 - 2 - blockLexDepth;
            mut boxedLocals: List<Local> = [];
            loop preScannedLocals as entry {
                if entry.depth == placeholderDepthC and entry.kind =!= "" and entry.kind =!= ir.VALUE_KIND_UNIT and entry.kind =!= ir.VALUE_KIND_NEVER {
                    cT := types.cValueType(entry.kind);
                    if cT =!= "" and cT =!= "void" {
                        cellPtr := "lt_cell_" + entry.runtime;
                        cellRt := "(*" + cellPtr + ")";
                        mut statements.pushBack("/*@T:" + entry.kind + "@*/" + cT + " *" + cellPtr + " = (" + cT + " *)lt_box_alloc(sizeof(" + cT + ")); (void)" + cellPtr + ";");
                        mut blockCells.pushBack((ptr = cellPtr, kind = entry.kind));
                        mut boxedLocals.pushBack((name = entry.name, runtime = cellRt, kind = entry.kind,
                        mutable = entry.mutable, writable = entry.writable, depth = entry.depth,
                        constant = entry.constant, code = entry.code, intValue = entry.intValue,
                        textValue = entry.textValue, initState = entry.initState));
                    } else {
                        mut boxedLocals.pushBack(entry);
                    }
                } else {
                    mut boxedLocals.pushBack(entry);
                }
            }
            blockLocals = boxedLocals;
        } else {
            blockLocals = preScannedLocals;
        }
    }
    mut stmtOwners: List<String> = [];
    mut stmtDeps: List<String> = [];
    var trackedStmtCount := 0;
    var statementCount := 0;
    var blockMarkers := "";
    var cursor := syntax.skipItemSeparators(source, start + 1, prefix);
    var blockKind := ir.VALUE_KIND_UNIT;
    var blockCode := ir.targetUnitLiteralCode(target);
    var blockInt := 0;
    var blockText := "";
    var blockConstant := true;
    var blockExits := false;
    var sawTailExpr := false;
    var lastPartialIfDiverges := false;
    blockSourceSize := source.length();
    loop true {
        var syncLen := 0;
        loop statements { syncLen = syncLen + 1; }
        loop trackedStmtCount < syncLen {
            mut stmtOwners.pushBack("");
            mut stmtDeps.pushBack(statements[trackedStmtCount]);
            trackedStmtCount = trackedStmtCount + 1;
        }
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= blockSourceSize {
            syntax.failAt(source, start, prefix, "expected }");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        lastPartialIfDiverges = false;
        var isStatement := false;
        chAtCursor := source.at(cursor);
        scanDestr := scanDestructureStart(source, cursor, blockSourceSize, prefix);
        destructureOpen := scanDestr.openPos;
        destructureMutable := scanDestr.isMutable;
        if destructureOpen >= 0 {
            isStatement = true;
            destructure := parseAggregatePattern(source, destructureOpen, prefix, blockAliases);
            afterTarget := syntax.skipTrivia(source, destructure.next, prefix);
            if not source.startsWithAt(afterTarget, ":=") {
                syntax.failAt(source, afterTarget, prefix, "expected := after " + destructure.shape + " destructuring target");
            }
            rhs := parseBinaryCtx(target, source, syntax.skipTrivia(source, afterTarget + 2, prefix), prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
            if target == ir.TARGET_TS and not inferMode and not blockExits {
                trace.checkTraceSafety(source, destructureOpen, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
            }
            if destructure.shape == "tuple" and destructure.count == 0 {
                if destructureMutable {
                    syntax.failAt(source, destructureOpen, prefix, "var tuple destructuring needs at least one binding");
                }
                if types.isTupleKind(rhs.kind) {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring expected 0 fields, got " + types.tupleComponentCount(rhs.kind).toText());
                }
                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + types.displayKind(rhs.kind));
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if not blockExits {
                    if rhs.kind == ir.VALUE_KIND_NEVER {
                        mut statements.pushBack(stmtReturnPrefix + "(" + rhs.code + ");");
                        blockExits = true;
                    } else {
                        mut statements.pushBack(if target == ir.TARGET_C { "(void)(" + rhs.code + ");" } else { "void (" + rhs.code + ");" });
                        if reach.isPrunableExprForTarget(target, ir.VALUE_KIND_UNIT, rhs.code) {
                            mut stmtOwners.pushBack("#discard");
                            mut stmtDeps.pushBack("");
                        } else {
                            mut stmtOwners.pushBack("");
                            mut stmtDeps.pushBack(rhs.code);
                        }
                        trackedStmtCount = trackedStmtCount + 1;
                    }
                    statementCount = statementCount + 1;
                }
                if target == ir.TARGET_TS and not inferMode {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                blockConstant = false;
                cursor = statementNext;
            } else if destructure.grouped {
                bindPart := types.decodeLengthPrefixedAt(destructure.encodedClauses, 0);
                bindName := bindPart.text;
                ctx.rejectNonValueBinding(source, destructureOpen, prefix, rhs.kind, bindName);
                ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                var groupedBindKind := rhs.kind;
                if destructure.groupedType =!= "" {
                    if not types.isCompatibleKind(destructure.groupedType, rhs.kind) {
                        syntax.failAt(source, destructureOpen, prefix, "cannot bind " + types.displayKind(rhs.kind) + " to " + types.displayKind(destructure.groupedType));
                    }
                    groupedBindKind = destructure.groupedType;
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                groupedSliceWritable := if types.isSliceKind(groupedBindKind) {
                    destructureMutable or sliceBorrows.sliceExprIsMutable(rhs.textValue)
                } else {
                    destructureMutable
                };
                groupedBorrow := sliceBorrows.borrowTagForBinding(groupedBindKind, groupedSliceWritable, rhs.textValue);
                if not groupedBorrow.ok { syntax.failAt(source, destructureOpen, prefix, groupedBorrow.error); }
                bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                bindFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(groupedBindKind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                mut declaredInBlock.pushBack(bindName);
                mut blockLocals.pushBack((name = bindName, runtime = bindRuntime, kind = groupedBindKind,
                mutable = destructureMutable, writable = if types.isSliceKind(groupedBindKind) { groupedSliceWritable } else { false }, depth = blockLexDepth, constant = false, code = bindFnDeps,
                intValue = rhs.intValue, textValue = groupedBorrow.textValue, initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    declKw := if destructureMutable { "let " } else { "const " };
                    tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(groupedBindKind) { ": " + types.tsFunctionType(groupedBindKind) } else { "" };
                    groupedCode := ctx.assignValueCode(target, groupedBindKind, rhs.kind, rhs.code);
                    pushBlockDeclC(isTaggedBody, target, declKw, bindRuntime, groupedBindKind, tsTypeAnn, groupedCode, mut taggedPreDecls, mut statements, mut blockOwned);
                    mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, groupedBindKind, groupedCode) { bindRuntime } else { "" });
                    mut stmtDeps.pushBack(groupedCode);
                    trackedStmtCount = trackedStmtCount + 1;
                    statementCount = statementCount + 1;
                }
                blockConstant = false;
                cursor = statementNext;
            } else {
                tempPrefix := if destructure.shape == "record" { "lite$rec" } else if destructure.shape == "array" { "lite$arr" } else { "lite$tuple" };
                tempSlot := if destructure.shape == "record" { "$rec" } else if destructure.shape == "array" { "$arr" } else { "$tuple" };
                tempRuntime := ir.freshScopeTemp(blockLocals, tempPrefix);
                resolvedBindings := resolveAggregateBindings(target, destructure.shape, destructure.count, destructure.encodedClauses, rhs.kind, tempRuntime, source, destructureOpen, prefix);
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + destructure.shape + " destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                rhsProvKind := sliceBorrows.provenanceKind(rhs.textValue);
                isSplitTuple := (rhsProvKind == "mut_split" or rhsProvKind == "ro_split") and destructure.shape == "tuple" and destructure.count == 2;
                aggFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(rhs.kind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                mut blockLocals.pushBack((name = tempSlot, runtime = tempRuntime, kind = ir.VALUE_KIND_UNIT,
                mutable = false, writable = false, depth = blockLexDepth, constant = false, code = aggFnDeps,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    pushBlockDeclC(isTaggedBody, target, "const ", tempRuntime, rhs.kind, "", rhs.code, mut taggedPreDecls, mut statements, mut blockOwned);
                    mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, rhs.kind, rhs.code) { tempRuntime } else { "" });
                    mut stmtDeps.pushBack(rhs.code);
                    trackedStmtCount = trackedStmtCount + 1;
                }
                mut pendingDestrNames: List<String> = [];
                var bCursor := 0;
                var bIndex := 0;
                loop bIndex < destructure.count {
                    bindPart := types.decodeLengthPrefixedAt(resolvedBindings, bCursor);
                    propPart := types.decodeLengthPrefixedAt(resolvedBindings, bindPart.next);
                    srcPart := types.decodeLengthPrefixedAt(resolvedBindings, propPart.next);
                    tgtPart := types.decodeLengthPrefixedAt(resolvedBindings, srcPart.next);
                    bCursor = tgtPart.next;
                    bindName := bindPart.text;
                    propExpr := propPart.text;
                    srcKind := srcPart.text;
                    bindKind := tgtPart.text;
                    if not (destructure.shape == "record" and bindName == "_") {
                        ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                        if not pendingDestrNames.contains(bindName) {
                            mut pendingDestrNames.pushBack(bindName);
                        }
                        bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                        fieldCode := ctx.assignValueCode(target, bindKind, srcKind, propExpr);
                        fieldFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(bindKind) {
                            "|" + tempRuntime + "|\n|" + tempRuntime + "|"
                        } else {
                            ""
                        };
                        fieldWritable := if isSplitTuple { rhsProvKind == "mut_split" } else { false };
                        fieldText := if isSplitTuple { sliceBorrows.splitHalfProvenance(rhs.textValue, destructureOpen, bIndex == 0) } else { "" };
                        mut blockLocals.pushBack((name = bindName, runtime = bindRuntime, kind = bindKind,
                        mutable = destructureMutable, writable = fieldWritable, depth = blockLexDepth, constant = false, code = fieldFnDeps,
                        intValue = 0, textValue = fieldText, initState = ir.INIT_STATE_INIT));
                        if not blockExits {
                            declKw := if destructureMutable { "let " } else { "const " };
                            tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(bindKind) { ": " + types.tsFunctionType(bindKind) } else { "" };
                            pushBlockDeclC(isTaggedBody, target, declKw, bindRuntime, bindKind, tsTypeAnn, fieldCode, mut taggedPreDecls, mut statements, mut blockOwned);
                            mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, bindKind, fieldCode) { bindRuntime } else { "" });
                            mut stmtDeps.pushBack(fieldCode);
                            trackedStmtCount = trackedStmtCount + 1;
                        }
                    }
                    bIndex = bIndex + 1;
                }
                loop pendingDestrNames as destrName {
                    mut declaredInBlock.pushBack(destrName);
                }
                if not blockExits { statementCount = statementCount + 1; }
                blockConstant = false;
                cursor = statementNext;
            }
        } else if chAtCursor == "{" {
            braceEnd := syntax.scanBraceEnd(source, cursor, prefix);
            fullBraceEnd := if braceEnd >= 0 { syntax.scanTrailingFinallyEnd(source, braceEnd, prefix) } else { -1 };
            afterBrace := if fullBraceEnd >= 0 { syntax.skipItemSeparators(source, fullBraceEnd, prefix) } else { -1 };
            atTailBrace := (not isStmtBody) and afterBrace >= 0 and afterBrace < blockSourceSize and source.at(afterBrace) == "}";
            if not atTailBrace {
                isStatement = true;
                stmtBlock := parseBinaryCtx(target, source, cursor, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "stmt", blockAliases);
                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtBlock); }
                afterStmtBlock := syntax.skipTrivia(source, stmtBlock.next, prefix);
                if afterStmtBlock < blockSourceSize and source.wordAt(afterStmtBlock, "then") {
                    syntax.failAt(source, afterStmtBlock, prefix, "then requires an if, match, or loop");
                }
                var stmtEndPos := stmtBlock.next;
                if afterStmtBlock < blockSourceSize and source.wordAt(afterStmtBlock, "finally") {
                    stmtFin := parseFinallyClause(target, source, afterStmtBlock, prefix, blockLocals, functions, params, currentName, ctxs, bodyDepth, inferMode, blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtFin); }
                    if not blockExits {
                        if target == ir.TARGET_C {
                            fnIdxSF := ctx.findCtxByKindIndex(ctxs, "fn");
                            fnRetSF := if fnIdxSF >= 0 { ctxs[fnIdxSF].valKind } else { "" };
                            rewrittenSF := ctx.cRewriteFinallyExits(stmtBlock.code, stmtFin.code, fnRetSF, afterStmtBlock);
                            mut statements.pushBack("{ { " + rewrittenSF + " } { " + stmtFin.code + " } }");
                        } else {
                            mut statements.pushBack("try { " + stmtBlock.code + " } finally { " + stmtFin.code + " }");
                        }
                        if stmtBlock.kind == ir.VALUE_KIND_NEVER or stmtFin.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                        statementCount = statementCount + 1;
                    }
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtFin.code);
                    }
                    stmtEndPos = stmtFin.next;
                } else if not blockExits {
                    if stmtBlock.code =!= "" {
                        mut statements.pushBack("{ " + stmtBlock.code + " }");
                    }
                    if stmtBlock.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                    statementCount = statementCount + 1;
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                    }
                }
                blockConstant = false;
                stmtNext := syntax.consumeStatementEnd(source, stmtEndPos, prefix);
                cursor = if stmtNext >= 0 { stmtNext } else { stmtEndPos };
            }
        } else if chAtCursor == "#" {
            leadAttr := types.parseTypeLayoutAttrs(source, cursor, prefix);
            if not leadAttr.ok {
                syntax.failAt(source, leadAttr.errPos, prefix, leadAttr.errMsg);
            }
            syntax.failAt(source, cursor, prefix, "layout attributes go after record/enum (for example 'record #packed { ... }' or 'enum #no_niche { ... }')");
        } else if chAtCursor == "@" {
            tagPeek := syntax.parseTagAt(source, cursor, prefix);
            afterPeek := syntax.skipTrivia(source, tagPeek.next, prefix);
            if afterPeek >= blockSourceSize or (source.at(afterPeek) =!= "{" and source.at(afterPeek) =!= "." and
            not source.wordAt(afterPeek, "do") and not source.wordAt(afterPeek, "if") and
            not source.wordAt(afterPeek, "match") and not source.wordAt(afterPeek, "loop")) {
                if tagPeek.tag == "packed" or tagPeek.tag == "align" or tagPeek.tag == "no_niche" {
                    syntax.failAt(source, cursor, prefix, "leading @" + tagPeek.tag + " is no longer supported; write 'record #" + tagPeek.tag + " { ... }' or 'enum #" + tagPeek.tag + " { ... }' instead");
                }
                syntax.failAt(source, afterPeek, prefix, "expected {, do, if, match, loop or . after block tag @" + tagPeek.tag);
            }
        } else if chAtCursor.isNameStart() or (chAtCursor == "." and blockSourceSize > cursor + 1 and source.wordAt(syntax.skipTrivia(source, cursor + 1, prefix), "item")) {
            var isDotItemStmt := false;
            var dotItemStart := cursor;
            if chAtCursor == "." {
                dotItemStart = syntax.skipTrivia(source, cursor + 1, prefix);
                dotAfter := syntax.skipTrivia(source, dotItemStart + 4, prefix);
                if syntax.isSingleEquals(source, dotAfter) or syntax.compoundAssignOp(source, dotAfter).width > 0 {
                    isDotItemStmt = true;
                } else if dotAfter < blockSourceSize and source.at(dotAfter) == "[" {
                    dotBrkEnd := syntax.scanBracketEnd(source, dotAfter, prefix);
                    if dotBrkEnd >= 0 {
                        dotAfterBrk := syntax.skipTrivia(source, dotBrkEnd, prefix);
                        if syntax.isSingleEquals(source, dotAfterBrk) or syntax.compoundAssignOp(source, dotAfterBrk).width > 0 {
                            isDotItemStmt = true;
                        }
                    }
                } else if dotAfter < blockSourceSize and source.at(dotAfter) == "." {
                    var scanDot := dotAfter;
                    var dotDepth := 0;
                    loop scanDot < blockSourceSize and source.at(scanDot) == "." and dotDepth < 2 {
                        dfStart := syntax.skipTrivia(source, scanDot + 1, prefix);
                        if dfStart >= blockSourceSize or not source.at(dfStart).isNameStart() { break; }
                        dfEnd := source.skipName(dfStart);
                        scanDot = syntax.skipTrivia(source, dfEnd, prefix);
                        dotDepth += 1;
                    }
                    if dotDepth >= 1 and scanDot < blockSourceSize and (syntax.isSingleEquals(source, scanDot) or syntax.compoundAssignOp(source, scanDot).width > 0) {
                        isDotItemStmt = true;
                    }
                }
            }
            if chAtCursor == "." and not isDotItemStmt {
                /* Fall through to expression/tail parser below for `.item`, `.item.x`, `.item.method()`, etc. */
            } else {
                itemStart := cursor;
                itemEnd := if isDotItemStmt { dotItemStart + 4 } else { source.skipName(itemStart) };
                itemName := if isDotItemStmt { ".item" } else { source.slice(itemStart, itemEnd) };
                afterItemName := syntax.skipTrivia(source, itemEnd, prefix);
                var blockOutputName := "";
                var blockOutputOpen := afterItemName;
                blockModIdx := if isDotItemStmt { -1 } else { sym.localIndex(blockLocals, itemName) };
                if blockModIdx >= 0 and blockLocals[blockModIdx].kind == ir.VALUE_KIND_MODULE and
                afterItemName < blockSourceSize and source.at(afterItemName) == "." {
                    memberStart := syntax.skipTrivia(source, afterItemName + 1, prefix);
                    memberEnd := source.skipName(memberStart);
                    if memberEnd > memberStart {
                        fnIdx := sym.findFunction(functions, itemName + "." + source.slice(memberStart, memberEnd));
                        if fnIdx >= 0 {
                            blockOutputName = builtinsAbi.coreOutputName(functions[fnIdx].runtime);
                            blockOutputOpen = syntax.skipTrivia(source, memberEnd, prefix);
                        }
                    }
                }
                if blockOutputName =!= "" {
                    isStatement = true;
                    if not allowOutput {
                        syntax.failAt(source, itemStart, prefix, "host output functions are standalone statements");
                    }
                    var outPos := syntax.expectSymbol(source, blockOutputOpen, "(", prefix);
                    outPos = syntax.skipTrivia(source, outPos, prefix);
                    mut outParts: List<String> = [];
                    var outArgCount := 0;
                    var outDiverged := false;
                    loop outPos < blockSourceSize and source.at(outPos) =!= ")" {
                        outArgStart := outPos;
                        outArg := parseBinaryCtx(target, source, outPos, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, outArg); }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, outArgStart, prefix, outArg.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, outArg.code);
                        }
                        if types.containsFnKind(outArg.kind) {
                            syntax.failAt(source, outArgStart, prefix, "cannot output function value");
                        }
                        if not outDiverged {
                            if outArg.kind == ir.VALUE_KIND_NEVER {
                                if not blockExits {
                                    mut statements.pushBack(stmtReturnPrefix + "(" + outArg.code + ");");
                                    blockExits = true;
                                }
                                outDiverged = true;
                            } else if target == ir.TARGET_C {
                                baseOutKind := types.distinctBaseKind(outArg.kind);
                                cPr := if baseOutKind == ir.VALUE_KIND_UNIT {
                                    if outArg.code == "0" { "printf(\"Unit\");" } else { "((void)(" + outArg.code + "), printf(\"Unit\"));" }
                                } else if types.isEnumKind(baseOutKind) and not types.isPayloadEnumKind(baseOutKind) {
                                    dName := types.enumDisplayName(baseOutKind);
                                    cCount := types.enumCaseCount(baseOutKind);
                                    mut enumLabels: List<String> = [];
                                    var eci := 0;
                                    loop eci < cCount {
                                        mut enumLabels.pushBack(cLiteral.textLiteralCode(dName + "." + types.enumCaseAt(baseOutKind, eci).name));
                                        eci = eci + 1;
                                    }
                                    "printf(\"%s\", ((const char *const[]){" + enumLabels.join(", ") + "}[" + outArg.code + "]));"
                                } else if baseOutKind == ir.VALUE_KIND_BOOL {
                                    "printf(\"%s\", (" + outArg.code + ") ? \"true\" : \"false\");"
                                } else if baseOutKind == ir.VALUE_KIND_STRING {
                                    "lt_print_str(" + outArg.code + ");"
                                } else if numeric.isUnsignedIntKind(baseOutKind) {
                                    "printf(\"%\" PRIu64, (uint64_t)(" + outArg.code + "));"
                                } else if numeric.isIntKind(baseOutKind) {
                                    "printf(\"%\" PRId64, (int64_t)(" + outArg.code + "));"
                                } else if numeric.isFloatKind(baseOutKind) {
                                    "/*@P:" + baseOutKind + "@*/lt_print_float(" + ir.targetFloatOperandCode(target, baseOutKind, outArg.code) + ");"
                                } else if types.isArrayKind(baseOutKind) and types.cArrayTag(baseOutKind) =!= "" {
                                    "/*@P:" + baseOutKind + "@*/" + types.cArrayTag(baseOutKind) + "_print(" + outArg.code + ");"
                                } else if types.isListKind(baseOutKind) or types.isArrayKind(baseOutKind) {
                                    elK := if types.isListKind(baseOutKind) { types.listElementKind(baseOutKind) } else { types.arrayElementKind(baseOutKind) };
                                    ob := cBorrowExprWithPostDrop(baseOutKind, outArg.code, false);
                                    pCall := "/*@P:" + baseOutKind + "@*/lt_list_" + types.cListTag(elK) + "_print(" + ob.expr + ");";
                                    if ob.drop =!= "" { pCall + " " + ob.drop + ";" } else { pCall }
                                } else if types.isMapKind(baseOutKind) {
                                    ob := cBorrowExprWithPostDrop(baseOutKind, outArg.code, false);
                                    pCall := "/*@P:" + baseOutKind + "@*/" + types.cMapTag(baseOutKind) + "_print(" + ob.expr + ");";
                                    if ob.drop =!= "" { pCall + " " + ob.drop + ";" } else { pCall }
                                } else if types.isSetKind(baseOutKind) {
                                    ob := cBorrowExprWithPostDrop(baseOutKind, outArg.code, false);
                                    pCall := "/*@P:" + baseOutKind + "@*/" + types.cSetTag(baseOutKind) + "_print(" + ob.expr + ");";
                                    if ob.drop =!= "" { pCall + " " + ob.drop + ";" } else { pCall }
                                } else if types.cStructTag(baseOutKind) =!= "" {
                                    ob := cBorrowExprWithPostDrop(baseOutKind, outArg.code, false);
                                    pCall := "/*@P:" + baseOutKind + "@*/" + types.cStructTag(baseOutKind) + "_print(" + ob.expr + ");";
                                    if ob.drop =!= "" { pCall + " " + ob.drop + ";" } else { pCall }
                                } else {
                                    "printf(\"%\" PRId64, (int64_t)(" + outArg.code + "));"
                                };
                                mut outParts.pushBack(cPr);
                            } else {
                                mut outParts.pushBack(types.tsDisplayValueCode(outArg.kind, outArg.code));
                            }
                        }
                        outArgCount = outArgCount + 1;
                        outPos = syntax.skipTrivia(source, outArg.next, prefix);
                        if outPos < blockSourceSize and source.at(outPos) == "," {
                            outPos = syntax.skipTrivia(source, outPos + 1, prefix);
                        } else {
                            break;
                        }
                    }
                    outPos = syntax.expectSymbol(source, outPos, ")", prefix);
                    stmtNext := syntax.consumeStatementEnd(source, outPos, prefix);
                    if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, outPos, prefix), prefix, "expected ; after " + blockOutputName); }
                    if not outDiverged and not blockExits {
                        if target == ir.TARGET_C {
                            cOutBody := outParts.join(" printf(\" \"); ");
                            cNewline := if blockOutputName == "outputLine" { " printf(\"\\n\");" } else { "" };
                            mut statements.pushBack("{ " + cOutBody + cNewline + " }");
                        } else {
                            lineCode := if outArgCount == 0 {
                                tsLiteral.textLiteralCode(if blockOutputName == "outputLine" { "\n" } else { "" })
                            } else {
                                joinedArgs := outParts.join(" + \" \" + ");
                                ending := if blockOutputName == "outputLine" { " + \"\\n\"" } else { "" };
                                if ending =!= "" { "(" + joinedArgs + ")" + ending } else { joinedArgs }
                            };
                            mut statements.pushBack("lite$emit(" + lineCode + ");");
                        }
                    }
                    if not blockExits or outDiverged { statementCount = statementCount + 1; }
                    blockConstant = false;
                    cursor = stmtNext;
                } else if itemName == "return" {
                    isStatement = true;
                    var hasTargetTag := false;
                    var targetTagName := "";
                    var targetTagPos := afterItemName;
                    var retValStart := afterItemName;
                    if afterItemName < blockSourceSize and source.at(afterItemName) == "@" {
                        retTag := syntax.parseTagAt(source, afterItemName, prefix);
                        afterRetTag := syntax.skipTrivia(source, retTag.next, prefix);
                        if afterRetTag >= blockSourceSize or source.at(afterRetTag) =!= "." {
                            hasTargetTag = true;
                            targetTagName = retTag.tag;
                            retValStart = afterRetTag;
                        }
                    }
                    if hasTargetTag {
                        targetIdx := ctx.findTaggedCtxIndex(ctxs, targetTagName);
                        if targetIdx < 0 {
                            syntax.failAt(source, targetTagPos, prefix, "unknown block tag @" + targetTagName);
                        }
                        targetCtx := ctxs[targetIdx];
                        if targetCtx.phase == ir.CTX_PHASE_THEN {
                            syntax.failAt(source, itemStart, prefix, "cannot return to @" + targetCtx.tag + " from inside its own then block");
                        }
                        if ctx.hasFinallyAbove(ctxs, targetIdx) {
                            syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                        }
                        isInferTarget := isInferPlaceholderKind(targetCtx.valKind);
                        if retValStart >= blockSourceSize or source.at(retValStart) == ";" or source.at(retValStart) == "}" {
                            if not isInferTarget and targetCtx.valKind =!= ir.VALUE_KIND_UNIT {
                                syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns " +
                                types.displayKind(targetCtx.valKind) + " and cannot return Unit");
                            }
                            stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                            if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                            if inferMode {
                                blockMarkers = blockMarkers + targetCtx.id.toText() + "=Unit\n";
                            }
                            if not blockExits {
                                if target == ir.TARGET_C {
                                    mut statements.pushBack("goto " + targetCtx.label + ";");
                                } else if targetCtx.iifeDepth == bodyDepth {
                                    mut statements.pushBack("break " + targetCtx.label + ";");
                                } else {
                                    mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + targetCtx.id.toText() + ", undefined);");
                                }
                                blockExits = true;
                            }
                            statementCount = statementCount + 1;
                            blockConstant = false;
                            cursor = stmtNext;
                        } else {
                            retExpected := inferHintKind(targetCtx.valKind);
                            rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, retExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                            if target == ir.TARGET_TS and not inferMode and not blockExits {
                                trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                                if types.containsFnKind(rhs.kind) {
                                    tagExitDepth := trace.parseLexDepthTag(targetCtx.iterLabel, blockLexDepth);
                                    trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, tagExitDepth, blockLocals);
                                }
                            }
                            stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                            if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                            if not isInferTarget {
                                if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                    if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                        syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns Unit and cannot return a value");
                                    }
                                } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(targetCtx.valKind, rhs.kind) {
                                    syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                                    " from block @" + targetCtx.tag + " returning " + types.displayKind(targetCtx.valKind));
                                }
                            }
                            if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
                                blockMarkers = blockMarkers + targetCtx.id.toText() + "=" + rhs.kind + "\n";
                            }
                            if not blockExits {
                                if rhs.kind == ir.VALUE_KIND_NEVER {
                                    mut statements.pushBack(stmtReturnPrefix + "(" + rhs.code + ");");
                                } else {
                                    retValCode := if isInferTarget { rhs.code }
                                    else if targetCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                                    else { ctx.assignValueCode(target, targetCtx.valKind, rhs.kind, rhs.code) };
                                    if target == ir.TARGET_C {
                                        if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                            mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, retValCode) + " goto " + targetCtx.label + ";");
                                        } else {
                                            mut statements.pushBack(ctx.cUnwrapIntoVar(targetCtx.valVar, targetCtx.valKind, retValCode) + " goto " + targetCtx.label + ";");
                                        }
                                    } else if targetCtx.iifeDepth == bodyDepth {
                                        if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                            mut statements.pushBack("void (" + retValCode + "); break " + targetCtx.label + ";");
                                        } else {
                                            mut statements.pushBack(targetCtx.valVar + " = " + retValCode + "; break " + targetCtx.label + ";");
                                        }
                                    } else {
                                        mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + targetCtx.id.toText() + ", " + retValCode + ");");
                                    }
                                }
                                blockExits = true;
                            }
                            statementCount = statementCount + 1;
                            blockConstant = false;
                            cursor = stmtNext;
                        }
                    } else {
                        fnIdx := ctx.findCtxByKindIndex(ctxs, "fn");
                        if fnIdx < 0 {
                            if ctx.hasFinallyAbove(ctxs, -1) {
                                syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                            }
                            syntax.failAt(source, itemStart, prefix, "return outside a function");
                        }
                        if ctx.hasFinallyAbove(ctxs, fnIdx) {
                            syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                        }
                        fnCtx := ctxs[fnIdx];
                        fnResult := fnCtx.valKind;
                        if retValStart >= blockSourceSize or source.at(retValStart) == ";" or source.at(retValStart) == "}" {
                            isUnitResRet := types.isResultKind(fnResult) and types.resultOkKind(fnResult) == ir.VALUE_KIND_UNIT;
                            if fnResult =!= ir.VALUE_KIND_UNIT and not isUnitResRet {
                                syntax.failAt(source, itemStart, prefix, "function " + currentName + " must return " + types.displayKind(fnResult));
                            }
                            stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                            if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                            if not blockExits {
                                if isUnitResRet {
                                    okRetCode := emitResultVariantExpr(target, fnResult, false, ir.VALUE_KIND_UNIT, "");
                                    if fnCtx.iifeDepth == bodyDepth or target == ir.TARGET_C {
                                        mut statements.pushBack("return " + okRetCode + ";");
                                    } else {
                                        mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(0, " + okRetCode + ");");
                                    }
                                } else if fnCtx.iifeDepth == bodyDepth or target == ir.TARGET_C {
                                    mut statements.pushBack("return;");
                                } else {
                                    mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(0, undefined);");
                                }
                                blockExits = true;
                            }
                            statementCount = statementCount + 1;
                            blockConstant = false;
                            cursor = stmtNext;
                        } else {
                            if fnResult == ir.VALUE_KIND_UNIT {
                                syntax.failAt(source, itemStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
                            }
                            rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, fnResult, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                            if not types.isCompatibleKind(fnResult, rhs.kind) {
                                syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                                " from function " + currentName + " returning " + types.displayKind(fnResult));
                            }
                            if target == ir.TARGET_TS and not inferMode and not blockExits {
                                trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                                if types.containsFnKind(rhs.kind) {
                                    fnExitDepth := trace.parseLexDepthTag(fnCtx.iterLabel, 1);
                                    trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, fnExitDepth, blockLocals);
                                }
                            }
                            stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                            if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                            if not blockExits {
                                retValCode := ctx.assignValueCode(target, fnResult, rhs.kind, rhs.code);
                                if rhs.kind == ir.VALUE_KIND_NEVER {
                                    if target == ir.TARGET_C {
                                        mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, retValCode));
                                    } else {
                                        mut statements.pushBack(stmtReturnPrefix + "(" + retValCode + ");");
                                    }
                                } else if target == ir.TARGET_C {
                                    if retValCode.startsWithAt(0, "/*@CBLK:") {
                                        endHdrR := retValCode.indexOf("@*/", 8);
                                        retVarR := retValCode.slice(8, endHdrR);
                                        blkBodyR := retValCode.slice(endHdrR + 3, retValCode.length());
                                        if retVarR == "0" {
                                            mut statements.pushBack("{ " + blkBodyR + " }");
                                        } else {
                                            mut statements.pushBack("{ " + types.cValueType(fnResult) + " lt_ret; " + blkBodyR + " lt_ret = " + retVarR + "; return lt_ret; }");
                                        }
                                    } else {
                                        mut statements.pushBack("return " + retValCode + ";");
                                    }
                                } else if fnCtx.iifeDepth == bodyDepth {
                                    mut statements.pushBack("return " + retValCode + ";");
                                } else {
                                    mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(0, " + retValCode + ");");
                                }
                                blockExits = true;
                            }
                            statementCount = statementCount + 1;
                            blockConstant = false;
                            cursor = stmtNext;
                        }
                    }
                } else if itemName == "break" or itemName == "continue" {
                    isStatement = true;
                    var targetLoopIdx := -1;
                    var afterExit := afterItemName;
                    if afterItemName < blockSourceSize and source.at(afterItemName) == "@" {
                        exitTag := syntax.parseTagAt(source, afterItemName, prefix);
                        afterDotCheck := syntax.skipTrivia(source, exitTag.next, prefix);
                        if afterDotCheck < blockSourceSize and source.at(afterDotCheck) == "." {
                            syntax.failAt(source, afterDotCheck, prefix, itemName + " @" + exitTag.tag + " followed by . is ambiguous; wrap the payload in parentheses");
                        }
                        foundIdx := ctx.findTaggedCtxIndex(ctxs, exitTag.tag);
                        if foundIdx < 0 {
                            syntax.failAt(source, afterItemName, prefix, "unknown block tag @" + exitTag.tag);
                        }
                        if ctxs[foundIdx].kind =!= ir.CTX_KIND_LOOP {
                            syntax.failAt(source, afterItemName, prefix, itemName + " @" + exitTag.tag + " requires an enclosing loop");
                        }
                        if ctxs[foundIdx].phase == ir.CTX_PHASE_THEN {
                            syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " @" + exitTag.tag + " from inside its own then block");
                        }
                        targetLoopIdx = foundIdx;
                        afterExit = afterDotCheck;
                    } else {
                        targetLoopIdx = ctx.findActiveLoopCtxIndex(ctxs);
                        if targetLoopIdx < 0 {
                            if ctx.hasFinallyAbove(ctxs, -1) {
                                syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                            }
                            syntax.failAt(source, itemStart, prefix, itemName + " outside loop");
                        }
                    }
                    if ctx.hasFinallyAbove(ctxs, targetLoopIdx) {
                        syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                    }
                    loopCtx := ctxs[targetLoopIdx];
                    if loopCtx.phase == ir.CTX_PHASE_HEADER {
                        syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " from loop header");
                    }
                    hasPayload := afterExit < blockSourceSize and source.at(afterExit) =!= ";" and source.at(afterExit) =!= "}";
                    var exitNext := afterExit;
                    if not hasPayload {
                        stmtNext := syntax.consumeStatementEnd(source, afterExit, prefix);
                        if stmtNext < 0 { syntax.failAt(source, afterExit, prefix, "expected ; after " + itemName); }
                        exitNext = stmtNext;
                        if inferMode and itemName == "break" and not blockExits {
                            blockMarkers = blockMarkers + loopCtx.id.toText() + "=@break\n";
                        }
                        if not blockExits {
                            if target == ir.TARGET_C {
                                if loopCtx.id > 0 and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                    cLbl := if itemName == "break" { "lt_brk_" + loopCtx.id.toText() } else { "lt_cont_" + loopCtx.id.toText() };
                                    mut statements.pushBack("goto " + cLbl + ";");
                                } else {
                                    mut statements.pushBack(itemName + ";");
                                }
                            } else if loopCtx.iifeDepth == bodyDepth {
                                if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                    mut statements.pushBack(itemName + " " + loopCtx.label + ";");
                                } else {
                                    mut statements.pushBack(itemName + ";");
                                }
                            } else {
                                transferId := if loopCtx.valVar =!= "" {
                                    if itemName == "break" { 1000000 + loopCtx.id } else { 0 - 1000000 - loopCtx.id }
                                } else {
                                    if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id }
                                };
                                mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + transferId.toText() + ", undefined);");
                            }
                            blockExits = true;
                        }
                    } else {
                        isInferLoop := isInferPlaceholderKind(loopCtx.valKind);
                        payExpected := inferHintKind(loopCtx.valKind);
                        rhs := parseBinaryCtx(target, source, afterExit, prefix, blockLocals, functions, params, currentName, payExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, afterExit, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            if types.containsFnKind(rhs.kind) {
                                loopExitDepth := trace.parseLexDepthTag(loopCtx.iterLabel, blockLexDepth);
                                trace.checkEscapingFnSafety(source, afterExit, prefix, rhs.code, loopExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + itemName); }
                        exitNext = stmtNext;
                        if not isInferLoop {
                            if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                    syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) + " to Unit loop .value");
                                }
                            } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(loopCtx.valKind, rhs.kind) {
                                syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) +
                                " to loop .value of kind " + types.displayKind(loopCtx.valKind));
                            }
                        }
                        if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
                            blockMarkers = blockMarkers + loopCtx.id.toText() + "=" + rhs.kind + "\n";
                        }
                        if not blockExits {
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                mut statements.pushBack(stmtReturnPrefix + "(" + rhs.code + ");");
                            } else {
                                payCode := if isInferLoop { rhs.code }
                                else if loopCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                                else { ctx.assignValueCode(target, loopCtx.valKind, rhs.kind, rhs.code) };
                                if target == ir.TARGET_C {
                                    cJump := if loopCtx.id > 0 {
                                        "goto " + (if itemName == "break" { "lt_brk_" } else { "lt_cont_" }) + loopCtx.id.toText() + ";"
                                    } else {
                                        itemName + ";"
                                    };
                                    if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                                        mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, payCode) + " " + cJump);
                                    } else if loopCtx.colVar =!= "" {
                                        colTagPay := types.cListTag(loopCtx.valKind);
                                        mut statements.pushBack(ctx.cUnwrapIntoVar(loopCtx.valVar, loopCtx.valKind, payCode) + " lt_list_" + colTagPay + "_push_back(&" + loopCtx.colVar + ", " + loopCtx.valVar + "); " + cJump);
                                    } else {
                                        mut statements.pushBack(ctx.cUnwrapIntoVar(loopCtx.valVar, loopCtx.valKind, payCode) + " " + cJump);
                                    }
                                } else if loopCtx.iifeDepth == bodyDepth {
                                    jumpStmt := if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                        itemName + " " + loopCtx.label + ";"
                                    } else {
                                        itemName + ";"
                                    };
                                    if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                                        mut statements.pushBack("void (" + payCode + "); " + jumpStmt);
                                    } else if loopCtx.colVar =!= "" {
                                        mut statements.pushBack(loopCtx.valVar + " = " + payCode + "; " + loopCtx.colVar + ".push(" + loopCtx.valVar + "); " + jumpStmt);
                                    } else {
                                        mut statements.pushBack(loopCtx.valVar + " = " + payCode + "; " + jumpStmt);
                                    }
                                } else {
                                    payTransferId := if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id };
                                    mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + payTransferId.toText() + ", " + payCode + ");");
                                }
                            }
                            blockExits = true;
                        }
                    }
                    statementCount = statementCount + 1;
                    blockConstant = false;
                    cursor = exitNext;
                } else if itemName == "else" {
                    syntax.failAt(source, itemStart, prefix, "unexpected else");
                } else if itemName == "if" {
                    rawStmtIfEnd := syntax.scanRawIfChainEnd(source, itemStart, prefix, true);
                    afterRawStmtIf := if rawStmtIfEnd >= 0 { syntax.skipTrivia(source, rawStmtIfEnd, prefix) } else { -1 };
                    stmtIfHasThen := afterRawStmtIf >= 0 and (source.wordAt(afterRawStmtIf, "then") or source.wordAt(afterRawStmtIf, "finally"));
                    afterRawIfTailCheck := if rawStmtIfEnd >= 0 { syntax.skipItemSeparators(source, rawStmtIfEnd, prefix) } else { -1 };
                    isLoopTailPatternIf := isLoopBody and afterRawIfTailCheck >= 0 and afterRawIfTailCheck < blockSourceSize and source.at(afterRawIfTailCheck) == "}";
                    var useValueIf := stmtIfHasThen or (syntax.ifChainHasPattern(source, itemStart, prefix) and not isLoopTailPatternIf);
                    if (not isStmtBody) and not useValueIf and not (isLoopBody and syntax.ifChainIsPartialOrReserved(source, itemStart, prefix)) {
                        valIfEnd := syntax.scanValueIfEnd(source, itemStart, prefix, false);
                        if valIfEnd >= 0 {
                            afterValIf := syntax.skipItemSeparators(source, valIfEnd, prefix);
                            if afterValIf < blockSourceSize and source.at(afterValIf) == "}" {
                                useValueIf = true;
                            }
                        }
                    }
                    if not useValueIf {
                        isStatement = true;
                        afterRawIfTail := if rawStmtIfEnd >= 0 { syntax.skipItemSeparators(source, rawStmtIfEnd, prefix) } else { -1 };
                        isLoopTailPartialIf := isLoopBody and afterRawIfTail >= 0 and afterRawIfTail < blockSourceSize and source.at(afterRawIfTail) == "}";
                        ifBranchSink := if isLoopTailPartialIf { "loopBody" } else { "stmt" };
                        ifBranchExpected := if isLoopTailPartialIf { expected } else { "" };
                        mut ifPartsBuf: tb.TextBuilder;
                        var allBranchesExit := true;
                        var hasElseBranch := false;
                        var ifCursor := afterItemName;
                        var isFirstIf := true;
                        var brIdxLoop := 0;
                        var ifCondCount := 0;
                        var firstIfPredRt := "";
                        var firstIfPredNeg := false;
                        var cumIfFalseFacts := "";
                        var ifB1Live := false;
                        var ifB2Live := false;
                        var ifLiveBranches := 0;
                        var mut ifStmtUpdates: List<ir.BranchUpdate> = [];
                        var stmtIfCurLocals := blockLocals;
                        ifBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_IF, phase = ir.CTX_PHASE_BODY,
                        iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
                        countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
                        var patChainFlagVar := "";
                        var isPatLoopChain := syntax.ifChainHasPattern(source, itemStart, prefix);
                        if isPatLoopChain {
                            patFlagId := ctx.nextCtxId(ctxs) + itemStart;
                            patChainFlagVar = if target == ir.TARGET_C { "lt_ifm_" + patFlagId.toText() } else { "lite$ifm" + patFlagId.toText() };
                            mut ifPartsBuf.append(if target == ir.TARGET_C { "bool " + patChainFlagVar + " = false; (void)" + patChainFlagVar + "; " } else { "let " + patChainFlagVar + ": boolean = false; void " + patChainFlagVar + "; " });
                        }
                        loop true {
                            syntax.rejectHeaderBlockTag(source, ifCursor, prefix, if isFirstIf { "if" } else { "else if" });
                            if isPatLoopChain {
                                fnCtxIdxLP := if target == ir.TARGET_C { ctx.findCtxByKindIndex(ctxs, "fn") } else { -1 };
                                fnRetKLP := if fnCtxIdxLP >= 0 { ctxs[fnCtxIdxLP].valKind } else { "" };
                                patBr := parseIfPatternBranch(target, source, ifCursor, itemStart, brIdxLoop, prefix, blockLocals, functions, params, currentName, ifBranchExpected, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, patBr.branch); blockMarkers = blockMarkers + patBr.markers; }
                                if patBr.branch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                                wrappedBr := wrapPatternIfClauses(target, patBr.clauses, patChainFlagVar + " = true; " + patBr.branch.code, fnRetKLP, ifCursor);
                                if brIdxLoop == 0 {
                                    mut ifPartsBuf.append(wrappedBr);
                                } else {
                                    mut ifPartsBuf.append(" if (!" + patChainFlagVar + ") " + wrappedBr);
                                }
                                ifCursor = patBr.next;
                                brIdxLoop = brIdxLoop + 1;
                                isFirstIf = false;
                                afterBranch := syntax.skipTrivia(source, ifCursor, prefix);
                                if afterBranch < blockSourceSize and source.wordAt(afterBranch, "else") {
                                    afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                                    syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                                    if afterElse < blockSourceSize and source.wordAt(afterElse, "if") {
                                        ifCursor = syntax.skipTrivia(source, afterElse + 2, prefix);
                                    } else {
                                        hasElseBranch = true;
                                        elseOpen := syntax.expectSymbol(source, afterElse, "{", prefix);
                                        elseBranch := parseBinaryCtx(target, source, elseOpen - 1, prefix, blockLocals, functions, params, currentName, ifBranchExpected, 0, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, elseBranch); }
                                        if elseBranch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                                        mut ifPartsBuf.append(" if (!" + patChainFlagVar + ") { ");
                                        mut ifPartsBuf.append(elseBranch.code);
                                        mut ifPartsBuf.append(" }");
                                        ifCursor = elseBranch.next;
                                        break;
                                    }
                                } else {
                                    break;
                                }
                                continue;
                            }
                            condParsed := parseBinaryCtx(target, source, ifCursor, prefix, stmtIfCurLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "", blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, condParsed); }
                            if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                                syntax.failAt(source, ifCursor, prefix, if isFirstIf { "if condition must be Bool" } else { "else if condition must be Bool" });
                            }
                            if target == ir.TARGET_TS and not inferMode and not blockExits {
                                trace.checkTraceSafety(source, ifCursor, prefix, condParsed.code, currentName, -1, stmtIfCurLocals, functions, emptyFuturesHere, emptyItemsHere);
                            }
                            condCode := if condParsed.constant {
                                litB := ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0);
                                if target == ir.TARGET_C { litB } else { "Boolean(" + litB + ")" }
                            } else {
                                condParsed.code
                            };
                            beforeOpen := syntax.skipTrivia(source, condParsed.next, prefix);
                            syntax.rejectMisplacedTag(source, beforeOpen, prefix, if isFirstIf { "block tag cannot appear before { in if" } else { "block tag cannot appear before { in else if" });
                            openPos := syntax.expectSymbol(source, beforeOpen, "{", prefix);
                            if isFirstIf {
                                /* Track immutable Bool predicate and outer-local branch updates inside blocks. */
                            }
                            predIfHere := if isFirstIf { extractImmBoolPredicate(source, ifCursor, condParsed.next, prefix, stmtIfCurLocals) } else { (rt = "", negated = false) };
                            brLocMark := sym.localMark();
                            brInLocals := narrowLocalsForBranch(target, stmtIfCurLocals, if isFirstIf { predIfHere.rt } else { "" }, not predIfHere.negated, condParsed.textValue, true);
                            cumIfFalseFacts = mergeUnionFacts(cumIfFalseFacts, extractFalseNarrowFacts(condParsed.textValue));
                            stmtIfCurLocals = applyUnionNarrowing(target, blockLocals, cumIfFalseFacts);
                            if isLoopTailPartialIf and syntax.isReservedBranchBlock(source, openPos - 1, prefix) >= 0 {
                                resBrEnd := syntax.isReservedBranchBlock(source, openPos - 1, prefix);
                                prefixKw := if isFirstIf { "if (" } else { " else if (" };
                                mut ifPartsBuf.append(prefixKw);
                                mut ifPartsBuf.append(condCode);
                                mut ifPartsBuf.append(") { }");
                                ifCursor = resBrEnd;
                                allBranchesExit = false;
                                if isFirstIf {
                                    firstIfPredRt = predIfHere.rt;
                                    firstIfPredNeg = predIfHere.negated;
                                    ifB1Live = true;
                                    ifLiveBranches = ifLiveBranches + 1;
                                } else {
                                    ifLiveBranches = ifLiveBranches + 1;
                                }
                                ifCondCount = ifCondCount + 1;
                            } else {
                                contexts.clearLastBranchInitRows();
                                branch := parseBinaryCtx(target, source, openPos - 1, prefix, brInLocals, functions, params, currentName, ifBranchExpected, 0, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, branch); }
                                if branch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                                ifCondCount = ifCondCount + 1;
                                if isFirstIf {
                                    firstIfPredRt = predIfHere.rt;
                                    firstIfPredNeg = predIfHere.negated;
                                    ifB1Live = branch.kind =!= ir.VALUE_KIND_NEVER;
                                }
                                if branch.kind =!= ir.VALUE_KIND_NEVER {
                                    ifStmtUpdates = collectBlockExitBranchUpdates(1, if isFirstIf { 1 } else { 0 }, ifStmtUpdates);
                                    ifLiveBranches = ifLiveBranches + 1;
                                } else {
                                    contexts.clearLastBranchInitRows();
                                }
                                sym.rewindLocalsTo(brLocMark);
                                prefixKw := if isFirstIf { "if (" } else { " else if (" };
                                mut ifPartsBuf.append(prefixKw);
                                mut ifPartsBuf.append(condCode);
                                mut ifPartsBuf.append(") { ");
                                mut ifPartsBuf.append(branch.code);
                                mut ifPartsBuf.append(" }");
                                ifCursor = branch.next;
                            }
                            isFirstIf = false;
                            afterBranch := syntax.skipTrivia(source, ifCursor, prefix);
                            if afterBranch < blockSourceSize and source.wordAt(afterBranch, "else") {
                                afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                                syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                                if afterElse < blockSourceSize and source.wordAt(afterElse, "if") {
                                    ifCursor = syntax.skipTrivia(source, afterElse + 2, prefix);
                                } else {
                                    hasElseBranch = true;
                                    elseOpen := syntax.expectSymbol(source, afterElse, "{", prefix);
                                    if isLoopTailPartialIf and syntax.isReservedBranchBlock(source, elseOpen - 1, prefix) >= 0 {
                                        elseResEnd := syntax.isReservedBranchBlock(source, elseOpen - 1, prefix);
                                        allBranchesExit = false;
                                        ifCondCount = 2;
                                        if elseResEnd >= 0 { ifB2Live = true; ifLiveBranches = ifLiveBranches + 1; }
                                        ifCursor = elseResEnd;
                                        break;
                                    }
                                    elseLocMark := sym.localMark();
