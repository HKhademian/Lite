                        colSliceCode := emitSoaColumnSliceCode(target, left.kind, left.code, col.idx, col.prop, col.kind);
                        colProv := sliceBorrows.makeColumnSliceProvenance("ro_slice", rEntry.runtime, rEntry.depth, rEntry.name, rEntry.textValue, label);
                        left = ctx.withMarkers((kind = "Slice<" + col.kind + ">", code = colSliceCode, intValue = 0, textValue = colProv, constant = false, next = labelEnd),
