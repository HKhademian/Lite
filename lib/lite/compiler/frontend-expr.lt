                    rVar := freshCOwnedTemp("lt_lr_");
                    resVar := freshCOwnedTemp("lt_lb_");
                    lInit := ctx.cUnwrapIntoVar(lVar, ir.VALUE_KIND_BOOL, left.code);
                    rInit := ctx.cUnwrapIntoVar(rVar, ir.VALUE_KIND_BOOL, right.code);
                    if operator.text == "and" {
                        "/*@CBLK:" + resVar + "@*/bool " + resVar + "; { bool " + lVar + "; " + lInit + " if (" + lVar + ") { bool " + rVar + "; " + rInit + " " + resVar + " = " + rVar + "; } else { " + resVar + " = false; } }"
                    } else {
                        "/*@CBLK:" + resVar + "@*/bool " + resVar + "; { bool " + lVar + "; " + lInit + " if (" + lVar + ") { " + resVar + " = true; } else { bool " + rVar + "; " + rInit + " " + resVar + " = " + rVar + "; } }"
                    }
                } else {
