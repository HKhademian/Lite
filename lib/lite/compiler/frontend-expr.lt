        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        thenId := condId + 1;
        thenValVar := if isCCond { "lt_cthen_" + thenId.toText() } else { "lite$val" + thenId.toText() };
        thenLabel := if isCCond { "lt_cb_" + thenId.toText() } else { "lite$b" + thenId.toText() };
        thenPass1ValKind := if normExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + normExpected };
        thenPass1Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
        iifeDepth = condDepth, valKind = thenPass1ValKind, valVar = thenValVar, label = thenLabel,
        iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false, colVar = "");
        thenPass1 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, thenPass1Ctx), condDepth, true, "tagged", aliases);
        if inferMode {
            thenMarkers := condOuterMarkers + ctx.collectParsedMarkers("", thenPass1);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenPass1.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenPass1.next), thenMarkers);
        } else {
            thenValKind := thenPass1.kind;
            thenPass2Expected := if thenValKind == ir.VALUE_KIND_UNIT or thenValKind == ir.VALUE_KIND_NEVER { "" } else { thenValKind };
            thenPass2Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
            iifeDepth = condDepth, valKind = thenValKind, valVar = thenValVar, label = thenLabel,
            iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false, colVar = "");
            thenPass2 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
            thenPass2Expected, 0, ctx.appendCtx(ctxs, thenPass2Ctx), condDepth, false, "tagged", aliases);
            if isCCond {
                if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                    left = (kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + condStmtCode,
                    intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                } else {
                    cValDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                        ""
                    } else {
                        types.cValueType(resolvedPreThenKind) + " " + condValVar + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; (void)" + condValVar + "; "
                    };
                    if thenValKind == ir.VALUE_KIND_UNIT or thenValKind == ir.VALUE_KIND_NEVER {
                        cThenBody := ctx.cUnwrapIntoVar("", thenValKind, thenPass2.code);
                        left = (kind = thenValKind, code = "/*@CBLK:0@*/{ " + cValDecl + condStmtCode + " " + cThenBody + " }",
                        intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                    } else {
                        cThenRes := "lt_ctres_" + thenId.toText();
                        cThenAssign := ctx.cUnwrapIntoVar(cThenRes, thenValKind, thenPass2.code);
                        left = (kind = thenValKind,
                        code = "/*@CBLK:" + cThenRes + "@*/" + types.cValueType(thenValKind) + " " + cThenRes + "; { " + cValDecl + condStmtCode + " " + cThenAssign + " }",
                        intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                    }
                }
            } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                condIifeBody = condStmtCode;
                left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            } else {
                valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                    ""
                } else {
                    "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; void " + condValVar + "; "
                };
                thenRet := if thenValKind == ir.VALUE_KIND_UNIT {
                    "void (" + thenPass2.code + "); return undefined;"
                } else {
                    "return " + thenPass2.code + ";"
                };
                condIifeBody = valDecl + condStmtCode + " " + thenRet;
                left = (kind = thenValKind, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            }
        }
    } else if inferMode {
        pinitTag := if resolvedCondInitState =!= ir.INIT_STATE_INIT { "$pinit:" + resolvedCondInitState } else { "" };
        left = ctx.withMarkers((kind = resolvedPreThenKind, code = "", intValue = 0, textValue = pinitTag, constant = false, next = condEndCursor), condOuterMarkers);
    } else if isCCond {
        if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            left = (kind = resolvedPreThenKind, code = "/*@CBLK:0@*/{ " + condStmtCode + " }",
            intValue = 0, textValue = "", constant = false, next = condEndCursor);
        } else if resolvedCondInitState =!= ir.INIT_STATE_INIT {
            cDeclInit := if types.cTypeNeedsDrop(resolvedPreThenKind) {
                types.cValueType(resolvedPreThenKind) + " " + condValVar + "; memset(&" + condValVar + ", 0, sizeof(" + condValVar + "));"
            } else {
                types.cValueType(resolvedPreThenKind) + " " + condValVar + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + ";"
            };
            left = (kind = resolvedPreThenKind,
            code = "/*@CBLK:" + condValVar + "@*/" + cDeclInit + " { " + condStmtCode + " }",
            intValue = 0, textValue = "$pinit:" + resolvedCondInitState, constant = false, next = condEndCursor);
        } else {
            left = (kind = resolvedPreThenKind,
            code = "/*@CBLK:" + condValVar + "@*/" + types.cValueType(resolvedPreThenKind) + " " + condValVar + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; { " + condStmtCode + " }",
            intValue = 0, textValue = "", constant = false, next = condEndCursor);
        }
    } else {
        valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else if resolvedCondInitState =!= ir.INIT_STATE_INIT {
            "let " + condValVar + "!: " + types.tsFunctionType(resolvedPreThenKind) + "; "
        } else {
            "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; "
        };
        finalRet := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
            " return undefined;"
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            " return " + condValVar + ";"
        };
        condIifeBody = valDecl + condStmtCode + finalRet;
        left = (kind = resolvedPreThenKind, code = "(() => { " + condIifeBody + " })()",
        intValue = 0, textValue = if resolvedCondInitState =!= ir.INIT_STATE_INIT { "$pinit:" + resolvedCondInitState } else { "" }, constant = false, next = condEndCursor);
    }
    afterCondConstruct := syntax.skipTrivia(source, left.next, prefix);
    if hasActualThen and afterCondConstruct < source.length() and source.wordAt(afterCondConstruct, "then") {
        syntax.failAt(source, afterCondConstruct, prefix, "duplicate then block");
    }
    if afterCondConstruct < source.length() and source.wordAt(afterCondConstruct, "finally") {
        condFinCtx := (id = condId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_FINALLY,
        iifeDepth = condDepth, valKind = resolvedPreThenKind, valVar = condValVar, label = condLabel,
        iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        finParsed := parseFinallyClause(target, source, afterCondConstruct, prefix, locals, functions, params, currentName,
        ctx.appendCtx(ctxs, condFinCtx), condDepth, inferMode, aliases);
        if isCCond {
            left = finishFinallyC(left.code, finParsed, left.kind, left, inferMode, ctxs, condId);
        } else {
            left = finishFinallyIife(condIifeBody, finParsed, left.kind, left, inferMode);
        }
    }
    left
};

/** Parses list push/pop intrinsic operations (`push_back`, `pop_back`, `push_front`, `pop_front`). */
parseListIntrinsicCall := fn(target: String, source: String, start: Int, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "length" or opName == "reverse" or opName == "slice" {
        open := syntax.expectSymbol(source, argOpen, "(", prefix);
        listStart := syntax.skipTrivia(source, open, prefix);
        lst := parseBinaryCtx(target, source, listStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isListKind(lst.kind) {
            syntax.failAt(source, listStart, prefix, opDisplay + " expects a List, got " + types.displayKind(lst.kind));
        }
        if opName == "length" {
            close := ctx.expectNonemptyCallClose(source, lst.next, prefix);
            lenCode := if target == ir.TARGET_C { "((" + lst.code + ").len)" } else { "BigInt((" + lst.code + ").length)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lenCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", lst) } else { "" });
        }
        if opName == "reverse" {
            close := ctx.expectNonemptyCallClose(source, lst.next, prefix);
            revTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(lst.kind)) } else { "" };
            revCode := if revTag =!= "" { "lt_list_" + revTag + "_reverse(" + lst.code + ")" } else { "[...(" + lst.code + ")].reverse()" };
            return ctx.withMarkers((kind = lst.kind, code = revCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", lst) } else { "" });
        }
        comma1 := syntax.skipTrivia(source, lst.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects start index after the list");
        }
        sStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        sArg := parseBinaryCtx(target, source, sStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(sArg.kind) {
            syntax.failAt(source, sStart, prefix, opDisplay + " start index must be Int, got " + types.displayKind(sArg.kind));
        }
        comma2 := syntax.skipTrivia(source, sArg.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects end index after start");
        }
        eStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        eArg := parseBinaryCtx(target, source, eStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(eArg.kind) {
            syntax.failAt(source, eStart, prefix, opDisplay + " end index must be Int, got " + types.displayKind(eArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, eArg.next, prefix);
        sCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, sArg.kind, sArg.code);
        eCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, eArg.kind, eArg.code);
        mk := if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers(ctx.collectParsedMarkers("", lst), sArg), eArg) } else { "" };
        slTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(lst.kind)) } else { "" };
        slCode := if slTag =!= "" {
            "lt_list_" + slTag + "_slice(" + lst.code + ", " + sCode + ", " + eCode + ", " + start.toText() + ")"
        } else {
            "lite$listSlice(" + lst.code + ", " + sCode + ", " + eCode + ", " + start.toText() + ")"
        };
        return ctx.withMarkers((kind = lst.kind, code = slCode,
        intValue = 0, textValue = "", constant = false, next = close), mk);
    }
    grant := ctx.parseListGrant(source, argOpen, prefix, locals, opDisplay);
    grantTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(grant.kind)) } else { "" };
    if opName == "clear" {
        close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
        clrCode := if grantTag =!= "" { "lt_list_" + grantTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").length = 0, undefined)" };
        return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
        intValue = 0, textValue = "", constant = false, next = close);
    }
    if opName == "set_at" {
        comma1 := syntax.skipTrivia(source, grant.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects an index after the mut list");
        }
        idxStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        idxArg := parseBinaryCtx(target, source, idxStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(idxArg.kind) {
            syntax.failAt(source, idxStart, prefix, opDisplay + " index must be Int, got " + types.displayKind(idxArg.kind));
        }
        comma2 := syntax.skipTrivia(source, idxArg.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects a value after the index");
        }
        valStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        elementKind := types.listElementKind(grant.kind);
        valArg := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elementKind, valArg.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elementKind) + ", got " + types.displayKind(valArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
        idxCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
        valCode := ctx.assignValueCode(target, elementKind, valArg.kind, valArg.code);
        mk := if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", idxArg), valArg) } else { "" };
        setCode := if grantTag =!= "" {
            "lt_list_" + grantTag + "_set(&" + grant.runtime + ", " + idxCode + ", " + valCode + ", " + start.toText() + ")"
        } else {
            "lite$listSet(" + grant.runtime + ", " + idxCode + ", " + valCode + ", " + start.toText() + ")"
        };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode,
        intValue = 0, textValue = "", constant = false, next = close), mk);
    }
    if opName == "push_back" or opName == "push_front" {
        cursor := syntax.skipTrivia(source, grant.next, prefix);
        if cursor >= source.length() or source.at(cursor) =!= "," {
            syntax.failAt(source, cursor, prefix, opDisplay + " expects a value after the mut list");
        }
        valueStart := syntax.skipTrivia(source, cursor + 1, prefix);
        elementKind := types.listElementKind(grant.kind);
        value := parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elementKind, value.kind) {
            syntax.failAt(source, valueStart, prefix, opDisplay + " element must be " + types.displayKind(elementKind) +
            ", got " + types.displayKind(value.kind));
        }
        close := ctx.expectNonemptyCallClose(source, value.next, prefix);
        vCode := ctx.assignValueCode(target, elementKind, value.kind, value.code);
        pushCode := if grantTag =!= "" {
            "lt_list_" + grantTag + "_" + opName + "(&" + grant.runtime + ", " + vCode + ")"
        } else {
            method := if opName == "push_back" { ".push(" } else { ".unshift(" };
            grant.runtime + method + vCode + ")"
        };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = pushCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", value) } else { "" });
    }
    close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
    popCode := if grantTag =!= "" {
        "lt_list_" + grantTag + "_" + opName + "(&" + grant.runtime + ", " + start.toText() + ")"
    } else {
        helper := if opName == "pop_back" { "lite$listPopBack(" } else { "lite$listPopFront(" };
        helper + grant.runtime + ", " + start.toText() + ")"
    };
    (kind = types.listElementKind(grant.kind), code = popCode,
    intValue = 0, textValue = "", constant = false, next = close)
};

/** Parses and lowers a `type/map` generic intrinsic call (`set`, `get`, `getOr`, `has`, `remove`, `size`, `clear`, `keys`, `values`). */
parseMapIntrinsicCall := fn(target: String, source: String, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "set" or opName == "remove" or opName == "clear" {
        grant := ctx.parseMapGrant(source, argOpen, prefix, locals, opDisplay);
        kKind := types.mapKeyKind(grant.kind);
        vKind := types.mapValueKind(grant.kind);
        mTag := if target == ir.TARGET_C { types.cMapTag(grant.kind) } else { "" };
        if opName == "clear" {
            close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
            clrCode := if mTag =!= "" { mTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").clear(), undefined)" };
            return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
            intValue = 0, textValue = "", constant = false, next = close);
        }
        comma1 := syntax.skipTrivia(source, grant.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects a key after the mut map");
        }
        keyStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        key := parseBinaryCtx(target, source, keyStart, prefix, locals, functions, params, currentName, kKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(kKind, key.kind) {
            syntax.failAt(source, keyStart, prefix, opDisplay + " key must be " + types.displayKind(kKind) + ", got " + types.displayKind(key.kind));
        }
        keyCode := ctx.assignValueCode(target, kKind, key.kind, key.code);
        if opName == "remove" {
            close := ctx.expectNonemptyCallClose(source, key.next, prefix);
            rmCode := if mTag =!= "" { mTag + "_remove(&" + grant.runtime + ", " + keyCode + ")" } else { "((" + grant.runtime + ").delete(" + keyCode + "))" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", key) } else { "" });
        }
        comma2 := syntax.skipTrivia(source, key.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects a value after the key");
        }
        valStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, vKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(vKind, val.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " value must be " + types.displayKind(vKind) + ", got " + types.displayKind(val.kind));
        }
        close := ctx.expectNonemptyCallClose(source, val.next, prefix);
        valCode := ctx.assignValueCode(target, vKind, val.kind, val.code);
        setCode := if mTag =!= "" { mTag + "_set(&" + grant.runtime + ", " + keyCode + ", " + valCode + ")" } else { "((" + grant.runtime + ").set(" + keyCode + ", " + valCode + "), undefined)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", key), val) } else { "" });
    }
    open := syntax.expectSymbol(source, argOpen, "(", prefix);
    mapStart := syntax.skipTrivia(source, open, prefix);
    m := parseBinaryCtx(target, source, mapStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not types.isMapKind(m.kind) {
        syntax.failAt(source, mapStart, prefix, opDisplay + " expects a Map, got " + types.displayKind(m.kind));
    }
    kKind := types.mapKeyKind(m.kind);
    vKind := types.mapValueKind(m.kind);
    mTag := if target == ir.TARGET_C { types.cMapTag(m.kind) } else { "" };
    var markers := if inferMode { ctx.collectParsedMarkers("", m) } else { "" };
    if opName == "size" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        szCode := if mTag =!= "" { "((" + m.code + ").len)" } else { "BigInt((" + m.code + ").size)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "keys" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        kListCode := if mTag =!= "" { mTag + "_keys(" + m.code + ")" } else { "Array.from((" + m.code + ").keys())" };
        return ctx.withMarkers((kind = "List<" + kKind + ">", code = kListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "values" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        vListCode := if mTag =!= "" { mTag + "_values(" + m.code + ")" } else { "Array.from((" + m.code + ").values())" };
        return ctx.withMarkers((kind = "List<" + vKind + ">", code = vListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma1 := syntax.skipTrivia(source, m.next, prefix);
    if comma1 >= source.length() or source.at(comma1) =!= "," {
        syntax.failAt(source, comma1, prefix, opDisplay + " expects a key after the map");
    }
    keyStart := syntax.skipTrivia(source, comma1 + 1, prefix);
    key := parseBinaryCtx(target, source, keyStart, prefix, locals, functions, params, currentName, kKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, key); }
    if not types.isCompatibleKind(kKind, key.kind) {
        syntax.failAt(source, keyStart, prefix, opDisplay + " key must be " + types.displayKind(kKind) + ", got " + types.displayKind(key.kind));
    }
    keyCode := ctx.assignValueCode(target, kKind, key.kind, key.code);
    if opName == "has" {
        close := ctx.expectNonemptyCallClose(source, key.next, prefix);
        hasCode := if mTag =!= "" { mTag + "_has(" + m.code + ", " + keyCode + ")" } else { "((" + m.code + ").has(" + keyCode + "))" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    tsV := types.tsFunctionType(vKind);
    needsCopy := ctx.copiedValueCode(target, vKind, "lite$v") =!= "lite$v";
    if opName == "get" {
        close := ctx.expectNonemptyCallClose(source, key.next, prefix);
        zeroVal := ctx.zeroParsed(target, vKind, close).code;
        resTupleKind := "(found:Bool,value:" + vKind + ")";
        code := if mTag =!= "" {
            "/*@T:" + resTupleKind + "@*/" + mTag + "_get(" + m.code + ", " + keyCode + ", " + zeroVal + ")"
        } else if not needsCopy {
            "lite$mapGet((" + m.code + "), " + keyCode + ", " + zeroVal + ")"
        } else {
            copied := ctx.copiedValueCode(target, vKind, "lite$v");
            "((lite$v: " + tsV + " | undefined): { found: boolean; value: " + tsV + " } => lite$v !== undefined ? { found: true, value: " + copied + " } : { found: false, value: " + zeroVal + " })((" + m.code + ").get(" + keyCode + "))"
        };
        return ctx.withMarkers((kind = resTupleKind, code = code,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma2 := syntax.skipTrivia(source, key.next, prefix);
    if comma2 >= source.length() or source.at(comma2) =!= "," {
        syntax.failAt(source, comma2, prefix, opDisplay + " expects a fallback value after the key");
    }
    fbStart := syntax.skipTrivia(source, comma2 + 1, prefix);
    fb := parseBinaryCtx(target, source, fbStart, prefix, locals, functions, params, currentName, vKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, fb); }
    if not types.isCompatibleKind(vKind, fb.kind) {
        syntax.failAt(source, fbStart, prefix, opDisplay + " fallback must be " + types.displayKind(vKind) + ", got " + types.displayKind(fb.kind));
    }
    close := ctx.expectNonemptyCallClose(source, fb.next, prefix);
    fbCode := ctx.assignValueCode(target, vKind, fb.kind, fb.code);
    code := if mTag =!= "" {
        mTag + "_get_or(" + m.code + ", " + keyCode + ", " + fbCode + ")"
    } else if not needsCopy {
        "lite$mapGetOr((" + m.code + "), " + keyCode + ", " + fbCode + ")"
    } else {
        copied := ctx.copiedValueCode(target, vKind, "lite$v");
        "((lite$v: " + tsV + " | undefined, lite$fb: " + tsV + "): " + tsV + " => lite$v !== undefined ? " + copied + " : lite$fb)((" + m.code + ").get(" + keyCode + "), " + fbCode + ")"
    };
    ctx.withMarkers((kind = vKind, code = code, intValue = 0, textValue = "", constant = false, next = close), markers)
};

/** Parses and lowers a `type/set` generic intrinsic call (`add`, `has`, `remove`, `size`, `clear`, `values`). */
parseSetIntrinsicCall := fn(target: String, source: String, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "add" or opName == "remove" or opName == "clear" {
        grant := ctx.parseSetGrant(source, argOpen, prefix, locals, opDisplay);
        elemKind := types.setElementKind(grant.kind);
        sTag := if target == ir.TARGET_C { types.cSetTag(grant.kind) } else { "" };
        if opName == "clear" {
            close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
            clrCode := if sTag =!= "" { sTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").clear(), undefined)" };
            return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
            intValue = 0, textValue = "", constant = false, next = close);
        }
        comma := syntax.skipTrivia(source, grant.next, prefix);
        if comma >= source.length() or source.at(comma) =!= "," {
            syntax.failAt(source, comma, prefix, opDisplay + " expects a value after the mut set");
        }
        valStart := syntax.skipTrivia(source, comma + 1, prefix);
        val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elemKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elemKind, val.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elemKind) + ", got " + types.displayKind(val.kind));
        }
        close := ctx.expectNonemptyCallClose(source, val.next, prefix);
        valCode := ctx.assignValueCode(target, elemKind, val.kind, val.code);
        if opName == "add" {
            addCode := if sTag =!= "" { sTag + "_add(&" + grant.runtime + ", " + valCode + ")" } else { "((" + grant.runtime + ").add(" + valCode + "), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = addCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", val) } else { "" });
        }
        rmCode := if sTag =!= "" { sTag + "_remove(&" + grant.runtime + ", " + valCode + ")" } else { "((" + grant.runtime + ").delete(" + valCode + "))" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", val) } else { "" });
    }
    open := syntax.expectSymbol(source, argOpen, "(", prefix);
    setStart := syntax.skipTrivia(source, open, prefix);
    s := parseBinaryCtx(target, source, setStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not types.isSetKind(s.kind) {
        syntax.failAt(source, setStart, prefix, opDisplay + " expects a Set, got " + types.displayKind(s.kind));
    }
    elemKind := types.setElementKind(s.kind);
    sTag := if target == ir.TARGET_C { types.cSetTag(s.kind) } else { "" };
    var markers := if inferMode { ctx.collectParsedMarkers("", s) } else { "" };
    if opName == "size" {
        close := ctx.expectNonemptyCallClose(source, s.next, prefix);
        szCode := if sTag =!= "" { "((" + s.code + ").len)" } else { "BigInt((" + s.code + ").size)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "values" {
        close := ctx.expectNonemptyCallClose(source, s.next, prefix);
        valListCode := if sTag =!= "" { sTag + "_values(" + s.code + ")" } else { "Array.from((" + s.code + ").values())" };
        return ctx.withMarkers((kind = "List<" + elemKind + ">", code = valListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma := syntax.skipTrivia(source, s.next, prefix);
    if comma >= source.length() or source.at(comma) =!= "," {
        syntax.failAt(source, comma, prefix, opDisplay + " expects a value after the set");
    }
    valStart := syntax.skipTrivia(source, comma + 1, prefix);
    val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elemKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, val); }
    if not types.isCompatibleKind(elemKind, val.kind) {
        syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elemKind) + ", got " + types.displayKind(val.kind));
    }
    close := ctx.expectNonemptyCallClose(source, val.next, prefix);
    valCode := ctx.assignValueCode(target, elemKind, val.kind, val.code);
    hasCode := if sTag =!= "" { sTag + "_has(" + s.code + ", " + valCode + ")" } else { "((" + s.code + ").has(" + valCode + "))" };
    ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode,
    intValue = 0, textValue = "", constant = false, next = close), markers)
};

/** True when `kind` has a `$getIndex` or `$setIndex` operator hook registered in `functions`. */
pub hasIndexHook := fn(kind: String, opName: String, functions: List<FunctionInfo>): Bool {
    if types.isSliceKind(kind) and (opName == "$getIndex" or opName == "$setIndex") {
        return true;
    }
    ownerKey := types.typeOpOwnerKey(kind);
    findAllTypeOpsForKind(functions, ownerKey, kind, "", opName).length() > 0
};

/** True when `kind` implements `core/interface.Index` (or `IndexMut` when `isMut`). */
pub hasInterfaceIndexImpl := fn(target: String, kind: String, isMut: Bool): Bool {
    modKey := if target == ir.TARGET_TS { "lib$core$interface" } else { "lib_s_core_s_interface" };
    reqKey := modKey + (if isMut { "#IndexMut" } else { "#Index" });
    types.findMatchingImplsByKey(kind, reqKey).length() > 0
};

/** Resolves an `Index<K, V>` or `IndexMut<K, V>` impl method on `receiverKind` matching `keyKind` (or `"$Range"` for `core/interface.Range`). */
pub resolveInterfaceIndexImpl := fn(target: String, source: String, errPos: Int, prefix: String,
receiverKind: String, keyKind: String, isMut: Bool, functions: List<FunctionInfo>, inferMode: Bool): (found: Bool, runtime: String, keyKind: String, valKind: String, resultKind: String) {
    emptyRes := (found = false, runtime = "", keyKind = "", valKind = "", resultKind = "");
    modKey := if target == ir.TARGET_TS { "lib$core$interface" } else { "lib_s_core_s_interface" };
    reqKey := modKey + (if isMut { "#IndexMut" } else { "#Index" });
    cands := types.findMatchingImplsByKey(receiverKind, reqKey);
    if cands.length() == 0 { return emptyRes; }
    mut exactMatches: List<(implIdx: Int, bindingsEncoded: String, arg0: String, arg1: String)> = [];
    mut compatMatches: List<(implIdx: Int, bindingsEncoded: String, arg0: String, arg1: String)> = [];
    loop cands as c {
        if keyKind == "$Range" {
            if types.isRecordKind(c.arg0) and c.arg0.startsWithAt(0, "Record<" + modKey + "#") and types.recordDisplayName(c.arg0) == "Range" {
                mut exactMatches.pushBack(c);
            }
        } else if c.arg0 == keyKind {
            mut exactMatches.pushBack(c);
        } else if keyKind =!= "" and types.isCompatibleKind(c.arg0, keyKind) {
            mut compatMatches.pushBack(c);
        }
    }
    matched := if exactMatches.length() > 0 { exactMatches } else { compatMatches };
    if matched.length() == 0 { return emptyRes; }
    if matched.length() > 1 and not inferMode {
        syntax.failAt(source, errPos, prefix, "ambiguous " + (if isMut { "IndexMut" } else { "Index" }) + " implementation on " + types.displayKind(receiverKind));
    }
    best := matched[0];
    imp := interfaces.getImpl(best.implIdx);
    mName := if isMut { "setIndex" } else { "getIndex" };
    fnRt := if inferMode { "$infer_idx" } else { resolveImplBindingRuntime(target, source, errPos, prefix, imp, best.bindingsEncoded, mName, functions) };
    resK := if isMut { ir.VALUE_KIND_UNIT } else { best.arg1 };
    (found = true, runtime = fnRt, keyKind = best.arg0, valKind = best.arg1, resultKind = resK)
};

/** Resolves a `$getIndex` or `$setIndex` operator hook on `receiverKind`, instantiating generics on demand when `not inferMode`. */
pub resolveIndexHookOp := fn(target: String, source: String, errPos: Int, prefix: String, receiverKind: String, opName: String, functions: List<FunctionInfo>, params: List<String>, inferMode: Bool): (found: Bool, runtime: String, keyKind: String, valKind: String, resultKind: String) {
    if types.isSliceKind(receiverKind) and (opName == "$getIndex" or opName == "$setIndex") {
        elK := types.sliceElementKind(receiverKind);
        rt := if opName == "$setIndex" { "lite$core$slice$setIndex:v1" } else { "lite$core$slice$getIndex:v1" };
        resK := if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { elK };
        return (found = true, runtime = rt, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = resK);
    }
    ownerKey := types.typeOpOwnerKey(receiverKind);
    idxCands := findAllTypeOpsForKind(functions, ownerKey, receiverKind, "", opName);
    if idxCands.length() == 0 {
        return (found = false, runtime = "", keyKind = "", valKind = "", resultKind = "");
    }
    opIdx := idxCands[0];
    info := functions[opIdx];
    rawRecv := types.paramKindOf(params[info.first]);
    recvBase := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
    rawKey := types.paramKindOf(params[info.first + 1]);
    rawVal := if opName == "$setIndex" { types.paramKindOf(params[info.first + 2]) } else { info.result };
    if info.runtime == "lite$core$list$getIndex:v1" or info.runtime == "lite$core$list$setAt:v1" {
        if not types.isListKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires List, got " + types.displayKind(receiverKind));
        }
        elK := types.listElementKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { elK });
    }
    if info.runtime == "lite$core$array$getIndex:v1" or info.runtime == "lite$core$array$setIndex:v1" {
        if not types.isArrayKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires Array, got " + types.displayKind(receiverKind));
        }
        elK := types.arrayElementKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { elK });
    }
    if info.runtime == "lite$core$map$getIndex:v1" or info.runtime == "lite$core$map$set:v1" {
        if not types.isMapKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires Map, got " + types.displayKind(receiverKind));
        }
        kK := types.mapKeyKind(receiverKind);
        vK := types.mapValueKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = kK, valKind = vK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { vK });
    }
    if info.runtime == "lite$core$simd$get:v1" {
        if not types.isSimdKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires Simd, got " + types.displayKind(receiverKind));
        }
        elK := types.simdElementKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = elK);
    }
    if info.runtime == "lite$core$soa$get:v1" or info.runtime == "lite$core$soa$set:v1" {
        if not types.isSoaKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires SoA, got " + types.displayKind(receiverKind));
        }
        recK := types.soaRecordKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = recK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { recK });
    }
    if info.runtime.startsWithAt(0, "$gen:") {
        tplKey := info.runtime.slice(5, info.runtime.length());
        tplIdx := generics.findTemplate(tplKey);
        if tplIdx < 0 {
            syntax.failAt(source, errPos, prefix, "internal error: missing generic template " + tplKey);
        }
        tpl := generics.getTemplate(tplIdx);
        mut bindings: Map<String, String>;
        uErr := generics.unifyKindMut(tpl.genericParams, recvBase, receiverKind, mut bindings);
        if uErr =!= "" {
            syntax.failAt(source, errPos, prefix, opName + " requires " + types.displayKind(recvBase) + ", got " + types.displayKind(receiverKind));
        }
        loop generics.splitGenericParams(tpl.genericParams) as gp {
            if not bindings.has(gp) {
                syntax.failAt(source, errPos, prefix, "cannot infer type parameter " + gp + " for " + opName + " on " + types.displayKind(receiverKind));
            }
        }
        cErr := findGenericConstraintError(tpl.genericParams, bindings, "");
        if cErr =!= "" {
            syntax.failAt(source, errPos, prefix, cErr);
        }
        concKey := generics.substKind(tpl.genericParams, rawKey, bindings);
        concVal := generics.substKind(tpl.genericParams, rawVal, bindings);
        concRes := generics.substKind(tpl.genericParams, info.result, bindings);
        var effRuntime := info.runtime;
        if not inferMode {
            mut allSubstParts: List<String> = [];
            loop generics.splitPipeEntries(tpl.params, tpl.paramCount) as tpEntry {
                tpName := types.paramNameOf(tpEntry);
                tpRaw := types.paramKindOf(tpEntry);
                tpIsMut := tpRaw.startsWithAt(0, "mut ");
                tpBase := if tpIsMut { tpRaw.slice(4, tpRaw.length()) } else { tpRaw };
                tpConc := generics.substKind(tpl.genericParams, tpBase, bindings);
                mut allSubstParts.pushBack(tpName + "=" + (if tpIsMut { "mut " } else { "" }) + tpConc);
            }
            effRuntime = generics.requestInstance(target, tplKey, generics.encodeBindings(tpl.genericParams, bindings), allSubstParts.join("|"), concRes);
        }
        return (found = true, runtime = effRuntime, keyKind = concKey, valKind = concVal, resultKind = concRes);
    }
    if not types.isCompatibleKind(recvBase, receiverKind) {
        syntax.failAt(source, errPos, prefix, opName + " requires " + types.displayKind(recvBase) + ", got " + types.displayKind(receiverKind));
    }
    (found = true, runtime = info.runtime, keyKind = rawKey, valKind = rawVal, resultKind = info.result)
};

/** Emits TS or C11 read expression for `$getIndex` (both user hooks and hard-builtin core hooks). */
emitHookIndexReadCode := fn(target: String, errPos: Int, recvKind: String, recvCode: String, getRuntime: String, keyCode: String): String {
    if getRuntime == "lite$core$list$getIndex:v1" or getRuntime == "lite$core$array$getIndex:v1" {
        elKind := if types.isListKind(recvKind) { types.listElementKind(recvKind) } else { types.arrayElementKind(recvKind) };
        if target == ir.TARGET_C {
            if types.isArrayKind(recvKind) and types.cArrayTag(recvKind) =!= "" {
                return "/*@T:" + recvKind + "@*/" + types.cArrayTag(recvKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
            }
            return "lt_list_" + types.cListTag(elKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$listAt(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
    }
    if getRuntime == "lite$core$slice$getIndex:v1" {
        if target == ir.TARGET_C {
            return types.cSliceTag(recvKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$sliceAt(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
    }
    if getRuntime == "lite$core$map$getIndex:v1" {
        if target == ir.TARGET_C {
            return types.cMapTag(recvKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$mapAt((" + recvCode + "), " + keyCode + ", " + errPos.toText() + ")";
    }
    if getRuntime == "lite$core$simd$get:v1" {
        if target == ir.TARGET_C {
            return types.cSimdTag(recvKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$simdAt(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
    }
    if getRuntime == "lite$core$soa$get:v1" {
        if target == ir.TARGET_C {
            return "/*@T:" + recvKind + "@*/" + types.cSoaTag(recvKind) + "_get(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        recK := types.soaRecordKind(recvKind);
        return emitTsSoaGetCode(recK, recvCode, keyCode, errPos, false);
    }
    getRuntime + "(" + recvCode + ", " + keyCode + ")"
};

/** Emits TS or C11 statement code for `entry[key] = val` or single-evaluation compound `entry[key] op= val` via `$setIndex` (and `$getIndex`). */
pub emitHookIndexAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entry: Local, setRuntime: String, getRuntime: String, keyKind: String, valKind: String, keyCode: String, compBaseOp: String, valParsed: Parsed): String {
    isCompound := compBaseOp =!= "";
    if setRuntime == "lite$core$list$setAt:v1" or setRuntime == "lite$core$array$setIndex:v1" {
        elKind := if types.isListKind(entry.kind) { types.listElementKind(entry.kind) } else { types.arrayElementKind(entry.kind) };
        if target == ir.TARGET_C {
            if types.isArrayKind(entry.kind) and types.cArrayTag(entry.kind) =!= "" {
                aTag := types.cArrayTag(entry.kind);
                if isCompound {
                    cValType := types.cValueType(elKind);
                    curRead := "/*@T:" + entry.kind + "@*/" + aTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                    nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, "lt_cv", compBaseOp, valParsed);
                    return "{ /*c-stmt*/ int64_t lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + aTag + "_set(&" + entry.runtime + ", lt_ck, " + nextVal + ", " + opPos.toText() + "); }";
                }
                vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
                return "/*@T:" + entry.kind + "@*/" + aTag + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
            }
            cTag := types.cListTag(elKind);
            if isCompound {
                cValType := types.cValueType(elKind);
                curRead := "lt_list_" + cTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, "lt_cv", compBaseOp, valParsed);
                return "{ /*c-stmt*/ int64_t lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; lt_list_" + cTag + "_set(&" + entry.runtime + ", lt_ck, " + nextVal + ", " + opPos.toText() + "); }";
            }
            vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
            return "lt_list_" + cTag + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
        }
        if isCompound {
            curRead := "lite$listAt(" + entry.runtime + ", lite$ci, " + opPos.toText() + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, curRead, compBaseOp, valParsed);
            return "((lite$ci: bigint) => lite$listSet(" + entry.runtime + ", lite$ci, " + nextVal + ", " + opPos.toText() + "))(" + keyCode + ")";
        }
        vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
        return "lite$listSet(" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
    }
    if setRuntime == "lite$core$slice$setIndex:v1" {
        elKind := types.sliceElementKind(entry.kind);
        if target == ir.TARGET_C {
            sTag := types.cSliceTag(entry.kind);
            if isCompound {
                cValType := types.cValueType(elKind);
                curRead := sTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, "lt_cv", compBaseOp, valParsed);
                return "{ /*c-stmt*/ int64_t lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + sTag + "_set(" + entry.runtime + ", lt_ck, " + nextVal + ", " + opPos.toText() + "); }";
            }
            vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
            return sTag + "_set(" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
        }
        if isCompound {
            curRead := "lite$sliceAt(" + entry.runtime + ", lite$ci, " + opPos.toText() + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, curRead, compBaseOp, valParsed);
            return "((lite$ci: bigint) => lite$sliceSet(" + entry.runtime + ", lite$ci, " + nextVal + ", " + opPos.toText() + "))(" + keyCode + ")";
        }
        vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
        return "lite$sliceSet(" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
    }
    if setRuntime == "lite$core$map$set:v1" {
        if target == ir.TARGET_C {
            mTag := types.cMapTag(entry.kind);
            if isCompound {
                cKeyType := types.cValueType(keyKind);
                cValType := types.cValueType(valKind);
                curRead := mTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lt_cv", compBaseOp, valParsed);
                return "{ /*c-stmt*/ " + cKeyType + " lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + mTag + "_set(&" + entry.runtime + ", lt_ck, " + nextVal + "); }";
            }
            vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
            return mTag + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ")";
        }
        if isCompound {
            curRead := "lite$mapAt(" + entry.runtime + ", lite$ck, " + opPos.toText() + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, curRead, compBaseOp, valParsed);
            return "((lite$ck: " + types.tsFunctionType(keyKind) + ") => (" + entry.runtime + ").set(lite$ck, " + nextVal + "))(" + keyCode + ")";
        }
        vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
        return "(" + entry.runtime + ").set(" + keyCode + ", " + vCode + ")";
    }
    if setRuntime == "lite$core$soa$set:v1" {
        if isCompound {
            syntax.failAt(source, opPos, prefix, "compound indexing assignment is not supported on SoA rows");
        }
        recK := types.soaRecordKind(entry.kind);
        vCode := ctx.assignValueCode(target, recK, valParsed.kind, valParsed.code);
        if target == ir.TARGET_C {
            return types.cSoaTag(entry.kind) + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
        }
        return emitTsSoaSetCode(recK, entry.runtime, keyCode, vCode, opPos, false);
    }
    if target == ir.TARGET_C {
        keyByPtr := types.cParamIsConstPtr(keyKind);
        if isCompound {
            cKeyType := types.cValueType(keyKind);
            cValType := types.cValueType(valKind);
            kb := cBorrowExprWithPostDrop(keyKind, "lt_ck", keyByPtr);
            recvArg := if types.cParamIsConstPtr(entry.kind) { "&(" + entry.runtime + ")" } else { entry.runtime };
            curRead := getRuntime + "(" + recvArg + ", " + kb.expr + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lt_cv", compBaseOp, valParsed);
            return "{ /*c-stmt*/ " + cKeyType + " lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + setRuntime + "(&" + entry.runtime + ", " + (if keyByPtr { "&lt_ck" } else { "lt_ck" }) + ", " + nextVal + "); }";
        }
        vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
        kb := cBorrowExprWithPostDrop(keyKind, keyCode, keyByPtr);
        setExpr := setRuntime + "(&" + entry.runtime + ", " + kb.expr + ", " + vCode + ")";
        mut hkDrops: List<String> = [];
        if kb.drop =!= "" { mut hkDrops.pushBack(kb.drop); }
        return cWrapExprWithPostDrops(ir.VALUE_KIND_UNIT, setExpr, hkDrops);
    }
    isRec := types.isRecordOrDistinctRecord(entry.kind);
    alreadyBoxed := isRec and entry.runtime.endsWith(".v");
    boxExpr := if alreadyBoxed { entry.runtime.slice(0, entry.runtime.length() - 2) } else { "" };
    tsRecType := if isRec and not alreadyBoxed { types.tsFunctionType(entry.kind) } else { "" };
    liveBox := if isRec and not alreadyBoxed {
        "const lite$ib: { v: " + tsRecType + " } = { get v(): " + tsRecType + " { return " + entry.runtime + "; }, set v(lite$nv: " + tsRecType + ") { " + entry.runtime + " = lite$nv; } };"
    } else { "" };
    if isCompound {
        tsKeyType := types.tsFunctionType(keyKind);
        curRead := getRuntime + "(" + entry.runtime + ", lite$ck)";
        nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lite$cv", compBaseOp, valParsed);
        if isRec and not alreadyBoxed {
            return "(() => { const lite$ck: " + tsKeyType + " = " + keyCode + "; const lite$cv = " + curRead + "; " + liveBox + " " + setRuntime + "(lite$ib, lite$ck, " + nextVal + "); })()";
        }
        recvArg := if alreadyBoxed { boxExpr } else { entry.runtime };
        return "(() => { const lite$ck: " + tsKeyType + " = " + keyCode + "; const lite$cv = " + curRead + "; " + setRuntime + "(" + recvArg + ", lite$ck, " + nextVal + "); })()";
    }
    vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
    if isRec and not alreadyBoxed {
        return "(() => { " + liveBox + " " + setRuntime + "(lite$ib, " + keyCode + ", " + vCode + "); })()";
    }
    recvArg := if alreadyBoxed { boxExpr } else { entry.runtime };
    setRuntime + "(" + recvArg + ", " + keyCode + ", " + vCode + ")"
};

/** True when the bracket expression starting at `openBracket` contains a top-level `..` range slice separator before `]`. */
isBracketRangeSlice := fn(source: String, openBracket: Int, prefix: String): Bool {
    size := source.length();
    var cursor := syntax.skipTrivia(source, openBracket + 1, prefix);
    var depth := 0;
    loop cursor < size {
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                sc := source.at(cursor);
                if sc == "\\" { cursor = cursor + 2; continue; }
                if sc == "\"" { cursor = cursor + 1; break; }
                cursor = cursor + 1;
            }
            continue;
        }
        if ch == "[" or ch == "(" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
            continue;
        }
        if ch == "]" {
            if depth == 0 { return false; }
            depth = depth - 1;
            cursor = cursor + 1;
            continue;
        }
        if ch == ")" or ch == "}" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
            continue;
        }
        if depth == 0 and source.startsWithAt(cursor, "..") {
            return true;
        }
        cursor = cursor + 1;
    }
    false
};

/** Finds the innermost local in `locals` whose runtime identifier matches `runtime`, or -1. */
findLocalIndexByRuntime := fn(locals: List<Local>, runtime: String): Int {
    if runtime == "" { return -1; }
    var i := locals.length() - 1;
    loop i >= 0 {
        if locals[i].runtime == runtime { return i; }
        i = i - 1;
    }
    -1
};

/** True when any local callable binding exists in scope (which could capture and mutate a local `mut` binding during a call). */
localsHasLocalClosure := fn(locals: List<Local>): Bool {
    loop locals as l {
        if l.depth >= 1 and l.name =!= "$self" and types.containsFnKind(l.kind) {
            return true;
        }
    }
    false
};

/** Extracts a user-facing binding name from a runtime variable expression for diagnostics. */
displayBindingFromRuntime := fn(rt: String): String {
    var s := rt;
    if s.startsWithAt(0, "&") { s = s.slice(1, s.length()); }
    if s.startsWithAt(0, "(*") and s.endsWith(")") { s = s.slice(2, s.length() - 1); }
    if s.endsWith(".v") { s = s.slice(0, s.length() - 2); }
    if s.startsWithAt(0, "lite_") { s = s.slice(5, s.length()); }
    s
};

/** Returns the conflicting source binding name if non-`mut` `argCode` aliases any `mut` root in `mutArgRoots`, or `""`. */
findMutAliasConflictName := fn(argCode: String, argKind: String, mutArgRoots: List<String>, mutArgNames: List<String>): String {
    if mutArgRoots.length() == 0 { return ""; }
    isContainerArg := types.isMutContainerKind(argKind) or types.cTypeHasListField(argKind);
    var ri := 0;
    loop ri < mutArgRoots.length() {
        rootRt := mutArgRoots[ri];
        if argCode == rootRt or argCode == rootRt + ".v" or rootRt == argCode + ".v" {
            return mutArgNames[ri];
        }
        if isContainerArg and (
        argCode.startsWithAt(0, "(" + rootRt + ").") or
        argCode.startsWithAt(0, rootRt + ".") or
        argCode.startsWithAt(0, "((" + rootRt + ")).")
        ) {
            return mutArgNames[ri];
        }
        ri += 1;
    }
    ""
};

/** Extracts root runtime identifier from a pure C11/TS field chain such as `((*lite_w)).f_cmdArena`, or `""` otherwise. */
extractFieldChainRootIdent := fn(code: String): String {
    size := code.length();
    var pos := 0;
    loop pos < size {
        c := code.at(pos);
        if c == "(" or c == "*" or c == " " { pos += 1; } else { break; }
    }
    if pos >= size or not (code.at(pos).isNameStart() or code.at(pos) == "$") { return ""; }
    idStart := pos;
    loop pos < size and (code.at(pos).isNameContinue() or code.at(pos) == "$") {
        pos += 1;
    }
    ident := code.slice(idStart, pos);
    loop pos < size {
        c := code.at(pos);
        if c == ")" or c == " " {
            pos += 1;
        } else if c == "." {
            pos += 1;
            if pos >= size or not (code.at(pos).isNameStart() or code.at(pos) == "$") { return ""; }
            loop pos < size and (code.at(pos).isNameContinue() or code.at(pos) == "$") {
                pos += 1;
            }
        } else {
            return "";
        }
    }
    ident
};

/** Resolves a local entry index for an addressable binding or field chain expression `code`, or -1. */
extractAddressableLocal := fn(locals: List<Local>, code: String): Int {
    direct := findLocalIndexByRuntime(locals, code);
    if direct >= 0 { return direct; }
    rootId := extractFieldChainRootIdent(code);
    if rootId == "" { return -1; }
    idx := findLocalIndexByRuntime(locals, rootId);
    if idx >= 0 { return idx; }
    findLocalIndexByRuntime(locals, "(*" + rootId + ")")
};

/** Checks bidirectional aliasing conflict between slice provenance `candProv` / runtime and `mutArgRoots`/`mutArgProvs`. */
checkMutArgAliasSymmetric := fn(candName: String, candRoot: String, candProv: String, mutArgRoots: List<String>, mutArgNames: List<String>, mutArgProvs: List<String>): String {
    effProv := if candProv =!= "" { candProv } else if candRoot =!= "" { "mut_slice:" + candRoot + "#0#" + candName } else { "" };
    hit := sliceBorrows.findMutSliceAliasConflict(effProv, mutArgRoots, mutArgNames, mutArgProvs);
    if hit =!= "" { return hit; }
    if candRoot =!= "" {
        singleRoot: List<String> = [candRoot];
        singleName: List<String> = [candName];
        singleProv: List<String> = [effProv];
        var i := 0;
        loop i < mutArgProvs.length() {
            existingHit := sliceBorrows.findMutSliceAliasConflict(mutArgProvs[i], singleRoot, singleName, singleProv);
            if existingHit =!= "" { return mutArgNames[i]; }
            i += 1;
        }
    }
    ""
};

/** Parses and lowers `[a..b]`, `[..b]`, `[a..]`, `[..]`, `[a..=b]`, `[..=b]` range bounds starting at `[` (`openBracket`). */
parseBracketSliceBounds := fn(target: String, source: String, openBracket: Int, initMarkers: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): (isRange: Bool, hasEnd: Bool, startCode: String, endCode: String, indexStart: Int, closeNext: Int, markers: String) {
    indexStart := syntax.skipTrivia(source, openBracket + 1, prefix);
    var hasSliceEnd := false;
    var sliceStartCode := if target == ir.TARGET_C { "0" } else { "0n" };
    var sliceEndCode := "";
    var sliceCloseNext := indexStart;
    var sliceMarkers := initMarkers;
    if source.startsWithAt(indexStart, "..") {
        isIncSlice := source.startsWithAt(indexStart, "..=");
        afterDots := syntax.skipTrivia(source, indexStart + (if isIncSlice { 3 } else { 2 }), prefix);
        if afterDots < source.length() and source.at(afterDots) == "]" {
            if isIncSlice {
                syntax.failAt(source, afterDots, prefix, "expected end index after ..=");
            }
            sliceCloseNext = afterDots + 1;
        } else {
            endParsed := parseBinaryCtx(target, source, afterDots, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { sliceMarkers = ctx.collectParsedMarkers(sliceMarkers, endParsed); }
            if not numeric.isIntKind(endParsed.kind) {
                syntax.failAt(source, afterDots, prefix, "slice end must be Int, got " + types.displayKind(endParsed.kind));
            }
            hasSliceEnd = true;
            rawEnd := ctx.assignValueCode(target, ir.VALUE_KIND_INT, endParsed.kind, endParsed.code);
            sliceEndCode = if isIncSlice {
                if target == ir.TARGET_C { "((int64_t)(" + rawEnd + ") < 0 ? -1 : ((int64_t)(" + rawEnd + ") + 1))" }
                else { "((lite$se: bigint) => lite$se < 0n ? -1n : lite$se + 1n)(" + rawEnd + ")" }
            } else { rawEnd };
            sliceCloseNext = syntax.expectSymbol(source, syntax.skipTrivia(source, endParsed.next, prefix), "]", prefix);
        }
        return (isRange = true, hasEnd = hasSliceEnd, startCode = sliceStartCode, endCode = sliceEndCode, indexStart = indexStart, closeNext = sliceCloseNext, markers = sliceMarkers);
    }
    index := parseBinaryCtx(target, source, indexStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { sliceMarkers = ctx.collectParsedMarkers(sliceMarkers, index); }
    afterFirst := syntax.skipTrivia(source, index.next, prefix);
    if not source.startsWithAt(afterFirst, "..") {
        return (isRange = false, hasEnd = false, startCode = "", endCode = "", indexStart = indexStart, closeNext = index.next, markers = sliceMarkers);
    }
    if not numeric.isIntKind(index.kind) {
        syntax.failAt(source, indexStart, prefix, "slice start must be Int, got " + types.displayKind(index.kind));
    }
    sliceStartCode = ctx.assignValueCode(target, ir.VALUE_KIND_INT, index.kind, index.code);
    isIncSlice := source.startsWithAt(afterFirst, "..=");
    afterDots := syntax.skipTrivia(source, afterFirst + (if isIncSlice { 3 } else { 2 }), prefix);
    if afterDots < source.length() and source.at(afterDots) == "]" {
        if isIncSlice {
            syntax.failAt(source, afterDots, prefix, "expected end index after ..=");
        }
        sliceCloseNext = afterDots + 1;
    } else {
        endParsed := parseBinaryCtx(target, source, afterDots, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { sliceMarkers = ctx.collectParsedMarkers(sliceMarkers, endParsed); }
        if not numeric.isIntKind(endParsed.kind) {
            syntax.failAt(source, afterDots, prefix, "slice end must be Int, got " + types.displayKind(endParsed.kind));
        }
        hasSliceEnd = true;
        rawEnd := ctx.assignValueCode(target, ir.VALUE_KIND_INT, endParsed.kind, endParsed.code);
        sliceEndCode = if isIncSlice {
            if target == ir.TARGET_C { "((int64_t)(" + rawEnd + ") < 0 ? -1 : ((int64_t)(" + rawEnd + ") + 1))" }
            else { "((lite$se: bigint) => lite$se < 0n ? -1n : lite$se + 1n)(" + rawEnd + ")" }
        } else { rawEnd };
        sliceCloseNext = syntax.expectSymbol(source, syntax.skipTrivia(source, endParsed.next, prefix), "]", prefix);
    }
    (isRange = true, hasEnd = hasSliceEnd, startCode = sliceStartCode, endCode = sliceEndCode, indexStart = indexStart, closeNext = sliceCloseNext, markers = sliceMarkers)
};

/** Emits zero-copy `Slice<T>` code for TS or C11 over an addressable `List<T>`, byte-aligned `[T; N]`, or `Slice<T>`. */
emitZeroCopySliceExpr := fn(target: String, errPos: Int, recvKind: String, recvCode: String, hasEnd: Bool, startCode: String, endCode: String, indexStart: Int, prefix: String, source: String): String {
    elKind := if types.isListKind(recvKind) { types.listElementKind(recvKind) }
    else if types.isArrayKind(recvKind) { types.arrayElementKind(recvKind) }
    else { types.sliceElementKind(recvKind) };
    sliceKind := "Slice<" + elKind + ">";
    if target == ir.TARGET_C {
        sTag := types.cSliceTag(sliceKind);
        if sTag == "" {
            syntax.failAt(source, errPos, prefix, "C backend does not support Slice<" + types.displayKind(elKind) + ">");
        }
        endFlag := if hasEnd { "true" } else { "false" };
        endVal := if hasEnd { endCode } else { "0" };
        if types.isSliceKind(recvKind) {
            return "/*@T:" + sliceKind + "@*/" + sTag + "_sub(" + recvCode + ", " + startCode + ", " + endVal + ", " + endFlag + ", " + indexStart.toText() + ")";
        }
        if types.isArrayKind(recvKind) and types.cArrayTag(recvKind) =!= "" {
            ext := types.arrayExtent(recvKind);
            if numeric.isSubByteIntKind(elKind) {
                return "/*@T:" + sliceKind + "@*/" + sTag + "_from_packed((uint8_t *)(uintptr_t)((" + recvCode + ").data), " + ext.toText() + ", " + startCode + ", " + endVal + ", " + endFlag + ", " + indexStart.toText() + ")";
            }
            cElem := types.cValueType(elKind);
            return "/*@T:" + sliceKind + "@*/" + sTag + "_from_raw((" + cElem + " *)(uintptr_t)((" + recvCode + ").data), " + ext.toText() + ", " + startCode + ", " + endVal + ", " + endFlag + ", " + indexStart.toText() + ")";
        }
        return "/*@T:" + sliceKind + "@*/" + sTag + "_from_list(&(" + recvCode + "), " + startCode + ", " + endVal + ", " + endFlag + ", " + indexStart.toText() + ")";
    }
    endArg := if hasEnd { endCode } else { "-1n" };
    hasEndArg := if hasEnd { "true" } else { "false" };
    if types.isSliceKind(recvKind) {
        return "lite$sliceSub(" + recvCode + ", " + startCode + ", " + endArg + ", " + hasEndArg + ", " + indexStart.toText() + ")";
    }
    "lite$sliceFrom(" + recvCode + ", " + startCode + ", " + endArg + ", " + hasEndArg + ", " + indexStart.toText() + ")"
};

/** True when calling `calleeRuntime` could directly or transitively mutate a module-level `mut` binding. */
calleeCanMutateGlobals := fn(isModuleFn: Bool, calleeRuntime: String, calleeCtxKind: String): Bool {
    if not isModuleFn { return true; }
    if calleeCtxKind =!= "" { return true; }
    if calleeRuntime.startsWithAt(0, "$gen:") {
        tIdx := generics.findTemplate(calleeRuntime.slice(5, calleeRuntime.length()));
        if tIdx < 0 { return true; }
        return contexts.moduleHasMutGlobals(generics.getTemplate(tIdx).moduleKey);
    }
    contexts.runtimeHasMutGlobals(calleeRuntime)
};

/** True when passing `argCode` to a read-only parameter requires a snapshot (C11 CoW RC bump or TS clone) to guard against aliasing or mutation during the call. */
readOnlyArgNeedsSnapshot := fn(argCode: String, locals: List<Local>, mutArgRuntimes: List<String>, hasClosureHazard: Bool, calleeMutGlobalHazard: Bool): Bool {
    var locIdx := findLocalIndexByRuntime(locals, argCode);
    if locIdx < 0 {
        rootIdent := extractFieldChainRootIdent(argCode);
        if rootIdent =!= "" {
            locIdx = findLocalIndexByRuntime(locals, rootIdent);
            if locIdx < 0 {
                locIdx = findLocalIndexByRuntime(locals, "(*" + rootIdent + ")");
            }
        }
    }
    if locIdx < 0 { return true; }
    loc := locals[locIdx];
    if not loc.writable { return false; }
    if loc.depth <= 0 { return true; }
    if loc.code == loc.runtime and calleeMutGlobalHazard { return true; }
    if mutArgRuntimes.contains(loc.runtime) { return true; }
    selfIdx := sym.localIndex(locals, "$self");
    if selfIdx >= 0 and loc.depth < locals[selfIdx].depth { return true; }
    if hasClosureHazard { return true; }
    false
};

/** Builds a structural TS writeback assignment statement updating nested field `fieldPathCsv` inside `rootRt`. */
tsFieldWritebackStmt := fn(rootRt: String, fieldPathCsv: String, valueExpr: String): String {
    fields := fieldPathCsv.split(".");
    var mut prefixes: List<String> = [rootRt];
    var i := 0;
    loop i + 1 < fields.length() {
        mut prefixes.pushBack("(" + prefixes[i] + ")." + fields[i]);
        i += 1;
    }
    var acc := valueExpr;
    var j := fields.length() - 1;
    loop j >= 0 {
        acc = "{ ...(" + prefixes[j] + "), " + fields[j] + ": " + acc + " }";
        j -= 1;
    }
    rootRt + " = " + acc + ";"
};

/** Resolves TS/C concrete method runtime for one impl binding, instantiating generic `$gen:` impl templates when needed. */
resolveImplBindingRuntime := fn(target: String, source: String, errPos: Int, prefix: String, implDef: interfaces.ImplDef, bindingsEnc: String, methodName: String, functions: List<FunctionInfo>): String {
    mb := interfaces.findBindingInImpl(implDef, methodName);
    if not mb.found {
        syntax.failAt(source, errPos, prefix, "internal error: missing impl method binding " + methodName);
    }
    findFnByKey := fn(fns: List<FunctionInfo>, key: String): Int {
        if key.startsWithAt(0, "$rt:") {
            sym.findFunctionByRuntime(fns, key.slice(4, key.length()))
        } else {
            sym.findFunction(fns, key)
        }
    };
    fnIdx := findFnByKey(functions, mb.binding.fnKey);
    if fnIdx < 0 {
        syntax.failAt(source, errPos, prefix, "internal error: missing function entry " + mb.binding.fnKey);
    }
    fInfo := functions[fnIdx];
    if not fInfo.runtime.startsWithAt(0, "$gen:") {
        return fInfo.runtime;
    }
    tplKey := fInfo.runtime.slice(5, fInfo.runtime.length());
    tplIdx := generics.findTemplate(tplKey);
    if tplIdx < 0 {
        syntax.failAt(source, errPos, prefix, "internal error: missing generic impl template " + tplKey);
    }
    tpl := generics.getTemplate(tplIdx);
    bMap := types.decodeImplBindings(bindingsEnc);
    effRes := generics.substKind(tpl.genericParams, tpl.result, bMap);
    mut allSubstParts: List<String> = [];
    loop generics.splitPipeEntries(tpl.params, tpl.paramCount) as tpEntry {
        tpName := types.paramNameOf(tpEntry);
        tpRaw := types.paramKindOf(tpEntry);
        tpIsMut := tpRaw.startsWithAt(0, "mut ");
        tpBase := if tpIsMut { tpRaw.slice(4, tpRaw.length()) } else { tpRaw };
        tpConc := generics.substKind(tpl.genericParams, tpBase, bMap);
        valErr := generics.validateSubstitutedKind(tpConc);
        if valErr =!= "" {
            syntax.failAt(source, errPos, prefix, valErr);
        }
        mut allSubstParts.pushBack(tpName + "=" + (if tpIsMut { "mut " } else { "" }) + tpConc);
    }
    enc := generics.encodeBindings(tpl.genericParams, bMap);
    generics.requestInstance(target, tplKey, enc, allSubstParts.join("|"), effRes)
};

/** Coerces a concrete value or existing `Dyn<I>` into `expectedKind` (`Dyn<Iface>`), returning matched/code/provenance and queueing any C temporary post-drops. */
pub coerceToDynIfNeeded := fn(target: String, source: String, errPos: Int, prefix: String, expectedKind: String, expectedWritable: Bool, rhsKind: String, rhsCode: String, rhsTextValue: String, allowOwningRval: Bool, locals: List<Local>, functions: List<FunctionInfo>, postDrops: mut List<String>): (matched: Bool, code: String, textValue: String) {
    if not types.isDynKind(expectedKind) {
        return (matched = false, code = rhsCode, textValue = rhsTextValue);
    }
    if rhsKind == expectedKind {
        var prov := rhsTextValue;
        if expectedWritable {
            if not prov.startsWithAt(0, "mut_dyn:") and not prov.startsWithAt(0, "borrow_mut:") {
                syntax.failAt(source, errPos, prefix, "mut dyn Interface requires explicit mut source");
            }
        } else if prov.startsWithAt(0, "ro_slice:") {
            prov = "ro_dyn:" + prov.slice(9, prov.length());
        } else if prov.startsWithAt(0, "mut_slice:") {
            prov = "mut_dyn:" + prov.slice(10, prov.length());
        }
        return (matched = true, code = rhsCode, textValue = prov);
    }
    if types.isDynKind(rhsKind) or rhsKind == ir.VALUE_KIND_NEVER {
        return (matched = false, code = rhsCode, textValue = rhsTextValue);
    }
    ifaceKind := types.dynInterfaceKind(expectedKind);
    imp := types.findImplForConcrete(rhsKind, ifaceKind);
    if not imp.found {
        return (matched = false, code = rhsCode, textValue = rhsTextValue);
    }
    if expectedWritable and not rhsTextValue.startsWithAt(0, "mut_dyn:") {
        syntax.failAt(source, errPos, prefix, "mut dyn Interface requires explicit mut source");
    }
    var prov := rhsTextValue;
    if not prov.startsWithAt(0, "mut_dyn:") {
        lIdx := extractAddressableLocal(locals, rhsCode);
        if lIdx >= 0 {
            loc := locals[lIdx];
            prov = "ro_dyn:" + loc.runtime + "#" + loc.depth.toText() + "#" + loc.name;
        } else {
            if not allowOwningRval and types.cDropFnForKind(rhsKind) =!= "" {
                syntax.failAt(source, errPos, prefix, "cannot borrow temporary value into dyn binding; bind the owner to a local variable first");
            }
            prov = "dyn_rval:";
        }
    }
    implDef := interfaces.getImpl(imp.implIdx);
    methods := types.instantiatedInterfaceMethods(ifaceKind);
    if target == ir.TARGET_TS {
        tsConcrete := types.tsFunctionType(rhsKind);
        dataExpr := if expectedWritable and types.isRecordOrDistinctRecord(rhsKind) {
            if rhsCode.endsWith(".v") {
                rhsCode.slice(0, rhsCode.length() - 2)
            } else {
                "{ get v(): " + tsConcrete + " { return " + rhsCode + "; }, set v(lite$nv: " + tsConcrete + ") { " + rhsCode + " = lite$nv; } }"
            }
        } else {
            "{ v: (" + rhsCode + ") }"
        };
        mut vtFields: List<String> = [];
        loop methods as m {
            fnRt := resolveImplBindingRuntime(target, source, errPos, prefix, implDef, imp.bindingsEncoded, m.name, functions);
            mut tParams: List<String> = ["lite$ds: { v: unknown }"];
            mut callArgs: List<String> = [];
            if m.recvMut and types.isRecordOrDistinctRecord(rhsKind) {
                mut callArgs.pushBack("(lite$ds as { v: " + tsConcrete + " })");
            } else {
                mut callArgs.pushBack("(lite$ds.v as " + tsConcrete + ")");
            }
            if m.paramCount > 0 {
                var pStart := 0;
                pLen := m.params.length();
                var pIdx := 0;
                loop pStart <= pLen {
                    bar := m.params.indexOf("|", pStart);
                    pEnd := if bar < 0 { pLen } else { bar };
                    entry := m.params.slice(pStart, pEnd);
                    eq := entry.indexOf("=", 0);
                    if eq > 0 {
                        rawPK := entry.slice(eq + 1, entry.length());
                        pMut := rawPK.startsWithAt(0, "mut ");
                        pKind := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                        pTs := if pMut and types.isRecordOrDistinctRecord(pKind) { "{ v: " + types.tsFunctionType(pKind) + " }" } else { types.tsFunctionType(pKind) };
                        aName := "a" + pIdx.toText();
                        mut tParams.pushBack(aName + ": " + pTs);
                        mut callArgs.pushBack(aName);
                        pIdx = pIdx + 1;
                    }
                    if bar < 0 { break; }
                    pStart = bar + 1;
                }
            }
            retTs := types.tsFunctionType(m.result);
            mut vtFields.pushBack(m.name + ": (" + tParams.join(", ") + "): " + retTs + " => " + fnRt + "(" + callArgs.join(", ") + ")");
        }
        vtCode := if vtFields.length() == 0 { "{}" } else { "{ " + vtFields.join(", ") + " }" };
        return (matched = true, code = "({ data: " + dataExpr + ", vt: " + vtCode + " })", textValue = prov);
    }
    dynTag := types.cDynTag(expectedKind);
    vtTag := types.cVtableTag(expectedKind);
    vtblSym := types.cVtableInstanceSym(expectedKind, rhsKind, implDef.key);
    cConcrete := types.cValueType(rhsKind);
    mut cTrampBuf: tb.TextBuilder;
    mut vtInits: List<String> = [];
    loop methods as m {
        fnRt := resolveImplBindingRuntime(target, source, errPos, prefix, implDef, imp.bindingsEncoded, m.name, functions);
        mCField := types.cFieldName(m.name);
        tName := vtblSym + "_" + mCField;
        mut vtInits.pushBack("." + mCField + " = " + tName);
        retC := types.cValueType(m.result);
        mut tParams: List<String> = ["void *lite_ds"];
        var recvExpr := "";
        if m.recvMut and not types.isSliceKind(rhsKind) and not types.isDynKind(rhsKind) {
            recvExpr = "(" + cConcrete + " *)lite_ds";
        } else if not m.recvMut and types.cParamIsConstPtr(rhsKind) {
            recvExpr = "(const " + cConcrete + " *)lite_ds";
        } else {
            recvExpr = "(*((const " + cConcrete + " *)lite_ds))";
        }
        mut callArgs: List<String> = [recvExpr];
        if m.paramCount > 0 {
            var pStart := 0;
            pLen := m.params.length();
            var pIdx := 0;
            loop pStart <= pLen {
                bar := m.params.indexOf("|", pStart);
                pEnd := if bar < 0 { pLen } else { bar };
                entry := m.params.slice(pStart, pEnd);
                eq := entry.indexOf("=", 0);
                if eq > 0 {
                    rawPK := entry.slice(eq + 1, entry.length());
                    pMut := rawPK.startsWithAt(0, "mut ");
                    pKind := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                    pC := types.cValueType(pKind);
                    isBorrow := types.isSliceKind(pKind) or types.isDynKind(pKind);
                    pSigC := if pMut and not isBorrow { pC + " *" }
                    else if not pMut and types.cParamIsConstPtr(pKind) { "const " + pC + " *" }
                    else { pC };
                    aName := "a" + pIdx.toText();
                    mut tParams.pushBack(pSigC + " " + aName);
                    mut callArgs.pushBack(aName);
                    pIdx = pIdx + 1;
                }
                if bar < 0 { break; }
                pStart = bar + 1;
            }
        }
        mut cTrampBuf.append("static ");
        mut cTrampBuf.append(retC);
        mut cTrampBuf.append(" ");
        mut cTrampBuf.append(tName);
        mut cTrampBuf.append("(");
        mut cTrampBuf.append(tParams.join(", "));
        mut cTrampBuf.append(") { ");
        if retC =!= "void" { mut cTrampBuf.append("return "); }
        mut cTrampBuf.append(fnRt);
        mut cTrampBuf.append("(");
        mut cTrampBuf.append(callArgs.join(", "));
        mut cTrampBuf.append("); }\n");
    }
    mut cTrampBuf.append("static const ");
    mut cTrampBuf.append(vtTag);
    mut cTrampBuf.append(" ");
    mut cTrampBuf.append(vtblSym);
    mut cTrampBuf.append(" = { ");
    mut cTrampBuf.append(if vtInits.length() == 0 { "0" } else { vtInits.join(", ") });
    mut cTrampBuf.append(" };");
    hoisted := "/*@CFN_START:" + vtblSym + "@*/" + cTrampBuf.build() + "/*@CFN_END@*/";
    b := cBorrowExprWithPostDrop(rhsKind, rhsCode, true);
    if b.drop =!= "" { mut postDrops.pushBack(b.drop); }
    dynExpr := "/*@T:" + expectedKind + "@*/" + hoisted + "((" + dynTag + "){ .data = (void *)(" + b.expr + "), .vt = &" + vtblSym + " })";
    (matched = true, code = dynExpr, textValue = prov)
};

/** Parses and lowers dynamic interface dispatch `d.method(args)` / `mut d.method(args)` through the `Dyn<Iface>` fat-pointer vtable. */
parseDynMethodDotCall := fn(target: String, source: String, labelStart: Int, openParen: Int, receiver: Parsed, recvLocalIdx: Int, opLabel: String, explicitMut: Bool, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    ifaceKind := types.dynInterfaceKind(receiver.kind);
    methods := types.instantiatedInterfaceMethods(ifaceKind);
    var mIdx := -1;
    var i := 0;
    loop i < methods.length() {
        if methods[i].name == opLabel {
            mIdx = i;
            break;
        }
        i = i + 1;
    }
    if mIdx < 0 {
        syntax.failAt(source, labelStart, prefix, "interface " + types.displayKind(ifaceKind) + " has no method " + opLabel);
    }
    m := methods[mIdx];
    if m.recvMut and explicitMut {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating method " + opLabel + " on read-only dyn binding");
        }
    }
    if m.recvMut and not explicitMut {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating method " + opLabel + " on read-only dyn binding");
        }
        syntax.failAt(source, labelStart, prefix, "mutating method " + types.displayKind(ifaceKind) + "." + opLabel + " requires mut at call site");
    }
    if not m.recvMut and explicitMut {
        syntax.failAt(source, labelStart, prefix, "method " + types.displayKind(ifaceKind) + "." + opLabel + " does not mutate its receiver; remove mut");
    }
    emptyReqs: List<String> = [];
    reqEntries := if m.paramCount > 0 { generics.splitPipeEntries(m.params, m.paramCount) } else { emptyReqs };
    argIifeDepth := if target == ir.TARGET_TS { iifeDepth + 1 } else { iifeDepth };
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    var callMarkers := "";
    mut argKinds: List<String> = [];
    mut argCodes: List<String> = [];
    var ai := 0;
    mut postCallDrops: List<String> = [];
    mut preBlkStmts: List<String> = [];
    mut mutRecBoxNames: List<String> = [];
    mut mutRecLocalRuntimes: List<String> = [];
    mut mutRecKinds: List<String> = [];
    if cursor < size and source.at(cursor) =!= ")" {
        loop true {
            if ai >= m.paramCount {
                syntax.failAt(source, cursor, prefix, "method " + types.displayKind(ifaceKind) + "." + opLabel + " expects " + m.paramCount.toText() + " argument(s), got more");
            }
            expRaw := types.paramKindOf(reqEntries[ai]);
            isMutExp := expRaw.startsWithAt(0, "mut ");
            expBase := if isMutExp { expRaw.slice(4, expRaw.length()) } else { expRaw };
            if isMutExp {
                lease := tryParseGroupedMutLease(source, cursor, prefix, false);
                if not lease.matched {
                    syntax.failAt(source, cursor, prefix, "argument " + (ai + 1).toText() + " of " + opLabel + " requires mut argument");
                }
                mRawName := source.slice(lease.nameStart, lease.nameEnd);
                mLeaseRes := resolveMutLeaseLocal(locals, ctxs, mRawName, source, lease.nameStart, prefix);
                mName := mLeaseRes.displayName;
                mLocIdx := mLeaseRes.idx;
                mEntry := locals[mLocIdx];
                if not types.isMutContainerKind(mEntry.kind) or not mEntry.writable {
                    syntax.failAt(source, lease.nameStart, prefix, "cannot pass non-mut binding " + mName + " as mut");
                }
                sliceBorrows.checkCanMutateBinding(locals, mEntry.runtime, mName, source, lease.nameStart, prefix);
                mProv := "mut_dyn:" + mEntry.runtime + "#" + mEntry.depth.toText() + "#" + mName;
                dynCheck := coerceToDynIfNeeded(target, source, lease.nameStart, prefix, expBase, true, mEntry.kind, mEntry.runtime, mProv, true, locals, functions, mut postCallDrops);
                var finCode := mEntry.runtime;
                if dynCheck.matched {
                    finCode = dynCheck.code;
                } else {
                    if not types.isCompatibleKind(expBase, mEntry.kind) {
                        syntax.failAt(source, lease.nameStart, prefix, "argument " + (ai + 1).toText() + " of " + opLabel + " must be mut " + types.displayKind(expBase) + ", got mut " + types.displayKind(mEntry.kind));
                    }
                    if target == ir.TARGET_C and not types.isSliceKind(mEntry.kind) and not types.isDynKind(mEntry.kind) {
                        finCode = "&" + mEntry.runtime;
                    } else if target == ir.TARGET_TS and types.isRecordOrDistinctRecord(mEntry.kind) {
                        if mEntry.runtime.endsWith(".v") {
                            finCode = mEntry.runtime.slice(0, mEntry.runtime.length() - 2);
                        } else {
                            boxN := "lite$mb" + mutRecBoxNames.length().toText();
                            mut mutRecBoxNames.pushBack(boxN);
                            mut mutRecLocalRuntimes.pushBack(mEntry.runtime);
                            mut mutRecKinds.pushBack(mEntry.kind);
                            finCode = boxN;
                        }
                    }
                }
                mut argKinds.pushBack(expRaw);
                mut argCodes.pushBack(finCode);
                cursor = syntax.skipTrivia(source, lease.next, prefix);
            } else {
                arg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, expBase, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                dynCheck := coerceToDynIfNeeded(target, source, cursor, prefix, expBase, false, arg.kind, arg.code, arg.textValue, true, locals, functions, mut postCallDrops);
                var rawCode := arg.code;
                if dynCheck.matched {
                    rawCode = dynCheck.code;
                } else {
                    if not types.isCompatibleKind(expBase, arg.kind) {
                        syntax.failAt(source, cursor, prefix, "argument " + (ai + 1).toText() + " of " + opLabel + " must be " + types.displayKind(expBase) + ", got " + types.displayKind(arg.kind));
                    }
                    rawCode = ctx.assignValueCode(target, expBase, arg.kind, arg.code);
                }
                if target == ir.TARGET_C {
                    mut argCodes.pushBack(prepCCallArg(true, "", expBase, rawCode, mut preBlkStmts, mut postCallDrops));
                } else {
                    mut argCodes.pushBack(rawCode);
                }
                mut argKinds.pushBack(expBase);
                cursor = syntax.skipTrivia(source, arg.next, prefix);
            }
            ai = ai + 1;
            if cursor < size and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor < size and source.at(cursor) == ")" { break; }
            } else {
                break;
            }
        }
    }
    if ai =!= m.paramCount {
        syntax.failAt(source, openParen, prefix, "method " + types.displayKind(ifaceKind) + "." + opLabel + " expects " + m.paramCount.toText() + " argument(s), got " + ai.toText());
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    if target == ir.TARGET_TS {
        allCallArgs := if argCodes.length() > 0 { ", " + argCodes.join(", ") } else { "" };
        var tsCall := if isCBorrowableLvalue(receiver.code) {
            "(" + receiver.code + ").vt." + m.name + "((" + receiver.code + ").data" + allCallArgs + ")"
        } else {
            "((lite$dr: " + types.tsFunctionType(receiver.kind) + "): " + types.tsFunctionType(m.result) + " => lite$dr.vt." + m.name + "(lite$dr.data" + allCallArgs + "))(" + receiver.code + ")"
        };
        if mutRecBoxNames.length() > 0 {
            mut wbSetup: List<String> = [];
            var bi := 0;
            loop bi < mutRecBoxNames.length() {
                bN := mutRecBoxNames[bi];
                bL := mutRecLocalRuntimes[bi];
                bT := types.tsFunctionType(mutRecKinds[bi]);
                mut wbSetup.pushBack("const " + bN + ": { v: " + bT + " } = { get v(): " + bT + " { return " + bL + "; }, set v(lite$nv: " + bT + ") { " + bL + " = lite$nv; } };");
                bi = bi + 1;
            }
            tsCall = if m.result == ir.VALUE_KIND_UNIT {
                "(() => { " + wbSetup.join(" ") + " void (" + tsCall + "); return undefined; })()"
            } else {
                "(((): " + types.tsFunctionType(m.result) + " => { " + wbSetup.join(" ") + " return " + tsCall + "; })())"
            };
        }
        return ctx.withMarkers((kind = m.result, code = tsCall, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers);
    }
    cField := types.cFieldName(m.name);
    allCArgs := if argCodes.length() > 0 { ", " + argCodes.join(", ") } else { "" };
    var rawCCall := "";
    if isCBorrowableLvalue(receiver.code) {
        rawCCall = "(" + receiver.code + ".vt->" + cField + "(" + receiver.code + ".data" + allCArgs + "))";
    } else {
        dt := freshCOwnedTemp("lt_dr_");
        cDt := types.cValueType(receiver.kind);
        mut preBlkStmts.pushBack("/*@LTMP:" + cDt + ":" + dt + "@*/" + dt + " = (" + receiver.code + ");");
        rawCCall = "(" + dt + ".vt->" + cField + "(" + dt + ".data" + allCArgs + "))";
    }
    cEmitted := if preBlkStmts.length() > 0 {
        dropsStmt := if postCallDrops.length() > 0 { postCallDrops.join("; ") + "; " } else { "" };
        if m.result == ir.VALUE_KIND_UNIT or m.result == ir.VALUE_KIND_NEVER {
            "/*@CBLK:0@*/{ " + preBlkStmts.join(" ") + " (void)(" + rawCCall + "); " + dropsStmt + "}"
        } else {
            cRv := freshCOwnedTemp("lt_or_");
            cRt := types.cValueType(m.result);
            "/*@CBLK:" + cRv + "@*/" + cRt + " " + cRv + "; { " + preBlkStmts.join(" ") + " " + cRv + " = (" + rawCCall + "); " + dropsStmt + "}"
        }
    } else if postCallDrops.length() > 0 {
        cWrapExprWithPostDrops(m.result, rawCCall, postCallDrops)
    } else {
        rawCCall
    };
    ctx.withMarkers((kind = m.result, code = cEmitted, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers)
};

/** Extracts a canonical root variable runtime from a context slot runtime expression for exclusivity checks. */
ctxSlotCanonRoot := fn(rt: String): String {
    if rt.startsWithAt(0, "(*(") and rt.endsWith("))") { return rt.slice(3, rt.length() - 2); }
    if rt.startsWithAt(0, "(*") and rt.endsWith(")") { return rt.slice(2, rt.length() - 1); }
    if rt.endsWith(".v") { return rt.slice(0, rt.length() - 2); }
    rt
};

/** Resolves all slots in `ctxKind` from lexical overrides, enclosing params, or ambient defaults, validates exclusivity & types, and lowers the projection arg. */
buildContextProjectionArg := fn(target: String, source: String, errPos: Int, prefix: String, calleeDisplay: String,
ctxKind: String, locals: List<Local>, functions: List<FunctionInfo>,
mutArgRoots: List<String>, mutArgNames: List<String>, mutArgProvs: List<String>,
entryCount: Int, entryPositions: List<Int>, entryKinds: List<String>, entryCodes: List<String>, entryProvs: List<String>,
postDrops: mut List<String>): String {
    if ctxKind == "" { return ""; }
    slots := contexts.parseCtxKindSlots(ctxKind);
    if slots.length() == 0 { return ""; }
    hasCanonRoot := fn(xs: List<String>, raw: String, canon: String): Bool {
        loop xs as x {
            if x == raw or x == canon or ctxSlotCanonRoot(x) == canon { return true; }
        }
        false
    };
    mut ctxMutRts: List<String> = [];
    mut ctxMutNames: List<String> = [];
    mut ctxMutProvs: List<String> = [];
    mut slotInits: List<String> = [];
    loop slots as cs {
        var foundProv := false;
        var isAmbient := false;
        var provKind := "";
        var backingKind := "";
        var provRt := "";
        var provWritable := false;
        var provText := "";
        var provImplKey := "";
        slotIdx := sym.localIndex(locals, "$ctxslot:" + cs.name);
        if slotIdx >= 0 and locals[slotIdx].depth >= -1 {
            sLoc := locals[slotIdx];
            if sLoc.textValue == "ctx_closure_forbidden" or sLoc.textValue == "closure_forbidden" {
                syntax.failAt(source, errPos, prefix, "cannot capture borrowed or mut context '" + cs.name + "' in a closure; declare context(...) on the closure instead");
            }
            foundProv = true;
            provKind = sLoc.kind;
            backingKind = sLoc.kind;
            provRt = sLoc.runtime;
            provWritable = sLoc.writable;
            provText = sLoc.textValue;
        } else {
            amb := contexts.findAmbient(cs.name);
            if amb.found {
                foundProv = true;
                isAmbient = true;
                provKind = amb.entry.slotKind;
                backingKind = amb.entry.backingKind;
                provRt = amb.entry.runtime;
                provWritable = amb.entry.isMut;
                provImplKey = amb.entry.implKey;
            }
        }
        if not foundProv {
            syntax.failAt(source, errPos, prefix, "missing context " + cs.name + ": " + types.displayKind(cs.kind) + " in call to " + calleeDisplay);
        }
        if cs.isMut and not provWritable {
            syntax.failAt(source, errPos, prefix, "context " + cs.name + " requires mut access in call to " + calleeDisplay);
        }
        canonRt := ctxSlotCanonRoot(provRt);
        if not isAmbient {
            if cs.isMut {
                aliasHit := checkMutArgAliasSymmetric(cs.name, canonRt, provText, mutArgRoots, mutArgNames, mutArgProvs);
                ctxAliasHit := checkMutArgAliasSymmetric(cs.name, canonRt, provText, ctxMutRts, ctxMutNames, ctxMutProvs);
                if aliasHit =!= "" or ctxAliasHit =!= "" or hasCanonRoot(mutArgRoots, provRt, canonRt) or hasCanonRoot(ctxMutRts, provRt, canonRt) {
                    syntax.failAt(source, errPos, prefix, "cannot pass " + cs.name + " multiple times as mut in the same call");
                }
                var ei := 0;
                loop ei < entryCount {
                    if not entryKinds[ei].startsWithAt(0, "mut ") {
                        roCanon := extractAddressableLocal(locals, entryCodes[ei]);
                        roRt := if roCanon >= 0 { locals[roCanon].runtime } else { "" };
                        if (roRt =!= "" and (roRt == provRt or ctxSlotCanonRoot(roRt) == canonRt)) or
                        findMutAliasConflictName(entryCodes[ei], entryKinds[ei], [canonRt, provRt], [cs.name]) =!= "" or
                        checkMutArgAliasSymmetric(if roCanon >= 0 { locals[roCanon].name } else { "" }, roRt, entryProvs[ei], [canonRt, provRt], [cs.name], [provText]) =!= "" {
                            syntax.failAt(source, entryPositions[ei], prefix, "cannot pass " + cs.name + " as both read-only and mut in the same call");
                        }
                    }
                    ei = ei + 1;
                }
                mut ctxMutRts.pushBack(canonRt);
                mut ctxMutNames.pushBack(cs.name);
                mut ctxMutProvs.pushBack(provText);
            } else {
                aliasHit := checkMutArgAliasSymmetric(cs.name, canonRt, provText, mutArgRoots, mutArgNames, mutArgProvs);
                ctxAliasHit := checkMutArgAliasSymmetric(cs.name, canonRt, provText, ctxMutRts, ctxMutNames, ctxMutProvs);
                if aliasHit =!= "" or ctxAliasHit =!= "" or hasCanonRoot(mutArgRoots, provRt, canonRt) or hasCanonRoot(ctxMutRts, provRt, canonRt) {
                    syntax.failAt(source, errPos, prefix, "cannot pass " + cs.name + " as both read-only and mut in the same call");
                }
            }
        }
        var fieldValCode := "";
        isAmbDynBacking := isAmbient and types.isDynKind(cs.kind) and provImplKey =!= "" and types.isDynKind(provKind) and types.isCompatibleKind(cs.kind, provKind);
        isConcreteDyn := types.isDynKind(cs.kind) and not types.isDynKind(provKind) and types.findImplForConcrete(provKind, types.dynInterfaceKind(cs.kind)).found;
        if isAmbDynBacking or isConcreteDyn {
            srcConcreteKind := if isAmbDynBacking { backingKind } else { provKind };
            srcProv := if cs.isMut { "mut_dyn:" } else { provText };
            coercedDyn := coerceToDynIfNeeded(target, source, errPos, prefix, cs.kind, cs.isMut, srcConcreteKind, provRt, srcProv, true, locals, functions, mut postDrops);
            fieldValCode = coercedDyn.code;
        } else if types.isCompatibleKind(cs.kind, provKind) {
            if target == ir.TARGET_C {
                if types.isSliceKind(cs.kind) or types.isDynKind(cs.kind) {
                    fieldValCode = provRt;
                } else if cs.isMut or types.cParamIsConstPtr(cs.kind) {
                    ptrExpr := if provRt.startsWithAt(0, "(*(") and provRt.endsWith("))") {
                        provRt.slice(3, provRt.length() - 2)
                    } else if provRt.startsWithAt(0, "(*") and provRt.endsWith(")") {
                        provRt.slice(2, provRt.length() - 1)
                    } else {
                        "&(" + provRt + ")"
                    };
                    fieldValCode = ptrExpr;
                } else {
                    fieldValCode = ctx.assignValueCode(target, cs.kind, provKind, provRt);
                }
            } else {
                if cs.isMut and not types.isDynKind(cs.kind) and not types.isSliceKind(cs.kind) {
                    if provRt.endsWith(".v") {
                        fieldValCode = provRt.slice(0, provRt.length() - 2);
                    } else {
                        tsT := types.tsFunctionType(cs.kind);
                        fieldValCode = "{ get v(): " + tsT + " { return " + provRt + "; }, set v(lite$nv: " + tsT + ") { " + provRt + " = lite$nv; } }";
                    }
                } else {
                    fieldValCode = ctx.assignValueCode(target, cs.kind, provKind, provRt);
                }
            }
        } else {
            syntax.failAt(source, errPos, prefix, "context " + cs.name + " type mismatch in call to " + calleeDisplay + ": expected " + types.displayKind(cs.kind) + ", got " + types.displayKind(provKind));
        }
        if target == ir.TARGET_C {
            mut slotInits.pushBack(".slot_" + ir.safeTargetIdent(ir.TARGET_C, cs.name) + " = " + fieldValCode);
        } else {
            mut slotInits.pushBack(cs.name + ": " + fieldValCode);
        }
    }
    if target == ir.TARGET_C {
        return "/*@T:" + ctxKind + "@*/(&(const " + types.cCtxTag(ctxKind) + "){ " + slotInits.join(", ") + " })";
    }
    "{ " + slotInits.join(", ") + " }"
};

/** Builds a C11 compound initializer `{ .slot_x = ... }` when every context slot in `ctxKind` has a compatible ambient default. */
pub tryBuildAmbientCtxDefaultInit := fn(source: String, errPos: Int, prefix: String, ctxKind: String, locals: List<Local>, functions: List<FunctionInfo>): String {
    if ctxKind == "" { return ""; }
    slots := contexts.parseCtxKindSlots(ctxKind);
    if slots.length() == 0 { return ""; }
    mut slotInits: List<String> = [];
    loop slots as cs {
        amb := contexts.findAmbient(cs.name);
        if not amb.found { return ""; }
        if cs.isMut and not amb.entry.isMut { return ""; }
        provKind := amb.entry.slotKind;
        backingKind := amb.entry.backingKind;
        provRt := amb.entry.runtime;
        provImplKey := amb.entry.implKey;
        var fieldValCode := "";
        isAmbDynBacking := types.isDynKind(cs.kind) and provImplKey =!= "" and types.isDynKind(provKind) and types.isCompatibleKind(cs.kind, provKind);
        isConcreteDyn := types.isDynKind(cs.kind) and not types.isDynKind(provKind) and types.findImplForConcrete(provKind, types.dynInterfaceKind(cs.kind)).found;
        if isAmbDynBacking or isConcreteDyn {
            srcConcreteKind := if isAmbDynBacking { backingKind } else { provKind };
            srcProv := if cs.isMut { "mut_dyn:" } else { "" };
            mut dummyPostDrops: List<String> = [];
            coercedDyn := coerceToDynIfNeeded(ir.TARGET_C, source, errPos, prefix, cs.kind, cs.isMut, srcConcreteKind, provRt, srcProv, true, locals, functions, mut dummyPostDrops);
            if not coercedDyn.matched or dummyPostDrops.length() > 0 { return ""; }
            fieldValCode = coercedDyn.code;
        } else if types.isCompatibleKind(cs.kind, provKind) {
            if types.isSliceKind(cs.kind) or types.isDynKind(cs.kind) {
                fieldValCode = provRt;
            } else if cs.isMut or types.cParamIsConstPtr(cs.kind) {
                ptrExpr := if provRt.startsWithAt(0, "(*(") and provRt.endsWith("))") {
                    provRt.slice(3, provRt.length() - 2)
                } else if provRt.startsWithAt(0, "(*") and provRt.endsWith(")") {
                    provRt.slice(2, provRt.length() - 1)
                } else {
                    "&(" + provRt + ")"
                };
                fieldValCode = ptrExpr;
            } else {
                fieldValCode = ctx.assignValueCode(ir.TARGET_C, cs.kind, provKind, provRt);
            }
        } else {
            return "";
        }
        mut slotInits.pushBack(".slot_" + ir.safeTargetIdent(ir.TARGET_C, cs.name) + " = " + fieldValCode);
    }
    "{ " + slotInits.join(", ") + " }"
};

/** Pre-scanned call-site argument metadata reused across overload candidates without mutating compiler state. */
OverloadCallArg := record {
    pos: Int;
    rhsStart: Int;
    label: String;
    isMut: Bool;
    isShorthand: Bool;
    isContextual: Bool;
    isUnsuffixedInt: Bool;
    isUnsuffixedFloat: Bool;
    natOk: Bool;
    natKind: String;
    next: Int;
};

/** Evaluates whether raw slice text is an unsuffixed integer literal (`42`, `-7`, `0xff`, `1_000`) or unsuffixed float literal (`3.14`). */
classifyNumericLiteralText := fn(raw: String): (isInt: Bool, isFloat: Bool) {
    t := raw.trim();
    if t == "" { return (isInt = false, isFloat = false); }
    if t.endsWith("i8") or t.endsWith("i16") or t.endsWith("i32") or t.endsWith("i64") or
    t.endsWith("u8") or t.endsWith("u16") or t.endsWith("u32") or t.endsWith("u64") or
    t.endsWith("f8") or t.endsWith("f16") or t.endsWith("f32") or t.endsWith("f64") {
        return (isInt = false, isFloat = false);
    }
    var cur := 0;
    n := t.length();
    if t.at(cur) == "-" or t.at(cur) == "+" {
        cur = cur + 1;
        loop cur < n and (t.at(cur) == " " or t.at(cur) == "\t") { cur = cur + 1; }
    }
    if cur >= n or not t.at(cur).isDigit() {
        return (isInt = false, isFloat = false);
    }
    var sawDot := false;
    var i := cur;
    loop i < n {
        ch := t.at(i);
        if ch == "." {
            if i + 1 < n and t.at(i + 1) == "." { return (isInt = false, isFloat = false); }
            sawDot = true;
        } else if not ch.isNameContinue() {
            return (isInt = false, isFloat = false);
        }
        i = i + 1;
    }
    if sawDot { (isInt = false, isFloat = true) } else { (isInt = true, isFloat = false) }
};

/** Result of scanning `<...>` comptime arguments in an overloaded call. */
ScannedComptimeArgs := record {
    ok: Bool;
    closeGt: Int;
    starts: List<Int>;
    ends: List<Int>;
};

/** Splits top-level comma-separated `<...>` comptime argument ranges and finds the matching `>` offset. */
scanOverloadComptimeArgs := fn(source: String, openLt: Int, prefix: String): ScannedComptimeArgs {
    size := source.length();
    mut starts: List<Int> = [];
    mut ends: List<Int> = [];
    var cur := syntax.skipTrivia(source, openLt + 1, prefix);
    if cur >= size or source.at(cur) == ">" {
        return ScannedComptimeArgs { ok = false, closeGt = openLt, starts = starts, ends = ends };
    }
    var depth := 0;
    var itemStart := cur;
    loop cur < size {
        ch := source.at(cur);
        if ch == "\"" {
            cur = syntax.skipAliasString(source, cur);
        } else if ch == "/" and source.startsWithAt(cur, "/*") {
            cur = syntax.skipComment(source, cur, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" or ch == "<" {
            depth = depth + 1;
            cur = cur + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth > 0 { depth = depth - 1; }
            cur = cur + 1;
        } else if ch == ">" {
            if depth == 0 {
                mut starts.pushBack(itemStart);
                mut ends.pushBack(cur);
                return ScannedComptimeArgs { ok = true, closeGt = cur + 1, starts = starts, ends = ends };
            }
            depth = depth - 1;
            cur = cur + 1;
        } else if ch == "," and depth == 0 {
            mut starts.pushBack(itemStart);
            mut ends.pushBack(cur);
            cur = syntax.skipTrivia(source, cur + 1, prefix);
            itemStart = cur;
        } else {
            cur = cur + 1;
        }
    }
    ScannedComptimeArgs { ok = false, closeGt = openLt, starts = starts, ends = ends }
};

/** Resolves overload selection (`choose candIdx` + `initBindings`) strictly before context resolution when multiple candidates share a callee name. */
selectOverloadForCall := fn(
target: String, source: String, postPos: Int, errPos: Int, prefix: String, calleeDisplay: String,
candIndices: List<Int>, hasRecv: Bool, recvKind: String, recvExplicitMut: Bool,
isStaticTypeCall: Bool, typeOwnerKey: String, memberName: String, resolvedType: String, aliasParamsCsv: String, aliasTplKind: String, memberErrPos: Int,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
ctxs: List<ConstructCtx>, iifeDepth: Int, aliases: List<AliasDecl>
): (chosenIdx: Int, initBindings: String, openParen: Int) {
    size := source.length();
    hasComptime := postPos < size and source.at(postPos) == "<";
    var openParen := postPos;
    var ctArgCount := 0;
    var mut ctArgStarts: List<Int> = [];
    var mut ctArgEnds: List<Int> = [];
    if hasComptime {
        scannedCt := scanOverloadComptimeArgs(source, postPos, prefix);
        if not scannedCt.ok {
            syntax.failAt(source, postPos, prefix, "expected > after type arguments in call to " + calleeDisplay);
        }
        ctArgStarts = scannedCt.starts;
        ctArgEnds = scannedCt.ends;
        ctArgCount = ctArgStarts.length();
        openParen = syntax.skipTrivia(source, scannedCt.closeGt, prefix);
        if openParen >= size or source.at(openParen) =!= "(" {
            syntax.failAt(source, openParen, prefix, "expected ( after type arguments in call to " + calleeDisplay);
        }
    }
    /* Step 1: pre-scan call arguments once. */
    mut callArgs: List<OverloadCallArg> = [];
    var scanCur := syntax.skipTrivia(source, openParen + 1, prefix);
    loop scanCur < size and source.at(scanCur) =!= ")" {
        argPos := scanCur;
        var aLabel := "";
        var aShorthand := false;
        var aRhs := scanCur;
        if syntax.isSingleEquals(source, scanCur) {
            idStart := syntax.skipTrivia(source, scanCur + 1, prefix);
            if idStart < size and source.at(idStart).isNameStart() {
                idEnd := source.skipName(idStart);
                aLabel = source.slice(idStart, idEnd);
                aRhs = idStart;
                aShorthand = true;
            }
        } else if scanCur < size and source.at(scanCur).isNameStart() {
            lEnd := source.skipName(scanCur);
            afterL := syntax.skipTrivia(source, lEnd, prefix);
            if syntax.isSingleEquals(source, afterL) {
                aLabel = source.slice(scanCur, lEnd);
                aRhs = syntax.skipTrivia(source, afterL + 1, prefix);
            }
        }
        lease := if not aShorthand {
            tryParseGroupedMutLease(source, aRhs, prefix, false)
        } else {
            (matched = false, sawMut = false, mutStart = 0, nameStart = 0, nameEnd = 0, next = aRhs)
        };
        aMut := lease.matched;
        balancedEnd := syntax.skipBalancedArgument(source, aRhs, prefix);
        var aContextual := false;
        var aNatOk := false;
        var aNatKind := "";
        var aUnsufInt := false;
        var aUnsufFloat := false;
        if aMut {
            afterL := syntax.skipTrivia(source, lease.next, prefix);
            isSubSlice := afterL < size and (source.at(afterL) == "[" or source.at(afterL) == ".");
            if isSubSlice {
                subProbe := parseBinaryCtx(target, source, aRhs, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, true, "", aliases);
                if subProbe.kind =!= "" {
                    aNatOk = true;
                    aNatKind = subProbe.kind;
                }
            } else {
                mName := source.slice(lease.nameStart, lease.nameEnd);
                var mLoc := if mName.startsWithAt(0, ".") {
                    pLoopIdx := ctx.findLeadingDotLoopIdx(ctxs, true);
                    if pLoopIdx >= 0 and ctxs[pLoopIdx].phase =!= ir.CTX_PHASE_THEN and ctxs[pLoopIdx].phase =!= ir.CTX_PHASE_HEADER {
                        sym.localIndex(locals, "$loop_item_" + ctxs[pLoopIdx].id.toText())
                    } else { -1 }
                } else {
                    sym.localIndex(locals, mName)
                };
                if mLoc >= 0 and locals[mLoc].depth >= -1 {
                    aNatOk = true;
                    aNatKind = locals[mLoc].kind;
                }
            }
        } else {
            firstCh := if aRhs < size { source.at(aRhs) } else { "" };
            candBareOv := if firstCh =!= "" and firstCh.isNameStart() {
                bEnd := source.skipName(aRhs);
                bAfter := syntax.skipTrivia(source, bEnd, prefix);
                if bAfter >= balancedEnd or source.at(bAfter) == "," or source.at(bAfter) == ")" {
                    bName := source.slice(aRhs, bEnd);
                    sym.localIndex(locals, bName) < 0 and sym.hasOverloads(functions, bName)
                } else { false }
            } else { false };
            needsExp := firstCh == "." or firstCh == "{" or firstCh == "[" or source.wordAt(aRhs, "fn") or candBareOv;
            if needsExp {
                /* Non-empty list literals [1, 2] and inferred structural record literals { ... } can probe naturally with expected = "". */
                var safeNatural := false;
                if firstCh == "[" {
                    inB := syntax.skipTrivia(source, aRhs + 1, prefix);
                    if inB < size and source.at(inB) =!= "]" { safeNatural = true; }
                } else if firstCh == "{" {
                    inB := syntax.skipTrivia(source, aRhs + 1, prefix);
                    if inB < size and (source.at(inB) == "}" or syntax.isSingleEquals(source, inB) or source.at(inB) == "\"") {
                        safeNatural = true;
                    } else if inB < size and source.at(inB).isNameStart() {
                        kEnd := source.skipName(inB);
                        kWord := source.slice(inB, kEnd);
                        kAfter := syntax.skipTrivia(source, kEnd, prefix);
                        if not syntax.isReservedWord(kWord) and kAfter < size and (syntax.isSingleEquals(source, kAfter) or (source.at(kAfter) == ":" and not source.startsWithAt(kAfter, ":="))) {
                            safeNatural = true;
                        }
                    }
                }
                if safeNatural {
                    natP := parseBinaryCtx(target, source, aRhs, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, true, "", aliases);
                    if natP.kind =!= "" {
                        aNatOk = true;
                        aNatKind = natP.kind;
                    } else {
                        aContextual = true;
                    }
                } else {
                    aContextual = true;
                }
            } else {
                natP := parseBinaryCtx(target, source, aRhs, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, true, "", aliases);
                if natP.kind =!= "" {
                    aNatOk = true;
                    aNatKind = natP.kind;
                    if natP.constant {
                        numCls := classifyNumericLiteralText(source.slice(aRhs, natP.next));
                        aUnsufInt = numCls.isInt and natP.kind == ir.VALUE_KIND_INT;
                        aUnsufFloat = numCls.isFloat and natP.kind == ir.VALUE_KIND_FLOAT;
                    }
                } else {
                    aContextual = true;
                }
            }
        }
        mut callArgs.pushBack(OverloadCallArg {
            pos = argPos, rhsStart = aRhs, label = aLabel, isMut = aMut,
            isShorthand = aShorthand, isContextual = aContextual,
            isUnsuffixedInt = aUnsufInt, isUnsuffixedFloat = aUnsufFloat,
            natOk = aNatOk, natKind = aNatKind, next = balancedEnd
        });
        scanCur = balancedEnd;
        if scanCur < size and source.at(scanCur) == "," {
            scanCur = syntax.skipTrivia(source, scanCur + 1, prefix);
            if scanCur < size and source.at(scanCur) == ")" { break; }
        } else {
            break;
        }
    }
    entryCount := callArgs.length();

    /* Step 2: evaluate viability and specificity tier for every candidate index. */
    mut viableIdxs: List<Int> = [];
    mut viableBindings: List<String> = [];
    mut viableTiers: List<Int> = [];
    mut viableGenParams: List<String> = [];
    mut viablePatsCsv: List<String> = [];
    mut viableOmitted: List<Int> = [];
    paramOffset := if hasRecv { 1 } else { 0 };

    loop candIndices as candIdx {
        info := functions[candIdx];
        if info.count < 0 { continue; }
        if isStaticTypeCall and hasRecv { continue; }
        if hasRecv and (isStaticTypeOp(info) or info.count < 1) { continue; }
        var preBindEnc := "";
        mut genBindings: Map<String, String>;
        isGen := info.runtime.startsWithAt(0, "$gen:");
        var gpStr := "";
        if isGen {
            tplKey := info.runtime.slice(5, info.runtime.length());
            tplIdx := generics.findTemplate(tplKey);
            if tplIdx < 0 { continue; }
            gpStr = generics.getTemplate(tplIdx).genericParams;
        }
        if isStaticTypeCall {
            stRes := resolveTypeQualifiedOp(source, memberErrPos, prefix, candIdx, memberName, typeOwnerKey, resolvedType, aliasParamsCsv, aliasTplKind, functions, params, true);
            if not stRes.ok { continue; }
            preBindEnc = stRes.initBindings;
            if preBindEnc =!= "" and gpStr =!= "" {
                loop generics.decodeBindings(preBindEnc) as pb {
                    if pb.kind =!= "" { mut genBindings.set(pb.name, pb.kind); }
                }
            }
        }
        if hasRecv {
            rawRecv := types.paramKindOf(params[info.first]);
            candRecvMut := rawRecv.startsWithAt(0, "mut ");
            if candRecvMut =!= recvExplicitMut { continue; }
            baseRecv := if candRecvMut { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
            if isGen {
                uRecvErr := generics.unifyKindMut(gpStr, baseRecv, recvKind, mut genBindings);
                if uRecvErr =!= "" { continue; }
                cRecvErr := findGenericConstraintError(gpStr, genBindings, "");
                if cRecvErr =!= "" { continue; }
                preBindEnc = generics.encodePartialBindings(gpStr, genBindings);
            } else {
                if not types.isCompatibleKind(baseRecv, recvKind) { continue; }
            }
        }
        if hasComptime {
            if not isGen { continue; }
            allSpecs := types.splitParamSpecs(gpStr);
            mut remSpecs: List<(name: String, kind: String)> = [];
            loop allSpecs as sp {
                if not genBindings.has(sp.name) { mut remSpecs.pushBack(sp); }
            }
            if ctArgCount =!= remSpecs.length() { continue; }
            var ctOk := true;
            var ci := 0;
            loop ci < ctArgCount {
                sp := remSpecs[ci];
                rawCt := source.slice(ctArgStarts[ci], ctArgEnds[ci]).trim();
                if rawCt == "" { ctOk = false; break; }
                if types.isTypeParamKind(sp.kind) {
                    cRes := types.canResolveTypeAt(rawCt, 0, prefix, aliases, "", [], 32);
                    if not cRes.ok or syntax.skipTrivia(rawCt, cRes.next, prefix) < rawCt.length() { ctOk = false; break; }
                    mut genBindings.set(sp.name, cRes.kind);
                } else {
                    vRes := types.parseComptimeValueArg(rawCt, 0, prefix, aliases, "", sp.kind);
                    if not vRes.ok or syntax.skipTrivia(rawCt, vRes.next, prefix) < rawCt.length() { ctOk = false; break; }
                    mut genBindings.set(sp.name, vRes.token);
                }
                ci = ci + 1;
            }
            if not ctOk { continue; }
            if findGenericConstraintError(gpStr, genBindings, "") =!= "" { continue; }
            preBindEnc = generics.encodePartialBindings(gpStr, genBindings);
        }
        userCount := info.count - paramOffset;
        if entryCount > userCount { continue; }
        /* Route call arguments to candidate parameter slots (positional, named, =shorthand). */
        mut slotMatched: List<Bool> = [];
        mut slotToArg: List<Int> = [];
        var si := 0;
        loop si < userCount {
            mut slotMatched.pushBack(false);
            mut slotToArg.pushBack(-1);
            si = si + 1;
        }
        var routingOk := true;
        var ai := 0;
        loop ai < entryCount {
            ca := callArgs[ai];
            if ca.label =!= "" {
                foundSlot := ctx.findParamSlot(params, info.first + paramOffset, userCount, ca.label);
                if foundSlot < 0 or slotMatched[foundSlot] { routingOk = false; break; }
                slotMatched[foundSlot] = true;
                slotToArg[foundSlot] = ai;
            } else {
                var firstFree := -1;
                var fi := 0;
                loop fi < slotMatched.length() {
                    if not slotMatched[fi] { firstFree = fi; break; }
                    fi = fi + 1;
                }
                if firstFree < 0 { routingOk = false; break; }
                slotMatched[firstFree] = true;
                slotToArg[firstFree] = ai;
            }
            ai = ai + 1;
        }
        if not routingOk { continue; }
        var optMissOk := true;
        var omittedCnt := 0;
        var fiMiss := 0;
        loop fiMiss < userCount {
            if not slotMatched[fiMiss] {
                if not types.paramIsOptional(params[info.first + paramOffset + fiMiss]) {
                    optMissOk = false;
                    break;
                }
                omittedCnt = omittedCnt + 1;
            }
            fiMiss = fiMiss + 1;
        }
        if not optMissOk { continue; }

        /* Validate parameter mutability and unify/match types per slot. */
        var candViable := true;
        var candTier := if isGen { 4 } else { 0 };
        mut candPats: List<String> = [];
        if isGen {
            /* Two-pass for generics so bound non-contextual args constrain generic parameters before contextual args. */
            var spIdx := 0;
            loop spIdx < userCount {
                rawPK := types.paramKindOf(params[info.first + paramOffset + spIdx]);
                mut candPats.pushBack(rawPK);
                if slotToArg[spIdx] < 0 {
                    spIdx = spIdx + 1;
                    continue;
                }
                ca := callArgs[slotToArg[spIdx]];
                pMut := rawPK.startsWithAt(0, "mut ");
                if ca.isMut =!= pMut { candViable = false; break; }
                pBase := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                if not ca.isContextual and ca.natOk and types.kindHasAnyGenericParam(gpStr, pBase) and pBase =!= "$InferParam" {
                    uErr := generics.unifyKindMut(gpStr, pBase, ca.natKind, mut genBindings);
                    if uErr =!= "" { candViable = false; break; }
                }
                spIdx = spIdx + 1;
            }
            if not candViable { continue; }
            if findGenericConstraintError(gpStr, genBindings, "") =!= "" { continue; }
            var spIdx2 := 0;
            loop spIdx2 < userCount {
                if slotToArg[spIdx2] < 0 {
                    spIdx2 = spIdx2 + 1;
                    continue;
                }
                ca := callArgs[slotToArg[spIdx2]];
                rawPK := types.paramKindOf(params[info.first + paramOffset + spIdx2]);
                pMut := rawPK.startsWithAt(0, "mut ");
                pBase := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                subP := generics.substKind(gpStr, pBase, genBindings);
                if subP == "$InferParam" {
                    spIdx2 = spIdx2 + 1;
                    continue;
                }
                var effArgK := ca.natKind;
                if ca.isContextual {
                    if types.kindHasAnyGenericParam(gpStr, subP) { candViable = false; break; }
                    pExp := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, subP, 0, ctxs, iifeDepth, true, "", aliases);
                    if pExp.kind == "" { candViable = false; break; }
                    effArgK = pExp.kind;
                } else if not ca.natOk {
                    candViable = false;
                    break;
                }
                if types.kindHasAnyGenericParam(gpStr, pBase) {
                    if not types.isCompatibleKind(subP, effArgK) {
                        if types.isDynKind(subP) and types.findImplForConcrete(effArgK, types.dynInterfaceKind(subP)).found {
                            /* Allowed via dyn */
                        } else {
                            candViable = false;
                            break;
                        }
                    }
                    /* Promote from unconstrained (4) to constrained/structured (2) if any generic slot is structured or constrained. */
                    if not types.isGenericParamName(gpStr, pBase) {
                        if candTier > 2 { candTier = 2; }
                    } else if types.typeParamConstraintKind(gpStr, pBase) =!= "" {
                        if candTier > 2 { candTier = 2; }
                    }
                } else {
                    if types.isDynKind(subP) and not types.isDynKind(effArgK) {
                        if not types.findImplForConcrete(effArgK, types.dynInterfaceKind(subP)).found {
                            candViable = false;
                            break;
                        }
                    } else if ca.isUnsuffixedInt and numeric.isIntKind(subP) and effArgK =!= subP {
                        pLit := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, subP, 0, ctxs, iifeDepth, true, "", aliases);
                        if pLit.kind == "" or not types.isCompatibleKind(subP, pLit.kind) { candViable = false; break; }
                    } else if ca.isUnsuffixedFloat and numeric.isFloatKind(subP) and effArgK =!= subP {
                        pLit := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, subP, 0, ctxs, iifeDepth, true, "", aliases);
                        if pLit.kind == "" or not types.isCompatibleKind(subP, pLit.kind) { candViable = false; break; }
                    } else if not types.isCompatibleKind(subP, effArgK) {
                        candViable = false;
                        break;
                    }
                }
                spIdx2 = spIdx2 + 1;
            }
        } else {
            var spIdx := 0;
            loop spIdx < userCount {
                rawPK := types.paramKindOf(params[info.first + paramOffset + spIdx]);
                mut candPats.pushBack(rawPK);
                if slotToArg[spIdx] < 0 {
                    spIdx = spIdx + 1;
                    continue;
                }
                ca := callArgs[slotToArg[spIdx]];
                pMut := rawPK.startsWithAt(0, "mut ");
                if ca.isMut =!= pMut { candViable = false; break; }
                pBase := if pMut { rawPK.slice(4, rawPK.length()) } else { rawPK };
                if pBase == "$InferParam" {
                    spIdx = spIdx + 1;
                    continue;
                }
                if ca.isContextual {
                    pExp := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, pBase, 0, ctxs, iifeDepth, true, "", aliases);
                    if pExp.kind == "" { candViable = false; break; }
                    if types.isDynKind(pBase) and not types.isDynKind(pExp.kind) {
                        if not types.findImplForConcrete(pExp.kind, types.dynInterfaceKind(pBase)).found { candViable = false; break; }
                        if candTier < 3 { candTier = 3; }
                    } else if not types.isCompatibleKind(pBase, pExp.kind) {
                        candViable = false;
                        break;
                    } else if candTier < 1 {
                        candTier = 1;
                    }
                } else if not ca.natOk {
                    candViable = false;
                    break;
                } else if ca.natKind == pBase {
                    /* Exact match keeps Tier 0. */
                } else if ca.isUnsuffixedInt and numeric.isIntKind(pBase) {
                    pLit := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, pBase, 0, ctxs, iifeDepth, true, "", aliases);
                    if pLit.kind == "" or not types.isCompatibleKind(pBase, pLit.kind) { candViable = false; break; }
                    if candTier < 1 { candTier = 1; }
                } else if ca.isUnsuffixedFloat and numeric.isFloatKind(pBase) {
                    pLit := parseBinaryCtx(target, source, ca.rhsStart, prefix, locals, functions, params, currentName, pBase, 0, ctxs, iifeDepth, true, "", aliases);
                    if pLit.kind == "" or not types.isCompatibleKind(pBase, pLit.kind) { candViable = false; break; }
                    if candTier < 1 { candTier = 1; }
                } else if types.isCompatibleKind(pBase, ca.natKind) {
                    /* Implicit widening (e.g. Int32 -> Int): Tier 1 */
                    if candTier < 1 { candTier = 1; }
                } else if types.isDynKind(pBase) and not types.isDynKind(ca.natKind) and types.findImplForConcrete(ca.natKind, types.dynInterfaceKind(pBase)).found {
                    if candTier < 3 { candTier = 3; }
                } else {
                    candViable = false;
                    break;
                }
                spIdx = spIdx + 1;
            }
        }
        if not candViable { continue; }
        /* For zero-arg generic vs non-generic, treat non-generic as Tier 0, unconstrained generic as Tier 4, constrained as Tier 2. */
        if isGen and userCount == 0 and hasComptime { candTier = 0; }
        mut viableIdxs.pushBack(candIdx);
        mut viableBindings.pushBack(preBindEnc);
        mut viableTiers.pushBack(candTier);
        mut viableGenParams.pushBack(gpStr);
        mut viablePatsCsv.pushBack(candPats.join("\n"));
        mut viableOmitted.pushBack(omittedCnt);
    }

    vc := viableIdxs.length();
    if vc == 0 {
        mut argTypesDisp: List<String> = [];
        loop callArgs as ca {
            d := if ca.isMut { "mut " } else { "" };
            mut argTypesDisp.pushBack(d + (if ca.natOk { types.displayKind(ca.natKind) } else { "_" }));
        }
        syntax.failAt(source, errPos, prefix, "no matching overload for " + calleeDisplay + " with argument types (" + argTypesDisp.join(", ") + ")");
    }
    if vc == 1 {
        return (chosenIdx = viableIdxs[0], initBindings = viableBindings[0], openParen = openParen);
    }

    /* Step 3: find maximal (undominated) candidates. */
    mut bestMask: List<Bool> = [];
    var bi := 0;
    loop bi < vc { mut bestMask.pushBack(true); bi = bi + 1; }
    var i := 0;
    loop i < vc {
        var j := 0;
        loop j < vc {
            if i =!= j and bestMask[i] and bestMask[j] {
                patsI := viablePatsCsv[i].split("\n");
                patsJ := viablePatsCsv[j].split("\n");
                jBetter := overloads.isMoreSpecificCandidate(
                viableTiers[j], viableGenParams[j], patsJ,
                viableTiers[i], viableGenParams[i], patsI
                );
                iBetter := overloads.isMoreSpecificCandidate(
                viableTiers[i], viableGenParams[i], patsI,
                viableTiers[j], viableGenParams[j], patsJ
                );
                if jBetter or (not iBetter and viableOmitted[j] < viableOmitted[i]) {
                    bestMask[i] = false;
                    break;
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    mut winners: List<Int> = [];
    var wi := 0;
    loop wi < vc {
        if bestMask[wi] { mut winners.pushBack(wi); }
        wi = wi + 1;
    }
    if winners.length() =!= 1 {
        syntax.failAt(source, errPos, prefix, "ambiguous call to overloaded " + calleeDisplay + ": matches multiple overloads");
    }
    w := winners[0];
    (chosenIdx = viableIdxs[w], initBindings = viableBindings[w], openParen = openParen)
};

/** Parses user, type-operation, and indirect function calls with positional, named, and `=name` shorthand arguments, plus optional prepended receiver, generic unification/monomorphization, and TS `mut Record` live accessor boxes. */
parseUserOrIndirectCallWithRecv := fn(target: String, source: String, openParen: Int, errPos: Int, isModuleFn: Bool, calleeDisplay: String, callRuntime: String, callParams: List<String>, callFirst: Int, callCount: Int, callResult: String, callCtxKind: String, hasRecv: Bool, recvCode: String, recvWritebackLocal: String, recvWritebackBox: String, recvWritebackStmt: String, recvWritebackKind: String, recvRootRuntime: String, initGenBindings: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    isGenericCall := isModuleFn and callRuntime.startsWithAt(0, "$gen:");
    genTplKey := if isGenericCall { callRuntime.slice(5, callRuntime.length()) } else { "" };
    var genParams := "";
    var genTplParamsRaw := "";
    var genTplParamCount := 0;
    mut genBindings: Map<String, String>;
    if isGenericCall {
        genTplIdx := generics.findTemplate(genTplKey);
        if genTplIdx < 0 {
            syntax.failAt(source, errPos, prefix, "internal error: missing generic template " + genTplKey);
        }
        genTpl := generics.getTemplate(genTplIdx);
        genParams = genTpl.genericParams;
        genTplParamsRaw = genTpl.params;
        genTplParamCount = genTpl.paramCount;
        loop generics.decodeBindings(initGenBindings) as initB {
            if initB.kind =!= "" {
                mut genBindings.set(initB.name, initB.kind);
            }
        }
    }
    explicitLabels := syntax.collectExplicitCallLabels(source, openParen, prefix);
    argIifeDepth := if target == ir.TARGET_TS and ctx.callReordersArgs(source, openParen, prefix, callParams, callFirst, callCount) {
        iifeDepth + 1
    } else {
        iifeDepth
    };
    var callMarkers := "";
    var slotEntry: List<Int> = [];
    var slotExplicit: List<Bool> = [];
    mut initSlots: List<Int> = [];
    mut initExplicit: List<Bool> = [];
    var initIdx := 0;
    loop initIdx < callCount {
        mut initSlots.pushBack(-1);
        mut initExplicit.pushBack(false);
        initIdx = initIdx + 1;
    }
    slotEntry = initSlots;
    slotExplicit = initExplicit;
    mut entryPositions: List<Int> = [];
    mut entrySlots: List<Int> = [];
    mut entryKinds: List<String> = [];
    mut entryCodes: List<String> = [];
    mut mutRecBoxNames: List<String> = [];
    mut mutRecLocalRuntimes: List<String> = [];
    mut mutRecWritebackStmts: List<String> = [];
    mut mutRecKinds: List<String> = [];
    mut mutArgRuntimes: List<String> = [];
    mut mutArgRoots: List<String> = [];
    mut mutArgNames: List<String> = [];
    mut mutArgProvs: List<String> = [];
    mut entryProvs: List<String> = [];
    if hasRecv and callFirst > 0 and types.paramKindOf(callParams[callFirst - 1]).startsWithAt(0, "mut ") {
        var recvRootCanon := if recvRootRuntime =!= "" { recvRootRuntime }
        else if recvWritebackLocal =!= "" { recvWritebackLocal }
        else if recvCode.startsWithAt(0, "&(") and recvCode.endsWith(")") { recvCode.slice(2, recvCode.length() - 1) }
        else if recvCode.startsWithAt(0, "&") { recvCode.slice(1, recvCode.length()) }
        else { recvCode };
        mut mutArgRoots.pushBack(recvRootCanon);
        mut mutArgNames.pushBack(displayBindingFromRuntime(recvRootCanon));
        mut mutArgProvs.pushBack("");
        if recvRootRuntime =!= "" {
            mut mutArgRuntimes.pushBack(recvRootRuntime);
            if not recvRootRuntime.endsWith(".v") {
                mut mutArgRuntimes.pushBack(recvRootRuntime + ".v");
            }
        }
        if recvWritebackLocal =!= "" {
            mut mutArgRuntimes.pushBack(recvWritebackLocal);
        } else if recvCode.startsWithAt(0, "&") {
            mut mutArgRuntimes.pushBack(recvCode.slice(1, recvCode.length()));
        } else {
            mut mutArgRuntimes.pushBack(recvCode);
            mut mutArgRuntimes.pushBack(recvCode + ".v");
        }
    }
    if target == ir.TARGET_TS and hasRecv and recvWritebackLocal =!= "" and recvWritebackBox =!= "" {
        mut mutRecBoxNames.pushBack(recvWritebackBox);
        mut mutRecLocalRuntimes.pushBack(recvWritebackLocal);
        mut mutRecWritebackStmts.pushBack(recvWritebackStmt);
        mut mutRecKinds.pushBack(recvWritebackKind);
    }
    var entryCount := 0;
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    if cursor < size and source.at(cursor) =!= ")" {
        loop true {
            if syntax.isSingleEquals(source, cursor) {
                argNameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if argNameStart >= size or not source.at(argNameStart).isNameStart() {
                    syntax.failAt(source, argNameStart, prefix, "expected parameter name after =");
                }
                argNameEnd := source.skipName(argNameStart);
                label := source.slice(argNameStart, argNameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, argNameStart, label, prefix); }
                afterIdent := syntax.skipTrivia(source, argNameEnd, prefix);
                if afterIdent < size and source.at(afterIdent) =!= "," and source.at(afterIdent) =!= ")" {
                    syntax.failAt(source, afterIdent, prefix, "shorthand argument requires a bare identifier");
                }
                slot := ctx.findParamSlot(callParams, callFirst, callCount, label);
                if slot < 0 {
                    syntax.failAt(source, argNameStart, prefix, "unknown parameter " + label + " in call to " + calleeDisplay);
                }
                if slotExplicit[slot] {
                    syntax.failAt(source, argNameStart, prefix, "duplicate named argument " + label + " in call to " + calleeDisplay);
                }
                slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                rawArgExpected := types.paramKindOf(callParams[callFirst + slot]);
                argExpected := if isGenericCall {
                    generics.substKindForExpected(genParams, rawArgExpected, genBindings)
                } else {
                    rawArgExpected
                };
                arg := parseBinaryCtx(target, source, argNameStart, prefix, locals, functions, params, currentName, argExpected, 30, ctxs, argIifeDepth, inferMode, "", aliases);
                if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                if isGenericCall {
                    uErr := generics.unifyKindMut(genParams, rawArgExpected, arg.kind, mut genBindings);
                    if uErr =!= "" {
                        syntax.failAt(source, argNameStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                    }
                }
                (mut entryPositions).pushBack(argNameStart);
                mut entrySlots.pushBack(slot);
                mut entryKinds.pushBack(arg.kind);
                mut entryCodes.pushBack(arg.code);
                mut entryProvs.pushBack(arg.textValue);
                entryCount += 1;
                cursor = syntax.skipTrivia(source, arg.next, prefix);
            } else {
                var namedLabel := "";
                var rhsStart := -1;
                if cursor < size and source.at(cursor).isNameStart() {
                    labelEnd := source.skipName(cursor);
                    afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
                    if syntax.isSingleEquals(source, afterLabel) {
                        namedLabel = source.slice(cursor, labelEnd);
                        rhsStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
                    }
                }
                if namedLabel =!= "" {
                    if syntax.isReservedWord(namedLabel) { syntax.unsupportedFeature(source, cursor, namedLabel, prefix); }
                    slot := ctx.findParamSlot(callParams, callFirst, callCount, namedLabel);
                    if slot < 0 {
                        syntax.failAt(source, cursor, prefix, "unknown parameter " + namedLabel + " in call to " + calleeDisplay);
                    }
                    if slotExplicit[slot] {
                        syntax.failAt(source, cursor, prefix, "duplicate named argument " + namedLabel + " in call to " + calleeDisplay);
                    }
                    slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                    slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                    rawArgExpected := types.paramKindOf(callParams[callFirst + slot]);
                    if rawArgExpected.startsWithAt(0, "mut ") {
                        lease := tryParseGroupedMutLease(source, rhsStart, prefix, false);
                        if not lease.matched {
                            if lease.sawMut {
                                if lease.nameEnd > lease.nameStart {
                                    syntax.failAt(source, lease.nameEnd, prefix, "expected ) after mut " + source.slice(lease.nameStart, lease.nameEnd));
                                }
                                syntax.failAt(source, lease.nameStart, prefix, "expected a binding name after mut");
                            }
                            syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + " requires mut argument");
                        }
                        mNameStart := lease.nameStart;
                        mNameEnd := lease.nameEnd;
                        mRawListName := source.slice(mNameStart, mNameEnd);
                        mLeaseRes := resolveMutLeaseLocal(locals, ctxs, mRawListName, source, mNameStart, prefix);
                        mListName := mLeaseRes.displayName;
                        mIdxRes := mLeaseRes.idx;
                        afterLease := syntax.skipTrivia(source, lease.next, prefix);
                        isMutSubExpr := afterLease < size and (source.at(afterLease) == "[" or source.at(afterLease) == ".");
                        if isMutSubExpr {
                            mutArg := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, "", 0, ctxs, argIifeDepth, inferMode, "", aliases);
                            if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, mutArg); }
                            if not types.isSliceKind(mutArg.kind) or not sliceBorrows.sliceExprIsMutable(mutArg.textValue) {
                                syntax.failAt(source, rhsStart, prefix, "mut call expression must resolve to a mutable Slice<T>");
                            }
                            if isGenericCall {
                                rawBaseMut := rawArgExpected.slice(4, rawArgExpected.length());
                                uErr := generics.unifyKindMut(genParams, rawBaseMut, mutArg.kind, mut genBindings);
                                if uErr =!= "" {
                                    syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                                }
                            }
                            subRootIdx := extractAddressableLocal(locals, locals[mIdxRes].runtime);
                            subRootRt := if subRootIdx >= 0 { locals[subRootIdx].runtime } else { "" };
                            aliasHit := checkMutArgAliasSymmetric(mListName, subRootRt, mutArg.textValue, mutArgRoots, mutArgNames, mutArgProvs);
                            if aliasHit =!= "" {
                                syntax.failAt(source, mNameStart, prefix, "cannot pass " + aliasHit + " multiple times as mut in the same call");
                            }
                            mut mutArgRoots.pushBack(subRootRt);
                            mut mutArgNames.pushBack(mListName);
                            mut mutArgProvs.pushBack(mutArg.textValue);
                            mut mutArgRuntimes.pushBack(subRootRt);
                            mut entryPositions.pushBack(rhsStart);
                            mut entrySlots.pushBack(slot);
                            mut entryKinds.pushBack("mut " + mutArg.kind);
                            mut entryCodes.pushBack(mutArg.code);
                            mut entryProvs.pushBack(mutArg.textValue);
                            entryCount += 1;
                            cursor = syntax.skipTrivia(source, mutArg.next, prefix);
                        } else {
                            mEntry := locals[mIdxRes];
                            if not types.isMutContainerKind(mEntry.kind) {
                                syntax.failAt(source, mNameStart, prefix, calleeDisplay + " requires a List, Map, Set, or record value, got " + types.displayKind(mEntry.kind));
                            }
                            if not mEntry.writable {
                                syntax.failAt(source, mNameStart, prefix, "cannot mutate " + mListName + " without mut");
                            }
                            sliceBorrows.checkCanMutateBinding(locals, mEntry.runtime, mListName, source, mNameStart, prefix);
                            if isGenericCall {
                                rawBaseMut := rawArgExpected.slice(4, rawArgExpected.length());
                                uErr := generics.unifyKindMut(genParams, rawBaseMut, mEntry.kind, mut genBindings);
                                if uErr =!= "" {
                                    syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                                }
                            }
                            mProv := if types.isSliceKind(mEntry.kind) {
                                "mut_slice:" + sliceBorrows.sliceIdentifierProvenance(mEntry.runtime, mEntry.depth, mListName, mEntry.textValue).slice(9, sliceBorrows.sliceIdentifierProvenance(mEntry.runtime, mEntry.depth, mListName, mEntry.textValue).length())
                            } else {
                                "mut_dyn:" + sliceBorrows.sliceIdentifierProvenance(mEntry.runtime, mEntry.depth, mListName, mEntry.textValue).slice(9, sliceBorrows.sliceIdentifierProvenance(mEntry.runtime, mEntry.depth, mListName, mEntry.textValue).length())
                            };
                            aliasHit := checkMutArgAliasSymmetric(mListName, mEntry.runtime, mProv, mutArgRoots, mutArgNames, mutArgProvs);
                            if aliasHit =!= "" or mutArgRoots.contains(mEntry.runtime) {
                                syntax.failAt(source, mNameStart, prefix, "cannot pass " + mListName + " multiple times as mut in the same call");
                            }
                            mut mutArgRoots.pushBack(mEntry.runtime);
                            mut mutArgNames.pushBack(mListName);
                            mut mutArgProvs.pushBack(mProv);
                            rawBaseMut := rawArgExpected.slice(4, rawArgExpected.length());
                            var mCode := mEntry.runtime;
                            if not types.isDynKind(rawBaseMut) {
                                mCode = if target == ir.TARGET_C and not types.isSliceKind(mEntry.kind) and not types.isDynKind(mEntry.kind) { "&" + mEntry.runtime } else { mEntry.runtime };
                                if target == ir.TARGET_TS and types.isRecordOrDistinctRecord(mEntry.kind) {
                                    if mEntry.runtime.endsWith(".v") {
                                        mCode = mEntry.runtime.slice(0, mEntry.runtime.length() - 2);
                                    } else {
                                        boxName := "lite$mb" + mutRecBoxNames.length().toText();
                                        mut mutRecBoxNames.pushBack(boxName);
                                        mut mutRecLocalRuntimes.pushBack(mEntry.runtime);
                                        mut mutRecWritebackStmts.pushBack("");
                                        mut mutRecKinds.pushBack(mEntry.kind);
                                        mCode = boxName;
                                    }
                                }
                            }
                            (mut mutArgRuntimes).pushBack(mEntry.runtime);
                            mut entryPositions.pushBack(rhsStart);
                            mut entrySlots.pushBack(slot);
                            mut entryKinds.pushBack("mut " + mEntry.kind);
                            mut entryCodes.pushBack(mCode);
                            mut entryProvs.pushBack(mProv);
                            entryCount += 1;
                            cursor = afterLease;
                        }
                    } else {
                        argExpected := if isGenericCall {
                            generics.substKindForExpected(genParams, rawArgExpected, genBindings)
                        } else {
                            rawArgExpected
                        };
                        arg := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                        if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                        if isGenericCall {
                            uErr := generics.unifyKindMut(genParams, rawArgExpected, arg.kind, mut genBindings);
                            if uErr =!= "" {
                                syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                            }
                        }
                        (mut entryPositions).pushBack(rhsStart);
                        mut entrySlots.pushBack(slot);
                        mut entryKinds.pushBack(arg.kind);
                        mut entryCodes.pushBack(arg.code);
                        mut entryProvs.pushBack(arg.textValue);
                        entryCount += 1;
                        cursor = syntax.skipTrivia(source, arg.next, prefix);
                    }
                } else {
                    var nextSlot := -1;
                    var scan := 0;
                    loop scan < callCount {
                        if slotEntry[scan] < 0 {
                            nextSlot = scan;
                            break;
                        }
                        scan += 1;
                    }
                    if nextSlot < 0 {
                        suffix := if callCount == 1 { " argument" } else { " arguments" };
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + callCount.toText() + suffix + ", got more");
                    }
                    slotName := types.paramNameOf(callParams[callFirst + nextSlot]);
                    isOverwrittenPos := explicitLabels.contains(slotName);
                    rawPosExpected := if isOverwrittenPos { "" } else { types.paramKindOf(callParams[callFirst + nextSlot]) };
                    slotEntry = ctx.setIntAt(slotEntry, nextSlot, entryCount);
                    if rawPosExpected.startsWithAt(0, "mut ") {
                        lease := tryParseGroupedMutLease(source, cursor, prefix, false);
                        if not lease.matched {
                            if lease.sawMut {
                                if lease.nameEnd > lease.nameStart {
                                    syntax.failAt(source, lease.nameEnd, prefix, "expected ) after mut " + source.slice(lease.nameStart, lease.nameEnd));
                                }
                                syntax.failAt(source, lease.nameStart, prefix, "expected a binding name after mut");
                            }
                            syntax.failAt(source, cursor, prefix, "argument " + (nextSlot + 1).toText() + " of " + calleeDisplay + " requires mut argument");
                        }
                        mNameStart := lease.nameStart;
                        mNameEnd := lease.nameEnd;
                        mRawListName := source.slice(mNameStart, mNameEnd);
                        mLeaseRes := resolveMutLeaseLocal(locals, ctxs, mRawListName, source, mNameStart, prefix);
                        mListName := mLeaseRes.displayName;
                        mIdxRes := mLeaseRes.idx;
                        afterLease := syntax.skipTrivia(source, lease.next, prefix);
                        isMutSubExpr := afterLease < size and (source.at(afterLease) == "[" or source.at(afterLease) == ".");
                        if isMutSubExpr {
                            mutArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, "", 0, ctxs, argIifeDepth, inferMode, "", aliases);
                            if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, mutArg); }
                            if not types.isSliceKind(mutArg.kind) or not sliceBorrows.sliceExprIsMutable(mutArg.textValue) {
                                syntax.failAt(source, cursor, prefix, "mut call expression must resolve to a mutable Slice<T>");
                            }
                            if isGenericCall {
                                rawBaseMut := rawPosExpected.slice(4, rawPosExpected.length());
                                uErr := generics.unifyKindMut(genParams, rawBaseMut, mutArg.kind, mut genBindings);
                                if uErr =!= "" {
                                    syntax.failAt(source, cursor, prefix, "argument " + (nextSlot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                                }
                            }
                            subRootIdx := extractAddressableLocal(locals, locals[mIdxRes].runtime);
                            subRootRt := if subRootIdx >= 0 { locals[subRootIdx].runtime } else { "" };
                            aliasHit := checkMutArgAliasSymmetric(mListName, subRootRt, mutArg.textValue, mutArgRoots, mutArgNames, mutArgProvs);
                            if aliasHit =!= "" {
                                syntax.failAt(source, mNameStart, prefix, "cannot pass " + aliasHit + " multiple times as mut in the same call");
                            }
