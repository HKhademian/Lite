        else if operator.text =!= "**" and numeric.isUnsignedIntKind(left.kind) { left.kind }
        else if operator.text =!= "**" and (left.kind == ir.VALUE_KIND_FLOAT8 or left.kind == ir.VALUE_KIND_FLOAT16 or left.kind == ir.VALUE_KIND_INT) { left.kind }
