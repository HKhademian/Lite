                }
            } else {
                if interTT == "" {
                    if target == ir.TARGET_C {
                        dropLeft := types.cDropFnForKind(left.kind);
                        isFreshL := ctx.isCFreshOwnedExpr(left.code);
                        if dropLeft =!= "" and (isFreshL or left.code.startsWithAt(0, "/*@CBLK:")) {
                            tmpL := freshCOwnedTemp("lt_tt_");
                            tmpR := freshCOwnedTemp("lt_ttr_");
                            lInit := if left.code.startsWithAt(0, "/*@CBLK:") { ctx.cUnwrapIntoVar(tmpL, left.kind, left.code) } else { tmpL + " = " + left.code + ";" };
                            ttCode = "/*@CBLK:" + tmpR + "@*/bool " + tmpR + " = false; { " + types.cValueType(left.kind) + " " + tmpL + "; " + lInit + " " + dropLeft + "(&" + tmpL + "); }";
                        } else if left.code.startsWithAt(0, "/*@CBLK:") {
                            tmpL := freshCOwnedTemp("lt_tt_");
                            tmpR := freshCOwnedTemp("lt_ttr_");
                            ttCode = "/*@CBLK:" + tmpR + "@*/bool " + tmpR + " = false; { " + types.cValueType(left.kind) + " " + tmpL + "; " + ctx.cUnwrapIntoVar(tmpL, left.kind, left.code) + " (void)" + tmpL + "; }";
                        } else {
