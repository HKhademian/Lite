                            tW := freshCOwnedTemp("lt_oa_");
                            mut preBlkStmts.pushBack("/*@LTMP:" + cTW + ":" + tW + "@*/{ " + blkBodyW + " " + tW + " = " + retVarW + "; }");
                            if dFnW =!= "" { mut postCallDrops.pushBack(dFnW + "(&" + tW + ")"); }
                            slotPrepared[targetSlot] = if byPtrW { "&" + tW } else { tW };
                        } else {
                            mut preBlkStmts.pushBack("{ " + blkBodyW + " }");
                            slotPrepared[targetSlot] = ir.targetUnitLiteralCode(target);
                        }
                    } else {
                        tW := freshCOwnedTemp("lt_oa_");
                        mut preBlkStmts.pushBack("/*@LTMP:" + cTW + ":" + tW + "@*/" + tW + " = (" + promotedStk + ");");
                        if dFnW =!= "" and not isCBorrowableLvalue(promotedStk) {
                            mut postCallDrops.pushBack(dFnW + "(&" + tW + ")");
                        }
                        slotPrepared[targetSlot] = if byPtrW { "&" + tW } else { tW };
                    }
                }
            }
            kIdx = kIdx + 1;
        }
        mut reorderedArgs: List<String> = [];
        if hasRecv {
            if target == ir.TARGET_C {
                mut reorderedArgs.pushBack(prepCCallArg(isUserCModuleFn, effRuntime, recvExpectedKind, recvCode, mut preBlkStmts, mut postCallDrops));
            } else {
                mut reorderedArgs.pushBack(recvCode);
            }
        }
        var sIdx := 0;
        loop sIdx < callCount {
            k := slotEntry[sIdx];
            argExpected := if isGenericCall { substSlotKinds[sIdx] } else { types.paramKindOf(callParams[callFirst + sIdx]) };
            isOptSlot := types.paramIsOptional(callParams[callFirst + sIdx]);
            isMutP := argExpected.startsWithAt(0, "mut ");
            baseP := if isMutP { argExpected.slice(4, argExpected.length()) } else { argExpected };
            if k < 0 {
                mut reorderedArgs.pushBack("false");
                mut reorderedArgs.pushBack(ctx.zeroParsed(target, baseP, errPos).code);
            } else {
                if isOptSlot {
                    mut reorderedArgs.pushBack("true");
                }
                mut reorderedArgs.pushBack(slotPrepared[sIdx]);
            }
            sIdx = sIdx + 1;
        }
        if ctxProjArg =!= "" {
            mut reorderedArgs.pushBack(ctxProjArg);
        }
        callExpr := if not isModuleFn {
            callFnKind := types.fnCanonicalKindWithCtx(callParams, callFirst, callCount, effResult, effCtxKind);
            callFnTag := types.cFnTag(callFnKind);
            cCallArgs := if reorderedArgs.length() > 0 { effRuntime + ", " + reorderedArgs.join(", ") } else { effRuntime };
            "/*@T:" + callFnKind + "@*/" + callFnTag + "_call(" + cCallArgs + ")"
        } else {
            effRuntime + "(" + reorderedArgs.join(", ") + ")"
        };
        wrappedReordered := if preBlkStmts.length() > 0 {
            dropsStmt := if postCallDrops.length() > 0 { postCallDrops.join("; ") + "; " } else { "" };
            if effResult == ir.VALUE_KIND_UNIT or effResult == ir.VALUE_KIND_NEVER {
                "/*@CBLK:0@*/{ " + preBlkStmts.join(" ") + " (void)(" + callExpr + "); " + dropsStmt + "}"
            } else {
                cRv := freshCOwnedTemp("lt_or_");
                cRt := types.cValueType(effResult);
                "/*@CBLK:" + cRv + "@*/" + cRt + " " + cRv + "; { " + preBlkStmts.join(" ") + " " + cRv + " = (" + callExpr + "); " + dropsStmt + "}"
            }
        } else if target == ir.TARGET_C and postCallDrops.length() > 0 {
            cWrapExprWithPostDrops(effResult, callExpr, postCallDrops)
        } else {
            callExpr
        };
        emittedCode = wrappedReordered;
    } else {
        mut evalStmts: List<String> = [];
        if not isModuleFn {
            mut evalStmts.pushBack("const lite$fn = " + effRuntime + ";");
        }
        if hasRecv {
            mut evalStmts.pushBack("const lite$recv = " + recvCode + ";");
        }
        var callDiverged := false;
        var kIdx := 0;
        loop kIdx < entryCount {
            if not callDiverged {
                targetSlot := entrySlots[kIdx];
                if entryKinds[kIdx] == ir.VALUE_KIND_NEVER {
                    mut evalStmts.pushBack("return " + entryCodes[kIdx] + ";");
                    callDiverged = true;
                } else if slotEntry[targetSlot] == kIdx {
                    temp := "lite$arg" + kIdx.toText();
                    argExpected := if isGenericCall { substSlotKinds[targetSlot] } else { types.paramKindOf(callParams[callFirst + targetSlot]) };
                    isMutP := argExpected.startsWithAt(0, "mut ");
                    baseP := if isMutP { argExpected.slice(4, argExpected.length()) } else { argExpected };
                    mut dummyDrops: List<String> = [];
                    argRhs := if types.isDynKind(baseP) {
                        dynArg := coerceToDynIfNeeded(target, source, entryPositions[kIdx], prefix, baseP, isMutP,
                        if entryKinds[kIdx].startsWithAt(0, "mut ") { entryKinds[kIdx].slice(4, entryKinds[kIdx].length()) } else { entryKinds[kIdx] },
                        entryCodes[kIdx], entryProvs[kIdx], true, locals, functions, mut dummyDrops);
                        dynArg.code
                    } else if argExpected.startsWithAt(0, "mut ") {
                        entryCodes[kIdx]
                    } else {
                        needsSnap := readOnlyArgNeedsSnapshot(entryCodes[kIdx], locals, mutArgRuntimes, callClosureHazard, calleeMutGlobalHazard);
                        ctx.readOnlyArgWithSnapshot(target, argExpected, entryKinds[kIdx], entryCodes[kIdx], needsSnap)
                    };
                    mut evalStmts.pushBack("const " + temp + " = " + argRhs + ";");
                } else {
                    mut evalStmts.pushBack("void (" + entryCodes[kIdx] + ");");
                }
            }
            kIdx = kIdx + 1;
        }
        if callDiverged {
            emittedCode = "(() => { " + evalStmts.join(" ") + " })()";
            emittedResultKind = ir.VALUE_KIND_NEVER;
        } else {
            mut slotTemps: List<String> = [];
            if hasRecv { mut slotTemps.pushBack("lite$recv"); }
            var sIdx := 0;
            loop sIdx < callCount {
                if slotEntry[sIdx] < 0 {
                    mut slotTemps.pushBack("undefined");
                } else {
                    mut slotTemps.pushBack("lite$arg" + slotEntry[sIdx].toText());
                }
                sIdx = sIdx + 1;
            }
            if ctxProjArg =!= "" { mut slotTemps.pushBack(ctxProjArg); }
            targetCallee := if isModuleFn { effRuntime } else { "lite$fn" };
            callExpr := targetCallee + "(" + slotTemps.join(", ") + ")";
            retStmt := if effResult == ir.VALUE_KIND_UNIT { "void (" + callExpr + "); return undefined;" } else { "return " + callExpr + ";" };
            emittedCode = "(() => { " + evalStmts.join(" ") + " " + retStmt + " })()";
        }
    }
    if target == ir.TARGET_TS and mutRecBoxNames.length() > 0 {
        mut wbSetup: List<String> = [];
        var bi := 0;
        bCount := mutRecBoxNames.length();
        loop bi < bCount {
            bName := mutRecBoxNames[bi];
            bLoc := mutRecLocalRuntimes[bi];
            bTsType := types.tsFunctionType(mutRecKinds[bi]);
            wbStmt := mutRecWritebackStmts[bi];
            setBody := if wbStmt =!= "" { wbStmt } else { bLoc + " = lite$nv;" };
            mut wbSetup.pushBack("const " + bName + ": { v: " + bTsType + " } = { get v(): " + bTsType + " { return " + bLoc + "; }, set v(lite$nv: " + bTsType + ") { " + setBody + " } };");
            bi = bi + 1;
        }
        if emittedResultKind == ir.VALUE_KIND_NEVER {
            emittedCode = "(((): never => { " + wbSetup.join(" ") + " return " + emittedCode + "; })())";
        } else if emittedResultKind == ir.VALUE_KIND_UNIT {
            emittedCode = "(() => { " + wbSetup.join(" ") + " void (" + emittedCode + "); return undefined; })()";
        } else {
            emittedCode = "(((): " + types.tsFunctionType(emittedResultKind) + " => { " + wbSetup.join(" ") + " return " + emittedCode + "; })())";
        }
    }
    ctx.withMarkers((kind = emittedResultKind, code = emittedCode, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers)
};

/** Prepares one C11 argument/receiver expression for a user/module/indirect call (stack-closure promotion, `const *` borrow, and `@LTMP` cleanup). */
prepCCallArg := fn(isUserMod: Bool, effRuntime: String, expectedKind: String, rawCode: String, preBlkStmts: mut List<String>, postDrops: mut List<String>): String {
    if effRuntime == "lite$extraCanvasRun" and expectedKind.startsWithAt(0, "fn(") {
        stk := promoteCStackClosure(rawCode);
        if stk.ok { return stk.code; }
    }
    if expectedKind.startsWithAt(0, "mut ") {
        return rawCode;
    }
    byPtr := isUserMod and types.cParamIsConstPtr(expectedKind);
    if not byPtr and types.cDropFnForKind(expectedKind) == "" {
        return rawCode;
    }
    if rawCode.startsWithAt(0, "/*@CBLK:") {
        endHdr := rawCode.indexOf("@*/", 8);
        if endHdr > 8 {
            retVar := rawCode.slice(8, endHdr);
            blkBody := rawCode.slice(endHdr + 3, rawCode.length());
            if retVar =!= "" and retVar =!= "0" {
                t := freshCOwnedTemp("lt_ot_");
                cT := types.cValueType(expectedKind);
                mut preBlkStmts.pushBack("/*@LTMP:" + cT + ":" + t + "@*/{ " + blkBody + " " + t + " = " + retVar + "; }");
                dFn := types.cDropFnForKind(expectedKind);
                if dFn =!= "" { mut postDrops.pushBack(dFn + "(&" + t + ")"); }
                return if byPtr { "&" + t } else { t };
            }
        }
    }
    b := cBorrowExprWithPostDrop(expectedKind, rawCode, byPtr);
    if b.drop =!= "" { mut postDrops.pushBack(b.drop); }
    b.expr
};

/** Parses user and indirect function calls with positional, named, and `=name` shorthand arguments. */
parseUserOrIndirectCall := fn(target: String, source: String, openParen: Int, errPos: Int, isModuleFn: Bool, calleeDisplay: String, callRuntime: String, callParams: List<String>, callFirst: Int, callCount: Int, callResult: String, callCtxKind: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    parseUserOrIndirectCallWithRecv(target, source, openParen, errPos, isModuleFn, calleeDisplay, callRuntime, callParams, callFirst, callCount, callResult, callCtxKind, false, "", "", "", "", "", "", "", callExpectedRet, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases)
};

/** Emits target code for `Rc<T>` hard-builtin operations shared between method and static call forms. */
emitRcHardOpCode := fn(
target: String, runtime: String, rcKind: String,
recvCode: String, mutRt: String, argCode: String, labelStart: Int
): (kind: String, code: String) {
    elemKind := types.rcElementKind(rcKind);
    rTag := if target == ir.TARGET_C { types.cRcTag(rcKind) } else { "" };
    if runtime == "lite$core$rc$isEmpty:v1" {
        c := if rTag =!= "" {
            rb := cBorrowExprWithPostDrop(rcKind, recvCode, false);
            mut reDrops: List<String> = [];
            if rb.drop =!= "" { mut reDrops.pushBack(rb.drop); }
            cWrapExprWithPostDrops(ir.VALUE_KIND_BOOL, "((" + rb.expr + ").box == NULL)", reDrops)
        } else { "((" + recvCode + ").box === null)" };
        return (kind = ir.VALUE_KIND_BOOL, code = c);
    }
    if runtime == "lite$core$rc$strongCount:v1" {
        c := if rTag =!= "" {
            rb := cBorrowExprWithPostDrop(rcKind, recvCode, false);
            mut rcDrops: List<String> = [];
            if rb.drop =!= "" { mut rcDrops.pushBack(rb.drop); }
            cWrapExprWithPostDrops(ir.VALUE_KIND_INT, rTag + "_count(" + rb.expr + ")", rcDrops)
        } else { "((" + recvCode + ").box === null ? 0n : BigInt((" + recvCode + ").box.count))" };
        return (kind = ir.VALUE_KIND_INT, code = c);
    }
    if runtime == "lite$core$rc$get:v1" {
        c := if rTag =!= "" {
            rb := cBorrowExprWithPostDrop(rcKind, recvCode, false);
            mut rgDrops: List<String> = [];
            if rb.drop =!= "" { mut rgDrops.pushBack(rb.drop); }
            cWrapExprWithPostDrops(elemKind, rTag + "_get(" + rb.expr + ")", rgDrops)
        } else {
            ctx.copiedValueCode(target, elemKind, "lite$rcGet(" + recvCode + ", " + labelStart.toText() + ")")
        };
        return (kind = elemKind, code = c);
    }
    if runtime == "lite$core$rc$share:v1" {
        c := if rTag =!= "" {
            rb := cBorrowExprWithPostDrop(rcKind, recvCode, false);
            mut shDrops: List<String> = [];
            if rb.drop =!= "" { mut shDrops.pushBack(rb.drop); }
            cWrapExprWithPostDrops(rcKind, "/*@T:" + rcKind + "@*/" + rTag + "_copy(" + rb.expr + ")", shDrops)
        } else {
            "lite$rcShare(" + recvCode + ")"
        };
        return (kind = rcKind, code = c);
    }
    if runtime == "lite$core$rc$makeUnique:v1" {
        c := if rTag =!= "" {
            rTag + "_make_unique(&" + mutRt + ")"
        } else {
            tsEl := types.tsFunctionType(elemKind);
            cloneBody := ctx.copiedValueCode(target, elemKind, "lite$rc_v");
            if cloneBody == "lite$rc_v" {
                "lite$rcMakeUnique(" + mutRt + ")"
            } else {
                "lite$rcMakeUniqueClone(" + mutRt + ", (lite$rc_v: " + tsEl + "): " + tsEl + " => " + cloneBody + ")"
            }
        };
        return (kind = ir.VALUE_KIND_UNIT, code = c);
    }
    if runtime == "lite$core$rc$reset:v1" {
        c := if rTag =!= "" {
            "(" + rTag + "_drop(&" + mutRt + "), (void)0)"
        } else {
            "lite$rcReset(" + mutRt + ")"
        };
        return (kind = ir.VALUE_KIND_UNIT, code = c);
    }
    if runtime == "lite$core$rc$replace:v1" {
        c := if rTag =!= "" {
            rTag + "_replace(&" + mutRt + ", " + argCode + ")"
        } else {
            "lite$rcReplace(" + mutRt + ", " + argCode + ")"
        };
        return (kind = ir.VALUE_KIND_UNIT, code = c);
    }
    eqCode := if rTag =!= "" {
        ra := cBorrowExprWithPostDrop(rcKind, recvCode, false);
        rb := cBorrowExprWithPostDrop(rcKind, argCode, false);
        mut eqDrops: List<String> = [];
        if ra.drop =!= "" { mut eqDrops.pushBack(ra.drop); }
        if rb.drop =!= "" { mut eqDrops.pushBack(rb.drop); }
        cWrapExprWithPostDrops(ir.VALUE_KIND_BOOL, "((" + ra.expr + ").box == (" + rb.expr + ").box)", eqDrops)
    } else {
        "((" + recvCode + ").box === (" + argCode + ").box)"
    };
    (kind = ir.VALUE_KIND_BOOL, code = eqCode)
};

/** Looks up field index, JS prop name, and canonical kind for column `colName` in `SoA<R>`, or `idx = -1`. */
soaColInfo := fn(soaKind: String, colName: String): (idx: Int, prop: String, kind: String) {
    recK := types.soaRecordKind(soaKind);
    fc := types.recordComponentCount(recK);
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recK, fi);
        if comp.label == colName {
            return (idx = fi, prop = comp.prop, kind = comp.kind);
        }
        fi = fi + 1;
    }
    (idx = -1, prop = "", kind = "")
};

/** Emits zero-copy borrowed `Slice<ColKind>` expression for `soaCode.<colName>`. */
emitSoaColumnSliceCode := fn(target: String, soaKind: String, soaCode: String, colIdx: Int, colProp: String, colKind: String): String {
    sliceKind := "Slice<" + colKind + ">";
    if target == ir.TARGET_C {
        return "/*@T:" + sliceKind + "@*/" + types.cSoaTag(soaKind) + "_col_" + colIdx.toText() + "(" + soaCode + ")";
    }
    "/*@T:" + sliceKind + "@*/({ data: (" + soaCode + ")." + colProp + ", off: 0, len: (" + soaCode + ")." + colProp + ".length })"
};

/** Emits TS checked binary arithmetic (`+`, `-`, `*`, `/`) for a `Simd<T, N>` lane element type `elKind`. */
tsSimdBinOpCode := fn(elKind: String, op: String, a: String, b: String, pos: Int): String {
    if elKind == ir.VALUE_KIND_FLOAT32 {
        ir.targetFloat32BinaryCode(ir.TARGET_TS, op, a, b, pos)
    } else if elKind == ir.VALUE_KIND_FLOAT {
        ir.targetFloatBinaryCode(ir.TARGET_TS, op, a, b, pos)
    } else {
        ctx.runtimeTypedIntegerCode(ir.TARGET_TS, elKind, op, a, b, pos)
    }
};

/** Emits TS checked unary negation (`-v`) for a signed `Simd<T, N>` lane element type `elKind`. */
tsSimdNegCode := fn(elKind: String, v: String, pos: Int): String {
    if elKind == ir.VALUE_KIND_FLOAT32 {
        "(Math.fround(-(" + v + ")))"
    } else if elKind == ir.VALUE_KIND_FLOAT {
        "(-(" + v + "))"
    } else if elKind == ir.VALUE_KIND_INT {
        ir.targetIntNegateCode(ir.TARGET_TS, v, pos)
    } else {
        ctx.runtimeTypedIntegerCode(ir.TARGET_TS, elKind, "-", "0n", v, pos)
    }
};

/** Emits TypeScript empty `SoA<R>` object literal expression. */
emitTsSoaZeroCode := fn(recKind: String): String {
    fc := types.recordComponentCount(recKind);
    mut cols: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut cols.pushBack(comp.prop + ": []");
        fi = fi + 1;
    }
    "({ " + cols.join(", ") + " } as " + types.tsFunctionType("SoA<" + recKind + ">") + ")"
};

/** Emits TypeScript `SoA<R>.get` / `uncheckedGet` / `$getIndex` expression. */
emitTsSoaGetCode := fn(recKind: String, soaCode: String, idxCode: String, errPos: Int, uncheckedOp: Bool): String {
    fc := types.recordComponentCount(recKind);
    firstProp := types.recordComponent(recKind, 0).prop;
    mut fields: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        copiedF := ctx.copiedValueCode(ir.TARGET_TS, comp.kind, "lite$s." + comp.prop + "[lite$si]!");
        mut fields.pushBack(comp.prop + ": " + copiedF);
        fi = fi + 1;
    }
    chkFlag := if uncheckedOp { "false" } else { "true" };
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + ", lite$si: number) => ({ " + fields.join(", ") + " }))(" + soaCode + ", lite$soaCheckIdx(" + idxCode + ", (" + soaCode + ")." + firstProp + ".length, " + errPos.toText() + ", " + chkFlag + "))"
};

/** Emits TypeScript `SoA<R>.set` / `uncheckedSet` / `$setIndex` expression. */
emitTsSoaSetCode := fn(recKind: String, soaMutRt: String, idxCode: String, rowCode: String, errPos: Int, uncheckedOp: Bool): String {
    fc := types.recordComponentCount(recKind);
    firstProp := types.recordComponent(recKind, 0).prop;
    mut assigns: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut assigns.pushBack("lite$s." + comp.prop + "[lite$si] = lite$r." + comp.prop + ";");
        fi = fi + 1;
    }
    chkFlag := if uncheckedOp { "false" } else { "true" };
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + ", lite$si: number, lite$r: " + types.tsFunctionType(recKind) + "): void => { " + assigns.join(" ") + " })(" + soaMutRt + ", lite$soaCheckIdx(" + idxCode + ", (" + soaMutRt + ")." + firstProp + ".length, " + errPos.toText() + ", " + chkFlag + "), " + rowCode + ")"
};

/** Emits TypeScript `SoA<R>.pushBack` expression. */
emitTsSoaPushCode := fn(recKind: String, soaMutRt: String, rowCode: String): String {
    fc := types.recordComponentCount(recKind);
    mut pushes: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut pushes.pushBack("lite$s." + comp.prop + ".push(lite$r." + comp.prop + ");");
        fi = fi + 1;
    }
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + ", lite$r: " + types.tsFunctionType(recKind) + "): void => { " + pushes.join(" ") + " })(" + soaMutRt + ", " + rowCode + ")"
};

/** Emits TypeScript `SoA<R>.clear` expression. */
emitTsSoaClearCode := fn(recKind: String, soaMutRt: String): String {
    fc := types.recordComponentCount(recKind);
    mut clears: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut clears.pushBack("lite$s." + comp.prop + ".length = 0;");
        fi = fi + 1;
    }
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + "): void => { " + clears.join(" ") + " })(" + soaMutRt + ")"
};

/** Emits TypeScript `SoA<R>.popBack` expression. */
emitTsSoaPopCode := fn(recKind: String, soaMutRt: String, errPos: Int): String {
    fc := types.recordComponentCount(recKind);
    firstProp := types.recordComponent(recKind, 0).prop;
    mut pops: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut pops.pushBack(comp.prop + ": lite$s." + comp.prop + ".pop()!");
        fi = fi + 1;
    }
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + "): " + types.tsFunctionType(recKind) + " => { if (lite$s." + firstProp + ".length === 0) lite$soaEmptyFault(" + errPos.toText() + "); return { " + pops.join(", ") + " }; })(" + soaMutRt + ")"
};

/** Emits TypeScript `SoA<R>.swapRemove` expression. */
emitTsSoaSwapRemoveCode := fn(recKind: String, soaMutRt: String, idxCode: String, errPos: Int): String {
    fc := types.recordComponentCount(recKind);
    firstProp := types.recordComponent(recKind, 0).prop;
    mut reads: List<String> = [];
    mut swaps: List<String> = [];
    mut pops: List<String> = [];
    var fi := 0;
    loop fi < fc {
        comp := types.recordComponent(recKind, fi);
        mut reads.pushBack(comp.prop + ": lite$s." + comp.prop + "[lite$si]!");
        mut swaps.pushBack("lite$s." + comp.prop + "[lite$si] = lite$s." + comp.prop + "[lite$last]!;");
        mut pops.pushBack("lite$s." + comp.prop + ".pop();");
        fi = fi + 1;
    }
    "((lite$s: " + types.tsFunctionType("SoA<" + recKind + ">") + ", lite$si: number): " + types.tsFunctionType(recKind) + " => { const lite$last = lite$s." + firstProp + ".length - 1; const lite$res = { " + reads.join(", ") + " }; if (lite$si !== lite$last) { " + swaps.join(" ") + " } " + pops.join(" ") + " return lite$res; })(" + soaMutRt + ", lite$soaCheckIdx(" + idxCode + ", (" + soaMutRt + ")." + firstProp + ".length, " + errPos.toText() + ", true))"
};

/** Parses explicit `<T, N>` or `<T>` on a static `Simd.*` intrinsic call when not already supplied on the receiver type. */
parseSimdCallExplicitShape := fn(source: String, cursorIn: Int, expectSingleT: Bool, prefix: String, aliases: List<AliasDecl>, inferMode: Bool): (matched: Bool, kind: String, elemKind: String, next: Int) {
    size := source.length();
    if cursorIn >= size or source.at(cursorIn) =!= "<" {
        return (matched = false, kind = "", elemKind = "", next = cursorIn);
    }
    tStart := syntax.skipTrivia(source, cursorIn + 1, prefix);
    if tStart >= size or source.at(tStart) == ">" {
        syntax.failAt(source, tStart, prefix, "expected a Simd element type");
    }
    tParsed := if inferMode {
        emptySeen: List<String> = [];
        canT := types.canResolveTypeAt(source, tStart, prefix, aliases, "", emptySeen, 32);
        if not canT.ok {
            return (matched = false, kind = "", elemKind = "", next = cursorIn);
        }
        (kind = canT.kind, next = canT.next)
    } else {
        types.parseTypeAt(source, tStart, prefix, aliases, "Simd element", "")
    };
    if not types.isSimdElemKind(tParsed.kind) {
        syntax.failAt(source, tStart, prefix, "unsupported Simd lane type " + types.displayKind(tParsed.kind));
    }
    if expectSingleT {
        gt := syntax.expectSymbol(source, syntax.skipTrivia(source, tParsed.next, prefix), ">", prefix);
        return (matched = true, kind = "", elemKind = tParsed.kind, next = syntax.skipTrivia(source, gt, prefix));
    }
    afterT := syntax.skipTrivia(source, tParsed.next, prefix);
    if afterT < size and source.at(afterT) == ">" {
        syntax.failAt(source, tStart, prefix, "Simd requires two arguments: Simd<T, N> (runtime-scalable or sizeless SIMD vectors are not supported)");
    }
    comma := syntax.expectSymbol(source, afterT, ",", prefix);
    extStart := syntax.skipTrivia(source, comma, prefix);
    if extStart < size and source.at(extStart) == "*" {
        syntax.failAt(source, extStart, prefix, "runtime-scalable or sizeless SIMD vectors are not supported; expected compile-time power-of-two lane count N");
    }
    var extEnd := extStart;
    loop extEnd < size and source.at(extEnd).isDigit() { extEnd = extEnd + 1; }
    if extEnd == extStart {
        syntax.failAt(source, extStart, prefix, "expected positive power-of-two lane count N in Simd<T, N>");
    }
    n := syntax.parseDigits(source, extStart, extEnd);
    if not types.isValidSimdLaneCount(tParsed.kind, n) {
        syntax.failAt(source, extStart, prefix, "unsupported Simd shape Simd<" + types.displayKind(tParsed.kind) + ", " + n.toText() + ">");
    }
    gt := syntax.expectSymbol(source, syntax.skipTrivia(source, extEnd, prefix), ">", prefix);
    (matched = true, kind = "Simd<" + tParsed.kind + "," + n.toText() + ">", elemKind = tParsed.kind, next = syntax.skipTrivia(source, gt, prefix))
};

/** Parses `Simd.*` static constructor/query calls (`splat`, `fromArray`, `load`, `nativeLanes`). */
parseSimdStaticIntrinsicCall := fn(
target: String, source: String, runtime: String, errPos: Int, postPos: Int, explicitSimdIn: String,
prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>,
currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>
): Parsed {
    var cursor := syntax.skipTrivia(source, postPos, prefix);
    if runtime == "lite$core$simd$nativeLanes:v1" {
        var elemKind := if explicitSimdIn =!= "" and types.isSimdKind(explicitSimdIn) { types.simdElementKind(explicitSimdIn) } else { "" };
        if elemKind == "" {
            sh := parseSimdCallExplicitShape(source, cursor, true, prefix, aliases, inferMode);
            if not sh.matched {
                if inferMode { return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos); }
                syntax.failAt(source, errPos, prefix, "Simd.nativeLanes requires element type argument <T>");
            }
            elemKind = sh.elemKind;
            cursor = sh.next;
        }
        openParen := syntax.expectSymbol(source, cursor, "(", prefix);
        close := syntax.expectSymbol(source, syntax.skipTrivia(source, openParen, prefix), ")", prefix);
        nLanes := types.simdNativeLaneCount(elemKind);
        cCode := if target == ir.TARGET_C { "(INT64_C(" + nLanes.toText() + "))" } else { nLanes.toText() + "n" };
        return (kind = ir.VALUE_KIND_INT, code = cCode, intValue = nLanes, textValue = "", constant = true, next = close);
    }
    var targetSimdKind := if explicitSimdIn =!= "" and types.isSimdKind(explicitSimdIn) { explicitSimdIn } else { "" };
    if targetSimdKind == "" and cursor < source.length() and source.at(cursor) == "<" {
        sh := parseSimdCallExplicitShape(source, cursor, false, prefix, aliases, inferMode);
        if not sh.matched {
            return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos);
        }
        targetSimdKind = sh.kind;
        cursor = sh.next;
    }
    if targetSimdKind == "" and runtime =!= "lite$core$simd$fromArray:v1" and expected =!= "" and types.isSimdKind(expected) {
        targetSimdKind = expected;
    }
    openParen := syntax.expectSymbol(source, cursor, "(", prefix);
    argStart := syntax.skipTrivia(source, openParen, prefix);
    if runtime == "lite$core$simd$splat:v1" {
        if targetSimdKind == "" {
            if inferMode { return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos); }
            syntax.failAt(source, errPos, prefix, "Simd.splat requires explicit Simd<T, N> type");
        }
        elK := types.simdElementKind(targetSimdKind);
        n := types.simdLaneCount(targetSimdKind);
        valArg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, elK, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elK, valArg.kind) {
            syntax.failAt(source, argStart, prefix, "Simd.splat expects " + types.displayKind(elK) + ", got " + types.displayKind(valArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
        vCode := ctx.assignValueCode(target, elK, valArg.kind, valArg.code);
        outCode := if target == ir.TARGET_C {
            "/*@T:" + targetSimdKind + "@*/" + types.cSimdTag(targetSimdKind) + "_splat(" + vCode + ")"
        } else {
            "lite$simdSplat(" + vCode + ", " + n.toText() + ")"
        };
        return ctx.withMarkers((kind = targetSimdKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", valArg) } else { "" });
    }
    if runtime == "lite$core$simd$fromArray:v1" {
        expArr := if targetSimdKind =!= "" { "[" + types.simdElementKind(targetSimdKind) + ";" + types.simdLaneCount(targetSimdKind).toText() + "]" } else { "" };
        arrArg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, expArr, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isArrayKind(arrArg.kind) or types.arrayExtent(arrArg.kind) <= 1 {
            syntax.failAt(source, argStart, prefix, "Simd.fromArray expects a fixed-size [T; N] array, got " + types.displayKind(arrArg.kind));
        }
        arrEl := types.arrayElementKind(arrArg.kind);
        arrN := types.arrayExtent(arrArg.kind);
        if targetSimdKind == "" {
            if not types.isValidSimdLaneCount(arrEl, arrN) {
                syntax.failAt(source, argStart, prefix, "unsupported Simd array shape [" + types.displayKind(arrEl) + "; " + arrN.toText() + "]");
            }
            targetSimdKind = "Simd<" + arrEl + "," + arrN.toText() + ">";
        } else {
            reqArr := "[" + types.simdElementKind(targetSimdKind) + ";" + types.simdLaneCount(targetSimdKind).toText() + "]";
            if not types.isCompatibleKind(reqArr, arrArg.kind) {
                syntax.failAt(source, argStart, prefix, "Simd.fromArray expects " + types.displayKind(reqArr) + ", got " + types.displayKind(arrArg.kind));
            }
        }
        close := ctx.expectNonemptyCallClose(source, arrArg.next, prefix);
        reqArrFinal := "[" + types.simdElementKind(targetSimdKind) + ";" + types.simdLaneCount(targetSimdKind).toText() + "]";
        aCode := ctx.assignValueCode(target, reqArrFinal, arrArg.kind, arrArg.code);
        outCode := if target == ir.TARGET_C {
            "/*@T:" + targetSimdKind + "@*/" + types.cSimdTag(targetSimdKind) + "_from_arr(" + aCode + ")"
        } else {
            "lite$simdFromArray(" + aCode + ")"
        };
        return ctx.withMarkers((kind = targetSimdKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", arrArg) } else { "" });
    }
    /* lite$core$simd$load:v1 */
    slArg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, if targetSimdKind =!= "" { "Slice<" + types.simdElementKind(targetSimdKind) + ">" } else { "" }, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if targetSimdKind == "" {
        if inferMode { return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos); }
        syntax.failAt(source, errPos, prefix, "Simd.load requires explicit Simd<T, N> type");
    }
    elK := types.simdElementKind(targetSimdKind);
    n := types.simdLaneCount(targetSimdKind);
    reqSlice := "Slice<" + elK + ">";
    if not types.isCompatibleKind(reqSlice, slArg.kind) {
        syntax.failAt(source, argStart, prefix, "Simd.load expects " + types.displayKind(reqSlice) + ", got " + types.displayKind(slArg.kind));
    }
    comma := syntax.expectSymbol(source, syntax.skipTrivia(source, slArg.next, prefix), ",", prefix);
    offStart := syntax.skipTrivia(source, comma, prefix);
    offArg := parseBinaryCtx(target, source, offStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not numeric.isIntKind(offArg.kind) {
        syntax.failAt(source, offStart, prefix, "Simd.load offset must be Int, got " + types.displayKind(offArg.kind));
    }
    close := ctx.expectNonemptyCallClose(source, offArg.next, prefix);
    offCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, offArg.kind, offArg.code);
    outCode := if target == ir.TARGET_C {
        "/*@T:" + targetSimdKind + "@*/" + types.cSimdTag(targetSimdKind) + "_load(" + slArg.code + ", " + offCode + ", " + errPos.toText() + ")"
    } else {
        "lite$simdLoad(" + slArg.code + ", " + offCode + ", " + n.toText() + ", " + errPos.toText() + ")"
    };
    ctx.withMarkers((kind = targetSimdKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close),
    if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", slArg), offArg) } else { "" })
};

/** Parses `SoA.create()` and `SoA.withCapacity(cap)` static constructors. */
parseSoaStaticIntrinsicCall := fn(
target: String, source: String, runtime: String, errPos: Int, postPos: Int, explicitSoaIn: String,
prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>,
currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>
): Parsed {
    var cursor := syntax.skipTrivia(source, postPos, prefix);
    var targetSoaKind := if explicitSoaIn =!= "" and types.isSoaKind(explicitSoaIn) { explicitSoaIn } else { "" };
    if targetSoaKind == "" and cursor < source.length() and source.at(cursor) == "<" {
        rStart := syntax.skipTrivia(source, cursor + 1, prefix);
        if inferMode {
            emptySeen: List<String> = [];
            canR := types.canResolveTypeAt(source, rStart, prefix, aliases, "", emptySeen, 32);
            if not canR.ok {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos);
            }
            if not types.isRecordKind(canR.kind) or types.recordComponentCount(canR.kind) == 0 or types.containsSliceKind(canR.kind) {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos);
            }
            gt := syntax.expectSymbol(source, syntax.skipTrivia(source, canR.next, prefix), ">", prefix);
            targetSoaKind = "SoA<" + canR.kind + ">";
            cursor = syntax.skipTrivia(source, gt, prefix);
        } else {
            pR := types.parseTypeAt(source, rStart, prefix, aliases, "SoA record type", "");
            if types.containsSliceKind(pR.kind) {
                syntax.failAt(source, rStart, prefix, "borrowed Slice<T> cannot be stored in owning container or type definition");
            }
            if not types.isRecordKind(pR.kind) or types.recordComponentCount(pR.kind) == 0 {
                syntax.failAt(source, rStart, prefix, "SoA<R> requires a non-empty record type, got " + types.displayKind(pR.kind));
            }
            gt := syntax.expectSymbol(source, syntax.skipTrivia(source, pR.next, prefix), ">", prefix);
            targetSoaKind = "SoA<" + pR.kind + ">";
            cursor = syntax.skipTrivia(source, gt, prefix);
        }
    }
    if targetSoaKind == "" and expected =!= "" and types.isSoaKind(expected) {
        targetSoaKind = expected;
    }
    if targetSoaKind == "" {
        if inferMode { return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos); }
        syntax.failAt(source, errPos, prefix, "SoA constructor requires record type argument R");
    }
    recKind := types.soaRecordKind(targetSoaKind);
    sTag := if target == ir.TARGET_C { types.cSoaTag(targetSoaKind) } else { "" };
    openParen := syntax.expectSymbol(source, cursor, "(", prefix);
    if runtime == "lite$core$soa$create:v1" {
        close := syntax.expectSymbol(source, syntax.skipTrivia(source, openParen, prefix), ")", prefix);
        outCode := if target == ir.TARGET_C {
            "/*@T:" + targetSoaKind + "@*/((" + sTag + "){ .len = 0 })"
        } else {
            emitTsSoaZeroCode(recKind)
        };
        return (kind = targetSoaKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close);
    }
    capStart := syntax.skipTrivia(source, openParen, prefix);
    capArg := parseBinaryCtx(target, source, capStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not numeric.isIntKind(capArg.kind) {
        syntax.failAt(source, capStart, prefix, "SoA.withCapacity expects Int, got " + types.displayKind(capArg.kind));
    }
    close := ctx.expectNonemptyCallClose(source, capArg.next, prefix);
    cCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, capArg.kind, capArg.code);
    outCode := if target == ir.TARGET_C {
        "/*@T:" + targetSoaKind + "@*/" + sTag + "_with_cap(" + cCode + ", " + errPos.toText() + ")"
    } else {
        "(lite$soaCheckCap(" + cCode + ", " + errPos.toText() + "), " + emitTsSoaZeroCode(recKind) + ")"
    };
    ctx.withMarkers((kind = targetSoaKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close),
    if inferMode { ctx.collectParsedMarkers("", capArg) } else { "" })
};

/** Parses `Rc.create(val)`, `Rc<T>.create(val)`, or `Rc.create<T>(val)`. */
parseRcCreateIntrinsicCall := fn(
target: String, source: String, errPos: Int, postPos: Int, explicitElemIn: String,
prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>,
currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>
): Parsed {
    var cursor := postPos;
    var explicitElem := explicitElemIn;
    if explicitElem == "" and cursor < source.length() and source.at(cursor) == "<" {
        tpStart := syntax.skipTrivia(source, cursor + 1, prefix);
        if inferMode {
            emptySeen: List<String> = [];
            canT := types.canResolveTypeAt(source, tpStart, prefix, aliases, "", emptySeen, 32);
            if not canT.ok {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = postPos);
            }
            explicitElem = canT.kind;
            gt := syntax.expectSymbol(source, syntax.skipTrivia(source, canT.next, prefix), ">", prefix);
            cursor = syntax.skipTrivia(source, gt, prefix);
        } else {
            pt := types.parseTypeAt(source, tpStart, prefix, aliases, "Rc element type", "");
            explicitElem = pt.kind;
            gt := syntax.expectSymbol(source, syntax.skipTrivia(source, pt.next, prefix), ">", prefix);
            cursor = syntax.skipTrivia(source, gt, prefix);
        }
    }
    openParen := syntax.expectSymbol(source, cursor, "(", prefix);
    argStart := syntax.skipTrivia(source, openParen, prefix);
    expValKind := if explicitElem =!= "" {
        explicitElem
    } else if expected =!= "" and types.isRcKind(expected) {
        types.rcElementKind(expected)
    } else {
        ""
    };
    valArg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, expValKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if explicitElem =!= "" and not types.isCompatibleKind(explicitElem, valArg.kind) {
        syntax.failAt(source, argStart, prefix, "Rc.create expects " + types.displayKind(explicitElem) + ", got " + types.displayKind(valArg.kind));
    }
    elemKind := if explicitElem =!= "" { explicitElem } else { valArg.kind };
    if elemKind == ir.VALUE_KIND_UNIT or elemKind == ir.VALUE_KIND_NEVER {
        syntax.failAt(source, errPos, prefix, "Rc cannot wrap " + types.displayKind(elemKind));
    }
    close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
    rcKind := "Rc<" + elemKind + ">";
    valCode := ctx.assignValueCode(target, elemKind, valArg.kind, valArg.code);
    outCode := if target == ir.TARGET_C {
        rTag := types.cRcTag(rcKind);
        if rTag =!= "" { "/*@T:" + rcKind + "@*/" + rTag + "_new(" + valCode + ")" } else { valCode }
    } else {
        "lite$rcCreate(" + valCode + ")"
    };
    ctx.withMarkers((kind = rcKind, code = outCode, intValue = 0, textValue = "", constant = false, next = close),
    if inferMode { ctx.collectParsedMarkers("", valArg) } else { "" })
};

/** Parses and lowers a hard-builtin type-attached dot call (`List.*`, `Array.*`, `Map.*`, `Set.*`, `Rc.*`, `String.length/at/slice`). */
parseCoreTypeOpHardCall := fn(target: String, source: String, labelStart: Int, openParen: Int, receiver: Parsed, recvLocalIdx: Int, runtime: String, opLabel: String, isMutRecv: Bool, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if isMutRecv and (recvLocalIdx < 0 or not locals[recvLocalIdx].writable) {
        syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
    }
    mutRt := if isMutRecv { receiver.code } else { "" };
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    var markers := if inferMode { ctx.collectParsedMarkers("", receiver) } else { "" };
    if runtime == "lite$textLength" {
        close := syntax.expectSymbol(source, cursor, ")", prefix);
        if receiver.constant {
            n := receiver.textValue.length();
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = ir.targetIntLiteralCode(target, n, false, n.toText()),
            intValue = n, textValue = "", constant = true, next = close), markers);
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = "lite$textLength(" + receiver.code + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime == "lite$textAt" {
        pArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, pArg); }
        if not numeric.isIntKind(pArg.kind) {
            syntax.failAt(source, cursor, prefix, "String.at position must be Int, got " + types.displayKind(pArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, pArg.next, prefix);
        pCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, pArg.kind, pArg.code);
        return ctx.withMarkers((kind = ir.VALUE_KIND_STRING, code = "lite$textAt(" + receiver.code + ", " + pCode + ", " + labelStart.toText() + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime == "lite$textSlice" {
        sArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, sArg); }
        if not numeric.isIntKind(sArg.kind) {
            syntax.failAt(source, cursor, prefix, "String.slice start must be Int, got " + types.displayKind(sArg.kind));
        }
        comma := syntax.expectSymbol(source, syntax.skipTrivia(source, sArg.next, prefix), ",", prefix);
        eStart := syntax.skipTrivia(source, comma, prefix);
        eArg := parseBinaryCtx(target, source, eStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, eArg); }
        if not numeric.isIntKind(eArg.kind) {
            syntax.failAt(source, eStart, prefix, "String.slice end must be Int, got " + types.displayKind(eArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, eArg.next, prefix);
        sCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, sArg.kind, sArg.code);
        eCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, eArg.kind, eArg.code);
        return ctx.withMarkers((kind = ir.VALUE_KIND_STRING, code = "lite$textSlice(" + receiver.code + ", " + sCode + ", " + eCode + ", " + labelStart.toText() + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime.startsWithAt(0, "lite$core$array$") {
        elKind := types.arrayElementKind(receiver.kind);
        aTag := if target == ir.TARGET_C { types.cArrayTag(receiver.kind) } else { "" };
        if runtime == "lite$core$array$length:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            ext := types.arrayExtent(receiver.kind);
            if ext >= 0 {
                return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = ir.targetIntLiteralCode(target, ext, false, ext.toText()),
                intValue = ext, textValue = "", constant = true, next = close), markers);
            }
            lenCode := if target == ir.TARGET_C { "((" + receiver.code + ").len)" } else { "BigInt((" + receiver.code + ").length)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lenCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$array$uncheckedGet:v1" {
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " index must be Int, got " + types.displayKind(idxArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, idxArg.next, prefix);
            iCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
            getCode := if aTag =!= "" {
                "/*@T:" + receiver.kind + "@*/" + aTag + "_uat(" + receiver.code + ", " + iCode + ", " + labelStart.toText() + ")"
            } else {
                "lite$listUncheckedAt(" + receiver.code + ", " + iCode + ", " + labelStart.toText() + ")"
            };
            return ctx.withMarkers((kind = elKind, code = getCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$array$uncheckedSet:v1" {
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " index must be Int, got " + types.displayKind(idxArg.kind));
            }
            comma := syntax.expectSymbol(source, syntax.skipTrivia(source, idxArg.next, prefix), ",", prefix);
            vStart := syntax.skipTrivia(source, comma, prefix);
            valArg := parseBinaryCtx(target, source, vStart, prefix, locals, functions, params, currentName, elKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
