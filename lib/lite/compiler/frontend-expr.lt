                        if target == ir.TARGET_C and fnRetVal.startsWithAt(0, "/*@CBLK:") {
                            rVar := "lt_fnret_" + start.toText();
                            mut statements.pushBack("{ " + types.cValueType(expected) + " " + rVar + "; " + ctx.cUnwrapIntoVar(rVar, expected, fnRetVal) + " return " + rVar + "; }");
                        } else {
                            mut statements.pushBack("return " + fnRetVal + ";");
                        }
                        blockExits = true;
                    }
                }
            } else if types.isResultKind(expected) and types.resultOkKind(expected) == ir.VALUE_KIND_UNIT {
                mut statements.pushBack("return " + emitResultVariantExpr(target, expected, false, ir.VALUE_KIND_UNIT, "") + ";");
                blockExits = true;
            } else if expected =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "function " + currentName + " must return " + types.displayKind(expected));
            }
        }
        var fnBodyJoined := if target == ir.TARGET_C { finalizeCBlockStmts(statements, blockOwned, blockCells, expected, start, blockExits) } else { statements.join(" ") };
        if target == ir.TARGET_TS {
            hasFnBodyTransfer := reach.codeUsesTextCall(fnBodyJoined, "lite$throwTransfer(0,");
            hasFnBodyProp := types.isResultKind(expected) and reach.codeUsesTextCall(fnBodyJoined, "lite$throwProp(");
            if hasFnBodyTransfer or hasFnBodyProp {
                catchRet := if expected == ir.VALUE_KIND_UNIT { "return;" } else { "return lite$transferVal;" };
                propRet := if types.isResultKind(expected) {
                    if types.resultErrKind(expected) == ir.VALUE_KIND_UNIT {
                        "return ({ _r: 1 as const } as " + types.tsFunctionType(expected) + ");"
                    } else {
                        "return ({ _r: 1 as const, _e: lite$propErr as " + types.tsFunctionType(types.resultErrKind(expected)) + " } as " + types.tsFunctionType(expected) + ");"
                    }
                } else { "" };
                var catchClauses := "";
                if hasFnBodyTransfer {
                    catchClauses = catchClauses + "if (lite$hasTransfer(lite$err, 0)) { " + catchRet + " } ";
                }
                if hasFnBodyProp {
                    catchClauses = catchClauses + "if (lite$hasProp(lite$err)) { " + propRet + " } ";
                }
                fnBodyJoined = "try { " + fnBodyJoined + " } catch (lite$err) { " + catchClauses + "throw lite$err; }";
            }
        }
        unregisterBlockOwnedInitFlags(blockOwned);
        return ctx.withMarkers((kind = expected, code = fnBodyJoined, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if isLoopBody {
        topLoopCtx := ctxs[ctx.findActiveLoopCtxIndex(ctxs)];
        topLoopId := topLoopCtx.id;
        topLoopValKind := topLoopCtx.valKind;
        topLoopValVar := topLoopCtx.valVar;
        if isInferPlaceholderKind(topLoopValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(blockKind) < 0 {
                        blockMarkers = blockMarkers + topLoopId.toText() + "=" + blockKind + "\n";
                    }
                } else if not lastPartialIfDiverges {
                    blockMarkers = blockMarkers + topLoopId.toText() + "=Unit\n";
                }
            }
            tailPlaceholderKind := if blockExits {
                ir.VALUE_KIND_NEVER
            } else if sawTailExpr {
                blockKind
            } else {
                ir.VALUE_KIND_UNIT
            };
            unregisterBlockOwnedInitFlags(blockOwned);
            return ctx.withMarkers((kind = tailPlaceholderKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), blockMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topLoopValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "loop produces Unit and cannot yield " + types.displayKind(blockKind));
                    }
                } else if topLoopValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot yield " + types.displayKind(blockKind) + " from diverging loop");
                    }
                } else if not types.isCompatibleKind(topLoopValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot commit " + types.displayKind(blockKind) +
                    " to loop .value of kind " + types.displayKind(topLoopValKind));
                }
                if blockKind == ir.VALUE_KIND_NEVER {
                    if target == ir.TARGET_C {
                        mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, blockCode));
                    } else {
                        mut statements.pushBack("(" + blockCode + ");");
                    }
                    blockExits = true;
                } else if topLoopValKind == ir.VALUE_KIND_UNIT {
                    if blockCode =!= ir.targetUnitLiteralCode(target) {
                        if target == ir.TARGET_C {
                            mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, blockCode));
                        } else {
                            mut statements.pushBack("void (" + blockCode + ");");
                        }
                    }
                } else {
                    tailLoopCode := ctx.assignValueCode(target, topLoopValKind, blockKind, blockCode);
                    if topLoopCtx.colVar =!= "" {
                        if target == ir.TARGET_C {
                            colTag := types.cListTag(topLoopValKind);
                            if types.cTypeNeedsDrop(topLoopValKind) {
                                mut statements.pushBack(blockAssignStmt(target, topLoopValVar, topLoopValKind, tailLoopCode) + " lt_list_" + colTag + "_push_back(&" + topLoopCtx.colVar + ", " + ctx.copiedValueCode(target, topLoopValKind, topLoopValVar) + ");");
                            } else {
                                mut statements.pushBack(topLoopValVar + " = " + tailLoopCode + "; lt_list_" + colTag + "_push_back(&" + topLoopCtx.colVar + ", " + topLoopValVar + ");");
                            }
                        } else {
                            mut statements.pushBack(topLoopValVar + " = " + tailLoopCode + "; " + topLoopCtx.colVar + ".push(" + topLoopValVar + ");");
                        }
                    } else if target == ir.TARGET_C and types.cTypeNeedsDrop(topLoopValKind) {
                        mut statements.pushBack(blockAssignStmt(target, topLoopValVar, topLoopValKind, tailLoopCode));
                    } else {
                        mut statements.pushBack(topLoopValVar + " = " + tailLoopCode + ";");
                    }
                }
            } else if not lastPartialIfDiverges and topLoopValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "loop body must produce " + types.displayKind(topLoopValKind));
            }
        }
        fnCtxIdxLp := if target == ir.TARGET_C { ctx.findCtxByKindIndex(ctxs, "fn") } else { -1 };
        fnRetKLp := if fnCtxIdxLp >= 0 { ctxs[fnCtxIdxLp].valKind } else { "" };
        loopBodyJoined := if target == ir.TARGET_C { finalizeCBlockStmts(statements, blockOwned, blockCells, fnRetKLp, start, blockExits) } else { statements.join(" ") };
        unregisterBlockOwnedInitFlags(blockOwned);
        return ctx.withMarkers((kind = if blockExits { ir.VALUE_KIND_NEVER } else { topLoopValKind }, code = loopBodyJoined,
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topLoopId) } else { "" });
    }
    if isTaggedBody {
        topCtx := ctxs[ctx.ctxCount(ctxs) - 1];
        topId := topCtx.id;
        topTag := topCtx.tag;
        topValKind := topCtx.valKind;
        topValVar := topCtx.valVar;
        topLabel := topCtx.label;
        if isInferPlaceholderKind(topValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        blockMarkers = blockMarkers + topId.toText() + "=" + blockKind + "\n";
                    }
                } else {
                    blockMarkers = blockMarkers + topId.toText() + "=Unit\n";
                }
            }
            inferredKind := ctx.inferKindFromMarkers(blockMarkers, topId, topTag, source, start, prefix, blockExits);
            outerMarkers := ctx.filterOtherMarkers(blockMarkers, topId);
            return ctx.withMarkers((kind = inferredKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), outerMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "block @" + topTag + " returns Unit and cannot return a value");
                    }
                } else if topValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning Never");
                    }
                } else if not types.isCompatibleKind(topValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning " + types.displayKind(topValKind));
                }
            } else if topValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "block @" + topTag + " must return " + types.displayKind(topValKind));
            }
        }
        if not blockExits and sawTailExpr {
            if blockKind == ir.VALUE_KIND_NEVER {
                if target == ir.TARGET_C {
                    mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, blockCode));
                } else {
                    mut statements.pushBack("(" + blockCode + ");");
                }
                blockExits = true;
            } else if topValKind == ir.VALUE_KIND_UNIT {
                if blockCode =!= ir.targetUnitLiteralCode(target) {
                    mut statements.pushBack(if target == ir.TARGET_C { ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, blockCode) } else { "void (" + blockCode + ");" });
                }
            } else {
                tailCode := ctx.assignValueCode(target, topValKind, blockKind, blockCode);
                if target == ir.TARGET_C {
                    mut statements.pushBack(ctx.cUnwrapIntoVar(topValVar, topValKind, tailCode));
                } else {
                    mut statements.pushBack(topValVar + " = " + tailCode + ";");
                }
            }
        }
        fnCtxIdx := ctx.findCtxByKindIndex(ctxs, "fn");
        fnRetKForDrops := if fnCtxIdx >= 0 { ctxs[fnCtxIdx].valKind } else { "" };
        rawJoined := if target == ir.TARGET_C {
            mut parts: List<String> = [];
            loop taggedPreDecls as td { mut parts.pushBack(td); }
            if blockOwned.length() > 0 or blockCells.length() > 0 {
                var si := 0;
                sCount := statements.length();
                loop si < sCount {
                    st := statements[si];
                    exitDrop := buildBlockDropStmt(blockOwned, blockCells, si);
                    mut parts.pushBack(if exitDrop =!= "" { ctx.cRewriteExitDrops(st, exitDrop, exitDrop, fnRetKForDrops, start + si) } else { st });
                    si = si + 1;
                }
            } else {
                loop statements as st { mut parts.pushBack(st); }
            }
            parts.join(" ")
        } else {
            statements.join(" ")
        };
        fullDropC := if target == ir.TARGET_C and (blockOwned.length() > 0 or blockCells.length() > 0) {
            buildBlockDropStmt(blockOwned, blockCells, -1)
        } else {
            ""
        };
        bodyJoined := rawJoined;
        if target == ir.TARGET_C {
            unregisterBlockOwnedInitFlags(blockOwned);
            needsCLbl := reach.codeUsesTextCall(bodyJoined, "goto " + topLabel + ";");
            cBodyWithLbl := if needsCLbl {
                bodyJoined + " " + topLabel + ": ;" + (if fullDropC =!= "" { " " + fullDropC } else { "" })
            } else {
                bodyJoined + (if fullDropC =!= "" { " " + fullDropC } else { "" })
            };
            if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER {
                return ctx.withMarkers((kind = topValKind, code = "/*@CBLK:0@*/{ " + cBodyWithLbl + " }", intValue = 0, textValue = "", constant = false, next = cursor),
                if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
            }
            return ctx.withMarkers((kind = topValKind,
            code = "/*@CBLK:" + topValVar + "@*/" + types.cValueType(topValKind) + " " + topValVar + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; { " + cBodyWithLbl + " }",
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
        }
        needsLabel := reach.codeUsesTextCall(bodyJoined, "break " + topLabel + ";");
        needsTry := reach.codeUsesTextCall(bodyJoined, "lite$throwTransfer(" + topId.toText() + ",");
        labeledBody := if needsLabel { topLabel + ": { " + bodyJoined + " }" } else { bodyJoined };
        wrappedBody := if needsTry {
            catchAssign := if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER { "" } else { topValVar + " = lite$transferVal;" };
            tryInner := if needsLabel { labeledBody } else { "{ " + labeledBody + " }" };
            "try { " + tryInner + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " + topId.toText() + ")) { " + catchAssign + " } else { throw lite$err; } }"
        } else {
            labeledBody
        };
        finalIife := if topValKind == ir.VALUE_KIND_UNIT {
            "(() => { " + wrappedBody + (if wrappedBody =!= "" { " " } else { "" }) + "return undefined; })()"
        } else if topValKind == ir.VALUE_KIND_NEVER {
            "(() => { " + wrappedBody + " })()"
        } else {
            "(() => { let " + topValVar + ": " + types.tsFunctionType(topValKind) + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; " + wrappedBody + " return " + topValVar + "; })()"
        };
        return ctx.withMarkers((kind = topValKind, code = finalIife, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
    }
    if isStandaloneBlock {
        afterUntaggedClose := syntax.skipTrivia(source, cursor, prefix);
        if afterUntaggedClose < blockSourceSize and source.wordAt(afterUntaggedClose, "then") {
            syntax.failAt(source, afterUntaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterUntaggedClose < blockSourceSize and source.wordAt(afterUntaggedClose, "finally") {
            finParsed := parseFinallyClause(target, source, afterUntaggedClose, prefix, locals, functions, params, currentName, ctxs, bodyDepth, inferMode, aliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, finParsed); }
            stmtsJoined := statements.join(" ");
            if target == ir.TARGET_C {
                fnCtxIdxFin := ctx.findCtxByKindIndex(ctxs, "fn");
                fnRetKFin := if fnCtxIdxFin >= 0 { ctxs[fnCtxIdxFin].valKind } else { "" };
                mut finStmtsParts: List<String> = [];
                if blockOwned.length() > 0 or blockCells.length() > 0 {
                    var fsi := 0;
                    fCount := statements.length();
                    loop fsi < fCount {
                        fst := statements[fsi];
                        fExitDrop := buildBlockDropStmt(blockOwned, blockCells, fsi);
                        mut finStmtsParts.pushBack(if fExitDrop =!= "" { ctx.cRewriteExitDrops(fst, fExitDrop, fExitDrop, fnRetKFin, start + fsi) } else { fst });
                        fsi = fsi + 1;
                    }
                } else {
                    loop statements as fst { mut finStmtsParts.pushBack(fst); }
                }
                stmtsJoinedCFin := finStmtsParts.join(" ");
                fullDropFin := if blockOwned.length() > 0 or blockCells.length() > 0 { buildBlockDropStmt(blockOwned, blockCells, -1) } else { "" };
                tryBlockC := if blockExits {
                    "/*@CBLK:0@*/" + stmtsJoinedCFin
                } else if blockKind == ir.VALUE_KIND_UNIT or blockKind == ir.VALUE_KIND_NEVER {
                    rawTailC := ctx.cUnwrapIntoVar("", blockKind, blockCode);
                    tailC := if fullDropFin =!= "" { ctx.cRewriteExitDrops(rawTailC, fullDropFin, fullDropFin, fnRetKFin, start + statements.length() + 1) } else { rawTailC };
                    "/*@CBLK:0@*/" + stmtsJoinedCFin + (if tailC =!= "" { " " + tailC } else { "" }) + (if fullDropFin =!= "" { " " + fullDropFin } else { "" })
                } else {
                    blkVar := "lt_blk_" + start.toText();
                    tailValC := ctx.copiedValueCode(target, blockKind, blockCode);
                    rawTailAssignC := ctx.cUnwrapIntoVar(blkVar, blockKind, tailValC);
                    tailAssignC := if fullDropFin =!= "" { ctx.cRewriteExitDrops(rawTailAssignC, fullDropFin, fullDropFin, fnRetKFin, start + statements.length() + 1) } else { rawTailAssignC };
                    "/*@CBLK:" + blkVar + "@*/" + types.cValueType(blockKind) + " " + blkVar + "; { " + stmtsJoinedCFin + " " + tailAssignC + (if fullDropFin =!= "" { " " + fullDropFin } else { "" }) + " }"
                };
                normKindC := if blockExits { ir.VALUE_KIND_NEVER } else { blockKind };
                dummyBaseC := (kind = normKindC, code = "", intValue = 0, textValue = "", constant = false, next = cursor);
                unregisterBlockOwnedInitFlags(blockOwned);
                return ctx.withMarkers(finishFinallyC(tryBlockC, finParsed, normKindC, dummyBaseC, inferMode, ctxs, afterUntaggedClose),
                if inferMode { blockMarkers } else { "" });
            }
            standaloneTryBody := if blockExits {
                stmtsJoined
            } else if blockKind == ir.VALUE_KIND_UNIT {
                unitRet := if blockCode == ir.targetUnitLiteralCode(target) {
                    "return undefined;"
                } else {
                    "void (" + blockCode + "); return undefined;"
                };
                if stmtsJoined == "" { unitRet } else { stmtsJoined + " " + unitRet }
            } else if blockKind == ir.VALUE_KIND_NEVER {
                if stmtsJoined == "" { "return " + blockCode + ";" } else { stmtsJoined + " return " + blockCode + ";" }
            } else {
                valRet := "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";";
                if stmtsJoined == "" { valRet } else { stmtsJoined + " " + valRet }
            };
            finalStandaloneKind := if blockExits or finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { blockKind };
            return ctx.withMarkers((kind = finalStandaloneKind,
            code = "(() => { try { " + standaloneTryBody + " } finally { " + finParsed.code + " } })()",
            intValue = 0, textValue = "", constant = false, next = finParsed.next),
            if inferMode { blockMarkers } else { "" });
        }
    }
    fnCtxIdxBlk := if target == ir.TARGET_C { ctx.findCtxByKindIndex(ctxs, "fn") } else { -1 };
    fnRetKBlk := if fnCtxIdxBlk >= 0 { ctxs[fnCtxIdxBlk].valKind } else { "" };
    if blockExits {
        unregisterBlockOwnedInitFlags(blockOwned);
        if target == ir.TARGET_C {
            mut exitStmtsParts: List<String> = [];
            if blockOwned.length() > 0 or blockCells.length() > 0 {
                var esi := 0;
                eCount := statements.length();
                loop esi < eCount {
                    est := statements[esi];
                    eDrop := buildBlockDropStmt(blockOwned, blockCells, esi);
                    mut exitStmtsParts.pushBack(if eDrop =!= "" { ctx.cRewriteExitDrops(est, eDrop, eDrop, fnRetKBlk, start + esi) } else { est });
                    esi = esi + 1;
                }
            } else {
                loop statements as est { mut exitStmtsParts.pushBack(est); }
            }
            return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + exitStmtsParts.join(" "),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "(() => { " + statements.join(" ") + " })()",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if statementCount == 0 and blockCells.length() == 0 and blockOwned.length() == 0 {
        if isBranchBody {
            saveBlockExitBranchRows(blockLocals, outerLocalsLen, blockLexDepth - 1);
        }
        baseBlock := (kind = blockKind, code = blockCode, intValue = blockInt, textValue = blockText, constant = blockConstant, next = cursor);
        return if inferMode and blockMarkers =!= "" { ctx.withMarkers(baseBlock, blockMarkers) } else { baseBlock };
    }
    if target == ir.TARGET_C {
        unregisterBlockOwnedInitFlags(blockOwned);
        if isBranchBody {
            saveBlockExitBranchRows(blockLocals, outerLocalsLen, blockLexDepth - 1);
        }
        mut cPartsEnd: List<String> = [];
        if blockOwned.length() > 0 or blockCells.length() > 0 {
            var nsi := 0;
            nCount := statements.length();
            loop nsi < nCount {
                nst := statements[nsi];
                nDrop := buildBlockDropStmt(blockOwned, blockCells, nsi);
                mut cPartsEnd.pushBack(if nDrop =!= "" { ctx.cRewriteExitDrops(nst, nDrop, nDrop, fnRetKBlk, start + nsi) } else { nst });
                nsi = nsi + 1;
            }
        } else {
            loop statements as nst { mut cPartsEnd.pushBack(nst); }
        }
        stmtsJoinedC := cPartsEnd.join(" ");
        fullDropC := if blockOwned.length() > 0 or blockCells.length() > 0 { buildBlockDropStmt(blockOwned, blockCells, -1) } else { "" };
        if blockKind == ir.VALUE_KIND_UNIT or blockKind == ir.VALUE_KIND_NEVER {
            rawTailC := ctx.cUnwrapIntoVar("", blockKind, blockCode);
            tailC := if fullDropC =!= "" { ctx.cRewriteExitDrops(rawTailC, fullDropC, fullDropC, fnRetKBlk, start + statements.length() + 1) } else { rawTailC };
            return ctx.withMarkers((kind = blockKind, code = "/*@CBLK:0@*/" + stmtsJoinedC + (if tailC =!= "" { " " + tailC } else { "" }) + (if fullDropC =!= "" { " " + fullDropC } else { "" }),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        blkVar := "lt_blk_" + start.toText();
        tailValC := ctx.copiedValueCode(target, blockKind, blockCode);
        rawTailAssignC := ctx.cUnwrapIntoVar(blkVar, blockKind, tailValC);
        tailAssignC := if fullDropC =!= "" { ctx.cRewriteExitDrops(rawTailAssignC, fullDropC, fullDropC, fnRetKBlk, start + statements.length() + 1) } else { rawTailAssignC };
        return ctx.withMarkers((kind = blockKind,
        code = "/*@CBLK:" + blkVar + "@*/" + types.cValueType(blockKind) + " " + blkVar + "; { " + stmtsJoinedC + " " + tailAssignC + (if fullDropC =!= "" { " " + fullDropC } else { "" }) + " }",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    returnCode := if blockKind == ir.VALUE_KIND_UNIT {
        if blockCode == ir.targetUnitLiteralCode(target) { "return undefined;" }
        else { "void (" + blockCode + "); return undefined;" }
    } else if blockKind == ir.VALUE_KIND_NEVER {
        "return " + blockCode + ";"
    } else {
        "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";"
    };
    if isBranchBody {
        saveBlockExitBranchRows(blockLocals, outerLocalsLen, blockLexDepth - 1);
    }
    ctx.withMarkers((kind = blockKind, code = "(() => { " + statements.join(" ") + " " + returnCode + " })()",
    intValue = 0, textValue = "", constant = false, next = cursor),
    if inferMode { blockMarkers } else { "" })
};

/** Parses `[@tag] loop [header] { ... } [then { ... }] [finally { ... }]` expressions. */
parseLoopExpr := fn(target: String, source: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    rawLoopEnd := syntax.scanRawLoopEnd(source, condParseStart, prefix);
    afterRawLoop := if rawLoopEnd >= 0 { syntax.skipTrivia(source, rawLoopEnd, prefix) } else { -1 };
    hasActualThen := afterRawLoop >= 0 and source.wordAt(afterRawLoop, "then");
    var suffixField := "";
    var suffixFieldAt := -1;
    var suffixEnd := rawLoopEnd;
    if not hasActualThen and afterRawLoop >= 0 and afterRawLoop < source.length() and source.at(afterRawLoop) == "." and
    source.slice(rawLoopEnd, afterRawLoop).indexOf("\n", 0) < 0 {
        sFieldStart := syntax.skipTrivia(source, afterRawLoop + 1, prefix);
        if sFieldStart < source.length() and source.at(sFieldStart).isNameStart() {
            sFieldEnd := source.skipName(sFieldStart);
            sName := source.slice(sFieldStart, sFieldEnd);
            if sName == "collected" or sName == "count" or sName == "value" {
                suffixField = sName;
                suffixFieldAt = sFieldStart;
                suffixEnd = sFieldEnd;
            }
        }
    }
