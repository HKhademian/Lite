/** Portable compiler-embedded compile-time evaluator, purity/effect analyzer, file-dependency tracker, and TS/C11 value materializer. */

crypto := import "core/crypto";
diagLib := import "core/diag";
fs := import "core/file";
integer := import "core/int";
io := import "core/io";
path := import "core/path";
proc := import "core/process";
textLib := import "core/text";
time := import "core/time";
tb := import "core/text-builder";
numeric := import "./numeric-literals";
ir := import "./frontend-ir";
syntax := import "./frontend-syntax";
types := import "./frontend-types";
ctx := import "./frontend-context";
interfaces := import "./interfaces";
sym := import "./symbol-table";
generics := import "./generics";

/** Transparent type alias matching `frontend-ir.AliasDecl`. */
AliasDecl := alias (name: String, target: String, at: Int, end: Int, depth: Int);

/** Indexed compile-time value cell (avoids recursive nominal types in C11 self-hosting). */
pub CtCell := record {
    tag: String;
    kind: String;
    intVal: Int;
    floatVal: Float;
    strVal: String;
    children: List<Int>;
    keys: List<String>;
};

/** Registered callable definition available to the compile-time evaluator. */
CtFnDef := record {
    runtime: String;
    name: String;
    moduleKey: String;
    moduleIdentity: String;
    source: String;
    prefix: String;
    bodyStart: Int;
    bodyEnd: Int;
    paramsEncoded: String;
    paramCount: Int;
    resultKind: String;
    isHostBuiltin: Bool;
    aliases: List<AliasDecl>;
};

/** Registered module source/identity metadata. */
CtModuleMeta := record {
    moduleKey: String;
    moduleIdentity: String;
    source: String;
    prefix: String;
};

/** Registered import alias binding inside a module. */
CtModuleImport := record {
    aliasName: String;
    targetModKey: String;
    targetIdentity: String;
};

/** Active lexical binding in a compile-time evaluation frame. */
CtBinding := record {
    name: String;
    valId: Int;
    mutable: Bool;
    kind: String;
};

/** Mutable lexical execution frame and enclosing construct state. */
CtFrame := record {
    bindings: List<CtBinding>;
    fnResultKind: String;
    moduleKey: String;
    aliases: List<AliasDecl>;
    loopCount: Int;
    loopIndex: Int;
    loopItemId: Int;
    hasLoopItem: Bool;
    activeTag: String;
};

/** Result of evaluating one statement block, branch, or expression. */
pub CtOutcome := record {
    ok: Bool;
    valId: Int;
    flow: String;
    error: String;
};

/** Result of evaluating a parenthesized compile-time argument list. */
CtCallArgs := record {
    ok: Bool;
    outcome: CtOutcome;
    args: List<Int>;
    labels: List<String>;
    next: Int;
};

/** Step, memory, recursion, and effect budget for one compile-time evaluation. */
EvalBudget := record {
    maxSteps: Int;
    steps: Int;
    maxNewCells: Int;
    baseCells: Int;
    maxDepth: Int;
    depth: Int;
    allowEffects: Bool;
    speculative: Bool;
};

/** Result of checking whether a source range performs direct or transitive effects. */
pub EffectCheckResult := record {
    pure: Bool;
    reason: String;
    pos: Int;
};

pub FLOW_NONE := "";
pub FLOW_RETURN := "return";
pub FLOW_BREAK := "break";
pub FLOW_CONTINUE := "continue";
pub FLOW_PANIC := "panic";
pub FLOW_PROP_ERR := "prop_err";

TAG_UNIT := "unit";
TAG_BOOL := "bool";
TAG_INT := "int";
TAG_UINT := "uint";
TAG_FLOAT := "float";
TAG_STR := "str";
TAG_ENUM := "enum";
TAG_TUPLE := "tuple";
TAG_RECORD := "record";
TAG_LIST := "list";
TAG_ARRAY := "array";
TAG_MAP := "map";
TAG_SET := "set";
TAG_UNION := "union";
TAG_RESULT := "result";
TAG_FN := "fn";
TAG_READER := "reader";
TAG_WRITER := "writer";

DEFAULT_MAX_STEPS := 100000;
DEFAULT_MAX_NEW_CELLS := 65536;
DEFAULT_MAX_DEPTH := 128;
SPEC_MAX_STEPS := 20000;
SPEC_MAX_NEW_CELLS := 4096;
SPEC_MAX_DEPTH := 64;

mut ctPool: List<CtCell> = [];
mut ctFnDefs: List<CtFnDef> = [];
mut ctFnIdxByRt: Map<String, Int>;
mut ctFnIdxByModName: Map<String, List<Int>>;
mut ctModules: Map<String, CtModuleMeta>;
mut ctImportsByMod: Map<String, List<CtModuleImport>>;
mut ctValByRuntime: Map<String, Int>;
mut ctValByMatCode: Map<String, Int>;
mut ctModMutableGlobals: Set<String>;
mut ctTracedFiles: List<String> = [];
mut ctTracedFileSet: Set<String>;
mut ctReaders: List<io.Reader>;
mut ctWriters: List<io.Writer>;
var ctStdoutIsArtifact := false;
var ctActiveModKey := "";
var ctBudgetPanic := "";
var ctUnitCellId := -1;
var ctTrueCellId := -1;
var ctFalseCellId := -1;

/** Resets all compile-time evaluator pools, registries, and dependency lists at compiler root entry. */
pub resetComptimeState := fn(): Unit {
    mut ctPool.clear();
    mut ctFnDefs.clear();
    mut ctFnIdxByRt.clear();
    mut ctFnIdxByModName.clear();
    mut ctModules.clear();
    mut ctImportsByMod.clear();
    mut ctValByRuntime.clear();
    mut ctValByMatCode.clear();
    mut ctModMutableGlobals.clear();
    mut ctTracedFiles.clear();
    mut ctTracedFileSet.clear();
    mut ctReaders.clear();
    mut ctWriters.clear();
    ctActiveModKey = "";
    ctBudgetPanic = "";
    ctUnitCellId = -1;
    ctTrueCellId = -1;
    ctFalseCellId = -1;
};

/** Marks whether compiler stdout emits the generated TS/C artifact (rerouting comptime output to stderr). */
pub setStdoutIsArtifact := fn(flag: Bool): Unit {
    ctStdoutIsArtifact = flag;
};

/** Sets the currently parsed module key for ambient lookups. */
pub setActiveModule := fn(modKey: String): Unit {
    ctActiveModKey = modKey;
};

/** Returns the active module key currently being parsed. */
pub getActiveModule := fn(): String {
    ctActiveModKey
};

/** Records module metadata (`source`, `prefix`, `moduleIdentity`) for compile-time evaluation and diagnostics. */
pub registerModuleMeta := fn(moduleKey: String, moduleIdentity: String, source: String, prefix: String): Unit {
    mut ctModules.set(moduleKey, CtModuleMeta { =moduleKey, =moduleIdentity, =source, =prefix });
};

/** Records one import binding (`aliasName -> targetModKey`) inside `moduleKey`. */
pub registerModuleImport := fn(moduleKey: String, aliasName: String, targetModKey: String, targetIdentity: String): Unit {
    existing := ctImportsByMod.get(moduleKey);
    mut list: List<CtModuleImport> = if existing.found { existing.value } else { [] };
    var replaced := false;
    var i := 0;
    loop i < list.length() {
        if list[i].aliasName == aliasName {
            mut list.setAt(i, CtModuleImport { =aliasName, =targetModKey, =targetIdentity });
            replaced = true;
            break;
        }
        i = i + 1;
    }
    if not replaced {
        mut list.pushBack(CtModuleImport { =aliasName, =targetModKey, =targetIdentity });
    }
    mut ctImportsByMod.set(moduleKey, list);
};

/** Registers a module-level or local immutable compile-time value id indexed by `runtime`. */
pub registerLocalCtVal := fn(runtime: String, valId: Int): Unit {
    if runtime =!= "" and valId >= 0 {
        mut ctValByRuntime.set(runtime, valId);
    }
};

/** Returns the compile-time value id registered for `runtime`, or `-1` when unknown at compile time. */
pub lookupLocalCtVal := fn(runtime: String): Int {
    if runtime == "" { return -1; }
    res := ctValByRuntime.get(runtime);
    if res.found { res.value } else { -1 }
};

/** Associates emitted materialized target `code` with its compile-time `valId` so bindings inherit compound values cleanly. */
pub registerMaterializedCode := fn(code: String, valId: Int): Unit {
    if code =!= "" and valId >= 0 {
        mut ctValByMatCode.set(code, valId);
    }
};

/** Returns the compile-time `valId` recorded for materialized target `code`, or `-1` if absent. */
pub lookupMaterializedCode := fn(code: String): Int {
    if code == "" { return -1; }
    res := ctValByMatCode.get(code);
    if res.found { res.value } else { -1 }
};

/** Registers an immutable binding's compile-time value from materialized `matCode` or constant scalar fields, returning `valId` or `-1`. */
pub registerScalarOrMatLocal := fn(runtime: String, kind: String, constant: Bool, intVal: Int, textVal: String, matCode: String): Int {
    if runtime == "" { return -1; }
    matId := lookupMaterializedCode(matCode);
    if matId >= 0 {
        registerLocalCtVal(runtime, matId);
        return matId;
    }
    if not constant { return -1; }
    mut b := unboundedBudget();
    vid := if kind == ir.VALUE_KIND_BOOL {
        makeBoolVal(intVal =!= 0, kind, mut b)
    } else if kind == ir.VALUE_KIND_STRING {
        makeStrVal(textVal, kind, mut b)
    } else if numeric.isIntKind(kind) {
        makeIntVal(intVal, kind, mut b)
    } else if types.isEnumKind(kind) and not types.isPayloadEnumKind(kind) {
        makeEnumVal(kind, intVal, types.enumCaseAt(kind, intVal).name, [], mut b)
    } else {
        -1
    };
    if vid >= 0 { registerLocalCtVal(runtime, vid); }
    vid
};

/** Records a mutable module-level variable (`var`, `mut`, `var mut`) so bare Stage-1 `.lt` initializers reject reading it. */
pub registerModuleMutableGlobal := fn(moduleKey: String, name: String, runtime: String): Unit {
    if moduleKey =!= "" and name =!= "" {
        mut ctModMutableGlobals.add(moduleKey + "\t" + name);
    }
    if runtime =!= "" {
        mut ctModMutableGlobals.add("$rt:" + runtime);
    }
};

/** True when `(moduleKey, name)` was declared as a mutable module global (`var`/`mut`/`var mut`). */
pub isModuleMutableGlobal := fn(moduleKey: String, name: String): Bool {
    ctModMutableGlobals.has(moduleKey + "\t" + name)
};

/** True when a runtime identifier refers to a mutable module global. */
pub isMutableGlobalRuntime := fn(runtime: String): Bool {
    ctModMutableGlobals.has("$rt:" + runtime)
};

/** Registers a callable function or type-operation body with the compile-time evaluator. */
pub registerFnDef := fn(runtime: String, name: String, moduleKey: String, moduleIdentity: String,
source: String, prefix: String, bodyStart: Int, bodyEnd: Int, paramsEncoded: String, paramCount: Int,
resultKind: String, isHostBuiltin: Bool, aliases: List<AliasDecl>): Unit {
    idx := ctFnDefs.length();
    def := CtFnDef {
        =runtime, =name, =moduleKey, =moduleIdentity, =source, =prefix,
        =bodyStart, =bodyEnd, =paramsEncoded, =paramCount, =resultKind, =isHostBuiltin, =aliases
    };
    if ctFnIdxByRt.has(runtime) {
        prev := ctFnIdxByRt.get(runtime);
        if prev.found {
            mut ctFnDefs.setAt(prev.value, def);
            return;
        }
    }
    mut ctFnDefs.pushBack(def);
    mut ctFnIdxByRt.set(runtime, idx);
    key := moduleKey + "\t" + name;
    prevList := ctFnIdxByModName.get(key);
    mut indices: List<Int> = if prevList.found { prevList.value } else { [] };
    mut indices.pushBack(idx);
    mut ctFnIdxByModName.set(key, indices);
};

/** Canonicalizes and records a filesystem path accessed during `comptime { ... }` for `--trace-json` dependency tracking. */
pub recordTracedFile := fn(rawPath: String): Unit {
    if rawPath == "" { return; }
    abs := if path.isAbsolute(rawPath) { path.normalize(rawPath) } else { path.resolve(proc.cwd(), rawPath) };
    rp := fs.realPath(abs);
    canon := if rp.ok { rp.path } else { abs };
    if not ctTracedFileSet.has(canon) {
        mut ctTracedFileSet.add(canon);
        mut ctTracedFiles.pushBack(canon);
    }
};

/** Returns all canonical file paths accessed during compile-time evaluation. */
pub getTracedFiles := fn(): List<String> {
    out: List<String> = ctTracedFiles;
    out
};

/** Allocates a cell in `ctPool` while checking the current budget's cell allocation cap. */
allocCell := fn(cell: CtCell, budget: mut EvalBudget): Int {
    if budget.maxNewCells > 0 and (ctPool.length() - budget.baseCells) >= budget.maxNewCells {
        if ctBudgetPanic == "" {
            ctBudgetPanic = "compile-time evaluation exceeded memory allocation limit (" + budget.maxNewCells.toText() + " cells)";
        }
    }
    id := ctPool.length();
    mut ctPool.pushBack(cell);
    id
};

/** Allocates an empty budget for unconditional internal helpers. */
unboundedBudget := fn(): EvalBudget {
    EvalBudget {
        maxSteps = DEFAULT_MAX_STEPS, steps = 0,
        maxNewCells = DEFAULT_MAX_NEW_CELLS, baseCells = ctPool.length(),
        maxDepth = DEFAULT_MAX_DEPTH, depth = 0,
        allowEffects = true, speculative = false
    }
};

makeUnitVal := fn(budget: mut EvalBudget): Int {
    if ctUnitCellId >= 0 { return ctUnitCellId; }
    ctUnitCellId = allocCell(CtCell { tag = TAG_UNIT, kind = ir.VALUE_KIND_UNIT, intVal = 0, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget);
    ctUnitCellId
};

makeBoolVal := fn(b: Bool, kind: String, budget: mut EvalBudget): Int {
    if kind == "" or kind == ir.VALUE_KIND_BOOL {
        if b and ctTrueCellId >= 0 { return ctTrueCellId; }
        if not b and ctFalseCellId >= 0 { return ctFalseCellId; }
        id := allocCell(CtCell { tag = TAG_BOOL, kind = ir.VALUE_KIND_BOOL, intVal = if b { 1 } else { 0 }, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget);
        if b { ctTrueCellId = id; } else { ctFalseCellId = id; }
        return id;
    }
    allocCell(CtCell { tag = TAG_BOOL, kind = kind, intVal = if b { 1 } else { 0 }, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget)
};

makeIntVal := fn(v: Int, kind: String, budget: mut EvalBudget): Int {
    k := if kind == "" { ir.VALUE_KIND_INT } else { kind };
    allocCell(CtCell { tag = TAG_INT, kind = k, intVal = v, floatVal = 0.0, strVal = v.toText(), children = [], keys = [] }, mut budget)
};

makeUIntVal := fn(v: UInt64, kind: String, budget: mut EvalBudget): Int {
    k := if kind == "" { ir.VALUE_KIND_UINT64 } else { kind };
    allocCell(CtCell { tag = TAG_UINT, kind = k, intVal = 0, floatVal = 0.0, strVal = v.toText(), children = [], keys = [] }, mut budget)
};

makeFloatVal := fn(v: Float, kind: String, budget: mut EvalBudget): Int {
    k := if kind == "" { ir.VALUE_KIND_FLOAT } else { kind };
    allocCell(CtCell { tag = TAG_FLOAT, kind = k, intVal = 0, floatVal = v, strVal = v.toText(), children = [], keys = [] }, mut budget)
};

makeStrVal := fn(s: String, kind: String, budget: mut EvalBudget): Int {
    k := if kind == "" { ir.VALUE_KIND_STRING } else { kind };
    allocCell(CtCell { tag = TAG_STR, kind = k, intVal = 0, floatVal = 0.0, strVal = s, children = [], keys = [] }, mut budget)
};

makeEnumVal := fn(kind: String, caseIdx: Int, caseName: String, args: List<Int>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_ENUM, kind = kind, intVal = caseIdx, floatVal = 0.0, strVal = caseName, children = args, keys = [] }, mut budget)
};

makeTupleVal := fn(kind: String, elems: List<Int>, labels: List<String>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_TUPLE, kind = kind, intVal = 0, floatVal = 0.0, strVal = "", children = elems, keys = labels }, mut budget)
};

makeRecordVal := fn(kind: String, vals: List<Int>, fieldNames: List<String>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_RECORD, kind = kind, intVal = 0, floatVal = 0.0, strVal = "", children = vals, keys = fieldNames }, mut budget)
};

makeListVal := fn(kind: String, elems: List<Int>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_LIST, kind = kind, intVal = 0, floatVal = 0.0, strVal = "", children = elems, keys = [] }, mut budget)
};

makeArrayVal := fn(kind: String, elems: List<Int>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_ARRAY, kind = kind, intVal = elems.length(), floatVal = 0.0, strVal = "", children = elems, keys = [] }, mut budget)
};

makeMapVal := fn(kind: String, mapKeys: List<String>, keyIds: List<Int>, valIds: List<Int>, budget: mut EvalBudget): Int {
    mut interleaved: List<Int> = [];
    var i := 0;
    loop i < keyIds.length() {
        mut interleaved.pushBack(keyIds[i]);
        mut interleaved.pushBack(valIds[i]);
        i = i + 1;
    }
    allocCell(CtCell { tag = TAG_MAP, kind = kind, intVal = keyIds.length(), floatVal = 0.0, strVal = "", children = interleaved, keys = mapKeys }, mut budget)
};

makeSetVal := fn(kind: String, setKeys: List<String>, elemIds: List<Int>, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_SET, kind = kind, intVal = elemIds.length(), floatVal = 0.0, strVal = "", children = elemIds, keys = setKeys }, mut budget)
};

makeUnionVal := fn(unionKind: String, memberIdx: Int, innerValId: Int, budget: mut EvalBudget): Int {
    c := ctPool[innerValId];
    if c.tag == TAG_UNION {
        mems := types.unionMembers(unionKind);
        origMems := types.unionMembers(c.kind);
        if c.intVal >= 0 and c.intVal < origMems.length() {
            origM := origMems[c.intVal];
            newIdx := types.unionMemberIndex(unionKind, origM);
            if newIdx >= 0 and c.children.length() > 0 {
                return allocCell(CtCell { tag = TAG_UNION, kind = unionKind, intVal = newIdx, floatVal = 0.0, strVal = "", children = [c.children[0]], keys = [] }, mut budget);
            }
        }
        return makeUnitVal(mut budget);
    }
    allocCell(CtCell { tag = TAG_UNION, kind = unionKind, intVal = memberIdx, floatVal = 0.0, strVal = "", children = [innerValId], keys = [] }, mut budget)
};

makeResultVal := fn(resKind: String, isErr: Bool, payloadValId: Int, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_RESULT, kind = resKind, intVal = if isErr { 1 } else { 0 }, floatVal = 0.0, strVal = "", children = [payloadValId], keys = [] }, mut budget)
};

makeFnRefVal := fn(fnKind: String, runtime: String, budget: mut EvalBudget): Int {
    allocCell(CtCell { tag = TAG_FN, kind = fnKind, intVal = 0, floatVal = 0.0, strVal = runtime, children = [], keys = [] }, mut budget)
};

/** Clones mutable collection cells by value when copied to another binding or returned from a call. */
cloneValIfContainer := fn(valId: Int, kind: String, budget: mut EvalBudget): Int {
    if valId < 0 or valId >= ctPool.length() { return valId; }
    c := ctPool[valId];
    if c.tag == TAG_LIST or c.tag == TAG_ARRAY or c.tag == TAG_RECORD or c.tag == TAG_TUPLE or c.tag == TAG_MAP or c.tag == TAG_SET or c.tag == TAG_UNION or c.tag == TAG_RESULT or (c.tag == TAG_ENUM and c.children.length() > 0) {
        mut newChildren: List<Int> = [];
        loop c.children as cid {
            mut newChildren.pushBack(self(cid, "", mut budget));
        }
        mut newKeys: List<String> = [];
        loop c.keys as k { mut newKeys.pushBack(k); }
        return allocCell(CtCell {
            tag = c.tag, kind = if kind =!= "" { kind } else { c.kind },
            intVal = c.intVal, floatVal = c.floatVal, strVal = c.strVal,
            children = newChildren, keys = newKeys
        }, mut budget);
    }
    valId
};

/** Consumes one execution step and panics if step/memory budget is exceeded. */
tickStep := fn(budget: mut EvalBudget): (ok: Bool, msg: String) {
    if ctBudgetPanic =!= "" {
        return (ok = false, msg = ctBudgetPanic);
    }
    budget.steps = budget.steps + 1;
    if budget.maxSteps > 0 and budget.steps > budget.maxSteps {
        msg := "compile-time evaluation exceeded step limit (" + budget.maxSteps.toText() + " steps)";
        ctBudgetPanic = msg;
        return (ok = false, msg = msg);
    }
    (ok = true, msg = "")
};

/** Constructs a canonical map/set lookup key from a scalar key cell. */
scalarKeyString := fn(valId: Int): String {
    c := ctPool[valId];
    if c.tag == TAG_STR { return "S:" + c.strVal; }
    if c.tag == TAG_INT { return "I:" + c.intVal.toText(); }
    if c.tag == TAG_UINT { return "U:" + c.strVal; }
    if c.tag == TAG_BOOL { return "B:" + c.intVal.toText(); }
    if c.tag == TAG_ENUM { return "E:" + c.kind + "#" + c.intVal.toText(); }
    "K:" + c.tag + ":" + c.strVal
};

/** Formats any compile-time value cell for `io.output` / `toText` diagnostics. */
formatCtVal := fn(valId: Int): String {
    if valId < 0 or valId >= ctPool.length() { return "Unit"; }
    c := ctPool[valId];
    if c.tag == TAG_UNIT { return "Unit"; }
    if c.tag == TAG_BOOL { return if c.intVal =!= 0 { "true" } else { "false" }; }
    if c.tag == TAG_INT { return c.intVal.toText(); }
    if c.tag == TAG_UINT or c.tag == TAG_FLOAT or c.tag == TAG_STR { return c.strVal; }
    if c.tag == TAG_ENUM {
        if c.children.length() == 0 { return c.strVal; }
        mut parts: List<String> = [];
        loop c.children as cid { mut parts.pushBack(self(cid)); }
        return c.strVal + "(" + parts.join(", ") + ")";
    }
    if c.tag == TAG_TUPLE {
        mut parts: List<String> = [];
        var i := 0;
        loop i < c.children.length() {
            lbl := if i < c.keys.length() { c.keys[i] } else { "" };
            vStr := self(c.children[i]);
            mut parts.pushBack(if lbl =!= "" { lbl + "=" + vStr } else { vStr });
            i = i + 1;
        }
        return if c.children.length() == 1 { "(" + parts[0] + ",)" } else { "(" + parts.join(", ") + ")" };
    }
    if c.tag == TAG_RECORD {
        recName := types.recordDisplayName(c.kind);
        if c.children.length() == 0 { return recName + " {}"; }
        mut parts: List<String> = [];
        var i := 0;
        loop i < c.children.length() {
            mut parts.pushBack(c.keys[i] + " = " + self(c.children[i]));
            i = i + 1;
        }
        return recName + " { " + parts.join(", ") + " }";
    }
    if c.tag == TAG_LIST or c.tag == TAG_ARRAY or c.tag == TAG_SET {
        mut parts: List<String> = [];
        loop c.children as cid { mut parts.pushBack(self(cid)); }
        return "[" + parts.join(", ") + "]";
    }
    if c.tag == TAG_UNION and c.children.length() > 0 {
        return self(c.children[0]);
    }
    if c.tag == TAG_RESULT and c.children.length() > 0 {
        if c.intVal == 0 { return ".ok(" + self(c.children[0]) + ")"; }
        return ".err(" + self(c.children[0]) + ")";
    }
    c.strVal
};

/** Checks deep structural equality between two compile-time values. */
ctValuesEqual := fn(aId: Int, bId: Int): Bool {
    if aId == bId { return true; }
    if aId < 0 or bId < 0 or aId >= ctPool.length() or bId >= ctPool.length() { return false; }
    a := ctPool[aId];
    b := ctPool[bId];
    if a.tag == TAG_UNION and a.children.length() > 0 {
        if b.tag == TAG_UNION and b.children.length() > 0 {
            return self(a.children[0], b.children[0]) and ctPool[a.children[0]].kind == ctPool[b.children[0]].kind;
        }
        return self(a.children[0], bId) and ctPool[a.children[0]].kind == b.kind;
    }
    if b.tag == TAG_UNION and b.children.length() > 0 {
        return self(aId, b.children[0]) and a.kind == ctPool[b.children[0]].kind;
    }
    if a.tag =!= b.tag { return false; }
    if a.tag == TAG_UNIT { return true; }
    if a.tag == TAG_BOOL or a.tag == TAG_INT { return a.intVal == b.intVal; }
    if a.tag == TAG_UINT or a.tag == TAG_STR { return a.strVal == b.strVal; }
    if a.tag == TAG_FLOAT { return a.floatVal == b.floatVal; }
    if a.tag == TAG_ENUM { return a.intVal == b.intVal and a.children.length() == 0 and b.children.length() == 0; }
    if a.tag == TAG_RESULT {
        if a.intVal =!= b.intVal { return false; }
        if a.children.length() == 0 or b.children.length() == 0 { return true; }
        return self(a.children[0], b.children[0]);
    }
    false
};

/** Constructs a zero-initialized compile-time value matching `zeroParsed`. */
makeZeroCtVal := fn(kind: String, budget: mut EvalBudget, aliases: List<AliasDecl>, modKey: String): Int {
    if types.isDistinctKind(kind) {
        inner := self(types.distinctUnderlyingKind(kind), mut budget, aliases, modKey);
        c := ctPool[inner];
        return allocCell(CtCell {
            tag = c.tag, kind = kind, intVal = c.intVal, floatVal = c.floatVal,
            strVal = c.strVal, children = c.children, keys = c.keys
        }, mut budget);
    }
    if kind == ir.VALUE_KIND_UNIT or kind == ir.VALUE_KIND_NEVER { return makeUnitVal(mut budget); }
    if kind == ir.VALUE_KIND_BOOL { return makeBoolVal(false, kind, mut budget); }
    if numeric.isUnsignedIntKind(kind) { return makeUIntVal(cast<UInt64>(0), kind, mut budget); }
    if numeric.isIntKind(kind) { return makeIntVal(0, kind, mut budget); }
    if numeric.isFloatKind(kind) { return makeFloatVal(0.0, kind, mut budget); }
    if kind == ir.VALUE_KIND_STRING { return makeStrVal("", kind, mut budget); }
    if types.isEnumKind(kind) {
        c0 := types.enumCaseAt(kind, 0);
        return makeEnumVal(kind, 0, c0.name, [], mut budget);
    }
    if types.isTupleKind(kind) {
        cnt := types.tupleComponentCount(kind);
        mut vals: List<Int> = [];
        mut lbls: List<String> = [];
        var i := 0;
        loop i < cnt {
            comp := types.tupleComponent(kind, i);
            mut vals.pushBack(self(comp.kind, mut budget, aliases, modKey));
            mut lbls.pushBack(comp.label);
            i = i + 1;
        }
        return makeTupleVal(kind, vals, lbls, mut budget);
    }
    if types.isRecordKind(kind) {
        cnt := types.recordComponentCount(kind);
        mut vals: List<Int> = [];
        mut keysList: List<String> = [];
        var i := 0;
        loop i < cnt {
            comp := types.recordComponent(kind, i);
            mut vals.pushBack(self(comp.kind, mut budget, aliases, modKey));
            mut keysList.pushBack(comp.label);
            i = i + 1;
        }
        return makeRecordVal(kind, vals, keysList, mut budget);
    }
    if types.isListKind(kind) { return makeListVal(kind, [], mut budget); }
    if types.isArrayKind(kind) {
        ext := types.arrayExtent(kind);
        elKind := types.arrayElementKind(kind);
        mut vals: List<Int> = [];
        var i := 0;
        loop i < ext {
            mut vals.pushBack(self(elKind, mut budget, aliases, modKey));
            i = i + 1;
        }
        return makeArrayVal(kind, vals, mut budget);
    }
    if types.isMapKind(kind) { return makeMapVal(kind, [], [], [], mut budget); }
    if types.isSetKind(kind) { return makeSetVal(kind, [], [], mut budget); }
    if types.isResultKind(kind) {
        okK := types.resultOkKind(kind);
        okVal := self(okK, mut budget, aliases, modKey);
        return makeResultVal(kind, false, okVal, mut budget);
    }
    if types.isUnionKind(kind) {
        mems := types.unionMembers(kind);
        if mems.length() > 0 {
            inner := self(mems[0], mut budget, aliases, modKey);
            return makeUnionVal(kind, 0, inner, mut budget);
        }
    }
    makeUnitVal(mut budget)
};

/** Parses an unsigned integer literal text (decimal, 0x, 0b, 0o, ignoring underscores and optional width suffix). */
parseUInt64Text := fn(raw: String): (value: UInt64, ok: Bool) {
    var s := raw.trim();
    if s.startsWith("+") { s = s.slice(1, s.length()); }
    if s == "" or s.startsWith("-") { return (value = cast<UInt64>(0), ok = false); }
    uIdx := s.indexOf("u", 0);
    if uIdx >= 0 and not (s.startsWith("0x") or s.startsWith("0X")) {
        s = s.slice(0, uIdx);
    } else if s.endsWith("u64") or s.endsWith("u32") or s.endsWith("u16") {
        s = s.slice(0, s.length() - 3);
    } else if s.endsWith("u8") or s.endsWith("u4") or s.endsWith("u2") or s.endsWith("u1") {
        s = s.slice(0, s.length() - 2);
    }
    var base := cast<UInt64>(10);
    var pos := 0;
    if s.startsWith("0x") or s.startsWith("0X") { base = cast<UInt64>(16); pos = 2; }
    else if s.startsWith("0b") or s.startsWith("0B") { base = cast<UInt64>(2); pos = 2; }
    else if s.startsWith("0o") or s.startsWith("0O") { base = cast<UInt64>(8); pos = 2; }
    var acc := cast<UInt64>(0);
    var digits := 0;
    loop pos < s.length() {
        ch := s.at(pos);
        pos = pos + 1;
        if ch == "_" { continue; }
        cp := ch.codePointAt(0);
        var d := -1;
        if cp >= 48 and cp <= 57 {
            d = cp - 48;
        } else if cp >= 97 and cp <= 102 {
            d = 10 + cp - 97;
        } else if cp >= 65 and cp <= 70 {
            d = 10 + cp - 65;
        } else {
            return (value = cast<UInt64>(0), ok = false);
        }
        if d < 0 or cast<UInt64>(d) >= base { return (value = cast<UInt64>(0), ok = false); }
        acc = acc * base + cast<UInt64>(d);
        digits = digits + 1;
    }
    if digits == 0 { return (value = cast<UInt64>(0), ok = false); }
    (value = acc, ok = true)
};

/** Parses a decimal floating-point literal text (with optional sign, fraction, exponent, underscores, and f suffix). */
parseFloatText := fn(raw: String): (value: Float, ok: Bool) {
    var s := raw.trim();
    if s.endsWith("f64") or s.endsWith("f32") or s.endsWith("f16") { s = s.slice(0, s.length() - 3); }
    else if s.endsWith("f8") { s = s.slice(0, s.length() - 2); }
    var neg := false;
    if s.startsWith("-") { neg = true; s = s.slice(1, s.length()); }
    else if s.startsWith("+") { s = s.slice(1, s.length()); }
    if s == "" { return (value = 0.0, ok = false); }
    var whole := 0.0;
    var frac := 0.0;
    var fracScale := 0.1;
    var inFrac := false;
    var digits := 0;
    var pos := 0;
    loop pos < s.length() {
        ch := s.at(pos);
        if ch == "e" or ch == "E" { break; }
        pos = pos + 1;
        if ch == "_" { continue; }
        if ch == "." and not inFrac {
            inFrac = true;
            continue;
        }
        if not ch.isDigit() { return (value = 0.0, ok = false); }
        dv := cast<Float>(ch.codePointAt(0) - 48);
        digits = digits + 1;
        if inFrac {
            frac = frac + dv * fracScale;
            fracScale = fracScale * 0.1;
        } else {
            whole = whole * 10.0 + dv;
        }
    }
    if digits == 0 { return (value = 0.0, ok = false); }
    var val := whole + frac;
    if pos < s.length() and (s.at(pos) == "e" or s.at(pos) == "E") {
        pos = pos + 1;
        var expNeg := false;
        if pos < s.length() and s.at(pos) == "-" { expNeg = true; pos = pos + 1; }
        else if pos < s.length() and s.at(pos) == "+" { pos = pos + 1; }
        var expVal := 0;
        var expDigits := 0;
        loop pos < s.length() {
            ch := s.at(pos);
            pos = pos + 1;
            if ch == "_" { continue; }
            if not ch.isDigit() { return (value = 0.0, ok = false); }
            expVal = expVal * 10 + (ch.codePointAt(0) - 48);
            expDigits = expDigits + 1;
        }
        if expDigits == 0 { return (value = 0.0, ok = false); }
        ePow := if expNeg { 10.0 ** cast<Float>(-expVal) } else { 10.0 ** cast<Float>(expVal) };
        val = val * ePow;
    }
    (value = if neg { -val } else { val }, ok = true)
};

/** Converts or widens a compile-time value `valId` from `actualKind` to `targetKind`. */
coerceCtValue := fn(targetKind: String, actualKind: String, valId: Int, budget: mut EvalBudget): Int {
    if valId < 0 or valId >= ctPool.length() { return valId; }
    if targetKind == "" or targetKind == actualKind or targetKind == ir.VALUE_KIND_NEVER {
        return valId;
    }
    c := ctPool[valId];
    if numeric.isFloatKind(targetKind) and numeric.isNumericKind(actualKind) {
        fVal := if c.tag == TAG_INT { cast<Float>(c.intVal) }
        else if c.tag == TAG_FLOAT { c.floatVal }
        else { 0.0 };
        return makeFloatVal(fVal, targetKind, mut budget);
    }
    if numeric.isSignedIntKind(targetKind) and numeric.isSignedIntKind(actualKind) and c.tag == TAG_INT {
        return makeIntVal(c.intVal, targetKind, mut budget);
    }
    if numeric.isUnsignedIntKind(targetKind) and numeric.isUnsignedIntKind(actualKind) and c.tag == TAG_UINT {
        uRes := parseUInt64Text(c.strVal);
        return makeUIntVal(if uRes.ok { uRes.value } else { cast<UInt64>(0) }, targetKind, mut budget);
    }
    if types.isUnionKind(targetKind) {
        if types.isUnionKind(actualKind) {
            return makeUnionVal(targetKind, 0, valId, mut budget);
        }
        memIdx := types.unionMemberIndex(targetKind, actualKind);
        if memIdx >= 0 {
            return makeUnionVal(targetKind, memIdx, valId, mut budget);
        }
        /* Match compatible subtype inside union */
        mems := types.unionMembers(targetKind);
        var mi := 0;
        loop mi < mems.length() {
            if types.isCompatibleKind(mems[mi], actualKind) {
                coercedInner := self(mems[mi], actualKind, valId, mut budget);
                return makeUnionVal(targetKind, mi, coercedInner, mut budget);
            }
            mi = mi + 1;
        }
    }
    if types.isResultKind(targetKind) {
        okExp := types.resultOkKind(targetKind);
        errExp := types.resultErrKind(targetKind);
        if types.isResultKind(actualKind) {
            if c.tag == TAG_RESULT and c.children.length() > 0 {
                if c.intVal == 0 {
                    coercedOk := self(okExp, types.resultOkKind(actualKind), c.children[0], mut budget);
                    return makeResultVal(targetKind, false, coercedOk, mut budget);
                } else {
                    coercedErr := self(errExp, types.resultErrKind(actualKind), c.children[0], mut budget);
                    return makeResultVal(targetKind, true, coercedErr, mut budget);
                }
            }
            return valId;
        }
        if types.isCompatibleKind(okExp, actualKind) {
            coercedOk := self(okExp, actualKind, valId, mut budget);
            return makeResultVal(targetKind, false, coercedOk, mut budget);
        }
    }
    if types.isDistinctKind(targetKind) {
        inner := self(types.distinctUnderlyingKind(targetKind), actualKind, valId, mut budget);
        ic := ctPool[inner];
        return allocCell(CtCell {
            tag = ic.tag, kind = targetKind, intVal = ic.intVal, floatVal = ic.floatVal,
            strVal = ic.strVal, children = ic.children, keys = ic.keys
        }, mut budget);
    }
    valId
};

/** Finds an imported module metadata entry inside `modKey` by import alias name `aliasName`. */
findImportInModule := fn(modKey: String, aliasName: String): (found: Bool, imp: CtModuleImport) {
    emptyImp := CtModuleImport { aliasName = "", targetModKey = "", targetIdentity = "" };
    res := ctImportsByMod.get(modKey);
    if not res.found { return (found = false, imp = emptyImp); }
    loop res.value as item {
        if item.aliasName == aliasName { return (found = true, imp = item); }
    }
    (found = false, imp = emptyImp)
};

/** Returns true when calling `(modIdentity, opName)` performs a host or build-time I/O effect. */
pub isEffectfulHostBuiltin := fn(modIdentity: String, opName: String): Bool {
    if modIdentity == "lite.core.file.v1" or modIdentity == "lite.core.process.v1" or
    modIdentity == "lite.core.time.v1" or modIdentity.startsWithAt(0, "lite.external.") {
        return true;
    }
    if modIdentity == "lite.core.io.v1" {
        return opName == "output" or opName == "outputLine" or opName == "errorLine" or
        opName == "inputArgs" or opName == "inputAll" or opName == "inputLine" or
        opName == "inputInt" or opName == "inputFloat" or opName == "exit" or
        opName == "Reader.stdin" or opName == "Writer.stdout" or opName == "Writer.stderr" or
        opName == "stdin" or opName == "stdout" or opName == "stderr";
    }
    if modIdentity == "lite.core.crypto.v1" {
        return opName == "randomBytes" or opName == "sha256File";
    }
    if modIdentity == "lite.core.path.v1" {
        return opName == "exists" or opName == "isFile" or opName == "isDirectory" or
        opName == "collectFiles" or opName == "copyFiltered";
    }
    false
};

/** Looks up registered `CtFnDef` indices by `(modKey, fnName)`. */
findFnIndicesInModule := fn(modKey: String, fnName: String): List<Int> {
    res := ctFnIdxByModName.get(modKey + "\t" + fnName);
    if res.found { res.value } else { [] }
};

/** Checks recursively whether a function `defIdx` performs any direct/transitive host effect or reads a mutable module global. */
checkFnDefEffects := fn(defIdx: Int, visited: mut Set<String>): EffectCheckResult {
    if defIdx < 0 or defIdx >= ctFnDefs.length() {
        return EffectCheckResult { pure = false, reason = "unknown function", pos = 0 };
    }
    def := ctFnDefs[defIdx];
    if def.isHostBuiltin {
        if isEffectfulHostBuiltin(def.moduleIdentity, def.name) {
            return EffectCheckResult { pure = false, reason = "call to effectful host operation " + def.name, pos = def.bodyStart };
        }
        return EffectCheckResult { pure = true, reason = "", pos = -1 };
    }
    if visited.has(def.runtime) {
        return EffectCheckResult { pure = true, reason = "", pos = -1 };
    }
    mut visited.add(def.runtime);
    checkRangeEffects(def.source, def.bodyStart, def.bodyEnd, def.prefix, def.moduleKey, mut visited)
};

/** Scans a source span `[rangeStart, rangeEnd)` (skipping comments, strings, nested `fn` bodies, and `comptime { ... }` blocks) for effects or mutable globals. */
checkRangeEffects := fn(source: String, rangeStart: Int, rangeEnd: Int, prefix: String, modKey: String, visited: mut Set<String>): EffectCheckResult {
    limit := if rangeEnd < source.length() { rangeEnd } else { source.length() };
    var cursor := rangeStart;
    loop cursor < limit {
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = syntax.skipAliasString(source, cursor);
            continue;
        }
        if ch == "/" and (cursor + 1 < limit and (source.at(cursor + 1) == "/" or source.at(cursor + 1) == "*")) {
            cursor = syntax.skipComment(source, cursor, prefix);
            continue;
        }
        if ch.isNameStart() {
            wEnd := source.skipName(cursor);
            w := source.slice(cursor, wEnd);
            afterW := syntax.skipTrivia(source, wEnd, prefix);
            if w == "fn" and afterW < limit and (source.at(afterW) == "(" or source.at(afterW) == "<") {
                /* Function literal declaration does not execute at definition time. */
                var scan := afterW;
                if source.at(scan) == "<" {
                    var gd := 0;
                    loop scan < limit {
                        sc := source.at(scan);
                        if sc == "<" { gd = gd + 1; scan = scan + 1; }
                        else if sc == ">" { gd = gd - 1; scan = scan + 1; if gd == 0 { break; } }
                        else { scan = scan + 1; }
                    }
                    scan = syntax.skipTrivia(source, scan, prefix);
                }
                if scan < limit and source.at(scan) == "(" {
                    scan = syntax.scanParenEnd(source, scan, prefix);
                    scan = syntax.skipTrivia(source, scan, prefix);
                }
                /* Skip optional return type and context(...) until `{` */
                loop scan < limit and source.at(scan) =!= "{" {
                    if source.at(scan) == "\"" { scan = syntax.skipAliasString(source, scan); }
                    else if source.at(scan) == "/" and scan + 1 < limit and (source.at(scan + 1) == "/" or source.at(scan + 1) == "*") { scan = syntax.skipComment(source, scan, prefix); }
                    else { scan = scan + 1; }
                }
                if scan < limit and source.at(scan) == "{" {
                    cursor = syntax.scanBraceEnd(source, scan, prefix);
                    continue;
                }
            }
            if w == "comptime" and afterW < limit and source.at(afterW) == "{" {
                /* Explicit comptime { ... } is evaluated directly and explicitly authorizes its effects. */
                cursor = syntax.scanBraceEnd(source, afterW, prefix);
                continue;
            }
            if w == "import" or w == "record" or w == "enum" or w == "interface" or w == "alias" or w == "distinct" {
                cursor = wEnd;
                continue;
            }
            /* Check dotted `mod.op` or `Type.op` */
            if afterW < limit and source.at(afterW) == "." {
                memberStart := syntax.skipTrivia(source, afterW + 1, prefix);
                if memberStart < limit and source.at(memberStart).isNameStart() {
                    memberEnd := source.skipName(memberStart);
                    memberName := source.slice(memberStart, memberEnd);
                    impHit := findImportInModule(modKey, w);
                    if impHit.found {
                        targetId := impHit.imp.targetIdentity;
                        if isEffectfulHostBuiltin(targetId, memberName) {
                            return EffectCheckResult { pure = false, reason = w + "." + memberName + " is an effectful operation and requires an explicit comptime { ... } block", pos = cursor };
                        }
                        if memberName == "Reader" or memberName == "Writer" {
                            afterM := syntax.skipTrivia(source, memberEnd, prefix);
                            if afterM < limit and source.at(afterM) == "." {
                                subS := syntax.skipTrivia(source, afterM + 1, prefix);
                                if subS < limit and source.at(subS).isNameStart() {
                                    subE := source.skipName(subS);
                                    subName := source.slice(subS, subE);
                                    if isEffectfulHostBuiltin(targetId, memberName + "." + subName) {
                                        return EffectCheckResult { pure = false, reason = w + "." + memberName + "." + subName + " requires an explicit comptime { ... } block", pos = cursor };
                                    }
                                }
                            }
                        }
                        if isModuleMutableGlobal(impHit.imp.targetModKey, memberName) {
                            return EffectCheckResult { pure = false, reason = "bare module initializer cannot depend on mutable global " + w + "." + memberName, pos = cursor };
                        }
                        targetFns := findFnIndicesInModule(impHit.imp.targetModKey, memberName);
                        loop targetFns as tIdx {
                            sub := checkFnDefEffects(tIdx, mut visited);
                            if not sub.pure {
                                return EffectCheckResult { pure = false, reason = w + "." + memberName + " transitively performs effects (" + sub.reason + ")", pos = cursor };
                            }
                        }
                        cursor = memberEnd;
                        continue;
                    }
                    typeFns := findFnIndicesInModule(modKey, w + "." + memberName);
                    loop typeFns as tfIdx {
                        sub := checkFnDefEffects(tfIdx, mut visited);
                        if not sub.pure {
                            return EffectCheckResult { pure = false, reason = w + "." + memberName + " transitively performs effects (" + sub.reason + ")", pos = cursor };
                        }
                    }
                }
            }
            if isModuleMutableGlobal(modKey, w) {
                return EffectCheckResult { pure = false, reason = "module initializer cannot read mutable binding " + w, pos = cursor };
            }
            afterCallPos := if afterW < limit and source.at(afterW) == "<" {
                /* Could be `f<...>(...)` or `x < y` */
                afterW
            } else { afterW };
            sameModFns := findFnIndicesInModule(modKey, w);
            if sameModFns.length() > 0 {
                var looksLikeCall := afterCallPos < limit and source.at(afterCallPos) == "(";
                if not looksLikeCall and afterCallPos < limit and source.at(afterCallPos) == "<" {
                    /* Heuristic scan for `>( ` */
                    var gtPos := afterCallPos + 1;
                    var gd := 1;
                    loop gtPos < limit and gd > 0 {
                        gc := source.at(gtPos);
                        if gc == "<" { gd = gd + 1; }
                        else if gc == ">" { gd = gd - 1; }
                        else if gc == ";" or gc == "{" or gc == "}" { break; }
                        gtPos = gtPos + 1;
                    }
                    if gd == 0 {
                        afterGt := syntax.skipTrivia(source, gtPos, prefix);
                        if afterGt < limit and source.at(afterGt) == "(" { looksLikeCall = true; }
                    }
                }
                if looksLikeCall {
                    loop sameModFns as sfIdx {
                        sub := checkFnDefEffects(sfIdx, mut visited);
                        if not sub.pure {
                            return EffectCheckResult { pure = false, reason = w + " transitively performs effects (" + sub.reason + ")", pos = cursor };
                        }
                    }
                }
            }
            cursor = wEnd;
            continue;
        }
        cursor = cursor + 1;
    }
    EffectCheckResult { pure = true, reason = "", pos = -1 }
};

/** Checks a module-level bare initializer expression `[exprStart, exprEnd)` for Stage-1 purity before evaluating it. */
pub checkExprEffects := fn(source: String, exprStart: Int, exprEnd: Int, prefix: String, modKey: String): EffectCheckResult {
    mut visited: Set<String>;
    checkRangeEffects(source, exprStart, exprEnd, prefix, modKey, mut visited)
};

/* --- Evaluator lookup helpers --- */

resolveCtTypeAt := fn(source: String, pos: Int, prefix: String, aliases: List<AliasDecl>): (ok: Bool, kind: String, next: Int) {
    emptySeen: List<String> = [];
    types.canResolveTypeAt(source, pos, prefix, aliases, "", emptySeen, 32)
};

rawNominalDisplay := fn(kind: String): String {
    if kind == types.CORE_ERROR_KIND { return "Error"; }
    if types.isRecordKind(kind) { return types.recordDisplayName(kind); }
    if types.isEnumKind(kind) { return types.enumDisplayName(kind); }
    if types.isDistinctKind(kind) { return types.distinctDisplayName(kind); }
    ""
};

baseNominalName := fn(kind: String): String {
    disp := rawNominalDisplay(kind);
    lt := disp.indexOf("<", 0);
    if lt >= 0 { disp.slice(0, lt) } else { disp }
};

splitCanonicalNominalArgs := fn(kind: String): List<String> {
    mut out: List<String> = [];
    disp := rawNominalDisplay(kind);
    lt := disp.indexOf("<", 0);
    if lt < 0 or not disp.endsWith(">") { return out; }
    argsStr := disp.slice(lt + 1, disp.length() - 1);
    if argsStr == "" { return out; }
    var pos := 0;
    var start := 0;
    var depth := 0;
    loop pos < argsStr.length() {
        ch := argsStr.at(pos);
        if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
        else if ch == ">" or ch == ")" or ch == "]" { if depth > 0 { depth = depth - 1; } }
        else if ch == "," and depth == 0 {
            mut out.pushBack(argsStr.slice(start, pos).trim());
            start = pos + 1;
        }
        pos = pos + 1;
    }
    if start < argsStr.length() { mut out.pushBack(argsStr.slice(start, argsStr.length()).trim()); }
    out
};

findTopLevelRangeOp := fn(source: String, startPos: Int, limitPos: Int, prefix: String): (found: Bool, pos: Int, width: Int, inclusive: Bool) {
    var cursor := syntax.skipTrivia(source, startPos, prefix);
    var depth := 0;
    loop cursor < limitPos {
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = syntax.skipAliasString(source, cursor);
            continue;
        }
        if ch == "(" or ch == "[" or ch == "{" { depth = depth + 1; cursor = cursor + 1; continue; }
        if ch == ")" or ch == "]" or ch == "}" { if depth > 0 { depth = depth - 1; } cursor = cursor + 1; continue; }
        if depth == 0 and cursor + 1 < limitPos and source.at(cursor) == "." and source.at(cursor + 1) == "." {
            if cursor + 2 < limitPos and source.at(cursor + 2) == "=" {
                return (found = true, pos = cursor, width = 3, inclusive = true);
            }
            return (found = true, pos = cursor, width = 2, inclusive = false);
        }
        cursor = cursor + 1;
    }
    (found = false, pos = -1, width = 0, inclusive = false)
};

findBalancedAngleEnd := fn(source: String, ltPos: Int, limitPos: Int): Int {
    var gt := ltPos + 1;
    var gd := 1;
    loop gt < limitPos and gd > 0 {
        gc := source.at(gt);
        if gc == "<" { gd = gd + 1; }
        else if gc == ">" { gd = gd - 1; }
        else if gc == ";" or gc == "{" or gc == "}" { return -1; }
        gt = gt + 1;
    }
    if gd == 0 { gt } else { -1 }
};

frameFindBinding := fn(frame: CtFrame, name: String): Int {
    var i := frame.bindings.length() - 1;
    loop i >= 0 {
        if frame.bindings[i].name == name { return i; }
        i = i - 1;
    }
    -1
};

frameSetOrPush := fn(frame: mut CtFrame, name: String, valId: Int, mutable: Bool, kind: String): Unit {
    idx := frameFindBinding(frame, name);
    if idx >= 0 {
        mut frame.bindings.setAt(idx, CtBinding { =name, =valId, =mutable, =kind });
    } else {
        mut frame.bindings.pushBack(CtBinding { =name, =valId, =mutable, =kind });
    }
};

/** Decodes pipe-separated parameter metadata `(name=kind)` returning `name` and `kind` (stripping leading `"mut "` if any). */
splitPipeEntry := fn(entry: String): (name: String, kind: String, isMut: Bool) {
    eq := entry.indexOf("=", 0);
    if eq < 0 { return (name = entry, kind = "", isMut = false); }
    pName := entry.slice(0, eq);
    rawKind := entry.slice(eq + 1, entry.length());
    isMut := rawKind.startsWithAt(0, "mut ");
    kind := if isMut { rawKind.slice(4, rawKind.length()) } else { rawKind };
    (name = pName, =kind, =isMut)
};

splitPipeEntriesLocal := fn(encoded: String, count: Int): List<String> {
    mut out: List<String> = [];
    if count <= 0 or encoded == "" { return out; }
    var pos := 0;
    size := encoded.length();
    var depth := 0;
    var start := 0;
    loop pos < size {
        ch := encoded.at(pos);
        if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
        else if ch == ">" or ch == ")" or ch == "]" { if depth > 0 { depth = depth - 1; } }
        else if ch == "|" and depth == 0 {
            mut out.pushBack(encoded.slice(start, pos));
            start = pos + 1;
        }
        pos = pos + 1;
    }
    if start <= size {
        mut out.pushBack(encoded.slice(start, size));
    }
    out
};

/* --- Forward declarations implemented by evalBlockRange / evalExprAt --- */

decodeStringLiteral := fn(source: String, start: Int, prefix: String): (ok: Bool, text: String, next: Int) {
    lit := syntax.parseText(ir.TARGET_TS, source, start, prefix);
    (ok = true, text = lit.textValue, next = lit.next)
};

/** Checks integer arithmetic with overflow panic matching runtime Lite behavior. */
evalCheckedIntBin := fn(op: String, lVal: Int, rVal: Int, kind: String, budget: mut EvalBudget): CtOutcome {
    if (op == "/" or op == "%" or op == ":/" or op == ":%") and rVal == 0 {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "integer division by zero in compile-time evaluation" };
    }
    folded := ctx.tryFoldInteger(op, lVal, rVal);
    if not folded.ok or not numeric.intKindFits(kind, folded.value) {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "integer overflow in compile-time evaluation (" + op + ")" };
    }
    vid := makeIntVal(folded.value, kind, mut budget);
    CtOutcome { ok = true, valId = vid, flow = FLOW_NONE, error = "" }
};

/** Evaluates Float arithmetic (`+ - * / **`), returning FLOW_PANIC if non-finite without tripping compiler runtime panics. */
evalFloatBin := fn(op: String, lVal: Float, rVal: Float, kind: String, budget: mut EvalBudget): CtOutcome {
    dblMax := 1.7976931348623157e308;
    absF := fn(x: Float): Float { if x < 0.0 { 0.0 - x } else { x } };
    al := absF(lVal);
    ar := absF(rVal);
    var overflows := false;
    if op == "+" {
        if (lVal > 0.0 and rVal > 0.0 and lVal > dblMax - rVal) or (lVal < 0.0 and rVal < 0.0 and lVal < (0.0 - dblMax) - rVal) {
            overflows = true;
        }
    } else if op == "-" {
        if (lVal > 0.0 and rVal < 0.0 and lVal > dblMax + rVal) or (lVal < 0.0 and rVal > 0.0 and lVal < (0.0 - dblMax) + rVal) {
            overflows = true;
        }
    } else if op == "*" {
        if ar > 1.0 and al > dblMax / ar { overflows = true; }
    } else if op == "/" {
        if rVal == 0.0 {
            return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "float division by zero in compile-time evaluation" };
        }
        if ar < 1.0 and al > dblMax * ar { overflows = true; }
    } else {
        if (lVal == 0.0 and rVal < 0.0) or
        (lVal < 0.0 and ar <= 4503599627370496.0 and cast<Float>(Int.trunc(rVal)) =!= rVal) or
        (al > 1.0e154 and ar >= 2.0) or (al >= 10.0 and rVal > 308.0) or (al > 1.0 and rVal > 1024.0) or
        (al > 0.0 and al <= 0.1 and rVal < -308.0) or (al > 0.0 and al < 1.0 and rVal < -1024.0) {
            overflows = true;
        }
    }
    if overflows {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "non-finite floating value in compile-time evaluation" };
    }
    res := if op == "+" { lVal + rVal }
    else if op == "-" { lVal - rVal }
    else if op == "*" { lVal * rVal }
    else if op == "/" { lVal / rVal }
    else { lVal ** rVal };
    vid := makeFloatVal(res, kind, mut budget);
    CtOutcome { ok = true, valId = vid, flow = FLOW_NONE, error = "" }
};

/** Evaluates a comparison operator between two scalar or union/result values. */
evalComparisonOp := fn(op: String, aId: Int, bId: Int): Bool {
    a := ctPool[aId];
    b := ctPool[bId];
    if a.tag == TAG_UNION or b.tag == TAG_UNION or a.tag == TAG_RESULT or b.tag == TAG_RESULT {
        eq := ctValuesEqual(aId, bId);
        return if op == "==" { eq } else { not eq };
    }
    if a.tag == TAG_STR and b.tag == TAG_STR {
        return ctx.compareTexts(op, a.strVal, b.strVal);
    }
    if a.tag == TAG_BOOL and b.tag == TAG_BOOL {
        return ctx.compareBools(op, a.intVal =!= 0, b.intVal =!= 0);
    }
    if (a.tag == TAG_INT or a.tag == TAG_ENUM) and (b.tag == TAG_INT or b.tag == TAG_ENUM) {
        return ctx.compareIntegers(op, a.intVal, b.intVal);
    }
    if a.tag == TAG_UINT and b.tag == TAG_UINT {
        au := parseUInt64Text(a.strVal);
        bu := parseUInt64Text(b.strVal);
        av := if au.ok { au.value } else { cast<UInt64>(0) };
        bv := if bu.ok { bu.value } else { cast<UInt64>(0) };
        if op == "==" { return av == bv; }
        if op == "=!=" { return av =!= bv; }
        if op == "<" or op == ">!" { return av < bv; }
        if op == "<=" or op == ">!=" { return av <= bv; }
        if op == ">" or op == "<!" { return av > bv; }
        return av >= bv;
    }
    if a.tag == TAG_FLOAT or b.tag == TAG_FLOAT {
        af := if a.tag == TAG_FLOAT { a.floatVal } else { cast<Float>(a.intVal) };
        bf := if b.tag == TAG_FLOAT { b.floatVal } else { cast<Float>(b.intVal) };
        if op == "==" { return af == bf; }
        if op == "=!=" { return af =!= bf; }
        if op == "<" { return af < bf; }
        if op == "<!" { return not (af < bf); }
        if op == "<=" { return af <= bf; }
        if op == "<!=" { return not (af <= bf); }
        if op == ">" { return af > bf; }
        if op == ">!" { return not (af > bf); }
        if op == ">=" { return af >= bf; }
        return not (af >= bf);
    }
    false
};

/** Tests whether compile-time value `valId` matches a resolved `: Type` (`targetKind`). */
valueMatchesType := fn(valId: Int, targetKind: String): Bool {
    if valId < 0 or valId >= ctPool.length() { return false; }
    c := ctPool[valId];
    actualKind := if c.tag == TAG_UNION and c.children.length() > 0 {
        ctPool[c.children[0]].kind
    } else {
        c.kind
    };
    if types.isUnionKind(targetKind) {
        return types.unionMemberIndex(targetKind, actualKind) >= 0;
    }
    actualKind == targetKind
};

/** Evaluates a call-argument list `(a, label = b, =shorthand)` cleanly without mutating the source. */
skipToMatchingClose := fn(source: String, openPos: Int, openCh: String, closeCh: String, prefix: String): Int {
    if openCh == "(" { return syntax.scanParenEnd(source, openPos, prefix); }
    if openCh == "[" { return syntax.scanBracketEnd(source, openPos, prefix); }
    syntax.scanBraceEnd(source, openPos, prefix)
};

/** Evaluates one host builtin call (`modIdentity`, `opName`) at compile time using `core` host APIs. */
evalHostBuiltinCall := fn(modIdentity: String, opName: String, args: List<Int>, budget: mut EvalBudget): CtOutcome {
    if not budget.allowEffects and isEffectfulHostBuiltin(modIdentity, opName) {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = opName + " requires an explicit comptime { ... } block" };
    }
    if modIdentity == "lite.core.io.v1" {
        if opName == "output" {
            mut parts: List<String> = [];
            loop args as a { mut parts.pushBack(formatCtVal(a)); }
            txt := parts.join("");
            if ctStdoutIsArtifact { io.errorLine(txt); } else { io.output(txt); }
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "outputLine" {
            mut parts: List<String> = [];
            loop args as a { mut parts.pushBack(formatCtVal(a)); }
            txt := parts.join(" ");
            if ctStdoutIsArtifact { io.errorLine(txt); } else { io.outputLine(txt); }
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "errorLine" {
            msg := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            io.errorLine(msg);
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "inputAll" {
            pr := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            s := io.inputAll(pr);
            return CtOutcome { ok = true, valId = makeStrVal(s, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "inputLine" {
            pr := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            s := io.inputLine(pr);
            return CtOutcome { ok = true, valId = makeStrVal(s, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "inputInt" {
            pr := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            n := io.inputInt(pr);
            return CtOutcome { ok = true, valId = makeIntVal(n, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "inputFloat" {
            pr := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            f := io.inputFloat(pr);
            return CtOutcome { ok = true, valId = makeFloatVal(f, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "inputArgs" {
            raw := io.inputArgs();
            mut ids: List<Int> = [];
            loop raw as r { mut ids.pushBack(makeStrVal(r, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<String>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "exit" {
            code := if args.length() > 0 { ctPool[args[0]].intVal } else { 1 };
            return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "comptime called io.exit(" + code.toText() + ")" };
        }
        if opName == "Reader.stdin" or opName == "Reader.fromBytes" {
            rdr := if opName == "Reader.stdin" { io.Reader.stdin() } else {
                mut bs: List<Int> = [];
                if args.length() > 0 {
                    loop ctPool[args[0]].children as cid { mut bs.pushBack(ctPool[cid].intVal); }
                }
                io.Reader.fromBytes(bs)
            };
            rid := ctReaders.length();
            mut ctReaders.pushBack(rdr);
            return CtOutcome { ok = true, valId = allocCell(CtCell { tag = TAG_READER, kind = "Distinct<lib/core/io#0#Reader;>", intVal = rid, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.buffer" or opName == "Writer.stdout" or opName == "Writer.stderr" {
            wr := if opName == "Writer.buffer" { io.Writer.buffer() } else if opName == "Writer.stdout" { io.Writer.stdout() } else { io.Writer.stderr() };
            wid := ctWriters.length();
            mut ctWriters.pushBack(wr);
            return CtOutcome { ok = true, valId = allocCell(CtCell { tag = TAG_WRITER, kind = "Distinct<lib/core/io#0#Writer;>", intVal = wid, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.ok" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            return CtOutcome { ok = true, valId = makeBoolVal(ctReaders[rid].ok(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.atEof" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            return CtOutcome { ok = true, valId = makeBoolVal(ctReaders[rid].atEof(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.error" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            return CtOutcome { ok = true, valId = makeStrVal(ctReaders[rid].error(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.read" and args.length() >= 2 {
            rid := ctPool[args[0]].intVal;
            maxB := ctPool[args[1]].intVal;
            bs := ctReaders[rid].read(maxB);
            mut ids: List<Int> = [];
            loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if (opName == "Reader.close" or opName == "close") and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            if ctPool[args[0]].tag == TAG_READER {
                res := ctReaders[rid].close();
                okId := makeBoolVal(res.ok, "", mut budget);
                errId := makeStrVal(res.error, "", mut budget);
                return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,error:String>", [okId, errId], ["ok", "error"], mut budget), flow = FLOW_NONE, error = "" };
            }
            if ctPool[args[0]].tag == TAG_WRITER {
                res := ctWriters[rid].close();
                okId := makeBoolVal(res.ok, "", mut budget);
                errId := makeStrVal(res.error, "", mut budget);
                return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,error:String>", [okId, errId], ["ok", "error"], mut budget), flow = FLOW_NONE, error = "" };
            }
        }
        if opName == "Writer.bytes" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            bs := ctWriters[wid].bytes();
            mut ids: List<Int> = [];
            loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.text" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            res := ctWriters[wid].text();
            okId := makeBoolVal(res.ok, "", mut budget);
            txtId := makeStrVal(res.text, "", mut budget);
            errId := makeStrVal(res.error, "", mut budget);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,text:String,error:String>", [okId, txtId, errId], ["ok", "text", "error"], mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.clear" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            ctWriters[wid].clear();
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.fromText" and args.length() > 0 {
            rdr := io.Reader.fromText(formatCtVal(args[0]));
            rid := ctReaders.length();
            mut ctReaders.pushBack(rdr);
            return CtOutcome { ok = true, valId = allocCell(CtCell { tag = TAG_READER, kind = "Distinct<lib/core/io#0#Reader;>", intVal = rid, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.readAll" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            bs := ctReaders[rid].readAll();
            mut ids: List<Int> = [];
            loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Reader.readAllText" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            res := ctReaders[rid].readAllText();
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,text:String,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.text, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "text", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Reader.readLine" and args.length() > 0 {
            rid := ctPool[args[0]].intVal;
            res := ctReaders[rid].readLine();
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,line:String,eof:Bool,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.line, "", mut budget), makeBoolVal(res.eof, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "line", "eof", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Reader.copyTo" and args.length() >= 2 {
            rid := ctPool[args[0]].intVal;
            wid := ctPool[args[1]].intVal;
            res := ctReaders[rid].copyTo(ctWriters[wid]);
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,copied:Int,error:String>", [makeBoolVal(res.ok, "", mut budget), makeIntVal(res.copied, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "copied", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Writer.ok" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            return CtOutcome { ok = true, valId = makeBoolVal(ctWriters[wid].ok(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.error" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            return CtOutcome { ok = true, valId = makeStrVal(ctWriters[wid].error(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.writeText" and args.length() >= 2 {
            wid := ctPool[args[0]].intVal;
            res := ctWriters[wid].writeText(formatCtVal(args[1]));
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Writer.writeLine" and args.length() >= 2 {
            wid := ctPool[args[0]].intVal;
            res := ctWriters[wid].writeLine(formatCtVal(args[1]));
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Writer.flush" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            res := ctWriters[wid].flush();
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Writer.close" and args.length() > 0 {
            wid := ctPool[args[0]].intVal;
            res := ctWriters[wid].close();
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Writer.write" and args.length() >= 2 {
            wid := ctPool[args[0]].intVal;
            mut bs: List<Int> = [];
            loop ctPool[args[1]].children as cid { mut bs.pushBack(ctPool[cid].intVal); }
            res := ctWriters[wid].write(bs);
            okId := makeBoolVal(res.ok, "", mut budget);
            wrId := makeIntVal(res.written, "", mut budget);
            errId := makeStrVal(res.error, "", mut budget);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,written:Int,error:String>", [okId, wrId, errId], ["ok", "written", "error"], mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "Writer.writeAndClose" and args.length() >= 2 {
            wid := ctPool[args[0]].intVal;
            mut bs: List<Int> = [];
            loop ctPool[args[1]].children as cid { mut bs.pushBack(ctPool[cid].intVal); }
            res := ctWriters[wid].writeAndClose(bs);
            okId := makeBoolVal(res.ok, "", mut budget);
            errId := makeStrVal(res.error, "", mut budget);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,error:String>", [okId, errId], ["ok", "error"], mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if modIdentity == "lite.core.file.v1" {
        if opName == "kind" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            return CtOutcome { ok = true, valId = makeStrVal(fs.kind(p), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "openReader" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            rdr := fs.openReader(p);
            rid := ctReaders.length();
            mut ctReaders.pushBack(rdr);
            return CtOutcome { ok = true, valId = allocCell(CtCell { tag = TAG_READER, kind = "Distinct<lib/core/io#0#Reader;>", intVal = rid, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget), flow = FLOW_NONE, error = "" };
        }
        if (opName == "openWriter" or opName == "openAppender") and args.length() > 0 {
            p := formatCtVal(args[0]);
            wr := if opName == "openWriter" { fs.openWriter(p) } else { fs.openAppender(p) };
            wid := ctWriters.length();
            mut ctWriters.pushBack(wr);
            return CtOutcome { ok = true, valId = allocCell(CtCell { tag = TAG_WRITER, kind = "Distinct<lib/core/io#0#Writer;>", intVal = wid, floatVal = 0.0, strVal = "", children = [], keys = [] }, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "listDir" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            if fs.kind(p) =!= fs.FILE_KIND_DIR {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot list non-directory " + p };
            }
            entries := fs.listDir(p);
            mut ids: List<Int> = [];
            loop entries as e { mut ids.pushBack(makeStrVal(e, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<String>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "realPath" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            res := fs.realPath(p);
            okId := makeBoolVal(res.ok, "", mut budget);
            pId := makeStrVal(res.path, "", mut budget);
            errId := makeStrVal(res.error, "", mut budget);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,path:String,error:String>", [okId, pId, errId], ["ok", "path", "error"], mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "readText" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            res := fs.readText(p);
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,text:String,error:String>",
                [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.text, "", mut budget), makeStrVal(res.error, "", mut budget)],
                ["ok", "text", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "readBytes" and args.length() > 0 {
            p := formatCtVal(args[0]);
            recordTracedFile(p);
            bs := fs.readBytes(p);
            mut ids: List<Int> = [];
            loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if (opName == "writeText" or opName == "appendText") and args.length() >= 2 {
            p := formatCtVal(args[0]);
            txt := formatCtVal(args[1]);
            res := if opName == "writeText" { fs.writeText(p, txt) } else { fs.appendText(p, txt) };
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>",
                [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)],
                ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if (opName == "writeBytes" or opName == "appendBytes") and args.length() >= 2 {
            p := formatCtVal(args[0]);
            mut bs: List<Int> = [];
            loop ctPool[args[1]].children as cid { mut bs.pushBack(ctPool[cid].intVal); }
            res := if opName == "writeBytes" { fs.writeBytes(p, bs) } else { fs.appendBytes(p, bs) };
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,error:String>",
                [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.error, "", mut budget)],
                ["ok", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "makeDir" or opName == "remove" or opName == "copy" or opName == "symlink" or opName == "makeTempDir" {
            p := if args.length() > 0 { formatCtVal(args[0]) } else { "" };
            p2 := if args.length() > 1 { formatCtVal(args[1]) } else { "" };
            if opName == "makeTempDir" {
                res := fs.makeTempDir(p);
                okId := makeBoolVal(res.ok, "", mut budget);
                pId := makeStrVal(res.path, "", mut budget);
                errId := makeStrVal(res.error, "", mut budget);
                return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,path:String,error:String>", [okId, pId, errId], ["ok", "path", "error"], mut budget), flow = FLOW_NONE, error = "" };
            }
            res := if opName == "makeDir" { fs.makeDir(p) }
            else if opName == "remove" { fs.remove(p) }
            else if opName == "copy" { recordTracedFile(p); fs.copy(p, p2) }
            else { fs.symlink(p, p2) };
            okId := makeBoolVal(res.ok, "", mut budget);
            errId := makeStrVal(res.error, "", mut budget);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<ok:Bool,error:String>", [okId, errId], ["ok", "error"], mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if modIdentity == "lite.core.process.v1" {
        if opName == "cwd" { return CtOutcome { ok = true, valId = makeStrVal(proc.cwd(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "execPath" { return CtOutcome { ok = true, valId = makeStrVal(proc.execPath(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "entryPath" { return CtOutcome { ok = true, valId = makeStrVal(proc.entryPath(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "platform" { return CtOutcome { ok = true, valId = makeStrVal(proc.platform(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "arch" { return CtOutcome { ok = true, valId = makeStrVal(proc.arch(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "runtimeVersion" { return CtOutcome { ok = true, valId = makeStrVal(proc.runtimeVersion(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "envGet" and args.length() > 0 {
            res := proc.envGet(formatCtVal(args[0]));
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<found:Bool,value:String>", [makeBoolVal(res.found, "", mut budget), makeStrVal(res.value, "", mut budget)], ["found", "value"], mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "run" and args.length() >= 6 {
            cmd := formatCtVal(args[0]);
            mut cArgs: List<String> = [];
            loop ctPool[args[1]].children as cid { mut cArgs.pushBack(formatCtVal(cid)); }
            wd := formatCtVal(args[2]);
            mut envOv: List<String> = [];
            loop ctPool[args[3]].children as eid { mut envOv.pushBack(formatCtVal(eid)); }
            cap := ctPool[args[4]].intVal =!= 0;
            stIn := formatCtVal(args[5]);
            res := proc.run(cmd, cArgs, wd, envOv, cap, stIn);
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<status:Int,stdout:String,stderr:String,error:String>",
                [makeIntVal(res.status, "", mut budget), makeStrVal(res.stdout, "", mut budget), makeStrVal(res.stderr, "", mut budget), makeStrVal(res.error, "", mut budget)],
                ["status", "stdout", "stderr", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
    }
    if modIdentity == "lite.core.time.v1" {
        if opName == "monotonicNs" { return CtOutcome { ok = true, valId = makeIntVal(time.monotonicNs(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "epochNs" { return CtOutcome { ok = true, valId = makeIntVal(time.epochNs(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if opName == "sleepMs" and args.length() > 0 {
            time.sleepMs(ctPool[args[0]].intVal);
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "localDate" { return CtOutcome { ok = true, valId = makeStrVal(time.localDate(), "", mut budget), flow = FLOW_NONE, error = "" }; }
    }
    if modIdentity == "lite.core.crypto.v1" and opName == "randomBytes" and args.length() > 0 {
        bs := crypto.randomBytes(ctPool[args[0]].intVal);
        mut ids: List<Int> = [];
        loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
        return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
    }
    if modIdentity == "lite.core.text.v1" {
        if opName == "String.length" and args.length() > 0 {
            return CtOutcome { ok = true, valId = makeIntVal(ctPool[args[0]].strVal.length(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "String.at" and args.length() >= 2 {
            s := ctPool[args[0]].strVal;
            idx := ctPool[args[1]].intVal;
            if idx < 0 or idx >= s.length() {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "String.at index " + idx.toText() + " out of bounds" };
            }
            return CtOutcome { ok = true, valId = makeStrVal(s.at(idx), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "String.slice" and args.length() >= 3 {
            s := ctPool[args[0]].strVal;
            a := ctPool[args[1]].intVal;
            b := ctPool[args[2]].intVal;
            if a < 0 or b < a or b > s.length() {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "String.slice(" + a.toText() + ", " + b.toText() + ") out of bounds" };
            }
            return CtOutcome { ok = true, valId = makeStrVal(s.slice(a, b), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "String.toCodePoints" and args.length() > 0 {
            cps := ctPool[args[0]].strVal.toCodePoints();
            mut ids: List<Int> = [];
            loop cps as cp { mut ids.pushBack(makeIntVal(cp, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if opName == "String.fromCodePoints" and args.length() > 0 {
            mut cps: List<Int> = [];
            loop ctPool[args[0]].children as cid { mut cps.pushBack(ctPool[cid].intVal); }
            res := String.fromCodePoints(cps);
            return CtOutcome {
                ok = true,
                valId = makeTupleVal("Tuple<ok:Bool,text:String,error:String>", [makeBoolVal(res.ok, "", mut budget), makeStrVal(res.text, "", mut budget), makeStrVal(res.error, "", mut budget)], ["ok", "text", "error"], mut budget),
                flow = FLOW_NONE, error = ""
            };
        }
        if opName == "Float.toText" or opName == "Float32.toText" {
            return CtOutcome { ok = true, valId = makeStrVal(ctPool[args[0]].floatVal.toText(), "", mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if modIdentity == "lite.core.int.v1" {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsupported host int builtin " + opName + " in comptime" };
    }
    if modIdentity == "lite.core.diag.v1" {
        if opName == "fail" {
            msg := if args.length() >= 2 { formatCtVal(args[0]) + ":" + formatCtVal(args[1]) } else if args.length() == 1 { formatCtVal(args[0]) } else { "diag.fail" };
            return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = msg };
        }
        if opName == "expect" and args.length() >= 3 {
            if ctPool[args[1]].intVal == 0 {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = formatCtVal(args[0]) + ":" + formatCtVal(args[2]) };
            }
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsupported compile-time host operation " + modIdentity + "." + opName }
};

/** Applies an arithmetic or comparison operator token to two scalar compile-time values. */
applyBinaryVal := fn(op: String, lId: Int, rId: Int, budget: mut EvalBudget): CtOutcome {
    l := ctPool[lId];
    r := ctPool[rId];
    if op == "==" or op == "=!=" or op == "<" or op == "<=" or op == ">" or op == ">=" or op == "<!" or op == "<!=" or op == ">!" or op == ">!=" {
        return CtOutcome { ok = true, valId = makeBoolVal(evalComparisonOp(op, lId, rId), "", mut budget), flow = FLOW_NONE, error = "" };
    }
    if op == "+" and l.tag == TAG_STR and r.tag == TAG_STR {
        return CtOutcome { ok = true, valId = makeStrVal(l.strVal + r.strVal, "", mut budget), flow = FLOW_NONE, error = "" };
    }
    if op == "**" {
        lf := if l.tag == TAG_FLOAT { l.floatVal } else { cast<Float>(l.intVal) };
        rf := if r.tag == TAG_FLOAT { r.floatVal } else { cast<Float>(r.intVal) };
        return evalFloatBin("**", lf, rf, ir.VALUE_KIND_FLOAT, mut budget);
    }
    if l.tag == TAG_INT and r.tag == TAG_INT {
        resK := numeric.promoteNumericKind(l.kind, r.kind);
        return evalCheckedIntBin(op, l.intVal, r.intVal, if resK =!= "" { resK } else { ir.VALUE_KIND_INT }, mut budget);
    }
    if l.tag == TAG_UINT and r.tag == TAG_UINT {
        resK := numeric.promoteNumericKind(l.kind, r.kind);
        rk := if resK =!= "" { resK } else { ir.VALUE_KIND_UINT64 };
        au := parseUInt64Text(l.strVal);
        bu := parseUInt64Text(r.strVal);
        av := if au.ok { au.value } else { cast<UInt64>(0) };
        bv := if bu.ok { bu.value } else { cast<UInt64>(0) };
        if (op == "/" or op == "%" or op == ":/" or op == ":%") and bv == cast<UInt64>(0) {
            return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsigned division by zero in compile-time evaluation" };
        }
        rv := if op == "+" { av + bv }
        else if op == "-" {
            if av < bv { return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsigned underflow in compile-time evaluation" }; }
            av - bv
        } else if op == "*" { av * bv }
        else if op == "/" or op == ":/" { av / bv }
        else { av % bv };
        return CtOutcome { ok = true, valId = makeUIntVal(rv, rk, mut budget), flow = FLOW_NONE, error = "" };
    }
    lf := if l.tag == TAG_FLOAT { l.floatVal } else { cast<Float>(l.intVal) };
    rf := if r.tag == TAG_FLOAT { r.floatVal } else { cast<Float>(r.intVal) };
    resK := numeric.promoteNumericKind(l.kind, r.kind);
    evalFloatBin(op, lf, rf, if numeric.isFloatKind(resK) { resK } else { ir.VALUE_KIND_FLOAT }, mut budget)
};

/* --- Evaluator entry points: forward helpers declared above, actual recursive bodies below --- */

/** Looks up the first matching overload index for `(modKey, fnName)` given argument count/labels. */
selectOverloadFnDef := fn(indices: List<Int>, posArgCount: Int, namedLabels: List<String>): Int {
    if indices.length() == 0 { return -1; }
    if indices.length() == 1 { return indices[0]; }
    totalArgs := posArgCount + namedLabels.length();
    var fallback := indices[0];
    loop indices as idx {
        def := ctFnDefs[idx];
        if def.paramCount =!= totalArgs { continue; }
        entries := splitPipeEntriesLocal(def.paramsEncoded, def.paramCount);
        var ok := true;
        loop namedLabels as lbl {
            var foundLbl := false;
            loop entries as e {
                if splitPipeEntry(e).name == lbl { foundLbl = true; break; }
            }
            if not foundLbl { ok = false; break; }
        }
        if ok { return idx; }
        fallback = idx;
    }
    fallback
};

/** Evaluates a sequence of statements `[startPos, limitPos)` in `source` using `frame` and `budget`. */
evalStmtRange := fn(source: String, startPos: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): CtOutcome {
    t := tickStep(mut budget);
    if not t.ok { return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = t.msg }; }
    modMetaRes := ctModules.get(frame.moduleKey);
    var cursor := syntax.skipItemSeparators(source, startPos, prefix);
    var lastVal := makeUnitVal(mut budget);
    loop cursor < limitPos {
        tLoop := tickStep(mut budget);
        if not tLoop.ok { return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = tLoop.msg }; }
        if source.at(cursor) == "}" { break; }
        stmtStart := cursor;
        /* Skip metadata / type declarations that produce no runtime statements */
        var prefixKw := "";
        var workPos := cursor;
        if source.at(cursor).isNameStart() {
            kwEnd := source.skipName(cursor);
            kw := source.slice(cursor, kwEnd);
            if kw == "pub" {
                prefixKw = "pub";
                workPos = syntax.skipTrivia(source, kwEnd, prefix);
            }
        }
        var varKw := "";
        var mutKw := "";
        if workPos < limitPos and source.at(workPos).isNameStart() {
            w1End := source.skipName(workPos);
            w1 := source.slice(workPos, w1End);
            if w1 == "var" {
                varKw = "var";
                workPos = syntax.skipTrivia(source, w1End, prefix);
                if workPos < limitPos and source.at(workPos).isNameStart() {
                    w2End := source.skipName(workPos);
                    if source.slice(workPos, w2End) == "mut" {
                        mutKw = "mut";
                        workPos = syntax.skipTrivia(source, w2End, prefix);
                    }
                }
            } else if w1 == "mut" {
                /* Check if declaration `mut name := ...` or `mut expr = ...` */
                afterM := syntax.skipTrivia(source, w1End, prefix);
                if afterM < limitPos and source.at(afterM).isNameStart() {
                    nEnd := source.skipName(afterM);
                    afterN := syntax.skipTrivia(source, nEnd, prefix);
                    if afterN < limitPos and (source.startsWithAt(afterN, ":=") or (source.at(afterN) == ":" and not source.startsWithAt(afterN, ":/") and not source.startsWithAt(afterN, ":%"))) {
                        mutKw = "mut";
                        workPos = afterM;
                    }
                }
            }
        }
        if workPos < limitPos and source.at(workPos).isNameStart() {
            nameStart := workPos;
            nameEnd := source.skipName(nameStart);
            name := source.slice(nameStart, nameEnd);
            afterName := syntax.skipTrivia(source, nameEnd, prefix);

            /* Control keywords */
            if varKw == "" and mutKw == "" and prefixKw == "" {
                if name == "return" {
                    if afterName < limitPos and source.at(afterName) == ";" {
                        return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_RETURN, error = "" };
                    }
                    rv := evalExprAt(source, afterName, limitPos, prefix, expectedKind, mut frame, mut budget);
                    if rv.outcome.flow =!= FLOW_NONE { return rv.outcome; }
                    retEnd := syntax.skipTrivia(source, rv.next, prefix);
                    coercedRet := coerceCtValue(expectedKind, ctPool[rv.outcome.valId].kind, cloneValIfContainer(rv.outcome.valId, "", mut budget), mut budget);
                    if retEnd < limitPos and source.at(retEnd) == ";" {
                        cursor = syntax.skipItemSeparators(source, retEnd + 1, prefix);
                    }
                    return CtOutcome { ok = true, valId = coercedRet, flow = FLOW_RETURN, error = "" };
                }
                if name == "break" or name == "continue" {
                    var scan := afterName;
                    var tagTxt := "";
                    var hasVal := false;
                    var bVal := makeUnitVal(mut budget);
                    if scan < limitPos and source.at(scan) == "@" {
                        ti := syntax.parseTagAt(source, scan, prefix);
                        tagTxt = ti.tag;
                        scan = syntax.skipTrivia(source, ti.next, prefix);
                    }
                    if name == "break" and scan < limitPos and source.at(scan) =!= ";" {
                        br := evalExprAt(source, scan, limitPos, prefix, "", mut frame, mut budget);
                        if br.outcome.flow =!= FLOW_NONE { return br.outcome; }
                        bVal = br.outcome.valId;
                        hasVal = true;
                        scan = syntax.skipTrivia(source, br.next, prefix);
                    }
                    flowTag := if name == "break" { FLOW_BREAK } else { FLOW_CONTINUE };
                    return CtOutcome { ok = true, valId = bVal, flow = flowTag, error = tagTxt };
                }
            }

            /* Function definition / type declaration statement inside block: skip */
            if afterName < limitPos and source.startsWithAt(afterName, ":=") {
                rhsS := syntax.skipTrivia(source, afterName + 2, prefix);
                if rhsS < limitPos and source.at(rhsS).isNameStart() {
                    rw := source.slice(rhsS, source.skipName(rhsS));
                    if rw == "record" or rw == "enum" or rw == "interface" or rw == "alias" or rw == "distinct" {
                        endS := syntax.scanExpressionItemEnd(source, stmtStart, prefix);
                        cursor = syntax.skipItemSeparators(source, endS, prefix);
                        continue;
                    }
                }
            }

            /* Local declaration `name := rhs;` or `name: Type [= rhs];` */
            if name =!= "_" and (source.startsWithAt(afterName, ":=") or (source.at(afterName) == ":" and not source.startsWithAt(afterName, ":/") and not source.startsWithAt(afterName, ":%"))) {
                isMut := varKw =!= "" or mutKw =!= "";
                if source.startsWithAt(afterName, ":=") {
                    rhsStart := syntax.skipTrivia(source, afterName + 2, prefix);
                    rhsRes := evalExprAt(source, rhsStart, limitPos, prefix, "", mut frame, mut budget);
                    if rhsRes.outcome.flow =!= FLOW_NONE { return rhsRes.outcome; }
                    valId := cloneValIfContainer(rhsRes.outcome.valId, "", mut budget);
                    vKind := ctPool[valId].kind;
                    frameSetOrPush(mut frame, name, valId, isMut, vKind);
                    afterStmt := syntax.skipTrivia(source, rhsRes.next, prefix);
                    cursor = syntax.skipItemSeparators(source, if afterStmt < limitPos and source.at(afterStmt) == ";" { afterStmt + 1 } else { afterStmt }, prefix);
                    lastVal = makeUnitVal(mut budget);
                    continue;
                }
                /* `: Type [= init]` */
                tyRes := resolveCtTypeAt(source, afterName + 1, prefix, frame.aliases);
                if not tyRes.ok {
                    return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time type" };
                }
                annKind := tyRes.kind;
                afterTy := syntax.skipTrivia(source, tyRes.next, prefix);
                var valId := -1;
                var nextPos := afterTy;
                if afterTy < limitPos and syntax.isSingleEquals(source, afterTy) {
                    rhsS := syntax.skipTrivia(source, afterTy + 1, prefix);
                    resEnd := syntax.isReservedInitMarker(source, rhsS, prefix);
                    if resEnd >= 0 {
                        valId = makeZeroCtVal(annKind, mut budget, frame.aliases, frame.moduleKey);
                        nextPos = resEnd;
                    } else {
                        rhsRes := evalExprAt(source, rhsS, limitPos, prefix, annKind, mut frame, mut budget);
                        if rhsRes.outcome.flow =!= FLOW_NONE { return rhsRes.outcome; }
                        valId = coerceCtValue(annKind, ctPool[rhsRes.outcome.valId].kind, cloneValIfContainer(rhsRes.outcome.valId, "", mut budget), mut budget);
                        nextPos = rhsRes.next;
                    }
                } else {
                    valId = makeZeroCtVal(annKind, mut budget, frame.aliases, frame.moduleKey);
                }
                frameSetOrPush(mut frame, name, valId, isMut, annKind);
                afterStmt := syntax.skipTrivia(source, nextPos, prefix);
                cursor = syntax.skipItemSeparators(source, if afterStmt < limitPos and source.at(afterStmt) == ";" { afterStmt + 1 } else { afterStmt }, prefix);
                lastVal = makeUnitVal(mut budget);
                continue;
            }
        }

        /* Assignment target or expression statement */
        exprRes := evalStmtExprOrAssign(source, stmtStart, limitPos, prefix, expectedKind, mut frame, mut budget);
        if exprRes.outcome.flow =!= FLOW_NONE { return exprRes.outcome; }
        afterExpr := syntax.skipTrivia(source, exprRes.next, prefix);
        if afterExpr < limitPos and source.at(afterExpr) == ";" {
            cursor = syntax.skipItemSeparators(source, afterExpr + 1, prefix);
            lastVal = makeUnitVal(mut budget);
        } else {
            lastVal = exprRes.outcome.valId;
            cursor = syntax.skipItemSeparators(source, afterExpr, prefix);
        }
    }
    CtOutcome { ok = true, valId = lastVal, flow = FLOW_NONE, error = "" }
};

/** Evaluates a statement which may be an lvalue assignment `(mut) lhs op= rhs` or ordinary expression. */
evalStmtExprOrAssign := fn(source: String, stmtStart: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    /* Try parsing simple assignment: `[mut] name = rhs` or `[mut] name[idx] = rhs` or `[mut] name.field = rhs` or `lhs += rhs` */
    var scan := stmtStart;
    if source.wordAt(scan, "mut") {
        scan = syntax.skipTrivia(source, scan + 3, prefix);
    }
    if scan < limitPos and source.at(scan).isNameStart() {
        nEnd := source.skipName(scan);
        vName := source.slice(scan, nEnd);
        bindIdx := frameFindBinding(frame, vName);
        if bindIdx >= 0 {
            var postPos := syntax.skipTrivia(source, nEnd, prefix);
            var hasIndex := false;
            var idxVal := 0;
            var hasField := false;
            var fldName := "";
            var chainOk := true;
            if postPos < limitPos and source.at(postPos) == "[" {
                idxR := evalExprAt(source, postPos + 1, limitPos, prefix, "", mut frame, mut budget);
                if idxR.outcome.flow =!= FLOW_NONE { return (outcome = idxR.outcome, next = idxR.next); }
                afterIdx := syntax.skipTrivia(source, idxR.next, prefix);
                if afterIdx < limitPos and source.at(afterIdx) == "]" {
                    hasIndex = true;
                    idxVal = ctPool[idxR.outcome.valId].intVal;
                    postPos = syntax.skipTrivia(source, afterIdx + 1, prefix);
                } else { chainOk = false; }
            } else if postPos < limitPos and source.at(postPos) == "." {
                fS := syntax.skipTrivia(source, postPos + 1, prefix);
                if fS < limitPos and source.at(fS).isNameStart() {
                    fE := source.skipName(fS);
                    hasField = true;
                    fldName = source.slice(fS, fE);
                    postPos = syntax.skipTrivia(source, fE, prefix);
                } else { chainOk = false; }
            }
            if chainOk and postPos < limitPos {
                compOp := syntax.compoundAssignOp(source, postPos);
                if compOp.width > 0 or syntax.isSingleEquals(source, postPos) {
                    opW := if compOp.width > 0 { compOp.width } else { 1 };
                    rhsRes := evalExprAt(source, postPos + opW, limitPos, prefix, "", mut frame, mut budget);
                    if rhsRes.outcome.flow =!= FLOW_NONE { return (outcome = rhsRes.outcome, next = rhsRes.next); }
                    b := frame.bindings[bindIdx];
                    curId := b.valId;
                    rhsId := rhsRes.outcome.valId;
                    if not hasIndex and not hasField {
                        newId := if compOp.width > 0 {
                            ap := applyBinaryVal(compOp.baseOp, curId, rhsId, mut budget);
                            if ap.flow =!= FLOW_NONE { return (outcome = ap, next = rhsRes.next); }
                            ap.valId
                        } else {
                            coerceCtValue(b.kind, ctPool[rhsId].kind, cloneValIfContainer(rhsId, "", mut budget), mut budget)
                        };
                        mut frame.bindings.setAt(bindIdx, CtBinding { name = b.name, valId = newId, mutable = b.mutable, kind = b.kind });
                        return (outcome = CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" }, next = rhsRes.next);
                    }
                    if hasIndex {
                        c := ctPool[curId];
                        if idxVal < 0 or idxVal >= c.children.length() {
                            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "index " + idxVal.toText() + " out of bounds" }, next = rhsRes.next);
                        }
                        oldEl := c.children[idxVal];
                        newEl := if compOp.width > 0 {
                            ap := applyBinaryVal(compOp.baseOp, oldEl, rhsId, mut budget);
                            if ap.flow =!= FLOW_NONE { return (outcome = ap, next = rhsRes.next); }
                            ap.valId
                        } else { cloneValIfContainer(rhsId, "", mut budget) };
                        mut newCh: List<Int> = c.children;
                        mut newCh.setAt(idxVal, newEl);
                        mut frame.bindings.setAt(bindIdx, CtBinding {
                            name = b.name,
                            valId = allocCell(CtCell { tag = c.tag, kind = c.kind, intVal = c.intVal, floatVal = c.floatVal, strVal = c.strVal, children = newCh, keys = c.keys }, mut budget),
                            mutable = b.mutable, kind = b.kind
                        });
                        return (outcome = CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" }, next = rhsRes.next);
                    }
                    if hasField {
                        c := ctPool[curId];
                        var fi := 0;
                        var hit := -1;
                        loop fi < c.keys.length() {
                            if c.keys[fi] == fldName { hit = fi; break; }
                            fi = fi + 1;
                        }
                        if hit >= 0 {
                            oldF := c.children[hit];
                            newF := if compOp.width > 0 {
                                ap := applyBinaryVal(compOp.baseOp, oldF, rhsId, mut budget);
                                if ap.flow =!= FLOW_NONE { return (outcome = ap, next = rhsRes.next); }
                                ap.valId
                            } else { cloneValIfContainer(rhsId, "", mut budget) };
                            mut newCh: List<Int> = c.children;
                            mut newCh.setAt(hit, newF);
                            mut frame.bindings.setAt(bindIdx, CtBinding {
                                name = b.name,
                                valId = allocCell(CtCell { tag = c.tag, kind = c.kind, intVal = c.intVal, floatVal = c.floatVal, strVal = c.strVal, children = newCh, keys = c.keys }, mut budget),
                                mutable = b.mutable, kind = b.kind
                            });
                            return (outcome = CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" }, next = rhsRes.next);
                        }
                    }
                }
            }
        }
    }
    evalExprAt(source, scan, limitPos, prefix, expectedKind, mut frame, mut budget)
};

/** Executes a braced block `{ ... }` [including optional trailing `finally { ... }`]. */
evalBracedBlock := fn(source: String, openBrace: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    closeBrace := syntax.scanBraceEnd(source, openBrace, prefix);
    savedLen := frame.bindings.length();
    savedAliases := frame.aliases;
    blkFlags := syntax.scanBlockFastFlags(source, openBrace, prefix);
    if blkFlags.hasAliasKw {
        frame.aliases = types.collectBlockTypeAliases(source, openBrace, prefix, types.maxAliasDepth(savedAliases) + 1, savedAliases);
    }
    res := evalStmtRange(source, openBrace + 1, closeBrace - 1, prefix, expectedKind, mut frame, mut budget);
    frame.aliases = savedAliases;
    loop frame.bindings.length() > savedLen { _popped := mut frame.bindings.popBack(); }
    afterClose := syntax.skipTrivia(source, closeBrace, prefix);
    var endCursor := closeBrace;
    if afterClose < source.length() and source.wordAt(afterClose, "finally") {
        finOpen := syntax.skipTrivia(source, afterClose + 7, prefix);
        if finOpen < source.length() and source.at(finOpen) == "{" {
            finClose := syntax.scanBraceEnd(source, finOpen, prefix);
            endCursor = finClose;
            if res.flow =!= FLOW_PANIC {
                finLen := frame.bindings.length();
                finRes := evalStmtRange(source, finOpen + 1, finClose - 1, prefix, "", mut frame, mut budget);
                loop frame.bindings.length() > finLen { _pop2 := mut frame.bindings.popBack(); }
                if finRes.flow == FLOW_PANIC {
                    return (outcome = finRes, next = finClose);
                }
            }
        }
    }
    (outcome = res, next = endCursor)
};

/** Evaluates one call to a resolved `CtFnDef` or generic template with explicit/inferred type arguments. */
invokeCtFnDefWithTypeArgs := fn(defIdx: Int, explicitTypeArgs: List<String>, args: List<Int>, namedLabels: List<String>, budget: mut EvalBudget): CtOutcome {
    if defIdx < 0 or defIdx >= ctFnDefs.length() {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown compile-time function" };
    }
    def := ctFnDefs[defIdx];
    if def.isHostBuiltin {
        return evalHostBuiltinCall(def.moduleIdentity, def.name, args, mut budget);
    }
    if budget.depth >= budget.maxDepth {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "compile-time recursion exceeded depth limit (" + budget.maxDepth.toText() + ")" };
    }
    var mut fnAliases: List<AliasDecl> = def.aliases;
    var effParamsEncoded := def.paramsEncoded;
    var effResultKind := def.resultKind;
    mut extraBindings: List<CtBinding> = [];
    if def.runtime.startsWithAt(0, "$gen:") {
        tplKey := def.runtime.slice(5, def.runtime.length());
        tIdx := generics.findTemplate(tplKey);
        if tIdx >= 0 {
            tpl := generics.getTemplate(tIdx);
            pSpecs := generics.splitGenericParams(tpl.genericParams);
            mut bindMap: Map<String, String>;
            var ti := 0;
            loop ti < pSpecs.length() and ti < explicitTypeArgs.length() {
                colP := pSpecs[ti].indexOf(":", 0);
                gpName := if colP >= 0 { pSpecs[ti].slice(0, colP).trim() } else { pSpecs[ti].trim() };
                mut bindMap.set(gpName, explicitTypeArgs[ti]);
                ti = ti + 1;
            }
            if bindMap.size() < pSpecs.length() {
                pEntries := splitPipeEntriesLocal(def.paramsEncoded, def.paramCount);
                posCnt := args.length() - namedLabels.length();
                var ai := 0;
                loop ai < pEntries.length() and ai < posCnt {
                    peUn := splitPipeEntry(pEntries[ai]);
                    if peUn.kind =!= "" and args[ai] >= 0 and args[ai] < ctPool.length() {
                        _u := generics.unifyKindMut(tpl.genericParams, peUn.kind, ctPool[args[ai]].kind, mut bindMap);
                    }
                    ai = ai + 1;
                }
            }
            var piSpec := 0;
            loop piSpec < pSpecs.length() {
                colP := pSpecs[piSpec].indexOf(":", 0);
                gpName := if colP >= 0 { pSpecs[piSpec].slice(0, colP).trim() } else { pSpecs[piSpec].trim() };
                bGot := bindMap.get(gpName);
                if bGot.found {
                    argK := bGot.value;
                    if types.isComptimeValueToken(argK) {
                        mut fnAliases.pushBack((name = gpName, target = "$Val:" + argK, at = -1, end = 0, depth = 0));
                        vk := types.comptimeValueTokenKind(argK);
                        cVid := if vk == ir.VALUE_KIND_INT { makeIntVal(types.comptimeIntValue(argK), vk, mut budget) }
                        else if vk == ir.VALUE_KIND_BOOL { makeBoolVal(types.comptimeBoolValue(argK), vk, mut budget) }
                        else if vk == ir.VALUE_KIND_STRING { makeStrVal(types.comptimeStringValue(argK), vk, mut budget) }
                        else { makeEnumVal(vk, types.comptimeEnumCaseIndex(argK), "", [], mut budget) };
                        mut extraBindings.pushBack(CtBinding { name = gpName, valId = cVid, mutable = false, kind = vk });
                    } else {
                        mut fnAliases.pushBack((name = gpName, target = "$Kind:" + argK, at = -1, end = 0, depth = 0));
                    }
                }
                piSpec = piSpec + 1;
            }
            if tpl.selfTarget =!= "" {
                effSelf := if tpl.selfTarget.startsWithAt(0, "$Kind:") {
                    "$Kind:" + generics.substKind(tpl.genericParams, tpl.selfTarget.slice(6, tpl.selfTarget.length()), bindMap)
                } else {
                    tpl.selfTarget
                };
                mut fnAliases.pushBack((name = "Self", target = effSelf, at = -1, end = 0, depth = 0));
            }
            effParamsEncoded = generics.substKind(tpl.genericParams, def.paramsEncoded, bindMap);
            effResultKind = generics.substKind(tpl.genericParams, def.resultKind, bindMap);
        }
    } else {
        dotP := def.name.indexOf(".", 0);
        if dotP > 0 {
            ownerName := def.name.slice(0, dotP);
            oIdx := types.findAlias(fnAliases, ownerName);
            if oIdx >= 0 {
                mut fnAliases.pushBack((name = "Self", target = fnAliases[oIdx].target, at = -1, end = 0, depth = 0));
            }
        }
    }
    if def.bodyStart > 0 and def.bodyStart <= def.source.length() and def.source.at(def.bodyStart - 1) == "{" {
        blkFlags := syntax.scanBlockFastFlags(def.source, def.bodyStart - 1, def.prefix);
        if blkFlags.hasAliasKw {
            fnAliases = types.collectBlockTypeAliases(def.source, def.bodyStart - 1, def.prefix, types.maxAliasDepth(fnAliases) + 1, fnAliases);
        }
    }
    mut fnFrame := CtFrame {
        bindings = extraBindings, fnResultKind = effResultKind, moduleKey = def.moduleKey,
        aliases = fnAliases, loopCount = 0, loopIndex = 0, loopItemId = -1, hasLoopItem = false, activeTag = ""
    };
    entries := splitPipeEntriesLocal(effParamsEncoded, def.paramCount);
    posCount := args.length() - namedLabels.length();
    var pi := 0;
    loop pi < entries.length() {
        pe := splitPipeEntry(entries[pi]);
        var argId := -1;
        if pi < posCount {
            argId = args[pi];
        } else {
            var ni := 0;
            loop ni < namedLabels.length() {
                if namedLabels[ni] == pe.name {
                    argId = args[posCount + ni];
                    break;
                }
                ni = ni + 1;
            }
        }
        if argId >= 0 {
            boundVal := coerceCtValue(pe.kind, ctPool[argId].kind, cloneValIfContainer(argId, "", mut budget), mut budget);
            mut fnFrame.bindings.pushBack(CtBinding { name = pe.name, valId = boundVal, mutable = pe.isMut, kind = ctPool[boundVal].kind });
        }
        pi = pi + 1;
    }
    budget.depth = budget.depth + 1;
    bodyRes := evalStmtRange(def.source, def.bodyStart, def.bodyEnd, def.prefix, effResultKind, mut fnFrame, mut budget);
    budget.depth = budget.depth - 1;
    if bodyRes.flow == FLOW_RETURN {
        return CtOutcome { ok = true, valId = coerceCtValue(effResultKind, ctPool[bodyRes.valId].kind, bodyRes.valId, mut budget), flow = FLOW_NONE, error = "" };
    }
    if bodyRes.flow == FLOW_PROP_ERR {
        return CtOutcome { ok = true, valId = bodyRes.valId, flow = FLOW_NONE, error = "" };
    }
    if bodyRes.flow =!= FLOW_NONE {
        return bodyRes;
    }
    if effResultKind =!= "" {
        return CtOutcome { ok = true, valId = coerceCtValue(effResultKind, ctPool[bodyRes.valId].kind, bodyRes.valId, mut budget), flow = FLOW_NONE, error = "" };
    }
    bodyRes
};

/** Evaluates one call to a resolved `CtFnDef` or runtime name, passing prepared argument value ids. */
invokeCtFnDef := fn(defIdx: Int, args: List<Int>, namedLabels: List<String>, budget: mut EvalBudget): CtOutcome {
    invokeCtFnDefWithTypeArgs(defIdx, [], args, namedLabels, mut budget)
};

/** Evaluates parenthesized call argument list `(arg1, label = arg2, =shorthand)` starting at `openParen`. */
evalCallArgs := fn(source: String, openParen: Int, prefix: String, frame: mut CtFrame, budget: mut EvalBudget): CtCallArgs {
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    mut args: List<Int> = [];
    mut labels: List<String> = [];
    var sawNamed := false;
    loop cursor < source.length() {
        if source.at(cursor) == ")" {
            return CtCallArgs { ok = true, outcome = CtOutcome { ok = true, valId = -1, flow = FLOW_NONE, error = "" }, args = args, labels = labels, next = cursor + 1 };
        }
        if syntax.isSingleEquals(source, cursor) {
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            shEnd := source.skipName(shStart);
            shName := source.slice(shStart, shEnd);
            valR := evalExprAt(source, shStart, source.length(), prefix, "", mut frame, mut budget);
            if valR.outcome.flow =!= FLOW_NONE {
                return CtCallArgs { ok = false, outcome = valR.outcome, args = args, labels = labels, next = valR.next };
            }
            mut args.pushBack(valR.outcome.valId);
            mut labels.pushBack(shName);
            sawNamed = true;
            cursor = syntax.skipTrivia(source, valR.next, prefix);
        } else if source.at(cursor).isNameStart() {
            if source.wordAt(cursor, "mut") {
                cursor = syntax.skipTrivia(source, cursor + 3, prefix);
                valR := evalExprAt(source, cursor, source.length(), prefix, "", mut frame, mut budget);
                if valR.outcome.flow =!= FLOW_NONE {
                    return CtCallArgs { ok = false, outcome = valR.outcome, args = args, labels = labels, next = valR.next };
                }
                mut args.pushBack(valR.outcome.valId);
                if sawNamed { mut labels.pushBack(""); }
                cursor = syntax.skipTrivia(source, valR.next, prefix);
            } else {
                nEnd := source.skipName(cursor);
                afterN := syntax.skipTrivia(source, nEnd, prefix);
                if afterN < source.length() and syntax.isSingleEquals(source, afterN) {
                    lblName := source.slice(cursor, nEnd);
                    valStart := syntax.skipTrivia(source, afterN + 1, prefix);
                    valR := evalExprAt(source, valStart, source.length(), prefix, "", mut frame, mut budget);
                    if valR.outcome.flow =!= FLOW_NONE {
                        return CtCallArgs { ok = false, outcome = valR.outcome, args = args, labels = labels, next = valR.next };
                    }
                    mut args.pushBack(valR.outcome.valId);
                    mut labels.pushBack(lblName);
                    sawNamed = true;
                    cursor = syntax.skipTrivia(source, valR.next, prefix);
                } else {
                    valR := evalExprAt(source, cursor, source.length(), prefix, "", mut frame, mut budget);
                    if valR.outcome.flow =!= FLOW_NONE {
                        return CtCallArgs { ok = false, outcome = valR.outcome, args = args, labels = labels, next = valR.next };
                    }
                    mut args.pushBack(valR.outcome.valId);
                    if sawNamed { mut labels.pushBack(""); }
                    cursor = syntax.skipTrivia(source, valR.next, prefix);
                }
            }
        } else {
            valR := evalExprAt(source, cursor, source.length(), prefix, "", mut frame, mut budget);
            if valR.outcome.flow =!= FLOW_NONE {
                return CtCallArgs { ok = false, outcome = valR.outcome, args = args, labels = labels, next = valR.next };
            }
            mut args.pushBack(valR.outcome.valId);
            if sawNamed { mut labels.pushBack(""); }
            cursor = syntax.skipTrivia(source, valR.next, prefix);
        }
        if cursor < source.length() and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if cursor < source.length() and source.at(cursor) == ")" {
        return CtCallArgs { ok = true, outcome = CtOutcome { ok = true, valId = -1, flow = FLOW_NONE, error = "" }, args = args, labels = labels, next = cursor + 1 };
    }
    CtCallArgs { ok = false, outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "expected ) in compile-time call" }, args = args, labels = labels, next = cursor }
};

/** Attempts to match one pattern against `subjValId`, binding any pattern variables into `frame` when matched. */
tryMatchCtPattern := fn(source: String, patStart: Int, limitPos: Int, prefix: String, subjValId: Int, frame: mut CtFrame, budget: mut EvalBudget): (matched: Bool, next: Int) {
    var cursor := syntax.skipTrivia(source, patStart, prefix);
    if cursor >= limitPos { return (matched = false, next = cursor); }
    subCell := ctPool[subjValId];
    loop true {
        curMatched := if source.at(cursor) == "_" and (cursor + 1 >= limitPos or not source.at(cursor + 1).isNameContinue()) {
            (matched = true, next = cursor + 1)
        } else if source.at(cursor) == ":" {
            /* Binding-free `: Type` union pattern */
            tyR := resolveCtTypeAt(source, cursor + 1, prefix, frame.aliases);
            if tyR.ok {
                (matched = valueMatchesType(subjValId, tyR.kind), next = tyR.next)
            } else {
                (matched = false, next = cursor + 1)
            }
        } else if source.at(cursor) == "." {
            cStart := syntax.skipTrivia(source, cursor + 1, prefix);
            cEnd := source.skipName(cStart);
            cName := source.slice(cStart, cEnd);
            afterC := syntax.skipTrivia(source, cEnd, prefix);
            var ok := false;
            var mut payloadIds: List<Int> = [];
            if subCell.tag == TAG_RESULT {
                if cName == "ok" and subCell.intVal == 0 {
                    ok = true;
                    if subCell.children.length() > 0 { mut payloadIds.pushBack(subCell.children[0]); }
                } else if cName == "err" and subCell.intVal =!= 0 {
                    ok = true;
                    if subCell.children.length() > 0 { mut payloadIds.pushBack(subCell.children[0]); }
                }
            } else if subCell.tag == TAG_ENUM and subCell.strVal == cName {
                ok = true;
                payloadIds = subCell.children;
            }
            if afterC < limitPos and source.at(afterC) == "(" {
                var pCur := syntax.skipTrivia(source, afterC + 1, prefix);
                var pIdx := 0;
                loop pCur < limitPos and source.at(pCur) =!= ")" {
                    if ok and pIdx < payloadIds.length() {
                        subPat := self(source, pCur, limitPos, prefix, payloadIds[pIdx], mut frame, mut budget);
                        if not subPat.matched { ok = false; }
                        pCur = syntax.skipTrivia(source, subPat.next, prefix);
                    } else {
                        pCur = syntax.skipBalancedArgument(source, pCur, prefix);
                        ok = false;
                    }
                    pIdx = pIdx + 1;
                    if pCur < limitPos and source.at(pCur) == "," { pCur = syntax.skipTrivia(source, pCur + 1, prefix); }
                    else { break; }
                }
                if pCur < limitPos and source.at(pCur) == ")" { pCur = pCur + 1; }
                (matched = ok, next = pCur)
            } else {
                (matched = ok, next = cEnd)
            }
        } else if source.at(cursor) == "\"" or source.at(cursor).isDigit() or source.at(cursor) == "-" {
            litR := evalExprAt(source, cursor, limitPos, prefix, "", mut frame, mut budget);
            eq := if litR.outcome.flow == FLOW_NONE { ctValuesEqual(subjValId, litR.outcome.valId) } else { false };
            (matched = eq, next = litR.next)
        } else if source.wordAt(cursor, "true") or source.wordAt(cursor, "false") {
            bEnd := source.skipName(cursor);
            bVal := source.slice(cursor, bEnd) == "true";
            eq := subCell.tag == TAG_BOOL and (subCell.intVal =!= 0) == bVal;
            (matched = eq, next = bEnd)
        } else if source.at(cursor) == "(" {
            var tCur := syntax.skipTrivia(source, cursor + 1, prefix);
            var tIdx := 0;
            var tOk := subCell.tag == TAG_TUPLE;
            loop tCur < limitPos and source.at(tCur) =!= ")" {
                if tOk and tIdx < subCell.children.length() {
                    sp := self(source, tCur, limitPos, prefix, subCell.children[tIdx], mut frame, mut budget);
                    if not sp.matched { tOk = false; }
                    tCur = syntax.skipTrivia(source, sp.next, prefix);
                } else {
                    tCur = syntax.skipBalancedArgument(source, tCur, prefix);
                    tOk = false;
                }
                tIdx = tIdx + 1;
                if tCur < limitPos and source.at(tCur) == "," { tCur = syntax.skipTrivia(source, tCur + 1, prefix); }
                else { break; }
            }
            if tCur < limitPos and source.at(tCur) == ")" { tCur = tCur + 1; }
            (matched = tOk, next = tCur)
        } else if source.at(cursor).isNameStart() {
            nEnd := source.skipName(cursor);
            pName := source.slice(cursor, nEnd);
            afterN := syntax.skipTrivia(source, nEnd, prefix);
            if afterN < limitPos and source.at(afterN) == ":" and not source.startsWithAt(afterN, ":=") {
                /* `name: Type` union pattern */
                tyR := resolveCtTypeAt(source, afterN + 1, prefix, frame.aliases);
                if tyR.ok and valueMatchesType(subjValId, tyR.kind) {
                    unw := if subCell.tag == TAG_UNION and subCell.children.length() > 0 { subCell.children[0] } else { subjValId };
                    frameSetOrPush(mut frame, pName, unw, false, ctPool[unw].kind);
                    (matched = true, next = tyR.next)
                } else {
                    (matched = false, next = if tyR.ok { tyR.next } else { nEnd })
                }
            } else if afterN < limitPos and source.at(afterN) == "." {
                /* Enum.Case or Enum.Case(p) */
                cS := syntax.skipTrivia(source, afterN + 1, prefix);
                cE := source.skipName(cS);
                cName := source.slice(cS, cE);
                afterC := syntax.skipTrivia(source, cE, prefix);
                var ok := subCell.tag == TAG_ENUM and subCell.strVal == cName;
                if afterC < limitPos and source.at(afterC) == "(" {
                    var pCur := syntax.skipTrivia(source, afterC + 1, prefix);
                    var pIdx := 0;
                    loop pCur < limitPos and source.at(pCur) =!= ")" {
                        if ok and pIdx < subCell.children.length() {
                            sp := self(source, pCur, limitPos, prefix, subCell.children[pIdx], mut frame, mut budget);
                            if not sp.matched { ok = false; }
                            pCur = syntax.skipTrivia(source, sp.next, prefix);
                        } else {
                            pCur = syntax.skipBalancedArgument(source, pCur, prefix);
                            ok = false;
                        }
                        pIdx = pIdx + 1;
                        if pCur < limitPos and source.at(pCur) == "," { pCur = syntax.skipTrivia(source, pCur + 1, prefix); }
                        else { break; }
                    }
                    if pCur < limitPos and source.at(pCur) == ")" { pCur = pCur + 1; }
                    (matched = ok, next = pCur)
                } else {
                    (matched = ok, next = cE)
                }
            } else {
                frameSetOrPush(mut frame, pName, subjValId, false, subCell.kind);
                (matched = true, next = nEnd)
            }
        } else {
            (matched = false, next = cursor + 1)
        };
        if curMatched.matched { return curMatched; }
        afterP := syntax.skipTrivia(source, curMatched.next, prefix);
        if afterP < limitPos and source.wordAt(afterP, "or") {
            cursor = syntax.skipTrivia(source, afterP + 2, prefix);
            continue;
        }
        return curMatched;
    }
    (matched = false, next = cursor)
};

/** Evaluates `if` / `else if` / `else` chains (including `if pat := source` and `and` guards). */
evalIfExpr := fn(source: String, ifStart: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    var cursor := syntax.skipTrivia(source, ifStart + 2, prefix);
    var endPos := ifStart;
    var taken := false;
    var resultOutcome := CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
    loop true {
        openBrace := syntax.scanIfHeaderOpen(source, cursor, prefix);
        if openBrace >= limitPos or source.at(openBrace) =!= "{" {
            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "expected { after if condition" }, next = cursor);
        }
        closeBrace := syntax.scanBraceEnd(source, openBrace, prefix);
        endPos = closeBrace;
        if not taken {
            condEnd := syntax.skipTrivia(source, openBrace, prefix);
            savedLen := frame.bindings.length();
            var condTrue := true;
            var segPos := cursor;
            loop segPos < openBrace {
                andPos := syntax.scanIfCondAndSplit(source, segPos, openBrace, prefix);
                segLimit := if andPos >= 0 { andPos } else { openBrace };
                bindOp := syntax.scanIfCondBindOp(source, segPos, segLimit, prefix);
                if bindOp >= 0 {
                    rhsStart := syntax.skipTrivia(source, bindOp + 2, prefix);
                    srcR := evalExprAt(source, rhsStart, segLimit, prefix, "", mut frame, mut budget);
                    if srcR.outcome.flow =!= FLOW_NONE {
                        loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                        return (outcome = srcR.outcome, next = closeBrace);
                    }
                    patR := tryMatchCtPattern(source, segPos, bindOp, prefix, srcR.outcome.valId, mut frame, mut budget);
                    if not patR.matched { condTrue = false; break; }
                } else {
                    condR := evalExprAt(source, segPos, segLimit, prefix, ir.VALUE_KIND_BOOL, mut frame, mut budget);
                    if condR.outcome.flow =!= FLOW_NONE {
                        loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                        return (outcome = condR.outcome, next = closeBrace);
                    }
                    if ctPool[condR.outcome.valId].intVal == 0 { condTrue = false; break; }
                }
                if andPos < 0 { break; }
                segPos = syntax.skipTrivia(source, andPos + 3, prefix);
            }
            if condTrue {
                taken = true;
                brR := evalBracedBlock(source, openBrace, prefix, expectedKind, mut frame, mut budget);
                resultOutcome = brR.outcome;
                endPos = brR.next;
                loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                if resultOutcome.flow =!= FLOW_NONE { return (outcome = resultOutcome, next = syntax.scanIfChainEnd(source, ifStart, prefix, false, true)); }
            } else {
                loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
            }
        }
        afterB := syntax.skipTrivia(source, endPos, prefix);
        if afterB < source.length() and source.wordAt(afterB, "else") {
            afterElse := syntax.skipTrivia(source, afterB + 4, prefix);
            if afterElse < source.length() and source.wordAt(afterElse, "if") {
                cursor = syntax.skipTrivia(source, afterElse + 2, prefix);
                continue;
            }
            if afterElse < source.length() and source.at(afterElse) == "{" {
                if not taken {
                    taken = true;
                    brR := evalBracedBlock(source, afterElse, prefix, expectedKind, mut frame, mut budget);
                    resultOutcome = brR.outcome;
                    endPos = brR.next;
                } else {
                    endPos = syntax.scanBraceEnd(source, afterElse, prefix);
                    afterFin := syntax.skipTrivia(source, endPos, prefix);
                    if afterFin < source.length() and source.wordAt(afterFin, "finally") {
                        fOpen := syntax.skipTrivia(source, afterFin + 7, prefix);
                        if fOpen < source.length() and source.at(fOpen) == "{" {
                            endPos = syntax.scanBraceEnd(source, fOpen, prefix);
                        }
                    }
                }
            }
        }
        break;
    }
    (outcome = resultOutcome, next = endPos)
};

/** Evaluates subject-based or subjectless `match` expressions/statements. */
evalMatchExpr := fn(source: String, matchStart: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    scan := syntax.scanMatchOpen(source, matchStart, prefix);
    var subjId := -1;
    if scan.isSubject {
        subR := evalExprAt(source, syntax.skipTrivia(source, matchStart + 5, prefix), scan.openPos, prefix, "", mut frame, mut budget);
        if subR.outcome.flow =!= FLOW_NONE { return (outcome = subR.outcome, next = syntax.scanBraceEnd(source, scan.openPos, prefix)); }
        subjId = subR.outcome.valId;
    }
    closeBrace := syntax.scanBraceEnd(source, scan.openPos, prefix);
    var cursor := syntax.skipTrivia(source, scan.openPos + 1, prefix);
    var resOutcome := CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
    var matchedArm := false;
    loop cursor < closeBrace - 1 {
        if source.at(cursor) == "}" { break; }
        bodyOpen := syntax.scanMatchArmBodyOpen(source, cursor, prefix);
        if bodyOpen >= closeBrace or source.at(bodyOpen) =!= "{" { break; }
        armClose := syntax.scanBraceEnd(source, bodyOpen, prefix);
        if not matchedArm {
            savedLen := frame.bindings.length();
            var armOk := false;
            if scan.isSubject {
                pRes := tryMatchCtPattern(source, cursor, bodyOpen, prefix, subjId, mut frame, mut budget);
                armOk = pRes.matched;
                if armOk {
                    afterP := syntax.skipTrivia(source, pRes.next, prefix);
                    if afterP < bodyOpen and source.wordAt(afterP, "and") {
                        gRes := evalExprAt(source, afterP + 3, bodyOpen, prefix, ir.VALUE_KIND_BOOL, mut frame, mut budget);
                        if gRes.outcome.flow =!= FLOW_NONE {
                            loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                            return (outcome = gRes.outcome, next = closeBrace);
                        }
                        armOk = ctPool[gRes.outcome.valId].intVal =!= 0;
                    }
                }
            } else {
                if source.at(cursor) == "_" and (cursor + 1 >= bodyOpen or not source.at(cursor + 1).isNameContinue()) {
                    armOk = true;
                } else {
                    gRes := evalExprAt(source, cursor, bodyOpen, prefix, ir.VALUE_KIND_BOOL, mut frame, mut budget);
                    if gRes.outcome.flow =!= FLOW_NONE {
                        loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                        return (outcome = gRes.outcome, next = closeBrace);
                    }
                    armOk = ctPool[gRes.outcome.valId].intVal =!= 0;
                }
            }
            if armOk {
                matchedArm = true;
                brR := evalBracedBlock(source, bodyOpen, prefix, expectedKind, mut frame, mut budget);
                resOutcome = brR.outcome;
            }
            loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
            if matchedArm { break; }
        }
        cursor = syntax.skipTrivia(source, armClose, prefix);
    }
    (outcome = resOutcome, next = closeBrace)
};

/** Evaluates a `loop` construct (condition, iterable `as item` / `mut src as item`, count, `.item`/`.index`/`.count`, `then`, `break`/`continue`). */
evalLoopExpr := fn(source: String, loopStart: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    var cur := syntax.skipTrivia(source, loopStart + 4, prefix);
    if cur >= limitPos {
        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "invalid loop" }, next = cur);
    }
    var hdrIsMut := false;
    if source.wordAt(cur, "mut") {
        hdrIsMut = true;
        cur = syntax.skipTrivia(source, cur + 3, prefix);
    }
    openBrace := syntax.scanConditionOpen(source, cur, prefix);
    closeBrace := syntax.scanBraceEnd(source, openBrace, prefix);

    /* Check for `as name` before `{` */
    var asPos := -1;
    var scanAs := cur;
    loop scanAs < openBrace {
        if source.wordAt(scanAs, "as") { asPos = scanAs; break; }
        if source.at(scanAs) == "\"" { scanAs = syntax.skipAliasString(source, scanAs); }
        else { scanAs = scanAs + 1; }
    }
    hdrEnd := if asPos >= 0 { asPos } else { openBrace };
    var itemVarName := "";
    if asPos >= 0 {
        iS := syntax.skipTrivia(source, asPos + 2, prefix);
        iE := source.skipName(iS);
        itemVarName = source.slice(iS, iE);
    }

    var isIterLoop := asPos >= 0;
    var isRangeLoop := false;
    var rangeStart := 0;
    var rangeEnd := 0;
    var colValId := -1;
    rangeOp := findTopLevelRangeOp(source, cur, hdrEnd, prefix);
    if rangeOp.found {
        loR := evalExprAt(source, cur, rangeOp.pos, prefix, ir.VALUE_KIND_INT, mut frame, mut budget);
        if loR.outcome.flow =!= FLOW_NONE { return (outcome = loR.outcome, next = closeBrace); }
        hiR := evalExprAt(source, rangeOp.pos + rangeOp.width, hdrEnd, prefix, ir.VALUE_KIND_INT, mut frame, mut budget);
        if hiR.outcome.flow =!= FLOW_NONE { return (outcome = hiR.outcome, next = closeBrace); }
        isIterLoop = true;
        isRangeLoop = true;
        rangeStart = ctPool[loR.outcome.valId].intVal;
        rangeEnd = ctPool[hiR.outcome.valId].intVal + (if rangeOp.inclusive { 1 } else { 0 });
    } else if not isIterLoop {
        /* Also test whether header evaluates to Int (count loop) or List/Array/String/Set */
        probeR := evalExprAt(source, cur, hdrEnd, prefix, "", mut frame, mut budget);
        if probeR.outcome.flow =!= FLOW_NONE { return (outcome = probeR.outcome, next = closeBrace); }
        pc := ctPool[probeR.outcome.valId];
        if pc.tag == TAG_BOOL {
            isIterLoop = false;
        } else if pc.tag == TAG_INT or pc.tag == TAG_LIST or pc.tag == TAG_ARRAY or pc.tag == TAG_SET {
            isIterLoop = true;
            colValId = probeR.outcome.valId;
        }
    } else {
        srcR := evalExprAt(source, cur, hdrEnd, prefix, "", mut frame, mut budget);
        if srcR.outcome.flow =!= FLOW_NONE { return (outcome = srcR.outcome, next = closeBrace); }
        colValId = srcR.outcome.valId;
    }

    savedLoopCount := frame.loopCount;
    savedLoopIndex := frame.loopIndex;
    savedLoopItem := frame.loopItemId;
    savedHasItem := frame.hasLoopItem;
    var loopResult := makeUnitVal(mut budget);
    var breakExit := false;

    if isIterLoop {
        colCell := if colValId >= 0 { ctPool[colValId] } else { CtCell { tag = TAG_INT, kind = ir.VALUE_KIND_INT, intVal = 0, floatVal = 0.0, strVal = "", children = [], keys = [] } };
        totalLen := if isRangeLoop {
            if rangeEnd > rangeStart { rangeEnd - rangeStart } else { 0 }
        } else if colCell.tag == TAG_INT {
            colCell.intVal
        } else {
            colCell.children.length()
        };
        frame.loopCount = totalLen;
        var idx := 0;
        loop idx < totalLen {
            tStep := tickStep(mut budget);
            if not tStep.ok { return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = tStep.msg }, next = closeBrace); }
            elemId := if isRangeLoop {
                makeIntVal(rangeStart + idx, "", mut budget)
            } else if colCell.tag == TAG_INT {
                makeIntVal(idx, "", mut budget)
            } else {
                colCell.children[idx]
            };
            frame.loopIndex = idx;
            frame.loopItemId = elemId;
            frame.hasLoopItem = true;
            savedLen := frame.bindings.length();
            if itemVarName =!= "" {
                mut frame.bindings.pushBack(CtBinding { name = itemVarName, valId = elemId, mutable = hdrIsMut, kind = ctPool[elemId].kind });
            }
            brR := evalStmtRange(source, openBrace + 1, closeBrace - 1, prefix, "", mut frame, mut budget);
            /* If writable loop updated `itemVarName` or `.item`, write back if possible */
            if hdrIsMut and itemVarName =!= "" {
                bIdx := frameFindBinding(frame, itemVarName);
                if bIdx >= 0 and frame.bindings[bIdx].valId =!= elemId {
                    mut newCh: List<Int> = colCell.children;
                    mut newCh.setAt(idx, frame.bindings[bIdx].valId);
                    mut ctPool.setAt(colValId, CtCell { tag = colCell.tag, kind = colCell.kind, intVal = colCell.intVal, floatVal = colCell.floatVal, strVal = colCell.strVal, children = newCh, keys = colCell.keys });
                    frame.loopItemId = frame.bindings[bIdx].valId;
                }
            }
            loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
            if brR.flow == FLOW_BREAK {
                breakExit = true;
                loopResult = brR.valId;
                break;
            }
            if brR.flow == FLOW_RETURN or brR.flow == FLOW_PANIC or brR.flow == FLOW_PROP_ERR {
                frame.loopCount = savedLoopCount;
                frame.loopIndex = savedLoopIndex;
                frame.loopItemId = savedLoopItem;
                frame.hasLoopItem = savedHasItem;
                return (outcome = brR, next = closeBrace);
            }
            idx = idx + 1;
        }
    } else {
        var iterCount := 0;
        loop true {
            tStep := tickStep(mut budget);
            if not tStep.ok { return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = tStep.msg }, next = closeBrace); }
            condR := evalExprAt(source, cur, hdrEnd, prefix, ir.VALUE_KIND_BOOL, mut frame, mut budget);
            if condR.outcome.flow =!= FLOW_NONE { return (outcome = condR.outcome, next = closeBrace); }
            if ctPool[condR.outcome.valId].intVal == 0 { break; }
            frame.loopIndex = iterCount;
            brR := evalBracedBlock(source, openBrace, prefix, "", mut frame, mut budget);
            if brR.outcome.flow == FLOW_BREAK {
                breakExit = true;
                loopResult = brR.outcome.valId;
                break;
            }
            if brR.outcome.flow == FLOW_RETURN or brR.outcome.flow == FLOW_PANIC or brR.outcome.flow == FLOW_PROP_ERR {
                frame.loopCount = savedLoopCount;
                frame.loopIndex = savedLoopIndex;
                frame.loopItemId = savedLoopItem;
                frame.hasLoopItem = savedHasItem;
                return (outcome = brR.outcome, next = closeBrace);
            }
            iterCount = iterCount + 1;
        }
    }

    var endPos := closeBrace;
    afterLoop := syntax.skipTrivia(source, closeBrace, prefix);
    if afterLoop < source.length() and source.wordAt(afterLoop, "then") {
        thenOpen := syntax.skipTrivia(source, afterLoop + 4, prefix);
        if thenOpen < source.length() and source.at(thenOpen) == "{" {
            thenClose := syntax.scanBraceEnd(source, thenOpen, prefix);
            endPos = thenClose;
            if not breakExit {
                thR := evalBracedBlock(source, thenOpen, prefix, expectedKind, mut frame, mut budget);
                if thR.outcome.flow =!= FLOW_NONE {
                    frame.loopCount = savedLoopCount;
                    frame.loopIndex = savedLoopIndex;
                    frame.loopItemId = savedLoopItem;
                    frame.hasLoopItem = savedHasItem;
                    return (outcome = thR.outcome, next = thenClose);
                }
                loopResult = thR.outcome.valId;
            }
        }
    }
    frame.loopCount = savedLoopCount;
    frame.loopIndex = savedLoopIndex;
    frame.loopItemId = savedLoopItem;
    frame.hasLoopItem = savedHasItem;
    (outcome = CtOutcome { ok = true, valId = loopResult, flow = FLOW_NONE, error = "" }, next = endPos)
};

/** Dispatches method call `recvValId.methodName(args)` on built-in primitive/collection types, records, or `impl`s. */
evalMethodCall := fn(source: String, methodName: String, recvId: Int, recvName: String, args: List<Int>, labels: List<String>, frame: mut CtFrame, budget: mut EvalBudget): CtOutcome {
    recv := ctPool[recvId];
    if recv.tag == TAG_STR {
        if methodName == "length" { return CtOutcome { ok = true, valId = makeIntVal(recv.strVal.length(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "at" and args.length() >= 1 {
            idx := ctPool[args[0]].intVal;
            if idx < 0 or idx >= recv.strVal.length() {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "String.at index out of bounds" };
            }
            return CtOutcome { ok = true, valId = makeStrVal(recv.strVal.at(idx), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "slice" and args.length() >= 2 {
            a := ctPool[args[0]].intVal;
            b := ctPool[args[1]].intVal;
            if a < 0 or b < a or b > recv.strVal.length() {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "String.slice out of bounds" };
            }
            return CtOutcome { ok = true, valId = makeStrVal(recv.strVal.slice(a, b), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "trim" { return CtOutcome { ok = true, valId = makeStrVal(recv.strVal.trim(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "toInt" {
            r := recv.strVal.toInt();
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<value:Int,ok:Bool>", [makeIntVal(r.value, "", mut budget), makeBoolVal(r.ok, "", mut budget)], ["value", "ok"], mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "indexOf" and args.length() >= 2 {
            return CtOutcome { ok = true, valId = makeIntVal(recv.strVal.indexOf(formatCtVal(args[0]), ctPool[args[1]].intVal), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "startsWithAt" and args.length() >= 2 {
            return CtOutcome { ok = true, valId = makeBoolVal(recv.strVal.startsWithAt(ctPool[args[0]].intVal, formatCtVal(args[1])), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "endsWith" and args.length() >= 1 {
            return CtOutcome { ok = true, valId = makeBoolVal(recv.strVal.endsWith(formatCtVal(args[0])), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "split" and args.length() >= 1 {
            parts := recv.strVal.split(formatCtVal(args[0]));
            mut ids: List<Int> = [];
            loop parts as p { mut ids.pushBack(makeStrVal(p, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<String>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "toCodePoints" {
            cps := recv.strVal.toCodePoints();
            mut ids: List<Int> = [];
            loop cps as cp { mut ids.pushBack(makeIntVal(cp, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "utf8Encode" {
            bs := recv.strVal.utf8Encode();
            mut ids: List<Int> = [];
            loop bs as b { mut ids.pushBack(makeIntVal(b, "", mut budget)); }
            return CtOutcome { ok = true, valId = makeListVal("List<Int>", ids, mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "isDigit" { return CtOutcome { ok = true, valId = makeBoolVal(recv.strVal.isDigit(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "isNameStart" { return CtOutcome { ok = true, valId = makeBoolVal(recv.strVal.isNameStart(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "isNameContinue" { return CtOutcome { ok = true, valId = makeBoolVal(recv.strVal.isNameContinue(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "toText" { return CtOutcome { ok = true, valId = recvId, flow = FLOW_NONE, error = "" }; }
    }
    if recv.tag == TAG_INT {
        if methodName == "toText" { return CtOutcome { ok = true, valId = makeStrVal(recv.intVal.toText(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "abs" { return CtOutcome { ok = true, valId = makeIntVal(recv.intVal.abs(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "min" and args.length() >= 1 { return CtOutcome { ok = true, valId = makeIntVal(recv.intVal.min(ctPool[args[0]].intVal), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "max" and args.length() >= 1 { return CtOutcome { ok = true, valId = makeIntVal(recv.intVal.max(ctPool[args[0]].intVal), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "checkedAdd" or methodName == "checkedSub" or methodName == "checkedMul" or methodName == "checkedDiv" or methodName == "checkedRem" or methodName == "floorDiv" or methodName == "floorMod" {
            rhs := ctPool[args[0]].intVal;
            r := if methodName == "checkedAdd" { recv.intVal.checkedAdd(rhs) }
            else if methodName == "checkedSub" { recv.intVal.checkedSub(rhs) }
            else if methodName == "checkedMul" { recv.intVal.checkedMul(rhs) }
            else if methodName == "checkedDiv" { recv.intVal.checkedDiv(rhs) }
            else if methodName == "checkedRem" { recv.intVal.checkedRem(rhs) }
            else if methodName == "floorDiv" { recv.intVal.floorDiv(rhs) }
            else { recv.intVal.floorMod(rhs) };
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<value:Int,ok:Bool>", [makeIntVal(r.value, "", mut budget), makeBoolVal(r.ok, "", mut budget)], ["value", "ok"], mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if recv.tag == TAG_BOOL and methodName == "toText" {
        return CtOutcome { ok = true, valId = makeStrVal(if recv.intVal =!= 0 { "true" } else { "false" }, "", mut budget), flow = FLOW_NONE, error = "" };
    }
    if recv.tag == TAG_FLOAT and methodName == "toText" {
        return CtOutcome { ok = true, valId = makeStrVal(recv.floatVal.toText(), "", mut budget), flow = FLOW_NONE, error = "" };
    }
    if recv.tag == TAG_LIST or recv.tag == TAG_ARRAY {
        if methodName == "length" { return CtOutcome { ok = true, valId = makeIntVal(recv.children.length(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "join" and args.length() >= 1 {
            sep := formatCtVal(args[0]);
            mut parts: List<String> = [];
            loop recv.children as cid { mut parts.pushBack(formatCtVal(cid)); }
            return CtOutcome { ok = true, valId = makeStrVal(parts.join(sep), "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "contains" and args.length() >= 1 {
            var found := false;
            loop recv.children as cid { if ctValuesEqual(cid, args[0]) { found = true; break; } }
            return CtOutcome { ok = true, valId = makeBoolVal(found, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "pushBack" and args.length() >= 1 {
            mut ch: List<Int> = recv.children;
            mut ch.pushBack(cloneValIfContainer(args[0], "", mut budget));
            mut ctPool.setAt(recvId, CtCell { tag = recv.tag, kind = recv.kind, intVal = recv.intVal, floatVal = recv.floatVal, strVal = recv.strVal, children = ch, keys = recv.keys });
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "popBack" {
            if recv.children.length() == 0 {
                return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "popBack on empty list in compile-time evaluation" };
            }
            mut ch: List<Int> = recv.children;
            popped := mut ch.popBack();
            mut ctPool.setAt(recvId, CtCell { tag = recv.tag, kind = recv.kind, intVal = recv.intVal, floatVal = recv.floatVal, strVal = recv.strVal, children = ch, keys = recv.keys });
            return CtOutcome { ok = true, valId = popped, flow = FLOW_NONE, error = "" };
        }
    }
    if recv.tag == TAG_MAP {
        if methodName == "length" { return CtOutcome { ok = true, valId = makeIntVal(recv.keys.length(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "has" and args.length() >= 1 {
            kStr := scalarKeyString(args[0]);
            var found := false;
            loop recv.keys as k { if k == kStr { found = true; break; } }
            return CtOutcome { ok = true, valId = makeBoolVal(found, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "set" and args.length() >= 2 {
            kStr := scalarKeyString(args[0]);
            mut newKeys: List<String> = recv.keys;
            mut newCh: List<Int> = recv.children;
            var hit := -1;
            var i := 0;
            loop i < newKeys.length() { if newKeys[i] == kStr { hit = i; break; } i = i + 1; }
            if hit >= 0 {
                mut newCh.setAt(hit * 2 + 1, cloneValIfContainer(args[1], "", mut budget));
            } else {
                mut newKeys.pushBack(kStr);
                mut newCh.pushBack(cloneValIfContainer(args[0], "", mut budget));
                mut newCh.pushBack(cloneValIfContainer(args[1], "", mut budget));
            }
            mut ctPool.setAt(recvId, CtCell { tag = TAG_MAP, kind = recv.kind, intVal = newKeys.length(), floatVal = 0.0, strVal = "", children = newCh, keys = newKeys });
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "get" and args.length() >= 1 {
            kStr := scalarKeyString(args[0]);
            var hit := -1;
            var i := 0;
            loop i < recv.keys.length() { if recv.keys[i] == kStr { hit = i; break; } i = i + 1; }
            valKind := types.mapValueKind(recv.kind);
            if hit >= 0 {
                vId := recv.children[hit * 2 + 1];
                return CtOutcome { ok = true, valId = makeTupleVal("Tuple<found:Bool,value:" + valKind + ">", [makeBoolVal(true, "", mut budget), vId], ["found", "value"], mut budget), flow = FLOW_NONE, error = "" };
            }
            zId := makeZeroCtVal(valKind, mut budget, frame.aliases, frame.moduleKey);
            return CtOutcome { ok = true, valId = makeTupleVal("Tuple<found:Bool,value:" + valKind + ">", [makeBoolVal(false, "", mut budget), zId], ["found", "value"], mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if recv.tag == TAG_SET {
        if methodName == "length" { return CtOutcome { ok = true, valId = makeIntVal(recv.keys.length(), "", mut budget), flow = FLOW_NONE, error = "" }; }
        if methodName == "has" and args.length() >= 1 {
            kStr := scalarKeyString(args[0]);
            var found := false;
            loop recv.keys as k { if k == kStr { found = true; break; } }
            return CtOutcome { ok = true, valId = makeBoolVal(found, "", mut budget), flow = FLOW_NONE, error = "" };
        }
        if methodName == "add" and args.length() >= 1 {
            kStr := scalarKeyString(args[0]);
            var hit := false;
            loop recv.keys as k { if k == kStr { hit = true; break; } }
            if not hit {
                mut newKeys: List<String> = recv.keys;
                mut newCh: List<Int> = recv.children;
                mut newKeys.pushBack(kStr);
                mut newCh.pushBack(cloneValIfContainer(args[0], "", mut budget));
                mut ctPool.setAt(recvId, CtCell { tag = TAG_SET, kind = recv.kind, intVal = newKeys.length(), floatVal = 0.0, strVal = "", children = newCh, keys = newKeys });
            }
            return CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        }
    }
    if recv.tag == TAG_READER or recv.tag == TAG_WRITER {
        mut fullArgs: List<Int> = [recvId];
        loop args as a { mut fullArgs.pushBack(a); }
        fullOp := if recv.tag == TAG_READER { "Reader." + methodName } else { "Writer." + methodName };
        return evalHostBuiltinCall("lite.core.io.v1", fullOp, fullArgs, mut budget);
    }
    /* Look up registered `Type.op` in active module or owner module */
    ownerKey := types.typeOpOwnerKey(recv.kind);
    if ownerKey =!= "" {
        hashPos := ownerKey.indexOf("#", 0);
        colonPos := ownerKey.indexOf(":", 0);
        ownerMod := if colonPos >= 0 and hashPos > colonPos { ownerKey.slice(colonPos + 1, hashPos) } else { frame.moduleKey };
        dispName := baseNominalName(recv.kind);
        var candIndices: List<Int> = findFnIndicesInModule(if recv.kind == types.CORE_ERROR_KIND { "lib$core$error" } else { ownerMod }, dispName + "." + methodName);
        if candIndices.length() == 0 and recv.kind == types.CORE_ERROR_KIND {
            candIndices = findFnIndicesInModule("lib_s_core_s_error", "Error." + methodName);
        }
        if candIndices.length() == 0 {
            candIndices = findFnIndicesInModule(frame.moduleKey, dispName + "." + methodName);
        }
        if candIndices.length() > 0 {
            mut allArgs: List<Int> = [recvId];
            loop args as a { mut allArgs.pushBack(a); }
            chosen := selectOverloadFnDef(candIndices, allArgs.length() - labels.length(), labels);
            return invokeCtFnDefWithTypeArgs(chosen, splitCanonicalNominalArgs(recv.kind), allArgs, labels, mut budget);
        }
    }
    /* Also check `lib/core/text` soft methods cleanly */
    if recv.tag == TAG_STR {
        mut textArgs: List<Int> = [recvId];
        loop args as a { mut textArgs.pushBack(a); }
        tIdx := findFnIndicesInModule("lib$core$text", "String." + methodName);
        tIdx2 := if tIdx.length() > 0 { tIdx } else { findFnIndicesInModule("lib_s_core_s_text", "String." + methodName) };
        if tIdx2.length() > 0 {
            chosen := selectOverloadFnDef(tIdx2, textArgs.length() - labels.length(), labels);
            return invokeCtFnDef(chosen, textArgs, labels, mut budget);
        }
    }
    CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsupported compile-time method call ." + methodName }
};

/** Parses and evaluates a postfix chain (`[idx]`, `.field`, `.method(...)`, `(args)`, `!`) on `baseId`. */
evalPostfixChain := fn(source: String, exprStart: Int, limitPos: Int, prefix: String, baseId: Int, baseName: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    if exprStart > 0 and source.at(exprStart - 1) == "}" {
        return (outcome = CtOutcome { ok = true, valId = baseId, flow = FLOW_NONE, error = "" }, next = exprStart);
    }
    var curId := baseId;
    var curName := baseName;
    var rawNext := exprStart;
    var cursor := syntax.skipTrivia(source, exprStart, prefix);
    loop cursor < limitPos {
        if rawNext > 0 and source.at(rawNext - 1) == "}" { break; }
        ch := source.at(cursor);
        if ch == "." {
            fStart := syntax.skipTrivia(source, cursor + 1, prefix);
            var fName := "";
            var fEnd := fStart;
            if fStart < limitPos and source.at(fStart) == "\"" and types.isRecordKind(ctPool[curId].kind) {
                qF := syntax.parseText(ir.TARGET_TS, source, fStart, prefix);
                fName = qF.textValue;
                fEnd = qF.next;
            } else if fStart < limitPos and source.at(fStart).isNameStart() {
                fEnd = source.skipName(fStart);
                fName = source.slice(fStart, fEnd);
            } else {
                break;
            }
            afterF := syntax.skipTrivia(source, fEnd, prefix);
            if afterF < limitPos and (source.at(afterF) == "(" or source.at(afterF) == "<") {
                var argParen := afterF;
                if source.at(argParen) == "<" {
                    /* Distinguish comptime `<...>(...)` from field comparison `<` */
                    var gt := argParen + 1;
                    var gd := 1;
                    loop gt < limitPos and gd > 0 {
                        gc := source.at(gt);
                        if gc == "<" { gd = gd + 1; }
                        else if gc == ">" { gd = gd - 1; }
                        else if gc == ";" or gc == "{" or gc == "}" { break; }
                        gt = gt + 1;
                    }
                    if gd =!= 0 { break; }
                    afterGt := syntax.skipTrivia(source, gt, prefix);
                    if afterGt >= limitPos or source.at(afterGt) =!= "(" { break; }
                    argParen = afterGt;
                }
                callA := evalCallArgs(source, argParen, prefix, mut frame, mut budget);
                if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                resM := evalMethodCall(source, fName, curId, curName, callA.args, callA.labels, mut frame, mut budget);
                if resM.flow =!= FLOW_NONE { return (outcome = resM, next = callA.next); }
                curId = resM.valId;
                curName = "";
                rawNext = callA.next;
                cursor = syntax.skipTrivia(source, callA.next, prefix);
                continue;
            }
            /* Field access on record / tuple */
            cell := ctPool[curId];
            var foundIdx := -1;
            var ki := 0;
            loop ki < cell.keys.length() {
                if cell.keys[ki] == fName { foundIdx = ki; break; }
                ki = ki + 1;
            }
            if foundIdx >= 0 and foundIdx < cell.children.length() {
                curId = cell.children[foundIdx];
                curName = "";
                rawNext = fEnd;
                cursor = syntax.skipTrivia(source, fEnd, prefix);
                continue;
            }
            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown compile-time field ." + fName }, next = fEnd);
        } else if ch == "[" {
            idxR := evalExprAt(source, cursor + 1, limitPos, prefix, "", mut frame, mut budget);
            if idxR.outcome.flow =!= FLOW_NONE { return (outcome = idxR.outcome, next = idxR.next); }
            afterIdx := syntax.skipTrivia(source, idxR.next, prefix);
            cell := ctPool[curId];
            if afterIdx < limitPos and source.at(afterIdx) == "." and afterIdx + 1 < limitPos and source.at(afterIdx + 1) == "." {
                /* Slice `xs[a..b]` -> represent as temporary List/Array view for `.toList()` or indexing */
                endR := evalExprAt(source, afterIdx + 2, limitPos, prefix, "", mut frame, mut budget);
                if endR.outcome.flow =!= FLOW_NONE { return (outcome = endR.outcome, next = endR.next); }
                a := ctPool[idxR.outcome.valId].intVal;
                b := ctPool[endR.outcome.valId].intVal;
                if a < 0 or b < a or b > cell.children.length() {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "slice bounds out of range in compile-time evaluation" }, next = endR.next);
                }
                mut subElems: List<Int> = [];
                var si := a;
                loop si < b { mut subElems.pushBack(cell.children[si]); si = si + 1; }
                elK := if types.isListKind(cell.kind) { types.listElementKind(cell.kind) } else { types.arrayElementKind(cell.kind) };
                curId = makeListVal("List<" + elK + ">", subElems, mut budget);
                closeBr := syntax.skipTrivia(source, endR.next, prefix);
                rawNext = if closeBr < limitPos and source.at(closeBr) == "]" { closeBr + 1 } else { closeBr };
                cursor = syntax.skipTrivia(source, rawNext, prefix);
                curName = "";
                continue;
            }
            idxVal := ctPool[idxR.outcome.valId].intVal;
            if idxVal < 0 or idxVal >= cell.children.length() {
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "index " + idxVal.toText() + " out of bounds (length " + cell.children.length().toText() + ")" }, next = afterIdx);
            }
            curId = cell.children[idxVal];
            curName = "";
            rawNext = if afterIdx < limitPos and source.at(afterIdx) == "]" { afterIdx + 1 } else { afterIdx };
            cursor = syntax.skipTrivia(source, rawNext, prefix);
            continue;
        } else if ch == "(" {
            cell := ctPool[curId];
            if cell.tag =!= TAG_FN {
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot invoke non-function value at compile time" }, next = cursor);
            }
            callA := evalCallArgs(source, cursor, prefix, mut frame, mut budget);
            if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
            rtIdx := ctFnIdxByRt.get(cell.strVal);
            if not rtIdx.found {
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "missing function definition for " + cell.strVal }, next = callA.next);
            }
            invR := invokeCtFnDef(rtIdx.value, callA.args, callA.labels, mut budget);
            if invR.flow =!= FLOW_NONE { return (outcome = invR, next = callA.next); }
            curId = invR.valId;
            curName = "";
            rawNext = callA.next;
            cursor = syntax.skipTrivia(source, callA.next, prefix);
            continue;
        } else if ch == "!" and not source.startsWithAt(cursor, "!=") {
            cell := ctPool[curId];
            if cell.tag =!= TAG_RESULT {
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "postfix ! on non-Result compile-time value" }, next = cursor + 1);
            }
            if cell.intVal == 0 {
                curId = if cell.children.length() > 0 { cell.children[0] } else { makeUnitVal(mut budget) };
                curName = "";
                rawNext = cursor + 1;
                cursor = syntax.skipTrivia(source, rawNext, prefix);
                continue;
            }
            /* Propagate `.err` outward as `Result<T_outer, E_outer>` */
            errPayloadId := if cell.children.length() > 0 { cell.children[0] } else { makeUnitVal(mut budget) };
            outResK := if frame.fnResultKind =!= "" and types.isResultKind(frame.fnResultKind) { frame.fnResultKind } else { cell.kind };
            outErrK := types.resultErrKind(outResK);
            actErrK := types.resultErrKind(cell.kind);
            var convErrId := errPayloadId;
            if outErrK =!= actErrK {
                if types.isCompatibleKind(outErrK, actErrK) {
                    convErrId = coerceCtValue(outErrK, actErrK, errPayloadId, mut budget);
                } else if outErrK == types.CORE_ERROR_KIND {
                    tsImp := types.findToErrorImpl(ir.TARGET_TS, actErrK);
                    imp := if tsImp.found { tsImp } else { types.findToErrorImpl(ir.TARGET_C, actErrK) };
                    if imp.found {
                        impDef := interfaces.getImpl(imp.implIdx);
                        bind := interfaces.findBindingInImpl(impDef, "toError");
                        if bind.found {
                            rIdx := ctFnIdxByRt.get(bind.binding.fnKey);
                            var toErrIdx := if rIdx.found { rIdx.value } else { -1 };
                            if toErrIdx < 0 {
                                cands := findFnIndicesInModule(impDef.declModule, bind.binding.fnKey);
                                if cands.length() > 0 { toErrIdx = cands[0]; }
                            }
                            if toErrIdx >= 0 {
                                convR := invokeCtFnDef(toErrIdx, [errPayloadId], [], mut budget);
                                if convR.flow =!= FLOW_NONE { return (outcome = convR, next = cursor + 1); }
                                convErrId = convR.valId;
                            }
                        }
                    }
                }
            }
            propVal := makeResultVal(outResK, true, convErrId, mut budget);
            return (outcome = CtOutcome { ok = true, valId = propVal, flow = FLOW_PROP_ERR, error = "" }, next = cursor + 1);
        } else {
            break;
        }
    }
    (outcome = CtOutcome { ok = true, valId = curId, flow = FLOW_NONE, error = "" }, next = rawNext)
};

/** Evaluates one primary expression (literals, records, lists/maps, names, calls, `if`/`match`/`loop`/`do`/`comptime`) + postfix chain. */
evalPrimaryAt := fn(source: String, startPos: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    start := syntax.skipTrivia(source, startPos, prefix);
    if start >= limitPos {
        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unexpected end of compile-time expression" }, next = start);
    }
    ch := source.at(start);
    var res := CtOutcome { ok = true, valId = -1, flow = FLOW_NONE, error = "" };
    var resNext := start;
    var baseName := "";

    if ch == "(" {
        innerCur := syntax.skipTrivia(source, start + 1, prefix);
        if syntax.looksLikeTupleEntry(source, innerCur, prefix) or (innerCur < limitPos and source.at(innerCur) == ")") {
            /* Tuple literal */
            var tCur := innerCur;
            mut vals: List<Int> = [];
            mut lbls: List<String> = [];
            var ti := 0;
            loop tCur < limitPos and source.at(tCur) =!= ")" {
                var lbl := "";
                if syntax.isSingleEquals(source, tCur) {
                    shS := syntax.skipTrivia(source, tCur + 1, prefix);
                    lbl = source.slice(shS, source.skipName(shS));
                    ev := evalExprAt(source, shS, limitPos, prefix, "", mut frame, mut budget);
                    if ev.outcome.flow =!= FLOW_NONE { return (outcome = ev.outcome, next = ev.next); }
                    mut vals.pushBack(ev.outcome.valId);
                    mut lbls.pushBack(lbl);
                    tCur = syntax.skipTrivia(source, ev.next, prefix);
                } else {
                    if source.at(tCur).isNameStart() {
                        ne := source.skipName(tCur);
                        an := syntax.skipTrivia(source, ne, prefix);
                        if an < limitPos and syntax.isSingleEquals(source, an) {
                            lbl = source.slice(tCur, ne);
                            tCur = syntax.skipTrivia(source, an + 1, prefix);
                        }
                    }
                    compK := if types.isTupleKind(expectedKind) and ti < types.tupleComponentCount(expectedKind) { types.tupleComponent(expectedKind, ti).kind } else { "" };
                    ev := evalExprAt(source, tCur, limitPos, prefix, compK, mut frame, mut budget);
                    if ev.outcome.flow =!= FLOW_NONE { return (outcome = ev.outcome, next = ev.next); }
                    mut vals.pushBack(ev.outcome.valId);
                    mut lbls.pushBack(lbl);
                    tCur = syntax.skipTrivia(source, ev.next, prefix);
                }
                ti = ti + 1;
                if tCur < limitPos and source.at(tCur) == "," { tCur = syntax.skipTrivia(source, tCur + 1, prefix); }
                else { break; }
            }
            resNext = if tCur < limitPos and source.at(tCur) == ")" { tCur + 1 } else { tCur };
            mut tParts: List<String> = [];
            var pi := 0;
            loop pi < vals.length() {
                vk := ctPool[vals[pi]].kind;
                mut tParts.pushBack(if lbls[pi] =!= "" { lbls[pi] + ":" + vk } else { vk });
                pi = pi + 1;
            }
            tKind := if types.isTupleKind(expectedKind) { expectedKind } else { "Tuple<" + tParts.join(",") + ">" };
            res = CtOutcome { ok = true, valId = makeTupleVal(tKind, vals, lbls, mut budget), flow = FLOW_NONE, error = "" };
        } else {
            ev := evalExprAt(source, innerCur, limitPos, prefix, expectedKind, mut frame, mut budget);
            if ev.outcome.flow =!= FLOW_NONE { return ev; }
            closeP := syntax.skipTrivia(source, ev.next, prefix);
            resNext = if closeP < limitPos and source.at(closeP) == ")" { closeP + 1 } else { closeP };
            res = ev.outcome;
        }
    } else if ch == "+" or ch == "-" {
        afterSign := syntax.skipTrivia(source, start + 1, prefix);
        if afterSign < limitPos and source.at(afterSign).isDigit() {
            numP := syntax.parseNumber(ir.TARGET_TS, source, start, prefix, expectedKind, 0);
            resNext = numP.next;
            if numeric.isFloatKind(numP.kind) {
                rawNum := source.slice(start, numP.next);
                fRes := parseFloatText(rawNum);
                fv := if fRes.ok { fRes.value } else { 0.0 };
                res = CtOutcome { ok = true, valId = makeFloatVal(fv, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
            } else if numeric.isUnsignedIntKind(numP.kind) {
                rawU := source.slice(start, numP.next);
                uRes := parseUInt64Text(rawU);
                res = CtOutcome { ok = true, valId = makeUIntVal(if uRes.ok { uRes.value } else { cast<UInt64>(0) }, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
            } else {
                res = CtOutcome { ok = true, valId = makeIntVal(numP.intValue, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
            }
        } else {
            opR := evalPrimaryAt(source, afterSign, limitPos, prefix, "", mut frame, mut budget);
            if opR.outcome.flow =!= FLOW_NONE { return opR; }
            resNext = opR.next;
            oc := ctPool[opR.outcome.valId];
            if ch == "+" {
                res = opR.outcome;
            } else if oc.tag == TAG_FLOAT {
                res = CtOutcome { ok = true, valId = makeFloatVal(-oc.floatVal, oc.kind, mut budget), flow = FLOW_NONE, error = "" };
            } else {
                neg := oc.intVal.checkedNeg();
                if not neg.ok or not numeric.intKindFits(oc.kind, neg.value) {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "integer negation overflow in compile-time evaluation" }, next = resNext);
                }
                res = CtOutcome { ok = true, valId = makeIntVal(neg.value, oc.kind, mut budget), flow = FLOW_NONE, error = "" };
            }
        }
    } else if ch.isDigit() {
        numP := syntax.parseNumber(ir.TARGET_TS, source, start, prefix, expectedKind, 0);
        resNext = numP.next;
        if numeric.isFloatKind(numP.kind) {
            rawNum := source.slice(start, numP.next);
            fRes := parseFloatText(rawNum);
            res = CtOutcome { ok = true, valId = makeFloatVal(if fRes.ok { fRes.value } else { 0.0 }, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
        } else if numeric.isUnsignedIntKind(numP.kind) {
            rawU := source.slice(start, numP.next);
            uRes := parseUInt64Text(rawU);
            res = CtOutcome { ok = true, valId = makeUIntVal(if uRes.ok { uRes.value } else { cast<UInt64>(0) }, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
        } else {
            res = CtOutcome { ok = true, valId = makeIntVal(numP.intValue, numP.kind, mut budget), flow = FLOW_NONE, error = "" };
        }
    } else if ch == "\"" {
        lit := decodeStringLiteral(source, start, prefix);
        resNext = lit.next;
        res = CtOutcome { ok = true, valId = makeStrVal(lit.text, ir.VALUE_KIND_STRING, mut budget), flow = FLOW_NONE, error = "" };
    } else if ch == "[" {
        var cur := syntax.skipTrivia(source, start + 1, prefix);
        isMapT := types.isMapKind(expectedKind);
        isSetT := types.isSetKind(expectedKind);
        if cur < limitPos and source.at(cur) == "]" {
            resNext = cur + 1;
            vid := if isMapT { makeMapVal(expectedKind, [], [], [], mut budget) }
            else if isSetT { makeSetVal(expectedKind, [], [], mut budget) }
            else if types.isArrayKind(expectedKind) { makeArrayVal(expectedKind, [], mut budget) }
            else { makeListVal(if expectedKind =!= "" { expectedKind } else { "List<Int>" }, [], mut budget) };
            res = CtOutcome { ok = true, valId = vid, flow = FLOW_NONE, error = "" };
        } else {
            elExp := if types.isListKind(expectedKind) { types.listElementKind(expectedKind) }
            else if types.isArrayKind(expectedKind) { types.arrayElementKind(expectedKind) }
            else if isSetT { types.setElementKind(expectedKind) }
            else if isMapT { types.mapKeyKind(expectedKind) } else { "" };
            firstR := evalExprAt(source, cur, limitPos, prefix, elExp, mut frame, mut budget);
            if firstR.outcome.flow =!= FLOW_NONE { return firstR; }
            afterFirst := syntax.skipTrivia(source, firstR.next, prefix);
            if afterFirst < limitPos and syntax.isSingleEquals(source, afterFirst) {
                /* Map `[k = v, ...]` */
                mut mKeys: List<String> = [];
                mut mKeyIds: List<Int> = [];
                mut mValIds: List<Int> = [];
                var kId := firstR.outcome.valId;
                var eqPos := afterFirst;
                loop true {
                    vExp := if isMapT { types.mapValueKind(expectedKind) } else { "" };
                    vR := evalExprAt(source, eqPos + 1, limitPos, prefix, vExp, mut frame, mut budget);
                    if vR.outcome.flow =!= FLOW_NONE { return vR; }
                    ks := scalarKeyString(kId);
                    var hit := -1;
                    var i := 0;
                    loop i < mKeys.length() { if mKeys[i] == ks { hit = i; break; } i = i + 1; }
                    if hit >= 0 {
                        mut mValIds.setAt(hit, cloneValIfContainer(vR.outcome.valId, "", mut budget));
                    } else {
                        mut mKeys.pushBack(ks);
                        mut mKeyIds.pushBack(kId);
                        mut mValIds.pushBack(cloneValIfContainer(vR.outcome.valId, "", mut budget));
                    }
                    cur = syntax.skipTrivia(source, vR.next, prefix);
                    if cur < limitPos and source.at(cur) == "," {
                        cur = syntax.skipTrivia(source, cur + 1, prefix);
                        if cur < limitPos and source.at(cur) == "]" { break; }
                        kR := evalExprAt(source, cur, limitPos, prefix, elExp, mut frame, mut budget);
                        if kR.outcome.flow =!= FLOW_NONE { return kR; }
                        kId = kR.outcome.valId;
                        eqPos = syntax.skipTrivia(source, kR.next, prefix);
                    } else { break; }
                }
                resNext = if cur < limitPos and source.at(cur) == "]" { cur + 1 } else { cur };
                kK := if isMapT { types.mapKeyKind(expectedKind) } else { ctPool[mKeyIds[0]].kind };
                vK := if isMapT { types.mapValueKind(expectedKind) } else { ctPool[mValIds[0]].kind };
                res = CtOutcome { ok = true, valId = makeMapVal("Map<" + kK + "," + vK + ">", mKeys, mKeyIds, mValIds, mut budget), flow = FLOW_NONE, error = "" };
            } else if afterFirst < limitPos and source.at(afterFirst) == ";" {
                /* Repeat `[elem; count]` */
                nStart := syntax.skipTrivia(source, afterFirst + 1, prefix);
                nR := evalExprAt(source, nStart, limitPos, prefix, ir.VALUE_KIND_INT, mut frame, mut budget);
                if nR.outcome.flow =!= FLOW_NONE { return nR; }
                cnt := ctPool[nR.outcome.valId].intVal;
                closeB := syntax.skipTrivia(source, nR.next, prefix);
                resNext = if closeB < limitPos and source.at(closeB) == "]" { closeB + 1 } else { closeB };
                elVal := firstR.outcome.valId;
                elKind := if elExp =!= "" { elExp } else { ctPool[elVal].kind };
                mut elems: List<Int> = [];
                var ri := 0;
                loop ri < cnt {
                    mut elems.pushBack(cloneValIfContainer(elVal, elKind, mut budget));
                    ri = ri + 1;
                }
                vid := if types.isListKind(expectedKind) { makeListVal("List<" + elKind + ">", elems, mut budget) }
                else { makeArrayVal("[" + elKind + ";" + cnt.toText() + "]", elems, mut budget) };
                res = CtOutcome { ok = true, valId = vid, flow = FLOW_NONE, error = "" };
            } else {
                mut elems: List<Int> = [coerceCtValue(elExp, ctPool[firstR.outcome.valId].kind, cloneValIfContainer(firstR.outcome.valId, "", mut budget), mut budget)];
                cur = afterFirst;
                loop cur < limitPos {
                    if cur < limitPos and source.at(cur) == "," {
                        cur = syntax.skipTrivia(source, cur + 1, prefix);
                        if cur < limitPos and source.at(cur) == "]" { break; }
                        er := evalExprAt(source, cur, limitPos, prefix, elExp, mut frame, mut budget);
                        if er.outcome.flow =!= FLOW_NONE { return er; }
                        mut elems.pushBack(coerceCtValue(elExp, ctPool[er.outcome.valId].kind, cloneValIfContainer(er.outcome.valId, "", mut budget), mut budget));
                        cur = syntax.skipTrivia(source, er.next, prefix);
                    } else { break; }
                }
                resNext = if cur < limitPos and source.at(cur) == "]" { cur + 1 } else { cur };
                effEl := if elExp =!= "" { elExp } else { ctPool[elems[0]].kind };
                vid := if isSetT {
                    mut sKeys: List<String> = [];
                    mut sIds: List<Int> = [];
                    loop elems as eid {
                        sk := scalarKeyString(eid);
                        if not sKeys.contains(sk) { mut sKeys.pushBack(sk); mut sIds.pushBack(eid); }
                    }
                    makeSetVal("Set<" + effEl + ">", sKeys, sIds, mut budget)
                } else if types.isArrayKind(expectedKind) {
                    makeArrayVal("[" + effEl + ";" + elems.length().toText() + "]", elems, mut budget)
                } else {
                    makeListVal("List<" + effEl + ">", elems, mut budget)
                };
                res = CtOutcome { ok = true, valId = vid, flow = FLOW_NONE, error = "" };
            }
        }
    } else if ch == "." {
        cStart := syntax.skipTrivia(source, start + 1, prefix);
        cEnd := source.skipName(cStart);
        cName := source.slice(cStart, cEnd);
        afterC := syntax.skipTrivia(source, cEnd, prefix);
        if cName == "count" and frame.loopCount >= 0 {
            resNext = cEnd;
            res = CtOutcome { ok = true, valId = makeIntVal(frame.loopCount, "", mut budget), flow = FLOW_NONE, error = "" };
        } else if cName == "index" {
            resNext = cEnd;
            res = CtOutcome { ok = true, valId = makeIntVal(frame.loopIndex, "", mut budget), flow = FLOW_NONE, error = "" };
        } else if cName == "item" and frame.hasLoopItem {
            resNext = cEnd;
            res = CtOutcome { ok = true, valId = frame.loopItemId, flow = FLOW_NONE, error = "" };
        } else if (cName == "ok" or cName == "err") and types.isResultKind(expectedKind) {
            isErr := cName == "err";
            pKind := if isErr { types.resultErrKind(expectedKind) } else { types.resultOkKind(expectedKind) };
            if afterC < limitPos and source.at(afterC) == "(" {
                callA := evalCallArgs(source, afterC, prefix, mut frame, mut budget);
                if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                resNext = callA.next;
                pId := coerceCtValue(pKind, ctPool[callA.args[0]].kind, callA.args[0], mut budget);
                res = CtOutcome { ok = true, valId = makeResultVal(expectedKind, isErr, pId, mut budget), flow = FLOW_NONE, error = "" };
            } else {
                resNext = cEnd;
                res = CtOutcome { ok = true, valId = makeResultVal(expectedKind, isErr, makeUnitVal(mut budget), mut budget), flow = FLOW_NONE, error = "" };
            }
        } else if types.isEnumKind(expectedKind) {
            caseIdx := types.enumCaseIndex(expectedKind, cName);
            if afterC < limitPos and source.at(afterC) == "(" {
                callA := evalCallArgs(source, afterC, prefix, mut frame, mut budget);
                if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                resNext = callA.next;
                res = CtOutcome { ok = true, valId = makeEnumVal(expectedKind, caseIdx, cName, callA.args, mut budget), flow = FLOW_NONE, error = "" };
            } else {
                resNext = cEnd;
                res = CtOutcome { ok = true, valId = makeEnumVal(expectedKind, caseIdx, cName, [], mut budget), flow = FLOW_NONE, error = "" };
            }
        } else if types.isRecordKind(expectedKind) and afterC < limitPos and source.at(afterC) == "(" {
            /* Contextual static call `.create(...)` */
            callA := evalCallArgs(source, afterC, prefix, mut frame, mut budget);
            if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
            resNext = callA.next;
            ownerK := types.typeOpOwnerKey(expectedKind);
            hashP := ownerK.indexOf("#", 0);
            colP := ownerK.indexOf(":", 0);
            oMod := if colP >= 0 and hashP > colP { ownerK.slice(colP + 1, hashP) } else { frame.moduleKey };
            dName := types.recordDisplayName(expectedKind);
            cands := findFnIndicesInModule(oMod, dName + "." + cName);
            cands2 := if cands.length() > 0 { cands } else { findFnIndicesInModule(frame.moduleKey, dName + "." + cName) };
            chosen := selectOverloadFnDef(cands2, callA.args.length() - callA.labels.length(), callA.labels);
            res = invokeCtFnDef(chosen, callA.args, callA.labels, mut budget);
        } else {
            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve ." + cName + " at compile time" }, next = cEnd);
        }
    } else if ch == "{" {
        recR := if types.isRecordKind(expectedKind) and not types.isAnonRecordKind(expectedKind) {
            evalRecordLiteralAt(source, start, limitPos, prefix, expectedKind, mut frame, mut budget)
        } else {
            evalInferredRecordLiteralAt(source, start, limitPos, prefix, expectedKind, mut frame, mut budget)
        };
        if recR.outcome.flow =!= FLOW_NONE { return recR; }
        res = recR.outcome;
        resNext = recR.next;
    } else if ch.isNameStart() {
        nEnd := source.skipName(start);
        name := source.slice(start, nEnd);
        afterName := syntax.skipTrivia(source, nEnd, prefix);
        if name == "Unit" {
            resNext = nEnd;
            res = CtOutcome { ok = true, valId = makeUnitVal(mut budget), flow = FLOW_NONE, error = "" };
        } else if name == "true" or name == "false" {
            resNext = nEnd;
            res = CtOutcome { ok = true, valId = makeBoolVal(name == "true", "", mut budget), flow = FLOW_NONE, error = "" };
        } else if name == "not" {
            sub := evalExprWithMin(source, afterName, limitPos, prefix, ir.VALUE_KIND_BOOL, 5, mut frame, mut budget);
            if sub.outcome.flow =!= FLOW_NONE { return sub; }
            resNext = sub.next;
            res = CtOutcome { ok = true, valId = makeBoolVal(ctPool[sub.outcome.valId].intVal == 0, "", mut budget), flow = FLOW_NONE, error = "" };
        } else if name == "mut" {
            return self(source, afterName, limitPos, prefix, expectedKind, mut frame, mut budget);
        } else if name == "do" or name == "comptime" {
            openB := syntax.skipTrivia(source, nEnd, prefix);
            brR := evalBracedBlock(source, openB, prefix, expectedKind, mut frame, mut budget);
            res = brR.outcome;
            resNext = brR.next;
        } else if name == "if" {
            ifR := evalIfExpr(source, start, limitPos, prefix, expectedKind, mut frame, mut budget);
            res = ifR.outcome;
            resNext = ifR.next;
        } else if name == "match" {
            mR := evalMatchExpr(source, start, limitPos, prefix, expectedKind, mut frame, mut budget);
            res = mR.outcome;
            resNext = mR.next;
        } else if name == "loop" {
            lR := evalLoopExpr(source, start, limitPos, prefix, expectedKind, mut frame, mut budget);
            res = lR.outcome;
            resNext = lR.next;
        } else if name == "cast" and afterName < limitPos and (source.at(afterName) == "<" or source.at(afterName) == "(") {
            var dstK := expectedKind;
            var openP := afterName;
            if source.at(afterName) == "<" {
                tyR := resolveCtTypeAt(source, afterName + 1, prefix, frame.aliases);
                if not tyR.ok {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time cast type" }, next = afterName + 1);
                }
                gtPos := syntax.skipTrivia(source, tyR.next, prefix);
                openP = syntax.skipTrivia(source, gtPos + 1, prefix);
                dstK = tyR.kind;
            }
            argExp := if dstK =!= "" and types.isDistinctKind(dstK) { types.distinctUnderlyingKind(dstK) } else { "" };
            ev := evalExprAt(source, openP + 1, limitPos, prefix, argExp, mut frame, mut budget);
            if ev.outcome.flow =!= FLOW_NONE { return ev; }
            closeP := syntax.skipTrivia(source, ev.next, prefix);
            resNext = if closeP < limitPos and source.at(closeP) == ")" { closeP + 1 } else { closeP };
            vCell := ctPool[ev.outcome.valId];
            var cVid := ev.outcome.valId;
            if numeric.isFloatKind(dstK) and vCell.tag == TAG_INT { cVid = makeFloatVal(cast<Float>(vCell.intVal), dstK, mut budget); }
            else if numeric.isSignedIntKind(dstK) and vCell.tag == TAG_UINT {
                uv := parseUInt64Text(vCell.strVal);
                cVid = makeIntVal(cast<Int>(if uv.ok { uv.value } else { cast<UInt64>(0) }), dstK, mut budget);
            } else if numeric.isUnsignedIntKind(dstK) and vCell.tag == TAG_INT {
                cVid = makeUIntVal(cast<UInt64>(vCell.intVal), dstK, mut budget);
            } else if numeric.isSignedIntKind(dstK) and vCell.tag == TAG_INT {
                cVid = makeIntVal(vCell.intVal, dstK, mut budget);
            } else if dstK =!= "" and (types.isDistinctKind(dstK) or types.isDistinctKind(vCell.kind)) {
                cVid = allocCell(CtCell {
                    tag = vCell.tag, kind = dstK, intVal = vCell.intVal,
                    floatVal = vCell.floatVal, strVal = vCell.strVal,
                    children = vCell.children, keys = vCell.keys
                }, mut budget);
            }
            res = CtOutcome { ok = true, valId = cVid, flow = FLOW_NONE, error = "" };
        } else {
            /* Module qualifier `mod.sym` or local/module symbol or `Type { ... }` / `Type.op` */
            impHit := findImportInModule(frame.moduleKey, name);
            if impHit.found and afterName < limitPos and source.at(afterName) == "." {
                mStart := syntax.skipTrivia(source, afterName + 1, prefix);
                mEnd := source.skipName(mStart);
                mName := source.slice(mStart, mEnd);
                afterM := syntax.skipTrivia(source, mEnd, prefix);
                tModKey := impHit.imp.targetModKey;
                tModId := impHit.imp.targetIdentity;
                if mName == "Error" and types.findAlias(frame.aliases, name + ".Error") >= 0 {
                    resolved := types.findAlias(frame.aliases, name + ".Error");
                }
                /* Check `mod.Record { ... }`, `mod.Enum.Case`, `mod.Type.op(...)`, `mod.fn(...)`, or `mod.VAL` */
                alIdx := types.findAlias(frame.aliases, name + "." + mName);
                if alIdx >= 0 and afterM < limitPos and source.at(afterM) == "{" {
                    recT := resolveCtTypeAt(name + "." + mName, 0, prefix, frame.aliases);
                    if not recT.ok {
                        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time record type " + name + "." + mName }, next = afterM);
                    }
                    recR := evalRecordLiteralAt(source, afterM, limitPos, prefix, recT.kind, mut frame, mut budget);
                    if recR.outcome.flow =!= FLOW_NONE { return recR; }
                    return evalPostfixChain(source, recR.next, limitPos, prefix, recR.outcome.valId, "", mut frame, mut budget);
                }
                if alIdx >= 0 and afterM < limitPos and source.at(afterM) == "." {
                    nomT := resolveCtTypeAt(name + "." + mName, 0, prefix, frame.aliases);
                    if not nomT.ok {
                        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time type " + name + "." + mName }, next = afterM);
                    }
                    nomK := nomT.kind;
                    opStart := syntax.skipTrivia(source, afterM + 1, prefix);
                    opEnd := source.skipName(opStart);
                    opName := source.slice(opStart, opEnd);
                    afterOp := syntax.skipTrivia(source, opEnd, prefix);
                    if types.isEnumKind(nomK) and (afterOp >= limitPos or source.at(afterOp) =!= "(") {
                        ci := types.enumCaseIndex(nomK, opName);
                        if ci >= 0 {
                            return evalPostfixChain(source, opEnd, limitPos, prefix, makeEnumVal(nomK, ci, opName, [], mut budget), "", mut frame, mut budget);
                        }
                    }
                    if afterOp < limitPos and source.at(afterOp) == "(" {
                        callA := evalCallArgs(source, afterOp, prefix, mut frame, mut budget);
                        if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                        if types.isEnumKind(nomK) and types.enumCaseIndex(nomK, opName) >= 0 {
                            ci := types.enumCaseIndex(nomK, opName);
                            return evalPostfixChain(source, callA.next, limitPos, prefix, makeEnumVal(nomK, ci, opName, callA.args, mut budget), "", mut frame, mut budget);
                        }
                        if isEffectfulHostBuiltin(tModId, mName + "." + opName) or tModId.startsWithAt(0, "lite.core.") {
                            candsT := findFnIndicesInModule(tModKey, mName + "." + opName);
                            if candsT.length() > 0 {
                                chosen := selectOverloadFnDef(candsT, callA.args.length() - callA.labels.length(), callA.labels);
                                inv := invokeCtFnDefWithTypeArgs(chosen, splitCanonicalNominalArgs(nomK), callA.args, callA.labels, mut budget);
                                if inv.flow =!= FLOW_NONE { return (outcome = inv, next = callA.next); }
                                return evalPostfixChain(source, callA.next, limitPos, prefix, inv.valId, "", mut frame, mut budget);
                            }
                            hb := evalHostBuiltinCall(tModId, mName + "." + opName, callA.args, mut budget);
                            if hb.flow =!= FLOW_NONE { return (outcome = hb, next = callA.next); }
                            return evalPostfixChain(source, callA.next, limitPos, prefix, hb.valId, "", mut frame, mut budget);
                        }
                        rawCandsT := findFnIndicesInModule(tModKey, mName + "." + opName);
                        candsT := if rawCandsT.length() > 0 {
                            rawCandsT
                        } else {
                            dispN := baseNominalName(nomK);
                            if dispN =!= "" { findFnIndicesInModule(tModKey, dispN + "." + opName) } else { rawCandsT }
                        };
                        chosen := selectOverloadFnDef(candsT, callA.args.length() - callA.labels.length(), callA.labels);
                        inv := invokeCtFnDefWithTypeArgs(chosen, splitCanonicalNominalArgs(nomK), callA.args, callA.labels, mut budget);
                        if inv.flow =!= FLOW_NONE { return (outcome = inv, next = callA.next); }
                        return evalPostfixChain(source, callA.next, limitPos, prefix, inv.valId, "", mut frame, mut budget);
                    }
                }
                if afterM < limitPos and source.at(afterM) == "(" {
                    callA := evalCallArgs(source, afterM, prefix, mut frame, mut budget);
                    if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                    if tModId == "lite.core.file.v1" or tModId == "lite.core.io.v1" or tModId == "lite.core.process.v1" or tModId == "lite.core.time.v1" or tModId == "lite.core.diag.v1" {
                        hbFast := evalHostBuiltinCall(tModId, mName, callA.args, mut budget);
                        if hbFast.ok or not hbFast.error.startsWithAt(0, "unsupported compile-time host operation") {
                            if hbFast.flow =!= FLOW_NONE { return (outcome = hbFast, next = callA.next); }
                            return evalPostfixChain(source, callA.next, limitPos, prefix, hbFast.valId, "", mut frame, mut budget);
                        }
                    }
                    cands := findFnIndicesInModule(tModKey, mName);
                    if cands.length() > 0 {
                        chosen := selectOverloadFnDef(cands, callA.args.length() - callA.labels.length(), callA.labels);
                        inv := invokeCtFnDef(chosen, callA.args, callA.labels, mut budget);
                        if inv.flow =!= FLOW_NONE { return (outcome = inv, next = callA.next); }
                        return evalPostfixChain(source, callA.next, limitPos, prefix, inv.valId, "", mut frame, mut budget);
                    }
                    hb := evalHostBuiltinCall(tModId, mName, callA.args, mut budget);
                    if hb.flow =!= FLOW_NONE { return (outcome = hb, next = callA.next); }
                    return evalPostfixChain(source, callA.next, limitPos, prefix, hb.valId, "", mut frame, mut budget);
                }
                /* Imported compile-time constant `mod.VAL` */
                modRt := ir.safeTargetIdent(ir.TARGET_TS, name + "." + mName);
                ctImpId := lookupLocalCtVal(frame.moduleKey + "::" + tModKey + "." + mName);
                ctTargetId := if ctImpId >= 0 { ctImpId } else { lookupLocalCtVal("$mod:" + tModKey + "." + mName) };
                if ctTargetId >= 0 {
                    return evalPostfixChain(source, mEnd, limitPos, prefix, ctTargetId, "", mut frame, mut budget);
                }
                _unused := modRt;
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown compile-time value " + name + "." + mName }, next = mEnd);
            }

            /* Record constructor `TypeName { ... }` or `TypeName<...>{ ... }` or enum/type-op `TypeName.Op` */
            alIdx := types.findAlias(frame.aliases, name);
            var gtTypePos := -1;
            if alIdx >= 0 and afterName < limitPos and source.at(afterName) == "<" {
                gtTypePos = findBalancedAngleEnd(source, afterName, limitPos);
            }
            afterTypeExpr := if gtTypePos > 0 { syntax.skipTrivia(source, gtTypePos, prefix) } else { afterName };
            typeExprSlice := if gtTypePos > 0 { source.slice(start, gtTypePos) } else { name };
            if alIdx >= 0 and afterTypeExpr < limitPos and source.at(afterTypeExpr) == "{" {
                recT := resolveCtTypeAt(typeExprSlice, 0, prefix, frame.aliases);
                if not recT.ok {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time record type " + typeExprSlice }, next = afterTypeExpr);
                }
                recR := evalRecordLiteralAt(source, afterTypeExpr, limitPos, prefix, recT.kind, mut frame, mut budget);
                if recR.outcome.flow =!= FLOW_NONE { return recR; }
                res = recR.outcome;
                resNext = recR.next;
            } else if alIdx >= 0 and afterTypeExpr < limitPos and source.at(afterTypeExpr) == "." {
                nomT := resolveCtTypeAt(typeExprSlice, 0, prefix, frame.aliases);
                if not nomT.ok {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time type " + typeExprSlice }, next = afterTypeExpr);
                }
                nomK := nomT.kind;
                opS := syntax.skipTrivia(source, afterTypeExpr + 1, prefix);
                opE := source.skipName(opS);
                opName := source.slice(opS, opE);
                afterOp := syntax.skipTrivia(source, opE, prefix);
                if afterOp < limitPos and source.at(afterOp) == "(" {
                    callA := evalCallArgs(source, afterOp, prefix, mut frame, mut budget);
                    if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                    resNext = callA.next;
                    if types.isEnumKind(nomK) and types.enumCaseIndex(nomK, opName) >= 0 {
                        ci := types.enumCaseIndex(nomK, opName);
                        res = CtOutcome { ok = true, valId = makeEnumVal(nomK, ci, opName, callA.args, mut budget), flow = FLOW_NONE, error = "" };
                    } else {
                        cands := findFnIndicesInModule(frame.moduleKey, name + "." + opName);
                        dispN := baseNominalName(nomK);
                        candsDisp := if cands.length() > 0 or dispN == "" { cands } else { findFnIndicesInModule(frame.moduleKey, dispN + "." + opName) };
                        cands2 := if candsDisp.length() > 0 { candsDisp } else { findFnIndicesInModule("lib$core$text", name + "." + opName) };
                        cands3 := if cands2.length() > 0 { cands2 } else { findFnIndicesInModule("lib_s_core_s_text", name + "." + opName) };
                        chosen := selectOverloadFnDef(cands3, callA.args.length() - callA.labels.length(), callA.labels);
                        res = invokeCtFnDefWithTypeArgs(chosen, splitCanonicalNominalArgs(nomK), callA.args, callA.labels, mut budget);
                    }
                } else if types.isEnumKind(nomK) {
                    ci := types.enumCaseIndex(nomK, opName);
                    resNext = opE;
                    res = CtOutcome { ok = true, valId = makeEnumVal(nomK, ci, opName, [], mut budget), flow = FLOW_NONE, error = "" };
                } else {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown compile-time static member " + name + "." + opName }, next = opE);
                }
            } else if afterName < limitPos and (source.at(afterName) == "(" or source.at(afterName) == "<") {
                /* Local fn binding or module function call, possibly `f<...>(...)` */
                var argParen := afterName;
                var matchedGenericCall := source.at(afterName) == "(";
                mut explicitCallTypeArgs: List<String> = [];
                if source.at(afterName) == "<" {
                    gt := findBalancedAngleEnd(source, afterName, limitPos);
                    if gt > 0 {
                        afterGt := syntax.skipTrivia(source, gt, prefix);
                        if afterGt < limitPos and source.at(afterGt) == "(" {
                            argParen = afterGt;
                            matchedGenericCall = true;
                            var tCur := afterName + 1;
                            tLimit := gt - 1;
                            loop tCur < tLimit {
                                var segEnd := tCur;
                                var segDepth := 0;
                                loop segEnd < tLimit {
                                    sc := source.at(segEnd);
                                    if sc == "<" or sc == "(" or sc == "[" { segDepth = segDepth + 1; }
                                    else if sc == ">" or sc == ")" or sc == "]" { if segDepth > 0 { segDepth = segDepth - 1; } }
                                    else if sc == "," and segDepth == 0 { break; }
                                    segEnd = segEnd + 1;
                                }
                                segSrc := source.slice(tCur, segEnd).trim();
                                if segSrc =!= "" {
                                    tTry := resolveCtTypeAt(segSrc, 0, prefix, frame.aliases);
                                    if tTry.ok and syntax.skipTrivia(segSrc, tTry.next, prefix) == segSrc.length() {
                                        mut explicitCallTypeArgs.pushBack(tTry.kind);
                                    } else {
                                        vTry := evalExprAt(segSrc, 0, segSrc.length(), prefix, "", mut frame, mut budget);
                                        if vTry.outcome.ok and vTry.outcome.flow == FLOW_NONE {
                                            tok := comptimeValToken(ctPool[vTry.outcome.valId].kind, vTry.outcome.valId);
                                            mut explicitCallTypeArgs.pushBack(if tok.startsWithAt(0, "$Val:") { tok.slice(5, tok.length()) } else { ctPool[vTry.outcome.valId].kind });
                                        }
                                    }
                                }
                                tCur = if segEnd < tLimit { segEnd + 1 } else { segEnd };
                            }
                        }
                    }
                }
                bIdx := frameFindBinding(frame, name);
                cands := findFnIndicesInModule(frame.moduleKey, name);
                if matchedGenericCall and (bIdx >= 0 or cands.length() > 0) {
                    callA := evalCallArgs(source, argParen, prefix, mut frame, mut budget);
                    if not callA.ok { return (outcome = callA.outcome, next = callA.next); }
                    resNext = callA.next;
                    if bIdx >= 0 and ctPool[frame.bindings[bIdx].valId].tag == TAG_FN {
                        rtIdx := ctFnIdxByRt.get(ctPool[frame.bindings[bIdx].valId].strVal);
                        res = invokeCtFnDefWithTypeArgs(if rtIdx.found { rtIdx.value } else { -1 }, explicitCallTypeArgs, callA.args, callA.labels, mut budget);
                    } else if cands.length() > 0 {
                        chosen := selectOverloadFnDef(cands, callA.args.length() - callA.labels.length(), callA.labels);
                        res = invokeCtFnDefWithTypeArgs(chosen, explicitCallTypeArgs, callA.args, callA.labels, mut budget);
                    }
                } else if bIdx >= 0 {
                    resNext = nEnd;
                    res = CtOutcome { ok = true, valId = frame.bindings[bIdx].valId, flow = FLOW_NONE, error = "" };
                    baseName = name;
                } else {
                    modVal := lookupLocalCtVal("$mod:" + frame.moduleKey + "." + name);
                    if modVal >= 0 {
                        resNext = nEnd;
                        res = CtOutcome { ok = true, valId = modVal, flow = FLOW_NONE, error = "" };
                        baseName = name;
                    } else {
                        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown or runtime value " + name + " in compile-time expression" }, next = nEnd);
                    }
                }
            } else {
                bIdx := frameFindBinding(frame, name);
                if bIdx >= 0 {
                    resNext = nEnd;
                    res = CtOutcome { ok = true, valId = frame.bindings[bIdx].valId, flow = FLOW_NONE, error = "" };
                    baseName = name;
                } else {
                    modVal := lookupLocalCtVal("$mod:" + frame.moduleKey + "." + name);
                    if modVal >= 0 {
                        resNext = nEnd;
                        res = CtOutcome { ok = true, valId = modVal, flow = FLOW_NONE, error = "" };
                        baseName = name;
                    } else {
                        sameFns := findFnIndicesInModule(frame.moduleKey, name);
                        if sameFns.length() > 0 {
                            def := ctFnDefs[sameFns[0]];
                            resNext = nEnd;
                            res = CtOutcome { ok = true, valId = makeFnRefVal("", def.runtime, mut budget), flow = FLOW_NONE, error = "" };
                        } else {
                            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unknown or runtime value " + name + " in compile-time expression" }, next = nEnd);
                        }
                    }
                }
            }
        }
    } else {
        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "unsupported token in compile-time expression: " + ch }, next = start + 1);
    }
    if res.flow =!= FLOW_NONE { return (outcome = res, next = resNext); }
    evalPostfixChain(source, resNext, limitPos, prefix, res.valId, baseName, mut frame, mut budget)
};

/** Evaluates a record literal `{ field = v, =shorthand, ... }` including declaration-order dependent defaults. */
evalRecordLiteralAt := fn(source: String, openBrace: Int, limitPos: Int, prefix: String, recordKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    var cursor := syntax.skipTrivia(source, openBrace + 1, prefix);
    compCount := types.recordComponentCount(recordKind);
    mut supMap: Map<String, Int>;
    loop cursor < limitPos and source.at(cursor) =!= "}" {
        if syntax.isSingleEquals(source, cursor) {
            shS := syntax.skipTrivia(source, cursor + 1, prefix);
            shE := source.skipName(shS);
            kName := source.slice(shS, shE);
            fKind := types.recordFieldKind(recordKind, kName);
            ev := evalExprAt(source, shS, limitPos, prefix, fKind, mut frame, mut budget);
            if ev.outcome.flow =!= FLOW_NONE { return ev; }
            mut supMap.set(kName, coerceCtValue(fKind, ctPool[ev.outcome.valId].kind, cloneValIfContainer(ev.outcome.valId, "", mut budget), mut budget));
            cursor = syntax.skipTrivia(source, ev.next, prefix);
        } else {
            kS := cursor;
            kE := source.skipName(kS);
            kName := source.slice(kS, kE);
            eqP := syntax.skipTrivia(source, kE, prefix);
            fKind := types.recordFieldKind(recordKind, kName);
            ev := evalExprAt(source, eqP + 1, limitPos, prefix, fKind, mut frame, mut budget);
            if ev.outcome.flow =!= FLOW_NONE { return ev; }
            mut supMap.set(kName, coerceCtValue(fKind, ctPool[ev.outcome.valId].kind, cloneValIfContainer(ev.outcome.valId, "", mut budget), mut budget));
            cursor = syntax.skipTrivia(source, ev.next, prefix);
        }
        if cursor < limitPos and (source.at(cursor) == "," or source.at(cursor) == ";") {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else { break; }
    }
    endPos := if cursor < limitPos and source.at(cursor) == "}" { cursor + 1 } else { cursor };
    mut fieldVals: List<Int> = [];
    mut fieldNames: List<String> = [];
    var ci := 0;
    loop ci < compCount {
        comp := types.recordComponent(recordKind, ci);
        mut fieldNames.pushBack(comp.label);
        got := supMap.get(comp.label);
        if got.found {
            mut fieldVals.pushBack(got.value);
        } else {
            mut fieldVals.pushBack(makeZeroCtVal(comp.kind, mut budget, frame.aliases, frame.moduleKey));
        }
        ci = ci + 1;
    }
    /* Apply Error.kind default `"Error"` when omitted */
    if recordKind == types.CORE_ERROR_KIND and not supMap.has("kind") and compCount > 0 {
        mut fieldVals.setAt(0, makeStrVal("Error", "", mut budget));
    }
    (outcome = CtOutcome { ok = true, valId = makeRecordVal(recordKind, fieldVals, fieldNames, mut budget), flow = FLOW_NONE, error = "" }, next = endPos)
};

/** Evaluates an inferred structural record literal `{}` or `{ "k"[: T] = v, k[: T] = v, =shorthand }` in written order and sorts fields into canonical `Record<$anon;...>` order. */
evalInferredRecordLiteralAt := fn(source: String, openBrace: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    expRec := if types.isAnonRecordKind(expectedKind) { expectedKind } else { "" };
    var cursor := syntax.skipTrivia(source, openBrace + 1, prefix);
    if cursor < limitPos and source.at(cursor) == "}" {
        emptyK := types.buildAnonRecordKind([]);
        return (outcome = CtOutcome { ok = true, valId = makeRecordVal(emptyK, [], [], mut budget), flow = FLOW_NONE, error = "" }, next = cursor + 1);
    }
    if cursor >= limitPos {
        return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "expected } in record literal" }, next = openBrace);
    }
    if not syntax.isSingleEquals(source, cursor) and source.at(cursor) =!= "\"" {
        var looksLikeRec := false;
        if source.at(cursor).isNameStart() {
            fE := source.skipName(cursor);
            fLbl := source.slice(cursor, fE);
            fAfter := syntax.skipTrivia(source, fE, prefix);
            if not syntax.isReservedWord(fLbl) and fAfter < limitPos and (syntax.isSingleEquals(source, fAfter) or (source.at(fAfter) == ":" and not source.startsWithAt(fAfter, ":="))) {
                looksLikeRec = true;
            }
        }
        if not looksLikeRec {
            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "standalone block expressions must use do { ... }" }, next = openBrace);
        }
    }
    mut fieldSpecs: List<(label: String, kind: String)> = [];
    mut supMap: Map<String, Int>;
    loop cursor < limitPos and source.at(cursor) =!= "}" {
        var kName := "";
        var explicitKind := "";
        var valPos := cursor;
        if syntax.isSingleEquals(source, cursor) {
            shS := syntax.skipTrivia(source, cursor + 1, prefix);
            shE := source.skipName(shS);
            kName = source.slice(shS, shE);
            valPos = shS;
        } else if source.at(cursor) == "\"" {
            qStr := syntax.parseText(ir.TARGET_TS, source, cursor, prefix);
            kName = qStr.textValue;
            afterQ := syntax.skipTrivia(source, qStr.next, prefix);
            if afterQ < limitPos and source.at(afterQ) == ":" and not source.startsWithAt(afterQ, ":=") {
                tyR := resolveCtTypeAt(source, syntax.skipTrivia(source, afterQ + 1, prefix), prefix, frame.aliases);
                if not tyR.ok {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve record field type" }, next = afterQ);
                }
                explicitKind = tyR.kind;
                eqP := syntax.skipTrivia(source, tyR.next, prefix);
                valPos = syntax.skipTrivia(source, eqP + 1, prefix);
            } else {
                valPos = syntax.skipTrivia(source, afterQ + 1, prefix);
            }
        } else {
            kE := source.skipName(cursor);
            kName = source.slice(cursor, kE);
            afterK := syntax.skipTrivia(source, kE, prefix);
            if afterK < limitPos and source.at(afterK) == ":" and not source.startsWithAt(afterK, ":=") {
                tyR := resolveCtTypeAt(source, syntax.skipTrivia(source, afterK + 1, prefix), prefix, frame.aliases);
                if not tyR.ok {
                    return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve record field type" }, next = afterK);
                }
                explicitKind = tyR.kind;
                eqP := syntax.skipTrivia(source, tyR.next, prefix);
                valPos = syntax.skipTrivia(source, eqP + 1, prefix);
            } else {
                valPos = syntax.skipTrivia(source, afterK + 1, prefix);
            }
        }
        if supMap.has(kName) {
            return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "duplicate record field " + kName }, next = cursor);
        }
        hintKind := if explicitKind =!= "" { explicitKind } else if expRec =!= "" { types.recordFieldKind(expRec, kName) } else { "" };
        ev := evalExprAt(source, valPos, limitPos, prefix, hintKind, mut frame, mut budget);
        if ev.outcome.flow =!= FLOW_NONE { return ev; }
        vId := cloneValIfContainer(ev.outcome.valId, "", mut budget);
        vKind := if explicitKind =!= "" { explicitKind } else { ctPool[vId].kind };
        cVal := if explicitKind =!= "" { coerceCtValue(explicitKind, ctPool[vId].kind, vId, mut budget) } else { vId };
        mut fieldSpecs.pushBack((label = kName, kind = vKind));
        mut supMap.set(kName, cVal);
        cursor = syntax.skipTrivia(source, ev.next, prefix);
        if cursor < limitPos and (source.at(cursor) == "," or source.at(cursor) == ";") {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else { break; }
    }
    endPos := if cursor < limitPos and source.at(cursor) == "}" { cursor + 1 } else { cursor };
    recKind := types.buildAnonRecordKind(fieldSpecs);
    compCount := types.recordComponentCount(recKind);
    mut fieldVals: List<Int> = [];
    mut fieldNames: List<String> = [];
    var ci := 0;
    loop ci < compCount {
        comp := types.recordComponent(recKind, ci);
        mut fieldNames.pushBack(comp.label);
        got := supMap.get(comp.label);
        mut fieldVals.pushBack(got.value);
        ci = ci + 1;
    }
    (outcome = CtOutcome { ok = true, valId = makeRecordVal(recKind, fieldVals, fieldNames, mut budget), flow = FLOW_NONE, error = "" }, next = endPos)
};

/** Precedence-climbing expression evaluator (`minimum` precedence), handling `: Type`, `else`, comparisons, `and`/`or`, and arithmetic. */
evalExprWithMin := fn(source: String, startPos: Int, limitPos: Int, prefix: String, expectedKind: String, minimum: Int, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    effMin := if minimum < 0 { 0 } else { minimum };
    var cursor := syntax.skipTrivia(source, startPos, prefix);
    var leader := "";
    if effMin == 0 and (source.wordAt(cursor, "and") or source.wordAt(cursor, "or")) {
        le := source.skipName(cursor);
        leader = source.slice(cursor, le);
        cursor = syntax.skipTrivia(source, le, prefix);
    }
    prim := evalPrimaryAt(source, cursor, limitPos, prefix, expectedKind, mut frame, mut budget);
    if prim.outcome.flow =!= FLOW_NONE { return prim; }
    var left := prim.outcome;
    var leftNext := prim.next;
    loop true {
        opPos := syntax.skipTrivia(source, leftNext, prefix);
        if opPos >= limitPos { break; }
        /* Result `else(err) { ... }` / `else { ... }` lazy recovery */
        if effMin <= 1 and ctPool[left.valId].tag == TAG_RESULT and source.wordAt(opPos, "else") {
            afterElse := syntax.skipTrivia(source, opPos + 4, prefix);
            var errBind := "";
            var bracePos := afterElse;
            if afterElse < limitPos and source.at(afterElse) == "(" {
                bS := syntax.skipTrivia(source, afterElse + 1, prefix);
                bE := source.skipName(bS);
                errBind = source.slice(bS, bE);
                cP := syntax.skipTrivia(source, bE, prefix);
                bracePos = syntax.skipTrivia(source, cP + 1, prefix);
            }
            if bracePos < limitPos and source.at(bracePos) == "{" {
                resClose := syntax.scanBraceEnd(source, bracePos, prefix);
                lc := ctPool[left.valId];
                if lc.intVal == 0 {
                    /* Success branch: skip lazy handler completely */
                    left = CtOutcome { ok = true, valId = if lc.children.length() > 0 { lc.children[0] } else { makeUnitVal(mut budget) }, flow = FLOW_NONE, error = "" };
                    leftNext = resClose;
                    continue;
                }
                /* Error branch: evaluate recovery handler */
                savedLen := frame.bindings.length();
                if errBind =!= "" and lc.children.length() > 0 {
                    eId := lc.children[0];
                    mut frame.bindings.pushBack(CtBinding { name = errBind, valId = eId, mutable = false, kind = ctPool[eId].kind });
                }
                hR := evalBracedBlock(source, bracePos, prefix, "", mut frame, mut budget);
                loop frame.bindings.length() > savedLen { _p := mut frame.bindings.popBack(); }
                if hR.outcome.flow =!= FLOW_NONE { return (outcome = hR.outcome, next = resClose); }
                okK := types.resultOkKind(lc.kind);
                hk := ctPool[hR.outcome.valId].kind;
                joinedK := types.joinBranchKind(okK, hk);
                left = CtOutcome { ok = true, valId = coerceCtValue(if joinedK =!= "" { joinedK } else { hk }, hk, hR.outcome.valId, mut budget), flow = FLOW_NONE, error = "" };
                leftNext = resClose;
                continue;
            }
        }
        /* Value type test `expr : Type` */
        if effMin <= 8 and source.at(opPos) == ":" and not source.startsWithAt(opPos, ":=") and not source.startsWithAt(opPos, ":/") and not source.startsWithAt(opPos, ":%") {
            tyR := resolveCtTypeAt(source, opPos + 1, prefix, frame.aliases);
            if not tyR.ok {
                return (outcome = CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "cannot resolve compile-time type test" }, next = opPos + 1);
            }
            matched := valueMatchesType(left.valId, tyR.kind);
            left = CtOutcome { ok = true, valId = makeBoolVal(matched, "", mut budget), flow = FLOW_NONE, error = "" };
            leftNext = tyR.next;
            continue;
        }
        op := syntax.readOperator(source, opPos);
        if op.text == "" { break; }
        lvl := syntax.operatorLevel(op.text);
        if lvl < effMin { break; }
        if opPos > 0 and leftNext > 0 and source.at(leftNext - 1) == "}" { break; }
        rightMin := if op.text == "**" { lvl } else { lvl + 1 };

        if op.text == "and" or op.text == "or" {
            isTrue := ctPool[left.valId].intVal =!= 0;
            if op.text == "and" and not isTrue {
                /* Short-circuit right operand syntax scan without executing side effects */
                rhsScan := evalExprSkip(source, opPos + op.width, limitPos, prefix, rightMin);
                left = CtOutcome { ok = true, valId = makeBoolVal(false, "", mut budget), flow = FLOW_NONE, error = "" };
                leftNext = rhsScan;
                continue;
            }
            if op.text == "or" and isTrue {
                rhsScan := evalExprSkip(source, opPos + op.width, limitPos, prefix, rightMin);
                left = CtOutcome { ok = true, valId = makeBoolVal(true, "", mut budget), flow = FLOW_NONE, error = "" };
                leftNext = rhsScan;
                continue;
            }
            rightR := self(source, opPos + op.width, limitPos, prefix, ir.VALUE_KIND_BOOL, rightMin, mut frame, mut budget);
            if rightR.outcome.flow =!= FLOW_NONE { return rightR; }
            left = rightR.outcome;
            leftNext = rightR.next;
            continue;
        }

        if syntax.isComparison(op.text) {
            rightR := self(source, opPos + op.width, limitPos, prefix, "", rightMin, mut frame, mut budget);
            if rightR.outcome.flow =!= FLOW_NONE { return rightR; }
            var chainOk := evalComparisonOp(op.text, left.valId, rightR.outcome.valId);
            var prevVal := rightR.outcome.valId;
            var curEnd := rightR.next;
            loop true {
                np := syntax.skipTrivia(source, curEnd, prefix);
                if np >= limitPos { break; }
                nop := syntax.comparisonOperatorAt(source, np);
                if not syntax.isComparison(nop.text) { break; }
                if chainOk {
                    nextR := self(source, np + nop.width, limitPos, prefix, "", lvl + 1, mut frame, mut budget);
                    if nextR.outcome.flow =!= FLOW_NONE { return nextR; }
                    chainOk = evalComparisonOp(nop.text, prevVal, nextR.outcome.valId);
                    prevVal = nextR.outcome.valId;
                    curEnd = nextR.next;
                } else {
                    curEnd = evalExprSkip(source, np + nop.width, limitPos, prefix, lvl + 1);
                }
            }
            left = CtOutcome { ok = true, valId = makeBoolVal(chainOk, "", mut budget), flow = FLOW_NONE, error = "" };
            leftNext = curEnd;
            continue;
        }

        rightR := self(source, opPos + op.width, limitPos, prefix, "", rightMin, mut frame, mut budget);
        if rightR.outcome.flow =!= FLOW_NONE { return rightR; }
        ap := applyBinaryVal(op.text, left.valId, rightR.outcome.valId, mut budget);
        if ap.flow =!= FLOW_NONE { return (outcome = ap, next = rightR.next); }
        left = ap;
        leftNext = rightR.next;
    }
    _unusedLeader := leader;
    (outcome = left, next = leftNext)
};

/** Evaluates one full expression at precedence 0. */
evalExprAt := fn(source: String, startPos: Int, limitPos: Int, prefix: String, expectedKind: String, frame: mut CtFrame, budget: mut EvalBudget): (outcome: CtOutcome, next: Int) {
    evalExprWithMin(source, startPos, limitPos, prefix, expectedKind, 0, mut frame, mut budget)
};

/** Advances past an unevaluated short-circuited RHS expression without executing it. */
evalExprSkip := fn(source: String, startPos: Int, limitPos: Int, prefix: String, minLvl: Int): Int {
    var cursor := syntax.skipTrivia(source, startPos, prefix);
    loop cursor < limitPos {
        ch := source.at(cursor);
        if ch == "\"" { cursor = syntax.skipAliasString(source, cursor); continue; }
        if ch == "/" and cursor + 1 < limitPos and (source.at(cursor + 1) == "/" or source.at(cursor + 1) == "*") {
            cursor = syntax.skipComment(source, cursor, prefix);
            continue;
        }
        if ch == "(" { cursor = syntax.scanParenEnd(source, cursor, prefix); continue; }
        if ch == "[" { cursor = syntax.scanBracketEnd(source, cursor, prefix); continue; }
        if ch == "{" { cursor = syntax.scanBraceEnd(source, cursor, prefix); continue; }
        if ch == ";" or ch == "," or ch == ")" or ch == "]" or ch == "}" { break; }
        op := syntax.readOperator(source, cursor);
        if op.text =!= "" and syntax.operatorLevel(op.text) < minLvl { break; }
        if source.wordAt(cursor, "if") { cursor = syntax.scanIfChainEnd(source, cursor, prefix, false, true); continue; }
        if source.wordAt(cursor, "match") { cursor = syntax.scanValueMatchEnd(source, cursor, prefix, false); continue; }
        if source.wordAt(cursor, "loop") { cursor = syntax.scanRawLoopEnd(source, cursor, prefix); continue; }
        if ch.isNameStart() { cursor = source.skipName(cursor); continue; }
        cursor = cursor + 1;
    }
    cursor
};

/** Evaluates an explicit `comptime { ... }` block starting at `openBrace` with host effects permitted. */
pub evalBlock := fn(source: String, openBrace: Int, prefix: String, modKey: String, expectedKind: String,
aliases: List<AliasDecl>, visibleBindings: List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)>): CtOutcome {
    ctBudgetPanic = "";
    mut budget := EvalBudget {
        maxSteps = DEFAULT_MAX_STEPS, steps = 0,
        maxNewCells = DEFAULT_MAX_NEW_CELLS, baseCells = ctPool.length(),
        maxDepth = DEFAULT_MAX_DEPTH, depth = 0,
        allowEffects = true, speculative = false
    };
    mut bindings: List<CtBinding> = [];
    loop visibleBindings as vb {
        vid := lookupLocalCtVal(vb.runtime);
        if vid >= 0 {
            mut bindings.pushBack(CtBinding { name = vb.name, valId = vid, mutable = false, kind = vb.kind });
        } else if vb.constant {
            cVid := if vb.kind == ir.VALUE_KIND_BOOL {
                makeBoolVal(vb.intValue =!= 0, vb.kind, mut budget)
            } else if vb.kind == ir.VALUE_KIND_STRING {
                makeStrVal(vb.textValue, vb.kind, mut budget)
            } else if numeric.isIntKind(vb.kind) {
                makeIntVal(vb.intValue, vb.kind, mut budget)
            } else if types.isEnumKind(vb.kind) {
                makeEnumVal(vb.kind, vb.intValue, types.enumCaseAt(vb.kind, vb.intValue).name, [], mut budget)
            } else { -1 };
            if cVid >= 0 {
                mut bindings.pushBack(CtBinding { name = vb.name, valId = cVid, mutable = false, kind = vb.kind });
            }
        }
    }
    blkFlags := syntax.scanBlockFastFlags(source, openBrace, prefix);
    blockAliases := if blkFlags.hasAliasKw {
        types.collectBlockTypeAliases(source, openBrace, prefix, types.maxAliasDepth(aliases) + 1, aliases)
    } else { aliases };
    mut frame := CtFrame {
        bindings = bindings, fnResultKind = expectedKind, moduleKey = modKey,
        aliases = blockAliases, loopCount = -1, loopIndex = 0, loopItemId = -1, hasLoopItem = false, activeTag = ""
    };
    closeBrace := syntax.scanBraceEnd(source, openBrace, prefix);
    res := evalStmtRange(source, openBrace + 1, closeBrace - 1, prefix, expectedKind, mut frame, mut budget);
    if ctBudgetPanic =!= "" {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = ctBudgetPanic };
    }
    if res.flow == FLOW_PANIC { return res; }
    if res.flow == FLOW_RETURN or res.flow == FLOW_PROP_ERR or res.flow == FLOW_BREAK or res.flow == FLOW_CONTINUE {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "control flow " + res.flow + " cannot escape comptime block" };
    }
    res
};

/** Evaluates one pure Stage-1 `.lt` initializer expression `[exprStart, exprEnd)` (rejecting effects and runtime dependencies). */
pub evalExprPure := fn(source: String, exprStart: Int, exprEnd: Int, prefix: String, modKey: String, expectedKind: String,
aliases: List<AliasDecl>, visibleBindings: List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)>): CtOutcome {
    ctBudgetPanic = "";
    mut budget := EvalBudget {
        maxSteps = DEFAULT_MAX_STEPS, steps = 0,
        maxNewCells = DEFAULT_MAX_NEW_CELLS, baseCells = ctPool.length(),
        maxDepth = DEFAULT_MAX_DEPTH, depth = 0,
        allowEffects = false, speculative = false
    };
    mut bindings: List<CtBinding> = [];
    loop visibleBindings as vb {
        if isMutableGlobalRuntime(vb.runtime) { continue; }
        vid := lookupLocalCtVal(vb.runtime);
        if vid >= 0 {
            mut bindings.pushBack(CtBinding { name = vb.name, valId = vid, mutable = false, kind = vb.kind });
        } else if vb.constant {
            cVid := if vb.kind == ir.VALUE_KIND_BOOL {
                makeBoolVal(vb.intValue =!= 0, vb.kind, mut budget)
            } else if vb.kind == ir.VALUE_KIND_STRING {
                makeStrVal(vb.textValue, vb.kind, mut budget)
            } else if numeric.isIntKind(vb.kind) {
                makeIntVal(vb.intValue, vb.kind, mut budget)
            } else if types.isEnumKind(vb.kind) {
                makeEnumVal(vb.kind, vb.intValue, types.enumCaseAt(vb.kind, vb.intValue).name, [], mut budget)
            } else { -1 };
            if cVid >= 0 {
                mut bindings.pushBack(CtBinding { name = vb.name, valId = cVid, mutable = false, kind = vb.kind });
            }
        }
    }
    mut frame := CtFrame {
        bindings = bindings, fnResultKind = expectedKind, moduleKey = modKey,
        aliases = aliases, loopCount = -1, loopIndex = 0, loopItemId = -1, hasLoopItem = false, activeTag = ""
    };
    ev := evalExprAt(source, exprStart, exprEnd, prefix, expectedKind, mut frame, mut budget);
    if ctBudgetPanic =!= "" {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = ctBudgetPanic };
    }
    if ev.outcome.flow =!= FLOW_NONE { return ev.outcome; }
    if expectedKind =!= "" {
        cId := coerceCtValue(expectedKind, ctPool[ev.outcome.valId].kind, ev.outcome.valId, mut budget);
        return CtOutcome { ok = true, valId = cId, flow = FLOW_NONE, error = "" };
    }
    ev.outcome
};

/** Best-effort pure evaluation for `.lts` / function-local immutable bindings (returns `ok = false` silently if effectful or runtime-dependent). */
pub tryEvalPureSpeculative := fn(source: String, exprStart: Int, exprEnd: Int, prefix: String, modKey: String, expectedKind: String,
aliases: List<AliasDecl>, visibleBindings: List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)>): CtOutcome {
    eff := checkExprEffects(source, exprStart, exprEnd, prefix, modKey);
    if not eff.pure {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "" };
    }
    ctBudgetPanic = "";
    mut budget := EvalBudget {
        maxSteps = SPEC_MAX_STEPS, steps = 0,
        maxNewCells = SPEC_MAX_NEW_CELLS, baseCells = ctPool.length(),
        maxDepth = SPEC_MAX_DEPTH, depth = 0,
        allowEffects = false, speculative = true
    };
    mut bindings: List<CtBinding> = [];
    loop visibleBindings as vb {
        if isMutableGlobalRuntime(vb.runtime) { continue; }
        vid := lookupLocalCtVal(vb.runtime);
        if vid >= 0 {
            mut bindings.pushBack(CtBinding { name = vb.name, valId = vid, mutable = false, kind = vb.kind });
        } else if vb.constant {
            cVid := if vb.kind == ir.VALUE_KIND_BOOL {
                makeBoolVal(vb.intValue =!= 0, vb.kind, mut budget)
            } else if vb.kind == ir.VALUE_KIND_STRING {
                makeStrVal(vb.textValue, vb.kind, mut budget)
            } else if numeric.isIntKind(vb.kind) {
                makeIntVal(vb.intValue, vb.kind, mut budget)
            } else if types.isEnumKind(vb.kind) {
                makeEnumVal(vb.kind, vb.intValue, types.enumCaseAt(vb.kind, vb.intValue).name, [], mut budget)
            } else { -1 };
            if cVid >= 0 {
                mut bindings.pushBack(CtBinding { name = vb.name, valId = cVid, mutable = false, kind = vb.kind });
            }
        }
    }
    mut frame := CtFrame {
        bindings = bindings, fnResultKind = expectedKind, moduleKey = modKey,
        aliases = aliases, loopCount = -1, loopIndex = 0, loopItemId = -1, hasLoopItem = false, activeTag = ""
    };
    ev := evalExprAt(source, exprStart, exprEnd, prefix, expectedKind, mut frame, mut budget);
    ctBudgetPanic = "";
    if ev.outcome.flow =!= FLOW_NONE or not ev.outcome.ok {
        return CtOutcome { ok = false, valId = -1, flow = FLOW_PANIC, error = "" };
    }
    if expectedKind =!= "" {
        cId := coerceCtValue(expectedKind, ctPool[ev.outcome.valId].kind, ev.outcome.valId, mut budget);
        return CtOutcome { ok = true, valId = cId, flow = FLOW_NONE, error = "" };
    }
    ev.outcome
};

/** Returns a `$Val:` alias token for discrete compile-time values (`Int`, `Bool`, `String`, plain `Enum`), or `""`. */
pub comptimeValToken := fn(kind: String, valId: Int): String {
    if valId < 0 or valId >= ctPool.length() { return ""; }
    c := ctPool[valId];
    if kind == ir.VALUE_KIND_INT and c.tag == TAG_INT { return "$Val:" + types.comptimeIntToken(c.intVal); }
    if kind == ir.VALUE_KIND_BOOL and c.tag == TAG_BOOL { return "$Val:" + types.comptimeBoolToken(c.intVal =!= 0); }
    if kind == ir.VALUE_KIND_STRING and c.tag == TAG_STR { return "$Val:" + types.comptimeStringToken(c.strVal); }
    if types.isEnumKind(kind) and not types.isPayloadEnumKind(kind) and c.tag == TAG_ENUM {
        return "$Val:" + types.comptimeEnumToken(kind, c.intVal);
    }
    ""
};

/** True when canonical type `kind` can be embedded from compile time into the compiled program. */
pub isMaterializableKind := fn(kind: String): Bool {
    if kind == "" or kind == ir.VALUE_KIND_NEVER { return false; }
    if types.isSliceKind(kind) or types.isDynKind(kind) or types.isRcKind(kind) or types.isSoaKind(kind) or types.isFnKind(kind) {
        return false;
    }
    if types.isDistinctKind(kind) {
        dName := types.distinctDisplayName(kind);
        if (dName == "Reader" or dName == "Writer") and (kind.contains("core$io#") or kind.contains("core_s_io#") or kind.contains("core/io#")) {
            return false;
        }
        return self(types.distinctUnderlyingKind(kind));
    }
    if kind == ir.VALUE_KIND_UNIT or kind == ir.VALUE_KIND_BOOL or kind == ir.VALUE_KIND_STRING or numeric.isNumericKind(kind) {
        return true;
    }
    if types.isEnumKind(kind) {
        cnt := types.enumCaseCount(kind);
        var ci := 0;
        loop ci < cnt {
            pc := types.enumCasePayloadCount(kind, ci);
            var pi := 0;
            loop pi < pc {
                if not self(types.enumCasePayloadKind(kind, ci, pi)) { return false; }
                pi = pi + 1;
            }
            ci = ci + 1;
        }
        return true;
    }
    if types.isTupleKind(kind) {
        cnt := types.tupleComponentCount(kind);
        var i := 0;
        loop i < cnt {
            if not self(types.tupleComponent(kind, i).kind) { return false; }
            i = i + 1;
        }
        return true;
    }
    if types.isRecordKind(kind) {
        cnt := types.recordComponentCount(kind);
        var i := 0;
        loop i < cnt {
            if not self(types.recordComponent(kind, i).kind) { return false; }
            i = i + 1;
        }
        return true;
    }
    if types.isListKind(kind) { return self(types.listElementKind(kind)); }
    if types.isArrayKind(kind) { return self(types.arrayElementKind(kind)); }
    if types.isMapKind(kind) { return self(types.mapKeyKind(kind)) and self(types.mapValueKind(kind)); }
    if types.isSetKind(kind) { return self(types.setElementKind(kind)); }
    if types.isUnionKind(kind) {
        loop types.unionMembers(kind) as m {
            if not self(m) { return false; }
        }
        return true;
    }
    if types.isResultKind(kind) {
        return self(types.resultOkKind(kind)) and self(types.resultErrKind(kind));
    }
    false
};

/** Materializes one compile-time value `valId` of canonical `kind` into identical owned TS or C11 target expression code. */
pub materializeValue := fn(target: String, kind: String, valId: Int): (code: String, constant: Bool, intValue: Int, textValue: String) {
    c := ctPool[valId];
    if types.isDistinctKind(kind) {
        baseK := types.distinctUnderlyingKind(kind);
        return self(target, baseK, valId);
    }
    if kind == ir.VALUE_KIND_UNIT {
        return (code = ir.targetUnitLiteralCode(target), constant = true, intValue = 0, textValue = "");
    }
    if kind == ir.VALUE_KIND_BOOL {
        b := c.intVal =!= 0;
        return (code = ir.targetBoolLiteralCode(target, b), constant = true, intValue = if b { 1 } else { 0 }, textValue = "");
    }
    if kind == ir.VALUE_KIND_STRING {
        return (code = ir.targetTextLiteralCode(target, c.strVal), constant = true, intValue = 0, textValue = c.strVal);
    }
    if numeric.isUnsignedIntKind(kind) {
        code := ir.targetUIntLiteralCode(target, c.strVal);
        return (code = if numeric.isNarrowUnsignedIntKind(kind) and target == ir.TARGET_C { "((uint" + (if kind == ir.VALUE_KIND_UINT16 { "16" } else if kind == ir.VALUE_KIND_UINT32 { "32" } else { "8" }) + "_t)(" + code + "))" } else { code }, constant = false, intValue = 0, textValue = c.strVal);
    }
    if numeric.isIntKind(kind) {
        v := c.intVal;
        neg := v < 0;
        digits := if v == integer.intMin { "9223372036854775808" } else if neg { (-v).toText() } else { v.toText() };
        lit := ir.targetIntLiteralCode(target, v, neg, digits);
        code := if target == ir.TARGET_C and numeric.isNarrowSignedIntKind(kind) {
            bits := numeric.narrowIntBits(kind);
            cTy := if bits <= 8 { "int8_t" } else if bits == 16 { "int16_t" } else { "int32_t" };
            "((" + cTy + ")(" + lit + "))"
        } else { lit };
        return (code = code, constant = true, intValue = v, textValue = "");
    }
    if numeric.isFloatKind(kind) {
        raw := c.floatVal.toText();
        neg := raw.startsWithAt(0, "-");
        digits := if neg { raw.slice(1, raw.length()) } else { raw };
        lit := if kind == ir.VALUE_KIND_FLOAT8 { ir.targetFloat8LiteralCode(target, digits, neg) }
        else if kind == ir.VALUE_KIND_FLOAT16 { ir.targetFloat16LiteralCode(target, digits, neg) }
        else if kind == ir.VALUE_KIND_FLOAT32 { ir.targetFloat32LiteralCode(target, digits, neg) }
        else { ir.targetFloatLiteralCode(target, digits, neg) };
        return (code = lit, constant = false, intValue = 0, textValue = "");
    }
    if types.isEnumKind(kind) {
        cIdx := c.intVal;
        if not types.isPayloadEnumKind(kind) {
            ec := if target == ir.TARGET_TS {
                types.enumCaseAt(kind, cIdx).valueCode
            } else {
                p := types.plainEnumCStorage(kind);
                "((" + p.cType + ")(" + cIdx.toText() + "))"
            };
            return (code = ec, constant = true, intValue = cIdx, textValue = "");
        }
        pCount := types.enumCasePayloadCount(kind, cIdx);
        mut pCodes: List<String> = [];
        var pi := 0;
        loop pi < pCount {
            pk := types.enumCasePayloadKind(kind, cIdx, pi);
            mut pCodes.pushBack(self(target, pk, c.children[pi]).code);
            pi = pi + 1;
        }
        if target == ir.TARGET_C {
            eTag := types.cStructTag(kind);
            return (code = "/*@T:" + kind + "@*/" + eTag + "_mk_" + cIdx.toText() + "(" + pCodes.join(", ") + ")", constant = false, intValue = 0, textValue = "");
        }
        tsT := types.tsFunctionType(kind);
        mut objParts: List<String> = ["_t: " + cIdx.toText() + " as const"];
        var ti := 0;
        loop ti < pCodes.length() {
            mut objParts.pushBack("_" + ti.toText() + ": " + pCodes[ti]);
            ti = ti + 1;
        }
        return (code = "({ " + objParts.join(", ") + " } as " + tsT + ")", constant = false, intValue = 0, textValue = "");
    }
    if types.isTupleKind(kind) {
        cnt := types.tupleComponentCount(kind);
        if cnt == 0 {
            code := if target == ir.TARGET_C { "/*@T:" + kind + "@*/((" + types.cStructTag(kind) + "){ ._empty = 0 })" } else { "{}" };
            return (code = code, constant = false, intValue = 0, textValue = "");
        }
        mut parts: List<String> = [];
        var i := 0;
        loop i < cnt {
            comp := types.tupleComponent(kind, i);
            mc := self(target, comp.kind, c.children[i]).code;
            if target == ir.TARGET_C {
                mut parts.pushBack("." + types.cFieldName(comp.prop) + " = " + mc);
            } else {
                mut parts.pushBack(comp.prop + ": " + mc);
            }
            i = i + 1;
        }
        code := if target == ir.TARGET_C {
            "/*@T:" + kind + "@*/((" + types.cStructTag(kind) + "){ " + parts.join(", ") + " })"
        } else {
            "{ " + parts.join(", ") + " }"
        };
        return (code = code, constant = false, intValue = 0, textValue = "");
    }
    if types.isRecordKind(kind) {
        cnt := types.recordComponentCount(kind);
        if cnt == 0 {
            code := if target == ir.TARGET_C { "/*@T:" + kind + "@*/((" + types.cStructTag(kind) + "){ ._empty = 0 })" } else { "{}" };
            return (code = code, constant = false, intValue = 0, textValue = "");
        }
        mut parts: List<String> = [];
        var i := 0;
        loop i < cnt {
            comp := types.recordComponent(kind, i);
            mc := self(target, comp.kind, c.children[i]).code;
            if target == ir.TARGET_C {
                mut parts.pushBack("." + types.cFieldName(comp.prop) + " = " + mc);
            } else {
                mut parts.pushBack(types.tsRecordPropKey(comp.label) + ": " + mc);
            }
            i = i + 1;
        }
        code := if target == ir.TARGET_C {
            "/*@T:" + kind + "@*/((" + types.cStructTag(kind) + "){ " + parts.join(", ") + " })"
        } else {
            "{ " + parts.join(", ") + " }"
        };
        return (code = code, constant = false, intValue = 0, textValue = "");
    }
    if types.isListKind(kind) {
        elK := types.listElementKind(kind);
        mut elCodes: List<String> = [];
        loop c.children as eid { mut elCodes.pushBack(self(target, elK, eid).code); }
        code := if target == ir.TARGET_C {
            lTag := types.cListTag(elK);
            if elCodes.length() == 0 {
                "lt_list_" + lTag + "_from(0, NULL)"
            } else {
                "lt_list_" + lTag + "_from(" + elCodes.length().toText() + ", (const " + types.cListElemType(lTag) + "[]){ " + elCodes.join(", ") + " })"
            }
        } else {
            "[" + elCodes.join(", ") + "]"
        };
        return (code = code, constant = false, intValue = 0, textValue = "");
    }
    if types.isArrayKind(kind) {
        elK := types.arrayElementKind(kind);
        mut elCodes: List<String> = [];
        loop c.children as eid { mut elCodes.pushBack(self(target, elK, eid).code); }
        code := if target == ir.TARGET_C {
            aTag := types.cArrayTag(kind);
            if elCodes.length() == 0 {
                "((/*@T:" + kind + "@*/" + aTag + "){ 0 })"
            } else if numeric.isSubByteIntKind(elK) {
                "/*@T:" + kind + "@*/" + aTag + "_from((const " + types.cValueType(elK) + "[]){ " + elCodes.join(", ") + " })"
            } else {
                "((/*@T:" + kind + "@*/" + aTag + "){ { " + elCodes.join(", ") + " } })"
            }
        } else {
            "[" + elCodes.join(", ") + "]"
        };
        return (code = code, constant = false, intValue = 0, textValue = "");
    }
    if types.isSetKind(kind) {
        elK := types.setElementKind(kind);
        mut elCodes: List<String> = [];
        loop c.children as eid { mut elCodes.pushBack(self(target, elK, eid).code); }
        code := if target == ir.TARGET_C {
            sTag := types.cSetTag(kind);
            if elCodes.length() == 0 {
                "/*@T:" + kind + "@*/" + sTag + "_from(0, NULL)"
            } else {
                kTag := types.cMapKeyTag(elK);
                "/*@T:" + kind + "@*/" + sTag + "_from(" + elCodes.length().toText() + ", (const " + types.cListElemType(kTag) + "[]){ " + elCodes.join(", ") + " })"
            }
        } else {
            "new Set<" + types.tsFunctionType(elK) + ">([" + elCodes.join(", ") + "])"
        };
        return (code = code, constant = false, intValue = 0, textValue = "");
    }
    if types.isMapKind(kind) {
        kK := types.mapKeyKind(kind);
        vK := types.mapValueKind(kind);
        if target == ir.TARGET_C {
            mTag := types.cMapTag(kind);
            if c.children.length() == 0 {
                return (code = "/*@T:" + kind + "@*/" + mTag + "_from(0, NULL)", constant = false, intValue = 0, textValue = "");
            }
            mut cEntries: List<String> = [];
            var i := 0;
            loop i < c.children.length() {
                kc := self(target, kK, c.children[i]).code;
                vc := self(target, vK, c.children[i + 1]).code;
                mut cEntries.pushBack("{ " + kc + ", " + vc + " }");
                i = i + 2;
            }
            return (code = "/*@T:" + kind + "@*/" + mTag + "_from(" + (c.children.length() / 2).toText() + ", (const " + mTag + "_entry[]){" + cEntries.join(", ") + "})", constant = false, intValue = 0, textValue = "");
        }
        mut tsEntries: List<String> = [];
        var i := 0;
        loop i < c.children.length() {
            kc := self(target, kK, c.children[i]).code;
            vc := self(target, vK, c.children[i + 1]).code;
            mut tsEntries.pushBack("[" + kc + ", " + vc + "]");
            i = i + 2;
        }
        return (code = "new Map<" + types.tsFunctionType(kK) + ", " + types.tsFunctionType(vK) + ">([" + tsEntries.join(", ") + "])", constant = false, intValue = 0, textValue = "");
    }
    if types.isUnionKind(kind) {
        mems := types.unionMembers(kind);
        innerId := if c.tag == TAG_UNION and c.children.length() > 0 { c.children[0] } else { valId };
        innerK := if c.tag == TAG_UNION and c.intVal >= 0 and c.intVal < mems.length() { mems[c.intVal] } else { ctPool[innerId].kind };
        mIdx := if c.tag == TAG_UNION { c.intVal } else { types.unionMemberIndex(kind, innerK) };
        innerCode := self(target, innerK, innerId).code;
        if target == ir.TARGET_C {
            uTag := types.cStructTag(kind);
            return (code = "/*@T:" + kind + "@*/" + uTag + "_mk_" + mIdx.toText() + "(" + innerCode + ")", constant = false, intValue = 0, textValue = "");
        }
        tsT := types.tsFunctionType(kind);
        return (code = "({ _u: " + mIdx.toText() + " as const, _v: " + innerCode + " } as " + tsT + ")", constant = false, intValue = 0, textValue = "");
    }
    if types.isResultKind(kind) {
        isErr := c.tag == TAG_RESULT and c.intVal =!= 0;
        okK := types.resultOkKind(kind);
        errK := types.resultErrKind(kind);
        payK := if isErr { errK } else { okK };
        payId := if c.tag == TAG_RESULT and c.children.length() > 0 { c.children[0] } else { valId };
        if target == ir.TARGET_C {
            rTag := types.cStructTag(kind);
            ctor := rTag + (if isErr { "_err" } else { "_ok" });
            if payK == ir.VALUE_KIND_UNIT {
                return (code = "/*@T:" + kind + "@*/" + ctor + "()", constant = false, intValue = 0, textValue = "");
            }
            return (code = "/*@T:" + kind + "@*/" + ctor + "(" + self(target, payK, payId).code + ")", constant = false, intValue = 0, textValue = "");
        }
        tsT := types.tsFunctionType(kind);
        if payK == ir.VALUE_KIND_UNIT {
            return (code = "({ _r: " + (if isErr { "1" } else { "0" }) + " as const } as " + tsT + ")", constant = false, intValue = 0, textValue = "");
        }
        payCode := self(target, payK, payId).code;
        propN := if isErr { "_e" } else { "_v" };
        return (code = "({ _r: " + (if isErr { "1" } else { "0" }) + " as const, " + propN + ": " + payCode + " } as " + tsT + ")", constant = false, intValue = 0, textValue = "");
    }
    (code = ir.targetUnitLiteralCode(target), constant = false, intValue = 0, textValue = "")
};
