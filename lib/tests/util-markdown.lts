md := import "data/markdown";
list := import "type/list";
test := import "core/test";

doc := "# Title\n\n## A `name` <T>\n\n## A `name` <T>\n\n`[skip](ignored.md)`\n\n[one](topic.md#a-name-) [two](<space path.md> \"t\")\n\n```lts\n[in-code](missing.md)\n```\n";

prose := md.stripCodeBlocks(doc);
headings := md.extractHeadings(prose);
test.checkInt("heading count", 3, headings.length());
test.checkText("first heading", "Title", headings[0]);
test.checkText("second heading", "A `name` <T>", headings[1]);

anchors := md.collectAnchors(doc + "<a id=\"explicit-id\"></a>\n");
test.checkBool("title anchor", true, anchors.contains("title"));
test.checkBool("dedup first", true, anchors.contains("a-name-"));
test.checkBool("dedup second", true, anchors.contains("a-name--1"));
test.checkBool("explicit html id", true, anchors.contains("explicit-id"));

links := md.extractLinkTargets(prose);
test.checkInt("link count", 2, links.length());
test.checkText("first link", "topic.md#a-name-", links[0]);
test.checkText("second link", "space path.md", links[1]);

test.checkBool("closed fence", false, md.hasUnclosedFence(doc));
test.checkBool("unclosed fence", true, md.hasUnclosedFence("   ```text\nhello\n"));

bodies := md.extractBacktickFenceBodies(doc);
test.checkInt("fence body count", 1, bodies.length());
test.checkText("fence body", "[in-code](missing.md)\n", bodies[0]);

test.done("util-markdown");
