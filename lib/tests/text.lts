integer := import "core/int";
text := import "core/text";
test := import "core/test";

test.checkBool("digit 7", true, text.isDigit("7"));
test.checkBool("digit a", false, text.isDigit("a"));
test.checkInt("digit value", 9, text.digitValue("9"));
test.checkBool("ascii letter", true, text.isAsciiLetter("Z"));
test.checkBool("ascii non-letter", false, text.isAsciiLetter("_"));
test.checkBool("name start underscore", true, text.isNameStart("_"));
test.checkBool("name start digit", false, text.isNameStart("1"));
test.checkBool("name continue digit", true, text.isNameContinue("9"));

test.checkInt("skip spaces", 3, text.skipSpaces(" \t\nx", 0));
test.checkInt("skip name", 4, text.skipName("abc9 ", 0));
test.checkBool("starts with", true, text.startsWithAt("hello", 1, "ell"));
test.checkBool("starts beyond", false, text.startsWithAt("hi", 1, "ello"));
test.checkBool("word boundary", true, text.wordAt("foo bar", 4, "bar"));
test.checkBool("word not boundary", false, text.wordAt("foobar", 0, "foo"));

test.checkInt("index of", 4, text.indexOfText("abcabc", "bc", 2));
test.checkInt("index absent", -1, text.indexOfText("abc", "z", 0));
test.checkInt("index empty", 2, text.indexOfText("abc", "", 2));

values: List<String> = ["a", "b", "c"];
test.checkText("join texts", "a,b,c", text.joinTexts(values, ","));
empty: List<String> = [];
test.checkText("join empty", "", text.joinTexts(empty, ","));

parsed := text.textToInt("42");
test.checkInt("text to int", 42, parsed.value);
test.checkBool("text to int ok", true, parsed.ok);
plusParsed := text.textToInt("+7");
test.checkInt("text to int plus", 7, plusParsed.value);
minParsed := text.textToInt("-9223372036854775808");
test.checkBool("text to int min", true, minParsed.ok);
maxOverflow := text.textToInt("9223372036854775808");
test.checkBool("text to int max overflow", false, maxOverflow.ok);
malformed := text.textToInt("12x");
test.checkBool("text to int malformed", false, malformed.ok);
emptyParsed := text.textToInt("");
test.checkBool("text to int empty", false, emptyParsed.ok);
signOnly := text.textToInt("-");
test.checkBool("text to int sign only", false, signOnly.ok);

test.checkBool("whitespace space", true, text.isWhitespace(" "));
test.checkBool("whitespace tab", true, text.isWhitespace("\t"));
test.checkBool("whitespace char", false, text.isWhitespace("a"));
test.checkText("trim start", "hi ", text.trimStart(" \t\nhi "));
test.checkText("trim end", " hi", text.trimEnd(" hi \r\n"));
test.checkText("trim", "hi", text.trim(" \thi\n "));
test.checkText("trim blank", "", text.trim(" \t\r\n"));
test.checkBool("ends with match", true, text.endsWith("sample.lts", ".lts"));
test.checkBool("ends with miss", false, text.endsWith("sample.ts", ".lts"));
test.checkBool("ends with longer", false, text.endsWith("a", "abc"));
test.checkText("repeat text", "ababab", text.repeatText("ab", 3));
test.checkText("repeat zero", "", text.repeatText("ab", 0));

test.done("text");
