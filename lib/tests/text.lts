text := import "type/string";
test := import "core/test";

test.checkBool("digit 7", true, "7".isDigit());
test.checkBool("digit a", false, "a".isDigit());
test.checkInt("digit value", 9, "9".digitValue());
test.checkBool("ascii letter", true, "Z".isAsciiLetter());
test.checkBool("ascii non-letter", false, "_".isAsciiLetter());
test.checkBool("name start underscore", true, "_".isNameStart());
test.checkBool("name start digit", false, "1".isNameStart());
test.checkBool("name continue digit", true, "9".isNameContinue());
test.checkBool("name start persian", true, "پ".isNameStart());
test.checkBool("name start persian digit", false, "۱".isNameStart());
test.checkBool("name continue persian digit", true, "۱".isNameContinue());
test.checkBool("name start emoji", false, "🚀".isNameStart());
test.checkBool("name start german", true, "ß".isNameStart());
test.checkBool("name start french", true, "é".isNameStart());
test.checkBool("name start chinese", true, "学".isNameStart());
test.checkBool("name start greek", true, "α".isNameStart());
test.checkBool("name start russian", true, "с".isNameStart());
test.checkBool("name start armenian", true, "հ".isNameStart());
test.checkBool("name start georgian", true, "მ".isNameStart());

test.checkInt("skip spaces", 3, " \t\nx".skipSpaces(0));
test.checkInt("skip name", 4, "abc9 ".skipName(0));
test.checkInt("skip name persian", 5, "پیام۱ ".skipName(0));
test.checkBool("starts with", true, "hello".startsWithAt(1, "ell"));
test.checkBool("starts beyond", false, "hi".startsWithAt(1, "ello"));
test.checkBool("word boundary", true, "foo bar".wordAt(4, "bar"));
test.checkBool("word not boundary", false, "foobar".wordAt(0, "foo"));
test.checkBool("word boundary persian", true, "پیام پ".wordAt(0, "پیام"));
test.checkBool("word not boundary persian", false, "پیام۱ پ".wordAt(0, "پیام"));

test.checkInt("index of", 4, "abcabc".indexOf("bc", 2));
test.checkInt("index absent", -1, "abc".indexOf("z", 0));
test.checkInt("index empty", 2, "abc".indexOf("", 2));
test.checkInt("index empty at end", 3, "abc".indexOf("", 3));
test.checkInt("index empty past end", -1, "abc".indexOf("", 4));
test.checkInt("index negative start", -1, "abc".indexOf("a", -1));
test.checkInt("index non-bmp after emoji", 2, "a🙂bc".indexOf("bc", 1));
test.checkInt("index non-bmp emoji", 1, "a🙂bc".indexOf("🙂", 0));
test.checkInt("index non-bmp empty", 4, "a🙂bc".indexOf("", 4));

values: List<String> = ["a", "b", "c"];
test.checkText("join texts", "a,b,c", values.join(","));
empty: List<String> = [];
test.checkText("join empty", "", empty.join(","));

parsed := "42".toInt();
test.checkInt("text to int", 42, parsed.value);
test.checkBool("text to int ok", true, parsed.ok);
plusParsed := "+7".toInt();
test.checkInt("text to int plus", 7, plusParsed.value);
minParsed := "-9223372036854775808".toInt();
test.checkBool("text to int min", true, minParsed.ok);
maxOverflow := "9223372036854775808".toInt();
test.checkBool("text to int max overflow", false, maxOverflow.ok);
malformed := "12x".toInt();
test.checkBool("text to int malformed", false, malformed.ok);
emptyParsed := "".toInt();
test.checkBool("text to int empty", false, emptyParsed.ok);
signOnly := "-".toInt();
test.checkBool("text to int sign only", false, signOnly.ok);

test.checkBool("whitespace space", true, " ".isWhitespace());
test.checkBool("whitespace tab", true, "\t".isWhitespace());
test.checkBool("whitespace char", false, "a".isWhitespace());
test.checkText("trim start", "hi ", " \t\nhi ".trimStart());
test.checkText("trim end", " hi", " hi \r\n".trimEnd());
test.checkText("trim", "hi", " \thi\n ".trim());
test.checkText("trim blank", "", " \t\r\n".trim());
test.checkBool("ends with match", true, "sample.lts".endsWith(".lts"));
test.checkBool("ends with miss", false, "sample.ts".endsWith(".lts"));
test.checkBool("ends with longer", false, "a".endsWith("abc"));
test.checkText("repeat text", "ababab", "ab".repeat(3));
test.checkText("repeat zero", "", "ab".repeat(0));
test.checkBool("contains match", true, "LiteScript".contains("Script"));
test.checkBool("contains miss", false, "LiteScript".contains("Java"));
test.checkText("to lower ascii", "hello world 123!", "HeLLo WoRLd 123!".toLowerAscii());

test.checkText("split comma", "a|b||c", "a,b,,c".split(",").join("|"));
test.checkText("split chars", "a-b-c", "abc".split("").join("-"));
test.checkText("split lines", "one/two", "one\r\ntwo\n".splitLines().join("/"));
test.checkText("replace all", "QUX bar QUX", "foo bar foo".replaceAll("foo", "QUX"));
test.checkText("pad left", "  7", "7".padLeft(3));
test.checkText("pad right", "7  ", "7".padRight(3));
test.checkText("pad left int", "  -42", (-42).toText().padLeft(5));
test.checkBool("lessOrEqual ascii", true, "actual".lessOrEqual("book"));
test.checkBool("lessOrEqual unicode", true, "é".lessOrEqual("ü"));

test.done("text");
