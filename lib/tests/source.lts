integer := import "core/int";
source := import "core/source";
test := import "core/test";

place := source.lineColumn("ab\ncd", 3);
test.checkInt("line column line", 2, place.line);
test.checkInt("line column column", 1, place.column);

clamped := source.lineColumn("ab\ncd", 100);
test.checkInt("line column clamped line", 2, clamped.line);
test.checkInt("line column clamped column", 3, clamped.column);

test.checkInt("line count empty", 1, source.lineCount(""));
test.checkInt("line count two", 2, source.lineCount("a\nb"));
test.checkInt("line count trailing", 2, source.lineCount("a\n"));

test.checkInt("line start second", 3, source.lineStartOffset("ab\ncd", 2));
test.checkInt("line end first", 2, source.lineEndOffset("ab\ncd", 1));
test.checkInt("line end last", 5, source.lineEndOffset("ab\ncd", 2));
test.checkInt("clamp below", 0, source.clampPosition("abc", -2));
test.checkInt("clamp above", 3, source.clampPosition("abc", 9));

test.done("source");
