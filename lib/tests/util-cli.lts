text := import "core/text";
cli := import "../../tools/src/internal/cli";
test := import "core/test";

sepArgs: List<String> = ["--", "a.lts", "--", "--flag"];
test.checkText("stripLeadingSeparator", "a.lts,--,--flag", cli.stripLeadingSeparator(sepArgs).join(","));
plainArgs: List<String> = ["a.lts", "--flag"];
test.checkText("stripLeadingSeparator noop", "a.lts,--flag", cli.stripLeadingSeparator(plainArgs).join(","));

/* Verify in-place munching with list.popFront leaves remaining args untouched on caller list. */
mut munched: List<String> = ["--flag", "target.lts", "--extra"];
first := mut munched.popFront();
test.checkText("popFront token", "--flag", first);
test.checkText("popFront remaining", "target.lts,--extra", munched.join(","));

test.checkText("entry bin/lite", "lite", cli.entryCommand("/repo/bin/lite"));
test.checkText("entry generated cli", "lite", cli.entryCommand("/repo/dist/tools/cli.ts"));
test.checkText("entry bin/lite-fmt", "fmt", cli.entryCommand("/repo/bin/lite-fmt"));
test.checkText("entry generated fmt", "fmt", cli.entryCommand("/repo/dist/tools/fmt.ts"));
test.checkText("entry checker", "check", cli.entryCommand("tools/checker.ts"));
test.checkText("entry doctor", "doctor", cli.entryCommand("tools/check.ts"));
test.checkText("entry test-runner", "test", cli.entryCommand("tools/test-runner.ts"));

supported: List<String> = ["check", "fmt", "docs", "doctor", "verify", "test"];
test.checkText("subcommand bare", "fmt", cli.normalizeSubcommand("fmt", supported));
test.checkText("subcommand flag", "fmt", cli.normalizeSubcommand("--fmt", supported));
test.checkText("subcommand unknown", "", cli.normalizeSubcommand("--help", supported));

test.done("util-cli");
