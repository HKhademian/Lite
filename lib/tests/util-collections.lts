/** Dual-target tests for `util/collections` O(n log n) sorts and O(n) Set/Map helpers. */

collections := import "core/list";
test := import "core/test";
text := import "core/text";

/* sortIndicesBy with capturing multi-key closure */
keys: List<String> = ["b", "a", "c", "a2"];
scores: List<Int> = [20, 50, 20, 50];
order := collections.sortIndicesBy(4, fn(i: Int, j: Int): Bool {
    if scores[i] =!= scores[j] { scores[i] > scores[j] }
    else { keys[i].lessOrEqual(keys[j]) }
});
test.checkText("sortIndicesBy multi-key", "1,3,0,2", order.map(fn(x: Int): String { x.toText() }).join(","));

emptyOrd := collections.sortIndicesBy(0, fn(i: Int, j: Int): Bool { i <= j });
test.checkInt("sortIndicesBy empty", 0, emptyOrd.length());

/* sortIntsBy descending + stability */
nums: List<Int> = [3, 1, 4, 1, 5, 9, 2];
descNums := nums.sortBy(fn(a: Int, b: Int): Bool { a >= b });
test.checkText("sortIntsBy desc", "9,5,4,3,2,1,1", descNums.map(fn(x: Int): String { x.toText() }).join(","));

/* sortTextsBy length then lex */
words: List<String> = ["pear", "fig", "apple", "kiwi", "ant"];
byLen := words.sortBy(fn(a: String, b: String): Bool {
    la := a.length();
    lb := b.length();
    if la =!= lb { la < lb } else { a.lessOrEqual(b) }
});
test.checkText("sortTextsBy len+lex", "ant,fig,kiwi,pear,apple", byLen.join(","));

/* dedupTexts & dedupInts */
rawWords: List<String> = ["b", "a", "b", "c", "a", "d"];
test.checkText("dedupTexts", "b,a,c,d", rawWords.dedup().join(","));

rawInts: List<Int> = [5, 2, 5, 8, 2, 1];
test.checkText("dedupInts", "5,2,8,1", rawInts.dedup().map(fn(x: Int): String { x.toText() }).join(","));

/* countTexts */
counts := collections.countTexts(["x", "y", "x", "z", "x", "y"]);
test.checkInt("countTexts x", 3, counts.getOr("x", 0));
test.checkInt("countTexts y", 2, counts.getOr("y", 0));
test.checkInt("countTexts z", 1, counts.getOr("z", 0));
test.checkInt("countTexts missing", 0, counts.getOr("w", 0));

/* textLessOrEqual: differing lengths, prefixes, and non-ASCII fallback */
test.check("book <= actual is false", not "book".lessOrEqual("actual"));
test.check("actual <= book is true", "actual".lessOrEqual("book"));
test.check("act <= actual is true", "act".lessOrEqual("actual"));
test.check("actual <= act is false", not "actual".lessOrEqual("act"));
test.check("a <= é is true", "a".lessOrEqual("é"));
test.check("é <= a is false", not "é".lessOrEqual("a"));
test.check("é <= ü is true", "é".lessOrEqual("ü"));
test.check("ü <= é is false", not "ü".lessOrEqual("é"));

test.done("util-collections");
