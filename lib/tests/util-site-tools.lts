siteTools := import "../../site/src/tools";
json := import "util/json";
test := import "core/test";

withRepo := siteTools.buildToolsPayloadJson("https://github.com/example/lite");
test.checkBool("valid json with repo", true, json.validate(withRepo).ok);
test.checkBool("contains cli ref", true, withRepo.indexOf("./bin/lite bench", 0) >= 0);
test.checkBool("contains bench-release cmd id", true, withRepo.indexOf("id=\\\"cmd-bench-release\\\"", 0) >= 0);
test.checkBool("uses repo vscode link", true, withRepo.indexOf("https://github.com/example/lite/tree/main/editors/vscode", 0) >= 0);
test.checkBool("contains search entries", true, withRepo.indexOf("Self-Hosting 3-Generation Ladder", 0) >= 0);

noRepo := siteTools.buildToolsPayloadJson("");
test.checkBool("valid json without repo", true, json.validate(noRepo).ok);
test.checkBool("fallback vscode href", true, noRepo.indexOf("href=\\\"../\\\"", 0) >= 0);

test.done("util-site-tools");
