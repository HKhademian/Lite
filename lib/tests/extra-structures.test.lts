/* Dual-target (TS + C11) and ASan/UBSan tests for `ds/ring`, `ds/deque`, `ds/heap`, `ds/bitset`, and `ds/sparse`. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
ccInfo := compilerTest.probeCc();

tmpRes := fs.makeTempDir("lite-extra-structures-test-");
test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
tmpDir := tmpRes.path;

functionalSrc :=
"io := import \"core/io\";\n" +
"ring := import \"ds/ring\";\n" +
"deque := import \"ds/deque\";\n" +
"heap := import \"ds/heap\";\n" +
"bitset := import \"ds/bitset\";\n" +
"sparse := import \"ds/sparse\";\n" +
"\n" +
"/* 1. ds/ring */\n" +
"ri: mut ring.IntRing = ring.createRing<Int>(3);\n" +
"o1 := mut ri.push(10);\n" +
"o2 := mut ri.push(20);\n" +
"o3 := mut ri.push(30);\n" +
"tp := mut ri.tryPush(99);\n" +
"o4 := mut ri.push(40);\n" +
"io.outputLine(\"ringInt\", o1, o2, o3, tp, o4, ri.peekFront().unwrapOr(-1), ri.peekBack().unwrapOr(-1), ri.get(1).unwrapOr(-1), ri.sum());\n" +
"p1 := mut ri.pop();\n" +
"io.outputLine(\"ringPop\", p1.isSome(), p1.unwrapOr(-1), ri.length());\n" +
"\n" +
"rf: mut ring.FloatRing = ring.createRing<Float>(4);\n" +
"_f1 := mut rf.push(10.0);\n" +
"_f2 := mut rf.push(20.0);\n" +
"_f3 := mut rf.push(30.0);\n" +
"mm := rf.minMax();\n" +
"io.outputLine(\"ringFloat\", rf.avg(), mm.min, mm.max, rf.length());\n" +
"\n" +
"/* 2. ds/deque */\n" +
"dq: mut deque.IntDeque = deque.createDeque<Int>(4);\n" +
"_d1 := mut dq.pushBack(2);\n" +
"_d2 := mut dq.pushFront(1);\n" +
"_d3 := mut dq.pushBack(3);\n" +
"_d4 := mut dq.pushFront(0);\n" +
"dFull := mut dq.pushBack(9);\n" +
"df := mut dq.popFront();\n" +
"db := mut dq.popBack();\n" +
"io.outputLine(\"dequeInt\", dFull, df.unwrapOr(-1), db.unwrapOr(-1), dq.peekFront().unwrapOr(-1), dq.peekBack().unwrapOr(-1), dq.length());\n" +
"\n" +
"td: mut deque.TextDeque = deque.createDeque<String>(3);\n" +
"_t1 := mut td.pushBack(\"b\");\n" +
"_t2 := mut td.pushFront(\"a\");\n" +
"_t3 := mut td.pushBack(\"c\");\n" +
"tf := mut td.popFront();\n" +
"tb := mut td.popBack();\n" +
"io.outputLine(\"dequeText\", tf.unwrapOr(\"\"), tb.unwrapOr(\"\"), td.length());\n" +
"\n" +
"/* 3. ds/heap */\n" +
"mut mn := heap.createMin(8);\n" +
"_m1 := mut mn.push(50);\n" +
"_m2 := mut mn.push(10);\n" +
"_m3 := mut mn.push(30);\n" +
"_m4 := mut mn.push(20);\n" +
"mp1 := mut mn.pop();\n" +
"mp2 := mut mn.pop();\n" +
"mp3 := mut mn.pop();\n" +
"mp4 := mut mn.pop();\n" +
"mp5 := mut mn.pop();\n" +
"io.outputLine(\"minHeap\", mp1.unwrapOr(-1), mp2.unwrapOr(-1), mp3.unwrapOr(-1), mp4.unwrapOr(-1), mp5.isSome());\n" +
"\n" +
"mut mx := heap.createMax(8);\n" +
"_x1 := mut mx.push(10);\n" +
"_x2 := mut mx.push(50);\n" +
"_x3 := mut mx.push(30);\n" +
"xp1 := mut mx.pop();\n" +
"xp2 := mut mx.pop();\n" +
"xp3 := mut mx.pop();\n" +
"io.outputLine(\"maxHeap\", xp1.unwrapOr(-1), xp2.unwrapOr(-1), xp3.unwrapOr(-1));\n" +
"\n" +
"pq: mut heap.IntPriorityQueue = heap.createPQ<Int>(8);\n" +
"_q1 := mut pq.push(30, 103);\n" +
"_q2 := mut pq.push(10, 101);\n" +
"_q3 := mut pq.push(20, 102);\n" +
"pqa := mut pq.pop();\n" +
"pqb := mut pq.pop();\n" +
"paPrio := match pqa { .Empty { -1 } .Some(e) { e.priority } };\n" +
"paItem := match pqa { .Empty { -1 } .Some(e) { e.item } };\n" +
"pbPrio := match pqb { .Empty { -1 } .Some(e) { e.priority } };\n" +
"pbItem := match pqb { .Empty { -1 } .Some(e) { e.item } };\n" +
"io.outputLine(\"pq\", paPrio, paItem, pbPrio, pbItem, pq.count());\n" +
"\n" +
"/* 4. ds/bitset */\n" +
"mut b1 := bitset.create(65);\n" +
"mut b2 := bitset.create(65);\n" +
"_bs1 := mut b1.set(0);\n" +
"_bs2 := mut b1.set(31);\n" +
"_bs3 := mut b1.set(64);\n" +
"_bs4 := mut b2.set(31);\n" +
"_bs5 := mut b2.set(45);\n" +
"io.outputLine(\"bitset1\", b1.test(0), b1.test(31), b1.test(64), b1.test(65), b1.countOnes(), b1.firstSet(), b1.firstClear());\n" +
"mut b1.orInto(b2);\n" +
"cntOr := b1.countOnes();\n" +
"mut b1.andInto(b2);\n" +
"cntAnd := b1.countOnes();\n" +
"eqAfterAnd := b1.equals(b2);\n" +
"mut b1.xorInto(b2);\n" +
"io.outputLine(\"bitsetOps\", cntOr, cntAnd, eqAfterAnd, b1.countOnes(), b1.firstSet());\n" +
"mut b1.setAll();\n" +
"io.outputLine(\"bitsetAll\", b1.countOnes(), b1.firstClear());\n" +
"\n" +
"/* 5. ds/sparse */\n" +
"mut ss := sparse.create(100);\n" +
"si1 := mut ss.insert(42);\n" +
"si2 := mut ss.insert(7);\n" +
"siDup := mut ss.insert(42);\n" +
"si3 := mut ss.insert(99);\n" +
"sr1 := mut ss.remove(42);\n" +
"srDup := mut ss.remove(42);\n" +
"io.outputLine(\"sparse\", si1, si2, siDup, si3, sr1, srDup, ss.has(42), ss.has(7), ss.has(99), ss.count(), ss.denseAt(0), ss.denseAt(1));\n" +
"mut ss.clear();\n" +
"io.outputLine(\"sparseClear\", ss.count(), ss.has(99));\n";

expectedOut :=
"ringInt false false false false true 20 40 30 90\n" +
"ringPop true 20 2\n" +
"ringFloat 20 10 30 3\n" +
"dequeInt false 0 3 1 2 2\n" +
"dequeText a c 1\n" +
"minHeap 10 20 30 50 false\n" +
"maxHeap 50 30 10\n" +
"pq 10 101 20 102 1\n" +
"bitset1 true true true false 3 0 1\n" +
"bitsetOps 4 2 true 0 -1\n" +
"bitsetAll 65 -1\n" +
"sparse true true false true true false false true true 2 99 7\n" +
"sparseClear 0 false\n";

emptyEnv: List<String> = [];
tsComp := compilerTest.compileStdin(root, selTs.path, functionalSrc, "");
test.checkInt("TS compile status: " + tsComp.stderr, 0, tsComp.status);
tsOutFile := path.join(tmpDir, "functional.ts");
test.check("write functional.ts", fs.writeText(tsOutFile, tsComp.stdout).ok);
tsRunner := path.join(tmpDir, "runner.ts");
tsRunnerCode :=
"import { writeSync } from 'node:fs';\n" +
"import { main } from './functional.ts';\n" +
"const out = main((t: string): void => { writeSync(1, t); });\n" +
"if (typeof out === 'string' && out.length > 0) writeSync(1, out);\n";
test.check("write runner.ts", fs.writeText(tsRunner, tsRunnerCode).ok);
tsRun := proc.run(project.nodeExecPath(), [tsRunner], root, emptyEnv, true, "");
test.checkInt("TS run status: " + tsRun.stderr, 0, tsRun.status);
test.checkText("TS functional output", expectedOut, tsRun.stdout);

if ccInfo.available {
    cComp := compilerTest.compileStdin(root, selC.path, functionalSrc, "");
    test.checkInt("C11 compile status: " + cComp.stderr, 0, cComp.status);
    cFile := path.join(tmpDir, "functional.c");
    cBin := path.join(tmpDir, "functional");
    test.check("write functional.c", fs.writeText(cFile, cComp.stdout).ok);
    ccRes := proc.run(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cFile, "-o", cBin, "-lm"], tmpDir, emptyEnv, true, "");
    test.checkInt("C11 cc status: " + ccRes.stderr, 0, ccRes.status);
    cRun := proc.run(cBin, [], root, emptyEnv, true, "");
    test.checkInt("C11 run status: " + cRun.stderr, 0, cRun.status);
    test.checkText("C11 functional output matches TS", expectedOut, cRun.stdout);

    stressSrc :=
    "io := import \"core/io\";\n" +
    "ring := import \"ds/ring\";\n" +
    "deque := import \"ds/deque\";\n" +
    "heap := import \"ds/heap\";\n" +
    "bitset := import \"ds/bitset\";\n" +
    "sparse := import \"ds/sparse\";\n" +
    "\n" +
    "mut r := ring.createRing<Int>(32);\n" +
    "mut dq := deque.createDeque<Int>(32);\n" +
    "mut hp := heap.createMin(64);\n" +
    "mut bs := bitset.create(128);\n" +
    "mut ss := sparse.create(128);\n" +
    "loop 0..5000 as i {\n" +
    "    _ro := mut r.push(i);\n" +
    "    _dp := mut dq.pushBack(i);\n" +
    "    if dq.length() > 16 { _df := mut dq.popFront(); }\n" +
    "    _hp := mut hp.push((i * 37) % 1000);\n" +
    "    if hp.count() > 32 { _hm := mut hp.pop(); }\n" +
    "    _bt := mut bs.toggle(i % 128);\n" +
    "    id := i % 128;\n" +
    "    if ss.has(id) { _sr := mut ss.remove(id); } else { _si := mut ss.insert(id); }\n" +
    "}\n" +
    "io.outputLine(\"stress\", r.length(), dq.length(), hp.count(), bs.countOnes(), ss.count());\n";

    stressPath := path.join(tmpDir, "stress.lts");
    ws := fs.writeText(stressPath, stressSrc);
    test.check("write stress.lts: " + ws.error, ws.ok);

    sanBin := path.join(tmpDir, "stress-san");
    buildSan := proc.run(path.join(root, "bin/lite"), ["build", "--sanitize", "--quiet", "-o", sanBin, stressPath], root, emptyEnv, true, "");
    test.check("ASan/UBSan build ok: " + buildSan.stderr, buildSan.status == 0 and buildSan.error == "");

    runSan := proc.run(sanBin, [], tmpDir, emptyEnv, true, "");
    test.check("ASan/UBSan stress exit 0: " + runSan.stderr, runSan.status == 0 and runSan.error == "");
    test.checkText("ASan/UBSan stress output", "stress 32 16 32 120 120\n", runSan.stdout);
}

fs.remove(tmpDir);
