integer := import "../core/int.lts";
format := import "../core/format.lts";
test := import "../core/test.lts";

test.checkText("decimal zero", "0", format.decimalText(0));
test.checkText("decimal negative", "-42", format.decimalText(-42));
test.checkText("decimal minimum", "-9223372036854775808", format.decimalText(integer.intMin()));
test.checkText("pad left text", "  7", format.padLeftText("7", 3));
test.checkText("pad right text", "7  ", format.padRightText("7", 3));
test.checkText("pad left no-op", "long", format.padLeftText("long", 2));
test.checkText("pad right no-op", "long", format.padRightText("long", 2));
test.checkText("pad left int", "  -42", format.padLeftInt(-42, 5));
test.checkText("pad right int", "7  ", format.padRightInt(7, 3));

values: List<Int> = [1, 2, 3];
test.checkText("join ints", "1, 2, 3", format.joinIntTexts(values, ", "));
empty: List<Int> = [];
test.checkText("join ints empty", "", format.joinIntTexts(empty, ", "));

test.done("format");
