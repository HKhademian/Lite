json := import "data/json";
test := import "core/test";

sample := "{\n  \"name\": \"lite\",\n  \"nested\": { \"name\": \"inner\", \"count\": 2 },\n  \"items\": [\"a\", \"b\\n\\\"c\\\"\", \"\\u003cok\\u003e\"],\n  \"flag\": true\n}";

valCheck := json.validate(sample);
test.checkBool("valid json", true, valCheck.ok);

badCheck := json.validate("{\"a\": [1,]}");
test.checkBool("reject trailing comma", false, badCheck.ok);

topName := json.readFieldString(sample, 0, "name");
test.checkBool("top name found", true, topName.found);
test.checkText("top name does not shadow nested", "lite", topName.value);

nestedField := json.findField(sample, 0, "nested");
test.checkBool("nested found", true, nestedField.found);
innerCount := json.readFieldInt(sample, nestedField.valuePos, "count");
test.checkInt("nested count", 2, innerCount.value);

flagField := json.readFieldBool(sample, 0, "flag");
test.checkBool("flag bool", true, flagField.value);

itemsField := json.findField(sample, 0, "items");
offsets := json.arrayOffsets(sample, itemsField.valuePos);
test.checkInt("array len", 3, offsets.length());
second := json.readStringAt(sample, offsets[1]);
test.checkText("escaped string", "b\n\"c\"", second.value);
third := json.readStringAt(sample, offsets[2]);
test.checkText("unicode escape", "<ok>", third.value);

keys := json.objectKeys(sample, 0);
test.checkInt("object keys count", 4, keys.length());
test.checkText("last key", "flag", keys[3]);

test.checkText("quote string", "\"a\\n\\\"b\\\"\\\\c\"", json.quoteString("a\n\"b\"\\c"));

uSample := "{\"u\":\"A\\u00e9\\ud83d\\ude42\\b\\f\"}";
uRead := json.readFieldString(uSample, 0, "u");
test.checkBool("unicode surrogate escape ok", true, uRead.ok);
expectedU := "Aé🙂" + String.fromCodePoint(8).text + String.fromCodePoint(12).text;
test.checkText("unicode surrogate escape val", expectedU, uRead.value);
test.checkText("quote control chars", "\"a\\u0000\\b\\f\\n\"", json.quoteString(json.readFieldString("{\"s\":\"a\\u0000\\b\\f\\n\"}", 0, "s").value));

span := json.valueSpan("  {\"x\": [1, 2]} , tail", 0);
test.checkBool("valueSpan ok", true, span.ok);
test.checkInt("valueSpan start", 2, span.start);
test.checkInt("valueSpan end", 15, span.end);

test.checkText("quote empty", "\"\"", json.quoteString(""));
htmlSample := "<div class=\"a&b\">\tline1\r\nline2\\path/é🙂</div>";
htmlQuoted := json.quoteString(htmlSample);
htmlDecoded := json.readFieldString("{\"html\":" + htmlQuoted + "}", 0, "html");
test.checkBool("html roundtrip ok", true, htmlDecoded.found and htmlDecoded.ok);
test.checkText("html roundtrip val", htmlSample, htmlDecoded.value);

nulNonAscii := "é" + String.fromCodePoint(0).text + "\n\t";
nulQuoted := json.quoteString(nulNonAscii);
test.checkText("nul non-ascii quoted", "\"é\\u0000\\n\\t\"", nulQuoted);
nulDecoded := json.readStringAt(nulQuoted, 0);
test.checkBool("nul non-ascii decode ok", true, nulDecoded.ok);
test.checkText("nul non-ascii decode val", nulNonAscii, nulDecoded.value);

test.checkBool("reject unescaped lf", false, json.readStringAt("\"a\nb\"", 0).ok);
test.checkBool("reject unescaped cr", false, json.readStringAt("\"a\rb\"", 0).ok);
test.checkBool("reject unescaped tab", false, json.readStringAt("\"a\tb\"", 0).ok);
test.checkBool("reject unterminated string", false, json.readStringAt("\"abc", 0).ok);
test.checkBool("reject unterminated escape", false, json.readStringAt("\"abc\\", 0).ok);
test.checkBool("reject invalid escape", false, json.readStringAt("\"abc\\q\"", 0).ok);
test.checkBool("reject incomplete unicode escape", false, json.readStringAt("\"\\u12\"", 0).ok);

slashTrail := json.readStringAt("\"foo\\\\\"", 0);
test.checkBool("escaped trailing backslash ok", true, slashTrail.ok);
test.checkText("escaped trailing backslash val", "foo\\", slashTrail.value);

slashQuote := json.readStringAt("\"a\\\\\\\"b\"", 0);
test.checkBool("escaped backslash and quote ok", true, slashQuote.ok);
test.checkText("escaped backslash and quote val", "a\\\"b", slashQuote.value);

siblingObj := "{\"a\":\"x\\\\\",\"b\":\"y\"}";
test.checkBool("sibling valid", true, json.validate(siblingObj).ok);
sibA := json.readFieldString(siblingObj, 0, "a");
sibB := json.readFieldString(siblingObj, 0, "b");
test.checkText("sibling a", "x\\", sibA.value);
test.checkText("sibling b", "y", sibB.value);

test.done("util-json");
