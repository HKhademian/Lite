challenges := import "util/challenges";
fs := import "core/file";
path := import "core/path";
project := import "util/project";
unicode := import "core/unicode";
test := import "core/test";

test.checkText("sorted counts json", "{\"a\":3,\"b\":2,\"c\":1}", challenges.formatSortedCountsJson(["b", "a", "c", "a", "b", "a"]));
test.checkText("difficulty band beginner", "beginner", challenges.difficultyBand(1500));
test.checkText("difficulty band intermediate", "intermediate", challenges.difficultyBand(6000));
test.checkText("difficulty band expert", "expert", challenges.difficultyBand(9500));

pDec := challenges.parseScaledNumberText("1.5");
test.checkBool("scaled decimal ok", true, pDec.ok);
test.checkInt("scaled decimal val", 1500, pDec.scaled);
test.checkBool("scaled decimal not int", false, pDec.isIntLiteral);
test.checkText("format csv float", "4.0", challenges.formatDifficultyCsv("leetcode", 4000, "4", true));
test.checkText("format csv cryptopals int", "4", challenges.formatDifficultyCsv("cryptopals", 4000, "4", true));

sorted := ["zeta", "alpha", "mu", "alpha"].sortTexts();
test.checkText("sort first", "alpha", sorted[0]);
test.checkText("sort last", "zeta", sorted[3]);
test.checkBool("binary search hit", true, challenges.sortedContainsText(sorted, "mu"));
test.checkBool("binary search miss", false, challenges.sortedContainsText(sorted, "beta"));

optOk := challenges.checkQueryOptions(["--topic=graphs", "--topic", "math", "--stats"]);
test.checkBool("query options ok", true, optOk.ok);
optBadFlag := challenges.checkQueryOptions(["--stats=1"]);
test.checkBool("query flag value rejected", false, optBadFlag.ok);
optBadUnk := challenges.checkQueryOptions(["--bogus"]);
test.checkBool("query unknown option rejected", false, optBadUnk.ok);

repoRoot := project.findRepoRoot();
test.checkBool("repo root found", true, repoRoot =!= "");
entJson := fs.readText(path.join(repoRoot, "benchmark/challenges/tools/html-entities.json")).text;
test.checkText("html entities match sample", "<x> & 🙂 € ¬it; &unknown;", challenges.unescapeChallengeHtml(entJson, "&lt;x&gt; &amp; &#x1F642; &#128; &notit; &unknown;"));
rep := unicode.fromCodePoint(65533).text;
test.checkText("html numeric edge", rep + " " + rep + " " + rep + " ", challenges.unescapeChallengeHtml(entJson, "&#0; &#xD800; &#x110000; &#11;"));

tmpRes := fs.makeTempDir("lite-challenge-bench-test-");
test.checkBool("temp dir ok", true, tmpRes.ok);
bad := challenges.validateChallengeBenchmark(tmpRes.path);
test.checkBool("missing index fails", false, bad.ok);

synRoot := path.join(tmpRes.path, "corpus");
_m1 := fs.makeDir(path.join(synRoot, "data"));
_m2 := fs.makeDir(path.join(synRoot, "schema"));
_m3 := fs.makeDir(path.join(synRoot, ".cache/benchmark/euler/statements"));
_m4 := fs.makeDir(path.join(synRoot, ".cache/benchmark/leetcode"));
_m5 := fs.makeDir(path.join(synRoot, ".cache/leetcode"));
_wt := fs.writeText(path.join(synRoot, "schema/taxonomy.json"), "{\"topics\":[{\"id\":\"math\"},{\"id\":\"arrays\"}]}\n");
_wi := fs.writeText(path.join(synRoot, "data/index.json"), "{\"total\":2,\"sources\":[{\"name\":\"project-euler\",\"count\":1},{\"name\":\"leetcode\",\"count\":1}]}\n");
_wc := fs.writeText(path.join(synRoot, "data/challenges.jsonl"),
"{\"id\":\"pe-1\",\"title\":\"Multiples\",\"source\":\"project-euler\",\"url\":\"https://example.invalid/pe/1\",\"native_id\":\"1\",\"number\":1,\"category\":\"mathematics\",\"primary_topic\":\"math\",\"topics\":[\"math\"],\"raw_topics\":[],\"tags\":[],\"difficulty\":{\"scale\":\"pe\",\"raw\":1,\"normalized\":1.5},\"formats\":[\"single\"],\"languages\":[\"all\"],\"topics_source\":\"curated\",\"popularity\":null,\"premium\":false,\"status\":\"verified\"}\n"
+ "{\"id\":\"lc-1\",\"title\":\"Two Sum\",\"source\":\"leetcode\",\"url\":\"https://example.invalid/lc/1\",\"native_id\":\"1\",\"number\":1,\"category\":\"algorithms\",\"primary_topic\":\"arrays\",\"topics\":[\"arrays\"],\"raw_topics\":[],\"tags\":[],\"difficulty\":{\"scale\":\"lc\",\"raw\":\"Easy\",\"normalized\":2},\"formats\":[\"function\"],\"languages\":[\"all\"],\"topics_source\":\"source\",\"popularity\":{\"solved\":100},\"premium\":false,\"status\":\"verified\"}\n");
_wl := fs.writeText(path.join(synRoot, "data/lists.jsonl"), "{\"id\":\"blind-75\",\"title\":\"Blind 75\",\"kind\":\"set\",\"source\":\"leetcode\",\"url\":\"https://example.invalid\",\"description\":\"list\",\"count\":1,\"challenge_ids\":[\"lc-1\"]}\n");
_ws := fs.writeText(path.join(synRoot, "data/tests.jsonl"),
"{\"challenge_id\":\"pe-1\",\"url\":\"https://example.invalid/pe/1\",\"source\":\"project-euler\",\"format\":\"single-answer\",\"status\":\"not-applicable\",\"public\":[],\"hidden\":[],\"hidden_policy\":\"none\",\"note\":null}\n"
+ "{\"challenge_id\":\"lc-1\",\"url\":\"https://example.invalid/lc/1\",\"source\":\"leetcode\",\"format\":\"function\",\"status\":\"public-only\",\"public\":[{\"name\":\"example-1\",\"kind\":\"example\",\"input\":\"x = [1]\",\"output\":\"1\",\"explanation\":null}],\"hidden\":[],\"hidden_policy\":\"none\",\"note\":null}\n");

valOk := challenges.validateChallengeCorpus(synRoot);
test.checkText("synthetic corpus err", "", valOk.error);
test.checkBool("synthetic corpus ok", true, valOk.ok);
test.checkText("synthetic corpus summary", "OK: 2 challenges, 1 lists, 2 topics, 2 used\n    tests: 1 with public cases, 0 with held-out cases", valOk.summaryText);

_ea := fs.writeText(path.join(synRoot, ".cache/benchmark/euler/Answers.txt"), "Problem 1: 233168\n");
_et := fs.writeText(path.join(synRoot, ".cache/benchmark/euler/tree.json"), "{\"tree\":[{\"type\":\"blob\",\"path\":\"python/p001.py\"}]}\n");
_eh := fs.writeText(path.join(synRoot, ".cache/benchmark/euler/statements/problem-001.html"), "<h2>Multiples &amp; Sums</h2><div class=\"problem_content\" role=\"problem\"><p>Find the sum of all multiples of 3 or 5 below 1000 cleanly in mathematics.</p></div><br>");
bEuler := challenges.buildBenchmarkEuler(synRoot, entJson);
test.checkText("build euler err", "", bEuler.error);
test.checkBool("build euler ok", true, bEuler.ok);
test.checkInt("build euler count", 1, bEuler.writtenCount);

_lm := fs.writeText(path.join(synRoot, ".cache/leetcode/merged.json"), "{\"questions\":[{\"frontend_id\":1,\"problem_slug\":\"two-sum\",\"description\":\"Given an array of integers nums and an integer target, return indices.\\n\\nExample 1:\\nInput: nums = [1]\"}]}\n");
_lt := fs.writeText(path.join(synRoot, ".cache/benchmark/leetcode/tree.json"), "{\"tree\":[{\"type\":\"blob\",\"path\":\"solution/0000-0099/0001.Two Sum/Solution.py\"}]}\n");
bLc := challenges.buildBenchmarkLeetcode(synRoot);
test.checkText("build leetcode err", "", bLc.error);
test.checkBool("build leetcode ok", true, bLc.ok);
test.checkInt("build leetcode count", 1, bLc.writtenCount);
test.checkInt("combined benchmark total", 2, bLc.totalCount);

bVal := challenges.validateChallengeBenchmark(path.join(synRoot, "benchmark"));
test.checkText("built synthetic benchmark valid err", "", bVal.error);
test.checkBool("built synthetic benchmark valid", true, bVal.ok);

testsRoot := path.join(tmpRes.path, "tests-corpus");
_tm1 := fs.makeDir(path.join(testsRoot, "data"));
_tm2 := fs.makeDir(path.join(testsRoot, "schema"));
_tm3 := fs.makeDir(path.join(testsRoot, ".cache/leetcode"));
_tm4 := fs.makeDir(path.join(testsRoot, ".cache/tests/cses"));
_tm5 := fs.makeDir(path.join(testsRoot, ".cache/tests/atcoder"));
_wt2 := fs.writeText(path.join(testsRoot, "schema/taxonomy.json"), "{\"topics\":[{\"id\":\"math\"},{\"id\":\"arrays\"}]}\n");
_wi2 := fs.writeText(path.join(testsRoot, "data/index.json"), "{\"total\":3,\"sources\":[{\"name\":\"project-euler\",\"count\":1},{\"name\":\"leetcode\",\"count\":1},{\"name\":\"cses\",\"count\":1}]}\n");
_wc2 := fs.writeText(path.join(testsRoot, "data/challenges.jsonl"),
"{\"id\":\"pe-1\",\"title\":\"One\",\"source\":\"project-euler\",\"url\":\"https://example.invalid/pe/1\",\"native_id\":\"1\",\"number\":1,\"category\":\"mathematics\",\"primary_topic\":\"math\",\"topics\":[\"math\"],\"raw_topics\":[],\"tags\":[],\"difficulty\":{\"scale\":\"pe\",\"raw\":1,\"normalized\":1.5},\"formats\":[\"single\"],\"languages\":[\"all\"],\"topics_source\":\"curated\",\"popularity\":null,\"premium\":false,\"status\":\"verified\"}\n"
+ "{\"id\":\"lc-1\",\"title\":\"Two Sum\",\"source\":\"leetcode\",\"url\":\"https://example.invalid/lc/1\",\"native_id\":\"1\",\"number\":1,\"category\":\"algorithms\",\"primary_topic\":\"arrays\",\"topics\":[\"arrays\"],\"raw_topics\":[],\"tags\":[],\"difficulty\":{\"scale\":\"lc\",\"raw\":\"Easy\",\"normalized\":2},\"formats\":[\"function\"],\"languages\":[\"all\"],\"topics_source\":\"source\",\"popularity\":{\"solved\":100},\"premium\":false,\"status\":\"verified\"}\n"
+ "{\"id\":\"cses-1\",\"title\":\"Weird\",\"source\":\"cses\",\"url\":\"https://example.invalid/cses/1\",\"native_id\":\"1\",\"number\":1,\"category\":\"algorithms\",\"primary_topic\":\"arrays\",\"topics\":[\"arrays\"],\"raw_topics\":[],\"tags\":[],\"difficulty\":{\"scale\":\"cses\",\"raw\":\"Intro\",\"normalized\":3},\"formats\":[\"stdio\"],\"languages\":[\"all\"],\"topics_source\":\"section\",\"popularity\":null,\"premium\":false,\"status\":\"verified\"}\n");
_wl2 := fs.writeText(path.join(testsRoot, "data/lists.jsonl"), "{\"id\":\"all\",\"title\":\"All\",\"kind\":\"set\",\"source\":\"leetcode\",\"url\":\"https://example.invalid\",\"description\":\"all\",\"count\":1,\"challenge_ids\":[\"lc-1\"]}\n");
_wm2 := fs.writeText(path.join(testsRoot, ".cache/leetcode/merged.json"), "{\"questions\":[{\"frontend_id\":1,\"problem_slug\":\"two-sum\",\"examples\":[{\"example_text\":\"Input: x = [1]\\nOutput: 1\\nExplanation: done\"},{\"example_text\":\"Input: x = [2]\\nOutput: 2\"}]}]}\n");
_wcs := fs.writeText(path.join(testsRoot, ".cache/tests/cses/cses-1.html"), "<h1 id=\"example\">Example</h1><p>Input:</p><pre>3</pre><p>Output:</p><pre>3 10 5 16 8 4 2 1</pre>");

btRes := challenges.buildChallengeTests(testsRoot, entJson);
test.checkText("build tests err", "", btRes.error);
test.checkBool("build tests ok", true, btRes.ok);
btVal := challenges.validateChallengeCorpus(testsRoot);
test.checkText("built tests validate err", "", btVal.error);
test.checkBool("built tests validate ok", true, btVal.ok);

_rm := fs.remove(tmpRes.path);
test.done("util-challenges");
