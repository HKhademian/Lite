verify := import "util/verify";
text := import "core/text";
test := import "core/test";

test.checkBool("usage mentions --coverage", true, text.indexOfText(verify.usageText(), "--coverage", 0) >= 0);

defOpts := verify.parseVerifyArgs([]);
test.checkBool("default opts ok", true, defOpts.ok);
test.checkBool("default changed true", true, defOpts.changed);
test.checkBool("default cache true", true, defOpts.cache);
test.checkBool("default update false", false, defOpts.update);
test.checkBool("default coverage false", false, defOpts.coverage);
test.checkBool("default help false", false, defOpts.help);

helpOpts := verify.parseVerifyArgs(["--help"]);
test.checkBool("help opts ok", true, helpOpts.ok);
test.checkBool("help opts flag", true, helpOpts.help);

flagOpts := verify.parseVerifyArgs(["--all", "--no-cache", "--quiet", "--filter", "foundations/*", "--shard", "1/2"]);
test.checkBool("flag opts ok", true, flagOpts.ok);
test.checkBool("flag --all clears changed", false, flagOpts.changed);
test.checkBool("flag --no-cache clears cache", false, flagOpts.cache);
test.checkBool("flag --quiet sets quiet", true, flagOpts.quiet);
test.checkBool("flag hasFilter", true, flagOpts.hasFilter);
test.checkText("flag filter value", "foundations/*", flagOpts.filter);
test.checkBool("flag hasShard", true, flagOpts.hasShard);
test.checkInt("flag shardIndex", 1, flagOpts.shardIndex);
test.checkInt("flag shardCount", 2, flagOpts.shardCount);

eqOpts := verify.parseVerifyArgs(["--filter", "types/*", "--shard", "2/3", "--coverage", "--update"]);
test.checkBool("eq opts ok", true, eqOpts.ok);
test.checkBool("eq coverage", true, eqOpts.coverage);
test.checkBool("eq update", true, eqOpts.update);
test.checkText("eq filter", "types/*", eqOpts.filter);
test.checkInt("eq shardIndex", 2, eqOpts.shardIndex);
test.checkInt("eq shardCount", 3, eqOpts.shardCount);

badEqForm := verify.parseVerifyArgs(["--filter=types/*"]);
test.checkBool("equals form rejected", false, badEqForm.ok);

badShardZero := verify.parseVerifyArgs(["--shard", "0/2"]);
test.checkBool("shard 0/2 rejected", false, badShardZero.ok);

badShardRange := verify.parseVerifyArgs(["--shard", "3/2"]);
test.checkBool("shard 3/2 rejected", false, badShardRange.ok);

badFilterMissing := verify.parseVerifyArgs(["--filter"]);
test.checkBool("missing --filter value rejected", false, badFilterMissing.ok);

badUnknown := verify.parseVerifyArgs(["--unknown-flag"]);
test.checkBool("unknown flag rejected", false, badUnknown.ok);

test.done("util-verify");
