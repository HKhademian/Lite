/* Dual-target (TS + C11) tests for abstract `extra/color` and `extra/canvas` APIs. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
compilerBuild := import "../../tools/src/internal/compiler-build";
compilerTest := import "../../tools/src/internal/compiler-test";
project := import "../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
ccInfo := compilerTest.probeCc();

tmpRes := fs.makeTempDir("lite-extra-canvas-test-");
test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
tmpDir := tmpRes.path;
tsPng := path.join(tmpDir, "ts.png");
cPng := path.join(tmpDir, "c.png");

makeSrc := fn(outPng: String): String {
    "io := import \"core/io\";\n" +
    "color := import \"extra/color\";\n" +
    "canvas := import \"extra/surface\";\n" +
    "\n" +
    "zero: color.Color;\n" +
    "io.outputLine(zero.red8(), zero.green8(), zero.blue8(), zero.alpha8());\n" +
    "c1 := color.Color.fromRgb8(255, 128, 0);\n" +
    "io.outputLine(c1.red8(), c1.green8(), c1.blue8(), c1.alpha8());\n" +
    "mid := color.BLACK.mix(color.WHITE, 0.5);\n" +
    "io.outputLine(mid.red8(), mid.alpha8());\n" +
    "h := color.Color.fromHsl(120.0, 1.0, 0.5);\n" +
    "io.outputLine(h.red8(), h.green8(), h.blue8());\n" +
    "\n" +
    "surf := canvas.Surface.open(\"Test\", 64, 48);\n" +
    "inp := surf.poll();\n" +
    "io.outputLine(inp.open, inp.width, inp.height);\n" +
    "surf.clear(color.Color.fromRgb(0.1, 0.2, 0.3));\n" +
    "surf.fillRect(canvas.rect(4.0, 4.0, 20.0, 12.0), canvas.RED);\n" +
    "surf.strokeRect(canvas.rect(2.0, 2.0, 60.0, 44.0), 2.0, canvas.WHITE);\n" +
    "surf.fillCircle(canvas.point(32.0, 24.0), 10.0, canvas.CYAN.withAlphaFloat(0.5));\n" +
    "surf.strokeLine(canvas.point(0.0, 0.0), canvas.point(63.0, 47.0), 2.0, canvas.YELLOW);\n" +
    "surf.setClipRect(canvas.rect(4.0, 4.0, 56.0, 40.0));\n" +
    "surf.fillTriangle(canvas.point(10.0, 10.0), canvas.point(40.0, 12.0), canvas.point(22.0, 36.0), canvas.MAGENTA);\n" +
    "surf.clearClipRect();\n" +
    "surf.drawText(\"Score: 100% [a-z] {ok}\", canvas.point(4.0, 28.0), 7.0, canvas.WHITE);\n" +
    "tex := canvas.Texture.create(4, 4);\n" +
    "tex.setPixel(1, 1, canvas.GREEN);\n" +
    "tex.setPixel(2, 2, canvas.YELLOW);\n" +
    "surf.blit(tex, canvas.point(6.0, 6.0));\n" +
    "surf.blitScaled(tex, canvas.rect(12.0, 6.0, 8.0, 8.0));\n" +
    "io.outputLine(tex.width(), tex.height(), surf.isKeyDown(\"Space\"), surf.isKeyPressed(\"a\"), surf.isKeyReleased(\"a\"), surf.isPointerPressed(), surf.isPointerReleased(), surf.wheelDelta());\n" +
    "tex.destroy();\n" +
    "m0 := canvas.scratchMark();\n" +
    "_tmpHud := \"HUD=\" + (42).toText();\n" +
    "canvas.scratchRewind(m0);\n" +
    "surf.present();\n" +
    "v0 := surf.vitals();\n" +
    "surf.setTargetFps(120.0);\n" +
    "v1 := surf.vitals();\n" +
    "surf.uncapFrameRate();\n" +
    "v2 := surf.vitals();\n" +
    "io.outputLine(v0.frameCount, v0.targetFps == 60.0, v1.targetFps == 120.0, v2.targetFps == 0.0, v0.frameTimeMs > 0.0, v0.memoryBytes > 0);\n" +
    "sz0 := surf.size();\n" +
    "pos0 := surf.position();\n" +
    "surf.resize(96, 72);\n" +
    "surf.setFullscreen(true);\n" +
    "b1 := surf.bounds();\n" +
    "surf.toggleFullscreen();\n" +
    "io.outputLine(sz0.width, sz0.height, pos0.x >= 0, b1.width, b1.height, b1.fullscreen, surf.isFullscreen());\n" +
    "surf.resize(64, 48);\n" +
    "cap := surf.capture(\"" + outPng + "\");\n" +
    "io.outputLine(cap.ok, cap.error);\n" +
    "surf.close();\n"
};

expected :=
"0 0 0 0\n" +
"255 128 0 255\n" +
"128 255\n" +
"0 255 0\n" +
"true 64 48\n" +
"4 4 false false false false false 0\n" +
"1 true true true true true\n" +
"64 48 true 96 72 true false\n" +
"true \n";

/* 1. TS target headless verification */
tsSrc := makeSrc(tsPng);
tsComp := compilerTest.compileStdin(root, selTs.path, tsSrc, "");
test.checkInt("ts compile status: " + tsComp.stderr, 0, tsComp.status);
tsOutFile := path.join(tmpDir, "ts.ts");
test.check("write ts.ts", fs.writeText(tsOutFile, tsComp.stdout).ok);
tsRun := proc.run(project.nodeExecPath(), [tsOutFile], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
test.checkInt("ts run status: " + tsRun.stderr, 0, tsRun.status);
test.checkText("ts stdout", expected, tsRun.stdout);
tsPngBytes := fs.readBytes(tsPng);
test.check("ts png exists and has PNG signature", tsPngBytes.length() > 32 and
tsPngBytes[0] == 137 and tsPngBytes[1] == 80 and tsPngBytes[2] == 78 and tsPngBytes[3] == 71);

/* 2. C11 target headless verification */
if ccInfo.available {
    cSrc := makeSrc(cPng);
    cComp := compilerTest.compileStdin(root, selC.path, cSrc, "");
    test.checkInt("c compile status: " + cComp.stderr, 0, cComp.status);
    cFile := path.join(tmpDir, "c_app.c");
    cBin := path.join(tmpDir, "c_app");
    test.check("write c_app.c", fs.writeText(cFile, cComp.stdout).ok);
    ccArgs: List<String> = if proc.platform() == "darwin" {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cFile, "-o", cBin, "-lm", "-framework", "Cocoa", "-framework", "CoreGraphics"]
    } else {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cFile, "-o", cBin, "-lm"]
    };
    ccRes := proc.run(ccInfo.cc, ccArgs, tmpDir, [], true, "");
    test.checkInt("c cc status: " + ccRes.stderr, 0, ccRes.status);
    cRun := proc.run(cBin, [], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
    test.checkInt("c run status: " + cRun.stderr, 0, cRun.status);
    test.checkText("c stdout parity", tsRun.stdout, cRun.stdout);
    cPngBytes := fs.readBytes(cPng);
    test.check("c png exists and has PNG signature", cPngBytes.length() > 32 and
    cPngBytes[0] == 137 and cPngBytes[1] == 80 and cPngBytes[2] == 78 and cPngBytes[3] == 71);

    /* 3. C11 AddressSanitizer + UBSan + 5,000-frame RSS stability leak gate (with frame-scratch HUD strings, triangles, clipping, and texture blits) */
    leakSrc :=
    "io := import \"core/io\";\n" +
    "canvas := import \"extra/surface\";\n" +
    "surf := canvas.Surface.open(\"LeakCheck\", 160, 120);\n" +
    "surf.uncapFrameRate();\n" +
    "spr := canvas.Texture.create(4, 4);\n" +
    "spr.setPixel(1, 1, canvas.GREEN);\n" +
    "var rssStart := 0;\n" +
    "var i := 0;\n" +
    "loop i < 5000 {\n" +
    "    mk := canvas.scratchMark();\n" +
    "    _inp := surf.poll();\n" +
    "    surf.clear(canvas.BLACK);\n" +
    "    surf.setClipRect(canvas.rect(4.0, 4.0, 152.0, 112.0));\n" +
    "    surf.fillRect(canvas.rect(10.0, 10.0, 40.0, 30.0), canvas.RED);\n" +
    "    surf.fillTriangle(canvas.point(60.0, 15.0), canvas.point(110.0, 20.0), canvas.point(80.0, 60.0), canvas.YELLOW);\n" +
    "    surf.fillCircle(canvas.point(80.0, 60.0), 20.0, canvas.CYAN.withAlphaFloat(0.5));\n" +
    "    surf.blitScaled(spr, canvas.rect(120.0, 10.0, 16.0, 16.0));\n" +
    "    hud := \"FRAME \" + i.toText() + \" SCORE=\" + (i * 10).toText();\n" +
    "    surf.drawText(hud, canvas.point(12.0, 12.0), 14.0, canvas.WHITE);\n" +
    "    surf.clearClipRect();\n" +
    "    surf.present();\n" +
    "    canvas.scratchRewind(mk);\n" +
    "    if i == 500 { rssStart = surf.vitals().memoryBytes; }\n" +
    "    i = i + 1;\n" +
    "}\n" +
    "spr.destroy();\n" +
    "rssEnd := surf.vitals().memoryBytes;\n" +
    "growth := rssEnd - rssStart;\n" +
    "io.outputLine(growth <= 1048576);\n" +
    "surf.close();\n";
    leakComp := compilerTest.compileStdin(root, selC.path, leakSrc, "");
    test.checkInt("leak c compile: " + leakComp.stderr, 0, leakComp.status);
    leakCFile := path.join(tmpDir, "leak.c");
    leakBin := path.join(tmpDir, "leak");
    test.check("write leak.c", fs.writeText(leakCFile, leakComp.stdout).ok);
    asanArgs: List<String> = if proc.platform() == "darwin" {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-fsanitize=address,undefined", leakCFile, "-o", leakBin, "-lm", "-framework", "Cocoa", "-framework", "CoreGraphics"]
    } else {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-fsanitize=address,undefined", leakCFile, "-o", leakBin, "-lm"]
    };
    asanCc := proc.run(ccInfo.cc, asanArgs, tmpDir, [], true, "");
    test.checkInt("asan cc status: " + asanCc.stderr, 0, asanCc.status);
    asanRun := proc.run(leakBin, [], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
    test.checkInt("asan run status: " + asanRun.stderr, 0, asanRun.status);
    test.checkText("5000-frame RSS growth <= 1MB", "true\n", asanRun.stdout);
}

/* 4. Host-driven `surface.run` callback loop parity (TS + C11) */
runSrc :=
"io := import \"core/io\";\n" +
"surf := import \"extra/surface\";\n" +
"win := surf.Surface.open(\"RunLoop\", 32, 24);\n" +
"win.uncapFrameRate();\n" +
"var frames := 0;\n" +
"win.run(fn(inp: surf.FrameInput): Bool {\n" +
"    if not inp.open { return false; }\n" +
"    win.clear(surf.BLACK);\n" +
"    win.fillRect(surf.rect(frames * 1.0, 2.0, 4.0, 4.0), surf.RED);\n" +
"    frames = frames + 1;\n" +
"    frames < 5\n" +
"});\n" +
"vit := win.vitals();\n" +
"io.outputLine(frames, vit.frameCount);\n" +
"win.close();\n";

runExpected := "5 4\n";
tsRunLoopComp := compilerTest.compileStdin(root, selTs.path, runSrc, "");
test.checkInt("run loop ts compile: " + tsRunLoopComp.stderr, 0, tsRunLoopComp.status);
tsRunLoopFile := path.join(tmpDir, "run_loop.ts");
test.check("write run_loop.ts", fs.writeText(tsRunLoopFile, tsRunLoopComp.stdout).ok);
tsRunLoopExec := proc.run(project.nodeExecPath(), [tsRunLoopFile], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
test.checkInt("run loop ts exec: " + tsRunLoopExec.stderr, 0, tsRunLoopExec.status);
test.checkText("run loop ts stdout", runExpected, tsRunLoopExec.stdout);

if ccInfo.available {
    cRunLoopComp := compilerTest.compileStdin(root, selC.path, runSrc, "");
    test.checkInt("run loop c compile: " + cRunLoopComp.stderr, 0, cRunLoopComp.status);
    cRunLoopFile := path.join(tmpDir, "run_loop.c");
    cRunLoopBin := path.join(tmpDir, "run_loop");
    test.check("write run_loop.c", fs.writeText(cRunLoopFile, cRunLoopComp.stdout).ok);
    runCcArgs: List<String> = if proc.platform() == "darwin" {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cRunLoopFile, "-o", cRunLoopBin, "-lm", "-framework", "Cocoa", "-framework", "CoreGraphics"]
    } else {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cRunLoopFile, "-o", cRunLoopBin, "-lm"]
    };
    runCcRes := proc.run(ccInfo.cc, runCcArgs, tmpDir, [], true, "");
    test.checkInt("run loop c cc: " + runCcRes.stderr, 0, runCcRes.status);
    cRunLoopExec := proc.run(cRunLoopBin, [], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
    test.checkInt("run loop c exec: " + cRunLoopExec.stderr, 0, cRunLoopExec.status);
    test.checkText("run loop c stdout parity", tsRunLoopExec.stdout, cRunLoopExec.stdout);
}

/* 5. Rebased `extra/canvas` (`unsetPixel`, `show`, `start`) dual-target parity (TS + C11) */
rebasedSrc :=
"io := import \"core/io\";\n" +
"cv := import \"extra/canvas\";\n" +
"_c0 := cv.create(width = 8, height = 6, title = \"StaticPixel\");\n" +
"cv.clear(cv.rgb(10, 20, 30));\n" +
"cv.setPixel(2, 2, cv.rgb(255, 0, 0));\n" +
"cv.unsetPixel(2, 2);\n" +
"cv.show();\n" +
"_c1 := cv.play(width = 8, height = 6, title = \"AnimPixel\");\n" +
"var ticks := 0;\n" +
"cv.start(fn(dt: Float): Int {\n" +
"    _d := dt;\n" +
"    cv.clear(cv.rgb(0, 0, 0));\n" +
"    cv.setPixel(ticks, 1, cv.rgb(0, 255, 0));\n" +
"    ticks = ticks + 1;\n" +
"    if ticks < 3 { 0 } else { 1 }\n" +
"});\n" +
"io.outputLine(ticks, cv.getOps().length());\n";

rebasedExp := "3 0\n";
tsRebComp := compilerTest.compileStdin(root, selTs.path, rebasedSrc, "");
test.checkInt("rebased canvas ts compile: " + tsRebComp.stderr, 0, tsRebComp.status);
tsRebFile := path.join(tmpDir, "rebased.ts");
test.check("write rebased.ts", fs.writeText(tsRebFile, tsRebComp.stdout).ok);
tsRebExec := proc.run(project.nodeExecPath(), [tsRebFile], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
test.checkInt("rebased canvas ts exec: " + tsRebExec.stderr, 0, tsRebExec.status);
test.checkText("rebased canvas ts stdout", rebasedExp, tsRebExec.stdout);

if ccInfo.available {
    cRebComp := compilerTest.compileStdin(root, selC.path, rebasedSrc, "");
    test.checkInt("rebased canvas c compile: " + cRebComp.stderr, 0, cRebComp.status);
    cRebFile := path.join(tmpDir, "rebased.c");
    cRebBin := path.join(tmpDir, "rebased");
    test.check("write rebased.c", fs.writeText(cRebFile, cRebComp.stdout).ok);
    rebCcArgs: List<String> = if proc.platform() == "darwin" {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cRebFile, "-o", cRebBin, "-lm", "-framework", "Cocoa", "-framework", "CoreGraphics"]
    } else {
        ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cRebFile, "-o", cRebBin, "-lm"]
    };
    rebCcRes := proc.run(ccInfo.cc, rebCcArgs, tmpDir, [], true, "");
    test.checkInt("rebased canvas c cc: " + rebCcRes.stderr, 0, rebCcRes.status);
    cRebExec := proc.run(cRebBin, [], root, ["LITE_CANVAS_HEADLESS=1"], true, "");
    test.checkInt("rebased canvas c exec: " + cRebExec.stderr, 0, cRebExec.status);
    test.checkText("rebased canvas c stdout parity", tsRebExec.stdout, cRebExec.stdout);
}

_rm := fs.remove(tmpDir);
test.done("extra-canvas");
