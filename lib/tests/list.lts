list := import "core/list";
test := import "core/test";

texts: List<String> = ["a", "b", "c"];
test.checkInt("list index text", 1, texts.indexOf("b"));
test.checkInt("list index text absent", -1, texts.indexOf("z"));
test.checkBool("list contains text", true, texts.contains("c"));
test.checkBool("list lacks text", false, texts.contains("z"));

ints: List<Int> = [3, 5, 8];
test.checkInt("list index int", 2, ints.indexOf(8));
test.checkBool("list contains int", true, ints.contains(5));
test.checkBool("list lacks int", false, ints.contains(4));

flags: List<Bool> = [false, true];
test.checkInt("list index bool", 1, flags.indexOf(true));
test.checkBool("list contains bool", true, flags.contains(false));

test.checkInt("list count text", 3, texts.length());
test.checkInt("list count int", 3, ints.length());
test.checkInt("list count bool", 2, flags.length());

nums: List<Int> = [4, 1, 4, 2, 1, 3];
test.checkText("list sort ints", "1,1,2,3,4,4", nums.sort().map(fn(x: Int): String { x.toText() }).join(","));
test.checkText("list sort desc", "4,4,3,2,1,1", nums.sortBy(fn(a: Int, b: Int): Bool { a >= b }).map(fn(x: Int): String { x.toText() }).join(","));
test.checkText("list dedup ints", "4,1,2,3", nums.dedup().map(fn(x: Int): String { x.toText() }).join(","));

words: List<String> = ["pear", "fig", "pear", "apple"];
test.checkText("list sort texts", "apple,fig,pear,pear", words.sortTexts().join(","));
test.checkText("list dedup texts", "pear,fig,apple", words.dedup().join(","));

total := nums.fold(0, fn(acc: Int, x: Int): Int { acc + x });
test.checkInt("list fold", 15, total);
test.checkBool("list any > 3", true, nums.any(fn(x: Int): Bool { x > 3 }));
test.checkBool("list any > 9", false, nums.any(fn(x: Int): Bool { x > 9 }));
test.checkBool("list all > 0", true, nums.all(fn(x: Int): Bool { x > 0 }));
test.checkBool("list all > 1", false, nums.all(fn(x: Int): Bool { x > 1 }));
test.checkInt("list findIndex == 2", 3, nums.findIndex(fn(x: Int): Bool { x == 2 }));
test.checkInt("list findIndex missing", -1, nums.findIndex(fn(x: Int): Bool { x == 99 }));
hit := nums.find(fn(x: Int): Bool { x > 2 and x < 4 });
test.checkBool("list find hit", true, hit.found);
test.checkInt("list find hit val", 3, hit.value);
miss := nums.find(fn(x: Int): Bool { x == 99 });
test.checkBool("list find miss", false, miss.found);

test.checkText("array join", "a-b", ["a", "b"].join("-"));
test.checkInt("array map len", 3, [1, 2, 3].map(fn(x: Int): Int { x * 10 }).length());
test.checkInt("array map elem", 20, [1, 2, 3].map(fn(x: Int): Int { x * 10 })[1]);
test.checkText("array filter", "2,4", [1, 2, 3, 4].filter(fn(x: Int): Bool { x % 2 == 0 }).map(fn(x: Int): String { x.toText() }).join(","));
test.checkInt("array fold", 6, [1, 2, 3].fold(0, fn(acc: Int, x: Int): Int { acc + x }));
test.checkBool("array any", true, [1, 2, 3].any(fn(x: Int): Bool { x == 2 }));
test.checkBool("array all", true, [1, 2, 3].all(fn(x: Int): Bool { x > 0 }));
test.checkInt("array indexOf", 1, ["x", "y", "z"].indexOf("y"));
test.checkBool("array contains", true, [10, 20].contains(20));
test.checkText("array dedup", "1,2,3", [1, 2, 1, 3].dedup().map(fn(x: Int): String { x.toText() }).join(","));
test.checkText("array sort", "1,2,3", [3, 1, 2].sort().map(fn(x: Int): String { x.toText() }).join(","));
test.checkText("array sortTexts", "a,z", ["z", "a"].sortTexts().join(","));

test.done("list");
