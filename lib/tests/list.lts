integer := import "../core/int.lts";
list := import "../core/list.lts";
test := import "../core/test.lts";

texts: List<String> = ["a", "b", "c"];
test.checkInt("list index text", 1, list.listIndexOfText(texts, "b"));
test.checkInt("list index text absent", -1, list.listIndexOfText(texts, "z"));
test.checkBool("list contains text", true, list.listContainsText(texts, "c"));
test.checkBool("list lacks text", false, list.listContainsText(texts, "z"));

ints: List<Int> = [3, 5, 8];
test.checkInt("list index int", 2, list.listIndexOfInt(ints, 8));
test.checkBool("list contains int", true, list.listContainsInt(ints, 5));
test.checkBool("list lacks int", false, list.listContainsInt(ints, 4));

flags: List<Bool> = [false, true];
test.checkInt("list index bool", 1, list.listIndexOfBool(flags, true));
test.checkBool("list contains bool", true, list.listContainsBool(flags, false));

test.done("list");
