fs := import "core/file";
test := import "core/test";
path := import "core/path";
json := import "data/json";
docgen := import "lite/docgen";
project := import "../../tools/src/internal/project";

sampleModule := "/* Example universal module. */\n\n/** Hidden private constant doc. */\npriv := 1;\n\n/** Public alias type. */\npub Pair := alias (a: Int, b: Int);\n\n/** Host signature with multiline params. */\npub probe := fn(\n    first: String,\n    second: Int\n): Bool;\n\n/** Normal implemented fn. */\npub add := fn(x: Int, y: Int): Int {\n    x + y\n}\n";

modJson := docgen.extractModuleJson(sampleModule, "core", "sample", "lib/core/sample.lts");
validMod := json.validate(modJson);
test.checkBool("sample module json valid", true, validMod.ok);
test.checkText("module id", "core/sample", json.readFieldString(modJson, 0, "id").value);
test.checkText("module env", "universal", json.readFieldString(modJson, 0, "environment").value);
test.checkText("module summary", "Example universal module.", json.readFieldString(modJson, 0, "summary").value);
test.checkBool("type symbol present", true, modJson.contains("\"kind\":\"type\",\"name\":\"Pair\""));
test.checkBool("host decl normalized", true, modJson.contains("\"signature\":\"pub probe := fn(first: String, second: Int): Bool;\",\"isHostDeclaration\":true"));
test.checkBool("impl fn not host", true, modJson.contains("\"signature\":\"pub add := fn(x: Int, y: Int): Int\",\"isHostDeclaration\":false"));
test.checkBool("private omitted", false, modJson.contains("\"priv\""));

opsSource := "pub make := fn(): Int { 0 }\n"
    + "pub Vec.empty := fn<T: Type<math.Numeric>>(): Self<T, 2> { 0 }\n"
    + "pub Vec.from := fn<T: Type<math.Numeric>>(values: [T; 2]): Self<T, 2> { 0 }\n"
    + "pub Vec.copy := fn<T: Type<math.Numeric>>(value: Vec<T, 2>): Self<T, 2> { 0 }\n"
    + "pub Vec.dim := fn<T: Type<math.Numeric>>(v: Self<T, 2>): Int { 2 }\n"
    + "pub Vec.set := fn<T: Type<math.Numeric>>(v: /* lease */ mut /* receiver */ Self<T, 2>, n: Int): Unit { }\n";
opsJson := docgen.extractModuleJson(opsSource, "math", "vec", "lib/math/vec.lt");
opsField := json.findField(opsJson, 0, "symbols");
opsOffsets := json.arrayOffsets(opsJson, opsField.valuePos);
expectedKinds: List<String> = ["module", "static", "static", "static", "instance", "instance"];
test.checkInt("function count", expectedKinds.length(), opsOffsets.length());
loop 0..opsOffsets.length() as i {
    op := opsOffsets[i];
    opName := json.readFieldString(opsJson, op, "name").value;
    test.checkText(opName + " function kind", expectedKinds[i], json.readFieldString(opsJson, op, "functionKind").value);
}

rootDir := project.findRepoRoot();
test.checkBool("repo root found", true, rootDir =!= "");
allJson := docgen.extractAllModulesJson(rootDir);
validAll := json.validate(allJson);
test.checkBool("all modules json valid", true, validAll.ok);
test.checkBool("includes core/io", true, allJson.contains("\"id\":\"core/io\""));
test.checkBool("includes core/text", true, allJson.contains("\"id\":\"core/text\""));
test.checkBool("includes extra/canvas", true, allJson.contains("\"id\":\"extra/canvas\",\"namespace\":\"extra\",\"name\":\"canvas\",\"file\":\"lib/extra/canvas.lt\",\"environment\":\"play\""));
test.checkBool("core/file is cli", true, allJson.contains("\"id\":\"core/file\",\"namespace\":\"core\",\"name\":\"file\",\"file\":\"lib/core/file.lt\",\"environment\":\"cli\""));

test.done("util-docgen");
