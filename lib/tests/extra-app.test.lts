/* Dual-target (TS + C11) and ASan/UBSan tests for `math/vector`, `math/matrix`, `ds/grid`, and `extra/timer`. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
ccInfo := compilerTest.probeCc();

tmpRes := fs.makeTempDir("lite-extra-app-test-");
test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
tmpDir := tmpRes.path;

functionalSrc :=
"io := import \"core/io\";\n" +
"math := import \"math/scalar\";\n" +
"vec := import \"math/vector\";\n" +
"mat := import \"math/matrix\";\n" +
"grid := import \"ds/grid\";\n" +
"timer := import \"extra/timer\";\n" +
"\n" +
"near := fn(a: Float, b: Float): Bool { math.abs(a - b) < 0.0001 };\n" +
"\n" +
"/* 1. math/vector (nominal TypeName.op) */\n" +
"v := vec.vec2(3.0, 4.0);\n" +
"vn := v.normalize();\n" +
"vr := vec.vec2(1.0, 0.0).rotate(math.PI * 0.5);\n" +
"c3 := vec.UNIT_X3.cross(vec.UNIT_Y3);\n" +
"rf := vec.vec3(1.0, -1.0, 0.0).reflect(vec.UNIT_Y3);\n" +
"vDot := v.normalize().dot(vec.vec2(1.0, 0.0));\n" +
"c3Dot := vec.UNIT_X3.cross(vec.UNIT_Y3).length();\n" +
"io.outputLine(\"vec\", near(v.length(), 5.0), near(vn.x, 0.6), near(vr.x, 0.0), near(vr.y, 1.0), near(c3.z, 1.0), near(rf.x, 1.0), near(rf.y, 1.0), near(v.length(), 5.0), near(vDot, 0.6), near(c3Dot, 1.0));\n" +
"\n" +
"/* 2. math/matrix */\n" +
"m2 := mat.rotation2(math.PI * 0.5);\n" +
"p2 := mat.mulVec2(m2, vec.vec2(1.0, 0.0));\n" +
"aff := mat.mul3(mat.translate2(10.0, 20.0), mat.scale2(2.0, 3.0));\n" +
"tp2 := mat.transformPoint2(aff, vec.vec2(4.0, 5.0));\n" +
"m4 := mat.mul4(mat.translate3(1.0, 2.0, 3.0), mat.rotateZ(math.PI * 0.5));\n" +
"tp3 := mat.transformPoint3(m4, vec.vec3(1.0, 0.0, 0.0));\n" +
"io.outputLine(\"mat\", near(mat.det2(m2), 1.0), near(p2.y, 1.0), near(tp2.x, 18.0), near(tp2.y, 35.0), near(mat.det3(aff), 6.0), near(tp3.x, 1.0), near(tp3.y, 3.0), near(tp3.z, 3.0));\n" +
"\n" +
"/* 3. ds/grid */\n" +
"g := grid.createInts(8, 6, 0);\n" +
"grid.fillIntRect(g, 1, 1, 3, 2, 7);\n" +
"_gs := grid.setInt(g, 0, 0, 9);\n" +
"g2 := grid.createInts(8, 6, 0);\n" +
"grid.copyInts(g2, g);\n" +
"io.outputLine(\"grid\", grid.intWidth(g), grid.intHeight(g), grid.getIntOr(g, 2, 2, -1), grid.getIntOr(g, 99, 0, -1), grid.countIntValue(g2, 7), grid.getIntOr(g2, 0, 0, -1));\n" +
"grid.destroyInts(g);\n" +
"grid.destroyInts(g2);\n" +
"\n" +
"fg := grid.createFloats(4, 4, 1.5);\n" +
"_fgs := grid.setFloat(fg, 2, 1, 3.25);\n" +
"io.outputLine(\"fgrid\", near(grid.getFloatOr(fg, 2, 1, 0.0), 3.25), near(grid.getFloatOr(fg, 0, 0, 0.0), 1.5));\n" +
"grid.destroyFloats(fg);\n" +
"\n" +
"/* 4. extra/timer */\n" +
"clk0 := timer.createClock(50.0, 0.1);\n" +
"adv1 := timer.advanceClock(clk0, 0.05);\n" +
"cd0 := timer.createCooldown(1.0, false);\n" +
"t0 := timer.trigger(cd0);\n" +
"cd1 := timer.tickCooldown(cd0, 1.0);\n" +
"t1 := timer.trigger(cd1);\n" +
"sw := timer.lap(timer.startStopwatch());\n" +
"el := timer.elapsedMs(sw);\n" +
"io.outputLine(\"timer\", adv1.lastSteps, near(adv1.alpha, 0.5), adv1.totalSteps, t0.fired, timer.isReady(cd1), t1.fired, near(timer.progress(t1), 0.0), el >= 0.0 and sw.lastLapMs >= 0.0);\n";

expectedOut :=
"vec true true true true true true true true true true\n" +
"mat true true true true true true true true\n" +
"grid 8 6 7 -1 6 9\n" +
"fgrid true true\n" +
"timer 2 true 2 false true true true true\n";

emptyEnv: List<String> = [];
tsComp := compilerTest.compileStdin(root, selTs.path, functionalSrc, "");
test.checkInt("TS compile status: " + tsComp.stderr, 0, tsComp.status);
tsOutFile := path.join(tmpDir, "functional.ts");
test.check("write functional.ts", fs.writeText(tsOutFile, tsComp.stdout).ok);
tsRunner := path.join(tmpDir, "runner.ts");
tsRunnerCode :=
"import { writeSync } from 'node:fs';\n" +
"import { main } from './functional.ts';\n" +
"const out = main((t: string): void => { writeSync(1, t); });\n" +
"if (typeof out === 'string' && out.length > 0) writeSync(1, out);\n";
test.check("write runner.ts", fs.writeText(tsRunner, tsRunnerCode).ok);
tsRun := proc.run(project.nodeExecPath(), [tsRunner], root, emptyEnv, true, "");
test.checkInt("TS run status: " + tsRun.stderr, 0, tsRun.status);
test.checkText("TS functional output", expectedOut, tsRun.stdout);

if ccInfo.available {
    cComp := compilerTest.compileStdin(root, selC.path, functionalSrc, "");
    test.checkInt("C11 compile status: " + cComp.stderr, 0, cComp.status);
    cFile := path.join(tmpDir, "functional.c");
    cBin := path.join(tmpDir, "functional");
    test.check("write functional.c", fs.writeText(cFile, cComp.stdout).ok);
    ccRes := proc.run(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cFile, "-o", cBin, "-lm"], tmpDir, emptyEnv, true, "");
    test.checkInt("C11 cc status: " + ccRes.stderr, 0, ccRes.status);
    cRun := proc.run(cBin, [], root, emptyEnv, true, "");
    test.checkInt("C11 run status: " + cRun.stderr, 0, cRun.status);
    test.checkText("C11 functional output matches TS", expectedOut, cRun.stdout);

    funcPath := path.join(tmpDir, "functional.lts");
    test.check("write functional.lts", fs.writeText(funcPath, functionalSrc).ok);
    sanBin := path.join(tmpDir, "app-san");
    buildSan := proc.run(path.join(root, "bin/lite"), ["build", "--sanitize", "--quiet", "-o", sanBin, funcPath], root, emptyEnv, true, "");
    test.check("ASan/UBSan build ok: " + buildSan.stderr, buildSan.status == 0 and buildSan.error == "");
    runSan := proc.run(sanBin, [], tmpDir, emptyEnv, true, "");
    test.check("ASan/UBSan exit 0: " + runSan.stderr, runSan.status == 0 and runSan.error == "");
    test.checkText("ASan/UBSan output", expectedOut, runSan.stdout);
}

fs.remove(tmpDir);
