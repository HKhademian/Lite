/* Dual-target (TS + C11) and ASan/UBSan tests for `ds/arena`, `ds/pool`, `ds/intern`, and `ds/lru`. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
ccInfo := compilerTest.probeCc();

tmpRes := fs.makeTempDir("lite-extra-memory-test-");
test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
tmpDir := tmpRes.path;

functionalSrc :=
"io := import \"core/io\";\n" +
"arena := import \"ds/arena\";\n" +
"pool := import \"ds/pool\";\n" +
"intern := import \"ds/intern\";\n" +
"lru := import \"ds/lru\";\n" +
"\n" +
"/* 1. ds/arena: byte arena + alignment + int32 + mark/rewind + reset + TypedArena<T> */\n" +
"mut a := arena.create(64);\n" +
"s1 := mut a.alloc(5);\n" +
"s2 := mut a.allocAligned(8, 8);\n" +
"badAlign := mut a.allocAligned(4, 3);\n" +
"ovf := mut a.alloc(100);\n" +
"io.outputLine(\"arena1\", s1.ok, s1.offset, s2.ok, s2.offset, badAlign.ok, ovf.ok);\n" +
"_w1 := mut a.writeByte(0, 255);\n" +
"_w2 := mut a.writeInt32(s2.offset, -123456);\n" +
"_w3 := mut a.writeInt32(s2.offset + 4, 987654);\n" +
"io.outputLine(\"arenaRW\", a.readByte(0), a.readInt32(s2.offset), a.readInt32(s2.offset + 4));\n" +
"m := a.mark();\n" +
"_s3 := mut a.alloc(16);\n" +
"usedBeforeRewind := a.usedBytes();\n" +
"rewOk := mut a.rewind(m);\n" +
"usedAfterRewind := a.usedBytes();\n" +
"mut a.reset();\n" +
"st := a.stats();\n" +
"io.outputLine(\"arenaStats\", usedBeforeRewind, rewOk, usedAfterRewind, st.usedBytes, st.peakBytes, st.resetCount, st.capacityBytes);\n" +
"mut a.destroy();\n" +
"allocDead := mut a.alloc(4);\n" +
"io.outputLine(\"arenaDead\", a.isValid(), allocDead.ok);\n" +
"mut a2 := arena.create(32);\n" +
"io.outputLine(\"arenaReuse\", a2.isValid(), a2.capacityBytes());\n" +
"mut a2.destroy();\n" +
"\n" +
"/* Generic TypedArena<T> (IntArena & FloatArena) */\n" +
"ia: mut arena.IntArena = arena.createTyped<Int>(16);\n" +
"i0 := mut ia.alloc(42);\n" +
"ispan := mut ia.allocSpan(4, 7);\n" +
"_iset := mut ia.set(ispan.offset + 2, 99);\n" +
"im := ia.mark();\n" +
"_iExtra := mut ia.alloc(100);\n" +
"_iRew := mut ia.rewind(im);\n" +
"io.outputLine(\"intArena\", i0, ia.get(i0), ia.get(ispan.offset + 2), ia.used(), ia.peakUsed());\n" +
"mut ia.reset();\n" +
"mut ia.destroy();\n" +
"\n" +
"fa: mut arena.FloatArena = arena.createTyped<Float>(8);\n" +
"f0 := mut fa.alloc(1.5);\n" +
"fspan := mut fa.allocSpan(3, 2.5);\n" +
"io.outputLine(\"floatArena\", f0, fa.get(f0), fa.get(fspan.offset + 1), fa.used());\n" +
"mut fa.destroy();\n" +
"\n" +
"/* 2. ds/pool: generational ABA protection + SlotPool + generic Pool<T> */\n" +
"mut sp := pool.createSlots(2);\n" +
"h1 := mut sp.acquire();\n" +
"h2 := mut sp.acquire();\n" +
"hFull := mut sp.acquire();\n" +
"rel1 := mut sp.release(h1);\n" +
"relDup := mut sp.release(h1);\n" +
"h3 := mut sp.acquire();\n" +
"io.outputLine(\"slotPool\", h1.index, h2.index, hFull.isValid(), rel1, relDup, h3.index == h1.index, h3.generation > h1.generation, sp.isAlive(h1), sp.isAlive(h3));\n" +
"mut sp.clear();\n" +
"io.outputLine(\"slotClear\", sp.count(), sp.isAlive(h2), sp.isAlive(h3));\n" +
"\n" +
"ip: mut pool.IntPool = pool.create<Int>(4);\n" +
"ih := mut ip.acquire(101);\n" +
"_is := mut ip.set(ih, 202);\n" +
"ig1 := ip.get(ih);\n" +
"_ir := mut ip.release(ih);\n" +
"ig2 := ip.get(ih);\n" +
"io.outputLine(\"intPool\", ig1.isSome(), ig1.unwrapOr(-1), ig2.isSome(), ip.count());\n" +
"\n" +
"tp: mut pool.TextPool = pool.create<String>(4);\n" +
"th := mut tp.acquire(\"alpha\");\n" +
"_ts := mut tp.set(th, \"beta\");\n" +
"tg1 := tp.get(th);\n" +
"_tr := mut tp.release(th);\n" +
"tg2 := tp.get(th);\n" +
"io.outputLine(\"textPool\", tg1.isSome(), tg1.unwrapOr(\"\"), tg2.isSome(), tp.count());\n" +
"\n" +
"/* 3. ds/intern: deduplication + multi-table isolation + clear */\n" +
"mut t1 := intern.create();\n" +
"mut t2 := intern.create();\n" +
"idA := mut t1.intern(\"alpha\");\n" +
"idA2 := mut t1.intern(\"alpha\");\n" +
"idColon := mut t1.intern(\":alpha\");\n" +
"_t2a := mut t2.intern(\"only2a\");\n" +
"_t2b := mut t2.intern(\"only2b\");\n" +
"idOther := mut t2.intern(\"alpha\");\n" +
"ist := t1.stats();\n" +
"io.outputLine(\"intern\", idA == idA2, idA =!= idColon, t1.resolveOr(idA, \"\"), t1.resolveOr(idColon, \"\"), t1.resolve(idOther).isSome(), ist.uniqueCount, ist.internCalls, ist.hitCalls);\n" +
"mut t1.clear();\n" +
"io.outputLine(\"internClear\", t1.count(), t1.has(\"alpha\"), t1.hasId(idA), t2.has(\"alpha\"));\n" +
"\n" +
"/* 4. ds/lru: generic O(1) bounded LRU<K, V> (LruText, LruInt, IntLru) */\n" +
"c: mut lru.LruText = lru.create<String, String>(3);\n" +
"_p1 := mut c.put(\"a\", \"1\");\n" +
"_p2 := mut c.put(\"b\", \"2\");\n" +
"_p3 := mut c.put(\"c\", \"3\");\n" +
"ga := mut c.get(\"a\");\n" +
"pk := c.peek(\"b\");\n" +
"ev := mut c.put(\"d\", \"4\");\n" +
"lst := c.stats();\n" +
"io.outputLine(\"lruText\", ga.isSome(), ga.unwrapOr(\"\"), pk.unwrapOr(\"\"), ev.evicted, ev.key, ev.value, c.has(\"b\"), c.newestKey().unwrapOr(\"\"), c.oldestKey().unwrapOr(\"\"), lst.count, lst.hits, lst.misses, lst.evictions);\n" +
"rmOk := mut c.remove(\"c\");\n" +
"ev2 := mut c.evictOldest();\n" +
"io.outputLine(\"lruTextRm\", rmOk, ev2.evicted, ev2.key, c.count());\n" +
"\n" +
"ci: mut lru.LruInt = lru.create<String, Int>(2);\n" +
"_pi1 := mut ci.put(\"x\", 10);\n" +
"_pi2 := mut ci.put(\"y\", 20);\n" +
"_gi := mut ci.get(\"x\");\n" +
"evi := mut ci.put(\"z\", 30);\n" +
"giMiss := mut ci.get(\"y\");\n" +
"io.outputLine(\"lruInt\", evi.evicted, evi.key, evi.value, giMiss.isSome(), ci.count());\n" +
"\n" +
"ck: mut lru.IntLru = lru.create<Int, Int>(2);\n" +
"_pk1 := mut ck.put(100, 1);\n" +
"_pk2 := mut ck.put(200, 2);\n" +
"_gk := mut ck.get(100);\n" +
"evk := mut ck.put(300, 3);\n" +
"io.outputLine(\"lruIntKey\", evk.evicted, evk.key, evk.value, ck.has(200), ck.count());\n";

funcPath := path.join(tmpDir, "functional.lts");
wr := fs.writeText(funcPath, functionalSrc);
test.check("write functional.lts: " + wr.error, wr.ok);

expectedOut :=
"arena1 true 0 true 8 false false\n" +
"arenaRW 255 -123456 987654\n" +
"arenaStats 32 true 16 0 32 1 64\n" +
"arenaDead false false\n" +
"arenaReuse true 32\n" +
"intArena 0 42 99 5 6\n" +
"floatArena 0 1.5 2.5 4\n" +
"slotPool 0 1 false true false true true false true\n" +
"slotClear 0 false false\n" +
"intPool true 202 false 0\n" +
"textPool true beta false 0\n" +
"intern true true alpha :alpha false 2 3 1\n" +
"internClear 0 false false true\n" +
"lruText true 1 2 true b 2 false d c 3 1 0 1\n" +
"lruTextRm true true a 1\n" +
"lruInt true y 20 false 2\n" +
"lruIntKey true 200 2 false 2\n";

/* Run on TS target */
emptyEnv: List<String> = [];
tsComp := compilerTest.compileStdin(root, selTs.path, functionalSrc, "");
test.checkInt("TS compile status: " + tsComp.stderr, 0, tsComp.status);
tsOutFile := path.join(tmpDir, "functional.ts");
test.check("write functional.ts", fs.writeText(tsOutFile, tsComp.stdout).ok);
tsRunner := path.join(tmpDir, "runner.ts");
tsRunnerCode :=
"import { writeSync } from 'node:fs';\n" +
"import { main } from './functional.ts';\n" +
"const out = main((t: string): void => { writeSync(1, t); });\n" +
"if (typeof out === 'string' && out.length > 0) writeSync(1, out);\n";
test.check("write runner.ts", fs.writeText(tsRunner, tsRunnerCode).ok);
tsRun := proc.run(project.nodeExecPath(), [tsRunner], root, emptyEnv, true, "");
test.checkInt("TS run status: " + tsRun.stderr, 0, tsRun.status);
test.checkText("TS functional output", expectedOut, tsRun.stdout);

/* Run on C11 target */
if ccInfo.available {
    cComp := compilerTest.compileStdin(root, selC.path, functionalSrc, "");
    test.checkInt("C11 compile status: " + cComp.stderr, 0, cComp.status);
    cFile := path.join(tmpDir, "functional.c");
    cBin := path.join(tmpDir, "functional");
    test.check("write functional.c", fs.writeText(cFile, cComp.stdout).ok);
    ccRes := proc.run(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", cFile, "-o", cBin, "-lm"], tmpDir, emptyEnv, true, "");
    test.checkInt("C11 cc status: " + ccRes.stderr, 0, ccRes.status);
    cRun := proc.run(cBin, [], root, emptyEnv, true, "");
    test.checkInt("C11 run status: " + cRun.stderr, 0, cRun.status);
    test.checkText("C11 functional output matches TS", expectedOut, cRun.stdout);

    /* Stress & ASan/UBSan bounded-memory verification via ./bin/lite build --sanitize */
    stressSrc :=
    "io := import \"core/io\";\n" +
    "arena := import \"ds/arena\";\n" +
    "pool := import \"ds/pool\";\n" +
    "intern := import \"ds/intern\";\n" +
    "lru := import \"ds/lru\";\n" +
    "\n" +
    "mut a := arena.create(256);\n" +
    "loop 0..5000 as f {\n" +
    "    s := mut a.allocAligned(64, 8);\n" +
    "    _w := mut a.writeInt32(s.offset, f);\n" +
    "    mut a.reset();\n" +
    "}\n" +
    "mut sp := pool.create<Int>(32);\n" +
    "loop 0..5000 as p {\n" +
    "    h := mut sp.acquire(p);\n" +
    "    _r := mut sp.release(h);\n" +
    "}\n" +
    "mut it := intern.create();\n" +
    "loop 0..500 as ic {\n" +
    "    _s1 := mut it.intern(\"sym_\" + (ic % 16).toText());\n" +
    "    if (ic % 50) == 49 { mut it.clear(); }\n" +
    "}\n" +
    "mut lc := lru.create<Int, Int>(32);\n" +
    "loop 0..5000 as lk {\n" +
    "    _ev := mut lc.put(lk, lk * 2);\n" +
    "}\n" +
    "io.outputLine(\"stress\", a.resetCount(), sp.count(), it.count(), lc.count(), lc.stats().evictions);\n" +
    "mut a.destroy();\n";

    stressPath := path.join(tmpDir, "stress.lts");
    ws := fs.writeText(stressPath, stressSrc);
    test.check("write stress.lts: " + ws.error, ws.ok);

    sanBin := path.join(tmpDir, "stress-san");
    buildSan := proc.run(path.join(root, "bin/lite"), ["build", "--sanitize", "--quiet", "-o", sanBin, stressPath], root, emptyEnv, true, "");
    test.check("ASan/UBSan build ok: " + buildSan.stderr, buildSan.status == 0 and buildSan.error == "");

    runSan := proc.run(sanBin, [], tmpDir, emptyEnv, true, "");
    test.check("ASan/UBSan stress exit 0: " + runSan.stderr, runSan.status == 0 and runSan.error == "");
    test.checkText("ASan/UBSan stress output", "stress 5000 0 0 32 4968\n", runSan.stdout);
}

/* Nominal type safety: unrelated ds records and distinct IDs cannot cross boundaries. */
nomBad1 := compilerTest.compileStdin(root, selTs.path, "arena := import \"ds/arena\"; bad := fn(x: arena.TypedArena<Int>): Int { x.used() }; mut a := arena.create(16); bad(a);\n", "");
test.check("reject Arena passed as TypedArena<Int>", nomBad1.status =!= 0);
nomBad2 := compilerTest.compileStdin(root, selTs.path, "intern := import \"ds/intern\"; mut t := intern.create(); id := mut t.intern(\"a\"); n: Int = id;\n", "");
test.check("reject distinct SymbolId assigned to Int", nomBad2.status =!= 0);

fs.remove(tmpDir);
