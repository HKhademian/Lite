/** Deterministic, seedable pseudorandom number generator (`math/random`). */

/** Mutable-method PRNG state handle; construct with `Rng.create` and advance with `mut rng.nextInt()`, `mut rng.rangeInt(...)`, or `mut rng.nextBool()`. */
pub Rng := record {
    state: Int;
};

MOD := 2147483647;
MULT := 48271;

normalizeSeed := fn(seed: Int): Int {
    var s := seed % MOD;
    if s <= 0 { s = s + MOD - 1; }
    if s <= 0 { s = 1; }
    s
};

/** Creates a deterministic `Rng` from any `seed`. */
pub Rng.create := fn(seed: Int): Self {
    Self { state = normalizeSeed(seed) }
};

/** Reseeds `rng` in place from `seed`. */
pub Rng.reseed := fn(rng: mut Self, seed: Int): Unit {
    rng.state = normalizeSeed(seed);
};

/** Advances `rng` in place by one Park-Miller LCG step, returning a positive `Int` in `[1, 2147483646]`. */
pub Rng.nextInt := fn(rng: mut Self): Int {
    s := (rng.state * MULT) % MOD;
    safe := if s <= 0 { s + MOD } else { s };
    rng.state = safe;
    safe
};

/** Advances `rng` in place and returns a deterministic `Int` in `[minVal, maxExclusive)`. */
pub Rng.rangeInt := fn(rng: mut Self, minVal: Int, maxExclusive: Int): Int {
    val := mut rng.nextInt();
    span := maxExclusive - minVal;
    if span <= 1 {
        return minVal;
    }
    minVal + (val % span)
};

/** Advances `rng` in place and returns a deterministic `Bool`. */
pub Rng.nextBool := fn(rng: mut Self): Bool {
    val := mut rng.nextInt();
    (val % 2) == 1
};

var defaultRng: mut Rng = Rng.create(1234567);

/** Seeds the module-level default PRNG used by `nextInt`, `rangeInt`, and `nextBool`. */
pub seed := fn(value: Int): Unit {
    mut defaultRng.reseed(value);
};

/** Returns a positive `Int` in `[1, 2147483646]` from the module-level default PRNG. */
pub nextInt := fn(): Int {
    mut defaultRng.nextInt()
};

/** Returns an `Int` in `[minVal, maxExclusive)` from the module-level default PRNG. */
pub rangeInt := fn(minVal: Int, maxExclusive: Int): Int {
    mut defaultRng.rangeInt(minVal, maxExclusive)
};

/** Returns a `Bool` from the module-level default PRNG. */
pub nextBool := fn(): Bool {
    mut defaultRng.nextBool()
};
