/** Generic NxM and 2x2/3x3/4x4 matrix math (`math/matrix`) backed by `Mat<T, R, C>` across TS and C11. */

math := import "math/scalar";
vec := import "math/vector";

/** Generic R×C numeric matrix stored row-major as `[Vec<T, C>; R]`. */
pub Mat := record<T: Type<math.Numeric>, R: Int, C: Int> {
    rows: [vec.Vec<T, C>; R];
}

/** Generic 2x2 matrix alias over `Mat<T, 2, 2>`. */
pub Mat2 := alias<T: Type<math.Numeric>> Mat<T, 2, 2>;

/** Generic 3x3 matrix alias over `Mat<T, 3, 3>`. */
pub Mat3 := alias<T: Type<math.Numeric>> Mat<T, 3, 3>;

/** Generic 4x4 matrix alias over `Mat<T, 4, 4>`. */
pub Mat4 := alias<T: Type<math.Numeric>> Mat<T, 4, 4>;

/** 2x2 `Float` matrix alias. */
pub FMat2 := alias Mat<Float, 2, 2>;

/** 3x3 `Float` matrix alias. */
pub FMat3 := alias Mat<Float, 3, 3>;

/** 4x4 `Float` matrix alias. */
pub FMat4 := alias Mat<Float, 4, 4>;

/** Constructs a generic `Mat<T, R, C>` from row vectors `[Vec<T, C>; R]`. */
pub Mat.from := fn<T: Type<math.Numeric>, R: Int, C: Int>(rows: [vec.Vec<T, C>; R]): Self<T, R, C> {
    Self<T, R, C> { rows = rows }
};

/** Zero-initialized generic `Mat<T, R, C>`. */
pub Mat.zeroed := fn<T: Type<math.Numeric>, R: Int, C: Int>(): Self<T, R, C> {
    res: Self<T, R, C>;
    res
};

/** Generic N×N `Float` identity matrix. */
pub Mat.identity := fn<N: Int>(): Self<Float, N, N> {
    var out: [vec.Vec<Float, N>; N];
    loop 0..N as i {
        var row: [Float; N];
        row[i] = 1.0;
        out[i] = vec.Vec<Float, N> { data = row };
    }
    Self<Float, N, N> { rows = out }
};

/** Compile-time row count `R` of `m`. */
pub Mat.rowsCount := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>): Int {
    m.rows.length()
};

/** Compile-time column count `C` of `m`. */
pub Mat.colsCount := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>): Int {
    _unused := m.rows.length();
    C
};

/** Returns entry `(r, c)` of matrix `m` (runtime bounds-checked). */
pub Mat.at := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>, r: Int, c: Int): T {
    m.rows[r].data[c]
};

/** Sets entry `(r, c)` of matrix `m` to `val` (runtime bounds-checked). */
pub Mat.set := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: mut Self<T, R, C>, r: Int, c: Int, val: T): Unit {
    var nextRows := m.rows;
    var rowVec := nextRows[r];
    mut rowVec.set(c, val);
    nextRows[r] = rowVec;
    m.rows = nextRows;
};

/** Returns row `r` as `Vec<T, C>`. */
pub Mat.row := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>, r: Int): vec.Vec<T, C> {
    m.rows[r]
};

/** Returns column `c` as `Vec<T, R>`. */
pub Mat.col := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>, c: Int): vec.Vec<T, R> {
    var out: [T; R];
    loop 0..R as r {
        out[r] = m.rows[r].data[c];
    }
    vec.Vec<T, R> { data = out }
};

/** Component-wise matrix addition `a + b`. */
pub Mat.add := fn<T: Type<math.Numeric>, R: Int, C: Int>(a: Self<T, R, C>, b: Self<T, R, C>): Self<T, R, C> {
    var out: [vec.Vec<T, C>; R];
    loop 0..R as r {
        out[r] = a.rows[r].add(b.rows[r]);
    }
    Self<T, R, C> { rows = out }
};

/** Component-wise matrix subtraction `a - b`. */
pub Mat.sub := fn<T: Type<math.Numeric>, R: Int, C: Int>(a: Self<T, R, C>, b: Self<T, R, C>): Self<T, R, C> {
    var out: [vec.Vec<T, C>; R];
    loop 0..R as r {
        out[r] = a.rows[r].sub(b.rows[r]);
    }
    Self<T, R, C> { rows = out }
};

/** Multiplies every entry of matrix `m` by scalar `s`. */
pub Mat.scale := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>, s: T): Self<T, R, C> {
    var out: [vec.Vec<T, C>; R];
    loop 0..R as r {
        out[r] = m.rows[r].scale(s);
    }
    Self<T, R, C> { rows = out }
};

/** Matrix product `(R×K) * (K×C) -> (R×C)`. */
pub Mat.mul := fn<T: Type<math.Numeric>, R: Int, K: Int, C: Int>(a: Self<T, R, K>, b: Self<T, K, C>): Self<T, R, C> {
    var out: [vec.Vec<T, C>; R];
    loop 0..R as r {
        var row: [T; C];
        loop 0..C as c {
            var acc: T;
            loop 0..K as k {
                acc = acc + (a.rows[r].data[k] * b.rows[k].data[c]);
            }
            row[c] = acc;
        }
        out[r] = vec.Vec<T, C> { data = row };
    }
    Self<T, R, C> { rows = out }
};

/** Matrix-vector product `(R×C) * Vec<T, C> -> Vec<T, R>`. */
pub Mat.mulVec := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>, v: vec.Vec<T, C>): vec.Vec<T, R> {
    var out: [T; R];
    loop 0..R as r {
        out[r] = m.rows[r].dot(v);
    }
    vec.Vec<T, R> { data = out }
};

/** Transpose of `(R×C)` matrix `m` into `(C×R)`. */
pub Mat.transpose := fn<T: Type<math.Numeric>, R: Int, C: Int>(m: Self<T, R, C>): Self<T, C, R> {
    var out: [vec.Vec<T, R>; C];
    loop 0..C as c {
        var row: [T; R];
        loop 0..R as r {
            row[r] = m.rows[r].data[c];
        }
        out[c] = vec.Vec<T, R> { data = row };
    }
    Self<T, C, R> { rows = out }
};

minor3 := fn(r1: [Float; 4], r2: [Float; 4], r3: [Float; 4], c0: Int, c1: Int, c2: Int): Float {
    (r1[c0] * ((r2[c1] * r3[c2]) - (r2[c2] * r3[c1])))
    - (r1[c1] * ((r2[c0] * r3[c2]) - (r2[c2] * r3[c0])))
    + (r1[c2] * ((r2[c0] * r3[c1]) - (r2[c1] * r3[c0])))
};

/** Determinant of an N×N `Float` matrix (exact closed form for N in `1..=4`). */
pub Mat.det := fn<N: Int>(m: Self<Float, N, N>): Float {
    if N == 1 {
        m.rows[0].data[0]
    } else if N == 2 {
        (m.rows[0].data[0] * m.rows[1].data[1]) - (m.rows[0].data[1] * m.rows[1].data[0])
    } else if N == 3 {
        r0 := m.rows[0].data;
        r1 := m.rows[1].data;
        r2 := m.rows[2].data;
        (r0[0] * ((r1[1] * r2[2]) - (r1[2] * r2[1])))
        - (r0[1] * ((r1[0] * r2[2]) - (r1[2] * r2[0])))
        + (r0[2] * ((r1[0] * r2[1]) - (r1[1] * r2[0])))
    } else if N == 4 {
        r0 := m.rows[0].data;
        r1 := m.rows[1].data;
        r2 := m.rows[2].data;
        r3 := m.rows[3].data;
        (r0[0] * minor3(r1, r2, r3, 1, 2, 3))
        - (r0[1] * minor3(r1, r2, r3, 0, 2, 3))
        + (r0[2] * minor3(r1, r2, r3, 0, 1, 3))
        - (r0[3] * minor3(r1, r2, r3, 0, 1, 2))
    } else {
        0.0
    }
};

/** Transforms 2D point `p` by homogeneous 3x3 matrix `m` (assuming `z = 1`). */
pub Mat.transformPoint2 := fn(m: Self<Float, 3, 3>, p: vec.FVec2): vec.FVec2 {
    res := m.mulVec(vec.vec3(p.x(), p.y(), 1.0));
    vec.vec2(res.x(), res.y())
};

/** Transforms 3D point `p` by 4x4 matrix `m` with perspective divide when `w != 0` and `w != 1`. */
pub Mat.transformPoint3 := fn(m: Self<Float, 4, 4>, p: vec.FVec3): vec.FVec3 {
    v := m.mulVec(vec.vec4(p.x(), p.y(), p.z(), 1.0));
    if v.w() == 0.0 or v.w() == 1.0 {
        vec.vec3(v.x(), v.y(), v.z())
    } else {
        vec.vec3(v.x() / v.w(), v.y() / v.w(), v.z() / v.w())
    }
};

/* ============================================================================
 * 2D & 3D Transform Constructors (Static Type Operations)
 * ============================================================================ */

/** 2x2 counter-clockwise rotation matrix by `radians`. */
pub Mat.rotation2 := fn(radians: Float): Self<Float, 2, 2> {
    c := math.cos(radians);
    s := math.sin(radians);
    Self<Float, 2, 2> { rows = [vec.vec2(c, 0.0 - s), vec.vec2(s, c)] }
};

/** 2D affine translation matrix in homogeneous 3x3 form. */
pub Mat.translate2 := fn(tx: Float, ty: Float): Self<Float, 3, 3> {
    Self<Float, 3, 3> {
    rows = [
    vec.vec3(1.0, 0.0, tx),
    vec.vec3(0.0, 1.0, ty),
    vec.vec3(0.0, 0.0, 1.0)
    ]
    }
};

/** 2D affine scale matrix in homogeneous 3x3 form. */
pub Mat.scale2 := fn(sx: Float, sy: Float): Self<Float, 3, 3> {
    Self<Float, 3, 3> {
    rows = [
    vec.vec3(sx, 0.0, 0.0),
    vec.vec3(0.0, sy, 0.0),
    vec.vec3(0.0, 0.0, 1.0)
    ]
    }
};

/** 2D affine rotation matrix by `radians` in homogeneous 3x3 form. */
pub Mat.rotate2 := fn(radians: Float): Self<Float, 3, 3> {
    c := math.cos(radians);
    s := math.sin(radians);
    Self<Float, 3, 3> {
    rows = [
    vec.vec3(c, 0.0 - s, 0.0),
    vec.vec3(s, c, 0.0),
    vec.vec3(0.0, 0.0, 1.0)
    ]
    }
};

/** 3D translation matrix in homogeneous 4x4 form. */
pub Mat.translate3 := fn(tx: Float, ty: Float, tz: Float): Self<Float, 4, 4> {
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(1.0, 0.0, 0.0, tx),
    vec.vec4(0.0, 1.0, 0.0, ty),
    vec.vec4(0.0, 0.0, 1.0, tz),
    vec.vec4(0.0, 0.0, 0.0, 1.0)
    ]
    }
};

/** 3D scale matrix in homogeneous 4x4 form. */
pub Mat.scale3 := fn(sx: Float, sy: Float, sz: Float): Self<Float, 4, 4> {
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(sx, 0.0, 0.0, 0.0),
    vec.vec4(0.0, sy, 0.0, 0.0),
    vec.vec4(0.0, 0.0, sz, 0.0),
    vec.vec4(0.0, 0.0, 0.0, 1.0)
    ]
    }
};

/** 3D rotation matrix around the X axis by `radians`. */
pub Mat.rotateX := fn(radians: Float): Self<Float, 4, 4> {
    c := math.cos(radians);
    s := math.sin(radians);
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(1.0, 0.0, 0.0, 0.0),
    vec.vec4(0.0, c, 0.0 - s, 0.0),
    vec.vec4(0.0, s, c, 0.0),
    vec.vec4(0.0, 0.0, 0.0, 1.0)
    ]
    }
};

/** 3D rotation matrix around the Y axis by `radians`. */
pub Mat.rotateY := fn(radians: Float): Self<Float, 4, 4> {
    c := math.cos(radians);
    s := math.sin(radians);
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(c, 0.0, s, 0.0),
    vec.vec4(0.0, 1.0, 0.0, 0.0),
    vec.vec4(0.0 - s, 0.0, c, 0.0),
    vec.vec4(0.0, 0.0, 0.0, 1.0)
    ]
    }
};

/** 3D rotation matrix around the Z axis by `radians`. */
pub Mat.rotateZ := fn(radians: Float): Self<Float, 4, 4> {
    c := math.cos(radians);
    s := math.sin(radians);
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(c, 0.0 - s, 0.0, 0.0),
    vec.vec4(s, c, 0.0, 0.0),
    vec.vec4(0.0, 0.0, 1.0, 0.0),
    vec.vec4(0.0, 0.0, 0.0, 1.0)
    ]
    }
};

/** Right-handed perspective projection matrix (`fovYRad`, `aspect`, `near`, `far`). */
pub Mat.perspective := fn(fovYRad: Float, aspect: Float, near: Float, far: Float): Self<Float, 4, 4> {
    half := fovYRad * 0.5;
    s := math.sin(half);
    c := math.cos(half);
    f := if s == 0.0 { 1.0 } else { c / s };
    nf := 1.0 / (near - far);
    Self<Float, 4, 4> {
    rows = [
    vec.vec4(if aspect == 0.0 { f } else { f / aspect }, 0.0, 0.0, 0.0),
    vec.vec4(0.0, f, 0.0, 0.0),
    vec.vec4(0.0, 0.0, (far + near) * nf, (2.0 * far * near) * nf),
    vec.vec4(0.0, 0.0, -1.0, 0.0)
    ]
    }
};
