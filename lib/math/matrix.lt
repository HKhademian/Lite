/** 2x2, 3x3, and 4x4 matrix math (`math/matrix`) for 2D/3D transforms across TS and C11. */

math := import "math/scalar";
vec := import "math/vector";

/** Row-major 2x2 matrix. */
pub Mat2 := alias (m00: Float, m01: Float, m10: Float, m11: Float);

/** Row-major 3x3 matrix (2D affine transforms & 3D rotations). */
pub Mat3 := alias (
m00: Float, m01: Float, m02: Float,
m10: Float, m11: Float, m12: Float,
m20: Float, m21: Float, m22: Float
);

/** Row-major 4x4 matrix (3D affine, camera, and projection transforms). */
pub Mat4 := alias (
m00: Float, m01: Float, m02: Float, m03: Float,
m10: Float, m11: Float, m12: Float, m13: Float,
m20: Float, m21: Float, m22: Float, m23: Float,
m30: Float, m31: Float, m32: Float, m33: Float
);

/* ============================================================================
 * Mat2
 * ============================================================================ */

/** 2x2 identity matrix. */
pub identity2 := fn(): Mat2 {
    (m00 = 1.0, m01 = 0.0, m10 = 0.0, m11 = 1.0)
};

/** 2x2 counter-clockwise rotation matrix by `radians`. */
pub rotation2 := fn(radians: Float): Mat2 {
    c := math.cos(radians);
    s := math.sin(radians);
    (m00 = c, m01 = 0.0 - s, m10 = s, m11 = c)
};

/** Multiplies two 2x2 matrices `a * b`. */
pub mul2 := fn(a: Mat2, b: Mat2): Mat2 {
    (
    m00 = (a.m00 * b.m00) + (a.m01 * b.m10),
    m01 = (a.m00 * b.m01) + (a.m01 * b.m11),
    m10 = (a.m10 * b.m00) + (a.m11 * b.m10),
    m11 = (a.m10 * b.m01) + (a.m11 * b.m11)
    )
};

/** Multiplies 2x2 matrix `m` by `FVec2`. */
pub mulVec2 := fn(m: Mat2, v: vec.FVec2): vec.FVec2 {
    vec.vec2((m.m00 * v.x()) + (m.m01 * v.y()), (m.m10 * v.x()) + (m.m11 * v.y()))
};

/** Determinant of 2x2 matrix `m`. */
pub det2 := fn(m: Mat2): Float {
    (m.m00 * m.m11) - (m.m01 * m.m10)
};

/** Transpose of 2x2 matrix `m`. */
pub transpose2 := fn(m: Mat2): Mat2 {
    (m00 = m.m00, m01 = m.m10, m10 = m.m01, m11 = m.m11)
};

/* ============================================================================
 * Mat3 (2D affine & 3x3 linear algebra)
 * ============================================================================ */

/** 3x3 identity matrix. */
pub identity3 := fn(): Mat3 {
    (
    m00 = 1.0, m01 = 0.0, m02 = 0.0,
    m10 = 0.0, m11 = 1.0, m12 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = 1.0
    )
};

/** 2D affine translation matrix in homogeneous 3x3 form. */
pub translate2 := fn(tx: Float, ty: Float): Mat3 {
    (
    m00 = 1.0, m01 = 0.0, m02 = tx,
    m10 = 0.0, m11 = 1.0, m12 = ty,
    m20 = 0.0, m21 = 0.0, m22 = 1.0
    )
};

/** 2D affine scale matrix in homogeneous 3x3 form. */
pub scale2 := fn(sx: Float, sy: Float): Mat3 {
    (
    m00 = sx, m01 = 0.0, m02 = 0.0,
    m10 = 0.0, m11 = sy, m12 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = 1.0
    )
};

/** 2D affine rotation matrix by `radians` in homogeneous 3x3 form. */
pub rotate2 := fn(radians: Float): Mat3 {
    c := math.cos(radians);
    s := math.sin(radians);
    (
    m00 = c, m01 = 0.0 - s, m02 = 0.0,
    m10 = s, m11 = c, m12 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = 1.0
    )
};

/** Multiplies two 3x3 matrices `a * b`. */
pub mul3 := fn(a: Mat3, b: Mat3): Mat3 {
    (
    m00 = (a.m00 * b.m00) + (a.m01 * b.m10) + (a.m02 * b.m20),
    m01 = (a.m00 * b.m01) + (a.m01 * b.m11) + (a.m02 * b.m21),
    m02 = (a.m00 * b.m02) + (a.m01 * b.m12) + (a.m02 * b.m22),
    m10 = (a.m10 * b.m00) + (a.m11 * b.m10) + (a.m12 * b.m20),
    m11 = (a.m10 * b.m01) + (a.m11 * b.m11) + (a.m12 * b.m21),
    m12 = (a.m10 * b.m02) + (a.m11 * b.m12) + (a.m12 * b.m22),
    m20 = (a.m20 * b.m00) + (a.m21 * b.m10) + (a.m22 * b.m20),
    m21 = (a.m20 * b.m01) + (a.m21 * b.m11) + (a.m22 * b.m21),
    m22 = (a.m20 * b.m02) + (a.m21 * b.m12) + (a.m22 * b.m22)
    )
};

/** Multiplies 3x3 matrix `m` by `FVec3`. */
pub mulVec3 := fn(m: Mat3, v: vec.FVec3): vec.FVec3 {
    vec.vec3(
    (m.m00 * v.x()) + (m.m01 * v.y()) + (m.m02 * v.z()),
    (m.m10 * v.x()) + (m.m11 * v.y()) + (m.m12 * v.z()),
    (m.m20 * v.x()) + (m.m21 * v.y()) + (m.m22 * v.z())
    )
};

/** Transforms 2D point `p` by homogeneous 3x3 matrix `m` (assuming `z = 1`). */
pub transformPoint2 := fn(m: Mat3, p: vec.FVec2): vec.FVec2 {
    vec.vec2(
    (m.m00 * p.x()) + (m.m01 * p.y()) + m.m02,
    (m.m10 * p.x()) + (m.m11 * p.y()) + m.m12
    )
};

/** Determinant of 3x3 matrix `m`. */
pub det3 := fn(m: Mat3): Float {
    (m.m00 * ((m.m11 * m.m22) - (m.m12 * m.m21)))
    - (m.m01 * ((m.m10 * m.m22) - (m.m12 * m.m20)))
    + (m.m02 * ((m.m10 * m.m21) - (m.m11 * m.m20)))
};

/** Transpose of 3x3 matrix `m`. */
pub transpose3 := fn(m: Mat3): Mat3 {
    (
    m00 = m.m00, m01 = m.m10, m02 = m.m20,
    m10 = m.m01, m11 = m.m11, m12 = m.m21,
    m20 = m.m02, m21 = m.m12, m22 = m.m22
    )
};

/* ============================================================================
 * Mat4 (3D affine, rotation, and projection transforms)
 * ============================================================================ */

/** 4x4 identity matrix. */
pub identity4 := fn(): Mat4 {
    (
    m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = 0.0,
    m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = 0.0,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** 3D translation matrix. */
pub translate3 := fn(tx: Float, ty: Float, tz: Float): Mat4 {
    (
    m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = tx,
    m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = ty,
    m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = tz,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** 3D scale matrix. */
pub scale3 := fn(sx: Float, sy: Float, sz: Float): Mat4 {
    (
    m00 = sx, m01 = 0.0, m02 = 0.0, m03 = 0.0,
    m10 = 0.0, m11 = sy, m12 = 0.0, m13 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = sz, m23 = 0.0,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** 3D rotation matrix around the X axis by `radians`. */
pub rotateX := fn(radians: Float): Mat4 {
    c := math.cos(radians);
    s := math.sin(radians);
    (
    m00 = 1.0, m01 = 0.0, m02 = 0.0, m03 = 0.0,
    m10 = 0.0, m11 = c, m12 = 0.0 - s, m13 = 0.0,
    m20 = 0.0, m21 = s, m22 = c, m23 = 0.0,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** 3D rotation matrix around the Y axis by `radians`. */
pub rotateY := fn(radians: Float): Mat4 {
    c := math.cos(radians);
    s := math.sin(radians);
    (
    m00 = c, m01 = 0.0, m02 = s, m03 = 0.0,
    m10 = 0.0, m11 = 1.0, m12 = 0.0, m13 = 0.0,
    m20 = 0.0 - s, m21 = 0.0, m22 = c, m23 = 0.0,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** 3D rotation matrix around the Z axis by `radians`. */
pub rotateZ := fn(radians: Float): Mat4 {
    c := math.cos(radians);
    s := math.sin(radians);
    (
    m00 = c, m01 = 0.0 - s, m02 = 0.0, m03 = 0.0,
    m10 = s, m11 = c, m12 = 0.0, m13 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = 1.0, m23 = 0.0,
    m30 = 0.0, m31 = 0.0, m32 = 0.0, m33 = 1.0
    )
};

/** Right-handed perspective projection matrix (`fovYRad`, `aspect`, `near`, `far`). */
pub perspective := fn(fovYRad: Float, aspect: Float, near: Float, far: Float): Mat4 {
    half := fovYRad * 0.5;
    s := math.sin(half);
    c := math.cos(half);
    f := if s == 0.0 { 1.0 } else { c / s };
    nf := 1.0 / (near - far);
    (
    m00 = if aspect == 0.0 { f } else { f / aspect }, m01 = 0.0, m02 = 0.0, m03 = 0.0,
    m10 = 0.0, m11 = f, m12 = 0.0, m13 = 0.0,
    m20 = 0.0, m21 = 0.0, m22 = (far + near) * nf, m23 = (2.0 * far * near) * nf,
    m30 = 0.0, m31 = 0.0, m32 = -1.0, m33 = 0.0
    )
};

/** Multiplies two 4x4 matrices `a * b`. */
pub mul4 := fn(a: Mat4, b: Mat4): Mat4 {
    (
    m00 = (a.m00 * b.m00) + (a.m01 * b.m10) + (a.m02 * b.m20) + (a.m03 * b.m30),
    m01 = (a.m00 * b.m01) + (a.m01 * b.m11) + (a.m02 * b.m21) + (a.m03 * b.m31),
    m02 = (a.m00 * b.m02) + (a.m01 * b.m12) + (a.m02 * b.m22) + (a.m03 * b.m32),
    m03 = (a.m00 * b.m03) + (a.m01 * b.m13) + (a.m02 * b.m23) + (a.m03 * b.m33),
    m10 = (a.m10 * b.m00) + (a.m11 * b.m10) + (a.m12 * b.m20) + (a.m13 * b.m30),
    m11 = (a.m10 * b.m01) + (a.m11 * b.m11) + (a.m12 * b.m21) + (a.m13 * b.m31),
    m12 = (a.m10 * b.m02) + (a.m11 * b.m12) + (a.m12 * b.m22) + (a.m13 * b.m32),
    m13 = (a.m10 * b.m03) + (a.m11 * b.m13) + (a.m12 * b.m23) + (a.m13 * b.m33),
    m20 = (a.m20 * b.m00) + (a.m21 * b.m10) + (a.m22 * b.m20) + (a.m23 * b.m30),
    m21 = (a.m20 * b.m01) + (a.m21 * b.m11) + (a.m22 * b.m21) + (a.m23 * b.m31),
    m22 = (a.m20 * b.m02) + (a.m21 * b.m12) + (a.m22 * b.m22) + (a.m23 * b.m32),
    m23 = (a.m20 * b.m03) + (a.m21 * b.m13) + (a.m22 * b.m23) + (a.m23 * b.m33),
    m30 = (a.m30 * b.m00) + (a.m31 * b.m10) + (a.m32 * b.m20) + (a.m33 * b.m30),
    m31 = (a.m30 * b.m01) + (a.m31 * b.m11) + (a.m32 * b.m21) + (a.m33 * b.m31),
    m32 = (a.m30 * b.m02) + (a.m31 * b.m12) + (a.m32 * b.m22) + (a.m33 * b.m32),
    m33 = (a.m30 * b.m03) + (a.m31 * b.m13) + (a.m32 * b.m23) + (a.m33 * b.m33)
    )
};

/** Multiplies 4x4 matrix `m` by `FVec4`. */
pub mulVec4 := fn(m: Mat4, v: vec.FVec4): vec.FVec4 {
    vec.vec4(
    (m.m00 * v.x()) + (m.m01 * v.y()) + (m.m02 * v.z()) + (m.m03 * v.w()),
    (m.m10 * v.x()) + (m.m11 * v.y()) + (m.m12 * v.z()) + (m.m13 * v.w()),
    (m.m20 * v.x()) + (m.m21 * v.y()) + (m.m22 * v.z()) + (m.m23 * v.w()),
    (m.m30 * v.x()) + (m.m31 * v.y()) + (m.m32 * v.z()) + (m.m33 * v.w())
    )
};

/** Transforms 3D point `p` by 4x4 matrix `m` with perspective divide when `w != 0`. */
pub transformPoint3 := fn(m: Mat4, p: vec.FVec3): vec.FVec3 {
    v := mulVec4(m, vec.vec4(p.x(), p.y(), p.z(), 1.0));
    if v.w() == 0.0 or v.w() == 1.0 {
        vec.vec3(v.x(), v.y(), v.z())
    } else {
        vec.vec3(v.x() / v.w(), v.y() / v.w(), v.z() / v.w())
    }
};

/** Transpose of 4x4 matrix `m`. */
pub transpose4 := fn(m: Mat4): Mat4 {
    (
    m00 = m.m00, m01 = m.m10, m02 = m.m20, m03 = m.m30,
    m10 = m.m01, m11 = m.m11, m12 = m.m21, m13 = m.m31,
    m20 = m.m02, m21 = m.m12, m22 = m.m22, m23 = m.m32,
    m30 = m.m03, m31 = m.m13, m32 = m.m23, m33 = m.m33
    )
};
