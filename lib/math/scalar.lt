/** Universal mathematical constants and pure Int/Float numeric helpers. */

/** Ratio of a circle's circumference to its diameter. */
pub PI := 3.141592653589793;

/** Full circle constant (`2 * PI`). */
pub TAU := 6.283185307179586;

/** Euler's number (`exp(1)`). */
pub E := 2.718281828459045;

/** Absolute value of an `Int`. */
pub absInt := fn(x: Int): Int {
    if x < 0 { -x } else { x }
};

/** Smaller of two `Int` values. */
pub minInt := fn(a: Int, b: Int): Int {
    if a <= b { a } else { b }
};

/** Larger of two `Int` values. */
pub maxInt := fn(a: Int, b: Int): Int {
    if a >= b { a } else { b }
};

/** Clamps `x` to the closed interval `[lo, hi]`. */
pub clampInt := fn(x: Int, lo: Int, hi: Int): Int {
    if x < lo { lo } else if x > hi { hi } else { x }
};

/** Returns `-1`, `0`, or `1` according to the sign of `x`. */
pub signInt := fn(x: Int): Int {
    if x < 0 { -1 } else if x > 0 { 1 } else { 0 }
};

/** Non-negative greatest common divisor of `a` and `b`. */
pub gcd := fn(a: Int, b: Int): Int {
    var x := absInt(a);
    var y := absInt(b);
    loop y =!= 0 {
        t := x % y;
        x = y;
        y = t;
    }
    x
};

/** Non-negative least common multiple of `a` and `b` (`0` if either input is `0`). */
pub lcm := fn(a: Int, b: Int): Int {
    if a == 0 or b == 0 { return 0; }
    absInt(a / gcd(a, b) * b)
};

/** Integer exponentiation `base ^ exp` for non-negative `exp` (`0` for negative `exp`). */
pub powInt := fn(base: Int, exp: Int): Int {
    if exp < 0 { return 0; }
    var res := 1;
    var b := base;
    var e := exp;
    loop e > 0 {
        if e % 2 == 1 { res = res * b; }
        e = e / 2;
        if e > 0 { b = b * b; }
    }
    res
};

/** Absolute value of a `Float`. */
pub abs := fn(x: Float): Float {
    if x < 0.0 { -x } else { x }
};

/** Smaller of two `Float` values. */
pub min := fn(a: Float, b: Float): Float {
    if a <= b { a } else { b }
};

/** Larger of two `Float` values. */
pub max := fn(a: Float, b: Float): Float {
    if a >= b { a } else { b }
};

/** Clamps `x` to `[lo, hi]`. */
pub clamp := fn(x: Float, lo: Float, hi: Float): Float {
    if x < lo { lo } else if x > hi { hi } else { x }
};

/** Linearly interpolates between `a` and `b` by factor `t`. */
pub lerp := fn(a: Float, b: Float, t: Float): Float {
    a + (b - a) * t
};

/** Square root of a non-negative `Float` via Newton-Raphson iteration. */
pub sqrt := fn(x: Float): Float {
    if x <= 0.0 { return 0.0; }
    var g := if x >= 1.0 { x * 0.5 } else { 1.0 };
    var i := 0;
    loop i < 24 {
        g = 0.5 * (g + x / g);
        i += 1;
    }
    g
};
