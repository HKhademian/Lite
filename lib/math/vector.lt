/** 2D/3D/4D vectors and generic N-dimensional `Vec<T, N>` math (`math/vector`) across TS and C11. */

math := import "math/scalar";
array := import "core/array";

/** Generic N-dimensional numeric vector backed by a fixed-length array `[T; N]`. */
pub Vec := record<T: Type<math.Numeric>, N: Int> {
    data: [T; N];
}

/** Generic 2D vector alias over `Vec<T, 2>`. */
pub Vec2 := alias<T: Type<math.Numeric>> Vec<T, 2>;

/** Generic 3D vector alias over `Vec<T, 3>`. */
pub Vec3 := alias<T: Type<math.Numeric>> Vec<T, 3>;

/** Generic 4D vector alias over `Vec<T, 4>`. */
pub Vec4 := alias<T: Type<math.Numeric>> Vec<T, 4>;

/** 2D integer vector alias. */
pub IVec2 := alias Vec<Int, 2>;

/** 3D integer vector alias. */
pub IVec3 := alias Vec<Int, 3>;

/** 2D floating-point vector alias. */
pub FVec2 := alias Vec<Float, 2>;

/** 3D floating-point vector alias. */
pub FVec3 := alias Vec<Float, 3>;

/** 4D floating-point vector alias. */
pub FVec4 := alias Vec<Float, 4>;

/** Constructs a generic `Vec<T, N>` from a fixed array `[T; N]`. */
pub Vec.from := fn<T: Type<math.Numeric>, N: Int>(data: [T; N]): Self<T, N> {
    Self<T, N> { data = data }
};

/** Constructs a generic `Vec<T, N>` with all `N` components set to `val`. */
pub Vec.splat := fn<T: Type<math.Numeric>, N: Int>(val: T): Self<T, N> {
    Self<T, N> { data = array.filled<T, N>(val) }
};

/** Zero-initialized generic `Vec<T, N>`. */
pub Vec.zeroed := fn<T: Type<math.Numeric>, N: Int>(): Self<T, N> {
    res: Self<T, N>;
    res
};

/** Constructs a 2D generic vector `Vec2<T>`. */
pub vec2 := fn<T: Type<math.Numeric>>(x: T, y: T): Vec2<T> {
    Vec<T, 2> { data = [x, y] }
};

/** Constructs a 3D generic vector `Vec3<T>`. */
pub vec3 := fn<T: Type<math.Numeric>>(x: T, y: T, z: T): Vec3<T> {
    Vec<T, 3> { data = [x, y, z] }
};

/** Constructs a 4D generic vector `Vec4<T>`. */
pub vec4 := fn<T: Type<math.Numeric>>(x: T, y: T, z: T, w: T): Vec4<T> {
    Vec<T, 4> { data = [x, y, z, w] }
};

/** Zero 2D `Float` vector `(0, 0)`. */
pub ZERO2 := FVec2.zeroed();

/** Zero 3D `Float` vector `(0, 0, 0)`. */
pub ZERO3 := FVec3.zeroed();

/** Zero 4D `Float` vector `(0, 0, 0, 0)`. */
pub ZERO4 := FVec4.zeroed();

/** Unit X axis `(1, 0, 0)`. */
pub UNIT_X3 := vec3(1.0, 0.0, 0.0);

/** Unit Y axis `(0, 1, 0)`. */
pub UNIT_Y3 := vec3(0.0, 1.0, 0.0);

/** Unit Z axis `(0, 0, 1)`. */
pub UNIT_Z3 := vec3(0.0, 0.0, 1.0);

/** Compile-time component count `N` of `v`. */
pub Vec.dim := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): Int {
    v.data.length()
};

/** Returns component at zero-based `index` (runtime bounds-checked). */
pub Vec.get := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>, index: Int): T {
    v.data[index]
};

/** Sets component at zero-based `index` to `val` (runtime bounds-checked). */
pub Vec.set := fn<T: Type<math.Numeric>, N: Int>(v: mut Self<T, N>, index: Int, val: T): Unit {
    var nextData := v.data;
    nextData[index] = val;
    v.data = nextData;
};

/** First coordinate (`data[0]`). */
pub Vec.x := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[0] };

/** Second coordinate (`data[1]`). */
pub Vec.y := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[1] };

/** Third coordinate (`data[2]`). */
pub Vec.z := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[2] };

/** Fourth coordinate (`data[3]`). */
pub Vec.w := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[3] };

/** Red / first channel (`data[0]`). */
pub Vec.r := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[0] };

/** Green / second channel (`data[1]`). */
pub Vec.g := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[1] };

/** Blue / third channel (`data[2]`). */
pub Vec.b := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[2] };

/** Alpha / fourth channel (`data[3]`). */
pub Vec.a := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T { v.data[3] };

/** Sets the first coordinate (`data[0]`) to `val`. */
pub Vec.setX := fn<T: Type<math.Numeric>, N: Int>(v: mut Self<T, N>, val: T): Unit { mut v.set(0, val); };

/** Sets the second coordinate (`data[1]`) to `val`. */
pub Vec.setY := fn<T: Type<math.Numeric>, N: Int>(v: mut Self<T, N>, val: T): Unit { mut v.set(1, val); };

/** Sets the third coordinate (`data[2]`) to `val`. */
pub Vec.setZ := fn<T: Type<math.Numeric>, N: Int>(v: mut Self<T, N>, val: T): Unit { mut v.set(2, val); };

/** Sets the fourth coordinate (`data[3]`) to `val`. */
pub Vec.setW := fn<T: Type<math.Numeric>, N: Int>(v: mut Self<T, N>, val: T): Unit { mut v.set(3, val); };

/** Component-wise addition `a + b`. */
pub Vec.add := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = a.data[i] + b.data[i];
    }
    Self<T, N> { data = out }
};

/** Component-wise subtraction `a - b`. */
pub Vec.sub := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = a.data[i] - b.data[i];
    }
    Self<T, N> { data = out }
};

/** Component-wise product `a * b`. */
pub Vec.mul := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = a.data[i] * b.data[i];
    }
    Self<T, N> { data = out }
};

/** Multiplies every component of `v` by scalar `s`. */
pub Vec.scale := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>, s: T): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = v.data[i] * s;
    }
    Self<T, N> { data = out }
};

/** Negates every component of `v`. */
pub Vec.neg := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): Self<T, N> {
    var out: [T; N];
    z: T;
    loop 0..N as i {
        out[i] = z - v.data[i];
    }
    Self<T, N> { data = out }
};

/** Component-wise minimum of `a` and `b`. */
pub Vec.minComp := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = if a.data[i] <= b.data[i] { a.data[i] } else { b.data[i] };
    }
    Self<T, N> { data = out }
};

/** Component-wise maximum of `a` and `b`. */
pub Vec.maxComp := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = if a.data[i] >= b.data[i] { a.data[i] } else { b.data[i] };
    }
    Self<T, N> { data = out }
};

/** Euclidean dot product `sum_i (a[i] * b[i])`. */
pub Vec.dot := fn<T: Type<math.Numeric>, N: Int>(a: Self<T, N>, b: Self<T, N>): T {
    var acc: T;
    loop 0..N as i {
        acc = acc + (a.data[i] * b.data[i]);
    }
    acc
};

/** Squared Euclidean length of `v`. */
pub Vec.lengthSq := fn<T: Type<math.Numeric>, N: Int>(v: Self<T, N>): T {
    v.dot(v)
};

/** Component-wise linear interpolation between `a` and `b` by `t`. */
pub Vec.lerp := fn<T: Type<math.FloatScalar>, N: Int>(a: Self<T, N>, b: Self<T, N>, t: T): Self<T, N> {
    var out: [T; N];
    loop 0..N as i {
        out[i] = a.data[i] + (b.data[i] - a.data[i]) * t;
    }
    Self<T, N> { data = out }
};

/** Euclidean length of a `Float` vector `v`. */
pub Vec.length := fn<N: Int>(v: Self<Float, N>): Float {
    math.sqrt(v.lengthSq())
};

/** Euclidean distance between `Float` vectors `a` and `b`. */
pub Vec.distance := fn<N: Int>(a: Self<Float, N>, b: Self<Float, N>): Float {
    a.sub(b).length()
};

/** Unit-length vector in the direction of `v`, or `Self<Float, N>.zeroed()` when near zero. */
pub Vec.normalize := fn<N: Int>(v: Self<Float, N>): Self<Float, N> {
    len := v.length();
    if len <= 0.000000000001 { Self<Float, N>.zeroed() } else { v.scale(1.0 / len) }
};

/** 2D signed cross product `(a.x * b.y) - (a.y * b.x)`. */
pub Vec.cross2 := fn(a: Self<Float, 2>, b: Self<Float, 2>): Float {
    (a.x() * b.y()) - (a.y() * b.x())
};

/** Rotates 2D `Float` vector `v` counter-clockwise by `radians`. */
pub Vec.rotate := fn(v: Self<Float, 2>, radians: Float): Self<Float, 2> {
    c := math.cos(radians);
    s := math.sin(radians);
    vec2((v.x() * c) - (v.y() * s), (v.x() * s) + (v.y() * c))
};

/** Returns the 90-degree counter-clockwise perpendicular 2D vector `(-y, x)`. */
pub Vec.perp := fn(v: Self<Float, 2>): Self<Float, 2> {
    vec2(0.0 - v.y(), v.x())
};

/** Clamps the magnitude of 2D `Float` vector `v` to at most `maxLen`. */
pub Vec.clampLength := fn(v: Self<Float, 2>, maxLen: Float): Self<Float, 2> {
    if maxLen <= 0.0 { return ZERO2; }
    lenSq := v.lengthSq();
    if lenSq <= (maxLen * maxLen) { v } else { v.scale(maxLen / math.sqrt(lenSq)) }
};

/** 3D cross product `a x b`. */
pub Vec.cross := fn(a: Self<Float, 3>, b: Self<Float, 3>): Self<Float, 3> {
    vec3(
    (a.y() * b.z()) - (a.z() * b.y()),
    (a.z() * b.x()) - (a.x() * b.z()),
    (a.x() * b.y()) - (a.y() * b.x())
    )
};

/** Reflects 3D incident vector `v` across unit surface normal `normal`. */
pub Vec.reflect := fn(v: Self<Float, 3>, normal: Self<Float, 3>): Self<Float, 3> {
    d := 2.0 * v.dot(normal);
    v.sub(normal.scale(d))
};
