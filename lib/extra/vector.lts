/** Experimental 2D/3D/4D vector math (`extra/vector`) for games, graphics, and physics across TS and C11. */

math := import "core/math";

/** 2D floating-point vector. */
pub Vec2 := record { x: Float; y: Float; };

/** 3D floating-point vector. */
pub Vec3 := record { x: Float; y: Float; z: Float; };

/** 4D floating-point vector (homogeneous coordinates or RGBA). */
pub Vec4 := record { x: Float; y: Float; z: Float; w: Float; };

/** Zero 2D vector `(0, 0)`. */
pub ZERO2 := Vec2 { x = 0.0, y = 0.0 };

/** Zero 3D vector `(0, 0, 0)`. */
pub ZERO3 := Vec3 { x = 0.0, y = 0.0, z = 0.0 };

/** Zero 4D vector `(0, 0, 0, 0)`. */
pub ZERO4 := Vec4 { x = 0.0, y = 0.0, z = 0.0, w = 0.0 };

/** Unit X axis `(1, 0, 0)`. */
pub UNIT_X3 := Vec3 { x = 1.0, y = 0.0, z = 0.0 };

/** Unit Y axis `(0, 1, 0)`. */
pub UNIT_Y3 := Vec3 { x = 0.0, y = 1.0, z = 0.0 };

/** Unit Z axis `(0, 0, 1)`. */
pub UNIT_Z3 := Vec3 { x = 0.0, y = 0.0, z = 1.0 };

/* Pure range-reduced trig helpers (exact to < 1e-11 on both TS and C11). */
wrapAngle := fn(rad: Float): Float {
    var a := rad;
    loop a > math.PI { a = a - math.TAU; }
    loop a < (0.0 - math.PI) { a = a + math.TAU; }
    a
};

/** Computes sine of `rad` radians using range-reduced 11th-order Taylor series. */
pub sinRad := fn(rad: Float): Float {
    var x := wrapAngle(rad);
    if x > (math.PI * 0.5) { x = math.PI - x; }
    else if x < (0.0 - (math.PI * 0.5)) { x = (0.0 - math.PI) - x; }
    x2 := x * x;
    var term := x;
    var sum := x;
    term = (0.0 - term * x2) / 6.0; sum = sum + term;
    term = (0.0 - term * x2) / 20.0; sum = sum + term;
    term = (0.0 - term * x2) / 42.0; sum = sum + term;
    term = (0.0 - term * x2) / 72.0; sum = sum + term;
    term = (0.0 - term * x2) / 110.0; sum = sum + term;
    sum
};

/** Computes cosine of `rad` radians. */
pub cosRad := fn(rad: Float): Float {
    sinRad(rad + (math.PI * 0.5))
};

/* ============================================================================
 * Vec2
 * ============================================================================ */

/** Constructs a `Vec2`. */
pub vec2 := fn(x: Float, y: Float): Vec2 { Vec2 { x = x, y = y } };

/** Adds `a + b`. */
pub Vec2.add := fn(a: Self, b: Self): Self { Vec2 { x = a.x + b.x, y = a.y + b.y } };

/** Subtracts `a - b`. */
pub Vec2.sub := fn(a: Self, b: Self): Self { Vec2 { x = a.x - b.x, y = a.y - b.y } };

/** Multiplies `v` by scalar `s`. */
pub Vec2.scale := fn(v: Self, s: Float): Self { Vec2 { x = v.x * s, y = v.y * s } };

/** Negates `v`. */
pub Vec2.neg := fn(v: Self): Self { Vec2 { x = 0.0 - v.x, y = 0.0 - v.y } };

/** Component-wise product of `a` and `b`. */
pub Vec2.mul := fn(a: Self, b: Self): Self { Vec2 { x = a.x * b.x, y = a.y * b.y } };

/** 2D dot product. */
pub Vec2.dot := fn(a: Self, b: Self): Float { (a.x * b.x) + (a.y * b.y) };

/** 2D signed cross product (z-component of 3D cross). */
pub Vec2.cross := fn(a: Self, b: Self): Float { (a.x * b.y) - (a.y * b.x) };

/** Squared Euclidean length of `v`. */
pub Vec2.lengthSq := fn(v: Self): Float { (v.x * v.x) + (v.y * v.y) };

/** Euclidean length of `v`. */
pub Vec2.length := fn(v: Self): Float { math.sqrt(v.lengthSq()) };

/** Euclidean distance between `a` and `b`. */
pub Vec2.distance := fn(a: Self, b: Self): Float { a.sub(b).length() };

/** Returns unit-length vector in the direction of `v`, or `ZERO2` when near zero. */
pub Vec2.normalize := fn(v: Self): Self {
    len := v.length();
    if len <= 0.000000000001 { ZERO2 } else { Vec2 { x = v.x / len, y = v.y / len } }
};

/** Linearly interpolates between `a` and `b` by `t`. */
pub Vec2.lerp := fn(a: Self, b: Self, t: Float): Self {
    Vec2 { x = math.lerp(a.x, b.x, t), y = math.lerp(a.y, b.y, t) }
};

/** Rotates `v` counter-clockwise by `radians`. */
pub Vec2.rotate := fn(v: Self, radians: Float): Self {
    c := cosRad(radians);
    s := sinRad(radians);
    Vec2 { x = (v.x * c) - (v.y * s), y = (v.x * s) + (v.y * c) }
};

/** Returns the 90-degree counter-clockwise perpendicular vector `(-y, x)`. */
pub Vec2.perp := fn(v: Self): Self { Vec2 { x = 0.0 - v.y, y = v.x } };

/** Clamps the magnitude of `v` to at most `maxLen`. */
pub Vec2.clampLength := fn(v: Self, maxLen: Float): Self {
    if maxLen <= 0.0 { return ZERO2; }
    lenSq := v.lengthSq();
    if lenSq <= (maxLen * maxLen) { v } else { v.scale(maxLen / math.sqrt(lenSq)) }
};

/* ============================================================================
 * Vec3
 * ============================================================================ */

/** Constructs a `Vec3`. */
pub vec3 := fn(x: Float, y: Float, z: Float): Vec3 { Vec3 { x = x, y = y, z = z } };

/** Adds `a + b`. */
pub Vec3.add := fn(a: Self, b: Self): Self { Vec3 { x = a.x + b.x, y = a.y + b.y, z = a.z + b.z } };

/** Subtracts `a - b`. */
pub Vec3.sub := fn(a: Self, b: Self): Self { Vec3 { x = a.x - b.x, y = a.y - b.y, z = a.z - b.z } };

/** Multiplies `v` by scalar `s`. */
pub Vec3.scale := fn(v: Self, s: Float): Self { Vec3 { x = v.x * s, y = v.y * s, z = v.z * s } };

/** Negates `v`. */
pub Vec3.neg := fn(v: Self): Self { Vec3 { x = 0.0 - v.x, y = 0.0 - v.y, z = 0.0 - v.z } };

/** Component-wise product of `a` and `b`. */
pub Vec3.mul := fn(a: Self, b: Self): Self { Vec3 { x = a.x * b.x, y = a.y * b.y, z = a.z * b.z } };

/** 3D dot product. */
pub Vec3.dot := fn(a: Self, b: Self): Float { (a.x * b.x) + (a.y * b.y) + (a.z * b.z) };

/** 3D cross product `a x b`. */
pub Vec3.cross := fn(a: Self, b: Self): Self {
    Vec3 {
    x = (a.y * b.z) - (a.z * b.y),
    y = (a.z * b.x) - (a.x * b.z),
    z = (a.x * b.y) - (a.y * b.x)
    }
};

/** Squared Euclidean length of `v`. */
pub Vec3.lengthSq := fn(v: Self): Float { (v.x * v.x) + (v.y * v.y) + (v.z * v.z) };

/** Euclidean length of `v`. */
pub Vec3.length := fn(v: Self): Float { math.sqrt(v.lengthSq()) };

/** Euclidean distance between `a` and `b`. */
pub Vec3.distance := fn(a: Self, b: Self): Float { a.sub(b).length() };

/** Returns unit-length vector in the direction of `v`, or `ZERO3` when near zero. */
pub Vec3.normalize := fn(v: Self): Self {
    len := v.length();
    if len <= 0.000000000001 { ZERO3 } else { Vec3 { x = v.x / len, y = v.y / len, z = v.z / len } }
};

/** Linearly interpolates between `a` and `b` by `t`. */
pub Vec3.lerp := fn(a: Self, b: Self, t: Float): Self {
    Vec3 { x = math.lerp(a.x, b.x, t), y = math.lerp(a.y, b.y, t), z = math.lerp(a.z, b.z, t) }
};

/** Reflects incident vector `v` across unit surface normal `normal`. */
pub Vec3.reflect := fn(v: Self, normal: Self): Self {
    d := 2.0 * v.dot(normal);
    v.sub(normal.scale(d))
};

/* ============================================================================
 * Vec4
 * ============================================================================ */

/** Constructs a `Vec4`. */
pub vec4 := fn(x: Float, y: Float, z: Float, w: Float): Vec4 { Vec4 { x = x, y = y, z = z, w = w } };

/** Adds `a + b`. */
pub Vec4.add := fn(a: Self, b: Self): Self { Vec4 { x = a.x + b.x, y = a.y + b.y, z = a.z + b.z, w = a.w + b.w } };

/** Subtracts `a - b`. */
pub Vec4.sub := fn(a: Self, b: Self): Self { Vec4 { x = a.x - b.x, y = a.y - b.y, z = a.z - b.z, w = a.w - b.w } };

/** Multiplies `v` by scalar `s`. */
pub Vec4.scale := fn(v: Self, s: Float): Self { Vec4 { x = v.x * s, y = v.y * s, z = v.z * s, w = v.w * s } };

/** 4D dot product. */
pub Vec4.dot := fn(a: Self, b: Self): Float { (a.x * b.x) + (a.y * b.y) + (a.z * b.z) + (a.w * b.w) };

/** Euclidean length of `v`. */
pub Vec4.length := fn(v: Self): Float { math.sqrt(v.dot(v)) };

/** Returns unit-length 4D vector, or `ZERO4` when near zero. */
pub Vec4.normalize := fn(v: Self): Self {
    len := v.length();
    if len <= 0.000000000001 { ZERO4 } else { Vec4 { x = v.x / len, y = v.y / len, z = v.z / len, w = v.w / len } }
};

/** Linearly interpolates between `a` and `b` by `t`. */
pub Vec4.lerp := fn(a: Self, b: Self, t: Float): Self {
    Vec4 { x = math.lerp(a.x, b.x, t), y = math.lerp(a.y, b.y, t), z = math.lerp(a.z, b.z, t), w = math.lerp(a.w, b.w, t) }
};
