/** Experimental compact bit-arrays (`extra/bitset`) packed 30 bits per word for masks, visited flags, and collision layers. */

/** Opaque generational handle to a fixed-length bitset. */
pub Bitset := type (handle: Int, gen: Int);

WORD_BITS := 30;
FULL_WORD := 1073741823; /* (2^30) - 1 */

var bsWords: mut List<Int> = [];
var bsBase: mut List<Int> = [];
var bsWordCap: mut List<Int> = [];
var bsBitLen: mut List<Int> = [];
var bsGen: mut List<Int> = [];
var bsAlive: mut List<Bool> = [];
var bsFree: mut List<Int> = [];

pow2 := fn(exp: Int): Int {
    var acc := 1;
    var i := 0;
    loop i < exp {
        acc = acc * 2;
        i += 1;
    }
    acc
};

wordHasBit := fn(word: Int, bit: Int): Bool {
    ((word / pow2(bit)) % 2) == 1
};

wordSetBit := fn(word: Int, bit: Int): Int {
    if wordHasBit(word, bit) { word } else { word + pow2(bit) }
};

wordClearBit := fn(word: Int, bit: Int): Int {
    if wordHasBit(word, bit) { word - pow2(bit) } else { word }
};

wordPopcount := fn(word: Int): Int {
    var x := word;
    var c := 0;
    loop x > 0 {
        if (x % 2) == 1 { c += 1; }
        x = x / 2;
    }
    c
};

wordOr := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 or xb > 0 {
        if ((xa % 2) == 1) or ((xb % 2) == 1) { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

wordAnd := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 and xb > 0 {
        if ((xa % 2) == 1) and ((xb % 2) == 1) { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

wordXor := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 or xb > 0 {
        if ((xa % 2) + (xb % 2)) == 1 { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

validBitset := fn(b: Bitset): Bool {
    id := b.handle;
    id >= 0 and id < bsAlive.length() and bsAlive[id] and bsGen[id] == b.gen
};

wordsForBits := fn(numBits: Int): Int {
    if numBits <= 0 { 0 } else { (numBits + WORD_BITS - 1) / WORD_BITS }
};

/** Creates a zero-initialized `Bitset` holding `numBits` bits. */
pub create := fn(numBits: Int): Bitset {
    bits := if numBits < 0 { 0 } else { numBits };
    needed := wordsForBits(bits);
    var fi := bsFree.length() - 1;
    loop fi >= 0 {
        id := bsFree[fi];
        if bsWordCap[id] >= needed {
            last := bsFree.length() - 1;
            if fi =!= last { mut bsFree.setAt(fi, bsFree[last]); }
            _drop := mut bsFree.popBack();
            mut bsBitLen.setAt(id, bits);
            mut bsAlive.setAt(id, true);
            base := bsBase[id];
            var zi := 0;
            loop zi < needed {
                mut bsWords.setAt(base + zi, 0);
                zi += 1;
            }
            return (handle = id, gen = bsGen[id]);
        }
        fi -= 1;
    }

    base := bsWords.length();
    var i := 0;
    loop i < needed {
        mut bsWords.pushBack(0);
        i += 1;
    }
    id := bsBase.length();
    mut bsBase.pushBack(base);
    mut bsWordCap.pushBack(needed);
    mut bsBitLen.pushBack(bits);
    mut bsGen.pushBack(1);
    mut bsAlive.pushBack(true);
    (handle = id, gen = 1)
};

/** Sets bit `index` to `1`; returns `false` if out of bounds. */
pub set := fn(bs: Bitset, index: Int): Bool {
    if not validBitset(bs) { return false; }
    id := bs.handle;
    if index < 0 or index >= bsBitLen[id] { return false; }
    wIdx := bsBase[id] + (index / WORD_BITS);
    mut bsWords.setAt(wIdx, wordSetBit(bsWords[wIdx], index % WORD_BITS));
    true
};

/** Clears bit `index` to `0`; returns `false` if out of bounds. */
pub clear := fn(bs: Bitset, index: Int): Bool {
    if not validBitset(bs) { return false; }
    id := bs.handle;
    if index < 0 or index >= bsBitLen[id] { return false; }
    wIdx := bsBase[id] + (index / WORD_BITS);
    mut bsWords.setAt(wIdx, wordClearBit(bsWords[wIdx], index % WORD_BITS));
    true
};

/** Flips bit `index`; returns `false` if out of bounds. */
pub toggle := fn(bs: Bitset, index: Int): Bool {
    if not validBitset(bs) { return false; }
    id := bs.handle;
    if index < 0 or index >= bsBitLen[id] { return false; }
    wIdx := bsBase[id] + (index / WORD_BITS);
    b := index % WORD_BITS;
    w := bsWords[wIdx];
    mut bsWords.setAt(wIdx, if wordHasBit(w, b) { wordClearBit(w, b) } else { wordSetBit(w, b) });
    true
};

/** True when bit `index` is `1`. */
pub test := fn(bs: Bitset, index: Int): Bool {
    if not validBitset(bs) { return false; }
    id := bs.handle;
    if index < 0 or index >= bsBitLen[id] { return false; }
    wordHasBit(bsWords[bsBase[id] + (index / WORD_BITS)], index % WORD_BITS)
};

/** Returns the number of bits set to `1` (population count). */
pub countOnes := fn(bs: Bitset): Int {
    if not validBitset(bs) { return 0; }
    id := bs.handle;
    wCount := wordsForBits(bsBitLen[id]);
    base := bsBase[id];
    var total := 0;
    var i := 0;
    loop i < wCount {
        total += wordPopcount(bsWords[base + i]);
        i += 1;
    }
    total
};

/** Returns the lowest index with bit `1`, or `-1` if all bits are `0`. */
pub firstSet := fn(bs: Bitset): Int {
    if not validBitset(bs) { return -1; }
    id := bs.handle;
    bits := bsBitLen[id];
    wCount := wordsForBits(bits);
    base := bsBase[id];
    var wi := 0;
    loop wi < wCount {
        w := bsWords[base + wi];
        if w > 0 {
            var bi := 0;
            loop bi < WORD_BITS {
                idx := (wi * WORD_BITS) + bi;
                if idx >= bits { return -1; }
                if wordHasBit(w, bi) { return idx; }
                bi += 1;
            }
        }
        wi += 1;
    }
    -1
};

/** Returns the lowest index with bit `0`, or `-1` if all bits are `1`. */
pub firstClear := fn(bs: Bitset): Int {
    if not validBitset(bs) { return -1; }
    id := bs.handle;
    bits := bsBitLen[id];
    wCount := wordsForBits(bits);
    base := bsBase[id];
    var wi := 0;
    loop wi < wCount {
        w := bsWords[base + wi];
        if w < FULL_WORD {
            var bi := 0;
            loop bi < WORD_BITS {
                idx := (wi * WORD_BITS) + bi;
                if idx >= bits { return -1; }
                if not wordHasBit(w, bi) { return idx; }
                bi += 1;
            }
        }
        wi += 1;
    }
    -1
};

/** Sets every valid bit in `bs` to `1`. */
pub setAll := fn(bs: Bitset): Unit {
    if not validBitset(bs) { return; }
    id := bs.handle;
    bits := bsBitLen[id];
    wCount := wordsForBits(bits);
    base := bsBase[id];
    var wi := 0;
    loop wi < wCount {
        rem := bits - (wi * WORD_BITS);
        val := if rem >= WORD_BITS { FULL_WORD } else { pow2(rem) - 1 };
        mut bsWords.setAt(base + wi, val);
        wi += 1;
    }
};

/** Clears every bit in `bs` to `0`. */
pub clearAll := fn(bs: Bitset): Unit {
    if not validBitset(bs) { return; }
    id := bs.handle;
    wCount := wordsForBits(bsBitLen[id]);
    base := bsBase[id];
    var wi := 0;
    loop wi < wCount {
        mut bsWords.setAt(base + wi, 0);
        wi += 1;
    }
};

/** Computes `dst |= src` across the overlapping bit length. */
pub orInto := fn(dst: Bitset, src: Bitset): Unit {
    if not validBitset(dst) or not validBitset(src) { return; }
    dId := dst.handle;
    sId := src.handle;
    dBits := bsBitLen[dId];
    sBits := bsBitLen[sId];
    wCount := wordsForBits(if dBits < sBits { dBits } else { sBits });
    dBase := bsBase[dId];
    sBase := bsBase[sId];
    var i := 0;
    loop i < wCount {
        val := wordOr(bsWords[dBase + i], bsWords[sBase + i]);
        rem := dBits - (i * WORD_BITS);
        masked := if rem >= WORD_BITS { val } else { wordAnd(val, pow2(rem) - 1) };
        mut bsWords.setAt(dBase + i, masked);
        i += 1;
    }
};

/** Computes `dst &= src` across the overlapping bit length (clears bits past `src`). */
pub andInto := fn(dst: Bitset, src: Bitset): Unit {
    if not validBitset(dst) or not validBitset(src) { return; }
    dId := dst.handle;
    sId := src.handle;
    dWords := wordsForBits(bsBitLen[dId]);
    sWords := wordsForBits(bsBitLen[sId]);
    dBase := bsBase[dId];
    sBase := bsBase[sId];
    var i := 0;
    loop i < dWords {
        val := if i < sWords { wordAnd(bsWords[dBase + i], bsWords[sBase + i]) } else { 0 };
        mut bsWords.setAt(dBase + i, val);
        i += 1;
    }
};

/** Computes `dst ^= src` across the overlapping bit length. */
pub xorInto := fn(dst: Bitset, src: Bitset): Unit {
    if not validBitset(dst) or not validBitset(src) { return; }
    dId := dst.handle;
    sId := src.handle;
    dBits := bsBitLen[dId];
    sBits := bsBitLen[sId];
    wCount := wordsForBits(if dBits < sBits { dBits } else { sBits });
    dBase := bsBase[dId];
    sBase := bsBase[sId];
    var i := 0;
    loop i < wCount {
        val := wordXor(bsWords[dBase + i], bsWords[sBase + i]);
        rem := dBits - (i * WORD_BITS);
        masked := if rem >= WORD_BITS { val } else { wordAnd(val, pow2(rem) - 1) };
        mut bsWords.setAt(dBase + i, masked);
        i += 1;
    }
};

/** True when `a` and `b` have the same bit length and identical bit patterns. */
pub equals := fn(a: Bitset, b: Bitset): Bool {
    if not validBitset(a) or not validBitset(b) { return false; }
    aId := a.handle;
    bId := b.handle;
    if bsBitLen[aId] =!= bsBitLen[bId] { return false; }
    wCount := wordsForBits(bsBitLen[aId]);
    aBase := bsBase[aId];
    bBase := bsBase[bId];
    var i := 0;
    loop i < wCount {
        if bsWords[aBase + i] =!= bsWords[bBase + i] { return false; }
        i += 1;
    }
    true
};

/** Returns the total number of bits addressable in `bs`. */
pub bitLength := fn(bs: Bitset): Int {
    if not validBitset(bs) { return 0; }
    bsBitLen[bs.handle]
};

/** Destroys `bs` and recycles its handle slot. */
pub destroy := fn(bs: Bitset): Unit {
    if not validBitset(bs) { return; }
    id := bs.handle;
    mut bsAlive.setAt(id, false);
    mut bsGen.setAt(id, bsGen[id] + 1);
    mut bsFree.pushBack(id);
};
