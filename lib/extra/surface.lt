/** Abstract, target-independent 2D desktop & headless drawing surface (`lite.extra.surface.v1`). */

color := import "extra/color";

/** Opaque color value re-exported from `extra/color`. */
pub Color := alias color.Color;

/** 2D point in logical surface coordinates. */
pub Point := alias (x: Float, y: Float);

/** Axis-aligned rectangle in logical surface coordinates. */
pub Rect := alias (x: Float, y: Float, width: Float, height: Float);

/** Opaque handle identifying an open abstract drawing surface. */
pub Surface := alias (handle: Int);

/** Snapshot of surface state and user input for the current frame. */
pub FrameInput := alias (open: Bool, width: Int, height: Int, pointerX: Float, pointerY: Float, pointerDown: Bool, key: String, deltaMs: Int);

/** Runtime performance and resource vitals for an active surface. */
pub Vitals := alias (frameCount: Int, frameTimeMs: Float, avgFrameTimeMs: Float, fps: Float, targetFps: Float, cpuTimeMs: Float, memoryBytes: Int);

/** Window geometry and fullscreen state snapshot for an active surface. */
pub Bounds := alias (x: Int, y: Int, width: Int, height: Int, fullscreen: Bool);

/** Offscreen RGBA pixel texture handle created by `createTexture`. */
pub Texture := alias (handle: Int, width: Int, height: Int);

/** Constructs a 2D point `(x, y)`. */
pub point := fn(x: Float, y: Float): Point { (x = x, y = y) };

/** Constructs a rectangle `(x, y, width, height)`. */
pub rect := fn(x: Float, y: Float, width: Float, height: Float): Rect { (x = x, y = y, width = width, height = height) };

/** Constructs an opaque color from normalized RGB channels (`0.0..1.0`). */
pub rgb := fn(r: Float, g: Float, b: Float): Color { color.fromRgb(r, g, b) };

/** Constructs a color from normalized RGBA channels (`0.0..1.0`). */
pub rgba := fn(r: Float, g: Float, b: Float, a: Float): Color { color.fromRgba(r, g, b, a) };

/** Constructs an opaque color from HSL (`hueDeg` in `0..360`, `s` and `l` in `0.0..1.0`). */
pub hsl := fn(hueDeg: Float, s: Float, l: Float): Color { color.fromHsl(hueDeg, s, l) };

/** Linearly blends `a` and `b` by `t` (`0.0..1.0`). */
pub mix := fn(a: Color, b: Color, t: Float): Color { color.mix(a, b, t) };

/** Returns `c` with its alpha channel replaced. */
pub withAlpha := fn(c: Color, a: Float): Color { color.withAlphaFloat(c, a) };

/** Transparent black. */
pub TRANSPARENT := color.TRANSPARENT;

/** Opaque black. */
pub BLACK := color.BLACK;

/** Opaque white. */
pub WHITE := color.WHITE;

/** Pure red. */
pub RED := color.RED;

/** Pure green. */
pub GREEN := color.GREEN;

/** Pure blue. */
pub BLUE := color.BLUE;

/** Pure yellow. */
pub YELLOW := color.YELLOW;

/** Pure cyan. */
pub CYAN := color.CYAN;

/** Pure magenta. */
pub MAGENTA := color.MAGENTA;

/** Opens an abstract drawing surface with the requested logical title and dimensions. */
pub open := fn(title: String, width: Int, height: Int): Surface;

/** Polls current surface state and input events for the next frame. */
pub poll := fn(surface: Surface): FrameInput;

/** Presents the current frame to the backing display target. */
pub present := fn(surface: Surface): Unit;

/** Closes the surface and releases its host resources. */
pub close := fn(surface: Surface): Unit;

/** Frame callback invoked once per frame by `run`; return `false` to stop the loop. */
pub FrameCallback := alias fn(FrameInput): Bool;

/** Runs a portable host-driven frame loop (`poll -> onFrame -> present`) across desktop, headless, and browser hosts until the surface closes or `onFrame` returns `false`. */
pub run := fn(surface: Surface, onFrame: FrameCallback): Unit;

/** Clears the entire surface to `fill`. */
pub clear := fn(surface: Surface, fill: Color): Unit;

/** Fills `area` with `fill`. */
pub fillRect := fn(surface: Surface, area: Rect, fill: Color): Unit;

/** Strokes the outline of `area` with thickness `lineWidth` and color `stroke`. */
pub strokeRect := fn(surface: Surface, area: Rect, lineWidth: Float, stroke: Color): Unit;

/** Fills a circle centered at `center` with `radius` and color `fill`. */
pub fillCircle := fn(surface: Surface, center: Point, radius: Float, fill: Color): Unit;

/** Strokes a line segment from `start` to `finish` with thickness `lineWidth` and color `stroke`. */
pub strokeLine := fn(surface: Surface, start: Point, finish: Point, lineWidth: Float, stroke: Color): Unit;

/** Draws `content` at `at` using logical pixel height `size` and color `fill`. */
pub drawText := fn(surface: Surface, content: String, at: Point, size: Float, fill: Color): Unit;

/** Captures the current surface contents to an image file at `outPath` (backend-encoded PNG). */
pub capture := fn(surface: Surface, outPath: String): (ok: Bool, error: String);

/** Sets the target frame rate in frames per second (`<= 0.0` releases the cap and runs uncapped; default is `60.0`). */
pub setTargetFps := fn(surface: Surface, fps: Float): Unit;

/** Sets the target frame time in milliseconds (`<= 0.0` releases the cap and runs uncapped). */
pub setFrameTimeMs := fn(surface: Surface, ms: Float): Unit {
    if ms <= 0.0 {
        setTargetFps(surface, 0.0);
    } else {
        setTargetFps(surface, 1000.0 / ms);
    }
};

/** Releases the frame-rate cap so the surface runs as fast as the host allows. */
pub uncapFrameRate := fn(surface: Surface): Unit {
    setTargetFps(surface, 0.0);
};

/** Reads live performance and resource vitals (frame count, frame time, FPS, CPU time, and resident memory bytes). */
pub vitals := fn(surface: Surface): Vitals;

/** Plays a short synthesized sine tone (`frequency` Hz, `durationMs` ms, `volume` 1..100) asynchronously on desktop hosts. */
pub playTone := fn(surface: Surface, frequency: Int, durationMs: Int, volume: Int): Unit;

/** Returns passive window geometry (`x`, `y`, `width`, `height`) and `fullscreen` state for `surface`. */
pub bounds := fn(surface: Surface): Bounds;

/** Resizes `surface` and its backing framebuffer to `width x height` logical pixels. */
pub resize := fn(surface: Surface, width: Int, height: Int): Unit;

/** Enters or exits native fullscreen mode on desktop hosts. */
pub setFullscreen := fn(surface: Surface, enabled: Bool): Unit;

/** Returns the current logical width of `surface` in pixels. */
pub width := fn(surface: Surface): Int {
    bounds(surface).width
};

/** Returns the current logical height of `surface` in pixels. */
pub height := fn(surface: Surface): Int {
    bounds(surface).height
};

/** Returns the current logical `(width, height)` size of `surface`. */
pub size := fn(surface: Surface): (width: Int, height: Int) {
    b := bounds(surface);
    (width = b.width, height = b.height)
};

/** Returns the current window `(x, y)` position of `surface`. */
pub position := fn(surface: Surface): (x: Int, y: Int) {
    b := bounds(surface);
    (x = b.x, y = b.y)
};

/** True when `surface` is currently in fullscreen mode. */
pub isFullscreen := fn(surface: Surface): Bool {
    bounds(surface).fullscreen
};

/** Toggles fullscreen mode on `surface`. */
pub toggleFullscreen := fn(surface: Surface): Unit {
    setFullscreen(surface, not isFullscreen(surface));
};

/** True while key `key` is currently held down on `surface`. */
pub isKeyDown := fn(surface: Surface, key: String): Bool;

/** True only on the frame key `key` transitions from up to down on `surface`. */
pub isKeyPressed := fn(surface: Surface, key: String): Bool;

/** True only on the frame key `key` transitions from down to up on `surface`. */
pub isKeyReleased := fn(surface: Surface, key: String): Bool;

/** True only on the frame the primary pointer button transitions from up to down. */
pub isPointerPressed := fn(surface: Surface): Bool;

/** True only on the frame the primary pointer button transitions from down to up. */
pub isPointerReleased := fn(surface: Surface): Bool;

/** Vertical scroll wheel delta accumulated since the previous frame. */
pub wheelDelta := fn(surface: Surface): Float;

/** Restricts subsequent drawing calls on `surface` to `area`. */
pub setClipRect := fn(surface: Surface, area: Rect): Unit;

/** Clears the active clipping rectangle so drawing spans the full surface. */
pub clearClipRect := fn(surface: Surface): Unit;

/** Fills the solid triangle `(a, b, c)` on `surface` with color `fill`. */
pub fillTriangle := fn(surface: Surface, a: Point, b: Point, c: Point, fill: Color): Unit;

/** Allocates a transparent `width x height` offscreen RGBA texture. */
pub createTexture := fn(width: Int, height: Int): Texture;

/** Writes color `fill` directly to pixel `(x, y)` inside offscreen texture `tex`. */
pub setTexturePixel := fn(tex: Texture, x: Int, y: Int, fill: Color): Unit;

/** Alpha-blends offscreen texture `tex` onto `surface` at top-left `at`. */
pub blit := fn(surface: Surface, tex: Texture, at: Point): Unit;

/** Alpha-blends offscreen texture `tex` scaled to `dest` on `surface`. */
pub blitScaled := fn(surface: Surface, tex: Texture, dest: Rect): Unit;

/** Releases offscreen texture `tex` and recycles its handle slot. */
pub destroyTexture := fn(tex: Texture): Unit;

/** Captures a checkpoint for per-frame scratch strings (O(1) no-op on GC targets, slab rewind on C11). */
pub scratchMark := fn(): Int;

/** Reclaims frame-scratch strings allocated after `mark` (O(1) no-op on GC targets, frees transient C11 slabs). */
pub scratchRewind := fn(mark: Int): Unit;
