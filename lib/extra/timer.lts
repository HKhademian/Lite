/** Experimental fixed-timestep accumulators, cooldowns, and monotonic stopwatches (`extra/timer`). */

time := import "core/time";

/** Pure fixed-timestep accumulator state for deterministic simulation updates (UPS). */
pub StepClock := type (stepSec: Float, maxDeltaSec: Float, accumulatorSec: Float, totalSteps: Int, lastSteps: Int, alpha: Float);

/** Pure cooldown timer state. */
pub Cooldown := type (durationSec: Float, remainingSec: Float, fired: Bool);

/** Monotonic wall-clock stopwatch snapshot. */
pub Stopwatch := type (startNs: Int, lastLapNs: Int, lastLapMs: Float);

/* ============================================================================
 * Fixed-timestep accumulator (StepClock)
 * ============================================================================ */

/** Creates a fixed-timestep accumulator for `ups` updates per second (clamping frame deltas to `maxDeltaSec`). */
pub createClock := fn(ups: Float, maxDeltaSec: Float): StepClock {
    rate := if ups <= 0.0 { 60.0 } else { ups };
    cap := if maxDeltaSec <= 0.0 { 0.1 } else { maxDeltaSec };
    (stepSec = 1.0 / rate, maxDeltaSec = cap, accumulatorSec = 0.0, totalSteps = 0, lastSteps = 0, alpha = 0.0)
};

/** Advances `clock` by `deltaSec`, updating `lastSteps`, `totalSteps`, and render interpolation `alpha` (`0..1`). */
pub advanceClock := fn(clock: StepClock, deltaSec: Float): StepClock {
    clamped := if deltaSec < 0.0 { 0.0 } else if deltaSec > clock.maxDeltaSec { clock.maxDeltaSec } else { deltaSec };
    var acc := clock.accumulatorSec + clamped;
    var steps := 0;
    loop acc >= clock.stepSec and steps < 32 {
        acc = acc - clock.stepSec;
        steps += 1;
    }
    alpha := if clock.stepSec > 0.0 { acc / clock.stepSec } else { 0.0 };
    (
    stepSec = clock.stepSec,
    maxDeltaSec = clock.maxDeltaSec,
    accumulatorSec = acc,
    totalSteps = clock.totalSteps + steps,
    lastSteps = steps,
    alpha = alpha
    )
};

/** Resets `clock`'s accumulator and step counters to zero. */
pub resetClock := fn(clock: StepClock): StepClock {
    (stepSec = clock.stepSec, maxDeltaSec = clock.maxDeltaSec, accumulatorSec = 0.0, totalSteps = 0, lastSteps = 0, alpha = 0.0)
};

/* ============================================================================
 * Cooldown timer
 * ============================================================================ */

/** Creates a cooldown timer with `durationSec` (ready immediately when `startReady` is true). */
pub createCooldown := fn(durationSec: Float, startReady: Bool): Cooldown {
    dur := if durationSec < 0.0 { 0.0 } else { durationSec };
    (durationSec = dur, remainingSec = if startReady { 0.0 } else { dur }, fired = false)
};

/** True when `cd` has cooled down and is ready to fire. */
pub isReady := fn(cd: Cooldown): Bool {
    cd.remainingSec <= 0.0
};

/** Advances `cd` by `deltaSec`, clamping remaining time at `0.0`. */
pub tickCooldown := fn(cd: Cooldown, deltaSec: Float): Cooldown {
    dt := if deltaSec < 0.0 { 0.0 } else { deltaSec };
    rem := cd.remainingSec - dt;
    (durationSec = cd.durationSec, remainingSec = if rem < 0.0 { 0.0 } else { rem }, fired = false)
};

/** Attempts to fire `cd`; if ready, resets `remainingSec = durationSec` and sets `fired = true`. */
pub trigger := fn(cd: Cooldown): Cooldown {
    if cd.remainingSec > 0.0 {
        return (durationSec = cd.durationSec, remainingSec = cd.remainingSec, fired = false);
    }
    (durationSec = cd.durationSec, remainingSec = cd.durationSec, fired = true)
};

/** Returns cooldown completion progress in `0.0..1.0` (`1.0` = ready). */
pub progress := fn(cd: Cooldown): Float {
    if cd.durationSec <= 0.0 or cd.remainingSec <= 0.0 { return 1.0; }
    p := 1.0 - (cd.remainingSec / cd.durationSec);
    if p < 0.0 { 0.0 } else if p > 1.0 { 1.0 } else { p }
};

/* ============================================================================
 * Monotonic Stopwatch
 * ============================================================================ */

/** Starts a new monotonic wall-clock stopwatch. */
pub startStopwatch := fn(): Stopwatch {
    now := time.monotonicNs();
    (startNs = now, lastLapNs = now, lastLapMs = 0.0)
};

/** Returns elapsed milliseconds since `sw` was started. */
pub elapsedMs := fn(sw: Stopwatch): Float {
    (time.monotonicNs() - sw.startNs) / 1000000.0
};

/** Records a lap and stores milliseconds since the previous lap in `lastLapMs`. */
pub lap := fn(sw: Stopwatch): Stopwatch {
    now := time.monotonicNs();
    (startNs = sw.startNs, lastLapNs = now, lastLapMs = (now - sw.lastLapNs) / 1000000.0)
};
