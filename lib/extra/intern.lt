/** Experimental string interner and symbol table (`extra/intern`) for O(1) identity checks and deduplication. */


/** Integer identifier representing a unique interned string inside an `Interner`. */
pub SymbolId := alias Int;

/** Sentinel invalid symbol identifier. */
pub INVALID_SYMBOL := -1;

/** Opaque generational handle to an interner table. */
pub Interner := alias (handle: Int, gen: Int);

/** Deduplication statistics snapshot for an `Interner`. */
pub InternStats := alias (uniqueCount: Int, totalChars: Int, internCalls: Int, hitCalls: Int);

/* --- Global string entry slab (recycled on clear/destroy) --- */
var entryText: mut List<String> = [];
var entryOwner: mut List<Int> = [];
var entryOwnerGen: mut List<Int> = [];
var entryAlive: mut List<Bool> = [];
var entryNextInTable: mut List<Int> = [];
var entryFreeSlots: mut List<Int> = [];

/* --- Lookup map: "<tableId>:<text>" -> global entry index (SymbolId) --- */
var lookupMap: mut Map<String, Int>;

/* --- Per-interner metadata --- */
var tblHead: mut List<Int> = [];
var tblCount: mut List<Int> = [];
var tblChars: mut List<Int> = [];
var tblCalls: mut List<Int> = [];
var tblHits: mut List<Int> = [];
var tblGen: mut List<Int> = [];
var tblAlive: mut List<Bool> = [];
var tblFreeSlots: mut List<Int> = [];

validTable := fn(table: Interner): Bool {
    idx := table.handle;
    idx >= 0 and idx < tblAlive.length() and tblAlive[idx] and tblGen[idx] == table.gen
};

makeKey := fn(tableId: Int, value: String): String {
    tableId.toText() + ":" + value
};

purgeEntries := fn(tableId: Int): Unit {
    var cur := tblHead[tableId];
    loop cur >= 0 {
        next := entryNextInTable[cur];
        key := makeKey(tableId, entryText[cur]);
        _rm := mut lookupMap.remove(key);
        mut entryAlive.setAt(cur, false);
        mut entryText.setAt(cur, "");
        mut entryOwner.setAt(cur, -1);
        mut entryOwnerGen.setAt(cur, 0);
        mut entryNextInTable.setAt(cur, -1);
        mut entryFreeSlots.pushBack(cur);
        cur = next;
    }
    (mut tblHead).setAt(tableId, -1);
    mut tblCount.setAt(tableId, 0);
    mut tblChars.setAt(tableId, 0);
    mut tblCalls.setAt(tableId, 0);
    mut tblHits.setAt(tableId, 0);
};

/** Creates a new empty string interner. */
pub create := fn(): Interner {
    if tblFreeSlots.length() > 0 {
        slot := mut tblFreeSlots.popBack();
        mut tblHead.setAt(slot, -1);
        mut tblCount.setAt(slot, 0);
        mut tblChars.setAt(slot, 0);
        mut tblCalls.setAt(slot, 0);
        mut tblHits.setAt(slot, 0);
        mut tblAlive.setAt(slot, true);
        return (handle = slot, gen = tblGen[slot]);
    }
    slot := tblHead.length();
    mut tblHead.pushBack(-1);
    mut tblCount.pushBack(0);
    mut tblChars.pushBack(0);
    mut tblCalls.pushBack(0);
    mut tblHits.pushBack(0);
    mut tblGen.pushBack(1);
    mut tblAlive.pushBack(true);
    (handle = slot, gen = 1)
};

/** True when `table` refers to a live interner. */
pub isValid := fn(table: Interner): Bool {
    validTable(table)
};

/** Interns `value` in O(1), returning its stable `SymbolId` (or `INVALID_SYMBOL` if `table` is invalid). */
pub intern := fn(table: Interner, value: String): SymbolId {
    if not validTable(table) { return INVALID_SYMBOL; }
    tid := table.handle;
    mut tblCalls.setAt(tid, tblCalls[tid] + 1);
    key := makeKey(tid, value);
    existing := lookupMap.get(key);
    if existing.found {
        mut tblHits.setAt(tid, tblHits[tid] + 1);
        return existing.value;
    }

    var eid := -1;
    if entryFreeSlots.length() > 0 {
        eid = mut entryFreeSlots.popBack();
        mut entryText.setAt(eid, value);
        mut entryOwner.setAt(eid, tid);
        mut entryOwnerGen.setAt(eid, table.gen);
        mut entryAlive.setAt(eid, true);
        mut entryNextInTable.setAt(eid, tblHead[tid]);
    } else {
        eid = entryText.length();
        mut entryText.pushBack(value);
        mut entryOwner.pushBack(tid);
        mut entryOwnerGen.pushBack(table.gen);
        mut entryAlive.pushBack(true);
        mut entryNextInTable.pushBack(tblHead[tid]);
    }
    (mut tblHead).setAt(tid, eid);
    mut tblCount.setAt(tid, tblCount[tid] + 1);
    mut tblChars.setAt(tid, tblChars[tid] + value.length());
    mut lookupMap.set(key, eid);
    eid
};

/** Looks up `value` without inserting it. */
pub lookup := fn(table: Interner, value: String): (found: Bool, id: SymbolId) {
    if not validTable(table) { return (found = false, id = INVALID_SYMBOL); }
    res := lookupMap.get(makeKey(table.handle, value));
    if res.found {
        (found = true, id = res.value)
    } else {
        (found = false, id = INVALID_SYMBOL)
    }
};

/** True when `value` is currently interned in `table`. */
pub has := fn(table: Interner, value: String): Bool {
    if not validTable(table) { return false; }
    lookupMap.has(makeKey(table.handle, value))
};

/** True when `id` currently resolves to a live symbol owned by `table`. */
pub hasId := fn(table: Interner, id: SymbolId): Bool {
    if not validTable(table) or id < 0 or id >= entryAlive.length() { return false; }
    entryAlive[id] and entryOwner[id] == table.handle and entryOwnerGen[id] == table.gen
};

/** Resolves `id` back to its interned `String` in O(1). */
pub resolve := fn(table: Interner, id: SymbolId): (found: Bool, value: String) {
    if not hasId(table, id) { return (found = false, value = ""); }
    (found = true, value = entryText[id])
};

/** Resolves `id` back to its interned `String`, or `fallback` when absent. */
pub resolveOr := fn(table: Interner, id: SymbolId, fallback: String): String {
    if not hasId(table, id) { return fallback; }
    entryText[id]
};

/** Returns the number of unique strings currently stored in `table`. */
pub count := fn(table: Interner): Int {
    if not validTable(table) { return 0; }
    tblCount[table.handle]
};

/** Returns the total character count of all unique strings currently stored in `table`. */
pub totalChars := fn(table: Interner): Int {
    if not validTable(table) { return 0; }
    tblChars[table.handle]
};

/** Returns deduplication statistics for `table`. */
pub stats := fn(table: Interner): InternStats {
    if not validTable(table) {
        return (uniqueCount = 0, totalChars = 0, internCalls = 0, hitCalls = 0);
    }
    tid := table.handle;
    (uniqueCount = tblCount[tid], totalChars = tblChars[tid], internCalls = tblCalls[tid], hitCalls = tblHits[tid])
};

/** Clears all interned strings from `table`, removing its map keys and recycling entry slots. */
pub clear := fn(table: Interner): Unit {
    if not validTable(table) { return; }
    purgeEntries(table.handle);
};

/** Destroys `table`, freeing all of its map entries and recycling its handle slot. */
pub destroy := fn(table: Interner): Unit {
    if not validTable(table) { return; }
    tid := table.handle;
    purgeEntries(tid);
    mut tblAlive.setAt(tid, false);
    mut tblGen.setAt(tid, tblGen[tid] + 1);
    mut tblFreeSlots.pushBack(tid);
};
