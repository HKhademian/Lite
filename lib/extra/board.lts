/* Optional 2D shape, sprite, and pixel-grid helpers built on extra/canvas. */

list := import "core/list";
text := import "core/text";
canvas := import "./canvas";

/** Draws a crisp 1-pixel outline rectangle at `(x, y, width, height)` without double-blending corners. */
pub drawRect := fn(x: Int, y: Int, width: Int, height: Int, color: canvas.Color): Unit {
    if width <= 0 or height <= 0 { return; }
    canvas.fillRect(x, y, width, 1, color);
    if height > 1 {
        canvas.fillRect(x, y + height - 1, width, 1, color);
    }
    if height > 2 {
        canvas.fillRect(x, y + 1, 1, height - 2, color);
        if width > 1 {
            canvas.fillRect(x + width - 1, y + 1, 1, height - 2, color);
        }
    }
}

absInt := fn(value: Int): Int {
    if value < 0 { 0 - value } else { value }
}

/** Draws an integer Bresenham line from `(x0, y0)` to `(x1, y1)`. */
pub drawLine := fn(x0: Int, y0: Int, x1: Int, y1: Int, color: canvas.Color): Unit {
    dx := absInt(x1 - x0);
    sx := if x0 < x1 { 1 } else { -1 };
    dy := 0 - absInt(y1 - y0);
    sy := if y0 < y1 { 1 } else { -1 };
    var cx := x0;
    var cy := y0;
    var err := dx + dy;
    loop true {
        canvas.setPixel(cx, cy, color);
        if cx == x1 and cy == y1 { break; }
        e2 := 2 * err;
        if e2 >= dy {
            err += dy;
            cx += sx;
        }
        if e2 <= dx {
            err += dx;
            cy += sy;
        }
    }
}

/** Fills a raster disk centered at `(cx, cy)` with inclusive integer radius. */
pub fillCircle := fn(cx: Int, cy: Int, radius: Int, color: canvas.Color): Unit {
    if radius < 0 { return; }
    limit := radius * radius;
    var dy := 0 - radius;
    loop dy <= radius {
        var dx := 0 - radius;
        loop dx <= radius {
            if (dx * dx) + (dy * dy) <= limit {
                canvas.setPixel(cx + dx, cy + dy, color);
            }
            dx += 1;
        }
        dy += 1;
    }
}

/** Draws every occurrence of `glyph` from `rows` at top-left `(x, y)` in `color`. */
pub drawSprite := fn(x: Int, y: Int, rows: List<String>, glyph: String, color: canvas.Color): Unit {
    var rowIdx := 0;
    loop rows as line {
        cols := text.length(line);
        var colIdx := 0;
        loop colIdx < cols {
            if text.at(line, colIdx) == glyph {
                canvas.setPixel(x + colIdx, y + rowIdx, color);
            }
            colIdx += 1;
        }
        rowIdx += 1;
    }
}

/** Creates a row-major pixel buffer matching the latest canvas dimensions filled with `color`. */
pub fillGrid := fn(color: canvas.Color): List<canvas.Color> {
    pixels: mut List<canvas.Color> = [];
    total := canvas.getWidth() * canvas.getHeight();
    var index := 0;
    loop index < total {
        list.pushBack(mut pixels, color);
        index += 1;
    }
    pixels
}
