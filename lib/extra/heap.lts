/** Experimental binary heaps and keyed priority queues (`extra/heap`) for timers, schedulers, and pathfinding. */

list := import "core/list";

/** Opaque generational handle to a binary min-heap of `Int` values. */
pub MinHeap := type (handle: Int, gen: Int);

/** Opaque generational handle to a binary max-heap of `Int` values. */
pub MaxHeap := type (handle: Int, gen: Int);

/** Opaque generational handle to a min-priority queue storing `(priority, item)` pairs. */
pub PriorityQueue := type (handle: Int, gen: Int);

/* --- Unified flat heap slab (shared by MinHeap and MaxHeap via isMax flag) --- */
var hSlab: mut List<Int> = [];
var hBase: mut List<Int> = [];
var hCap: mut List<Int> = [];
var hCount: mut List<Int> = [];
var hIsMax: mut List<Bool> = [];
var hGen: mut List<Int> = [];
var hAlive: mut List<Bool> = [];
var hFree: mut List<Int> = [];

/* --- Keyed PriorityQueue flat slab --- */
var pqPrio: mut List<Int> = [];
var pqItem: mut List<Int> = [];
var pqBase: mut List<Int> = [];
var pqCap: mut List<Int> = [];
var pqLen: mut List<Int> = [];
var pqGen: mut List<Int> = [];
var pqAlive: mut List<Bool> = [];
var pqFree: mut List<Int> = [];

validHeap := fn(id: Int, gen: Int, expectMax: Bool): Bool {
    id >= 0 and id < list.length(hAlive) and hAlive[id] and hGen[id] == gen and hIsMax[id] == expectMax
};

validPQ := fn(pq: PriorityQueue): Bool {
    id := pq.handle;
    id >= 0 and id < list.length(pqAlive) and pqAlive[id] and pqGen[id] == pq.gen
};

heapBetter := fn(a: Int, b: Int, isMax: Bool): Bool {
    if isMax { a > b } else { a < b }
};

createHeapRaw := fn(capacity: Int, isMax: Bool): (handle: Int, gen: Int) {
    cap := if capacity < 1 { 1 } else { capacity };
    var fi := list.length(hFree) - 1;
    loop fi >= 0 {
        id := hFree[fi];
        if hCap[id] >= cap {
            last := list.length(hFree) - 1;
            if fi =!= last { list.setAt(mut hFree, fi, hFree[last]); }
            _drop := list.popBack(mut hFree);
            list.setAt(mut hCap, id, cap);
            list.setAt(mut hCount, id, 0);
            list.setAt(mut hIsMax, id, isMax);
            list.setAt(mut hAlive, id, true);
            return (handle = id, gen = hGen[id]);
        }
        fi -= 1;
    }

    base := list.length(hSlab);
    var i := 0;
    loop i < cap {
        list.pushBack(mut hSlab, 0);
        i += 1;
    }
    id := list.length(hBase);
    list.pushBack(mut hBase, base);
    list.pushBack(mut hCap, cap);
    list.pushBack(mut hCount, 0);
    list.pushBack(mut hIsMax, isMax);
    list.pushBack(mut hGen, 1);
    list.pushBack(mut hAlive, true);
    (handle = id, gen = 1)
};

pushHeapRaw := fn(id: Int, value: Int, isMax: Bool): Bool {
    cnt := hCount[id];
    if cnt >= hCap[id] { return false; }
    base := hBase[id];
    var idx := cnt;
    list.setAt(mut hSlab, base + idx, value);
    list.setAt(mut hCount, id, cnt + 1);
    loop idx > 0 {
        parent := (idx - 1) / 2;
        pv := hSlab[base + parent];
        cv := hSlab[base + idx];
        if heapBetter(cv, pv, isMax) {
            list.setAt(mut hSlab, base + parent, cv);
            list.setAt(mut hSlab, base + idx, pv);
            idx = parent;
        } else {
            break;
        }
    }
    true
};

popHeapRaw := fn(id: Int, isMax: Bool): (found: Bool, value: Int) {
    cnt := hCount[id];
    if cnt <= 0 { return (found = false, value = 0); }
    base := hBase[id];
    top := hSlab[base];
    nextCnt := cnt - 1;
    list.setAt(mut hCount, id, nextCnt);
    if nextCnt > 0 {
        list.setAt(mut hSlab, base, hSlab[base + nextCnt]);
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and heapBetter(hSlab[base + left], hSlab[base + best], isMax) {
                best = left;
            }
            if right < nextCnt and heapBetter(hSlab[base + right], hSlab[base + best], isMax) {
                best = right;
            }
            if best == idx { break; }
            tmp := hSlab[base + idx];
            list.setAt(mut hSlab, base + idx, hSlab[base + best]);
            list.setAt(mut hSlab, base + best, tmp);
            idx = best;
        }
    }
    (found = true, value = top)
};

/* ============================================================================
 * MinHeap API
 * ============================================================================ */

/** Creates a fixed-capacity binary min-heap (`capacity >= 1`). */
pub createMin := fn(capacity: Int): MinHeap {
    createHeapRaw(capacity, false)
};

/** Pushes `value` into `heap` in O(log n); returns `false` if full. */
pub pushMin := fn(heap: MinHeap, value: Int): Bool {
    if not validHeap(heap.handle, heap.gen, false) { return false; }
    pushHeapRaw(heap.handle, value, false)
};

/** Removes and returns the minimum value in O(log n). */
pub popMin := fn(heap: MinHeap): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, false) { return (found = false, value = 0); }
    popHeapRaw(heap.handle, false)
};

/** Returns the minimum value without removing it in O(1). */
pub peekMin := fn(heap: MinHeap): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, false) { return (found = false, value = 0); }
    id := heap.handle;
    if hCount[id] <= 0 { return (found = false, value = 0); }
    (found = true, value = hSlab[hBase[id]])
};

/** Returns the number of elements in `heap`. */
pub minCount := fn(heap: MinHeap): Int {
    if not validHeap(heap.handle, heap.gen, false) { return 0; }
    hCount[heap.handle]
};

/** Clears `heap` in O(1). */
pub clearMin := fn(heap: MinHeap): Unit {
    if not validHeap(heap.handle, heap.gen, false) { return; }
    list.setAt(mut hCount, heap.handle, 0);
};

/** Destroys `heap` and recycles its handle slot. */
pub destroyMin := fn(heap: MinHeap): Unit {
    if not validHeap(heap.handle, heap.gen, false) { return; }
    id := heap.handle;
    list.setAt(mut hAlive, id, false);
    list.setAt(mut hGen, id, hGen[id] + 1);
    list.pushBack(mut hFree, id);
};

/* ============================================================================
 * MaxHeap API
 * ============================================================================ */

/** Creates a fixed-capacity binary max-heap (`capacity >= 1`). */
pub createMax := fn(capacity: Int): MaxHeap {
    createHeapRaw(capacity, true)
};

/** Pushes `value` into `heap` in O(log n); returns `false` if full. */
pub pushMax := fn(heap: MaxHeap, value: Int): Bool {
    if not validHeap(heap.handle, heap.gen, true) { return false; }
    pushHeapRaw(heap.handle, value, true)
};

/** Removes and returns the maximum value in O(log n). */
pub popMax := fn(heap: MaxHeap): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, true) { return (found = false, value = 0); }
    popHeapRaw(heap.handle, true)
};

/** Returns the maximum value without removing it in O(1). */
pub peekMax := fn(heap: MaxHeap): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, true) { return (found = false, value = 0); }
    id := heap.handle;
    if hCount[id] <= 0 { return (found = false, value = 0); }
    (found = true, value = hSlab[hBase[id]])
};

/** Returns the number of elements in `heap`. */
pub maxCount := fn(heap: MaxHeap): Int {
    if not validHeap(heap.handle, heap.gen, true) { return 0; }
    hCount[heap.handle]
};

/** Clears `heap` in O(1). */
pub clearMax := fn(heap: MaxHeap): Unit {
    if not validHeap(heap.handle, heap.gen, true) { return; }
    list.setAt(mut hCount, heap.handle, 0);
};

/** Destroys `heap` and recycles its handle slot. */
pub destroyMax := fn(heap: MaxHeap): Unit {
    if not validHeap(heap.handle, heap.gen, true) { return; }
    id := heap.handle;
    list.setAt(mut hAlive, id, false);
    list.setAt(mut hGen, id, hGen[id] + 1);
    list.pushBack(mut hFree, id);
};

/* ============================================================================
 * Keyed PriorityQueue (lowest priority popped first)
 * ============================================================================ */

/** Creates a fixed-capacity min-priority queue storing `(priority, item)` pairs. */
pub createPQ := fn(capacity: Int): PriorityQueue {
    cap := if capacity < 1 { 1 } else { capacity };
    var fi := list.length(pqFree) - 1;
    loop fi >= 0 {
        id := pqFree[fi];
        if pqCap[id] >= cap {
            last := list.length(pqFree) - 1;
            if fi =!= last { list.setAt(mut pqFree, fi, pqFree[last]); }
            _drop := list.popBack(mut pqFree);
            list.setAt(mut pqCap, id, cap);
            list.setAt(mut pqLen, id, 0);
            list.setAt(mut pqAlive, id, true);
            return (handle = id, gen = pqGen[id]);
        }
        fi -= 1;
    }

    base := list.length(pqPrio);
    var i := 0;
    loop i < cap {
        list.pushBack(mut pqPrio, 0);
        list.pushBack(mut pqItem, 0);
        i += 1;
    }
    id := list.length(pqBase);
    list.pushBack(mut pqBase, base);
    list.pushBack(mut pqCap, cap);
    list.pushBack(mut pqLen, 0);
    list.pushBack(mut pqGen, 1);
    list.pushBack(mut pqAlive, true);
    (handle = id, gen = 1)
};

/** Enqueues `(priority, item)` in O(log n); returns `false` if full. */
pub pushPQ := fn(pq: PriorityQueue, priority: Int, item: Int): Bool {
    if not validPQ(pq) { return false; }
    id := pq.handle;
    cnt := pqLen[id];
    if cnt >= pqCap[id] { return false; }
    base := pqBase[id];
    var idx := cnt;
    list.setAt(mut pqPrio, base + idx, priority);
    list.setAt(mut pqItem, base + idx, item);
    list.setAt(mut pqLen, id, cnt + 1);
    loop idx > 0 {
        parent := (idx - 1) / 2;
        pp := pqPrio[base + parent];
        cp := pqPrio[base + idx];
        if cp < pp {
            pi := pqItem[base + parent];
            ci := pqItem[base + idx];
            list.setAt(mut pqPrio, base + parent, cp);
            list.setAt(mut pqItem, base + parent, ci);
            list.setAt(mut pqPrio, base + idx, pp);
            list.setAt(mut pqItem, base + idx, pi);
            idx = parent;
        } else {
            break;
        }
    }
    true
};

/** Removes and returns the lowest-priority `(priority, item)` pair in O(log n). */
pub popPQ := fn(pq: PriorityQueue): (found: Bool, priority: Int, item: Int) {
    if not validPQ(pq) { return (found = false, priority = 0, item = 0); }
    id := pq.handle;
    cnt := pqLen[id];
    if cnt <= 0 { return (found = false, priority = 0, item = 0); }
    base := pqBase[id];
    topP := pqPrio[base];
    topI := pqItem[base];
    nextCnt := cnt - 1;
    list.setAt(mut pqLen, id, nextCnt);
    if nextCnt > 0 {
        list.setAt(mut pqPrio, base, pqPrio[base + nextCnt]);
        list.setAt(mut pqItem, base, pqItem[base + nextCnt]);
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and pqPrio[base + left] < pqPrio[base + best] {
                best = left;
            }
            if right < nextCnt and pqPrio[base + right] < pqPrio[base + best] {
                best = right;
            }
            if best == idx { break; }
            tp := pqPrio[base + idx];
            ti := pqItem[base + idx];
            list.setAt(mut pqPrio, base + idx, pqPrio[base + best]);
            list.setAt(mut pqItem, base + idx, pqItem[base + best]);
            list.setAt(mut pqPrio, base + best, tp);
            list.setAt(mut pqItem, base + best, ti);
            idx = best;
        }
    }
    (found = true, priority = topP, item = topI)
};

/** Peeks at the lowest-priority `(priority, item)` without removing it in O(1). */
pub peekPQ := fn(pq: PriorityQueue): (found: Bool, priority: Int, item: Int) {
    if not validPQ(pq) { return (found = false, priority = 0, item = 0); }
    id := pq.handle;
    if pqLen[id] <= 0 { return (found = false, priority = 0, item = 0); }
    base := pqBase[id];
    (found = true, priority = pqPrio[base], item = pqItem[base])
};

/** Returns the number of queued entries in `pq`. */
pub pqCount := fn(pq: PriorityQueue): Int {
    if not validPQ(pq) { return 0; }
    pqLen[pq.handle]
};

/** Clears `pq` in O(1). */
pub clearPQ := fn(pq: PriorityQueue): Unit {
    if not validPQ(pq) { return; }
    list.setAt(mut pqLen, pq.handle, 0);
};

/** Destroys `pq` and recycles its handle slot. */
pub destroyPQ := fn(pq: PriorityQueue): Unit {
    if not validPQ(pq) { return; }
    id := pq.handle;
    list.setAt(mut pqAlive, id, false);
    list.setAt(mut pqGen, id, pqGen[id] + 1);
    list.pushBack(mut pqFree, id);
};
