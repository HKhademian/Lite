/** Experimental binary heaps and keyed priority queues (`extra/heap`) for timers, schedulers, and pathfinding. */

/** Opaque generational handle to a binary min-heap of `Int` values. */
pub MinHeap := record { handle: Int; gen: Int; };

/** Opaque generational handle to a binary max-heap of `Int` values. */
pub MaxHeap := record { handle: Int; gen: Int; };

/** Opaque generational handle to a min-priority queue storing `(priority, item)` pairs. */
pub PriorityQueue := record { handle: Int; gen: Int; };

/* --- Unified flat heap slab (shared by MinHeap and MaxHeap via isMax flag) --- */
var hSlab: mut List<Int> = [];
var hBase: mut List<Int> = [];
var hCap: mut List<Int> = [];
var hCount: mut List<Int> = [];
var hIsMax: mut List<Bool> = [];
var hGen: mut List<Int> = [];
var hAlive: mut List<Bool> = [];
var hFree: mut List<Int> = [];

/* --- Keyed PriorityQueue flat slab --- */
var pqPrio: mut List<Int> = [];
var pqItem: mut List<Int> = [];
var pqBase: mut List<Int> = [];
var pqCap: mut List<Int> = [];
var pqLen: mut List<Int> = [];
var pqGen: mut List<Int> = [];
var pqAlive: mut List<Bool> = [];
var pqFree: mut List<Int> = [];

validHeap := fn(id: Int, gen: Int, expectMax: Bool): Bool {
    id >= 0 and id < hAlive.length() and hAlive[id] and hGen[id] == gen and hIsMax[id] == expectMax
};

validPQ := fn(pq: PriorityQueue): Bool {
    id := pq.handle;
    id >= 0 and id < pqAlive.length() and pqAlive[id] and pqGen[id] == pq.gen
};

heapBetter := fn(a: Int, b: Int, isMax: Bool): Bool {
    if isMax { a > b } else { a < b }
};

createHeapRaw := fn(capacity: Int, isMax: Bool): (handle: Int, gen: Int) {
    cap := if capacity < 1 { 1 } else { capacity };
    var fi := hFree.length() - 1;
    loop fi >= 0 {
        id := hFree[fi];
        if hCap[id] >= cap {
            last := hFree.length() - 1;
            if fi =!= last { hFree[fi] = hFree[last]; }
            _drop := hFree.popBack();
            hCap[id] = cap;
            hCount[id] = 0;
            hIsMax[id] = isMax;
            hAlive[id] = true;
            return (handle = id, gen = hGen[id]);
        }
        fi -= 1;
    }

    base := hSlab.length();
    var i := 0;
    loop i < cap {
        hSlab.pushBack(0);
        i += 1;
    }
    id := hBase.length();
    hBase.pushBack(base);
    hCap.pushBack(cap);
    hCount.pushBack(0);
    hIsMax.pushBack(isMax);
    hGen.pushBack(1);
    hAlive.pushBack(true);
    (handle = id, gen = 1)
};

pushHeapRaw := fn(id: Int, value: Int, isMax: Bool): Bool {
    cnt := hCount[id];
    if cnt >= hCap[id] { return false; }
    base := hBase[id];
    var idx := cnt;
    hSlab[base + idx] = value;
    hCount[id] = cnt + 1;
    loop idx > 0 {
        parent := (idx - 1) / 2;
        pv := hSlab[base + parent];
        cv := hSlab[base + idx];
        if heapBetter(cv, pv, isMax) {
            hSlab[base + parent] = cv;
            hSlab[base + idx] = pv;
            idx = parent;
        } else {
            break;
        }
    }
    true
};

popHeapRaw := fn(id: Int, isMax: Bool): (found: Bool, value: Int) {
    cnt := hCount[id];
    if cnt <= 0 { return (found = false, value = 0); }
    base := hBase[id];
    top := hSlab[base];
    nextCnt := cnt - 1;
    hCount[id] = nextCnt;
    if nextCnt > 0 {
        hSlab[base] = hSlab[base + nextCnt];
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and heapBetter(hSlab[base + left], hSlab[base + best], isMax) {
                best = left;
            }
            if right < nextCnt and heapBetter(hSlab[base + right], hSlab[base + best], isMax) {
                best = right;
            }
            if best == idx { break; }
            tmp := hSlab[base + idx];
            hSlab[base + idx] = hSlab[base + best];
            hSlab[base + best] = tmp;
            idx = best;
        }
    }
    (found = true, value = top)
};

/* ============================================================================
 * MinHeap API
 * ============================================================================ */

/** Creates a fixed-capacity binary min-heap (`capacity >= 1`). */
pub createMin := fn(capacity: Int): MinHeap {
    raw := createHeapRaw(capacity, false);
    MinHeap { handle = raw.handle, gen = raw.gen }
};

/** Pushes `value` into `heap` in O(log n); returns `false` if full. */
pub MinHeap.push := fn(heap: Self, value: Int): Bool {
    if not validHeap(heap.handle, heap.gen, false) { return false; }
    pushHeapRaw(heap.handle, value, false)
};

/** Removes and returns the minimum value in O(log n). */
pub MinHeap.pop := fn(heap: Self): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, false) { return (found = false, value = 0); }
    popHeapRaw(heap.handle, false)
};

/** Returns the minimum value without removing it in O(1). */
pub MinHeap.peek := fn(heap: Self): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, false) { return (found = false, value = 0); }
    id := heap.handle;
    if hCount[id] <= 0 { return (found = false, value = 0); }
    (found = true, value = hSlab[hBase[id]])
};

/** Returns the number of elements in `heap`. */
pub MinHeap.count := fn(heap: Self): Int {
    if not validHeap(heap.handle, heap.gen, false) { return 0; }
    hCount[heap.handle]
};

/** Clears `heap` in O(1). */
pub MinHeap.clear := fn(heap: Self): Unit {
    if not validHeap(heap.handle, heap.gen, false) { return; }
    hCount[heap.handle] = 0;
};

/** Destroys `heap` and recycles its handle slot. */
pub MinHeap.destroy := fn(heap: Self): Unit {
    if not validHeap(heap.handle, heap.gen, false) { return; }
    id := heap.handle;
    hAlive[id] = false;
    hGen[id] = hGen[id] + 1;
    hFree.pushBack(id);
};

/** #deprecated Use `heap.push(value)` instead. */
pub pushMin := fn(heap: MinHeap, value: Int): Bool { heap.push(value) };

/** #deprecated Use `heap.pop()` instead. */
pub popMin := fn(heap: MinHeap): (found: Bool, value: Int) { heap.pop() };

/** #deprecated Use `heap.peek()` instead. */
pub peekMin := fn(heap: MinHeap): (found: Bool, value: Int) { heap.peek() };

/** #deprecated Use `heap.count()` instead. */
pub minCount := fn(heap: MinHeap): Int { heap.count() };

/** #deprecated Use `heap.clear()` instead. */
pub clearMin := fn(heap: MinHeap): Unit { heap.clear(); };

/** #deprecated Use `heap.destroy()` instead. */
pub destroyMin := fn(heap: MinHeap): Unit { heap.destroy(); };

/* ============================================================================
 * MaxHeap API
 * ============================================================================ */

/** Creates a fixed-capacity binary max-heap (`capacity >= 1`). */
pub createMax := fn(capacity: Int): MaxHeap {
    raw := createHeapRaw(capacity, true);
    MaxHeap { handle = raw.handle, gen = raw.gen }
};

/** Pushes `value` into `heap` in O(log n); returns `false` if full. */
pub MaxHeap.push := fn(heap: Self, value: Int): Bool {
    if not validHeap(heap.handle, heap.gen, true) { return false; }
    pushHeapRaw(heap.handle, value, true)
};

/** Removes and returns the maximum value in O(log n). */
pub MaxHeap.pop := fn(heap: Self): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, true) { return (found = false, value = 0); }
    popHeapRaw(heap.handle, true)
};

/** Returns the maximum value without removing it in O(1). */
pub MaxHeap.peek := fn(heap: Self): (found: Bool, value: Int) {
    if not validHeap(heap.handle, heap.gen, true) { return (found = false, value = 0); }
    id := heap.handle;
    if hCount[id] <= 0 { return (found = false, value = 0); }
    (found = true, value = hSlab[hBase[id]])
};

/** Returns the number of elements in `heap`. */
pub MaxHeap.count := fn(heap: Self): Int {
    if not validHeap(heap.handle, heap.gen, true) { return 0; }
    hCount[heap.handle]
};

/** Clears `heap` in O(1). */
pub MaxHeap.clear := fn(heap: Self): Unit {
    if not validHeap(heap.handle, heap.gen, true) { return; }
    hCount[heap.handle] = 0;
};

/** Destroys `heap` and recycles its handle slot. */
pub MaxHeap.destroy := fn(heap: Self): Unit {
    if not validHeap(heap.handle, heap.gen, true) { return; }
    id := heap.handle;
    hAlive[id] = false;
    hGen[id] = hGen[id] + 1;
    hFree.pushBack(id);
};

/** #deprecated Use `heap.push(value)` instead. */
pub pushMax := fn(heap: MaxHeap, value: Int): Bool { heap.push(value) };

/** #deprecated Use `heap.pop()` instead. */
pub popMax := fn(heap: MaxHeap): (found: Bool, value: Int) { heap.pop() };

/** #deprecated Use `heap.peek()` instead. */
pub peekMax := fn(heap: MaxHeap): (found: Bool, value: Int) { heap.peek() };

/** #deprecated Use `heap.count()` instead. */
pub maxCount := fn(heap: MaxHeap): Int { heap.count() };

/** #deprecated Use `heap.clear()` instead. */
pub clearMax := fn(heap: MaxHeap): Unit { heap.clear(); };

/** #deprecated Use `heap.destroy()` instead. */
pub destroyMax := fn(heap: MaxHeap): Unit { heap.destroy(); };

/* ============================================================================
 * Keyed PriorityQueue (lowest priority popped first)
 * ============================================================================ */

/** Creates a fixed-capacity min-priority queue storing `(priority, item)` pairs. */
pub createPQ := fn(capacity: Int): PriorityQueue {
    cap := if capacity < 1 { 1 } else { capacity };
    var fi := pqFree.length() - 1;
    loop fi >= 0 {
        id := pqFree[fi];
        if pqCap[id] >= cap {
            last := pqFree.length() - 1;
            if fi =!= last { pqFree[fi] = pqFree[last]; }
            _drop := pqFree.popBack();
            pqCap[id] = cap;
            pqLen[id] = 0;
            pqAlive[id] = true;
            return PriorityQueue { handle = id, gen = pqGen[id] };
        }
        fi -= 1;
    }

    base := pqPrio.length();
    var i := 0;
    loop i < cap {
        pqPrio.pushBack(0);
        pqItem.pushBack(0);
        i += 1;
    }
    id := pqBase.length();
    pqBase.pushBack(base);
    pqCap.pushBack(cap);
    pqLen.pushBack(0);
    pqGen.pushBack(1);
    pqAlive.pushBack(true);
    PriorityQueue { handle = id, gen = 1 }
};

/** Enqueues `(priority, item)` in O(log n); returns `false` if full. */
pub PriorityQueue.push := fn(pq: Self, priority: Int, item: Int): Bool {
    if not validPQ(pq) { return false; }
    id := pq.handle;
    cnt := pqLen[id];
    if cnt >= pqCap[id] { return false; }
    base := pqBase[id];
    var idx := cnt;
    pqPrio[base + idx] = priority;
    pqItem[base + idx] = item;
    pqLen[id] = cnt + 1;
    loop idx > 0 {
        parent := (idx - 1) / 2;
        pp := pqPrio[base + parent];
        cp := pqPrio[base + idx];
        if cp < pp {
            pi := pqItem[base + parent];
            ci := pqItem[base + idx];
            pqPrio[base + parent] = cp;
            pqItem[base + parent] = ci;
            pqPrio[base + idx] = pp;
            pqItem[base + idx] = pi;
            idx = parent;
        } else {
            break;
        }
    }
    true
};

/** Removes and returns the lowest-priority `(priority, item)` pair in O(log n). */
pub PriorityQueue.pop := fn(pq: Self): (found: Bool, priority: Int, item: Int) {
    if not validPQ(pq) { return (found = false, priority = 0, item = 0); }
    id := pq.handle;
    cnt := pqLen[id];
    if cnt <= 0 { return (found = false, priority = 0, item = 0); }
    base := pqBase[id];
    topP := pqPrio[base];
    topI := pqItem[base];
    nextCnt := cnt - 1;
    pqLen[id] = nextCnt;
    if nextCnt > 0 {
        pqPrio[base] = pqPrio[base + nextCnt];
        pqItem[base] = pqItem[base + nextCnt];
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and pqPrio[base + left] < pqPrio[base + best] {
                best = left;
            }
            if right < nextCnt and pqPrio[base + right] < pqPrio[base + best] {
                best = right;
            }
            if best == idx { break; }
            tp := pqPrio[base + idx];
            ti := pqItem[base + idx];
            pqPrio[base + idx] = pqPrio[base + best];
            pqItem[base + idx] = pqItem[base + best];
            pqPrio[base + best] = tp;
            pqItem[base + best] = ti;
            idx = best;
        }
    }
    (found = true, priority = topP, item = topI)
};

/** Peeks at the lowest-priority `(priority, item)` without removing it in O(1). */
pub PriorityQueue.peek := fn(pq: Self): (found: Bool, priority: Int, item: Int) {
    if not validPQ(pq) { return (found = false, priority = 0, item = 0); }
    id := pq.handle;
    if pqLen[id] <= 0 { return (found = false, priority = 0, item = 0); }
    base := pqBase[id];
    (found = true, priority = pqPrio[base], item = pqItem[base])
};

/** Returns the number of queued entries in `pq`. */
pub PriorityQueue.count := fn(pq: Self): Int {
    if not validPQ(pq) { return 0; }
    pqLen[pq.handle]
};

/** Clears `pq` in O(1). */
pub PriorityQueue.clear := fn(pq: Self): Unit {
    if not validPQ(pq) { return; }
    pqLen[pq.handle] = 0;
};

/** Destroys `pq` and recycles its handle slot. */
pub PriorityQueue.destroy := fn(pq: Self): Unit {
    if not validPQ(pq) { return; }
    id := pq.handle;
    pqAlive[id] = false;
    pqGen[id] = pqGen[id] + 1;
    pqFree.pushBack(id);
};

/** #deprecated Use `pq.push(priority, item)` instead. */
pub pushPQ := fn(pq: PriorityQueue, priority: Int, item: Int): Bool { pq.push(priority, item) };

/** #deprecated Use `pq.pop()` instead. */
pub popPQ := fn(pq: PriorityQueue): (found: Bool, priority: Int, item: Int) { pq.pop() };

/** #deprecated Use `pq.peek()` instead. */
pub peekPQ := fn(pq: PriorityQueue): (found: Bool, priority: Int, item: Int) { pq.peek() };

/** #deprecated Use `pq.count()` instead. */
pub pqCount := fn(pq: PriorityQueue): Int { pq.count() };

/** #deprecated Use `pq.clear()` instead. */
pub clearPQ := fn(pq: PriorityQueue): Unit { pq.clear(); };

/** #deprecated Use `pq.destroy()` instead. */
pub destroyPQ := fn(pq: PriorityQueue): Unit { pq.destroy(); };
