/** Shared compiler-testing harness utilities for native `.test.lts` suites. */

crypto := import "core/crypto";
fs := import "core/file";
integer := import "core/int";
list := import "core/list";
path := import "core/path";
proc := import "core/process";
project := import "util/project";
test := import "core/test";
text := import "core/text";
unicode := import "core/unicode";
cases := import "util/cases";
json := import "util/json";

/** Result of compiling or executing a Lite program or compiler phase driver. */
pub RunOutput := type (status: Int, stdout: String, stderr: String);

/** Prepared TS-compiled phase driver artifact and isolated Node runner inside `workDir`. */
pub TestDriver := type (workDir: String, artifactPath: String, runnerPath: String);

emptyEnv := fn(): List<String> {
    res: List<String> = [];
    res
};

emptyBytes := fn(): List<Int> {
    res: List<Int> = [];
    res
};

/** Compiles and strictly typechecks `relSourcePath` once under an isolated temporary directory. */
pub prepareDriver := fn(rootDir: String, compilerPath: String, relSourcePath: String): TestDriver {
    tmpRes := fs.makeTempDir("lite-driver-");
    test.check("prepareDriver makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    pkgRes := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    test.check("prepareDriver package.json", pkgRes.ok);

    artifactPath := path.join(workDir, "driver.ts");
    compErr := path.join(workDir, "compile.stderr");
    comp := proc.runBytes(project.nodeExecPath(), [compilerPath, relSourcePath], rootDir, emptyEnv(), 60000, emptyBytes(), artifactPath, compErr);
    test.check("prepareDriver compiler error: " + comp.error, comp.error == "");
    test.checkInt("prepareDriver compile " + relSourcePath, 0, comp.status);
    test.checkText("prepareDriver stderr " + relSourcePath, "", fs.readText(compErr).text);

    chk := cases.checkTsArtifactFileWithStatus(rootDir, artifactPath, path.join(workDir, "tsc"), 60000);
    test.check("prepareDriver tsc " + relSourcePath + ": " + chk.error, chk.ok);

    runnerPath := path.join(workDir, "runner.ts");
    wr := cases.writeTsRunner(runnerPath);
    test.check("prepareDriver runner.ts: " + wr.error, wr.ok);

    (workDir = workDir, artifactPath = artifactPath, runnerPath = runnerPath)
};

/** Removes temporary files allocated for `driver`. */
pub disposeDriver := fn(driver: TestDriver): Unit {
    _rm := fs.remove(driver.workDir);
};

/** Runs `driver` in a fresh Node process with `stdinText`. */
pub runDriver := fn(driver: TestDriver, stdinText: String): RunOutput {
    outPath := path.join(driver.workDir, "run.stdout");
    errPath := path.join(driver.workDir, "run.stderr");
    ran := proc.runBytes(
    project.nodeExecPath(), [driver.runnerPath, driver.artifactPath], driver.workDir, emptyEnv(), 30000, unicode.utf8Encode(stdinText), outPath, errPath
    );
    test.check("runDriver process error: " + ran.error, ran.error == "");
    outRes := fs.readText(outPath);
    errRes := fs.readText(errPath);
    test.check("runDriver stdout decode: " + outRes.error, outRes.ok);
    test.check("runDriver stderr decode: " + errRes.error, errRes.ok);
    (status = ran.status, stdout = outRes.text, stderr = errRes.text)
};

/** Runs `driver` on `stdinText` and asserts exact exit status, stdout, and stderr. */
pub assertDriver := fn(driver: TestDriver, label: String, stdinText: String, expectedStatus: Int, expectedStdout: String, expectedStderr: String): Unit {
    res := runDriver(driver, stdinText);
    test.checkInt(label + " status", expectedStatus, res.status);
    test.checkText(label + " stdout", expectedStdout, res.stdout);
    test.checkText(label + " stderr", expectedStderr, res.stderr);
};

/** Compiles inline `source` using `compilerPath` via `--stdin`, with custom `cwdDir`, `--root` override, and extra flags. */
pub compileStdinWithOpts := fn(
rootDir: String,
compilerPath: String,
cwdDir: String,
source: String,
logicalName: String,
rootTargetOverride: String,
extraCompilerArgs: List<String>
): RunOutput {
    tmpRes := fs.makeTempDir("lite-comp-");
    test.check("compileStdin makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    rootTarget := if rootTargetOverride =!= "" {
        rootTargetOverride
    } else if logicalName == "" {
        path.join(rootDir, "__lite_stdin__.lts")
    } else if text.startsWithAt(logicalName, 0, "/") {
        logicalName
    } else {
        path.join(rootDir, logicalName)
    };
    args: mut List<String> = [compilerPath, "--stdin", "--name", logicalName, "--root", rootTarget];
    loop extraCompilerArgs as extra {
        list.pushBack(mut args, extra);
    }
    outPath := path.join(workDir, "out");
    errPath := path.join(workDir, "err");
    res := proc.runBytes(project.nodeExecPath(), args, cwdDir, emptyEnv(), 60000, unicode.utf8Encode(source), outPath, errPath);
    test.check("compileStdin error: " + res.error, res.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    _rm := fs.remove(workDir);
    (status = res.status, stdout = outText, stderr = errText)
};

/** Compiles inline `source` using `compilerPath` via `--stdin`, capturing exit status, stdout, and stderr. */
pub compileStdin := fn(rootDir: String, compilerPath: String, source: String, logicalName: String): RunOutput {
    compileStdinWithOpts(rootDir, compilerPath, rootDir, source, logicalName, "", emptyEnv())
};

/** Invokes `compilerPath` directly with `args` inside `cwdDir`, capturing exit status, stdout, and stderr. */
pub compileFile := fn(compilerPath: String, cwdDir: String, args: List<String>): RunOutput {
    tmpRes := fs.makeTempDir("lite-comp-file-");
    test.check("compileFile makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    cmdArgs: mut List<String> = [compilerPath];
    loop args as arg {
        list.pushBack(mut cmdArgs, arg);
    }
    outPath := path.join(workDir, "out");
    errPath := path.join(workDir, "err");
    res := proc.runBytes(project.nodeExecPath(), cmdArgs, cwdDir, emptyEnv(), 60000, emptyBytes(), outPath, errPath);
    test.check("compileFile error: " + res.error, res.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    _rm := fs.remove(workDir);
    (status = res.status, stdout = outText, stderr = errText)
};

/** Strict-typechecked TS artifact and isolated runner inside `workDir`. */
pub PreparedTs := type (workDir: String, artifactPath: String, runnerPath: String);

/** Strict-typechecks `tsCode` once in a temporary directory and prepares an isolated runner for repeated executions. */
pub prepareTs := fn(rootDir: String, tsCode: String): PreparedTs {
    tmpRes := fs.makeTempDir("lite-run-ts-");
    test.check("prepareTs makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    pkgRes := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    test.check("prepareTs package.json", pkgRes.ok);

    tsPath := path.join(workDir, "artifact.ts");
    wTs := fs.writeText(tsPath, tsCode);
    test.check("prepareTs write artifact", wTs.ok);

    chk := cases.checkTsArtifactFileWithStatus(rootDir, tsPath, path.join(workDir, "tsc"), 60000);
    test.check("prepareTs tsc: " + chk.error, chk.ok);

    runnerPath := path.join(workDir, "runner.ts");
    wr := cases.writeTsRunner(runnerPath);
    test.check("prepareTs runner.ts", wr.ok);

    (workDir = workDir, artifactPath = tsPath, runnerPath = runnerPath)
};

/** Executes a prepared TS artifact with raw `stdinBytes` and `extraArgs`. */
pub runPreparedTsWithBytes := fn(prepared: PreparedTs, stdinBytes: List<Int>, extraArgs: List<String>): RunOutput {
    runArgs: mut List<String> = [prepared.runnerPath, prepared.artifactPath];
    loop extraArgs as extra {
        list.pushBack(mut runArgs, extra);
    }
    outPath := path.join(prepared.workDir, "run.stdout");
    errPath := path.join(prepared.workDir, "run.stderr");
    ran := proc.runBytes(project.nodeExecPath(), runArgs, prepared.workDir, emptyEnv(), 30000, stdinBytes, outPath, errPath);
    test.check("runPreparedTs error: " + ran.error, ran.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    (status = ran.status, stdout = outText, stderr = errText)
};

/** Executes a prepared TS artifact with `stdinText` and `extraArgs`. */
pub runPreparedTsWithInput := fn(prepared: PreparedTs, stdinText: String, extraArgs: List<String>): RunOutput {
    runPreparedTsWithBytes(prepared, unicode.utf8Encode(stdinText), extraArgs)
};

/** Removes the temporary directory created by `prepareTs`. */
pub cleanupPreparedTs := fn(prepared: PreparedTs): Unit {
    _rm := fs.remove(prepared.workDir);
};

/** Strict-typechecks `tsCode` and runs it in a fresh Node process with raw `stdinBytes` and `extraArgs`. */
pub checkAndRunTsWithBytes := fn(
rootDir: String,
tsCode: String,
stdinBytes: List<Int>,
extraArgs: List<String>
): RunOutput {
    prepared := prepareTs(rootDir, tsCode);
    res := runPreparedTsWithBytes(prepared, stdinBytes, extraArgs);
    cleanupPreparedTs(prepared);
    res
};

/** Strict-typechecks `tsCode` and runs it in a fresh Node process with `stdinText` and `extraArgs`. */
pub checkAndRunTsWithInput := fn(rootDir: String, tsCode: String, stdinText: String, extraArgs: List<String>): RunOutput {
    checkAndRunTsWithBytes(rootDir, tsCode, unicode.utf8Encode(stdinText), extraArgs)
};

/** Strict-typechecks `tsCode` and runs it in a fresh Node process with empty stdin/args. */
pub checkAndRunTs := fn(rootDir: String, tsCode: String): RunOutput {
    checkAndRunTsWithBytes(rootDir, tsCode, emptyBytes(), emptyEnv())
};

/** Compiles inline `source` to TS, strict-typechecks it, executes it with `stdinText` and `args`, and returns `(status, stdout, stderr)`. */
pub compileCheckRunTsWithInput := fn(
rootDir: String,
compilerPath: String,
source: String,
logicalName: String,
stdinText: String,
extraArgs: List<String>
): RunOutput {
    compiled := compileStdin(rootDir, compilerPath, source, logicalName);
    test.check("compileCheckRunTs compile: " + compiled.stderr, compiled.status == 0 and compiled.stderr == "");
    checkAndRunTsWithInput(rootDir, compiled.stdout, stdinText, extraArgs)
};

/** Compiles inline `source` to TS, strict-typechecks it, executes it, and returns `(status, stdout, stderr)`. */
pub compileCheckRunTs := fn(rootDir: String, compilerPath: String, source: String, logicalName: String): RunOutput {
    compileCheckRunTsWithInput(rootDir, compilerPath, source, logicalName, "", emptyEnv())
};

/** Looks up a recorded `(status, stdout, stderr)` case in `process.json` matching `sourceText`, `logicalName` (`""` means null), empty args, and `stdinText`. */
pub lookupProcessContract := fn(
contractsJson: String,
sourceText: String,
logicalName: String,
stdinText: String
): (found: Bool, status: Int, stdout: String, stderr: String) {
    srcHash := crypto.sha256Text(sourceText);
    quotedHash := json.quoteString(srcHash);
    needleLen := text.length(quotedHash);
    stdinB64 := crypto.base64Encode(unicode.utf8Encode(stdinText));

    casesField := json.findObjectField(contractsJson, 0, "cases");
    test.check("process.json cases field", casesField.found);
    var searchPos := casesField.valuePos;
    loop true {
        hitPos := text.indexOfText(contractsJson, quotedHash, searchPos);
        if hitPos < 0 { break; }
        searchPos = hitPos + needleLen;

        var back := hitPos - 1;
        loop back >= casesField.valuePos {
            if text.at(contractsJson, back) == "{" {
                sVal := json.readObjectString(contractsJson, back, "source");
                if sVal.found {
                    if sVal.ok and sVal.value == srcHash {
                        inVal := json.readObjectString(contractsJson, back, "stdin");
                        argsField := json.findObjectField(contractsJson, back, "args");
                        isEmptyArgs := argsField.found and list.listCountInt(json.arrayElementOffsets(contractsJson, argsField.valuePos)) == 0;
                        var nameMatched := false;
                        if logicalName == "" {
                            nameField := json.findObjectField(contractsJson, back, "name");
                            nameMatched = nameField.found and text.at(contractsJson, nameField.valuePos) == "n";
                        } else {
                            nameVal := json.readObjectString(contractsJson, back, "name");
                            nameMatched = nameVal.found and nameVal.ok and nameVal.value == logicalName;
                        }
                        if inVal.found and inVal.ok and inVal.value == stdinB64 and nameMatched and isEmptyArgs {
                            stVal := json.readObjectInt(contractsJson, back, "status");
                            outVal := json.readObjectString(contractsJson, back, "stdout");
                            errVal := json.readObjectString(contractsJson, back, "stderr");
                            return (found = true, status = stVal.value, stdout = outVal.value, stderr = errVal.value);
                        }
                    }
                    break;
                }
            }
            back = back - 1;
        }
    }
    (found = false, status = -1, stdout = "", stderr = "")
};

/** Looks up a recorded `(status, stdout, stderr)` case in `process.json` matching `sourceText`, `stdinText`, null name, and empty args. */
pub findProcessContract := fn(contractsJson: String, sourceText: String, stdinText: String): (found: Bool, status: Int, stdout: String, stderr: String) {
    lookupProcessContract(contractsJson, sourceText, "", stdinText)
};

/** Strict-typechecks generated `tsCode` via `cases.checkTsArtifactFileWithStatus` without executing it. */
pub checkTsCode := fn(rootDir: String, tsCode: String): (ok: Bool, error: String) {
    tmpRes := fs.makeTempDir("lite-check-ts-");
    test.check("checkTsCode makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    pkgRes := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    test.check("checkTsCode package.json", pkgRes.ok);

    tsPath := path.join(workDir, "artifact.ts");
    wTs := fs.writeText(tsPath, tsCode);
    test.check("checkTsCode write artifact", wTs.ok);

    chk := cases.checkTsArtifactFileWithStatus(rootDir, tsPath, path.join(workDir, "tsc"), 60000);
    _rm := fs.remove(workDir);
    (ok = chk.ok, error = chk.error)
};

/** Probes for a local C11 compiler (`$CC` or `cc`), returning `(available = false)` when unavailable or skipped via `LITE_SKIP_NATIVE=1`. */
pub probeCc := fn(): (available: Bool, cc: String) {
    skipVar := proc.envGet("LITE_SKIP_NATIVE");
    if skipVar.found and skipVar.value == "1" {
        return (available = false, cc = "");
    }
    ccEnv := proc.envGet("CC");
    cc := if ccEnv.found and ccEnv.value =!= "" { ccEnv.value } else { "cc" };
    tmpRes := fs.makeTempDir("lite-cc-probe-");
    if not tmpRes.ok { return (available = false, cc = ""); }
    outP := path.join(tmpRes.path, "out");
    errP := path.join(tmpRes.path, "err");
    res := proc.runBytes(cc, ["--version"], tmpRes.path, emptyEnv(), 10000, emptyBytes(), outP, errP);
    _rm := fs.remove(tmpRes.path);
    if res.error =!= "" or res.status =!= 0 {
        return (available = false, cc = "");
    }
    (available = true, cc = cc)
};

/** Compiles C source `cCode` with `cc -std=c11 -Wall -Wextra -Werror -lm` and runs the binary with `stdinText`. */
pub compileAndRunC := fn(cCode: String, cc: String, stdinText: String): RunOutput {
    tmpRes := fs.makeTempDir("lite-run-c-");
    test.check("compileAndRunC makeTempDir: " + tmpRes.error, tmpRes.ok);
    workDir := tmpRes.path;

    cPath := path.join(workDir, "artifact.c");
    exePath := path.join(workDir, "artifact");
    wC := fs.writeText(cPath, cCode);
    test.check("compileAndRunC write artifact.c", wC.ok);

    ccOut := path.join(workDir, "cc.stdout");
    ccErr := path.join(workDir, "cc.stderr");
    ccArgs: mut List<String> = ["-std=c11", "-Wall", "-Wextra", "-Werror", cPath, "-o", exePath, "-lm"];
    if proc.platform() == "darwin" and text.containsText(cCode, "LITE_LINK_FRAMEWORKS: Cocoa CoreGraphics") {
        list.pushBack(mut ccArgs, "-framework");
        list.pushBack(mut ccArgs, "Cocoa");
        list.pushBack(mut ccArgs, "-framework");
        list.pushBack(mut ccArgs, "CoreGraphics");
    }
    ccRes := proc.runBytes(cc, ccArgs, workDir, emptyEnv(), 30000, emptyBytes(), ccOut, ccErr);
    test.check("compileAndRunC cc error: " + ccRes.error, ccRes.error == "");
    if ccRes.status =!= 0 {
        msg := fs.readText(ccErr).text;
        _rmCc := fs.remove(workDir);
        test.check("compileAndRunC cc failed: " + msg, false);
    }

    runOut := path.join(workDir, "run.stdout");
    runErr := path.join(workDir, "run.stderr");
    ran := proc.runBytes(exePath, emptyEnv(), workDir, emptyEnv(), 10000, unicode.utf8Encode(stdinText), runOut, runErr);
    test.check("compileAndRunC run error: " + ran.error, ran.error == "");
    outText := fs.readText(runOut).text;
    errText := fs.readText(runErr).text;
    _rm := fs.remove(workDir);
    (status = ran.status, stdout = outText, stderr = errText)
};

/** Compiles inline `source` with C compiler `cCompilerPath`, builds with `-std=c11 -Wall -Wextra -Werror`, and runs the binary. */
pub compileCheckRunC := fn(rootDir: String, cCompilerPath: String, cc: String, source: String, logicalName: String, stdinText: String): RunOutput {
    compiled := compileStdin(rootDir, cCompilerPath, source, logicalName);
    test.check("compileCheckRunC compile: " + compiled.stderr, compiled.status == 0 and compiled.stderr == "");
    compileAndRunC(compiled.stdout, cc, stdinText)
};

/** Compiles `source` with `compilerPath` expecting exit status 2, empty stdout, and exact stderr. */
pub assertCompileErrorNamed := fn(rootDir: String, compilerPath: String, label: String, source: String, logicalName: String, expectedErr: String): Unit {
    res := compileStdin(rootDir, compilerPath, source, logicalName);
    test.checkInt(label + " status", 2, res.status);
    test.checkText(label + " stdout", "", res.stdout);
    test.checkText(label + " stderr", expectedErr, res.stderr);
};

/** Compiles `source` with `compilerPath` expecting exit status 2, empty stdout, and exact stderr. */
pub assertCompileError := fn(rootDir: String, compilerPath: String, label: String, source: String, expectedErr: String): Unit {
    assertCompileErrorNamed(rootDir, compilerPath, label, source, "", expectedErr);
};

/** Compiles `source` with `compilerPath` expecting exit status 2, empty stdout, and `expectedSub` inside stderr. */
pub assertCompileErrorContainsNamed := fn(rootDir: String, compilerPath: String, label: String, source: String, logicalName: String, expectedSub: String): Unit {
    res := compileStdin(rootDir, compilerPath, source, logicalName);
    test.checkInt(label + " status", 2, res.status);
    test.checkText(label + " stdout", "", res.stdout);
    test.check(label + " stderr contains \"" + expectedSub + "\" (got: " + res.stderr + ")", text.containsText(res.stderr, expectedSub));
};

/** Compiles `source` with `compilerPath` expecting exit status 2, empty stdout, and `expectedSub` inside stderr. */
pub assertCompileErrorContains := fn(rootDir: String, compilerPath: String, label: String, source: String, expectedSub: String): Unit {
    assertCompileErrorContainsNamed(rootDir, compilerPath, label, source, "", expectedSub);
};

/** Compiles, strict-checks, and executes `source` on TS expecting exit 0 and `expectedOut`. */
pub assertCompileRunTsNamed := fn(rootDir: String, compilerPath: String, label: String, source: String, logicalName: String, expectedOut: String): Unit {
    res := compileCheckRunTs(rootDir, compilerPath, source, logicalName);
    test.checkInt(label + " status", 0, res.status);
    test.checkText(label + " stdout", expectedOut, res.stdout);
    test.checkText(label + " stderr", "", res.stderr);
};

/** Compiles, strict-checks, and executes `source` on TS expecting exit 0 and `expectedOut`. */
pub assertCompileRunTs := fn(rootDir: String, compilerPath: String, label: String, source: String, expectedOut: String): Unit {
    assertCompileRunTsNamed(rootDir, compilerPath, label, source, "", expectedOut);
};

/** Reads `compiler/tests/contracts/process.json` for recorded phase-driver expectations. */
pub readProcessContracts := fn(rootDir: String): String {
    readRes := fs.readText(path.join(rootDir, "compiler/tests/contracts/process.json"));
    test.check("read process.json: " + readRes.error, readRes.ok);
    readRes.text
};

/** Checks that `compiler/tests/contracts/process.json` records exact `(status, stdout, stderr)` for `driverRelPath` + `stdinText` without running `driver`. */
pub assertRecordedContract := fn(
rootDir: String,
contractsJson: String,
driverRelPath: String,
label: String,
stdinText: String,
expectedStatus: Int,
expectedStdout: String,
expectedStderr: String,
checkStreams: Bool
): (status: Int, stdout: String, stderr: String) {
    srcRes := fs.readText(path.join(rootDir, driverRelPath));
    test.check("read driver source " + driverRelPath, srcRes.ok);
    rec := findProcessContract(contractsJson, srcRes.text, stdinText);
    test.check("recorded contract found for " + label, rec.found);
    test.checkInt(label + " contract status", expectedStatus, rec.status);
    if checkStreams {
        test.checkText(label + " contract stdout", expectedStdout, rec.stdout);
        test.checkText(label + " contract stderr", expectedStderr, rec.stderr);
    }
    (status = rec.status, stdout = rec.stdout, stderr = rec.stderr)
};

/** Looks up the recorded contract in `process.json` for `sourceText`, `logicalName`, and `stdinText`, asserting `expectedStatus`. */
pub assertContractStatus := fn(
contractsJson: String,
label: String,
sourceText: String,
logicalName: String,
stdinText: String,
expectedStatus: Int
): (status: Int, stdout: String, stderr: String) {
    rec := lookupProcessContract(contractsJson, sourceText, logicalName, stdinText);
    test.check("recorded contract found for " + label, rec.found);
    test.checkInt(label + " contract status", expectedStatus, rec.status);
    (status = rec.status, stdout = rec.stdout, stderr = rec.stderr)
};

/** Checks that `actual` matches the recorded `(status, stdout, stderr)` contract in `process.json` for `sourceText` and `logicalName`. */
pub assertRunMatchesNamedContract := fn(
contractsJson: String,
label: String,
sourceText: String,
logicalName: String,
stdinText: String,
expectedStatus: Int,
actual: RunOutput
): Unit {
    rec := assertContractStatus(contractsJson, label, sourceText, logicalName, stdinText, expectedStatus);
    test.checkInt(label + " run status", rec.status, actual.status);
    test.checkText(label + " run stdout", rec.stdout, actual.stdout);
    test.checkText(label + " run stderr", rec.stderr, actual.stderr);
};

/** Checks that `actual` matches the recorded `(status, stdout, stderr)` contract in `process.json` for `sourceText`. */
pub assertRunMatchesContract := fn(
contractsJson: String,
label: String,
sourceText: String,
stdinText: String,
expectedStatus: Int,
actual: RunOutput
): Unit {
    assertRunMatchesNamedContract(contractsJson, label, sourceText, "", stdinText, expectedStatus, actual);
};

/** Looks up the recorded `(status, stdout, stderr)` contract for `driverRelPath` + `stdinText` (with empty args, null name) and asserts `driver` matches it. */
pub assertDriverMatchesContract := fn(
rootDir: String,
contractsJson: String,
driverRelPath: String,
driver: TestDriver,
label: String,
stdinText: String,
expectedStatus: Int
): Unit {
    rec := assertRecordedContract(rootDir, contractsJson, driverRelPath, label, stdinText, expectedStatus, "", "", false);
    assertDriver(driver, label, stdinText, rec.status, rec.stdout, rec.stderr);
};
