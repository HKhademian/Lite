/** Provisional GFM-subset Markdown-to-HTML renderer, TOC extractor, and doc-status detector. */

text := import "core/text";
json := import "data/json";
md := import "util/markdown";
tb := import "util/text-builder";

/** Escapes HTML special characters (`&`, `<`, `>`, `"`). */
pub escapeHtml := fn(raw: String): String {
    size := raw.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        ch := raw.at(i);
        var esc := "";
        if ch == "&" { esc = "&amp;"; }
        else if ch == "<" { esc = "&lt;"; }
        else if ch == ">" { esc = "&gt;"; }
        else if ch == "\"" { esc = "&quot;"; }
        if esc =!= "" {
            if i > runStart { tb.append(mut out, raw.slice(runStart, i)); }
            tb.append(mut out, esc);
            runStart = i + 1;
        }
        i += 1;
    }
    if runStart == 0 { return raw; }
    if runStart < size { tb.append(mut out, raw.slice(runStart, size)); }
    tb.build(out)
};

countCharAt := fn(source: String, start: Int, limit: Int, ch: String): Int {
    var count := 0;
    loop start + count < limit and source.at(start + count) == ch {
        count += 1;
    }
    count
};

findLineEnd := fn(source: String, start: Int, size: Int): Int {
    idx := source.indexOf("\n", start);
    if idx < 0 { size } else { idx }
};

splitLines := fn(source: String): List<String> {
    lines: mut List<String> = [];
    size := source.length();
    var pos := 0;
    loop pos <= size {
        lineEnd := findLineEnd(source, pos, size);
        var cleanEnd := lineEnd;
        if cleanEnd > pos and source.at(cleanEnd - 1) == "\r" {
            cleanEnd -= 1;
        }
        (mut lines).pushBack(source.slice(pos, cleanEnd));
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    lines
};

isSchemeChar := fn(ch: String): Bool {
    ch.isAsciiLetter() or ch.isDigit() or ch == "+" or ch == "." or ch == "-"
};

isLiteUri := fn(target: String): Bool {
    target.startsWithAt(0, "lite://") or target.startsWithAt(0, "lite:/")
};

isExternalHref := fn(target: String): Bool {
    if target.startsWithAt(0, "//") { return true; }
    size := target.length();
    if size < 2 or not target.at(0).isAsciiLetter() { return false; }
    var i := 1;
    loop i < size {
        ch := target.at(i);
        if ch == ":" { return true; }
        if not isSchemeChar(ch) { return false; }
        i += 1;
    }
    false
};

isEscapablePunct := fn(ch: String): Bool {
    "\\`*_{}[]()#+-.!|<>\"'~".contains(ch)
};

findClosingCodeTicks := fn(line: String, start: Int, tickCount: Int): Int {
    size := line.length();
    var pos := start;
    loop pos < size {
        if line.at(pos) == "`" {
            cnt := countCharAt(line, pos, size, "`");
            if cnt == tickCount { return pos; }
            pos += cnt;
        } else {
            pos += 1;
        }
    }
    -1
};

findMatchingBracketEnd := fn(line: String, openPos: Int): Int {
    size := line.length();
    var pos := openPos + 1;
    var depth := 1;
    loop pos < size {
        ch := line.at(pos);
        if ch == "\\" and pos + 1 < size {
            pos += 2;
        } else if ch == "`" {
            ticks := countCharAt(line, pos, size, "`");
            closeTicks := findClosingCodeTicks(line, pos + ticks, ticks);
            if closeTicks >= 0 {
                pos = closeTicks + ticks;
            } else {
                pos += ticks;
            }
        } else if ch == "[" {
            depth += 1;
            pos += 1;
        } else if ch == "]" {
            depth -= 1;
            if depth == 0 { return pos; }
            pos += 1;
        } else {
            pos += 1;
        }
    }
    -1
};

parseLinkDestination := fn(line: String, openParen: Int): (ok: Bool, href: String, title: String, closeParen: Int) {
    size := line.length();
    var pos := openParen + 1;
    loop pos < size and line.at(pos).isWhitespace() {
        pos += 1;
    }
    if pos >= size {
        return (ok = false, href = "", title = "", closeParen = -1);
    }
    var href := "";
    if line.at(pos) == "<" {
        gtPos := line.indexOf(">", pos + 1);
        if gtPos < 0 {
            return (ok = false, href = "", title = "", closeParen = -1);
        }
        href = line.slice(pos + 1, gtPos);
        pos = gtPos + 1;
    } else {
        destStart := pos;
        var parenDepth := 0;
        loop pos < size {
            ch := line.at(pos);
            if ch == ")" and parenDepth == 0 { break; }
            if ch.isWhitespace() and parenDepth == 0 { break; }
            if ch == "(" { parenDepth += 1; }
            else if ch == ")" { parenDepth -= 1; }
            pos += 1;
        }
        if pos == destStart {
            return (ok = false, href = "", title = "", closeParen = -1);
        }
        href = line.slice(destStart, pos);
    }
    loop pos < size and line.at(pos).isWhitespace() {
        pos += 1;
    }
    var title := "";
    if pos < size and (line.at(pos) == "\"" or line.at(pos) == "'") {
        q := line.at(pos);
        qEnd := line.indexOf(q, pos + 1);
        if qEnd < 0 {
            return (ok = false, href = "", title = "", closeParen = -1);
        }
        title = line.slice(pos + 1, qEnd);
        pos = qEnd + 1;
        loop pos < size and line.at(pos).isWhitespace() {
            pos += 1;
        }
    }
    if pos >= size or line.at(pos) =!= ")" {
        return (ok = false, href = "", title = "", closeParen = -1);
    }
    (ok = true, =href, =title, closeParen = pos)
};

findClosingEmph := fn(line: String, start: Int, doubleStar: Bool): Int {
    size := line.length();
    var pos := start;
    loop pos < size {
        ch := line.at(pos);
        if ch == "\\" and pos + 1 < size {
            pos += 2;
        } else if ch == "`" {
            ticks := countCharAt(line, pos, size, "`");
            closeTicks := findClosingCodeTicks(line, pos + ticks, ticks);
            if closeTicks >= 0 {
                pos = closeTicks + ticks;
            } else {
                pos += ticks;
            }
        } else if ch == "*" {
            if doubleStar {
                starRun := countCharAt(line, pos, size, "*");
                if starRun >= 2 and pos > start and not line.at(pos - 1).isWhitespace() {
                    return pos + starRun - 2;
                }
                pos += starRun;
            } else {
                if pos + 1 < size and line.at(pos + 1) == "*" {
                    pos += 2;
                } else if pos > start and not line.at(pos - 1).isWhitespace() {
                    return pos;
                } else {
                    pos += 1;
                }
            }
        } else {
            pos += 1;
        }
    }
    -1
};

/* mode 0 = full HTML, mode 1 = TOC HTML (no nested links), mode 2 = plain text */
renderInlineWithMode := fn(line: String, mode: Int): String {
    size := line.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var pos := 0;
    loop pos < size {
        ch := line.at(pos);
        if ch == "\\" and pos + 1 < size and isEscapablePunct(line.at(pos + 1)) {
            if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
            nextCh := line.at(pos + 1);
            tb.append(mut out, if mode == 2 { nextCh } else { escapeHtml(nextCh) });
            pos += 2;
            runStart = pos;
        } else if ch == "`" {
            if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
            ticks := countCharAt(line, pos, size, "`");
            closeTicks := findClosingCodeTicks(line, pos + ticks, ticks);
            if closeTicks >= 0 {
                var body := line.slice(pos + ticks, closeTicks);
                bodyLen := body.length();
                if bodyLen >= 2 and body.at(0) == " " and body.at(bodyLen - 1) == " " and body.trim() =!= "" {
                    body = body.slice(1, bodyLen - 1);
                }
                if mode == 2 {
                    tb.append(mut out, body);
                } else {
                    tb.append(mut out, "<code>" + escapeHtml(body) + "</code>");
                }
                pos = closeTicks + ticks;
            } else {
                tb.append(mut out, "`".repeat(ticks));
                pos += ticks;
            }
            runStart = pos;
        } else if ch == "!" and pos + 1 < size and line.at(pos + 1) == "[" {
            altEnd := findMatchingBracketEnd(line, pos + 1);
            if altEnd >= 0 and altEnd + 1 < size and line.at(altEnd + 1) == "(" {
                dest := parseLinkDestination(line, altEnd + 1);
                if dest.ok {
                    if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
                    altText := line.slice(pos + 2, altEnd);
                    if mode == 0 {
                        srcAttr := escapeHtml(dest.href);
                        dataAttr := if isExternalHref(dest.href) { "" } else { " data-md-src=\"" + srcAttr + "\"" };
                        titleAttr := if dest.title == "" { "" } else { " title=\"" + escapeHtml(dest.title) + "\"" };
                        tb.append(mut out, "<img src=\"" + srcAttr + "\"" + dataAttr + " alt=\"" + escapeHtml(altText) + "\"" + titleAttr + " loading=\"lazy\">");
                    } else {
                        tb.append(mut out, self(altText, mode));
                    }
                    pos = dest.closeParen + 1;
                    runStart = pos;
                } else {
                    pos += 1;
                }
            } else {
                pos += 1;
            }
        } else if ch == "[" {
            labelEnd := findMatchingBracketEnd(line, pos);
            if labelEnd >= 0 and labelEnd + 1 < size and line.at(labelEnd + 1) == "(" {
                dest := parseLinkDestination(line, labelEnd + 1);
                if dest.ok {
                    if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
                    labelRaw := line.slice(pos + 1, labelEnd);
                    if mode == 0 {
                        hrefAttr := escapeHtml(dest.href);
                        isLite := isLiteUri(dest.href);
                        isExt := isExternalHref(dest.href);
                        isHashOnly := dest.href.startsWithAt(0, "#");
                        relAttr := if not isLite and isExt and (dest.href.startsWithAt(0, "http://") or dest.href.startsWithAt(0, "https://")) {
                            " target=\"_blank\" rel=\"noopener\""
                        } else {
                            ""
                        };
                        dataAttr := if isLite {
                            " data-lite-uri=\"" + hrefAttr + "\""
                        } else if not isExt and not isHashOnly {
                            " data-md-href=\"" + hrefAttr + "\""
                        } else {
                            ""
                        };
                        titleAttr := if dest.title == "" { "" } else { " title=\"" + escapeHtml(dest.title) + "\"" };
                        tb.append(mut out, "<a href=\"" + hrefAttr + "\"" + dataAttr + relAttr + titleAttr + ">" + self(labelRaw, 0) + "</a>");
                    } else {
                        tb.append(mut out, self(labelRaw, mode));
                    }
                    pos = dest.closeParen + 1;
                    runStart = pos;
                } else {
                    pos += 1;
                }
            } else {
                pos += 1;
            }
        } else if ch == "*" {
            if pos + 1 < size and line.at(pos + 1) == "*" {
                if pos + 2 < size and not line.at(pos + 2).isWhitespace() {
                    closeStrong := findClosingEmph(line, pos + 2, true);
                    if closeStrong > pos + 2 {
                        if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
                        innerStrong := line.slice(pos + 2, closeStrong);
                        if mode == 2 {
                            tb.append(mut out, self(innerStrong, 2));
                        } else {
                            tb.append(mut out, "<strong>" + self(innerStrong, mode) + "</strong>");
                        }
                        pos = closeStrong + 2;
                        runStart = pos;
                    } else {
                        pos += 2;
                    }
                } else {
                    pos += 2;
                }
            } else if pos + 1 < size and not line.at(pos + 1).isWhitespace() {
                closeEm := findClosingEmph(line, pos + 1, false);
                if closeEm > pos + 1 {
                    if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
                    innerEm := line.slice(pos + 1, closeEm);
                    if mode == 2 {
                        tb.append(mut out, self(innerEm, 2));
                    } else {
                        tb.append(mut out, "<em>" + self(innerEm, mode) + "</em>");
                    }
                    pos = closeEm + 1;
                    runStart = pos;
                } else {
                    pos += 1;
                }
            } else {
                pos += 1;
            }
        } else if mode =!= 2 and (ch == "&" or ch == "<" or ch == ">" or ch == "\"") {
            if pos > runStart { tb.append(mut out, line.slice(runStart, pos)); }
            if ch == "&" { tb.append(mut out, "&amp;"); }
            else if ch == "<" { tb.append(mut out, "&lt;"); }
            else if ch == ">" { tb.append(mut out, "&gt;"); }
            else { tb.append(mut out, "&quot;"); }
            pos += 1;
            runStart = pos;
        } else {
            pos += 1;
        }
    }
    if runStart == 0 { return line; }
    if runStart < size { tb.append(mut out, line.slice(runStart, size)); }
    tb.build(out)
};

/** Renders inline Markdown formatting (code spans, links, images, emphasis) into HTML. */
pub renderInline := fn(line: String): String {
    renderInlineWithMode(line, 0)
};

/** Renders inline Markdown suitable for TOC labels without nested `<a>` links. */
pub renderTocInline := fn(line: String): String {
    renderInlineWithMode(line, 1)
};

/** Strips inline Markdown formatting delimiters into plain text for page titles and search entries. */
pub stripInlineMarkdown := fn(line: String): String {
    renderInlineWithMode(line, 2)
};

/** Classifies a Markdown guide's design/implementation status from its header lines. */
pub detectDocStatus := fn(docText: String): String {
    lines := splitLines(docText);
    total := lines.length();
    var i := 0;
    var headerBlock := "";
    loop i < total and i < 20 {
        headerBlock = headerBlock + "\n" + lines[i].toLowerAscii();
        i += 1;
    }
    hasMarker := headerBlock.contains("status:") or headerBlock.contains("stage:");
    if not hasMarker { return "guide"; }
    if headerBlock.contains("historical") or headerBlock.contains("superseded") or headerBlock.contains("retired") {
        return "historical";
    }
    if headerBlock.contains("working proposal") or headerBlock.contains("status: proposal") or headerBlock.contains("status: **proposal") or headerBlock.contains("draft") {
        return "proposal";
    }
    if headerBlock.contains("selected") or headerBlock.contains("established") {
        return "selected";
    }
    if headerBlock.contains("open") {
        return "open";
    }
    "guide"
};

parseHeadingLine := fn(line: String): (ok: Bool, level: Int, headingText: String) {
    size := line.length();
    var lead := 0;
    loop lead < size and lead < 3 and line.at(lead) == " " {
        lead += 1;
    }
    hashes := countCharAt(line, lead, size, "#");
    if hashes < 1 or hashes > 6 or lead + hashes >= size {
        return (ok = false, level = 0, headingText = "");
    }
    afterHash := line.at(lead + hashes);
    if afterHash =!= " " and afterHash =!= "\t" {
        return (ok = false, level = 0, headingText = "");
    }
    var bodyStart := lead + hashes + 1;
    loop bodyStart < size and line.at(bodyStart).isWhitespace() {
        bodyStart += 1;
    }
    var bodyEnd := size;
    loop bodyEnd > bodyStart and line.at(bodyEnd - 1).isWhitespace() {
        bodyEnd -= 1;
    }
    loop bodyEnd > bodyStart and line.at(bodyEnd - 1) == "#" {
        bodyEnd -= 1;
    }
    loop bodyEnd > bodyStart and line.at(bodyEnd - 1).isWhitespace() {
        bodyEnd -= 1;
    }
    if bodyEnd <= bodyStart {
        return (ok = false, level = 0, headingText = "");
    }
    (ok = true, level = hashes, headingText = line.slice(bodyStart, bodyEnd))
};

parseFenceOpen := fn(line: String): (ok: Bool, ch: String, count: Int, lang: String) {
    size := line.length();
    var lead := 0;
    loop lead < size and lead < 3 and line.at(lead) == " " {
        lead += 1;
    }
    if lead >= size { return (ok = false, ch = "", count = 0, lang = ""); }
    ch := line.at(lead);
    if ch =!= "`" and ch =!= "~" {
        return (ok = false, ch = "", count = 0, lang = "");
    }
    cnt := countCharAt(line, lead, size, ch);
    if cnt < 3 {
        return (ok = false, ch = "", count = 0, lang = "");
    }
    info := line.slice(lead + cnt, size).trim();
    if ch == "`" and info.contains("`") {
        return (ok = false, ch = "", count = 0, lang = "");
    }
    var langEnd := 0;
    infoLen := info.length();
    loop langEnd < infoLen and not info.at(langEnd).isWhitespace() {
        langEnd += 1;
    }
    lang := info.slice(0, langEnd);
    (ok = true, ch = ch, count = cnt, lang = lang)
};

isFenceClose := fn(line: String, fenceChar: String, fenceLen: Int): Bool {
    size := line.length();
    var lead := 0;
    loop lead < size and lead < 3 and line.at(lead) == " " {
        lead += 1;
    }
    cnt := countCharAt(line, lead, size, fenceChar);
    if cnt < fenceLen { return false; }
    line.slice(lead + cnt, size).trim() == ""
};

isHorizontalRule := fn(line: String): Bool {
    trimmed := line.trim();
    size := trimmed.length();
    if size < 3 { return false; }
    first := trimmed.at(0);
    if first =!= "-" and first =!= "*" and first =!= "_" { return false; }
    var count := 0;
    var i := 0;
    loop i < size {
        ch := trimmed.at(i);
        if ch == first {
            count += 1;
        } else if not ch.isWhitespace() {
            return false;
        }
        i += 1;
    }
    count >= 3
};

parseBulletItem := fn(line: String): (ok: Bool, indent: Int, body: String) {
    size := line.length();
    var indent := 0;
    loop indent < size and line.at(indent) == " " {
        indent += 1;
    }
    if indent + 1 >= size {
        return (ok = false, indent = 0, body = "");
    }
    marker := line.at(indent);
    after := line.at(indent + 1);
    if (marker == "-" or marker == "*" or marker == "+") and (after == " " or after == "\t") {
        return (ok = true, indent = indent, body = line.slice(indent + 2, size).trimStart());
    }
    (ok = false, indent = 0, body = "")
};

parseOrderedItem := fn(line: String): (ok: Bool, indent: Int, body: String) {
    size := line.length();
    var indent := 0;
    loop indent < size and line.at(indent) == " " {
        indent += 1;
    }
    var pos := indent;
    loop pos < size and line.at(pos).isDigit() {
        pos += 1;
    }
    if pos == indent or pos + 1 >= size {
        return (ok = false, indent = 0, body = "");
    }
    delim := line.at(pos);
    after := line.at(pos + 1);
    if (delim == "." or delim == ")") and (after == " " or after == "\t") {
        return (ok = true, indent = indent, body = line.slice(pos + 2, size).trimStart());
    }
    (ok = false, indent = 0, body = "")
};

parseTableRow := fn(line: String): List<String> {
    cells: mut List<String> = [];
    trimmed := line.trim();
    size := trimmed.length();
    if size == 0 or not trimmed.contains("|") { return cells; }
    var start := 0;
    var end := size;
    if trimmed.at(0) == "|" { start = 1; }
    if end > start and trimmed.at(end - 1) == "|" { end -= 1; }
    var cellStart := start;
    var i := start;
    loop i <= end {
        if i == end {
            mut cells.pushBack(trimmed.slice(cellStart, i).trim());
            break;
        }
        ch := trimmed.at(i);
        if ch == "\\" and i + 1 < end {
            i += 2;
        } else if ch == "`" {
            ticks := countCharAt(trimmed, i, end, "`");
            closePos := findClosingCodeTicks(trimmed, i + ticks, ticks);
            if closePos >= 0 and closePos < end {
                i = closePos + ticks;
            } else {
                i += ticks;
            }
        } else if ch == "|" {
            mut cells.pushBack(trimmed.slice(cellStart, i).trim());
            cellStart = i + 1;
            i += 1;
        } else {
            i += 1;
        }
    }
    cells
};

isTableSeparatorCell := fn(cell: String): Bool {
    trimmed := cell.trim();
    size := trimmed.length();
    if size == 0 { return false; }
    var i := 0;
    if trimmed.at(i) == ":" { i += 1; }
    var dashes := 0;
    loop i < size and trimmed.at(i) == "-" {
        dashes += 1;
        i += 1;
    }
    if i < size and trimmed.at(i) == ":" { i += 1; }
    dashes >= 1 and i == size
};

alignCodeStyle := fn(code: String): String {
    if code == "l" { return " style=\"text-align:left\""; }
    if code == "r" { return " style=\"text-align:right\""; }
    if code == "c" { return " style=\"text-align:center\""; }
    ""
};

parseTableAligns := fn(line: String, expectedCols: Int): (ok: Bool, packed: String) {
    cells := parseTableRow(line);
    if cells.length() =!= expectedCols or expectedCols == 0 {
        return (ok = false, packed = "");
    }
    var packed := "";
    loop cells as cell {
        if not isTableSeparatorCell(cell) {
            return (ok = false, packed = "");
        }
        trimmed := cell.trim();
        leftColon := trimmed.startsWithAt(0, ":");
        rightColon := trimmed.endsWith(":");
        code := if leftColon and rightColon {
            "c"
        } else if rightColon {
            "r"
        } else if leftColon {
            "l"
        } else {
            "-"
        };
        packed = packed + code;
    }
    (ok = true, =packed)
};

renderBodyLines := fn(lines: List<String>, collectToc: Bool): (title: String, html: String, tocJson: String) {
    total := lines.length();
    blocks: mut List<String> = [];
    seenSlugs: mut List<String> = [];
    tocEntries: mut List<String> = [];
    var docTitle := "";
    var fenceIndex := 0;
    var i := 0;

    loop i < total {
        line := lines[i];
        trimmed := line.trim();
        if trimmed == "" {
            i += 1;
        } else {
            fence := parseFenceOpen(line);
            if fence.ok {
                bodyLines: mut List<String> = [];
                i += 1;
                loop i < total {
                    if isFenceClose(lines[i], fence.ch, fence.count) {
                        i += 1;
                        break;
                    }
                    (mut bodyLines).pushBack(lines[i]);
                    i += 1;
                }
                bodyRaw := if bodyLines.length() == 0 { "" } else { bodyLines.join("\n") + "\n" };
                langAttr := escapeHtml(fence.lang);
                mut blocks.pushBack("<pre class=\"md-code\" data-lang=\"" + langAttr + "\" data-fence=\"" + fenceIndex.toText() + "\"><code>" + escapeHtml(bodyRaw) + "</code></pre>");
                fenceIndex += 1;
            } else {
                heading := parseHeadingLine(line);
                if heading.ok {
                    plainHeading := stripInlineMarkdown(heading.headingText);
                    if docTitle == "" and heading.level == 1 {
                        docTitle = plainHeading;
                    }
                    baseSlug := md.headingAnchor(heading.headingText);
                    var dupCount := 0;
                    loop seenSlugs as prevSlug {
                        if prevSlug == baseSlug { dupCount += 1; }
                    }
                    (mut seenSlugs).pushBack(baseSlug);
                    slug := if dupCount == 0 { baseSlug } else { baseSlug + "-" + dupCount.toText() };
                    lvlStr := heading.level.toText();
                    anchorLink := if heading.level == 2 or heading.level == 3 {
                        "<a class=\"md-heading-anchor\" href=\"#" + escapeHtml(slug) + "\" aria-label=\"Link to " + escapeHtml(plainHeading) + "\">#</a>"
                    } else {
                        ""
                    };
                    mut blocks.pushBack("<h" + lvlStr + " id=\"" + escapeHtml(slug) + "\">" + anchorLink + renderInline(heading.headingText) + "</h" + lvlStr + ">");
                    if collectToc and (heading.level == 2 or heading.level == 3) {
                        tocEntry := "{\"level\":" + lvlStr + ",\"id\":" + json.quoteString(slug) + ",\"text\":" + json.quoteString(plainHeading) + ",\"labelHtml\":" + json.quoteString(renderTocInline(heading.headingText)) + "}";
                        mut tocEntries.pushBack(tocEntry);
                    }
                    i += 1;
                } else if isHorizontalRule(line) {
                    mut blocks.pushBack("<hr>");
                    i += 1;
                } else if line.trimStart().startsWithAt(0, ">") {
                    quoteLines: mut List<String> = [];
                    loop i < total {
                        qlTrim := lines[i].trimStart();
                        if not qlTrim.startsWithAt(0, ">") { break; }
                        afterGt := qlTrim.slice(1, qlTrim.length());
                        cleaned := if afterGt.startsWithAt(0, " ") { afterGt.slice(1, afterGt.length()) } else { afterGt };
                        mut quoteLines.pushBack(cleaned);
                        i += 1;
                    }
                    var alertKind := "";
                    var alertLabel := "";
                    if quoteLines.length() > 0 {
                        firstQ := quoteLines[0].trim();
                        if firstQ == "[!NOTE]" { alertKind = "note"; alertLabel = "Note"; }
                        else if firstQ == "[!TIP]" { alertKind = "tip"; alertLabel = "Tip"; }
                        else if firstQ == "[!IMPORTANT]" { alertKind = "important"; alertLabel = "Important"; }
                        else if firstQ == "[!WARNING]" { alertKind = "warning"; alertLabel = "Warning"; }
                        else if firstQ == "[!CAUTION]" { alertKind = "caution"; alertLabel = "Caution"; }
                    }
                    if alertKind =!= "" {
                        innerAlertLines: mut List<String> = [];
                        var qi := 1;
                        qTotal := quoteLines.length();
                        loop qi < qTotal {
                            mut innerAlertLines.pushBack(quoteLines[qi]);
                            qi += 1;
                        }
                        innerAlert := self(innerAlertLines, false);
                        mut blocks.pushBack("<div class=\"md-alert md-alert-" + alertKind + "\"><div class=\"md-alert-title\">" + alertLabel + "</div>" + innerAlert.html + "</div>");
                    } else {
                        innerQuote := self(quoteLines, false);
                        mut blocks.pushBack("<blockquote>" + innerQuote.html + "</blockquote>");
                    }
                } else {
                    hasTable := i + 1 < total and line.contains("|");
                    var renderedTable := false;
                    if hasTable {
                        headCells := parseTableRow(line);
                        colCount := headCells.length();
                        sepRes := parseTableAligns(lines[i + 1], colCount);
                        if sepRes.ok {
                            renderedTable = true;
                            thParts: mut List<String> = [];
                            var ci := 0;
                            loop ci < colCount {
                                styleAttr := alignCodeStyle(sepRes.packed.at(ci));
                                mut thParts.pushBack("<th" + styleAttr + ">" + renderInline(headCells[ci]) + "</th>");
                                ci += 1;
                            }
                            rowParts: mut List<String> = [];
                            i += 2;
                            loop i < total {
                                rowTrim := lines[i].trim();
                                if rowTrim == "" or not rowTrim.contains("|") { break; }
                                if parseFenceOpen(lines[i]).ok or parseHeadingLine(lines[i]).ok { break; }
                                rowCells := parseTableRow(lines[i]);
                                tdParts: mut List<String> = [];
                                rowLen := rowCells.length();
                                var rci := 0;
                                loop rci < colCount {
                                    styleAttr := alignCodeStyle(sepRes.packed.at(rci));
                                    cellVal := if rci < rowLen { rowCells[rci] } else { "" };
                                    mut tdParts.pushBack("<td" + styleAttr + ">" + renderInline(cellVal) + "</td>");
                                    rci += 1;
                                }
                                (mut rowParts).pushBack("<tr>" + tdParts.join("") + "</tr>");
                                i += 1;
                            }
                            tbodyHtml := if rowParts.length() == 0 { "" } else { "<tbody>" + rowParts.join("") + "</tbody>" };
                            mut blocks.pushBack("<div class=\"md-table-wrap\"><table><thead><tr>" + thParts.join("") + "</tr></thead>" + tbodyHtml + "</table></div>");
                        }
                    }
                    if not renderedTable {
                        ulItem := parseBulletItem(line);
                        if ulItem.ok {
                            itemsHtml: mut List<String> = [];
                            loop i < total {
                                curItem := parseBulletItem(lines[i]);
                                if not curItem.ok { break; }
                                itemLines: mut List<String> = [curItem.body];
                                i += 1;
                                loop i < total {
                                    nextLine := lines[i];
                                    nextTrim := nextLine.trim();
                                    if nextTrim == "" { break; }
                                    if parseBulletItem(nextLine).ok or parseOrderedItem(nextLine).ok or parseHeadingLine(nextLine).ok or parseFenceOpen(nextLine).ok or isHorizontalRule(nextLine) or nextLine.trimStart().startsWithAt(0, ">") {
                                        break;
                                    }
                                    (mut itemLines).pushBack(nextLine.trim());
                                    i += 1;
                                }
                                (mut itemsHtml).pushBack("<li>" + renderInline(itemLines.join(" ")) + "</li>");
                                if i < total and lines[i].trim() == "" and i + 1 < total and parseBulletItem(lines[i + 1]).ok {
                                    i += 1;
                                }
                            }
                            (mut blocks).pushBack("<ul>" + itemsHtml.join("") + "</ul>");
                        } else {
                            olItem := parseOrderedItem(line);
                            if olItem.ok {
                                olItemsHtml: mut List<String> = [];
                                loop i < total {
                                    curOl := parseOrderedItem(lines[i]);
                                    if not curOl.ok { break; }
                                    olItemLines: mut List<String> = [curOl.body];
                                    i += 1;
                                    loop i < total {
                                        nextLine := lines[i];
                                        nextTrim := nextLine.trim();
                                        if nextTrim == "" { break; }
                                        if parseBulletItem(nextLine).ok or parseOrderedItem(nextLine).ok or parseHeadingLine(nextLine).ok or parseFenceOpen(nextLine).ok or isHorizontalRule(nextLine) or nextLine.trimStart().startsWithAt(0, ">") {
                                            break;
                                        }
                                        (mut olItemLines).pushBack(nextLine.trim());
                                        i += 1;
                                    }
                                    (mut olItemsHtml).pushBack("<li>" + renderInline(olItemLines.join(" ")) + "</li>");
                                    if i < total and lines[i].trim() == "" and i + 1 < total and parseOrderedItem(lines[i + 1]).ok {
                                        i += 1;
                                    }
                                }
                                (mut blocks).pushBack("<ol>" + olItemsHtml.join("") + "</ol>");
                            } else {
                                paraLines: mut List<String> = [];
                                loop i < total {
                                    pLine := lines[i];
                                    pTrim := pLine.trim();
                                    if pTrim == "" { break; }
                                    if paraLines.length() > 0 {
                                        if parseFenceOpen(pLine).ok or parseHeadingLine(pLine).ok or isHorizontalRule(pLine) or pLine.trimStart().startsWithAt(0, ">") or parseBulletItem(pLine).ok or parseOrderedItem(pLine).ok {
                                            break;
                                        }
                                        if i + 1 < total and pLine.contains("|") {
                                            pCells := parseTableRow(pLine);
                                            if parseTableAligns(lines[i + 1], pCells.length()).ok { break; }
                                        }
                                    }
                                    (mut paraLines).pushBack(pTrim);
                                    i += 1;
                                }
                                (mut blocks).pushBack("<p>" + renderInline(paraLines.join(" ")) + "</p>");
                            }
                        }
                    }
                }
            }
        }
    }

    tocJson := "[" + tocEntries.join(",") + "]";
    (title = docTitle, html = blocks.join("\n"), =tocJson)
};

/** Renders Markdown `docText` to HTML, extracting document title, status classification, and JSON TOC. */
pub renderMarkdown := fn(docText: String): (title: String, status: String, html: String, tocJson: String) {
    lines := splitLines(docText);
    rendered := renderBodyLines(lines, true);
    status := detectDocStatus(docText);
    (title = rendered.title, =status, html = rendered.html, tocJson = rendered.tocJson)
};

/** Renders `docText` and wraps the result with `docPath` as one JSON object string. */
pub renderMarkdownJson := fn(docText: String, docPath: String): String {
    rendered := renderMarkdown(docText);
    title := if rendered.title == "" { docPath } else { rendered.title };
    "{\"path\":" + json.quoteString(docPath) +
    ",\"title\":" + json.quoteString(title) +
    ",\"status\":" + json.quoteString(rendered.status) +
    ",\"toc\":" + rendered.tocJson +
    ",\"html\":" + json.quoteString(rendered.html) + "}"
};
