/** Reusable O(n log n) comparator-driven index sort and O(n) frequency map helpers. */

/** Comparator returning true when `a` should be ordered before or equal to `b`. */
pub IntComparator := alias fn(Int, Int): Bool;

/** Returns a stable O(n log n) sorted index permutation `[0..count-1]` ordered by `lessOrEq(i, j)`. */
pub sortIndicesBy := fn(count: Int, lessOrEq: IntComparator): List<Int> {
    var src: mut List<Int> = [];
    var k := 0;
    loop k < count {
        mut src.pushBack(k);
        k += 1;
    }
    if count <= 1 { return src; }
    var width := 1;
    loop width < count {
        dst: mut List<Int> = [];
        var left := 0;
        loop left < count {
            mid := if left + width < count { left + width } else { count };
            right := if left + width * 2 < count { left + width * 2 } else { count };
            var i := left;
            var j := mid;
            loop i < mid and j < right {
                if lessOrEq(src[i], src[j]) {
                    mut dst.pushBack(src[i]);
                    i += 1;
                } else {
                    mut dst.pushBack(src[j]);
                    j += 1;
                }
            }
            loop i < mid {
                mut dst.pushBack(src[i]);
                i += 1;
            }
            loop j < right {
                mut dst.pushBack(src[j]);
                j += 1;
            }
            left += width * 2;
        }
        src = dst;
        width = width * 2;
    }
    src
};

/** Counts occurrences of each string in `values` in O(n), preserving first-seen key order. */
pub countTexts := fn(values: List<String>): Map<String, Int> {
    counts: mut Map<String, Int>;
    loop values as v {
        prev := counts.getOr(v, 0);
        mut counts.set(v, prev + 1);
    }
    counts
};
