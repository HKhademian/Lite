/** Shared helpers and validators for challenge corpus and benchmark tools (`benchmark/challenges/tools/`). */

io := import "core/io";
fs := import "core/file";
path := import "core/path";
text := import "core/text";
list := import "core/list";
map := import "core/map";
set := import "core/set";
integer := import "core/int";
crypto := import "core/crypto";
unicode := import "core/unicode";
collections := import "util/collections";
json := import "util/json";

isJsonSpace := fn(ch: String): Bool {
    ch == " " or ch == "\n" or ch == "\r" or ch == "\t"
};

pub skipJsonSpace := fn(source: String, start: Int): Int {
    var pos := start;
    size := text.length(source);
    loop pos < size {
        if not isJsonSpace(text.at(source, pos)) { return pos; }
        pos = pos + 1;
    }
    pos
};

pub isJsonObjectAt := fn(source: String, start: Int): Bool {
    pos := skipJsonSpace(source, start);
    pos < text.length(source) and text.at(source, pos) == "{"
};

pub isJsonArrayAt := fn(source: String, start: Int): Bool {
    pos := skipJsonSpace(source, start);
    pos < text.length(source) and text.at(source, pos) == "["
};

pub readNormalizedText := fn(filePath: String): (ok: Bool, text: String, error: String) {
    res := fs.readText(filePath);
    if not res.ok { return (ok = false, text = "", error = res.error); }
    raw := res.text;
    parts: mut List<String> = [];
    var segStart := 0;
    var i := 0;
    size := text.length(raw);
    loop i < size {
        if text.at(raw, i) == "\r" {
            list.pushBack(mut parts, text.slice(raw, segStart, i));
            list.pushBack(mut parts, "\n");
            if i + 1 < size and text.at(raw, i + 1) == "\n" {
                i = i + 1;
            }
            segStart = i + 1;
        }
        i = i + 1;
    }
    if segStart == 0 { return (ok = true, text = raw, error = ""); }
    list.pushBack(mut parts, text.slice(raw, segStart, size));
    (ok = true, text = text.joinTexts(parts, ""), error = "")
};

pub splitJsonLines := fn(raw: String): List<String> {
    out: mut List<String> = [];
    size := text.length(raw);
    var pos := 0;
    loop pos < size {
        nl := text.indexOfText(raw, "\n", pos);
        end := if nl < 0 { size } else { nl };
        line := text.trim(text.slice(raw, pos, end));
        if line =!= "" {
            list.pushBack(mut out, line);
        }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    out
};

/** Formats unique values sorted descending by frequency as compact JSON object (`{"a":2,"b":1}`). */
pub formatSortedCountsJson := fn(values: List<String>): String {
    freq := collections.countTexts(values);
    keys: mut List<String> = [];
    counts: mut List<Int> = [];
    loop freq as entry {
        list.pushBack(mut keys, entry.key);
        list.pushBack(mut counts, entry.value);
    }
    order := collections.sortIndicesBy(list.listCountText(keys), fn(a: Int, b: Int): Bool {
        counts[a] >= counts[b]
    });
    entries: mut List<String> = [];
    loop order as idx {
        list.pushBack(mut entries, json.quoteString(keys[idx]) + ":" + integer.intText(counts[idx]));
    }
    "{" + text.joinTexts(entries, ",") + "}"
};

formatCompactIntObject := fn(source: String, objPos: Int): String {
    entries: mut List<String> = [];
    loop json.objectKeys(source, objPos) as k {
        vRes := json.readObjectInt(source, objPos, k);
        if vRes.found and vRes.ok {
            list.pushBack(mut entries, json.quoteString(k) + ":" + integer.intText(vRes.value));
        }
    }
    "{" + text.joinTexts(entries, ",") + "}"
};

checkScalarFieldNonEmpty := fn(source: String, objPos: Int, key: String): Bool {
    f := json.findObjectField(source, objPos, key);
    if not f.found { return false; }
    sRes := json.readStringAt(source, f.valuePos);
    if sRes.ok { return text.trim(sRes.value) =!= ""; }
    span := json.valueSpan(source, f.valuePos);
    if not span.ok { return false; }
    raw := text.trim(text.slice(source, span.start, span.end));
    raw =!= "" and raw =!= "null"
};

validateBenchmarkCasesArray := fn(itemId: String, caseFilePath: String, expectedCount: Int): (ok: Bool, actualCount: Int, error: String) {
    rRes := fs.readText(caseFilePath);
    if not rRes.ok { return (ok = false, actualCount = 0, error = rRes.error); }
    src := rRes.text;
    if not json.validate(src).ok or not isJsonArrayAt(src, 0) {
        return (ok = false, actualCount = 0, error = caseFilePath + ": expected JSON array");
    }
    offsets := json.arrayElementOffsets(src, skipJsonSpace(src, 0));
    actual := list.listCountInt(offsets);
    if actual =!= expectedCount {
        return (ok = false, actualCount = 0, error = itemId + ": case count mismatch");
    }
    requiredKeys: List<String> = ["name", "input", "output"];
    loop offsets as cPos {
        if not isJsonObjectAt(src, cPos) {
            return (ok = false, actualCount = 0, error = itemId + ": test case is not an object");
        }
        loop requiredKeys as rk {
            if not checkScalarFieldNonEmpty(src, cPos, rk) {
                return (ok = false, actualCount = 0, error = itemId + ": empty " + rk + " in test case");
            }
        }
    }
    (ok = true, actualCount = actual, error = "")
};

/** Validates `benchmark/challenges/benchmark/` dataset and returns formatted summary text. */
pub validateChallengeBenchmark := fn(benchDir: String): (ok: Bool, summaryText: String, error: String) {
    indexPath := path.join(benchDir, "index.json");
    idxRead := fs.readText(indexPath);
    if not idxRead.ok { return (ok = false, summaryText = "", error = idxRead.error); }
    idxJson := idxRead.text;
    if not json.validate(idxJson).ok or not isJsonObjectAt(idxJson, 0) {
        return (ok = false, summaryText = "", error = "benchmark/index.json: expected object");
    }
    totalRes := json.readObjectInt(idxJson, 0, "total");
    sourcesField := json.findObjectField(idxJson, 0, "sources");
    if not totalRes.found or not totalRes.ok or not sourcesField.found or not isJsonObjectAt(idxJson, sourcesField.valuePos) {
        return (ok = false, summaryText = "", error = "benchmark/index.json: missing total or sources");
    }

    itemsRead := fs.readText(path.join(benchDir, "items.jsonl"));
    if not itemsRead.ok { return (ok = false, summaryText = "", error = itemsRead.error); }
    itemLines := splitJsonLines(itemsRead.text);
    rowCount := list.listCountText(itemLines);

    ids: mut List<String> = [];
    idSet: mut Set<String>;
    sources: mut List<String> = [];
    loop itemLines as line {
        if not json.validate(line).ok or not isJsonObjectAt(line, 0) {
            return (ok = false, summaryText = "", error = "items.jsonl: expected object line");
        }
        idRes := json.readObjectString(line, 0, "id");
        srcRes := json.readObjectString(line, 0, "source");
        if not idRes.found or not idRes.ok or not srcRes.found or not srcRes.ok {
            return (ok = false, summaryText = "", error = "items.jsonl: missing id or source");
        }
        if set.has(idSet, idRes.value) {
            return (ok = false, summaryText = "", error = "duplicate benchmark ids");
        }
        set.add(mut idSet, idRes.value);
        list.pushBack(mut ids, idRes.value);
        list.pushBack(mut sources, srcRes.value);
    }

    if totalRes.value =!= rowCount {
        return (ok = false, summaryText = "", error = "benchmark/index.json total mismatch");
    }
    var srcSum := 0;
    loop json.objectKeys(idxJson, sourcesField.valuePos) as sk {
        sv := json.readObjectInt(idxJson, sourcesField.valuePos, sk);
        if not sv.found or not sv.ok {
            return (ok = false, summaryText = "", error = "benchmark/index.json invalid source count");
        }
        srcSum = srcSum + sv.value;
    }
    if srcSum =!= rowCount {
        return (ok = false, summaryText = "", error = "benchmark source counts mismatch");
    }

    itemsDir := path.join(benchDir, "items");
    dirNames := fs.listDir(itemsDir);
    var dirCount := 0;
    loop dirNames as dn {
        if fs.kind(path.join(itemsDir, dn)) == fs.FILE_KIND_DIR {
            dirCount = dirCount + 1;
            if not set.has(idSet, dn) {
                return (ok = false, summaryText = "", error = "item directories differ from items.jsonl");
            }
        }
    }
    if dirCount =!= rowCount {
        return (ok = false, summaryText = "", error = "item directories differ from items.jsonl");
    }

    var publicTotal := 0;
    var hiddenTotal := 0;
    formats: mut List<String> = [];
    allowedHarness: List<String> = ["single-answer", "stdio", "function"];

    var ri := 0;
    loop ri < rowCount {
        rowId := ids[ri];
        rowSrc := sources[ri];
        itemDir := path.join(itemsDir, rowId);
        metaPath := path.join(itemDir, "meta.json");
        if fs.kind(metaPath) =!= fs.FILE_KIND_FILE {
            return (ok = false, summaryText = "", error = rowId + ": missing meta.json");
        }
        metaRead := fs.readText(metaPath);
        if not metaRead.ok or not json.validate(metaRead.text).ok {
            return (ok = false, summaryText = "", error = rowId + ": invalid meta.json");
        }
        meta := metaRead.text;

        mId := json.readObjectString(meta, 0, "id");
        mSrc := json.readObjectString(meta, 0, "source");
        if not mId.found or mId.value =!= rowId or not mSrc.found or mSrc.value =!= rowSrc {
            return (ok = false, summaryText = "", error = rowId + ": metadata identity mismatch");
        }
        mHar := json.readObjectString(meta, 0, "harness");
        if not mHar.found or not list.listContainsText(allowedHarness, mHar.value) {
            return (ok = false, summaryText = "", error = rowId + ": unsupported harness " + mHar.value);
        }
        harness := mHar.value;
        list.pushBack(mut formats, harness);

        mStmt := json.readObjectString(meta, 0, "statement");
        if not mStmt.found or not mStmt.ok {
            return (ok = false, summaryText = "", error = rowId + ": statement missing or too short");
        }
        stmtPath := path.join(itemDir, mStmt.value);
        if fs.kind(stmtPath) =!= fs.FILE_KIND_FILE {
            return (ok = false, summaryText = "", error = rowId + ": statement missing or too short");
        }
        stmtRead := readNormalizedText(stmtPath);
        if not stmtRead.ok or text.length(text.trim(stmtRead.text)) < 50 {
            return (ok = false, summaryText = "", error = rowId + ": statement missing or too short");
        }

        refField := json.findObjectField(meta, 0, "reference_solutions");
        if not refField.found or not isJsonArrayAt(meta, refField.valuePos) {
            return (ok = false, summaryText = "", error = rowId + ": missing reference solution metadata");
        }
        refOffsets := json.arrayElementOffsets(meta, refField.valuePos);
        if list.listCountInt(refOffsets) == 0 {
            return (ok = false, summaryText = "", error = rowId + ": missing reference solution metadata");
        }
        loop refOffsets as rPos {
            rUrl := json.readObjectString(meta, rPos, "url");
            if not rUrl.found or not text.startsWithAt(rUrl.value, 0, "https://") {
                return (ok = false, summaryText = "", error = rowId + ": bad reference url");
            }
        }
        mUrl := json.readObjectString(meta, 0, "url");
        if not mUrl.found or not text.startsWithAt(mUrl.value, 0, "https://") {
            return (ok = false, summaryText = "", error = rowId + ": bad source url");
        }

        testsField := json.findObjectField(meta, 0, "tests");
        if not testsField.found or not isJsonObjectAt(meta, testsField.valuePos) {
            return (ok = false, summaryText = "", error = rowId + ": missing tests object");
        }
        pubPathRes := json.readObjectString(meta, testsField.valuePos, "public_path");
        if not pubPathRes.found or not pubPathRes.ok {
            return (ok = false, summaryText = "", error = rowId + ": missing public_path");
        }
        if harness == "single-answer" {
            ansPath := path.join(itemDir, pubPathRes.value);
            if fs.kind(ansPath) =!= fs.FILE_KIND_FILE {
                return (ok = false, summaryText = "", error = rowId + ": missing public answer");
            }
            ansRead := readNormalizedText(ansPath);
            if not ansRead.ok or text.trim(ansRead.text) == "" {
                return (ok = false, summaryText = "", error = rowId + ": missing public answer");
            }
            publicTotal = publicTotal + 1;
        } else {
            hidPathRes := json.readObjectString(meta, testsField.valuePos, "hidden_path");
            if not hidPathRes.found or not hidPathRes.ok {
                return (ok = false, summaryText = "", error = rowId + ": missing hidden_path");
            }
            expPub := json.readObjectInt(meta, testsField.valuePos, "public");
            expHid := json.readObjectInt(meta, testsField.valuePos, "hidden");
            pubChk := validateBenchmarkCasesArray(rowId, path.join(itemDir, pubPathRes.value), expPub.value);
            if not pubChk.ok {
                return (ok = false, summaryText = "", error = pubChk.error);
            }
            hiddenFullPath := path.join(itemDir, hidPathRes.value);
            var hidCount := 0;
            if fs.kind(hiddenFullPath) == fs.FILE_KIND_FILE {
                hidChk := validateBenchmarkCasesArray(rowId, hiddenFullPath, expHid.value);
                if not hidChk.ok {
                    return (ok = false, summaryText = "", error = hidChk.error);
                }
                hidCount = hidChk.actualCount;
            } else if expHid.value =!= 0 {
                return (ok = false, summaryText = "", error = rowId + ": case count mismatch");
            }
            publicTotal = publicTotal + pubChk.actualCount;
            hiddenTotal = hiddenTotal + hidCount;
        }
        ri = ri + 1;
    }

    summary := "OK: " + integer.intText(rowCount) + " benchmark items\n"
    + "    formats: " + formatSortedCountsJson(formats) + "\n"
    + "    public cases: " + integer.intText(publicTotal) + "  hidden cases: " + integer.intText(hiddenTotal) + "\n"
    + "    sources: " + formatCompactIntObject(idxJson, sourcesField.valuePos);
    (ok = true, summaryText = summary, error = "")
};

/** CLI runner for `benchmark/challenges/tools/validate_benchmark.ts`. */
pub runValidateBenchmarkCommand := fn(rootDir: String): Int {
    benchDir := path.join(rootDir, "benchmark/challenges/benchmark");
    res := validateChallengeBenchmark(benchDir);
    if not res.ok {
        io.errorLine("FAIL: " + res.error);
        return 1;
    }
    io.outputLine(res.summaryText);
    0
};

pub compareTextLex := fn(a: String, b: String): Int {
    if a == b { return 0; }
    la := text.length(a);
    lb := text.length(b);
    n := if la < lb { la } else { lb };
    var i := 0;
    loop i < n {
        ca := text.at(a, i);
        cb := text.at(b, i);
        if ca =!= cb {
            pa := unicode.toCodePoints(ca)[0];
            pb := unicode.toCodePoints(cb)[0];
            return if pa < pb { -1 } else { 1 };
        }
        i = i + 1;
    }
    if la < lb { -1 } else if la > lb { 1 } else { 0 }
};

/** Sorts a `List<String>` lexicographically in O(N log N) via bottom-up merge sort. */
pub sortTexts := fn(items: List<String>): List<String> {
    n := list.listCountText(items);
    if n <= 1 { return items; }
    var cur: mut List<String> = [];
    loop items as it {
        list.pushBack(mut cur, it);
    }
    var width := 1;
    loop width < n {
        next: mut List<String> = [];
        var start := 0;
        loop start < n {
            mid := if start + width < n { start + width } else { n };
            rightEnd := if start + width * 2 < n { start + width * 2 } else { n };
            var li := start;
            var ri := mid;
            loop li < mid or ri < rightEnd {
                if li >= mid {
                    list.pushBack(mut next, cur[ri]);
                    ri = ri + 1;
                } else if ri >= rightEnd {
                    list.pushBack(mut next, cur[li]);
                    li = li + 1;
                } else if compareTextLex(cur[li], cur[ri]) <= 0 {
                    list.pushBack(mut next, cur[li]);
                    li = li + 1;
                } else {
                    list.pushBack(mut next, cur[ri]);
                    ri = ri + 1;
                }
            }
            start = start + width * 2;
        }
        cur = next;
        width = width * 2;
    }
    cur
};

/** Returns true if `target` appears in pre-sorted `sortedItems` using binary search. */
pub sortedContainsText := fn(sortedItems: List<String>, target: String): Bool {
    var lo := 0;
    var hi := list.listCountText(sortedItems) - 1;
    loop lo <= hi {
        mid := lo + (hi - lo) / 2;
        cmp := compareTextLex(sortedItems[mid], target);
        if cmp == 0 { return true; }
        if cmp < 0 {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    false
};

formatFrequencyLines := fn(values: List<String>, indent: String, nameWidth: Int): String {
    sortedVals := sortTexts(values);
    n := list.listCountText(sortedVals);
    keys: mut List<String> = [];
    counts: mut List<Int> = [];
    var i := 0;
    loop i < n {
        curKey := sortedVals[i];
        var cnt := 1;
        loop i + cnt < n {
            if sortedVals[i + cnt] =!= curKey { break; }
            cnt = cnt + 1;
        }
        list.pushBack(mut keys, curKey);
        list.pushBack(mut counts, cnt);
        i = i + cnt;
    }

    order := collections.sortIndicesBy(list.listCountText(keys), fn(a: Int, b: Int): Bool {
        counts[a] >= counts[b]
    });
    lines: mut List<String> = [];
    loop order as idx {
        kPad := padRight(keys[idx], nameWidth);
        cPad := padLeft(integer.intText(counts[idx]), 5);
        list.pushBack(mut lines, indent + kPad + " " + cPad);
    }
    text.joinTexts(lines, "\n")
};

pub padRight := fn(s: String, width: Int): String {
    len := text.length(s);
    if len >= width { return s; }
    s + text.repeatText(" ", width - len)
};

pub padLeft := fn(s: String, width: Int): String {
    len := text.length(s);
    if len >= width { return s; }
    text.repeatText(" ", width - len) + s
};

pub isLowerSlugText := fn(s: String): Bool {
    size := text.length(s);
    if size == 0 { return false; }
    first := text.at(s, 0);
    if text.indexOfText("abcdefghijklmnopqrstuvwxyz0123456789", first, 0) < 0 { return false; }
    var i := 1;
    loop i < size {
        ch := text.at(s, i);
        if text.indexOfText("abcdefghijklmnopqrstuvwxyz0123456789-", ch, 0) < 0 { return false; }
        i = i + 1;
    }
    true
};

/** Parses decimal text or number field in JSON object into fixed-point thousandths (`1.5 -> 1500`). */
pub parseScaledDecimal1000 := fn(source: String, objPos: Int, key: String): (ok: Bool, scaled: Int, isIntLiteral: Bool, raw: String) {
    f := json.findObjectField(source, objPos, key);
    if not f.found { return (ok = false, scaled = 0, isIntLiteral = false, raw = ""); }
    span := json.valueSpan(source, f.valuePos);
    if not span.ok { return (ok = false, scaled = 0, isIntLiteral = false, raw = ""); }
    raw := text.trim(text.slice(source, span.start, span.end));
    res := parseScaledNumberText(raw);
    (ok = res.ok, scaled = res.scaled, isIntLiteral = res.isIntLiteral, raw = raw)
};

/** Parses decimal text (e.g. `4`, `1.5`, `-2.5`) into thousandths (`Int`). */
pub parseScaledNumberText := fn(raw: String): (ok: Bool, scaled: Int, isIntLiteral: Bool) {
    size := text.length(raw);
    if size == 0 { return (ok = false, scaled = 0, isIntLiteral = false); }
    var neg := false;
    var start := 0;
    if text.at(raw, 0) == "-" {
        neg = true;
        start = 1;
        if size == 1 { return (ok = false, scaled = 0, isIntLiteral = false); }
    }
    var dot := -1;
    var i := start;
    loop i < size {
        ch := text.at(raw, i);
        if ch == "." {
            if dot >= 0 { return (ok = false, scaled = 0, isIntLiteral = false); }
            dot = i;
        } else if not text.isDigit(ch) {
            return (ok = false, scaled = 0, isIntLiteral = false);
        }
        i = i + 1;
    }
    wholeStr := if dot < 0 { text.slice(raw, start, size) } else { text.slice(raw, start, dot) };
    if wholeStr == "" { return (ok = false, scaled = 0, isIntLiteral = false); }
    wholeParsed := text.textToInt(wholeStr);
    if not wholeParsed.ok { return (ok = false, scaled = 0, isIntLiteral = false); }
    var frac := 0;
    var isInt := dot < 0;
    if dot >= 0 {
        fracStr := text.slice(raw, dot + 1, size);
        if fracStr == "" { return (ok = false, scaled = 0, isIntLiteral = false); }
        var place := 100;
        var fi := 0;
        var allZero := true;
        loop fi < text.length(fracStr) {
            d := text.textToInt(text.at(fracStr, fi));
            if not d.ok { return (ok = false, scaled = 0, isIntLiteral = false); }
            if d.value =!= 0 { allZero = false; }
            if place >= 1 {
                frac = frac + d.value * place;
                place = place / 10;
            }
            fi = fi + 1;
        }
        isInt = allZero;
    }
    mag := wholeParsed.value * 1000 + frac;
    (ok = true, scaled = if neg { 0 - mag } else { mag }, isIntLiteral = isInt)
};

checkStrictStringArrayField := fn(source: String, objPos: Int, key: String): (ok: Bool, itemsEmpty: Bool) {
    f := json.findObjectField(source, objPos, key);
    if not f.found or not isJsonArrayAt(source, f.valuePos) {
        return (ok = false, itemsEmpty = true);
    }
    offsets := json.arrayElementOffsets(source, f.valuePos);
    loop offsets as elPos {
        s := json.readStringAt(source, elPos);
        if not s.ok { return (ok = false, itemsEmpty = true); }
    }
    (ok = true, itemsEmpty = list.listCountInt(offsets) == 0)
};

pub readStringArray := fn(source: String, objPos: Int, key: String): List<String> {
    out: mut List<String> = [];
    f := json.findObjectField(source, objPos, key);
    if not f.found or not isJsonArrayAt(source, f.valuePos) { return out; }
    loop json.arrayElementOffsets(source, f.valuePos) as elPos {
        s := json.readStringAt(source, elPos);
        if s.ok { list.pushBack(mut out, s.value); }
    }
    out
};

isNullField := fn(source: String, objPos: Int, key: String): Bool {
    f := json.findObjectField(source, objPos, key);
    if not f.found { return false; }
    span := json.valueSpan(source, f.valuePos);
    if not span.ok { return false; }
    text.trim(text.slice(source, span.start, span.end)) == "null"
};

/** Validates `benchmark/challenges/data/` and `schema/taxonomy.json` (`benchmark/challenges/tools/validate.ts`). */
pub validateChallengeCorpus := fn(benchRootDir: String): (ok: Bool, summaryText: String, error: String) {
    dataDir := path.join(benchRootDir, "data");
    chRead := fs.readText(path.join(dataDir, "challenges.jsonl"));
    if not chRead.ok { return (ok = false, summaryText = "", error = chRead.error); }
    liRead := fs.readText(path.join(dataDir, "lists.jsonl"));
    if not liRead.ok { return (ok = false, summaryText = "", error = liRead.error); }
    idxRead := fs.readText(path.join(dataDir, "index.json"));
    if not idxRead.ok { return (ok = false, summaryText = "", error = idxRead.error); }
    taxRead := fs.readText(path.join(benchRootDir, "schema/taxonomy.json"));
    if not taxRead.ok { return (ok = false, summaryText = "", error = taxRead.error); }

    if not json.validate(idxRead.text).ok or not isJsonObjectAt(idxRead.text, 0) {
        return (ok = false, summaryText = "", error = "data/index.json: expected object");
    }
    if not json.validate(taxRead.text).ok or not isJsonObjectAt(taxRead.text, 0) {
        return (ok = false, summaryText = "", error = "schema/taxonomy.json: expected object");
    }

    taxTopicsField := json.findObjectField(taxRead.text, 0, "topics");
    if not taxTopicsField.found or not isJsonArrayAt(taxRead.text, taxTopicsField.valuePos) {
        return (ok = false, summaryText = "", error = "schema/taxonomy.json: missing topics array");
    }
    rawTopicIds: mut List<String> = [];
    loop json.arrayElementOffsets(taxRead.text, taxTopicsField.valuePos) as tPos {
        tid := json.readObjectString(taxRead.text, tPos, "id");
        if tid.found and tid.ok { list.pushBack(mut rawTopicIds, tid.value); }
    }
    sortedTopics := sortTexts(rawTopicIds);

    allowedSources: List<String> = ["advent-of-code", "project-euler", "leetcode", "codeforces", "cses", "atcoder", "rosalind", "cryptopals", "jane-street"];
    allowedCats: List<String> = ["algorithms", "data-structures", "mathematics", "databases", "shell", "concurrency", "javascript", "data-analysis", "security", "bioinformatics", "puzzles", "frontend", "system-design"];
    allowedTopicSrc: List<String> = ["source", "section", "curated", "none"];
    allowedStatus: List<String> = ["verified", "partial"];
    requiredKeys: List<String> = ["id", "title", "source", "url", "native_id", "category", "topics", "raw_topics", "tags", "difficulty", "formats", "languages", "topics_source", "premium", "status"];
    strArrKeys: List<String> = ["formats", "languages", "raw_topics", "tags"];

    lines := splitJsonLines(chRead.text);
    recCount := list.listCountText(lines);
    rawIds: mut List<String> = [];
    usedTopics: mut List<String> = [];
    var lineNo := 0;

    loop lines as line {
        lineNo = lineNo + 1;
        if not json.validate(line).ok or not isJsonObjectAt(line, 0) {
            return (ok = false, summaryText = "", error = "challenges.jsonl:" + integer.intText(lineNo) + ": invalid JSON");
        }
        idRes := json.readObjectString(line, 0, "id");
        idLabel := if idRes.found and idRes.ok { idRes.value } else { "<missing id>" };

        loop requiredKeys as rk {
            rf := json.findObjectField(line, 0, rk);
            if not rf.found {
                return (ok = false, summaryText = "", error = idLabel + ": missing field " + rk);
            }
        }
        if not idRes.found or not idRes.ok or not isLowerSlugText(idRes.value) {
            return (ok = false, summaryText = "", error = idLabel + ": bad id");
        }
        cid := idRes.value;
        list.pushBack(mut rawIds, cid);

        titleRes := json.readObjectString(line, 0, "title");
        if not titleRes.found or not titleRes.ok or text.trim(titleRes.value) == "" {
            return (ok = false, summaryText = "", error = cid + ": empty title");
        }
        srcRes := json.readObjectString(line, 0, "source");
        if not srcRes.found or not list.listContainsText(allowedSources, srcRes.value) {
            return (ok = false, summaryText = "", error = cid + ": unknown source " + srcRes.value);
        }
        urlRes := json.readObjectString(line, 0, "url");
        if not urlRes.found or not text.startsWithAt(urlRes.value, 0, "https://") {
            return (ok = false, summaryText = "", error = cid + ": bad url " + urlRes.value);
        }
        catRes := json.readObjectString(line, 0, "category");
        if not catRes.found or not list.listContainsText(allowedCats, catRes.value) {
            return (ok = false, summaryText = "", error = cid + ": unknown category " + catRes.value);
        }
        tsRes := json.readObjectString(line, 0, "topics_source");
        if not tsRes.found or not list.listContainsText(allowedTopicSrc, tsRes.value) {
            return (ok = false, summaryText = "", error = cid + ": invalid topics_source");
        }
        stRes := json.readObjectString(line, 0, "status");
        if not stRes.found or not list.listContainsText(allowedStatus, stRes.value) {
            return (ok = false, summaryText = "", error = cid + ": invalid status");
        }
        premRes := json.readObjectBool(line, 0, "premium");
        if not premRes.found or not premRes.ok {
            return (ok = false, summaryText = "", error = cid + ": premium must be bool");
        }
        loop strArrKeys as sak {
            saChk := checkStrictStringArrayField(line, 0, sak);
            if not saChk.ok {
                return (ok = false, summaryText = "", error = cid + ": " + sak + " must be a string array");
            }
        }
        topChk := checkStrictStringArrayField(line, 0, "topics");
        if not topChk.ok {
            return (ok = false, summaryText = "", error = cid + ": topics must be an array of strings");
        }
        rTopics := readStringArray(line, 0, "topics");
        loop rTopics as tp {
            if not isLowerSlugText(tp) {
                return (ok = false, summaryText = "", error = cid + ": bad topic " + tp);
            }
            if not sortedContainsText(sortedTopics, tp) {
                return (ok = false, summaryText = "", error = cid + ": topic " + tp + " not in schema/taxonomy.json");
            }
            list.pushBack(mut usedTopics, tp);
        }

        diffField := json.findObjectField(line, 0, "difficulty");
        if not diffField.found or not isJsonObjectAt(line, diffField.valuePos) {
            return (ok = false, summaryText = "", error = cid + ": difficulty must be an object");
        }
        rawField := json.findObjectField(line, diffField.valuePos, "raw");
        if isNullField(line, diffField.valuePos, "scale") or not json.findObjectField(line, diffField.valuePos, "scale").found or not rawField.found {
            return (ok = false, summaryText = "", error = cid + ": difficulty needs scale and raw");
        }
        normRes := parseScaledDecimal1000(line, diffField.valuePos, "normalized");
        if not normRes.ok or normRes.scaled < 1000 or normRes.scaled > 10000 {
            return (ok = false, summaryText = "", error = cid + ": normalized difficulty out of range");
        }
        if list.listCountText(rTopics) == 0 {
            if not isNullField(line, 0, "primary_topic") {
                return (ok = false, summaryText = "", error = cid + ": primary_topic must be topics[0] or null for empty topics");
            }
        } else {
            ptRes := json.readObjectString(line, 0, "primary_topic");
            if not ptRes.found or not ptRes.ok or ptRes.value =!= rTopics[0] {
                return (ok = false, summaryText = "", error = cid + ": primary_topic must be topics[0] or null for empty topics");
            }
        }
    }

    sortedIds := sortTexts(rawIds);
    var di := 1;
    loop di < recCount {
        if sortedIds[di] == sortedIds[di - 1] {
            return (ok = false, summaryText = "", error = "duplicate ids");
        }
        di = di + 1;
    }

    listLines := splitJsonLines(liRead.text);
    loop listLines as lLine {
        if not json.validate(lLine).ok or not isJsonObjectAt(lLine, 0) {
            return (ok = false, summaryText = "", error = "lists.jsonl: expected object");
        }
        lId := json.readObjectString(lLine, 0, "id").value;
        lCnt := json.readObjectInt(lLine, 0, "count").value;
        cIds := readStringArray(lLine, 0, "challenge_ids");
        if lCnt =!= list.listCountText(cIds) {
            return (ok = false, summaryText = "", error = "list " + lId + ": count does not match challenge_ids");
        }
        loop cIds as cid {
            if not sortedContainsText(sortedIds, cid) {
                return (ok = false, summaryText = "", error = "list " + lId + ": unknown challenge " + cid);
            }
        }
        gField := json.findObjectField(lLine, 0, "groups");
        if gField.found and isJsonArrayAt(lLine, gField.valuePos) {
            loop json.arrayElementOffsets(lLine, gField.valuePos) as gPos {
                loop readStringArray(lLine, gPos, "challenge_ids") as gcid {
                    if not sortedContainsText(sortedIds, gcid) {
                        return (ok = false, summaryText = "", error = "list " + lId + ": unknown challenge " + gcid);
                    }
                }
            }
        }
    }

    testsPath := path.join(dataDir, "tests.jsonl");
    var hasTests := false;
    var testsCount := 0;
    var withPub := 0;
    var withHid := 0;
    if fs.kind(testsPath) == fs.FILE_KIND_FILE {
        hasTests = true;
        tRead := fs.readText(testsPath);
        if not tRead.ok { return (ok = false, summaryText = "", error = tRead.error); }
        tLines := splitJsonLines(tRead.text);
        testsCount = list.listCountText(tLines);
        rawTestIds: mut List<String> = [];
        var tLineNo := 0;
        loop tLines as tLine {
            tLineNo = tLineNo + 1;
            if not json.validate(tLine).ok or not isJsonObjectAt(tLine, 0) {
                return (ok = false, summaryText = "", error = "tests.jsonl:" + integer.intText(tLineNo) + ": invalid JSON");
            }
            tcId := json.readObjectString(tLine, 0, "challenge_id").value;
            list.pushBack(mut rawTestIds, tcId);
            pubF := json.findObjectField(tLine, 0, "public");
            hidF := json.findObjectField(tLine, 0, "hidden");
            emptyInts: List<Int> = [];
            pubOff := if pubF.found and isJsonArrayAt(tLine, pubF.valuePos) { json.arrayElementOffsets(tLine, pubF.valuePos) } else { emptyInts };
            hidOff := if hidF.found and isJsonArrayAt(tLine, hidF.valuePos) { json.arrayElementOffsets(tLine, hidF.valuePos) } else { emptyInts };
            pubN := list.listCountInt(pubOff);
            hidN := list.listCountInt(hidOff);
            if pubN > 0 { withPub = withPub + 1; }
            if hidN > 0 { withHid = withHid + 1; }

            loop pubOff as cp {
                if not checkScalarFieldNonEmpty(tLine, cp, "input") or not checkScalarFieldNonEmpty(tLine, cp, "output") or not checkScalarFieldNonEmpty(tLine, cp, "name") {
                    return (ok = false, summaryText = "", error = tcId + ": empty or unnamed test case");
                }
            }
            loop hidOff as hp {
                if not checkScalarFieldNonEmpty(tLine, hp, "input") or not checkScalarFieldNonEmpty(tLine, hp, "output") or not checkScalarFieldNonEmpty(tLine, hp, "name") {
                    return (ok = false, summaryText = "", error = tcId + ": empty or unnamed test case");
                }
            }
            st := json.readObjectString(tLine, 0, "status").value;
            if st == "public+hidden" and (pubN == 0 or hidN == 0) {
                return (ok = false, summaryText = "", error = tcId + ": status says public+hidden but cases are missing");
            }
            if st == "public-only" and (pubN == 0 or hidN > 0) {
                return (ok = false, summaryText = "", error = tcId + ": status says public-only but cases are wrong");
            }
            if (st == "none" or st == "not-applicable") and (pubN > 0 or hidN > 0) {
                return (ok = false, summaryText = "", error = tcId + ": status " + st + " but cases exist");
            }
            if hidN > 0 {
                pol := json.readObjectString(tLine, 0, "hidden_policy").value;
                if pol =!= "held-out-official-samples" {
                    return (ok = false, summaryText = "", error = tcId + ": hidden cases without held-out policy");
                }
            }
        }
        sortedTestIds := sortTexts(rawTestIds);
        if testsCount =!= recCount {
            return (ok = false, summaryText = "", error = "test records do not match challenges");
        }
        var ti := 0;
        loop ti < testsCount {
            if ti > 0 and sortedTestIds[ti] == sortedTestIds[ti - 1] {
                return (ok = false, summaryText = "", error = "duplicate test records");
            }
            if sortedTestIds[ti] =!= sortedIds[ti] {
                return (ok = false, summaryText = "", error = "test records do not match challenges");
            }
            ti = ti + 1;
        }
    }

    idxTotal := json.readObjectInt(idxRead.text, 0, "total").value;
    if idxTotal =!= recCount {
        return (ok = false, summaryText = "", error = "index.total does not match challenges.jsonl");
    }
    srcArrField := json.findObjectField(idxRead.text, 0, "sources");
    var idxSum := 0;
    loop json.arrayElementOffsets(idxRead.text, srcArrField.valuePos) as sPos {
        idxSum = idxSum + json.readObjectInt(idxRead.text, sPos, "count").value;
    }
    if idxSum =!= recCount {
        return (ok = false, summaryText = "", error = "index source counts do not sum to total");
    }

    sortedUsed := sortTexts(usedTopics);
    var usedUnique := 0;
    var ui := 0;
    loop ui < list.listCountText(sortedUsed) {
        if ui == 0 or sortedUsed[ui] =!= sortedUsed[ui - 1] {
            usedUnique = usedUnique + 1;
        }
        ui = ui + 1;
    }

    var summary := "OK: " + integer.intText(recCount) + " challenges, "
    + integer.intText(list.listCountText(listLines)) + " lists, "
    + integer.intText(list.listCountText(sortedTopics)) + " topics, "
    + integer.intText(usedUnique) + " used";
    if hasTests {
        summary = summary + "\n    tests: " + integer.intText(withPub) + " with public cases, " + integer.intText(withHid) + " with held-out cases";
    }
    (ok = true, summaryText = summary, error = "")
};

/** CLI runner for `benchmark/challenges/tools/validate.ts`. */
pub runValidateCorpusCommand := fn(rootDir: String): Int {
    res := validateChallengeCorpus(path.join(rootDir, "benchmark/challenges"));
    if not res.ok {
        io.errorLine("FAIL: " + res.error);
        return 1;
    }
    io.outputLine(res.summaryText);
    0
};

/** Maps scaled thousandths difficulty (`1000..10000`) to named difficulty band. */
pub difficultyBand := fn(scaled1000: Int): String {
    if scaled1000 <= 2000 { return "beginner"; }
    if scaled1000 <= 4000 { return "easy"; }
    if scaled1000 <= 6000 { return "intermediate"; }
    if scaled1000 <= 8000 { return "advanced"; }
    "expert"
};

/** Formats CSV difficulty string matching `common.ts:normalizedText`. */
pub formatDifficultyCsv := fn(source: String, scaled1000: Int, rawText: String, isIntLiteral: Bool): String {
    if source =!= "cryptopals" and isIntLiteral {
        whole := scaled1000 / 1000;
        return integer.intText(whole) + ".0";
    }
    rawText
};

pub asciiLower := fn(s: String): String {
    out: mut List<String> = [];
    upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    lower := "abcdefghijklmnopqrstuvwxyz";
    sLen := text.length(s);
    var i := 0;
    loop i < sLen {
        ch := text.at(s, i);
        pos := text.indexOfText(upper, ch, 0);
        list.pushBack(mut out, if pos >= 0 { text.at(lower, pos) } else { ch });
        i = i + 1;
    }
    text.joinTexts(out, "")
};

splitTrimmedCsv := fn(raw: String): List<String> {
    out: mut List<String> = [];
    size := text.length(raw);
    var start := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        if atEnd or text.at(raw, i) == "," {
            part := text.trim(text.slice(raw, start, i));
            if part =!= "" { list.pushBack(mut out, part); }
            start = i + 1;
        }
        i = i + 1;
    }
    out
};

queryOptionKind := fn(name: String): String {
    flags: List<String> = ["--desc", "--all", "--json", "--csv", "--stats", "--help", "-h"];
    values: List<String> = ["--source", "--category", "--difficulty", "--topics-source", "--status", "--premium", "--list", "--search", "--sort", "--limit", "--group-by"];
    if list.listContainsText(flags, name) { return "flag"; }
    if list.listContainsText(values, name) { return "value"; }
    if name == "--topic" { return "repeat"; }
    ""
};

/** Validates query tool CLI arguments matching `common.ts:options` error semantics. */
pub checkQueryOptions := fn(args: List<String>): (ok: Bool, error: String) {
    count := list.listCountText(args);
    var i := 0;
    loop i < count {
        arg := args[i];
        eq := text.indexOfText(arg, "=", 0);
        name := if eq < 0 { arg } else { text.slice(arg, 0, eq) };
        kind := queryOptionKind(name);
        if kind == "" {
            return (ok = false, error = "unknown option " + name);
        }
        if kind == "flag" {
            if eq >= 0 { return (ok = false, error = name + " does not accept a value"); }
        } else {
            val := if eq >= 0 { text.slice(arg, eq + 1, text.length(arg)) } else { if i + 1 < count { args[i + 1] } else { "__MISSING__" } };
            if val == "__MISSING__" or text.startsWithAt(val, 0, "--") {
                return (ok = false, error = "missing value for " + name);
            }
            if eq < 0 { i = i + 1; }
        }
        i = i + 1;
    }
    (ok = true, error = "")
};

hasQueryFlag := fn(args: List<String>, target: String): Bool {
    count := list.listCountText(args);
    var i := 0;
    loop i < count {
        arg := args[i];
        eq := text.indexOfText(arg, "=", 0);
        name := if eq < 0 { arg } else { text.slice(arg, 0, eq) };
        if name == target { return true; }
        if eq < 0 and queryOptionKind(name) =!= "flag" { i = i + 1; }
        i = i + 1;
    }
    false
};

readQueryValue := fn(args: List<String>, target: String): (found: Bool, value: String) {
    var found := false;
    var out := "";
    count := list.listCountText(args);
    var i := 0;
    loop i < count {
        arg := args[i];
        eq := text.indexOfText(arg, "=", 0);
        name := if eq < 0 { arg } else { text.slice(arg, 0, eq) };
        if eq >= 0 {
            if name == target {
                found = true;
                out = text.slice(arg, eq + 1, text.length(arg));
            }
        } else if queryOptionKind(name) =!= "flag" {
            if i + 1 < count {
                if name == target {
                    found = true;
                    out = args[i + 1];
                }
                i = i + 1;
            }
        }
        i = i + 1;
    }
    (found = found, value = out)
};

readQueryRepeatTopics := fn(args: List<String>): List<String> {
    out: mut List<String> = [];
    count := list.listCountText(args);
    var i := 0;
    loop i < count {
        arg := args[i];
        eq := text.indexOfText(arg, "=", 0);
        name := if eq < 0 { arg } else { text.slice(arg, 0, eq) };
        if name == "--topic" {
            raw := if eq >= 0 { text.slice(arg, eq + 1, text.length(arg)) } else { args[i + 1] };
            loop splitTrimmedCsv(raw) as tp {
                list.pushBack(mut out, tp);
            }
        }
        if eq < 0 and queryOptionKind(name) =!= "flag" { i = i + 1; }
        i = i + 1;
    }
    out
};

pub csvEscapeField := fn(val: String): String {
    needsQuote := text.indexOfText(val, "\"", 0) >= 0 or text.indexOfText(val, ",", 0) >= 0 or text.indexOfText(val, "\r", 0) >= 0 or text.indexOfText(val, "\n", 0) >= 0;
    if not needsQuote { return val; }
    parts: mut List<String> = ["\""];
    valLen := text.length(val);
    var i := 0;
    loop i < valLen {
        ch := text.at(val, i);
        if ch == "\"" { list.pushBack(mut parts, "\"\""); } else { list.pushBack(mut parts, ch); }
        i = i + 1;
    }
    list.pushBack(mut parts, "\"");
    text.joinTexts(parts, "")
};

formatDiffTable := fn(scaled1000: Int): String {
    safe := if scaled1000 < 0 { 0 } else { scaled1000 };
    tenths := (safe + 50) / 100;
    whole := tenths / 10;
    rem := tenths % 10;
    integer.intText(whole) + "." + integer.intText(rem)
};

queryCompareRecords := fn(
sortMode: String, desc: Bool,
sA: String, idA: String, titleA: String, diffA: Int, numA: Int, popA: Int,
sB: String, idB: String, titleB: String, diffB: Int, numB: Int, popB: Int
): Int {
    var cmp := 0;
    if sortMode == "difficulty" {
        cmp = if diffA < diffB { -1 } else if diffA > diffB { 1 } else { 0 };
    } else if sortMode == "title" {
        cmp = compareTextLex(asciiLower(titleA), asciiLower(titleB));
    } else if sortMode == "popularity" {
        cmp = if popA < popB { -1 } else if popA > popB { 1 } else { 0 };
    } else if sortMode == "id" {
        cmp = compareTextLex(idA, idB);
    } else {
        cmp = compareTextLex(sA, sB);
        if cmp == 0 {
            cmp = if numA < numB { -1 } else if numA > numB { 1 } else { 0 };
        }
        if cmp == 0 {
            cmp = compareTextLex(idA, idB);
        }
    }
    if desc { 0 - cmp } else { cmp }
};

/** Executes `benchmark/challenges/tools/query.ts` over `benchmark/challenges/data/`. */
pub runQueryCommand := fn(rootDir: String, args: List<String>): Int {
    optChk := checkQueryOptions(args);
    if not optChk.ok {
        io.errorLine(optChk.error);
        return 2;
    }
    if hasQueryFlag(args, "--help") or hasQueryFlag(args, "-h") {
        io.outputLine("Usage: node tools/query.ts [--source ids] [--category ids] [--topic ids] [--difficulty 1-10|4-7] [--list ids] [--search text] [--sort source|id|title|difficulty|popularity] [--desc] [--limit N|--all] [--json|--csv] [--group-by source|category|topic|difficulty|topics_source|status] [--stats]");
        return 0;
    }

    dataDir := path.join(rootDir, "benchmark/challenges/data");
    chRead := fs.readText(path.join(dataDir, "challenges.jsonl"));
    if not chRead.ok { io.errorLine("FAIL: " + chRead.error); return 1; }
    liRead := fs.readText(path.join(dataDir, "lists.jsonl"));
    if not liRead.ok { io.errorLine("FAIL: " + liRead.error); return 1; }

    lines := splitJsonLines(chRead.text);
    nAll := list.listCountText(lines);

    allIds: mut List<String> = [];
    allSources: mut List<String> = [];
    allCats: mut List<String> = [];
    allTitles: mut List<String> = [];
    allTopSrc: mut List<String> = [];
    allStatuses: mut List<String> = [];
    allDiffs: mut List<Int> = [];
    allDiffIntFlag: mut List<Bool> = [];
    allDiffRaw: mut List<String> = [];
    allNums: mut List<Int> = [];
    allPops: mut List<Int> = [];

    loop lines as ln {
        idV := json.readObjectString(ln, 0, "id").value;
        srcV := json.readObjectString(ln, 0, "source").value;
        catV := json.readObjectString(ln, 0, "category").value;
        ttlV := json.readObjectString(ln, 0, "title").value;
        tsV := json.readObjectString(ln, 0, "topics_source").value;
        stV := json.readObjectString(ln, 0, "status").value;

        dField := json.findObjectField(ln, 0, "difficulty");
        normD := parseScaledDecimal1000(ln, dField.valuePos, "normalized");
        numF := json.readObjectInt(ln, 0, "number");
        numV := if numF.found and numF.ok { numF.value } else { 0 };
        var popV := 0;
        popF := json.findObjectField(ln, 0, "popularity");
        if popF.found and isJsonObjectAt(ln, popF.valuePos) {
            solRes := json.readObjectInt(ln, popF.valuePos, "solved");
            if solRes.found and solRes.ok { popV = solRes.value; }
        }

        list.pushBack(mut allIds, idV);
        list.pushBack(mut allSources, srcV);
        list.pushBack(mut allCats, catV);
        list.pushBack(mut allTitles, ttlV);
        list.pushBack(mut allTopSrc, tsV);
        list.pushBack(mut allStatuses, stV);
        list.pushBack(mut allDiffs, normD.scaled);
        list.pushBack(mut allDiffIntFlag, normD.isIntLiteral);
        list.pushBack(mut allDiffRaw, normD.raw);
        list.pushBack(mut allNums, numV);
        list.pushBack(mut allPops, popV);
    }

    if hasQueryFlag(args, "--stats") {
        io.outputLine("total: " + integer.intText(nAll));
        io.outputLine("\nsource:\n" + formatFrequencyLines(allSources, "  ", 22));
        io.outputLine("\ncategory:\n" + formatFrequencyLines(allCats, "  ", 22));
        bands: mut List<String> = [];
        loop allDiffs as dScaled {
            list.pushBack(mut bands, difficultyBand(dScaled));
        }
        io.outputLine("\ndifficulty:\n" + formatFrequencyLines(bands, "  ", 22));
        io.outputLine("\ntopics_source:\n" + formatFrequencyLines(allTopSrc, "  ", 22));
        io.outputLine("\nstatus:\n" + formatFrequencyLines(allStatuses, "  ", 22));
        return 0;
    }

    listOpt := readQueryValue(args, "--list");
    var hasSelectedOrder := false;
    selectedOrderedIds: mut List<String> = [];
    selectedIdSet: mut Set<String>;
    if listOpt.found and listOpt.value =!= "" {
        hasSelectedOrder = true;
        listLines := splitJsonLines(liRead.text);
        seenListIds: mut Set<String>;
        loop splitTrimmedCsv(listOpt.value) as lid {
            if not set.has(seenListIds, lid) {
                set.add(mut seenListIds, lid);
                var matchedLine := "";
                loop listLines as ll {
                    if json.readObjectString(ll, 0, "id").value == lid {
                        matchedLine = ll;
                        break;
                    }
                }
                if matchedLine == "" {
                    io.errorLine("FAIL: unknown list(s): " + lid);
                    return 1;
                }
                loop readStringArray(matchedLine, 0, "challenge_ids") as cid {
                    list.pushBack(mut selectedOrderedIds, cid);
                    set.add(mut selectedIdSet, cid);
                }
            }
        }
    }

    emptyStrs: List<String> = [];
    srcFilter := readQueryValue(args, "--source");
    srcFilterList := if srcFilter.found { splitTrimmedCsv(srcFilter.value) } else { emptyStrs };
    catFilter := readQueryValue(args, "--category");
    catFilterList := if catFilter.found { splitTrimmedCsv(catFilter.value) } else { emptyStrs };
    topicsFilter := readQueryRepeatTopics(args);

    diffFilter := readQueryValue(args, "--difficulty");
    var hasDiffRange := false;
    var diffLow := 0;
    var diffHigh := 0;
    if diffFilter.found and diffFilter.value =!= "" {
        hasDiffRange = true;
        dash := text.indexOfText(diffFilter.value, "-", 0);
        if dash < 0 {
            p := parseScaledNumberText(diffFilter.value);
            if not p.ok { io.errorLine("FAIL: invalid difficulty range"); return 1; }
            diffLow = p.scaled;
            diffHigh = p.scaled;
        } else {
            pL := parseScaledNumberText(text.slice(diffFilter.value, 0, dash));
            pR := parseScaledNumberText(text.slice(diffFilter.value, dash + 1, text.length(diffFilter.value)));
            if not pL.ok or not pR.ok { io.errorLine("FAIL: invalid difficulty range"); return 1; }
            diffLow = pL.scaled;
            diffHigh = pR.scaled;
        }
    }

    tsFilter := readQueryValue(args, "--topics-source");
    stFilter := readQueryValue(args, "--status");
    premOpt := readQueryValue(args, "--premium");
    premium := if premOpt.found { premOpt.value } else { "include" };
    if premium =!= "include" and premium =!= "exclude" and premium =!= "only" {
        io.errorLine("FAIL: invalid --premium");
        return 1;
    }
    searchOpt := readQueryValue(args, "--search");
    searchNeedle := if searchOpt.found { asciiLower(searchOpt.value) } else { "" };

    var filteredIdx: mut List<Int> = [];
    var idx := 0;
    loop idx < nAll {
        var keep := true;
        if list.listCountText(srcFilterList) > 0 and not list.listContainsText(srcFilterList, allSources[idx]) { keep = false; }
        if keep and list.listCountText(catFilterList) > 0 and not list.listContainsText(catFilterList, allCats[idx]) { keep = false; }
        if keep and hasDiffRange {
            dv := allDiffs[idx];
            if dv < diffLow or dv > diffHigh { keep = false; }
        }
        if keep and tsFilter.found and tsFilter.value =!= "" and allTopSrc[idx] =!= tsFilter.value { keep = false; }
        if keep and stFilter.found and stFilter.value =!= "" and allStatuses[idx] =!= stFilter.value { keep = false; }
        if keep and premium =!= "include" {
            isPrem := json.readObjectBool(lines[idx], 0, "premium").value;
            if (premium == "only" and not isPrem) or (premium == "exclude" and isPrem) { keep = false; }
        }
        if keep and searchNeedle =!= "" {
            if text.indexOfText(asciiLower(allTitles[idx]), searchNeedle, 0) < 0 { keep = false; }
        }
        if keep and list.listCountText(topicsFilter) > 0 {
            recTopics := readStringArray(lines[idx], 0, "topics");
            loop topicsFilter as tf {
                if not list.listContainsText(recTopics, tf) {
                    keep = false;
                    break;
                }
            }
        }
        if keep and hasSelectedOrder {
            if not set.has(selectedIdSet, allIds[idx]) { keep = false; }
        }
        if keep { list.pushBack(mut filteredIdx, idx); }
        idx = idx + 1;
    }

    if hasSelectedOrder {
        filteredById: mut Map<String, Int>;
        loop filteredIdx as fi {
            if not map.has(filteredById, allIds[fi]) {
                map.set(mut filteredById, allIds[fi], fi);
            }
        }
        orderedIdx: mut List<Int> = [];
        loop selectedOrderedIds as targetId {
            fi := map.getOr(filteredById, targetId, -1);
            if fi >= 0 {
                list.pushBack(mut orderedIdx, fi);
            }
        }
        filteredIdx = orderedIdx;
    }

    groupOpt := readQueryValue(args, "--group-by");
    if groupOpt.found {
        gk := groupOpt.value;
        allowedGroup: List<String> = ["source", "category", "topic", "difficulty", "topics_source", "status"];
        if not list.listContainsText(allowedGroup, gk) {
            io.errorLine("FAIL: unknown grouping " + gk);
            return 1;
        }
        groupVals: mut List<String> = [];
        loop filteredIdx as fi {
            if gk == "topic" {
                loop readStringArray(lines[fi], 0, "topics") as tp {
                    list.pushBack(mut groupVals, tp);
                }
            } else if gk == "source" {
                list.pushBack(mut groupVals, allSources[fi]);
            } else if gk == "category" {
                list.pushBack(mut groupVals, allCats[fi]);
            } else if gk == "difficulty" {
                list.pushBack(mut groupVals, difficultyBand(allDiffs[fi]));
            } else if gk == "topics_source" {
                list.pushBack(mut groupVals, allTopSrc[fi]);
            } else {
                list.pushBack(mut groupVals, allStatuses[fi]);
            }
        }
        if list.listCountText(groupVals) > 0 {
            io.outputLine(formatFrequencyLines(groupVals, "", 24));
        }
        io.outputLine(padRight("TOTAL", 24) + " " + padLeft(integer.intText(list.listCountInt(filteredIdx)), 5));
        return 0;
    }

    sortOpt := readQueryValue(args, "--sort");
    sortMode := if sortOpt.found { sortOpt.value } else { "source" };
    allowedSort: List<String> = ["source", "id", "title", "difficulty", "popularity"];
    if not list.listContainsText(allowedSort, sortMode) {
        io.errorLine("FAIL: invalid --sort");
        return 1;
    }
    desc := hasQueryFlag(args, "--desc");
    if not hasSelectedOrder and list.listCountInt(filteredIdx) > 1 {
        mCount := list.listCountInt(filteredIdx);
        var cur: mut List<Int> = filteredIdx;
        var width := 1;
        loop width < mCount {
            next: mut List<Int> = [];
            var start := 0;
            loop start < mCount {
                mid := if start + width < mCount { start + width } else { mCount };
                rightEnd := if start + width * 2 < mCount { start + width * 2 } else { mCount };
                var li := start;
                var ri := mid;
                loop li < mid or ri < rightEnd {
                    if li >= mid {
                        list.pushBack(mut next, cur[ri]);
                        ri = ri + 1;
                    } else if ri >= rightEnd {
                        list.pushBack(mut next, cur[li]);
                        li = li + 1;
                    } else {
                        ia := cur[li];
                        ib := cur[ri];
                        cmp := queryCompareRecords(
                        sortMode, desc,
                        allSources[ia], allIds[ia], allTitles[ia], allDiffs[ia], allNums[ia], allPops[ia],
                        allSources[ib], allIds[ib], allTitles[ib], allDiffs[ib], allNums[ib], allPops[ib]
                        );
                        if cmp <= 0 {
                            list.pushBack(mut next, ia);
                            li = li + 1;
                        } else {
                            list.pushBack(mut next, ib);
                            ri = ri + 1;
                        }
                    }
                }
                start = start + width * 2;
            }
            cur = next;
            width = width * 2;
        }
        filteredIdx = cur;
    }

    totalMatches := list.listCountInt(filteredIdx);
    limitOpt := readQueryValue(args, "--limit");
    var limit := 25;
    if limitOpt.found {
        lp := text.textToInt(limitOpt.value);
        if not lp.ok { io.errorLine("FAIL: invalid --limit"); return 1; }
        limit = lp.value;
    }
    shownCount := if hasQueryFlag(args, "--all") or totalMatches <= limit { totalMatches } else if limit <= 0 { 0 } else { limit };

    if hasQueryFlag(args, "--json") {
        var si := 0;
        loop si < shownCount {
            io.outputLine(lines[filteredIdx[si]]);
            si = si + 1;
        }
        return 0;
    }

    if hasQueryFlag(args, "--csv") {
        io.output("id,title,source,category,difficulty,topics,url\r\n");
        var si := 0;
        loop si < shownCount {
            fi := filteredIdx[si];
            ln := lines[fi];
            diffStr := formatDifficultyCsv(allSources[fi], allDiffs[fi], allDiffRaw[fi], allDiffIntFlag[fi]);
            topicsJoined := text.joinTexts(readStringArray(ln, 0, "topics"), ";");
            urlV := json.readObjectString(ln, 0, "url").value;
            row := csvEscapeField(allIds[fi]) + ","
            + csvEscapeField(allTitles[fi]) + ","
            + csvEscapeField(allSources[fi]) + ","
            + csvEscapeField(allCats[fi]) + ","
            + csvEscapeField(diffStr) + ","
            + csvEscapeField(topicsJoined) + ","
            + csvEscapeField(urlV) + "\r\n";
            io.output(row);
            si = si + 1;
        }
        return 0;
    }

    io.outputLine(padRight("ID", 28) + " " + padLeft("DIFF", 4) + "  " + padRight("SOURCE", 14) + " TITLE");
    io.outputLine(text.repeatText("-", 110));
    var si := 0;
    loop si < shownCount {
        fi := filteredIdx[si];
        tVal := allTitles[fi];
        tDisp := if text.length(tVal) <= 52 { tVal } else { text.slice(tVal, 0, 49) + "..." };
        io.outputLine(padRight(allIds[fi], 28) + " " + padLeft(formatDiffTable(allDiffs[fi]), 4) + "  " + padRight(allSources[fi], 14) + " " + tDisp);
        si = si + 1;
    }
    io.outputLine("\n" + integer.intText(shownCount) + " shown of " + integer.intText(totalMatches) + " matching challenge(s)");
    0
};

pub findSortedEntity := fn(keys: List<String>, target: String): Int {
    var lo := 0;
    var hi := list.listCountText(keys) - 1;
    loop lo <= hi {
        mid := lo + (hi - lo) / 2;
        cmp := compareTextLex(keys[mid], target);
        if cmp == 0 { return mid; }
        if cmp < 0 { lo = mid + 1; } else { hi = mid - 1; }
    }
    -1
};

parseHexOrDecInt := fn(raw: String, isHex: Bool): (ok: Bool, value: Int) {
    size := text.length(raw);
    if size == 0 { return (ok = false, value = 0); }
    var acc := 0;
    var i := 0;
    hexDigits := "0123456789abcdef";
    hexUpper := "0123456789ABCDEF";
    loop i < size {
        ch := text.at(raw, i);
        var d := text.indexOfText(hexDigits, ch, 0);
        if d < 0 and isHex { d = text.indexOfText(hexUpper, ch, 0); }
        if d < 0 or (not isHex and d >= 10) { return (ok = false, value = 0); }
        if acc <= 1114111 {
            acc = acc * (if isHex { 16 } else { 10 }) + d;
        }
        i = i + 1;
    }
    (ok = true, value = acc)
};

decodeNumericHtmlEntity := fn(n: Int): String {
    legacy: List<Int> = [
    8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143,
    144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376
    ];
    if n == 0 or n > 1114111 or (n >= 55296 and n <= 57343) {
        return unicode.fromCodePoint(65533).text;
    }
    if n >= 128 and n <= 159 {
        return unicode.fromCodePoint(legacy[n - 128]).text;
    }
    low16 := n % 65536;
    if (n >= 1 and n <= 8) or n == 11 or (n >= 14 and n <= 31) or n == 127 or (n >= 64976 and n <= 65007) or low16 >= 65534 {
        return "";
    }
    cp := unicode.fromCodePoint(n);
    if cp.ok { cp.text } else { unicode.fromCodePoint(65533).text }
};

pub sortIndexByKeys := fn(keys: List<String>): List<Int> {
    var sortedIdx: mut List<Int> = [];
    var ki := 0;
    kCount := list.listCountText(keys);
    loop ki < kCount {
        list.pushBack(mut sortedIdx, ki);
        ki = ki + 1;
    }
    if kCount <= 1 { return sortedIdx; }
    var width := 1;
    loop width < kCount {
        next: mut List<Int> = [];
        var st := 0;
        loop st < kCount {
            mid := if st + width < kCount { st + width } else { kCount };
            re := if st + width * 2 < kCount { st + width * 2 } else { kCount };
            var li := st;
            var ri := mid;
            loop li < mid or ri < re {
                if li >= mid {
                    list.pushBack(mut next, sortedIdx[ri]);
                    ri = ri + 1;
                } else if ri >= re {
                    list.pushBack(mut next, sortedIdx[li]);
                    li = li + 1;
                } else if compareTextLex(keys[sortedIdx[li]], keys[sortedIdx[ri]]) <= 0 {
                    list.pushBack(mut next, sortedIdx[li]);
                    li = li + 1;
                } else {
                    list.pushBack(mut next, sortedIdx[ri]);
                    ri = ri + 1;
                }
            }
            st = st + width * 2;
        }
        sortedIdx = next;
        width = width * 2;
    }
    sortedIdx
};

pub unescapeHtmlWithTable := fn(sortedKeys: List<String>, sortedVals: List<String>, value: String): String {
    if text.indexOfText(value, "&", 0) < 0 { return value; }
    out: mut List<String> = [];
    size := text.length(value);
    var pos := 0;
    loop pos < size {
        amp := text.indexOfText(value, "&", pos);
        if amp < 0 {
            list.pushBack(mut out, text.slice(value, pos, size));
            break;
        }
        if amp > pos {
            list.pushBack(mut out, text.slice(value, pos, amp));
        }
        if amp + 1 >= size {
            list.pushBack(mut out, "&");
            break;
        }
        if text.at(value, amp + 1) == "#" {
            var numStart := amp + 2;
            var isHex := false;
            if numStart < size and (text.at(value, numStart) == "x" or text.at(value, numStart) == "X") {
                isHex = true;
                numStart = numStart + 1;
            }
            var j := numStart;
            loop j < size {
                ch := text.at(value, j);
                okCh := if isHex {
                    text.indexOfText("0123456789abcdefABCDEF", ch, 0) >= 0
                } else {
                    text.isDigit(ch)
                };
                if not okCh { break; }
                j = j + 1;
            }
            parsed := parseHexOrDecInt(text.slice(value, numStart, j), isHex);
            if parsed.ok {
                list.pushBack(mut out, decodeNumericHtmlEntity(parsed.value));
                pos = if j < size and text.at(value, j) == ";" { j + 1 } else { j };
            } else {
                list.pushBack(mut out, "&");
                pos = amp + 1;
            }
        } else {
            var end := amp + 1;
            maxEnd := if amp + 1 + 33 < size { amp + 1 + 33 } else { size };
            entityStops := "\t\n <&#" + unicode.fromCodePoint(12).text;
            loop end < maxEnd {
                ch := text.at(value, end);
                if text.indexOfText(entityStops, ch, 0) >= 0 { break; }
                end = end + 1;
                if ch == ";" { break; }
            }
            candMax := text.slice(value, amp + 1, end);
            var matched := false;
            var tryLen := text.length(candMax);
            loop tryLen >= 2 {
                cand := text.slice(candMax, 0, tryLen);
                idx := findSortedEntity(sortedKeys, cand);
                if idx >= 0 {
                    list.pushBack(mut out, sortedVals[idx]);
                    pos = amp + 1 + tryLen;
                    matched = true;
                    break;
                }
                tryLen = tryLen - 1;
            }
            if not matched {
                list.pushBack(mut out, "&");
                pos = amp + 1;
            }
        }
    }
    text.joinTexts(out, "")
};

/** Parses a flat JSON object of string values in one linear pass, returning interleaved sorted `[key0, val0, ...]`. */
pub parseSortedStringObjectPairs := fn(jsonText: String): List<String> {
    rawKeys: mut List<String> = [];
    rawVals: mut List<String> = [];
    jsonLen := text.length(jsonText);
    var pos := skipJsonSpace(jsonText, 0);
    if pos < jsonLen and text.at(jsonText, pos) == "{" {
        pos = skipJsonSpace(jsonText, pos + 1);
        loop pos < jsonLen and text.at(jsonText, pos) =!= "}" {
            kR := json.readStringAt(jsonText, pos);
            if not kR.ok { break; }
            pos = skipJsonSpace(jsonText, kR.next);
            if pos >= jsonLen or text.at(jsonText, pos) =!= ":" { break; }
            pos = skipJsonSpace(jsonText, pos + 1);
            vR := json.readStringAt(jsonText, pos);
            if not vR.ok { break; }
            list.pushBack(mut rawKeys, kR.value);
            list.pushBack(mut rawVals, vR.value);
            pos = skipJsonSpace(jsonText, vR.next);
            if pos < jsonLen and text.at(jsonText, pos) == "," {
                pos = skipJsonSpace(jsonText, pos + 1);
            }
        }
    }
    sortedIdx := sortIndexByKeys(rawKeys);
    out: mut List<String> = [];
    loop sortedIdx as si {
        list.pushBack(mut out, rawKeys[si]);
        list.pushBack(mut out, rawVals[si]);
    }
    out
};

/** Decodes HTML5 named and numeric character references using `entitiesJsonPath` (`html-entities.json`). */
pub unescapeChallengeHtml := fn(entitiesJsonText: String, value: String): String {
    if text.indexOfText(value, "&", 0) < 0 { return value; }
    pairs := parseSortedStringObjectPairs(entitiesJsonText);
    sortedKeys: mut List<String> = [];
    sortedVals: mut List<String> = [];
    var pi := 0;
    pLen := list.listCountText(pairs);
    loop pi + 1 < pLen {
        list.pushBack(mut sortedKeys, pairs[pi]);
        list.pushBack(mut sortedVals, pairs[pi + 1]);
        pi = pi + 2;
    }
    unescapeHtmlWithTable(sortedKeys, sortedVals, value)
};

pub stripHtmlTags := fn(raw: String): String {
    out: mut List<String> = [];
    size := text.length(raw);
    var pos := 0;
    loop pos < size {
        lt := text.indexOfText(raw, "<", pos);
        if lt < 0 {
            list.pushBack(mut out, text.slice(raw, pos, size));
            break;
        }
        gt := text.indexOfText(raw, ">", lt + 1);
        if gt < 0 {
            list.pushBack(mut out, text.slice(raw, pos, size));
            break;
        }
        list.pushBack(mut out, text.slice(raw, pos, lt));
        pos = gt + 1;
    }
    text.joinTexts(out, "")
};

replaceHtmlLineBreaksAndParagraphs := fn(raw: String): String {
    out: mut List<String> = [];
    size := text.length(raw);
    var pos := 0;
    loop pos < size {
        lt := text.indexOfText(raw, "<", pos);
        if lt < 0 {
            list.pushBack(mut out, text.slice(raw, pos, size));
            break;
        }
        gt := text.indexOfText(raw, ">", lt + 1);
        if gt < 0 {
            list.pushBack(mut out, text.slice(raw, pos, size));
            break;
        }
        list.pushBack(mut out, text.slice(raw, pos, lt));
        tag := asciiLower(text.trim(text.slice(raw, lt + 1, gt)));
        if tag == "br" or tag == "br/" or tag == "br /" {
            list.pushBack(mut out, "\n");
        } else if tag == "/p" {
            list.pushBack(mut out, "\n\n");
        }
        pos = gt + 1;
    }
    text.joinTexts(out, "")
};

collapseMultiNewlines := fn(raw: String): String {
    out: mut List<String> = [];
    rawLen := text.length(raw);
    var streak := 0;
    var i := 0;
    loop i < rawLen {
        ch := text.at(raw, i);
        if ch == "\n" {
            streak = streak + 1;
            if streak <= 2 { list.pushBack(mut out, ch); }
        } else {
            streak = 0;
            list.pushBack(mut out, ch);
        }
        i = i + 1;
    }
    text.joinTexts(out, "")
};

encodeUriComponentStrict := fn(seg: String): String {
    unreserved := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~";
    hex := "0123456789ABCDEF";
    out: mut List<String> = [];
    bytes := unicode.utf8Encode(seg);
    var i := 0;
    loop i < list.listCountInt(bytes) {
        b := bytes[i];
        if b < 128 {
            ch := unicode.fromCodePoint(b).text;
            if text.indexOfText(unreserved, ch, 0) >= 0 {
                list.pushBack(mut out, ch);
            } else {
                list.pushBack(mut out, "%" + text.at(hex, b / 16) + text.at(hex, b % 16));
            }
        } else {
            list.pushBack(mut out, "%" + text.at(hex, b / 16) + text.at(hex, b % 16));
        }
        i = i + 1;
    }
    text.joinTexts(out, "")
};

encodeGithubPath := fn(relPath: String): String {
    parts: mut List<String> = [];
    size := text.length(relPath);
    var start := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        if atEnd or text.at(relPath, i) == "/" {
            list.pushBack(mut parts, encodeUriComponentStrict(text.slice(relPath, start, i)));
            start = i + 1;
        }
        i = i + 1;
    }
    text.joinTexts(parts, "/")
};

pub padLeftZero := fn(n: Int, width: Int): String {
    var out := integer.intText(n);
    loop text.length(out) < width {
        out = "0" + out;
    }
    out
};

parseThreeDigitPythonNum := fn(treePath: String): (ok: Bool, num: Int) {
    if not text.startsWithAt(treePath, 0, "python/p") or not text.endsWith(treePath, ".py") or text.length(treePath) =!= 14 {
        return (ok = false, num = 0);
    }
    digits := text.slice(treePath, 8, 11);
    if not text.isDigit(text.at(digits, 0)) or not text.isDigit(text.at(digits, 1)) or not text.isDigit(text.at(digits, 2)) {
        return (ok = false, num = 0);
    }
    parsed := text.textToInt(digits);
    (ok = parsed.ok, num = parsed.value)
};

parseLeetcodeSolutionNum := fn(treePath: String): (ok: Bool, num: Int) {
    if not text.startsWithAt(treePath, 0, "solution/") or not text.endsWith(treePath, "/Solution.py") {
        return (ok = false, num = 0);
    }
    dashPos := text.indexOfText(treePath, "-", 9);
    if dashPos <= 9 { return (ok = false, num = 0); }
    slashPos := text.indexOfText(treePath, "/", dashPos + 1);
    if slashPos <= dashPos + 1 { return (ok = false, num = 0); }
    dotPos := text.indexOfText(treePath, ".", slashPos + 1);
    if dotPos <= slashPos + 1 { return (ok = false, num = 0); }
    numStr := text.slice(treePath, slashPos + 1, dotPos);
    numLen := text.length(numStr);
    var i := 0;
    loop i < numLen {
        if not text.isDigit(text.at(numStr, i)) { return (ok = false, num = 0); }
        i = i + 1;
    }
    parsed := text.textToInt(numStr);
    (ok = parsed.ok, num = parsed.value)
};

mergeAndWriteBenchmarkManifest := fn(benchDir: String, replaceSource: String, writtenLines: List<String>): (ok: Bool, totalRows: Int, error: String) {
    manifestPath := path.join(benchDir, "items.jsonl");
    mergedLines: mut List<String> = [];
    if fs.kind(manifestPath) == fs.FILE_KIND_FILE {
        extRead := fs.readText(manifestPath);
        if not extRead.ok { return (ok = false, totalRows = 0, error = extRead.error); }
        loop splitJsonLines(extRead.text) as ln {
            if json.readObjectString(ln, 0, "source").value =!= replaceSource {
                list.pushBack(mut mergedLines, ln);
            }
        }
    }
    loop writtenLines as wl {
        list.pushBack(mut mergedLines, wl);
    }

    n := list.listCountText(mergedLines);
    sources: mut List<String> = [];
    ids: mut List<String> = [];
    var order: mut List<Int> = [];
    var i := 0;
    loop i < n {
        ln := mergedLines[i];
        list.pushBack(mut sources, json.readObjectString(ln, 0, "source").value);
        list.pushBack(mut ids, json.readObjectString(ln, 0, "id").value);
        list.pushBack(mut order, i);
        i = i + 1;
    }
    if n > 1 {
        var width := 1;
        loop width < n {
            next: mut List<Int> = [];
            var st := 0;
            loop st < n {
                mid := if st + width < n { st + width } else { n };
                re := if st + width * 2 < n { st + width * 2 } else { n };
                var li := st;
                var ri := mid;
                loop li < mid or ri < re {
                    if li >= mid {
                        list.pushBack(mut next, order[ri]);
                        ri = ri + 1;
                    } else if ri >= re {
                        list.pushBack(mut next, order[li]);
                        li = li + 1;
                    } else {
                        ia := order[li];
                        ib := order[ri];
                        var cmp := compareTextLex(sources[ia], sources[ib]);
                        if cmp == 0 { cmp = compareTextLex(ids[ia], ids[ib]); }
                        if cmp <= 0 {
                            list.pushBack(mut next, ia);
                            li = li + 1;
                        } else {
                            list.pushBack(mut next, ib);
                            ri = ri + 1;
                        }
                    }
                }
                st = st + width * 2;
            }
            order = next;
            width = width * 2;
        }
    }

    sortedLines: mut List<String> = [];
    sortedSources: mut List<String> = [];
    loop order as oi {
        list.pushBack(mut sortedLines, mergedLines[oi]);
        list.pushBack(mut sortedSources, sources[oi]);
    }
    _mb := fs.makeDir(benchDir);
    wItems := fs.writeText(manifestPath, if n == 0 { "" } else { text.joinTexts(sortedLines, "\n") + "\n" });
    if not wItems.ok { return (ok = false, totalRows = 0, error = wItems.error); }

    idxJson := "{\n  \"total\": " + integer.intText(n) + ",\n  \"sources\": " + formatSortedCountsJson(sortedSources) + "\n}\n";
    wIdx := fs.writeText(path.join(benchDir, "index.json"), idxJson);
    if not wIdx.ok { return (ok = false, totalRows = 0, error = wIdx.error); }
    (ok = true, totalRows = n, error = "")
};

/** Builds Project Euler benchmark items from `.cache/benchmark/euler` (`build_benchmark_euler.ts`). */
pub buildBenchmarkEuler := fn(challengesRootDir: String, entitiesJsonText: String): (ok: Bool, writtenCount: Int, totalCount: Int, error: String) {
    cacheDir := path.join(challengesRootDir, ".cache/benchmark/euler");
    chRead := fs.readText(path.join(challengesRootDir, "data/challenges.jsonl"));
    if not chRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = chRead.error); }
    ansRead := readNormalizedText(path.join(cacheDir, "Answers.txt"));
    if not ansRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = ansRead.error); }
    treeRead := fs.readText(path.join(cacheDir, "tree.json"));
    if not treeRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = treeRead.error); }

    entPairs := parseSortedStringObjectPairs(entitiesJsonText);
    entKeys: mut List<String> = [];
    entVals: mut List<String> = [];
    var epi := 0;
    loop epi + 1 < list.listCountText(entPairs) {
        list.pushBack(mut entKeys, entPairs[epi]);
        list.pushBack(mut entVals, entPairs[epi + 1]);
        epi = epi + 2;
    }

    eulerByNum: mut Map<Int, Int>;
    eulerLines: mut List<String> = [];
    loop splitJsonLines(chRead.text) as ln {
        if json.readObjectString(ln, 0, "source").value == "project-euler" {
            numR := json.readObjectInt(ln, 0, "number");
            if numR.found and numR.ok {
                if not map.has(eulerByNum, numR.value) {
                    map.set(mut eulerByNum, numR.value, list.listCountText(eulerLines));
                }
                list.pushBack(mut eulerLines, ln);
            }
        }
    }

    ansByNum: mut Map<Int, Int>;
    ansVals: mut List<String> = [];
    loop splitJsonLines(ansRead.text) as aln {
        if text.startsWithAt(aln, 0, "Problem ") {
            colon := text.indexOfText(aln, ":", 8);
            if colon > 8 {
                pn := text.textToInt(text.slice(aln, 8, colon));
                if pn.ok {
                    rest := text.trim(text.slice(aln, colon + 1, text.length(aln)));
                    restLen := text.length(rest);
                    var sp := 0;
                    loop sp < restLen {
                        ch := text.at(rest, sp);
                        if ch == " " or ch == "\t" { break; }
                        sp = sp + 1;
                    }
                    ansToken := text.slice(rest, 0, sp);
                    if ansToken =!= "" {
                        if not map.has(ansByNum, pn.value) {
                            map.set(mut ansByNum, pn.value, list.listCountText(ansVals));
                        }
                        list.pushBack(mut ansVals, ansToken);
                    }
                }
            }
        }
    }

    treeField := json.findObjectField(treeRead.text, 0, "tree");
    blobNumsRaw: mut List<Int> = [];
    blobNumSet: mut Set<Int>;
    loop json.arrayElementOffsets(treeRead.text, treeField.valuePos) as tPos {
        if json.readObjectString(treeRead.text, tPos, "type").value == "blob" {
            tPath := json.readObjectString(treeRead.text, tPos, "path").value;
            pn := parseThreeDigitPythonNum(tPath);
            if pn.ok and not set.has(blobNumSet, pn.num) {
                set.add(mut blobNumSet, pn.num);
                list.pushBack(mut blobNumsRaw, pn.num);
            }
        }
    }
    blobNums := list.sortInts(blobNumsRaw);

    benchDir := path.join(challengesRootDir, "benchmark");
    writtenLines: mut List<String> = [];

    loop blobNums as n {
        chIdx := map.getOr(eulerByNum, n, -1);
        ansIdx := map.getOr(ansByNum, n, -1);
        padded := padLeftZero(n, 3);
        stmtHtmlPath := path.join(cacheDir, "statements/problem-" + padded + ".html");
        if chIdx >= 0 and ansIdx >= 0 and fs.kind(stmtHtmlPath) == fs.FILE_KIND_FILE {
            cLine := eulerLines[chIdx];
            ans := ansVals[ansIdx];
            page := readNormalizedText(stmtHtmlPath).text;
            bodyStartTag := "<div class=\"problem_content\" role=\"problem\">";
            bStart := text.indexOfText(page, bodyStartTag, 0);
            if bStart >= 0 {
                afterOpen := bStart + text.length(bodyStartTag);
                var bEnd := -1;
                var searchPos := afterOpen;
                loop true {
                    closeDiv := text.indexOfText(page, "</div>", searchPos);
                    if closeDiv < 0 { break; }
                    afterClose := skipJsonSpace(page, closeDiv + 6);
                    if text.startsWithAt(page, afterClose, "<br") {
                        bEnd = closeDiv;
                        break;
                    }
                    searchPos = closeDiv + 6;
                }
                if bEnd >= 0 {
                    bodyHtml := text.slice(page, afterOpen, bEnd);
                    var title := json.readObjectString(cLine, 0, "title").value;
                    h2Start := text.indexOfText(page, "<h2>", 0);
                    if h2Start >= 0 {
                        h2End := text.indexOfText(page, "</h2>", h2Start + 4);
                        if h2End >= 0 {
                            extractedTitle := text.trim(unescapeHtmlWithTable(entKeys, entVals, stripHtmlTags(text.slice(page, h2Start + 4, h2End))));
                            if extractedTitle =!= "" { title = extractedTitle; }
                        }
                    }
                    statement := text.trim(collapseMultiNewlines(unescapeHtmlWithTable(entKeys, entVals, replaceHtmlLineBreaksAndParagraphs(bodyHtml))));
                    if statement =!= "" {
                        cid := json.readObjectString(cLine, 0, "id").value;
                        curl := json.readObjectString(cLine, 0, "url").value;
                        ccat := json.readObjectString(cLine, 0, "category").value;
                        topicsSpan := json.valueSpan(cLine, json.findObjectField(cLine, 0, "topics").valuePos);
                        topicsRawJson := text.slice(cLine, topicsSpan.start, topicsSpan.end);
                        diffField := json.findObjectField(cLine, 0, "difficulty");
                        diffSpan := json.valueSpan(cLine, diffField.valuePos);
                        diffRawJson := text.slice(cLine, diffSpan.start, diffSpan.end);
                        normRes := parseScaledDecimal1000(cLine, diffField.valuePos, "normalized");
                        rawDiffField := json.findObjectField(cLine, diffField.valuePos, "raw");
                        rawDiffStr := json.readStringAt(cLine, rawDiffField.valuePos);
                        rawDiffDisp := if rawDiffStr.ok { rawDiffStr.value } else {
                            sp := json.valueSpan(cLine, rawDiffField.valuePos);
                            text.slice(cLine, sp.start, sp.end)
                        };
                        diffDisp := formatDifficultyCsv("project-euler", normRes.scaled, normRes.raw, normRes.isIntLiteral);

                        itemDir := path.join(benchDir, "items/" + cid);
                        _mp := fs.makeDir(path.join(itemDir, "tests/public"));
                        probMd := "# " + title + "\n\n**Source:** [Project Euler #" + integer.intText(n) + "](" + curl + ")  \n"
                        + "**Answer type:** one number  \n"
                        + "**Difficulty:** " + diffDisp + "/10 (" + rawDiffDisp + ")\n\n"
                        + "## Problem\n\n" + statement + "\n\n## Output\n\nPrint the single numeric answer.\n";
                        _wp := fs.writeText(path.join(itemDir, "problem.md"), probMd);
                        _wa := fs.writeText(path.join(itemDir, "tests/public/answer.txt"), ans + "\n");

                        refUrl := "https://github.com/nayuki/Project-Euler-solutions/blob/master/python/p" + padded + ".py";
                        ansSha := crypto.sha256Bytes(unicode.utf8Encode(ans));
                        metaJson := "{\n"
                        + "  \"id\": " + json.quoteString(cid) + ",\n"
                        + "  \"source\": \"project-euler\",\n"
                        + "  \"title\": " + json.quoteString(title) + ",\n"
                        + "  \"url\": " + json.quoteString(curl) + ",\n"
                        + "  \"category\": " + json.quoteString(ccat) + ",\n"
                        + "  \"topics\": " + topicsRawJson + ",\n"
                        + "  \"difficulty\": " + diffRawJson + ",\n"
                        + "  \"harness\": \"single-answer\",\n"
                        + "  \"statement\": \"problem.md\",\n"
                        + "  \"tests\": {\n    \"public\": 1,\n    \"hidden\": 0,\n    \"public_path\": \"tests/public/answer.txt\",\n    \"hidden_kind\": \"none\"\n  },\n"
                        + "  \"reference_solutions\": [\n    {\n      \"language\": \"python\",\n      \"url\": " + json.quoteString(refUrl) + ",\n      \"license\": \"All rights reserved; link only\",\n      \"verified_answer\": true\n    }\n  ],\n"
                        + "  \"answer_sha256\": " + json.quoteString(ansSha) + ",\n"
                        + "  \"license_note\": \"Statement remains Project Euler copyright; reference code remains Project Nayuki copyright.\"\n}\n";
                        _wm := fs.writeText(path.join(itemDir, "meta.json"), metaJson);

                        itemRow := "{\"id\":" + json.quoteString(cid) + ",\"source\":\"project-euler\",\"title\":" + json.quoteString(title)
                        + ",\"url\":" + json.quoteString(curl) + ",\"harness\":\"single-answer\",\"tests\":{\"public\":1,\"hidden\":0},\"reference\":"
                        + json.quoteString(refUrl) + "}";
                        list.pushBack(mut writtenLines, itemRow);
                    }
                }
            }
        }
    }

    merged := mergeAndWriteBenchmarkManifest(benchDir, "project-euler", writtenLines);
    if not merged.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = merged.error); }
    (ok = true, writtenCount = list.listCountText(writtenLines), totalCount = merged.totalRows, error = "")
};

splitBeforeExample1 := fn(desc: String): String {
    lines: mut List<String> = [];
    trimmed := text.trim(desc);
    rawLines := splitJsonLines(trimmed);
    loop rawLines as ln {
        t := text.trim(ln);
        if text.startsWithAt(t, 0, "Example 1:") or text.startsWithAt(t, 0, "Example 1 :") {
            break;
        }
        list.pushBack(mut lines, ln);
    }
    var out := text.trim(text.joinTexts(lines, "\n"));
    if text.endsWith(out, "Constraints:") {
        out = text.trim(text.slice(out, 0, text.length(out) - 12));
    }
    out
};

/** Builds LeetCode benchmark items from `.cache/{leetcode,benchmark/leetcode}` (`build_benchmark_leetcode.ts`). */
pub buildBenchmarkLeetcode := fn(challengesRootDir: String): (ok: Bool, writtenCount: Int, totalCount: Int, error: String) {
    dataDir := path.join(challengesRootDir, "data");
    cacheDir := path.join(challengesRootDir, ".cache");
    chRead := fs.readText(path.join(dataDir, "challenges.jsonl"));
    if not chRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = chRead.error); }
    tsRead := fs.readText(path.join(dataDir, "tests.jsonl"));
    if not tsRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = tsRead.error); }
    mRead := fs.readText(path.join(cacheDir, "leetcode/merged.json"));
    if not mRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = mRead.error); }
    lRead := fs.readText(path.join(dataDir, "lists.jsonl"));
    if not lRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = lRead.error); }
    trRead := fs.readText(path.join(cacheDir, "benchmark/leetcode/tree.json"));
    if not trRead.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = trRead.error); }

    chLines := splitJsonLines(chRead.text);
    chIds: mut List<String> = [];
    chIdIndex: mut Map<String, Int>;
    loop chLines as cl {
        cid := json.readObjectString(cl, 0, "id").value;
        if not map.has(chIdIndex, cid) {
            map.set(mut chIdIndex, cid, list.listCountText(chIds));
        }
        list.pushBack(mut chIds, cid);
    }

    tsLines := splitJsonLines(tsRead.text);
    tsIdIndex: mut Map<String, Int>;
    var tsi := 0;
    loop tsLines as tl {
        tid := json.readObjectString(tl, 0, "challenge_id").value;
        if not map.has(tsIdIndex, tid) {
            map.set(mut tsIdIndex, tid, tsi);
        }
        tsi = tsi + 1;
    }

    qField := json.findObjectField(mRead.text, 0, "questions");
    qOffsets := json.arrayElementOffsets(mRead.text, qField.valuePos);
    qIdIndex: mut Map<String, Int>;
    var qi := 0;
    loop qOffsets as qp {
        fidStr := json.readObjectString(mRead.text, qp, "frontend_id");
        qid := if fidStr.found and fidStr.ok {
            fidStr.value
        } else {
            fidInt := json.readObjectInt(mRead.text, qp, "frontend_id");
            if fidInt.found and fidInt.ok { integer.intText(fidInt.value) } else { "" }
        };
        if not map.has(qIdIndex, qid) {
            map.set(mut qIdIndex, qid, qi);
        }
        qi = qi + 1;
    }

    treeField := json.findObjectField(trRead.text, 0, "tree");
    pathNumIndex: mut Map<Int, Int>;
    pathStrs: mut List<String> = [];
    loop json.arrayElementOffsets(trRead.text, treeField.valuePos) as tPos {
        if json.readObjectString(trRead.text, tPos, "type").value == "blob" {
            tPath := json.readObjectString(trRead.text, tPos, "path").value;
            pn := parseLeetcodeSolutionNum(tPath);
            if pn.ok and not map.has(pathNumIndex, pn.num) {
                map.set(mut pathNumIndex, pn.num, list.listCountText(pathStrs));
                list.pushBack(mut pathStrs, tPath);
            }
        }
    }

    curated: mut List<String> = [];
    curatedSet: mut Set<String>;
    loop splitJsonLines(lRead.text) as ll {
        lid := json.readObjectString(ll, 0, "id").value;
        if lid == "blind-75" or lid == "neetcode-150" {
            loop readStringArray(ll, 0, "challenge_ids") as cid {
                if not set.has(curatedSet, cid) {
                    set.add(mut curatedSet, cid);
                    list.pushBack(mut curated, cid);
                }
            }
        }
    }

    selIds: mut List<String> = [];
    selIdSet: mut Set<String>;
    selOrigins: mut List<String> = [];
    loop curated as cid {
        ci := map.getOr(chIdIndex, cid, -1);
        if ci >= 0 {
            cl := chLines[ci];
            isPrem := json.readObjectBool(cl, 0, "premium").value;
            cat := json.readObjectString(cl, 0, "category").value;
            tps := readStringArray(cl, 0, "topics");
            natId := json.readObjectString(cl, 0, "native_id").value;
            natNum := text.textToInt(natId);
            ti := map.getOr(tsIdIndex, cid, -1);
            var hasPub := false;
            if ti >= 0 {
                pf := json.findObjectField(tsLines[ti], 0, "public");
                if pf.found and isJsonArrayAt(tsLines[ti], pf.valuePos) {
                    hasPub = list.listCountInt(json.arrayElementOffsets(tsLines[ti], pf.valuePos)) > 0;
                }
            }
            if not isPrem and cat == "algorithms" and not list.listContainsText(tps, "design")
            and map.has(qIdIndex, natId) and natNum.ok and map.has(pathNumIndex, natNum.value) and hasPub {
                list.pushBack(mut selIds, cid);
                set.add(mut selIdSet, cid);
                list.pushBack(mut selOrigins, "curated");
            }
        }
    }

    fillIndices: mut List<Int> = [];
    fillPops: mut List<Int> = [];
    var ci := 0;
    chCount := list.listCountText(chIds);
    loop ci < chCount {
        cl := chLines[ci];
        cid := chIds[ci];
        if json.readObjectString(cl, 0, "source").value == "leetcode"
        and not set.has(selIdSet, cid) and not set.has(curatedSet, cid) {
            isPrem := json.readObjectBool(cl, 0, "premium").value;
            cat := json.readObjectString(cl, 0, "category").value;
            tps := readStringArray(cl, 0, "topics");
            natId := json.readObjectString(cl, 0, "native_id").value;
            natNum := text.textToInt(natId);
            ti := map.getOr(tsIdIndex, cid, -1);
            var hasPub := false;
            if ti >= 0 {
                pf := json.findObjectField(tsLines[ti], 0, "public");
                if pf.found and isJsonArrayAt(tsLines[ti], pf.valuePos) {
                    hasPub = list.listCountInt(json.arrayElementOffsets(tsLines[ti], pf.valuePos)) > 0;
                }
            }
            if not isPrem and cat == "algorithms" and not list.listContainsText(tps, "design")
            and map.has(qIdIndex, natId) and natNum.ok and map.has(pathNumIndex, natNum.value) and hasPub {
                var solved := 0;
                popF := json.findObjectField(cl, 0, "popularity");
                if popF.found and isJsonObjectAt(cl, popF.valuePos) {
                    sR := json.readObjectInt(cl, popF.valuePos, "solved");
                    if sR.found and sR.ok { solved = sR.value; }
                }
                list.pushBack(mut fillIndices, ci);
                list.pushBack(mut fillPops, solved);
            }
        }
        ci = ci + 1;
    }

    fLen := list.listCountInt(fillIndices);
    fillOrd := collections.sortIndicesBy(fLen, fn(a: Int, b: Int): Bool {
        fillPops[a] >= fillPops[b]
    });
    loop fillOrd as oi {
        fi := fillIndices[oi];
        list.pushBack(mut selIds, chIds[fi]);
        list.pushBack(mut selOrigins, "popular");
    }

    benchDir := path.join(challengesRootDir, "benchmark");
    writtenLines: mut List<String> = [];
    var candI := 0;
    selCount := list.listCountText(selIds);
    loop candI < selCount {
        if list.listCountText(writtenLines) >= 298 { break; }
        cid := selIds[candI];
        origin := selOrigins[candI];
        cLine := chLines[map.getOr(chIdIndex, cid, 0)];
        tLine := tsLines[map.getOr(tsIdIndex, cid, 0)];
        natId := json.readObjectString(cLine, 0, "native_id").value;
        qPos := qOffsets[map.getOr(qIdIndex, natId, 0)];
        descR := json.readObjectString(mRead.text, qPos, "description");
        descText := splitBeforeExample1(if descR.found and descR.ok { descR.value } else { "" });
        if text.length(descText) >= 40 {
            n := text.textToInt(natId).value;
            rawRel := pathStrs[map.getOr(pathNumIndex, n, 0)];
            refUrl := "https://github.com/doocs/leetcode/blob/main/" + encodeGithubPath(rawRel);

            ctitle := json.readObjectString(cLine, 0, "title").value;
            curl := json.readObjectString(cLine, 0, "url").value;
            ccat := json.readObjectString(cLine, 0, "category").value;
            topics := readStringArray(cLine, 0, "topics");
            topicsSpan := json.valueSpan(cLine, json.findObjectField(cLine, 0, "topics").valuePos);
            topicsRawJson := text.slice(cLine, topicsSpan.start, topicsSpan.end);
            diffField := json.findObjectField(cLine, 0, "difficulty");
            diffSpan := json.valueSpan(cLine, diffField.valuePos);
            diffRawJson := text.slice(cLine, diffSpan.start, diffSpan.end);
            normRes := parseScaledDecimal1000(cLine, diffField.valuePos, "normalized");
            rawDiffF := json.findObjectField(cLine, diffField.valuePos, "raw");
            rawDiffStr := json.readStringAt(cLine, rawDiffF.valuePos);
            rawDiffDisp := if rawDiffStr.ok { rawDiffStr.value } else {
                sp := json.valueSpan(cLine, rawDiffF.valuePos);
                text.slice(cLine, sp.start, sp.end)
            };
            diffDisp := formatDifficultyCsv("leetcode", normRes.scaled, normRes.raw, normRes.isIntLiteral);

            pubField := json.findObjectField(tLine, 0, "public");
            hidField := json.findObjectField(tLine, 0, "hidden");
            pubSpan := json.valueSpan(tLine, pubField.valuePos);
            hidSpan := json.valueSpan(tLine, hidField.valuePos);
            pubArrayJson := text.slice(tLine, pubSpan.start, pubSpan.end);
            hidArrayJson := text.slice(tLine, hidSpan.start, hidSpan.end);
            pubOffsets := json.arrayElementOffsets(tLine, pubField.valuePos);
            hidOffsets := json.arrayElementOffsets(tLine, hidField.valuePos);
            pubCount := list.listCountInt(pubOffsets);
            hidCount := list.listCountInt(hidOffsets);

            exBlocks: mut List<String> = [];
            loop pubOffsets as pPos {
                en := json.readObjectString(tLine, pPos, "name").value;
                ein := json.readObjectString(tLine, pPos, "input").value;
                eout := json.readObjectString(tLine, pPos, "output").value;
                list.pushBack(mut exBlocks, "### " + en + "\n\n```text\nInput: " + ein + "\nOutput: " + eout + "\n```");
            }

            topicsJoined := if list.listCountText(topics) > 0 { text.joinTexts(topics, ", ") } else { "—" };
            probMd := "# " + ctitle + "\n\n"
            + "**Source:** [LeetCode #" + integer.intText(n) + "](" + curl + ")  \n"
            + "**Difficulty:** " + diffDisp + "/10 (" + rawDiffDisp + ")  \n"
            + "**Topics:** " + topicsJoined + "  \n"
            + "**Harness:** function-style inputs (`name = value` pairs)\n\n"
            + "## Problem\n\n" + descText + "\n\n"
            + "## Public examples\n\n" + text.joinTexts(exBlocks, "\n\n") + "\n";

            itemDir := path.join(benchDir, "items/" + cid);
            _mt := fs.makeDir(path.join(itemDir, "tests"));
            _wp := fs.writeText(path.join(itemDir, "problem.md"), probMd);
            _wpub := fs.writeText(path.join(itemDir, "tests/public.json"), pubArrayJson + "\n");
            _whid := fs.writeText(path.join(itemDir, "tests/hidden.json"), hidArrayJson + "\n");

            testsMetaJson := "{\"public\":" + integer.intText(pubCount) + ",\"hidden\":" + integer.intText(hidCount)
            + ",\"public_path\":\"tests/public.json\",\"hidden_path\":\"tests/hidden.json\",\"hidden_kind\":\"held-out-official-examples\"}";

            metaJson := "{\n"
            + "  \"id\": " + json.quoteString(cid) + ",\n"
            + "  \"source\": \"leetcode\",\n"
            + "  \"title\": " + json.quoteString(ctitle) + ",\n"
            + "  \"url\": " + json.quoteString(curl) + ",\n"
            + "  \"category\": " + json.quoteString(ccat) + ",\n"
            + "  \"topics\": " + topicsRawJson + ",\n"
            + "  \"difficulty\": " + diffRawJson + ",\n"
            + "  \"harness\": \"function\",\n"
            + "  \"input_format\": \"text\",\n"
            + "  \"statement\": \"problem.md\",\n"
            + "  \"selection\": " + json.quoteString(origin) + ",\n"
            + "  \"tests\": " + testsMetaJson + ",\n"
            + "  \"reference_solutions\": [\n    {\n      \"language\": \"python\",\n      \"url\": " + json.quoteString(refUrl) + ",\n      \"license\": \"CC-BY-SA-4.0\",\n      \"status\": \"linked-not-executed\"\n    }\n  ],\n"
            + "  \"license_note\": \"Statement metadata from LeetCode; reference code remains doocs/leetcode CC-BY-SA-4.0.\"\n}\n";
            _wm := fs.writeText(path.join(itemDir, "meta.json"), metaJson);

            itemRow := "{\"id\":" + json.quoteString(cid) + ",\"source\":\"leetcode\",\"title\":" + json.quoteString(ctitle)
            + ",\"url\":" + json.quoteString(curl) + ",\"harness\":\"function\",\"selection\":" + json.quoteString(origin)
            + ",\"tests\":" + testsMetaJson + ",\"reference\":" + json.quoteString(refUrl) + "}";
            list.pushBack(mut writtenLines, itemRow);
        }
        candI = candI + 1;
    }

    merged := mergeAndWriteBenchmarkManifest(benchDir, "leetcode", writtenLines);
    if not merged.ok { return (ok = false, writtenCount = 0, totalCount = 0, error = merged.error); }
    (ok = true, writtenCount = list.listCountText(writtenLines), totalCount = merged.totalRows, error = "")
};

/** CLI runner for `benchmark/challenges/tools/build_benchmark_euler.ts`. */
pub runBuildBenchmarkEulerCommand := fn(rootDir: String): Int {
    chRoot := path.join(rootDir, "benchmark/challenges");
    entRead := fs.readText(path.join(chRoot, "tools/html-entities.json"));
    if not entRead.ok { io.errorLine("FAIL: " + entRead.error); return 1; }
    res := buildBenchmarkEuler(chRoot, entRead.text);
    if not res.ok { io.errorLine("FAIL: " + res.error); return 1; }
    io.outputLine("wrote " + integer.intText(res.writtenCount) + " Project Euler items; total " + integer.intText(res.totalCount));
    0
};

/** CLI runner for `benchmark/challenges/tools/build_benchmark_leetcode.ts`. */
pub runBuildBenchmarkLeetcodeCommand := fn(rootDir: String): Int {
    res := buildBenchmarkLeetcode(path.join(rootDir, "benchmark/challenges"));
    if not res.ok { io.errorLine("FAIL: " + res.error); return 1; }
    io.outputLine("wrote " + integer.intText(res.writtenCount) + " LeetCode items; total " + integer.intText(res.totalCount));
    0
};

trimEdgeNewlines := fn(raw: String): String {
    var s := 0;
    var e := text.length(raw);
    loop s < e and text.at(raw, s) == "\n" { s = s + 1; }
    loop e > s and text.at(raw, e - 1) == "\n" { e = e - 1; }
    text.slice(raw, s, e)
};

cleanSampleHtmlBlock := fn(sortedKeys: List<String>, sortedVals: List<String>, fragment: String): String {
    out: mut List<String> = [];
    size := text.length(fragment);
    var pos := 0;
    loop pos < size {
        lt := text.indexOfText(fragment, "<", pos);
        if lt < 0 {
            list.pushBack(mut out, text.slice(fragment, pos, size));
            break;
        }
        gt := text.indexOfText(fragment, ">", lt + 1);
        if gt < 0 {
            list.pushBack(mut out, text.slice(fragment, pos, size));
            break;
        }
        list.pushBack(mut out, text.slice(fragment, pos, lt));
        tag := asciiLower(text.trim(text.slice(fragment, lt + 1, gt)));
        if tag == "br" or tag == "br/" or tag == "br /" {
            list.pushBack(mut out, "\n");
        }
        pos = gt + 1;
    }
    trimEdgeNewlines(unescapeHtmlWithTable(sortedKeys, sortedVals, text.joinTexts(out, "")))
};

parseLeetcodeExampleCase := fn(rawText: String): (ok: Bool, input: String, output: String, hasExpl: Bool, expl: String) {
    normalized := text.trim(collapseCrLf(rawText));
    normLen := text.length(normalized);
    inPos := text.indexOfText(normalized, "Input:", 0);
    if inPos < 0 { return (ok = false, input = "", output = "", hasExpl = false, expl = ""); }
    var outPos := -1;
    var scan := inPos + 6;
    loop scan < normLen {
        nl := text.indexOfText(normalized, "\n", scan);
        if nl < 0 { break; }
        afterWs := skipHorizontalSpace(normalized, nl + 1);
        if text.startsWithAt(normalized, afterWs, "Output:") {
            outPos = afterWs;
            break;
        }
        scan = nl + 1;
    }
    if outPos < 0 { return (ok = false, input = "", output = "", hasExpl = false, expl = ""); }
    inVal := text.trim(text.slice(normalized, inPos + 6, outPos));

    var explPos := -1;
    var scan2 := outPos + 7;
    loop scan2 < normLen {
        nl := text.indexOfText(normalized, "\n", scan2);
        if nl < 0 { break; }
        afterWs := skipHorizontalSpace(normalized, nl + 1);
        if text.startsWithAt(normalized, afterWs, "Explanation:") {
            explPos = afterWs;
            break;
        }
        scan2 = nl + 1;
    }
    outVal := text.trim(text.slice(normalized, outPos + 7, if explPos >= 0 { explPos } else { normLen }));
    if inVal == "" or outVal == "" {
        return (ok = false, input = "", output = "", hasExpl = false, expl = "");
    }
    if explPos >= 0 {
        exVal := text.trim(text.slice(normalized, explPos + 12, normLen));
        return (ok = true, input = inVal, output = outVal, hasExpl = exVal =!= "", expl = exVal);
    }
    (ok = true, input = inVal, output = outVal, hasExpl = false, expl = "")
};

pub collapseCrLf := fn(raw: String): String {
    parts: mut List<String> = [];
    var seg := 0;
    var i := 0;
    size := text.length(raw);
    loop i < size {
        if text.at(raw, i) == "\r" {
            list.pushBack(mut parts, text.slice(raw, seg, i));
            list.pushBack(mut parts, "\n");
            if i + 1 < size and text.at(raw, i + 1) == "\n" { i = i + 1; }
            seg = i + 1;
        }
        i = i + 1;
    }
    if seg == 0 { return raw; }
    list.pushBack(mut parts, text.slice(raw, seg, size));
    text.joinTexts(parts, "")
};

skipHorizontalSpace := fn(raw: String, start: Int): Int {
    var p := start;
    loop p < text.length(raw) {
        ch := text.at(raw, p);
        if ch =!= " " and ch =!= "\t" { break; }
        p = p + 1;
    }
    p
};

extractBetweenPre := fn(section: String, startPos: Int): (found: Bool, inner: String, nextPos: Int) {
    openTag := text.indexOfText(section, "<pre>", startPos);
    if openTag < 0 { return (found = false, inner = "", nextPos = startPos); }
    closeTag := text.indexOfText(section, "</pre>", openTag + 5);
    if closeTag < 0 { return (found = false, inner = "", nextPos = startPos); }
    (found = true, inner = text.slice(section, openTag + 5, closeTag), nextPos = closeTag + 6)
};

challengeFormatName := fn(source: String, formats: List<String>): String {
    if source == "cses" or source == "atcoder" or source == "advent-of-code" or source == "rosalind" or source == "codeforces" { return "stdio"; }
    if source == "project-euler" { return "single-answer"; }
    if source == "cryptopals" { return "programming"; }
    if source == "jane-street" { return "puzzle"; }
    if list.listContainsText(formats, "sql") { return "sql"; }
    if list.listContainsText(formats, "shell") { return "shell"; }
    "function"
};

challengeMissingNote := fn(source: String, hasPage: Bool): String {
    if source == "codeforces" { return "Official samples are not retrievable: codeforces.com returns HTTP 403 to automated requests."; }
    if source == "project-euler" { return "Project Euler asks for one numeric answer; there is no input/output test contract."; }
    if source == "advent-of-code" { return "Puzzle inputs are per-user and examples are prose, so there are no canonical public test cases."; }
    if source == "cryptopals" { return "Fixed cryptographic exercises without a uniform stdin/stdout contract."; }
    if source == "jane-street" { return "One-off puzzle with no automated input/output contract."; }
    if not hasPage { return "Sample page was not downloaded; run tools/fetch_tests.ts."; }
    "No sample section found on the problem page."
};

buildCaseJsonObject := fn(name: String, kind: String, inputVal: String, outputVal: String, hasExpl: Bool, explVal: String): String {
    "{\"name\":" + json.quoteString(name) + ",\"kind\":" + json.quoteString(kind)
    + ",\"input\":" + json.quoteString(inputVal) + ",\"output\":" + json.quoteString(outputVal)
    + ",\"explanation\":" + (if hasExpl { json.quoteString(explVal) } else { "null" }) + "}"
};

/** Builds `data/tests.{jsonl,csv}` and updates `data/index.json` (`benchmark/challenges/tools/build_tests.ts`). */
pub buildChallengeTests := fn(challengesRootDir: String, entitiesJsonText: String): (ok: Bool, summaryText: String, error: String) {
    dataDir := path.join(challengesRootDir, "data");
    cacheDir := path.join(challengesRootDir, ".cache");
    chRead := fs.readText(path.join(dataDir, "challenges.jsonl"));
    if not chRead.ok { return (ok = false, summaryText = "", error = chRead.error); }
    mRead := fs.readText(path.join(cacheDir, "leetcode/merged.json"));
    if not mRead.ok { return (ok = false, summaryText = "", error = mRead.error); }

    entPairs := parseSortedStringObjectPairs(entitiesJsonText);
    entKeys: mut List<String> = [];
    entVals: mut List<String> = [];
    var epi := 0;
    loop epi + 1 < list.listCountText(entPairs) {
        list.pushBack(mut entKeys, entPairs[epi]);
        list.pushBack(mut entVals, entPairs[epi + 1]);
        epi = epi + 2;
    }

    qField := json.findObjectField(mRead.text, 0, "questions");
    qOffsets := json.arrayElementOffsets(mRead.text, qField.valuePos);
    qLookupKeys: mut List<String> = [];
    qLookupPos: mut List<Int> = [];
    loop qOffsets as qp {
        fidStr := json.readObjectString(mRead.text, qp, "frontend_id");
        fidKey := if fidStr.found and fidStr.ok { fidStr.value } else {
            fidInt := json.readObjectInt(mRead.text, qp, "frontend_id");
            if fidInt.found and fidInt.ok { integer.intText(fidInt.value) } else { "" }
        };
        slugKey := json.readObjectString(mRead.text, qp, "problem_slug").value;
        if fidKey =!= "" {
            list.pushBack(mut qLookupKeys, fidKey);
            list.pushBack(mut qLookupPos, qp);
        }
        if slugKey =!= "" {
            list.pushBack(mut qLookupKeys, slugKey);
            list.pushBack(mut qLookupPos, qp);
        }
    }
    qSortedOrder := sortIndexByKeys(qLookupKeys);
    qSortedKeys: mut List<String> = [];
    qSortedPos: mut List<Int> = [];
    loop qSortedOrder as qi {
        list.pushBack(mut qSortedKeys, qLookupKeys[qi]);
        list.pushBack(mut qSortedPos, qLookupPos[qi]);
    }

    chLines := splitJsonLines(chRead.text);
    recLines: mut List<String> = [];
    csvLines: mut List<String> = ["challenge_id,source,status,format,public_count,hidden_count,hidden_policy"];
    statusVals: mut List<String> = [];
    srcNames: mut List<String> = [];
    srcPubDocs: mut Map<String, Int>;
    srcHidDocs: mut Map<String, Int>;
    srcAllDocs: mut Map<String, Int>;
    srcPubCases: mut Map<String, Int>;
    srcHidCases: mut Map<String, Int>;

    var totalWithPub := 0;
    var totalWithHid := 0;
    var totalPubCases := 0;
    var totalHidCases := 0;
    writtenIds: mut List<String> = [];

    loop chLines as cl {
        cid := json.readObjectString(cl, 0, "id").value;
        curl := json.readObjectString(cl, 0, "url").value;
        source := json.readObjectString(cl, 0, "source").value;
        natId := json.readObjectString(cl, 0, "native_id").value;
        isPrem := json.readObjectBool(cl, 0, "premium").value;
        fmts := readStringArray(cl, 0, "formats");
        fmt := challengeFormatName(source, fmts);

        rawInputs: mut List<String> = [];
        rawOutputs: mut List<String> = [];
        rawHasExpl: mut List<Bool> = [];
        rawExpls: mut List<String> = [];
        var hasNote := false;
        var noteText := "";

        if source == "leetcode" {
            qHit := findSortedEntity(qSortedKeys, natId);
            if qHit >= 0 {
                qp := qSortedPos[qHit];
                exField := json.findObjectField(mRead.text, qp, "examples");
                if exField.found and isJsonArrayAt(mRead.text, exField.valuePos) {
                    loop json.arrayElementOffsets(mRead.text, exField.valuePos) as ep {
                        exTextRes := json.readObjectString(mRead.text, ep, "example_text");
                        if exTextRes.found and exTextRes.ok {
                            parsedEx := parseLeetcodeExampleCase(exTextRes.value);
                            if parsedEx.ok {
                                list.pushBack(mut rawInputs, parsedEx.input);
                                list.pushBack(mut rawOutputs, parsedEx.output);
                                list.pushBack(mut rawHasExpl, parsedEx.hasExpl);
                                list.pushBack(mut rawExpls, parsedEx.expl);
                            }
                        }
                    }
                }
            }
            if list.listCountText(rawInputs) == 0 {
                hasNote = true;
                noteText = if isPrem { "Premium problem; examples may require a subscription." } else { "No parseable examples in the public metadata mirror." };
            }
        } else if source == "cses" or source == "atcoder" or source == "rosalind" {
            htmlPath := path.join(cacheDir, "tests/" + source + "/" + cid + ".html");
            if fs.kind(htmlPath) == fs.FILE_KIND_FILE {
                page := readNormalizedText(htmlPath).text;
                if source == "cses" {
                    start := text.indexOfText(page, "id=\"example\"", 0);
                    if start >= 0 {
                        sec := text.slice(page, start, text.length(page));
                        var pos := 0;
                        loop true {
                            pIn := text.indexOfText(sec, "<p>Input:</p>", pos);
                            if pIn < 0 { break; }
                            preIn := extractBetweenPre(sec, pIn + 13);
                            if not preIn.found { break; }
                            afterIn := skipJsonSpace(sec, preIn.nextPos);
                            if text.startsWithAt(sec, afterIn, "<p>Output:</p>") {
                                preOut := extractBetweenPre(sec, afterIn + 14);
                                if preOut.found {
                                    ci := cleanSampleHtmlBlock(entKeys, entVals, preIn.inner);
                                    co := cleanSampleHtmlBlock(entKeys, entVals, preOut.inner);
                                    if text.trim(ci) =!= "" and text.trim(co) =!= "" {
                                        list.pushBack(mut rawInputs, ci);
                                        list.pushBack(mut rawOutputs, co);
                                        list.pushBack(mut rawHasExpl, false);
                                        list.pushBack(mut rawExpls, "");
                                    }
                                    pos = preOut.nextPos;
                                } else {
                                    pos = preIn.nextPos;
                                }
                            } else {
                                pos = preIn.nextPos;
                            }
                        }
                        if list.listCountText(rawInputs) == 0 {
                            p1 := extractBetweenPre(sec, 0);
                            if p1.found {
                                p2 := extractBetweenPre(sec, p1.nextPos);
                                if p2.found {
                                    ci := cleanSampleHtmlBlock(entKeys, entVals, p1.inner);
                                    co := cleanSampleHtmlBlock(entKeys, entVals, p2.inner);
                                    if text.trim(ci) =!= "" and text.trim(co) =!= "" {
                                        list.pushBack(mut rawInputs, ci);
                                        list.pushBack(mut rawOutputs, co);
                                        list.pushBack(mut rawHasExpl, false);
                                        list.pushBack(mut rawExpls, "");
                                    }
                                }
                            }
                        }
                    }
                } else if source == "atcoder" {
                    inNums: mut List<Int> = [];
                    inVals: mut List<String> = [];
                    outNums: mut List<Int> = [];
                    outVals: mut List<String> = [];
                    var pos := 0;
                    loop true {
                        h3 := text.indexOfText(page, "<h3>Sample Input ", pos);
                        if h3 < 0 { break; }
                        endH3 := text.indexOfText(page, "</h3>", h3 + 17);
                        if endH3 < 0 { break; }
                        nParsed := text.textToInt(text.slice(page, h3 + 17, endH3));
                        preR := extractBetweenPre(page, endH3 + 5);
                        if nParsed.ok and preR.found {
                            list.pushBack(mut inNums, nParsed.value);
                            list.pushBack(mut inVals, cleanSampleHtmlBlock(entKeys, entVals, preR.inner));
                            pos = preR.nextPos;
                        } else {
                            pos = endH3 + 5;
                        }
                    }
                    pos = 0;
                    loop true {
                        h3 := text.indexOfText(page, "<h3>Sample Output ", pos);
                        if h3 < 0 { break; }
                        endH3 := text.indexOfText(page, "</h3>", h3 + 18);
                        if endH3 < 0 { break; }
                        nParsed := text.textToInt(text.slice(page, h3 + 18, endH3));
                        preR := extractBetweenPre(page, endH3 + 5);
                        if nParsed.ok and preR.found {
                            list.pushBack(mut outNums, nParsed.value);
                            list.pushBack(mut outVals, cleanSampleHtmlBlock(entKeys, entVals, preR.inner));
                            pos = preR.nextPos;
                        } else {
                            pos = endH3 + 5;
                        }
                    }
                    inNumIdx: mut Map<Int, Int>;
                    var ini := 0;
                    loop inNums as n {
                        if not map.has(inNumIdx, n) { map.set(mut inNumIdx, n, ini); }
                        ini = ini + 1;
                    }
                    outNumIdx: mut Map<Int, Int>;
                    var outi := 0;
                    loop outNums as n {
                        if not map.has(outNumIdx, n) { map.set(mut outNumIdx, n, outi); }
                        outi = outi + 1;
                    }
                    sortedNums := list.sortInts(inNums);
                    loop sortedNums as n {
                        iIdx := map.getOr(inNumIdx, n, -1);
                        oIdx := map.getOr(outNumIdx, n, -1);
                        if iIdx >= 0 and oIdx >= 0 {
                            ci := inVals[iIdx];
                            co := outVals[oIdx];
                            if text.trim(ci) =!= "" and text.trim(co) =!= "" {
                                list.pushBack(mut rawInputs, ci);
                                list.pushBack(mut rawOutputs, co);
                                list.pushBack(mut rawHasExpl, false);
                                list.pushBack(mut rawExpls, "");
                            }
                        }
                    }
                } else {
                    sd := text.indexOfText(page, "<h2 id=\"sample-dataset\">", 0);
                    so := text.indexOfText(page, "<h2 id=\"sample-output\">", 0);
                    if sd >= 0 and so >= 0 {
                        preIn := extractBetweenPre(page, sd);
                        preOut := extractBetweenPre(page, so);
                        if preIn.found and preOut.found {
                            ci := cleanSampleHtmlBlock(entKeys, entVals, preIn.inner);
                            co := cleanSampleHtmlBlock(entKeys, entVals, preOut.inner);
                            if text.trim(ci) =!= "" and text.trim(co) =!= "" {
                                list.pushBack(mut rawInputs, ci);
                                list.pushBack(mut rawOutputs, co);
                                list.pushBack(mut rawHasExpl, false);
                                list.pushBack(mut rawExpls, "");
                            }
                        }
                    }
                }
                if list.listCountText(rawInputs) == 0 {
                    hasNote = true;
                    noteText = challengeMissingNote(source, true);
                }
            } else {
                hasNote = true;
                noteText = challengeMissingNote(source, false);
            }
        } else {
            hasNote = true;
            noteText = challengeMissingNote(source, false);
        }

        pubJsons: mut List<String> = [];
        hidJsons: mut List<String> = [];
        totalC := list.listCountText(rawInputs);
        var i := 0;
        loop i < totalC {
            cName := if i == 0 { (if fmt == "function" { "example-1" } else { "sample-1" }) } else { "held-out-" + integer.intText(i) };
            cKind := if i == 0 { (if fmt == "function" { "example" } else { "sample" }) } else { (if fmt == "function" { "held-out-example" } else { "held-out-sample" }) };
            hE := if i == 0 { rawHasExpl[i] } else { false };
            exV := if i == 0 { rawExpls[i] } else { "" };
            obj := buildCaseJsonObject(cName, cKind, rawInputs[i], rawOutputs[i], hE, exV);
            if i == 0 { list.pushBack(mut pubJsons, obj); } else { list.pushBack(mut hidJsons, obj); }
            i = i + 1;
        }

        pubN := list.listCountText(pubJsons);
        hidN := list.listCountText(hidJsons);
        notApp := source == "project-euler" or source == "advent-of-code" or source == "cryptopals" or source == "jane-street";
        st := if pubN > 0 { (if hidN > 0 { "public+hidden" } else { "public-only" }) } else if notApp { "not-applicable" } else { "none" };
        hidPol := if hidN > 0 { "held-out-official-samples" } else { "none" };
        list.pushBack(mut statusVals, st);

        if pubN > 0 { totalWithPub = totalWithPub + 1; }
        if hidN > 0 { totalWithHid = totalWithHid + 1; }
        totalPubCases = totalPubCases + pubN;
        totalHidCases = totalHidCases + hidN;

        if not map.has(srcAllDocs, source) {
            list.pushBack(mut srcNames, source);
        }
        map.set(mut srcAllDocs, source, map.getOr(srcAllDocs, source, 0) + 1);
        map.set(mut srcPubDocs, source, map.getOr(srcPubDocs, source, 0) + (if pubN > 0 { 1 } else { 0 }));
        map.set(mut srcHidDocs, source, map.getOr(srcHidDocs, source, 0) + (if hidN > 0 { 1 } else { 0 }));
        map.set(mut srcPubCases, source, map.getOr(srcPubCases, source, 0) + pubN);
        map.set(mut srcHidCases, source, map.getOr(srcHidCases, source, 0) + hidN);

        recJson := "{\"challenge_id\":" + json.quoteString(cid)
        + ",\"url\":" + json.quoteString(curl)
        + ",\"source\":" + json.quoteString(source)
        + ",\"format\":" + json.quoteString(fmt)
        + ",\"status\":" + json.quoteString(st)
        + ",\"public\":[" + text.joinTexts(pubJsons, ",") + "]"
        + ",\"hidden\":[" + text.joinTexts(hidJsons, ",") + "]"
        + ",\"hidden_policy\":" + json.quoteString(hidPol)
        + ",\"note\":" + (if hasNote { json.quoteString(noteText) } else { "null" }) + "}";
        list.pushBack(mut recLines, recJson);
        list.pushBack(mut writtenIds, cid);

        csvRow := csvEscapeField(cid) + "," + csvEscapeField(source) + "," + csvEscapeField(st) + ","
        + csvEscapeField(fmt) + "," + integer.intText(pubN) + "," + integer.intText(hidN) + "," + csvEscapeField(hidPol);
        list.pushBack(mut csvLines, csvRow);
    }

    sortedRecIds := sortTexts(writtenIds);
    nRec := list.listCountText(recLines);
    if nRec =!= list.listCountText(chLines) {
        return (ok = false, summaryText = "", error = "test/challenge id mismatch");
    }
    var di := 1;
    loop di < nRec {
        if sortedRecIds[di] == sortedRecIds[di - 1] {
            return (ok = false, summaryText = "", error = "test/challenge id mismatch");
        }
        di = di + 1;
    }

    wJsonl := fs.writeText(path.join(dataDir, "tests.jsonl"), if nRec == 0 { "" } else { text.joinTexts(recLines, "\n") + "\n" });
    if not wJsonl.ok { return (ok = false, summaryText = "", error = wJsonl.error); }
    wCsv := fs.writeText(path.join(dataDir, "tests.csv"), text.joinTexts(csvLines, "\r\n") + "\r\n");
    if not wCsv.ok { return (ok = false, summaryText = "", error = wCsv.error); }

    sortedSrcOrder := sortIndexByKeys(srcNames);
    bySourceEntries: mut List<String> = [];
    summaryLines: mut List<String> = [
    "wrote " + integer.intText(nRec) + " test records",
    "  with public cases: " + integer.intText(totalWithPub),
    "  with hidden cases: " + integer.intText(totalWithHid),
    "  public cases: " + integer.intText(totalPubCases) + "  hidden cases: " + integer.intText(totalHidCases),
    ];
    loop sortedSrcOrder as sIdx {
        sName := srcNames[sIdx];
        entry := json.quoteString(sName) + ":{\"challenges\":" + integer.intText(map.getOr(srcAllDocs, sName, 0))
        + ",\"with_public\":" + integer.intText(map.getOr(srcPubDocs, sName, 0))
        + ",\"with_hidden\":" + integer.intText(map.getOr(srcHidDocs, sName, 0))
        + ",\"public_cases\":" + integer.intText(map.getOr(srcPubCases, sName, 0))
        + ",\"hidden_cases\":" + integer.intText(map.getOr(srcHidCases, sName, 0)) + "}";
        list.pushBack(mut bySourceEntries, entry);
        list.pushBack(mut summaryLines, "  " + padRight(sName, 16) + " public " + padLeft(integer.intText(map.getOr(srcPubDocs, sName, 0)), 5) + "  hidden " + padLeft(integer.intText(map.getOr(srcHidDocs, sName, 0)), 5));
    }

    idxPath := path.join(dataDir, "index.json");
    if fs.kind(idxPath) == fs.FILE_KIND_FILE {
        idxRead := fs.readText(idxPath);
        if idxRead.ok and json.validate(idxRead.text).ok and isJsonObjectAt(idxRead.text, 0) {
            testsSummaryObj := "{\n    \"total\": " + integer.intText(nRec) + ",\n"
            + "    \"with_public\": " + integer.intText(totalWithPub) + ",\n"
            + "    \"with_hidden\": " + integer.intText(totalWithHid) + ",\n"
            + "    \"public_cases\": " + integer.intText(totalPubCases) + ",\n"
            + "    \"hidden_cases\": " + integer.intText(totalHidCases) + ",\n"
            + "    \"by_status\": " + formatSortedCountsJson(statusVals) + ",\n"
            + "    \"by_source\": {" + text.joinTexts(bySourceEntries, ",") + "}\n  }";
            topFields: mut List<String> = [];
            loop json.objectKeys(idxRead.text, 0) as tk {
                if tk =!= "tests" {
                    f := json.findObjectField(idxRead.text, 0, tk);
                    sp := json.valueSpan(idxRead.text, f.valuePos);
                    if sp.ok {
                        list.pushBack(mut topFields, "  " + json.quoteString(tk) + ": " + text.slice(idxRead.text, sp.start, sp.end));
                    }
                }
            }
            list.pushBack(mut topFields, "  \"tests\": " + testsSummaryObj);
            _wi := fs.writeText(idxPath, "{\n" + text.joinTexts(topFields, ",\n") + "\n}\n");
        }
    }

    (ok = true, summaryText = text.joinTexts(summaryLines, "\n"), error = "")
};

/** CLI runner for `benchmark/challenges/tools/build_tests.ts`. */
pub runBuildTestsCommand := fn(rootDir: String): Int {
    chRoot := path.join(rootDir, "benchmark/challenges");
    entRead := fs.readText(path.join(chRoot, "tools/html-entities.json"));
    if not entRead.ok { io.errorLine("FAIL: " + entRead.error); return 1; }
    res := buildChallengeTests(chRoot, entRead.text);
    if not res.ok { io.errorLine("FAIL: " + res.error); return 1; }
    io.outputLine(res.summaryText);
    0
};
