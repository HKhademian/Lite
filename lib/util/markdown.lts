/** Provisional Markdown parsing, heading/anchor extraction, link scanning, and fence checks. */

integer := import "core/int";
text := import "core/text";
list := import "core/list";
map := import "core/map";
set := import "core/set";
tb := import "util/text-builder";

findLineEnd := fn(source: String, start: Int, size: Int): Int {
    idx := text.indexOfText(source, "\n", start);
    if idx < 0 { size } else { idx }
}

isBlankRest := fn(source: String, fromPos: Int, lineEnd: Int): Bool {
    var i := fromPos;
    loop i < lineEnd {
        if not text.isWhitespace(text.at(source, i)) { return false; }
        i = i + 1;
    }
    true
}

countRepeatedAt := fn(source: String, start: Int, limit: Int, ch: String): Int {
    var count := 0;
    loop start + count < limit and text.at(source, start + count) == ch {
        count = count + 1;
    }
    count
}

/** Removes fenced code blocks delimited at column 0 (` ``` ` or `~~~`) so prose scanners skip example code. */
pub stripCodeBlocks := fn(source: String): String {
    if text.indexOfText(source, "```", 0) < 0 and text.indexOfText(source, "~~~", 0) < 0 {
        return source;
    }
    size := text.length(source);
    out: mut tb.TextBuilder;
    var runStart := 0;
    var pos := 0;
    var inFence := false;
    var fenceChar := "";
    var fenceLen := 0;
    var fenceStart := 0;

    loop pos <= size {
        lineEnd := findLineEnd(source, pos, size);
        if not inFence {
            if pos < size {
                ch := text.at(source, pos);
                if ch == "`" or ch == "~" {
                    cnt := countRepeatedAt(source, pos, lineEnd, ch);
                    if cnt >= 3 {
                        if pos > runStart {
                            tb.append(mut out, text.slice(source, runStart, pos));
                        }
                        inFence = true;
                        fenceChar = ch;
                        fenceLen = cnt;
                        fenceStart = pos;
                    }
                }
            }
        } else {
            if pos + fenceLen <= lineEnd {
                matches := countRepeatedAt(source, pos, lineEnd, fenceChar);
                if matches == fenceLen and isBlankRest(source, pos + fenceLen, lineEnd) {
                    inFence = false;
                    fenceChar = "";
                    fenceLen = 0;
                    runStart = lineEnd;
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }

    if inFence {
        tb.append(mut out, text.slice(source, fenceStart, size));
    } else if runStart < size {
        tb.append(mut out, text.slice(source, runStart, size));
    }
    tb.build(out)
}

/** True when `source` leaves a fenced code block (with up to 3 leading spaces) unclosed at EOF. */
pub hasUnclosedFence := fn(source: String): Bool {
    if text.indexOfText(source, "```", 0) < 0 and text.indexOfText(source, "~~~", 0) < 0 {
        return false;
    }
    size := text.length(source);
    var pos := 0;
    var fenceChar := "";
    var fenceLen := 0;

    loop pos < size {
        lineEnd := findLineEnd(source, pos, size);
        var lead := pos;
        var spaces := 0;
        loop lead < lineEnd and spaces < 3 and text.isWhitespace(text.at(source, lead)) {
            lead = lead + 1;
            spaces = spaces + 1;
        }
        if lead < lineEnd {
            ch := text.at(source, lead);
            if ch == "`" or ch == "~" {
                cnt := countRepeatedAt(source, lead, lineEnd, ch);
                if cnt >= 3 {
                    if fenceLen == 0 {
                        fenceChar = ch;
                        fenceLen = cnt;
                    } else if ch == fenceChar and cnt >= fenceLen {
                        fenceChar = "";
                        fenceLen = 0;
                    }
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    fenceLen > 0
}

/** Extracts ATX headings (`#`..`######`) from already code-stripped prose. */
pub extractHeadings := fn(proseText: String): List<String> {
    headings: mut List<String> = [];
    if text.indexOfText(proseText, "#", 0) < 0 { return headings; }
    size := text.length(proseText);
    var pos := 0;
    loop pos < size {
        lineEnd := findLineEnd(proseText, pos, size);
        var cleanEnd := lineEnd;
        if cleanEnd > pos and text.at(proseText, cleanEnd - 1) == "\r" {
            cleanEnd = cleanEnd - 1;
        }
        hashes := countRepeatedAt(proseText, pos, cleanEnd, "#");
        if hashes >= 1 and hashes <= 6 and pos + hashes < cleanEnd {
            afterHash := text.at(proseText, pos + hashes);
            if afterHash == " " or afterHash == "\t" {
                var bodyStart := pos + hashes + 1;
                loop bodyStart < cleanEnd and text.isWhitespace(text.at(proseText, bodyStart)) {
                    bodyStart = bodyStart + 1;
                }
                var bodyEnd := cleanEnd;
                loop bodyEnd > bodyStart and text.isWhitespace(text.at(proseText, bodyEnd - 1)) {
                    bodyEnd = bodyEnd - 1;
                }
                loop bodyEnd > bodyStart and text.at(proseText, bodyEnd - 1) == "#" {
                    bodyEnd = bodyEnd - 1;
                }
                loop bodyEnd > bodyStart and text.isWhitespace(text.at(proseText, bodyEnd - 1)) {
                    bodyEnd = bodyEnd - 1;
                }
                if bodyEnd > bodyStart {
                    list.pushBack(mut headings, text.slice(proseText, bodyStart, bodyEnd));
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    headings
}

stripHtmlTags := fn(source: String): String {
    size := text.length(source);
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        open := text.indexOfText(source, "<", i);
        if open < 0 { break; }
        close := text.indexOfText(source, ">", open + 1);
        if close >= 0 {
            if open > runStart { tb.append(mut out, text.slice(source, runStart, open)); }
            i = close + 1;
            runStart = i;
        } else {
            i = open + 1;
        }
    }
    if runStart == 0 { return source; }
    if runStart < size { tb.append(mut out, text.slice(source, runStart, size)); }
    tb.build(out)
}

isAsciiPrintablePunct := fn(ch: String): Bool {
    text.containsText("!\"#$%&'()*+,./:;<=>?@[\\]^`{|}~", ch)
}

isUnicodeNonWordSymbol := fn(ch: String): Bool {
    text.containsText("—–…“”‘’•·×°§→←↔«»‹›", ch)
}

/** GitHub-style heading slug for fragment matching. */
pub headingAnchor := fn(heading: String): String {
    cleaned := stripHtmlTags(text.toLowerAscii(heading));
    size := text.length(cleaned);
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        ch := text.at(cleaned, i);
        if text.isWhitespace(ch) {
            if i > runStart { tb.append(mut out, text.slice(cleaned, runStart, i)); }
            tb.append(mut out, "-");
            runStart = i + 1;
        } else if ch == "_" or ch == "-" or text.isAsciiLetter(ch) or text.isDigit(ch) {
        } else if isAsciiPrintablePunct(ch) or isUnicodeNonWordSymbol(ch) {
            if i > runStart { tb.append(mut out, text.slice(cleaned, runStart, i)); }
            runStart = i + 1;
        }
        i = i + 1;
    }
    if runStart == 0 { return cleaned; }
    if runStart < size { tb.append(mut out, text.slice(cleaned, runStart, size)); }
    tb.build(out)
}

/** Collects GitHub-style heading anchors (including `-1`, `-2` duplicate suffixes) and explicit HTML `id=`/`name=` anchors. */
pub collectAnchors := fn(docText: String): List<String> {
    found: mut List<String> = [];
    foundSet: mut Set<String>;
    slugCounts: mut Map<String, Int>;
    headings := extractHeadings(stripCodeBlocks(docText));

    loop headings as heading {
        slug := headingAnchor(heading);
        dupCount := map.getOr(slugCounts, slug, 0);
        map.set(mut slugCounts, slug, dupCount + 1);
        anchor := if dupCount == 0 { slug } else { slug + "-" + integer.intText(dupCount) };
        if not set.has(foundSet, anchor) {
            set.add(mut foundSet, anchor);
            list.pushBack(mut found, anchor);
        }
    }

    if text.indexOfText(docText, "id=", 0) < 0 and text.indexOfText(docText, "name=", 0) < 0 {
        return found;
    }
    size := text.length(docText);
    var pos := 0;
    loop pos < size {
        eq := text.indexOfText(docText, "=", pos);
        if eq < 0 { break; }
        var isMatch := false;
        if eq - 2 >= pos and text.startsWithAt(docText, eq - 2, "id=") {
            isMatch = eq - 2 == 0 or not text.isNameContinue(text.at(docText, eq - 3));
        } else if eq - 4 >= pos and text.startsWithAt(docText, eq - 4, "name=") {
            isMatch = eq - 4 == 0 or not text.isNameContinue(text.at(docText, eq - 5));
        }
        if isMatch and eq + 1 < size {
            q := text.at(docText, eq + 1);
            if q == "\"" or q == "'" {
                valStart := eq + 2;
                valEnd := text.indexOfText(docText, q, valStart);
                if valEnd > valStart {
                    val := text.slice(docText, valStart, valEnd);
                    if not set.has(foundSet, val) {
                        set.add(mut foundSet, val);
                        list.pushBack(mut found, val);
                    }
                    pos = valEnd + 1;
                } else {
                    pos = eq + 1;
                }
            } else {
                pos = eq + 1;
            }
        } else {
            pos = eq + 1;
        }
    }
    found
}

stripInlineCode := fn(proseText: String): String {
    size := text.length(proseText);
    out: mut tb.TextBuilder;
    var runStart := 0;
    var pos := 0;
    loop pos < size {
        tickPos := text.indexOfText(proseText, "`", pos);
        if tickPos < 0 { break; }
        ticks := countRepeatedAt(proseText, tickPos, size, "`");
        closeNeedle := text.repeatText("`", ticks);
        lineEnd := findLineEnd(proseText, tickPos + ticks, size);
        closeAt := text.indexOfText(proseText, closeNeedle, tickPos + ticks);
        if closeAt >= 0 and closeAt + ticks <= lineEnd {
            if tickPos > runStart { tb.append(mut out, text.slice(proseText, runStart, tickPos)); }
            pos = closeAt + ticks;
            runStart = pos;
        } else {
            pos = tickPos + ticks;
        }
    }
    if runStart == 0 { return proseText; }
    if runStart < size { tb.append(mut out, text.slice(proseText, runStart, size)); }
    tb.build(out)
}

/** Extracts inline Markdown link and image destination targets from code-stripped prose. */
pub extractLinkTargets := fn(proseText: String): List<String> {
    links: mut List<String> = [];
    if text.indexOfText(proseText, "](", 0) < 0 { return links; }
    clean := stripInlineCode(proseText);
    size := text.length(clean);
    var pos := 0;

    loop pos < size {
        openPos := text.indexOfText(clean, "[", pos);
        if openPos < 0 { break; }
        labelEnd := text.indexOfText(clean, "]", openPos + 1);
        if labelEnd < 0 { break; }
        nlPos := text.indexOfText(clean, "\n", openPos + 1);
        if (nlPos < 0 or labelEnd < nlPos) and labelEnd + 1 < size and text.at(clean, labelEnd + 1) == "(" {
            var targetStart := labelEnd + 2;
            if targetStart < size {
                if text.at(clean, targetStart) == "<" {
                    gtPos := text.indexOfText(clean, ">", targetStart + 1);
                    if gtPos > targetStart + 1 {
                        var afterGt := gtPos + 1;
                        var validClose := afterGt < size and text.at(clean, afterGt) == ")";
                        if not validClose and afterGt < size and text.isWhitespace(text.at(clean, afterGt)) {
                            loop afterGt < size and text.isWhitespace(text.at(clean, afterGt)) {
                                afterGt = afterGt + 1;
                            }
                            if afterGt < size and text.at(clean, afterGt) == "\"" {
                                titleEnd := text.indexOfText(clean, "\"", afterGt + 1);
                                if titleEnd >= 0 and titleEnd + 1 < size and text.at(clean, titleEnd + 1) == ")" {
                                    afterGt = titleEnd + 1;
                                    validClose = true;
                                }
                            }
                        }
                        if validClose {
                            list.pushBack(mut links, text.slice(clean, targetStart + 1, gtPos));
                            pos = afterGt + 1;
                        } else {
                            pos = openPos + 1;
                        }
                    } else {
                        pos = openPos + 1;
                    }
                } else {
                    var targetEnd := targetStart;
                    loop targetEnd < size and not text.isWhitespace(text.at(clean, targetEnd)) and text.at(clean, targetEnd) =!= ")" {
                        targetEnd = targetEnd + 1;
                    }
                    if targetEnd > targetStart and targetEnd < size {
                        var afterTarget := targetEnd;
                        var validClose := text.at(clean, afterTarget) == ")";
                        if not validClose and text.isWhitespace(text.at(clean, afterTarget)) {
                            loop afterTarget < size and text.isWhitespace(text.at(clean, afterTarget)) {
                                afterTarget = afterTarget + 1;
                            }
                            if afterTarget < size and text.at(clean, afterTarget) == "\"" {
                                titleEnd := text.indexOfText(clean, "\"", afterTarget + 1);
                                if titleEnd >= 0 and titleEnd + 1 < size and text.at(clean, titleEnd + 1) == ")" {
                                    afterTarget = titleEnd + 1;
                                    validClose = true;
                                }
                            }
                        }
                        if validClose {
                            list.pushBack(mut links, text.slice(clean, targetStart, targetEnd));
                            pos = afterTarget + 1;
                        } else {
                            pos = openPos + 1;
                        }
                    } else {
                        pos = openPos + 1;
                    }
                }
            } else {
                pos = openPos + 1;
            }
        } else {
            pos = openPos + 1;
        }
    }
    links
}

/** Extracts bodies of backtick fences delimited at column 0 (` ``` `) in document order. */
pub extractBacktickFenceBodies := fn(docText: String): List<String> {
    bodies: mut List<String> = [];
    if text.indexOfText(docText, "```", 0) < 0 { return bodies; }
    size := text.length(docText);
    var pos := 0;
    var inFence := false;
    var bodyStart := 0;

    loop pos <= size {
        lineEnd := findLineEnd(docText, pos, size);
        if text.startsWithAt(docText, pos, "```") {
            if not inFence {
                if lineEnd < size {
                    inFence = true;
                    bodyStart = lineEnd + 1;
                }
            } else {
                list.pushBack(mut bodies, text.slice(docText, bodyStart, pos));
                inFence = false;
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    bodies
}
