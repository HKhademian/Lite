/** Byte-exact stream descriptor validation, hashing, and byte extraction for case manifests. */

crypto := import "core/crypto";
fs := import "core/file";
unicode := import "core/unicode";
list := import "core/list";
path := import "core/path";
json := import "util/json";

isHex64 := fn(value: String): Bool {
    if value.length() =!= 64 { return false; }
    var i := 0;
    loop i < 64 {
        ch := value.at(i);
        ok := ch.isDigit() or ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f";
        if not ok { return false; }
        i = i + 1;
    }
    true
}

isSiblingFileName := fn(name: String): Bool {
    size := name.length();
    if size == 0 { return false; }
    first := name.at(0);
    if not (first.isAsciiLetter() or first.isDigit()) { return false; }
    var i := 1;
    loop i < size {
        ch := name.at(i);
        ok := ch.isAsciiLetter() or ch.isDigit() or ch == "." or ch == "_" or ch == "-";
        if not ok { return false; }
        i = i + 1;
    }
    true
}

isJsonPrefixAt := fn(source: String, start: Int, prefix: String): Bool {
    pos := source.skipSpaces(start);
    source.startsWithAt(pos, prefix)
}

parseBytesArray := fn(source: String, arrayPos: Int, label: String): (ok: Bool, error: String) {
    if not isJsonPrefixAt(source, arrayPos, "[") {
        return (ok = false, error = label + ".bytes must contain integers 0-255");
    }
    offsets := json.arrayElementOffsets(source, arrayPos);
    loop offsets as bPos {
        byteRes := json.readIntAt(source, bPos);
        if not byteRes.ok or byteRes.value < 0 or byteRes.value > 255 {
            return (ok = false, error = label + ".bytes must contain integers 0-255");
        }
    }
    (ok = true, error = "")
}

collectBytesArray := fn(source: String, arrayPos: Int): List<Int> {
    out: mut List<Int> = [];
    offsets := json.arrayElementOffsets(source, arrayPos);
    loop offsets as bPos {
        byteRes := json.readIntAt(source, bPos);
        mut out.pushBack(byteRes.value);
    }
    out
}

/** Validates one JSON stream descriptor at `streamPos` and returns `(ok, sha256, kind, error)`. */
pub validateStream := fn(
source: String,
streamPos: Int,
directory: String,
label: String,
requiredHash: Bool,
siblingOnly: Bool,
checkHash: Bool
): (ok: Bool, sha256: String, kind: String, error: String) {
    if not isJsonPrefixAt(source, streamPos, "{") {
        return (ok = false, sha256 = "", kind = "", error = label + ": stream must be an object");
    }
    keys := json.objectKeys(source, streamPos);
    allowed: List<String> = ["text", "bytes", "file", "hash"];
    var form := "";
    var formCount := 0;
    loop keys as k {
        if not list.listContainsText(allowed, k) {
            return (ok = false, sha256 = "", kind = "", error = label + ": unexpected stream key");
        }
        if k =!= "hash" {
            form = k;
            formCount = formCount + 1;
        }
    }
    if formCount =!= 1 {
        return (ok = false, sha256 = "", kind = "", error = label + ": exactly one of text, bytes or file required");
    }

    var digest := "";
    if form == "text" {
        tRes := json.readObjectString(source, streamPos, "text");
        if not tRes.ok { return (ok = false, sha256 = "", kind = "", error = label + ".text must be a string"); }
        digest = "sha256:" + crypto.sha256Text(tRes.value);
    } else if form == "bytes" {
        bField := json.findObjectField(source, streamPos, "bytes");
        parsed := parseBytesArray(source, bField.valuePos, label);
        if not parsed.ok { return (ok = false, sha256 = "", kind = "", error = parsed.error); }
        digest = "sha256:" + crypto.sha256Bytes(collectBytesArray(source, bField.valuePos));
    } else {
        fRes := json.readObjectString(source, streamPos, "file");
        if not fRes.ok or fRes.value == "" or (siblingOnly and not isSiblingFileName(fRes.value)) {
            kindMsg := if siblingOnly { "a sibling file name" } else { "a nonempty file path" };
            return (ok = false, sha256 = "", kind = "", error = label + ".file must be " + kindMsg);
        }
        fullFile := path.resolve(directory, fRes.value);
        if fs.kind(fullFile) =!= fs.FILE_KIND_FILE {
            return (ok = false, sha256 = "", kind = "", error = label + ".file missing: " + fullFile);
        }
        fHash := crypto.sha256File(fullFile);
        if not fHash.ok {
            return (ok = false, sha256 = "", kind = "", error = label + ".file hash failed: " + fHash.error);
        }
        digest = "sha256:" + fHash.hex;
    }

    hashField := json.findObjectField(source, streamPos, "hash");
    if requiredHash or hashField.found {
        var validHash := false;
        var hashValue := "";
        if hashField.found {
            hStr := json.readStringAt(source, hashField.valuePos);
            if hStr.ok and hStr.value.startsWithAt(0, "sha256:") {
                hexPart := hStr.value.slice(7, hStr.value.length());
                if isHex64(hexPart) {
                    validHash = true;
                    hashValue = hStr.value;
                }
            }
        }
        if not validHash {
            return (ok = false, sha256 = "", kind = "", error = label + ".hash must be sha256:<64 lowercase hex>");
        }
        if checkHash and hashValue =!= digest {
            return (ok = false, sha256 = "", kind = "", error = label + ".hash does not match content");
        }
    }
    (ok = true, sha256 = digest, kind = form, error = "")
}

/** Reads the raw `0..255` byte list of a validated stream descriptor at `streamPos`. */
pub readStreamBytes := fn(source: String, streamPos: Int, directory: String): List<Int> {
    if json.findObjectField(source, streamPos, "text").found {
        tRes := json.readObjectString(source, streamPos, "text");
        return unicode.utf8Encode(tRes.value);
    }
    bField := json.findObjectField(source, streamPos, "bytes");
    if bField.found {
        return collectBytesArray(source, bField.valuePos);
    }
    fRes := json.readObjectString(source, streamPos, "file");
    fs.readBytes(path.resolve(directory, fRes.value))
}

/** Returns true when `left` and `right` contain identical byte sequences. */
pub equalBytes := fn(left: List<Int>, right: List<Int>): Bool {
    n := left.length();
    if n =!= right.length() { return false; }
    var i := 0;
    loop i < n {
        if left[i] =!= right[i] { return false; }
        i = i + 1;
    }
    true
}
