/** Offline documentation discovery, search formatting, and Markdown integrity verification. */

fs := import "core/file";
text := import "core/text";
list := import "core/list";
path := import "core/path";
json := import "util/json";
md := import "util/markdown";
docgen := import "util/docgen";
tb := import "util/text-builder";

/** Default directory names excluded when discovering repository Markdown files. */
pub defaultIgnoredDirs := fn(): List<String> {
    dirs: List<String> = [".git", ".cache", "node_modules", "dist", ".agent"];
    dirs
}

/** Collects sorted Markdown file paths under `directory`, ignoring VCS/build/cache folders. */
pub listDocFiles := fn(directory: String): List<String> {
    targets: List<String> = [directory];
    path.collectFiles(directory, targets, ".md", defaultIgnoredDirs(), false)
}

isSchemeChar := fn(ch: String): Bool {
    ch.isAsciiLetter() or ch.isDigit() or ch == "+" or ch == "." or ch == "-"
}

isExternalUri := fn(target: String): Bool {
    if target.startsWithAt(0, "//") { return true; }
    size := target.length();
    if size < 2 or not target.at(0).isAsciiLetter() { return false; }
    var i := 1;
    loop i < size {
        ch := target.at(i);
        if ch == ":" { return true; }
        if not isSchemeChar(ch) { return false; }
        i = i + 1;
    }
    false
}

isHex := fn(ch: String): Bool {
    ch.isDigit() or
    ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or
    ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F"
}

hexVal := fn(ch: String): Int {
    if ch.isDigit() { return ch.digitValue(); }
    lower := ch.toLowerAscii();
    if lower == "a" { return 10; }
    if lower == "b" { return 11; }
    if lower == "c" { return 12; }
    if lower == "d" { return 13; }
    if lower == "e" { return 14; }
    15
}

asciiChar := fn(code: Int): String {
    if code >= 32 and code <= 126 {
        table := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        return table.at(code - 32);
    }
    ""
}

decodePercentUri := fn(target: String): (ok: Bool, value: String) {
    size := target.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        if target.at(i) == "%" {
            if i + 2 >= size or not isHex(target.at(i + 1)) or not isHex(target.at(i + 2)) {
                return (ok = false, value = "");
            }
            code := hexVal(target.at(i + 1)) * 16 + hexVal(target.at(i + 2));
            if i > runStart { tb.append(mut out, target.slice(runStart, i)); }
            decoded := asciiChar(code);
            if decoded =!= "" {
                tb.append(mut out, decoded);
            } else if code < 128 {
                if code == 9 { tb.append(mut out, "\t"); }
                else if code == 10 { tb.append(mut out, "\n"); }
                else if code == 13 { tb.append(mut out, "\r"); }
                else { return (ok = false, value = ""); }
            } else {
                tb.append(mut out, target.slice(i, i + 3));
            }
            i = i + 3;
            runStart = i;
        } else {
            i = i + 1;
        }
    }
    if runStart == 0 { return (ok = true, value = target); }
    if runStart < size { tb.append(mut out, target.slice(runStart, size)); }
    (ok = true, value = tb.build(out))
}

dropFirstLines := fn(source: String, skipLines: Int): String {
    if skipLines <= 0 { return source; }
    size := source.length();
    var pos := 0;
    var skipped := 0;
    loop pos < size and skipped < skipLines {
        if source.at(pos) == "\n" {
            skipped = skipped + 1;
        }
        pos = pos + 1;
    }
    if skipped < skipLines { return ""; }
    source.slice(pos, size)
}

packAnchors := fn(anchors: List<String>): String {
    if anchors.length() == 0 { return "\n"; }
    "\n" + text.joinTexts(anchors, "\n") + "\n"
}

isLiteUri := fn(target: String): Bool {
    target.startsWithAt(0, "lite://") or target.startsWithAt(0, "lite:/")
};

stripSuffix := fn(value: String, suffix: String): String {
    if value.endsWith(suffix) {
        value.slice(0, value.length() - suffix.length())
    } else {
        value
    }
};

trimSlashes := fn(raw: String): String {
    var start := 0;
    var end := raw.length();
    loop start < end and raw.at(start) == "/" { start = start + 1; }
    loop end > start and raw.at(end - 1) == "/" { end = end - 1; }
    raw.slice(start, end)
};

parseLiteUri := fn(rawTarget: String): (ok: Bool, ns: String, target: String, fragment: String, error: String) {
    rest0 := if rawTarget.startsWithAt(0, "lite://") {
        rawTarget.slice(7, rawTarget.length())
    } else {
        rawTarget.slice(6, rawTarget.length())
    };
    hashPos := rest0.indexOf("#", 0);
    bodyRaw := if hashPos < 0 { rest0 } else { rest0.slice(0, hashPos) };
    fragment := if hashPos < 0 { "" } else { rest0.slice(hashPos + 1, rest0.length()) };
    body := trimSlashes(bodyRaw);
    if body == "" {
        return (ok = false, ns = "", target = "", fragment = fragment, error = "empty lite URI " + rawTarget);
    }
    slashPos := body.indexOf("/", 0);
    rawNs := (if slashPos < 0 { body } else { body.slice(0, slashPos) }).toLowerAscii();
    var target := if slashPos < 0 { "" } else { trimSlashes(body.slice(slashPos + 1, body.length())) };
    var ns := "";
    if rawNs == "handbook" {
        ns = "handbook";
    } else if rawNs == "brand" or rawNs == "branding" {
        ns = "brand";
    } else if rawNs == "doc" or rawNs == "docs" {
        if target == "handbook" {
            ns = "handbook";
            target = "";
        } else if target.startsWithAt(0, "handbook/") {
            ns = "handbook";
            target = target.slice(9, target.length());
        } else if target == "brand" {
            ns = "brand";
            target = "";
        } else if target.startsWithAt(0, "brand/") {
            ns = "brand";
            target = target.slice(6, target.length());
        } else {
            ns = "doc";
        }
    } else if rawNs == "spec" {
        ns = "doc";
        cleanSpec := stripSuffix(stripSuffix(target, ".html"), ".md");
        if cleanSpec == "" or cleanSpec == "overview" or cleanSpec == "README" {
            target = "spec-overview";
        } else if cleanSpec == "index" {
            target = "spec";
        } else if not target.startsWithAt(0, "spec/") {
            target = "spec/" + target;
        }
    } else if rawNs == "proposal" or rawNs == "proposals" {
        ns = "doc";
        if target == "" {
            target = "proposals/README";
        } else if not target.startsWithAt(0, "proposals/") {
            target = "proposals/" + target;
        }
    } else if rawNs == "compiler" {
        ns = "doc";
        cleanComp := stripSuffix(stripSuffix(target, ".html"), ".md");
        if cleanComp == "" or cleanComp == "overview" or cleanComp == "README" {
            target = "compiler/overview";
        } else if not target.startsWithAt(0, "compiler/") {
            target = "compiler/" + target;
        }
    } else if rawNs == "repo" {
        ns = "repo";
    } else if rawNs == "learn" {
        ns = "learn";
    } else if rawNs == "gym" {
        ns = "gym";
    } else if rawNs == "play" or rawNs == "playground" {
        ns = "play";
    } else if rawNs == "module" or rawNs == "modules" {
        ns = "module";
    } else if rawNs == "tool" or rawNs == "tools" {
        ns = "tool";
    } else if rawNs == "gallery" {
        ns = "gallery";
    } else {
        return (ok = false, ns = "", target = "", fragment = fragment, error = "unknown lite URI namespace '" + rawNs + "' in " + rawTarget);
    }
    (ok = true, ns = ns, target = target, fragment = fragment, error = "")
};

checkFragmentInMd := fn(
destination: String, fragment: String,
anchorCache: mut Map<String, String>
): Bool {
    if fragment == "" { return true; }
    cached := anchorCache.get(destination);
    packed := if cached.found {
        cached.value
    } else {
        targetRead := fs.readText(destination);
        built := if targetRead.ok { packAnchors(md.collectAnchors(targetRead.text)) } else { "\n" };
        mut anchorCache.set(destination, built);
        built
    };
    packed.contains("\n" + fragment + "\n")
};

handbookSourceForSlug := fn(slug: String): String {
    hbSlugs: List<String> = [
    "overview-and-setup", "bindings-and-mutability", "numbers-operators-and-strings",
    "conditionals-match-and-loops", "tuples-arrays-lists-and-aliases",
    "blocks-wiring-and-closures", "imports-visibility-and-io",
    "graphics-surfaces-and-play", "math-vectors-and-matrices",
    "data-structures-and-memory", "native-c11-and-optimization"
    ];
    hbPaths: List<String> = [
    "language/learn/handbook/getting-started/overview-and-setup.md",
    "language/learn/handbook/foundations/bindings-and-mutability.md",
    "language/learn/handbook/foundations/numbers-operators-and-strings.md",
    "language/learn/handbook/control/conditionals-match-and-loops.md",
    "language/learn/handbook/types/tuples-arrays-lists-and-aliases.md",
    "language/learn/handbook/execution/blocks-wiring-and-closures.md",
    "language/learn/handbook/modules/imports-visibility-and-io.md",
    "language/learn/handbook/extra/graphics-surfaces-and-play.md",
    "language/learn/handbook/extra/math-vectors-and-matrices.md",
    "language/learn/handbook/extra/data-structures-and-memory.md",
    "language/learn/handbook/tooling/native-c11-and-optimization.md"
    ];
    hit := list.listIndexOfText(hbSlugs, slug);
    if hit >= 0 { hbPaths[hit] } else { "" }
};

resolveLiteDocSource := fn(directory: String, rawTarget: String): (found: Bool, isVirtualIndex: Bool, filePath: String) {
    clean := stripSuffix(stripSuffix(rawTarget, ".html"), ".md");
    if clean == "" or clean == "index" or clean == "spec" or clean == "spec/index" {
        return (found = true, isVirtualIndex = true, filePath = "");
    }
    candidates: mut List<String> = [];
    if clean == "overview" { mut candidates.pushBack("docs/README.md"); }
    else if clean == "spec-overview" { mut candidates.pushBack("docs/spec/README.md"); }
    else if clean == "contributing" or clean == "CONTRIBUTING" { mut candidates.pushBack("CONTRIBUTING.md"); }
    else if clean == "compiler/overview" { mut candidates.pushBack("compiler/README.md"); }
    else if clean == "compiler/bootstrap-readme" or clean == "compiler/bootstrap/README" { mut candidates.pushBack("compiler/bootstrap/README.md"); }
    else if clean == "compiler/manifests-readme" or clean == "compiler/manifests/README" { mut candidates.pushBack("compiler/manifests/README.md"); }
    else if clean == "compiler/igniter-tests" or clean == "igniter/tests/README" or clean == "compiler/igniter/tests/README" { mut candidates.pushBack("igniter/tests/README.md"); }
    else if clean == "compiler/contributing" { mut candidates.pushBack("CONTRIBUTING.md"); }
    else if clean.startsWithAt(0, "spec/") { mut candidates.pushBack("docs/spec/" + clean.slice(5, clean.length()) + ".md"); }
    else if clean.startsWithAt(0, "spec-") { mut candidates.pushBack("docs/spec/" + clean.slice(5, clean.length()) + ".md"); }
    else if clean.startsWithAt(0, "research/") { mut candidates.pushBack("docs/research/" + clean.slice(9, clean.length()) + ".md"); }
    else if clean.startsWithAt(0, "research-") { mut candidates.pushBack("docs/research/" + clean.slice(9, clean.length()) + ".md"); }
    else if clean.startsWithAt(0, "proposals/") { mut candidates.pushBack("docs/proposals/" + clean.slice(10, clean.length()) + ".md"); }
    else if clean.startsWithAt(0, "compiler/") { mut candidates.pushBack(clean + ".md"); }
    else if clean.startsWithAt(0, "docs/") { mut candidates.pushBack(clean + ".md"); }
    else {
        mut candidates.pushBack("docs/" + clean + ".md");
        mut candidates.pushBack("docs/spec/" + clean + ".md");
        mut candidates.pushBack("docs/research/" + clean + ".md");
        mut candidates.pushBack("docs/proposals/" + clean + ".md");
        mut candidates.pushBack("compiler/" + clean + ".md");
    }
    loop candidates as rel {
        abs := path.resolve(directory, rel);
        if fs.kind(abs) == fs.FILE_KIND_FILE {
            return (found = true, isVirtualIndex = false, filePath = abs);
        }
    }
    (found = false, isVirtualIndex = false, filePath = "")
};

catalogHasLearnTarget := fn(directory: String, rawTarget: String): Bool {
    clean := stripSuffix(rawTarget, ".html");
    if clean == "" or clean == "index" { return true; }
    catPath := path.resolve(directory, "language/learn/catalog.json");
    if fs.kind(catPath) =!= fs.FILE_KIND_FILE { return false; }
    catRead := fs.readText(catPath);
    if not catRead.ok { return false; }
    catJson := catRead.text;
    tracksF := json.findObjectField(catJson, 0, "tracks");
    if not tracksF.found { return false; }
    loop json.arrayElementOffsets(catJson, tracksF.valuePos) as tp {
        trackIdR := json.readObjectString(catJson, tp, "id");
        trackId := if trackIdR.found and trackIdR.ok { trackIdR.value } else { "" };
        lessonsF := json.findObjectField(catJson, tp, "lessons");
        if not lessonsF.found { continue; }
        loop json.arrayElementOffsets(catJson, lessonsF.valuePos) as lp {
            idR := json.readObjectString(catJson, lp, "id");
            slugR := json.readObjectString(catJson, lp, "slug");
            lId := if idR.found and idR.ok { idR.value } else { "" };
            lSlug := if slugR.found and slugR.ok { slugR.value } else { "" };
            if clean == lSlug or clean == lId or (trackId =!= "" and clean == trackId + "/" + lSlug) {
                return true;
            }
        }
    }
    false
};

catalogHasGymTarget := fn(directory: String, rawTarget: String): Bool {
    var clean := stripSuffix(rawTarget, ".html");
    if clean == "" or clean == "index" { return true; }
    var expectedMode := "";
    if clean.startsWithAt(0, "drills/") {
        expectedMode = "drill";
        clean = clean.slice(7, clean.length());
    } else if clean.startsWithAt(0, "drill/") {
        expectedMode = "drill";
        clean = clean.slice(6, clean.length());
    } else if clean.startsWithAt(0, "workouts/") {
        expectedMode = "kata";
        clean = clean.slice(9, clean.length());
    } else if clean.startsWithAt(0, "workout/") {
        expectedMode = "kata";
        clean = clean.slice(8, clean.length());
    }
    catPath := path.resolve(directory, "language/gym/catalog.json");
    if fs.kind(catPath) =!= fs.FILE_KIND_FILE { return false; }
    catRead := fs.readText(catPath);
    if not catRead.ok { return false; }
    catJson := catRead.text;
    exF := json.findObjectField(catJson, 0, "exercises");
    if not exF.found { return false; }
    loop json.arrayElementOffsets(catJson, exF.valuePos) as ep {
        modeR := json.readObjectString(catJson, ep, "mode");
        idR := json.readObjectString(catJson, ep, "id");
        slugR := json.readObjectString(catJson, ep, "slug");
        eMode := if modeR.found and modeR.ok { modeR.value } else { "" };
        eId := if idR.found and idR.ok { idR.value } else { "" };
        eSlug := if slugR.found and slugR.ok { slugR.value } else { "" };
        if (expectedMode == "" or eMode == expectedMode) and (clean == eSlug or clean == eId) {
            return true;
        }
    }
    false
};

siteSamplesContainId := fn(directory: String, targetId: String): Bool {
    siteFiles: List<String> = ["site/groups.ts", "site/play-samples.ts"];
    singlePat := "id: '" + targetId + "'";
    doublePat := "id: \"" + targetId + "\"";
    loop siteFiles as rel {
        abs := path.resolve(directory, rel);
        if fs.kind(abs) == fs.FILE_KIND_FILE {
            r := fs.readText(abs);
            if r.ok and (r.text.contains(singlePat) or r.text.contains(doublePat)) {
                return true;
            }
        }
    }
    false
};

hasLtsSlugInDirs := fn(directory: String, dirs: List<String>, slug: String): Bool {
    clean := stripSuffix(slug, ".lts");
    loop dirs as relDir {
        absDir := path.resolve(directory, relDir);
        if fs.kind(absDir) == fs.FILE_KIND_DIR {
            files := path.collectFiles(absDir, [absDir], ".lts", defaultIgnoredDirs(), false);
            loop files as f {
                stem := path.stem(f);
                rel := stripSuffix(path.relative(absDir, f), ".lts");
                if clean == stem or clean == rel {
                    return true;
                }
            }
        }
    }
    false
};

hasPathTraversal := fn(target: String): Bool {
    target == ".." or
    target.startsWithAt(0, "../") or
    target.endsWith("/..") or
    target.contains("/../")
};

isAllAsciiDigits := fn(value: String): Bool {
    n := value.length();
    if n == 0 { return false; }
    var i := 0;
    loop i < n {
        if not value.at(i).isDigit() { return false; }
        i = i + 1;
    }
    true
};

hasHandbookPieceSlug := fn(directory: String, pieceSlug: String): Bool {
    n := pieceSlug.length();
    var lastDash := -1;
    var i := 0;
    loop i < n {
        if pieceSlug.at(i) == "-" { lastDash = i; }
        i = i + 1;
    }
    if lastDash <= 0 { return false; }
    suffix := pieceSlug.slice(lastDash + 1, n);
    if not isAllAsciiDigits(suffix) { return false; }
    hbRel := handbookSourceForSlug(pieceSlug.slice(0, lastDash));
    if hbRel == "" { return false; }
    fs.kind(path.resolve(directory, hbRel)) == fs.FILE_KIND_FILE
};

checkPlayTarget := fn(directory: String, rawTarget: String): Bool {
    if rawTarget == "" { return true; }
    if rawTarget.startsWithAt(0, "sample/") {
        return siteSamplesContainId(directory, rawTarget.slice(7, rawTarget.length()));
    }
    if rawTarget.startsWithAt(0, "example/") {
        exSlug := rawTarget.slice(8, rawTarget.length());
        if hasLtsSlugInDirs(directory, ["language/examples", "language/showcases"], exSlug) {
            return true;
        }
        if exSlug.startsWithAt(0, "showcase-") {
            return hasLtsSlugInDirs(directory, ["language/showcases"], exSlug.slice(9, exSlug.length()));
        }
        return false;
    }
    if rawTarget.startsWithAt(0, "case/") {
        return hasLtsSlugInDirs(directory, ["language/cases"], rawTarget.slice(5, rawTarget.length()));
    }
    if rawTarget.startsWithAt(0, "piece/") {
        pieceSlug := rawTarget.slice(6, rawTarget.length());
        if hasLtsSlugInDirs(directory, ["language/showcases", "language/samples", "samples"], pieceSlug) {
            return true;
        }
        if pieceSlug.startsWithAt(0, "gym-") and catalogHasGymTarget(directory, pieceSlug.slice(4, pieceSlug.length())) {
            return true;
        }
        if catalogHasLearnTarget(directory, pieceSlug) {
            return true;
        }
        return hasHandbookPieceSlug(directory, pieceSlug);
    }
    if siteSamplesContainId(directory, rawTarget) { return true; }
    hasLtsSlugInDirs(directory, ["language/examples", "language/cases", "language/showcases", "language/samples", "samples"], rawTarget)
};

resolveLiteBrandSource := fn(directory: String, rawTarget: String): String {
    if hasPathTraversal(rawTarget) { return ""; }
    clean := stripSuffix(rawTarget, ".html");
    candidates: mut List<String> = [];
    if clean == "" or clean == "index" or clean == "overview" or clean == "README" or clean == "README.md" or clean == "brand/README.md" {
        mut candidates.pushBack("brand/README.md");
    } else if clean == "name" or clean == "name.md" or clean == "brand/name.md" {
        mut candidates.pushBack("brand/name.md");
    } else if clean == "investigation" or clean == "investigation/README" or clean == "investigation/README.md" or clean == "brand/investigation/README.md" {
        mut candidates.pushBack("brand/investigation/README.md");
    } else {
        bare := if rawTarget.startsWithAt(0, "brand/") { rawTarget.slice(6, rawTarget.length()) } else { rawTarget };
        mut candidates.pushBack("brand/" + bare);
        mdClean := stripSuffix(stripSuffix(bare, ".html"), ".md");
        mut candidates.pushBack("brand/" + mdClean + ".md");
    }
    loop candidates as rel {
        abs := path.resolve(directory, rel);
        if fs.kind(abs) == fs.FILE_KIND_FILE {
            return abs;
        }
    }
    ""
};

checkLiteUri := fn(
directory: String, relPath: String, rawTarget: String,
anchorCache: mut Map<String, String>
): String {
    parsed := parseLiteUri(rawTarget);
    if not parsed.ok {
        return relPath + ": " + parsed.error;
    }
    ns := parsed.ns;
    target := parsed.target;
    fragment := parsed.fragment;

    if ns == "brand" {
        dest := resolveLiteBrandSource(directory, target);
        if dest == "" {
            return relPath + ": missing lite://brand target " + rawTarget;
        }
        if fragment =!= "" and dest.endsWith(".md") and not checkFragmentInMd(dest, fragment, mut anchorCache) {
            return relPath + ": missing fragment in " + rawTarget;
        }
        return "";
    }
    if ns == "repo" {
        if target == "" or hasPathTraversal(target) {
            return relPath + ": invalid lite://repo target " + rawTarget;
        }
        dest := path.resolve(directory, target);
        destKind := fs.kind(dest);
        if destKind == fs.FILE_KIND_MISSING {
            return relPath + ": missing lite://repo target " + rawTarget;
        }
        if fragment =!= "" and destKind == fs.FILE_KIND_FILE and dest.endsWith(".md") and not checkFragmentInMd(dest, fragment, mut anchorCache) {
            return relPath + ": missing fragment in " + rawTarget;
        }
        return "";
    }
    if ns == "handbook" {
        clean := stripSuffix(stripSuffix(target, ".html"), ".md");
        if clean == "" or clean == "single-page" { return ""; }
        hbRel := handbookSourceForSlug(clean);
        if hbRel == "" {
            return relPath + ": missing lite://handbook target " + rawTarget;
        }
        dest := path.resolve(directory, hbRel);
        if fs.kind(dest) =!= fs.FILE_KIND_FILE {
            return relPath + ": missing lite://handbook target " + rawTarget;
        }
        if fragment =!= "" and not checkFragmentInMd(dest, fragment, mut anchorCache) {
            return relPath + ": missing fragment in " + rawTarget;
        }
        return "";
    }
    if ns == "doc" {
        res := resolveLiteDocSource(directory, target);
        if not res.found {
            return relPath + ": missing lite://doc target " + rawTarget;
        }
        if not res.isVirtualIndex and fragment =!= "" and not checkFragmentInMd(res.filePath, fragment, mut anchorCache) {
            return relPath + ": missing fragment in " + rawTarget;
        }
        return "";
    }
    if ns == "learn" {
        if not catalogHasLearnTarget(directory, target) {
            return relPath + ": missing lite://learn target " + rawTarget;
        }
        return "";
    }
    if ns == "gym" {
        if not catalogHasGymTarget(directory, target) {
            return relPath + ": missing lite://gym target " + rawTarget;
        }
        return "";
    }
    if ns == "module" {
        cleanMod := stripSuffix(stripSuffix(stripSuffix(target, ".html"), ".lts"), ".lt");
        if cleanMod == "" or cleanMod == "index" { return ""; }
        modFileLt := path.resolve(directory, "lib/" + cleanMod + ".lt");
        modFileLts := path.resolve(directory, "lib/" + cleanMod + ".lts");
        modFile := if fs.kind(modFileLt) == fs.FILE_KIND_FILE { modFileLt } else { modFileLts };
        if fs.kind(modFile) =!= fs.FILE_KIND_FILE {
            return relPath + ": missing lite://module target " + rawTarget;
        }
        if fragment =!= "" {
            modRead := fs.readText(modFile);
            if not modRead.ok {
                return relPath + ": cannot read module for " + rawTarget;
            }
            modJson := docgen.extractModuleJson(modRead.text, "", cleanMod, "");
            if not modJson.contains("\"name\":" + json.quoteString(fragment)) {
                return relPath + ": missing module symbol #" + fragment + " in " + rawTarget;
            }
        }
        return "";
    }
    if ns == "tool" {
        knownTools: List<String> = [
        "", "overview", "cli", "vscode", "playground-host", "bootstrap",
        "run", "play", "build", "compile", "check", "fmt", "ignite", "test", "verify", "docs", "doctor", "bench-release",
        "cmd-run", "cmd-play", "cmd-build", "cmd-compile", "cmd-check", "cmd-fmt", "cmd-ignite", "cmd-test", "cmd-verify", "cmd-docs", "cmd-doctor", "cmd-bench-release"
        ];
        var toolKey := stripSuffix(target, ".html");
        if toolKey == "" and fragment =!= "" { toolKey = fragment; }
        if not list.listContainsText(knownTools, toolKey) {
            return relPath + ": missing lite://tool target " + rawTarget;
        }
        return "";
    }
    if ns == "play" {
        if not checkPlayTarget(directory, target) {
            return relPath + ": missing lite://play target " + rawTarget;
        }
        return "";
    }
    if ns == "gallery" {
        if target == "" { return ""; }
        cleanGal := if target.startsWithAt(0, "sample-") {
            target.slice(7, target.length())
        } else if target.startsWithAt(0, "group-") {
            target.slice(6, target.length())
        } else {
            target
        };
        if not siteSamplesContainId(directory, cleanGal) {
            return relPath + ": missing lite://gallery target " + rawTarget;
        }
        return "";
    }
    ""
};

/** Verifies Markdown fences, links, heading fragments, and `config/documentation.json` entries under `directory`. */
pub checkDocuments := fn(directory: String): List<String> {
    failures: mut List<String> = [];
    anchorCache: mut Map<String, String>;
    files := listDocFiles(directory);

    loop files as fullFile {
        relPath := path.relative(directory, fullFile);
        readRes := fs.readText(fullFile);
        if not readRes.ok {
            mut failures.pushBack(relPath + ": " + readRes.error);
        } else {
            docText := readRes.text;
            if md.hasUnclosedFence(docText) {
                mut failures.pushBack(relPath + ": unclosed code fence");
            }
            links := md.extractLinkTargets(md.stripCodeBlocks(docText));
            loop links as rawTarget {
                if isLiteUri(rawTarget) {
                    uriErr := checkLiteUri(directory, relPath, rawTarget, mut anchorCache);
                    if uriErr =!= "" {
                        mut failures.pushBack(uriErr);
                    }
                } else if not isExternalUri(rawTarget) {
                    decodedRes := decodePercentUri(rawTarget);
                    if not decodedRes.ok {
                        mut failures.pushBack(relPath + ": invalid link " + rawTarget);
                    } else {
                        target := decodedRes.value;
                        hashPos := target.indexOf("#", 0);
                        namePart := if hashPos < 0 { target } else { target.slice(0, hashPos) };
                        fragment := if hashPos < 0 { "" } else { target.slice(hashPos + 1, target.length()) };
                        destination := if namePart == "" { fullFile } else { path.resolve(path.parentDir(fullFile), namePart) };
                        destKind := fs.kind(destination);
                        if destKind == fs.FILE_KIND_MISSING {
                            mut failures.pushBack(relPath + ": missing link " + target);
                        } else if fragment =!= "" and path.extName(destination) == ".md" and destKind == fs.FILE_KIND_FILE {
                            if not checkFragmentInMd(destination, fragment, mut anchorCache) {
                                mut failures.pushBack(relPath + ": missing fragment " + target);
                            }
                        }
                    }
                }
            }
        }
    }

    configPath := path.join(directory, "config/documentation.json");
    if fs.kind(configPath) == fs.FILE_KIND_FILE {
        cfgRead := fs.readText(configPath);
        if not cfgRead.ok {
            mut failures.pushBack("config/documentation.json: " + cfgRead.error);
            return failures;
        }
        cfgText := cfgRead.text;
        cfgCheck := json.validate(cfgText);
        if not cfgCheck.ok {
            mut failures.pushBack("config/documentation.json: " + cfgCheck.error);
            return failures;
        }
        navField := json.findObjectField(cfgText, 0, "navigation");
        if navField.found {
            navItems := json.arrayElementOffsets(cfgText, navField.valuePos);
            loop navItems as navPos {
                labelRes := json.readObjectString(cfgText, navPos, "label");
                pathRes := json.readObjectString(cfgText, navPos, "path");
                navPath := if pathRes.found and pathRes.ok { pathRes.value } else { "" };
                navLabel := if labelRes.found and labelRes.ok { labelRes.value } else { "" };
                if navLabel == "" or fs.kind(path.resolve(directory, navPath)) == fs.FILE_KIND_MISSING {
                    mut failures.pushBack("config/documentation.json: missing navigation destination " + navPath);
                }
            }
        }
        snipField := json.findObjectField(cfgText, 0, "snippets");
        if snipField.found {
            snipItems := json.arrayElementOffsets(cfgText, snipField.valuePos);
            loop snipItems as snipPos {
                srcRes := json.readObjectString(cfgText, snipPos, "source");
                docRes := json.readObjectString(cfgText, snipPos, "document");
                fenceRes := json.readObjectInt(cfgText, snipPos, "fence");
                skipRes := json.readObjectInt(cfgText, snipPos, "skipLines");
                srcRel := if srcRes.found and srcRes.ok { srcRes.value } else { "" };
                docRel := if docRes.found and docRes.ok { docRes.value } else { "" };
                srcFull := path.resolve(directory, srcRel);
                docFull := path.resolve(directory, docRel);
                if fs.kind(srcFull) == fs.FILE_KIND_MISSING or fs.kind(docFull) == fs.FILE_KIND_MISSING {
                    mut failures.pushBack("config/documentation.json: missing snippet source/document " + srcRel);
                } else {
                    docRead := fs.readText(docFull);
                    srcRead := fs.readText(srcFull);
                    if not docRead.ok or not srcRead.ok {
                        mut failures.pushBack("config/documentation.json: cannot read snippet " + srcRel);
                    } else {
                        fences := md.extractBacktickFenceBodies(docRead.text);
                        skipCount := if skipRes.found and skipRes.ok { skipRes.value } else { 0 };
                        expected := dropFirstLines(srcRead.text, skipCount);
                        fenceIdx := if fenceRes.found and fenceRes.ok { fenceRes.value } else { -1 };
                        if fenceIdx < 0 or fenceIdx >= fences.length() or fences[fenceIdx] =!= expected {
                            mut failures.pushBack(docRel + ": code fence " + fenceIdx.toText() + " differs from " + srcRel);
                        }
                    }
                }
            }
        }
    }
    failures
}

/** Formats the curated navigation overview from `config/documentation.json`. */
pub navigationSummary := fn(directory: String): (ok: Bool, text: String, error: String) {
    configPath := path.join(directory, "config/documentation.json");
    if fs.kind(configPath) =!= fs.FILE_KIND_FILE {
        return (ok = false, text = "", error = "documentation navigation configuration is missing");
    }
    cfgRead := fs.readText(configPath);
    if not cfgRead.ok {
        return (ok = false, text = "", error = cfgRead.error);
    }
    navField := json.findObjectField(cfgRead.text, 0, "navigation");
    if not navField.found {
        return (ok = false, text = "", error = "documentation navigation configuration is missing");
    }
    lines: mut List<String> = [];
    navItems := json.arrayElementOffsets(cfgRead.text, navField.valuePos);
    loop navItems as navPos {
        labelRes := json.readObjectString(cfgRead.text, navPos, "label");
        pathRes := json.readObjectString(cfgRead.text, navPos, "path");
        label := if labelRes.found and labelRes.ok { labelRes.value } else { "" };
        navPath := if pathRes.found and pathRes.ok { pathRes.value } else { "" };
        mut lines.pushBack(label + ": " + navPath);
    }
    (mut lines).pushBack("Search: lite docs QUERY | --json [QUERY] | --check");
    (ok = true, text = text.joinTexts(lines, "\n"), error = "")
}

docMatchesQuery := fn(relPath: String, title: String, headings: List<String>, queryLower: String): Bool {
    if queryLower == "" { return true; }
    if relPath.toLowerAscii().contains(queryLower) { return true; }
    if title.toLowerAscii().contains(queryLower) { return true; }
    loop headings as heading {
        if heading.toLowerAscii().contains(queryLower) { return true; }
    }
    false
}

/** Searches documentation paths, titles, and headings matching case-insensitive `query`. */
pub searchDocsText := fn(directory: String, query: String): (count: Int, text: String) {
    queryLower := query.toLowerAscii();
    lines: mut List<String> = [];
    var count := 0;
    files := listDocFiles(directory);

    loop files as fullFile {
        relPath := path.relative(directory, fullFile);
        readRes := fs.readText(fullFile);
        docText := if readRes.ok { readRes.text } else { "" };
        headings := md.extractHeadings(md.stripCodeBlocks(docText));
        title := if headings.length() > 0 { headings[0] } else { path.baseName(fullFile) };
        if docMatchesQuery(relPath, title, headings, queryLower) {
            mut lines.pushBack(title + "\n  " + relPath);
            count = count + 1;
        }
    }
    (count = count, text = text.joinTexts(lines, "\n"))
}

/** Formats matching documentation records as 2-space indented JSON (`JSON.stringify(..., null, 2)` parity). */
pub docsJson := fn(directory: String, query: String): String {
    queryLower := query.toLowerAscii();
    entries: mut List<String> = [];
    files := listDocFiles(directory);

    loop files as fullFile {
        relPath := path.relative(directory, fullFile);
        readRes := fs.readText(fullFile);
        docText := if readRes.ok { readRes.text } else { "" };
        headings := md.extractHeadings(md.stripCodeBlocks(docText));
        title := if headings.length() > 0 { headings[0] } else { path.baseName(fullFile) };
        if docMatchesQuery(relPath, title, headings, queryLower) {
            hCount := headings.length();
            var headingsJson := "[]";
            if hCount > 0 {
                hLines: mut List<String> = [];
                loop headings as h {
                    mut hLines.pushBack("      " + json.quoteString(h));
                }
                headingsJson = "[\n" + text.joinTexts(hLines, ",\n") + "\n    ]";
            }
            entry := "  {\n    \"path\": " + json.quoteString(relPath) + ",\n    \"title\": " + json.quoteString(title) + ",\n    \"headings\": " + headingsJson + "\n  }";
            mut entries.pushBack(entry);
        }
    }
    if entries.length() == 0 { return "[]"; }
    "[\n" + text.joinTexts(entries, ",\n") + "\n]"
}
