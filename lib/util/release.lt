/** Shared component release stream parsing, SemVer validation, and readiness profile helpers. */

fs := import "core/file";
text := import "core/text";
list := import "core/list";
path := import "core/path";
json := import "util/json";

isIdentChar := fn(ch: String): Bool {
    ch.isDigit() or ch.isAsciiLetter() or ch == "-"
};

isAllDigits := fn(segment: String): Bool {
    size := segment.length();
    if size == 0 { return false; }
    var i := 0;
    loop i < size {
        if not segment.at(i).isDigit() { return false; }
        i = i + 1;
    }
    true
};

isPlainNumericSegment := fn(segment: String): Bool {
    if not isAllDigits(segment) { return false; }
    size := segment.length();
    if size > 1 and segment.at(0) == "0" { return false; }
    true
};

validDotIdentifiers := fn(part: String, rejectLeadingZeroNumeric: Bool): Bool {
    size := part.length();
    if size == 0 { return false; }
    var segStart := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        isDot := not atEnd and part.at(i) == ".";
        if atEnd or isDot {
            seg := part.slice(segStart, i);
            if seg.length() == 0 { return false; }
            if rejectLeadingZeroNumeric and isAllDigits(seg) and not isPlainNumericSegment(seg) {
                return false;
            }
            segStart = i + 1;
        } else if not isIdentChar(part.at(i)) {
            return false;
        }
        i = i + 1;
    }
    true
};

/** Validates SemVer (`MAJOR.MINOR.PATCH[-PRERELEASE][+BUILD]`) without leading zeroes on numeric identifiers. */
pub isValidSemver := fn(version: String): Bool {
    size := version.length();
    if size == 0 { return false; }
    plusPos := version.indexOf("+", 0);
    beforeBuild := if plusPos >= 0 { version.slice(0, plusPos) } else { version };
    if plusPos >= 0 {
        buildPart := version.slice(plusPos + 1, size);
        if not validDotIdentifiers(buildPart, false) { return false; }
    }
    dashPos := beforeBuild.indexOf("-", 0);
    corePart := if dashPos >= 0 { beforeBuild.slice(0, dashPos) } else { beforeBuild };
    if dashPos >= 0 {
        prePart := beforeBuild.slice(dashPos + 1, beforeBuild.length());
        if not validDotIdentifiers(prePart, true) { return false; }
    }
    dot1 := corePart.indexOf(".", 0);
    if dot1 < 0 { return false; }
    dot2 := corePart.indexOf(".", dot1 + 1);
    if dot2 < 0 { return false; }
    if corePart.indexOf(".", dot2 + 1) >= 0 { return false; }
    isPlainNumericSegment(corePart.slice(0, dot1)) and
    isPlainNumericSegment(corePart.slice(dot1 + 1, dot2)) and
    isPlainNumericSegment(corePart.slice(dot2 + 1, corePart.length()))
};

/** Returns true when `version` is a plain `MAJOR.MINOR.PATCH` string (required for VS Code extension). */
pub isPlainMajorMinorPatch := fn(version: String): Bool {
    version.indexOf("-", 0) < 0 and
    version.indexOf("+", 0) < 0 and
    isValidSemver(version)
};

allComponents := fn(): List<String> {
    items: List<String> = [
    "project", "language", "scripting", "compiler", "igniter", "cli",
    "formatter", "runtime", "stdlib", "builtins", "checker", "tester",
    "verifier", "benchmark", "release", "docs", "vscode", "linker", "doctor"
    ];
    items
};

/** Maps a component name to its release tag prefix (before `-v`), or `""` when unknown. */
pub componentTagPrefix := fn(component: String): String {
    if component == "project" { return "lite"; }
    if component == "language" { return "lang"; }
    if component == "scripting" { return "script"; }
    if component == "compiler" { return "compiler"; }
    if component == "igniter" { return "igniter"; }
    if component == "cli" { return "cli"; }
    if component == "formatter" { return "formatter"; }
    if component == "runtime" { return "runtime"; }
    if component == "stdlib" { return "std"; }
    if component == "builtins" { return "builtins"; }
    if component == "checker" { return "check"; }
    if component == "tester" { return "test"; }
    if component == "verifier" { return "verify"; }
    if component == "benchmark" { return "bench"; }
    if component == "release" { return "release"; }
    if component == "docs" { return "docs"; }
    if component == "vscode" { return "vscode"; }
    if component == "linker" { return "linker"; }
    if component == "doctor" { return "doctor"; }
    ""
};

/** Parses a component release tag such as `compiler-v0.2.0-pre` into `(component, version)`. */
pub parseComponentTag := fn(tag: String): (ok: Bool, component: String, version: String, error: String) {
    components := allComponents();
    loop components as component {
        prefix := componentTagPrefix(component) + "-v";
        if tag.startsWithAt(0, prefix) {
            version := tag.slice(prefix.length(), tag.length());
            if not isValidSemver(version) {
                return (ok = false, component = "", version = "", error = "invalid release version: " + tag);
            }
            return (ok = true, component = component, version = version, error = "");
        }
    }
    (ok = false, component = "", version = "", error = "unsupported release tag: " + tag)
};

readIgniterVersion := fn(rootDir: String): (ok: Bool, version: String, error: String) {
    pkgRead := fs.readText(path.join(rootDir, "igniter/package.json"));
    if not pkgRead.ok {
        return (ok = false, version = "", error = pkgRead.error);
    }
    ver := json.readObjectString(pkgRead.text, 0, "version");
    if not ver.found or not ver.ok or not isValidSemver(ver.value) {
        return (ok = false, version = "", error = "invalid igniter package version");
    }
    (ok = true, version = ver.value, error = "")
};

/** Validates `igniter/package.json` and `config/versions.json` and resolves an optional release `tag`. */
pub selectComponentRelease := fn(rootDir: String, tag: String): (ok: Bool, hasTag: Bool, component: String, version: String, error: String) {
    igniterRes := readIgniterVersion(rootDir);
    if not igniterRes.ok {
        return (ok = false, hasTag = false, component = "", version = "", error = igniterRes.error);
    }
    verRead := fs.readText(path.join(rootDir, "config/versions.json"));
    if not verRead.ok {
        return (ok = false, hasTag = false, component = "", version = "", error = verRead.error);
    }
    verValid := json.validate(verRead.text);
    if not verValid.ok {
        return (ok = false, hasTag = false, component = "", version = "", error = verValid.error);
    }

    components := allComponents();
    keys := json.objectKeys(verRead.text, 0);
    loop keys as key {
        if key == "igniter" or not components.contains(key) {
            return (ok = false, hasTag = false, component = "", version = "", error = "unknown versions.json component: " + key);
        }
    }

    var matchedComponent := "";
    var matchedVersion := "";
    var wantComponent := "";
    var wantVersion := "";
    if tag =!= "" {
        parsed := parseComponentTag(tag);
        if not parsed.ok {
            return (ok = false, hasTag = false, component = "", version = "", error = parsed.error);
        }
        wantComponent = parsed.component;
        wantVersion = parsed.version;
    }

    loop components as component {
        var assigned := false;
        var val := "";
        if component == "igniter" {
            assigned = true;
            val = igniterRes.version;
        } else {
            field := json.findObjectField(verRead.text, 0, component);
            if not field.found {
                return (ok = false, hasTag = false, component = "", version = "", error = "versions.json: invalid or missing " + component + " version");
            }
            if verRead.text.startsWithAt(field.valuePos, "null") {
                assigned = false;
            } else {
                strRes := json.readStringAt(verRead.text, field.valuePos);
                if not strRes.ok or not isValidSemver(strRes.value) {
                    return (ok = false, hasTag = false, component = "", version = "", error = "versions.json: invalid or missing " + component + " version");
                }
                if component == "vscode" and not isPlainMajorMinorPatch(strRes.value) {
                    return (ok = false, hasTag = false, component = "", version = "", error = "vscode version requires plain MAJOR.MINOR.PATCH");
                }
                assigned = true;
                val = strRes.value;
            }
        }
        if component == wantComponent {
            if not assigned or val =!= wantVersion {
                authFile := if component == "igniter" { "igniter/package.json" } else { "versions.json" };
                return (ok = false, hasTag = false, component = "", version = "", error = component + " tag/version mismatch: update " + authFile + " before tagging");
            }
            matchedComponent = component;
            matchedVersion = val;
        }
    }

    if tag == "" {
        return (ok = true, hasTag = false, component = "", version = "", error = "");
    }
    (ok = true, hasTag = true, component = matchedComponent, version = matchedVersion, error = "")
};

/** Validates and serializes all repository component versions (including `igniter`) as a JSON object string. */
pub versionsJson := fn(rootDir: String): (ok: Bool, jsonText: String, error: String) {
    checked := selectComponentRelease(rootDir, "");
    if not checked.ok { return (ok = false, jsonText = "", error = checked.error); }

    igniterRes := readIgniterVersion(rootDir);
    if not igniterRes.ok { return (ok = false, jsonText = "", error = igniterRes.error); }
    verRead := fs.readText(path.join(rootDir, "config/versions.json"));
    if not verRead.ok { return (ok = false, jsonText = "", error = verRead.error); }

    entries: mut List<String> = [];
    loop allComponents() as component {
        if component == "igniter" {
            mut entries.pushBack("\"igniter\":" + json.quoteString(igniterRes.version));
        } else {
            field := json.findObjectField(verRead.text, 0, component);
            if verRead.text.startsWithAt(field.valuePos, "null") {
                mut entries.pushBack(json.quoteString(component) + ":null");
            } else {
                strRes := json.readStringAt(verRead.text, field.valuePos);
                mut entries.pushBack(json.quoteString(component) + ":" + json.quoteString(strRes.value));
            }
        }
    }
    (ok = true, jsonText = "{" + entries.join(",") + "}", error = "")
};

pub PROFILE_TOOLS := "tools";
pub PROFILE_COMPILER := "compiler";
pub PROFILE_LANGUAGE := "language";

/** Classifies a release into `"tools"`, `"compiler"`, or `"language"` verification profiles. */
pub releaseProfile := fn(hasTag: Bool, component: String, version: String): String {
    toolComponents: List<String> = [
    "cli", "checker", "tester", "verifier", "benchmark", "release", "docs", "vscode", "formatter", "linker", "doctor"
    ];
    if not hasTag or toolComponents.contains(component) {
        return PROFILE_TOOLS;
    }
    if component == "project" or component == "language" or component == "scripting" {
        return PROFILE_LANGUAGE;
    }
    if component == "compiler" and version.indexOf("-", 0) < 0 {
        return PROFILE_LANGUAGE;
    }
    PROFILE_COMPILER
};

profileSummary := fn(profile: String): String {
    if profile == PROFILE_COMPILER {
        return "Compiler preview verified across the three-generation fixed-point bootstrap ladder and recorded corpus contracts; native C remains deferred.";
    }
    if profile == PROFILE_LANGUAGE {
        return "Language release verified across the three-generation bootstrap ladder, recorded corpus contracts, and full `lite verify --all --no-cache` conformance.";
    }
    "Tool/source snapshot validated for CLI, docs, and extracted TS compilation; does not establish full language conformance."
};

/** Renders concise Markdown release notes describing component identity, tag summary, verification evidence, and SHA-256 artifacts. */
pub formatReleaseNotes := fn(
label: String, commit: String, profile: String,
hasComponent: Bool, componentName: String, componentVersion: String,
archive: String, archiveSha256: String, manifestSha256: String,
hasVsix: Bool, vsixFile: String, vsixSha256: String,
hasBootstrap: Bool, bootstrapGenerations: Int, bootstrapFixedPoint: Bool,
hasCorpusCases: Bool, corpusCases: Int, corpusPrograms: Int, corpusRejections: Int, corpusExecutions: Int, corpusMismatches: Int,
bootstrapSupport: String,
tagMessage: String
): String {
    componentText := if not hasComponent { "unpublished snapshot" } else { componentName + " v" + componentVersion };
    lines: mut List<String> = [
    "# " + label,
    "",
    "- **Source commit**: `" + commit + "`",
    "- **Released component**: " + componentText,
    "- **Readiness profile**: `" + profile + "` — " + profileSummary(profile),
    "- **Native C backend**: deferred (`nativeCompiler: false`)"
    ];
    if tagMessage =!= "" {
        mut lines.pushBack("");
        mut lines.pushBack("## Summary");
        mut lines.pushBack("");
        mut lines.pushBack(tagMessage);
    }
    (mut lines).pushBack("");
    mut lines.pushBack("## Verification");
    mut lines.pushBack("");
    mut lines.pushBack("- Extracted archive validated with `./bin/lite doctor --docs`");
    mut lines.pushBack("- Node-only TypeScript emission & execution roundtrip verified on `001-001-report-int-42.lts` (output `42`)");
    if hasBootstrap {
        ladderStatus := if bootstrapFixedPoint { "passed" } else { "failed" };
        corpusStats := if not hasCorpusCases {
            "mismatches=" + corpusMismatches.toText()
        } else {
            corpusCases.toText() + " cases (" +
            corpusPrograms.toText() + " programs, " +
            corpusRejections.toText() + " rejections, " +
            corpusExecutions.toText() + " executions), mismatches=" +
            corpusMismatches.toText()
        };
        mut lines.pushBack("- Self-hosting fixed-point ladder: " + ladderStatus + " (" + bootstrapGenerations.toText() + " generations)");
        mut lines.pushBack("- Generated corpus parity: " + corpusStats);
        if profile == PROFILE_LANGUAGE {
            mut lines.pushBack("- Full repository verification: `./bin/lite verify --all --no-cache` passed");
        }
        (mut lines).pushBack("- Embedded archive evidence: `release/compiler.ts`, `release/compiler-source.lts`, `release/verification.json` (" + bootstrapSupport + ")");
    }
    (mut lines).pushBack("");
    mut lines.pushBack("## Artifacts");
    mut lines.pushBack("");
    mut lines.pushBack("- `" + archive + "` — sha256: `" + archiveSha256 + "`");
    if hasVsix {
        mut lines.pushBack("- `" + vsixFile + "` — sha256: `" + vsixSha256 + "`");
    }
    (mut lines).pushBack("- `manifest.json` — sha256: `" + manifestSha256 + "`");
    mut lines.pushBack("- `RELEASE-NOTES.md` — these release notes");
    mut lines.pushBack("- `SHA256SUMS` — checksum manifest for all release files");
    mut lines.pushBack("");
    mut lines.pushBack("## Verify and extract");
    mut lines.pushBack("");
    mut lines.pushBack("```sh");
    mut lines.pushBack("shasum -a 256 -c SHA256SUMS");
    mut lines.pushBack("mkdir -p lite-" + label + " && tar -xzf " + archive + " -C lite-" + label);
    mut lines.pushBack("cd lite-" + label + " && ./bin/lite doctor --docs");
    mut lines.pushBack("```");
    mut lines.pushBack("");
    mut lines.pushBack("See `docs/start-here.md`, `docs/release-automation.md`, and `compiler/transition-plan.md` in the archive.");
    mut lines.pushBack("");
    lines.join("\n")
};

/** Serializes the validated component versions map as formatted JSON lines for `manifest.json`. */
pub formatComponentVersionsJson := fn(rootDir: String, indent: String): (ok: Bool, jsonText: String, error: String) {
    igniterRes := readIgniterVersion(rootDir);
    if not igniterRes.ok {
        return (ok = false, jsonText = "", error = igniterRes.error);
    }
    verRead := fs.readText(path.join(rootDir, "config/versions.json"));
    if not verRead.ok {
        return (ok = false, jsonText = "", error = verRead.error);
    }
    components := allComponents();
    entries: mut List<String> = [];
    loop components as component {
        if component == "igniter" {
            mut entries.pushBack(indent + "  \"igniter\": " + json.quoteString(igniterRes.version));
        } else {
            field := json.findObjectField(verRead.text, 0, component);
            if not field.found {
                return (ok = false, jsonText = "", error = "missing version for " + component);
            }
            if verRead.text.startsWithAt(field.valuePos, "null") {
                mut entries.pushBack(indent + "  " + json.quoteString(component) + ": null");
            } else {
                strRes := json.readStringAt(verRead.text, field.valuePos);
                if not strRes.ok {
                    return (ok = false, jsonText = "", error = "invalid version for " + component);
                }
                (mut entries).pushBack(indent + "  " + json.quoteString(component) + ": " + json.quoteString(strRes.value));
            }
        }
    }
    (ok = true, jsonText = "{\n" + entries.join(",\n") + "\n" + indent + "}", error = "")
};
