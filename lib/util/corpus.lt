/** Shared Lite utilities for generated-compiler build, three-generation self-hosting, and corpus parity verification. */

io := import "core/io";
fs := import "core/file";
path := import "core/path";
proc := import "core/process";
project := import "util/project";
text := import "core/text";
list := import "core/list";
crypto := import "core/crypto";
time := import "core/time";
unicode := import "core/unicode";
json := import "util/json";
streams := import "util/streams";
cases := import "util/cases";
compilerBuild := import "util/compiler-build";

isJsonSpace := fn(ch: String): Bool {
    ch == " " or ch == "\n" or ch == "\r" or ch == "\t"
};

skipJsonSpace := fn(source: String, start: Int): Int {
    var pos := start;
    size := source.length();
    loop pos < size {
        if not isJsonSpace(source.at(pos)) { return pos; }
        pos = pos + 1;
    }
    pos
};

isJsonObjectAt := fn(source: String, start: Int): Bool {
    pos := skipJsonSpace(source, start);
    pos < source.length() and source.at(pos) == "{"
};

isJsonArrayAt := fn(source: String, start: Int): Bool {
    pos := skipJsonSpace(source, start);
    pos < source.length() and source.at(pos) == "["
};

/** Reads string items from a JSON array starting at `arrPos`. */
pub readStringListAt := fn(source: String, arrPos: Int): List<String> {
    out: mut List<String> = [];
    if not isJsonArrayAt(source, arrPos) { return out; }
    loop json.arrayElementOffsets(source, arrPos) as elPos {
        s := json.readStringAt(source, elPos);
        if s.ok { mut out.pushBack(s.value); }
    }
    out
};

/** Validates `--key value` pairs against `allowedKeys`, rejecting unknown, missing, duplicate, or flag-like values. */
pub parseToolOptions := fn(args: List<String>, allowedKeys: List<String>): (ok: Bool, error: String) {
    seen: mut List<String> = [];
    count := args.length();
    var i := 0;
    loop i < count {
        arg := args[i];
        if not arg.startsWithAt(0, "--") {
            return (ok = false, error = "invalid or missing option: " + arg);
        }
        key := arg.slice(2, arg.length());
        if i + 1 >= count {
            return (ok = false, error = "invalid or missing option: " + arg);
        }
        val := args[i + 1];
        if not allowedKeys.contains(key) or seen.contains(key) or val.startsWithAt(0, "--") {
            return (ok = false, error = "invalid or missing option: " + arg);
        }
        (mut seen).pushBack(key);
        i = i + 2;
    }
    (ok = true, error = "")
};

/** Reads the string value for `--<key>` from validated option arguments. */
pub readToolOption := fn(args: List<String>, key: String): (found: Bool, value: String) {
    flag := "--" + key;
    count := args.length();
    var i := 0;
    loop i + 1 < count {
        if args[i] == flag {
            return (found = true, value = args[i + 1]);
        }
        i = i + 2;
    }
    (found = false, value = "")
};

/** Reads an integer `--<key>` option >= `minimum`, defaulting to `fallback` when absent. */
pub positiveOptionValue := fn(args: List<String>, key: String, fallback: Int, minimum: Int): (ok: Bool, value: Int, error: String) {
    opt := readToolOption(args, key);
    if not opt.found { return (ok = true, value = fallback, error = ""); }
    raw := opt.value;
    if raw == "" { return (ok = false, value = 0, error = "invalid --" + key); }
    var start := 0;
    if raw.startsWithAt(0, "-") {
        if raw.length() == 1 { return (ok = false, value = 0, error = "invalid --" + key); }
        start = 1;
    }
    var i := start;
    loop i < raw.length() {
        if not raw.at(i).isDigit() { return (ok = false, value = 0, error = "invalid --" + key); }
        i = i + 1;
    }
    parsed := raw.toInt();
    if not parsed.ok or parsed.value < minimum {
        return (ok = false, value = 0, error = "invalid --" + key);
    }
    (ok = true, value = parsed.value, error = "")
};

/** Returns the Git HEAD hash when `rootDir` owns its repository, or `found = false` inside source archives. */
pub repoRevision := fn(rootDir: String): (found: Bool, rev: String) {
    emptyEnv: List<String> = [];
    topArgs: List<String> = ["rev-parse", "--show-toplevel"];
    topRes := proc.run("git", topArgs, rootDir, emptyEnv, true, "");
    if topRes.error =!= "" or topRes.status =!= 0 {
        return (found = false, rev = "");
    }
    if path.normalize(topRes.stdout.trim()) =!= path.normalize(rootDir) {
        return (found = false, rev = "");
    }
    headArgs: List<String> = ["rev-parse", "HEAD"];
    headRes := proc.run("git", headArgs, rootDir, emptyEnv, true, "");
    if headRes.error =!= "" or headRes.status =!= 0 {
        return (found = false, rev = "");
    }
    (found = true, rev = headRes.stdout.trim())
};

/** Builds or selects `target` (`"ts"` or `"c"`) compiler natively and returns its metadata. */
pub readCompilerMeta := fn(rootDir: String, target: String): (
ok: Bool, artifactPath: String, sourceSha256: String, artifactSha256: String, builderSha256: String, rawJson: String, error: String
) {
    built := compilerBuild.buildCompiler(rootDir, target);
    if not built.ok {
        return (ok = false, artifactPath = "", sourceSha256 = "", artifactSha256 = "", builderSha256 = "", rawJson = "", error = built.error);
    }
    (ok = true, artifactPath = built.path, sourceSha256 = built.sourceSha256, artifactSha256 = built.artifactSha256, builderSha256 = built.builderSha256, rawJson = built.jsonText, error = "")
};

/** Formats SHA-256 identity metadata for `relPaths` under `rootDir`. */
pub toolIdentitiesJson := fn(rootDir: String, relPaths: List<String>): (ok: Bool, jsonText: String, error: String) {
    entries: mut List<String> = [];
    loop relPaths as rel {
        hRes := crypto.sha256File(path.join(rootDir, rel));
        if not hRes.ok { return (ok = false, jsonText = "", error = hRes.error); }
        (mut entries).pushBack("{\n      \"path\": " + json.quoteString(rel) + ",\n      \"sha256\": " + json.quoteString(hRes.hex) + "\n    }");
    }
    (ok = true, jsonText = "[\n    " + entries.join(",\n    ") + "\n  ]", error = "")
};

/** Strictly typechecks a single TS artifact file and returns elapsed integer milliseconds. */
pub checkStrictSingle := fn(rootDir: String, artifactPath: String): (ok: Bool, elapsedMs: Int, error: String) {
    tmpRes := fs.makeTempDir("lite-strict-check-");
    if not tmpRes.ok { return (ok = false, elapsedMs = 0, error = tmpRes.error); }
    startNs := time.monotonicNs();
    chk := cases.checkTsArtifactFileWithStatus(rootDir, artifactPath, tmpRes.path, 60000);
    elapsedMs := (time.monotonicNs() - startNs) / 1000000;
    _rm := fs.remove(tmpRes.path);
    if not chk.ok { return (ok = false, elapsedMs = elapsedMs, error = chk.error); }
    (ok = true, elapsedMs = elapsedMs, error = "")
};

/** Resolves selected TS compiler metadata and optional explicit `--artifact` overrides. */
pub checkSeedArtifact := fn(rootDir: String, hasArtifact: Bool, optArtifact: String): (
ok: Bool, chosenPath: String, artifactSha256: String, sourceSha256: String,
selectedCompilerSha256: String, selectedBuilderSha256: String, totalDepBytes: Int, error: String
) {
    meta := readCompilerMeta(rootDir, "ts");
    if not meta.ok {
        return (ok = false, chosenPath = "", artifactSha256 = "", sourceSha256 = "", selectedCompilerSha256 = "", selectedBuilderSha256 = "", totalDepBytes = 0, error = meta.error);
    }
    chosen := if hasArtifact { path.resolve(proc.cwd(), optArtifact) } else { meta.artifactPath };
    chosenHash := crypto.sha256File(chosen);
    if not chosenHash.ok {
        return (ok = false, chosenPath = "", artifactSha256 = "", sourceSha256 = "", selectedCompilerSha256 = "", selectedBuilderSha256 = "", totalDepBytes = 0, error = chosenHash.error);
    }
    var totalBytes := 0;
    depsField := json.findObjectField(meta.rawJson, 0, "dependencies");
    loop readStringListAt(meta.rawJson, depsField.valuePos) as depRel {
        totalBytes = totalBytes + fs.readBytes(path.resolve(rootDir, depRel)).length();
    }
    (
    ok = true, chosenPath = chosen, artifactSha256 = chosenHash.hex, sourceSha256 = meta.sourceSha256,
    selectedCompilerSha256 = meta.artifactSha256, selectedBuilderSha256 = meta.builderSha256, totalDepBytes = totalBytes, error = ""
    )
};

MODULE_IDENTITIES: Map<String, String> = [
"lib/core/io.lt" = "lite.core.io.v1",
"lib/core/int.lt" = "lite.core.int.v1",
"lib/core/list.lt" = "lite.core.list.v1",
"lib/core/map.lt" = "lite.core.map.v1",
"lib/core/set.lt" = "lite.core.set.v1",
"lib/core/text.lt" = "lite.core.text.v1",
"lib/core/file.lt" = "lite.core.file.v1",
"lib/core/process.lt" = "lite.core.process.v1",
"lib/core/crypto.lt" = "lite.core.crypto.v1",
"lib/core/time.lt" = "lite.core.time.v1",
"lib/core/unicode.lt" = "lite.core.unicode.v1",
"compiler/src/modules.lt" = "lite.compiler.modules.v1",
];

/** Identifies source bytes matching a shipped core/compiler host module. */
pub sourceModuleIdentity := fn(rootDir: String, sourceBytes: List<Int>): String {
    loop MODULE_IDENTITIES as entry {
        full := path.join(rootDir, entry.key);
        if fs.kind(full) == fs.FILE_KIND_FILE {
            if streams.equalBytes(sourceBytes, fs.readBytes(full)) {
                return entry.value;
            }
        }
    }
    ""
};

indentTwoSpaces := fn(raw: String): String {
    lines: mut List<String> = [];
    var pos := 0;
    size := raw.length();
    loop pos <= size {
        nl := raw.indexOf("\n", pos);
        end := if nl < 0 { size } else { nl };
        mut lines.pushBack(raw.slice(pos, end));
        if nl < 0 { break; }
        pos = nl + 1;
    }
    lines.join("\n  ")
};

/** Executes `compiler/scripts/build.ts` natively and prints `{ ts, c }` JSON metadata. */
pub runCompilerBuildCommand := fn(rootDir: String): Int {
    tsRes := compilerBuild.buildCompiler(rootDir, "ts");
    if not tsRes.ok {
        io.errorLine("compiler build: " + tsRes.error);
        return 1;
    }
    cRes := compilerBuild.buildCompiler(rootDir, "c");
    if not cRes.ok {
        io.errorLine("compiler build: " + cRes.error);
        return 1;
    }
    io.outputLine("{\n  \"ts\": " + indentTwoSpaces(tsRes.jsonText) + ",\n  \"c\": " + indentTwoSpaces(cRes.jsonText) + "\n}");
    0
};

/** Rebuilds current TS compiler root `S` through three checked TS generations and prints/persists `ladder.json`. */
pub runSelfHostCommand := fn(rootDir: String, args: List<String>): Int {
    allowed: List<String> = ["out", "artifact"];
    optsOk := parseToolOptions(args, allowed);
    if not optsOk.ok {
        io.errorLine(optsOk.error);
        return 1;
    }
    outOpt := readToolOption(args, "out");
    artOpt := readToolOption(args, "artifact");

    sel := checkSeedArtifact(rootDir, artOpt.found, artOpt.value);
    if not sel.ok {
        io.errorLine(sel.error);
        return 1;
    }

    manifestPath := path.join(rootDir, "compiler/manifests/ts.json");
    manRes := fs.readText(manifestPath);
    if not manRes.ok {
        io.errorLine(manRes.error);
        return 1;
    }
    filesField := json.findObjectField(manRes.text, 0, "files");
    if not filesField.found {
        io.errorLine("self-host ladder requires one TS source root");
        return 1;
    }
    manFiles := readStringListAt(manRes.text, filesField.valuePos);
    if manFiles.length() =!= 1 {
        io.errorLine("self-host ladder requires one TS source root");
        return 1;
    }
    rootSourcePath := path.resolve(path.parentDir(manifestPath), manFiles[0]);
    if fs.kind(rootSourcePath) =!= fs.FILE_KIND_FILE {
        io.errorLine("missing compiler root source: " + rootSourcePath);
        return 1;
    }
    sourceBytes := fs.readBytes(rootSourcePath);
    decoded := unicode.utf8DecodeStrict(sourceBytes);
    if not decoded.ok {
        io.errorLine(rootSourcePath + ": source is not valid UTF-8");
        return 1;
    }
    sourceName := path.relative(rootDir, rootSourcePath);
    rootIdentity := sourceModuleIdentity(rootDir, sourceBytes);

    var outDir := "";
    if outOpt.found {
        outDir = path.resolve(proc.cwd(), outOpt.value);
        mkOut := fs.makeDir(outDir);
        if not mkOut.ok {
            io.errorLine(mkOut.error);
            return 1;
        }
    } else {
        tmpOut := fs.makeTempDir("lite-generated-ladder-");
        if not tmpOut.ok {
            io.errorLine(tmpOut.error);
            return 1;
        }
        outDir = tmpOut.path;
    }
    _pkg := fs.writeText(path.join(outDir, "package.json"), "{\"type\":\"module\"}\n");
    _src := fs.writeBytes(path.join(outDir, "S.lts"), sourceBytes);

    genWorkRes := fs.makeTempDir("lite-ladder-work-");
    if not genWorkRes.ok {
        io.errorLine(genWorkRes.error);
        return 1;
    }
    genWork := genWorkRes.path;

    var builderSha := sel.artifactSha256;
    var builderPath := sel.chosenPath;
    var firstArtifactSha := "";
    var fixedPoint := true;
    var lastArtifactSha := sel.artifactSha256;
    genJsonEntries: mut List<String> = [];
    genPaths: mut List<String> = [];
    genHashes: mut List<String> = [];
    emptyEnv: List<String> = [];
    _unusedId := rootIdentity;
    runnerPath := path.join(genWork, "runner.ts");
    _wRun := cases.writeTsRunner(runnerPath);

    var gen := 1;
    loop gen <= 3 {
        tmpOutTs := path.join(genWork, "gen-" + gen.toText() + ".ts");
        tmpErr := path.join(genWork, "gen-" + gen.toText() + ".stderr");
        compArgs: List<String> = [runnerPath, builderPath, "--stdin", "--name", sourceName, "--root", rootSourcePath, "-O3"];
        startNs := time.monotonicNs();
        compRes := proc.runBytes(project.nodeExecPath(), compArgs, rootDir, emptyEnv, 0, sourceBytes, tmpOutTs, tmpErr);
        compileMs := (time.monotonicNs() - startNs) / 1000000;
        if compRes.error =!= "" {
            _rm := fs.remove(genWork);
            io.errorLine(compRes.error);
            return 1;
        }
        errBytes := fs.readBytes(tmpErr);
        if compRes.status =!= 0 or errBytes.length() =!= 0 {
            _rm := fs.remove(genWork);
            io.errorLine("generation " + gen.toText() + " failed (" + compRes.status.toText() + "):\n" + unicode.utf8DecodeLossy(errBytes));
            return 1;
        }
        chk := checkStrictSingle(rootDir, tmpOutTs);
        if not chk.ok {
            _rm := fs.remove(genWork);
            io.errorLine("strict artifact check failed:\n" + chk.error);
            return 1;
        }
        outBytes := fs.readBytes(tmpOutTs);
        artSha := crypto.sha256Bytes(outBytes);
        genPath := path.join(outDir, "generation-" + gen.toText() + ".ts");
        wGen := fs.writeBytes(genPath, outBytes);
        if not wGen.ok {
            _rm := fs.remove(genWork);
            io.errorLine(wGen.error);
            return 1;
        }
        if gen == 1 {
            firstArtifactSha = artSha;
        } else if artSha =!= firstArtifactSha {
            fixedPoint = false;
        }
        itemJson := "{\n"
        + "      \"generation\": " + gen.toText() + ",\n"
        + "      \"sourceSha256\": " + json.quoteString(sel.sourceSha256) + ",\n"
        + "      \"builderSha256\": " + json.quoteString(builderSha) + ",\n"
        + "      \"artifactSha256\": " + json.quoteString(artSha) + ",\n"
        + "      \"bytes\": " + outBytes.length().toText() + ",\n"
        + "      \"compileProcessMs\": " + compileMs.toText() + ",\n"
        + "      \"strictCheckMs\": " + chk.elapsedMs.toText() + ",\n"
        + "      \"path\": " + json.quoteString(genPath) + "\n    }";
        mut genJsonEntries.pushBack(itemJson);
        mut genPaths.pushBack(genPath);
        mut genHashes.pushBack(artSha);
        builderSha = artSha;
        lastArtifactSha = artSha;
        builderPath = genPath;
        gen = gen + 1;
    }
    _rmWork := fs.remove(genWork);

    var vi := 0;
    loop vi < genPaths.length() {
        persisted := crypto.sha256File(genPaths[vi]);
        if not persisted.ok or persisted.hex =!= genHashes[vi] {
            io.errorLine("persisted generation identity mismatch");
            return 1;
        }
        vi = vi + 1;
    }

    toolPaths: List<String> = [
    "compiler/scripts/self-host.ts", "tools/src/self-host.lts", "lib/util/corpus.lt", "lib/util/compiler-build.lt", "igniter/artifacts.ts"
    ];
    toolsJsonRes := toolIdentitiesJson(rootDir, toolPaths);
    if not toolsJsonRes.ok {
        io.errorLine(toolsJsonRes.error);
        return 1;
    }
    revRes := repoRevision(rootDir);
    revJson := if revRes.found { json.quoteString(revRes.rev) } else { "null" };
    matchesSelected := lastArtifactSha == sel.selectedCompilerSha256;
    equalsBuilder := lastArtifactSha == sel.artifactSha256;

    summary := "{\n"
    + "  \"phase\": \"generated-fixed-point\",\n"
    + "  \"revision\": " + revJson + ",\n"
    + "  \"node\": " + json.quoteString(proc.runtimeVersion()) + ",\n"
    + "  \"out\": " + json.quoteString(outDir) + ",\n"
    + "  \"selected\": {\n"
    + "    \"artifactSha256\": " + json.quoteString(sel.artifactSha256) + ",\n"
    + "    \"currentSourceSha256\": " + json.quoteString(sel.sourceSha256) + ",\n"
    + "    \"selectedCompilerSha256\": " + json.quoteString(sel.selectedCompilerSha256) + ",\n"
    + "    \"selectedCompilerBuilderSha256\": " + json.quoteString(sel.selectedBuilderSha256) + ",\n"
    + "    \"supplied\": " + (if artOpt.found { "true" } else { "false" }) + "\n  },\n"
    + "  \"toolSources\": " + toolsJsonRes.jsonText + ",\n"
    + "  \"source\": {\n"
    + "    \"bytes\": " + sel.totalDepBytes.toText() + ",\n"
    + "    \"sha256\": " + json.quoteString(sel.sourceSha256) + "\n  },\n"
    + "  \"generations\": [\n    " + genJsonEntries.join(",\n    ") + "\n  ],\n"
    + "  \"fixedPoint\": " + (if fixedPoint { "true" } else { "false" }) + ",\n"
    + "  \"matchesSelectedCompiler\": " + (if matchesSelected { "true" } else { "false" }) + ",\n"
    + "  \"equalsSelectedBuilder\": " + (if equalsBuilder { "true" } else { "false" }) + "\n}\n";

    wLadder := fs.writeText(path.join(outDir, "ladder.json"), summary);
    if not wLadder.ok {
        io.errorLine(wLadder.error);
        return 1;
    }
    io.output(summary);
    if fixedPoint { 0 } else { 1 }
};

hasThreeDigits := fn(part: String): Bool {
    part.length() == 3
    and part.at(0).isDigit()
    and part.at(1).isDigit()
    and part.at(2).isDigit()
};

isLowerSlug := fn(slug: String): Bool {
    size := slug.length();
    if size == 0 { return false; }
    var prevDash := true;
    var i := 0;
    loop i < size {
        ch := slug.at(i);
        if ch == "-" {
            if prevDash { return false; }
            prevDash = true;
        } else {
            isAlnum := "abcdefghijklmnopqrstuvwxyz0123456789".indexOf(ch, 0) >= 0;
            if not isAlnum { return false; }
            prevDash = false;
        }
        i = i + 1;
    }
    not prevDash
};

/** Parses `NNN-MMM-slug.json` compiler fixture names into category and slug. */
pub parseFixtureFilename := fn(fileName: String): (ok: Bool, category: String, slug: String) {
    if not fileName.endsWith(".json") or fileName.length() < 14 {
        return (ok = false, category = "", slug = "");
    }
    stem := fileName.slice(0, fileName.length() - 5);
    if stem.at(3) =!= "-" or stem.at(7) =!= "-" {
        return (ok = false, category = "", slug = "");
    }
    catCode := stem.slice(0, 3);
    subCode := stem.slice(4, 7);
    slug := stem.slice(8, stem.length());
    if not hasThreeDigits(catCode) or not hasThreeDigits(subCode) or not isLowerSlug(slug) {
        return (ok = false, category = "", slug = "");
    }
    if catCode =!= "001" and catCode =!= "002" {
        return (ok = false, category = "", slug = "");
    }
    cat := if catCode == "001" { "program" } else { "rejected" };
    (ok = true, category = cat, slug = slug)
};

/** Looks up the recorded TS artifact digest for `slug` inside `current-artifacts.json`. */
pub findRecordedTsHash := fn(refJson: String, artOffsets: List<Int>, slug: String): (found: Bool, tsHash: String) {
    loop artOffsets as pos {
        nameRes := json.readObjectString(refJson, pos, "name");
        if nameRes.found and nameRes.value == slug {
            tsRes := json.readObjectString(refJson, pos, "ts");
            if tsRes.found { return (found = true, tsHash = tsRes.value); }
        }
    }
    (found = false, tsHash = "")
};

/** Returns whether raw compiler streams/exit satisfy the fixture contract. */
pub contractMatchesBytes := fn(
category: String, expExit: Int, expOutBytes: List<Int>, expErrBytes: List<Int>, expectedTsHash: String,
actStatus: Int, actOutBytes: List<Int>, actErrBytes: List<Int>
): Bool {
    if category == "rejected" {
        return actStatus == expExit and streams.equalBytes(actOutBytes, expOutBytes) and streams.equalBytes(actErrBytes, expErrBytes);
    }
    actStatus == 0 and actErrBytes.length() == 0 and ("sha256:" + crypto.sha256Bytes(actOutBytes)) == expectedTsHash
};

/** Validates compiler artifact `artifactPath` against all recorded corpus contracts cleanly. */
pub validateCorpusArtifact := fn(rootDir: String, artifactPath: String, expectedSourceSha: String): (
ok: Bool, cases: Int, programs: Int, rejections: Int, executions: Int,
mismatchCount: Int, firstMismatch: String, jsonBody: String, error: String
) {
    emptyFail := false;
    _unused := emptyFail;
    refPath := path.join(rootDir, "compiler/tests/references/generated/current-artifacts.json");
    refRead := fs.readText(refPath);
    if not refRead.ok {
        return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = refRead.error);
    }
    refSrcHash := json.readObjectString(refRead.text, 0, "sourceSha256");
    if not refSrcHash.found or refSrcHash.value =!= expectedSourceSha {
        return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = "recorded corpus artifacts do not match current Lite compiler source; review their contracts first");
    }
    artField := json.findObjectField(refRead.text, 0, "artifacts");
    artOffsets := json.arrayElementOffsets(refRead.text, artField.valuePos);

    chkComp := checkStrictSingle(rootDir, artifactPath);
    if not chkComp.ok {
        return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = "strict compiler check failed:\n" + chkComp.error);
    }

    compDir := path.join(rootDir, "igniter/tests/compiler");
    fixFiles := path.collectFiles(compDir, [compDir], ".json", [], false);
    if fixFiles.length() == 0 {
        return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = "no compiler fixtures found");
    }

    tmpWorkRes := fs.makeTempDir("lite-corpus-parity-");
    if not tmpWorkRes.ok {
        return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = tmpWorkRes.error);
    }
    workDir := tmpWorkRes.path;
    _wPkg := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    runnerPath := path.join(workDir, "runner.ts");
    _wRun := cases.writeTsRunner(runnerPath);
    emptyEnv: List<String> = [];

    compiledKeys: mut List<String> = [];
    compiledStatus: mut List<Int> = [];
    compiledOutFiles: mut List<String> = [];
    compiledErrFiles: mut List<String> = [];

    distinctProgTexts: mut List<String> = [];
    distinctProgFiles: mut List<String> = [];

    progFixtureFiles: mut List<String> = [];
    progCaseNames: mut List<String> = [];
    progStdinFiles: mut List<String> = [];
    progExpOutFiles: mut List<String> = [];
    progExpErrFiles: mut List<String> = [];
    progExpExits: mut List<Int> = [];
    progSourceIndices: mut List<Int> = [];

    mismatches: mut List<String> = [];
    var totalCases := 0;
    var rejectionMatches := 0;
    var compileSeq := 0;
    var streamSeq := 0;

    loop fixFiles as absFix {
        fileName := path.baseName(absFix);
        parsedFn := parseFixtureFilename(fileName);
        if not parsedFn.ok {
            _rm := fs.remove(workDir);
            return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = fileName + ": invalid compiler fixture filename");
        }
        fixRead := fs.readText(absFix);
        if not fixRead.ok {
            _rm := fs.remove(workDir);
            return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = fixRead.error);
        }
        fixJson := fixRead.text;
        expectedTs := findRecordedTsHash(refRead.text, artOffsets, parsedFn.slug);
        if parsedFn.category == "program" and not expectedTs.found {
            _rm := fs.remove(workDir);
            return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = "missing artifact contract: " + parsedFn.slug);
        }

        srcField := json.findObjectField(fixJson, 0, "source");
        srcCheck := streams.validateStream(fixJson, srcField.valuePos, compDir, fileName + ".source", false, false, true);
        if not srcCheck.ok {
            _rm := fs.remove(workDir);
            return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = srcCheck.error);
        }
        srcFileField := json.readObjectString(fixJson, srcField.valuePos, "file");
        sourceRel := if srcFileField.found { srcFileField.value } else { fileName.slice(0, fileName.length() - 5) + ".lts" };
        sourcePath := path.resolve(compDir, sourceRel);
        fixSourceBytes := streams.readStreamBytes(fixJson, srcField.valuePos, compDir);
        cacheKey := sourcePath + "\n" + crypto.sha256Bytes(fixSourceBytes);

        var cIdx := -1;
        var ki := 0;
        loop ki < compiledKeys.length() {
            if compiledKeys[ki] == cacheKey {
                cIdx = ki;
                break;
            }
            ki = ki + 1;
        }
        if cIdx < 0 {
            outFile := path.join(workDir, "comp-" + compileSeq.toText() + ".out");
            errFile := path.join(workDir, "comp-" + compileSeq.toText() + ".err");
            compArgs: List<String> = [runnerPath, artifactPath, "--stdin", "--name", "", "--root", sourcePath];
            cRes := proc.runBytes(project.nodeExecPath(), compArgs, workDir, emptyEnv, 0, fixSourceBytes, outFile, errFile);
            if cRes.error =!= "" {
                _rm := fs.remove(workDir);
                return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = cRes.error);
            }
            cIdx = compiledKeys.length();
            mut compiledKeys.pushBack(cacheKey);
            mut compiledStatus.pushBack(cRes.status);
            mut compiledOutFiles.pushBack(outFile);
            mut compiledErrFiles.pushBack(errFile);
            compileSeq = compileSeq + 1;
        }

        actStatus := compiledStatus[cIdx];
        actOutBytes := fs.readBytes(compiledOutFiles[cIdx]);
        actErrBytes := fs.readBytes(compiledErrFiles[cIdx]);
        actOutSha := crypto.sha256Bytes(actOutBytes);

        casesField := json.findObjectField(fixJson, 0, "cases");
        loop json.arrayElementOffsets(fixJson, casesField.valuePos) as sPos {
            totalCases = totalCases + 1;
            caseName := json.readObjectString(fixJson, sPos, "name").value;
            expExit := json.readObjectInt(fixJson, sPos, "exitCode").value;

            inField := json.findObjectField(fixJson, sPos, "stdin");
            outField := json.findObjectField(fixJson, sPos, "stdout");
            errField := json.findObjectField(fixJson, sPos, "stderr");
            emptyBytes: List<Int> = [];
            expInBytes := if inField.found { streams.readStreamBytes(fixJson, inField.valuePos, compDir) } else { emptyBytes };
            expOutBytes := if outField.found { streams.readStreamBytes(fixJson, outField.valuePos, compDir) } else { emptyBytes };
            expErrBytes := if errField.found { streams.readStreamBytes(fixJson, errField.valuePos, compDir) } else { emptyBytes };

            matched := contractMatchesBytes(parsedFn.category, expExit, expOutBytes, expErrBytes, expectedTs.tsHash, actStatus, actOutBytes, actErrBytes);
            if parsedFn.category == "rejected" {
                if matched {
                    rejectionMatches = rejectionMatches + 1;
                } else {
                    detail := "status " + actStatus.toText() + ", stderr " + json.quoteString(unicode.utf8DecodeLossy(actErrBytes));
                    mut mismatches.pushBack(fileName + "/" + caseName + ": compiler contract (" + detail + ")");
                }
            } else if not matched {
                detail := "artifact " + actOutSha + ", expected " + expectedTs.tsHash;
                mut mismatches.pushBack(fileName + "/" + caseName + ": compiler contract (" + detail + ")");
            } else {
                var pIdx := -1;
                var pi := 0;
                loop pi < distinctProgTexts.length() {
                    if distinctProgTexts[pi] == actOutSha {
                        pIdx = pi;
                        break;
                    }
                    pi = pi + 1;
                }
                if pIdx < 0 {
                    pIdx = distinctProgTexts.length();
                    progTsPath := path.join(workDir, "prog-" + pIdx.toText() + ".ts");
                    _wp := fs.writeBytes(progTsPath, actOutBytes);
                    mut distinctProgTexts.pushBack(actOutSha);
                    mut distinctProgFiles.pushBack(progTsPath);
                }
                inFile := path.join(workDir, "s-" + streamSeq.toText() + ".in");
                eOutFile := path.join(workDir, "s-" + streamSeq.toText() + ".expout");
                eErrFile := path.join(workDir, "s-" + streamSeq.toText() + ".experr");
                _w1 := fs.writeBytes(inFile, expInBytes);
                _w2 := fs.writeBytes(eOutFile, expOutBytes);
                _w3 := fs.writeBytes(eErrFile, expErrBytes);
                streamSeq = streamSeq + 1;

                mut progFixtureFiles.pushBack(fileName);
                mut progCaseNames.pushBack(caseName);
                mut progStdinFiles.pushBack(inFile);
                mut progExpOutFiles.pushBack(eOutFile);
                mut progExpErrFiles.pushBack(eErrFile);
                mut progExpExits.pushBack(expExit);
                mut progSourceIndices.pushBack(pIdx);
            }
        }
    }

    var executions := 0;
    matchedPrograms := progFixtureFiles.length();
    if distinctProgFiles.length() > 0 {
        chkDir := path.join(workDir, "batch-tsc");
        batchCheck := cases.checkTsArtifactFilesWithStatus(rootDir, distinctProgFiles, chkDir, 60000);
        if not batchCheck.ok {
            _rm := fs.remove(workDir);
            return (ok = false, cases = 0, programs = 0, rejections = 0, executions = 0, mismatchCount = 0, firstMismatch = "", jsonBody = "", error = "strict corpus artifact check failed:\n" + batchCheck.error);
        }
        var si := 0;
        loop si < matchedPrograms {
            tsFile := distinctProgFiles[progSourceIndices[si]];
            inBytes := fs.readBytes(progStdinFiles[si]);
            rOut := path.join(workDir, "run-" + si.toText() + ".out");
            rErr := path.join(workDir, "run-" + si.toText() + ".err");
            runArgs: List<String> = [runnerPath, tsFile];
            ran := proc.runBytes(project.nodeExecPath(), runArgs, workDir, emptyEnv, 10000, inBytes, rOut, rErr);
            executions = executions + 1;
            okRun := ran.error == "" and ran.status == progExpExits[si]
            and streams.equalBytes(fs.readBytes(rOut), fs.readBytes(progExpOutFiles[si]))
            and streams.equalBytes(fs.readBytes(rErr), fs.readBytes(progExpErrFiles[si]));
            if not okRun {
                mut mismatches.pushBack(progFixtureFiles[si] + "/" + progCaseNames[si] + ": runtime contract");
            }
            si = si + 1;
        }
    }

    _rm := fs.remove(workDir);

    quotedMismatches: mut List<String> = [];
    loop mismatches as mm {
        mut quotedMismatches.pushBack(json.quoteString(mm));
    }
    mismatchJson := if quotedMismatches.length() == 0 {
        "[]"
    } else {
        "[\n    " + quotedMismatches.join(",\n    ") + "\n  ]"
    };
    mmCount := mismatches.length();
    firstMm := if mmCount > 0 { mismatches[0] } else { "" };

    body := "{\n"
    + "  \"cases\": " + totalCases.toText() + ",\n"
    + "  \"programs\": " + matchedPrograms.toText() + ",\n"
    + "  \"rejections\": " + rejectionMatches.toText() + ",\n"
    + "  \"executions\": " + executions.toText() + ",\n"
    + "  \"mismatches\": " + mismatchJson + "\n}";

    (ok = true, cases = totalCases, programs = matchedPrograms, rejections = rejectionMatches, executions = executions, mismatchCount = mmCount, firstMismatch = firstMm, jsonBody = body, error = "")
};

/** Validates all 94 recorded corpus contracts against the selected or `--artifact` TS compiler. */
pub runCorpusParityCommand := fn(rootDir: String, args: List<String>): Int {
    allowed: List<String> = ["artifact", "target"];
    optsOk := parseToolOptions(args, allowed);
    if not optsOk.ok {
        io.errorLine(optsOk.error);
        return 1;
    }
    targetOpt := readToolOption(args, "target");
    target := if targetOpt.found { targetOpt.value } else { "ts" };
    if target =!= "ts" and target =!= "c" {
        io.errorLine("--target must be ts or c");
        return 1;
    }
    if target =!= "ts" {
        io.errorLine("C corpus execution is deferred");
        return 1;
    }

    artOpt := readToolOption(args, "artifact");
    sel := checkSeedArtifact(rootDir, artOpt.found, artOpt.value);
    if not sel.ok {
        io.errorLine(sel.error);
        return 1;
    }

    validated := validateCorpusArtifact(rootDir, sel.chosenPath, sel.sourceSha256);
    if not validated.ok {
        io.errorLine(validated.error);
        return 1;
    }

    toolPaths: List<String> = [
    "compiler/scripts/corpus-parity.ts", "tools/src/corpus-parity.lts", "lib/util/corpus.lt", "lib/util/compiler-build.lt", "igniter/artifacts.ts"
    ];
    toolsJsonRes := toolIdentitiesJson(rootDir, toolPaths);
    if not toolsJsonRes.ok {
        io.errorLine(toolsJsonRes.error);
        return 1;
    }

    report := "{\n"
    + "  \"phase\": \"recorded-contracts\",\n"
    + "  \"target\": " + json.quoteString(target) + ",\n"
    + "  \"artifactSha256\": " + json.quoteString(sel.artifactSha256) + ",\n"
    + "  \"sourceSha256\": " + json.quoteString(sel.sourceSha256) + ",\n"
    + "  \"selectedCompilerSha256\": " + json.quoteString(sel.selectedCompilerSha256) + ",\n"
    + "  \"selectedCompilerBuilderSha256\": " + json.quoteString(sel.selectedBuilderSha256) + ",\n"
    + "  \"supplied\": " + (if artOpt.found { "true" } else { "false" }) + ",\n"
    + "  \"toolSources\": " + toolsJsonRes.jsonText + ",\n"
    + "  " + validated.jsonBody.slice(4, validated.jsonBody.length() - 2)
    + "\n}\n";

    io.output(report);
    if validated.mismatchCount == 0 { 0 } else { 1 }
};
