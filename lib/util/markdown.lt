/** Provisional Markdown parsing, heading/anchor extraction, link scanning, and fence checks. */

tb := import "util/text-builder";

findLineEnd := fn(source: String, start: Int, size: Int): Int {
    idx := source.indexOf("\n", start);
    if idx < 0 { size } else { idx }
}

isBlankRest := fn(source: String, fromPos: Int, lineEnd: Int): Bool {
    var i := fromPos;
    loop i < lineEnd {
        if not source.at(i).isWhitespace() { return false; }
        i = i + 1;
    }
    true
}

countRepeatedAt := fn(source: String, start: Int, limit: Int, ch: String): Int {
    var count := 0;
    loop start + count < limit and source.at(start + count) == ch {
        count = count + 1;
    }
    count
}

/** Removes fenced code blocks delimited at column 0 (` ``` ` or `~~~`) so prose scanners skip example code. */
pub stripCodeBlocks := fn(source: String): String {
    if source.indexOf("```", 0) < 0 and source.indexOf("~~~", 0) < 0 {
        return source;
    }
    size := source.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var pos := 0;
    var inFence := false;
    var fenceChar := "";
    var fenceLen := 0;
    var fenceStart := 0;

    loop pos <= size {
        lineEnd := findLineEnd(source, pos, size);
        if not inFence {
            if pos < size {
                ch := source.at(pos);
                if ch == "`" or ch == "~" {
                    cnt := countRepeatedAt(source, pos, lineEnd, ch);
                    if cnt >= 3 {
                        if pos > runStart {
                            mut out.append(source.slice(runStart, pos));
                        }
                        inFence = true;
                        fenceChar = ch;
                        fenceLen = cnt;
                        fenceStart = pos;
                    }
                }
            }
        } else {
            if pos + fenceLen <= lineEnd {
                matches := countRepeatedAt(source, pos, lineEnd, fenceChar);
                if matches == fenceLen and isBlankRest(source, pos + fenceLen, lineEnd) {
                    inFence = false;
                    fenceChar = "";
                    fenceLen = 0;
                    runStart = lineEnd;
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }

    if inFence {
        mut out.append(source.slice(fenceStart, size));
    } else if runStart < size {
        mut out.append(source.slice(runStart, size));
    }
    out.build()
}

/** True when `source` leaves a fenced code block (with up to 3 leading spaces) unclosed at EOF. */
pub hasUnclosedFence := fn(source: String): Bool {
    if source.indexOf("```", 0) < 0 and source.indexOf("~~~", 0) < 0 {
        return false;
    }
    size := source.length();
    var pos := 0;
    var fenceChar := "";
    var fenceLen := 0;

    loop pos < size {
        lineEnd := findLineEnd(source, pos, size);
        var lead := pos;
        var spaces := 0;
        loop lead < lineEnd and spaces < 3 and source.at(lead).isWhitespace() {
            lead = lead + 1;
            spaces = spaces + 1;
        }
        if lead < lineEnd {
            ch := source.at(lead);
            if ch == "`" or ch == "~" {
                cnt := countRepeatedAt(source, lead, lineEnd, ch);
                if cnt >= 3 {
                    if fenceLen == 0 {
                        fenceChar = ch;
                        fenceLen = cnt;
                    } else if ch == fenceChar and cnt >= fenceLen {
                        fenceChar = "";
                        fenceLen = 0;
                    }
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    fenceLen > 0
}

/** Extracts ATX headings (`#`..`######`) from already code-stripped prose. */
pub extractHeadings := fn(proseText: String): List<String> {
    headings: mut List<String> = [];
    if proseText.indexOf("#", 0) < 0 { return headings; }
    size := proseText.length();
    var pos := 0;
    loop pos < size {
        lineEnd := findLineEnd(proseText, pos, size);
        var cleanEnd := lineEnd;
        if cleanEnd > pos and proseText.at(cleanEnd - 1) == "\r" {
            cleanEnd = cleanEnd - 1;
        }
        hashes := countRepeatedAt(proseText, pos, cleanEnd, "#");
        if hashes >= 1 and hashes <= 6 and pos + hashes < cleanEnd {
            afterHash := proseText.at(pos + hashes);
            if afterHash == " " or afterHash == "\t" {
                var bodyStart := pos + hashes + 1;
                loop bodyStart < cleanEnd and proseText.at(bodyStart).isWhitespace() {
                    bodyStart = bodyStart + 1;
                }
                var bodyEnd := cleanEnd;
                loop bodyEnd > bodyStart and proseText.at(bodyEnd - 1).isWhitespace() {
                    bodyEnd = bodyEnd - 1;
                }
                loop bodyEnd > bodyStart and proseText.at(bodyEnd - 1) == "#" {
                    bodyEnd = bodyEnd - 1;
                }
                loop bodyEnd > bodyStart and proseText.at(bodyEnd - 1).isWhitespace() {
                    bodyEnd = bodyEnd - 1;
                }
                if bodyEnd > bodyStart {
                    mut headings.pushBack(proseText.slice(bodyStart, bodyEnd));
                }
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    headings
}

/** Strips HTML tags (`<...>`) from `source`. */
pub stripHtmlTags := fn(source: String): String {
    size := source.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        open := source.indexOf("<", i);
        if open < 0 { break; }
        close := source.indexOf(">", open + 1);
        if close >= 0 {
            if open > runStart { mut out.append(source.slice(runStart, open)); }
            i = close + 1;
            runStart = i;
        } else {
            i = open + 1;
        }
    }
    if runStart == 0 { return source; }
    if runStart < size { mut out.append(source.slice(runStart, size)); }
    out.build()
}

isAsciiPrintablePunct := fn(ch: String): Bool {
    "!\"#$%&'()*+,./:;<=>?@[\\]^`{|}~".contains(ch)
}

isUnicodeNonWordSymbol := fn(ch: String): Bool {
    "—–…“”‘’•·×°§→←↔«»‹›".contains(ch)
}

/** GitHub-style heading slug for fragment matching. */
pub headingAnchor := fn(heading: String): String {
    cleaned := stripHtmlTags(heading.toLowerAscii());
    size := cleaned.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var i := 0;
    loop i < size {
        ch := cleaned.at(i);
        if ch.isWhitespace() {
            if i > runStart { mut out.append(cleaned.slice(runStart, i)); }
            mut out.append("-");
            runStart = i + 1;
        } else if ch == "_" or ch == "-" or ch.isAsciiLetter() or ch.isDigit() {
        } else if isAsciiPrintablePunct(ch) or isUnicodeNonWordSymbol(ch) {
            if i > runStart { mut out.append(cleaned.slice(runStart, i)); }
            runStart = i + 1;
        }
        i = i + 1;
    }
    if runStart == 0 { return cleaned; }
    if runStart < size { mut out.append(cleaned.slice(runStart, size)); }
    out.build()
}

/** Collects GitHub-style heading anchors (including `-1`, `-2` duplicate suffixes) and explicit HTML `id=`/`name=` anchors. */
pub collectAnchors := fn(docText: String): List<String> {
    found: mut List<String> = [];
    foundSet: mut Set<String>;
    slugCounts: mut Map<String, Int>;
    headings := extractHeadings(stripCodeBlocks(docText));

    loop headings as heading {
        slug := headingAnchor(heading);
        dupCount := slugCounts.getOr(slug, 0);
        mut slugCounts.set(slug, dupCount + 1);
        anchor := if dupCount == 0 { slug } else { slug + "-" + dupCount.toText() };
        if not foundSet.has(anchor) {
            mut foundSet.add(anchor);
            mut found.pushBack(anchor);
        }
    }

    if docText.indexOf("id=", 0) < 0 and docText.indexOf("name=", 0) < 0 {
        return found;
    }
    size := docText.length();
    var pos := 0;
    loop pos < size {
        eq := docText.indexOf("=", pos);
        if eq < 0 { break; }
        var isMatch := false;
        if eq - 2 >= pos and docText.startsWithAt(eq - 2, "id=") {
            isMatch = eq - 2 == 0 or not docText.at(eq - 3).isNameContinue();
        } else if eq - 4 >= pos and docText.startsWithAt(eq - 4, "name=") {
            isMatch = eq - 4 == 0 or not docText.at(eq - 5).isNameContinue();
        }
        if isMatch and eq + 1 < size {
            q := docText.at(eq + 1);
            if q == "\"" or q == "'" {
                valStart := eq + 2;
                valEnd := docText.indexOf(q, valStart);
                if valEnd > valStart {
                    val := docText.slice(valStart, valEnd);
                    if not foundSet.has(val) {
                        mut foundSet.add(val);
                        mut found.pushBack(val);
                    }
                    pos = valEnd + 1;
                } else {
                    pos = eq + 1;
                }
            } else {
                pos = eq + 1;
            }
        } else {
            pos = eq + 1;
        }
    }
    found
}

stripInlineCode := fn(proseText: String): String {
    size := proseText.length();
    out: mut tb.TextBuilder;
    var runStart := 0;
    var pos := 0;
    loop pos < size {
        tickPos := proseText.indexOf("`", pos);
        if tickPos < 0 { break; }
        ticks := countRepeatedAt(proseText, tickPos, size, "`");
        closeNeedle := "`".repeat(ticks);
        lineEnd := findLineEnd(proseText, tickPos + ticks, size);
        closeAt := proseText.indexOf(closeNeedle, tickPos + ticks);
        if closeAt >= 0 and closeAt + ticks <= lineEnd {
            if tickPos > runStart { mut out.append(proseText.slice(runStart, tickPos)); }
            pos = closeAt + ticks;
            runStart = pos;
        } else {
            pos = tickPos + ticks;
        }
    }
    if runStart == 0 { return proseText; }
    if runStart < size { mut out.append(proseText.slice(runStart, size)); }
    out.build()
}

/** Extracts inline Markdown link and image destination targets from code-stripped prose. */
pub extractLinkTargets := fn(proseText: String): List<String> {
    links: mut List<String> = [];
    if proseText.indexOf("](", 0) < 0 { return links; }
    clean := stripInlineCode(proseText);
    size := clean.length();
    var pos := 0;

    loop pos < size {
        openPos := clean.indexOf("[", pos);
        if openPos < 0 { break; }
        labelEnd := clean.indexOf("]", openPos + 1);
        if labelEnd < 0 { break; }
        nlPos := clean.indexOf("\n", openPos + 1);
        if (nlPos < 0 or labelEnd < nlPos) and labelEnd + 1 < size and clean.at(labelEnd + 1) == "(" {
            var targetStart := labelEnd + 2;
            if targetStart < size {
                if clean.at(targetStart) == "<" {
                    gtPos := clean.indexOf(">", targetStart + 1);
                    if gtPos > targetStart + 1 {
                        var afterGt := gtPos + 1;
                        var validClose := afterGt < size and clean.at(afterGt) == ")";
                        if not validClose and afterGt < size and clean.at(afterGt).isWhitespace() {
                            loop afterGt < size and clean.at(afterGt).isWhitespace() {
                                afterGt = afterGt + 1;
                            }
                            if afterGt < size and clean.at(afterGt) == "\"" {
                                titleEnd := clean.indexOf("\"", afterGt + 1);
                                if titleEnd >= 0 and titleEnd + 1 < size and clean.at(titleEnd + 1) == ")" {
                                    afterGt = titleEnd + 1;
                                    validClose = true;
                                }
                            }
                        }
                        if validClose {
                            mut links.pushBack(clean.slice(targetStart + 1, gtPos));
                            pos = afterGt + 1;
                        } else {
                            pos = openPos + 1;
                        }
                    } else {
                        pos = openPos + 1;
                    }
                } else {
                    var targetEnd := targetStart;
                    loop targetEnd < size and not clean.at(targetEnd).isWhitespace() and clean.at(targetEnd) =!= ")" {
                        targetEnd = targetEnd + 1;
                    }
                    if targetEnd > targetStart and targetEnd < size {
                        var afterTarget := targetEnd;
                        var validClose := clean.at(afterTarget) == ")";
                        if not validClose and clean.at(afterTarget).isWhitespace() {
                            loop afterTarget < size and clean.at(afterTarget).isWhitespace() {
                                afterTarget = afterTarget + 1;
                            }
                            if afterTarget < size and clean.at(afterTarget) == "\"" {
                                titleEnd := clean.indexOf("\"", afterTarget + 1);
                                if titleEnd >= 0 and titleEnd + 1 < size and clean.at(titleEnd + 1) == ")" {
                                    afterTarget = titleEnd + 1;
                                    validClose = true;
                                }
                            }
                        }
                        if validClose {
                            mut links.pushBack(clean.slice(targetStart, targetEnd));
                            pos = afterTarget + 1;
                        } else {
                            pos = openPos + 1;
                        }
                    } else {
                        pos = openPos + 1;
                    }
                }
            } else {
                pos = openPos + 1;
            }
        } else {
            pos = openPos + 1;
        }
    }
    links
}

/** Extracts bodies of backtick fences delimited at column 0 (` ``` `) in document order. */
pub extractBacktickFenceBodies := fn(docText: String): List<String> {
    bodies: mut List<String> = [];
    if docText.indexOf("```", 0) < 0 { return bodies; }
    size := docText.length();
    var pos := 0;
    var inFence := false;
    var bodyStart := 0;

    loop pos <= size {
        lineEnd := findLineEnd(docText, pos, size);
        if docText.startsWithAt(pos, "```") {
            if not inFence {
                if lineEnd < size {
                    inFence = true;
                    bodyStart = lineEnd + 1;
                }
            } else {
                mut bodies.pushBack(docText.slice(bodyStart, pos));
                inFence = false;
            }
        }
        if lineEnd >= size { break; }
        pos = lineEnd + 1;
    }
    bodies
}
