/** Module API documentation extractor across `lib/core`, `lib/math`, `lib/ds`, `lib/data`, and `lib/extra`. */

fs := import "core/file";
text := import "core/text";
path := import "core/path";
json := import "util/json";
tb := import "util/text-builder";

/** Strips leading block-comment delimiters, trailing close markers, and per-line `*` prefixes from a block comment body. */
cleanDocComment := fn(rawComment: String): String {
    size := rawComment.length();
    var start := 2;
    if start < size and rawComment.at(start) == "*" {
        start += 1;
    }
    var end := size;
    if end - 2 >= start and rawComment.startsWithAt(end - 2, "*/") {
        end -= 2;
    }
    inner := rawComment.slice(start, end);
    innerLen := inner.length();
    cleanedLines: mut List<String> = [];
    var pos := 0;
    loop pos <= innerLen {
        nl := inner.indexOf("\n", pos);
        lineEnd := if nl < 0 { innerLen } else { nl };
        var cleanEnd := lineEnd;
        if cleanEnd > pos and inner.at(cleanEnd - 1) == "\r" {
            cleanEnd -= 1;
        }
        trimmed := inner.slice(pos, cleanEnd).trim();
        var lineBody := trimmed;
        if trimmed.startsWithAt(0, "*") {
            afterStar := trimmed.slice(1, trimmed.length());
            lineBody = if afterStar.startsWithAt(0, " ") {
                afterStar.slice(1, afterStar.length())
            } else {
                afterStar.trimStart()
            };
        }
        (mut cleanedLines).pushBack(lineBody);
        if nl < 0 { break; }
        pos = nl + 1;
    }
    text.joinTexts(cleanedLines, "\n").trim()
};

/** Normalizes internal line breaks and repeated whitespace in a extracted signature string. */
normalizeSignature := fn(raw: String): String {
    size := raw.length();
    out: mut tb.TextBuilder;
    var lastCh := "";
    var i := 0;
    var pendingSpace := false;
    loop i < size {
        ch := raw.at(i);
        if ch.isWhitespace() {
            if lastCh =!= "" {
                pendingSpace = true;
            }
        } else {
            if pendingSpace {
                if lastCh =!= "(" and ch =!= ")" and ch =!= "," {
                    tb.append(mut out, " ");
                }
                pendingSpace = false;
            }
            tb.append(mut out, ch);
            lastCh = ch;
        }
        i += 1;
    }
    tb.build(out).trim()
};

skipBlockComment := fn(source: String, start: Int, startLine: Int): (next: Int, nextLine: Int, raw: String) {
    size := source.length();
    var pos := start + 2;
    var line := startLine;
    var depth := 1;
    loop pos < size and depth > 0 {
        if pos + 1 < size and source.at(pos) == "/" and source.at(pos + 1) == "*" {
            depth += 1;
            pos += 2;
        } else if pos + 1 < size and source.at(pos) == "*" and source.at(pos + 1) == "/" {
            depth -= 1;
            pos += 2;
        } else {
            if source.at(pos) == "\n" { line += 1; }
            pos += 1;
        }
    }
    (next = pos, nextLine = line, raw = source.slice(start, pos))
};

skipStringLiteral := fn(source: String, start: Int, startLine: Int): (next: Int, nextLine: Int) {
    size := source.length();
    var pos := start + 1;
    var line := startLine;
    loop pos < size {
        ch := source.at(pos);
        if ch == "\\" and pos + 1 < size {
            if source.at(pos + 1) == "\n" { line += 1; }
            pos += 2;
        } else if ch == "\"" {
            return (next = pos + 1, nextLine = line);
        } else {
            if ch == "\n" { line += 1; }
            pos += 1;
        }
    }
    (next = pos, nextLine = line)
};

skipLineComment := fn(source: String, start: Int): Int {
    nl := source.indexOf("\n", start);
    if nl < 0 { source.length() } else { nl }
};

skipInlineTrivia := fn(source: String, start: Int, startLine: Int): (next: Int, nextLine: Int) {
    size := source.length();
    var pos := start;
    var line := startLine;
    loop pos < size {
        ch := source.at(pos);
        if ch.isWhitespace() {
            if ch == "\n" { line += 1; }
            pos += 1;
        } else if pos + 1 < size and ch == "/" and source.at(pos + 1) == "/" {
            pos = skipLineComment(source, pos);
        } else if pos + 1 < size and ch == "/" and source.at(pos + 1) == "*" {
            skipped := skipBlockComment(source, pos, line);
            pos = skipped.next;
            line = skipped.nextLine;
        } else {
            break;
        }
    }
    (next = pos, nextLine = line)
};

/** Classifies a module namespace and name into `"universal"`, `"play"`, or `"cli"`. */
classifyEnvironment := fn(namespace: String, name: String): String {
    if namespace == "extra" {
        if name == "canvas" or name == "audio" or name == "board" or name == "surface" {
            return "play";
        }
        return "universal";
    }
    if namespace == "core" and (name == "file" or name == "path" or name == "process" or name == "time") {
        return "cli";
    }
    "universal"
};

/** Extracts module summary and public `type`/`fn`/`const` symbol records from one `.lts` source string as JSON. */
pub extractModuleJson := fn(source: String, namespace: String, name: String, fileRel: String): String {
    size := source.length();
    var pos := 0;
    var line := 1;
    var braceDepth := 0;
    var parenDepth := 0;
    var sawCode := false;
    var moduleSummary := "";
    var pendingDoc := "";
    symbolsJson: mut List<String> = [];

    loop pos < size {
        ch := source.at(pos);
        if ch.isWhitespace() {
            if ch == "\n" { line += 1; }
            pos += 1;
        } else if ch == "\"" {
            sawCode = true;
            lit := skipStringLiteral(source, pos, line);
            pos = lit.next;
            line = lit.nextLine;
        } else if pos + 1 < size and ch == "/" and source.at(pos + 1) == "/" {
            pos = skipLineComment(source, pos);
        } else if pos + 1 < size and ch == "/" and source.at(pos + 1) == "*" {
            isDoc := pos + 2 < size and source.at(pos + 2) == "*" and (pos + 3 >= size or source.at(pos + 3) =!= "/");
            blk := skipBlockComment(source, pos, line);
            if braceDepth == 0 and parenDepth == 0 {
                cleaned := cleanDocComment(blk.raw);
                if not sawCode and moduleSummary == "" and not isDoc {
                    moduleSummary = cleaned;
                } else if not sawCode and moduleSummary == "" and isDoc {
                    var wsPos := blk.next;
                    loop wsPos < size and source.at(wsPos).isWhitespace() { wsPos += 1; }
                    if wsPos < size and not source.wordAt(wsPos, "pub") {
                        moduleSummary = cleaned;
                    } else {
                        pendingDoc = cleaned;
                    }
                } else if isDoc {
                    pendingDoc = cleaned;
                }
            }
            pos = blk.next;
            line = blk.nextLine;
        } else if braceDepth == 0 and parenDepth == 0 and source.wordAt(pos, "pub") {
            sawCode = true;
            declLine := line;
            afterPub := skipInlineTrivia(source, pos + 3, line);
            nameStart := afterPub.next;
            nameEnd := source.skipName(nameStart);
            var declName := source.slice(nameStart, nameEnd);
            var afterName := skipInlineTrivia(source, nameEnd, afterPub.nextLine);
            if declName =!= "" and afterName.next < size and source.at(afterName.next) == "." {
                afterDot := skipInlineTrivia(source, afterName.next + 1, afterName.nextLine);
                var opStart := afterDot.next;
                var hasDollar := false;
                if opStart < size and source.at(opStart) == "$" {
                    hasDollar = true;
                    opStart += 1;
                }
                opEnd := source.skipName(opStart);
                if opEnd > opStart {
                    opPart := (if hasDollar { "$" } else { "" }) + source.slice(opStart, opEnd);
                    declName = declName + "." + opPart;
                    afterName = skipInlineTrivia(source, opEnd, afterDot.nextLine);
                }
            }
            if declName =!= "" and source.startsWithAt(afterName.next, ":=") {
                rhsProbe := skipInlineTrivia(source, afterName.next + 2, afterName.nextLine);
                rhsStart := rhsProbe.next;
                var scanPos := rhsStart;
                var scanLine := rhsProbe.nextLine;
                var scanParen := 0;
                var stoppedAt := "";
                loop scanPos < size {
                    sc := source.at(scanPos);
                    if sc == "\"" {
                        sLit := skipStringLiteral(source, scanPos, scanLine);
                        scanPos = sLit.next;
                        scanLine = sLit.nextLine;
                    } else if scanPos + 1 < size and sc == "/" and source.at(scanPos + 1) == "/" {
                        scanPos = skipLineComment(source, scanPos);
                    } else if scanPos + 1 < size and sc == "/" and source.at(scanPos + 1) == "*" {
                        sBlk := skipBlockComment(source, scanPos, scanLine);
                        scanPos = sBlk.next;
                        scanLine = sBlk.nextLine;
                    } else if sc == "(" {
                        scanParen += 1;
                        scanPos += 1;
                    } else if sc == ")" {
                        if scanParen > 0 { scanParen -= 1; }
                        scanPos += 1;
                    } else if scanParen == 0 and (sc == "{" or sc == ";") {
                        stoppedAt = sc;
                        break;
                    } else {
                        if sc == "\n" { scanLine += 1; }
                        scanPos += 1;
                    }
                }
                rawRhs := source.slice(rhsStart, scanPos);
                normRhs := normalizeSignature(rawRhs);
                var kind := "const";
                if normRhs.wordAt(0, "alias") or normRhs.wordAt(0, "distinct") or normRhs.wordAt(0, "record") or normRhs.wordAt(0, "enum") {
                    kind = "type";
                } else if normRhs.wordAt(0, "fn") or normRhs.startsWithAt(0, "fn<") or normRhs.startsWithAt(0, "fn(") {
                    kind = "fn";
                }
                isHost := kind == "fn" and stoppedAt == ";";
                sig := "pub " + declName + " := " + normRhs + (if stoppedAt == ";" { ";" } else { "" });
                symJson := "{\"kind\":" + json.quoteString(kind) +
                ",\"name\":" + json.quoteString(declName) +
                ",\"signature\":" + json.quoteString(sig) +
                ",\"isHostDeclaration\":" + (if isHost { "true" } else { "false" }) +
                ",\"doc\":" + json.quoteString(pendingDoc) +
                ",\"line\":" + declLine.toText() + "}";
                mut symbolsJson.pushBack(symJson);
                pendingDoc = "";
                pos = scanPos;
                line = scanLine;
            } else {
                pendingDoc = "";
                pos = nameEnd;
                line = afterName.nextLine;
            }
        } else {
            sawCode = true;
            if ch == "{" {
                braceDepth += 1;
            } else if ch == "}" {
                if braceDepth > 0 { braceDepth -= 1; }
                if braceDepth == 0 and parenDepth == 0 {
                    pendingDoc = "";
                }
            } else if ch == "(" {
                parenDepth += 1;
            } else if ch == ")" {
                if parenDepth > 0 { parenDepth -= 1; }
            } else if ch == ";" and braceDepth == 0 and parenDepth == 0 {
                pendingDoc = "";
            }
            if ch == "\n" { line += 1; }
            pos += 1;
        }
    }

    modId := namespace + "/" + name;
    env := classifyEnvironment(namespace, name);
    "{\"id\":" + json.quoteString(modId) +
    ",\"namespace\":" + json.quoteString(namespace) +
    ",\"name\":" + json.quoteString(name) +
    ",\"file\":" + json.quoteString(fileRel) +
    ",\"environment\":" + json.quoteString(env) +
    ",\"summary\":" + json.quoteString(moduleSummary) +
    ",\"symbols\":[" + text.joinTexts(symbolsJson, ",") + "]}"
};

/** Extracts sorted module API documentation records across `lib/core`, `lib/math`, `lib/ds`, `lib/data`, and `lib/extra` `.lt` files under `rootDir`. */
pub extractAllModulesJson := fn(rootDir: String): String {
    namespaces: List<String> = ["core", "math", "ds", "data", "extra"];
    modJsonEntries: mut List<String> = [];
    loop namespaces as ns {
        nsDir := path.join(rootDir, "lib/" + ns);
        if fs.kind(nsDir) == fs.FILE_KIND_DIR {
            entries := fs.listDir(nsDir);
            loop entries as entryName {
                if entryName.endsWith(".lt") {
                    fullPath := path.join(nsDir, entryName);
                    if fs.kind(fullPath) == fs.FILE_KIND_FILE {
                        readRes := fs.readText(fullPath);
                        if readRes.ok {
                            modName := path.stem(entryName);
                            relFile := "lib/" + ns + "/" + entryName;
                            mut modJsonEntries.pushBack(extractModuleJson(readRes.text, ns, modName, relFile));
                        }
                    }
                }
            }
        }
    }
    "[" + text.joinTexts(modJsonEntries, ",") + "]"
};
