/** Provisional case manifest validation and scenario execution utilities for `.case.json` fixtures. */

fs := import "core/file";
proc := import "core/process";
crypto := import "core/crypto";
integer := import "core/int";
text := import "core/text";
list := import "core/list";
path := import "core/path";
json := import "util/json";
streams := import "util/streams";

CASE_KIND_TOOL := "tool";
CASE_KIND_FEATURE := "feature";
CASE_KIND_REJECT := "reject";
CASE_KIND_COMPILE := "compile";
CASE_KIND_SAMPLE := "sample";
CASE_KIND_EXAMPLE := "example";

WORKSPACE_CLEAN := "clean";
WORKSPACE_DIRTY := "dirty";

hasDotDotSegment := fn(relPath: String): Bool {
    size := text.length(relPath);
    var segStart := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        if atEnd or text.at(relPath, i) == "/" or text.at(relPath, i) == "\\" {
            if text.slice(relPath, segStart, i) == ".." { return true; }
            segStart = i + 1;
        }
        i = i + 1;
    }
    false
}

validateStream := fn(source: String, streamPos: Int, directory: String): (ok: Bool, error: String) {
    checked := streams.validateStream(source, streamPos, directory, "stream", false, false, true);
    (ok = checked.ok, error = checked.error)
}

/** Validates one `.case.json` manifest file cleanly, returning `id` on success. */
pub validateCaseFile := fn(rootDir: String, caseFile: String): (ok: Bool, id: String, error: String) {
    readRes := fs.readText(caseFile);
    if not readRes.ok { return (ok = false, id = "", error = caseFile + ": " + readRes.error); }
    textSrc := readRes.text;
    validJson := json.validate(textSrc);
    if not validJson.ok { return (ok = false, id = "", error = caseFile + ": " + validJson.error); }

    topKeys := json.objectKeys(textSrc, 0);
    allowedTop: List<String> = ["id", "kind", "pending", "features", "cases", "benchmark", "tool", "source"];
    loop topKeys as k {
        if not list.listContainsText(allowedTop, k) {
            return (ok = false, id = "", error = caseFile + ": unexpected case key " + k);
        }
    }

    idRes := json.readObjectString(textSrc, 0, "id");
    if not idRes.found or not idRes.ok or idRes.value == "" {
        return (ok = false, id = "", error = caseFile + ": case ID required");
    }
    caseId := idRes.value;

    kindRes := json.readObjectString(textSrc, 0, "kind");
    validKinds: List<String> = [
    CASE_KIND_TOOL, CASE_KIND_FEATURE, CASE_KIND_REJECT,
    CASE_KIND_COMPILE, CASE_KIND_SAMPLE, CASE_KIND_EXAMPLE
    ];
    if not kindRes.found or not kindRes.ok or not list.listContainsText(validKinds, kindRes.value) {
        return (ok = false, id = "", error = caseFile + ": invalid case kind");
    }
    kind := kindRes.value;

    pendingField := json.findObjectField(textSrc, 0, "pending");
    if pendingField.found {
        pStr := json.readStringAt(textSrc, pendingField.valuePos);
        if kind == CASE_KIND_TOOL or not pStr.ok or text.trim(pStr.value) == "" {
            return (ok = false, id = "", error = caseFile + ": pending needs a language case and reason");
        }
    }

    caseDir := path.parentDir(caseFile);
    if kind == CASE_KIND_TOOL {
        if json.findObjectField(textSrc, 0, "source").found {
            return (ok = false, id = "", error = caseFile + ": tool cases name a tool, not a case executable");
        }
        toolRes := json.readObjectString(textSrc, 0, "tool");
        if not toolRes.found or not toolRes.ok or text.containsText(toolRes.value, "/") or fs.kind(path.join(rootDir, "bin/" + toolRes.value)) == fs.FILE_KIND_MISSING {
            return (ok = false, id = "", error = caseFile + ": unknown tool");
        }
    } else {
        srcRes := json.readObjectString(textSrc, 0, "source");
        if not srcRes.found or not srcRes.ok or not text.endsWith(srcRes.value, ".lts") {
            return (ok = false, id = "", error = caseFile + ": Lite source must use .lts");
        }
        if fs.kind(path.resolve(caseDir, srcRes.value)) =!= fs.FILE_KIND_FILE {
            return (ok = false, id = "", error = caseFile + ": missing case source " + srcRes.value);
        }
    }

    featField := json.findObjectField(textSrc, 0, "features");
    if not featField.found { return (ok = false, id = "", error = caseFile + ": features must be an array"); }
    seenFeatures: mut List<String> = [];
    loop json.arrayElementOffsets(textSrc, featField.valuePos) as fPos {
        fStr := json.readStringAt(textSrc, fPos);
        if not fStr.ok { return (ok = false, id = "", error = caseFile + ": features must be strings"); }
        if list.listContainsText(seenFeatures, fStr.value) {
            return (ok = false, id = "", error = caseFile + ": duplicate feature IDs");
        }
        list.pushBack(mut seenFeatures, fStr.value);
    }

    casesField := json.findObjectField(textSrc, 0, "cases");
    if not casesField.found { return (ok = false, id = "", error = caseFile + ": case scenarios required"); }
    scenarios := json.arrayElementOffsets(textSrc, casesField.valuePos);
    if list.listCountInt(scenarios) == 0 {
        return (ok = false, id = "", error = caseFile + ": case scenarios required");
    }

    allowedScenario: List<String> = ["name", "args", "stdin", "stdout", "stderr", "exitCode", "timeoutMs", "artifact", "inputFiles", "outputFiles", "workspace", "tag", "files"];
    seenScenarios: mut List<String> = [];
    loop scenarios as sPos {
        loop json.objectKeys(textSrc, sPos) as sk {
            if not list.listContainsText(allowedScenario, sk) {
                return (ok = false, id = "", error = caseFile + ": unexpected scenario key " + sk);
            }
        }
        nameRes := json.readObjectString(textSrc, sPos, "name");
        if not nameRes.found or not nameRes.ok or nameRes.value == "" or list.listContainsText(seenScenarios, nameRes.value) {
            return (ok = false, id = "", error = caseFile + ": scenario names must be unique");
        }
        list.pushBack(mut seenScenarios, nameRes.value);

        codeRes := json.readObjectInt(textSrc, sPos, "exitCode");
        if not codeRes.found or not codeRes.ok or codeRes.value < 0 or codeRes.value > 255 {
            return (ok = false, id = "", error = caseFile + ": invalid exit status");
        }
        timeoutRes := json.readObjectInt(textSrc, sPos, "timeoutMs");
        if timeoutRes.found and (not timeoutRes.ok or timeoutRes.value <= 0 or timeoutRes.value > 600000) {
            return (ok = false, id = "", error = caseFile + ": invalid timeout");
        }
        argsField := json.findObjectField(textSrc, sPos, "args");
        if argsField.found {
            loop json.arrayElementOffsets(textSrc, argsField.valuePos) as aPos {
                aStr := json.readStringAt(textSrc, aPos);
                if not aStr.ok { return (ok = false, id = "", error = caseFile + ": invalid arguments"); }
            }
        }

        stdinField := json.findObjectField(textSrc, sPos, "stdin");
        stdoutField := json.findObjectField(textSrc, sPos, "stdout");
        stderrField := json.findObjectField(textSrc, sPos, "stderr");
        if not stdinField.found or not stdoutField.found or not stderrField.found {
            return (ok = false, id = "", error = caseFile + ": missing stream");
        }
        s1 := validateStream(textSrc, stdinField.valuePos, caseDir);
        if not s1.ok { return (ok = false, id = "", error = s1.error); }
        s2 := validateStream(textSrc, stdoutField.valuePos, caseDir);
        if not s2.ok { return (ok = false, id = "", error = s2.error); }
        s3 := validateStream(textSrc, stderrField.valuePos, caseDir);
        if not s3.ok { return (ok = false, id = "", error = s3.error); }

        inFilesField := json.findObjectField(textSrc, sPos, "inputFiles");
        if inFilesField.found {
            if kind =!= CASE_KIND_FEATURE and kind =!= CASE_KIND_SAMPLE and kind =!= CASE_KIND_EXAMPLE {
                return (ok = false, id = "", error = caseFile + ": file fixtures need a runnable Lite case");
            }
            loop json.objectKeys(textSrc, inFilesField.valuePos) as fname {
                if fname == "" or path.isAbsolute(fname) or hasDotDotSegment(fname) {
                    return (ok = false, id = "", error = caseFile + ": file fixture paths must stay inside the case workspace");
                }
                fv := json.findObjectField(textSrc, inFilesField.valuePos, fname);
                vs := validateStream(textSrc, fv.valuePos, caseDir);
                if not vs.ok { return (ok = false, id = "", error = vs.error); }
            }
        }
        outFilesField := json.findObjectField(textSrc, sPos, "outputFiles");
        if outFilesField.found {
            if kind =!= CASE_KIND_FEATURE and kind =!= CASE_KIND_SAMPLE and kind =!= CASE_KIND_EXAMPLE {
                return (ok = false, id = "", error = caseFile + ": file fixtures need a runnable Lite case");
            }
            loop json.objectKeys(textSrc, outFilesField.valuePos) as fname {
                if fname == "" or path.isAbsolute(fname) or hasDotDotSegment(fname) {
                    return (ok = false, id = "", error = caseFile + ": file fixture paths must stay inside the case workspace");
                }
                fv := json.findObjectField(textSrc, outFilesField.valuePos, fname);
                vs := validateStream(textSrc, fv.valuePos, caseDir);
                if not vs.ok { return (ok = false, id = "", error = vs.error); }
            }
        }
        artField := json.findObjectField(textSrc, sPos, "artifact");
        if artField.found {
            if kind =!= CASE_KIND_COMPILE { return (ok = false, id = "", error = caseFile + ": only compile cases compare generated artifacts"); }
            vs := validateStream(textSrc, artField.valuePos, caseDir);
            if not vs.ok { return (ok = false, id = "", error = vs.error); }
        }
        wsRes := json.readObjectString(textSrc, sPos, "workspace");
        if wsRes.found and (kind =!= CASE_KIND_TOOL or not wsRes.ok or (wsRes.value =!= WORKSPACE_CLEAN and wsRes.value =!= WORKSPACE_DIRTY)) {
            return (ok = false, id = "", error = caseFile + ": invalid workspace");
        }
        tagField := json.findObjectField(textSrc, sPos, "tag");
        if tagField.found {
            tName := json.readObjectString(textSrc, tagField.valuePos, "name");
            tAnn := json.readObjectBool(textSrc, tagField.valuePos, "annotated");
            if not wsRes.found or not tName.found or not tName.ok or not tAnn.found or not tAnn.ok {
                return (ok = false, id = "", error = caseFile + ": invalid fixture tag");
            }
        }
        filesField := json.findObjectField(textSrc, sPos, "files");
        if filesField.found {
            if kind =!= CASE_KIND_TOOL { return (ok = false, id = "", error = caseFile + ": invalid artifact paths"); }
            loop json.arrayElementOffsets(textSrc, filesField.valuePos) as fpPos {
                fpStr := json.readStringAt(textSrc, fpPos);
                if not fpStr.ok or fpStr.value == "" or path.isAbsolute(fpStr.value) or hasDotDotSegment(fpStr.value) {
                    return (ok = false, id = "", error = caseFile + ": invalid artifact paths");
                }
            }
        }
    }

    benchField := json.findObjectField(textSrc, 0, "benchmark");
    if benchField.found {
        allowedBench: List<String> = ["warmups", "samples"];
        loop json.objectKeys(textSrc, benchField.valuePos) as bk {
            if not list.listContainsText(allowedBench, bk) {
                return (ok = false, id = "", error = caseFile + ": unexpected benchmark key " + bk);
            }
        }
        wRes := json.readObjectInt(textSrc, benchField.valuePos, "warmups");
        smRes := json.readObjectInt(textSrc, benchField.valuePos, "samples");
        if not wRes.found or not wRes.ok or wRes.value < 0 or not smRes.found or not smRes.ok or smRes.value < 1 {
            return (ok = false, id = "", error = caseFile + ": invalid benchmark counts");
        }
    }
    (ok = true, id = caseId, error = "")
}

/** Discovers all `.case.json` manifest files under `language/cases` and `tools/cases` in sorted order. */
pub discoverAllCaseFiles := fn(rootDir: String): List<String> {
    roots: List<String> = [path.join(rootDir, "language/cases"), path.join(rootDir, "tools/cases")];
    ignored: List<String> = [];
    path.collectFiles(rootDir, roots, ".case.json", ignored, false)
}

/** Returns true when `candidate` matches `filter` (literal substring or `*` wildcard glob). */
pub matchesCaseFilter := fn(candidate: String, filter: String): Bool {
    if filter == "" { return true; }
    if not text.containsText(filter, "*") {
        return text.containsText(candidate, filter);
    }
    filterLen := text.length(filter);
    startsWild := text.at(filter, 0) == "*";
    endsWild := text.at(filter, filterLen - 1) == "*";
    parts: mut List<String> = [];
    var segStart := 0;
    var i := 0;
    loop i <= filterLen {
        atEnd := i == filterLen;
        if atEnd or text.at(filter, i) == "*" {
            if i > segStart {
                list.pushBack(mut parts, text.slice(filter, segStart, i));
            }
            segStart = i + 1;
        }
        i = i + 1;
    }
    partCount := list.listCountText(parts);
    if partCount == 0 { return true; }
    candLen := text.length(candidate);
    var cursor := 0;
    var idx := 0;
    loop idx < partCount {
        part := parts[idx];
        partLen := text.length(part);
        if idx == 0 and not startsWild {
            if not text.startsWithAt(candidate, 0, part) { return false; }
            cursor = partLen;
        } else if idx == partCount - 1 and not endsWild {
            if candLen < partLen or cursor > candLen - partLen or not text.endsWith(candidate, part) {
                return false;
            }
            cursor = candLen;
        } else {
            found := text.indexOfText(candidate, part, cursor);
            if found < 0 { return false; }
            cursor = found + partLen;
        }
        idx = idx + 1;
    }
    true
}

/** Returns true when `candidate` matches `pattern` as a full or unanchored `*`-wildcard glob. */
pub globMatch := fn(candidate: String, pattern: String): Bool {
    if matchesCaseFilter(candidate, pattern) { return true; }
    text.containsText(pattern, "*") and matchesCaseFilter(candidate, "*" + pattern + "*")
}

matchesCaseEntry := fn(rootDir: String, caseId: String, caseFile: String, filter: String): Bool {
    if filter == "" { return true; }
    if matchesCaseFilter(caseId, filter) { return true; }
    relFile := path.relative(rootDir, caseFile);
    matchesCaseFilter(relFile, filter)
}

/** Validates all discovered cases, ensures unique IDs, and verifies at least one case matches `filter`. */
pub validateCaseSet := fn(rootDir: String, filter: String): (ok: Bool, matchCount: Int, error: String) {
    files := discoverAllCaseFiles(rootDir);
    if list.listCountText(files) == 0 {
        return (ok = false, matchCount = 0, error = "no cases found");
    }
    seenIds: mut List<String> = [];
    var matches := 0;
    loop files as caseFile {
        checked := validateCaseFile(rootDir, caseFile);
        if not checked.ok { return (ok = false, matchCount = 0, error = checked.error); }
        if list.listContainsText(seenIds, checked.id) {
            return (ok = false, matchCount = 0, error = "duplicate case IDs");
        }
        list.pushBack(mut seenIds, checked.id);
        if matchesCaseEntry(rootDir, checked.id, caseFile, filter) {
            matches = matches + 1;
        }
    }
    if matches == 0 {
        return (ok = false, matchCount = 0, error = "no cases match: " + filter);
    }
    (ok = true, matchCount = matches, error = "")
}

/** Returns discovered `.case.json` files whose manifest `id` or path matches `filter`. */
pub selectCaseFiles := fn(rootDir: String, filter: String): List<String> {
    files := discoverAllCaseFiles(rootDir);
    if filter == "" { return files; }
    selected: mut List<String> = [];
    loop files as caseFile {
        readRes := fs.readText(caseFile);
        if readRes.ok {
            idRes := json.readObjectString(readRes.text, 0, "id");
            if idRes.found and idRes.ok and matchesCaseEntry(rootDir, idRes.value, caseFile, filter) {
                list.pushBack(mut selected, caseFile);
            }
        }
    }
    selected
}

/** Discovers and validates all `.case.json` manifests under `language/cases` and `tools/cases`. */
pub validateAllCases := fn(rootDir: String): (ok: Bool, error: String) {
    checked := validateCaseSet(rootDir, "");
    (ok = checked.ok, error = checked.error)
}

/** Validates `caseFile` and reads its top-level manifest metadata fields cleanly. */
pub readCaseMeta := fn(rootDir: String, caseFile: String): (ok: Bool, id: String, kind: String, pending: String, hasPending: Bool, tool: String, source: String, hasBenchmark: Bool, warmups: Int, samples: Int, scenarioCount: Int, error: String) {
    absFile := path.resolve(proc.cwd(), caseFile);
    checked := validateCaseFile(rootDir, absFile);
    if not checked.ok {
        return (
        ok = false, id = "", kind = "", pending = "", hasPending = false,
        tool = "", source = "", hasBenchmark = false, warmups = 0, samples = 0,
        scenarioCount = 0, error = checked.error,
        );
    }
    src := fs.readText(absFile).text;
    kind := json.readObjectString(src, 0, "kind").value;
    pendRes := json.readObjectString(src, 0, "pending");
    toolRes := json.readObjectString(src, 0, "tool");
    srcRes := json.readObjectString(src, 0, "source");
    benchField := json.findObjectField(src, 0, "benchmark");
    var warmups := 0;
    var samples := 0;
    if benchField.found {
        warmups = json.readObjectInt(src, benchField.valuePos, "warmups").value;
        samples = json.readObjectInt(src, benchField.valuePos, "samples").value;
    }
    casesField := json.findObjectField(src, 0, "cases");
    scenarios := json.arrayElementOffsets(src, casesField.valuePos);
    (
    ok = true, id = checked.id, kind = kind,
    pending = if pendRes.found { pendRes.value } else { "" },
    hasPending = pendRes.found,
    tool = if toolRes.found { toolRes.value } else { "" },
    source = if srcRes.found { srcRes.value } else { "" },
    hasBenchmark = benchField.found,
    warmups = warmups, samples = samples,
    scenarioCount = list.listCountInt(scenarios),
    error = "",
    )
}

/** Returns the `name` field for scenario `scenarioIdx` in `caseFile`. */
pub readScenarioName := fn(caseFile: String, scenarioIdx: Int): String {
    absFile := path.resolve(proc.cwd(), caseFile);
    readRes := fs.readText(absFile);
    if not readRes.ok { return ""; }
    casesField := json.findObjectField(readRes.text, 0, "cases");
    if not casesField.found { return ""; }
    scenarios := json.arrayElementOffsets(readRes.text, casesField.valuePos);
    if scenarioIdx < 0 or scenarioIdx >= list.listCountInt(scenarios) { return ""; }
    json.readObjectString(readRes.text, scenarios[scenarioIdx], "name").value
}

readFileDiagnostic := fn(filePath: String, byteCount: Int): String {
    res := fs.readText(filePath);
    if res.ok { return res.text; }
    "(binary output, " + integer.intText(byteCount) + " bytes)"
}

buildTsConfigFilesText := fn(rootDir: String, files: List<String>): (ok: Bool, text: String, error: String) {
    cfgPath := path.join(rootDir, "igniter/tsconfig.json");
    cfgRes := fs.readText(cfgPath);
    if not cfgRes.ok { return (ok = false, text = "", error = cfgPath + ": " + cfgRes.error); }
    optsField := json.findObjectField(cfgRes.text, 0, "compilerOptions");
    if not optsField.found { return (ok = false, text = "", error = cfgPath + ": missing compilerOptions"); }

    parts: mut List<String> = [];
    loop json.objectKeys(cfgRes.text, optsField.valuePos) as key {
        if key =!= "types" and key =!= "typeRoots" and key =!= "lib" {
            valField := json.findObjectField(cfgRes.text, optsField.valuePos, key);
            span := json.valueSpan(cfgRes.text, valField.valuePos);
            if not span.ok { return (ok = false, text = "", error = cfgPath + ": invalid compilerOptions." + key); }
            list.pushBack(mut parts, json.quoteString(key) + ":" + text.slice(cfgRes.text, span.start, span.end));
        }
    }
    list.pushBack(mut parts, "\"types\":[]");
    list.pushBack(mut parts, "\"typeRoots\":[]");
    list.pushBack(mut parts, "\"lib\":[\"ESNext\"]");

    quotedFiles: mut List<String> = [];
    loop files as f {
        list.pushBack(mut quotedFiles, json.quoteString(f));
    }
    body := "{\"compilerOptions\":{" + text.joinTexts(parts, ",") + "},\"files\":[" + text.joinTexts(quotedFiles, ",") + "]}\n";
    (ok = true, text = body, error = "")
}

/** Strict-typechecks one or more emitted TypeScript files inside `workDir` with `timeoutMs` (`<= 0` disables timeout). */
pub checkTsArtifactFilesWithStatus := fn(rootDir: String, files: List<String>, workDir: String, timeoutMs: Int): (ok: Bool, status: Int, error: String) {
    mkRes := fs.makeDir(workDir);
    if not mkRes.ok { return (ok = false, status = -1, error = mkRes.error); }
    pkgRes := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    if not pkgRes.ok { return (ok = false, status = -1, error = pkgRes.error); }

    localFiles: mut List<String> = [];
    var idx := 0;
    loop files as srcFile {
        localFile := path.join(workDir, "artifact-" + integer.intText(idx) + ".ts");
        copyArt := fs.copy(srcFile, localFile);
        if not copyArt.ok { return (ok = false, status = -1, error = copyArt.error); }
        list.pushBack(mut localFiles, localFile);
        idx = idx + 1;
    }

    cfgRes := buildTsConfigFilesText(rootDir, localFiles);
    if not cfgRes.ok { return (ok = false, status = -1, error = cfgRes.error); }
    tsconfigPath := path.join(workDir, "tsconfig.json");
    wCfg := fs.writeText(tsconfigPath, cfgRes.text);
    if not wCfg.ok { return (ok = false, status = -1, error = wCfg.error); }

    exeName := if proc.platform() == "win32" { "tsc.exe" } else { "tsc" };
    nativeTsc := path.join(rootDir, "igniter/node_modules/@typescript/typescript-" + proc.platform() + "-" + proc.arch() + "/lib/" + exeName);
    outPath := path.join(workDir, "tsc.stdout");
    errPath := path.join(workDir, "tsc.stderr");
    emptyBytes: List<Int> = [];
    emptyEnv: List<String> = [];

    var status := -1;
    var procErr := "";
    if fs.kind(nativeTsc) == fs.FILE_KIND_FILE {
        args: List<String> = ["-p", tsconfigPath];
        res := proc.runBytes(nativeTsc, args, workDir, emptyEnv, timeoutMs, emptyBytes, outPath, errPath);
        status = res.status;
        procErr = res.error;
    } else {
        args: List<String> = [path.join(rootDir, "igniter/node_modules/typescript/bin/tsc"), "-p", tsconfigPath];
        res := proc.runBytes(proc.execPath(), args, workDir, emptyEnv, timeoutMs, emptyBytes, outPath, errPath);
        status = res.status;
        procErr = res.error;
    }

    if procErr =!= "" { return (ok = false, status = status, error = procErr); }
    if status =!= 0 {
        errBytes := fs.readBytes(errPath);
        outBytes := fs.readBytes(outPath);
        msg := if list.listCountInt(errBytes) > 0 { readFileDiagnostic(errPath, list.listCountInt(errBytes)) } else { readFileDiagnostic(outPath, list.listCountInt(outBytes)) };
        return (ok = false, status = status, error = msg);
    }
    (ok = true, status = 0, error = "")
}

/** Strict-typechecks emitted TypeScript `artifactPath` inside `workDir` with `timeoutMs` (`<= 0` disables timeout). */
pub checkTsArtifactFileWithStatus := fn(rootDir: String, artifactPath: String, workDir: String, timeoutMs: Int): (ok: Bool, status: Int, error: String) {
    files: List<String> = [artifactPath];
    checkTsArtifactFilesWithStatus(rootDir, files, workDir, timeoutMs)
}

/** Strict-typechecks emitted TypeScript `artifactPath` inside `workDir` using native or JS `tsc`. */
pub checkTsArtifactFile := fn(rootDir: String, artifactPath: String, workDir: String): (ok: Bool, error: String) {
    checked := checkTsArtifactFileWithStatus(rootDir, artifactPath, workDir, 30000);
    (ok = checked.ok, error = checked.error)
}

runCaseGit := fn(projDir: String, gitArgs: List<String>): (ok: Bool, error: String) {
    args: mut List<String> = [
    "-c", "user.name=Case fixture", "-c", "user.email=fixture@example.invalid",
    "-c", "commit.gpgSign=false", "-c", "tag.gpgSign=false",
    "-c", "maintenance.auto=false", "-c", "gc.auto=0",
    ];
    loop gitArgs as gArg {
        list.pushBack(mut args, gArg);
    }
    emptyEnv: List<String> = [];
    res := proc.run("git", args, projDir, emptyEnv, true, "");
    if res.error =!= "" { return (ok = false, error = res.error); }
    if res.status =!= 0 { return (ok = false, error = "git failed: " + res.stdout + res.stderr); }
    (ok = true, error = "")
}

prepareToolWorkspace := fn(rootDir: String, caseText: String, sPos: Int, workDir: String): (ok: Bool, workspace: String, error: String) {
    wsRes := json.readObjectString(caseText, sPos, "workspace");
    if not wsRes.found { return (ok = true, workspace = rootDir, error = ""); }

    projDir := path.join(workDir, "project");
    topSkip: List<String> = [".git", "node_modules", "dist", ".cache"];
    nestedSkip: List<String> = ["node_modules"];
    copied := path.copyFiltered(rootDir, projDir, topSkip, nestedSkip);
    if not copied.ok { return (ok = false, workspace = "", error = copied.error); }

    g1 := runCaseGit(projDir, ["init", "-b", "main"]);
    if not g1.ok { return (ok = false, workspace = "", error = g1.error); }
    g2 := runCaseGit(projDir, ["add", "."]);
    if not g2.ok { return (ok = false, workspace = "", error = g2.error); }
    g3 := runCaseGit(projDir, ["commit", "-m", "case fixture"]);
    if not g3.ok { return (ok = false, workspace = "", error = g3.error); }

    tagField := json.findObjectField(caseText, sPos, "tag");
    if tagField.found {
        tName := json.readObjectString(caseText, tagField.valuePos, "name").value;
        tAnn := json.readObjectBool(caseText, tagField.valuePos, "annotated").value;
        if tAnn {
            gt := runCaseGit(projDir, ["tag", "-a", tName, "-m", tName]);
            if not gt.ok { return (ok = false, workspace = "", error = gt.error); }
        } else {
            gt := runCaseGit(projDir, ["tag", tName]);
            if not gt.ok { return (ok = false, workspace = "", error = gt.error); }
        }
    }
    if wsRes.value == WORKSPACE_DIRTY {
        wDirty := fs.writeText(path.join(projDir, "uncommitted.txt"), "dirty\n");
        if not wDirty.ok { return (ok = false, workspace = "", error = wDirty.error); }
    }
    (ok = true, workspace = projDir, error = "")
}

readStringListAt := fn(caseText: String, arrPos: Int): List<String> {
    items: mut List<String> = [];
    loop json.arrayElementOffsets(caseText, arrPos) as elPos {
        s := json.readStringAt(caseText, elPos);
        if s.ok { list.pushBack(mut items, s.value); }
    }
    items
}

verifyScenarioInWork := fn(rootDir: String, absFile: String, scenarioIdx: Int, work: String): (ok: Bool, artifactSha: String, error: String) {
    checked := validateCaseFile(rootDir, absFile);
    if not checked.ok { return (ok = false, artifactSha = "", error = checked.error); }
    caseText := fs.readText(absFile).text;
    caseId := checked.id;

    pendRes := json.readObjectString(caseText, 0, "pending");
    if pendRes.found {
        return (ok = false, artifactSha = "", error = caseId + ": pending: " + pendRes.value);
    }

    casesField := json.findObjectField(caseText, 0, "cases");
    scenarios := json.arrayElementOffsets(caseText, casesField.valuePos);
    if scenarioIdx < 0 or scenarioIdx >= list.listCountInt(scenarios) {
        return (ok = false, artifactSha = "", error = caseId + ": invalid scenario index");
    }
    sPos := scenarios[scenarioIdx];
    sName := json.readObjectString(caseText, sPos, "name").value;
    label := caseId + "/" + sName;
    kind := json.readObjectString(caseText, 0, "kind").value;
    caseDir := path.parentDir(absFile);

    timeoutRes := json.readObjectInt(caseText, sPos, "timeoutMs");
    timeoutMs := if timeoutRes.found { timeoutRes.value } else { 30000 };
    argsField := json.findObjectField(caseText, sPos, "args");
    emptyStrings: List<String> = [];
    scenarioArgs := if argsField.found { readStringListAt(caseText, argsField.valuePos) } else { emptyStrings };

    stdinField := json.findObjectField(caseText, sPos, "stdin");
    stdoutField := json.findObjectField(caseText, sPos, "stdout");
    stderrField := json.findObjectField(caseText, sPos, "stderr");
    stdinBytes := streams.readStreamBytes(caseText, stdinField.valuePos, caseDir);
    expectedStdout := streams.readStreamBytes(caseText, stdoutField.valuePos, caseDir);
    expectedStderr := streams.readStreamBytes(caseText, stderrField.valuePos, caseDir);
    expectedExit := json.readObjectInt(caseText, sPos, "exitCode").value;

    emptyBytes: List<Int> = [];
    emptyEnv: List<String> = [];

    var actualStatus := -1;
    var actualStdout: mut List<Int> = [];
    var actualStderr: mut List<Int> = [];
    var actualStderrPath := "";
    var artifactSha := "";
    var workspace := rootDir;

    if kind == CASE_KIND_TOOL {
        wsRes := prepareToolWorkspace(rootDir, caseText, sPos, work);
        if not wsRes.ok { return (ok = false, artifactSha = "", error = wsRes.error); }
        workspace = wsRes.workspace;
        toolName := json.readObjectString(caseText, 0, "tool").value;

        cmdArgs: mut List<String> = [path.join(workspace, "bin/" + toolName)];
        loop scenarioArgs as arg {
            list.pushBack(mut cmdArgs, arg);
        }
        outPath := path.join(work, "tool.stdout");
        errPath := path.join(work, "tool.stderr");
        runRes := proc.runBytes(proc.execPath(), cmdArgs, workspace, emptyEnv, timeoutMs, stdinBytes, outPath, errPath);
        if runRes.error =!= "" { return (ok = false, artifactSha = "", error = runRes.error); }
        actualStatus = runRes.status;
        actualStdout = fs.readBytes(outPath);
        actualStderr = fs.readBytes(errPath);
        actualStderrPath = errPath;
    } else {
        sourceRel := json.readObjectString(caseText, 0, "source").value;
        compileArg := path.relative(rootDir, path.resolve(caseDir, sourceRel));
        compArgs: List<String> = [path.join(rootDir, "bin/lite-compile"), compileArg];
        compOutPath := path.join(work, "compile.stdout");
        compErrPath := path.join(work, "compile.stderr");
        compiled := proc.runBytes(proc.execPath(), compArgs, rootDir, emptyEnv, timeoutMs, emptyBytes, compOutPath, compErrPath);
        if compiled.error =!= "" { return (ok = false, artifactSha = "", error = compiled.error); }

        compOutBytes := fs.readBytes(compOutPath);
        compErrBytes := fs.readBytes(compErrPath);
        outputTsPath := path.join(work, "program.lts.ts");

        if compiled.status == 0 {
            copied := fs.copy(compOutPath, outputTsPath);
            if not copied.ok { return (ok = false, artifactSha = "", error = copied.error); }
            tsCheck := checkTsArtifactFile(rootDir, outputTsPath, path.join(work, "tsc-check"));
            if not tsCheck.ok { return (ok = false, artifactSha = "", error = tsCheck.error); }
            hashRes := crypto.sha256File(outputTsPath);
            if not hashRes.ok { return (ok = false, artifactSha = "", error = hashRes.error); }
            artifactSha = hashRes.hex;
        }

        if kind == CASE_KIND_COMPILE {
            artField := json.findObjectField(caseText, sPos, "artifact");
            if artField.found {
                if fs.kind(outputTsPath) =!= fs.FILE_KIND_FILE {
                    return (ok = false, artifactSha = "", error = label + ": missing generated artifact");
                }
                expectedArt := streams.readStreamBytes(caseText, artField.valuePos, caseDir);
                if not streams.equalBytes(fs.readBytes(outputTsPath), expectedArt) {
                    return (ok = false, artifactSha = "", error = "generated artifact differs");
                }
            }
        }
        if kind == CASE_KIND_REJECT and fs.kind(outputTsPath) =!= fs.FILE_KIND_MISSING {
            return (ok = false, artifactSha = "", error = "rejection created an output artifact");
        }

        if kind == CASE_KIND_REJECT or kind == CASE_KIND_COMPILE {
            actualStatus = compiled.status;
            actualStdout = if compiled.status == 0 { emptyBytes } else { compOutBytes };
            actualStderr = compErrBytes;
            actualStderrPath = compErrPath;
        } else {
            if compiled.status =!= 0 {
                return (ok = false, artifactSha = "", error = readFileDiagnostic(compErrPath, list.listCountInt(compErrBytes)));
            }
            if list.listCountInt(compErrBytes) > 0 {
                return (ok = false, artifactSha = "", error = "unexpected compiler diagnostics");
            }
            wPkg := fs.writeText(path.join(work, "package.json"), "{\"type\":\"module\"}\n");
            if not wPkg.ok { return (ok = false, artifactSha = "", error = wPkg.error); }
            filesDir := path.join(work, "files");
            mkFiles := fs.makeDir(filesDir);
            if not mkFiles.ok { return (ok = false, artifactSha = "", error = mkFiles.error); }

            inFilesField := json.findObjectField(caseText, sPos, "inputFiles");
            if inFilesField.found {
                loop json.objectKeys(caseText, inFilesField.valuePos) as fname {
                    fv := json.findObjectField(caseText, inFilesField.valuePos, fname);
                    dstFile := path.join(filesDir, fname);
                    mkParent := fs.makeDir(path.parentDir(dstFile));
                    if not mkParent.ok { return (ok = false, artifactSha = "", error = mkParent.error); }
                    wf := fs.writeBytes(dstFile, streams.readStreamBytes(caseText, fv.valuePos, caseDir));
                    if not wf.ok { return (ok = false, artifactSha = "", error = wf.error); }
                }
            }

            runArgs: mut List<String> = [path.join(rootDir, "compiler/entry.ts"), outputTsPath];
            loop scenarioArgs as arg {
                list.pushBack(mut runArgs, arg);
            }
            runOutPath := path.join(work, "run.stdout");
            runErrPath := path.join(work, "run.stderr");
            runRes := proc.runBytes(proc.execPath(), runArgs, filesDir, emptyEnv, timeoutMs, stdinBytes, runOutPath, runErrPath);
            if runRes.error =!= "" { return (ok = false, artifactSha = "", error = runRes.error); }

            outFilesField := json.findObjectField(caseText, sPos, "outputFiles");
            if outFilesField.found {
                loop json.objectKeys(caseText, outFilesField.valuePos) as fname {
                    fv := json.findObjectField(caseText, outFilesField.valuePos, fname);
                    outFile := path.join(filesDir, fname);
                    if fs.kind(outFile) =!= fs.FILE_KIND_FILE {
                        return (ok = false, artifactSha = "", error = label + ": file " + fname);
                    }
                    expectedFileBytes := streams.readStreamBytes(caseText, fv.valuePos, caseDir);
                    if not streams.equalBytes(fs.readBytes(outFile), expectedFileBytes) {
                        return (ok = false, artifactSha = "", error = label + ": file " + fname);
                    }
                }
            }

            actualStatus = runRes.status;
            actualStdout = fs.readBytes(runOutPath);
            actualStderr = fs.readBytes(runErrPath);
            actualStderrPath = runErrPath;
        }
    }

    if actualStatus =!= expectedExit {
        diag := readFileDiagnostic(actualStderrPath, list.listCountInt(actualStderr));
        return (ok = false, artifactSha = "", error = label + ": exit status; " + diag);
    }
    if not streams.equalBytes(actualStdout, expectedStdout) {
        return (ok = false, artifactSha = "", error = label + ": stdout");
    }
    if not streams.equalBytes(actualStderr, expectedStderr) {
        return (ok = false, artifactSha = "", error = label + ": stderr");
    }
    if kind == CASE_KIND_REJECT {
        if expectedExit == 0 or list.listCountInt(actualStdout) > 0 {
            return (ok = false, artifactSha = "", error = label + ": unexpected reject output");
        }
    }
    filesField := json.findObjectField(caseText, sPos, "files");
    if filesField.found {
        loop readStringListAt(caseText, filesField.valuePos) as artifactRel {
            if fs.kind(path.resolve(workspace, artifactRel)) == fs.FILE_KIND_MISSING {
                return (ok = false, artifactSha = "", error = "missing artifact: " + artifactRel);
            }
        }
    }
    (ok = true, artifactSha = artifactSha, error = "")
}

/** Verifies scenario `scenarioIdx` of `caseFile` inside an isolated temporary workspace. */
pub verifyCaseScenario := fn(rootDir: String, caseFile: String, scenarioIdx: Int): (ok: Bool, artifactSha: String, error: String) {
    absFile := path.resolve(proc.cwd(), caseFile);
    tmpRes := fs.makeTempDir("lite-case-");
    if not tmpRes.ok { return (ok = false, artifactSha = "", error = tmpRes.error); }
    res := verifyScenarioInWork(rootDir, absFile, scenarioIdx, tmpRes.path);
    _rm := fs.remove(tmpRes.path);
    res
}

hashFileMapJson := fn(caseText: String, objPos: Int, caseDir: String): String {
    entries: mut List<String> = [];
    loop json.objectKeys(caseText, objPos) as fname {
        fv := json.findObjectField(caseText, objPos, fname);
        digest := crypto.sha256Bytes(streams.readStreamBytes(caseText, fv.valuePos, caseDir));
        list.pushBack(mut entries, json.quoteString(fname) + ":" + json.quoteString(digest));
    }
    "{" + text.joinTexts(entries, ",") + "}"
}

/** Builds deterministic JSON identity metadata (manifest, source, and scenario stream hashes) for `caseFile`. */
pub caseIdentityJson := fn(rootDir: String, caseFile: String): (ok: Bool, jsonText: String, error: String) {
    absFile := path.resolve(proc.cwd(), caseFile);
    checked := validateCaseFile(rootDir, absFile);
    if not checked.ok { return (ok = false, jsonText = "", error = checked.error); }
    caseText := fs.readText(absFile).text;
    caseDir := path.parentDir(absFile);
    kind := json.readObjectString(caseText, 0, "kind").value;

    manifestHash := crypto.sha256File(absFile);
    if not manifestHash.ok { return (ok = false, jsonText = "", error = manifestHash.error); }
    sourceTarget := if kind == CASE_KIND_TOOL {
        path.join(rootDir, "bin/" + json.readObjectString(caseText, 0, "tool").value)
    } else {
        path.resolve(caseDir, json.readObjectString(caseText, 0, "source").value)
    };
    sourceHash := crypto.sha256File(sourceTarget);
    if not sourceHash.ok { return (ok = false, jsonText = "", error = sourceHash.error); }

    casesField := json.findObjectField(caseText, 0, "cases");
    scenarioJsonList: mut List<String> = [];
    loop json.arrayElementOffsets(caseText, casesField.valuePos) as sPos {
        sName := json.readObjectString(caseText, sPos, "name").value;
        stdinHash := crypto.sha256Bytes(streams.readStreamBytes(caseText, json.findObjectField(caseText, sPos, "stdin").valuePos, caseDir));
        stdoutHash := crypto.sha256Bytes(streams.readStreamBytes(caseText, json.findObjectField(caseText, sPos, "stdout").valuePos, caseDir));
        stderrHash := crypto.sha256Bytes(streams.readStreamBytes(caseText, json.findObjectField(caseText, sPos, "stderr").valuePos, caseDir));

        fields: mut List<String> = [
        "\"name\":" + json.quoteString(sName),
        "\"stdin\":" + json.quoteString(stdinHash),
        "\"stdout\":" + json.quoteString(stdoutHash),
        "\"stderr\":" + json.quoteString(stderrHash),
        ];
        artField := json.findObjectField(caseText, sPos, "artifact");
        if artField.found {
            artHash := crypto.sha256Bytes(streams.readStreamBytes(caseText, artField.valuePos, caseDir));
            list.pushBack(mut fields, "\"artifact\":" + json.quoteString(artHash));
        }
        inFilesField := json.findObjectField(caseText, sPos, "inputFiles");
        if inFilesField.found {
            list.pushBack(mut fields, "\"inputFiles\":" + hashFileMapJson(caseText, inFilesField.valuePos, caseDir));
        }
        outFilesField := json.findObjectField(caseText, sPos, "outputFiles");
        if outFilesField.found {
            list.pushBack(mut fields, "\"outputFiles\":" + hashFileMapJson(caseText, outFilesField.valuePos, caseDir));
        }
        list.pushBack(mut scenarioJsonList, "{" + text.joinTexts(fields, ",") + "}");
    }

    body := "{\"manifest\":" + json.quoteString(manifestHash.hex)
    + ",\"source\":" + json.quoteString(sourceHash.hex)
    + ",\"streams\":[" + text.joinTexts(scenarioJsonList, ",") + "]}";
    (ok = true, jsonText = body, error = "")
}
