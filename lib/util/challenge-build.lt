/** Normalizes cached challenge sources into `data/` and `schema/taxonomy.json` (`benchmark/challenges/tools/build.ts`). */

io := import "core/io";
fs := import "core/file";
path := import "core/path";
text := import "core/text";
list := import "core/list";
time := import "core/time";
unicode := import "core/unicode";
collections := import "util/collections";
json := import "data/json";
challenges := import "util/challenges";

/** Converts display text to a lowercase URL slug (`"A & B"` -> `"a-and-b"`). */
pub slugifyText := fn(value: String): String {
    lowered := challenges.asciiLower(value.trim());
    out: mut List<String> = [];
    var prevDash := true;
    var i := 0;
    size := lowered.length();
    loop i < size {
        ch := lowered.at(i);
        if ch == "&" {
            if not prevDash { mut out.pushBack("-"); }
            (mut out).pushBack("and-");
            prevDash = true;
        } else if "abcdefghijklmnopqrstuvwxyz0123456789".indexOf(ch, 0) >= 0 {
            mut out.pushBack(ch);
            prevDash = false;
        } else if not prevDash {
            mut out.pushBack("-");
            prevDash = true;
        }
        i = i + 1;
    }
    joined := out.join("");
    var s := 0;
    var e := joined.length();
    loop s < e and joined.at(s) == "-" { s = s + 1; }
    loop e > s and joined.at(e - 1) == "-" { e = e - 1; }
    joined.slice(s, e)
};

replaceSpacesCollapse := fn(raw: String): String {
    out: mut List<String> = [];
    var inSpace := true;
    var i := 0;
    size := raw.length();
    loop i < size {
        ch := raw.at(i);
        isWs := ch == " " or ch == "\n" or ch == "\r" or ch == "\t" or ch == unicode.fromCodePoint(12).text or ch == unicode.fromCodePoint(11).text;
        if isWs {
            if not inSpace {
                mut out.pushBack(" ");
                inSpace = true;
            }
        } else {
            mut out.pushBack(ch);
            inSpace = false;
        }
        i = i + 1;
    }
    out.join("").trim()
};

cleanHtmlTitle := fn(entKeys: List<String>, entVals: List<String>, raw: String): String {
    replaceSpacesCollapse(challenges.unescapeHtmlWithTable(entKeys, entVals, challenges.stripHtmlTags(raw)))
};

/** Ties-to-even integer rounding of `num / den` (`den > 0`). */
pub roundDivTiesEven := fn(num: Int, den: Int): Int {
    if den <= 0 { return 0; }
    neg := (num < 0 and den > 0) or (num > 0 and den < 0);
    a := if num < 0 { 0 - num } else { num };
    b := if den < 0 { 0 - den } else { den };
    var q := a / b;
    rem := a % b;
    twice := rem * 2;
    if twice > b or (twice == b and (q % 2) == 1) {
        q = q + 1;
    }
    if neg { 0 - q } else { q }
};

formatTenthsJson := fn(tenths: Int): String {
    clamped := if tenths < 10 { 10 } else if tenths > 100 { 100 } else { tenths };
    whole := clamped / 10;
    rem := clamped % 10;
    if rem == 0 { whole.toText() } else { whole.toText() + "." + rem.toText() }
};

formatCsvTenths := fn(tenths: Int): String {
    clamped := if tenths < 10 { 10 } else if tenths > 100 { 100 } else { tenths };
    (clamped / 10).toText() + "." + (clamped % 10).toText()
};

formatFourDecimalsJson := fn(tenThousandths: Int): String {
    if tenThousandths <= 0 { return "0"; }
    if tenThousandths >= 10000 { return "1"; }
    whole := (tenThousandths / 10000).toText();
    var frac := challenges.padLeftZero(tenThousandths % 10000, 4);
    loop frac.length() > 1 and frac.endsWith("0") {
        frac = frac.slice(0, frac.length() - 1);
    }
    whole + "." + frac
};

lookupStringFieldOrNull := fn(objJson: String, objPos: Int, key: String, fallback: String): String {
    if objPos < 0 { return fallback; }
    res := json.readFieldString(objJson, objPos, key);
    if res.found and res.ok { res.value } else { fallback }
};

quoteStringList := fn(items: List<String>): String {
    quoted: mut List<String> = [];
    loop items as it {
        mut quoted.pushBack(json.quoteString(it));
    }
    "[" + quoted.join(",") + "]"
};

dedupTextsPreserveOrder := fn(items: List<String>): List<String> {
    items.dedup()
};

titleCaseTopic := fn(slug: String): String {
    parts: mut List<String> = [];
    upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    lower := "abcdefghijklmnopqrstuvwxyz";
    var capNext := true;
    var i := 0;
    loop i < slug.length() {
        ch := slug.at(i);
        if ch == "-" {
            mut parts.pushBack(" ");
            capNext = true;
        } else {
            if capNext {
                pos := lower.indexOf(ch, 0);
                mut parts.pushBack(if pos >= 0 { upper.at(pos) } else { ch });
            } else {
                mut parts.pushBack(ch);
            }
            capNext = false;
        }
        i = i + 1;
    }
    parts.join("")
};

isAllDigitsStr := fn(s: String): Bool {
    if s == "" { return false; }
    var i := 0;
    loop i < s.length() {
        if not s.at(i).isDigit() { return false; }
        i = i + 1;
    }
    true
};

buildChallengeRecordJson := fn(
id: String, title: String, source: String, url: String, nativeId: String,
hasSet: Bool, setVal: String, hasNum: Bool, numVal: Int,
category: String, topics: List<String>, rawTopics: List<String>, tags: List<String>,
diffScale: String, diffRawJson: String, diffNormJson: String, diffNormScaled: Int,
formats: List<String>, languages: List<String>, topicsSource: String,
popJson: String, premium: Bool, status: String
): (jsonLine: String, id: String, source: String, setVal: String, hasNum: Bool, numVal: Int, cat: String, diffNormScaled: Int, primaryTopic: String, topicsJoined: String) {
    uniqTopics := dedupTextsPreserveOrder(topics);
    uniqTags := dedupTextsPreserveOrder(tags);
    primJson := if uniqTopics.length() > 0 { json.quoteString(uniqTopics[0]) } else { "null" };
    fallbackLangs: List<String> = ["any"];
    langs := if languages.length() > 0 { languages } else { fallbackLangs };
    line := "{\"id\":" + json.quoteString(id)
    + ",\"title\":" + json.quoteString(title)
    + ",\"source\":" + json.quoteString(source)
    + ",\"url\":" + json.quoteString(url)
    + ",\"native_id\":" + json.quoteString(nativeId)
    + ",\"set\":" + (if hasSet { json.quoteString(setVal) } else { "null" })
    + ",\"number\":" + (if hasNum { numVal.toText() } else { "null" })
    + ",\"category\":" + json.quoteString(category)
    + ",\"primary_topic\":" + primJson
    + ",\"topics\":" + quoteStringList(uniqTopics)
    + ",\"raw_topics\":" + quoteStringList(rawTopics)
    + ",\"tags\":" + quoteStringList(uniqTags)
    + ",\"difficulty\":{\"scale\":" + json.quoteString(diffScale) + ",\"raw\":" + diffRawJson + ",\"normalized\":" + diffNormJson + "}"
    + ",\"formats\":" + quoteStringList(formats)
    + ",\"languages\":" + quoteStringList(langs)
    + ",\"topics_source\":" + json.quoteString(topicsSource)
    + ",\"popularity\":" + popJson
    + ",\"premium\":" + (if premium { "true" } else { "false" })
    + ",\"status\":" + json.quoteString(status) + "}";
    _dummy := diffNormScaled;
    (
    jsonLine = line, id = id, source = source, setVal = if hasSet { setVal } else { "" },
    hasNum = hasNum, numVal = numVal, cat = category, diffNormScaled = diffNormScaled,
    primaryTopic = if uniqTopics.length() > 0 { uniqTopics[0] } else { "" },
    topicsJoined = uniqTopics.join(";")
    )
};

collectHtmlPagesSorted := fn(cacheDir: String, subDir: String, prefix: String): List<String> {
    dir := path.join(cacheDir, subDir);
    if fs.kind(dir) =!= fs.FILE_KIND_DIR {
        empty: List<String> = [];
        return empty;
    }
    matched: mut List<String> = [];
    loop fs.listDir(dir) as name {
        if name.startsWithAt(0, prefix) and name.endsWith(".html") {
            mut matched.pushBack(path.join(dir, name));
        }
    }
    matched.sortTexts()
};

findClosingDoubleDiv := fn(html: String, startPos: Int): Int {
    htmlLen := html.length();
    var scan := startPos;
    loop scan < htmlLen {
        c1 := html.indexOf("</div>", scan);
        if c1 < 0 { return -1; }
        var afterWs := c1 + 6;
        loop afterWs < htmlLen {
            ch := html.at(afterWs);
            if ch == " " or ch == "\n" or ch == "\r" or ch == "\t" {
                afterWs = afterWs + 1;
            } else { break; }
        }
        if html.startsWithAt(afterWs, "</div>") {
            return c1;
        }
        scan = c1 + 6;
    }
    -1
};

trimTrailingColons := fn(s: String): String {
    var end := s.length();
    loop end > 0 and s.at(end - 1) == ":" { end = end - 1; }
    s.slice(0, end)
};

parseRoadmapListJson := fn(
    tomlPath: String, listId: String, title: String, url: String, description: String, sortedKnownIds: List<String>
): (ok: Bool, hasList: Bool, listJson: String, metaJson: String, error: String) {
    if fs.kind(tomlPath) =!= fs.FILE_KIND_FILE {
        return (ok = true, hasList = false, listJson = "", metaJson = "", error = "");
    }
    raw := challenges.readNormalizedText(tomlPath).text;
    len := raw.length();
    blockStarts: mut List<Int> = [];
    var pos := 0;
    loop pos < len {
        atLineStart := pos == 0 or raw.at(pos - 1) == "\n";
        if atLineStart and raw.startsWithAt(pos, "[[groups]]") {
            var lineEnd := pos + 10;
            loop lineEnd < len and raw.at(lineEnd) == " " or (lineEnd < len and raw.at(lineEnd) == "\t") { lineEnd = lineEnd + 1; }
            if lineEnd == len or raw.at(lineEnd) == "\n" {
                mut blockStarts.pushBack(if lineEnd < len { lineEnd + 1 } else { lineEnd });
            }
        }
        nl := raw.indexOf("\n", pos);
        if nl < 0 { break; }
        pos = nl + 1;
    }

    flatIds: mut List<String> = [];
    seenAcrossGroups: mut Set<String>;
    groupsJson: mut List<String> = [];
    bCount := blockStarts.length();
    var bi := 0;
    loop bi < bCount {
        bStart := blockStarts[bi];
        bEnd := if bi + 1 < bCount { blockStarts[bi + 1] - 10 } else { len };
        block := raw.slice(bStart, bEnd);
        blen := block.length();
        var gName := "";
        var foundName := false;
        var probsStart := -1;
        var bp := 0;
        loop bp < blen {
            atStart := bp == 0 or block.at(bp - 1) == "\n";
            if atStart and block.startsWithAt(bp, "name") {
                eqPos := block.indexOf("=", bp + 4);
                nlPos := block.indexOf("\n", bp);
                if eqPos >= 0 and (nlPos < 0 or eqPos < nlPos) {
                    qPos := challenges.skipJsonSpace(block, eqPos + 1);
                    nParsed := json.readStringAt(block, qPos);
                    if nParsed.ok { gName = nParsed.value; foundName = true; }
                }
            }
            if atStart and block.startsWithAt(bp, "problems") {
                eqPos := block.indexOf("=", bp + 8);
                nlPos := block.indexOf("\n", bp);
                if eqPos >= 0 and (nlPos < 0 or eqPos < nlPos) {
                    probsStart = challenges.skipJsonSpace(block, eqPos + 1);
                }
            }
            nl := block.indexOf("\n", bp);
            if nl < 0 { break; }
            bp = nl + 1;
        }
        if not foundName or probsStart < 0 or block.at(probsStart) =!= "[" {
            return (ok = false, hasList = false, listJson = "", metaJson = "", error = "unsupported roadmap group in " + tomlPath);
        }
        arrEnd := block.indexOf("]", probsStart);
        if arrEnd < 0 {
            return (ok = false, hasList = false, listJson = "", metaJson = "", error = "unsupported roadmap group in " + tomlPath);
        }
        groupIds: mut List<String> = [];
        var scan := probsStart + 1;
        loop scan < arrEnd {
            if block.at(scan) == "\"" {
                strR := json.readStringAt(block, scan);
                if strR.ok {
                    pText := strR.value;
                    usPos := pText.indexOf("_", 0);
                    pfx := if usPos >= 0 { pText.slice(0, usPos) } else { pText };
                    if isAllDigitsStr(pfx) {
                        cid := "leetcode-" + pfx.toInt().value.toText();
                        if challenges.findSortedEntity(sortedKnownIds, cid) >= 0 and not seenAcrossGroups.has(cid) {
                            mut seenAcrossGroups.add(cid);
                            mut groupIds.pushBack(cid);
                            mut flatIds.pushBack(cid);
                        }
                    }
                    scan = strR.next;
                } else {
                    scan = scan + 1;
                }
            } else {
                scan = scan + 1;
            }
        }
        if groupIds.length() > 0 {
            mut groupsJson.pushBack("{\"name\":" + json.quoteString(gName) + ",\"challenge_ids\":" + quoteStringList(groupIds) + "}");
        }
        bi = bi + 1;
    }

    uniqFlat := dedupTextsPreserveOrder(flatIds);
    cnt := uniqFlat.length();
    groupsField := if groupsJson.length() > 0 { ",\"groups\":[" + groupsJson.join(",") + "]" } else { "" };
    lJson := "{\"id\":" + json.quoteString(listId) + ",\"title\":" + json.quoteString(title)
        + ",\"kind\":\"roadmap\",\"source\":\"leetcode\",\"url\":" + json.quoteString(url)
        + ",\"description\":" + json.quoteString(description) + ",\"count\":" + cnt.toText()
        + ",\"challenge_ids\":" + quoteStringList(uniqFlat) + groupsField + "}";
    mJson := "{\"id\":" + json.quoteString(listId) + ",\"title\":" + json.quoteString(title) + ",\"count\":" + cnt.toText() + "}";
    (ok = true, hasList = true, listJson = lJson, metaJson = mJson, error = "")
};

/** Normalizes cached sources in `challengesRootDir/.cache/` into `data/` and `schema/taxonomy.json`. */
pub buildChallengeCorpus := fn(challengesRootDir: String, catalogJsonText: String, entitiesJsonText: String): (ok: Bool, summaryText: String, error: String) {
    cacheDir := path.join(challengesRootDir, ".cache");
    if fs.kind(cacheDir) =!= fs.FILE_KIND_DIR {
        return (ok = false, summaryText = "", error = "no cache; run tools/fetch_sources.ts first");
    }

    entPairs := challenges.parseSortedStringObjectPairs(entitiesJsonText);
    entKeys: mut List<String> = [];
    entVals: mut List<String> = [];
    var epi := 0;
    loop epi + 1 < entPairs.length() {
        mut entKeys.pushBack(entPairs[epi]);
        mut entVals.pushBack(entPairs[epi + 1]);
        epi = epi + 2;
    }

    catField := json.findField(catalogJsonText, 0, "CATEGORIES");
    lcField := json.findField(catalogJsonText, 0, "LC_TOPICS");
    cfField := json.findField(catalogJsonText, 0, "CF_TAGS");
    csesField := json.findField(catalogJsonText, 0, "CSES_SECTIONS");
    cpField := json.findField(catalogJsonText, 0, "CRYPTOPALS_SETS");
    tgField := json.findField(catalogJsonText, 0, "TOPIC_GROUPS");
    tlField := json.findField(catalogJsonText, 0, "TOPIC_LABELS");
    dbField := json.findField(catalogJsonText, 0, "DIFFICULTY_BANDS");
    siField := json.findField(catalogJsonText, 0, "SOURCE_INFO");
    soField := json.findField(catalogJsonText, 0, "SOURCE_ORDER");
    sourceOrder := challenges.readStringArray(catalogJsonText, 0, "SOURCE_ORDER");
    allowedCats := json.objectKeys(catalogJsonText, catField.valuePos);
    _unusedSo := soField.found;

    recJsons: mut List<String> = [];
    recIds: mut List<String> = [];
    recSources: mut List<String> = [];
    recNums: mut List<Int> = [];
    recSets: mut List<String> = [];
    recCats: mut List<String> = [];
    recDiffTiers: mut List<String> = [];
    recTopSrcs: mut List<String> = [];
    recStatuses: mut List<String> = [];
    recTopicsAll: mut List<String> = [];
    recCsvRows: mut List<String> = ["id,title,source,category,primary_topic,topics,raw_topics,tags,difficulty,difficulty_normalized,topics_source,formats,premium,url"];

    var yr := 2015;
    loop yr <= 2025 {
        var day := 1;
        loop day <= 25 {
            pDay := challenges.padLeftZero(day, 2);
            aocPath := path.join(cacheDir, "aoc/" + yr.toText() + "/day" + pDay + ".html");
            if fs.kind(aocPath) == fs.FILE_KIND_FILE {
                html := challenges.readNormalizedText(aocPath).text;
                marker := "<h2>--- Day " + day.toText() + ": ";
                ms := html.indexOf(marker, 0);
                if ms >= 0 {
                    afterM := ms + marker.length();
                    me := html.indexOf(" ---</h2>", afterM);
                    if me >= 0 {
                        ttl := cleanHtmlTitle(entKeys, entVals, html.slice(afterM, me));
                        cid := "aoc-" + yr.toText() + "-" + pDay;
                        curl := "https://adventofcode.com/" + yr.toText() + "/day/" + day.toText();
                        tenths := 10 + roundDivTiesEven((day - 1) * 10, 3);
                        normStr := formatTenthsJson(tenths);
                        emptyStrs: List<String> = [];
                        tagsList: List<String> = ["advent-of-code", yr.toText(), "day-" + day.toText()];
                        fmtsList: List<String> = ["stdin-stdout", "two-part"];
                        langsList: List<String> = ["any"];
                        rec := buildChallengeRecordJson(
                        cid, ttl, "advent-of-code", curl, yr.toText() + "/" + day.toText(),
                        true, yr.toText(), true, day, "puzzles", emptyStrs, emptyStrs, tagsList,
                        "aoc-day", json.quoteString("Day " + day.toText()), normStr, tenths,
                        fmtsList, langsList, "none", "null", false, "verified"
                        );
                        mut recJsons.pushBack(rec.jsonLine);
                        mut recIds.pushBack(rec.id);
                        mut recSources.pushBack(rec.source);
                        mut recNums.pushBack(day);
                        mut recSets.pushBack(yr.toText());
                        mut recCats.pushBack(rec.cat);
                        mut recDiffTiers.pushBack((tenths / 10).toText());
                        mut recTopSrcs.pushBack("none");
                        mut recStatuses.pushBack("verified");
                        mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",advent-of-code,puzzles,,,,"
                        + challenges.csvEscapeField(tagsList.join(";")) + ","
                        + challenges.csvEscapeField("Day " + day.toText()) + "," + formatCsvTenths(tenths) + ",none,"
                        + challenges.csvEscapeField("stdin-stdout;two-part") + ",False," + challenges.csvEscapeField(curl));
                    }
                }
            }
            day = day + 1;
        }
        yr = yr + 1;
    }

    eulerNums: mut List<Int> = [];
    eulerNumSet: mut Set<Int>;
    eulerTitles: mut List<String> = [];
    loop collectHtmlPagesSorted(cacheDir, "project-euler", "page") as ePath {
        html := challenges.readNormalizedText(ePath).text;
        htmlLen := html.length();
        var pos := 0;
        loop pos < htmlLen {
            hrefPos := html.indexOf("href=\"problem=", pos);
            if hrefPos < 0 { break; }
            numStart := hrefPos + 14;
            quoteEnd := html.indexOf("\"", numStart);
            if quoteEnd < 0 { break; }
            nParsed := html.slice(numStart, quoteEnd).toInt();
            tagGt := html.indexOf(">", quoteEnd);
            closeA := if tagGt >= 0 { html.indexOf("</a>", tagGt + 1) } else { -1 };
            if nParsed.ok and tagGt >= 0 and closeA >= 0 {
                if not eulerNumSet.has(nParsed.value) {
                    mut eulerNumSet.add(nParsed.value);
                    mut eulerNums.pushBack(nParsed.value);
                    mut eulerTitles.pushBack(cleanHtmlTitle(entKeys, entVals, html.slice(tagGt + 1, closeA)));
                }
                pos = closeA + 4;
            } else {
                pos = numStart;
            }
        }
    }
    sortedEulerIdx := collections.sortIndicesBy(eulerNums.length(), fn(a: Int, b: Int): Bool {
        eulerNums[a] <= eulerNums[b]
    });
    loop sortedEulerIdx as idx {
        n := eulerNums[idx];
        ttl := eulerTitles[idx];
        tenths := if n <= 25 { 15 } else if n <= 50 { 20 } else if n <= 100 { 30 } else if n <= 200 { 40 } else if n <= 350 { 50 } else if n <= 500 { 60 } else if n <= 700 { 70 } else { 80 };
        normStr := formatTenthsJson(tenths);
        pNum := challenges.padLeftZero(n, 3);
        cid := "project-euler-" + pNum;
        curl := "https://projecteuler.net/problem=" + n.toText();
        topicsList: List<String> = ["math"];
        tagsList: List<String> = ["project-euler", "tier-" + (tenths / 10).toText()];
        fmtsList: List<String> = ["stdin-stdout", "single-answer"];
        langsList: List<String> = ["any"];
        emptyStrs: List<String> = [];
        rec := buildChallengeRecordJson(
        cid, ttl, "project-euler", curl, n.toText(), true, "Project Euler", true, n,
        "mathematics", topicsList, emptyStrs, tagsList, "project-euler-number", n.toText(),
        normStr, tenths, fmtsList, langsList, "curated", "null", false, "verified"
        );
        mut recJsons.pushBack(rec.jsonLine);
        mut recIds.pushBack(rec.id);
        mut recSources.pushBack(rec.source);
        mut recNums.pushBack(n);
        mut recSets.pushBack("Project Euler");
        mut recCats.pushBack(rec.cat);
        mut recDiffTiers.pushBack((tenths / 10).toText());
        mut recTopSrcs.pushBack("curated");
        mut recStatuses.pushBack("verified");
        mut recTopicsAll.pushBack("math");
        mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",project-euler,mathematics,math,math,,"
        + challenges.csvEscapeField(tagsList.join(";")) + "," + n.toText() + "," + formatCsvTenths(tenths)
        + ",curated," + challenges.csvEscapeField("stdin-stdout;single-answer") + ",False," + challenges.csvEscapeField(curl));
    }

    lcApiPath := path.join(cacheDir, "leetcode/api-all.json");
    lcMergedPath := path.join(cacheDir, "leetcode/merged.json");
    if fs.kind(lcApiPath) == fs.FILE_KIND_FILE and fs.kind(lcMergedPath) == fs.FILE_KIND_FILE {
        apiText := fs.readText(lcApiPath).text;
        mText := fs.readText(lcMergedPath).text;
        qField := json.findField(mText, 0, "questions");
        qKeys: mut List<String> = [];
        qPositions: mut List<Int> = [];
        loop json.arrayOffsets(mText, qField.valuePos) as qp {
            fidS := json.readFieldString(mText, qp, "frontend_id");
            fidVal := if fidS.found and fidS.ok { fidS.value } else {
                fidI := json.readFieldInt(mText, qp, "frontend_id");
                if fidI.found and fidI.ok { fidI.value.toText() } else { "" }
            };
            slugV := json.readFieldString(mText, qp, "problem_slug").value;
            if fidVal =!= "" { mut qKeys.pushBack(fidVal); mut qPositions.pushBack(qp); }
            if slugV =!= "" { mut qKeys.pushBack(slugV); mut qPositions.pushBack(qp); }
        }
        qOrd := challenges.sortIndexByKeys(qKeys);
        qSortedK: mut List<String> = [];
        qSortedP: mut List<Int> = [];
        loop qOrd as qi { mut qSortedK.pushBack(qKeys[qi]); mut qSortedP.pushBack(qPositions[qi]); }

        pairsField := json.findField(apiText, 0, "stat_status_pairs");
        loop json.arrayOffsets(apiText, pairsField.valuePos) as pPos {
            statF := json.findField(apiText, pPos, "stat");
            diffF := json.findField(apiText, pPos, "difficulty");
            fqidR := json.readFieldInt(apiText, statF.valuePos, "frontend_question_id");
            qidNum := if fqidR.found and fqidR.ok and fqidR.value > 0 { fqidR.value } else { json.readFieldInt(apiText, statF.valuePos, "question_id").value };
            qidStr := qidNum.toText();
            slug := json.readFieldString(apiText, statF.valuePos, "question__title_slug").value;
            ttlRaw := json.readFieldString(apiText, statF.valuePos, "question__title").value;
            ttl := cleanHtmlTitle(entKeys, entVals, ttlRaw);
            attemptsR := json.readFieldInt(apiText, statF.valuePos, "total_submitted");
            solvedR := json.readFieldInt(apiText, statF.valuePos, "total_acs");
            attempts := if attemptsR.found and attemptsR.ok { attemptsR.value } else { 0 };
            solved := if solvedR.found and solvedR.ok { solvedR.value } else { 0 };
            lvl := json.readFieldInt(apiText, diffF.valuePos, "level").value;
            paid := json.readFieldBool(apiText, pPos, "paid_only").value;

            diffLabel := if lvl == 1 { "Easy" } else if lvl == 3 { "Hard" } else { "Medium" };
            normTenths := if lvl == 1 { 20 } else if lvl == 3 { 80 } else { 50 };
            normStr := formatTenthsJson(normTenths);

            var qHitPos := -1;
            idxById := challenges.findSortedEntity(qSortedK, qidStr);
            if idxById >= 0 { qHitPos = qSortedP[idxById]; }
            else {
                idxBySlug := challenges.findSortedEntity(qSortedK, slug);
                if idxBySlug >= 0 { qHitPos = qSortedP[idxBySlug]; }
            }
            emptyRawTopics: List<String> = [];
            rawTopics := if qHitPos >= 0 { challenges.readStringArray(mText, qHitPos, "topics") } else { emptyRawTopics };
            mappedTopics: mut List<String> = [];
            loop rawTopics as rt {
                lk := json.readFieldString(catalogJsonText, lcField.valuePos, rt);
                slugTp := if lk.found and lk.ok { lk.value } else { slugifyText(rt) };
                if not mappedTopics.contains(slugTp) {
                    mut mappedTopics.pushBack(slugTp);
                }
            }
            loop mappedTopics as mt { mut recTopicsAll.pushBack(mt); }

            cat := if mappedTopics.contains("databases") { "databases" }
            else if mappedTopics.contains("shell") { "shell" }
            else if mappedTopics.contains("concurrency") { "concurrency" }
            else if mappedTopics.contains("javascript") { "javascript" }
            else if mappedTopics.contains("pandas") { "data-analysis" }
            else { "algorithms" };

            fmtStr := if mappedTopics.contains("databases") { "sql" } else if mappedTopics.contains("shell") { "shell" } else { "function" };
            langStr := if mappedTopics.contains("databases") { "sql" } else if mappedTopics.contains("shell") { "bash" } else if mappedTopics.contains("pandas") { "python" } else { "any" };
            tpSrc := if mappedTopics.length() > 0 { "source" } else { "none" };
            stVal := if mappedTopics.length() > 0 { "verified" } else { "partial" };

            tagsList: mut List<String> = ["leetcode", challenges.asciiLower(diffLabel)];
            if paid { mut tagsList.pushBack("premium"); }

            accJson := if attempts > 0 { formatFourDecimalsJson(roundDivTiesEven(solved * 10000, attempts)) } else { "null" };
            popJson := "{\"attempts\":" + attempts.toText() + ",\"solved\":" + solved.toText() + ",\"acceptance\":" + accJson + "}";
            cid := "leetcode-" + qidStr;
            curl := "https://leetcode.com/problems/" + slug + "/";
            rec := buildChallengeRecordJson(
            cid, ttl, "leetcode", curl, qidStr, false, "", isAllDigitsStr(qidStr), qidNum,
            cat, mappedTopics, rawTopics, tagsList, "leetcode", json.quoteString(diffLabel),
            (normTenths / 10).toText(), normTenths, [fmtStr], [langStr], tpSrc, popJson, paid, stVal
            );
            mut recJsons.pushBack(rec.jsonLine);
            mut recIds.pushBack(rec.id);
            mut recSources.pushBack(rec.source);
            mut recNums.pushBack(qidNum);
            mut recSets.pushBack("");
            mut recCats.pushBack(rec.cat);
            mut recDiffTiers.pushBack((normTenths / 10).toText());
            mut recTopSrcs.pushBack(tpSrc);
            mut recStatuses.pushBack(stVal);
            mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",leetcode," + challenges.csvEscapeField(cat) + ","
            + challenges.csvEscapeField(rec.primaryTopic) + "," + challenges.csvEscapeField(rec.topicsJoined) + ","
            + challenges.csvEscapeField(rawTopics.join(";")) + "," + challenges.csvEscapeField(tagsList.join(";")) + ","
            + challenges.csvEscapeField(diffLabel) + "," + formatCsvTenths(normTenths) + "," + tpSrc + "," + challenges.csvEscapeField(fmtStr) + ","
            + (if paid { "True" } else { "False" }) + "," + challenges.csvEscapeField(curl));
        }
    }

    cfPath := path.join(cacheDir, "codeforces/problemset.json");
    if fs.kind(cfPath) == fs.FILE_KIND_FILE {
        cfText := fs.readText(cfPath).text;
        resField := json.findField(cfText, 0, "result");
        stArrField := json.findField(cfText, resField.valuePos, "problemStatistics");
        stKeys: mut List<String> = [];
        stVals: mut List<Int> = [];
        loop json.arrayOffsets(cfText, stArrField.valuePos) as sp {
            cId := json.readFieldInt(cfText, sp, "contestId").value;
            cIdx := json.readFieldString(cfText, sp, "index").value;
            sc := json.readFieldInt(cfText, sp, "solvedCount").value;
            mut stKeys.pushBack(cId.toText() + "/" + cIdx);
            mut stVals.pushBack(sc);
        }
        stOrd := challenges.sortIndexByKeys(stKeys);
        stSK: mut List<String> = [];
        stSV: mut List<Int> = [];
        loop stOrd as si { mut stSK.pushBack(stKeys[si]); mut stSV.pushBack(stVals[si]); }

        prArrField := json.findField(cfText, resField.valuePos, "problems");
        cContestIds: mut List<Int> = [];
        cIndexes: mut List<String> = [];
        cSolved: mut List<Int> = [];
        cRatings: mut List<Int> = [];
        cPosList: mut List<Int> = [];
        loop json.arrayOffsets(cfText, prArrField.valuePos) as pp {
            ratR := json.readFieldInt(cfText, pp, "rating");
            tpR := json.readFieldString(cfText, pp, "type");
            tpVal := if tpR.found and tpR.ok { tpR.value } else { "PROGRAMMING" };
            if ratR.found and ratR.ok and ratR.value >= 800 and ratR.value <= 3000 and tpVal == "PROGRAMMING" {
                cId := json.readFieldInt(cfText, pp, "contestId").value;
                cIdx := json.readFieldString(cfText, pp, "index").value;
                hit := challenges.findSortedEntity(stSK, cId.toText() + "/" + cIdx);
                sv := if hit >= 0 { stSV[hit] } else { 0 };
                if sv > 0 {
                    mut cContestIds.pushBack(cId);
                    mut cIndexes.pushBack(cIdx);
                    mut cSolved.pushBack(sv);
                    mut cRatings.pushBack(ratR.value);
                    mut cPosList.pushBack(pp);
                }
            }
        }

        cfN := cContestIds.length();
        var cfOrd: mut List<Int> = [];
        var cfi := 0;
        loop cfi < cfN { mut cfOrd.pushBack(cfi); cfi = cfi + 1; }
        if cfN > 1 {
            var width := 1;
            loop width < cfN {
                next: mut List<Int> = [];
                var st := 0;
                loop st < cfN {
                    mid := if st + width < cfN { st + width } else { cfN };
                    re := if st + width * 2 < cfN { st + width * 2 } else { cfN };
                    var li := st;
                    var ri := mid;
                    loop li < mid or ri < re {
                        if li >= mid { mut next.pushBack(cfOrd[ri]); ri = ri + 1; }
                        else if ri >= re { mut next.pushBack(cfOrd[li]); li = li + 1; }
                        else {
                            ia := cfOrd[li];
                            ib := cfOrd[ri];
                            var takeA := false;
                            if cSolved[ia] > cSolved[ib] { takeA = true; }
                            else if cSolved[ia] == cSolved[ib] {
                                if cContestIds[ia] < cContestIds[ib] { takeA = true; }
                                else if cContestIds[ia] == cContestIds[ib] and challenges.compareTextLex(cIndexes[ia], cIndexes[ib]) <= 0 { takeA = true; }
                            }
                            if takeA { mut next.pushBack(ia); li = li + 1; } else { mut next.pushBack(ib); ri = ri + 1; }
                        }
                    }
                    st = st + width * 2;
                }
                cfOrd = next;
                width = width * 2;
            }
        }

        cfSelected: mut List<Int> = [];
        cfSelectedSet: mut Set<Int>;
        lows: List<Int> = [800, 1200, 1600, 2000];
        highs: List<Int> = [1199, 1599, 1999, 3000];
        var bi := 0;
        loop bi < 4 {
            var bucketCount := 0;
            loop cfOrd as ci {
                if cRatings[ci] >= lows[bi] and cRatings[ci] <= highs[bi] and not cfSelectedSet.has(ci) {
                    mut cfSelectedSet.add(ci);
                    mut cfSelected.pushBack(ci);
                    bucketCount = bucketCount + 1;
                    if bucketCount >= 200 { break; }
                }
            }
            bi = bi + 1;
        }
        loop cfOrd as ci {
            if cfSelected.length() >= 800 { break; }
            if not cfSelectedSet.has(ci) {
                mut cfSelectedSet.add(ci);
                mut cfSelected.pushBack(ci);
            }
        }

        loop cfSelected as ci {
            pp := cPosList[ci];
            cId := cContestIds[ci];
            cIdx := cIndexes[ci];
            rating := cRatings[ci];
            solved := cSolved[ci];
            ttl := cleanHtmlTitle(entKeys, entVals, json.readFieldString(cfText, pp, "name").value);
            rawTags := challenges.readStringArray(cfText, pp, "tags");
            mappedTags: mut List<String> = [];
            loop rawTags as rt {
                lk := json.readFieldString(catalogJsonText, cfField.valuePos, rt);
                slugTp := if lk.found and lk.ok { lk.value } else { slugifyText(rt) };
                if not mappedTags.contains(slugTp) { mut mappedTags.pushBack(slugTp); }
            }
            loop mappedTags as mt { mut recTopicsAll.pushBack(mt); }

            tenths := 10 + roundDivTiesEven((rating - 800) * 10, 250);
            normStr := formatTenthsJson(tenths);
            cid := challenges.asciiLower("codeforces-" + cId.toText() + cIdx);
            curl := "https://codeforces.com/problemset/problem/" + cId.toText() + "/" + cIdx;
            tagsList: List<String> = ["codeforces", "rating-" + rating.toText(), "contest-" + cId.toText(), "index-" + challenges.asciiLower(cIdx)];
            popJson := "{\"solved\":" + solved.toText() + "}";
            rec := buildChallengeRecordJson(
            cid, ttl, "codeforces", curl, cId.toText() + cIdx, true, "contest-" + cId.toText(),
            false, 0, "algorithms", mappedTags, rawTags, tagsList, "codeforces-rating", rating.toText(),
            normStr, tenths, ["stdin-stdout"], ["any"], "source", popJson, false, "verified"
            );
            mut recJsons.pushBack(rec.jsonLine);
            mut recIds.pushBack(rec.id);
            mut recSources.pushBack(rec.source);
            mut recNums.pushBack(0);
            mut recSets.pushBack(rec.setVal);
            mut recCats.pushBack(rec.cat);
            mut recDiffTiers.pushBack((tenths / 10).toText());
            mut recTopSrcs.pushBack("source");
            mut recStatuses.pushBack("verified");
            mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",codeforces,algorithms,"
            + challenges.csvEscapeField(rec.primaryTopic) + "," + challenges.csvEscapeField(rec.topicsJoined) + ","
            + challenges.csvEscapeField(rawTags.join(";")) + "," + challenges.csvEscapeField(tagsList.join(";")) + ","
            + rating.toText() + "," + formatCsvTenths(tenths) + ",source,stdin-stdout,False," + challenges.csvEscapeField(curl));
        }
    }

    csesPath := path.join(cacheDir, "cses/problemset.html");
    if fs.kind(csesPath) == fs.FILE_KIND_FILE {
        html := challenges.readNormalizedText(csesPath).text;
        htmlLen := html.length();
        secCounts: mut Map<String, Int>;
        var curSec := "";
        var pos := 0;
        loop pos < htmlLen {
            h2Pos := html.indexOf("<h2>", pos);
            hrefPos := html.indexOf("href=\"/problemset/task/", pos);
            if h2Pos < 0 and hrefPos < 0 { break; }
            isH2Next := h2Pos >= 0 and (hrefPos < 0 or h2Pos < hrefPos);
            if isH2Next {
                h2End := html.indexOf("</h2>", h2Pos + 4);
                if h2End < 0 { break; }
                curSec = cleanHtmlTitle(entKeys, entVals, html.slice(h2Pos + 4, h2End));
                pos = h2End + 5;
            } else {
                idStart := hrefPos + 23;
                qEnd := html.indexOf("\">", idStart);
                aEnd := if qEnd >= 0 { html.indexOf("</a>", qEnd + 2) } else { -1 };
                if qEnd >= 0 and aEnd >= 0 and curSec =!= "" {
                    taskId := html.slice(idStart, qEnd);
                    ttl := cleanHtmlTitle(entKeys, entVals, html.slice(qEnd + 2, aEnd));
                    secF := json.findField(catalogJsonText, csesField.valuePos, curSec);
                    var tpList: List<String> = ["mixed"];
                    var baseVal := 50;
                    if secF.found {
                        offs := json.arrayOffsets(catalogJsonText, secF.valuePos);
                        if offs.length() >= 2 {
                            tps: mut List<String> = [];
                            loop json.arrayOffsets(catalogJsonText, offs[0]) as tpPos {
                                s := json.readStringAt(catalogJsonText, tpPos);
                                if s.ok { mut tps.pushBack(s.value); }
                            }
                            tpList = tps;
                            bR := challenges.parseScaledNumberText(catalogJsonText.slice(json.valueSpan(catalogJsonText, offs[1]).start, json.valueSpan(catalogJsonText, offs[1]).end));
                            if bR.ok { baseVal = bR.scaled / 100; }
                        }
                    }
                    loop tpList as mt { mut recTopicsAll.pushBack(mt); }
                    n := secCounts.getOr(curSec, 0) + 1;
                    mut secCounts.set(curSec, n);
                    cid := "cses-" + taskId;
                    curl := "https://cses.fi/problemset/task/" + taskId;
                    tagsList: List<String> = ["cses", slugifyText(curSec)];
                    normStr := formatTenthsJson(baseVal);
                    emptyStrsCses: List<String> = [];
                    rec := buildChallengeRecordJson(
                    cid, ttl, "cses", curl, taskId, true, curSec, true, n,
                    "algorithms", tpList, emptyStrsCses, tagsList, "cses-section", json.quoteString(curSec),
                    normStr, baseVal, ["stdin-stdout"], ["any"], "section", "null", false, "verified"
                    );
                    mut recJsons.pushBack(rec.jsonLine);
                    mut recIds.pushBack(rec.id);
                    mut recSources.pushBack(rec.source);
                    mut recNums.pushBack(n);
                    mut recSets.pushBack(curSec);
                    mut recCats.pushBack(rec.cat);
                    mut recDiffTiers.pushBack((baseVal / 10).toText());
                    mut recTopSrcs.pushBack("section");
                    mut recStatuses.pushBack("verified");
                    mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",cses,algorithms,"
                    + challenges.csvEscapeField(rec.primaryTopic) + "," + challenges.csvEscapeField(rec.topicsJoined) + ",,"
                    + challenges.csvEscapeField(tagsList.join(";")) + "," + challenges.csvEscapeField(curSec)
                    + "," + formatCsvTenths(baseVal) + ",section,stdin-stdout,False," + challenges.csvEscapeField(curl));
                    pos = aEnd + 4;
                } else {
                    pos = hrefPos + 23;
                }
            }
        }
    }

    atcProbPath := path.join(cacheDir, "atcoder/problems.json");
    atcModPath := path.join(cacheDir, "atcoder/models.json");
    if fs.kind(atcProbPath) == fs.FILE_KIND_FILE and fs.kind(atcModPath) == fs.FILE_KIND_FILE {
        pText := fs.readText(atcProbPath).text;
        mText := fs.readText(atcModPath).text;
        cPPos: mut List<Int> = [];
        cUsers: mut List<Int> = [];
        cDiffRaw: mut List<String> = [];
        cDiffTenths: mut List<Int> = [];
        cPrefixes: mut List<String> = [];
        loop json.arrayOffsets(mText, 0) as _unused { break; }
        mKeys := json.objectKeys(mText, 0);
        mOrd := challenges.sortIndexByKeys(mKeys);
        sortedMKeys: mut List<String> = [];
        loop mOrd as mi { mut sortedMKeys.pushBack(mKeys[mi]); }
        _unusedMk := sortedMKeys.length();

        loop json.arrayOffsets(pText, 0) as pp {
            pid := json.readFieldString(pText, pp, "id").value;
            cId := json.readFieldString(pText, pp, "contest_id").value;
            var pfx := "";
            var pi := 0;
            loop pi < cId.length() {
                ch := cId.at(pi);
                if "abcdefghijklmnopqrstuvwxyz".indexOf(ch, 0) >= 0 {
                    pfx = pfx + ch;
                    pi = pi + 1;
                } else { break; }
            }
            if pfx == "abc" or pfx == "arc" or pfx == "agc" {
                mf := json.findField(mText, 0, pid);
                if mf.found and challenges.isJsonObjectAt(mText, mf.valuePos) {
                    expR := json.readFieldBool(mText, mf.valuePos, "is_experimental");
                    isExp := expR.found and expR.ok and expR.value;
                    dParsed := challenges.parseScaledDecimal1000(mText, mf.valuePos, "difficulty");
                    if not isExp and dParsed.ok {
                        uR := json.readFieldInt(mText, mf.valuePos, "irt_users");
                        users := if uR.found and uR.ok { uR.value } else { 0 };
                        val1000 := if dParsed.scaled > 400000 { dParsed.scaled } else { 400000 };
                        tenths := 10 + roundDivTiesEven((val1000 - 400000) * 10, 320000);
                        mut cPPos.pushBack(pp);
                        mut cUsers.pushBack(users);
                        mut cDiffRaw.pushBack(dParsed.raw);
                        mut cDiffTenths.pushBack(tenths);
                        mut cPrefixes.pushBack(pfx);
                    }
                }
            }
        }
        aLen := cPPos.length();
        var aOrd: mut List<Int> = [];
        var ai := 0;
        loop ai < aLen { mut aOrd.pushBack(ai); ai = ai + 1; }
        if aLen > 1 {
            var width := 1;
            loop width < aLen {
                next: mut List<Int> = [];
                var st := 0;
                loop st < aLen {
                    mid := if st + width < aLen { st + width } else { aLen };
                    re := if st + width * 2 < aLen { st + width * 2 } else { aLen };
                    var li := st;
                    var ri := mid;
                    loop li < mid or ri < re {
                        if li >= mid { mut next.pushBack(aOrd[ri]); ri = ri + 1; }
                        else if ri >= re { mut next.pushBack(aOrd[li]); li = li + 1; }
                        else if cUsers[aOrd[li]] >= cUsers[aOrd[ri]] { mut next.pushBack(aOrd[li]); li = li + 1; }
                        else { mut next.pushBack(aOrd[ri]); ri = ri + 1; }
                    }
                    st = st + width * 2;
                }
                aOrd = next;
                width = width * 2;
            }
        }
        var taken := 0;
        loop aOrd as idx {
            if taken >= 350 { break; }
            taken = taken + 1;
            pp := cPPos[idx];
            pid := json.readFieldString(pText, pp, "id").value;
            cId := json.readFieldString(pText, pp, "contest_id").value;
            ttl := cleanHtmlTitle(entKeys, entVals, json.readFieldString(pText, pp, "name").value);
            normStr := formatTenthsJson(cDiffTenths[idx]);
            var dashed := "";
            var di := 0;
            loop di < pid.length() {
                ch := pid.at(di);
                dashed = dashed + (if ch == "_" { "-" } else { ch });
                di = di + 1;
            }
            cid := challenges.asciiLower("atcoder-" + dashed);
            curl := "https://atcoder.jp/contests/" + cId + "/tasks/" + pid;
            tagsList: List<String> = ["atcoder", cPrefixes[idx], "contest-" + cId];
            popJson := "{\"users\":" + cUsers[idx].toText() + "}";
            emptyStrs: List<String> = [];
            rec := buildChallengeRecordJson(
            cid, ttl, "atcoder", curl, pid, true, cId, false, 0,
            "algorithms", emptyStrs, emptyStrs, tagsList, "atcoder-difficulty", cDiffRaw[idx],
            normStr, cDiffTenths[idx], ["stdin-stdout"], ["any"], "none", popJson, false, "verified"
            );
            mut recJsons.pushBack(rec.jsonLine);
            mut recIds.pushBack(rec.id);
            mut recSources.pushBack(rec.source);
            mut recNums.pushBack(0);
            mut recSets.pushBack(cId);
            mut recCats.pushBack(rec.cat);
            mut recDiffTiers.pushBack((cDiffTenths[idx] / 10).toText());
            mut recTopSrcs.pushBack("none");
            mut recStatuses.pushBack("verified");
            mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",atcoder,algorithms,,,,"
            + challenges.csvEscapeField(tagsList.join(";")) + "," + challenges.csvEscapeField(cDiffRaw[idx])
            + "," + formatCsvTenths(cDiffTenths[idx]) + ",none,stdin-stdout,False," + challenges.csvEscapeField(curl));
        }
    }

    loop json.objectKeys(catalogJsonText, cpField.valuePos) as setNo {
        setHtmlPath := path.join(cacheDir, "cryptopals/set" + setNo + ".html");
        if fs.kind(setHtmlPath) == fs.FILE_KIND_FILE {
            html := challenges.readNormalizedText(setHtmlPath).text;
            arrPos := json.findField(catalogJsonText, cpField.valuePos, setNo).valuePos;
            offs := json.arrayOffsets(catalogJsonText, arrPos);
            setName := json.readStringAt(catalogJsonText, offs[0]).value;
            setTopics := challenges.readStringArray(catalogJsonText, arrPos, "dummy");
            _unusedStp := setTopics.length();
            var tpList: mut List<String> = [];
            loop json.arrayOffsets(catalogJsonText, offs[1]) as tpPos {
                s := json.readStringAt(catalogJsonText, tpPos);
                if s.ok { mut tpList.pushBack(s.value); mut recTopicsAll.pushBack(s.value); }
            }
            var pos := 0;
            htmlLen := html.length();
            needle := "/sets/" + setNo + "/challenges/";
            needleLen := needle.length();
            loop pos < htmlLen {
                nPos := html.indexOf(needle, pos);
                if nPos < 0 { break; }
                nStart := nPos + needleLen;
                var nEnd := nStart;
                loop nEnd < htmlLen and html.at(nEnd).isDigit() { nEnd = nEnd + 1; }
                gtPos := html.indexOf(">", nEnd);
                aEnd := if gtPos >= 0 { html.indexOf("</a>", gtPos + 1) } else { -1 };
                if nEnd > nStart and gtPos >= 0 and aEnd >= 0 {
                    cNoStr := html.slice(nStart, nEnd);
                    hasTxt := html.startsWithAt(nEnd, ".txt");
                    ttl := cleanHtmlTitle(entKeys, entVals, html.slice(gtPos + 1, aEnd));
                    cNum := cNoStr.toInt().value;
                    setNum := setNo.toInt().value;
                    tenths := (1 + setNum) * 10;
                    cid := "cryptopals-" + challenges.padLeftZero(cNum, 2);
                    curl := "https://cryptopals.com/sets/" + setNo + "/challenges/" + cNoStr + (if hasTxt { ".txt" } else { "" });
                    tagsList: List<String> = ["cryptopals", "set-" + setNo];
                    emptyStrsCp: List<String> = [];
                    rec := buildChallengeRecordJson(
                    cid, ttl, "cryptopals", curl, cNoStr, true, "Set " + setNo + ": " + setName,
                    true, cNum, "security", tpList, emptyStrsCp, tagsList, "cryptopals-set", json.quoteString("Set " + setNo),
                    (1 + setNum).toText(), tenths, ["programming"], ["any"], "curated", "null", false, "verified"
                    );
                    mut recJsons.pushBack(rec.jsonLine);
                    mut recIds.pushBack(rec.id);
                    mut recSources.pushBack(rec.source);
                    mut recNums.pushBack(cNum);
                    mut recSets.pushBack("Set " + setNo + ": " + setName);
                    mut recCats.pushBack(rec.cat);
                    mut recDiffTiers.pushBack((1 + setNum).toText());
                    mut recTopSrcs.pushBack("curated");
                    mut recStatuses.pushBack("verified");
                    mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",cryptopals,security,"
                    + challenges.csvEscapeField(rec.primaryTopic) + "," + challenges.csvEscapeField(rec.topicsJoined) + ",,"
                    + challenges.csvEscapeField(tagsList.join(";")) + "," + challenges.csvEscapeField("Set " + setNo)
                    + "," + (1 + setNum).toText() + ",curated,programming,False," + challenges.csvEscapeField(curl));
                    pos = aEnd + 4;
                } else {
                    pos = nPos + needle.length();
                }
            }
        }
    }

    rosPath := path.join(cacheDir, "rosalind/list.html");
    if fs.kind(rosPath) == fs.FILE_KIND_FILE {
        html := challenges.readNormalizedText(rosPath).text;
        htmlLen := html.length();
        var pos := 0;
        loop pos < htmlLen {
            trStart := html.indexOf("<tr>", pos);
            if trStart < 0 { break; }
            trEnd := html.indexOf("</tr>", trStart + 4);
            if trEnd < 0 { break; }
            row := html.slice(trStart + 4, trEnd);
            rowLen := row.length();
            pos = trEnd + 5;
            pMark := "href=\"/problems/";
            pPos := row.indexOf(pMark, 0);
            if pPos < 0 { continue; }
            idStart := pPos + pMark.length();
            var idEnd := idStart;
            var validPid := true;
            loop idEnd < rowLen {
                ch := row.at(idEnd);
                if ch == "/" { break; }
                if ch == "\"" or ch == " " or ch == "\t" or ch == "\n" or ch == "\r" { validPid = false; break; }
                idEnd = idEnd + 1;
            }
            if not validPid or idEnd == idStart or idEnd >= rowLen or not row.startsWithAt(idEnd, "/\"") {
                continue;
            }
            pid := row.slice(idStart, idEnd);
            gtPos := row.indexOf(">", idEnd + 2);
            aEnd := if gtPos >= 0 { row.indexOf("</a>", gtPos + 1) } else { -1 };
            if gtPos < 0 or aEnd < 0 { continue; }
            rawTitle := row.slice(gtPos + 1, aEnd);
            if rawTitle.indexOf("<", 0) >= 0 { continue; }
            ttl := cleanHtmlTitle(entKeys, entVals, rawTitle);

            var solved := 0;
            recMark := "/recent/\">";
            rPos := row.indexOf(recMark, 0);
            if rPos >= 0 {
                dStart := rPos + recMark.length();
                var dEnd := dStart;
                loop dEnd < rowLen and row.at(dEnd).isDigit() { dEnd = dEnd + 1; }
                if dEnd > dStart and row.startsWithAt(dEnd, "</a>") {
                    solved = row.slice(dStart, dEnd).toInt().value;
                }
            }

            var hasRatio := false;
            var ratioScaled1000 := 0;
            pctPos := row.indexOf("% of all attempts", 0);
            if pctPos > 0 {
                var numStart := pctPos;
                var sawDigit := false;
                loop numStart > 0 {
                    ch := row.at(numStart - 1);
                    if ch.isDigit() or ch == "." {
                        if ch.isDigit() { sawDigit = true; }
                        numStart = numStart - 1;
                    } else { break; }
                }
                if sawDigit {
                    rParsed := challenges.parseScaledNumberText(row.slice(numStart, pctPos));
                    if rParsed.ok {
                        hasRatio = true;
                        ratioScaled1000 = rParsed.scaled;
                    }
                }
            }

            diffRaw := if hasRatio {
                p10 := roundDivTiesEven(ratioScaled1000, 100);
                (p10 / 10).toText() + "." + (p10 % 10).toText() + "% correct"
            } else { "unknown" };
            tenths := if hasRatio {
                rawT := roundDivTiesEven(900000 - 8 * ratioScaled1000, 10000);
                if rawT < 10 { 10 } else if rawT > 100 { 100 } else { rawT }
            } else { 40 };
            normStr := formatTenthsJson(tenths);
            accJson := if hasRatio { formatFourDecimalsJson(roundDivTiesEven(ratioScaled1000, 10)) } else { "null" };
            popJson := "{\"solved\":" + solved.toText() + ",\"acceptance\":" + accJson + "}";

            cid := "rosalind-" + pid;
            curl := "https://rosalind.info/problems/" + pid + "/";
            topicsList: List<String> = ["bioinformatics"];
            tagsList: List<String> = ["rosalind", pid];
            emptyStrsRos: List<String> = [];
            mut recTopicsAll.pushBack("bioinformatics");
            rec := buildChallengeRecordJson(
            cid, ttl, "rosalind", curl, pid, true, "Bioinformatics Stronghold", false, 0,
            "bioinformatics", topicsList, emptyStrsRos, tagsList, "acceptance-proxy", json.quoteString(diffRaw),
            normStr, tenths, ["stdin-stdout"], ["any"], "curated", popJson, false, "verified"
            );
            mut recJsons.pushBack(rec.jsonLine);
            mut recIds.pushBack(rec.id);
            mut recSources.pushBack(rec.source);
            mut recNums.pushBack(0);
            mut recSets.pushBack("Bioinformatics Stronghold");
            mut recCats.pushBack(rec.cat);
            mut recDiffTiers.pushBack((tenths / 10).toText());
            mut recTopSrcs.pushBack("curated");
            mut recStatuses.pushBack("verified");
            mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",rosalind,bioinformatics,bioinformatics,bioinformatics,,"
            + challenges.csvEscapeField(tagsList.join(";")) + "," + challenges.csvEscapeField(diffRaw)
            + "," + formatCsvTenths(tenths) + ",curated,stdin-stdout,False," + challenges.csvEscapeField(curl));
        }
    }

    seenJsSlugs: mut Set<String>;
    loop collectHtmlPagesSorted(cacheDir, "jane-street", "archive") as jsPath {
        html := challenges.readNormalizedText(jsPath).text;
        htmlLen := html.length();
        var pos := 0;
        cardOpen := "<div class=\"row puzzle-row archive-list\">";
        cardOpenLen := cardOpen.length();
        loop pos < htmlLen {
            cStart := html.indexOf(cardOpen, pos);
            if cStart < 0 { break; }
            bodyStart := cStart + cardOpenLen;
            cEnd := findClosingDoubleDiv(html, bodyStart);
            if cEnd < 0 { break; }
            body := html.slice(bodyStart, cEnd);
            pos = cEnd + 6;

            nTag := "<span class=\"name\">";
            nPos := body.indexOf(nTag, 0);
            nClose := if nPos >= 0 { body.indexOf("</span>", nPos + nTag.length()) } else { -1 };
            rawName := if nClose >= 0 { body.slice(nPos + nTag.length(), nClose) } else { "" };
            lTag := "class=\"puzzle-link\" href=\"";
            lPos := body.indexOf(lTag, 0);
            lEnd := if lPos >= 0 { body.indexOf("\"", lPos + lTag.length()) } else { -1 };
            link := if lEnd >= 0 { body.slice(lPos + lTag.length(), lEnd) } else { "" };
            if rawName == "" or link == "" or rawName.indexOf("<", 0) >= 0 { continue; }

            var trimmed := link;
            loop trimmed.startsWithAt(0, "/") { trimmed = trimmed.slice(1, trimmed.length()); }
            loop trimmed.endsWith("/") { trimmed = trimmed.slice(0, trimmed.length() - 1); }
            var lastSlash := -1;
            var si := 0;
            loop si < trimmed.length() {
                if trimmed.at(si) == "/" { lastSlash = si; }
                si = si + 1;
            }
            var slug := if lastSlash >= 0 { trimmed.slice(lastSlash + 1, trimmed.length()) } else { trimmed };
            if slug.endsWith("-index") {
                slug = slug.slice(0, slug.length() - 6);
            }
            if slug == "" or seenJsSlugs.has(slug) { continue; }
            (mut seenJsSlugs).add(slug);

            dTag := "<span class=\"date\">";
            dPos := body.indexOf(dTag, 0);
            dClose := if dPos >= 0 { body.indexOf("</span>", dPos + dTag.length()) } else { -1 };
            month := if dClose >= 0 and body.slice(dPos + dTag.length(), dClose).indexOf("<", 0) < 0 {
                trimTrailingColons(cleanHtmlTitle(entKeys, entVals, body.slice(dPos + dTag.length(), dClose)))
            } else { "" };

            ttl := cleanHtmlTitle(entKeys, entVals, rawName);
            cid := "jane-street-" + slug;
            curl := "https://www.janestreet.com" + link;
            tagsList: mut List<String> = ["jane-street"];
            if month =!= "" { mut tagsList.pushBack(slugifyText(month)); }
            emptyStrsJs: List<String> = [];
            rec := buildChallengeRecordJson(
            cid, ttl, "jane-street", curl, slug, month =!= "", month, false, 0,
            "puzzles", emptyStrsJs, emptyStrsJs, tagsList, "editorial", json.quoteString("Puzzle"),
            "7", 70, ["puzzle"], ["any"], "none", "null", false, "verified"
            );
            mut recJsons.pushBack(rec.jsonLine);
            mut recIds.pushBack(rec.id);
            mut recSources.pushBack(rec.source);
            mut recNums.pushBack(0);
            mut recSets.pushBack(month);
            mut recCats.pushBack(rec.cat);
            mut recDiffTiers.pushBack("7");
            mut recTopSrcs.pushBack("none");
            mut recStatuses.pushBack("verified");
            mut recCsvRows.pushBack(challenges.csvEscapeField(cid) + "," + challenges.csvEscapeField(ttl) + ",jane-street,puzzles,,,,"
            + challenges.csvEscapeField(tagsList.join(";")) + ",Puzzle,7.0,none,puzzle,False," + challenges.csvEscapeField(curl));
        }
    }

    sortedIdsForCheck := recIds.sortTexts();
    var di := 1;
    loop di < sortedIdsForCheck.length() {
        if sortedIdsForCheck[di] == sortedIdsForCheck[di - 1] {
            return (ok = false, summaryText = "", error = "duplicate challenge ids");
        }
        di = di + 1;
    }

    sourceOrderIndex: mut Map<String, Int>;
    var soi := 0;
    loop sourceOrder as sName {
        if not sourceOrderIndex.has(sName) {
            mut sourceOrderIndex.set(sName, soi);
        }
        soi = soi + 1;
    }

    allN := recJsons.length();
    recOrd := collections.sortIndicesBy(allN, fn(ia: Int, ib: Int): Bool {
        oaa := sourceOrderIndex.getOr(recSources[ia], 99);
        obb := sourceOrderIndex.getOr(recSources[ib], 99);
        if oaa =!= obb { return oaa < obb; }
        if recNums[ia] =!= recNums[ib] { return recNums[ia] < recNums[ib]; }
        challenges.compareTextLex(recIds[ia], recIds[ib]) <= 0
    });

    sortedJsons: mut List<String> = [];
    sortedIds: mut List<String> = [];
    sortedSources: mut List<String> = [];
    sortedCats: mut List<String> = [];
    sortedDiffs: mut List<String> = [];
    sortedTopSrcs: mut List<String> = [];
    sortedStatuses: mut List<String> = [];
    sortedCsvRows: mut List<String> = ["id,title,source,category,primary_topic,topics,raw_topics,tags,difficulty,difficulty_normalized,topics_source,formats,premium,url"];
    loop recOrd as idx {
        mut sortedJsons.pushBack(recJsons[idx]);
        mut sortedIds.pushBack(recIds[idx]);
        mut sortedSources.pushBack(recSources[idx]);
        mut sortedCats.pushBack(recCats[idx]);
        mut sortedDiffs.pushBack(recDiffTiers[idx]);
        mut sortedTopSrcs.pushBack(recTopSrcs[idx]);
        mut sortedStatuses.pushBack(recStatuses[idx]);
        mut sortedCsvRows.pushBack(recCsvRows[idx + 1]);
    }
    _unusedAllowedCats := allowedCats.length();

    listsJsonEntries: mut List<String> = [];
    listsMetaEntries: mut List<String> = [];

    rmIds: List<String> = ["blind-75", "neetcode-150"];
    rmTitles: List<String> = ["Blind 75", "NeetCode 150"];
    rmFiles: List<String> = ["blind_75.toml", "neetcode_150.toml"];
    rmUrls: List<String> = [
        "https://leetcode.com/discuss/general-discussion/460599/blind-75",
        "https://neetcode.io/practice"
    ];
    rmDescs: List<String> = [
        "The classic 75-question interview list, grouped by pattern.",
        "NeetCode's curated 150-question roadmap, grouped by pattern."
    ];
    var rmi := 0;
    loop rmi < 2 {
        rmRes := parseRoadmapListJson(
            path.join(cacheDir, "roadmaps/" + rmFiles[rmi]),
            rmIds[rmi], rmTitles[rmi], rmUrls[rmi], rmDescs[rmi], sortedIdsForCheck
        );
        if not rmRes.ok { return (ok = false, summaryText = "", error = rmRes.error); }
        if rmRes.hasList {
            mut listsJsonEntries.pushBack(rmRes.listJson);
            mut listsMetaEntries.pushBack(rmRes.metaJson);
        }
        rmi = rmi + 1;
    }

    var lyr := 2015;
    loop lyr <= 2025 {
        yStr := lyr.toText();
        yIds: mut List<String> = [];
        loop recOrd as idx {
            if recSources[idx] == "advent-of-code" and recSets[idx] == yStr {
                mut yIds.pushBack(recIds[idx]);
            }
        }
        uniqY := dedupTextsPreserveOrder(yIds);
        if uniqY.length() > 0 {
            yTitle := "Advent of Code " + yStr;
            mut listsJsonEntries.pushBack("{\"id\":\"aoc-" + yStr + "\",\"title\":" + json.quoteString(yTitle) + ",\"kind\":\"event\",\"source\":\"advent-of-code\",\"url\":\"https://adventofcode.com/" + yStr + "\",\"description\":" + json.quoteString("All " + uniqY.length().toText() + " puzzles from Advent of Code " + yStr + ".") + ",\"count\":" + uniqY.length().toText() + ",\"challenge_ids\":" + quoteStringList(uniqY) + "}");
            mut listsMetaEntries.pushBack("{\"id\":\"aoc-" + yStr + "\",\"title\":" + json.quoteString(yTitle) + ",\"count\":" + uniqY.length().toText() + "}");
        }
        lyr = lyr + 1;
    }

    csesListSecs: mut List<String> = [];
    loop recOrd as idx {
        if recSources[idx] == "cses" and not csesListSecs.contains(recSets[idx]) {
            mut csesListSecs.pushBack(recSets[idx]);
        }
    }
    loop csesListSecs as secName {
        secIds: mut List<String> = [];
        loop recOrd as idx {
            if recSources[idx] == "cses" and recSets[idx] == secName {
                mut secIds.pushBack(recIds[idx]);
            }
        }
        uniqSec := dedupTextsPreserveOrder(secIds);
        if uniqSec.length() > 0 {
            sTitle := "CSES · " + secName;
            sId := "cses-" + slugifyText(secName);
            sDesc := "CSES “" + secName + "” section (" + uniqSec.length().toText() + " tasks).";
            mut listsJsonEntries.pushBack("{\"id\":" + json.quoteString(sId) + ",\"title\":" + json.quoteString(sTitle) + ",\"kind\":\"section\",\"source\":\"cses\",\"url\":\"https://cses.fi/problemset/\",\"description\":" + json.quoteString(sDesc) + ",\"count\":" + uniqSec.length().toText() + ",\"challenge_ids\":" + quoteStringList(uniqSec) + "}");
            mut listsMetaEntries.pushBack("{\"id\":" + json.quoteString(sId) + ",\"title\":" + json.quoteString(sTitle) + ",\"count\":" + uniqSec.length().toText() + "}");
        }
    }

    loop json.objectKeys(catalogJsonText, cpField.valuePos) as setNo {
        arrPos := json.findField(catalogJsonText, cpField.valuePos, setNo).valuePos;
        offs := json.arrayOffsets(catalogJsonText, arrPos);
        setName := json.readStringAt(catalogJsonText, offs[0]).value;
        cpPrefix := "Set " + setNo + ":";
        cpIds: mut List<String> = [];
        loop recOrd as idx {
            if recSources[idx] == "cryptopals" and recSets[idx].startsWithAt(0, cpPrefix) {
                mut cpIds.pushBack(recIds[idx]);
            }
        }
        uniqCp := dedupTextsPreserveOrder(cpIds);
        if uniqCp.length() > 0 {
            cTitle := "Cryptopals · Set " + setNo + ": " + setName;
            cId := "cryptopals-set-" + setNo;
            cDesc := uniqCp.length().toText() + " crypto challenges from set " + setNo + ".";
            mut listsJsonEntries.pushBack("{\"id\":" + json.quoteString(cId) + ",\"title\":" + json.quoteString(cTitle) + ",\"kind\":\"set\",\"source\":\"cryptopals\",\"url\":\"https://cryptopals.com/sets/" + setNo + "\",\"description\":" + json.quoteString(cDesc) + ",\"count\":" + uniqCp.length().toText() + ",\"challenge_ids\":" + quoteStringList(uniqCp) + "}");
            mut listsMetaEntries.pushBack("{\"id\":" + json.quoteString(cId) + ",\"title\":" + json.quoteString(cTitle) + ",\"count\":" + uniqCp.length().toText() + "}");
        }
    }

    peFirst100: mut List<String> = [];
    loop recOrd as idx {
        if recSources[idx] == "project-euler" and recNums[idx] > 0 and recNums[idx] <= 100 {
            mut peFirst100.pushBack(recIds[idx]);
        }
    }
    uniqPe := dedupTextsPreserveOrder(peFirst100);
    mut listsJsonEntries.pushBack("{\"id\":\"project-euler-first-100\",\"title\":\"Project Euler · First 100\",\"kind\":\"collection\",\"source\":\"project-euler\",\"url\":\"https://projecteuler.net/archives\",\"description\":\"The classic first hundred Project Euler problems; a common starting target.\",\"count\":" + uniqPe.length().toText() + ",\"challenge_ids\":" + quoteStringList(uniqPe) + "}");
    mut listsMetaEntries.pushBack("{\"id\":\"project-euler-first-100\",\"title\":\"Project Euler · First 100\",\"count\":" + uniqPe.length().toText() + "}");

    lcCatIds: List<String> = ["databases", "concurrency", "shell"];
    lcCatTitles: List<String> = ["LeetCode · Database", "LeetCode · Concurrency", "LeetCode · Shell"];
    lcCatDescs: List<String> = [
        "All SQL/database problems in the corpus; good for SQL interview prep.",
        "Threads, locks and synchronization problems.",
        "Unix shell and command-line problems."
    ];
    var lci := 0;
    loop lci < 3 {
        catId := lcCatIds[lci];
        cIds: mut List<String> = [];
        loop recOrd as idx {
            if recSources[idx] == "leetcode" and recCats[idx] == catId {
                mut cIds.pushBack(recIds[idx]);
            }
        }
        uniqC := dedupTextsPreserveOrder(cIds);
        if uniqC.length() > 0 {
            lId := "leetcode-" + catId;
            mut listsJsonEntries.pushBack("{\"id\":" + json.quoteString(lId) + ",\"title\":" + json.quoteString(lcCatTitles[lci]) + ",\"kind\":\"collection\",\"source\":\"leetcode\",\"url\":\"https://leetcode.com/problemset/\",\"description\":" + json.quoteString(lcCatDescs[lci]) + ",\"count\":" + uniqC.length().toText() + ",\"challenge_ids\":" + quoteStringList(uniqC) + "}");
            mut listsMetaEntries.pushBack("{\"id\":" + json.quoteString(lId) + ",\"title\":" + json.quoteString(lcCatTitles[lci]) + ",\"count\":" + uniqC.length().toText() + "}");
        }
        lci = lci + 1;
    }

    dataDir := path.join(challengesRootDir, "data");
    schemaDir := path.join(challengesRootDir, "schema");
    _md1 := fs.makeDir(dataDir);
    _md2 := fs.makeDir(schemaDir);
    _wj := fs.writeText(path.join(dataDir, "challenges.jsonl"), if allN == 0 { "" } else { sortedJsons.join("\n") + "\n" });
    _wl := fs.writeText(path.join(dataDir, "lists.jsonl"), if listsJsonEntries.length() == 0 { "" } else { listsJsonEntries.join("\n") + "\n" });
    _wc := fs.writeText(path.join(dataDir, "challenges.csv"), sortedCsvRows.join("\r\n") + "\r\n");

    siEntries: mut List<String> = [];
    taxSrcEntries: mut List<String> = [];
    loop json.arrayOffsets(catalogJsonText, siField.valuePos) as sp {
        offs := json.arrayOffsets(catalogJsonText, sp);
        sid := json.readStringAt(catalogJsonText, offs[0]).value;
        sname := json.readStringAt(catalogJsonText, offs[1]).value;
        shome := json.readStringAt(catalogJsonText, offs[2]).value;
        sdesc := json.readStringAt(catalogJsonText, offs[3]).value;
        var sCount := 0;
        loop sortedSources as rs { if rs == sid { sCount = sCount + 1; } }
        (mut siEntries).pushBack("{\"id\":" + json.quoteString(sid) + ",\"name\":" + json.quoteString(sname) + ",\"homepage\":" + json.quoteString(shome) + ",\"description\":" + json.quoteString(sdesc) + ",\"count\":" + sCount.toText() + "}");
        mut taxSrcEntries.pushBack("{\"id\":" + json.quoteString(sid) + ",\"name\":" + json.quoteString(sname) + ",\"homepage\":" + json.quoteString(shome) + ",\"description\":" + json.quoteString(sdesc) + "}");
    }

    uniqueSortedTopics := dedupTextsPreserveOrder(recTopicsAll.sortTexts());
    taxTopicEntries: mut List<String> = [];
    loop uniqueSortedTopics as tid {
        lblR := json.readFieldString(catalogJsonText, tlField.valuePos, tid);
        grpR := json.readFieldString(catalogJsonText, tgField.valuePos, tid);
        lbl := if lblR.found and lblR.ok { lblR.value } else { titleCaseTopic(tid) };
        grp := if grpR.found and grpR.ok { grpR.value } else { "other" };
        mut taxTopicEntries.pushBack("{\"id\":" + json.quoteString(tid) + ",\"label\":" + json.quoteString(lbl) + ",\"group\":" + json.quoteString(grp) + "}");
    }

    taxCatEntries: mut List<String> = [];
    loop json.objectKeys(catalogJsonText, catField.valuePos) as cid {
        cdesc := json.readFieldString(catalogJsonText, catField.valuePos, cid).value;
        mut taxCatEntries.pushBack("{\"id\":" + json.quoteString(cid) + ",\"description\":" + json.quoteString(cdesc) + "}");
    }

    dbSpan := json.valueSpan(catalogJsonText, dbField.valuePos);
    dbJson := catalogJsonText.slice(dbSpan.start, dbSpan.end);

    indexJson := "{\n"
    + "  \"total\": " + allN.toText() + ",\n"
    + "  \"built\": " + json.quoteString(time.localDate()) + ",\n"
    + "  \"sources\": [" + siEntries.join(",") + "],\n"
    + "  \"categories\": " + challenges.formatSortedCountsJson(sortedCats) + ",\n"
    + "  \"difficulty\": " + challenges.formatSortedCountsJson(sortedDiffs) + ",\n"
    + "  \"topics\": " + challenges.formatSortedCountsJson(recTopicsAll) + ",\n"
    + "  \"topics_source\": " + challenges.formatSortedCountsJson(sortedTopSrcs) + ",\n"
    + "  \"status\": " + challenges.formatSortedCountsJson(sortedStatuses) + ",\n"
    + "  \"lists\": [" + listsMetaEntries.join(",") + "]\n}\n";
    _wi := fs.writeText(path.join(dataDir, "index.json"), indexJson);

    taxJson := "{\n"
    + "  \"version\": 1,\n"
    + "  \"note\": \"Generated by tools/build.ts from the topics present in the corpus.\",\n"
    + "  \"categories\": [" + taxCatEntries.join(",") + "],\n"
    + "  \"topics\": [" + taxTopicEntries.join(",") + "],\n"
    + "  \"difficulty\": { \"scale\": \"normalized 1-10\", \"bands\": " + dbJson + " },\n"
    + "  \"sources\": [" + taxSrcEntries.join(",") + "]\n}\n";
    _wt := fs.writeText(path.join(schemaDir, "taxonomy.json"), taxJson);

    sumLines: mut List<String> = [
    "wrote " + allN.toText() + " challenges, " + listsJsonEntries.length().toText() + " lists"
    ];
    loop sourceOrder as sid {
        var sc := 0;
        loop sortedSources as rs { if rs == sid { sc = sc + 1; } }
        (mut sumLines).pushBack("  " + sid.padRight(16) + " " + sc.toText().padLeft(5));
    }
    (mut sumLines).pushBack("  " + "TOTAL".padRight(16) + " " + allN.toText().padLeft(5));
    mut sumLines.pushBack("  topics: " + uniqueSortedTopics.length().toText() + "   categories: " + dedupTextsPreserveOrder(sortedCats).length().toText());
    (ok = true, summaryText = sumLines.join("\n"), error = "")
};

/** CLI runner for `benchmark/challenges/tools/build.ts`. */
pub runBuildCorpusCommand := fn(rootDir: String): Int {
    chRoot := path.join(rootDir, "benchmark/challenges");
    catRead := fs.readText(path.join(chRoot, "tools/catalog.json"));
    if not catRead.ok { io.errorLine("FAIL: " + catRead.error); return 1; }
    entRead := fs.readText(path.join(chRoot, "tools/html-entities.json"));
    if not entRead.ok { io.errorLine("FAIL: " + entRead.error); return 1; }
    res := buildChallengeCorpus(chRoot, catRead.text, entRead.text);
    if not res.ok {
        io.errorLine("FAIL: " + res.error);
        return 1;
    }
    io.outputLine(res.summaryText);
    0
};
