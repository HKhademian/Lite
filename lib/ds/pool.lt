/** Generational slot pools (`ds/pool`) for O(1) object reuse with safe stale-handle detection. */

/** Generational handle identifying a single slot inside a pool. */
pub Handle := record {
    index: Int;
    generation: Int;
}

/** Sentinel invalid handle returned when a pool is full or has no slot. */
pub INVALID_HANDLE := Handle { index = -1, generation = 0 };

/** True when `h` has a non-negative index and positive generation. */
pub Handle.isValid := fn(h: Self): Bool {
    h.index >= 0 and h.generation > 0
};

/** True when `a` and `b` refer to the exact same slot index and generation. */
pub Handle.equals := fn(a: Self, b: Self): Bool {
    a.index == b.index and a.generation == b.generation
};

/** Outcome of reading a `Pool<T>` entry by handle. */
pub PoolItem := enum<T: Type> {
    Empty;
    Some(T);
}

/** True when `item` holds a value `.Some(...)`. */
pub PoolItem.isSome := fn<T: Type>(item: Self<T>): Bool {
    match item {
        .Empty { false }
        .Some { true }
    }
};

/** Returns the wrapped value when `.Some(v)`, or `fallback` when `.Empty`. */
pub PoolItem.unwrapOr := fn<T: Type>(item: Self<T>, fallback: T): T {
    match item {
        .Empty { fallback }
        .Some(v) { v }
    }
};

/** Fixed-capacity generational slot allocator (pairs with user-owned parallel arrays). */
pub SlotPool := record {
    slotGen: List<Int>;
    slotAlive: List<Bool>;
    freeList: List<Int>;
    cap: Int;
    liveCount: Int;
}

/** Generic fixed-capacity generational pool storing `T` values per live slot. */
pub Pool := record<T: Type> {
    values: List<T>;
    slotGen: List<Int>;
    slotAlive: List<Bool>;
    freeList: List<Int>;
    cap: Int;
    liveCount: Int;
}

/** Generational pool storing `Int` values. */
pub IntPool := alias Pool<Int>;

/** Generational pool storing `String` values. */
pub TextPool := alias Pool<String>;

/* ============================================================================
 * SlotPool
 * ============================================================================ */

/** Creates a fixed-capacity generational `SlotPool` with O(1) acquire and release. */
pub SlotPool.create := fn(capacity: Int): Self {
    cap := if capacity < 0 { 0 } else { capacity };
    gens: mut List<Int> = [];
    alive: mut List<Bool> = [];
    free: mut List<Int> = [];
    loop 0..cap as i {
        mut gens.pushBack(1);
        mut alive.pushBack(false);
        mut free.pushBack(cap - 1 - i);
    }
    Self { slotGen = gens, slotAlive = alive, freeList = free, cap = cap, liveCount = 0 }
};

/** Acquires a slot in O(1), returning its generational `Handle` or `INVALID_HANDLE` if full. */
pub SlotPool.acquire := fn(p: mut Self): Handle {
    if p.freeList.length() == 0 { return INVALID_HANDLE; }
    fl: mut List<Int> = p.freeList;
    idx := mut fl.popBack();
    al: mut List<Bool> = p.slotAlive;
    mut al.setAt(idx, true);
    p.freeList = fl;
    p.slotAlive = al;
    p.liveCount = p.liveCount + 1;
    Handle { index = idx, generation = p.slotGen[idx] }
};

/** True when `h` points to a currently allocated slot with matching generation in `p`. */
pub SlotPool.isAlive := fn(p: Self, h: Handle): Bool {
    if h.index < 0 or h.index >= p.cap { return false; }
    p.slotAlive[h.index] and p.slotGen[h.index] == h.generation
};

/** Releases slot `h` in O(1) and bumps its generation; returns `false` if already released/stale. */
pub SlotPool.release := fn(p: mut Self, h: Handle): Bool {
    if not p.isAlive(h) { return false; }
    idx := h.index;
    al: mut List<Bool> = p.slotAlive;
    gs: mut List<Int> = p.slotGen;
    fl: mut List<Int> = p.freeList;
    mut al.setAt(idx, false);
    mut gs.setAt(idx, gs[idx] + 1);
    mut fl.pushBack(idx);
    p.slotAlive = al;
    p.slotGen = gs;
    p.freeList = fl;
    p.liveCount = p.liveCount - 1;
    true
};

/** Returns the number of currently live slots in `p`. */
pub SlotPool.count := fn(p: Self): Int { p.liveCount };

/** Returns the total slot capacity of `p`. */
pub SlotPool.capacity := fn(p: Self): Int { p.cap };

/** Returns the number of free slots remaining in `p`. */
pub SlotPool.freeCount := fn(p: Self): Int { p.cap - p.liveCount };

/** Releases all live slots and bumps their generations in O(capacity). */
pub SlotPool.clear := fn(p: mut Self): Unit {
    al: mut List<Bool> = p.slotAlive;
    gs: mut List<Int> = p.slotGen;
    fl: mut List<Int> = [];
    loop 0..p.cap as i {
        if al[i] {
            mut al.setAt(i, false);
            mut gs.setAt(i, gs[i] + 1);
        }
        mut fl.pushBack(p.cap - 1 - i);
    }
    p.slotAlive = al;
    p.slotGen = gs;
    p.freeList = fl;
    p.liveCount = 0;
};

/* ============================================================================
 * Generic Pool<T>
 * ============================================================================ */

/** Creates a fixed-capacity generic `Pool<T>` storing `T` payloads per slot. */
pub Pool.create := fn<T: Type>(capacity: Int): Self<T> {
    cap := if capacity < 0 { 0 } else { capacity };
    vals: mut List<T> = [];
    gens: mut List<Int> = [];
    alive: mut List<Bool> = [];
    free: mut List<Int> = [];
    z: T;
    loop 0..cap as i {
        mut vals.pushBack(z);
        mut gens.pushBack(1);
        mut alive.pushBack(false);
        mut free.pushBack(cap - 1 - i);
    }
    Self<T> { values = vals, slotGen = gens, slotAlive = alive, freeList = free, cap = cap, liveCount = 0 }
};

/** Allocates a slot in `p` initialized with `value`, returning `Handle` or `INVALID_HANDLE` if full. */
pub Pool.acquire := fn<T: Type>(p: mut Self<T>, value: T): Handle {
    if p.freeList.length() == 0 { return INVALID_HANDLE; }
    fl: mut List<Int> = p.freeList;
    idx := mut fl.popBack();
    vs: mut List<T> = p.values;
    al: mut List<Bool> = p.slotAlive;
    mut vs.setAt(idx, value);
    mut al.setAt(idx, true);
    p.freeList = fl;
    p.values = vs;
    p.slotAlive = al;
    p.liveCount = p.liveCount + 1;
    Handle { index = idx, generation = p.slotGen[idx] }
};

/** True when `h` points to a currently live slot in `p`. */
pub Pool.isAlive := fn<T: Type>(p: Self<T>, h: Handle): Bool {
    if h.index < 0 or h.index >= p.cap { return false; }
    p.slotAlive[h.index] and p.slotGen[h.index] == h.generation
};

/** Reads the `T` value at `h`, or `.Empty` when stale/invalid. */
pub Pool.get := fn<T: Type>(p: Self<T>, h: Handle): PoolItem<T> {
    if not p.isAlive(h) { .Empty } else { .Some(p.values[h.index]) }
};

/** Overwrites the `T` value at `h`; returns `false` when stale/invalid. */
pub Pool.set := fn<T: Type>(p: mut Self<T>, h: Handle, value: T): Bool {
    if not p.isAlive(h) { return false; }
    vs: mut List<T> = p.values;
    mut vs.setAt(h.index, value);
    p.values = vs;
    true
};

/** Releases slot `h` in O(1), clearing its payload to zero and bumping its generation. */
pub Pool.release := fn<T: Type>(p: mut Self<T>, h: Handle): Bool {
    if not p.isAlive(h) { return false; }
    idx := h.index;
    z: T;
    vs: mut List<T> = p.values;
    al: mut List<Bool> = p.slotAlive;
    gs: mut List<Int> = p.slotGen;
    fl: mut List<Int> = p.freeList;
    mut vs.setAt(idx, z);
    mut al.setAt(idx, false);
    mut gs.setAt(idx, gs[idx] + 1);
    mut fl.pushBack(idx);
    p.values = vs;
    p.slotAlive = al;
    p.slotGen = gs;
    p.freeList = fl;
    p.liveCount = p.liveCount - 1;
    true
};

/** Returns the number of live slots in `p`. */
pub Pool.count := fn<T: Type>(p: Self<T>): Int { p.liveCount };

/** Returns the total slot capacity of `p`. */
pub Pool.capacity := fn<T: Type>(p: Self<T>): Int { p.cap };

/** Returns the number of free slots remaining in `p`. */
pub Pool.freeCount := fn<T: Type>(p: Self<T>): Int { p.cap - p.liveCount };

/** Releases all live slots in `p`, resetting payloads to zero and bumping generations. */
pub Pool.clear := fn<T: Type>(p: mut Self<T>): Unit {
    z: T;
    vs: mut List<T> = p.values;
    al: mut List<Bool> = p.slotAlive;
    gs: mut List<Int> = p.slotGen;
    fl: mut List<Int> = [];
    loop 0..p.cap as i {
        if al[i] {
            mut vs.setAt(i, z);
            mut al.setAt(i, false);
            mut gs.setAt(i, gs[i] + 1);
        }
        mut fl.pushBack(p.cap - 1 - i);
    }
    p.values = vs;
    p.slotAlive = al;
    p.slotGen = gs;
    p.freeList = fl;
    p.liveCount = 0;
};
