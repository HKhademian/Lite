/* Fixed-capacity generational slot and typed object pools with O(1) packed free-list reuse. */

/** Generational handle identifying a slot inside a `SlotPool` or `Pool<T>`. */
pub Handle := record {
    index: Int;
    generation: Int;
};

/** Sentinel invalid handle (`index = -1, generation = 0`). */
pub INVALID_HANDLE := Handle { index = -1, generation = 0 };

/** True when `h` references a valid non-negative slot index and positive generation. */
pub Handle.isValid := fn(h: Self): Bool {
    h.index >= 0 and h.generation > 0
};

/** True when `a` and `b` carry identical slot index and generation. */
pub Handle.equals := fn(a: Self, b: Self): Bool {
    a.index == b.index and a.generation == b.generation
};

/** Fixed-capacity generational handle allocator backed by packed 32-bit metadata and LIFO free list. */
pub SlotPool := record {
    slotMeta: List<UInt32>;
    freeList: List<UInt32>;
    cap: Int;
    liveCount: Int;
};

/** Fixed-capacity generational typed object pool (`values` + packed 32-bit slot metadata). */
pub Pool := record<T: Type> {
    values: List<T>;
    slotMeta: List<UInt32>;
    freeList: List<UInt32>;
    cap: Int;
    liveCount: Int;
};

/** Convenience alias for a pool of `Int` values. */
pub IntPool := alias Pool<Int>;

/** Convenience alias for a pool of `String` values. */
pub TextPool := alias Pool<String>;

packMeta := fn(gen: Int, alive: Bool): UInt32 {
    masked := gen.bitAnd(2147483647);
    cast<UInt32>(if alive { masked.bitOr(2147483648) } else { masked })
};

metaGen := fn(meta: UInt32): Int {
    cast<Int>(meta).bitAnd(2147483647)
};

metaAlive := fn(meta: UInt32): Bool {
    cast<Int>(meta).bitAnd(2147483648) =!= 0
};

bumpGeneration := fn(gen: Int): Int {
    if gen >= 2147483647 { 1 } else { gen + 1 }
};

/** Creates a `SlotPool` pre-populated with `capacity` recyclable generational slots. */
pub SlotPool.create := fn(capacity: Int): Self {
    mut meta: List<UInt32> = [];
    mut free: List<UInt32> = [];
    if capacity <= 0 {
        return SlotPool { slotMeta = meta, freeList = free, cap = 0, liveCount = 0 };
    }
    var i := 0;
    loop i < capacity {
        mut meta.pushBack(packMeta(1, false));
        mut free.pushBack(cast<UInt32>(capacity - 1 - i));
        i = i + 1;
    }
    SlotPool { slotMeta = meta, freeList = free, cap = capacity, liveCount = 0 }
};

/** Acquires one free slot handle in O(1), or `INVALID_HANDLE` when full. */
pub SlotPool.acquire := fn(p: mut Self): Handle {
    if p.freeList.length() == 0 { return INVALID_HANDLE; }
    slotIdx := cast<Int>(mut p.freeList.popBack());
    gen := metaGen(p.slotMeta[slotIdx]);
    mut p.slotMeta.setAt(slotIdx, packMeta(gen, true));
    p.liveCount = p.liveCount + 1;
    Handle { index = slotIdx, generation = gen }
};

/** Acquires one free slot handle in O(1), returning `.None` when full. */
pub SlotPool.tryAcquire := fn(p: mut Self): Option<Handle> {
    if p.freeList.length() == 0 { return .None; }
    .Some(mut p.acquire())
};

/** True when `h` matches an currently live slot inside `p`. */
pub SlotPool.isAlive := fn(p: Self, h: Handle): Bool {
    if h.index < 0 or h.index >= p.cap or h.generation <= 0 { return false; }
    m := p.slotMeta[h.index];
    metaAlive(m) and metaGen(m) == h.generation
};

/** Releases `h` back to the free list and bumps its slot generation. */
pub SlotPool.release := fn(p: mut Self, h: Handle): Bool {
    if not p.isAlive(h) { return false; }
    nextGen := bumpGeneration(metaGen(p.slotMeta[h.index]));
    mut p.slotMeta.setAt(h.index, packMeta(nextGen, false));
    mut p.freeList.pushBack(cast<UInt32>(h.index));
    p.liveCount = p.liveCount - 1;
    true
};

/** Returns number of currently live handles. */
pub SlotPool.count := fn(p: Self): Int { p.liveCount };
/** Returns total slot capacity of `p`. */
pub SlotPool.capacity := fn(p: Self): Int { p.cap };
/** Returns remaining free slot count in `p`. */
pub SlotPool.freeCount := fn(p: Self): Int { p.cap - p.liveCount };

/** Invalidates all live handles in-place and resets the free list without reallocating. */
pub SlotPool.clear := fn(p: mut Self): Unit {
    mut p.freeList.clear();
    var i := 0;
    loop i < p.cap {
        nextGen := bumpGeneration(metaGen(p.slotMeta[i]));
        mut p.slotMeta.setAt(i, packMeta(nextGen, false));
        i = i + 1;
    }
    var j := 0;
    loop j < p.cap {
        mut p.freeList.pushBack(cast<UInt32>(p.cap - 1 - j));
        j = j + 1;
    }
    p.liveCount = 0;
};

/** Creates a typed object pool with capacity `capacity` and dense value storage. */
pub Pool.create := fn<T: Type>(capacity: Int): Self<T> {
    mut vals: List<T> = [];
    mut meta: List<UInt32> = [];
    mut free: List<UInt32> = [];
    if capacity <= 0 {
        return Pool<T> { values = vals, slotMeta = meta, freeList = free, cap = 0, liveCount = 0 };
    }
    var i := 0;
    loop i < capacity {
        mut meta.pushBack(packMeta(1, false));
        mut free.pushBack(cast<UInt32>(capacity - 1 - i));
        i = i + 1;
    }
    Pool<T> { values = vals, slotMeta = meta, freeList = free, cap = capacity, liveCount = 0 }
};

/** Acquires a slot storing `value` in O(1), or returns `INVALID_HANDLE` when full. */
pub Pool.acquire := fn<T: Type>(p: mut Self<T>, value: T): Handle {
    if p.freeList.length() == 0 { return INVALID_HANDLE; }
    slotIdx := cast<Int>(mut p.freeList.popBack());
    loop p.values.length() <= slotIdx {
        mut p.values.pushBack(value);
    }
    mut p.values.setAt(slotIdx, value);
    gen := metaGen(p.slotMeta[slotIdx]);
    mut p.slotMeta.setAt(slotIdx, packMeta(gen, true));
    p.liveCount = p.liveCount + 1;
    Handle { index = slotIdx, generation = gen }
};

/** Acquires a slot storing `value` in O(1), returning `.None` when full. */
pub Pool.tryInsert := fn<T: Type>(p: mut Self<T>, value: T): Option<Handle> {
    if p.freeList.length() == 0 { return .None; }
    .Some(mut p.acquire(value))
};

/** True when `h` points to a live slot in `p`. */
pub Pool.isAlive := fn<T: Type>(p: Self<T>, h: Handle): Bool {
    if h.index < 0 or h.index >= p.cap or h.generation <= 0 { return false; }
    m := p.slotMeta[h.index];
    metaAlive(m) and metaGen(m) == h.generation
};

/** Returns `.Some(value)` if `h` is alive, otherwise `.None`. */
pub Pool.get := fn<T: Type>(p: Self<T>, h: Handle): Option<T> {
    if not p.isAlive(h) { return .None; }
    .Some(p.values[h.index])
};

/** Overwrites a live slot's stored value in-place; returns `false` for stale/invalid handles. */
pub Pool.set := fn<T: Type>(p: mut Self<T>, h: Handle, value: T): Bool {
    if not p.isAlive(h) { return false; }
    mut p.values.setAt(h.index, value);
    true
};

/** Releases `h` and returns it to the free list while incrementing generation. */
pub Pool.release := fn<T: Type>(p: mut Self<T>, h: Handle): Bool {
    if not p.isAlive(h) { return false; }
    nextGen := bumpGeneration(metaGen(p.slotMeta[h.index]));
    mut p.slotMeta.setAt(h.index, packMeta(nextGen, false));
    mut p.freeList.pushBack(cast<UInt32>(h.index));
    p.liveCount = p.liveCount - 1;
    true
};

/** Returns number of live objects held in `p`. */
pub Pool.count := fn<T: Type>(p: Self<T>): Int { p.liveCount };
/** Returns total slot capacity of `p`. */
pub Pool.capacity := fn<T: Type>(p: Self<T>): Int { p.cap };
/** Returns remaining free slot count in `p`. */
pub Pool.freeCount := fn<T: Type>(p: Self<T>): Int { p.cap - p.liveCount };

/** Clears all live objects in-place and bumps every slot's generation. */
pub Pool.clear := fn<T: Type>(p: mut Self<T>): Unit {
    mut p.freeList.clear();
    var i := 0;
    loop i < p.cap {
        nextGen := bumpGeneration(metaGen(p.slotMeta[i]));
        mut p.slotMeta.setAt(i, packMeta(nextGen, false));
        i = i + 1;
    }
    var j := 0;
    loop j < p.cap {
        mut p.freeList.pushBack(cast<UInt32>(p.cap - 1 - j));
        j = j + 1;
    }
    p.liveCount = 0;
};
