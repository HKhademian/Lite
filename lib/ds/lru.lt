/** Bounded-capacity generic O(1) LRU caches (`ds/lru`) with strict memory ceilings across TS and C11. */

/** Supported cache key scalar types. */
pub LruKey := alias Int | String;

/** Cache occupancy and hit/miss/eviction counters. */
pub LruStats := record {
    count: Int;
    capacity: Int;
    hits: Int;
    misses: Int;
    evictions: Int;
}

/** Outcome of reading a value from an `Lru<K, V>`. */
pub LruValue := enum<V: Type> {
    Empty;
    Some(V);
}

/** True when `item` holds `.Some(...)`. */
pub LruValue.isSome := fn<V: Type>(item: Self<V>): Bool {
    match item {
        .Empty { false }
        .Some { true }
    }
};

/** Returns the cached value when `.Some(v)`, or `fallback` when `.Empty`. */
pub LruValue.unwrapOr := fn<V: Type>(item: Self<V>, fallback: V): V {
    match item {
        .Empty { fallback }
        .Some(v) { v }
    }
};

/** Outcome of querying newest or oldest key from an `Lru<K, V>`. */
pub LruKeyOpt := enum<K: Type<LruKey>> {
    Empty;
    Some(K);
}

/** True when `item` holds a key `.Some(...)`. */
pub LruKeyOpt.isSome := fn<K: Type<LruKey>>(item: Self<K>): Bool {
    match item {
        .Empty { false }
        .Some { true }
    }
};

/** Returns the key when `.Some(k)`, or `fallback` when `.Empty`. */
pub LruKeyOpt.unwrapOr := fn<K: Type<LruKey>>(item: Self<K>, fallback: K): K {
    match item {
        .Empty { fallback }
        .Some(k) { k }
    }
};

/** Eviction report returned by `Lru.put` and `Lru.evictOldest`. */
pub LruEviction := record<K: Type<LruKey>, V: Type> {
    evicted: Bool;
    key: K;
    value: V;
}

/** Generic bounded-capacity O(1) LRU cache mapping `K` keys to `V` values. */
pub Lru := record<K: Type<LruKey>, V: Type> {
    keys: List<K>;
    vals: List<V>;
    prev: List<Int>;
    next: List<Int>;
    freeSlots: List<Int>;
    index: Map<K, Int>;
    cap: Int;
    head: Int;
    tail: Int;
    hits: Int;
    misses: Int;
    evictions: Int;
}

/** Bounded-capacity `String -> String` LRU cache alias. */
pub LruText := alias Lru<String, String>;

/** Bounded-capacity `String -> Int` LRU cache alias. */
pub LruInt := alias Lru<String, Int>;

/** Bounded-capacity `Int -> Int` LRU cache alias. */
pub IntLru := alias Lru<Int, Int>;

lruUnlink := fn<K: Type<LruKey>, V: Type>(c: mut Lru<K, V>, idx: Int): Unit {
    p := c.prev[idx];
    n := c.next[idx];
    mut pr: List<Int> = c.prev;
    mut nx: List<Int> = c.next;
    if p >= 0 { mut nx.setAt(p, n); } else { c.head = n; }
    if n >= 0 { mut pr.setAt(n, p); } else { c.tail = p; }
    mut pr.setAt(idx, -1);
    mut nx.setAt(idx, -1);
    c.prev = pr;
    c.next = nx;
};

lruPushFront := fn<K: Type<LruKey>, V: Type>(c: mut Lru<K, V>, idx: Int): Unit {
    oldHead := c.head;
    mut pr: List<Int> = c.prev;
    mut nx: List<Int> = c.next;
    mut pr.setAt(idx, -1);
    mut nx.setAt(idx, oldHead);
    if oldHead >= 0 { mut pr.setAt(oldHead, idx); } else { c.tail = idx; }
    c.prev = pr;
    c.next = nx;
    c.head = idx;
};

/** Creates a bounded O(1) `Lru<K, V>` cache holding at most `capacity` entries (`>= 1`). */
pub Lru.create := fn<K: Type<LruKey>, V: Type>(capacity: Int): Self<K, V> {
    cap := if capacity < 1 { 1 } else { capacity };
    mut ks: List<K> = [];
    mut vs: List<V> = [];
    mut pr: List<Int> = [];
    mut nx: List<Int> = [];
    mut fl: List<Int> = [];
    zk: K;
    zv: V;
    loop 0..cap as i {
        mut ks.pushBack(zk);
        mut vs.pushBack(zv);
        mut pr.pushBack(-1);
        mut nx.pushBack(-1);
        mut fl.pushBack(cap - 1 - i);
    }
    idxMap: Map<K, Int>;
    Lru<K, V> {
    keys = ks, vals = vs, prev = pr, next = nx, freeSlots = fl, index = idxMap,
    cap = cap, head = -1, tail = -1, hits = 0, misses = 0, evictions = 0
    }
};

/** Inserts or updates `key -> value`, moving it to most-recently-used and returning any evicted entry. */
pub Lru.put := fn<K: Type<LruKey>, V: Type>(c: mut Self<K, V>, key: K, value: V): LruEviction<K, V> {
    existing := c.index.get(key);
    if existing.found {
        idx := existing.value;
        mut vs: List<V> = c.vals;
        mut vs.setAt(idx, value);
        c.vals = vs;
        lruUnlink<K, V>(mut c, idx);
        lruPushFront<K, V>(mut c, idx);
        return LruEviction<K, V> {};
    }

    var ev := LruEviction<K, V> {};
    var slot := -1;
    if c.freeSlots.length() > 0 {
        mut fl: List<Int> = c.freeSlots;
        slot = mut fl.popBack();
        c.freeSlots = fl;
    } else {
        victim := c.tail;
        ev = LruEviction<K, V> { evicted = true, key = c.keys[victim], value = c.vals[victim] };
        mut mp: Map<K, Int> = c.index;
        _rm := mut mp.remove(c.keys[victim]);
        c.index = mp;
        lruUnlink<K, V>(mut c, victim);
        c.evictions = c.evictions + 1;
        slot = victim;
    }

    mut ks: List<K> = c.keys;
    mut vs: List<V> = c.vals;
    mut mp: Map<K, Int> = c.index;
    mut ks.setAt(slot, key);
    mut vs.setAt(slot, value);
    mut mp.set(key, slot);
    c.keys = ks;
    c.vals = vs;
    c.index = mp;
    lruPushFront<K, V>(mut c, slot);
    ev
};

/** Looks up `key` in O(1), updating hit/miss counters and promoting to most-recently-used on hit. */
pub Lru.get := fn<K: Type<LruKey>, V: Type>(c: mut Self<K, V>, key: K): LruValue<V> {
    res := c.index.get(key);
    if not res.found {
        c.misses = c.misses + 1;
        return .Empty;
    }
    c.hits = c.hits + 1;
    idx := res.value;
    lruUnlink<K, V>(mut c, idx);
    lruPushFront<K, V>(mut c, idx);
    .Some(c.vals[idx])
};

/** Reads `key` in O(1) without changing recency order or hit/miss counters. */
pub Lru.peek := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>, key: K): LruValue<V> {
    res := c.index.get(key);
    if not res.found { .Empty } else { .Some(c.vals[res.value]) }
};

/** True when `key` is currently cached. */
pub Lru.has := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>, key: K): Bool {
    c.index.has(key)
};

/** Removes `key` from `c` in O(1); returns `true` if it was present. */
pub Lru.remove := fn<K: Type<LruKey>, V: Type>(c: mut Self<K, V>, key: K): Bool {
    res := c.index.get(key);
    if not res.found { return false; }
    idx := res.value;
    mut mp: Map<K, Int> = c.index;
    _rm := mut mp.remove(key);
    c.index = mp;
    lruUnlink<K, V>(mut c, idx);
    zk: K;
    zv: V;
    mut ks: List<K> = c.keys;
    mut vs: List<V> = c.vals;
    mut fl: List<Int> = c.freeSlots;
    mut ks.setAt(idx, zk);
    mut vs.setAt(idx, zv);
    mut fl.pushBack(idx);
    c.keys = ks;
    c.vals = vs;
    c.freeSlots = fl;
    true
};

/** Evicts and returns the least-recently-used entry, or `evicted = false` when empty. */
pub Lru.evictOldest := fn<K: Type<LruKey>, V: Type>(c: mut Self<K, V>): LruEviction<K, V> {
    if c.tail < 0 { return LruEviction<K, V> {}; }
    victim := c.tail;
    ev := LruEviction<K, V> { evicted = true, key = c.keys[victim], value = c.vals[victim] };
    mut mp: Map<K, Int> = c.index;
    _rm := mut mp.remove(c.keys[victim]);
    c.index = mp;
    lruUnlink<K, V>(mut c, victim);
    zk: K;
    zv: V;
    mut ks: List<K> = c.keys;
    mut vs: List<V> = c.vals;
    mut fl: List<Int> = c.freeSlots;
    mut ks.setAt(victim, zk);
    mut vs.setAt(victim, zv);
    mut fl.pushBack(victim);
    c.keys = ks;
    c.vals = vs;
    c.freeSlots = fl;
    c.evictions = c.evictions + 1;
    ev
};

/** Returns the most-recently-used key, or `.Empty` if empty. */
pub Lru.newestKey := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>): LruKeyOpt<K> {
    if c.head < 0 { .Empty } else { .Some(c.keys[c.head]) }
};

/** Returns the least-recently-used key, or `.Empty` if empty. */
pub Lru.oldestKey := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>): LruKeyOpt<K> {
    if c.tail < 0 { .Empty } else { .Some(c.keys[c.tail]) }
};

/** Number of entries currently stored in `c`. */
pub Lru.count := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>): Int {
    c.index.size()
};

/** Maximum entry capacity of `c`. */
pub Lru.capacity := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>): Int {
    c.cap
};

/** Returns an `LruStats` snapshot for `c`. */
pub Lru.stats := fn<K: Type<LruKey>, V: Type>(c: Self<K, V>): LruStats {
    LruStats {
    count = c.index.size(),
    capacity = c.cap,
    hits = c.hits,
    misses = c.misses,
    evictions = c.evictions
    }
};

/** Clears all entries and resets statistics counters on `c`. */
pub Lru.clear := fn<K: Type<LruKey>, V: Type>(c: mut Self<K, V>): Unit {
    zk: K;
    zv: V;
    mut ks: List<K> = c.keys;
    mut vs: List<V> = c.vals;
    mut pr: List<Int> = c.prev;
    mut nx: List<Int> = c.next;
    mut fl: List<Int> = [];
    loop 0..c.cap as i {
        mut ks.setAt(i, zk);
        mut vs.setAt(i, zv);
        mut pr.setAt(i, -1);
        mut nx.setAt(i, -1);
        mut fl.pushBack(c.cap - 1 - i);
    }
    emptyIdx: Map<K, Int>;
    c.keys = ks;
    c.vals = vs;
    c.prev = pr;
    c.next = nx;
    c.freeSlots = fl;
    c.index = emptyIdx;
    c.head = -1;
    c.tail = -1;
    c.hits = 0;
    c.misses = 0;
    c.evictions = 0;
};
