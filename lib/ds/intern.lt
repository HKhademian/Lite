/** String interner and symbol table (`ds/intern`) for O(1) identity checks and deduplication. */

/** Distinct integer identifier representing a unique interned string inside an `Interner`. */
pub SymbolId := distinct Int;

/** Sentinel invalid symbol identifier. */
pub INVALID_SYMBOL := cast<SymbolId>(-1);

/** True when `id` is a valid non-negative symbol identifier. */
pub SymbolId.isValid := fn(id: Self): Bool {
    cast<Int>(id) >= 0
};

/** Outcome of resolving a `SymbolId` inside an `Interner`. */
pub InternLookup := enum {
    None;
    Some(String);
}

/** True when `res` contains a resolved string `.Some(...)`. */
pub InternLookup.isSome := fn(res: Self): Bool {
    match res {
        .None { false }
        .Some { true }
    }
};

/** Returns the resolved string when `.Some(s)`, or `fallback` when `.None`. */
pub InternLookup.unwrapOr := fn(res: Self, fallback: String): String {
    match res {
        .None { fallback }
        .Some(s) { s }
    }
};

/** Deduplication statistics snapshot for an `Interner`. */
pub InternStats := record {
    uniqueCount: Int;
    totalChars: Int;
    internCalls: Int;
    hitCalls: Int;
}

/** Self-contained string interner mapping unique strings to dense `SymbolId`s. */
pub Interner := record {
    entries: List<String>;
    lookup: Map<String, Int>;
    totalChars: Int;
    internCalls: Int;
    hitCalls: Int;
}

/** Creates a new empty `Interner`. */
pub Interner.create := fn(): Self {
    Self {}
};

/** Interns `value` in O(1), returning its stable `SymbolId`. */
pub Interner.intern := fn(table: mut Self, value: String): SymbolId {
    table.internCalls = table.internCalls + 1;
    existing := table.lookup.get(value);
    if existing.found {
        table.hitCalls = table.hitCalls + 1;
        return cast<SymbolId>(existing.value);
    }
    eid := table.entries.length();
    mut es: List<String> = table.entries;
    mut mp: Map<String, Int> = table.lookup;
    mut es.pushBack(value);
    mut mp.set(value, eid);
    table.entries = es;
    table.lookup = mp;
    table.totalChars = table.totalChars + value.length();
    cast<SymbolId>(eid)
};

/** Looks up `value` without inserting it. */
pub Interner.lookupId := fn(table: Self, value: String): (found: Bool, id: SymbolId) {
    res := table.lookup.get(value);
    if res.found {
        (found = true, id = cast<SymbolId>(res.value))
    } else {
        (found = false, id = INVALID_SYMBOL)
    }
};

/** True when `value` is currently interned in `table`. */
pub Interner.has := fn(table: Self, value: String): Bool {
    table.lookup.has(value)
};

/** True when `id` currently resolves to a live symbol inside `table`. */
pub Interner.hasId := fn(table: Self, id: SymbolId): Bool {
    raw := cast<Int>(id);
    raw >= 0 and raw < table.entries.length()
};

/** Resolves `id` back to its interned `String` in O(1), or `.None` if absent. */
pub Interner.resolve := fn(table: Self, id: SymbolId): InternLookup {
    if not table.hasId(id) { .None } else { .Some(table.entries[cast<Int>(id)]) }
};

/** Resolves `id` back to its interned `String`, or `fallback` when absent. */
pub Interner.resolveOr := fn(table: Self, id: SymbolId, fallback: String): String {
    if not table.hasId(id) { fallback } else { table.entries[cast<Int>(id)] }
};

/** Returns the number of unique strings currently stored in `table`. */
pub Interner.count := fn(table: Self): Int {
    table.entries.length()
};

/** Returns the total character count of all unique strings currently stored in `table`. */
pub Interner.charCount := fn(table: Self): Int {
    table.totalChars
};

/** Returns deduplication statistics for `table`. */
pub Interner.stats := fn(table: Self): InternStats {
    InternStats {
    uniqueCount = table.entries.length(),
    totalChars = table.totalChars,
    internCalls = table.internCalls,
    hitCalls = table.hitCalls
    }
};

/** Clears all interned strings and resets statistics counters on `table`. */
pub Interner.clear := fn(table: mut Self): Unit {
    emptyList: List<String> = [];
    emptyMap: Map<String, Int>;
    table.entries = emptyList;
    table.lookup = emptyMap;
    table.totalChars = 0;
    table.internCalls = 0;
    table.hitCalls = 0;
};
