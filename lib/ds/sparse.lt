/** Sparse sets (`ds/sparse`) with O(1) membership/removal and cache-friendly dense iteration. */

/** Bounded-universe integer sparse set (`0..capacity-1`) with O(1) ops and dense iteration. */
pub SparseSet := record {
    sparse: List<Int>;
    dense: List<Int>;
    cap: Int;
    liveCount: Int;
}

/** Creates a sparse set supporting integer IDs in `0..capacity-1`. */
pub SparseSet.create := fn(capacity: Int): Self {
    cap := if capacity < 1 { 1 } else { capacity };
    mut sp: List<Int> = [];
    mut dn: List<Int> = [];
    loop 0..cap {
        mut sp.pushBack(-1);
        mut dn.pushBack(0);
    }
    Self { sparse = sp, dense = dn, cap = cap, liveCount = 0 }
};

/** True when `value` is currently a member of `s` in O(1). */
pub SparseSet.has := fn(s: Self, value: Int): Bool {
    if value < 0 or value >= s.cap { return false; }
    denseIdx := s.sparse[value];
    denseIdx >= 0 and denseIdx < s.liveCount and s.dense[denseIdx] == value
};

/** Inserts `value` (`0..capacity-1`) into `s` in O(1); returns `true` if newly inserted. */
pub SparseSet.insert := fn(s: mut Self, value: Int): Bool {
    if value < 0 or value >= s.cap or s.has(value) { return false; }
    cnt := s.liveCount;
    mut sp: List<Int> = s.sparse;
    mut dn: List<Int> = s.dense;
    mut sp.setAt(value, cnt);
    mut dn.setAt(cnt, value);
    s.sparse = sp;
    s.dense = dn;
    s.liveCount = cnt + 1;
    true
};

/** Removes `value` from `s` in O(1) via swap-with-last; returns `true` if it was present. */
pub SparseSet.remove := fn(s: mut Self, value: Int): Bool {
    if not s.has(value) { return false; }
    denseIdx := s.sparse[value];
    lastIdx := s.liveCount - 1;
    lastVal := s.dense[lastIdx];
    mut sp: List<Int> = s.sparse;
    mut dn: List<Int> = s.dense;
    mut dn.setAt(denseIdx, lastVal);
    mut sp.setAt(lastVal, denseIdx);
    s.sparse = sp;
    s.dense = dn;
    s.liveCount = lastIdx;
    true
};

/** Returns the dense index (`0..count-1`) of `value`, or `-1` if absent. */
pub SparseSet.indexOf := fn(s: Self, value: Int): Int {
    if not s.has(value) { return -1; }
    s.sparse[value]
};

/** Returns the member ID at dense position `index` (`0..count-1`), or `-1` if out of bounds. */
pub SparseSet.denseAt := fn(s: Self, index: Int): Int {
    if index < 0 or index >= s.liveCount { return -1; }
    s.dense[index]
};

/** Returns the number of live members in `s`. */
pub SparseSet.count := fn(s: Self): Int {
    s.liveCount
};

/** Returns the maximum ID universe capacity of `s`. */
pub SparseSet.capacity := fn(s: Self): Int {
    s.cap
};

/** Returns the dense index (`0..count-1`) of `value`, or `.None` if absent. */
pub SparseSet.findIndex := fn(s: Self, value: Int): Option<Int> {
    if not s.has(value) { return .None; }
    .Some(s.sparse[value])
};

/** Returns the member ID at dense position `index` (`0..count-1`), or `.None` if out of bounds. */
pub SparseSet.at := fn(s: Self, index: Int): Option<Int> {
    if index < 0 or index >= s.liveCount { return .None; }
    .Some(s.dense[index])
};

/** Inserts all IDs in `values` into `s`, returning the number of newly inserted IDs. */
pub SparseSet.insertAll := fn(s: mut Self, values: Slice<Int>): Int {
    var added := 0;
    loop values as v {
        if mut s.insert(v) { added += 1; }
    }
    added
};

/** True when any ID in `values` is currently present in `s`. */
pub SparseSet.hasAny := fn(s: Self, values: Slice<Int>): Bool {
    loop values as v {
        if s.has(v) { return true; }
    }
    false
};

/** Clears `s` in O(1) without rewriting the sparse array. */
pub SparseSet.clear := fn(s: mut Self): Unit {
    s.liveCount = 0;
};
