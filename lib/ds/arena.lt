/** Scratch and frame bump allocators (`ds/arena`) for O(1) bulk reclamation across TS and C11. */

/** Byte slice allocation returned by `Arena.alloc` or `Arena.allocAligned`. */
pub Slice := record {
    offset: Int;
    length: Int;
    ok: Bool;
}

/** Saved watermark returned by `mark` and passed to `rewind`. */
pub Mark := record {
    offset: Int;
    gen: Int;
}

/** Contiguous span allocation inside a `TypedArena<T>`. */
pub Span := record {
    offset: Int;
    length: Int;
    ok: Bool;
}

/** Allocation statistics snapshot for a byte-addressed `Arena`. */
pub ArenaStats := record {
    usedBytes: Int;
    capacityBytes: Int;
    remainingBytes: Int;
    peakBytes: Int;
    resetCount: Int;
}

/** Self-contained byte-addressed bump allocator with alignment, watermarks, and bulk reset. */
pub Arena := record {
    data: List<Int>;
    cap: Int;
    offset: Int;
    peak: Int;
    resets: Int;
    gen: Int;
    alive: Bool;
}

/** Generic typed scratch bump allocator storing `T` values with O(1) mark/rewind and bulk reset. */
pub TypedArena := record<T: Type> {
    data: List<T>;
    cap: Int;
    offset: Int;
    peak: Int;
    resets: Int;
    gen: Int;
    alive: Bool;
}

/** Typed integer scratch arena alias. */
pub IntArena := alias TypedArena<Int>;

/** Typed float scratch arena alias. */
pub FloatArena := alias TypedArena<Float>;

isPowerOfTwo := fn(n: Int): Bool {
    if n <= 0 { return false; }
    var x := n;
    loop x > 1 {
        if (x % 2) =!= 0 { return false; }
        x = x / 2;
    }
    true
};

alignOffset := fn(offset: Int, align: Int): Int {
    if align <= 1 { return offset; }
    rem := offset % align;
    if rem == 0 { offset } else { offset + (align - rem) }
};

normByte := fn(value: Int): Int {
    b := value % 256;
    if b < 0 { b + 256 } else { b }
};

/* ============================================================================
 * Byte-addressed Arena
 * ============================================================================ */

/** Creates a fixed-capacity byte-addressed bump arena backed by a zero-initialized slab. */
pub create := fn(capacityBytes: Int): Arena {
    cap := if capacityBytes < 0 { 0 } else { capacityBytes };
    buf: mut List<Int> = [];
    loop 0..cap {
        mut buf.pushBack(0);
    }
    Arena { data = buf, cap = cap, offset = 0, peak = 0, resets = 0, gen = 1, alive = true }
};

/** True when `a` is active and has not been destroyed. */
pub Arena.isValid := fn(a: Self): Bool {
    a.alive
};

/** Allocates `size` bytes aligned to `align` (must be a power of two, >= 1). */
pub Arena.allocAligned := fn(a: mut Self, size: Int, align: Int): Slice {
    if not a.alive or size < 0 or not isPowerOfTwo(align) {
        return Slice {};
    }
    start := alignOffset(a.offset, align);
    end := start + size;
    if end > a.cap {
        return Slice {};
    }
    a.offset = end;
    if end > a.peak {
        a.peak = end;
    }
    Slice { offset = start, length = size, ok = true }
};

/** Allocates `size` contiguous bytes from `a` in O(1). */
pub Arena.alloc := fn(a: mut Self, size: Int): Slice {
    mut a.allocAligned(size, 1)
};

/** Writes a single unsigned byte (low 8 bits of `value`) at `offset` within `a`. */
pub Arena.writeByte := fn(a: mut Self, offset: Int, value: Int): Bool {
    if not a.alive or offset < 0 or offset >= a.offset { return false; }
    buf: mut List<Int> = a.data;
    mut buf.setAt(offset, normByte(value));
    a.data = buf;
    true
};

/** Reads a single unsigned byte (`0..255`) at `offset` within `a`, or `-1` if out of bounds. */
pub Arena.readByte := fn(a: Self, offset: Int): Int {
    if not a.alive or offset < 0 or offset >= a.offset { return -1; }
    a.data[offset]
};

/** Writes a little-endian 32-bit integer at `offset..offset+4` within `a`. */
pub Arena.writeInt32 := fn(a: mut Self, offset: Int, value: Int): Bool {
    if not a.alive or offset < 0 or offset + 4 > a.offset { return false; }
    v := if value < 0 { value + 4294967296 } else { value };
    buf: mut List<Int> = a.data;
    mut buf.setAt(offset, normByte(v));
    mut buf.setAt(offset + 1, normByte(v / 256));
    mut buf.setAt(offset + 2, normByte(v / 65536));
    mut buf.setAt(offset + 3, normByte(v / 16777216));
    a.data = buf;
    true
};

/** Reads a little-endian signed 32-bit integer from `offset..offset+4`, or `0` if out of bounds. */
pub Arena.readInt32 := fn(a: Self, offset: Int): Int {
    if not a.alive or offset < 0 or offset + 4 > a.offset { return 0; }
    u := a.data[offset] + (a.data[offset + 1] * 256) + (a.data[offset + 2] * 65536) + (a.data[offset + 3] * 16777216);
    if u >= 2147483648 { u - 4294967296 } else { u }
};

/** Saves the current bump offset of `a` so later allocations can be rewound in O(1). */
pub Arena.mark := fn(a: Self): Mark {
    if not a.alive { return Mark {}; }
    Mark { offset = a.offset, gen = a.gen }
};

/** Rewinds `a` back to a previously saved `Mark` in O(1). */
pub Arena.rewind := fn(a: mut Self, m: Mark): Bool {
    if not a.alive or m.gen =!= a.gen or m.offset < 0 or m.offset > a.offset { return false; }
    a.offset = m.offset;
    true
};

/** Resets `a` to offset `0` in O(1) without releasing its backing slab. */
pub Arena.reset := fn(a: mut Self): Unit {
    if not a.alive { return; }
    a.offset = 0;
    a.resets = a.resets + 1;
};

/** Returns the number of currently allocated bytes in `a`. */
pub Arena.usedBytes := fn(a: Self): Int {
    if not a.alive { return 0; }
    a.offset
};

/** Returns the total byte capacity of `a`. */
pub Arena.capacityBytes := fn(a: Self): Int {
    if not a.alive { return 0; }
    a.cap
};

/** Returns the remaining free bytes in `a`. */
pub Arena.remainingBytes := fn(a: Self): Int {
    if not a.alive { return 0; }
    a.cap - a.offset
};

/** Returns the high-water mark of bytes allocated in `a`. */
pub Arena.peakBytes := fn(a: Self): Int {
    if not a.alive { return 0; }
    a.peak
};

/** Returns how many times `reset` was called on `a`. */
pub Arena.resetCount := fn(a: Self): Int {
    if not a.alive { return 0; }
    a.resets
};

/** Returns an `ArenaStats` snapshot for `a`. */
pub Arena.stats := fn(a: Self): ArenaStats {
    if not a.alive {
        return ArenaStats {};
    }
    ArenaStats {
    usedBytes = a.offset,
    capacityBytes = a.cap,
    remainingBytes = a.cap - a.offset,
    peakBytes = a.peak,
    resetCount = a.resets
    }
};

/** Invalidates `a` and releases its backing storage. */
pub Arena.destroy := fn(a: mut Self): Unit {
    if not a.alive { return; }
    a.alive = false;
    a.gen = a.gen + 1;
    a.offset = 0;
    empty: List<Int> = [];
    a.data = empty;
};

/* ============================================================================
 * Generic TypedArena<T>
 * ============================================================================ */

/** Creates a typed scratch bump arena holding up to `capacity` `T` elements. */
pub createTyped := fn<T: Type>(capacity: Int): TypedArena<T> {
    cap := if capacity < 0 { 0 } else { capacity };
    buf: mut List<T> = [];
    z: T;
    loop 0..cap {
        mut buf.pushBack(z);
    }
    TypedArena<T> { data = buf, cap = cap, offset = 0, peak = 0, resets = 0, gen = 1, alive = true }
};

/** True when typed arena `a` is active and has not been destroyed. */
pub TypedArena.isValid := fn<T: Type>(a: Self<T>): Bool {
    a.alive
};

/** Pushes one `T` value into `a` in O(1), returning its index or `-1` if full/invalid. */
pub TypedArena.alloc := fn<T: Type>(a: mut Self<T>, value: T): Int {
    if not a.alive or a.offset >= a.cap { return -1; }
    idx := a.offset;
    buf: mut List<T> = a.data;
    mut buf.setAt(idx, value);
    a.data = buf;
    a.offset = idx + 1;
    if a.offset > a.peak { a.peak = a.offset; }
    idx
};

/** Allocates `count` contiguous `T` slots initialized to `fill` in O(count). */
pub TypedArena.allocSpan := fn<T: Type>(a: mut Self<T>, count: Int, fill: T): Span {
    if not a.alive or count < 0 or a.offset + count > a.cap {
        return Span {};
    }
    start := a.offset;
    buf: mut List<T> = a.data;
    loop 0..count as i {
        mut buf.setAt(start + i, fill);
    }
    a.data = buf;
    a.offset = start + count;
    if a.offset > a.peak { a.peak = a.offset; }
    Span { offset = start, length = count, ok = true }
};

/** Reads element `offset` from `a`, or `zero(T)` if invalid/out of bounds. */
pub TypedArena.get := fn<T: Type>(a: Self<T>, offset: Int): T {
    if not a.alive or offset < 0 or offset >= a.offset {
        z: T;
        return z;
    }
    a.data[offset]
};

/** Overwrites element `offset` in `a`; returns `false` if invalid/out of bounds. */
pub TypedArena.set := fn<T: Type>(a: mut Self<T>, offset: Int, value: T): Bool {
    if not a.alive or offset < 0 or offset >= a.offset { return false; }
    buf: mut List<T> = a.data;
    mut buf.setAt(offset, value);
    a.data = buf;
    true
};

/** Saves a watermark `Mark` for `a`. */
pub TypedArena.mark := fn<T: Type>(a: Self<T>): Mark {
    if not a.alive { return Mark {}; }
    Mark { offset = a.offset, gen = a.gen }
};

/** Rewinds `a` to a saved watermark `m`. */
pub TypedArena.rewind := fn<T: Type>(a: mut Self<T>, m: Mark): Bool {
    if not a.alive or m.gen =!= a.gen or m.offset < 0 or m.offset > a.offset { return false; }
    a.offset = m.offset;
    true
};

/** Resets `a` to `0` used slots in O(1). */
pub TypedArena.reset := fn<T: Type>(a: mut Self<T>): Unit {
    if not a.alive { return; }
    a.offset = 0;
    a.resets = a.resets + 1;
};

/** Returns the number of currently allocated slots in `a`. */
pub TypedArena.used := fn<T: Type>(a: Self<T>): Int {
    if not a.alive { return 0; }
    a.offset
};

/** Returns the total element capacity of `a`. */
pub TypedArena.capacity := fn<T: Type>(a: Self<T>): Int {
    if not a.alive { return 0; }
    a.cap
};

/** Returns the high-water mark of slots allocated in `a`. */
pub TypedArena.peakUsed := fn<T: Type>(a: Self<T>): Int {
    if not a.alive { return 0; }
    a.peak
};

/** Invalidates `a` and releases its backing storage. */
pub TypedArena.destroy := fn<T: Type>(a: mut Self<T>): Unit {
    if not a.alive { return; }
    a.alive = false;
    a.gen = a.gen + 1;
    a.offset = 0;
    empty: List<T> = [];
    a.data = empty;
};
