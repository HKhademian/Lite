/** Compact bit-arrays (`ds/bitset`) packed 30 bits per word for masks, visited flags, and collision layers. */

WORD_BITS := 30;
FULL_WORD := 1073741823; /* (2^30) - 1 */

/** Fixed-length bit-array packing 30 bits per `Int` word. */
pub Bitset := record {
    words: List<Int>;
    bitLen: Int;
}

pow2 := fn(exp: Int): Int {
    var acc := 1;
    loop 0..exp {
        acc = acc * 2;
    }
    acc
};

wordHasBit := fn(word: Int, bit: Int): Bool {
    ((word / pow2(bit)) % 2) == 1
};

wordSetBit := fn(word: Int, bit: Int): Int {
    if wordHasBit(word, bit) { word } else { word + pow2(bit) }
};

wordClearBit := fn(word: Int, bit: Int): Int {
    if wordHasBit(word, bit) { word - pow2(bit) } else { word }
};

wordPopcount := fn(word: Int): Int {
    var x := word;
    var c := 0;
    loop x > 0 {
        if (x % 2) == 1 { c += 1; }
        x = x / 2;
    }
    c
};

wordOr := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 or xb > 0 {
        if ((xa % 2) == 1) or ((xb % 2) == 1) { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

wordAnd := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 and xb > 0 {
        if ((xa % 2) == 1) and ((xb % 2) == 1) { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

wordXor := fn(a: Int, b: Int): Int {
    var xa := a;
    var xb := b;
    var out := 0;
    var p := 1;
    loop xa > 0 or xb > 0 {
        if ((xa % 2) + (xb % 2)) == 1 { out += p; }
        xa = xa / 2;
        xb = xb / 2;
        p = p * 2;
    }
    out
};

wordsForBits := fn(numBits: Int): Int {
    if numBits <= 0 { 0 } else { (numBits + WORD_BITS - 1) / WORD_BITS }
};

/** Creates a zero-initialized `Bitset` holding `numBits` bits. */
pub Bitset.create := fn(numBits: Int): Self {
    bits := if numBits < 0 { 0 } else { numBits };
    needed := wordsForBits(bits);
    mut ws: List<Int> = [];
    loop 0..needed {
        mut ws.pushBack(0);
    }
    Self { words = ws, bitLen = bits }
};

/** Sets bit `index` to `1`; returns `false` if out of bounds. */
pub Bitset.set := fn(bs: mut Self, index: Int): Bool {
    if index < 0 or index >= bs.bitLen { return false; }
    wIdx := index / WORD_BITS;
    mut ws: List<Int> = bs.words;
    mut ws.setAt(wIdx, wordSetBit(ws[wIdx], index % WORD_BITS));
    bs.words = ws;
    true
};

/** Clears bit `index` to `0`; returns `false` if out of bounds. */
pub Bitset.clear := fn(bs: mut Self, index: Int): Bool {
    if index < 0 or index >= bs.bitLen { return false; }
    wIdx := index / WORD_BITS;
    mut ws: List<Int> = bs.words;
    mut ws.setAt(wIdx, wordClearBit(ws[wIdx], index % WORD_BITS));
    bs.words = ws;
    true
};

/** Flips bit `index`; returns `false` if out of bounds. */
pub Bitset.toggle := fn(bs: mut Self, index: Int): Bool {
    if index < 0 or index >= bs.bitLen { return false; }
    wIdx := index / WORD_BITS;
    b := index % WORD_BITS;
    mut ws: List<Int> = bs.words;
    w := ws[wIdx];
    mut ws.setAt(wIdx, if wordHasBit(w, b) { wordClearBit(w, b) } else { wordSetBit(w, b) });
    bs.words = ws;
    true
};

/** True when bit `index` is `1`. */
pub Bitset.test := fn(bs: Self, index: Int): Bool {
    if index < 0 or index >= bs.bitLen { return false; }
    wordHasBit(bs.words[index / WORD_BITS], index % WORD_BITS)
};

/** Returns the number of bits set to `1` (population count). */
pub Bitset.countOnes := fn(bs: Self): Int {
    wCount := bs.words.length();
    var total := 0;
    loop 0..wCount as i {
        total += wordPopcount(bs.words[i]);
    }
    total
};

/** Returns the lowest index with bit `1`, or `-1` if all bits are `0`. */
pub Bitset.firstSet := fn(bs: Self): Int {
    wCount := bs.words.length();
    loop 0..wCount as wi {
        w := bs.words[wi];
        if w > 0 {
            loop 0..WORD_BITS as bi {
                idx := (wi * WORD_BITS) + bi;
                if idx >= bs.bitLen { return -1; }
                if wordHasBit(w, bi) { return idx; }
            }
        }
    }
    -1
};

/** Returns the lowest index with bit `0`, or `-1` if all bits are `1`. */
pub Bitset.firstClear := fn(bs: Self): Int {
    wCount := bs.words.length();
    loop 0..wCount as wi {
        w := bs.words[wi];
        if w < FULL_WORD {
            loop 0..WORD_BITS as bi {
                idx := (wi * WORD_BITS) + bi;
                if idx >= bs.bitLen { return -1; }
                if not wordHasBit(w, bi) { return idx; }
            }
        }
    }
    -1
};

/** Sets every valid bit in `bs` to `1`. */
pub Bitset.setAll := fn(bs: mut Self): Unit {
    wCount := bs.words.length();
    mut ws: List<Int> = bs.words;
    loop 0..wCount as wi {
        rem := bs.bitLen - (wi * WORD_BITS);
        val := if rem >= WORD_BITS { FULL_WORD } else { pow2(rem) - 1 };
        mut ws.setAt(wi, val);
    }
    bs.words = ws;
};

/** Clears every bit in `bs` to `0`. */
pub Bitset.clearAll := fn(bs: mut Self): Unit {
    wCount := bs.words.length();
    mut ws: List<Int> = bs.words;
    loop 0..wCount as wi {
        mut ws.setAt(wi, 0);
    }
    bs.words = ws;
};

/** Computes `dst |= src` across the overlapping bit length. */
pub Bitset.orInto := fn(dst: mut Self, src: Self): Unit {
    overlapBits := if dst.bitLen < src.bitLen { dst.bitLen } else { src.bitLen };
    wCount := wordsForBits(overlapBits);
    mut ws: List<Int> = dst.words;
    loop 0..wCount as i {
        val := wordOr(ws[i], src.words[i]);
        rem := dst.bitLen - (i * WORD_BITS);
        masked := if rem >= WORD_BITS { val } else { wordAnd(val, pow2(rem) - 1) };
        mut ws.setAt(i, masked);
    }
    dst.words = ws;
};

/** Computes `dst &= src` across the overlapping bit length (clears bits past `src`). */
pub Bitset.andInto := fn(dst: mut Self, src: Self): Unit {
    dWords := dst.words.length();
    sWords := src.words.length();
    mut ws: List<Int> = dst.words;
    loop 0..dWords as i {
        val := if i < sWords { wordAnd(ws[i], src.words[i]) } else { 0 };
        mut ws.setAt(i, val);
    }
    dst.words = ws;
};

/** Computes `dst ^= src` across the overlapping bit length. */
pub Bitset.xorInto := fn(dst: mut Self, src: Self): Unit {
    overlapBits := if dst.bitLen < src.bitLen { dst.bitLen } else { src.bitLen };
    wCount := wordsForBits(overlapBits);
    mut ws: List<Int> = dst.words;
    loop 0..wCount as i {
        val := wordXor(ws[i], src.words[i]);
        rem := dst.bitLen - (i * WORD_BITS);
        masked := if rem >= WORD_BITS { val } else { wordAnd(val, pow2(rem) - 1) };
        mut ws.setAt(i, masked);
    }
    dst.words = ws;
};

/** True when `a` and `b` have the same bit length and identical bit patterns. */
pub Bitset.equals := fn(a: Self, b: Self): Bool {
    if a.bitLen =!= b.bitLen { return false; }
    wCount := a.words.length();
    loop 0..wCount as i {
        if a.words[i] =!= b.words[i] { return false; }
    }
    true
};

/** Returns the total number of bits addressable in `bs`. */
pub Bitset.length := fn(bs: Self): Int {
    bs.bitLen
};
