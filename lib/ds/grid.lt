/** Generic flat-backed 2D grids (`ds/grid`) for tilemaps, cellular automata, and board games. */

math := import "math/scalar";

/** Comparable scalar set supported by `Grid.countValue`. */
pub GridComparable := alias math.Numeric | String | Bool;

/** Outcome of reading a cell from a generic `Grid<T>`. */
pub GridCell := enum<T: Type> {
    OutOfBounds;
    Value(T);
}

/** True when `cell` holds a valid `.Value(...)`. */
pub GridCell.isValue := fn<T: Type>(cell: Self<T>): Bool {
    match cell {
        .OutOfBounds { false }
        .Value { true }
    }
};

/** Returns the cell value when `.Value(v)`, or `fallback` when `.OutOfBounds`. */
pub GridCell.unwrapOr := fn<T: Type>(cell: Self<T>, fallback: T): T {
    match cell {
        .OutOfBounds { fallback }
        .Value(v) { v }
    }
};

/** Generic flat-backed 2D row-major grid storing `T` values. */
pub Grid := record<T: Type> {
    width: Int;
    height: Int;
    data: List<T>;
}

/** 2D integer grid alias. */
pub IntGrid := alias Grid<Int>;

/** 2D floating-point grid alias. */
pub FloatGrid := alias Grid<Float>;

/** Creates a generic `width x height` grid filled with `fill`. */
pub createGrid := fn<T: Type>(width: Int, height: Int, fill: T): Grid<T> {
    w := if width < 1 { 1 } else { width };
    h := if height < 1 { 1 } else { height };
    total := w * h;
    buf: mut List<T> = [];
    loop 0..total {
        mut buf.pushBack(fill);
    }
    Grid<T> { width = w, height = h, data = buf }
};

/** True when `(x, y)` lies inside `g`. */
pub Grid.inBounds := fn<T: Type>(g: Self<T>, x: Int, y: Int): Bool {
    x >= 0 and x < g.width and y >= 0 and y < g.height
};

/** Reads cell `(x, y)` or `.OutOfBounds`. */
pub Grid.get := fn<T: Type>(g: Self<T>, x: Int, y: Int): GridCell<T> {
    if not g.inBounds(x, y) { .OutOfBounds } else { .Value(g.data[(y * g.width) + x]) }
};

/** Reads cell `(x, y)`, returning `fallback` when out of bounds. */
pub Grid.getOr := fn<T: Type>(g: Self<T>, x: Int, y: Int, fallback: T): T {
    if not g.inBounds(x, y) { fallback } else { g.data[(y * g.width) + x] }
};

/** Writes `value` to cell `(x, y)`; returns `false` when out of bounds. */
pub Grid.set := fn<T: Type>(g: mut Self<T>, x: Int, y: Int, value: T): Bool {
    if not g.inBounds(x, y) { return false; }
    buf: mut List<T> = g.data;
    mut buf.setAt((y * g.width) + x, value);
    g.data = buf;
    true
};

/** Fills axis-aligned sub-rectangle `[x, x + w) x [y, y + h)` clamped to `g`. */
pub Grid.fillRect := fn<T: Type>(g: mut Self<T>, x: Int, y: Int, w: Int, h: Int, value: T): Unit {
    if w <= 0 or h <= 0 { return; }
    x0 := if x < 0 { 0 } else { x };
    y0 := if y < 0 { 0 } else { y };
    x1 := if x + w > g.width { g.width } else { x + w };
    y1 := if y + h > g.height { g.height } else { y + h };
    if x0 >= x1 or y0 >= y1 { return; }
    buf: mut List<T> = g.data;
    loop y0..y1 as cy {
        rowOff := cy * g.width;
        loop x0..x1 as cx {
            mut buf.setAt(rowOff + cx, value);
        }
    }
    g.data = buf;
};

/** Resets every cell in `g` to `fill`. */
pub Grid.clear := fn<T: Type>(g: mut Self<T>, fill: T): Unit {
    buf: mut List<T> = g.data;
    total := g.width * g.height;
    loop 0..total as i {
        mut buf.setAt(i, fill);
    }
    g.data = buf;
};

/** Copies overlapping cells from `src` into `dst` (matching top-left coordinates). */
pub Grid.copyFrom := fn<T: Type>(dst: mut Self<T>, src: Self<T>): Unit {
    cw := if dst.width < src.width { dst.width } else { src.width };
    ch := if dst.height < src.height { dst.height } else { src.height };
    if cw <= 0 or ch <= 0 { return; }
    buf: mut List<T> = dst.data;
    loop 0..ch as cy {
        dstRow := cy * dst.width;
        srcRow := cy * src.width;
        loop 0..cw as cx {
            mut buf.setAt(dstRow + cx, src.data[srcRow + cx]);
        }
    }
    dst.data = buf;
};

/** Counts how many cells in `g` equal `target`. */
pub Grid.countValue := fn<T: Type<GridComparable>>(g: Self<T>, target: T): Int {
    var total := 0;
    loop g.data as v {
        if v == target { total += 1; }
    }
    total
};
