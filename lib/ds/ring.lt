/** Fixed-capacity generic circular ring buffers (`ds/ring`) for rolling windows, telemetry, and audio rings. */

math := import "math/scalar";

/** Generic fixed-capacity circular ring buffer storing `T` values. */
pub Ring := record<T: Type> {
    data: List<T>;
    cap: Int;
    head: Int;
    count: Int;
}

/** Circular `Int` ring buffer alias. */
pub IntRing := alias Ring<Int>;

/** Circular `Float` ring buffer alias. */
pub FloatRing := alias Ring<Float>;

/** Creates an empty generic `Ring<T>` with fixed capacity `>= 1`. */
pub Ring.create := fn<T: Type>(capacity: Int): Self<T> {
    cap := if capacity < 1 { 1 } else { capacity };
    mut buf: List<T> = [];
    z: T;
    loop 0..cap {
        mut buf.pushBack(z);
    }
    Self<T> { data = buf, cap = cap, head = 0, count = 0 }
};

/** Number of stored elements currently in `r`. */
pub Ring.length := fn<T: Type>(r: Self<T>): Int {
    r.count
};

/** Fixed slot capacity of `r`. */
pub Ring.capacity := fn<T: Type>(r: Self<T>): Int {
    r.cap
};

/** True when `r` contains zero elements. */
pub Ring.isEmpty := fn<T: Type>(r: Self<T>): Bool {
    r.count == 0
};

/** True when `r` has reached capacity. */
pub Ring.isFull := fn<T: Type>(r: Self<T>): Bool {
    r.count >= r.cap
};

/** Appends `value` in O(1), overwriting the oldest element if full; returns `true` when an overwrite occurred. */
pub Ring.push := fn<T: Type>(r: mut Self<T>, value: T): Bool {
    tail := (r.head + r.count) % r.cap;
    mut buf: List<T> = r.data;
    mut buf.setAt(tail, value);
    r.data = buf;
    if r.count >= r.cap {
        r.head = (r.head + 1) % r.cap;
        true
    } else {
        r.count = r.count + 1;
        false
    }
};

/** Appends `value` only if space remains; returns `true` on success or `false` when full. */
pub Ring.tryPush := fn<T: Type>(r: mut Self<T>, value: T): Bool {
    if r.count >= r.cap { return false; }
    tail := (r.head + r.count) % r.cap;
    mut buf: List<T> = r.data;
    mut buf.setAt(tail, value);
    r.data = buf;
    r.count = r.count + 1;
    true
};

/** Removes and returns the oldest element, or `.None` if empty. */
pub Ring.pop := fn<T: Type>(r: mut Self<T>): Option<T> {
    if r.count <= 0 { return .None; }
    val := r.data[r.head];
    z: T;
    mut buf: List<T> = r.data;
    mut buf.setAt(r.head, z);
    r.data = buf;
    r.head = (r.head + 1) % r.cap;
    r.count = r.count - 1;
    .Some(val)
};

/** Returns the oldest element without removing it. */
pub Ring.peekFront := fn<T: Type>(r: Self<T>): Option<T> {
    if r.count <= 0 { .None } else { .Some(r.data[r.head]) }
};

/** Returns the most recently pushed element without removing it. */
pub Ring.peekBack := fn<T: Type>(r: Self<T>): Option<T> {
    if r.count <= 0 { .None } else { .Some(r.data[(r.head + r.count - 1) % r.cap]) }
};

/** Returns the `index`-th element (`0` = oldest) without removing it. */
pub Ring.get := fn<T: Type>(r: Self<T>, index: Int): Option<T> {
    if index < 0 or index >= r.count { .None } else { .Some(r.data[(r.head + index) % r.cap]) }
};

/** Resets `r` to empty and clears stored elements to their zero value. */
pub Ring.clear := fn<T: Type>(r: mut Self<T>): Unit {
    mut buf: List<T> = r.data;
    z: T;
    loop 0..r.cap as i {
        mut buf.setAt(i, z);
    }
    r.data = buf;
    r.head = 0;
    r.count = 0;
};

/** Sums all currently buffered numeric elements in `r`. */
pub Ring.sum := fn<T: Type<math.Numeric>>(r: Self<T>): T {
    var total: T;
    loop 0..r.count as i {
        total = total + r.data[(r.head + i) % r.cap];
    }
    total
};

/** Computes the arithmetic mean of a `Float` ring buffer (`0.0` when empty). */
pub Ring.avg := fn(r: Self<Float>): Float {
    if r.count <= 0 { return 0.0; }
    r.sum() / (r.count * 1.0)
};

/** Returns `(found, min, max)` over all elements currently in a `Float` ring buffer. */
pub Ring.minMax := fn(r: Self<Float>): (found: Bool, min: Float, max: Float) {
    if r.count <= 0 { return (found = false, min = 0.0, max = 0.0); }
    first := r.data[r.head];
    var lo := first;
    var hi := first;
    loop 1..r.count as i {
        v := r.data[(r.head + i) % r.cap];
        if v < lo { lo = v; }
        if v > hi { hi = v; }
    }
    (found = true, min = lo, max = hi)
};
