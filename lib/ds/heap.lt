/** Binary heaps and generic keyed priority queues (`ds/heap`) for timers, schedulers, and pathfinding. */

/** Outcome of popping or peeking a `MinHeap` or `MaxHeap`. */
pub HeapItem := enum<T: Type> {
    Empty;
    Some(T);
}

/** True when `item` holds a value `.Some(...)`. */
pub HeapItem.isSome := fn<T: Type>(item: Self<T>): Bool {
    match item {
        .Empty { false }
        .Some { true }
    }
};

/** Returns the wrapped value when `.Some(v)`, or `fallback` when `.Empty`. */
pub HeapItem.unwrapOr := fn<T: Type>(item: Self<T>, fallback: T): T {
    match item {
        .Empty { fallback }
        .Some(v) { v }
    }
};

/** Entry stored in a keyed `PriorityQueue<T>`. */
pub PQEntry := record<T: Type> {
    priority: Int;
    item: T;
}

/** Outcome of popping or peeking a keyed `PriorityQueue<T>`. */
pub PQItem := enum<T: Type> {
    Empty;
    Some(PQEntry<T>);
}

/** True when `entry` holds `.Some(...)`. */
pub PQItem.isSome := fn<T: Type>(entry: Self<T>): Bool {
    match entry {
        .Empty { false }
        .Some { true }
    }
};

/** Fixed-capacity binary min-heap of `Int` values. */
pub MinHeap := record {
    data: List<Int>;
    cap: Int;
}

/** Fixed-capacity binary max-heap of `Int` values. */
pub MaxHeap := record {
    data: List<Int>;
    cap: Int;
}

/** Fixed-capacity min-priority queue storing `(priority, item)` pairs with lowest priority popped first. */
pub PriorityQueue := record<T: Type> {
    prios: List<Int>;
    items: List<T>;
    cap: Int;
}

/** Priority queue storing `Int` item payloads. */
pub IntPriorityQueue := alias PriorityQueue<Int>;

heapBetter := fn(a: Int, b: Int, isMax: Bool): Bool {
    if isMax { a > b } else { a < b }
};

pushIntHeap := fn(buf: mut List<Int>, cap: Int, value: Int, isMax: Bool): Bool {
    cnt := buf.length();
    if cnt >= cap { return false; }
    mut buf.pushBack(value);
    var idx := cnt;
    loop idx > 0 {
        parent := (idx - 1) / 2;
        pv := buf[parent];
        cv := buf[idx];
        if heapBetter(cv, pv, isMax) {
            mut buf.setAt(parent, cv);
            mut buf.setAt(idx, pv);
            idx = parent;
        } else {
            break;
        }
    }
    true
};

popIntHeap := fn(buf: mut List<Int>, isMax: Bool): HeapItem<Int> {
    cnt := buf.length();
    if cnt <= 0 { return .Empty; }
    top := buf[0];
    last := mut buf.popBack();
    nextCnt := buf.length();
    if nextCnt > 0 {
        mut buf.setAt(0, last);
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and heapBetter(buf[left], buf[best], isMax) {
                best = left;
            }
            if right < nextCnt and heapBetter(buf[right], buf[best], isMax) {
                best = right;
            }
            if best == idx { break; }
            tmp := buf[idx];
            mut buf.setAt(idx, buf[best]);
            mut buf.setAt(best, tmp);
            idx = best;
        }
    }
    .Some(top)
};

/* ============================================================================
 * MinHeap & MaxHeap
 * ============================================================================ */

/** Creates a fixed-capacity binary min-heap of `Int` values. */
pub MinHeap.create := fn(capacity: Int): Self {
    cap := if capacity < 1 { 1 } else { capacity };
    Self { cap = cap }
};

/** Creates a fixed-capacity binary max-heap of `Int` values. */
pub MaxHeap.create := fn(capacity: Int): Self {
    cap := if capacity < 1 { 1 } else { capacity };
    Self { cap = cap }
};

/** Inserts `value` into min-heap `h` in O(log n); returns `false` if full. */
pub MinHeap.push := fn(h: mut Self, value: Int): Bool {
    buf: mut List<Int> = h.data;
    ok := pushIntHeap(mut buf, h.cap, value, false);
    if ok { h.data = buf; }
    ok
};

/** Removes and returns the minimum value in O(log n). */
pub MinHeap.pop := fn(h: mut Self): HeapItem<Int> {
    buf: mut List<Int> = h.data;
    res := popIntHeap(mut buf, false);
    h.data = buf;
    res
};

/** Returns the minimum value without removing it in O(1). */
pub MinHeap.peek := fn(h: Self): HeapItem<Int> {
    if h.data.length() == 0 { .Empty } else { .Some(h.data[0]) }
};

/** Returns the number of elements currently in `h`. */
pub MinHeap.count := fn(h: Self): Int { h.data.length() };

/** Returns the maximum capacity of `h`. */
pub MinHeap.capacity := fn(h: Self): Int { h.cap };

/** True when `h` contains zero elements. */
pub MinHeap.isEmpty := fn(h: Self): Bool { h.data.length() == 0 };

/** True when `h` has reached capacity. */
pub MinHeap.isFull := fn(h: Self): Bool { h.data.length() >= h.cap };

/** Clears `h` in O(1). */
pub MinHeap.clear := fn(h: mut Self): Unit {
    empty: List<Int> = [];
    h.data = empty;
};

/** Inserts `value` into max-heap `h` in O(log n); returns `false` if full. */
pub MaxHeap.push := fn(h: mut Self, value: Int): Bool {
    buf: mut List<Int> = h.data;
    ok := pushIntHeap(mut buf, h.cap, value, true);
    if ok { h.data = buf; }
    ok
};

/** Removes and returns the maximum value in O(log n). */
pub MaxHeap.pop := fn(h: mut Self): HeapItem<Int> {
    buf: mut List<Int> = h.data;
    res := popIntHeap(mut buf, true);
    h.data = buf;
    res
};

/** Returns the maximum value without removing it in O(1). */
pub MaxHeap.peek := fn(h: Self): HeapItem<Int> {
    if h.data.length() == 0 { .Empty } else { .Some(h.data[0]) }
};

/** Returns the number of elements currently in `h`. */
pub MaxHeap.count := fn(h: Self): Int { h.data.length() };

/** Returns the maximum capacity of `h`. */
pub MaxHeap.capacity := fn(h: Self): Int { h.cap };

/** True when `h` contains zero elements. */
pub MaxHeap.isEmpty := fn(h: Self): Bool { h.data.length() == 0 };

/** True when `h` has reached capacity. */
pub MaxHeap.isFull := fn(h: Self): Bool { h.data.length() >= h.cap };

/** Clears `h` in O(1). */
pub MaxHeap.clear := fn(h: mut Self): Unit {
    empty: List<Int> = [];
    h.data = empty;
};

/* ============================================================================
 * Generic Keyed PriorityQueue<T>
 * ============================================================================ */

/** Creates a fixed-capacity generic min-priority queue storing `(priority, item)` pairs. */
pub PriorityQueue.create := fn<T: Type>(capacity: Int): Self<T> {
    cap := if capacity < 1 { 1 } else { capacity };
    Self<T> { cap = cap }
};

/** Enqueues `(priority, item)` into `pq` in O(log n); returns `false` if full. */
pub PriorityQueue.push := fn<T: Type>(pq: mut Self<T>, priority: Int, item: T): Bool {
    cnt := pq.prios.length();
    if cnt >= pq.cap { return false; }
    ps: mut List<Int> = pq.prios;
    vs: mut List<T> = pq.items;
    mut ps.pushBack(priority);
    mut vs.pushBack(item);
    var idx := cnt;
    loop idx > 0 {
        parent := (idx - 1) / 2;
        if ps[idx] < ps[parent] {
            tp := ps[parent];
            ti := vs[parent];
            mut ps.setAt(parent, ps[idx]);
            mut vs.setAt(parent, vs[idx]);
            mut ps.setAt(idx, tp);
            mut vs.setAt(idx, ti);
            idx = parent;
        } else {
            break;
        }
    }
    pq.prios = ps;
    pq.items = vs;
    true
};

/** Removes and returns the lowest-priority `PQEntry<T>` in O(log n). */
pub PriorityQueue.pop := fn<T: Type>(pq: mut Self<T>): PQItem<T> {
    cnt := pq.prios.length();
    if cnt <= 0 { return .Empty; }
    topP := pq.prios[0];
    topI := pq.items[0];
    ps: mut List<Int> = pq.prios;
    vs: mut List<T> = pq.items;
    lastP := mut ps.popBack();
    lastI := mut vs.popBack();
    nextCnt := ps.length();
    if nextCnt > 0 {
        mut ps.setAt(0, lastP);
        mut vs.setAt(0, lastI);
        var idx := 0;
        loop true {
            left := (idx * 2) + 1;
            right := left + 1;
            var best := idx;
            if left < nextCnt and ps[left] < ps[best] { best = left; }
            if right < nextCnt and ps[right] < ps[best] { best = right; }
            if best == idx { break; }
            tp := ps[idx];
            ti := vs[idx];
            mut ps.setAt(idx, ps[best]);
            mut vs.setAt(idx, vs[best]);
            mut ps.setAt(best, tp);
            mut vs.setAt(best, ti);
            idx = best;
        }
    }
    pq.prios = ps;
    pq.items = vs;
    .Some(PQEntry<T> { priority = topP, item = topI })
};

/** Returns the lowest-priority `PQEntry<T>` without removing it in O(1). */
pub PriorityQueue.peek := fn<T: Type>(pq: Self<T>): PQItem<T> {
    if pq.prios.length() == 0 {
        .Empty
    } else {
        .Some(PQEntry<T> { priority = pq.prios[0], item = pq.items[0] })
    }
};

/** Returns the number of entries in `pq`. */
pub PriorityQueue.count := fn<T: Type>(pq: Self<T>): Int { pq.prios.length() };

/** Returns the maximum capacity of `pq`. */
pub PriorityQueue.capacity := fn<T: Type>(pq: Self<T>): Int { pq.cap };

/** True when `pq` contains zero entries. */
pub PriorityQueue.isEmpty := fn<T: Type>(pq: Self<T>): Bool { pq.prios.length() == 0 };

/** True when `pq` has reached capacity. */
pub PriorityQueue.isFull := fn<T: Type>(pq: Self<T>): Bool { pq.prios.length() >= pq.cap };

/** Clears all entries from `pq` in O(1). */
pub PriorityQueue.clear := fn<T: Type>(pq: mut Self<T>): Unit {
    ep: List<Int> = [];
    ei: List<T> = [];
    pq.prios = ep;
    pq.items = ei;
};
