/* Provisional core host cryptography signatures. This module adds no host authority by itself. */

/** Returns the lowercase hexadecimal SHA-256 digest of UTF-8 `text`. */
pub sha256Text := fn(text: String): String;

/** Returns the lowercase hexadecimal SHA-256 digest of the raw bytes of the file at `path`. */
pub sha256File := fn(path: String): (ok: Bool, hex: String, error: String);
