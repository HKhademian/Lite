var xidTablesReady := false;
xidStartRanges: mut List<Int> = [];
xidContExtraRanges: mut List<Int> = [];

hexNibble := fn(ch: String): Int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    if ch == "a" { return 10; }
    if ch == "b" { return 11; }
    if ch == "c" { return 12; }
    if ch == "d" { return 13; }
    if ch == "e" { return 14; }
    15
};

parseHexRanges := fn(encoded: String, out: mut List<Int>): Unit {
    size := encoded.length();
    var pos := 0;
    loop pos < size {
        var lo := 0;
        loop pos < size {
            ch := encoded.at(pos);
            if ch == "-" or ch == "," { break; }
            lo = lo * 16 + hexNibble(ch);
            pos += 1;
        }
        var hi := lo;
        if pos < size and encoded.at(pos) == "-" {
            pos += 1;
            hi = 0;
            loop pos < size {
                ch := encoded.at(pos);
                if ch == "," { break; }
                hi = hi * 16 + hexNibble(ch);
                pos += 1;
            }
        }
        if pos < size and encoded.at(pos) == "," { pos += 1; }
        mut out.pushBack(lo);
        mut out.pushBack(hi);
    }
};

ensureXidTables := fn(): Unit {
    if xidTablesReady { return; }
    parseHexRanges(XID_START_HEX_1, mut xidStartRanges);
    parseHexRanges(XID_START_HEX_2, mut xidStartRanges);
    parseHexRanges(XID_CONT_EXTRA_HEX, mut xidContExtraRanges);
    xidTablesReady = true;
};

inCodePointRanges := fn(ranges: List<Int>, cp: Int): Bool {
    var lo := 0;
    var hi := (ranges.length() / 2) - 1;
    loop lo <= hi {
        mid := lo + ((hi - lo) / 2);
        idx := mid * 2;
        if cp < ranges[idx] {
            hi = mid - 1;
        } else if cp > ranges[idx + 1] {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
};

/** True when `cp` is an ASCII letter or Unicode 16.0.0 `XID_Start` scalar. */
pub isXidStart := fn(cp: Int): Bool {
    if cp < 128 {
        return (cp >= 97 and cp <= 122) or (cp >= 65 and cp <= 90);
    }
    ensureXidTables();
    inCodePointRanges(xidStartRanges, cp)
};

/** True when `cp` is an ASCII identifier char or Unicode 16.0.0 `XID_Continue` scalar (excluding `Cf` join controls). */
pub isXidContinue := fn(cp: Int): Bool {
    if cp < 128 {
        return (cp >= 97 and cp <= 122) or (cp >= 65 and cp <= 90) or (cp >= 48 and cp <= 57) or cp == 95;
    }
    ensureXidTables();
    inCodePointRanges(xidStartRanges, cp) or inCodePointRanges(xidContExtraRanges, cp)
};

/** Shifts ASCII code points in `[lo, hi]` by `delta`, returning `source` untouched when no characters match. */
mapAsciiCodePointRange := fn(source: String, lo: Int, hi: Int, delta: Int): String {
    cps := source.toCodePoints();
    out: mut List<Int> = [];
    var changed := false;
    loop cps as cp {
        if cp >= lo and cp <= hi {
            mut out.pushBack(cp + delta);
            changed = true;
        } else {
            mut out.pushBack(cp);
        }
    }
    if not changed { return source; }
    String.fromCodePoints(out).text
};

/* --- Public String text & lexical operations --- */

/** Returns `value` unchanged as a `String`. */
pub String.toText := fn(value: Self): String {
    value
};

/** Formats one `Bool` as `"true"` or `"false"`. */
pub Bool.toText := fn(value: Self): String {
    if value { "true" } else { "false" }
};

/** True when `source` has zero Unicode scalars. */
pub String.isEmpty := fn(source: Self): Bool {
    source.length() == 0
};

/** Returns the first zero-based Unicode scalar index at or after `start` where `needle` occurs, or -1 when absent (soft builtin). */
pub String.indexOf := fn(source: Self, needle: String, start: Int): Int {
    if start < 0 { return -1; }
    srcLen := source.length();
    if start > srcLen { return -1; }
    needleLen := needle.length();
    if needleLen == 0 { return start; }
    limit := srcLen - needleLen;
    if start > limit { return -1; }
    first := needle.at(0);
    var i := start;
    loop i <= limit {
        if source.at(i) == first {
            var j := 1;
            var matched := true;
            loop j < needleLen {
                if source.at(i + j) =!= needle.at(j) {
                    matched = false;
                    break;
                }
                j += 1;
            }
            if matched { return i; }
        }
        i += 1;
    }
    -1
};

/** True when `text` is exactly one ASCII decimal digit (soft builtin). */
pub String.isDigit := fn(text: Self): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
};

/** Numeric value of one checked ASCII decimal digit. */
pub String.digitValue := fn(text: Self): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
};

/** True for one ASCII letter, `a`-`z` or `A`-`Z` (soft builtin). */
pub String.isAsciiLetter := fn(ch: Self): Bool {
    or ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or ch == "g"
    or ch == "h" or ch == "i" or ch == "j" or ch == "k" or ch == "l" or ch == "m" or ch == "n"
    or ch == "o" or ch == "p" or ch == "q" or ch == "r" or ch == "s" or ch == "t" or ch == "u"
    or ch == "v" or ch == "w" or ch == "x" or ch == "y" or ch == "z"
    or ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F" or ch == "G"
    or ch == "H" or ch == "I" or ch == "J" or ch == "K" or ch == "L" or ch == "M" or ch == "N"
    or ch == "O" or ch == "P" or ch == "Q" or ch == "R" or ch == "S" or ch == "T" or ch == "U"
    or ch == "V" or ch == "W" or ch == "X" or ch == "Y" or ch == "Z"
};

/** True for a valid identifier start (`XID_Start` or `_`) under Unicode 16.0.0 (soft builtin). */
pub String.isNameStart := fn(ch: Self): Bool {
    if ch.isAsciiLetter() or ch == "_" { return true; }
    if ch.length() =!= 1 { return false; }
    cp := ch.codePointAt(0);
    if cp < 128 { return false; }
    isXidStart(cp)
};

/** True for a valid identifier continuation character (`XID_Continue` without `Cf`) under Unicode 16.0.0 (soft builtin). */
pub String.isNameContinue := fn(ch: Self): Bool {
    if ch.isAsciiLetter() or ch.isDigit() or ch == "_" { return true; }
    if ch.length() =!= 1 { return false; }
    cp := ch.codePointAt(0);
    if cp < 128 { return false; }
    isXidContinue(cp)
};

/** True when `ch` is Lite ASCII whitespace (soft builtin). */
pub String.isWhitespace := fn(ch: Self): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
};

/** Returns the first position at or after `start` that is not Lite whitespace (soft builtin). */
pub String.skipSpaces := fn(source: Self, start: Int): Int {
    size := source.length();
    var position := start;
    loop position < size {
        if source.at(position).isWhitespace() {
            position += 1;
        } else {
            return position;
        }
    }
    position
};

/** Returns the position after the identifier run starting at `start` (soft builtin). */
pub String.skipName := fn(source: Self, start: Int): Int {
    size := source.length();
    var position := start;
    loop position < size and source.at(position).isNameContinue() {
        position += 1;
    }
    position
};

/** True when `text` occurs at `position` and stays inside `source` (soft builtin). */
pub String.startsWithAt := fn(source: Self, position: Int, text: String): Bool {
    width := text.length();
    size := source.length();
    if position < 0 or position + width > size { return false; }
    if width == 0 { return true; }
    if source.at(position) =!= text.at(0) { return false; }
    if width == 1 { return true; }
    source.slice(position, position + width) == text
};

/** True when the whole identifier `word` occurs at `position` (soft builtin). */
pub String.wordAt := fn(source: Self, position: Int, word: String): Bool {
    if not source.startsWithAt(position, word) { return false; }
    after := position + word.length();
    after >= source.length() or not source.at(after).isNameContinue()
};

/** Parses optional-sign decimal Int64 text (soft builtin). */
pub String.toInt := fn(text: Self): (value: Int, ok: Bool) {
    size := text.length();
    if size == 0 { return (value = 0, ok = false); }
    var position := 0;
    var negative := false;
    if text.at(0) == "-" {
        negative = true;
        position = 1;
    } else if text.at(0) == "+" {
        position = 1;
    }
    if position >= size { return (value = 0, ok = false); }
    var value := 0;
    loop position < size {
        ch := text.at(position);
        if not ch.isDigit() { return (value = 0, ok = false); }
        digit := ch.digitValue();
        if negative {
            if value < (integer.intMin + digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 - digit;
        } else {
            if value > (integer.intMax - digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 + digit;
        }
        position += 1;
    }
    (value = value, ok = true)
};

/** Returns `source` with leading Lite ASCII whitespace removed (soft builtin). */
pub String.trimStart := fn(source: Self): String {
    size := source.length();
    var start := 0;
    loop start < size and source.at(start).isWhitespace() {
        start += 1;
    }
    source.slice(start, size)
};

/** Returns `source` with trailing Lite ASCII whitespace removed (soft builtin). */
pub String.trimEnd := fn(source: Self): String {
    var end := source.length();
    loop end > 0 and source.at(end - 1).isWhitespace() {
        end -= 1;
    }
    source.slice(0, end)
};

/** Returns `source` with both leading and trailing Lite ASCII whitespace removed (soft builtin). */
pub String.trim := fn(source: Self): String {
    source.trimStart().trimEnd()
};

/** True when `source` starts with `prefix`. */
pub String.startsWith := fn(source: Self, prefix: String): Bool {
    source.startsWithAt(0, prefix)
};

/** True when `source` ends with `suffix` (soft builtin). */
pub String.endsWith := fn(source: Self, suffix: String): Bool {
    sourceLen := source.length();
    suffixLen := suffix.length();
    if suffixLen > sourceLen { return false; }
    source.startsWithAt(sourceLen - suffixLen, suffix)
};

/** Returns `value` repeated `count` times, or empty text when `count <= 0` (soft builtin). */
pub String.repeat := fn(value: Self, count: Int): String {
    if count <= 0 { return ""; }
    var out := "";
    var i := 0;
    loop i < count {
        out = out + value;
        i += 1;
    }
    out
};

/** True when `needle` occurs anywhere inside `source` (soft builtin). */
pub String.contains := fn(source: Self, needle: String): Bool {
    source.indexOf(needle, 0) >= 0
};

/** Returns `source` with ASCII uppercase letters `A`-`Z` converted to lowercase `a`-`z` (soft builtin). */
pub String.toLowerAscii := fn(source: Self): String {
    mapAsciiCodePointRange(source, 65, 90, 32)
};

/** Returns `source` with ASCII lowercase letters `a`-`z` converted to uppercase `A`-`Z`. */
pub String.toUpperAscii := fn(source: Self): String {
    mapAsciiCodePointRange(source, 97, 122, -32)
};

ASCII_CMP_ORDER := "\t\n\r !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";

/** Lexicographical Unicode code-point three-way comparison (`-1`, `0`, or `1`), with a fast ASCII path. */
pub String.compare := fn(a: Self, b: String): Int {
    la := a.length();
    lb := b.length();
    limit := if la < lb { la } else { lb };
    var i := 0;
    loop i < limit {
        ca := a.at(i);
        cb := b.at(i);
        if ca =!= cb {
            oa := ASCII_CMP_ORDER.indexOf(ca, 0);
            ob := ASCII_CMP_ORDER.indexOf(cb, 0);
            if oa >= 0 and ob >= 0 {
                return if oa < ob { -1 } else { 1 };
            }
            pa := ca.codePointAt(0);
            pb := cb.codePointAt(0);
            return if pa < pb { -1 } else { 1 };
        }
        i += 1;
    }
    if la < lb { -1 } else if la > lb { 1 } else { 0 }
};

/** Lexicographical Unicode code-point comparison (`a <= b`), with a fast ASCII path. */
pub String.lessOrEqual := fn(a: Self, b: String): Bool {
    a.compare(b) <= 0
};

/** Returns `value` left-padded with `fill` up to `width` scalars, or unchanged when already at least `width` (or `fill` is empty). */
pub String.padLeftWith := fn(value: Self, width: Int, fill: String): String {
    len := value.length();
    fillLen := fill.length();
    if len >= width or fillLen == 0 { return value; }
    need := width - len;
    reps := (need + fillLen - 1) / fillLen;
    pad := fill.repeat(reps);
    if pad.length() > need { pad.slice(0, need) + value } else { pad + value }
};

/** Returns `value` right-padded with `fill` up to `width` scalars, or unchanged when already at least `width` (or `fill` is empty). */
pub String.padRightWith := fn(value: Self, width: Int, fill: String): String {
    len := value.length();
    fillLen := fill.length();
    if len >= width or fillLen == 0 { return value; }
    need := width - len;
    reps := (need + fillLen - 1) / fillLen;
    pad := fill.repeat(reps);
    if pad.length() > need { value + pad.slice(0, need) } else { value + pad }
};

/** Returns `value` left-padded with spaces up to `width` scalars, or unchanged when already at least `width`. */
pub String.padLeft := fn(value: Self, width: Int): String {
    value.padLeftWith(width, " ")
};

/** Returns `value` right-padded with spaces up to `width` scalars, or unchanged when already at least `width`. */
pub String.padRight := fn(value: Self, width: Int): String {
    value.padRightWith(width, " ")
};

/** Splits `source` on every non-overlapping occurrence of `divider`. When `divider` is empty, splits into Unicode scalars. */
pub String.split := fn(source: Self, divider: String): List<String> {
    out: mut List<String> = [];
    srcLen := source.length();
    divLen := divider.length();
    if divLen == 0 {
        var i := 0;
        loop i < srcLen {
            mut out.pushBack(source.at(i));
            i += 1;
        }
        return out;
    }
    var pos := 0;
    loop true {
        hit := source.indexOf(divider, pos);
        if hit < 0 {
            mut out.pushBack(source.slice(pos, srcLen));
            break;
        }
        (mut out).pushBack(source.slice(pos, hit));
        pos = hit + divLen;
    }
    out
};

/** Splits `source` into lines on `\\n` (stripping any preceding `\\r`). */
pub String.splitLines := fn(source: Self): List<String> {
    out: mut List<String> = [];
    srcLen := source.length();
    if srcLen == 0 { return out; }
    var pos := 0;
    loop pos <= srcLen {
        nl := source.indexOf("\n", pos);
        end := if nl < 0 { srcLen } else { nl };
        lineEnd := if end > pos and source.at(end - 1) == "\r" { end - 1 } else { end };
        mut out.pushBack(source.slice(pos, lineEnd));
        if nl < 0 { break; }
        pos = nl + 1;
        if pos == srcLen { break; }
    }
    out
};

/** Replaces every non-overlapping occurrence of non-empty `needle` in `source` with `replacement` in O(n). */
pub String.replaceAll := fn(source: Self, needle: String, replacement: String): String {
    needleLen := needle.length();
    if needleLen == 0 { return source; }
    first := source.indexOf(needle, 0);
    if first < 0 { return source; }
    srcLen := source.length();
    parts: mut List<String> = [];
    var pos := 0;
    var hit := first;
    loop hit >= 0 {
        if hit > pos { mut parts.pushBack(source.slice(pos, hit)); }
        mut parts.pushBack(replacement);
        pos = hit + needleLen;
        hit = source.indexOf(needle, pos);
    }
    if pos < srcLen { mut parts.pushBack(source.slice(pos, srcLen)); }
    parts.join("")
};
