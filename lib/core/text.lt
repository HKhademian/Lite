/* Core String operations (hard builtins, soft builtins, pure Lite). */

integer := import "core/int";
unicode := import "core/unicode";

/** Returns Unicode scalar count for one string value. */
pub String.length := fn(text: Self): Int;

/** Returns the Unicode scalar at a zero-based position, faulting outside the string. */
pub String.at := fn(text: Self, position: Int): String;

/** Returns the half-open Unicode scalar interval `[start, end)`, faulting outside the string. */
pub String.slice := fn(text: Self, start: Int, end: Int): String;

/** True when `source` has zero Unicode scalars. */
pub String.isEmpty := fn(source: Self): Bool {
    source.length() == 0
}

/** Pure-Lite `indexOf` implementation shared by `String.indexOf` and deprecated `indexOf`. */
indexOfPure := fn(source: String, needle: String, start: Int): Int {
    if start < 0 { return -1; }
    srcLen := source.length();
    if start > srcLen { return -1; }
    needleLen := needle.length();
    if needleLen == 0 { return start; }
    limit := srcLen - needleLen;
    if start > limit { return -1; }
    first := needle.at(0);
    var i := start;
    loop i <= limit {
        if source.at(i) == first {
            var j := 1;
            var matched := true;
            loop j < needleLen {
                if source.at(i + j) =!= needle.at(j) {
                    matched = false;
                    break;
                }
                j += 1;
            }
            if matched { return i; }
        }
        i += 1;
    }
    -1
}

/** Pure-Lite `isDigit` implementation. */
isDigitPure := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

/** Numeric value of one checked ASCII decimal digit. */
digitValuePure := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

/** Pure-Lite `isAsciiLetter` implementation. */
isAsciiLetterPure := fn(ch: String): Bool {
    or ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or ch == "g"
    or ch == "h" or ch == "i" or ch == "j" or ch == "k" or ch == "l" or ch == "m" or ch == "n"
    or ch == "o" or ch == "p" or ch == "q" or ch == "r" or ch == "s" or ch == "t" or ch == "u"
    or ch == "v" or ch == "w" or ch == "x" or ch == "y" or ch == "z"
    or ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F" or ch == "G"
    or ch == "H" or ch == "I" or ch == "J" or ch == "K" or ch == "L" or ch == "M" or ch == "N"
    or ch == "O" or ch == "P" or ch == "Q" or ch == "R" or ch == "S" or ch == "T" or ch == "U"
    or ch == "V" or ch == "W" or ch == "X" or ch == "Y" or ch == "Z"
}

/** Pure-Lite `isNameStart` implementation (ASCII fast path + Unicode 16.0.0 XID_Start). */
isNameStartPure := fn(ch: String): Bool {
    if isAsciiLetterPure(ch) or ch == "_" { return true; }
    if ch.length() =!= 1 { return false; }
    cp := unicode.codePointAt(ch, 0);
    if cp < 128 { return false; }
    unicode.isXidStart(cp)
}

/** Pure-Lite `isNameContinue` implementation (ASCII fast path + Unicode 16.0.0 XID_Continue without Cf). */
isNameContinuePure := fn(ch: String): Bool {
    if isAsciiLetterPure(ch) or isDigitPure(ch) or ch == "_" { return true; }
    if ch.length() =!= 1 { return false; }
    cp := unicode.codePointAt(ch, 0);
    if cp < 128 { return false; }
    unicode.isXidContinue(cp)
}

/** Pure-Lite `isWhitespace` implementation. */
isWhitespacePure := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
}

/** Pure-Lite `skipSpaces` implementation. */
skipSpacesPure := fn(source: String, start: Int): Int {
    size := source.length();
    var position := start;
    loop position < size {
        ch := source.at(position);
        if isWhitespacePure(ch) {
            position = position + 1;
        } else {
            return position;
        }
    }
    position
}

/** Pure-Lite `skipName` implementation. */
skipNamePure := fn(source: String, start: Int): Int {
    size := source.length();
    var position := start;
    loop position < size and isNameContinuePure(source.at(position)) {
        position = position + 1;
    }
    position
}

/** Pure-Lite `startsWithAt` implementation. */
startsWithAtPure := fn(source: String, position: Int, text: String): Bool {
    width := text.length();
    size := source.length();
    if position < 0 or position + width > size { return false; }
    if width == 0 { return true; }
    if source.at(position) =!= text.at(0) { return false; }
    if width == 1 { return true; }
    source.slice(position, position + width) == text
}

/** Pure-Lite `wordAt` implementation. */
wordAtPure := fn(source: String, position: Int, word: String): Bool {
    if not startsWithAtPure(source, position, word) { return false; }
    after := position + word.length();
    after >= source.length() or not isNameContinuePure(source.at(after))
}

/** Pure-Lite `textToInt` implementation. */
textToIntPure := fn(text: String): (value: Int, ok: Bool) {
    size := text.length();
    if size == 0 { return (value = 0, ok = false); }
    var position := 0;
    var negative := false;
    if text.at(0) == "-" {
        negative = true;
        position = 1;
    } else if text.at(0) == "+" {
        position = 1;
    }
    if position >= size { return (value = 0, ok = false); }
    var value := 0;
    loop position < size {
        ch := text.at(position);
        if not isDigitPure(ch) { return (value = 0, ok = false); }
        digit := digitValuePure(ch);
        if negative {
            if value < (integer.intMin + digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 - digit;
        } else {
            if value > (integer.intMax - digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 + digit;
        }
        position = position + 1;
    }
    (value = value, ok = true)
}

/** Pure-Lite `trimStart` implementation. */
trimStartPure := fn(source: String): String {
    size := source.length();
    var start := 0;
    loop start < size and isWhitespacePure(source.at(start)) {
        start = start + 1;
    }
    source.slice(start, size)
}

/** Pure-Lite `trimEnd` implementation. */
trimEndPure := fn(source: String): String {
    var end := source.length();
    loop end > 0 and isWhitespacePure(source.at(end - 1)) {
        end = end - 1;
    }
    source.slice(0, end)
}

/** Pure-Lite `endsWith` implementation. */
endsWithPure := fn(source: String, suffix: String): Bool {
    sourceLen := source.length();
    suffixLen := suffix.length();
    if suffixLen > sourceLen { return false; }
    startsWithAtPure(source, sourceLen - suffixLen, suffix)
}

/** Pure-Lite `repeat` implementation. */
repeatPure := fn(value: String, count: Int): String {
    if count <= 0 { return ""; }
    var out := "";
    var i := 0;
    loop i < count {
        out = out + value;
        i = i + 1;
    }
    out
}

/** Returns `ch` in lowercase when it is an ASCII uppercase letter `A`-`Z`. */
lowerAsciiChar := fn(ch: String): String {
    if ch == "A" { return "a"; }
    if ch == "B" { return "b"; }
    if ch == "C" { return "c"; }
    if ch == "D" { return "d"; }
    if ch == "E" { return "e"; }
    if ch == "F" { return "f"; }
    if ch == "G" { return "g"; }
    if ch == "H" { return "h"; }
    if ch == "I" { return "i"; }
    if ch == "J" { return "j"; }
    if ch == "K" { return "k"; }
    if ch == "L" { return "l"; }
    if ch == "M" { return "m"; }
    if ch == "N" { return "n"; }
    if ch == "O" { return "o"; }
    if ch == "P" { return "p"; }
    if ch == "Q" { return "q"; }
    if ch == "R" { return "r"; }
    if ch == "S" { return "s"; }
    if ch == "T" { return "t"; }
    if ch == "U" { return "u"; }
    if ch == "V" { return "v"; }
    if ch == "W" { return "w"; }
    if ch == "X" { return "x"; }
    if ch == "Y" { return "y"; }
    if ch == "Z" { return "z"; }
    ch
}

/** Pure-Lite `toLowerAscii` implementation. */
toLowerAsciiPure := fn(source: String): String {
    size := source.length();
    var out := "";
    var runStart := 0;
    var i := 0;
    loop i < size {
        ch := source.at(i);
        lower := lowerAsciiChar(ch);
        if lower =!= ch {
            if i > runStart { out = out + source.slice(runStart, i); }
            out = out + lower;
            runStart = i + 1;
        }
        i = i + 1;
    }
    if runStart == 0 { return source; }
    if runStart < size { out = out + source.slice(runStart, size); }
    out
}

/* --- Public String type-attached operations --- */

/** Returns the first zero-based Unicode scalar index at or after `start` where `needle` occurs, or -1 when absent (soft builtin). */
pub String.indexOf := fn(source: Self, needle: String, start: Int): Int {
    indexOfPure(source, needle, start)
}

/** True when `text` is exactly one ASCII decimal digit (soft builtin). */
pub String.isDigit := fn(text: Self): Bool {
    isDigitPure(text)
}

/** Numeric value of one checked ASCII decimal digit. */
pub String.digitValue := fn(text: Self): Int {
    digitValuePure(text)
}

/** True for one ASCII letter, `a`-`z` or `A`-`Z` (soft builtin). */
pub String.isAsciiLetter := fn(ch: Self): Bool {
    isAsciiLetterPure(ch)
}

/** True for a valid identifier start (`XID_Start` or `_`) under Unicode 16.0.0 (soft builtin). */
pub String.isNameStart := fn(ch: Self): Bool {
    isNameStartPure(ch)
}

/** True for a valid identifier continuation character (`XID_Continue` without `Cf`) under Unicode 16.0.0 (soft builtin). */
pub String.isNameContinue := fn(ch: Self): Bool {
    isNameContinuePure(ch)
}

/** True when `ch` is Lite ASCII whitespace (soft builtin). */
pub String.isWhitespace := fn(ch: Self): Bool {
    isWhitespacePure(ch)
}

/** Returns the first position at or after `start` that is not Lite whitespace (soft builtin). */
pub String.skipSpaces := fn(source: Self, start: Int): Int {
    skipSpacesPure(source, start)
}

/** Returns the position after the identifier run starting at `start` (soft builtin). */
pub String.skipName := fn(source: Self, start: Int): Int {
    skipNamePure(source, start)
}

/** True when `text` occurs at `position` and stays inside `source` (soft builtin). */
pub String.startsWithAt := fn(source: Self, position: Int, text: String): Bool {
    startsWithAtPure(source, position, text)
}

/** True when the whole identifier `word` occurs at `position` (soft builtin). */
pub String.wordAt := fn(source: Self, position: Int, word: String): Bool {
    wordAtPure(source, position, word)
}

/** Parses optional-sign decimal Int64 text (soft builtin). */
pub String.toInt := fn(text: Self): (value: Int, ok: Bool) {
    textToIntPure(text)
}

/** Returns `source` with leading Lite ASCII whitespace removed (soft builtin). */
pub String.trimStart := fn(source: Self): String {
    trimStartPure(source)
}

/** Returns `source` with trailing Lite ASCII whitespace removed (soft builtin). */
pub String.trimEnd := fn(source: Self): String {
    trimEndPure(source)
}

/** Returns `source` with both leading and trailing Lite ASCII whitespace removed (soft builtin). */
pub String.trim := fn(source: Self): String {
    trimEndPure(trimStartPure(source))
}

/** True when `source` starts with `prefix`. */
pub String.startsWith := fn(source: Self, prefix: String): Bool {
    source.startsWithAt(0, prefix)
}

/** True when `source` ends with `suffix` (soft builtin). */
pub String.endsWith := fn(source: Self, suffix: String): Bool {
    endsWithPure(source, suffix)
}

/** Returns `value` repeated `count` times, or empty text when `count <= 0` (soft builtin). */
pub String.repeat := fn(value: Self, count: Int): String {
    repeatPure(value, count)
}

/** True when `needle` occurs anywhere inside `source` (soft builtin). */
pub String.contains := fn(source: Self, needle: String): Bool {
    indexOfPure(source, needle, 0) >= 0
}

/** Returns `source` with ASCII uppercase letters `A`-`Z` converted to lowercase `a`-`z` (soft builtin). */
pub String.toLowerAscii := fn(source: Self): String {
    toLowerAsciiPure(source)
}

/** Joins text values in list order with `separator` between adjacent values. */
pub joinTexts := fn(values: List<String>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = value;
            first = false;
        } else {
            result = result + separator + value;
        }
    }
    result
}
