/* Core String operations, Unicode scalar codecs, and UAX #31 identifier classification (hard builtins, soft builtins, pure Lite). */

integer := import "core/int";
_list := import "core/list";

/** Maximum valid Unicode scalar code point (`U+10FFFF`). */
pub UNICODE_MAX_SCALAR := 1114111;

/** Unicode replacement character (`U+FFFD`) substituted in lossy decoding. */
pub UNICODE_REPLACEMENT_CHAR := 65533;

UTF16_BMP_MAX := 65535;
UTF16_SUPPLEMENTARY_BASE := 65536;
UTF16_HIGH_SURROGATE_START := 55296;
UTF16_HIGH_SURROGATE_END := 56319;
UTF16_LOW_SURROGATE_START := 56320;
UTF16_LOW_SURROGATE_END := 57343;
UTF16_SURROGATE_SHIFT := 1024;
UTF8_ASCII_MAX := 127;
UTF8_CONT_MIN := 128;
UTF8_CONT_MAX := 191;
UTF8_2BYTE_LEAD_BASE := 192;
UTF8_2BYTE_LEAD_MIN := 194;
UTF8_2BYTE_MAX := 2047;
UTF8_3BYTE_LEAD_BASE := 224;
UTF8_3BYTE_LEAD_MAX := 239;
UTF8_3BYTE_LOW_CONT := 160;
UTF8_SURROGATE_LEAD := 237;
UTF8_3BYTE_SURROGATE_MAX_CONT := 159;
UTF8_4BYTE_LEAD_BASE := 240;
UTF8_4BYTE_LEAD_MAX := 244;
UTF8_4BYTE_LOW_CONT := 144;
UTF8_4BYTE_HIGH_CONT := 143;
BYTE_MAX := 255;

/* --- Hard builtin String operations --- */

/** Returns Unicode scalar count for one string value. */
pub String.length := fn(text: Self): Int;

/** Returns the Unicode scalar at a zero-based position, faulting outside the string. */
pub String.at := fn(text: Self, position: Int): String;

/** Returns the half-open Unicode scalar interval `[start, end)`, faulting outside the string. */
pub String.slice := fn(text: Self, start: Int, end: Int): String;

/** Returns the UTF-32 Unicode scalar code point list of `text`. */
pub String.toCodePoints := fn(text: Self): List<Int>;

/** Encodes UTF-32 Unicode scalar code points into text, rejecting invalid scalar values or surrogates. */
pub String.fromCodePoints := fn(points: List<Int>): (ok: Bool, text: String, error: String);

/** Formats one 64-bit IEEE-754 Float as shortest round-trip decimal text (`-0.0` formats as `"0"`). */
pub Float.toText := fn(value: Self): String;

/** Formats one 32-bit IEEE-754 Float32 as shortest round-trip decimal text (`-0.0` formats as `"0"`). */
pub Float32.toText := fn(value: Self): String;

/* --- Pure Unicode scalar & UTF-8 / UTF-16 helpers --- */

/** Returns true when `point` is a valid Unicode scalar value (`0..0x10FFFF` excluding surrogates `0xD800..0xDFFF`). */
pub isValidScalar := fn(point: Int): Bool {
    point >= 0 and point <= UNICODE_MAX_SCALAR and (point < UTF16_HIGH_SURROGATE_START or point > UTF16_LOW_SURROGATE_END)
};

/** Encodes a single Unicode scalar code point into a one-character string when valid. */
pub String.fromCodePoint := fn(point: Int): (ok: Bool, text: String, error: String) {
    points: List<Int> = [point];
    String.fromCodePoints(points)
};

/** Returns the Unicode scalar code point at zero-based scalar index `position`. */
pub String.codePointAt := fn(text: Self, position: Int): Int {
    ch := text.at(position);
    points := ch.toCodePoints();
    points[0]
};

/** Returns the number of UTF-16 code units in `text`. */
pub String.utf16Length := fn(text: Self): Int {
    var total := 0;
    loop text.toCodePoints() as cp {
        total += if cp <= UTF16_BMP_MAX { 1 } else { 2 };
    }
    total
};

/** Encodes `text` as UTF-16 `0..65535` code unit values. */
pub String.utf16Encode := fn(text: Self): List<Int> {
    var out: mut List<Int> = [];
    loop text.toCodePoints() as cp {
        if cp <= UTF16_BMP_MAX {
            mut out.pushBack(cp);
        } else {
            adjusted := cp - UTF16_SUPPLEMENTARY_BASE;
            mut out.pushBack(UTF16_HIGH_SURROGATE_START + (adjusted / UTF16_SURROGATE_SHIFT));
            mut out.pushBack(UTF16_LOW_SURROGATE_START + (adjusted % UTF16_SURROGATE_SHIFT));
        }
    }
    out
};

/** Decodes UTF-16 `0..65535` code units to text, rejecting out-of-range values or unpaired surrogates. */
pub String.fromUtf16Strict := fn(units: List<Int>): (ok: Bool, text: String, error: String) {
    count := units.length();
    var points: mut List<Int> = [];
    var index := 0;
    loop index < count {
        code := units[index];
        if code < 0 or code > UTF16_BMP_MAX {
            return (ok = false, text = "", error = "UTF-16 code unit outside 0..65535: " + code.toText());
        }
        if code >= UTF16_HIGH_SURROGATE_START and code <= UTF16_HIGH_SURROGATE_END {
            if index + 1 >= count {
                return (ok = false, text = "", error = "unpaired UTF-16 high surrogate");
            }
            next := units[index + 1];
            if next < UTF16_LOW_SURROGATE_START or next > UTF16_LOW_SURROGATE_END {
                return (ok = false, text = "", error = "unpaired UTF-16 high surrogate");
            }
            (mut points).pushBack(UTF16_SUPPLEMENTARY_BASE + (code - UTF16_HIGH_SURROGATE_START) * UTF16_SURROGATE_SHIFT + (next - UTF16_LOW_SURROGATE_START));
            index += 2;
        } else if code >= UTF16_LOW_SURROGATE_START and code <= UTF16_LOW_SURROGATE_END {
            return (ok = false, text = "", error = "unpaired UTF-16 low surrogate");
        } else {
            mut points.pushBack(code);
            index += 1;
        }
    }
    String.fromCodePoints(points)
};

/** Encodes `text` as UTF-8 `0..255` byte values (soft builtin). */
pub String.utf8Encode := fn(text: Self): List<Int> {
    var out: mut List<Int> = [];
    loop text.toCodePoints() as cp {
        if cp <= UTF8_ASCII_MAX {
            mut out.pushBack(cp);
        } else if cp <= UTF8_2BYTE_MAX {
            mut out.pushBack(UTF8_2BYTE_LEAD_BASE + (cp / 64));
            mut out.pushBack(UTF8_CONT_MIN + (cp % 64));
        } else if cp <= UTF16_BMP_MAX {
            mut out.pushBack(UTF8_3BYTE_LEAD_BASE + (cp / 4096));
            mut out.pushBack(UTF8_CONT_MIN + ((cp / 64) % 64));
            mut out.pushBack(UTF8_CONT_MIN + (cp % 64));
        } else {
            mut out.pushBack(UTF8_4BYTE_LEAD_BASE + (cp / 262144));
            mut out.pushBack(UTF8_CONT_MIN + ((cp / 4096) % 64));
            mut out.pushBack(UTF8_CONT_MIN + ((cp / 64) % 64));
            mut out.pushBack(UTF8_CONT_MIN + (cp % 64));
        }
    }
    out
};

/** Decodes UTF-8 `bytes`, either failing on invalid sequences (`strict`) or substituting U+FFFD. */
utf8DecodeInternal := fn(bytes: List<Int>, strict: Bool): (ok: Bool, text: String, error: String) {
    count := bytes.length();
    var points: mut List<Int> = [];
    var needed := 0;
    var seen := 0;
    var codePoint := 0;
    var lowerBoundary := UTF8_CONT_MIN;
    var upperBoundary := UTF8_CONT_MAX;
    var index := 0;
    loop index < count {
        b := bytes[index];
        if b < 0 or b > BYTE_MAX {
            if strict {
                return (ok = false, text = "", error = "byte value outside 0..255: " + b.toText());
            }
            if needed > 0 {
                mut points.pushBack(UNICODE_REPLACEMENT_CHAR);
            }
            codePoint = 0;
            needed = 0;
            seen = 0;
            lowerBoundary = UTF8_CONT_MIN;
            upperBoundary = UTF8_CONT_MAX;
            mut points.pushBack(UNICODE_REPLACEMENT_CHAR);
            index += 1;
        } else if needed == 0 {
            if b <= UTF8_ASCII_MAX {
                mut points.pushBack(b);
            } else if b >= UTF8_2BYTE_LEAD_MIN and b <= UTF8_3BYTE_LEAD_BASE - 1 {
                needed = 1;
                codePoint = b - UTF8_2BYTE_LEAD_BASE;
            } else if b >= UTF8_3BYTE_LEAD_BASE and b <= UTF8_3BYTE_LEAD_MAX {
                if b == UTF8_3BYTE_LEAD_BASE { lowerBoundary = UTF8_3BYTE_LOW_CONT; }
                if b == UTF8_SURROGATE_LEAD { upperBoundary = UTF8_3BYTE_SURROGATE_MAX_CONT; }
                needed = 2;
                codePoint = b - UTF8_3BYTE_LEAD_BASE;
            } else if b >= UTF8_4BYTE_LEAD_BASE and b <= UTF8_4BYTE_LEAD_MAX {
                if b == UTF8_4BYTE_LEAD_BASE { lowerBoundary = UTF8_4BYTE_LOW_CONT; }
                if b == UTF8_4BYTE_LEAD_MAX { upperBoundary = UTF8_4BYTE_HIGH_CONT; }
                needed = 3;
                codePoint = b - UTF8_4BYTE_LEAD_BASE;
            } else {
                if strict {
                    return (ok = false, text = "", error = "invalid UTF-8 lead byte");
                }
                (mut points).pushBack(UNICODE_REPLACEMENT_CHAR);
            }
            index += 1;
        } else if b < lowerBoundary or b > upperBoundary {
            if strict {
                return (ok = false, text = "", error = "invalid UTF-8 continuation byte");
            }
            codePoint = 0;
            needed = 0;
            seen = 0;
            lowerBoundary = UTF8_CONT_MIN;
            upperBoundary = UTF8_CONT_MAX;
            mut points.pushBack(UNICODE_REPLACEMENT_CHAR);
        } else {
            lowerBoundary = UTF8_CONT_MIN;
            upperBoundary = UTF8_CONT_MAX;
            codePoint = codePoint * 64 + (b - UTF8_CONT_MIN);
            seen += 1;
            if seen == needed {
                mut points.pushBack(codePoint);
                codePoint = 0;
                needed = 0;
                seen = 0;
            }
            index += 1;
        }
    }
    if needed > 0 {
        if strict {
            return (ok = false, text = "", error = "truncated UTF-8 sequence");
        }
        (mut points).pushBack(UNICODE_REPLACEMENT_CHAR);
    }
    String.fromCodePoints(points)
};

/** Decodes raw `0..255` UTF-8 bytes to text, rejecting invalid byte values or invalid UTF-8 sequences (soft builtin). */
pub String.fromUtf8Strict := fn(bytes: List<Int>): (ok: Bool, text: String, error: String) {
    utf8DecodeInternal(bytes, true)
};

/** Decodes raw `0..255` UTF-8 bytes to text, replacing malformed byte sequences with U+FFFD (soft builtin). */
pub String.fromUtf8Lossy := fn(bytes: List<Int>): String {
    utf8DecodeInternal(bytes, false).text
};

/** Returns true when `bytes` is a valid `0..255` byte list forming strict UTF-8. */
pub String.isValidUtf8 := fn(bytes: List<Int>): Bool {
    String.fromUtf8Strict(bytes).ok
};

