/* Core cryptography primitives (host CSPRNG plus pure-Lite SHA-256, SHA-512, HMAC, and encodings). This module adds no host authority by itself. */

diag := import "core/diag";
file := import "core/file";
io := import "core/io";
text := import "type/string";

/** Generates `count` cryptographically strong random `0..255` byte values. */
pub randomBytes := fn(count: Int): List<Int> #host;

b64Alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
hexAlphabet := "0123456789abcdef";

/** Validates that every integer in `bytes` falls within `0..255`. */
checkByteRange := fn(bytes: List<Int>): Unit {
    loop bytes as b {
        if b < 0 or b > 255 {
            diag.fail("", "byte value outside 0..255: " + b.toText());
            return;
        }
    }
};

k256: [UInt32; 64] = [
1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
];

k512: [UInt64; 80] = [
4794697086780616226, 8158064640168781261, 13096744586834688815, 16840607885511220156,
4131703408338449720, 6480981068601479193, 10538285296894168987, 12329834152419229976,
15566598209576043074, 1334009975649890238, 2608012711638119052, 6128411473006802146,
8268148722764581231, 9286055187155687089, 11230858885718282805, 13951009754708518548,
16472876342353939154, 17275323862435702243, 1135362057144423861, 2597628984639134821,
3308224258029322869, 5365058923640841347, 6679025012923562964, 8573033837759648693,
10970295158949994411, 12119686244451234320, 12683024718118986047, 13788192230050041572,
14330467153632333762, 15395433587784984357, 489312712824947311, 1452737877330783856,
2861767655752347644, 3322285676063803686, 5560940570517711597, 5996557281743188959,
7280758554555802590, 8532644243296465576, 9350256976987008742, 10552545826968843579,
11727347734174303076, 12113106623233404929, 14000437183269869457, 14369950271660146224,
15101387698204529176, 15463397548674623760, 17586052441742319658, 1182934255886127544,
1847814050463011016, 2177327727835720531, 2830643537854262169, 3796741975233480872,
4115178125766777443, 5681478168544905931, 6601373596472566643, 7507060721942968483,
8399075790359081724, 8693463985226723168, 9568029438360202098, 10144078919501101548,
10430055236837252648, 11840083180663258601, 13761210420658862357, 14299343276471374635,
14566680578165727644, 15097957966210449927, 16922976911328602910, 17689382322260857208,
500013540394364858, 748580250866718886, 1242879168328830382, 1977374033974150939,
2944078676154940804, 3659926193048069267, 4368137639120453308, 4836135668995329356,
5532061633213252278, 6448918945643986474, 6902733635092675308, 7801388544844847127
];

/** Formats an unsigned 32-bit integer as 8 lowercase hexadecimal digits. */
word32Hex := fn(word: UInt32): String {
    var out := "";
    var step := 0;
    loop step < 8 {
        nib := cast<Int>(word.shiftRight(28 - step * 4).bitAnd(15));
        out += hexAlphabet.at(nib);
        step += 1;
    }
    out
};

/** Formats an unsigned 64-bit integer as 16 lowercase hexadecimal digits. */
word64Hex := fn(word: UInt64): String {
    var out := "";
    var step := 0;
    loop step < 16 {
        nib := cast<Int>(word.shiftRight(60 - step * 4).bitAnd(15));
        out += hexAlphabet.at(nib);
        step += 1;
    }
    out
};

/** Compresses one 64-byte SHA-256 block into the eight 32-bit state words using stack-inline schedule storage. */
sha256Compress := fn(
h0In: UInt32, h1In: UInt32, h2In: UInt32, h3In: UInt32,
h4In: UInt32, h5In: UInt32, h6In: UInt32, h7In: UInt32,
block: List<Int>, offset: Int
): (h0: UInt32, h1: UInt32, h2: UInt32, h3: UInt32, h4: UInt32, h5: UInt32, h6: UInt32, h7: UInt32) {
    var w: [UInt32; 64];
    var i := 0;
    loop i < 16 {
        p := offset + i * 4;
        w[i] = cast<UInt32>(block[p]).shiftLeft(24)
        .bitOr(cast<UInt32>(block[p + 1]).shiftLeft(16))
        .bitOr(cast<UInt32>(block[p + 2]).shiftLeft(8))
        .bitOr(cast<UInt32>(block[p + 3]));
        i += 1;
    }
    loop i < 64 {
        w15 := w[i - 15];
        s0 := w15.rotateRight(7).bitXor(w15.rotateRight(18)).bitXor(w15.shiftRight(3));
        w2 := w[i - 2];
        s1 := w2.rotateRight(17).bitXor(w2.rotateRight(19)).bitXor(w2.shiftRight(10));
        w[i] = w[i - 16].wrappingAdd(s0).wrappingAdd(w[i - 7]).wrappingAdd(s1);
        i += 1;
    }

    var a := h0In;
    var b := h1In;
    var c := h2In;
    var d := h3In;
    var e := h4In;
    var f := h5In;
    var g := h6In;
    var h := h7In;
    var r := 0;
    loop r < 64 {
        capS1 := e.rotateRight(6).bitXor(e.rotateRight(11)).bitXor(e.rotateRight(25));
        ch := e.bitAnd(f).bitXor(e.bitNot().bitAnd(g));
        temp1 := h.wrappingAdd(capS1).wrappingAdd(ch).wrappingAdd(k256[r]).wrappingAdd(w[r]);
        capS0 := a.rotateRight(2).bitXor(a.rotateRight(13)).bitXor(a.rotateRight(22));
        maj := a.bitAnd(b).bitXor(a.bitAnd(c)).bitXor(b.bitAnd(c));
        temp2 := capS0.wrappingAdd(maj);
        h = g;
        g = f;
        f = e;
        e = d.wrappingAdd(temp1);
        d = c;
        c = b;
        b = a;
        a = temp1.wrappingAdd(temp2);
        r += 1;
    }
    (
    h0 = h0In.wrappingAdd(a),
    h1 = h1In.wrappingAdd(b),
    h2 = h2In.wrappingAdd(c),
    h3 = h3In.wrappingAdd(d),
    h4 = h4In.wrappingAdd(e),
    h5 = h5In.wrappingAdd(f),
    h6 = h6In.wrappingAdd(g),
    h7 = h7In.wrappingAdd(h)
    )
};

/** Pads and hashes the remaining SHA-256 tail block(s) and returns the lowercase hex digest. */
sha256FinalizeTail := fn(
h0In: UInt32, h1In: UInt32, h2In: UInt32, h3In: UInt32,
h4In: UInt32, h5In: UInt32, h6In: UInt32, h7In: UInt32,
tail: List<Int>, totalBytes: Int
): String {
    var h0 := h0In;
    var h1 := h1In;
    var h2 := h2In;
    var h3 := h3In;
    var h4 := h4In;
    var h5 := h5In;
    var h6 := h6In;
    var h7 := h7In;
    mut padded: List<Int> = [];
    loop tail as b {
        mut padded.pushBack(b);
    }
    (mut padded).pushBack(128);
    loop (padded.length() % 64) =!= 56 {
        mut padded.pushBack(0);
    }
    bitLen := cast<UInt64>(totalBytes).shiftLeft(3);
    var k := 0;
    loop k < 8 {
        mut padded.pushBack(cast<Int>(bitLen.shiftRight(56 - k * 8).bitAnd(255)));
        k += 1;
    }
    totalPadded := padded.length();
    var pos := 0;
    loop pos < totalPadded {
        st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, padded, pos);
        h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
        h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
        pos += 64;
    }
    word32Hex(h0) + word32Hex(h1) + word32Hex(h2) + word32Hex(h3) +
    word32Hex(h4) + word32Hex(h5) + word32Hex(h6) + word32Hex(h7)
};

/** Streams raw bytes from `reader` and returns the lowercase hexadecimal SHA-256 digest. */
pub sha256Reader := fn(reader: io.Reader): (ok: Bool, hex: String, error: String) {
    if not reader.ok() {
        return (ok = false, hex = "", error = reader.error());
    }
    var h0: UInt32 = 1779033703;
    var h1: UInt32 = 3144134277;
    var h2: UInt32 = 1013904242;
    var h3: UInt32 = 2773480762;
    var h4: UInt32 = 1359893119;
    var h5: UInt32 = 2600822924;
    var h6: UInt32 = 528734635;
    var h7: UInt32 = 1541459225;
    var totalBytes := 0;
    var mut tail: List<Int> = [];
    loop true {
        chunk := reader.read(16384);
        if not reader.ok() {
            return (ok = false, hex = "", error = reader.error());
        }
        chunkLen := chunk.length();
        if chunkLen == 0 {
            if reader.atEof() { break; }
            continue;
        }
        totalBytes += chunkLen;
        var pos := 0;
        if tail.length() > 0 {
            loop tail.length() < 64 and pos < chunkLen {
                mut tail.pushBack(chunk[pos]);
                pos += 1;
            }
            if tail.length() == 64 {
                st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, tail, 0);
                h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
                h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
                tail = [];
            }
        }
        loop pos + 64 <= chunkLen {
            st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, chunk, pos);
            h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
            h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
            pos += 64;
        }
        loop pos < chunkLen {
            mut tail.pushBack(chunk[pos]);
            pos += 1;
        }
    }
    (ok = true, hex = sha256FinalizeTail(h0, h1, h2, h3, h4, h5, h6, h7, tail, totalBytes), error = "")
};

/** Returns the lowercase hexadecimal SHA-256 digest of raw `0..255` byte values. */
pub sha256Bytes := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    total := bytes.length();
    var h0: UInt32 = 1779033703;
    var h1: UInt32 = 3144134277;
    var h2: UInt32 = 1013904242;
    var h3: UInt32 = 2773480762;
    var h4: UInt32 = 1359893119;
    var h5: UInt32 = 2600822924;
    var h6: UInt32 = 528734635;
    var h7: UInt32 = 1541459225;
    var pos := 0;
    loop pos + 64 <= total {
        st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, bytes, pos);
        h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
        h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
        pos += 64;
    }
    mut tail: List<Int> = [];
    loop pos < total {
        mut tail.pushBack(bytes[pos]);
        pos += 1;
    }
    sha256FinalizeTail(h0, h1, h2, h3, h4, h5, h6, h7, tail, total)
};

/** Returns the lowercase hexadecimal SHA-256 digest of UTF-8 `value`. */
pub sha256Text := fn(value: String): String {
    sha256Bytes(value.utf8Encode())
};

/** Returns the lowercase hexadecimal SHA-256 digest of the raw bytes of the file at `path`. */
pub sha256File := fn(path: String): (ok: Bool, hex: String, error: String) {
    reader := file.openReader(path);
    if not reader.ok() {
        return (ok = false, hex = "", error = reader.error());
    }
    hashed := sha256Reader(reader);
    closed := reader.close();
    if not hashed.ok {
        return hashed;
    }
    if not closed.ok {
        return (ok = false, hex = "", error = closed.error);
    }
    hashed
};

/** Returns the lowercase hexadecimal SHA-512 digest of raw `0..255` byte values. */
pub sha512Bytes := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    total := bytes.length();
    mut padded: List<Int> = [];
    loop bytes as b {
        mut padded.pushBack(b);
    }
    (mut padded).pushBack(128);
    loop (padded.length() % 128) =!= 112 {
        mut padded.pushBack(0);
    }
    bitLenHi := cast<UInt64>(total).shiftRight(61);
    bitLenLo := cast<UInt64>(total).shiftLeft(3);
    var k := 0;
    loop k < 8 {
        mut padded.pushBack(cast<Int>(bitLenHi.shiftRight(56 - k * 8).bitAnd(255)));
        k += 1;
    }
    k = 0;
    loop k < 8 {
        mut padded.pushBack(cast<Int>(bitLenLo.shiftRight(56 - k * 8).bitAnd(255)));
        k += 1;
    }

    var h0: UInt64 = 7640891576956012808;
    var h1: UInt64 = 13503953896175478587;
    var h2: UInt64 = 4354685564936845355;
    var h3: UInt64 = 11912009170470909681;
    var h4: UInt64 = 5840696475078001361;
    var h5: UInt64 = 11170449401992604703;
    var h6: UInt64 = 2270897969802886507;
    var h7: UInt64 = 6620516959819538809;

    totalPadded := padded.length();
    var offset := 0;
    var w: [UInt64; 80];
    loop offset < totalPadded {
        var i := 0;
        loop i < 16 {
            p := offset + i * 8;
            w[i] = cast<UInt64>(padded[p]).shiftLeft(56)
            .bitOr(cast<UInt64>(padded[p + 1]).shiftLeft(48))
            .bitOr(cast<UInt64>(padded[p + 2]).shiftLeft(40))
            .bitOr(cast<UInt64>(padded[p + 3]).shiftLeft(32))
            .bitOr(cast<UInt64>(padded[p + 4]).shiftLeft(24))
            .bitOr(cast<UInt64>(padded[p + 5]).shiftLeft(16))
            .bitOr(cast<UInt64>(padded[p + 6]).shiftLeft(8))
            .bitOr(cast<UInt64>(padded[p + 7]));
            i += 1;
        }
        loop i < 80 {
            w15 := w[i - 15];
            s0 := w15.rotateRight(1).bitXor(w15.rotateRight(8)).bitXor(w15.shiftRight(7));
            w2 := w[i - 2];
            s1 := w2.rotateRight(19).bitXor(w2.rotateRight(61)).bitXor(w2.shiftRight(6));
            w[i] = w[i - 16].wrappingAdd(s0).wrappingAdd(w[i - 7]).wrappingAdd(s1);
            i += 1;
        }

        var a := h0;
        var b := h1;
        var c := h2;
        var d := h3;
        var e := h4;
        var f := h5;
        var g := h6;
        var h := h7;

        var r := 0;
        loop r < 80 {
            sig1 := e.rotateRight(14).bitXor(e.rotateRight(18)).bitXor(e.rotateRight(41));
            ch := e.bitAnd(f).bitXor(e.bitNot().bitAnd(g));
            temp1 := h.wrappingAdd(sig1).wrappingAdd(ch).wrappingAdd(k512[r]).wrappingAdd(w[r]);
            sig0 := a.rotateRight(28).bitXor(a.rotateRight(34)).bitXor(a.rotateRight(39));
            maj := a.bitAnd(b).bitXor(a.bitAnd(c)).bitXor(b.bitAnd(c));
            temp2 := sig0.wrappingAdd(maj);

            h = g;
            g = f;
            f = e;
            e = d.wrappingAdd(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrappingAdd(temp2);
            r += 1;
        }

        h0 = h0.wrappingAdd(a);
        h1 = h1.wrappingAdd(b);
        h2 = h2.wrappingAdd(c);
        h3 = h3.wrappingAdd(d);
        h4 = h4.wrappingAdd(e);
        h5 = h5.wrappingAdd(f);
        h6 = h6.wrappingAdd(g);
        h7 = h7.wrappingAdd(h);
        offset += 128;
    }

    word64Hex(h0) + word64Hex(h1) + word64Hex(h2) + word64Hex(h3) +
    word64Hex(h4) + word64Hex(h5) + word64Hex(h6) + word64Hex(h7)
};

/** Returns the lowercase hexadecimal SHA-512 digest of UTF-8 `value`. */
pub sha512Text := fn(value: String): String {
    sha512Bytes(value.utf8Encode())
};

/** True when `ch` is one of the 64 non-padding Base64 alphabet characters. */
isBase64DataChar := fn(ch: String): Bool {
    b64Alphabet.indexOf(ch, 0) >= 0
}

/** True when `ch` is an ASCII hexadecimal digit (`0-9`, `a-f`, `A-F`). */
isHexChar := fn(ch: String): Bool {
    "0123456789abcdefABCDEF".indexOf(ch, 0) >= 0
}

/** Computes the bitwise XOR of two byte values (`0..255`). */
byteXor := fn(left: Int, right: Int): Int {
    left.bitXor(right)
}

/** Returns true when `encoded` is valid standard RFC 4648 padded base64 text. */
pub isValidBase64 := fn(encoded: String): Bool {
    size := encoded.length();
    if size == 0 { return true; }
    if size % 4 =!= 0 { return false; }
    var padding := 0;
    if encoded.at(size - 1) == "=" { padding += 1; }
    if encoded.at(size - 2) == "=" {
        if padding == 0 { return false; }
        padding += 1;
    }
    dataEnd := size - padding;
    var index := 0;
    loop index < dataEnd {
        if not isBase64DataChar(encoded.at(index)) { return false; }
        index += 1;
    }
    true
}

/** Returns true when `encoded` is valid even-length hexadecimal byte text. */
pub isValidHex := fn(encoded: String): Bool {
    size := encoded.length();
    if size % 2 =!= 0 { return false; }
    var index := 0;
    loop index < size {
        if not isHexChar(encoded.at(index)) { return false; }
        index += 1;
    }
    true
}

/** Encodes raw `0..255` byte values as standard RFC 4648 base64 text. */
pub base64Encode := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    count := bytes.length();
    mut parts: List<String> = [];
    var index := 0;
    loop index < count {
        b0 := bytes[index];
        c0 := b64Alphabet.at(b0 / 4);
        rem0 := b0 % 4;
        if index + 1 >= count {
            mut parts.pushBack(c0 + b64Alphabet.at(rem0 * 16) + "==");
            break;
        }
        b1 := bytes[index + 1];
        c1 := b64Alphabet.at(rem0 * 16 + (b1 / 16));
        rem1 := b1 % 16;
        if index + 2 >= count {
            mut parts.pushBack(c0 + c1 + b64Alphabet.at(rem1 * 4) + "=");
            break;
        }
        b2 := bytes[index + 2];
        mut parts.pushBack(c0 + c1 + b64Alphabet.at(rem1 * 4 + (b2 / 64)) + b64Alphabet.at(b2 % 64));
        index += 3;
    }
    parts.join("")
}

/** Decodes standard RFC 4648 base64 text into `0..255` byte values, faulting on malformed input. */
pub base64Decode := fn(encoded: String): List<Int> {
    if not isValidBase64(encoded) {
        diag.fail("", "invalid base64 input");
        return [];
    }
    size := encoded.length();
    var mut out: List<Int> = [];
    var index := 0;
    loop index < size {
        d0 := b64Alphabet.indexOf(encoded.at(index), 0);
        d1 := b64Alphabet.indexOf(encoded.at(index + 1), 0);
        mut out.pushBack(d0 * 4 + (d1 / 16));
        c2 := encoded.at(index + 2);
        if c2 =!= "=" {
            d2 := b64Alphabet.indexOf(c2, 0);
            mut out.pushBack((d1 % 16) * 16 + (d2 / 4));
            c3 := encoded.at(index + 3);
            if c3 =!= "=" {
                d3 := b64Alphabet.indexOf(c3, 0);
                mut out.pushBack((d2 % 4) * 64 + d3);
            }
        }
        index += 4;
    }
    out
}

/** Encodes raw `0..255` byte values as lowercase hexadecimal text. */
pub hexEncode := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    mut parts: List<String> = [];
    loop bytes as b {
        mut parts.pushBack(hexAlphabet.at(b / 16) + hexAlphabet.at(b % 16));
    }
    parts.join("")
}

/** Decodes hexadecimal text into `0..255` byte values, faulting on malformed input. */
pub hexDecode := fn(encoded: String): List<Int> {
    if not isValidHex(encoded) {
        diag.fail("", "invalid hex input");
        return [];
    }
    size := encoded.length();
    var mut out: List<Int> = [];
    var index := 0;
    loop index < size {
        hi := hexAlphabet.indexOf(encoded.at(index).toLowerAscii(), 0);
        lo := hexAlphabet.indexOf(encoded.at(index + 1).toLowerAscii(), 0);
        mut out.pushBack(hi * 16 + lo);
        index += 2;
    }
    out
}

/** Returns the lowercase hexadecimal HMAC-SHA256 tag of `data` using secret `key` bytes. */
pub hmacSha256Bytes := fn(key: List<Int>, data: List<Int>): String {
    checkByteRange(key);
    keySize := key.length();
    normalized := if keySize > 64 { hexDecode(sha256Bytes(key)) } else { key };
    var mut blockKey: List<Int> = [];
    loop normalized as b {
        mut blockKey.pushBack(b);
    }
    loop blockKey.length() < 64 {
        mut blockKey.pushBack(0);
    }
    var mut inner: List<Int> = [];
    var mut outer: List<Int> = [];
    var index := 0;
    loop index < 64 {
        kb := blockKey[index];
        mut inner.pushBack(byteXor(kb, 54));
        mut outer.pushBack(byteXor(kb, 92));
        index += 1;
    }
    loop data as b {
        mut inner.pushBack(b);
    }
    innerDigest := hexDecode(sha256Bytes(inner));
    loop innerDigest as b {
        mut outer.pushBack(b);
    }
    sha256Bytes(outer)
}
