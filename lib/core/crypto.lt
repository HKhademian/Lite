587496836, 1086792851, 365543100, 2618297676, 3409855158, 4234509866, 987167468, 1246189591
];

/** Computes 32-bit three-way bitwise XOR via precomputed 4-bit lookup tables. */
xor3_32 := fn(a: Int, b: Int, c: Int): Int {
    var x := a;
    var y := b;
    var z := c;
    var acc := 0;
    var mul := 1;
    var step := 0;
    loop step < 8 {
        xy := xor4[(x % 16) * 16 + (y % 16)];
        acc += xor4[xy * 16 + (z % 16)] * mul;
        x /= 16;
        y /= 16;
        z /= 16;
        mul *= 16;
        step += 1;
    }
    acc
};

/** Computes the SHA-256 `Ch(e, f, g)` 32-bit bitwise choice function. */
ch32 := fn(e: Int, f: Int, g: Int): Int {
    var ve := e;
    var vf := f;
    var vg := g;
    var acc := 0;
    var mul := 1;
    var step := 0;
    loop step < 8 {
        ne := ve % 16;
        nf := vf % 16;
        ng := vg % 16;
        fxor := xor4[nf * 16 + ng];
        acc += xor4[ng * 16 + and4[ne * 16 + fxor]] * mul;
        ve /= 16;
        vf /= 16;
        vg /= 16;
        mul *= 16;
        step += 1;
    }
    acc
};

/** Computes the SHA-256 `Maj(a, b, c)` 32-bit bitwise majority function. */
maj32 := fn(a: Int, b: Int, c: Int): Int {
    var va := a;
    var vb := b;
    var vc := c;
    var acc := 0;
    var mul := 1;
    var step := 0;
    loop step < 8 {
        na := va % 16;
        nb := vb % 16;
        nc := vc % 16;
        abAnd := and4[na * 16 + nb];
        abXor := xor4[na * 16 + nb];
        acc += xor4[abAnd * 16 + and4[nc * 16 + abXor]] * mul;
        va /= 16;
        vb /= 16;
        vc /= 16;
        mul *= 16;
        step += 1;
    }
    acc
};

/** Formats an unsigned 32-bit integer as 8 lowercase hexadecimal digits. */
word32Hex := fn(word: Int): String {
    var out := "";
    var div := 268435456;
    var step := 0;
    loop step < 8 {
        nib := (word / div) % 16;
        out += hexAlphabet.at(nib);
        div /= 16;
        step += 1;
    }
    out
};

/** Compresses one 64-byte SHA-256 block into the eight 32-bit state words. */
sha256Compress := fn(
h0In: Int, h1In: Int, h2In: Int, h3In: Int,
h4In: Int, h5In: Int, h6In: Int, h7In: Int,
block: List<Int>, offset: Int
): (h0: Int, h1: Int, h2: Int, h3: Int, h4: Int, h5: Int, h6: Int, h7: Int) {
    w: mut List<Int> = [];
    var i := 0;
    loop i < 16 {
        p := offset + i * 4;
        mut w.pushBack(block[p] * 16777216 + block[p + 1] * 65536 + block[p + 2] * 256 + block[p + 3]);
        i += 1;
    }
    loop i < 64 {
        w15 := w[i - 15];
        s0 := xor3_32(
        (w15 / 128) + (w15 % 128) * 33554432,
        (w15 / 262144) + (w15 % 262144) * 16384,
        w15 / 8
        );
        w2 := w[i - 2];
        s1 := xor3_32(
        (w2 / 131072) + (w2 % 131072) * 32768,
        (w2 / 524288) + (w2 % 524288) * 8192,
        w2 / 1024
        );
        mut w.pushBack((w[i - 16] + s0 + w[i - 7] + s1) % pow32);
        i += 1;
    }

    var a := h0In;
    var b := h1In;
    var c := h2In;
    var d := h3In;
    var e := h4In;
    var f := h5In;
    var g := h6In;
    var h := h7In;
    var r := 0;
    loop r < 64 {
        capS1 := xor3_32(
        (e / 64) + (e % 64) * 67108864,
        (e / 2048) + (e % 2048) * 2097152,
        (e / 33554432) + (e % 33554432) * 128
        );
        ch := ch32(e, f, g);
        temp1 := (h + capS1 + ch + k256[r] + w[r]) % pow32;
        capS0 := xor3_32(
        (a / 4) + (a % 4) * 1073741824,
        (a / 8192) + (a % 8192) * 524288,
        (a / 4194304) + (a % 4194304) * 1024
        );
        maj := maj32(a, b, c);
        temp2 := (capS0 + maj) % pow32;
        h = g;
        g = f;
        f = e;
        e = (d + temp1) % pow32;
        d = c;
        c = b;
        b = a;
        a = (temp1 + temp2) % pow32;
        r += 1;
    }
    (
    h0 = (h0In + a) % pow32,
    h1 = (h1In + b) % pow32,
    h2 = (h2In + c) % pow32,
    h3 = (h3In + d) % pow32,
    h4 = (h4In + e) % pow32,
    h5 = (h5In + f) % pow32,
    h6 = (h6In + g) % pow32,
    h7 = (h7In + h) % pow32
    )
};

/** Pads and hashes the remaining SHA-256 tail block(s) and returns the lowercase hex digest. */
sha256FinalizeTail := fn(
h0In: Int, h1In: Int, h2In: Int, h3In: Int,
h4In: Int, h5In: Int, h6In: Int, h7In: Int,
tail: List<Int>, totalBytes: Int
): String {
    var h0 := h0In;
    var h1 := h1In;
    var h2 := h2In;
    var h3 := h3In;
    var h4 := h4In;
    var h5 := h5In;
    var h6 := h6In;
    var h7 := h7In;
    padded: mut List<Int> = [];
    loop tail as b {
        mut padded.pushBack(b);
    }
    (mut padded).pushBack(128);
    loop (padded.length() % 64) =!= 56 {
        mut padded.pushBack(0);
    }
    var bitLen := totalBytes * 8;
    lenBytes: mut List<Int> = [];
    var k := 0;
    loop k < 8 {
        mut lenBytes.pushFront(bitLen % 256);
        bitLen /= 256;
        k += 1;
    }
    loop lenBytes as lb {
        mut padded.pushBack(lb);
    }
    totalPadded := padded.length();
    var pos := 0;
    loop pos < totalPadded {
        st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, padded, pos);
        h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
        h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
        pos += 64;
    }
    word32Hex(h0) + word32Hex(h1) + word32Hex(h2) + word32Hex(h3) +
    word32Hex(h4) + word32Hex(h5) + word32Hex(h6) + word32Hex(h7)
};

/** Streams raw bytes from `reader` and returns the lowercase hexadecimal SHA-256 digest. */
pub sha256Reader := fn(reader: io.Reader): (ok: Bool, hex: String, error: String) {
    if not reader.ok() {
        return (ok = false, hex = "", error = reader.error());
    }
    var h0 := 1779033703;
    var h1 := 3144134277;
    var h2 := 1013904242;
    var h3 := 2773480762;
    var h4 := 1359893119;
    var h5 := 2600822924;
    var h6 := 528734635;
    var h7 := 1541459225;
    var totalBytes := 0;
    var tail: mut List<Int> = [];
    loop true {
        chunk := reader.read(16384);
        if not reader.ok() {
            return (ok = false, hex = "", error = reader.error());
        }
        chunkLen := chunk.length();
        if chunkLen == 0 {
            if reader.atEof() { break; }
            continue;
        }
        totalBytes += chunkLen;
        var pos := 0;
        if tail.length() > 0 {
            loop tail.length() < 64 and pos < chunkLen {
                mut tail.pushBack(chunk[pos]);
                pos += 1;
            }
            if tail.length() == 64 {
                st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, tail, 0);
                h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
                h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
                tail = [];
            }
        }
        loop pos + 64 <= chunkLen {
            st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, chunk, pos);
            h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
            h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
            pos += 64;
        }
        loop pos < chunkLen {
            mut tail.pushBack(chunk[pos]);
            pos += 1;
        }
    }
    (ok = true, hex = sha256FinalizeTail(h0, h1, h2, h3, h4, h5, h6, h7, tail, totalBytes), error = "")
};

/** Returns the lowercase hexadecimal SHA-256 digest of raw `0..255` byte values. */
pub sha256Bytes := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    total := bytes.length();
    var h0 := 1779033703;
    var h1 := 3144134277;
    var h2 := 1013904242;
    var h3 := 2773480762;
    var h4 := 1359893119;
    var h5 := 2600822924;
    var h6 := 528734635;
    var h7 := 1541459225;
    var pos := 0;
    loop pos + 64 <= total {
        st := sha256Compress(h0, h1, h2, h3, h4, h5, h6, h7, bytes, pos);
        h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3;
        h4 = st.h4; h5 = st.h5; h6 = st.h6; h7 = st.h7;
        pos += 64;
    }
    tail: mut List<Int> = [];
    loop pos < total {
        mut tail.pushBack(bytes[pos]);
        pos += 1;
    }
    sha256FinalizeTail(h0, h1, h2, h3, h4, h5, h6, h7, tail, total)
};

/** Returns the lowercase hexadecimal SHA-256 digest of UTF-8 `value`. */
pub sha256Text := fn(value: String): String {
    sha256Bytes(unicode.utf8Encode(value))
};

/** Returns the lowercase hexadecimal SHA-256 digest of the raw bytes of the file at `path`. */
pub sha256File := fn(path: String): (ok: Bool, hex: String, error: String) {
    reader := file.openReader(path);
    if not reader.ok() {
        return (ok = false, hex = "", error = reader.error());
    }
    hashed := sha256Reader(reader);
    closed := reader.close();
    if not hashed.ok {
        return hashed;
    }
    if not closed.ok {
        return (ok = false, hex = "", error = closed.error);
    }
    hashed
};

/** Returns `2^bits` for unsigned 32-bit shift computations. */
pow2Arr := fn(bits: Int): Int {
    var out := 1;
    var i := 0;
    loop i < bits {
        out *= 2;
        i += 1;
    }
    out
};

/** Rotates a 64-bit word (`hi`, `lo`) right by `shift` bits. */
rotr64 := fn(hi: Int, lo: Int, shift: Int): (hi: Int, lo: Int) {
    if shift == 0 { return (hi = hi, lo = lo); }
    if shift < 32 {
        d := pow2Arr(shift);
        m := pow2Arr(32 - shift);
        return (hi = (hi / d) + (lo % d) * m, lo = (lo / d) + (hi % d) * m);
    }
    s := shift - 32;
    if s == 0 { return (hi = lo, lo = hi); }
    d := pow2Arr(s);
    m := pow2Arr(32 - s);
    (hi = (lo / d) + (hi % d) * m, lo = (hi / d) + (lo % d) * m)
};

/** Logically shifts a 64-bit word (`hi`, `lo`) right by `shift` bits (`shift < 32`). */
shr64 := fn(hi: Int, lo: Int, shift: Int): (hi: Int, lo: Int) {
    d := pow2Arr(shift);
    m := pow2Arr(32 - shift);
    (hi = hi / d, lo = (lo / d) + (hi % d) * m)
};

/** Returns the lowercase hexadecimal SHA-512 digest of raw `0..255` byte values. */
pub sha512Bytes := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    total := bytes.length();
    padded: mut List<Int> = [];
    loop bytes as b {
        mut padded.pushBack(b);
    }
    (mut padded).pushBack(128);
    loop (padded.length() % 128) =!= 112 {
        mut padded.pushBack(0);
    }
    var bitLen := total * 8;
    lenBytes: mut List<Int> = [];
    var k := 0;
    loop k < 16 {
        mut lenBytes.pushFront(bitLen % 256);
        bitLen /= 256;
        k += 1;
    }
    loop lenBytes as lb {
        mut padded.pushBack(lb);
    }

    var h0Hi := 1779033703; var h0Lo := 4089235720;
    var h1Hi := 3144134277; var h1Lo := 2227873595;
    var h2Hi := 1013904242; var h2Lo := 4271175723;
    var h3Hi := 2773480762; var h3Lo := 1595750129;
    var h4Hi := 1359893119; var h4Lo := 2917565137;
    var h5Hi := 2600822924; var h5Lo := 725511199;
    var h6Hi := 528734635; var h6Lo := 4215389547;
    var h7Hi := 1541459225; var h7Lo := 327033209;

    totalPadded := padded.length();
    var offset := 0;
    loop offset < totalPadded {
        wHi: mut List<Int> = [];
        wLo: mut List<Int> = [];
        var i := 0;
        loop i < 16 {
            p := offset + i * 8;
            mut wHi.pushBack(padded[p] * 16777216 + padded[p + 1] * 65536 + padded[p + 2] * 256 + padded[p + 3]);
            mut wLo.pushBack(padded[p + 4] * 16777216 + padded[p + 5] * 65536 + padded[p + 6] * 256 + padded[p + 7]);
            i += 1;
        }
        loop i < 80 {
            x0 := rotr64(wHi[i - 15], wLo[i - 15], 1);
            x1 := rotr64(wHi[i - 15], wLo[i - 15], 8);
            x2 := shr64(wHi[i - 15], wLo[i - 15], 7);
            s0Hi := xor3_32(x0.hi, x1.hi, x2.hi);
            s0Lo := xor3_32(x0.lo, x1.lo, x2.lo);
            y0 := rotr64(wHi[i - 2], wLo[i - 2], 19);
            y1 := rotr64(wHi[i - 2], wLo[i - 2], 61);
            y2 := shr64(wHi[i - 2], wLo[i - 2], 6);
            s1Hi := xor3_32(y0.hi, y1.hi, y2.hi);
            s1Lo := xor3_32(y0.lo, y1.lo, y2.lo);
            sumLo := wLo[i - 16] + s0Lo + wLo[i - 7] + s1Lo;
            sumHi := wHi[i - 16] + s0Hi + wHi[i - 7] + s1Hi + (sumLo / pow32);
            mut wHi.pushBack(sumHi % pow32);
            mut wLo.pushBack(sumLo % pow32);
            i += 1;
        }

        var aHi := h0Hi; var aLo := h0Lo;
        var bHi := h1Hi; var bLo := h1Lo;
        var cHi := h2Hi; var cLo := h2Lo;
        var dHi := h3Hi; var dLo := h3Lo;
        var eHi := h4Hi; var eLo := h4Lo;
        var fHi := h5Hi; var fLo := h5Lo;
        var gHi := h6Hi; var gLo := h6Lo;
        var hHi := h7Hi; var hLo := h7Lo;

        var r := 0;
        loop r < 80 {
            r14 := rotr64(eHi, eLo, 14);
            r18 := rotr64(eHi, eLo, 18);
            r41 := rotr64(eHi, eLo, 41);
            sig1Hi := xor3_32(r14.hi, r18.hi, r41.hi);
            sig1Lo := xor3_32(r14.lo, r18.lo, r41.lo);
            chHi := ch32(eHi, fHi, gHi);
            chLo := ch32(eLo, fLo, gLo);
            t1Lo := hLo + sig1Lo + chLo + k512Lo[r] + wLo[r];
            t1Hi := (hHi + sig1Hi + chHi + k512Hi[r] + wHi[r] + (t1Lo / pow32)) % pow32;
            t1LoMod := t1Lo % pow32;

            r28 := rotr64(aHi, aLo, 28);
            r34 := rotr64(aHi, aLo, 34);
            r39 := rotr64(aHi, aLo, 39);
            sig0Hi := xor3_32(r28.hi, r34.hi, r39.hi);
            sig0Lo := xor3_32(r28.lo, r34.lo, r39.lo);
            majHi := maj32(aHi, bHi, cHi);
            majLo := maj32(aLo, bLo, cLo);
            t2Lo := sig0Lo + majLo;
            t2Hi := (sig0Hi + majHi + (t2Lo / pow32)) % pow32;
            t2LoMod := t2Lo % pow32;

            hHi = gHi; hLo = gLo;
            gHi = fHi; gLo = fLo;
            fHi = eHi; fLo = eLo;
            neLo := dLo + t1LoMod;
            eHi = (dHi + t1Hi + (neLo / pow32)) % pow32;
            eLo = neLo % pow32;
            dHi = cHi; dLo = cLo;
            cHi = bHi; cLo = bLo;
            bHi = aHi; bLo = aLo;
            naLo := t1LoMod + t2LoMod;
            aHi = (t1Hi + t2Hi + (naLo / pow32)) % pow32;
            aLo = naLo % pow32;
            r += 1;
        }

        s0 := h0Lo + aLo; h0Hi = (h0Hi + aHi + (s0 / pow32)) % pow32; h0Lo = s0 % pow32;
        s1 := h1Lo + bLo; h1Hi = (h1Hi + bHi + (s1 / pow32)) % pow32; h1Lo = s1 % pow32;
        s2 := h2Lo + cLo; h2Hi = (h2Hi + cHi + (s2 / pow32)) % pow32; h2Lo = s2 % pow32;
        s3 := h3Lo + dLo; h3Hi = (h3Hi + dHi + (s3 / pow32)) % pow32; h3Lo = s3 % pow32;
        s4 := h4Lo + eLo; h4Hi = (h4Hi + eHi + (s4 / pow32)) % pow32; h4Lo = s4 % pow32;
        s5 := h5Lo + fLo; h5Hi = (h5Hi + fHi + (s5 / pow32)) % pow32; h5Lo = s5 % pow32;
        s6 := h6Lo + gLo; h6Hi = (h6Hi + gHi + (s6 / pow32)) % pow32; h6Lo = s6 % pow32;
        s7 := h7Lo + hLo; h7Hi = (h7Hi + hHi + (s7 / pow32)) % pow32; h7Lo = s7 % pow32;
        offset += 128;
    }

    word32Hex(h0Hi) + word32Hex(h0Lo) + word32Hex(h1Hi) + word32Hex(h1Lo) +
    word32Hex(h2Hi) + word32Hex(h2Lo) + word32Hex(h3Hi) + word32Hex(h3Lo) +
    word32Hex(h4Hi) + word32Hex(h4Lo) + word32Hex(h5Hi) + word32Hex(h5Lo) +
    word32Hex(h6Hi) + word32Hex(h6Lo) + word32Hex(h7Hi) + word32Hex(h7Lo)
};

/** Returns the lowercase hexadecimal SHA-512 digest of UTF-8 `value`. */
pub sha512Text := fn(value: String): String {
    sha512Bytes(unicode.utf8Encode(value))
};

/** True when `ch` is one of the 64 non-padding Base64 alphabet characters. */
isBase64DataChar := fn(ch: String): Bool {
    b64Alphabet.indexOf(ch, 0) >= 0
}

/** True when `ch` is an ASCII hexadecimal digit (`0-9`, `a-f`, `A-F`). */
isHexChar := fn(ch: String): Bool {
    "0123456789abcdefABCDEF".indexOf(ch, 0) >= 0
}

/** Computes the bitwise XOR of two byte values (`0..255`). */
byteXor := fn(left: Int, right: Int): Int {
    var a := left;
    var b := right;
    var bit := 1;
    var out := 0;
    loop bit < 256 {
        if a % 2 =!= b % 2 {
            out += bit;
        }
        a = a / 2;
        b = b / 2;
        bit *= 2;
    }
    out
}

/** Returns true when `encoded` is valid standard RFC 4648 padded base64 text. */
pub isValidBase64 := fn(encoded: String): Bool {
    size := encoded.length();
    if size == 0 { return true; }
    if size % 4 =!= 0 { return false; }
    var padding := 0;
    if encoded.at(size - 1) == "=" { padding += 1; }
    if encoded.at(size - 2) == "=" {
        if padding == 0 { return false; }
        padding += 1;
    }
    dataEnd := size - padding;
    var index := 0;
    loop index < dataEnd {
        if not isBase64DataChar(encoded.at(index)) { return false; }
        index += 1;
    }
    true
}

/** Returns true when `encoded` is valid even-length hexadecimal byte text. */
pub isValidHex := fn(encoded: String): Bool {
    size := encoded.length();
    if size % 2 =!= 0 { return false; }
    var index := 0;
    loop index < size {
        if not isHexChar(encoded.at(index)) { return false; }
        index += 1;
    }
    true
}

/** Encodes raw `0..255` byte values as standard RFC 4648 base64 text. */
pub base64Encode := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    count := bytes.length();
    parts: mut List<String> = [];
    var index := 0;
    loop index < count {
        b0 := bytes[index];
        c0 := b64Alphabet.at(b0 / 4);
        rem0 := b0 % 4;
        if index + 1 >= count {
            mut parts.pushBack(c0 + b64Alphabet.at(rem0 * 16) + "==");
            break;
        }
        b1 := bytes[index + 1];
        c1 := b64Alphabet.at(rem0 * 16 + (b1 / 16));
        rem1 := b1 % 16;
        if index + 2 >= count {
            mut parts.pushBack(c0 + c1 + b64Alphabet.at(rem1 * 4) + "=");
            break;
        }
        b2 := bytes[index + 2];
        mut parts.pushBack(c0 + c1 + b64Alphabet.at(rem1 * 4 + (b2 / 64)) + b64Alphabet.at(b2 % 64));
        index += 3;
    }
    parts.join("")
}

/** Decodes standard RFC 4648 base64 text into `0..255` byte values, faulting on malformed input. */
pub base64Decode := fn(encoded: String): List<Int> {
    if not isValidBase64(encoded) {
        diag.fail("", "invalid base64 input");
        return [];
    }
    size := encoded.length();
    var out: mut List<Int> = [];
    var index := 0;
    loop index < size {
        d0 := b64Alphabet.indexOf(encoded.at(index), 0);
        d1 := b64Alphabet.indexOf(encoded.at(index + 1), 0);
        mut out.pushBack(d0 * 4 + (d1 / 16));
        c2 := encoded.at(index + 2);
        if c2 =!= "=" {
            d2 := b64Alphabet.indexOf(c2, 0);
            mut out.pushBack((d1 % 16) * 16 + (d2 / 4));
            c3 := encoded.at(index + 3);
            if c3 =!= "=" {
                d3 := b64Alphabet.indexOf(c3, 0);
                mut out.pushBack((d2 % 4) * 64 + d3);
            }
        }
        index += 4;
    }
    out
}

/** Encodes raw `0..255` byte values as lowercase hexadecimal text. */
pub hexEncode := fn(bytes: List<Int>): String {
    checkByteRange(bytes);
    parts: mut List<String> = [];
    loop bytes as b {
        mut parts.pushBack(hexAlphabet.at(b / 16) + hexAlphabet.at(b % 16));
    }
    parts.join("")
}

/** Decodes hexadecimal text into `0..255` byte values, faulting on malformed input. */
pub hexDecode := fn(encoded: String): List<Int> {
    if not isValidHex(encoded) {
        diag.fail("", "invalid hex input");
        return [];
    }
    size := encoded.length();
    var out: mut List<Int> = [];
    var index := 0;
    loop index < size {
        hi := hexAlphabet.indexOf(encoded.at(index).toLowerAscii(), 0);
        lo := hexAlphabet.indexOf(encoded.at(index + 1).toLowerAscii(), 0);
        mut out.pushBack(hi * 16 + lo);
        index += 2;
    }
    out
}

/** Returns the lowercase hexadecimal HMAC-SHA256 tag of `data` using secret `key` bytes. */
pub hmacSha256Bytes := fn(key: List<Int>, data: List<Int>): String {
    checkByteRange(key);
    keySize := key.length();
    normalized := if keySize > 64 { hexDecode(sha256Bytes(key)) } else { key };
    var blockKey: mut List<Int> = [];
    loop normalized as b {
        mut blockKey.pushBack(b);
    }
    loop blockKey.length() < 64 {
        mut blockKey.pushBack(0);
    }
    var inner: mut List<Int> = [];
    var outer: mut List<Int> = [];
    var index := 0;
    loop index < 64 {
        kb := blockKey[index];
        mut inner.pushBack(byteXor(kb, 54));
        mut outer.pushBack(byteXor(kb, 92));
        index += 1;
    }
    loop data as b {
        mut inner.pushBack(b);
    }
    innerDigest := hexDecode(sha256Bytes(inner));
    loop innerDigest as b {
        mut outer.pushBack(b);
    }
    sha256Bytes(outer)
}
