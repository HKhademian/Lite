/* Provisional bootstrap test assertions. Not an official standard library. */

integer := import "core/int";
io := import "core/io";

/** Reports `FAIL name` and exits 2 unless `condition` is true. */
pub check := fn(name: String, condition: Bool): Unit {
    if not condition {
        io.errorLine("FAIL " + name);
        io.exit(2);
    } else { }
}

/** Checks one Int value and reports expected/actual text on failure. */
pub checkInt := fn(name: String, expected: Int, actual: Int): Unit {
    if expected =!= actual {
        io.errorLine("FAIL " + name + ": expected " + integer.intText(expected) + ", got " + integer.intText(actual));
        io.exit(2);
    } else { }
}

/** Checks one String value and reports expected/actual text on failure. */
pub checkText := fn(name: String, expected: String, actual: String): Unit {
    if expected =!= actual {
        io.errorLine("FAIL " + name + ": expected \"" + expected + "\", got \"" + actual + "\"");
        io.exit(2);
    } else { }
}

/** Checks one Bool value and reports expected/actual text on failure. */
pub checkBool := fn(name: String, expected: Bool, actual: Bool): Unit {
    if expected =!= actual {
        io.errorLine("FAIL " + name + ": expected " + (if expected { "true" } else { "false" }) +
            ", got " + (if actual { "true" } else { "false" }));
        io.exit(2);
    } else { }
}

/** Reports a successful test entry as `name: ok`. */
pub done := fn(name: String): Unit {
    io.outputLine(name + ": ok");
}
