/** Core path manipulation, traversal, and filesystem-kind query helpers. */

file := import "core/file";
io := import "core/io";
list := import "core/list";
proc := import "core/process";
text := import "core/text";

/** True when the active host platform uses Windows path rules. */
isWin32 := fn(): Bool {
    proc.platform() == "win32"
}

/** True when `ch` is a path separator under POSIX or Windows (`win`). */
isSepWith := fn(ch: String, win: Bool): Bool {
    ch == "/" or (win and ch == "\\")
}

/** Platform-native path separator (`/` on POSIX, `\` on Windows). */
pub sep := fn(): String {
    if isWin32() { return "\\"; }
    "/"
}

/** True when `ch` is a path separator for the active platform. */
pub isSep := fn(ch: String): Bool {
    isSepWith(ch, isWin32())
}

/** True when `target` is an absolute path on the active platform. */
pub isAbsolute := fn(target: String): Bool {
    size := target.length();
    if size == 0 { return false; }
    win := isWin32();
    if isSepWith(target.at(0), win) { return true; }
    win and size >= 2 and target.at(0).isAsciiLetter() and target.at(1) == ":"
}

/** Normalizes `.` and `..` segments and repeated separators in `raw`. */
pub normalize := fn(raw: String): String {
    size := raw.length();
    if size == 0 { return "."; }
    win := isWin32();
    separator := if win { "\\" } else { "/" };
    var rootPrefix := "";
    var start := 0;
    if win and size >= 2 and raw.at(0).isAsciiLetter() and raw.at(1) == ":" {
        drive := raw.slice(0, 2);
        if size >= 3 and isSepWith(raw.at(2), true) {
            rootPrefix = drive + separator;
            start = 3;
        } else {
            rootPrefix = drive;
            start = 2;
        }
    } else if isSepWith(raw.at(0), win) {
        rootPrefix = separator;
        start = 1;
    }

    parts: mut List<String> = [];
    var partsCount := 0;
    var segStart := start;
    loop segStart <= size {
        var sepPos := raw.indexOf("/", segStart);
        if win {
            bsPos := raw.indexOf("\\", segStart);
            if bsPos >= 0 and (sepPos < 0 or bsPos < sepPos) { sepPos = bsPos; }
        }
        i := if sepPos < 0 { size } else { sepPos };
        if i > segStart {
            seg := raw.slice(segStart, i);
            if seg == ".." {
                if partsCount > 0 and (rootPrefix =!= "" or parts[partsCount - 1] =!= "..") {
                    mut parts.popBack();
                    partsCount = partsCount - 1;
                } else if rootPrefix == "" {
                    mut parts.pushBack("..");
                    partsCount = partsCount + 1;
                }
            } else if seg =!= "." {
                mut parts.pushBack(seg);
                partsCount = partsCount + 1;
            }
        }
        if sepPos < 0 { break; }
        segStart = i + 1;
    }

    if partsCount == 0 {
        if rootPrefix =!= "" { return rootPrefix; }
        return ".";
    }
    rootPrefix + parts.join(separator)
}

/** Joins `baseDir` and `target` and normalizes the combined path. */
pub join := fn(baseDir: String, target: String): String {
    if baseDir == "" { return normalize(target); }
    if target == "" { return normalize(baseDir); }
    normalize(baseDir + sep() + target)
}

/** Joins all non-empty segments in `parts` and normalizes the result. */
pub joinAll := fn(parts: List<String>): String {
    var acc := "";
    var hasAny := false;
    loop parts as part {
        if part =!= "" {
            if not hasAny {
                acc = part;
                hasAny = true;
            } else {
                acc = acc + sep() + part;
            }
        }
    }
    if not hasAny { return "."; }
    normalize(acc)
}

/** Resolves `target` against `baseDir`, matching absolute-path override behavior. */
pub resolve := fn(baseDir: String, target: String): String {
    if isAbsolute(target) { return normalize(target); }
    join(baseDir, target)
}

/** Returns the parent directory of `target`. */
pub parentDir := fn(target: String): String {
    resolve(target, "..")
}

/** Returns the final path segment of `target` without any trailing extension stripping. */
pub baseName := fn(target: String): String {
    var end := target.length();
    loop end > 0 and isSep(target.at(end - 1)) {
        end = end - 1;
    }
    if end == 0 { return ""; }
    var pos := end;
    loop pos > 0 and not isSep(target.at(pos - 1)) {
        pos = pos - 1;
    }
    target.slice(pos, end)
}

/** Returns the file extension (including leading `.`) of `target`, or empty text when absent. */
pub extName := fn(target: String): String {
    base := baseName(target);
    if base == "" or base == "." or base == ".." { return ""; }
    size := base.length();
    var i := size - 1;
    loop i > 0 {
        if base.at(i) == "." {
            return base.slice(i, size);
        }
        i = i - 1;
    }
    ""
}

/** Returns the final path segment without its extension. */
pub stem := fn(target: String): String {
    base := baseName(target);
    ext := extName(target);
    if ext == "" { return base; }
    base.slice(0, base.length() - ext.length())
}

/** Returns `target` with its file extension replaced by `ext` (or stripped when `ext == ""`). */
pub withExt := fn(target: String, ext: String): String {
    base := baseName(target);
    if base == "" or base == "." or base == ".." { return target; }
    var end := target.length();
    loop end > 0 and isSep(target.at(end - 1)) {
        end = end - 1;
    }
    oldExt := extName(target);
    stemEnd := end - oldExt.length();
    prefix := target.slice(0, stemEnd);
    suffix := target.slice(end, target.length());
    if ext == "" { return prefix + suffix; }
    normalizedExt := if ext.startsWithAt(0, ".") { ext } else { "." + ext };
    prefix + normalizedExt + suffix
}

/** Splits a separator-normalized path (after its root prefix) into non-empty components. */
splitSegments := fn(normalized: String): List<String> {
    parts: mut List<String> = [];
    size := normalized.length();
    var start := 0;
    if isWin32() and size >= 2 and normalized.at(0).isAsciiLetter() and normalized.at(1) == ":" {
        if size >= 3 and isSep(normalized.at(2)) { start = 3; } else { start = 2; }
    } else if size > 0 and isSep(normalized.at(0)) {
        start = 1;
    }
    var segStart := start;
    var i := start;
    loop i <= size {
        atEnd := i == size;
        if atEnd or isSep(normalized.at(i)) {
            if i > segStart {
                mut parts.pushBack(normalized.slice(segStart, i));
            }
            segStart = i + 1;
        }
        i = i + 1;
    }
    parts
}

/** Computes the relative path from `fromDir` to `toPath`, resolving relative inputs against `proc.cwd()`. */
pub relative := fn(fromDir: String, toPath: String): String {
    cwd := proc.cwd();
    fromAbs := resolve(cwd, fromDir);
    toAbs := resolve(cwd, toPath);
    if fromAbs == toAbs { return ""; }
    fromSegs := splitSegments(fromAbs);
    toSegs := splitSegments(toAbs);
    fromLen := fromSegs.length();
    toLen := toSegs.length();
    var common := 0;
    loop common < fromLen and common < toLen and fromSegs[common] == toSegs[common] {
        common = common + 1;
    }
    out: mut List<String> = [];
    var up := common;
    loop up < fromLen {
        mut out.pushBack("..");
        up = up + 1;
    }
    var down := common;
    loop down < toLen {
        mut out.pushBack(toSegs[down]);
        down = down + 1;
    }
    if out.length() == 0 { return ""; }
    out.join(sep())
}

/** True when `target` resolves to an existing filesystem entry (file, directory, or other). */
pub exists := fn(target: String): Bool {
    file.kind(target) =!= file.FILE_KIND_MISSING
}

/** True when `target` resolves to a regular file. */
pub isFile := fn(target: String): Bool {
    file.kind(target) == file.FILE_KIND_FILE
}

/** True when `target` resolves to a directory. */
pub isDirectory := fn(target: String): Bool {
    file.kind(target) == file.FILE_KIND_DIR
}

/** Standard directory names skipped during repository path walks. */
pub defaultIgnoredDirs := fn(): List<String> {
    dirs: List<String> = ["node_modules", "dist"];
    dirs
}

/** Walks `targets` in sorted depth-first order, skipping ignored/dot directories and keeping files ending in `extension` (or all files when `extension == ""`). */
pub collectFiles := fn(baseDir: String, targets: List<String>, extension: String, ignoredNames: List<String>, skipDotEntries: Bool): List<String> {
    files: mut List<String> = [];
    stack: mut List<String> = [];
    var stackCount := 0;
    var targetIdx := targets.length() - 1;
    loop targetIdx >= 0 {
        mut stack.pushBack(resolve(baseDir, targets[targetIdx]));
        stackCount = stackCount + 1;
        targetIdx = targetIdx - 1;
    }

    loop stackCount > 0 {
        resolved := mut stack.popBack();
        stackCount = stackCount - 1;
        entryKind := file.kind(resolved);
        if entryKind == file.FILE_KIND_MISSING {
            io.errorLine("ENOENT: no such file or directory, stat '" + resolved + "'");
            io.exit(1);
        }
        if entryKind == file.FILE_KIND_DIR {
            entries := file.listDir(resolved);
            var entryIdx := entries.length() - 1;
            loop entryIdx >= 0 {
                entry := entries[entryIdx];
                isDot := skipDotEntries and entry.startsWithAt(0, ".");
                if not isDot and not ignoredNames.contains(entry) {
                    mut stack.pushBack(resolve(resolved, entry));
                    stackCount = stackCount + 1;
                }
                entryIdx = entryIdx - 1;
            }
        } else if extension == "" or resolved.endsWith(extension) {
            mut files.pushBack(resolved);
        }
    }
    files
}

/** Recursively copies `srcDir` into `dstDir`, skipping `topSkipNames` at root and `nestedSkipNames` below. */
pub copyFiltered := fn(srcDir: String, dstDir: String, topSkipNames: List<String>, nestedSkipNames: List<String>): (ok: Bool, error: String) {
    mkRoot := file.makeDir(dstDir);
    if not mkRoot.ok { return (ok = false, error = mkRoot.error); }

    srcStack: mut List<String> = [];
    dstStack: mut List<String> = [];
    depthStack: mut List<Int> = [];
    var stackCount := 0;

    mut srcStack.pushBack(srcDir);
    mut dstStack.pushBack(dstDir);
    mut depthStack.pushBack(0);
    stackCount = 1;

    loop stackCount > 0 {
        curSrc := mut srcStack.popBack();
        curDst := mut dstStack.popBack();
        curDepth := mut depthStack.popBack();
        stackCount = stackCount - 1;

        entries := file.listDir(curSrc);
        skipList := if curDepth == 0 { topSkipNames } else { nestedSkipNames };
        loop entries as entry {
            if not skipList.contains(entry) {
                nextSrc := join(curSrc, entry);
                nextDst := join(curDst, entry);
                entryKind := file.kind(nextSrc);
                if entryKind == file.FILE_KIND_DIR {
                    mkSub := file.makeDir(nextDst);
                    if not mkSub.ok { return (ok = false, error = mkSub.error); }
                    (mut srcStack).pushBack(nextSrc);
                    mut dstStack.pushBack(nextDst);
                    mut depthStack.pushBack(curDepth + 1);
                    stackCount = stackCount + 1;
                } else if entryKind == file.FILE_KIND_FILE {
                    copied := file.copy(nextSrc, nextDst);
                    if not copied.ok { return (ok = false, error = copied.error); }
                }
            }
        }
    }
    (ok = true, error = "")
}
