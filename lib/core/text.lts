/* Provisional bootstrap text support. Not an official standard library. */

integer := import "core/int";
host := import "core/text-host";

/** True when `text` is exactly one ASCII decimal digit. */
pub isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

/** Numeric value of one checked ASCII decimal digit. */
pub digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

/** True for one ASCII letter, `a`-`z` or `A`-`Z`. */
pub isAsciiLetter := fn(ch: String): Bool {
    or ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" or ch == "f" or ch == "g"
    or ch == "h" or ch == "i" or ch == "j" or ch == "k" or ch == "l" or ch == "m" or ch == "n"
    or ch == "o" or ch == "p" or ch == "q" or ch == "r" or ch == "s" or ch == "t" or ch == "u"
    or ch == "v" or ch == "w" or ch == "x" or ch == "y" or ch == "z"
    or ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" or ch == "F" or ch == "G"
    or ch == "H" or ch == "I" or ch == "J" or ch == "K" or ch == "L" or ch == "M" or ch == "N"
    or ch == "O" or ch == "P" or ch == "Q" or ch == "R" or ch == "S" or ch == "T" or ch == "U"
    or ch == "V" or ch == "W" or ch == "X" or ch == "Y" or ch == "Z"
}

/** True for an ASCII identifier start or underscore accepted by the compiler subset. */
pub isNameStart := fn(ch: String): Bool {
    isAsciiLetter(ch) or ch == "_"
}

/** True for an identifier continuation character. */
pub isNameContinue := fn(ch: String): Bool {
    isNameStart(ch) or isDigit(ch)
}

/** Returns the first position at or after `start` that is not Lite whitespace. */
pub skipSpaces := fn(source: String, start: Int): Int {
    size := host.length(source);
    var position := start;
    loop position < size {
        ch := host.at(source, position);
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            position = position + 1;
        } else {
            return position;
        }
    }
    position
}

/** Returns the position after the identifier run starting at `start`. */
pub skipName := fn(source: String, start: Int): Int {
    size := host.length(source);
    var position := start;
    loop position < size and isNameContinue(host.at(source, position)) {
        position = position + 1;
    }
    position
}

/** True when `text` occurs at `position` and stays inside `source`. */
pub startsWithAt := fn(source: String, position: Int, text: String): Bool {
    width := host.length(text);
    size := host.length(source);
    if position < 0 or position + width > size { return false; }
    if width == 0 { return true; }
    if host.at(source, position) =!= host.at(text, 0) { return false; }
    if width == 1 { return true; }
    host.slice(source, position, position + width) == text
}

/** True when the whole identifier `word` occurs at `position`, not a longer identifier that merely starts with it. */
pub wordAt := fn(source: String, position: Int, word: String): Bool {
    if not startsWithAt(source, position, word) { return false; }
    after := position + host.length(word);
    after >= host.length(source) or not isNameContinue(host.at(source, after))
}

/** Returns the first index at or after `start` where `needle` occurs, or -1 when absent. */
pub indexOfText := fn(source: String, needle: String, start: Int): Int {
    size := host.length(source);
    width := host.length(needle);
    var position := start;
    if position < 0 or position > size { return -1; }
    if width == 0 { return position; }
    first := host.at(needle, 0);
    if width == 1 {
        loop position < size {
            if host.at(source, position) == first { return position; }
            position = position + 1;
        }
        return -1;
    }
    loop position + width <= size {
        if host.at(source, position) == first and startsWithAt(source, position, needle) { return position; }
        position = position + 1;
    }
    -1
}

/** Joins text values in list order with `separator` between adjacent values. */
pub joinTexts := fn(values: List<String>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = value;
            first = false;
        } else {
            result = result + separator + value;
        }
    }
    result
}

/** Parses optional-sign decimal Int64 text; `ok` is false for empty, malformed or out-of-range text. */
pub textToInt := fn(text: String): (value: Int, ok: Bool) {
    size := host.length(text);
    if size == 0 { return (value = 0, ok = false); }
    var position := 0;
    var negative := false;
    if host.at(text, 0) == "-" {
        negative = true;
        position = 1;
    } else if host.at(text, 0) == "+" {
        position = 1;
    }
    if position >= size { return (value = 0, ok = false); }
    var value := 0;
    loop position < size {
        ch := host.at(text, position);
        if not isDigit(ch) { return (value = 0, ok = false); }
        digit := digitValue(ch);
        if negative {
            if value < (integer.intMin() + digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 - digit;
        } else {
            if value > (integer.intMax() - digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 + digit;
        }
        position = position + 1;
    }
    (value = value, ok = true)
}

/** Returns Unicode scalar count for one text value. */
pub length := fn(text: String): Int { host.length(text) }

/** Returns the Unicode scalar at a zero-based position, faulting outside the text. */
pub at := fn(text: String, position: Int): String { host.at(text, position) }

/** Returns the half-open Unicode scalar interval `[start, end)`, faulting outside the text. */
pub slice := fn(text: String, start: Int, end: Int): String { host.slice(text, start, end) }

/** True when `ch` is Lite ASCII whitespace (` `, `\\t`, `\\r`, or `\\n`). */
pub isWhitespace := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
}

/** Returns `source` with leading Lite ASCII whitespace removed. */
pub trimStart := fn(source: String): String {
    size := host.length(source);
    var start := 0;
    loop start < size and isWhitespace(host.at(source, start)) {
        start = start + 1;
    }
    host.slice(source, start, size)
}

/** Returns `source` with trailing Lite ASCII whitespace removed. */
pub trimEnd := fn(source: String): String {
    var end := host.length(source);
    loop end > 0 and isWhitespace(host.at(source, end - 1)) {
        end = end - 1;
    }
    host.slice(source, 0, end)
}

/** Returns `source` with both leading and trailing Lite ASCII whitespace removed. */
pub trim := fn(source: String): String {
    trimEnd(trimStart(source))
}

/** True when `source` ends with `suffix`. */
pub endsWith := fn(source: String, suffix: String): Bool {
    sourceLen := host.length(source);
    suffixLen := host.length(suffix);
    if suffixLen > sourceLen { return false; }
    startsWithAt(source, sourceLen - suffixLen, suffix)
}

/** Returns `value` repeated `count` times, or empty text when `count <= 0`. */
pub repeatText := fn(value: String, count: Int): String {
    if count <= 0 { return ""; }
    var out := "";
    var i := 0;
    loop i < count {
        out = out + value;
        i = i + 1;
    }
    out
}
