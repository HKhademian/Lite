/* Core explicit optional value (`Option<T>`) with niche-packed C11 layout when `T` has spare bit patterns. */

diag := import "core/diag";

/** Explicit optional value: `.None` when absent, `.Some(value)` when present. */
pub Option := enum<T: Type> {
    None;
    Some(T);
};

/** True when `opt` holds `.Some(...)`. */
pub Option.isSome := fn<T: Type>(opt: Self<T>): Bool {
    match opt {
        Option<T>.None { false }
        Option<T>.Some(_) { true }
    }
};

/** True when `opt` holds `.None`. */
pub Option.isNone := fn<T: Type>(opt: Self<T>): Bool {
    match opt {
        Option<T>.None { true }
        Option<T>.Some(_) { false }
    }
};

/** Returns the wrapped value when `.Some(v)`, or `fallback` when `.None`. */
pub Option.unwrapOr := fn<T: Type>(opt: Self<T>, fallback: T): T {
    match opt {
        Option<T>.None { fallback }
        Option<T>.Some(v) { v }
    }
};

/** Returns the wrapped value when `.Some(v)`, or exits with `message` when `.None`. */
pub Option.expect := fn<T: Type>(opt: Self<T>, message: String): T {
    match opt {
        Option<T>.None {
            diag.fail("Option", message);
        }
        Option<T>.Some(v) {
            return v;
        }
    }
    var fallback: T;
    fallback
};
