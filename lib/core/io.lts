/* Provisional core host signatures and target-independent synchronous streams. This module adds no host authority by itself. */

list := import "core/list";
unicode := import "core/unicode";

/** Handle to a synchronous byte/text input source (`"stdin"`, `"buffer"`, `"file"`, or `"error"`). */
pub Reader := type (kind: String, handle: Int);

/** Handle to a synchronous byte/text output sink (`"stdout"`, `"stderr"`, `"buffer"`, `"file"`, or `"error"`). */
pub Writer := type (kind: String, handle: Int);

/** ASCII line-feed byte (`\n`). */
BYTE_LF := 10;

/** ASCII carriage-return byte (`\r`). */
BYTE_CR := 13;

/** Synchronous read chunk size in bytes for whole-stream reads and copies. */
READ_CHUNK_BYTES := 65536;

/** Number of bytes read per step when scanning a single line. */
READ_LINE_STEP_BYTES := 1;

/** Writes display values to the host output stream without adding a newline. */
pub output := fn(...values): Unit;

/** Writes display values to the host output stream followed by one newline. */
pub outputLine := fn(...values): Unit;

/** Writes one message to the host error stream followed by one newline. */
pub errorLine := fn(text: String): Unit;

/** Returns the command-line arguments following the generated program entry. */
pub inputArgs := fn(): List<String>;

/** Reads all remaining standard input; `prompt` is optional at call sites, but this provisional declaration cannot express that yet. */
pub inputAll := fn(prompt: String): String;

/** Reads one input line; `prompt` is optional at call sites, but this provisional declaration cannot express that yet. */
pub inputLine := fn(prompt: String): String;

/** Reads one signed Int token; `prompt` is optional at call sites, but this provisional declaration cannot express that yet. */
pub inputInt := fn(prompt: String): Int;

/** Reads one finite Float token; `prompt` is optional at call sites, but this provisional declaration cannot express that yet. */
pub inputFloat := fn(prompt: String): Float;

/** Terminates the generated program with `status`. */
pub exit := fn(status: Int): Unit;

/** Returns the shared synchronous standard-input `Reader`. */
pub stdinReader := fn(): Reader;

/** Returns the shared synchronous standard-output `Writer`. */
pub stdoutWriter := fn(): Writer;

/** Returns the shared synchronous standard-error `Writer`. */
pub stderrWriter := fn(): Writer;

/** Creates an in-memory `Reader` backed by raw `0..255` byte values. */
pub bufferReader := fn(bytes: List<Int>): Reader;

/** Creates an in-memory `Reader` backed by UTF-8 bytes of `text`. */
pub textReader := fn(text: String): Reader {
    bufferReader(unicode.utf8Encode(text))
}

/** Creates an in-memory `Writer` accumulating written bytes. */
pub bufferWriter := fn(): Writer;

/** Returns raw `0..255` byte values currently accumulated in buffer `writer`. */
pub writerBytes := fn(writer: Writer): List<Int>;

/** Decodes accumulated bytes in buffer `writer` as strict UTF-8 text. */
pub writerText := fn(writer: Writer): (ok: Bool, text: String, error: String);

/** Clears accumulated bytes in buffer `writer`. */
pub clearWriter := fn(writer: Writer): Unit;

/** True when `reader` is open and has no recorded error. */
pub readerOk := fn(reader: Reader): Bool;

/** True when `reader` has reached end-of-stream. */
pub readerAtEof := fn(reader: Reader): Bool;

/** Returns the recorded error message on `reader`, or empty text. */
pub readerError := fn(reader: Reader): String;

/** Reads up to `maxBytes` bytes synchronously from `reader`, returning `[]` on EOF or error. */
pub read := fn(reader: Reader, maxBytes: Int): List<Int>;

/** Decodes accumulated line bytes as strict UTF-8 into a single `readLine` result record. */
decodeLineBytes := fn(lineBytes: List<Int>): (ok: Bool, line: String, eof: Bool, error: String) {
    decoded := unicode.utf8DecodeStrict(lineBytes);
    if not decoded.ok {
        return (ok = false, line = "", eof = false, error = decoded.error);
    }
    (ok = true, line = decoded.text, eof = false, error = "")
}

/** Reads all remaining bytes synchronously from `reader`. */
pub readAll := fn(reader: Reader): List<Int> {
    if not readerOk(reader) { return []; }
    out: mut List<Int> = [];
    loop readerOk(reader) and not readerAtEof(reader) {
        chunk := read(reader, 65536);
        if not readerOk(reader) { return []; }
        if list.listCountInt(chunk) == 0 { break; }
        loop chunk as byte {
            list.pushBack(mut out, byte);
        }
    }
    out
}

/** Reads all remaining bytes synchronously from `reader` and decodes strict UTF-8 text. */
pub readAllText := fn(reader: Reader): (ok: Bool, text: String, error: String) {
    if not readerOk(reader) {
        return (ok = false, text = "", error = readerError(reader));
    }
    bytes := readAll(reader);
    if not readerOk(reader) {
        return (ok = false, text = "", error = readerError(reader));
    }
    unicode.utf8DecodeStrict(bytes)
}

/** Reads one line synchronously from `reader`, stripping trailing `\n` or `\r\n`. */
pub readLine := fn(reader: Reader): (ok: Bool, line: String, eof: Bool, error: String) {
    if not readerOk(reader) {
        return (ok = false, line = "", eof = false, error = readerError(reader));
    }
    lineBytes: mut List<Int> = [];
    loop not readerAtEof(reader) {
        chunk := read(reader, 1);
        if not readerOk(reader) {
            return (ok = false, line = "", eof = false, error = readerError(reader));
        }
        if list.listCountInt(chunk) == 0 { break; }
        nextByte := chunk[0];
        if nextByte == 10 {
            count := list.listCountInt(lineBytes);
            if count > 0 and lineBytes[count - 1] == 13 {
                list.popBack(mut lineBytes);
            }
            return decodeLineBytes(lineBytes);
        }
        list.pushBack(mut lineBytes, nextByte);
    }
    if list.listCountInt(lineBytes) == 0 {
        return (ok = true, line = "", eof = true, error = "");
    }
    decodeLineBytes(lineBytes)
}

/** Closes `reader` when backed by an owned resource. */
pub closeReader := fn(reader: Reader): (ok: Bool, error: String);

/** True when `writer` is open and has no recorded error. */
pub writerOk := fn(writer: Writer): Bool;

/** Returns the recorded error message on `writer`, or empty text. */
pub writerError := fn(writer: Writer): String;

/** Writes raw `0..255` byte values synchronously to `writer`. */
pub write := fn(writer: Writer, bytes: List<Int>): (ok: Bool, written: Int, error: String);

/** Writes UTF-8 `text` synchronously to `writer`. */
pub writeText := fn(writer: Writer, text: String): (ok: Bool, error: String) {
    res := write(writer, unicode.utf8Encode(text));
    (ok = res.ok, error = res.error)
}

/** Writes UTF-8 `text` followed by `\n` synchronously to `writer`. */
pub writeLine := fn(writer: Writer, text: String): (ok: Bool, error: String) {
    writeText(writer, text + "\n")
}

/** Flushes buffered output on `writer` if supported. */
pub flush := fn(writer: Writer): (ok: Bool, error: String);

/** Closes `writer` when backed by an owned resource. */
pub closeWriter := fn(writer: Writer): (ok: Bool, error: String);

/** Writes `bytes` to `writer` and closes the stream, returning any write or close error. */
pub writeAndClose := fn(writer: Writer, bytes: List<Int>): (ok: Bool, error: String) {
    if not writerOk(writer) {
        return (ok = false, error = writerError(writer));
    }
    wrote := write(writer, bytes);
    closed := closeWriter(writer);
    if not wrote.ok {
        return (ok = false, error = wrote.error);
    }
    if not closed.ok {
        return (ok = false, error = closed.error);
    }
    (ok = true, error = "")
}

/** Streams all remaining bytes synchronously from `reader` into `writer`. */
pub copyStream := fn(reader: Reader, writer: Writer): (ok: Bool, copied: Int, error: String) {
    if not readerOk(reader) {
        return (ok = false, copied = 0, error = readerError(reader));
    }
    if not writerOk(writer) {
        return (ok = false, copied = 0, error = writerError(writer));
    }
    var total := 0;
    loop readerOk(reader) and not readerAtEof(reader) {
        chunk := read(reader, 65536);
        err := readerError(reader);
        if err =!= "" {
            return (ok = false, copied = total, error = err);
        }
        if list.listCountInt(chunk) == 0 { break; }
        wrote := write(writer, chunk);
        if not wrote.ok {
            return (ok = false, copied = total, error = wrote.error);
        }
        total += wrote.written;
    }
    (ok = true, copied = total, error = "")
}
