/* List-backed O(n) nominal text builder utility. Zero-initialize with `mut b: tb.TextBuilder;`. */

/** Buffered string builder backed by a list of chunks and a single final concatenation. */
pub TextBuilder := record {
    chunks: List<String>;
};

/** Appends a non-empty chunk to `b` in amortized O(1). */
pub TextBuilder.append := fn(b: mut Self, chunk: String): Unit {
    if chunk =!= "" {
        mut b.chunks.pushBack(chunk);
    }
};

/** Appends `line` followed by a newline (`\\n`) to `b` in amortized O(1). */
pub TextBuilder.appendLine := fn(b: mut Self, line: String): Unit {
    if line =!= "" {
        mut b.chunks.pushBack(line);
    }
    mut b.chunks.pushBack("\n");
};

/** Materializes all buffered chunks into one String via a single O(n) pass. */
pub TextBuilder.build := fn(b: Self): String {
    b.chunks.join("")
};

/** Materializes all buffered chunks joined by `separator` via a single O(n) pass. */
pub TextBuilder.buildJoined := fn(b: Self, separator: String): String {
    b.chunks.join(separator)
};

/** Returns the number of buffered chunks currently stored in `b`. */
pub TextBuilder.count := fn(b: Self): Int {
    b.chunks.length()
};

/** Removes all buffered chunks from `b` so it can be reused. */
pub TextBuilder.clear := fn(b: mut Self): Unit {
    mut b.chunks.clear();
};
