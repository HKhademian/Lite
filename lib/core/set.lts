/* Provisional bootstrap set support. Not an official standard library. */

/** Registered set mutation intrinsic; inserts `value` into `s` in O(1). */
pub add := fn<T>(s: mut Set<T>, value: T): Unit;

/** Registered set membership intrinsic; true when `s` contains `value` in O(1). */
pub has := fn<T>(s: Set<T>, value: T): Bool;

/** Registered set mutation intrinsic; removes `value` and returns true when it was present in O(1). */
pub remove := fn<T>(s: mut Set<T>, value: T): Bool;

/** Registered set size intrinsic; returns the number of elements in O(1). */
pub size := fn<T>(s: Set<T>): Int;

/** Registered set mutation intrinsic; removes all elements in O(1). */
pub clear := fn<T>(s: mut Set<T>): Unit;

/** Registered set values intrinsic; returns all elements in insertion order in O(n). */
pub values := fn<T>(s: Set<T>): List<T>;
