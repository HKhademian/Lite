/* Provisional Unicode scalar bridge primitives and pure-Lite UTF-8/UTF-16/UTF-32 codecs. */

integer := import "core/int";
list := import "core/list";
textLib := import "core/text";

/** Maximum valid Unicode scalar code point (`U+10FFFF`). */
pub UNICODE_MAX_SCALAR := 1114111;

/** Unicode replacement character (`U+FFFD`) substituted in lossy decoding. */
pub UNICODE_REPLACEMENT_CHAR := 65533;

/** Maximum code point representable as a single UTF-16 code unit (`U+FFFF`). */
UTF16_BMP_MAX := 65535;

/** Base scalar offset above the Basic Multilingual Plane (`U+10000`). */
UTF16_SUPPLEMENTARY_BASE := 65536;

/** First UTF-16 high-surrogate code unit (`0xD800`). */
UTF16_HIGH_SURROGATE_START := 55296;

/** Last UTF-16 high-surrogate code unit (`0xDBFF`). */
UTF16_HIGH_SURROGATE_END := 56319;

/** First UTF-16 low-surrogate code unit (`0xDC00`). */
UTF16_LOW_SURROGATE_START := 56320;

/** Last UTF-16 low-surrogate code unit (`0xDFFF`). */
UTF16_LOW_SURROGATE_END := 57343;

/** Radix multiplier (`2^10`) splitting a 20-bit supplementary offset into surrogates. */
UTF16_SURROGATE_SHIFT := 1024;

/** Maximum single-byte ASCII scalar (`0x7F`). */
UTF8_ASCII_MAX := 127;

/** Minimum UTF-8 continuation byte (`0x80`). */
UTF8_CONT_MIN := 128;

/** Maximum UTF-8 continuation byte (`0xBF`). */
UTF8_CONT_MAX := 191;

/** UTF-8 two-byte lead byte prefix (`0xC0`) and minimum valid lead (`0xC2`). */
UTF8_2BYTE_LEAD_BASE := 192;
UTF8_2BYTE_LEAD_MIN := 194;

/** Maximum scalar encodable in two UTF-8 bytes (`U+07FF`). */
UTF8_2BYTE_MAX := 2047;

/** UTF-8 three-byte lead byte range (`0xE0..0xEF`) and restricted continuation bounds. */
UTF8_3BYTE_LEAD_BASE := 224;
UTF8_3BYTE_LEAD_MAX := 239;
UTF8_3BYTE_LOW_CONT := 160;
UTF8_SURROGATE_LEAD := 237;
UTF8_3BYTE_SURROGATE_MAX_CONT := 159;

/** UTF-8 four-byte lead byte range (`0xF0..0xF4`) and restricted continuation bounds. */
UTF8_4BYTE_LEAD_BASE := 240;
UTF8_4BYTE_LEAD_MAX := 244;
UTF8_4BYTE_LOW_CONT := 144;
UTF8_4BYTE_HIGH_CONT := 143;

/** Maximum valid raw byte value (`0xFF`). */
BYTE_MAX := 255;

/** Maximum valid UTF-16 code unit (`0xFFFF`). */
UTF16_UNIT_MAX := 65535;

/** Returns the UTF-32 Unicode scalar code point list of `text`. */
pub toCodePoints := fn(text: String): List<Int>;

/** Encodes UTF-32 Unicode scalar code points into text, rejecting invalid scalar values or surrogates. */
pub fromCodePoints := fn(points: List<Int>): (ok: Bool, text: String, error: String);

/** Returns true when `point` is a valid Unicode scalar value (`0..0x10FFFF` excluding surrogates `0xD800..0xDFFF`). */
pub isValidScalar := fn(point: Int): Bool {
    point >= 0 and point <= 1114111 and (point < 55296 or point > 57343)
}

/** Encodes a single Unicode scalar code point into a one-character string when valid. */
pub fromCodePoint := fn(point: Int): (ok: Bool, text: String, error: String) {
    points: List<Int> = [point];
    fromCodePoints(points)
}

/** Returns the Unicode scalar code point at zero-based scalar index `position`. */
pub codePointAt := fn(text: String, position: Int): Int {
    ch := textLib.at(text, position);
    points := toCodePoints(ch);
    points[0]
}

/** Returns the number of UTF-16 code units in `text`. */
pub utf16Length := fn(text: String): Int {
    var total := 0;
    loop toCodePoints(text) as cp {
        total += if cp <= 65535 { 1 } else { 2 };
    }
    total
}

/** Encodes `text` as UTF-16 `0..65535` code unit values. */
pub utf16Encode := fn(text: String): List<Int> {
    var out: mut List<Int> = [];
    loop toCodePoints(text) as cp {
        if cp <= 65535 {
            list.pushBack(mut out, cp);
        } else {
            adjusted := cp - 65536;
            list.pushBack(mut out, 55296 + (adjusted / 1024));
            list.pushBack(mut out, 56320 + (adjusted % 1024));
        }
    }
    out
}

/** Decodes UTF-16 `0..65535` code units to text, rejecting out-of-range values or unpaired surrogates. */
pub utf16DecodeStrict := fn(units: List<Int>): (ok: Bool, text: String, error: String) {
    count := list.listCountInt(units);
    var points: mut List<Int> = [];
    var index := 0;
    loop index < count {
        code := units[index];
        if code < 0 or code > 65535 {
            return (ok = false, text = "", error = "UTF-16 code unit outside 0..65535: " + integer.intText(code));
        }
        if code >= 55296 and code <= 56319 {
            if index + 1 >= count {
                return (ok = false, text = "", error = "unpaired UTF-16 high surrogate");
            }
            next := units[index + 1];
            if next < 56320 or next > 57343 {
                return (ok = false, text = "", error = "unpaired UTF-16 high surrogate");
            }
            list.pushBack(mut points, 65536 + (code - 55296) * 1024 + (next - 56320));
            index += 2;
        } else if code >= 56320 and code <= 57343 {
            return (ok = false, text = "", error = "unpaired UTF-16 low surrogate");
        } else {
            list.pushBack(mut points, code);
            index += 1;
        }
    }
    fromCodePoints(points)
}

/** Encodes `text` as UTF-8 `0..255` byte values. */
pub utf8Encode := fn(text: String): List<Int> {
    var out: mut List<Int> = [];
    loop toCodePoints(text) as cp {
        if cp <= 127 {
            list.pushBack(mut out, cp);
        } else if cp <= 2047 {
            list.pushBack(mut out, 192 + (cp / 64));
            list.pushBack(mut out, 128 + (cp % 64));
        } else if cp <= 65535 {
            list.pushBack(mut out, 224 + (cp / 4096));
            list.pushBack(mut out, 128 + ((cp / 64) % 64));
            list.pushBack(mut out, 128 + (cp % 64));
        } else {
            list.pushBack(mut out, 240 + (cp / 262144));
            list.pushBack(mut out, 128 + ((cp / 4096) % 64));
            list.pushBack(mut out, 128 + ((cp / 64) % 64));
            list.pushBack(mut out, 128 + (cp % 64));
        }
    }
    out
}

/** Decodes UTF-8 `bytes`, either failing on invalid sequences (`strict`) or substituting U+FFFD. */
utf8DecodeInternal := fn(bytes: List<Int>, strict: Bool): (ok: Bool, text: String, error: String) {
    count := list.listCountInt(bytes);
    var points: mut List<Int> = [];
    var needed := 0;
    var seen := 0;
    var codePoint := 0;
    var lowerBoundary := 128;
    var upperBoundary := 191;
    var index := 0;
    loop index < count {
        b := bytes[index];
        if b < 0 or b > 255 {
            if strict {
                return (ok = false, text = "", error = "byte value outside 0..255: " + integer.intText(b));
            }
            codePoint = 0;
            needed = 0;
            seen = 0;
            lowerBoundary = 128;
            upperBoundary = 191;
            list.pushBack(mut points, 65533);
            index += 1;
        } else if needed == 0 {
            if b <= 127 {
                list.pushBack(mut points, b);
            } else if b >= 194 and b <= 223 {
                needed = 1;
                codePoint = b - 192;
            } else if b >= 224 and b <= 239 {
                if b == 224 { lowerBoundary = 160; }
                if b == 237 { upperBoundary = 159; }
                needed = 2;
                codePoint = b - 224;
            } else if b >= 240 and b <= 244 {
                if b == 240 { lowerBoundary = 144; }
                if b == 244 { upperBoundary = 143; }
                needed = 3;
                codePoint = b - 240;
            } else {
                if strict {
                    return (ok = false, text = "", error = "invalid UTF-8 lead byte");
                }
                list.pushBack(mut points, 65533);
            }
            index += 1;
        } else if b < lowerBoundary or b > upperBoundary {
            if strict {
                return (ok = false, text = "", error = "invalid UTF-8 continuation byte");
            }
            codePoint = 0;
            needed = 0;
            seen = 0;
            lowerBoundary = 128;
            upperBoundary = 191;
            list.pushBack(mut points, 65533);
        } else {
            lowerBoundary = 128;
            upperBoundary = 191;
            codePoint = codePoint * 64 + (b - 128);
            seen += 1;
            if seen == needed {
                list.pushBack(mut points, codePoint);
                codePoint = 0;
                needed = 0;
                seen = 0;
            }
            index += 1;
        }
    }
    if needed > 0 {
        if strict {
            return (ok = false, text = "", error = "truncated UTF-8 sequence");
        }
        list.pushBack(mut points, 65533);
    }
    fromCodePoints(points)
}

/** Decodes raw `0..255` UTF-8 bytes to text, rejecting invalid byte values or invalid UTF-8 sequences. */
pub utf8DecodeStrict := fn(bytes: List<Int>): (ok: Bool, text: String, error: String) {
    utf8DecodeInternal(bytes, true)
}

/** Decodes raw `0..255` UTF-8 bytes to text, replacing malformed byte sequences with U+FFFD. */
pub utf8DecodeLossy := fn(bytes: List<Int>): String {
    utf8DecodeInternal(bytes, false).text
}

/** Returns true when `bytes` is a valid `0..255` byte list forming strict UTF-8. */
pub isValidUtf8 := fn(bytes: List<Int>): Bool {
    utf8DecodeStrict(bytes).ok
}
