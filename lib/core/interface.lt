/* Core open nominal interface contracts for allocation, logging, and indexed access. */

/** Explicit byte-buffer allocator interface with reset capability. */
pub Allocator := interface {
    alloc: fn(self: mut Self, bytes: Int): List<UInt8>;
    reset: fn(self: mut Self): Unit;
};

/** Structured message logger interface. */
pub Logger := interface {
    log: fn(self: mut Self, level: String, msg: String): Unit;
};

/** Read-only key-to-value indexed lookup contract (`container[key]`). */
pub Index := interface<K: Type, V: Type> {
    getIndex: fn(self: Self, key: K): V;
};

/** Mutable key-to-value indexed update contract (`container[key] = value`). */
pub IndexMut := interface<K: Type, V: Type> {
    setIndex: fn(self: mut Self, key: K, value: V): Unit;
};

/** Half-open integer index range `[start..end)` passed to `Index<Range, R>` containers. */
pub Range := record {
    start: Int;
    end: Int;
};

/** Built-in indexed read conformance for `List<T>` (`fn<C: Type<Index<Int, T>>>`). */
pub impl<T: Type> Index<Int, T> for List<T> {
    getIndex := fn(self: Self, key: Int): T { self[key] };
};

/** Built-in indexed write conformance for `List<T>` (`fn<C: Type<IndexMut<Int, T>>>`). */
pub impl<T: Type> IndexMut<Int, T> for List<T> {
    setIndex := fn(self: mut Self, key: Int, value: T): Unit { self[key] = value; };
};

/** Built-in indexed read conformance for fixed arrays `[T; N]` (`fn<C: Type<Index<Int, T>>>`). */
pub impl<T: Type, N: Int> Index<Int, T> for [T; N] {
    getIndex := fn(self: Self, key: Int): T { self[key] };
};

/** Built-in indexed write conformance for fixed arrays `[T; N]` (`fn<C: Type<IndexMut<Int, T>>>`). */
pub impl<T: Type, N: Int> IndexMut<Int, T> for [T; N] {
    setIndex := fn(self: mut Self, key: Int, value: T): Unit { self[key] = value; };
};
