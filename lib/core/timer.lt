/** Nominal fixed-timestep accumulators, cooldowns, and monotonic stopwatches (`core/timer`). */

time := import "core/time";

/** Fixed-timestep accumulator state for deterministic simulation updates (UPS). */
pub StepClock := record {
    stepSec: Float;
    maxDeltaSec: Float;
    accumulatorSec: Float;
    totalSteps: Int;
    lastSteps: Int;
    alpha: Float;
}

/** Nominal cooldown timer state. */
pub Cooldown := record {
    durationSec: Float;
    remainingSec: Float;
    fired: Bool;
}

/** Nominal monotonic wall-clock stopwatch. */
pub Stopwatch := record {
    startNs: Int;
    lastLapNs: Int;
    lastLapMs: Float;
}

/* ============================================================================
 * Fixed-timestep accumulator (StepClock)
 * ============================================================================ */

/** Creates a fixed-timestep accumulator for `ups` updates per second (clamping frame deltas to `maxDeltaSec`). */
pub StepClock.create := fn(ups: Float, maxDeltaSec: Float): Self {
    rate := if ups <= 0.0 { 60.0 } else { ups };
    cap := if maxDeltaSec <= 0.0 { 0.1 } else { maxDeltaSec };
    Self {
    stepSec = 1.0 / rate,
    maxDeltaSec = cap,
    accumulatorSec = 0.0,
    totalSteps = 0,
    lastSteps = 0,
    alpha = 0.0
    }
};

/** Advances `clock` by `deltaSec`, updating `lastSteps`, `totalSteps`, and render interpolation `alpha` (`0..1`). */
pub StepClock.advance := fn(clock: mut Self, deltaSec: Float): Unit {
    clamped := if deltaSec < 0.0 { 0.0 } else if deltaSec > clock.maxDeltaSec { clock.maxDeltaSec } else { deltaSec };
    var acc := clock.accumulatorSec + clamped;
    var steps := 0;
    loop acc >= clock.stepSec and steps < 32 {
        acc = acc - clock.stepSec;
        steps += 1;
    }
    clock.accumulatorSec = acc;
    clock.totalSteps = clock.totalSteps + steps;
    clock.lastSteps = steps;
    clock.alpha = if clock.stepSec > 0.0 { acc / clock.stepSec } else { 0.0 };
};

/** Resets `clock`'s accumulator and step counters to zero. */
pub StepClock.reset := fn(clock: mut Self): Unit {
    clock.accumulatorSec = 0.0;
    clock.totalSteps = 0;
    clock.lastSteps = 0;
    clock.alpha = 0.0;
};

/* ============================================================================
 * Cooldown timer (Cooldown)
 * ============================================================================ */

/** Creates a cooldown timer with `durationSec` (ready immediately when `startReady` is true). */
pub Cooldown.create := fn(durationSec: Float, startReady: Bool): Self {
    dur := if durationSec < 0.0 { 0.0 } else { durationSec };
    Self { durationSec = dur, remainingSec = if startReady { 0.0 } else { dur }, fired = false }
};

/** True when `cd` has cooled down and is ready to fire. */
pub Cooldown.isReady := fn(cd: Self): Bool {
    cd.remainingSec <= 0.0
};

/** Advances `cd` by `deltaSec`, clamping remaining time at `0.0`. */
pub Cooldown.tick := fn(cd: mut Self, deltaSec: Float): Unit {
    dt := if deltaSec < 0.0 { 0.0 } else { deltaSec };
    rem := cd.remainingSec - dt;
    cd.remainingSec = if rem < 0.0 { 0.0 } else { rem };
    cd.fired = false;
};

/** Attempts to fire `cd`; if ready, resets `remainingSec = durationSec`, sets `fired = true`, and returns `true`. */
pub Cooldown.trigger := fn(cd: mut Self): Bool {
    if cd.remainingSec > 0.0 {
        cd.fired = false;
        return false;
    }
    cd.remainingSec = cd.durationSec;
    cd.fired = true;
    true
};

/** Returns cooldown completion progress in `0.0..1.0` (`1.0` = ready). */
pub Cooldown.progress := fn(cd: Self): Float {
    if cd.durationSec <= 0.0 or cd.remainingSec <= 0.0 { return 1.0; }
    p := 1.0 - (cd.remainingSec / cd.durationSec);
    if p < 0.0 { 0.0 } else if p > 1.0 { 1.0 } else { p }
};

/* ============================================================================
 * Monotonic Stopwatch (Stopwatch)
 * ============================================================================ */

/** Starts a new monotonic wall-clock stopwatch. */
pub Stopwatch.start := fn(): Self {
    now := time.monotonicNs();
    Self { startNs = now, lastLapNs = now, lastLapMs = 0.0 }
};

/** Returns elapsed milliseconds since `sw` was started. */
pub Stopwatch.elapsedMs := fn(sw: Self): Float {
    (time.monotonicNs() - sw.startNs) / 1000000.0
};

/** Records a lap and stores/returns milliseconds since the previous lap in `lastLapMs`. */
pub Stopwatch.lap := fn(sw: mut Self): Float {
    now := time.monotonicNs();
    lapMs := (now - sw.lastLapNs) / 1000000.0;
    sw.lastLapNs = now;
    sw.lastLapMs = lapMs;
    lapMs
};
