/* Provisional bootstrap list-search support. Not an official standard library. */

/** Registered list mutation intrinsic; T is scoped to these bodyless core declarations only. */
pub pushBack := fn<T>(values: mut List<T>, value: T): Unit;

/** Registered list mutation intrinsic; returns the element type of the granted list. */
pub popBack := fn<T>(values: mut List<T>): T;

/** Registered list mutation intrinsic; prepends `value` to `values`. */
pub pushFront := fn<T>(values: mut List<T>, value: T): Unit;

/** Registered list mutation intrinsic; removes and returns the first element of `values`. */
pub popFront := fn<T>(values: mut List<T>): T;

/** Returns the index of `target` in `values`, or -1 when absent. */
pub listIndexOfText := fn(values: List<String>, target: String): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index += 1;
    }
    -1
}

/** True when `values` contains `target`. */
pub listContainsText := fn(values: List<String>, target: String): Bool {
    listIndexOfText(=values, =target) >= 0
}

/** Returns the index of `target` in `values`, or -1 when absent. */
pub listIndexOfInt := fn(values: List<Int>, target: Int): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index += 1;
    }
    -1
}

/** True when `values` contains `target`. */
pub listContainsInt := fn(values: List<Int>, target: Int): Bool {
    listIndexOfInt(=values, =target) >= 0
}

/** Returns the index of `target` in `values`, or -1 when absent. */
pub listIndexOfBool := fn(values: List<Bool>, target: Bool): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index += 1;
    }
    -1
}

/** True when `values` contains `target`. */
pub listContainsBool := fn(values: List<Bool>, target: Bool): Bool {
    listIndexOfBool(=values, =target) >= 0
}

/** Returns the number of elements in `values`. */
pub listCountText := fn(values: List<String>): Int {
    var count := 0;
    loop values as value {
        count = count + 1;
    }
    count
}

/** Returns the number of elements in `values`. */
pub listCountInt := fn(values: List<Int>): Int {
    var count := 0;
    loop values as value {
        count = count + 1;
    }
    count
}

/** Returns the number of elements in `values`. */
pub listCountBool := fn(values: List<Bool>): Int {
    var count := 0;
    loop values as value {
        count = count + 1;
    }
    count
}
