/* Provisional bootstrap formatting support. Not an official standard library. */
integer := import "./int.lts";


/** Formats one signed 64-bit Int as decimal text. */
pub decimalText := fn(value: Int): String {
    integer.intText(value)
}

/** Left-pads `value` with spaces to at least `width` characters. */
pub padLeftText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = " " + result;
        index = index + 1;
    }
    result
}

/** Right-pads `value` with spaces to at least `width` characters. */
pub padRightText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = result + " ";
        index = index + 1;
    }
    result
}

/** Formats an Int and left-pads it with spaces to at least `width` characters. */
pub padLeftInt := fn(value: Int, width: Int): String {
    padLeftText(integer.intText(value), width)
}

/** Formats an Int and right-pads it with spaces to at least `width` characters. */
pub padRightInt := fn(value: Int, width: Int): String {
    padRightText(integer.intText(value), width)
}

/** Joins Int values in list order with `separator` between adjacent values. */
pub joinIntTexts := fn(values: List<Int>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = integer.intText(value);
            first = false;
        } else {
            result = result + separator + integer.intText(value);
        }
    }
    result
}
