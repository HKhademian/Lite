/* Provisional bootstrap formatting support. Not an official standard library. */

importFlatAll "int.lts";

/** Formats one signed 64-bit Int as decimal text. */
decimalText := fn(value: Int): String {
    intText(value)
}

/** Left-pads `value` with spaces to at least `width` characters. */
padLeftText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = " " + result;
        index = index + 1;
    }
    result
}

/** Right-pads `value` with spaces to at least `width` characters. */
padRightText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = result + " ";
        index = index + 1;
    }
    result
}

/** Formats an Int and left-pads it with spaces to at least `width` characters. */
padLeftInt := fn(value: Int, width: Int): String {
    padLeftText(intText(value), width)
}

/** Formats an Int and right-pads it with spaces to at least `width` characters. */
padRightInt := fn(value: Int, width: Int): String {
    padRightText(intText(value), width)
}

/** Joins Int values in list order with `separator` between adjacent values. */
joinIntTexts := fn(values: List<Int>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = intText(value);
            first = false;
        } else {
            result = result + separator + intText(value);
        }
    }
    result
}
