/* Provisional bootstrap source-position support. Not an official standard library. */

text := import "core/text";

/** Clamps one offset into the inclusive range `0..text.length(source)`. */
pub clampPosition := fn(source: String, position: Int): Int {
    size := text.length(source);
    if position < 0 { return 0; }
    if position > size { return size; }
    position
}

/** One-based line and column of a source offset, clamping at both ends. */
pub lineColumn := fn(source: String, position: Int): (line: Int, column: Int) {
    cursor := clampPosition(source, position);
    var line := 1;
    var lineStart := 0;
    var index := 0;
    loop index < cursor {
        if text.at(source, index) == "\n" {
            line += 1;
            lineStart = index + 1;
        }
        index += 1;
    }
    (=line, column = cursor - lineStart + 1)
}

/** Number of source lines, counting the empty source as one line. */
pub lineCount := fn(source: String): Int {
    size := text.length(source);
    var count := 1;
    var index := 0;
    loop index < size {
        if text.at(source, index) == "\n" { count += 1; }
        index += 1;
    }
    count
}

/** Offset of the first character on one-based `line`, or text length when absent. */
pub lineStartOffset := fn(source: String, line: Int): Int {
    size := text.length(source);
    if line <= 1 { return 0; }
    var current := 2;
    var index := 0;
    loop index < size {
        if text.at(source, index) == "\n" {
            if current == line { return index + 1; }
            current += 1;
        }
        index += 1;
    }
    size
}

/** Offset just before the line terminator of one-based `line`. */
pub lineEndOffset := fn(source: String, line: Int): Int {
    size := text.length(source);
    start := lineStartOffset(source, line);
    var index := start;
    loop index < size and text.at(source, index) =!= "\n" {
        index += 1;
    }
    index
}
