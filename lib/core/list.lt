/* Core list operations. */

_set := import "core/set";

/** Closed numeric scalar constraint supported by `List.sort`. */
pub OrderedScalar := alias Int | Int8 | Int16 | Int32 | Float | Float32;

/** Closed equatable scalar constraint supported by `List.indexOf`, `List.contains`, and `List.dedup`. */
pub Equatable := alias OrderedScalar | String | Bool;

/** Appends `value` to the end of `values`. */
pub List.pushBack := fn<T>(values: mut Self<T>, value: T): Unit;

/** Removes and returns the last element of `values`, faulting when empty. */
pub List.popBack := fn<T>(values: mut Self<T>): T;

/** Prepends `value` to the front of `values`. */
pub List.pushFront := fn<T>(values: mut Self<T>, value: T): Unit;

/** Removes and returns the first element of `values`, faulting when empty. */
pub List.popFront := fn<T>(values: mut Self<T>): T;

/** Returns the number of elements in `values`. */
pub List.length := fn<T>(values: Self<T>): Int;

/** Replaces the element at zero-based `index` in `values`, faulting when out of bounds. */
pub List.setAt := fn<T>(values: mut Self<T>, index: Int, value: T): Unit;

/** Returns a new list containing the half-open slice `values[start..end)`. */
pub List.slice := fn<T>(values: Self<T>, start: Int, end: Int): List<T>;

/** Returns a new list with the elements of `values` in reverse order. */
pub List.reverse := fn<T>(values: Self<T>): List<T>;

/** Removes all elements from `values`. */
pub List.clear := fn<T>(values: mut Self<T>): Unit;

/** Returns the element at zero-based `index`, faulting when out of bounds. */
pub List.$getIndex := fn<T>(values: Self<T>, index: Int): T;

/** Replaces the element at zero-based `index` via `values[index] = value`. */
pub List.$setIndex := fn<T>(values: mut Self<T>, index: Int, value: T): Unit;

/** Returns the element at zero-based `index`, skipping bounds checks when `-fno-check-unchecked` is active. */
pub List.uncheckedGet := fn<T>(values: Self<T>, index: Int): T;

/** Replaces the element at zero-based `index`, skipping bounds checks when `-fno-check-unchecked` is active. */
pub List.uncheckedSet := fn<T>(values: mut Self<T>, index: Int, value: T): Unit;

/** True when `values` has zero elements. */
pub List.isEmpty := fn<T>(values: Self<T>): Bool {
    values.length() == 0
};

/** Returns a new list obtained by applying `transform` to every element of `values`. */
pub List.map := fn<T, U>(values: Self<T>, transform: fn(T): U): List<U> {
    out: mut List<U> = [];
    loop values as item {
        mut out.pushBack(transform(item));
    }
    out
};

/** Returns a new list containing the elements of `values` satisfying `pred`. */
pub List.filter := fn<T>(values: Self<T>, pred: fn(T): Bool): List<T> {
    out: mut List<T> = [];
    loop values as item {
        if pred(item) { mut out.pushBack(item); }
    }
    out
};

/** Joins string list elements in order with `separator` between adjacent items (soft builtin). */
pub List.join := fn(values: Self<String>, separator: String): String {
    n := values.length();
    if n == 0 { return ""; }
    if n == 1 { return values[0]; }
    var cur: mut List<String> = values;
    loop cur.length() > 1 {
        next: mut List<String> = [];
        var i := 0;
        m := cur.length();
        loop i + 1 < m {
            mut next.pushBack(cur[i] + separator + cur[i + 1]);
            i += 2;
        }
        if i < m {
            mut next.pushBack(cur[i]);
        }
        cur = next;
    }
    cur[0]
};

/** Returns a stable O(n log n) copy of `values` ordered by `lessOrEqual(a, b)`. */
pub List.sortBy := fn<T: Type>(values: Self<T>, lessOrEqual: fn(T, T): Bool): List<T> {
    n := values.length();
    if n <= 1 { return values; }
    var src: mut List<T> = values;
    var width := 1;
    loop width < n {
        dst: mut List<T> = [];
        var left := 0;
        loop left < n {
            mid := if left + width < n { left + width } else { n };
            right := if left + width * 2 < n { left + width * 2 } else { n };
            var i := left;
            var j := mid;
            loop i < mid and j < right {
                if lessOrEqual(src[i], src[j]) {
                    mut dst.pushBack(src[i]);
                    i += 1;
                } else {
                    mut dst.pushBack(src[j]);
                    j += 1;
                }
            }
            loop i < mid {
                mut dst.pushBack(src[i]);
                i += 1;
            }
            loop j < right {
                mut dst.pushBack(src[j]);
                j += 1;
            }
            left += width * 2;
        }
        src = dst;
        width = width * 2;
    }
    src
};

/** Returns a new sorted ascending copy of numeric scalar `values` using stable O(n log n) merge sort. */
pub List.sort := fn<T: Type<OrderedScalar>>(values: Self<T>): List<T> {
    n := values.length();
    if n <= 1 { return values; }
    var src: mut List<T> = values;
    var width := 1;
    loop width < n {
        dst: mut List<T> = [];
        var left := 0;
        loop left < n {
            mid := if left + width < n { left + width } else { n };
            right := if left + width * 2 < n { left + width * 2 } else { n };
            var i := left;
            var j := mid;
            loop i < mid and j < right {
                if src[i] <= src[j] {
                    mut dst.pushBack(src[i]);
                    i += 1;
                } else {
                    mut dst.pushBack(src[j]);
                    j += 1;
                }
            }
            loop i < mid {
                mut dst.pushBack(src[i]);
                i += 1;
            }
            loop j < right {
                mut dst.pushBack(src[j]);
                j += 1;
            }
            left += width * 2;
        }
        src = dst;
        width = width * 2;
    }
    src
};

/** Returns a new lexicographically sorted ascending copy of `values` using stable O(n log n) merge sort. */
pub List.sortTexts := fn(values: Self<String>): List<String> {
    n := values.length();
    if n <= 1 { return values; }
    var src: mut List<String> = values;
    var width := 1;
    loop width < n {
        dst: mut List<String> = [];
        var left := 0;
        loop left < n {
            mid := if left + width < n { left + width } else { n };
            right := if left + width * 2 < n { left + width * 2 } else { n };
            var i := left;
            var j := mid;
            loop i < mid and j < right {
                if src[i].lessOrEqual(src[j]) {
                    mut dst.pushBack(src[i]);
                    i += 1;
                } else {
                    mut dst.pushBack(src[j]);
                    j += 1;
                }
            }
            loop i < mid {
                mut dst.pushBack(src[i]);
                i += 1;
            }
            loop j < right {
                mut dst.pushBack(src[j]);
                j += 1;
            }
            left += width * 2;
        }
        src = dst;
        width = width * 2;
    }
    src
};

/** Returns the index of `target` in `values`, or -1 when absent. */
pub List.indexOf := fn<T: Type<Equatable>>(values: Self<T>, target: T): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index += 1;
    }
    -1
};

/** True when `values` contains `target`. */
pub List.contains := fn<T: Type<Equatable>>(values: Self<T>, target: T): Bool {
    values.indexOf(target) >= 0
};

/** Returns unique elements of `values` preserving first-seen order in O(n). */
pub List.dedup := fn<T: Type<Equatable>>(values: Self<T>): List<T> {
    seen: mut Set<T>;
    out: mut List<T> = [];
    loop values as value {
        if not seen.has(value) {
            mut seen.add(value);
            mut out.pushBack(value);
        }
    }
    out
};

/** Folds `values` left-to-right starting from `initial` using `step(acc, item)`. */
pub List.fold := fn<T: Type, U: Type>(values: Self<T>, initial: U, step: fn(U, T): U): U {
    var acc := initial;
    loop values as item {
        acc = step(acc, item);
    }
    acc
};

/** True when any element of `values` satisfies `pred`. */
pub List.any := fn<T: Type>(values: Self<T>, pred: fn(T): Bool): Bool {
    loop values as item {
        if pred(item) { return true; }
    }
    false
};

/** True when every element of `values` satisfies `pred`. */
pub List.all := fn<T: Type>(values: Self<T>, pred: fn(T): Bool): Bool {
    loop values as item {
        if not pred(item) { return false; }
    }
    true
};

/** Returns the zero-based index of the first element satisfying `pred`, or -1 when absent. */
pub List.findIndex := fn<T: Type>(values: Self<T>, pred: fn(T): Bool): Int {
    var index := 0;
    loop values as item {
        if pred(item) { return index; }
        index += 1;
    }
    -1
};

/** Returns `(found = true, value = item)` for the first element satisfying `pred`, or `(found = false, value = zero)`. */
pub List.find := fn<T: Type>(values: Self<T>, pred: fn(T): Bool): (found: Bool, value: T) {
    z: T;
    loop values as item {
        if pred(item) { return (found = true, value = item); }
    }
    (found = false, value = z)
};

/** Fills `length` bytes of `dst` starting at `offset` with `value`, faulting when out of bounds. */
pub List.fillBytes := fn(dst: mut List<UInt8>, offset: Int, length: Int, value: UInt8): Unit {
    if offset < 0 or length < 0 or length > dst.length() or offset > dst.length() - length {
        _ := dst[-1];
        return;
    }
    var i := 0;
    loop i < length {
        dst[offset + i] = value;
        i += 1;
    }
};

/** Copies `length` bytes from `src[srcOffset..]` into `dst[dstOffset..]`, overlap-safe and bounds-checked. */
pub List.copyBytes := fn(dst: mut List<UInt8>, dstOffset: Int, src: List<UInt8>, srcOffset: Int, length: Int): Unit {
    if dstOffset < 0 or srcOffset < 0 or length < 0 or length > dst.length() or dstOffset > dst.length() - length or length > src.length() or srcOffset > src.length() - length {
        _ := dst[-1];
        return;
    }
    if length == 0 { return; }
    if dstOffset > srcOffset {
        var i := length - 1;
        loop i >= 0 {
            dst[dstOffset + i] = src[srcOffset + i];
            i -= 1;
        }
    } else {
        var i := 0;
        loop i < length {
            dst[dstOffset + i] = src[srcOffset + i];
            i += 1;
        }
    }
};

/** Returns the index of the first occurrence of `needle` at or after `start`, or `-1` when absent. */
pub List.indexOfByte := fn(values: List<UInt8>, needle: UInt8, start: Int): Int {
    var i := if start < 0 { 0 } else { start };
    n := values.length();
    loop i < n {
        if values[i] == needle { return i; }
        i += 1;
    }
    -1
};
