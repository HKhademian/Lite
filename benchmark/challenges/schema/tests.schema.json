{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/tests.schema.json",
  "title": "ChallengeTests",
  "description": "Official public language/examples/samples for one challenge, split into visible and held-out cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "url",
    "source",
    "format",
    "status",
    "public",
    "hidden",
    "hidden_policy",
    "note"
  ],
  "properties": {
    "challenge_id": {
      "type": "string",
      "description": "Foreign key into data/challenges.jsonl."
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "source": {
      "type": "string",
      "enum": [
        "advent-of-code",
        "project-euler",
        "leetcode",
        "codeforces",
        "cses",
        "atcoder",
        "rosalind",
        "cryptopals",
        "jane-street"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "function",
        "stdio",
        "sql",
        "shell",
        "single-answer",
        "programming",
        "puzzle"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "public+hidden",
        "public-only",
        "none",
        "not-applicable"
      ]
    },
    "public": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "hidden": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "hidden_policy": {
      "type": "string",
      "enum": [
        "held-out-official-samples",
        "none"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "input",
        "output",
        "explanation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "example",
            "sample",
            "held-out-example",
            "held-out-sample"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
