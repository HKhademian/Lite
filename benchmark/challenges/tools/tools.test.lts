/** Boundary checks for Lite-migrated challenge rounding and HTML entity decoding utilities. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
text := import "type/string";
cbuild := import "../../../tools/src/internal/challenge-build";
ch := import "../../../tools/src/internal/challenges";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

entitiesRes := fs.readText(path.join(root, "benchmark/challenges/tools/html-entities.json"));
test.check("read html-entities.json: " + entitiesRes.error, entitiesRes.ok);

/* ties-to-even rounding */
test.checkInt("roundDivTiesEven(5, 2)", 2, cbuild.roundDivTiesEven(5, 2));
test.checkInt("roundDivTiesEven(7, 2)", 4, cbuild.roundDivTiesEven(7, 2));
test.checkInt("roundDivTiesEven(125, 100)", 1, cbuild.roundDivTiesEven(125, 100));
test.checkInt("roundDivTiesEven(135, 100)", 1, cbuild.roundDivTiesEven(135, 100));
test.checkInt("roundDivTiesEven(2675, 1000)", 3, cbuild.roundDivTiesEven(2675, 1000));
test.checkInt("roundDivTiesEven(-2675, 1000)", -3, cbuild.roundDivTiesEven(-2675, 1000));

/* HTML entity decoding */
decoded1 := ch.unescapeChallengeHtml(entitiesRes.text, "&lt;x&gt; &amp; &NotEqualTilde; &#x1F642; &#128; &notit; &unknown;");
decoded2 := ch.unescapeChallengeHtml(entitiesRes.text, "&#0; &#xD800; &#x110000; &#11;");
test.checkText("decoded1", "<x> & ≂̸ 🙂 € ¬it; &unknown;", decoded1);
rep := String.fromCodePoint(text.UNICODE_REPLACEMENT_CHAR).text;
test.checkText("decoded2", rep + " " + rep + " " + rep + " ", decoded2);
