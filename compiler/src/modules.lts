diagLib := import "core/diag";
listLib := import "core/list";
frontend := import "./frontend.lts";
sourceReader := import "./source-reader.lts";
/* Initial source graph traversal for the generated TypeScript compiler. */

/** True when the graph has entered one canonical source path. */
moduleVisited := fn(graph: frontend.Items, path: String): Bool {
    loop graph as item {
        if item.kind == "ModuleVisited" and item.name == path { return true; }
    }
    false
}

/** True when the graph completed parsing one canonical source path. */
moduleProcessed := fn(graph: frontend.Items, path: String): Bool {
    loop graph as item {
        if item.kind == "ModuleProcessed" and item.name == path { return true; }
    }
    false
}

/** Returns the graph identity assigned when one canonical source was first visited. */
moduleIdForPath := fn(graph: frontend.Items, path: String): Int {
    loop graph as item {
        if item.kind == "ModuleVisited" and item.name == path { return item.intValue; }
    }
    -1
}

/** Assigns a stable ordinal to the next discovered source unit. */
nextModuleId := fn(graph: frontend.Items): Int {
    var count := 0;
    loop graph as item {
        if item.kind == "ModuleVisited" { count += 1; }
    }
    count
}

/** Returns public declaration records for one completed source module. */
modulePublicDeclarations := fn(graph: frontend.Items, path: String): frontend.Items {
    result: mut frontend.Items = [];
    var inside := false;
    loop graph as item {
        if item.kind == "ModuleStart" { inside = item.name == path; }
        else if item.kind == "ModuleEnd" and inside { break; }
        else if inside and (item.kind == "PublicFunction" or item.kind == "PublicValue" or item.kind == "PublicType") {
            listLib.pushBack(mut result, item);
        }
    }
    result
}
/** Appends an import interface, rejecting alias and public-name collisions. */
appendModuleExports := fn(existing: frontend.Items, incoming: frontend.Items, prefix: String): frontend.Items {
    var result: mut frontend.Items = existing;
    loop incoming as item {
        var duplicate := false;
        loop result as previous {
            if item.kind == "ModuleAlias" {
                if (previous.kind == "ModuleAlias" and previous.name == item.name) or
                    ((previous.kind == "PublicFunction" or previous.kind == "PublicValue") and previous.name == item.name) {
                    duplicate = true;
                }
            } else if item.kind == "PublicFunction" or item.kind == "PublicValue" {
                if ((previous.kind == "PublicFunction" or previous.kind == "PublicValue") and previous.name == item.name) or
                    (previous.kind == "ModuleAlias" and previous.name == item.name) {
                    duplicate = true;
                }
            } else if item.kind == "PublicType" and previous.kind == "PublicType" and previous.name == item.name {
                duplicate = true;
            }
        }
        if duplicate {
            if item.kind == "ModuleAlias" { diagLib.fail(prefix, "duplicate module alias " + item.name); }
            if item.kind == "PublicType" { diagLib.fail(prefix, "duplicate imported public type " + item.name); }
            diagLib.fail(prefix, "duplicate imported public name " + item.name);
        }
        listLib.pushBack(mut result, item);
    }
    result
}

/** Builds one aliased module namespace from its source-declared public interface. */
moduleAliasExports := fn(graph: frontend.Items, path: String, alias: String): frontend.Items {
    result: mut frontend.Items = [(kind = "ModuleAlias", name = alias, runtime = "", code = "",
        intValue = moduleIdForPath(graph, path), textValue = path)];
    loop modulePublicDeclarations(graph, path) as item {
        listLib.pushBack(mut result, (kind = item.kind, name = alias + "." + item.name, runtime = item.runtime,
            code = item.code, intValue = item.intValue, textValue = item.textValue));
    }
    result
}

/** Reads and parses each canonical source once, marking it visited before recursion and processed after dependencies and local parsing. */
pub visitSourceModule := fn(target: String, path: String, display: String, identity: String, source: String,
    initialGraph: frontend.Items): frontend.Items {
    if moduleVisited(initialGraph, path) { return initialGraph; }
    moduleId := nextModuleId(initialGraph);
    var graph: mut frontend.Items = initialGraph;
    listLib.pushBack(mut graph, (kind = "ModuleVisited", name = path, runtime = "", code = "", intValue = moduleId, textValue = ""));
    var importedExports: mut frontend.Items = [];
    loop frontend.collectImportClauses(target, source, path) as clause {
        loaded := sourceReader.read(path, clause.textValue);
        if loaded.identity == "lite.compiler.source-reader.v1" and identity =!= "lite.compiler.modules.v1" {
            diagLib.fail(display, "the compiler source reader is private to module traversal");
        }
        if not moduleVisited(graph, loaded.path) {
            graph = self(=target, path = loaded.path, display = loaded.display, identity = loaded.identity, source = loaded.text, initialGraph = graph);
        }
        if moduleProcessed(graph, loaded.path) {
            importedExports = appendModuleExports(importedExports, moduleAliasExports(graph, loaded.path, clause.name), path);
        }
    }
    localItems := frontend.parseProgramWithIdentity(=target, =source, prefix = display, exports = importedExports, =moduleId, moduleIdentity = identity);
    listLib.pushBack(mut graph, (kind = "ModuleStart", name = path, runtime = "", code = "", intValue = moduleId, textValue = display));
    loop localItems as item { listLib.pushBack(mut graph, item); }
    listLib.pushBack(mut graph, (kind = "ModuleEnd", name = path, runtime = "", code = "", intValue = moduleId, textValue = ""));
    listLib.pushBack(mut graph, (kind = "ModuleProcessed", name = path, runtime = "", code = "", intValue = 0, textValue = ""));
    graph
}

/** Removes graph-only records while preserving dependency-first parsed item order. */
pub moduleItems := fn(graph: frontend.Items): frontend.Items {
    result: mut frontend.Items = [];
    loop graph as item {
        if item.kind =!= "ModuleVisited" and item.kind =!= "ModuleProcessed" and
            item.kind =!= "ModuleStart" and item.kind =!= "ModuleEnd" {
            listLib.pushBack(mut result, item);
        }
    }
    result
}
