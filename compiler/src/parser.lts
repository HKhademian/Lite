/* Lite-written parser core. Starts with the type grammar; declaration/body slices follow. */


/** One flat parse node: kind, name, detail text and source position. */
Node := type (kind: String, name: String, detail: String, offset: Int, line: Int, column: Int);

/** Parse nodes in source order. */
Nodes := type List<Node>;

/* Parse-node kind spellings. Zero-argument accessors because Lite has no enum
   and top-level values cannot be captured by functions yet. */
/** Canonical node kind for one type alias. */
NODE_KIND_TYPE_ALIAS := fn(): String { "TypeAlias" }

/** Canonical node kind for one declaration. */
NODE_KIND_DECLARATION := fn(): String { "Declaration" }

/** Canonical node kind for a complete program. */
NODE_KIND_PROGRAM := fn(): String { "Program" }

/** Reports one token-positioned parser diagnostic and exits 2. */
parseFail := fn(token: Token, prefix: String, message: String): Unit {
    fail(prefix, decimalText(token.line) + ":" + decimalText(token.column) + ": " + message);
}

/** Number of tokens, including the final EOF token. */
tokenCount := fn(tokens: Tokens): Int {
    var count := 0;
    loop tokens as token {
        if token.kind == TOKEN_KIND_EOF() { return count + 1; }
        count = count + 1;
    }
    count
}

/** Returns the token at `index`; the caller keeps `index` inside the counted list. */
tokenAt := fn(tokens: Tokens, index: Int): Token {
    tokens[index]
}

/** True when the token is the exact symbol `text`. */
isSymbol := fn(token: Token, text: String): Bool {
    token.kind == TOKEN_KIND_SYMBOL() and token.text == text
}

/** Consumes the exact symbol or reports a parser diagnostic. */
expectSymbol := fn(tokens: Tokens, index: Int, text: String, prefix: String): Int {
    token := tokenAt(tokens, index);
    if not isSymbol(token, text) {
        parseFail(token, prefix, "expected " + text);
    }
    index + 1
}

/** Consumes a simple-item separator, allowing EOF, a closing scope and a directly closed block token as implicit boundaries. */
consumeStatementEnd := fn(tokens: Tokens, index: Int, prefix: String): Int {
    token := tokenAt(tokens, index);
    if isSymbol(token, ";") { return index + 1; }
    if token.kind == TOKEN_KIND_EOF() or isSymbol(token, "}") or
        (index > 0 and isSymbol(tokenAt(tokens, index - 1), "}")) { return index; }
    expectSymbol(tokens, index, ";", prefix)
}

/** Parses one type: a name, `List<T>` or a flat tuple with optional labels. */
parseType := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    if token.kind == TOKEN_KIND_NAME() {
        after := tokenAt(tokens, index + 1);
        if isSymbol(after, "<") {
            if token.text =!= "List" {
                parseFail(token, prefix, "unsupported generic type " + token.text);
            }
            inner := self(tokens, index + 2, prefix);
            closed := expectSymbol(tokens, inner.next, ">", prefix);
            return (next = closed, text = "List<" + inner.text + ">");
        }
        return (next = index + 1, text = token.text);
    }
    if isSymbol(token, "(") {
        var cursor := index + 1;
        var text := "(";
        var first := true;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), ")") { break; }
            var label := "";
            if tokenAt(tokens, cursor).kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":") {
                label = tokenAt(tokens, cursor).text + ": ";
                cursor = cursor + 2;
            }
            component := self(tokens, cursor, prefix);
            if not first { text = text + ", "; }
            text = text + label + component.text;
            first = false;
            cursor = component.next;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        closed := expectSymbol(tokens, cursor, ")", prefix);
        return (next = closed, text = text + ")");
    }
    parseFail(token, prefix, "expected a type");
    (next = index, text = "")
}

/** Quotes one String value as valid normalized expression text. */
quotedText := fn(text: String): String {
    escaped := escapedTokenText(text);
    var result := "";
    var index := 0;
    loop index < textLength(escaped) {
        ch := textAt(escaped, index);
        if ch == "\"" { result = result + "\\\""; } else { result = result + ch; }
        index = index + 1;
    }
    result
}

/** Precedence for one binary word or symbol, or 0 when it is not binary. */
binaryLevel := fn(text: String): Int {
    if text == "or" { 2 }
    else if text == "and" { 3 }
    else if text == "==" or text == "=!=" or text == "<" or text == "<!" or text == "<=" or
        text == "<!=" or text == ">" or text == ">!" or text == ">=" or text == ">!=" { 5 }
    else if text == "+" or text == "-" { 10 }
    else if text == "*" or text == "/" or text == "%" or text == ":/" or text == ":%" { 20 }
    else if text == "**" { 25 }
    else { 0 }
}

/** True when a token is a selected binary operator. */
isBinaryToken := fn(token: Token): Bool {
    if token.kind == TOKEN_KIND_KEYWORD() and (token.text == "and" or token.text == "or") { return true; }
    token.kind == TOKEN_KIND_SYMBOL() and binaryLevel(token.text) > 0
}

/**
 * Parses one expression and returns a fully parenthesized normalized text.
 * `if` value expressions are the next slice; this function reports them
 * explicitly instead of guessing a block boundary.
 */
parseExpression := fn(tokens: Tokens, index: Int, prefix: String, minimum: Int): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    var cursor := index;
    var leftText := "";
    var firstLabel := false;
    if token.kind == TOKEN_KIND_KEYWORD() and (token.text == "and" or token.text == "or") {
        operand := self(tokens, index + 1, prefix, 0);
        return (next = operand.next, text = operand.text);
    } else if token.kind == TOKEN_KIND_KEYWORD() and token.text == "not" {
        operand := self(tokens, index + 1, prefix, 5);
        leftText = "(not " + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == TOKEN_KIND_SYMBOL() and (token.text == "-" or token.text == "+") {
        operand := self(tokens, index + 1, prefix, 30);
        leftText = "(" + token.text + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == TOKEN_KIND_INT() {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == TOKEN_KIND_STRING() {
        var value := token.text;
        cursor = index + 1;
        loop tokenAt(tokens, cursor).kind == TOKEN_KIND_STRING() {
            value = value + tokenAt(tokens, cursor).text;
            cursor = cursor + 1;
        }
        leftText = "\"" + quotedText(value) + "\"";
    } else if token.kind == TOKEN_KIND_BOOL() {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == TOKEN_KIND_NAME() {
        leftText = token.text;
        cursor = index + 1;
        if isSymbol(tokenAt(tokens, cursor), "(") {
            var argText := "";
            var argCount := 0;
            cursor = cursor + 1;
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                if argCount > 0 { argText = argText + ", "; }
                if tokenAt(tokens, cursor).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor).text == "mut" {
                    argText = argText + "mut ";
                    cursor = cursor + 1;
                }
                if tokenAt(tokens, cursor).kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    argText = argText + tokenAt(tokens, cursor).text + " = ";
                    cursor = cursor + 2;
                }
                arg := self(tokens, cursor, prefix, 0);
                argText = argText + arg.text;
                cursor = arg.next;
                argCount = argCount + 1;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = leftText + "(" + argText + ")";
        }
    } else if isSymbol(token, "(") {
        cursor = index + 1;
        var firstText := "";
        if tokenAt(tokens, cursor).kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), "=") {
            firstText = tokenAt(tokens, cursor).text + " = ";
            firstLabel = true;
            cursor = cursor + 2;
        }
        first := self(tokens, cursor, prefix, 0);
        firstText = firstText + first.text;
        cursor = first.next;
        if firstLabel or isSymbol(tokenAt(tokens, cursor), ",") {
            var tupleText := "(" + firstText;
            if isSymbol(tokenAt(tokens, cursor), ",") { cursor = cursor + 1; }
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                tupleText = tupleText + ", ";
                if tokenAt(tokens, cursor).kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    tupleText = tupleText + tokenAt(tokens, cursor).text + " = ";
                    cursor = cursor + 2;
                }
                component := self(tokens, cursor, prefix, 0);
                tupleText = tupleText + component.text;
                cursor = component.next;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = tupleText + ")";
        } else {
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = "(" + firstText + ")";
        }
    } else if isSymbol(token, "[") {
        cursor = index + 1;
        var listText := "[";
        var itemCount := 0;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), "]") { break; }
            if itemCount > 0 { listText = listText + ", "; }
            item := self(tokens, cursor, prefix, 0);
            listText = listText + item.text;
            cursor = item.next;
            itemCount = itemCount + 1;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        cursor = expectSymbol(tokens, cursor, "]", prefix);
        leftText = listText + "]";
    } else if token.kind == TOKEN_KIND_KEYWORD() and token.text == "if" {
        condition := self(tokens, index + 1, prefix, 0);
        opening := expectSymbol(tokens, condition.next, "{", prefix);
        branchValue := self(tokens, opening, prefix, 0);
        closing := expectSymbol(tokens, branchValue.next, "}", prefix);
        var ifText := "if " + condition.text + " { " + branchValue.text + " }";
        cursor = closing;
        loop true {
            if tokenAt(tokens, cursor).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor).text == "else" {
                afterElse := cursor + 1;
                if tokenAt(tokens, afterElse).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, afterElse).text == "if" {
                    elseCondition := self(tokens, afterElse + 1, prefix, 0);
                    elseOpening := expectSymbol(tokens, elseCondition.next, "{", prefix);
                    elseValue := self(tokens, elseOpening, prefix, 0);
                    elseClosing := expectSymbol(tokens, elseValue.next, "}", prefix);
                    ifText = ifText + " else if " + elseCondition.text + " { " + elseValue.text + " }";
                    cursor = elseClosing;
                } else {
                    elseOpening := expectSymbol(tokens, afterElse, "{", prefix);
                    elseValue := self(tokens, elseOpening, prefix, 0);
                    elseClosing := expectSymbol(tokens, elseValue.next, "}", prefix);
                    ifText = ifText + " else { " + elseValue.text + " }";
                    cursor = elseClosing;
                    break;
                }
            } else {
                break;
            }
        }
        leftText = ifText;
    } else {
        parseFail(token, prefix, "expected an expression");
        return (next = index, text = "");
    }
    loop true {
        current := tokenAt(tokens, cursor);
        if isSymbol(current, ".") {
            member := tokenAt(tokens, cursor + 1);
            if member.kind == TOKEN_KIND_NAME() or member.kind == TOKEN_KIND_INT() {
                leftText = leftText + "." + member.text;
                cursor = cursor + 2;
            } else {
                parseFail(member, prefix, "expected a field name after .");
            }
        } else if isSymbol(current, "[") {
            indexExpr := self(tokens, cursor + 1, prefix, 0);
            closed := expectSymbol(tokens, indexExpr.next, "]", prefix);
            leftText = leftText + "[" + indexExpr.text + "]";
            cursor = closed;
        } else {
            break;
        }
    }
    loop true {
        operator := tokenAt(tokens, cursor);
        if not isBinaryToken(operator) { break; }
        level := binaryLevel(operator.text);
        if level < minimum { break; }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(tokens, cursor + 1, prefix, rightMinimum);
        leftText = "(" + leftText + " " + operator.text + " " + right.text + ")";
        cursor = right.next;
    }
    (next = cursor, text = leftText)
}

/** Parses one declaration into scalar node fields. */
parseDeclaration := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    var cursor := index;
    var isVar := false;
    if tokenAt(tokens, cursor).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor).text == "var" {
        isVar = true;
        cursor = cursor + 1;
    }
    token := tokenAt(tokens, cursor);
    if token.kind =!= TOKEN_KIND_NAME() {
        parseFail(token, prefix, "expected a declaration name");
    }
    name := token.text;
    cursor = cursor + 1;
    var detail := "";
    if isSymbol(tokenAt(tokens, cursor), ":=") {
        expression := parseExpression(tokens, cursor + 1, prefix, 0);
        detail = (if isVar { "var " } else { "" }) + ":= " + expression.text;
        cursor = expression.next;
    } else if isSymbol(tokenAt(tokens, cursor), ":") {
        cursor = cursor + 1;
        var mutableType := false;
        if tokenAt(tokens, cursor).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor).text == "mut" {
            mutableType = true;
            cursor = cursor + 1;
        }
        parsedType := parseType(tokens, cursor, prefix);
        detail = (if isVar { "var " } else { "" }) +
            (if mutableType { "mut " } else { "" }) + parsedType.text;
        cursor = parsedType.next;
        if isSymbol(tokenAt(tokens, cursor), "=") {
            if isSymbol(tokenAt(tokens, cursor + 1), "?") {
                detail = detail + " = ?";
                cursor = cursor + 2;
            } else {
                expression := parseExpression(tokens, cursor + 1, prefix, 0);
                detail = detail + " = " + expression.text;
                cursor = expression.next;
            }
        } else if isSymbol(tokenAt(tokens, cursor), "?") {
            detail = detail + " = ?";
            cursor = cursor + 1;
        }
    } else {
        parseFail(tokenAt(tokens, cursor), prefix, "expected := or : after declaration name");
    }
    ended := consumeStatementEnd(tokens, cursor, prefix);
    (next = ended, name = name, detail = detail, offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of declarations, ending at EOF. */
parseDeclarations := fn(tokens: Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    nodes: mut List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        parsed := parseDeclaration(tokens, cursor, prefix);
        push_back(mut nodes, (kind = NODE_KIND_DECLARATION(), name = parsed.name, detail = parsed.detail,
            offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** Parses one `{ ... }` block or the whole source when `closed` is false into normalized text. */
parseBlock := fn(tokens: Tokens, index: Int, prefix: String, closed: Bool): (next: Int, text: String) {
    var cursor := index;
    if closed {
        cursor = expectSymbol(tokens, cursor, "{", prefix);
    }
    var body := "";
    var itemCount := 0;
    loop true {
        token := tokenAt(tokens, cursor);
        if closed and isSymbol(token, "}") {
            cursor = cursor + 1;
            break;
        }
        if token.kind == TOKEN_KIND_EOF() {
            if closed { parseFail(token, prefix, "expected } before end of source"); }
            break;
        }
        if isSymbol(token, "}") {
            parseFail(token, prefix, "unexpected }");
        }
        if token.kind == TOKEN_KIND_KEYWORD() and
            (token.text == "match" or token.text == "record" or token.text == "import" or
                token.text == "using" or token.text == "then" or token.text == "finally") {
            parseFail(token, prefix, "unsupported feature \"" + token.text + "\"");
        }
        if isSymbol(token, ";") { cursor = cursor + 1; continue; }
        var itemText := "";
        if token.kind == TOKEN_KIND_KEYWORD() and token.text == "if" {
            condition := parseExpression(tokens, cursor + 1, prefix, 0);
            if not isSymbol(tokenAt(tokens, condition.next), "{") {
                parseFail(tokenAt(tokens, condition.next), prefix, "expected { after if condition");
            }
            branch := self(tokens, condition.next, prefix, true);
            var branchText := "if " + condition.text + " " + branch.text;
            cursor = branch.next;
            loop true {
                if tokenAt(tokens, cursor).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor).text == "else" {
                    afterElse := cursor + 1;
                    if tokenAt(tokens, afterElse).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, afterElse).text == "if" {
                        elseCondition := parseExpression(tokens, afterElse + 1, prefix, 0);
                        if not isSymbol(tokenAt(tokens, elseCondition.next), "{") {
                            parseFail(tokenAt(tokens, elseCondition.next), prefix, "expected { after else if condition");
                        }
                        elseBranch := self(tokens, elseCondition.next, prefix, true);
                        branchText = branchText + " else if " + elseCondition.text + " " + elseBranch.text;
                        cursor = elseBranch.next;
                    } else {
                        elseBranch := self(tokens, afterElse, prefix, true);
                        branchText = branchText + " else " + elseBranch.text;
                        cursor = elseBranch.next;
                        break;
                    }
                } else {
                    break;
                }
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
            itemText = branchText;
        } else if token.kind == TOKEN_KIND_KEYWORD() and token.text == "loop" {
            source := parseExpression(tokens, cursor + 1, prefix, 0);
            if tokenAt(tokens, source.next).kind == TOKEN_KIND_NAME() and tokenAt(tokens, source.next).text == "as" {
                variable := tokenAt(tokens, source.next + 1);
                if variable.kind =!= TOKEN_KIND_NAME() {
                    parseFail(variable, prefix, "expected a loop item name after as");
                }
                bodyBlock := self(tokens, source.next + 2, prefix, true);
                itemText = "loop " + source.text + " as " + variable.text + " " + bodyBlock.text;
                cursor = bodyBlock.next;
            } else {
                if not isSymbol(tokenAt(tokens, source.next), "{") {
                    parseFail(tokenAt(tokens, source.next), prefix, "expected { after loop source");
                }
                bodyBlock := self(tokens, source.next, prefix, true);
                itemText = "loop " + source.text + " " + bodyBlock.text;
                cursor = bodyBlock.next;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == TOKEN_KIND_KEYWORD() and (token.text == "break" or token.text == "continue") {
            itemText = token.text;
            cursor = cursor + 1;
            if isSymbol(tokenAt(tokens, cursor), "@") {
                label := tokenAt(tokens, cursor + 1);
                if label.kind =!= TOKEN_KIND_NAME() { parseFail(label, prefix, "expected a loop label after @"); }
                itemText = itemText + " @" + label.text;
                cursor = cursor + 2;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == TOKEN_KIND_KEYWORD() and token.text == "return" {
            afterReturn := cursor + 1;
            if isSymbol(tokenAt(tokens, afterReturn), ";") or isSymbol(tokenAt(tokens, afterReturn), "}") or
                tokenAt(tokens, afterReturn).kind == TOKEN_KIND_EOF() {
                itemText = "return";
                cursor = afterReturn;
            } else {
                value := parseExpression(tokens, afterReturn, prefix, 0);
                itemText = "return " + value.text;
                cursor = value.next;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == TOKEN_KIND_SYMBOL() and token.text == "{" {
            blockText := self(tokens, cursor, prefix, true);
            itemText = blockText.text;
            cursor = consumeStatementEnd(tokens, blockText.next, prefix);
        } else if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "fn" {
            name := token.text;
            var afterName := cursor + 3;
            afterName = expectSymbol(tokens, afterName, "(", prefix);
            var parameters := "";
            var parameterCount := 0;
            loop true {
                if isSymbol(tokenAt(tokens, afterName), ")") { break; }
                parameter := tokenAt(tokens, afterName);
                if parameter.kind =!= TOKEN_KIND_NAME() { parseFail(parameter, prefix, "expected a parameter name"); }
                colon := expectSymbol(tokens, afterName + 1, ":", prefix);
                parameterType := parseType(tokens, colon, prefix);
                if parameterCount > 0 { parameters = parameters + ", "; }
                parameters = parameters + parameter.text + ": " + parameterType.text;
                parameterCount = parameterCount + 1;
                afterName = parameterType.next;
                if isSymbol(tokenAt(tokens, afterName), ",") {
                    afterName = afterName + 1;
                } else {
                    break;
                }
            }
            afterName = expectSymbol(tokens, afterName, ")", prefix);
            resultColon := expectSymbol(tokens, afterName, ":", prefix);
            resultType := parseType(tokens, resultColon, prefix);
            if not isSymbol(tokenAt(tokens, resultType.next), "{") {
                parseFail(tokenAt(tokens, resultType.next), prefix, "expected { after function signature");
            }
            functionBody := self(tokens, resultType.next, prefix, true);
            itemText = name + " := fn(" + parameters + "): " + resultType.text + " " + functionBody.text;
            cursor = functionBody.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "type" {
            assigned := expectSymbol(tokens, cursor + 1, ":=", prefix);
            typeWord := tokenAt(tokens, assigned);
            if typeWord.kind =!= TOKEN_KIND_KEYWORD() or typeWord.text =!= "type" {
                parseFail(typeWord, prefix, "expected type after :=");
            }
            aliasType := parseType(tokens, assigned + 1, prefix);
            ended := consumeStatementEnd(tokens, aliasType.next, prefix);
            itemText = token.text + " := type " + aliasType.text;
            cursor = ended;
        } else if token.kind == TOKEN_KIND_KEYWORD() and token.text == "var" or
            (token.kind == TOKEN_KIND_NAME() and (isSymbol(tokenAt(tokens, cursor + 1), ":=") or
                isSymbol(tokenAt(tokens, cursor + 1), ":"))) {
            declaration := parseDeclaration(tokens, cursor, prefix);
            itemText = declaration.name + " " + declaration.detail;
            cursor = declaration.next;
        } else if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), "=") {
            value := parseExpression(tokens, cursor + 2, prefix, 0);
            itemText = token.text + " = " + value.text;
            cursor = value.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else {
            expression := parseExpression(tokens, cursor, prefix, 0);
            itemText = expression.text;
            cursor = expression.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        }
        if itemCount > 0 { body = body + "; "; }
        body = body + itemText;
        itemCount = itemCount + 1;
    }
    (next = cursor, text = if closed { "{ " + body + " }" } else { body })
}

/** Parses a complete source as one Program node containing normalized item text. */
parseProgram := fn(tokens: Tokens, prefix: String): Nodes {
    parsed := parseBlock(tokens, 0, prefix, false);
    nodes: mut List<Node> = [];
    push_back(mut nodes, (kind = NODE_KIND_PROGRAM(), name = "", detail = parsed.text, offset = 0, line = 1, column = 1));
    nodes
}

/** Parses one `Name := type Type;` declaration into scalar node fields. */
parseTypeAlias := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    token := tokenAt(tokens, index);
    if token.kind =!= TOKEN_KIND_NAME() {
        parseFail(token, prefix, "expected a type alias name");
    }
    assigned := expectSymbol(tokens, index + 1, ":=", prefix);
    typeWord := tokenAt(tokens, assigned);
    if typeWord.kind =!= TOKEN_KIND_KEYWORD() or typeWord.text =!= "type" {
        parseFail(typeWord, prefix, "expected type after :=");
    }
    parsed := parseType(tokens, assigned + 1, prefix);
    ended := consumeStatementEnd(tokens, parsed.next, prefix);
    (next = ended, name = token.text, detail = parsed.text,
        offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of type alias declarations, ending at EOF. */
parseTypeDeclarations := fn(tokens: Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    nodes: mut List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        parsed := parseTypeAlias(tokens, cursor, prefix);
        push_back(mut nodes, (kind = NODE_KIND_TYPE_ALIAS(), name = parsed.name, detail = parsed.detail,
            offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** Formats one parse node as `kind|name|detail|line:column|offset`. */
dumpNode := fn(node: Node): String {
    node.kind + "|" + node.name + "|" + node.detail + "|" + decimalText(node.line) + ":" +
        decimalText(node.column) + "|" + decimalText(node.offset)
}

/** Reports parsed nodes in source order, one per line. */
dumpNodes := fn(nodes: Nodes): Unit {
    loop nodes as node {
        outputLine(dumpNode(node));
    }
}
