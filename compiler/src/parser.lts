/* Lite-written parser core. Starts with the type grammar; declaration/body slices follow. */

importFlatAll "../../lib/core/int.lts";
importFlatAll "../../lib/core/text.lts";
importFlatAll "../../lib/core/source.lts";
importFlatAll "../../lib/core/diag.lts";
importFlatAll "../../lib/core/format.lts";
importFlatAll "lexer.lts";

/** One flat parse node: kind, name, detail text and source position. */
Node := type (kind: String, name: String, detail: String, offset: Int, line: Int, column: Int);

/** Parse nodes in source order. */
Nodes := type List<Node>;

/** Reports one token-positioned parser diagnostic and exits 2. */
parseFail := fn(token: Token, prefix: String, message: String): Unit {
    fail(prefix, decimalText(token.line) + ":" + decimalText(token.column) + ": " + message);
}

/** Number of tokens, including the final EOF token. */
tokenCount := fn(tokens: Tokens): Int {
    var count := 0;
    loop tokens as token {
        if token.kind == "EOF" { return count + 1; }
        count = count + 1;
    }
    count
}

/** Returns the token at `index`; the caller keeps `index` inside the counted list. */
tokenAt := fn(tokens: Tokens, index: Int): Token {
    tokens[index]
}

/** True when the token is the exact symbol `text`. */
isSymbol := fn(token: Token, text: String): Bool {
    token.kind == "Symbol" and token.text == text
}

/** Consumes the exact symbol or reports a parser diagnostic. */
expectSymbol := fn(tokens: Tokens, index: Int, text: String, prefix: String): Int {
    token := tokenAt(tokens, index);
    if not isSymbol(token, text) {
        parseFail(token, prefix, "expected " + text);
    }
    index + 1
}

/** Parses one type: a name, `List<T>` or a flat tuple with optional labels. */
parseType := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    if token.kind == "Name" {
        after := tokenAt(tokens, index + 1);
        if isSymbol(after, "<") {
            if token.text =!= "List" {
                parseFail(token, prefix, "unsupported generic type " + token.text);
            }
            inner := self(tokens, index + 2, prefix);
            closed := expectSymbol(tokens, inner.next, ">", prefix);
            return (next = closed, text = "List<" + inner.text + ">");
        }
        return (next = index + 1, text = token.text);
    }
    if isSymbol(token, "(") {
        var cursor := index + 1;
        var text := "(";
        var first := true;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), ")") { break; }
            var label := "";
            if tokenAt(tokens, cursor).kind == "Name" and isSymbol(tokenAt(tokens, cursor + 1), ":") {
                label = tokenAt(tokens, cursor).text + ": ";
                cursor = cursor + 2;
            }
            component := self(tokens, cursor, prefix);
            if not first { text = text + ", "; }
            text = text + label + component.text;
            first = false;
            cursor = component.next;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        closed := expectSymbol(tokens, cursor, ")", prefix);
        return (next = closed, text = text + ")");
    }
    parseFail(token, prefix, "expected a type");
    (next = index, text = "")
}

/** Precedence for one binary word or symbol, or 0 when it is not binary. */
binaryLevel := fn(text: String): Int {
    if text == "or" { 2 }
    else if text == "and" { 3 }
    else if text == "==" or text == "=!=" or text == "<" or text == "<!" or text == "<=" or
        text == "<!=" or text == ">" or text == ">!" or text == ">=" or text == ">!=" { 5 }
    else if text == "+" or text == "-" { 10 }
    else if text == "*" or text == "/" or text == "%" or text == ":/" or text == ":%" { 20 }
    else if text == "**" { 25 }
    else { 0 }
}

/** True when a token is a selected binary operator. */
isBinaryToken := fn(token: Token): Bool {
    if token.kind == "Keyword" and (token.text == "and" or token.text == "or") { return true; }
    token.kind == "Symbol" and binaryLevel(token.text) > 0
}

/**
 * Parses one expression and returns a fully parenthesized normalized text.
 * `if` value expressions are the next slice; this function reports them
 * explicitly instead of guessing a block boundary.
 */
parseExpression := fn(tokens: Tokens, index: Int, prefix: String, minimum: Int): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    var cursor := index;
    var leftText := "";
    var firstLabel := false;
    if token.kind == "Keyword" and token.text == "not" {
        operand := self(tokens, index + 1, prefix, 5);
        leftText = "(not " + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == "Symbol" and (token.text == "-" or token.text == "+") {
        operand := self(tokens, index + 1, prefix, 30);
        leftText = "(" + token.text + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == "Int" {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == "String" {
        leftText = "\"" + escapedTokenText(token.text) + "\"";
        cursor = index + 1;
    } else if token.kind == "Bool" {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == "Name" {
        leftText = token.text;
        cursor = index + 1;
        if isSymbol(tokenAt(tokens, cursor), "(") {
            var argText := "";
            var argCount := 0;
            cursor = cursor + 1;
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                if argCount > 0 { argText = argText + ", "; }
                if tokenAt(tokens, cursor).kind == "Keyword" and tokenAt(tokens, cursor).text == "mut" {
                    argText = argText + "mut ";
                    cursor = cursor + 1;
                }
                if tokenAt(tokens, cursor).kind == "Name" and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    argText = argText + tokenAt(tokens, cursor).text + " = ";
                    cursor = cursor + 2;
                }
                arg := self(tokens, cursor, prefix, 0);
                argText = argText + arg.text;
                cursor = arg.next;
                argCount = argCount + 1;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = leftText + "(" + argText + ")";
        }
    } else if isSymbol(token, "(") {
        cursor = index + 1;
        var firstText := "";
        if tokenAt(tokens, cursor).kind == "Name" and isSymbol(tokenAt(tokens, cursor + 1), "=") {
            firstText = tokenAt(tokens, cursor).text + " = ";
            firstLabel = true;
            cursor = cursor + 2;
        }
        first := self(tokens, cursor, prefix, 0);
        firstText = firstText + first.text;
        cursor = first.next;
        if firstLabel or isSymbol(tokenAt(tokens, cursor), ",") {
            var tupleText := "(" + firstText;
            if isSymbol(tokenAt(tokens, cursor), ",") { cursor = cursor + 1; }
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                tupleText = tupleText + ", ";
                if tokenAt(tokens, cursor).kind == "Name" and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    tupleText = tupleText + tokenAt(tokens, cursor).text + " = ";
                    cursor = cursor + 2;
                }
                component := self(tokens, cursor, prefix, 0);
                tupleText = tupleText + component.text;
                cursor = component.next;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = tupleText + ")";
        } else {
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = "(" + firstText + ")";
        }
    } else if isSymbol(token, "[") {
        cursor = index + 1;
        var listText := "[";
        var itemCount := 0;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), "]") { break; }
            if itemCount > 0 { listText = listText + ", "; }
            item := self(tokens, cursor, prefix, 0);
            listText = listText + item.text;
            cursor = item.next;
            itemCount = itemCount + 1;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        cursor = expectSymbol(tokens, cursor, "]", prefix);
        leftText = listText + "]";
    } else if token.kind == "Keyword" and token.text == "if" {
        parseFail(token, prefix, "if value expressions are not parsed yet");
        return (next = index, text = "");
    } else {
        parseFail(token, prefix, "expected an expression");
        return (next = index, text = "");
    }
    loop true {
        current := tokenAt(tokens, cursor);
        if isSymbol(current, ".") {
            member := tokenAt(tokens, cursor + 1);
            if member.kind == "Name" or member.kind == "Int" {
                leftText = leftText + "." + member.text;
                cursor = cursor + 2;
            } else {
                parseFail(member, prefix, "expected a field name after .");
            }
        } else if isSymbol(current, "[") {
            indexExpr := self(tokens, cursor + 1, prefix, 0);
            closed := expectSymbol(tokens, indexExpr.next, "]", prefix);
            leftText = leftText + "[" + indexExpr.text + "]";
            cursor = closed;
        } else {
            break;
        }
    }
    loop true {
        operator := tokenAt(tokens, cursor);
        if not isBinaryToken(operator) { break; }
        level := binaryLevel(operator.text);
        if level < minimum { break; }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(tokens, cursor + 1, prefix, rightMinimum);
        leftText = "(" + leftText + " " + operator.text + " " + right.text + ")";
        cursor = right.next;
    }
    (next = cursor, text = leftText)
}

/** Parses one declaration into scalar node fields. */
parseDeclaration := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    var cursor := index;
    var isVar := false;
    if tokenAt(tokens, cursor).kind == "Keyword" and tokenAt(tokens, cursor).text == "var" {
        isVar = true;
        cursor = cursor + 1;
    }
    token := tokenAt(tokens, cursor);
    if token.kind =!= "Name" {
        parseFail(token, prefix, "expected a declaration name");
    }
    name := token.text;
    cursor = cursor + 1;
    var detail := "";
    if isSymbol(tokenAt(tokens, cursor), ":=") {
        expression := parseExpression(tokens, cursor + 1, prefix, 0);
        detail = (if isVar { "var " } else { "" }) + ":= " + expression.text;
        cursor = expression.next;
    } else if isSymbol(tokenAt(tokens, cursor), ":") {
        cursor = cursor + 1;
        var mutableType := false;
        if tokenAt(tokens, cursor).kind == "Keyword" and tokenAt(tokens, cursor).text == "mut" {
            mutableType = true;
            cursor = cursor + 1;
        }
        parsedType := parseType(tokens, cursor, prefix);
        detail = (if isVar { "var " } else { "" }) +
            (if mutableType { "mut " } else { "" }) + parsedType.text;
        cursor = parsedType.next;
        if isSymbol(tokenAt(tokens, cursor), "=") {
            if isSymbol(tokenAt(tokens, cursor + 1), "?") {
                detail = detail + " = ?";
                cursor = cursor + 2;
            } else {
                expression := parseExpression(tokens, cursor + 1, prefix, 0);
                detail = detail + " = " + expression.text;
                cursor = expression.next;
            }
        } else if isSymbol(tokenAt(tokens, cursor), "?") {
            detail = detail + " = ?";
            cursor = cursor + 1;
        }
    } else {
        parseFail(tokenAt(tokens, cursor), prefix, "expected := or : after declaration name");
    }
    ended := expectSymbol(tokens, cursor, ";", prefix);
    (next = ended, name = name, detail = detail, offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of declarations, ending at EOF. */
parseDeclarations := fn(tokens: Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    nodes: mut List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == "EOF" { break; }
        parsed := parseDeclaration(tokens, cursor, prefix);
        push_back(mut nodes, (kind = "Declaration", name = parsed.name, detail = parsed.detail,
            offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** Parses one `Name := type Type;` declaration into scalar node fields. */
parseTypeAlias := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    token := tokenAt(tokens, index);
    if token.kind =!= "Name" {
        parseFail(token, prefix, "expected a type alias name");
    }
    assigned := expectSymbol(tokens, index + 1, ":=", prefix);
    typeWord := tokenAt(tokens, assigned);
    if typeWord.kind =!= "Keyword" or typeWord.text =!= "type" {
        parseFail(typeWord, prefix, "expected type after :=");
    }
    parsed := parseType(tokens, assigned + 1, prefix);
    ended := expectSymbol(tokens, parsed.next, ";", prefix);
    (next = ended, name = token.text, detail = parsed.text,
        offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of type alias declarations, ending at EOF. */
parseTypeDeclarations := fn(tokens: Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    nodes: mut List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == "EOF" { break; }
        parsed := parseTypeAlias(tokens, cursor, prefix);
        push_back(mut nodes, (kind = "TypeAlias", name = parsed.name, detail = parsed.detail,
            offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** Formats one parse node as `kind|name|detail|line:column|offset`. */
dumpNode := fn(node: Node): String {
    node.kind + "|" + node.name + "|" + node.detail + "|" + decimalText(node.line) + ":" +
        decimalText(node.column) + "|" + decimalText(node.offset)
}

/** Reports parsed nodes in source order, one per line. */
dumpNodes := fn(nodes: Nodes): Unit {
    loop nodes as node {
        report(dumpNode(node));
    }
}
