/* Lite-written checker foundation. */

lexer := import "./lexer.lts";
parser := import "./parser.lts";
numeric := import "./numeric-literals.lts";
integer := import "core/int";
diag := import "core/diag";
format := import "core/format";
io := import "core/io";
textLib := import "core/text";

/** One top-level symbol: kind, name, detail text and source position. */
list := import "core/list";
pub Symbol := type (kind: String, name: String, detail: String, offset: Int, line: Int, column: Int);

/** Top-level symbols in source order. */
pub Symbols := type List<Symbol>;

/** One local binding: name, reassignment mutability, block depth and origin kind. */
Local := type (name: String, typeText: String, mutable: Bool, writable: Bool, depth: Int, kind: String);

/** Local bindings in declaration order, removed when their block closes. */
Locals := type List<Local>;

/** Canonical symbol kind for a type alias. */
SYMBOL_KIND_TYPE := fn(): String { "type" }

/** Canonical symbol kind for a function. */
SYMBOL_KIND_FUNCTION := fn(): String { "function" }

/** Canonical symbol kind for a value declaration. */
SYMBOL_KIND_VALUE := fn(): String { "value" }

/** True for a built-in type name accepted by the bootstrap subset. */
isBuiltinType := fn(name: String): Bool {
    name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" or name == "List" or
    numeric.isNarrowNumericKind(name) or numeric.numericAliasKind(name) =!= ""
}

/** True when a read-only text list contains `target`. */
hasText := fn(values: List<String>, target: String): Bool {
    loop values as value {
        if value == target { return true; }
    }
    false
}

/** Returns the newest local with `name`, or -1. */
findLocal := fn(locals: Locals, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** Returns the index of a local with `name` directly in `depth`, or -1. */
findLocalAtDepth := fn(locals: Locals, name: String, depth: Int): Int {
    var index := 0;
    loop locals as local {
        if local.name == name and local.depth == depth { return index; }
        index = index + 1;
    }
    -1
}

/** True for the admitted built-in scalar type names. */
isScalarType := fn(typeText: String): Bool {
    typeText == "Int" or typeText == "Float" or typeText == "String" or typeText == "Bool" or typeText == "Unit" or
    numeric.isNarrowNumericKind(typeText)
}

/** Returns `List<T>`'s element type, or empty text when the type is not a list. */
listElementType := fn(typeText: String): String {
    size := textLib.length(typeText);
    if size > 5 and textLib.startsWithAt(typeText, 0, "List<") and textLib.at(typeText, size - 1) == ">" {
        return textLib.slice(typeText, 5, size - 1);
    }
    ""
}

/** Returns the index of the first top-level symbol named `name`, or -1. */
findSymbol := fn(symbols: Symbols, name: String): Int {
    var index := 0;
    loop symbols as symbol {
        if symbol.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Parses one function symbol's result type text. */
functionResultType := fn(symbol: Symbol): String {
    tokens := lexer.tokenize(symbol.detail, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    var depth := 0;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, "(") { depth = depth + 1; }
        else if parser.isSymbol(token, ")") {
            depth = depth - 1;
            if depth == 0 {
                cursor = cursor + 1;
                break;
            }
        }
        cursor = cursor + 1;
    }
    if not parser.isSymbol(parser.tokenAt(tokens, cursor), ":") { return ""; }
    parsed := parser.parseType(tokens, cursor + 1, "");
    parsed.text
}

/** Returns one function symbol's parameter types in order. */
functionParamTypes := fn(symbol: Symbol): List<String> {
    tokens := lexer.tokenize(symbol.detail, "");
    count := parser.tokenCount(tokens);
    types: mut List<String> = [];
    var cursor := 0;
    loop cursor < count {
        if parser.isSymbol(parser.tokenAt(tokens, cursor), "(") { break; }
        cursor = cursor + 1;
    }
    cursor = cursor + 1;
    loop cursor < count {
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") { break; }
        colon := parser.expectSymbol(tokens, cursor + 1, ":", "");
        parameterType := parser.parseType(tokens, colon, "");
        list.pushBack(mut types, parameterType.text);
        cursor = parameterType.next;
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ",") {
            cursor = cursor + 1;
        } else {
            break;
        }
    }
    types
}

/** Finds one binary/prefix operator at the first parenthesis depth of normalized text. */
topLevelOperator := fn(text: String): String {
    tokens := lexer.tokenize(text, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    var depth := 0;
    var found := "";
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, "(") {
            depth = depth + 1;
        } else if parser.isSymbol(token, ")") {
            depth = depth - 1;
        } else if depth == 1 {
            if (token.kind == lexer.TOKEN_KIND_KEYWORD() and (token.text == "and" or token.text == "or" or token.text == "not")) or
                (token.kind == lexer.TOKEN_KIND_SYMBOL() and (token.text == "+" or token.text == "-" or token.text == "*" or
                    token.text == "/" or token.text == "%" or token.text == ":/" or token.text == ":%" or
                    token.text == "**" or token.text == "==" or token.text == "=!=" or token.text == "<" or
                    token.text == "<!" or token.text == "<=" or token.text == "<!=" or token.text == ">" or
                    token.text == ">!" or token.text == ">=" or token.text == ">!=")) {
                found = token.text;
            }
        }
        cursor = cursor + 1;
    }
    found
}

/** Returns the first literal/name type token inside normalized text, or empty. */
firstOperandType := fn(symbols: Symbols, locals: Locals, text: String): String {
    tokens := lexer.tokenize(text, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_STRING() { return "String"; }
        if token.kind == lexer.TOKEN_KIND_INT() { return "Int"; }
        if token.kind == lexer.TOKEN_KIND_FLOAT() { return "Float"; }
        if token.kind == lexer.TOKEN_KIND_BOOL() { return "Bool"; }
        if token.kind == lexer.TOKEN_KIND_NAME() {
            index := findLocal(locals, token.text);
            if index >= 0 { return locals[index].typeText; }
        }
        cursor = cursor + 1;
    }
    ""
}

/** Resolves a bare type-alias name to its detail text. */
resolveAliasName := fn(symbols: Symbols, typeText: String, depth: Int): String {
    if depth > 16 { return typeText; }
    index := findSymbol(symbols, typeText);
    if index >= 0 and symbols[index].kind == SYMBOL_KIND_TYPE() {
        return resolveAliasName(symbols, symbols[index].detail, depth + 1);
    }
    numericKind := numeric.numericAliasKind(typeText);
    if numericKind == "" { typeText } else { numericKind }
}

/** Returns one tuple component type by label or positional index, or empty. */
tupleComponentType := fn(typeText: String, member: String): String {
    tokens := lexer.tokenize(typeText, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        if parser.isSymbol(parser.tokenAt(tokens, cursor), "(") { break; }
        cursor = cursor + 1;
    }
    cursor = cursor + 1;
    var index := 0;
    loop cursor < count {
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") { break; }
        var label := "";
        if parser.tokenKindAt(tokens, cursor) == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":") {
            label = parser.tokenTextAt(tokens, cursor);
            cursor = cursor + 2;
        }
        component := parser.parseType(tokens, cursor, "");
        namedMatch := label =!= "" and member == label;
        if namedMatch or member == integer.intText(index) {
            return component.text;
        }
        cursor = component.next;
        index = index + 1;
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ",") { cursor = cursor + 1; } else { break; }
    }
    ""
}

/** Trims trailing ASCII spaces from a normalized operand slice. */
trimTrailingSpaces := fn(text: String): String {
    var end := textLib.length(text);
    loop end > 0 and textLib.at(text, end - 1) == " " { end = end - 1; }
    textLib.slice(text, 0, end)
}

/** Splits a normalized binary expression `(left op right)` at top-level parenthesis depth 1. */
splitBinaryOperands := fn(text: String): (left: String, op: String, right: String) {
    tokens := lexer.tokenize(text, "");
    count := parser.tokenCount(tokens);
    if count < 5 or not parser.isSymbol(parser.tokenAt(tokens, 0), "(") or not parser.isSymbol(parser.tokenAt(tokens, count - 2), ")") {
        return (left = "", op = "", right = "");
    }
    var cursor := 1;
    var depth := 1;
    loop cursor < count - 2 {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, "(") or parser.isSymbol(token, "[") or parser.isSymbol(token, "{") {
            depth = depth + 1;
        } else if parser.isSymbol(token, ")") or parser.isSymbol(token, "]") or parser.isSymbol(token, "}") {
            depth = depth - 1;
        } else if depth == 1 and cursor > 1 and token.kind == lexer.TOKEN_KIND_SYMBOL() and
            (token.text == "+" or token.text == "-" or token.text == "*" or token.text == "/" or
                token.text == "%" or token.text == ":/" or token.text == ":%" or token.text == "**") {
            leftText := trimTrailingSpaces(textLib.slice(text, parser.tokenOffsetAt(tokens, 1), token.offset));
            rightStart := parser.tokenOffsetAt(tokens, cursor + 1);
            rightEnd := parser.tokenOffsetAt(tokens, count - 2);
            rightText := trimTrailingSpaces(textLib.slice(text, rightStart, rightEnd));
            return (left = leftText, op = token.text, right = rightText);
        }
        cursor = cursor + 1;
    }
    (left = "", op = "", right = "")
}

/** True when two type texts are compatible for the checked subset, allowing lossless numeric widening on scalars. */
typesCompatible := fn(symbols: Symbols, expected: String, actual: String): Bool {
    if expected == "" or actual == "" { return true; }
    expectedType := resolveAliasName(symbols, expected, 0);
    actualType := resolveAliasName(symbols, actual, 0);
    if isScalarType(expectedType) or isScalarType(actualType) {
        return expectedType == actualType or numeric.numericWidens(expectedType, actualType);
    }
    if textLib.startsWithAt(expectedType, 0, "List<") and textLib.startsWithAt(actualType, 0, "List<") {
        return resolveAliasName(symbols, listElementType(expectedType), 0) ==
            resolveAliasName(symbols, listElementType(actualType), 0);
    }
    if textLib.startsWithAt(expectedType, 0, "(") and textLib.startsWithAt(actualType, 0, "(") {
        return expectedType == actualType;
    }
    true
}

/** Infers a simple scalar/tuple/list/call/name type from normalized expression text. */
simpleType := fn(symbols: Symbols, locals: Locals, text: String): String {
    size := textLib.length(text);
    if size == 0 { return ""; }
    if text == "true" or text == "false" { return "Bool"; }
    if textLib.startsWithAt(text, 0, "\"") { return "String"; }
    first := textLib.at(text, 0);
    if textLib.isDigit(first) {
        token := parser.tokenAt(lexer.tokenize(text, ""), 0);
        if token.kind == lexer.TOKEN_KIND_FLOAT() { return "Float"; }
        return "Int";
    }
    if textLib.startsWithAt(text, 0, "(-") or textLib.startsWithAt(text, 0, "(+") {
        operand := self(symbols, locals, textLib.slice(text, 2, size - 1));
        resolvedOperand := resolveAliasName(symbols, operand, 0);
        if numeric.isNumericKind(resolvedOperand) { return resolvedOperand; }
        return "Int";
    }
    if textLib.startsWithAt(text, 0, "not ") { return "Bool"; }
    if textLib.startsWithAt(text, 0, "match {") {
        tokens := lexer.tokenize(text, "");
        count := parser.tokenCount(tokens);
        var cursor := 2;
        var depth := 1;
        var parens := 0;
        var brackets := 0;
        loop cursor < count {
            token := parser.tokenAt(tokens, cursor);
            if token.kind == lexer.TOKEN_KIND_EOF() { return ""; }
            if depth == 1 and parens == 0 and brackets == 0 and
                token.kind == lexer.TOKEN_KIND_NAME() and token.text == "_" and
                parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                if parser.isSymbol(parser.tokenAt(tokens, cursor + 2), "}") { return "Unit"; }
                startOffset := parser.tokenOffsetAt(tokens, cursor + 2);
                var armCursor := cursor + 2;
                var armDepth := 1;
                var endOffset := 0;
                loop armCursor < count {
                    armToken := parser.tokenAt(tokens, armCursor);
                    if armToken.kind == lexer.TOKEN_KIND_EOF() { return ""; }
                    if parser.isSymbol(armToken, "{") {
                        armDepth = armDepth + 1;
                    } else if parser.isSymbol(armToken, "}") {
                        armDepth = armDepth - 1;
                        if armDepth == 0 {
                            endOffset = armToken.offset;
                            break;
                        }
                    }
                    armCursor = armCursor + 1;
                }
                loop endOffset > startOffset and textLib.at(text, endOffset - 1) == " " {
                    endOffset = endOffset - 1;
                }
                if endOffset <= startOffset { return "Unit"; }
                fallbackText := textLib.slice(text, startOffset, endOffset);
                if fallbackText == "Unit" { return "Unit"; }
                return self(symbols, locals, fallbackText);
            }
            if parser.isSymbol(token, "{") {
                depth = depth + 1;
            } else if parser.isSymbol(token, "}") {
                depth = depth - 1;
                if depth == 0 { return ""; }
            } else if parser.isSymbol(token, "(") {
                parens = parens + 1;
            } else if parser.isSymbol(token, ")") {
                if parens > 0 { parens = parens - 1; }
            } else if parser.isSymbol(token, "[") {
                brackets = brackets + 1;
            } else if parser.isSymbol(token, "]") {
                if brackets > 0 { brackets = brackets - 1; }
            }
            cursor = cursor + 1;
        }
        return "";
    }
    if textLib.startsWithAt(text, 0, "[") {
        if size == 2 { return ""; }
        tokens := lexer.tokenize(text, "");
        count := parser.tokenCount(tokens);
        var cursor := 1;
        var depth := 0;
        var endOffset := 0;
        loop cursor < count {
            token := parser.tokenAt(tokens, cursor);
            if parser.isSymbol(token, "(") or parser.isSymbol(token, "[") or parser.isSymbol(token, "{") {
                depth = depth + 1;
            } else if parser.isSymbol(token, ")") or parser.isSymbol(token, "]") or parser.isSymbol(token, "}") {
                if depth == 0 and parser.isSymbol(token, "]") {
                    endOffset = token.offset;
                    break;
                }
                depth = depth - 1;
            } else if parser.isSymbol(token, ",") and depth == 0 {
                endOffset = token.offset;
                break;
            }
            cursor = cursor + 1;
        }
        if endOffset == 0 { return ""; }
        elementType := simpleType(symbols, locals, textLib.slice(text, parser.tokenOffsetAt(tokens, 1), endOffset));
        if elementType == "" { return ""; }
        return "List<" + elementType + ">";
    }
    if textLib.startsWithAt(text, 0, "(") {
        operator := topLevelOperator(text);
        if operator == "and" or operator == "or" or operator == "not" or
            operator == "==" or operator == "=!=" or operator == "<" or operator == "<!" or
            operator == "<=" or operator == "<!=" or operator == ">" or operator == ">!" or
            operator == ">=" or operator == ">!=" {
            return "Bool";
        }
        if operator == "**" { return "Float"; }
        if operator == "+" or operator == "-" or operator == "*" or operator == "/" or
            operator == "%" or operator == ":/" or operator == ":%" {
            split := splitBinaryOperands(text);
            if split.op =!= "" {
                leftType := resolveAliasName(symbols, simpleType(symbols, locals, split.left), 0);
                rightType := resolveAliasName(symbols, simpleType(symbols, locals, split.right), 0);
                if operator == "+" and (leftType == "String" or rightType == "String") { return "String"; }
                promoted := numeric.promoteNumericKind(leftType, rightType);
                if promoted =!= "" { return promoted; }
                if numeric.isFloatKind(leftType) { return leftType; }
                if numeric.isFloatKind(rightType) { return rightType; }
                return "Int";
            }
            if operator == "+" and firstOperandType(symbols, locals, text) == "String" { return "String"; }
            return "Int";
        }
        if textLib.indexOfText(text, ",", 0) >= 0 or textLib.indexOfText(text, " = ", 0) >= 0 { return ""; }
        if size >= 2 { return simpleType(symbols, locals, textLib.slice(text, 1, size - 1)); }
        return "";
    }
    if textLib.isNameStart(first) {
        var field := -1;
        var fieldCursor := 0;
        loop fieldCursor < size {
            if textLib.at(text, fieldCursor) == "." { field = fieldCursor; }
            fieldCursor = fieldCursor + 1;
        }
        if field > 0 {
            baseText := textLib.slice(text, 0, field);
            member := textLib.slice(text, field + 1, size);
            baseType := simpleType(symbols, locals, baseText);
            resolved := resolveAliasName(symbols, baseType, 0);
            return tupleComponentType(resolved, member);
        }
        indexAt := textLib.indexOfText(text, "[", 0);
        if indexAt > 0 and textLib.at(text, size - 1) == "]" {
            baseText := textLib.slice(text, 0, indexAt);
            indexText := textLib.slice(text, indexAt + 1, size - 1);
            baseType := simpleType(symbols, locals, baseText);
            resolved := resolveAliasName(symbols, baseType, 0);
            if textLib.startsWithAt(resolved, 0, "List<") { return listElementType(resolved); }
            return tupleComponentType(resolved, indexText);
        }
        index := findLocal(locals, text);
        if index >= 0 { return locals[index].typeText; }
        call := textLib.indexOfText(text, "(", 0);
        if call > 0 {
            name := textLib.slice(text, 0, call);
            functionIndex := findSymbol(symbols, name);
            if functionIndex >= 0 and symbols[functionIndex].kind == SYMBOL_KIND_FUNCTION() {
                return functionResultType(symbols[functionIndex]);
            }
            if name == "inputAll" or name == "textAt" or name == "textSlice" { return "String"; }
            if name == "textLength" { return "Int"; }
            if name == "inputFloat" { return "Float"; }
        }
    }
    ""
}

/** Recognizes direct/grouped signed-or-unsigned numeric literals admitted into an expected numeric width without widening arbitrary values. */
contextualNumericLiteralType := fn(text: String, expectedType: String): String {
    tokens := lexer.tokenize(text, "");
    var first := 0;
    var last := parser.tokenCount(tokens) - 2;
    loop first < last and parser.isSymbol(parser.tokenAt(tokens, first), "(") and parser.isSymbol(parser.tokenAt(tokens, last), ")") {
        var depth := 0;
        var cursor := first;
        loop cursor <= last {
            if parser.isSymbol(parser.tokenAt(tokens, cursor), "(") { depth = depth + 1; }
            else if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") {
                depth = depth - 1;
                if depth == 0 { break; }
            }
            cursor = cursor + 1;
        }
        if cursor =!= last { break; }
        first = first + 1;
        last = last - 1;
    }
    negative := parser.isSymbol(parser.tokenAt(tokens, first), "-");
    if negative { first = first + 1; }
    if first =!= last { return ""; }
    kind := parser.tokenKindAt(tokens, first);
    literal := parser.tokenTextAt(tokens, first);
    scanned := numeric.scanNumericLiteral(literal, 0);
    if kind == lexer.TOKEN_KIND_FLOAT() {
        if expectedType == "Float32" {
            digits := textLib.slice(literal, 0, scanned.integerEnd) + textLib.slice(literal, scanned.fractionStart, scanned.fractionEnd);
            if numeric.finiteFloat32Digits(digits, scanned.fractionEnd - scanned.fractionStart, scanned.exponent) { return "Float32"; }
            return "Float";
        }
        return "";
    }
    if kind =!= lexer.TOKEN_KIND_INT() { return ""; }
    if scanned.outsideInt or (not negative and scanned.magnitude == -9223372036854775808) { return ""; }
    value := if negative { scanned.magnitude } else { 0 - scanned.magnitude };
    if numeric.isNarrowIntKind(expectedType) and numeric.intKindFits(expectedType, value) { return expectedType; }
    if expectedType == "Float32" and numeric.intExactlyFloat32(value) { return "Float32"; }
    if expectedType == "Float" and numeric.intExactlyFloat(value) { return "Float"; }
    ""
}

/** Infers a scalar or contextual list literal expression with fixed-width numeric literal admission. */
contextualSimpleType := fn(symbols: Symbols, locals: Locals, text: String, expected: String): String {
    resolvedExpected := resolveAliasName(symbols, expected, 0);
    if textLib.startsWithAt(resolvedExpected, 0, "List<") and textLib.startsWithAt(text, 0, "[") {
        elementExpected := listElementType(resolvedExpected);
        tokens := lexer.tokenize(text, "");
        count := parser.tokenCount(tokens);
        var cursor := 1;
        if parser.isSymbol(parser.tokenAt(tokens, cursor), "]") { return resolvedExpected; }
        var itemStart := parser.tokenOffsetAt(tokens, cursor);
        var depth := 0;
        var allFit := true;
        loop cursor < count {
            token := parser.tokenAt(tokens, cursor);
            if token.kind == lexer.TOKEN_KIND_EOF() { allFit = false; break; }
            if parser.isSymbol(token, "(") or parser.isSymbol(token, "[") or parser.isSymbol(token, "{") {
                depth = depth + 1;
            } else if parser.isSymbol(token, ")") or parser.isSymbol(token, "]") or parser.isSymbol(token, "}") {
                if depth == 0 and parser.isSymbol(token, "]") {
                    itemText := textLib.slice(text, itemStart, token.offset);
                    itemType := self(symbols, locals, itemText, elementExpected);
                    if not typesCompatible(symbols, elementExpected, itemType) { allFit = false; }
                    break;
                }
                depth = depth - 1;
            } else if parser.isSymbol(token, ",") and depth == 0 {
                itemText := textLib.slice(text, itemStart, token.offset);
                itemType := self(symbols, locals, itemText, elementExpected);
                if not typesCompatible(symbols, elementExpected, itemType) { allFit = false; break; }
                if cursor + 1 < count { itemStart = parser.tokenOffsetAt(tokens, cursor + 1); }
            }
            cursor = cursor + 1;
        }
        if allFit { return "List<" + resolveAliasName(symbols, elementExpected, 0) + ">"; }
    }
    contextual := contextualNumericLiteralType(text, resolvedExpected);
    if contextual =!= "" { return contextual; }
    simpleType(symbols, locals, text)
}

/** Builds a token-shaped source position for a symbol diagnostic. */
symbolToken := fn(symbol: Symbol): lexer.Token {
    (kind = symbol.kind, text = symbol.name, offset = symbol.offset, line = symbol.line, column = symbol.column)
}

/** Reports one token-positioned checker diagnostic and exits 2. */
checkFail := fn(token: lexer.Token, prefix: String, message: String): Unit {
    diag.fail(prefix, format.decimalText(token.line) + ":" + format.decimalText(token.column) + ": " + message);
}

/** Skips one balanced `{ ... }` sequence and returns the position after it. */
skipBraces := fn(tokens: lexer.Tokens, index: Int, prefix: String): Int {
    var cursor := parser.expectSymbol(tokens, index, "{", prefix);
    var depth := 1;
    loop true {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() {
            checkFail(token, prefix, "unterminated block");
        }
        if parser.isSymbol(token, "{") {
            depth = depth + 1;
        } else if parser.isSymbol(token, "}") {
            depth = depth - 1;
            if depth == 0 { return cursor + 1; }
        }
        cursor = cursor + 1;
    }
    cursor
}

/** Retains sequential value bindings in source order; other duplicate symbol kinds remain unsupported. */
addSymbol := fn(symbols: Symbols, symbol: Symbol, prefix: String): Symbols {
    previous := findSymbol(symbols, symbol.name);
    if previous >= 0 and (symbol.kind =!= SYMBOL_KIND_VALUE() or symbols[previous].kind =!= SYMBOL_KIND_VALUE()) {
        checkFail((kind = symbol.kind, text = symbol.name, offset = symbol.offset,
            line = symbol.line, column = symbol.column), prefix, "duplicate top-level name " + symbol.name);
    }
    result: mut List<Symbol> = [];
    loop symbols as item { list.pushBack(mut result, item); }
    list.pushBack(mut result, symbol);
    result
}

/** Parses one function signature and skips its body into scalar symbol fields. */
parseFunctionSymbol := fn(tokens: lexer.Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    nameToken := parser.tokenAt(tokens, index);
    afterName := parser.expectSymbol(tokens, index + 1, ":=", prefix);
    functionWord := parser.tokenAt(tokens, afterName);
    if functionWord.kind =!= lexer.TOKEN_KIND_KEYWORD() or functionWord.text =!= "fn" {
        checkFail(functionWord, prefix, "expected fn after :=");
    }
    var cursor := parser.expectSymbol(tokens, afterName + 1, "(", prefix);
    var detail := "(";
    var parameterCount := 0;
    parameterNames: mut List<String> = [];
    loop true {
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") { break; }
        parameter := parser.tokenAt(tokens, cursor);
        if parameter.kind =!= lexer.TOKEN_KIND_NAME() {
            checkFail(parameter, prefix, "expected a parameter name");
        }
        if hasText(parameterNames, parameter.text) {
            checkFail(parameter, prefix, "duplicate parameter " + parameter.text);
        }
        list.pushBack(mut parameterNames, parameter.text);
        colon := parser.expectSymbol(tokens, cursor + 1, ":", prefix);
        parameterType := parser.parseType(tokens, colon, prefix);
        if parameterCount > 0 { detail = detail + ", "; }
        detail = detail + parameter.text + ": " + parameterType.text;
        parameterCount = parameterCount + 1;
        cursor = parameterType.next;
        if parser.isSymbol(parser.tokenAt(tokens, cursor), ",") {
            cursor = cursor + 1;
        } else {
            break;
        }
    }
    cursor = parser.expectSymbol(tokens, cursor, ")", prefix);
    resultColon := parser.expectSymbol(tokens, cursor, ":", prefix);
    resultType := parser.parseType(tokens, resultColon, prefix);
    detail = detail + "): " + resultType.text;
    var afterBody := skipBraces(tokens, resultType.next, prefix);
    if parser.isSymbol(parser.tokenAt(tokens, afterBody), ";") { afterBody = afterBody + 1; }
    (next = afterBody, name = nameToken.text, detail = detail,
        offset = nameToken.offset, line = nameToken.line, column = nameToken.column)
}

/** Collects top-level symbols, retaining each sequential value declaration. */
collectSymbols := fn(tokens: lexer.Tokens, prefix: String): Symbols {
    count := parser.tokenCount(tokens);
    var symbols: mut List<Symbol> = [];
    var cursor := 0;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, ";") { cursor = cursor + 1; continue; }
        if token.kind == lexer.TOKEN_KIND_EOF() { break; }
        if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") and
            parser.tokenKindAt(tokens, cursor + 2) == lexer.TOKEN_KIND_KEYWORD() and parser.tokenTextAt(tokens, cursor + 2) == "type" {
            afterName := parser.expectSymbol(tokens, cursor + 1, ":=", prefix);
            parsedType := parser.parseType(tokens, afterName + 1, prefix);
            ended := parser.expectSymbol(tokens, parsedType.next, ";", prefix);
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_TYPE(), name = token.text, detail = parsedType.text,
                offset = token.offset, line = token.line, column = token.column), prefix);
            cursor = ended;
        } else if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") and
            parser.tokenKindAt(tokens, cursor + 2) == lexer.TOKEN_KIND_KEYWORD() and parser.tokenTextAt(tokens, cursor + 2) == "fn" {
            parsed := parseFunctionSymbol(tokens, cursor, prefix);
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_FUNCTION(), name = parsed.name, detail = parsed.detail,
                offset = parsed.offset, line = parsed.line, column = parsed.column), prefix);
            cursor = parsed.next;
        } else if (token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "var") or
            (token.kind == lexer.TOKEN_KIND_NAME() and (parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") or
                parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":"))) {
            declaration := parser.parseDeclaration(tokens, cursor, prefix);
            nameToken := parser.tokenAt(tokens, cursor + (if token.kind == lexer.TOKEN_KIND_KEYWORD() { 1 } else { 0 }));
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_VALUE(), name = declaration.name, detail = declaration.detail,
                offset = nameToken.offset, line = nameToken.line, column = nameToken.column), prefix);
            cursor = declaration.next;
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "loop" {
            var body := cursor + 1;
            if not parser.isSymbol(parser.tokenAt(tokens, body), "{") {
                sequence := parser.parseExpression(tokens, body, prefix, 0);
                body = sequence.next;
                if parser.tokenKindAt(tokens, body) == lexer.TOKEN_KIND_NAME() and parser.tokenTextAt(tokens, body) == "as" {
                    receiver := parser.tokenAt(tokens, body + 1);
                    if receiver.kind =!= lexer.TOKEN_KIND_NAME() { checkFail(receiver, prefix, "expected a loop item name after as"); }
                    body = body + 2;
                }
            }
            cursor = skipBraces(tokens, body, prefix);
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "match" {
            if not parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                checkFail(token, prefix, "unsupported feature \"match\"");
            }
            cursor = skipBraces(tokens, cursor + 1, prefix);
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
        } else if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "=") {
            value := parser.parseExpression(tokens, cursor + 2, prefix, 0);
            cursor = parser.consumeStatementEnd(tokens, value.next, prefix);
        } else {
            expression := parser.parseExpression(tokens, cursor, prefix, 0);
            cursor = expression.next;
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
        }
    }
    symbols
}

/** Validates subjectless Boolean match arms embedded inside one expression token span. */
checkEmbeddedMatches := fn(tokens: lexer.Tokens, start: Int, end: Int, symbols: Symbols, locals: Locals, prefix: String): Unit {
    var cursor := start;
    loop cursor < end {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() { break; }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "match" {
            if not parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                checkFail(token, prefix, "unsupported feature \"match\"");
            }
            var armCursor := cursor + 2;
            var sawFallback := false;
            loop true {
                if armCursor >= end {
                    checkFail(token, prefix, "expected } to close match");
                }
                if parser.isSymbol(parser.tokenAt(tokens, armCursor), ";") {
                    armCursor = armCursor + 1;
                    continue;
                }
                armToken := parser.tokenAt(tokens, armCursor);
                if armToken.kind == lexer.TOKEN_KIND_EOF() {
                    checkFail(armToken, prefix, "expected } to close match");
                }
                if parser.isSymbol(armToken, "}") {
                    if not sawFallback {
                        checkFail(armToken, prefix, "subjectless match requires a final _ fallback arm");
                    }
                    armCursor = armCursor + 1;
                    break;
                }
                if sawFallback {
                    checkFail(armToken, prefix, "match fallback _ must be the final arm");
                }
                var armOpen := -1;
                if armToken.kind == lexer.TOKEN_KIND_NAME() and armToken.text == "_" and
                    parser.isSymbol(parser.tokenAt(tokens, armCursor + 1), "{") {
                    sawFallback = true;
                    armOpen = armCursor + 1;
                } else {
                    brace := parser.scanMatchArmBrace(tokens, armCursor);
                    if brace < 0 or brace >= end {
                        checkFail(armToken, prefix, "expected { after match arm condition");
                    }
                    if brace == armCursor {
                        checkFail(armToken, prefix, "match arm header requires grouping for { ... } expressions");
                    }
                    condition := parser.parseExpression(tokens, armCursor, prefix, 0);
                    if condition.next > brace {
                        checkFail(parser.tokenAt(tokens, brace), prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                    }
                    armOpen = parser.expectSymbol(tokens, condition.next, "{", prefix) - 1;
                    self(tokens, armCursor, brace, symbols, locals, prefix);
                    conditionType := simpleType(symbols, locals, condition.text);
                    if isScalarType(conditionType) and conditionType =!= "Bool" {
                        checkFail(armToken, prefix, "match arm condition must be Bool");
                    }
                }
                afterArm := skipBraces(tokens, armOpen, prefix);
                self(tokens, armOpen + 1, afterArm - 1, symbols, locals, prefix);
                armCursor = afterArm;
            }
            cursor = armCursor;
            continue;
        }
        cursor = cursor + 1;
    }
}

/** Checks block-local declarations, parameter scopes and statement assignments. */
checkLocals := fn(tokens: lexer.Tokens, prefix: String, symbols: Symbols): Unit {
    count := parser.tokenCount(tokens);
    locals: mut List<Local> = [];
    var localCount := 0;
    var depth := 0;
    var parens := 0;
    var brackets := 0;
    var cursor := 0;
    var functionResult := "";
    var functionBodyDepth := -1;
    var pendingLoop := false;
    var loopDepth := 0;
    loopBodies: mut List<Int> = [];
    var pendingMatch := false;
    var matchCount := 0;
    matchDepths: mut List<Int> = [];
    matchParens: mut List<Int> = [];
    matchBrackets: mut List<Int> = [];
    matchFallbacks: mut List<Int> = [];
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() { break; }
        if matchCount > 0 and depth == matchDepths[matchCount - 1] and
            parens == matchParens[matchCount - 1] and brackets == matchBrackets[matchCount - 1] {
            if parser.isSymbol(token, ";") { cursor = cursor + 1; continue; }
            if parser.isSymbol(token, "}") {
                if matchFallbacks[matchCount - 1] == 0 {
                    checkFail(token, prefix, "subjectless match requires a final _ fallback arm");
                }
                list.popBack(mut matchDepths);
                list.popBack(mut matchParens);
                list.popBack(mut matchBrackets);
                list.popBack(mut matchFallbacks);
                matchCount = matchCount - 1;
            } else {
                if matchFallbacks[matchCount - 1] =!= 0 {
                    checkFail(token, prefix, "match fallback _ must be the final arm");
                }
                if token.kind == lexer.TOKEN_KIND_NAME() and token.text == "_" and
                    parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                    list.popBack(mut matchFallbacks);
                    list.pushBack(mut matchFallbacks, 1);
                    depth = depth + 1;
                    cursor = cursor + 2;
                    continue;
                }
                brace := parser.scanMatchArmBrace(tokens, cursor);
                if brace < 0 { checkFail(token, prefix, "expected { after match arm condition"); }
                if brace == cursor {
                    checkFail(token, prefix, "match arm header requires grouping for { ... } expressions");
                }
                condition := parser.parseExpression(tokens, cursor, prefix, 0);
                if condition.next > brace {
                    checkFail(parser.tokenAt(tokens, brace), prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                }
                armOpen := parser.expectSymbol(tokens, condition.next, "{", prefix) - 1;
                checkEmbeddedMatches(tokens, cursor, brace, symbols, locals, prefix);
                conditionType := simpleType(symbols, locals, condition.text);
                if isScalarType(conditionType) and conditionType =!= "Bool" {
                    checkFail(token, prefix, "match arm condition must be Bool");
                }
                depth = depth + 1;
                cursor = armOpen + 1;
                continue;
            }
        }
        if parser.isSymbol(token, "{") {
            if pendingLoop {
                list.pushBack(mut loopBodies, depth + 1);
                loopDepth = loopDepth + 1;
                pendingLoop = false;
            }
            if pendingMatch {
                list.pushBack(mut matchDepths, depth + 1);
                list.pushBack(mut matchParens, parens);
                list.pushBack(mut matchBrackets, brackets);
                list.pushBack(mut matchFallbacks, 0);
                matchCount = matchCount + 1;
                pendingMatch = false;
            }
            depth = depth + 1;
            cursor = cursor + 1;
            continue;
        }
        if parser.isSymbol(token, "}") {
            if loopDepth > 0 and loopBodies[loopDepth - 1] == depth {
                list.popBack(mut loopBodies);
                loopDepth = loopDepth - 1;
            }
            loop localCount > 0 and locals[localCount - 1].depth >= depth {
                list.popBack(mut locals);
                localCount = localCount - 1;
            }
            if functionBodyDepth == depth {
                functionResult = "";
                functionBodyDepth = -1;
            }
            depth = depth - 1;
            cursor = cursor + 1;
            continue;
        }
        if parser.isSymbol(token, "(") { parens = parens + 1; cursor = cursor + 1; continue; }
        if parser.isSymbol(token, ")") { parens = parens - 1; cursor = cursor + 1; continue; }
        if parser.isSymbol(token, "[") { brackets = brackets + 1; cursor = cursor + 1; continue; }
        if parser.isSymbol(token, "]") { brackets = brackets - 1; cursor = cursor + 1; continue; }
        if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") and
            parser.tokenKindAt(tokens, cursor + 2) == lexer.TOKEN_KIND_KEYWORD() and parser.tokenTextAt(tokens, cursor + 2) == "type" {
            afterName := parser.expectSymbol(tokens, cursor + 1, ":=", prefix);
            aliasType := parser.parseType(tokens, afterName + 1, prefix);
            cursor = parser.expectSymbol(tokens, aliasType.next, ";", prefix);
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") and
            parser.tokenKindAt(tokens, cursor + 2) == lexer.TOKEN_KIND_KEYWORD() and parser.tokenTextAt(tokens, cursor + 2) == "fn" {
            var parameterCursor := parser.expectSymbol(tokens, cursor + 3, "(", prefix);
            loop true {
                if parser.isSymbol(parser.tokenAt(tokens, parameterCursor), ")") { break; }
                parameter := parser.tokenAt(tokens, parameterCursor);
                if parameter.kind =!= lexer.TOKEN_KIND_NAME() {
                    checkFail(parameter, prefix, "expected a parameter name");
                }
                if findLocalAtDepth(locals, parameter.text, depth + 1) >= 0 {
                    checkFail(parameter, prefix, "duplicate parameter " + parameter.text);
                }
                colon := parser.expectSymbol(tokens, parameterCursor + 1, ":", prefix);
                parameterType := parser.parseType(tokens, colon, prefix);
                list.pushBack(mut locals, (name = parameter.text, typeText = parameterType.text,
                    mutable = false, writable = false, depth = depth + 1, kind = "parameter"));
                localCount = localCount + 1;
                parameterCursor = parameterType.next;
                if parser.isSymbol(parser.tokenAt(tokens, parameterCursor), ",") {
                    parameterCursor = parameterCursor + 1;
                } else {
                    break;
                }
            }
            parameterCursor = parser.expectSymbol(tokens, parameterCursor, ")", prefix);
            resultColon := parser.expectSymbol(tokens, parameterCursor, ":", prefix);
            resultType := parser.parseType(tokens, resultColon, prefix);
            functionResult = resultType.text;
            functionBodyDepth = depth + 1;
            cursor = resultType.next;
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "return" {
            if functionBodyDepth < 0 {
                checkFail(token, prefix, "return outside function");
            }
            afterReturn := cursor + 1;
            if parser.isSymbol(parser.tokenAt(tokens, afterReturn), ";") or parser.isSymbol(parser.tokenAt(tokens, afterReturn), "}") or
                parser.tokenKindAt(tokens, afterReturn) == lexer.TOKEN_KIND_EOF() {
                if functionResult =!= "" and functionResult =!= "Unit" {
                    checkFail(token, prefix, "return requires a value");
                }
                cursor = afterReturn;
            } else {
                value := parser.parseExpression(tokens, afterReturn, prefix, 0);
                checkEmbeddedMatches(tokens, afterReturn, value.next, symbols, locals, prefix);
                inferred := contextualSimpleType(symbols, locals, value.text, functionResult);
                if not typesCompatible(symbols, functionResult, inferred) {
                    checkFail(token, prefix, "cannot return " + inferred + " from function returning " + functionResult);
                }
                cursor = value.next;
            }
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and (token.text == "break" or token.text == "continue") {
            if loopDepth == 0 {
                checkFail(token, prefix, token.text + " outside loop");
            }
            cursor = cursor + 1;
            if parser.isSymbol(parser.tokenAt(tokens, cursor), "@") { cursor = cursor + 2; }
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "if" {
            condition := parser.parseExpression(tokens, cursor + 1, prefix, 0);
            checkEmbeddedMatches(tokens, cursor + 1, condition.next, symbols, locals, prefix);
            conditionType := simpleType(symbols, locals, condition.text);
            if isScalarType(conditionType) and conditionType =!= "Bool" {
                checkFail(token, prefix, "if condition must be Bool");
            }
            cursor = condition.next;
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "match" {
            if not parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                checkFail(token, prefix, "unsupported feature \"match\"");
            }
            pendingMatch = true;
            cursor = cursor + 1;
            continue;
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "loop" {
            if parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "{") {
                pendingLoop = true;
                cursor = cursor + 1;
                continue;
            }
            source := parser.parseExpression(tokens, cursor + 1, prefix, 0);
            checkEmbeddedMatches(tokens, cursor + 1, source.next, symbols, locals, prefix);
            if parser.tokenKindAt(tokens, source.next) == lexer.TOKEN_KIND_NAME() and parser.tokenTextAt(tokens, source.next) == "as" {
                itemToken := parser.tokenAt(tokens, source.next + 1);
                if itemToken.kind =!= lexer.TOKEN_KIND_NAME() {
                    checkFail(itemToken, prefix, "expected a loop item name after as");
                }
                sourceType := simpleType(symbols, locals, source.text);
                itemType := listElementType(sourceType);
                list.pushBack(mut locals, (name = itemToken.text, typeText = itemType, mutable = false,
                    writable = false, depth = depth + 1, kind = "loop item"));
                localCount = localCount + 1;
                cursor = source.next + 2;
                pendingLoop = true;
            } else {
                conditionType := simpleType(symbols, locals, source.text);
                if isScalarType(conditionType) and conditionType =!= "Bool" {
                    checkFail(token, prefix, "loop condition must be Bool");
                }
                cursor = source.next;
                pendingLoop = true;
            }
            continue;
        }
        if (token.kind == lexer.TOKEN_KIND_KEYWORD() and token.text == "var") or
            (token.kind == lexer.TOKEN_KIND_NAME() and (parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":=") or
                parser.isSymbol(parser.tokenAt(tokens, cursor + 1), ":"))) {
            declaration := parser.parseDeclaration(tokens, cursor, prefix);
            nameToken := parser.tokenAt(tokens, cursor + (if token.kind == lexer.TOKEN_KIND_KEYWORD() { 1 } else { 0 }));
            mutable := textLib.startsWithAt(declaration.detail, 0, "var ");
            var writable := false;
            var work := declaration.detail;
            if mutable { work = textLib.slice(work, 4, textLib.length(work)); }
            var typeText := "";
            var initText := "";
            if textLib.startsWithAt(work, 0, ":= ") {
                initText = textLib.slice(work, 3, textLib.length(work));
                typeText = simpleType(symbols, locals, initText);
            } else {
                if textLib.startsWithAt(work, 0, "mut ") {
                    writable = true;
                    work = textLib.slice(work, 4, textLib.length(work));
                }
                split := textLib.indexOfText(work, " = ", 0);
                if split >= 0 {
                    typeText = textLib.slice(work, 0, split);
                    initText = textLib.slice(work, split + 3, textLib.length(work));
                } else {
                    typeText = work;
                }
                if initText =!= "" and initText =!= "?" {
                    inferred := contextualSimpleType(symbols, locals, initText, typeText);
                    if not typesCompatible(symbols, typeText, inferred) {
                        checkFail(nameToken, prefix, "cannot initialize " + typeText + " with " + inferred);
                    }
                }
            }
            checkEmbeddedMatches(tokens, cursor, declaration.next, symbols, locals, prefix);
            list.pushBack(mut locals, (name = declaration.name, typeText = typeText, mutable = mutable,
                writable = writable, depth = depth, kind = "local"));
            localCount = localCount + 1;
            cursor = declaration.next;
            continue;
        }
        if parens == 0 and brackets == 0 and token.kind == lexer.TOKEN_KIND_NAME() and
            parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "=") {
            previous := parser.tokenAt(tokens, cursor - 1);
            if parser.isSymbol(previous, "(") or parser.isSymbol(previous, ",") {
                cursor = cursor + 1;
                continue;
            }
            index := findLocal(locals, token.text);
            if index < 0 {
                checkFail(token, prefix, "unknown local " + token.text);
            }
            if not locals[index].mutable {
                checkFail(token, prefix, "cannot assign to immutable local " + token.text);
            }
            value := parser.parseExpression(tokens, cursor + 2, prefix, 0);
            checkEmbeddedMatches(tokens, cursor + 2, value.next, symbols, locals, prefix);
            localType := locals[index].typeText;
            inferred := contextualSimpleType(symbols, locals, value.text, localType);
            if not typesCompatible(symbols, localType, inferred) {
                checkFail(token, prefix, "cannot assign " + inferred + " to " + localType + " local " + token.text);
            }
            cursor = value.next;
            if parser.isSymbol(parser.tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
            continue;
        }
        cursor = cursor + 1;
    }
}

/** Validates every type name inside one type or signature text. */
validateTypeText := fn(symbols: Symbols, text: String, depth: Int, symbol: Symbol, prefix: String): Unit {
    if depth > 16 {
        checkFail(symbolToken(symbol), prefix, "recursive type alias " + symbol.name);
    }
    tokens := lexer.tokenize(text, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() { break; }
        if token.kind == lexer.TOKEN_KIND_NAME() {
            next := parser.tokenAt(tokens, cursor + 1);
            if parser.isSymbol(next, ":") {
                cursor = cursor + 1;
            } else if not isBuiltinType(token.text) {
                index := findSymbol(symbols, token.text);
                if index < 0 {
                    checkFail(symbolToken(symbol), prefix, "unknown type " + token.text);
                }
                alias := symbols[index];
                if alias.kind =!= SYMBOL_KIND_TYPE() {
                    checkFail(symbolToken(symbol), prefix, "name " + token.text + " is not a type");
                }
                validateTypeText(symbols, alias.detail, depth + 1, alias, prefix);
            }
        }
        cursor = cursor + 1;
    }
}

/** Validates the annotation of one value declaration, if it has one. */
validateValueSymbol := fn(symbols: Symbols, symbol: Symbol, prefix: String): Unit {
    var text := symbol.detail;
    if textLib.startsWithAt(text, 0, "var ") { text = textLib.slice(text, 4, textLib.length(text)); }
    if textLib.startsWithAt(text, 0, "mut ") { text = textLib.slice(text, 4, textLib.length(text)); }
    if textLib.startsWithAt(text, 0, ":= ") { return; }
    split := textLib.indexOfText(text, " = ", 0);
    if split >= 0 { text = textLib.slice(text, 0, split); }
    if text == "" { return; }
    validateTypeText(symbols, text, 0, symbol, prefix);
}

/** Validates collected symbols' type annotations and signatures. */
validateSymbols := fn(symbols: Symbols, prefix: String): Unit {
    loop symbols as symbol {
        if symbol.kind == SYMBOL_KIND_TYPE() or symbol.kind == SYMBOL_KIND_FUNCTION() {
            validateTypeText(symbols, symbol.detail, 0, symbol, prefix);
        } else {
            validateValueSymbol(symbols, symbol, prefix);
        }
    }
}

/** Number of parameters in one function symbol's detail text. */
functionArity := fn(symbol: Symbol): Int {
    tokens := lexer.tokenize(symbol.detail, "");
    count := parser.tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, "(") { break; }
        cursor = cursor + 1;
    }
    cursor = cursor + 1;
    if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") { return 0; }
    var depth := 0;
    var arguments := 1;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if parser.isSymbol(token, "(") or parser.isSymbol(token, "[") or parser.isSymbol(token, "{") {
            depth = depth + 1;
        } else if parser.isSymbol(token, ")") or parser.isSymbol(token, "]") or parser.isSymbol(token, "}") {
            if depth == 0 and parser.isSymbol(token, ")") { return arguments; }
            depth = depth - 1;
        } else if parser.isSymbol(token, ",") and depth == 0 {
            arguments = arguments + 1;
        }
        cursor = cursor + 1;
    }
    arguments
}

/** Counts one call's top-level arguments starting at its opening parenthesis. */
callArity := fn(tokens: lexer.Tokens, openIndex: Int, prefix: String): Int {
    count := parser.tokenCount(tokens);
    var cursor := openIndex + 1;
    if parser.isSymbol(parser.tokenAt(tokens, cursor), ")") { return 0; }
    var depth := 0;
    var arguments := 1;
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() {
            checkFail(token, prefix, "unterminated call");
        }
        if parser.isSymbol(token, "(") or parser.isSymbol(token, "[") or parser.isSymbol(token, "{") {
            depth = depth + 1;
        } else if parser.isSymbol(token, ")") or parser.isSymbol(token, "]") or parser.isSymbol(token, "}") {
            if depth == 0 and parser.isSymbol(token, ")") { return arguments; }
            depth = depth - 1;
        } else if parser.isSymbol(token, ",") and depth == 0 {
            arguments = arguments + 1;
        }
        cursor = cursor + 1;
    }
    arguments
}

/** Checks direct calls to known top-level functions for matching arity. */
checkCalls := fn(tokens: lexer.Tokens, symbols: Symbols, prefix: String): Unit {
    count := parser.tokenCount(tokens);
    var cursor := 0;
    emptyLocals: List<Local> = [];
    loop cursor < count {
        token := parser.tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF() { break; }
        if token.kind == lexer.TOKEN_KIND_NAME() and parser.isSymbol(parser.tokenAt(tokens, cursor + 1), "(") {
            index := findSymbol(symbols, token.text);
            if index >= 0 and symbols[index].kind == SYMBOL_KIND_FUNCTION() {
                expected := functionArity(symbols[index]);
                actual := callArity(tokens, cursor + 1, prefix);
                if expected =!= actual {
                    checkFail(token, prefix, "function " + token.text + " expects " + format.decimalText(expected) +
                        " arguments, got " + format.decimalText(actual));
                }
                parameterTypes := functionParamTypes(symbols[index]);
                var argumentCursor := cursor + 2;
                var argumentIndex := 0;
                loop argumentIndex < expected {
                    if parser.tokenKindAt(tokens, argumentCursor) == lexer.TOKEN_KIND_KEYWORD() and
                        parser.tokenTextAt(tokens, argumentCursor) == "mut" {
                        argumentCursor = argumentCursor + 1;
                    }
                    if parser.tokenKindAt(tokens, argumentCursor) == lexer.TOKEN_KIND_NAME() and
                        parser.isSymbol(parser.tokenAt(tokens, argumentCursor + 1), "=") {
                        argumentCursor = argumentCursor + 2;
                    }
                    argument := parser.parseExpression(tokens, argumentCursor, prefix, 0);
                    expectedType := parameterTypes[argumentIndex];
                    inferred := contextualSimpleType(symbols, emptyLocals, argument.text, expectedType);
                    if not typesCompatible(symbols, expectedType, inferred) {
                        checkFail(token, prefix, "argument " + format.decimalText(argumentIndex + 1) + " of " + token.text +
                            " expects " + expectedType + ", got " + inferred);
                    }
                    argumentCursor = argument.next;
                    argumentIndex = argumentIndex + 1;
                    if argumentIndex < expected and parser.isSymbol(parser.tokenAt(tokens, argumentCursor), ",") {
                        argumentCursor = argumentCursor + 1;
                    }
                }
            }
        }
        cursor = cursor + 1;
    }
}

/** Collects, validates and checks one source. */
pub checkSource := fn(tokens: lexer.Tokens, prefix: String): Symbols {
    symbols := collectSymbols(tokens, prefix);
    validateSymbols(symbols, prefix);
    checkLocals(tokens, prefix, symbols);
    checkCalls(tokens, symbols, prefix);
    symbols
}

/** Formats one symbol as `kind|name|detail|line:column|offset`. */
dumpSymbol := fn(symbol: Symbol): String {
    symbol.kind + "|" + symbol.name + "|" + symbol.detail + "|" + format.decimalText(symbol.line) + ":" +
        format.decimalText(symbol.column) + "|" + format.decimalText(symbol.offset)
}

/** Reports collected symbols in source order, one per line. */
pub dumpSymbols := fn(symbols: Symbols): Unit {
    loop symbols as symbol {
        io.outputLine(dumpSymbol(symbol));
    }
}

/** Runs the source checker and writes its deterministic symbol dump. */
pub testDumpSymbols := fn(source: String, prefix: String): Unit {
    tokens := lexer.tokenize(source, prefix);
    dumpSymbols(checkSource(tokens, prefix));
}
