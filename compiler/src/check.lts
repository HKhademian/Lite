/* Lite-written checker foundation. Starts with top-level symbols and duplicates. */

/** One top-level symbol: kind, name, detail text and source position. */
Symbol := type (kind: String, name: String, detail: String, offset: Int, line: Int, column: Int);

/** Top-level symbols in source order. */
Symbols := type List<Symbol>;

/** One local binding: name, reassignment mutability, block depth and origin kind. */
Local := type (name: String, typeText: String, mutable: Bool, depth: Int, kind: String);

/** Local bindings in declaration order, removed when their block closes. */
Locals := type List<Local>;

/** Canonical symbol kind for a type alias. */
SYMBOL_KIND_TYPE := fn(): String { "type" }

/** Canonical symbol kind for a function. */
SYMBOL_KIND_FUNCTION := fn(): String { "function" }

/** Canonical symbol kind for a value declaration. */
SYMBOL_KIND_VALUE := fn(): String { "value" }

/** True for a built-in type name accepted by the bootstrap subset. */
isBuiltinType := fn(name: String): Bool {
    name == "Int" or name == "String" or name == "Bool" or name == "Unit" or name == "List"
}

/** True when a read-only text list contains `target`. */
hasText := fn(values: List<String>, target: String): Bool {
    loop values as value {
        if value == target { return true; }
    }
    false
}

/** Returns the newest local with `name`, or -1. */
findLocal := fn(locals: Locals, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** Returns the index of a local with `name` directly in `depth`, or -1. */
findLocalAtDepth := fn(locals: Locals, name: String, depth: Int): Int {
    var index := 0;
    loop locals as local {
        if local.name == name and local.depth == depth { return index; }
        index = index + 1;
    }
    -1
}

/** True for the four built-in scalar type names. */
isScalarType := fn(typeText: String): Bool {
    typeText == "Int" or typeText == "String" or typeText == "Bool" or typeText == "Unit"
}

/** Returns `List<T>`'s element type, or empty text when the type is not a list. */
listElementType := fn(typeText: String): String {
    size := textLength(typeText);
    if size > 5 and startsWithAt(typeText, 0, "List<") and textAt(typeText, size - 1) == ">" {
        return textSlice(typeText, 5, size - 1);
    }
    ""
}

/** Returns the index of the first top-level symbol named `name`, or -1. */
findSymbol := fn(symbols: Symbols, name: String): Int {
    var index := 0;
    loop symbols as symbol {
        if symbol.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Parses one function symbol's result type text. */
functionResultType := fn(symbol: Symbol): String {
    tokens := tokenize(symbol.detail, "");
    count := tokenCount(tokens);
    var cursor := 0;
    var depth := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if isSymbol(token, "(") { depth = depth + 1; }
        else if isSymbol(token, ")") {
            depth = depth - 1;
            if depth == 0 {
                cursor = cursor + 1;
                break;
            }
        }
        cursor = cursor + 1;
    }
    if not isSymbol(tokenAt(tokens, cursor), ":") { return ""; }
    parsed := parseType(tokens, cursor + 1, "");
    parsed.text
}

/** Infers a simple scalar/call/name type from normalized expression text, or empty when unknown. */
simpleType := fn(symbols: Symbols, locals: Locals, text: String): String {
    size := textLength(text);
    if size == 0 { return ""; }
    if text == "true" or text == "false" { return "Bool"; }
    if startsWithAt(text, 0, "\"") { return "String"; }
    first := textAt(text, 0);
    if isDigit(first) { return "Int"; }
    if startsWithAt(text, 0, "(-") or startsWithAt(text, 0, "(+") { return "Int"; }
    if startsWithAt(text, 0, "not ") { return "Bool"; }
    if startsWithAt(text, 0, "(") {
        if indexOfText(text, " == ", 0) >= 0 or indexOfText(text, " =!= ", 0) >= 0 or
            indexOfText(text, " < ", 0) >= 0 or indexOfText(text, " <= ", 0) >= 0 or
            indexOfText(text, " > ", 0) >= 0 or indexOfText(text, " >= ", 0) >= 0 or
            indexOfText(text, " <! ", 0) >= 0 or indexOfText(text, " >! ", 0) >= 0 or
            indexOfText(text, " <!= ", 0) >= 0 or indexOfText(text, " >!= ", 0) >= 0 or
            indexOfText(text, " and ", 0) >= 0 or indexOfText(text, " or ", 0) >= 0 {
            return "Bool";
        }
        return "";
    }
    if isNameStart(first) {
        index := findLocal(locals, text);
        if index >= 0 { return locals[index].typeText; }
        call := indexOfText(text, "(", 0);
        if call > 0 {
            name := textSlice(text, 0, call);
            functionIndex := findSymbol(symbols, name);
            if functionIndex >= 0 and symbols[functionIndex].kind == SYMBOL_KIND_FUNCTION() {
                return functionResultType(symbols[functionIndex]);
            }
            if name == "inputAll" or name == "textAt" or name == "textSlice" { return "String"; }
            if name == "textLength" { return "Int"; }
            if name == "true" or name == "false" { return "Bool"; }
        }
    }
    ""
}

/** Builds a token-shaped source position for a symbol diagnostic. */
symbolToken := fn(symbol: Symbol): Token {
    (kind = symbol.kind, text = symbol.name, offset = symbol.offset, line = symbol.line, column = symbol.column)
}

/** Reports one token-positioned checker diagnostic and exits 2. */
checkFail := fn(token: Token, prefix: String, message: String): Unit {
    fail(prefix, decimalText(token.line) + ":" + decimalText(token.column) + ": " + message);
}

/** Skips one balanced `{ ... }` sequence and returns the position after it. */
skipBraces := fn(tokens: Tokens, index: Int, prefix: String): Int {
    var cursor := expectSymbol(tokens, index, "{", prefix);
    var depth := 1;
    loop true {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() {
            checkFail(token, prefix, "unterminated block");
        }
        if isSymbol(token, "{") {
            depth = depth + 1;
        } else if isSymbol(token, "}") {
            depth = depth - 1;
            if depth == 0 { return cursor + 1; }
        }
        cursor = cursor + 1;
    }
    cursor
}

/** Adds one symbol, rejecting a duplicate top-level name. */
addSymbol := fn(symbols: Symbols, symbol: Symbol, prefix: String): Symbols {
    if findSymbol(symbols, symbol.name) >= 0 {
        checkFail((kind = symbol.kind, text = symbol.name, offset = symbol.offset,
            line = symbol.line, column = symbol.column), prefix, "duplicate top-level name " + symbol.name);
    }
    result: mut List<Symbol> = [];
    loop symbols as item { push_back(mut result, item); }
    push_back(mut result, symbol);
    result
}

/** Parses one function signature and skips its body into scalar symbol fields. */
parseFunctionSymbol := fn(tokens: Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    nameToken := tokenAt(tokens, index);
    afterName := expectSymbol(tokens, index + 1, ":=", prefix);
    functionWord := tokenAt(tokens, afterName);
    if functionWord.kind =!= TOKEN_KIND_KEYWORD() or functionWord.text =!= "fn" {
        checkFail(functionWord, prefix, "expected fn after :=");
    }
    var cursor := expectSymbol(tokens, afterName + 1, "(", prefix);
    var detail := "(";
    var parameterCount := 0;
    parameterNames: mut List<String> = [];
    loop true {
        if isSymbol(tokenAt(tokens, cursor), ")") { break; }
        parameter := tokenAt(tokens, cursor);
        if parameter.kind =!= TOKEN_KIND_NAME() {
            checkFail(parameter, prefix, "expected a parameter name");
        }
        if hasText(parameterNames, parameter.text) {
            checkFail(parameter, prefix, "duplicate parameter " + parameter.text);
        }
        push_back(mut parameterNames, parameter.text);
        colon := expectSymbol(tokens, cursor + 1, ":", prefix);
        parameterType := parseType(tokens, colon, prefix);
        if parameterCount > 0 { detail = detail + ", "; }
        detail = detail + parameter.text + ": " + parameterType.text;
        parameterCount = parameterCount + 1;
        cursor = parameterType.next;
        if isSymbol(tokenAt(tokens, cursor), ",") {
            cursor = cursor + 1;
        } else {
            break;
        }
    }
    cursor = expectSymbol(tokens, cursor, ")", prefix);
    resultColon := expectSymbol(tokens, cursor, ":", prefix);
    resultType := parseType(tokens, resultColon, prefix);
    detail = detail + "): " + resultType.text;
    var afterBody := skipBraces(tokens, resultType.next, prefix);
    if isSymbol(tokenAt(tokens, afterBody), ";") { afterBody = afterBody + 1; }
    (next = afterBody, name = nameToken.text, detail = detail,
        offset = nameToken.offset, line = nameToken.line, column = nameToken.column)
}

/** Collects top-level type, function and value symbols with duplicate rejection. */
collectSymbols := fn(tokens: Tokens, prefix: String): Symbols {
    count := tokenCount(tokens);
    var symbols: mut List<Symbol> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "type" {
            afterName := expectSymbol(tokens, cursor + 1, ":=", prefix);
            parsedType := parseType(tokens, afterName + 1, prefix);
            ended := expectSymbol(tokens, parsedType.next, ";", prefix);
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_TYPE(), name = token.text, detail = parsedType.text,
                offset = token.offset, line = token.line, column = token.column), prefix);
            cursor = ended;
        } else if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "fn" {
            parsed := parseFunctionSymbol(tokens, cursor, prefix);
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_FUNCTION(), name = parsed.name, detail = parsed.detail,
                offset = parsed.offset, line = parsed.line, column = parsed.column), prefix);
            cursor = parsed.next;
        } else if (token.kind == TOKEN_KIND_KEYWORD() and token.text == "var") or
            (token.kind == TOKEN_KIND_NAME() and (isSymbol(tokenAt(tokens, cursor + 1), ":=") or
                isSymbol(tokenAt(tokens, cursor + 1), ":"))) {
            declaration := parseDeclaration(tokens, cursor, prefix);
            nameToken := tokenAt(tokens, cursor + (if token.kind == TOKEN_KIND_KEYWORD() { 1 } else { 0 }));
            symbols = addSymbol(symbols, (kind = SYMBOL_KIND_VALUE(), name = declaration.name, detail = declaration.detail,
                offset = nameToken.offset, line = nameToken.line, column = nameToken.column), prefix);
            cursor = declaration.next;
        } else {
            expression := parseExpression(tokens, cursor, prefix, 0);
            cursor = expression.next;
            if isSymbol(tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
        }
    }
    symbols
}

/** Checks block-local declarations, parameter scopes and statement assignments. */
checkLocals := fn(tokens: Tokens, prefix: String, symbols: Symbols): Unit {
    count := tokenCount(tokens);
    locals: mut List<Local> = [];
    var localCount := 0;
    var depth := 0;
    var parens := 0;
    var brackets := 0;
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        if isSymbol(token, "{") { depth = depth + 1; cursor = cursor + 1; continue; }
        if isSymbol(token, "}") {
            loop localCount > 0 and locals[localCount - 1].depth >= depth {
                pop_back(mut locals);
                localCount = localCount - 1;
            }
            depth = depth - 1;
            cursor = cursor + 1;
            continue;
        }
        if isSymbol(token, "(") { parens = parens + 1; cursor = cursor + 1; continue; }
        if isSymbol(token, ")") { parens = parens - 1; cursor = cursor + 1; continue; }
        if isSymbol(token, "[") { brackets = brackets + 1; cursor = cursor + 1; continue; }
        if isSymbol(token, "]") { brackets = brackets - 1; cursor = cursor + 1; continue; }
        if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "type" {
            afterName := expectSymbol(tokens, cursor + 1, ":=", prefix);
            aliasType := parseType(tokens, afterName + 1, prefix);
            cursor = expectSymbol(tokens, aliasType.next, ";", prefix);
            continue;
        }
        if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
            tokenAt(tokens, cursor + 2).kind == TOKEN_KIND_KEYWORD() and tokenAt(tokens, cursor + 2).text == "fn" {
            var parameterCursor := expectSymbol(tokens, cursor + 3, "(", prefix);
            loop true {
                if isSymbol(tokenAt(tokens, parameterCursor), ")") { break; }
                parameter := tokenAt(tokens, parameterCursor);
                if parameter.kind =!= TOKEN_KIND_NAME() {
                    checkFail(parameter, prefix, "expected a parameter name");
                }
                if findLocalAtDepth(locals, parameter.text, depth + 1) >= 0 {
                    checkFail(parameter, prefix, "duplicate parameter " + parameter.text);
                }
                colon := expectSymbol(tokens, parameterCursor + 1, ":", prefix);
                parameterType := parseType(tokens, colon, prefix);
                push_back(mut locals, (name = parameter.text, typeText = parameterType.text,
                    mutable = false, depth = depth + 1, kind = "parameter"));
                localCount = localCount + 1;
                parameterCursor = parameterType.next;
                if isSymbol(tokenAt(tokens, parameterCursor), ",") {
                    parameterCursor = parameterCursor + 1;
                } else {
                    break;
                }
            }
            parameterCursor = expectSymbol(tokens, parameterCursor, ")", prefix);
            resultColon := expectSymbol(tokens, parameterCursor, ":", prefix);
            resultType := parseType(tokens, resultColon, prefix);
            cursor = resultType.next;
            continue;
        }
        if token.kind == TOKEN_KIND_KEYWORD() and token.text == "if" {
            condition := parseExpression(tokens, cursor + 1, prefix, 0);
            conditionType := simpleType(symbols, locals, condition.text);
            if isScalarType(conditionType) and conditionType =!= "Bool" {
                checkFail(token, prefix, "if condition must be Bool");
            }
            cursor = condition.next;
            continue;
        }
        if token.kind == TOKEN_KIND_KEYWORD() and token.text == "loop" {
            source := parseExpression(tokens, cursor + 1, prefix, 0);
            if tokenAt(tokens, source.next).kind == TOKEN_KIND_NAME() and tokenAt(tokens, source.next).text == "as" {
                itemToken := tokenAt(tokens, source.next + 1);
                if itemToken.kind =!= TOKEN_KIND_NAME() {
                    checkFail(itemToken, prefix, "expected a loop item name after as");
                }
                sourceType := simpleType(symbols, locals, source.text);
                itemType := listElementType(sourceType);
                push_back(mut locals, (name = itemToken.text, typeText = itemType, mutable = false,
                    depth = depth + 1, kind = "loop item"));
                localCount = localCount + 1;
                cursor = source.next + 2;
            } else {
                conditionType := simpleType(symbols, locals, source.text);
                if isScalarType(conditionType) and conditionType =!= "Bool" {
                    checkFail(token, prefix, "loop condition must be Bool");
                }
                cursor = source.next;
            }
            continue;
        }
        if (token.kind == TOKEN_KIND_KEYWORD() and token.text == "var") or
            (token.kind == TOKEN_KIND_NAME() and (isSymbol(tokenAt(tokens, cursor + 1), ":=") or
                isSymbol(tokenAt(tokens, cursor + 1), ":"))) {
            declaration := parseDeclaration(tokens, cursor, prefix);
            nameToken := tokenAt(tokens, cursor + (if token.kind == TOKEN_KIND_KEYWORD() { 1 } else { 0 }));
            if findLocalAtDepth(locals, declaration.name, depth) >= 0 {
                checkFail(nameToken, prefix, "duplicate local " + declaration.name);
            }
            mutable := startsWithAt(declaration.detail, 0, "var ");
            var work := declaration.detail;
            if mutable { work = textSlice(work, 4, textLength(work)); }
            var typeText := "";
            var initText := "";
            if startsWithAt(work, 0, ":= ") {
                initText = textSlice(work, 3, textLength(work));
                typeText = simpleType(symbols, locals, initText);
            } else {
                if startsWithAt(work, 0, "mut ") { work = textSlice(work, 4, textLength(work)); }
                split := indexOfText(work, " = ", 0);
                if split >= 0 {
                    typeText = textSlice(work, 0, split);
                    initText = textSlice(work, split + 3, textLength(work));
                } else {
                    typeText = work;
                }
                if initText =!= "" and initText =!= "?" {
                    inferred := simpleType(symbols, locals, initText);
                    if isScalarType(typeText) and isScalarType(inferred) and typeText =!= inferred {
                        checkFail(nameToken, prefix, "cannot initialize " + typeText + " with " + inferred);
                    }
                }
            }
            push_back(mut locals, (name = declaration.name, typeText = typeText, mutable = mutable,
                depth = depth, kind = "local"));
            localCount = localCount + 1;
            cursor = declaration.next;
            continue;
        }
        if parens == 0 and brackets == 0 and token.kind == TOKEN_KIND_NAME() and
            isSymbol(tokenAt(tokens, cursor + 1), "=") {
            index := findLocal(locals, token.text);
            if index < 0 {
                checkFail(token, prefix, "unknown local " + token.text);
            }
            if not locals[index].mutable {
                checkFail(token, prefix, "cannot assign to immutable local " + token.text);
            }
            value := parseExpression(tokens, cursor + 2, prefix, 0);
            inferred := simpleType(symbols, locals, value.text);
            localType := locals[index].typeText;
            if isScalarType(localType) and isScalarType(inferred) and localType =!= inferred {
                checkFail(token, prefix, "cannot assign " + inferred + " to " + localType + " local " + token.text);
            }
            cursor = value.next;
            if isSymbol(tokenAt(tokens, cursor), ";") { cursor = cursor + 1; }
            continue;
        }
        cursor = cursor + 1;
    }
}

/** Validates every type name inside one type or signature text. */
validateTypeText := fn(symbols: Symbols, text: String, depth: Int, symbol: Symbol, prefix: String): Unit {
    if depth > 16 {
        checkFail(symbolToken(symbol), prefix, "recursive type alias " + symbol.name);
    }
    tokens := tokenize(text, "");
    count := tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        if token.kind == TOKEN_KIND_NAME() {
            next := tokenAt(tokens, cursor + 1);
            if isSymbol(next, ":") {
                cursor = cursor + 1;
            } else if not isBuiltinType(token.text) {
                index := findSymbol(symbols, token.text);
                if index < 0 {
                    checkFail(symbolToken(symbol), prefix, "unknown type " + token.text);
                }
                alias := symbols[index];
                if alias.kind =!= SYMBOL_KIND_TYPE() {
                    checkFail(symbolToken(symbol), prefix, "name " + token.text + " is not a type");
                }
                validateTypeText(symbols, alias.detail, depth + 1, alias, prefix);
            }
        }
        cursor = cursor + 1;
    }
}

/** Validates the annotation of one value declaration, if it has one. */
validateValueSymbol := fn(symbols: Symbols, symbol: Symbol, prefix: String): Unit {
    var text := symbol.detail;
    if startsWithAt(text, 0, "var ") { text = textSlice(text, 4, textLength(text)); }
    if startsWithAt(text, 0, "mut ") { text = textSlice(text, 4, textLength(text)); }
    if startsWithAt(text, 0, ":= ") { return; }
    split := indexOfText(text, " = ", 0);
    if split >= 0 { text = textSlice(text, 0, split); }
    if text == "" { return; }
    validateTypeText(symbols, text, 0, symbol, prefix);
}

/** Validates collected symbols' type annotations and signatures. */
validateSymbols := fn(symbols: Symbols, prefix: String): Unit {
    loop symbols as symbol {
        if symbol.kind == SYMBOL_KIND_TYPE() or symbol.kind == SYMBOL_KIND_FUNCTION() {
            validateTypeText(symbols, symbol.detail, 0, symbol, prefix);
        } else {
            validateValueSymbol(symbols, symbol, prefix);
        }
    }
}

/** Number of parameters in one function symbol's detail text. */
functionArity := fn(symbol: Symbol): Int {
    tokens := tokenize(symbol.detail, "");
    count := tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if isSymbol(token, "(") { break; }
        cursor = cursor + 1;
    }
    cursor = cursor + 1;
    if isSymbol(tokenAt(tokens, cursor), ")") { return 0; }
    var depth := 0;
    var arguments := 1;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if isSymbol(token, "(") or isSymbol(token, "[") or isSymbol(token, "{") {
            depth = depth + 1;
        } else if isSymbol(token, ")") or isSymbol(token, "]") or isSymbol(token, "}") {
            if depth == 0 and isSymbol(token, ")") { return arguments; }
            depth = depth - 1;
        } else if isSymbol(token, ",") and depth == 0 {
            arguments = arguments + 1;
        }
        cursor = cursor + 1;
    }
    arguments
}

/** Counts one call's top-level arguments starting at its opening parenthesis. */
callArity := fn(tokens: Tokens, openIndex: Int, prefix: String): Int {
    count := tokenCount(tokens);
    var cursor := openIndex + 1;
    if isSymbol(tokenAt(tokens, cursor), ")") { return 0; }
    var depth := 0;
    var arguments := 1;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() {
            checkFail(token, prefix, "unterminated call");
        }
        if isSymbol(token, "(") or isSymbol(token, "[") or isSymbol(token, "{") {
            depth = depth + 1;
        } else if isSymbol(token, ")") or isSymbol(token, "]") or isSymbol(token, "}") {
            if depth == 0 and isSymbol(token, ")") { return arguments; }
            depth = depth - 1;
        } else if isSymbol(token, ",") and depth == 0 {
            arguments = arguments + 1;
        }
        cursor = cursor + 1;
    }
    arguments
}

/** Checks direct calls to known top-level functions for matching arity. */
checkCalls := fn(tokens: Tokens, symbols: Symbols, prefix: String): Unit {
    count := tokenCount(tokens);
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == TOKEN_KIND_EOF() { break; }
        if token.kind == TOKEN_KIND_NAME() and isSymbol(tokenAt(tokens, cursor + 1), "(") {
            index := findSymbol(symbols, token.text);
            if index >= 0 and symbols[index].kind == SYMBOL_KIND_FUNCTION() {
                expected := functionArity(symbols[index]);
                actual := callArity(tokens, cursor + 1, prefix);
                if expected =!= actual {
                    checkFail(token, prefix, "function " + token.text + " expects " + decimalText(expected) +
                        " arguments, got " + decimalText(actual));
                }
            }
        }
        cursor = cursor + 1;
    }
}

/** Collects, validates and checks one source. */
checkSource := fn(tokens: Tokens, prefix: String): Symbols {
    symbols := collectSymbols(tokens, prefix);
    validateSymbols(symbols, prefix);
    checkLocals(tokens, prefix, symbols);
    checkCalls(tokens, symbols, prefix);
    symbols
}

/** Formats one symbol as `kind|name|detail|line:column|offset`. */
dumpSymbol := fn(symbol: Symbol): String {
    symbol.kind + "|" + symbol.name + "|" + symbol.detail + "|" + decimalText(symbol.line) + ":" +
        decimalText(symbol.column) + "|" + decimalText(symbol.offset)
}

/** Reports collected symbols in source order, one per line. */
dumpSymbols := fn(symbols: Symbols): Unit {
    loop symbols as symbol {
        report(dumpSymbol(symbol));
    }
}
