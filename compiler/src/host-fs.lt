/** Compiler CLI flag parsing, root discovery, and direct core/file module loading without a JS source bridge. */

crypto := import "core/crypto";
diagLib := import "core/diag";
fs := import "core/file";
io := import "core/io";
path := import "core/path";
textLib := import "core/text";
unicode := import "core/unicode";
tb := import "util/text-builder";
frontend := import "./frontend";
optCfg := import "./opt-config";

/** Parses I/O and trace CLI flags and positional file target for TS and C compiler drivers without reading `io.inputArgs()`. */
pub parseCompilerFlags := fn(rawArgs: List<String>): (
ok: Bool, isStdin: Bool, hasName: Bool, name: String, hasRoot: Bool, rootPath: String,
hasOut: Bool, outPath: String, hasTrace: Bool, tracePath: String, filePath: String, error: String
) {
    var isStdin := false;
    var hasName := false;
    var name := "";
    var hasRoot := false;
    var rootPath := "";
    var hasOut := false;
    var outPath := "";
    var hasTrace := false;
    var tracePath := "";
    var filePath := "";

    args: mut List<String> = rawArgs;
    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--stdin" {
            isStdin = true;
        } else if arg.startsWithAt(0, "-O") {
            if not optCfg.parseOptClass(arg.slice(2, arg.length())).ok {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unsupported optimization flag " + arg + " (expected -O0, -O1, -O2, -O3, -Os, or -Oc)");
            }
        } else if arg == "--opt" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --opt");
            }
            rawOpt := mut args.popFront();
            if not optCfg.parseOptClass(rawOpt).ok {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
        } else if arg.startsWithAt(0, "--opt=") {
            rawOpt := arg.slice(6, arg.length());
            if not optCfg.parseOptClass(rawOpt).ok {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
        } else if arg.startsWithAt(0, "-f") {
            if not optCfg.isPassFlag(arg) {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unsupported optimization pass flag " + arg);
            }
        } else if arg == "--emit-format" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --emit-format (expected pretty or compact)");
            }
            _ignoredFmt := mut args.popFront();
        } else if arg.startsWithAt(0, "--emit-format=") {
            _ignoredInlineFmt := true;
        } else if arg == "--source-map" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --source-map (expected none, comments, or lines)");
            }
            _ignoredSm := mut args.popFront();
        } else if arg.startsWithAt(0, "--source-map=") {
            _ignoredInlineSm := true;
        } else if arg == "--builtin-mode" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --builtin-mode");
            }
            _ignoredSpec := mut args.popFront();
        } else if arg.startsWithAt(0, "--builtin-mode=") {
            _ignoredInlineSpec := true;
        } else if arg == "--name" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --name");
            }
            hasName = true;
            name = mut args.popFront();
        } else if arg.startsWithAt(0, "--name=") {
            hasName = true;
            name = arg.slice(7, arg.length());
        } else if arg == "--root" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --root");
            }
            hasRoot = true;
            rootPath = mut args.popFront();
        } else if arg.startsWithAt(0, "--root=") {
            hasRoot = true;
            rootPath = arg.slice(7, arg.length());
        } else if arg == "--out" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --out");
            }
            hasOut = true;
            outPath = mut args.popFront();
        } else if arg.startsWithAt(0, "--out=") {
            hasOut = true;
            outPath = arg.slice(6, arg.length());
        } else if arg == "--trace-json" {
            if args.length() == 0 {
                return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing value for --trace-json");
            }
            hasTrace = true;
            tracePath = mut args.popFront();
        } else if arg.startsWithAt(0, "--trace-json=") {
            hasTrace = true;
            tracePath = arg.slice(13, arg.length());
        } else if arg.startsWithAt(0, "-") {
            return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unknown compiler option " + arg);
        } else if filePath =!= "" {
            return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "unexpected argument " + arg);
        } else {
            filePath = arg;
        }
    }

    if isStdin and filePath =!= "" {
        return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "cannot combine --stdin with a file argument");
    }
    if not isStdin and filePath == "" {
        return (ok = false, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "missing input file (or --stdin)");
    }
    (ok = true, =isStdin, =hasName, =name, =hasRoot, =rootPath, =hasOut, =outPath, =hasTrace, =tracePath, =filePath, error = "")
}

/** Extracts repeatable `--builtin-mode` specification values from `rawArgs`. */
pub extractBuiltinSpecs := fn(rawArgs: List<String>): List<String> {
    out: mut List<String> = [];
    args: mut List<String> = rawArgs;
    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--builtin-mode" and args.length() > 0 {
            mut out.pushBack(mut args.popFront());
        } else if arg.startsWithAt(0, "--builtin-mode=") {
            mut out.pushBack(arg.slice(15, arg.length()));
        }
    }
    out
}

/** Walks up parent directories from `startDir` looking for a Lite distribution containing `lib/core/io.lt`. */
walkRootUp := fn(startDir: String): String {
    if startDir == "" { return ""; }
    var dir := startDir;
    loop true {
        if fs.kind(path.join(dir, "lib/core/io.lt")) == fs.FILE_KIND_FILE {
            rp := fs.realPath(dir);
            return if rp.ok { rp.path } else { dir };
        }
        parent := path.parentDir(dir);
        if parent == dir { break; }
        dir = parent;
    }
    ""
}

/** Locates the canonical Lite repository/distribution root from entry script, source path, or cwd. */
pub findProjectRoot := fn(entryPathHint: String, sourcePathHint: String, cwd: String): String {
    if entryPathHint =!= "" {
        absEntry := if path.isAbsolute(entryPathHint) { path.normalize(entryPathHint) } else { path.resolve(cwd, entryPathHint) };
        rpEntry := fs.realPath(absEntry);
        entryDir := path.parentDir(if rpEntry.ok { rpEntry.path } else { absEntry });
        foundEntry := walkRootUp(entryDir);
        if foundEntry =!= "" { return foundEntry; }
    }
    if sourcePathHint =!= "" {
        absSource := if path.isAbsolute(sourcePathHint) { path.normalize(sourcePathHint) } else { path.resolve(cwd, sourcePathHint) };
        foundSource := walkRootUp(path.parentDir(absSource));
        if foundSource =!= "" { return foundSource; }
    }
    if cwd =!= "" {
        foundCwd := walkRootUp(cwd);
        if foundCwd =!= "" { return foundCwd; }
    }
    ""
}

/** Canonicalizes virtual/real source root directory even when root file itself lives in memory (`--stdin`). */
pub canonicalizeRootPath := fn(rawPath: String, cwd: String): String {
    abs := if rawPath == "" {
        path.join(cwd, "__lite_stdin__.lts")
    } else if path.isAbsolute(rawPath) {
        path.normalize(rawPath)
    } else {
        path.resolve(cwd, rawPath)
    };
    rp := fs.realPath(abs);
    if rp.ok { return rp.path; }
    parentRp := fs.realPath(path.parentDir(abs));
    if parentRp.ok {
        return path.join(parentRp.path, path.baseName(abs));
    }
    abs
}

/** True when `spec` starts with an ASCII Windows drive prefix (`C:...`). */
hasDrivePrefix := fn(spec: String): Bool {
    if spec.length() < 2 { return false; }
    spec.at(0).isAsciiLetter() and spec.at(1) == ":"
}

/** Resolves Lite imports: relative `./`/`../` use importer directory, absolute paths stay absolute, bare specs resolve under `<projectRoot>/lib`. */
pub resolveImportPath := fn(importerPath: String, spec: String, projectRoot: String, cwd: String): (ok: Bool, path: String, error: String) {
    if spec == "" or spec.indexOf("\\", 0) >= 0 {
        return (ok = false, path = "", error = "import path must be nonempty and use \"/\" separators");
    }
    if hasDrivePrefix(spec) {
        return (ok = false, path = "", error = "absolute drive paths are not supported on this host");
    }
    if spec.endsWith(".lt") {
        return (ok = false, path = "", error = "module import must omit the .lt extension (" + spec + ")");
    }
    isLts := spec.endsWith(".lts");
    if isLts and importerPath.endsWith(".lt") {
        return (ok = false, path = "", error = "cannot import .lts script " + spec + " from .lt module");
    }
    sourceSpec := if isLts { spec } else { spec + ".lt" };
    if sourceSpec.startsWithAt(0, "/") {
        return (ok = true, path = path.normalize(sourceSpec), error = "");
    }
    if sourceSpec.startsWithAt(0, "./") or sourceSpec.startsWithAt(0, "../") {
        baseImporter := canonicalizeRootPath(importerPath, cwd);
        return (ok = true, path = path.resolve(path.parentDir(baseImporter), sourceSpec), error = "");
    }
    if projectRoot == "" {
        return (ok = false, path = "", error = "cannot resolve library import " + spec + " (missing distribution root)");
    }
    (ok = true, path = path.join(path.join(projectRoot, "lib"), sourceSpec), error = "")
}

/** Returns a project-relative diagnostic path when `filePath` is inside `projectRoot`, or the canonical path otherwise. */
pub displaySourcePath := fn(filePath: String, projectRoot: String): String {
    if projectRoot == "" { return filePath; }
    rel := path.relative(projectRoot, filePath);
    if rel == ".." or rel.startsWithAt(0, "../") or path.isAbsolute(rel) {
        return filePath;
    }
    rel
}

var cachedIdentityRoot := "";
var cachedIdentityLoaded: mut List<Bool> = [];
var cachedIdentityTexts: mut List<String> = [];

/** Identifies source text matching a shipped core/compiler host module in `projectRoot`. */
pub sourceModuleIdentity := fn(projectRoot: String, sourceText: String): String {
    if projectRoot == "" { return ""; }
    paths: List<String> = [
    "lib/core/io.lt", "lib/core/int.lt", "lib/core/list.lt", "lib/core/array.lt", "lib/core/map.lt", "lib/core/set.lt", "lib/core/text.lt",
    "lib/core/file.lt", "lib/core/process.lt", "lib/core/crypto.lt", "lib/core/time.lt",
    "lib/core/unicode.lt", "lib/external/ts.lt", "lib/external/http.lt", "lib/external/bench.lt",
    "lib/external/pool.lt", "lib/extra/surface.lt", "compiler/src/modules.lt"
    ];
    identities: List<String> = [
    "lite.core.io.v1", "lite.core.int.v1", "lite.core.list.v1", "lite.core.array.v1", "lite.core.map.v1", "lite.core.set.v1", "lite.core.text.v1",
    "lite.core.file.v1", "lite.core.process.v1", "lite.core.crypto.v1", "lite.core.time.v1",
    "lite.core.unicode.v1", "lite.external.ts.v1", "lite.external.http.v1", "lite.external.bench.v1",
    "lite.external.pool.v1", "lite.extra.surface.v1", "lite.compiler.modules.v1"
    ];
    if cachedIdentityRoot =!= projectRoot {
        cachedIdentityRoot = projectRoot;
        cachedIdentityLoaded = [];
        cachedIdentityTexts = [];
        var loadIdx := 0;
        loop loadIdx < paths.length() {
            full := path.join(projectRoot, paths[loadIdx]);
            if fs.kind(full) == fs.FILE_KIND_FILE {
                loaded := fs.readText(full);
                if loaded.ok {
                    mut cachedIdentityLoaded.pushBack(true);
                    mut cachedIdentityTexts.pushBack(loaded.text);
                } else {
                    mut cachedIdentityLoaded.pushBack(false);
                    mut cachedIdentityTexts.pushBack("");
                }
            } else {
                mut cachedIdentityLoaded.pushBack(false);
                mut cachedIdentityTexts.pushBack("");
            }
            loadIdx = loadIdx + 1;
        }
    }
    var i := 0;
    loop i < paths.length() {
        if cachedIdentityLoaded[i] and cachedIdentityTexts[i] == sourceText {
            return identities[i];
        }
        i = i + 1;
    }
    ""
}

/** True when `msg` represents an invalid-UTF-8 decode error from Node `TextDecoder`. */
pub isUtf8DecodeError := fn(msg: String): Bool {
    msg.contains("not valid for encoding utf-8") or
    msg.contains("invalid utf-8") or
    msg.contains("invalid UTF-8")
}

/** Extracts a leading POSIX/Node error code such as `"ENOENT"` from `errMsg`, falling back to `fallback`. */
extractErrCode := fn(errMsg: String, fallback: String): String {
    colon := errMsg.indexOf(":", 0);
    if colon > 0 and colon <= 16 {
        code := errMsg.slice(0, colon);
        if code.startsWithAt(0, "E") {
            return code;
        }
    }
    fallback
}

/** Resolves and reads one imported `.lts` module via `core/file`, reporting exact import diagnostics on error. */
pub readImportedSource := fn(importerPath: String, importerDisplay: String, spec: String, projectRoot: String, cwd: String): (
path: String, display: String, identity: String, text: String
) {
    resolved := resolveImportPath(importerPath, spec, projectRoot, cwd);
    if not resolved.ok {
        diagLib.fail(importerDisplay, resolved.error);
    }
    rp := fs.realPath(resolved.path);
    if not rp.ok {
        code := extractErrCode(rp.error, "resolve error");
        diagLib.fail(importerDisplay, "cannot read imported source " + spec + " (" + code + ")");
    }
    canonPath := rp.path;
    readRes := fs.readText(canonPath);
    if not readRes.ok {
        if isUtf8DecodeError(readRes.error) {
            diagLib.fail(importerDisplay, "imported source " + spec + " is not valid UTF-8");
        }
        code := extractErrCode(readRes.error, "read error");
        diagLib.fail(importerDisplay, "cannot read imported source " + spec + " (" + code + ")");
    }
    display := displaySourcePath(canonPath, projectRoot);
    identity := sourceModuleIdentity(projectRoot, readRes.text);
    (path = canonPath, =display, =identity, text = readRes.text)
}

/** Reads one shipped built-in core owner module if present and identity-verified, without failing when absent. */
pub tryReadCoreOwner := fn(projectRoot: String, relPath: String): (
ok: Bool, path: String, display: String, identity: String, text: String
) {
    if projectRoot == "" { return (ok = false, path = "", display = "", identity = "", text = ""); }
    full := path.join(projectRoot, relPath);
    if fs.kind(full) =!= fs.FILE_KIND_FILE { return (ok = false, path = "", display = "", identity = "", text = ""); }
    rp := fs.realPath(full);
    if not rp.ok { return (ok = false, path = "", display = "", identity = "", text = ""); }
    readRes := fs.readText(rp.path);
    if not readRes.ok { return (ok = false, path = "", display = "", identity = "", text = ""); }
    identity := sourceModuleIdentity(projectRoot, readRes.text);
    if identity == "" { return (ok = false, path = "", display = "", identity = "", text = ""); }
    (ok = true, path = rp.path, display = displaySourcePath(rp.path, projectRoot), =identity, text = readRes.text)
}

/** Loads the root compiler input file (or stdin) for `flags` and returns normalized compiler inputs. */
pub loadRootInput := fn(
isStdin: Bool, hasName: Bool, optName: String, hasRoot: Bool, optRoot: String, filePath: String,
cwd: String, entryPathHint: String, stdinText: String
): (path: String, display: String, identity: String, text: String, projectRoot: String) {
    if isStdin {
        rootHint := if hasRoot and optRoot =!= "" { optRoot } else if hasName and optName =!= "" { optName } else { "__lite_stdin__.lts" };
        canonRoot := canonicalizeRootPath(rootHint, cwd);
        projectRoot := findProjectRoot(entryPathHint, canonRoot, cwd);
        display := if hasName { optName } else { "" };
        identity := sourceModuleIdentity(projectRoot, stdinText);
        return (path = canonRoot, =display, =identity, text = stdinText, =projectRoot);
    }

    rawAbs := if path.isAbsolute(filePath) { path.normalize(filePath) } else { path.resolve(cwd, filePath) };
    projectRoot := findProjectRoot(entryPathHint, rawAbs, cwd);
    rp := fs.realPath(rawAbs);
    if not rp.ok {
        io.errorLine(filePath + ": " + rp.error);
        io.exit(2);
    }
    canonPath := rp.path;
    readRes := fs.readText(canonPath);
    if not readRes.ok {
        if isUtf8DecodeError(readRes.error) {
            io.errorLine(filePath + ": InputFault: cannot read input: invalid UTF-8");
            io.exit(1);
        }
        io.errorLine(filePath + ": " + readRes.error);
        io.exit(2);
    }
    canonDisplay := displaySourcePath(canonPath, projectRoot);
    display := if hasName { optName } else if canonDisplay =!= canonPath { canonDisplay } else { rawAbs };
    identity := sourceModuleIdentity(projectRoot, readRes.text);
    (path = canonPath, =display, =identity, text = readRes.text, =projectRoot)
}

/** Converts a `0..15` integer value to its lowercase hexadecimal digit. */
hexDigit := fn(n: Int): String {
    if n < 10 { n.toText() }
    else if n == 10 { "a" }
    else if n == 11 { "b" }
    else if n == 12 { "c" }
    else if n == 13 { "d" }
    else if n == 14 { "e" }
    else { "f" }
}

/** Formats one string as a valid JSON double-quoted literal. */
quoteJson := fn(s: String): String {
    out: mut tb.TextBuilder;
    tb.append(mut out, "\"");
    codePoints := unicode.toCodePoints(s);
    loop codePoints as cp {
        if cp == 34 { tb.append(mut out, "\\\""); }
        else if cp == 92 { tb.append(mut out, "\\\\"); }
        else if cp == 8 { tb.append(mut out, "\\b"); }
        else if cp == 12 { tb.append(mut out, "\\f"); }
        else if cp == 10 { tb.append(mut out, "\\n"); }
        else if cp == 13 { tb.append(mut out, "\\r"); }
        else if cp == 9 { tb.append(mut out, "\\t"); }
        else if cp < 32 {
            tb.append(mut out, "\\u00");
            tb.append(mut out, hexDigit(cp / 16));
            tb.append(mut out, hexDigit(cp % 16));
        } else {
            one: List<Int> = [cp];
            dec := unicode.fromCodePoints(one);
            if dec.ok { tb.append(mut out, dec.text); }
        }
    }
    tb.append(mut out, "\"");
    tb.build(out)
}

/** Serializes `{ files, edges }` trace JSON from `graph` to `tracePath`. */
pub writeTraceJson := fn(tracePath: String, graph: frontend.Items): Unit {
    fileEntries: mut List<String> = [];
    edgeEntries: mut List<String> = [];
    loop graph as item {
        if item.kind == frontend.ITEM_KIND_MODULE_LOADED {
            hRes := crypto.sha256File(item.name);
            if not hRes.ok {
                diagLib.fail("", "cannot hash traced source " + item.name + ": " + hRes.error);
            }
            (mut fileEntries).pushBack("{\"path\":" + quoteJson(item.name) + ",\"sha256\":" + quoteJson(hRes.hex) + "}");
        } else if item.kind == frontend.ITEM_KIND_IMPORT_EDGE {
            mut edgeEntries.pushBack("{\"importer\":" + quoteJson(item.name) + ",\"spec\":" + quoteJson(item.code) + ",\"path\":" + quoteJson(item.runtime) + "}");
        }
    }
    body := "{\"files\":[" + fileEntries.join(",") + "],\"edges\":[" + edgeEntries.join(",") + "]}\n";
    w := fs.writeText(tracePath, body);
    if not w.ok {
        diagLib.fail("", "cannot write trace file " + tracePath + ": " + w.error);
    }
}
