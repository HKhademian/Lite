/** Resolves the three public 64-bit numeric synonyms, or returns empty text for any other spelling. Shared by the frontend and normalized parser/checker phases. */

textLib := import "core/text";

pub numericAliasKind := fn(name: String): String {
    if name == "Int64" { "Int" }
    else if name == "Float64" or name == "Double" { "Float" }
    else { "" }
}

/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntKind := fn(kind: String): Bool {
    kind == "Int8" or kind == "Int16" or kind == "Int32" or kind == "Int"
}

/** True when `kind` is one of the IEEE binary float scalar types (`Float32`, `Float`). */
pub isFloatKind := fn(kind: String): Bool {
    kind == "Float32" or kind == "Float"
}

/** True when `kind` is any signed integer or binary float scalar type. */
pub isNumericKind := fn(kind: String): Bool {
    isIntKind(kind) or isFloatKind(kind)
}

/** True when `kind` is a bounded fixed-width signed integer type narrower than `Int`. */
pub isNarrowIntKind := fn(kind: String): Bool {
    kind == "Int8" or kind == "Int16" or kind == "Int32"
}

/** True when `kind` is one of the four narrow numeric scalar types (`Int8`, `Int16`, `Int32`, `Float32`). */
pub isNarrowNumericKind := fn(kind: String): Bool {
    isNarrowIntKind(kind) or kind == "Float32"
}

/** Returns the signed integer bit width for a numeric integer scalar kind. */
pub narrowIntBits := fn(kind: String): Int {
    if kind == "Int8" { 8 }
    else if kind == "Int16" { 16 }
    else if kind == "Int32" { 32 }
    else { 64 }
}

/** True when `value` fits in the signed range of integer scalar kind `kind`. */
pub intKindFits := fn(kind: String, value: Int): Bool {
    if kind == "Int8" { value >= -128 and value <= 127 }
    else if kind == "Int16" { value >= -32768 and value <= 32767 }
    else if kind == "Int32" { value >= -2147483648 and value <= 2147483647 }
    else { kind == "Int" }
}

/** Returns the width rank inside a numeric family (`1` for `Int8`/`Float32`, up to `4` for `Int`/`Float`). */
pub numericRank := fn(kind: String): Int {
    if kind == "Int8" or kind == "Float32" { 1 }
    else if kind == "Int16" { 2 }
    else if kind == "Int32" { 3 }
    else if kind == "Int" or kind == "Float" { 4 }
    else { 0 }
}

/** Promotes two numeric kinds inside the same family (`Int*` or `Float*`) to the wider kind, or returns empty text across families. */
pub promoteNumericKind := fn(leftKind: String, rightKind: String): String {
    if isIntKind(leftKind) and isIntKind(rightKind) {
        if numericRank(leftKind) >= numericRank(rightKind) { leftKind } else { rightKind }
    } else if isFloatKind(leftKind) and isFloatKind(rightKind) {
        if numericRank(leftKind) >= numericRank(rightKind) { leftKind } else { rightKind }
    } else { "" }
}

/** True when `actual` losslessly widens to `expected` under LiteScript's fixed-width numeric rules. */
pub numericWidens := fn(expected: String, actual: String): Bool {
    if isIntKind(expected) and isIntKind(actual) {
        numericRank(actual) <= numericRank(expected)
    } else if isFloatKind(expected) and isFloatKind(actual) {
        numericRank(actual) <= numericRank(expected)
    } else if isFloatKind(expected) and isIntKind(actual) {
        if expected == "Float32" { actual == "Int8" or actual == "Int16" }
        else { actual == "Int8" or actual == "Int16" or actual == "Int32" }
    } else { false }
}

/** True when an admitted Int64 value has no nonzero bits beyond the positive binary float significand limit. Division avoids taking the absolute value of Int64.MIN. */
intWithinFloatLimit := fn(input: Int, limit: Int): Bool {
    var value := input;
    loop value > limit or value < -limit {
        if value % 2 =!= 0 { return false; }
        value /= 2;
    }
    true
}

/** True when an admitted Int64 value has no nonzero bits beyond binary64 precision. */
pub intExactlyFloat := fn(input: Int): Bool {
    intWithinFloatLimit(input, 9007199254740992)
}

/** True when an admitted Int64 value has no nonzero bits beyond binary32 precision. */
pub intExactlyFloat32 := fn(input: Int): Bool {
    intWithinFloatLimit(input, 16777216)
}

/** Compares a decimal literal's significant digits and power against an excluded overflow midpoint without runtime float math. */
finiteDigitsWithin := fn(digits: String, fractionCount: Int, exponent: Int, maxPower: Int, midpoint: String): Bool {
    var first := 0;
    loop first < textLib.length(digits) and textLib.at(digits, first) == "0" { first += 1; }
    if first == textLib.length(digits) { return true; }
    significant := textLib.slice(digits, first, textLib.length(digits));
    power := textLib.length(significant) - fractionCount + exponent;
    if power < maxPower { return true; }
    if power > maxPower { return false; }
    var count := textLib.length(significant);
    if count < textLib.length(midpoint) { count = textLib.length(midpoint); }
    var index := 0;
    loop index < count {
        left := if index < textLib.length(significant) { textLib.digitValue(textLib.at(significant, index)) } else { 0 };
        right := if index < textLib.length(midpoint) { textLib.digitValue(textLib.at(midpoint, index)) } else { 0 };
        if left < right { return true; }
        if left > right { return false; }
        index += 1;
    }
    false
}

/** Checks finite binary64 literal rounding using decimal digits, without requiring Float arithmetic in the bootstrap compiler. The excluded midpoint is 2^1024 - 2^970; a tie rounds to infinity. */
pub finiteFloatDigits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 309,
        "")
}

/** Checks finite binary32 literal rounding using decimal digits so both TS Math.fround(Number(...)) and C strtof produce finite values. */
pub finiteFloat32Digits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 39, "340282356779733642748073463979561713664")
}

/** Scans one unsigned decimal numeric token, retaining an Int-range witness and Float grammar/range components without target code or diagnostics. Exponent saturation preserves every possible cancellation with the literal's digits. */
pub scanNumericLiteral := fn(source: String, position: Int): (next: Int, integerEnd: Int, fractionStart: Int, fractionEnd: Int, exponent: Int, floating: Bool, exponentMissingAt: Int, magnitude: Int, outsideInt: Bool) {
    size := textLib.length(source);
    var cursor := position;
    var magnitude := 0;
    var outsideInt := false;
    loop cursor < size and textLib.isDigit(textLib.at(source, cursor)) {
        digit := textLib.digitValue(textLib.at(source, cursor));
        if not outsideInt {
            if magnitude < (-9223372036854775808 + digit) / 10 { outsideInt = true; }
            else { magnitude = magnitude * 10 - digit; }
        }
        cursor += 1;
    }
    integerEnd := cursor;
    var fractionStart := cursor;
    var fractionEnd := cursor;
    var floating := false;
    if cursor + 1 < size and textLib.at(source, cursor) == "." and textLib.isDigit(textLib.at(source, cursor + 1)) {
        floating = true;
        cursor += 1;
        fractionStart = cursor;
        loop cursor < size and textLib.isDigit(textLib.at(source, cursor)) { cursor += 1; }
        fractionEnd = cursor;
    }
    var exponent := 0;
    var exponentMissingAt := -1;
    if cursor < size and (textLib.at(source, cursor) == "e" or textLib.at(source, cursor) == "E") {
        floating = true;
        exponentAt := cursor;
        cursor += 1;
        var negativeExponent := false;
        if cursor < size and (textLib.at(source, cursor) == "+" or textLib.at(source, cursor) == "-") {
            negativeExponent = textLib.at(source, cursor) == "-";
            cursor += 1;
        }
        exponentStart := cursor;
        limit := size + 310;
        loop cursor < size and textLib.isDigit(textLib.at(source, cursor)) {
            digit := textLib.digitValue(textLib.at(source, cursor));
            if exponent > (limit - digit) / 10 { exponent = limit; }
            else { exponent = exponent * 10 + digit; }
            cursor += 1;
        }
        if cursor == exponentStart { exponentMissingAt = exponentAt; }
        if negativeExponent { exponent = -exponent; }
    }
    (next = cursor, =integerEnd, =fractionStart, =fractionEnd,
        =exponent, =floating, =exponentMissingAt, =magnitude, =outsideInt)
}
