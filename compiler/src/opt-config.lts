/** Composable compiler optimization and code-emission configuration (`-O0`..`-O3`, `-Os`, `-Oc`, and `-f...` overrides). */

listLib := import "core/list";
textLib := import "core/text";
emitFmt := import "./emit-format.lts";

/** Per-pass optimization and emission configuration. Presets (`-O0`..`-O3`, `-Os`, `-Oc`) set defaults; every field is overridable. */
pub OptConfig := type (
    ok: Bool,
    error: String,
    preset: String,
    constFold: Bool,
    branchSimplify: Bool,
    deadStore: Bool,
    blockPrune: Bool,
    dce: Bool,
    inlineLeaves: Bool,
    inlineMaxSize: Int,
    optRounds: Int,
    emitFormat: String,
    sourceMap: String,
    preserveComments: Bool,
    preserveDocs: Bool
);

/** Legacy numeric optLevel (`0`..`3`, `4`=`s`, `5`=`c`) -> preset code string. */
pub presetFromLegacyLevel := fn(optLevel: Int): String {
    if optLevel == 0 { "0" }
    else if optLevel == 1 { "1" }
    else if optLevel == 2 { "2" }
    else if optLevel == 3 { "3" }
    else if optLevel == 4 { "s" }
    else if optLevel == 5 { "c" }
    else { "1" }
};

/** Preset code string (`0`, `1`, `2`, `3`, `s`, `c`) -> legacy numeric level (`-1` if invalid). */
pub legacyLevelFromPreset := fn(raw: String): Int {
    if raw == "0" { 0 }
    else if raw == "1" { 1 }
    else if raw == "2" { 2 }
    else if raw == "3" { 3 }
    else if raw == "s" or raw == "S" { 4 }
    else if raw == "c" or raw == "C" { 5 }
    else { -1 }
};

/** Returns an error `OptConfig` with `ok = false`. */
failConfig := fn(base: OptConfig, message: String): OptConfig {
    (
        ok = false,
        error = message,
        preset = base.preset,
        constFold = base.constFold,
        branchSimplify = base.branchSimplify,
        deadStore = base.deadStore,
        blockPrune = base.blockPrune,
        dce = base.dce,
        inlineLeaves = base.inlineLeaves,
        inlineMaxSize = base.inlineMaxSize,
        optRounds = base.optRounds,
        emitFormat = base.emitFormat,
        sourceMap = base.sourceMap,
        preserveComments = base.preserveComments,
        preserveDocs = base.preserveDocs
    )
};

/** Returns the default `OptConfig` for a native preset (`"0"`, `"1"`, `"2"`, `"3"`, `"s"`, `"c"`) on `target` (`"ts"` or `"c"`). */
pub presetConfig := fn(preset: String, target: String): OptConfig {
    if preset == "c" or preset == "C" {
        /* Custom zero-default baseline: every optimization, purification, comment/doc, and source-map pass starts OFF. */
        return (
            ok = true,
            error = "",
            preset = "c",
            constFold = false,
            branchSimplify = false,
            deadStore = false,
            blockPrune = false,
            dce = false,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = -1,
            emitFormat = emitFmt.FORMAT_PRETTY,
            sourceMap = emitFmt.SOURCEMAP_NONE,
            preserveComments = false,
            preserveDocs = false
        );
    }
    if preset == "0" {
        /* Debug/inspection preset: zero optimizations, with source maps and root comments/docs preserved by default. */
        defaultSm := if target == "c" { emitFmt.SOURCEMAP_LINES } else { emitFmt.SOURCEMAP_COMMENTS };
        return (
            ok = true,
            error = "",
            preset = "0",
            constFold = false,
            branchSimplify = false,
            deadStore = false,
            blockPrune = false,
            dce = false,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 0,
            emitFormat = emitFmt.FORMAT_PRETTY,
            sourceMap = defaultSm,
            preserveComments = true,
            preserveDocs = true
        );
    }
    if preset == "2" {
        return (
            ok = true,
            error = "",
            preset = "2",
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 2,
            emitFormat = emitFmt.FORMAT_PRETTY,
            sourceMap = emitFmt.SOURCEMAP_NONE,
            preserveComments = false,
            preserveDocs = false
        );
    }
    if preset == "3" {
        return (
            ok = true,
            error = "",
            preset = "3",
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = true,
            inlineMaxSize = 256,
            optRounds = 3,
            emitFormat = emitFmt.FORMAT_PRETTY,
            sourceMap = emitFmt.SOURCEMAP_NONE,
            preserveComments = false,
            preserveDocs = false
        );
    }
    if preset == "s" or preset == "S" {
        return (
            ok = true,
            error = "",
            preset = "s",
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 2,
            emitFormat = emitFmt.FORMAT_COMPACT,
            sourceMap = emitFmt.SOURCEMAP_NONE,
            preserveComments = false,
            preserveDocs = false
        );
    }
    /* Default `-O1` preset. */
    (
        ok = true,
        error = "",
        preset = "1",
        constFold = false,
        branchSimplify = true,
        deadStore = true,
        blockPrune = true,
        dce = true,
        inlineLeaves = false,
        inlineMaxSize = 0,
        optRounds = 1,
        emitFormat = emitFmt.FORMAT_PRETTY,
        sourceMap = emitFmt.SOURCEMAP_NONE,
        preserveComments = false,
        preserveDocs = false
    )
};

/** Builds an `OptConfig` from legacy numeric `optLevel` and optional explicit `emitFormat` / `sourceMap` overrides. */
pub configFromLegacyOpts := fn(optLevel: Int, target: String, emitFormat: String, sourceMap: String): OptConfig {
    base := presetConfig(presetFromLegacyLevel(optLevel), target);
    effFmt := if emitFormat == emitFmt.FORMAT_PRETTY or emitFormat == emitFmt.FORMAT_COMPACT { emitFormat } else { base.emitFormat };
    effSm := if sourceMap == emitFmt.SOURCEMAP_NONE or sourceMap == emitFmt.SOURCEMAP_COMMENTS or sourceMap == emitFmt.SOURCEMAP_LINES { sourceMap } else { base.sourceMap };
    (
        ok = true,
        error = "",
        preset = base.preset,
        constFold = base.constFold,
        branchSimplify = base.branchSimplify,
        deadStore = base.deadStore,
        blockPrune = base.blockPrune,
        dce = base.dce,
        inlineLeaves = base.inlineLeaves,
        inlineMaxSize = base.inlineMaxSize,
        optRounds = base.optRounds,
        emitFormat = effFmt,
        sourceMap = effSm,
        preserveComments = base.preserveComments,
        preserveDocs = base.preserveDocs
    )
};

/** Parses a non-negative ASCII integer string; returns `-1` when invalid. */
parseNonNegInt := fn(raw: String): Int {
    n := textLib.length(raw);
    if n == 0 or n > 9 { return -1; }
    var acc := 0;
    var i := 0;
    loop i < n {
        ch := textLib.at(raw, i);
        d := if ch == "0" { 0 }
        else if ch == "1" { 1 }
        else if ch == "2" { 2 }
        else if ch == "3" { 3 }
        else if ch == "4" { 4 }
        else if ch == "5" { 5 }
        else if ch == "6" { 6 }
        else if ch == "7" { 7 }
        else if ch == "8" { 8 }
        else if ch == "9" { 9 }
        else { -1 };
        if d < 0 { return -1; }
        acc = acc * 10 + d;
        i = i + 1;
    }
    acc
};

/** True when `arg` is a recognized `-f...` or `-fno-...` pass configuration flag. */
pub isPassFlag := fn(arg: String): Bool {
    arg == "-fconst-fold" or arg == "-fno-const-fold" or
    arg == "-fbranch-simplify" or arg == "-fno-branch-simplify" or
    arg == "-fdead-store" or arg == "-fno-dead-store" or
    arg == "-fblock-prune" or arg == "-fno-block-prune" or
    arg == "-fdce" or arg == "-fno-dce" or
    arg == "-finline" or arg == "-fno-inline" or
    arg == "-fpreserve-comments" or arg == "-fno-preserve-comments" or
    arg == "-fpreserve-docs" or arg == "-fno-preserve-docs" or
    textLib.startsWithAt(arg, 0, "-finline-limit=") or
    textLib.startsWithAt(arg, 0, "-fopt-rounds=")
};

/** Resolves effective simplification round count (`0..8`), auto-enabling 1 round on `-Oc` when a round pass is opted in. */
pub effectiveOptRounds := fn(cfg: OptConfig): Int {
    hasRoundPass := cfg.branchSimplify or cfg.deadStore or cfg.blockPrune;
    if not hasRoundPass { return 0; }
    if cfg.optRounds < 0 { 1 } else { cfg.optRounds }
};

/** Resolves effective leaf-inline body size limit (`0` disables inlining). */
pub effectiveInlineMaxSize := fn(cfg: OptConfig): Int {
    if not cfg.inlineLeaves { return 0; }
    if cfg.inlineMaxSize > 0 { cfg.inlineMaxSize } else { 256 }
};

/** Parses `-O0`..`-O3`, `-Os`, `-Oc`, `--opt`, `--emit-format`, `--source-map`, and `-f...` pass overrides left-to-right. */
pub parseOptConfig := fn(rawArgs: List<String>, target: String): OptConfig {
    var cfg := presetConfig("1", target);
    args: mut List<String> = rawArgs;
    loop listLib.listCountText(args) > 0 {
        arg := listLib.popFront(mut args);
        if arg == "-O0" {
            cfg = presetConfig("0", target);
        } else if arg == "-O1" {
            cfg = presetConfig("1", target);
        } else if arg == "-O2" {
            cfg = presetConfig("2", target);
        } else if arg == "-O3" {
            cfg = presetConfig("3", target);
        } else if arg == "-Os" {
            cfg = presetConfig("s", target);
        } else if arg == "-Oc" {
            cfg = presetConfig("c", target);
        } else if textLib.startsWithAt(arg, 0, "-O") {
            return failConfig(cfg, "unsupported optimization flag " + arg + " (expected -O0, -O1, -O2, -O3, -Os, or -Oc)");
        } else if arg == "--opt" {
            if listLib.listCountText(args) == 0 {
                return failConfig(cfg, "missing value for --opt");
            }
            rawOpt := listLib.popFront(mut args);
            if legacyLevelFromPreset(rawOpt) < 0 {
                return failConfig(cfg, "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
            cfg = presetConfig(rawOpt, target);
        } else if textLib.startsWithAt(arg, 0, "--opt=") {
            rawOpt := textLib.slice(arg, 6, textLib.length(arg));
            if legacyLevelFromPreset(rawOpt) < 0 {
                return failConfig(cfg, "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
            cfg = presetConfig(rawOpt, target);
        } else if arg == "--emit-format" {
            if listLib.listCountText(args) == 0 {
                return failConfig(cfg, "missing value for --emit-format (expected pretty or compact)");
            }
            v := listLib.popFront(mut args);
            if v =!= emitFmt.FORMAT_PRETTY and v =!= emitFmt.FORMAT_COMPACT {
                return failConfig(cfg, "unsupported --emit-format " + v + " (expected pretty or compact)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = v, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if textLib.startsWithAt(arg, 0, "--emit-format=") {
            v := textLib.slice(arg, 14, textLib.length(arg));
            if v =!= emitFmt.FORMAT_PRETTY and v =!= emitFmt.FORMAT_COMPACT {
                return failConfig(cfg, "unsupported --emit-format " + v + " (expected pretty or compact)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = v, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "--source-map" {
            if listLib.listCountText(args) == 0 {
                return failConfig(cfg, "missing value for --source-map (expected none, comments, or lines)");
            }
            v := listLib.popFront(mut args);
            if v =!= emitFmt.SOURCEMAP_NONE and v =!= emitFmt.SOURCEMAP_COMMENTS and v =!= emitFmt.SOURCEMAP_LINES {
                return failConfig(cfg, "unsupported --source-map " + v + " (expected none, comments, or lines)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = v, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if textLib.startsWithAt(arg, 0, "--source-map=") {
            v := textLib.slice(arg, 13, textLib.length(arg));
            if v =!= emitFmt.SOURCEMAP_NONE and v =!= emitFmt.SOURCEMAP_COMMENTS and v =!= emitFmt.SOURCEMAP_LINES {
                return failConfig(cfg, "unsupported --source-map " + v + " (expected none, comments, or lines)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = v, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fconst-fold" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = true, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-const-fold" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = false, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fbranch-simplify" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = true, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-branch-simplify" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = false, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fdead-store" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = true, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-dead-store" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = false, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fblock-prune" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = true, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-block-prune" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = false, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fdce" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = true, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-dce" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = false, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-finline" {
            lim := if cfg.inlineMaxSize > 0 { cfg.inlineMaxSize } else { 256 };
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = true, inlineMaxSize = lim, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-inline" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = false, inlineMaxSize = 0, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if textLib.startsWithAt(arg, 0, "-finline-limit=") {
            rawN := textLib.slice(arg, 15, textLib.length(arg));
            n := parseNonNegInt(rawN);
            if n < 0 {
                return failConfig(cfg, "invalid -finline-limit value " + rawN + " (expected non-negative integer)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = n > 0, inlineMaxSize = n, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if textLib.startsWithAt(arg, 0, "-fopt-rounds=") {
            rawN := textLib.slice(arg, 13, textLib.length(arg));
            n := parseNonNegInt(rawN);
            if n < 0 or n > 8 {
                return failConfig(cfg, "invalid -fopt-rounds value " + rawN + " (expected 0..8)");
            }
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = n, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fpreserve-comments" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = true, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fno-preserve-comments" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = false, preserveDocs = cfg.preserveDocs);
        } else if arg == "-fpreserve-docs" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = true);
        } else if arg == "-fno-preserve-docs" {
            cfg = (ok = true, error = "", preset = cfg.preset, constFold = cfg.constFold, branchSimplify = cfg.branchSimplify, deadStore = cfg.deadStore, blockPrune = cfg.blockPrune, dce = cfg.dce, inlineLeaves = cfg.inlineLeaves, inlineMaxSize = cfg.inlineMaxSize, optRounds = cfg.optRounds, emitFormat = cfg.emitFormat, sourceMap = cfg.sourceMap, preserveComments = cfg.preserveComments, preserveDocs = false);
        } else if textLib.startsWithAt(arg, 0, "-f") {
            return failConfig(cfg, "unsupported optimization pass flag " + arg);
        } else if arg == "--builtin-mode" or arg == "--name" or arg == "--root" or arg == "--out" or arg == "--trace-json" {
            if listLib.listCountText(args) > 0 {
                _skip := listLib.popFront(mut args);
            }
        }
    }
    cfg
};
