/** Resolves the three public 64-bit numeric synonyms, or returns empty text for any other spelling. Shared by the frontend and normalized parser/checker phases. */

pub KIND_INT1 := "Int1";
pub KIND_INT2 := "Int2";
pub KIND_INT4 := "Int4";
pub KIND_INT8 := "Int8";
pub KIND_INT16 := "Int16";
pub KIND_INT32 := "Int32";
pub KIND_INT := "Int";
pub KIND_UINT1 := "UInt1";
pub KIND_UINT2 := "UInt2";
pub KIND_UINT4 := "UInt4";
pub KIND_UINT8 := "UInt8";
pub KIND_UINT16 := "UInt16";
pub KIND_UINT32 := "UInt32";
pub KIND_UINT64 := "UInt64";
pub KIND_FLOAT8 := "Float8";
pub KIND_FLOAT16 := "Float16";
pub KIND_FLOAT32 := "Float32";
pub KIND_FLOAT := "Float";
pub KIND_STRING := "String";
pub KIND_BOOL := "Bool";
pub KIND_UNIT := "Unit";
pub KIND_NEVER := "Never";

/** Resolves canonical numeric type alias `name` to its internal kind, or `""` if unknown. */
pub numericAliasKind := fn(name: String): String {
    if name == "Int64" { KIND_INT }
    else if name == "Float64" or name == "Double" { KIND_FLOAT }
    else { "" }
}

/** True when `kind` is one of the signed integer scalar types (`Int1`..`Int`). */
pub isSignedIntKind := fn(kind: String): Bool {
    kind == KIND_INT1 or kind == KIND_INT2 or kind == KIND_INT4 or
    kind == KIND_INT8 or kind == KIND_INT16 or kind == KIND_INT32 or kind == KIND_INT
}

/** True when `kind` is one of the unsigned integer scalar types (`UInt1`..`UInt64`). */
pub isUnsignedIntKind := fn(kind: String): Bool {
    kind == KIND_UINT1 or kind == KIND_UINT2 or kind == KIND_UINT4 or
    kind == KIND_UINT8 or kind == KIND_UINT16 or kind == KIND_UINT32 or kind == KIND_UINT64
}

/** True when `kind` is any signed or unsigned integer scalar type (`Int1`..`Int`, `UInt1`..`UInt64`). */
pub isIntKind := fn(kind: String): Bool {
    isSignedIntKind(kind) or isUnsignedIntKind(kind)
}

/** True when `kind` is a sub-byte integer type (`1`, `2`, or `4` bits) bit-packed in fixed arrays. */
pub isSubByteIntKind := fn(kind: String): Bool {
    kind == KIND_INT1 or kind == KIND_INT2 or kind == KIND_INT4 or
    kind == KIND_UINT1 or kind == KIND_UINT2 or kind == KIND_UINT4
}

/** True when `kind` is one of the binary float scalar types (`Float8`, `Float16`, `Float32`, `Float`). */
pub isFloatKind := fn(kind: String): Bool {
    kind == KIND_FLOAT8 or kind == KIND_FLOAT16 or kind == KIND_FLOAT32 or kind == KIND_FLOAT
}

/** True when `kind` is any integer or binary float scalar type. */
pub isNumericKind := fn(kind: String): Bool {
    isIntKind(kind) or isFloatKind(kind)
}

/** True when `kind` is a bounded fixed-width signed integer type narrower than `Int`. */
pub isNarrowSignedIntKind := fn(kind: String): Bool {
    kind == KIND_INT1 or kind == KIND_INT2 or kind == KIND_INT4 or
    kind == KIND_INT8 or kind == KIND_INT16 or kind == KIND_INT32
}

/** True when `kind` is a bounded fixed-width unsigned integer type narrower than `UInt64`. */
pub isNarrowUnsignedIntKind := fn(kind: String): Bool {
    kind == KIND_UINT1 or kind == KIND_UINT2 or kind == KIND_UINT4 or
    kind == KIND_UINT8 or kind == KIND_UINT16 or kind == KIND_UINT32
}

/** True when `kind` is a bounded fixed-width integer type narrower than 64 bits. */
pub isNarrowIntKind := fn(kind: String): Bool {
    isNarrowSignedIntKind(kind) or isNarrowUnsignedIntKind(kind)
}

/** True when `kind` is any non-default numeric scalar type (`Int1..Int32`, `UInt1..UInt64`, `Float8..Float32`). */
pub isNarrowNumericKind := fn(kind: String): Bool {
    isNarrowIntKind(kind) or kind == KIND_UINT64 or
    kind == KIND_FLOAT8 or kind == KIND_FLOAT16 or kind == KIND_FLOAT32
}

/** Returns the integer bit width for a signed or unsigned integer scalar kind. */
pub narrowIntBits := fn(kind: String): Int8 {
    if kind == KIND_INT1 or kind == KIND_UINT1 { 1 }
    else if kind == KIND_INT2 or kind == KIND_UINT2 { 2 }
    else if kind == KIND_INT4 or kind == KIND_UINT4 { 4 }
    else if kind == KIND_INT8 or kind == KIND_UINT8 { 8 }
    else if kind == KIND_INT16 or kind == KIND_UINT16 { 16 }
    else if kind == KIND_INT32 or kind == KIND_UINT32 { 32 }
    else { 64 }
}

/** True when `value` (as signed Int64) fits in the range of integer scalar kind `kind`. */
pub intKindFits := fn(kind: String, value: Int): Bool {
    if kind == KIND_INT1 { value >= -1 and value <= 0 }
    else if kind == KIND_INT2 { value >= -2 and value <= 1 }
    else if kind == KIND_INT4 { value >= -8 and value <= 7 }
    else if kind == KIND_INT8 { value >= -128 and value <= 127 }
    else if kind == KIND_INT16 { value >= -32768 and value <= 32767 }
    else if kind == KIND_INT32 { value >= -2147483648 and value <= 2147483647 }
    else if kind == KIND_INT { true }
    else if kind == KIND_UINT1 { value >= 0 and value <= 1 }
    else if kind == KIND_UINT2 { value >= 0 and value <= 3 }
    else if kind == KIND_UINT4 { value >= 0 and value <= 15 }
    else if kind == KIND_UINT8 { value >= 0 and value <= 255 }
    else if kind == KIND_UINT16 { value >= 0 and value <= 65535 }
    else if kind == KIND_UINT32 { value >= 0 and value <= 4294967295 }
    else if kind == KIND_UINT64 { value >= 0 }
    else { false }
}

/** True when non-negative decimal digit string `digits` fits inside unsigned 64-bit range `0..18446744073709551615`. */
pub uint64DigitsFit := fn(digits: String): Bool {
    finiteDigitsAtMost(digits, 0, 0, 20, "18446744073709551615")
}

/** Returns the width rank inside a numeric family (`Int*` / `UInt*`: `1..7`, `Float*`: `1..4`). */
pub numericRank := fn(kind: String): Int8 {
    if kind == KIND_INT1 or kind == KIND_UINT1 or kind == KIND_FLOAT8 { 1 }
    else if kind == KIND_INT2 or kind == KIND_UINT2 or kind == KIND_FLOAT16 { 2 }
    else if kind == KIND_INT4 or kind == KIND_UINT4 or kind == KIND_FLOAT32 { 3 }
    else if kind == KIND_INT8 or kind == KIND_UINT8 or kind == KIND_FLOAT { 4 }
    else if kind == KIND_INT16 or kind == KIND_UINT16 { 5 }
    else if kind == KIND_INT32 or kind == KIND_UINT32 { 6 }
    else if kind == KIND_INT or kind == KIND_UINT64 { 7 }
    else { 0 }
}

/** Promotes two numeric kinds inside the same family (`Signed`, `Unsigned`, or `Float*`) to the wider kind, or returns empty text across families. */
pub promoteNumericKind := fn(leftKind: String, rightKind: String): String {
    if isSignedIntKind(leftKind) and isSignedIntKind(rightKind) {
        if numericRank(leftKind) >= numericRank(rightKind) { leftKind } else { rightKind }
    } else if isUnsignedIntKind(leftKind) and isUnsignedIntKind(rightKind) {
        if numericRank(leftKind) >= numericRank(rightKind) { leftKind } else { rightKind }
    } else if isFloatKind(leftKind) and isFloatKind(rightKind) {
        if numericRank(leftKind) >= numericRank(rightKind) { leftKind } else { rightKind }
    } else { "" }
}

/** True when `actual` losslessly widens to `expected` under LiteScript's fixed-width numeric rules. */
pub numericWidens := fn(expected: String, actual: String): Bool {
    if isSignedIntKind(expected) and isSignedIntKind(actual) {
        numericRank(actual) <= numericRank(expected)
    } else if isUnsignedIntKind(expected) and isUnsignedIntKind(actual) {
        numericRank(actual) <= numericRank(expected)
    } else if isFloatKind(expected) and isFloatKind(actual) {
        numericRank(actual) <= numericRank(expected)
    } else if isFloatKind(expected) and isIntKind(actual) {
        bits := narrowIntBits(actual);
        if expected == KIND_FLOAT8 { bits <= 4 }
        else if expected == KIND_FLOAT16 { bits <= 8 }
        else if expected == KIND_FLOAT32 { bits <= 16 }
        else { bits <= 32 }
    } else { false }
}

/** True when an admitted Int64 value has no nonzero bits beyond the positive binary float significand limit. Division avoids taking the absolute value of Int64.MIN. */
intWithinFloatLimit := fn(input: Int, limit: Int): Bool {
    var value := input;
    loop value > limit or value < -limit {
        if value % 2 =!= 0 { return false; }
        value /= 2;
    }
    true
}

/** True when an admitted Int64 value has no nonzero bits beyond binary64 precision. */
pub intExactlyFloat := fn(input: Int): Bool {
    intWithinFloatLimit(input, 9007199254740992)
}

/** True when an admitted Int64 value has no nonzero bits beyond binary32 precision. */
pub intExactlyFloat32 := fn(input: Int): Bool {
    intWithinFloatLimit(input, 16777216)
}

/** True when an admitted Int64 value has no nonzero bits beyond IEEE binary16 finite range & precision (`±65504`). */
pub intExactlyFloat16 := fn(input: Int): Bool {
    input >= -65504 and input <= 65504 and intWithinFloatLimit(input, 2048)
}

/** True when an admitted Int64 value is exactly representable in OCP E4M3 `Float8` (`±448`, 3 mantissa bits). */
pub intExactlyFloat8 := fn(input: Int): Bool {
    input >= -448 and input <= 448 and intWithinFloatLimit(input, 16)
}

/** Checks decimal digits against an inclusive maximum (`maxPower`, `limitDigits`). */
finiteDigitsAtMost := fn(digits: String, fractionCount: Int, exponent: Int, maxPower: Int16, limitDigits: String): Bool {
    var first := 0;
    loop first < digits.length() and digits.at(first) == "0" { first += 1; }
    if first == digits.length() { return true; }
    significant := digits.slice(first, digits.length());
    power := significant.length() - fractionCount + exponent;
    if power < maxPower { return true; }
    if power > maxPower { return false; }
    var count := significant.length();
    if count < limitDigits.length() { count = limitDigits.length(); }
    var index := 0;
    loop index < count {
        left := if index < significant.length() { significant.at(index).digitValue() } else { 0 };
        right := if index < limitDigits.length() { limitDigits.at(index).digitValue() } else { 0 };
        if left < right { return true; }
        if left > right { return false; }
        index += 1;
    }
    true
}

/** Compares a decimal literal's significant digits and power against an excluded overflow midpoint without runtime float math. */
finiteDigitsWithin := fn(digits: String, fractionCount: Int, exponent: Int, maxPower: Int16, midpoint: String): Bool {
    var first := 0;
    loop first < digits.length() and digits.at(first) == "0" { first += 1; }
    if first == digits.length() { return true; }
    significant := digits.slice(first, digits.length());
    power := significant.length() - fractionCount + exponent;
    if power < maxPower { return true; }
    if power > maxPower { return false; }
    var count := significant.length();
    if count < midpoint.length() { count = midpoint.length(); }
    var index := 0;
    loop index < count {
        left := if index < significant.length() { significant.at(index).digitValue() } else { 0 };
        right := if index < midpoint.length() { midpoint.at(index).digitValue() } else { 0 };
        if left < right { return true; }
        if left > right { return false; }
        index += 1;
    }
    false
}

/** Checks finite binary64 literal rounding using decimal digits, without requiring Float arithmetic in the bootstrap compiler. The excluded midpoint is 2^1024 - 2^970; a tie rounds to infinity. */
pub finiteFloatDigits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 309,
        "")
}

/** Checks finite binary32 literal rounding using decimal digits so both TS Math.fround(Number(...)) and C strtof produce finite values. */
pub finiteFloat32Digits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 39, "340282356779733642748073463979561713664")
}

/** Checks finite IEEE binary16 literal rounding (`|x| < 65520`). */
pub finiteFloat16Digits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 5, "6552")
}

/** Checks finite OCP E4M3 Float8 literal rounding (`|x| < 464`). */
pub finiteFloat8Digits := fn(digits: String, fractionCount: Int, exponent: Int): Bool {
    finiteDigitsWithin(digits, fractionCount, exponent, 3, "464")
}

/** Scans one unsigned decimal numeric token, retaining an Int-range witness and Float grammar/range components without target code or diagnostics. Exponent saturation preserves every possible cancellation with the literal's digits. */
pub scanNumericLiteral := fn(source: String, position: Int): (next: Int, integerEnd: Int, fractionStart: Int, fractionEnd: Int, exponent: Int, floating: Bool, exponentMissingAt: Int, magnitude: Int, outsideInt: Bool) {
    size := source.length();
    var cursor := position;
    var magnitude := 0;
    var outsideInt := false;
    loop cursor < size and source.at(cursor).isDigit() {
        digit := source.at(cursor).digitValue();
        if not outsideInt {
            if magnitude < (-9223372036854775808 + digit) / 10 { outsideInt = true; }
            else { magnitude = magnitude * 10 - digit; }
        }
        cursor += 1;
    }
    integerEnd := cursor;
    var fractionStart := cursor;
    var fractionEnd := cursor;
    var floating := false;
    if cursor + 1 < size and source.at(cursor) == "." and source.at(cursor + 1).isDigit() {
        floating = true;
        cursor += 1;
        fractionStart = cursor;
        loop cursor < size and source.at(cursor).isDigit() { cursor += 1; }
        fractionEnd = cursor;
    }
    var exponent := 0;
    var exponentMissingAt := -1;
    if cursor < size and (source.at(cursor) == "e" or source.at(cursor) == "E") {
        floating = true;
        exponentAt := cursor;
        cursor += 1;
        var negativeExponent := false;
        if cursor < size and (source.at(cursor) == "+" or source.at(cursor) == "-") {
            negativeExponent = source.at(cursor) == "-";
            cursor += 1;
        }
        exponentStart := cursor;
        limit := size + 310;
        loop cursor < size and source.at(cursor).isDigit() {
            digit := source.at(cursor).digitValue();
            if exponent > (limit - digit) / 10 { exponent = limit; }
            else { exponent = exponent * 10 + digit; }
            cursor += 1;
        }
        if cursor == exponentStart { exponentMissingAt = exponentAt; }
        if negativeExponent { exponent = -exponent; }
    }
    (next = cursor, =integerEnd, =fractionStart, =fractionEnd,
        =exponent, =floating, =exponentMissingAt, =magnitude, =outsideInt)
}
