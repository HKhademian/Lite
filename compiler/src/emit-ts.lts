            io.outputLine("            } else { return { ok: false, line: \"\", eof: false, error: \"invalid reader handle\" }; }");
            io.outputLine("        } else {");
            io.outputLine("            try {");
            io.outputLine("                const read = fs.readSync(0, one, 0, 1, null);");
            io.outputLine("                if (read === 0) { lite$stdinState.eof = true; break; }");
            io.outputLine("                nextByte = one[0] ?? 0;");
