/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Maps a restricted Lite scalar kind to its TypeScript type. */
tsScalarType := fn(kind: String): String {
    if kind == "Int" { "bigint" }
    else if kind == "String" { "string" }
    else if kind == "Bool" { "boolean" }
    else { "void" }
}

/** Formats one canonical flat named-tuple kind as a TypeScript object type. */
tsTupleType := fn(kind: String): String {
    size := textLength(kind);
    var cursor := 1;
    var result := "{ ";
    var count := 0;
    loop cursor < size and textAt(kind, cursor) =!= ")" {
        nameStart := cursor;
        cursor = skipName(kind, cursor);
        label := textSlice(kind, nameStart, cursor);
        if cursor < size and textAt(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipName(kind, cursor);
        fieldKind := textSlice(kind, typeStart, cursor);
        if count > 0 { result = result + " "; }
        result = result + label + ": " + tsScalarType(fieldKind);
        count = count + 1;
        if cursor < size and textAt(kind, cursor) == "," {
            result = result + ";";
            cursor = cursor + 1;
        }
    }
    result + " }"
}

/** Maps a restricted Lite scalar, flat named-tuple or List kind to its TypeScript type. */
tsFunctionType := fn(kind: String): String {
    if isListKind(kind) { tsFunctionType(listElementKind(kind)) + "[]" }
    else if isTupleKind(kind) { tsTupleType(kind) }
    else { tsScalarType(kind) }
}

/** Formats a `|`-separated `name=kind` parameter list as a TypeScript parameter list. */
tsParameterList := fn(encoded: String): String {
    if encoded == "" { return ""; }
    var result := "";
    var start := 0;
    loop true {
        separator := indexOfText(encoded, "|", start);
        var end := textLength(encoded);
        if separator >= 0 { end = separator; }
        entry := textSlice(encoded, start, end);
        equals := indexOfText(entry, "=", 0);
        parameterName := textSlice(entry, 0, equals);
        parameterKind := textSlice(entry, equals + 1, textLength(entry));
        if textLength(result) > 0 { result = result + ", "; }
        result = result + "lite_" + parameterName + ": " + tsFunctionType(parameterKind);
        if separator < 0 { break; }
        start = separator + 1;
    }
    result
}

/** Emits `void` reads for parameters so strict unused-parameter checking accepts bodies that ignore inputs. */
reportParameterReads := fn(encoded: String, indent: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        separator := indexOfText(encoded, "|", start);
        var end := textLength(encoded);
        if separator >= 0 { end = separator; }
        entry := textSlice(encoded, start, end);
        equals := indexOfText(entry, "=", 0);
        report(indent + "void lite_" + textSlice(entry, 0, equals) + ";");
        if separator < 0 { break; }
        start = separator + 1;
    }
}

/** Formats one report argument as a TypeScript string expression. */
reportArgumentCode := fn(item: Item): String {
    if item.kind == "Int" { "(" + item.code + ").toString()" }
    else if item.kind == "Bool" { "((" + item.code + ") ? \"true\" : \"false\")" }
    else { item.code }
}

/** True when any emitted item reads a list element through the checked helper. */
usesListIndex := fn(items: Items): Bool {
    loop items as item {
        if codeUsesListIndex(item.code) { return true; }
    }
    false
}

/** True when any emitted item pops a list element through the checked helper. */
usesListPop := fn(items: Items): Bool {
    loop items as item {
        if codeUsesListPop(item.code) { return true; }
    }
    false
}

/** True when any emitted item calls the named `lite$` helper outside quoted String literal text. */
usesBuiltin := fn(items: Items, name: String): Bool {
    loop items as item {
        if codeUsesTextCall(item.code, "lite$" + name + "(") { return true; }
    }
    false
}

/** Emits the self-contained declarations and helpers for the I/O and text builtins a program uses. */
emitBuiltinHelpers := fn(items: Items): Unit {
    if usesBuiltin(items, "inputArgs") or usesBuiltin(items, "inputAll") or
        usesBuiltin(items, "reportError") or usesBuiltin(items, "exit") {
        report("declare const process: {");
        report("    argv: string[];");
        report("    exit(code: number): never;");
        report("    getBuiltinModule(name: \"node:fs\"): {");
        report("        readFileSync(fd: number, encoding: \"utf8\"): string;");
        report("        writeSync(fd: number, text: string): number;");
        report("    };");
        report("};");
        report("");
    }
    if usesBuiltin(items, "inputArgs") {
        report("function lite$inputArgs(): string[] {");
        report("    return process.argv.slice(2);");
        report("}");
        report("");
    }
    if usesBuiltin(items, "inputAll") {
        report("function lite$inputAll(): string {");
        report("    return process.getBuiltinModule(\"node:fs\").readFileSync(0, \"utf8\");");
        report("}");
        report("");
    }
    if usesBuiltin(items, "reportError") {
        report("function lite$reportError(text: string): void {");
        report("    process.getBuiltinModule(\"node:fs\").writeSync(2, text + \"\\n\");");
        report("}");
        report("");
    }
    if usesBuiltin(items, "exit") {
        report("function lite$exit(status: bigint): void {");
        report("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite_out);");
        report("    process.exit(Number(status));");
        report("}");
        report("");
    }
    if usesBuiltin(items, "textLength") {
        report("function lite$textLength(text: string): bigint {");
        report("    return BigInt(Array.from(text).length);");
        report("}");
        report("");
    }
    if usesBuiltin(items, "textAt") {
        report("function lite$textAt(text: string, position: bigint): string {");
        report("    const points = Array.from(text);");
        report("    if (position < 0n || position >= BigInt(points.length)) {");
        report("        throw new Error(\"BoundPanic: textAt index outside text\");");
        report("    }");
        report("    const value = points[Number(position)];");
        report("    if (value === undefined) {");
        report("        throw new Error(\"BoundPanic: textAt index outside text\");");
        report("    }");
        report("    return value;");
        report("}");
        report("");
    }
    if usesBuiltin(items, "textSlice") {
        report("function lite$textSlice(text: string, start: bigint, end: bigint): string {");
        report("    const points = Array.from(text);");
        report("    if (start < 0n || end < start || end > BigInt(points.length)) {");
        report("        throw new Error(\"BoundPanic: textSlice requires 0 <= start <= end <= textLength(text)\");");
        report("    }");
        report("    return points.slice(Number(start), Number(end)).join(\"\");");
        report("}");
        report("");
    }
    return;
}

/** Emits the checked list-index helper used by generated programs that read list elements. */
emitListIndexHelper := fn(): Unit {
    report("function lite$listAt<T>(items: readonly T[], index: bigint): T {");
    report("    if (index < 0n || index >= BigInt(items.length)) {");
    report("        throw new Error(\"BoundPanic: list index outside its extent\");");
    report("    }");
    report("    const value = items[Number(index)];");
    report("    if (value === undefined) {");
    report("        throw new Error(\"BoundPanic: list index outside its extent\");");
    report("    }");
    report("    return value;");
    report("}");
    report("");
}

/** Emits the checked list-pop helper used by generated programs that pop a list tail. */
emitListPopHelper := fn(): Unit {
    report("function lite$listPopBack<T>(items: T[]): T {");
    report("    const value = items.pop();");
    report("    if (value === undefined) {");
    report("        throw new Error(\"BoundPanic: pop_back on an empty list\");");
    report("    }");
    report("    return value;");
    report("}");
    report("");
}

/** Emits the checked truncating BigInt division helper used by generated programs that divide at runtime. */
emitIntDivideHelper := fn(): Unit {
    report("function lite$divideInt(left: bigint, right: bigint): bigint {");
    report("    if (right === 0n) {");
    report("        throw new Error(\"ArithmeticPanic: division by zero in integer expression\");");
    report("    }");
    report("    if (left === -(1n << 63n) && right === -1n) {");
    report("        throw new Error(\"ArithmeticPanic: integer expression outside signed 64-bit range\");");
    report("    }");
    report("    return left / right;");
    report("}");
    report("");
}

/** Emits the checked BigInt remainder helper used by generated programs that take a runtime remainder. */
emitIntRemainderHelper := fn(): Unit {
    report("function lite$remainderInt(left: bigint, right: bigint): bigint {");
    report("    if (right === 0n) {");
    report("        throw new Error(\"ArithmeticPanic: remainder by zero in integer expression\");");
    report("    }");
    report("    if (left === -(1n << 63n) && right === -1n) {");
    report("        throw new Error(\"ArithmeticPanic: integer expression outside signed 64-bit range\");");
    report("    }");
    report("    return left % right;");
    report("}");
    report("");
}

/** Emits the checked BigInt floor-division helper used by generated programs that floor-divide at runtime. */
emitIntFloorDivideHelper := fn(): Unit {
    report("function lite$floorDivideInt(left: bigint, right: bigint): bigint {");
    report("    const quotient = lite$divideInt(left, right);");
    report("    const remainder = left % right;");
    report("    return remainder !== 0n && (left < 0n) !== (right < 0n) ? quotient - 1n : quotient;");
    report("}");
    report("");
}

/** Emits the checked BigInt floor-modulo helper used by generated programs that take a runtime floor modulo. */
emitIntFloorModuloHelper := fn(): Unit {
    report("function lite$floorModuloInt(left: bigint, right: bigint): bigint {");
    report("    if (right === 0n) {");
    report("        throw new Error(\"ArithmeticPanic: modulo by zero in integer expression\");");
    report("    }");
    report("    const remainder = left % right;");
    report("    return remainder !== 0n && (remainder < 0n) !== (right < 0n) ? remainder + right : remainder;");
    report("}");
    report("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(items: Items): Unit {
    if (usesBuiltin(items, "divideInt") or usesBuiltin(items, "floorDivideInt")) { emitIntDivideHelper(); }
    if usesBuiltin(items, "remainderInt") { emitIntRemainderHelper(); }
    if usesBuiltin(items, "floorDivideInt") { emitIntFloorDivideHelper(); }
    if usesBuiltin(items, "floorModuloInt") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the TS module from the flat item stream. Locals become const/let declarations, control flow becomes braces, and reports append to and return `lite_out`. */
emitProgram := fn(items: Items): Unit {
    hasExit := usesBuiltin(items, "exit");
    if hasExit {
        report("let lite_out = \"\";");
        report("");
    }
    emitBuiltinHelpers(items);
    if usesListIndex(items) { emitListIndexHelper(); }
    if usesListPop(items) { emitListPopHelper(); }
    emitIntDivisionHelpers(items);
    report("export function main(): string {");
    if not hasExit { report("    let lite_out = \"\";"); }
    var indent := "    ";
    var line := "";
    var count := 0;
    loop items as item {
        if item.kind == "FunctionStart" {
            report(indent + "function " + item.runtime + "(" + tsParameterList(item.textValue) + "): " +
                tsFunctionType(item.code) + " {");
            indent = indent + "    ";
            reportParameterReads(item.textValue, indent);
        } else if item.kind == "FunctionEnd" {
            indent = dedent(indent);
            report(indent + "}");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "Return" {
            if item.code == "" {
                report(indent + "return;");
            } else {
                report(indent + "return " + item.code + ";");
            }
        } else if item.kind == "Call" {
            report(indent + item.code + ";");
        } else if item.kind == "LocalInt" or item.kind == "LocalString" or item.kind == "LocalBool" or item.kind == "LocalTuple" {
            report(indent + "const " + item.runtime + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "LocalList" {
            report(indent + "const " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarInt" or item.kind == "VarString" or item.kind == "VarBool" or item.kind == "VarTuple" {
            report(indent + "let " + item.runtime + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarList" {
            report(indent + "let " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignTuple" {
            report(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "AssignList" {
            report(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "If" {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            report(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            report(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "LoopSeq" {
            report(indent + "for (const " + item.runtime + " of " + listCopyCode(item.code) + ") {");
            indent = indent + "    ";
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "Boolean(true)" }
                else if item.code == "false" { "Boolean(false)" }
                else { item.code };
            report(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "End" {
            report(indent + "lite_out += " + line + " + \"\\n\";");
            line = "";
            count = 0;
        } else {
            if count > 0 { line = line + " + \" \" + "; }
            line = line + reportArgumentCode(item);
            count = count + 1;
        }
    }
    report("    return lite_out;");
    report("}");
}
