            io.outputLine("    if (lineBytes.length === 0) return { ok: true, line: \"\", eof: true, error: \"\" };");
            io.outputLine("    try { return { ok: true, line: new TextDecoder(\"utf-8\", { fatal: true }).decode(Uint8Array.from(lineBytes)), eof: false, error: \"\" }; }");
