            io.outputLine("    }");
            io.outputLine("    const entry = lite$lookupStream(writer.handle);");
            io.outputLine("    if (entry === undefined) return { ok: false, written: 0n, error: \"invalid writer handle\" };");
            io.outputLine("    if (entry.kind === \"error\") return { ok: false, written: 0n, error: entry.error };");
            io.outputLine("    if (entry.kind === \"bufferReader\") return { ok: false, written: 0n, error: \"handle is a reader, not a writer\" };");
