/** Emits host process, env, and child-execution helpers used by the program. */
emitProcessHelpers := fn(calls: String): Unit {
    if not usesProcess(calls) { return; }
    if usesBuiltin(calls, "processCwd") { io.outputLine("function lite$processCwd(): string { return process.cwd(); }"); }
    if usesBuiltin(calls, "processExecPath") { io.outputLine("function lite$processExecPath(): string { return process.execPath; }"); }
    if usesBuiltin(calls, "processEntryPath") { io.outputLine("function lite$processEntryPath(): string { return process.argv[1] ?? \"\"; }"); }
    if usesBuiltin(calls, "processPlatform") { io.outputLine("function lite$processPlatform(): string { return process.platform; }"); }
    if usesBuiltin(calls, "processArch") { io.outputLine("function lite$processArch(): string { return process.arch; }"); }
    if usesBuiltin(calls, "processRuntimeVersion") { io.outputLine("function lite$processRuntimeVersion(): string { return process.version; }"); }
    if usesBuiltin(calls, "processEnvGet") {
        io.outputLine("function lite$processEnvGet(name: string): { found: boolean; value: string } {");
        io.outputLine("    if (!Object.prototype.hasOwnProperty.call(process.env, name)) return { found: false, value: \"\" };");
        io.outputLine("    const raw = process.env[name];");
        io.outputLine("    return raw === undefined ? { found: false, value: \"\" } : { found: true, value: raw };");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "processRun") or usesBuiltin(calls, "processRunBytes") {
        io.outputLine("function lite$buildEnv(envOverrides: readonly string[]): { ok: true; env: Record<string, string | undefined> } | { ok: false; error: string } {");
        io.outputLine("    const env: Record<string, string | undefined> = { ...process.env };");
        io.outputLine("    for (const entry of envOverrides) {");
        io.outputLine("        const eq = entry.indexOf(\"=\");");
        io.outputLine("        if (eq === 0) { delete env[entry.slice(1)]; }");
        io.outputLine("        else if (eq > 0) { env[entry.slice(0, eq)] = entry.slice(eq + 1); }");
        io.outputLine("        else { return { ok: false, error: \"invalid environment override: \" + entry }; }");
        io.outputLine("    }");
        io.outputLine("    return { ok: true, env };");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "processRun") {
        io.outputLine("function lite$processRun(command: string, args: string[], cwd: string, envOverrides: string[], capture: boolean, stdinText: string): { status: bigint; stdout: string; stderr: string; error: string } {");
        io.outputLine("    const built = lite$buildEnv(envOverrides);");
        io.outputLine("    if (!built.ok) return { status: -1n, stdout: \"\", stderr: \"\", error: built.error };");
        io.outputLine("    const opts: { cwd?: string; env: Record<string, string | undefined>; encoding?: \"utf8\"; input?: string; stdio: \"inherit\" | readonly [\"pipe\", \"pipe\", \"pipe\"]; maxBuffer: number } = capture");
        io.outputLine("        ? { env: built.env, encoding: \"utf8\", input: stdinText, stdio: [\"pipe\", \"pipe\", \"pipe\"], maxBuffer: 128 * 1024 * 1024 }");
        io.outputLine("        : { env: built.env, stdio: \"inherit\", maxBuffer: 128 * 1024 * 1024 };");
        io.outputLine("    if (cwd !== \"\") opts.cwd = cwd;");
        io.outputLine("    const res = process.getBuiltinModule(\"node:child_process\").spawnSync(command, args, opts);");
        io.outputLine("    const stdout = res.stdout ?? \"\";");
        io.outputLine("    const stderr = res.stderr ?? \"\";");
        io.outputLine("    if (res.error !== undefined) return { status: -1n, stdout, stderr, error: res.error instanceof Error ? res.error.message : String(res.error) };");
        io.outputLine("    if (res.signal !== null) return { status: -1n, stdout, stderr, error: \"terminated by signal \" + res.signal };");
        io.outputLine("    return { status: BigInt(res.status ?? 1), stdout, stderr, error: \"\" };");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "processRunBytes") {
        io.outputLine("function lite$processRunBytes(command: string, args: string[], cwd: string, envOverrides: string[], timeoutMs: bigint, stdinBytes: readonly bigint[], stdoutPath: string, stderrPath: string): { status: bigint; error: string } {");
        io.outputLine("    const built = lite$buildEnv(envOverrides);");
        io.outputLine("    if (!built.ok) return { status: -1n, error: built.error };");
        io.outputLine("    const fs = process.getBuiltinModule(\"node:fs\");");
        io.outputLine("    let input: Uint8Array;");
        io.outputLine("    try { input = lite$toBytes(stdinBytes); }");
        io.outputLine("    catch (error) { return { status: -1n, error: lite$errMsg(error) }; }");
        io.outputLine("    const opts: { cwd?: string; env: Record<string, string | undefined>; input: Uint8Array; stdio: readonly [\"pipe\", \"pipe\", \"pipe\"]; timeout?: number; maxBuffer: number } = {");
        io.outputLine("        env: built.env, input, stdio: [\"pipe\", \"pipe\", \"pipe\"], maxBuffer: 128 * 1024 * 1024,");
        io.outputLine("    };");
        io.outputLine("    if (cwd !== \"\") opts.cwd = cwd;");
        io.outputLine("    if (timeoutMs > 0n) opts.timeout = Number(timeoutMs);");
        io.outputLine("    const res = process.getBuiltinModule(\"node:child_process\").spawnSync(command, args, opts);");
        io.outputLine("    try {");
        io.outputLine("        if (stdoutPath !== \"\") fs.writeFileSync(stdoutPath, res.stdout ?? new Uint8Array(0));");
        io.outputLine("        if (stderrPath !== \"\") fs.writeFileSync(stderrPath, res.stderr ?? new Uint8Array(0));");
        io.outputLine("    } catch (error) { return { status: -1n, error: lite$errMsg(error) }; }");
        io.outputLine("    if (res.error !== undefined) return { status: -1n, error: lite$errMsg(res.error) };");
        io.outputLine("    if (res.signal !== null) return { status: -1n, error: \"terminated by signal \" + res.signal };");
        io.outputLine("    return { status: BigInt(res.status ?? 1), error: \"\" };");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Emits host crypto and clock helpers used by the program. */
emitCryptoAndTimeHelpers := fn(calls: String): Unit {
    if usesBuiltin(calls, "cryptoDigestBytes") {
        io.outputLine("function lite$cryptoDigestBytes(algorithm: string, bytes: readonly bigint[]): string {");
        io.outputLine("    if (algorithm !== \"sha256\" && algorithm !== \"sha512\") {");
        io.outputLine("        throw new Error(\"unsupported digest algorithm: \" + algorithm);");
        io.outputLine("    }");
        io.outputLine("    return process.getBuiltinModule(\"node:crypto\").createHash(algorithm).update(lite$toBytes(bytes)).digest(\"hex\");");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "cryptoRandomBytes") {
        io.outputLine("function lite$cryptoRandomBytes(count: bigint): bigint[] {");
        io.outputLine("    if (count < 0n || count > 2147483647n) {");
        io.outputLine("        throw new Error(\"randomBytes count out of range: \" + String(count));");
        io.outputLine("    }");
        io.outputLine("    return lite$fromBytes(process.getBuiltinModule(\"node:crypto\").randomBytes(Number(count)));");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "timeMonotonicNs") {
        io.outputLine("function lite$timeMonotonicNs(): bigint { return process.hrtime.bigint(); }");
    }
    if usesBuiltin(calls, "timeEpochNs") {
        io.outputLine("function lite$timeEpochNs(): bigint { return BigInt(Date.now()) * 1000000n; }");
    }
    if usesBuiltin(calls, "timeSleepMs") {
        io.outputLine("function lite$timeSleepMs(ms: bigint): void {");
        io.outputLine("    if (ms <= 0n) return;");
        io.outputLine("    const limit = ms > 2147483647n ? 2147483647 : Number(ms);");
        io.outputLine("    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, limit);");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "timeLocalDate") {
        io.outputLine("function lite$timeLocalDate(): string {");
        io.outputLine("    const now = new Date();");
        io.outputLine("    return String(now.getFullYear()).padStart(4, \"0\") + \"-\" + String(now.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(now.getDate()).padStart(2, \"0\");");
        io.outputLine("}");
    }
    if usesCrypto(calls) or usesTime(calls) { io.outputLine(""); }
}

/** Emits host Unicode scalar bridge helpers used by the program. */
emitUnicodeHelpers := fn(calls: String): Unit {
    if not usesUnicode(calls) { return; }
    if usesBuiltin(calls, "unicodeToCodePoints") {
        io.outputLine("function lite$unicodeToCodePoints(text: string): bigint[] {");
        io.outputLine("    const out: bigint[] = [];");
        io.outputLine("    for (const ch of text) { out.push(BigInt(ch.codePointAt(0) ?? 0)); }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "unicodeFromCodePoints") {
        io.outputLine("function lite$unicodeFromCodePoints(points: readonly bigint[]): { ok: boolean; text: string; error: string } {");
        io.outputLine("    let text = \"\";");
        io.outputLine("    let chunk = \"\";");
        io.outputLine("    for (let i = 0; i < points.length; i += 1) {");
        io.outputLine("        const point = points[i];");
        io.outputLine("        if (point === undefined || point < 0n || point > 1114111n || (point >= 55296n && point <= 57343n)) {");
        io.outputLine("            return { ok: false, text: \"\", error: \"invalid Unicode scalar code point: \" + String(point) };");
        io.outputLine("        }");
        io.outputLine("        chunk += String.fromCodePoint(Number(point));");
        io.outputLine("        if (chunk.length >= 4096) { text += chunk; chunk = \"\"; }");
        io.outputLine("    }");
        io.outputLine("    return { ok: true, text: text + chunk, error: \"\" };");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Emits the self-contained declarations and helpers for the I/O and text builtins a program uses. */
emitBuiltinHelpers := fn(calls: String): Unit {
    abruptFault := usesAbruptFault(calls);
    abruptExit := usesBuiltin(calls, "finally") and usesBuiltin(calls, "exit");
    abruptUnwind := usesAbruptUnwind(calls);
    emitProcessDecl(calls);
    if abruptUnwind {
        io.outputLine("const lite$abruptToken = {};");
        io.outputLine("let lite$abruptActive: boolean = false;");
        if abruptFault { io.outputLine("let lite$abruptHasFault: boolean = false;"); }
        io.outputLine("let lite$abruptStderr: string = \"\";");
        io.outputLine("let lite$abruptStatus: number = 0;");
        if abruptFault {
            io.outputLine("function lite$throwAbruptFault(text: string): never {");
            io.outputLine("    if (!lite$abruptActive) {");
            io.outputLine("        lite$abruptActive = true;");
            io.outputLine("        lite$abruptHasFault = true;");
            io.outputLine("        lite$abruptStderr = text;");
            io.outputLine("        lite$abruptStatus = 1;");
            io.outputLine("    } else if (!lite$abruptHasFault) {");
            io.outputLine("        lite$abruptHasFault = true;");
            io.outputLine("        lite$abruptStderr = text;");
            io.outputLine("        lite$abruptStatus = 1;");
            io.outputLine("    } else {");
            io.outputLine("        lite$abruptStderr += text;");
            io.outputLine("    }");
            io.outputLine("    throw lite$abruptToken;");
            io.outputLine("}");
        }
        if abruptExit {
            io.outputLine("function lite$throwAbruptExit(status: number): never {");
            io.outputLine("    if (!lite$abruptActive) {");
            io.outputLine("        lite$abruptActive = true;");
            io.outputLine("        lite$abruptStatus = status;");
            io.outputLine("    }");
            io.outputLine("    throw lite$abruptToken;");
            io.outputLine("}");
        }
        io.outputLine("");
    }
    if usesBuiltin(calls, "readSource") {
        io.outputLine("let lite$sourceProvider: ((importer: string, spec: string) => { path: string; display: string; identity: string; text: string }) | undefined;");
        io.outputLine("function lite$readSource(importer: string, spec: string): { path: string; display: string; identity: string; text: string } {");
        io.outputLine("    if (lite$sourceProvider === undefined) throw new Error(\"compiler host does not provide source reads\");");
        io.outputLine("    return lite$sourceProvider(importer, spec);");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "inputArgs") {
        io.outputLine("function lite$inputArgs(): string[] {");
        io.outputLine("    return process.argv.slice(2);");
        io.outputLine("}");
        io.outputLine("");
    }
    emitInputHelpers(calls);
    if usesBuiltin(calls, "reportError") {
        io.outputLine("function lite$reportError(text: string): void {");
        io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, text + \"\\n\");");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "exit") {
        io.outputLine("function lite$exit(status: bigint): never {");
        if abruptUnwind {
            io.outputLine("    return lite$throwAbruptExit(Number(status));");
        } else {
            io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out);");
            io.outputLine("    process.exit(Number(status));");
        }
        io.outputLine("}");
        io.outputLine("");
    }
    emitFsHelpers(calls);
    emitProcessHelpers(calls);
    emitCryptoAndTimeHelpers(calls);
    emitUnicodeHelpers(calls);
    if usesBuiltin(calls, "textLength") or usesBuiltin(calls, "textAt") or usesBuiltin(calls, "textSlice") or usesBuiltin(calls, "textIndexOf") {
        io.outputLine("let lite$lastBmp = \"\";");
        io.outputLine("const lite$bmpSet = new Set<string>();");
        io.outputLine("const lite$textCache = new Map<string, readonly string[]>();");
        io.outputLine("function lite$isBmp(text: string): boolean {");
        io.outputLine("    if (text === lite$lastBmp) return true;");
        io.outputLine("    const len = text.length;");
        io.outputLine("    if (len === 0) return true;");
        io.outputLine("    if (len === 1) {");
        io.outputLine("        const c = text.charCodeAt(0);");
        io.outputLine("        return c < 0xd800 || c > 0xdfff;");
        io.outputLine("    }");
        io.outputLine("    if (len > 64) {");
        io.outputLine("        if (lite$bmpSet.has(text)) {");
        io.outputLine("            lite$lastBmp = text;");
        io.outputLine("            return true;");
        io.outputLine("        }");
        io.outputLine("        if (lite$textCache.has(text)) return false;");
        io.outputLine("    }");
        io.outputLine("    for (let i = 0; i < len; i += 1) {");
        io.outputLine("        const c = text.charCodeAt(i);");
        io.outputLine("        if (c >= 0xd800 && c <= 0xdfff) return false;");
        io.outputLine("    }");
        io.outputLine("    if (len > 64) {");
        io.outputLine("        if (lite$bmpSet.size >= 64) lite$bmpSet.clear();");
        io.outputLine("        lite$bmpSet.add(text);");
        io.outputLine("        lite$lastBmp = text;");
        io.outputLine("    }");
        io.outputLine("    return true;");
        io.outputLine("}");
        io.outputLine("function lite$textPoints(text: string): readonly string[] {");
        io.outputLine("    const found = lite$textCache.get(text);");
        io.outputLine("    if (found !== undefined) return found;");
        io.outputLine("    const points = Array.from(text);");
        io.outputLine("    if (lite$textCache.size >= 64) lite$textCache.clear();");
        io.outputLine("    lite$textCache.set(text, points);");
        io.outputLine("    return points;");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textLength") {
        io.outputLine("function lite$textLength(text: string): bigint {");
        io.outputLine("    if (lite$isBmp(text)) return BigInt(text.length);");
        io.outputLine("    return BigInt(lite$textPoints(text).length);");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textAt") {
        io.outputLine("function lite$textAt(text: string, position: bigint, at: number): string {");
        io.outputLine("    if (lite$isBmp(text)) {");
        io.outputLine("        const idx = Number(position);");
        io.outputLine("        if (position < 0n || position >= BigInt(text.length)) {");
        io.outputLine("            lite$fault(\"BoundPanic\", at, \"textAt index outside text\");");
        io.outputLine("        }");
        io.outputLine("        const bmpValue = text[idx];");
        io.outputLine("        if (bmpValue === undefined) {");
        io.outputLine("            throw new Error(\"BoundPanic: textAt index outside text\");");
        io.outputLine("        }");
        io.outputLine("        return bmpValue;");
        io.outputLine("    }");
        io.outputLine("    const points = lite$textPoints(text);");
        io.outputLine("    if (position < 0n || position >= BigInt(points.length)) {");
        io.outputLine("        lite$fault(\"BoundPanic\", at, \"textAt index outside text\");");
        io.outputLine("    }");
        io.outputLine("    const value = points[Number(position)];");
        io.outputLine("    if (value === undefined) {");
        io.outputLine("        throw new Error(\"BoundPanic: textAt index outside text\");");
        io.outputLine("    }");
        io.outputLine("    return value;");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textSlice") {
        io.outputLine("function lite$textSlice(text: string, start: bigint, end: bigint, at: number): string {");
        io.outputLine("    if (lite$isBmp(text)) {");
        io.outputLine("        if (start < 0n || end < start || end > BigInt(text.length)) {");
        io.outputLine("            lite$fault(\"BoundPanic\", at, \"textSlice requires 0 <= start <= end <= textLength(text)\");");
        io.outputLine("        }");
        io.outputLine("        return text.slice(Number(start), Number(end));");
        io.outputLine("    }");
        io.outputLine("    const points = lite$textPoints(text);");
        io.outputLine("    if (start < 0n || end < start || end > BigInt(points.length)) {");
        io.outputLine("        lite$fault(\"BoundPanic\", at, \"textSlice requires 0 <= start <= end <= textLength(text)\");");
        io.outputLine("    }");
        io.outputLine("    return points.slice(Number(start), Number(end)).join(\"\");");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textIndexOf") {
        io.outputLine("function lite$textIndexOf(source: string, needle: string, start: bigint): bigint {");
        io.outputLine("    if (start < 0n) return -1n;");
        io.outputLine("    if (lite$isBmp(source)) {");
        io.outputLine("        const len = source.length;");
        io.outputLine("        if (start > BigInt(len)) return -1n;");
        io.outputLine("        if (needle.length === 0) return start;");
        io.outputLine("        const idx = source.indexOf(needle, Number(start));");
        io.outputLine("        return idx < 0 ? -1n : BigInt(idx);");
        io.outputLine("    }");
        io.outputLine("    const points = lite$textPoints(source);");
        io.outputLine("    if (start > BigInt(points.length)) return -1n;");
        io.outputLine("    if (needle.length === 0) return start;");
        io.outputLine("    if (source.indexOf(needle) < 0) return -1n;");
        io.outputLine("    const s = Number(start);");
        io.outputLine("    const nPoints = lite$isBmp(needle) ? null : lite$textPoints(needle);");
        io.outputLine("    const nLen = nPoints === null ? needle.length : nPoints.length;");
        io.outputLine("    const limit = points.length - nLen;");
        io.outputLine("    if (nLen === 1) {");
        io.outputLine("        for (let i = s; i <= limit; i += 1) {");
        io.outputLine("            if (points[i] === needle) return BigInt(i);");
        io.outputLine("        }");
        io.outputLine("        return -1n;");
        io.outputLine("    }");
        io.outputLine("    const first = nPoints === null ? needle[0] : nPoints[0];");
        io.outputLine("    for (let i = s; i <= limit; i += 1) {");
        io.outputLine("        if (points[i] !== first) continue;");
        io.outputLine("        let ok = true;");
        io.outputLine("        for (let j = 1; j < nLen; j += 1) {");
        io.outputLine("            if (points[i + j] !== (nPoints === null ? needle[j] : nPoints[j])) { ok = false; break; }");
        io.outputLine("        }");
        io.outputLine("        if (ok) return BigInt(i);");
        io.outputLine("    }");
        io.outputLine("    return -1n;");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "throwTransfer") {
        io.outputLine("const lite$transferToken = {};");
        io.outputLine("let lite$transferVal: any = undefined;");
        io.outputLine("function lite$throwTransfer(id: number, value: unknown): never {");
        io.outputLine("    throw { token: lite$transferToken, id, value };");
        io.outputLine("}");
        io.outputLine("function lite$hasTransfer(err: unknown, id: number): boolean {");
        io.outputLine("    if (typeof err === \"object\" && err !== null && \"token\" in err && err.token === lite$transferToken && \"id\" in err && err.id === id && \"value\" in err) {");
        io.outputLine("        lite$transferVal = err.value;");
        io.outputLine("        return true;");
        io.outputLine("    }");
        io.outputLine("    return false;");
        io.outputLine("}");
        io.outputLine("");
    }
    return;
}

/** Emits the checked list-index helper used by generated programs that read list elements. */
emitListIndexHelper := fn(): Unit {
    io.outputLine("function lite$listAt<T>(items: readonly T[], index: bigint, at: number): T {");
    io.outputLine("    if (index < 0n || index >= BigInt(items.length)) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    io.outputLine("    }");
    io.outputLine("    const value = items[Number(index)];");
    io.outputLine("    if (value === undefined) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    io.outputLine("    }");
    io.outputLine("    return value;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits the checked list-pop-back helper used by generated programs that pop the back of a list. */
emitListPopHelper := fn(): Unit {
    io.outputLine("function lite$listPopBack<T>(items: T[], at: number): T {");
    io.outputLine("    if (items.length === 0) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"pop_back on an empty list\");");
    io.outputLine("    }");
    io.outputLine("    return items.pop() as T;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits the checked list-pop-front helper used by generated programs that pop the front of a list. */
emitListPopFrontHelper := fn(): Unit {
    io.outputLine("function lite$listPopFront<T>(items: T[], at: number): T {");
    io.outputLine("    if (items.length === 0) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"pop_front on an empty list\");");
    io.outputLine("    }");
    io.outputLine("    return items.shift() as T;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned truncating division with checked Int64 results. */
emitIntDivideHelper := fn(): Unit {
    io.outputLine("function lite$divideInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"division by zero\");");
    io.outputLine("    return lite$checkedInt(left / right, at);");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned remainder; MIN%-1 is representable zero. */
emitIntRemainderHelper := fn(): Unit {
    io.outputLine("function lite$remainderInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"remainder by zero\");");
    io.outputLine("    return left % right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor division without repeating operands. */
emitIntFloorDivideHelper := fn(): Unit {
    io.outputLine("function lite$floorDivideInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    const quotient = lite$divideInt(left, right, at);");
    io.outputLine("    const remainder = left % right;");
    io.outputLine("    return remainder !== 0n && (left < 0n) !== (right < 0n) ? quotient - 1n : quotient;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor modulo, including signed-minimum divisors. */
emitIntFloorModuloHelper := fn(): Unit {
    io.outputLine("function lite$floorModuloInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"modulo by zero\");");
    io.outputLine("    const remainder = left % right;");
    io.outputLine("    return remainder !== 0n && (remainder < 0n) !== (right < 0n) ? remainder + right : remainder;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if (usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "floorDivideInt")) { emitIntDivideHelper(); }
    if usesBuiltin(calls, "remainderInt") { emitIntRemainderHelper(); }
    if usesBuiltin(calls, "floorDivideInt") { emitIntFloorDivideHelper(); }
    if usesBuiltin(calls, "floorModuloInt") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the TS module from the flat item stream. Report arguments evaluate once, left to right, before reading and appending to `lite$out`, preserving reports made by argument calls. */
pub emitProgram := fn(items: frontend.Items, source: String, prefix: String): Unit {
    calls := frontend.targetHelperCalls(items);
    abruptFault := usesAbruptFault(calls);
    abruptUnwind := usesAbruptUnwind(calls);
    hasInput := usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat");
    hasExit := usesBuiltin(calls, "exit") or hasInput or abruptUnwind;
    if hasExit {
        io.outputLine("let lite$out = \"\";");
        io.outputLine("");
    }
    emitBuiltinHelpers(calls);
    if usesListIndex(calls) { emitListIndexHelper(); }
    if usesListPop(calls) { emitListPopHelper(); }
    if usesListPopFront(calls) { emitListPopFrontHelper(); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesBuiltin(calls, "readSource") {
        io.outputLine("export function main(lite$write?: (text: string) => void, lite$sourceProviderInput?: (importer: string, spec: string) => { path: string; display: string; identity: string; text: string }): string {");
        io.outputLine("    lite$sourceProvider = lite$sourceProviderInput;");
    } else {
        io.outputLine("export function main(lite$write?: (text: string) => void): string {");
    }
    if hasExit { io.outputLine("    lite$out = \"\";"); }
    if hasInput { io.outputLine("    lite$resetInput();"); }
    if usesStreamRuntime(calls) { io.outputLine("    lite$resetStreams();"); }
    if not hasExit { io.outputLine("    let lite$out = \"\";"); }
    io.outputLine("    function lite$emit(text: string): void {");
    io.outputLine("        if (lite$write === undefined) lite$out += text;");
    io.outputLine("        else lite$write(text);");
    io.outputLine("    }");
    io.outputLine("    void lite$emit;");
    var indent := "    ";
    if abruptUnwind {
        io.outputLine("    lite$abruptActive = false;");
        if abruptFault { io.outputLine("    lite$abruptHasFault = false;"); }
        io.outputLine("    lite$abruptStderr = \"\";");
        io.outputLine("    lite$abruptStatus = 0;");
        io.outputLine("    try {");
        indent = "        ";
    }
    var line := "";
    var count := 0;
    var mainStopped := false;
    var activeTries := "|";
    loop items as tryItem {
        if (tryItem.kind == "TransferCatch" or tryItem.kind == "LoopTransferCatch") and tryItem.runtime =!= "" {
            activeTries = activeTries + tryItem.runtime + "|";
        }
    }
    loop items as item {
        if item.kind == "FunctionStart" {
            io.outputLine(indent + "function " + item.runtime + "(" + tsParameterList(item.textValue) + "): " +
            tsFunctionType(item.code) + " {");
            indent = indent + "    ";
            reportParameterReads(item.textValue, indent);
        } else if item.kind == "FunctionEnd" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "TransferTry" or item.kind == "LoopTransferTry" {
            if item.runtime =!= "" and activeTries =!= "|" and textLib.indexOfText(activeTries, "|" + item.runtime + "|", 0) >= 0 {
                io.outputLine(indent + "try {");
                indent = indent + "    ";
            }
        } else if item.kind == "TransferCatch" {
            indent = dedent(indent);
            io.outputLine(indent + "} catch (lite$err) {");
            if item.code == "Unit" {
                io.outputLine(indent + "    if (lite$hasTransfer(lite$err, 0)) { return; } else { throw lite$err; }");
            } else {
                io.outputLine(indent + "    if (lite$hasTransfer(lite$err, 0)) { return lite$transferVal; } else { throw lite$err; }");
            }
            io.outputLine(indent + "}");
        } else if item.kind == "LoopTransferCatch" {
            indent = dedent(indent);
            io.outputLine(indent + "} catch (lite$err) {");
            io.outputLine(indent + "    if (lite$hasTransfer(lite$err, " + item.code + ")) { break; }");
            io.outputLine(indent + "    else if (lite$hasTransfer(lite$err, " + item.textValue + ")) { continue; }");
            io.outputLine(indent + "    else { throw lite$err; }");
            io.outputLine(indent + "}");
        } else if item.kind == "Return" {
            if item.code == "" {
                io.outputLine(indent + "return;");
            } else {
                io.outputLine(indent + "return " + item.code + ";");
            }
        } else if item.kind == "Unreachable" {
            io.outputLine(indent + "throw new Error(\"unreachable loop completion\");");
        } else if item.kind == "Break" {
            io.outputLine(indent + "break;");
        } else if item.kind == "Continue" {
            io.outputLine(indent + "continue;");
        } else if item.kind == "Call" {
            io.outputLine(indent + item.code + ";");
        } else if item.kind == "Discard" {
            io.outputLine(indent + "void (" + item.code + ");");
        } else if item.kind == "LocalInt" or item.kind == "LocalString" or item.kind == "LocalBool" or item.kind == "LocalFloat" or item.kind == "LocalTuple" {
            io.outputLine(indent + "const " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "LocalList" {
            io.outputLine(indent + "const " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarInt" or item.kind == "VarString" or item.kind == "VarBool" or item.kind == "VarFloat" or item.kind == "VarTuple" {
            io.outputLine(indent + "let " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarList" {
            io.outputLine(indent + "let " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignFloat" or item.kind == "AssignTuple" {
            io.outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "AssignList" {
            io.outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "Scope" {
            io.outputLine(indent + "{");
            indent = indent + "    ";
        } else if item.kind == "If" {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            io.outputLine(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            io.outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "ElseIf" {
            indent = dedent(indent);
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            io.outputLine(indent + "} else if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" or item.kind == "EndScope" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "LoopSeq" {
            io.outputLine(indent + "for (const " + item.runtime + " of " + tsLiteral.listCopyCode(item.code) + ") {");
            indent = indent + "    ";
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "Boolean(true)" }
            else if item.code == "false" { "Boolean(false)" }
            else { item.code };
            io.outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "End" or item.kind == "EndOutput" {
            if count == 0 {
                io.outputLine(indent + "lite$emit(" + tsLiteral.textLiteralCode(if item.kind == "End" { "\n" } else { "" }) + ");");
            } else {
                ending := if item.kind == "End" { " + \"\\n\"" } else { "" };
                emitted := if count == 1 and item.kind == "End" and not textLib.startsWithAt(line, 0, "(") and textLib.indexOfText(line, "?", 0) >= 0 {
                    "(" + line + ")"
                } else {
                    line
                };
                io.outputLine(indent + "lite$emit(" + emitted + ending + ");");
            }
            line = "";
            count = 0;
        } else if item.kind == "MainStop" {
            mainStopped = true;
        } else if item.kind == "Import" or item.kind == "PublicFunction" or item.kind == "PublicValue" or item.kind == "PublicType" or item.kind == "Noop" {
        } else {
            if count > 0 { line = line + " + \" \" + "; }
            line = line + reportArgumentCode(item);
            count = count + 1;
        }
    }
    if not mainStopped { io.outputLine(indent + "return lite$out;"); }
    if abruptUnwind {
        io.outputLine("    } catch (lite$err) {");
        io.outputLine("        if (lite$err === lite$abruptToken) {");
        io.outputLine("            if (lite$out !== \"\") {");
        io.outputLine("                process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out);");
        io.outputLine("                lite$out = \"\";");
        io.outputLine("            }");
        io.outputLine("            if (lite$abruptStderr !== \"\") {");
        io.outputLine("                process.getBuiltinModule(\"node:fs\").writeSync(2, lite$abruptStderr);");
        io.outputLine("            }");
        io.outputLine("            process.exit(lite$abruptStatus);");
        io.outputLine("        }");
        io.outputLine("        throw lite$err;");
        io.outputLine("    }");
    }
    io.outputLine("}");
    if not usesBuiltin(calls, "readSource") and (usesHostOs(calls) or usesBuiltin(calls, "inputArgs")) {
        io.outputLine("");
        io.outputLine("if ((import.meta as { readonly main?: boolean }).main === true) {");
        io.outputLine("    main((text: string): void => {");
        io.outputLine("        process.getBuiltinModule(\"node:fs\").writeSync(1, text);");
        io.outputLine("    });");
        io.outputLine("}");
    }
}
