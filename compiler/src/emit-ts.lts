tsLiteral := import "./ts-literals.lts";
frontend := import "./frontend.lts";
io := import "core/io";
textLib := import "core/text";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textLib.slice(indent, 0, textLib.length(indent) - 4)
}

/** Formats one canonical flat tuple kind as a TypeScript object type. */
tsTupleType := fn(kind: String): String {
    count := frontend.tupleComponentCount(kind);
    var result := "{ ";
    var index := 0;
    loop index < count {
        comp := frontend.tupleComponent(kind, index);
        if index > 0 { result = result + "; "; }
        result = result + frontend.tupleObjectKey(comp.label, index) + ": " + tsLiteral.tsScalarType(comp.kind);
        index = index + 1;
    }
    result + " }"
}

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array or List kind to its TypeScript type. */
tsFunctionType := fn(kind: String): String {
    if frontend.isListKind(kind) { tsFunctionType(frontend.listElementKind(kind)) + "[]" }
    else if frontend.isArrayKind(kind) { tsFunctionType(frontend.arrayElementKind(kind)) + "[]" }
    else if frontend.isTupleKind(kind) { tsTupleType(kind) }
    else { tsLiteral.tsScalarType(kind) }
}

/** Formats a `|`-separated `name=kind` parameter list as a TypeScript parameter list. */
tsParameterList := fn(encoded: String): String {
    if encoded == "" { return ""; }
    var result := "";
    var start := 0;
    loop true {
        separator := textLib.indexOfText(encoded, "|", start);
        var end := textLib.length(encoded);
        if separator >= 0 { end = separator; }
        entry := textLib.slice(encoded, start, end);
        equals := textLib.indexOfText(entry, "=", 0);
        parameterName := textLib.slice(entry, 0, equals);
        parameterKind := textLib.slice(entry, equals + 1, textLib.length(entry));
        if textLib.length(result) > 0 { result = result + ", "; }
        result = result + "lite_" + parameterName + ": " + tsFunctionType(parameterKind);
        if separator < 0 { break; }
        start = separator + 1;
    }
    result
}

/** Emits `void` reads for parameters so strict unused-parameter checking accepts bodies that ignore inputs. */
reportParameterReads := fn(encoded: String, indent: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        separator := textLib.indexOfText(encoded, "|", start);
        var end := textLib.length(encoded);
        if separator >= 0 { end = separator; }
        entry := textLib.slice(encoded, start, end);
        equals := textLib.indexOfText(entry, "=", 0);
        io.outputLine(indent + "void lite_" + textLib.slice(entry, 0, equals) + ";");
        if separator < 0 { break; }
        start = separator + 1;
    }
}

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
displayValueCode := fn(kind: String, code: String): String {
    if frontend.isIntScalarKind(kind) or frontend.isFloatScalarKind(kind) { return "(" + code + ").toString()"; }
    if kind == "Bool" { return "((" + code + ") ? \"true\" : \"false\")"; }
    if kind == "Unit" { return "((value: unknown): string => { void value; return \"Unit\"; })(" + code + ")"; }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        element := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        return "(\"[\" + (" + code + ").map((value: " + tsFunctionType(element) + ") => " + self(element, "value") + ").join(\", \") + \"]\")";
    }
    if frontend.isTupleKind(kind) {
        var result := tsLiteral.textLiteralCode("(");
        count := frontend.tupleComponentCount(kind);
        var index := 0;
        loop index < count {
            comp := frontend.tupleComponent(kind, index);
            separator := if index == 0 { "" } else { ", " };
            prefixText := if comp.label == "" { separator } else { separator + comp.label + "=" };
            result = result + " + " + tsLiteral.textLiteralCode(prefixText) + " + " + self(comp.kind, "value." + comp.prop);
            index = index + 1;
        }
        ending := if count == 1 { ",)" } else { ")" };
        return "((value: " + tsFunctionType(kind) + "): string => " + result + " + " + tsLiteral.textLiteralCode(ending) + ")(" + code + ")";
    }
    code
}

/** Formats one output argument without duplicating its evaluation. */
reportArgumentCode := fn(item: frontend.Item): String {
    displayValueCode(item.kind, item.code)
}

/** True when any emitted item calls the named `lite$` helper outside quoted String literal text. */
usesBuiltin := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    textLib.indexOfText(calls, "|lite$" + name + "(|", 0) >= 0
}

/** True when any emitted item reads a list element through the checked helper. */
usesListIndex := fn(calls: String): Bool {
    usesBuiltin(calls, "listAt")
}

/** True when any emitted item pops a list back element through the checked helper. */
usesListPop := fn(calls: String): Bool {
    usesBuiltin(calls, "listPopBack")
}

/** True when any emitted item pops a list front element through the checked helper. */
usesListPopFront := fn(calls: String): Bool {
    usesBuiltin(calls, "listPopFront")
}


/** True when a program needs checked dynamic Int* arithmetic or narrow range guards. */
usesIntArithmetic := fn(calls: String): Bool {
    usesBuiltin(calls, "addInt") or usesBuiltin(calls, "subtractInt") or usesBuiltin(calls, "multiplyInt") or
    usesBuiltin(calls, "negateInt") or usesBuiltin(calls, "checkedNarrowInt")
}

/** True when positioned division-family helpers are needed. */
usesIntDivision := fn(calls: String): Bool {
    usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "remainderInt") or usesBuiltin(calls, "floorDivideInt") or usesBuiltin(calls, "floorModuloInt")
}

/** True when binary64/binary32 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool { usesBuiltin(calls, "floatOp") or usesBuiltin(calls, "float32Op") or usesBuiltin(calls, "floatPower") }

/** Emits the shared Float and Float32 arithmetic helpers without folding operations before execution. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesBuiltin(calls, "floatPower") {
        io.outputLine("function lite$floatPower(left: number, right: number, at: number): number {");
        io.outputLine("    if (right <= 0) lite$fault(\"ArithmeticPanic\", at, \"power exponent must be positive in this checkpoint\");");
        io.outputLine("    const value = Math.pow(left, right);");
        io.outputLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "float32Op") {
        io.outputLine("function lite$float32Op(left: number, right: number, op: number, at: number): number {");
        io.outputLine("    if (op === 3 && right === 0) lite$fault(\"ArithmeticPanic\", at, \"division by zero\");");
        io.outputLine("    const value = Math.fround(op === 0 ? left + right : op === 1 ? left - right : op === 2 ? left * right : left / right);");
        io.outputLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if not usesBuiltin(calls, "floatOp") { return; }
    io.outputLine("function lite$floatOp(left: number, right: number, op: number, at: number): number {");
    io.outputLine("    if (op === 3 && right === 0) lite$fault(\"ArithmeticPanic\", at, \"division by zero\");");
    io.outputLine("    const value = op === 0 ? left + right : op === 1 ? left - right : op === 2 ? left * right : left / right;");
    io.outputLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
    io.outputLine("    return value;");
    io.outputLine("}");
}

/** True when positioned bounds faults may be raised by text or list helpers. */
usesBounds := fn(calls: String): Bool {
    usesBuiltin(calls, "textAt") or usesBuiltin(calls, "textSlice") or usesListIndex(calls) or usesListPop(calls) or usesListPopFront(calls)
}

/** Emits shared position metadata once, exact runtime faults, and the arithmetic helpers actually used. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    integers := usesIntArithmetic(calls) or usesIntDivision(calls);
    if not integers and not usesBounds(calls) and not usesFloatArithmetic(calls) { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    needsRange := usesBuiltin(calls, "addInt") or usesBuiltin(calls, "subtractInt") or
        usesBuiltin(calls, "multiplyInt") or usesBuiltin(calls, "negateInt") or
        usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "floorDivideInt");
    io.outputLine("const lite$intLines: readonly number[] = [" + frontend.lineStartCodes(source) + "];");
    io.outputLine("const lite$intSource = " + tsLiteral.textLiteralCode(namePrefix) + ";");
    if needsRange { io.outputLine("const lite$intMin = -(1n << 63n), lite$intMax = (1n << 63n) - 1n;"); }
    io.outputLine("function lite$fault(category: string, at: number, message: string): never {");
    io.outputLine("    let line = 0;");
    io.outputLine("    while (line + 1 < lite$intLines.length && (lite$intLines[line + 1] ?? Infinity) <= at) line += 1;");
    io.outputLine("    const column = at - (lite$intLines[line] ?? 0) + 1;");
    io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, lite$intSource + (line + 1) + \":\" + column + \": \" + category + \": \" + message + \"\\n\");");
    io.outputLine("    process.exit(1);");
    io.outputLine("}");
    if integers {
        io.outputLine("function lite$intFault(at: number, message: string): never { return lite$fault(\"ArithmeticPanic\", at, message); }");
    }
    if needsRange {
        io.outputLine("function lite$checkedInt(value: bigint, at: number): bigint {");
        io.outputLine("    if (value < lite$intMin || value > lite$intMax) lite$intFault(at, \"integer outside Int range\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "addInt") {
        io.outputLine("function lite$addInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left + right, at); }");
    }
    if usesBuiltin(calls, "subtractInt") {
        io.outputLine("function lite$subtractInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left - right, at); }");
    }
    if usesBuiltin(calls, "multiplyInt") {
        io.outputLine("function lite$multiplyInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left * right, at); }");
    }
    if usesBuiltin(calls, "negateInt") {
        io.outputLine("function lite$negateInt(value: bigint, at: number): bigint { return lite$checkedInt(-value, at); }");
    }
    if usesBuiltin(calls, "checkedNarrowInt") {
        io.outputLine("function lite$checkedNarrowInt(value: bigint, bits: bigint, name: string, at: number): bigint {");
        io.outputLine("    const limit = 1n << (bits - 1n);");
        io.outputLine("    if (value < -limit || value >= limit) lite$intFault(at, \"integer outside \" + name + \" range\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Emits shared buffered byte input and strict incremental UTF-8 decoding for the temporary input helpers. */
emitInputHelpers := fn(calls: String): Unit {
    if not (usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat")) { return; }
    io.outputLine("declare const TextDecoder: { new(label: string, options: { fatal: boolean }): { decode(input?: Uint8Array, options?: { stream: boolean }): string } };");
    io.outputLine("const lite$decoder = new TextDecoder(\"utf-8\", { fatal: true });");
    io.outputLine("const lite$bytes = new Uint8Array(4096);");
    io.outputLine("let lite$byteAt = 0, lite$byteEnd = 0;");
    io.outputLine("let lite$ended = false;");
    io.outputLine("let lite$pending: string | null | undefined;");
    io.outputLine("function lite$inputFault(at: string, message: string): never {");
    io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, at + message + \"\\n\");");
    io.outputLine("    process.exit(1);");
    io.outputLine("}");
    io.outputLine("function lite$prompt(text: string | undefined): void {");
    io.outputLine("    if (text === undefined) return;");
    io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out + text);");
    io.outputLine("    lite$out = \"\";");
    io.outputLine("}");
    io.outputLine("function lite$peek(at: string): string | null {");
    io.outputLine("    if (lite$pending !== undefined) return lite$pending;");
    io.outputLine("    if (lite$ended) return null;");
    io.outputLine("    try {");
    io.outputLine("        while (true) {");
    io.outputLine("            if (lite$byteAt === lite$byteEnd) {");
    io.outputLine("                lite$byteEnd = process.getBuiltinModule(\"node:fs\").readSync(0, lite$bytes, 0, lite$bytes.length, null);");
    io.outputLine("                lite$byteAt = 0;");
    io.outputLine("                if (lite$byteEnd === 0) {");
    io.outputLine("                    lite$ended = true;");
    io.outputLine("                    lite$pending = lite$decoder.decode() || null;");
    io.outputLine("                    return lite$pending;");
    io.outputLine("                }");
    io.outputLine("            }");
    io.outputLine("            const text = lite$decoder.decode(lite$bytes.subarray(lite$byteAt, ++lite$byteAt), { stream: true });");
    io.outputLine("            if (text !== \"\") { lite$pending = text; return text; }");
    io.outputLine("        }");
    io.outputLine("    } catch (error) {");
    io.outputLine("        return lite$inputFault(at, \"cannot read input: \" + (error instanceof Error ? error.message : String(error)));");
    io.outputLine("    }");
    io.outputLine("}");
    io.outputLine("function lite$take(at: string): string | null {");
    io.outputLine("    const text = lite$peek(at); lite$pending = undefined; return text;");
    io.outputLine("}");
    if usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat") {
        io.outputLine("function lite$word(at: string): string | null {");
        io.outputLine("    let ch = lite$peek(at);");
        io.outputLine("    while (ch !== null && /\\s/u.test(ch)) { lite$take(at); ch = lite$peek(at); }");
        io.outputLine("    if (ch === null) return null;");
        io.outputLine("    let text = \"\";");
        io.outputLine("    while (ch !== null && !/\\s/u.test(ch)) { text += lite$take(at); ch = lite$peek(at); }");
        io.outputLine("    return text;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "inputAll") {
        io.outputLine("function lite$inputAll(prompt: string | undefined, at: string): string {");
        io.outputLine("    lite$prompt(prompt);");
        io.outputLine("    let text = \"\";");
        io.outputLine("    for (let ch = lite$take(at); ch !== null; ch = lite$take(at)) text += ch;");
        io.outputLine("    return text;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "inputLine") {
        io.outputLine("function lite$inputLine(prompt: string | undefined, at: string): string {");
        io.outputLine("    lite$prompt(prompt);");
        io.outputLine("    let text = \"\", ch = lite$take(at);");
        io.outputLine("    if (ch === null) return lite$inputFault(at, \"EOF before inputLine value\");");
        io.outputLine("    while (ch !== null && ch !== \"\\n\") { text += ch; ch = lite$take(at); }");
        io.outputLine("    return ch === \"\\n\" && text.endsWith(\"\\r\") ? text.slice(0, -1) : text;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "inputInt") {
        io.outputLine("function lite$inputInt(prompt: string | undefined, at: string): bigint {");
        io.outputLine("    lite$prompt(prompt);");
        io.outputLine("    const text = lite$word(at);");
        io.outputLine("    if (text === null) return lite$inputFault(at, \"EOF before inputInt value\");");
        io.outputLine("    if (!/^[+-]?[0-9]+$/.test(text)) return lite$inputFault(at, \"expected an integer token\");");
        io.outputLine("    const value = BigInt(text);");
        io.outputLine("    if (value < -(1n << 63n) || value > (1n << 63n) - 1n) return lite$inputFault(at, \"input outside signed 64-bit range\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if usesBuiltin(calls, "inputFloat") {
        io.outputLine("function lite$inputFloat(prompt: string | undefined, at: string): number {");
        io.outputLine("    lite$prompt(prompt);");
        io.outputLine("    const text = lite$word(at);");
        io.outputLine("    if (text === null) return lite$inputFault(at, \"EOF before inputFloat value\");");
        io.outputLine("    const value = Number(text);");
        io.outputLine("    if (!/^[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$/.test(text) || !Number.isFinite(value)) return lite$inputFault(at, \"expected a finite floating token\");");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Emits the self-contained declarations and helpers for the I/O and text builtins a program uses. */
emitBuiltinHelpers := fn(calls: String): Unit {
    if usesBuiltin(calls, "inputArgs") or usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat") or
        usesBuiltin(calls, "reportError") or usesBuiltin(calls, "exit") or usesIntArithmetic(calls) or usesIntDivision(calls) or usesBounds(calls) or usesFloatArithmetic(calls) {
        io.outputLine("declare const process: {");
        io.outputLine("    argv: string[];");
        io.outputLine("    exit(code: number): never;");
        io.outputLine("    getBuiltinModule(name: \"node:fs\"): {");
        io.outputLine("        readSync(fd: number, buffer: Uint8Array, offset: number, length: number, position: null): number;");
        io.outputLine("        writeSync(fd: number, text: string): number;");
        io.outputLine("    };");
        io.outputLine("};");
        io.outputLine("");
    }
    if usesBuiltin(calls, "readSource") {
        io.outputLine("let lite$sourceProvider: ((importer: string, spec: string) => { path: string; display: string; identity: string; text: string }) | undefined;");
        io.outputLine("function lite$readSource(importer: string, spec: string): { path: string; display: string; identity: string; text: string } {");
        io.outputLine("    if (lite$sourceProvider === undefined) throw new Error(\"compiler host does not provide source reads\");");
        io.outputLine("    return lite$sourceProvider(importer, spec);");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "inputArgs") {
        io.outputLine("function lite$inputArgs(): string[] {");
        io.outputLine("    return process.argv.slice(2);");
        io.outputLine("}");
        io.outputLine("");
    }
    emitInputHelpers(calls);
    if usesBuiltin(calls, "reportError") {
        io.outputLine("function lite$reportError(text: string): void {");
        io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, text + \"\\n\");");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "exit") {
        io.outputLine("function lite$exit(status: bigint): never {");
        io.outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out);");
        io.outputLine("    process.exit(Number(status));");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textLength") or usesBuiltin(calls, "textAt") or usesBuiltin(calls, "textSlice") {
        io.outputLine("const lite$textCache = new Map<string, readonly string[]>();");
        io.outputLine("function lite$textPoints(text: string): readonly string[] {");
        io.outputLine("    const found = lite$textCache.get(text);");
        io.outputLine("    if (found !== undefined) {");
        io.outputLine("        lite$textCache.delete(text);");
        io.outputLine("        lite$textCache.set(text, found);");
        io.outputLine("        return found;");
        io.outputLine("    }");
        io.outputLine("    const points = Array.from(text);");
        io.outputLine("    lite$textCache.set(text, points);");
        io.outputLine("    if (lite$textCache.size > 8) {");
        io.outputLine("        const oldest = lite$textCache.keys().next();");
        io.outputLine("        if (oldest.done !== true) lite$textCache.delete(oldest.value);");
        io.outputLine("    }");
        io.outputLine("    return points;");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textLength") {
        io.outputLine("function lite$textLength(text: string): bigint {");
        io.outputLine("    return BigInt(lite$textPoints(text).length);");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textAt") {
        io.outputLine("function lite$textAt(text: string, position: bigint, at: number): string {");
        io.outputLine("    const points = lite$textPoints(text);");
        io.outputLine("    if (position < 0n || position >= BigInt(points.length)) {");
        io.outputLine("        lite$fault(\"BoundPanic\", at, \"textAt index outside text\");");
        io.outputLine("    }");
        io.outputLine("    const value = points[Number(position)];");
        io.outputLine("    if (value === undefined) {");
        io.outputLine("        throw new Error(\"BoundPanic: textAt index outside text\");");
        io.outputLine("    }");
        io.outputLine("    return value;");
        io.outputLine("}");
        io.outputLine("");
    }
    if usesBuiltin(calls, "textSlice") {
        io.outputLine("function lite$textSlice(text: string, start: bigint, end: bigint, at: number): string {");
        io.outputLine("    const points = lite$textPoints(text);");
        io.outputLine("    if (start < 0n || end < start || end > BigInt(points.length)) {");
        io.outputLine("        lite$fault(\"BoundPanic\", at, \"textSlice requires 0 <= start <= end <= textLength(text)\");");
        io.outputLine("    }");
        io.outputLine("    return points.slice(Number(start), Number(end)).join(\"\");");
        io.outputLine("}");
        io.outputLine("");
    }
    return;
}

/** Emits the checked list-index helper used by generated programs that read list elements. */
emitListIndexHelper := fn(): Unit {
    io.outputLine("function lite$listAt<T>(items: readonly T[], index: bigint, at: number): T {");
    io.outputLine("    if (index < 0n || index >= BigInt(items.length)) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    io.outputLine("    }");
    io.outputLine("    const value = items[Number(index)];");
    io.outputLine("    if (value === undefined) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    io.outputLine("    }");
    io.outputLine("    return value;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits the checked list-pop-back helper used by generated programs that pop the back of a list. */
emitListPopHelper := fn(): Unit {
    io.outputLine("function lite$listPopBack<T>(items: T[], at: number): T {");
    io.outputLine("    if (items.length === 0) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"pop_back on an empty list\");");
    io.outputLine("    }");
    io.outputLine("    return items.pop() as T;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits the checked list-pop-front helper used by generated programs that pop the front of a list. */
emitListPopFrontHelper := fn(): Unit {
    io.outputLine("function lite$listPopFront<T>(items: T[], at: number): T {");
    io.outputLine("    if (items.length === 0) {");
    io.outputLine("        lite$fault(\"BoundPanic\", at, \"pop_front on an empty list\");");
    io.outputLine("    }");
    io.outputLine("    return items.shift() as T;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned truncating division with checked Int64 results. */
emitIntDivideHelper := fn(): Unit {
    io.outputLine("function lite$divideInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"division by zero\");");
    io.outputLine("    return lite$checkedInt(left / right, at);");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned remainder; MIN%-1 is representable zero. */
emitIntRemainderHelper := fn(): Unit {
    io.outputLine("function lite$remainderInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"remainder by zero\");");
    io.outputLine("    return left % right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor division without repeating operands. */
emitIntFloorDivideHelper := fn(): Unit {
    io.outputLine("function lite$floorDivideInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    const quotient = lite$divideInt(left, right, at);");
    io.outputLine("    const remainder = left % right;");
    io.outputLine("    return remainder !== 0n && (left < 0n) !== (right < 0n) ? quotient - 1n : quotient;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor modulo, including signed-minimum divisors. */
emitIntFloorModuloHelper := fn(): Unit {
    io.outputLine("function lite$floorModuloInt(left: bigint, right: bigint, at: number): bigint {");
    io.outputLine("    if (right === 0n) lite$intFault(at, \"modulo by zero\");");
    io.outputLine("    const remainder = left % right;");
    io.outputLine("    return remainder !== 0n && (remainder < 0n) !== (right < 0n) ? remainder + right : remainder;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if (usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "floorDivideInt")) { emitIntDivideHelper(); }
    if usesBuiltin(calls, "remainderInt") { emitIntRemainderHelper(); }
    if usesBuiltin(calls, "floorDivideInt") { emitIntFloorDivideHelper(); }
    if usesBuiltin(calls, "floorModuloInt") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the TS module from the flat item stream. Report arguments evaluate once, left to right, before reading and appending to `lite$out`, preserving reports made by argument calls. */
pub emitProgram := fn(items: frontend.Items, source: String, prefix: String): Unit {
    calls := frontend.targetHelperCalls(items);
    hasExit := usesBuiltin(calls, "exit") or usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat");
    if hasExit {
        io.outputLine("let lite$out = \"\";");
        io.outputLine("");
    }
    emitBuiltinHelpers(calls);
    if usesListIndex(calls) { emitListIndexHelper(); }
    if usesListPop(calls) { emitListPopHelper(); }
    if usesListPopFront(calls) { emitListPopFrontHelper(); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesBuiltin(calls, "readSource") {
        io.outputLine("export function main(lite$write?: (text: string) => void, lite$sourceProviderInput?: (importer: string, spec: string) => { path: string; display: string; identity: string; text: string }): string {");
        io.outputLine("    lite$sourceProvider = lite$sourceProviderInput;");
    } else {
        io.outputLine("export function main(lite$write?: (text: string) => void): string {");
    }
    if not hasExit { io.outputLine("    let lite$out = \"\";"); }
    io.outputLine("    function lite$emit(text: string): void {");
    io.outputLine("        if (lite$write === undefined) lite$out += text;");
    io.outputLine("        else lite$write(text);");
    io.outputLine("    }");
    io.outputLine("    void lite$emit;");
    var indent := "    ";
    var line := "";
    var count := 0;
    var mainStopped := false;
    loop items as item {
        if item.kind == "FunctionStart" {
            io.outputLine(indent + "function " + item.runtime + "(" + tsParameterList(item.textValue) + "): " +
                tsFunctionType(item.code) + " {");
            indent = indent + "    ";
            reportParameterReads(item.textValue, indent);
        } else if item.kind == "FunctionEnd" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "Return" {
            if item.code == "" {
                io.outputLine(indent + "return;");
            } else {
                io.outputLine(indent + "return " + item.code + ";");
            }
        } else if item.kind == "Unreachable" {
            io.outputLine(indent + "throw new Error(\"unreachable loop completion\");");
        } else if item.kind == "Break" {
            io.outputLine(indent + "break;");
        } else if item.kind == "Continue" {
            io.outputLine(indent + "continue;");
        } else if item.kind == "Call" {
            io.outputLine(indent + item.code + ";");
        } else if item.kind == "Discard" {
            io.outputLine(indent + "void (" + item.code + ");");
        } else if item.kind == "LocalInt" or item.kind == "LocalString" or item.kind == "LocalBool" or item.kind == "LocalFloat" or item.kind == "LocalTuple" {
            io.outputLine(indent + "const " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "LocalList" {
            io.outputLine(indent + "const " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarInt" or item.kind == "VarString" or item.kind == "VarBool" or item.kind == "VarFloat" or item.kind == "VarTuple" {
            io.outputLine(indent + "let " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarList" {
            io.outputLine(indent + "let " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignFloat" or item.kind == "AssignTuple" {
            io.outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "AssignList" {
            io.outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "Scope" {
            io.outputLine(indent + "{");
            indent = indent + "    ";
        } else if item.kind == "If" {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            io.outputLine(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            io.outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "ElseIf" {
            indent = dedent(indent);
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            io.outputLine(indent + "} else if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" or item.kind == "EndScope" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "LoopSeq" {
            io.outputLine(indent + "for (const " + item.runtime + " of " + tsLiteral.listCopyCode(item.code) + ") {");
            indent = indent + "    ";
            io.outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "Boolean(true)" }
                else if item.code == "false" { "Boolean(false)" }
                else { item.code };
            io.outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "End" or item.kind == "EndOutput" {
            if count == 0 {
                io.outputLine(indent + "lite$emit(" + tsLiteral.textLiteralCode(if item.kind == "End" { "\n" } else { "" }) + ");");
            } else {
                ending := if item.kind == "End" { " + \"\\n\"" } else { "" };
                emitted := if count == 1 and item.kind == "End" and not textLib.startsWithAt(line, 0, "(") and textLib.indexOfText(line, "?", 0) >= 0 {
                    "(" + line + ")"
                } else {
                    line
                };
                io.outputLine(indent + "lite$emit(" + emitted + ending + ");");
            }
            line = "";
            count = 0;
        } else if item.kind == "MainStop" {
            mainStopped = true;
        } else if item.kind == "Import" or item.kind == "PublicFunction" or item.kind == "PublicValue" or item.kind == "PublicType" {
        } else {
            if count > 0 { line = line + " + \" \" + "; }
            line = line + reportArgumentCode(item);
            count = count + 1;
        }
    }
    if not mainStopped { io.outputLine("    return lite$out;"); }
    io.outputLine("}");
}
