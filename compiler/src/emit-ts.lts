/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Maps a restricted Lite scalar kind to its TypeScript type. */
tsScalarType := fn(kind: String): String {
    if kind == "Int" { "bigint" }
    else if kind == "String" { "string" }
    else if kind == "Float" { "number" }
    else if kind == "Bool" { "boolean" }
    else { "void" }
}

/** Formats one canonical flat named-tuple kind as a TypeScript object type. */
tsTupleType := fn(kind: String): String {
    size := textLength(kind);
    var cursor := 1;
    var result := "{ ";
    var count := 0;
    loop cursor < size and textAt(kind, cursor) =!= ")" {
        nameStart := cursor;
        cursor = skipName(kind, cursor);
        label := textSlice(kind, nameStart, cursor);
        if cursor < size and textAt(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipName(kind, cursor);
        fieldKind := textSlice(kind, typeStart, cursor);
        if count > 0 { result = result + " "; }
        result = result + label + ": " + tsScalarType(fieldKind);
        count = count + 1;
        if cursor < size and textAt(kind, cursor) == "," {
            result = result + ";";
            cursor = cursor + 1;
        }
    }
    result + " }"
}

/** Maps a restricted Lite scalar, flat named-tuple or List kind to its TypeScript type. */
tsFunctionType := fn(kind: String): String {
    if isListKind(kind) { tsFunctionType(listElementKind(kind)) + "[]" }
    else if isTupleKind(kind) { tsTupleType(kind) }
    else { tsScalarType(kind) }
}

/** Formats a `|`-separated `name=kind` parameter list as a TypeScript parameter list. */
tsParameterList := fn(encoded: String): String {
    if encoded == "" { return ""; }
    var result := "";
    var start := 0;
    loop true {
        separator := indexOfText(encoded, "|", start);
        var end := textLength(encoded);
        if separator >= 0 { end = separator; }
        entry := textSlice(encoded, start, end);
        equals := indexOfText(entry, "=", 0);
        parameterName := textSlice(entry, 0, equals);
        parameterKind := textSlice(entry, equals + 1, textLength(entry));
        if textLength(result) > 0 { result = result + ", "; }
        result = result + "lite_" + parameterName + ": " + tsFunctionType(parameterKind);
        if separator < 0 { break; }
        start = separator + 1;
    }
    result
}

/** Emits `void` reads for parameters so strict unused-parameter checking accepts bodies that ignore inputs. */
reportParameterReads := fn(encoded: String, indent: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        separator := indexOfText(encoded, "|", start);
        var end := textLength(encoded);
        if separator >= 0 { end = separator; }
        entry := textSlice(encoded, start, end);
        equals := indexOfText(entry, "=", 0);
        outputLine(indent + "void lite_" + textSlice(entry, 0, equals) + ";");
        if separator < 0 { break; }
        start = separator + 1;
    }
}

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
displayValueCode := fn(kind: String, code: String): String {
    if kind == "Int" or kind == "Float" { return "(" + code + ").toString()"; }
    if kind == "Bool" { return "((" + code + ") ? \"true\" : \"false\")"; }
    if kind == "Unit" { return "((value: unknown): string => { void value; return \"Unit\"; })(" + code + ")"; }
    if isListKind(kind) {
        element := listElementKind(kind);
        return "(\"[\" + (" + code + ").map((value: " + tsFunctionType(element) + ") => " + self(element, "value") + ").join(\", \") + \"]\")";
    }
    if isTupleKind(kind) {
        var result := textLiteralCode("(");
        var cursor := 1;
        var count := 0;
        loop cursor < textLength(kind) and textAt(kind, cursor) =!= ")" {
            start := cursor;
            cursor = skipName(kind, cursor);
            label := textSlice(kind, start, cursor);
            cursor = cursor + 1;
            typeStart := cursor;
            cursor = skipName(kind, cursor);
            component := textSlice(kind, typeStart, cursor);
            separator := if count == 0 { "" } else { ", " };
            result = result + " + " + textLiteralCode(separator + label + "=") + " + " + self(component, "value." + label);
            count = count + 1;
            if cursor < textLength(kind) and textAt(kind, cursor) == "," { cursor = cursor + 1; }
        }
        ending := if count == 1 { ",)" } else { ")" };
        return "((value: " + tsFunctionType(kind) + "): string => " + result + " + " + textLiteralCode(ending) + ")(" + code + ")";
    }
    code
}

/** Formats one output argument without duplicating its evaluation. */
reportArgumentCode := fn(item: Item): String {
    displayValueCode(item.kind, item.code)
}

/** True when any emitted item reads a list element through the checked helper. */
usesListIndex := fn(items: Items): Bool {
    loop items as item {
        if codeUsesListIndex(item.code) { return true; }
    }
    false
}

/** True when any emitted item pops a list element through the checked helper. */
usesListPop := fn(items: Items): Bool {
    loop items as item {
        if codeUsesListPop(item.code) { return true; }
    }
    false
}

/** True when any emitted item calls the named `lite$` helper outside quoted String literal text. */
usesBuiltin := fn(items: Items, name: String): Bool {
    loop items as item {
        if codeUsesTextCall(item.code, "lite$" + name + "(") { return true; }
    }
    false
}

/** True when a program needs the checked dynamic Int64 arithmetic runtime. */
usesIntArithmetic := fn(items: Items): Bool {
    usesBuiltin(items, "addInt") or usesBuiltin(items, "subtractInt") or usesBuiltin(items, "multiplyInt") or usesBuiltin(items, "negateInt")
}

/** True when positioned division-family helpers are needed. */
usesIntDivision := fn(items: Items): Bool {
    usesBuiltin(items, "divideInt") or usesBuiltin(items, "remainderInt") or usesBuiltin(items, "floorDivideInt") or usesBuiltin(items, "floorModuloInt")
}

/** Emits position metadata once, a checked result guard, and only the arithmetic helpers the program uses. */
emitIntArithmeticHelpers := fn(items: Items, source: String, prefix: String): Unit {
    if not usesIntArithmetic(items) and not usesIntDivision(items) { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    needsRange := usesIntArithmetic(items) or usesBuiltin(items, "divideInt") or usesBuiltin(items, "floorDivideInt");
    outputLine("const lite$intLines: readonly number[] = [" + lineStartCodes(source) + "];");
    outputLine("const lite$intSource = " + textLiteralCode(namePrefix) + ";");
    if needsRange { outputLine("const lite$intMin = -(1n << 63n), lite$intMax = (1n << 63n) - 1n;"); }
    outputLine("function lite$intFault(at: number, message: string): never {");
    outputLine("    let line = 0;");
    outputLine("    while (line + 1 < lite$intLines.length && (lite$intLines[line + 1] ?? Infinity) <= at) line += 1;");
    outputLine("    const column = at - (lite$intLines[line] ?? 0) + 1;");
    outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, lite$intSource + (line + 1) + \":\" + column + \": ArithmeticPanic: \" + message + \"\\n\");");
    outputLine("    process.exit(1);");
    outputLine("}");
    if needsRange {
        outputLine("function lite$checkedInt(value: bigint, at: number): bigint {");
        outputLine("    if (value < lite$intMin || value > lite$intMax) lite$intFault(at, \"integer outside Int range\");");
        outputLine("    return value;");
        outputLine("}");
    }
    if usesBuiltin(items, "addInt") {
        outputLine("function lite$addInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left + right, at); }");
    }
    if usesBuiltin(items, "subtractInt") {
        outputLine("function lite$subtractInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left - right, at); }");
    }
    if usesBuiltin(items, "multiplyInt") {
        outputLine("function lite$multiplyInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left * right, at); }");
    }
    if usesBuiltin(items, "negateInt") {
        outputLine("function lite$negateInt(value: bigint, at: number): bigint { return lite$checkedInt(-value, at); }");
    }
    outputLine("");
}

/** Emits shared buffered byte input and strict incremental UTF-8 decoding for the temporary input helpers. */
emitInputHelpers := fn(items: Items): Unit {
    if not (usesBuiltin(items, "inputAll") or usesBuiltin(items, "inputLine") or usesBuiltin(items, "inputInt") or usesBuiltin(items, "inputFloat")) { return; }
    outputLine("declare const TextDecoder: { new(label: string, options: { fatal: boolean }): { decode(input?: Uint8Array, options?: { stream: boolean }): string } };");
    outputLine("const lite$decoder = new TextDecoder(\"utf-8\", { fatal: true });");
    outputLine("const lite$bytes = new Uint8Array(4096);");
    outputLine("let lite$byteAt = 0, lite$byteEnd = 0;");
    outputLine("let lite$ended = false;");
    outputLine("let lite$pending: string | null | undefined;");
    outputLine("function lite$inputFault(at: string, message: string): never {");
    outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, at + message + \"\\n\");");
    outputLine("    process.exit(1);");
    outputLine("}");
    outputLine("function lite$prompt(text: string | undefined): void {");
    outputLine("    if (text === undefined) return;");
    outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite_out + text);");
    outputLine("    lite_out = \"\";");
    outputLine("}");
    outputLine("function lite$peek(at: string): string | null {");
    outputLine("    if (lite$pending !== undefined) return lite$pending;");
    outputLine("    if (lite$ended) return null;");
    outputLine("    try {");
    outputLine("        while (true) {");
    outputLine("            if (lite$byteAt === lite$byteEnd) {");
    outputLine("                lite$byteEnd = process.getBuiltinModule(\"node:fs\").readSync(0, lite$bytes, 0, lite$bytes.length, null);");
    outputLine("                lite$byteAt = 0;");
    outputLine("                if (lite$byteEnd === 0) {");
    outputLine("                    lite$ended = true;");
    outputLine("                    lite$pending = lite$decoder.decode() || null;");
    outputLine("                    return lite$pending;");
    outputLine("                }");
    outputLine("            }");
    outputLine("            const text = lite$decoder.decode(lite$bytes.subarray(lite$byteAt, ++lite$byteAt), { stream: true });");
    outputLine("            if (text !== \"\") { lite$pending = text; return text; }");
    outputLine("        }");
    outputLine("    } catch (error) {");
    outputLine("        return lite$inputFault(at, \"cannot read input: \" + (error instanceof Error ? error.message : String(error)));");
    outputLine("    }");
    outputLine("}");
    outputLine("function lite$take(at: string): string | null {");
    outputLine("    const text = lite$peek(at); lite$pending = undefined; return text;");
    outputLine("}");
    if usesBuiltin(items, "inputInt") or usesBuiltin(items, "inputFloat") {
        outputLine("function lite$word(at: string): string | null {");
        outputLine("    let ch = lite$peek(at);");
        outputLine("    while (ch !== null && /\\s/u.test(ch)) { lite$take(at); ch = lite$peek(at); }");
        outputLine("    if (ch === null) return null;");
        outputLine("    let text = \"\";");
        outputLine("    while (ch !== null && !/\\s/u.test(ch)) { text += lite$take(at); ch = lite$peek(at); }");
        outputLine("    return text;");
        outputLine("}");
    }
    if usesBuiltin(items, "inputAll") {
        outputLine("function lite$inputAll(prompt: string | undefined, at: string): string {");
        outputLine("    lite$prompt(prompt);");
        outputLine("    let text = \"\";");
        outputLine("    for (let ch = lite$take(at); ch !== null; ch = lite$take(at)) text += ch;");
        outputLine("    return text;");
        outputLine("}");
    }
    if usesBuiltin(items, "inputLine") {
        outputLine("function lite$inputLine(prompt: string | undefined, at: string): string {");
        outputLine("    lite$prompt(prompt);");
        outputLine("    let text = \"\", ch = lite$take(at);");
        outputLine("    if (ch === null) return lite$inputFault(at, \"EOF before inputLine value\");");
        outputLine("    while (ch !== null && ch !== \"\\n\") { text += ch; ch = lite$take(at); }");
        outputLine("    return ch === \"\\n\" && text.endsWith(\"\\r\") ? text.slice(0, -1) : text;");
        outputLine("}");
    }
    if usesBuiltin(items, "inputInt") {
        outputLine("function lite$inputInt(prompt: string | undefined, at: string): bigint {");
        outputLine("    lite$prompt(prompt);");
        outputLine("    const text = lite$word(at);");
        outputLine("    if (text === null) return lite$inputFault(at, \"EOF before inputInt value\");");
        outputLine("    if (!/^[+-]?[0-9]+$/.test(text)) return lite$inputFault(at, \"expected an integer token\");");
        outputLine("    const value = BigInt(text);");
        outputLine("    if (value < -(1n << 63n) || value > (1n << 63n) - 1n) return lite$inputFault(at, \"input outside signed 64-bit range\");");
        outputLine("    return value;");
        outputLine("}");
    }
    if usesBuiltin(items, "inputFloat") {
        outputLine("function lite$inputFloat(prompt: string | undefined, at: string): number {");
        outputLine("    lite$prompt(prompt);");
        outputLine("    const text = lite$word(at);");
        outputLine("    if (text === null) return lite$inputFault(at, \"EOF before inputFloat value\");");
        outputLine("    const value = Number(text);");
        outputLine("    if (!/^[+-]?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$/.test(text) || !Number.isFinite(value)) return lite$inputFault(at, \"expected a finite floating token\");");
        outputLine("    return value;");
        outputLine("}");
    }
    outputLine("");
}

/** Emits the self-contained declarations and helpers for the I/O and text builtins a program uses. */
emitBuiltinHelpers := fn(items: Items): Unit {
    if usesBuiltin(items, "inputArgs") or usesBuiltin(items, "inputAll") or usesBuiltin(items, "inputLine") or usesBuiltin(items, "inputInt") or usesBuiltin(items, "inputFloat") or
        usesBuiltin(items, "reportError") or usesBuiltin(items, "exit") or usesIntArithmetic(items) or usesIntDivision(items) {
        outputLine("declare const process: {");
        outputLine("    argv: string[];");
        outputLine("    exit(code: number): never;");
        outputLine("    getBuiltinModule(name: \"node:fs\"): {");
        outputLine("        readSync(fd: number, buffer: Uint8Array, offset: number, length: number, position: null): number;");
        outputLine("        writeSync(fd: number, text: string): number;");
        outputLine("    };");
        outputLine("};");
        outputLine("");
    }
    if usesBuiltin(items, "inputArgs") {
        outputLine("function lite$inputArgs(): string[] {");
        outputLine("    return process.argv.slice(2);");
        outputLine("}");
        outputLine("");
    }
    emitInputHelpers(items);
    if usesBuiltin(items, "reportError") {
        outputLine("function lite$reportError(text: string): void {");
        outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, text + \"\\n\");");
        outputLine("}");
        outputLine("");
    }
    if usesBuiltin(items, "exit") {
        outputLine("function lite$exit(status: bigint): void {");
        outputLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite_out);");
        outputLine("    process.exit(Number(status));");
        outputLine("}");
        outputLine("");
    }
    if usesBuiltin(items, "textLength") or usesBuiltin(items, "textAt") or usesBuiltin(items, "textSlice") {
        outputLine("const lite$textCache = new Map<string, readonly string[]>();");
        outputLine("function lite$textPoints(text: string): readonly string[] {");
        outputLine("    const found = lite$textCache.get(text);");
        outputLine("    if (found !== undefined) {");
        outputLine("        lite$textCache.delete(text);");
        outputLine("        lite$textCache.set(text, found);");
        outputLine("        return found;");
        outputLine("    }");
        outputLine("    const points = Array.from(text);");
        outputLine("    lite$textCache.set(text, points);");
        outputLine("    if (lite$textCache.size > 8) {");
        outputLine("        const oldest = lite$textCache.keys().next();");
        outputLine("        if (oldest.done !== true) lite$textCache.delete(oldest.value);");
        outputLine("    }");
        outputLine("    return points;");
        outputLine("}");
        outputLine("");
    }
    if usesBuiltin(items, "textLength") {
        outputLine("function lite$textLength(text: string): bigint {");
        outputLine("    return BigInt(lite$textPoints(text).length);");
        outputLine("}");
        outputLine("");
    }
    if usesBuiltin(items, "textAt") {
        outputLine("function lite$textAt(text: string, position: bigint): string {");
        outputLine("    const points = lite$textPoints(text);");
        outputLine("    if (position < 0n || position >= BigInt(points.length)) {");
        outputLine("        throw new Error(\"BoundPanic: textAt index outside text\");");
        outputLine("    }");
        outputLine("    const value = points[Number(position)];");
        outputLine("    if (value === undefined) {");
        outputLine("        throw new Error(\"BoundPanic: textAt index outside text\");");
        outputLine("    }");
        outputLine("    return value;");
        outputLine("}");
        outputLine("");
    }
    if usesBuiltin(items, "textSlice") {
        outputLine("function lite$textSlice(text: string, start: bigint, end: bigint): string {");
        outputLine("    const points = lite$textPoints(text);");
        outputLine("    if (start < 0n || end < start || end > BigInt(points.length)) {");
        outputLine("        throw new Error(\"BoundPanic: textSlice requires 0 <= start <= end <= textLength(text)\");");
        outputLine("    }");
        outputLine("    return points.slice(Number(start), Number(end)).join(\"\");");
        outputLine("}");
        outputLine("");
    }
    return;
}

/** Emits the checked list-index helper used by generated programs that read list elements. */
emitListIndexHelper := fn(): Unit {
    outputLine("function lite$listAt<T>(items: readonly T[], index: bigint): T {");
    outputLine("    if (index < 0n || index >= BigInt(items.length)) {");
    outputLine("        throw new Error(\"BoundPanic: list index outside its extent\");");
    outputLine("    }");
    outputLine("    const value = items[Number(index)];");
    outputLine("    if (value === undefined) {");
    outputLine("        throw new Error(\"BoundPanic: list index outside its extent\");");
    outputLine("    }");
    outputLine("    return value;");
    outputLine("}");
    outputLine("");
}

/** Emits the checked list-pop helper used by generated programs that pop a list tail. */
emitListPopHelper := fn(): Unit {
    outputLine("function lite$listPopBack<T>(items: T[]): T {");
    outputLine("    const value = items.pop();");
    outputLine("    if (value === undefined) {");
    outputLine("        throw new Error(\"BoundPanic: pop_back on an empty list\");");
    outputLine("    }");
    outputLine("    return value;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned truncating division with checked Int64 results. */
emitIntDivideHelper := fn(): Unit {
    outputLine("function lite$divideInt(left: bigint, right: bigint, at: number): bigint {");
    outputLine("    if (right === 0n) lite$intFault(at, \"division by zero\");");
    outputLine("    return lite$checkedInt(left / right, at);");
    outputLine("}");
    outputLine("");
}

/** Emits positioned remainder; MIN%-1 is representable zero. */
emitIntRemainderHelper := fn(): Unit {
    outputLine("function lite$remainderInt(left: bigint, right: bigint, at: number): bigint {");
    outputLine("    if (right === 0n) lite$intFault(at, \"remainder by zero\");");
    outputLine("    return left % right;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned floor division without repeating operands. */
emitIntFloorDivideHelper := fn(): Unit {
    outputLine("function lite$floorDivideInt(left: bigint, right: bigint, at: number): bigint {");
    outputLine("    const quotient = lite$divideInt(left, right, at);");
    outputLine("    const remainder = left % right;");
    outputLine("    return remainder !== 0n && (left < 0n) !== (right < 0n) ? quotient - 1n : quotient;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned floor modulo, including signed-minimum divisors. */
emitIntFloorModuloHelper := fn(): Unit {
    outputLine("function lite$floorModuloInt(left: bigint, right: bigint, at: number): bigint {");
    outputLine("    if (right === 0n) lite$intFault(at, \"modulo by zero\");");
    outputLine("    const remainder = left % right;");
    outputLine("    return remainder !== 0n && (remainder < 0n) !== (right < 0n) ? remainder + right : remainder;");
    outputLine("}");
    outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(items: Items): Unit {
    if (usesBuiltin(items, "divideInt") or usesBuiltin(items, "floorDivideInt")) { emitIntDivideHelper(); }
    if usesBuiltin(items, "remainderInt") { emitIntRemainderHelper(); }
    if usesBuiltin(items, "floorDivideInt") { emitIntFloorDivideHelper(); }
    if usesBuiltin(items, "floorModuloInt") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the TS module from the flat item stream. Report arguments evaluate once, left to right, before reading and appending to `lite_out`, preserving reports made by argument calls. */
emitProgram := fn(items: Items, source: String, prefix: String): Unit {
    hasExit := usesBuiltin(items, "exit") or usesBuiltin(items, "inputAll") or usesBuiltin(items, "inputLine") or usesBuiltin(items, "inputInt") or usesBuiltin(items, "inputFloat");
    if hasExit {
        outputLine("let lite_out = \"\";");
        outputLine("");
    }
    emitBuiltinHelpers(items);
    if usesListIndex(items) { emitListIndexHelper(); }
    if usesListPop(items) { emitListPopHelper(); }
    emitIntArithmeticHelpers(items, source, prefix);
    emitIntDivisionHelpers(items);
    outputLine("export function main(lite$write?: (text: string) => void): string {");
    if not hasExit { outputLine("    let lite_out = \"\";"); }
    outputLine("    function lite$emit(text: string): void {");
    outputLine("        if (lite$write === undefined) lite_out += text;");
    outputLine("        else lite$write(text);");
    outputLine("    }");
    outputLine("    void lite$emit;");
    var indent := "    ";
    var line := "";
    var count := 0;
    var reportIndex := 0;
    loop items as item {
        if item.kind == "FunctionStart" {
            outputLine(indent + "function " + item.runtime + "(" + tsParameterList(item.textValue) + "): " +
                tsFunctionType(item.code) + " {");
            indent = indent + "    ";
            reportParameterReads(item.textValue, indent);
        } else if item.kind == "FunctionEnd" {
            indent = dedent(indent);
            outputLine(indent + "}");
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "Return" {
            if item.code == "" {
                outputLine(indent + "return;");
            } else {
                outputLine(indent + "return " + item.code + ";");
            }
        } else if item.kind == "Break" {
            outputLine(indent + "break;");
        } else if item.kind == "Continue" {
            outputLine(indent + "continue;");
        } else if item.kind == "Call" {
            outputLine(indent + item.code + ";");
        } else if item.kind == "LocalInt" or item.kind == "LocalString" or item.kind == "LocalBool" or item.kind == "LocalFloat" or item.kind == "LocalTuple" {
            outputLine(indent + "const " + item.runtime + " = " + item.code + ";");
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "LocalList" {
            outputLine(indent + "const " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarInt" or item.kind == "VarString" or item.kind == "VarBool" or item.kind == "VarFloat" or item.kind == "VarTuple" {
            outputLine(indent + "let " + item.runtime + " = " + item.code + ";");
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarList" {
            outputLine(indent + "let " + item.runtime + ": " + tsFunctionType(item.textValue) + " = " + item.code + ";");
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignFloat" or item.kind == "AssignTuple" {
            outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "AssignList" {
            outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "If" {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            outputLine(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "ElseIf" {
            indent = dedent(indent);
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            outputLine(indent + "} else if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" {
            indent = dedent(indent);
            outputLine(indent + "}");
        } else if item.kind == "LoopSeq" {
            outputLine(indent + "for (const " + item.runtime + " of " + listCopyCode(item.code) + ") {");
            indent = indent + "    ";
            outputLine(indent + "void " + item.runtime + ";");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "Boolean(true)" }
                else if item.code == "false" { "Boolean(false)" }
                else { item.code };
            outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            outputLine(indent + "}");
        } else if item.kind == "End" or item.kind == "EndOutput" {
            if count == 0 { line = textLiteralCode(""); }
            temporary := "lite$report" + intText(reportIndex);
            outputLine(indent + "const " + temporary + " = " + line + ";");
            ending := if item.kind == "End" { " + \"\\n\"" } else { "" };
            outputLine(indent + "lite$emit(" + temporary + ending + ");");
            reportIndex = reportIndex + 1;
            line = "";
            count = 0;
        } else {
            if count > 0 { line = line + " + \" \" + "; }
            line = line + reportArgumentCode(item);
            count = count + 1;
        }
    }
    outputLine("    return lite_out;");
    outputLine("}");
}
