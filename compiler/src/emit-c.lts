        io.outputLine("    ssize_t n = read(e->fd, tmp, cap);");
        io.outputLine("    if (n < 0) { e->error = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        io.outputLine("    if (n == 0) { e->eof = true; free(tmp); return empty; }");
        io.outputLine("    int64_t *data = malloc((size_t)n * sizeof(int64_t));");
