        outLine("    if (max_bytes <= 0) { return empty; }");
        outLine("    if (strcmp(reader." + fKind + ", \"stdin\") == 0 && reader." + fHandle + " == 0) {");
        outLine("        if (lt_stdin_err[0] != '\\0' || lt_stdin_eof) { return empty; }");
        outLine("        size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        outLine("        uint8_t *tmp = malloc(cap);");
        outLine("        if (tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate read buffer\\n\"); exit(1); }");
        outLine("        ssize_t n = read(0, tmp, cap);");
        outLine("        if (n < 0) { lt_stdin_err = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        outLine("        if (n == 0) { lt_stdin_eof = true; free(tmp); return empty; }");
        outLine("        int64_t *data = malloc((size_t)n * sizeof(int64_t));");
        outLine("        if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate bytes\\n\"); exit(1); }");
        outLine("        for (ssize_t i = 0; i < n; i += 1) { data[i] = (int64_t)tmp[i]; }");
        outLine("        free(tmp);");
        outLine("        return (lt_list_i64){ data, (int64_t)n, (int64_t)n, NULL };");
        outLine("    }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    if (e == NULL || e->closed || e->error[0] != '\\0' || e->kind == 4 || e->kind == 3 || e->eof) { return empty; }");
        outLine("    if (e->kind == 2) {");
        outLine("        int64_t avail = e->len - e->pos;");
        outLine("        int64_t take = max_bytes > avail ? avail : max_bytes;");
        outLine("        if (take <= 0) { e->eof = true; return empty; }");
        outLine("        int64_t *data = malloc((size_t)take * sizeof(int64_t));");
        outLine("        if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate bytes\\n\"); exit(1); }");
        outLine("        for (int64_t i = 0; i < take; i += 1) { data[i] = (int64_t)e->buf[e->pos + i]; }");
        outLine("        e->pos += take;");
        outLine("        return (lt_list_i64){ data, take, take, NULL };");
        outLine("    }");
        outLine("    size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        outLine("    uint8_t *tmp = malloc(cap);");
        outLine("    if (tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate read buffer\\n\"); exit(1); }");
        outLine("    ssize_t n = read(e->fd, tmp, cap);");
        outLine("    if (n < 0) { e->error = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        outLine("    if (n == 0) { e->eof = true; free(tmp); return empty; }");
        outLine("    int64_t *data = malloc((size_t)n * sizeof(int64_t));");
        outLine("    if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate bytes\\n\"); exit(1); }");
        outLine("    for (ssize_t i = 0; i < n; i += 1) { data[i] = (int64_t)tmp[i]; }");
        outLine("    free(tmp);");
        outLine("    return (lt_list_i64){ data, (int64_t)n, (int64_t)n, NULL };");
