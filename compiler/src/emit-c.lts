frontend := import "./frontend.lts";
cLiteral := import "./c-literals.lts";
integer := import "core/int";
listLib := import "core/list";
diagLib := import "core/diag";
io := import "core/io";
textLib := import "core/text";
tb := import "util/text-builder";

var cOutUseWriter := false;
cOutBuf: mut tb.TextBuilder;

/** Emits one C11 line to either stdout or the buffered `TextBuilder` for `--out`. */
outLine := fn(s: String): Unit {
    if not cOutUseWriter {
        io.outputLine(s);
    } else {
        tb.appendLine(mut cOutBuf, s);
    }
};

/** Emits raw C11 text to either stdout or the buffered `TextBuilder` for `--out`. */
outText := fn(s: String): Unit {
    if not cOutUseWriter {
        io.output(s);
    } else {
        tb.append(mut cOutBuf, s);
    }
};

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textLib.slice(indent, 0, textLib.length(indent) - 4)
}

/** Returns the C11 scalar list tag (`i64`, `f64`, `bool`, `str`) for a List/Array kind, or `""` if not a C-supported list/array. */
cListTagForKind := fn(kind: String): String {
    if frontend.isListKind(kind) { frontend.cListTag(frontend.listElementKind(kind)) }
    else if frontend.isArrayKind(kind) { frontend.cListTag(frontend.arrayElementKind(kind)) }
    else { "" }
};

/** Maps a restricted Lite scalar, enum, struct, map, set, list/array, or Unit/Never kind to its C11 type. */
cScalarType := fn(kind: String): String {
    listTag := cListTagForKind(kind);
    if listTag =!= "" { "lt_list_" + listTag }
    else if frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) }
    else if frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) }
    else if frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) }
    else if frontend.cFnTag(kind) =!= "" { frontend.cFnTag(kind) }
    else if kind == frontend.VALUE_KIND_UNIT or kind == frontend.VALUE_KIND_NEVER { "void" }
    else if frontend.isIntScalarKind(kind) or frontend.isEnumKind(kind) { "int64_t" }
    else if kind == frontend.VALUE_KIND_BOOL { "bool" }
    else if frontend.isFloatScalarKind(kind) { "double" }
    else { "const char *" }
};

/** Maps a local or mutable variable item to its C11 declaration type prefix. */
cDeclTypeItem := fn(item: frontend.Item): String {
    kind := item.kind;
    if kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST {
        "lt_list_" + cListTagForKind(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE {
        frontend.cStructTag(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_FN or kind == frontend.ITEM_KIND_VAR_FN {
        cScalarType(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT { "int64_t " }
    else if kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT { "double " }
    else if kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL { "bool " }
    else { "const char *" }
};

/** Fails cleanly when a reachable scalar/function signature references an unsupported C type. */
checkUnsupportedCType := fn(kind: String): Unit {
    if frontend.isTupleKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support tuple values yet"); }
    if frontend.isMapKind(kind) and frontend.cMapTag(kind) == "" { diagLib.fail("", "C backend does not support map values yet"); }
    if frontend.isSetKind(kind) and frontend.cSetTag(kind) == "" { diagLib.fail("", "C backend does not support set values yet"); }
    if frontend.isRecordKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support record values yet"); }
    if frontend.isListKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support list values yet"); }
    if frontend.isArrayKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support array values yet"); }
    if frontend.isFnKind(kind) and frontend.cFnTag(kind) == "" { diagLib.fail("", "C backend does not support function values yet"); }
};

/** Checks parameter and return types of a reachable top-level or module function for C11 emission. */
checkCFunctionSignature := fn(item: frontend.Item): Unit {
    checkUnsupportedCType(item.code);
    encoded := item.textValue;
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        if eq >= 0 {
            checkUnsupportedCType(textLib.slice(entry, eq + 1, textLib.length(entry)));
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** Emits UTF-8 Unicode scalar `core/text` C11 helpers only for primitives referenced by `calls`. */
emitTextPrimitiveHelpers := fn(calls: String): Unit {
    hasSliceFrom := usesIntHelper(calls, "lite$textSliceFrom(");
    hasLen := usesIntHelper(calls, "lite$textLength(") or hasSliceFrom;
    hasAt := usesIntHelper(calls, "lite$textAt(");
    hasSlice := usesIntHelper(calls, "lite$textSlice(") or hasSliceFrom;
    hasSoftUtf8 := usesCTextSoftUtf8(calls);
    if not hasLen and not hasAt and not hasSlice and not hasSoftUtf8 { return; }
    outLine("static size_t lt_utf8_step(const char *s, size_t offset) {");
    outLine("    const unsigned char b = (unsigned char)s[offset];");
    outLine("    if (b < 0x80u) { return 1u; }");
    outLine("    if ((b & 0xE0u) == 0xC0u && s[offset + 1] != '\\0') { return 2u; }");
    outLine("    if ((b & 0xF0u) == 0xE0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0') { return 3u; }");
    outLine("    if ((b & 0xF8u) == 0xF0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0' && s[offset + 3] != '\\0') { return 4u; }");
    outLine("    return 1u;");
    outLine("}");
    outLine("typedef struct { const char *s; size_t byte_len; int64_t cp_len; bool ascii; size_t last_b; int64_t last_cp; } lt_utf8_meta;");
    outLine("static lt_utf8_meta lt_utf8_cache[64];");
    outLine("static lt_utf8_meta *lt_utf8_get_meta(const char *s) {");
    outLine("    size_t h = (((size_t)(uintptr_t)s) >> 4) & 63u;");
    outLine("    if (lt_utf8_cache[h].s == s) { return &lt_utf8_cache[h]; }");
    outLine("    size_t b = 0u; int64_t cp = 0; bool ascii = true;");
    outLine("    while (s[b] != '\\0') {");
    outLine("        if ((unsigned char)s[b] < 0x80u) { b += 1u; cp += 1; }");
    outLine("        else { ascii = false; b += lt_utf8_step(s, b); cp += 1; }");
    outLine("    }");
    outLine("    lt_utf8_meta *slot = &lt_utf8_cache[h];");
    outLine("    slot->s = s; slot->byte_len = b; slot->cp_len = cp; slot->ascii = ascii; slot->last_b = 0u; slot->last_cp = 0;");
    outLine("    return slot;");
    outLine("}");
    if hasAt or hasSlice {
        outLine("static const char *lt_ascii_char(unsigned char c) {");
        outLine("    static char tbl[128][2];");
        outLine("    static bool init = false;");
        outLine("    if (!init) { for (int i = 0; i < 128; i++) { tbl[i][0] = (char)i; tbl[i][1] = '\\0'; } init = true; }");
        outLine("    return tbl[c];");
        outLine("}");
        outLine("static const char *lt_alloc_text_slice(const char *s, size_t start, size_t end) {");
        outLine("    const size_t len = end - start;");
        outLine("    if (len == 0u) { return \"\"; }");
        outLine("    if (len == 1u && (unsigned char)s[start] < 128u) { return lt_ascii_char((unsigned char)s[start]); }");
        outLine("    char *out = lt_str_alloc(len + 1u);");
        outLine("    memcpy(out, s + start, len);");
        outLine("    out[len] = '\\0';");
        outLine("    return out;");
        outLine("}");
    }
    if hasAt or hasSlice or hasSoftUtf8 {
        outLine("static size_t lt_utf8_byte_at(const char *s, int64_t target, bool allow_end, bool *ok) {");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (target < 0 || target > m->cp_len || (!allow_end && target == m->cp_len)) { *ok = false; return 0u; }");
        outLine("    if (m->ascii) { *ok = true; return (size_t)target; }");
        outLine("    if (target == m->cp_len) { *ok = true; return m->byte_len; }");
        outLine("    size_t byte_pos = (target >= m->last_cp) ? m->last_b : 0u;");
        outLine("    int64_t count = (target >= m->last_cp) ? m->last_cp : 0;");
        outLine("    while (count < target && s[byte_pos] != '\\0') { byte_pos += lt_utf8_step(s, byte_pos); count += 1; }");
        outLine("    m->last_b = byte_pos; m->last_cp = count;");
        outLine("    *ok = true;");
        outLine("    return byte_pos;");
        outLine("}");
    }
    if hasLen {
        outLine("static int64_t lt_text_length(const char *s) { return lt_utf8_get_meta(s)->cp_len; }");
    }
    if hasAt {
        outLine("static char lt_ascii_chars[128][2];");
        outLine("static bool lt_ascii_chars_init = false;");
        outLine("static const char *lt_text_at(const char *s, int64_t position, size_t at) {");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (position < 0 || position >= m->cp_len) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("    if (m->ascii) {");
        outLine("        if (!lt_ascii_chars_init) { for (int i = 0; i < 128; i += 1) { lt_ascii_chars[i][0] = (char)i; lt_ascii_chars[i][1] = '\\0'; } lt_ascii_chars_init = true; }");
        outLine("        return lt_ascii_chars[(unsigned char)s[position]];");
        outLine("    }");
        outLine("    bool ok = false;");
        outLine("    const size_t start = lt_utf8_byte_at(s, position, false, &ok);");
        outLine("    if (!ok) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("    return lt_alloc_text_slice(s, start, start + lt_utf8_step(s, start));");
        outLine("}");
    }
    if hasSlice {
        outLine("static const char *lt_text_slice(const char *s, int64_t start, int64_t end, size_t at) {");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (start < 0 || end < start || end > m->cp_len) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    if (m->ascii) { return lt_alloc_text_slice(s, (size_t)start, (size_t)end); }");
        outLine("    bool ok = false;");
        outLine("    const size_t b_start = lt_utf8_byte_at(s, start, true, &ok);");
        outLine("    if (!ok) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    size_t b_end = b_start;");
        outLine("    int64_t remaining = end - start;");
        outLine("    while (remaining > 0 && s[b_end] != '\\0') { b_end += lt_utf8_step(s, b_end); remaining -= 1; }");
        outLine("    if (remaining > 0) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    return lt_alloc_text_slice(s, b_start, b_end);");
        outLine("}");
    }
    if hasSliceFrom {
        outLine("static const char *lt_text_slice_from(const char *s, int64_t start, size_t at) {");
        outLine("    return lt_text_slice(s, start, lt_text_length(s), at);");
        outLine("}");
    }
    outLine("");
};

/** True when a program calls supported C11 stdin helpers (`inputAll`, `inputLine`, `inputInt`, `inputFloat`). */
usesInputHelpers := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or
    usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(")
};

/** Emits portable ISO C11 stdin helpers matching Lite's `core/io` prompt and `InputFault` contracts. */
emitInputHelpers := fn(calls: String): Unit {
    hasAll := usesIntHelper(calls, "lite$inputAll(");
    hasLine := usesIntHelper(calls, "lite$inputLine(");
    hasInt := usesIntHelper(calls, "lite$inputInt(");
    hasFloat := usesIntHelper(calls, "lite$inputFloat(");
    if not hasAll and not hasLine and not hasInt and not hasFloat { return; }
    outLine("static void lt_input_prompt(const char *prompt) {");
    outLine("    if (prompt != NULL) { fputs(prompt, stdout); fflush(stdout); }");
    outLine("}");
    if hasLine or hasInt or hasFloat {
        outLine("static _Noreturn void lt_input_fault(const char *at, const char *message) {");
        outLine("    fprintf(stderr, \"%s%s\\n\", at, message);");
        outLine("    exit(1);");
        outLine("}");
    }
    if hasInt or hasFloat {
        outLine("static char *lt_input_word(void) {");
        outLine("    int ch = fgetc(stdin);");
        outLine("    while (ch != EOF && (ch == ' ' || ch == '\\t' || ch == '\\r' || ch == '\\n')) { ch = fgetc(stdin); }");
        outLine("    if (ch == EOF) { return NULL; }");
        outLine("    size_t cap = 64u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    while (ch != EOF && ch != ' ' && ch != '\\t' && ch != '\\r' && ch != '\\n') {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    if (ch != EOF) { ungetc(ch, stdin); }");
        outLine("    buf[len] = '\\0';");
        outLine("    return buf;");
        outLine("}");
    }
    if hasAll {
        outLine("static const char *lt_input_all(const char *prompt, const char *at) {");
        outLine("    (void)at;");
        outLine("    lt_input_prompt(prompt);");
        outLine("    size_t cap = 128u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    int ch = fgetc(stdin);");
        outLine("    while (ch != EOF) {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    buf[len] = '\\0';");
        outLine("    return buf;");
        outLine("}");
    }
    if hasLine {
        outLine("static const char *lt_input_line(const char *prompt, const char *at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    int ch = fgetc(stdin);");
        outLine("    if (ch == EOF) { lt_input_fault(at, \"EOF before inputLine value\"); }");
        outLine("    size_t cap = 128u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    while (ch != EOF && ch != '\\n') {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    if (ch == '\\n' && len > 0u && buf[len - 1u] == '\\r') { len -= 1u; }");
        outLine("    buf[len] = '\\0';");
        outLine("    return buf;");
        outLine("}");
    }
    if hasInt {
        outLine("static int64_t lt_input_int(const char *prompt, const char *at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    char *tok = lt_input_word();");
        outLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputInt value\"); }");
        outLine("    size_t i = (tok[0] == '+' || tok[0] == '-') ? 1u : 0u;");
        outLine("    if (tok[i] == '\\0') { free(tok); lt_input_fault(at, \"expected an integer token\"); }");
        outLine("    while (tok[i] != '\\0') { if (tok[i] < '0' || tok[i] > '9') { free(tok); lt_input_fault(at, \"expected an integer token\"); } i += 1u; }");
        outLine("    errno = 0;");
        outLine("    char *endp = NULL;");
        outLine("    long long val = strtoll(tok, &endp, 10);");
        outLine("    int err = errno;");
        outLine("    free(tok);");
        outLine("    if (err == ERANGE || val < INT64_MIN || val > INT64_MAX) { lt_input_fault(at, \"input outside signed 64-bit range\"); }");
        outLine("    return (int64_t)val;");
        outLine("}");
    }
    if hasFloat {
        outLine("static double lt_input_float(const char *prompt, const char *at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    char *tok = lt_input_word();");
        outLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputFloat value\"); }");
        outLine("    char *endp = NULL;");
        outLine("    double val = strtod(tok, &endp);");
        outLine("    bool ok = endp != tok && *endp == '\\0' && isfinite(val);");
        outLine("    free(tok);");
        outLine("    if (!ok) { lt_input_fault(at, \"expected a finite floating token\"); }");
        outLine("    return val;");
        outLine("}");
    }
    outLine("");
};

/** Formats a pipe-separated parameter list as C11 typed parameters or `void`. */
cParameterList := fn(encoded: String): String {
    if encoded == "" { return "void"; }
    var result := "";
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        paramName := textLib.slice(entry, 0, eq);
        rawParamKind := textLib.slice(entry, eq + 1, textLib.length(entry));
        isMutParam := textLib.startsWithAt(rawParamKind, 0, "mut ");
        paramKind := if isMutParam { textLib.slice(rawParamKind, 4, textLib.length(rawParamKind)) } else { rawParamKind };
        if textLib.length(result) > 0 { result = result + ", "; }
        result = result + cScalarType(paramKind) + (if isMutParam { " *lite_" } else { " lite_" }) + paramName;
        if sep < 0 { break; }
        start = sep + 1;
    }
    result
};

/** Emits `(void)lite_param;` silencing reads for strict C11 warning checks. */
emitCParameterReads := fn(encoded: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        outLine("    (void)lite_" + textLib.slice(entry, 0, eq) + ";");
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** True when `item.kind` starts a local/mutable variable declaration. */
isCLocalDeclKind := fn(kind: String): Bool {
    kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT or
    kind == frontend.ITEM_KIND_LOCAL_STRING or kind == frontend.ITEM_KIND_VAR_STRING or
    kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT or
    kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL or
    kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE or
    kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST or
    kind == frontend.ITEM_KIND_LOCAL_FN or kind == frontend.ITEM_KIND_VAR_FN
};

/** Skips a balanced CFN_START ... CFN_END hoisted-closure block starting at `start` in `code`. */
skipCFnBlock := fn(code: String, start: Int): Int {
    size := textLib.length(code);
    var cursor := start + 13;
    var depth := 1;
    loop cursor < size and depth > 0 {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CFN_START:") {
            depth = depth + 1;
            cursor = cursor + 13;
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CFN_END@*/") {
            depth = depth - 1;
            cursor = cursor + 13;
        } else {
            cursor = cursor + 1;
        }
    }
    cursor
};

/** Detects leaked JS tuple or array literal syntax inside a scalar-typed expression on C, skipping quoted strings, type annotations, and C11 compound literals. */
unsupportedAggregateCode := fn(code: String): String {
    if textLib.indexOfText(code, "{", 0) < 0 and textLib.indexOfText(code, "[", 0) < 0 { return ""; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CFN_START:") {
            cursor = skipCFnBlock(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:") or textLib.startsWithAt(code, cursor, "/*@P:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
        } else if ch == "(" and (textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "(const ") or textLib.startsWithAt(code, cursor, "((lt_s_") or textLib.startsWithAt(code, cursor, "((lt_fnv_")) {
            isDouble := textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "((lt_s_") or textLib.startsWithAt(code, cursor, "((lt_fnv_");
            var depth := 0;
            loop cursor < size {
                c2 := textLib.at(code, cursor);
                if c2 == "\"" {
                    cursor = frontend.skipAliasString(code, cursor);
                } else {
                    if c2 == "(" { depth = depth + 1; }
                    else if c2 == ")" {
                        depth = depth - 1;
                        if depth == 0 {
                            cursor = cursor + 1;
                            if not isDouble and cursor < size and textLib.at(code, cursor) == "{" {
                                var bDepth := 0;
                                loop cursor < size {
                                    c3 := textLib.at(code, cursor);
                                    if c3 == "\"" { cursor = frontend.skipAliasString(code, cursor); }
                                    else {
                                        if c3 == "{" { bDepth = bDepth + 1; }
                                        else if c3 == "}" {
                                            bDepth = bDepth - 1;
                                            if bDepth == 0 { cursor = cursor + 1; break; }
                                        }
                                        cursor = cursor + 1;
                                    }
                                }
                            }
                            break;
                        }
                    }
                    cursor = cursor + 1;
                }
            }
        } else if ch == "[" and textLib.startsWithAt(code, cursor, "[0] == '\\0'") {
            cursor = cursor + textLib.length("[0] == '\\0'");
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CBLK:") {
            return "";
        } else if ch == "{" and textLib.startsWithAt(code, cursor, "{ /*c-stmt*/") {
            return "";
        } else if ch == "{" {
            return "C backend does not support tuple values yet";
        } else if ch == "[" {
            return "C backend does not support array values yet";
        } else {
            cursor = cursor + 1;
        }
    }
    ""
};

/** Rewrites registered `lite$...(` builtin calls and strips internal `/*@T:...*/`/`/*@C:...*/` markers outside quoted strings. */
normalizeCBuiltinCalls := fn(code: String): String {
    if textLib.indexOfText(code, "lite$", 0) < 0 and textLib.indexOfText(code, "/*@", 0) < 0 { return code; }
    size := textLib.length(code);
    var out := "";
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CFN_START:") {
            out = out + textLib.slice(code, flushed, cursor);
            cursor = skipCFnBlock(code, cursor);
            flushed = cursor;
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:") or textLib.startsWithAt(code, cursor, "/*@P:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            out = out + textLib.slice(code, flushed, cursor);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$reportError(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_report_error(";
            cursor = cursor + textLib.length("lite$reportError(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$exit(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_exit(";
            cursor = cursor + textLib.length("lite$exit(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textLength(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_length(";
            cursor = cursor + textLib.length("lite$textLength(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textAt(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_at(";
            cursor = cursor + textLib.length("lite$textAt(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textSliceFrom(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_slice_from(";
            cursor = cursor + textLib.length("lite$textSliceFrom(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textSlice(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_slice(";
            cursor = cursor + textLib.length("lite$textSlice(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputArgs(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_args(";
            cursor = cursor + textLib.length("lite$inputArgs(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputAll(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_all(";
            cursor = cursor + textLib.length("lite$inputAll(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputLine(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_line(";
            cursor = cursor + textLib.length("lite$inputLine(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputInt(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_int(";
            cursor = cursor + textLib.length("lite$inputInt(");
