        outLine("    if ((strcmp(writer." + fKind + ", \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(writer." + fKind + ", \"stderr\") == 0 && writer." + fHandle + " == 2)) { return (" + okErrTag + "){ true, \"\" }; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okErrTag + "){ false, \"invalid writer handle\" }; }");
        outLine("    if (e->kind == 4) { return (" + okErrTag + "){ false, e->error }; }");
        outLine("    if (e->kind == 2) { return (" + okErrTag + "){ false, \"handle is a reader, not a writer\" }; }");
        outLine("    if (e->closed) { return (" + okErrTag + "){ false, \"writer is closed\" }; }");
        outLine("    if (e->kind == 3) { return (" + okErrTag + "){ true, \"\" }; }");
        outLine("    if (fsync(e->fd) < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioCloseWriter(") {
        outLine("static " + okErrTag + " lt_io_close_writer(" + shTag + " writer) {");
        outLine("    if ((strcmp(writer." + fKind + ", \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(writer." + fKind + ", \"stderr\") == 0 && writer." + fHandle + " == 2)) { return (" + okErrTag + "){ true, \"\" }; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okErrTag + "){ false, \"invalid writer handle\" }; }");
        outLine("    if (e->kind == 4) { return (" + okErrTag + "){ false, e->error }; }");
        outLine("    if (e->kind == 2) { return (" + okErrTag + "){ false, \"handle is a reader, not a writer\" }; }");
        outLine("    if (e->kind == 1 && !e->closed) {");
        outLine("        int rc = close(e->fd);");
        outLine("        e->closed = true;");
        outLine("        if (rc < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    }");
        outLine("    e->closed = true;");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterBytes(") {
        outLine("static lt_list_i64 lt_io_writer_bytes(" + shTag + " writer) {");
        outLine("    lt_list_i64 empty = { NULL, 0, 0, NULL };");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL || e->kind != 3 || e->len <= 0) { return empty; }");
        outLine("    int64_t *data = malloc((size_t)e->len * sizeof(int64_t));");
        outLine("    if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate writer bytes\\n\"); exit(1); }");
        outLine("    for (int64_t i = 0; i < e->len; i += 1) { data[i] = (int64_t)e->buf[i]; }");
        outLine("    return (lt_list_i64){ data, e->len, e->len, NULL };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterText(") {
        outLine("static " + okTextTag + " lt_io_writer_text(" + shTag + " writer) {");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okTextTag + "){ false, \"\", \"invalid writer handle\" }; }");
        outLine("    if (e->kind != 3) { return (" + okTextTag + "){ false, \"\", \"writer is not a buffer writer\" }; }");
        outLine("    if (e->error[0] != '\\0') { return (" + okTextTag + "){ false, \"\", e->error }; }");
        outLine("    for (int64_t i = 0; i < e->len; ) {");
        outLine("        uint8_t b0 = e->buf[i];");
        outLine("        if (b0 < 0x80) { i += 1; }");
        outLine("        else if (b0 >= 0xC2 && b0 <= 0xDF && i + 1 < e->len && (e->buf[i + 1] & 0xC0) == 0x80) { i += 2; }");
        outLine("        else if (b0 >= 0xE0 && b0 <= 0xEF && i + 2 < e->len && (e->buf[i + 1] & 0xC0) == 0x80 && (e->buf[i + 2] & 0xC0) == 0x80 && !(b0 == 0xE0 && e->buf[i + 1] < 0xA0) && !(b0 == 0xED && e->buf[i + 1] >= 0xA0)) { i += 3; }");
        outLine("        else if (b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < e->len && (e->buf[i + 1] & 0xC0) == 0x80 && (e->buf[i + 2] & 0xC0) == 0x80 && (e->buf[i + 3] & 0xC0) == 0x80 && !(b0 == 0xF0 && e->buf[i + 1] < 0x90) && !(b0 == 0xF4 && e->buf[i + 1] >= 0x90)) { i += 4; }");
        outLine("        else { return (" + okTextTag + "){ false, \"\", \"invalid UTF-8 byte sequence\" }; }");
        outLine("    }");
        outLine("    char *out = malloc((size_t)e->len + 1);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate writer text\\n\"); exit(1); }");
        outLine("    if (e->len > 0) { memcpy(out, e->buf, (size_t)e->len); }");
        outLine("    out[e->len] = '\\0';");
        outLine("    return (" + okTextTag + "){ true, out, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioClearWriter(") {
        outLine("static void lt_io_clear_writer(" + shTag + " writer) {");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e != NULL && e->kind == 3) { e->len = 0; }");
        outLine("}");
    }
};

/** Emits C11 `core/file` non-stream filesystem builtin helpers. */
emitCFileBuiltinHelpers := fn(calls: String): Unit {
    if not usesFileBuiltins(calls) { return; }
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    okPathTag := frontend.cStructTag("(ok:Bool,path:String,error:String)");
    if usesIntHelper(calls, "lite$fileKind(") {
        outLine("static const char *lt_file_kind(const char *path) {");
        outLine("    struct stat st;");
        outLine("    if (stat(path, &st) != 0) { return \"missing\"; }");
        outLine("    if (S_ISREG(st.st_mode)) { return \"file\"; }");
        outLine("    if (S_ISDIR(st.st_mode)) { return \"dir\"; }");
        outLine("    return \"other\";");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileListDir(") {
        outLine("static int lt_cmp_cstr(const void *a, const void *b) {");
        outLine("    const char *sa = *(const char *const *)a;");
        outLine("    const char *sb = *(const char *const *)b;");
        outLine("    return strcmp(sa, sb);");
        outLine("}");
        outLine("static lt_list_str lt_file_list_dir(const char *path) {");
        outLine("    DIR *d = opendir(path);");
        outLine("    if (d == NULL) { fprintf(stderr, \"cannot list directory %s: %s\\n\", path, strerror(errno)); exit(2); }");
        outLine("    int64_t len = 0; int64_t cap = 16;");
        outLine("    const char **data = malloc((size_t)cap * sizeof(const char *));");
        outLine("    if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate dir list\\n\"); exit(1); }");
        outLine("    struct dirent *ent;");
        outLine("    while ((ent = readdir(d)) != NULL) {");
        outLine("        if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) { continue; }");
        outLine("        if (len >= cap) { cap *= 2; data = realloc(data, (size_t)cap * sizeof(const char *)); if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot grow dir list\\n\"); exit(1); } }");
        outLine("        data[len++] = lt_dup_str(ent->d_name);");
        outLine("    }");
        outLine("    closedir(d);");
        outLine("    if (len > 1) { qsort(data, (size_t)len, sizeof(const char *), lt_cmp_cstr); }");
        outLine("    return (lt_list_str){ data, len, cap, NULL };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileMakeDir(") {
        outLine("static " + okErrTag + " lt_file_make_dir(const char *path) {");
        outLine("    if (path[0] == '\\0') { return (" + okErrTag + "){ false, \"empty path\" }; }");
        outLine("    char *tmp = lt_dup_str(path);");
        outLine("    size_t n = strlen(tmp);");
        outLine("    while (n > 1 && tmp[n - 1] == '/') { tmp[--n] = '\\0'; }");
        outLine("    for (size_t i = 1; i < n; i += 1) {");
        outLine("        if (tmp[i] == '/') {");
        outLine("            tmp[i] = '\\0';");
        outLine("            if (mkdir(tmp, 0777) != 0 && errno != EEXIST) { const char *err = lt_dup_str(strerror(errno)); free(tmp); return (" + okErrTag + "){ false, err }; }");
        outLine("            tmp[i] = '/';");
        outLine("        }");
        outLine("    }");
        outLine("    if (mkdir(tmp, 0777) != 0) {");
        outLine("        struct stat st;");
        outLine("        if (!(errno == EEXIST && stat(tmp, &st) == 0 && S_ISDIR(st.st_mode))) {");
        outLine("            const char *err = lt_dup_str(strerror(errno)); free(tmp); return (" + okErrTag + "){ false, err };");
        outLine("        }");
        outLine("    }");
        outLine("    free(tmp);");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileRemove(") {
        outLine("static " + okErrTag + " lt_file_remove(const char *path) {");
        outLine("    struct stat st;");
        outLine("    if (lstat(path, &st) != 0) {");
        outLine("        if (errno == ENOENT) { return (" + okErrTag + "){ true, \"\" }; }");
        outLine("        return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) };");
        outLine("    }");
        outLine("    if (S_ISDIR(st.st_mode)) {");
        outLine("        DIR *d = opendir(path);");
        outLine("        if (d == NULL) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        struct dirent *ent;");
        outLine("        while ((ent = readdir(d)) != NULL) {");
        outLine("            if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) { continue; }");
        outLine("            size_t clen = strlen(path) + 1 + strlen(ent->d_name) + 1;");
        outLine("            char *child = malloc(clen);");
        outLine("            if (child == NULL) { closedir(d); return (" + okErrTag + "){ false, \"out of memory\" }; }");
        outLine("            snprintf(child, clen, \"%s/%s\", path, ent->d_name);");
        outLine("            " + okErrTag + " sub = lt_file_remove(child);");
        outLine("            free(child);");
        outLine("            if (!sub." + frontend.cFieldName("ok") + ") { closedir(d); return sub; }");
        outLine("        }");
        outLine("        closedir(d);");
        outLine("        if (rmdir(path) != 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        return (" + okErrTag + "){ true, \"\" };");
        outLine("    }");
        outLine("    if (unlink(path) != 0 && errno != ENOENT) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileCopy(") {
        outLine("static " + okErrTag + " lt_file_copy(const char *from_path, const char *to_path) {");
        outLine("    struct stat st;");
        outLine("    if (lstat(from_path, &st) != 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    if (S_ISLNK(st.st_mode)) {");
        outLine("        char lbuf[4096];");
        outLine("        ssize_t n = readlink(from_path, lbuf, sizeof(lbuf) - 1);");
        outLine("        if (n < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        lbuf[n] = '\\0';");
        outLine("        unlink(to_path);");
        outLine("        if (symlink(lbuf, to_path) != 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        return (" + okErrTag + "){ true, \"\" };");
        outLine("    }");
        outLine("    if (S_ISDIR(st.st_mode)) {");
        outLine("        if (mkdir(to_path, 0777) != 0 && errno != EEXIST) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        DIR *d = opendir(from_path);");
        outLine("        if (d == NULL) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("        struct dirent *ent;");
        outLine("        while ((ent = readdir(d)) != NULL) {");
        outLine("            if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) { continue; }");
        outLine("            size_t slen = strlen(from_path) + 1 + strlen(ent->d_name) + 1;");
        outLine("            size_t dlen = strlen(to_path) + 1 + strlen(ent->d_name) + 1;");
        outLine("            char *sp = malloc(slen); char *dp = malloc(dlen);");
        outLine("            if (sp == NULL || dp == NULL) { free(sp); free(dp); closedir(d); return (" + okErrTag + "){ false, \"out of memory\" }; }");
        outLine("            snprintf(sp, slen, \"%s/%s\", from_path, ent->d_name);");
        outLine("            snprintf(dp, dlen, \"%s/%s\", to_path, ent->d_name);");
        outLine("            " + okErrTag + " sub = lt_file_copy(sp, dp);");
        outLine("            free(sp); free(dp);");
        outLine("            if (!sub." + frontend.cFieldName("ok") + ") { closedir(d); return sub; }");
        outLine("        }");
        outLine("        closedir(d);");
        outLine("        return (" + okErrTag + "){ true, \"\" };");
        outLine("    }");
        outLine("    int in_fd = open(from_path, O_RDONLY);");
        outLine("    if (in_fd < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    int out_fd = open(to_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);");
        outLine("    if (out_fd < 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); return (" + okErrTag + "){ false, err }; }");
        outLine("    uint8_t buf[65536];");
        outLine("    for (;;) {");
        outLine("        ssize_t n = read(in_fd, buf, sizeof(buf));");
        outLine("        if (n < 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); close(out_fd); return (" + okErrTag + "){ false, err }; }");
        outLine("        if (n == 0) { break; }");
        outLine("        ssize_t off = 0;");
        outLine("        while (off < n) {");
        outLine("            ssize_t w = write(out_fd, buf + off, (size_t)(n - off));");
        outLine("            if (w < 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); close(out_fd); return (" + okErrTag + "){ false, err }; }");
        outLine("            off += w;");
        outLine("        }");
        outLine("    }");
        outLine("    close(in_fd); close(out_fd);");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileSymlink(") {
        outLine("static " + okErrTag + " lt_file_symlink(const char *target_path, const char *link_path) {");
        outLine("    if (symlink(target_path, link_path) != 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileRealPath(") {
        outLine("static " + okPathTag + " lt_file_real_path(const char *path) {");
        outLine("    char *resolved = realpath(path, NULL);");
        outLine("    if (resolved == NULL) { return (" + okPathTag + "){ false, \"\", lt_dup_str(strerror(errno)) }; }");
        outLine("    return (" + okPathTag + "){ true, resolved, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileMakeTempDir(") {
        outLine("static " + okPathTag + " lt_file_make_temp_dir(const char *prefix) {");
        outLine("    const char *base = getenv(\"TMPDIR\");");
        outLine("    if (base == NULL || base[0] == '\\0') { base = \"/tmp\"; }");
        outLine("    size_t blen = strlen(base);");
        outLine("    bool need_slash = blen > 0 && base[blen - 1] != '/';");
        outLine("    size_t plen = strlen(prefix);");
        outLine("    char *tmpl = malloc(blen + (need_slash ? 1 : 0) + plen + 7);");
        outLine("    if (tmpl == NULL) { return (" + okPathTag + "){ false, \"\", \"out of memory\" }; }");
        outLine("    snprintf(tmpl, blen + (need_slash ? 1 : 0) + plen + 7, \"%s%s%sXXXXXX\", base, need_slash ? \"/\" : \"\", prefix);");
        outLine("    char *created = mkdtemp(tmpl);");
        outLine("    if (created == NULL) { const char *err = lt_dup_str(strerror(errno)); free(tmpl); return (" + okPathTag + "){ false, \"\", err }; }");
        outLine("    return (" + okPathTag + "){ true, created, \"\" };");
        outLine("}");
    }
};

/** Emits C11 `core/process` query builtin helpers. */
emitCProcessBuiltinHelpers := fn(calls: String): Unit {
    if not usesProcessQueryBuiltins(calls) { return; }
    if usesIntHelper(calls, "lite$processCwd(") {
        outLine("static const char *lt_process_cwd(void) {");
        outLine("    char *d = getcwd(NULL, 0);");
        outLine("    return d != NULL ? d : \"\";");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processExecPath(") {
        outLine("static const char *lt_process_exec_path(void) {");
        outLine("    if (lt_argc <= 0 || lt_argv == NULL || lt_argv[0] == NULL) { return \"\"; }");
        outLine("    char *r = realpath(lt_argv[0], NULL);");
        outLine("    return r != NULL ? r : lt_argv[0];");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processEntryPath(") {
        outLine("static const char *lt_process_entry_path(void) {");
        outLine("    if (lt_argc <= 0 || lt_argv == NULL || lt_argv[0] == NULL) { return \"\"; }");
        outLine("    char *r = realpath(lt_argv[0], NULL);");
        outLine("    return r != NULL ? r : lt_argv[0];");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processPlatform(") {
        outLine("static const char *lt_process_platform(void) {");
        outLine("#if defined(__APPLE__)");
        outLine("    return \"darwin\";");
        outLine("#elif defined(__linux__)");
        outLine("    return \"linux\";");
        outLine("#elif defined(_WIN32)");
        outLine("    return \"win32\";");
        outLine("#else");
        outLine("    return \"unknown\";");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processArch(") {
        outLine("static const char *lt_process_arch(void) {");
        outLine("#if defined(__aarch64__) || defined(_M_ARM64)");
        outLine("    return \"arm64\";");
        outLine("#elif defined(__x86_64__) || defined(_M_X64)");
        outLine("    return \"x64\";");
        outLine("#else");
        outLine("    return \"unknown\";");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processRuntimeVersion(") {
        outLine("static const char *lt_process_runtime_version(void) { return \"c11\"; }");
    }
    if usesIntHelper(calls, "lite$processEnvGet(") {
        foundValTag := frontend.cStructTag("(found:Bool,value:String)");
        outLine("static " + foundValTag + " lt_process_env_get(const char *name) {");
        outLine("    const char *v = getenv(name);");
        outLine("    if (v == NULL) { return (" + foundValTag + "){ false, \"\" }; }");
        outLine("    return (" + foundValTag + "){ true, v };");
        outLine("}");
    }
};

/** Emits C11 `core/time`, `core/crypto.randomBytes`, and `core/process.run`/`runBytes` helpers. */
emitCProcessSpawnAndTimeHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite$timeMonotonicNs(") {
        outLine("static int64_t lt_time_monotonic_ns(void) {");
        outLine("    struct timespec ts;");
        outLine("    clock_gettime(CLOCK_MONOTONIC, &ts);");
        outLine("    return (int64_t)ts.tv_sec * INT64_C(1000000000) + (int64_t)ts.tv_nsec;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$timeEpochNs(") {
        outLine("static int64_t lt_time_epoch_ns(void) {");
        outLine("    struct timespec ts;");
        outLine("    clock_gettime(CLOCK_REALTIME, &ts);");
        outLine("    return (int64_t)ts.tv_sec * INT64_C(1000000000) + (int64_t)ts.tv_nsec;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$timeSleepMs(") {
        outLine("static void lt_time_sleep_ms(int64_t ms) {");
        outLine("    if (ms <= 0) { return; }");
        outLine("    if (ms > INT64_C(2147483647)) { ms = INT64_C(2147483647); }");
        outLine("    struct timespec req = { (time_t)(ms / 1000), (long)((ms % 1000) * 1000000) };");
        outLine("    nanosleep(&req, NULL);");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$timeLocalDate(") {
        outLine("static const char *lt_time_local_date(void) {");
        outLine("    time_t t = time(NULL);");
        outLine("    struct tm tm_buf;");
        outLine("    localtime_r(&t, &tm_buf);");
        outLine("    char *buf = malloc(16);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate date\\n\"); exit(1); }");
        outLine("    snprintf(buf, 16, \"%04d-%02d-%02d\", tm_buf.tm_year + 1900, tm_buf.tm_mon + 1, tm_buf.tm_mday);");
        outLine("    return buf;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$cryptoRandomBytes(") {
        outLine("static lt_list_i64 lt_crypto_random_bytes(int64_t count) {");
        outLine("    if (count < 0 || count > INT64_C(2147483647)) { fprintf(stderr, \"randomBytes count out of range: %\" PRId64 \"\\n\", count); exit(2); }");
        outLine("    if (count == 0) { return (lt_list_i64){ NULL, 0, 0, NULL }; }");
        outLine("    int fd = open(\"/dev/urandom\", O_RDONLY);");
        outLine("    if (fd < 0) { fprintf(stderr, \"cannot open /dev/urandom: %s\\n\", strerror(errno)); exit(2); }");
        outLine("    uint8_t *raw = malloc((size_t)count);");
        outLine("    if (raw == NULL) { close(fd); fprintf(stderr, \"MemoryFault: cannot allocate random bytes\\n\"); exit(1); }");
        outLine("    size_t off = 0u;");
        outLine("    while (off < (size_t)count) {");
        outLine("        ssize_t n = read(fd, raw + off, (size_t)count - off);");
        outLine("        if (n <= 0) { free(raw); close(fd); fprintf(stderr, \"cannot read /dev/urandom\\n\"); exit(2); }");
        outLine("        off += (size_t)n;");
        outLine("    }");
        outLine("    close(fd);");
        outLine("    int64_t *data = malloc((size_t)count * sizeof(int64_t));");
        outLine("    int64_t *rc = malloc(sizeof(int64_t));");
        outLine("    if (data == NULL || rc == NULL) { free(raw); fprintf(stderr, \"MemoryFault: cannot allocate random list\\n\"); exit(1); }");
        outLine("    *rc = 1;");
        outLine("    for (int64_t i = 0; i < count; i += 1) { data[i] = (int64_t)raw[i]; }");
        outLine("    free(raw);");
        outLine("    return (lt_list_i64){ data, count, count, rc };");
        outLine("}");
    }
    if usesProcessSpawnBuiltins(calls) {
        outLine("typedef struct { int64_t status; uint8_t *out; size_t out_len; uint8_t *err; size_t err_len; const char *error; } lt_spawn_res;");
        outLine("static void lt_buf_append(uint8_t **buf, size_t *len, size_t *cap, const uint8_t *src, size_t n) {");
        outLine("    if (n == 0u) { return; }");
        outLine("    if (*len + n + 1u > *cap) {");
        outLine("        size_t ncap = *cap == 0u ? 4096u : *cap * 2u;");
        outLine("        while (ncap < *len + n + 1u) { ncap *= 2u; }");
        outLine("        uint8_t *nb = realloc(*buf, ncap);");
        outLine("        if (nb == NULL) { fprintf(stderr, \"MemoryFault: cannot grow capture buffer\\n\"); exit(1); }");
        outLine("        *buf = nb; *cap = ncap;");
        outLine("    }");
        outLine("    memcpy(*buf + *len, src, n); *len += n;");
        outLine("}");
        outLine("static int64_t lt_mono_ms(void) {");
        outLine("    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);");
        outLine("    return (int64_t)ts.tv_sec * 1000 + (int64_t)(ts.tv_nsec / 1000000);");
        outLine("}");
        outLine("static lt_spawn_res lt_spawn_core(const char *command, lt_list_str args, const char *cwd, lt_list_str env_ov, bool capture, int64_t timeout_ms, const uint8_t *in_data, size_t in_len) {");
        outLine("    for (int64_t i = 0; i < env_ov.len; i += 1) {");
        outLine("        if (strchr(env_ov.data[i], '=') == NULL) {");
        outLine("            size_t elen = strlen(env_ov.data[i]) + 40u;");
        outLine("            char *msg = malloc(elen);");
        outLine("            if (msg != NULL) { snprintf(msg, elen, \"invalid environment override: %s\", env_ov.data[i]); }");
        outLine("            return (lt_spawn_res){ -1, NULL, 0u, NULL, 0u, msg != NULL ? msg : \"invalid environment override\" };");
        outLine("        }");
        outLine("    }");
        outLine("    int in_p[2] = { -1, -1 }; int out_p[2] = { -1, -1 }; int err_p[2] = { -1, -1 }; int exec_p[2] = { -1, -1 };");
        outLine("    if (pipe(exec_p) != 0) { return (lt_spawn_res){ -1, NULL, 0u, NULL, 0u, lt_dup_str(strerror(errno)) }; }");
        outLine("    fcntl(exec_p[1], F_SETFD, FD_CLOEXEC);");
        outLine("    if (capture) {");
        outLine("        if (pipe(in_p) != 0 || pipe(out_p) != 0 || pipe(err_p) != 0) {");
        outLine("            const char *msg = lt_dup_str(strerror(errno));");
        outLine("            if (in_p[0] >= 0) { close(in_p[0]); close(in_p[1]); }");
        outLine("            if (out_p[0] >= 0) { close(out_p[0]); close(out_p[1]); }");
        outLine("            if (err_p[0] >= 0) { close(err_p[0]); close(err_p[1]); }");
        outLine("            close(exec_p[0]); close(exec_p[1]);");
        outLine("            return (lt_spawn_res){ -1, NULL, 0u, NULL, 0u, msg };");
        outLine("        }");
        outLine("    }");
        outLine("    char **argv = malloc((size_t)(args.len + 2) * sizeof(char *));");
        outLine("    if (argv == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate argv\\n\"); exit(1); }");
        outLine("    argv[0] = (char *)command;");
        outLine("    for (int64_t i = 0; i < args.len; i += 1) { argv[i + 1] = (char *)args.data[i]; }");
        outLine("    argv[args.len + 1] = NULL;");
        outLine("    fflush(stdout); fflush(stderr);");
        outLine("    pid_t pid = fork();");
        outLine("    if (pid < 0) {");
        outLine("        const char *msg = lt_dup_str(strerror(errno));");
        outLine("        free(argv);");
        outLine("        if (capture) { close(in_p[0]); close(in_p[1]); close(out_p[0]); close(out_p[1]); close(err_p[0]); close(err_p[1]); }");
        outLine("        close(exec_p[0]); close(exec_p[1]);");
        outLine("        return (lt_spawn_res){ -1, NULL, 0u, NULL, 0u, msg };");
        outLine("    }");
        outLine("    if (pid == 0) {");
        outLine("        close(exec_p[0]);");
        outLine("        if (capture) {");
        outLine("            dup2(in_p[0], 0); dup2(out_p[1], 1); dup2(err_p[1], 2);");
        outLine("            close(in_p[0]); close(in_p[1]); close(out_p[0]); close(out_p[1]); close(err_p[0]); close(err_p[1]);");
        outLine("        }");
        outLine("        if (cwd[0] != '\\0' && chdir(cwd) != 0) { int e = errno; ssize_t _w = write(exec_p[1], &e, sizeof(e)); (void)_w; _exit(127); }");
        outLine("        for (int64_t i = 0; i < env_ov.len; i += 1) {");
        outLine("            const char *eq = strchr(env_ov.data[i], '=');");
        outLine("            if (eq == env_ov.data[i]) { unsetenv(eq + 1); }");
        outLine("            else if (eq != NULL) {");
        outLine("                size_t klen = (size_t)(eq - env_ov.data[i]);");
        outLine("                char *key = malloc(klen + 1u);");
        outLine("                if (key != NULL) { memcpy(key, env_ov.data[i], klen); key[klen] = '\\0'; setenv(key, eq + 1, 1); free(key); }");
        outLine("            }");
        outLine("        }");
        outLine("        execvp(command, argv);");
        outLine("        int e = errno; ssize_t _w = write(exec_p[1], &e, sizeof(e)); (void)_w; _exit(127);");
        outLine("    }");
        outLine("    free(argv);");
        outLine("    close(exec_p[1]);");
        outLine("    int exec_err = 0;");
        outLine("    ssize_t en = read(exec_p[0], &exec_err, sizeof(exec_err));");
        outLine("    close(exec_p[0]);");
        outLine("    uint8_t *out_buf = NULL; size_t out_len = 0u; size_t out_cap = 0u;");
        outLine("    uint8_t *err_buf = NULL; size_t err_len = 0u; size_t err_cap = 0u;");
        outLine("    bool timed_out = false;");
        outLine("    if (capture) {");
        outLine("        close(in_p[0]); close(out_p[1]); close(err_p[1]);");
        outLine("        fcntl(in_p[1], F_SETFL, O_NONBLOCK); fcntl(out_p[0], F_SETFL, O_NONBLOCK); fcntl(err_p[0], F_SETFL, O_NONBLOCK);");
        outLine("        size_t in_off = 0u;");
        outLine("        if (in_len == 0u) { close(in_p[1]); in_p[1] = -1; }");
        outLine("        int64_t deadline = timeout_ms > 0 ? lt_mono_ms() + timeout_ms : 0;");
        outLine("        uint8_t tmp[16384];");
        outLine("        while (in_p[1] >= 0 || out_p[0] >= 0 || err_p[0] >= 0) {");
        outLine("            struct pollfd fds[3]; int nfds = 0;");
        outLine("            int idx_in = -1, idx_out = -1, idx_err = -1;");
        outLine("            if (in_p[1] >= 0) { idx_in = nfds; fds[nfds].fd = in_p[1]; fds[nfds].events = POLLOUT; fds[nfds].revents = 0; nfds += 1; }");
        outLine("            if (out_p[0] >= 0) { idx_out = nfds; fds[nfds].fd = out_p[0]; fds[nfds].events = POLLIN; fds[nfds].revents = 0; nfds += 1; }");
        outLine("            if (err_p[0] >= 0) { idx_err = nfds; fds[nfds].fd = err_p[0]; fds[nfds].events = POLLIN; fds[nfds].revents = 0; nfds += 1; }");
        outLine("            int pto = -1;");
        outLine("            if (deadline > 0) {");
        outLine("                int64_t rem = deadline - lt_mono_ms();");
        outLine("                if (rem <= 0) { timed_out = true; kill(pid, SIGKILL); break; }");
        outLine("                pto = rem > 60000 ? 60000 : (int)rem;");
        outLine("            }");
        outLine("            int pr = poll(fds, (nfds_t)nfds, pto);");
        outLine("            if (pr < 0) { if (errno == EINTR) { continue; } break; }");
        outLine("            if (pr == 0 && deadline > 0 && lt_mono_ms() >= deadline) { timed_out = true; kill(pid, SIGKILL); break; }");
        outLine("            if (idx_in >= 0 && (fds[idx_in].revents & (POLLOUT | POLLERR | POLLHUP))) {");
        outLine("                ssize_t w = write(in_p[1], in_data + in_off, in_len - in_off);");
        outLine("                if (w > 0) { in_off += (size_t)w; if (in_off >= in_len) { close(in_p[1]); in_p[1] = -1; } }");
        outLine("                else if (w < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) { close(in_p[1]); in_p[1] = -1; }");
        outLine("            }");
        outLine("            if (idx_out >= 0 && (fds[idx_out].revents & (POLLIN | POLLHUP | POLLERR))) {");
        outLine("                ssize_t r = read(out_p[0], tmp, sizeof(tmp));");
        outLine("                if (r > 0) { lt_buf_append(&out_buf, &out_len, &out_cap, tmp, (size_t)r); }");
        outLine("                else if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { close(out_p[0]); out_p[0] = -1; }");
        outLine("            }");
        outLine("            if (idx_err >= 0 && (fds[idx_err].revents & (POLLIN | POLLHUP | POLLERR))) {");
        outLine("                ssize_t r = read(err_p[0], tmp, sizeof(tmp));");
        outLine("                if (r > 0) { lt_buf_append(&err_buf, &err_len, &err_cap, tmp, (size_t)r); }");
        outLine("                else if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { close(err_p[0]); err_p[0] = -1; }");
        outLine("            }");
        outLine("        }");
        outLine("        if (in_p[1] >= 0) { close(in_p[1]); }");
        outLine("        if (out_p[0] >= 0) { close(out_p[0]); }");
        outLine("        if (err_p[0] >= 0) { close(err_p[0]); }");
        outLine("    }");
        outLine("    int wstatus = 0;");
        outLine("    while (waitpid(pid, &wstatus, 0) < 0 && errno == EINTR) {}");
        outLine("    if (en == (ssize_t)sizeof(exec_err) && exec_err != 0) {");
        outLine("        return (lt_spawn_res){ -1, out_buf, out_len, err_buf, err_len, lt_dup_str(strerror(exec_err)) };");
        outLine("    }");
        outLine("    if (timed_out) { return (lt_spawn_res){ -1, out_buf, out_len, err_buf, err_len, \"ETIMEDOUT\" }; }");
        outLine("    if (WIFSIGNALED(wstatus)) {");
        outLine("        char *smsg = malloc(64);");
        outLine("        if (smsg != NULL) { snprintf(smsg, 64, \"terminated by signal %d\", WTERMSIG(wstatus)); }");
        outLine("        return (lt_spawn_res){ -1, out_buf, out_len, err_buf, err_len, smsg != NULL ? smsg : \"terminated by signal\" };");
        outLine("    }");
        outLine("    int64_t code = WIFEXITED(wstatus) ? (int64_t)WEXITSTATUS(wstatus) : 1;");
        outLine("    return (lt_spawn_res){ code, out_buf, out_len, err_buf, err_len, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processRun(") {
        runTag := frontend.cStructTag("(status:Int,stdout:String,stderr:String,error:String)");
        outLine("static " + runTag + " lt_process_run(const char *command, lt_list_str args, const char *cwd, lt_list_str env_ov, bool capture, const char *stdin_text) {");
        outLine("    lt_spawn_res r = lt_spawn_core(command, args, cwd, env_ov, capture, 0, (const uint8_t *)stdin_text, strlen(stdin_text));");
        outLine("    char *so = \"\"; char *se = \"\";");
        outLine("    if (r.out != NULL) { so = realloc(r.out, r.out_len + 1u); if (so == NULL) { fprintf(stderr, \"MemoryFault\\n\"); exit(1); } so[r.out_len] = '\\0'; }");
        outLine("    if (r.err != NULL) { se = realloc(r.err, r.err_len + 1u); if (se == NULL) { fprintf(stderr, \"MemoryFault\\n\"); exit(1); } se[r.err_len] = '\\0'; }");
        outLine("    return (" + runTag + "){ r.status, so, se, r.error };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$processRunBytes(") {
        rbTag := frontend.cStructTag("(status:Int,error:String)");
        outLine("static " + rbTag + " lt_process_run_bytes(const char *command, lt_list_str args, const char *cwd, lt_list_str env_ov, int64_t timeout_ms, lt_list_i64 stdin_bytes, const char *stdout_path, const char *stderr_path) {");
        outLine("    uint8_t *in_buf = stdin_bytes.len > 0 ? malloc((size_t)stdin_bytes.len) : NULL;");
        outLine("    if (stdin_bytes.len > 0 && in_buf == NULL) { return (" + rbTag + "){ -1, \"out of memory\" }; }");
        outLine("    for (int64_t i = 0; i < stdin_bytes.len; i += 1) {");
        outLine("        if (stdin_bytes.data[i] < 0 || stdin_bytes.data[i] > 255) { free(in_buf); return (" + rbTag + "){ -1, \"byte value outside 0..255\" }; }");
        outLine("        in_buf[i] = (uint8_t)stdin_bytes.data[i];");
        outLine("    }");
        outLine("    lt_spawn_res r = lt_spawn_core(command, args, cwd, env_ov, true, timeout_ms, in_buf, (size_t)stdin_bytes.len);");
        outLine("    free(in_buf);");
        outLine("    const char *werr = \"\";");
        outLine("    if (stdout_path[0] != '\\0') {");
        outLine("        int fd = open(stdout_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);");
        outLine("        if (fd < 0) { werr = lt_dup_str(strerror(errno)); }");
        outLine("        else { size_t off = 0u; while (off < r.out_len) { ssize_t w = write(fd, r.out + off, r.out_len - off); if (w < 0) { werr = lt_dup_str(strerror(errno)); break; } off += (size_t)w; } close(fd); }");
        outLine("    }");
        outLine("    if (werr[0] == '\\0' && stderr_path[0] != '\\0') {");
        outLine("        int fd = open(stderr_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);");
        outLine("        if (fd < 0) { werr = lt_dup_str(strerror(errno)); }");
        outLine("        else { size_t off = 0u; while (off < r.err_len) { ssize_t w = write(fd, r.err + off, r.err_len - off); if (w < 0) { werr = lt_dup_str(strerror(errno)); break; } off += (size_t)w; } close(fd); }");
        outLine("    }");
        outLine("    free(r.out); free(r.err);");
        outLine("    if (werr[0] != '\\0') { return (" + rbTag + "){ -1, werr }; }");
        outLine("    return (" + rbTag + "){ r.status, r.error };");
        outLine("}");
    }
};

/** Emits all C11 host builtin helpers (`core/unicode`, `core/io` streams, `core/file`, `core/process`, `core/time`, `core/crypto`). */
emitCHostBuiltinHelpers := fn(calls: String): Unit {
    needDupStr := usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or
        usesIntHelper(calls, "lite$fileOpenAppender(") or usesIntHelper(calls, "lite$ioRead(") or
        usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWrite(") or
        usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") or
        usesIntHelper(calls, "lite$fileListDir(") or usesIntHelper(calls, "lite$fileMakeDir(") or
        usesIntHelper(calls, "lite$fileRemove(") or usesIntHelper(calls, "lite$fileCopy(") or
        usesIntHelper(calls, "lite$fileSymlink(") or usesIntHelper(calls, "lite$fileRealPath(") or
        usesIntHelper(calls, "lite$fileMakeTempDir(") or usesCFileSoft(calls) or usesProcessSpawnBuiltins(calls);
    if needDupStr {
        outLine("static char *lt_dup_str(const char *s) {");
        outLine("    size_t n = strlen(s);");
        outLine("    char *out = malloc(n + 1);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot duplicate string\\n\"); exit(1); }");
        outLine("    memcpy(out, s, n + 1);");
        outLine("    return out;");
        outLine("}");
    }
    emitCUnicodeBuiltinHelpers(calls);
    emitCStreamBuiltinHelpers(calls);
    emitCFileBuiltinHelpers(calls);
    emitCProcessBuiltinHelpers(calls);
    emitCProcessSpawnAndTimeHelpers(calls);
};

/** Extracts the C runtime parameter name (`lite_<name>`) at `targetIndex` from an encoded parameter list. */
cParamRuntimeAt := fn(encoded: String, targetIndex: Int): String {
    if encoded == "" or targetIndex < 0 { return ""; }
    var index := 0;
    var start := 0;
    loop true {
        separator := textLib.indexOfText(encoded, "|", start);
        end := if separator >= 0 { separator } else { textLib.length(encoded) };
        if index == targetIndex {
            entry := textLib.slice(encoded, start, end);
            eq := textLib.indexOfText(entry, "=", 0);
            if eq <= 0 { return ""; }
            return "lite_" + textLib.slice(entry, 0, eq);
        }
        if separator < 0 { return ""; }
        index = index + 1;
        start = separator + 1;
    }
    ""
};

/** Returns a C11 native fast-path return expression for a registered soft-builtin function, or `""`. */
cSoftBuiltinExpr := fn(moduleName: String, fnName: String, params: String): String {
    arg0 := cParamRuntimeAt(params, 0);
    if moduleName == "lib/core/int" {
        if fnName == "intText" { return "lt_c_int_text(" + arg0 + ")"; }
    } else if moduleName == "lib/core/text" {
        if fnName == "skipSpaces" { return "lt_c_text_skip_while(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", true)"; }
        if fnName == "skipName" { return "lt_c_text_skip_while(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", false)"; }
        if fnName == "indexOf" or fnName == "indexOfText" {
            return "lt_c_text_index_of(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "startsWithAt" {
            return "lt_c_text_starts_with_at(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "wordAt" {
            return "lt_c_text_word_at(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "joinTexts" { return "lt_c_text_join(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "textToInt" { return "lt_c_text_to_int(" + arg0 + ")"; }
        if fnName == "trimStart" { return "lt_c_text_trim(" + arg0 + ", true, false)"; }
        if fnName == "trimEnd" { return "lt_c_text_trim(" + arg0 + ", false, true)"; }
        if fnName == "trim" { return "lt_c_text_trim(" + arg0 + ", true, true)"; }
        if fnName == "endsWith" { return "lt_c_text_ends_with(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "repeatText" { return "lt_c_text_repeat(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "containsText" { return "lt_c_text_contains(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "toLowerAscii" { return "lt_c_text_to_lower(" + arg0 + ")"; }
        if fnName == "isDigit" { return "lt_c_text_is_digit(" + arg0 + ")"; }
        if fnName == "isAsciiLetter" { return "lt_c_text_is_ascii_letter(" + arg0 + ")"; }
        if fnName == "isNameStart" { return "lt_c_text_is_name_start(" + arg0 + ")"; }
        if fnName == "isNameContinue" { return "lt_c_text_is_name_continue(" + arg0 + ")"; }
        if fnName == "isWhitespace" { return "lt_c_text_is_whitespace(" + arg0 + ")"; }
    } else if moduleName == "lib/core/file" {
        if fnName == "readText" { return "lt_c_file_read_text(" + arg0 + ")"; }
        if fnName == "writeText" { return "lt_c_file_write_text(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "appendText" { return "lt_c_file_append_text(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
    }
    ""
};

/** Replaces verified soft-builtin function bodies with C11 host overrides unless switched to `pure` by `--builtin-mode`. */
applyCSoftBuiltins := fn(rawItems: frontend.Items, prefix: String, builtinSpecs: List<String>): frontend.Items {
    rules := frontend.parseBuiltinModeSpecs(prefix, builtinSpecs);
    out: mut frontend.Items = [];
    var skippingDepth := 0;
    var pendingSoftFn := "";
    var pendingSoftRuntime := "";
    var pendingSoftParams := "";
    loop rawItems as item {
        if skippingDepth > 0 {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                skippingDepth = skippingDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                skippingDepth = skippingDepth - 1;
                if skippingDepth == 0 { listLib.pushBack(mut out, item); }
            }
            continue;
        }
        if item.kind == frontend.ITEM_KIND_SOFT_BUILTIN {
            if pendingSoftFn =!= "" and item.name == pendingSoftFn and item.runtime == pendingSoftRuntime and item.textValue == pendingSoftParams {
                overrideCode := cSoftBuiltinExpr(item.code, item.name, item.textValue);
                if overrideCode =!= "" and frontend.resolveBuiltinMode(rules, item.code, item.name) == frontend.BUILTIN_MODE_BUILTIN {
                    listLib.pushBack(mut out, (kind = frontend.ITEM_KIND_RETURN, name = "", runtime = "", code = overrideCode, intValue = 0, textValue = ""));
                    skippingDepth = 1;
                }
            }
            pendingSoftFn = ""; pendingSoftRuntime = ""; pendingSoftParams = "";
            continue;
        }
        pendingSoftFn = ""; pendingSoftRuntime = ""; pendingSoftParams = "";
        listLib.pushBack(mut out, item);
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            pendingSoftFn = item.name;
            pendingSoftRuntime = item.runtime;
            pendingSoftParams = item.textValue;
        }
    }
    out
};

/** Emits C11 native fast-path helpers for `core/int`, `core/text`, and `core/file` soft builtins. */
emitCSoftBuiltinHelpers := fn(calls: String): Unit {
    if not usesCSoftBuiltins(calls) { return; }
    if usesIntHelper(calls, "lt_c_text_is_digit(") {
        outLine("static bool lt_c_text_is_digit(const char *s) { return s[0] >= '0' && s[0] <= '9' && s[1] == '\\0'; }");
    }
    if usesIntHelper(calls, "lt_c_text_is_ascii_letter(") {
        outLine("static bool lt_c_text_is_ascii_letter(const char *s) { return ((s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z')) && s[1] == '\\0'; }");
    }
    if usesIntHelper(calls, "lt_c_text_is_name_start(") {
        outLine("static bool lt_c_text_is_name_start(const char *s) { return (s[0] == '_' || (s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z')) && s[1] == '\\0'; }");
    }
    if usesIntHelper(calls, "lt_c_text_is_name_continue(") {
        outLine("static bool lt_c_text_is_name_continue(const char *s) { return (s[0] == '_' || (s[0] >= 'a' && s[0] <= 'z') || (s[0] >= 'A' && s[0] <= 'Z') || (s[0] >= '0' && s[0] <= '9')) && s[1] == '\\0'; }");
    }
    if usesIntHelper(calls, "lt_c_text_is_whitespace(") {
        outLine("static bool lt_c_text_is_whitespace(const char *s) { return (s[0] == ' ' || s[0] == '\\t' || s[0] == '\\r' || s[0] == '\\n') && s[1] == '\\0'; }");
    }
    if usesIntHelper(calls, "lt_c_int_text(") {
        outLine("static const char *lt_c_int_text(int64_t v) {");
        outLine("    char tmp[32];");
        outLine("    int n = snprintf(tmp, sizeof tmp, \"%\" PRId64, v);");
        outLine("    if (n < 0) { n = 0; }");
        outLine("    char *buf = lt_str_alloc((size_t)n + 1u);");
        outLine("    memcpy(buf, tmp, (size_t)n + 1u);");
        outLine("    return buf;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_skip_while(") {
        outLine("static int64_t lt_c_text_skip_while(const char *s, int64_t start, bool spaces) {");
        outLine("    if (start < 0) { fprintf(stderr, \"BoundPanic: textAt index outside text\\n\"); exit(1); }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (start >= m->cp_len) { return start; }");
        outLine("    bool ok = false;");
        outLine("    size_t b = lt_utf8_byte_at(s, start, true, &ok);");
        outLine("    int64_t cp = start;");
        outLine("    while (s[b] != '\\0') {");
        outLine("        unsigned char c = (unsigned char)s[b];");
        outLine("        bool keep = spaces ? (c == ' ' || c == '\\t' || c == '\\r' || c == '\\n')");
        outLine("            : ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_');");
        outLine("        if (!keep) { break; }");
        outLine("        b += 1u; cp += 1;");
        outLine("    }");
        outLine("    return cp;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_starts_with_at(") or usesIntHelper(calls, "lt_c_text_word_at(") {
        outLine("static bool lt_c_text_starts_with_at(const char *s, int64_t pos, const char *sub) {");
        outLine("    if (pos < 0) { return false; }");
        outLine("    size_t sub_len = strlen(sub);");
        outLine("    if (pos == 0) { return sub_len == 0u || strncmp(s, sub, sub_len) == 0; }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (pos > m->cp_len) { return false; }");
        outLine("    if (sub_len == 0u) { return true; }");
        outLine("    if (m->ascii) { return (size_t)pos + sub_len <= m->byte_len && memcmp(s + pos, sub, sub_len) == 0; }");
        outLine("    bool ok = false;");
        outLine("    size_t b = lt_utf8_byte_at(s, pos, true, &ok);");
        outLine("    return ok && b + sub_len <= m->byte_len && memcmp(s + b, sub, sub_len) == 0;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_word_at(") {
        outLine("static bool lt_c_text_word_at(const char *s, int64_t pos, const char *word) {");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (pos < 0 || pos > m->cp_len) { return false; }");
        outLine("    size_t wlen = strlen(word);");
        outLine("    size_t b = 0u;");
        outLine("    if (m->ascii) { b = (size_t)pos; }");
        outLine("    else { bool ok = false; b = lt_utf8_byte_at(s, pos, true, &ok); if (!ok) { return false; } }");
        outLine("    if (b + wlen > m->byte_len || memcmp(s + b, word, wlen) != 0) { return false; }");
        outLine("    if (b + wlen >= m->byte_len) { return true; }");
        outLine("    unsigned char c = (unsigned char)s[b + wlen];");
        outLine("    return !((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_');");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_index_of(") {
        outLine("static int64_t lt_c_text_index_of(const char *s, const char *needle, int64_t start) {");
        outLine("    if (start < 0) { return -1; }");
        outLine("    if (start == 0) {");
        outLine("        if (needle[0] == '\\0') { return 0; }");
        outLine("        const char *found = strstr(s, needle);");
        outLine("        if (found == NULL) { return -1; }");
        outLine("        size_t target_b = (size_t)(found - s);");
        outLine("        int64_t cp = 0; size_t b = 0u;");
        outLine("        while (b < target_b) {");
        outLine("            if ((unsigned char)s[b] < 0x80u) { b += 1u; cp += 1; }");
        outLine("            else { b += lt_utf8_step(s, b); cp += 1; }");
        outLine("        }");
        outLine("        return cp;");
        outLine("    }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (start > m->cp_len) { return -1; }");
        outLine("    if (needle[0] == '\\0') { return start; }");
        outLine("    if (m->ascii) {");
        outLine("        const char *found = strstr(s + start, needle);");
        outLine("        return found == NULL ? -1 : (int64_t)(found - s);");
        outLine("    }");
        outLine("    bool ok = false;");
        outLine("    size_t b = lt_utf8_byte_at(s, start, true, &ok);");
        outLine("    if (!ok) { return -1; }");
        outLine("    const char *found = strstr(s + b, needle);");
        outLine("    if (found == NULL) { return -1; }");
        outLine("    size_t target_b = (size_t)(found - s);");
        outLine("    int64_t cp = start;");
        outLine("    while (b < target_b) { b += lt_utf8_step(s, b); cp += 1; }");
        outLine("    return cp;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_join(") {
        outLine("static const char *lt_c_text_join(lt_list_str values, const char *sep) {");
        outLine("    if (values.len <= 0) { return \"\"; }");
        outLine("    if (values.len == 1) { return values.data[0]; }");
        outLine("    size_t sep_len = strlen(sep);");
        outLine("    size_t total = sep_len * (size_t)(values.len - 1);");
        outLine("    for (int64_t i = 0; i < values.len; i += 1) { total += strlen(values.data[i]); }");
        outLine("    char *out = malloc(total + 1u);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate joined text\\n\"); exit(1); }");
        outLine("    size_t pos = 0u;");
        outLine("    for (int64_t i = 0; i < values.len; i += 1) {");
        outLine("        if (i > 0 && sep_len > 0u) { memcpy(out + pos, sep, sep_len); pos += sep_len; }");
        outLine("        size_t n = strlen(values.data[i]);");
        outLine("        if (n > 0u) { memcpy(out + pos, values.data[i], n); pos += n; }");
        outLine("    }");
        outLine("    out[pos] = '\\0';");
        outLine("    return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_to_int(") {
        t2iTag := frontend.cStructTag("(value:Int,ok:Bool)");
        outLine("static " + t2iTag + " lt_c_text_to_int(const char *s) {");
        outLine("    if (s[0] == '\\0') { return (" + t2iTag + "){ 0, false }; }");
        outLine("    size_t i = 0u;");
        outLine("    if (s[0] == '+' || s[0] == '-') { i = 1u; }");
        outLine("    if (s[i] == '\\0') { return (" + t2iTag + "){ 0, false }; }");
        outLine("    for (size_t j = i; s[j] != '\\0'; j += 1u) { if (s[j] < '0' || s[j] > '9') { return (" + t2iTag + "){ 0, false }; } }");
        outLine("    errno = 0; char *end = NULL;");
        outLine("    long long v = strtoll(s, &end, 10);");
        outLine("    if (errno == ERANGE || end == NULL || *end != '\\0') { return (" + t2iTag + "){ 0, false }; }");
        outLine("    return (" + t2iTag + "){ (int64_t)v, true };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_trim(") {
        outLine("static const char *lt_c_text_trim(const char *s, bool left, bool right) {");
        outLine("    size_t len = strlen(s); size_t a = 0u; size_t b = len;");
        outLine("    if (left) { while (a < b && (s[a] == ' ' || s[a] == '\\t' || s[a] == '\\r' || s[a] == '\\n')) { a += 1u; } }");
        outLine("    if (right) { while (b > a && (s[b - 1u] == ' ' || s[b - 1u] == '\\t' || s[b - 1u] == '\\r' || s[b - 1u] == '\\n')) { b -= 1u; } }");
        outLine("    if (a == 0u && b == len) { return s; }");
        outLine("    size_t n = b - a; char *out = malloc(n + 1u);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate trimmed text\\n\"); exit(1); }");
        outLine("    if (n > 0u) { memcpy(out, s + a, n); }");
        outLine("    out[n] = '\\0'; return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_ends_with(") {
        outLine("static bool lt_c_text_ends_with(const char *s, const char *suf) {");
        outLine("    size_t sl = strlen(s); size_t sufl = strlen(suf);");
        outLine("    return sufl <= sl && memcmp(s + (sl - sufl), suf, sufl) == 0;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_repeat(") {
        outLine("static const char *lt_c_text_repeat(const char *s, int64_t count) {");
        outLine("    if (count <= 0 || s[0] == '\\0') { return \"\"; }");
        outLine("    size_t sl = strlen(s); size_t total = sl * (size_t)count;");
        outLine("    char *out = malloc(total + 1u);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate repeated text\\n\"); exit(1); }");
        outLine("    for (int64_t i = 0; i < count; i += 1) { memcpy(out + (size_t)i * sl, s, sl); }");
        outLine("    out[total] = '\\0'; return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_text_contains(") {
        outLine("static bool lt_c_text_contains(const char *s, const char *needle) { return strstr(s, needle) != NULL; }");
    }
    if usesIntHelper(calls, "lt_c_text_to_lower(") {
        outLine("static const char *lt_c_text_to_lower(const char *s) {");
        outLine("    size_t n = strlen(s); char *out = malloc(n + 1u);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate lower text\\n\"); exit(1); }");
        outLine("    for (size_t i = 0u; i < n; i += 1u) { char c = s[i]; out[i] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c; }");
        outLine("    out[n] = '\\0'; return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_file_read_text(") {
        okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
        outLine("static " + okTextTag + " lt_c_file_read_text(const char *path) {");
        outLine("    int fd = open(path, O_RDONLY);");
        outLine("    if (fd < 0) { return (" + okTextTag + "){ false, \"\", lt_dup_str(strerror(errno)) }; }");
        outLine("    struct stat st;");
        outLine("    if (fstat(fd, &st) != 0) { const char *err = lt_dup_str(strerror(errno)); close(fd); return (" + okTextTag + "){ false, \"\", err }; }");
        outLine("    if (S_ISDIR(st.st_mode)) { close(fd); return (" + okTextTag + "){ false, \"\", \"EISDIR: illegal operation on a directory\" }; }");
        outLine("    size_t cap = st.st_size > 0 ? (size_t)st.st_size : 4096u;");
        outLine("    uint8_t *buf = malloc(cap + 1u);");
        outLine("    if (buf == NULL) { close(fd); return (" + okTextTag + "){ false, \"\", \"out of memory\" }; }");
        outLine("    size_t len = 0u;");
        outLine("    for (;;) {");
        outLine("        if (len >= cap) { cap = cap * 2u + 4096u; uint8_t *nb = realloc(buf, cap + 1u); if (nb == NULL) { free(buf); close(fd); return (" + okTextTag + "){ false, \"\", \"out of memory\" }; } buf = nb; }");
        outLine("        ssize_t n = read(fd, buf + len, cap - len);");
        outLine("        if (n < 0) { const char *err = lt_dup_str(strerror(errno)); free(buf); close(fd); return (" + okTextTag + "){ false, \"\", err }; }");
        outLine("        if (n == 0) { break; }");
        outLine("        len += (size_t)n;");
        outLine("    }");
        outLine("    close(fd);");
        outLine("    for (size_t i = 0u; i < len; ) {");
        outLine("        uint8_t b0 = buf[i];");
        outLine("        if (b0 < 0x80u) { i += 1u; }");
        outLine("        else if (b0 >= 0xC2u && b0 <= 0xDFu && i + 1u < len && (buf[i + 1u] & 0xC0u) == 0x80u) { i += 2u; }");
        outLine("        else if (b0 >= 0xE0u && b0 <= 0xEFu && i + 2u < len && (buf[i + 1u] & 0xC0u) == 0x80u && (buf[i + 2u] & 0xC0u) == 0x80u && !(b0 == 0xE0u && buf[i + 1u] < 0xA0u) && !(b0 == 0xEDu && buf[i + 1u] >= 0xA0u)) { i += 3u; }");
        outLine("        else if (b0 >= 0xF0u && b0 <= 0xF4u && i + 3u < len && (buf[i + 1u] & 0xC0u) == 0x80u && (buf[i + 2u] & 0xC0u) == 0x80u && (buf[i + 3u] & 0xC0u) == 0x80u && !(b0 == 0xF0u && buf[i + 1u] < 0x90u) && !(b0 == 0xF4u && buf[i + 1u] >= 0x90u)) { i += 4u; }");
        outLine("        else { free(buf); return (" + okTextTag + "){ false, \"\", \"invalid UTF-8 byte sequence\" }; }");
        outLine("    }");
        outLine("    buf[len] = 0u;");
        outLine("    return (" + okTextTag + "){ true, (const char *)buf, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_file_write_text(") or usesIntHelper(calls, "lt_c_file_append_text(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_file_put_text(const char *path, const char *text, int flags) {");
        outLine("    int fd = open(path, flags, 0666);");
        outLine("    if (fd < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    size_t len = strlen(text); size_t off = 0u;");
        outLine("    while (off < len) {");
        outLine("        ssize_t n = write(fd, text + off, len - off);");
        outLine("        if (n < 0) { const char *err = lt_dup_str(strerror(errno)); close(fd); return (" + okErrTag + "){ false, err }; }");
        outLine("        off += (size_t)n;");
        outLine("    }");
        outLine("    if (close(fd) < 0) { return (" + okErrTag + "){ false, lt_dup_str(strerror(errno)) }; }");
        outLine("    return (" + okErrTag + "){ true, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_file_write_text(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_file_write_text(const char *path, const char *text) { return lt_c_file_put_text(path, text, O_WRONLY | O_CREAT | O_TRUNC); }");
    }
    if usesIntHelper(calls, "lt_c_file_append_text(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_file_append_text(const char *path, const char *text) { return lt_c_file_put_text(path, text, O_WRONLY | O_CREAT | O_APPEND); }");
    }
};

pub emitProgramWithSpecsOpt := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, optLevel: Int): Unit {
    softItems := applyCSoftBuiltins(items, prefix, builtinSpecs);
    reachable := frontend.filterReachableItemsWithOpt(softItems, frontend.TARGET_C, optLevel);
    calls := frontend.targetHelperCalls(reachable);
    var floatOutput := false;
    var hasFunctions := false;
    var hasFnOutput := false;
    var hasUnreachable := false;
    floatLiterals := usesIntHelper(calls, "lt_float_literal(");
    float32Literals := usesIntHelper(calls, "lt_float32_literal(");
    var float32Values := float32Literals or usesIntHelper(calls, "lt_float32_op(");
    var floatValues := floatLiterals or float32Values or usesFloatArithmetic(calls);
    var fnRefTokens := frontend.emptyTokenBuckets();
    var fnDepth := 0;
    loop reachable as item {
        if frontend.isFloatScalarKind(item.kind) { floatOutput = true; }
        if frontend.isFloatScalarKind(item.kind) or item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isFloatScalarKind(item.name)) { floatValues = true; }
        if item.kind == frontend.VALUE_KIND_FLOAT32 or (item.kind == frontend.ITEM_KIND_DISCARD and item.name == frontend.VALUE_KIND_FLOAT32) { float32Values = true; }
        if item.kind == frontend.ITEM_KIND_UNREACHABLE { hasUnreachable = true; }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            hasFunctions = true;
            fnDepth = fnDepth + 1;
            checkCFunctionSignature(item);
            if frontend.isFloatScalarKind(item.code) { floatValues = true; }
            if item.code == frontend.VALUE_KIND_FLOAT32 { float32Values = true; }
            if textLib.indexOfText(item.textValue, "=Float", 0) >= 0 { floatValues = true; }
            if textLib.indexOfText(item.textValue, "=Float32", 0) >= 0 { float32Values = true; }
        } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
        } else if fnDepth > 0 {
            if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT { hasFnOutput = true; }
            fnRefTokens = frontend.codeReachableTokensSet(item.code, fnRefTokens);
            if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                fnRefTokens = frontend.tokenBucketAdd(fnRefTokens, item.runtime);
            }
        }
        unsupported := unsupportedBuiltinCode(frontend.targetCodeCalls(item.code, "|"));
        if unsupported =!= "" {
            diagLib.fail("", unsupported);
        }
        if (frontend.isTupleKind(item.kind) and frontend.cStructTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isTupleKind(item.name) and frontend.cStructTag(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_TUPLE or item.kind == frontend.ITEM_KIND_VAR_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE) and frontend.cStructTag(item.textValue) == "") {
            diagLib.fail("", "C backend does not support tuple values yet");
        }
        if (frontend.isMapKind(item.kind) and frontend.cMapTag(item.kind) == "") or
        (frontend.isMapKind(item.textValue) and frontend.cMapTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isMapKind(item.name) and frontend.cMapTag(item.name) == "") {
            diagLib.fail("", "C backend does not support map values yet");
        }
        if (frontend.isSetKind(item.kind) and frontend.cSetTag(item.kind) == "") or
        (frontend.isSetKind(item.textValue) and frontend.cSetTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isSetKind(item.name) and frontend.cSetTag(item.name) == "") {
            diagLib.fail("", "C backend does not support set values yet");
        }
        isUnsupportedRecordDecl := (item.kind == frontend.ITEM_KIND_LOCAL_RECORD or item.kind == frontend.ITEM_KIND_VAR_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD) and not frontend.isEnumKind(item.textValue) and frontend.cStructTag(item.textValue) == "" and frontend.cMapTag(item.textValue) == "" and frontend.cSetTag(item.textValue) == "";
        if (frontend.isRecordKind(item.kind) and frontend.cStructTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isRecordKind(item.name) and frontend.cStructTag(item.name) == "") or isUnsupportedRecordDecl {
            diagLib.fail("", "C backend does not support record values yet");
        }
        if (frontend.isListKind(item.kind) and cListTagForKind(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isListKind(item.name) and cListTagForKind(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_LIST or item.kind == frontend.ITEM_KIND_VAR_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_LIST) and cListTagForKind(item.textValue) == "") {
            diagLib.fail("", "C backend does not support list values yet");
        }
        if (frontend.isArrayKind(item.kind) and cListTagForKind(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isArrayKind(item.name) and cListTagForKind(item.name) == "") {
            diagLib.fail("", "C backend does not support array values yet");
        }
        if (frontend.isFnKind(item.kind) and frontend.cFnTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isFnKind(item.name) and frontend.cFnTag(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_FN or item.kind == frontend.ITEM_KIND_VAR_FN or item.kind == frontend.ITEM_KIND_ASSIGN_FN) and frontend.cFnTag(item.textValue) == "") {
            diagLib.fail("", "C backend does not support function values yet");
        }
        if item.kind == frontend.ITEM_KIND_LOOP_SEQ and frontend.cListTag(item.textValue) == "" {
            diagLib.fail("", "C backend does not support list traversal yet");
        }
        if frontend.codeUsesListIndex(item.code) or frontend.codeUsesListPop(item.code) or frontend.codeUsesListCopy(item.code) {
            diagLib.fail("", "C backend does not support list values yet");
        }
        aggErr := unsupportedAggregateCode(item.code);
        if aggErr =!= "" {
            diagLib.fail("", aggErr);
        }
    }
    hoistedFnKeys: mut List<String> = [];
    hoistedFnDefs: mut List<String> = [];
    loop reachable as item {
        extracted := extractCHoistedFns(item.code);
        loop extracted as entry {
            sepIdx := textLib.indexOfText(entry, "\n", 0);
            if sepIdx > 0 {
                eKey := textLib.slice(entry, 0, sepIdx);
                eBody := textLib.slice(entry, sepIdx + 1, textLib.length(entry));
                if not listLib.listContainsText(hoistedFnKeys, eKey) {
                    listLib.pushBack(mut hoistedFnKeys, eKey);
                    listLib.pushBack(mut hoistedFnDefs, eBody);
                }
            }
        }
    }
    hasHoistedFns := listLib.length(hoistedFnDefs) > 0;
    if hasHoistedFns {
        hasFunctions = true;
        loop hoistedFnDefs as hDef {
            fnRefTokens = frontend.codeReachableTokensSet(hDef, fnRefTokens);
        }
    }
    orderedEntries: mut List<String> = [];
    var seenTypeKeys := frontend.emptyTokenBuckets();
    var printTypeKeys := frontend.emptyTokenBuckets();
    var copyTypeKeys := frontend.emptyTokenBuckets();
    convExpKinds: mut List<String> = [];
    convActKinds: mut List<String> = [];
    var seenConvNames := frontend.emptyTokenBuckets();
    seedKinds: mut List<String> = [];
    hasInputArgs := usesIntHelper(calls, "lite$inputArgs(");
    hasMainArgs := hasInputArgs or usesIntHelper(calls, "lite$processEntryPath(") or usesIntHelper(calls, "lite$processExecPath(");
    if hasInputArgs or usesIntHelper(calls, "lite$fileListDir(") or usesIntHelper(calls, "lt_c_text_join(") or usesProcessSpawnBuiltins(calls) { listLib.pushBack(mut seedKinds, "List<String>"); }
    if usesIntHelper(calls, "lite$unicodeToCodePoints(") or usesIntHelper(calls, "lite$unicodeFromCodePoints(") or
    usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioWriterBytes(") or
    usesIntHelper(calls, "lite$ioRead(") or usesIntHelper(calls, "lite$ioWrite(") or
    usesIntHelper(calls, "lite$cryptoRandomBytes(") or usesIntHelper(calls, "lite$processRunBytes(") {
        listLib.pushBack(mut seedKinds, "List<Int>");
    }
    if usesIntHelper(calls, "lite$processRun(") { listLib.pushBack(mut seedKinds, "(status:Int,stdout:String,stderr:String,error:String)"); }
    if usesIntHelper(calls, "lite$processRunBytes(") { listLib.pushBack(mut seedKinds, "(status:Int,error:String)"); }
    if usesStreamBuiltins(calls) { listLib.pushBack(mut seedKinds, "(kind:String,handle:Int)"); }
    if usesIntHelper(calls, "lite$unicodeFromCodePoints(") or usesIntHelper(calls, "lite$ioWriterText(") or
    usesIntHelper(calls, "lt_c_file_read_text(") {
        listLib.pushBack(mut seedKinds, "(ok:Bool,text:String,error:String)");
    }
    if usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioFlush(") or
    usesIntHelper(calls, "lite$ioCloseWriter(") or usesIntHelper(calls, "lite$fileMakeDir(") or
    usesIntHelper(calls, "lite$fileRemove(") or usesIntHelper(calls, "lite$fileCopy(") or
    usesIntHelper(calls, "lite$fileSymlink(") or usesIntHelper(calls, "lt_c_file_write_text(") or
    usesIntHelper(calls, "lt_c_file_append_text(") {
        listLib.pushBack(mut seedKinds, "(ok:Bool,error:String)");
    }
    if usesIntHelper(calls, "lt_c_text_to_int(") { listLib.pushBack(mut seedKinds, "(value:Int,ok:Bool)"); }
    if usesIntHelper(calls, "lite$ioWrite(") { listLib.pushBack(mut seedKinds, "(ok:Bool,written:Int,error:String)"); }
    if usesIntHelper(calls, "lite$fileRealPath(") or usesIntHelper(calls, "lite$fileMakeTempDir(") {
        listLib.pushBack(mut seedKinds, "(ok:Bool,path:String,error:String)");
    }
    if usesIntHelper(calls, "lite$processEnvGet(") { listLib.pushBack(mut seedKinds, "(found:Bool,value:String)"); }
    loop reachable as item {
        if cListTagForKind(item.kind) =!= "" or frontend.cStructTag(item.kind) =!= "" or frontend.cMapTag(item.kind) =!= "" or frontend.cSetTag(item.kind) =!= "" {
            listLib.pushBack(mut seedKinds, item.kind);
            pFlags := collectTypeFlags(item.kind);
            loop pFlags as pf {
                if pf == "FLOAT" { floatOutput = true; floatValues = true; }
                else if pf == "FLOAT32" { float32Values = true; }
                else { printTypeKeys = frontend.tokenBucketAdd(printTypeKeys, pf); }
            }
        }
        if item.kind == frontend.ITEM_KIND_DISCARD and (cListTagForKind(item.name) =!= "" or frontend.cStructTag(item.name) =!= "" or frontend.cMapTag(item.name) =!= "" or frontend.cSetTag(item.name) =!= "") {
            listLib.pushBack(mut seedKinds, item.name);
        }
        if item.kind == frontend.ITEM_KIND_LOCAL_LIST or item.kind == frontend.ITEM_KIND_VAR_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_LIST or
        item.kind == frontend.ITEM_KIND_LOCAL_TUPLE or item.kind == frontend.ITEM_KIND_VAR_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE or
        item.kind == frontend.ITEM_KIND_LOCAL_RECORD or item.kind == frontend.ITEM_KIND_VAR_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD or
        item.kind == frontend.ITEM_KIND_LOCAL_FN or item.kind == frontend.ITEM_KIND_VAR_FN or item.kind == frontend.ITEM_KIND_ASSIGN_FN {
            if cListTagForKind(item.textValue) =!= "" or frontend.cStructTag(item.textValue) =!= "" or frontend.cMapTag(item.textValue) =!= "" or frontend.cSetTag(item.textValue) =!= "" or frontend.cFnTag(item.textValue) =!= "" {
                listLib.pushBack(mut seedKinds, item.textValue);
            }
        }
        if item.kind == frontend.ITEM_KIND_LOOP_SEQ and item.intValue < 2 and frontend.cListTag(item.textValue) =!= "" {
            seqListKind := "List<" + item.textValue + ">";
            listLib.pushBack(mut seedKinds, seqListKind);
            if item.intValue =!= 1 {
                cFlags := collectTypeFlags(seqListKind);
                loop cFlags as cf {
                    if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                }
            }
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ and item.intValue == 4 {
            annotsM := extractCTypeAnnotations(item.code);
            if listLib.length(annotsM) > 0 and textLib.startsWithAt(annotsM[0], 0, "T:") {
                mk := textLib.slice(annotsM[0], 2, textLib.length(annotsM[0]));
                cFlags := collectTypeFlags(mk);
                loop cFlags as cf {
                    if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                }
            }
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ and item.intValue == 5 {
            sk := "Set<" + item.textValue + ">";
            listLib.pushBack(mut seedKinds, sk);
            cFlags := collectTypeFlags(sk);
            loop cFlags as cf {
                if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
            }
        }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            if cListTagForKind(item.code) =!= "" or frontend.cStructTag(item.code) =!= "" or frontend.cMapTag(item.code) =!= "" or frontend.cSetTag(item.code) =!= "" {
                listLib.pushBack(mut seedKinds, item.code);
            }
            if item.textValue =!= "" {
                var pStart := 0;
                loop true {
                    pSep := textLib.indexOfText(item.textValue, "|", pStart);
                    pEnd := if pSep >= 0 { pSep } else { textLib.length(item.textValue) };
                    pEntry := textLib.slice(item.textValue, pStart, pEnd);
                    pEq := textLib.indexOfText(pEntry, "=", 0);
                    if pEq >= 0 {
                        rawPKind := textLib.slice(pEntry, pEq + 1, textLib.length(pEntry));
                        pKind := if textLib.startsWithAt(rawPKind, 0, "mut ") { textLib.slice(rawPKind, 4, textLib.length(rawPKind)) } else { rawPKind };
                        if cListTagForKind(pKind) =!= "" or frontend.cStructTag(pKind) =!= "" or frontend.cMapTag(pKind) =!= "" or frontend.cSetTag(pKind) =!= "" {
                            listLib.pushBack(mut seedKinds, pKind);
                        }
                    }
                    if pSep < 0 { break; }
                    pStart = pSep + 1;
                }
            }
        }
        annots := extractCTypeAnnotations(item.code);
        loop annots as ann {
            if textLib.startsWithAt(ann, 0, "T:") {
                listLib.pushBack(mut seedKinds, textLib.slice(ann, 2, textLib.length(ann)));
            } else if textLib.startsWithAt(ann, 0, "P:") {
                pk := textLib.slice(ann, 2, textLib.length(ann));
                listLib.pushBack(mut seedKinds, pk);
                pFlagsA := collectTypeFlags(pk);
                loop pFlagsA as pfA {
                    if pfA == "FLOAT" { floatOutput = true; floatValues = true; }
                    else if pfA == "FLOAT32" { float32Values = true; }
                    else { printTypeKeys = frontend.tokenBucketAdd(printTypeKeys, pfA); }
                }
            } else if textLib.startsWithAt(ann, 0, "C:") {
                body := textLib.slice(ann, 2, textLib.length(ann));
                bar := textLib.indexOfText(body, "|", 0);
                if bar > 0 {
                    eKind := textLib.slice(body, 0, bar);
                    aKind := textLib.slice(body, bar + 1, textLib.length(body));
                    listLib.pushBack(mut seedKinds, eKind);
                    listLib.pushBack(mut seedKinds, aKind);
                    cName := frontend.cTupleConvertName(eKind, aKind);
                    if not frontend.tokenBucketHas(seenConvNames, cName) {
                        seenConvNames = frontend.tokenBucketAdd(seenConvNames, cName);
                        listLib.pushBack(mut convExpKinds, eKind);
                        listLib.pushBack(mut convActKinds, aKind);
                        cFlags := collectTypeFlags(eKind);
                        loop cFlags as cf {
                            if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                        }
                    }
                }
            }
        }
    }
    if textLib.indexOfText(calls, "|lt_list_i64_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Int>"); }
    if textLib.indexOfText(calls, "|lt_list_f64_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Float>"); }
    if textLib.indexOfText(calls, "|lt_list_bool_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Bool>"); }
    if textLib.indexOfText(calls, "|lt_list_str_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<String>"); }
    var hasAnyList := false;
    loop seedKinds as sk {
        tFlags := collectTypeFlags(sk);
        loop tFlags as tf {
            if tf == "FLOAT" { floatValues = true; }
            else if tf == "FLOAT32" { float32Values = true; }
        }
        subs := collectSubKinds(sk);
        loop subs as sub {
            isL := textLib.startsWithAt(sub, 0, "L|");
            isM := textLib.startsWithAt(sub, 0, "M|");
            isE := textLib.startsWithAt(sub, 0, "E|");
            isF := textLib.startsWithAt(sub, 0, "F|");
            payload := textLib.slice(sub, 2, textLib.length(sub));
            tKey := if isL { "L:" + frontend.cListTag(payload) }
            else if isM { "M:" + frontend.cMapTag(payload) }
            else if isE { "E:" + frontend.cSetTag(payload) }
            else if isF { "F:" + frontend.cFnTag(payload) }
            else { "S:" + frontend.cStructTag(payload) };
            if not frontend.tokenBucketHas(seenTypeKeys, tKey) {
                seenTypeKeys = frontend.tokenBucketAdd(seenTypeKeys, tKey);
                listLib.pushBack(mut orderedEntries, sub);
                if isL or isM or isE { hasAnyList = true; }
            }
        }
    }
    extraListSeeds: mut List<String> = [];
    loop orderedEntries as oe {
        if textLib.startsWithAt(oe, 0, "S|") {
            sKind := textLib.slice(oe, 2, textLib.length(oe));
            sTag := frontend.cStructTag(sKind);
            if textLib.indexOfText(calls, "|lt_list_" + sTag + "_", 0) >= 0 and not frontend.tokenBucketHas(seenTypeKeys, "L:" + sTag) {
                seenTypeKeys = frontend.tokenBucketAdd(seenTypeKeys, "L:" + sTag);
                listLib.pushBack(mut extraListSeeds, "L|" + sKind);
                hasAnyList = true;
            }
            if usesIntHelper(calls, sTag + "_copy(") or usesIntHelper(calls, "lt_list_" + sTag + "_copy(") {
                cFlags := collectTypeFlags(sKind);
                loop cFlags as cf {
                    if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                }
            }
        }
    }
    loop extraListSeeds as el { listLib.pushBack(mut orderedEntries, el); }
    hasReportError := usesIntHelper(calls, "lite$reportError(");
    hasExit := usesIntHelper(calls, "lite$exit(");
    hasInput := usesInputHelpers(calls);
    hasInputInt := usesIntHelper(calls, "lite$inputInt(");
    hasInputFloat := usesIntHelper(calls, "lite$inputFloat(");
    hasPosixHost := usesPosixHost(calls);
    hasUnicodeHost := usesUnicodeBuiltins(calls);
    hasSoftBuiltins := usesCSoftBuiltins(calls);
    if hasPosixHost {
        outLine("#if defined(__APPLE__)");
        outLine("#define _DARWIN_C_SOURCE");
        outLine("#else");
        outLine("#define _XOPEN_SOURCE 700");
        outLine("#endif");
    }
    outLine("#include <stdio.h>");
    if usesIntDivision(calls) or usesStringConcat(calls) or usesIntArithmetic(calls) or floatValues or hasUnreachable or hasExit or usesTextPrimitives(calls) or hasInput or hasAnyList or hasPosixHost or hasUnicodeHost or hasSoftBuiltins or hasHoistedFns or usesIntHelper(calls, "calloc(") { outLine("#include <stdlib.h>"); }
    if hasInputInt or hasPosixHost or usesIntHelper(calls, "lt_c_text_to_int(") { outLine("#include <errno.h>"); }
    outLine("#include <inttypes.h>");
    outLine("#include <stdbool.h>");
    outLine("#include <string.h>");
    if hasPosixHost {
        outLine("#include <fcntl.h>");
        outLine("#include <unistd.h>");
        outLine("#include <sys/stat.h>");
        outLine("#include <dirent.h>");
    }
    if usesTimeBuiltins(calls) or usesProcessSpawnBuiltins(calls) { outLine("#include <time.h>"); }
    if usesProcessSpawnBuiltins(calls) {
        outLine("#include <signal.h>");
        outLine("#include <poll.h>");
        outLine("#include <sys/wait.h>");
    }
    if usesFloatArithmetic(calls) or hasInputFloat { outLine("#include <math.h>"); }
    if floatValues {
        outLine("#include <float.h>");
        outLine("_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024, \"Float requires binary64 double\");");
    }
    if float32Values {
        outLine("_Static_assert(FLT_RADIX == 2 && FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128, \"Float32 requires binary32 float\");");
    }
    if floatLiterals { outLine("static double lt_float_literal(const char *text) { return strtod(text, NULL); }"); }
    if float32Literals { outLine("static float lt_float32_literal(const char *text) { return strtof(text, NULL); }"); }
    if floatOutput { emitFloatOutputHelpers(); }
    if hasReportError { outLine("static void lt_report_error(const char *text) { fprintf(stderr, \"%s\\n\", text); }"); }
    if hasExit { outLine("static _Noreturn void lt_exit(int64_t status) { fflush(stdout); exit((int)status); }"); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesStringConcat(calls) or usesIntHelper(calls, "lite$textAt(") or usesIntHelper(calls, "lite$textSliceFrom(") or usesIntHelper(calls, "lt_c_int_text(") {
        outLine("static char *lt_str_alloc(size_t n) {");
        outLine("    static char *slab = NULL;");
        outLine("    static size_t pos = 0u, cap = 0u;");
        outLine("    if (n > 16384u) {");
        outLine("        char *p = malloc(n);");
        outLine("        if (p == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("        return p;");
        outLine("    }");
        outLine("    if (pos + n > cap) {");
        outLine("        cap = 65536u;");
        outLine("        slab = malloc(cap);");
        outLine("        if (slab == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("        pos = 0u;");
        outLine("    }");
        outLine("    char *p = slab + pos;");
        outLine("    pos += n;");
        outLine("    return p;");
        outLine("}");
    }
    if usesStringConcat(calls) { emitStringConcatHelper(); }
    emitTextPrimitiveHelpers(calls);
    emitInputHelpers(calls);
    loop orderedEntries as oe {
        isL := textLib.startsWithAt(oe, 0, "L|");
        isM := textLib.startsWithAt(oe, 0, "M|");
        isE := textLib.startsWithAt(oe, 0, "E|");
        isF := textLib.startsWithAt(oe, 0, "F|");
        payload := textLib.slice(oe, 2, textLib.length(oe));
        if isL {
            lTag := frontend.cListTag(payload);
            lNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "L:" + lTag);
            lNeedPrint := frontend.tokenBucketHas(printTypeKeys, "L:" + lTag);
            lNeedFrom := hasInputArgs and lTag == "str";
            emitCListTagHelpers(lTag, payload, calls, lNeedCopy, lNeedPrint, lNeedFrom);
        } else if isM {
            mTag := frontend.cMapTag(payload);
            mNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "M:" + mTag);
            mNeedPrint := frontend.tokenBucketHas(printTypeKeys, "M:" + mTag);
            emitCMapHelpers(payload, calls, mNeedCopy, mNeedPrint);
        } else if isE {
            eTag := frontend.cSetTag(payload);
            eNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "E:" + eTag);
            eNeedPrint := frontend.tokenBucketHas(printTypeKeys, "E:" + eTag);
            emitCSetHelpers(payload, calls, eNeedCopy, eNeedPrint);
        } else if isF {
            emitCFnTypeHelper(payload, calls);
        } else {
            sTag := frontend.cStructTag(payload);
            sNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "S:" + sTag);
            sNeedPrint := frontend.tokenBucketHas(printTypeKeys, "S:" + sTag);
            emitCStructHelpers(payload, sNeedCopy, sNeedPrint);
        }
    }
    var convIdx := 0;
    convCount := listLib.length(convExpKinds);
    loop convIdx < convCount {
        emitCTupleConvHelper(convExpKinds[convIdx], convActKinds[convIdx]);
        convIdx = convIdx + 1;
    }
    if hasMainArgs {
        outLine("static int lt_argc = 0;");
        outLine("static char **lt_argv = NULL;");
    }
    if hasInputArgs {
        outLine("static lt_list_str lt_input_args(void) {");
        outLine("    if (lt_argc <= 1) { return lt_list_str_from(0, NULL); }");
        outLine("    return lt_list_str_from((int64_t)(lt_argc - 1), (const char *const *)(lt_argv + 1));");
        outLine("}");
        outLine("");
    }
    emitCHostBuiltinHelpers(calls);
    emitCSoftBuiltinHelpers(calls);
    var hoistedGlobals := frontend.emptyTokenBuckets();
    if hasFunctions {
        if hasFnOutput { outLine("static int lt_io_status = 0;"); }
        var scanDepth := 0;
        var scanBlocks := 0;
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                scanDepth = scanDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                if scanDepth > 0 { scanDepth = scanDepth - 1; }
            } else if scanDepth == 0 {
                if item.kind == frontend.ITEM_KIND_SCOPE or item.kind == frontend.ITEM_KIND_IF or item.kind == frontend.ITEM_KIND_LOOP or item.kind == frontend.ITEM_KIND_LOOP_SEQ {
                    scanBlocks = scanBlocks + 1;
                } else if item.kind == frontend.ITEM_KIND_END_SCOPE or item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_LOOP {
                    if scanBlocks > 0 { scanBlocks = scanBlocks - 1; }
                } else if scanBlocks == 0 and isCLocalDeclKind(item.kind) and frontend.tokenBucketHas(fnRefTokens, item.runtime) and
                not frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                    hoistedGlobals = frontend.tokenBucketAdd(hoistedGlobals, item.runtime);
                    outLine("static " + cDeclTypeItem(item) + item.runtime + ";");
                }
            }
        }
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                outLine("static " + cScalarType(item.code) + " " + item.runtime + "(" + cParameterList(item.textValue) + ");");
            }
        }
        loop hoistedFnDefs as hDef {
            outLine(injectCFnTemps(normalizeCBuiltinCalls(hDef)));
        }
        outLine("");
        var totalItems := 0;
        loop reachable { totalItems = totalItems + 1; }
        var fnIdx := 0;
        loop fnIdx < totalItems {
            if reachable[fnIdx].kind == frontend.ITEM_KIND_FUNCTION_START {
                fnIdx = emitOneCFunction(reachable, fnIdx, totalItems, hoistedGlobals);
            } else {
                fnIdx = fnIdx + 1;
            }
        }
    }
    mainItems: mut frontend.Items = [];
    if hasFunctions {
        var mDepth := 0;
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START { mDepth = mDepth + 1; }
            else if item.kind == frontend.ITEM_KIND_FUNCTION_END { if mDepth > 0 { mDepth = mDepth - 1; } }
            else if mDepth == 0 { listLib.pushBack(mut mainItems, item); }
        }
    } else {
        loop reachable as item { listLib.pushBack(mut mainItems, item); }
    }
    if hasMainArgs {
        outLine("int main(int argc, char **argv) {");
        outLine("    lt_argc = argc; lt_argv = argv;");
    } else {
        outLine("int main(void) {");
    }
    outLine("    int status = 0;");
    emitArithmeticTemporaries(mainItems);
    emitCItemStream(mainItems, hoistedGlobals, "", "status = 1;");
    if hasFnOutput {
        outLine("    return status ? status : lt_io_status;");
    } else {
        outLine("    return status;");
    }
    outLine("}");
}

/** Emits the C program to an explicit `io.Writer` with `--builtin-mode` specifications and optimization level (`0..3`). */
pub emitProgramToOpt := fn(writer: io.Writer, items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, optLevel: Int): Unit {
    cOutUseWriter = true;
    tb.clear(mut cOutBuf);
    emitProgramWithSpecsOpt(items, source, prefix, builtinSpecs, optLevel);
    _res := io.writeText(writer, tb.build(cOutBuf));
    tb.clear(mut cOutBuf);
    cOutUseWriter = false;
};

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications at default `-O1`. */
pub emitProgramWithSpecs := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>): Unit {
    emitProgramWithSpecsOpt(items, source, prefix, builtinSpecs, 1);
}

/** Emits the C program from the flat item stream using default builtin modes. */
pub emitProgram := fn(items: frontend.Items, source: String, prefix: String): Unit {
    emptySpecs: List<String> = [];
    emitProgramWithSpecsOpt(items, source, prefix, emptySpecs, 1);
}
