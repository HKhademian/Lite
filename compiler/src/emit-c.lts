        io.outputLine("    if (max_bytes <= 0) { return empty; }");
        io.outputLine("    if (strcmp(reader." + fKind + ", \"stdin\") == 0 && reader." + fHandle + " == 0) {");
        io.outputLine("        if (lt_stdin_err[0] != '\\0' || lt_stdin_eof) { return empty; }");
        io.outputLine("        size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        io.outputLine("        uint8_t *tmp = malloc(cap);");
        io.outputLine("        if (tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate read buffer\\n\"); exit(1); }");
        io.outputLine("        ssize_t n = read(0, tmp, cap);");
        io.outputLine("        if (n < 0) { lt_stdin_err = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        io.outputLine("        if (n == 0) { lt_stdin_eof = true; free(tmp); return empty; }");
