            cursor = cursor + textLib.length("lite$processRunBytes(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$cryptoRandomBytes(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_crypto_random_bytes(";
            cursor = cursor + textLib.length("lite$cryptoRandomBytes(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$timeMonotonicNs(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_time_monotonic_ns(";
            cursor = cursor + textLib.length("lite$timeMonotonicNs(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$timeEpochNs(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_time_epoch_ns(";
            cursor = cursor + textLib.length("lite$timeEpochNs(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$timeSleepMs(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_time_sleep_ms(";
            cursor = cursor + textLib.length("lite$timeSleepMs(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$timeLocalDate(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_time_local_date(";
            cursor = cursor + textLib.length("lite$timeLocalDate(");
            flushed = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { code } else { out + textLib.slice(code, flushed, size) }
};

/** Builds one checked printf call for an Int*, Float*, String, Bool, Unit or Never report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    match {
        kind == frontend.VALUE_KIND_NEVER { "((void)(" + code + "), 0)" }
        kind == frontend.VALUE_KIND_UNIT {
            if code == "0" { "printf(\"Unit\")" } else { "((void)(" + code + "), printf(\"Unit\"))" }
        }
        frontend.isEnumKind(kind) {
            dName := frontend.enumDisplayName(kind);
            cCount := frontend.enumCaseCount(kind);
            labels: mut List<String> = [];
            var ci := 0;
            loop ci < cCount {
                listLib.pushBack(mut labels, cLiteral.textLiteralCode(dName + "." + frontend.enumCaseNameAt(kind, ci)));
                ci = ci + 1;
            }
            "printf(\"%s\", ((const char *const[]){" + textLib.joinTexts(labels, ", ") + "}[" + code + "]))"
        }
        frontend.isFloatScalarKind(kind) { "lt_print_float((double)(" + code + "))" }
        cListTagForKind(kind) =!= "" { "lt_list_" + cListTagForKind(kind) + "_print(" + code + ")" }
        frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) + "_print(" + code + ")" }
        frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) + "_print(" + code + ")" }
        frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) + "_print(" + code + ")" }
        frontend.isIntScalarKind(kind) { "printf(\"%\" PRId64, (int64_t)(" + code + "))" }
        kind == frontend.VALUE_KIND_BOOL { "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))" }
        _ { "printf(\"%s\", " + code + ")" }
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    textLib.indexOfText(calls, "|" + name + "|", 0) >= 0
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: String): String {
    match {
        usesIntHelper(calls, "lite$extTsStripTypes(") or usesIntHelper(calls, "lite$extHttpFetchToFile(") or
        usesIntHelper(calls, "lite$extHttpServeStatic(") or usesIntHelper(calls, "lite$extBenchMeasureCompiler(") or
        usesIntHelper(calls, "lite$extPoolCpuCount(") or usesIntHelper(calls, "lite$extPoolRunJson(") {
            "C backend does not support external host builtins yet"
        }
        _ { "" }
    }
};

/** True when any emitted item calls a `core/time` builtin. */
usesTimeBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$timeMonotonicNs(") or usesIntHelper(calls, "lite$timeEpochNs(") or
    usesIntHelper(calls, "lite$timeSleepMs(") or usesIntHelper(calls, "lite$timeLocalDate(")
};

/** True when any emitted item calls a `core/process` child-spawn builtin. */
usesProcessSpawnBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$processRun(") or usesIntHelper(calls, "lite$processRunBytes(")
};

/** True when any emitted item calls a core/unicode hard builtin. */
usesUnicodeBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$unicodeToCodePoints(") or usesIntHelper(calls, "lite$unicodeFromCodePoints(")
};

/** True when any emitted item calls a core/io stream or core/file stream opener builtin. */
usesStreamBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or
    usesIntHelper(calls, "lite$fileOpenAppender(") or usesIntHelper(calls, "lite$ioStdinReader(") or
    usesIntHelper(calls, "lite$ioStdoutWriter(") or usesIntHelper(calls, "lite$ioStderrWriter(") or
    usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(") or
    usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
    usesIntHelper(calls, "lite$ioClearWriter(") or usesIntHelper(calls, "lite$ioReaderOk(") or
    usesIntHelper(calls, "lite$ioReaderAtEof(") or usesIntHelper(calls, "lite$ioReaderError(") or
    usesIntHelper(calls, "lite$ioRead(") or usesIntHelper(calls, "lite$ioCloseReader(") or
    usesIntHelper(calls, "lite$ioWriterOk(") or usesIntHelper(calls, "lite$ioWriterError(") or
    usesIntHelper(calls, "lite$ioWrite(") or usesIntHelper(calls, "lite$ioFlush(") or
    usesIntHelper(calls, "lite$ioCloseWriter(")
};

/** True when any emitted item calls a core/file non-stream filesystem builtin. */
usesFileBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$fileKind(") or usesIntHelper(calls, "lite$fileListDir(") or
    usesIntHelper(calls, "lite$fileMakeDir(") or usesIntHelper(calls, "lite$fileRemove(") or
    usesIntHelper(calls, "lite$fileCopy(") or usesIntHelper(calls, "lite$fileSymlink(") or
    usesIntHelper(calls, "lite$fileRealPath(") or usesIntHelper(calls, "lite$fileMakeTempDir(")
};

/** True when any emitted item calls a core/process query builtin. */
usesProcessQueryBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$processCwd(") or usesIntHelper(calls, "lite$processExecPath(") or
    usesIntHelper(calls, "lite$processEntryPath(") or usesIntHelper(calls, "lite$processPlatform(") or
    usesIntHelper(calls, "lite$processArch(") or usesIntHelper(calls, "lite$processRuntimeVersion(") or
    usesIntHelper(calls, "lite$processEnvGet(")
};

/** True when any emitted item calls a C11 soft-builtin text helper that needs `lt_utf8_get_meta`/`lt_utf8_byte_at`. */
usesCTextSoftUtf8 := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_c_text_skip_while(") or usesIntHelper(calls, "lt_c_text_index_of(") or
    usesIntHelper(calls, "lt_c_text_starts_with_at(") or usesIntHelper(calls, "lt_c_text_word_at(")
};

/** True when any emitted item calls a C11 soft-builtin file/crypto-file helper that needs POSIX headers. */
usesCFileSoft := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_c_file_read_text(") or usesIntHelper(calls, "lt_c_file_write_text(") or
    usesIntHelper(calls, "lt_c_file_append_text(") or usesIntHelper(calls, "lt_c_sha256_file(")
};

/** True when any emitted item calls any C11 soft-builtin fast-path helper. */
usesCSoftBuiltins := fn(calls: String): Bool {
    usesCTextSoftUtf8(calls) or usesCFileSoft(calls) or
    usesIntHelper(calls, "lt_c_int_text(") or usesIntHelper(calls, "lt_c_text_join(") or
    usesIntHelper(calls, "lt_c_text_to_int(") or usesIntHelper(calls, "lt_c_text_trim(") or
    usesIntHelper(calls, "lt_c_text_ends_with(") or usesIntHelper(calls, "lt_c_text_repeat(") or
    usesIntHelper(calls, "lt_c_text_contains(") or usesIntHelper(calls, "lt_c_text_to_lower(") or
    usesIntHelper(calls, "lt_c_text_is_digit(") or usesIntHelper(calls, "lt_c_text_is_ascii_letter(") or
    usesIntHelper(calls, "lt_c_text_is_name_start(") or usesIntHelper(calls, "lt_c_text_is_name_continue(") or
    usesIntHelper(calls, "lt_c_text_is_whitespace(") or
    usesIntHelper(calls, "lt_c_sha256_text(") or usesIntHelper(calls, "lt_c_sha256_bytes(")
};

/** True when any emitted item needs POSIX OS headers (`unistd.h`, `fcntl.h`, `sys/stat.h`, `dirent.h`). */
usesPosixHost := fn(calls: String): Bool {
    usesStreamBuiltins(calls) or usesFileBuiltins(calls) or usesProcessQueryBuiltins(calls) or usesCFileSoft(calls) or
    usesProcessSpawnBuiltins(calls) or usesTimeBuiltins(calls) or usesIntHelper(calls, "lite$cryptoRandomBytes(")
};

/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program needs checked dynamic Int* arithmetic or narrow range guards. */
usesIntArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
    usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(") or
    usesIntHelper(calls, "lt_checked_narrow_int(")
}

/** True when binary64/binary32 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float32_op(") or usesIntHelper(calls, "lt_float_power(")
}

/** Emits checked binary64/binary32 operations; caller temporaries preserve left-to-right operand effects. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesIntHelper(calls, "lt_float_power(") {
        outLine("static double lt_float_power(double left, double right, size_t at) {");
        outLine("    if (left == 0 && right < 0) { lt_int_fault(at, \"zero cannot be raised to a negative power\"); }");
        outLine("    double value = pow(left, right);");
        outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        outLine("    return value;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_float32_op(") {
        outLine("static double lt_float32_op(double left, double right, int op, size_t at) {");
        outLine("    const float l = (float)left;");
        outLine("    const float r = (float)right;");
        outLine("    if (op == 3 && r == 0.0f) { lt_int_fault(at, \"division by zero\"); }");
        outLine("    float value = op == 0 ? l + r : op == 1 ? l - r : op == 2 ? l * r : l / r;");
        outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        outLine("    return (double)value;");
        outLine("}");
    }
    if not usesIntHelper(calls, "lt_float_op(") { return; }
    outLine("static double lt_float_op(double left, double right, int op, size_t at) {");
    outLine("    if (op == 3 && right == 0) { lt_int_fault(at, \"division by zero\"); }");
    outLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
    outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
    outLine("    return value;");
    outLine("}");
}

/** True when a program calls `core/text` UTF-8 scalar primitives. */
usesTextPrimitives := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
    usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(")
}

/** True when `calls` references any bounds-checked C11 list helper for `tag`. */
/** True when any list or map bounds helper is called in `calls`. */
usesAnyListBounds := fn(calls: String): Bool {
    if calls == "|" { return false; }
    size := textLib.length(calls);
    var start := 1;
    loop start < size {
        sep := textLib.indexOfText(calls, "|", start);
        end := if sep >= 0 { sep } else { size };
        tok := textLib.slice(calls, start, end);
        if textLib.startsWithAt(tok, 0, "lt_list_") and (
            textLib.endsWith(tok, "_at(") or textLib.endsWith(tok, "_set(") or
            textLib.endsWith(tok, "_pop_back(") or textLib.endsWith(tok, "_pop_front(") or
            textLib.endsWith(tok, "_slice(") or textLib.endsWith(tok, "_slice_from(")
        ) {
            return true;
        }
        if textLib.startsWithAt(tok, 0, "lt_map_") and textLib.endsWith(tok, "_at(") {
            return true;
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
    false
};

/** Emits portable ISO C11 typedef, optional deep copy, and optional print helper for one tuple or nominal record `kind`. */
emitCStructHelpers := fn(kind: String, needCopy: Bool, needPrint: Bool): Unit {
    tag := frontend.cStructTag(kind);
    isRec := frontend.isRecordKind(kind);
    count := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
    if count == 0 {
        outLine("typedef struct { int _empty; } " + tag + ";");
    } else {
        var fields := "";
        var i := 0;
        loop i < count {
            comp := if isRec { frontend.recordComponent(kind, i) } else { frontend.tupleComponent(kind, i) };
            fields = fields + cScalarType(comp.kind) + " " + frontend.cFieldName(comp.prop) + "; ";
            i = i + 1;
        }
        outLine("typedef struct { " + fields + "} " + tag + ";");
    }
    if needCopy and frontend.cTypeHasListField(kind) {
        outLine("static " + tag + " " + tag + "_copy(" + tag + " src) {");
        if count == 0 {
            outLine("    return src;");
        } else {
            var inits := "";
            var ci := 0;
            loop ci < count {
                comp := if isRec { frontend.recordComponent(kind, ci) } else { frontend.tupleComponent(kind, ci) };
                if ci > 0 { inits = inits + ", "; }
                fnm := frontend.cFieldName(comp.prop);
                fVal := if cListTagForKind(comp.kind) =!= "" {
                    "lt_list_" + cListTagForKind(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cMapTag(comp.kind) =!= "" {
                    frontend.cMapTag(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cSetTag(comp.kind) =!= "" {
                    frontend.cSetTag(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cStructTag(comp.kind) =!= "" and frontend.cTypeHasListField(comp.kind) {
                    frontend.cStructTag(comp.kind) + "_copy(src." + fnm + ")"
                } else {
                    "src." + fnm
                };
                inits = inits + "." + fnm + " = " + fVal;
                ci = ci + 1;
            }
            outLine("    return (" + tag + "){ " + inits + " };");
        }
        outLine("}");
    }
    if needPrint {
        outLine("static int " + tag + "_print(" + tag + " v) {");
        if isRec {
            recName := frontend.recordDisplayName(kind);
            if count == 0 {
                outLine("    (void)v;");
                outLine("    return printf(\"%s\", " + cLiteral.textLiteralCode(recName + " {}") + ");");
            } else {
                outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(recName + " { ") + ") < 0) { return -1; }");
                var pi := 0;
                loop pi < count {
                    comp := frontend.recordComponent(kind, pi);
                    sep := if pi == 0 { "" } else { ", " };
                    outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(sep + comp.label + " = ") + ") < 0) { return -1; }");
                    outLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                    pi = pi + 1;
                }
                outLine("    return printf(\" }\");");
            }
        } else {
            outLine("    if (printf(\"(\") < 0) { return -1; }");
            var pi := 0;
            loop pi < count {
                comp := frontend.tupleComponent(kind, pi);
                sep := if pi == 0 { "" } else { ", " };
                prefixTxt := if comp.label == "" { sep } else { sep + comp.label + "=" };
                if prefixTxt =!= "" {
                    outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(prefixTxt) + ") < 0) { return -1; }");
                }
                outLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                pi = pi + 1;
            }
            if count == 0 { outLine("    (void)v;"); }
            ending := if count == 1 { ",)" } else { ")" };
            outLine("    return printf(" + cLiteral.textLiteralCode(ending) + ");");
        }
        outLine("}");
    }
    outLine("");
};

/** Emits one C11 tuple-label conversion helper converting `actualKind` to `expectedKind`. */
emitCTupleConvHelper := fn(expectedKind: String, actualKind: String): Unit {
    expTag := frontend.cStructTag(expectedKind);
    actTag := frontend.cStructTag(actualKind);
    fnName := frontend.cTupleConvertName(expectedKind, actualKind);
    count := frontend.tupleComponentCount(expectedKind);
    outLine("static " + expTag + " " + fnName + "(" + actTag + " v) {");
    if count == 0 {
        outLine("    (void)v; return (" + expTag + "){ ._empty = 0 };");
    } else {
        var inits := "";
        var i := 0;
        loop i < count {
            eComp := frontend.tupleComponent(expectedKind, i);
            aComp := frontend.tupleComponent(actualKind, i);
            if i > 0 { inits = inits + ", "; }
            aExpr := "v." + frontend.cFieldName(aComp.prop);
            fVal := if cListTagForKind(eComp.kind) =!= "" {
                "lt_list_" + cListTagForKind(eComp.kind) + "_copy(" + aExpr + ")"
            } else if frontend.cStructTag(eComp.kind) =!= "" and frontend.cTypeHasListField(eComp.kind) {
                frontend.cStructTag(eComp.kind) + "_copy(" + aExpr + ")"
            } else {
                aExpr
            };
            inits = inits + "." + frontend.cFieldName(eComp.prop) + " = " + fVal;
            i = i + 1;
        }
        outLine("    return (" + expTag + "){ " + inits + " };");
    }
    outLine("}");
    outLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Map<K, V>` struct and only the helpers used for `kind`. */
emitCMapHelpers := fn(kind: String, calls: String, needCopy: Bool, needPrint: Bool): Unit {
    kKind := frontend.mapKeyKind(kind);
    vKind := frontend.mapValueKind(kind);
    mTag := frontend.cMapTag(kind);
    kTag := frontend.cMapKeyTag(kKind);
    kType := cScalarType(kKind);
    vType := cScalarType(vKind);
    kEq := if kTag == "str" { "strcmp(a, b) == 0" } else { "a == b" };
    vCopy := if cListTagForKind(vKind) =!= "" { "lt_list_" + cListTagForKind(vKind) + "_copy(v)" }
    else if frontend.cMapTag(vKind) =!= "" { frontend.cMapTag(vKind) + "_copy(v)" }
    else if frontend.cSetTag(vKind) =!= "" { frontend.cSetTag(vKind) + "_copy(v)" }
    else if frontend.cStructTag(vKind) =!= "" and frontend.cTypeHasListField(vKind) { frontend.cStructTag(vKind) + "_copy(v)" }
    else { "v" };
    hasFrom := usesIntHelper(calls, mTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, mTag + "_copy(");
    hasSet := usesIntHelper(calls, mTag + "_set(");
    hasHas := usesIntHelper(calls, mTag + "_has(");
    hasAt := usesIntHelper(calls, mTag + "_at(");
    hasGet := usesIntHelper(calls, mTag + "_get(");
    hasGetOr := usesIntHelper(calls, mTag + "_get_or(");
    hasRemove := usesIntHelper(calls, mTag + "_remove(");
    hasClear := usesIntHelper(calls, mTag + "_clear(");
    hasKeys := usesIntHelper(calls, mTag + "_keys(");
    hasValues := usesIntHelper(calls, mTag + "_values(");
    outLine("typedef struct { " + kType + " key; " + vType + " val; } " + mTag + "_entry;");
    outLine("typedef struct { " + mTag + "_entry *data; int64_t len; int64_t cap; int64_t *idx; int64_t idx_cap; int64_t *rc; } " + mTag + ";");
    needFind := hasFrom or hasSet or hasHas or hasAt or hasGet or hasGetOr or hasRemove;
    needMut := hasFrom or hasSet or hasRemove;
    if needFind {
        outLine("static bool " + mTag + "_keq(" + kType + " a, " + kType + " b) { return " + kEq + "; }");
        outLine("static uint64_t " + mTag + "_hash(" + kType + " k) {");
        if kTag == "str" {
            outLine("    uint64_t h = UINT64_C(14695981039346656037);");
            outLine("    for (const unsigned char *p = (const unsigned char *)k; *p != 0; p += 1) { h ^= (uint64_t)(*p); h *= UINT64_C(1099511628211); }");
            outLine("    return h;");
        } else {
            outLine("    uint64_t x = (uint64_t)k;");
            outLine("    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);");
            outLine("    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);");
            outLine("    return x ^ (x >> 31);");
        }
        outLine("}");
        outLine("static int64_t " + mTag + "_find(" + mTag + " m, " + kType + " k) {");
        outLine("    if (m.len <= 0) { return -1; }");
        outLine("    if (m.idx != NULL && m.idx_cap > 0) {");
        outLine("        uint64_t mask = (uint64_t)(m.idx_cap - 1);");
        outLine("        uint64_t pos = " + mTag + "_hash(k) & mask;");
        outLine("        for (;;) {");
        outLine("            int64_t slot = m.idx[pos];");
        outLine("            if (slot == 0) { return -1; }");
        outLine("            if (slot > 0 && " + mTag + "_keq(m.data[slot - 1].key, k)) { return slot - 1; }");
        outLine("            pos = (pos + 1u) & mask;");
        outLine("        }");
        outLine("    }");
        outLine("    for (int64_t i = 0; i < m.len; i += 1) { if (" + mTag + "_keq(m.data[i].key, k)) { return i; } }");
        outLine("    return -1;");
        outLine("}");
    }
    if needMut {
        outLine("static void " + mTag + "_rehash(" + mTag + " *m, int64_t next_cap) {");
        outLine("    int64_t *nidx = calloc((size_t)next_cap, sizeof(int64_t));");
        outLine("    if (nidx == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate map index\\n\"); exit(1); }");
        outLine("    uint64_t mask = (uint64_t)(next_cap - 1);");
        outLine("    for (int64_t i = 0; i < m->len; i += 1) {");
        outLine("        uint64_t pos = " + mTag + "_hash(m->data[i].key) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = i + 1;");
        outLine("    }");
        outLine("    free(m->idx); m->idx = nidx; m->idx_cap = next_cap;");
        outLine("}");
        outLine("static void " + mTag + "_detach(" + mTag + " *m) {");
        outLine("    if (m->rc != NULL && *(m->rc) > 1) {");
        outLine("        *(m->rc) -= 1;");
        outLine("        int64_t ncap = m->len > 8 ? m->len : 8;");
        outLine("        " + mTag + "_entry *ndata = malloc((size_t)ncap * sizeof(" + mTag + "_entry));");
        outLine("        int64_t *nrc = malloc(sizeof(int64_t));");
        outLine("        if (ndata == NULL || nrc == NULL) { fprintf(stderr, \"MemoryFault: cannot detach map\\n\"); exit(1); }");
        outLine("        *nrc = 1;");
        if vCopy == "v" {
            outLine("        if (m->len > 0) { memcpy(ndata, m->data, (size_t)m->len * sizeof(" + mTag + "_entry)); }");
        } else {
            outLine("        for (int64_t i = 0; i < m->len; i += 1) { " + vType + " v = m->data[i].val; ndata[i].key = m->data[i].key; ndata[i].val = " + vCopy + "; }");
        }
        outLine("        m->data = ndata; m->cap = ncap; m->idx = NULL; m->idx_cap = 0; m->rc = nrc;");
        outLine("        if (m->len > 0) { int64_t ic = 16; while (ic < m->len * 2) { ic *= 2; } " + mTag + "_rehash(m, ic); }");
        outLine("    }");
        outLine("}");
    }
    if hasFrom or hasSet {
        outLine("static void " + mTag + "_set(" + mTag + " *m, " + kType + " k, " + vType + " v) {");
        outLine("    " + mTag + "_detach(m);");
        outLine("    int64_t idx = " + mTag + "_find(*m, k);");
        outLine("    if (idx >= 0) { m->data[idx].val = v; return; }");
        outLine("    if (m->len >= m->cap) {");
        outLine("        int64_t next = m->cap > 0 ? m->cap * 2 : 8;");
        outLine("        " + mTag + "_entry *buf = realloc(m->data, (size_t)next * sizeof(" + mTag + "_entry));");
        outLine("        if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow map\\n\"); exit(1); }");
        outLine("        if (m->rc == NULL) { m->rc = malloc(sizeof(int64_t)); if (m->rc == NULL) { fprintf(stderr, \"MemoryFault: cannot grow map\\n\"); exit(1); } *(m->rc) = 1; }");
        outLine("        m->data = buf; m->cap = next;");
        outLine("    }");
        outLine("    int64_t entry_idx = m->len;");
        outLine("    m->data[entry_idx].key = k; m->data[entry_idx].val = v; m->len += 1;");
        outLine("    if (m->idx == NULL || m->len * 2 > m->idx_cap) {");
        outLine("        int64_t ic = m->idx_cap > 0 ? m->idx_cap * 2 : 16;");
        outLine("        while (ic < m->len * 2) { ic *= 2; }");
        outLine("        " + mTag + "_rehash(m, ic);");
        outLine("    } else {");
        outLine("        uint64_t mask = (uint64_t)(m->idx_cap - 1);");
        outLine("        uint64_t pos = " + mTag + "_hash(k) & mask;");
        outLine("        while (m->idx[pos] > 0) { pos = (pos + 1u) & mask; }");
        outLine("        m->idx[pos] = entry_idx + 1;");
        outLine("    }");
        outLine("}");
    }
    if hasFrom {
        outLine("static " + mTag + " " + mTag + "_from(int64_t count, const " + mTag + "_entry *elems) {");
        outLine("    " + mTag + " out = { NULL, 0, 0, NULL, 0, NULL };");
        outLine("    for (int64_t i = 0; i < count; i += 1) { " + mTag + "_set(&out, elems[i].key, elems[i].val); }");
        outLine("    return out;");
        outLine("}");
    }
    if hasCopy {
        outLine("static " + mTag + " " + mTag + "_copy(" + mTag + " src) {");
        outLine("    if (src.len <= 0) { return (" + mTag + "){ NULL, 0, 0, NULL, 0, NULL }; }");
        outLine("    if (src.rc != NULL) { *(src.rc) += 1; return src; }");
        outLine("    " + mTag + " out = { NULL, src.len, src.len, NULL, 0, NULL };");
        outLine("    out.data = malloc((size_t)src.len * sizeof(" + mTag + "_entry));");
        outLine("    out.rc = malloc(sizeof(int64_t));");
        outLine("    if (out.data == NULL || out.rc == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate map\\n\"); exit(1); }");
        outLine("    *(out.rc) = 1;");
        if vCopy == "v" {
            outLine("    memcpy(out.data, src.data, (size_t)src.len * sizeof(" + mTag + "_entry));");
        } else {
            outLine("    for (int64_t i = 0; i < src.len; i += 1) { " + vType + " v = src.data[i].val; out.data[i].key = src.data[i].key; out.data[i].val = " + vCopy + "; }");
        }
        outLine("    return out;");
        outLine("}");
    }
    if hasHas {
        outLine("static bool " + mTag + "_has(" + mTag + " m, " + kType + " k) { return " + mTag + "_find(m, k) >= 0; }");
    }
    if hasAt {
        outLine("static " + vType + " " + mTag + "_at(" + mTag + " m, " + kType + " k, size_t at) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { lt_bound_fault(at, \"map key not found\"); }");
        outLine("    " + vType + " v = m.data[idx].val; return " + vCopy + ";");
        outLine("}");
    }
    if hasGet {
        resTag := frontend.cStructTag("(found:Bool,value:" + vKind + ")");
        outLine("static " + resTag + " " + mTag + "_get(" + mTag + " m, " + kType + " k, " + vType + " zero) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { return (" + resTag + "){ .f_found = false, .f_value = zero }; }");
        outLine("    " + vType + " v = m.data[idx].val; return (" + resTag + "){ .f_found = true, .f_value = " + vCopy + " };");
        outLine("}");
    }
    if hasGetOr {
        outLine("static " + vType + " " + mTag + "_get_or(" + mTag + " m, " + kType + " k, " + vType + " fb) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { return fb; }");
        outLine("    " + vType + " v = m.data[idx].val; return " + vCopy + ";");
        outLine("}");
    }
    if hasRemove {
        outLine("static bool " + mTag + "_remove(" + mTag + " *m, " + kType + " k) {");
        outLine("    int64_t idx = " + mTag + "_find(*m, k);");
        outLine("    if (idx < 0) { return false; }");
        outLine("    " + mTag + "_detach(m);");
        outLine("    if (idx + 1 < m->len) { memmove(m->data + idx, m->data + idx + 1, (size_t)(m->len - idx - 1) * sizeof(" + mTag + "_entry)); }");
        outLine("    m->len -= 1;");
        outLine("    if (m->idx_cap > 0) { " + mTag + "_rehash(m, m->idx_cap); }");
        outLine("    return true;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + mTag + "_clear(" + mTag + " *m) {");
        outLine("    if (m->rc != NULL && *(m->rc) > 1) { *(m->rc) -= 1; m->data = NULL; m->cap = 0; m->idx = NULL; m->idx_cap = 0; m->rc = NULL; }");
        outLine("    else if (m->idx != NULL && m->idx_cap > 0) { memset(m->idx, 0, (size_t)m->idx_cap * sizeof(int64_t)); }");
        outLine("    m->len = 0;");
        outLine("}");
    }
    if hasKeys {
        kListType := "lt_list_" + kTag;
        outLine("static " + kListType + " " + mTag + "_keys(" + mTag + " m) {");
        outLine("    " + kListType + " out = { NULL, m.len, m.len, NULL };");
        outLine("    if (m.len > 0) {");
        outLine("        out.data = malloc((size_t)m.len * sizeof(" + kType + "));");
        outLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        outLine("        for (int64_t i = 0; i < m.len; i += 1) { out.data[i] = m.data[i].key; }");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if hasValues {
        vListTag := frontend.cListTag(vKind);
        if vListTag =!= "" {
            vListType := "lt_list_" + vListTag;
            outLine("static " + vListType + " " + mTag + "_values(" + mTag + " m) {");
            outLine("    " + vListType + " out = { NULL, m.len, m.len, NULL };");
            outLine("    if (m.len > 0) {");
            outLine("        out.data = malloc((size_t)m.len * sizeof(" + vType + "));");
            outLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
            outLine("        for (int64_t i = 0; i < m.len; i += 1) { " + vType + " v = m.data[i].val; out.data[i] = " + vCopy + "; }");
            outLine("    }");
            outLine("    return out;");
            outLine("}");
        }
    }
    if needPrint {
        outLine("static int " + mTag + "_print(" + mTag + " m) {");
        outLine("    if (printf(\"{\") < 0) { return -1; }");
        outLine("    for (int64_t i = 0; i < m.len; i += 1) {");
        outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        outLine("        if (" + cCall(kKind, "m.data[i].key") + " < 0) { return -1; }");
        outLine("        if (printf(\": \") < 0) { return -1; }");
        outLine("        if (" + cCall(vKind, "m.data[i].val") + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"}\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Set<T>` struct and only the helpers used for `kind`. */
emitCSetHelpers := fn(kind: String, calls: String, needCopy: Bool, needPrint: Bool): Unit {
    eKind := frontend.setElementKind(kind);
    sTag := frontend.cSetTag(kind);
    kTag := frontend.cMapKeyTag(eKind);
    eType := cScalarType(eKind);
    eConstPtr := if kTag == "str" { "const char *const *" } else { "const " + eType + " *" };
    kEq := if kTag == "str" { "strcmp(a, b) == 0" } else { "a == b" };
    hasFrom := usesIntHelper(calls, sTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, sTag + "_copy(");
    hasAdd := usesIntHelper(calls, sTag + "_add(");
    hasHas := usesIntHelper(calls, sTag + "_has(");
    hasRemove := usesIntHelper(calls, sTag + "_remove(");
    hasClear := usesIntHelper(calls, sTag + "_clear(");
    hasValues := usesIntHelper(calls, sTag + "_values(");
    outLine("typedef struct { " + eType + " *data; int64_t len; int64_t cap; int64_t *idx; int64_t idx_cap; int64_t *rc; } " + sTag + ";");
    needFind := hasFrom or hasAdd or hasHas or hasRemove;
    needMut := hasFrom or hasAdd or hasRemove;
    if needFind {
        outLine("static bool " + sTag + "_eq(" + eType + " a, " + eType + " b) { return " + kEq + "; }");
        outLine("static uint64_t " + sTag + "_hash(" + eType + " k) {");
        if kTag == "str" {
            outLine("    uint64_t h = UINT64_C(14695981039346656037);");
            outLine("    for (const unsigned char *p = (const unsigned char *)k; *p != 0; p += 1) { h ^= (uint64_t)(*p); h *= UINT64_C(1099511628211); }");
            outLine("    return h;");
        } else {
            outLine("    uint64_t x = (uint64_t)k;");
            outLine("    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);");
            outLine("    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);");
            outLine("    return x ^ (x >> 31);");
        }
        outLine("}");
        outLine("static int64_t " + sTag + "_find(" + sTag + " s, " + eType + " v) {");
        outLine("    if (s.len <= 0) { return -1; }");
        outLine("    if (s.idx != NULL && s.idx_cap > 0) {");
        outLine("        uint64_t mask = (uint64_t)(s.idx_cap - 1);");
        outLine("        uint64_t pos = " + sTag + "_hash(v) & mask;");
        outLine("        for (;;) {");
        outLine("            int64_t slot = s.idx[pos];");
        outLine("            if (slot == 0) { return -1; }");
        outLine("            if (slot > 0 && " + sTag + "_eq(s.data[slot - 1], v)) { return slot - 1; }");
        outLine("            pos = (pos + 1u) & mask;");
        outLine("        }");
        outLine("    }");
        outLine("    for (int64_t i = 0; i < s.len; i += 1) { if (" + sTag + "_eq(s.data[i], v)) { return i; } }");
        outLine("    return -1;");
        outLine("}");
    }
    if needMut {
        outLine("static void " + sTag + "_rehash(" + sTag + " *s, int64_t next_cap) {");
        outLine("    int64_t *nidx = calloc((size_t)next_cap, sizeof(int64_t));");
        outLine("    if (nidx == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate set index\\n\"); exit(1); }");
        outLine("    uint64_t mask = (uint64_t)(next_cap - 1);");
        outLine("    for (int64_t i = 0; i < s->len; i += 1) {");
        outLine("        uint64_t pos = " + sTag + "_hash(s->data[i]) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = i + 1;");
        outLine("    }");
        outLine("    free(s->idx); s->idx = nidx; s->idx_cap = next_cap;");
        outLine("}");
        outLine("static void " + sTag + "_detach(" + sTag + " *s) {");
        outLine("    if (s->rc != NULL && *(s->rc) > 1) {");
        outLine("        *(s->rc) -= 1;");
        outLine("        int64_t ncap = s->len > 8 ? s->len : 8;");
        outLine("        " + eType + " *ndata = malloc((size_t)ncap * sizeof(" + eType + "));");
        outLine("        int64_t *nrc = malloc(sizeof(int64_t));");
        outLine("        if (ndata == NULL || nrc == NULL) { fprintf(stderr, \"MemoryFault: cannot detach set\\n\"); exit(1); }");
        outLine("        *nrc = 1;");
        outLine("        if (s->len > 0) { memcpy(ndata, s->data, (size_t)s->len * sizeof(" + eType + ")); }");
        outLine("        s->data = ndata; s->cap = ncap; s->idx = NULL; s->idx_cap = 0; s->rc = nrc;");
        outLine("        if (s->len > 0) { int64_t ic = 16; while (ic < s->len * 2) { ic *= 2; } " + sTag + "_rehash(s, ic); }");
        outLine("    }");
        outLine("}");
    }
    if hasFrom or hasAdd {
        outLine("static void " + sTag + "_add(" + sTag + " *s, " + eType + " v) {");
        outLine("    if (" + sTag + "_find(*s, v) >= 0) { return; }");
        outLine("    " + sTag + "_detach(s);");
        outLine("    if (s->len >= s->cap) {");
        outLine("        int64_t next = s->cap > 0 ? s->cap * 2 : 8;");
        outLine("        " + eType + " *buf = realloc(s->data, (size_t)next * sizeof(" + eType + "));");
        outLine("        if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow set\\n\"); exit(1); }");
        outLine("        if (s->rc == NULL) { s->rc = malloc(sizeof(int64_t)); if (s->rc == NULL) { fprintf(stderr, \"MemoryFault: cannot grow set\\n\"); exit(1); } *(s->rc) = 1; }");
        outLine("        s->data = buf; s->cap = next;");
        outLine("    }");
        outLine("    int64_t entry_idx = s->len;");
        outLine("    s->data[entry_idx] = v; s->len += 1;");
        outLine("    if (s->idx == NULL || s->len * 2 > s->idx_cap) {");
        outLine("        int64_t ic = s->idx_cap > 0 ? s->idx_cap * 2 : 16;");
        outLine("        while (ic < s->len * 2) { ic *= 2; }");
        outLine("        " + sTag + "_rehash(s, ic);");
        outLine("    } else {");
        outLine("        uint64_t mask = (uint64_t)(s->idx_cap - 1);");
        outLine("        uint64_t pos = " + sTag + "_hash(v) & mask;");
        outLine("        while (s->idx[pos] > 0) { pos = (pos + 1u) & mask; }");
        outLine("        s->idx[pos] = entry_idx + 1;");
        outLine("    }");
        outLine("}");
    }
    if hasFrom {
        outLine("static " + sTag + " " + sTag + "_from(int64_t count, " + eConstPtr + "elems) {");
        outLine("    " + sTag + " out = { NULL, 0, 0, NULL, 0, NULL };");
        outLine("    for (int64_t i = 0; i < count; i += 1) { " + sTag + "_add(&out, elems[i]); }");
        outLine("    return out;");
        outLine("}");
    }
    if hasCopy {
        outLine("static " + sTag + " " + sTag + "_copy(" + sTag + " src) {");
        outLine("    if (src.len <= 0) { return (" + sTag + "){ NULL, 0, 0, NULL, 0, NULL }; }");
        outLine("    if (src.rc != NULL) { *(src.rc) += 1; return src; }");
        outLine("    " + sTag + " out = { NULL, src.len, src.len, NULL, 0, NULL };");
        outLine("    out.data = malloc((size_t)src.len * sizeof(" + eType + "));");
        outLine("    out.rc = malloc(sizeof(int64_t));");
        outLine("    if (out.data == NULL || out.rc == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate set\\n\"); exit(1); }");
        outLine("    *(out.rc) = 1;");
        outLine("    memcpy(out.data, src.data, (size_t)src.len * sizeof(" + eType + "));");
        outLine("    return out;");
        outLine("}");
    }
    if hasHas {
        outLine("static bool " + sTag + "_has(" + sTag + " s, " + eType + " v) { return " + sTag + "_find(s, v) >= 0; }");
    }
    if hasRemove {
        outLine("static bool " + sTag + "_remove(" + sTag + " *s, " + eType + " v) {");
        outLine("    int64_t idx = " + sTag + "_find(*s, v);");
        outLine("    if (idx < 0) { return false; }");
        outLine("    " + sTag + "_detach(s);");
        outLine("    if (idx + 1 < s->len) { memmove(s->data + idx, s->data + idx + 1, (size_t)(s->len - idx - 1) * sizeof(" + eType + ")); }");
        outLine("    s->len -= 1;");
        outLine("    if (s->idx_cap > 0) { " + sTag + "_rehash(s, s->idx_cap); }");
        outLine("    return true;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + sTag + "_clear(" + sTag + " *s) {");
        outLine("    if (s->rc != NULL && *(s->rc) > 1) { *(s->rc) -= 1; s->data = NULL; s->cap = 0; s->idx = NULL; s->idx_cap = 0; s->rc = NULL; }");
        outLine("    else if (s->idx != NULL && s->idx_cap > 0) { memset(s->idx, 0, (size_t)s->idx_cap * sizeof(int64_t)); }");
        outLine("    s->len = 0;");
        outLine("}");
    }
    if hasValues {
        vListType := "lt_list_" + kTag;
        outLine("static " + vListType + " " + sTag + "_values(" + sTag + " s) {");
        outLine("    " + vListType + " out = { NULL, s.len, s.len, NULL };");
        outLine("    if (s.len > 0) {");
        outLine("        out.data = malloc((size_t)s.len * sizeof(" + eType + "));");
        outLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        outLine("        memcpy(out.data, s.data, (size_t)s.len * sizeof(" + eType + "));");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + sTag + "_print(" + sTag + " s) {");
        outLine("    if (printf(\"{\") < 0) { return -1; }");
        outLine("    for (int64_t i = 0; i < s.len; i += 1) {");
        outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        outLine("        if (" + cCall(eKind, "s.data[i]") + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"}\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 list struct and only the helper operations used for `tag` (`i64`, `f64`, `bool`, `str`, or `lt_s_...`). */
emitCListTagHelpers := fn(tag: String, elemKind: String, calls: String, needCopy: Bool, needPrint: Bool, needFrom: Bool): Unit {
    cType := frontend.cListElemType(tag);
    cElemConstPtr := if tag == "str" { "const char *const *" } else { "const " + cType + " *" };
    lType := "lt_list_" + tag;
    elemNeedsDeepCopy := elemKind =!= "" and frontend.cStructTag(elemKind) =!= "" and frontend.cTypeHasListField(elemKind);
    hasFrom := needFrom or usesIntHelper(calls, lType + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, lType + "_copy(");
    hasAt := usesIntHelper(calls, lType + "_at(");
    hasSet := usesIntHelper(calls, lType + "_set(");
    hasPushBack := usesIntHelper(calls, lType + "_push_back(");
    hasPushFront := usesIntHelper(calls, lType + "_push_front(");
    hasPopBack := usesIntHelper(calls, lType + "_pop_back(");
    hasPopFront := usesIntHelper(calls, lType + "_pop_front(");
    hasSliceFrom := usesIntHelper(calls, lType + "_slice_from(");
    hasSlice := usesIntHelper(calls, lType + "_slice(") or hasSliceFrom;
    hasReverse := usesIntHelper(calls, lType + "_reverse(");
    hasClear := usesIntHelper(calls, lType + "_clear(");
    outLine("typedef struct { " + cType + " *data; int64_t len; int64_t cap; int64_t *rc; } " + lType + ";");
    hasMut := hasSet or hasPushBack or hasPushFront or hasPopBack or hasPopFront;
    if hasFrom or hasCopy or hasSlice or hasReverse {
        outLine("static " + lType + " " + lType + "_from(int64_t count, " + cElemConstPtr + "elems) {");
        outLine("    " + lType + " out = { NULL, count, count, NULL };");
        outLine("    if (count > 0) {");
        outLine("        out.data = malloc((size_t)count * sizeof(" + cType + "));");
        outLine("        out.rc = malloc(sizeof(int64_t));");
        outLine("        if (out.data == NULL || out.rc == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        outLine("        *(out.rc) = 1;");
        outLine("        memcpy(out.data, elems, (size_t)count * sizeof(" + cType + "));");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if hasCopy {
        outLine("static " + lType + " " + lType + "_copy(" + lType + " src) {");
        outLine("    if (src.len <= 0) { return (" + lType + "){ NULL, 0, 0, NULL }; }");
        outLine("    if (src.rc != NULL) { *(src.rc) += 1; return src; }");
        if elemNeedsDeepCopy {
            outLine("    " + lType + " out = " + lType + "_from(src.len, src.data);");
            outLine("    for (int64_t i = 0; i < out.len; i += 1) { out.data[i] = " + tag + "_copy(out.data[i]); }");
            outLine("    return out;");
        } else {
            outLine("    return " + lType + "_from(src.len, src.data);");
        }
        outLine("}");
    }
    if hasMut {
        outLine("static void " + lType + "_detach(" + lType + " *xs, int64_t min_cap) {");
        outLine("    if (xs->rc != NULL && *(xs->rc) > 1) {");
        outLine("        *(xs->rc) -= 1;");
        outLine("        int64_t ncap = xs->len > min_cap ? xs->len : min_cap;");
        outLine("        if (ncap < 8) { ncap = 8; }");
        outLine("        " + cType + " *buf = malloc((size_t)ncap * sizeof(" + cType + "));");
        outLine("        int64_t *nrc = malloc(sizeof(int64_t));");
        outLine("        if (buf == NULL || nrc == NULL) { fprintf(stderr, \"MemoryFault: cannot detach list\\n\"); exit(1); }");
        outLine("        *nrc = 1;");
        outLine("        if (xs->len > 0) {");
        outLine("            memcpy(buf, xs->data, (size_t)xs->len * sizeof(" + cType + "));");
        if elemNeedsDeepCopy {
            outLine("            for (int64_t i = 0; i < xs->len; i += 1) { buf[i] = " + tag + "_copy(buf[i]); }");
        }
        outLine("        }");
        outLine("        xs->data = buf; xs->cap = ncap; xs->rc = nrc;");
        outLine("    }");
        outLine("}");
    }
    if hasAt {
        outLine("static " + cType + " " + lType + "_at(" + lType + " xs, int64_t idx, size_t at) {");
        outLine("    if (idx < 0 || idx >= xs.len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        outLine("    return xs.data[idx];");
        outLine("}");
    }
    if hasSet {
        outLine("static void " + lType + "_set(" + lType + " *xs, int64_t idx, " + cType + " val, size_t at) {");
        outLine("    if (idx < 0 || idx >= xs->len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        outLine("    " + lType + "_detach(xs, xs->len);");
        outLine("    xs->data[idx] = val;");
        outLine("}");
    }
    if hasPushBack or hasPushFront {
        outLine("static void " + lType + "_grow(" + lType + " *xs, int64_t need) {");
        outLine("    " + lType + "_detach(xs, need);");
        outLine("    if (xs->cap >= need) { return; }");
        outLine("    int64_t next = xs->cap > 0 ? xs->cap * 2 : 8;");
        outLine("    while (next < need) { next *= 2; }");
        outLine("    " + cType + " *buf = realloc(xs->data, (size_t)next * sizeof(" + cType + "));");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow list\\n\"); exit(1); }");
        outLine("    if (xs->rc == NULL) { xs->rc = malloc(sizeof(int64_t)); if (xs->rc == NULL) { fprintf(stderr, \"MemoryFault: cannot grow list\\n\"); exit(1); } *(xs->rc) = 1; }");
        outLine("    xs->data = buf; xs->cap = next;");
        outLine("}");
    }
    if hasPushBack {
        outLine("static void " + lType + "_push_back(" + lType + " *xs, " + cType + " val) {");
        outLine("    " + lType + "_grow(xs, xs->len + 1);");
        outLine("    xs->data[xs->len++] = val;");
        outLine("}");
    }
    if hasPushFront {
        outLine("static void " + lType + "_push_front(" + lType + " *xs, " + cType + " val) {");
        outLine("    " + lType + "_grow(xs, xs->len + 1);");
        outLine("    if (xs->len > 0) { memmove(xs->data + 1, xs->data, (size_t)xs->len * sizeof(" + cType + ")); }");
        outLine("    xs->data[0] = val; xs->len += 1;");
        outLine("}");
    }
    if hasPopBack {
        outLine("static " + cType + " " + lType + "_pop_back(" + lType + " *xs, size_t at) {");
        outLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        outLine("    " + lType + "_detach(xs, xs->len);");
        outLine("    return xs->data[--xs->len];");
        outLine("}");
    }
    if hasPopFront {
        outLine("static " + cType + " " + lType + "_pop_front(" + lType + " *xs, size_t at) {");
        outLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        outLine("    " + lType + "_detach(xs, xs->len);");
        outLine("    " + cType + " head = xs->data[0];");
        outLine("    xs->len -= 1;");
        outLine("    if (xs->len > 0) { memmove(xs->data, xs->data + 1, (size_t)xs->len * sizeof(" + cType + ")); }");
        outLine("    return head;");
        outLine("}");
    }
    if hasSlice {
        outLine("static " + lType + " " + lType + "_slice(" + lType + " xs, int64_t start, int64_t end, size_t at) {");
        outLine("    if (start < 0 || end < start || end > xs.len) { lt_bound_fault(at, \"list slice bounds outside its extent\"); }");
        outLine("    return " + lType + "_from(end - start, xs.data + start);");
        outLine("}");
    }
    if hasSliceFrom {
        outLine("static " + lType + " " + lType + "_slice_from(" + lType + " xs, int64_t start, size_t at) {");
        outLine("    return " + lType + "_slice(xs, start, xs.len, at);");
        outLine("}");
    }
    if hasReverse {
        outLine("static " + lType + " " + lType + "_reverse(" + lType + " xs) {");
        outLine("    " + lType + " out = " + lType + "_from(xs.len, xs.data);");
        outLine("    for (int64_t i = 0; i < out.len / 2; i += 1) { " + cType + " t = out.data[i]; out.data[i] = out.data[out.len - 1 - i]; out.data[out.len - 1 - i] = t; }");
        outLine("    return out;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + lType + "_clear(" + lType + " *xs) {");
        outLine("    if (xs->rc != NULL && *(xs->rc) > 1) { *(xs->rc) -= 1; xs->data = NULL; xs->cap = 0; xs->rc = NULL; }");
        outLine("    xs->len = 0;");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + lType + "_print(" + lType + " xs) {");
        outLine("    if (printf(\"[\") < 0) { return -1; }");
        outLine("    for (int64_t i = 0; i < xs.len; i += 1) {");
        outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        elemPrint := if tag == "i64" { "printf(\"%\" PRId64, xs.data[i])" }
        else if tag == "f64" { "lt_print_float(xs.data[i])" }
        else if tag == "bool" { "printf(\"%s\", xs.data[i] ? \"true\" : \"false\")" }
        else if tag == "str" { "printf(\"%s\", xs.data[i])" }
        else { tag + "_print(xs.data[i])" };
        outLine("        if (" + elemPrint + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"]\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable C11 guards that reject overflow and bounds faults before evaluating operations. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    usesArith := usesIntArithmetic(calls) or usesIntDivision(calls) or usesFloatArithmetic(calls);
    usesBounds := usesIntHelper(calls, "lite$textAt(") or usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(") or
    usesAnyListBounds(calls);
    if not usesArith and not usesBounds { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    outLine("static const size_t lt_int_lines[] = {" + frontend.lineStartCodes(source) + "};");
    outLine("static const char *lt_int_source = " + cLiteral.textLiteralCode(namePrefix) + ";");
    if usesBounds {
        outLine("static _Noreturn void lt_fault(const char *category, size_t at, const char *message) {");
        outLine("    size_t line = 0;");
        outLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        outLine("    fprintf(stderr, \"%s%zu:%zu: %s: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, category, message);");
        outLine("    exit(1);");
        outLine("}");
        outLine("static _Noreturn void lt_bound_fault(size_t at, const char *message) { lt_fault(\"BoundPanic\", at, message); }");
        if usesArith {
            outLine("static _Noreturn void lt_int_fault(size_t at, const char *message) { lt_fault(\"ArithmeticPanic\", at, message); }");
        }
    } else {
        outLine("static _Noreturn void lt_int_fault(size_t at, const char *message) {");
        outLine("    size_t line = 0;");
        outLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        outLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
        outLine("    exit(1);");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_add(") {
        outLine("static int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        outLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    return left + right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        outLine("static int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        outLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    return left - right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        outLine("static int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        outLine("    if (left == 0 || right == 0) { return 0; }");
        outLine("    if (left > 0) {");
        outLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
        outLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    } else if (right > 0) {");
        outLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    return left * right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        outLine("static int64_t lt_checked_negate(int64_t value, size_t at) {");
        outLine("    if (value == INT64_MIN) { lt_int_fault(at, \"integer outside Int range\"); }");
        outLine("    return -value;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_narrow_int(") {
        outLine("static int64_t lt_checked_narrow_int(int64_t value, int bits, const char *name, size_t at) {");
        outLine("    const int64_t limit = INT64_C(1) << (bits - 1);");
        outLine("    if (value < -limit || value >= limit) {");
        outLine("        char message[64];");
        outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
        outLine("        lt_int_fault(at, message);");
        outLine("    }");
        outLine("    return value;");
        outLine("}");
    }
    outLine("");
}

/** Declares hygienic arithmetic/comparison temporaries at unique assignment sites, skipping quoted text and hoisted closure bodies. */
emitArithmeticTemporaries := fn(items: frontend.Items): Unit {
    seen: mut List<String> = [];
    loop items as item {
        var cursor := 0;
        loop cursor < textLib.length(item.code) {
            ch := textLib.at(item.code, cursor);
            if ch == "\"" {
                cursor = frontend.skipAliasString(item.code, cursor);
            } else if ch == "/" and textLib.startsWithAt(item.code, cursor, "/*@CFN_START:") {
                cursor = skipCFnBlock(item.code, cursor);
            } else if ch == "l" and (textLib.startsWithAt(item.code, cursor, "lt_arg_") or textLib.startsWithAt(item.code, cursor, "lt_cmp_")) {
                end := textLib.skipName(item.code, cursor);
                if textLib.startsWithAt(item.code, end, " = ") {
                    tName := textLib.slice(item.code, cursor, end);
                    if not listLib.listContainsText(seen, tName) {
                        listLib.pushBack(mut seen, tName);
                        tag := if textLib.startsWithAt(item.code, cursor, "lt_cmp_") or textLib.startsWithAt(item.code, cursor, "lt_arg_f_") { textLib.at(item.code, cursor + 7) } else { "i" };
                        typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                        else if tag == "f" { "double " } else { "int64_t " };
                        outLine("    " + typeCode + tName + ";");
                    }
                }
                cursor = end;
            } else { cursor = cursor + 1; }
        }
    }
}

/** Collects hygienic arithmetic/comparison temporary declarations for a single hoisted closure definition and injects them at its placeholder. */
injectCFnTemps := fn(code: String): String {
    marker := "/*@CFN_TEMPS@*/";
    mIdx := textLib.indexOfText(code, marker, 0);
    if mIdx < 0 { return code; }
    var decls := "";
    seen: mut List<String> = [];
    var cursor := 0;
    size := textLib.length(code);
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "l" and (textLib.startsWithAt(code, cursor, "lt_arg_") or textLib.startsWithAt(code, cursor, "lt_cmp_")) {
            end := textLib.skipName(code, cursor);
            if textLib.startsWithAt(code, end, " = ") {
                tName := textLib.slice(code, cursor, end);
                if not listLib.listContainsText(seen, tName) {
                    listLib.pushBack(mut seen, tName);
                    tag := if textLib.startsWithAt(code, cursor, "lt_cmp_") or textLib.startsWithAt(code, cursor, "lt_arg_f_") { textLib.at(code, cursor + 7) } else { "i" };
                    typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                    else if tag == "f" { "double " } else { "int64_t " };
                    decls = decls + typeCode + tName + "; ";
                }
            }
            cursor = end;
        } else { cursor = cursor + 1; }
    }
    textLib.slice(code, 0, mIdx) + decls + textLib.slice(code, mIdx + textLib.length(marker), size)
};

/** Emits shortest round-trip binary64 display with decimal/exponent thresholds shared by the TS runtime; source remains statically checked and no locale is selected by generated programs. */
emitFloatOutputHelpers := fn(): Unit {
    outLine("/* Split printf's positive finite decimal into significant digits and its first-digit exponent. */");
    outLine("static int lt_float_digits(const char *text, char *digits, int *exponent) {");
    outLine("    int size = 0, before = 0, dot = 0;");
    outLine("    const char *at = text;");
    outLine("    while (*at && *at != 'e' && *at != 'E') {");
    outLine("        if (*at == '.') dot = 1;");
    outLine("        else { digits[size++] = *at; if (!dot) before++; }");
    outLine("        at++;");
    outLine("    }");
    outLine("    int power = *at ? (int)strtol(at + 1, NULL, 10) : 0;");
    outLine("    int leading = 0;");
    outLine("    while (leading + 1 < size && digits[leading] == '0') leading++;");
    outLine("    memmove(digits, digits + leading, (size_t)(size - leading));");
    outLine("    size -= leading;");
    outLine("    digits[size] = '\\0';");
    outLine("    *exponent = before - leading - 1 + power;");
    outLine("    return size;");
    outLine("}");
    outLine("/* Move to the adjacent positive decimal having at most precision significant digits. */");
    outLine("static void lt_float_neighbor(char *digits, int precision, int *exponent, int direction) {");
    outLine("    int at = precision - 1;");
    outLine("    if (direction > 0) {");
    outLine("        while (at >= 0 && digits[at] == '9') digits[at--] = '0';");
    outLine("        if (at >= 0) digits[at]++;");
    outLine("        else { digits[0] = '1'; (*exponent)++; }");
    outLine("    } else {");
    outLine("        while (at >= 0 && digits[at] == '0') digits[at--] = '9';");
    outLine("        if (at >= 0) digits[at]--;");
    outLine("        if (digits[0] == '0') {");
    outLine("            for (int i = 0; i < precision; i++) digits[i] = '9';");
    outLine("            (*exponent)--;");
    outLine("        }");
    outLine("    }");
    outLine("}");
    outLine("/* Find the least significant-digit count that round-trips, including asymmetric boundary candidates. */");
    outLine("static int lt_float_format(double value, char *out) {");
    outLine("    if (value == 0.0) { strcpy(out, \"0\"); return 1; }");
    outLine("    int negative = value < 0.0;");
    outLine("    double positive = negative ? -value : value;");
    outLine("    char digits[32], nearest[64], adjacent[64];");
    outLine("    int size = 0, exponent = 0, found = 0;");
    outLine("    for (int precision = 1; precision <= 17 && !found; precision++) {");
    outLine("        if (snprintf(nearest, sizeof nearest, \"%.*g\", precision, positive) < 0) return 0;");
    outLine("        size = lt_float_digits(nearest, digits, &exponent);");
    outLine("        if (strtod(nearest, NULL) == positive) { found = 1; break; }");
    outLine("        while (size < precision) digits[size++] = '0';");
    outLine("        digits[size] = '\\0';");
    outLine("        for (int direction = -1; direction <= 1 && !found; direction += 2) {");
    outLine("            char candidate[32]; memcpy(candidate, digits, (size_t)size + 1);");
    outLine("            int power = exponent;");
    outLine("            lt_float_neighbor(candidate, precision, &power, direction);");
    outLine("            if (snprintf(adjacent, sizeof adjacent, \"%se%d\", candidate, power - precision + 1) < 0) return 0;");
    outLine("            if (strtod(adjacent, NULL) == positive) {");
    outLine("                memcpy(digits, candidate, (size_t)size + 1); exponent = power; found = 1;");
    outLine("            }");
    outLine("        }");
    outLine("    }");
    outLine("    if (!found) return 0;");
    outLine("    while (size > 1 && digits[size - 1] == '0') size--;");
    outLine("    int at = 0;");
    outLine("    if (negative) out[at++] = '-';");
    outLine("    if (exponent >= 21 || exponent < -6) {");
    outLine("        out[at++] = digits[0];");
    outLine("        if (size > 1) { out[at++] = '.'; memcpy(out + at, digits + 1, (size_t)size - 1); at += size - 1; }");
    outLine("        out[at++] = 'e';");
    outLine("        if (exponent >= 0) out[at++] = '+';");
    outLine("        int length = snprintf(out + at, 64u - (size_t)at, \"%d\", exponent);");
    outLine("        if (length < 0) return 0;");
    outLine("        at += length;");
    outLine("    } else if (exponent < 0) {");
    outLine("        out[at++] = '0'; out[at++] = '.';");
    outLine("        for (int i = -1; i > exponent; i--) out[at++] = '0';");
    outLine("        memcpy(out + at, digits, (size_t)size); at += size;");
    outLine("    } else {");
    outLine("        for (int i = 0; i <= exponent || i < size; i++) {");
    outLine("            if (i == exponent + 1) out[at++] = '.';");
    outLine("            out[at++] = i < size ? digits[i] : '0';");
    outLine("        }");
    outLine("    }");
    outLine("    out[at] = '\\0';");
    outLine("    return 1;");
    outLine("}");
    outLine("static int lt_print_float(double value) {");
    outLine("    char text[64];");
    outLine("    if (!lt_float_format(value, text)) return -1;");
    outLine("    return printf(\"%s\", text);");
    outLine("}");
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic. */
emitIntDivideHelper := fn(): Unit {
    outLine("static int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    outLine("    if (right == 0) { lt_int_fault(at, \"division by zero\"); }");
    outLine("    if (left == INT64_MIN && right == -1) { lt_int_fault(at, \"integer outside Int range\"); }");
    outLine("    return left / right;");
    outLine("}");
    outLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(): Unit {
    outLine("static int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    outLine("    if (right == 0) { lt_int_fault(at, \"remainder by zero\"); }");
    outLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    outLine("    return left % right;");
    outLine("}");
    outLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    outLine("static int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    outLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    outLine("    const int64_t remainder = left % right;");
    outLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    outLine("}");
    outLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(): Unit {
    outLine("static int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    outLine("    if (right == 0) { lt_int_fault(at, \"modulo by zero\"); }");
    outLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    outLine("    const int64_t remainder = left % right;");
    outLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    outLine("}");
    outLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    outLine("static const char *lite_concat(const char *left, const char *right) {");
    outLine("    if (left[0] == '\\0') { return right; }");
    outLine("    if (right[0] == '\\0') { return left; }");
    outLine("    const size_t left_length = strlen(left);");
    outLine("    const size_t right_length = strlen(right);");
    outLine("    char *combined = lt_str_alloc(left_length + right_length + 1u);");
    outLine("    memcpy(combined, left, left_length);");
    outLine("    memcpy(combined + left_length, right, right_length + 1u);");
    outLine("    return combined;");
    outLine("}");
    outLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary, preserving non-trivial Unit/Never side effects. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if textLib.startsWithAt(code, 0, "/*@CBLK:") {
        endHdr := textLib.indexOfText(code, "@*/", 8);
        retVar := textLib.slice(code, 8, endHdr);
        blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
        if kind == frontend.VALUE_KIND_NEVER or kind == frontend.VALUE_KIND_UNIT {
            outLine(indent + "{ " + blkBody + " }");
        } else {
            outLine(indent + cScalarType(kind) + " " + name + ";");
            outLine(indent + "{ " + blkBody + " " + name + " = " + retVar + "; }");
        }
        return;
    }
    if kind == frontend.VALUE_KIND_NEVER {
        outLine(indent + "(void)(" + code + ");");
        return;
    }
    if kind == frontend.VALUE_KIND_UNIT {
        if code =!= "0" { outLine(indent + "(void)(" + code + ");"); }
        return;
    }
    typeCode := cScalarType(kind) + " ";
    outLine(indent + typeCode + name + " = " + code + ";");
}

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String, failAction: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { " + failAction + " }\n"
}

/** Emits statements for one C function body (`fnResult != ""`) or `main` (`fnResult == ""`). */
emitCItemStream := fn(stream: frontend.Items, hoistedGlobals: frontend.TokenBuckets, fnResult: String, failAction: String): Unit {
    var indent := "    ";
    var blockDepth := 0;
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    var writes := "";
    var seqLoopId := 0;
    loopSeqFlags: mut List<Int> = [];
    loopSeqReleases: mut List<String> = [];
    loop stream as item {
        code := normalizeCBuiltinCalls(item.code);
        if isCLocalDeclKind(item.kind) {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                if not (fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime)) {
                    outLine(indent + cDeclTypeItem(item) + item.runtime + ";");
                }
                outLine(indent + "{ " + blkBody + " " + item.runtime + " = " + retVar + "; }");
            } else if fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                outLine(indent + item.runtime + " = " + code + ";");
            } else {
                outLine(indent + cDeclTypeItem(item) + item.runtime + " = " + code + ";");
            }
            outLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_ASSIGN_INT or item.kind == frontend.ITEM_KIND_ASSIGN_STRING or item.kind == frontend.ITEM_KIND_ASSIGN_BOOL or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_FN {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                outLine(indent + "{ " + blkBody + " " + item.runtime + " = " + retVar + "; }");
            } else {
                outLine(indent + item.runtime + " = " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_RETURN {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                if fnResult == frontend.VALUE_KIND_UNIT {
                    outLine(indent + "{ " + blkBody + " } return;");
                } else {
                    outLine(indent + "{ " + cScalarType(fnResult) + " lt_ret; " + blkBody + " lt_ret = " + retVar + "; return lt_ret; }");
                }
            } else if fnResult == frontend.VALUE_KIND_UNIT {
                if code =!= "" { outLine(indent + "(void)(" + code + ");"); }
                outLine(indent + "return;");
            } else if code == "" {
                outLine(indent + "return;");
            } else if textLib.startsWithAt(code, 0, "lt_exit(") {
                outLine(indent + "(void)(" + code + ");");
            } else {
                outLine(indent + "return " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_CALL or item.kind == frontend.ITEM_KIND_DISCARD {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                outLine(indent + "{ " + blkBody + " }");
            } else if item.kind == frontend.ITEM_KIND_CALL and textLib.startsWithAt(code, 0, "{ /*c-stmt*/") {
                outLine(indent + code);
            } else {
                outLine(indent + "(void)(" + code + ");");
            }
        } else if item.kind == frontend.ITEM_KIND_UNREACHABLE {
            outLine(indent + "fprintf(stderr, \"unreachable loop completion\\n\");");
            outLine(indent + "exit(1);");
        } else if item.kind == frontend.ITEM_KIND_BREAK {
            outLine(indent + "break;");
        } else if item.kind == frontend.ITEM_KIND_CONTINUE {
            outLine(indent + "continue;");
        } else if item.kind == frontend.ITEM_KIND_SCOPE {
            outLine(indent + "{");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_IF {
            outLine(indent + "if (" + code + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_ELSE {
            indent = dedent(indent);
            outLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE_IF {
            indent = dedent(indent);
            outLine(indent + "} else if (" + code + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_SCOPE {
            indent = dedent(indent);
            outLine(indent + "}");
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_LOOP {
            condition := if code == "" { "true" } else { code };
            outLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
            listLib.pushBack(mut loopSeqFlags, 0);
            listLib.pushBack(mut loopSeqReleases, "");
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            seqId := integer.intText(seqLoopId);
            seqLoopId = seqLoopId + 1;
            if item.intValue == 2 or item.intValue == 3 {
                nl := textLib.indexOfText(code, "\n", 0);
                rStart := if nl >= 0 { textLib.slice(code, 0, nl) } else { "0" };
                rEnd := if nl >= 0 { textLib.slice(code, nl + 1, textLib.length(code)) } else { "0" };
                rOp := if item.intValue == 3 { "<=" } else { "<" };
                endVar := "lt_rend_" + seqId;
                idxVar := "lt_ri_" + seqId;
                outLine(indent + "{");
                outLine(indent + "    int64_t " + endVar + " = " + rEnd + ";");
                outLine(indent + "    for (int64_t " + idxVar + " = " + rStart + "; " + idxVar + " " + rOp + " " + endVar + "; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        int64_t " + item.runtime + " = " + idxVar + ";");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
                listLib.pushBack(mut loopSeqReleases, "");
            } else if item.intValue == 4 {
                /* Map loop: item.textValue is `(key:K,value:V)`, first `@T:` in item.code is `Map<K,V>`. */
                annots := extractCTypeAnnotations(item.code);
                mapKind := if listLib.length(annots) > 0 and textLib.startsWithAt(annots[0], 0, "T:") { textLib.slice(annots[0], 2, textLib.length(annots[0])) } else { "" };
                mTag := frontend.cMapTag(mapKind);
                entryTag := frontend.cStructTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                outLine(indent + "{");
                outLine(indent + "    " + mTag + " " + seqVar + " = " + mTag + "_copy(" + code + ");");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        " + entryTag + " " + item.runtime + " = (" + entryTag + "){ .f_key = " + seqVar + ".data[" + idxVar + "].key, .f_value = " + seqVar + ".data[" + idxVar + "].val };");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
                listLib.pushBack(mut loopSeqReleases, "");
            } else if item.intValue == 5 {
                /* Set loop: item.textValue is element kind `T`. */
                sTag := frontend.cSetTag("Set<" + item.textValue + ">");
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                outLine(indent + "{");
                outLine(indent + "    " + sTag + " " + seqVar + " = " + sTag + "_copy(" + code + ");");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        " + cScalarType(item.textValue) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
                listLib.pushBack(mut loopSeqReleases, "");
            } else {
                tag := frontend.cListTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                seqInit := if item.intValue == 1 { code } else { "lt_list_" + tag + "_copy(" + code + ")" };
                outLine(indent + "{");
                outLine(indent + "    lt_list_" + tag + " " + seqVar + " = " + seqInit + ";");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        " + frontend.cListElemType(tag) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
                listLib.pushBack(mut loopSeqReleases, if item.intValue == 1 { "" } else { seqVar });
            }
        } else if item.kind == frontend.ITEM_KIND_END_LOOP {
            isSeqEnd := if loopSeqFlags.length > 0 { listLib.popBack(mut loopSeqFlags) == 1 } else { false };
            relVar := if loopSeqReleases.length > 0 { listLib.popBack(mut loopSeqReleases) } else { "" };
            if isSeqEnd {
                indent = dedent(dedent(indent));
                outLine(indent + "    }");
                if relVar =!= "" {
                    outLine(indent + "    if (" + relVar + ".rc != NULL) { if (*(" + relVar + ".rc) <= 1) { free(" + relVar + ".data); free(" + relVar + ".rc); } else { *(" + relVar + ".rc) -= 1; } }");
                }
                outLine(indent + "}");
            } else {
                indent = dedent(indent);
                outLine(indent + "}");
            }
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT {
            if count == 1 {
                if textLib.startsWithAt(firstCode, 0, "/*@CBLK:") {
                    oneTemp := "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, oneTemp, indent);
                    outText(outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { oneTemp }, indent, failAction));
                } else {
                    outText(outputWriteCode(firstKind, firstCode, indent, failAction));
                }
            }
            else if count > 1 { outText(writes); }
            if item.kind == frontend.ITEM_KIND_END { outLine(indent + "if (printf(\"\\n\") < 0) { " + failAction + " }"); }
            count = 0;
            writes = "";
        } else if item.kind == frontend.ITEM_KIND_MAIN_STOP or item.kind == frontend.ITEM_KIND_IMPORT or
        item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or
        item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or item.kind == frontend.ITEM_KIND_PURE_GLOBAL or
        item.kind == frontend.ITEM_KIND_SOFT_BUILTIN or item.kind == frontend.ITEM_KIND_NOOP {
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    writes = outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { firstTemp }, indent, failAction);
                }
                temp := "lt_output_" + integer.intText(tempIndex);
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, code, temp, indent);
                writes = writes + indent + "if (printf(\" \") < 0) { " + failAction + " }\n" +
                outputWriteCode(item.kind, if item.kind == frontend.VALUE_KIND_UNIT or item.kind == frontend.VALUE_KIND_NEVER { "0" } else { temp }, indent, failAction);
            }
            count = count + 1;
        }
    }
};

/** Emits one C11 function definition starting at `FUNCTION_START` index `startIndex` and returns the index after `FUNCTION_END`. */
emitOneCFunction := fn(reachable: frontend.Items, startIndex: Int, total: Int, hoistedGlobals: frontend.TokenBuckets): Int {
    fnItem := reachable[startIndex];
    fnItems: mut frontend.Items = [];
    var idx := startIndex + 1;
    var depth := 1;
    loop idx < total {
        item := reachable[idx];
        if item.kind == frontend.ITEM_KIND_FUNCTION_START { depth = depth + 1; }
        else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            depth = depth - 1;
            if depth == 0 {
                idx = idx + 1;
                break;
            }
        }
        listLib.pushBack(mut fnItems, item);
        idx = idx + 1;
    }
    outLine("static " + cScalarType(fnItem.code) + " " + fnItem.runtime + "(" + cParameterList(fnItem.textValue) + ") {");
    emitCParameterReads(fnItem.textValue);
    emitArithmeticTemporaries(fnItems);
    emitCItemStream(fnItems, hoistedGlobals, fnItem.code, "lt_io_status = 1;");
    outLine("}");
    outLine("");
    idx
};

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications and optimization level (`0..3`). */
/** Returns all C-supported struct (`S|<kind>`), list (`L|<elemKind>`), map (`M|<kind>`), and set (`E|<kind>`) types referenced by `kind` in post-order. */
collectSubKinds := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        if frontend.cListTag(elKind) == "" { return out; }
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "L|" + elKind);
        return out;
    }
    if frontend.isMapKind(kind) {
        if frontend.cMapTag(kind) == "" { return out; }
        kKind := frontend.mapKeyKind(kind);
        vKind := frontend.mapValueKind(kind);
        subK := self("List<" + kKind + ">");
        loop subK as s { listLib.pushBack(mut out, s); }
        subV := self(vKind);
        loop subV as s { listLib.pushBack(mut out, s); }
        if frontend.cListTag(vKind) =!= "" {
            subVL := self("List<" + vKind + ">");
            loop subVL as s { listLib.pushBack(mut out, s); }
        }
        subGet := self("(found:Bool,value:" + vKind + ")");
        loop subGet as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "M|" + kind);
        return out;
    }
    if frontend.isSetKind(kind) {
        if frontend.cSetTag(kind) == "" { return out; }
        eKind := frontend.setElementKind(kind);
        subE := self("List<" + eKind + ">");
        loop subE as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "E|" + kind);
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        if frontend.cStructTag(kind) == "" { return out; }
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        listLib.pushBack(mut out, "S|" + kind);
        return out;
    }
    if frontend.isFnKind(kind) {
        if frontend.cFnTag(kind) == "" { return out; }
        pCount := frontend.fnParamCount(kind);
        var pi := 0;
        loop pi < pCount {
            subP := self(frontend.fnParamComponent(kind, pi).kind);
            loop subP as s { listLib.pushBack(mut out, s); }
            pi = pi + 1;
        }
        subR := self(frontend.fnResultKind(kind));
        loop subR as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "F|" + kind);
        return out;
    }
    out
};

/** Returns all struct/list/map/set tags and `"FLOAT"`/`"FLOAT32"` markers reachable inside `kind` for print/copy/float tracking. */
collectTypeFlags := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isFloatScalarKind(kind) {
        listLib.pushBack(mut out, "FLOAT");
        if kind == frontend.VALUE_KIND_FLOAT32 { listLib.pushBack(mut out, "FLOAT32"); }
        return out;
    }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        tag := frontend.cListTag(elKind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "L:" + tag);
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isMapKind(kind) {
        tag := frontend.cMapTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "M:" + tag);
        subK := self(frontend.mapKeyKind(kind));
        loop subK as s { listLib.pushBack(mut out, s); }
        subV := self(frontend.mapValueKind(kind));
        loop subV as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isSetKind(kind) {
        tag := frontend.cSetTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "E:" + tag);
        subE := self(frontend.setElementKind(kind));
        loop subE as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        tag := frontend.cStructTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "S:" + tag);
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        return out;
    }
    out
};

/** Extracts all `/*@T:<kind>@*/`, `/*@P:<kind>@*/`, and `/*@C:<exp>|<act>@*/` payloads from emitted C expression `code`. */
extractCTypeAnnotations := fn(code: String): List<String> {
    out: mut List<String> = [];
    if textLib.indexOfText(code, "/*@", 0) < 0 { return out; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:") or textLib.startsWithAt(code, cursor, "/*@P:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            if endTag < 0 { break; }
            listLib.pushBack(mut out, textLib.slice(code, cursor + 3, endTag));
            cursor = endTag + 3;
        } else {
            cursor = cursor + 1;
        }
    }
    out
};

/** Recursively extracts balanced CFN_START ... CFN_END hoisted closure/trampoline definitions (innermost first), encoded as `<key>\n<body>`. */
extractCHoistedFns := fn(code: String): List<String> {
    out: mut List<String> = [];
    if textLib.indexOfText(code, "/*@CFN_START:", 0) < 0 { return out; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CFN_START:") {
            keyEnd := textLib.indexOfText(code, "@*/", cursor + 13);
            blockEnd := skipCFnBlock(code, cursor);
            if keyEnd > cursor + 13 and blockEnd >= keyEnd + 16 {
                key := textLib.slice(code, cursor + 13, keyEnd);
                body := textLib.slice(code, keyEnd + 3, blockEnd - 13);
                nested := self(body);
                loop nested as entry {
                    listLib.pushBack(mut out, entry);
                }
                listLib.pushBack(mut out, key + "\n" + body);
            }
            cursor = blockEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    out
};

/** Emits a C11 fat-pointer struct typedef and `_call` helper for function value type `kind`. */
emitCFnTypeHelper := fn(kind: String, calls: String): Unit {
    fTag := frontend.cFnTag(kind);
    retKind := frontend.fnResultKind(kind);
    retC := cScalarType(retKind);
    pCount := frontend.fnParamCount(kind);
    var fpParams := "void *";
    var callParams := fTag + " f";
    var callArgs := "f.env";
    var i := 0;
    loop i < pCount {
        pC := cScalarType(frontend.fnParamComponent(kind, i).kind);
        aName := "a" + integer.intText(i);
        fpParams = fpParams + ", " + pC;
        callParams = callParams + ", " + pC + " " + aName;
        callArgs = callArgs + ", " + aName;
        i = i + 1;
    }
    outLine("typedef struct " + fTag + " { " + retC + " (*fn)(" + fpParams + "); void *env; } " + fTag + ";");
    if usesIntHelper(calls, fTag + "_call(") {
        if retC == "void" {
            outLine("static void " + fTag + "_call(" + callParams + ") { f.fn(" + callArgs + "); }");
        } else {
            outLine("static " + retC + " " + fTag + "_call(" + callParams + ") { return f.fn(" + callArgs + "); }");
        }
    }
    outLine("");
};

/** Emits C11 `core/unicode` hard builtin helpers (`toCodePoints`, `fromCodePoints`). */
emitCUnicodeBuiltinHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite$unicodeToCodePoints(") {
        outLine("static lt_list_i64 lt_unicode_to_code_points(const char *text) {");
        outLine("    const uint8_t *p = (const uint8_t *)text;");
        outLine("    int64_t len = 0; int64_t cap = 16;");
        outLine("    int64_t *data = malloc((size_t)cap * sizeof(int64_t));");
        outLine("    if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate code points\\n\"); exit(1); }");
        outLine("    while (*p != 0) {");
        outLine("        int64_t cp = 0xFFFD;");
        outLine("        uint8_t b0 = *p;");
        outLine("        if (b0 < 0x80) { cp = (int64_t)b0; p += 1; }");
        outLine("        else if ((b0 & 0xE0) == 0xC0 && p[1] != 0) { cp = (int64_t)(((b0 & 0x1F) << 6) | (p[1] & 0x3F)); p += 2; }");
        outLine("        else if ((b0 & 0xF0) == 0xE0 && p[1] != 0 && p[2] != 0) { cp = (int64_t)(((b0 & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F)); p += 3; }");
        outLine("        else if ((b0 & 0xF8) == 0xF0 && p[1] != 0 && p[2] != 0 && p[3] != 0) { cp = (int64_t)(((b0 & 0x07) << 18) | ((p[1] & 0x3F) << 12) | ((p[2] & 0x3F) << 6) | (p[3] & 0x3F)); p += 4; }");
        outLine("        else { p += 1; }");
        outLine("        if (len >= cap) { cap *= 2; data = realloc(data, (size_t)cap * sizeof(int64_t)); if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot grow code points\\n\"); exit(1); } }");
        outLine("        data[len++] = cp;");
        outLine("    }");
        outLine("    lt_list_i64 out = { data, len, cap, NULL };");
        outLine("    return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$unicodeFromCodePoints(") {
        okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
        outLine("static " + okTextTag + " lt_unicode_from_code_points(lt_list_i64 points) {");
        outLine("    size_t cap = (size_t)(points.len > 0 ? points.len * 4 : 1) + 1;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate text\\n\"); exit(1); }");
        outLine("    size_t pos = 0;");
        outLine("    for (int64_t i = 0; i < points.len; i += 1) {");
        outLine("        int64_t cp = points.data[i];");
        outLine("        if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {");
        outLine("            free(buf);");
        outLine("            char *msg = malloc(96);");
        outLine("            if (msg == NULL) { return (" + okTextTag + "){ false, \"\", \"invalid Unicode scalar code point\" }; }");
        outLine("            snprintf(msg, 96, \"invalid Unicode scalar code point: %\" PRId64, cp);");
        outLine("            return (" + okTextTag + "){ false, \"\", msg };");
        outLine("        }");
        outLine("        if (cp < 0x80) { buf[pos++] = (char)cp; }");
        outLine("        else if (cp < 0x800) { buf[pos++] = (char)(0xC0 | (cp >> 6)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("        else if (cp < 0x10000) { buf[pos++] = (char)(0xE0 | (cp >> 12)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("        else { buf[pos++] = (char)(0xF0 | (cp >> 18)); buf[pos++] = (char)(0x80 | ((cp >> 12) & 0x3F)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("    }");
        outLine("    buf[pos] = '\\0';");
        outLine("    return (" + okTextTag + "){ true, buf, \"\" };");
        outLine("}");
    }
};

/** Emits C11 `core/io` stream and `core/file` stream-opener helpers. */
emitCStreamBuiltinHelpers := fn(calls: String): Unit {
    if not usesStreamBuiltins(calls) { return; }
    shTag := frontend.cStructTag("(kind:String,handle:Int)");
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
    okWrittenTag := frontend.cStructTag("(ok:Bool,written:Int,error:String)");
    fKind := frontend.cFieldName("kind");
    fHandle := frontend.cFieldName("handle");
    needFileOpen := usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or usesIntHelper(calls, "lite$fileOpenAppender(");
    needAlloc := needFileOpen or usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(");
    needLookup := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
        usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(") or
        usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWriterOk(") or
        usesIntHelper(calls, "lite$ioWriterError(") or usesIntHelper(calls, "lite$ioWrite(") or
        usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") or
        usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
        usesIntHelper(calls, "lite$ioClearWriter(");
    needStdinState := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
        usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(");
    if needAlloc or needLookup {
        outLine("typedef struct { int kind; int fd; uint8_t *buf; int64_t len; int64_t cap; int64_t pos; bool eof; bool closed; const char *error; } lt_stream_entry;");
        outLine("static lt_stream_entry *lt_streams = NULL;");
        outLine("static int64_t lt_streams_len = 0;");
        outLine("static int64_t lt_streams_cap = 0;");
    }
    if needStdinState {
        outLine("static bool lt_stdin_eof = false;");
        outLine("static const char *lt_stdin_err = \"\";");
    }
    if needAlloc {
        outLine("static int64_t lt_alloc_stream(lt_stream_entry entry) {");
        outLine("    if (lt_streams_len >= lt_streams_cap) {");
        outLine("        lt_streams_cap = lt_streams_cap == 0 ? 16 : lt_streams_cap * 2;");
        outLine("        lt_streams = realloc(lt_streams, (size_t)lt_streams_cap * sizeof(lt_stream_entry));");
        outLine("        if (lt_streams == NULL) { fprintf(stderr, \"MemoryFault: cannot grow stream table\\n\"); exit(1); }");
        outLine("    }");
        outLine("    int64_t id = lt_streams_len + 10;");
        outLine("    lt_streams[lt_streams_len++] = entry;");
        outLine("    return id;");
        outLine("}");
    }
    if needLookup {
        outLine("static lt_stream_entry *lt_lookup_stream(int64_t handle) {");
        outLine("    int64_t idx = handle - 10;");
        outLine("    if (idx < 0 || idx >= lt_streams_len) { return NULL; }");
        outLine("    return &lt_streams[idx];");
        outLine("}");
    }
    if needFileOpen {
        outLine("static " + shTag + " lt_file_open_stream(const char *path, int flags, bool for_write) {");
        outLine("    int fd = open(path, flags, 0666);");
        outLine("    if (fd < 0) {");
        outLine("        const char *err = lt_dup_str(strerror(errno));");
        outLine("        lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, err };");
        outLine("        return (" + shTag + "){ \"error\", lt_alloc_stream(e) };");
        outLine("    }");
        outLine("    if (!for_write) {");
        outLine("        struct stat st;");
        outLine("        if (fstat(fd, &st) == 0 && S_ISDIR(st.st_mode)) {");
        outLine("            close(fd);");
        outLine("            lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, \"EISDIR: illegal operation on a directory\" };");
        outLine("            return (" + shTag + "){ \"error\", lt_alloc_stream(e) };");
        outLine("        }");
        outLine("    }");
        outLine("    lt_stream_entry e = { 1, fd, NULL, 0, 0, 0, false, false, \"\" };");
        outLine("    return (" + shTag + "){ \"file\", lt_alloc_stream(e) };");
        outLine("}");
