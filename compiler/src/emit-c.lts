    }
    if usesIntHelper(calls, "lite$ioWriterOk(") {
        outLine("static bool lt_io_writer_ok(" + shTag + " writer) {");
        outLine("    if ((strcmp(writer." + fKind + ", \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(writer." + fKind + ", \"stderr\") == 0 && writer." + fHandle + " == 2)) { return true; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    return e != NULL && (e->kind == 1 || e->kind == 3) && !e->closed && e->error[0] == '\\0';");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWrite(") {
        outLine("static " + okWrittenTag + " lt_io_write(" + shTag + " writer, lt_list_i64 bytes) {");
        outLine("    uint8_t *tmp = bytes.len > 0 ? malloc((size_t)bytes.len) : NULL;");
        outLine("    if (bytes.len > 0 && tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate write buffer\\n\"); exit(1); }");
        outLine("    for (int64_t i = 0; i < bytes.len; i += 1) {");
        outLine("        if (bytes.data[i] < 0 || bytes.data[i] > 255) { free(tmp); return (" + okWrittenTag + "){ false, 0, \"byte value outside 0..255\" }; }");
        outLine("        tmp[i] = (uint8_t)bytes.data[i];");
        outLine("    }");
        outLine("    int target_fd = -1;");
        outLine("    lt_stream_entry *e = NULL;");
        outLine("    if (strcmp(writer." + fKind + ", \"stdout\") == 0 && writer." + fHandle + " == 1) { target_fd = 1; }");
        outLine("    else if (strcmp(writer." + fKind + ", \"stderr\") == 0 && writer." + fHandle + " == 2) { target_fd = 2; }");
        outLine("    else {");
        outLine("        e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("        if (e == NULL) { free(tmp); return (" + okWrittenTag + "){ false, 0, \"invalid writer handle\" }; }");
        outLine("        if (e->kind == 4) { free(tmp); return (" + okWrittenTag + "){ false, 0, e->error }; }");
        outLine("        if (e->kind == 2) { free(tmp); return (" + okWrittenTag + "){ false, 0, \"handle is a reader, not a writer\" }; }");
        outLine("        if (e->closed) { free(tmp); return (" + okWrittenTag + "){ false, 0, \"writer is closed\" }; }");
        outLine("        if (e->error[0] != '\\0') { free(tmp); return (" + okWrittenTag + "){ false, 0, e->error }; }");
        outLine("        if (e->kind == 3) {");
        outLine("            if (bytes.len > 0) {");
        outLine("                if (e->len + bytes.len > e->cap) {");
        outLine("                    int64_t ncap = e->cap == 0 ? 64 : e->cap * 2;");
        outLine("                    while (ncap < e->len + bytes.len) { ncap *= 2; }");
        outLine("                    e->buf = realloc(e->buf, (size_t)ncap);");
        outLine("                    if (e->buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow buffer writer\\n\"); exit(1); }");
        outLine("                    e->cap = ncap;");
        outLine("                }");
        outLine("                memcpy(e->buf + e->len, tmp, (size_t)bytes.len);");
        outLine("                e->len += bytes.len;");
        outLine("            }");
        outLine("            free(tmp);");
        outLine("            return (" + okWrittenTag + "){ true, bytes.len, \"\" };");
        outLine("        }");
        outLine("        target_fd = e->fd;");
        outLine("    }");
        outLine("    int64_t off = 0;");
        outLine("    while (off < bytes.len) {");
        outLine("        ssize_t n = write(target_fd, tmp + off, (size_t)(bytes.len - off));");
        outLine("        if (n < 0) {");
        outLine("            const char *msg = lt_dup_str(strerror(errno));");
        outLine("            if (e != NULL) { e->error = msg; }");
        outLine("            free(tmp);");
        outLine("            return (" + okWrittenTag + "){ false, 0, msg };");
        outLine("        }");
        outLine("        off += (int64_t)n;");
        outLine("    }");
        outLine("    free(tmp);");
        outLine("    return (" + okWrittenTag + "){ true, bytes.len, \"\" };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioFlush(") {
