        io.outputLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        io.outputLine("    if (e == NULL || e->closed || e->error[0] != '\\0' || e->kind == 4 || e->kind == 3 || e->eof) { return empty; }");
        io.outputLine("    if (e->kind == 2) {");
        io.outputLine("        int64_t avail = e->len - e->pos;");
