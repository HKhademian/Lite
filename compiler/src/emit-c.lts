        io.outputLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        io.outputLine("    if (e == NULL) { return \"invalid reader handle\"; }");
        io.outputLine("    if (e->kind == 3) { return \"handle is a writer, not a reader\"; }");
        io.outputLine("    if (e->error[0] != '\\0') { return e->error; }");
        io.outputLine("    if (e->closed) { return \"reader is closed\"; }");
        io.outputLine("    return \"\";");
        io.outputLine("}");
    }
