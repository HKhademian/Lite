            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$ioWriterError(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_io_writer_error(";
            cursor = cursor + textLib.length("lite$ioWriterError(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$ioWrite(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_io_write(";
            cursor = cursor + textLib.length("lite$ioWrite(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$ioFlush(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_io_flush(";
            cursor = cursor + textLib.length("lite$ioFlush(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$ioCloseWriter(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_io_close_writer(";
            cursor = cursor + textLib.length("lite$ioCloseWriter(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$fileKind(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_file_kind(";
            cursor = cursor + textLib.length("lite$fileKind(");
