        io.outputLine("        for (int64_t i = 0; i < take; i += 1) { data[i] = (int64_t)e->buf[e->pos + i]; }");
        io.outputLine("        e->pos += take;");
        io.outputLine("        return (lt_list_i64){ data, take, take, NULL };");
        io.outputLine("    }");
        io.outputLine("    size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        io.outputLine("    uint8_t *tmp = malloc(cap);");
