frontend := import "./frontend.lts";
cLiteral := import "./c-literals.lts";
integer := import "core/int";
diagLib := import "core/diag";
io := import "core/io";
textLib := import "core/text";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textLib.slice(indent, 0, textLib.length(indent) - 4)
}

/** Builds one checked printf call for an Int, String or Bool report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    if kind == "Unit" {
        "printf(\"Unit\")"
    } else if kind == "Float" {
        "lt_print_float((double)(" + code + "))"
    } else if kind == "Int" {
        "printf(\"%\" PRId64, (int64_t)(" + code + "))"
    } else if kind == "Bool" {
        "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))"
    } else {
        "printf(\"%s\", " + code + ")"
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    textLib.indexOfText(calls, "|" + name + "|", 0) >= 0
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: String): String {
    if usesIntHelper(calls, "lite$readSource(") {
        "C backend does not support compiler source reads"
    } else if usesIntHelper(calls, "lite$inputArgs(") or usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(") {
        "C backend does not support input builtins yet"
    } else if usesIntHelper(calls, "lite$reportError(") or usesIntHelper(calls, "lite$exit(") {
        "C backend does not support reportError or exit yet"
    } else if usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
        usesIntHelper(calls, "lite$textSlice(") {
        "C backend does not support text builtins yet"
    } else {
        ""
    }
}


/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program needs checked dynamic Int64 arithmetic. */
usesIntArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
        usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(")
}

/** True when binary64 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool { usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float_power(") }

/** Emits checked binary64 operations; caller temporaries preserve left-to-right operand effects. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesIntHelper(calls, "lt_float_power(") {
        io.outputLine("static double lt_float_power(double left, double right, size_t at) {");
        io.outputLine("    if (right <= 0) { lt_int_fault(at, \"power exponent must be positive in this checkpoint\"); }");
        io.outputLine("    double value = pow(left, right);");
        io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if not usesIntHelper(calls, "lt_float_op(") { return; }
    io.outputLine("static double lt_float_op(double left, double right, int op, size_t at) {");
    io.outputLine("    if (op == 3 && right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
    io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
    io.outputLine("    return value;");
    io.outputLine("}");
}

/** Emits portable C11 guards that reject overflow before evaluating a signed operation. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    if not usesIntArithmetic(calls) and not usesIntDivision(calls) and not usesFloatArithmetic(calls) { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    io.outputLine("static const size_t lt_int_lines[] = {" + frontend.lineStartCodes(source) + "};");
    io.outputLine("static const char *lt_int_source = " + cLiteral.textLiteralCode(namePrefix) + ";");
    io.outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) {");
    io.outputLine("    size_t line = 0;");
    io.outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
    io.outputLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
    io.outputLine("    exit(1);");
    io.outputLine("}");
    if usesIntHelper(calls, "lt_checked_add(") {
        io.outputLine("static int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left + right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        io.outputLine("static int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left - right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        io.outputLine("static int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if (left == 0 || right == 0) { return 0; }");
        io.outputLine("    if (left > 0) {");
        io.outputLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
        io.outputLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right > 0) {");
        io.outputLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left * right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        io.outputLine("static int64_t lt_checked_negate(int64_t value, size_t at) {");
        io.outputLine("    if (value == INT64_MIN) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return -value;");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Declares hygienic arithmetic/comparison temporaries at unique assignment sites, skipping quoted text. */
emitArithmeticTemporaries := fn(items: frontend.Items): Unit {
    loop items as item {
        var cursor := 0;
        loop cursor < textLib.length(item.code) {
            ch := textLib.at(item.code, cursor);
            if ch == "\"" {
                cursor = frontend.skipAliasString(item.code, cursor);
            } else if ch == "l" and (textLib.startsWithAt(item.code, cursor, "lt_arg_") or textLib.startsWithAt(item.code, cursor, "lt_cmp_")) {
                end := textLib.skipName(item.code, cursor);
                if textLib.startsWithAt(item.code, end, " = ") {
                    tag := if textLib.startsWithAt(item.code, cursor, "lt_cmp_") or textLib.startsWithAt(item.code, cursor, "lt_arg_f_") { textLib.at(item.code, cursor + 7) } else { "i" };
                    typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                        else if tag == "f" { "double " } else { "int64_t " };
                    io.outputLine("    " + typeCode + textLib.slice(item.code, cursor, end) + ";");
                }
                cursor = end;
            } else { cursor = cursor + 1; }
        }
    }
}

/** Emits shortest round-trip binary64 display with decimal/exponent thresholds shared by the TS runtime; source remains statically checked and no locale is selected by generated programs. */
emitFloatOutputHelpers := fn(): Unit {
    io.outputLine("/* Split printf's positive finite decimal into significant digits and its first-digit exponent. */");
    io.outputLine("static int lt_float_digits(const char *text, char *digits, int *exponent) {");
    io.outputLine("    int size = 0, before = 0, dot = 0;");
    io.outputLine("    const char *at = text;");
    io.outputLine("    while (*at && *at != 'e' && *at != 'E') {");
    io.outputLine("        if (*at == '.') dot = 1;");
    io.outputLine("        else { digits[size++] = *at; if (!dot) before++; }");
    io.outputLine("        at++;");
    io.outputLine("    }");
    io.outputLine("    int power = *at ? (int)strtol(at + 1, NULL, 10) : 0;");
    io.outputLine("    int leading = 0;");
    io.outputLine("    while (leading + 1 < size && digits[leading] == '0') leading++;");
    io.outputLine("    memmove(digits, digits + leading, (size_t)(size - leading));");
    io.outputLine("    size -= leading;");
    io.outputLine("    digits[size] = '\\0';");
    io.outputLine("    *exponent = before - leading - 1 + power;");
    io.outputLine("    return size;");
    io.outputLine("}");
    io.outputLine("/* Move to the adjacent positive decimal having at most precision significant digits. */");
    io.outputLine("static void lt_float_neighbor(char *digits, int precision, int *exponent, int direction) {");
    io.outputLine("    int at = precision - 1;");
    io.outputLine("    if (direction > 0) {");
    io.outputLine("        while (at >= 0 && digits[at] == '9') digits[at--] = '0';");
    io.outputLine("        if (at >= 0) digits[at]++;");
    io.outputLine("        else { digits[0] = '1'; (*exponent)++; }");
    io.outputLine("    } else {");
    io.outputLine("        while (at >= 0 && digits[at] == '0') digits[at--] = '9';");
    io.outputLine("        if (at >= 0) digits[at]--;");
    io.outputLine("        if (digits[0] == '0') {");
    io.outputLine("            for (int i = 0; i < precision; i++) digits[i] = '9';");
    io.outputLine("            (*exponent)--;");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("}");
    io.outputLine("/* Find the least significant-digit count that round-trips, including asymmetric boundary candidates. */");
    io.outputLine("static int lt_float_format(double value, char *out) {");
    io.outputLine("    if (value == 0.0) { strcpy(out, \"0\"); return 1; }");
    io.outputLine("    int negative = value < 0.0;");
    io.outputLine("    double positive = negative ? -value : value;");
    io.outputLine("    char digits[32], nearest[64], adjacent[64];");
    io.outputLine("    int size = 0, exponent = 0, found = 0;");
    io.outputLine("    for (int precision = 1; precision <= 17 && !found; precision++) {");
    io.outputLine("        if (snprintf(nearest, sizeof nearest, \"%.*g\", precision, positive) < 0) return 0;");
    io.outputLine("        size = lt_float_digits(nearest, digits, &exponent);");
    io.outputLine("        if (strtod(nearest, NULL) == positive) { found = 1; break; }");
    io.outputLine("        while (size < precision) digits[size++] = '0';");
    io.outputLine("        digits[size] = '\\0';");
    io.outputLine("        for (int direction = -1; direction <= 1 && !found; direction += 2) {");
    io.outputLine("            char candidate[32]; memcpy(candidate, digits, (size_t)size + 1);");
    io.outputLine("            int power = exponent;");
    io.outputLine("            lt_float_neighbor(candidate, precision, &power, direction);");
    io.outputLine("            if (snprintf(adjacent, sizeof adjacent, \"%se%d\", candidate, power - precision + 1) < 0) return 0;");
    io.outputLine("            if (strtod(adjacent, NULL) == positive) {");
    io.outputLine("                memcpy(digits, candidate, (size_t)size + 1); exponent = power; found = 1;");
    io.outputLine("            }");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    if (!found) return 0;");
    io.outputLine("    while (size > 1 && digits[size - 1] == '0') size--;");
    io.outputLine("    int at = 0;");
    io.outputLine("    if (negative) out[at++] = '-';");
    io.outputLine("    if (exponent >= 21 || exponent < -6) {");
    io.outputLine("        out[at++] = digits[0];");
    io.outputLine("        if (size > 1) { out[at++] = '.'; memcpy(out + at, digits + 1, (size_t)size - 1); at += size - 1; }");
    io.outputLine("        out[at++] = 'e';");
    io.outputLine("        if (exponent >= 0) out[at++] = '+';");
    io.outputLine("        int length = snprintf(out + at, 64u - (size_t)at, \"%d\", exponent);");
    io.outputLine("        if (length < 0) return 0;");
    io.outputLine("        at += length;");
    io.outputLine("    } else if (exponent < 0) {");
    io.outputLine("        out[at++] = '0'; out[at++] = '.';");
    io.outputLine("        for (int i = -1; i > exponent; i--) out[at++] = '0';");
    io.outputLine("        memcpy(out + at, digits, (size_t)size); at += size;");
    io.outputLine("    } else {");
    io.outputLine("        for (int i = 0; i <= exponent || i < size; i++) {");
    io.outputLine("            if (i == exponent + 1) out[at++] = '.';");
    io.outputLine("            out[at++] = i < size ? digits[i] : '0';");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    out[at] = '\\0';");
    io.outputLine("    return 1;");
    io.outputLine("}");
    io.outputLine("static int lt_print_float(double value) {");
    io.outputLine("    char text[64];");
    io.outputLine("    if (!lt_float_format(value, text)) return -1;");
    io.outputLine("    return printf(\"%s\", text);");
    io.outputLine("}");
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic. */
emitIntDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { lt_int_fault(at, \"integer outside Int range\"); }");
    io.outputLine("    return left / right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(): Unit {
    io.outputLine("static int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"remainder by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    return left % right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"modulo by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    io.outputLine("static const char *lite_concat(const char *left, const char *right) {");
    io.outputLine("    const size_t left_length = strlen(left);");
    io.outputLine("    const size_t right_length = strlen(right);");
    io.outputLine("    char *combined = malloc(left_length + right_length + 1);");
    io.outputLine("    if (combined == NULL) {");
    io.outputLine("        fprintf(stderr, \"MemoryFault: cannot allocate concatenated text\\n\");");
    io.outputLine("        exit(1);");
    io.outputLine("    }");
    io.outputLine("    memcpy(combined, left, left_length);");
    io.outputLine("    memcpy(combined + left_length, right, right_length + 1);");
    io.outputLine("    return combined;");
    io.outputLine("}");
    io.outputLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary. Unit has no stored payload or supported C-side effect. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if kind == "Unit" { return; }
    typeCode := if kind == "Int" { "int64_t " }
        else if kind == "Bool" { "bool " }
        else if kind == "Float" { "double " }
        else { "const char *" };
    io.outputLine(indent + typeCode + name + " = " + code + ";");
}

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { status = 1; }\n"
}

/** Emits the C program from the flat item stream. Multi-value output evaluates its arguments before any write; every printf keeps the shared write-failure status. */
pub emitProgram := fn(items: frontend.Items, source: String, prefix: String): Unit {
    calls := frontend.targetHelperCalls(items);
    var floatOutput := false;
    floatLiterals := usesIntHelper(calls, "lt_float_literal(");
    var floatValues := floatLiterals or usesFloatArithmetic(calls);
    loop items as item {
        if item.kind == "Float" { floatOutput = true; }
        if item.kind == "Float" or item.kind == "LocalFloat" or item.kind == "VarFloat" or item.kind == "AssignFloat" or
            (item.kind == "Discard" and item.name == "Float") { floatValues = true; }
        if item.kind == "FunctionStart" {
            diagLib.fail("", "C backend does not support top-level functions yet");
        }
        unsupported := unsupportedBuiltinCode(frontend.targetCodeCalls(item.code, "|"));
        if unsupported =!= "" {
            diagLib.fail("", unsupported);
        }
        if frontend.isTupleKind(item.kind) or (item.kind == "Discard" and frontend.isTupleKind(item.name)) or item.kind == "LocalTuple" or item.kind == "VarTuple" or item.kind == "AssignTuple" {
            diagLib.fail("", "C backend does not support tuple values yet");
        }
        if frontend.isListKind(item.kind) or (item.kind == "Discard" and frontend.isListKind(item.name)) or item.kind == "LocalList" or item.kind == "VarList" or item.kind == "AssignList" {
            diagLib.fail("", "C backend does not support list values yet");
        }
        if item.kind == "LoopSeq" {
            diagLib.fail("", "C backend does not support list traversal yet");
        }
        if frontend.codeUsesListIndex(item.code) or frontend.codeUsesListPop(item.code) {
            diagLib.fail("", "C backend does not support list values yet");
        }
        if frontend.codeUsesValueIf(item.code) {
            diagLib.fail("", "C backend does not support value if expressions yet");
        }
    }
    io.outputLine("#include <stdio.h>");
    if usesIntDivision(calls) or usesStringConcat(calls) or usesIntArithmetic(calls) or floatValues { io.outputLine("#include <stdlib.h>"); }
    io.outputLine("#include <inttypes.h>");
    io.outputLine("#include <stdbool.h>");
    io.outputLine("#include <string.h>");
    if usesFloatArithmetic(calls) { io.outputLine("#include <math.h>"); }
    if floatValues {
        io.outputLine("#include <float.h>");
        io.outputLine("_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024, \"Float requires binary64 double\");");
    }
    if floatLiterals { io.outputLine("static double lt_float_literal(const char *text) { return strtod(text, NULL); }"); }
    if floatOutput { emitFloatOutputHelpers(); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesStringConcat(calls) { emitStringConcatHelper(); }
    io.outputLine("int main(void) {");
    io.outputLine("    int status = 0;");
    emitArithmeticTemporaries(items);
    var indent := "    ";
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    var writes := "";
    loop items as item {
        if item.kind == "LocalInt" or item.kind == "VarInt" {
            io.outputLine(indent + "int64_t " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalString" or item.kind == "VarString" {
            io.outputLine(indent + "const char *" + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalFloat" or item.kind == "VarFloat" {
            io.outputLine(indent + "double " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalBool" or item.kind == "VarBool" {
            io.outputLine(indent + "bool " + item.runtime + " = " + item.code + ";");
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignFloat" {
            io.outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "Discard" {
            io.outputLine(indent + "(void)(" + item.code + ");");
        } else if item.kind == "Break" {
            io.outputLine(indent + "break;");
        } else if item.kind == "Continue" {
            io.outputLine(indent + "continue;");
        } else if item.kind == "Scope" {
            io.outputLine(indent + "{");
            indent = indent + "    ";
        } else if item.kind == "If" {
            io.outputLine(indent + "if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            io.outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "ElseIf" {
            indent = dedent(indent);
            io.outputLine(indent + "} else if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" or item.kind == "EndScope" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "true" } else { item.code };
            io.outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            io.outputLine(indent + "}");
        } else if item.kind == "End" or item.kind == "EndOutput" {
            if count == 1 { io.output(outputWriteCode(firstKind, firstCode, indent)); }
            else if count > 1 { io.output(writes); }
            if item.kind == "End" { io.outputLine(indent + "if (printf(\"\\n\") < 0) { status = 1; }"); }
            count = 0;
            writes = "";
        } else if item.kind == "Import" or item.kind == "PublicFunction" or item.kind == "PublicValue" or item.kind == "PublicType" {
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = item.code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    writes = outputWriteCode(firstKind, firstTemp, indent);
                }
                temp := "lt_output_" + integer.intText(tempIndex);
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, item.code, temp, indent);
                writes = writes + indent + "if (printf(\" \") < 0) { status = 1; }\n" + outputWriteCode(item.kind, temp, indent);
            }
            count = count + 1;
        }
    }
    io.outputLine("    return status;");
    io.outputLine("}");
}
