/** Builds one checked printf call for an Int*, Float*, String, Bool, Unit or Never report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    match {
        kind == frontend.VALUE_KIND_NEVER { "((void)(" + code + "), 0)" }
        kind == frontend.VALUE_KIND_UNIT {
            if code == "0" { "printf(\"Unit\")" } else { "((void)(" + code + "), printf(\"Unit\"))" }
        }
        frontend.isEnumKind(kind) {
            dName := frontend.enumDisplayName(kind);
            cCount := frontend.enumCaseCount(kind);
            labels: mut List<String> = [];
            var ci := 0;
            loop ci < cCount {
                listLib.pushBack(mut labels, cLiteral.textLiteralCode(dName + "." + frontend.enumCaseNameAt(kind, ci)));
                ci = ci + 1;
            }
            "printf(\"%s\", ((const char *const[]){" + textLib.joinTexts(labels, ", ") + "}[" + code + "]))"
        }
        frontend.isFloatScalarKind(kind) { "lt_print_float((double)(" + code + "))" }
        cListTagForKind(kind) =!= "" { "lt_list_" + cListTagForKind(kind) + "_print(" + code + ")" }
        frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) + "_print(" + code + ")" }
        frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) + "_print(" + code + ")" }
        frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) + "_print(" + code + ")" }
        frontend.isIntScalarKind(kind) { "printf(\"%\" PRId64, (int64_t)(" + code + "))" }
        kind == frontend.VALUE_KIND_BOOL { "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))" }
        _ { "printf(\"%s\", " + code + ")" }
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    textLib.indexOfText(calls, "|" + name + "|", 0) >= 0
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: String): String {
    match {
        usesIntHelper(calls, "lite$processRun(") or usesIntHelper(calls, "lite$processRunBytes(") {
            "C backend does not support process spawn builtins yet"
        }
        usesIntHelper(calls, "lite$cryptoRandomBytes(") or usesIntHelper(calls, "lite$cryptoDigestBytes(") or
        usesIntHelper(calls, "lite$cryptoDigestText(") or usesIntHelper(calls, "lite$cryptoDigestFile(") or
        usesIntHelper(calls, "lite$cryptoHmacSha256Bytes(") or usesIntHelper(calls, "lite$cryptoEncodeBytes(") or
        usesIntHelper(calls, "lite$cryptoDecodeBytes(") {
            "C backend does not support crypto builtins yet"
        }
        usesIntHelper(calls, "lite$timeMonotonicNs(") or usesIntHelper(calls, "lite$timeEpochNs(") or
        usesIntHelper(calls, "lite$timeSleepMs(") or usesIntHelper(calls, "lite$timeLocalDate(") {
            "C backend does not support time builtins yet"
        }
        usesIntHelper(calls, "lite$extTsStripTypes(") or usesIntHelper(calls, "lite$extHttpFetchToFile(") or
        usesIntHelper(calls, "lite$extHttpServeStatic(") or usesIntHelper(calls, "lite$extBenchMeasureCompiler(") or
        usesIntHelper(calls, "lite$extPoolCpuCount(") or usesIntHelper(calls, "lite$extPoolRunJson(") {
            "C backend does not support external host builtins yet"
        }
        _ { "" }
    }
};

/** True when any emitted item calls a core/unicode hard builtin. */
usesUnicodeBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$unicodeToCodePoints(") or usesIntHelper(calls, "lite$unicodeFromCodePoints(")
};

/** True when any emitted item calls a core/io stream or core/file stream opener builtin. */
usesStreamBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or
    usesIntHelper(calls, "lite$fileOpenAppender(") or usesIntHelper(calls, "lite$ioStdinReader(") or
    usesIntHelper(calls, "lite$ioStdoutWriter(") or usesIntHelper(calls, "lite$ioStderrWriter(") or
    usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(") or
    usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
    usesIntHelper(calls, "lite$ioClearWriter(") or usesIntHelper(calls, "lite$ioReaderOk(") or
    usesIntHelper(calls, "lite$ioReaderAtEof(") or usesIntHelper(calls, "lite$ioReaderError(") or
    usesIntHelper(calls, "lite$ioRead(") or usesIntHelper(calls, "lite$ioCloseReader(") or
    usesIntHelper(calls, "lite$ioWriterOk(") or usesIntHelper(calls, "lite$ioWriterError(") or
    usesIntHelper(calls, "lite$ioWrite(") or usesIntHelper(calls, "lite$ioFlush(") or
    usesIntHelper(calls, "lite$ioCloseWriter(")
};

/** True when any emitted item calls a core/file non-stream filesystem builtin. */
usesFileBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$fileKind(") or usesIntHelper(calls, "lite$fileListDir(") or
    usesIntHelper(calls, "lite$fileMakeDir(") or usesIntHelper(calls, "lite$fileRemove(") or
    usesIntHelper(calls, "lite$fileCopy(") or usesIntHelper(calls, "lite$fileSymlink(") or
    usesIntHelper(calls, "lite$fileRealPath(") or usesIntHelper(calls, "lite$fileMakeTempDir(")
};

/** True when any emitted item calls a core/process query builtin. */
usesProcessQueryBuiltins := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$processCwd(") or usesIntHelper(calls, "lite$processExecPath(") or
    usesIntHelper(calls, "lite$processEntryPath(") or usesIntHelper(calls, "lite$processPlatform(") or
    usesIntHelper(calls, "lite$processArch(") or usesIntHelper(calls, "lite$processRuntimeVersion(") or
    usesIntHelper(calls, "lite$processEnvGet(")
};

/** True when any emitted item needs POSIX OS headers (`unistd.h`, `fcntl.h`, `sys/stat.h`, `dirent.h`). */
usesPosixHost := fn(calls: String): Bool {
    usesStreamBuiltins(calls) or usesFileBuiltins(calls) or usesProcessQueryBuiltins(calls)
};

/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program needs checked dynamic Int* arithmetic or narrow range guards. */
usesIntArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
    usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(") or
    usesIntHelper(calls, "lt_checked_narrow_int(")
}

/** True when binary64/binary32 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float32_op(") or usesIntHelper(calls, "lt_float_power(")
}

/** Emits checked binary64/binary32 operations; caller temporaries preserve left-to-right operand effects. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesIntHelper(calls, "lt_float_power(") {
        io.outputLine("static double lt_float_power(double left, double right, size_t at) {");
        io.outputLine("    if (left == 0 && right < 0) { lt_int_fault(at, \"zero cannot be raised to a negative power\"); }");
        io.outputLine("    double value = pow(left, right);");
        io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_float32_op(") {
        io.outputLine("static double lt_float32_op(double left, double right, int op, size_t at) {");
        io.outputLine("    const float l = (float)left;");
        io.outputLine("    const float r = (float)right;");
        io.outputLine("    if (op == 3 && r == 0.0f) { lt_int_fault(at, \"division by zero\"); }");
        io.outputLine("    float value = op == 0 ? l + r : op == 1 ? l - r : op == 2 ? l * r : l / r;");
        io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        io.outputLine("    return (double)value;");
        io.outputLine("}");
    }
    if not usesIntHelper(calls, "lt_float_op(") { return; }
    io.outputLine("static double lt_float_op(double left, double right, int op, size_t at) {");
    io.outputLine("    if (op == 3 && right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
    io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
    io.outputLine("    return value;");
    io.outputLine("}");
}

/** True when a program calls `core/text` UTF-8 scalar primitives. */
usesTextPrimitives := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
    usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(")
}

/** True when `calls` references any bounds-checked C11 list helper for `tag`. */
/** True when any list or map bounds helper is called in `calls`. */
usesAnyListBounds := fn(calls: String): Bool {
    if calls == "|" { return false; }
    size := textLib.length(calls);
    var start := 1;
    loop start < size {
        sep := textLib.indexOfText(calls, "|", start);
        end := if sep >= 0 { sep } else { size };
        tok := textLib.slice(calls, start, end);
        if textLib.startsWithAt(tok, 0, "lt_list_") and (
            textLib.endsWith(tok, "_at(") or textLib.endsWith(tok, "_set(") or
            textLib.endsWith(tok, "_pop_back(") or textLib.endsWith(tok, "_pop_front(") or
            textLib.endsWith(tok, "_slice(") or textLib.endsWith(tok, "_slice_from(")
        ) {
            return true;
        }
        if textLib.startsWithAt(tok, 0, "lt_map_") and textLib.endsWith(tok, "_at(") {
            return true;
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
    false
};

/** Emits portable ISO C11 typedef, optional deep copy, and optional print helper for one tuple or nominal record `kind`. */
emitCStructHelpers := fn(kind: String, needCopy: Bool, needPrint: Bool): Unit {
    tag := frontend.cStructTag(kind);
    isRec := frontend.isRecordKind(kind);
    count := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
    if count == 0 {
        io.outputLine("typedef struct { int _empty; } " + tag + ";");
    } else {
        var fields := "";
        var i := 0;
        loop i < count {
            comp := if isRec { frontend.recordComponent(kind, i) } else { frontend.tupleComponent(kind, i) };
            fields = fields + cScalarType(comp.kind) + " " + frontend.cFieldName(comp.prop) + "; ";
            i = i + 1;
        }
        io.outputLine("typedef struct { " + fields + "} " + tag + ";");
    }
    if needCopy and frontend.cTypeHasListField(kind) {
        io.outputLine("static " + tag + " " + tag + "_copy(" + tag + " src) {");
        if count == 0 {
            io.outputLine("    return src;");
        } else {
            var inits := "";
            var ci := 0;
            loop ci < count {
                comp := if isRec { frontend.recordComponent(kind, ci) } else { frontend.tupleComponent(kind, ci) };
                if ci > 0 { inits = inits + ", "; }
                fnm := frontend.cFieldName(comp.prop);
                fVal := if cListTagForKind(comp.kind) =!= "" {
                    "lt_list_" + cListTagForKind(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cMapTag(comp.kind) =!= "" {
                    frontend.cMapTag(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cSetTag(comp.kind) =!= "" {
                    frontend.cSetTag(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cStructTag(comp.kind) =!= "" and frontend.cTypeHasListField(comp.kind) {
                    frontend.cStructTag(comp.kind) + "_copy(src." + fnm + ")"
                } else {
                    "src." + fnm
                };
                inits = inits + "." + fnm + " = " + fVal;
                ci = ci + 1;
            }
            io.outputLine("    return (" + tag + "){ " + inits + " };");
        }
        io.outputLine("}");
    }
    if needPrint {
        io.outputLine("static int " + tag + "_print(" + tag + " v) {");
        if isRec {
            recName := frontend.recordDisplayName(kind);
            if count == 0 {
                io.outputLine("    (void)v;");
                io.outputLine("    return printf(\"%s\", " + cLiteral.textLiteralCode(recName + " {}") + ");");
            } else {
                io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(recName + " { ") + ") < 0) { return -1; }");
                var pi := 0;
                loop pi < count {
                    comp := frontend.recordComponent(kind, pi);
                    sep := if pi == 0 { "" } else { ", " };
                    io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(sep + comp.label + " = ") + ") < 0) { return -1; }");
                    io.outputLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                    pi = pi + 1;
                }
                io.outputLine("    return printf(\" }\");");
            }
        } else {
            io.outputLine("    if (printf(\"(\") < 0) { return -1; }");
            var pi := 0;
            loop pi < count {
                comp := frontend.tupleComponent(kind, pi);
                sep := if pi == 0 { "" } else { ", " };
                prefixTxt := if comp.label == "" { sep } else { sep + comp.label + "=" };
                if prefixTxt =!= "" {
                    io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(prefixTxt) + ") < 0) { return -1; }");
                }
                io.outputLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                pi = pi + 1;
            }
            if count == 0 { io.outputLine("    (void)v;"); }
            ending := if count == 1 { ",)" } else { ")" };
            io.outputLine("    return printf(" + cLiteral.textLiteralCode(ending) + ");");
        }
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits one C11 tuple-label conversion helper converting `actualKind` to `expectedKind`. */
emitCTupleConvHelper := fn(expectedKind: String, actualKind: String): Unit {
    expTag := frontend.cStructTag(expectedKind);
    actTag := frontend.cStructTag(actualKind);
    fnName := frontend.cTupleConvertName(expectedKind, actualKind);
    count := frontend.tupleComponentCount(expectedKind);
    io.outputLine("static " + expTag + " " + fnName + "(" + actTag + " v) {");
    if count == 0 {
        io.outputLine("    (void)v; return (" + expTag + "){ ._empty = 0 };");
    } else {
        var inits := "";
        var i := 0;
        loop i < count {
            eComp := frontend.tupleComponent(expectedKind, i);
            aComp := frontend.tupleComponent(actualKind, i);
            if i > 0 { inits = inits + ", "; }
            aExpr := "v." + frontend.cFieldName(aComp.prop);
            fVal := if cListTagForKind(eComp.kind) =!= "" {
                "lt_list_" + cListTagForKind(eComp.kind) + "_copy(" + aExpr + ")"
            } else if frontend.cStructTag(eComp.kind) =!= "" and frontend.cTypeHasListField(eComp.kind) {
                frontend.cStructTag(eComp.kind) + "_copy(" + aExpr + ")"
            } else {
                aExpr
            };
            inits = inits + "." + frontend.cFieldName(eComp.prop) + " = " + fVal;
            i = i + 1;
        }
        io.outputLine("    return (" + expTag + "){ " + inits + " };");
    }
    io.outputLine("}");
    io.outputLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Map<K, V>` struct and only the helpers used for `kind`. */
emitCMapHelpers := fn(kind: String, calls: String, needCopy: Bool, needPrint: Bool): Unit {
    kKind := frontend.mapKeyKind(kind);
    vKind := frontend.mapValueKind(kind);
    mTag := frontend.cMapTag(kind);
    kTag := frontend.cMapKeyTag(kKind);
    kType := cScalarType(kKind);
    vType := cScalarType(vKind);
    kEq := if kTag == "str" { "strcmp(a, b) == 0" } else { "a == b" };
    vCopy := if cListTagForKind(vKind) =!= "" { "lt_list_" + cListTagForKind(vKind) + "_copy(v)" }
    else if frontend.cMapTag(vKind) =!= "" { frontend.cMapTag(vKind) + "_copy(v)" }
    else if frontend.cSetTag(vKind) =!= "" { frontend.cSetTag(vKind) + "_copy(v)" }
    else if frontend.cStructTag(vKind) =!= "" and frontend.cTypeHasListField(vKind) { frontend.cStructTag(vKind) + "_copy(v)" }
    else { "v" };
    hasFrom := usesIntHelper(calls, mTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, mTag + "_copy(");
    hasSet := usesIntHelper(calls, mTag + "_set(");
    hasHas := usesIntHelper(calls, mTag + "_has(");
    hasAt := usesIntHelper(calls, mTag + "_at(");
    hasGet := usesIntHelper(calls, mTag + "_get(");
    hasGetOr := usesIntHelper(calls, mTag + "_get_or(");
    hasRemove := usesIntHelper(calls, mTag + "_remove(");
    hasClear := usesIntHelper(calls, mTag + "_clear(");
    hasKeys := usesIntHelper(calls, mTag + "_keys(");
    hasValues := usesIntHelper(calls, mTag + "_values(");
    io.outputLine("typedef struct { " + kType + " key; " + vType + " val; } " + mTag + "_entry;");
    io.outputLine("typedef struct { " + mTag + "_entry *data; int64_t len; int64_t cap; } " + mTag + ";");
    needFind := hasFrom or hasSet or hasHas or hasAt or hasGet or hasGetOr or hasRemove;
    if needFind {
        io.outputLine("static bool " + mTag + "_keq(" + kType + " a, " + kType + " b) { return " + kEq + "; }");
        io.outputLine("static int64_t " + mTag + "_find(" + mTag + " m, " + kType + " k) {");
        io.outputLine("    for (int64_t i = 0; i < m.len; i += 1) { if (" + mTag + "_keq(m.data[i].key, k)) { return i; } }");
        io.outputLine("    return -1;");
        io.outputLine("}");
    }
    if hasFrom or hasSet {
        io.outputLine("static void " + mTag + "_set(" + mTag + " *m, " + kType + " k, " + vType + " v) {");
        io.outputLine("    int64_t idx = " + mTag + "_find(*m, k);");
        io.outputLine("    if (idx >= 0) { m->data[idx].val = v; return; }");
        io.outputLine("    if (m->len >= m->cap) {");
        io.outputLine("        int64_t next = m->cap > 0 ? m->cap * 2 : 8;");
        io.outputLine("        " + mTag + "_entry *buf = realloc(m->data, (size_t)next * sizeof(" + mTag + "_entry));");
        io.outputLine("        if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow map\\n\"); exit(1); }");
        io.outputLine("        m->data = buf; m->cap = next;");
        io.outputLine("    }");
        io.outputLine("    m->data[m->len].key = k; m->data[m->len].val = v; m->len += 1;");
        io.outputLine("}");
    }
    if hasFrom {
        io.outputLine("static " + mTag + " " + mTag + "_from(int64_t count, const " + mTag + "_entry *elems) {");
        io.outputLine("    " + mTag + " out = { NULL, 0, 0 };");
        io.outputLine("    for (int64_t i = 0; i < count; i += 1) { " + mTag + "_set(&out, elems[i].key, elems[i].val); }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasCopy {
        io.outputLine("static " + mTag + " " + mTag + "_copy(" + mTag + " src) {");
        io.outputLine("    " + mTag + " out = { NULL, src.len, src.len };");
        io.outputLine("    if (src.len > 0) {");
        io.outputLine("        out.data = malloc((size_t)src.len * sizeof(" + mTag + "_entry));");
        io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate map\\n\"); exit(1); }");
        if vCopy == "v" {
            io.outputLine("        memcpy(out.data, src.data, (size_t)src.len * sizeof(" + mTag + "_entry));");
        } else {
            io.outputLine("        for (int64_t i = 0; i < src.len; i += 1) { " + vType + " v = src.data[i].val; out.data[i].key = src.data[i].key; out.data[i].val = " + vCopy + "; }");
        }
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasHas {
        io.outputLine("static bool " + mTag + "_has(" + mTag + " m, " + kType + " k) { return " + mTag + "_find(m, k) >= 0; }");
    }
    if hasAt {
        io.outputLine("static " + vType + " " + mTag + "_at(" + mTag + " m, " + kType + " k, size_t at) {");
        io.outputLine("    int64_t idx = " + mTag + "_find(m, k);");
        io.outputLine("    if (idx < 0) { lt_bound_fault(at, \"map key not found\"); }");
        io.outputLine("    " + vType + " v = m.data[idx].val; return " + vCopy + ";");
        io.outputLine("}");
    }
    if hasGet {
        resTag := frontend.cStructTag("(found:Bool,value:" + vKind + ")");
        io.outputLine("static " + resTag + " " + mTag + "_get(" + mTag + " m, " + kType + " k, " + vType + " zero) {");
        io.outputLine("    int64_t idx = " + mTag + "_find(m, k);");
        io.outputLine("    if (idx < 0) { return (" + resTag + "){ .f_found = false, .f_value = zero }; }");
        io.outputLine("    " + vType + " v = m.data[idx].val; return (" + resTag + "){ .f_found = true, .f_value = " + vCopy + " };");
        io.outputLine("}");
    }
    if hasGetOr {
        io.outputLine("static " + vType + " " + mTag + "_get_or(" + mTag + " m, " + kType + " k, " + vType + " fb) {");
        io.outputLine("    int64_t idx = " + mTag + "_find(m, k);");
        io.outputLine("    if (idx < 0) { return fb; }");
        io.outputLine("    " + vType + " v = m.data[idx].val; return " + vCopy + ";");
        io.outputLine("}");
    }
    if hasRemove {
        io.outputLine("static bool " + mTag + "_remove(" + mTag + " *m, " + kType + " k) {");
        io.outputLine("    int64_t idx = " + mTag + "_find(*m, k);");
        io.outputLine("    if (idx < 0) { return false; }");
        io.outputLine("    if (idx + 1 < m->len) { memmove(m->data + idx, m->data + idx + 1, (size_t)(m->len - idx - 1) * sizeof(" + mTag + "_entry)); }");
        io.outputLine("    m->len -= 1; return true;");
        io.outputLine("}");
    }
    if hasClear {
        io.outputLine("static void " + mTag + "_clear(" + mTag + " *m) { m->len = 0; }");
    }
    if hasKeys {
        kListType := "lt_list_" + kTag;
        io.outputLine("static " + kListType + " " + mTag + "_keys(" + mTag + " m) {");
        io.outputLine("    " + kListType + " out = { NULL, m.len, m.len, NULL };");
        io.outputLine("    if (m.len > 0) {");
        io.outputLine("        out.data = malloc((size_t)m.len * sizeof(" + kType + "));");
        io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        io.outputLine("        for (int64_t i = 0; i < m.len; i += 1) { out.data[i] = m.data[i].key; }");
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasValues {
        vListTag := frontend.cListTag(vKind);
        if vListTag =!= "" {
            vListType := "lt_list_" + vListTag;
            io.outputLine("static " + vListType + " " + mTag + "_values(" + mTag + " m) {");
            io.outputLine("    " + vListType + " out = { NULL, m.len, m.len, NULL };");
            io.outputLine("    if (m.len > 0) {");
            io.outputLine("        out.data = malloc((size_t)m.len * sizeof(" + vType + "));");
            io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
            io.outputLine("        for (int64_t i = 0; i < m.len; i += 1) { " + vType + " v = m.data[i].val; out.data[i] = " + vCopy + "; }");
            io.outputLine("    }");
            io.outputLine("    return out;");
            io.outputLine("}");
        }
    }
    if needPrint {
        io.outputLine("static int " + mTag + "_print(" + mTag + " m) {");
        io.outputLine("    if (printf(\"{\") < 0) { return -1; }");
        io.outputLine("    for (int64_t i = 0; i < m.len; i += 1) {");
        io.outputLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        io.outputLine("        if (" + cCall(kKind, "m.data[i].key") + " < 0) { return -1; }");
        io.outputLine("        if (printf(\": \") < 0) { return -1; }");
        io.outputLine("        if (" + cCall(vKind, "m.data[i].val") + " < 0) { return -1; }");
        io.outputLine("    }");
        io.outputLine("    return printf(\"}\");");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Set<T>` struct and only the helpers used for `kind`. */
emitCSetHelpers := fn(kind: String, calls: String, needCopy: Bool, needPrint: Bool): Unit {
    eKind := frontend.setElementKind(kind);
    sTag := frontend.cSetTag(kind);
    kTag := frontend.cMapKeyTag(eKind);
    eType := cScalarType(eKind);
    eConstPtr := if kTag == "str" { "const char *const *" } else { "const " + eType + " *" };
    kEq := if kTag == "str" { "strcmp(a, b) == 0" } else { "a == b" };
    hasFrom := usesIntHelper(calls, sTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, sTag + "_copy(");
    hasAdd := usesIntHelper(calls, sTag + "_add(");
    hasHas := usesIntHelper(calls, sTag + "_has(");
    hasRemove := usesIntHelper(calls, sTag + "_remove(");
    hasClear := usesIntHelper(calls, sTag + "_clear(");
    hasValues := usesIntHelper(calls, sTag + "_values(");
    io.outputLine("typedef struct { " + eType + " *data; int64_t len; int64_t cap; } " + sTag + ";");
    needFind := hasFrom or hasAdd or hasHas or hasRemove;
    if needFind {
        io.outputLine("static bool " + sTag + "_eq(" + eType + " a, " + eType + " b) { return " + kEq + "; }");
        io.outputLine("static int64_t " + sTag + "_find(" + sTag + " s, " + eType + " v) {");
        io.outputLine("    for (int64_t i = 0; i < s.len; i += 1) { if (" + sTag + "_eq(s.data[i], v)) { return i; } }");
        io.outputLine("    return -1;");
        io.outputLine("}");
    }
    if hasFrom or hasAdd {
        io.outputLine("static void " + sTag + "_add(" + sTag + " *s, " + eType + " v) {");
        io.outputLine("    if (" + sTag + "_find(*s, v) >= 0) { return; }");
        io.outputLine("    if (s->len >= s->cap) {");
        io.outputLine("        int64_t next = s->cap > 0 ? s->cap * 2 : 8;");
        io.outputLine("        " + eType + " *buf = realloc(s->data, (size_t)next * sizeof(" + eType + "));");
        io.outputLine("        if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow set\\n\"); exit(1); }");
        io.outputLine("        s->data = buf; s->cap = next;");
        io.outputLine("    }");
        io.outputLine("    s->data[s->len++] = v;");
        io.outputLine("}");
    }
    if hasFrom {
        io.outputLine("static " + sTag + " " + sTag + "_from(int64_t count, " + eConstPtr + "elems) {");
        io.outputLine("    " + sTag + " out = { NULL, 0, 0 };");
        io.outputLine("    for (int64_t i = 0; i < count; i += 1) { " + sTag + "_add(&out, elems[i]); }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasCopy {
        io.outputLine("static " + sTag + " " + sTag + "_copy(" + sTag + " src) {");
        io.outputLine("    " + sTag + " out = { NULL, src.len, src.len };");
        io.outputLine("    if (src.len > 0) {");
        io.outputLine("        out.data = malloc((size_t)src.len * sizeof(" + eType + "));");
        io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate set\\n\"); exit(1); }");
        io.outputLine("        memcpy(out.data, src.data, (size_t)src.len * sizeof(" + eType + "));");
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasHas {
        io.outputLine("static bool " + sTag + "_has(" + sTag + " s, " + eType + " v) { return " + sTag + "_find(s, v) >= 0; }");
    }
    if hasRemove {
        io.outputLine("static bool " + sTag + "_remove(" + sTag + " *s, " + eType + " v) {");
        io.outputLine("    int64_t idx = " + sTag + "_find(*s, v);");
        io.outputLine("    if (idx < 0) { return false; }");
        io.outputLine("    if (idx + 1 < s->len) { memmove(s->data + idx, s->data + idx + 1, (size_t)(s->len - idx - 1) * sizeof(" + eType + ")); }");
        io.outputLine("    s->len -= 1; return true;");
        io.outputLine("}");
    }
    if hasClear {
        io.outputLine("static void " + sTag + "_clear(" + sTag + " *s) { s->len = 0; }");
    }
    if hasValues {
        vListType := "lt_list_" + kTag;
        io.outputLine("static " + vListType + " " + sTag + "_values(" + sTag + " s) {");
        io.outputLine("    " + vListType + " out = { NULL, s.len, s.len, NULL };");
        io.outputLine("    if (s.len > 0) {");
        io.outputLine("        out.data = malloc((size_t)s.len * sizeof(" + eType + "));");
        io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        io.outputLine("        memcpy(out.data, s.data, (size_t)s.len * sizeof(" + eType + "));");
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if needPrint {
        io.outputLine("static int " + sTag + "_print(" + sTag + " s) {");
        io.outputLine("    if (printf(\"{\") < 0) { return -1; }");
        io.outputLine("    for (int64_t i = 0; i < s.len; i += 1) {");
        io.outputLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        io.outputLine("        if (" + cCall(eKind, "s.data[i]") + " < 0) { return -1; }");
        io.outputLine("    }");
        io.outputLine("    return printf(\"}\");");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits portable ISO C11 list struct and only the helper operations used for `tag` (`i64`, `f64`, `bool`, `str`, or `lt_s_...`). */
emitCListTagHelpers := fn(tag: String, elemKind: String, calls: String, needCopy: Bool, needPrint: Bool, needFrom: Bool): Unit {
    cType := frontend.cListElemType(tag);
    cElemConstPtr := if tag == "str" { "const char *const *" } else { "const " + cType + " *" };
    lType := "lt_list_" + tag;
    elemNeedsDeepCopy := elemKind =!= "" and frontend.cStructTag(elemKind) =!= "" and frontend.cTypeHasListField(elemKind);
    hasFrom := needFrom or usesIntHelper(calls, lType + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, lType + "_copy(");
    hasAt := usesIntHelper(calls, lType + "_at(");
    hasSet := usesIntHelper(calls, lType + "_set(");
    hasPushBack := usesIntHelper(calls, lType + "_push_back(");
    hasPushFront := usesIntHelper(calls, lType + "_push_front(");
    hasPopBack := usesIntHelper(calls, lType + "_pop_back(");
    hasPopFront := usesIntHelper(calls, lType + "_pop_front(");
    hasSliceFrom := usesIntHelper(calls, lType + "_slice_from(");
    hasSlice := usesIntHelper(calls, lType + "_slice(") or hasSliceFrom;
    hasReverse := usesIntHelper(calls, lType + "_reverse(");
    hasClear := usesIntHelper(calls, lType + "_clear(");
    io.outputLine("typedef struct { " + cType + " *data; int64_t len; int64_t cap; int64_t *rc; } " + lType + ";");
    hasMut := hasSet or hasPushBack or hasPushFront or hasPopBack or hasPopFront;
    if hasFrom or hasCopy or hasSlice or hasReverse {
        io.outputLine("static " + lType + " " + lType + "_from(int64_t count, " + cElemConstPtr + "elems) {");
        io.outputLine("    " + lType + " out = { NULL, count, count, NULL };");
        io.outputLine("    if (count > 0) {");
        io.outputLine("        out.data = malloc((size_t)count * sizeof(" + cType + "));");
        io.outputLine("        out.rc = malloc(sizeof(int64_t));");
        io.outputLine("        if (out.data == NULL || out.rc == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        io.outputLine("        *(out.rc) = 1;");
        io.outputLine("        memcpy(out.data, elems, (size_t)count * sizeof(" + cType + "));");
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasCopy {
        io.outputLine("static " + lType + " " + lType + "_copy(" + lType + " src) {");
        io.outputLine("    if (src.len <= 0) { return (" + lType + "){ NULL, 0, 0, NULL }; }");
        io.outputLine("    if (src.rc != NULL) { *(src.rc) += 1; return src; }");
        if elemNeedsDeepCopy {
            io.outputLine("    " + lType + " out = " + lType + "_from(src.len, src.data);");
            io.outputLine("    for (int64_t i = 0; i < out.len; i += 1) { out.data[i] = " + tag + "_copy(out.data[i]); }");
            io.outputLine("    return out;");
        } else {
            io.outputLine("    return " + lType + "_from(src.len, src.data);");
        }
        io.outputLine("}");
    }
    if hasMut {
        io.outputLine("static void " + lType + "_detach(" + lType + " *xs, int64_t min_cap) {");
        io.outputLine("    if (xs->rc != NULL && *(xs->rc) > 1) {");
        io.outputLine("        *(xs->rc) -= 1;");
        io.outputLine("        int64_t ncap = xs->len > min_cap ? xs->len : min_cap;");
        io.outputLine("        if (ncap < 8) { ncap = 8; }");
        io.outputLine("        " + cType + " *buf = malloc((size_t)ncap * sizeof(" + cType + "));");
        io.outputLine("        int64_t *nrc = malloc(sizeof(int64_t));");
        io.outputLine("        if (buf == NULL || nrc == NULL) { fprintf(stderr, \"MemoryFault: cannot detach list\\n\"); exit(1); }");
        io.outputLine("        *nrc = 1;");
        io.outputLine("        if (xs->len > 0) {");
        io.outputLine("            memcpy(buf, xs->data, (size_t)xs->len * sizeof(" + cType + "));");
        if elemNeedsDeepCopy {
            io.outputLine("            for (int64_t i = 0; i < xs->len; i += 1) { buf[i] = " + tag + "_copy(buf[i]); }");
        }
        io.outputLine("        }");
        io.outputLine("        xs->data = buf; xs->cap = ncap; xs->rc = nrc;");
        io.outputLine("    }");
        io.outputLine("}");
    }
    if hasAt {
        io.outputLine("static " + cType + " " + lType + "_at(" + lType + " xs, int64_t idx, size_t at) {");
        io.outputLine("    if (idx < 0 || idx >= xs.len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        io.outputLine("    return xs.data[idx];");
        io.outputLine("}");
    }
    if hasSet {
        io.outputLine("static void " + lType + "_set(" + lType + " *xs, int64_t idx, " + cType + " val, size_t at) {");
        io.outputLine("    if (idx < 0 || idx >= xs->len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        io.outputLine("    " + lType + "_detach(xs, xs->len);");
        io.outputLine("    xs->data[idx] = val;");
        io.outputLine("}");
    }
    if hasPushBack or hasPushFront {
        io.outputLine("static void " + lType + "_grow(" + lType + " *xs, int64_t need) {");
        io.outputLine("    " + lType + "_detach(xs, need);");
        io.outputLine("    if (xs->cap >= need) { return; }");
        io.outputLine("    int64_t next = xs->cap > 0 ? xs->cap * 2 : 8;");
        io.outputLine("    while (next < need) { next *= 2; }");
        io.outputLine("    " + cType + " *buf = realloc(xs->data, (size_t)next * sizeof(" + cType + "));");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow list\\n\"); exit(1); }");
        io.outputLine("    if (xs->rc == NULL) { xs->rc = malloc(sizeof(int64_t)); if (xs->rc == NULL) { fprintf(stderr, \"MemoryFault: cannot grow list\\n\"); exit(1); } *(xs->rc) = 1; }");
        io.outputLine("    xs->data = buf; xs->cap = next;");
        io.outputLine("}");
    }
    if hasPushBack {
        io.outputLine("static void " + lType + "_push_back(" + lType + " *xs, " + cType + " val) {");
        io.outputLine("    " + lType + "_grow(xs, xs->len + 1);");
        io.outputLine("    xs->data[xs->len++] = val;");
        io.outputLine("}");
    }
    if hasPushFront {
        io.outputLine("static void " + lType + "_push_front(" + lType + " *xs, " + cType + " val) {");
        io.outputLine("    " + lType + "_grow(xs, xs->len + 1);");
        io.outputLine("    if (xs->len > 0) { memmove(xs->data + 1, xs->data, (size_t)xs->len * sizeof(" + cType + ")); }");
        io.outputLine("    xs->data[0] = val; xs->len += 1;");
        io.outputLine("}");
    }
    if hasPopBack {
        io.outputLine("static " + cType + " " + lType + "_pop_back(" + lType + " *xs, size_t at) {");
        io.outputLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        io.outputLine("    " + lType + "_detach(xs, xs->len);");
        io.outputLine("    return xs->data[--xs->len];");
        io.outputLine("}");
    }
    if hasPopFront {
        io.outputLine("static " + cType + " " + lType + "_pop_front(" + lType + " *xs, size_t at) {");
        io.outputLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        io.outputLine("    " + lType + "_detach(xs, xs->len);");
        io.outputLine("    " + cType + " head = xs->data[0];");
        io.outputLine("    xs->len -= 1;");
        io.outputLine("    if (xs->len > 0) { memmove(xs->data, xs->data + 1, (size_t)xs->len * sizeof(" + cType + ")); }");
        io.outputLine("    return head;");
        io.outputLine("}");
    }
    if hasSlice {
        io.outputLine("static " + lType + " " + lType + "_slice(" + lType + " xs, int64_t start, int64_t end, size_t at) {");
        io.outputLine("    if (start < 0 || end < start || end > xs.len) { lt_bound_fault(at, \"list slice bounds outside its extent\"); }");
        io.outputLine("    return " + lType + "_from(end - start, xs.data + start);");
        io.outputLine("}");
    }
    if hasSliceFrom {
        io.outputLine("static " + lType + " " + lType + "_slice_from(" + lType + " xs, int64_t start, size_t at) {");
        io.outputLine("    return " + lType + "_slice(xs, start, xs.len, at);");
        io.outputLine("}");
    }
    if hasReverse {
        io.outputLine("static " + lType + " " + lType + "_reverse(" + lType + " xs) {");
        io.outputLine("    " + lType + " out = " + lType + "_from(xs.len, xs.data);");
        io.outputLine("    for (int64_t i = 0; i < out.len / 2; i += 1) { " + cType + " t = out.data[i]; out.data[i] = out.data[out.len - 1 - i]; out.data[out.len - 1 - i] = t; }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasClear {
        io.outputLine("static void " + lType + "_clear(" + lType + " *xs) {");
        io.outputLine("    if (xs->rc != NULL && *(xs->rc) > 1) { *(xs->rc) -= 1; xs->data = NULL; xs->cap = 0; xs->rc = NULL; }");
        io.outputLine("    xs->len = 0;");
        io.outputLine("}");
    }
    if needPrint {
        io.outputLine("static int " + lType + "_print(" + lType + " xs) {");
        io.outputLine("    if (printf(\"[\") < 0) { return -1; }");
        io.outputLine("    for (int64_t i = 0; i < xs.len; i += 1) {");
        io.outputLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        elemPrint := if tag == "i64" { "printf(\"%\" PRId64, xs.data[i])" }
        else if tag == "f64" { "lt_print_float(xs.data[i])" }
        else if tag == "bool" { "printf(\"%s\", xs.data[i] ? \"true\" : \"false\")" }
        else if tag == "str" { "printf(\"%s\", xs.data[i])" }
        else { tag + "_print(xs.data[i])" };
        io.outputLine("        if (" + elemPrint + " < 0) { return -1; }");
        io.outputLine("    }");
        io.outputLine("    return printf(\"]\");");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits portable C11 guards that reject overflow and bounds faults before evaluating operations. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    usesArith := usesIntArithmetic(calls) or usesIntDivision(calls) or usesFloatArithmetic(calls);
    usesBounds := usesIntHelper(calls, "lite$textAt(") or usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(") or
    usesAnyListBounds(calls);
    if not usesArith and not usesBounds { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    io.outputLine("static const size_t lt_int_lines[] = {" + frontend.lineStartCodes(source) + "};");
    io.outputLine("static const char *lt_int_source = " + cLiteral.textLiteralCode(namePrefix) + ";");
    if usesBounds {
        io.outputLine("static _Noreturn void lt_fault(const char *category, size_t at, const char *message) {");
        io.outputLine("    size_t line = 0;");
        io.outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        io.outputLine("    fprintf(stderr, \"%s%zu:%zu: %s: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, category, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
        io.outputLine("static _Noreturn void lt_bound_fault(size_t at, const char *message) { lt_fault(\"BoundPanic\", at, message); }");
        if usesArith {
            io.outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) { lt_fault(\"ArithmeticPanic\", at, message); }");
        }
    } else {
        io.outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) {");
        io.outputLine("    size_t line = 0;");
        io.outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        io.outputLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_add(") {
        io.outputLine("static int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left + right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        io.outputLine("static int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left - right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        io.outputLine("static int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if (left == 0 || right == 0) { return 0; }");
        io.outputLine("    if (left > 0) {");
        io.outputLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
        io.outputLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right > 0) {");
        io.outputLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left * right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        io.outputLine("static int64_t lt_checked_negate(int64_t value, size_t at) {");
        io.outputLine("    if (value == INT64_MIN) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return -value;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_narrow_int(") {
        io.outputLine("static int64_t lt_checked_narrow_int(int64_t value, int bits, const char *name, size_t at) {");
        io.outputLine("    const int64_t limit = INT64_C(1) << (bits - 1);");
        io.outputLine("    if (value < -limit || value >= limit) {");
        io.outputLine("        char message[64];");
        io.outputLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
        io.outputLine("        lt_int_fault(at, message);");
        io.outputLine("    }");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Declares hygienic arithmetic/comparison temporaries at unique assignment sites, skipping quoted text. */
emitArithmeticTemporaries := fn(items: frontend.Items): Unit {
    loop items as item {
        var cursor := 0;
        loop cursor < textLib.length(item.code) {
            ch := textLib.at(item.code, cursor);
            if ch == "\"" {
                cursor = frontend.skipAliasString(item.code, cursor);
            } else if ch == "l" and (textLib.startsWithAt(item.code, cursor, "lt_arg_") or textLib.startsWithAt(item.code, cursor, "lt_cmp_")) {
                end := textLib.skipName(item.code, cursor);
                if textLib.startsWithAt(item.code, end, " = ") {
                    tag := if textLib.startsWithAt(item.code, cursor, "lt_cmp_") or textLib.startsWithAt(item.code, cursor, "lt_arg_f_") { textLib.at(item.code, cursor + 7) } else { "i" };
                    typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                    else if tag == "f" { "double " } else { "int64_t " };
                    io.outputLine("    " + typeCode + textLib.slice(item.code, cursor, end) + ";");
                }
                cursor = end;
            } else { cursor = cursor + 1; }
        }
    }
}

/** Emits shortest round-trip binary64 display with decimal/exponent thresholds shared by the TS runtime; source remains statically checked and no locale is selected by generated programs. */
emitFloatOutputHelpers := fn(): Unit {
    io.outputLine("/* Split printf's positive finite decimal into significant digits and its first-digit exponent. */");
    io.outputLine("static int lt_float_digits(const char *text, char *digits, int *exponent) {");
    io.outputLine("    int size = 0, before = 0, dot = 0;");
    io.outputLine("    const char *at = text;");
    io.outputLine("    while (*at && *at != 'e' && *at != 'E') {");
    io.outputLine("        if (*at == '.') dot = 1;");
    io.outputLine("        else { digits[size++] = *at; if (!dot) before++; }");
    io.outputLine("        at++;");
    io.outputLine("    }");
    io.outputLine("    int power = *at ? (int)strtol(at + 1, NULL, 10) : 0;");
    io.outputLine("    int leading = 0;");
    io.outputLine("    while (leading + 1 < size && digits[leading] == '0') leading++;");
    io.outputLine("    memmove(digits, digits + leading, (size_t)(size - leading));");
    io.outputLine("    size -= leading;");
    io.outputLine("    digits[size] = '\\0';");
    io.outputLine("    *exponent = before - leading - 1 + power;");
    io.outputLine("    return size;");
    io.outputLine("}");
    io.outputLine("/* Move to the adjacent positive decimal having at most precision significant digits. */");
    io.outputLine("static void lt_float_neighbor(char *digits, int precision, int *exponent, int direction) {");
    io.outputLine("    int at = precision - 1;");
    io.outputLine("    if (direction > 0) {");
    io.outputLine("        while (at >= 0 && digits[at] == '9') digits[at--] = '0';");
    io.outputLine("        if (at >= 0) digits[at]++;");
    io.outputLine("        else { digits[0] = '1'; (*exponent)++; }");
    io.outputLine("    } else {");
    io.outputLine("        while (at >= 0 && digits[at] == '0') digits[at--] = '9';");
    io.outputLine("        if (at >= 0) digits[at]--;");
    io.outputLine("        if (digits[0] == '0') {");
    io.outputLine("            for (int i = 0; i < precision; i++) digits[i] = '9';");
    io.outputLine("            (*exponent)--;");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("}");
    io.outputLine("/* Find the least significant-digit count that round-trips, including asymmetric boundary candidates. */");
    io.outputLine("static int lt_float_format(double value, char *out) {");
    io.outputLine("    if (value == 0.0) { strcpy(out, \"0\"); return 1; }");
    io.outputLine("    int negative = value < 0.0;");
    io.outputLine("    double positive = negative ? -value : value;");
    io.outputLine("    char digits[32], nearest[64], adjacent[64];");
    io.outputLine("    int size = 0, exponent = 0, found = 0;");
    io.outputLine("    for (int precision = 1; precision <= 17 && !found; precision++) {");
    io.outputLine("        if (snprintf(nearest, sizeof nearest, \"%.*g\", precision, positive) < 0) return 0;");
    io.outputLine("        size = lt_float_digits(nearest, digits, &exponent);");
    io.outputLine("        if (strtod(nearest, NULL) == positive) { found = 1; break; }");
    io.outputLine("        while (size < precision) digits[size++] = '0';");
    io.outputLine("        digits[size] = '\\0';");
    io.outputLine("        for (int direction = -1; direction <= 1 && !found; direction += 2) {");
    io.outputLine("            char candidate[32]; memcpy(candidate, digits, (size_t)size + 1);");
    io.outputLine("            int power = exponent;");
    io.outputLine("            lt_float_neighbor(candidate, precision, &power, direction);");
    io.outputLine("            if (snprintf(adjacent, sizeof adjacent, \"%se%d\", candidate, power - precision + 1) < 0) return 0;");
    io.outputLine("            if (strtod(adjacent, NULL) == positive) {");
    io.outputLine("                memcpy(digits, candidate, (size_t)size + 1); exponent = power; found = 1;");
    io.outputLine("            }");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    if (!found) return 0;");
    io.outputLine("    while (size > 1 && digits[size - 1] == '0') size--;");
    io.outputLine("    int at = 0;");
    io.outputLine("    if (negative) out[at++] = '-';");
    io.outputLine("    if (exponent >= 21 || exponent < -6) {");
    io.outputLine("        out[at++] = digits[0];");
    io.outputLine("        if (size > 1) { out[at++] = '.'; memcpy(out + at, digits + 1, (size_t)size - 1); at += size - 1; }");
    io.outputLine("        out[at++] = 'e';");
    io.outputLine("        if (exponent >= 0) out[at++] = '+';");
    io.outputLine("        int length = snprintf(out + at, 64u - (size_t)at, \"%d\", exponent);");
    io.outputLine("        if (length < 0) return 0;");
    io.outputLine("        at += length;");
    io.outputLine("    } else if (exponent < 0) {");
    io.outputLine("        out[at++] = '0'; out[at++] = '.';");
    io.outputLine("        for (int i = -1; i > exponent; i--) out[at++] = '0';");
    io.outputLine("        memcpy(out + at, digits, (size_t)size); at += size;");
    io.outputLine("    } else {");
    io.outputLine("        for (int i = 0; i <= exponent || i < size; i++) {");
    io.outputLine("            if (i == exponent + 1) out[at++] = '.';");
    io.outputLine("            out[at++] = i < size ? digits[i] : '0';");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    out[at] = '\\0';");
    io.outputLine("    return 1;");
    io.outputLine("}");
    io.outputLine("static int lt_print_float(double value) {");
    io.outputLine("    char text[64];");
    io.outputLine("    if (!lt_float_format(value, text)) return -1;");
    io.outputLine("    return printf(\"%s\", text);");
    io.outputLine("}");
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic. */
emitIntDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { lt_int_fault(at, \"integer outside Int range\"); }");
    io.outputLine("    return left / right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(): Unit {
    io.outputLine("static int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"remainder by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    return left % right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"modulo by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    io.outputLine("static const char *lite_concat(const char *left, const char *right) {");
    io.outputLine("    const size_t left_length = strlen(left);");
    io.outputLine("    const size_t right_length = strlen(right);");
    io.outputLine("    char *combined = malloc(left_length + right_length + 1);");
    io.outputLine("    if (combined == NULL) {");
    io.outputLine("        fprintf(stderr, \"MemoryFault: cannot allocate concatenated text\\n\");");
    io.outputLine("        exit(1);");
    io.outputLine("    }");
    io.outputLine("    memcpy(combined, left, left_length);");
    io.outputLine("    memcpy(combined + left_length, right, right_length + 1);");
    io.outputLine("    return combined;");
    io.outputLine("}");
    io.outputLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary, preserving non-trivial Unit/Never side effects. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if textLib.startsWithAt(code, 0, "/*@CBLK:") {
        endHdr := textLib.indexOfText(code, "@*/", 8);
        retVar := textLib.slice(code, 8, endHdr);
        blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
        if kind == frontend.VALUE_KIND_NEVER or kind == frontend.VALUE_KIND_UNIT {
            io.outputLine(indent + "{ " + blkBody + " }");
        } else {
            io.outputLine(indent + cScalarType(kind) + " " + name + ";");
            io.outputLine(indent + "{ " + blkBody + " " + name + " = " + retVar + "; }");
        }
        return;
    }
    if kind == frontend.VALUE_KIND_NEVER {
        io.outputLine(indent + "(void)(" + code + ");");
        return;
    }
    if kind == frontend.VALUE_KIND_UNIT {
        if code =!= "0" { io.outputLine(indent + "(void)(" + code + ");"); }
        return;
    }
    typeCode := cScalarType(kind) + " ";
    io.outputLine(indent + typeCode + name + " = " + code + ";");
}

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String, failAction: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { " + failAction + " }\n"
}

/** Emits statements for one C function body (`fnResult != ""`) or `main` (`fnResult == ""`). */
emitCItemStream := fn(stream: frontend.Items, hoistedGlobals: frontend.TokenBuckets, fnResult: String, failAction: String): Unit {
    var indent := "    ";
    var blockDepth := 0;
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    var writes := "";
    var seqLoopId := 0;
    loopSeqFlags: mut List<Int> = [];
    loop stream as item {
        code := normalizeCBuiltinCalls(item.code);
        if isCLocalDeclKind(item.kind) {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                if not (fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime)) {
                    io.outputLine(indent + cDeclTypeItem(item) + item.runtime + ";");
                }
                io.outputLine(indent + "{ " + blkBody + " " + item.runtime + " = " + retVar + "; }");
            } else if fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                io.outputLine(indent + item.runtime + " = " + code + ";");
            } else {
                io.outputLine(indent + cDeclTypeItem(item) + item.runtime + " = " + code + ";");
            }
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_ASSIGN_INT or item.kind == frontend.ITEM_KIND_ASSIGN_STRING or item.kind == frontend.ITEM_KIND_ASSIGN_BOOL or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_LIST {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                io.outputLine(indent + "{ " + blkBody + " " + item.runtime + " = " + retVar + "; }");
            } else {
                io.outputLine(indent + item.runtime + " = " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_RETURN {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                retVar := textLib.slice(code, 8, endHdr);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                if fnResult == frontend.VALUE_KIND_UNIT {
                    io.outputLine(indent + "{ " + blkBody + " } return;");
                } else {
                    io.outputLine(indent + "{ " + cScalarType(fnResult) + " lt_ret; " + blkBody + " lt_ret = " + retVar + "; return lt_ret; }");
                }
            } else if fnResult == frontend.VALUE_KIND_UNIT {
                if code =!= "" { io.outputLine(indent + "(void)(" + code + ");"); }
                io.outputLine(indent + "return;");
            } else if code == "" {
                io.outputLine(indent + "return;");
            } else if textLib.startsWithAt(code, 0, "lt_exit(") {
                io.outputLine(indent + "(void)(" + code + ");");
            } else {
                io.outputLine(indent + "return " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_CALL or item.kind == frontend.ITEM_KIND_DISCARD {
            if textLib.startsWithAt(code, 0, "/*@CBLK:") {
                endHdr := textLib.indexOfText(code, "@*/", 8);
                blkBody := textLib.slice(code, endHdr + 3, textLib.length(code));
                io.outputLine(indent + "{ " + blkBody + " }");
            } else if item.kind == frontend.ITEM_KIND_CALL and textLib.startsWithAt(code, 0, "{ /*c-stmt*/") {
                io.outputLine(indent + code);
            } else {
                io.outputLine(indent + "(void)(" + code + ");");
            }
        } else if item.kind == frontend.ITEM_KIND_UNREACHABLE {
            io.outputLine(indent + "fprintf(stderr, \"unreachable loop completion\\n\");");
            io.outputLine(indent + "exit(1);");
        } else if item.kind == frontend.ITEM_KIND_BREAK {
            io.outputLine(indent + "break;");
        } else if item.kind == frontend.ITEM_KIND_CONTINUE {
            io.outputLine(indent + "continue;");
        } else if item.kind == frontend.ITEM_KIND_SCOPE {
            io.outputLine(indent + "{");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_IF {
            io.outputLine(indent + "if (" + code + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_ELSE {
            indent = dedent(indent);
            io.outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE_IF {
            indent = dedent(indent);
            io.outputLine(indent + "} else if (" + code + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_SCOPE {
            indent = dedent(indent);
            io.outputLine(indent + "}");
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_LOOP {
            condition := if code == "" { "true" } else { code };
            io.outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
            listLib.pushBack(mut loopSeqFlags, 0);
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            seqId := integer.intText(seqLoopId);
            seqLoopId = seqLoopId + 1;
            if item.intValue == 2 or item.intValue == 3 {
                nl := textLib.indexOfText(code, "\n", 0);
                rStart := if nl >= 0 { textLib.slice(code, 0, nl) } else { "0" };
                rEnd := if nl >= 0 { textLib.slice(code, nl + 1, textLib.length(code)) } else { "0" };
                rOp := if item.intValue == 3 { "<=" } else { "<" };
                endVar := "lt_rend_" + seqId;
                idxVar := "lt_ri_" + seqId;
                io.outputLine(indent + "{");
                io.outputLine(indent + "    int64_t " + endVar + " = " + rEnd + ";");
                io.outputLine(indent + "    for (int64_t " + idxVar + " = " + rStart + "; " + idxVar + " " + rOp + " " + endVar + "; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    io.outputLine(indent + "        int64_t " + item.runtime + " = " + idxVar + ";");
                    io.outputLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
            } else if item.intValue == 4 {
                /* Map loop: item.textValue is `(key:K,value:V)`, first `@T:` in item.code is `Map<K,V>`. */
                annots := extractCTypeAnnotations(item.code);
                mapKind := if listLib.length(annots) > 0 and textLib.startsWithAt(annots[0], 0, "T:") { textLib.slice(annots[0], 2, textLib.length(annots[0])) } else { "" };
                mTag := frontend.cMapTag(mapKind);
                entryTag := frontend.cStructTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                io.outputLine(indent + "{");
                io.outputLine(indent + "    " + mTag + " " + seqVar + " = " + mTag + "_copy(" + code + ");");
                io.outputLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    io.outputLine(indent + "        " + entryTag + " " + item.runtime + " = (" + entryTag + "){ .f_key = " + seqVar + ".data[" + idxVar + "].key, .f_value = " + seqVar + ".data[" + idxVar + "].val };");
                    io.outputLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
            } else if item.intValue == 5 {
                /* Set loop: item.textValue is element kind `T`. */
                sTag := frontend.cSetTag("Set<" + item.textValue + ">");
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                io.outputLine(indent + "{");
                io.outputLine(indent + "    " + sTag + " " + seqVar + " = " + sTag + "_copy(" + code + ");");
                io.outputLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    io.outputLine(indent + "        " + cScalarType(item.textValue) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                    io.outputLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
            } else {
                tag := frontend.cListTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                seqInit := if item.intValue == 1 { code } else { "lt_list_" + tag + "_copy(" + code + ")" };
                io.outputLine(indent + "{");
                io.outputLine(indent + "    lt_list_" + tag + " " + seqVar + " = " + seqInit + ";");
                io.outputLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    io.outputLine(indent + "        " + frontend.cListElemType(tag) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                    io.outputLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                listLib.pushBack(mut loopSeqFlags, 1);
            }
        } else if item.kind == frontend.ITEM_KIND_END_LOOP {
            isSeqEnd := if loopSeqFlags.length > 0 { listLib.popBack(mut loopSeqFlags) == 1 } else { false };
            if isSeqEnd {
                indent = dedent(dedent(indent));
                io.outputLine(indent + "    }");
                io.outputLine(indent + "}");
            } else {
                indent = dedent(indent);
                io.outputLine(indent + "}");
            }
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT {
            if count == 1 {
                if textLib.startsWithAt(firstCode, 0, "/*@CBLK:") {
                    oneTemp := "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, oneTemp, indent);
                    io.output(outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { oneTemp }, indent, failAction));
                } else {
                    io.output(outputWriteCode(firstKind, firstCode, indent, failAction));
                }
            }
            else if count > 1 { io.output(writes); }
            if item.kind == frontend.ITEM_KIND_END { io.outputLine(indent + "if (printf(\"\\n\") < 0) { " + failAction + " }"); }
            count = 0;
            writes = "";
        } else if item.kind == frontend.ITEM_KIND_MAIN_STOP or item.kind == frontend.ITEM_KIND_IMPORT or
        item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or
        item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or item.kind == frontend.ITEM_KIND_PURE_GLOBAL or
        item.kind == frontend.ITEM_KIND_SOFT_BUILTIN or item.kind == frontend.ITEM_KIND_NOOP {
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    writes = outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { firstTemp }, indent, failAction);
                }
                temp := "lt_output_" + integer.intText(tempIndex);
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, code, temp, indent);
                writes = writes + indent + "if (printf(\" \") < 0) { " + failAction + " }\n" +
                outputWriteCode(item.kind, if item.kind == frontend.VALUE_KIND_UNIT or item.kind == frontend.VALUE_KIND_NEVER { "0" } else { temp }, indent, failAction);
            }
            count = count + 1;
        }
    }
};

/** Emits one C11 function definition starting at `FUNCTION_START` index `startIndex` and returns the index after `FUNCTION_END`. */
emitOneCFunction := fn(reachable: frontend.Items, startIndex: Int, total: Int, hoistedGlobals: frontend.TokenBuckets): Int {
    fnItem := reachable[startIndex];
    fnItems: mut frontend.Items = [];
    var idx := startIndex + 1;
    var depth := 1;
    loop idx < total {
        item := reachable[idx];
        if item.kind == frontend.ITEM_KIND_FUNCTION_START { depth = depth + 1; }
        else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            depth = depth - 1;
            if depth == 0 {
                idx = idx + 1;
                break;
            }
        }
        listLib.pushBack(mut fnItems, item);
        idx = idx + 1;
    }
    io.outputLine("static " + cScalarType(fnItem.code) + " " + fnItem.runtime + "(" + cParameterList(fnItem.textValue) + ") {");
    emitCParameterReads(fnItem.textValue);
    emitArithmeticTemporaries(fnItems);
    emitCItemStream(fnItems, hoistedGlobals, fnItem.code, "lt_io_status = 1;");
    io.outputLine("}");
    io.outputLine("");
    idx
};

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications and optimization level (`0..3`). */
/** Returns all C-supported struct (`S|<kind>`), list (`L|<elemKind>`), map (`M|<kind>`), and set (`E|<kind>`) types referenced by `kind` in post-order. */
collectSubKinds := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        if frontend.cListTag(elKind) == "" { return out; }
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "L|" + elKind);
        return out;
    }
    if frontend.isMapKind(kind) {
        if frontend.cMapTag(kind) == "" { return out; }
        kKind := frontend.mapKeyKind(kind);
        vKind := frontend.mapValueKind(kind);
        subK := self("List<" + kKind + ">");
        loop subK as s { listLib.pushBack(mut out, s); }
        subV := self(vKind);
        loop subV as s { listLib.pushBack(mut out, s); }
        if frontend.cListTag(vKind) =!= "" {
            subVL := self("List<" + vKind + ">");
            loop subVL as s { listLib.pushBack(mut out, s); }
        }
        subGet := self("(found:Bool,value:" + vKind + ")");
        loop subGet as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "M|" + kind);
        return out;
    }
    if frontend.isSetKind(kind) {
        if frontend.cSetTag(kind) == "" { return out; }
        eKind := frontend.setElementKind(kind);
        subE := self("List<" + eKind + ">");
        loop subE as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "E|" + kind);
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        if frontend.cStructTag(kind) == "" { return out; }
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        listLib.pushBack(mut out, "S|" + kind);
        return out;
    }
    out
};

/** Returns all struct/list/map/set tags and `"FLOAT"`/`"FLOAT32"` markers reachable inside `kind` for print/copy/float tracking. */
collectTypeFlags := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isFloatScalarKind(kind) {
        listLib.pushBack(mut out, "FLOAT");
        if kind == frontend.VALUE_KIND_FLOAT32 { listLib.pushBack(mut out, "FLOAT32"); }
        return out;
    }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        tag := frontend.cListTag(elKind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "L:" + tag);
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isMapKind(kind) {
        tag := frontend.cMapTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "M:" + tag);
        subK := self(frontend.mapKeyKind(kind));
        loop subK as s { listLib.pushBack(mut out, s); }
        subV := self(frontend.mapValueKind(kind));
        loop subV as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isSetKind(kind) {
        tag := frontend.cSetTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "E:" + tag);
        subE := self(frontend.setElementKind(kind));
        loop subE as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        tag := frontend.cStructTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "S:" + tag);
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        return out;
    }
    out
};

/** Extracts all `/*@T:<kind>@*/` and `/*@C:<exp>|<act>@*/` payloads from emitted C expression `code`. */
extractCTypeAnnotations := fn(code: String): List<String> {
    out: mut List<String> = [];
    if textLib.indexOfText(code, "/*@", 0) < 0 { return out; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            if endTag < 0 { break; }
            listLib.pushBack(mut out, textLib.slice(code, cursor + 3, endTag));
            cursor = endTag + 3;
        } else {
            cursor = cursor + 1;
        }
    }
    out
};

/** Emits C11 `core/unicode` hard builtin helpers (`toCodePoints`, `fromCodePoints`). */
emitCUnicodeBuiltinHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite$unicodeToCodePoints(") {
        io.outputLine("static lt_list_i64 lt_unicode_to_code_points(const char *text) {");
        io.outputLine("    const uint8_t *p = (const uint8_t *)text;");
        io.outputLine("    int64_t len = 0; int64_t cap = 16;");
        io.outputLine("    int64_t *data = malloc((size_t)cap * sizeof(int64_t));");
        io.outputLine("    if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate code points\\n\"); exit(1); }");
        io.outputLine("    while (*p != 0) {");
        io.outputLine("        int64_t cp = 0xFFFD;");
        io.outputLine("        uint8_t b0 = *p;");
        io.outputLine("        if (b0 < 0x80) { cp = (int64_t)b0; p += 1; }");
        io.outputLine("        else if ((b0 & 0xE0) == 0xC0 && p[1] != 0) { cp = (int64_t)(((b0 & 0x1F) << 6) | (p[1] & 0x3F)); p += 2; }");
        io.outputLine("        else if ((b0 & 0xF0) == 0xE0 && p[1] != 0 && p[2] != 0) { cp = (int64_t)(((b0 & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F)); p += 3; }");
        io.outputLine("        else if ((b0 & 0xF8) == 0xF0 && p[1] != 0 && p[2] != 0 && p[3] != 0) { cp = (int64_t)(((b0 & 0x07) << 18) | ((p[1] & 0x3F) << 12) | ((p[2] & 0x3F) << 6) | (p[3] & 0x3F)); p += 4; }");
        io.outputLine("        else { p += 1; }");
        io.outputLine("        if (len >= cap) { cap *= 2; data = realloc(data, (size_t)cap * sizeof(int64_t)); if (data == NULL) { fprintf(stderr, \"MemoryFault: cannot grow code points\\n\"); exit(1); } }");
        io.outputLine("        data[len++] = cp;");
        io.outputLine("    }");
        io.outputLine("    lt_list_i64 out = { data, len, cap, NULL };");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lite$unicodeFromCodePoints(") {
        okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
        io.outputLine("static " + okTextTag + " lt_unicode_from_code_points(lt_list_i64 points) {");
        io.outputLine("    size_t cap = (size_t)(points.len > 0 ? points.len * 4 : 1) + 1;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate text\\n\"); exit(1); }");
        io.outputLine("    size_t pos = 0;");
        io.outputLine("    for (int64_t i = 0; i < points.len; i += 1) {");
        io.outputLine("        int64_t cp = points.data[i];");
        io.outputLine("        if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {");
        io.outputLine("            free(buf);");
        io.outputLine("            char *msg = malloc(96);");
        io.outputLine("            if (msg == NULL) { return (" + okTextTag + "){ false, \"\", \"invalid Unicode scalar code point\" }; }");
        io.outputLine("            snprintf(msg, 96, \"invalid Unicode scalar code point: %\" PRId64, cp);");
        io.outputLine("            return (" + okTextTag + "){ false, \"\", msg };");
        io.outputLine("        }");
        io.outputLine("        if (cp < 0x80) { buf[pos++] = (char)cp; }");
        io.outputLine("        else if (cp < 0x800) { buf[pos++] = (char)(0xC0 | (cp >> 6)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        io.outputLine("        else if (cp < 0x10000) { buf[pos++] = (char)(0xE0 | (cp >> 12)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        io.outputLine("        else { buf[pos++] = (char)(0xF0 | (cp >> 18)); buf[pos++] = (char)(0x80 | ((cp >> 12) & 0x3F)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        io.outputLine("    }");
        io.outputLine("    buf[pos] = '\\0';");
        io.outputLine("    return (" + okTextTag + "){ true, buf, \"\" };");
        io.outputLine("}");
    }
};

/** Emits C11 `core/io` stream and `core/file` stream-opener helpers. */
emitCStreamBuiltinHelpers := fn(calls: String): Unit {
    if not usesStreamBuiltins(calls) { return; }
    shTag := frontend.cStructTag("(kind:String,handle:Int)");
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
    okWrittenTag := frontend.cStructTag("(ok:Bool,written:Int,error:String)");
    fKind := frontend.cFieldName("kind");
    fHandle := frontend.cFieldName("handle");
    needFileOpen := usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or usesIntHelper(calls, "lite$fileOpenAppender(");
    needAlloc := needFileOpen or usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(");
    needLookup := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
        usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(") or
        usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWriterOk(") or
        usesIntHelper(calls, "lite$ioWriterError(") or usesIntHelper(calls, "lite$ioWrite(") or
        usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") or
        usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
        usesIntHelper(calls, "lite$ioClearWriter(");
    needStdinState := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
        usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(");
    if needAlloc or needLookup {
        io.outputLine("typedef struct { int kind; int fd; uint8_t *buf; int64_t len; int64_t cap; int64_t pos; bool eof; bool closed; const char *error; } lt_stream_entry;");
        io.outputLine("static lt_stream_entry *lt_streams = NULL;");
        io.outputLine("static int64_t lt_streams_len = 0;");
        io.outputLine("static int64_t lt_streams_cap = 0;");
    }
    if needStdinState {
        io.outputLine("static bool lt_stdin_eof = false;");
        io.outputLine("static const char *lt_stdin_err = \"\";");
    }
    if needAlloc {
        io.outputLine("static int64_t lt_alloc_stream(lt_stream_entry entry) {");
        io.outputLine("    if (lt_streams_len >= lt_streams_cap) {");
        io.outputLine("        lt_streams_cap = lt_streams_cap == 0 ? 16 : lt_streams_cap * 2;");
        io.outputLine("        lt_streams = realloc(lt_streams, (size_t)lt_streams_cap * sizeof(lt_stream_entry));");
        io.outputLine("        if (lt_streams == NULL) { fprintf(stderr, \"MemoryFault: cannot grow stream table\\n\"); exit(1); }");
        io.outputLine("    }");
        io.outputLine("    int64_t id = lt_streams_len + 10;");
        io.outputLine("    lt_streams[lt_streams_len++] = entry;");
        io.outputLine("    return id;");
        io.outputLine("}");
    }
    if needLookup {
        io.outputLine("static lt_stream_entry *lt_lookup_stream(int64_t handle) {");
        io.outputLine("    int64_t idx = handle - 10;");
        io.outputLine("    if (idx < 0 || idx >= lt_streams_len) { return NULL; }");
        io.outputLine("    return &lt_streams[idx];");
        io.outputLine("}");
    }
    if needFileOpen {
        io.outputLine("static " + shTag + " lt_file_open_stream(const char *path, int flags, bool for_write) {");
        io.outputLine("    int fd = open(path, flags, 0666);");
        io.outputLine("    if (fd < 0) {");
        io.outputLine("        const char *err = lt_dup_str(strerror(errno));");
        io.outputLine("        lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, err };");
        io.outputLine("        return (" + shTag + "){ \"error\", lt_alloc_stream(e) };");
        io.outputLine("    }");
        io.outputLine("    if (!for_write) {");
        io.outputLine("        struct stat st;");
        io.outputLine("        if (fstat(fd, &st) == 0 && S_ISDIR(st.st_mode)) {");
        io.outputLine("            close(fd);");
        io.outputLine("            lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, \"EISDIR: illegal operation on a directory\" };");
        io.outputLine("            return (" + shTag + "){ \"error\", lt_alloc_stream(e) };");
        io.outputLine("        }");
        io.outputLine("    }");
        io.outputLine("    lt_stream_entry e = { 1, fd, NULL, 0, 0, 0, false, false, \"\" };");
        io.outputLine("    return (" + shTag + "){ \"file\", lt_alloc_stream(e) };");
        io.outputLine("}");
    }
