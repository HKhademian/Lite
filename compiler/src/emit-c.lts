/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Builds one checked printf call for an Int, String or Bool report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    if kind == "Unit" {
        "printf(\"Unit\")"
    } else if kind == "Float" {
        "printf(\"%g\", (double)(" + code + "))"
    } else if kind == "Int" {
        "printf(\"%\" PRId64, (int64_t)(" + code + "))"
    } else if kind == "Bool" {
        "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))"
    } else {
        "printf(\"%s\", " + code + ")"
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    indexOfText(calls, "|" + name + "|", 0) >= 0
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: String): String {
    if usesIntHelper(calls, "lite$inputArgs(") or usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(") {
        "C backend does not support input builtins yet"
    } else if usesIntHelper(calls, "lite$reportError(") or usesIntHelper(calls, "lite$exit(") {
        "C backend does not support reportError or exit yet"
    } else if usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
        usesIntHelper(calls, "lite$textSlice(") {
        "C backend does not support text builtins yet"
    } else {
        ""
    }
}


/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program needs checked dynamic Int64 arithmetic. */
usesIntArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
        usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(")
}

/** Emits portable C11 guards that reject overflow before evaluating a signed operation. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    if not usesIntArithmetic(calls) and not usesIntDivision(calls) { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    outputLine("static const size_t lt_int_lines[] = {" + lineStartCodes(source) + "};");
    outputLine("static const char *lt_int_source = " + textLiteralCode(namePrefix) + ";");
    outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) {");
    outputLine("    size_t line = 0;");
    outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
    outputLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
    outputLine("    exit(1);");
    outputLine("}");
    if usesIntHelper(calls, "lt_checked_add(") {
        outputLine("static int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        outputLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    return left + right;");
        outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        outputLine("static int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        outputLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    return left - right;");
        outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        outputLine("static int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        outputLine("    if (left == 0 || right == 0) { return 0; }");
        outputLine("    if (left > 0) {");
        outputLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
        outputLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    } else if (right > 0) {");
        outputLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    return left * right;");
        outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        outputLine("static int64_t lt_checked_negate(int64_t value, size_t at) {");
        outputLine("    if (value == INT64_MIN) { lt_int_fault(at, \"integer outside Int range\"); }");
        outputLine("    return -value;");
        outputLine("}");
    }
    outputLine("");
}

/** Declares hygienic arithmetic/comparison temporaries at unique assignment sites, skipping quoted text. */
emitArithmeticTemporaries := fn(items: Items): Unit {
    loop items as item {
        var cursor := 0;
        loop cursor < textLength(item.code) {
            ch := textAt(item.code, cursor);
            if ch == "\"" {
                cursor = skipAliasString(item.code, cursor);
            } else if ch == "l" and (startsWithAt(item.code, cursor, "lt_arg_") or startsWithAt(item.code, cursor, "lt_cmp_")) {
                end := skipName(item.code, cursor);
                if startsWithAt(item.code, end, " = ") {
                    tag := if startsWithAt(item.code, cursor, "lt_cmp_") { textAt(item.code, cursor + 7) } else { "i" };
                    typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                        else if tag == "f" { "double " } else { "int64_t " };
                    outputLine("    " + typeCode + textSlice(item.code, cursor, end) + ";");
                }
                cursor = end;
            } else { cursor = cursor + 1; }
        }
    }
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic. */
emitIntDivideHelper := fn(): Unit {
    outputLine("static int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    outputLine("    if (right == 0) { lt_int_fault(at, \"division by zero\"); }");
    outputLine("    if (left == INT64_MIN && right == -1) { lt_int_fault(at, \"integer outside Int range\"); }");
    outputLine("    return left / right;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(): Unit {
    outputLine("static int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    outputLine("    if (right == 0) { lt_int_fault(at, \"remainder by zero\"); }");
    outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    outputLine("    return left % right;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    outputLine("static int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    outputLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    outputLine("    const int64_t remainder = left % right;");
    outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    outputLine("}");
    outputLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(): Unit {
    outputLine("static int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    outputLine("    if (right == 0) { lt_int_fault(at, \"modulo by zero\"); }");
    outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    outputLine("    const int64_t remainder = left % right;");
    outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    outputLine("}");
    outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    outputLine("static const char *lite_concat(const char *left, const char *right) {");
    outputLine("    const size_t left_length = strlen(left);");
    outputLine("    const size_t right_length = strlen(right);");
    outputLine("    char *combined = malloc(left_length + right_length + 1);");
    outputLine("    if (combined == NULL) {");
    outputLine("        fprintf(stderr, \"MemoryFault: cannot allocate concatenated text\\n\");");
    outputLine("        exit(1);");
    outputLine("    }");
    outputLine("    memcpy(combined, left, left_length);");
    outputLine("    memcpy(combined + left_length, right, right_length + 1);");
    outputLine("    return combined;");
    outputLine("}");
    outputLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary. Unit has no stored payload or supported C-side effect. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if kind == "Unit" { return; }
    typeCode := if kind == "Int" { "int64_t " }
        else if kind == "Bool" { "bool " }
        else if kind == "Float" { "double " }
        else { "const char *" };
    outputLine(indent + typeCode + name + " = " + code + ";");
}

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { status = 1; }\n"
}

/** Emits the C program from the flat item stream. Multi-value output evaluates its arguments before any write; every printf keeps the shared write-failure status. */
emitProgram := fn(items: Items, source: String, prefix: String): Unit {
    calls := targetHelperCalls(items);
    loop items as item {
        if item.kind == "FunctionStart" {
            fail("", "C backend does not support top-level functions yet");
        }
        unsupported := unsupportedBuiltinCode(targetCodeCalls(item.code, "|"));
        if unsupported =!= "" {
            fail("", unsupported);
        }
        if isTupleKind(item.kind) or (item.kind == "Discard" and isTupleKind(item.name)) or item.kind == "LocalTuple" or item.kind == "VarTuple" or item.kind == "AssignTuple" {
            fail("", "C backend does not support tuple values yet");
        }
        if isListKind(item.kind) or (item.kind == "Discard" and isListKind(item.name)) or item.kind == "LocalList" or item.kind == "VarList" or item.kind == "AssignList" {
            fail("", "C backend does not support list values yet");
        }
        if item.kind == "LoopSeq" {
            fail("", "C backend does not support list traversal yet");
        }
        if codeUsesListIndex(item.code) or codeUsesListPop(item.code) {
            fail("", "C backend does not support list values yet");
        }
        if codeUsesValueIf(item.code) {
            fail("", "C backend does not support value if expressions yet");
        }
    }
    outputLine("#include <stdio.h>");
    if usesIntDivision(calls) or usesStringConcat(calls) or usesIntArithmetic(calls) { outputLine("#include <stdlib.h>"); }
    outputLine("#include <inttypes.h>");
    outputLine("#include <stdbool.h>");
    outputLine("#include <string.h>");
    emitIntArithmeticHelpers(calls, source, prefix);
    emitIntDivisionHelpers(calls);
    if usesStringConcat(calls) { emitStringConcatHelper(); }
    outputLine("int main(void) {");
    outputLine("    int status = 0;");
    emitArithmeticTemporaries(items);
    var indent := "    ";
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    var writes := "";
    loop items as item {
        if item.kind == "LocalInt" or item.kind == "VarInt" {
            outputLine(indent + "int64_t " + item.runtime + " = " + item.code + ";");
            outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalString" or item.kind == "VarString" {
            outputLine(indent + "const char *" + item.runtime + " = " + item.code + ";");
            outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalFloat" or item.kind == "VarFloat" {
            outputLine(indent + "double " + item.runtime + " = " + item.code + ";");
            outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalBool" or item.kind == "VarBool" {
            outputLine(indent + "bool " + item.runtime + " = " + item.code + ";");
            outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" or item.kind == "AssignFloat" {
            outputLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "Discard" {
            outputLine(indent + "(void)(" + item.code + ");");
        } else if item.kind == "Break" {
            outputLine(indent + "break;");
        } else if item.kind == "Continue" {
            outputLine(indent + "continue;");
        } else if item.kind == "Scope" {
            outputLine(indent + "{");
            indent = indent + "    ";
        } else if item.kind == "If" {
            outputLine(indent + "if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "ElseIf" {
            indent = dedent(indent);
            outputLine(indent + "} else if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" or item.kind == "EndScope" {
            indent = dedent(indent);
            outputLine(indent + "}");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "true" } else { item.code };
            outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            outputLine(indent + "}");
        } else if item.kind == "End" or item.kind == "EndOutput" {
            if count == 1 { output(outputWriteCode(firstKind, firstCode, indent)); }
            else if count > 1 { output(writes); }
            if item.kind == "End" { outputLine(indent + "if (printf(\"\\n\") < 0) { status = 1; }"); }
            count = 0;
            writes = "";
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = item.code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    writes = outputWriteCode(firstKind, firstTemp, indent);
                }
                temp := "lt_output_" + intText(tempIndex);
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, item.code, temp, indent);
                writes = writes + indent + "if (printf(\" \") < 0) { status = 1; }\n" + outputWriteCode(item.kind, temp, indent);
            }
            count = count + 1;
        }
    }
    outputLine("    return status;");
    outputLine("}");
}
