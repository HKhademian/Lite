frontend := import "./frontend.lts";
cLiteral := import "./c-literals.lts";
integer := import "core/int";
listLib := import "core/list";
diagLib := import "core/diag";
io := import "core/io";
textLib := import "core/text";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textLib.slice(indent, 0, textLib.length(indent) - 4)
}

/** Returns the C11 scalar list tag (`i64`, `f64`, `bool`, `str`) for a List/Array kind, or `""` if not a C-supported list/array. */
cListTagForKind := fn(kind: String): String {
    if frontend.isListKind(kind) { frontend.cListTag(frontend.listElementKind(kind)) }
    else if frontend.isArrayKind(kind) { frontend.cListTag(frontend.arrayElementKind(kind)) }
    else { "" }
};

/** Maps a restricted Lite scalar, enum, struct, list/array, or Unit/Never kind to its C11 type. */
cScalarType := fn(kind: String): String {
    listTag := cListTagForKind(kind);
    if listTag =!= "" { "lt_list_" + listTag }
    else if frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) }
    else if kind == frontend.VALUE_KIND_UNIT or kind == frontend.VALUE_KIND_NEVER { "void" }
    else if frontend.isIntScalarKind(kind) or frontend.isEnumKind(kind) { "int64_t" }
    else if kind == frontend.VALUE_KIND_BOOL { "bool" }
    else if frontend.isFloatScalarKind(kind) { "double" }
    else { "const char *" }
};

/** Maps a local or mutable variable item to its C11 declaration type prefix. */
cDeclTypeItem := fn(item: frontend.Item): String {
    kind := item.kind;
    if kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST {
        "lt_list_" + cListTagForKind(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE {
        frontend.cStructTag(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD {
        if frontend.isEnumKind(item.textValue) { "int64_t " } else { frontend.cStructTag(item.textValue) + " " }
    } else if kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT { "int64_t " }
    else if kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT { "double " }
    else if kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL { "bool " }
    else { "const char *" }
};

/** Fails cleanly when a reachable scalar/function signature references an unsupported C type. */
checkUnsupportedCType := fn(kind: String): Unit {
    if frontend.isTupleKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support tuple values yet"); }
    if frontend.isMapKind(kind) { diagLib.fail("", "C backend does not support map values yet"); }
    if frontend.isSetKind(kind) { diagLib.fail("", "C backend does not support set values yet"); }
    if frontend.isRecordKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support record values yet"); }
    if frontend.isListKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support list values yet"); }
    if frontend.isArrayKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support array values yet"); }
    if frontend.containsFnKind(kind) { diagLib.fail("", "C backend does not support function values yet"); }
};

/** Checks parameter and return types of a reachable top-level or module function for C11 emission. */
checkCFunctionSignature := fn(item: frontend.Item): Unit {
    checkUnsupportedCType(item.code);
    encoded := item.textValue;
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        if eq >= 0 {
            checkUnsupportedCType(textLib.slice(entry, eq + 1, textLib.length(entry)));
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** Emits UTF-8 Unicode scalar `core/text` C11 helpers only for primitives referenced by `calls`. */
emitTextPrimitiveHelpers := fn(calls: String): Unit {
    hasSliceFrom := usesIntHelper(calls, "lite$textSliceFrom(");
    hasLen := usesIntHelper(calls, "lite$textLength(") or hasSliceFrom;
    hasAt := usesIntHelper(calls, "lite$textAt(");
    hasSlice := usesIntHelper(calls, "lite$textSlice(") or hasSliceFrom;
    if not hasLen and not hasAt and not hasSlice { return; }
    io.outputLine("static size_t lt_utf8_step(const char *s, size_t offset) {");
    io.outputLine("    const unsigned char b = (unsigned char)s[offset];");
    io.outputLine("    if (b < 0x80u) { return 1u; }");
    io.outputLine("    if ((b & 0xE0u) == 0xC0u && s[offset + 1] != '\\0') { return 2u; }");
    io.outputLine("    if ((b & 0xF0u) == 0xE0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0') { return 3u; }");
    io.outputLine("    if ((b & 0xF8u) == 0xF0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0' && s[offset + 3] != '\\0') { return 4u; }");
    io.outputLine("    return 1u;");
    io.outputLine("}");
    if hasAt or hasSlice {
        io.outputLine("static const char *lt_alloc_text_slice(const char *s, size_t start, size_t end) {");
        io.outputLine("    const size_t len = end - start;");
        io.outputLine("    char *out = malloc(len + 1u);");
        io.outputLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate sliced text\\n\"); exit(1); }");
        io.outputLine("    if (len > 0u) { memcpy(out, s + start, len); }");
        io.outputLine("    out[len] = '\\0';");
        io.outputLine("    return out;");
        io.outputLine("}");
        io.outputLine("static size_t lt_utf8_byte_at(const char *s, int64_t target, bool allow_end, bool *ok) {");
        io.outputLine("    if (target < 0) { *ok = false; return 0u; }");
        io.outputLine("    size_t byte_pos = 0u;");
        io.outputLine("    int64_t count = 0;");
        io.outputLine("    while (s[byte_pos] != '\\0') {");
        io.outputLine("        if (count == target) { *ok = true; return byte_pos; }");
        io.outputLine("        byte_pos += lt_utf8_step(s, byte_pos);");
        io.outputLine("        count += 1;");
        io.outputLine("    }");
        io.outputLine("    *ok = allow_end && count == target;");
        io.outputLine("    return byte_pos;");
        io.outputLine("}");
    }
    if hasLen {
        io.outputLine("static int64_t lt_text_length(const char *s) {");
        io.outputLine("    size_t byte_pos = 0u;");
        io.outputLine("    int64_t count = 0;");
        io.outputLine("    while (s[byte_pos] != '\\0') { byte_pos += lt_utf8_step(s, byte_pos); count += 1; }");
        io.outputLine("    return count;");
        io.outputLine("}");
    }
    if hasAt {
        io.outputLine("static const char *lt_text_at(const char *s, int64_t position, size_t at) {");
        io.outputLine("    bool ok = false;");
        io.outputLine("    const size_t start = lt_utf8_byte_at(s, position, false, &ok);");
        io.outputLine("    if (!ok) { lt_bound_fault(at, \"textAt index outside text\"); }");
        io.outputLine("    return lt_alloc_text_slice(s, start, start + lt_utf8_step(s, start));");
        io.outputLine("}");
    }
    if hasSlice {
        io.outputLine("static const char *lt_text_slice(const char *s, int64_t start, int64_t end, size_t at) {");
        io.outputLine("    if (start < 0 || end < start) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    bool ok = false;");
        io.outputLine("    const size_t b_start = lt_utf8_byte_at(s, start, true, &ok);");
        io.outputLine("    if (!ok) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    size_t b_end = b_start;");
        io.outputLine("    int64_t remaining = end - start;");
        io.outputLine("    while (remaining > 0 && s[b_end] != '\\0') { b_end += lt_utf8_step(s, b_end); remaining -= 1; }");
        io.outputLine("    if (remaining > 0) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    return lt_alloc_text_slice(s, b_start, b_end);");
        io.outputLine("}");
    }
    if hasSliceFrom {
        io.outputLine("static const char *lt_text_slice_from(const char *s, int64_t start, size_t at) {");
        io.outputLine("    return lt_text_slice(s, start, lt_text_length(s), at);");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** True when a program calls supported C11 stdin helpers (`inputAll`, `inputLine`, `inputInt`, `inputFloat`). */
usesInputHelpers := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or
    usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(")
};

/** Emits portable ISO C11 stdin helpers matching Lite's `core/io` prompt and `InputFault` contracts. */
emitInputHelpers := fn(calls: String): Unit {
    hasAll := usesIntHelper(calls, "lite$inputAll(");
    hasLine := usesIntHelper(calls, "lite$inputLine(");
    hasInt := usesIntHelper(calls, "lite$inputInt(");
    hasFloat := usesIntHelper(calls, "lite$inputFloat(");
    if not hasAll and not hasLine and not hasInt and not hasFloat { return; }
    io.outputLine("static void lt_input_prompt(const char *prompt) {");
    io.outputLine("    if (prompt != NULL) { fputs(prompt, stdout); fflush(stdout); }");
    io.outputLine("}");
    if hasLine or hasInt or hasFloat {
        io.outputLine("static _Noreturn void lt_input_fault(const char *at, const char *message) {");
        io.outputLine("    fprintf(stderr, \"%s%s\\n\", at, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
    }
    if hasInt or hasFloat {
        io.outputLine("static char *lt_input_word(void) {");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    while (ch != EOF && (ch == ' ' || ch == '\\t' || ch == '\\r' || ch == '\\n')) { ch = fgetc(stdin); }");
        io.outputLine("    if (ch == EOF) { return NULL; }");
        io.outputLine("    size_t cap = 64u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    while (ch != EOF && ch != ' ' && ch != '\\t' && ch != '\\r' && ch != '\\n') {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    if (ch != EOF) { ungetc(ch, stdin); }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasAll {
        io.outputLine("static const char *lt_input_all(const char *prompt, const char *at) {");
        io.outputLine("    (void)at;");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    size_t cap = 128u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    while (ch != EOF) {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasLine {
        io.outputLine("static const char *lt_input_line(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    if (ch == EOF) { lt_input_fault(at, \"EOF before inputLine value\"); }");
        io.outputLine("    size_t cap = 128u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    while (ch != EOF && ch != '\\n') {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    if (ch == '\\n' && len > 0u && buf[len - 1u] == '\\r') { len -= 1u; }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasInt {
        io.outputLine("static int64_t lt_input_int(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    char *tok = lt_input_word();");
        io.outputLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputInt value\"); }");
        io.outputLine("    size_t i = (tok[0] == '+' || tok[0] == '-') ? 1u : 0u;");
        io.outputLine("    if (tok[i] == '\\0') { free(tok); lt_input_fault(at, \"expected an integer token\"); }");
        io.outputLine("    while (tok[i] != '\\0') { if (tok[i] < '0' || tok[i] > '9') { free(tok); lt_input_fault(at, \"expected an integer token\"); } i += 1u; }");
        io.outputLine("    errno = 0;");
        io.outputLine("    char *endp = NULL;");
        io.outputLine("    long long val = strtoll(tok, &endp, 10);");
        io.outputLine("    int err = errno;");
        io.outputLine("    free(tok);");
        io.outputLine("    if (err == ERANGE || val < INT64_MIN || val > INT64_MAX) { lt_input_fault(at, \"input outside signed 64-bit range\"); }");
        io.outputLine("    return (int64_t)val;");
        io.outputLine("}");
    }
    if hasFloat {
        io.outputLine("static double lt_input_float(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    char *tok = lt_input_word();");
        io.outputLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputFloat value\"); }");
        io.outputLine("    char *endp = NULL;");
        io.outputLine("    double val = strtod(tok, &endp);");
        io.outputLine("    bool ok = endp != tok && *endp == '\\0' && isfinite(val);");
        io.outputLine("    free(tok);");
        io.outputLine("    if (!ok) { lt_input_fault(at, \"expected a finite floating token\"); }");
        io.outputLine("    return val;");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Formats a pipe-separated parameter list as C11 typed parameters or `void`. */
cParameterList := fn(encoded: String): String {
    if encoded == "" { return "void"; }
    var result := "";
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        paramName := textLib.slice(entry, 0, eq);
        paramKind := textLib.slice(entry, eq + 1, textLib.length(entry));
        if textLib.length(result) > 0 { result = result + ", "; }
        result = result + cScalarType(paramKind) + " lite_" + paramName;
        if sep < 0 { break; }
        start = sep + 1;
    }
    result
};

/** Emits `(void)lite_param;` silencing reads for strict C11 warning checks. */
emitCParameterReads := fn(encoded: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        io.outputLine("    (void)lite_" + textLib.slice(entry, 0, eq) + ";");
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** True when `item.kind` starts a local/mutable variable declaration. */
isCLocalDeclKind := fn(kind: String): Bool {
    kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT or
    kind == frontend.ITEM_KIND_LOCAL_STRING or kind == frontend.ITEM_KIND_VAR_STRING or
    kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT or
    kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL or
    kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE or
    kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST
};

/** Detects leaked JS tuple or array literal syntax inside a scalar-typed expression on C, skipping quoted strings, type annotations, and C11 compound literals. */
unsupportedAggregateCode := fn(code: String): String {
    if textLib.indexOfText(code, "{", 0) < 0 and textLib.indexOfText(code, "[", 0) < 0 { return ""; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
        } else if ch == "(" and (textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "(const ") or textLib.startsWithAt(code, cursor, "((lt_s_")) {
            isDouble := textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "((lt_s_");
            var depth := 0;
            loop cursor < size {
                c2 := textLib.at(code, cursor);
                if c2 == "\"" {
                    cursor = frontend.skipAliasString(code, cursor);
                } else {
                    if c2 == "(" { depth = depth + 1; }
                    else if c2 == ")" {
                        depth = depth - 1;
                        if depth == 0 {
                            cursor = cursor + 1;
                            if not isDouble and cursor < size and textLib.at(code, cursor) == "{" {
                                var bDepth := 0;
                                loop cursor < size {
                                    c3 := textLib.at(code, cursor);
                                    if c3 == "\"" { cursor = frontend.skipAliasString(code, cursor); }
                                    else {
                                        if c3 == "{" { bDepth = bDepth + 1; }
                                        else if c3 == "}" {
                                            bDepth = bDepth - 1;
                                            if bDepth == 0 { cursor = cursor + 1; break; }
                                        }
                                        cursor = cursor + 1;
                                    }
                                }
                            }
                            break;
                        }
                    }
                    cursor = cursor + 1;
                }
            }
        } else if ch == "[" and textLib.startsWithAt(code, cursor, "[0] == '\\0'") {
            cursor = cursor + textLib.length("[0] == '\\0'");
        } else if ch == "{" {
            return "C backend does not support tuple values yet";
        } else if ch == "[" {
            return "C backend does not support array values yet";
        } else {
            cursor = cursor + 1;
        }
    }
    ""
};

/** Rewrites registered `lite$...(` builtin calls and strips internal `/*@T:...*/`/`/*@C:...*/` markers outside quoted strings. */
normalizeCBuiltinCalls := fn(code: String): String {
    if textLib.indexOfText(code, "lite$", 0) < 0 and textLib.indexOfText(code, "/*@", 0) < 0 { return code; }
    size := textLib.length(code);
    var out := "";
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            out = out + textLib.slice(code, flushed, cursor);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$reportError(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_report_error(";
            cursor = cursor + textLib.length("lite$reportError(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$exit(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_exit(";
            cursor = cursor + textLib.length("lite$exit(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textLength(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_length(";
            cursor = cursor + textLib.length("lite$textLength(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textAt(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_at(";
            cursor = cursor + textLib.length("lite$textAt(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textSliceFrom(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_slice_from(";
            cursor = cursor + textLib.length("lite$textSliceFrom(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$textSlice(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_text_slice(";
            cursor = cursor + textLib.length("lite$textSlice(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputArgs(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_args(";
            cursor = cursor + textLib.length("lite$inputArgs(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputAll(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_all(";
            cursor = cursor + textLib.length("lite$inputAll(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputLine(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_line(";
            cursor = cursor + textLib.length("lite$inputLine(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputInt(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_int(";
            cursor = cursor + textLib.length("lite$inputInt(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$inputFloat(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_input_float(";
            cursor = cursor + textLib.length("lite$inputFloat(");
            flushed = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { code } else { out + textLib.slice(code, flushed, size) }
};

/** Builds one checked printf call for an Int*, Float*, String, Bool, Unit or Never report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    match {
        kind == frontend.VALUE_KIND_NEVER { "((void)(" + code + "), 0)" }
        kind == frontend.VALUE_KIND_UNIT {
            if code == "0" { "printf(\"Unit\")" } else { "((void)(" + code + "), printf(\"Unit\"))" }
        }
        frontend.isEnumKind(kind) {
            dName := frontend.enumDisplayName(kind);
            cCount := frontend.enumCaseCount(kind);
            labels: mut List<String> = [];
            var ci := 0;
            loop ci < cCount {
                listLib.pushBack(mut labels, cLiteral.textLiteralCode(dName + "." + frontend.enumCaseNameAt(kind, ci)));
                ci = ci + 1;
            }
            "printf(\"%s\", ((const char *const[]){" + textLib.joinTexts(labels, ", ") + "}[" + code + "]))"
        }
        frontend.isFloatScalarKind(kind) { "lt_print_float((double)(" + code + "))" }
        cListTagForKind(kind) =!= "" { "lt_list_" + cListTagForKind(kind) + "_print(" + code + ")" }
        frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) + "_print(" + code + ")" }
        frontend.isIntScalarKind(kind) { "printf(\"%\" PRId64, (int64_t)(" + code + "))" }
        kind == frontend.VALUE_KIND_BOOL { "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))" }
        _ { "printf(\"%s\", " + code + ")" }
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    textLib.indexOfText(calls, "|" + name + "|", 0) >= 0
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: String): String {
    match {
        usesIntHelper(calls, "lite$fileKind(") or usesIntHelper(calls, "lite$fileOpenReader(") or
        usesIntHelper(calls, "lite$fileOpenWriter(") or usesIntHelper(calls, "lite$fileOpenAppender(") or
        usesIntHelper(calls, "lite$fileListDir(") or usesIntHelper(calls, "lite$fileMakeDir(") or
        usesIntHelper(calls, "lite$fileRemove(") or usesIntHelper(calls, "lite$fileCopy(") or
        usesIntHelper(calls, "lite$fileSymlink(") or usesIntHelper(calls, "lite$fileRealPath(") or
        usesIntHelper(calls, "lite$fileMakeTempDir(") {
            "C backend does not support filesystem builtins yet"
        }
        usesIntHelper(calls, "lite$ioStdinReader(") or usesIntHelper(calls, "lite$ioStdoutWriter(") or
        usesIntHelper(calls, "lite$ioStderrWriter(") or usesIntHelper(calls, "lite$ioBufferReader(") or
        usesIntHelper(calls, "lite$ioTextReader(") or usesIntHelper(calls, "lite$ioBufferWriter(") or
        usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
        usesIntHelper(calls, "lite$ioClearWriter(") or usesIntHelper(calls, "lite$ioReaderOk(") or
        usesIntHelper(calls, "lite$ioReaderAtEof(") or usesIntHelper(calls, "lite$ioReaderError(") or
        usesIntHelper(calls, "lite$ioRead(") or usesIntHelper(calls, "lite$ioReadAll(") or
        usesIntHelper(calls, "lite$ioReadAllText(") or usesIntHelper(calls, "lite$ioReadLine(") or
        usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWriterOk(") or
        usesIntHelper(calls, "lite$ioWriterError(") or usesIntHelper(calls, "lite$ioWrite(") or
        usesIntHelper(calls, "lite$ioWriteText(") or usesIntHelper(calls, "lite$ioWriteLine(") or
        usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") {
            "C backend does not support stream builtins yet"
        }
        usesIntHelper(calls, "lite$processCwd(") or usesIntHelper(calls, "lite$processExecPath(") or
        usesIntHelper(calls, "lite$processEntryPath(") or usesIntHelper(calls, "lite$processPlatform(") or
        usesIntHelper(calls, "lite$processArch(") or usesIntHelper(calls, "lite$processRuntimeVersion(") or
        usesIntHelper(calls, "lite$processEnvGet(") or usesIntHelper(calls, "lite$processRun(") or
        usesIntHelper(calls, "lite$processRunBytes(") {
            "C backend does not support process builtins yet"
        }
        usesIntHelper(calls, "lite$cryptoRandomBytes(") or usesIntHelper(calls, "lite$cryptoDigestBytes(") or
        usesIntHelper(calls, "lite$cryptoDigestText(") or usesIntHelper(calls, "lite$cryptoDigestFile(") or
        usesIntHelper(calls, "lite$cryptoHmacSha256Bytes(") or usesIntHelper(calls, "lite$cryptoEncodeBytes(") or
        usesIntHelper(calls, "lite$cryptoDecodeBytes(") {
            "C backend does not support crypto builtins yet"
        }
        usesIntHelper(calls, "lite$timeMonotonicNs(") or usesIntHelper(calls, "lite$timeEpochNs(") or
        usesIntHelper(calls, "lite$timeSleepMs(") or usesIntHelper(calls, "lite$timeLocalDate(") {
            "C backend does not support time builtins yet"
        }
        usesIntHelper(calls, "lite$unicodeToCodePoints(") or usesIntHelper(calls, "lite$unicodeFromCodePoints(") {
            "C backend does not support unicode builtins yet"
        }
        usesIntHelper(calls, "lite$extTsStripTypes(") or usesIntHelper(calls, "lite$extHttpFetchToFile(") or
        usesIntHelper(calls, "lite$extHttpServeStatic(") or usesIntHelper(calls, "lite$extBenchMeasureCompiler(") or
        usesIntHelper(calls, "lite$extPoolCpuCount(") or usesIntHelper(calls, "lite$extPoolRunJson(") {
            "C backend does not support external host builtins yet"
        }
        _ { "" }
    }
}

/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program needs checked dynamic Int* arithmetic or narrow range guards. */
usesIntArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
    usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(") or
    usesIntHelper(calls, "lt_checked_narrow_int(")
}

/** True when binary64/binary32 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool {
    usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float32_op(") or usesIntHelper(calls, "lt_float_power(")
}

/** Emits checked binary64/binary32 operations; caller temporaries preserve left-to-right operand effects. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesIntHelper(calls, "lt_float_power(") {
        io.outputLine("static double lt_float_power(double left, double right, size_t at) {");
        io.outputLine("    if (left == 0 && right < 0) { lt_int_fault(at, \"zero cannot be raised to a negative power\"); }");
        io.outputLine("    double value = pow(left, right);");
        io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_float32_op(") {
        io.outputLine("static double lt_float32_op(double left, double right, int op, size_t at) {");
        io.outputLine("    const float l = (float)left;");
        io.outputLine("    const float r = (float)right;");
        io.outputLine("    if (op == 3 && r == 0.0f) { lt_int_fault(at, \"division by zero\"); }");
        io.outputLine("    float value = op == 0 ? l + r : op == 1 ? l - r : op == 2 ? l * r : l / r;");
        io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
        io.outputLine("    return (double)value;");
        io.outputLine("}");
    }
    if not usesIntHelper(calls, "lt_float_op(") { return; }
    io.outputLine("static double lt_float_op(double left, double right, int op, size_t at) {");
    io.outputLine("    if (op == 3 && right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
    io.outputLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }");
    io.outputLine("    return value;");
    io.outputLine("}");
}

/** True when a program calls `core/text` UTF-8 scalar primitives. */
usesTextPrimitives := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
    usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(")
}

/** True when `calls` references any bounds-checked C11 list helper for `tag`. */
/** True when any list bounds helper is called in `calls` (for scalar or struct element lists). */
usesAnyListBounds := fn(calls: String): Bool {
    textLib.indexOfText(calls, "|lt_list_", 0) >= 0 and (
        textLib.indexOfText(calls, "_at(|", 0) >= 0 or
        textLib.indexOfText(calls, "_set(|", 0) >= 0 or
        textLib.indexOfText(calls, "_pop_back(|", 0) >= 0 or
        textLib.indexOfText(calls, "_pop_front(|", 0) >= 0 or
        textLib.indexOfText(calls, "_slice(|", 0) >= 0 or
        textLib.indexOfText(calls, "_slice_from(|", 0) >= 0
    )
};

/** Emits portable ISO C11 typedef, optional deep copy, and optional print helper for one tuple or nominal record `kind`. */
emitCStructHelpers := fn(kind: String, needCopy: Bool, needPrint: Bool): Unit {
    tag := frontend.cStructTag(kind);
    isRec := frontend.isRecordKind(kind);
    count := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
    if count == 0 {
        io.outputLine("typedef struct { int _empty; } " + tag + ";");
    } else {
        var fields := "";
        var i := 0;
        loop i < count {
            comp := if isRec { frontend.recordComponent(kind, i) } else { frontend.tupleComponent(kind, i) };
            fields = fields + cScalarType(comp.kind) + " " + frontend.cFieldName(comp.prop) + "; ";
            i = i + 1;
        }
        io.outputLine("typedef struct { " + fields + "} " + tag + ";");
    }
    if needCopy and frontend.cTypeHasListField(kind) {
        io.outputLine("static " + tag + " " + tag + "_copy(" + tag + " src) {");
        if count == 0 {
            io.outputLine("    return src;");
        } else {
            var inits := "";
            var ci := 0;
            loop ci < count {
                comp := if isRec { frontend.recordComponent(kind, ci) } else { frontend.tupleComponent(kind, ci) };
                if ci > 0 { inits = inits + ", "; }
                fnm := frontend.cFieldName(comp.prop);
                fVal := if cListTagForKind(comp.kind) =!= "" {
                    "lt_list_" + cListTagForKind(comp.kind) + "_copy(src." + fnm + ")"
                } else if frontend.cStructTag(comp.kind) =!= "" and frontend.cTypeHasListField(comp.kind) {
                    frontend.cStructTag(comp.kind) + "_copy(src." + fnm + ")"
                } else {
                    "src." + fnm
                };
                inits = inits + "." + fnm + " = " + fVal;
                ci = ci + 1;
            }
            io.outputLine("    return (" + tag + "){ " + inits + " };");
        }
        io.outputLine("}");
    }
    if needPrint {
        io.outputLine("static int " + tag + "_print(" + tag + " v) {");
        if isRec {
            recName := frontend.recordDisplayName(kind);
            if count == 0 {
                io.outputLine("    (void)v;");
                io.outputLine("    return printf(\"%s\", " + cLiteral.textLiteralCode(recName + " {}") + ");");
            } else {
                io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(recName + " { ") + ") < 0) { return -1; }");
                var pi := 0;
                loop pi < count {
                    comp := frontend.recordComponent(kind, pi);
                    sep := if pi == 0 { "" } else { ", " };
                    io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(sep + comp.label + " = ") + ") < 0) { return -1; }");
                    io.outputLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                    pi = pi + 1;
                }
                io.outputLine("    return printf(\" }\");");
            }
        } else {
            io.outputLine("    if (printf(\"(\") < 0) { return -1; }");
            var pi := 0;
            loop pi < count {
                comp := frontend.tupleComponent(kind, pi);
                sep := if pi == 0 { "" } else { ", " };
                prefixTxt := if comp.label == "" { sep } else { sep + comp.label + "=" };
                if prefixTxt =!= "" {
                    io.outputLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(prefixTxt) + ") < 0) { return -1; }");
                }
                io.outputLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                pi = pi + 1;
            }
            if count == 0 { io.outputLine("    (void)v;"); }
            ending := if count == 1 { ",)" } else { ")" };
            io.outputLine("    return printf(" + cLiteral.textLiteralCode(ending) + ");");
        }
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits one C11 tuple-label conversion helper converting `actualKind` to `expectedKind`. */
emitCTupleConvHelper := fn(expectedKind: String, actualKind: String): Unit {
    expTag := frontend.cStructTag(expectedKind);
    actTag := frontend.cStructTag(actualKind);
    fnName := frontend.cTupleConvertName(expectedKind, actualKind);
    count := frontend.tupleComponentCount(expectedKind);
    io.outputLine("static " + expTag + " " + fnName + "(" + actTag + " v) {");
    if count == 0 {
        io.outputLine("    (void)v; return (" + expTag + "){ ._empty = 0 };");
    } else {
        var inits := "";
        var i := 0;
        loop i < count {
            eComp := frontend.tupleComponent(expectedKind, i);
            aComp := frontend.tupleComponent(actualKind, i);
            if i > 0 { inits = inits + ", "; }
            aExpr := "v." + frontend.cFieldName(aComp.prop);
            fVal := if cListTagForKind(eComp.kind) =!= "" {
                "lt_list_" + cListTagForKind(eComp.kind) + "_copy(" + aExpr + ")"
            } else if frontend.cStructTag(eComp.kind) =!= "" and frontend.cTypeHasListField(eComp.kind) {
                frontend.cStructTag(eComp.kind) + "_copy(" + aExpr + ")"
            } else {
                aExpr
            };
            inits = inits + "." + frontend.cFieldName(eComp.prop) + " = " + fVal;
            i = i + 1;
        }
        io.outputLine("    return (" + expTag + "){ " + inits + " };");
    }
    io.outputLine("}");
    io.outputLine("");
};

/** Emits portable ISO C11 list struct and only the helper operations used for `tag` (`i64`, `f64`, `bool`, `str`, or `lt_s_...`). */
emitCListTagHelpers := fn(tag: String, elemKind: String, calls: String, needCopy: Bool, needPrint: Bool, needFrom: Bool): Unit {
    cType := frontend.cListElemType(tag);
    cElemConstPtr := if tag == "str" { "const char *const *" } else { "const " + cType + " *" };
    lType := "lt_list_" + tag;
    elemNeedsDeepCopy := elemKind =!= "" and frontend.cStructTag(elemKind) =!= "" and frontend.cTypeHasListField(elemKind);
    hasFrom := needFrom or usesIntHelper(calls, lType + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, lType + "_copy(");
    hasAt := usesIntHelper(calls, lType + "_at(");
    hasSet := usesIntHelper(calls, lType + "_set(");
    hasPushBack := usesIntHelper(calls, lType + "_push_back(");
    hasPushFront := usesIntHelper(calls, lType + "_push_front(");
    hasPopBack := usesIntHelper(calls, lType + "_pop_back(");
    hasPopFront := usesIntHelper(calls, lType + "_pop_front(");
    hasSliceFrom := usesIntHelper(calls, lType + "_slice_from(");
    hasSlice := usesIntHelper(calls, lType + "_slice(") or hasSliceFrom;
    hasReverse := usesIntHelper(calls, lType + "_reverse(");
    hasClear := usesIntHelper(calls, lType + "_clear(");
    io.outputLine("typedef struct { " + cType + " *data; int64_t len; int64_t cap; } " + lType + ";");
    if hasFrom or hasCopy or hasSlice or hasReverse {
        io.outputLine("static " + lType + " " + lType + "_from(int64_t count, " + cElemConstPtr + "elems) {");
        io.outputLine("    " + lType + " out = { NULL, count, count };");
        io.outputLine("    if (count > 0) {");
        io.outputLine("        out.data = malloc((size_t)count * sizeof(" + cType + "));");
        io.outputLine("        if (out.data == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate list\\n\"); exit(1); }");
        io.outputLine("        memcpy(out.data, elems, (size_t)count * sizeof(" + cType + "));");
        io.outputLine("    }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasCopy {
        io.outputLine("static " + lType + " " + lType + "_copy(" + lType + " src) {");
        if elemNeedsDeepCopy {
            io.outputLine("    " + lType + " out = " + lType + "_from(src.len, src.data);");
            io.outputLine("    for (int64_t i = 0; i < out.len; i += 1) { out.data[i] = " + tag + "_copy(out.data[i]); }");
            io.outputLine("    return out;");
        } else {
            io.outputLine("    return " + lType + "_from(src.len, src.data);");
        }
        io.outputLine("}");
    }
    if hasAt {
        io.outputLine("static " + cType + " " + lType + "_at(" + lType + " xs, int64_t idx, size_t at) {");
        io.outputLine("    if (idx < 0 || idx >= xs.len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        io.outputLine("    return xs.data[idx];");
        io.outputLine("}");
    }
    if hasSet {
        io.outputLine("static void " + lType + "_set(" + lType + " *xs, int64_t idx, " + cType + " val, size_t at) {");
        io.outputLine("    if (idx < 0 || idx >= xs->len) { lt_bound_fault(at, \"list index outside its extent\"); }");
        io.outputLine("    xs->data[idx] = val;");
        io.outputLine("}");
    }
    if hasPushBack or hasPushFront {
        io.outputLine("static void " + lType + "_grow(" + lType + " *xs, int64_t need) {");
        io.outputLine("    if (xs->cap >= need) { return; }");
        io.outputLine("    int64_t next = xs->cap > 0 ? xs->cap * 2 : 8;");
        io.outputLine("    while (next < need) { next *= 2; }");
        io.outputLine("    " + cType + " *buf = realloc(xs->data, (size_t)next * sizeof(" + cType + "));");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow list\\n\"); exit(1); }");
        io.outputLine("    xs->data = buf; xs->cap = next;");
        io.outputLine("}");
    }
    if hasPushBack {
        io.outputLine("static void " + lType + "_push_back(" + lType + " *xs, " + cType + " val) {");
        io.outputLine("    " + lType + "_grow(xs, xs->len + 1);");
        io.outputLine("    xs->data[xs->len++] = val;");
        io.outputLine("}");
    }
    if hasPushFront {
        io.outputLine("static void " + lType + "_push_front(" + lType + " *xs, " + cType + " val) {");
        io.outputLine("    " + lType + "_grow(xs, xs->len + 1);");
        io.outputLine("    if (xs->len > 0) { memmove(xs->data + 1, xs->data, (size_t)xs->len * sizeof(" + cType + ")); }");
        io.outputLine("    xs->data[0] = val; xs->len += 1;");
        io.outputLine("}");
    }
    if hasPopBack {
        io.outputLine("static " + cType + " " + lType + "_pop_back(" + lType + " *xs, size_t at) {");
        io.outputLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        io.outputLine("    return xs->data[--xs->len];");
        io.outputLine("}");
    }
    if hasPopFront {
        io.outputLine("static " + cType + " " + lType + "_pop_front(" + lType + " *xs, size_t at) {");
        io.outputLine("    if (xs->len <= 0) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        io.outputLine("    " + cType + " head = xs->data[0];");
        io.outputLine("    xs->len -= 1;");
        io.outputLine("    if (xs->len > 0) { memmove(xs->data, xs->data + 1, (size_t)xs->len * sizeof(" + cType + ")); }");
        io.outputLine("    return head;");
        io.outputLine("}");
    }
    if hasSlice {
        io.outputLine("static " + lType + " " + lType + "_slice(" + lType + " xs, int64_t start, int64_t end, size_t at) {");
        io.outputLine("    if (start < 0 || end < start || end > xs.len) { lt_bound_fault(at, \"list slice bounds outside its extent\"); }");
        io.outputLine("    return " + lType + "_from(end - start, xs.data + start);");
        io.outputLine("}");
    }
    if hasSliceFrom {
        io.outputLine("static " + lType + " " + lType + "_slice_from(" + lType + " xs, int64_t start, size_t at) {");
        io.outputLine("    return " + lType + "_slice(xs, start, xs.len, at);");
        io.outputLine("}");
    }
    if hasReverse {
        io.outputLine("static " + lType + " " + lType + "_reverse(" + lType + " xs) {");
        io.outputLine("    " + lType + " out = " + lType + "_from(xs.len, xs.data);");
        io.outputLine("    for (int64_t i = 0; i < out.len / 2; i += 1) { " + cType + " t = out.data[i]; out.data[i] = out.data[out.len - 1 - i]; out.data[out.len - 1 - i] = t; }");
        io.outputLine("    return out;");
        io.outputLine("}");
    }
    if hasClear {
        io.outputLine("static void " + lType + "_clear(" + lType + " *xs) { xs->len = 0; }");
    }
    if needPrint {
        io.outputLine("static int " + lType + "_print(" + lType + " xs) {");
        io.outputLine("    if (printf(\"[\") < 0) { return -1; }");
        io.outputLine("    for (int64_t i = 0; i < xs.len; i += 1) {");
        io.outputLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        elemPrint := if tag == "i64" { "printf(\"%\" PRId64, xs.data[i])" }
        else if tag == "f64" { "lt_print_float(xs.data[i])" }
        else if tag == "bool" { "printf(\"%s\", xs.data[i] ? \"true\" : \"false\")" }
        else if tag == "str" { "printf(\"%s\", xs.data[i])" }
        else { tag + "_print(xs.data[i])" };
        io.outputLine("        if (" + elemPrint + " < 0) { return -1; }");
        io.outputLine("    }");
        io.outputLine("    return printf(\"]\");");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Emits portable C11 guards that reject overflow and bounds faults before evaluating operations. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    usesArith := usesIntArithmetic(calls) or usesIntDivision(calls) or usesFloatArithmetic(calls);
    usesBounds := usesIntHelper(calls, "lite$textAt(") or usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(") or
    usesAnyListBounds(calls);
    if not usesArith and not usesBounds { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    io.outputLine("static const size_t lt_int_lines[] = {" + frontend.lineStartCodes(source) + "};");
    io.outputLine("static const char *lt_int_source = " + cLiteral.textLiteralCode(namePrefix) + ";");
    if usesBounds {
        io.outputLine("static _Noreturn void lt_fault(const char *category, size_t at, const char *message) {");
        io.outputLine("    size_t line = 0;");
        io.outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        io.outputLine("    fprintf(stderr, \"%s%zu:%zu: %s: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, category, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
        io.outputLine("static _Noreturn void lt_bound_fault(size_t at, const char *message) { lt_fault(\"BoundPanic\", at, message); }");
        if usesArith {
            io.outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) { lt_fault(\"ArithmeticPanic\", at, message); }");
        }
    } else {
        io.outputLine("static _Noreturn void lt_int_fault(size_t at, const char *message) {");
        io.outputLine("    size_t line = 0;");
        io.outputLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
        io.outputLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_add(") {
        io.outputLine("static int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left + right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        io.outputLine("static int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left - right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        io.outputLine("static int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        io.outputLine("    if (left == 0 || right == 0) { return 0; }");
        io.outputLine("    if (left > 0) {");
        io.outputLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
        io.outputLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right > 0) {");
        io.outputLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return left * right;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        io.outputLine("static int64_t lt_checked_negate(int64_t value, size_t at) {");
        io.outputLine("    if (value == INT64_MIN) { lt_int_fault(at, \"integer outside Int range\"); }");
        io.outputLine("    return -value;");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lt_checked_narrow_int(") {
        io.outputLine("static int64_t lt_checked_narrow_int(int64_t value, int bits, const char *name, size_t at) {");
        io.outputLine("    const int64_t limit = INT64_C(1) << (bits - 1);");
        io.outputLine("    if (value < -limit || value >= limit) {");
        io.outputLine("        char message[64];");
        io.outputLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
        io.outputLine("        lt_int_fault(at, message);");
        io.outputLine("    }");
        io.outputLine("    return value;");
        io.outputLine("}");
    }
    io.outputLine("");
}

/** Declares hygienic arithmetic/comparison temporaries at unique assignment sites, skipping quoted text. */
emitArithmeticTemporaries := fn(items: frontend.Items): Unit {
    loop items as item {
        var cursor := 0;
        loop cursor < textLib.length(item.code) {
            ch := textLib.at(item.code, cursor);
            if ch == "\"" {
                cursor = frontend.skipAliasString(item.code, cursor);
            } else if ch == "l" and (textLib.startsWithAt(item.code, cursor, "lt_arg_") or textLib.startsWithAt(item.code, cursor, "lt_cmp_")) {
                end := textLib.skipName(item.code, cursor);
                if textLib.startsWithAt(item.code, end, " = ") {
                    tag := if textLib.startsWithAt(item.code, cursor, "lt_cmp_") or textLib.startsWithAt(item.code, cursor, "lt_arg_f_") { textLib.at(item.code, cursor + 7) } else { "i" };
                    typeCode := if tag == "s" { "const char *" } else if tag == "b" { "bool " }
                    else if tag == "f" { "double " } else { "int64_t " };
                    io.outputLine("    " + typeCode + textLib.slice(item.code, cursor, end) + ";");
                }
                cursor = end;
            } else { cursor = cursor + 1; }
        }
    }
}

/** Emits shortest round-trip binary64 display with decimal/exponent thresholds shared by the TS runtime; source remains statically checked and no locale is selected by generated programs. */
emitFloatOutputHelpers := fn(): Unit {
    io.outputLine("/* Split printf's positive finite decimal into significant digits and its first-digit exponent. */");
    io.outputLine("static int lt_float_digits(const char *text, char *digits, int *exponent) {");
    io.outputLine("    int size = 0, before = 0, dot = 0;");
    io.outputLine("    const char *at = text;");
    io.outputLine("    while (*at && *at != 'e' && *at != 'E') {");
    io.outputLine("        if (*at == '.') dot = 1;");
    io.outputLine("        else { digits[size++] = *at; if (!dot) before++; }");
    io.outputLine("        at++;");
    io.outputLine("    }");
    io.outputLine("    int power = *at ? (int)strtol(at + 1, NULL, 10) : 0;");
    io.outputLine("    int leading = 0;");
    io.outputLine("    while (leading + 1 < size && digits[leading] == '0') leading++;");
    io.outputLine("    memmove(digits, digits + leading, (size_t)(size - leading));");
    io.outputLine("    size -= leading;");
    io.outputLine("    digits[size] = '\\0';");
    io.outputLine("    *exponent = before - leading - 1 + power;");
    io.outputLine("    return size;");
    io.outputLine("}");
    io.outputLine("/* Move to the adjacent positive decimal having at most precision significant digits. */");
    io.outputLine("static void lt_float_neighbor(char *digits, int precision, int *exponent, int direction) {");
    io.outputLine("    int at = precision - 1;");
    io.outputLine("    if (direction > 0) {");
    io.outputLine("        while (at >= 0 && digits[at] == '9') digits[at--] = '0';");
    io.outputLine("        if (at >= 0) digits[at]++;");
    io.outputLine("        else { digits[0] = '1'; (*exponent)++; }");
    io.outputLine("    } else {");
    io.outputLine("        while (at >= 0 && digits[at] == '0') digits[at--] = '9';");
    io.outputLine("        if (at >= 0) digits[at]--;");
    io.outputLine("        if (digits[0] == '0') {");
    io.outputLine("            for (int i = 0; i < precision; i++) digits[i] = '9';");
    io.outputLine("            (*exponent)--;");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("}");
    io.outputLine("/* Find the least significant-digit count that round-trips, including asymmetric boundary candidates. */");
    io.outputLine("static int lt_float_format(double value, char *out) {");
    io.outputLine("    if (value == 0.0) { strcpy(out, \"0\"); return 1; }");
    io.outputLine("    int negative = value < 0.0;");
    io.outputLine("    double positive = negative ? -value : value;");
    io.outputLine("    char digits[32], nearest[64], adjacent[64];");
    io.outputLine("    int size = 0, exponent = 0, found = 0;");
    io.outputLine("    for (int precision = 1; precision <= 17 && !found; precision++) {");
    io.outputLine("        if (snprintf(nearest, sizeof nearest, \"%.*g\", precision, positive) < 0) return 0;");
    io.outputLine("        size = lt_float_digits(nearest, digits, &exponent);");
    io.outputLine("        if (strtod(nearest, NULL) == positive) { found = 1; break; }");
    io.outputLine("        while (size < precision) digits[size++] = '0';");
    io.outputLine("        digits[size] = '\\0';");
    io.outputLine("        for (int direction = -1; direction <= 1 && !found; direction += 2) {");
    io.outputLine("            char candidate[32]; memcpy(candidate, digits, (size_t)size + 1);");
    io.outputLine("            int power = exponent;");
    io.outputLine("            lt_float_neighbor(candidate, precision, &power, direction);");
    io.outputLine("            if (snprintf(adjacent, sizeof adjacent, \"%se%d\", candidate, power - precision + 1) < 0) return 0;");
    io.outputLine("            if (strtod(adjacent, NULL) == positive) {");
    io.outputLine("                memcpy(digits, candidate, (size_t)size + 1); exponent = power; found = 1;");
    io.outputLine("            }");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    if (!found) return 0;");
    io.outputLine("    while (size > 1 && digits[size - 1] == '0') size--;");
    io.outputLine("    int at = 0;");
    io.outputLine("    if (negative) out[at++] = '-';");
    io.outputLine("    if (exponent >= 21 || exponent < -6) {");
    io.outputLine("        out[at++] = digits[0];");
    io.outputLine("        if (size > 1) { out[at++] = '.'; memcpy(out + at, digits + 1, (size_t)size - 1); at += size - 1; }");
    io.outputLine("        out[at++] = 'e';");
    io.outputLine("        if (exponent >= 0) out[at++] = '+';");
    io.outputLine("        int length = snprintf(out + at, 64u - (size_t)at, \"%d\", exponent);");
    io.outputLine("        if (length < 0) return 0;");
    io.outputLine("        at += length;");
    io.outputLine("    } else if (exponent < 0) {");
    io.outputLine("        out[at++] = '0'; out[at++] = '.';");
    io.outputLine("        for (int i = -1; i > exponent; i--) out[at++] = '0';");
    io.outputLine("        memcpy(out + at, digits, (size_t)size); at += size;");
    io.outputLine("    } else {");
    io.outputLine("        for (int i = 0; i <= exponent || i < size; i++) {");
    io.outputLine("            if (i == exponent + 1) out[at++] = '.';");
    io.outputLine("            out[at++] = i < size ? digits[i] : '0';");
    io.outputLine("        }");
    io.outputLine("    }");
    io.outputLine("    out[at] = '\\0';");
    io.outputLine("    return 1;");
    io.outputLine("}");
    io.outputLine("static int lt_print_float(double value) {");
    io.outputLine("    char text[64];");
    io.outputLine("    if (!lt_float_format(value, text)) return -1;");
    io.outputLine("    return printf(\"%s\", text);");
    io.outputLine("}");
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: String): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic. */
emitIntDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"division by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { lt_int_fault(at, \"integer outside Int range\"); }");
    io.outputLine("    return left / right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(): Unit {
    io.outputLine("static int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"remainder by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    return left % right;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(): Unit {
    io.outputLine("static int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    io.outputLine("    if (right == 0) { lt_int_fault(at, \"modulo by zero\"); }");
    io.outputLine("    if (left == INT64_MIN && right == -1) { return 0; }");
    io.outputLine("    const int64_t remainder = left % right;");
    io.outputLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    io.outputLine("}");
    io.outputLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    io.outputLine("static const char *lite_concat(const char *left, const char *right) {");
    io.outputLine("    const size_t left_length = strlen(left);");
    io.outputLine("    const size_t right_length = strlen(right);");
    io.outputLine("    char *combined = malloc(left_length + right_length + 1);");
    io.outputLine("    if (combined == NULL) {");
    io.outputLine("        fprintf(stderr, \"MemoryFault: cannot allocate concatenated text\\n\");");
    io.outputLine("        exit(1);");
    io.outputLine("    }");
    io.outputLine("    memcpy(combined, left, left_length);");
    io.outputLine("    memcpy(combined + left_length, right, right_length + 1);");
    io.outputLine("    return combined;");
    io.outputLine("}");
    io.outputLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary, preserving non-trivial Unit/Never side effects. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if kind == frontend.VALUE_KIND_NEVER {
        io.outputLine(indent + "(void)(" + code + ");");
        return;
    }
    if kind == frontend.VALUE_KIND_UNIT {
        if code =!= "0" { io.outputLine(indent + "(void)(" + code + ");"); }
        return;
    }
    typeCode := if cListTagForKind(kind) =!= "" { "lt_list_" + cListTagForKind(kind) + " " }
    else if frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) + " " }
    else if frontend.isIntScalarKind(kind) or frontend.isEnumKind(kind) { "int64_t " }
    else if kind == frontend.VALUE_KIND_BOOL { "bool " }
    else if frontend.isFloatScalarKind(kind) { "double " }
    else { "const char *" };
    io.outputLine(indent + typeCode + name + " = " + code + ";");
}

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String, failAction: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { " + failAction + " }\n"
}

/** Emits statements for one C function body (`fnResult != ""`) or `main` (`fnResult == ""`). */
emitCItemStream := fn(stream: frontend.Items, hoistedGlobals: frontend.TokenBuckets, fnResult: String, failAction: String): Unit {
    var indent := "    ";
    var blockDepth := 0;
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    var writes := "";
    var seqLoopId := 0;
    loopSeqFlags: mut List<Int> = [];
    loop stream as item {
        code := normalizeCBuiltinCalls(item.code);
        if isCLocalDeclKind(item.kind) {
            if fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                io.outputLine(indent + item.runtime + " = " + code + ";");
            } else {
                io.outputLine(indent + cDeclTypeItem(item) + item.runtime + " = " + code + ";");
            }
            io.outputLine(indent + "(void)" + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_ASSIGN_INT or item.kind == frontend.ITEM_KIND_ASSIGN_STRING or item.kind == frontend.ITEM_KIND_ASSIGN_BOOL or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_LIST {
            io.outputLine(indent + item.runtime + " = " + code + ";");
        } else if item.kind == frontend.ITEM_KIND_RETURN {
            if fnResult == frontend.VALUE_KIND_UNIT {
                if code =!= "" { io.outputLine(indent + "(void)(" + code + ");"); }
                io.outputLine(indent + "return;");
            } else if code == "" {
                io.outputLine(indent + "return;");
            } else if textLib.startsWithAt(code, 0, "lt_exit(") {
                io.outputLine(indent + "(void)(" + code + ");");
            } else {
                io.outputLine(indent + "return " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_CALL or item.kind == frontend.ITEM_KIND_DISCARD {
            io.outputLine(indent + "(void)(" + code + ");");
        } else if item.kind == frontend.ITEM_KIND_UNREACHABLE {
            io.outputLine(indent + "fprintf(stderr, \"unreachable loop completion\\n\");");
            io.outputLine(indent + "exit(1);");
        } else if item.kind == frontend.ITEM_KIND_BREAK {
            io.outputLine(indent + "break;");
        } else if item.kind == frontend.ITEM_KIND_CONTINUE {
            io.outputLine(indent + "continue;");
        } else if item.kind == frontend.ITEM_KIND_SCOPE {
            io.outputLine(indent + "{");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_IF {
            io.outputLine(indent + "if (" + code + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_ELSE {
            indent = dedent(indent);
            io.outputLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE_IF {
            indent = dedent(indent);
            io.outputLine(indent + "} else if (" + code + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_SCOPE {
            indent = dedent(indent);
            io.outputLine(indent + "}");
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_LOOP {
            condition := if code == "" { "true" } else { code };
            io.outputLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
            listLib.pushBack(mut loopSeqFlags, 0);
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            tag := frontend.cListTag(item.textValue);
            seqId := integer.intText(seqLoopId);
            seqLoopId = seqLoopId + 1;
            seqVar := "lt_seq_" + seqId;
            idxVar := "lt_sidx_" + seqId;
            seqInit := if item.intValue == 1 { code } else { "lt_list_" + tag + "_copy(" + code + ")" };
            io.outputLine(indent + "{");
            io.outputLine(indent + "    lt_list_" + tag + " " + seqVar + " = " + seqInit + ";");
            io.outputLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
            if item.runtime =!= "" {
                io.outputLine(indent + "        " + frontend.cListElemType(tag) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                io.outputLine(indent + "        (void)" + item.runtime + ";");
            }
            indent = indent + "        ";
            blockDepth = blockDepth + 1;
            listLib.pushBack(mut loopSeqFlags, 1);
        } else if item.kind == frontend.ITEM_KIND_END_LOOP {
            isSeqEnd := if loopSeqFlags.length > 0 { listLib.popBack(mut loopSeqFlags) == 1 } else { false };
            if isSeqEnd {
                indent = dedent(dedent(indent));
                io.outputLine(indent + "    }");
                io.outputLine(indent + "}");
            } else {
                indent = dedent(indent);
                io.outputLine(indent + "}");
            }
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT {
            if count == 1 { io.output(outputWriteCode(firstKind, firstCode, indent, failAction)); }
            else if count > 1 { io.output(writes); }
            if item.kind == frontend.ITEM_KIND_END { io.outputLine(indent + "if (printf(\"\\n\") < 0) { " + failAction + " }"); }
            count = 0;
            writes = "";
        } else if item.kind == frontend.ITEM_KIND_MAIN_STOP or item.kind == frontend.ITEM_KIND_IMPORT or
        item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or
        item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or item.kind == frontend.ITEM_KIND_PURE_GLOBAL or
        item.kind == frontend.ITEM_KIND_SOFT_BUILTIN or item.kind == frontend.ITEM_KIND_NOOP {
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + integer.intText(tempIndex);
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    writes = outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { firstTemp }, indent, failAction);
                }
                temp := "lt_output_" + integer.intText(tempIndex);
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, code, temp, indent);
                writes = writes + indent + "if (printf(\" \") < 0) { " + failAction + " }\n" +
                outputWriteCode(item.kind, if item.kind == frontend.VALUE_KIND_UNIT or item.kind == frontend.VALUE_KIND_NEVER { "0" } else { temp }, indent, failAction);
            }
            count = count + 1;
        }
    }
};

/** Emits one C11 function definition starting at `FUNCTION_START` index `startIndex` and returns the index after `FUNCTION_END`. */
emitOneCFunction := fn(reachable: frontend.Items, startIndex: Int, total: Int, hoistedGlobals: frontend.TokenBuckets): Int {
    fnItem := reachable[startIndex];
    fnItems: mut frontend.Items = [];
    var idx := startIndex + 1;
    var depth := 1;
    loop idx < total {
        item := reachable[idx];
        if item.kind == frontend.ITEM_KIND_FUNCTION_START { depth = depth + 1; }
        else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            depth = depth - 1;
            if depth == 0 {
                idx = idx + 1;
                break;
            }
        }
        listLib.pushBack(mut fnItems, item);
        idx = idx + 1;
    }
    io.outputLine("static " + cScalarType(fnItem.code) + " " + fnItem.runtime + "(" + cParameterList(fnItem.textValue) + ") {");
    emitCParameterReads(fnItem.textValue);
    emitArithmeticTemporaries(fnItems);
    emitCItemStream(fnItems, hoistedGlobals, fnItem.code, "lt_io_status = 1;");
    io.outputLine("}");
    io.outputLine("");
    idx
};

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications and optimization level (`0..3`). */
/** Returns all C-supported struct (`S|<kind>`) and list (`L|<elemKind>`) types referenced by `kind` in post-order. */
collectSubKinds := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        if frontend.cListTag(elKind) == "" { return out; }
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        listLib.pushBack(mut out, "L|" + elKind);
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        if frontend.cStructTag(kind) == "" { return out; }
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        listLib.pushBack(mut out, "S|" + kind);
        return out;
    }
    out
};

/** Returns all struct/list tags and `"FLOAT"`/`"FLOAT32"` markers reachable inside `kind` for print/copy/float tracking. */
collectTypeFlags := fn(kind: String): List<String> {
    out: mut List<String> = [];
    if frontend.isFloatScalarKind(kind) {
        listLib.pushBack(mut out, "FLOAT");
        if kind == frontend.VALUE_KIND_FLOAT32 { listLib.pushBack(mut out, "FLOAT32"); }
        return out;
    }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        tag := frontend.cListTag(elKind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "L:" + tag);
        sub := self(elKind);
        loop sub as s { listLib.pushBack(mut out, s); }
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        tag := frontend.cStructTag(kind);
        if tag == "" { return out; }
        listLib.pushBack(mut out, "S:" + tag);
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { listLib.pushBack(mut out, s); }
            i = i + 1;
        }
        return out;
    }
    out
};

/** Extracts all `/*@T:<kind>@*/` and `/*@C:<exp>|<act>@*/` payloads from emitted C expression `code`. */
extractCTypeAnnotations := fn(code: String): List<String> {
    out: mut List<String> = [];
    if textLib.indexOfText(code, "/*@", 0) < 0 { return out; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            if endTag < 0 { break; }
            listLib.pushBack(mut out, textLib.slice(code, cursor + 3, endTag));
            cursor = endTag + 3;
        } else {
            cursor = cursor + 1;
        }
    }
    out
};

pub emitProgramWithSpecsOpt := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, optLevel: Int): Unit {
    _modes := frontend.parseBuiltinModeSpecs(prefix, builtinSpecs);
    reachable := frontend.filterReachableItemsWithOpt(items, frontend.TARGET_C, optLevel);
    calls := frontend.targetHelperCalls(reachable);
    var floatOutput := false;
    var hasFunctions := false;
    var hasFnOutput := false;
    var hasUnreachable := false;
    floatLiterals := usesIntHelper(calls, "lt_float_literal(");
    float32Literals := usesIntHelper(calls, "lt_float32_literal(");
    var float32Values := float32Literals or usesIntHelper(calls, "lt_float32_op(");
    var floatValues := floatLiterals or float32Values or usesFloatArithmetic(calls);
    var fnRefTokens := frontend.emptyTokenBuckets();
    var fnDepth := 0;
    loop reachable as item {
        if frontend.isFloatScalarKind(item.kind) { floatOutput = true; }
        if frontend.isFloatScalarKind(item.kind) or item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isFloatScalarKind(item.name)) { floatValues = true; }
        if item.kind == frontend.VALUE_KIND_FLOAT32 or (item.kind == frontend.ITEM_KIND_DISCARD and item.name == frontend.VALUE_KIND_FLOAT32) { float32Values = true; }
        if item.kind == frontend.ITEM_KIND_UNREACHABLE { hasUnreachable = true; }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            hasFunctions = true;
            fnDepth = fnDepth + 1;
            checkCFunctionSignature(item);
            if frontend.isFloatScalarKind(item.code) { floatValues = true; }
            if item.code == frontend.VALUE_KIND_FLOAT32 { float32Values = true; }
            if textLib.indexOfText(item.textValue, "=Float", 0) >= 0 { floatValues = true; }
            if textLib.indexOfText(item.textValue, "=Float32", 0) >= 0 { float32Values = true; }
        } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
        } else if fnDepth > 0 {
            if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT { hasFnOutput = true; }
            fnRefTokens = frontend.codeReachableTokensSet(item.code, fnRefTokens);
            if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                fnRefTokens = frontend.tokenBucketAdd(fnRefTokens, item.runtime);
            }
        }
        unsupported := unsupportedBuiltinCode(frontend.targetCodeCalls(item.code, "|"));
        if unsupported =!= "" {
            diagLib.fail("", unsupported);
        }
        if (frontend.isTupleKind(item.kind) and frontend.cStructTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isTupleKind(item.name) and frontend.cStructTag(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_TUPLE or item.kind == frontend.ITEM_KIND_VAR_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE) and frontend.cStructTag(item.textValue) == "") {
            diagLib.fail("", "C backend does not support tuple values yet");
        }
        if frontend.isMapKind(item.kind) or frontend.isMapKind(item.textValue) or (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isMapKind(item.name)) {
            diagLib.fail("", "C backend does not support map values yet");
        }
        if frontend.isSetKind(item.kind) or frontend.isSetKind(item.textValue) or (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isSetKind(item.name)) {
            diagLib.fail("", "C backend does not support set values yet");
        }
        isUnsupportedRecordDecl := (item.kind == frontend.ITEM_KIND_LOCAL_RECORD or item.kind == frontend.ITEM_KIND_VAR_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD) and not frontend.isEnumKind(item.textValue) and frontend.cStructTag(item.textValue) == "";
        if (frontend.isRecordKind(item.kind) and frontend.cStructTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isRecordKind(item.name) and frontend.cStructTag(item.name) == "") or isUnsupportedRecordDecl {
            diagLib.fail("", "C backend does not support record values yet");
        }
        if (frontend.isListKind(item.kind) and cListTagForKind(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isListKind(item.name) and cListTagForKind(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_LIST or item.kind == frontend.ITEM_KIND_VAR_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_LIST) and cListTagForKind(item.textValue) == "") {
            diagLib.fail("", "C backend does not support list values yet");
        }
        if (frontend.isArrayKind(item.kind) and cListTagForKind(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isArrayKind(item.name) and cListTagForKind(item.name) == "") {
            diagLib.fail("", "C backend does not support array values yet");
        }
        if frontend.containsFnKind(item.kind) or (item.kind == frontend.ITEM_KIND_DISCARD and frontend.containsFnKind(item.name)) or item.kind == frontend.ITEM_KIND_LOCAL_FN or item.kind == frontend.ITEM_KIND_VAR_FN or item.kind == frontend.ITEM_KIND_ASSIGN_FN {
            diagLib.fail("", "C backend does not support function values yet");
        }
        if item.kind == frontend.ITEM_KIND_LOOP_SEQ and frontend.cListTag(item.textValue) == "" {
            diagLib.fail("", "C backend does not support list traversal yet");
        }
        if frontend.codeUsesListIndex(item.code) or frontend.codeUsesListPop(item.code) or frontend.codeUsesListCopy(item.code) {
            diagLib.fail("", "C backend does not support list values yet");
        }
        aggErr := unsupportedAggregateCode(item.code);
        if aggErr =!= "" {
            diagLib.fail("", aggErr);
        }
    }
    orderedEntries: mut List<String> = [];
    var seenTypeKeys := frontend.emptyTokenBuckets();
    var printTypeKeys := frontend.emptyTokenBuckets();
    var copyTypeKeys := frontend.emptyTokenBuckets();
    convExpKinds: mut List<String> = [];
    convActKinds: mut List<String> = [];
    var seenConvNames := frontend.emptyTokenBuckets();
    seedKinds: mut List<String> = [];
    hasInputArgs := usesIntHelper(calls, "lite$inputArgs(");
    if hasInputArgs { listLib.pushBack(mut seedKinds, "List<String>"); }
    loop reachable as item {
        if cListTagForKind(item.kind) =!= "" or frontend.cStructTag(item.kind) =!= "" {
            listLib.pushBack(mut seedKinds, item.kind);
            pFlags := collectTypeFlags(item.kind);
            loop pFlags as pf {
                if pf == "FLOAT" { floatOutput = true; floatValues = true; }
                else if pf == "FLOAT32" { float32Values = true; }
                else { printTypeKeys = frontend.tokenBucketAdd(printTypeKeys, pf); }
            }
        }
        if item.kind == frontend.ITEM_KIND_DISCARD and (cListTagForKind(item.name) =!= "" or frontend.cStructTag(item.name) =!= "") {
            listLib.pushBack(mut seedKinds, item.name);
        }
        if item.kind == frontend.ITEM_KIND_LOCAL_LIST or item.kind == frontend.ITEM_KIND_VAR_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_LIST or
        item.kind == frontend.ITEM_KIND_LOCAL_TUPLE or item.kind == frontend.ITEM_KIND_VAR_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE or
        item.kind == frontend.ITEM_KIND_LOCAL_RECORD or item.kind == frontend.ITEM_KIND_VAR_RECORD or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD {
            if cListTagForKind(item.textValue) =!= "" or frontend.cStructTag(item.textValue) =!= "" {
                listLib.pushBack(mut seedKinds, item.textValue);
            }
        }
        if item.kind == frontend.ITEM_KIND_LOOP_SEQ and frontend.cListTag(item.textValue) =!= "" {
            seqListKind := "List<" + item.textValue + ">";
            listLib.pushBack(mut seedKinds, seqListKind);
            if item.intValue =!= 1 {
                cFlags := collectTypeFlags(seqListKind);
                loop cFlags as cf {
                    if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                }
            }
        }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            if cListTagForKind(item.code) =!= "" or frontend.cStructTag(item.code) =!= "" {
                listLib.pushBack(mut seedKinds, item.code);
            }
            if item.textValue =!= "" {
                var pStart := 0;
                loop true {
                    pSep := textLib.indexOfText(item.textValue, "|", pStart);
                    pEnd := if pSep >= 0 { pSep } else { textLib.length(item.textValue) };
                    pEntry := textLib.slice(item.textValue, pStart, pEnd);
                    pEq := textLib.indexOfText(pEntry, "=", 0);
                    if pEq >= 0 {
                        pKind := textLib.slice(pEntry, pEq + 1, textLib.length(pEntry));
                        if cListTagForKind(pKind) =!= "" or frontend.cStructTag(pKind) =!= "" {
                            listLib.pushBack(mut seedKinds, pKind);
                        }
                    }
                    if pSep < 0 { break; }
                    pStart = pSep + 1;
                }
            }
        }
        annots := extractCTypeAnnotations(item.code);
        loop annots as ann {
            if textLib.startsWithAt(ann, 0, "T:") {
                listLib.pushBack(mut seedKinds, textLib.slice(ann, 2, textLib.length(ann)));
            } else if textLib.startsWithAt(ann, 0, "C:") {
                body := textLib.slice(ann, 2, textLib.length(ann));
                bar := textLib.indexOfText(body, "|", 0);
                if bar > 0 {
                    eKind := textLib.slice(body, 0, bar);
                    aKind := textLib.slice(body, bar + 1, textLib.length(body));
                    listLib.pushBack(mut seedKinds, eKind);
                    listLib.pushBack(mut seedKinds, aKind);
                    cName := frontend.cTupleConvertName(eKind, aKind);
                    if not frontend.tokenBucketHas(seenConvNames, cName) {
                        seenConvNames = frontend.tokenBucketAdd(seenConvNames, cName);
                        listLib.pushBack(mut convExpKinds, eKind);
                        listLib.pushBack(mut convActKinds, aKind);
                        cFlags := collectTypeFlags(eKind);
                        loop cFlags as cf {
                            if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                        }
                    }
                }
            }
        }
    }
    if textLib.indexOfText(calls, "|lt_list_i64_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Int>"); }
    if textLib.indexOfText(calls, "|lt_list_f64_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Float>"); }
    if textLib.indexOfText(calls, "|lt_list_bool_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<Bool>"); }
    if textLib.indexOfText(calls, "|lt_list_str_", 0) >= 0 { listLib.pushBack(mut seedKinds, "List<String>"); }
    var hasAnyList := false;
    loop seedKinds as sk {
        tFlags := collectTypeFlags(sk);
        loop tFlags as tf {
            if tf == "FLOAT" { floatValues = true; }
            else if tf == "FLOAT32" { float32Values = true; }
        }
        subs := collectSubKinds(sk);
        loop subs as sub {
            isL := textLib.startsWithAt(sub, 0, "L|");
            payload := textLib.slice(sub, 2, textLib.length(sub));
            tKey := if isL { "L:" + frontend.cListTag(payload) } else { "S:" + frontend.cStructTag(payload) };
            if not frontend.tokenBucketHas(seenTypeKeys, tKey) {
                seenTypeKeys = frontend.tokenBucketAdd(seenTypeKeys, tKey);
                listLib.pushBack(mut orderedEntries, sub);
                if isL { hasAnyList = true; }
            }
        }
    }
    extraListSeeds: mut List<String> = [];
    loop orderedEntries as oe {
        if textLib.startsWithAt(oe, 0, "S|") {
            sKind := textLib.slice(oe, 2, textLib.length(oe));
            sTag := frontend.cStructTag(sKind);
            if textLib.indexOfText(calls, "|lt_list_" + sTag + "_", 0) >= 0 and not frontend.tokenBucketHas(seenTypeKeys, "L:" + sTag) {
                seenTypeKeys = frontend.tokenBucketAdd(seenTypeKeys, "L:" + sTag);
                listLib.pushBack(mut extraListSeeds, "L|" + sKind);
                hasAnyList = true;
            }
            if usesIntHelper(calls, sTag + "_copy(") or usesIntHelper(calls, "lt_list_" + sTag + "_copy(") {
                cFlags := collectTypeFlags(sKind);
                loop cFlags as cf {
                    if cf =!= "FLOAT" and cf =!= "FLOAT32" { copyTypeKeys = frontend.tokenBucketAdd(copyTypeKeys, cf); }
                }
            }
        }
    }
    loop extraListSeeds as el { listLib.pushBack(mut orderedEntries, el); }
    hasReportError := usesIntHelper(calls, "lite$reportError(");
    hasExit := usesIntHelper(calls, "lite$exit(");
    hasInput := usesInputHelpers(calls);
    hasInputInt := usesIntHelper(calls, "lite$inputInt(");
    hasInputFloat := usesIntHelper(calls, "lite$inputFloat(");
    io.outputLine("#include <stdio.h>");
    if usesIntDivision(calls) or usesStringConcat(calls) or usesIntArithmetic(calls) or floatValues or hasUnreachable or hasExit or usesTextPrimitives(calls) or hasInput or hasAnyList { io.outputLine("#include <stdlib.h>"); }
    if hasInputInt { io.outputLine("#include <errno.h>"); }
    io.outputLine("#include <inttypes.h>");
    io.outputLine("#include <stdbool.h>");
    io.outputLine("#include <string.h>");
    if usesFloatArithmetic(calls) or hasInputFloat { io.outputLine("#include <math.h>"); }
    if floatValues {
        io.outputLine("#include <float.h>");
        io.outputLine("_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024, \"Float requires binary64 double\");");
    }
    if float32Values {
        io.outputLine("_Static_assert(FLT_RADIX == 2 && FLT_MANT_DIG == 24 && FLT_MAX_EXP == 128, \"Float32 requires binary32 float\");");
    }
    if floatLiterals { io.outputLine("static double lt_float_literal(const char *text) { return strtod(text, NULL); }"); }
    if float32Literals { io.outputLine("static float lt_float32_literal(const char *text) { return strtof(text, NULL); }"); }
    if floatOutput { emitFloatOutputHelpers(); }
    if hasReportError { io.outputLine("static void lt_report_error(const char *text) { fprintf(stderr, \"%s\\n\", text); }"); }
    if hasExit { io.outputLine("static _Noreturn void lt_exit(int64_t status) { fflush(stdout); exit((int)status); }"); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesStringConcat(calls) { emitStringConcatHelper(); }
    emitTextPrimitiveHelpers(calls);
    emitInputHelpers(calls);
    loop orderedEntries as oe {
        isL := textLib.startsWithAt(oe, 0, "L|");
        payload := textLib.slice(oe, 2, textLib.length(oe));
        if isL {
            lTag := frontend.cListTag(payload);
            lNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "L:" + lTag);
            lNeedPrint := frontend.tokenBucketHas(printTypeKeys, "L:" + lTag);
            lNeedFrom := hasInputArgs and lTag == "str";
            emitCListTagHelpers(lTag, payload, calls, lNeedCopy, lNeedPrint, lNeedFrom);
        } else {
            sTag := frontend.cStructTag(payload);
            sNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "S:" + sTag);
            sNeedPrint := frontend.tokenBucketHas(printTypeKeys, "S:" + sTag);
            emitCStructHelpers(payload, sNeedCopy, sNeedPrint);
        }
    }
    var convIdx := 0;
    convCount := listLib.length(convExpKinds);
    loop convIdx < convCount {
        emitCTupleConvHelper(convExpKinds[convIdx], convActKinds[convIdx]);
        convIdx = convIdx + 1;
    }
    if hasInputArgs {
        io.outputLine("static int lt_argc = 0;");
        io.outputLine("static char **lt_argv = NULL;");
        io.outputLine("static lt_list_str lt_input_args(void) {");
        io.outputLine("    if (lt_argc <= 1) { return lt_list_str_from(0, NULL); }");
        io.outputLine("    return lt_list_str_from((int64_t)(lt_argc - 1), (const char *const *)(lt_argv + 1));");
        io.outputLine("}");
        io.outputLine("");
    }
    var hoistedGlobals := frontend.emptyTokenBuckets();
    if hasFunctions {
        if hasFnOutput { io.outputLine("static int lt_io_status = 0;"); }
        var scanDepth := 0;
        var scanBlocks := 0;
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                scanDepth = scanDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                if scanDepth > 0 { scanDepth = scanDepth - 1; }
            } else if scanDepth == 0 {
                if item.kind == frontend.ITEM_KIND_SCOPE or item.kind == frontend.ITEM_KIND_IF or item.kind == frontend.ITEM_KIND_LOOP or item.kind == frontend.ITEM_KIND_LOOP_SEQ {
                    scanBlocks = scanBlocks + 1;
                } else if item.kind == frontend.ITEM_KIND_END_SCOPE or item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_LOOP {
                    if scanBlocks > 0 { scanBlocks = scanBlocks - 1; }
                } else if scanBlocks == 0 and isCLocalDeclKind(item.kind) and frontend.tokenBucketHas(fnRefTokens, item.runtime) and
                not frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                    hoistedGlobals = frontend.tokenBucketAdd(hoistedGlobals, item.runtime);
                    io.outputLine("static " + cDeclTypeItem(item) + item.runtime + ";");
                }
            }
        }
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                io.outputLine("static " + cScalarType(item.code) + " " + item.runtime + "(" + cParameterList(item.textValue) + ");");
            }
        }
        io.outputLine("");
        var totalItems := 0;
        loop reachable { totalItems = totalItems + 1; }
        var fnIdx := 0;
        loop fnIdx < totalItems {
            if reachable[fnIdx].kind == frontend.ITEM_KIND_FUNCTION_START {
                fnIdx = emitOneCFunction(reachable, fnIdx, totalItems, hoistedGlobals);
            } else {
                fnIdx = fnIdx + 1;
            }
        }
    }
    mainItems: mut frontend.Items = [];
    if hasFunctions {
        var mDepth := 0;
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START { mDepth = mDepth + 1; }
            else if item.kind == frontend.ITEM_KIND_FUNCTION_END { if mDepth > 0 { mDepth = mDepth - 1; } }
            else if mDepth == 0 { listLib.pushBack(mut mainItems, item); }
        }
    } else {
        loop reachable as item { listLib.pushBack(mut mainItems, item); }
    }
    if hasInputArgs {
        io.outputLine("int main(int argc, char **argv) {");
        io.outputLine("    lt_argc = argc; lt_argv = argv;");
    } else {
        io.outputLine("int main(void) {");
    }
    io.outputLine("    int status = 0;");
    emitArithmeticTemporaries(mainItems);
    emitCItemStream(mainItems, hoistedGlobals, "", "status = 1;");
    if hasFnOutput {
        io.outputLine("    return status ? status : lt_io_status;");
    } else {
        io.outputLine("    return status;");
    }
    io.outputLine("}");
}

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications at default `-O1`. */
pub emitProgramWithSpecs := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>): Unit {
    emitProgramWithSpecsOpt(items, source, prefix, builtinSpecs, 1);
}

/** Emits the C program from the flat item stream using default builtin modes. */
pub emitProgram := fn(items: frontend.Items, source: String, prefix: String): Unit {
    emptySpecs: List<String> = [];
    emitProgramWithSpecsOpt(items, source, prefix, emptySpecs, 1);
}
