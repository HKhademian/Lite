        io.outputLine("    if (strcmp(reader." + fKind + ", \"stdin\") == 0 && reader." + fHandle + " == 0) { return lt_stdin_err[0] == '\\0'; }");
        io.outputLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        io.outputLine("    return e != NULL && (e->kind == 1 || e->kind == 2) && !e->closed && e->error[0] == '\\0';");
        io.outputLine("}");
    }
    if usesIntHelper(calls, "lite$ioReaderAtEof(") {
        io.outputLine("static bool lt_io_reader_at_eof(" + shTag + " reader) {");
        io.outputLine("    if (strcmp(reader." + fKind + ", \"stdin\") == 0 && reader." + fHandle + " == 0) { return lt_stdin_eof; }");
        io.outputLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
