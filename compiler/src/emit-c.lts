frontend := import "./frontend.lts";
cLiteral := import "./c-literals.lts";
integer := import "core/int";
listLib := import "core/list";
diagLib := import "core/diag";
io := import "core/io";
textLib := import "core/text";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textLib.slice(indent, 0, textLib.length(indent) - 4)
}

/** Returns the C11 scalar list tag (`i64`, `f64`, `bool`, `str`) for a List/Array kind, or `""` if not a C-supported list/array. */
cListTagForKind := fn(kind: String): String {
    if frontend.isListKind(kind) { frontend.cListTag(frontend.listElementKind(kind)) }
    else if frontend.isArrayKind(kind) { frontend.cListTag(frontend.arrayElementKind(kind)) }
    else { "" }
};

/** Maps a restricted Lite scalar, enum, struct, map, set, list/array, or Unit/Never kind to its C11 type. */
cScalarType := fn(kind: String): String {
    listTag := cListTagForKind(kind);
    if listTag =!= "" { "lt_list_" + listTag }
    else if frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) }
    else if frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) }
    else if frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) }
    else if kind == frontend.VALUE_KIND_UNIT or kind == frontend.VALUE_KIND_NEVER { "void" }
    else if frontend.isIntScalarKind(kind) or frontend.isEnumKind(kind) { "int64_t" }
    else if kind == frontend.VALUE_KIND_BOOL { "bool" }
    else if frontend.isFloatScalarKind(kind) { "double" }
    else { "const char *" }
};

/** Maps a local or mutable variable item to its C11 declaration type prefix. */
cDeclTypeItem := fn(item: frontend.Item): String {
    kind := item.kind;
    if kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST {
        "lt_list_" + cListTagForKind(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE {
        frontend.cStructTag(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD {
        cScalarType(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT { "int64_t " }
    else if kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT { "double " }
    else if kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL { "bool " }
    else { "const char *" }
};

/** Fails cleanly when a reachable scalar/function signature references an unsupported C type. */
checkUnsupportedCType := fn(kind: String): Unit {
    if frontend.isTupleKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support tuple values yet"); }
    if frontend.isMapKind(kind) and frontend.cMapTag(kind) == "" { diagLib.fail("", "C backend does not support map values yet"); }
    if frontend.isSetKind(kind) and frontend.cSetTag(kind) == "" { diagLib.fail("", "C backend does not support set values yet"); }
    if frontend.isRecordKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support record values yet"); }
    if frontend.isListKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support list values yet"); }
    if frontend.isArrayKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support array values yet"); }
    if frontend.containsFnKind(kind) { diagLib.fail("", "C backend does not support function values yet"); }
};

/** Checks parameter and return types of a reachable top-level or module function for C11 emission. */
checkCFunctionSignature := fn(item: frontend.Item): Unit {
    checkUnsupportedCType(item.code);
    encoded := item.textValue;
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        if eq >= 0 {
            checkUnsupportedCType(textLib.slice(entry, eq + 1, textLib.length(entry)));
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** Emits UTF-8 Unicode scalar `core/text` C11 helpers only for primitives referenced by `calls`. */
emitTextPrimitiveHelpers := fn(calls: String): Unit {
    hasSliceFrom := usesIntHelper(calls, "lite$textSliceFrom(");
    hasLen := usesIntHelper(calls, "lite$textLength(") or hasSliceFrom;
    hasAt := usesIntHelper(calls, "lite$textAt(");
    hasSlice := usesIntHelper(calls, "lite$textSlice(") or hasSliceFrom;
    if not hasLen and not hasAt and not hasSlice { return; }
    io.outputLine("static size_t lt_utf8_step(const char *s, size_t offset) {");
    io.outputLine("    const unsigned char b = (unsigned char)s[offset];");
    io.outputLine("    if (b < 0x80u) { return 1u; }");
    io.outputLine("    if ((b & 0xE0u) == 0xC0u && s[offset + 1] != '\\0') { return 2u; }");
    io.outputLine("    if ((b & 0xF0u) == 0xE0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0') { return 3u; }");
    io.outputLine("    if ((b & 0xF8u) == 0xF0u && s[offset + 1] != '\\0' && s[offset + 2] != '\\0' && s[offset + 3] != '\\0') { return 4u; }");
    io.outputLine("    return 1u;");
    io.outputLine("}");
    io.outputLine("typedef struct { const char *s; size_t byte_len; int64_t cp_len; bool ascii; size_t last_b; int64_t last_cp; } lt_utf8_meta;");
    io.outputLine("static lt_utf8_meta lt_utf8_cache[8];");
    io.outputLine("static int lt_utf8_cache_next = 0;");
    io.outputLine("static lt_utf8_meta *lt_utf8_get_meta(const char *s) {");
    io.outputLine("    for (int i = 0; i < 8; i += 1) { if (lt_utf8_cache[i].s == s) { return &lt_utf8_cache[i]; } }");
    io.outputLine("    size_t b = 0u; int64_t cp = 0; bool ascii = true;");
    io.outputLine("    while (s[b] != '\\0') {");
    io.outputLine("        if ((unsigned char)s[b] < 0x80u) { b += 1u; cp += 1; }");
    io.outputLine("        else { ascii = false; b += lt_utf8_step(s, b); cp += 1; }");
    io.outputLine("    }");
    io.outputLine("    lt_utf8_meta *slot = &lt_utf8_cache[lt_utf8_cache_next];");
    io.outputLine("    lt_utf8_cache_next = (lt_utf8_cache_next + 1) & 7;");
    io.outputLine("    slot->s = s; slot->byte_len = b; slot->cp_len = cp; slot->ascii = ascii; slot->last_b = 0u; slot->last_cp = 0;");
    io.outputLine("    return slot;");
    io.outputLine("}");
    if hasAt or hasSlice {
        io.outputLine("static const char *lt_alloc_text_slice(const char *s, size_t start, size_t end) {");
        io.outputLine("    const size_t len = end - start;");
        io.outputLine("    char *out = malloc(len + 1u);");
        io.outputLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate sliced text\\n\"); exit(1); }");
        io.outputLine("    if (len > 0u) { memcpy(out, s + start, len); }");
        io.outputLine("    out[len] = '\\0';");
        io.outputLine("    return out;");
        io.outputLine("}");
        io.outputLine("static size_t lt_utf8_byte_at(const char *s, int64_t target, bool allow_end, bool *ok) {");
        io.outputLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        io.outputLine("    if (target < 0 || target > m->cp_len || (!allow_end && target == m->cp_len)) { *ok = false; return 0u; }");
        io.outputLine("    if (m->ascii) { *ok = true; return (size_t)target; }");
        io.outputLine("    if (target == m->cp_len) { *ok = true; return m->byte_len; }");
        io.outputLine("    size_t byte_pos = (target >= m->last_cp) ? m->last_b : 0u;");
        io.outputLine("    int64_t count = (target >= m->last_cp) ? m->last_cp : 0;");
        io.outputLine("    while (count < target && s[byte_pos] != '\\0') { byte_pos += lt_utf8_step(s, byte_pos); count += 1; }");
        io.outputLine("    m->last_b = byte_pos; m->last_cp = count;");
        io.outputLine("    *ok = true;");
        io.outputLine("    return byte_pos;");
        io.outputLine("}");
    }
    if hasLen {
        io.outputLine("static int64_t lt_text_length(const char *s) { return lt_utf8_get_meta(s)->cp_len; }");
    }
    if hasAt {
        io.outputLine("static char lt_ascii_chars[128][2];");
        io.outputLine("static bool lt_ascii_chars_init = false;");
        io.outputLine("static const char *lt_text_at(const char *s, int64_t position, size_t at) {");
        io.outputLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        io.outputLine("    if (position < 0 || position >= m->cp_len) { lt_bound_fault(at, \"textAt index outside text\"); }");
        io.outputLine("    if (m->ascii) {");
        io.outputLine("        if (!lt_ascii_chars_init) { for (int i = 0; i < 128; i += 1) { lt_ascii_chars[i][0] = (char)i; lt_ascii_chars[i][1] = '\\0'; } lt_ascii_chars_init = true; }");
        io.outputLine("        return lt_ascii_chars[(unsigned char)s[position]];");
        io.outputLine("    }");
        io.outputLine("    bool ok = false;");
        io.outputLine("    const size_t start = lt_utf8_byte_at(s, position, false, &ok);");
        io.outputLine("    if (!ok) { lt_bound_fault(at, \"textAt index outside text\"); }");
        io.outputLine("    return lt_alloc_text_slice(s, start, start + lt_utf8_step(s, start));");
        io.outputLine("}");
    }
    if hasSlice {
        io.outputLine("static const char *lt_text_slice(const char *s, int64_t start, int64_t end, size_t at) {");
        io.outputLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        io.outputLine("    if (start < 0 || end < start || end > m->cp_len) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    if (m->ascii) { return lt_alloc_text_slice(s, (size_t)start, (size_t)end); }");
        io.outputLine("    bool ok = false;");
        io.outputLine("    const size_t b_start = lt_utf8_byte_at(s, start, true, &ok);");
        io.outputLine("    if (!ok) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    size_t b_end = b_start;");
        io.outputLine("    int64_t remaining = end - start;");
        io.outputLine("    while (remaining > 0 && s[b_end] != '\\0') { b_end += lt_utf8_step(s, b_end); remaining -= 1; }");
        io.outputLine("    if (remaining > 0) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        io.outputLine("    return lt_alloc_text_slice(s, b_start, b_end);");
        io.outputLine("}");
    }
    if hasSliceFrom {
        io.outputLine("static const char *lt_text_slice_from(const char *s, int64_t start, size_t at) {");
        io.outputLine("    return lt_text_slice(s, start, lt_text_length(s), at);");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** True when a program calls supported C11 stdin helpers (`inputAll`, `inputLine`, `inputInt`, `inputFloat`). */
usesInputHelpers := fn(calls: String): Bool {
    usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or
    usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(")
};

/** Emits portable ISO C11 stdin helpers matching Lite's `core/io` prompt and `InputFault` contracts. */
emitInputHelpers := fn(calls: String): Unit {
    hasAll := usesIntHelper(calls, "lite$inputAll(");
    hasLine := usesIntHelper(calls, "lite$inputLine(");
    hasInt := usesIntHelper(calls, "lite$inputInt(");
    hasFloat := usesIntHelper(calls, "lite$inputFloat(");
    if not hasAll and not hasLine and not hasInt and not hasFloat { return; }
    io.outputLine("static void lt_input_prompt(const char *prompt) {");
    io.outputLine("    if (prompt != NULL) { fputs(prompt, stdout); fflush(stdout); }");
    io.outputLine("}");
    if hasLine or hasInt or hasFloat {
        io.outputLine("static _Noreturn void lt_input_fault(const char *at, const char *message) {");
        io.outputLine("    fprintf(stderr, \"%s%s\\n\", at, message);");
        io.outputLine("    exit(1);");
        io.outputLine("}");
    }
    if hasInt or hasFloat {
        io.outputLine("static char *lt_input_word(void) {");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    while (ch != EOF && (ch == ' ' || ch == '\\t' || ch == '\\r' || ch == '\\n')) { ch = fgetc(stdin); }");
        io.outputLine("    if (ch == EOF) { return NULL; }");
        io.outputLine("    size_t cap = 64u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    while (ch != EOF && ch != ' ' && ch != '\\t' && ch != '\\r' && ch != '\\n') {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    if (ch != EOF) { ungetc(ch, stdin); }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasAll {
        io.outputLine("static const char *lt_input_all(const char *prompt, const char *at) {");
        io.outputLine("    (void)at;");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    size_t cap = 128u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    while (ch != EOF) {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasLine {
        io.outputLine("static const char *lt_input_line(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    int ch = fgetc(stdin);");
        io.outputLine("    if (ch == EOF) { lt_input_fault(at, \"EOF before inputLine value\"); }");
        io.outputLine("    size_t cap = 128u, len = 0u;");
        io.outputLine("    char *buf = malloc(cap);");
        io.outputLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        io.outputLine("    while (ch != EOF && ch != '\\n') {");
        io.outputLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        io.outputLine("        buf[len++] = (char)ch;");
        io.outputLine("        ch = fgetc(stdin);");
        io.outputLine("    }");
        io.outputLine("    if (ch == '\\n' && len > 0u && buf[len - 1u] == '\\r') { len -= 1u; }");
        io.outputLine("    buf[len] = '\\0';");
        io.outputLine("    return buf;");
        io.outputLine("}");
    }
    if hasInt {
        io.outputLine("static int64_t lt_input_int(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    char *tok = lt_input_word();");
        io.outputLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputInt value\"); }");
        io.outputLine("    size_t i = (tok[0] == '+' || tok[0] == '-') ? 1u : 0u;");
        io.outputLine("    if (tok[i] == '\\0') { free(tok); lt_input_fault(at, \"expected an integer token\"); }");
        io.outputLine("    while (tok[i] != '\\0') { if (tok[i] < '0' || tok[i] > '9') { free(tok); lt_input_fault(at, \"expected an integer token\"); } i += 1u; }");
        io.outputLine("    errno = 0;");
        io.outputLine("    char *endp = NULL;");
        io.outputLine("    long long val = strtoll(tok, &endp, 10);");
        io.outputLine("    int err = errno;");
        io.outputLine("    free(tok);");
        io.outputLine("    if (err == ERANGE || val < INT64_MIN || val > INT64_MAX) { lt_input_fault(at, \"input outside signed 64-bit range\"); }");
        io.outputLine("    return (int64_t)val;");
        io.outputLine("}");
    }
    if hasFloat {
        io.outputLine("static double lt_input_float(const char *prompt, const char *at) {");
        io.outputLine("    lt_input_prompt(prompt);");
        io.outputLine("    char *tok = lt_input_word();");
        io.outputLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputFloat value\"); }");
        io.outputLine("    char *endp = NULL;");
        io.outputLine("    double val = strtod(tok, &endp);");
        io.outputLine("    bool ok = endp != tok && *endp == '\\0' && isfinite(val);");
        io.outputLine("    free(tok);");
        io.outputLine("    if (!ok) { lt_input_fault(at, \"expected a finite floating token\"); }");
        io.outputLine("    return val;");
        io.outputLine("}");
    }
    io.outputLine("");
};

/** Formats a pipe-separated parameter list as C11 typed parameters or `void`. */
cParameterList := fn(encoded: String): String {
    if encoded == "" { return "void"; }
    var result := "";
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        paramName := textLib.slice(entry, 0, eq);
        paramKind := textLib.slice(entry, eq + 1, textLib.length(entry));
        if textLib.length(result) > 0 { result = result + ", "; }
        result = result + cScalarType(paramKind) + " lite_" + paramName;
        if sep < 0 { break; }
        start = sep + 1;
    }
    result
};

/** Emits `(void)lite_param;` silencing reads for strict C11 warning checks. */
emitCParameterReads := fn(encoded: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := textLib.indexOfText(encoded, "|", start);
        end := if sep >= 0 { sep } else { textLib.length(encoded) };
        entry := textLib.slice(encoded, start, end);
        eq := textLib.indexOfText(entry, "=", 0);
        io.outputLine("    (void)lite_" + textLib.slice(entry, 0, eq) + ";");
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** True when `item.kind` starts a local/mutable variable declaration. */
isCLocalDeclKind := fn(kind: String): Bool {
    kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT or
    kind == frontend.ITEM_KIND_LOCAL_STRING or kind == frontend.ITEM_KIND_VAR_STRING or
    kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT or
    kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL or
    kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE or
    kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST
};

/** Detects leaked JS tuple or array literal syntax inside a scalar-typed expression on C, skipping quoted strings, type annotations, and C11 compound literals. */
unsupportedAggregateCode := fn(code: String): String {
    if textLib.indexOfText(code, "{", 0) < 0 and textLib.indexOfText(code, "[", 0) < 0 { return ""; }
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
        } else if ch == "(" and (textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "(const ") or textLib.startsWithAt(code, cursor, "((lt_s_")) {
            isDouble := textLib.startsWithAt(code, cursor, "((const ") or textLib.startsWithAt(code, cursor, "((lt_s_");
            var depth := 0;
            loop cursor < size {
                c2 := textLib.at(code, cursor);
                if c2 == "\"" {
                    cursor = frontend.skipAliasString(code, cursor);
                } else {
                    if c2 == "(" { depth = depth + 1; }
                    else if c2 == ")" {
                        depth = depth - 1;
                        if depth == 0 {
                            cursor = cursor + 1;
                            if not isDouble and cursor < size and textLib.at(code, cursor) == "{" {
                                var bDepth := 0;
                                loop cursor < size {
                                    c3 := textLib.at(code, cursor);
                                    if c3 == "\"" { cursor = frontend.skipAliasString(code, cursor); }
                                    else {
                                        if c3 == "{" { bDepth = bDepth + 1; }
                                        else if c3 == "}" {
                                            bDepth = bDepth - 1;
                                            if bDepth == 0 { cursor = cursor + 1; break; }
                                        }
                                        cursor = cursor + 1;
                                    }
                                }
                            }
                            break;
                        }
                    }
                    cursor = cursor + 1;
                }
            }
        } else if ch == "[" and textLib.startsWithAt(code, cursor, "[0] == '\\0'") {
            cursor = cursor + textLib.length("[0] == '\\0'");
        } else if ch == "/" and textLib.startsWithAt(code, cursor, "/*@CBLK:") {
            return "";
        } else if ch == "{" and textLib.startsWithAt(code, cursor, "{ /*c-stmt*/") {
            return "";
        } else if ch == "{" {
            return "C backend does not support tuple values yet";
        } else if ch == "[" {
            return "C backend does not support array values yet";
        } else {
            cursor = cursor + 1;
        }
    }
    ""
};

/** Rewrites registered `lite$...(` builtin calls and strips internal `/*@T:...*/`/`/*@C:...*/` markers outside quoted strings. */
normalizeCBuiltinCalls := fn(code: String): String {
    if textLib.indexOfText(code, "lite$", 0) < 0 and textLib.indexOfText(code, "/*@", 0) < 0 { return code; }
    size := textLib.length(code);
    var out := "";
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and (textLib.startsWithAt(code, cursor, "/*@T:") or textLib.startsWithAt(code, cursor, "/*@C:")) {
            endTag := textLib.indexOfText(code, "@*/", cursor + 5);
            out = out + textLib.slice(code, flushed, cursor);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
