        outLine("static const char *lt_io_writer_error(" + shTag + " writer) {");
        outLine("    if ((strcmp(writer." + fKind + ", \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(writer." + fKind + ", \"stderr\") == 0 && writer." + fHandle + " == 2)) { return \"\"; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return \"invalid writer handle\"; }");
        outLine("    if (e->kind == 2) { return \"handle is a reader, not a writer\"; }");
        outLine("    if (e->error[0] != '\\0') { return e->error; }");
        outLine("    if (e->closed) { return \"writer is closed\"; }");
        outLine("    return \"\";");
