            out = out + textLib.slice(code, flushed, cursor) + "lt_process_entry_path(";
            cursor = cursor + textLib.length("lite$processEntryPath(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$processPlatform(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_process_platform(";
            cursor = cursor + textLib.length("lite$processPlatform(");
            flushed = cursor;
        } else if ch == "l" and textLib.startsWithAt(code, cursor, "lite$processArch(") {
            out = out + textLib.slice(code, flushed, cursor) + "lt_process_arch(";
            cursor = cursor + textLib.length("lite$processArch(");
