frontend := import "./frontend.lts";
modules := import "./modules.lts";
emitter := import "./emit-c.lts";
io := import "core/io";

/** Runs the C emitter over the same source graph used by the TS compiler. */
pub run := fn(): Unit {
    prefix := frontend.sourcePrefix();
    source := io.inputAll();
    if frontend.sourceModulePath() =!= "" {
        graph := modules.visitSourceModule(target = "c", path = frontend.sourceModulePath(), display = prefix,
            identity = frontend.sourceModuleIdentity(), =source, initialGraph = []);
        emitter.emitProgram(items = modules.moduleItems(graph), =source, =prefix);
    } else {
        emitter.emitProgram(items = frontend.parseProgram(target = "c", =source, =prefix), =source, =prefix);
    }
}
