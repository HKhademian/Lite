/** Expression, block, conditional, loop, call, and operator precedence parser and lowering for TS and C targets. */

formatLib := import "core/format";
listLib := import "core/list";
sourceLib := import "core/source";
numeric := import "./numeric-literals.lts";
integer := import "core/int";
tsLiteral := import "./ts-literals.lts";
ir := import "./frontend-ir.lts";
builtinsAbi := import "./builtins-abi.lts";
syntax := import "./frontend-syntax.lts";
types := import "./frontend-types.lts";
trace := import "./trace-safety.lts";
reach := import "./reachability.lts";
infer := import "./frontend-inference.lts";
ctx := import "./frontend-context.lts";
textLib := import "core/text";

/** One parsed expression matching `frontend-ir.Parsed`. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);

/** One local visible to later statements matching `frontend-ir.Local`. */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);

/** One program or module-graph item matching `frontend-ir.Item`. */
Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := type List<Item>;

/** One previously declared top-level function matching `frontend-ir.FunctionInfo`. */
FunctionInfo := type (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);

/** A later top-level scalar definition matching `frontend-ir.FutureValue`. */
FutureValue := type (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);

/** One transparent type alias matching `frontend-ir.AliasDecl`. */
AliasDecl := type (name: String, target: String, at: Int, end: Int, depth: Int);

/** Lexical control-flow and metadata context matching `frontend-ir.ConstructCtx`. */
ConstructCtx := type (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool);

/** Normalizes expected contextual value kind by erasing non-value sentinels and unwrapping `TailList<T>`. */
normalizeExpectedValueKind := fn(expected: String): String {
    if expected == ir.VALUE_KIND_UNIT or expected == ir.VALUE_KIND_NEVER {
        ""
    } else if textLib.startsWithAt(expected, 0, "TailList<") {
        "List<" + types.listElementKind(textLib.slice(expected, 4, textLib.length(expected))) + ">"
    } else {
        expected
    }
};

/** Normalizes inferred block/conditional exit kind hints passed from an enclosing context. */
inferHintKind := fn(valKind: String): String {
    if textLib.startsWithAt(valKind, 0, (ir.VAL_KIND_INFER + ":")) {
        textLib.slice(valKind, 10, textLib.length(valKind))
    } else if valKind == ir.VAL_KIND_INFER or valKind == ir.VALUE_KIND_UNIT or valKind == ir.VALUE_KIND_NEVER {
        ""
    } else {
        valKind
    }
};

/** True when `valKind` is a Pass 1 placeholder awaiting exit type inference. */
isInferPlaceholderKind := fn(valKind: String): Bool {
    valKind == ir.VAL_KIND_INFER or textLib.startsWithAt(valKind, 0, (ir.VAL_KIND_INFER + ":"))
};

/** Parses a trailing `finally { ... }` block and validates ordering against `then` and duplicate `finally`. */
parseFinallyClause := fn(target: String, source: String, afterFinWordPos: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ownerCtxs: List<ConstructCtx>, bodyDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    afterFinKw := syntax.skipTrivia(source, afterFinWordPos + 7, prefix);
    syntax.rejectMisplacedTag(source, afterFinKw, prefix, "block tag cannot appear after finally");
    finOpen := syntax.expectSymbol(source, afterFinKw, "{", prefix);
    finBarrierCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FINALLY, phase = ir.CTX_PHASE_FINALLY,
    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "",
    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
    finParsed := parseBinaryCtx(target, source, finOpen - 1, prefix, locals, functions, params, currentName,
    "", 0, ctx.appendCtx(ownerCtxs, finBarrierCtx), bodyDepth, inferMode, "finally", aliases);
    afterFinClose := syntax.skipTrivia(source, finParsed.next, prefix);
    size := textLib.length(source);
    if afterFinClose < size and textLib.wordAt(source, afterFinClose, "then") {
        syntax.failAt(source, afterFinClose, prefix, "then must appear before finally");
    }
    if afterFinClose < size and textLib.wordAt(source, afterFinClose, "finally") {
        syntax.failAt(source, afterFinClose, prefix, "duplicate finally block");
    }
    finParsed
};

/** Emits a `try { ... } finally { ... }` IIFE result for Pass 1 (marker-carrying) or Pass 2 codegen. */
finishFinallyIife := fn(tryBody: String, finParsed: Parsed, normalKind: String, leftForMarkers: Parsed, inferMode: Bool): Parsed {
    finalKind := if finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { normalKind };
    if inferMode {
        merged := ctx.collectParsedMarkers(ctx.collectParsedMarkers("", leftForMarkers), finParsed);
        return ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = finParsed.next), merged);
    }
    (kind = finalKind, code = "(() => { try { " + tryBody + " } finally { " + finParsed.code + " } })()",
    intValue = 0, textValue = "", constant = false, next = finParsed.next)
};

/** Parses `()`, a parenthesized expression, or a named/positional flat tuple literal starting at `start`. */
parseParenOrTupleExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    sourceSize := textLib.length(source);
    if textLib.at(source, syntax.skipTrivia(source, start + 1, prefix)) == ")" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = syntax.skipTrivia(source, start + 1, prefix) + 1);
    }
    if syntax.looksLikeTupleEntry(source, start + 1, prefix) {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        labels: mut List<String> = [];
        codes: mut List<String> = [];
        kinds: mut List<String> = [];
        var tupleMarkers := "";
        var count := 0;
        loop cursor < sourceSize and textLib.at(source, cursor) =!= ")" {
            var label := "";
            var valueStart := cursor;
            var value := ctx.intParsed("", 0, true, cursor);
            if syntax.isSingleEquals(source, cursor) {
                nameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if nameStart >= sourceSize or not textLib.isNameStart(textLib.at(source, nameStart)) {
                    syntax.failAt(source, nameStart, prefix, "expected a tuple field name after =");
                }
                nameEnd := textLib.skipName(source, nameStart);
                label = textLib.slice(source, nameStart, nameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, nameStart, label, prefix); }
                if listLib.listContainsText(labels, label) {
                    syntax.failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                }
                valueStart = nameStart;
                fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                value = parseBinaryCtx(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30, ctxs, iifeDepth, inferMode, "", aliases);
            } else if cursor < sourceSize and textLib.isNameStart(textLib.at(source, cursor)) {
                nameEnd := textLib.skipName(source, cursor);
                afterName := syntax.skipTrivia(source, nameEnd, prefix);
                if syntax.isSingleEquals(source, afterName) {
                    label = textLib.slice(source, cursor, nameEnd);
                    if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, cursor, label, prefix); }
                    if listLib.listContainsText(labels, label) {
                        syntax.failAt(source, cursor, prefix, "duplicate tuple field " + label);
                    }
                    valueStart = syntax.skipTrivia(source, afterName + 1, prefix);
                    fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                    value = parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                } else {
                    fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                    value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                }
            } else {
                fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
            }
            if inferMode { tupleMarkers = ctx.collectParsedMarkers(tupleMarkers, value); }
            if types.isTupleKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "nested tuple values are not supported");
            }
            if types.isListKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "list values inside tuples are not supported");
            }
            if value.kind == ir.VALUE_KIND_UNIT or value.kind == ir.VALUE_KIND_NEVER {
                failName := if label =!= "" { label } else { integer.intText(count) };
                syntax.failAt(source, valueStart, prefix, "tuple field " + failName + " cannot be " + types.displayKind(value.kind));
            }
            listLib.pushBack(mut labels, label);
            listLib.pushBack(mut codes, value.code);
            listLib.pushBack(mut kinds, value.kind);
            count = count + 1;
            cursor = syntax.skipTrivia(source, value.next, prefix);
            if cursor < sourceSize and textLib.at(source, cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = syntax.expectSymbol(source, cursor, ")", prefix);
        var kindText := "(";
        var codeText := "{ ";
        var index := 0;
        loop index < count {
            if index > 0 {
                kindText = kindText + ",";
                codeText = codeText + ", ";
            }
            kindText = kindText + labels[index] + ":" + kinds[index];
            codeText = codeText + types.tupleObjectKey(labels[index], index) + ": " + codes[index];
            index = index + 1;
        }
        return ctx.withMarkers((kind = kindText + ")", code = codeText + " }", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
    }
    var groupedExpected := expected;
    if numeric.isNumericKind(expected) {
        groupEnd := syntax.scanParenEnd(source, start, prefix);
        if groupEnd >= 0 and syntax.binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
    }
    inner := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
    next := syntax.expectSymbol(source, syntax.skipTrivia(source, inner.next, prefix), ")", prefix);
    ctx.withMarkers((kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next),
    if inferMode { ctx.collectParsedMarkers("", inner) } else { "" })
};

/** Parses prefix unary `+` or `-` (numeric literals or general runtime operands). */
parseUnarySignExpr := fn(target: String, source: String, start: Int, ch: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    after := syntax.skipTrivia(source, start + 1, prefix);
    if after < textLib.length(source) and textLib.isDigit(textLib.at(source, after)) {
        litExpected := if ch == "-" { expected } else { "" };
        return syntax.parseNumber(target, source, start, prefix, litExpected, minimum);
    }
    operand := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, "", 30, ctxs, iifeDepth, inferMode, "", aliases);
    operandLoopId := types.loopValMarkerId(operand.kind);
    if inferMode and operandLoopId >= 0 {
        if expected =!= "" and expected =!= ir.VALUE_KIND_UNIT and expected =!= ir.VALUE_KIND_NEVER and numeric.isNumericKind(expected) {
            return ctx.withMarkers((kind = expected, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
            ctx.collectParsedMarkers("", operand) + integer.intText(operandLoopId) + "=" + expected + "\n");
        }
        return ctx.withMarkers((kind = operand.kind, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
        ctx.collectParsedMarkers("", operand));
    }
    if not numeric.isNumericKind(operand.kind) {
        syntax.failAt(source, start, prefix, "unary " + ch + " requires an Int or Float operand");
    }
    code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
    if numeric.isFloatKind(operand.kind) {
        return ctx.withMarkers((kind = operand.kind, code = code, intValue = 0, textValue = "", constant = false, next = operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if operand.constant {
        folded := if ch == "-" { integer.intNegate(operand.intValue) } else { (value = operand.intValue, ok = true) };
        if folded.ok and numeric.intKindFits(operand.kind, folded.value) {
            return ctx.typedIntParsed(operand.kind, code, folded.value, true, operand.next);
        }
    }
    runtimeCode := if ch == "-" {
        rawNeg := ir.targetIntNegateCode(target, operand.code, start);
        if numeric.isNarrowIntKind(operand.kind) { ir.targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start) } else { rawNeg }
    } else {
        code
    };
    ctx.withMarkers(ctx.typedIntParsed(operand.kind, runtimeCode, 0, false, operand.next),
    if inferMode { ctx.collectParsedMarkers("", operand) } else { "" })
};

/** Parses `[a, b, ...]` list or fixed-size array literals starting at `start`. */
parseListOrArrayExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var cursor := syntax.skipTrivia(source, start + 1, prefix);
    isTailList := textLib.startsWithAt(expected, 0, "TailList<");
    isListTarget := types.isListKind(expected) or isTailList;
    var elementKind := "";
    if types.isListKind(expected) { elementKind = types.listElementKind(expected); }
    else if isTailList { elementKind = types.listElementKind(textLib.slice(expected, 4, textLib.length(expected))); }
    else if types.isArrayKind(expected) { elementKind = types.arrayElementKind(expected); }
    elementCodes: mut List<String> = [];
    var listMarkers := "";
    var count := 0;
    loop true {
        if cursor >= textLib.length(source) {
            syntax.failAt(source, cursor, prefix, "expected ] in list literal");
        }
        if textLib.at(source, cursor) == "]" { break; }
        elementStart := cursor;
        element := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { listMarkers = ctx.collectParsedMarkers(listMarkers, element); }
        if element.kind == ir.VALUE_KIND_UNIT and elementKind =!= ir.VALUE_KIND_UNIT {
            syntax.failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " cannot be Unit");
        }
        if types.isListKind(element.kind) {
            syntax.failAt(source, elementStart, prefix, "nested list types are not supported");
        }
        if elementKind == "" {
            if element.kind =!= ir.VALUE_KIND_NEVER { elementKind = element.kind; }
        } else {
            compatible := if isListTarget { types.isCompatibleKind(elementKind, element.kind) }
            else { element.kind == ir.VALUE_KIND_NEVER or element.kind == elementKind or types.fnShapeMatches(elementKind, element.kind) };
            if not compatible {
                syntax.failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " must be " +
                types.displayKind(elementKind) + ", got " + types.displayKind(element.kind));
            }
        }
        listLib.pushBack(mut elementCodes, ctx.assignValueCode(target, elementKind, element.kind, element.code));
        count = count + 1;
        cursor = syntax.skipTrivia(source, element.next, prefix);
        if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, "]", prefix);
    if count > 0 and elementKind == "" {
        syntax.failAt(source, start, prefix, "list element 1 cannot be Never");
    }
    if count == 0 and not types.isListKind(expected) and not isTailList and not types.isArrayKind(expected) {
        syntax.failAt(source, start, prefix, "empty list literal requires a List element type");
    }
    resultKind := if types.isListKind(expected) or (count == 0 and isTailList) {
        "List<" + elementKind + ">"
    } else {
        "[" + elementKind + ";" + integer.intText(count) + "]"
    };
    ctx.withMarkers((kind = resultKind, code = "[" + textLib.joinTexts(elementCodes, ", ") + "]",
    intValue = 0, textValue = "", constant = false, next = cursor), listMarkers)
};

/** Parses `@tag.field`, `@tag { ... }`, and `@tag if/match/loop` prefixes. */
parseTagPrefixExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    tagInfo := syntax.parseTagAt(source, start, prefix);
    afterTag := syntax.skipTrivia(source, tagInfo.next, prefix);
    tagSourceSize := textLib.length(source);
    if afterTag < tagSourceSize and textLib.at(source, afterTag) == "." {
        fieldStart := syntax.skipTrivia(source, afterTag + 1, prefix);
        if fieldStart >= tagSourceSize or not textLib.isNameStart(textLib.at(source, fieldStart)) {
            syntax.failAt(source, fieldStart, prefix, "expected field name after @" + tagInfo.tag + ".");
        }
        fieldEnd := textLib.skipName(source, fieldStart);
        fieldName := textLib.slice(source, fieldStart, fieldEnd);
        ctxIdx := ctx.findTaggedCtxIndex(ctxs, tagInfo.tag);
        if ctxIdx < 0 {
            syntax.failAt(source, start, prefix, "unknown block tag @" + tagInfo.tag);
        }
        if ctx.hasFinallyAbove(ctxs, ctxIdx) {
            syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
        }
        c := ctxs[ctxIdx];
        if c.kind == ir.CTX_KIND_IF or c.kind == ir.CTX_KIND_MATCH {
            if fieldName =!= "value" {
                syntax.failAt(source, fieldStart, prefix, "conditional tag @" + tagInfo.tag + " only exposes .value, not ." + fieldName);
            }
            if c.phase =!= ir.CTX_PHASE_THEN {
                syntax.failAt(source, fieldStart, prefix, "@" + tagInfo.tag + ".value is only available inside that conditional's then block");
            }
            if c.itemKind == ir.VALUE_KIND_UNIT or c.itemKind == ir.VALUE_KIND_NEVER or c.itemKind == "" {
                syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose .value for " +
                types.displayKind(if c.itemKind == "" { ir.VALUE_KIND_UNIT } else { c.itemKind }) + " conditional");
            }
            return (kind = c.itemKind, code = c.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
        }
        if c.kind == ir.CTX_KIND_LOOP {
            if c.phase == ir.CTX_PHASE_FINALLY {
                syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
            }
            if target =!= ir.TARGET_TS {
                syntax.failAt(source, start, prefix, "C backend does not support loop metadata yet");
            }
            return ctx.resolveLoopField(target, c, fieldName, expected, source, fieldStart, fieldEnd, prefix);
        }
        syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose ." + fieldName);
    }
    if afterTag < tagSourceSize and textLib.at(source, afterTag) == "{" {
        if target =!= ir.TARGET_TS {
            syntax.failAt(source, start, prefix, "C backend does not support tagged blocks yet");
        }
        hintExpected := normalizeExpectedValueKind(expected);
        blockId := ctx.nextCtxId(ctxs);
        blockLabel := "lite$b" + integer.intText(blockId);
        blockValVar := "lite$val" + integer.intText(blockId);
        taggedLexDepthStr := integer.intText(ir.maxLocalLexDepth(locals) + 1);
        pass1ValKind := if hintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + hintExpected };
        pass1Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
        iifeDepth = iifeDepth + 1, valKind = pass1ValKind, valVar = blockValVar, label = blockLabel,
        iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
        pass1 := parseBinaryCtx(target, source, afterTag, prefix, locals, functions, params, currentName,
        hintExpected, 0, ctx.appendCtx(ctxs, pass1Ctx), iifeDepth + 1, true, "tagged", aliases);
        var result := pass1;
        if not inferMode {
            inferredKind := pass1.kind;
            pass2Expected := if inferredKind == ir.VALUE_KIND_UNIT or inferredKind == ir.VALUE_KIND_NEVER { "" } else { inferredKind };
            pass2Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
            iifeDepth = iifeDepth + 1, valKind = inferredKind, valVar = blockValVar, label = blockLabel,
            iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
            result = parseBinaryCtx(target, source, afterTag, prefix, locals, functions, params, currentName,
            pass2Expected, 0, ctx.appendCtx(ctxs, pass2Ctx), iifeDepth + 1, false, "tagged", aliases);
        }
        afterTaggedClose := syntax.skipTrivia(source, result.next, prefix);
        if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "then") {
            syntax.failAt(source, afterTaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "finally") {
            taggedFinCtx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_FINALLY,
            iifeDepth = iifeDepth + 1, valKind = result.kind, valVar = blockValVar, label = blockLabel,
            iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
            finParsed := parseFinallyClause(target, source, afterTaggedClose, prefix, locals, functions, params, currentName,
            ctx.appendCtx(ctxs, taggedFinCtx), iifeDepth + 1, inferMode, aliases);
            taggedTryBody := if result.kind == ir.VALUE_KIND_UNIT {
                "void (" + result.code + "); return undefined;"
            } else if result.kind == ir.VALUE_KIND_NEVER {
                "(" + result.code + ");"
            } else {
                "return " + result.code + ";"
            };
            result = finishFinallyIife(taggedTryBody, finParsed, result.kind, result, inferMode);
        }
        return result;
    }
    if afterTag < tagSourceSize and (textLib.wordAt(source, afterTag, "if") or textLib.wordAt(source, afterTag, "match")) {
        condKind := if textLib.wordAt(source, afterTag, "if") { ir.CTX_KIND_IF } else { ir.CTX_KIND_MATCH };
        return parseCondExpr(target, source, condKind, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if afterTag < tagSourceSize and textLib.wordAt(source, afterTag, "loop") {
        return parseLoopExpr(target, source, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    syntax.failAt(source, afterTag, prefix, "expected {, if, match, loop or . after block tag @" + tagInfo.tag);
    ctx.intParsed("", 0, true, start)
};

/** Parses a `fn(...) { ... }` anonymous/closure function literal expression starting after `fn`. */
parseFnLiteralExpr := fn(target: String, source: String, nameStart: Int, afterKw: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if target =!= ir.TARGET_TS {
        syntax.failAt(source, nameStart, prefix, "C backend does not support function values yet");
    }
    size := textLib.length(source);
    var cursor := syntax.expectSymbol(source, syntax.skipTrivia(source, afterKw, prefix), "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    hasExpectedFn := types.isFnKind(expected);
    expectedParamCount := if hasExpectedFn { types.fnParamCount(expected) } else { 0 };
    paramNames: mut List<String> = [];
    paramKinds: mut List<String> = [];
    var encodedKind := "fn(";
    var paramIdx := 0;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        pStart := cursor;
        if not textLib.isNameStart(textLib.at(source, pStart)) {
            syntax.failAt(source, pStart, prefix, "expected a parameter name");
        }
        pEnd := textLib.skipName(source, pStart);
        pName := textLib.slice(source, pStart, pEnd);
        if syntax.isReservedWord(pName) { syntax.unsupportedFeature(source, pStart, pName, prefix); }
        if listLib.listContainsText(paramNames, pName) {
            syntax.failAt(source, pStart, prefix, "duplicate parameter " + pName);
        }
        listLib.pushBack(mut paramNames, pName);
        cursor = syntax.skipTrivia(source, pEnd, prefix);
        var pKind := "";
        if cursor < size and textLib.at(source, cursor) == ":" {
            typedParam := types.parseFunctionType(source, cursor + 1, prefix, aliases, "");
            pKind = typedParam.kind;
            cursor = syntax.skipTrivia(source, typedParam.next, prefix);
        } else if hasExpectedFn and paramIdx < expectedParamCount {
            pKind = types.fnParamComponent(expected, paramIdx).kind;
        } else {
            syntax.failAt(source, pStart, prefix, "expected : Type for parameter " + pName);
        }
        if pKind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, pStart, prefix, "function parameter " + pName + " cannot have type Unit");
        }
        listLib.pushBack(mut paramKinds, pKind);
        if paramIdx > 0 { encodedKind = encodedKind + ","; }
        encodedKind = encodedKind + pName + ":" + pKind;
        paramIdx = paramIdx + 1;
        if cursor < size and textLib.at(source, cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    var retKind := "";
    if cursor < size and textLib.at(source, cursor) == ":" {
        typedRet := types.parseFunctionType(source, cursor + 1, prefix, aliases, "");
        retKind = typedRet.kind;
        cursor = syntax.skipTrivia(source, typedRet.next, prefix);
    } else if hasExpectedFn {
        retKind = types.fnResultKind(expected);
    } else {
        syntax.failAt(source, cursor, prefix, "expected : ReturnType in function expression");
    }
    if cursor >= size or textLib.at(source, cursor) =!= "{" {
        syntax.failAt(source, cursor, prefix, "expected { for function body");
    }
    fnKind := encodedKind + "):" + retKind;
    fnLexDepth := ir.maxLocalLexDepth(locals) + 1;
    fnLocals: mut List<Local> = [];
    selfRuntime := ir.freshScopeTemp(locals, "lite$self");
    listLib.pushBack(mut fnLocals, (name = "$self", runtime = selfRuntime, kind = fnKind,
    mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
    intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
    loop locals as outerEntry {
        if outerEntry.name =!= "$self" and outerEntry.depth >= -1 {
            capturedInit := if outerEntry.initState == ir.INIT_STATE_UNINIT_ASSIGNED { ir.INIT_STATE_INIT }
            else if outerEntry.initState == ir.INIT_STATE_UNINIT and not outerEntry.mutable { ir.INIT_STATE_MAYBE }
            else { outerEntry.initState };
            capturedConst := if outerEntry.mutable or outerEntry.writable { false } else { outerEntry.constant };
            listLib.pushBack(mut fnLocals, (name = outerEntry.name, runtime = outerEntry.runtime, kind = outerEntry.kind,
            mutable = outerEntry.mutable, writable = outerEntry.writable, depth = outerEntry.depth, constant = capturedConst,
            code = outerEntry.code, intValue = outerEntry.intValue, textValue = outerEntry.textValue, initState = capturedInit));
        }
    }
    loop locals as outerEntry {
        if outerEntry.depth <= -2 {
            futLexDepth := 0 - 2 - outerEntry.depth;
            if trace.latestActiveLocalByRuntime(locals, outerEntry.runtime) < 0 and
            not ir.localsHasDeeperReachedName(locals, outerEntry.name, futLexDepth) {
                listLib.pushBack(mut fnLocals, (name = outerEntry.name, runtime = outerEntry.runtime, kind = outerEntry.kind,
                mutable = outerEntry.mutable, writable = outerEntry.writable, depth = -1, constant = false,
                code = outerEntry.code, intValue = 0, textValue = "", initState = outerEntry.initState));
            }
        }
    }
    var tsParamsCode := "";
    var paramVoidStmts := "";
    var pBindIdx := 0;
    loop pBindIdx < paramIdx {
        pName := paramNames[pBindIdx];
        pKind := paramKinds[pBindIdx];
        pRuntime := ir.localRuntimeName(target, fnLocals, pName, "", fnLexDepth);
        listLib.pushBack(mut fnLocals, (name = pName, runtime = pRuntime, kind = pKind,
        mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
        if pBindIdx > 0 { tsParamsCode = tsParamsCode + ", "; }
        tsParamsCode = tsParamsCode + pRuntime + ": " + types.tsFunctionType(pKind);
        paramVoidStmts = paramVoidStmts + "void " + pRuntime + "; ";
        pBindIdx = pBindIdx + 1;
    }
    fnCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FN, phase = ir.CTX_PHASE_BODY, iifeDepth = iifeDepth + 1,
    valKind = retKind, valVar = "", label = "", iterLabel = integer.intText(fnLexDepth), countVar = "", itemVar = "",
    itemKind = "", indexVar = "", hasIndex = false);
    emptyFnCtxs: List<ConstructCtx> = [];
    fnCtxs := ctx.appendCtx(emptyFnCtxs, fnCtx);
    var fnBodySink := "fnBody";
    if paramIdx > 0 {
        fnBodySink = "fnBody:" + textLib.joinTexts(paramNames, ",");
    }
    fnBody := parseBinaryCtx(target, source, cursor, prefix, fnLocals, functions, params, "<fn>",
    retKind, 0, fnCtxs, iifeDepth + 1, inferMode, fnBodySink, aliases);
    usesSelf := reach.codeUsesTextCall(fnBody.code, selfRuntime);
    fnPrefix := if usesSelf { "(function " + selfRuntime } else { "(function " };
    fnFullCode := fnPrefix + "(" + tsParamsCode + "): " + types.tsFunctionType(retKind) + " { " + paramVoidStmts + fnBody.code + " })";
    ctx.withMarkers((kind = fnKind, code = fnFullCode, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next),
    if inferMode { ctx.collectParsedMarkers("", fnBody) } else { "" })
};

/** Ensures `$recpop:<recordKind>` and `$recdef:...` entries exist in `aliases`, lazily resolving forward-declared local records when needed. */
ensureRecordDefaults := fn(target: String, source: String, recordKind: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): List<AliasDecl> {
    if types.findAlias(aliases, "$recpop:" + recordKind) >= 0 { return aliases; }
    declAt := types.recordDeclAt(recordKind);
    if declAt < 0 { return aliases; }
    aliasIdx := types.aliasIndexAt(aliases, declAt);
    if aliasIdx < 0 { return aliases; }
    aliasEntry := aliases[aliasIdx];
    if aliasEntry.at < 0 or not textLib.startsWithAt(aliasEntry.target, 0, "@recraw:") { return aliases; }
    afterName := textLib.skipName(source, aliasEntry.at);
    opPos := syntax.skipTrivia(source, afterName, prefix);
    if not textLib.startsWithAt(source, opPos, ":=") { return aliases; }
    recPos := syntax.skipTrivia(source, opPos + 2, prefix);
    if not textLib.wordAt(source, recPos, "record") { return aliases; }
    seeded := types.appendEncodedRecordDefaults(aliases, recordKind, "", aliasEntry.depth);
    parsedRec := parseRecordDecl(target, source, recPos, aliasEntry.at, aliasEntry.name, aliasEntry.depth, prefix, locals, functions, params, currentName, ctxs, iifeDepth, false, seeded);
    types.appendEncodedRecordDefaults(aliases, parsedRec.kind, parsedRec.encodedDefaults, aliasEntry.depth)
};

/** Parses `{ field = expr, ... }` or `{}` for an explicit or contextual nominal `recordKind`, resolving omitted fields from defaults then zero. */
parseRecordLiteral := fn(target: String, source: String, braceStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, recordKind: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := textLib.length(source);
    recAliases := ensureRecordDefaults(target, source, recordKind, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    recName := types.recordDisplayName(recordKind);
    suppliedKeys: mut List<String> = [];
    suppliedCodes: mut List<String> = [];
    var recMarkers := "";
    var cursor := syntax.skipTrivia(source, braceStart + 1, prefix);
    loop true {
        if cursor >= size {
            syntax.failAt(source, braceStart, prefix, "expected } in record construction");
        }
        if textLib.at(source, cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        var labelStart := cursor;
        var label := "";
        var valStart := cursor;
        var valMin := 0;
        if syntax.isSingleEquals(source, cursor) {
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not textLib.isNameStart(textLib.at(source, shStart)) {
                syntax.failAt(source, shStart, prefix, "expected field name after = in record construction");
            }
            shEnd := textLib.skipName(source, shStart);
            labelStart = shStart;
            label = textLib.slice(source, shStart, shEnd);
            valStart = shStart;
            valMin = 30;
        } else {
            if not textLib.isNameStart(textLib.at(source, cursor)) {
                syntax.failAt(source, cursor, prefix, "expected field name in record construction");
            }
            labelEnd := textLib.skipName(source, labelStart);
            label = textLib.slice(source, labelStart, labelEnd);
            afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
            if not syntax.isSingleEquals(source, afterLabel) {
                syntax.failAt(source, afterLabel, prefix, "expected = after record field " + label);
            }
            valStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
        }
        if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, labelStart, label, prefix); }
        fieldKind := types.recordFieldKind(recordKind, label);
        if fieldKind == "" {
            syntax.failAt(source, labelStart, prefix, "record " + recName + " has no field " + label);
        }
        if listLib.listContainsText(suppliedKeys, label) {
            syntax.failAt(source, labelStart, prefix, "duplicate record field " + label);
        }
        zeroEnd := syntax.isZeroInitLiteral(source, valStart, prefix);
        var valNext := valStart;
        var valCode := "";
        var checkZero := false;
        if valMin == 0 and zeroEnd >= 0 and not numeric.isNumericKind(fieldKind) {
            afterZero := syntax.skipTrivia(source, zeroEnd, prefix);
            if afterZero < size and (textLib.at(source, afterZero) == "," or textLib.at(source, afterZero) == "}") {
                checkZero = true;
            }
        }
        if checkZero {
            z := ctx.zeroParsed(target, fieldKind, zeroEnd);
            valCode = z.code;
            valNext = z.next;
        } else {
            valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, fieldKind, valMin, ctxs, iifeDepth, inferMode, "", recAliases);
            if inferMode { recMarkers = ctx.collectParsedMarkers(recMarkers, valParsed); }
            if not types.isCompatibleKind(fieldKind, valParsed.kind) {
                syntax.failAt(source, valStart, prefix, "cannot initialize " + types.displayKind(fieldKind) + " field " + label + " with " + types.displayKind(valParsed.kind));
            }
            valCode = ctx.assignValueCode(target, fieldKind, valParsed.kind, valParsed.code);
            valNext = valParsed.next;
        }
        listLib.pushBack(mut suppliedKeys, label);
        listLib.pushBack(mut suppliedCodes, valCode);
        afterVal := syntax.skipTrivia(source, valNext, prefix);
        if afterVal < size and textLib.at(source, afterVal) == "," {
            cursor = syntax.skipTrivia(source, afterVal + 1, prefix);
        } else if afterVal < size and textLib.at(source, afterVal) == "}" {
            cursor = afterVal + 1;
            break;
        } else {
            syntax.failAt(source, afterVal, prefix, "expected , or } after record field " + label);
        }
    }
    compCount := types.recordComponentCount(recordKind);
    if compCount == 0 {
        return ctx.withMarkers((kind = recordKind, code = "{}", intValue = 0, textValue = "", constant = false, next = cursor), recMarkers);
    }
    encodedSupplied := types.encodeRecordPairs(suppliedKeys, suppliedCodes);
    fieldExprs: mut List<String> = [];
    var compIdx := 0;
    loop compIdx < compCount {
        comp := types.recordComponent(recordKind, compIdx);
        var chosen := "";
        var supIdx := 0;
        var supFound := false;
        loop suppliedKeys as sKey {
            if sKey == comp.label {
                chosen = suppliedCodes[supIdx];
                supFound = true;
                break;
            }
            supIdx = supIdx + 1;
        }
        if not supFound {
            defCode := types.findRecordDefaultCode(recAliases, recordKind, comp.label);
            if defCode =!= "" {
                chosen = defCode;
            } else {
                chosen = ctx.zeroParsed(target, comp.kind, cursor).code;
            }
        }
        listLib.pushBack(mut fieldExprs, types.tupleObjectKey(comp.label, compIdx) + ": " + chosen);
        compIdx = compIdx + 1;
    }
    _unused := encodedSupplied;
    ctx.withMarkers((kind = recordKind, code = "{ " + textLib.joinTexts(fieldExprs, ", ") + " }", intValue = 0, textValue = "", constant = false, next = cursor), recMarkers)
};

/** Detects a leading `(...) :=`, `{...} :=`, `[...] :=` (or `var ...`) destructuring pattern, rejecting construction-shaped `Name {...} :=` headers. */
pub scanDestructureStart := fn(source: String, cursor: Int, limit: Int, prefix: String): (openPos: Int, isMutable: Bool) {
    if cursor >= limit { return (openPos = -1, isMutable = false); }
    ch := textLib.at(source, cursor);
    if ch == "(" or ch == "{" or ch == "[" {
        endPos := if ch == "(" { syntax.scanParenEnd(source, cursor, prefix) } else if ch == "{" { syntax.scanBraceEnd(source, cursor, prefix) } else { syntax.scanBracketEnd(source, cursor, prefix) };
        afterEnd := if endPos >= 0 { syntax.skipTrivia(source, endPos, prefix) } else { -1 };
        if afterEnd >= 0 and afterEnd < limit and textLib.startsWithAt(source, afterEnd, ":=") {
            return (openPos = cursor, isMutable = false);
        }
        return (openPos = -1, isMutable = false);
    }
    if ch == "v" and textLib.wordAt(source, cursor, "var") {
        afterVar := syntax.skipTrivia(source, cursor + 3, prefix);
        if afterVar < limit {
            vCh := textLib.at(source, afterVar);
            if vCh == "(" or vCh == "{" or vCh == "[" {
                return (openPos = afterVar, isMutable = true);
            }
            if textLib.isNameStart(vCh) {
                varPatEnd := syntax.skipTrivia(source, textLib.skipName(source, afterVar), prefix);
                if varPatEnd < limit and textLib.at(source, varPatEnd) == "{" {
                    patBraceEnd := syntax.scanBraceEnd(source, varPatEnd, prefix);
                    afterPatBrace := if patBraceEnd >= 0 { syntax.skipTrivia(source, patBraceEnd, prefix) } else { -1 };
                    if afterPatBrace >= 0 and textLib.startsWithAt(source, afterPatBrace, ":=") {
                        syntax.failAt(source, afterVar, prefix, "construction-shaped record pattern is not allowed; omit the type name");
                    }
                }
            }
        }
    }
    (openPos = -1, isMutable = false)
};

/** Parses `{ ... }`, `( ... )`, or `[ ... ]` destructuring clauses uniformly, including `= name` shorthand, `bind = field`, `: Type`, and `_`. */
pub parseAggregatePattern := fn(source: String, openPos: Int, prefix: String, aliases: List<AliasDecl>): (shape: String, count: Int, grouped: Bool, groupedType: String, encodedClauses: String, next: Int) {
    size := textLib.length(source);
    openDelim := textLib.at(source, openPos);
    shape := if openDelim == "{" { "record" } else if openDelim == "(" { "tuple" } else { "array" };
    closeDelim := if openDelim == "{" { "}" } else if openDelim == "(" { ")" } else { "]" };
    var cursor := syntax.skipTrivia(source, openPos + 1, prefix);
    seenRecBinds: mut List<String> = [];
    var encoded := "";
    var count := 0;
    var hadComma := false;
    var lastMode := "pos";
    var lastExpected := "";
    loop cursor < size and textLib.at(source, cursor) =!= closeDelim {
        var bindName := "";
        var sourceField := "";
        var expectedKind := "";
        var clauseMode := "pos";
        var clauseEnd := cursor;
        if syntax.isSingleEquals(source, cursor) {
            if shape == "array" {
                syntax.failAt(source, cursor, prefix, "array destructuring does not support = selector");
            }
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not textLib.isNameStart(textLib.at(source, shStart)) {
                syntax.failAt(source, shStart, prefix, "expected field name after = in " + shape + " destructuring");
            }
            shEnd := textLib.skipName(source, shStart);
            shName := textLib.slice(source, shStart, shEnd);
            if syntax.isReservedWord(shName) { syntax.unsupportedFeature(source, shStart, shName, prefix); }
            if shName == "_" {
                syntax.failAt(source, shStart, prefix, "use _ = sourceField to discard a field");
            }
            if shape == "record" and listLib.listContainsText(seenRecBinds, shName) {
                syntax.failAt(source, shStart, prefix, "duplicate record pattern binding " + shName);
            }
            bindName = shName;
            sourceField = shName;
            clauseMode = "named";
            afterSh := syntax.skipTrivia(source, shEnd, prefix);
            clauseEnd = afterSh;
            if afterSh < size and textLib.at(source, afterSh) == ":" {
                typed := types.parseLocalType(source, afterSh + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterSh, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                clauseEnd = syntax.skipTrivia(source, typed.next, prefix);
            }
        } else {
            if not textLib.isNameStart(textLib.at(source, cursor)) {
                syntax.failAt(source, cursor, prefix, if shape == "record" { "expected binding name in record pattern" } else { "expected a binding name in " + shape + " destructuring" });
            }
            bindStart := cursor;
            bindEnd := textLib.skipName(source, bindStart);
            bindName = textLib.slice(source, bindStart, bindEnd);
            if syntax.isReservedWord(bindName) { syntax.unsupportedFeature(source, bindStart, bindName, prefix); }
            if shape == "record" and bindName =!= "_" and listLib.listContainsText(seenRecBinds, bindName) {
                syntax.failAt(source, bindStart, prefix, "duplicate record pattern binding " + bindName);
            }
            afterBind := syntax.skipTrivia(source, bindEnd, prefix);
            var checkEqPos := afterBind;
            if afterBind < size and textLib.at(source, afterBind) == ":" {
                typed := types.parseLocalType(source, afterBind + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterBind, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                checkEqPos = syntax.skipTrivia(source, typed.next, prefix);
            }
            clauseEnd = checkEqPos;
            if syntax.isSingleEquals(source, checkEqPos) {
                if shape == "array" {
                    syntax.failAt(source, checkEqPos, prefix, "array destructuring patterns do not use =");
                }
                fieldStart := syntax.skipTrivia(source, checkEqPos + 1, prefix);
                if fieldStart >= size or not textLib.isNameStart(textLib.at(source, fieldStart)) {
                    syntax.failAt(source, fieldStart, prefix, "expected source field name after =");
                }
                fieldEnd := textLib.skipName(source, fieldStart);
                sourceField = textLib.slice(source, fieldStart, fieldEnd);
                if syntax.isReservedWord(sourceField) { syntax.unsupportedFeature(source, fieldStart, sourceField, prefix); }
                clauseMode = "named";
                clauseEnd = syntax.skipTrivia(source, fieldEnd, prefix);
            } else if shape == "record" {
                if expectedKind =!= "" {
                    if bindName == "_" { syntax.failAt(source, bindStart, prefix, "expected = sourceField after _"); }
                    sourceField = bindName;
                    clauseMode = "named";
                } else {
                    syntax.failAt(source, checkEqPos, prefix, "expected = sourceField or : Type in record pattern clause " + bindName);
                }
            }
        }
        if shape == "record" and bindName =!= "_" { listLib.pushBack(mut seenRecBinds, bindName); }
        encoded = encoded + types.encodeLengthPrefixedText(bindName) + types.encodeLengthPrefixedText(sourceField) +
        types.encodeLengthPrefixedText(expectedKind) + types.encodeLengthPrefixedText(clauseMode);
        lastMode = clauseMode;
        lastExpected = expectedKind;
        count = count + 1;
        cursor = clauseEnd;
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    next := syntax.expectSymbol(source, cursor, closeDelim, prefix);
    if count == 0 and shape == "record" {
        syntax.failAt(source, openPos, prefix, "record destructuring needs at least one field clause");
    }
    if count == 0 and shape == "array" {
        syntax.failAt(source, openPos, prefix, "array destructuring needs at least one binding");
    }
    grouped := shape == "tuple" and count == 1 and not hadComma and lastMode == "pos";
    (shape = shape, count = count, grouped = grouped, groupedType = if grouped { lastExpected } else { "" }, encodedClauses = encoded, next = next)
};

/** Validates `rhsKind` against a parsed aggregate destructuring pattern and resolves each clause to `(bindName, propExpr, srcKind, targetKind)`. */
pub resolveAggregateBindings := fn(shape: String, count: Int, encodedClauses: String, rhsKind: String, tempRuntime: String, source: String, openPos: Int, prefix: String): String {
    if shape == "record" and not types.isRecordKind(rhsKind) {
        syntax.failAt(source, openPos, prefix, "record destructuring requires a record value, got " + types.displayKind(rhsKind));
    }
    if shape == "tuple" {
        if not types.isTupleKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "tuple destructuring requires a tuple value, got " + types.displayKind(rhsKind));
        }
        if types.tupleComponentCount(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "tuple destructuring expected " + integer.intText(count) +
            " fields, got " + integer.intText(types.tupleComponentCount(rhsKind)));
        }
    }
    if shape == "array" {
        if types.isListKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "cannot destructure runtime-sized List<" + types.displayKind(types.listElementKind(rhsKind)) + ">; fixed array required");
        }
        if not types.isArrayKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "array destructuring requires an array value, got " + types.displayKind(rhsKind));
        }
        if types.arrayExtent(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "array destructuring expected " + integer.intText(count) +
            " elements, got " + integer.intText(types.arrayExtent(rhsKind)));
        }
    }
    var claimedBag := "";
    var out := "";
    var clCursor := 0;
    var clIndex := 0;
    loop clIndex < count {
        bindPart := types.decodeLengthPrefixedAt(encodedClauses, clCursor);
        fieldPart := types.decodeLengthPrefixedAt(encodedClauses, bindPart.next);
        typePart := types.decodeLengthPrefixedAt(encodedClauses, fieldPart.next);
        modePart := types.decodeLengthPrefixedAt(encodedClauses, typePart.next);
        clCursor = modePart.next;
        bindName := bindPart.text;
        sourceField := fieldPart.text;
        expectedKind := typePart.text;
        clauseMode := modePart.text;
        var srcKind := "";
        var propExpr := "";
        if shape == "record" {
            srcKind = types.recordFieldKind(rhsKind, sourceField);
            if srcKind == "" {
                syntax.failAt(source, openPos, prefix, "record " + types.recordDisplayName(rhsKind) + " has no field " + sourceField);
            }
            propExpr = tempRuntime + "." + types.recordComponentProp(rhsKind, sourceField);
        } else if shape == "tuple" {
            var compIdx := -1;
            if clauseMode == "named" {
                compIdx = types.tupleComponentIndexByLabel(rhsKind, sourceField);
                if compIdx < 0 {
                    syntax.failAt(source, openPos, prefix, "tuple has no field " + sourceField);
                }
                idxTok := integer.intText(compIdx);
                if trace.tokenInPipeBag(claimedBag, idxTok) {
                    syntax.failAt(source, openPos, prefix, "duplicate selection of tuple field " + sourceField);
                }
                claimedBag = trace.appendPipeBag(claimedBag, idxTok);
            } else {
                var probe := 0;
                loop probe < count {
                    idxTok := integer.intText(probe);
                    if not trace.tokenInPipeBag(claimedBag, idxTok) {
                        compIdx = probe;
                        claimedBag = trace.appendPipeBag(claimedBag, idxTok);
                        break;
                    }
                    probe = probe + 1;
                }
            }
            comp := types.tupleComponent(rhsKind, compIdx);
            srcKind = comp.kind;
            propExpr = tempRuntime + "." + comp.prop;
        } else {
            srcKind = types.arrayElementKind(rhsKind);
            propExpr = tempRuntime + "[" + integer.intText(clIndex) + "]!";
        }
        var targetKind := srcKind;
        if expectedKind =!= "" {
            if not types.isCompatibleKind(expectedKind, srcKind) {
                syntax.failAt(source, openPos, prefix, "cannot bind " + types.displayKind(srcKind) + " to " + types.displayKind(expectedKind));
            }
            targetKind = expectedKind;
        }
        out = out + types.encodeLengthPrefixedText(bindName) + types.encodeLengthPrefixedText(propExpr) +
        types.encodeLengthPrefixedText(srcKind) + types.encodeLengthPrefixedText(targetKind);
        clIndex = clIndex + 1;
    }
    out
};

/** Parses name-headed primaries: `Unit`, `true`/`false`, `not`, `if`/`match`/`loop`, `fn`, `self`, locals, module functions, and list intrinsics. */
parseNamedPrimaryExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    nameStart := start;
    next := textLib.skipName(source, start);
    name := textLib.slice(source, nameStart, next);
    if name == "Unit" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next);
    }
    if name == "true" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, true), true, true, next);
    }
    if name == "false" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, false), false, true, next);
    }
    if name == "not" {
        operand := parseBinaryCtx(target, source, next, prefix, locals, functions, params, currentName, "", 5, ctxs, iifeDepth, inferMode, "", aliases);
        operandLoopId := types.loopValMarkerId(operand.kind);
        if inferMode and operandLoopId >= 0 {
            return ctx.withMarkers(ctx.boolParsed("", false, false, operand.next),
            ctx.collectParsedMarkers("", operand) + integer.intText(operandLoopId) + "=Bool\n");
        }
        if operand.kind =!= ir.VALUE_KIND_BOOL {
            syntax.failAt(source, nameStart, prefix, "not requires a Bool operand");
        }
        if operand.constant {
            value := operand.intValue == 0;
            return ctx.boolParsed(ir.targetBoolLiteralCode(target, value), value, true, operand.next);
        }
        return ctx.withMarkers(ctx.boolParsed(ir.targetNotCode(target, operand.code), false, false, operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if name == "if" or name == "match" {
        return parseCondExpr(target, source, name, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "loop" {
        return parseLoopExpr(target, source, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "fn" {
        return parseFnLiteralExpr(target, source, nameStart, next, prefix, locals, functions, params, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if syntax.isReservedWord(name) { syntax.unsupportedFeature(source, nameStart, name, prefix); }
    afterName := syntax.skipTrivia(source, next, prefix);
    isCallSite := afterName < textLib.length(source) and textLib.at(source, afterName) == "(";
    if name == "self" {
        selfLocalIdx := ir.localIndex(locals, "$self");
        if selfLocalIdx >= 0 {
            selfEntry := locals[selfLocalIdx];
            return (kind = selfEntry.kind, code = selfEntry.runtime, intValue = 0, textValue = "", constant = false, next = next);
        }
        if currentName == "" { syntax.failAt(source, nameStart, prefix, "self is only available inside a function"); }
        selfIndex := ir.findFunction(functions, currentName);
        if selfIndex >= 0 {
            return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = integer.intText(nameStart), intValue = selfIndex, textValue = currentName, constant = false, next = next);
        }
        syntax.failAt(source, nameStart, prefix, "unknown value " + name);
        return ctx.intParsed("", 0, true, start);
    }
    index := ir.localIndex(locals, name);
    hasLocalShadow := index >= 0 and locals[index].depth >= -1;
    if hasLocalShadow {
        entry := locals[index];
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        return (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, constant = entry.constant, next = next);
    }
    callableIndex := ir.findFunction(functions, name);
    if callableIndex >= 0 {
        if currentName == "" and functions[callableIndex].declAt > nameStart {
            syntax.failAt(source, nameStart, prefix, "cannot access " + name + " before initialization");
        }
        return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = integer.intText(nameStart), intValue = callableIndex, textValue = name, constant = false, next = next);
    }
    if isCallSite and (name == "push_back" or name == "pop_back" or name == "push_front" or name == "pop_front") {
        return (kind = ir.VALUE_KIND_LIST_OP, code = name, intValue = 0, textValue = name, constant = false, next = afterName);
    }
    if index >= 0 {
        entry := locals[index];
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        return (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, constant = entry.constant, next = next);
    }
    if afterName < textLib.length(source) and textLib.at(source, afterName) == "{" and types.findAlias(aliases, name) >= 0 {
        var resolvedRec := "";
        if inferMode {
            emptySeen: List<String> = [];
            canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
            if not canRes.ok or not types.isRecordKind(canRes.kind) {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
            }
            resolvedRec = canRes.kind;
        } else {
            emptySeen: List<String> = [];
            resolvedRec = types.resolveAliasKind(source, nameStart, prefix, aliases, name, emptySeen);
            if not types.isRecordKind(resolvedRec) {
                syntax.failAt(source, nameStart, prefix, "record construction requires a record type, got " + types.displayKind(resolvedRec));
            }
        }
        return parseRecordLiteral(target, source, afterName, prefix, locals, functions, params, currentName, resolvedRec, ctxs, iifeDepth, inferMode, aliases);
    }
    syntax.failAt(source, nameStart, prefix, "unknown value " + name);
    ctx.intParsed("", 0, true, start)
};

/** Resolves leading-dot loop metadata expressions (`.count`, `.value`, `.item`, `.index`). */
resolveLeadingDotExpr := fn(target: String, source: String, start: Int, prefix: String, expected: String, ctxs: List<ConstructCtx>): Parsed {
    fieldStart := syntax.skipTrivia(source, start + 1, prefix);
    size := textLib.length(source);
    if fieldStart >= size or not textLib.isNameStart(textLib.at(source, fieldStart)) {
        syntax.failAt(source, fieldStart, prefix, "expected metadata field name after .");
    }
    fieldEnd := textLib.skipName(source, fieldStart);
    fieldName := textLib.slice(source, fieldStart, fieldEnd);
    loopIdx := ctx.findLeadingDotLoopIdx(ctxs);
    if loopIdx == ir.DOT_LOOP_IN_CONDITIONAL {
        syntax.failAt(source, start, prefix, "leading-dot ." + fieldName + " is not available inside a conditional; use an explicit loop @tag");
    } else if loopIdx == ir.DOT_LOOP_IN_FINALLY {
        syntax.failAt(source, start, prefix, "loop metadata is not available in finally");
    } else if loopIdx < 0 {
        syntax.failAt(source, start, prefix, "." + fieldName + " outside loop");
    }
    if target =!= ir.TARGET_TS {
        syntax.failAt(source, start, prefix, "C backend does not support loop metadata yet");
    }
    ctx.resolveLoopField(target, ctxs[loopIdx], fieldName, expected, source, fieldStart, fieldEnd, prefix)
};

/** Parses `{ ... }` block expressions, statement blocks, function bodies, loop bodies, finally blocks, and conditional branches. */
parseBlockExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    isTaggedBody := bodySink == "tagged";
    isLoopBody := bodySink == "loopBody" or textLib.startsWithAt(bodySink, 0, "loopBody:");
    isStmtBody := bodySink == "stmt" or textLib.startsWithAt(bodySink, 0, "stmt:");
    isFinallyBody := bodySink == "finally";
    isBranchBody := bodySink == "branch";
    isFnBody := bodySink == "fnBody" or textLib.startsWithAt(bodySink, 0, "fnBody:");
    isStandaloneBlock := not isTaggedBody and not isLoopBody and not isStmtBody and not isFinallyBody and not isBranchBody and not isFnBody;
    allowOutput := isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isBranchBody or isFnBody or (bodySink == "exprOut");
    bodyDepth := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { iifeDepth } else { iifeDepth + 1 };
    stmtReturnPrefix := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { "" } else { "return " };
    var blockLocals: mut List<Local> = [];
    loop locals as entry { listLib.pushBack(mut blockLocals, entry); }
    outerLocalsLen := ctx.localsCount(blockLocals);
    blockLexDepth := ir.maxLocalLexDepth(blockLocals) + 1;
    emptyFuturesHere: List<FutureValue> = [];
    emptyItemsHere: List<Item> = [];
    nextAliasDepth := types.maxAliasDepth(aliases) + 1;
    var blockAliases := types.collectBlockTypeAliases(source, start, prefix, nextAliasDepth, aliases);
    declaredInBlock: mut List<String> = [];
    var seedBag := "";
    loop ctx.seedBlockDeclaredNames(bodySink) as seededName {
        listLib.pushBack(mut declaredInBlock, seededName);
        seedBag = trace.appendPipeBag(seedBag, seededName);
    }
    blockAssignedBag := if target == ir.TARGET_TS {
        infer.scanInnerBlockAssignedBag(target, source, start, prefix, seedBag)
    } else {
        ""
    };
    if target == ir.TARGET_TS {
        preScannedLocals := infer.appendBlockFutureLocals(target, source, start, prefix, blockLexDepth, seedBag, blockAssignedBag, blockAliases, functions, params, blockLocals);
        blockLocals = [];
        loop preScannedLocals as entry { listLib.pushBack(mut blockLocals, entry); }
    }
    statements: mut List<String> = [];
    stmtOwners: mut List<String> = [];
    stmtDeps: mut List<String> = [];
    var trackedStmtCount := 0;
    var statementCount := 0;
    var blockMarkers := "";
    var cursor := syntax.skipItemSeparators(source, start + 1, prefix);
    var blockKind := ir.VALUE_KIND_UNIT;
    var blockCode := ir.targetUnitLiteralCode(target);
    var blockInt := 0;
    var blockText := "";
    var blockConstant := true;
    var blockExits := false;
    var sawTailExpr := false;
    var lastPartialIfDiverges := false;
    blockSourceSize := textLib.length(source);
    loop true {
        var syncLen := 0;
        loop statements { syncLen = syncLen + 1; }
        loop trackedStmtCount < syncLen {
            listLib.pushBack(mut stmtOwners, "");
            listLib.pushBack(mut stmtDeps, statements[trackedStmtCount]);
            trackedStmtCount = trackedStmtCount + 1;
        }
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= blockSourceSize {
            syntax.failAt(source, start, prefix, "expected }");
        }
        if textLib.at(source, cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        lastPartialIfDiverges = false;
        var isStatement := false;
        chAtCursor := textLib.at(source, cursor);
        scanDestr := scanDestructureStart(source, cursor, blockSourceSize, prefix);
        destructureOpen := scanDestr.openPos;
        destructureMutable := scanDestr.isMutable;
        if destructureOpen >= 0 {
            isStatement = true;
            destructure := parseAggregatePattern(source, destructureOpen, prefix, blockAliases);
            afterTarget := syntax.skipTrivia(source, destructure.next, prefix);
            if not textLib.startsWithAt(source, afterTarget, ":=") {
                syntax.failAt(source, afterTarget, prefix, "expected := after " + destructure.shape + " destructuring target");
            }
            rhs := parseBinaryCtx(target, source, syntax.skipTrivia(source, afterTarget + 2, prefix), prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
            if target == ir.TARGET_TS and not inferMode and not blockExits {
                trace.checkTraceSafety(source, destructureOpen, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
            }
            if destructure.shape == "tuple" and destructure.count == 0 {
                if destructureMutable {
                    syntax.failAt(source, destructureOpen, prefix, "var tuple destructuring needs at least one binding");
                }
                if types.isTupleKind(rhs.kind) {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring expected 0 fields, got " + integer.intText(types.tupleComponentCount(rhs.kind)));
                }
                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + types.displayKind(rhs.kind));
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if not blockExits {
                    if rhs.kind == ir.VALUE_KIND_NEVER {
                        listLib.pushBack(mut statements, stmtReturnPrefix + "(" + rhs.code + ");");
                        blockExits = true;
                    } else {
                        listLib.pushBack(mut statements, "void (" + rhs.code + ");");
                        if reach.isPrunableExprForTarget(target, ir.VALUE_KIND_UNIT, rhs.code) {
                            listLib.pushBack(mut stmtOwners, "#discard");
                            listLib.pushBack(mut stmtDeps, "");
                        } else {
                            listLib.pushBack(mut stmtOwners, "");
                            listLib.pushBack(mut stmtDeps, rhs.code);
                        }
                        trackedStmtCount = trackedStmtCount + 1;
                    }
                    statementCount = statementCount + 1;
                }
                if target == ir.TARGET_TS and not inferMode {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                blockConstant = false;
                cursor = statementNext;
            } else if destructure.grouped {
                bindPart := types.decodeLengthPrefixedAt(destructure.encodedClauses, 0);
                bindName := bindPart.text;
                ctx.rejectNonValueBinding(source, destructureOpen, prefix, rhs.kind, bindName);
                ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                var groupedBindKind := rhs.kind;
                if destructure.groupedType =!= "" {
                    if not types.isCompatibleKind(destructure.groupedType, rhs.kind) {
                        syntax.failAt(source, destructureOpen, prefix, "cannot bind " + types.displayKind(rhs.kind) + " to " + types.displayKind(destructure.groupedType));
                    }
                    groupedBindKind = destructure.groupedType;
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                bindFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(groupedBindKind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                listLib.pushBack(mut declaredInBlock, bindName);
                listLib.pushBack(mut blockLocals, (name = bindName, runtime = bindRuntime, kind = groupedBindKind,
                mutable = destructureMutable, writable = false, depth = blockLexDepth, constant = false, code = bindFnDeps,
                intValue = rhs.intValue, textValue = rhs.textValue, initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    declKw := if destructureMutable { "let " } else { "const " };
                    tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(groupedBindKind) { ": " + types.tsFunctionType(groupedBindKind) } else { "" };
                    groupedCode := ctx.assignValueCode(target, groupedBindKind, rhs.kind, rhs.code);
                    listLib.pushBack(mut statements, declKw + bindRuntime + tsTypeAnn + " = " + groupedCode + "; void " + bindRuntime + ";");
                    listLib.pushBack(mut stmtOwners, if reach.isPrunableExprForTarget(target, groupedBindKind, groupedCode) { bindRuntime } else { "" });
                    listLib.pushBack(mut stmtDeps, groupedCode);
                    trackedStmtCount = trackedStmtCount + 1;
                    statementCount = statementCount + 1;
                }
                blockConstant = false;
                cursor = statementNext;
            } else {
                tempPrefix := if destructure.shape == "record" { "lite$rec" } else if destructure.shape == "array" { "lite$arr" } else { "lite$tuple" };
                tempSlot := if destructure.shape == "record" { "$rec" } else if destructure.shape == "array" { "$arr" } else { "$tuple" };
                tempRuntime := ir.freshScopeTemp(blockLocals, tempPrefix);
                resolvedBindings := resolveAggregateBindings(destructure.shape, destructure.count, destructure.encodedClauses, rhs.kind, tempRuntime, source, destructureOpen, prefix);
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + destructure.shape + " destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                aggFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(rhs.kind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                listLib.pushBack(mut blockLocals, (name = tempSlot, runtime = tempRuntime, kind = ir.VALUE_KIND_UNIT,
                mutable = false, writable = false, depth = blockLexDepth, constant = false, code = aggFnDeps,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    listLib.pushBack(mut statements, "const " + tempRuntime + " = " + rhs.code + "; void " + tempRuntime + ";");
                    listLib.pushBack(mut stmtOwners, if reach.isPrunableExprForTarget(target, rhs.kind, rhs.code) { tempRuntime } else { "" });
                    listLib.pushBack(mut stmtDeps, rhs.code);
                    trackedStmtCount = trackedStmtCount + 1;
                }
                pendingDestrNames: mut List<String> = [];
                var bCursor := 0;
                var bIndex := 0;
                loop bIndex < destructure.count {
                    bindPart := types.decodeLengthPrefixedAt(resolvedBindings, bCursor);
                    propPart := types.decodeLengthPrefixedAt(resolvedBindings, bindPart.next);
                    srcPart := types.decodeLengthPrefixedAt(resolvedBindings, propPart.next);
                    tgtPart := types.decodeLengthPrefixedAt(resolvedBindings, srcPart.next);
                    bCursor = tgtPart.next;
                    bindName := bindPart.text;
                    propExpr := propPart.text;
                    srcKind := srcPart.text;
                    bindKind := tgtPart.text;
                    if not (destructure.shape == "record" and bindName == "_") {
                        ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                        if not listLib.listContainsText(pendingDestrNames, bindName) {
                            listLib.pushBack(mut pendingDestrNames, bindName);
                        }
                        bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                        fieldCode := ctx.assignValueCode(target, bindKind, srcKind, propExpr);
                        fieldFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(bindKind) {
                            "|" + tempRuntime + "|\n|" + tempRuntime + "|"
                        } else {
                            ""
                        };
                        listLib.pushBack(mut blockLocals, (name = bindName, runtime = bindRuntime, kind = bindKind,
                        mutable = destructureMutable, writable = false, depth = blockLexDepth, constant = false, code = fieldFnDeps,
                        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                        if not blockExits {
                            declKw := if destructureMutable { "let " } else { "const " };
                            tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(bindKind) { ": " + types.tsFunctionType(bindKind) } else { "" };
                            listLib.pushBack(mut statements, declKw + bindRuntime + tsTypeAnn + " = " + fieldCode + "; void " + bindRuntime + ";");
                            listLib.pushBack(mut stmtOwners, if reach.isPrunableExprForTarget(target, bindKind, fieldCode) { bindRuntime } else { "" });
                            listLib.pushBack(mut stmtDeps, fieldCode);
                            trackedStmtCount = trackedStmtCount + 1;
                        }
                    }
                    bIndex = bIndex + 1;
                }
                loop pendingDestrNames as destrName {
                    listLib.pushBack(mut declaredInBlock, destrName);
                }
                if not blockExits { statementCount = statementCount + 1; }
                blockConstant = false;
                cursor = statementNext;
            }
        } else if chAtCursor == "{" {
            braceEnd := syntax.scanBraceEnd(source, cursor, prefix);
            fullBraceEnd := if braceEnd >= 0 { syntax.scanTrailingFinallyEnd(source, braceEnd, prefix) } else { -1 };
            afterBrace := if fullBraceEnd >= 0 { syntax.skipItemSeparators(source, fullBraceEnd, prefix) } else { -1 };
            atTailBrace := (not isStmtBody) and afterBrace >= 0 and afterBrace < blockSourceSize and textLib.at(source, afterBrace) == "}";
            if not atTailBrace {
                isStatement = true;
                stmtBlock := parseBinaryCtx(target, source, cursor, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "stmt", blockAliases);
                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtBlock); }
                afterStmtBlock := syntax.skipTrivia(source, stmtBlock.next, prefix);
                if afterStmtBlock < blockSourceSize and textLib.wordAt(source, afterStmtBlock, "then") {
                    syntax.failAt(source, afterStmtBlock, prefix, "then requires an if, match, or loop");
                }
                var stmtEndPos := stmtBlock.next;
                if afterStmtBlock < blockSourceSize and textLib.wordAt(source, afterStmtBlock, "finally") {
                    if target =!= ir.TARGET_TS {
                        syntax.failAt(source, afterStmtBlock, prefix, "C backend does not support finally blocks yet");
                    }
                    stmtFin := parseFinallyClause(target, source, afterStmtBlock, prefix, blockLocals, functions, params, currentName, ctxs, bodyDepth, inferMode, blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtFin); }
                    if not blockExits {
                        listLib.pushBack(mut statements, "try { " + stmtBlock.code + " } finally { " + stmtFin.code + " }");
                        if stmtBlock.kind == ir.VALUE_KIND_NEVER or stmtFin.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                        statementCount = statementCount + 1;
                    }
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtFin.code);
                    }
                    stmtEndPos = stmtFin.next;
                } else if not blockExits {
                    if stmtBlock.code =!= "" {
                        listLib.pushBack(mut statements, "{ " + stmtBlock.code + " }");
                    }
                    if stmtBlock.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                    statementCount = statementCount + 1;
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                    }
                }
                blockConstant = false;
                stmtNext := syntax.consumeStatementEnd(source, stmtEndPos, prefix);
                cursor = if stmtNext >= 0 { stmtNext } else { stmtEndPos };
            }
        } else if chAtCursor == "@" {
            tagPeek := syntax.parseTagAt(source, cursor, prefix);
            afterPeek := syntax.skipTrivia(source, tagPeek.next, prefix);
            if afterPeek >= blockSourceSize or (textLib.at(source, afterPeek) =!= "{" and textLib.at(source, afterPeek) =!= "." and
            not textLib.wordAt(source, afterPeek, "if") and not textLib.wordAt(source, afterPeek, "match") and
            not textLib.wordAt(source, afterPeek, "loop")) {
                syntax.failAt(source, afterPeek, prefix, "expected {, if, match, loop or . after block tag @" + tagPeek.tag);
            }
        } else if textLib.isNameStart(chAtCursor) {
            itemStart := cursor;
            itemEnd := textLib.skipName(source, itemStart);
            itemName := textLib.slice(source, itemStart, itemEnd);
            afterItemName := syntax.skipTrivia(source, itemEnd, prefix);
            var blockOutputName := "";
            var blockOutputOpen := afterItemName;
            blockModIdx := ir.localIndex(blockLocals, itemName);
            if blockModIdx >= 0 and blockLocals[blockModIdx].kind == ir.VALUE_KIND_MODULE and
            afterItemName < blockSourceSize and textLib.at(source, afterItemName) == "." {
                memberStart := syntax.skipTrivia(source, afterItemName + 1, prefix);
                memberEnd := textLib.skipName(source, memberStart);
                if memberEnd > memberStart {
                    fnIdx := ir.findFunction(functions, itemName + "." + textLib.slice(source, memberStart, memberEnd));
                    if fnIdx >= 0 {
                        blockOutputName = builtinsAbi.coreOutputName(functions[fnIdx].runtime);
                        blockOutputOpen = syntax.skipTrivia(source, memberEnd, prefix);
                    }
                }
            }
            if blockOutputName =!= "" {
                isStatement = true;
                if not allowOutput {
                    syntax.failAt(source, itemStart, prefix, "host output functions are standalone statements");
                }
                var outPos := syntax.expectSymbol(source, blockOutputOpen, "(", prefix);
                outPos = syntax.skipTrivia(source, outPos, prefix);
                outParts: mut List<String> = [];
                var outArgCount := 0;
                var outDiverged := false;
                loop outPos < blockSourceSize and textLib.at(source, outPos) =!= ")" {
                    outArgStart := outPos;
                    outArg := parseBinaryCtx(target, source, outPos, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, outArg); }
                    if target == ir.TARGET_TS and not inferMode and not blockExits {
                        trace.checkTraceSafety(source, outArgStart, prefix, outArg.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, outArg.code);
                    }
                    if types.containsFnKind(outArg.kind) {
                        syntax.failAt(source, outArgStart, prefix, "cannot output function value");
                    }
                    if not outDiverged {
                        if outArg.kind == ir.VALUE_KIND_NEVER {
                            if not blockExits {
                                listLib.pushBack(mut statements, stmtReturnPrefix + "(" + outArg.code + ");");
                                blockExits = true;
                            }
                            outDiverged = true;
                        } else {
                            listLib.pushBack(mut outParts, types.tsDisplayValueCode(outArg.kind, outArg.code));
                        }
                    }
                    outArgCount = outArgCount + 1;
                    outPos = syntax.skipTrivia(source, outArg.next, prefix);
                    if outPos < blockSourceSize and textLib.at(source, outPos) == "," {
                        outPos = syntax.skipTrivia(source, outPos + 1, prefix);
                    } else {
                        break;
                    }
                }
                outPos = syntax.expectSymbol(source, outPos, ")", prefix);
                stmtNext := syntax.consumeStatementEnd(source, outPos, prefix);
                if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, outPos, prefix), prefix, "expected ; after " + blockOutputName); }
                if not outDiverged and not blockExits {
                    lineCode := if outArgCount == 0 {
                        tsLiteral.textLiteralCode(if blockOutputName == "outputLine" { "\n" } else { "" })
                    } else {
                        joinedArgs := textLib.joinTexts(outParts, " + \" \" + ");
                        ending := if blockOutputName == "outputLine" { " + \"\\n\"" } else { "" };
                        if ending =!= "" { "(" + joinedArgs + ")" + ending } else { joinedArgs }
                    };
                    listLib.pushBack(mut statements, "lite$emit(" + lineCode + ");");
                }
                if not blockExits or outDiverged { statementCount = statementCount + 1; }
                blockConstant = false;
                cursor = stmtNext;
            } else if itemName == "return" {
                isStatement = true;
                var hasTargetTag := false;
                var targetTagName := "";
                var targetTagPos := afterItemName;
                var retValStart := afterItemName;
                if afterItemName < blockSourceSize and textLib.at(source, afterItemName) == "@" {
                    retTag := syntax.parseTagAt(source, afterItemName, prefix);
                    afterRetTag := syntax.skipTrivia(source, retTag.next, prefix);
                    if afterRetTag >= blockSourceSize or textLib.at(source, afterRetTag) =!= "." {
                        hasTargetTag = true;
                        targetTagName = retTag.tag;
                        retValStart = afterRetTag;
                    }
                }
                if hasTargetTag {
                    targetIdx := ctx.findTaggedCtxIndex(ctxs, targetTagName);
                    if targetIdx < 0 {
                        syntax.failAt(source, targetTagPos, prefix, "unknown block tag @" + targetTagName);
                    }
                    targetCtx := ctxs[targetIdx];
                    if targetCtx.phase == ir.CTX_PHASE_THEN {
                        syntax.failAt(source, itemStart, prefix, "cannot return to @" + targetCtx.tag + " from inside its own then block");
                    }
                    if ctx.hasFinallyAbove(ctxs, targetIdx) {
                        syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                    }
                    isInferTarget := isInferPlaceholderKind(targetCtx.valKind);
                    if retValStart >= blockSourceSize or textLib.at(source, retValStart) == ";" or textLib.at(source, retValStart) == "}" {
                        if not isInferTarget and targetCtx.valKind =!= ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns " +
                            types.displayKind(targetCtx.valKind) + " and cannot return Unit");
                        }
                        stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                        if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                        if inferMode {
                            blockMarkers = blockMarkers + integer.intText(targetCtx.id) + "=Unit\n";
                        }
                        if not blockExits {
                            if targetCtx.iifeDepth == bodyDepth {
                                listLib.pushBack(mut statements, "break " + targetCtx.label + ";");
                            } else {
                                if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local return yet"); }
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(targetCtx.id) + ", undefined);");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    } else {
                        retExpected := inferHintKind(targetCtx.valKind);
                        rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, retExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            if types.containsFnKind(rhs.kind) {
                                tagExitDepth := trace.parseLexDepthTag(targetCtx.iterLabel, blockLexDepth);
                                trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, tagExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                        if not isInferTarget {
                            if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                    syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns Unit and cannot return a value");
                                }
                            } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(targetCtx.valKind, rhs.kind) {
                                syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                                " from block @" + targetCtx.tag + " returning " + types.displayKind(targetCtx.valKind));
                            }
                        }
                        if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
                            blockMarkers = blockMarkers + integer.intText(targetCtx.id) + "=" + rhs.kind + "\n";
                        }
                        if not blockExits {
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                listLib.pushBack(mut statements, stmtReturnPrefix + "(" + rhs.code + ");");
                            } else {
                                retValCode := if isInferTarget { rhs.code }
                                else if targetCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                                else { ctx.assignValueCode(target, targetCtx.valKind, rhs.kind, rhs.code) };
                                if targetCtx.iifeDepth == bodyDepth {
                                    if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                        listLib.pushBack(mut statements, "void (" + retValCode + "); break " + targetCtx.label + ";");
                                    } else {
                                        listLib.pushBack(mut statements, targetCtx.valVar + " = " + retValCode + "; break " + targetCtx.label + ";");
                                    }
                                } else {
                                    if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local return yet"); }
                                    listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(targetCtx.id) + ", " + retValCode + ");");
                                }
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    }
                } else {
                    fnIdx := ctx.findCtxByKindIndex(ctxs, "fn");
                    if fnIdx < 0 {
                        if ctx.hasFinallyAbove(ctxs, -1) {
                            syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                        }
                        syntax.failAt(source, itemStart, prefix, "return outside a function");
                    }
                    if ctx.hasFinallyAbove(ctxs, fnIdx) {
                        syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                    }
                    fnCtx := ctxs[fnIdx];
                    fnResult := fnCtx.valKind;
                    if retValStart >= blockSourceSize or textLib.at(source, retValStart) == ";" or textLib.at(source, retValStart) == "}" {
                        if fnResult =!= ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "function " + currentName + " must return " + types.displayKind(fnResult));
                        }
                        stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                        if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                        if not blockExits {
                            if fnCtx.iifeDepth == bodyDepth {
                                listLib.pushBack(mut statements, "return;");
                            } else {
                                if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local return yet"); }
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(0, undefined);");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    } else {
                        if fnResult == ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
                        }
                        rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, fnResult, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if not types.isCompatibleKind(fnResult, rhs.kind) {
                            syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                            " from function " + currentName + " returning " + types.displayKind(fnResult));
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
