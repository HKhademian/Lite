                if finalSeqItemKind =!= "" and finalSeqItemKind =!= ir.VALUE_KIND_UNIT {
                    decls = decls + types.cValueType(finalSeqItemKind) + " " + loopItemMetaVar + " = " +
                    ctx.zeroParsed(target, finalSeqItemKind, 0).code + "; (void)" + loopItemMetaVar + "; ";
                }
            }
            if resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER {
                decls = decls + types.cValueType(resolvedPreThenKind) + " " + loopValVar + " = " +
                ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; (void)" + loopValVar + "; ";
            }
            if emitCollected {
                colTag := types.cListTag(resolvedPreThenKind);
                decls = decls + "lt_list_" + colTag + " " + loopColVar + " = lt_list_" + colTag + "_from(0, NULL); (void)" + loopColVar + "; ";
            }
        } else {
            decls = "let " + loopCountVar + ": bigint = 0n; void " + loopCountVar + "; ";
            if finalIsSeqLoop {
                decls = decls + "let " + loopIdxVar + ": bigint = 0n; void " + loopIdxVar + "; ";
                if finalSeqItemKind =!= "" and finalSeqItemKind =!= ir.VALUE_KIND_UNIT {
                    decls = decls + "let " + loopItemMetaVar + ": " + types.tsFunctionType(finalSeqItemKind) + " = " +
                    ctx.zeroParsed(target, finalSeqItemKind, 0).code + "; void " + loopItemMetaVar + "; ";
                }
            }
            if resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER {
                decls = decls + "let " + loopValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " +
                ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; void " + loopValVar + "; ";
            }
            if emitCollected {
                decls = decls + "const " + loopColVar + ": (" + types.tsFunctionType(resolvedPreThenKind) + ")[] = []; void " + loopColVar + "; ";
            }
        }
    }
    var loopIifeBody := "";
    var left := ctx.intParsed("", 0, true, condParseStart);
    if hasActualThen {
        thenKwPos := syntax.skipTrivia(source, loopEndCursor, prefix);
        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        loopThenCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_THEN,
        iifeDepth = loopDepth, valKind = resolvedPreThenKind, valVar = loopValVar, label = loopLabel,
        iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = finalSeqItemKind,
        indexVar = loopIdxVar, hasIndex = finalIsSeqLoop, colVar = finalColVar);
        thenParsed := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, loopThenCtx), iifeDepth, inferMode, "branch", aliases);
        if inferMode {
            thenMarkers := loopOuterMarkers + ctx.collectParsedMarkers("", thenParsed);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenParsed.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenParsed.next), thenMarkers);
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            loopIifeBody = decls + loopStmtCode + " throw new Error(\"unreachable\");";
            left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        } else {
            thenRet := if thenParsed.kind == ir.VALUE_KIND_UNIT {
                "void (" + thenParsed.code + "); return undefined;"
            } else if thenParsed.kind == ir.VALUE_KIND_NEVER {
                "(" + thenParsed.code + "); throw new Error(\"unreachable\");"
            } else {
                "return " + thenParsed.code + ";"
            };
            loopIifeBody = decls + loopStmtCode + " " + thenRet;
            left = (kind = thenParsed.kind, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        }
    } else if inferMode {
        resultNext := if suffixField =!= "" { suffixEnd } else { loopEndCursor };
        resultKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ir.VALUE_KIND_NEVER
        } else if suffixField == "collected" {
            "List<" + resolvedPreThenKind + ">"
        } else if suffixField == "count" {
            ir.VALUE_KIND_INT
        } else {
            resolvedPreThenKind
        };
        left = ctx.withMarkers((kind = resultKind, code = "", intValue = 0, textValue = "", constant = false, next = resultNext), loopOuterMarkers);
    } else {
        resultNext := if suffixField =!= "" { suffixEnd } else { loopEndCursor };
        resultKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ir.VALUE_KIND_NEVER
        } else if suffixField == "collected" {
            "List<" + resolvedPreThenKind + ">"
        } else if suffixField == "count" {
            ir.VALUE_KIND_INT
        } else {
            resolvedPreThenKind
        };
        if isCLoop {
