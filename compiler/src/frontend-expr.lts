            loopHintExpected
        } else if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            resolvedPreThenKind
        };
        headerCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_HEADER,
        iifeDepth = loopDepth, valKind = passCtxValKind, valVar = loopValVar, label = loopLabel,
        iterLabel = loopLabel, countVar = loopCountVar, itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = passColVar);
        headerCtxs := ctx.appendCtx(ctxs, headerCtx);
        hdrStart := syntax.skipTrivia(source, condParseStart + 4, prefix);
        syntax.rejectHeaderBlockTag(source, hdrStart, prefix, "loop");
        var passMarkers := "";
        var isSeqLoop := false;
        var isRangeLoop := false;
        var isRangeInclusive := false;
        var rangeStartCode := "";
        var rangeEndCode := "";
        var isUncond := false;
        var condCode := "true";
        var seqCode := "";
        var seqItemName := "";
        var seqItemKind := "";
        var beforeLoopOpen := hdrStart;
        if hdrStart < textLib.length(source) and textLib.at(source, hdrStart) == "{" {
            isUncond = true;
        } else {
            hdr := parseBinaryCtx(target, source, hdrStart, prefix, locals, functions, params, currentName, "", 0, headerCtxs, loopDepth, passInfer, "", aliases);
            if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, hdr); }
            afterHdr := syntax.skipTrivia(source, hdr.next, prefix);
            if textLib.startsWithAt(source, afterHdr, "..") {
                if not numeric.isIntKind(hdr.kind) {
