                            listLib.pushBack(mut statements, stmtReturnPrefix + "(" + rhs.code + ");");
                        } else {
                            payCode := if isInferLoop { rhs.code }
                            else if loopCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                            else { ctx.assignValueCode(target, loopCtx.valKind, rhs.kind, rhs.code) };
                            if loopCtx.iifeDepth == bodyDepth {
                                jumpStmt := if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
