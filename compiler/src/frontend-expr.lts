                }
                isRangeInclusive = textLib.startsWithAt(source, afterHdr, "..=");
                endStart := syntax.skipTrivia(source, afterHdr + (if isRangeInclusive { 3 } else { 2 }), prefix);
                endHdr := parseBinaryCtx(target, source, endStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, headerCtxs, loopDepth, passInfer, "", aliases);
                if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, endHdr); }
                if not numeric.isIntKind(endHdr.kind) {
                    syntax.failAt(source, endStart, prefix, "range loop end must be Int, got " + types.displayKind(endHdr.kind));
                }
                isRangeLoop = true;
                isSeqLoop = true;
                seqItemKind = ir.VALUE_KIND_INT;
                rangeStartCode = ctx.assignValueCode(target, ir.VALUE_KIND_INT, hdr.kind, hdr.code);
                rangeEndCode = ctx.assignValueCode(target, ir.VALUE_KIND_INT, endHdr.kind, endHdr.code);
                afterEnd := syntax.skipTrivia(source, endHdr.next, prefix);
                if textLib.wordAt(source, afterEnd, "as") {
                    itemNameStart := syntax.skipTrivia(source, afterEnd + 2, prefix);
                    if itemNameStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, itemNameStart)) {
                        syntax.failAt(source, itemNameStart, prefix, "expected an item name after as");
                    }
                    itemNameEnd := textLib.skipName(source, itemNameStart);
                    seqItemName = textLib.slice(source, itemNameStart, itemNameEnd);
                    if syntax.isReservedWord(seqItemName) { syntax.unsupportedFeature(source, itemNameStart, seqItemName, prefix); }
                    beforeLoopOpen = syntax.skipTrivia(source, itemNameEnd, prefix);
                } else {
                    beforeLoopOpen = afterEnd;
                }
            } else if textLib.wordAt(source, afterHdr, "as") {
                if not types.isListKind(hdr.kind) and not types.isArrayKind(hdr.kind) and not types.isMapKind(hdr.kind) and not types.isSetKind(hdr.kind) {
                    syntax.failAt(source, hdrStart, prefix, "loop sequence must be a List, Array, Map, or Set, got " + types.displayKind(hdr.kind));
                }
                itemNameStart := syntax.skipTrivia(source, afterHdr + 2, prefix);
                if itemNameStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, itemNameStart)) {
                    syntax.failAt(source, itemNameStart, prefix, "expected an item name after as");
                }
                itemNameEnd := textLib.skipName(source, itemNameStart);
                seqItemName = textLib.slice(source, itemNameStart, itemNameEnd);
                if syntax.isReservedWord(seqItemName) { syntax.unsupportedFeature(source, itemNameStart, seqItemName, prefix); }
                isSeqLoop = true;
                if types.isMapKind(hdr.kind) {
                    seqItemKind = "(key:" + types.mapKeyKind(hdr.kind) + ",value:" + types.mapValueKind(hdr.kind) + ")";
                    seqCode = "Array.from((" + hdr.code + ").entries(), ([lite$mk, lite$mv]) => ({ key: lite$mk, value: lite$mv }))";
                } else if types.isSetKind(hdr.kind) {
                    seqItemKind = types.setElementKind(hdr.kind);
                    seqCode = "Array.from((" + hdr.code + ").values())";
                } else {
                    seqCode = hdr.code;
                    seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
                }
                beforeLoopOpen = syntax.skipTrivia(source, itemNameEnd, prefix);
            } else if types.isListKind(hdr.kind) or types.isArrayKind(hdr.kind) or types.isMapKind(hdr.kind) or types.isSetKind(hdr.kind) {
                isSeqLoop = true;
                if types.isMapKind(hdr.kind) {
                    seqItemKind = "(key:" + types.mapKeyKind(hdr.kind) + ",value:" + types.mapValueKind(hdr.kind) + ")";
                    seqCode = "Array.from((" + hdr.code + ").entries(), ([lite$mk, lite$mv]) => ({ key: lite$mk, value: lite$mv }))";
                } else if types.isSetKind(hdr.kind) {
                    seqItemKind = types.setElementKind(hdr.kind);
                    seqCode = "Array.from((" + hdr.code + ").values())";
                } else {
                    seqCode = hdr.code;
                    seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
