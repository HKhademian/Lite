                            if types.containsFnKind(rhs.kind) {
                                fnExitDepth := trace.parseLexDepthTag(fnCtx.iterLabel, 1);
                                trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, fnExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                        if not blockExits {
                            retValCode := ctx.assignValueCode(target, fnResult, rhs.kind, rhs.code);
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                listLib.pushBack(mut statements, stmtReturnPrefix + "(" + retValCode + ");");
                            } else if fnCtx.iifeDepth == bodyDepth {
                                listLib.pushBack(mut statements, "return " + retValCode + ";");
                            } else {
                                if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local return yet"); }
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(0, " + retValCode + ");");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    }
                }
            } else if itemName == "break" or itemName == "continue" {
                isStatement = true;
                var targetLoopIdx := -1;
                var afterExit := afterItemName;
                if afterItemName < blockSourceSize and textLib.at(source, afterItemName) == "@" {
                    exitTag := syntax.parseTagAt(source, afterItemName, prefix);
                    afterDotCheck := syntax.skipTrivia(source, exitTag.next, prefix);
                    if afterDotCheck < blockSourceSize and textLib.at(source, afterDotCheck) == "." {
                        syntax.failAt(source, afterDotCheck, prefix, itemName + " @" + exitTag.tag + " followed by . is ambiguous; wrap the payload in parentheses");
                    }
                    foundIdx := ctx.findTaggedCtxIndex(ctxs, exitTag.tag);
                    if foundIdx < 0 {
                        syntax.failAt(source, afterItemName, prefix, "unknown block tag @" + exitTag.tag);
                    }
                    if ctxs[foundIdx].kind =!= ir.CTX_KIND_LOOP {
                        syntax.failAt(source, afterItemName, prefix, itemName + " @" + exitTag.tag + " requires an enclosing loop");
                    }
                    if ctxs[foundIdx].phase == ir.CTX_PHASE_THEN {
                        syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " @" + exitTag.tag + " from inside its own then block");
                    }
                    targetLoopIdx = foundIdx;
                    afterExit = afterDotCheck;
                } else {
                    targetLoopIdx = ctx.findActiveLoopCtxIndex(ctxs);
                    if targetLoopIdx < 0 {
                        if ctx.hasFinallyAbove(ctxs, -1) {
                            syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                        }
                        syntax.failAt(source, itemStart, prefix, itemName + " outside loop");
                    }
                }
