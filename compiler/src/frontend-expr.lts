                                }
                            } else {
                                payTransferId := if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id };
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(payTransferId) + ", " + payCode + ");");
                            }
