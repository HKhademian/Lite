                }
                if hasBareCont {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + contBareId + ")) { continue; }");
                }
                if hasPayBrk {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + brkPayId + ")) { " + valAssign + "break; }");
                }
                if hasBareBrk {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + brkBareId + ")) { break; }");
                }
