                } else {
                    loopItemMetaVar + " = " + loopIterVar + "; "
                };
                loopIdxVar + " = " + loopCountVar + "; " + loopCountVar + " = " + loopCountVar + " + 1n; " + itemStep
            } else {
                loopCountVar + " = " + loopCountVar + " + 1n; "
            };
            brkPayId := loopIdStr;
            contPayId := integer.intText(0 - loopId);
            brkBareId := integer.intText(1000000 + loopId);
            contBareId := integer.intText(0 - 1000000 - loopId);
            hasPayCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contPayId + ",");
            hasBareCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contBareId + ",");
            hasPayBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkPayId + ",");
            hasBareBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkBareId + ",");
