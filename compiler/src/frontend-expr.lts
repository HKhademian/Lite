                    isStatement = true;
                    var ifParts := "";
                    var allBranchesExit := true;
                    var hasElseBranch := false;
                    var ifCursor := afterItemName;
                    var isFirstIf := true;
                    ifBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_IF, phase = ir.CTX_PHASE_BODY,
                    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
                    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false));
                    loop true {
                        syntax.rejectHeaderBlockTag(source, ifCursor, prefix, if isFirstIf { "if" } else { "else if" });
                        condParsed := parseBinaryCtx(target, source, ifCursor, prefix, blockLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, condParsed); }
                        if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                            syntax.failAt(source, ifCursor, prefix, if isFirstIf { "if condition must be Bool" } else { "else if condition must be Bool" });
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, ifCursor, prefix, condParsed.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        }
                        condCode := if condParsed.constant {
                            "Boolean(" + ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0) + ")"
                        } else {
                            condParsed.code
                        };
                        beforeOpen := syntax.skipTrivia(source, condParsed.next, prefix);
                        syntax.rejectMisplacedTag(source, beforeOpen, prefix, if isFirstIf { "block tag cannot appear before { in if" } else { "block tag cannot appear before { in else if" });
                        openPos := syntax.expectSymbol(source, beforeOpen, "{", prefix);
                        branch := parseBinaryCtx(target, source, openPos - 1, prefix, blockLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "stmt", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, branch); }
                        if branch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                        prefixKw := if isFirstIf { "if (" } else { " else if (" };
                        ifParts = ifParts + prefixKw + condCode + ") { " + branch.code + " }";
                        ifCursor = branch.next;
                        isFirstIf = false;
                        afterBranch := syntax.skipTrivia(source, ifCursor, prefix);
                        if afterBranch < blockSourceSize and textLib.wordAt(source, afterBranch, "else") {
                            afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                            syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                            if afterElse < blockSourceSize and textLib.wordAt(source, afterElse, "if") {
                                ifCursor = syntax.skipTrivia(source, afterElse + 2, prefix);
                            } else {
                                hasElseBranch = true;
                                elseOpen := syntax.expectSymbol(source, afterElse, "{", prefix);
                                elseBranch := parseBinaryCtx(target, source, elseOpen - 1, prefix, blockLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "stmt", blockAliases);
                                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, elseBranch); }
                                if elseBranch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                                ifParts = ifParts + " else { " + elseBranch.code + " }";
                                ifCursor = elseBranch.next;
                                break;
                            }
                        } else {
                            break;
                        }
                    }
                    if not blockExits {
                        listLib.pushBack(mut statements, ifParts);
                        if hasElseBranch and allBranchesExit { blockExits = true; }
                        statementCount = statementCount + 1;
                        if target == ir.TARGET_TS and not inferMode {
                            blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, ifParts);
                        }
                    }
                    if not hasElseBranch and allBranchesExit {
                        lastPartialIfDiverges = true;
                    }
                    blockConstant = false;
                    stmtNext := syntax.consumeStatementEnd(source, ifCursor, prefix);
                    cursor = if stmtNext >= 0 { stmtNext } else { ifCursor };
                }
            } else if itemName == "match" {
                syntax.rejectMisplacedTag(source, afterItemName, prefix, "block tag cannot appear before { in match");
                if afterItemName >= blockSourceSize or textLib.at(source, afterItemName) =!= "{" {
