                        if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                        if not blockExits {
                            if fnCtx.iifeDepth == bodyDepth or target == ir.TARGET_C {
                                listLib.pushBack(mut statements, "return;");
                            } else {
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(0, undefined);");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    } else {
                        if fnResult == ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
                        }
                        rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, fnResult, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if not types.isCompatibleKind(fnResult, rhs.kind) {
                            syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                            " from function " + currentName + " returning " + types.displayKind(fnResult));
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            if types.containsFnKind(rhs.kind) {
                                fnExitDepth := trace.parseLexDepthTag(fnCtx.iterLabel, 1);
                                trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, fnExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                        if not blockExits {
                            retValCode := ctx.assignValueCode(target, fnResult, rhs.kind, rhs.code);
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                if target == ir.TARGET_C {
                                    listLib.pushBack(mut statements, ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, retValCode));
                                } else {
                                    listLib.pushBack(mut statements, stmtReturnPrefix + "(" + retValCode + ");");
                                }
                            } else if target == ir.TARGET_C {
                                if textLib.startsWithAt(retValCode, 0, "/*@CBLK:") {
                                    endHdrR := textLib.indexOfText(retValCode, "@*/", 8);
                                    retVarR := textLib.slice(retValCode, 8, endHdrR);
                                    blkBodyR := textLib.slice(retValCode, endHdrR + 3, textLib.length(retValCode));
                                    listLib.pushBack(mut statements, "{ " + types.cValueType(fnResult) + " lt_ret; " + blkBodyR + " lt_ret = " + retVarR + "; return lt_ret; }");
                                } else {
                                    listLib.pushBack(mut statements, "return " + retValCode + ";");
                                }
                            } else if fnCtx.iifeDepth == bodyDepth {
                                listLib.pushBack(mut statements, "return " + retValCode + ";");
                            } else {
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(0, " + retValCode + ");");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    }
                }
            } else if itemName == "break" or itemName == "continue" {
                isStatement = true;
                var targetLoopIdx := -1;
                var afterExit := afterItemName;
                if afterItemName < blockSourceSize and textLib.at(source, afterItemName) == "@" {
                    exitTag := syntax.parseTagAt(source, afterItemName, prefix);
                    afterDotCheck := syntax.skipTrivia(source, exitTag.next, prefix);
                    if afterDotCheck < blockSourceSize and textLib.at(source, afterDotCheck) == "." {
                        syntax.failAt(source, afterDotCheck, prefix, itemName + " @" + exitTag.tag + " followed by . is ambiguous; wrap the payload in parentheses");
                    }
                    foundIdx := ctx.findTaggedCtxIndex(ctxs, exitTag.tag);
                    if foundIdx < 0 {
                        syntax.failAt(source, afterItemName, prefix, "unknown block tag @" + exitTag.tag);
                    }
                    if ctxs[foundIdx].kind =!= ir.CTX_KIND_LOOP {
                        syntax.failAt(source, afterItemName, prefix, itemName + " @" + exitTag.tag + " requires an enclosing loop");
                    }
                    if ctxs[foundIdx].phase == ir.CTX_PHASE_THEN {
                        syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " @" + exitTag.tag + " from inside its own then block");
                    }
                    targetLoopIdx = foundIdx;
                    afterExit = afterDotCheck;
                } else {
                    targetLoopIdx = ctx.findActiveLoopCtxIndex(ctxs);
                    if targetLoopIdx < 0 {
                        if ctx.hasFinallyAbove(ctxs, -1) {
                            syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                        }
                        syntax.failAt(source, itemStart, prefix, itemName + " outside loop");
                    }
                }
                if ctx.hasFinallyAbove(ctxs, targetLoopIdx) {
                    syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                }
                loopCtx := ctxs[targetLoopIdx];
                if loopCtx.phase == ir.CTX_PHASE_HEADER {
                    syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " from loop header");
                }
                hasPayload := afterExit < blockSourceSize and textLib.at(source, afterExit) =!= ";" and textLib.at(source, afterExit) =!= "}";
                var exitNext := afterExit;
                if not hasPayload {
                    stmtNext := syntax.consumeStatementEnd(source, afterExit, prefix);
                    if stmtNext < 0 { syntax.failAt(source, afterExit, prefix, "expected ; after " + itemName); }
                    exitNext = stmtNext;
                    if inferMode and itemName == "break" and not blockExits {
                        blockMarkers = blockMarkers + integer.intText(loopCtx.id) + "=@break\n";
                    }
                    if not blockExits {
                        if loopCtx.iifeDepth == bodyDepth {
                            if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                listLib.pushBack(mut statements, itemName + " " + loopCtx.label + ";");
                            } else {
                                listLib.pushBack(mut statements, itemName + ";");
                            }
                        } else {
                            if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local " + itemName + " yet"); }
                            transferId := if loopCtx.valVar =!= "" {
                                if itemName == "break" { 1000000 + loopCtx.id } else { 0 - 1000000 - loopCtx.id }
                            } else {
                                if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id }
                            };
                            listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(transferId) + ", undefined);");
                        }
                        blockExits = true;
                    }
                } else {
                    if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support " + itemName + " payloads yet"); }
                    isInferLoop := isInferPlaceholderKind(loopCtx.valKind);
                    payExpected := inferHintKind(loopCtx.valKind);
                    rhs := parseBinaryCtx(target, source, afterExit, prefix, blockLocals, functions, params, currentName, payExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                    if target == ir.TARGET_TS and not inferMode and not blockExits {
                        trace.checkTraceSafety(source, afterExit, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        if types.containsFnKind(rhs.kind) {
                            loopExitDepth := trace.parseLexDepthTag(loopCtx.iterLabel, blockLexDepth);
                            trace.checkEscapingFnSafety(source, afterExit, prefix, rhs.code, loopExitDepth, blockLocals);
                        }
                    }
                    stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                    if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + itemName); }
                    exitNext = stmtNext;
                    if not isInferLoop {
                        if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                            if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) + " to Unit loop .value");
                            }
                        } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(loopCtx.valKind, rhs.kind) {
                            syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) +
                            " to loop .value of kind " + types.displayKind(loopCtx.valKind));
                        }
                    }
                    if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
                        blockMarkers = blockMarkers + integer.intText(loopCtx.id) + "=" + rhs.kind + "\n";
                    }
                    if not blockExits {
                        if rhs.kind == ir.VALUE_KIND_NEVER {
                            listLib.pushBack(mut statements, stmtReturnPrefix + "(" + rhs.code + ");");
                        } else {
                            payCode := if isInferLoop { rhs.code }
                            else if loopCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                            else { ctx.assignValueCode(target, loopCtx.valKind, rhs.kind, rhs.code) };
                            if loopCtx.iifeDepth == bodyDepth {
                                jumpStmt := if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                    itemName + " " + loopCtx.label + ";"
                                } else {
                                    itemName + ";"
                                };
                                if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                                    listLib.pushBack(mut statements, "void (" + payCode + "); " + jumpStmt);
                                } else if loopCtx.colVar =!= "" {
                                    listLib.pushBack(mut statements, loopCtx.valVar + " = " + payCode + "; " + loopCtx.colVar + ".push(" + loopCtx.valVar + "); " + jumpStmt);
                                } else {
                                    listLib.pushBack(mut statements, loopCtx.valVar + " = " + payCode + "; " + jumpStmt);
                                }
                            } else {
                                payTransferId := if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id };
                                listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(payTransferId) + ", " + payCode + ");");
                            }
                        }
                        blockExits = true;
                    }
                }
                statementCount = statementCount + 1;
                blockConstant = false;
                cursor = exitNext;
            } else if itemName == "else" {
                syntax.failAt(source, itemStart, prefix, "unexpected else");
            } else if itemName == "if" {
                rawStmtIfEnd := syntax.scanRawIfChainEnd(source, itemStart, prefix, true);
                afterRawStmtIf := if rawStmtIfEnd >= 0 { syntax.skipTrivia(source, rawStmtIfEnd, prefix) } else { -1 };
                stmtIfHasThen := afterRawStmtIf >= 0 and (textLib.wordAt(source, afterRawStmtIf, "then") or textLib.wordAt(source, afterRawStmtIf, "finally"));
                var useValueIf := stmtIfHasThen;
                if (not isStmtBody) and not useValueIf {
                    valIfEnd := syntax.scanValueIfEnd(source, itemStart, prefix, false);
                    if valIfEnd >= 0 {
                        afterValIf := syntax.skipItemSeparators(source, valIfEnd, prefix);
                        if afterValIf < blockSourceSize and textLib.at(source, afterValIf) == "}" {
                            useValueIf = true;
                        }
                    }
                }
                if not useValueIf {
                    isStatement = true;
                    afterRawIfTail := if rawStmtIfEnd >= 0 { syntax.skipItemSeparators(source, rawStmtIfEnd, prefix) } else { -1 };
                    isLoopTailPartialIf := isLoopBody and afterRawIfTail >= 0 and afterRawIfTail < blockSourceSize and textLib.at(source, afterRawIfTail) == "}";
                    ifBranchSink := if isLoopTailPartialIf { "loopBody" } else { "stmt" };
                    ifBranchExpected := if isLoopTailPartialIf { expected } else { "" };
                    var ifParts := "";
                    var allBranchesExit := true;
                    var hasElseBranch := false;
                    var ifCursor := afterItemName;
                    var isFirstIf := true;
                    ifBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_IF, phase = ir.CTX_PHASE_BODY,
                    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
                    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
                    loop true {
                        syntax.rejectHeaderBlockTag(source, ifCursor, prefix, if isFirstIf { "if" } else { "else if" });
                        condParsed := parseBinaryCtx(target, source, ifCursor, prefix, blockLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, condParsed); }
                        if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                            syntax.failAt(source, ifCursor, prefix, if isFirstIf { "if condition must be Bool" } else { "else if condition must be Bool" });
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, ifCursor, prefix, condParsed.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        }
                        condCode := if condParsed.constant {
                            litB := ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0);
                            if target == ir.TARGET_C { litB } else { "Boolean(" + litB + ")" }
                        } else {
                            condParsed.code
                        };
                        beforeOpen := syntax.skipTrivia(source, condParsed.next, prefix);
                        syntax.rejectMisplacedTag(source, beforeOpen, prefix, if isFirstIf { "block tag cannot appear before { in if" } else { "block tag cannot appear before { in else if" });
                        openPos := syntax.expectSymbol(source, beforeOpen, "{", prefix);
                        branch := parseBinaryCtx(target, source, openPos - 1, prefix, blockLocals, functions, params, currentName, ifBranchExpected, 0, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, branch); }
                        if branch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                        prefixKw := if isFirstIf { "if (" } else { " else if (" };
                        ifParts = ifParts + prefixKw + condCode + ") { " + branch.code + " }";
                        ifCursor = branch.next;
                        isFirstIf = false;
                        afterBranch := syntax.skipTrivia(source, ifCursor, prefix);
                        if afterBranch < blockSourceSize and textLib.wordAt(source, afterBranch, "else") {
                            afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                            syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                            if afterElse < blockSourceSize and textLib.wordAt(source, afterElse, "if") {
                                ifCursor = syntax.skipTrivia(source, afterElse + 2, prefix);
                            } else {
                                hasElseBranch = true;
                                elseOpen := syntax.expectSymbol(source, afterElse, "{", prefix);
                                elseBranch := parseBinaryCtx(target, source, elseOpen - 1, prefix, blockLocals, functions, params, currentName, ifBranchExpected, 0, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, elseBranch); }
                                if elseBranch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                                ifParts = ifParts + " else { " + elseBranch.code + " }";
                                ifCursor = elseBranch.next;
                                break;
                            }
                        } else {
                            break;
                        }
                    }
                    if not blockExits {
                        listLib.pushBack(mut statements, ifParts);
                        if hasElseBranch and allBranchesExit { blockExits = true; }
                        statementCount = statementCount + 1;
                        if target == ir.TARGET_TS and not inferMode {
                            blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, ifParts);
                        }
                    }
                    if (not hasElseBranch and allBranchesExit) or isLoopTailPartialIf {
                        lastPartialIfDiverges = true;
                    }
                    blockConstant = false;
                    stmtNext := syntax.consumeStatementEnd(source, ifCursor, prefix);
                    cursor = if stmtNext >= 0 { stmtNext } else { ifCursor };
                }
            } else if itemName == "match" {
                syntax.rejectMisplacedTag(source, afterItemName, prefix, "block tag cannot appear before { in match");
                isSubjectStmtMatch := afterItemName < blockSourceSize and textLib.at(source, afterItemName) =!= "{";
                rawStmtMatchEnd := syntax.scanRawMatchEnd(source, itemStart, prefix);
                afterRawStmtMatch := if rawStmtMatchEnd >= 0 { syntax.skipTrivia(source, rawStmtMatchEnd, prefix) } else { -1 };
                stmtMatchHasThen := afterRawStmtMatch >= 0 and (textLib.wordAt(source, afterRawStmtMatch, "then") or textLib.wordAt(source, afterRawStmtMatch, "finally"));
                afterRawMatchTail := if rawStmtMatchEnd >= 0 { syntax.skipItemSeparators(source, rawStmtMatchEnd, prefix) } else { -1 };
                isLoopTailMatch := isLoopBody and not stmtMatchHasThen and afterRawMatchTail >= 0 and afterRawMatchTail < blockSourceSize and textLib.at(source, afterRawMatchTail) == "}";
                var useValueMatch := stmtMatchHasThen;
                if (not isStmtBody) and (not isLoopTailMatch) and not useValueMatch {
                    valMatchEnd := syntax.scanValueMatchEnd(source, itemStart, prefix, false);
                    if valMatchEnd >= 0 {
                        afterValMatch := syntax.skipItemSeparators(source, valMatchEnd, prefix);
                        if afterValMatch < blockSourceSize and textLib.at(source, afterValMatch) == "}" {
                            useValueMatch = true;
                        }
                    }
                }
                if not useValueMatch and isSubjectStmtMatch {
                    isStatement = true;
                    subStmt := if isLoopTailMatch {
                        parseSubjectMatchLoopTail(target, source, itemStart, prefix, blockLocals, functions, params, currentName, expected, ctxs, bodyDepth, inferMode, blockAliases)
                    } else {
                        parseSubjectMatchStmt(target, source, itemStart, prefix, blockLocals, functions, params, currentName, ctxs, bodyDepth, inferMode, blockAliases)
                    };
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, subStmt); }
                    listLib.pushBack(mut statements, subStmt.code);
                    statementCount = statementCount + 1;
                    if subStmt.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                    if isLoopTailMatch { lastPartialIfDiverges = true; }
                    cursor = subStmt.next;
                } else if not useValueMatch {
                    isStatement = true;
                    matchArmSink := if isLoopTailMatch { "loopBody" } else { "stmt" };
                    matchArmExpected := if isLoopTailMatch { expected } else { "" };
                    var matchCursor := syntax.skipItemSeparators(source, afterItemName + 1, prefix);
                    var matchParts := "";
                    var sawFallback := false;
                    var armCount := 0;
                    var allArmsExit := true;
                    matchBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_MATCH, phase = ir.CTX_PHASE_BODY,
                    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
                    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
                    loop true {
                        matchCursor = syntax.skipItemSeparators(source, matchCursor, prefix);
                        if matchCursor >= blockSourceSize {
                            syntax.failAt(source, afterItemName, prefix, "expected } to close match");
                        }
                        if textLib.at(source, matchCursor) == "}" {
                            if not sawFallback and not isLoopTailMatch {
                                syntax.failAt(source, matchCursor, prefix, "subjectless match requires a final _ fallback arm");
                            }
                            matchCursor = matchCursor + 1;
                            break;
                        }
                        if sawFallback {
                            syntax.failAt(source, matchCursor, prefix, "match fallback _ must be the final arm");
                        }
                        afterUnder := syntax.skipTrivia(source, matchCursor + 1, prefix);
                        if textLib.wordAt(source, matchCursor, "_") {
                            syntax.rejectMisplacedTag(source, afterUnder, prefix, "block tag cannot appear after _ in match arm");
                        }
                        isFallback := textLib.wordAt(source, matchCursor, "_") and afterUnder < blockSourceSize and
                        textLib.at(source, afterUnder) == "{";
                        if isFallback {
                            sawFallback = true;
                            arm := parseBinaryCtx(target, source, afterUnder, prefix, blockLocals, functions, params, currentName, matchArmExpected, 0, matchBarrierCtxs, bodyDepth, inferMode, matchArmSink, blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, arm); }
                            if arm.kind =!= ir.VALUE_KIND_NEVER { allArmsExit = false; }
                            if armCount == 0 {
                                matchParts = "{ " + arm.code + " }";
                            } else {
                                matchParts = matchParts + " else { " + arm.code + " }";
                            }
                            armCount = armCount + 1;
                            matchCursor = arm.next;
                        } else {
                            armOpen := syntax.scanConditionOpen(source, matchCursor, prefix);
                            if armOpen < 0 {
                                syntax.failAt(source, matchCursor, prefix, "expected { after match arm condition");
                            }
                            if armOpen == matchCursor {
                                syntax.failAt(source, matchCursor, prefix, "match arm header requires grouping for { ... } expressions");
                            }
                            syntax.rejectHeaderBlockTag(source, matchCursor, prefix, "match arm");
                            condParsed := parseBinaryCtx(target, source, matchCursor, prefix, blockLocals, functions, params, currentName, "", 0, matchBarrierCtxs, bodyDepth, inferMode, "", blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, condParsed); }
                            afterCond := syntax.skipTrivia(source, condParsed.next, prefix);
                            syntax.rejectMisplacedTag(source, afterCond, prefix, "block tag cannot appear before { in match arm");
                            if afterCond > armOpen {
                                syntax.failAt(source, armOpen, prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                            }
                            if afterCond =!= armOpen {
                                _ := syntax.expectSymbol(source, afterCond, "{", prefix);
                            }
                            if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                                syntax.failAt(source, matchCursor, prefix, "match arm condition must be Bool");
                            }
                            if target == ir.TARGET_TS and not inferMode and not blockExits {
                                trace.checkTraceSafety(source, matchCursor, prefix, condParsed.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            }
                            condCode := if condParsed.constant {
                                "Boolean(" + ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0) + ")"
                            } else {
                                condParsed.code
                            };
                            arm := parseBinaryCtx(target, source, armOpen, prefix, blockLocals, functions, params, currentName, matchArmExpected, 0, matchBarrierCtxs, bodyDepth, inferMode, matchArmSink, blockAliases);
                            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, arm); }
                            if arm.kind =!= ir.VALUE_KIND_NEVER { allArmsExit = false; }
                            armKw := if armCount == 0 { "if (" } else { " else if (" };
                            matchParts = matchParts + armKw + condCode + ") { " + arm.code + " }";
                            armCount = armCount + 1;
                            matchCursor = arm.next;
                        }
                    }
                    if not blockExits {
                        listLib.pushBack(mut statements, matchParts);
                        if sawFallback and allArmsExit { blockExits = true; }
                        statementCount = statementCount + 1;
                        if target == ir.TARGET_TS and not inferMode {
                            blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, matchParts);
                        }
                    }
                    if isLoopTailMatch { lastPartialIfDiverges = true; }
                    blockConstant = false;
                    stmtNext := syntax.consumeStatementEnd(source, matchCursor, prefix);
                    cursor = if stmtNext >= 0 { stmtNext } else { matchCursor };
                }
            } else if itemName == "loop" {
                rawLoopStmtEnd := syntax.scanRawLoopEnd(source, itemStart, prefix);
                var atLoopTail := false;
                if (not isStmtBody) and rawLoopStmtEnd >= 0 {
                    afterRawLoopStmt := syntax.skipItemSeparators(source, rawLoopStmtEnd, prefix);
                    atLoopTail = afterRawLoopStmt < blockSourceSize and textLib.at(source, afterRawLoopStmt) == "}";
                }
                useExprLoop := syntax.loopNeedsExprLowering(source, itemStart, prefix) or (target == ir.TARGET_TS and atLoopTail);
                if not useExprLoop {
                    isStatement = true;
                    syntax.rejectHeaderBlockTag(source, afterItemName, prefix, "loop");
                    var loopHeaderPos := afterItemName;
                    var loopCondCode := "";
                    var loopSeqCode := "";
                    var loopItemName := "";
                    var loopItemKind := "";
                    if loopHeaderPos < blockSourceSize and textLib.at(source, loopHeaderPos) =!= "{" {
                        hdrParsed := parseBinaryCtx(target, source, loopHeaderPos, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, hdrParsed); }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, loopHeaderPos, prefix, hdrParsed.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        }
                        afterHdr := syntax.skipTrivia(source, hdrParsed.next, prefix);
                        if textLib.wordAt(source, afterHdr, "as") {
                            if not types.isListKind(hdrParsed.kind) and not types.isArrayKind(hdrParsed.kind) and not types.isMapKind(hdrParsed.kind) and not types.isSetKind(hdrParsed.kind) {
                                syntax.failAt(source, loopHeaderPos, prefix, "loop sequence must be a List, Array, Map, or Set, got " + types.displayKind(hdrParsed.kind));
                            }
                            asNameStart := syntax.skipTrivia(source, afterHdr + 2, prefix);
                            if asNameStart >= blockSourceSize or not textLib.isNameStart(textLib.at(source, asNameStart)) {
