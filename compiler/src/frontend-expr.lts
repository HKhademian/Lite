                    }
                    stmtFin := parseFinallyClause(target, source, afterStmtBlock, prefix, blockLocals, functions, params, currentName, ctxs, bodyDepth, inferMode, blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtFin); }
                    if not blockExits {
