        topValKind := topCtx.valKind;
        topValVar := topCtx.valVar;
        topLabel := topCtx.label;
        if isInferPlaceholderKind(topValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        blockMarkers = blockMarkers + integer.intText(topId) + "=" + blockKind + "\n";
                    }
                } else {
                    blockMarkers = blockMarkers + integer.intText(topId) + "=Unit\n";
                }
            }
            inferredKind := ctx.inferKindFromMarkers(blockMarkers, topId, topTag, source, start, prefix, blockExits);
            outerMarkers := ctx.filterOtherMarkers(blockMarkers, topId);
            return ctx.withMarkers((kind = inferredKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), outerMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "block @" + topTag + " returns Unit and cannot return a value");
                    }
                } else if topValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning Never");
                    }
                } else if not types.isCompatibleKind(topValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning " + types.displayKind(topValKind));
                }
            } else if topValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "block @" + topTag + " must return " + types.displayKind(topValKind));
            }
        }
        if not blockExits and sawTailExpr {
            if blockKind == ir.VALUE_KIND_NEVER {
                listLib.pushBack(mut statements, "(" + blockCode + ");");
                blockExits = true;
            } else if topValKind == ir.VALUE_KIND_UNIT {
                if blockCode =!= ir.targetUnitLiteralCode(target) {
                    listLib.pushBack(mut statements, "void (" + blockCode + ");");
                }
            } else {
                tailCode := ctx.assignValueCode(target, topValKind, blockKind, blockCode);
                listLib.pushBack(mut statements, topValVar + " = " + tailCode + ";");
            }
        }
        bodyJoined := textLib.joinTexts(statements, " ");
        needsLabel := reach.codeUsesTextCall(bodyJoined, "break " + topLabel + ";");
        needsTry := reach.codeUsesTextCall(bodyJoined, "lite$throwTransfer(" + integer.intText(topId) + ",");
        labeledBody := if needsLabel { topLabel + ": { " + bodyJoined + " }" } else { bodyJoined };
        wrappedBody := if needsTry {
            catchAssign := if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER { "" } else { topValVar + " = lite$transferVal;" };
            tryInner := if needsLabel { labeledBody } else { "{ " + labeledBody + " }" };
            "try { " + tryInner + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " + integer.intText(topId) + ")) { " + catchAssign + " } else { throw lite$err; } }"
        } else {
            labeledBody
        };
        finalIife := if topValKind == ir.VALUE_KIND_UNIT {
            "(() => { " + wrappedBody + (if wrappedBody =!= "" { " " } else { "" }) + "return undefined; })()"
        } else if topValKind == ir.VALUE_KIND_NEVER {
            "(() => { " + wrappedBody + " })()"
        } else {
            "(() => { let " + topValVar + ": " + types.tsFunctionType(topValKind) + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; " + wrappedBody + " return " + topValVar + "; })()"
        };
        return ctx.withMarkers((kind = topValKind, code = finalIife, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
    }
    if isStandaloneBlock {
        afterUntaggedClose := syntax.skipTrivia(source, cursor, prefix);
        if afterUntaggedClose < blockSourceSize and textLib.wordAt(source, afterUntaggedClose, "then") {
            syntax.failAt(source, afterUntaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterUntaggedClose < blockSourceSize and textLib.wordAt(source, afterUntaggedClose, "finally") {
            if target =!= ir.TARGET_TS {
                syntax.failAt(source, afterUntaggedClose, prefix, "C backend does not support finally blocks yet");
            }
            finParsed := parseFinallyClause(target, source, afterUntaggedClose, prefix, locals, functions, params, currentName, ctxs, bodyDepth, inferMode, aliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, finParsed); }
            stmtsJoined := textLib.joinTexts(statements, " ");
            standaloneTryBody := if blockExits {
                stmtsJoined
            } else if blockKind == ir.VALUE_KIND_UNIT {
                unitRet := if blockCode == ir.targetUnitLiteralCode(target) {
                    "return undefined;"
                } else {
                    "void (" + blockCode + "); return undefined;"
                };
                if stmtsJoined == "" { unitRet } else { stmtsJoined + " " + unitRet }
            } else if blockKind == ir.VALUE_KIND_NEVER {
                if stmtsJoined == "" { "return " + blockCode + ";" } else { stmtsJoined + " return " + blockCode + ";" }
            } else {
                valRet := "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";";
                if stmtsJoined == "" { valRet } else { stmtsJoined + " " + valRet }
            };
            finalStandaloneKind := if blockExits or finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { blockKind };
            return ctx.withMarkers((kind = finalStandaloneKind,
            code = "(() => { try { " + standaloneTryBody + " } finally { " + finParsed.code + " } })()",
            intValue = 0, textValue = "", constant = false, next = finParsed.next),
            if inferMode { blockMarkers } else { "" });
        }
    }
    if blockExits {
        if target =!= ir.TARGET_TS {
            syntax.failAt(source, start, prefix, "C backend does not support statement-bearing value blocks yet");
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "(() => { " + textLib.joinTexts(statements, " ") + " })()",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if statementCount == 0 {
        baseBlock := (kind = blockKind, code = blockCode, intValue = blockInt, textValue = blockText, constant = blockConstant, next = cursor);
        return if inferMode and blockMarkers =!= "" { ctx.withMarkers(baseBlock, blockMarkers) } else { baseBlock };
    }
    if target =!= ir.TARGET_TS {
        syntax.failAt(source, start, prefix, "C backend does not support statement-bearing value blocks yet");
    }
    returnCode := if blockKind == ir.VALUE_KIND_UNIT {
        if blockCode == ir.targetUnitLiteralCode(target) { "return undefined;" }
        else { "void (" + blockCode + "); return undefined;" }
    } else if blockKind == ir.VALUE_KIND_NEVER {
        "return " + blockCode + ";"
    } else {
        "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";"
    };
    ctx.withMarkers((kind = blockKind, code = "(() => { " + textLib.joinTexts(statements, " ") + " " + returnCode + " })()",
    intValue = 0, textValue = "", constant = false, next = cursor),
    if inferMode { blockMarkers } else { "" })
};

/** Parses `[@tag] loop [header] { ... } [then { ... }] [finally { ... }]` expressions. */
parseLoopExpr := fn(target: String, source: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    rawLoopEnd := syntax.scanRawLoopEnd(source, condParseStart, prefix);
    afterRawLoop := if rawLoopEnd >= 0 { syntax.skipTrivia(source, rawLoopEnd, prefix) } else { -1 };
    hasActualThen := afterRawLoop >= 0 and textLib.wordAt(source, afterRawLoop, "then");
    afterOptLoopThen := if hasActualThen { syntax.scanTrailingThenEnd(source, rawLoopEnd, prefix, false) } else { rawLoopEnd };
    afterOptLoopThenTrivia := if afterOptLoopThen >= 0 { syntax.skipTrivia(source, afterOptLoopThen, prefix) } else { -1 };
    hasLoopFinally := afterOptLoopThenTrivia >= 0 and textLib.wordAt(source, afterOptLoopThenTrivia, "finally");
    if target =!= ir.TARGET_TS {
        if condParseTag =!= "" {
            syntax.failAt(source, condParseTagAt, prefix, "C backend does not support tagged loops yet");
        }
        if hasLoopFinally {
            syntax.failAt(source, afterOptLoopThenTrivia, prefix, "C backend does not support finally blocks yet");
        }
        syntax.unsupportedFeature(source, condParseStart, "loop", prefix);
    }
    loopId := ctx.nextCtxId(ctxs);
    loopIdStr := integer.intText(loopId);
    loopValVar := "lite$val" + loopIdStr;
    loopCountVar := "lite$cnt" + loopIdStr;
    loopItemMetaVar := "lite$litem" + loopIdStr;
    loopIdxVar := "lite$lidx" + loopIdStr;
    loopIterVar := "lite$iter" + loopIdStr;
    loopLabel := "lite$l" + loopIdStr;
    loopDepth := iifeDepth + 1;
    normExpected := normalizeExpectedValueKind(expected);
    loopHintExpected := if hasActualThen { "" } else { normExpected };
    loopTagDisplay := if condParseTag =!= "" { condParseTag } else { "loop" };
    passCount := if inferMode { 1 } else { 2 };
    var resolvedPreThenKind := "";
    var loopOuterMarkers := "";
    var loopEndCursor := condParseStart;
    var loopStmtCode := "";
    var finalIsSeqLoop := false;
    var finalSeqItemKind := "";
    var pass := 1;
    loop pass <= passCount {
        isPass1 := pass == 1;
        passInfer := isPass1 or inferMode;
        passCtxValKind := if isPass1 {
            if loopHintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + loopHintExpected }
        } else {
            resolvedPreThenKind
        };
        passBodyExpected := if isPass1 {
            loopHintExpected
        } else if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            resolvedPreThenKind
        };
        headerCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_HEADER,
        iifeDepth = loopDepth, valKind = passCtxValKind, valVar = loopValVar, label = loopLabel,
        iterLabel = loopLabel, countVar = loopCountVar, itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
        headerCtxs := ctx.appendCtx(ctxs, headerCtx);
        hdrStart := syntax.skipTrivia(source, condParseStart + 4, prefix);
        syntax.rejectHeaderBlockTag(source, hdrStart, prefix, "loop");
        var passMarkers := "";
        var isSeqLoop := false;
        var isUncond := false;
        var condCode := "true";
        var seqCode := "";
        var seqItemName := "";
        var seqItemKind := "";
        var beforeLoopOpen := hdrStart;
        if hdrStart < textLib.length(source) and textLib.at(source, hdrStart) == "{" {
            isUncond = true;
        } else {
            hdr := parseBinaryCtx(target, source, hdrStart, prefix, locals, functions, params, currentName, "", 0, headerCtxs, loopDepth, passInfer, "", aliases);
            if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, hdr); }
            afterHdr := syntax.skipTrivia(source, hdr.next, prefix);
            if textLib.wordAt(source, afterHdr, "as") {
                if not types.isListKind(hdr.kind) and not types.isArrayKind(hdr.kind) {
                    syntax.failAt(source, hdrStart, prefix, "loop sequence must be a List or Array, got " + types.displayKind(hdr.kind));
                }
                itemNameStart := syntax.skipTrivia(source, afterHdr + 2, prefix);
                if itemNameStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, itemNameStart)) {
                    syntax.failAt(source, itemNameStart, prefix, "expected an item name after as");
                }
                itemNameEnd := textLib.skipName(source, itemNameStart);
                seqItemName = textLib.slice(source, itemNameStart, itemNameEnd);
                if syntax.isReservedWord(seqItemName) { syntax.unsupportedFeature(source, itemNameStart, seqItemName, prefix); }
                isSeqLoop = true;
                seqCode = hdr.code;
                seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
                beforeLoopOpen = syntax.skipTrivia(source, itemNameEnd, prefix);
            } else if types.isListKind(hdr.kind) or types.isArrayKind(hdr.kind) {
                isSeqLoop = true;
                seqCode = hdr.code;
                seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
                beforeLoopOpen = afterHdr;
            } else {
                if hdr.kind =!= ir.VALUE_KIND_BOOL {
                    syntax.failAt(source, hdrStart, prefix, "loop condition must be Bool");
                }
                if hdr.constant {
                    if hdr.intValue == 0 {
                        condCode = "false";
                    } else {
                        condCode = "true";
                        isUncond = true;
                    }
                } else {
                    condCode = hdr.code;
                }
                beforeLoopOpen = afterHdr;
            }
        }
        syntax.rejectMisplacedTag(source, beforeLoopOpen, prefix, "block tag cannot appear before { in loop");
        loopOpen := syntax.expectSymbol(source, beforeLoopOpen, "{", prefix);
        loopLocals: mut List<Local> = [];
        loop locals as entry { listLib.pushBack(mut loopLocals, entry); }
        loopItemLexDepth := ir.maxLocalLexDepth(loopLocals) + 1;
        if isSeqLoop and seqItemName =!= "" {
            if seqItemKind == ir.VALUE_KIND_UNIT {
                listLib.pushBack(mut loopLocals, (name = seqItemName, runtime = ir.targetUnitLiteralCode(target), kind = ir.VALUE_KIND_UNIT,
                mutable = false, writable = false, depth = loopItemLexDepth, constant = true, code = ir.targetUnitLiteralCode(target),
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
            } else {
                seqItemCode := if target == ir.TARGET_TS and not passInfer and types.containsFnKind(seqItemKind) { trace.computeCallableRhsDeps(seqCode) } else { loopItemMetaVar };
                listLib.pushBack(mut loopLocals, (name = seqItemName, runtime = loopItemMetaVar, kind = seqItemKind,
                mutable = false, writable = false, depth = loopItemLexDepth, constant = false, code = seqItemCode,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
            }
        }
        loopBodyLexDepthStr := integer.intText(ir.maxLocalLexDepth(loopLocals) + 1);
        bodyCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_BODY,
        iifeDepth = loopDepth, valKind = passCtxValKind, valVar = loopValVar, label = loopLabel,
        iterLabel = loopBodyLexDepthStr, countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = seqItemKind,
        indexVar = loopIdxVar, hasIndex = isSeqLoop);
        bodyCtxs := ctx.appendCtx(ctxs, bodyCtx);
        loopBodySink := if isSeqLoop and seqItemName =!= "" { "loopBody:" + seqItemName } else { "loopBody" };
        bodyParsed := parseBinaryCtx(target, source, loopOpen - 1, prefix, loopLocals, functions, params, currentName,
        passBodyExpected, 0, bodyCtxs, loopDepth, passInfer, loopBodySink, aliases);
        if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, bodyParsed); }
        if isPass1 {
            loopEndCursor = bodyParsed.next;
            finalIsSeqLoop = isSeqLoop;
            finalSeqItemKind = seqItemKind;
            loopOuterMarkers = ctx.filterOtherMarkers(passMarkers, loopId);
            markerScan := infer.scanLoopMarkers(passMarkers, loopId);
            if isUncond and bodyParsed.kind == ir.VALUE_KIND_NEVER and not markerScan.hasAny {
                resolvedPreThenKind = ir.VALUE_KIND_NEVER;
            } else {
                if hasActualThen and not markerScan.hasConcrete {
                    probeThenKw := syntax.skipTrivia(source, loopEndCursor, prefix);
                    probeAfterThen := syntax.skipTrivia(source, probeThenKw + 4, prefix);
                    syntax.rejectMisplacedTag(source, probeAfterThen, prefix, "block tag cannot appear after then");
                    probeThenOpen := syntax.expectSymbol(source, probeAfterThen, "{", prefix);
                    thenProbeCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_THEN,
                    iifeDepth = loopDepth, valKind = ir.VAL_KIND_INFER, valVar = loopValVar, label = loopLabel,
                    iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = seqItemKind,
                    indexVar = loopIdxVar, hasIndex = isSeqLoop);
                    thenProbe := parseBinaryCtx(target, source, probeThenOpen - 1, prefix, locals, functions, params, currentName,
                    normExpected, 0, ctx.appendCtx(ctxs, thenProbeCtx), iifeDepth, true, "exprOut", aliases);
                    passMarkers = ctx.collectParsedMarkers(passMarkers, thenProbe);
                }
                resolvedPreThenKind = infer.inferLoopValueKind(passMarkers, loopId, loopTagDisplay, source, condParseTagAt, prefix, loopHintExpected);
            }
        } else {
            metaStep := if isSeqLoop {
                itemStep := if seqItemKind == "" or seqItemKind == ir.VALUE_KIND_UNIT {
                    "void " + loopIterVar + "; "
                } else {
                    loopItemMetaVar + " = " + loopIterVar + "; "
                };
                loopIdxVar + " = " + loopCountVar + "; " + loopCountVar + " = " + loopCountVar + " + 1n; " + itemStep
            } else {
                loopCountVar + " = " + loopCountVar + " + 1n; "
            };
            brkPayId := loopIdStr;
            contPayId := integer.intText(0 - loopId);
            brkBareId := integer.intText(1000000 + loopId);
            contBareId := integer.intText(0 - 1000000 - loopId);
            hasPayCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contPayId + ",");
            hasBareCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contBareId + ",");
            hasPayBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkPayId + ",");
            hasBareBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkBareId + ",");
            valAssign := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER { "" }
            else { loopValVar + " = lite$transferVal; " };
            var wrappedBody := bodyParsed.code;
            if hasPayCont or hasBareCont or hasPayBrk or hasBareBrk {
                catchClauses: mut List<String> = [];
                if hasPayCont {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + contPayId + ")) { " + valAssign + "continue; }");
                }
                if hasBareCont {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + contBareId + ")) { continue; }");
                }
                if hasPayBrk {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + brkPayId + ")) { " + valAssign + "break; }");
                }
                if hasBareBrk {
                    listLib.pushBack(mut catchClauses, "if (lite$hasTransfer(lite$err, " + brkBareId + ")) { break; }");
                }
                wrappedBody = "try { " + bodyParsed.code + " } catch (lite$err) { " +
                textLib.joinTexts(catchClauses, " else ") + " else { throw lite$err; } }";
            }
            rawLoopStmt := if isSeqLoop {
                "for (const " + loopIterVar + " of " + ir.targetListCopyCode(target, seqCode) + ") { " + metaStep + wrappedBody + " }"
            } else {
                whileCond := if condCode == "true" { "Boolean(true)" } else if condCode == "false" { "Boolean(false)" } else { "Boolean(" + condCode + ")" };
                "while (" + whileCond + ") { " + metaStep + wrappedBody + " }"
            };
            needsLoopLabel := reach.codeUsesTextCall(rawLoopStmt, "break " + loopLabel + ";") or
            reach.codeUsesTextCall(rawLoopStmt, "continue " + loopLabel + ";");
            labeledLoop := if needsLoopLabel { loopLabel + ": " + rawLoopStmt } else { rawLoopStmt };
            hdrCheckText := if isSeqLoop { seqCode } else { condCode };
            hdrHasPayBrk := reach.codeUsesTextCall(hdrCheckText, "lite$throwTransfer(" + brkPayId + ",");
            hdrHasBareBrk := reach.codeUsesTextCall(hdrCheckText, "lite$throwTransfer(" + brkBareId + ",");
            if hdrHasPayBrk or hdrHasBareBrk {
                hdrClauses: mut List<String> = [];
                if hdrHasPayBrk {
                    listLib.pushBack(mut hdrClauses, "if (lite$hasTransfer(lite$err, " + brkPayId + ")) { " + valAssign + "}");
                }
                if hdrHasBareBrk {
                    listLib.pushBack(mut hdrClauses, "if (lite$hasTransfer(lite$err, " + brkBareId + ")) { }");
                }
                loopStmtCode = "try { " + labeledLoop + " } catch (lite$err) { " +
                textLib.joinTexts(hdrClauses, " else ") + " else { throw lite$err; } }";
            } else {
                loopStmtCode = labeledLoop;
            }
        }
        pass = pass + 1;
    }
    var decls := "";
    if not inferMode {
        decls = "let " + loopCountVar + ": bigint = 0n; void " + loopCountVar + "; ";
        if finalIsSeqLoop {
            decls = decls + "let " + loopIdxVar + ": bigint = 0n; void " + loopIdxVar + "; ";
            if finalSeqItemKind =!= "" and finalSeqItemKind =!= ir.VALUE_KIND_UNIT {
                decls = decls + "let " + loopItemMetaVar + ": " + types.tsFunctionType(finalSeqItemKind) + " = " +
                ctx.zeroParsed(target, finalSeqItemKind, 0).code + "; void " + loopItemMetaVar + "; ";
            }
        }
        if resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER {
            decls = decls + "let " + loopValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " +
            ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; void " + loopValVar + "; ";
        }
    }
    var loopIifeBody := "";
    var left := ctx.intParsed("", 0, true, condParseStart);
    if hasActualThen {
        thenKwPos := syntax.skipTrivia(source, loopEndCursor, prefix);
        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        loopThenCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_THEN,
        iifeDepth = loopDepth, valKind = resolvedPreThenKind, valVar = loopValVar, label = loopLabel,
        iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = finalSeqItemKind,
        indexVar = loopIdxVar, hasIndex = finalIsSeqLoop);
        thenParsed := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, loopThenCtx), iifeDepth, inferMode, "branch", aliases);
        if inferMode {
            thenMarkers := loopOuterMarkers + ctx.collectParsedMarkers("", thenParsed);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenParsed.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenParsed.next), thenMarkers);
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            loopIifeBody = decls + loopStmtCode + " throw new Error(\"unreachable\");";
            left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        } else {
            thenRet := if thenParsed.kind == ir.VALUE_KIND_UNIT {
                "void (" + thenParsed.code + "); return undefined;"
            } else if thenParsed.kind == ir.VALUE_KIND_NEVER {
                "(" + thenParsed.code + "); throw new Error(\"unreachable\");"
            } else {
                "return " + thenParsed.code + ";"
            };
            loopIifeBody = decls + loopStmtCode + " " + thenRet;
            left = (kind = thenParsed.kind, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        }
    } else if inferMode {
        left = ctx.withMarkers((kind = resolvedPreThenKind, code = "", intValue = 0, textValue = "", constant = false, next = loopEndCursor), loopOuterMarkers);
    } else {
        finalRet := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
            " return undefined;"
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            " throw new Error(\"unreachable\");"
        } else {
            " return " + loopValVar + ";"
        };
        loopIifeBody = decls + loopStmtCode + finalRet;
        left = (kind = resolvedPreThenKind, code = "(() => { " + loopIifeBody + " })()",
        intValue = 0, textValue = "", constant = false, next = loopEndCursor);
    }
    afterLoopConstruct := syntax.skipTrivia(source, left.next, prefix);
    if hasActualThen and afterLoopConstruct < textLib.length(source) and textLib.wordAt(source, afterLoopConstruct, "then") {
        syntax.failAt(source, afterLoopConstruct, prefix, "duplicate then block");
    }
    if afterLoopConstruct < textLib.length(source) and textLib.wordAt(source, afterLoopConstruct, "finally") {
        loopFinCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_FINALLY,
        iifeDepth = loopDepth, valKind = resolvedPreThenKind, valVar = loopValVar, label = loopLabel,
        iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = finalSeqItemKind,
        indexVar = loopIdxVar, hasIndex = finalIsSeqLoop);
        finParsed := parseFinallyClause(target, source, afterLoopConstruct, prefix, locals, functions, params, currentName,
        ctx.appendCtx(ctxs, loopFinCtx), loopDepth, inferMode, aliases);
        left = finishFinallyIife(loopIifeBody, finParsed, left.kind, left, inferMode);
    }
    left
};

/** Parses `[@tag] if ... [else ...]` and `[@tag] match { ... }` value expressions with optional `then` and `finally`. */
parseCondExpr := fn(target: String, source: String, condParseKind: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    rawCondEnd := if condParseKind == ir.CTX_KIND_IF {
        syntax.scanRawIfChainEnd(source, condParseStart, prefix, true)
    } else {
        openMatchCheck := syntax.skipTrivia(source, condParseStart + 5, prefix);
        syntax.rejectMisplacedTag(source, openMatchCheck, prefix, "block tag cannot appear before { in match");
        if openMatchCheck >= textLib.length(source) or textLib.at(source, openMatchCheck) =!= "{" {
            syntax.unsupportedFeature(source, condParseStart, "match", prefix);
        }
        syntax.scanRawMatchEnd(source, condParseStart, prefix)
    };
    afterRawCond := if rawCondEnd >= 0 { syntax.skipTrivia(source, rawCondEnd, prefix) } else { -1 };
    hasActualThen := afterRawCond >= 0 and textLib.wordAt(source, afterRawCond, "then");
    afterOptThen := if hasActualThen { syntax.scanTrailingThenEnd(source, rawCondEnd, prefix, false) } else { rawCondEnd };
    afterOptThenTrivia := if afterOptThen >= 0 { syntax.skipTrivia(source, afterOptThen, prefix) } else { -1 };
    hasActualFinally := afterOptThenTrivia >= 0 and textLib.wordAt(source, afterOptThenTrivia, "finally");
    if hasActualFinally and target =!= ir.TARGET_TS {
        syntax.failAt(source, afterOptThenTrivia, prefix, "C backend does not support finally blocks yet");
    }
    useIifeCond := condParseTag =!= "" or hasActualThen or hasActualFinally;
    if useIifeCond and target =!= ir.TARGET_TS {
        if condParseTag =!= "" {
            syntax.failAt(source, condParseTagAt, prefix, "C backend does not support tagged conditionals yet");
        }
        syntax.failAt(source, condParseStart, prefix, "C backend does not support conditional then blocks yet");
    }
    if not useIifeCond {
        condBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = condParseKind, phase = ir.CTX_PHASE_BODY,
        iifeDepth = iifeDepth, valKind = "", valVar = "", label = "", iterLabel = "",
        countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false));
        if condParseKind == ir.CTX_KIND_IF {
            var cursor := syntax.skipTrivia(source, condParseStart + 2, prefix);
            var ifMarkers := "";
            syntax.rejectHeaderBlockTag(source, cursor, prefix, "if");
            conditionStart := cursor;
            condition := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, "", 0, condBarrierCtxs, iifeDepth, inferMode, "", aliases);
            if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, condition); }
            if condition.kind =!= ir.VALUE_KIND_BOOL {
                syntax.failAt(source, conditionStart, prefix, "if condition must be Bool");
            }
            conditionCode := if condition.constant {
                ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
            } else {
                condition.code
            };
            beforeFirstOpen := syntax.skipTrivia(source, condition.next, prefix);
            syntax.rejectMisplacedTag(source, beforeFirstOpen, prefix, "block tag cannot appear before { in if");
            cursor = syntax.expectSymbol(source, beforeFirstOpen, "{", prefix);
            first := parseBinaryCtx(target, source, cursor - 1, prefix, locals, functions, params, currentName, expected, 0, condBarrierCtxs, iifeDepth, inferMode, "branch", aliases);
            if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, first); }
            cursor = first.next;
            conditionCodes: mut List<String> = [];
            branchCodes: mut List<String> = [];
            branchKinds: mut List<String> = [];
            listLib.pushBack(mut conditionCodes, conditionCode);
            listLib.pushBack(mut branchCodes, first.code);
            listLib.pushBack(mut branchKinds, first.kind);
            var resultKind := first.kind;
            var branchCount := 1;
            loop true {
                afterBranch := syntax.skipTrivia(source, cursor, prefix);
                if not textLib.wordAt(source, afterBranch, "else") {
                    if minimum >= 0 or (minimum == -2 and resultKind =!= ir.VALUE_KIND_UNIT) {
                        syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
                    }
                    if resultKind == ir.VALUE_KIND_NEVER {
                        if expected == "" or textLib.startsWithAt(expected, 0, "TailList<") {
                            syntax.failAt(source, condParseStart, prefix, "partial conditional declaration needs a normally completing value branch; add else");
                        }
                        resultKind = expected;
                    }
                    fallback := ctx.zeroParsed(target, resultKind, cursor);
                    listLib.pushBack(mut branchCodes, fallback.code);
                    listLib.pushBack(mut branchKinds, resultKind);
                    branchCount = branchCount + 1;
                    break;
                }
                afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                if textLib.wordAt(source, afterElse, "if") {
                    elseConditionStart := syntax.skipTrivia(source, afterElse + 2, prefix);
                    syntax.rejectHeaderBlockTag(source, elseConditionStart, prefix, "else if");
                    elseCondition := parseBinaryCtx(target, source, elseConditionStart, prefix, locals, functions, params, currentName, "", 0, condBarrierCtxs, iifeDepth, inferMode, "", aliases);
                    if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, elseCondition); }
                    if elseCondition.kind =!= ir.VALUE_KIND_BOOL {
                        syntax.failAt(source, elseConditionStart, prefix, "if condition must be Bool");
                    }
                    elseConditionCode := if elseCondition.constant {
                        ir.targetBoolLiteralCode(target, elseCondition.intValue =!= 0)
                    } else {
                        elseCondition.code
                    };
                    beforeElseIfOpen := syntax.skipTrivia(source, elseCondition.next, prefix);
                    syntax.rejectMisplacedTag(source, beforeElseIfOpen, prefix, "block tag cannot appear before { in else if");
                    open := syntax.expectSymbol(source, beforeElseIfOpen, "{", prefix);
                    elseBranchStart := syntax.skipTrivia(source, open, prefix);
                    branch := parseBinaryCtx(target, source, open - 1, prefix, locals, functions, params, currentName, expected, 0, condBarrierCtxs, iifeDepth, inferMode, "branch", aliases);
                    if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, branch); }
                    joinedKind := types.joinBranchKind(resultKind, branch.kind);
                    if joinedKind == "" {
                        syntax.failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                        types.displayKind(resultKind) + " and " + types.displayKind(branch.kind));
                    }
                    resultKind = joinedKind;
                    cursor = branch.next;
                    listLib.pushBack(mut conditionCodes, elseConditionCode);
                    listLib.pushBack(mut branchCodes, branch.code);
                    listLib.pushBack(mut branchKinds, branch.kind);
                    branchCount = branchCount + 1;
                } else {
                    open := syntax.expectSymbol(source, afterElse, "{", prefix);
                    elseBranchStart := syntax.skipTrivia(source, open, prefix);
                    branch := parseBinaryCtx(target, source, open - 1, prefix, locals, functions, params, currentName, expected, 0, condBarrierCtxs, iifeDepth, inferMode, "branch", aliases);
                    if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, branch); }
                    joinedKind := types.joinBranchKind(resultKind, branch.kind);
                    if joinedKind == "" {
                        syntax.failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                        types.displayKind(resultKind) + " and " + types.displayKind(branch.kind));
                    }
                    resultKind = joinedKind;
                    cursor = branch.next;
                    listLib.pushBack(mut branchCodes, branch.code);
                    listLib.pushBack(mut branchKinds, branch.kind);
                    branchCount = branchCount + 1;
                    break;
                }
            }
            code := ctx.ternaryChainCode(target, resultKind, conditionCodes, branchCodes, branchKinds, branchCount);
            return ctx.withMarkers((kind = resultKind, code = code, intValue = 0, textValue = "", constant = false, next = cursor), ifMarkers);
        }
        openMatchPos := syntax.skipTrivia(source, condParseStart + 5, prefix);
        size := textLib.length(source);
        var cursor := syntax.skipItemSeparators(source, openMatchPos + 1, prefix);
        conditionCodes: mut List<String> = [];
        branchCodes: mut List<String> = [];
        branchKinds: mut List<String> = [];
        var matchMarkers := "";
        var resultKind := "";
        var branchCount := 0;
        var sawFallback := false;
        loop true {
            cursor = syntax.skipItemSeparators(source, cursor, prefix);
            if cursor >= size {
                syntax.failAt(source, openMatchPos, prefix, "expected } to close match");
            }
            if textLib.at(source, cursor) == "}" {
                if not sawFallback {
                    syntax.failAt(source, cursor, prefix, "subjectless match requires a final _ fallback arm");
                }
                cursor = cursor + 1;
                break;
            }
            if sawFallback {
                syntax.failAt(source, cursor, prefix, "match fallback _ must be the final arm");
            }
            afterUnderscore := syntax.skipTrivia(source, cursor + 1, prefix);
            if textLib.wordAt(source, cursor, "_") {
                syntax.rejectMisplacedTag(source, afterUnderscore, prefix, "block tag cannot appear after _ in match arm");
            }
            isFallback := textLib.wordAt(source, cursor, "_") and afterUnderscore < size and
            textLib.at(source, afterUnderscore) == "{";
            var armOpen := -1;
            if isFallback {
                armOpen = afterUnderscore;
                sawFallback = true;
            } else {
                armOpen = syntax.scanConditionOpen(source, cursor, prefix);
                if armOpen < 0 {
                    syntax.failAt(source, cursor, prefix, "expected { after match arm condition");
                }
                if armOpen == cursor {
                    syntax.failAt(source, cursor, prefix, "match arm header requires grouping for { ... } expressions");
                }
                condStart := cursor;
                syntax.rejectHeaderBlockTag(source, condStart, prefix, "match arm");
                condition := parseBinaryCtx(target, source, condStart, prefix, locals, functions, params, currentName, "", 0, condBarrierCtxs, iifeDepth, inferMode, "", aliases);
                if inferMode { matchMarkers = ctx.collectParsedMarkers(matchMarkers, condition); }
                afterCond := syntax.skipTrivia(source, condition.next, prefix);
                syntax.rejectMisplacedTag(source, afterCond, prefix, "block tag cannot appear before { in match arm");
                if afterCond > armOpen {
                    syntax.failAt(source, armOpen, prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                }
                if afterCond =!= armOpen {
                    _ := syntax.expectSymbol(source, afterCond, "{", prefix);
                }
                if condition.kind =!= ir.VALUE_KIND_BOOL {
                    syntax.failAt(source, condStart, prefix, "match arm condition must be Bool");
                }
                conditionCode := if condition.constant {
                    ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
                } else {
                    condition.code
                };
                listLib.pushBack(mut conditionCodes, conditionCode);
            }
            armBodyStart := syntax.skipTrivia(source, armOpen + 1, prefix);
            branch := parseBinaryCtx(target, source, armOpen, prefix, locals, functions, params, currentName, expected, 0, condBarrierCtxs, iifeDepth, inferMode, "branch", aliases);
            if inferMode { matchMarkers = ctx.collectParsedMarkers(matchMarkers, branch); }
            joinedKind := types.joinBranchKind(resultKind, branch.kind);
            if joinedKind == "" {
                syntax.failAt(source, armBodyStart, prefix, "value match arms must have the same kind, got " +
                types.displayKind(resultKind) + " and " + types.displayKind(branch.kind));
            }
            resultKind = joinedKind;
            listLib.pushBack(mut branchCodes, branch.code);
            listLib.pushBack(mut branchKinds, branch.kind);
            branchCount = branchCount + 1;
            cursor = branch.next;
        }
        code := ctx.ternaryChainCode(target, resultKind, conditionCodes, branchCodes, branchKinds, branchCount);
        return ctx.withMarkers((kind = resultKind, code = code, intValue = 0, textValue = "", constant = false, next = cursor), matchMarkers);
    }
    condId := ctx.nextCtxId(ctxs);
    condValVar := "lite$val" + integer.intText(condId);
    condLabel := "lite$b" + integer.intText(condId);
    condDepth := iifeDepth + 1;
    normExpected := normalizeExpectedValueKind(expected);
    condHintExpected := if hasActualThen { "" } else { normExpected };
    condTagDisplay := if condParseTag =!= "" { condParseTag } else { condParseKind };
    passCount := if inferMode { 1 } else { 2 };
    var resolvedPreThenKind := "";
    var condOuterMarkers := "";
    var condEndCursor := condParseStart;
    var condStmtCode := "";
    var pass := 1;
    loop pass <= passCount {
        isPass1 := pass == 1;
        passInfer := isPass1 or inferMode;
        passCtxValKind := if isPass1 {
            if condHintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + condHintExpected }
        } else {
            resolvedPreThenKind
        };
        condCtx := (id = condId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_BODY,
        iifeDepth = condDepth, valKind = passCtxValKind, valVar = condValVar, label = condLabel,
        iterLabel = integer.intText(ir.maxLocalLexDepth(locals) + 1), countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
        condPassCtxs := ctx.appendCtx(ctxs, condCtx);
        passBranchExpected := if isPass1 {
            condHintExpected
        } else if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            resolvedPreThenKind
        };
        var passMarkers := "";
        passCondCodes: mut List<String> = [];
        passBranchCodes: mut List<String> = [];
        passBranchKinds: mut List<String> = [];
        var passResultKind := "";
        var passBranchCount := 0;
        var passHasElse := false;
        var passPartialNoElseAt := -1;
        var cursor := 0;
        if condParseKind == ir.CTX_KIND_IF {
            cursor = syntax.skipTrivia(source, condParseStart + 2, prefix);
            syntax.rejectHeaderBlockTag(source, cursor, prefix, "if");
            condStart0 := cursor;
            cond0 := parseBinaryCtx(target, source, condStart0, prefix, locals, functions, params, currentName, "", 0, condPassCtxs, condDepth, passInfer, "", aliases);
            if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, cond0); }
            if cond0.kind =!= ir.VALUE_KIND_BOOL {
                syntax.failAt(source, condStart0, prefix, "if condition must be Bool");
            }
            cond0Code := if cond0.constant {
                ir.targetBoolLiteralCode(target, cond0.intValue =!= 0)
            } else {
                cond0.code
            };
            beforeFirstOpen := syntax.skipTrivia(source, cond0.next, prefix);
            syntax.rejectMisplacedTag(source, beforeFirstOpen, prefix, "block tag cannot appear before { in if");
            cursor = syntax.expectSymbol(source, beforeFirstOpen, "{", prefix);
            first := parseBinaryCtx(target, source, cursor - 1, prefix, locals, functions, params, currentName, passBranchExpected, 0, condPassCtxs, condDepth, passInfer, "branch", aliases);
            if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, first); }
            cursor = first.next;
            listLib.pushBack(mut passCondCodes, cond0Code);
            listLib.pushBack(mut passBranchCodes, first.code);
            listLib.pushBack(mut passBranchKinds, first.kind);
            passResultKind = first.kind;
            passBranchCount = 1;
            loop true {
                afterBranch := syntax.skipTrivia(source, cursor, prefix);
                if not textLib.wordAt(source, afterBranch, "else") {
                    if hasActualThen or minimum >= 0 {
                        syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
                    }
                    passPartialNoElseAt = afterBranch;
                    break;
                }
                afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                if textLib.wordAt(source, afterElse, "if") {
                    elseCondStart := syntax.skipTrivia(source, afterElse + 2, prefix);
                    syntax.rejectHeaderBlockTag(source, elseCondStart, prefix, "else if");
                    elseCond := parseBinaryCtx(target, source, elseCondStart, prefix, locals, functions, params, currentName, "", 0, condPassCtxs, condDepth, passInfer, "", aliases);
                    if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, elseCond); }
                    if elseCond.kind =!= ir.VALUE_KIND_BOOL {
                        syntax.failAt(source, elseCondStart, prefix, "if condition must be Bool");
                    }
                    elseCondCode := if elseCond.constant {
                        ir.targetBoolLiteralCode(target, elseCond.intValue =!= 0)
                    } else {
                        elseCond.code
                    };
                    beforeElseIfOpen := syntax.skipTrivia(source, elseCond.next, prefix);
                    syntax.rejectMisplacedTag(source, beforeElseIfOpen, prefix, "block tag cannot appear before { in else if");
                    open := syntax.expectSymbol(source, beforeElseIfOpen, "{", prefix);
                    elseBranchStart := syntax.skipTrivia(source, open, prefix);
                    branch := parseBinaryCtx(target, source, open - 1, prefix, locals, functions, params, currentName, passBranchExpected, 0, condPassCtxs, condDepth, passInfer, "branch", aliases);
                    if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, branch); }
                    joinedKind := types.joinBranchKind(passResultKind, branch.kind);
                    if joinedKind == "" {
                        syntax.failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                        types.displayKind(passResultKind) + " and " + types.displayKind(branch.kind));
                    }
                    passResultKind = joinedKind;
                    cursor = branch.next;
                    listLib.pushBack(mut passCondCodes, elseCondCode);
                    listLib.pushBack(mut passBranchCodes, branch.code);
                    listLib.pushBack(mut passBranchKinds, branch.kind);
                    passBranchCount = passBranchCount + 1;
                } else {
                    passHasElse = true;
                    open := syntax.expectSymbol(source, afterElse, "{", prefix);
                    elseBranchStart := syntax.skipTrivia(source, open, prefix);
                    branch := parseBinaryCtx(target, source, open - 1, prefix, locals, functions, params, currentName, passBranchExpected, 0, condPassCtxs, condDepth, passInfer, "branch", aliases);
                    if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, branch); }
                    joinedKind := types.joinBranchKind(passResultKind, branch.kind);
                    if joinedKind == "" {
                        syntax.failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                        types.displayKind(passResultKind) + " and " + types.displayKind(branch.kind));
                    }
                    passResultKind = joinedKind;
                    cursor = branch.next;
                    listLib.pushBack(mut passBranchCodes, branch.code);
                    listLib.pushBack(mut passBranchKinds, branch.kind);
                    passBranchCount = passBranchCount + 1;
                    break;
                }
            }
        } else {
            openMatchPos := syntax.skipTrivia(source, condParseStart + 5, prefix);
            size := textLib.length(source);
            cursor = syntax.skipItemSeparators(source, openMatchPos + 1, prefix);
            var sawFallback := false;
            loop true {
                cursor = syntax.skipItemSeparators(source, cursor, prefix);
                if cursor >= size {
                    syntax.failAt(source, openMatchPos, prefix, "expected } to close match");
                }
                if textLib.at(source, cursor) == "}" {
                    if not sawFallback {
                        syntax.failAt(source, cursor, prefix, "subjectless match requires a final _ fallback arm");
                    }
                    cursor = cursor + 1;
                    break;
                }
                if sawFallback {
                    syntax.failAt(source, cursor, prefix, "match fallback _ must be the final arm");
                }
                afterUnderscore := syntax.skipTrivia(source, cursor + 1, prefix);
                if textLib.wordAt(source, cursor, "_") {
                    syntax.rejectMisplacedTag(source, afterUnderscore, prefix, "block tag cannot appear after _ in match arm");
                }
                isFallback := textLib.wordAt(source, cursor, "_") and afterUnderscore < size and
                textLib.at(source, afterUnderscore) == "{";
                var armOpen := -1;
                if isFallback {
                    armOpen = afterUnderscore;
                    sawFallback = true;
                    passHasElse = true;
                } else {
                    armOpen = syntax.scanConditionOpen(source, cursor, prefix);
                    if armOpen < 0 {
                        syntax.failAt(source, cursor, prefix, "expected { after match arm condition");
                    }
                    if armOpen == cursor {
                        syntax.failAt(source, cursor, prefix, "match arm header requires grouping for { ... } expressions");
                    }
                    condStart := cursor;
                    syntax.rejectHeaderBlockTag(source, condStart, prefix, "match arm");
                    condParsed := parseBinaryCtx(target, source, condStart, prefix, locals, functions, params, currentName, "", 0, condPassCtxs, condDepth, passInfer, "", aliases);
                    if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, condParsed); }
                    afterCond := syntax.skipTrivia(source, condParsed.next, prefix);
                    syntax.rejectMisplacedTag(source, afterCond, prefix, "block tag cannot appear before { in match arm");
                    if afterCond > armOpen {
                        syntax.failAt(source, armOpen, prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                    }
                    if afterCond =!= armOpen {
                        _ := syntax.expectSymbol(source, afterCond, "{", prefix);
                    }
                    if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                        syntax.failAt(source, condStart, prefix, "match arm condition must be Bool");
                    }
                    condCode := if condParsed.constant {
                        ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0)
                    } else {
                        condParsed.code
                    };
                    listLib.pushBack(mut passCondCodes, condCode);
                }
                armBodyStart := syntax.skipTrivia(source, armOpen + 1, prefix);
                branch := parseBinaryCtx(target, source, armOpen, prefix, locals, functions, params, currentName, passBranchExpected, 0, condPassCtxs, condDepth, passInfer, "branch", aliases);
                if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, branch); }
                joinedKind := types.joinBranchKind(passResultKind, branch.kind);
                if joinedKind == "" {
                    syntax.failAt(source, armBodyStart, prefix, "value match arms must have the same kind, got " +
                    types.displayKind(passResultKind) + " and " + types.displayKind(branch.kind));
                }
                passResultKind = joinedKind;
                listLib.pushBack(mut passBranchCodes, branch.code);
                listLib.pushBack(mut passBranchKinds, branch.kind);
                passBranchCount = passBranchCount + 1;
                cursor = branch.next;
            }
        }
        if isPass1 {
            var bIdx := 0;
            var allBranchesNever := true;
            loop bIdx < passBranchCount {
                bKind := passBranchKinds[bIdx];
                if bKind =!= ir.VALUE_KIND_NEVER {
                    allBranchesNever = false;
                    passMarkers = passMarkers + integer.intText(condId) + "=" + bKind + "\n";
                }
                bIdx = bIdx + 1;
            }
            if passHasElse {
                resolvedPreThenKind = ctx.inferKindFromMarkers(passMarkers, condId, condTagDisplay, source, condParseTagAt, prefix, allBranchesNever);
            } else {
                partialStopped := if minimum == -1 { allBranchesNever } else { false };
                prePartial := ctx.inferKindFromMarkers(passMarkers, condId, condTagDisplay, source, condParseTagAt, prefix, partialStopped);
                if minimum == -1 {
                    if prePartial == ir.VALUE_KIND_NEVER {
                        if expected == "" or textLib.startsWithAt(expected, 0, "TailList<") {
                            syntax.failAt(source, condParseStart, prefix, "partial conditional declaration needs a normally completing value branch; add else");
                        }
                        resolvedPreThenKind = expected;
                    } else {
                        resolvedPreThenKind = prePartial;
                    }
                } else {
                    if prePartial =!= ir.VALUE_KIND_UNIT {
                        syntax.failAt(source, passPartialNoElseAt, prefix, "value if requires a final else");
                    }
                    resolvedPreThenKind = ir.VALUE_KIND_UNIT;
                }
            }
            condOuterMarkers = ctx.filterOtherMarkers(passMarkers, condId);
            condEndCursor = cursor;
        } else {
            var rawIfStmt := "";
            if condParseKind == ir.CTX_KIND_MATCH and passBranchCount == 1 and passHasElse {
                rawIfStmt = ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[0], passBranchCodes[0]);
            } else {
                condCount := if passHasElse { passBranchCount - 1 } else { passBranchCount };
                var cIdx := 0;
                loop cIdx < condCount {
                    kwPrefix := if cIdx == 0 { "if (" } else { " else if (" };
                    stmtPart := ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[cIdx], passBranchCodes[cIdx]);
                    rawIfStmt = rawIfStmt + kwPrefix + "Boolean(" + passCondCodes[cIdx] + ")) { " + stmtPart + " }";
                    cIdx = cIdx + 1;
                }
                if passHasElse {
                    elsePart := ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[passBranchCount - 1], passBranchCodes[passBranchCount - 1]);
                    rawIfStmt = rawIfStmt + " else { " + elsePart + " }";
                }
            }
            needsCondTry := condParseTag =!= "" and reach.codeUsesTextCall(rawIfStmt, "lite$throwTransfer(" + integer.intText(condId) + ",");
            if needsCondTry {
                catchAssign := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER { "" }
                else { condValVar + " = lite$transferVal;" };
                condStmtCode = "try { " + rawIfStmt + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " +
                integer.intText(condId) + ")) { " + catchAssign + " } else { throw lite$err; } }";
            } else {
                condStmtCode = rawIfStmt;
            }
        }
        pass = pass + 1;
    }
    var condIifeBody := "";
    var left := ctx.intParsed("", 0, true, condParseStart);
    if hasActualThen {
        thenKwPos := syntax.skipTrivia(source, condEndCursor, prefix);
        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        thenId := condId + 1;
        thenValVar := "lite$val" + integer.intText(thenId);
        thenLabel := "lite$b" + integer.intText(thenId);
        thenPass1ValKind := if normExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + normExpected };
        thenPass1Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
        iifeDepth = condDepth, valKind = thenPass1ValKind, valVar = thenValVar, label = thenLabel,
        iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false);
        thenPass1 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, thenPass1Ctx), condDepth, true, "tagged", aliases);
        if inferMode {
            thenMarkers := condOuterMarkers + ctx.collectParsedMarkers("", thenPass1);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenPass1.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenPass1.next), thenMarkers);
        } else {
            thenValKind := thenPass1.kind;
            thenPass2Expected := if thenValKind == ir.VALUE_KIND_UNIT or thenValKind == ir.VALUE_KIND_NEVER { "" } else { thenValKind };
            thenPass2Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
            iifeDepth = condDepth, valKind = thenValKind, valVar = thenValVar, label = thenLabel,
            iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false);
            thenPass2 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
            thenPass2Expected, 0, ctx.appendCtx(ctxs, thenPass2Ctx), condDepth, false, "tagged", aliases);
            if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                condIifeBody = condStmtCode;
                left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            } else {
                valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                    ""
                } else {
                    "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; void " + condValVar + "; "
                };
                thenRet := if thenValKind == ir.VALUE_KIND_UNIT {
                    "void (" + thenPass2.code + "); return undefined;"
                } else {
                    "return " + thenPass2.code + ";"
                };
                condIifeBody = valDecl + condStmtCode + " " + thenRet;
                left = (kind = thenValKind, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            }
        }
    } else if inferMode {
        left = ctx.withMarkers((kind = resolvedPreThenKind, code = "", intValue = 0, textValue = "", constant = false, next = condEndCursor), condOuterMarkers);
    } else {
        valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; "
        };
        finalRet := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
            " return undefined;"
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            " return " + condValVar + ";"
        };
        condIifeBody = valDecl + condStmtCode + finalRet;
        left = (kind = resolvedPreThenKind, code = "(() => { " + condIifeBody + " })()",
        intValue = 0, textValue = "", constant = false, next = condEndCursor);
    }
    afterCondConstruct := syntax.skipTrivia(source, left.next, prefix);
    if hasActualThen and afterCondConstruct < textLib.length(source) and textLib.wordAt(source, afterCondConstruct, "then") {
        syntax.failAt(source, afterCondConstruct, prefix, "duplicate then block");
    }
    if afterCondConstruct < textLib.length(source) and textLib.wordAt(source, afterCondConstruct, "finally") {
        if target =!= ir.TARGET_TS {
            syntax.failAt(source, afterCondConstruct, prefix, "C backend does not support finally blocks yet");
        }
        condFinCtx := (id = condId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_FINALLY,
        iifeDepth = condDepth, valKind = resolvedPreThenKind, valVar = condValVar, label = condLabel,
        iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
        finParsed := parseFinallyClause(target, source, afterCondConstruct, prefix, locals, functions, params, currentName,
        ctx.appendCtx(ctxs, condFinCtx), condDepth, inferMode, aliases);
        left = finishFinallyIife(condIifeBody, finParsed, left.kind, left, inferMode);
    }
    left
};

/** Parses list push/pop intrinsic operations (`push_back`, `pop_back`, `push_front`, `pop_front`). */
parseListIntrinsicCall := fn(target: String, source: String, start: Int, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    grant := ctx.parseListGrant(source, argOpen, prefix, locals, opDisplay);
    if opName == "push_back" or opName == "push_front" {
        cursor := syntax.skipTrivia(source, grant.next, prefix);
        if cursor >= textLib.length(source) or textLib.at(source, cursor) =!= "," {
            syntax.failAt(source, cursor, prefix, opDisplay + " expects a value after the mut list");
        }
        valueStart := syntax.skipTrivia(source, cursor + 1, prefix);
        elementKind := types.listElementKind(grant.kind);
        value := parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elementKind, value.kind) {
            syntax.failAt(source, valueStart, prefix, opDisplay + " element must be " + types.displayKind(elementKind) +
            ", got " + types.displayKind(value.kind));
        }
        close := ctx.expectNonemptyCallClose(source, value.next, prefix);
        method := if opName == "push_back" { ".push(" } else { ".unshift(" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = grant.runtime + method + ctx.assignValueCode(target, elementKind, value.kind, value.code) + ")",
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", value) } else { "" });
    }
    close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
    helper := if opName == "pop_back" { "lite$listPopBack(" } else { "lite$listPopFront(" };
    (kind = types.listElementKind(grant.kind), code = helper + grant.runtime + ", " + integer.intText(start) + ")",
    intValue = 0, textValue = "", constant = false, next = close)
};

/** Parses user and indirect function calls with positional, named, and `=name` shorthand arguments. */
parseUserOrIndirectCall := fn(target: String, source: String, openParen: Int, errPos: Int, isModuleFn: Bool, calleeDisplay: String, callRuntime: String, callParams: List<String>, callFirst: Int, callCount: Int, callResult: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := textLib.length(source);
    explicitLabels := syntax.collectExplicitCallLabels(source, openParen, prefix);
    argIifeDepth := if target == ir.TARGET_TS and ctx.callReordersArgs(source, openParen, prefix, callParams, callFirst, callCount) {
        iifeDepth + 1
    } else {
        iifeDepth
    };
    var callMarkers := "";
    var slotEntry: List<Int> = [];
    var slotExplicit: List<Bool> = [];
    initSlots: mut List<Int> = [];
    initExplicit: mut List<Bool> = [];
    var initIdx := 0;
    loop initIdx < callCount {
        listLib.pushBack(mut initSlots, -1);
        listLib.pushBack(mut initExplicit, false);
        initIdx = initIdx + 1;
    }
    slotEntry = initSlots;
    slotExplicit = initExplicit;
    entryPositions: mut List<Int> = [];
    entrySlots: mut List<Int> = [];
    entryKinds: mut List<String> = [];
    entryCodes: mut List<String> = [];
    var entryCount := 0;
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    if cursor < size and textLib.at(source, cursor) =!= ")" {
        loop true {
            if syntax.isSingleEquals(source, cursor) {
                argNameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if argNameStart >= size or not textLib.isNameStart(textLib.at(source, argNameStart)) {
                    syntax.failAt(source, argNameStart, prefix, "expected parameter name after =");
                }
                argNameEnd := textLib.skipName(source, argNameStart);
                label := textLib.slice(source, argNameStart, argNameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, argNameStart, label, prefix); }
                afterIdent := syntax.skipTrivia(source, argNameEnd, prefix);
                if afterIdent < size and textLib.at(source, afterIdent) =!= "," and textLib.at(source, afterIdent) =!= ")" {
                    syntax.failAt(source, afterIdent, prefix, "shorthand argument requires a bare identifier");
                }
                slot := ctx.findParamSlot(callParams, callFirst, callCount, label);
                if slot < 0 {
                    syntax.failAt(source, argNameStart, prefix, "unknown parameter " + label + " in call to " + calleeDisplay);
                }
                if slotExplicit[slot] {
                    syntax.failAt(source, argNameStart, prefix, "duplicate named argument " + label + " in call to " + calleeDisplay);
                }
                slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                argExpected := types.paramKindOf(callParams[callFirst + slot]);
                arg := parseBinaryCtx(target, source, argNameStart, prefix, locals, functions, params, currentName, argExpected, 30, ctxs, argIifeDepth, inferMode, "", aliases);
                if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                listLib.pushBack(mut entryPositions, argNameStart);
                listLib.pushBack(mut entrySlots, slot);
                listLib.pushBack(mut entryKinds, arg.kind);
                listLib.pushBack(mut entryCodes, arg.code);
                entryCount += 1;
                cursor = syntax.skipTrivia(source, arg.next, prefix);
            } else {
                var namedLabel := "";
                var rhsStart := -1;
                if cursor < size and textLib.isNameStart(textLib.at(source, cursor)) {
                    labelEnd := textLib.skipName(source, cursor);
                    afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
                    if syntax.isSingleEquals(source, afterLabel) {
                        namedLabel = textLib.slice(source, cursor, labelEnd);
                        rhsStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
                    }
                }
                if namedLabel =!= "" {
                    if syntax.isReservedWord(namedLabel) { syntax.unsupportedFeature(source, cursor, namedLabel, prefix); }
                    slot := ctx.findParamSlot(callParams, callFirst, callCount, namedLabel);
                    if slot < 0 {
                        syntax.failAt(source, cursor, prefix, "unknown parameter " + namedLabel + " in call to " + calleeDisplay);
                    }
                    if slotExplicit[slot] {
                        syntax.failAt(source, cursor, prefix, "duplicate named argument " + namedLabel + " in call to " + calleeDisplay);
                    }
                    slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                    slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                    argExpected := types.paramKindOf(callParams[callFirst + slot]);
                    arg := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                    if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                    listLib.pushBack(mut entryPositions, rhsStart);
                    listLib.pushBack(mut entrySlots, slot);
                    listLib.pushBack(mut entryKinds, arg.kind);
                    listLib.pushBack(mut entryCodes, arg.code);
                    entryCount += 1;
                    cursor = syntax.skipTrivia(source, arg.next, prefix);
                } else {
                    var nextSlot := -1;
                    var scan := 0;
                    loop scan < callCount {
                        if slotEntry[scan] < 0 {
                            nextSlot = scan;
                            break;
                        }
                        scan += 1;
                    }
                    if nextSlot < 0 {
                        suffix := if callCount == 1 { " argument" } else { " arguments" };
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(callCount) + suffix + ", got more");
                    }
                    slotName := types.paramNameOf(callParams[callFirst + nextSlot]);
                    posExpected := if listLib.listContainsText(explicitLabels, slotName) { "" } else { types.paramKindOf(callParams[callFirst + nextSlot]) };
                    slotEntry = ctx.setIntAt(slotEntry, nextSlot, entryCount);
                    arg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, posExpected, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                    if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                    listLib.pushBack(mut entryPositions, cursor);
                    listLib.pushBack(mut entrySlots, nextSlot);
                    listLib.pushBack(mut entryKinds, arg.kind);
                    listLib.pushBack(mut entryCodes, arg.code);
                    entryCount += 1;
                    cursor = syntax.skipTrivia(source, arg.next, prefix);
                }
            }
            if cursor < size and textLib.at(source, cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor < size and textLib.at(source, cursor) == ")" { break; }
            } else {
                break;
            }
        }
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    var filledCount := 0;
    var checkSlot := 0;
    loop checkSlot < callCount {
        if slotEntry[checkSlot] >= 0 { filledCount += 1; }
        checkSlot += 1;
    }
    if filledCount =!= callCount {
        suffix := if callCount == 1 { " argument" } else { " arguments" };
        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(callCount) +
        suffix + ", got " + formatLib.decimalText(filledCount));
    }
    var isIdentityOrder := entryCount == callCount;
    var slotIdx := 0;
    loop slotIdx < callCount {
        k := slotEntry[slotIdx];
        if k =!= slotIdx { isIdentityOrder = false; }
        argExpected := types.paramKindOf(callParams[callFirst + slotIdx]);
        if not types.isCompatibleKind(argExpected, entryKinds[k]) {
            syntax.failAt(source, entryPositions[k], prefix, "argument " + formatLib.decimalText(slotIdx + 1) + " of " +
            calleeDisplay + " must be " + types.displayKind(argExpected) + ", got " + types.displayKind(entryKinds[k]));
        }
        slotIdx += 1;
    }
    var emittedCode := "";
    var emittedResultKind := callResult;
    if isIdentityOrder {
        finalArgs: mut List<String> = [];
        var pIdx := 0;
        loop pIdx < callCount {
            argExpected := types.paramKindOf(callParams[callFirst + pIdx]);
            listLib.pushBack(mut finalArgs, ctx.assignValueCode(target, argExpected, entryKinds[pIdx], entryCodes[pIdx]));
            pIdx = pIdx + 1;
        }
        targetCallee := if isModuleFn { callRuntime } else { "(" + callRuntime + ")" };
        emittedCode = targetCallee + "(" + textLib.joinTexts(finalArgs, ", ") + ")";
    } else {
        if target =!= ir.TARGET_TS {
            syntax.failAt(source, errPos, prefix, "C backend does not support named or reordered call arguments yet");
        }
        evalStmts: mut List<String> = [];
        if not isModuleFn {
            listLib.pushBack(mut evalStmts, "const lite$fn = " + callRuntime + ";");
        }
        var callDiverged := false;
        var kIdx := 0;
        loop kIdx < entryCount {
            if not callDiverged {
                targetSlot := entrySlots[kIdx];
                if entryKinds[kIdx] == ir.VALUE_KIND_NEVER {
                    listLib.pushBack(mut evalStmts, "return " + entryCodes[kIdx] + ";");
                    callDiverged = true;
                } else if slotEntry[targetSlot] == kIdx {
                    temp := "lite$arg" + integer.intText(kIdx);
                    argExpected := types.paramKindOf(callParams[callFirst + targetSlot]);
                    listLib.pushBack(mut evalStmts, "const " + temp + " = " + ctx.assignValueCode(target, argExpected, entryKinds[kIdx], entryCodes[kIdx]) + ";");
                } else {
                    listLib.pushBack(mut evalStmts, "void (" + entryCodes[kIdx] + ");");
                }
            }
            kIdx = kIdx + 1;
        }
        if callDiverged {
            emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " })()";
            emittedResultKind = ir.VALUE_KIND_NEVER;
        } else {
            slotTemps: mut List<String> = [];
            var sIdx := 0;
            loop sIdx < callCount {
                listLib.pushBack(mut slotTemps, "lite$arg" + integer.intText(slotEntry[sIdx]));
                sIdx = sIdx + 1;
            }
            targetCallee := if isModuleFn { callRuntime } else { "lite$fn" };
            callExpr := targetCallee + "(" + textLib.joinTexts(slotTemps, ", ") + ")";
            retStmt := if callResult == ir.VALUE_KIND_UNIT { "void (" + callExpr + "); return undefined;" } else { "return " + callExpr + ";" };
            emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " " + retStmt + " })()";
        }
    }
    ctx.withMarkers((kind = emittedResultKind, code = emittedCode, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers)
};

/** Parses postfix `.field`, `[index]`, list-intrinsic operations, and function/indirect calls on `initialLeft`. */
parsePostfixChain := fn(target: String, source: String, exprStart: Int, initialLeft: Parsed, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var left := initialLeft;
    loop true {
        if left.next > 0 and textLib.at(source, left.next - 1) == "}" { break; }
        postPosition := syntax.skipTrivia(source, left.next, prefix);
        if postPosition < textLib.length(source) and textLib.at(source, postPosition) == "." {
            labelStart := syntax.skipTrivia(source, postPosition + 1, prefix);
            if labelStart < textLib.length(source) and textLib.isDigit(textLib.at(source, labelStart)) {
                var end := labelStart;
                var fieldIndex := 0;
                loop end < textLib.length(source) and textLib.isDigit(textLib.at(source, end)) {
                    fieldIndex = fieldIndex * 10 + syntax.decimalDigit(textLib.at(source, end));
                    end = end + 1;
                }
                if types.isArrayKind(left.kind) {
                    if fieldIndex >= types.arrayExtent(left.kind) {
                        syntax.failAt(source, labelStart, prefix, "array index " + textLib.slice(source, labelStart, end) + " out of bounds");
                    }
                    left = ctx.withMarkers((kind = types.arrayElementKind(left.kind), code = "(" + left.code + ")[" + integer.intText(fieldIndex) + "]!",
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                } else if types.isRecordKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "record values do not support positional field access ." + textLib.slice(source, labelStart, end));
                } else if not types.isTupleKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "field access requires a tuple or module value");
                } else {
                    comp := types.tupleComponent(left.kind, fieldIndex);
                    if comp.kind == "" {
                        syntax.failAt(source, labelStart, prefix, "tuple has no field " + textLib.slice(source, labelStart, end));
                    }
                    left = ctx.withMarkers((kind = comp.kind, code = "(" + left.code + ")." + comp.prop,
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                }
            } else if labelStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, labelStart)) {
                break;
            } else {
                labelEnd := textLib.skipName(source, labelStart);
                label := textLib.slice(source, labelStart, labelEnd);
                if left.kind == ir.VALUE_KIND_MODULE {
                    qualified := left.textValue + "." + label;
                    functionIndex := ir.findFunction(functions, qualified);
                    if functionIndex >= 0 {
                        left = (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = integer.intText(exprStart), intValue = functionIndex, textValue = qualified,
                        constant = false, next = labelEnd);
                    } else {
                        afterMemberLabel := syntax.skipTrivia(source, labelEnd, prefix);
                        if afterMemberLabel < textLib.length(source) and textLib.at(source, afterMemberLabel) == "{" and types.findAlias(aliases, qualified) >= 0 {
                            var modRecKind := "";
                            if inferMode {
                                emptySeen: List<String> = [];
                                canRes := types.canResolveTypeAt(qualified, 0, prefix, aliases, "", emptySeen, 32);
                                if not canRes.ok or not types.isRecordKind(canRes.kind) {
                                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                }
                                modRecKind = canRes.kind;
                            } else {
                                emptySeen: List<String> = [];
                                modRecKind = types.resolveAliasKind(source, labelStart, prefix, aliases, qualified, emptySeen);
                                if not types.isRecordKind(modRecKind) {
                                    syntax.failAt(source, labelStart, prefix, "record construction requires a record type, got " + types.displayKind(modRecKind));
                                }
                            }
                            left = parseRecordLiteral(target, source, afterMemberLabel, prefix, locals, functions, params, currentName, modRecKind, ctxs, iifeDepth, inferMode, aliases);
                        } else {
                            memberIndex := ir.localIndex(locals, qualified);
                            if memberIndex < 0 {
                                syntax.failAt(source, labelStart, prefix, "unknown module member " + qualified);
                            }
                            if syntax.isSingleEquals(source, syntax.skipTrivia(source, labelEnd, prefix)) {
                                syntax.failAt(source, labelStart, prefix, "module members are immutable");
                            }
                            member := locals[memberIndex];
                            left = (kind = member.kind, code = member.runtime, intValue = member.intValue,
                            textValue = member.textValue, constant = member.constant, next = labelEnd);
                        }
                    }
                } else if types.isRecordKind(left.kind) {
                    fieldKind := types.recordFieldKind(left.kind, label);
                    if fieldKind == "" {
                        syntax.failAt(source, labelStart, prefix, "record " + types.recordDisplayName(left.kind) + " has no field " + label);
                    }
                    prop := types.recordComponentProp(left.kind, label);
                    left = ctx.withMarkers((kind = fieldKind, code = "(" + left.code + ")." + prop,
                    intValue = 0, textValue = "", constant = false, next = labelEnd),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                } else {
                    if not types.isTupleKind(left.kind) {
                        syntax.failAt(source, postPosition, prefix, "field access requires a tuple or module value");
                    }
                    fieldKind := types.tupleFieldKind(left.kind, label);
                    if fieldKind == "" {
                        syntax.failAt(source, labelStart, prefix, "tuple has no field " + label);
                    }
                    left = ctx.withMarkers((kind = fieldKind, code = "(" + left.code + ")." + label,
                    intValue = 0, textValue = "", constant = false, next = labelEnd),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                }
            }
        } else if postPosition < textLib.length(source) and textLib.at(source, postPosition) == "[" {
            if not types.isListKind(left.kind) and not types.isArrayKind(left.kind) {
                syntax.failAt(source, postPosition, prefix, "indexing requires a list value");
            }
            indexStart := syntax.skipTrivia(source, postPosition + 1, prefix);
            index := parseBinaryCtx(target, source, indexStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
            if index.kind =!= ir.VALUE_KIND_INT {
                syntax.failAt(source, indexStart, prefix, "list index must be Int, got " + types.displayKind(index.kind));
            }
            close := syntax.skipTrivia(source, index.next, prefix);
            next := syntax.expectSymbol(source, close, "]", prefix);
            elemKind := if types.isListKind(left.kind) { types.listElementKind(left.kind) } else { types.arrayElementKind(left.kind) };
            left = ctx.withMarkers((kind = elemKind,
            code = "lite$listAt((" + left.code + "), " + index.code + ", " + integer.intText(indexStart) + ")",
            intValue = 0, textValue = "", constant = false, next = next),
            if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", left), index) } else { "" });
        } else if left.kind == ir.VALUE_KIND_LIST_OP {
            left = parseListIntrinsicCall(target, source, exprStart, left.next, left.textValue, left.code, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
        } else if left.kind == ir.VALUE_KIND_MODULE_FUNCTION or (types.isFnKind(left.kind) and postPosition < textLib.length(source) and textLib.at(source, postPosition) == "(") {
            isModuleFn := left.kind == ir.VALUE_KIND_MODULE_FUNCTION;
            var handleUserCall := not isModuleFn;
            var callParams: List<String> = params;
            var callFirst := 0;
            var callCount := 0;
            var callResult := "";
            var callRuntime := left.code;
            var calleeDisplay := types.displayKind(left.kind);
            var errPos := postPosition;
            if isModuleFn {
                info := functions[left.intValue];
                calleeDisplay = left.textValue;
                errPos = if left.code =!= "" { syntax.parseDigits(left.code, 0, textLib.length(left.code)) } else { exprStart };
                var listOpName := "";
                var listOpDisplay := "";
                if info.runtime == "lite$core$list$pushBack:v1" { listOpName = "push_back"; listOpDisplay = "pushBack"; }
                else if info.runtime == "lite$core$list$popBack:v1" { listOpName = "pop_back"; listOpDisplay = "popBack"; }
                else if info.runtime == "lite$core$list$pushFront:v1" { listOpName = "push_front"; listOpDisplay = "pushFront"; }
                else if info.runtime == "lite$core$list$popFront:v1" { listOpName = "pop_front"; listOpDisplay = "popFront"; }
                if listOpName =!= "" {
                    left = parseListIntrinsicCall(target, source, exprStart, postPosition, listOpName, listOpDisplay, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
                } else if info.count < 0 {
                    syntax.failAt(source, errPos, prefix, "host output functions are standalone statements");
                } else if postPosition >= textLib.length(source) or textLib.at(source, postPosition) =!= "(" {
                    if textLib.startsWithAt(info.runtime, 0, "lite$") or target =!= ir.TARGET_TS {
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " must be called");
                    }
                    fnValKind := types.fnCanonicalKind(params, info.first, info.count, info.result);
                    left = (kind = fnValKind, code = info.runtime, intValue = 0, textValue = "", constant = false, next = left.next);
                } else if textLib.startsWithAt(info.runtime, 0, "lite$") {
                    var cursor := syntax.skipTrivia(source, postPosition + 1, prefix);
                    argumentCodes: mut List<String> = [];
                    var callMarkers := "";
                    var argumentCount := 0;
                    size := textLib.length(source);
                    if cursor < size and textLib.at(source, cursor) =!= ")" {
                        loop true {
                            isNamed := if syntax.isSingleEquals(source, cursor) { true }
                            else if cursor < size and textLib.isNameStart(textLib.at(source, cursor)) {
                                syntax.isSingleEquals(source, syntax.skipTrivia(source, textLib.skipName(source, cursor), prefix))
                            } else { false };
                            if isNamed {
                                syntax.failAt(source, cursor, prefix, "named arguments are not supported for host function " + calleeDisplay);
                            }
                            if argumentCount >= info.count {
                                suffix := if info.count == 1 { " argument" } else { " arguments" };
                                syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(info.count) + suffix + ", got more");
                            }
                            argExpected := types.paramKindOf(params[info.first + argumentCount]);
                            argument := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                            if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, argument); }
                            if not types.isCompatibleKind(argExpected, argument.kind) {
                                syntax.failAt(source, cursor, prefix, "argument " + formatLib.decimalText(argumentCount + 1) + " of " + calleeDisplay +
                                " must be " + types.displayKind(argExpected) + ", got " + types.displayKind(argument.kind));
                            }
                            listLib.pushBack(mut argumentCodes, ctx.assignValueCode(target, argExpected, argument.kind, argument.code));
                            argumentCount = argumentCount + 1;
                            cursor = syntax.skipTrivia(source, argument.next, prefix);
                            if cursor < size and textLib.at(source, cursor) == "," {
                                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                                if cursor < size and textLib.at(source, cursor) == ")" { break; }
                            } else {
                                break;
                            }
                        }
                    }
                    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
                    optionalPrompt := info.runtime == "lite$inputAll" or info.runtime == "lite$inputLine" or
                    info.runtime == "lite$inputInt" or info.runtime == "lite$inputFloat";
                    optionalExit := info.runtime == "lite$exit";
                    if argumentCount =!= info.count and not ((optionalPrompt or optionalExit) and argumentCount == 0) {
                        suffix := if info.count == 1 { " argument" } else { " arguments" };
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(info.count) +
                        suffix + ", got " + formatLib.decimalText(argumentCount));
                    }
                    if optionalExit and argumentCount == 0 {
                        listLib.pushBack(mut argumentCodes, ir.targetIntLiteralCode(target, 0, false, "0"));
                    }
                    if optionalPrompt {
                        if argumentCount == 0 { listLib.pushBack(mut argumentCodes, "undefined"); }
                        place := sourceLib.lineColumn(source, errPos);
                        location := (if prefix == "" { "" } else { prefix + ":" }) + formatLib.decimalText(place.line) + ":" +
                        formatLib.decimalText(place.column) + ": InputFault: ";
                        listLib.pushBack(mut argumentCodes, ir.targetTextLiteralCode(target, location));
                    }
                    if info.runtime == "lite$textAt" or info.runtime == "lite$textSlice" {
                        listLib.pushBack(mut argumentCodes, integer.intText(errPos));
                    }
                    callResultKind := if optionalExit { ir.VALUE_KIND_NEVER } else { info.result };
                    left = ctx.withMarkers((kind = callResultKind, code = info.runtime + "(" + textLib.joinTexts(argumentCodes, ", ") + ")",
                    intValue = 0, textValue = "", constant = false, next = cursor), callMarkers);
                } else {
                    handleUserCall = true;
                    callFirst = info.first;
                    callCount = info.count;
                    callResult = info.result;
                    callRuntime = info.runtime;
                }
            } else {
                if target =!= ir.TARGET_TS {
                    syntax.failAt(source, postPosition, prefix, "C backend does not support indirect function calls yet");
                }
                callParams = types.fnParamEntries(left.kind);
                callFirst = 0;
                callCount = types.fnParamCount(left.kind);
                callResult = types.fnResultKind(left.kind);
            }
            if handleUserCall {
                left = parseUserOrIndirectCall(target, source, postPosition, errPos, isModuleFn, calleeDisplay, callRuntime,
                callParams, callFirst, callCount, callResult, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
            }
        } else if postPosition < textLib.length(source) and textLib.at(source, postPosition) == "(" {
            syntax.failAt(source, postPosition, prefix, "cannot call non-function value of type " + types.displayKind(left.kind));
        } else {
            break;
        }
    }
    left
};

/** Parses binary operators (`**`, `*`, `+`, comparisons and chains, `and`/`or`) above `effectiveMinimum` by precedence climbing. */
parseBinaryOperatorChain := fn(target: String, source: String, exprStart: Int, initialLeft: Parsed, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, effectiveMinimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var left := initialLeft;
    loop true {
        if left.next > 0 and textLib.at(source, left.next - 1) == "}" { break; }
        operatorPosition := syntax.skipTrivia(source, left.next, prefix);
        if operatorPosition >= textLib.length(source) { break; }
        operator := syntax.readOperator(source, operatorPosition);
        if operator.text == "" { break; }
        level := syntax.operatorLevel(operator.text);
        if level < effectiveMinimum { break; }
        if operator.text == "**" {
            var signPosition := exprStart;
            loop signPosition < textLib.length(source) and (textLib.at(source, signPosition) == "+" or textLib.at(source, signPosition) == "-") {
                if textLib.at(source, signPosition) == "-" {
                    syntax.failAt(source, operatorPosition, prefix, "group a negative power base as (-base) or negate the completed power as -(base ** exponent)");
                }
                signPosition = syntax.skipTrivia(source, signPosition + 1, prefix);
            }
        }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := parseBinaryCtx(target, source, operatorPosition + operator.width, prefix, locals, functions, params, currentName, "", rightMinimum, ctxs, iifeDepth, inferMode, "", aliases);
        var opMarkers := if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", left), right) } else { "" };
        leftLoopId := types.loopValMarkerId(left.kind);
        rightLoopId := types.loopValMarkerId(right.kind);
        if inferMode and (leftLoopId >= 0 or rightLoopId >= 0) {
            if leftLoopId >= 0 and rightLoopId >= 0 {
                if operator.text == "and" or operator.text == "or" {
                    opMarkers = opMarkers + integer.intText(leftLoopId) + "=Bool\n" + integer.intText(rightLoopId) + "=Bool\n";
                    left = ctx.boolParsed("", false, false, right.next);
                } else if syntax.isComparison(operator.text) {
                    var chainEnd := right.next;
                    var nextPos := syntax.skipTrivia(source, chainEnd, prefix);
                    var nextOp := syntax.comparisonOperatorAt(source, nextPos);
                    loop syntax.isComparison(nextOp.text) {
                        operand := parseBinaryCtx(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                        opMarkers = ctx.collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = syntax.skipTrivia(source, chainEnd, prefix);
                        nextOp = syntax.comparisonOperatorAt(source, nextPos);
                    }
                    left = ctx.boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    left = (kind = ir.VALUE_KIND_FLOAT, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else {
                    left = (kind = left.kind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                }
            } else {
                targetLoopId := if leftLoopId >= 0 { leftLoopId } else { rightLoopId };
                peerKind := if leftLoopId >= 0 { right.kind } else { left.kind };
                if operator.text == "and" or operator.text == "or" {
                    if peerKind =!= ir.VALUE_KIND_BOOL {
                        syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=Bool\n";
                    left = ctx.boolParsed("", false, false, right.next);
                } else if syntax.isComparison(operator.text) {
                    if peerKind == ir.VALUE_KIND_NEVER { syntax.failAt(source, operatorPosition, prefix, "cannot compare Never values"); }
                    if types.isTupleKind(peerKind) { syntax.failAt(source, operatorPosition, prefix, "cannot compare tuple values"); }
                    if types.isListKind(peerKind) { syntax.failAt(source, operatorPosition, prefix, "cannot compare list values"); }
                    if types.isFnKind(peerKind) { syntax.failAt(source, operatorPosition, prefix, "cannot compare function values"); }
                    if operator.text =!= "==" and operator.text =!= "=!=" and not numeric.isNumericKind(peerKind) {
                        syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    var chainEnd := right.next;
                    var nextPos := syntax.skipTrivia(source, chainEnd, prefix);
                    var nextOp := syntax.comparisonOperatorAt(source, nextPos);
                    loop syntax.isComparison(nextOp.text) {
                        operand := parseBinaryCtx(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                        opMarkers = ctx.collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = syntax.skipTrivia(source, chainEnd, prefix);
                        nextOp = syntax.comparisonOperatorAt(source, nextPos);
                    }
                    left = ctx.boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    if not numeric.isNumericKind(peerKind) {
                        syntax.failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = ir.VALUE_KIND_FLOAT, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if operator.text == "+" and peerKind == ir.VALUE_KIND_STRING {
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=String\n";
                    left = ctx.textParsed("", "", false, right.next);
                } else if numeric.isNumericKind(peerKind) {
                    if not numeric.isIntKind(peerKind) and operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                        syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = peerKind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if types.isListKind(peerKind) {
                    syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
                } else if operator.text == "+" {
                    syntax.failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
                } else {
                    syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                }
            }
        } else if operator.text == "and" or operator.text == "or" {
            if left.kind =!= ir.VALUE_KIND_BOOL or right.kind =!= ir.VALUE_KIND_BOOL {
                syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
            }
            if left.constant and right.constant {
                value := if operator.text == "and" {
                    left.intValue =!= 0 and right.intValue =!= 0
                } else {
                    left.intValue =!= 0 or right.intValue =!= 0
                };
                left = ctx.boolParsed(ir.targetBoolLiteralCode(target, value), value, true, right.next);
            } else {
                left = ctx.boolParsed(ir.targetLogicCode(target, operator.text, left.code, right.code), false, false, right.next);
            }
        } else if syntax.isComparison(operator.text) {
            firstPair := ctx.compareParsed(target, source, operatorPosition, operator.text, left, right, prefix);
            var nextPosition := syntax.skipTrivia(source, right.next, prefix);
            var nextOperator := syntax.comparisonOperatorAt(source, nextPosition);
            if not syntax.isComparison(nextOperator.text) {
                left = firstPair;
            } else {
                codes: mut List<String> = [left.code, right.code];
                kinds: mut List<String> = [left.kind, right.kind];
                operators: mut List<String> = [operator.text];
                var count := 1;
                var previous := right;
                var end := right.next;
                var constant := left.constant and right.constant;
                var value := firstPair.intValue =!= 0;
                loop syntax.isComparison(nextOperator.text) {
                    operand := parseBinaryCtx(target, source, nextPosition + nextOperator.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                    if inferMode { opMarkers = ctx.collectParsedMarkers(opMarkers, operand); }
                    pair := ctx.compareParsed(target, source, nextPosition, nextOperator.text, previous, operand, prefix);
                    listLib.pushBack(mut codes, operand.code);
                    listLib.pushBack(mut kinds, operand.kind);
                    listLib.pushBack(mut operators, nextOperator.text);
                    constant = constant and operand.constant;
                    if constant { value = value and pair.intValue =!= 0; }
                    count = count + 1;
                    previous = operand;
                    end = operand.next;
                    nextPosition = syntax.skipTrivia(source, end, prefix);
                    nextOperator = syntax.comparisonOperatorAt(source, nextPosition);
                }
                if constant { left = ctx.boolParsed(ir.targetBoolLiteralCode(target, value), value, true, end); }
                else { left = ctx.boolParsed(ir.targetComparisonChainCode(target, codes, kinds, operators, count, operatorPosition), false, false, end); }
            }
        } else if operator.text == "**" {
            if not numeric.isNumericKind(left.kind) or not numeric.isNumericKind(right.kind) {
                syntax.failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
            }
            code := ir.targetFloatPowerCode(target, ir.targetFloatOperandCode(target, left.kind, left.code), ir.targetFloatOperandCode(target, right.kind, right.code), operatorPosition);
            left = (kind = ir.VALUE_KIND_FLOAT, code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind) {
            promoted := numeric.promoteNumericKind(left.kind, right.kind);
            if left.constant and right.constant {
                folded := ctx.tryFoldInteger(operator.text, left.intValue, right.intValue);
                if folded.ok and numeric.intKindFits(promoted, folded.value) {
                    code := if (operator.text == "%" or operator.text == ":%") and left.intValue == integer.intMin and right.intValue == -1 {
                        ir.targetIntLiteralCode(target, 0, false, "0")
                    } else if operator.text == ":/" { ir.targetFloorDivCode(target, left.code, right.code) }
                    else if operator.text == ":%" { ir.targetFloorModCode(target, left.code, right.code) }
                    else { "(" + left.code + " " + operator.text + " " + right.code + ")" };
                    left = ctx.typedIntParsed(promoted, code, folded.value, true, right.next);
                } else {
                    left = ctx.typedIntParsed(promoted, ctx.runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
                }
            } else {
                left = ctx.typedIntParsed(promoted, ctx.runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
            }
        } else if operator.text == "+" and left.kind == ir.VALUE_KIND_STRING and right.kind == ir.VALUE_KIND_STRING {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = ctx.textParsed(ir.targetTextLiteralCode(target, combined), combined, true, right.next);
            } else {
                left = ctx.textParsed(ir.targetConcatCode(target, left.code, right.code), "", false, right.next);
            }
        } else if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
            if operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
            }
            promotedFloat := numeric.promoteNumericKind(left.kind, right.kind);
            floatKind := if promotedFloat =!= "" { promotedFloat } else if numeric.isFloatKind(left.kind) { left.kind } else { right.kind };
            code := if floatKind == ir.VALUE_KIND_FLOAT32 {
                ir.targetFloat32BinaryCode(target, operator.text, ir.targetFloat32OperandCode(target, left.kind, left.code), ir.targetFloat32OperandCode(target, right.kind, right.code), operatorPosition)
            } else {
                ir.targetFloatBinaryCode(target, operator.text, ir.targetFloatOperandCode(target, left.kind, left.code), ir.targetFloatOperandCode(target, right.kind, right.code), operatorPosition)
            };
            left = (kind = floatKind, code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if types.isListKind(left.kind) or types.isListKind(right.kind) {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if operator.text == "+" {
            syntax.failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            syntax.failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
        if inferMode and opMarkers =!= "" { left = ctx.withMarkers(left, opMarkers); }
    }
    left
};

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`, with construct context tracking. */
pub parseBinaryCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    sourceSize := textLib.length(source);
    var start := syntax.skipTrivia(source, position, prefix);
    if start >= sourceSize {
        syntax.failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    effectiveMinimum := if minimum < 0 { 0 } else { minimum };
    var leaderStart := -1;
    var leaderText := "";
    if effectiveMinimum == 0 and (textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or")) {
        leaderStart = start;
        leaderEnd := textLib.skipName(source, start);
        leaderText = textLib.slice(source, start, leaderEnd);
        start = syntax.skipTrivia(source, leaderEnd, prefix);
        if textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or") {
            syntax.failAt(source, start, prefix, "leading " + leaderText + " may appear only once");
        }
    }
    var left := ctx.intParsed("", 0, true, start);
    ch := textLib.at(source, start);
    if ch == "(" {
        left = parseParenOrTupleExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "+" or ch == "-" {
        left = parseUnarySignExpr(target, source, start, ch, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if textLib.isDigit(ch) {
        left = syntax.parseNumber(target, source, start, prefix, expected, minimum);
    } else if ch == "\"" {
        left = syntax.parseText(target, source, start, prefix);
    } else if ch == "[" {
        left = parseListOrArrayExpr(target, source, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "@" {
        left = parseTagPrefixExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "{" {
        if bodySink == "" and types.isRecordKind(expected) {
            left = parseRecordLiteral(target, source, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
        } else {
            left = parseBlockExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, bodySink, aliases);
        }
    } else if textLib.isNameStart(ch) {
        left = parseNamedPrimaryExpr(target, source, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    } else if ch == "." {
        left = resolveLeadingDotExpr(target, source, start, prefix, expected, ctxs);
    } else {
        syntax.failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    left = parsePostfixChain(target, source, start, left, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    left = parseBinaryOperatorChain(target, source, start, left, prefix, locals, functions, params, currentName, effectiveMinimum, ctxs, iifeDepth, inferMode, aliases);
    if leaderStart >= 0 and left.kind =!= ir.VALUE_KIND_BOOL {
        syntax.failAt(source, leaderStart, prefix, "leading " + leaderText + " requires a Bool expression");
    }
    left
};

/** Parses one expression with an empty construct context stack. */
pub parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    emptyAliases: List<AliasDecl> = [];
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, minimum, [], 0, false, "", emptyAliases)
};

/** Parses one complete expression at the lowest precedence with construct contexts and an optional contextual kind. */
pub parseExpressionAsCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, 0, ctxs, 0, false, "", aliases)
};

/** Parses one statement-level expression with construct contexts, allowing unit-producing tagged conditionals without else. */
pub parseStatementExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, -2, ctxs, 0, false, "", aliases)
};

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
pub parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, 0)
};

/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
pub parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, "", 0, ctxs, 0, false, "", aliases)
};

/** Parses one complete expression at the lowest precedence without a contextual kind. */
pub parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, "", 0)
};

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
pub parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    var inner := syntax.skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = syntax.skipTrivia(source, inner + 1, prefix);
    }
    if not textLib.wordAt(source, inner, "if") { return []; }
    result: mut List<Item> = [];
    var cursor := syntax.skipTrivia(source, inner + 2, prefix);
    var isFirst := true;
    loop true {
        syntax.rejectHeaderBlockTag(source, cursor, prefix, if isFirst { "if" } else { "else if" });
        conditionStart := cursor;
        condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, params, currentName, ctxs, aliases);
        if condition.kind =!= ir.VALUE_KIND_BOOL {
            syntax.failAt(source, conditionStart, prefix, "if condition must be Bool");
        }
        conditionCode := if condition.constant {
            ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
        } else {
            condition.code
        };
        beforeOpen := syntax.skipTrivia(source, condition.next, prefix);
        syntax.rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in if");
        open := syntax.expectSymbol(source, beforeOpen, "{", prefix);
        branchStart := syntax.skipTrivia(source, open, prefix);
        branch := parseExpressionAsCtx(target, source, branchStart, prefix, locals, functions, params, currentName, targetKind, ctxs, aliases);
        if not types.isCompatibleKind(targetKind, branch.kind) {
            syntax.failAt(source, targetAt, prefix, "cannot assign " + types.displayKind(branch.kind) + " to " + types.displayKind(targetKind) + " local " + targetName);
        }
        cursor = syntax.expectSymbol(source, syntax.skipTrivia(source, branch.next, prefix), "}", prefix);
        listLib.pushBack(mut result, (kind = if isFirst { ir.ITEM_KIND_IF } else { ir.ITEM_KIND_ELSE_IF }, name = "", runtime = "", code = conditionCode,
        intValue = 0, textValue = ""));
        listLib.pushBack(mut result, (kind = ir.ITEM_PREFIX_ASSIGN + ctx.storageKind(targetKind), name = targetName, runtime = targetRuntime,
        code = ctx.assignValueCode(target, targetKind, branch.kind, branch.code), intValue = branch.intValue, textValue = ctx.storageTextPayload(targetKind, branch.textValue)));
        isFirst = false;
        afterBranch := syntax.skipTrivia(source, cursor, prefix);
        if not textLib.wordAt(source, afterBranch, "else") {
            var end := afterBranch;
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = syntax.skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            statementNext := if matched { syntax.consumeStatementEnd(source, end, prefix) } else { -1 };
            if statementNext < 0 {
                syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
            }
            listLib.pushBack(mut result, (kind = ir.ITEM_KIND_END_IF, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            listLib.pushBack(mut result, (kind = ir.ITEM_KIND_END, name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
            return result;
        }
        afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
        syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
        if not textLib.wordAt(source, afterElse, "if") {
            return [];
        }
        cursor = syntax.skipTrivia(source, afterElse + 2, prefix);
    }
    []
};

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
pub parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    var inner := syntax.skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = syntax.skipTrivia(source, inner + 1, prefix);
    }
    ifKwPos := syntax.skipOptionalScanTag(source, inner, prefix, "if");
    if ifKwPos >= 0 and textLib.wordAt(source, ifKwPos, "if") {
        scannedEnd := syntax.scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := syntax.skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = syntax.skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and syntax.consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinaryCtx(target, source, inner, prefix, locals, functions, params, currentName, expected, -1, ctxs, 0, false, "", aliases);
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseExpressionAsCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
pub parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): (next: Int, returned: Bool, code: String, valueKind: String) {
    var isTailClose := false;
    if valueTail {
        end := syntax.scanExpressionItemEnd(source, position, prefix);
        nextCheck := syntax.skipItemSeparators(source, end, prefix);
        isTailClose = nextCheck < textLib.length(source) and textLib.at(source, nextCheck) == "}";
    }
    expected := if isTailClose {
        if types.isListKind(currentResult) { "Tail" + currentResult } else { currentResult }
    } else {
        ""
    };
    trimmedStart := syntax.skipTrivia(source, position, prefix);
    stmtSink := if trimmedStart < textLib.length(source) and textLib.at(source, trimmedStart) == "{" { "exprOut" } else { "" };
    stmtMin := if not isTailClose or currentResult == ir.VALUE_KIND_UNIT { -2 } else { 0 };
    parsed := parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, stmtMin, ctxs, 0, false, stmtSink, aliases);
    ended := syntax.consumeStatementEnd(source, parsed.next, prefix);
    if ended < 0 { syntax.failAt(source, syntax.skipTrivia(source, parsed.next, prefix), prefix, "expected ; after expression statement"); }
    next := syntax.skipItemSeparators(source, ended, prefix);
    returned := currentName =!= "" and valueTail and next < textLib.length(source) and textLib.at(source, next) == "}";
    if returned and not types.isCompatibleKind(currentResult, parsed.kind) {
        syntax.failAt(source, position, prefix, "cannot return " + types.displayKind(parsed.kind) + " from function " + currentName +
        " returning " + types.displayKind(currentResult));
    }
    (next = next, returned = returned, code = if returned { if parsed.kind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, parsed.code) } else { ctx.assignValueCode(target, currentResult, parsed.kind, parsed.code) } } else { parsed.code }, valueKind = parsed.kind)
};

/** Parses `Name := record { field: Type [= default]; ... }`, validating field names, types, defaults, and returning the canonical kind and encoded defaults. */
pub parseRecordDecl := fn(target: String, source: String, recPos: Int, nameStart: Int, recName: String, aliasDepth: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): (kind: String, encodedDefaults: String, markers: String, next: Int) {
    size := textLib.length(source);
    bracePos := syntax.skipTrivia(source, recPos + 6, prefix);
    if bracePos >= size or textLib.at(source, bracePos) =!= "{" {
        syntax.failAt(source, bracePos, prefix, "expected { after record");
    }
    scopedAliases := types.aliasesUpToDepth(aliases, aliasDepth);
    seenRec: mut List<String> = [integer.intText(aliasDepth) + ":" + recName];
    fieldNames: mut List<String> = [];
    defaultKeys: mut List<String> = [];
    defaultCodes: mut List<String> = [];
    var markers := "";
    var cursor := bracePos + 1;
    loop true {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= size {
            syntax.failAt(source, bracePos, prefix, "expected } after record fields");
        }
        if textLib.at(source, cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            syntax.failAt(source, cursor, prefix, "expected a record field name");
        }
        fStart := cursor;
        fEnd := textLib.skipName(source, fStart);
        fName := textLib.slice(source, fStart, fEnd);
        if syntax.isReservedWord(fName) {
            syntax.unsupportedFeature(source, fStart, fName, prefix);
        }
        if listLib.listContainsText(fieldNames, fName) {
            syntax.failAt(source, fStart, prefix, "duplicate record field " + fName);
        }
        listLib.pushBack(mut fieldNames, fName);
        afterField := syntax.skipTrivia(source, fEnd, prefix);
        if afterField >= size or textLib.at(source, afterField) =!= ":" {
            syntax.failAt(source, afterField, prefix, "expected : after record field " + fName);
        }
        typeStart := syntax.skipTrivia(source, afterField + 1, prefix);
        fieldType := types.parseTypeWithSeen(source, fStart, true, source, typeStart, prefix, scopedAliases, "record field", "", seenRec);
        if fieldType.kind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, fStart, prefix, "unsupported record field type Unit");
        }
        afterType := syntax.skipTrivia(source, fieldType.next, prefix);
        var nextCursor := afterType;
        var lastTokenPos := fieldType.next;
        if syntax.isSingleEquals(source, afterType) {
            defStart := syntax.skipTrivia(source, afterType + 1, prefix);
            defParsed := parseBinaryCtx(target, source, defStart, prefix, locals, functions, params, currentName, fieldType.kind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, defParsed); }
            if not types.isCompatibleKind(fieldType.kind, defParsed.kind) {
                syntax.failAt(source, defStart, prefix, "cannot initialize " + types.displayKind(fieldType.kind) + " field " + fName + " with " + types.displayKind(defParsed.kind));
            }
            if defParsed.kind == ir.VALUE_KIND_NEVER {
                syntax.failAt(source, defStart, prefix, "record field default " + fName + " cannot diverge");
            }
            converted := ctx.assignValueCode(target, fieldType.kind, defParsed.kind, defParsed.code);
            listLib.pushBack(mut defaultKeys, fName);
            listLib.pushBack(mut defaultCodes, converted);
            lastTokenPos = defParsed.next;
            nextCursor = syntax.skipTrivia(source, defParsed.next, prefix);
        }
        if nextCursor < size and textLib.at(source, nextCursor) == ";" {
            cursor = nextCursor + 1;
        } else if nextCursor < size and textLib.at(source, nextCursor) == "}" {
            cursor = nextCursor;
        } else if lastTokenPos > 0 and textLib.at(source, lastTokenPos - 1) == "}" {
            cursor = nextCursor;
        } else {
            syntax.failAt(source, nextCursor, prefix, "expected ; or } after record field " + fName);
        }
    }
    afterDecl := syntax.consumeStatementEnd(source, cursor, prefix);
    if afterDecl < 0 {
        syntax.failAt(source, syntax.skipTrivia(source, cursor, prefix), prefix, "expected ; after record declaration " + recName);
    }
    emptySeen: List<String> = [];
    canonicalKind := types.resolveAliasKind(source, nameStart, prefix, aliases, recName, emptySeen);
    (kind = canonicalKind, encodedDefaults = types.encodeRecordPairs(defaultKeys, defaultCodes), markers = markers, next = afterDecl)
};
