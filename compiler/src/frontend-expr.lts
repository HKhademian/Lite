                }
                loopCtx := ctxs[targetLoopIdx];
                if loopCtx.phase == ir.CTX_PHASE_HEADER {
                    syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " from loop header");
                }
                hasPayload := afterExit < blockSourceSize and textLib.at(source, afterExit) =!= ";" and textLib.at(source, afterExit) =!= "}";
                var exitNext := afterExit;
                if not hasPayload {
                    stmtNext := syntax.consumeStatementEnd(source, afterExit, prefix);
                    if stmtNext < 0 { syntax.failAt(source, afterExit, prefix, "expected ; after " + itemName); }
                    exitNext = stmtNext;
                    if inferMode and itemName == "break" and not blockExits {
                        blockMarkers = blockMarkers + integer.intText(loopCtx.id) + "=@break\n";
                    }
                    if not blockExits {
                        if loopCtx.iifeDepth == bodyDepth {
                            if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                listLib.pushBack(mut statements, itemName + " " + loopCtx.label + ";");
                            } else {
                                listLib.pushBack(mut statements, itemName + ";");
                            }
                        } else {
                            if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support non-local " + itemName + " yet"); }
                            transferId := if loopCtx.valVar =!= "" {
                                if itemName == "break" { 1000000 + loopCtx.id } else { 0 - 1000000 - loopCtx.id }
                            } else {
                                if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id }
                            };
                            listLib.pushBack(mut statements, stmtReturnPrefix + "lite$throwTransfer(" + integer.intText(transferId) + ", undefined);");
                        }
                        blockExits = true;
                    }
                } else {
                    if target =!= ir.TARGET_TS { syntax.failAt(source, itemStart, prefix, "C backend does not support " + itemName + " payloads yet"); }
                    isInferLoop := isInferPlaceholderKind(loopCtx.valKind);
                    payExpected := inferHintKind(loopCtx.valKind);
                    rhs := parseBinaryCtx(target, source, afterExit, prefix, blockLocals, functions, params, currentName, payExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                    if target == ir.TARGET_TS and not inferMode and not blockExits {
                        trace.checkTraceSafety(source, afterExit, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        if types.containsFnKind(rhs.kind) {
                            loopExitDepth := trace.parseLexDepthTag(loopCtx.iterLabel, blockLexDepth);
                            trace.checkEscapingFnSafety(source, afterExit, prefix, rhs.code, loopExitDepth, blockLocals);
                        }
                    }
