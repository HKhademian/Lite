                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after assignment to " + itemName); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                listLib.pushBack(mut blockLocals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = entry.code,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    listLib.pushBack(mut statements, entry.runtime + " = " + rhsCode + ";");
                    isCompoundLocalOwner := not ir.localsRangeUsesRuntime(blockLocals, outerLocalsLen, entry.runtime);
                    compoundOwner := if isCompoundLocalOwner and reach.isPrunableExprForTarget(target, entry.kind, rhsCode) { entry.runtime } else { "" };
                    compoundDeps := if compoundOwner =!= "" { rhsCode } else { entry.runtime + " " + rhsCode };
                    listLib.pushBack(mut stmtOwners, compoundOwner);
                    listLib.pushBack(mut stmtDeps, compoundDeps);
                    trackedStmtCount = trackedStmtCount + 1;
                    statementCount = statementCount + 1;
                }
                blockConstant = false;
                cursor = statementNext;
            }
        }
        if not isStatement {
            var itemExpected := if isStmtBody { "" } else { expected };
            itemEnd := syntax.scanExpressionItemEnd(source, cursor, prefix);
            itemAfter := syntax.skipItemSeparators(source, itemEnd, prefix);
            itemAtClose := itemAfter < textLib.length(source) and textLib.at(source, itemAfter) == "}";
            if not itemAtClose { itemExpected = ""; }
            else if isTaggedBody and (expected == ir.VALUE_KIND_UNIT or expected == ir.VALUE_KIND_NEVER) { itemExpected = ""; }
            else if isFnBody and (expected == ir.VALUE_KIND_UNIT or expected == ir.VALUE_KIND_NEVER) { itemExpected = ""; }
            else if isFnBody and types.isListKind(expected) { itemExpected = "Tail" + expected; }
            itemSink := if (not isStmtBody) and allowOutput and itemAtClose { "exprOut" } else { "" };
            itemMinimum := if isStmtBody or (not itemAtClose) or minimum == -2 or
            (isLoopBody and (expected == "" or expected == ir.VALUE_KIND_UNIT)) { -2 } else { 0 };
            expr := parseBinaryCtx(target, source, cursor, prefix, blockLocals, functions, params, currentName, itemExpected, itemMinimum, ctxs, bodyDepth, inferMode, itemSink, blockAliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, expr); }
            if target == ir.TARGET_TS and not inferMode and not blockExits {
                trace.checkTraceSafety(source, cursor, prefix, expr.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, expr.code);
            }
            statementNext := syntax.consumeStatementEnd(source, expr.next, prefix);
            if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, expr.next, prefix), prefix, "expected ; or }"); }
            afterExpr := syntax.skipItemSeparators(source, statementNext, prefix);
            if (not isStmtBody) and afterExpr < textLib.length(source) and textLib.at(source, afterExpr) == "}" {
                if target == ir.TARGET_TS and not inferMode and not blockExits and types.containsFnKind(expr.kind) {
                    trace.checkEscapingFnSafety(source, cursor, prefix, expr.code, blockLexDepth, blockLocals);
                }
                sawTailExpr = true;
                blockKind = expr.kind;
                blockCode = expr.code;
                blockInt = expr.intValue;
                blockText = expr.textValue;
                blockConstant = expr.constant;
                cursor = afterExpr + 1;
                break;
            }
            if not blockExits {
                if expr.kind == ir.VALUE_KIND_NEVER {
                    listLib.pushBack(mut statements, stmtReturnPrefix + "(" + expr.code + ");");
                    blockExits = true;
                } else {
                    listLib.pushBack(mut statements, if target == ir.TARGET_C { "(void)(" + expr.code + ");" } else { "void (" + expr.code + ");" });
                    if reach.isPrunableExprForTarget(target, expr.kind, expr.code) {
                        listLib.pushBack(mut stmtOwners, "#discard");
                        listLib.pushBack(mut stmtDeps, "");
                    } else {
                        listLib.pushBack(mut stmtOwners, "");
                        listLib.pushBack(mut stmtDeps, expr.code);
                    }
                    trackedStmtCount = trackedStmtCount + 1;
                }
                statementCount = statementCount + 1;
            }
            blockConstant = false;
            if isStmtBody and afterExpr < textLib.length(source) and textLib.at(source, afterExpr) == "}" {
                cursor = afterExpr + 1;
                break;
            }
            cursor = statementNext;
        }
    }
    var endSyncLen := 0;
    loop statements { endSyncLen = endSyncLen + 1; }
    loop trackedStmtCount < endSyncLen {
        listLib.pushBack(mut stmtOwners, "");
        listLib.pushBack(mut stmtDeps, statements[trackedStmtCount]);
        trackedStmtCount = trackedStmtCount + 1;
    }
    if target == ir.TARGET_TS or isStmtBody {
        prunedStmts := reach.pruneBlockStatements(statements, stmtOwners, stmtDeps, sawTailExpr and not blockExits, blockCode);
        loop trackedStmtCount > 0 {
            _ := listLib.popBack(mut statements);
            trackedStmtCount = trackedStmtCount - 1;
        }
        var prunedCount := 0;
        loop prunedStmts as keptStmt {
            listLib.pushBack(mut statements, keptStmt);
            prunedCount = prunedCount + 1;
        }
        statementCount = prunedCount;
        if statementCount == 0 and not blockExits and not sawTailExpr {
            blockConstant = true;
        }
    }
    if isStmtBody {
        stmtCode := textLib.joinTexts(statements, " ");
        stmtKind := if blockExits { ir.VALUE_KIND_NEVER } else { ir.VALUE_KIND_UNIT };
        return ctx.withMarkers((kind = stmtKind, code = stmtCode, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if isFinallyBody {
        if not blockExits and sawTailExpr {
            if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                syntax.failAt(source, start, prefix, "finally block must produce Unit, got " + types.displayKind(blockKind));
            }
            if blockKind == ir.VALUE_KIND_NEVER {
                listLib.pushBack(mut statements, "(" + blockCode + ");");
                blockExits = true;
            } else if blockCode =!= ir.targetUnitLiteralCode(target) {
                listLib.pushBack(mut statements, if target == ir.TARGET_C { "(void)(" + blockCode + ");" } else { "void (" + blockCode + ");" });
            }
        }
        finCode := textLib.joinTexts(statements, " ");
        finKind := if blockExits { ir.VALUE_KIND_NEVER } else { ir.VALUE_KIND_UNIT };
        return ctx.withMarkers((kind = finKind, code = finCode, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if isFnBody {
        if not blockExits {
            if sawTailExpr {
                if expected == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "function " + currentName + " returns Unit and cannot return a value");
                    }
                    if blockKind == ir.VALUE_KIND_NEVER {
                        listLib.pushBack(mut statements, "(" + blockCode + ");");
                        blockExits = true;
                    } else if blockCode =!= ir.targetUnitLiteralCode(target) {
                        listLib.pushBack(mut statements, if target == ir.TARGET_C { "(void)(" + blockCode + ");" } else { "void (" + blockCode + ");" });
                    }
                } else if expected == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from function " + currentName + " returning Never");
                    }
                    listLib.pushBack(mut statements, "(" + blockCode + ");");
                    blockExits = true;
                } else {
                    if not types.isCompatibleKind(expected, blockKind) {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from function " + currentName + " returning " + types.displayKind(expected));
                    }
                    if blockKind == ir.VALUE_KIND_NEVER {
                        listLib.pushBack(mut statements, "(" + blockCode + ");");
                        blockExits = true;
                    } else {
                        listLib.pushBack(mut statements, "return " + ctx.assignValueCode(target, expected, blockKind, blockCode) + ";");
                        blockExits = true;
                    }
                }
            } else if expected =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "function " + currentName + " must return " + types.displayKind(expected));
            }
        }
        var fnBodyJoined := textLib.joinTexts(statements, " ");
        if reach.codeUsesTextCall(fnBodyJoined, "lite$throwTransfer(0,") {
            catchRet := if expected == ir.VALUE_KIND_UNIT { "return;" } else { "return lite$transferVal;" };
            fnBodyJoined = "try { " + fnBodyJoined + " } catch (lite$err) { if (lite$hasTransfer(lite$err, 0)) { " + catchRet + " } throw lite$err; }";
        }
        return ctx.withMarkers((kind = expected, code = fnBodyJoined, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if isLoopBody {
        topLoopCtx := ctxs[ctx.findActiveLoopCtxIndex(ctxs)];
        topLoopId := topLoopCtx.id;
        topLoopValKind := topLoopCtx.valKind;
        topLoopValVar := topLoopCtx.valVar;
        if isInferPlaceholderKind(topLoopValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(blockKind) < 0 {
                        blockMarkers = blockMarkers + integer.intText(topLoopId) + "=" + blockKind + "\n";
                    }
                } else if not lastPartialIfDiverges {
                    blockMarkers = blockMarkers + integer.intText(topLoopId) + "=Unit\n";
                }
            }
            tailPlaceholderKind := if blockExits {
                ir.VALUE_KIND_NEVER
            } else if sawTailExpr {
                blockKind
            } else {
                ir.VALUE_KIND_UNIT
            };
            return ctx.withMarkers((kind = tailPlaceholderKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), blockMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topLoopValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "loop produces Unit and cannot yield " + types.displayKind(blockKind));
                    }
                } else if topLoopValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot yield " + types.displayKind(blockKind) + " from diverging loop");
                    }
                } else if not types.isCompatibleKind(topLoopValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot commit " + types.displayKind(blockKind) +
                    " to loop .value of kind " + types.displayKind(topLoopValKind));
                }
                if blockKind == ir.VALUE_KIND_NEVER {
                    listLib.pushBack(mut statements, "(" + blockCode + ");");
                    blockExits = true;
                } else if topLoopValKind == ir.VALUE_KIND_UNIT {
                    if blockCode =!= ir.targetUnitLiteralCode(target) {
                        if target == ir.TARGET_C {
                            listLib.pushBack(mut statements, "(void)(" + blockCode + ");");
                        } else {
                            listLib.pushBack(mut statements, "void (" + blockCode + ");");
                        }
                    }
                } else {
                    tailLoopCode := ctx.assignValueCode(target, topLoopValKind, blockKind, blockCode);
                    if topLoopCtx.colVar =!= "" {
                        if target == ir.TARGET_C {
                            colTag := types.cListTag(topLoopValKind);
                            listLib.pushBack(mut statements, topLoopValVar + " = " + tailLoopCode + "; lt_list_" + colTag + "_push_back(&" + topLoopCtx.colVar + ", " + topLoopValVar + ");");
                        } else {
                            listLib.pushBack(mut statements, topLoopValVar + " = " + tailLoopCode + "; " + topLoopCtx.colVar + ".push(" + topLoopValVar + ");");
                        }
                    } else {
                        listLib.pushBack(mut statements, topLoopValVar + " = " + tailLoopCode + ";");
                    }
                }
            } else if not lastPartialIfDiverges and topLoopValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "loop body must produce " + types.displayKind(topLoopValKind));
            }
        }
        loopBodyJoined := textLib.joinTexts(statements, " ");
        return ctx.withMarkers((kind = if blockExits { ir.VALUE_KIND_NEVER } else { topLoopValKind }, code = loopBodyJoined,
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topLoopId) } else { "" });
    }
    if isTaggedBody {
        topCtx := ctxs[ctx.ctxCount(ctxs) - 1];
        topId := topCtx.id;
        topTag := topCtx.tag;
        topValKind := topCtx.valKind;
        topValVar := topCtx.valVar;
        topLabel := topCtx.label;
        if isInferPlaceholderKind(topValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        blockMarkers = blockMarkers + integer.intText(topId) + "=" + blockKind + "\n";
                    }
                } else {
                    blockMarkers = blockMarkers + integer.intText(topId) + "=Unit\n";
                }
            }
            inferredKind := ctx.inferKindFromMarkers(blockMarkers, topId, topTag, source, start, prefix, blockExits);
            outerMarkers := ctx.filterOtherMarkers(blockMarkers, topId);
            return ctx.withMarkers((kind = inferredKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), outerMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "block @" + topTag + " returns Unit and cannot return a value");
                    }
                } else if topValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning Never");
                    }
                } else if not types.isCompatibleKind(topValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning " + types.displayKind(topValKind));
                }
            } else if topValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "block @" + topTag + " must return " + types.displayKind(topValKind));
            }
        }
        if not blockExits and sawTailExpr {
            if blockKind == ir.VALUE_KIND_NEVER {
                listLib.pushBack(mut statements, "(" + blockCode + ");");
                blockExits = true;
            } else if topValKind == ir.VALUE_KIND_UNIT {
                if blockCode =!= ir.targetUnitLiteralCode(target) {
                    listLib.pushBack(mut statements, if target == ir.TARGET_C { "(void)(" + blockCode + ");" } else { "void (" + blockCode + ");" });
                }
            } else {
                tailCode := ctx.assignValueCode(target, topValKind, blockKind, blockCode);
                listLib.pushBack(mut statements, topValVar + " = " + tailCode + ";");
            }
        }
        bodyJoined := textLib.joinTexts(statements, " ");
        needsLabel := reach.codeUsesTextCall(bodyJoined, "break " + topLabel + ";");
        needsTry := reach.codeUsesTextCall(bodyJoined, "lite$throwTransfer(" + integer.intText(topId) + ",");
        labeledBody := if needsLabel { topLabel + ": { " + bodyJoined + " }" } else { bodyJoined };
        wrappedBody := if needsTry {
            catchAssign := if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER { "" } else { topValVar + " = lite$transferVal;" };
            tryInner := if needsLabel { labeledBody } else { "{ " + labeledBody + " }" };
            "try { " + tryInner + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " + integer.intText(topId) + ")) { " + catchAssign + " } else { throw lite$err; } }"
        } else {
            labeledBody
        };
        finalIife := if topValKind == ir.VALUE_KIND_UNIT {
            "(() => { " + wrappedBody + (if wrappedBody =!= "" { " " } else { "" }) + "return undefined; })()"
        } else if topValKind == ir.VALUE_KIND_NEVER {
            "(() => { " + wrappedBody + " })()"
        } else {
            "(() => { let " + topValVar + ": " + types.tsFunctionType(topValKind) + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; " + wrappedBody + " return " + topValVar + "; })()"
        };
        return ctx.withMarkers((kind = topValKind, code = finalIife, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
    }
    if isStandaloneBlock {
        afterUntaggedClose := syntax.skipTrivia(source, cursor, prefix);
        if afterUntaggedClose < blockSourceSize and textLib.wordAt(source, afterUntaggedClose, "then") {
            syntax.failAt(source, afterUntaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterUntaggedClose < blockSourceSize and textLib.wordAt(source, afterUntaggedClose, "finally") {
            if target =!= ir.TARGET_TS {
                syntax.failAt(source, afterUntaggedClose, prefix, "C backend does not support finally blocks yet");
            }
            finParsed := parseFinallyClause(target, source, afterUntaggedClose, prefix, locals, functions, params, currentName, ctxs, bodyDepth, inferMode, aliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, finParsed); }
            stmtsJoined := textLib.joinTexts(statements, " ");
            standaloneTryBody := if blockExits {
                stmtsJoined
            } else if blockKind == ir.VALUE_KIND_UNIT {
                unitRet := if blockCode == ir.targetUnitLiteralCode(target) {
                    "return undefined;"
                } else {
                    "void (" + blockCode + "); return undefined;"
                };
                if stmtsJoined == "" { unitRet } else { stmtsJoined + " " + unitRet }
            } else if blockKind == ir.VALUE_KIND_NEVER {
                if stmtsJoined == "" { "return " + blockCode + ";" } else { stmtsJoined + " return " + blockCode + ";" }
            } else {
                valRet := "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";";
                if stmtsJoined == "" { valRet } else { stmtsJoined + " " + valRet }
            };
            finalStandaloneKind := if blockExits or finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { blockKind };
            return ctx.withMarkers((kind = finalStandaloneKind,
            code = "(() => { try { " + standaloneTryBody + " } finally { " + finParsed.code + " } })()",
            intValue = 0, textValue = "", constant = false, next = finParsed.next),
            if inferMode { blockMarkers } else { "" });
        }
    }
    if blockExits {
        if target == ir.TARGET_C {
            return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + textLib.joinTexts(statements, " "),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "(() => { " + textLib.joinTexts(statements, " ") + " })()",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if statementCount == 0 {
        baseBlock := (kind = blockKind, code = blockCode, intValue = blockInt, textValue = blockText, constant = blockConstant, next = cursor);
        return if inferMode and blockMarkers =!= "" { ctx.withMarkers(baseBlock, blockMarkers) } else { baseBlock };
    }
    if target == ir.TARGET_C {
        stmtsJoinedC := textLib.joinTexts(statements, " ");
        if blockKind == ir.VALUE_KIND_UNIT or blockKind == ir.VALUE_KIND_NEVER {
            tailC := ctx.cUnwrapIntoVar("", blockKind, blockCode);
            return ctx.withMarkers((kind = blockKind, code = "/*@CBLK:0@*/" + stmtsJoinedC + (if tailC =!= "" { " " + tailC } else { "" }),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        blkVar := "lt_blk_" + integer.intText(start);
        tailValC := ctx.copiedValueCode(target, blockKind, blockCode);
        tailAssignC := ctx.cUnwrapIntoVar(blkVar, blockKind, tailValC);
        return ctx.withMarkers((kind = blockKind,
        code = "/*@CBLK:" + blkVar + "@*/" + types.cValueType(blockKind) + " " + blkVar + "; { " + stmtsJoinedC + " " + tailAssignC + " }",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    returnCode := if blockKind == ir.VALUE_KIND_UNIT {
        if blockCode == ir.targetUnitLiteralCode(target) { "return undefined;" }
        else { "void (" + blockCode + "); return undefined;" }
    } else if blockKind == ir.VALUE_KIND_NEVER {
        "return " + blockCode + ";"
    } else {
        "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";"
    };
    ctx.withMarkers((kind = blockKind, code = "(() => { " + textLib.joinTexts(statements, " ") + " " + returnCode + " })()",
    intValue = 0, textValue = "", constant = false, next = cursor),
    if inferMode { blockMarkers } else { "" })
};

/** Parses `[@tag] loop [header] { ... } [then { ... }] [finally { ... }]` expressions. */
parseLoopExpr := fn(target: String, source: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    rawLoopEnd := syntax.scanRawLoopEnd(source, condParseStart, prefix);
    afterRawLoop := if rawLoopEnd >= 0 { syntax.skipTrivia(source, rawLoopEnd, prefix) } else { -1 };
    hasActualThen := afterRawLoop >= 0 and textLib.wordAt(source, afterRawLoop, "then");
    var suffixField := "";
    var suffixFieldAt := -1;
    var suffixEnd := rawLoopEnd;
    if not hasActualThen and afterRawLoop >= 0 and afterRawLoop < textLib.length(source) and textLib.at(source, afterRawLoop) == "." {
        sFieldStart := syntax.skipTrivia(source, afterRawLoop + 1, prefix);
        if sFieldStart < textLib.length(source) and textLib.isNameStart(textLib.at(source, sFieldStart)) {
            sFieldEnd := textLib.skipName(source, sFieldStart);
            sName := textLib.slice(source, sFieldStart, sFieldEnd);
            if sName == "collected" or sName == "count" or sName == "value" {
                suffixField = sName;
                suffixFieldAt = sFieldStart;
                suffixEnd = sFieldEnd;
            }
        }
    }
    afterOptLoopThen := if hasActualThen { syntax.scanTrailingThenEnd(source, rawLoopEnd, prefix, false) } else { suffixEnd };
    afterOptLoopThenTrivia := if afterOptLoopThen >= 0 { syntax.skipTrivia(source, afterOptLoopThen, prefix) } else { -1 };
    hasLoopFinally := afterOptLoopThenTrivia >= 0 and textLib.wordAt(source, afterOptLoopThenTrivia, "finally");
    if target =!= ir.TARGET_TS {
        if condParseTag =!= "" {
            syntax.failAt(source, condParseTagAt, prefix, "C backend does not support tagged loops yet");
        }
        if hasLoopFinally {
            syntax.failAt(source, afterOptLoopThenTrivia, prefix, "C backend does not support finally blocks yet");
        }
        if hasActualThen {
            syntax.failAt(source, condParseStart, prefix, "C backend does not support loop then blocks yet");
        }
    }
    isCLoop := target == ir.TARGET_C;
    loopId := ctx.nextCtxId(ctxs);
    loopIdStr := integer.intText(loopId);
    loopValVar := if isCLoop { "lt_val_" + loopIdStr } else { "lite$val" + loopIdStr };
    loopColVar := if isCLoop { "lt_col_" + loopIdStr } else { "lite$col" + loopIdStr };
    loopCountVar := if isCLoop { "lt_cnt_" + loopIdStr } else { "lite$cnt" + loopIdStr };
    loopItemMetaVar := if isCLoop { "lt_litem_" + loopIdStr } else { "lite$litem" + loopIdStr };
    loopIdxVar := if isCLoop { "lt_lidx_" + loopIdStr } else { "lite$lidx" + loopIdStr };
    loopIterVar := if isCLoop { "lt_iter_" + loopIdStr } else { "lite$iter" + loopIdStr };
    loopLabel := if isCLoop { "lt_l_" + loopIdStr } else { "lite$l" + loopIdStr };
    loopDepth := iifeDepth + 1;
    normExpected := normalizeExpectedValueKind(expected);
    loopHintExpected := if hasActualThen or suffixField == "count" {
        ""
    } else if suffixField == "collected" {
        if types.isListKind(normExpected) { types.listElementKind(normExpected) } else { "" }
    } else {
        normExpected
    };
    wantsCollected := if suffixField == "collected" {
        true
    } else if hasActualThen and afterOptLoopThen > rawLoopEnd {
        textLib.indexOfText(textLib.slice(source, rawLoopEnd, afterOptLoopThen), "collected", 0) >= 0
    } else {
        false
    };
    loopTagDisplay := if condParseTag =!= "" { condParseTag } else { "loop" };
    passCount := if inferMode { 1 } else { 2 };
    var resolvedPreThenKind := "";
    var loopOuterMarkers := "";
    var loopEndCursor := condParseStart;
    var loopStmtCode := "";
    var finalIsSeqLoop := false;
    var finalSeqItemKind := "";
    var pass := 1;
    loop pass <= passCount {
        isPass1 := pass == 1;
        passInfer := isPass1 or inferMode;
        passEmitCollected := not isPass1 and wantsCollected and resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER;
        passColVar := if passEmitCollected { loopColVar } else { "" };
        passCtxValKind := if isPass1 {
            if loopHintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + loopHintExpected }
        } else {
            resolvedPreThenKind
        };
