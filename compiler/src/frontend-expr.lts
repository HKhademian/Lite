                            if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) + " to Unit loop .value");
                            }
                        } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(loopCtx.valKind, rhs.kind) {
                            syntax.failAt(source, afterExit, prefix, "cannot commit " + types.displayKind(rhs.kind) +
                            " to loop .value of kind " + types.displayKind(loopCtx.valKind));
                        }
                    }
                    if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
