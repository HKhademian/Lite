                loopIterVar + " " + rangeCmp + " " + rangeEndVar + "; " + loopIterVar + " += 1n) { " + metaStep + wrappedBody + " }"
            } else if isSeqLoop {
                "for (const " + loopIterVar + " of " + ir.targetListCopyCode(target, seqCode) + ") { " + metaStep + wrappedBody + " }"
            } else {
                whileCond := if condCode == "true" { "Boolean(true)" } else if condCode == "false" { "Boolean(false)" } else { "Boolean(" + condCode + ")" };
                "while (" + whileCond + ") { " + metaStep + wrappedBody + " }"
            };
