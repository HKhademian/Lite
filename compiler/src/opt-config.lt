/** Composable compiler optimization and code-emission configuration (`-O0`..`-O3`, `-Os`, `-Oc`, and `-f...` overrides). */


/** Native optimization preset class (`-O0`, `-O1`, `-O2`, `-O3`, `-Os`, `-Oc`). */
pub OptClass := enum { O0; O1; O2; O3; Os; Oc; };

/** Emitted code formatting style (`--emit-format`). */
pub EmitFormat := enum { Pretty; Compact; };

/** Emitted source-location mapping mode (`--source-map`). */
pub SourceMapMode := enum { None; Comments; Lines; };

/** Per-pass optimization and emission configuration. Presets (`OptClass`) set defaults; every field is overridable. */
pub OptConfig := alias (
    ok: Bool,
    error: String,
    preset: OptClass,
    constFold: Bool,
    branchSimplify: Bool,
    deadStore: Bool,
    blockPrune: Bool,
    dce: Bool,
    inlineLeaves: Bool,
    inlineMaxSize: Int,
    optRounds: Int,
    emitFormat: EmitFormat,
    sourceMap: SourceMapMode,
    preserveComments: Bool,
    preserveDocs: Bool,
    checkArithmetic: Bool,
    checkBounds: Bool,
    checkFloatFinite: Bool,
    checkUnchecked: Bool,
    debugInfo: Bool
);

/** Parses an `OptClass` suffix (`0`, `1`, `2`, `3`, `s`, `c`). */
pub parseOptClass := fn(raw: String): (ok: Bool, value: OptClass) {
    if raw == "0" { (ok = true, value = OptClass.O0) }
    else if raw == "1" { (ok = true, value = OptClass.O1) }
    else if raw == "2" { (ok = true, value = OptClass.O2) }
    else if raw == "3" { (ok = true, value = OptClass.O3) }
    else if raw == "s" or raw == "S" { (ok = true, value = OptClass.Os) }
    else if raw == "c" or raw == "C" { (ok = true, value = OptClass.Oc) }
    else { (ok = false, value = OptClass.O1) }
};

/** Parses `--emit-format` value (`pretty` or `compact`). */
parseEmitFormat := fn(raw: String): (ok: Bool, value: EmitFormat) {
    if raw == "pretty" { (ok = true, value = EmitFormat.Pretty) }
    else if raw == "compact" { (ok = true, value = EmitFormat.Compact) }
    else { (ok = false, value = EmitFormat.Pretty) }
};

/** Parses `--source-map` value (`none`, `comments`, or `lines`). */
parseSourceMapMode := fn(raw: String): (ok: Bool, value: SourceMapMode) {
    if raw == "none" { (ok = true, value = SourceMapMode.None) }
    else if raw == "comments" { (ok = true, value = SourceMapMode.Comments) }
    else if raw == "lines" { (ok = true, value = SourceMapMode.Lines) }
    else { (ok = false, value = SourceMapMode.None) }
};

/** Returns an error `OptConfig` with `ok = false`. */
failConfig := fn(base: OptConfig, message: String): OptConfig {
    (
        ok = false,
        error = message,
        preset = base.preset,
        constFold = base.constFold,
        branchSimplify = base.branchSimplify,
        deadStore = base.deadStore,
        blockPrune = base.blockPrune,
        dce = base.dce,
        inlineLeaves = base.inlineLeaves,
        inlineMaxSize = base.inlineMaxSize,
        optRounds = base.optRounds,
        emitFormat = base.emitFormat,
        sourceMap = base.sourceMap,
        preserveComments = base.preserveComments,
        preserveDocs = base.preserveDocs,
        checkArithmetic = base.checkArithmetic,
        checkBounds = base.checkBounds,
        checkFloatFinite = base.checkFloatFinite,
        checkUnchecked = base.checkUnchecked,
        debugInfo = base.debugInfo
    )
};

/** Applies resolved safety and debug-info switches onto `base`. */
withSafetyFlags := fn(
    base: OptConfig,
    checkArithmetic: Bool, checkBounds: Bool, checkFloatFinite: Bool, checkUnchecked: Bool, debugInfo: Bool
): OptConfig {
    (
        ok = base.ok,
        error = base.error,
        preset = base.preset,
        constFold = base.constFold,
        branchSimplify = base.branchSimplify,
        deadStore = base.deadStore,
        blockPrune = base.blockPrune,
        dce = base.dce,
        inlineLeaves = base.inlineLeaves,
        inlineMaxSize = base.inlineMaxSize,
        optRounds = base.optRounds,
        emitFormat = base.emitFormat,
        sourceMap = base.sourceMap,
        preserveComments = base.preserveComments,
        preserveDocs = base.preserveDocs,
        =checkArithmetic,
        =checkBounds,
        =checkFloatFinite,
        =checkUnchecked,
        =debugInfo
    )
};

/** Returns the default `OptConfig` for a native `OptClass` preset on `target` (`"ts"` or `"c"`). */
pub presetConfig := fn(preset: OptClass, target: String): OptConfig {
    if preset == OptClass.Oc {
        /* Custom zero-default baseline: every optimization, purification, comment/doc, and source-map pass starts OFF. */
        return (
            ok = true,
            error = "",
            preset = OptClass.Oc,
            constFold = false,
            branchSimplify = false,
            deadStore = false,
            blockPrune = false,
            dce = false,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = -1,
            emitFormat = EmitFormat.Pretty,
            sourceMap = SourceMapMode.None,
            preserveComments = false,
            preserveDocs = false,
            checkArithmetic = true,
            checkBounds = true,
            checkFloatFinite = true,
            checkUnchecked = false,
            debugInfo = false
        );
    }
    if preset == OptClass.O0 {
        /* Debug/inspection preset: zero optimizations, with source maps, debug checks, and root comments/docs preserved by default. */
        defaultSm := if target == "c" { SourceMapMode.Lines } else { SourceMapMode.Comments };
        return (
            ok = true,
            error = "",
            preset = OptClass.O0,
            constFold = false,
            branchSimplify = false,
            deadStore = false,
            blockPrune = false,
            dce = false,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 0,
            emitFormat = EmitFormat.Pretty,
            sourceMap = defaultSm,
            preserveComments = true,
            preserveDocs = true,
            checkArithmetic = true,
            checkBounds = true,
            checkFloatFinite = true,
            checkUnchecked = true,
            debugInfo = true
        );
    }
    if preset == OptClass.O2 {
        return (
            ok = true,
            error = "",
            preset = OptClass.O2,
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 2,
            emitFormat = EmitFormat.Pretty,
            sourceMap = SourceMapMode.None,
            preserveComments = false,
            preserveDocs = false,
            checkArithmetic = true,
            checkBounds = true,
            checkFloatFinite = true,
            checkUnchecked = false,
            debugInfo = false
        );
    }
    if preset == OptClass.O3 {
        return (
            ok = true,
            error = "",
            preset = OptClass.O3,
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = true,
            inlineMaxSize = 256,
            optRounds = 3,
            emitFormat = EmitFormat.Pretty,
            sourceMap = SourceMapMode.None,
            preserveComments = false,
            preserveDocs = false,
            checkArithmetic = true,
            checkBounds = true,
            checkFloatFinite = true,
            checkUnchecked = false,
            debugInfo = false
        );
    }
    if preset == OptClass.Os {
        return (
            ok = true,
            error = "",
            preset = OptClass.Os,
            constFold = true,
            branchSimplify = true,
            deadStore = true,
            blockPrune = true,
            dce = true,
            inlineLeaves = false,
            inlineMaxSize = 0,
            optRounds = 2,
            emitFormat = EmitFormat.Compact,
            sourceMap = SourceMapMode.None,
            preserveComments = false,
            preserveDocs = false,
            checkArithmetic = true,
            checkBounds = true,
            checkFloatFinite = true,
            checkUnchecked = false,
            debugInfo = false
        );
    }
    /* Default `-O1` preset. */
    (
        ok = true,
        error = "",
        preset = OptClass.O1,
        constFold = false,
        branchSimplify = true,
        deadStore = true,
        blockPrune = true,
        dce = true,
        inlineLeaves = false,
        inlineMaxSize = 0,
        optRounds = 1,
        emitFormat = EmitFormat.Pretty,
        sourceMap = SourceMapMode.None,
        preserveComments = false,
        preserveDocs = false,
        checkArithmetic = true,
        checkBounds = true,
        checkFloatFinite = true,
        checkUnchecked = false,
        debugInfo = false
    )
};

/** Parses a non-negative ASCII integer string; returns `-1` when invalid. */
parseNonNegInt := fn(raw: String): Int {
    n := raw.length();
    if n == 0 or n > 9 { return -1; }
    var acc := 0;
    var i := 0;
    loop i < n {
        ch := raw.at(i);
        d := if ch == "0" { 0 }
        else if ch == "1" { 1 }
        else if ch == "2" { 2 }
        else if ch == "3" { 3 }
        else if ch == "4" { 4 }
        else if ch == "5" { 5 }
        else if ch == "6" { 6 }
        else if ch == "7" { 7 }
        else if ch == "8" { 8 }
        else if ch == "9" { 9 }
        else { -1 };
        if d < 0 { return -1; }
        acc = acc * 10 + d;
        i = i + 1;
    }
    acc
};

/** True when `arg` is a recognized `-f...` or `-fno-...` pass configuration flag. */
pub isPassFlag := fn(arg: String): Bool {
    arg == "-fconst-fold" or arg == "-fno-const-fold" or
    arg == "-fbranch-simplify" or arg == "-fno-branch-simplify" or
    arg == "-fdead-store" or arg == "-fno-dead-store" or
    arg == "-fblock-prune" or arg == "-fno-block-prune" or
    arg == "-fdce" or arg == "-fno-dce" or
    arg == "-finline" or arg == "-fno-inline" or
    arg == "-fpreserve-comments" or arg == "-fno-preserve-comments" or
    arg == "-fpreserve-docs" or arg == "-fno-preserve-docs" or
    arg == "-fcheck-arithmetic" or arg == "-fno-check-arithmetic" or
    arg == "-fcheck-bounds" or arg == "-fno-check-bounds" or
    arg == "-fcheck-float-finite" or arg == "-fno-check-float-finite" or
    arg == "-fcheck-unchecked" or arg == "-fno-check-unchecked" or
    arg == "-fdebug-info" or arg == "-fno-debug-info" or
    arg.startsWithAt(0, "-finline-limit=") or
    arg.startsWithAt(0, "-fopt-rounds=")
};

/** Resolves effective simplification round count (`0..8`), auto-enabling 1 round on `-Oc` when a round pass is opted in. */
pub effectiveOptRounds := fn(cfg: OptConfig): Int {
    hasRoundPass := cfg.branchSimplify or cfg.deadStore or cfg.blockPrune;
    if not hasRoundPass { return 0; }
    if cfg.optRounds < 0 { 1 } else { cfg.optRounds }
};

/** Resolves effective leaf-inline body size limit (`0` disables inlining). */
pub effectiveInlineMaxSize := fn(cfg: OptConfig): Int {
    if not cfg.inlineLeaves { return 0; }
    if cfg.inlineMaxSize > 0 { cfg.inlineMaxSize } else { 256 }
};

/** Returns a copy of `cfg` with updated pass/emission fields. */
withOptFields := fn(
    cfg: OptConfig,
    constFold: Bool, branchSimplify: Bool, deadStore: Bool, blockPrune: Bool, dce: Bool,
    inlineLeaves: Bool, inlineMaxSize: Int, optRounds: Int,
    emitFormat: EmitFormat, sourceMap: SourceMapMode, preserveComments: Bool, preserveDocs: Bool
): OptConfig {
    (
        ok = true,
        error = "",
        preset = cfg.preset,
        =constFold,
        =branchSimplify,
        =deadStore,
        =blockPrune,
        =dce,
        =inlineLeaves,
        =inlineMaxSize,
        =optRounds,
        =emitFormat,
        =sourceMap,
        =preserveComments,
        =preserveDocs,
        checkArithmetic = cfg.checkArithmetic,
        checkBounds = cfg.checkBounds,
        checkFloatFinite = cfg.checkFloatFinite,
        checkUnchecked = cfg.checkUnchecked,
        debugInfo = cfg.debugInfo
    )
};

/** Parses `-O0`..`-O3`, `-Os`, `-Oc`, `--opt`, `--sanitize`, `--emit-format`, `--source-map`, and `-f...` pass/safety overrides. */
pub parseOptConfig := fn(rawArgs: List<String>, target: String): OptConfig {
    var cfg := presetConfig(OptClass.O1, target);
    var hasSanitize := false;
    var ovArith := -1;
    var ovBounds := -1;
    var ovFinite := -1;
    var ovUnchecked := -1;
    var ovDebug := -1;
    args: mut List<String> = rawArgs;
    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--sanitize" {
            hasSanitize = true;
        } else if arg.startsWithAt(0, "-O") {
            parsed := parseOptClass(arg.slice(2, arg.length()));
            if not parsed.ok {
                return failConfig(cfg, "unsupported optimization flag " + arg + " (expected -O0, -O1, -O2, -O3, -Os, or -Oc)");
            }
            cfg = presetConfig(parsed.value, target);
        } else if arg == "--opt" {
            if args.length() == 0 {
                return failConfig(cfg, "missing value for --opt");
            }
            rawOpt := mut args.popFront();
            parsed := parseOptClass(rawOpt);
            if not parsed.ok {
                return failConfig(cfg, "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
            cfg = presetConfig(parsed.value, target);
        } else if arg.startsWithAt(0, "--opt=") {
            rawOpt := arg.slice(6, arg.length());
            parsed := parseOptClass(rawOpt);
            if not parsed.ok {
                return failConfig(cfg, "unsupported optimization level " + rawOpt + " (expected 0, 1, 2, 3, s, or c)");
            }
            cfg = presetConfig(parsed.value, target);
        } else if arg == "--emit-format" {
            if args.length() == 0 {
                return failConfig(cfg, "missing value for --emit-format (expected pretty or compact)");
            }
            rawFmt := mut args.popFront();
            parsedFmt := parseEmitFormat(rawFmt);
            if not parsedFmt.ok {
                return failConfig(cfg, "unsupported --emit-format " + rawFmt + " (expected pretty or compact)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, parsedFmt.value, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg.startsWithAt(0, "--emit-format=") {
            rawFmt := arg.slice(14, arg.length());
            parsedFmt := parseEmitFormat(rawFmt);
            if not parsedFmt.ok {
                return failConfig(cfg, "unsupported --emit-format " + rawFmt + " (expected pretty or compact)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, parsedFmt.value, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "--source-map" {
            if args.length() == 0 {
                return failConfig(cfg, "missing value for --source-map (expected none, comments, or lines)");
            }
            rawSm := mut args.popFront();
            parsedSm := parseSourceMapMode(rawSm);
            if not parsedSm.ok {
                return failConfig(cfg, "unsupported --source-map " + rawSm + " (expected none, comments, or lines)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, parsedSm.value, cfg.preserveComments, cfg.preserveDocs);
        } else if arg.startsWithAt(0, "--source-map=") {
            rawSm := arg.slice(13, arg.length());
            parsedSm := parseSourceMapMode(rawSm);
            if not parsedSm.ok {
                return failConfig(cfg, "unsupported --source-map " + rawSm + " (expected none, comments, or lines)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, parsedSm.value, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fconst-fold" or arg == "-fno-const-fold" {
            cfg = withOptFields(cfg, arg == "-fconst-fold", cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fbranch-simplify" or arg == "-fno-branch-simplify" {
            cfg = withOptFields(cfg, cfg.constFold, arg == "-fbranch-simplify", cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fdead-store" or arg == "-fno-dead-store" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, arg == "-fdead-store", cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fblock-prune" or arg == "-fno-block-prune" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, arg == "-fblock-prune", cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fdce" or arg == "-fno-dce" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, arg == "-fdce", cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-finline" {
            lim := if cfg.inlineMaxSize > 0 { cfg.inlineMaxSize } else { 256 };
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, true, lim, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fno-inline" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, false, 0, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg.startsWithAt(0, "-finline-limit=") {
            rawN := arg.slice(15, arg.length());
            n := parseNonNegInt(rawN);
            if n < 0 {
                return failConfig(cfg, "invalid -finline-limit value " + rawN + " (expected non-negative integer)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, n > 0, n, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg.startsWithAt(0, "-fopt-rounds=") {
            rawN := arg.slice(13, arg.length());
            n := parseNonNegInt(rawN);
            if n < 0 or n > 8 {
                return failConfig(cfg, "invalid -fopt-rounds value " + rawN + " (expected 0..8)");
            }
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, n, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, cfg.preserveDocs);
        } else if arg == "-fpreserve-comments" or arg == "-fno-preserve-comments" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, arg == "-fpreserve-comments", cfg.preserveDocs);
        } else if arg == "-fpreserve-docs" or arg == "-fno-preserve-docs" {
            cfg = withOptFields(cfg, cfg.constFold, cfg.branchSimplify, cfg.deadStore, cfg.blockPrune, cfg.dce, cfg.inlineLeaves, cfg.inlineMaxSize, cfg.optRounds, cfg.emitFormat, cfg.sourceMap, cfg.preserveComments, arg == "-fpreserve-docs");
        } else if arg == "-fcheck-arithmetic" { ovArith = 1; }
        else if arg == "-fno-check-arithmetic" { ovArith = 0; }
        else if arg == "-fcheck-bounds" { ovBounds = 1; }
        else if arg == "-fno-check-bounds" { ovBounds = 0; }
        else if arg == "-fcheck-float-finite" { ovFinite = 1; }
        else if arg == "-fno-check-float-finite" { ovFinite = 0; }
        else if arg == "-fcheck-unchecked" { ovUnchecked = 1; }
        else if arg == "-fno-check-unchecked" { ovUnchecked = 0; }
        else if arg == "-fdebug-info" { ovDebug = 1; }
        else if arg == "-fno-debug-info" { ovDebug = 0; }
        else if arg.startsWithAt(0, "-f") {
            return failConfig(cfg, "unsupported optimization pass flag " + arg);
        } else if arg == "--builtin-mode" or arg == "--name" or arg == "--root" or arg == "--out" or arg == "--trace-json" {
            if args.length() > 0 {
                _skip := mut args.popFront();
            }
        }
    }
    resArith := if ovArith >= 0 { ovArith == 1 } else if hasSanitize { true } else { cfg.checkArithmetic };
    resBounds := if ovBounds >= 0 { ovBounds == 1 } else if hasSanitize { true } else { cfg.checkBounds };
    resFinite := if ovFinite >= 0 { ovFinite == 1 } else if hasSanitize { true } else { cfg.checkFloatFinite };
    resUnchecked := if ovUnchecked >= 0 { ovUnchecked == 1 } else if hasSanitize { true } else { cfg.checkUnchecked };
    resDebug := if ovDebug >= 0 { ovDebug == 1 } else if hasSanitize { true } else { cfg.debugInfo };
    withSafetyFlags(cfg, resArith, resBounds, resFinite, resUnchecked, resDebug)
};
