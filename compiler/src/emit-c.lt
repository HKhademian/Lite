    }
    if usesIntHelper(calls, "lite$ioRead(") {
        outLine("static lt_list_i64 lt_io_read(" + shTag + " reader, int64_t max_bytes) {");
        outLine("    lt_list_i64 empty = { NULL, 0u, 0u };");
        outLine("    if (max_bytes <= 0) { return empty; }");
        outLine("    if (strcmp(lt_text_cstr(reader." + fKind + "), \"stdin\") == 0 && reader." + fHandle + " == 0) {");
        outLine("        if (lt_stdin_err[0] != '\\0' || lt_stdin_eof) { return empty; }");
        outLine("        size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        outLine("        uint8_t *tmp = malloc(cap);");
        outLine("        if (tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate read buffer\\n\"); exit(1); }");
        outLine("        ssize_t n = read(0, tmp, cap);");
        outLine("        if (n < 0) { lt_stdin_err = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        outLine("        if (n == 0) { lt_stdin_eof = true; free(tmp); return empty; }");
        outLine("        int64_t *data = (int64_t *)lt_heap_alloc((size_t)n * sizeof(int64_t));");
        outLine("        for (ssize_t i = 0; i < n; i += 1) { data[i] = (int64_t)tmp[i]; }");
        outLine("        free(tmp);");
        outLine("        return (lt_list_i64){ data, (uint32_t)n, (uint32_t)n };");
        outLine("    }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    if (e == NULL || e->closed || e->error[0] != '\\0' || e->kind == 4 || e->kind == 3 || e->eof) { return empty; }");
        outLine("    if (e->kind == 2) {");
        outLine("        int64_t avail = e->len - e->pos;");
        outLine("        int64_t take = max_bytes > avail ? avail : max_bytes;");
        outLine("        if (take <= 0) { e->eof = true; return empty; }");
        outLine("        int64_t *data = (int64_t *)lt_heap_alloc((size_t)take * sizeof(int64_t));");
        outLine("        for (int64_t i = 0; i < take; i += 1) { data[i] = (int64_t)e->buf[e->pos + i]; }");
        outLine("        e->pos += take;");
        outLine("        return (lt_list_i64){ data, (uint32_t)take, (uint32_t)take };");
        outLine("    }");
        outLine("    size_t cap = max_bytes > 16777216 ? 16777216 : (size_t)max_bytes;");
        outLine("    uint8_t *tmp = malloc(cap);");
        outLine("    if (tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate read buffer\\n\"); exit(1); }");
        outLine("    ssize_t n = read(e->fd, tmp, cap);");
        outLine("    if (n < 0) { e->error = lt_dup_str(strerror(errno)); free(tmp); return empty; }");
        outLine("    if (n == 0) { e->eof = true; free(tmp); return empty; }");
        outLine("    int64_t *data = (int64_t *)lt_heap_alloc((size_t)n * sizeof(int64_t));");
        outLine("    for (ssize_t i = 0; i < n; i += 1) { data[i] = (int64_t)tmp[i]; }");
        outLine("    free(tmp);");
        outLine("    return (lt_list_i64){ data, (uint32_t)n, (uint32_t)n };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioCloseReader(") {
        outLine("static " + okErrTag + " lt_io_close_reader(" + shTag + " reader) {");
        outLine("    if (strcmp(lt_text_cstr(reader." + fKind + "), \"stdin\") == 0 && reader." + fHandle + " == 0) { return (" + okErrTag + "){ true, LT_ASTR(\"\") }; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okErrTag + "){ false, LT_ASTR(\"invalid reader handle\") }; }");
        outLine("    if (e->kind == 4) { return (" + okErrTag + "){ false, lt_text_from_cstr(e->error) }; }");
        outLine("    if (e->kind == 3) { return (" + okErrTag + "){ false, LT_ASTR(\"handle is a writer, not a reader\") }; }");
        outLine("    if (e->kind == 1 && !e->closed) {");
        outLine("        int rc = close(e->fd);");
        outLine("        e->closed = true;");
        outLine("        if (rc < 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    }");
        outLine("    e->closed = true;");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterError(") {
        outLine("static lt_str lt_io_writer_error(" + shTag + " writer) {");
        outLine("    if ((strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2)) { return LT_ASTR(\"\"); }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return LT_ASTR(\"invalid writer handle\"); }");
        outLine("    if (e->kind == 2) { return LT_ASTR(\"handle is a reader, not a writer\"); }");
        outLine("    if (e->error[0] != '\\0') { return lt_text_from_cstr(e->error); }");
        outLine("    if (e->closed) { return LT_ASTR(\"writer is closed\"); }");
        outLine("    return LT_ASTR(\"\");");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterOk(") {
        outLine("static bool lt_io_writer_ok(" + shTag + " writer) {");
        outLine("    if ((strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2)) { return true; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    return e != NULL && (e->kind == 1 || e->kind == 3) && !e->closed && e->error[0] == '\\0';");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWrite(") {
        outLine("static " + okWrittenTag + " lt_io_write(" + shTag + " writer, lt_list_i64 bytes) {");
        outLine("    uint8_t *tmp = bytes.len > 0 ? malloc((size_t)bytes.len) : NULL;");
        outLine("    if (bytes.len > 0 && tmp == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate write buffer\\n\"); exit(1); }");
        outLine("    for (int64_t i = 0; i < bytes.len; i += 1) {");
        outLine("        if (bytes.data[i] < 0 || bytes.data[i] > 255) { free(tmp); return (" + okWrittenTag + "){ false, 0, LT_ASTR(\"byte value outside 0..255\") }; }");
        outLine("        tmp[i] = (uint8_t)bytes.data[i];");
        outLine("    }");
        outLine("    int target_fd = -1;");
        outLine("    lt_stream_entry *e = NULL;");
        outLine("    if (strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) { target_fd = 1; }");
        outLine("    else if (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2) { target_fd = 2; }");
        outLine("    else {");
        outLine("        e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("        if (e == NULL) { free(tmp); return (" + okWrittenTag + "){ false, 0, LT_ASTR(\"invalid writer handle\") }; }");
        outLine("        if (e->kind == 4) { free(tmp); return (" + okWrittenTag + "){ false, 0, lt_text_from_cstr(e->error) }; }");
        outLine("        if (e->kind == 2) { free(tmp); return (" + okWrittenTag + "){ false, 0, LT_ASTR(\"handle is a reader, not a writer\") }; }");
        outLine("        if (e->closed) { free(tmp); return (" + okWrittenTag + "){ false, 0, LT_ASTR(\"writer is closed\") }; }");
        outLine("        if (e->error[0] != '\\0') { free(tmp); return (" + okWrittenTag + "){ false, 0, lt_text_from_cstr(e->error) }; }");
        outLine("        if (e->kind == 3) {");
        outLine("            if (bytes.len > 0) {");
        outLine("                if (e->len + bytes.len > e->cap) {");
        outLine("                    int64_t ncap = e->cap == 0 ? 64 : e->cap * 2;");
        outLine("                    while (ncap < e->len + bytes.len) { ncap *= 2; }");
        outLine("                    e->buf = realloc(e->buf, (size_t)ncap);");
        outLine("                    if (e->buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow buffer writer\\n\"); exit(1); }");
        outLine("                    e->cap = ncap;");
        outLine("                }");
        outLine("                memcpy(e->buf + e->len, tmp, (size_t)bytes.len);");
        outLine("                e->len += bytes.len;");
        outLine("            }");
        outLine("            free(tmp);");
        outLine("            return (" + okWrittenTag + "){ true, bytes.len, LT_ASTR(\"\") };");
        outLine("        }");
        outLine("        target_fd = e->fd;");
        outLine("    }");
        outLine("    int64_t off = 0;");
        outLine("    while (off < bytes.len) {");
        outLine("        ssize_t n = write(target_fd, tmp + off, (size_t)(bytes.len - off));");
        outLine("        if (n < 0) {");
        outLine("            const char *msg = lt_dup_str(strerror(errno));");
        outLine("            if (e != NULL) { e->error = msg; }");
        outLine("            free(tmp);");
        outLine("            return (" + okWrittenTag + "){ false, 0, lt_text_from_cstr(msg) };");
        outLine("        }");
        outLine("        off += (int64_t)n;");
        outLine("    }");
        outLine("    free(tmp);");
        outLine("    return (" + okWrittenTag + "){ true, bytes.len, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioFlush(") {
        outLine("static " + okErrTag + " lt_io_flush(" + shTag + " writer) {");
        outLine("    if ((strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2)) { return (" + okErrTag + "){ true, LT_ASTR(\"\") }; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okErrTag + "){ false, LT_ASTR(\"invalid writer handle\") }; }");
        outLine("    if (e->kind == 4) { return (" + okErrTag + "){ false, lt_text_from_cstr(e->error) }; }");
        outLine("    if (e->kind == 2) { return (" + okErrTag + "){ false, LT_ASTR(\"handle is a reader, not a writer\") }; }");
        outLine("    if (e->closed) { return (" + okErrTag + "){ false, LT_ASTR(\"writer is closed\") }; }");
        outLine("    if (e->kind == 3) { return (" + okErrTag + "){ true, LT_ASTR(\"\") }; }");
        outLine("    if (fsync(e->fd) < 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioCloseWriter(") {
        outLine("static " + okErrTag + " lt_io_close_writer(" + shTag + " writer) {");
        outLine("    if ((strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) || (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2)) { return (" + okErrTag + "){ true, LT_ASTR(\"\") }; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okErrTag + "){ false, LT_ASTR(\"invalid writer handle\") }; }");
        outLine("    if (e->kind == 4) { return (" + okErrTag + "){ false, lt_text_from_cstr(e->error) }; }");
        outLine("    if (e->kind == 2) { return (" + okErrTag + "){ false, LT_ASTR(\"handle is a reader, not a writer\") }; }");
        outLine("    if (e->kind == 1 && !e->closed) {");
        outLine("        int rc = close(e->fd);");
        outLine("        e->closed = true;");
        outLine("        if (rc < 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    }");
        outLine("    e->closed = true;");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterBytes(") {
        outLine("static lt_list_i64 lt_io_writer_bytes(" + shTag + " writer) {");
        outLine("    lt_list_i64 empty = { NULL, 0u, 0u };");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL || e->kind != 3 || e->len <= 0) { return empty; }");
        outLine("    int64_t *data = (int64_t *)lt_heap_alloc((size_t)e->len * sizeof(int64_t));");
        outLine("    for (int64_t i = 0; i < e->len; i += 1) { data[i] = (int64_t)e->buf[i]; }");
        outLine("    return (lt_list_i64){ data, (uint32_t)e->len, (uint32_t)e->len };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioWriterText(") {
        outLine("static " + okTextTag + " lt_io_writer_text(" + shTag + " writer) {");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e == NULL) { return (" + okTextTag + "){ false, LT_ASTR(\"\"), LT_ASTR(\"invalid writer handle\") }; }");
        outLine("    if (e->kind != 3) { return (" + okTextTag + "){ false, LT_ASTR(\"\"), LT_ASTR(\"writer is not a buffer writer\") }; }");
        outLine("    if (e->error[0] != '\\0') { return (" + okTextTag + "){ false, LT_ASTR(\"\"), lt_text_from_cstr(e->error) }; }");
        outLine("    int32_t cp = 0;");
        outLine("    for (int64_t i = 0; i < e->len; ) {");
        outLine("        uint8_t b0 = e->buf[i];");
        outLine("        if (b0 < 0x80) { i += 1; cp += 1; }");
        outLine("        else if (b0 >= 0xC2 && b0 <= 0xDF && i + 1 < e->len && (e->buf[i + 1] & 0xC0) == 0x80) { i += 2; cp += 1; }");
        outLine("        else if (b0 >= 0xE0 && b0 <= 0xEF && i + 2 < e->len && (e->buf[i + 1] & 0xC0) == 0x80 && (e->buf[i + 2] & 0xC0) == 0x80 && !(b0 == 0xE0 && e->buf[i + 1] < 0xA0) && !(b0 == 0xED && e->buf[i + 1] >= 0xA0)) { i += 3; cp += 1; }");
        outLine("        else if (b0 >= 0xF0 && b0 <= 0xF4 && i + 3 < e->len && (e->buf[i + 1] & 0xC0) == 0x80 && (e->buf[i + 2] & 0xC0) == 0x80 && (e->buf[i + 3] & 0xC0) == 0x80 && !(b0 == 0xF0 && e->buf[i + 1] < 0x90) && !(b0 == 0xF4 && e->buf[i + 1] >= 0x90)) { i += 4; cp += 1; }");
        outLine("        else { return (" + okTextTag + "){ false, LT_ASTR(\"\"), LT_ASTR(\"invalid UTF-8 byte sequence\") }; }");
        outLine("    }");
        outLine("    char *out = malloc((size_t)e->len + 1);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate writer text\\n\"); exit(1); }");
        outLine("    if (e->len > 0) { memcpy(out, e->buf, (size_t)e->len); }");
        outLine("    out[e->len] = '\\0';");
        outLine("    return (" + okTextTag + "){ true, lt_text_from_buf(out, (size_t)e->len, cp), LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioClearWriter(") {
        outLine("static void lt_io_clear_writer(" + shTag + " writer) {");
        outLine("    lt_stream_entry *e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("    if (e != NULL && e->kind == 3) { e->len = 0; }");
        outLine("}");
    }
};

/** Emits C11 `core/file` non-stream filesystem builtin helpers. */
emitCFileBuiltinHelpers := fn(calls: Set<String>): Unit {
    if not usesFileBuiltins(calls) { return; }
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    okPathTag := frontend.cStructTag("(ok:Bool,path:String,error:String)");
    if usesIntHelper(calls, "lite$fileKind(") {
        outLine("static lt_str lt_file_kind(lt_str path_s) {");
        outLine("    struct stat st;");
        outLine("    if (stat(lt_text_cstr(path_s), &st) != 0) { return LT_ASTR(\"missing\"); }");
        outLine("    if (S_ISREG(st.st_mode)) { return LT_ASTR(\"file\"); }");
        outLine("    if (S_ISDIR(st.st_mode)) { return LT_ASTR(\"dir\"); }");
        outLine("    return LT_ASTR(\"other\");");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileListDir(") {
        outLine("static int lt_cmp_ltstr(const void *a, const void *b) {");
        outLine("    const lt_str *sa = (const lt_str *)a;");
        outLine("    const lt_str *sb = (const lt_str *)b;");
        outLine("    return strcmp(lt_str_data(sa), lt_str_data(sb));");
        outLine("}");
        outLine("static lt_list_str lt_file_list_dir(lt_str path_s) {");
        outLine("    const char *path = lt_text_cstr(path_s);");
        outLine("    DIR *d = opendir(path);");
        outLine("    if (d == NULL) { fprintf(stderr, \"cannot list directory %s: %s\\n\", path, strerror(errno)); exit(2); }");
        outLine("    int64_t len = 0; int64_t cap = 16;");
        outLine("    lt_str *data = (lt_str *)lt_heap_alloc((size_t)cap * sizeof(lt_str));");
        outLine("    struct dirent *ent;");
        outLine("    while ((ent = readdir(d)) != NULL) {");
        outLine("        if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) { continue; }");
        outLine("        if (len >= cap) { int64_t ncap = cap * 2; data = (lt_str *)lt_heap_realloc(data, (size_t)cap * sizeof(lt_str), (size_t)ncap * sizeof(lt_str)); cap = ncap; }");
        outLine("        data[len++] = lt_text_from_cstr(ent->d_name);");
        outLine("    }");
        outLine("    closedir(d);");
        outLine("    if (len == 0) { lt_heap_free(data); return (lt_list_str){ NULL, 0u, 0u }; }");
        outLine("    if (len > 1) { qsort(data, (size_t)len, sizeof(lt_str), lt_cmp_ltstr); }");
        outLine("    return (lt_list_str){ data, (uint32_t)len, (uint32_t)cap };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileMakeDir(") {
        outLine("static " + okErrTag + " lt_file_make_dir(lt_str path_s) {");
        outLine("    const char *path = lt_str_data(&path_s);");
        outLine("    size_t plen = lt_str_byte_len(path_s);");
        outLine("    if (plen == 0u) { return (" + okErrTag + "){ false, LT_ASTR(\"empty path\") }; }");
        outLine("    char *tmp = lt_dup_str(path);");
        outLine("    size_t n = plen;");
        outLine("    while (n > 1 && tmp[n - 1] == '/') { tmp[--n] = '\\0'; }");
        outLine("    for (size_t i = 1; i < n; i += 1) {");
        outLine("        if (tmp[i] == '/') {");
        outLine("            tmp[i] = '\\0';");
        outLine("            if (mkdir(tmp, 0777) != 0 && errno != EEXIST) { const char *err = lt_dup_str(strerror(errno)); free(tmp); return (" + okErrTag + "){ false, lt_text_from_cstr(err) }; }");
        outLine("            tmp[i] = '/';");
        outLine("        }");
        outLine("    }");
        outLine("    if (mkdir(tmp, 0777) != 0) {");
        outLine("        struct stat st;");
        outLine("        if (!(errno == EEXIST && stat(tmp, &st) == 0 && S_ISDIR(st.st_mode))) {");
        outLine("            const char *err = lt_dup_str(strerror(errno)); free(tmp); return (" + okErrTag + "){ false, lt_text_from_cstr(err) };");
        outLine("        }");
        outLine("    }");
        outLine("    free(tmp);");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileRemove(") {
        outLine("static " + okErrTag + " lt_file_remove(lt_str path_s) {");
        outLine("    const char *path = lt_str_data(&path_s);");
        outLine("    size_t path_len = lt_str_byte_len(path_s);");
        outLine("    struct stat st;");
        outLine("    if (lstat(path, &st) != 0) {");
        outLine("        if (errno == ENOENT) { return (" + okErrTag + "){ true, LT_ASTR(\"\") }; }");
        outLine("        return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) };");
        outLine("    }");
