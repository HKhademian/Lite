        outLine("}");
        outLine("LT_INLINE " + okErrTag + " lt_canvas_capture(" + surfTag + " surf, lt_str out_path) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle);");
        outLine("    if (!s) return (" + okErrTag + "){ .f_ok = false, .f_error = LT_ASTR(\"invalid canvas surface handle\") };");
        outLine("    FILE *f = fopen(lt_text_cstr(out_path), \"wb\");");
        outLine("    if (!f) return (" + okErrTag + "){ .f_ok = false, .f_error = LT_ASTR(\"cannot open output path\") };");
        outLine("    static const uint8_t sig[8] = {137,80,78,71,13,10,26,10};");
        outLine("    uint8_t ihdr[13] = {0}; lt_png_u32(ihdr, (uint32_t)s->w); lt_png_u32(ihdr + 4, (uint32_t)s->h); ihdr[8] = 8; ihdr[9] = 6;");
        outLine("    size_t stride = 1u + (size_t)s->w * 4u; size_t raw_len = (size_t)s->h * stride;");
        outLine("    uint8_t *raw = malloc(raw_len); if (!raw) { fclose(f); return (" + okErrTag + "){ .f_ok = false, .f_error = LT_ASTR(\"out of memory\") }; }");
        outLine("    for (int y = 0; y < s->h; y += 1) { raw[(size_t)y * stride] = 0; memcpy(raw + (size_t)y * stride + 1u, s->pixels + (size_t)y * (size_t)s->w * 4u, (size_t)s->w * 4u); }");
        outLine("    size_t blocks = (raw_len + 65534u) / 65535u; if (blocks == 0) blocks = 1;");
        outLine("    size_t zlen = 2u + raw_len + blocks * 5u + 4u;");
        outLine("    uint8_t *z = malloc(zlen); if (!z) { free(raw); fclose(f); return (" + okErrTag + "){ .f_ok = false, .f_error = LT_ASTR(\"out of memory\") }; }");
        outLine("    size_t zp = 0; z[zp++] = 0x78; z[zp++] = 0x01;");
        outLine("    uint32_t a1 = 1u, a2 = 0u;");
        outLine("    for (size_t i = 0; i < raw_len; i += 1) { a1 = (a1 + raw[i]) % 65521u; a2 = (a2 + a1) % 65521u; }");
        outLine("    size_t off = 0; while (off < raw_len || (raw_len == 0 && off == 0)) {");
        outLine("        size_t chunk = raw_len - off; if (chunk > 65535u) chunk = 65535u;");
        outLine("        bool last = (off + chunk >= raw_len);");
        outLine("        z[zp++] = last ? 1u : 0u; z[zp++] = (uint8_t)(chunk & 255u); z[zp++] = (uint8_t)((chunk >> 8) & 255u);");
        outLine("        uint16_t nlen = (uint16_t)(~chunk); z[zp++] = (uint8_t)(nlen & 255u); z[zp++] = (uint8_t)((nlen >> 8) & 255u);");
        outLine("        if (chunk > 0) { memcpy(z + zp, raw + off, chunk); zp += chunk; }");
        outLine("        off += chunk; if (raw_len == 0) break;");
        outLine("    }");
        outLine("    lt_png_u32(z + zp, (a2 << 16) | a1); zp += 4u;");
        outLine("    bool ok = fwrite(sig, 1, 8, f) == 8 && lt_png_chunk(f, \"IHDR\", ihdr, 13u) && lt_png_chunk(f, \"IDAT\", z, zp) && lt_png_chunk(f, \"IEND\", NULL, 0u);");
        outLine("    free(z); free(raw); fclose(f);");
        outLine("    return (" + okErrTag + "){ .f_ok = ok, .f_error = ok ? LT_ASTR(\"\") : LT_ASTR(\"failed writing PNG\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasPlayTone(") {
        outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
        outLine("static id lt_sound_ring[16];");
        outLine("static int lt_sound_ring_idx = 0;");
        outLine("LT_INLINE void lt_wav_u16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)(v & 0xffu); p[1] = (uint8_t)(v >> 8); }");
        outLine("LT_INLINE void lt_wav_u32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)(v & 0xffu); p[1] = (uint8_t)((v >> 8) & 0xffu); p[2] = (uint8_t)((v >> 16) & 0xffu); p[3] = (uint8_t)(v >> 24); }");
        outLine("#endif");
        outLine("LT_INLINE void lt_canvas_play_tone(" + surfTag + " surf, int64_t freq, int64_t duration_ms, int64_t volume) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle);");
        outLine("    if (!s || s->headless || freq < 20 || freq > 20000 || duration_ms <= 0 || duration_ms > 3000 || volume <= 0) return;");
