        outLine("    uint8_t buf[65536];");
        outLine("    for (;;) {");
        outLine("        ssize_t n = read(in_fd, buf, sizeof(buf));");
        outLine("        if (n < 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); close(out_fd); return (" + okErrTag + "){ false, lt_text_from_cstr(err) }; }");
        outLine("        if (n == 0) { break; }");
        outLine("        ssize_t off = 0;");
        outLine("        while (off < n) {");
        outLine("            ssize_t w = write(out_fd, buf + off, (size_t)(n - off));");
        outLine("            if (w < 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); close(out_fd); return (" + okErrTag + "){ false, lt_text_from_cstr(err) }; }");
        outLine("            off += w;");
        outLine("        }");
        outLine("    }");
        outLine("    if (fchmod(out_fd, (mode_t)(st.st_mode & 0777)) != 0) { const char *err = lt_dup_str(strerror(errno)); close(in_fd); close(out_fd); return (" + okErrTag + "){ false, lt_text_from_cstr(err) }; }");
        outLine("    close(in_fd); close(out_fd);");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
