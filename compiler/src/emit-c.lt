        outLine("    if (symlink(lt_text_cstr(target_path), lt_text_cstr(link_path)) != 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileRealPath(") {
        outLine("static " + okPathTag + " lt_file_real_path(lt_str path) {");
