        outLine("LT_INLINE bool lt_png_chunk(FILE *f, const char *tag, const uint8_t *data, size_t len) {");
        outLine("    uint8_t *buf = malloc(4u + len); if (!buf) return false;");
        outLine("    memcpy(buf, tag, 4u); if (len > 0) memcpy(buf + 4u, data, len);");
        outLine("    uint8_t hdr[4], crc[4]; lt_png_u32(hdr, (uint32_t)len); lt_png_u32(crc, lt_png_crc(buf, 4u + len));");
        outLine("    bool ok = fwrite(hdr, 1, 4, f) == 4 && fwrite(buf, 1, 4u + len, f) == 4u + len && fwrite(crc, 1, 4, f) == 4;");
