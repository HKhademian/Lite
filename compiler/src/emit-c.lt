    mut cBuiltinMap.set("processCwd", "lt_process_cwd");
    mut cBuiltinMap.set("processExecPath", "lt_process_exec_path");
    mut cBuiltinMap.set("processEntryPath", "lt_process_entry_path");
    mut cBuiltinMap.set("processPlatform", "lt_process_platform");
    mut cBuiltinMap.set("processArch", "lt_process_arch");
    mut cBuiltinMap.set("processRuntimeVersion", "lt_process_runtime_version");
    mut cBuiltinMap.set("processEnvGet", "lt_process_env_get");
    mut cBuiltinMap.set("processRun", "lt_process_run");
    mut cBuiltinMap.set("processRunBytes", "lt_process_run_bytes");
    mut cBuiltinMap.set("cryptoRandomBytes", "lt_crypto_random_bytes");
    mut cBuiltinMap.set("timeMonotonicNs", "lt_time_monotonic_ns");
    mut cBuiltinMap.set("timeEpochNs", "lt_time_epoch_ns");
    mut cBuiltinMap.set("timeSleepMs", "lt_time_sleep_ms");
    mut cBuiltinMap.set("timeLocalDate", "lt_time_local_date");
    mut cBuiltinMap.set("extPoolCpuCount", "lt_ext_pool_cpu_count");
    mut cBuiltinMap.set("extPoolRunJson", "lt_ext_pool_run_json");
