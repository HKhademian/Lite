        outLine("        return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("    }");
        outLine("    if (unlink(path) != 0 && errno != ENOENT) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileCopy(") {
        outLine("static " + okErrTag + " lt_file_copy(lt_str from_s, lt_str to_s) {");
        outLine("    const char *from_path = lt_str_data(&from_s);");
        outLine("    const char *to_path = lt_str_data(&to_s);");
        outLine("    size_t from_len = lt_str_byte_len(from_s);");
        outLine("    size_t to_len = lt_str_byte_len(to_s);");
        outLine("    struct stat st;");
        outLine("    if (lstat(from_path, &st) != 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    if (S_ISLNK(st.st_mode)) {");
        outLine("        char lbuf[4096];");
        outLine("        ssize_t n = readlink(from_path, lbuf, sizeof(lbuf) - 1);");
        outLine("        if (n < 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("        lbuf[n] = '\\0';");
        outLine("        unlink(to_path);");
        outLine("        if (symlink(lbuf, to_path) != 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("        return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("    }");
        outLine("    if (S_ISDIR(st.st_mode)) {");
        outLine("        if (mkdir(to_path, 0777) != 0 && errno != EEXIST) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("        DIR *d = opendir(from_path);");
        outLine("        if (d == NULL) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("        struct dirent *ent;");
        outLine("        while ((ent = readdir(d)) != NULL) {");
        outLine("            if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) { continue; }");
        outLine("            size_t slen = from_len + 1u + strlen(ent->d_name) + 1u;");
        outLine("            size_t dlen = to_len + 1u + strlen(ent->d_name) + 1u;");
        outLine("            char *sp = malloc(slen); char *dp = malloc(dlen);");
        outLine("            if (sp == NULL || dp == NULL) { free(sp); free(dp); closedir(d); return (" + okErrTag + "){ false, LT_ASTR(\"out of memory\") }; }");
        outLine("            snprintf(sp, slen, \"%s/%s\", from_path, ent->d_name);");
        outLine("            snprintf(dp, dlen, \"%s/%s\", to_path, ent->d_name);");
        outLine("            " + okErrTag + " sub = lt_file_copy(lt_text_from_cstr(sp), lt_text_from_cstr(dp));");
        outLine("            free(sp); free(dp);");
        outLine("            if (!sub." + frontend.cFieldName("ok") + ") { closedir(d); return sub; }");
        outLine("        }");
        outLine("        closedir(d);");
        outLine("        return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("    }");
        outLine("    int in_fd = open(from_path, O_RDONLY);");
        outLine("    if (in_fd < 0) { return (" + okErrTag + "){ false, lt_text_from_cstr(lt_dup_str(strerror(errno))) }; }");
        outLine("    unlink(to_path);");
