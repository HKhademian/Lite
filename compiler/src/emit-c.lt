frontend := import "./frontend";
numeric := import "./numeric-literals";
cLiteral := import "./c-literals";
emitFmt := import "./emit-format";
optCfg := import "./opt-config";
diagLib := import "core/diag";
io := import "core/io";
textLib := import "core/text";
tb := import "util/text-builder";

var cOutUseWriter := false;
var cCompactEmit := false;
var cSourceMapMode: optCfg.SourceMapMode = optCfg.SourceMapMode.None;
cOutBuf: mut tb.TextBuilder;

/** Emits one C11 line to either stdout or the buffered `TextBuilder` for `--out`. */
outLine := fn(s: String): Unit {
    line := if cCompactEmit { s.trimStart() } else { emitFmt.formatEmittedLine(s) };
    if cCompactEmit and line == "" { return; }
    if not cOutUseWriter {
        io.outputLine(line);
    } else {
        mut cOutBuf.appendLine(line);
    }
};

/** Emits raw C11 text to either stdout or the buffered `TextBuilder` for `--out`. */
outText := fn(s: String): Unit {
    if not cOutUseWriter {
        io.output(s);
    } else {
        mut cOutBuf.append(s);
    }
};

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    indent.slice(0, indent.length() - 4)
}

/** Returns the C11 scalar list tag (`i64`, `f64`, `bool`, `str`) for a List or wildcard Array kind, or `""` for concrete fixed arrays `[T; N]` and other kinds. */
cListTagForKind := fn(kind: String): String {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind)); }
    if frontend.isListKind(kind) { frontend.cListTag(frontend.listElementKind(kind)) }
    else if frontend.isArrayKind(kind) and frontend.cArrayTag(kind) == "" { frontend.cListTag(frontend.arrayElementKind(kind)) }
    else { "" }
};

/** Maps a restricted Lite scalar, enum, struct, fixed array, map, set, list, or Unit/Never kind to its C11 type. */
cScalarType := fn(kind: String): String {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind)); }
    listTag := cListTagForKind(kind);
    if listTag =!= "" { "lt_list_" + listTag }
    else if frontend.cArrayTag(kind) =!= "" { frontend.cArrayTag(kind) }
    else if frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) }
    else if frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) }
    else if frontend.cRcTag(kind) =!= "" { frontend.cRcTag(kind) }
    else if frontend.cSliceTag(kind) =!= "" { frontend.cSliceTag(kind) }
    else if frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) }
    else if frontend.cFnTag(kind) =!= "" { frontend.cFnTag(kind) }
    else if kind == frontend.VALUE_KIND_UNIT or kind == frontend.VALUE_KIND_NEVER { "void" }
    else if kind == frontend.VALUE_KIND_INT1 or kind == frontend.VALUE_KIND_INT2 or kind == frontend.VALUE_KIND_INT4 or kind == frontend.VALUE_KIND_INT8 { "int8_t" }
    else if kind == frontend.VALUE_KIND_INT16 { "int16_t" }
    else if kind == frontend.VALUE_KIND_INT32 { "int32_t" }
    else if kind == frontend.VALUE_KIND_UINT1 or kind == frontend.VALUE_KIND_UINT2 or kind == frontend.VALUE_KIND_UINT4 or kind == frontend.VALUE_KIND_UINT8 or kind == frontend.VALUE_KIND_FLOAT8 { "uint8_t" }
    else if kind == frontend.VALUE_KIND_UINT16 { "uint16_t" }
    else if kind == frontend.VALUE_KIND_UINT32 { "uint32_t" }
    else if kind == frontend.VALUE_KIND_UINT64 { "uint64_t" }
    else if kind == frontend.VALUE_KIND_FLOAT16 { "lt_f16" }
    else if kind == frontend.VALUE_KIND_FLOAT32 { "float" }
    else if frontend.isEnumKind(kind) and not frontend.isPayloadEnumKind(kind) { frontend.plainEnumCStorage(kind).cType }
    else if frontend.isIntScalarKind(kind) { "int64_t" }
    else if frontend.VALUE_KIND_BOOL == kind { "bool" }
    else if frontend.isFloatScalarKind(kind) { "double" }
    else { "lt_str" }
};

/** Returns canonical C11 type and ownership helper names (`_drop`, `_copy`, `_move`) for `kind`. */
cKindOps := fn(kind: String): (cType: String, dropFn: String, copyFn: String, moveFn: String) {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind)); }
    cT := cScalarType(kind);
    dropFn := frontend.cDropFnForKind(kind);
    if dropFn == "" {
        return (cType = cT, dropFn = "", copyFn = "", moveFn = "");
    }
    stem := dropFn.slice(0, dropFn.length() - 5);
    (cType = cT, =dropFn, copyFn = stem + "_copy", moveFn = stem + "_move")
};

/** Maps a local or mutable variable item to its C11 declaration type prefix. */
cDeclTypeItem := fn(item: frontend.Item): String {
    kind := item.kind;
    if kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST {
        cScalarType(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE {
        frontend.cStructTag(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_FN or kind == frontend.ITEM_KIND_VAR_FN {
        cScalarType(item.textValue) + " "
    } else if kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT {
        if item.textValue =!= "" { cScalarType(item.textValue) + " " } else { "int64_t " }
    } else if kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT {
        if item.textValue =!= "" { cScalarType(item.textValue) + " " } else { "double " }
    } else if kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL { "bool " }
    else { "lt_str " }
};

/** Fails cleanly when a reachable scalar/function signature references an unsupported C type. */
checkUnsupportedCType := fn(kind: String): Unit {
    if frontend.isDistinctKind(kind) { self(frontend.distinctBaseKind(kind)); return; }
    if frontend.isTupleKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support tuple values yet"); }
    if frontend.isMapKind(kind) and frontend.cMapTag(kind) == "" { diagLib.fail("", "C backend does not support map values yet"); }
    if frontend.isSetKind(kind) and frontend.cSetTag(kind) == "" { diagLib.fail("", "C backend does not support set values yet"); }
    if frontend.isRcKind(kind) and frontend.cRcTag(kind) == "" { diagLib.fail("", "C backend does not support Rc values yet"); }
    if frontend.isSliceKind(kind) and frontend.cSliceTag(kind) == "" { diagLib.fail("", "C backend does not support Slice values yet"); }
    if frontend.isRecordKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support record values yet"); }
    if frontend.isPayloadEnumKind(kind) and frontend.cStructTag(kind) == "" { diagLib.fail("", "C backend does not support payload enum values yet"); }
    if frontend.isListKind(kind) and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support list values yet"); }
    if frontend.isArrayKind(kind) and frontend.cArrayTag(kind) == "" and cListTagForKind(kind) == "" { diagLib.fail("", "C backend does not support array values yet"); }
    if frontend.isFnKind(kind) and frontend.cFnTag(kind) == "" { diagLib.fail("", "C backend does not support function values yet"); }
};

/** Checks parameter and return types of a reachable top-level or module function for C11 emission. */
checkCFunctionSignature := fn(item: frontend.Item): Unit {
    checkUnsupportedCType(item.code);
    encoded := item.textValue;
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := encoded.indexOf("|", start);
        end := if sep >= 0 { sep } else { encoded.length() };
        entry := encoded.slice(start, end);
        eq := entry.indexOf("=", 0);
        if eq >= 0 {
            checkUnsupportedCType(entry.slice(eq + 1, entry.length()));
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** Emits UTF-8 Unicode scalar `core/text` C11 helpers only for primitives referenced by `calls`. */
emitTextPrimitiveHelpers := fn(calls: Set<String>): Unit {
    hasSliceFrom := usesIntHelper(calls, "lite$textSliceFrom(");
    hasLen := usesIntHelper(calls, "lite$textLength(") or hasSliceFrom;
    hasAt := usesIntHelper(calls, "lite$textAt(");
    hasSlice := usesIntHelper(calls, "lite$textSlice(") or hasSliceFrom;
    hasSoftUtf8 := usesCTextSoftUtf8(calls);
    if not hasLen and not hasAt and not hasSlice and not hasSoftUtf8 { return; }
    outLine("static size_t lt_utf8_step(const char *s, size_t offset, size_t byte_len) {");
    outLine("    const unsigned char b = (unsigned char)s[offset];");
    outLine("    if (b < 0x80u) { return 1u; }");
    outLine("    if ((b & 0xE0u) == 0xC0u && offset + 1u < byte_len) { return 2u; }");
    outLine("    if ((b & 0xF0u) == 0xE0u && offset + 2u < byte_len) { return 3u; }");
    outLine("    if ((b & 0xF8u) == 0xF0u && offset + 3u < byte_len) { return 4u; }");
    outLine("    return 1u;");
    outLine("}");
    outLine("typedef struct { const char *s; size_t byte_len; int64_t cp_len; uint64_t gen; bool ascii; size_t last_b; int64_t last_cp; uint32_t stamp; } lt_utf8_meta;");
    outLine("LT_THREAD_LOCAL lt_utf8_meta lt_utf8_cache[256];");
    outLine("LT_THREAD_LOCAL lt_utf8_meta *lt_utf8_last = NULL;");
    outLine("LT_THREAD_LOCAL uint32_t lt_utf8_clock = 1u;");
    outLine("static lt_utf8_meta *lt_utf8_get_meta(lt_str str) {");
    outLine("    const char *s = str.ext.data != NULL ? str.ext.data : \"\";");
    outLine("    const size_t blen = lt_str_byte_len(str);");
    outLine("    const uint64_t cur_gen = lt_arena_gen();");
    outLine("    if (lt_utf8_last != NULL && lt_utf8_last->s == s && lt_utf8_last->byte_len == blen && lt_utf8_last->gen == cur_gen) { return lt_utf8_last; }");
    outLine("    size_t base = ((((size_t)(uintptr_t)s) >> 4) & 63u) << 2;");
    outLine("    for (size_t w = 0u; w < 4u; w += 1u) {");
    outLine("        if (lt_utf8_cache[base + w].s == s && lt_utf8_cache[base + w].byte_len == blen && lt_utf8_cache[base + w].gen == cur_gen) { lt_utf8_cache[base + w].stamp = ++lt_utf8_clock; lt_utf8_last = &lt_utf8_cache[base + w]; return lt_utf8_last; }");
    outLine("    }");
    outLine("    int64_t cp = lt_str_cp_len_known(str);");
    outLine("    bool ascii = (cp == (int64_t)blen);");
    outLine("    if (cp < 0) {");
    outLine("        cp = 0; ascii = true;");
    outLine("        for (size_t b = 0u; b < blen; ) {");
    outLine("            if ((unsigned char)s[b] < 0x80u) { b += 1u; cp += 1; }");
    outLine("            else { ascii = false; b += lt_utf8_step(s, b, blen); cp += 1; }");
    outLine("        }");
    outLine("    }");
    outLine("    size_t victim = base;");
    outLine("    for (size_t w = 0u; w < 4u; w += 1u) {");
    outLine("        lt_utf8_meta *cand = &lt_utf8_cache[base + w];");
    outLine("        if (cand->s == NULL || cand->gen != cur_gen) { victim = base + w; break; }");
    outLine("        lt_utf8_meta *cur = &lt_utf8_cache[victim];");
    outLine("        if (cand->byte_len < cur->byte_len && cur->byte_len >= 4096u) { victim = base + w; }");
    outLine("        else if ((cand->byte_len < 4096u) == (cur->byte_len < 4096u) && cand->stamp < cur->stamp) { victim = base + w; }");
    outLine("    }");
    outLine("    lt_utf8_meta *slot = &lt_utf8_cache[victim];");
    outLine("    slot->s = s; slot->byte_len = blen; slot->cp_len = cp; slot->gen = cur_gen; slot->ascii = ascii; slot->last_b = 0u; slot->last_cp = 0; slot->stamp = ++lt_utf8_clock;");
    outLine("    lt_utf8_last = slot;");
    outLine("    return slot;");
    outLine("}");
    if hasAt or hasSlice {
        outLine("static inline lt_str lt_ascii_char(unsigned char c) {");
        outLine("    lt_str r = LT_EMPTY_STR;");
        outLine("    r.sso.buf[0] = (char)c; r.sso.tag = 1u;");
        outLine("    return r;");
        outLine("}");
        outLine("static lt_str lt_alloc_text_slice(const char *s, size_t start, size_t end, int64_t cp_len) {");
        outLine("    const size_t len = end - start;");
        outLine("    if (len == 0u) { return LT_EMPTY_STR; }");
        outLine("    if (len == 1u && (unsigned char)s[start] < 128u) { return lt_ascii_char((unsigned char)s[start]); }");
        outLine("    return lt_str_make(s + start, len, cp_len);");
        outLine("}");
    }
    if hasAt or hasSlice or hasSoftUtf8 {
        outLine("static size_t lt_utf8_byte_at(lt_str str, int64_t target, bool allow_end, bool *ok) {");
        outLine("    const size_t sbl = lt_str_byte_len(str);");
        outLine("    const int64_t known = lt_str_cp_len_known(str);");
        outLine("    if (known == (int64_t)sbl) {");
        outLine("        if (target < 0 || target > (int64_t)sbl || (!allow_end && target == (int64_t)sbl)) { *ok = false; return 0u; }");
        outLine("        *ok = true; return (size_t)target;");
        outLine("    }");
        outLine("    if (!lt_str_is_ext(str)) {");
        outLine("        if (target < 0) { *ok = false; return 0u; }");
        outLine("        size_t b = 0u; int64_t c = 0;");
        outLine("        while (b < sbl && c < target) { b += lt_utf8_step(str.sso.buf, b, sbl); c += 1; }");
        outLine("        if (c < target || (!allow_end && b >= sbl)) { *ok = false; return 0u; }");
        outLine("        *ok = true; return b;");
        outLine("    }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(str);");
        outLine("    if (target < 0 || target > m->cp_len || (!allow_end && target == m->cp_len)) { *ok = false; return 0u; }");
        outLine("    if (m->ascii) { *ok = true; return (size_t)target; }");
        outLine("    if (target == m->cp_len) { *ok = true; return m->byte_len; }");
        outLine("    const char *s = m->s;");
        outLine("    size_t blen = m->byte_len;");
        outLine("    size_t byte_pos = 0u;");
        outLine("    int64_t count = 0;");
        outLine("    if (target >= m->last_cp) {");
        outLine("        byte_pos = m->last_b; count = m->last_cp;");
        outLine("        while (count < target && byte_pos < blen) { byte_pos += lt_utf8_step(s, byte_pos, blen); count += 1; }");
        outLine("    } else if (m->last_cp - target < target) {");
        outLine("        byte_pos = m->last_b; count = m->last_cp;");
        outLine("        while (count > target && byte_pos > 0u) { byte_pos -= 1u; while (byte_pos > 0u && (((unsigned char)s[byte_pos]) & 0xC0u) == 0x80u) { byte_pos -= 1u; } count -= 1; }");
        outLine("    } else {");
        outLine("        while (count < target && byte_pos < blen) { byte_pos += lt_utf8_step(s, byte_pos, blen); count += 1; }");
        outLine("    }");
        outLine("    m->last_b = byte_pos; m->last_cp = count;");
        outLine("    *ok = true;");
        outLine("    return byte_pos;");
        outLine("}");
    }
    if hasLen {
        outLine("static inline int64_t lt_text_length(lt_str s) {");
        outLine("    int64_t known = lt_str_cp_len_known(s);");
        outLine("    if (known >= 0) { return known; }");
        outLine("    if (!lt_str_is_ext(s)) {");
        outLine("        size_t bl = (size_t)(s.sso.tag & 0x0Fu);");
        outLine("        int64_t cp = 0;");
        outLine("        for (size_t b = 0u; b < bl; ) { b += lt_utf8_step(s.sso.buf, b, bl); cp += 1; }");
        outLine("        return cp;");
        outLine("    }");
        outLine("    return lt_utf8_get_meta(s)->cp_len;");
        outLine("}");
    }
    if hasAt {
        outLine("static lt_str lt_text_at(lt_str s, int64_t position, size_t at) {");
        outLine("    const size_t sbl = lt_str_byte_len(s);");
        outLine("    const int64_t known = lt_str_cp_len_known(s);");
        outLine("    if (known == (int64_t)sbl) {");
        outLine("        if (position < 0 || position >= (int64_t)sbl) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("        const char *sd = lt_str_data(&s);");
        outLine("        return lt_ascii_char((unsigned char)sd[position]);");
        outLine("    }");
        outLine("    if (!lt_str_is_ext(s)) {");
        outLine("        bool ok = false;");
        outLine("        const size_t start = lt_utf8_byte_at(s, position, false, &ok);");
        outLine("        if (!ok) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("        return lt_alloc_text_slice(s.sso.buf, start, start + lt_utf8_step(s.sso.buf, start, sbl), 1);");
        outLine("    }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (position < 0 || position >= m->cp_len) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("    if (m->ascii) { return lt_ascii_char((unsigned char)m->s[position]); }");
        outLine("    bool ok = false;");
        outLine("    const size_t start = lt_utf8_byte_at(s, position, false, &ok);");
        outLine("    if (!ok) { lt_bound_fault(at, \"textAt index outside text\"); }");
        outLine("    return lt_alloc_text_slice(m->s, start, start + lt_utf8_step(m->s, start, m->byte_len), 1);");
        outLine("}");
    }
    if hasSlice {
        outLine("static lt_str lt_text_slice(lt_str s, int64_t start, int64_t end, size_t at) {");
        outLine("    const size_t sbl = lt_str_byte_len(s);");
        outLine("    const int64_t known = lt_str_cp_len_known(s);");
        outLine("    if (known == (int64_t)sbl) {");
        outLine("        if (start < 0 || end < start || end > (int64_t)sbl) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("        return lt_alloc_text_slice(lt_str_data(&s), (size_t)start, (size_t)end, end - start);");
        outLine("    }");
        outLine("    if (!lt_str_is_ext(s)) {");
        outLine("        if (start < 0 || end < start) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("        bool ok = false;");
        outLine("        const size_t b_start = lt_utf8_byte_at(s, start, true, &ok);");
        outLine("        if (!ok) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("        size_t b_end = b_start; int64_t remaining = end - start;");
        outLine("        while (remaining > 0 && b_end < sbl) { b_end += lt_utf8_step(s.sso.buf, b_end, sbl); remaining -= 1; }");
        outLine("        if (remaining > 0) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("        return lt_alloc_text_slice(s.sso.buf, b_start, b_end, end - start);");
        outLine("    }");
        outLine("    lt_utf8_meta *m = lt_utf8_get_meta(s);");
        outLine("    if (start < 0 || end < start || end > m->cp_len) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    if (m->ascii) { return lt_alloc_text_slice(m->s, (size_t)start, (size_t)end, end - start); }");
        outLine("    bool ok = false;");
        outLine("    const size_t b_start = lt_utf8_byte_at(s, start, true, &ok);");
        outLine("    if (!ok) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    size_t b_end = b_start;");
        outLine("    int64_t remaining = end - start;");
        outLine("    while (remaining > 0 && b_end < m->byte_len) { b_end += lt_utf8_step(m->s, b_end, m->byte_len); remaining -= 1; }");
        outLine("    if (remaining > 0) { lt_bound_fault(at, \"textSlice requires 0 <= start <= end <= textLength(text)\"); }");
        outLine("    return lt_alloc_text_slice(m->s, b_start, b_end, end - start);");
        outLine("}");
    }
    if hasSliceFrom {
        outLine("static lt_str lt_text_slice_from(lt_str s, int64_t start, size_t at) {");
        outLine("    return lt_text_slice(s, start, lt_text_length(s), at);");
        outLine("}");
    }
    outLine("");
};

/** True when a program calls supported C11 stdin helpers (`inputAll`, `inputLine`, `inputInt`, `inputFloat`). */
usesInputHelpers := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$inputAll(") or usesIntHelper(calls, "lite$inputLine(") or
    usesIntHelper(calls, "lite$inputInt(") or usesIntHelper(calls, "lite$inputFloat(")
};

/** Emits portable ISO C11 stdin helpers matching Lite's `core/io` prompt and `InputFault` contracts. */
emitInputHelpers := fn(calls: Set<String>): Unit {
    hasAll := usesIntHelper(calls, "lite$inputAll(");
    hasLine := usesIntHelper(calls, "lite$inputLine(");
    hasInt := usesIntHelper(calls, "lite$inputInt(");
    hasFloat := usesIntHelper(calls, "lite$inputFloat(");
    if not hasAll and not hasLine and not hasInt and not hasFloat { return; }
    outLine("static void lt_input_prompt(lt_str prompt) {");
    outLine("    size_t n = lt_str_byte_len(prompt);");
    outLine("    if (n > 0u) { (void)fwrite(lt_str_data(&prompt), 1u, n, stdout); fflush(stdout); }");
    outLine("}");
    if hasLine or hasInt or hasFloat {
        outLine("static _Noreturn void lt_input_fault(lt_str at, const char *message) {");
        outLine("    fprintf(stderr, \"%s%s\\n\", lt_text_cstr(at), message);");
        outLine("    exit(1);");
        outLine("}");
    }
    if hasInt or hasFloat {
        outLine("static char *lt_input_word(void) {");
        outLine("    int ch = fgetc(stdin);");
        outLine("    while (ch != EOF && (ch == ' ' || ch == '\\t' || ch == '\\r' || ch == '\\n')) { ch = fgetc(stdin); }");
        outLine("    if (ch == EOF) { return NULL; }");
        outLine("    size_t cap = 64u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    while (ch != EOF && ch != ' ' && ch != '\\t' && ch != '\\r' && ch != '\\n') {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    if (ch != EOF) { ungetc(ch, stdin); }");
        outLine("    buf[len] = '\\0';");
        outLine("    return buf;");
        outLine("}");
    }
    if hasAll {
        outLine("static lt_str lt_input_all(lt_str prompt, lt_str at) {");
        outLine("    (void)at;");
        outLine("    lt_input_prompt(prompt);");
        outLine("    size_t cap = 128u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    int32_t cp = 0;");
        outLine("    int ch = fgetc(stdin);");
        outLine("    while (ch != EOF) {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        if (((unsigned char)ch & 0xC0u) != 0x80u) { cp += 1; }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    buf[len] = '\\0';");
        outLine("    return lt_text_from_buf(buf, len, cp);");
        outLine("}");
    }
    if hasLine {
        outLine("static lt_str lt_input_line(lt_str prompt, lt_str at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    int ch = fgetc(stdin);");
        outLine("    if (ch == EOF) { lt_input_fault(at, \"EOF before inputLine value\"); }");
        outLine("    size_t cap = 128u, len = 0u;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate input buffer\\n\"); exit(1); }");
        outLine("    int32_t cp = 0;");
        outLine("    while (ch != EOF && ch != '\\n') {");
        outLine("        if (len + 1u >= cap) { cap *= 2u; buf = realloc(buf, cap); if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow input buffer\\n\"); exit(1); } }");
        outLine("        if (((unsigned char)ch & 0xC0u) != 0x80u) { cp += 1; }");
        outLine("        buf[len++] = (char)ch;");
        outLine("        ch = fgetc(stdin);");
        outLine("    }");
        outLine("    if (ch == '\\n' && len > 0u && buf[len - 1u] == '\\r') { len -= 1u; cp -= 1; }");
        outLine("    buf[len] = '\\0';");
        outLine("    return lt_text_from_buf(buf, len, cp);");
        outLine("}");
    }
    if hasInt {
        outLine("static int64_t lt_input_int(lt_str prompt, lt_str at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    char *tok = lt_input_word();");
        outLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputInt value\"); }");
        outLine("    size_t i = (tok[0] == '+' || tok[0] == '-') ? 1u : 0u;");
        outLine("    if (tok[i] == '\\0') { free(tok); lt_input_fault(at, \"expected an integer token\"); }");
        outLine("    while (tok[i] != '\\0') { if (tok[i] < '0' || tok[i] > '9') { free(tok); lt_input_fault(at, \"expected an integer token\"); } i += 1u; }");
        outLine("    errno = 0;");
        outLine("    char *endp = NULL;");
        outLine("    long long val = strtoll(tok, &endp, 10);");
        outLine("    int err = errno;");
        outLine("    free(tok);");
        outLine("    if (err == ERANGE || val < INT64_MIN || val > INT64_MAX) { lt_input_fault(at, \"input outside signed 64-bit range\"); }");
        outLine("    return (int64_t)val;");
        outLine("}");
    }
    if hasFloat {
        outLine("static double lt_input_float(lt_str prompt, lt_str at) {");
        outLine("    lt_input_prompt(prompt);");
        outLine("    char *tok = lt_input_word();");
        outLine("    if (tok == NULL) { lt_input_fault(at, \"EOF before inputFloat value\"); }");
        outLine("    char *endp = NULL;");
        outLine("    double val = strtod(tok, &endp);");
        outLine("    bool ok = endp != tok && *endp == '\\0' && isfinite(val);");
        outLine("    free(tok);");
        outLine("    if (!ok) { lt_input_fault(at, \"expected a finite floating token\"); }");
        outLine("    return val;");
        outLine("}");
    }
    outLine("");
};

/** Formats a pipe-separated parameter list as C11 typed parameters or `void`, applying `restrict` only when proven sound. */
cParameterListWithRestrict := fn(encoded: String, useRestrict: Bool): String {
    if encoded == "" { return "void"; }
    result: mut tb.TextBuilder;
    var start := 0;
    loop true {
        sep := encoded.indexOf("|", start);
        end := if sep >= 0 { sep } else { encoded.length() };
        entry := encoded.slice(start, end);
        eq := entry.indexOf("=", 0);
        paramName := entry.slice(0, eq);
        rawParamKind := entry.slice(eq + 1, entry.length());
        isMutParam := rawParamKind.startsWithAt(0, "mut ");
        paramKind := if isMutParam { rawParamKind.slice(4, rawParamKind.length()) } else { rawParamKind };
        if result.count() > 0 { mut result.append(", "); }
        if isMutParam and not frontend.isSliceKind(paramKind) {
            mut result.append(cScalarType(paramKind));
            mut result.append(if useRestrict { " * restrict lite_" } else { " *lite_" });
        } else if frontend.cParamIsConstPtr(paramKind) {
            mut result.append("const ");
            mut result.append(cScalarType(paramKind));
            mut result.append(if useRestrict { " * restrict lite_" } else { " *lite_" });
        } else {
            mut result.append(cScalarType(paramKind));
            mut result.append(" lite_");
        }
        mut result.append(frontend.cSafeIdent(paramName));
        if sep < 0 { break; }
        start = sep + 1;
    }
    result.build()
};

/** Formats a pipe-separated parameter list as C11 typed parameters or `void`. */
cParameterList := fn(encoded: String): String {
    cParameterListWithRestrict(encoded, false)
};

/** Emits `(void)lite_param;` silencing reads for strict C11 warning checks. */
emitCParameterReads := fn(encoded: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        sep := encoded.indexOf("|", start);
        end := if sep >= 0 { sep } else { encoded.length() };
        entry := encoded.slice(start, end);
        eq := entry.indexOf("=", 0);
        outLine("    (void)lite_" + frontend.cSafeIdent(entry.slice(0, eq)) + ";");
        if sep < 0 { break; }
        start = sep + 1;
    }
};

/** True when `item.kind` starts a local/mutable variable declaration. */
isCLocalDeclKind := fn(kind: String): Bool {
    kind == frontend.ITEM_KIND_LOCAL_INT or kind == frontend.ITEM_KIND_VAR_INT or
    kind == frontend.ITEM_KIND_LOCAL_STRING or kind == frontend.ITEM_KIND_VAR_STRING or
    kind == frontend.ITEM_KIND_LOCAL_FLOAT or kind == frontend.ITEM_KIND_VAR_FLOAT or
    kind == frontend.ITEM_KIND_LOCAL_BOOL or kind == frontend.ITEM_KIND_VAR_BOOL or
    kind == frontend.ITEM_KIND_LOCAL_RECORD or kind == frontend.ITEM_KIND_VAR_RECORD or
    kind == frontend.ITEM_KIND_LOCAL_TUPLE or kind == frontend.ITEM_KIND_VAR_TUPLE or
    kind == frontend.ITEM_KIND_LOCAL_LIST or kind == frontend.ITEM_KIND_VAR_LIST or
    kind == frontend.ITEM_KIND_LOCAL_FN or kind == frontend.ITEM_KIND_VAR_FN
};

/** True when `item.kind` assigns an existing local/mutable variable. */
isCAssignKind := fn(kind: String): Bool {
    kind == frontend.ITEM_KIND_ASSIGN_INT or kind == frontend.ITEM_KIND_ASSIGN_STRING or
    kind == frontend.ITEM_KIND_ASSIGN_BOOL or kind == frontend.ITEM_KIND_ASSIGN_FLOAT or
    kind == frontend.ITEM_KIND_ASSIGN_RECORD or kind == frontend.ITEM_KIND_ASSIGN_TUPLE or
    kind == frontend.ITEM_KIND_ASSIGN_LIST or kind == frontend.ITEM_KIND_ASSIGN_FN
};

/** Skips a balanced CFN_START ... CFN_END hoisted-closure block starting at `start` in `code`. */
skipCFnBlock := fn(code: String, start: Int): Int {
    size := code.length();
    var cursor := start + 13;
    var depth := 1;
    loop cursor < size and depth > 0 {
        ch := code.at(cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CFN_START:") {
            depth = depth + 1;
            cursor = cursor + 13;
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CFN_END@*/") {
            depth = depth - 1;
            cursor = cursor + 13;
        } else {
            cursor = cursor + 1;
        }
    }
    cursor
};

/** Detects leaked JS tuple or array literal syntax inside a scalar-typed expression on C, skipping quoted strings, type annotations, and C11 compound literals. */
unsupportedAggregateCode := fn(code: String): String {
    if code.indexOf("{", 0) < 0 and code.indexOf("[", 0) < 0 { return ""; }
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CFN_START:") {
            cursor = skipCFnBlock(code, cursor);
        } else if ch == "/" and (code.startsWithAt(cursor, "/*@T:") or code.startsWithAt(cursor, "/*@C:") or code.startsWithAt(cursor, "/*@P:")) {
            endTag := code.indexOf("@*/", cursor + 5);
            cursor = if endTag >= 0 { endTag + 3 } else { size };
        } else if ch == "(" and (code.startsWithAt(cursor, "((const ") or code.startsWithAt(cursor, "(const ") or code.startsWithAt(cursor, "((lt_s_") or code.startsWithAt(cursor, "((lt_fnv_") or code.startsWithAt(cursor, "((lt_arr_") or code.startsWithAt(cursor, "((lt_rc_") or code.startsWithAt(cursor, "((lt_slice_") or code.startsWithAt(cursor, "((lt_list_") or code.startsWithAt(cursor, "((/*@T:") or code.startsWithAt(cursor, "(/*@T:")) {
            isDouble := code.startsWithAt(cursor, "((const ") or code.startsWithAt(cursor, "((lt_s_") or code.startsWithAt(cursor, "((lt_fnv_") or code.startsWithAt(cursor, "((lt_arr_") or code.startsWithAt(cursor, "((lt_rc_") or code.startsWithAt(cursor, "((lt_slice_") or code.startsWithAt(cursor, "((lt_list_") or code.startsWithAt(cursor, "((/*@T:");
            var depth := 0;
            loop cursor < size {
                c2 := code.at(cursor);
                if c2 == "\"" {
                    cursor = frontend.skipAliasString(code, cursor);
                } else {
                    if c2 == "(" { depth = depth + 1; }
                    else if c2 == ")" {
                        depth = depth - 1;
                        if depth == 0 {
                            cursor = cursor + 1;
                            if not isDouble and cursor < size and code.at(cursor) == "{" {
                                var bDepth := 0;
                                loop cursor < size {
                                    c3 := code.at(cursor);
                                    if c3 == "\"" { cursor = frontend.skipAliasString(code, cursor); }
                                    else {
                                        if c3 == "{" { bDepth = bDepth + 1; }
                                        else if c3 == "}" {
                                            bDepth = bDepth - 1;
                                            if bDepth == 0 { cursor = cursor + 1; break; }
                                        }
                                        cursor = cursor + 1;
                                    }
                                }
                            }
                            break;
                        }
                    }
                    cursor = cursor + 1;
                }
            }
        } else if ch == "." and code.startsWithAt(cursor, ".data[") {
            dEnd := cursor + 6;
            var dCur := dEnd;
            loop dCur < size and code.at(dCur).isDigit() { dCur = dCur + 1; }
            if dCur > dEnd and dCur < size and code.at(dCur) == "]" {
                cursor = dCur + 1;
            } else {
                cursor = cursor + 1;
            }
        } else if ch == "[" and code.startsWithAt(cursor, "[0] == '\\0'") {
            cursor = cursor + "[0] == '\\0'".length();
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CBLK:") {
            return "";
        } else if ch == "{" and code.startsWithAt(cursor, "{ /*c-stmt*/") {
            return "";
        } else if ch == "{" {
            return "C backend does not support tuple values yet";
        } else if ch == "[" {
            return "C backend does not support array values yet";
        } else {
            cursor = cursor + 1;
        }
    }
    ""
};

/* Lazily initialized O(1) rewrite table from `lite$<name>` suffix to C11 runtime function name. */
var cBuiltinMapReady := false;
cBuiltinMap: mut Map<String, String>;

/** Populates `cBuiltinMap` once with all registered `lite$...(` -> `lt_...(` C11 runtime mappings. */
ensureCBuiltinMap := fn(): Unit {
    if cBuiltinMapReady { return; }
    cBuiltinMapReady = true;
    mut cBuiltinMap.set("reportError", "lt_report_error");
    mut cBuiltinMap.set("exit", "lt_exit");
    mut cBuiltinMap.set("textLength", "lt_text_length");
    mut cBuiltinMap.set("textAt", "lt_text_at");
    mut cBuiltinMap.set("textSliceFrom", "lt_text_slice_from");
    mut cBuiltinMap.set("textSlice", "lt_text_slice");
    mut cBuiltinMap.set("inputArgs", "lt_input_args");
    mut cBuiltinMap.set("inputAll", "lt_input_all");
    mut cBuiltinMap.set("inputLine", "lt_input_line");
    mut cBuiltinMap.set("inputInt", "lt_input_int");
    mut cBuiltinMap.set("inputFloat", "lt_input_float");
    mut cBuiltinMap.set("unicodeToCodePoints", "lt_unicode_to_code_points");
    mut cBuiltinMap.set("unicodeFromCodePoints", "lt_unicode_from_code_points");
    mut cBuiltinMap.set("floatToText", "lt_float_to_text");
    mut cBuiltinMap.set("float32ToText", "lt_float32_to_text");
    mut cBuiltinMap.set("ioStdinReader", "lt_io_stdin_reader");
    mut cBuiltinMap.set("ioStdoutWriter", "lt_io_stdout_writer");
    mut cBuiltinMap.set("ioStderrWriter", "lt_io_stderr_writer");
    mut cBuiltinMap.set("ioBufferReader", "lt_io_buffer_reader");
    mut cBuiltinMap.set("ioBufferWriter", "lt_io_buffer_writer");
    mut cBuiltinMap.set("ioWriterBytes", "lt_io_writer_bytes");
    mut cBuiltinMap.set("ioWriterText", "lt_io_writer_text");
    mut cBuiltinMap.set("ioClearWriter", "lt_io_clear_writer");
    mut cBuiltinMap.set("ioReaderOk", "lt_io_reader_ok");
    mut cBuiltinMap.set("ioReaderAtEof", "lt_io_reader_at_eof");
    mut cBuiltinMap.set("ioReaderError", "lt_io_reader_error");
    mut cBuiltinMap.set("ioRead", "lt_io_read");
    mut cBuiltinMap.set("ioCloseReader", "lt_io_close_reader");
    mut cBuiltinMap.set("ioWriterOk", "lt_io_writer_ok");
    mut cBuiltinMap.set("ioWriterError", "lt_io_writer_error");
    mut cBuiltinMap.set("ioWrite", "lt_io_write");
    mut cBuiltinMap.set("ioFlush", "lt_io_flush");
