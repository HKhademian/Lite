        outLine("    memcpy(wav, \"RIFF\", 4u); lt_wav_u32(wav + 4u, 36u + data_bytes); memcpy(wav + 8u, \"WAVEfmt \", 8u);");
        outLine("    lt_wav_u32(wav + 16u, 16u); lt_wav_u16(wav + 20u, 1u); lt_wav_u16(wav + 22u, 1u);");
        outLine("    lt_wav_u32(wav + 24u, sr); lt_wav_u32(wav + 28u, sr * 2u); lt_wav_u16(wav + 32u, 2u); lt_wav_u16(wav + 34u, 16u);");
        outLine("    memcpy(wav + 36u, \"data\", 4u); lt_wav_u32(wav + 40u, data_bytes);");
        outLine("    double amp = ((double)volume / 100.0) * 12000.0;");
        outLine("    double phase_inc = 6.28318530717958647692 * (double)freq / (double)sr;");
        outLine("    uint32_t fade = samples < 440u ? (samples / 2u) : 220u;");
        outLine("    for (uint32_t i = 0; i < samples; i += 1u) {");
        outLine("        double env = 1.0;");
        outLine("        if (fade > 0u && i < fade) env = (double)i / (double)fade;");
        outLine("        else if (fade > 0u && i + fade > samples) env = (double)(samples - i) / (double)fade;");
        outLine("        int16_t v = (int16_t)(sin(phase_inc * (double)i) * amp * env);");
        outLine("        lt_wav_u16(wav + 44u + i * 2u, (uint16_t)v);");
        outLine("    }");
        outLine("    void *pool = objc_autoreleasePoolPush();");
        outLine("    id nsData = ((id (*)(id, SEL, const void *, unsigned long))objc_msgSend)((id)objc_getClass(\"NSData\"), sel_registerName(\"dataWithBytes:length:\"), wav, (unsigned long)(44u + data_bytes));");
        outLine("    free(wav);");
        outLine("    id snd = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(\"NSSound\"), sel_registerName(\"alloc\"));");
        outLine("    snd = ((id (*)(id, SEL, id))objc_msgSend)(snd, sel_registerName(\"initWithData:\"), nsData);");
        outLine("    if (snd != NULL) {");
        outLine("        int slot = lt_sound_ring_idx; lt_sound_ring_idx = (lt_sound_ring_idx + 1) & 15;");
        outLine("        if (lt_sound_ring[slot] != NULL) { ((void (*)(id, SEL))objc_msgSend)(lt_sound_ring[slot], sel_registerName(\"release\")); }");
        outLine("        lt_sound_ring[slot] = snd;");
        outLine("        ((signed char (*)(id, SEL))objc_msgSend)(snd, sel_registerName(\"play\"));");
        outLine("    }");
        outLine("    objc_autoreleasePoolPop(pool);");
        outLine("#else");
        outLine("    (void)freq; (void)duration_ms; (void)volume;");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasIsKeyDown(") {
        outLine("LT_INLINE bool lt_canvas_is_key_down(" + surfTag + " surf, lt_str key) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? lt_keyset_has(s->keys_down, s->keys_down_n, lt_text_cstr(key)) : false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasIsKeyPressed(") {
        outLine("LT_INLINE bool lt_canvas_is_key_pressed(" + surfTag + " surf, lt_str key) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? lt_keyset_has(s->keys_pressed, s->keys_pressed_n, lt_text_cstr(key)) : false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasIsKeyReleased(") {
        outLine("LT_INLINE bool lt_canvas_is_key_released(" + surfTag + " surf, lt_str key) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? lt_keyset_has(s->keys_released, s->keys_released_n, lt_text_cstr(key)) : false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasIsPointerPressed(") {
        outLine("LT_INLINE bool lt_canvas_is_pointer_pressed(" + surfTag + " surf) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? s->ppressed : false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasIsPointerReleased(") {
        outLine("LT_INLINE bool lt_canvas_is_pointer_released(" + surfTag + " surf) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? s->preleased : false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasWheelDelta(") {
        outLine("LT_INLINE double lt_canvas_wheel_delta(" + surfTag + " surf) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); return s ? s->wheel_y : 0.0; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasSetClipRect(") {
        outLine("LT_INLINE void lt_canvas_set_clip_rect(" + surfTag + " surf, " + rcTag + " area) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); if (!s) return;");
        outLine("    s->has_clip = true;");
        outLine("    s->clip_x0 = (int)floor(area.f_x); if (s->clip_x0 < 0) s->clip_x0 = 0;");
        outLine("    s->clip_y0 = (int)floor(area.f_y); if (s->clip_y0 < 0) s->clip_y0 = 0;");
        outLine("    s->clip_x1 = (int)ceil(area.f_x + area.f_width); if (s->clip_x1 > s->w) s->clip_x1 = s->w;");
        outLine("    s->clip_y1 = (int)ceil(area.f_y + area.f_height); if (s->clip_y1 > s->h) s->clip_y1 = s->h;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasClearClipRect(") {
        outLine("LT_INLINE void lt_canvas_clear_clip_rect(" + surfTag + " surf) { lt_canvas_state *s = lt_canvas_get(surf.f_handle); if (s) s->has_clip = false; }");
    }
    if usesIntHelper(calls, "lite$extraCanvasFillTriangle(") {
        outLine("LT_INLINE void lt_canvas_fill_triangle(" + surfTag + " surf, " + ptTag + " a, " + ptTag + " b, " + ptTag + " c, " + colTag + " fill) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); if (!s) return;");
        outLine("    double area = (b.f_x - a.f_x) * (c.f_y - a.f_y) - (b.f_y - a.f_y) * (c.f_x - a.f_x);");
        outLine("    if (area == 0.0) return;");
        outLine("    uint8_t r = lt_canvas_u8(fill.f_r), g = lt_canvas_u8(fill.f_g), bl = lt_canvas_u8(fill.f_b), al = lt_canvas_u8(fill.f_a);");
        outLine("    double minx = a.f_x < b.f_x ? (a.f_x < c.f_x ? a.f_x : c.f_x) : (b.f_x < c.f_x ? b.f_x : c.f_x);");
        outLine("    double miny = a.f_y < b.f_y ? (a.f_y < c.f_y ? a.f_y : c.f_y) : (b.f_y < c.f_y ? b.f_y : c.f_y);");
        outLine("    double maxx = a.f_x > b.f_x ? (a.f_x > c.f_x ? a.f_x : c.f_x) : (b.f_x > c.f_x ? b.f_x : c.f_x);");
        outLine("    double maxy = a.f_y > b.f_y ? (a.f_y > c.f_y ? a.f_y : c.f_y) : (b.f_y > c.f_y ? b.f_y : c.f_y);");
        outLine("    int x0 = (int)floor(minx); if (x0 < 0) x0 = 0; int y0 = (int)floor(miny); if (y0 < 0) y0 = 0;");
        outLine("    int x1 = (int)ceil(maxx); if (x1 > s->w) x1 = s->w; int y1 = (int)ceil(maxy); if (y1 > s->h) y1 = s->h;");
        outLine("    for (int y = y0; y < y1; y += 1) { double py = (double)y + 0.5; for (int x = x0; x < x1; x += 1) { double px = (double)x + 0.5; double e0 = (b.f_x - a.f_x) * (py - a.f_y) - (b.f_y - a.f_y) * (px - a.f_x); double e1 = (c.f_x - b.f_x) * (py - b.f_y) - (c.f_y - b.f_y) * (px - b.f_x); double e2 = (a.f_x - c.f_x) * (py - c.f_y) - (a.f_y - c.f_y) * (px - c.f_x); if (area > 0.0 ? (e0 >= 0.0 && e1 >= 0.0 && e2 >= 0.0) : (e0 <= 0.0 && e1 <= 0.0 && e2 <= 0.0)) lt_canvas_blend(s, x, y, r, g, bl, al); } }");
        outLine("}");
    }
    outLine("LT_INLINE lt_texture_state *lt_texture_get(int64_t h) { if (h < 1 || h > 256) return NULL; lt_texture_state *t = &lt_texture_slots[h - 1]; return t->pixels ? t : NULL; }");
    if usesIntHelper(calls, "lite$extraCanvasCreateTexture(") {
        outLine("LT_INLINE " + texTag + " lt_canvas_create_texture(int64_t width, int64_t height) {");
        outLine("    int w = width > 0 ? (int)width : 1; int h = height > 0 ? (int)height : 1;");
        outLine("    int slot = -1; for (int i = 0; i < 256; i += 1) { if (lt_texture_slots[i].pixels == NULL) { slot = i; break; } }");
        outLine("    if (slot < 0) return (" + texTag + "){ .f_handle = 0, .f_width = 0, .f_height = 0 };");
        outLine("    size_t nbytes = (size_t)w * (size_t)h * 4u;");
        outLine("    lt_texture_slots[slot].w = w; lt_texture_slots[slot].h = h; lt_texture_slots[slot].pixels_bytes = nbytes;");
        outLine("    lt_texture_slots[slot].pixels = calloc(nbytes, 1u);");
        outLine("    if (lt_texture_slots[slot].pixels != NULL) { lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)nbytes; }");
        outLine("    return (" + texTag + "){ .f_handle = (int64_t)(slot + 1), .f_width = (int64_t)w, .f_height = (int64_t)h };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasSetTexturePixel(") {
        outLine("LT_INLINE void lt_canvas_set_texture_pixel(" + texTag + " tex, int64_t x, int64_t y, " + colTag + " fill) {");
        outLine("    lt_texture_state *t = lt_texture_get(tex.f_handle); if (!t) return;");
        outLine("    if (x < 0 || y < 0 || x >= t->w || y >= t->h) return;");
        outLine("    size_t idx = ((size_t)y * (size_t)t->w + (size_t)x) * 4u;");
        outLine("    t->pixels[idx] = lt_canvas_u8(fill.f_r); t->pixels[idx + 1] = lt_canvas_u8(fill.f_g); t->pixels[idx + 2] = lt_canvas_u8(fill.f_b); t->pixels[idx + 3] = lt_canvas_u8(fill.f_a);");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasBlit(") {
        outLine("LT_INLINE void lt_canvas_blit(" + surfTag + " surf, " + texTag + " tex, " + ptTag + " at) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); lt_texture_state *t = lt_texture_get(tex.f_handle); if (!s || !t) return;");
        outLine("    int ox = (int)floor(at.f_x + 0.5), oy = (int)floor(at.f_y + 0.5);");
        outLine("    for (int sy = 0; sy < t->h; sy += 1) { int dy = oy + sy; if (dy < 0 || dy >= s->h) continue; for (int sx = 0; sx < t->w; sx += 1) { int dx = ox + sx; if (dx < 0 || dx >= s->w) continue; size_t idx = ((size_t)sy * (size_t)t->w + (size_t)sx) * 4u; lt_canvas_blend(s, dx, dy, t->pixels[idx], t->pixels[idx + 1], t->pixels[idx + 2], t->pixels[idx + 3]); } }");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasBlitScaled(") {
        outLine("LT_INLINE void lt_canvas_blit_scaled(" + surfTag + " surf, " + texTag + " tex, " + rcTag + " dest) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); lt_texture_state *t = lt_texture_get(tex.f_handle);");
        outLine("    if (!s || !t || dest.f_width <= 0.0 || dest.f_height <= 0.0) return;");
        outLine("    int x0 = (int)floor(dest.f_x); if (x0 < 0) x0 = 0; int y0 = (int)floor(dest.f_y); if (y0 < 0) y0 = 0;");
        outLine("    int x1 = (int)ceil(dest.f_x + dest.f_width); if (x1 > s->w) x1 = s->w; int y1 = (int)ceil(dest.f_y + dest.f_height); if (y1 > s->h) y1 = s->h;");
        outLine("    for (int y = y0; y < y1; y += 1) {");
        outLine("        int sy = (int)floor(((double)y + 0.5 - dest.f_y) / dest.f_height * (double)t->h); if (sy < 0) sy = 0; if (sy >= t->h) sy = t->h - 1;");
        outLine("        for (int x = x0; x < x1; x += 1) {");
        outLine("            int sx = (int)floor(((double)x + 0.5 - dest.f_x) / dest.f_width * (double)t->w); if (sx < 0) sx = 0; if (sx >= t->w) sx = t->w - 1;");
        outLine("            size_t idx = ((size_t)sy * (size_t)t->w + (size_t)sx) * 4u;");
        outLine("            lt_canvas_blend(s, x, y, t->pixels[idx], t->pixels[idx + 1], t->pixels[idx + 2], t->pixels[idx + 3]);");
        outLine("        }");
        outLine("    }");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasDestroyTexture(") {
        outLine("LT_INLINE void lt_canvas_destroy_texture(" + texTag + " tex) { lt_texture_state *t = lt_texture_get(tex.f_handle); if (!t) return; if (t->pixels != NULL) { lt_tl_ctx.live_bytes -= (int64_t)t->pixels_bytes; free(t->pixels); } memset(t, 0, sizeof(*t)); }");
    }
    if usesIntHelper(calls, "lite$extraCanvasScratchMark(") {
        outLine("LT_INLINE int64_t lt_canvas_scratch_mark(void) { return lt_str_slab_mark(); }");
    }
    if usesIntHelper(calls, "lite$extraCanvasScratchRewind(") {
        outLine("LT_INLINE void lt_canvas_scratch_rewind(int64_t mark) { lt_str_slab_rewind(mark); }");
    }
    outLine("");
};

/** True when any call token in `calls` starts with `prefix`. */
hasCallPrefix := fn(calls: Set<String>, prefix: String): Bool {
    loop calls as tok {
        if tok.startsWithAt(0, prefix) { return true; }
    }
    false
};

/** Emits a complete C11 program driven by composable `OptConfig`. */
pub emitProgramWithConfig := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, config: optCfg.OptConfig): Unit {
    prevCompact := cCompactEmit;
    prevSourceMap := cSourceMapMode;
    cCompactEmit = config.emitFormat == optCfg.EmitFormat.Compact;
    cSourceMapMode = config.sourceMap;
    softItems := applyCSoftBuiltins(items, prefix, builtinSpecs);
    reachable := frontend.filterReachableItemsWithConfig(softItems, frontend.TARGET_C, config);
    baseCalls := frontend.targetHelperCallSet(reachable);
    calls: mut Set<String>;
    loop baseCalls as bc { mut calls.add(bc); }
    unsupported := unsupportedBuiltinCode(calls);
    if unsupported =!= "" {
        diagLib.fail("", unsupported);
    }
    if usesIntHelper(calls, "lite$listAt(") or usesIntHelper(calls, "lite$listPopBack(") or
    usesIntHelper(calls, "lite$listPopFront(") or usesIntHelper(calls, "lt_list_copy(") {
        diagLib.fail("", "C backend does not support list values yet");
    }
    var floatOutput := false;
    var hasFunctions := false;
    var hasFnOutput := false;
    var hasUnreachable := false;
    floatLiterals := usesIntHelper(calls, "lt_float_literal(");
    float8Literals := usesIntHelper(calls, "lt_float8_literal(");
    float16Literals := usesIntHelper(calls, "lt_float16_literal(");
    float32Literals := usesIntHelper(calls, "lt_float32_literal(");
    hasFloatToText := usesIntHelper(calls, "lite$floatToText(");
    hasFloat32ToText := usesIntHelper(calls, "lite$float32ToText(");
    var float8Values := float8Literals or usesHelperPrefix(calls, "lt_f8_") or usesHelperPrefix(calls, "lt_float8_") or usesIntHelper(calls, "lt_f64_to_f8(") or usesIntHelper(calls, "lt_fma_f8(") or usesIntHelper(calls, "lt_ufma_f8(") or usesIntHelper(calls, "lt_ufadd_f8(") or usesIntHelper(calls, "lt_ufsub_f8(") or usesIntHelper(calls, "lt_ufmul_f8(") or usesIntHelper(calls, "lt_ufdiv_f8(");
    var float16Values := float16Literals or usesHelperPrefix(calls, "lt_f16_") or usesHelperPrefix(calls, "lt_float16_") or usesHelperPrefix(calls, "lt_f64_to_f16") or usesIntHelper(calls, "lt_fma_f16(") or usesIntHelper(calls, "lt_ufma_f16(") or usesIntHelper(calls, "lt_ufadd_f16(") or usesIntHelper(calls, "lt_ufsub_f16(") or usesIntHelper(calls, "lt_ufmul_f16(") or usesIntHelper(calls, "lt_ufdiv_f16(");
    var float32Values := float32Literals or hasFloat32ToText or usesIntHelper(calls, "lt_float32_op(") or usesIntHelper(calls, "lt_f64_to_f32_checked(") or usesIntHelper(calls, "lt_f32_to_bits(") or usesIntHelper(calls, "lt_f32_from_bits(") or usesIntHelper(calls, "lt_f32_ufrom_bits(") or usesIntHelper(calls, "lt_ufadd_f32(") or usesIntHelper(calls, "lt_ufsub_f32(") or usesIntHelper(calls, "lt_ufmul_f32(") or usesIntHelper(calls, "lt_ufdiv_f32(") or usesIntHelper(calls, "lt_ufma_f32(");
    var floatValues := floatLiterals or float8Values or float16Values or float32Values or hasFloatToText or usesFloatArithmetic(calls) or usesIntHelper(calls, "lt_f64_to_bits(");
    fnRefTokens: mut Set<String>;
    var fnDepth := 0;
    loop reachable as item {
        baseItemKind := frontend.distinctBaseKind(item.kind);
        baseDiscardKind := if item.kind == frontend.ITEM_KIND_DISCARD { frontend.distinctBaseKind(item.name) } else { "" };
        if frontend.isFloatScalarKind(baseItemKind) { floatOutput = true; }
        if frontend.isFloatScalarKind(baseItemKind) or item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or
        (frontend.isDistinctKind(item.textValue) and frontend.isFloatScalarKind(frontend.distinctBaseKind(item.textValue))) or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isFloatScalarKind(baseDiscardKind)) { floatValues = true; }
        if baseItemKind == frontend.VALUE_KIND_FLOAT8 or (item.kind == frontend.ITEM_KIND_DISCARD and baseDiscardKind == frontend.VALUE_KIND_FLOAT8) or ((item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT) and frontend.distinctBaseKind(item.textValue) == frontend.VALUE_KIND_FLOAT8) { float8Values = true; floatValues = true; }
        if baseItemKind == frontend.VALUE_KIND_FLOAT16 or (item.kind == frontend.ITEM_KIND_DISCARD and baseDiscardKind == frontend.VALUE_KIND_FLOAT16) or ((item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT) and frontend.distinctBaseKind(item.textValue) == frontend.VALUE_KIND_FLOAT16) { float16Values = true; floatValues = true; }
        if baseItemKind == frontend.VALUE_KIND_FLOAT32 or (item.kind == frontend.ITEM_KIND_DISCARD and baseDiscardKind == frontend.VALUE_KIND_FLOAT32) { float32Values = true; }
        if item.kind == frontend.ITEM_KIND_UNREACHABLE { hasUnreachable = true; }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            hasFunctions = true;
            fnDepth = fnDepth + 1;
            checkCFunctionSignature(item);
            baseRetKind := frontend.distinctBaseKind(item.code);
            if frontend.isFloatScalarKind(baseRetKind) { floatValues = true; }
            if baseRetKind == frontend.VALUE_KIND_FLOAT8 { float8Values = true; }
            if baseRetKind == frontend.VALUE_KIND_FLOAT16 { float16Values = true; }
            if baseRetKind == frontend.VALUE_KIND_FLOAT32 { float32Values = true; }
            if item.textValue.indexOf("=Float", 0) >= 0 { floatValues = true; }
            if item.textValue.indexOf("=Float8", 0) >= 0 { float8Values = true; }
            if item.textValue.indexOf("=Float16", 0) >= 0 { float16Values = true; }
            if item.textValue.indexOf("=Float32", 0) >= 0 { float32Values = true; }
        } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
        } else if fnDepth > 0 {
            if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT { hasFnOutput = true; }
            frontend.codeReachableTokensSet(item.code, mut fnRefTokens);
            if item.kind.startsWithAt(0, "Assign") and item.runtime =!= "" {
                frontend.tokenBucketAdd(mut fnRefTokens, item.runtime);
            }
        }
        if (frontend.isTupleKind(item.kind) and frontend.cStructTag(item.kind) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isTupleKind(item.name) and frontend.cStructTag(item.name) == "") or
        ((item.kind == frontend.ITEM_KIND_LOCAL_TUPLE or item.kind == frontend.ITEM_KIND_VAR_TUPLE or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE) and frontend.cStructTag(item.textValue) == "") {
            diagLib.fail("", "C backend does not support tuple values yet");
        }
        if (frontend.isMapKind(item.kind) and frontend.cMapTag(item.kind) == "") or
        (frontend.isMapKind(item.textValue) and frontend.cMapTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isMapKind(item.name) and frontend.cMapTag(item.name) == "") {
            diagLib.fail("", "C backend does not support map values yet");
        }
        if (frontend.isSetKind(item.kind) and frontend.cSetTag(item.kind) == "") or
        (frontend.isSetKind(item.textValue) and frontend.cSetTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isSetKind(item.name) and frontend.cSetTag(item.name) == "") {
            diagLib.fail("", "C backend does not support set values yet");
        }
        if (frontend.isRcKind(item.kind) and frontend.cRcTag(item.kind) == "") or
        (frontend.isRcKind(item.textValue) and frontend.cRcTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isRcKind(item.name) and frontend.cRcTag(item.name) == "") {
            diagLib.fail("", "C backend does not support Rc values yet");
        }
        if (frontend.isSliceKind(item.kind) and frontend.cSliceTag(item.kind) == "") or
        (frontend.isSliceKind(item.textValue) and frontend.cSliceTag(item.textValue) == "") or
        (item.kind == frontend.ITEM_KIND_DISCARD and frontend.isSliceKind(item.name) and frontend.cSliceTag(item.name) == "") {
            diagLib.fail("", "C backend does not support Slice values yet");
        }
        isSupportedDistDecl := if frontend.isDistinctKind(item.textValue) {
            base := frontend.distinctBaseKind(item.textValue);
