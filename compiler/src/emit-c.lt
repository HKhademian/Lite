        outLine("        size_t off = (seg->pos + align - 1u) & ~(align - 1u);");
        outLine("        if (n <= seg->reserve && off <= seg->reserve - n) {");
        outLine("            size_t need = off + n;");
        outLine("            size_t step = (size_t)65536u; if (step < a->page_sz) { step = a->page_sz; }");
        outLine("            size_t new_com = ((need + step - 1u) / step) * step;");
        outLine("            if (new_com > seg->reserve) { new_com = seg->reserve; }");
        outLine("#if defined(_WIN32)");
        outLine("            if (VirtualAlloc((char *)seg + seg->committed, new_com - seg->committed, MEM_COMMIT, PAGE_READWRITE) == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("            if (mprotect((char *)seg + seg->committed, new_com - seg->committed, PROT_READ | PROT_WRITE) != 0) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#endif");
        outLine("            seg->committed = new_com;");
        outLine("            seg->pos = need;");
        outLine("            size_t live = a->base_bytes + (seg->pos - LT_VM_HDR_SZ);");
        outLine("            if (live > a->peak_bytes) { a->peak_bytes = live; }");
        outLine("            return (char *)seg + off;");
        outLine("        }");
        outLine("    }");
        outLine("    size_t prev_base = a->cur != NULL ? (a->base_bytes + (a->cur->pos - LT_VM_HDR_SZ)) : 0u;");
        outLine("    size_t min_blk = LT_VM_HDR_SZ + align + n;");
        outLine("    size_t reserve = (size_t)(64u * 1024u * 1024u);");
        outLine("    if (min_blk > reserve) { reserve = ((min_blk + a->page_sz - 1u) / a->page_sz) * a->page_sz; }");
        outLine("    size_t init_com = (size_t)65536u; if (init_com < a->page_sz) { init_com = a->page_sz; }");
        outLine("    if (min_blk > init_com) { init_com = ((min_blk + a->page_sz - 1u) / a->page_sz) * a->page_sz; }");
        outLine("    if (init_com > reserve) { init_com = reserve; }");
        outLine("#if defined(_WIN32)");
        outLine("    char *mem = (char *)VirtualAlloc(NULL, reserve, MEM_RESERVE, PAGE_NOACCESS);");
        outLine("    if (mem == NULL || VirtualAlloc(mem, init_com, MEM_COMMIT, PAGE_READWRITE) == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("    void *rmem = mmap(NULL, reserve, PROT_NONE, MAP_PRIVATE | LT_MAP_ANON, -1, 0);");
        outLine("    if (rmem == MAP_FAILED) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("    char *mem = (char *)rmem;");
        outLine("    if (mprotect(mem, init_com, PROT_READ | PROT_WRITE) != 0) { munmap(mem, reserve); fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#else");
        outLine("    reserve = init_com;");
        outLine("    char *mem = malloc(init_com);");
        outLine("    if (mem == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#endif");
        outLine("    lt_vm_seg *ns = (lt_vm_seg *)mem;");
        outLine("    ns->prev = a->cur; ns->reserve = reserve; ns->committed = init_com; ns->pos = LT_VM_HDR_SZ; ns->prev_base_bytes = prev_base;");
        outLine("    if (a->root == NULL) { a->root = ns; }");
        outLine("    a->cur = ns;");
        outLine("    a->base_bytes = prev_base;");
        outLine("    size_t off = (ns->pos + align - 1u) & ~(align - 1u);");
        outLine("    ns->pos = off + n;");
        outLine("    size_t live = a->base_bytes + (ns->pos - LT_VM_HDR_SZ);");
        outLine("    if (live > a->peak_bytes) { a->peak_bytes = live; }");
        outLine("    return mem + off;");
        outLine("}");
        outLine("LT_INLINE void *lt_vm_arena_alloc(lt_vm_arena *a, size_t align, size_t n) {");
        outLine("    if (align < 8u) { align = 8u; }");
        outLine("    lt_vm_seg *seg = a->cur;");
        outLine("    if (LT_VM_LIKELY(seg != NULL)) {");
        outLine("        size_t off = (seg->pos + align - 1u) & ~(align - 1u);");
        outLine("        if (LT_VM_LIKELY(n <= seg->committed && off <= seg->committed - n)) {");
        outLine("            seg->pos = off + n;");
        outLine("            size_t live = a->base_bytes + (seg->pos - LT_VM_HDR_SZ);");
        outLine("            if (live > a->peak_bytes) { a->peak_bytes = live; }");
        outLine("            return (char *)seg + off;");
        outLine("        }");
        outLine("    }");
        outLine("    return lt_vm_arena_alloc_slow(a, align, n);");
        outLine("}");
        outLine("LT_INLINE int64_t lt_vm_arena_mark(lt_vm_arena *a) {");
        outLine("    int64_t id = ++a->mark_seq;");
        outLine("    int idx = a->mark_n < 64 ? a->mark_n++ : 63;");
        outLine("    a->marks[idx].id = id; a->marks[idx].seg = a->cur; a->marks[idx].pos = a->cur != NULL ? a->cur->pos : LT_VM_HDR_SZ; a->marks[idx].base_bytes = a->base_bytes;");
        outLine("    return id;");
        outLine("}");
        outLine("LT_INLINE void lt_vm_arena_rewind(lt_vm_arena *a, int64_t mark) {");
        outLine("    for (int i = a->mark_n - 1; i >= 0; i -= 1) {");
        outLine("        if (a->marks[i].id == mark) {");
        outLine("            lt_vm_seg *target = a->marks[i].seg;");
        outLine("            while (a->cur != NULL && a->cur != target) {");
        outLine("                if (target == NULL && a->cur == a->root) { break; }");
        outLine("                lt_vm_seg *prev = a->cur->prev;");
        outLine("#if defined(_WIN32)");
        outLine("                VirtualFree(a->cur, 0, MEM_RELEASE);");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("                munmap(a->cur, a->cur->reserve);");
        outLine("#else");
        outLine("                free(a->cur);");
        outLine("#endif");
        outLine("                a->cur = prev;");
        outLine("            }");
        outLine("            if (a->cur != NULL) {");
        outLine("                a->cur->pos = target != NULL ? a->marks[i].pos : LT_VM_HDR_SZ;");
        outLine("#if defined(__unix__) || defined(__APPLE__)");
        outLine("                if (a->cur == a->root && a->cur->committed > LT_VM_HOT_FLOOR && a->cur->pos <= LT_VM_HOT_FLOOR) {");
        outLine("                    size_t rel = a->cur->committed - LT_VM_HOT_FLOOR;");
        outLine("                    madvise((char *)a->cur + LT_VM_HOT_FLOOR, rel, MADV_DONTNEED);");
        outLine("                    mprotect((char *)a->cur + LT_VM_HOT_FLOOR, rel, PROT_NONE);");
        outLine("                    a->cur->committed = LT_VM_HOT_FLOOR;");
        outLine("                }");
        outLine("#endif");
        outLine("            }");
        outLine("            a->base_bytes = a->marks[i].base_bytes;");
        outLine("            a->mark_n = i;");
        outLine("            a->generation += 1u;");
        outLine("            return;");
        outLine("        }");
        outLine("    }");
        outLine("}");
        outLine("LT_INLINE void lt_vm_arena_destroy(lt_vm_arena *a) {");
        outLine("    lt_vm_seg *seg = a->cur;");
        outLine("    while (seg != NULL) {");
        outLine("        lt_vm_seg *prev = seg->prev;");
        outLine("#if defined(_WIN32)");
        outLine("        VirtualFree(seg, 0, MEM_RELEASE);");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        munmap(seg, seg->reserve);");
        outLine("#else");
        outLine("        free(seg);");
        outLine("#endif");
        outLine("        seg = prev;");
        outLine("    }");
        outLine("    a->root = NULL; a->cur = NULL; a->base_bytes = 0u; a->mark_n = 0;");
        outLine("}");
        outLine("#define LT_HEAP_CLASSES 12");
        outLine("#define LT_HEAP_SB_RESERVE ((size_t)(2u * 1024u * 1024u))");
        outLine("#define LT_SB_HDR_SZ ((size_t)64u)");
        outLine("#define LT_SPAN_HDR_SZ ((size_t)32u)");
        outLine("typedef struct { uint32_t cls; uint32_t pad; uint64_t size; } lt_blk_hdr;");
        outLine("typedef struct lt_heap_sb { struct lt_heap_sb *prev_all; size_t reserve; size_t committed; size_t pos; } lt_heap_sb;");
        outLine("typedef struct lt_vm_span { struct lt_vm_span *prev; struct lt_vm_span *next; size_t map_size; size_t pad; } lt_vm_span;");
        outLine("_Static_assert(sizeof(lt_blk_hdr) == 16, \"lt_blk_hdr\");");
        outLine("_Static_assert(sizeof(lt_vm_span) <= 32, \"lt_vm_span\");");
        outLine("typedef struct { lt_heap_sb *all_sbs; lt_heap_sb *cur_sb[LT_HEAP_CLASSES]; void *free_heads[LT_HEAP_CLASSES]; lt_vm_span *spans; size_t page_sz; } lt_heap;");
        outLine("#endif");
        outLine("typedef struct { lt_vm_arena temp; lt_vm_arena scope; lt_heap heap; int64_t heap_allocs; int64_t live_bytes; bool in_frame; } lt_ctx;");
        outLine("LT_THREAD_LOCAL lt_ctx lt_tl_ctx;");
        outLine("#if defined(LITE_ALLOC_SYSTEM)");
        outLine("LT_INLINE void *lt_heap_alloc(size_t n) {");
        outLine("    size_t req = n > 0u ? n : 1u;");
        outLine("    char *raw = malloc(sizeof(lt_sys_blk_hdr) + req);");
        outLine("    if (raw == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("    lt_sys_blk_hdr *hdr = (lt_sys_blk_hdr *)raw;");
        outLine("    hdr->size = req; hdr->pad = 0u;");
        outLine("    lt_tl_ctx.heap_allocs += 1;");
        outLine("    lt_tl_ctx.live_bytes += (int64_t)req;");
        outLine("    return raw + sizeof(lt_sys_blk_hdr);");
        outLine("}");
        outLine("LT_INLINE void lt_heap_free(void *p) {");
        outLine("    if (p == NULL) { return; }");
        outLine("    lt_sys_blk_hdr *hdr = ((lt_sys_blk_hdr *)p) - 1;");
        outLine("    lt_tl_ctx.live_bytes -= (int64_t)hdr->size;");
        outLine("    free(hdr);");
        outLine("}");
        outLine("LT_INLINE void *lt_heap_realloc(void *p, size_t old_n, size_t new_n) {");
        outLine("    (void)old_n;");
        outLine("    if (p == NULL) { return lt_heap_alloc(new_n); }");
        outLine("    if (new_n == 0u) { lt_heap_free(p); return NULL; }");
        outLine("    lt_sys_blk_hdr *hdr = ((lt_sys_blk_hdr *)p) - 1;");
        outLine("    size_t cur = hdr->size;");
        outLine("    char *nb = realloc(hdr, sizeof(lt_sys_blk_hdr) + new_n);");
        outLine("    if (nb == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("    hdr = (lt_sys_blk_hdr *)nb; hdr->size = new_n;");
        outLine("    lt_tl_ctx.live_bytes += (int64_t)new_n - (int64_t)cur;");
        outLine("    return nb + sizeof(lt_sys_blk_hdr);");
        outLine("}");
        outLine("LT_INLINE void lt_heap_destroy(lt_heap *h) { (void)h; }");
        outLine("#else");
        outLine("LT_INLINE uint32_t lt_heap_cls(size_t n) {");
        outLine("    size_t cap = 16u;");
        outLine("    for (uint32_t c = 0u; c < (uint32_t)LT_HEAP_CLASSES; c += 1u) { if (n <= cap) { return c; } cap <<= 1; }");
        outLine("    return UINT32_MAX;");
        outLine("}");
        outLine("LT_INLINE void *lt_heap_alloc_slow(lt_heap *h, uint32_t cls, size_t n) {");
        outLine("    if (h->page_sz == 0u) {");
        outLine("#if defined(_WIN32)");
        outLine("        SYSTEM_INFO si; GetSystemInfo(&si); h->page_sz = (size_t)si.dwPageSize;");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        long psz = sysconf(_SC_PAGESIZE); h->page_sz = psz > 0 ? (size_t)psz : (size_t)4096u;");
        outLine("#else");
        outLine("        h->page_sz = (size_t)4096u;");
        outLine("#endif");
        outLine("    }");
        outLine("    if (cls == UINT32_MAX) {");
        outLine("        size_t total = LT_SPAN_HDR_SZ + sizeof(lt_blk_hdr) + n;");
        outLine("        size_t map_sz = ((total + h->page_sz - 1u) / h->page_sz) * h->page_sz;");
        outLine("#if defined(_WIN32)");
        outLine("        char *mem = (char *)VirtualAlloc(NULL, map_sz, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);");
        outLine("        if (mem == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        void *rmem = mmap(NULL, map_sz, PROT_READ | PROT_WRITE, MAP_PRIVATE | LT_MAP_ANON, -1, 0);");
        outLine("        if (rmem == MAP_FAILED) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("        char *mem = (char *)rmem;");
        outLine("#else");
        outLine("        char *mem = malloc(map_sz);");
        outLine("        if (mem == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#endif");
        outLine("        lt_vm_span *sp = (lt_vm_span *)mem;");
        outLine("        sp->prev = NULL; sp->next = h->spans; sp->map_size = map_sz; sp->pad = 0u;");
        outLine("        if (h->spans != NULL) { h->spans->prev = sp; }");
        outLine("        h->spans = sp;");
        outLine("        lt_blk_hdr *hdr = (lt_blk_hdr *)(mem + LT_SPAN_HDR_SZ);");
        outLine("        hdr->cls = UINT32_MAX; hdr->pad = 0u; hdr->size = (uint64_t)n;");
        outLine("        lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)n;");
        outLine("        return (void *)(hdr + 1);");
        outLine("    }");
        outLine("    size_t class_sz = (size_t)16u << cls;");
        outLine("    size_t stride = sizeof(lt_blk_hdr) + class_sz;");
        outLine("    lt_heap_sb *sb = h->cur_sb[cls];");
        outLine("    if (sb != NULL && sb->pos + stride <= sb->reserve) {");
        outLine("        size_t need = sb->pos + stride;");
        outLine("        size_t step = (size_t)65536u; if (step < h->page_sz) { step = h->page_sz; }");
        outLine("        size_t new_com = ((need + step - 1u) / step) * step;");
        outLine("        if (new_com > sb->reserve) { new_com = sb->reserve; }");
        outLine("#if defined(_WIN32)");
        outLine("        if (VirtualAlloc((char *)sb + sb->committed, new_com - sb->committed, MEM_COMMIT, PAGE_READWRITE) == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        if (mprotect((char *)sb + sb->committed, new_com - sb->committed, PROT_READ | PROT_WRITE) != 0) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#endif");
        outLine("        sb->committed = new_com;");
        outLine("        char *slot = (char *)sb + sb->pos; sb->pos = need;");
        outLine("        lt_blk_hdr *hdr = (lt_blk_hdr *)slot; hdr->cls = cls; hdr->pad = 0u; hdr->size = (uint64_t)n;");
        outLine("        lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)n;");
        outLine("        return (void *)(hdr + 1);");
        outLine("    }");
        outLine("    size_t reserve = LT_HEAP_SB_RESERVE;");
        outLine("    size_t init_com = (size_t)65536u; if (init_com < h->page_sz) { init_com = h->page_sz; }");
        outLine("    if (LT_SB_HDR_SZ + stride > init_com) { init_com = ((LT_SB_HDR_SZ + stride + h->page_sz - 1u) / h->page_sz) * h->page_sz; }");
        outLine("    if (init_com > reserve) { init_com = reserve; }");
        outLine("#if defined(_WIN32)");
        outLine("    char *mem = (char *)VirtualAlloc(NULL, reserve, MEM_RESERVE, PAGE_NOACCESS);");
        outLine("    if (mem == NULL || VirtualAlloc(mem, init_com, MEM_COMMIT, PAGE_READWRITE) == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("    void *rmem = mmap(NULL, reserve, PROT_NONE, MAP_PRIVATE | LT_MAP_ANON, -1, 0);");
        outLine("    if (rmem == MAP_FAILED) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("    char *mem = (char *)rmem;");
        outLine("    if (mprotect(mem, init_com, PROT_READ | PROT_WRITE) != 0) { munmap(mem, reserve); fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#else");
        outLine("    reserve = init_com;");
        outLine("    char *mem = malloc(init_com);");
        outLine("    if (mem == NULL) { fprintf(stderr, \"MemoryFault: out of memory\\n\"); exit(1); }");
        outLine("#endif");
        outLine("    sb = (lt_heap_sb *)mem; sb->prev_all = h->all_sbs; h->all_sbs = sb; sb->reserve = reserve; sb->committed = init_com; sb->pos = LT_SB_HDR_SZ; h->cur_sb[cls] = sb;");
        outLine("    char *slot = (char *)sb + sb->pos; sb->pos += stride;");
        outLine("    lt_blk_hdr *hdr = (lt_blk_hdr *)slot; hdr->cls = cls; hdr->pad = 0u; hdr->size = (uint64_t)n;");
        outLine("    lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)n;");
        outLine("    return (void *)(hdr + 1);");
        outLine("}");
        outLine("LT_INLINE void *lt_heap_alloc(size_t n) {");
        outLine("    size_t req = n > 0u ? n : 1u;");
        outLine("    lt_heap *h = &lt_tl_ctx.heap;");
        outLine("    if (LT_VM_LIKELY(req <= (size_t)32768u)) {");
        outLine("        uint32_t cls = lt_heap_cls(req);");
        outLine("        void *fp = h->free_heads[cls];");
        outLine("        if (LT_VM_LIKELY(fp != NULL)) {");
        outLine("            h->free_heads[cls] = *(void **)fp;");
        outLine("            lt_blk_hdr *hdr = ((lt_blk_hdr *)fp) - 1;");
        outLine("            hdr->cls = cls; hdr->size = (uint64_t)req;");
        outLine("            lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)req;");
        outLine("            return fp;");
        outLine("        }");
        outLine("        size_t stride = sizeof(lt_blk_hdr) + ((size_t)16u << cls);");
        outLine("        lt_heap_sb *sb = h->cur_sb[cls];");
        outLine("        if (LT_VM_LIKELY(sb != NULL && sb->pos + stride <= sb->committed)) {");
        outLine("            char *slot = (char *)sb + sb->pos; sb->pos += stride;");
        outLine("            lt_blk_hdr *hdr = (lt_blk_hdr *)slot; hdr->cls = cls; hdr->pad = 0u; hdr->size = (uint64_t)req;");
        outLine("            lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)req;");
        outLine("            return (void *)(hdr + 1);");
        outLine("        }");
        outLine("        return lt_heap_alloc_slow(h, cls, req);");
        outLine("    }");
        outLine("    return lt_heap_alloc_slow(h, UINT32_MAX, req);");
        outLine("}");
        outLine("LT_INLINE void lt_heap_free(void *p) {");
        outLine("    if (p == NULL) { return; }");
        outLine("    lt_blk_hdr *hdr = ((lt_blk_hdr *)p) - 1;");
        outLine("    lt_tl_ctx.live_bytes -= (int64_t)hdr->size;");
        outLine("    lt_heap *h = &lt_tl_ctx.heap;");
        outLine("    if (LT_VM_LIKELY(hdr->cls < (uint32_t)LT_HEAP_CLASSES)) {");
        outLine("        *(void **)p = h->free_heads[hdr->cls];");
        outLine("        h->free_heads[hdr->cls] = p;");
        outLine("        return;");
        outLine("    }");
        outLine("    lt_vm_span *sp = (lt_vm_span *)((char *)hdr - LT_SPAN_HDR_SZ);");
        outLine("    if (sp->prev != NULL) { sp->prev->next = sp->next; } else { h->spans = sp->next; }");
        outLine("    if (sp->next != NULL) { sp->next->prev = sp->prev; }");
        outLine("#if defined(_WIN32)");
        outLine("    VirtualFree(sp, 0, MEM_RELEASE);");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("    munmap(sp, sp->map_size);");
        outLine("#else");
        outLine("    free(sp);");
        outLine("#endif");
        outLine("}");
        outLine("LT_INLINE void *lt_heap_realloc(void *p, size_t old_n, size_t new_n) {");
        outLine("    (void)old_n;");
        outLine("    if (p == NULL) { return lt_heap_alloc(new_n); }");
        outLine("    if (new_n == 0u) { lt_heap_free(p); return NULL; }");
        outLine("    lt_blk_hdr *hdr = ((lt_blk_hdr *)p) - 1;");
        outLine("    size_t cur_n = (size_t)hdr->size;");
        outLine("    if (hdr->cls < (uint32_t)LT_HEAP_CLASSES) {");
        outLine("        size_t cap_sz = (size_t)16u << hdr->cls;");
        outLine("        if (new_n <= cap_sz) { lt_tl_ctx.live_bytes += (int64_t)new_n - (int64_t)cur_n; hdr->size = (uint64_t)new_n; return p; }");
        outLine("    }");
        outLine("    void *np = lt_heap_alloc(new_n);");
        outLine("    size_t cp = cur_n < new_n ? cur_n : new_n;");
        outLine("    if (cp > 0u) { memcpy(np, p, cp); }");
        outLine("    lt_heap_free(p);");
        outLine("    return np;");
        outLine("}");
        outLine("LT_INLINE void lt_heap_destroy(lt_heap *h) {");
        outLine("    lt_heap_sb *sb = h->all_sbs;");
        outLine("    while (sb != NULL) {");
        outLine("        lt_heap_sb *prev = sb->prev_all;");
        outLine("#if defined(_WIN32)");
        outLine("        VirtualFree(sb, 0, MEM_RELEASE);");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        munmap(sb, sb->reserve);");
        outLine("#else");
        outLine("        free(sb);");
        outLine("#endif");
        outLine("        sb = prev;");
        outLine("    }");
        outLine("    lt_vm_span *sp = h->spans;");
        outLine("    while (sp != NULL) {");
        outLine("        lt_vm_span *next = sp->next;");
        outLine("#if defined(_WIN32)");
        outLine("        VirtualFree(sp, 0, MEM_RELEASE);");
        outLine("#elif defined(__unix__) || defined(__APPLE__)");
        outLine("        munmap(sp, sp->map_size);");
        outLine("#else");
        outLine("        free(sp);");
        outLine("#endif");
        outLine("        sp = next;");
        outLine("    }");
        outLine("    memset(h, 0, sizeof(*h));");
        outLine("}");
        outLine("#endif");
        outLine("typedef struct { int64_t rc; uint64_t payload_bytes; } lt_box_hdr;");
        outLine("_Static_assert(sizeof(lt_box_hdr) == 16, \"lt_box_hdr\");");
        outLine("LT_INLINE void *lt_box_alloc(size_t n) {");
        outLine("    char *raw = (char *)lt_heap_alloc(sizeof(lt_box_hdr) + n);");
        outLine("    memset(raw, 0, sizeof(lt_box_hdr) + n);");
        outLine("    ((lt_box_hdr *)raw)->rc = 1;");
        outLine("    ((lt_box_hdr *)raw)->payload_bytes = (uint64_t)n;");
        outLine("    return (void *)(raw + sizeof(lt_box_hdr));");
        outLine("}");
        outLine("LT_INLINE void *lt_box_retain(void *p) {");
        outLine("    if (p == NULL) { return NULL; }");
        outLine("    ((lt_box_hdr *)((char *)p - sizeof(lt_box_hdr)))->rc += 1;");
        outLine("    return p;");
        outLine("}");
        outLine("LT_INLINE bool lt_box_dec(void *p) {");
        outLine("    if (p == NULL) { return false; }");
        outLine("    lt_box_hdr *h = (lt_box_hdr *)((char *)p - sizeof(lt_box_hdr));");
        outLine("    h->rc -= 1;");
        outLine("    return h->rc <= 0;");
        outLine("}");
        outLine("LT_INLINE void lt_box_free_raw(void *p) { if (p != NULL) { lt_heap_free((char *)p - sizeof(lt_box_hdr)); } }");
        outLine("LT_INLINE void lt_box_release(void *p) { if (lt_box_dec(p)) { lt_box_free_raw(p); } }");
        outLine("LT_INLINE void lt_ctx_shutdown(void) {");
        outLine("    const char *chk = getenv(\"LITE_CHECK_LEAKS\");");
        outLine("    if (chk != NULL && chk[0] == '1' && lt_tl_ctx.live_bytes != 0) {");
        outLine("        fprintf(stderr, \"MemoryLeak: live_bytes=%\" PRId64 \"\\n\", lt_tl_ctx.live_bytes);");
        outLine("        abort();");
        outLine("    }");
        outLine("    lt_vm_arena_destroy(&lt_tl_ctx.temp);");
        outLine("    lt_vm_arena_destroy(&lt_tl_ctx.scope);");
        outLine("    lt_heap_destroy(&lt_tl_ctx.heap);");
        outLine("}");
        outLine("LT_INLINE uint64_t lt_arena_gen(void) { return lt_tl_ctx.temp.generation; }");
        outLine("LT_INLINE char *lt_str_alloc(size_t n) { return (char *)lt_vm_arena_alloc(&lt_tl_ctx.temp, 8u, n); }");
        outLine("LT_INLINE lt_str lt_str_make_jumbo(const char *src, size_t len, int64_t cp_len) {");
        outLine("    char *blk = lt_str_alloc(sizeof(lt_str_jumbo_hdr) + len + 1u);");
        outLine("    lt_str_jumbo_hdr *hdr = (lt_str_jumbo_hdr *)blk;");
        outLine("    hdr->byte_len = (uint64_t)len; hdr->cp_len = cp_len;");
        outLine("    char *p = blk + sizeof(lt_str_jumbo_hdr);");
        outLine("    if (len > 0u && src != NULL) { memcpy(p, src, len); }");
        outLine("    p[len] = '\\0';");
        outLine("    return (lt_str){ .ext = { .data = p, .byte_len = UINT32_MAX, .meta = UINT32_C(0xFFFFFFFF) } };");
        outLine("}");
        outLine("LT_INLINE lt_str lt_str_make(const char *src, size_t len, int64_t cp_len) {");
        outLine("    if (len == 0u) { return LT_EMPTY_STR; }");
        outLine("    if (len <= 14u) { return lt_str_from_sso(src, len); }");
        outLine("    if (len >= (size_t)UINT32_MAX) { return lt_str_make_jumbo(src, len, cp_len); }");
        outLine("    char *buf = lt_str_alloc(len + 1u);");
        outLine("    memcpy(buf, src, len); buf[len] = '\\0';");
        outLine("    return (lt_str){ .ext = { .data = buf, .byte_len = (uint32_t)len, .meta = lt_str_pack_meta(cp_len) } };");
        outLine("}");
        outLine("LT_INLINE int64_t lt_str_slab_mark(void) { return lt_vm_arena_mark(&lt_tl_ctx.temp); }");
        outLine("LT_INLINE void lt_str_slab_rewind(int64_t mark) { lt_vm_arena_rewind(&lt_tl_ctx.temp, mark); }");
    } else if usesTextPrimitives(calls) or usesCTextSoftUtf8(calls) {
        outLine("#define lt_arena_gen() UINT64_C(0)");
    }
    if needStrFromCstr {
        outLine("LT_INLINE lt_str lt_text_from_cstr(const char *s) {");
        outLine("    if (s == NULL || s[0] == '\\0') { return LT_EMPTY_STR; }");
        outLine("    size_t n = strlen(s);");
        outLine("    if (n <= 14u) { return lt_str_from_sso(s, n); }");
        outLine("    const unsigned char *p = (const unsigned char *)s;");
        outLine("    int64_t cp = 0;");
        outLine("    for (size_t i = 0u; i < n; i += 1u) { if ((p[i] & 0xC0u) != 0x80u) { cp += 1; } }");
        outLine("    return lt_str_make(s, n, cp);");
        outLine("}");
        outLine("LT_INLINE lt_str lt_text_from_owned_cstr(char *s) {");
        outLine("    if (s == NULL) { return LT_EMPTY_STR; }");
        outLine("    lt_str r = lt_text_from_cstr(s); free(s); return r;");
        outLine("}");
    }
    if needStrFromBuf {
        outLine("LT_INLINE lt_str lt_text_from_buf(const char *s, size_t len, int64_t cp_len) {");
        outLine("    if (len == 0u || s == NULL) { if (s != NULL) { free((void *)(uintptr_t)s); } return LT_EMPTY_STR; }");
        outLine("    lt_str r = lt_str_make(s, len, cp_len);");
        outLine("    free((void *)(uintptr_t)s);");
        outLine("    return r;");
        outLine("}");
    }
    if hasExit {
        if usesRuntimeCtx {
            outLine("static _Noreturn void lt_exit(int64_t status) { fflush(stdout); lt_vm_arena_destroy(&lt_tl_ctx.temp); lt_vm_arena_destroy(&lt_tl_ctx.scope); lt_heap_destroy(&lt_tl_ctx.heap); exit((int)status); }");
        } else {
            outLine("static _Noreturn void lt_exit(int64_t status) { fflush(stdout); exit((int)status); }");
        }
    }
    emitIntArithmeticHelpers(calls, source, prefix, config);
    emitIntBitwiseHelpers(calls, config);
    emitFloatArithmeticHelpers(calls, float8Values, float16Values, float8Literals, float16Literals, config);
    emitIntDivisionHelpers(calls, config);
    emitUncheckedCHelpers(calls, config);
    if hasAnyList {
        outLine("typedef struct { uint64_t len; uint64_t cap; } lt_list_jumbo_hdr;");
        outLine("#define LT_LIST_SCOPE_BIT UINT32_C(0x80000000)");
    }
    if hasHoistedFns or hasFnTypes {
        outLine("typedef struct { void (*drop)(void *); void *(*clone)(void *); } lt_env_hdr;");
    }
    if hasFloatToText {
        outLine("static lt_str lt_float_to_text(double value) {");
        outLine("    char tmp[64];");
        outLine("    if (!lt_float_format(value, tmp)) { return LT_ASTR(\"0\"); }");
        outLine("    size_t n = strlen(tmp);");
        outLine("    return lt_str_make(tmp, n, (int64_t)n);");
        outLine("}");
    }
    if hasFloat32ToText {
        outLine("static lt_str lt_float32_to_text(float value) {");
        outLine("    char tmp[64];");
        outLine("    if (!lt_float_format((double)value, tmp)) { return LT_ASTR(\"0\"); }");
        outLine("    size_t n = strlen(tmp);");
        outLine("    return lt_str_make(tmp, n, (int64_t)n);");
        outLine("}");
    }
    if usesStringConcat(calls) { emitStringConcatHelper(); }
    emitTextPrimitiveHelpers(calls);
    emitInputHelpers(calls);
    loop orderedEntries as oe {
        isL := oe.startsWithAt(0, "L|");
        isA := oe.startsWithAt(0, "A|");
        isM := oe.startsWithAt(0, "M|");
        isE := oe.startsWithAt(0, "E|");
        isR := oe.startsWithAt(0, "R|");
        isV := oe.startsWithAt(0, "V|");
        isF := oe.startsWithAt(0, "F|");
        payload := oe.slice(2, oe.length());
        if isL {
            lTag := frontend.cListTag(payload);
            lNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "L:" + lTag);
            lNeedPrint := frontend.tokenBucketHas(printTypeKeys, "L:" + lTag);
            lNeedFrom := (hasInputArgs and lTag == "str") or arrSliceNeedFrom.has(lTag);
            emitCListTagHelpers(lTag, payload, calls, lNeedCopy, lNeedPrint, lNeedFrom, config);
        } else if isA {
            aTag := frontend.cArrayTag(payload);
            aNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "A:" + aTag);
            aNeedPrint := frontend.tokenBucketHas(printTypeKeys, "A:" + aTag);
            emitCArrayHelpers(payload, calls, aNeedCopy, aNeedPrint, config);
        } else if isM {
            mTag := frontend.cMapTag(payload);
            mNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "M:" + mTag);
            mNeedPrint := frontend.tokenBucketHas(printTypeKeys, "M:" + mTag);
            emitCMapHelpers(payload, calls, mNeedCopy, mNeedPrint);
        } else if isE {
            eTag := frontend.cSetTag(payload);
            eNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "E:" + eTag);
            eNeedPrint := frontend.tokenBucketHas(printTypeKeys, "E:" + eTag);
            emitCSetHelpers(payload, calls, eNeedCopy, eNeedPrint);
        } else if isR {
            rTag := frontend.cRcTag(payload);
            rNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "R:" + rTag);
            rNeedPrint := frontend.tokenBucketHas(printTypeKeys, "R:" + rTag);
            emitCRcHelpers(payload, calls, rNeedCopy, rNeedPrint);
        } else if isV {
            vTag := frontend.cSliceTag(payload);
            vNeedPrint := frontend.tokenBucketHas(printTypeKeys, "V:" + vTag);
            emitCSliceHelpers(payload, calls, vNeedPrint, config);
        } else if isF {
            emitCFnTypeHelper(payload, calls);
        } else {
            sTag := frontend.cStructTag(payload);
            sNeedCopy := frontend.tokenBucketHas(copyTypeKeys, "S:" + sTag);
            sNeedPrint := frontend.tokenBucketHas(printTypeKeys, "S:" + sTag);
            emitCStructHelpers(payload, sNeedCopy, sNeedPrint, config);
        }
    }
    loop sliceSplitKinds as spKind {
        vTag := frontend.cSliceTag(spKind);
        pairTag := frontend.cStructTag("(left:" + spKind + ",right:" + spKind + ")");
        if pairTag =!= "" {
            outLine("LT_INLINE " + pairTag + " " + vTag + "_split_at(" + vTag + " s, int64_t mid, size_t at) {");
            outLine("    if (LT_UNLIKELY(mid < 0 || mid > s.len)) { lt_bound_fault(at, \"splitAt index outside slice extent\"); }");
            outLine("    " + vTag + " left = (mid == 0) ? (" + vTag + "){ .data = NULL, .len = 0 } : (" + vTag + "){ .data = s.data, .len = mid };");
            outLine("    int64_t rlen = s.len - mid;");
            outLine("    " + vTag + " right = (rlen == 0) ? (" + vTag + "){ .data = NULL, .len = 0 } : (" + vTag + "){ .data = s.data + mid, .len = rlen };");
            outLine("    return (" + pairTag + "){ .f_left = left, .f_right = right };");
            outLine("}");
        }
    }
    if usesIntHelper(calls, "lt_str_bytes(") {
        outLine("LT_INLINE lt_slice_u8 lt_str_bytes(const lt_str *s) {");
        outLine("    size_t bl = lt_str_byte_len(*s);");
        outLine("    if (bl == 0u) { return (lt_slice_u8){ .data = NULL, .len = 0 }; }");
        outLine("    const char *p = lt_str_data(s);");
        outLine("    return (lt_slice_u8){ .data = (uint8_t *)(uintptr_t)p, .len = (int64_t)bl };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_str_bytes_lit(") {
        outLine("LT_INLINE lt_slice_u8 lt_str_bytes_lit(const char *s, size_t n) {");
        outLine("    if (n == 0u) { return (lt_slice_u8){ .data = NULL, .len = 0 }; }");
        outLine("    return (lt_slice_u8){ .data = (uint8_t *)(uintptr_t)s, .len = (int64_t)n };");
        outLine("}");
    }
    var convIdx := 0;
    convCount := convExpKinds.length();
    loop convIdx < convCount {
        emitCTupleConvHelper(convExpKinds[convIdx], convActKinds[convIdx]);
        convIdx = convIdx + 1;
    }
    loop calls as callTok {
        if callTok.startsWithAt(0, "lt_wmul_") and callTok.endsWith("(") {
            sep := callTok.indexOf("__", 8);
            if sep > 8 {
                it := callTok.slice(8, sep);
                sTag := callTok.slice(sep + 2, callTok.length() - 1);
                fnNm := "lt_wmul_" + it + "__" + sTag;
                isU := it.at(0) == "u";
                bitsStr := it.slice(1, it.length());
                cT := if bitsStr == "64" { if isU { "uint64_t" } else { "int64_t" } }
                else if bitsStr == "32" { if isU { "uint32_t" } else { "int32_t" } }
                else if bitsStr == "16" { if isU { "uint16_t" } else { "int16_t" } }
                else { if isU { "uint8_t" } else { "int8_t" } };
                outLine("LT_INLINE " + sTag + " " + fnNm + "(" + cT + " a, " + cT + " b) {");
                if bitsStr == "64" {
                    if isU {
                        outLine("#if defined(__SIZEOF_INT128__)");
                        outLine("    unsigned __int128 p = (unsigned __int128)a * (unsigned __int128)b;");
                        outLine("    return (" + sTag + "){ .f_lo = (uint64_t)p, .f_hi = (uint64_t)(p >> 64) };");
                        outLine("#else");
                        outLine("    uint64_t al = (uint32_t)a, ah = a >> 32, bl = (uint32_t)b, bh = b >> 32;");
                        outLine("    uint64_t p0 = al * bl, p1 = al * bh, p2 = ah * bl, p3 = ah * bh;");
                        outLine("    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;");
                        outLine("    uint64_t hi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);");
                        outLine("    return (" + sTag + "){ .f_lo = a * b, .f_hi = hi };");
                        outLine("#endif");
                    } else {
                        outLine("#if defined(__SIZEOF_INT128__)");
                        outLine("    __int128 p = (__int128)a * (__int128)b;");
                        outLine("    return (" + sTag + "){ .f_lo = (int64_t)(uint64_t)p, .f_hi = (int64_t)(p >> 64) };");
                        outLine("#else");
                        outLine("    uint64_t ua = (uint64_t)a, ub = (uint64_t)b;");
                        outLine("    uint64_t al = (uint32_t)ua, ah = ua >> 32, bl = (uint32_t)ub, bh = ub >> 32;");
                        outLine("    uint64_t p0 = al * bl, p1 = al * bh, p2 = ah * bl, p3 = ah * bh;");
                        outLine("    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;");
                        outLine("    uint64_t uhi = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);");
                        outLine("    if (a < 0) { uhi -= ub; } if (b < 0) { uhi -= ua; }");
                        outLine("    return (" + sTag + "){ .f_lo = (int64_t)(ua * ub), .f_hi = (int64_t)uhi };");
                        outLine("#endif");
                    }
                } else {
                    if isU {
                        outLine("    uint64_t p = (uint64_t)a * (uint64_t)b;");
                        maskExpr := if bitsStr == "1" { "UINT64_C(1)" } else if bitsStr == "2" { "UINT64_C(3)" } else if bitsStr == "4" { "UINT64_C(15)" } else { "" };
                        if maskExpr =!= "" {
                            outLine("    return (" + sTag + "){ .f_lo = (uint8_t)(p & " + maskExpr + "), .f_hi = (uint8_t)((p >> " + bitsStr + ") & " + maskExpr + ") };");
                        } else {
                            outLine("    return (" + sTag + "){ .f_lo = (" + cT + ")p, .f_hi = (" + cT + ")(p >> " + bitsStr + ") };");
                        }
                    } else {
                        outLine("    int64_t p = (int64_t)a * (int64_t)b;");
                        outLine("    int64_t phi = (p >= 0) ? (int64_t)((uint64_t)p >> " + bitsStr + ") : (int64_t)(~((~(uint64_t)p) >> " + bitsStr + "));");
                        if bitsStr == "1" or bitsStr == "2" or bitsStr == "4" {
                            outLine("    return (" + sTag + "){ .f_lo = lt_wrap_s((uint64_t)p, " + bitsStr + "), .f_hi = lt_wrap_s((uint64_t)phi, " + bitsStr + ") };");
                        } else {
                            outLine("    return (" + sTag + "){ .f_lo = (" + cT + ")((uint64_t)p), .f_hi = (" + cT + ")((uint64_t)phi) };");
                        }
                    }
                }
                outLine("}");
            }
        }
    }
    if hasMainArgs {
        outLine("static int lt_argc = 0;");
        outLine("static char **lt_argv = NULL;");
    }
    if hasInputArgs {
        outLine("static lt_list_str lt_input_args(void) {");
        outLine("    if (lt_argc <= 1) { return (lt_list_str){ NULL, 0u, 0u }; }");
        outLine("    int64_t n = (int64_t)(lt_argc - 1);");
        outLine("    lt_str *data = (lt_str *)lt_heap_alloc((size_t)n * sizeof(lt_str));");
        outLine("    for (int64_t i = 0; i < n; i += 1) { data[i] = lt_text_from_cstr(lt_argv[i + 1]); }");
        outLine("    return (lt_list_str){ data, (uint32_t)n, (uint32_t)n };");
        outLine("}");
        outLine("");
    }
    emitCHostBuiltinHelpers(calls);
    emitCSoftBuiltinHelpers(calls, config);
    emitCExtraCanvasHelpers(calls);
    emitCVmArenaHelpers(calls);
    if hasFunctions {
        if hasFnOutput { outLine("static int lt_io_status = 0;"); }
        emittedHoisted: mut Set<String>;
        var scanDepth := 0;
        var scanBlocks := 0;
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                scanDepth = scanDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                if scanDepth > 0 { scanDepth = scanDepth - 1; }
            } else if scanDepth == 0 {
                if item.kind == frontend.ITEM_KIND_SCOPE or item.kind == frontend.ITEM_KIND_IF or item.kind == frontend.ITEM_KIND_LOOP or item.kind == frontend.ITEM_KIND_LOOP_SEQ {
                    scanBlocks = scanBlocks + 1;
                } else if item.kind == frontend.ITEM_KIND_END_SCOPE or item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_LOOP {
                    if scanBlocks > 0 { scanBlocks = scanBlocks - 1; }
                } else if scanBlocks == 0 and isCLocalDeclKind(item.kind) and hoistedGlobals.has(item.runtime) and not emittedHoisted.has(item.runtime) {
                    mut emittedHoisted.add(item.runtime);
                    normInit := normalizeCBuiltinCalls(item.code);
                    if constHoistedGlobals.has(item.runtime) {
                        outLine("static const " + cDeclTypeItem(item) + item.runtime + " = " + normInit + ";");
                    } else {
                        outLine("static " + cDeclTypeItem(item) + item.runtime + ";");
                    }
                }
            }
        }
        loop reachable as item {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                outLine("static " + cScalarType(item.code) + " " + item.runtime + "(" + cParameterListWithRestrict(item.textValue, restrictFns.has(item.runtime)) + ");");
            }
        }
        loop hoistedFnDefs as hDef {
            outLine(normalizeCBuiltinCalls(injectCFnTemps(hDef)));
        }
        outLine("");
        var totalItems := 0;
        loop reachable { totalItems = totalItems + 1; }
        var fnIdx := 0;
        loop fnIdx < totalItems {
            if reachable[fnIdx].kind == frontend.ITEM_KIND_FUNCTION_START {
                /* Emit any immediately preceding top-level comments right above the C function definition. */
                var cScan := fnIdx - 1;
                loop cScan >= 0 and (reachable[cScan].kind == frontend.ITEM_KIND_COMMENT or reachable[cScan].kind == frontend.ITEM_KIND_SOURCE_LOC) {
                    cScan = cScan - 1;
                }
                var cEmit := cScan + 1;
                loop cEmit < fnIdx {
                    if reachable[cEmit].kind == frontend.ITEM_KIND_COMMENT {
                        emitCComment("", reachable[cEmit].code);
                    }
                    cEmit = cEmit + 1;
                }
                fnIdx = emitOneCFunction(reachable, fnIdx, totalItems, hoistedGlobals, constHoistedGlobals, restrictFns, restrictMutSliceFns);
            } else {
                fnIdx = fnIdx + 1;
            }
        }
    }
    mainItems: mut frontend.Items = [];
    if hasFunctions {
        var rTotal := 0;
        loop reachable { rTotal = rTotal + 1; }
        var mDepth := 0;
        var ri := 0;
        loop ri < rTotal {
            item := reachable[ri];
            if item.kind == frontend.ITEM_KIND_FUNCTION_START { mDepth = mDepth + 1; }
            else if item.kind == frontend.ITEM_KIND_FUNCTION_END { if mDepth > 0 { mDepth = mDepth - 1; } }
            else if mDepth == 0 {
                /* Skip comments attached directly to a top-level function definition (already emitted above it). */
                var attachedToFn := false;
                if item.kind == frontend.ITEM_KIND_COMMENT {
                    var look := ri + 1;
                    loop look < rTotal and (reachable[look].kind == frontend.ITEM_KIND_COMMENT or reachable[look].kind == frontend.ITEM_KIND_SOURCE_LOC) {
                        look = look + 1;
                    }
                    if look < rTotal and reachable[look].kind == frontend.ITEM_KIND_FUNCTION_START {
                        attachedToFn = true;
                    }
                }
                if not attachedToFn { mut mainItems.pushBack(item); }
            }
            ri = ri + 1;
        }
    } else {
        loop reachable as item { mut mainItems.pushBack(item); }
    }
    var hasMainOutput := false;
    loop mainItems as mOutScan {
        if mOutScan.kind == frontend.ITEM_KIND_END or mOutScan.kind == frontend.ITEM_KIND_END_OUTPUT {
            hasMainOutput = true;
            break;
        }
    }
    if hasMainArgs {
        outLine("int main(int argc, char **argv) {");
        outLine("    lt_argc = argc; lt_argv = argv;");
    } else {
        outLine("int main(void) {");
    }
    if hasMainOutput {
        outLine("    int status = 0;");
    }
    emptyScopeLists: Set<String>;
    emptyRestrictSliceParams: Set<String>;
    emitArithmeticTemporaries(mainItems);
    emitCItemStream(mainItems, hoistedGlobals, constHoistedGlobals, "", if hasMainOutput { "status = 1;" } else { "" }, emptyScopeLists, emptyRestrictSliceParams);
    if usesRuntimeCtx {
        outLine("    lt_ctx_shutdown();");
    }
    if hasMainOutput and hasFnOutput {
        outLine("    return status ? status : lt_io_status;");
    } else if hasMainOutput {
        outLine("    return status;");
    } else if hasFnOutput {
        outLine("    return lt_io_status;");
    } else {
        outLine("    return 0;");
    }
    outLine("}");
    cCompactEmit = prevCompact;
    cSourceMapMode = prevSourceMap;
}

/** Emits the C program to an explicit `io.Writer` driven by composable `OptConfig`. */
pub emitProgramToWithConfig := fn(writer: io.Writer, items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, config: optCfg.OptConfig): Unit {
    cOutUseWriter = true;
    mut cOutBuf.clear();
    emitProgramWithConfig(items, source, prefix, builtinSpecs, config);
    _res := writer.writeText(cOutBuf.build());
    mut cOutBuf.clear();
    cOutUseWriter = false;
};
