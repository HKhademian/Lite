    }
    if usesIntHelper(calls, "lite$ioReaderAtEof(") {
        outLine("static bool lt_io_reader_at_eof(" + shTag + " reader) {");
        outLine("    if (strcmp(lt_text_cstr(reader." + fKind + "), \"stdin\") == 0 && reader." + fHandle + " == 0) { return lt_stdin_eof; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    if (e != NULL && (e->kind == 1 || e->kind == 2)) { return e->eof; }");
