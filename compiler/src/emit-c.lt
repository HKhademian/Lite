    if usesIntHelper(calls, "lite$extraCanvasCapture(") {
        outLine("LT_INLINE uint32_t lt_png_crc(const uint8_t *buf, size_t len) { uint32_t c = 0xffffffffu; for (size_t i = 0; i < len; i += 1) { c ^= buf[i]; for (int k = 0; k < 8; k += 1) c = (c >> 1) ^ (0xedb88320u & (uint32_t)(-(int32_t)(c & 1u))); } return c ^ 0xffffffffu; }");
