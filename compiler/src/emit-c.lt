        outLine("        if (lt_stdin_eof) { return (" + lineTag + "){ true, LT_ASTR(\"\"), true, LT_ASTR(\"\") }; }");
        outLine("        fd = 0;");
        outLine("    } else {");
        outLine("        e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("        if (e == NULL) { return (" + lineTag + "){ false, LT_ASTR(\"\"), false, LT_ASTR(\"invalid reader handle\") }; }");
        outLine("        if (e->kind == 3) { return (" + lineTag + "){ false, LT_ASTR(\"\"), false, LT_ASTR(\"handle is a writer, not a reader\") }; }");
        outLine("        if (e->error[0] != '\\0') { return (" + lineTag + "){ false, LT_ASTR(\"\"), false, lt_text_from_cstr(e->error) }; }");
        outLine("        if (e->closed) { return (" + lineTag + "){ false, LT_ASTR(\"\"), false, LT_ASTR(\"reader is closed\") }; }");
        outLine("        if (e->eof) { return (" + lineTag + "){ true, LT_ASTR(\"\"), true, LT_ASTR(\"\") }; }");
        outLine("        if (e->kind == 2) {");
        outLine("            if (e->pos >= e->len) { e->eof = true; return (" + lineTag + "){ true, LT_ASTR(\"\"), true, LT_ASTR(\"\") }; }");
        outLine("            const uint8_t *start = e->buf + e->pos; size_t rem = (size_t)(e->len - e->pos);");
        outLine("            const uint8_t *nl = memchr(start, '\\n', rem);");
        outLine("            size_t line_len = nl != NULL ? (size_t)(nl - start) : rem;");
        outLine("            if (nl != NULL) { e->pos += (int64_t)line_len + 1; if (line_len > 0u && start[line_len - 1u] == '\\r') { line_len -= 1u; } }");
        outLine("            else { e->pos = e->len; e->eof = true; }");
        outLine("            if (line_len == 0u) { return (" + lineTag + "){ true, LT_ASTR(\"\"), false, LT_ASTR(\"\") }; }");
        outLine("            int32_t cp = 0; const char *uerr = \"\";");
        outLine("            if (!lt_c_utf8_validate_buf(start, line_len, &cp, &uerr)) { return (" + lineTag + "){ false, LT_ASTR(\"\"), false, lt_text_from_cstr(uerr) }; }");
        outLine("            char *out = malloc(line_len + 1u);");
        outLine("            if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate line\\n\"); exit(1); }");
        outLine("            memcpy(out, start, line_len); out[line_len] = '\\0';");
        outLine("            return (" + lineTag + "){ true, lt_text_from_buf(out, line_len, cp), false, LT_ASTR(\"\") };");
        outLine("        }");
        outLine("        fd = e->fd;");
        outLine("    }");
        outLine("    size_t cap = 128u; size_t len = 0u; bool got_nl = false;");
        outLine("    uint8_t *buf = malloc(cap + 1u);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate line\\n\"); exit(1); }");
        outLine("    for (;;) {");
        outLine("        uint8_t ch = 0u;");
        outLine("        ssize_t n = read(fd, &ch, 1u);");
        outLine("        if (n < 0) { const char *msg = lt_dup_str(strerror(errno)); if (e != NULL) { e->error = msg; } else { lt_stdin_err = msg; } free(buf); return (" + lineTag + "){ false, LT_ASTR(\"\"), false, lt_text_from_cstr(msg) }; }");
        outLine("        if (n == 0) { if (e != NULL) { e->eof = true; } else { lt_stdin_eof = true; } break; }");
        outLine("        if (ch == (uint8_t)'\\n') { got_nl = true; if (len > 0u && buf[len - 1u] == (uint8_t)'\\r') { len -= 1u; } break; }");
        outLine("        if (len >= cap) { cap *= 2u; uint8_t *nb = realloc(buf, cap + 1u); if (nb == NULL) { free(buf); fprintf(stderr, \"MemoryFault: cannot grow line\\n\"); exit(1); } buf = nb; }");
        outLine("        buf[len++] = ch;");
        outLine("    }");
        outLine("    if (!got_nl && len == 0u) { free(buf); return (" + lineTag + "){ true, LT_ASTR(\"\"), true, LT_ASTR(\"\") }; }");
        outLine("    if (len == 0u) { free(buf); return (" + lineTag + "){ true, LT_ASTR(\"\"), false, LT_ASTR(\"\") }; }");
        outLine("    int32_t cp = 0; const char *uerr = \"\";");
        outLine("    if (!lt_c_utf8_validate_buf(buf, len, &cp, &uerr)) { free(buf); return (" + lineTag + "){ false, LT_ASTR(\"\"), false, lt_text_from_cstr(uerr) }; }");
        outLine("    buf[len] = 0u;");
        outLine("    return (" + lineTag + "){ true, lt_text_from_buf((const char *)buf, len, cp), false, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_io_write_text(") or usesIntHelper(calls, "lt_c_io_write_line(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_io_write_str_raw(" + shTag + " writer, lt_str text, bool add_nl) {");
        outLine("    int target_fd = -1; lt_stream_entry *e = NULL;");
        outLine("    if (strcmp(lt_text_cstr(writer." + fKind + "), \"stdout\") == 0 && writer." + fHandle + " == 1) { target_fd = 1; }");
        outLine("    else if (strcmp(lt_text_cstr(writer." + fKind + "), \"stderr\") == 0 && writer." + fHandle + " == 2) { target_fd = 2; }");
        outLine("    else {");
        outLine("        e = lt_lookup_stream(writer." + fHandle + ");");
        outLine("        if (e == NULL) { return (" + okErrTag + "){ false, LT_ASTR(\"invalid writer handle\") }; }");
        outLine("        if (e->kind == 4) { return (" + okErrTag + "){ false, lt_text_from_cstr(e->error) }; }");
        outLine("        if (e->kind == 2) { return (" + okErrTag + "){ false, LT_ASTR(\"handle is a reader, not a writer\") }; }");
        outLine("        if (e->closed) { return (" + okErrTag + "){ false, LT_ASTR(\"writer is closed\") }; }");
        outLine("        if (e->error[0] != '\\0') { return (" + okErrTag + "){ false, lt_text_from_cstr(e->error) }; }");
        outLine("        if (e->kind == 3) {");
        outLine("            size_t tlen = lt_str_byte_len(text); const char *td = lt_str_data(&text);");
        outLine("            size_t add_len = tlen + (add_nl ? 1u : 0u);");
        outLine("            if (add_len > 0u) {");
        outLine("                if (e->len + (int64_t)add_len > e->cap) {");
        outLine("                    int64_t ncap = e->cap == 0 ? 64 : e->cap * 2;");
        outLine("                    while (ncap < e->len + (int64_t)add_len) { ncap *= 2; }");
        outLine("                    e->buf = realloc(e->buf, (size_t)ncap);");
        outLine("                    if (e->buf == NULL) { fprintf(stderr, \"MemoryFault: cannot grow buffer writer\\n\"); exit(1); }");
        outLine("                    e->cap = ncap;");
        outLine("                }");
        outLine("                if (tlen > 0u) { memcpy(e->buf + e->len, td, tlen); e->len += (int64_t)tlen; }");
        outLine("                if (add_nl) { e->buf[e->len++] = (uint8_t)'\\n'; }");
        outLine("            }");
        outLine("            return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("        }");
        outLine("        target_fd = e->fd;");
        outLine("    }");
        outLine("    size_t len = lt_str_byte_len(text); size_t off = 0u; const char *td = lt_str_data(&text);");
        outLine("    while (off < len) {");
        outLine("        ssize_t n = write(target_fd, td + off, len - off);");
        outLine("        if (n < 0) { const char *msg = lt_dup_str(strerror(errno)); if (e != NULL) { e->error = msg; } return (" + okErrTag + "){ false, lt_text_from_cstr(msg) }; }");
        outLine("        off += (size_t)n;");
        outLine("    }");
        outLine("    if (add_nl) {");
        outLine("        uint8_t nl = (uint8_t)'\\n';");
        outLine("        ssize_t n = write(target_fd, &nl, 1u);");
        outLine("        if (n < 0) { const char *msg = lt_dup_str(strerror(errno)); if (e != NULL) { e->error = msg; } return (" + okErrTag + "){ false, lt_text_from_cstr(msg) }; }");
        outLine("    }");
        outLine("    return (" + okErrTag + "){ true, LT_ASTR(\"\") };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_io_write_text(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_io_write_text(" + shTag + " writer, lt_str text) { return lt_c_io_write_str_raw(writer, text, false); }");
    }
    if usesIntHelper(calls, "lt_c_io_write_line(") {
        okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
        outLine("static " + okErrTag + " lt_c_io_write_line(" + shTag + " writer, lt_str text) { return lt_c_io_write_str_raw(writer, text, true); }");
    }
    if usesIntHelper(calls, "lt_c_u64_add_carry(") {
        acTag := frontend.cStructTag("(sum:UInt64,carry:Bool)");
        fSum := frontend.cFieldName("sum");
        fCarry := frontend.cFieldName("carry");
        outLine("LT_INLINE " + acTag + " lt_c_u64_add_carry(uint64_t a, uint64_t b, bool carry) {");
        outLine("    uint64_t s1 = a + b;");
        outLine("    bool c1 = s1 < a;");
        outLine("    uint64_t s2 = s1 + (carry ? UINT64_C(1) : UINT64_C(0));");
        outLine("    bool c2 = s2 < s1;");
        outLine("    return (" + acTag + "){ ." + fSum + " = s2, ." + fCarry + " = c1 || c2 };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_u64_sub_borrow(") {
        sbTag := frontend.cStructTag("(diff:UInt64,borrow:Bool)");
        fDiff := frontend.cFieldName("diff");
        fBorrow := frontend.cFieldName("borrow");
        outLine("LT_INLINE " + sbTag + " lt_c_u64_sub_borrow(uint64_t a, uint64_t b, bool borrow) {");
        outLine("    uint64_t d1 = a - b;");
        outLine("    bool b1 = a < b;");
        outLine("    uint64_t bi = borrow ? UINT64_C(1) : UINT64_C(0);");
        outLine("    uint64_t d2 = d1 - bi;");
        outLine("    bool b2 = d1 < bi;");
        outLine("    return (" + sbTag + "){ ." + fDiff + " = d2, ." + fBorrow + " = b1 || b2 };");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_c_list_fill_bytes(") or usesIntHelper(calls, "lt_c_list_copy_bytes(") or usesIntHelper(calls, "lt_c_list_index_of_byte(") {
        u8ListType := cScalarType("List<UInt8>");
        if usesIntHelper(calls, "lt_c_list_fill_bytes(") {
            outLine("static void lt_c_list_fill_bytes(" + u8ListType + " *dst, int64_t offset, int64_t length, uint8_t value) {");
            if config.checkBounds {
                outLine("    int64_t n = " + u8ListType + "_len(*dst);");
                outLine("    if (LT_UNLIKELY(offset < 0 || length < 0 || length > n || offset > n - length)) { lt_bound_fault(0u, \"fillBytes range out of bounds\"); }");
            }
            outLine("    if (length > 0) { memset(dst->data + offset, (int)value, (size_t)length); }");
            outLine("}");
        }
        if usesIntHelper(calls, "lt_c_list_copy_bytes(") {
            outLine("static void lt_c_list_copy_bytes(" + u8ListType + " *dst, int64_t dst_off, " + u8ListType + " src, int64_t src_off, int64_t length) {");
            if config.checkBounds {
                outLine("    int64_t dn = " + u8ListType + "_len(*dst);");
                outLine("    int64_t sn = " + u8ListType + "_len(src);");
                outLine("    if (LT_UNLIKELY(dst_off < 0 || src_off < 0 || length < 0 || length > dn || dst_off > dn - length || length > sn || src_off > sn - length)) { lt_bound_fault(0u, \"copyBytes range out of bounds\"); }");
            }
            outLine("    if (length > 0) { memmove(dst->data + dst_off, src.data + src_off, (size_t)length); }");
            outLine("}");
        }
        if usesIntHelper(calls, "lt_c_list_index_of_byte(") {
            outLine("static int64_t lt_c_list_index_of_byte(" + u8ListType + " values, uint8_t needle, int64_t start) {");
            outLine("    int64_t n = " + u8ListType + "_len(values);");
            outLine("    int64_t s = start < 0 ? 0 : start;");
            outLine("    if (s >= n) { return -1; }");
            outLine("    const void *p = memchr(values.data + s, (int)needle, (size_t)(n - s));");
            outLine("    return p == NULL ? -1 : (int64_t)((const uint8_t *)p - values.data);");
            outLine("}");
        }
    }
};

/** True when any emitted item calls a `ds/arena` virtual-memory arena builtin. */
usesVmArenaBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$vmArenaCreate(") or usesIntHelper(calls, "lite$vmArenaWriteByte(") or
    usesIntHelper(calls, "lite$vmArenaReadByte(") or usesIntHelper(calls, "lite$vmArenaWriteInt32(") or
    usesIntHelper(calls, "lite$vmArenaReadInt32(") or usesIntHelper(calls, "lite$vmArenaReset(") or
    usesIntHelper(calls, "lite$vmArenaDestroy(")
};

/** Emits C11 `lt_vm_arena`-backed user `VmArena` slot helpers for demand-paged bump arenas. */
emitCVmArenaHelpers := fn(calls: Set<String>): Unit {
    if not usesVmArenaBuiltins(calls) { return; }
    outLine("typedef struct { lt_vm_arena arena; uint8_t *base; size_t cap; bool active; } lt_vm_user_slot;");
    outLine("static lt_vm_user_slot lt_vm_user_slots[256];");
    outLine("LT_INLINE lt_vm_user_slot *lt_vm_user_lookup(int64_t handle) {");
    outLine("    if (handle < 1 || handle > 256) { return NULL; }");
    outLine("    lt_vm_user_slot *s = &lt_vm_user_slots[handle - 1];");
    outLine("    return (s->active && s->base != NULL) ? s : NULL;");
    outLine("}");
    outLine("static int64_t lt_vm_user_create(int64_t cap_bytes) {");
    outLine("    if (cap_bytes <= 0) { return 0; }");
    outLine("    for (int i = 0; i < 256; i += 1) {");
    outLine("        if (!lt_vm_user_slots[i].active) {");
    outLine("            lt_vm_user_slot *s = &lt_vm_user_slots[i];");
    outLine("            memset(&s->arena, 0, sizeof(s->arena));");
    outLine("            s->cap = (size_t)cap_bytes;");
    outLine("            s->base = (uint8_t *)lt_vm_arena_alloc(&s->arena, 8u, s->cap);");
    outLine("#if defined(LITE_ALLOC_SYSTEM)");
    outLine("            memset(s->base, 0, s->cap);");
    outLine("#endif");
    outLine("            s->active = true;");
    outLine("            return (int64_t)(i + 1);");
    outLine("        }");
    outLine("    }");
    outLine("    return 0;");
    outLine("}");
    if usesIntHelper(calls, "lite$vmArenaWriteByte(") {
        outLine("LT_INLINE bool lt_vm_user_write_byte(int64_t handle, int64_t offset, int64_t value) {");
        outLine("    lt_vm_user_slot *s = lt_vm_user_lookup(handle);");
        outLine("    if (s == NULL || offset < 0 || (size_t)offset >= s->cap || value < 0 || value > 255) { return false; }");
        outLine("    s->base[(size_t)offset] = (uint8_t)value;");
        outLine("    return true;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$vmArenaReadByte(") {
        outLine("LT_INLINE int64_t lt_vm_user_read_byte(int64_t handle, int64_t offset) {");
        outLine("    lt_vm_user_slot *s = lt_vm_user_lookup(handle);");
        outLine("    if (s == NULL || offset < 0 || (size_t)offset >= s->cap) { return -1; }");
        outLine("    return (int64_t)s->base[(size_t)offset];");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$vmArenaWriteInt32(") {
        outLine("LT_INLINE bool lt_vm_user_write_i32(int64_t handle, int64_t offset, int64_t value) {");
        outLine("    lt_vm_user_slot *s = lt_vm_user_lookup(handle);");
        outLine("    if (s == NULL || offset < 0 || (size_t)offset > s->cap - 4u || s->cap < 4u || value < -2147483648LL || value > 2147483647LL) { return false; }");
        outLine("    uint32_t u = (uint32_t)(int32_t)value;");
        outLine("    uint8_t *p = s->base + (size_t)offset;");
        outLine("    p[0] = (uint8_t)(u & 0xFFu); p[1] = (uint8_t)((u >> 8) & 0xFFu);");
        outLine("    p[2] = (uint8_t)((u >> 16) & 0xFFu); p[3] = (uint8_t)((u >> 24) & 0xFFu);");
        outLine("    return true;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$vmArenaReadInt32(") {
        outLine("LT_INLINE int64_t lt_vm_user_read_i32(int64_t handle, int64_t offset) {");
        outLine("    lt_vm_user_slot *s = lt_vm_user_lookup(handle);");
        outLine("    if (s == NULL || offset < 0 || s->cap < 4u || (size_t)offset > s->cap - 4u) { return 0; }");
        outLine("    const uint8_t *p = s->base + (size_t)offset;");
        outLine("    uint32_t u = (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);");
        outLine("    return (int64_t)(int32_t)u;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$vmArenaReset(") {
        outLine("LT_INLINE void lt_vm_user_reset(int64_t handle) { (void)handle; }");
    }
    if usesIntHelper(calls, "lite$vmArenaDestroy(") {
        outLine("LT_INLINE void lt_vm_user_destroy(int64_t handle) {");
        outLine("    lt_vm_user_slot *s = lt_vm_user_lookup(handle);");
        outLine("    if (s == NULL) { return; }");
        outLine("    lt_vm_arena_destroy(&s->arena);");
        outLine("    s->base = NULL; s->cap = 0u; s->active = false;");
        outLine("}");
    }
};

/** True when any emitted item calls an `extra/canvas` surface or drawing builtin. */
usesExtraCanvasBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$extraCanvasOpen(") or usesIntHelper(calls, "lite$extraCanvasPoll(") or
    usesIntHelper(calls, "lite$extraCanvasPresent(") or usesIntHelper(calls, "lite$extraCanvasClose(") or
    usesIntHelper(calls, "lite$extraCanvasClear(") or usesIntHelper(calls, "lite$extraCanvasFillRect(") or
    usesIntHelper(calls, "lite$extraCanvasStrokeRect(") or usesIntHelper(calls, "lite$extraCanvasFillCircle(") or
    usesIntHelper(calls, "lite$extraCanvasStrokeLine(") or usesIntHelper(calls, "lite$extraCanvasDrawText(") or
    usesIntHelper(calls, "lite$extraCanvasCapture(") or usesIntHelper(calls, "lite$extraCanvasSetTargetFps(") or
    usesIntHelper(calls, "lite$extraCanvasVitals(") or usesIntHelper(calls, "lite$extraCanvasPlayTone(") or
    usesIntHelper(calls, "lite$extraCanvasBounds(") or usesIntHelper(calls, "lite$extraCanvasResize(") or
    usesIntHelper(calls, "lite$extraCanvasSetFullscreen(") or usesIntHelper(calls, "lite$extraCanvasRun(") or
    usesIntHelper(calls, "lite$extraCanvasIsKeyDown(") or usesIntHelper(calls, "lite$extraCanvasIsKeyPressed(") or
    usesIntHelper(calls, "lite$extraCanvasIsKeyReleased(") or usesIntHelper(calls, "lite$extraCanvasIsPointerPressed(") or
    usesIntHelper(calls, "lite$extraCanvasIsPointerReleased(") or usesIntHelper(calls, "lite$extraCanvasWheelDelta(") or
    usesIntHelper(calls, "lite$extraCanvasSetClipRect(") or usesIntHelper(calls, "lite$extraCanvasClearClipRect(") or
    usesIntHelper(calls, "lite$extraCanvasFillTriangle(") or usesIntHelper(calls, "lite$extraCanvasCreateTexture(") or
    usesIntHelper(calls, "lite$extraCanvasSetTexturePixel(") or usesIntHelper(calls, "lite$extraCanvasBlit(") or
    usesIntHelper(calls, "lite$extraCanvasBlitScaled(") or usesIntHelper(calls, "lite$extraCanvasDestroyTexture(") or
    usesIntHelper(calls, "lite$extraCanvasScratchMark(") or usesIntHelper(calls, "lite$extraCanvasScratchRewind(")
};

/** Emits the self-contained C11 `extra/canvas` runtime (native macOS AppKit/CoreGraphics window + headless RGBA framebuffer + PNG encoder + vitals). */
emitCExtraCanvasHelpers := fn(calls: Set<String>): Unit {
    if not usesExtraCanvasBuiltins(calls) { return; }
    surfTag := frontend.cStructTag("(handle:Int)");
    texTag := frontend.cStructTag("(handle:Int,width:Int,height:Int)");
    colTag := frontend.cStructTag("(r:Float,g:Float,b:Float,a:Float)");
    ptTag := frontend.cStructTag("(x:Float,y:Float)");
    rcTag := frontend.cStructTag("(x:Float,y:Float,width:Float,height:Float)");
    inpTag := frontend.cStructTag("(open:Bool,width:Int,height:Int,pointerX:Float,pointerY:Float,pointerDown:Bool,key:String,deltaMs:Int)");
    vitTag := frontend.cStructTag("(frameCount:Int,frameTimeMs:Float,avgFrameTimeMs:Float,fps:Float,targetFps:Float,cpuTimeMs:Float,memoryBytes:Int,heapAllocs:Int,liveBytes:Int,tempPeakBytes:Int)");
    bndTag := frontend.cStructTag("(x:Int,y:Int,width:Int,height:Int,fullscreen:Bool)");
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    outLine("typedef struct { int w; int h; int x; int y; bool fullscreen; uint8_t *pixels; size_t pixels_bytes; bool has_clip; int clip_x0; int clip_y0; int clip_x1; int clip_y1; bool open; double px; double py; bool pdown; bool prev_pdown; bool ppressed; bool preleased; double wheel_y; double pending_wheel_y; char key[16]; char key_out[16]; char keys_down[32][16]; int keys_down_n; char keys_prev[32][16]; int keys_prev_n; char keys_pressed[32][16]; int keys_pressed_n; char keys_released[32][16]; int keys_released_n; int64_t last_ms; int64_t frame_start_ns; int64_t frame_count; double target_fps; double last_frame_ms; double avg_frame_ms; int64_t auto_frame_mark; bool headless; void *win; void *view; } lt_canvas_state;");
    outLine("static lt_canvas_state lt_canvas_slots[16];");
    outLine("typedef struct { int w; int h; uint8_t *pixels; size_t pixels_bytes; } lt_texture_state;");
    outLine("static lt_texture_state lt_texture_slots[256];");
    outLine("LT_INLINE int64_t lt_canvas_now_ns(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec; }");
    outLine("LT_INLINE int64_t lt_canvas_now_ms(void) { return lt_canvas_now_ns() / 1000000LL; }");
    outLine("LT_INLINE uint8_t lt_canvas_u8(double v) { if (!(v > 0.0)) return 0; if (v >= 1.0) return 255; return (uint8_t)(v * 255.0 + 0.5); }");
    outLine("LT_INLINE void lt_canvas_blend(lt_canvas_state *s, int x, int y, uint8_t r, uint8_t g, uint8_t b, uint8_t a) {");
    outLine("    if (x < 0 || y < 0 || x >= s->w || y >= s->h || a == 0) return;");
    outLine("    if (s->has_clip && (x < s->clip_x0 || y < s->clip_y0 || x >= s->clip_x1 || y >= s->clip_y1)) return;");
    outLine("    uint8_t *p = s->pixels + ((size_t)y * (size_t)s->w + (size_t)x) * 4u;");
    outLine("    if (a == 255) { p[0] = r; p[1] = g; p[2] = b; p[3] = 255; return; }");
    outLine("    unsigned inv = 255u - (unsigned)a;");
    outLine("    p[0] = (uint8_t)(((unsigned)r * a + (unsigned)p[0] * inv + 127u) >> 8);");
    outLine("    p[1] = (uint8_t)(((unsigned)g * a + (unsigned)p[1] * inv + 127u) >> 8);");
    outLine("    p[2] = (uint8_t)(((unsigned)b * a + (unsigned)p[2] * inv + 127u) >> 8);");
    outLine("    unsigned oa = (unsigned)a + (((unsigned)p[3] * inv + 127u) >> 8);");
    outLine("    p[3] = (uint8_t)(oa > 255u ? 255u : oa);");
    outLine("}");
    outLine("LT_INLINE lt_canvas_state *lt_canvas_get(int64_t h) { if (h < 1 || h > 16) return NULL; lt_canvas_state *s = &lt_canvas_slots[h - 1]; return s->pixels ? s : NULL; }");
    outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
    outLine("extern void *objc_autoreleasePoolPush(void);");
    outLine("extern void objc_autoreleasePoolPop(void *pool);");
    outLine("static bool lt_cocoa_ready = false;");
    outLine("static id lt_cocoa_mode = NULL;");
    outLine("LT_INLINE void lt_cocoa_init(void) {");
    outLine("    if (lt_cocoa_ready) return; lt_cocoa_ready = true;");
    outLine("    void *pool = objc_autoreleasePoolPush();");
    outLine("    id app = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(\"NSApplication\"), sel_registerName(\"sharedApplication\"));");
    outLine("    ((signed char (*)(id, SEL, int64_t))objc_msgSend)(app, sel_registerName(\"setActivationPolicy:\"), 0);");
    outLine("    ((void (*)(id, SEL))objc_msgSend)(app, sel_registerName(\"finishLaunching\"));");
    outLine("    id m = ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass(\"NSString\"), sel_registerName(\"stringWithUTF8String:\"), \"kCFRunLoopDefaultMode\");");
    outLine("    lt_cocoa_mode = ((id (*)(id, SEL))objc_msgSend)(m, sel_registerName(\"retain\"));");
    outLine("    objc_autoreleasePoolPop(pool);");
    outLine("}");
    outLine("#endif");
    outLine("LT_INLINE void lt_canvas_realloc_buf(lt_canvas_state *s, int nw, int nh) {");
    outLine("    if (nw < 1) nw = 1; if (nh < 1) nh = 1;");
    outLine("    if (nw == s->w && nh == s->h) return;");
    outLine("    size_t nbytes = (size_t)nw * (size_t)nh * 4u;");
    outLine("    uint8_t *nb = calloc(nbytes, 1u);");
    outLine("    if (!nb) return;");
    outLine("    lt_tl_ctx.heap_allocs += 1;");
    outLine("    if (s->pixels != NULL) {");
    outLine("        int cw = s->w < nw ? s->w : nw; int ch = s->h < nh ? s->h : nh;");
    outLine("        for (int row = 0; row < ch; row += 1) memcpy(nb + (size_t)row * (size_t)nw * 4u, s->pixels + (size_t)row * (size_t)s->w * 4u, (size_t)cw * 4u);");
    outLine("        free(s->pixels);");
    outLine("        lt_tl_ctx.live_bytes -= (int64_t)s->pixels_bytes;");
    outLine("    }");
    outLine("    s->pixels = nb; s->pixels_bytes = nbytes; s->w = nw; s->h = nh; s->has_clip = false;");
    outLine("    lt_tl_ctx.live_bytes += (int64_t)nbytes;");
    outLine("}");
    outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
    outLine("LT_INLINE CGRect lt_objc_rect(id obj, SEL sel) {");
    outLine("#if defined(__x86_64__)");
    outLine("    CGRect r; ((void (*)(CGRect *, id, SEL))objc_msgSend_stret)(&r, obj, sel); return r;");
    outLine("#else");
    outLine("    return ((CGRect (*)(id, SEL))objc_msgSend)(obj, sel);");
    outLine("#endif");
    outLine("}");
    outLine("LT_INLINE void lt_canvas_sync_bounds(lt_canvas_state *s) {");
    outLine("    if (!s || s->headless || s->win == NULL || s->view == NULL) return;");
    outLine("    CGRect wf = lt_objc_rect((id)s->win, sel_registerName(\"frame\"));");
    outLine("    s->x = (int)wf.origin.x; s->y = (int)wf.origin.y;");
    outLine("    unsigned long mask = ((unsigned long (*)(id, SEL))objc_msgSend)((id)s->win, sel_registerName(\"styleMask\"));");
    outLine("    s->fullscreen = ((mask & (1ul << 14)) != 0ul);");
    outLine("    CGRect vb = lt_objc_rect((id)s->view, sel_registerName(\"bounds\"));");
    outLine("    int nw = (int)(vb.size.width + 0.5); int nh = (int)(vb.size.height + 0.5);");
    outLine("    if (nw > 0 && nh > 0 && (nw != s->w || nh != s->h)) lt_canvas_realloc_buf(s, nw, nh);");
    outLine("}");
    outLine("#else");
    outLine("LT_INLINE void lt_canvas_sync_bounds(lt_canvas_state *s) { (void)s; }");
    outLine("#endif");
    outLine("LT_INLINE " + surfTag + " lt_canvas_open(lt_str title_s, int64_t width, int64_t height) {");
    outLine("    const char *title = lt_str_byte_len(title_s) > 0u ? lt_str_data(&title_s) : NULL;");
    outLine("    int w = width > 0 ? (int)width : 1; int h = height > 0 ? (int)height : 1;");
    outLine("    int slot = -1; for (int i = 0; i < 16; i += 1) { if (lt_canvas_slots[i].pixels == NULL) { slot = i; break; } }");
    outLine("    if (slot < 0) return (" + surfTag + "){ .f_handle = 0 };");
    outLine("    lt_canvas_state *s = &lt_canvas_slots[slot]; memset(s, 0, sizeof(*s));");
    outLine("    s->w = w; s->h = h; s->x = 120; s->y = 120; s->fullscreen = false; s->open = true; s->last_ms = lt_canvas_now_ms(); s->frame_start_ns = lt_canvas_now_ns(); s->target_fps = 60.0;");
    outLine("    s->pixels_bytes = (size_t)w * (size_t)h * 4u;");
    outLine("    s->pixels = calloc(s->pixels_bytes, 1u);");
    outLine("    if (s->pixels != NULL) { lt_tl_ctx.heap_allocs += 1; lt_tl_ctx.live_bytes += (int64_t)s->pixels_bytes; }");
    outLine("    const char *hl = getenv(\"LITE_CANVAS_HEADLESS\");");
    outLine("    s->headless = (hl != NULL && strcmp(hl, \"1\") == 0);");
    outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
    outLine("    if (!s->headless) {");
    outLine("        lt_cocoa_init();");
    outLine("        CGRect frame = CGRectMake(120.0, 120.0, (double)w, (double)h);");
    outLine("        id win = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(\"NSWindow\"), sel_registerName(\"alloc\"));");
    outLine("        win = ((id (*)(id, SEL, CGRect, unsigned long, unsigned long, signed char))objc_msgSend)(win, sel_registerName(\"initWithContentRect:styleMask:backing:defer:\"), frame, 15ul, 2ul, 0);");
    outLine("        ((void (*)(id, SEL, unsigned long))objc_msgSend)(win, sel_registerName(\"setCollectionBehavior:\"), 1ul << 7);");
    outLine("        id nsTitle = ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass(\"NSString\"), sel_registerName(\"stringWithUTF8String:\"), title ? title : \"Lite Canvas\");");
    outLine("        ((void (*)(id, SEL, id))objc_msgSend)(win, sel_registerName(\"setTitle:\"), nsTitle);");
    outLine("        id cv = ((id (*)(id, SEL))objc_msgSend)(win, sel_registerName(\"contentView\"));");
    outLine("        ((void (*)(id, SEL, signed char))objc_msgSend)(cv, sel_registerName(\"setWantsLayer:\"), 1);");
    outLine("        ((void (*)(id, SEL, id))objc_msgSend)(win, sel_registerName(\"makeKeyAndOrderFront:\"), NULL);");
    outLine("        id app = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(\"NSApplication\"), sel_registerName(\"sharedApplication\"));");
    outLine("        ((void (*)(id, SEL, signed char))objc_msgSend)(app, sel_registerName(\"activateIgnoringOtherApps:\"), 1);");
    outLine("        s->win = (void *)win; s->view = (void *)cv;");
    outLine("    }");
    outLine("#else");
    outLine("    (void)title;");
    outLine("#endif");
    outLine("    return (" + surfTag + "){ .f_handle = (int64_t)(slot + 1) };");
    outLine("}");
    outLine("LT_INLINE void lt_key_copy(char dst[16], const char *src) {");
    outLine("    size_t i = 0u;");
    outLine("    if (src != NULL) { while (i < 15u && src[i] != '\\0') { dst[i] = src[i]; i += 1u; } }");
    outLine("    dst[i] = '\\0';");
    outLine("}");
    outLine("LT_INLINE bool lt_keyset_has(const char list[32][16], int count, const char *k) {");
    outLine("    if (k == NULL || k[0] == '\\0') return false;");
    outLine("    for (int i = 0; i < count; i += 1) { if (strcmp(list[i], k) == 0) return true; }");
    outLine("    return false;");
    outLine("}");
    outLine("LT_INLINE void lt_keyset_add(char list[32][16], int *count, const char *k) {");
    outLine("    if (k == NULL || k[0] == '\\0' || lt_keyset_has(list, *count, k) || *count >= 32) return;");
    outLine("    lt_key_copy(list[*count], k); *count += 1;");
    outLine("}");
    outLine("LT_INLINE void lt_keyset_remove(char list[32][16], int *count, const char *k) {");
    outLine("    if (k == NULL || k[0] == '\\0') return;");
    outLine("    for (int i = 0; i < *count; i += 1) {");
    outLine("        if (strcmp(list[i], k) == 0) { if (i != *count - 1) memcpy(list[i], list[*count - 1], 16u); *count -= 1; return; }");
    outLine("    }");
    outLine("}");
    outLine("LT_INLINE void lt_map_cocoa_key(const char *u, char out[16]) {");
    outLine("    if (!u || u[0] == '\\0') { out[0] = '\\0'; return; }");
    outLine("    if (u[0] == 27) lt_key_copy(out, \"Escape\");");
    outLine("    else if (u[0] == '\\r' || u[0] == '\\n') lt_key_copy(out, \"Enter\");");
    outLine("    else if (u[0] == 127 || u[0] == 8) lt_key_copy(out, \"Backspace\");");
    outLine("    else if ((unsigned char)u[0] == 0xEF && (unsigned char)u[1] == 0x9C && (unsigned char)u[2] == 0x80) lt_key_copy(out, \"ArrowUp\");");
    outLine("    else if ((unsigned char)u[0] == 0xEF && (unsigned char)u[1] == 0x9C && (unsigned char)u[2] == 0x81) lt_key_copy(out, \"ArrowDown\");");
    outLine("    else if ((unsigned char)u[0] == 0xEF && (unsigned char)u[1] == 0x9C && (unsigned char)u[2] == 0x82) lt_key_copy(out, \"ArrowLeft\");");
    outLine("    else if ((unsigned char)u[0] == 0xEF && (unsigned char)u[1] == 0x9C && (unsigned char)u[2] == 0x83) lt_key_copy(out, \"ArrowRight\");");
    outLine("    else if ((unsigned char)u[0] == 0xEF && (unsigned char)u[1] == 0x9C && (unsigned char)u[2] >= 0x84 && (unsigned char)u[2] <= 0x8F) snprintf(out, 16, \"F%d\", (int)((unsigned char)u[2] - 0x83));");
    outLine("    else lt_key_copy(out, u);");
    outLine("}");
    outLine("LT_INLINE " + inpTag + " lt_canvas_poll(" + surfTag + " surf) {");
    outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle);");
    outLine("    if (!s) return (" + inpTag + "){ .f_open = false, .f_width = 0, .f_height = 0, .f_pointerX = 0.0, .f_pointerY = 0.0, .f_pointerDown = false, .f_key = LT_ASTR(\"\"), .f_deltaMs = 0 };");
    outLine("    s->key[0] = '\\0';");
    outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
    outLine("    if (!s->headless && s->win != NULL) {");
    outLine("        void *pool = objc_autoreleasePoolPush();");
    outLine("        id app = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(\"NSApplication\"), sel_registerName(\"sharedApplication\"));");
    outLine("        for (;;) {");
    outLine("            id ev = ((id (*)(id, SEL, unsigned long, id, id, signed char))objc_msgSend)(app, sel_registerName(\"nextEventMatchingMask:untilDate:inMode:dequeue:\"), ~0ul, NULL, lt_cocoa_mode, 1);");
    outLine("            if (ev == NULL) break;");
    outLine("            unsigned long et = ((unsigned long (*)(id, SEL))objc_msgSend)(ev, sel_registerName(\"type\"));");
    outLine("            if (et == 1ul) s->pdown = true;");
    outLine("            else if (et == 2ul) s->pdown = false;");
    outLine("            else if (et == 22ul) { s->pending_wheel_y += ((double (*)(id, SEL))objc_msgSend)(ev, sel_registerName(\"scrollingDeltaY\")); }");
    outLine("            else if (et == 10ul || et == 11ul) {");
    outLine("                id chars = ((id (*)(id, SEL))objc_msgSend)(ev, sel_registerName(\"characters\"));");
    outLine("                const char *u = chars ? ((const char *(*)(id, SEL))objc_msgSend)(chars, sel_registerName(\"UTF8String\")) : \"\";");
    outLine("                char mapped[16]; lt_map_cocoa_key(u, mapped);");
    outLine("                if (et == 10ul) {");
    outLine("                    lt_key_copy(s->key, mapped); lt_keyset_add(s->keys_down, &s->keys_down_n, mapped);");
    outLine("                    unsigned long mods = ((unsigned long (*)(id, SEL))objc_msgSend)(ev, sel_registerName(\"modifierFlags\"));");
    outLine("                    if ((mods & (1ul << 20)) == 0ul) continue;");
    outLine("                } else {");
    outLine("                    lt_keyset_remove(s->keys_down, &s->keys_down_n, mapped);");
    outLine("                }");
    outLine("            }");
    outLine("            ((void (*)(id, SEL, id))objc_msgSend)(app, sel_registerName(\"sendEvent:\"), ev);");
    outLine("        }");
    outLine("        signed char vis = ((signed char (*)(id, SEL))objc_msgSend)((id)s->win, sel_registerName(\"isVisible\"));");
    outLine("        if (!vis) s->open = false;");
    outLine("        lt_canvas_sync_bounds(s);");
    outLine("        CGPoint pt = ((CGPoint (*)(id, SEL))objc_msgSend)((id)s->win, sel_registerName(\"mouseLocationOutsideOfEventStream\"));");
    outLine("        s->px = pt.x; s->py = (double)s->h - pt.y;");
    outLine("        objc_autoreleasePoolPop(pool);");
    outLine("    }");
    outLine("#endif");
    outLine("    int64_t now = lt_canvas_now_ms(); int64_t dt = now - s->last_ms; if (dt < 0) dt = 0; s->last_ms = now;");
    outLine("    s->keys_pressed_n = 0; s->keys_released_n = 0;");
    outLine("    for (int i = 0; i < s->keys_down_n; i += 1) { if (!lt_keyset_has(s->keys_prev, s->keys_prev_n, s->keys_down[i])) lt_keyset_add(s->keys_pressed, &s->keys_pressed_n, s->keys_down[i]); }");
    outLine("    if (s->key[0] != '\\0' && !lt_keyset_has(s->keys_prev, s->keys_prev_n, s->key)) lt_keyset_add(s->keys_pressed, &s->keys_pressed_n, s->key);");
    outLine("    for (int i = 0; i < s->keys_prev_n; i += 1) { if (!lt_keyset_has(s->keys_down, s->keys_down_n, s->keys_prev[i])) lt_keyset_add(s->keys_released, &s->keys_released_n, s->keys_prev[i]); }");
    outLine("    memcpy(s->keys_prev, s->keys_down, sizeof(s->keys_prev)); s->keys_prev_n = s->keys_down_n;");
    outLine("    s->ppressed = s->pdown && !s->prev_pdown; s->preleased = !s->pdown && s->prev_pdown; s->prev_pdown = s->pdown;");
    outLine("    s->wheel_y = s->pending_wheel_y; s->pending_wheel_y = 0.0;");
    outLine("    if (!lt_tl_ctx.in_frame && lt_tl_ctx.temp.mark_n == 0 && s->auto_frame_mark == 0) { s->auto_frame_mark = lt_str_slab_mark(); }");
    outLine("    memcpy(s->key_out, s->key, 16);");
    outLine("    size_t klen = s->key_out[0] ? strlen(s->key_out) : 0u;");
    outLine("    lt_str ks = klen > 0u ? lt_str_make(s->key_out, klen, (int64_t)klen) : LT_EMPTY_STR;");
    outLine("    return (" + inpTag + "){ .f_open = s->open, .f_width = s->w, .f_height = s->h, .f_pointerX = s->px, .f_pointerY = s->py, .f_pointerDown = s->pdown, .f_key = ks, .f_deltaMs = dt };");
    outLine("}");
    outLine("LT_INLINE void lt_canvas_present(" + surfTag + " surf) {");
    outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); if (!s) return;");
    outLine("#if defined(__APPLE__) && !defined(LITE_CANVAS_NO_GUI)");
    outLine("    if (!s->headless && s->view != NULL) {");
    outLine("        void *pool = objc_autoreleasePoolPush();");
    outLine("        CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();");
    outLine("        CGDataProviderRef prov = CGDataProviderCreateWithData(NULL, s->pixels, (size_t)s->w * (size_t)s->h * 4u, NULL);");
    outLine("        CGImageRef img = CGImageCreate((size_t)s->w, (size_t)s->h, 8, 32, (size_t)s->w * 4u, cs, kCGBitmapByteOrderDefault | kCGImageAlphaLast, prov, NULL, false, kCGRenderingIntentDefault);");
    outLine("        id layer = ((id (*)(id, SEL))objc_msgSend)((id)s->view, sel_registerName(\"layer\"));");
    outLine("        if (layer != NULL && img != NULL) { ((void (*)(id, SEL, id))objc_msgSend)(layer, sel_registerName(\"setContents:\"), (id)img); }");
    outLine("        if (img != NULL) CGImageRelease(img);");
    outLine("        CGDataProviderRelease(prov); CGColorSpaceRelease(cs);");
    outLine("        objc_autoreleasePoolPop(pool);");
    outLine("    }");
    outLine("#endif");
    outLine("    int64_t after_ns = lt_canvas_now_ns();");
    outLine("    if (!s->headless && s->target_fps > 0.0) {");
    outLine("        int64_t target_ns = (int64_t)(1000000000.0 / s->target_fps);");
    outLine("        int64_t rem_ns = target_ns - (after_ns - s->frame_start_ns);");
    outLine("        if (rem_ns > 200000LL) {");
    outLine("            struct timespec sl = { (time_t)(rem_ns / 1000000000LL), (long)(rem_ns % 1000000000LL) };");
    outLine("            nanosleep(&sl, NULL);");
    outLine("            after_ns = lt_canvas_now_ns();");
    outLine("        }");
    outLine("    }");
    outLine("    double fms = (double)(after_ns - s->frame_start_ns) / 1000000.0;");
    outLine("    if (fms < 0.0001) fms = 0.0001;");
    outLine("    s->frame_start_ns = after_ns;");
    outLine("    s->frame_count += 1;");
    outLine("    s->last_frame_ms = fms;");
    outLine("    s->avg_frame_ms = s->avg_frame_ms <= 0.0 ? fms : s->avg_frame_ms * 0.85 + fms * 0.15;");
    outLine("    if (s->auto_frame_mark > 0) { lt_str_slab_rewind(s->auto_frame_mark); s->auto_frame_mark = 0; }");
    outLine("}");
    if usesIntHelper(calls, "lite$extraCanvasSetTargetFps(") {
        outLine("LT_INLINE void lt_canvas_set_target_fps(" + surfTag + " surf, double fps) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle); if (!s) return;");
        outLine("    s->target_fps = fps > 0.0 ? fps : 0.0;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasVitals(") {
        outLine("LT_INLINE " + vitTag + " lt_canvas_vitals(" + surfTag + " surf) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle);");
        outLine("    struct rusage ru; memset(&ru, 0, sizeof(ru)); getrusage(RUSAGE_SELF, &ru);");
        outLine("    double cpu_ms = (double)ru.ru_utime.tv_sec * 1000.0 + (double)ru.ru_utime.tv_usec / 1000.0 + (double)ru.ru_stime.tv_sec * 1000.0 + (double)ru.ru_stime.tv_usec / 1000.0;");
        outLine("    int64_t rss = 0;");
        outLine("#if defined(__APPLE__)");
        outLine("    struct mach_task_basic_info mi; mach_msg_type_number_t mc = MACH_TASK_BASIC_INFO_COUNT;");
        outLine("    if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO, (task_info_t)&mi, &mc) == KERN_SUCCESS) rss = (int64_t)mi.resident_size;");
        outLine("    else rss = (int64_t)ru.ru_maxrss;");
        outLine("#else");
        outLine("    rss = (int64_t)ru.ru_maxrss * 1024LL;");
        outLine("#endif");
        outLine("    if (!s) return (" + vitTag + "){ .f_frameCount = 0, .f_frameTimeMs = 0.0, .f_avgFrameTimeMs = 0.0, .f_fps = 0.0, .f_targetFps = 0.0, .f_cpuTimeMs = cpu_ms, .f_memoryBytes = rss, .f_heapAllocs = lt_tl_ctx.heap_allocs, .f_liveBytes = lt_tl_ctx.live_bytes, .f_tempPeakBytes = (int64_t)lt_tl_ctx.temp.peak_bytes };");
        outLine("    double fps = s->avg_frame_ms > 0.0 ? 1000.0 / s->avg_frame_ms : 0.0;");
        outLine("    return (" + vitTag + "){ .f_frameCount = s->frame_count, .f_frameTimeMs = s->last_frame_ms, .f_avgFrameTimeMs = s->avg_frame_ms, .f_fps = fps, .f_targetFps = s->target_fps, .f_cpuTimeMs = cpu_ms, .f_memoryBytes = rss, .f_heapAllocs = lt_tl_ctx.heap_allocs, .f_liveBytes = lt_tl_ctx.live_bytes, .f_tempPeakBytes = (int64_t)lt_tl_ctx.temp.peak_bytes };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$extraCanvasBounds(") {
        outLine("LT_INLINE " + bndTag + " lt_canvas_bounds(" + surfTag + " surf) {");
        outLine("    lt_canvas_state *s = lt_canvas_get(surf.f_handle);");
        outLine("    if (!s) return (" + bndTag + "){ .f_x = 0, .f_y = 0, .f_width = 0, .f_height = 0, .f_fullscreen = false };");
        outLine("    lt_canvas_sync_bounds(s);");
