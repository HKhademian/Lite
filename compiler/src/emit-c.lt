    mut cBuiltinMap.set("extraCanvasBlit", "lt_canvas_blit");
    mut cBuiltinMap.set("extraCanvasBlitScaled", "lt_canvas_blit_scaled");
    mut cBuiltinMap.set("extraCanvasDestroyTexture", "lt_canvas_destroy_texture");
    mut cBuiltinMap.set("extraCanvasScratchMark", "lt_canvas_scratch_mark");
    mut cBuiltinMap.set("extraCanvasScratchRewind", "lt_canvas_scratch_rewind");
    mut cBuiltinMap.set("vmArenaCreate", "lt_vm_user_create");
    mut cBuiltinMap.set("vmArenaWriteByte", "lt_vm_user_write_byte");
    mut cBuiltinMap.set("vmArenaReadByte", "lt_vm_user_read_byte");
    mut cBuiltinMap.set("vmArenaWriteInt32", "lt_vm_user_write_i32");
    mut cBuiltinMap.set("vmArenaReadInt32", "lt_vm_user_read_i32");
    mut cBuiltinMap.set("vmArenaReset", "lt_vm_user_reset");
    mut cBuiltinMap.set("vmArenaDestroy", "lt_vm_user_destroy");
};

/** Rewrites registered `lite$...(` builtin calls via O(1) map lookup and strips internal `/*@T:...*/`/`/*@C:...*/`/`/*@P:...*/`/`/*@CFN_START:...*/` markers outside quoted strings. */
normalizeCBuiltinCalls := fn(code: String): String {
    var nextLite := code.indexOf("lite$", 0);
    var nextAnnot := code.indexOf("/*@", 0);
    if nextLite < 0 and nextAnnot < 0 { return code; }
    ensureCBuiltinMap();
    size := code.length();
    var nextQuote := code.indexOf("\"", 0);
    out: mut tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite$", cursor); }
        if nextAnnot >= 0 and nextAnnot < cursor { nextAnnot = code.indexOf("/*@", cursor); }
        var hit := -1;
        if nextLite >= 0 { hit = nextLite; }
        if nextAnnot >= 0 and (hit < 0 or nextAnnot < hit) { hit = nextAnnot; }
        if hit < 0 { break; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = frontend.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit == nextAnnot {
            if code.startsWithAt(hit, "/*@CFN_START:") {
                if hit > flushed { mut out.append(code.slice(flushed, hit)); }
                cursor = skipCFnBlock(code, hit);
                flushed = cursor;
            } else if code.startsWithAt(hit, "/*@T:") or code.startsWithAt(hit, "/*@C:") or code.startsWithAt(hit, "/*@P:") or code.startsWithAt(hit, "/*@LTMP:") or code.startsWithAt(hit, "/*@CSTK:") {
                endTag := code.indexOf("@*/", hit + 5);
                if hit > flushed { mut out.append(code.slice(flushed, hit)); }
                cursor = if endTag >= 0 { endTag + 3 } else { size };
                flushed = cursor;
            } else {
                cursor = hit + 3;
            }
        } else {
            endName := code.skipName(hit + 5);
            if endName > hit + 5 and endName < size and code.at(endName) == "(" {
                found := cBuiltinMap.get(code.slice(hit + 5, endName));
                if found.found {
                    if hit > flushed { mut out.append(code.slice(flushed, hit)); }
                    mut out.append(found.value);
                    mut out.append("(");
                    cursor = endName + 1;
                    flushed = cursor;
                    continue;
                }
            }
            cursor = endName;
        }
    }
    if flushed == 0 { return code; }
    if flushed < size { mut out.append(code.slice(flushed, size)); }
    out.build()
};

/** Builds one checked printf call for an Int*, Float*, String, Bool, Unit or Never report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind), code); }
    match {
        kind == frontend.VALUE_KIND_NEVER { "((void)(" + code + "), 0)" }
        kind == frontend.VALUE_KIND_UNIT {
            if code == "0" { "printf(\"Unit\")" } else { "((void)(" + code + "), printf(\"Unit\"))" }
        }
        frontend.isEnumKind(kind) and not frontend.isPayloadEnumKind(kind) {
            dName := frontend.enumDisplayName(kind);
            cCount := frontend.enumCaseCount(kind);
            labels: mut List<String> = [];
            var ci := 0;
            loop ci < cCount {
                mut labels.pushBack(cLiteral.textLiteralCode(dName + "." + frontend.enumCaseNameAt(kind, ci)));
                ci = ci + 1;
            }
            "printf(\"%s\", ((const char *const[]){" + labels.join(", ") + "}[" + code + "]))"
        }
        kind == frontend.VALUE_KIND_FLOAT8 { "lt_print_float(lt_f8_to_f64(" + code + "))" }
        kind == frontend.VALUE_KIND_FLOAT16 { "lt_print_float(lt_f16_to_f64(" + code + "))" }
        frontend.isFloatScalarKind(kind) { "lt_print_float((double)(" + code + "))" }
        numeric.isUnsignedIntKind(kind) { "printf(\"%\" PRIu64, (uint64_t)(" + code + "))" }
        frontend.cArrayTag(kind) =!= "" { frontend.cArrayTag(kind) + "_print(" + code + ")" }
        cListTagForKind(kind) =!= "" { "lt_list_" + cListTagForKind(kind) + "_print(" + code + ")" }
        frontend.cMapTag(kind) =!= "" { frontend.cMapTag(kind) + "_print(" + code + ")" }
        frontend.cSetTag(kind) =!= "" { frontend.cSetTag(kind) + "_print(" + code + ")" }
        frontend.cRcTag(kind) =!= "" { frontend.cRcTag(kind) + "_print(" + code + ")" }
        frontend.cSliceTag(kind) =!= "" { frontend.cSliceTag(kind) + "_print(" + code + ")" }
        frontend.cStructTag(kind) =!= "" { frontend.cStructTag(kind) + "_print(" + code + ")" }
        frontend.isIntScalarKind(kind) { "printf(\"%\" PRId64, (int64_t)(" + code + "))" }
        kind == frontend.VALUE_KIND_BOOL { "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))" }
        _ { "lt_print_str(" + code + ")" }
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(calls: Set<String>, name: String): Bool {
    calls.has(name)
}

/** True when any emitted item calls a helper whose token starts with `prefix`. */
usesHelperPrefix := fn(calls: Set<String>, prefix: String): Bool {
    loop calls as tok {
        if tok.startsWithAt(0, prefix) { return true; }
    }
    false
};

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(calls: Set<String>): String {
    match {
        usesIntHelper(calls, "lite$extTsStripTypes(") or usesIntHelper(calls, "lite$extHttpFetchToFile(") or
        usesIntHelper(calls, "lite$extHttpServeStatic(") or usesIntHelper(calls, "lite$extBenchMeasureCompiler(") {
            "C backend does not support external host builtins yet"
        }
        _ { "" }
    }
};

/** True when any emitted item calls an `external/pool` builtin. */
usesPoolBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$extPoolCpuCount(") or usesIntHelper(calls, "lite$extPoolRunJson(")
};

/** True when any emitted item calls a `core/time` builtin. */
usesTimeBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$timeMonotonicNs(") or usesIntHelper(calls, "lite$timeEpochNs(") or
    usesIntHelper(calls, "lite$timeSleepMs(") or usesIntHelper(calls, "lite$timeLocalDate(")
};

/** True when any emitted item calls a `core/process` child-spawn builtin. */
usesProcessSpawnBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$processRun(") or usesIntHelper(calls, "lite$processRunBytes(")
};

/** True when any emitted item calls a core/text Unicode hard builtin. */
usesUnicodeBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$unicodeToCodePoints(") or usesIntHelper(calls, "lite$unicodeFromCodePoints(")
};

/** True when any emitted item calls a core/io stream or core/file stream opener builtin. */
usesStreamBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or
    usesIntHelper(calls, "lite$fileOpenAppender(") or usesIntHelper(calls, "lite$ioStdinReader(") or
    usesIntHelper(calls, "lite$ioStdoutWriter(") or usesIntHelper(calls, "lite$ioStderrWriter(") or
    usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(") or
    usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
    usesIntHelper(calls, "lite$ioClearWriter(") or usesIntHelper(calls, "lite$ioReaderOk(") or
    usesIntHelper(calls, "lite$ioReaderAtEof(") or usesIntHelper(calls, "lite$ioReaderError(") or
    usesIntHelper(calls, "lite$ioRead(") or usesIntHelper(calls, "lite$ioCloseReader(") or
    usesIntHelper(calls, "lite$ioWriterOk(") or usesIntHelper(calls, "lite$ioWriterError(") or
    usesIntHelper(calls, "lite$ioWrite(") or usesIntHelper(calls, "lite$ioFlush(") or
    usesIntHelper(calls, "lite$ioCloseWriter(") or usesCIoSoft(calls)
};

/** True when any emitted item calls a core/file non-stream filesystem builtin. */
usesFileBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$fileKind(") or usesIntHelper(calls, "lite$fileListDir(") or
    usesIntHelper(calls, "lite$fileMakeDir(") or usesIntHelper(calls, "lite$fileRemove(") or
    usesIntHelper(calls, "lite$fileCopy(") or usesIntHelper(calls, "lite$fileSymlink(") or
    usesIntHelper(calls, "lite$fileRealPath(") or usesIntHelper(calls, "lite$fileMakeTempDir(")
};

/** True when any emitted item calls a core/process query builtin. */
usesProcessQueryBuiltins := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$processCwd(") or usesIntHelper(calls, "lite$processExecPath(") or
    usesIntHelper(calls, "lite$processEntryPath(") or usesIntHelper(calls, "lite$processPlatform(") or
    usesIntHelper(calls, "lite$processArch(") or usesIntHelper(calls, "lite$processRuntimeVersion(") or
    usesIntHelper(calls, "lite$processEnvGet(")
};

/** True when any emitted item calls a C11 soft-builtin text helper that needs `lt_utf8_get_meta`/`lt_utf8_byte_at`. */
usesCTextSoftUtf8 := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_c_text_skip_while(") or usesIntHelper(calls, "lt_c_text_index_of(") or
    usesIntHelper(calls, "lt_c_text_starts_with_at(") or usesIntHelper(calls, "lt_c_text_word_at(")
};

/** True when any emitted item calls a C11 soft-builtin file/crypto-file helper that needs POSIX headers. */
usesCFileSoft := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_c_file_read_text(") or usesIntHelper(calls, "lt_c_file_write_text(") or
    usesIntHelper(calls, "lt_c_file_append_text(") or usesIntHelper(calls, "lt_c_sha256_file(")
};

/** True when any emitted item calls a C11 soft-builtin `core/text` UTF-8 helper. */
usesCUtf8Soft := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_c_utf8_encode(") or
    usesIntHelper(calls, "lt_c_utf8_decode_strict(") or
    usesIntHelper(calls, "lt_c_utf8_decode_lossy(")
};

/** True when any emitted item calls a C11 soft-builtin `core/io` stream helper. */
usesCIoSoft := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_c_io_from_text(") or usesIntHelper(calls, "lt_c_io_read_all(") or
    usesIntHelper(calls, "lt_c_io_read_all_text(") or usesIntHelper(calls, "lt_c_io_read_line(") or
    usesIntHelper(calls, "lt_c_io_write_text(") or usesIntHelper(calls, "lt_c_io_write_line(")
};

/** True when any emitted item calls any C11 soft-builtin fast-path helper. */
usesCSoftBuiltins := fn(calls: Set<String>): Bool {
    usesCTextSoftUtf8(calls) or usesCFileSoft(calls) or usesCUtf8Soft(calls) or usesCIoSoft(calls) or
    usesIntHelper(calls, "lt_c_int_text(") or usesIntHelper(calls, "lt_c_text_join(") or
    usesIntHelper(calls, "lt_c_text_to_int(") or usesIntHelper(calls, "lt_c_text_trim(") or
    usesIntHelper(calls, "lt_c_text_ends_with(") or usesIntHelper(calls, "lt_c_text_repeat(") or
    usesIntHelper(calls, "lt_c_text_contains(") or usesIntHelper(calls, "lt_c_text_to_lower(") or
    usesIntHelper(calls, "lt_c_text_is_digit(") or usesIntHelper(calls, "lt_c_text_is_ascii_letter(") or
    usesIntHelper(calls, "lt_c_text_is_name_start(") or usesIntHelper(calls, "lt_c_text_is_name_continue(") or
    usesIntHelper(calls, "lt_c_text_is_whitespace(") or
    usesIntHelper(calls, "lt_c_sha256_text(") or usesIntHelper(calls, "lt_c_sha256_bytes(") or
    usesIntHelper(calls, "lt_c_u64_add_carry(") or usesIntHelper(calls, "lt_c_u64_sub_borrow(") or
    usesIntHelper(calls, "lt_c_list_fill_bytes(") or usesIntHelper(calls, "lt_c_list_copy_bytes(") or
    usesIntHelper(calls, "lt_c_list_index_of_byte(")
};

/** True when any emitted item needs POSIX OS headers (`unistd.h`, `fcntl.h`, `sys/stat.h`, `dirent.h`). */
usesPosixHost := fn(calls: Set<String>): Bool {
    usesStreamBuiltins(calls) or usesFileBuiltins(calls) or usesProcessQueryBuiltins(calls) or usesCFileSoft(calls) or
    usesProcessSpawnBuiltins(calls) or usesTimeBuiltins(calls) or usesPoolBuiltins(calls) or usesIntHelper(calls, "lite$cryptoRandomBytes(")
};

/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_remainder_int(") or
    usesIntHelper(calls, "lite_floor_divide_int(") or usesIntHelper(calls, "lite_floor_modulo_int(")
}

/** True when a program calls any integer unchecked intrinsic (`lt_uadd_...`, etc.). */
usesUncheckedInt := fn(calls: Set<String>): Bool {
    usesHelperPrefix(calls, "lt_uadd_") or usesHelperPrefix(calls, "lt_usub_") or
    usesHelperPrefix(calls, "lt_umul_") or usesHelperPrefix(calls, "lt_udiv_") or
    usesHelperPrefix(calls, "lt_urem_") or usesHelperPrefix(calls, "lt_uneg_") or
    usesHelperPrefix(calls, "lt_ushl_") or usesHelperPrefix(calls, "lt_ushr_") or
    usesHelperPrefix(calls, "lt_utrunc_")
};

/** True when a program calls any float unchecked or bit-cast intrinsic. */
usesUncheckedFloat := fn(calls: Set<String>): Bool {
    usesHelperPrefix(calls, "lt_ufadd_") or usesHelperPrefix(calls, "lt_ufsub_") or
    usesHelperPrefix(calls, "lt_ufmul_") or usesHelperPrefix(calls, "lt_ufdiv_") or
    usesHelperPrefix(calls, "lt_ufma_") or
    usesIntHelper(calls, "lt_f32_from_bits(") or usesIntHelper(calls, "lt_f64_from_bits(") or
    usesIntHelper(calls, "lt_f32_ufrom_bits(") or usesIntHelper(calls, "lt_f64_ufrom_bits(")
};

/** True when a program needs checked dynamic Int or UInt arithmetic, narrow range guards, or numeric casts. */
usesIntArithmetic := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_checked_add(") or usesIntHelper(calls, "lt_checked_subtract(") or
    usesIntHelper(calls, "lt_checked_multiply(") or usesIntHelper(calls, "lt_checked_negate(") or
    usesIntHelper(calls, "lt_checked_narrow_int(") or usesIntHelper(calls, "lt_checked_uadd(") or
    usesIntHelper(calls, "lt_checked_usub(") or usesIntHelper(calls, "lt_checked_umul(") or
    usesIntHelper(calls, "lt_checked_udiv(") or usesIntHelper(calls, "lt_checked_urem(") or
    usesIntHelper(calls, "lt_checked_narrow_uint(") or usesIntHelper(calls, "lt_cast_i2u(") or
    usesIntHelper(calls, "lt_cast_u2i(") or usesIntHelper(calls, "lt_trunc_f64_to_int(") or
    usesIntHelper(calls, "lt_trunc_f64_to_uint(") or usesIntHelper(calls, "lt_shl_s(") or
    usesIntHelper(calls, "lt_shl_u(") or usesIntHelper(calls, "lt_shr_s(") or usesIntHelper(calls, "lt_shr_u(")
}

/** True when Float/Float32/Float16/Float8 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float32_op(") or
    usesIntHelper(calls, "lt_float16_op(") or usesIntHelper(calls, "lt_float8_op(") or
    usesIntHelper(calls, "lt_f64_to_f8(") or usesIntHelper(calls, "lt_float8_literal(") or
    usesIntHelper(calls, "lt_f64_to_f16_checked(") or usesIntHelper(calls, "lt_f64_to_f32_checked(") or
    usesIntHelper(calls, "lt_float_power(") or usesHelperPrefix(calls, "lt_fma_") or
    usesUncheckedFloat(calls)
}

/** Emits checked Float8/Float16/Float32/Float operations; caller temporaries preserve left-to-right operand effects. */
emitFloatArithmeticHelpers := fn(calls: Set<String>, float8Values: Bool, float16Values: Bool, float8Literals: Bool, float16Literals: Bool, config: optCfg.OptConfig): Unit {
    needF8 := float8Values or float8Literals or usesIntHelper(calls, "lt_f8_to_f64(") or usesIntHelper(calls, "lt_f8_neg(") or usesIntHelper(calls, "lt_f64_to_f8(") or usesIntHelper(calls, "lt_float8_op(") or usesIntHelper(calls, "lt_fma_f8(") or usesIntHelper(calls, "lt_ufma_f8(") or usesIntHelper(calls, "lt_ufadd_f8(") or usesIntHelper(calls, "lt_ufsub_f8(") or usesIntHelper(calls, "lt_ufmul_f8(") or usesIntHelper(calls, "lt_ufdiv_f8(");
    needF16 := float16Values or float16Literals or usesIntHelper(calls, "lt_f16_to_f64(") or usesIntHelper(calls, "lt_f16_neg(") or usesHelperPrefix(calls, "lt_f64_to_f16") or usesIntHelper(calls, "lt_float16_op(") or usesHelperPrefix(calls, "lt_f16_") or usesIntHelper(calls, "lt_fma_f16(") or usesIntHelper(calls, "lt_ufma_f16(") or usesIntHelper(calls, "lt_ufadd_f16(") or usesIntHelper(calls, "lt_ufsub_f16(") or usesIntHelper(calls, "lt_ufmul_f16(") or usesIntHelper(calls, "lt_ufdiv_f16(");
    if needF8 {
        lutBuf: mut tb.TextBuilder;
        var b := 0;
        loop b < 256 {
            s := b / 128;
            em := b % 128;
            e := em / 8;
            m := em % 8;
            sign := if s =!= 0 { "-" } else { "" };
            entry := if e == 15 and m == 7 { "0.0f" }
            else if e == 0 and m == 0 { sign + "0.0f" }
            else if e == 0 { sign + "0x" + m.toText() + "p-9f" }
            else {
                mantHex := "0123456789abcdef".at(8 + m);
                sign + "0x" + mantHex + "p" + (e - 10).toText() + "f"
            };
            if b > 0 { mut lutBuf.append(", "); }
            mut lutBuf.append(entry);
            b = b + 1;
        }
        outLine("static const float lt_f8_lut[256] = { " + lutBuf.build() + " };");
        outLine("LT_INLINE double lt_f8_to_f64(uint8_t b) { return (double)lt_f8_lut[b]; }");
        outLine("LT_INLINE uint8_t lt_f8_neg(uint8_t b) { return (uint8_t)(b ^ 0x80u); }");
        if float8Literals or usesIntHelper(calls, "lt_f64_to_f8(") or usesIntHelper(calls, "lt_float8_op(") or usesIntHelper(calls, "lt_fma_f8(") or usesIntHelper(calls, "lt_ufma_f8(") or usesIntHelper(calls, "lt_ufadd_f8(") or usesIntHelper(calls, "lt_ufsub_f8(") or usesIntHelper(calls, "lt_ufmul_f8(") or usesIntHelper(calls, "lt_ufdiv_f8(") {
            outLine("static uint8_t lt_f64_to_f8(double x, size_t at) {");
            if config.checkFloatFinite {
                outLine("    if (!isfinite(x)) { lt_int_fault(at, \"non-finite floating value\"); }");
            } else {
                outLine("    (void)at;");
                outLine("    if (isnan(x)) { return 0x7fu; }");
            }
            outLine("    uint8_t sign = signbit(x) ? 0x80u : 0u;");
            outLine("    double ax = fabs(x);");
            outLine("    if (ax == 0.0) { return sign; }");
            if config.checkFloatFinite {
                outLine("    if (ax >= 464.0) { lt_int_fault(at, \"non-finite floating value\"); }");
            } else {
                outLine("    if (ax >= 464.0) { return (uint8_t)(sign | 0x7eu); }");
            }
            outLine("    if (ax < 0x1p-6) {");
            outLine("        double scaled = ax * 512.0; double fl = floor(scaled); double rem = scaled - fl; uint8_t m = (uint8_t)fl;");
            outLine("        if (rem > 0.5 || (rem == 0.5 && (m & 1u) != 0u)) { m += 1u; }");
            outLine("        return (uint8_t)(sign | (m == 8u ? 0x08u : m));");
            outLine("    }");
            outLine("    int e2 = 0; double f = frexp(ax, &e2); int e = (e2 - 1) + 7;");
            outLine("    double scaled = (2.0 * f - 1.0) * 8.0; double fl = floor(scaled); double rem = scaled - fl; uint8_t m = (uint8_t)fl;");
            outLine("    if (rem > 0.5 || (rem == 0.5 && (m & 1u) != 0u)) { m += 1u; }");
            outLine("    if (m == 8u) { m = 0u; e += 1; }");
            outLine("    return (uint8_t)(sign | (uint8_t)(e << 3) | m);");
            outLine("}");
        }
        if float8Literals { outLine("static uint8_t lt_float8_literal(const char *text) { return lt_f64_to_f8(strtod(text, NULL), 0); }"); }
        if usesIntHelper(calls, "lt_float8_op(") or (config.checkUnchecked and (usesIntHelper(calls, "lt_ufadd_f8(") or usesIntHelper(calls, "lt_ufsub_f8(") or usesIntHelper(calls, "lt_ufmul_f8(") or usesIntHelper(calls, "lt_ufdiv_f8("))) {
            outLine("static uint8_t lt_float8_op(double left, double right, int op, size_t at) {");
            if config.checkArithmetic { outLine("    if (op == 3 && right == 0.0) { lt_int_fault(at, \"division by zero\"); }"); }
            outLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
            outLine("    return lt_f64_to_f8(value, at);");
            outLine("}");
        }
    }
    if needF16 {
        outLine("#if defined(__FLT16_MANT_DIG__)");
        outLine("LT_INLINE double lt_f16_to_f64(lt_f16 v) { return (double)v; }");
        outLine("LT_INLINE lt_f16 lt_f64_to_f16_unchecked(double v) { return (lt_f16)v; }");
        outLine("LT_INLINE lt_f16 lt_f16_neg(lt_f16 v) { return -v; }");
        outLine("#else");
        outLine("LT_INLINE double lt_f16_to_f64(lt_f16 h) {");
        outLine("    uint32_t s = (h >> 15) & 1u; int32_t e = (h >> 10) & 0x1fu; uint32_t m = h & 0x3ffu;");
        outLine("    double v = (e == 0) ? ldexp((double)m, -24) : (e == 31) ? (m ? NAN : INFINITY) : ldexp((double)(0x400u + m), e - 25);");
        outLine("    return s ? -v : v;");
        outLine("}");
        outLine("static lt_f16 lt_f64_to_f16_unchecked(double x) {");
        outLine("    if (isnan(x)) { return 0x7e00u; }");
        outLine("    uint16_t sign = signbit(x) ? 0x8000u : 0u;");
        outLine("    double ax = fabs(x);");
        outLine("    if (ax == 0.0) { return sign; }");
        outLine("    if (isinf(ax) || ax >= 65520.0) { return (uint16_t)(sign | 0x7c00u); }");
        outLine("    if (ax < 0x1p-14) {");
        outLine("        double scaled = ldexp(ax, 24); double fl = floor(scaled); double rem = scaled - fl; uint16_t m = (uint16_t)fl;");
        outLine("        if (rem > 0.5 || (rem == 0.5 && (m & 1u) != 0u)) { m += 1u; }");
        outLine("        return (uint16_t)(sign | (m == 1024u ? 0x0400u : m));");
        outLine("    }");
        outLine("    int e2 = 0; double f = frexp(ax, &e2); int e = (e2 - 1) + 15;");
        outLine("    double scaled = (2.0 * f - 1.0) * 1024.0; double fl = floor(scaled); double rem = scaled - fl; uint16_t m = (uint16_t)fl;");
        outLine("    if (rem > 0.5 || (rem == 0.5 && (m & 1u) != 0u)) { m += 1u; }");
        outLine("    if (m == 1024u) { m = 0u; e += 1; }");
        outLine("    return (uint16_t)(sign | (uint16_t)(e << 10) | m);");
        outLine("}");
        outLine("LT_INLINE lt_f16 lt_f16_neg(lt_f16 h) { return (lt_f16)(h ^ 0x8000u); }");
        outLine("#endif");
        if usesIntHelper(calls, "lt_f64_to_f16_checked(") or usesIntHelper(calls, "lt_float16_op(") or usesIntHelper(calls, "lt_fma_f16(") or (config.checkUnchecked and (usesIntHelper(calls, "lt_ufma_f16(") or usesIntHelper(calls, "lt_ufadd_f16(") or usesIntHelper(calls, "lt_ufsub_f16(") or usesIntHelper(calls, "lt_ufmul_f16(") or usesIntHelper(calls, "lt_ufdiv_f16("))) {
            outLine("static lt_f16 lt_f64_to_f16_checked(double v, size_t at) {");
            if config.checkFloatFinite {
                outLine("    if (!isfinite(v) || fabs(v) >= 65520.0) { lt_int_fault(at, \"non-finite floating value\"); }");
            } else {
                outLine("    (void)at;");
            }
            outLine("    return lt_f64_to_f16_unchecked(v);");
            outLine("}");
        }
        if float16Literals { outLine("static lt_f16 lt_float16_literal(const char *text) { return lt_f64_to_f16_unchecked(strtod(text, NULL)); }"); }
        if usesIntHelper(calls, "lt_float16_op(") or (config.checkUnchecked and (usesIntHelper(calls, "lt_ufadd_f16(") or usesIntHelper(calls, "lt_ufsub_f16(") or usesIntHelper(calls, "lt_ufmul_f16(") or usesIntHelper(calls, "lt_ufdiv_f16("))) {
            outLine("static lt_f16 lt_float16_op(double left, double right, int op, size_t at) {");
            if config.checkArithmetic { outLine("    if (op == 3 && right == 0.0) { lt_int_fault(at, \"division by zero\"); }"); }
            outLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
            outLine("    return lt_f64_to_f16_checked(value, at);");
            outLine("}");
        }
        if usesIntHelper(calls, "lt_f16_add_raw(") {
            outLine("LT_INLINE lt_f16 lt_f16_add_raw(lt_f16 a, lt_f16 b) { return lt_f64_to_f16_unchecked(lt_f16_to_f64(a) + lt_f16_to_f64(b)); }");
        }
        if usesIntHelper(calls, "lt_f16_sub_raw(") {
            outLine("LT_INLINE lt_f16 lt_f16_sub_raw(lt_f16 a, lt_f16 b) { return lt_f64_to_f16_unchecked(lt_f16_to_f64(a) - lt_f16_to_f64(b)); }");
        }
        if usesIntHelper(calls, "lt_f16_mul_raw(") {
            outLine("LT_INLINE lt_f16 lt_f16_mul_raw(lt_f16 a, lt_f16 b) { return lt_f64_to_f16_unchecked(lt_f16_to_f64(a) * lt_f16_to_f64(b)); }");
        }
        if usesIntHelper(calls, "lt_f16_div_raw(") {
            outLine("LT_INLINE lt_f16 lt_f16_div_raw(lt_f16 a, lt_f16 b) { return lt_f64_to_f16_unchecked(lt_f16_to_f64(a) / lt_f16_to_f64(b)); }");
        }
    }
    if usesIntHelper(calls, "lt_fma_f8(") or (config.checkUnchecked and usesIntHelper(calls, "lt_ufma_f8(")) {
        outLine("static uint8_t lt_fma_f8(uint8_t a, uint8_t b, uint8_t c, size_t at) {");
        outLine("    return lt_f64_to_f8(fma(lt_f8_to_f64(a), lt_f8_to_f64(b), lt_f8_to_f64(c)), at);");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_fma_f16(") or (config.checkUnchecked and usesIntHelper(calls, "lt_ufma_f16(")) {
        outLine("static lt_f16 lt_fma_f16(lt_f16 a, lt_f16 b, lt_f16 c, size_t at) {");
        outLine("    return lt_f64_to_f16_checked(fma(lt_f16_to_f64(a), lt_f16_to_f64(b), lt_f16_to_f64(c)), at);");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_fma_f32(") or (config.checkUnchecked and usesIntHelper(calls, "lt_ufma_f32(")) {
        outLine("static float lt_fma_f32(float a, float b, float c, size_t at) {");
        outLine("    float v = fmaf(a, b, c);");
        if config.checkFloatFinite { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_fma_f64(") or (config.checkUnchecked and usesIntHelper(calls, "lt_ufma_f64(")) {
        outLine("static double lt_fma_f64(double a, double b, double c, size_t at) {");
        outLine("    double v = fma(a, b, c);");
        if config.checkFloatFinite { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_f64_to_f32_checked(") {
        outLine("static float lt_f64_to_f32_checked(double v, size_t at) {");
        outLine("    float r = (float)v;");
        if config.checkFloatFinite { outLine("    if (!isfinite(r)) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return r;");
        outLine("}");
    }
    if not usesFloatArithmetic(calls) { return; }
    if usesIntHelper(calls, "lt_float_power(") {
        outLine("static double lt_float_power(double left, double right, size_t at) {");
        if config.checkArithmetic { outLine("    if (left == 0 && right < 0) { lt_int_fault(at, \"zero cannot be raised to a negative power\"); }"); }
        outLine("    double value = pow(left, right);");
        if config.checkFloatFinite { outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else if not config.checkArithmetic { outLine("    (void)at;"); }
        outLine("    return value;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_float32_op(") or (config.checkUnchecked and (usesIntHelper(calls, "lt_ufadd_f32(") or usesIntHelper(calls, "lt_ufsub_f32(") or usesIntHelper(calls, "lt_ufmul_f32(") or usesIntHelper(calls, "lt_ufdiv_f32("))) {
        outLine("static float lt_float32_op(double left, double right, int op, size_t at) {");
        outLine("    const float l = (float)left;");
        outLine("    const float r = (float)right;");
        if config.checkArithmetic { outLine("    if (op == 3 && r == 0.0f) { lt_int_fault(at, \"division by zero\"); }"); }
        outLine("    float value = op == 0 ? l + r : op == 1 ? l - r : op == 2 ? l * r : l / r;");
        if config.checkFloatFinite { outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else if not config.checkArithmetic { outLine("    (void)at;"); }
        outLine("    return value;");
        outLine("}");
    }
    if not (usesIntHelper(calls, "lt_float_op(") or (config.checkUnchecked and (usesIntHelper(calls, "lt_ufadd_f64(") or usesIntHelper(calls, "lt_ufsub_f64(") or usesIntHelper(calls, "lt_ufmul_f64(") or usesIntHelper(calls, "lt_ufdiv_f64(")))) { return; }
    outLine("static double lt_float_op(double left, double right, int op, size_t at) {");
    if config.checkArithmetic { outLine("    if (op == 3 && right == 0) { lt_int_fault(at, \"division by zero\"); }"); }
    outLine("    double value = op == 0 ? left + right : op == 1 ? left - right : op == 2 ? left * right : left / right;");
    if config.checkFloatFinite { outLine("    if (!isfinite(value)) { lt_int_fault(at, \"non-finite floating value\"); }"); }
    else if not config.checkArithmetic { outLine("    (void)at;"); }
    outLine("    return value;");
    outLine("}");
}

/** True when a program calls `core/text` UTF-8 scalar primitives. */
usesTextPrimitives := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite$textLength(") or usesIntHelper(calls, "lite$textAt(") or
    usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(")
}

/** True when any list, fixed-array, or map bounds helper actually needs `lt_bound_fault`. */
usesAnyListBounds := fn(calls: Set<String>, config: optCfg.OptConfig): Bool {
    loop calls as tok {
        if tok.startsWithAt(0, "lt_list_") and (
        ((tok.endsWith("_at(") or tok.endsWith("_set(")) and config.checkBounds) or
        ((tok.endsWith("_uat(") or tok.endsWith("_uset(")) and config.checkUnchecked) or
        tok.endsWith("_pop_back(") or tok.endsWith("_pop_front(") or
        tok.endsWith("_slice(") or tok.endsWith("_slice_from(")
        ) {
            return true;
        }
        if tok.startsWithAt(0, "lt_arr_") and (
        ((tok.endsWith("_at(") or tok.endsWith("_set(")) and config.checkBounds) or
        ((tok.endsWith("_uat(") or tok.endsWith("_uset(")) and config.checkUnchecked) or
        tok.endsWith("_slice(") or tok.endsWith("_slice_from(")
        ) {
            return true;
        }
        if tok.startsWithAt(0, "lt_map_") and tok.endsWith("_at(") {
            return true;
        }
        if tok.startsWithAt(0, "lt_slice_") and (
        tok.endsWith("_from_list(") or tok.endsWith("_from_raw(") or
        tok.endsWith("_sub(") or tok.endsWith("_split_at(") or
        ((tok.endsWith("_at(") or tok.endsWith("_set(") or tok.endsWith("_at_r(") or tok.endsWith("_set_r(")) and config.checkBounds) or
        ((tok.endsWith("_uat(") or tok.endsWith("_uset(") or tok.endsWith("_uat_r(") or tok.endsWith("_uset_r(")) and config.checkUnchecked)
        ) {
            return true;
        }
    }
    if config.checkBounds and (usesIntHelper(calls, "lt_c_list_fill_bytes(") or usesIntHelper(calls, "lt_c_list_copy_bytes(")) {
        return true;
    }
    false
};

/** Analyzes spare bit-pattern niches for `kind` up to struct depth 4 (`Bool` only at depth 0 for C11 soundness). */
cTypeNicheInfo := fn(kind: String, depth: Int): (hasNiche: Bool, mode: String, fieldPath: String, cRawType: String, sentinelVal: String) {
    emptyNiche := (hasNiche = false, mode = "", fieldPath = "", cRawType = "", sentinelVal = "");
    if depth > 4 { return emptyNiche; }
    base := frontend.distinctBaseKind(kind);
    if frontend.isRecordKind(base) {
        ra := frontend.recordLayoutAttrs(base);
        if ra.noNiche or ra.packed { return emptyNiche; }
    }
    if frontend.isEnumKind(base) and frontend.enumLayoutAttrs(base).noNiche {
        return emptyNiche;
    }
    if base == frontend.VALUE_KIND_BOOL {
        if depth == 0 {
            return (hasNiche = true, mode = "bool", fieldPath = "", cRawType = "uint8_t", sentinelVal = "2u");
        }
        return emptyNiche;
    }
    if base == frontend.VALUE_KIND_INT1 or base == frontend.VALUE_KIND_INT2 or base == frontend.VALUE_KIND_INT4 {
        return (hasNiche = true, mode = "sub_i", fieldPath = "", cRawType = "int8_t", sentinelVal = "INT8_MIN");
    }
    if base == frontend.VALUE_KIND_UINT1 or base == frontend.VALUE_KIND_UINT2 or base == frontend.VALUE_KIND_UINT4 {
        return (hasNiche = true, mode = "sub_u", fieldPath = "", cRawType = "uint8_t", sentinelVal = "UINT8_MAX");
    }
    if frontend.isEnumKind(base) and not frontend.isPayloadEnumKind(base) {
        st := frontend.plainEnumCStorage(base);
        cc := frontend.enumCaseCount(base);
        if cc >= st.maxCases { return emptyNiche; }
        sentExpr := if st.cType == "int64_t" { "INT64_C(-1)" } else { "((" + st.cType + ")" + cc.toText() + "u)" };
        return (hasNiche = true, mode = "enum", fieldPath = "", cRawType = st.cType, sentinelVal = sentExpr);
    }
    if base == frontend.VALUE_KIND_STRING {
        return (hasNiche = true, mode = "str", fieldPath = "", cRawType = "lt_str", sentinelVal = "0x7Fu");
    }
    if frontend.isRcKind(base) and frontend.cRcTag(base) =!= "" {
        return (hasNiche = true, mode = "rc", fieldPath = "", cRawType = frontend.cRcTag(base), sentinelVal = "(void *)(uintptr_t)1u");
    }
    if frontend.isListKind(base) and cListTagForKind(base) =!= "" {
        return (hasNiche = true, mode = "list", fieldPath = "", cRawType = cScalarType(base), sentinelVal = "1u");
    }
    if frontend.isRecordKind(base) or frontend.isTupleKind(base) {
        isR := frontend.isRecordKind(base);
        cnt := if isR { frontend.recordComponentCount(base) } else { frontend.tupleComponentCount(base) };
        var fi := 0;
        loop fi < cnt {
            comp := if isR { frontend.recordComponent(base, fi) } else { frontend.tupleComponent(base, fi) };
            sub := self(comp.kind, depth + 1);
            if sub.hasNiche {
                return (hasNiche = true, mode = sub.mode, fieldPath = "." + frontend.cFieldName(comp.prop) + sub.fieldPath, cRawType = sub.cRawType, sentinelVal = sub.sentinelVal);
            }
            fi = fi + 1;
        }
    }
    emptyNiche
};

/** Returns a C11 `_Alignas(...)` prefix string for `align` (`0` -> `""`), clamped safely against `baseType`. */
cAlignasPrefix := fn(align: Int, baseType: String): String {
    if align <= 0 { "" } else { "_Alignas((" + align.toText() + " > _Alignof(" + baseType + ")) ? " + align.toText() + " : _Alignof(" + baseType + ")) " }
};

/** Emits portable ISO C11 typedef, optional deep copy, and optional print helper for one tuple, nominal record, or payload enum `kind`. */
emitCStructHelpers := fn(kind: String, needCopy: Bool, needPrint: Bool, config: optCfg.OptConfig): Unit {
    tag := frontend.cStructTag(kind);
    if frontend.isPayloadEnumKind(kind) {
        cc := frontend.enumCaseCount(kind);
        eAttrs := frontend.enumLayoutAttrs(kind);
        var packEmptyIdx := -1;
        var packSomeIdx := -1;
        var canNichePack := false;
        var packPayloadKind := "";
        var packNiche := (hasNiche = false, mode = "", fieldPath = "", cRawType = "", sentinelVal = "");
        if config.nicheOpt and not eAttrs.noNiche and cc == 2 {
            p0 := frontend.enumCasePayloadCount(kind, 0);
            p1 := frontend.enumCasePayloadCount(kind, 1);
            if p0 == 0 and p1 == 1 {
                packEmptyIdx = 0;
                packSomeIdx = 1;
                packPayloadKind = frontend.enumCasePayloadKind(kind, 1, 0);
            } else if p1 == 0 and p0 == 1 {
                packEmptyIdx = 1;
                packSomeIdx = 0;
                packPayloadKind = frontend.enumCasePayloadKind(kind, 0, 0);
            }
            if packPayloadKind =!= "" {
                packNiche = cTypeNicheInfo(packPayloadKind, 0);
                canNichePack = packNiche.hasNiche;
            }
        }
        if canNichePack {
            isBoolNiche := packNiche.mode == "bool";
            pCType := cScalarType(packPayloadKind);
            fieldCType := if isBoolNiche { "uint8_t" } else { pCType };
            fieldName := if isBoolNiche { "raw" } else { "val" };
            alignPref := cAlignasPrefix(eAttrs.align, fieldCType);
            outLine("typedef struct { " + alignPref + fieldCType + " " + fieldName + "; } " + tag + ";");
            outLine("LT_INLINE " + tag + " " + tag + "_mk_" + packEmptyIdx.toText() + "(void) {");
            outLine("    " + tag + " r;");
            outLine("    memset(&r, 0, sizeof(r));");
            if isBoolNiche {
                outLine("    r.raw = 2u;");
            } else if packNiche.mode == "str" {
                outLine("    r.val" + packNiche.fieldPath + ".sso.tag = 0x7Fu;");
            } else if packNiche.mode == "rc" {
                outLine("    r.val" + packNiche.fieldPath + ".box = (void *)(uintptr_t)1u;");
            } else if packNiche.mode == "list" {
                outLine("    r.val" + packNiche.fieldPath + ".len = 1u;");
            } else {
                outLine("    r.val" + packNiche.fieldPath + " = " + packNiche.sentinelVal + ";");
            }
            outLine("    return r;");
            outLine("}");
            outLine("LT_INLINE " + tag + " " + tag + "_mk_" + packSomeIdx.toText() + "(" + pCType + " f0) {");
            if isBoolNiche {
                outLine("    return (" + tag + "){ .raw = f0 ? (uint8_t)1u : (uint8_t)0u };");
            } else {
                outLine("    return (" + tag + "){ .val = f0 };");
            }
            outLine("}");
            isSentExpr := if isBoolNiche {
                "(v.raw == 2u)"
            } else if packNiche.mode == "str" {
                "(v.val" + packNiche.fieldPath + ".sso.tag == 0x7Fu)"
            } else if packNiche.mode == "rc" {
                "(v.val" + packNiche.fieldPath + ".box == (void *)(uintptr_t)1u)"
            } else if packNiche.mode == "list" {
                "(v.val" + packNiche.fieldPath + ".data == NULL && v.val" + packNiche.fieldPath + ".len == 1u)"
            } else {
                "(v.val" + packNiche.fieldPath + " == " + packNiche.sentinelVal + ")"
            };
            outLine("LT_INLINE int64_t " + tag + "_tag(" + tag + " v) { return " + isSentExpr + " ? INT64_C(" + packEmptyIdx.toText() + ") : INT64_C(" + packSomeIdx.toText() + "); }");
            if isBoolNiche {
                outLine("LT_INLINE bool " + tag + "_p_" + packSomeIdx.toText() + "_0(" + tag + " v) { return v.raw != 0u; }");
            } else {
                outLine("LT_INLINE " + pCType + " " + tag + "_p_" + packSomeIdx.toText() + "_0(" + tag + " v) { return v.val; }");
            }
            if frontend.cTypeNeedsDrop(kind) {
                pOps := cKindOps(packPayloadKind);
                outLine("LT_INLINE void " + tag + "_drop(" + tag + " *v) {");
                if pOps.dropFn =!= "" {
                    outLine("    if (" + tag + "_tag(*v) == INT64_C(" + packSomeIdx.toText() + ")) { " + pOps.dropFn + "(&v->val); }");
                }
                outLine("    *v = " + tag + "_mk_" + packEmptyIdx.toText() + "();");
                outLine("}");
                outLine("LT_INLINE " + tag + " " + tag + "_move(" + tag + " *v) { " + tag + " r = *v; *v = " + tag + "_mk_" + packEmptyIdx.toText() + "(); return r; }");
                if needCopy {
                    outLine("LT_INLINE " + tag + " " + tag + "_copy(" + tag + " src) {");
                    if pOps.copyFn =!= "" {
                        outLine("    if (" + tag + "_tag(src) == INT64_C(" + packSomeIdx.toText() + ")) { return " + tag + "_mk_" + packSomeIdx.toText() + "(" + pOps.copyFn + "(src.val)); }");
                    }
                    outLine("    return src;");
                    outLine("}");
                }
            }
            if needPrint {
                dName := frontend.enumDisplayName(kind);
                emptyName := frontend.enumCaseNameAt(kind, packEmptyIdx);
                someName := frontend.enumCaseNameAt(kind, packSomeIdx);
                outLine("static int " + tag + "_print(" + tag + " v) {");
                outLine("    if (" + tag + "_tag(v) == INT64_C(" + packEmptyIdx.toText() + ")) { return printf(\"%s\", " + cLiteral.textLiteralCode(dName + "." + emptyName) + "); }");
                outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(dName + "." + someName + "(") + ") < 0) { return -1; }");
                outLine("    if (" + cCall(packPayloadKind, tag + "_p_" + packSomeIdx.toText() + "_0(v)") + " < 0) { return -1; }");
                outLine("    return printf(\")\");");
                outLine("}");
            }
            outLine("");
            return;
        }
        unionFieldsBuf: mut tb.TextBuilder;
        mut unionFieldsBuf.append("int _empty; ");
        var ci := 0;
        loop ci < cc {
            pc := frontend.enumCasePayloadCount(kind, ci);
            if pc > 0 {
                sfBuf: mut tb.TextBuilder;
                var pi := 0;
                loop pi < pc {
                    mut sfBuf.append(cScalarType(frontend.enumCasePayloadKind(kind, ci, pi)));
                    mut sfBuf.append(" f");
                    mut sfBuf.append(pi.toText());
                    mut sfBuf.append("; ");
                    pi = pi + 1;
                }
                mut unionFieldsBuf.append("struct { ");
                mut unionFieldsBuf.append(sfBuf.build());
                mut unionFieldsBuf.append("} c");
                mut unionFieldsBuf.append(ci.toText());
                mut unionFieldsBuf.append("; ");
            }
            ci = ci + 1;
        }
        eTagAlign := cAlignasPrefix(eAttrs.align, "int64_t");
        outLine("typedef struct { " + eTagAlign + "int64_t tag; union { " + unionFieldsBuf.build() + "} u; } " + tag + ";");
        outLine("LT_INLINE int64_t " + tag + "_tag(" + tag + " v) { return v.tag; }");
        var mci := 0;
        loop mci < cc {
            pc := frontend.enumCasePayloadCount(kind, mci);
            if pc == 0 {
                outLine("LT_INLINE " + tag + " " + tag + "_mk_" + mci.toText() + "(void) { return (" + tag + "){ .tag = " + mci.toText() + ", .u = { ._empty = 0 } }; }");
            } else {
                pDeclBuf: mut tb.TextBuilder;
                pInitBuf: mut tb.TextBuilder;
                var pi := 0;
                loop pi < pc {
                    pk := frontend.enumCasePayloadKind(kind, mci, pi);
                    pCT := cScalarType(pk);
                    if pi > 0 {
                        mut pDeclBuf.append(", ");
                        mut pInitBuf.append(", ");
                    }
                    mut pDeclBuf.append(pCT);
                    mut pDeclBuf.append(" f");
                    mut pDeclBuf.append(pi.toText());
                    mut pInitBuf.append(".f");
                    mut pInitBuf.append(pi.toText());
                    mut pInitBuf.append(" = f");
                    mut pInitBuf.append(pi.toText());
                    outLine("LT_INLINE " + pCT + " " + tag + "_p_" + mci.toText() + "_" + pi.toText() + "(" + tag + " v) { return v.u.c" + mci.toText() + ".f" + pi.toText() + "; }");
                    pi = pi + 1;
                }
                outLine("LT_INLINE " + tag + " " + tag + "_mk_" + mci.toText() + "(" + pDeclBuf.build() + ") { return (" + tag + "){ .tag = " + mci.toText() + ", .u = { .c" + mci.toText() + " = { " + pInitBuf.build() + " } } }; }");
            }
            mci = mci + 1;
        }
        if frontend.cTypeNeedsDrop(kind) {
            outLine("LT_INLINE void " + tag + "_drop(" + tag + " *v) {");
            outLine("    switch (v->tag) {");
            var dci := 0;
            loop dci < cc {
                pc := frontend.enumCasePayloadCount(kind, dci);
                var caseDrops: mut List<String> = [];
                var dpi := 0;
                loop dpi < pc {
                    pk := frontend.enumCasePayloadKind(kind, dci, dpi);
                    pOps := cKindOps(pk);
                    if pOps.dropFn =!= "" {
                        mut caseDrops.pushBack(pOps.dropFn + "(&v->u.c" + dci.toText() + ".f" + dpi.toText() + ");");
                    }
                    dpi += 1;
                }
                if caseDrops.length() > 0 {
                    outLine("        case " + dci.toText() + ": " + caseDrops.join(" ") + " break;");
                }
                dci += 1;
            }
            outLine("        default: break;");
            outLine("    }");
            outLine("    memset(v, 0, sizeof(*v));");
            outLine("}");
            outLine("LT_INLINE " + tag + " " + tag + "_move(" + tag + " *v) { " + tag + " r = *v; memset(v, 0, sizeof(*v)); return r; }");
        }
        if needCopy and frontend.cTypeNeedsDrop(kind) {
            outLine("LT_INLINE " + tag + " " + tag + "_copy(" + tag + " src) {");
            outLine("    switch (src.tag) {");
            var cci := 0;
            loop cci < cc {
                pc := frontend.enumCasePayloadCount(kind, cci);
                var caseHasHeap := false;
                var pi := 0;
                loop pi < pc {
                    pk := frontend.enumCasePayloadKind(kind, cci, pi);
                    if cKindOps(pk).copyFn =!= "" {
                        caseHasHeap = true;
                        break;
                    }
                    pi = pi + 1;
                }
                if caseHasHeap {
                    initsBuf: mut tb.TextBuilder;
                    var ppi := 0;
                    loop ppi < pc {
                        if ppi > 0 { mut initsBuf.append(", "); }
                        pk := frontend.enumCasePayloadKind(kind, cci, ppi);
                        fnm := "src.u.c" + cci.toText() + ".f" + ppi.toText();
                        pCopyFn := cKindOps(pk).copyFn;
                        fVal := if pCopyFn =!= "" { pCopyFn + "(" + fnm + ")" } else { fnm };
                        mut initsBuf.append(".f");
                        mut initsBuf.append(ppi.toText());
                        mut initsBuf.append(" = ");
                        mut initsBuf.append(fVal);
                        ppi = ppi + 1;
                    }
                    outLine("        case " + cci.toText() + ": return (" + tag + "){ .tag = " + cci.toText() + ", .u = { .c" + cci.toText() + " = { " + initsBuf.build() + " } } };");
                }
                cci = cci + 1;
            }
            outLine("        default: return src;");
            outLine("    }");
            outLine("}");
        }
        if needPrint {
            dName := frontend.enumDisplayName(kind);
            outLine("static int " + tag + "_print(" + tag + " v) {");
            outLine("    switch (v.tag) {");
            var pci := 0;
            loop pci < cc {
                cName := frontend.enumCaseNameAt(kind, pci);
                pc := frontend.enumCasePayloadCount(kind, pci);
                if pc == 0 {
                    outLine("        case " + pci.toText() + ": (void)v; return printf(\"%s\", " + cLiteral.textLiteralCode(dName + "." + cName) + ");");
                } else {
                    outLine("        case " + pci.toText() + ": {");
                    outLine("            if (printf(\"%s\", " + cLiteral.textLiteralCode(dName + "." + cName + "(") + ") < 0) { return -1; }");
                    var ppi := 0;
                    loop ppi < pc {
                        if ppi > 0 {
                            outLine("            if (printf(\", \") < 0) { return -1; }");
                        }
                        pk := frontend.enumCasePayloadKind(kind, pci, ppi);
                        outLine("            if (" + cCall(pk, "v.u.c" + pci.toText() + ".f" + ppi.toText()) + " < 0) { return -1; }");
                        ppi = ppi + 1;
                    }
                    outLine("            return printf(\")\");");
                    outLine("        }");
                }
                pci = pci + 1;
            }
            outLine("        default: (void)v; return 0;");
            outLine("    }");
            outLine("}");
        }
        outLine("");
        return;
    }
    isRec := frontend.isRecordKind(kind);
    recAttrs := if isRec { frontend.recordLayoutAttrs(kind) } else { (packed = false, align = 0, noNiche = false) };
    packedKw := if recAttrs.packed { "LT_PACKED " } else { "" };
    count := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
    if count == 0 {
        emptyAlign := cAlignasPrefix(recAttrs.align, "int");
        outLine("typedef struct " + packedKw + "{ " + emptyAlign + "int _empty; } " + tag + ";");
    } else {
        fieldsBuf: mut tb.TextBuilder;
        var i := 0;
        loop i < count {
            comp := if isRec { frontend.recordComponent(kind, i) } else { frontend.tupleComponent(kind, i) };
            fCT := cScalarType(comp.kind);
            if i == 0 and recAttrs.align > 0 {
                mut fieldsBuf.append(cAlignasPrefix(recAttrs.align, fCT));
            }
            mut fieldsBuf.append(fCT);
            mut fieldsBuf.append(" ");
            mut fieldsBuf.append(frontend.cFieldName(comp.prop));
            mut fieldsBuf.append("; ");
            i = i + 1;
        }
        outLine("typedef struct " + packedKw + "{ " + fieldsBuf.build() + "} " + tag + ";");
    }
    if frontend.cTypeNeedsDrop(kind) {
        outLine("LT_INLINE void " + tag + "_drop(" + tag + " *v) {");
        var di := 0;
        loop di < count {
            comp := if isRec { frontend.recordComponent(kind, di) } else { frontend.tupleComponent(kind, di) };
            dFn := cKindOps(comp.kind).dropFn;
            if dFn =!= "" {
                outLine("    " + dFn + "(&v->" + frontend.cFieldName(comp.prop) + ");");
            }
            di += 1;
        }
        outLine("    memset(v, 0, sizeof(*v));");
        outLine("}");
        outLine("LT_INLINE " + tag + " " + tag + "_move(" + tag + " *v) { " + tag + " r = *v; memset(v, 0, sizeof(*v)); return r; }");
    }
    if needCopy and frontend.cTypeNeedsDrop(kind) {
        outLine("LT_INLINE " + tag + " " + tag + "_copy(" + tag + " src) {");
        if count == 0 {
            outLine("    return src;");
        } else {
            initsBuf: mut tb.TextBuilder;
            var ci := 0;
            loop ci < count {
                comp := if isRec { frontend.recordComponent(kind, ci) } else { frontend.tupleComponent(kind, ci) };
                if ci > 0 { mut initsBuf.append(", "); }
                fnm := frontend.cFieldName(comp.prop);
                cFn := cKindOps(comp.kind).copyFn;
                fVal := if cFn =!= "" { cFn + "(src." + fnm + ")" } else { "src." + fnm };
                mut initsBuf.append(".");
                mut initsBuf.append(fnm);
                mut initsBuf.append(" = ");
                mut initsBuf.append(fVal);
                ci = ci + 1;
            }
            outLine("    return (" + tag + "){ " + initsBuf.build() + " };");
        }
        outLine("}");
    }
    if needPrint {
        outLine("static int " + tag + "_print(" + tag + " v) {");
        if isRec {
            recName := frontend.recordDisplayName(kind);
            if count == 0 {
                outLine("    (void)v;");
                outLine("    return printf(\"%s\", " + cLiteral.textLiteralCode(recName + " {}") + ");");
            } else {
                outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(recName + " { ") + ") < 0) { return -1; }");
                var pi := 0;
                loop pi < count {
                    comp := frontend.recordComponent(kind, pi);
                    sep := if pi == 0 { "" } else { ", " };
                    outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(sep + comp.label + " = ") + ") < 0) { return -1; }");
                    outLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                    pi = pi + 1;
                }
                outLine("    return printf(\" }\");");
            }
        } else {
            outLine("    if (printf(\"(\") < 0) { return -1; }");
            var pi := 0;
            loop pi < count {
                comp := frontend.tupleComponent(kind, pi);
                sep := if pi == 0 { "" } else { ", " };
                prefixTxt := if comp.label == "" { sep } else { sep + comp.label + "=" };
                if prefixTxt =!= "" {
                    outLine("    if (printf(\"%s\", " + cLiteral.textLiteralCode(prefixTxt) + ") < 0) { return -1; }");
                }
                outLine("    if (" + cCall(comp.kind, "v." + frontend.cFieldName(comp.prop)) + " < 0) { return -1; }");
                pi = pi + 1;
            }
            if count == 0 { outLine("    (void)v;"); }
            ending := if count == 1 { ",)" } else { ")" };
            outLine("    return printf(" + cLiteral.textLiteralCode(ending) + ");");
        }
        outLine("}");
    }
    outLine("");
};

/** Emits one C11 tuple-label conversion helper converting `actualKind` to `expectedKind`. */
emitCTupleConvHelper := fn(expectedKind: String, actualKind: String): Unit {
    expTag := frontend.cStructTag(expectedKind);
    actTag := frontend.cStructTag(actualKind);
    fnName := frontend.cTupleConvertName(expectedKind, actualKind);
    count := frontend.tupleComponentCount(expectedKind);
    outLine("static " + expTag + " " + fnName + "(" + actTag + " v) {");
    if count == 0 {
        outLine("    (void)v; return (" + expTag + "){ ._empty = 0 };");
    } else {
        initsBuf: mut tb.TextBuilder;
        var i := 0;
        loop i < count {
            eComp := frontend.tupleComponent(expectedKind, i);
            aComp := frontend.tupleComponent(actualKind, i);
            if i > 0 { mut initsBuf.append(", "); }
            aExpr := "v." + frontend.cFieldName(aComp.prop);
            cFn := cKindOps(eComp.kind).copyFn;
            fVal := if cFn =!= "" { cFn + "(" + aExpr + ")" } else { aExpr };
            mut initsBuf.append(".");
            mut initsBuf.append(frontend.cFieldName(eComp.prop));
            mut initsBuf.append(" = ");
            mut initsBuf.append(fVal);
            i = i + 1;
        }
        outLine("    return (" + expTag + "){ " + initsBuf.build() + " };");
    }
    outLine("}");
    outLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Map<K, V>` (24 B descriptor + single contiguous backing allocation) and helpers for `kind`. */
emitCMapHelpers := fn(kind: String, calls: Set<String>, needCopy: Bool, needPrint: Bool): Unit {
    kKind := frontend.mapKeyKind(kind);
    vKind := frontend.mapValueKind(kind);
    mTag := frontend.cMapTag(kind);
    kTag := frontend.cMapKeyTag(kKind);
    kType := cScalarType(kKind);
    vType := cScalarType(vKind);
    kEq := if kTag == "str" { "lt_text_eq(a, b)" }
    else if kTag == "f8" { "lt_f8_to_f64(a) == lt_f8_to_f64(b)" }
    else if kTag == "f16" { "lt_f16_to_f64(a) == lt_f16_to_f64(b)" }
    else { "a == b" };
    vOps := cKindOps(vKind);
    valNeedsDrop := vOps.dropFn =!= "";
    vCopy := if vOps.copyFn =!= "" { vOps.copyFn + "(v)" } else { "v" };
    hasFrom := usesIntHelper(calls, mTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, mTag + "_copy(");
    hasSet := usesIntHelper(calls, mTag + "_set(");
    hasHas := usesIntHelper(calls, mTag + "_has(");
    hasAt := usesIntHelper(calls, mTag + "_at(");
    hasGet := usesIntHelper(calls, mTag + "_get(");
    hasGetOr := usesIntHelper(calls, mTag + "_get_or(");
    hasRemove := usesIntHelper(calls, mTag + "_remove(");
    hasClear := usesIntHelper(calls, mTag + "_clear(");
    hasKeys := usesIntHelper(calls, mTag + "_keys(");
    hasValues := usesIntHelper(calls, mTag + "_values(");
    outLine("typedef struct { " + kType + " key; " + vType + " val; } " + mTag + "_entry;");
    outLine("typedef struct { void *blk; uint32_t len; uint32_t used; uint32_t cap; uint32_t idx_cap; } " + mTag + ";");
    outLine("#if UINTPTR_MAX > 0xffffffffu");
    outLine("_Static_assert(sizeof(" + mTag + ") == 24, \"lt_map must be 24 bytes\");");
    outLine("#endif");
    outLine("LT_INLINE size_t " + mTag + "_idx_off(uint32_t cap) { return ((size_t)cap * sizeof(" + mTag + "_entry) + 3u) & ~(size_t)3u; }");
    outLine("LT_INLINE size_t " + mTag + "_dead_off(uint32_t cap, uint32_t idx_cap) { return " + mTag + "_idx_off(cap) + (size_t)idx_cap * sizeof(int32_t); }");
    outLine("LT_INLINE size_t " + mTag + "_blk_bytes(uint32_t cap, uint32_t idx_cap) { return " + mTag + "_dead_off(cap, idx_cap) + (((size_t)cap + 7u) >> 3); }");
    outLine("LT_INLINE " + mTag + "_entry *" + mTag + "_data(" + mTag + " m) { return (" + mTag + "_entry *)m.blk; }");
    outLine("LT_INLINE int32_t *" + mTag + "_idx(" + mTag + " m) { return (int32_t *)((char *)m.blk + " + mTag + "_idx_off(m.cap)); }");
    outLine("LT_INLINE uint8_t *" + mTag + "_dead(" + mTag + " m) { return (uint8_t *)((char *)m.blk + " + mTag + "_dead_off(m.cap, m.idx_cap)); }");
    outLine("LT_INLINE bool " + mTag + "_is_dead(" + mTag + " m, uint32_t i) { return (m.len != m.used) && (((" + mTag + "_dead(m)[i >> 3] >> (i & 7u)) & 1u) != 0u); }");
    outLine("LT_INLINE void " + mTag + "_drop(" + mTag + " *m) {");
    outLine("    if (m->blk != NULL) {");
    if valNeedsDrop {
        outLine("        " + mTag + "_entry *d = " + mTag + "_data(*m);");
        outLine("        for (uint32_t i = 0u; i < m->used; i += 1u) { if (!" + mTag + "_is_dead(*m, i)) { " + vOps.dropFn + "(&d[i].val); } }");
    }
    outLine("        lt_heap_free(m->blk);");
    outLine("        m->blk = NULL; m->len = 0u; m->used = 0u; m->cap = 0u; m->idx_cap = 0u;");
    outLine("    }");
    outLine("}");
    outLine("LT_INLINE " + mTag + " " + mTag + "_move(" + mTag + " *m) { " + mTag + " r = *m; m->blk = NULL; m->len = 0u; m->used = 0u; m->cap = 0u; m->idx_cap = 0u; return r; }");
    needFind := hasFrom or hasSet or hasHas or hasAt or hasGet or hasGetOr or hasRemove;
    needMut := hasFrom or hasSet or hasRemove or hasCopy;
    if needFind or hasCopy {
        outLine("static uint64_t " + mTag + "_hash(" + kType + " k) {");
        if kTag == "str" {
            outLine("    return lt_text_hash(k);");
        } else {
            if kTag == "f64" or kTag == "f16" {
                dExpr := if kTag == "f16" { "lt_f16_to_f64(k)" } else { "k" };
                outLine("    double d = " + dExpr + "; double c = (d == 0.0) ? 0.0 : d; uint64_t x = 0; memcpy(&x, &c, sizeof(x));");
            } else if kTag == "f32" {
                outLine("    float c = (k == 0.0f) ? 0.0f : k; uint32_t b = 0; memcpy(&b, &c, sizeof(b)); uint64_t x = (uint64_t)b;");
            } else if kTag == "f8" {
                outLine("    uint64_t x = (k == 0x80u) ? UINT64_C(0) : (uint64_t)k;");
            } else {
                outLine("    uint64_t x = (uint64_t)k;");
            }
            outLine("    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);");
            outLine("    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);");
            outLine("    return x ^ (x >> 31);");
        }
        outLine("}");
    }
    if needFind {
        outLine("static bool " + mTag + "_keq(" + kType + " a, " + kType + " b) { return " + kEq + "; }");
        outLine("static int64_t " + mTag + "_find(" + mTag + " m, " + kType + " k) {");
        outLine("    if (m.len == 0u || m.blk == NULL) { return -1; }");
        outLine("    " + mTag + "_entry *d = " + mTag + "_data(m);");
        outLine("    int32_t *idx = " + mTag + "_idx(m);");
        outLine("    uint64_t mask = (uint64_t)(m.idx_cap - 1u);");
        outLine("    uint64_t pos = " + mTag + "_hash(k) & mask;");
        outLine("    for (;;) {");
        outLine("        int32_t slot = idx[pos];");
        outLine("        if (slot == 0) { return -1; }");
        outLine("        if (slot > 0 && " + mTag + "_keq(d[slot - 1].key, k)) { return (int64_t)(slot - 1); }");
        outLine("        pos = (pos + 1u) & mask;");
        outLine("    }");
        outLine("}");
    }
    if needMut {
        outLine("static void " + mTag + "_rehash(" + mTag + " *m, uint32_t next_cap, uint32_t next_ic) {");
        outLine("    if (next_cap < 8u) { next_cap = 8u; }");
        outLine("    if (next_ic < 16u) { next_ic = 16u; }");
        outLine("    size_t nb = " + mTag + "_blk_bytes(next_cap, next_ic);");
        outLine("    void *nblk = lt_heap_alloc(nb);");
        outLine("    " + mTag + "_entry *ndata = (" + mTag + "_entry *)nblk;");
        outLine("    " + mTag + "_entry *odata = " + mTag + "_data(*m);");
        outLine("    uint32_t w = 0u;");
        outLine("    for (uint32_t i = 0u; i < m->used; i += 1u) {");
        outLine("        if (!" + mTag + "_is_dead(*m, i)) { ndata[w] = odata[i]; w += 1u; }");
        outLine("    }");
        outLine("    int32_t *nidx = (int32_t *)((char *)nblk + " + mTag + "_idx_off(next_cap));");
        outLine("    memset(nidx, 0, nb - " + mTag + "_idx_off(next_cap));");
        outLine("    uint64_t mask = (uint64_t)(next_ic - 1u);");
        outLine("    for (uint32_t i = 0u; i < w; i += 1u) {");
        outLine("        uint64_t pos = " + mTag + "_hash(ndata[i].key) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = (int32_t)(i + 1u);");
        outLine("    }");
        outLine("    if (m->blk != NULL) { lt_heap_free(m->blk); }");
        outLine("    m->blk = nblk; m->used = w; m->cap = next_cap; m->idx_cap = next_ic;");
        outLine("}");
    }
    if hasFrom or hasSet {
        outLine("static void " + mTag + "_set(" + mTag + " *m, " + kType + " k, " + vType + " v) {");
        outLine("    int64_t idx = " + mTag + "_find(*m, k);");
        outLine("    if (idx >= 0) {");
        outLine("        " + mTag + "_entry *d = " + mTag + "_data(*m);");
        if valNeedsDrop {
            outLine("        " + vOps.dropFn + "(&d[idx].val);");
        }
        outLine("        d[idx].val = v; return;");
        outLine("    }");
        outLine("    if (m->blk == NULL || m->used >= m->cap || m->used * 2u >= m->idx_cap) {");
        outLine("        uint32_t ncap = m->cap == 0u ? 8u : ((m->len * 2u <= m->cap && m->used >= m->cap) ? m->cap : m->cap * 2u);");
        outLine("        uint32_t nic = m->idx_cap > 0u ? m->idx_cap : 16u;");
        outLine("        while (nic < ncap * 2u) { nic *= 2u; }");
        outLine("        " + mTag + "_rehash(m, ncap, nic);");
        outLine("    }");
        outLine("    " + mTag + "_entry *d = " + mTag + "_data(*m);");
        outLine("    int32_t *hidx = " + mTag + "_idx(*m);");
        outLine("    uint32_t entry_idx = m->used;");
        outLine("    d[entry_idx].key = k; d[entry_idx].val = v;");
        outLine("    m->used += 1u; m->len += 1u;");
        outLine("    uint64_t mask = (uint64_t)(m->idx_cap - 1u);");
        outLine("    uint64_t pos = " + mTag + "_hash(k) & mask;");
        outLine("    while (hidx[pos] > 0) { pos = (pos + 1u) & mask; }");
        outLine("    hidx[pos] = (int32_t)(entry_idx + 1u);");
        outLine("}");
    }
    if hasFrom {
        outLine("static " + mTag + " " + mTag + "_from(int64_t count, const " + mTag + "_entry *elems) {");
        outLine("    " + mTag + " out = { NULL, 0u, 0u, 0u, 0u };");
        outLine("    if (count > 0) {");
        outLine("        uint32_t c = 8u; while ((int64_t)c < count) { c *= 2u; }");
        outLine("        uint32_t ic = c * 2u; if (ic < 16u) { ic = 16u; }");
        outLine("        " + mTag + "_rehash(&out, c, ic);");
        outLine("        for (int64_t i = 0; i < count; i += 1) { " + mTag + "_set(&out, elems[i].key, elems[i].val); }");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if hasCopy {
        outLine("LT_INLINE " + mTag + " " + mTag + "_copy(" + mTag + " src) {");
        outLine("    if (src.len == 0u || src.blk == NULL) { return (" + mTag + "){ NULL, 0u, 0u, 0u, 0u }; }");
        outLine("    uint32_t ncap = src.len < 8u ? 8u : src.len;");
        outLine("    uint32_t nic = 16u; while (nic < ncap * 2u) { nic *= 2u; }");
        outLine("    size_t nb = " + mTag + "_blk_bytes(ncap, nic);");
        outLine("    void *nblk = lt_heap_alloc(nb);");
        outLine("    " + mTag + "_entry *ndata = (" + mTag + "_entry *)nblk;");
        outLine("    " + mTag + "_entry *sdata = " + mTag + "_data(src);");
        outLine("    uint32_t w = 0u;");
        outLine("    for (uint32_t i = 0u; i < src.used; i += 1u) {");
        outLine("        if (" + mTag + "_is_dead(src, i)) { continue; }");
        if vCopy == "v" {
            outLine("        ndata[w] = sdata[i]; w += 1u;");
        } else {
            outLine("        " + vType + " v = sdata[i].val; ndata[w].key = sdata[i].key; ndata[w].val = " + vCopy + "; w += 1u;");
        }
        outLine("    }");
        outLine("    int32_t *nidx = (int32_t *)((char *)nblk + " + mTag + "_idx_off(ncap));");
        outLine("    memset(nidx, 0, nb - " + mTag + "_idx_off(ncap));");
        outLine("    uint64_t mask = (uint64_t)(nic - 1u);");
        outLine("    for (uint32_t i = 0u; i < w; i += 1u) {");
        outLine("        uint64_t pos = " + mTag + "_hash(ndata[i].key) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = (int32_t)(i + 1u);");
        outLine("    }");
        outLine("    return (" + mTag + "){ nblk, w, w, ncap, nic };");
        outLine("}");
    }
    if hasHas {
        outLine("static bool " + mTag + "_has(" + mTag + " m, " + kType + " k) { return " + mTag + "_find(m, k) >= 0; }");
    }
    if hasAt {
        outLine("static " + vType + " " + mTag + "_at(" + mTag + " m, " + kType + " k, size_t at) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { lt_bound_fault(at, \"map key not found\"); }");
        outLine("    " + vType + " v = " + mTag + "_data(m)[idx].val; return " + vCopy + ";");
        outLine("}");
    }
    if hasGet {
        resTag := frontend.cStructTag("(found:Bool,value:" + vKind + ")");
        outLine("static " + resTag + " " + mTag + "_get(" + mTag + " m, " + kType + " k, " + vType + " zero) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { return (" + resTag + "){ .f_found = false, .f_value = zero }; }");
        if valNeedsDrop {
            outLine("    " + vOps.dropFn + "(&zero);");
        }
        outLine("    " + vType + " v = " + mTag + "_data(m)[idx].val; return (" + resTag + "){ .f_found = true, .f_value = " + vCopy + " };");
        outLine("}");
    }
    if hasGetOr {
        outLine("static " + vType + " " + mTag + "_get_or(" + mTag + " m, " + kType + " k, " + vType + " fb) {");
        outLine("    int64_t idx = " + mTag + "_find(m, k);");
        outLine("    if (idx < 0) { return fb; }");
        if valNeedsDrop {
            outLine("    " + vOps.dropFn + "(&fb);");
        }
        outLine("    " + vType + " v = " + mTag + "_data(m)[idx].val; return " + vCopy + ";");
        outLine("}");
    }
    if hasRemove {
        outLine("static bool " + mTag + "_remove(" + mTag + " *m, " + kType + " k) {");
        outLine("    if (m->len == 0u || m->blk == NULL) { return false; }");
        outLine("    " + mTag + "_entry *d = " + mTag + "_data(*m);");
        outLine("    int32_t *hidx = " + mTag + "_idx(*m);");
        outLine("    uint64_t mask = (uint64_t)(m->idx_cap - 1u);");
        outLine("    uint64_t pos = " + mTag + "_hash(k) & mask;");
        outLine("    int64_t slot_idx = -1;");
        outLine("    for (;;) {");
        outLine("        int32_t slot = hidx[pos];");
        outLine("        if (slot == 0) { return false; }");
        outLine("        if (slot > 0 && " + mTag + "_keq(d[slot - 1].key, k)) { slot_idx = (int64_t)(slot - 1); hidx[pos] = -1; break; }");
        outLine("        pos = (pos + 1u) & mask;");
        outLine("    }");
        if valNeedsDrop {
            outLine("    " + vOps.dropFn + "(&d[slot_idx].val);");
        }
        outLine("    uint8_t *dead = " + mTag + "_dead(*m);");
        outLine("    dead[(size_t)slot_idx >> 3] |= (uint8_t)(1u << ((size_t)slot_idx & 7u));");
        outLine("    m->len -= 1u;");
        outLine("    if (m->len == 0u) {");
        outLine("        m->used = 0u;");
        outLine("        memset(hidx, 0, " + mTag + "_blk_bytes(m->cap, m->idx_cap) - " + mTag + "_idx_off(m->cap));");
        outLine("    } else if (m->used >= 16u && (m->used - m->len) * 2u >= m->used) {");
        outLine("        uint32_t ic = 16u; while (ic < m->cap * 2u) { ic *= 2u; }");
        outLine("        " + mTag + "_rehash(m, m->cap, ic);");
        outLine("    }");
        outLine("    return true;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + mTag + "_clear(" + mTag + " *m) {");
        outLine("    if (m->blk != NULL) {");
        if valNeedsDrop {
            outLine("        " + mTag + "_entry *d = " + mTag + "_data(*m);");
            outLine("        for (uint32_t i = 0u; i < m->used; i += 1u) { if (!" + mTag + "_is_dead(*m, i)) { " + vOps.dropFn + "(&d[i].val); } }");
        }
        outLine("        memset(" + mTag + "_idx(*m), 0, " + mTag + "_blk_bytes(m->cap, m->idx_cap) - " + mTag + "_idx_off(m->cap));");
        outLine("    }");
        outLine("    m->used = 0u; m->len = 0u;");
        outLine("}");
    }
    if hasKeys {
        kListType := "lt_list_" + kTag;
        outLine("static " + kListType + " " + mTag + "_keys(" + mTag + " m) {");
        outLine("    " + kListType + " out = { NULL, m.len, m.len };");
        outLine("    if (m.len > 0u) {");
        outLine("        out.data = lt_heap_alloc((size_t)m.len * sizeof(" + kType + "));");
        outLine("        " + mTag + "_entry *d = " + mTag + "_data(m);");
        outLine("        uint32_t w = 0u;");
        outLine("        for (uint32_t i = 0u; i < m.used; i += 1u) { if (!" + mTag + "_is_dead(m, i)) { out.data[w] = d[i].key; w += 1u; } }");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if hasValues {
        vListTag := frontend.cListTag(vKind);
        if vListTag =!= "" {
            vListType := "lt_list_" + vListTag;
            outLine("static " + vListType + " " + mTag + "_values(" + mTag + " m) {");
            outLine("    " + vListType + " out = { NULL, m.len, m.len };");
            outLine("    if (m.len > 0u) {");
            outLine("        out.data = lt_heap_alloc((size_t)m.len * sizeof(" + vType + "));");
            outLine("        " + mTag + "_entry *d = " + mTag + "_data(m);");
            outLine("        uint32_t w = 0u;");
            outLine("        for (uint32_t i = 0u; i < m.used; i += 1u) { if (!" + mTag + "_is_dead(m, i)) { " + vType + " v = d[i].val; out.data[w] = " + vCopy + "; w += 1u; } }");
            outLine("    }");
            outLine("    return out;");
            outLine("}");
        }
    }
    if needPrint {
        outLine("static int " + mTag + "_print(" + mTag + " m) {");
        outLine("    if (printf(\"{\") < 0) { return -1; }");
        outLine("    bool first = true;");
        outLine("    " + mTag + "_entry *d = " + mTag + "_data(m);");
        outLine("    for (uint32_t i = 0u; i < m.used; i += 1u) {");
        outLine("        if (" + mTag + "_is_dead(m, i)) { continue; }");
        outLine("        if (!first && printf(\", \") < 0) { return -1; }");
        outLine("        first = false;");
        outLine("        if (" + cCall(kKind, "d[i].key") + " < 0) { return -1; }");
        outLine("        if (printf(\": \") < 0) { return -1; }");
        outLine("        if (" + cCall(vKind, "d[i].val") + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"}\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 insertion-order-preserving `Set<T>` (24 B descriptor + single contiguous backing allocation) and helpers for `kind`. */
emitCSetHelpers := fn(kind: String, calls: Set<String>, needCopy: Bool, needPrint: Bool): Unit {
    eKind := frontend.setElementKind(kind);
    sTag := frontend.cSetTag(kind);
    kTag := frontend.cMapKeyTag(eKind);
    eType := cScalarType(eKind);
    eConstPtr := "const " + eType + " *";
    kEq := if kTag == "str" { "lt_text_eq(a, b)" }
    else if kTag == "f8" { "lt_f8_to_f64(a) == lt_f8_to_f64(b)" }
    else if kTag == "f16" { "lt_f16_to_f64(a) == lt_f16_to_f64(b)" }
    else { "a == b" };
    hasFrom := usesIntHelper(calls, sTag + "_from(");
    hasCopy := needCopy or usesIntHelper(calls, sTag + "_copy(");
    hasAdd := usesIntHelper(calls, sTag + "_add(");
    hasHas := usesIntHelper(calls, sTag + "_has(");
    hasRemove := usesIntHelper(calls, sTag + "_remove(");
    hasClear := usesIntHelper(calls, sTag + "_clear(");
    hasValues := usesIntHelper(calls, sTag + "_values(");
    outLine("typedef struct { void *blk; uint32_t len; uint32_t used; uint32_t cap; uint32_t idx_cap; } " + sTag + ";");
    outLine("#if UINTPTR_MAX > 0xffffffffu");
    outLine("_Static_assert(sizeof(" + sTag + ") == 24, \"lt_set must be 24 bytes\");");
    outLine("#endif");
    outLine("LT_INLINE size_t " + sTag + "_idx_off(uint32_t cap) { return ((size_t)cap * sizeof(" + eType + ") + 3u) & ~(size_t)3u; }");
    outLine("LT_INLINE size_t " + sTag + "_dead_off(uint32_t cap, uint32_t idx_cap) { return " + sTag + "_idx_off(cap) + (size_t)idx_cap * sizeof(int32_t); }");
    outLine("LT_INLINE size_t " + sTag + "_blk_bytes(uint32_t cap, uint32_t idx_cap) { return " + sTag + "_dead_off(cap, idx_cap) + (((size_t)cap + 7u) >> 3); }");
    outLine("LT_INLINE " + eType + " *" + sTag + "_data(" + sTag + " s) { return (" + eType + " *)s.blk; }");
    outLine("LT_INLINE int32_t *" + sTag + "_idx(" + sTag + " s) { return (int32_t *)((char *)s.blk + " + sTag + "_idx_off(s.cap)); }");
    outLine("LT_INLINE uint8_t *" + sTag + "_dead(" + sTag + " s) { return (uint8_t *)((char *)s.blk + " + sTag + "_dead_off(s.cap, s.idx_cap)); }");
    outLine("LT_INLINE bool " + sTag + "_is_dead(" + sTag + " s, uint32_t i) { return (s.len != s.used) && (((" + sTag + "_dead(s)[i >> 3] >> (i & 7u)) & 1u) != 0u); }");
    outLine("LT_INLINE void " + sTag + "_drop(" + sTag + " *s) {");
    outLine("    if (s->blk != NULL) { lt_heap_free(s->blk); s->blk = NULL; s->len = 0u; s->used = 0u; s->cap = 0u; s->idx_cap = 0u; }");
    outLine("}");
    outLine("LT_INLINE " + sTag + " " + sTag + "_move(" + sTag + " *s) { " + sTag + " r = *s; s->blk = NULL; s->len = 0u; s->used = 0u; s->cap = 0u; s->idx_cap = 0u; return r; }");
    needFind := hasFrom or hasAdd or hasHas or hasRemove;
    needMut := hasFrom or hasAdd or hasRemove or hasCopy;
    if needFind or hasCopy {
        outLine("static uint64_t " + sTag + "_hash(" + eType + " k) {");
        if kTag == "str" {
            outLine("    return lt_text_hash(k);");
        } else {
            if kTag == "f64" or kTag == "f16" {
                dExpr := if kTag == "f16" { "lt_f16_to_f64(k)" } else { "k" };
                outLine("    double d = " + dExpr + "; double c = (d == 0.0) ? 0.0 : d; uint64_t x = 0; memcpy(&x, &c, sizeof(x));");
            } else if kTag == "f32" {
                outLine("    float c = (k == 0.0f) ? 0.0f : k; uint32_t b = 0; memcpy(&b, &c, sizeof(b)); uint64_t x = (uint64_t)b;");
            } else if kTag == "f8" {
                outLine("    uint64_t x = (k == 0x80u) ? UINT64_C(0) : (uint64_t)k;");
            } else {
                outLine("    uint64_t x = (uint64_t)k;");
            }
            outLine("    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);");
            outLine("    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);");
            outLine("    return x ^ (x >> 31);");
        }
        outLine("}");
    }
    if needFind {
        outLine("static bool " + sTag + "_eq(" + eType + " a, " + eType + " b) { return " + kEq + "; }");
        outLine("static int64_t " + sTag + "_find(" + sTag + " s, " + eType + " v) {");
        outLine("    if (s.len == 0u || s.blk == NULL) { return -1; }");
        outLine("    " + eType + " *d = " + sTag + "_data(s);");
        outLine("    int32_t *idx = " + sTag + "_idx(s);");
        outLine("    uint64_t mask = (uint64_t)(s.idx_cap - 1u);");
        outLine("    uint64_t pos = " + sTag + "_hash(v) & mask;");
        outLine("    for (;;) {");
        outLine("        int32_t slot = idx[pos];");
        outLine("        if (slot == 0) { return -1; }");
        outLine("        if (slot > 0 && " + sTag + "_eq(d[slot - 1], v)) { return (int64_t)(slot - 1); }");
        outLine("        pos = (pos + 1u) & mask;");
        outLine("    }");
        outLine("}");
    }
    if needMut {
        outLine("static void " + sTag + "_rehash(" + sTag + " *s, uint32_t next_cap, uint32_t next_ic) {");
        outLine("    if (next_cap < 8u) { next_cap = 8u; }");
        outLine("    if (next_ic < 16u) { next_ic = 16u; }");
        outLine("    size_t nb = " + sTag + "_blk_bytes(next_cap, next_ic);");
        outLine("    void *nblk = lt_heap_alloc(nb);");
        outLine("    " + eType + " *ndata = (" + eType + " *)nblk;");
        outLine("    " + eType + " *odata = " + sTag + "_data(*s);");
        outLine("    uint32_t w = 0u;");
        outLine("    for (uint32_t i = 0u; i < s->used; i += 1u) {");
        outLine("        if (!" + sTag + "_is_dead(*s, i)) { ndata[w] = odata[i]; w += 1u; }");
        outLine("    }");
        outLine("    int32_t *nidx = (int32_t *)((char *)nblk + " + sTag + "_idx_off(next_cap));");
        outLine("    memset(nidx, 0, nb - " + sTag + "_idx_off(next_cap));");
        outLine("    uint64_t mask = (uint64_t)(next_ic - 1u);");
        outLine("    for (uint32_t i = 0u; i < w; i += 1u) {");
        outLine("        uint64_t pos = " + sTag + "_hash(ndata[i]) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = (int32_t)(i + 1u);");
        outLine("    }");
        outLine("    if (s->blk != NULL) { lt_heap_free(s->blk); }");
        outLine("    s->blk = nblk; s->used = w; s->cap = next_cap; s->idx_cap = next_ic;");
        outLine("}");
    }
    if hasFrom or hasAdd {
        outLine("static void " + sTag + "_add(" + sTag + " *s, " + eType + " v) {");
        outLine("    if (" + sTag + "_find(*s, v) >= 0) { return; }");
        outLine("    if (s->blk == NULL || s->used >= s->cap || s->used * 2u >= s->idx_cap) {");
        outLine("        uint32_t ncap = s->cap == 0u ? 8u : ((s->len * 2u <= s->cap && s->used >= s->cap) ? s->cap : s->cap * 2u);");
        outLine("        uint32_t nic = s->idx_cap > 0u ? s->idx_cap : 16u;");
        outLine("        while (nic < ncap * 2u) { nic *= 2u; }");
        outLine("        " + sTag + "_rehash(s, ncap, nic);");
        outLine("    }");
        outLine("    " + eType + " *d = " + sTag + "_data(*s);");
        outLine("    int32_t *hidx = " + sTag + "_idx(*s);");
        outLine("    uint32_t entry_idx = s->used;");
        outLine("    d[entry_idx] = v;");
        outLine("    s->used += 1u; s->len += 1u;");
        outLine("    uint64_t mask = (uint64_t)(s->idx_cap - 1u);");
        outLine("    uint64_t pos = " + sTag + "_hash(v) & mask;");
        outLine("    while (hidx[pos] > 0) { pos = (pos + 1u) & mask; }");
        outLine("    hidx[pos] = (int32_t)(entry_idx + 1u);");
        outLine("}");
    }
    if hasFrom {
        outLine("static " + sTag + " " + sTag + "_from(int64_t count, " + eConstPtr + "elems) {");
        outLine("    " + sTag + " out = { NULL, 0u, 0u, 0u, 0u };");
        outLine("    if (count > 0) {");
        outLine("        uint32_t c = 8u; while ((int64_t)c < count) { c *= 2u; }");
        outLine("        uint32_t ic = c * 2u; if (ic < 16u) { ic = 16u; }");
        outLine("        " + sTag + "_rehash(&out, c, ic);");
        outLine("        for (int64_t i = 0; i < count; i += 1) { " + sTag + "_add(&out, elems[i]); }");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if hasCopy {
        outLine("LT_INLINE " + sTag + " " + sTag + "_copy(" + sTag + " src) {");
        outLine("    if (src.len == 0u || src.blk == NULL) { return (" + sTag + "){ NULL, 0u, 0u, 0u, 0u }; }");
        outLine("    uint32_t ncap = src.len < 8u ? 8u : src.len;");
        outLine("    uint32_t nic = 16u; while (nic < ncap * 2u) { nic *= 2u; }");
        outLine("    size_t nb = " + sTag + "_blk_bytes(ncap, nic);");
        outLine("    void *nblk = lt_heap_alloc(nb);");
        outLine("    " + eType + " *ndata = (" + eType + " *)nblk;");
        outLine("    " + eType + " *sdata = " + sTag + "_data(src);");
        outLine("    uint32_t w = 0u;");
        outLine("    for (uint32_t i = 0u; i < src.used; i += 1u) { if (!" + sTag + "_is_dead(src, i)) { ndata[w] = sdata[i]; w += 1u; } }");
        outLine("    int32_t *nidx = (int32_t *)((char *)nblk + " + sTag + "_idx_off(ncap));");
        outLine("    memset(nidx, 0, nb - " + sTag + "_idx_off(ncap));");
        outLine("    uint64_t mask = (uint64_t)(nic - 1u);");
        outLine("    for (uint32_t i = 0u; i < w; i += 1u) {");
        outLine("        uint64_t pos = " + sTag + "_hash(ndata[i]) & mask;");
        outLine("        while (nidx[pos] != 0) { pos = (pos + 1u) & mask; }");
        outLine("        nidx[pos] = (int32_t)(i + 1u);");
        outLine("    }");
        outLine("    return (" + sTag + "){ nblk, w, w, ncap, nic };");
        outLine("}");
    }
    if hasHas {
        outLine("static bool " + sTag + "_has(" + sTag + " s, " + eType + " v) { return " + sTag + "_find(s, v) >= 0; }");
    }
    if hasRemove {
        outLine("static bool " + sTag + "_remove(" + sTag + " *s, " + eType + " v) {");
        outLine("    if (s->len == 0u || s->blk == NULL) { return false; }");
        outLine("    " + eType + " *d = " + sTag + "_data(*s);");
        outLine("    int32_t *hidx = " + sTag + "_idx(*s);");
        outLine("    uint64_t mask = (uint64_t)(s->idx_cap - 1u);");
        outLine("    uint64_t pos = " + sTag + "_hash(v) & mask;");
        outLine("    int64_t slot_idx = -1;");
        outLine("    for (;;) {");
        outLine("        int32_t slot = hidx[pos];");
        outLine("        if (slot == 0) { return false; }");
        outLine("        if (slot > 0 && " + sTag + "_eq(d[slot - 1], v)) { slot_idx = (int64_t)(slot - 1); hidx[pos] = -1; break; }");
        outLine("        pos = (pos + 1u) & mask;");
        outLine("    }");
        outLine("    uint8_t *dead = " + sTag + "_dead(*s);");
        outLine("    dead[(size_t)slot_idx >> 3] |= (uint8_t)(1u << ((size_t)slot_idx & 7u));");
        outLine("    s->len -= 1u;");
        outLine("    if (s->len == 0u) {");
        outLine("        s->used = 0u;");
        outLine("        memset(hidx, 0, " + sTag + "_blk_bytes(s->cap, s->idx_cap) - " + sTag + "_idx_off(s->cap));");
        outLine("    } else if (s->used >= 16u && (s->used - s->len) * 2u >= s->used) {");
        outLine("        uint32_t ic = 16u; while (ic < s->cap * 2u) { ic *= 2u; }");
        outLine("        " + sTag + "_rehash(s, s->cap, ic);");
        outLine("    }");
        outLine("    return true;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + sTag + "_clear(" + sTag + " *s) {");
        outLine("    if (s->blk != NULL) { memset(" + sTag + "_idx(*s), 0, " + sTag + "_blk_bytes(s->cap, s->idx_cap) - " + sTag + "_idx_off(s->cap)); }");
        outLine("    s->used = 0u; s->len = 0u;");
        outLine("}");
    }
    if hasValues {
        vListType := "lt_list_" + kTag;
        outLine("static " + vListType + " " + sTag + "_values(" + sTag + " s) {");
        outLine("    " + vListType + " out = { NULL, s.len, s.len };");
        outLine("    if (s.len > 0u) {");
        outLine("        out.data = lt_heap_alloc((size_t)s.len * sizeof(" + eType + "));");
        outLine("        " + eType + " *d = " + sTag + "_data(s);");
        outLine("        uint32_t w = 0u;");
        outLine("        for (uint32_t i = 0u; i < s.used; i += 1u) { if (!" + sTag + "_is_dead(s, i)) { out.data[w] = d[i]; w += 1u; } }");
        outLine("    }");
        outLine("    return out;");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + sTag + "_print(" + sTag + " s) {");
        outLine("    if (printf(\"{\") < 0) { return -1; }");
        outLine("    bool first = true;");
        outLine("    " + eType + " *d = " + sTag + "_data(s);");
        outLine("    for (uint32_t i = 0u; i < s.used; i += 1u) {");
        outLine("        if (" + sTag + "_is_dead(s, i)) { continue; }");
        outLine("        if (!first && printf(\", \") < 0) { return -1; }");
        outLine("        first = false;");
        outLine("        if (" + cCall(eKind, "d[i]") + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"}\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 pointer-sized `Rc<T>` reference-counted box wrapper and operations for `kind`. */
emitCRcHelpers := fn(kind: String, calls: Set<String>, needCopy: Bool, needPrint: Bool): Unit {
    eKind := frontend.rcElementKind(kind);
    rTag := frontend.cRcTag(kind);
    eType := cScalarType(eKind);
    ops := cKindOps(eKind);
    hasNew := usesIntHelper(calls, rTag + "_new(");
    hasCopy := needCopy or usesIntHelper(calls, rTag + "_copy(");
    hasGet := usesIntHelper(calls, rTag + "_get(");
    hasCount := usesIntHelper(calls, rTag + "_count(");
    hasUnique := usesIntHelper(calls, rTag + "_make_unique(");
    hasReplace := usesIntHelper(calls, rTag + "_replace(");
    outLine("typedef struct { void *box; } " + rTag + ";");
    outLine("#if UINTPTR_MAX > 0xffffffffu");
    outLine("_Static_assert(sizeof(" + rTag + ") == 8, \"lt_rc must be 8 bytes\");");
    outLine("#endif");
    outLine("LT_INLINE void " + rTag + "_drop(" + rTag + " *r) {");
    outLine("    if (r->box != NULL) {");
    outLine("        if (lt_box_dec(r->box)) {");
    if ops.dropFn =!= "" {
        outLine("            " + ops.dropFn + "((" + eType + " *)r->box);");
    }
    outLine("            lt_box_free_raw(r->box);");
    outLine("        }");
    outLine("        r->box = NULL;");
    outLine("    }");
    outLine("}");
    outLine("LT_INLINE " + rTag + " " + rTag + "_move(" + rTag + " *r) { " + rTag + " out = *r; r->box = NULL; return out; }");
    if hasNew or hasUnique or hasReplace {
        outLine("LT_INLINE " + rTag + " " + rTag + "_new(" + eType + " v) {");
        outLine("    " + eType + " *p = (" + eType + " *)lt_box_alloc(sizeof(" + eType + "));");
        outLine("    *p = v;");
        outLine("    return (" + rTag + "){ .box = p };");
        outLine("}");
    }
    if hasCopy {
        outLine("LT_INLINE " + rTag + " " + rTag + "_copy(" + rTag + " r) {");
        outLine("    return (" + rTag + "){ .box = lt_box_retain(r.box) };");
        outLine("}");
    }
    if hasCount {
        outLine("LT_INLINE int64_t " + rTag + "_count(" + rTag + " r) {");
        outLine("    if (r.box == NULL) { return 0; }");
        outLine("    return ((const lt_box_hdr *)((const char *)r.box - sizeof(lt_box_hdr)))->rc;");
        outLine("}");
    }
    if hasGet {
        outLine("LT_INLINE " + eType + " " + rTag + "_get(" + rTag + " r) {");
        outLine("    if (r.box == NULL) { fprintf(stderr, \"NullPointerPanic: Rc.get on empty Rc\\n\"); exit(1); }");
        if ops.copyFn =!= "" {
            outLine("    return " + ops.copyFn + "(*((const " + eType + " *)r.box));");
        } else {
            outLine("    return *((const " + eType + " *)r.box);");
        }
        outLine("}");
    }
    if hasUnique {
        outLine("LT_INLINE void " + rTag + "_make_unique(" + rTag + " *r) {");
        outLine("    if (r->box == NULL) { return; }");
        outLine("    lt_box_hdr *h = (lt_box_hdr *)((char *)r->box - sizeof(lt_box_hdr));");
        outLine("    if (h->rc <= 1) { return; }");
        if ops.copyFn =!= "" {
            outLine("    " + eType + " copy = " + ops.copyFn + "(*((const " + eType + " *)r->box));");
        } else {
            outLine("    " + eType + " copy = *((const " + eType + " *)r->box);");
        }
        outLine("    h->rc -= 1;");
        outLine("    r->box = " + rTag + "_new(copy).box;");
        outLine("}");
    }
    if hasReplace {
        outLine("LT_INLINE void " + rTag + "_replace(" + rTag + " *r, " + eType + " v) {");
        outLine("    if (r->box == NULL) { r->box = " + rTag + "_new(v).box; return; }");
        outLine("    lt_box_hdr *h = (lt_box_hdr *)((char *)r->box - sizeof(lt_box_hdr));");
        outLine("    if (h->rc <= 1) {");
        if ops.dropFn =!= "" {
            outLine("        " + ops.dropFn + "((" + eType + " *)r->box);");
        }
        outLine("        *((" + eType + " *)r->box) = v;");
        outLine("        return;");
        outLine("    }");
        outLine("    h->rc -= 1;");
        outLine("    r->box = " + rTag + "_new(v).box;");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + rTag + "_print(" + rTag + " r) {");
        outLine("    if (r.box == NULL) { return printf(\"Rc(empty)\"); }");
        outLine("    if (printf(\"Rc(\") < 0) { return -1; }");
        outLine("    if (" + cCall(eKind, "*((const " + eType + " *)r.box)") + " < 0) { return -1; }");
        outLine("    return printf(\")\");");
        outLine("}");
    }
};

/** Emits portable ISO C11 typedef and on-demand non-split helpers for borrowed `Slice<T>`. */
emitCSliceHelpers := fn(kind: String, calls: Set<String>, needPrint: Bool, config: optCfg.OptConfig): Unit {
    eKind := frontend.sliceElementKind(kind);
    vTag := frontend.cSliceTag(kind);
    lTag := cListTagForKind("List<" + eKind + ">");
    cType := cScalarType(eKind);
    ops := cKindOps(eKind);
    elemNeedsDeepCopy := ops.copyFn =!= "";
    elemNeedsDrop := ops.dropFn =!= "";
    hasFromList := usesIntHelper(calls, vTag + "_from_list(");
    hasFromRaw := usesIntHelper(calls, vTag + "_from_raw(");
    hasSub := usesIntHelper(calls, vTag + "_sub(");
    hasAt := usesIntHelper(calls, vTag + "_at(");
    hasAtR := usesIntHelper(calls, vTag + "_at_r(");
    hasUat := usesIntHelper(calls, vTag + "_uat(");
    hasUatR := usesIntHelper(calls, vTag + "_uat_r(");
    hasSet := usesIntHelper(calls, vTag + "_set(");
    hasSetR := usesIntHelper(calls, vTag + "_set_r(");
    hasUset := usesIntHelper(calls, vTag + "_uset(");
    hasUsetR := usesIntHelper(calls, vTag + "_uset_r(");
    hasToList := usesIntHelper(calls, vTag + "_to_list(");
    outLine("typedef struct { " + cType + " *data; int64_t len; } " + vTag + ";");
    if hasFromList and lTag =!= "" {
        lType := "lt_list_" + lTag;
        outLine("LT_INLINE " + vTag + " " + vTag + "_from_list(const " + lType + " *xs, int64_t start, int64_t end, bool has_end, size_t at) {");
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    int64_t e = has_end ? end : n;");
        outLine("    if (LT_UNLIKELY(start < 0 || e < start || e > n)) { lt_bound_fault(at, \"slice bounds outside its extent\"); }");
        outLine("    int64_t len = e - start;");
        outLine("    if (len == 0) { return (" + vTag + "){ .data = NULL, .len = 0 }; }");
        outLine("    return (" + vTag + "){ .data = xs->data + start, .len = len };");
        outLine("}");
    }
    if hasFromRaw {
        outLine("LT_INLINE " + vTag + " " + vTag + "_from_raw(" + cType + " *ptr, int64_t n, int64_t start, int64_t end, bool has_end, size_t at) {");
        outLine("    int64_t e = has_end ? end : n;");
        outLine("    if (LT_UNLIKELY(start < 0 || e < start || e > n)) { lt_bound_fault(at, \"slice bounds outside its extent\"); }");
        outLine("    int64_t len = e - start;");
        outLine("    if (len == 0) { return (" + vTag + "){ .data = NULL, .len = 0 }; }");
        outLine("    return (" + vTag + "){ .data = ptr + start, .len = len };");
        outLine("}");
    }
    if hasSub {
        outLine("LT_INLINE " + vTag + " " + vTag + "_sub(" + vTag + " s, int64_t start, int64_t end, bool has_end, size_t at) {");
        outLine("    int64_t e = has_end ? end : s.len;");
        outLine("    if (LT_UNLIKELY(start < 0 || e < start || e > s.len)) { lt_bound_fault(at, \"slice bounds outside its extent\"); }");
        outLine("    int64_t len = e - start;");
        outLine("    if (len == 0) { return (" + vTag + "){ .data = NULL, .len = 0 }; }");
        outLine("    return (" + vTag + "){ .data = s.data + start, .len = len };");
        outLine("}");
    }
    if hasAt {
        outLine("static " + cType + " " + vTag + "_at(" + vTag + " s, int64_t idx, size_t at) {");
        if config.checkBounds {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= s.len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + ops.copyFn + "(s.data[idx]);");
        } else {
            outLine("    return s.data[idx];");
        }
        outLine("}");
    }
    if hasUat {
        outLine("LT_INLINE " + cType + " " + vTag + "_uat(" + vTag + " s, int64_t idx, size_t at) {");
        if config.checkUnchecked {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= s.len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + ops.copyFn + "(s.data[idx]);");
        } else {
            outLine("    return s.data[idx];");
        }
        outLine("}");
    }
    if hasSet {
        outLine("static void " + vTag + "_set(" + vTag + " s, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkBounds {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= s.len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + ops.dropFn + "(&s.data[idx]);");
        }
        outLine("    s.data[idx] = val;");
        outLine("}");
    }
    if hasUset {
        outLine("LT_INLINE void " + vTag + "_uset(" + vTag + " s, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkUnchecked {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= s.len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + ops.dropFn + "(&s.data[idx]);");
        }
        outLine("    s.data[idx] = val;");
        outLine("}");
    }
    if hasAtR {
        outLine("LT_INLINE " + cType + " " + vTag + "_at_r(const " + cType + " * restrict data, int64_t len, int64_t idx, size_t at) {");
        if config.checkBounds {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)len; (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + ops.copyFn + "(data[idx]);");
        } else {
            outLine("    return data[idx];");
        }
        outLine("}");
    }
    if hasUatR {
        outLine("LT_INLINE " + cType + " " + vTag + "_uat_r(const " + cType + " * restrict data, int64_t len, int64_t idx, size_t at) {");
        if config.checkUnchecked {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)len; (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + ops.copyFn + "(data[idx]);");
        } else {
            outLine("    return data[idx];");
        }
        outLine("}");
    }
    if hasSetR {
        outLine("LT_INLINE void " + vTag + "_set_r(" + cType + " * restrict data, int64_t len, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkBounds {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)len; (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + ops.dropFn + "(&data[idx]);");
        }
        outLine("    data[idx] = val;");
        outLine("}");
    }
    if hasUsetR {
        outLine("LT_INLINE void " + vTag + "_uset_r(" + cType + " * restrict data, int64_t len, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkUnchecked {
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= len)) { lt_bound_fault(at, \"slice index outside its extent\"); }");
        } else {
            outLine("    (void)len; (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + ops.dropFn + "(&data[idx]);");
        }
        outLine("    data[idx] = val;");
        outLine("}");
    }
    if hasToList and lTag =!= "" {
        lType := "lt_list_" + lTag;
        outLine("LT_INLINE " + lType + " " + vTag + "_to_list(" + vTag + " s) {");
        outLine("    if (s.len <= 0 || s.data == NULL) { return (" + lType + "){ NULL, 0u, 0u }; }");
        outLine("    " + lType + " out = " + lType + "_from(s.len, s.data);");
        if elemNeedsDeepCopy {
            outLine("    for (int64_t i = 0; i < s.len; i += 1) { out.data[i] = " + ops.copyFn + "(out.data[i]); }");
        }
        outLine("    return out;");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + vTag + "_print(" + vTag + " s) {");
        outLine("    if (putchar('[') == EOF) { return -1; }");
        outLine("    for (int64_t i = 0; i < s.len; i += 1) {");
        outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        outLine("        if (" + cCall(eKind, "s.data[i]") + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return putchar(']') == EOF ? -1 : 0;");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 16 B `rc`-free list struct and helpers for `tag`. */
emitCListTagHelpers := fn(tag: String, elemKind: String, calls: Set<String>, needCopy: Bool, needPrint: Bool, needFrom: Bool, config: optCfg.OptConfig): Unit {
    cType := frontend.cListElemType(tag);
    cElemConstPtr := "const " + cType + " *";
    lType := "lt_list_" + tag;
    elOps := if elemKind =!= "" { cKindOps(elemKind) } else { (cType = cType, dropFn = "", copyFn = "", moveFn = "") };
    elemNeedsDrop := elOps.dropFn =!= "";
    elemNeedsDeepCopy := elOps.copyFn =!= "";
    hasFrom := needFrom or usesIntHelper(calls, lType + "_from(");
    hasRepeat := usesIntHelper(calls, lType + "_repeat(");
    hasCopy := needCopy or usesIntHelper(calls, lType + "_copy(");
    hasAt := usesIntHelper(calls, lType + "_at(");
    hasUat := usesIntHelper(calls, lType + "_uat(");
    hasSet := usesIntHelper(calls, lType + "_set(");
    hasUset := usesIntHelper(calls, lType + "_uset(");
    hasPushBack := usesIntHelper(calls, lType + "_push_back(");
    hasPushFront := usesIntHelper(calls, lType + "_push_front(");
    hasPopBack := usesIntHelper(calls, lType + "_pop_back(");
    hasPopFront := usesIntHelper(calls, lType + "_pop_front(");
    hasSliceFrom := usesIntHelper(calls, lType + "_slice_from(");
    hasSlice := usesIntHelper(calls, lType + "_slice(") or hasSliceFrom;
    hasReverse := usesIntHelper(calls, lType + "_reverse(");
    hasClear := usesIntHelper(calls, lType + "_clear(");
    outLine("typedef struct { " + cType + " *data; uint32_t len; uint32_t cap; } " + lType + ";");
    outLine("#if UINTPTR_MAX > 0xffffffffu");
    outLine("_Static_assert(sizeof(" + lType + ") == 16, \"lt_list must be 16 bytes\");");
    outLine("#endif");
    outLine("LT_INLINE int64_t " + lType + "_len(" + lType + " xs) {");
    outLine("    if (LT_UNLIKELY(xs.len == UINT32_MAX)) { return (int64_t)((const lt_list_jumbo_hdr *)xs.data)[-1].len; }");
    outLine("    return (int64_t)xs.len;");
    outLine("}");
    outLine("LT_INLINE int64_t " + lType + "_cap(" + lType + " xs) {");
    outLine("    if (LT_UNLIKELY(xs.cap == UINT32_MAX)) { return (int64_t)((const lt_list_jumbo_hdr *)xs.data)[-1].cap; }");
    outLine("    return (int64_t)(xs.cap & UINT32_C(0x7FFFFFFF));");
    outLine("}");
    outLine("LT_INLINE bool " + lType + "_is_scope(" + lType + " xs) { return xs.cap != UINT32_MAX && (xs.cap & LT_LIST_SCOPE_BIT) != 0u; }");
    outLine("LT_INLINE void " + lType + "_drop(" + lType + " *xs) {");
    if elemNeedsDrop {
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    if (xs->data != NULL) { for (int64_t i = 0; i < n; i += 1) { " + elOps.dropFn + "(&xs->data[i]); } }");
    }
    outLine("    if (xs->data != NULL && !" + lType + "_is_scope(*xs)) {");
    outLine("        if (LT_UNLIKELY(xs->cap == UINT32_MAX)) { lt_heap_free((char *)xs->data - sizeof(lt_list_jumbo_hdr)); }");
    outLine("        else { lt_heap_free(xs->data); }");
    outLine("    }");
    outLine("    xs->data = NULL; xs->len = 0u; xs->cap = 0u;");
    outLine("}");
    outLine("LT_INLINE " + lType + " " + lType + "_move(" + lType + " *xs) { " + lType + " r = *xs; xs->data = NULL; xs->len = 0u; xs->cap = 0u; return r; }");
    outLine("LT_INLINE " + lType + " " + lType + "_init_scope(void) { return (" + lType + "){ NULL, 0u, LT_LIST_SCOPE_BIT }; }");
    outLine("LT_INLINE " + lType + " " + lType + "_from_scope(int64_t count, " + cElemConstPtr + "elems) {");
    outLine("    if (count <= 0) { return (" + lType + "){ NULL, 0u, LT_LIST_SCOPE_BIT }; }");
    outLine("    " + cType + " *d = lt_vm_arena_alloc(&lt_tl_ctx.scope, _Alignof(" + cType + ") > 8u ? _Alignof(" + cType + ") : 8u, (size_t)count * sizeof(" + cType + "));");
    outLine("    memcpy(d, elems, (size_t)count * sizeof(" + cType + "));");
    outLine("    return (" + lType + "){ d, (uint32_t)count, LT_LIST_SCOPE_BIT | (uint32_t)count };");
    outLine("}");
    if hasFrom or hasCopy or hasSlice or hasReverse {
        outLine("LT_INLINE " + lType + " " + lType + "_from(int64_t count, " + cElemConstPtr + "elems) {");
        outLine("    if (count <= 0) { return (" + lType + "){ NULL, 0u, 0u }; }");
        outLine("    if (LT_UNLIKELY(count >= (int64_t)0x7FFFFFFF)) {");
        outLine("        char *blk = lt_heap_alloc(sizeof(lt_list_jumbo_hdr) + (size_t)count * sizeof(" + cType + "));");
        outLine("        lt_list_jumbo_hdr *h = (lt_list_jumbo_hdr *)blk;");
        outLine("        h->len = (uint64_t)count; h->cap = (uint64_t)count;");
        outLine("        " + cType + " *d = (" + cType + " *)(blk + sizeof(lt_list_jumbo_hdr));");
        outLine("        memcpy(d, elems, (size_t)count * sizeof(" + cType + "));");
        outLine("        return (" + lType + "){ d, UINT32_MAX, UINT32_MAX };");
        outLine("    }");
        outLine("    " + cType + " *d = lt_heap_alloc((size_t)count * sizeof(" + cType + "));");
        outLine("    memcpy(d, elems, (size_t)count * sizeof(" + cType + "));");
        outLine("    return (" + lType + "){ d, (uint32_t)count, (uint32_t)count };");
        outLine("}");
    }
    if hasRepeat {
        outLine("static " + lType + " " + lType + "_repeat(int64_t count, " + cType + " val) {");
        outLine("    if (count <= 0) { return (" + lType + "){ NULL, 0u, 0u }; }");
        outLine("    " + cType + " *d = lt_heap_alloc((size_t)count * sizeof(" + cType + "));");
        if elemNeedsDeepCopy {
            outLine("    for (int64_t i = 0; i < count; i += 1) { d[i] = " + elOps.copyFn + "(val); }");
            outLine("    " + elOps.dropFn + "(&val);");
        } else {
            outLine("    for (int64_t i = 0; i < count; i += 1) { d[i] = val; }");
        }
        outLine("    return (" + lType + "){ d, (uint32_t)count, (uint32_t)count };");
        outLine("}");
    }
    if hasCopy {
        outLine("LT_INLINE " + lType + " " + lType + "_copy(" + lType + " src) {");
        outLine("    int64_t n = " + lType + "_len(src);");
        outLine("    if (n <= 0) { return (" + lType + "){ NULL, 0u, 0u }; }");
        outLine("    " + lType + " out = " + lType + "_from(n, src.data);");
        if elemNeedsDeepCopy {
            outLine("    for (int64_t i = 0; i < n; i += 1) { out.data[i] = " + elOps.copyFn + "(out.data[i]); }");
        }
        outLine("    return out;");
        outLine("}");
    }
    if hasAt {
        outLine("static " + cType + " " + lType + "_at(" + lType + " xs, int64_t idx, size_t at) {");
        if config.checkBounds {
            outLine("    int64_t n = " + lType + "_len(xs);");
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= n)) { lt_bound_fault(at, \"list index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + elOps.copyFn + "(xs.data[idx]);");
        } else {
            outLine("    return xs.data[idx];");
        }
        outLine("}");
    }
    if hasUat {
        outLine("LT_INLINE " + cType + " " + lType + "_uat(" + lType + " xs, int64_t idx, size_t at) {");
        if config.checkUnchecked {
            outLine("    int64_t n = " + lType + "_len(xs);");
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= n)) { lt_bound_fault(at, \"list index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDeepCopy {
            outLine("    return " + elOps.copyFn + "(xs.data[idx]);");
        } else {
            outLine("    return xs.data[idx];");
        }
        outLine("}");
    }
    if hasSet {
        outLine("static void " + lType + "_set(" + lType + " *xs, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkBounds {
            outLine("    int64_t n = " + lType + "_len(*xs);");
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= n)) { lt_bound_fault(at, \"list index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + elOps.dropFn + "(&xs->data[idx]);");
        }
        outLine("    xs->data[idx] = val;");
        outLine("}");
    }
    if hasUset {
        outLine("LT_INLINE void " + lType + "_uset(" + lType + " *xs, int64_t idx, " + cType + " val, size_t at) {");
        if config.checkUnchecked {
            outLine("    int64_t n = " + lType + "_len(*xs);");
            outLine("    if (LT_UNLIKELY(idx < 0 || idx >= n)) { lt_bound_fault(at, \"list index outside its extent\"); }");
        } else {
            outLine("    (void)at;");
        }
        if elemNeedsDrop {
            outLine("    " + elOps.dropFn + "(&xs->data[idx]);");
        }
        outLine("    xs->data[idx] = val;");
        outLine("}");
    }
    if hasPushBack or hasPushFront {
        outLine("static void " + lType + "_grow(" + lType + " *xs, int64_t need) {");
        outLine("    int64_t cap = " + lType + "_cap(*xs);");
        outLine("    if (cap >= need) { return; }");
        outLine("    int64_t next = cap > 0 ? cap * 2 : 8;");
        outLine("    while (next < need) { next *= 2; }");
        outLine("    if (" + lType + "_is_scope(*xs) && next < (int64_t)0x7FFFFFFF) {");
        outLine("        " + cType + " *nb = lt_vm_arena_alloc(&lt_tl_ctx.scope, _Alignof(" + cType + ") > 8u ? _Alignof(" + cType + ") : 8u, (size_t)next * sizeof(" + cType + "));");
        outLine("        int64_t cur_len = " + lType + "_len(*xs);");
        outLine("        if (cur_len > 0 && xs->data != NULL) { memcpy(nb, xs->data, (size_t)cur_len * sizeof(" + cType + ")); }");
        outLine("        xs->data = nb; xs->cap = LT_LIST_SCOPE_BIT | (uint32_t)next;");
        outLine("        return;");
        outLine("    }");
        outLine("    if (LT_UNLIKELY(next >= (int64_t)0x7FFFFFFF)) {");
        outLine("        int64_t cur_len = " + lType + "_len(*xs);");
        outLine("        char *blk = lt_heap_alloc(sizeof(lt_list_jumbo_hdr) + (size_t)next * sizeof(" + cType + "));");
        outLine("        lt_list_jumbo_hdr *h = (lt_list_jumbo_hdr *)blk; h->len = (uint64_t)cur_len; h->cap = (uint64_t)next;");
        outLine("        " + cType + " *nb = (" + cType + " *)(blk + sizeof(lt_list_jumbo_hdr));");
        outLine("        if (cur_len > 0 && xs->data != NULL) { memcpy(nb, xs->data, (size_t)cur_len * sizeof(" + cType + ")); }");
        outLine("        if (xs->data != NULL && !" + lType + "_is_scope(*xs)) {");
        outLine("            if (xs->cap == UINT32_MAX) { lt_heap_free((char *)xs->data - sizeof(lt_list_jumbo_hdr)); }");
        outLine("            else { lt_heap_free(xs->data); }");
        outLine("        }");
        outLine("        xs->data = nb; xs->len = UINT32_MAX; xs->cap = UINT32_MAX;");
        outLine("        return;");
        outLine("    }");
        outLine("    if (" + lType + "_is_scope(*xs)) {");
        outLine("        " + cType + " *nb = lt_heap_alloc((size_t)next * sizeof(" + cType + "));");
        outLine("        int64_t cur_len = " + lType + "_len(*xs);");
        outLine("        if (cur_len > 0 && xs->data != NULL) { memcpy(nb, xs->data, (size_t)cur_len * sizeof(" + cType + ")); }");
        outLine("        xs->data = nb; xs->cap = (uint32_t)next;");
        outLine("        return;");
        outLine("    }");
        outLine("    " + cType + " *buf = lt_heap_realloc(xs->data, (size_t)cap * sizeof(" + cType + "), (size_t)next * sizeof(" + cType + "));");
        outLine("    xs->data = buf; xs->cap = (uint32_t)next;");
        outLine("}");
    }
    if hasPushBack {
        outLine("static void " + lType + "_push_back(" + lType + " *xs, " + cType + " val) {");
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    " + lType + "_grow(xs, n + 1);");
        outLine("    xs->data[n] = val;");
        outLine("    if (LT_UNLIKELY(xs->len == UINT32_MAX)) { ((lt_list_jumbo_hdr *)xs->data)[-1].len = (uint64_t)(n + 1); } else { xs->len = (uint32_t)(n + 1); }");
        outLine("}");
    }
    if hasPushFront {
        outLine("static void " + lType + "_push_front(" + lType + " *xs, " + cType + " val) {");
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    " + lType + "_grow(xs, n + 1);");
        outLine("    if (n > 0) { memmove(xs->data + 1, xs->data, (size_t)n * sizeof(" + cType + ")); }");
        outLine("    xs->data[0] = val;");
        outLine("    if (LT_UNLIKELY(xs->len == UINT32_MAX)) { ((lt_list_jumbo_hdr *)xs->data)[-1].len = (uint64_t)(n + 1); } else { xs->len = (uint32_t)(n + 1); }");
        outLine("}");
    }
    if hasPopBack {
        outLine("static " + cType + " " + lType + "_pop_back(" + lType + " *xs, size_t at) {");
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    if (LT_UNLIKELY(n <= 0)) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        outLine("    int64_t nl = n - 1;");
        outLine("    if (LT_UNLIKELY(xs->len == UINT32_MAX)) { ((lt_list_jumbo_hdr *)xs->data)[-1].len = (uint64_t)nl; } else { xs->len = (uint32_t)nl; }");
        outLine("    return xs->data[nl];");
        outLine("}");
    }
    if hasPopFront {
        outLine("static " + cType + " " + lType + "_pop_front(" + lType + " *xs, size_t at) {");
        outLine("    int64_t n = " + lType + "_len(*xs);");
        outLine("    if (LT_UNLIKELY(n <= 0)) { lt_bound_fault(at, \"cannot pop from an empty list\"); }");
        outLine("    " + cType + " head = xs->data[0];");
        outLine("    int64_t nl = n - 1;");
        outLine("    if (LT_UNLIKELY(xs->len == UINT32_MAX)) { ((lt_list_jumbo_hdr *)xs->data)[-1].len = (uint64_t)nl; } else { xs->len = (uint32_t)nl; }");
        outLine("    if (nl > 0) { memmove(xs->data, xs->data + 1, (size_t)nl * sizeof(" + cType + ")); }");
        outLine("    return head;");
        outLine("}");
    }
    if hasSlice {
        outLine("static " + lType + " " + lType + "_slice(" + lType + " xs, int64_t start, int64_t end, size_t at) {");
        outLine("    int64_t n = " + lType + "_len(xs);");
        outLine("    if (LT_UNLIKELY(start < 0 || end < start || end > n)) { lt_bound_fault(at, \"list slice bounds outside its extent\"); }");
        outLine("    " + lType + " out = " + lType + "_from(end - start, xs.data + start);");
        if elemNeedsDeepCopy {
            outLine("    int64_t on = end - start; for (int64_t i = 0; i < on; i += 1) { out.data[i] = " + elOps.copyFn + "(out.data[i]); }");
        }
        outLine("    return out;");
        outLine("}");
    }
    if hasSliceFrom {
        outLine("static " + lType + " " + lType + "_slice_from(" + lType + " xs, int64_t start, size_t at) {");
        outLine("    return " + lType + "_slice(xs, start, " + lType + "_len(xs), at);");
        outLine("}");
    }
    if hasReverse {
        outLine("static " + lType + " " + lType + "_reverse(" + lType + " xs) {");
        outLine("    int64_t n = " + lType + "_len(xs);");
        outLine("    " + lType + " out = " + lType + "_from(n, xs.data);");
        if elemNeedsDeepCopy {
            outLine("    for (int64_t i = 0; i < n; i += 1) { out.data[i] = " + elOps.copyFn + "(out.data[i]); }");
        }
        outLine("    for (int64_t i = 0; i < n / 2; i += 1) { " + cType + " t = out.data[i]; out.data[i] = out.data[n - 1 - i]; out.data[n - 1 - i] = t; }");
        outLine("    return out;");
        outLine("}");
    }
    if hasClear {
        outLine("static void " + lType + "_clear(" + lType + " *xs) {");
        if elemNeedsDrop {
            outLine("    int64_t n = " + lType + "_len(*xs);");
            outLine("    if (xs->data != NULL) { for (int64_t i = 0; i < n; i += 1) { " + elOps.dropFn + "(&xs->data[i]); } }");
        }
        outLine("    if (LT_UNLIKELY(xs->len == UINT32_MAX)) { ((lt_list_jumbo_hdr *)xs->data)[-1].len = 0u; } else { xs->len = 0u; }");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + lType + "_print(" + lType + " xs) {");
        outLine("    int64_t n = " + lType + "_len(xs);");
        outLine("    if (printf(\"[\") < 0) { return -1; }");
        outLine("    for (int64_t i = 0; i < n; i += 1) {");
        outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
        elemPrint := if tag == "i64" or tag == "i32" or tag == "i16" or tag == "i8" or tag == "i4" or tag == "i2" or tag == "i1" { "printf(\"%\" PRId64, (int64_t)xs.data[i])" }
        else if tag == "u64" or tag == "u32" or tag == "u16" or tag == "u8" or tag == "u4" or tag == "u2" or tag == "u1" { "printf(\"%\" PRIu64, (uint64_t)xs.data[i])" }
        else if tag == "f64" or tag == "f32" { "lt_print_float((double)xs.data[i])" }
        else if tag == "f8" { "lt_print_float(lt_f8_to_f64(xs.data[i]))" }
        else if tag == "f16" { "lt_print_float(lt_f16_to_f64(xs.data[i]))" }
        else if tag == "bool" { "printf(\"%s\", xs.data[i] ? \"true\" : \"false\")" }
        else if tag == "str" { "lt_print_str(xs.data[i])" }
        else { tag + "_print(xs.data[i])" };
        outLine("        if (" + elemPrint + " < 0) { return -1; }");
        outLine("    }");
        outLine("    return printf(\"]\");");
        outLine("}");
    }
    outLine("");
};

/** Emits portable ISO C11 inline fixed-array value struct (`typedef struct { T data[N]; } lt_arr_...`) and only the helper operations used for `kind`. Zero heap allocations. */
emitCArrayHelpers := fn(kind: String, calls: Set<String>, needCopy: Bool, needPrint: Bool, config: optCfg.OptConfig): Unit {
    aTag := frontend.cArrayTag(kind);
    elKind := frontend.arrayElementKind(kind);
    ext := frontend.arrayExtent(kind);
    cElemType := cScalarType(elKind);
    extStr := ext.toText();
    elOps := cKindOps(elKind);
    elCopyExpr := if elOps.copyFn =!= "" { elOps.copyFn + "(val)" } else { "val" };
    elemNeedsDrop := elOps.dropFn =!= "";
    elemNeedsDeepCopy := elemNeedsDrop;
    isSubByte := ext > 0 and numeric.isSubByteIntKind(elKind);
    subBits := if isSubByte { numeric.narrowIntBits(elKind) } else { 0 };
    hasFrom := isSubByte and usesIntHelper(calls, aTag + "_from(");
    hasRepeat := ext > 0 and usesIntHelper(calls, aTag + "_repeat(");
    hasCopy := elemNeedsDeepCopy and (needCopy or usesIntHelper(calls, aTag + "_copy("));
    hasAt := usesIntHelper(calls, aTag + "_at(");
    hasUat := usesIntHelper(calls, aTag + "_uat(");
    hasSet := usesIntHelper(calls, aTag + "_set(");
    hasUset := usesIntHelper(calls, aTag + "_uset(");
    hasSliceFrom := usesIntHelper(calls, aTag + "_slice_from(");
    hasSlice := usesIntHelper(calls, aTag + "_slice(") or hasSliceFrom;
    hasGetRaw := isSubByte and (needPrint or hasAt or hasUat or hasSlice or usesIntHelper(calls, aTag + "_get_raw("));
    hasSetRaw := isSubByte and (hasFrom or hasRepeat or hasSet or hasUset);
    if ext == 0 {
        outLine("typedef struct { uint8_t _empty; } " + aTag + ";");
    } else if isSubByte {
        byteCount := (ext * subBits + 7) :/ 8;
        outLine("typedef struct { uint8_t data[" + byteCount.toText() + "]; } " + aTag + ";");
    } else {
        outLine("typedef struct { " + cElemType + " data[" + extStr + "]; } " + aTag + ";");
    }
    if elemNeedsDrop and ext > 0 {
        outLine("LT_INLINE void " + aTag + "_drop(" + aTag + " *xs) { for (int64_t i = 0; i < " + extStr + "; i += 1) { " + elOps.dropFn + "(&xs->data[i]); } }");
        outLine("LT_INLINE " + aTag + " " + aTag + "_move(" + aTag + " *xs) { " + aTag + " r = *xs; memset(xs, 0, sizeof(*xs)); return r; }");
    }
    if hasGetRaw {
        maskHex := if subBits == 1 { "1u" } else if subBits == 2 { "3u" } else { "0x0fu" };
        shiftExpr := if subBits == 1 { "(unsigned)((size_t)idx & 7u)" } else if subBits == 2 { "(unsigned)(((size_t)idx & 3u) << 1)" } else { "(unsigned)(((size_t)idx & 1u) << 2)" };
        byteShift := if subBits == 1 { "3" } else if subBits == 2 { "2" } else { "1" };
        outLine("LT_INLINE " + cElemType + " " + aTag + "_get_raw(" + aTag + " xs, int64_t idx) {");
        outLine("    uint8_t b = (uint8_t)((xs.data[(size_t)idx >> " + byteShift + "] >> " + shiftExpr + ") & " + maskHex + ");");
        if numeric.isSignedIntKind(elKind) {
            if subBits == 1 {
                outLine("    return (int8_t)(b ? -1 : 0);");
            } else if subBits == 2 {
                outLine("    return (int8_t)b - (int8_t)((b & 2u) << 1);");
            } else {
                outLine("    return (int8_t)b - (int8_t)((b & 8u) << 1);");
            }
        } else {
            outLine("    return b;");
        }
        outLine("}");
    }
    if hasSetRaw {
        maskHex := if subBits == 1 { "1u" } else if subBits == 2 { "3u" } else { "0x0fu" };
        shiftExpr := if subBits == 1 { "(unsigned)((size_t)idx & 7u)" } else if subBits == 2 { "(unsigned)(((size_t)idx & 3u) << 1)" } else { "(unsigned)(((size_t)idx & 1u) << 2)" };
        byteShift := if subBits == 1 { "3" } else if subBits == 2 { "2" } else { "1" };
        outLine("LT_INLINE void " + aTag + "_set_raw(" + aTag + " *xs, int64_t idx, " + cElemType + " val) {");
        outLine("    size_t bi = (size_t)idx >> " + byteShift + ";");
        outLine("    unsigned sh = " + shiftExpr + ";");
        outLine("    xs->data[bi] = (uint8_t)((xs->data[bi] & ~(uint8_t)(" + maskHex + " << sh)) | (uint8_t)(((uint8_t)val & " + maskHex + ") << sh));");
        outLine("}");
    }
    if hasFrom {
        outLine("static " + aTag + " " + aTag + "_from(const " + cElemType + " *vals) {");
        outLine("    " + aTag + " out = { 0 };");
        outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) { " + aTag + "_set_raw(&out, i, vals[i]); }");
        outLine("    return out;");
        outLine("}");
    }
    if hasRepeat {
        outLine("static " + aTag + " " + aTag + "_repeat(" + cElemType + " val) {");
        if isSubByte {
            outLine("    " + aTag + " out = { 0 };");
            outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) { " + aTag + "_set_raw(&out, i, val); }");
            outLine("    return out;");
        } else {
            outLine("    " + aTag + " out;");
            if elemNeedsDeepCopy {
                outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) { out.data[i] = " + elCopyExpr + "; }");
                outLine("    " + elOps.dropFn + "(&val);");
            } else {
                outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) { out.data[i] = val; }");
            }
            outLine("    return out;");
        }
        outLine("}");
    }
    if hasCopy {
        outLine("LT_INLINE " + aTag + " " + aTag + "_copy(" + aTag + " src) {");
        if ext == 0 {
            outLine("    return src;");
        } else {
            outLine("    " + aTag + " out;");
            outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) { " + cElemType + " val = src.data[i]; out.data[i] = " + elCopyExpr + "; }");
            outLine("    return out;");
        }
        outLine("}");
    }
    if hasAt {
        outLine("LT_INLINE " + cElemType + " " + aTag + "_at(" + aTag + " xs, int64_t idx, size_t at) {");
        if ext == 0 {
            outLine("    (void)xs; (void)idx;");
            if config.checkBounds { outLine("    lt_bound_fault(at, \"list index outside its extent\");"); }
            else { outLine("    (void)at; " + cElemType + " z; memset(&z, 0, sizeof(z)); return z;"); }
        } else if isSubByte {
            if config.checkBounds {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            outLine("    return " + aTag + "_get_raw(xs, idx);");
        } else {
            if config.checkBounds {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            if elemNeedsDeepCopy {
                outLine("    return " + elOps.copyFn + "(xs.data[idx]);");
            } else {
                outLine("    return xs.data[idx];");
            }
        }
        outLine("}");
    }
    if hasUat {
        outLine("LT_INLINE " + cElemType + " " + aTag + "_uat(" + aTag + " xs, int64_t idx, size_t at) {");
        if ext == 0 {
            outLine("    (void)xs; (void)idx;");
            if config.checkUnchecked { outLine("    lt_bound_fault(at, \"list index outside its extent\");"); }
            else { outLine("    (void)at; " + cElemType + " z; memset(&z, 0, sizeof(z)); return z;"); }
        } else if isSubByte {
            if config.checkUnchecked {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            outLine("    return " + aTag + "_get_raw(xs, idx);");
        } else {
            if config.checkUnchecked {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            if elemNeedsDeepCopy {
                outLine("    return " + elOps.copyFn + "(xs.data[idx]);");
            } else {
                outLine("    return xs.data[idx];");
            }
        }
        outLine("}");
    }
    if hasSet {
        outLine("LT_INLINE void " + aTag + "_set(" + aTag + " *xs, int64_t idx, " + cElemType + " val, size_t at) {");
        if ext == 0 {
            outLine("    (void)xs; (void)idx; (void)val;");
            if config.checkBounds { outLine("    lt_bound_fault(at, \"list index outside its extent\");"); }
            else { outLine("    (void)at;"); }
        } else if isSubByte {
            if config.checkBounds {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            outLine("    " + aTag + "_set_raw(xs, idx, val);");
        } else {
            if config.checkBounds {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            if elemNeedsDrop {
                outLine("    " + elOps.dropFn + "(&xs->data[idx]);");
            }
            outLine("    xs->data[idx] = val;");
        }
        outLine("}");
    }
    if hasUset {
        outLine("LT_INLINE void " + aTag + "_uset(" + aTag + " *xs, int64_t idx, " + cElemType + " val, size_t at) {");
        if ext == 0 {
            outLine("    (void)xs; (void)idx; (void)val;");
            if config.checkUnchecked { outLine("    lt_bound_fault(at, \"list index outside its extent\");"); }
            else { outLine("    (void)at;"); }
        } else if isSubByte {
            if config.checkUnchecked {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            outLine("    " + aTag + "_set_raw(xs, idx, val);");
        } else {
            if config.checkUnchecked {
                outLine("    if (LT_UNLIKELY(idx < 0 || idx >= " + extStr + ")) { lt_bound_fault(at, \"list index outside its extent\"); }");
            } else {
                outLine("    (void)at;");
            }
            if elemNeedsDrop {
                outLine("    " + elOps.dropFn + "(&xs->data[idx]);");
            }
            outLine("    xs->data[idx] = val;");
        }
        outLine("}");
    }
    if hasSlice {
        elListTag := frontend.cListTag(elKind);
        lType := "lt_list_" + elListTag;
        outLine("static " + lType + " " + aTag + "_slice(" + aTag + " xs, int64_t start, int64_t end, size_t at) {");
        outLine("    if (LT_UNLIKELY(start < 0 || end < start || end > " + extStr + ")) { lt_bound_fault(at, \"list slice bounds outside its extent\"); }");
        if ext == 0 {
            outLine("    (void)xs; (void)start; (void)end;");
            outLine("    return " + lType + "_from(0, NULL);");
        } else if isSubByte {
            outLine("    int64_t n = end - start;");
            outLine("    if (n == 0) { return " + lType + "_from(0, NULL); }");
            outLine("    " + cElemType + " *tmp = lt_heap_alloc((size_t)n * sizeof(" + cElemType + "));");
            outLine("    for (int64_t i = 0; i < n; i += 1) { tmp[i] = " + aTag + "_get_raw(xs, start + i); }");
            outLine("    " + lType + " out = " + lType + "_from(n, tmp);");
            outLine("    lt_heap_free(tmp);");
            outLine("    return out;");
        } else if elemNeedsDeepCopy {
            outLine("    int64_t n = end - start;");
            outLine("    " + lType + " out = " + lType + "_from(n, xs.data + start);");
            outLine("    for (int64_t i = 0; i < n; i += 1) { out.data[i] = " + elOps.copyFn + "(out.data[i]); }");
            outLine("    return out;");
        } else {
            outLine("    return " + lType + "_from(end - start, xs.data + start);");
        }
        outLine("}");
    }
    if hasSliceFrom {
        elListTag := frontend.cListTag(elKind);
        lType := "lt_list_" + elListTag;
        outLine("static " + lType + " " + aTag + "_slice_from(" + aTag + " xs, int64_t start, size_t at) {");
        outLine("    return " + aTag + "_slice(xs, start, " + extStr + ", at);");
        outLine("}");
    }
    if needPrint {
        outLine("static int " + aTag + "_print(" + aTag + " xs) {");
        if ext == 0 {
            outLine("    (void)xs;");
            outLine("    return printf(\"[]\");");
        } else {
            elemExpr := if isSubByte { aTag + "_get_raw(xs, i)" } else { "xs.data[i]" };
            outLine("    if (printf(\"[\") < 0) { return -1; }");
            outLine("    for (int64_t i = 0; i < " + extStr + "; i += 1) {");
            outLine("        if (i > 0 && printf(\", \") < 0) { return -1; }");
            outLine("        if (" + cCall(elKind, elemExpr) + " < 0) { return -1; }");
            outLine("    }");
            outLine("    return printf(\"]\");");
        }
        outLine("}");
    }
    outLine("");
};

/** Emits portable C11 guards that reject overflow and bounds faults before evaluating operations. */
emitIntArithmeticHelpers := fn(calls: Set<String>, source: String, prefix: String, config: optCfg.OptConfig): Unit {
    usesArithHelpers := usesIntArithmetic(calls) or usesIntDivision(calls) or usesFloatArithmetic(calls);
    usesCheckedIntFault := config.checkArithmetic and (usesIntArithmetic(calls) or usesIntDivision(calls));
    usesCheckedFloatArith := usesIntHelper(calls, "lt_float_op(") or usesIntHelper(calls, "lt_float32_op(") or usesIntHelper(calls, "lt_float16_op(") or usesIntHelper(calls, "lt_float8_op(") or usesIntHelper(calls, "lt_float_power(");
    usesCheckedFloatFinite := usesCheckedFloatArith or usesIntHelper(calls, "lt_f64_to_f8(") or usesIntHelper(calls, "lt_f64_to_f16_checked(") or usesIntHelper(calls, "lt_f64_to_f32_checked(") or usesHelperPrefix(calls, "lt_fma_") or usesIntHelper(calls, "lt_f32_from_bits(") or usesIntHelper(calls, "lt_f64_from_bits(");
    usesCheckedFloatFault := (config.checkArithmetic and usesCheckedFloatArith) or
    (config.checkFloatFinite and usesCheckedFloatFinite) or
    (config.checkUnchecked and (usesHelperPrefix(calls, "lt_ufadd_") or usesHelperPrefix(calls, "lt_ufsub_") or usesHelperPrefix(calls, "lt_ufmul_") or usesHelperPrefix(calls, "lt_ufdiv_") or usesHelperPrefix(calls, "lt_ufma_") or usesIntHelper(calls, "lt_f32_ufrom_bits(") or usesIntHelper(calls, "lt_f64_ufrom_bits(")));
    usesUnchIntFault := config.checkUnchecked and usesUncheckedInt(calls);
    usesArith := usesCheckedIntFault or usesCheckedFloatFault or usesUnchIntFault;
    usesBounds := usesIntHelper(calls, "lite$textAt(") or usesIntHelper(calls, "lite$textSlice(") or usesIntHelper(calls, "lite$textSliceFrom(") or
    usesAnyListBounds(calls, config);
    if not usesArithHelpers and not usesArith and not usesBounds { return; }
    outLine("#ifndef LT_UNLIKELY");
    outLine("#if defined(__GNUC__) || defined(__clang__)");
    outLine("#define LT_UNLIKELY(x) __builtin_expect(!!(x), 0)");
    outLine("#define LT_COLD __attribute__((cold))");
    outLine("#else");
    outLine("#define LT_UNLIKELY(x) (x)");
    outLine("#define LT_COLD");
    outLine("#endif");
    outLine("#endif");
    if usesArith or usesBounds {
        namePrefix := if prefix == "" { "" } else { prefix + ":" };
        outLine("static const size_t lt_int_lines[] = {" + frontend.lineStartCodes(source) + "};");
        outLine("static const char *lt_int_source = " + cLiteral.textLiteralCode(namePrefix) + ";");
        if usesBounds {
            outLine("static LT_COLD _Noreturn void lt_fault(const char *category, size_t at, const char *message) {");
            outLine("    size_t line = 0;");
            outLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
            outLine("    fprintf(stderr, \"%s%zu:%zu: %s: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, category, message);");
            outLine("    exit(1);");
            outLine("}");
            outLine("static LT_COLD _Noreturn void lt_bound_fault(size_t at, const char *message) { lt_fault(\"BoundPanic\", at, message); }");
            if usesArith {
                outLine("static LT_COLD _Noreturn void lt_int_fault(size_t at, const char *message) { lt_fault(\"ArithmeticPanic\", at, message); }");
            }
        } else {
            outLine("static LT_COLD _Noreturn void lt_int_fault(size_t at, const char *message) {");
            outLine("    size_t line = 0;");
            outLine("    while (line + 1 < sizeof(lt_int_lines) / sizeof(lt_int_lines[0]) && lt_int_lines[line + 1] <= at) { line += 1; }");
            outLine("    fprintf(stderr, \"%s%zu:%zu: ArithmeticPanic: %s\\n\", lt_int_source, line + 1, at - lt_int_lines[line] + 1, message);");
            outLine("    exit(1);");
            outLine("}");
        }
    }
    if usesIntHelper(calls, "lt_checked_add(") {
        outLine("LT_INLINE int64_t lt_checked_add(int64_t left, int64_t right, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)at; return (int64_t)((uint64_t)left + (uint64_t)right);");
        } else {
            outLine("#if defined(__GNUC__) || defined(__clang__)");
            outLine("    int64_t out = 0;");
            outLine("    if (LT_UNLIKELY(__builtin_add_overflow(left, right, &out))) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return out;");
            outLine("#else");
            outLine("    if ((right > 0 && left > INT64_MAX - right) || (right < 0 && left < INT64_MIN - right)) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return left + right;");
            outLine("#endif");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_subtract(") {
        outLine("LT_INLINE int64_t lt_checked_subtract(int64_t left, int64_t right, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)at; return (int64_t)((uint64_t)left - (uint64_t)right);");
        } else {
            outLine("#if defined(__GNUC__) || defined(__clang__)");
            outLine("    int64_t out = 0;");
            outLine("    if (LT_UNLIKELY(__builtin_sub_overflow(left, right, &out))) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return out;");
            outLine("#else");
            outLine("    if ((right < 0 && left > INT64_MAX + right) || (right > 0 && left < INT64_MIN + right)) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return left - right;");
            outLine("#endif");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_multiply(") {
        outLine("LT_INLINE int64_t lt_checked_multiply(int64_t left, int64_t right, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)at; return (int64_t)((uint64_t)left * (uint64_t)right);");
        } else {
            outLine("#if defined(__GNUC__) || defined(__clang__)");
            outLine("    int64_t out = 0;");
            outLine("    if (LT_UNLIKELY(__builtin_mul_overflow(left, right, &out))) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return out;");
            outLine("#else");
            outLine("    if (left == 0 || right == 0) { return 0; }");
            outLine("    if (left > 0) {");
            outLine("        if (right > 0) { if (left > INT64_MAX / right) { lt_int_fault(at, \"integer outside Int range\"); } }");
            outLine("        else if (right < INT64_MIN / left) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    } else if (right > 0) {");
            outLine("        if (left < INT64_MIN / right) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    } else if (right < INT64_MAX / left) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return left * right;");
            outLine("#endif");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_negate(") {
        outLine("LT_INLINE int64_t lt_checked_negate(int64_t value, size_t at) {");
        if config.checkArithmetic {
            outLine("    if (LT_UNLIKELY(value == INT64_MIN)) { lt_int_fault(at, \"integer outside Int range\"); }");
            outLine("    return -value;");
        } else {
            outLine("    (void)at;");
            outLine("    return (int64_t)(UINT64_C(0) - (uint64_t)value);");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_narrow_int(") {
        outLine("LT_INLINE int64_t lt_checked_narrow_int(int64_t value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return value;");
        } else {
            outLine("    if (bits >= 64) { return value; }");
            outLine("    const int64_t limit = INT64_C(1) << (bits - 1);");
            outLine("    if (LT_UNLIKELY(value < -limit || value >= limit)) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return value;");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_uadd(") {
        outLine("LT_INLINE uint64_t lt_checked_uadd(uint64_t left, uint64_t right, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)at; return left + right;");
        } else {
            outLine("#if defined(__GNUC__) || defined(__clang__)");
            outLine("    uint64_t out = 0;");
            outLine("    if (LT_UNLIKELY(__builtin_add_overflow(left, right, &out))) { lt_int_fault(at, \"integer outside UInt64 range\"); }");
            outLine("    return out;");
            outLine("#else");
            outLine("    if (LT_UNLIKELY(left > UINT64_MAX - right)) { lt_int_fault(at, \"integer outside UInt64 range\"); }");
            outLine("    return left + right;");
            outLine("#endif");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_usub(") {
        outLine("LT_INLINE uint64_t lt_checked_usub(uint64_t left, uint64_t right, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(left < right)) { lt_int_fault(at, \"integer outside UInt64 range\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return left - right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_umul(") {
        outLine("LT_INLINE uint64_t lt_checked_umul(uint64_t left, uint64_t right, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)at; return left * right;");
        } else {
            outLine("#if defined(__GNUC__) || defined(__clang__)");
            outLine("    uint64_t out = 0;");
            outLine("    if (LT_UNLIKELY(__builtin_mul_overflow(left, right, &out))) { lt_int_fault(at, \"integer outside UInt64 range\"); }");
            outLine("    return out;");
            outLine("#else");
            outLine("    if (left != 0 && right > UINT64_MAX / left) { lt_int_fault(at, \"integer outside UInt64 range\"); }");
            outLine("    return left * right;");
            outLine("#endif");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_udiv(") {
        outLine("LT_INLINE uint64_t lt_checked_udiv(uint64_t left, uint64_t right, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(right == 0)) { lt_int_fault(at, \"division by zero\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return left / right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_urem(") {
        outLine("LT_INLINE uint64_t lt_checked_urem(uint64_t left, uint64_t right, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(right == 0)) { lt_int_fault(at, \"division by zero\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return left % right;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_checked_narrow_uint(") {
        outLine("LT_INLINE uint64_t lt_checked_narrow_uint(uint64_t value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return value;");
        } else {
            outLine("    if (bits >= 64) { return value; }");
            outLine("    const uint64_t limit = UINT64_C(1) << (bits & 63);");
            outLine("    if (LT_UNLIKELY(value >= limit)) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return value;");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_cast_i2u(") {
        outLine("LT_INLINE uint64_t lt_cast_i2u(int64_t value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return (uint64_t)value;");
        } else {
            outLine("    if (LT_UNLIKELY(value < 0 || (bits < 64 && (uint64_t)value >= (UINT64_C(1) << (bits & 63))))) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return (uint64_t)value;");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_cast_u2i(") {
        outLine("LT_INLINE int64_t lt_cast_u2i(uint64_t value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return (int64_t)value;");
        } else {
            outLine("    const uint64_t maxv = (UINT64_C(1) << (bits - 1)) - UINT64_C(1);");
            outLine("    if (LT_UNLIKELY(value > maxv)) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return (int64_t)value;");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_trunc_f64_to_int(") {
        outLine("LT_INLINE int64_t lt_trunc_f64_to_int(double value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return (int64_t)value;");
        } else {
            outLine("    if (LT_UNLIKELY(!isfinite(value))) { lt_int_fault(at, \"non-finite floating value\"); }");
            outLine("    double t = trunc(value);");
            outLine("    bool oob = (bits == 64) ? (t < -9223372036854775808.0 || t >= 9223372036854775808.0) : (t < -(double)(UINT64_C(1) << (bits - 1)) || t >= (double)(UINT64_C(1) << (bits - 1)));");
            outLine("    if (LT_UNLIKELY(oob)) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return (int64_t)t;");
        }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_trunc_f64_to_uint(") {
        outLine("LT_INLINE uint64_t lt_trunc_f64_to_uint(double value, int bits, const char *name, size_t at) {");
        if not config.checkArithmetic {
            outLine("    (void)bits; (void)name; (void)at; return (uint64_t)value;");
        } else {
            outLine("    if (LT_UNLIKELY(!isfinite(value))) { lt_int_fault(at, \"non-finite floating value\"); }");
            outLine("    double t = trunc(value);");
            outLine("    bool oob = (t < 0.0) || ((bits == 64) ? (t >= 18446744073709551616.0) : (t >= (double)(UINT64_C(1) << (bits & 63))));");
            outLine("    if (LT_UNLIKELY(oob)) {");
            outLine("        char message[64];");
            outLine("        snprintf(message, sizeof message, \"integer outside %s range\", name);");
            outLine("        lt_int_fault(at, message);");
            outLine("    }");
            outLine("    return (uint64_t)t;");
        }
        outLine("}");
    }
    outLine("");
}

/** Emits on-demand C11 helpers for bitwise, checked shift, rotate, wrapping, saturating, and bit-count intrinsics. */
emitIntBitwiseHelpers := fn(calls: Set<String>, config: optCfg.OptConfig): Unit {
    needWrapS := usesIntHelper(calls, "lt_wrap_s(") or usesHelperPrefix(calls, "lt_wmul_i1__") or usesHelperPrefix(calls, "lt_wmul_i2__") or usesHelperPrefix(calls, "lt_wmul_i4__") or usesIntHelper(calls, "lt_shl_s(") or usesIntHelper(calls, "lt_rotl_s(") or usesIntHelper(calls, "lt_rotr_s(");
    if needWrapS {
        outLine("LT_INLINE int8_t lt_wrap_s(uint64_t u, int bits) {");
        outLine("    uint64_t m = (UINT64_C(1) << (bits & 63)) - UINT64_C(1);");
        outLine("    uint64_t s = UINT64_C(1) << ((bits - 1) & 63);");
        outLine("    u &= m;");
        outLine("    return (int8_t)((u & s) ? (int64_t)(u | ~m) : (int64_t)u);");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_shl_s(") {
        outLine("LT_INLINE int64_t lt_shl_s(int64_t v, int64_t n, int bits, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(n < 0 || n >= bits)) { lt_int_fault(at, \"shift count out of range\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    uint64_t r = ((uint64_t)v) << (unsigned)n;");
        outLine("    if (bits >= 64) { return (int64_t)r; }");
        outLine("    uint64_t m = (UINT64_C(1) << (bits & 63)) - UINT64_C(1);");
        outLine("    uint64_t s = UINT64_C(1) << ((bits - 1) & 63);");
        outLine("    r &= m;");
        outLine("    return (r & s) ? (int64_t)(r | ~m) : (int64_t)r;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_shl_u(") {
        outLine("LT_INLINE uint64_t lt_shl_u(uint64_t v, int64_t n, int bits, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(n < 0 || n >= bits)) { lt_int_fault(at, \"shift count out of range\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    uint64_t r = v << (unsigned)n;");
        outLine("    if (bits < 64) { r &= (UINT64_C(1) << (bits & 63)) - UINT64_C(1); }");
        outLine("    return r;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_shr_s(") {
        outLine("LT_INLINE int64_t lt_shr_s(int64_t v, int64_t n, int bits, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(n < 0 || n >= bits)) { lt_int_fault(at, \"shift count out of range\"); }"); }
        else { outLine("    (void)bits; (void)at;"); }
        outLine("    return (v >= 0) ? (int64_t)((uint64_t)v >> (unsigned)n) : (int64_t)(~((~(uint64_t)v) >> (unsigned)n));");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_shr_u(") {
        outLine("LT_INLINE uint64_t lt_shr_u(uint64_t v, int64_t n, int bits, size_t at) {");
        if config.checkArithmetic { outLine("    if (LT_UNLIKELY(n < 0 || n >= bits)) { lt_int_fault(at, \"shift count out of range\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    if (bits < 64) { v &= (UINT64_C(1) << (bits & 63)) - UINT64_C(1); }");
        outLine("    return v >> (unsigned)n;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_rotl_u32(") {
        outLine("LT_INLINE uint32_t lt_rotl_u32(uint32_t v, int64_t n) { uint32_t s = (uint32_t)(uint64_t)n & 31u; return (v << s) | (v >> ((32u - s) & 31u)); }");
    }
    if usesIntHelper(calls, "lt_rotr_u32(") {
        outLine("LT_INLINE uint32_t lt_rotr_u32(uint32_t v, int64_t n) { uint32_t s = (uint32_t)(uint64_t)n & 31u; return (v >> s) | (v << ((32u - s) & 31u)); }");
    }
    if usesIntHelper(calls, "lt_rotl_u64(") {
        outLine("LT_INLINE uint64_t lt_rotl_u64(uint64_t v, int64_t n) { uint32_t s = (uint32_t)(uint64_t)n & 63u; return (v << s) | (v >> ((64u - s) & 63u)); }");
    }
    if usesIntHelper(calls, "lt_rotr_u64(") {
        outLine("LT_INLINE uint64_t lt_rotr_u64(uint64_t v, int64_t n) { uint32_t s = (uint32_t)(uint64_t)n & 63u; return (v >> s) | (v << ((64u - s) & 63u)); }");
    }
    needRotU := usesIntHelper(calls, "lt_rotl_u(") or usesIntHelper(calls, "lt_rotr_u(") or usesIntHelper(calls, "lt_rotl_s(") or usesIntHelper(calls, "lt_rotr_s(");
    if needRotU {
        outLine("LT_INLINE uint64_t lt_rotl_u(uint64_t v, int64_t n, int bits) {");
        outLine("    uint64_t m = (bits >= 64) ? UINT64_MAX : ((UINT64_C(1) << (bits & 63)) - UINT64_C(1));");
        outLine("    unsigned s = (unsigned)((uint64_t)n & (uint64_t)(bits - 1));");
        outLine("    v &= m; if (s == 0u) { return v; }");
        outLine("    return ((v << s) | (v >> ((unsigned)bits - s))) & m;");
        outLine("}");
        outLine("LT_INLINE uint64_t lt_rotr_u(uint64_t v, int64_t n, int bits) {");
        outLine("    uint64_t m = (bits >= 64) ? UINT64_MAX : ((UINT64_C(1) << (bits & 63)) - UINT64_C(1));");
        outLine("    unsigned s = (unsigned)((uint64_t)n & (uint64_t)(bits - 1));");
        outLine("    v &= m; if (s == 0u) { return v; }");
        outLine("    return ((v >> s) | (v << ((unsigned)bits - s))) & m;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_rotl_s(") {
        outLine("LT_INLINE int64_t lt_rotl_s(uint64_t v, int64_t n, int bits) {");
        outLine("    uint64_t r = lt_rotl_u(v, n, bits);");
        outLine("    if (bits >= 64) { return (int64_t)r; }");
        outLine("    uint64_t m = (UINT64_C(1) << (bits & 63)) - UINT64_C(1);");
        outLine("    uint64_t s = UINT64_C(1) << ((bits - 1) & 63);");
        outLine("    return (r & s) ? (int64_t)(r | ~m) : (int64_t)r;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_rotr_s(") {
        outLine("LT_INLINE int64_t lt_rotr_s(uint64_t v, int64_t n, int bits) {");
        outLine("    uint64_t r = lt_rotr_u(v, n, bits);");
        outLine("    if (bits >= 64) { return (int64_t)r; }");
        outLine("    uint64_t m = (UINT64_C(1) << (bits & 63)) - UINT64_C(1);");
        outLine("    uint64_t s = UINT64_C(1) << ((bits - 1) & 63);");
        outLine("    return (r & s) ? (int64_t)(r | ~m) : (int64_t)r;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_sadd_s(") {
        outLine("LT_INLINE int64_t lt_sadd_s(int64_t a, int64_t b, int bits) {");
        outLine("    int64_t minv = (bits >= 64) ? INT64_MIN : -(int64_t)(UINT64_C(1) << ((bits - 1) & 63));");
        outLine("    int64_t maxv = (bits >= 64) ? INT64_MAX : (int64_t)((UINT64_C(1) << ((bits - 1) & 63)) - UINT64_C(1));");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    int64_t out = 0; if (__builtin_add_overflow(a, b, &out)) { return (b < 0) ? minv : maxv; }");
        outLine("#else");
        outLine("    if (b > 0 && a > INT64_MAX - b) { return maxv; } if (b < 0 && a < INT64_MIN - b) { return minv; }");
        outLine("    int64_t out = a + b;");
        outLine("#endif");
        outLine("    return (out < minv) ? minv : (out > maxv) ? maxv : out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ssub_s(") {
        outLine("LT_INLINE int64_t lt_ssub_s(int64_t a, int64_t b, int bits) {");
        outLine("    int64_t minv = (bits >= 64) ? INT64_MIN : -(int64_t)(UINT64_C(1) << ((bits - 1) & 63));");
        outLine("    int64_t maxv = (bits >= 64) ? INT64_MAX : (int64_t)((UINT64_C(1) << ((bits - 1) & 63)) - UINT64_C(1));");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    int64_t out = 0; if (__builtin_sub_overflow(a, b, &out)) { return (b > 0) ? minv : maxv; }");
        outLine("#else");
        outLine("    if (b < 0 && a > INT64_MAX + b) { return maxv; } if (b > 0 && a < INT64_MIN + b) { return minv; }");
        outLine("    int64_t out = a - b;");
        outLine("#endif");
        outLine("    return (out < minv) ? minv : (out > maxv) ? maxv : out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_smul_s(") {
        outLine("LT_INLINE int64_t lt_smul_s(int64_t a, int64_t b, int bits) {");
        outLine("    int64_t minv = (bits >= 64) ? INT64_MIN : -(int64_t)(UINT64_C(1) << ((bits - 1) & 63));");
        outLine("    int64_t maxv = (bits >= 64) ? INT64_MAX : (int64_t)((UINT64_C(1) << ((bits - 1) & 63)) - UINT64_C(1));");
        outLine("    if (a == 0 || b == 0) { return 0; }");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    int64_t out = 0; if (__builtin_mul_overflow(a, b, &out)) { return ((a ^ b) < 0) ? minv : maxv; }");
        outLine("#else");
        outLine("    if (a > 0) { if (b > 0 ? (a > INT64_MAX / b) : (b < INT64_MIN / a)) { return ((a ^ b) < 0) ? minv : maxv; } }");
        outLine("    else { if (b > 0 ? (a < INT64_MIN / b) : (b < INT64_MAX / a)) { return ((a ^ b) < 0) ? minv : maxv; } }");
        outLine("    int64_t out = a * b;");
        outLine("#endif");
        outLine("    return (out < minv) ? minv : (out > maxv) ? maxv : out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_sadd_u(") {
        outLine("LT_INLINE uint64_t lt_sadd_u(uint64_t a, uint64_t b, int bits) {");
        outLine("    uint64_t maxv = (bits >= 64) ? UINT64_MAX : ((UINT64_C(1) << (bits & 63)) - UINT64_C(1));");
        outLine("    if (a >= maxv || b > maxv - a) { return maxv; }");
        outLine("    return a + b;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ssub_u(") {
        outLine("LT_INLINE uint64_t lt_ssub_u(uint64_t a, uint64_t b, int bits) { (void)bits; return (a <= b) ? UINT64_C(0) : (a - b); }");
    }
    if usesIntHelper(calls, "lt_smul_u(") {
        outLine("LT_INLINE uint64_t lt_smul_u(uint64_t a, uint64_t b, int bits) {");
        outLine("    uint64_t maxv = (bits >= 64) ? UINT64_MAX : ((UINT64_C(1) << (bits & 63)) - UINT64_C(1));");
        outLine("    if (a == 0u || b == 0u) { return UINT64_C(0); }");
        outLine("    if (a > maxv / b) { return maxv; }");
        outLine("    return a * b;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_popcnt(") {
        outLine("LT_INLINE int64_t lt_popcnt(uint64_t u) {");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    return (int64_t)__builtin_popcountll(u);");
        outLine("#else");
        outLine("    int64_t c = 0; while (u != 0u) { u &= (u - 1u); c += 1; } return c;");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_clz(") {
        outLine("LT_INLINE int64_t lt_clz(uint64_t u, int bits) {");
        outLine("    if (u == 0u) { return (int64_t)bits; }");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    return (int64_t)(__builtin_clzll(u) - (64 - bits));");
        outLine("#else");
        outLine("    int64_t c = 0; uint64_t bit = UINT64_C(1) << ((bits - 1) & 63);");
        outLine("    while (bit != 0u && (u & bit) == 0u) { c += 1; bit >>= 1; } return c;");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ctz(") {
        outLine("LT_INLINE int64_t lt_ctz(uint64_t u, int bits) {");
        outLine("    if (u == 0u) { return (int64_t)bits; }");
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("    return (int64_t)__builtin_ctzll(u);");
        outLine("#else");
        outLine("    int64_t c = 0; while ((u & 1u) == 0u) { c += 1; u >>= 1; } return c;");
        outLine("#endif");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_bswap16(") {
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("LT_INLINE uint16_t lt_bswap16(uint16_t u) { return __builtin_bswap16(u); }");
        outLine("#else");
        outLine("LT_INLINE uint16_t lt_bswap16(uint16_t u) { return (uint16_t)((u >> 8) | (u << 8)); }");
        outLine("#endif");
    }
    if usesIntHelper(calls, "lt_bswap32(") {
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("LT_INLINE uint32_t lt_bswap32(uint32_t u) { return __builtin_bswap32(u); }");
        outLine("#else");
        outLine("LT_INLINE uint32_t lt_bswap32(uint32_t u) { return ((u & 0xffu) << 24) | ((u & 0xff00u) << 8) | ((u >> 8) & 0xff00u) | ((u >> 24) & 0xffu); }");
        outLine("#endif");
    }
    if usesIntHelper(calls, "lt_bswap64(") {
        outLine("#if defined(__GNUC__) || defined(__clang__)");
        outLine("LT_INLINE uint64_t lt_bswap64(uint64_t u) { return __builtin_bswap64(u); }");
        outLine("#else");
        outLine("LT_INLINE uint64_t lt_bswap64(uint64_t u) { return ((u & 0xffULL) << 56) | ((u & 0xff00ULL) << 40) | ((u & 0xff0000ULL) << 24) | ((u & 0xff000000ULL) << 8) | ((u >> 8) & 0xff000000ULL) | ((u >> 24) & 0xff0000ULL) | ((u >> 40) & 0xff00ULL) | ((u >> 56) & 0xffULL); }");
        outLine("#endif");
    }
}

/** Returns the last starting index of `needle` inside `s`, or `-1` if absent. */
cLastIndexOfStr := fn(s: String, needle: String): Int {
    var pos := 0;
    var last := -1;
    loop true {
        hit := s.indexOf(needle, pos);
        if hit < 0 { break; }
        last = hit;
        pos = hit + needle.length();
    }
    last
};

/** Declares hygienic arithmetic/comparison/owned temporaries, jumping directly to markers outside strings and hoisted closure bodies. */
emitArithmeticTemporaries := fn(items: frontend.Items): Unit {
    seen: mut Set<String>;
    loop items as item {
        code := item.code;
        var nextArg := code.indexOf("lt_arg_", 0);
        var nextCmp := code.indexOf("lt_cmp_", 0);
        var nextLtmp := code.indexOf("/*@LTMP:", 0);
        if nextArg < 0 and nextCmp < 0 and nextLtmp < 0 { continue; }
        codeLen := code.length();
        var nextQuote := code.indexOf("\"", 0);
        var nextCfn := code.indexOf("/*@CFN_START:", 0);
        var cursor := 0;
        loop cursor < codeLen {
            if nextArg >= 0 and nextArg < cursor { nextArg = code.indexOf("lt_arg_", cursor); }
            if nextCmp >= 0 and nextCmp < cursor { nextCmp = code.indexOf("lt_cmp_", cursor); }
            if nextLtmp >= 0 and nextLtmp < cursor { nextLtmp = code.indexOf("/*@LTMP:", cursor); }
            var hit := -1;
            if nextArg >= 0 { hit = nextArg; }
            if nextCmp >= 0 and (hit < 0 or nextCmp < hit) { hit = nextCmp; }
            if nextLtmp >= 0 and (hit < 0 or nextLtmp < hit) { hit = nextLtmp; }
            if hit < 0 { break; }
            if nextQuote >= 0 and nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextCfn >= 0 and nextCfn < cursor { nextCfn = code.indexOf("/*@CFN_START:", cursor); }
            if nextQuote >= 0 and nextQuote < hit and (nextCfn < 0 or nextQuote < nextCfn) {
                cursor = frontend.skipAliasString(code, nextQuote);
                continue;
            }
            if nextCfn >= 0 and nextCfn < hit {
                cursor = skipCFnBlock(code, nextCfn);
                continue;
            }
            if hit == nextLtmp {
                endTag := code.indexOf("@*/", hit + 8);
                if endTag < 0 { break; }
                payload := code.slice(hit + 8, endTag);
                sep := cLastIndexOfStr(payload, ":");
                if sep > 0 {
                    cType := payload.slice(0, sep);
                    vName := payload.slice(sep + 1, payload.length());
                    if not seen.has(vName) {
                        mut seen.add(vName);
                        outLine("    " + cType + " " + vName + "; (void)" + vName + ";");
                    }
                }
                cursor = endTag + 3;
                continue;
            }
            end := code.skipName(hit);
            if code.startsWithAt(end, " = ") {
                tName := code.slice(hit, end);
                if not seen.has(tName) {
                    mut seen.add(tName);
                    tag := if code.startsWithAt(hit, "lt_cmp_") or code.startsWithAt(hit, "lt_arg_f_") or code.startsWithAt(hit, "lt_arg_u_") { code.at(hit + 7) } else { "i" };
                    typeCode := if tag == "s" { "lt_str " } else if tag == "b" { "bool " }
                    else if tag == "f" { "double " } else if tag == "u" { "uint64_t " } else { "int64_t " };
                    outLine("    " + typeCode + tName + ";");
                }
            }
            cursor = end;
        }
    }
}

/** Collects hygienic arithmetic/comparison/owned temporary declarations for a single hoisted closure definition and injects them at its placeholder. */
injectCFnTemps := fn(code: String): String {
    marker := "/*@CFN_TEMPS@*/";
    mIdx := code.indexOf(marker, 0);
    if mIdx < 0 { return code; }
    var nextArg := code.indexOf("lt_arg_", 0);
    var nextCmp := code.indexOf("lt_cmp_", 0);
    var nextLtmp := code.indexOf("/*@LTMP:", 0);
    size := code.length();
    if nextArg < 0 and nextCmp < 0 and nextLtmp < 0 {
        return code.slice(0, mIdx) + code.slice(mIdx + marker.length(), size);
    }
    decls: mut tb.TextBuilder;
    seen: mut Set<String>;
    var nextQuote := code.indexOf("\"", 0);
    var cursor := 0;
    loop cursor < size {
        if nextArg >= 0 and nextArg < cursor { nextArg = code.indexOf("lt_arg_", cursor); }
        if nextCmp >= 0 and nextCmp < cursor { nextCmp = code.indexOf("lt_cmp_", cursor); }
        if nextLtmp >= 0 and nextLtmp < cursor { nextLtmp = code.indexOf("/*@LTMP:", cursor); }
        var hit := -1;
        if nextArg >= 0 { hit = nextArg; }
        if nextCmp >= 0 and (hit < 0 or nextCmp < hit) { hit = nextCmp; }
        if nextLtmp >= 0 and (hit < 0 or nextLtmp < hit) { hit = nextLtmp; }
        if hit < 0 { break; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = frontend.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit == nextLtmp {
            endTag := code.indexOf("@*/", hit + 8);
            if endTag < 0 { break; }
            payload := code.slice(hit + 8, endTag);
            sep := cLastIndexOfStr(payload, ":");
            if sep > 0 {
                cType := payload.slice(0, sep);
                vName := payload.slice(sep + 1, payload.length());
                if not seen.has(vName) {
                    mut seen.add(vName);
                    mut decls.append(cType + " " + vName + "; (void)" + vName + "; ");
                }
            }
            cursor = endTag + 3;
            continue;
        }
        end := code.skipName(hit);
        if code.startsWithAt(end, " = ") {
            tName := code.slice(hit, end);
            if not seen.has(tName) {
                mut seen.add(tName);
                tag := if code.startsWithAt(hit, "lt_cmp_") or code.startsWithAt(hit, "lt_arg_f_") or code.startsWithAt(hit, "lt_arg_u_") { code.at(hit + 7) } else { "i" };
                typeCode := if tag == "s" { "lt_str " } else if tag == "b" { "bool " }
                else if tag == "f" { "double " } else if tag == "u" { "uint64_t " } else { "int64_t " };
                mut decls.append(typeCode + tName + "; ");
            }
        }
        cursor = end;
    }
    code.slice(0, mIdx) + decls.build() + code.slice(mIdx + marker.length(), size)
};

/** Emits shortest round-trip binary64 display with decimal/exponent thresholds shared by the TS runtime; source remains statically checked and no locale is selected by generated programs. */
emitFloatOutputHelpers := fn(needPrint: Bool): Unit {
    outLine("/* Split printf's positive finite decimal into significant digits and its first-digit exponent. */");
    outLine("static int lt_float_digits(const char *text, char *digits, int *exponent) {");
    outLine("    int size = 0, before = 0, dot = 0;");
    outLine("    const char *at = text;");
    outLine("    while (*at && *at != 'e' && *at != 'E') {");
    outLine("        if (*at == '.') dot = 1;");
    outLine("        else { digits[size++] = *at; if (!dot) before++; }");
    outLine("        at++;");
    outLine("    }");
    outLine("    int power = *at ? (int)strtol(at + 1, NULL, 10) : 0;");
    outLine("    int leading = 0;");
    outLine("    while (leading + 1 < size && digits[leading] == '0') leading++;");
    outLine("    memmove(digits, digits + leading, (size_t)(size - leading));");
    outLine("    size -= leading;");
    outLine("    digits[size] = '\\0';");
    outLine("    *exponent = before - leading - 1 + power;");
    outLine("    return size;");
    outLine("}");
    outLine("/* Move to the adjacent positive decimal having at most precision significant digits. */");
    outLine("static void lt_float_neighbor(char *digits, int precision, int *exponent, int direction) {");
    outLine("    int at = precision - 1;");
    outLine("    if (direction > 0) {");
    outLine("        while (at >= 0 && digits[at] == '9') digits[at--] = '0';");
    outLine("        if (at >= 0) digits[at]++;");
    outLine("        else { digits[0] = '1'; (*exponent)++; }");
    outLine("    } else {");
    outLine("        while (at >= 0 && digits[at] == '0') digits[at--] = '9';");
    outLine("        if (at >= 0) digits[at]--;");
    outLine("        if (digits[0] == '0') {");
    outLine("            for (int i = 0; i < precision; i++) digits[i] = '9';");
    outLine("            (*exponent)--;");
    outLine("        }");
    outLine("    }");
    outLine("}");
    outLine("/* Find the least significant-digit count that round-trips, including asymmetric boundary candidates. */");
    outLine("static int lt_float_format(double value, char *out) {");
    outLine("    if (value == 0.0) { strcpy(out, \"0\"); return 1; }");
    outLine("    int negative = value < 0.0;");
    outLine("    double positive = negative ? -value : value;");
    outLine("    char digits[32], nearest[64], adjacent[64];");
    outLine("    int size = 0, exponent = 0, found = 0;");
    outLine("    for (int precision = 1; precision <= 17 && !found; precision++) {");
    outLine("        if (snprintf(nearest, sizeof nearest, \"%.*g\", precision, positive) < 0) return 0;");
    outLine("        size = lt_float_digits(nearest, digits, &exponent);");
    outLine("        if (strtod(nearest, NULL) == positive) { found = 1; break; }");
    outLine("        while (size < precision) digits[size++] = '0';");
    outLine("        digits[size] = '\\0';");
    outLine("        for (int direction = -1; direction <= 1 && !found; direction += 2) {");
    outLine("            char candidate[32]; memcpy(candidate, digits, (size_t)size + 1);");
    outLine("            int power = exponent;");
    outLine("            lt_float_neighbor(candidate, precision, &power, direction);");
    outLine("            if (snprintf(adjacent, sizeof adjacent, \"%se%d\", candidate, power - precision + 1) < 0) return 0;");
    outLine("            if (strtod(adjacent, NULL) == positive) {");
    outLine("                memcpy(digits, candidate, (size_t)size + 1); exponent = power; found = 1;");
    outLine("            }");
    outLine("        }");
    outLine("    }");
    outLine("    if (!found) return 0;");
    outLine("    while (size > 1 && digits[size - 1] == '0') size--;");
    outLine("    int at = 0;");
    outLine("    if (negative) out[at++] = '-';");
    outLine("    if (exponent >= 21 || exponent < -6) {");
    outLine("        out[at++] = digits[0];");
    outLine("        if (size > 1) { out[at++] = '.'; memcpy(out + at, digits + 1, (size_t)size - 1); at += size - 1; }");
    outLine("        out[at++] = 'e';");
    outLine("        if (exponent >= 0) out[at++] = '+';");
    outLine("        int length = snprintf(out + at, 64u - (size_t)at, \"%d\", exponent);");
    outLine("        if (length < 0) return 0;");
    outLine("        at += length;");
    outLine("    } else if (exponent < 0) {");
    outLine("        out[at++] = '0'; out[at++] = '.';");
    outLine("        for (int i = -1; i > exponent; i--) out[at++] = '0';");
    outLine("        memcpy(out + at, digits, (size_t)size); at += size;");
    outLine("    } else {");
    outLine("        for (int i = 0; i <= exponent || i < size; i++) {");
    outLine("            if (i == exponent + 1) out[at++] = '.';");
    outLine("            out[at++] = i < size ? digits[i] : '0';");
    outLine("        }");
    outLine("    }");
    outLine("    out[at] = '\\0';");
    outLine("    return 1;");
    outLine("}");
    if (needPrint) {
        outLine("static int lt_print_float(double value) {");
        outLine("    char text[64];");
        outLine("    if (!lt_float_format(value, text)) return -1;");
        outLine("    return printf(\"%s\", text);");
        outLine("}");
    }
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(calls: Set<String>): Bool {
    usesIntHelper(calls, "lite_concat(")
}

/** Emits positioned portable division, guarding undefined C arithmetic unless `-fno-check-arithmetic` is set. */
emitIntDivideHelper := fn(config: optCfg.OptConfig): Unit {
    outLine("LT_INLINE int64_t lite_divide_int(int64_t left, int64_t right, size_t at) {");
    if config.checkArithmetic {
        outLine("    if (LT_UNLIKELY(right == 0)) { lt_int_fault(at, \"division by zero\"); }");
        outLine("    if (LT_UNLIKELY(left == INT64_MIN && right == -1)) { lt_int_fault(at, \"integer outside Int range\"); }");
    } else {
        outLine("    (void)at;");
    }
    outLine("    return left / right;");
    outLine("}");
    outLine("");
}

/** Emits positioned remainder, returning zero before C MIN%-1 would be undefined. */
emitIntRemainderHelper := fn(config: optCfg.OptConfig): Unit {
    outLine("LT_INLINE int64_t lite_remainder_int(int64_t left, int64_t right, size_t at) {");
    if config.checkArithmetic { outLine("    if (LT_UNLIKELY(right == 0)) { lt_int_fault(at, \"remainder by zero\"); }"); }
    else { outLine("    (void)at;"); }
    outLine("    if (LT_UNLIKELY(left == INT64_MIN && right == -1)) { return 0; }");
    outLine("    return left % right;");
    outLine("}");
    outLine("");
}

/** Emits positioned portable floor division, evaluating its operands once. */
emitIntFloorDivideHelper := fn(): Unit {
    outLine("LT_INLINE int64_t lite_floor_divide_int(int64_t left, int64_t right, size_t at) {");
    outLine("    const int64_t quotient = lite_divide_int(left, right, at);");
    outLine("    const int64_t remainder = left % right;");
    outLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    outLine("}");
    outLine("");
}

/** Emits positioned floor modulo with a defined signed-minimum path. */
emitIntFloorModuloHelper := fn(config: optCfg.OptConfig): Unit {
    outLine("LT_INLINE int64_t lite_floor_modulo_int(int64_t left, int64_t right, size_t at) {");
    if config.checkArithmetic { outLine("    if (LT_UNLIKELY(right == 0)) { lt_int_fault(at, \"modulo by zero\"); }"); }
    else { outLine("    (void)at;"); }
    outLine("    if (LT_UNLIKELY(left == INT64_MIN && right == -1)) { return 0; }");
    outLine("    const int64_t remainder = left % right;");
    outLine("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    outLine("}");
    outLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: Set<String>, config: optCfg.OptConfig): Unit {
    if usesIntHelper(calls, "lite_divide_int(") or usesIntHelper(calls, "lite_floor_divide_int(") {
        emitIntDivideHelper(config);
    }
    if usesIntHelper(calls, "lite_remainder_int(") { emitIntRemainderHelper(config); }
    if usesIntHelper(calls, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(calls, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(config); }
    return;
}

/** Emits on-demand C11 helpers for Float bit casts and `unchecked*` operations (checked when `-fcheck-unchecked` is enabled). */
emitUncheckedCHelpers := fn(calls: Set<String>, config: optCfg.OptConfig): Unit {
    if usesIntHelper(calls, "lt_f32_to_bits(") {
        outLine("LT_INLINE uint32_t lt_f32_to_bits(float v) { uint32_t u = 0u; memcpy(&u, &v, 4u); return u; }");
    }
    if usesIntHelper(calls, "lt_f64_to_bits(") {
        outLine("LT_INLINE uint64_t lt_f64_to_bits(double v) { uint64_t u = 0u; memcpy(&u, &v, 8u); return u; }");
    }
    if usesIntHelper(calls, "lt_f32_from_bits(") {
        outLine("LT_INLINE float lt_f32_from_bits(uint32_t u, size_t at) {");
        outLine("    float v = 0.0f; memcpy(&v, &u, 4u);");
        if config.checkFloatFinite { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_f32_ufrom_bits(") {
        outLine("LT_INLINE float lt_f32_ufrom_bits(uint32_t u, size_t at) {");
        outLine("    float v = 0.0f; memcpy(&v, &u, 4u);");
        if config.checkUnchecked { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_f64_from_bits(") {
        outLine("LT_INLINE double lt_f64_from_bits(uint64_t u, size_t at) {");
        outLine("    double v = 0.0; memcpy(&v, &u, 8u);");
        if config.checkFloatFinite { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    if usesIntHelper(calls, "lt_f64_ufrom_bits(") {
        outLine("LT_INLINE double lt_f64_ufrom_bits(uint64_t u, size_t at) {");
        outLine("    double v = 0.0; memcpy(&v, &u, 8u);");
        if config.checkUnchecked { outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }"); }
        else { outLine("    (void)at;"); }
        outLine("    return v;");
        outLine("}");
    }
    fOps: List<String> = ["add", "sub", "mul", "div"];
    fSyms: List<String> = ["+", "-", "*", "/"];
    var foi := 0;
    loop foi < 4 {
        opN := fOps[foi];
        sym := fSyms[foi];
        if usesIntHelper(calls, "lt_uf" + opN + "_f64(") {
            outLine("LT_INLINE double lt_uf" + opN + "_f64(double a, double b, size_t at) {");
            if config.checkUnchecked { outLine("    return lt_float_op(a, b, " + foi.toText() + ", at);"); }
            else { outLine("    (void)at; return a " + sym + " b;"); }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_uf" + opN + "_f32(") {
            outLine("LT_INLINE float lt_uf" + opN + "_f32(float a, float b, size_t at) {");
            if config.checkUnchecked { outLine("    return lt_float32_op((double)a, (double)b, " + foi.toText() + ", at);"); }
            else { outLine("    (void)at; return (float)(a " + sym + " b);"); }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_uf" + opN + "_f16(") {
            outLine("LT_INLINE lt_f16 lt_uf" + opN + "_f16(lt_f16 a, lt_f16 b, size_t at) {");
            if config.checkUnchecked { outLine("    return lt_float16_op(lt_f16_to_f64(a), lt_f16_to_f64(b), " + foi.toText() + ", at);"); }
            else { outLine("    (void)at; return lt_f64_to_f16_unchecked(lt_f16_to_f64(a) " + sym + " lt_f16_to_f64(b));"); }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_uf" + opN + "_f8(") {
            outLine("LT_INLINE uint8_t lt_uf" + opN + "_f8(uint8_t a, uint8_t b, size_t at) {");
            if config.checkUnchecked { outLine("    return lt_float8_op(lt_f8_to_f64(a), lt_f8_to_f64(b), " + foi.toText() + ", at);"); }
            else { outLine("    (void)at; return lt_f64_to_f8(lt_f8_to_f64(a) " + sym + " lt_f8_to_f64(b), 0);"); }
            outLine("}");
        }
        foi += 1;
    }
    if usesIntHelper(calls, "lt_ufma_f64(") {
        outLine("LT_INLINE double lt_ufma_f64(double a, double b, double c, size_t at) {");
        if config.checkUnchecked { outLine("    return lt_fma_f64(a, b, c, at);"); } else { outLine("    (void)at; return fma(a, b, c);"); }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ufma_f32(") {
        outLine("LT_INLINE float lt_ufma_f32(float a, float b, float c, size_t at) {");
        if config.checkUnchecked { outLine("    return lt_fma_f32(a, b, c, at);"); } else { outLine("    (void)at; return fmaf(a, b, c);"); }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ufma_f16(") {
        outLine("LT_INLINE lt_f16 lt_ufma_f16(lt_f16 a, lt_f16 b, lt_f16 c, size_t at) {");
        if config.checkUnchecked { outLine("    return lt_fma_f16(a, b, c, at);"); }
        else { outLine("    (void)at; return lt_f64_to_f16_unchecked(fma(lt_f16_to_f64(a), lt_f16_to_f64(b), lt_f16_to_f64(c)));"); }
        outLine("}");
    }
    if usesIntHelper(calls, "lt_ufma_f8(") {
        outLine("LT_INLINE uint8_t lt_ufma_f8(uint8_t a, uint8_t b, uint8_t c, size_t at) {");
        if config.checkUnchecked { outLine("    return lt_fma_f8(a, b, c, at);"); }
        else { outLine("    (void)at; return lt_f64_to_f8(fma(lt_f8_to_f64(a), lt_f8_to_f64(b), lt_f8_to_f64(c)), 0);"); }
        outLine("}");
    }
    if not usesUncheckedInt(calls) { return; }
    iTags: List<String> = ["i1","i2","i4","i8","i16","i32","i64","u1","u2","u4","u8","u16","u32","u64"];
    iBits: List<Int> = [1, 2, 4, 8, 16, 32, 64, 1, 2, 4, 8, 16, 32, 64];
    iCTypes: List<String> = ["int8_t","int8_t","int8_t","int8_t","int16_t","int32_t","int64_t","uint8_t","uint8_t","uint8_t","uint8_t","uint16_t","uint32_t","uint64_t"];
    var idx := 0;
    loop idx < 14 {
        t := iTags[idx];
        bits := iBits[idx];
        cT := iCTypes[idx];
        isSigned := idx < 7;
        uT := if isSigned { iCTypes[idx + 7] } else { cT };
        bText := bits.toText();
        loExpr := if bits == 64 { "INT64_MIN" } else { "-(INT64_C(1) << " + (bits - 1).toText() + ")" };
        hiExpr := if bits == 64 { "INT64_MAX" } else { "(INT64_C(1) << " + (bits - 1).toText() + ") - INT64_C(1)" };
        uMaxExpr := if bits == 64 { "UINT64_MAX" } else { "(UINT64_C(1) << " + bText + ") - UINT64_C(1)" };
        if usesIntHelper(calls, "lt_uadd_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_uadd_" + t + "(" + cT + " a, " + cT + " b, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")((" + uT + ")a + (" + uT + ")b);");
            } else if bits == 64 and isSigned {
                outLine("    int64_t out = 0; if (LT_UNLIKELY(__builtin_add_overflow(a, b, &out))) { lt_int_fault(at, \"integer outside Int range\"); } return out;");
            } else if bits == 64 {
                outLine("    uint64_t out = 0; if (LT_UNLIKELY(__builtin_add_overflow(a, b, &out))) { lt_int_fault(at, \"integer outside UInt64 range\"); } return out;");
            } else if isSigned {
                outLine("    int64_t r = (int64_t)a + (int64_t)b; if (LT_UNLIKELY(r < " + loExpr + " || r > " + hiExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")r;");
            } else {
                outLine("    uint64_t r = (uint64_t)a + (uint64_t)b; if (LT_UNLIKELY(r > " + uMaxExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")r;");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_usub_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_usub_" + t + "(" + cT + " a, " + cT + " b, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")((" + uT + ")a - (" + uT + ")b);");
            } else if bits == 64 and isSigned {
                outLine("    int64_t out = 0; if (LT_UNLIKELY(__builtin_sub_overflow(a, b, &out))) { lt_int_fault(at, \"integer outside Int range\"); } return out;");
            } else if isSigned {
                outLine("    int64_t r = (int64_t)a - (int64_t)b; if (LT_UNLIKELY(r < " + loExpr + " || r > " + hiExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")r;");
            } else {
                outLine("    if (LT_UNLIKELY(a < b)) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")(a - b);");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_umul_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_umul_" + t + "(" + cT + " a, " + cT + " b, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")((" + uT + ")a * (" + uT + ")b);");
            } else if bits == 64 and isSigned {
                outLine("    int64_t out = 0; if (LT_UNLIKELY(__builtin_mul_overflow(a, b, &out))) { lt_int_fault(at, \"integer outside Int range\"); } return out;");
            } else if bits == 64 {
                outLine("    uint64_t out = 0; if (LT_UNLIKELY(__builtin_mul_overflow(a, b, &out))) { lt_int_fault(at, \"integer outside UInt64 range\"); } return out;");
            } else if isSigned {
                outLine("    int64_t r = (int64_t)a * (int64_t)b; if (LT_UNLIKELY(r < " + loExpr + " || r > " + hiExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")r;");
            } else {
                outLine("    uint64_t r = (uint64_t)a * (uint64_t)b; if (LT_UNLIKELY(r > " + uMaxExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")r;");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_udiv_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_udiv_" + t + "(" + cT + " a, " + cT + " b, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")(a / b);");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY(b == 0)) { lt_int_fault(at, \"division by zero\"); }");
                outLine("    if (LT_UNLIKELY((int64_t)a == " + loExpr + " && (int64_t)b == -1)) { lt_int_fault(at, \"integer overflow\"); }");
                outLine("    return (" + cT + ")((int64_t)a / (int64_t)b);");
            } else {
                outLine("    if (LT_UNLIKELY(b == 0)) { lt_int_fault(at, \"division by zero\"); } return (" + cT + ")(a / b);");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_urem_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_urem_" + t + "(" + cT + " a, " + cT + " b, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")(a % b);");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY(b == 0)) { lt_int_fault(at, \"remainder by zero\"); }");
                outLine("    if (LT_UNLIKELY((int64_t)a == " + loExpr + " && (int64_t)b == -1)) { return (" + cT + ")0; }");
                outLine("    return (" + cT + ")((int64_t)a % (int64_t)b);");
            } else {
                outLine("    if (LT_UNLIKELY(b == 0)) { lt_int_fault(at, \"remainder by zero\"); } return (" + cT + ")(a % b);");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_uneg_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_uneg_" + t + "(" + cT + " a, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")((" + uT + ")0u - (" + uT + ")a);");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY((int64_t)a == " + loExpr + ")) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")(-(int64_t)a);");
            } else {
                outLine("    if (LT_UNLIKELY(a != 0)) { lt_int_fault(at, \"integer overflow\"); } return (" + cT + ")0;");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_ushl_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_ushl_" + t + "(" + cT + " a, int64_t n, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")((" + uT + ")a << (unsigned)n);");
            } else if isSigned and bits == 64 {
                outLine("    if (LT_UNLIKELY(n < 0 || n >= 64)) { lt_int_fault(at, \"shift count out of range\"); } return (int64_t)(((uint64_t)a) << (unsigned)n);");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY(n < 0 || n >= " + bText + ")) { lt_int_fault(at, \"shift count out of range\"); }");
                outLine("    uint64_t m = (UINT64_C(1) << " + bText + ") - UINT64_C(1); uint64_t s = UINT64_C(1) << " + (bits - 1).toText() + ";");
                outLine("    uint64_t r = (((uint64_t)a) << (unsigned)n) & m; return (" + cT + ")((r & s) ? (int64_t)(r | ~m) : (int64_t)r);");
            } else {
                outLine("    if (LT_UNLIKELY(n < 0 || n >= " + bText + ")) { lt_int_fault(at, \"shift count out of range\"); }");
                outLine("    uint64_t r = ((uint64_t)a) << (unsigned)n;");
                if bits < 64 { outLine("    r &= " + uMaxExpr + ";"); }
                outLine("    return (" + cT + ")r;");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_ushr_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_ushr_" + t + "(" + cT + " a, int64_t n, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")(a >> (unsigned)n);");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY(n < 0 || n >= " + bText + ")) { lt_int_fault(at, \"shift count out of range\"); }");
                outLine("    return (" + cT + ")((a >= 0) ? (int64_t)((uint64_t)a >> (unsigned)n) : (int64_t)(~((~(uint64_t)a) >> (unsigned)n)));");
            } else {
                outLine("    if (LT_UNLIKELY(n < 0 || n >= " + bText + ")) { lt_int_fault(at, \"shift count out of range\"); }");
                outLine("    return (" + cT + ")((uint64_t)a >> (unsigned)n);");
            }
            outLine("}");
        }
        if usesIntHelper(calls, "lt_utrunc_" + t + "(") {
            outLine("LT_INLINE " + cT + " lt_utrunc_" + t + "(double v, size_t at) {");
            if not config.checkUnchecked {
                outLine("    (void)at; return (" + cT + ")v;");
            } else if isSigned {
                outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }");
                outLine("    double tr = trunc(v);");
                if bits == 64 { outLine("    if (LT_UNLIKELY(tr < -9223372036854775808.0 || tr >= 9223372036854775808.0)) { lt_int_fault(at, \"integer overflow\"); }"); }
                else { outLine("    if (LT_UNLIKELY(tr < -(double)(UINT64_C(1) << " + (bits - 1).toText() + ") || tr >= (double)(UINT64_C(1) << " + (bits - 1).toText() + "))) { lt_int_fault(at, \"integer overflow\"); }"); }
                outLine("    return (" + cT + ")tr;");
            } else {
                outLine("    if (LT_UNLIKELY(!isfinite(v))) { lt_int_fault(at, \"non-finite floating value\"); }");
                outLine("    double tr = trunc(v);");
                if bits == 64 { outLine("    if (LT_UNLIKELY(tr < 0.0 || tr >= 18446744073709551616.0)) { lt_int_fault(at, \"integer overflow\"); }"); }
                else { outLine("    if (LT_UNLIKELY(tr < 0.0 || tr >= (double)(UINT64_C(1) << " + bText + "))) { lt_int_fault(at, \"integer overflow\"); }"); }
                outLine("    return (" + cT + ")tr;");
            }
            outLine("}");
        }
        idx += 1;
    }
};

/** Emits the checked UTF-8 byte concatenation helper backed by SSO (<= 14B) or `lt_vm_arena`. */
emitStringConcatHelper := fn(): Unit {
    outLine("static lt_str lite_concat(lt_str left, lt_str right) {");
    outLine("    const size_t ll = lt_str_byte_len(left);");
    outLine("    if (ll == 0u) { return right; }");
    outLine("    const size_t rl = lt_str_byte_len(right);");
    outLine("    if (rl == 0u) { return left; }");
    outLine("    const size_t total = ll + rl;");
    outLine("    const char *ld = lt_str_data(&left);");
    outLine("    const char *rd = lt_str_data(&right);");
    outLine("    if (total <= 14u) {");
    outLine("        lt_str r = LT_EMPTY_STR;");
    outLine("        memcpy(r.sso.buf, ld, ll);");
    outLine("        memcpy(r.sso.buf + ll, rd, rl);");
    outLine("        r.sso.tag = (uint8_t)total;");
    outLine("        return r;");
    outLine("    }");
    outLine("    const int64_t lcp = lt_str_cp_len_known(left);");
    outLine("    const int64_t rcp = lt_str_cp_len_known(right);");
    outLine("    int64_t cp = (lcp >= 0 && rcp >= 0) ? (lcp + rcp) : -1;");
    outLine("    if (total >= (size_t)UINT32_MAX) {");
    outLine("        lt_str r = lt_str_make_jumbo(NULL, total, cp);");
    outLine("        char *dst = (char *)(uintptr_t)r.ext.data;");
    outLine("        memcpy(dst, ld, ll); memcpy(dst + ll, rd, rl);");
    outLine("        return r;");
    outLine("    }");
    outLine("    char *combined = lt_str_alloc(total + 1u);");
    outLine("    memcpy(combined, ld, ll);");
    outLine("    memcpy(combined + ll, rd, rl);");
    outLine("    combined[total] = '\\0';");
    outLine("    return (lt_str){ .ext = { .data = combined, .byte_len = (uint32_t)total, .meta = lt_str_pack_meta(cp) } };");
    outLine("}");
    outLine("");
}

/** Evaluates one multi-value output argument into a hygienic scalar temporary, preserving non-trivial Unit/Never side effects. */
emitOutputArgument := fn(kind: String, code: String, name: String, indent: String): Unit {
    if code.startsWithAt(0, "/*@CBLK:") {
        endHdr := code.indexOf("@*/", 8);
        retVar := code.slice(8, endHdr);
        blkBody := code.slice(endHdr + 3, code.length());
        if kind == frontend.VALUE_KIND_NEVER or kind == frontend.VALUE_KIND_UNIT {
            outLine(indent + "{ " + blkBody + " }");
        } else {
            outLine(indent + cScalarType(kind) + " " + name + ";");
            outLine(indent + "{ " + blkBody + " " + name + " = " + retVar + "; }");
        }
        return;
    }
    if kind == frontend.VALUE_KIND_NEVER {
        outLine(indent + "(void)(" + code + ");");
        return;
    }
    if kind == frontend.VALUE_KIND_UNIT {
        if code =!= "0" { outLine(indent + "(void)(" + code + ");"); }
        return;
    }
    typeCode := cScalarType(kind) + " ";
    outLine(indent + typeCode + name + " = " + code + ";");
}

/** Emits a preserved comment or doc block with per-line `indent`. */
emitCComment := fn(indent: String, commentText: String): Unit {
    n := commentText.length();
    var start := 0;
    loop start <= n {
        nl := commentText.indexOf("\n", start);
        end := if nl >= 0 { nl } else { n };
        rawLine := commentText.slice(start, end);
        cleanLine := if start == 0 { rawLine } else { rawLine.trimStart() };
        if start == 0 or cleanLine =!= "" {
            outLine(indent + cleanLine);
        } else {
            outLine("");
        }
        if nl < 0 { break; }
        start = nl + 1;
    }
};

/** Formats one output write after every argument has evaluated successfully. */
outputWriteCode := fn(kind: String, code: String, indent: String, failAction: String): String {
    indent + "if (" + cCall(kind, code) + " < 0) { " + failAction + " }\n"
}

/** Unwraps a binding-position single-accumulator CBLK loop into a flat declaration + loop when strictly equivalent with zero extra overhead. */
tryUnwrapDirectCLoopBinding := fn(cTypePrefix: String, targetName: String, isHoistedGlobal: Bool, retVar: String, blkBody: String): (ok: Bool, declLine: String, loopLine: String) {
    if retVar == "" or retVar == "0" {
        return (ok = false, declLine = "", loopLine = "");
    }
    trimmed := blkBody.trim();
    retEq := retVar + " = ";
    p1 := cTypePrefix + retEq;
    p2 := cTypePrefix.trimEnd() + " " + retEq;
    initStart := if trimmed.startsWithAt(0, p1) {
        p1.length()
    } else if trimmed.startsWithAt(0, p2) {
        p2.length()
    } else {
        -1
    };
    if initStart < 0 {
        return (ok = false, declLine = "", loopLine = "");
    }
    semiPos := emitFmt.findTopLevelSemi(trimmed, initStart);
    if semiPos < 0 {
        return (ok = false, declLine = "", loopLine = "");
    }
    initExpr := trimmed.slice(initStart, semiPos);
    rest := trimmed.slice(semiPos + 1, trimmed.length()).trim();
    if not emitFmt.isSingleScopedLoopStmt(rest) {
        return (ok = false, declLine = "", loopLine = "");
    }
    if emitFmt.codeUsesIdent(initExpr, targetName) or emitFmt.codeUsesIdent(rest, targetName) or emitFmt.codeUsesIdent(initExpr, retVar) {
        return (ok = false, declLine = "", loopLine = "");
    }
    declLine := if isHoistedGlobal { targetName + " = " + initExpr + ";" } else { cTypePrefix + targetName + " = " + initExpr + ";" };
    loopLine := emitFmt.replaceIdentToken(rest, retVar, targetName);
    (ok = true, =declLine, =loopLine)
};

/** True when `s[start..end)` is a non-empty ASCII decimal digit run. */
isCAsciiDigits := fn(s: String, start: Int, end: Int): Bool {
    if end <= start { return false; }
    var i := start;
    loop i < end {
        if not s.at(i).isDigit() { return false; }
        i += 1;
    }
    true
};

/** True when `code` is a pure C11 compile-time Int64 constant expression (`INT64_C(...)`, `(-INT64_C(...))`, `INT64_MIN`, digits). */
isCStaticConstIntCode := fn(code: String): Bool {
    n := code.length();
    if code == "INT64_MIN" or code == "INT64_MAX" { return true; }
    if code.startsWithAt(0, "INT64_C(") and code.endsWith(")") {
        return isCAsciiDigits(code, 8, n - 1);
    }
    if code.startsWithAt(0, "UINT64_C(") and code.endsWith(")") {
        return isCAsciiDigits(code, 9, n - 1);
    }
    if code.startsWithAt(0, "(-INT64_C(") and code.endsWith("))") {
        return isCAsciiDigits(code, 10, n - 2);
    }
    if code.startsWithAt(0, "-") {
        return isCAsciiDigits(code, 1, n);
    }
    isCAsciiDigits(code, 0, n)
};

/** True when `code` is a pure C11 `LT_STR_SSO("...", N)`, `LT_STR_LIT("...", N)`, or `LT_ASTR("...")` constant expression. */
isCStaticConstStrCode := fn(code: String): Bool {
    n := code.length();
    if code.startsWithAt(0, "LT_STR_SSO(\"") and code.endsWith(")") {
        strEnd := frontend.skipAliasString(code, 11);
        if strEnd >= n or not code.startsWithAt(strEnd, ", ") { return false; }
        return isCAsciiDigits(code, strEnd + 2, n - 1);
    }
    if code.startsWithAt(0, "LT_STR_LIT(\"") and code.endsWith(")") {
        strEnd := frontend.skipAliasString(code, 11);
        if strEnd >= n or not code.startsWithAt(strEnd, ", ") { return false; }
        return isCAsciiDigits(code, strEnd + 2, n - 1);
    }
    if code.startsWithAt(0, "LT_ASTR(\"") and code.endsWith(")") {
        strEnd := frontend.skipAliasString(code, 8);
        return strEnd == n - 1;
    }
    false
};

/** True when top-level immutable binding `(kind, code)` can be emitted as a file-scope `static const` C11 constant. */
isCStaticConstScalarInit := fn(kind: String, code: String): Bool {
    if kind == frontend.ITEM_KIND_LOCAL_BOOL {
        return code == "true" or code == "false";
    }
    if kind == frontend.ITEM_KIND_LOCAL_INT {
        return isCStaticConstIntCode(code);
    }
    if kind == frontend.ITEM_KIND_LOCAL_STRING {
        return isCStaticConstStrCode(code);
    }
    false
};

/** Returns the LiteScript type kind of a local decl or assignment if it needs deterministic `_drop`, or `""`. */
cItemOwnedKind := fn(item: frontend.Item): String {
    k := item.kind;
    if k == frontend.ITEM_KIND_LOCAL_LIST or k == frontend.ITEM_KIND_VAR_LIST or k == frontend.ITEM_KIND_ASSIGN_LIST or
    k == frontend.ITEM_KIND_LOCAL_TUPLE or k == frontend.ITEM_KIND_VAR_TUPLE or k == frontend.ITEM_KIND_ASSIGN_TUPLE or
    k == frontend.ITEM_KIND_LOCAL_RECORD or k == frontend.ITEM_KIND_VAR_RECORD or k == frontend.ITEM_KIND_ASSIGN_RECORD or
    k == frontend.ITEM_KIND_LOCAL_FN or k == frontend.ITEM_KIND_VAR_FN or k == frontend.ITEM_KIND_ASSIGN_FN {
        if frontend.cTypeNeedsDrop(item.textValue) { return item.textValue; }
    }
    ""
};

/** True when C11 expression `code` is a plain borrowable lvalue (not an owned temporary rvalue). */
isCBorrowableCLval := fn(code: String): Bool {
    var c := code.trim();
    if c == "" or c.indexOf("/*@CBLK:", 0) >= 0 or c.indexOf("{", 0) >= 0 { return false; }
    loop c.length() > 0 {
        if c.startsWithAt(0, "(*") and c.endsWith(")") {
            inner := c.slice(2, c.length() - 1).trim();
            if (inner.startsWithAt(0, "lite_") or inner.startsWithAt(0, "lt_cell_")) and inner.skipName(0) == inner.length() {
                return true;
            }
            return false;
        }
        dotPos := cLastIndexOfStr(c, ".f_");
        if dotPos > 0 {
            fPart := c.slice(dotPos + 1, c.length());
            if fPart.skipName(0) == fPart.length() {
                lhs := c.slice(0, dotPos).trim();
                if lhs.startsWithAt(0, "(") and lhs.endsWith(")") { c = lhs.slice(1, lhs.length() - 1).trim(); }
                else { c = lhs; }
                continue;
            }
        }
        break;
    }
    (c.startsWithAt(0, "lite_") or c.startsWithAt(0, "lt_") or c.startsWithAt(0, "_")) and c.skipName(0) == c.length()
};

/** Counts whole-identifier occurrences of `ident` in `code` outside strings and `/*@CFN_START:...*/` blocks. */
countCIdentOcc := fn(code: String, ident: String): Int {
    if ident == "" or code.indexOf(ident, 0) < 0 { return 0; }
    size := code.length();
    idLen := ident.length();
    firstCh := ident.at(0);
    var count := 0;
    var cursor := 0;
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := code.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CFN_START:") {
            cursor = skipCFnBlock(code, cursor);
        } else if ch == firstCh and code.startsWithAt(cursor, ident) and
        (cursor == 0 or not code.at(cursor - 1).isNameContinue()) and
        (cursor + idLen >= size or not code.at(cursor + idLen).isNameContinue()) {
            count = count + 1;
            cursor = cursor + idLen;
        } else {
            cursor = cursor + 1;
        }
    }
    count
};

/** Builds C cleanup statements for `owned` entries with `depth >= minDepth` in reverse declaration order. */
buildScopeDropStmt := fn(owned: List<(rt: String, kind: String, depth: Int)>, minDepth: Int): String {
    buf: mut tb.TextBuilder;
    var i := owned.length() - 1;
    loop i >= 0 {
        o := owned[i];
        if o.depth >= minDepth {
            dFn := frontend.cDropFnForKind(o.kind);
            if dFn =!= "" {
                mut buf.append(dFn);
                mut buf.append("(&");
                mut buf.append(o.rt);
                mut buf.append("); ");
            }
        }
        i = i - 1;
    }
    buf.build().trim()
};

/** True when every occurrence of `rt` in `normCode` is a verified non-escaping list operation or `const *`/`&` borrow. */
isSafeScopeListUsage := fn(normCode: String, rt: String, lType: String): Bool {
    if normCode.indexOf("/*@CFN_START:", 0) >= 0 or normCode.indexOf("/*@CBLK:", 0) >= 0 or
    normCode.indexOf("lt_mk_", 0) >= 0 or normCode.indexOf("_call(", 0) >= 0 or
    normCode.indexOf(lType + "_copy(", 0) >= 0 or normCode.indexOf(lType + "_move(", 0) >= 0 {
        return false;
    }
    size := normCode.length();
    idLen := rt.length();
    firstCh := rt.at(0);
    var cursor := 0;
    loop cursor < size {
        ch := normCode.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := normCode.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == firstCh and normCode.startsWithAt(cursor, rt) and
        (cursor == 0 or not normCode.at(cursor - 1).isNameContinue()) and
        (cursor + idLen >= size or not normCode.at(cursor + idLen).isNameContinue()) {
            byAmp := (cursor >= 1 and normCode.at(cursor - 1) == "&") or
            (cursor >= 2 and normCode.startsWithAt(cursor - 2, "&("));
            bySafeHelper := (cursor >= lType.length() + 5 and normCode.startsWithAt(cursor - (lType.length() + 5), lType + "_len(")) or
            (cursor >= lType.length() + 4 and normCode.startsWithAt(cursor - (lType.length() + 4), lType + "_at(")) or
            (cursor >= lType.length() + 5 and normCode.startsWithAt(cursor - (lType.length() + 5), lType + "_uat(")) or
            (cursor >= lType.length() + 7 and normCode.startsWithAt(cursor - (lType.length() + 7), lType + "_print(")) or
            (cursor >= lType.length() + 9 and normCode.startsWithAt(cursor - (lType.length() + 9), lType + "_reverse(")) or
            (cursor >= lType.length() + 7 and normCode.startsWithAt(cursor - (lType.length() + 7), lType + "_slice(")) or
            (cursor >= lType.length() + 12 and normCode.startsWithAt(cursor - (lType.length() + 12), lType + "_slice_from("));
            if not byAmp and not bySafeHelper {
                return false;
            }
            cursor = cursor + idLen;
        } else {
            cursor = cursor + 1;
        }
    }
    true
};

/** Returns function-level (`depth == 0`, `loopDepth == 0`) `List<T>` variable runtimes safe to allocate on `lt_tl_ctx.scope`. */
analyzeFnScopeLists := fn(stream: frontend.Items): Set<String> {
    out: mut Set<String>;
    n := stream.length();
    depths: mut List<Int> = [];
    loopDepths: mut List<Int> = [];
    var d := 0;
    var ld := 0;
    var i := 0;
    loop i < n {
        it := stream[i];
        mut depths.pushBack(d);
        mut loopDepths.pushBack(ld);
        if it.kind == frontend.ITEM_KIND_SCOPE or it.kind == frontend.ITEM_KIND_IF { d += 1; }
        else if it.kind == frontend.ITEM_KIND_END_IF or it.kind == frontend.ITEM_KIND_END_SCOPE { if d > 0 { d -= 1; } }
        else if it.kind == frontend.ITEM_KIND_LOOP or it.kind == frontend.ITEM_KIND_LOOP_SEQ { d += 1; ld += 1; }
        else if it.kind == frontend.ITEM_KIND_END_LOOP { if d > 0 { d -= 1; } if ld > 0 { ld -= 1; } }
        i = i + 1;
    }
    i = 0;
    loop i < n {
        it := stream[i];
        if (it.kind == frontend.ITEM_KIND_LOCAL_LIST or it.kind == frontend.ITEM_KIND_VAR_LIST) and
        depths[i] == 0 and loopDepths[i] == 0 and frontend.isListKind(it.textValue) {
            elTag := frontend.cListTag(frontend.listElementKind(it.textValue));
            normInit := normalizeCBuiltinCalls(it.code);
            if elTag =!= "" and normInit.startsWithAt(0, "lt_list_" + elTag + "_from(") {
                lType := "lt_list_" + elTag;
                rt := it.runtime;
                var safe := true;
                var j := i + 1;
                loop j < n {
                    it2 := stream[j];
                    if isCLocalDeclKind(it2.kind) and it2.runtime == rt { break; }
                    if isCAssignKind(it2.kind) and it2.runtime == rt { safe = false; break; }
                    norm2 := normalizeCBuiltinCalls(it2.code);
                    if countCIdentOcc(norm2, rt) > 0 {
                        if it2.kind == frontend.ITEM_KIND_LOOP_SEQ {
                            if it2.intValue =!= 1 or norm2.trim() =!= rt { safe = false; break; }
                        } else if not isSafeScopeListUsage(norm2, rt, lType) {
                            safe = false; break;
                        }
                    }
                    j = j + 1;
                }
                if safe { mut out.add(rt); }
            }
        }
        i = i + 1;
    }
    out
};

/** Computes safe Move-on-Last-Use rewrites (`itemIdx -> "rt|copyFn|moveFn"`) for owned non-scope local variables. */
analyzeMoveLastUses := fn(stream: frontend.Items, hoistedGlobals: frontend.TokenBuckets, scopeLists: Set<String>): Map<Int, String> {
    out: mut Map<Int, String>;
    n := stream.length();
    depths: mut List<Int> = [];
    loopDepths: mut List<Int> = [];
    var d := 0;
    var ld := 0;
    var i := 0;
    loop i < n {
        it := stream[i];
        mut depths.pushBack(d);
        mut loopDepths.pushBack(ld);
        if it.kind == frontend.ITEM_KIND_SCOPE or it.kind == frontend.ITEM_KIND_IF { d += 1; }
        else if it.kind == frontend.ITEM_KIND_END_IF or it.kind == frontend.ITEM_KIND_END_SCOPE { if d > 0 { d -= 1; } }
        else if it.kind == frontend.ITEM_KIND_LOOP or it.kind == frontend.ITEM_KIND_LOOP_SEQ { d += 1; ld += 1; }
        else if it.kind == frontend.ITEM_KIND_END_LOOP { if d > 0 { d -= 1; } if ld > 0 { ld -= 1; } }
        i = i + 1;
    }
    i = 0;
    loop i < n {
        it := stream[i];
        ownedK := cItemOwnedKind(it);
        rt := it.runtime;
        if isCLocalDeclKind(it.kind) and ownedK =!= "" and rt =!= "" and
        not frontend.tokenBucketHas(hoistedGlobals, rt) and not scopeLists.has(rt) {
            ops := cKindOps(ownedK);
            if ops.copyFn =!= "" and ops.moveFn =!= "" {
                declD := depths[i];
                declLD := loopDepths[i];
                var lastIdx := -1;
                var lastCount := 0;
                var lastD := -1;
                var lastLD := -1;
                var reassigned := false;
                var outCount := 0;
                var j := i + 1;
                loop j < n {
                    it2 := stream[j];
                    if depths[j] < declD { break; }
                    if isCLocalDeclKind(it2.kind) and it2.runtime == rt and depths[j] == declD { break; }
                    if isCAssignKind(it2.kind) and it2.runtime == rt { reassigned = true; break; }
                    if it2.kind == frontend.ITEM_KIND_END or it2.kind == frontend.ITEM_KIND_END_OUTPUT {
                        outCount = 0;
                        j = j + 1;
                        continue;
                    }
                    isCtrl := it2.kind == frontend.ITEM_KIND_SCOPE or it2.kind == frontend.ITEM_KIND_END_SCOPE or
                    it2.kind == frontend.ITEM_KIND_IF or it2.kind == frontend.ITEM_KIND_ELSE_IF or it2.kind == frontend.ITEM_KIND_ELSE or
                    it2.kind == frontend.ITEM_KIND_END_IF or it2.kind == frontend.ITEM_KIND_LOOP or it2.kind == frontend.ITEM_KIND_END_LOOP or
                    it2.kind == frontend.ITEM_KIND_COMMENT or it2.kind == frontend.ITEM_KIND_SOURCE_LOC or it2.kind == frontend.ITEM_KIND_IMPORT or
                    it2.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or it2.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP or
                    it2.kind == frontend.ITEM_KIND_PUBLIC_VALUE or it2.kind == frontend.ITEM_KIND_PUBLIC_TYPE or it2.kind == frontend.ITEM_KIND_NOOP;
                    isOutArg := not isCtrl and not isCLocalDeclKind(it2.kind) and not isCAssignKind(it2.kind) and
                    it2.kind =!= frontend.ITEM_KIND_RETURN and it2.kind =!= frontend.ITEM_KIND_CALL and it2.kind =!= frontend.ITEM_KIND_DISCARD and
                    it2.kind =!= frontend.ITEM_KIND_LOOP_SEQ and it2.kind =!= frontend.ITEM_KIND_BREAK and it2.kind =!= frontend.ITEM_KIND_CONTINUE and
                    it2.kind =!= frontend.ITEM_KIND_UNREACHABLE;
                    if isOutArg { outCount = outCount + 1; }
                    norm2 := normalizeCBuiltinCalls(it2.code);
                    occ := countCIdentOcc(norm2, rt);
                    if occ > 0 {
                        lastIdx = j;
                        lastCount = occ;
                        lastD = depths[j];
                        lastLD = loopDepths[j];
                    }
                    j = j + 1;
                }
                if not reassigned and lastIdx >= 0 and lastCount == 1 and lastLD == declLD and not out.has(lastIdx) {
                    lk := stream[lastIdx].kind;
                    if (lastD == declD or lk == frontend.ITEM_KIND_RETURN) and
                    (isCLocalDeclKind(lk) or isCAssignKind(lk) or lk == frontend.ITEM_KIND_RETURN or lk == frontend.ITEM_KIND_CALL) {
                        mut out.set(lastIdx, rt + "|" + ops.copyFn + "|" + ops.moveFn);
                    }
                }
            }
        }
        i = i + 1;
    }
    out
};

/** Emits statements for one C function body (`fnResult != ""`) or `main` (`fnResult == ""`). */
emitCItemStream := fn(stream: frontend.Items, hoistedGlobals: frontend.TokenBuckets, constHoistedGlobals: frontend.TokenBuckets, fnResult: String, failAction: String, scopeLists: Set<String>, restrictSliceParams: Set<String>): Unit {
    moveMap := analyzeMoveLastUses(stream, hoistedGlobals, scopeLists);
    hasScopeMark := scopeLists.size() > 0;
    var indent := "    ";
    var blockDepth := 0;
    var count := 0;
    var tempIndex := 0;
    var firstKind := "";
    var firstCode := "";
    var firstTemp := "";
    writes: mut tb.TextBuilder;
    multiOutputDrops: mut List<(tmp: String, kind: String)> = [];
    var seqLoopId := 0;
    loopSeqFlags: mut List<Int> = [];
    loopSeqReleases: mut List<String> = [];
    scopeOwned: mut List<(rt: String, kind: String, depth: Int)> = [];
    loopOwnedDepths: mut List<Int> = [];
    var pendingLocFile := "";
    var pendingLocLine := 0;
    var pendingLocCol := "";
    var lastEmittedLocFile := "";
    var lastEmittedLocLine := 0;
    var streamIdx := -1;
    loop stream as item {
        streamIdx = streamIdx + 1;
        if item.kind == frontend.ITEM_KIND_COMMENT {
            emitCComment(indent, item.code);
            continue;
        }
        if item.kind == frontend.ITEM_KIND_SOURCE_LOC {
            pendingLocFile = item.name;
            pendingLocLine = item.intValue;
            pendingLocCol = item.code;
            continue;
        }
        if cSourceMapMode =!= optCfg.SourceMapMode.None and pendingLocLine > 0 and
        item.kind =!= frontend.ITEM_KIND_IMPORT and item.kind =!= frontend.ITEM_KIND_PUBLIC_FUNCTION and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE_OP and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_VALUE and item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE and
        item.kind =!= frontend.ITEM_KIND_SOFT_BUILTIN and item.kind =!= frontend.ITEM_KIND_NOOP and
        item.kind =!= frontend.ITEM_KIND_END_IF and item.kind =!= frontend.ITEM_KIND_ELSE and
        item.kind =!= frontend.ITEM_KIND_ELSE_IF and item.kind =!= frontend.ITEM_KIND_END_LOOP and
        item.kind =!= frontend.ITEM_KIND_END_SCOPE and item.kind =!= frontend.ITEM_KIND_MAIN_STOP {
            if pendingLocFile =!= lastEmittedLocFile or pendingLocLine =!= lastEmittedLocLine {
                dispFile := if pendingLocFile =!= "" { pendingLocFile } else { "<stdin>" };
                if cSourceMapMode == optCfg.SourceMapMode.Lines {
                    outLine("#line " + pendingLocLine.toText() + " " + cLiteral.textLiteralCode(dispFile));
                } else {
                    outLine(indent + "// " + dispFile + ":" + pendingLocLine.toText() + ":" + pendingLocCol);
                }
                lastEmittedLocFile = pendingLocFile;
                lastEmittedLocLine = pendingLocLine;
            }
            pendingLocLine = 0;
        }
        var code := normalizeCBuiltinCalls(item.code);
        if isCLocalDeclKind(item.kind) and scopeLists.has(item.runtime) {
            elTagS := frontend.cListTag(frontend.listElementKind(item.textValue));
            fromTok := "lt_list_" + elTagS + "_from(";
            if code.startsWithAt(0, fromTok) {
                code = "lt_list_" + elTagS + "_from_scope(" + code.slice(fromTok.length(), code.length());
            }
        }
        mvSpec := moveMap.get(streamIdx);
        if mvSpec.found {
            p1 := mvSpec.value.indexOf("|", 0);
            p2 := mvSpec.value.indexOf("|", p1 + 1);
            mvRt := mvSpec.value.slice(0, p1);
            mvCopy := mvSpec.value.slice(p1 + 1, p2);
            mvMove := mvSpec.value.slice(p2 + 1, mvSpec.value.length());
            copyPat := mvCopy + "(" + mvRt + ")";
            moveRep := mvMove + "(&" + mvRt + ")";
            if code.indexOf(copyPat, 0) >= 0 {
                code = frontend.cReplaceExactToken(code, copyPat, moveRep);
            } else if item.kind == frontend.ITEM_KIND_RETURN and code.trim() == mvRt {
                code = moveRep;
            }
        }
        if code.indexOf("/*@CBLK:", 0) >= 0 {
            curRetDrop := buildScopeDropStmt(scopeOwned, 0);
            var lrIdx := loopSeqReleases.length() - 1;
            lrBuf: mut tb.TextBuilder;
            if curRetDrop =!= "" { mut lrBuf.append(curRetDrop); mut lrBuf.append(" "); }
            loop lrIdx >= 0 {
                rel := loopSeqReleases[lrIdx];
                if rel =!= "" { mut lrBuf.append(rel); mut lrBuf.append(" "); }
                lrIdx = lrIdx - 1;
            }
            if hasScopeMark { mut lrBuf.append("lt_vm_arena_rewind(&lt_tl_ctx.scope, lt_scope_mk);"); }
            curLoopDrop := if loopOwnedDepths.length() > 0 { buildScopeDropStmt(scopeOwned, loopOwnedDepths[loopOwnedDepths.length() - 1]) } else { "" };
            fullRetDrop := lrBuf.build().trim();
            if fullRetDrop =!= "" or curLoopDrop =!= "" {
                code = frontend.cRewriteExitDrops(code, fullRetDrop, curLoopDrop, fnResult, streamIdx + 10000);
            }
        }
        if isCLocalDeclKind(item.kind) {
            if code.startsWithAt(0, "/*@CBLK:") {
                endHdr := code.indexOf("@*/", 8);
                retVar := code.slice(8, endHdr);
                blkBody := code.slice(endHdr + 3, code.length());
                isHoisted := fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime);
                cTypePrefix := cDeclTypeItem(item);
                unwrappedLoop := tryUnwrapDirectCLoopBinding(cTypePrefix, item.runtime, isHoisted, retVar, blkBody);
                if unwrappedLoop.ok {
                    outLine(indent + unwrappedLoop.declLine);
                    outLine(indent + unwrappedLoop.loopLine);
                } else {
                    if not isHoisted {
                        outLine(indent + cTypePrefix + item.runtime + ";");
                    }
                    outLine(indent + "{ " + blkBody + " " + item.runtime + " = " + retVar + "; }");
                }
            } else if fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime) {
                if not frontend.tokenBucketHas(constHoistedGlobals, item.runtime) {
                    outLine(indent + item.runtime + " = " + code + ";");
                }
            } else {
                outLine(indent + cDeclTypeItem(item) + item.runtime + " = " + code + ";");
            }
            outLine(indent + "(void)" + item.runtime + ";");
            ownedK := cItemOwnedKind(item);
            if ownedK =!= "" {
                isHoistedG := fnResult == "" and blockDepth == 0 and frontend.tokenBucketHas(hoistedGlobals, item.runtime);
                mut scopeOwned.pushBack((rt = item.runtime, kind = ownedK, depth = if isHoistedG { -1 } else { blockDepth }));
            }
        } else if isCAssignKind(item.kind) {
            owKind := cItemOwnedKind(item);
            owDropFn := if owKind =!= "" { frontend.cDropFnForKind(owKind) } else { "" };
            if code.startsWithAt(0, "/*@CBLK:") {
                endHdr := code.indexOf("@*/", 8);
                retVar := code.slice(8, endHdr);
                blkBody := code.slice(endHdr + 3, code.length());
                dropPre := if owDropFn =!= "" { owDropFn + "(&" + item.runtime + "); " } else { "" };
                outLine(indent + "{ " + blkBody + " " + dropPre + item.runtime + " = " + retVar + "; }");
            } else if owDropFn =!= "" {
                outLine(indent + "{ " + cScalarType(owKind) + " lt_ow = " + code + "; " + owDropFn + "(&" + item.runtime + "); " + item.runtime + " = lt_ow; }");
            } else {
                outLine(indent + item.runtime + " = " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_RETURN {
            retDropsBuf: mut tb.TextBuilder;
            allDrop := buildScopeDropStmt(scopeOwned, 0);
            if allDrop =!= "" { mut retDropsBuf.append(allDrop); mut retDropsBuf.append(" "); }
            var lrIdx := loopSeqReleases.length() - 1;
            loop lrIdx >= 0 {
                rel := loopSeqReleases[lrIdx];
                if rel =!= "" { mut retDropsBuf.append(rel); mut retDropsBuf.append(" "); }
                lrIdx = lrIdx - 1;
            }
            if hasScopeMark { mut retDropsBuf.append("lt_vm_arena_rewind(&lt_tl_ctx.scope, lt_scope_mk); "); }
            retDrops := retDropsBuf.build().trim();
            if code.startsWithAt(0, "/*@CBLK:") {
                endHdr := code.indexOf("@*/", 8);
                retVar := code.slice(8, endHdr);
                blkBody := code.slice(endHdr + 3, code.length());
                if fnResult == frontend.VALUE_KIND_UNIT {
                    outLine(indent + "{ " + blkBody + (if retDrops =!= "" { " " + retDrops } else { "" }) + " } return;");
                } else if retVar == "0" {
                    outLine(indent + "{ " + blkBody + " }");
                } else {
                    outLine(indent + "{ " + cScalarType(fnResult) + " lt_ret; " + blkBody + " lt_ret = " + retVar + ";" + (if retDrops =!= "" { " " + retDrops } else { "" }) + " return lt_ret; }");
                }
            } else if fnResult == frontend.VALUE_KIND_UNIT {
                if code =!= "" { outLine(indent + "(void)(" + code + ");"); }
                if retDrops =!= "" { outLine(indent + retDrops); }
                outLine(indent + "return;");
            } else if code == "" {
                if retDrops =!= "" { outLine(indent + retDrops); }
                outLine(indent + "return;");
            } else if code.startsWithAt(0, "lt_exit(") {
                if retDrops =!= "" { outLine(indent + retDrops); }
                outLine(indent + "(void)(" + code + ");");
            } else if retDrops =!= "" {
                outLine(indent + "{ " + cScalarType(fnResult) + " lt_ret = " + code + "; " + retDrops + " return lt_ret; }");
            } else {
                outLine(indent + "return " + code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_CALL or item.kind == frontend.ITEM_KIND_DISCARD {
            discardDropFn := if item.kind == frontend.ITEM_KIND_DISCARD and item.name =!= "" { frontend.cDropFnForKind(item.name) } else { "" };
            if code.startsWithAt(0, "/*@CBLK:") {
                endHdr := code.indexOf("@*/", 8);
                retVar := code.slice(8, endHdr);
                blkBody := code.slice(endHdr + 3, code.length());
                if retVar =!= "" and retVar =!= "0" {
                    if discardDropFn =!= "" {
                        outLine(indent + "{ " + blkBody + " " + discardDropFn + "(&" + retVar + "); }");
                    } else {
                        outLine(indent + "{ " + blkBody + " (void)" + retVar + "; }");
                    }
                } else {
                    outLine(indent + "{ " + blkBody + " }");
                }
            } else if discardDropFn =!= "" and not isCBorrowableCLval(code) {
                outLine(indent + "{ " + cScalarType(item.name) + " lt_disc = " + code + "; " + discardDropFn + "(&lt_disc); }");
            } else if code.startsWithAt(0, "{ /*c-stmt*/") {
                trimmedCStmt := code.trim();
                if trimmedCStmt.endsWith("}") {
                    innerC := trimmedCStmt.slice(12, trimmedCStmt.length() - 1).trim();
                    if innerC.startsWithAt(0, "for (") or innerC.startsWithAt(0, "while (") or innerC.startsWithAt(0, "if (") {
                        outLine(indent + innerC);
                    } else {
                        outLine(indent + "{ " + innerC + " }");
                    }
                } else {
                    outLine(indent + code);
                }
            } else {
                outLine(indent + "(void)(" + code + ");");
            }
        } else if item.kind == frontend.ITEM_KIND_UNREACHABLE {
            outLine(indent + "fprintf(stderr, \"unreachable loop completion\\n\");");
            outLine(indent + "exit(1);");
        } else if item.kind == frontend.ITEM_KIND_BREAK or item.kind == frontend.ITEM_KIND_CONTINUE {
            topLD := if loopOwnedDepths.length() > 0 { loopOwnedDepths[loopOwnedDepths.length() - 1] } else { blockDepth };
            bDrop := buildScopeDropStmt(scopeOwned, topLD);
            if bDrop =!= "" {
                outLine(indent + "{ " + bDrop + " " + (if item.kind == frontend.ITEM_KIND_BREAK { "break;" } else { "continue;" }) + " }");
            } else {
                outLine(indent + (if item.kind == frontend.ITEM_KIND_BREAK { "break;" } else { "continue;" }));
            }
        } else if item.kind == frontend.ITEM_KIND_SCOPE {
            outLine(indent + "{");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_IF {
            outLine(indent + "if (" + code + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
        } else if item.kind == frontend.ITEM_KIND_ELSE {
            loop scopeOwned.length() > 0 and scopeOwned[scopeOwned.length() - 1].depth >= blockDepth {
                popped := mut scopeOwned.popBack();
                dFn := frontend.cDropFnForKind(popped.kind);
                if dFn =!= "" { outLine(indent + dFn + "(&" + popped.rt + ");"); }
            }
            indent = dedent(indent);
            outLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE_IF {
            loop scopeOwned.length() > 0 and scopeOwned[scopeOwned.length() - 1].depth >= blockDepth {
                popped := mut scopeOwned.popBack();
                dFn := frontend.cDropFnForKind(popped.kind);
                if dFn =!= "" { outLine(indent + dFn + "(&" + popped.rt + ");"); }
            }
            indent = dedent(indent);
            outLine(indent + "} else if (" + code + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_SCOPE {
            loop scopeOwned.length() > 0 and scopeOwned[scopeOwned.length() - 1].depth >= blockDepth {
                popped := mut scopeOwned.popBack();
                dFn := frontend.cDropFnForKind(popped.kind);
                if dFn =!= "" { outLine(indent + dFn + "(&" + popped.rt + ");"); }
            }
            indent = dedent(indent);
            outLine(indent + "}");
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_LOOP {
            condition := if code == "" { "true" } else { code };
            outLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
            blockDepth = blockDepth + 1;
            mut loopSeqFlags.pushBack(0);
            mut loopSeqReleases.pushBack("");
            mut loopOwnedDepths.pushBack(blockDepth);
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            seqId := seqLoopId.toText();
            seqLoopId = seqLoopId + 1;
            if item.intValue == 2 or item.intValue == 3 {
                nl := code.indexOf("\n", 0);
                rStart := if nl >= 0 { code.slice(0, nl) } else { "0" };
                rEnd := if nl >= 0 { code.slice(nl + 1, code.length()) } else { "0" };
                rOp := if item.intValue == 3 { "<=" } else { "<" };
                endVar := "lt_rend_" + seqId;
                idxVar := "lt_ri_" + seqId;
                outLine(indent + "{");
                outLine(indent + "    int64_t " + endVar + " = " + rEnd + ";");
                outLine(indent + "    for (int64_t " + idxVar + " = " + rStart + "; " + idxVar + " " + rOp + " " + endVar + "; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        int64_t " + item.runtime + " = " + idxVar + ";");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack("");
                mut loopOwnedDepths.pushBack(blockDepth);
            } else if item.intValue == 4 {
                /* Map loop: item.textValue is `(key:K,value:V)`, first `@T:` in item.code is `Map<K,V>`. */
                annots := extractCTypeAnnotations(item.code);
                mapKind := if annots.length() > 0 and annots[0].startsWithAt(0, "T:") { annots[0].slice(2, annots[0].length()) } else { "" };
                mTag := frontend.cMapTag(mapKind);
                entryTag := frontend.cStructTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                seqInit := if isCBorrowableCLval(code) { mTag + "_copy(" + code + ")" } else { code };
                outLine(indent + "{");
                outLine(indent + "    " + mTag + " " + seqVar + " = " + seqInit + ";");
                outLine(indent + "    for (uint32_t " + idxVar + " = 0u; " + idxVar + " < " + seqVar + ".used; " + idxVar + " += 1u) {");
                outLine(indent + "        if (" + mTag + "_is_dead(" + seqVar + ", " + idxVar + ")) { continue; }");
                if item.runtime =!= "" {
                    outLine(indent + "        " + entryTag + " " + item.runtime + " = (" + entryTag + "){ .f_key = " + mTag + "_data(" + seqVar + ")[" + idxVar + "].key, .f_value = " + mTag + "_data(" + seqVar + ")[" + idxVar + "].val };");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack(mTag + "_drop(&" + seqVar + ");");
                mut loopOwnedDepths.pushBack(blockDepth);
            } else if item.intValue == 5 {
                /* Set loop: item.textValue is element kind `T`. */
                sTag := frontend.cSetTag("Set<" + item.textValue + ">");
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                seqInit := if isCBorrowableCLval(code) { sTag + "_copy(" + code + ")" } else { code };
                outLine(indent + "{");
                outLine(indent + "    " + sTag + " " + seqVar + " = " + seqInit + ";");
                outLine(indent + "    for (uint32_t " + idxVar + " = 0u; " + idxVar + " < " + seqVar + ".used; " + idxVar + " += 1u) {");
                outLine(indent + "        if (" + sTag + "_is_dead(" + seqVar + ", " + idxVar + ")) { continue; }");
                if item.runtime =!= "" {
                    outLine(indent + "        " + cScalarType(item.textValue) + " " + item.runtime + " = " + sTag + "_data(" + seqVar + ")[" + idxVar + "];");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack(sTag + "_drop(&" + seqVar + ");");
                mut loopOwnedDepths.pushBack(blockDepth);
            } else if item.intValue == 6 {
                /* Fixed array loop: item.textValue is element kind `T`, first `@T:` in item.code is `[T; N]`. */
                annotsA := extractCTypeAnnotations(item.code);
                arrKind := if annotsA.length() > 0 and annotsA[0].startsWithAt(0, "T:") { annotsA[0].slice(2, annotsA[0].length()) } else { "" };
                aTag := frontend.cArrayTag(arrKind);
                aExt := frontend.arrayExtent(arrKind);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                outLine(indent + "{");
                outLine(indent + "    " + aTag + " " + seqVar + " = " + code + ";");
                outLine(indent + "    (void)" + seqVar + ";");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + aExt.toText() + "; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    elemRead := if numeric.isSubByteIntKind(item.textValue) {
                        aTag + "_get_raw(" + seqVar + ", " + idxVar + ")"
                    } else {
                        seqVar + ".data[" + idxVar + "]"
                    };
                    outLine(indent + "        " + cScalarType(item.textValue) + " " + item.runtime + " = " + elemRead + ";");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack("");
                mut loopOwnedDepths.pushBack(blockDepth);
            } else if item.intValue == 7 {
                /* Slice loop: item.textValue is element kind `T`, first `@T:` in item.code is `Slice<T>`. */
                annotsS := extractCTypeAnnotations(item.code);
                sliceKind := if annotsS.length() > 0 and annotsS[0].startsWithAt(0, "T:") { annotsS[0].slice(2, annotsS[0].length()) } else { "" };
                vTag := frontend.cSliceTag(sliceKind);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                rawSeqExpr := if code.startsWithAt(0, "/*@T:") {
                    eTag := code.indexOf("@*/", 5);
                    if eTag >= 0 { code.slice(eTag + 3, code.length()) } else { code }
                } else {
                    code
                };
                elemSrc := if restrictSliceParams.has(rawSeqExpr) {
                    rawSeqExpr + "__rp[" + idxVar + "]"
                } else {
                    seqVar + ".data[" + idxVar + "]"
                };
                outLine(indent + "{");
                outLine(indent + "    " + vTag + " " + seqVar + " = " + code + ";");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + seqVar + ".len; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        " + cScalarType(item.textValue) + " " + item.runtime + " = " + elemSrc + ";");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack("");
                mut loopOwnedDepths.pushBack(blockDepth);
            } else {
                tag := frontend.cListTag(item.textValue);
                seqVar := "lt_seq_" + seqId;
                idxVar := "lt_sidx_" + seqId;
                lenVar := "lt_slen_" + seqId;
                borrowImmutable := item.intValue == 1;
                seqInit := if borrowImmutable or not isCBorrowableCLval(code) { code } else { "lt_list_" + tag + "_copy(" + code + ")" };
                outLine(indent + "{");
                outLine(indent + "    lt_list_" + tag + " " + seqVar + " = " + seqInit + ";");
                outLine(indent + "    int64_t " + lenVar + " = lt_list_" + tag + "_len(" + seqVar + ");");
                outLine(indent + "    for (int64_t " + idxVar + " = 0; " + idxVar + " < " + lenVar + "; " + idxVar + " += 1) {");
                if item.runtime =!= "" {
                    outLine(indent + "        " + frontend.cListElemType(tag) + " " + item.runtime + " = " + seqVar + ".data[" + idxVar + "];");
                    outLine(indent + "        (void)" + item.runtime + ";");
                }
                indent = indent + "        ";
                blockDepth = blockDepth + 1;
                mut loopSeqFlags.pushBack(1);
                mut loopSeqReleases.pushBack(if borrowImmutable { "" } else { "lt_list_" + tag + "_drop(&" + seqVar + ");" });
                mut loopOwnedDepths.pushBack(blockDepth);
            }
        } else if item.kind == frontend.ITEM_KIND_END_LOOP {
            loop scopeOwned.length() > 0 and scopeOwned[scopeOwned.length() - 1].depth >= blockDepth {
                popped := mut scopeOwned.popBack();
                dFn := frontend.cDropFnForKind(popped.kind);
                if dFn =!= "" { outLine(indent + dFn + "(&" + popped.rt + ");"); }
            }
            if loopOwnedDepths.length() > 0 { _lp := mut loopOwnedDepths.popBack(); }
            isSeqEnd := if loopSeqFlags.length() > 0 { mut loopSeqFlags.popBack() == 1 } else { false };
            relStmt := if loopSeqReleases.length() > 0 { mut loopSeqReleases.popBack() } else { "" };
            if isSeqEnd {
                indent = dedent(dedent(indent));
                outLine(indent + "    }");
                if relStmt =!= "" {
                    outLine(indent + "    " + relStmt);
                }
                outLine(indent + "}");
            } else {
                indent = dedent(indent);
                outLine(indent + "}");
            }
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT {
            if count == 1 {
                oneDrop := if not isCBorrowableCLval(firstCode) { frontend.cDropFnForKind(firstKind) } else { "" };
                if firstCode.startsWithAt(0, "/*@CBLK:") or oneDrop =!= "" {
                    oneTemp := "lt_output_" + tempIndex.toText();
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, oneTemp, indent);
                    outText(outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { oneTemp }, indent, failAction));
                    if oneDrop =!= "" { outLine(indent + oneDrop + "(&" + oneTemp + ");"); }
                } else {
                    outText(outputWriteCode(firstKind, firstCode, indent, failAction));
                }
            } else if count > 1 {
                outText(writes.build());
                var mdi := multiOutputDrops.length() - 1;
                loop mdi >= 0 {
                    md := multiOutputDrops[mdi];
                    mdDrop := frontend.cDropFnForKind(md.kind);
                    if mdDrop =!= "" { outLine(indent + mdDrop + "(&" + md.tmp + ");"); }
                    mdi = mdi - 1;
                }
            }
            if item.kind == frontend.ITEM_KIND_END { outLine(indent + "if (printf(\"\\n\") < 0) { " + failAction + " }"); }
            count = 0;
            mut writes.clear();
            mut multiOutputDrops.clear();
        } else if item.kind == frontend.ITEM_KIND_MAIN_STOP or item.kind == frontend.ITEM_KIND_IMPORT or
        item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or
        item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or item.kind == frontend.ITEM_KIND_PURE_GLOBAL or
        item.kind == frontend.ITEM_KIND_SOFT_BUILTIN or item.kind == frontend.ITEM_KIND_NOOP or item.kind == frontend.ITEM_KIND_SOURCE_LOC or item.kind == frontend.ITEM_KIND_COMMENT {
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = code;
            } else {
                if count == 1 {
                    firstTemp = "lt_output_" + tempIndex.toText();
                    tempIndex = tempIndex + 1;
                    emitOutputArgument(firstKind, firstCode, firstTemp, indent);
                    if not isCBorrowableCLval(firstCode) and frontend.cDropFnForKind(firstKind) =!= "" {
                        mut multiOutputDrops.pushBack((tmp = firstTemp, kind = firstKind));
                    }
                    mut writes.clear();
                    mut writes.append(outputWriteCode(firstKind, if firstKind == frontend.VALUE_KIND_UNIT or firstKind == frontend.VALUE_KIND_NEVER { "0" } else { firstTemp }, indent, failAction));
                }
                temp := "lt_output_" + tempIndex.toText();
                tempIndex = tempIndex + 1;
                emitOutputArgument(item.kind, code, temp, indent);
                if not isCBorrowableCLval(code) and frontend.cDropFnForKind(item.kind) =!= "" {
                    mut multiOutputDrops.pushBack((tmp = temp, kind = item.kind));
                }
                mut writes.append(indent + "if (printf(\" \") < 0) { " + failAction + " }\n");
                mut writes.append(outputWriteCode(item.kind, if item.kind == frontend.VALUE_KIND_UNIT or item.kind == frontend.VALUE_KIND_NEVER { "0" } else { temp }, indent, failAction));
            }
            count = count + 1;
        }
    }
    minCleanD := if fnResult == "" { -1 } else { 0 };
    loop scopeOwned.length() > 0 {
        popped := mut scopeOwned.popBack();
        if popped.depth >= minCleanD {
            dFn := frontend.cDropFnForKind(popped.kind);
            if dFn =!= "" { outLine(indent + dFn + "(&" + popped.rt + ");"); }
        }
    }
};

/** Rewrites `<vTag>_{at,uat,set,uset}(<paramRt>,` / `((<paramRt>),` outside C strings to `<vTag>_..._r(<paramRt>__rp, <paramRt>.len,`. */
rewriteRestrictSliceForParam := fn(code: String, vTag: String, paramRt: String): String {
    if code == "" or vTag == "" or paramRt == "" or code.indexOf(vTag + "_", 0) < 0 { return code; }
    size := code.length();
    out: mut tb.TextBuilder;
    var segStart := 0;
    var cursor := 0;
    prefixTok := vTag + "_";
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" {
            cursor = frontend.skipAliasString(code, cursor);
            continue;
        }
        if code.startsWithAt(cursor, prefixTok) and (cursor == 0 or not code.at(cursor - 1).isNameContinue()) {
            afterPref := cursor + prefixTok.length();
            var opName := "";
            if code.startsWithAt(afterPref, "at(" + paramRt + ",") { opName = "at"; }
            else if code.startsWithAt(afterPref, "uat(" + paramRt + ",") { opName = "uat"; }
            else if code.startsWithAt(afterPref, "set(" + paramRt + ",") { opName = "set"; }
            else if code.startsWithAt(afterPref, "uset(" + paramRt + ",") { opName = "uset"; }
            if opName =!= "" {
                oldHeadLen := prefixTok.length() + opName.length() + 1 + paramRt.length() + 1;
                if cursor > segStart { mut out.append(code.slice(segStart, cursor)); }
                mut out.append(prefixTok + opName + "_r(" + paramRt + "__rp, " + paramRt + ".len,");
                cursor = cursor + oldHeadLen;
                segStart = cursor;
                continue;
            }
            var opParenName := "";
            if code.startsWithAt(afterPref, "at((" + paramRt + "),") { opParenName = "at"; }
            else if code.startsWithAt(afterPref, "uat((" + paramRt + "),") { opParenName = "uat"; }
            else if code.startsWithAt(afterPref, "set((" + paramRt + "),") { opParenName = "set"; }
            else if code.startsWithAt(afterPref, "uset((" + paramRt + "),") { opParenName = "uset"; }
            if opParenName =!= "" {
                oldHeadLen := prefixTok.length() + opParenName.length() + 2 + paramRt.length() + 2;
                if cursor > segStart { mut out.append(code.slice(segStart, cursor)); }
                mut out.append(prefixTok + opParenName + "_r(" + paramRt + "__rp, " + paramRt + ".len,");
                cursor = cursor + oldHeadLen;
                segStart = cursor;
                continue;
            }
        }
        cursor = cursor + 1;
    }
    if segStart == 0 { return code; }
    if segStart < size { mut out.append(code.slice(segStart, size)); }
    out.build()
};

/** Rewrites slice indexing calls across all slice parameters of `encodedParams`. */
rewriteRestrictSliceCode := fn(code: String, encodedParams: String): String {
    if encodedParams == "" or code.indexOf("lt_slice_", 0) < 0 { return code; }
    var cur := code;
    var start := 0;
    loop true {
        sep := encodedParams.indexOf("|", start);
        end := if sep >= 0 { sep } else { encodedParams.length() };
        entry := encodedParams.slice(start, end);
        eq := entry.indexOf("=", 0);
        if eq > 0 {
            pName := entry.slice(0, eq);
            rawPK := entry.slice(eq + 1, entry.length());
            pK := if rawPK.startsWithAt(0, "mut ") { rawPK.slice(4, rawPK.length()) } else { rawPK };
            if frontend.isSliceKind(pK) {
                vTag := frontend.cSliceTag(pK);
                pRt := "lite_" + frontend.cSafeIdent(pName);
                cur = rewriteRestrictSliceForParam(cur, vTag, pRt);
            }
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
    cur
};

/** Collects identifier/global/callee tokens referenced across `fnItems`. */
collectFnBodyTokens := fn(fnItems: frontend.Items): Set<String> {
    fnTokens: mut Set<String>;
    loop fnItems as it {
        frontend.codeReachableTokensSet(it.code, mut fnTokens);
        if isCAssignKind(it.kind) and it.runtime =!= "" {
            mut fnTokens.add(it.runtime);
        }
    }
    fnTokens
};

/** Returns `true` if `fnItems` (with `encodedParams`) satisfies Lite's static `restrict` non-aliasing proof. */
fnCanProveRestrict := fn(encodedParams: String, fnTokens: Set<String>, hoistedGlobals: frontend.TokenBuckets, constHoistedGlobals: frontend.TokenBuckets, hasAnyMutGlobal: Bool, fnsTouchingMutGlobals: Set<String>): (ok: Bool, hasMutSlice: Bool) {
    if encodedParams == "" { return (ok = false, hasMutSlice = false); }
    var hasMutNonSlice := false;
    var hasMutSlice := false;
    var start := 0;
    loop true {
        sep := encodedParams.indexOf("|", start);
        end := if sep >= 0 { sep } else { encodedParams.length() };
        entry := encodedParams.slice(start, end);
        eq := entry.indexOf("=", 0);
        if eq > 0 {
            rawPK := entry.slice(eq + 1, entry.length());
            if rawPK.startsWithAt(0, "mut ") {
                pK := rawPK.slice(4, rawPK.length());
                if frontend.isSliceKind(pK) { hasMutSlice = true; } else { hasMutNonSlice = true; }
            }
        }
        if sep < 0 { break; }
        start = sep + 1;
    }
    if not hasMutNonSlice and not hasMutSlice {
        return (ok = false, hasMutSlice = false);
    }
    loop fnTokens as tok {
        if hoistedGlobals.has(tok) and not constHoistedGlobals.has(tok) {
            return (ok = false, hasMutSlice = false);
        }
        if fnsTouchingMutGlobals.has(tok) {
            return (ok = false, hasMutSlice = false);
        }
        if hasAnyMutGlobal and tok.startsWithAt(0, "lt_fnp_") {
            return (ok = false, hasMutSlice = false);
        }
    }
    (ok = true, =hasMutSlice)
};

/** Emits one C11 function definition starting at `FUNCTION_START` index `startIndex` and returns the index after `FUNCTION_END`. */
emitOneCFunction := fn(reachable: frontend.Items, startIndex: Int, total: Int, hoistedGlobals: frontend.TokenBuckets, constHoistedGlobals: frontend.TokenBuckets, restrictFns: Set<String>, restrictMutSliceFns: Set<String>): Int {
    fnItem := reachable[startIndex];
    fnItems: mut frontend.Items = [];
    var idx := startIndex + 1;
    var depth := 1;
    loop idx < total {
        item := reachable[idx];
        if item.kind == frontend.ITEM_KIND_FUNCTION_START { depth = depth + 1; }
        else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            depth = depth - 1;
            if depth == 0 {
                idx = idx + 1;
                break;
            }
        }
        (mut fnItems).pushBack(item);
        idx = idx + 1;
    }
    useRestrict := restrictFns.has(fnItem.runtime);
    useMutSliceRestrict := restrictMutSliceFns.has(fnItem.runtime);
    outLine("static " + cScalarType(fnItem.code) + " " + fnItem.runtime + "(" + cParameterListWithRestrict(fnItem.textValue, useRestrict) + ") {");
    emitCParameterReads(fnItem.textValue);
    restrictSliceParams: mut Set<String>;
    emitItems: mut frontend.Items = [];
    if useMutSliceRestrict {
        var pStart := 0;
        loop true {
            pSep := fnItem.textValue.indexOf("|", pStart);
            pEnd := if pSep >= 0 { pSep } else { fnItem.textValue.length() };
            pEntry := fnItem.textValue.slice(pStart, pEnd);
            pEq := pEntry.indexOf("=", 0);
            if pEq > 0 {
                pName := pEntry.slice(0, pEq);
                rawPK := pEntry.slice(pEq + 1, pEntry.length());
                isMutP := rawPK.startsWithAt(0, "mut ");
                pK := if isMutP { rawPK.slice(4, rawPK.length()) } else { rawPK };
                if frontend.isSliceKind(pK) {
                    pRt := "lite_" + frontend.cSafeIdent(pName);
                    elCT := cScalarType(frontend.sliceElementKind(pK));
                    ptrQual := if isMutP { " * restrict " } else { " * restrict " };
                    constPref := if isMutP { "" } else { "const " };
                    outLine("    " + constPref + elCT + ptrQual + pRt + "__rp = " + pRt + ".data; (void)" + pRt + "__rp;");
                    mut restrictSliceParams.add(pRt);
                }
            }
            if pSep < 0 { break; }
            pStart = pSep + 1;
        }
        loop fnItems as fi {
            rwCode := rewriteRestrictSliceCode(fi.code, fnItem.textValue);
            mut emitItems.pushBack((kind = fi.kind, name = fi.name, runtime = fi.runtime, code = rwCode, intValue = fi.intValue, textValue = fi.textValue));
        }
    } else {
        loop fnItems as fi { mut emitItems.pushBack(fi); }
    }
    emitArithmeticTemporaries(emitItems);
    scopeLists := analyzeFnScopeLists(emitItems);
    if scopeLists.size() > 0 {
        outLine("    int64_t lt_scope_mk = lt_vm_arena_mark(&lt_tl_ctx.scope); (void)lt_scope_mk;");
    }
    emitCItemStream(emitItems, hoistedGlobals, constHoistedGlobals, fnItem.code, "lt_io_status = 1;", scopeLists, restrictSliceParams);
    if scopeLists.size() > 0 and (fnItem.code == frontend.VALUE_KIND_UNIT or fnItem.code == frontend.VALUE_KIND_NEVER) {
        outLine("    lt_vm_arena_rewind(&lt_tl_ctx.scope, lt_scope_mk);");
    }
    outLine("}");
    outLine("");
    idx
};

/** Emits the C program from the flat item stream with explicit `--builtin-mode` specifications and optimization level (`0..3`). */
/** Returns all C-supported struct (`S|<kind>`), list (`L|<elemKind>`), map (`M|<kind>`), and set (`E|<kind>`) types referenced by `kind` in post-order. */
collectSubKinds := fn(kind: String): List<String> {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind)); }
    out: mut List<String> = [];
    if frontend.cArrayTag(kind) =!= "" {
        elKind := frontend.arrayElementKind(kind);
        sub := self(elKind);
        loop sub as s { mut out.pushBack(s); }
        (mut out).pushBack("A|" + kind);
        return out;
    }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        if frontend.cListTag(elKind) == "" { return out; }
        sub := self(elKind);
        loop sub as s { mut out.pushBack(s); }
        (mut out).pushBack("L|" + elKind);
        return out;
    }
    if frontend.isMapKind(kind) {
        if frontend.cMapTag(kind) == "" { return out; }
        kKind := frontend.mapKeyKind(kind);
        vKind := frontend.mapValueKind(kind);
        subK := self("List<" + kKind + ">");
        loop subK as s { mut out.pushBack(s); }
        subV := self(vKind);
        loop subV as s { mut out.pushBack(s); }
        if frontend.cListTag(vKind) =!= "" {
            subVL := self("List<" + vKind + ">");
            loop subVL as s { mut out.pushBack(s); }
        }
        subGet := self("(found:Bool,value:" + vKind + ")");
        loop subGet as s { mut out.pushBack(s); }
        (mut out).pushBack("M|" + kind);
        return out;
    }
    if frontend.isSetKind(kind) {
        if frontend.cSetTag(kind) == "" { return out; }
        eKind := frontend.setElementKind(kind);
        subE := self("List<" + eKind + ">");
        loop subE as s { mut out.pushBack(s); }
        (mut out).pushBack("E|" + kind);
        return out;
    }
    if frontend.isRcKind(kind) {
        if frontend.cRcTag(kind) == "" { return out; }
        eKind := frontend.rcElementKind(kind);
        subE := self(eKind);
        loop subE as s { mut out.pushBack(s); }
        (mut out).pushBack("R|" + kind);
        return out;
    }
    if frontend.isSliceKind(kind) {
        if frontend.cSliceTag(kind) == "" { return out; }
        eKind := frontend.sliceElementKind(kind);
        subE := self(eKind);
        loop subE as s { mut out.pushBack(s); }
        (mut out).pushBack("V|" + kind);
        return out;
    }
    if frontend.isPayloadEnumKind(kind) {
        if frontend.cStructTag(kind) == "" { return out; }
        cc := frontend.enumCaseCount(kind);
        var ci := 0;
        loop ci < cc {
            pc := frontend.enumCasePayloadCount(kind, ci);
            var pi := 0;
            loop pi < pc {
                sub := self(frontend.enumCasePayloadKind(kind, ci, pi));
                loop sub as s { mut out.pushBack(s); }
                pi = pi + 1;
            }
            ci = ci + 1;
        }
        (mut out).pushBack("S|" + kind);
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        if frontend.cStructTag(kind) == "" { return out; }
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { mut out.pushBack(s); }
            i = i + 1;
        }
        (mut out).pushBack("S|" + kind);
        return out;
    }
    if frontend.isFnKind(kind) {
        if frontend.cFnTag(kind) == "" { return out; }
        pCount := frontend.fnParamCount(kind);
        var pi := 0;
        loop pi < pCount {
            subP := self(frontend.fnParamComponent(kind, pi).kind);
            loop subP as s { mut out.pushBack(s); }
            pi = pi + 1;
        }
        subR := self(frontend.fnResultKind(kind));
        loop subR as s { mut out.pushBack(s); }
        (mut out).pushBack("F|" + kind);
        return out;
    }
    out
};

/** Returns all struct/list/map/set tags and `"FLOAT"`/`"FLOAT32"`/`"STR"` markers reachable inside `kind` for print/copy/float tracking. */
collectTypeFlags := fn(kind: String): List<String> {
    if frontend.isDistinctKind(kind) { return self(frontend.distinctBaseKind(kind)); }
    out: mut List<String> = [];
    if kind == frontend.VALUE_KIND_STRING {
        mut out.pushBack("STR");
        return out;
    }
    if frontend.isFloatScalarKind(kind) {
        mut out.pushBack("FLOAT");
        if kind == frontend.VALUE_KIND_FLOAT32 { mut out.pushBack("FLOAT32"); }
        return out;
    }
    if frontend.cArrayTag(kind) =!= "" {
        aTag := frontend.cArrayTag(kind);
        (mut out).pushBack("A:" + aTag);
        sub := self(frontend.arrayElementKind(kind));
        loop sub as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isListKind(kind) or frontend.isArrayKind(kind) {
        elKind := if frontend.isListKind(kind) { frontend.listElementKind(kind) } else { frontend.arrayElementKind(kind) };
        tag := frontend.cListTag(elKind);
        if tag == "" { return out; }
        (mut out).pushBack("L:" + tag);
        sub := self(elKind);
        loop sub as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isMapKind(kind) {
        tag := frontend.cMapTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("M:" + tag);
        subK := self(frontend.mapKeyKind(kind));
        loop subK as s { mut out.pushBack(s); }
        subV := self(frontend.mapValueKind(kind));
        loop subV as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isSetKind(kind) {
        tag := frontend.cSetTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("E:" + tag);
        subE := self(frontend.setElementKind(kind));
        loop subE as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isRcKind(kind) {
        tag := frontend.cRcTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("R:" + tag);
        subE := self(frontend.rcElementKind(kind));
        loop subE as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isSliceKind(kind) {
        tag := frontend.cSliceTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("V:" + tag);
        subE := self(frontend.sliceElementKind(kind));
        loop subE as s { mut out.pushBack(s); }
        return out;
    }
    if frontend.isPayloadEnumKind(kind) {
        tag := frontend.cStructTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("S:" + tag);
        cc := frontend.enumCaseCount(kind);
        var ci := 0;
        loop ci < cc {
            pc := frontend.enumCasePayloadCount(kind, ci);
            var pi := 0;
            loop pi < pc {
                sub := self(frontend.enumCasePayloadKind(kind, ci, pi));
                loop sub as s { mut out.pushBack(s); }
                pi = pi + 1;
            }
            ci = ci + 1;
        }
        return out;
    }
    if frontend.isTupleKind(kind) or frontend.isRecordKind(kind) {
        tag := frontend.cStructTag(kind);
        if tag == "" { return out; }
        (mut out).pushBack("S:" + tag);
        isRec := frontend.isRecordKind(kind);
        cnt := if isRec { frontend.recordComponentCount(kind) } else { frontend.tupleComponentCount(kind) };
        var i := 0;
        loop i < cnt {
            fKind := if isRec { frontend.recordComponent(kind, i).kind } else { frontend.tupleComponent(kind, i).kind };
            sub := self(fKind);
            loop sub as s { mut out.pushBack(s); }
            i = i + 1;
        }
        return out;
    }
    out
};

/** Extracts all `/*@T:<kind>@*/`, `/*@P:<kind>@*/`, and `/*@C:<exp>|<act>@*/` payloads from emitted C expression `code`, jumping via `indexOfText`. */
extractCTypeAnnotations := fn(code: String): List<String> {
    out: mut List<String> = [];
    var nextAnnot := code.indexOf("/*@", 0);
    if nextAnnot < 0 { return out; }
    size := code.length();
    var nextQuote := code.indexOf("\"", 0);
    var cursor := 0;
    loop cursor < size {
        if nextAnnot < cursor { nextAnnot = code.indexOf("/*@", cursor); }
        if nextAnnot < 0 { break; }
        if nextQuote >= 0 and nextQuote < nextAnnot {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < nextAnnot {
                cursor = frontend.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if code.startsWithAt(nextAnnot, "/*@T:") or code.startsWithAt(nextAnnot, "/*@C:") or code.startsWithAt(nextAnnot, "/*@P:") {
            endTag := code.indexOf("@*/", nextAnnot + 5);
            if endTag < 0 { break; }
            (mut out).pushBack(code.slice(nextAnnot + 3, endTag));
            cursor = endTag + 3;
        } else {
            cursor = nextAnnot + 3;
        }
    }
    out
};

/** Recursively extracts balanced CFN_START ... CFN_END hoisted closure/trampoline definitions (innermost first), encoded as `<key>\n<body>`. */
extractCHoistedFns := fn(code: String): List<String> {
    out: mut List<String> = [];
    var nextCfn := code.indexOf("/*@CFN_START:", 0);
    if nextCfn < 0 { return out; }
    size := code.length();
    var nextQuote := code.indexOf("\"", 0);
    var cursor := 0;
    loop cursor < size {
        if nextCfn < cursor { nextCfn = code.indexOf("/*@CFN_START:", cursor); }
        if nextCfn < 0 { break; }
        if nextQuote >= 0 and nextQuote < nextCfn {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < nextCfn {
                cursor = frontend.skipAliasString(code, nextQuote);
                continue;
            }
        }
        keyEnd := code.indexOf("@*/", nextCfn + 13);
        blockEnd := skipCFnBlock(code, nextCfn);
        if keyEnd > nextCfn + 13 and blockEnd >= keyEnd + 16 {
            key := code.slice(nextCfn + 13, keyEnd);
            body := code.slice(keyEnd + 3, blockEnd - 13);
            nested := self(body);
            loop nested as entry {
                mut out.pushBack(entry);
            }
            (mut out).pushBack(key + "\n" + body);
        }
        cursor = blockEnd;
    }
    out
};

/** Emits a C11 fat-pointer struct typedef and `_call` helper for function value type `kind`. */
emitCFnTypeHelper := fn(kind: String, calls: Set<String>): Unit {
    fTag := frontend.cFnTag(kind);
    retKind := frontend.fnResultKind(kind);
    retC := cScalarType(retKind);
    pCount := frontend.fnParamCount(kind);
    fpParamsBuf: mut tb.TextBuilder;
    mut fpParamsBuf.append("void *");
    callParamsBuf: mut tb.TextBuilder;
    mut callParamsBuf.append(fTag);
    mut callParamsBuf.append(" f");
    callArgsBuf: mut tb.TextBuilder;
    mut callArgsBuf.append("f.env");
    var i := 0;
    loop i < pCount {
        pC := cScalarType(frontend.fnParamComponent(kind, i).kind);
        aName := "a" + i.toText();
        mut fpParamsBuf.append(", ");
        mut fpParamsBuf.append(pC);
        mut callParamsBuf.append(", ");
        mut callParamsBuf.append(pC);
        mut callParamsBuf.append(" ");
        mut callParamsBuf.append(aName);
        mut callArgsBuf.append(", ");
        mut callArgsBuf.append(aName);
        i = i + 1;
    }
    fpParams := fpParamsBuf.build();
    callParams := callParamsBuf.build();
    callArgs := callArgsBuf.build();
    outLine("typedef struct " + fTag + " { " + retC + " (*fn)(" + fpParams + "); void *env; } " + fTag + ";");
    outLine("LT_INLINE " + fTag + " " + fTag + "_copy(" + fTag + " f) {");
    outLine("    if (f.env != NULL) { lt_env_hdr *h = (lt_env_hdr *)f.env; if (h->clone != NULL) { return (" + fTag + "){ f.fn, h->clone(f.env) }; } }");
    outLine("    return f;");
    outLine("}");
    outLine("LT_INLINE void " + fTag + "_drop(" + fTag + " *f) {");
    outLine("    if (f->env != NULL) { lt_env_hdr *h = (lt_env_hdr *)f->env; if (h->drop != NULL) { h->drop(f->env); } f->env = NULL; }");
    outLine("    f->fn = NULL;");
    outLine("}");
    outLine("LT_INLINE " + fTag + " " + fTag + "_move(" + fTag + " *f) { " + fTag + " r = *f; f->fn = NULL; f->env = NULL; return r; }");
    if usesIntHelper(calls, fTag + "_call(") {
        if retC == "void" {
            outLine("static void " + fTag + "_call(" + callParams + ") { f.fn(" + callArgs + "); }");
        } else {
            outLine("static " + retC + " " + fTag + "_call(" + callParams + ") { return f.fn(" + callArgs + "); }");
        }
    }
    outLine("");
};

/** Emits C11 `core/text` Unicode hard builtin helpers (`String.toCodePoints`, `String.fromCodePoints`). */
emitCUnicodeBuiltinHelpers := fn(calls: Set<String>): Unit {
    if usesIntHelper(calls, "lite$unicodeToCodePoints(") {
        outLine("static lt_list_i64 lt_unicode_to_code_points(lt_str text) {");
        outLine("    const size_t tlen = lt_str_byte_len(text);");
        outLine("    if (tlen == 0u) { return (lt_list_i64){ NULL, 0u, 0u }; }");
        outLine("    const uint8_t *p = (const uint8_t *)lt_str_data(&text);");
        outLine("    const uint8_t *end = p + tlen;");
        outLine("    int64_t known_cp = lt_str_cp_len_known(text);");
        outLine("    int64_t len = 0; int64_t cap = known_cp > 16 ? known_cp : 16;");
        outLine("    int64_t *data = (int64_t *)lt_heap_alloc((size_t)cap * sizeof(int64_t));");
        outLine("    while (p < end) {");
        outLine("        int64_t cp = 0xFFFD;");
        outLine("        uint8_t b0 = *p;");
        outLine("        if (b0 < 0x80) { cp = (int64_t)b0; p += 1; }");
        outLine("        else if ((b0 & 0xE0) == 0xC0 && p + 1 < end) { cp = (int64_t)(((b0 & 0x1F) << 6) | (p[1] & 0x3F)); p += 2; }");
        outLine("        else if ((b0 & 0xF0) == 0xE0 && p + 2 < end) { cp = (int64_t)(((b0 & 0x0F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F)); p += 3; }");
        outLine("        else if ((b0 & 0xF8) == 0xF0 && p + 3 < end) { cp = (int64_t)(((b0 & 0x07) << 18) | ((p[1] & 0x3F) << 12) | ((p[2] & 0x3F) << 6) | (p[3] & 0x3F)); p += 4; }");
        outLine("        else { p += 1; }");
        outLine("        if (len >= cap) { int64_t ncap = cap * 2; data = (int64_t *)lt_heap_realloc(data, (size_t)cap * sizeof(int64_t), (size_t)ncap * sizeof(int64_t)); cap = ncap; }");
        outLine("        data[len++] = cp;");
        outLine("    }");
        outLine("    lt_list_i64 out = { data, (uint32_t)len, (uint32_t)cap };");
        outLine("    return out;");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$unicodeFromCodePoints(") {
        okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
        outLine("static " + okTextTag + " lt_unicode_from_code_points(lt_list_i64 points) {");
        outLine("    int64_t plen = lt_list_i64_len(points);");
        outLine("    size_t cap = (size_t)(plen > 0 ? plen * 4 : 1) + 1;");
        outLine("    char *buf = malloc(cap);");
        outLine("    if (buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate text\\n\"); exit(1); }");
        outLine("    size_t pos = 0;");
        outLine("    for (int64_t i = 0; i < plen; i += 1) {");
        outLine("        int64_t cp = points.data[i];");
        outLine("        if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {");
        outLine("            free(buf);");
        outLine("            char *msg = malloc(96);");
        outLine("            if (msg == NULL) { return (" + okTextTag + "){ false, LT_ASTR(\"\"), LT_ASTR(\"invalid Unicode scalar code point\") }; }");
        outLine("            snprintf(msg, 96, \"invalid Unicode scalar code point: %\" PRId64, cp);");
        outLine("            return (" + okTextTag + "){ false, LT_ASTR(\"\"), lt_text_from_owned_cstr(msg) };");
        outLine("        }");
        outLine("        if (cp < 0x80) { buf[pos++] = (char)cp; }");
        outLine("        else if (cp < 0x800) { buf[pos++] = (char)(0xC0 | (cp >> 6)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("        else if (cp < 0x10000) { buf[pos++] = (char)(0xE0 | (cp >> 12)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("        else { buf[pos++] = (char)(0xF0 | (cp >> 18)); buf[pos++] = (char)(0x80 | ((cp >> 12) & 0x3F)); buf[pos++] = (char)(0x80 | ((cp >> 6) & 0x3F)); buf[pos++] = (char)(0x80 | (cp & 0x3F)); }");
        outLine("    }");
        outLine("    buf[pos] = '\\0';");
        outLine("    return (" + okTextTag + "){ true, lt_text_from_buf(buf, pos, plen), LT_ASTR(\"\") };");
        outLine("}");
    }
};

/** Emits C11 `core/io` stream and `core/file` stream-opener helpers. */
emitCStreamBuiltinHelpers := fn(calls: Set<String>): Unit {
    if not usesStreamBuiltins(calls) { return; }
    shTag := frontend.cStructTag("(kind:String,handle:Int)");
    okErrTag := frontend.cStructTag("(ok:Bool,error:String)");
    okTextTag := frontend.cStructTag("(ok:Bool,text:String,error:String)");
    okWrittenTag := frontend.cStructTag("(ok:Bool,written:Int,error:String)");
    fKind := frontend.cFieldName("kind");
    fHandle := frontend.cFieldName("handle");
    needFileOpen := usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or usesIntHelper(calls, "lite$fileOpenAppender(");
    needAlloc := needFileOpen or usesIntHelper(calls, "lite$ioBufferReader(") or usesIntHelper(calls, "lite$ioBufferWriter(") or usesIntHelper(calls, "lt_c_io_from_text(");
    needLookup := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
    usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(") or
    usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWriterOk(") or
    usesIntHelper(calls, "lite$ioWriterError(") or usesIntHelper(calls, "lite$ioWrite(") or
    usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") or
    usesIntHelper(calls, "lite$ioWriterBytes(") or usesIntHelper(calls, "lite$ioWriterText(") or
    usesIntHelper(calls, "lite$ioClearWriter(") or usesIntHelper(calls, "lt_c_io_read_all(") or
    usesIntHelper(calls, "lt_c_io_read_all_text(") or usesIntHelper(calls, "lt_c_io_read_line(") or
    usesIntHelper(calls, "lt_c_io_write_text(") or usesIntHelper(calls, "lt_c_io_write_line(");
    needStdinState := usesIntHelper(calls, "lite$ioReaderOk(") or usesIntHelper(calls, "lite$ioReaderAtEof(") or
    usesIntHelper(calls, "lite$ioReaderError(") or usesIntHelper(calls, "lite$ioRead(") or
    usesIntHelper(calls, "lt_c_io_read_all(") or usesIntHelper(calls, "lt_c_io_read_all_text(") or
    usesIntHelper(calls, "lt_c_io_read_line(");
    if needAlloc or needLookup {
        outLine("typedef struct { int kind; int fd; uint8_t *buf; int64_t len; int64_t cap; int64_t pos; bool eof; bool closed; const char *error; } lt_stream_entry;");
        outLine("static lt_stream_entry *lt_streams = NULL;");
        outLine("static int64_t lt_streams_len = 0;");
    }
    if needStdinState {
        outLine("static bool lt_stdin_eof = false;");
        outLine("static const char *lt_stdin_err = \"\";");
    }
    if needAlloc {
        outLine("static int64_t lt_streams_cap = 0;");
        outLine("static int64_t lt_alloc_stream(lt_stream_entry entry) {");
        outLine("    if (lt_streams_len >= lt_streams_cap) {");
        outLine("        lt_streams_cap = lt_streams_cap == 0 ? 16 : lt_streams_cap * 2;");
        outLine("        lt_streams = realloc(lt_streams, (size_t)lt_streams_cap * sizeof(lt_stream_entry));");
        outLine("        if (lt_streams == NULL) { fprintf(stderr, \"MemoryFault: cannot grow stream table\\n\"); exit(1); }");
        outLine("    }");
        outLine("    int64_t id = lt_streams_len + 10;");
        outLine("    lt_streams[lt_streams_len++] = entry;");
        outLine("    return id;");
        outLine("}");
    }
    if needLookup {
        outLine("static lt_stream_entry *lt_lookup_stream(int64_t handle) {");
        outLine("    int64_t idx = handle - 10;");
        outLine("    if (idx < 0 || idx >= lt_streams_len) { return NULL; }");
        outLine("    return &lt_streams[idx];");
        outLine("}");
    }
    if needFileOpen {
        outLine("static " + shTag + " lt_file_open_stream(lt_str path_s, int flags, bool for_write) {");
        outLine("    const char *path = lt_text_cstr(path_s);");
        outLine("    int fd = open(path, flags, 0666);");
        outLine("    if (fd < 0) {");
        outLine("        const char *err = lt_dup_str(strerror(errno));");
        outLine("        lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, err };");
        outLine("        return (" + shTag + "){ LT_ASTR(\"error\"), lt_alloc_stream(e) };");
        outLine("    }");
        outLine("    if (!for_write) {");
        outLine("        struct stat st;");
        outLine("        if (fstat(fd, &st) == 0 && S_ISDIR(st.st_mode)) {");
        outLine("            close(fd);");
        outLine("            lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, \"EISDIR: illegal operation on a directory\" };");
        outLine("            return (" + shTag + "){ LT_ASTR(\"error\"), lt_alloc_stream(e) };");
        outLine("        }");
        outLine("    }");
        outLine("    lt_stream_entry e = { 1, fd, NULL, 0, 0, 0, false, false, \"\" };");
        outLine("    return (" + shTag + "){ LT_ASTR(\"file\"), lt_alloc_stream(e) };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$fileOpenReader(") {
        outLine("static " + shTag + " lt_file_open_reader(lt_str path) { return lt_file_open_stream(path, O_RDONLY, false); }");
    }
    if usesIntHelper(calls, "lite$fileOpenWriter(") {
        outLine("static " + shTag + " lt_file_open_writer(lt_str path) { return lt_file_open_stream(path, O_WRONLY | O_CREAT | O_TRUNC, true); }");
    }
    if usesIntHelper(calls, "lite$fileOpenAppender(") {
        outLine("static " + shTag + " lt_file_open_appender(lt_str path) { return lt_file_open_stream(path, O_WRONLY | O_CREAT | O_APPEND, true); }");
    }
    if usesIntHelper(calls, "lite$ioStdinReader(") {
        outLine("static " + shTag + " lt_io_stdin_reader(void) { return (" + shTag + "){ LT_ASTR(\"stdin\"), 0 }; }");
    }
    if usesIntHelper(calls, "lite$ioStdoutWriter(") {
        outLine("static " + shTag + " lt_io_stdout_writer(void) { return (" + shTag + "){ LT_ASTR(\"stdout\"), 1 }; }");
    }
    if usesIntHelper(calls, "lite$ioStderrWriter(") {
        outLine("static " + shTag + " lt_io_stderr_writer(void) { return (" + shTag + "){ LT_ASTR(\"stderr\"), 2 }; }");
    }
    if usesIntHelper(calls, "lite$ioBufferReader(") {
        outLine("static " + shTag + " lt_io_buffer_reader(lt_list_i64 bytes) {");
        outLine("    uint8_t *buf = bytes.len > 0 ? malloc((size_t)bytes.len) : NULL;");
        outLine("    if (bytes.len > 0 && buf == NULL) { fprintf(stderr, \"MemoryFault: cannot allocate buffer reader\\n\"); exit(1); }");
        outLine("    for (int64_t i = 0; i < bytes.len; i += 1) {");
        outLine("        if (bytes.data[i] < 0 || bytes.data[i] > 255) {");
        outLine("            free(buf);");
        outLine("            lt_stream_entry e = { 4, -1, NULL, 0, 0, 0, false, false, \"byte value outside 0..255\" };");
        outLine("            return (" + shTag + "){ LT_ASTR(\"error\"), lt_alloc_stream(e) };");
        outLine("        }");
        outLine("        buf[i] = (uint8_t)bytes.data[i];");
        outLine("    }");
        outLine("    lt_stream_entry e = { 2, -1, buf, bytes.len, bytes.len, 0, false, false, \"\" };");
        outLine("    return (" + shTag + "){ LT_ASTR(\"buffer\"), lt_alloc_stream(e) };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioBufferWriter(") {
        outLine("static " + shTag + " lt_io_buffer_writer(void) {");
        outLine("    lt_stream_entry e = { 3, -1, NULL, 0, 0, 0, false, false, \"\" };");
        outLine("    return (" + shTag + "){ LT_ASTR(\"buffer\"), lt_alloc_stream(e) };");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioReaderError(") {
        outLine("static lt_str lt_io_reader_error(" + shTag + " reader) {");
        outLine("    if (strcmp(lt_text_cstr(reader." + fKind + "), \"stdin\") == 0 && reader." + fHandle + " == 0) { return lt_text_from_cstr(lt_stdin_err); }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    if (e == NULL) { return LT_ASTR(\"invalid reader handle\"); }");
        outLine("    if (e->kind == 3) { return LT_ASTR(\"handle is a writer, not a reader\"); }");
        outLine("    if (e->error[0] != '\\0') { return lt_text_from_cstr(e->error); }");
        outLine("    if (e->closed) { return LT_ASTR(\"reader is closed\"); }");
        outLine("    return LT_ASTR(\"\");");
        outLine("}");
    }
    if usesIntHelper(calls, "lite$ioReaderOk(") {
        outLine("static bool lt_io_reader_ok(" + shTag + " reader) {");
        outLine("    if (strcmp(lt_text_cstr(reader." + fKind + "), \"stdin\") == 0 && reader." + fHandle + " == 0) { return lt_stdin_err[0] == '\\0'; }");
        outLine("    lt_stream_entry *e = lt_lookup_stream(reader." + fHandle + ");");
        outLine("    return e != NULL && (e->kind == 1 || e->kind == 2) && !e->closed && e->error[0] == '\\0';");
