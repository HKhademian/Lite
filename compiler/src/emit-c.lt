        outLine("            close(out_p[1]); close(err_p[1]); close(exec_p[1]);");
        outLine("            int exec_err = 0;");
        outLine("            ssize_t en = read(exec_p[0], &exec_err, sizeof(exec_err));");
        outLine("            close(exec_p[0]);");
        outLine("            if (en != (ssize_t)sizeof(exec_err)) { exec_err = 0; }");
        outLine("            fcntl(out_p[0], F_SETFL, O_NONBLOCK); fcntl(err_p[0], F_SETFL, O_NONBLOCK);");
        outLine("            int64_t s = 0;");
        outLine("            while (s < limit && slots[s].active) { s += 1; }");
        outLine("            slots[s].active = true; slots[s].job_idx = job; slots[s].pid = pid;");
        outLine("            slots[s].out_fd = out_p[0]; slots[s].err_fd = err_p[0]; slots[s].exec_err = exec_err;");
        outLine("            active += 1;");
        outLine("        }");
        outLine("        int nfds = 0;");
        outLine("        for (int64_t s = 0; s < limit; s += 1) {");
        outLine("            if (!slots[s].active) { continue; }");
        outLine("            if (slots[s].out_fd >= 0) { pfds[nfds].fd = slots[s].out_fd; pfds[nfds].events = POLLIN; pfds[nfds].revents = 0; nfds += 1; }");
        outLine("            if (slots[s].err_fd >= 0) { pfds[nfds].fd = slots[s].err_fd; pfds[nfds].events = POLLIN; pfds[nfds].revents = 0; nfds += 1; }");
        outLine("        }");
        outLine("        if (nfds > 0) {");
        outLine("            int pr = poll(pfds, (nfds_t)nfds, -1);");
        outLine("            if (pr < 0 && errno != EINTR) { break; }");
        outLine("            for (int64_t s = 0; s < limit; s += 1) {");
        outLine("                if (!slots[s].active) { continue; }");
        outLine("                int64_t j = slots[s].job_idx;");
        outLine("                if (slots[s].out_fd >= 0) {");
        outLine("                    for (;;) {");
        outLine("                        ssize_t r = read(slots[s].out_fd, tmp, sizeof(tmp));");
        outLine("                        if (r > 0) { lt_buf_append(&results[j].out, &results[j].out_len, &results[j].out_cap, tmp, (size_t)r); }");
        outLine("                        else if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { close(slots[s].out_fd); slots[s].out_fd = -1; break; }");
        outLine("                        else if (errno == EAGAIN || errno == EWOULDBLOCK) { break; }");
        outLine("                    }");
        outLine("                }");
        outLine("                if (slots[s].err_fd >= 0) {");
        outLine("                    for (;;) {");
        outLine("                        ssize_t r = read(slots[s].err_fd, tmp, sizeof(tmp));");
        outLine("                        if (r > 0) { lt_buf_append(&results[j].err, &results[j].err_len, &results[j].err_cap, tmp, (size_t)r); }");
        outLine("                        else if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { close(slots[s].err_fd); slots[s].err_fd = -1; break; }");
        outLine("                        else if (errno == EAGAIN || errno == EWOULDBLOCK) { break; }");
        outLine("                    }");
        outLine("                }");
        outLine("            }");
        outLine("        }");
        outLine("        for (int64_t s = 0; s < limit; s += 1) {");
        outLine("            if (slots[s].active && slots[s].out_fd < 0 && slots[s].err_fd < 0) {");
        outLine("                int64_t j = slots[s].job_idx;");
        outLine("                int wst = 0;");
        outLine("                while (waitpid(slots[s].pid, &wst, 0) < 0 && errno == EINTR) {}");
        outLine("                if (slots[s].exec_err != 0) {");
        outLine("                    results[j].status = -1; results[j].error = lt_dup_str(strerror(slots[s].exec_err));");
        outLine("                } else if (WIFSIGNALED(wst)) {");
        outLine("                    char *smsg = malloc(64);");
        outLine("                    if (smsg != NULL) { snprintf(smsg, 64, \"terminated by signal %d\", WTERMSIG(wst)); }");
        outLine("                    results[j].status = -1; results[j].error = smsg != NULL ? smsg : lt_dup_str(\"terminated by signal\");");
        outLine("                } else {");
        outLine("                    results[j].status = WIFEXITED(wst) ? (int64_t)WEXITSTATUS(wst) : -1;");
        outLine("                    results[j].error = lt_dup_str(\"\");");
        outLine("                }");
        outLine("                slots[s].active = false; active -= 1; done += 1;");
        outLine("            }");
        outLine("        }");
        outLine("    }");
        outLine("    uint8_t *jbuf = NULL; size_t jlen = 0u; size_t jcap = 0u;");
        outLine("    lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\"[\", 1u);");
        outLine("    for (int64_t i = 0; i < total; i += 1) {");
        outLine("        if (i > 0) { lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\",\", 1u); }");
        outLine("        char hdr[64];");
        outLine("        int hn = snprintf(hdr, sizeof(hdr), \"{\\\"status\\\":%\" PRId64 \",\\\"stdout\\\":\", results[i].status);");
        outLine("        lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)hdr, (size_t)hn);");
        outLine("        lt_pool_json_append_str(&jbuf, &jlen, &jcap, results[i].out, results[i].out_len);");
        outLine("        lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\",\\\"stderr\\\":\", 10u);");
        outLine("        lt_pool_json_append_str(&jbuf, &jlen, &jcap, results[i].err, results[i].err_len);");
        outLine("        lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\",\\\"error\\\":\", 9u);");
        outLine("        const char *es = results[i].error != NULL ? results[i].error : \"\";");
        outLine("        lt_pool_json_append_str(&jbuf, &jlen, &jcap, (const uint8_t *)es, strlen(es));");
        outLine("        lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\"}\", 1u);");
        outLine("        free(results[i].out); free(results[i].err); free(results[i].error);");
        outLine("    }");
        outLine("    lt_buf_append(&jbuf, &jlen, &jcap, (const uint8_t *)\"]\", 1u);");
        outLine("    uint8_t z = 0u; lt_buf_append(&jbuf, &jlen, &jcap, &z, 1u);");
        outLine("    free(results); free(slots); free(pfds);");
        outLine("    return lt_text_from_cstr((const char *)jbuf);");
        outLine("}");
    }
};

/** Emits all C11 host builtin helpers (`core/text` Unicode, `core/io` streams, `core/file`, `core/process`, `core/time`, `core/crypto`). */
emitCHostBuiltinHelpers := fn(calls: Set<String>): Unit {
    needDupStr := usesIntHelper(calls, "lite$fileOpenReader(") or usesIntHelper(calls, "lite$fileOpenWriter(") or
    usesIntHelper(calls, "lite$fileOpenAppender(") or usesIntHelper(calls, "lite$ioRead(") or
    usesIntHelper(calls, "lite$ioCloseReader(") or usesIntHelper(calls, "lite$ioWrite(") or
    usesIntHelper(calls, "lite$ioFlush(") or usesIntHelper(calls, "lite$ioCloseWriter(") or
    usesIntHelper(calls, "lite$fileListDir(") or usesIntHelper(calls, "lite$fileMakeDir(") or
    usesIntHelper(calls, "lite$fileRemove(") or usesIntHelper(calls, "lite$fileCopy(") or
    usesIntHelper(calls, "lite$fileSymlink(") or usesIntHelper(calls, "lite$fileRealPath(") or
    usesIntHelper(calls, "lite$fileMakeTempDir(") or usesCFileSoft(calls) or usesProcessSpawnBuiltins(calls) or usesIntHelper(calls, "lite$extPoolRunJson(") or
    usesIntHelper(calls, "lt_c_io_read_all(") or usesIntHelper(calls, "lt_c_io_read_all_text(") or
    usesIntHelper(calls, "lt_c_io_read_line(") or usesIntHelper(calls, "lt_c_io_write_text(") or
    usesIntHelper(calls, "lt_c_io_write_line(");
    if needDupStr {
        outLine("static char *lt_dup_str(const char *s) {");
        outLine("    size_t n = strlen(s);");
        outLine("    char *out = malloc(n + 1);");
        outLine("    if (out == NULL) { fprintf(stderr, \"MemoryFault: cannot duplicate string\\n\"); exit(1); }");
        outLine("    memcpy(out, s, n + 1);");
        outLine("    return out;");
        outLine("}");
    }
    emitCUnicodeBuiltinHelpers(calls);
    emitCStreamBuiltinHelpers(calls);
    emitCFileBuiltinHelpers(calls);
    emitCProcessBuiltinHelpers(calls);
    emitCProcessSpawnAndTimeHelpers(calls);
};

/** Extracts the C runtime parameter name (`lite_<name>`) at `targetIndex` from an encoded parameter list. */
cParamRuntimeAt := fn(encoded: String, targetIndex: Int): String {
    if encoded == "" or targetIndex < 0 { return ""; }
    var index := 0;
    var start := 0;
    loop true {
        separator := encoded.indexOf("|", start);
        end := if separator >= 0 { separator } else { encoded.length() };
        if index == targetIndex {
            entry := encoded.slice(start, end);
            eq := entry.indexOf("=", 0);
            if eq <= 0 { return ""; }
            rawPKind := entry.slice(eq + 1, entry.length());
            isMut := rawPKind.startsWithAt(0, "mut ");
            pKind := if isMut { rawPKind.slice(4, rawPKind.length()) } else { rawPKind };
            baseRt := "lite_" + frontend.cSafeIdent(entry.slice(0, eq));
            return if isMut or frontend.cParamIsConstPtr(pKind) { "(*" + baseRt + ")" } else { baseRt };
        }
        if separator < 0 { return ""; }
        index = index + 1;
        start = separator + 1;
    }
    ""
};

/** Returns a C11 native fast-path return expression for a registered soft-builtin function, or `""`. */
cSoftBuiltinExpr := fn(moduleName: String, fnName: String, params: String): String {
    arg0 := cParamRuntimeAt(params, 0);
    if moduleName == "lib/core/int" {
        if fnName == "Int.toText" { return "lt_c_int_text(" + arg0 + ")"; }
        if fnName == "Int.abs" { return "(" + arg0 + " < 0 ? lt_checked_negate(" + arg0 + ", 0) : " + arg0 + ")"; }
        if fnName == "Int.min" { return "(" + arg0 + " < " + cParamRuntimeAt(params, 1) + " ? " + arg0 + " : " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "Int.max" { return "(" + arg0 + " > " + cParamRuntimeAt(params, 1) + " ? " + arg0 + " : " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "Int.clamp" {
            a1 := cParamRuntimeAt(params, 1);
            a2 := cParamRuntimeAt(params, 2);
            return "(" + arg0 + " < " + a1 + " ? " + a1 + " : (" + arg0 + " > " + a2 + " ? " + a2 + " : " + arg0 + "))";
        }
        if fnName == "UInt32.clz" { return "lt_clz((uint64_t)(" + arg0 + "), 32)"; }
        if fnName == "UInt32.ctz" { return "lt_ctz((uint64_t)(" + arg0 + "), 32)"; }
        if fnName == "UInt32.popcnt" { return "lt_popcnt((uint64_t)(" + arg0 + "))"; }
        if fnName == "UInt32.bswap" { return "lt_bswap32(" + arg0 + ")"; }
        if fnName == "UInt64.clz" { return "lt_clz(" + arg0 + ", 64)"; }
        if fnName == "UInt64.ctz" { return "lt_ctz(" + arg0 + ", 64)"; }
        if fnName == "UInt64.popcnt" { return "lt_popcnt(" + arg0 + ")"; }
        if fnName == "UInt64.bswap" { return "lt_bswap64(" + arg0 + ")"; }
        if fnName == "UInt64.mulWide" {
            return "lt_wmul_u64__" + frontend.cStructTag("(lo:UInt64,hi:UInt64)") + "(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")";
        }
        if fnName == "UInt64.addWithCarry" {
            return "lt_c_u64_add_carry(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "UInt64.subWithBorrow" {
            return "lt_c_u64_sub_borrow(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
    } else if moduleName == "lib/core/list" {
        if fnName == "List.join" { return "lt_c_text_join(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "List.fillBytes" {
            return "lt_c_list_fill_bytes(&" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ", " + cParamRuntimeAt(params, 3) + ")";
        }
        if fnName == "List.copyBytes" {
            return "lt_c_list_copy_bytes(&" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ", " + cParamRuntimeAt(params, 3) + ", " + cParamRuntimeAt(params, 4) + ")";
        }
        if fnName == "List.indexOfByte" {
            return "lt_c_list_index_of_byte(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
    } else if moduleName == "lib/core/text" {
        if fnName == "String.skipSpaces" { return "lt_c_text_skip_while(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", true)"; }
        if fnName == "String.skipName" { return "lt_c_text_skip_while(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", false)"; }
        if fnName == "String.indexOf" {
            return "lt_c_text_index_of(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "String.startsWithAt" {
            return "lt_c_text_starts_with_at(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "String.wordAt" {
            return "lt_c_text_word_at(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ", " + cParamRuntimeAt(params, 2) + ")";
        }
        if fnName == "String.toInt" { return "lt_c_text_to_int(" + arg0 + ")"; }
        if fnName == "String.trimStart" { return "lt_c_text_trim(" + arg0 + ", true, false)"; }
        if fnName == "String.trimEnd" { return "lt_c_text_trim(" + arg0 + ", false, true)"; }
        if fnName == "String.trim" { return "lt_c_text_trim(" + arg0 + ", true, true)"; }
        if fnName == "String.endsWith" { return "lt_c_text_ends_with(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "String.repeat" { return "lt_c_text_repeat(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "String.contains" { return "lt_c_text_contains(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "String.toLowerAscii" { return "lt_c_text_to_lower(" + arg0 + ")"; }
        if fnName == "String.isDigit" { return "lt_c_text_is_digit(" + arg0 + ")"; }
        if fnName == "String.isAsciiLetter" { return "lt_c_text_is_ascii_letter(" + arg0 + ")"; }
        if fnName == "String.isNameStart" { return "lt_c_text_is_name_start(" + arg0 + ")"; }
        if fnName == "String.isNameContinue" { return "lt_c_text_is_name_continue(" + arg0 + ")"; }
        if fnName == "String.isWhitespace" { return "lt_c_text_is_whitespace(" + arg0 + ")"; }
        if fnName == "String.utf8Encode" { return "lt_c_utf8_encode(" + arg0 + ")"; }
        if fnName == "String.fromUtf8Strict" { return "lt_c_utf8_decode_strict(" + arg0 + ")"; }
        if fnName == "String.fromUtf8Lossy" { return "lt_c_utf8_decode_lossy(" + arg0 + ")"; }
    } else if moduleName == "lib/core/io" {
        if fnName == "Reader.fromText" { return "lt_c_io_from_text(" + arg0 + ")"; }
        if fnName == "Reader.readAll" { return "lt_c_io_read_all(" + arg0 + ")"; }
        if fnName == "Reader.readAllText" { return "lt_c_io_read_all_text(" + arg0 + ")"; }
        if fnName == "Reader.readLine" { return "lt_c_io_read_line(" + arg0 + ")"; }
        if fnName == "Writer.writeText" { return "lt_c_io_write_text(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "Writer.writeLine" { return "lt_c_io_write_line(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
    } else if moduleName == "lib/core/file" {
        if fnName == "readText" { return "lt_c_file_read_text(" + arg0 + ")"; }
        if fnName == "writeText" { return "lt_c_file_write_text(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
        if fnName == "appendText" { return "lt_c_file_append_text(" + arg0 + ", " + cParamRuntimeAt(params, 1) + ")"; }
    }
    ""
};

/** Replaces verified soft-builtin function bodies with C11 host overrides unless switched to `pure` by `--builtin-mode`. */
applyCSoftBuiltins := fn(rawItems: frontend.Items, prefix: String, builtinSpecs: List<String>): frontend.Items {
    rules := frontend.parseBuiltinModeSpecs(prefix, builtinSpecs);
    out: mut frontend.Items = [];
    var skippingDepth := 0;
    var pendingSoftFn := "";
    var pendingSoftRuntime := "";
    var pendingSoftParams := "";
    loop rawItems as item {
        if skippingDepth > 0 {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                skippingDepth = skippingDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                skippingDepth = skippingDepth - 1;
                if skippingDepth == 0 { mut out.pushBack(item); }
            }
            continue;
        }
        if item.kind == frontend.ITEM_KIND_SOFT_BUILTIN {
            if pendingSoftFn =!= "" and item.name == pendingSoftFn and item.runtime == pendingSoftRuntime and item.textValue == pendingSoftParams {
                overrideCode := cSoftBuiltinExpr(item.code, item.name, item.textValue);
                if overrideCode =!= "" and frontend.resolveBuiltinMode(rules, item.code, item.name) == frontend.BUILTIN_MODE_BUILTIN {
                    mut out.pushBack((kind = frontend.ITEM_KIND_RETURN, name = "", runtime = "", code = overrideCode, intValue = 0, textValue = ""));
                    skippingDepth = 1;
                }
            }
            pendingSoftFn = ""; pendingSoftRuntime = ""; pendingSoftParams = "";
            continue;
        }
        pendingSoftFn = ""; pendingSoftRuntime = ""; pendingSoftParams = "";
        mut out.pushBack(item);
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            pendingSoftFn = item.name;
            pendingSoftRuntime = item.runtime;
            pendingSoftParams = item.textValue;
        }
    }
    out
};

/** Emits C11 native fast-path helpers for `core/int`, `core/text`, and `core/file` soft builtins. */
emitCSoftBuiltinHelpers := fn(calls: Set<String>, config: optCfg.OptConfig): Unit {
    if not usesCSoftBuiltins(calls) { return; }
    if usesIntHelper(calls, "lt_c_text_is_digit(") {
        outLine("static bool lt_c_text_is_digit(lt_str s) { const char *d = lt_str_data(&s); return lt_str_byte_len(s) == 1u && d[0] >= '0' && d[0] <= '9'; }");
    }
    if usesIntHelper(calls, "lt_c_text_is_ascii_letter(") {
        outLine("static bool lt_c_text_is_ascii_letter(lt_str s) { const char *d = lt_str_data(&s); return lt_str_byte_len(s) == 1u && ((d[0] >= 'a' && d[0] <= 'z') || (d[0] >= 'A' && d[0] <= 'Z')); }");
    }
    usesXidCont := usesIntHelper(calls, "lt_c_text_is_name_continue(") or usesIntHelper(calls, "lt_c_text_skip_while(") or usesIntHelper(calls, "lt_c_text_word_at(");
    usesXidStart := usesIntHelper(calls, "lt_c_text_is_name_start(") or usesXidCont;
    if usesXidStart {
        outLine("static const uint32_t lt_xid_start[][2] = {");
        outLine("    {0xAAu,0xAAu}, {0xB5u,0xB5u}, {0xBAu,0xBAu}, {0xC0u,0xD6u}, {0xD8u,0xF6u}, {0xF8u,0x2C1u}, {0x2C6u,0x2D1u}, {0x2E0u,0x2E4u},");
        outLine("    {0x2ECu,0x2ECu}, {0x2EEu,0x2EEu}, {0x370u,0x374u}, {0x376u,0x377u}, {0x37Bu,0x37Du}, {0x37Fu,0x37Fu}, {0x386u,0x386u}, {0x388u,0x38Au},");
        outLine("    {0x38Cu,0x38Cu}, {0x38Eu,0x3A1u}, {0x3A3u,0x3F5u}, {0x3F7u,0x481u}, {0x48Au,0x52Fu}, {0x531u,0x556u}, {0x559u,0x559u}, {0x560u,0x588u},");
        outLine("    {0x5D0u,0x5EAu}, {0x5EFu,0x5F2u}, {0x620u,0x64Au}, {0x66Eu,0x66Fu}, {0x671u,0x6D3u}, {0x6D5u,0x6D5u}, {0x6E5u,0x6E6u}, {0x6EEu,0x6EFu},");
        outLine("    {0x6FAu,0x6FCu}, {0x6FFu,0x6FFu}, {0x710u,0x710u}, {0x712u,0x72Fu}, {0x74Du,0x7A5u}, {0x7B1u,0x7B1u}, {0x7CAu,0x7EAu}, {0x7F4u,0x7F5u},");
        outLine("    {0x7FAu,0x7FAu}, {0x800u,0x815u}, {0x81Au,0x81Au}, {0x824u,0x824u}, {0x828u,0x828u}, {0x840u,0x858u}, {0x860u,0x86Au}, {0x870u,0x887u},");
        outLine("    {0x889u,0x88Eu}, {0x8A0u,0x8C9u}, {0x904u,0x939u}, {0x93Du,0x93Du}, {0x950u,0x950u}, {0x958u,0x961u}, {0x971u,0x980u}, {0x985u,0x98Cu},");
        outLine("    {0x98Fu,0x990u}, {0x993u,0x9A8u}, {0x9AAu,0x9B0u}, {0x9B2u,0x9B2u}, {0x9B6u,0x9B9u}, {0x9BDu,0x9BDu}, {0x9CEu,0x9CEu}, {0x9DCu,0x9DDu},");
        outLine("    {0x9DFu,0x9E1u}, {0x9F0u,0x9F1u}, {0x9FCu,0x9FCu}, {0xA05u,0xA0Au}, {0xA0Fu,0xA10u}, {0xA13u,0xA28u}, {0xA2Au,0xA30u}, {0xA32u,0xA33u},");
        outLine("    {0xA35u,0xA36u}, {0xA38u,0xA39u}, {0xA59u,0xA5Cu}, {0xA5Eu,0xA5Eu}, {0xA72u,0xA74u}, {0xA85u,0xA8Du}, {0xA8Fu,0xA91u}, {0xA93u,0xAA8u},");
