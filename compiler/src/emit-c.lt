        outLine("static bool lt_cp_in_ranges(const uint32_t ranges[][2], size_t count, uint32_t cp) {");
        outLine("    size_t lo = 0u, hi = count;");
        outLine("    while (lo < hi) {");
        outLine("        size_t mid = lo + ((hi - lo) >> 1);");
        outLine("        if (cp < ranges[mid][0]) { hi = mid; }");
        outLine("        else if (cp > ranges[mid][1]) { lo = mid + 1u; }");
        outLine("        else { return true; }");
        outLine("    }");
        outLine("    return false;");
        outLine("}");
        outLine("static inline bool lt_is_xid_start_non_ascii(uint32_t cp) {");
        outLine("    return lt_cp_in_ranges(lt_xid_start, sizeof(lt_xid_start) / sizeof(lt_xid_start[0]), cp);");
        outLine("}");
        outLine("static size_t lt_utf8_decode_at(const char *s, size_t b, size_t len, uint32_t *out_cp) {");
        outLine("    unsigned char b0 = (unsigned char)s[b];");
        outLine("    if (b0 < 0x80u) { *out_cp = (uint32_t)b0; return 1u; }");
        outLine("    if ((b0 & 0xE0u) == 0xC0u && b + 1u < len) {");
        outLine("        unsigned char b1 = (unsigned char)s[b + 1u];");
        outLine("        if ((b1 & 0xC0u) == 0x80u && b0 >= 0xC2u) {");
        outLine("            *out_cp = ((uint32_t)(b0 & 0x1Fu) << 6) | (uint32_t)(b1 & 0x3Fu);");
        outLine("            return 2u;");
        outLine("        }");
        outLine("    } else if ((b0 & 0xF0u) == 0xE0u && b + 2u < len) {");
        outLine("        unsigned char b1 = (unsigned char)s[b + 1u], b2 = (unsigned char)s[b + 2u];");
        outLine("        if ((b1 & 0xC0u) == 0x80u && (b2 & 0xC0u) == 0x80u) {");
        outLine("            uint32_t cp = ((uint32_t)(b0 & 0x0Fu) << 12) | ((uint32_t)(b1 & 0x3Fu) << 6) | (uint32_t)(b2 & 0x3Fu);");
        outLine("            if (cp >= 0x800u && (cp < 0xD800u || cp > 0xDFFFu)) { *out_cp = cp; return 3u; }");
        outLine("        }");
        outLine("    } else if ((b0 & 0xF8u) == 0xF0u && b + 3u < len) {");
        outLine("        unsigned char b1 = (unsigned char)s[b + 1u], b2 = (unsigned char)s[b + 2u], b3 = (unsigned char)s[b + 3u];");
        outLine("        if ((b1 & 0xC0u) == 0x80u && (b2 & 0xC0u) == 0x80u && (b3 & 0xC0u) == 0x80u) {");
        outLine("            uint32_t cp = ((uint32_t)(b0 & 0x07u) << 18) | ((uint32_t)(b1 & 0x3Fu) << 12) | ((uint32_t)(b2 & 0x3Fu) << 6) | (uint32_t)(b3 & 0x3Fu);");
        outLine("            if (cp >= 0x10000u && cp <= 0x10FFFFu) { *out_cp = cp; return 4u; }");
        outLine("        }");
        outLine("    }");
        outLine("    *out_cp = 0u;");
        outLine("    return 0u;");
        outLine("}");
    }
