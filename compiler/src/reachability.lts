/** Target helper call scanning, 32-bucket token sets, block-scoped pure dead-code pruning, and program reachability filtering. */

integer := import "core/int";
listLib := import "core/list";
textLib := import "core/text";
ir := import "./frontend-ir.lts";
syntax := import "./frontend-syntax.lts";
types := import "./frontend-types.lts";
trace := import "./trace-safety.lts";

/** One parsed item entry matching `frontend-ir.Item`. */
Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := type List<Item>;

/** 32-bucket hashed string set matching `frontend-ir.TokenBuckets`. */
TokenBuckets := type (count: Int, b0: String, b1: String, b2: String, b3: String, b4: String, b5: String, b6: String, b7: String, b8: String, b9: String, b10: String, b11: String, b12: String, b13: String, b14: String, b15: String, b16: String, b17: String, b18: String, b19: String, b20: String, b21: String, b22: String, b23: String, b24: String, b25: String, b26: String, b27: String, b28: String, b29: String, b30: String, b31: String);

/** True when emitted target code calls `needle` outside quoted String literal text. */
pub codeUsesTextCall := fn(code: String, needle: String): Bool {
    if textLib.indexOfText(code, needle, 0) < 0 { return false; }
    size := textLib.length(code);
    if size == 0 { return false; }
    width := textLib.length(needle);
    if width == 0 { return true; }
    first := textLib.at(needle, 0);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := textLib.at(code, cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if ch == first and textLib.startsWithAt(code, cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
};

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
};

/** True when emitted target code calls a checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(") or codeUsesTextCall(code, "lite$listPopFront(")
};

/** True when emitted target code contains a C list-copy placeholder outside quoted String literal text. */
pub codeUsesListCopy := fn(code: String): Bool {
    codeUsesTextCall(code, "lt_list_copy(")
};

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
};

/** Collects distinct target or user-function call tokens, skipping quoted text and consuming whole identifiers. */
scanCodeCalls := fn(code: String, existing: String, userFnsOnly: Bool): String {
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    var nextFinally := if userFnsOnly { -1 } else { textLib.indexOfText(code, "finally", 0) };
    if nextLite < 0 and nextLt < 0 and nextFinally < 0 { return existing; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var calls := existing;
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        if nextFinally >= 0 and nextFinally < cursor { nextFinally = textLib.indexOfText(code, "finally", cursor); }
        var hit := -1;
        if nextLite >= 0 { hit = nextLite; }
        if nextLt >= 0 and (hit < 0 or nextLt < hit) { hit = nextLt; }
        if nextFinally >= 0 and (hit < 0 or nextFinally < hit) { hit = nextFinally; }
        if hit < 0 { return calls; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = textLib.indexOfText(code, "\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        name := textLib.slice(code, hit, endPos);
        if endPos < size and textLib.at(code, endPos) == "(" {
            matched := if userFnsOnly {
                textLib.startsWithAt(name, 0, "lt_fn_") or textLib.startsWithAt(name, 0, "liteFn$") or
                textLib.startsWithAt(name, 0, "liteFn_")
            } else {
                (textLib.startsWithAt(name, 0, "lite$") and not textLib.startsWithAt(name, 0, "lite$m$")) or
                textLib.startsWithAt(name, 0, "lite_") or
                (textLib.startsWithAt(name, 0, "lt_") and not textLib.startsWithAt(name, 0, "lt_fn_") and
                not textLib.startsWithAt(name, 0, "lt_m_") and not textLib.startsWithAt(name, 0, "lt_s"))
            };
            if matched {
                token := name + "(|";
                if textLib.indexOfText(calls, "|" + token, 0) < 0 { calls = calls + token; }
            }
        } else if not userFnsOnly and name == "finally" {
            var afterFin := endPos;
            loop afterFin < size and (textLib.at(code, afterFin) == " " or textLib.at(code, afterFin) == "\t" or textLib.at(code, afterFin) == "\n") {
                afterFin = afterFin + 1;
            }
            if afterFin < size and textLib.at(code, afterFin) == "{" {
                if textLib.indexOfText(calls, "|lite$finally(|", 0) < 0 { calls = calls + "lite$finally(|"; }
            }
        }
        cursor = endPos;
    }
    calls
};

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, false)
};

/** Collects distinct user-function call tokens (`lt_fn_*(` / `liteFn...(`) from `code`, skipping quoted text. */
pub userFunctionCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, true)
};

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCalls := fn(items: Items): String {
    var calls := "|";
    loop items as item { calls = targetCodeCalls(item.code, calls); }
    calls
};

/** True when `calls` already contains the pipe-delimited call token `needle`. */
pub hasHelperToken := fn(calls: String, needle: String): Bool {
    textLib.indexOfText(calls, "|" + needle + "|", 0) >= 0
};

/** Creates an empty 32-bucket token set. */
pub emptyTokenBuckets := fn(): TokenBuckets {
    (count = 0, b0 = "|", b1 = "|", b2 = "|", b3 = "|", b4 = "|", b5 = "|", b6 = "|", b7 = "|",
    b8 = "|", b9 = "|", b10 = "|", b11 = "|", b12 = "|", b13 = "|", b14 = "|", b15 = "|",
    b16 = "|", b17 = "|", b18 = "|", b19 = "|", b20 = "|", b21 = "|", b22 = "|", b23 = "|",
    b24 = "|", b25 = "|", b26 = "|", b27 = "|", b28 = "|", b29 = "|", b30 = "|", b31 = "|")
};

/** Maps a token string to its 0..31 bucket index using its code-point length. */
tokenBucketSlot := fn(needle: String): Int {
    n := textLib.length(needle);
    n - (n / 32) * 32
};

/** Reads the bucket string stored at `slot` (0..31) in `s`. */
tokenBucketGet := fn(s: TokenBuckets, slot: Int): String {
    if slot < 16 {
        if slot < 8 {
            if slot == 0 { return s.b0; }
            if slot == 1 { return s.b1; }
            if slot == 2 { return s.b2; }
            if slot == 3 { return s.b3; }
            if slot == 4 { return s.b4; }
            if slot == 5 { return s.b5; }
            if slot == 6 { return s.b6; }
            return s.b7;
        }
        if slot == 8 { return s.b8; }
        if slot == 9 { return s.b9; }
        if slot == 10 { return s.b10; }
        if slot == 11 { return s.b11; }
        if slot == 12 { return s.b12; }
        if slot == 13 { return s.b13; }
        if slot == 14 { return s.b14; }
        return s.b15;
    }
    if slot < 24 {
        if slot == 16 { return s.b16; }
        if slot == 17 { return s.b17; }
        if slot == 18 { return s.b18; }
        if slot == 19 { return s.b19; }
        if slot == 20 { return s.b20; }
        if slot == 21 { return s.b21; }
        if slot == 22 { return s.b22; }
        return s.b23;
    }
    if slot == 24 { return s.b24; }
    if slot == 25 { return s.b25; }
    if slot == 26 { return s.b26; }
    if slot == 27 { return s.b27; }
    if slot == 28 { return s.b28; }
    if slot == 29 { return s.b29; }
    if slot == 30 { return s.b30; }
    s.b31
};

/** Returns a copy of `s` with bucket `slot` replaced by `val` and `count` incremented. */
withTokenBucket := fn(s: TokenBuckets, slot: Int, val: String): TokenBuckets {
    (count = s.count + 1,
    b0 = if slot == 0 { val } else { s.b0 }, b1 = if slot == 1 { val } else { s.b1 },
    b2 = if slot == 2 { val } else { s.b2 }, b3 = if slot == 3 { val } else { s.b3 },
    b4 = if slot == 4 { val } else { s.b4 }, b5 = if slot == 5 { val } else { s.b5 },
    b6 = if slot == 6 { val } else { s.b6 }, b7 = if slot == 7 { val } else { s.b7 },
    b8 = if slot == 8 { val } else { s.b8 }, b9 = if slot == 9 { val } else { s.b9 },
    b10 = if slot == 10 { val } else { s.b10 }, b11 = if slot == 11 { val } else { s.b11 },
    b12 = if slot == 12 { val } else { s.b12 }, b13 = if slot == 13 { val } else { s.b13 },
    b14 = if slot == 14 { val } else { s.b14 }, b15 = if slot == 15 { val } else { s.b15 },
    b16 = if slot == 16 { val } else { s.b16 }, b17 = if slot == 17 { val } else { s.b17 },
    b18 = if slot == 18 { val } else { s.b18 }, b19 = if slot == 19 { val } else { s.b19 },
    b20 = if slot == 20 { val } else { s.b20 }, b21 = if slot == 21 { val } else { s.b21 },
    b22 = if slot == 22 { val } else { s.b22 }, b23 = if slot == 23 { val } else { s.b23 },
    b24 = if slot == 24 { val } else { s.b24 }, b25 = if slot == 25 { val } else { s.b25 },
    b26 = if slot == 26 { val } else { s.b26 }, b27 = if slot == 27 { val } else { s.b27 },
    b28 = if slot == 28 { val } else { s.b28 }, b29 = if slot == 29 { val } else { s.b29 },
    b30 = if slot == 30 { val } else { s.b30 }, b31 = if slot == 31 { val } else { s.b31 })
};

/** True when `s` contains `needle`. */
pub tokenBucketHas := fn(s: TokenBuckets, needle: String): Bool {
    if needle == "" { return false; }
    textLib.indexOfText(tokenBucketGet(s, tokenBucketSlot(needle)), "|" + needle + "|", 0) >= 0
};

/** Returns `s` with `needle` inserted into its length-hashed bucket. */
pub tokenBucketAdd := fn(s: TokenBuckets, needle: String): TokenBuckets {
    if needle == "" { return s; }
    slot := tokenBucketSlot(needle);
    b := tokenBucketGet(s, slot);
    if textLib.indexOfText(b, "|" + needle + "|", 0) >= 0 { return s; }
    withTokenBucket(s, slot, b + needle + "|")
};

/** Serializes all 32 buckets into one `|`-delimited string. */
pub flattenTokenBuckets := fn(s: TokenBuckets): String {
    var out := "|";
    var i := 0;
    loop i < 32 {
        b := tokenBucketGet(s, i);
        bLen := textLib.length(b);
        if bLen > 1 { out = out + textLib.slice(b, 1, bLen); }
        i = i + 1;
    }
    out
};

/** Collects distinct `lite*` / `lt_*` call or value identifier tokens from `code` into `existing`. */
pub codeReachableTokensSet := fn(code: String, existing: TokenBuckets): TokenBuckets {
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    if nextLite < 0 and nextLt < 0 { return existing; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var tokens := existing;
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return tokens; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor {
                nextQuote = textLib.indexOfText(code, "\"", cursor);
            }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        name := textLib.slice(code, hit, endPos);
        token := if textLib.startsWithAt(name, 0, "lt_fn_") or textLib.startsWithAt(name, 0, "liteFn$") or
        textLib.startsWithAt(name, 0, "liteFn_") {
            name + "("
        } else {
            name
        };
        tokens = tokenBucketAdd(tokens, token);
        cursor = endPos;
    }
    tokens
};

/** True when `kind` represents a top-level value or mutable variable declaration item. */
isTopDeclKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_LOCAL_INT or kind == ir.ITEM_KIND_LOCAL_STRING or kind == ir.ITEM_KIND_LOCAL_BOOL or kind == ir.ITEM_KIND_LOCAL_FLOAT or
    kind == ir.ITEM_KIND_LOCAL_TUPLE or kind == ir.ITEM_KIND_LOCAL_RECORD or kind == ir.ITEM_KIND_LOCAL_LIST or kind == ir.ITEM_KIND_LOCAL_FN or kind == ir.ITEM_KIND_LOCAL_UNIT or
    kind == ir.ITEM_KIND_VAR_INT or kind == ir.ITEM_KIND_VAR_STRING or kind == ir.ITEM_KIND_VAR_BOOL or kind == ir.ITEM_KIND_VAR_FLOAT or
    kind == ir.ITEM_KIND_VAR_TUPLE or kind == ir.ITEM_KIND_VAR_RECORD or kind == ir.ITEM_KIND_VAR_LIST or kind == ir.ITEM_KIND_VAR_FN or kind == ir.ITEM_KIND_VAR_UNIT
};

/** True when `kind` and `code` only use scalar/unit features valid for scalar C dead-code pruning, preserving unsupported-type checks. */
pub isCSupportedKindAndCode := fn(kind: String, code: String): Bool {
    not types.isTupleKind(kind) and not types.isRecordKind(kind) and not types.isEnumKind(kind) and not types.isMapKind(kind) and not types.isListKind(kind) and not types.isArrayKind(kind) and not types.containsFnKind(kind) and
    not codeUsesValueIf(code) and not codeUsesListCopy(code) and not codeUsesListIndex(code) and not codeUsesListPop(code)
};

/** True when `item` uses a C-unsupported construct that must stay visible to `emitProgram` diagnostics. */
isCUnsupportedItem := fn(item: Item): Bool {
    item.kind == ir.ITEM_KIND_LOCAL_TUPLE or item.kind == ir.ITEM_KIND_VAR_TUPLE or item.kind == ir.ITEM_KIND_ASSIGN_TUPLE or
    item.kind == ir.ITEM_KIND_LOCAL_RECORD or item.kind == ir.ITEM_KIND_VAR_RECORD or item.kind == ir.ITEM_KIND_ASSIGN_RECORD or
    item.kind == ir.ITEM_KIND_LOCAL_LIST or item.kind == ir.ITEM_KIND_VAR_LIST or item.kind == ir.ITEM_KIND_ASSIGN_LIST or
    item.kind == ir.ITEM_KIND_LOCAL_FN or item.kind == ir.ITEM_KIND_VAR_FN or item.kind == ir.ITEM_KIND_ASSIGN_FN or
    (item.kind == ir.ITEM_KIND_DISCARD and (types.isTupleKind(item.name) or types.isRecordKind(item.name) or types.isEnumKind(item.name) or types.isMapKind(item.name) or types.isListKind(item.name) or
    types.isArrayKind(item.name) or types.containsFnKind(item.name))) or
    codeUsesValueIf(item.code) or codeUsesListCopy(item.code) or codeUsesListIndex(item.code) or codeUsesListPop(item.code)
};

/** True when `=` at `eqPos` in `stripped` is a comparison/arrow or an assignment to a local declared inside `stripped` itself. */
isInnerLocalAssignAt := fn(stripped: String, eqPos: Int): Bool {
    len := textLib.length(stripped);
    if eqPos < 0 or eqPos >= len or textLib.at(stripped, eqPos) =!= "=" { return false; }
    if eqPos + 1 < len {
        nx := textLib.at(stripped, eqPos + 1);
        if nx == "=" or nx == ">" { return true; }
    }
    if eqPos > 0 {
        pv := textLib.at(stripped, eqPos - 1);
        if pv == "=" or pv == "!" or pv == "<" or pv == ">" { return true; }
        if pv == "+" or pv == "-" or pv == "*" or pv == "/" or pv == "%" { return false; }
    }
    var scanBack := eqPos - 1;
    var bDepth := 0;
    loop scanBack >= 0 {
        sc := textLib.at(stripped, scanBack);
        if sc == ")" or sc == "]" or sc == "}" {
            bDepth = bDepth + 1;
        } else if sc == "(" or sc == "[" or sc == "{" {
            if bDepth == 0 {
                scanBack = scanBack + 1;
                break;
            }
            bDepth = bDepth - 1;
        } else if sc == ";" and bDepth == 0 {
            scanBack = scanBack + 1;
            break;
        }
        scanBack = scanBack - 1;
    }
    if scanBack < 0 { scanBack = 0; }
    stmtPos := trace.skipCodeSpaces(stripped, scanBack);
    if textLib.wordAt(stripped, stmtPos, "const") or textLib.wordAt(stripped, stmtPos, "let") {
        return true;
    }
    if stmtPos >= eqPos or not (textLib.isNameStart(textLib.at(stripped, stmtPos)) or textLib.at(stripped, stmtPos) == "$") {
        return false;
    }
    var lhsEnd := stmtPos;
    loop lhsEnd < eqPos and trace.isTraceIdentChar(textLib.at(stripped, lhsEnd)) { lhsEnd = lhsEnd + 1; }
    if trace.skipCodeSpaces(stripped, lhsEnd) =!= eqPos { return false; }
    lhs := textLib.slice(stripped, stmtPos, lhsEnd);
    textLib.indexOfText(stripped, "let " + lhs + " ", 0) >= 0 or
    textLib.indexOfText(stripped, "let " + lhs + ":", 0) >= 0 or
    textLib.indexOfText(stripped, "let " + lhs + ";", 0) >= 0
};

/** True when `code` has no function calls, runtime panic helpers, loops, throws, or outer mutations after stripping uninvoked `fn` literals. */
pub isSideEffectFreeCode := fn(target: String, code: String): Bool {
    if code == "" { return true; }
    stripped := trace.stripDeferredFnBodies(code).code;
    size := textLib.length(stripped);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(stripped, cursor);
        if ch == "\"" {
            cursor = trace.skipCodeString(stripped, cursor);
            continue;
        }
        if ch == "(" {
            if textLib.startsWithAt(stripped, cursor, "(function ") { return false; }
            closeEnd := trace.scanBalancedParenEnd(stripped, cursor);
            if trace.isIndirectUserCallParens(stripped, cursor, closeEnd) { return false; }
            if target == ir.TARGET_TS and closeEnd >= 0 {
                afterClose := trace.skipCodeSpaces(stripped, closeEnd);
                if afterClose < size and textLib.at(stripped, afterClose) == "(" and
                not trace.isCompilerArrowIife(stripped, cursor, closeEnd) {
                    return false;
                }
            }
            cursor = cursor + 1;
            continue;
        }
        if ch == "]" {
            afterBr := trace.skipCodeSpaces(stripped, cursor + 1);
            if afterBr < size and textLib.at(stripped, afterBr) == "(" { return false; }
            cursor = cursor + 1;
            continue;
        }
        if ch == "=" {
            if not isInnerLocalAssignAt(stripped, cursor) { return false; }
            cursor = cursor + 1;
            continue;
        }
        if textLib.isNameStart(ch) or ch == "$" {
            var endPos := cursor;
            loop endPos < size and trace.isTraceIdentChar(textLib.at(stripped, endPos)) { endPos = endPos + 1; }
            name := textLib.slice(stripped, cursor, endPos);
            prevIsDot := cursor > 0 and textLib.at(stripped, cursor - 1) == ".";
            if not prevIsDot and (name == "throw" or name == "while" or name == "for" or name == "try") {
                return false;
            }
            afterName := trace.skipCodeSpaces(stripped, endPos);
            if afterName < size and textLib.at(stripped, afterName) == "(" {
                isKeywordParen := not prevIsDot and (name == "if" or name == "return" or name == "void");
                isMathPrefix := cursor >= 5 and textLib.slice(stripped, cursor - 5, cursor) == "Math." and
                (cursor == 5 or not trace.isTraceIdentChar(textLib.at(stripped, cursor - 6)));
                isMathFround := name == "fround" and isMathPrefix;
                isPureWrapper := not prevIsDot and (
                name == "Boolean" or name == "Number" or name == "INT64_C" or
                name == "lt_float_literal" or name == "lt_float32_literal" or name == "strcmp"
                );
                if not isKeywordParen and not isMathFround and not isPureWrapper {
                    return false;
                }
            }
            cursor = endPos;
            continue;
        }
        cursor = cursor + 1;
    }
    true
};

/** True when a declaration or discarded expression of `kind` and `code` can be omitted on `target` without altering observable behavior or diagnostics. */
pub isPrunableExprForTarget := fn(target: String, kind: String, code: String): Bool {
    if target =!= ir.TARGET_TS and not isCSupportedKindAndCode(kind, code) { return false; }
    isSideEffectFreeCode(target, code)
};

/** Eliminates unreachable pure statements and local bindings inside one `{ ... }` block after its statements and tail are parsed. */
pub pruneBlockStatements := fn(stmts: List<String>, owners: List<String>, deps: List<String>, hasTail: Bool, tailCode: String): List<String> {
    var total := 0;
    var hasPrunable := false;
    loop stmts { total = total + 1; }
    if total == 0 {
        emptyOut: mut List<String> = [];
        return emptyOut;
    }
    var checkIdx := 0;
    loop checkIdx < total {
        if owners[checkIdx] =!= "" {
            hasPrunable = true;
            break;
        }
        checkIdx = checkIdx + 1;
    }
    if not hasPrunable { return stmts; }

    var reachable := emptyTokenBuckets();
    if hasTail {
        reachable = codeReachableTokensSet(tailCode, reachable);
    }
    var seedIdx := 0;
    loop seedIdx < total {
        if owners[seedIdx] == "" {
            reachable = codeReachableTokensSet(deps[seedIdx], reachable);
        }
        seedIdx = seedIdx + 1;
    }

    var scannedBag := "";
    loop true {
        beforeCount := reachable.count;
        var scanIdx := 0;
        loop scanIdx < total {
            ow := owners[scanIdx];
            if ow =!= "" and ow =!= "#discard" and tokenBucketHas(reachable, ow) {
                key := integer.intText(scanIdx);
                if not trace.tokenInPipeBag(scannedBag, key) {
                    scannedBag = trace.appendPipeBag(scannedBag, key);
                    reachable = codeReachableTokensSet(deps[scanIdx], reachable);
                }
            }
            scanIdx = scanIdx + 1;
        }
        if reachable.count == beforeCount { break; }
    }

    kept: mut List<String> = [];
    var outIdx := 0;
    loop outIdx < total {
        ow := owners[outIdx];
        if ow == "" or (ow =!= "#discard" and tokenBucketHas(reachable, ow)) {
            listLib.pushBack(mut kept, stmts[outIdx]);
        }
        outIdx = outIdx + 1;
    }
    kept
};

/** Returns ancestor depth (`0` for `startBlockId`) of `targetBlockId` in `startBlockId`'s chain, or `-1`. */
blockAncestorDistance := fn(targetBlockId: Int, startBlockId: Int, parentBlockIds: List<Int>): Int {
    var b := startBlockId;
    var dist := 0;
    loop b > 0 {
        if b == targetBlockId { return dist; }
        b = parentBlockIds[b];
        dist = dist + 1;
    }
    -1
};

/** Finds matching declaration index in `decl*` along the lexical parent chain from `startBlockId`, or -1. */
findDeclInBlockChain := fn(runtime: String, startBlockId: Int, parentBlockIds: List<Int>,
declRuntimes: List<String>, declBlockIds: List<Int>, declCount: Int): Int {
    var bestIdx := -1;
    var bestDist := -1;
    var d := declCount - 1;
    loop d >= 0 {
        if declRuntimes[d] == runtime {
            dist := blockAncestorDistance(declBlockIds[d], startBlockId, parentBlockIds);
            if dist >= 0 and (bestDist < 0 or dist < bestDist) {
                bestIdx = d;
                bestDist = dist;
                if dist == 0 { return d; }
            }
        }
        d = d - 1;
    }
    bestIdx
};

/** Maps runtime identifier references in `code` to matching declaration item indices along `startBlockId`'s lexical ancestor chain. */
resolveBlockLexicalDeps := fn(code: String, startBlockId: Int, parentBlockIds: List<Int>,
declRuntimes: List<String>, declBlockIds: List<Int>, declIdxs: List<Int>, declCount: Int): String {
    if declCount <= 0 or startBlockId <= 0 or code == "" { return ""; }
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    if nextLite < 0 and nextLt < 0 { return ""; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var bag := "";
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return bag; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = textLib.indexOfText(code, "\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        tok := textLib.slice(code, hit, endPos);
        matchedDecl := findDeclInBlockChain(tok, startBlockId, parentBlockIds, declRuntimes, declBlockIds, declCount);
        if matchedDecl >= 0 {
            bag = trace.appendPipeBag(bag, integer.intText(declIdxs[matchedDecl]));
        }
        cursor = endPos;
    }
    bag
};

/** Merges every index token in pipe-delimited `links` into `bag` without duplicates. */
mergeIndexPipeBag := fn(bag: String, links: String): String {
    if links == "" { return bag; }
    var out := bag;
    len := textLib.length(links);
    var pos := 0;
    loop pos < len {
        if textLib.at(links, pos) == "|" {
            pos = pos + 1;
            continue;
        }
        nextBar := textLib.indexOfText(links, "|", pos);
        endPos := if nextBar < 0 { len } else { nextBar };
        if endPos > pos {
            out = trace.appendPipeBag(out, textLib.slice(links, pos, endPos));
        }
        pos = endPos + 1;
    }
    out
};

/** Eliminates dead pure locals, pure discarded expressions, and resulting empty scopes per lexical block (supporting forward same-block references). */
pub pruneBlockScopedItems := fn(items: Items, target: String): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total == 0 { return items; }
    var hasPrunable := false;
    blockStack: mut List<Int> = [0];
    var stackLen := 1;
    parentBlockIds: mut List<Int> = [-1];
    var nextBlockId := 1;
    declRuntimes: mut List<String> = [];
    declBlockIds: mut List<Int> = [];
    declIdxs: mut List<Int> = [];
    declPrunables: mut List<Bool> = [];
    var declCount := 0;
    itemEvalBlocks: mut List<Int> = [];
    itemOwners: mut List<Int> = [];
    var idx := 0;
    loop idx < total {
        item := items[idx];
        curBlockId := blockStack[stackLen - 1];
        var evalBlockId := curBlockId;
        var owner := -1;
        if item.kind == ir.ITEM_KIND_ELSE_IF or item.kind == ir.ITEM_KIND_ELSE {
            if stackLen > 1 {
                _popArm := listLib.popBack(mut blockStack);
                stackLen = stackLen - 1;
            }
            parentId := blockStack[stackLen - 1];
            evalBlockId = parentId;
            newArmId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            listLib.pushBack(mut parentBlockIds, parentId);
            listLib.pushBack(mut blockStack, newArmId);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP or item.kind == ir.ITEM_KIND_FUNCTION_END {
            if stackLen > 1 {
                _popEnd := listLib.popBack(mut blockStack);
                stackLen = stackLen - 1;
            }
        } else if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_START or
        item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            newBlockId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            listLib.pushBack(mut parentBlockIds, curBlockId);
            listLib.pushBack(mut blockStack, newBlockId);
            stackLen = stackLen + 1;
            if item.kind == ir.ITEM_KIND_LOOP_SEQ and item.runtime =!= "" {
                listLib.pushBack(mut declRuntimes, item.runtime);
                listLib.pushBack(mut declBlockIds, newBlockId);
                listLib.pushBack(mut declIdxs, idx);
                listLib.pushBack(mut declPrunables, false);
                declCount = declCount + 1;
            }
        } else if item.kind == ir.ITEM_KIND_DISCARD {
            if (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code) {
                owner = -2;
                hasPrunable = true;
            }
        } else if evalBlockId > 0 and isTopDeclKind(item.kind) and item.runtime =!= "" {
            canPruneDecl := (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code);
            if canPruneDecl {
                owner = idx;
                hasPrunable = true;
            }
            listLib.pushBack(mut declRuntimes, item.runtime);
            listLib.pushBack(mut declBlockIds, evalBlockId);
            listLib.pushBack(mut declIdxs, idx);
            listLib.pushBack(mut declPrunables, canPruneDecl);
            declCount = declCount + 1;
        }
        listLib.pushBack(mut itemEvalBlocks, evalBlockId);
        listLib.pushBack(mut itemOwners, owner);
        idx = idx + 1;
    }
    if not hasPrunable { return items; }

    resolvedOwners: mut List<Int> = [];
    itemDeps: mut List<String> = [];
    var idx2 := 0;
    loop idx2 < total {
        item := items[idx2];
        evalBlock := itemEvalBlocks[idx2];
        var owner2 := itemOwners[idx2];
        var deps := "";
        if owner2 == -2 {
            deps = "";
        } else if evalBlock > 0 and textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
            matchedDecl := findDeclInBlockChain(item.runtime, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declCount);
            if matchedDecl >= 0 and declPrunables[matchedDecl] and (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and
            isSideEffectFreeCode(target, item.code) {
                owner2 = declIdxs[matchedDecl];
                deps = resolveBlockLexicalDeps(item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
            } else {
                deps = resolveBlockLexicalDeps(item.runtime + " " + item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
            }
        } else {
            deps = resolveBlockLexicalDeps(item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
        }
        listLib.pushBack(mut resolvedOwners, owner2);
        listLib.pushBack(mut itemDeps, deps);
        idx2 = idx2 + 1;
    }

    var liveDeclBag := "";
    var seedIdx := 0;
    loop seedIdx < total {
        if resolvedOwners[seedIdx] == -1 {
            liveDeclBag = mergeIndexPipeBag(liveDeclBag, itemDeps[seedIdx]);
        }
        seedIdx = seedIdx + 1;
    }
    var scannedItemBag := "";
    loop true {
        beforeLen := textLib.length(liveDeclBag);
        var j := 0;
        loop j < total {
            own := resolvedOwners[j];
            if own >= 0 and trace.tokenInPipeBag(liveDeclBag, integer.intText(own)) {
                key := integer.intText(j);
                if not trace.tokenInPipeBag(scannedItemBag, key) {
                    scannedItemBag = trace.appendPipeBag(scannedItemBag, key);
                    liveDeclBag = mergeIndexPipeBag(liveDeclBag, itemDeps[j]);
                }
            }
            j = j + 1;
        }
        if textLib.length(liveDeclBag) == beforeLen { break; }
    }

    peeled: mut Items = [];
    var peeledLen := 0;
    var k := 0;
    loop k < total {
        ownk := resolvedOwners[k];
        keepItem := ownk == -1 or (ownk >= 0 and trace.tokenInPipeBag(liveDeclBag, integer.intText(ownk)));
        if keepItem {
            cur := items[k];
            if cur.kind == ir.ITEM_KIND_END_SCOPE and peeledLen > 0 and peeled[peeledLen - 1].kind == ir.ITEM_KIND_SCOPE {
                _dropScope := listLib.popBack(mut peeled);
                peeledLen = peeledLen - 1;
            } else {
                listLib.pushBack(mut peeled, cur);
                peeledLen = peeledLen + 1;
            }
        }
        k = k + 1;
    }
    peeled
};

/** Simplifies statement-level `if` / `else if` / `else` chains and `loop false` blocks with compile-time constant Bool conditions in a single O(n) pass. */
pub simplifyConstantBranches := fn(items: Items, target: String): Items {
    trueLit := ir.targetBoolLiteralCode(target, true);
    falseLit := ir.targetBoolLiteralCode(target, false);
    var hasConstBranch := false;
    var hasCUnsupported := false;
    loop items as scanItem {
        if ((scanItem.kind == ir.ITEM_KIND_IF or scanItem.kind == ir.ITEM_KIND_ELSE_IF) and
        (scanItem.code == trueLit or scanItem.code == falseLit)) or
        (scanItem.kind == ir.ITEM_KIND_LOOP and scanItem.code == falseLit) {
            hasConstBranch = true;
        }
        if target =!= ir.TARGET_TS and isCUnsupportedItem(scanItem) {
            hasCUnsupported = true;
        }
    }
    if not hasConstBranch or hasCUnsupported { return items; }
    frameKinds: mut List<Int> = [];
    frameModes: mut List<Int> = [];
    frameTakens: mut List<Bool> = [];
    frameSkips: mut List<Bool> = [];
    frameParentSkips: mut List<Bool> = [];
    var stackLen := 0;
    out: mut Items = [];
    loop items as item {
        currentlySkipping := if stackLen > 0 { frameSkips[stackLen - 1] } else { false };
        if item.kind == ir.ITEM_KIND_IF {
            if currentlySkipping {
                listLib.pushBack(mut frameKinds, 0);
                listLib.pushBack(mut frameModes, 0);
                listLib.pushBack(mut frameTakens, false);
                listLib.pushBack(mut frameSkips, true);
                listLib.pushBack(mut frameParentSkips, true);
                stackLen = stackLen + 1;
            } else if item.code == falseLit {
                listLib.pushBack(mut frameKinds, 1);
                listLib.pushBack(mut frameModes, 0);
                listLib.pushBack(mut frameTakens, false);
                listLib.pushBack(mut frameSkips, true);
                listLib.pushBack(mut frameParentSkips, false);
                stackLen = stackLen + 1;
            } else if item.code == trueLit {
                listLib.pushBack(mut out, (kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                listLib.pushBack(mut frameKinds, 1);
                listLib.pushBack(mut frameModes, 2);
                listLib.pushBack(mut frameTakens, true);
                listLib.pushBack(mut frameSkips, false);
                listLib.pushBack(mut frameParentSkips, false);
                stackLen = stackLen + 1;
            } else {
                listLib.pushBack(mut out, item);
                listLib.pushBack(mut frameKinds, 1);
                listLib.pushBack(mut frameModes, 1);
                listLib.pushBack(mut frameTakens, false);
                listLib.pushBack(mut frameSkips, false);
                listLib.pushBack(mut frameParentSkips, false);
                stackLen = stackLen + 1;
            }
        } else if item.kind == ir.ITEM_KIND_ELSE_IF {
            if stackLen > 0 and not frameParentSkips[stackLen - 1] and frameKinds[stackLen - 1] == 1 {
                mode := listLib.popBack(mut frameModes);
                taken := listLib.popBack(mut frameTakens);
                _prevSkip := listLib.popBack(mut frameSkips);
                var newMode := mode;
                var newTaken := taken;
                var newSkip := true;
                if taken {
                    newSkip = true;
                } else if item.code == falseLit {
                    newSkip = true;
                } else if item.code == trueLit {
                    if mode == 0 {
                        listLib.pushBack(mut out, (kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                        newMode = 2;
                    } else {
                        listLib.pushBack(mut out, (kind = ir.ITEM_KIND_ELSE, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                        newMode = 1;
                    }
                    newTaken = true;
                    newSkip = false;
                } else {
                    if mode == 0 {
                        listLib.pushBack(mut out, (kind = ir.ITEM_KIND_IF, name = item.name, runtime = item.runtime, code = item.code, intValue = item.intValue, textValue = item.textValue));
                        newMode = 1;
                    } else {
                        listLib.pushBack(mut out, item);
                        newMode = 1;
                    }
                    newTaken = false;
                    newSkip = false;
                }
                listLib.pushBack(mut frameModes, newMode);
                listLib.pushBack(mut frameTakens, newTaken);
                listLib.pushBack(mut frameSkips, newSkip);
            }
        } else if item.kind == ir.ITEM_KIND_ELSE {
            if stackLen > 0 and not frameParentSkips[stackLen - 1] and frameKinds[stackLen - 1] == 1 {
                mode := listLib.popBack(mut frameModes);
                taken := listLib.popBack(mut frameTakens);
                _prevSkip := listLib.popBack(mut frameSkips);
                var newMode := mode;
                var newTaken := true;
                var newSkip := true;
                if taken {
                    newSkip = true;
                } else if mode == 0 {
                    listLib.pushBack(mut out, (kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                    newMode = 2;
                    newSkip = false;
                } else {
                    listLib.pushBack(mut out, item);
                    newMode = 1;
                    newSkip = false;
                }
                listLib.pushBack(mut frameModes, newMode);
                listLib.pushBack(mut frameTakens, newTaken);
                listLib.pushBack(mut frameSkips, newSkip);
            }
        } else if item.kind == ir.ITEM_KIND_END_IF {
            if stackLen > 0 {
                kind := listLib.popBack(mut frameKinds);
                mode := listLib.popBack(mut frameModes);
                _taken := listLib.popBack(mut frameTakens);
                _skip := listLib.popBack(mut frameSkips);
                parentSkip := listLib.popBack(mut frameParentSkips);
                stackLen = stackLen - 1;
                if not parentSkip and kind == 1 {
                    if mode == 1 {
                        listLib.pushBack(mut out, item);
                    } else if mode == 2 {
                        listLib.pushBack(mut out, (kind = ir.ITEM_KIND_END_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                    }
                }
            }
        } else if item.kind == ir.ITEM_KIND_LOOP and item.code == falseLit {
            listLib.pushBack(mut frameKinds, 0);
            listLib.pushBack(mut frameModes, 0);
            listLib.pushBack(mut frameTakens, false);
            listLib.pushBack(mut frameSkips, true);
            listLib.pushBack(mut frameParentSkips, true);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_START or
        item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            if not currentlySkipping { listLib.pushBack(mut out, item); }
            listLib.pushBack(mut frameKinds, 0);
            listLib.pushBack(mut frameModes, 0);
            listLib.pushBack(mut frameTakens, false);
            listLib.pushBack(mut frameSkips, currentlySkipping);
            listLib.pushBack(mut frameParentSkips, currentlySkipping);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_END or
        item.kind == ir.ITEM_KIND_END_LOOP {
            if stackLen > 0 {
                _kind := listLib.popBack(mut frameKinds);
                _mode := listLib.popBack(mut frameModes);
                _taken := listLib.popBack(mut frameTakens);
                _skip := listLib.popBack(mut frameSkips);
                parentSkip := listLib.popBack(mut frameParentSkips);
                stackLen = stackLen - 1;
                if not parentSkip { listLib.pushBack(mut out, item); }
            } else {
                listLib.pushBack(mut out, item);
            }
        } else {
            if not currentlySkipping { listLib.pushBack(mut out, item); }
        }
    }
    out
};

/** Unwraps synthetic scopes introduced by constant-branch simplification when they contain no direct local declarations, in O(n) time. */
unwrapSyntheticScopes := fn(items: Items): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total == 0 { return items; }
    openIdxs: mut List<Int> = [];
    isSynths: mut List<Bool> = [];
    hasDecls: mut List<Bool> = [];
    var stackLen := 0;
    var dropSet := emptyTokenBuckets();
    var hasDrop := false;
    var hasAnySynth := false;
    var idx := 0;
    loop idx < total {
        item := items[idx];
        if item.kind == ir.ITEM_KIND_SCOPE {
            isSynth := item.name == "synthetic";
            if isSynth { hasAnySynth = true; }
            listLib.pushBack(mut openIdxs, idx);
            listLib.pushBack(mut isSynths, isSynth);
            listLib.pushBack(mut hasDecls, false);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ or
        item.kind == ir.ITEM_KIND_FUNCTION_START {
            listLib.pushBack(mut openIdxs, idx);
            listLib.pushBack(mut isSynths, false);
            listLib.pushBack(mut hasDecls, false);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE {
            if stackLen > 0 {
                openIdx := listLib.popBack(mut openIdxs);
                isSynth := listLib.popBack(mut isSynths);
                hasDecl := listLib.popBack(mut hasDecls);
                stackLen = stackLen - 1;
                if isSynth and not hasDecl {
                    dropSet = tokenBucketAdd(dropSet, integer.intText(openIdx));
                    dropSet = tokenBucketAdd(dropSet, integer.intText(idx));
                    hasDrop = true;
                }
            }
        } else if item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP or
        item.kind == ir.ITEM_KIND_FUNCTION_END {
            if stackLen > 0 {
                _openIdx := listLib.popBack(mut openIdxs);
                _isSynth := listLib.popBack(mut isSynths);
                _hasDecl := listLib.popBack(mut hasDecls);
                stackLen = stackLen - 1;
            }
        } else if stackLen > 0 and isSynths[stackLen - 1] and not hasDecls[stackLen - 1] and
        (isTopDeclKind(item.kind) or item.kind == ir.ITEM_KIND_PURE_GLOBAL) {
            _oldDecl := listLib.popBack(mut hasDecls);
            listLib.pushBack(mut hasDecls, true);
        }
        idx = idx + 1;
    }
    if not hasAnySynth or not hasDrop { return items; }
    out: mut Items = [];
    var k := 0;
    loop k < total {
        if not tokenBucketHas(dropSet, integer.intText(k)) {
            listLib.pushBack(mut out, items[k]);
        }
        k = k + 1;
    }
    out
};

/** True when `kind` is a mutable scalar `var` declaration eligible for straight-line dead-store and constant propagation. */
isVarScalarKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_VAR_INT or kind == ir.ITEM_KIND_VAR_STRING or kind == ir.ITEM_KIND_VAR_BOOL or kind == ir.ITEM_KIND_VAR_FLOAT
};

/** True when `kind` is a scalar reassignment eligible for straight-line dead-store and constant propagation. */
isAssignScalarKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_ASSIGN_INT or kind == ir.ITEM_KIND_ASSIGN_STRING or kind == ir.ITEM_KIND_ASSIGN_BOOL or kind == ir.ITEM_KIND_ASSIGN_FLOAT
};

/** True when `code` is an atomic TS scalar literal (`true`, `false`, `"..."`, `[0-9]+n`, or `(-[0-9]+n)`). */
isSimpleTsScalarLiteral := fn(code: String): Bool {
    if code == "true" or code == "false" { return true; }
    size := textLib.length(code);
    if size < 2 { return false; }
    first := textLib.at(code, 0);
    if first == "\"" {
        if textLib.at(code, size - 1) =!= "\"" { return false; }
        var i := 1;
        loop i < size - 1 {
            ch := textLib.at(code, i);
            if ch == "\\" {
                i = i + 2;
                if i > size - 1 { return false; }
                continue;
            }
            if ch == "\"" { return false; }
            i = i + 1;
        }
        return true;
    }
    if textLib.at(code, size - 1) == "n" {
        var i := 0;
        loop i < size - 1 {
            if not textLib.isDigit(textLib.at(code, i)) { return false; }
            i = i + 1;
        }
        return size >= 2;
    }
    if size >= 5 and textLib.startsWithAt(code, 0, "(-") and textLib.at(code, size - 2) == "n" and textLib.at(code, size - 1) == ")" {
        var i := 2;
        loop i < size - 2 {
            if not textLib.isDigit(textLib.at(code, i)) { return false; }
            i = i + 1;
        }
        return true;
    }
    false
};

/** Replaces one element at `index` in a bounded small list of Strings. */
setSmallTextAt := fn(values: List<String>, index: Int, value: String): List<String> {
    out: mut List<String> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut out, if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Replaces one element at `index` in a bounded small list of Ints. */
setSmallIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> {
    out: mut List<Int> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut out, if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Replaces one element at `index` in a bounded small list of Bools. */
setSmallBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> {
    out: mut List<Bool> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut out, if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Finds `name` in bounded `activeNames` (size <= 64), or returns -1. */
findActiveVarSlot := fn(activeNames: List<String>, activeCount: Int, name: String): Int {
    var i := 0;
    loop i < activeCount {
        if activeNames[i] == name { return i; }
        i = i + 1;
    }
    -1
};

/** Substitutes active literal `var` identifiers in `code` (outside strings, property accesses, and arrow functions) in O(|code|) time, returning a pipe-bag of any remaining active slot indices read. */
rewriteAndMarkActiveReads := fn(code: String, activeSet: TokenBuckets, activeNames: List<String>, activeConstCodes: List<String>, activeRead: List<Bool>, activeCount: Int, allowSub: Bool): (code: String, readPipe: String, changed: Bool) {
    if activeCount == 0 or code == "" {
        return (code = code, readPipe = "", changed = false);
    }
    size := textLib.length(code);
    canSub := allowSub and textLib.indexOfText(code, "=>", 0) < 0 and
    textLib.indexOfText(code, "===", 0) < 0 and textLib.indexOfText(code, "!==", 0) < 0;
    parts: mut List<String> = [];
    var segStart := 0;
    var changed := false;
    var readPipe := "";
    var pos := 0;
    loop pos < size {
        ch := textLib.at(code, pos);
        if ch == "\"" {
            pos = pos + 1;
            loop pos < size {
                sCh := textLib.at(code, pos);
                if sCh == "\\" {
                    pos = pos + 2;
                    continue;
                }
                pos = pos + 1;
                if sCh == "\"" { break; }
            }
            continue;
        }
        if textLib.isNameStart(ch) {
            var end := pos + 1;
            loop end < size and (textLib.isNameContinue(textLib.at(code, end)) or textLib.at(code, end) == "$") {
                end = end + 1;
            }
            isProp := pos > 0 and textLib.at(code, pos - 1) == ".";
            if not isProp {
                tok := textLib.slice(code, pos, end);
                if tokenBucketHas(activeSet, tok) {
                    slot := findActiveVarSlot(activeNames, activeCount, tok);
                    if slot >= 0 {
                        constVal := activeConstCodes[slot];
                        if canSub and constVal =!= "" {
                            if pos > segStart {
                                listLib.pushBack(mut parts, textLib.slice(code, segStart, pos));
                            }
                            listLib.pushBack(mut parts, constVal);
                            segStart = end;
                            changed = true;
                        } else if not activeRead[slot] {
                            slotTag := "|" + integer.intText(slot) + "|";
                            if textLib.indexOfText(readPipe, slotTag, 0) < 0 {
                                readPipe = if readPipe == "" { slotTag } else { readPipe + integer.intText(slot) + "|" };
                            }
                        }
                    }
                }
            }
            pos = end;
            continue;
        }
        pos = pos + 1;
    }
    if not changed {
        return (code = code, readPipe = readPipe, changed = false);
    }
    if segStart < size {
        listLib.pushBack(mut parts, textLib.slice(code, segStart, size));
    }
    (code = textLib.joinTexts(parts, ""), readPipe = readPipe, changed = true)
};

/** True when `code` mentions identifier `targetName` outside string literals and property accesses, in O(|code|) time. */
codeMentionsIdent := fn(code: String, targetName: String): Bool {
    if code == "" or textLib.indexOfText(code, targetName, 0) < 0 { return false; }
    size := textLib.length(code);
    var pos := 0;
    loop pos < size {
        ch := textLib.at(code, pos);
        if ch == "\"" {
            pos = pos + 1;
            loop pos < size {
                sCh := textLib.at(code, pos);
                if sCh == "\\" {
                    pos = pos + 2;
                    continue;
                }
                pos = pos + 1;
                if sCh == "\"" { break; }
            }
            continue;
        }
        if textLib.isNameStart(ch) {
            var end := pos + 1;
            loop end < size and (textLib.isNameContinue(textLib.at(code, end)) or textLib.at(code, end) == "$") {
                end = end + 1;
            }
            if not (pos > 0 and textLib.at(code, pos - 1) == ".") and textLib.slice(code, pos, end) == targetName {
                return true;
            }
            pos = end;
            continue;
        }
        pos = pos + 1;
    }
    false
};

/** Performs straight-line basic-block dead-store elimination and scalar literal propagation on `var` bindings in O(n + B) time. */
pub optimizeStraightLineVars := fn(items: Items, target: String): Items {
    if target =!= ir.TARGET_TS { return items; }
    var total := 0;
    var hasVarOrAssign := false;
    loop items as scanItem {
        total = total + 1;
        if isVarScalarKind(scanItem.kind) or isAssignScalarKind(scanItem.kind) {
            hasVarOrAssign = true;
        }
    }
    if total == 0 or not hasVarOrAssign { return items; }

    var activeSet := emptyTokenBuckets();
    var activeNames: List<String> = [];
    var activeDeclIdxs: List<Int> = [];
    var activeDeclMerged: List<Bool> = [];
    var activeDeclCodes: List<String> = [];
    var activeWriteIdxs: List<Int> = [];
    var activeWriteIsDecl: List<Bool> = [];
    var activeWritePure: List<Bool> = [];
    var activeRead: List<Bool> = [];
    var activeConstCodes: List<String> = [];
    var activeCount := 0;

    var dropSet := emptyTokenBuckets();
    var hasDrops := false;
    overrideIdxs: mut List<Int> = [];
    overrideCodes: mut List<String> = [];
    var overrideCount := 0;
    var anyRewrite := false;
    outItems: mut Items = [];

    var idx := 0;
    loop idx < total {
        item := items[idx];
        kind := item.kind;
        isBarrier := kind == ir.ITEM_KIND_IF or kind == ir.ITEM_KIND_ELSE_IF or kind == ir.ITEM_KIND_ELSE or kind == ir.ITEM_KIND_END_IF or
        kind == ir.ITEM_KIND_LOOP or kind == ir.ITEM_KIND_LOOP_SEQ or kind == ir.ITEM_KIND_END_LOOP or
        kind == ir.ITEM_KIND_SCOPE or kind == ir.ITEM_KIND_END_SCOPE or
        kind == ir.ITEM_KIND_FUNCTION_START or kind == ir.ITEM_KIND_FUNCTION_END or
        kind == ir.ITEM_KIND_RETURN or kind == ir.ITEM_KIND_BREAK or kind == ir.ITEM_KIND_CONTINUE or
        kind == ir.ITEM_KIND_UNREACHABLE or kind == ir.ITEM_KIND_MAIN_STOP or
        kind == ir.ITEM_KIND_CALL or kind == ir.ITEM_KIND_END_OUTPUT;

        isPreFlushBarrier := kind == ir.ITEM_KIND_ELSE_IF or kind == ir.ITEM_KIND_ELSE or kind == ir.ITEM_KIND_END_IF or
        kind == ir.ITEM_KIND_LOOP or kind == ir.ITEM_KIND_END_LOOP or
        kind == ir.ITEM_KIND_SCOPE or kind == ir.ITEM_KIND_END_SCOPE or
        kind == ir.ITEM_KIND_FUNCTION_START or kind == ir.ITEM_KIND_FUNCTION_END;
        rewritten := if isPreFlushBarrier {
            (code = item.code, readPipe = "", changed = false)
        } else {
            rewriteAndMarkActiveReads(item.code, activeSet, activeNames, activeConstCodes, activeRead, activeCount, true)
        };
        newCode := rewritten.code;
        if rewritten.readPipe =!= "" {
            nextReadFlags: mut List<Bool> = [];
            var rIdx := 0;
            loop rIdx < activeCount {
                tag := "|" + integer.intText(rIdx) + "|";
                listLib.pushBack(mut nextReadFlags, activeRead[rIdx] or textLib.indexOfText(rewritten.readPipe, tag, 0) >= 0);
                rIdx = rIdx + 1;
            }
            activeRead = nextReadFlags;
        }
        if rewritten.changed { anyRewrite = true; }
        codePure := isSideEffectFreeCode(target, newCode) and textLib.indexOfText(newCode, "=>", 0) < 0;
        updatedItem := if rewritten.changed {
            (kind = item.kind, name = item.name, runtime = item.runtime, code = newCode, intValue = item.intValue, textValue = item.textValue)
        } else {
            item
        };
        listLib.pushBack(mut outItems, updatedItem);

        if isBarrier or not codePure {
            var s := 0;
            loop s < activeCount {
                if activeDeclMerged[s] {
                    listLib.pushBack(mut overrideIdxs, activeDeclIdxs[s]);
                    listLib.pushBack(mut overrideCodes, activeDeclCodes[s]);
                    overrideCount = overrideCount + 1;
                }
                s = s + 1;
            }
            activeSet = emptyTokenBuckets();
            activeNames = [];
            activeDeclIdxs = [];
            activeDeclMerged = [];
            activeDeclCodes = [];
            activeWriteIdxs = [];
            activeWriteIsDecl = [];
            activeWritePure = [];
            activeRead = [];
            activeConstCodes = [];
            activeCount = 0;
        } else if isVarScalarKind(kind) and item.runtime =!= "" {
            litCode := if isSimpleTsScalarLiteral(newCode) { newCode } else { "" };
            if activeCount < 64 {
                activeSet = tokenBucketAdd(activeSet, item.runtime);
                nextNames: mut List<String> = [];
                nextDeclIdxs: mut List<Int> = [];
                nextDeclMerged: mut List<Bool> = [];
                nextDeclCodes: mut List<String> = [];
                nextWriteIdxs: mut List<Int> = [];
                nextWriteIsDecl: mut List<Bool> = [];
                nextWritePure: mut List<Bool> = [];
                nextRead: mut List<Bool> = [];
                nextConstCodes: mut List<String> = [];
                var copyI := 0;
                loop copyI < activeCount {
                    listLib.pushBack(mut nextNames, activeNames[copyI]);
                    listLib.pushBack(mut nextDeclIdxs, activeDeclIdxs[copyI]);
                    listLib.pushBack(mut nextDeclMerged, activeDeclMerged[copyI]);
                    listLib.pushBack(mut nextDeclCodes, activeDeclCodes[copyI]);
                    listLib.pushBack(mut nextWriteIdxs, activeWriteIdxs[copyI]);
                    listLib.pushBack(mut nextWriteIsDecl, activeWriteIsDecl[copyI]);
                    listLib.pushBack(mut nextWritePure, activeWritePure[copyI]);
                    listLib.pushBack(mut nextRead, activeRead[copyI]);
                    listLib.pushBack(mut nextConstCodes, activeConstCodes[copyI]);
                    copyI = copyI + 1;
                }
                listLib.pushBack(mut nextNames, item.runtime);
                listLib.pushBack(mut nextDeclIdxs, idx);
                listLib.pushBack(mut nextDeclMerged, false);
                listLib.pushBack(mut nextDeclCodes, "");
                listLib.pushBack(mut nextWriteIdxs, idx);
                listLib.pushBack(mut nextWriteIsDecl, true);
                listLib.pushBack(mut nextWritePure, codePure);
                listLib.pushBack(mut nextRead, false);
                listLib.pushBack(mut nextConstCodes, litCode);
                activeNames = nextNames;
                activeDeclIdxs = nextDeclIdxs;
                activeDeclMerged = nextDeclMerged;
                activeDeclCodes = nextDeclCodes;
                activeWriteIdxs = nextWriteIdxs;
                activeWriteIsDecl = nextWriteIsDecl;
                activeWritePure = nextWritePure;
                activeRead = nextRead;
                activeConstCodes = nextConstCodes;
                activeCount = activeCount + 1;
            }
        } else if isAssignScalarKind(kind) and item.runtime =!= "" {
            litCode := if isSimpleTsScalarLiteral(newCode) { newCode } else { "" };
            slot := if tokenBucketHas(activeSet, item.runtime) { findActiveVarSlot(activeNames, activeCount, item.runtime) } else { -1 };
            if slot >= 0 {
                canDropPrev := not activeRead[slot] and activeWritePure[slot] and not codeMentionsIdent(newCode, item.runtime);
                if canDropPrev and activeWriteIsDecl[slot] and (idx == activeWriteIdxs[slot] + 1 or litCode =!= "") {
                    activeDeclMerged = setSmallBoolAt(activeDeclMerged, slot, true);
                    activeDeclCodes = setSmallTextAt(activeDeclCodes, slot, newCode);
                    activeWritePure = setSmallBoolAt(activeWritePure, slot, codePure);
                    activeRead = setSmallBoolAt(activeRead, slot, false);
                    activeConstCodes = setSmallTextAt(activeConstCodes, slot, litCode);
                    dropSet = tokenBucketAdd(dropSet, integer.intText(idx));
                    hasDrops = true;
                } else {
                    if canDropPrev and not activeWriteIsDecl[slot] {
                        dropSet = tokenBucketAdd(dropSet, integer.intText(activeWriteIdxs[slot]));
                        hasDrops = true;
                    }
                    activeWriteIdxs = setSmallIntAt(activeWriteIdxs, slot, idx);
                    activeWriteIsDecl = setSmallBoolAt(activeWriteIsDecl, slot, false);
                    activeWritePure = setSmallBoolAt(activeWritePure, slot, codePure);
                    activeRead = setSmallBoolAt(activeRead, slot, false);
                    activeConstCodes = setSmallTextAt(activeConstCodes, slot, litCode);
                }
            } else if activeCount < 64 {
                activeSet = tokenBucketAdd(activeSet, item.runtime);
                nextNames: mut List<String> = [];
                nextDeclIdxs: mut List<Int> = [];
                nextDeclMerged: mut List<Bool> = [];
                nextDeclCodes: mut List<String> = [];
                nextWriteIdxs: mut List<Int> = [];
                nextWriteIsDecl: mut List<Bool> = [];
                nextWritePure: mut List<Bool> = [];
                nextRead: mut List<Bool> = [];
                nextConstCodes: mut List<String> = [];
                var copyI := 0;
                loop copyI < activeCount {
                    listLib.pushBack(mut nextNames, activeNames[copyI]);
                    listLib.pushBack(mut nextDeclIdxs, activeDeclIdxs[copyI]);
                    listLib.pushBack(mut nextDeclMerged, activeDeclMerged[copyI]);
                    listLib.pushBack(mut nextDeclCodes, activeDeclCodes[copyI]);
                    listLib.pushBack(mut nextWriteIdxs, activeWriteIdxs[copyI]);
                    listLib.pushBack(mut nextWriteIsDecl, activeWriteIsDecl[copyI]);
                    listLib.pushBack(mut nextWritePure, activeWritePure[copyI]);
                    listLib.pushBack(mut nextRead, activeRead[copyI]);
                    listLib.pushBack(mut nextConstCodes, activeConstCodes[copyI]);
                    copyI = copyI + 1;
                }
                listLib.pushBack(mut nextNames, item.runtime);
                listLib.pushBack(mut nextDeclIdxs, -1);
                listLib.pushBack(mut nextDeclMerged, false);
                listLib.pushBack(mut nextDeclCodes, "");
                listLib.pushBack(mut nextWriteIdxs, idx);
                listLib.pushBack(mut nextWriteIsDecl, false);
                listLib.pushBack(mut nextWritePure, codePure);
                listLib.pushBack(mut nextRead, false);
                listLib.pushBack(mut nextConstCodes, litCode);
                activeNames = nextNames;
                activeDeclIdxs = nextDeclIdxs;
                activeDeclMerged = nextDeclMerged;
                activeDeclCodes = nextDeclCodes;
                activeWriteIdxs = nextWriteIdxs;
                activeWriteIsDecl = nextWriteIsDecl;
                activeWritePure = nextWritePure;
                activeRead = nextRead;
                activeConstCodes = nextConstCodes;
                activeCount = activeCount + 1;
            }
        }
        idx = idx + 1;
    }

    var sEnd := 0;
    loop sEnd < activeCount {
        if activeDeclMerged[sEnd] {
            listLib.pushBack(mut overrideIdxs, activeDeclIdxs[sEnd]);
            listLib.pushBack(mut overrideCodes, activeDeclCodes[sEnd]);
            overrideCount = overrideCount + 1;
        }
        sEnd = sEnd + 1;
    }

    if not anyRewrite and not hasDrops and overrideCount == 0 {
        return items;
    }

    finalItems: mut Items = [];
    var ovPos := 0;
    var k := 0;
    loop k < total {
        if hasDrops and tokenBucketHas(dropSet, integer.intText(k)) {
            k = k + 1;
            continue;
        }
        cur := outItems[k];
        if ovPos < overrideCount and overrideIdxs[ovPos] == k {
            listLib.pushBack(mut finalItems, (kind = cur.kind, name = cur.name, runtime = cur.runtime,
            code = overrideCodes[ovPos], intValue = cur.intValue, textValue = cur.textValue));
            ovPos = ovPos + 1;
        } else {
            listLib.pushBack(mut finalItems, cur);
        }
        k = k + 1;
    }
    finalItems
};

/** Removes unreachable top-level function bodies and side-effect-free code across root and inner blocks for `target`. */
pub filterReachableItemsForTarget := fn(items: Items, target: String): Items {
    simplified := unwrapSyntheticScopes(simplifyConstantBranches(items, target));
    varOpt := optimizeStraightLineVars(simplified, target);
    pruned := unwrapSyntheticScopes(pruneBlockScopedItems(varOpt, target));
    var hasPrunable := false;
    var seedTokens := emptyTokenBuckets();
    var fnDepth := 0;
    var blockDepth := 0;
    var nextIsPure := false;
    pureDecls: mut List<String> = [];
    loop pruned as item {
        if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
            nextIsPure = true;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_START {
            hasPrunable = true;
            fnDepth = fnDepth + 1;
            nextIsPure = false;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
            nextIsPure = false;
            continue;
        }
        if fnDepth > 0 {
            nextIsPure = false;
            continue;
        }
        isTopDecl := blockDepth == 0 and isTopDeclKind(item.kind);
        isPureDecl := isTopDecl and (nextIsPure or ((target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code)));
        nextIsPure = false;
        if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            blockDepth = blockDepth + 1;
            seedTokens = codeReachableTokensSet(item.code, seedTokens);
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if isPureDecl {
            hasPrunable = true;
            listLib.pushBack(mut pureDecls, item.runtime);
        } else if item.kind =!= ir.ITEM_KIND_IMPORT and item.kind =!= ir.ITEM_KIND_PUBLIC_FUNCTION and item.kind =!= ir.ITEM_KIND_PUBLIC_VALUE and
        item.kind =!= ir.ITEM_KIND_PUBLIC_TYPE and item.kind =!= ir.ITEM_KIND_NOOP {
            seedTokens = codeReachableTokensSet(item.code, seedTokens);
            if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                seedTokens = tokenBucketAdd(seedTokens, item.runtime);
            }
        }
    }
    if not hasPrunable { return pruned; }

    var reachable := seedTokens;
    var scanned := emptyTokenBuckets();
    loop true {
        beforeCount := reachable.count;
        var scanFnDepth := 0;
        var scanBlockDepth := 0;
        var scanBody := false;
        loop pruned as item {
            if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
                continue;
            } else if item.kind == ir.ITEM_KIND_FUNCTION_START {
                if scanFnDepth == 0 {
                    token := item.runtime + "(";
                    scanBody = tokenBucketHas(reachable, token) and not tokenBucketHas(scanned, token);
                    if scanBody { scanned = tokenBucketAdd(scanned, token); }
                }
                scanFnDepth = scanFnDepth + 1;
            } else if item.kind == ir.ITEM_KIND_FUNCTION_END {
                if scanFnDepth > 0 { scanFnDepth = scanFnDepth - 1; }
                if scanFnDepth == 0 { scanBody = false; }
            } else if scanFnDepth > 0 {
                if scanBody {
                    reachable = codeReachableTokensSet(item.code, reachable);
                    if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                        reachable = tokenBucketAdd(reachable, item.runtime);
                    }
                }
            } else {
                if scanBlockDepth == 0 and isTopDeclKind(item.kind) {
                    if listLib.listContainsText(pureDecls, item.runtime) and tokenBucketHas(reachable, item.runtime) and
                    not tokenBucketHas(scanned, item.runtime) {
                        scanned = tokenBucketAdd(scanned, item.runtime);
                        reachable = codeReachableTokensSet(item.code, reachable);
                    }
                }
                if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
                    scanBlockDepth = scanBlockDepth + 1;
                } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
                    if scanBlockDepth > 0 { scanBlockDepth = scanBlockDepth - 1; }
                }
            }
        }
        if reachable.count == beforeCount { break; }
    }

    filtered: mut Items = [];
    var keepFnDepth := 0;
    var keepBlockDepth := 0;
    var keepFn := false;
    var nextDeclPure := false;
    loop pruned as item {
        if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
            nextDeclPure = true;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_START {
            nextDeclPure = false;
            if keepFnDepth == 0 { keepFn = tokenBucketHas(reachable, item.runtime + "("); }
            keepFnDepth = keepFnDepth + 1;
            if keepFn { listLib.pushBack(mut filtered, item); }
        } else if item.kind == ir.ITEM_KIND_FUNCTION_END {
            nextDeclPure = false;
            wasKeeping := keepFn;
            if keepFnDepth > 0 { keepFnDepth = keepFnDepth - 1; }
            if keepFnDepth == 0 { keepFn = false; }
            if wasKeeping { listLib.pushBack(mut filtered, item); }
        } else if keepFnDepth > 0 {
            nextDeclPure = false;
            if keepFn { listLib.pushBack(mut filtered, item); }
        } else {
            dropDecl := keepBlockDepth == 0 and isTopDeclKind(item.kind) and
            (nextDeclPure or ((target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code))) and
            not tokenBucketHas(reachable, item.runtime);
            nextDeclPure = false;
            if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
                keepBlockDepth = keepBlockDepth + 1;
            } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
                if keepBlockDepth > 0 { keepBlockDepth = keepBlockDepth - 1; }
            }
            if not dropDecl { listLib.pushBack(mut filtered, item); }
        }
    }
    filtered
};

/** Removes unreachable top-level function bodies and side-effect-free declarations for TS emission. */
pub filterReachableItems := fn(items: Items): Items {
    filterReachableItemsForTarget(items, ir.TARGET_TS)
};
