        outLine("                if (c < 128 ? ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c === 95) : lite$isXidContinue(c)) pos += 1;");
        outLine("                else break;");
        outLine("            }");
        outLine("        }");
        outLine("        return BigInt(pos);");
        outLine("    }");
        outLine("    const points = lite$textPoints(source);");
        outLine("    const len = points.length;");
        outLine("    if (pos >= len) return start;");
        outLine("    while (pos < len) {");
        outLine("        const p = points[pos]!;");
        outLine("        const c = p.codePointAt(0);");
        outLine("        if (c === undefined) break;");
        outLine("        if (spaces ? (c === 32 || c === 9 || c === 13 || c === 10) : lite$isXidContinue(c)) pos += 1;");
        outLine("        else break;");
        outLine("    }");
        outLine("    return BigInt(pos);");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "textStartsWithAt") or usesBuiltin(calls, "textWordAt") {
        outLine("function lite$textStartsWithAt(source: string, position: bigint, text: string): boolean {");
        outLine("    const pos = Number(position);");
        outLine("    if (pos < 0 || pos > source.length) return false;");
        outLine("    if (pos === 0) return source.startsWith(text);");
        outLine("    if (lite$isBmp(source)) return source.startsWith(text, pos);");
        outLine("    const points = lite$textPoints(source);");
        outLine("    if (pos > points.length) return false;");
        outLine("    if (text.length === 0) return true;");
        outLine("    if (lite$isBmp(text)) {");
        outLine("        if (pos + text.length > points.length) return false;");
        outLine("        for (let i = 0; i < text.length; i += 1) {");
        outLine("            if (points[pos + i] !== text[i]) return false;");
        outLine("        }");
        outLine("        return true;");
        outLine("    }");
        outLine("    const tPoints = lite$textPoints(text);");
        outLine("    if (pos + tPoints.length > points.length) return false;");
        outLine("    for (let i = 0; i < tPoints.length; i += 1) {");
        outLine("        const tp = tPoints[i];");
        outLine("        if (tp === undefined || points[pos + i] !== tp) return false;");
        outLine("    }");
        outLine("    return true;");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "textWordAt") {
        outLine("function lite$textWordAt(source: string, position: bigint, word: string): boolean {");
        outLine("    const pos = Number(position);");
        outLine("    if (pos < 0) return false;");
        outLine("    if (lite$isBmp(source)) {");
        outLine("        if (pos > source.length) return false;");
        outLine("        if (!source.startsWith(word, pos)) return false;");
        outLine("        const after = pos + word.length;");
        outLine("        if (after >= source.length) return true;");
        outLine("        const cc = source.charCodeAt(after);");
        outLine("        return !(cc < 128 ? ((cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || (cc >= 48 && cc <= 57) || cc === 95) : lite$isXidContinue(cc));");
        outLine("    }");
        outLine("    if (!lite$textStartsWithAt(source, position, word)) return false;");
        outLine("    const points = lite$textPoints(source);");
        outLine("    const wLen = lite$isBmp(word) ? word.length : lite$textPoints(word).length;");
        outLine("    const after = pos + wLen;");
        outLine("    if (after >= points.length) return true;");
        outLine("    const next = points[after];");
        outLine("    if (next === undefined) return true;");
        outLine("    const cc = next.codePointAt(0);");
        outLine("    return cc === undefined || !lite$isXidContinue(cc);");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "textToInt") {
        outLine("function lite$textToInt(text: string): { value: bigint; ok: boolean } {");
        outLine("    if (!/^[+-]?[0-9]+$/.test(text)) return { value: 0n, ok: false };");
        outLine("    const value = BigInt(text);");
        outLine("    if (value < -9223372036854775808n || value > 9223372036854775807n) return { value: 0n, ok: false };");
        outLine("    return { value, ok: true };");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "textTrim") {
        outLine("function lite$textTrim(source: string, trimLeft: boolean, trimRight: boolean): string {");
        outLine("    let start = 0;");
        outLine("    let end = source.length;");
        outLine("    if (trimLeft) {");
        outLine("        while (start < end) {");
        outLine("            const c = source.charCodeAt(start);");
        outLine("            if (c !== 32 && c !== 9 && c !== 13 && c !== 10) break;");
        outLine("            start += 1;");
        outLine("        }");
        outLine("    }");
        outLine("    if (trimRight) {");
        outLine("        while (end > start) {");
        outLine("            const c = source.charCodeAt(end - 1);");
        outLine("            if (c !== 32 && c !== 9 && c !== 13 && c !== 10) break;");
        outLine("            end -= 1;");
        outLine("        }");
        outLine("    }");
        outLine("    return start === 0 && end === source.length ? source : source.slice(start, end);");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "textToLowerAscii") {
        outLine("function lite$textToLowerAscii(source: string): string {");
        outLine("    for (let i = 0; i < source.length; i += 1) {");
        outLine("        const c = source.charCodeAt(i);");
        outLine("        if (c >= 65 && c <= 90) return source.replace(/[A-Z]+/g, m => m.toLowerCase());");
        outLine("    }");
        outLine("    return source;");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "throwTransfer") {
        outLine("const lite$transferToken = {};");
        outLine("let lite$transferVal: any = undefined;");
        outLine("function lite$throwTransfer(id: number, value: unknown): never {");
        outLine("    throw { token: lite$transferToken, id, value };");
        outLine("}");
        outLine("function lite$hasTransfer(err: unknown, id: number): boolean {");
        outLine("    if (typeof err === \"object\" && err !== null && \"token\" in err && err.token === lite$transferToken && \"id\" in err && err.id === id && \"value\" in err) {");
        outLine("        lite$transferVal = err.value;");
        outLine("        return true;");
        outLine("    }");
        outLine("    return false;");
        outLine("}");
        outLine("");
    }
    return;
}

/** Emits the checked map-index helper used by generated programs that read map entries via `m[k]`. */
emitMapIndexHelper := fn(): Unit {
    outLine("function lite$mapAt<K, V>(entries: ReadonlyMap<K, V>, key: K, at: number): V {");
    outLine("    const value = entries.get(key);");
    outLine("    if (value === undefined) {");
    outLine("        lite$fault(\"KeyPanic\", at, \"missing map key\");");
    outLine("    }");
    outLine("    return value;");
    outLine("}");
    outLine("");
}

/** Emits the single-lookup `core/map` `get` helper. */
emitMapGetHelper := fn(): Unit {
    outLine("function lite$mapGet<K, V>(entries: ReadonlyMap<K, V>, key: K, zero: V): { found: boolean; value: V } {");
    outLine("    const value = entries.get(key);");
    outLine("    return value !== undefined ? { found: true, value } : { found: false, value: zero };");
    outLine("}");
    outLine("");
}

/** Emits the single-lookup `core/map` `getOr` helper. */
emitMapGetOrHelper := fn(): Unit {
    outLine("function lite$mapGetOr<K, V>(entries: ReadonlyMap<K, V>, key: K, fallback: V): V {");
    outLine("    const value = entries.get(key);");
    outLine("    return value !== undefined ? value : fallback;");
    outLine("}");
    outLine("");
}

/** Emits the checked list-write helper used by generated programs that mutate list/array elements by index. */
emitListSetHelper := fn(): Unit {
    outLine("function lite$listSet<T>(items: T[], index: bigint, value: T, at: number): void {");
    outLine("    if (index < 0n || index >= BigInt(items.length)) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    outLine("    }");
    outLine("    items[Number(index)] = value;");
    outLine("}");
    outLine("");
}

/** Emits the checked list-slice helper used by `core/list.slice`. */
emitListSliceHelper := fn(): Unit {
    outLine("function lite$listSlice<T>(items: readonly T[], start: bigint, end: bigint, at: number): T[] {");
    outLine("    const len = BigInt(items.length);");
    outLine("    if (start < 0n || end < start || end > len) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"list slice bounds outside its extent\");");
    outLine("    }");
    outLine("    return items.slice(Number(start), Number(end));");
    outLine("}");
    outLine("");
}

/** Emits the checked list-index helper used by generated programs that read list elements. */
emitListIndexHelper := fn(): Unit {
    outLine("function lite$listAt<T>(items: readonly T[], index: bigint, at: number): T {");
    outLine("    if (index < 0n || index >= BigInt(items.length)) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    outLine("    }");
    outLine("    const value = items[Number(index)];");
    outLine("    if (value === undefined) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"list index outside its extent\");");
    outLine("    }");
    outLine("    return value;");
    outLine("}");
    outLine("");
}

/** Emits the checked list-pop-back helper used by generated programs that pop the back of a list. */
emitListPopHelper := fn(): Unit {
    outLine("function lite$listPopBack<T>(items: T[], at: number): T {");
    outLine("    if (items.length === 0) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"pop_back on an empty list\");");
    outLine("    }");
    outLine("    return items.pop() as T;");
    outLine("}");
    outLine("");
}

/** Emits the checked list-pop-front helper used by generated programs that pop the front of a list. */
emitListPopFrontHelper := fn(): Unit {
    outLine("function lite$listPopFront<T>(items: T[], at: number): T {");
    outLine("    if (items.length === 0) {");
    outLine("        lite$fault(\"BoundPanic\", at, \"pop_front on an empty list\");");
    outLine("    }");
    outLine("    return items.shift() as T;");
    outLine("}");
    outLine("");
}

/** Emits positioned truncating division with checked Int64 results. */
emitIntDivideHelper := fn(): Unit {
    outLine("function lite$divideInt(left: bigint, right: bigint, at: number): bigint {");
    outLine("    if (right === 0n) lite$intFault(at, \"division by zero\");");
    outLine("    return lite$checkedInt(left / right, at);");
    outLine("}");
    outLine("");
}

/** Emits positioned remainder; MIN%-1 is representable zero. */
emitIntRemainderHelper := fn(): Unit {
    outLine("function lite$remainderInt(left: bigint, right: bigint, at: number): bigint {");
    outLine("    if (right === 0n) lite$intFault(at, \"remainder by zero\");");
    outLine("    return left % right;");
    outLine("}");
    outLine("");
}

/** Emits positioned floor division without repeating operands. */
emitIntFloorDivideHelper := fn(): Unit {
    outLine("function lite$floorDivideInt(left: bigint, right: bigint, at: number): bigint {");
    outLine("    const quotient = lite$divideInt(left, right, at);");
    outLine("    const remainder = left % right;");
    outLine("    return remainder !== 0n && (left < 0n) !== (right < 0n) ? quotient - 1n : quotient;");
    outLine("}");
    outLine("");
}

/** Emits positioned floor modulo, including signed-minimum divisors. */
emitIntFloorModuloHelper := fn(): Unit {
    outLine("function lite$floorModuloInt(left: bigint, right: bigint, at: number): bigint {");
    outLine("    if (right === 0n) lite$intFault(at, \"modulo by zero\");");
    outLine("    const remainder = left % right;");
    outLine("    return remainder !== 0n && (remainder < 0n) !== (right < 0n) ? remainder + right : remainder;");
    outLine("}");
    outLine("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(calls: String): Unit {
    if (usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "floorDivideInt")) { emitIntDivideHelper(); }
    if usesBuiltin(calls, "remainderInt") { emitIntRemainderHelper(); }
    if usesBuiltin(calls, "floorDivideInt") { emitIntFloorDivideHelper(); }
    if usesBuiltin(calls, "floorModuloInt") { emitIntFloorModuloHelper(); }
    return;
}

/** Extracts the runtime identifier of parameter `targetIndex` from encoded `|`-separated `name=kind` entries. */
paramRuntimeAt := fn(encoded: String, targetIndex: Int): String {
    if encoded == "" or targetIndex < 0 { return ""; }
    var index := 0;
    var start := 0;
    loop true {
        separator := encoded.indexOf("|", start);
        var end := encoded.length();
        if separator >= 0 { end = separator; }
        if index == targetIndex {
            entry := encoded.slice(start, end);
            eq := entry.indexOf("=", 0);
            if eq <= 0 { return ""; }
            return "lite_" + entry.slice(0, eq);
        }
        if separator < 0 { return ""; }
        index += 1;
        start = separator + 1;
    }
    ""
}

/** Returns the soft-builtin return expression for an overridable module function or type-attached operation, or `""` when none exists. */
softBuiltinExpr := fn(moduleName: String, rawFnName: String, params: String): String {
    fnName := if rawFnName == "Int.toText" { "intText" }
    else if rawFnName == "String.toInt" { "textToInt" }
    else if rawFnName == "String.repeat" { "repeatText" }
    else if rawFnName == "String.contains" { "containsText" }
    else if rawFnName.startsWithAt(0, "String.") { rawFnName.slice(7, rawFnName.length()) }
    else { rawFnName };
    arg0 := paramRuntimeAt(params, 0);
    if moduleName == "lib/core/crypto" {
        if fnName == "sha256Bytes" { return "lite$cryptoDigestBytes(\"sha256\", " + arg0 + ")"; }
        if fnName == "sha256Text" { return "lite$cryptoDigestText(\"sha256\", " + arg0 + ")"; }
        if fnName == "sha256File" { return "lite$cryptoDigestFile(\"sha256\", " + arg0 + ")"; }
        if fnName == "sha512Bytes" { return "lite$cryptoDigestBytes(\"sha512\", " + arg0 + ")"; }
        if fnName == "sha512Text" { return "lite$cryptoDigestText(\"sha512\", " + arg0 + ")"; }
        if fnName == "hmacSha256Bytes" { return "lite$cryptoHmacSha256Bytes(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "isValidBase64" { return "lite$cryptoIsValidBase64(" + arg0 + ")"; }
        if fnName == "isValidHex" { return "lite$cryptoIsValidHex(" + arg0 + ")"; }
        if fnName == "base64Encode" { return "lite$cryptoEncodeBytes(\"base64\", " + arg0 + ")"; }
        if fnName == "hexEncode" { return "lite$cryptoEncodeBytes(\"hex\", " + arg0 + ")"; }
        if fnName == "base64Decode" { return "lite$cryptoDecodeBytes(\"base64\", " + arg0 + ")"; }
        if fnName == "hexDecode" { return "lite$cryptoDecodeBytes(\"hex\", " + arg0 + ")"; }
    } else if moduleName == "lib/core/int" {
        if fnName == "intText" { return "String(" + arg0 + ")"; }
    } else if moduleName == "lib/core/text" {
        if fnName == "skipSpaces" { return "lite$textSkipWhile(" + arg0 + ", " + paramRuntimeAt(params, 1) + ", true)"; }
        if fnName == "skipName" { return "lite$textSkipWhile(" + arg0 + ", " + paramRuntimeAt(params, 1) + ", false)"; }
        if fnName == "indexOf" {
            return "lite$textIndexOf(" + arg0 + ", " + paramRuntimeAt(params, 1) + ", " + paramRuntimeAt(params, 2) + ")";
        }
        if fnName == "startsWithAt" {
            return "lite$textStartsWithAt(" + arg0 + ", " + paramRuntimeAt(params, 1) + ", " + paramRuntimeAt(params, 2) + ")";
        }
        if fnName == "wordAt" {
            return "lite$textWordAt(" + arg0 + ", " + paramRuntimeAt(params, 1) + ", " + paramRuntimeAt(params, 2) + ")";
        }
        if fnName == "joinTexts" { return arg0 + ".join(" + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "textToInt" { return "lite$textToInt(" + arg0 + ")"; }
        if fnName == "trimStart" { return "lite$textTrim(" + arg0 + ", true, false)"; }
        if fnName == "trimEnd" { return "lite$textTrim(" + arg0 + ", false, true)"; }
        if fnName == "trim" { return "lite$textTrim(" + arg0 + ", true, true)"; }
        if fnName == "endsWith" { return arg0 + ".endsWith(" + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "repeatText" {
            arg1 := paramRuntimeAt(params, 1);
            return "(" + arg1 + " <= 0n || " + arg0 + " === \"\" ? \"\" : " + arg0 + ".repeat(Number(" + arg1 + ")))";
        }
        if fnName == "containsText" { return arg0 + ".includes(" + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "toLowerAscii" { return "lite$textToLowerAscii(" + arg0 + ")"; }
        if fnName == "isDigit" { return "(" + arg0 + ".length === 1 && " + arg0 + " >= \"0\" && " + arg0 + " <= \"9\")"; }
        if fnName == "isAsciiLetter" {
            return "(" + arg0 + ".length === 1 && ((" + arg0 + " >= \"a\" && " + arg0 + " <= \"z\") || (" + arg0 + " >= \"A\" && " + arg0 + " <= \"Z\")))";
        }
        if fnName == "isNameStart" { return "lite$isNameStart(" + arg0 + ")"; }
        if fnName == "isNameContinue" { return "lite$isNameContinue(" + arg0 + ")"; }
        if fnName == "isWhitespace" {
            return "(" + arg0 + " === \" \" || " + arg0 + " === \"\\t\" || " + arg0 + " === \"\\r\" || " + arg0 + " === \"\\n\")";
        }
    } else if moduleName == "lib/core/io" {
        if fnName == "textReader" { return "lite$ioTextReader(" + arg0 + ")"; }
        if fnName == "readAll" { return "lite$ioReadAll(" + arg0 + ")"; }
        if fnName == "readAllText" { return "lite$ioReadAllText(" + arg0 + ")"; }
        if fnName == "readLine" { return "lite$ioReadLine(" + arg0 + ")"; }
        if fnName == "writeText" { return "lite$ioWriteText(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "writeLine" { return "lite$ioWriteLine(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
    } else if moduleName == "lib/core/unicode" {
        if fnName == "utf8Encode" { return "lite$unicodeUtf8Encode(" + arg0 + ")"; }
        if fnName == "utf8DecodeStrict" { return "lite$unicodeUtf8DecodeStrict(" + arg0 + ")"; }
        if fnName == "utf8DecodeLossy" { return "lite$unicodeUtf8DecodeLossy(" + arg0 + ")"; }
    } else if moduleName == "lib/core/file" {
        if fnName == "readBytes" { return "lite$fileReadBytes(" + arg0 + ")"; }
        if fnName == "readText" { return "lite$fileReadText(" + arg0 + ")"; }
        if fnName == "writeBytes" { return "lite$fileWriteBytes(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "writeText" { return "lite$fileWriteText(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "appendBytes" { return "lite$fileAppendBytes(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
        if fnName == "appendText" { return "lite$fileAppendText(" + arg0 + ", " + paramRuntimeAt(params, 1) + ")"; }
    }
    ""
}

/** Replaces verified soft-builtin function bodies with host overrides unless switched to `pure` by `--builtin-mode`. */
applySoftBuiltins := fn(rawItems: frontend.Items, prefix: String, builtinSpecs: List<String>): frontend.Items {
    rules := frontend.parseBuiltinModeSpecs(prefix, builtinSpecs);
    out: mut frontend.Items = [];
    var skippingDepth := 0;
    var pendingSoftFn := "";
    var pendingSoftRuntime := "";
    var pendingSoftParams := "";
    loop rawItems as item {
        if skippingDepth > 0 {
            if item.kind == frontend.ITEM_KIND_FUNCTION_START {
                skippingDepth = skippingDepth + 1;
            } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
                skippingDepth = skippingDepth - 1;
                if skippingDepth == 0 {
                    mut out.pushBack(item);
                }
            }
            continue;
        }
        if item.kind == frontend.ITEM_KIND_SOFT_BUILTIN {
            if pendingSoftFn =!= "" and item.name == pendingSoftFn and item.runtime == pendingSoftRuntime and item.textValue == pendingSoftParams {
                overrideCode := softBuiltinExpr(item.code, item.name, item.textValue);
                if overrideCode =!= "" and frontend.resolveBuiltinMode(rules, item.code, item.name) == frontend.BUILTIN_MODE_BUILTIN {
                    mut out.pushBack((kind = frontend.ITEM_KIND_RETURN, name = "", runtime = "", code = overrideCode,
                    intValue = 0, textValue = ""));
                    skippingDepth = 1;
                }
            }
            pendingSoftFn = "";
            pendingSoftRuntime = "";
            pendingSoftParams = "";
            continue;
        }
        pendingSoftFn = "";
        pendingSoftRuntime = "";
        pendingSoftParams = "";
        mut out.pushBack(item);
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            pendingSoftFn = item.name;
            pendingSoftRuntime = item.runtime;
            pendingSoftParams = item.textValue;
        }
    }
    out
}

/** Emits a preserved comment or doc block with per-line `indent`. */
emitTsComment := fn(indent: String, commentText: String): Unit {
    n := commentText.length();
    var start := 0;
    loop start <= n {
        nl := commentText.indexOf("\n", start);
        end := if nl >= 0 { nl } else { n };
        rawLine := commentText.slice(start, end);
        cleanLine := if start == 0 { rawLine } else { rawLine.trimStart() };
        if start == 0 or cleanLine =!= "" {
            outLine(indent + cleanLine);
        } else {
            outLine("");
        }
        if nl < 0 { break; }
        start = nl + 1;
    }
};

/** Derives a collision-free temporary initializer variable name for an immutable TS binding `targetName`. */
tsInitTempName := fn(targetName: String): String {
    base := if targetName.startsWithAt(0, "lite_") {
        targetName.slice(5, targetName.length())
    } else {
        targetName
    };
    "_init_" + base
};

/** Unwraps a binding-position loop/block IIFE into flat statements without an IIFE closure, preserving `const` for immutable bindings. */
tryUnwrapDirectTsLoopBinding := fn(targetName: String, isVar: Bool, explicitType: String, code: String): (ok: Bool, declLine: String, loopLine: String, bindLine: String) {
    trimmed := code.trim();
    if not trimmed.startsWithAt(0, "(() => { ") or not trimmed.endsWith(" })()") {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    inner := trimmed.slice(9, trimmed.length() - 5).trim();
    innerLen := inner.length();
    if innerLen < 12 or inner.at(innerLen - 1) =!= ";" {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    var retStart := innerLen - 1;
    loop retStart > 0 and (inner.at(retStart - 1).isNameContinue() or inner.at(retStart - 1) == "$") {
        retStart = retStart - 1;
    }
    retVar := inner.slice(retStart, innerLen - 1);
    if retVar == "" or retStart < 8 or inner.slice(retStart - 8, retStart) =!= " return " {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    beforeRet := inner.slice(0, retStart - 8).trim();
    if beforeRet == "" or beforeRet.indexOf("return ", 0) >= 0 or beforeRet.indexOf("return;", 0) >= 0 {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    /* Case 1: single-accumulator loop (`let/const retVar: T = init; for/while (...) { ... }`). */
    letPrefix := "let " + retVar + ": ";
    constPrefix := "const " + retVar + ": ";
    isConstDecl := beforeRet.startsWithAt(0, constPrefix);
    isLetDecl := beforeRet.startsWithAt(0, letPrefix);
    if isConstDecl or isLetDecl {
        typeStart := if isConstDecl { constPrefix.length() } else { letPrefix.length() };
        eqPos := beforeRet.indexOf(" = ", typeStart);
        semiPos := if eqPos >= 0 { emitFmt.findTopLevelSemi(beforeRet, eqPos + 3) } else { -1 };
        if eqPos >= 0 and semiPos >= 0 {
            declType := beforeRet.slice(typeStart, eqPos);
            initExpr := beforeRet.slice(eqPos + 3, semiPos);
            rest := beforeRet.slice(semiPos + 1, beforeRet.length()).trim();
            if emitFmt.isSingleScopedLoopStmt(rest) and not emitFmt.codeUsesIdent(initExpr, retVar) {
                ann := if explicitType =!= "" { explicitType } else { declType };
                if isVar {
                    if not emitFmt.codeUsesIdent(initExpr, targetName) and not emitFmt.codeUsesIdent(rest, targetName) {
                        declLine := "let " + targetName + ": " + ann + " = " + initExpr + ";";
                        loopLine := emitFmt.replaceIdentToken(rest, retVar, targetName);
                        return (ok = true, =declLine, =loopLine, bindLine = "");
                    }
                } else if isConstDecl {
                    if not emitFmt.codeUsesIdent(initExpr, targetName) and not emitFmt.codeUsesIdent(rest, targetName) {
                        declLine := "const " + targetName + ": " + ann + " = " + initExpr + ";";
                        loopLine := emitFmt.replaceIdentToken(rest, retVar, targetName);
                        return (ok = true, =declLine, =loopLine, bindLine = "");
                    }
                } else {
                    tmpVar := tsInitTempName(targetName);
                    if not emitFmt.codeUsesIdent(initExpr, tmpVar) and not emitFmt.codeUsesIdent(rest, tmpVar) {
                        declLine := "let " + tmpVar + ": " + ann + " = " + initExpr + ";";
                        loopLine := emitFmt.replaceIdentToken(rest, retVar, tmpVar);
                        bindLine := "const " + targetName + " = " + tmpVar + ";";
                        return (ok = true, =declLine, =loopLine, =bindLine);
                    }
                }
            }
        }
    }
    /* Case 2: general multi-statement/multi-decl block without internal `return` (preserves `const` via scoped `{ ... }` block). */
    if explicitType == "" {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    if isVar {
        if not emitFmt.codeUsesIdent(beforeRet, targetName) {
            return (
            ok = true,
            declLine = "let " + targetName + ": " + explicitType + ";",
            loopLine = "{ " + beforeRet + " " + targetName + " = " + retVar + "; }",
            bindLine = ""
            );
        }
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    tmpVar := tsInitTempName(targetName);
    if emitFmt.codeUsesIdent(beforeRet, tmpVar) {
        return (ok = false, declLine = "", loopLine = "", bindLine = "");
    }
    (
    ok = true,
    declLine = "let " + tmpVar + ": " + explicitType + ";",
    loopLine = "{ " + beforeRet + " " + tmpVar + " = " + retVar + "; }",
    bindLine = "const " + targetName + " = " + tmpVar + ";"
    )
};

/** Emits the TS module driven by composable `OptConfig`. */
pub emitProgramWithConfig := fn(items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, config: optCfg.OptConfig): Unit {
    prevCompact := tsCompactEmit;
    prevSourceMap := tsSourceMapMode;
    tsCompactEmit = config.emitFormat == optCfg.EmitFormat.Compact;
    tsSourceMapMode = config.sourceMap;
    effectiveItems := frontend.filterReachableItemsWithConfig(applySoftBuiltins(items, prefix, builtinSpecs), frontend.TARGET_TS, config);
    calls := frontend.targetHelperCalls(effectiveItems);
    abruptFault := usesAbruptFault(calls);
    abruptUnwind := usesAbruptUnwind(calls);
    hasInput := usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat");
    hasExit := usesBuiltin(calls, "exit") or usesDiagFailExit(calls) or hasInput or abruptUnwind;
    var hasEmitItem := false;
    loop effectiveItems as emitScan {
        if emitScan.kind == frontend.ITEM_KIND_END or emitScan.kind == frontend.ITEM_KIND_END_OUTPUT {
            hasEmitItem = true;
            break;
        }
    }
    usesEmit := hasEmitItem or hasExit or hasInput or abruptUnwind or calls.indexOf("lite$emit(", 0) >= 0;
    if hasExit {
        outLine("let lite$out: string[] = [];");
        outLine("");
    }
    emitBuiltinHelpers(calls);
    if usesListIndex(calls) { emitListIndexHelper(); }
    if usesListSet(calls) { emitListSetHelper(); }
    if usesListSlice(calls) { emitListSliceHelper(); }
    if usesMapIndex(calls) { emitMapIndexHelper(); }
    if usesMapGet(calls) { emitMapGetHelper(); }
    if usesMapGetOr(calls) { emitMapGetOrHelper(); }
    if usesListPop(calls) { emitListPopHelper(); }
    if usesListPopFront(calls) { emitListPopFrontHelper(); }
    emitIntArithmeticHelpers(calls, source, prefix);
    emitFloatArithmeticHelpers(calls);
    emitIntDivisionHelpers(calls);
    if usesEmit {
        outLine("export function main(lite$write?: (text: string) => void): string {");
        if hasExit { outLine("    lite$out = [];"); }
        if hasInput { outLine("    lite$resetInput();"); }
        if usesStreamRuntime(calls) { outLine("    lite$resetStreams();"); }
        if not hasExit { outLine("    const lite$out: string[] = [];"); }
        outLine("    function lite$emit(text: string): void {");
        outLine("        if (lite$write === undefined) lite$out.push(text);");
        outLine("        else lite$write(text);");
        outLine("    }");
        if not hasEmitItem and calls.indexOf("lite$emit(", 0) < 0 {
            outLine("    void lite$emit;");
        }
    } else {
        outLine("export function main(_write?: (text: string) => void): string {");
        if usesStreamRuntime(calls) { outLine("    lite$resetStreams();"); }
    }
    var indent := "    ";
    if abruptUnwind {
        outLine("    lite$abruptActive = false;");
        if abruptFault { outLine("    lite$abruptHasFault = false;"); }
        outLine("    lite$abruptStderr = \"\";");
        outLine("    lite$abruptStatus = 0;");
        outLine("    try {");
        indent = "        ";
    }
    lineBuf: mut tb.TextBuilder;
    var count := 0;
    var mainStopped := false;
    activeTriesBuf: mut tb.TextBuilder;
    tb.append(mut activeTriesBuf, "|");
    loop effectiveItems as tryItem {
        if (tryItem.kind == frontend.ITEM_KIND_TRANSFER_CATCH or tryItem.kind == frontend.ITEM_KIND_LOOP_TRANSFER_CATCH) and tryItem.runtime =!= "" {
            tb.append(mut activeTriesBuf, tryItem.runtime);
            tb.append(mut activeTriesBuf, "|");
        }
    }
    activeTries := tb.build(activeTriesBuf);
    var pendingLocFile := "";
    var pendingLocLine := 0;
    var pendingLocCol := "";
    var lastEmittedLocFile := "";
    var lastEmittedLocLine := 0;
    loop effectiveItems as item {
        if item.kind == frontend.ITEM_KIND_COMMENT {
            emitTsComment(indent, item.code);
            continue;
        }
        if item.kind == frontend.ITEM_KIND_SOURCE_LOC {
            pendingLocFile = item.name;
            pendingLocLine = item.intValue;
            pendingLocCol = item.code;
            continue;
        }
        if tsSourceMapMode =!= optCfg.SourceMapMode.None and pendingLocLine > 0 and
        item.kind =!= frontend.ITEM_KIND_IMPORT and item.kind =!= frontend.ITEM_KIND_PUBLIC_FUNCTION and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE_OP and
        item.kind =!= frontend.ITEM_KIND_PUBLIC_VALUE and item.kind =!= frontend.ITEM_KIND_PUBLIC_TYPE and
        item.kind =!= frontend.ITEM_KIND_NOOP and item.kind =!= frontend.ITEM_KIND_END_IF and
        item.kind =!= frontend.ITEM_KIND_ELSE and item.kind =!= frontend.ITEM_KIND_ELSE_IF and
        item.kind =!= frontend.ITEM_KIND_END_LOOP and item.kind =!= frontend.ITEM_KIND_END_SCOPE and
        item.kind =!= frontend.ITEM_KIND_FUNCTION_END and item.kind =!= frontend.ITEM_KIND_TRANSFER_CATCH and
        item.kind =!= frontend.ITEM_KIND_LOOP_TRANSFER_CATCH and item.kind =!= frontend.ITEM_KIND_MAIN_STOP {
            if pendingLocFile =!= lastEmittedLocFile or pendingLocLine =!= lastEmittedLocLine {
                dispFile := if pendingLocFile =!= "" { pendingLocFile } else { "<stdin>" };
                outLine(indent + "// " + dispFile + ":" + pendingLocLine.toText() + ":" + pendingLocCol);
                lastEmittedLocFile = pendingLocFile;
                lastEmittedLocLine = pendingLocLine;
            }
            pendingLocLine = 0;
        }
        if item.kind == frontend.ITEM_KIND_FUNCTION_START {
            outLine(indent + "function " + item.runtime + "(" + tsParameterList(item.textValue) + "): " +
            tsFunctionType(item.code) + " {");
            indent = indent + "    ";
            reportParameterReads(item.textValue, indent);
        } else if item.kind == frontend.ITEM_KIND_FUNCTION_END {
            indent = dedent(indent);
            outLine(indent + "}");
            outLine(indent + "void " + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_TRANSFER_TRY or item.kind == frontend.ITEM_KIND_LOOP_TRANSFER_TRY {
            if item.runtime =!= "" and activeTries =!= "|" and activeTries.indexOf("|" + item.runtime + "|", 0) >= 0 {
                outLine(indent + "try {");
                indent = indent + "    ";
            }
        } else if item.kind == frontend.ITEM_KIND_TRANSFER_CATCH {
            indent = dedent(indent);
            outLine(indent + "} catch (lite$err) {");
            if item.code == frontend.VALUE_KIND_UNIT {
                outLine(indent + "    if (lite$hasTransfer(lite$err, 0)) { return; } else { throw lite$err; }");
            } else {
                outLine(indent + "    if (lite$hasTransfer(lite$err, 0)) { return lite$transferVal; } else { throw lite$err; }");
            }
            outLine(indent + "}");
        } else if item.kind == frontend.ITEM_KIND_LOOP_TRANSFER_CATCH {
            indent = dedent(indent);
            outLine(indent + "} catch (lite$err) {");
            outLine(indent + "    if (lite$hasTransfer(lite$err, " + item.code + ")) { break; }");
            outLine(indent + "    else if (lite$hasTransfer(lite$err, " + item.textValue + ")) { continue; }");
            outLine(indent + "    else { throw lite$err; }");
            outLine(indent + "}");
        } else if item.kind == frontend.ITEM_KIND_RETURN {
            if item.code == "" {
                outLine(indent + "return;");
            } else {
                outLine(indent + "return " + item.code + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_UNREACHABLE {
            outLine(indent + "throw new Error(\"unreachable loop completion\");");
        } else if item.kind == frontend.ITEM_KIND_BREAK {
            outLine(indent + "break;");
        } else if item.kind == frontend.ITEM_KIND_CONTINUE {
            outLine(indent + "continue;");
        } else if item.kind == frontend.ITEM_KIND_CALL {
            outLine(indent + item.code + ";");
        } else if item.kind == frontend.ITEM_KIND_DISCARD {
            trimmedDiscard := item.code.trim();
            unwrapped := if trimmedDiscard.startsWithAt(0, "(() => { ") and trimmedDiscard.endsWith(" return undefined; })()") {
                innerBody := trimmedDiscard.slice(9, trimmedDiscard.length() - 23).trim();
                if innerBody.indexOf("return ", 0) < 0 and innerBody.indexOf("return;", 0) < 0 {
                    if innerBody.startsWithAt(0, "for (") or innerBody.startsWithAt(0, "while (") or innerBody.startsWithAt(0, "if (") or innerBody.startsWithAt(0, "try {") {
                        innerBody
                    } else if innerBody == "" {
                        ""
                    } else {
                        "{ " + innerBody + " }"
                    }
                } else { "" }
            } else { "" };
            if unwrapped =!= "" {
                outLine(indent + unwrapped);
            } else {
                outLine(indent + "void (" + item.code + ");");
            }
        } else if item.kind == frontend.ITEM_KIND_LOCAL_INT or item.kind == frontend.ITEM_KIND_LOCAL_STRING or item.kind == frontend.ITEM_KIND_LOCAL_BOOL or item.kind == frontend.ITEM_KIND_LOCAL_FLOAT or item.kind == frontend.ITEM_KIND_LOCAL_TUPLE {
            scalarTsType := if item.kind == frontend.ITEM_KIND_LOCAL_INT { "bigint" }
            else if item.kind == frontend.ITEM_KIND_LOCAL_STRING { "string" }
            else if item.kind == frontend.ITEM_KIND_LOCAL_BOOL { "boolean" }
            else if item.kind == frontend.ITEM_KIND_LOCAL_FLOAT { "number" }
            else { "" };
            unwrappedLoop := tryUnwrapDirectTsLoopBinding(item.runtime, false, scalarTsType, item.code);
            if unwrappedLoop.ok {
                outLine(indent + unwrappedLoop.declLine);
                outLine(indent + unwrappedLoop.loopLine);
                if unwrappedLoop.bindLine =!= "" { outLine(indent + unwrappedLoop.bindLine); }
            } else {
                outLine(indent + "const " + item.runtime + " = " + item.code + ";");
            }
            outLine(indent + "void " + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_LOCAL_LIST or item.kind == frontend.ITEM_KIND_LOCAL_FN or item.kind == frontend.ITEM_KIND_LOCAL_RECORD {
            tsType := tsFunctionType(item.textValue);
            unwrappedLoop := tryUnwrapDirectTsLoopBinding(item.runtime, false, tsType, item.code);
            if unwrappedLoop.ok {
                outLine(indent + unwrappedLoop.declLine);
                outLine(indent + unwrappedLoop.loopLine);
                if unwrappedLoop.bindLine =!= "" { outLine(indent + unwrappedLoop.bindLine); }
            } else {
                outLine(indent + "const " + item.runtime + ": " + tsType + " = " + item.code + ";");
            }
            outLine(indent + "void " + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_VAR_INT or item.kind == frontend.ITEM_KIND_VAR_STRING or item.kind == frontend.ITEM_KIND_VAR_BOOL or item.kind == frontend.ITEM_KIND_VAR_FLOAT or item.kind == frontend.ITEM_KIND_VAR_TUPLE {
            scalarTsType := if item.kind == frontend.ITEM_KIND_VAR_INT { "bigint" }
            else if item.kind == frontend.ITEM_KIND_VAR_STRING { "string" }
            else if item.kind == frontend.ITEM_KIND_VAR_BOOL { "boolean" }
            else if item.kind == frontend.ITEM_KIND_VAR_FLOAT { "number" }
            else { "" };
            unwrappedLoop := tryUnwrapDirectTsLoopBinding(item.runtime, true, scalarTsType, item.code);
            if unwrappedLoop.ok {
                outLine(indent + unwrappedLoop.declLine);
                outLine(indent + unwrappedLoop.loopLine);
                if unwrappedLoop.bindLine =!= "" { outLine(indent + unwrappedLoop.bindLine); }
            } else {
                outLine(indent + "let " + item.runtime + " = " + item.code + ";");
            }
            outLine(indent + "void " + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_VAR_LIST or item.kind == frontend.ITEM_KIND_VAR_FN or item.kind == frontend.ITEM_KIND_VAR_RECORD {
            tsType := tsFunctionType(item.textValue);
            unwrappedLoop := tryUnwrapDirectTsLoopBinding(item.runtime, true, tsType, item.code);
            if unwrappedLoop.ok {
                outLine(indent + unwrappedLoop.declLine);
                outLine(indent + unwrappedLoop.loopLine);
                if unwrappedLoop.bindLine =!= "" { outLine(indent + unwrappedLoop.bindLine); }
            } else {
                outLine(indent + "let " + item.runtime + ": " + tsType + " = " + item.code + ";");
            }
            outLine(indent + "void " + item.runtime + ";");
        } else if item.kind == frontend.ITEM_KIND_ASSIGN_INT or item.kind == frontend.ITEM_KIND_ASSIGN_STRING or item.kind == frontend.ITEM_KIND_ASSIGN_BOOL or item.kind == frontend.ITEM_KIND_ASSIGN_FLOAT or item.kind == frontend.ITEM_KIND_ASSIGN_TUPLE {
            outLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == frontend.ITEM_KIND_ASSIGN_LIST or item.kind == frontend.ITEM_KIND_ASSIGN_FN or item.kind == frontend.ITEM_KIND_ASSIGN_RECORD {
            outLine(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == frontend.ITEM_KIND_SCOPE {
            outLine(indent + "{");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_IF {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            outLine(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE {
            indent = dedent(indent);
            outLine(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_ELSE_IF {
            indent = dedent(indent);
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            outLine(indent + "} else if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_IF or item.kind == frontend.ITEM_KIND_END_SCOPE {
            indent = dedent(indent);
            outLine(indent + "}");
        } else if item.kind == frontend.ITEM_KIND_LOOP_SEQ {
            if item.intValue == 1 {
                outLine(indent + "for (const " + item.runtime + " of (" + item.code + ")) {");
                indent = indent + "    ";
                outLine(indent + "void " + item.runtime + ";");
            } else if item.intValue == 2 {
                outLine(indent + "for (const [lite$mk, lite$mv] of (" + item.code + ")) {");
                indent = indent + "    ";
                outLine(indent + "const " + item.runtime + " = { key: lite$mk, value: lite$mv };");
                outLine(indent + "void " + item.runtime + ";");
            } else {
                seqExpr := if item.code.startsWithAt(0, "Array.from(") { item.code } else { tsLiteral.listCopyCode(item.code) };
                outLine(indent + "for (const " + item.runtime + " of " + seqExpr + ") {");
                indent = indent + "    ";
                outLine(indent + "void " + item.runtime + ";");
            }
        } else if item.kind == frontend.ITEM_KIND_LOOP {
            condition := if item.code == "" { "Boolean(true)" }
            else if item.code == "false" { "Boolean(false)" }
            else { item.code };
            outLine(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == frontend.ITEM_KIND_END_LOOP {
            indent = dedent(indent);
            outLine(indent + "}");
        } else if item.kind == frontend.ITEM_KIND_END or item.kind == frontend.ITEM_KIND_END_OUTPUT {
            if count == 0 {
                outLine(indent + "lite$emit(" + tsLiteral.textLiteralCode(if item.kind == frontend.ITEM_KIND_END { "\n" } else { "" }) + ");");
            } else {
                line := tb.build(lineBuf);
                ending := if item.kind == frontend.ITEM_KIND_END { " + \"\\n\"" } else { "" };
                emitted := if count == 1 and item.kind == frontend.ITEM_KIND_END and not line.startsWithAt(0, "(") and line.indexOf("?", 0) >= 0 {
                    "(" + line + ")"
                } else {
                    line
                };
                outLine(indent + "lite$emit(" + emitted + ending + ");");
            }
            tb.clear(mut lineBuf);
            count = 0;
        } else if item.kind == frontend.ITEM_KIND_MAIN_STOP {
            mainStopped = true;
        } else if item.kind == frontend.ITEM_KIND_IMPORT or item.kind == frontend.ITEM_KIND_PUBLIC_FUNCTION or item.kind == frontend.ITEM_KIND_PUBLIC_TYPE_OP or item.kind == frontend.ITEM_KIND_PUBLIC_VALUE or item.kind == frontend.ITEM_KIND_PUBLIC_TYPE or item.kind == frontend.ITEM_KIND_NOOP {
        } else {
            if count > 0 { tb.append(mut lineBuf, " + \" \" + "); }
            tb.append(mut lineBuf, reportArgumentCode(item));
            count = count + 1;
        }
    }
    if not mainStopped {
        if usesEmit {
            outLine(indent + "return lite$out.join(\"\");");
        } else {
            outLine(indent + "return \"\";");
        }
    }
    if abruptUnwind {
        outLine("    } catch (lite$err) {");
        outLine("        if (lite$err === lite$abruptToken) {");
        outLine("            if (lite$out.length > 0) {");
        outLine("                process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out.join(\"\"));");
        outLine("                lite$out = [];");
        outLine("            }");
        outLine("            if (lite$abruptStderr !== \"\") {");
        outLine("                process.getBuiltinModule(\"node:fs\").writeSync(2, lite$abruptStderr);");
        outLine("            }");
        outLine("            process.exit(lite$abruptStatus);");
        outLine("        }");
        outLine("        throw lite$err;");
        outLine("    }");
    }
    outLine("}");
    if usesHostOs(calls) or usesBuiltin(calls, "inputArgs") {
        outLine("");
        outLine("if ((import.meta as { readonly main?: boolean }).main === true) {");
        outLine("    const lite$exitTok = {};");
        outLine("    let lite$exitCode = 0;");
        outLine("    const lite$proc = process as { exit: (code: number) => never; exitCode?: number };");
        outLine("    const lite$origExit = lite$proc.exit;");
        outLine("    lite$proc.exit = (code: number): never => { lite$exitCode = code; throw lite$exitTok; };");
        outLine("    try {");
        outLine("        main((text: string): void => {");
        outLine("            process.getBuiltinModule(\"node:fs\").writeSync(1, text);");
        outLine("        });");
        outLine("    } catch (lite$err) {");
        outLine("        if (lite$err === lite$exitTok) {");
        outLine("            lite$proc.exitCode = lite$exitCode;");
        outLine("        } else {");
        outLine("            throw lite$err;");
        outLine("        }");
        outLine("    } finally {");
        outLine("        lite$proc.exit = lite$origExit;");
        outLine("    }");
        outLine("}");
    }
    tsCompactEmit = prevCompact;
    tsSourceMapMode = prevSourceMap;
}

/** Emits the TS module into `writer` driven by composable `OptConfig`. */
pub emitProgramToWithConfig := fn(writer: io.Writer, items: frontend.Items, source: String, prefix: String, builtinSpecs: List<String>, config: optCfg.OptConfig): Unit {
    tsOutUseWriter = true;
    tsOutWriterKind = writer.kind;
    tsOutWriterHandle = writer.handle;
    emitProgramWithConfig(items, source, prefix, builtinSpecs, config);
    tsOutUseWriter = false;
};
