/** Emits the self-contained declarations and helpers for the I/O and text builtins a program uses. */
emitBuiltinHelpers := fn(calls: String): Unit {
    abruptFault := usesAbruptFault(calls);
    abruptExit := usesBuiltin(calls, "finally") and (usesBuiltin(calls, "exit") or usesDiagFailExit(calls));
    abruptUnwind := usesAbruptUnwind(calls);
    emitProcessDecl(calls);
    if abruptUnwind {
        outLine("const lite$abruptToken = {};");
        outLine("let lite$abruptActive: boolean = false;");
        if abruptFault { outLine("let lite$abruptHasFault: boolean = false;"); }
        outLine("let lite$abruptStderr: string = \"\";");
        outLine("let lite$abruptStatus: number = 0;");
        if abruptFault {
            outLine("function lite$throwAbruptFault(text: string): never {");
            outLine("    if (!lite$abruptActive) {");
            outLine("        lite$abruptActive = true;");
            outLine("        lite$abruptHasFault = true;");
            outLine("        lite$abruptStderr = text;");
            outLine("        lite$abruptStatus = 1;");
            outLine("    } else if (!lite$abruptHasFault) {");
            outLine("        lite$abruptHasFault = true;");
            outLine("        lite$abruptStderr = text;");
            outLine("        lite$abruptStatus = 1;");
            outLine("    } else {");
            outLine("        lite$abruptStderr += text;");
            outLine("    }");
            outLine("    throw lite$abruptToken;");
            outLine("}");
        }
        if abruptExit {
            outLine("function lite$throwAbruptExit(status: number): never {");
            outLine("    if (!lite$abruptActive) {");
            outLine("        lite$abruptActive = true;");
            outLine("        lite$abruptStatus = status;");
            outLine("    }");
            outLine("    throw lite$abruptToken;");
            outLine("}");
        }
        outLine("");
    }
    if usesBuiltin(calls, "inputArgs") {
        outLine("function lite$inputArgs(): string[] {");
        outLine("    return process.argv.slice(2);");
        outLine("}");
        outLine("");
    }
    emitInputHelpers(calls);
    if usesBuiltin(calls, "reportError") or usesDiagFailExit(calls) {
        outLine("function lite$reportError(text: string): void {");
        outLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, text + \"\\n\");");
        outLine("}");
        outLine("");
    }
    if usesBuiltin(calls, "exit") or usesDiagFailExit(calls) {
