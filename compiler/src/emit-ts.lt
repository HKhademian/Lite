/** Emits host process, env, and child-execution helpers used by the program. */
emitProcessHelpers := fn(calls: String): Unit {
    if not usesProcess(calls) { return; }
    if usesBuiltin(calls, "processCwd") { outLine("function lite$processCwd(): string { return process.cwd(); }"); }
    if usesBuiltin(calls, "processExecPath") { outLine("function lite$processExecPath(): string { return process.execPath; }"); }
    if usesBuiltin(calls, "processEntryPath") { outLine("function lite$processEntryPath(): string { return process.argv[1] ?? \"\"; }"); }
    if usesBuiltin(calls, "processPlatform") { outLine("function lite$processPlatform(): string { return process.platform; }"); }
    if usesBuiltin(calls, "processArch") { outLine("function lite$processArch(): string { return process.arch; }"); }
    if usesBuiltin(calls, "processRuntimeVersion") { outLine("function lite$processRuntimeVersion(): string { return process.version; }"); }
    if usesBuiltin(calls, "processEnvGet") {
        outLine("function lite$processEnvGet(name: string): { found: boolean; value: string } {");
        outLine("    if (!Object.prototype.hasOwnProperty.call(process.env, name)) return { found: false, value: \"\" };");
