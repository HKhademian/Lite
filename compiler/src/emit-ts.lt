tsLiteral := import "./ts-literals";
emitFmt := import "./emit-format";
optCfg := import "./opt-config";
frontend := import "./frontend";
io := import "core/io";
tb := import "util/text-builder";

var tsOutUseWriter := false;
var tsOutWriterKind := "";
var tsOutWriterHandle := 0;
var tsCompactEmit := false;
var tsSourceMapMode: optCfg.SourceMapMode = optCfg.SourceMapMode.None;

/** Emits one line to either standard output or an explicit target `io.Writer`. */
outLine := fn(s: String): Unit {
    line := if tsCompactEmit { s.trimStart() } else { emitFmt.formatEmittedLine(s) };
    if tsCompactEmit and line == "" { return; }
    if not tsOutUseWriter {
        io.outputLine(line);
    } else {
        w: io.Writer = (kind = tsOutWriterKind, handle = tsOutWriterHandle);
        _res := io.writeLine(w, line);
    }
};

/** Emits raw text to either standard output or an explicit target `io.Writer`. */
outText := fn(s: String): Unit {
    if not tsOutUseWriter {
        io.output(s);
    } else {
        w: io.Writer = (kind = tsOutWriterKind, handle = tsOutWriterHandle);
        _res := io.writeText(w, s);
    }
};

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    indent.slice(0, indent.length() - 4)
}

/** Formats one canonical flat tuple kind as a TypeScript object type. */
tsTupleType := fn(kind: String): String {
    frontend.tsTupleType(kind)
}

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array or List kind to its TypeScript type. */
tsFunctionType := fn(kind: String): String {
    frontend.tsFunctionType(kind)
}

/** Formats a `|`-separated `name=kind` parameter list as a TypeScript parameter list. */
tsParameterList := fn(encoded: String): String {
    if encoded == "" { return ""; }
    result: mut tb.TextBuilder;
    var start := 0;
    loop true {
        separator := encoded.indexOf("|", start);
        var end := encoded.length();
        if separator >= 0 { end = separator; }
        entry := encoded.slice(start, end);
        equals := entry.indexOf("=", 0);
        parameterName := entry.slice(0, equals);
        rawParameterKind := entry.slice(equals + 1, entry.length());
        isMutParam := rawParameterKind.startsWithAt(0, "mut ");
        parameterKind := if isMutParam {
            rawParameterKind.slice(4, rawParameterKind.length())
        } else { rawParameterKind };
        if tb.count(result) > 0 { tb.append(mut result, ", "); }
        tb.append(mut result, "lite_");
        tb.append(mut result, parameterName);
        if isMutParam and frontend.isRecordOrDistinctRecord(parameterKind) {
            tb.append(mut result, ": { v: ");
            tb.append(mut result, tsFunctionType(parameterKind));
            tb.append(mut result, " }");
        } else {
            tb.append(mut result, ": ");
            tb.append(mut result, tsFunctionType(parameterKind));
        }
        if separator < 0 { break; }
        start = separator + 1;
    }
    tb.build(result)
}

/** Emits `void` reads for parameters so strict unused-parameter checking accepts bodies that ignore inputs. */
reportParameterReads := fn(encoded: String, indent: String): Unit {
    if encoded == "" { return; }
    var start := 0;
    loop true {
        separator := encoded.indexOf("|", start);
        var end := encoded.length();
        if separator >= 0 { end = separator; }
        entry := encoded.slice(start, end);
        equals := entry.indexOf("=", 0);
        outLine(indent + "void lite_" + entry.slice(0, equals) + ";");
        if separator < 0 { break; }
        start = separator + 1;
    }
}

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
displayValueCode := fn(kind: String, code: String): String {
    frontend.tsDisplayValueCode(kind, code)
}

/** Formats one output argument without duplicating its evaluation. */
reportArgumentCode := fn(item: frontend.Item): String {
    displayValueCode(item.kind, item.code)
}

/** True when any emitted item calls the named `lite$` helper outside quoted String literal text. */
usesBuiltin := fn(calls: String, name: String): Bool {
    if calls == "|" { return false; }
    calls.indexOf("|lite$" + name + "(|", 0) >= 0
}

/** True when any emitted item reads a map value through the checked helper. */
usesMapIndex := fn(calls: String): Bool {
    usesBuiltin(calls, "mapAt")
}

/** True when any emitted item calls the shared `core/map` `get` helper. */
usesMapGet := fn(calls: String): Bool {
    usesBuiltin(calls, "mapGet")
}

/** True when any emitted item calls the shared `core/map` `getOr` helper. */
usesMapGetOr := fn(calls: String): Bool {
    usesBuiltin(calls, "mapGetOr")
}

/** True when any emitted item reads a list element through the checked helper. */
usesListIndex := fn(calls: String): Bool {
    usesBuiltin(calls, "listAt")
}

/** True when any emitted item writes a list element through the checked helper. */
usesListSet := fn(calls: String): Bool {
    usesBuiltin(calls, "listSet")
}

/** True when any emitted item slices a list through the checked helper. */
usesListSlice := fn(calls: String): Bool {
    usesBuiltin(calls, "listSlice")
}

/** True when any emitted item pops a list back element through the checked helper. */
usesListPop := fn(calls: String): Bool {
    usesBuiltin(calls, "listPopBack")
}

/** True when any emitted item pops a list front element through the checked helper. */
usesListPopFront := fn(calls: String): Bool {
    usesBuiltin(calls, "listPopFront")
}

/** True when any emitted item calls a host filesystem builtin. */
/** True when any emitted item calls a core `file` host builtin. */
usesFile := fn(calls: String): Bool {
    usesBuiltin(calls, "fileKind") or usesBuiltin(calls, "fileOpenReader") or
    usesBuiltin(calls, "fileOpenWriter") or usesBuiltin(calls, "fileOpenAppender") or
    usesBuiltin(calls, "fileListDir") or usesBuiltin(calls, "fileMakeDir") or
    usesBuiltin(calls, "fileRemove") or usesBuiltin(calls, "fileCopy") or
    usesBuiltin(calls, "fileSymlink") or usesBuiltin(calls, "fileRealPath") or
    usesBuiltin(calls, "fileMakeTempDir") or usesBuiltin(calls, "fileReadBytes") or
    usesBuiltin(calls, "fileReadText") or usesBuiltin(calls, "fileWriteBytes") or
    usesBuiltin(calls, "fileWriteText") or usesBuiltin(calls, "fileAppendBytes") or
    usesBuiltin(calls, "fileAppendText")
}

/** True when any emitted item calls a core `io` synchronous `Reader`/`Writer` stream builtin. */
usesIoStream := fn(calls: String): Bool {
    usesBuiltin(calls, "ioStdinReader") or usesBuiltin(calls, "ioStdoutWriter") or usesBuiltin(calls, "ioStderrWriter") or
    usesBuiltin(calls, "ioBufferReader") or usesBuiltin(calls, "ioTextReader") or usesBuiltin(calls, "ioBufferWriter") or
    usesBuiltin(calls, "ioWriterBytes") or usesBuiltin(calls, "ioWriterText") or usesBuiltin(calls, "ioClearWriter") or
    usesBuiltin(calls, "ioReaderOk") or usesBuiltin(calls, "ioReaderAtEof") or usesBuiltin(calls, "ioReaderError") or
    usesBuiltin(calls, "ioRead") or usesBuiltin(calls, "ioReadAll") or usesBuiltin(calls, "ioReadAllText") or
    usesBuiltin(calls, "ioReadLine") or usesBuiltin(calls, "ioCloseReader") or usesBuiltin(calls, "ioWriterOk") or
    usesBuiltin(calls, "ioWriterError") or usesBuiltin(calls, "ioWrite") or usesBuiltin(calls, "ioWriteText") or
    usesBuiltin(calls, "ioWriteLine") or usesBuiltin(calls, "ioFlush") or usesBuiltin(calls, "ioCloseWriter")
}

/** True when the shared synchronous `Reader`/`Writer` stream table must be emitted. */
usesStreamRuntime := fn(calls: String): Bool {
    usesIoStream(calls) or usesBuiltin(calls, "fileOpenReader") or
    usesBuiltin(calls, "fileOpenWriter") or usesBuiltin(calls, "fileOpenAppender")
}

/** True when a host helper reports diagnostic failures through `lite$reportError` + `lite$exit(2n)`. */
usesDiagFailExit := fn(calls: String): Bool {
    usesBuiltin(calls, "fileReadBytes") or usesBuiltin(calls, "cryptoEncodeBytes") or
    usesBuiltin(calls, "cryptoDecodeBytes") or usesBuiltin(calls, "cryptoHmacSha256Bytes")
}

/** True when a host helper validates `0..255` byte lists through diagnostic exit 2. */
usesToBytesDiag := fn(calls: String): Bool {
    usesBuiltin(calls, "cryptoEncodeBytes") or usesBuiltin(calls, "cryptoHmacSha256Bytes")
}

/** True when any emitted item calls a host helper returning `(ok, ..., error)` or recording host error strings. */
usesHostErrorResult := fn(calls: String): Bool {
    usesBuiltin(calls, "fileMakeDir") or usesBuiltin(calls, "fileRemove") or usesBuiltin(calls, "fileCopy") or
    usesBuiltin(calls, "fileSymlink") or usesBuiltin(calls, "fileRealPath") or usesBuiltin(calls, "fileMakeTempDir") or
    usesBuiltin(calls, "fileOpenReader") or usesBuiltin(calls, "fileOpenWriter") or usesBuiltin(calls, "fileOpenAppender") or
    usesBuiltin(calls, "fileReadBytes") or usesBuiltin(calls, "fileReadText") or usesBuiltin(calls, "fileWriteBytes") or
    usesBuiltin(calls, "fileWriteText") or usesBuiltin(calls, "fileAppendBytes") or usesBuiltin(calls, "fileAppendText") or
    usesBuiltin(calls, "ioRead") or usesBuiltin(calls, "ioReadAll") or usesBuiltin(calls, "ioReadAllText") or
    usesBuiltin(calls, "ioReadLine") or usesBuiltin(calls, "ioCloseReader") or usesBuiltin(calls, "ioWrite") or
    usesBuiltin(calls, "ioWriteText") or usesBuiltin(calls, "ioWriteLine") or usesBuiltin(calls, "ioFlush") or
    usesBuiltin(calls, "ioCloseWriter") or usesBuiltin(calls, "ioWriterText") or usesBuiltin(calls, "processRunBytes") or
    usesBuiltin(calls, "cryptoDigestFile") or usesBuiltin(calls, "unicodeUtf8DecodeStrict") or
    usesBuiltin(calls, "extTsStripTypes") or usesBuiltin(calls, "extHttpFetchToFile") or
    usesToBytesDiag(calls)
}

/** True when any emitted item calls a host process builtin. */
usesProcess := fn(calls: String): Bool {
    usesBuiltin(calls, "processCwd") or usesBuiltin(calls, "processExecPath") or
    usesBuiltin(calls, "processEntryPath") or usesBuiltin(calls, "processPlatform") or
    usesBuiltin(calls, "processArch") or usesBuiltin(calls, "processRuntimeVersion") or
    usesBuiltin(calls, "processEnvGet") or usesBuiltin(calls, "processRun") or usesBuiltin(calls, "processRunBytes")
}

/** True when any emitted item uses Node `node:crypto` digest, HMAC, or CSPRNG builtins. */
usesCrypto := fn(calls: String): Bool {
    usesBuiltin(calls, "cryptoDigestBytes") or usesBuiltin(calls, "cryptoDigestText") or
    usesBuiltin(calls, "cryptoDigestFile") or usesBuiltin(calls, "cryptoHmacSha256Bytes") or
    usesBuiltin(calls, "cryptoRandomBytes")
}

/** True when any emitted item uses Node `node:buffer` base64/hex codec builtins. */
usesCryptoBuffer := fn(calls: String): Bool {
    usesBuiltin(calls, "cryptoEncodeBytes") or usesBuiltin(calls, "cryptoDecodeBytes")
}

/** True when any emitted item calls a host time builtin. */
usesTime := fn(calls: String): Bool {
    usesBuiltin(calls, "timeMonotonicNs") or usesBuiltin(calls, "timeEpochNs") or
    usesBuiltin(calls, "timeSleepMs") or usesBuiltin(calls, "timeLocalDate")
}

/** True when any emitted item calls a Unicode scalar bridge builtin. */
usesUnicode := fn(calls: String): Bool {
    usesBuiltin(calls, "unicodeToCodePoints") or usesBuiltin(calls, "unicodeFromCodePoints") or
    usesBuiltin(calls, "unicodeUtf8Encode") or usesBuiltin(calls, "unicodeUtf8DecodeStrict") or
    usesBuiltin(calls, "unicodeUtf8DecodeLossy")
}

/** True when any emitted item calls an external host binding declared under `lib/external/`. */
usesExternal := fn(calls: String): Bool {
    usesBuiltin(calls, "extTsStripTypes") or usesBuiltin(calls, "extHttpFetchToFile") or
    usesBuiltin(calls, "extHttpServeStatic") or usesBuiltin(calls, "extBenchMeasureCompiler") or
    usesBuiltin(calls, "extPoolCpuCount") or usesBuiltin(calls, "extPoolRunJson")
}

/** True when any emitted item calls an `extra/canvas` surface or drawing binding. */
usesExtraCanvas := fn(calls: String): Bool {
    usesBuiltin(calls, "extraCanvasOpen") or usesBuiltin(calls, "extraCanvasPoll") or
    usesBuiltin(calls, "extraCanvasPresent") or usesBuiltin(calls, "extraCanvasClose") or
    usesBuiltin(calls, "extraCanvasClear") or usesBuiltin(calls, "extraCanvasFillRect") or
    usesBuiltin(calls, "extraCanvasStrokeRect") or usesBuiltin(calls, "extraCanvasFillCircle") or
    usesBuiltin(calls, "extraCanvasStrokeLine") or usesBuiltin(calls, "extraCanvasDrawText") or
    usesBuiltin(calls, "extraCanvasCapture") or usesBuiltin(calls, "extraCanvasSetTargetFps") or
    usesBuiltin(calls, "extraCanvasVitals") or usesBuiltin(calls, "extraCanvasPlayTone") or
    usesBuiltin(calls, "extraCanvasBounds") or usesBuiltin(calls, "extraCanvasResize") or
    usesBuiltin(calls, "extraCanvasSetFullscreen") or usesBuiltin(calls, "extraCanvasRun") or
    usesBuiltin(calls, "extraCanvasIsKeyDown") or usesBuiltin(calls, "extraCanvasIsKeyPressed") or
    usesBuiltin(calls, "extraCanvasIsKeyReleased") or usesBuiltin(calls, "extraCanvasIsPointerPressed") or
    usesBuiltin(calls, "extraCanvasIsPointerReleased") or usesBuiltin(calls, "extraCanvasWheelDelta") or
    usesBuiltin(calls, "extraCanvasSetClipRect") or usesBuiltin(calls, "extraCanvasClearClipRect") or
    usesBuiltin(calls, "extraCanvasFillTriangle") or usesBuiltin(calls, "extraCanvasCreateTexture") or
    usesBuiltin(calls, "extraCanvasSetTexturePixel") or usesBuiltin(calls, "extraCanvasBlit") or
    usesBuiltin(calls, "extraCanvasBlitScaled") or usesBuiltin(calls, "extraCanvasDestroyTexture") or
    usesBuiltin(calls, "extraCanvasScratchMark") or usesBuiltin(calls, "extraCanvasScratchRewind")
}

/** True when any emitted item calls any OS/host tool builtin beyond basic I/O and text. */
usesHostOs := fn(calls: String): Bool {
    usesFile(calls) or usesStreamRuntime(calls) or usesProcess(calls) or usesCrypto(calls) or usesCryptoBuffer(calls) or usesTime(calls) or usesExternal(calls) or usesExtraCanvas(calls)
}

/** True when a program needs checked dynamic Int* arithmetic or narrow range guards. */
usesIntArithmetic := fn(calls: String): Bool {
    usesBuiltin(calls, "addInt") or usesBuiltin(calls, "subtractInt") or usesBuiltin(calls, "multiplyInt") or
    usesBuiltin(calls, "negateInt") or usesBuiltin(calls, "checkedNarrowInt")
}

/** True when positioned division-family helpers are needed. */
usesIntDivision := fn(calls: String): Bool {
    usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "remainderInt") or usesBuiltin(calls, "floorDivideInt") or usesBuiltin(calls, "floorModuloInt")
}

/** True when binary64/binary32 operations need finite-result and zero-divisor guards. */
usesFloatArithmetic := fn(calls: String): Bool { usesBuiltin(calls, "floatOp") or usesBuiltin(calls, "float32Op") or usesBuiltin(calls, "floatPower") }

/** Emits the shared Float and Float32 arithmetic helpers without folding operations before execution. */
emitFloatArithmeticHelpers := fn(calls: String): Unit {
    if not usesFloatArithmetic(calls) { return; }
    if usesBuiltin(calls, "floatPower") {
        outLine("function lite$floatPower(left: number, right: number, at: number): number {");
        outLine("    if (left === 0 && right < 0) lite$fault(\"ArithmeticPanic\", at, \"zero cannot be raised to a negative power\");");
        outLine("    const value = Math.pow(left, right);");
        outLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
        outLine("    return value;");
        outLine("}");
    }
    if usesBuiltin(calls, "float32Op") {
        outLine("function lite$float32Op(left: number, right: number, op: number, at: number): number {");
        outLine("    if (op === 3 && right === 0) lite$fault(\"ArithmeticPanic\", at, \"division by zero\");");
        outLine("    const value = Math.fround(op === 0 ? left + right : op === 1 ? left - right : op === 2 ? left * right : left / right);");
        outLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
        outLine("    return value;");
        outLine("}");
    }
    if not usesBuiltin(calls, "floatOp") { return; }
    outLine("function lite$floatOp(left: number, right: number, op: number, at: number): number {");
    outLine("    if (op === 3 && right === 0) lite$fault(\"ArithmeticPanic\", at, \"division by zero\");");
    outLine("    const value = op === 0 ? left + right : op === 1 ? left - right : op === 2 ? left * right : left / right;");
    outLine("    if (!Number.isFinite(value)) lite$fault(\"ArithmeticPanic\", at, \"non-finite floating value\");");
    outLine("    return value;");
    outLine("}");
}

/** True when positioned bounds faults may be raised by text or list helpers. */
usesBounds := fn(calls: String): Bool {
    usesBuiltin(calls, "textAt") or usesBuiltin(calls, "textSlice") or usesBuiltin(calls, "textSkipWhile") or usesListIndex(calls) or usesListSet(calls) or usesListSlice(calls) or usesMapIndex(calls) or usesListPop(calls) or usesListPopFront(calls)
}

/** True when runtime faults or input failures may require construct-level `finally` unwinding. */
usesAbruptFault := fn(calls: String): Bool {
    usesBuiltin(calls, "finally") and (
    usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or
    usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat") or usesIntArithmetic(calls) or
    usesIntDivision(calls) or usesBounds(calls) or usesFloatArithmetic(calls)
    )
}

/** True when construct-level `finally` must intercept process-terminating exits or runtime faults to unwind cleanups first. */
usesAbruptUnwind := fn(calls: String): Bool {
    usesAbruptFault(calls) or (usesBuiltin(calls, "finally") and (usesBuiltin(calls, "exit") or usesDiagFailExit(calls)))
}

/** Emits shared position metadata once, exact runtime faults, and the arithmetic helpers actually used. */
emitIntArithmeticHelpers := fn(calls: String, source: String, prefix: String): Unit {
    integers := usesIntArithmetic(calls) or usesIntDivision(calls);
    if not integers and not usesBounds(calls) and not usesFloatArithmetic(calls) { return; }
    namePrefix := if prefix == "" { "" } else { prefix + ":" };
    needsRange := usesBuiltin(calls, "addInt") or usesBuiltin(calls, "subtractInt") or
    usesBuiltin(calls, "multiplyInt") or usesBuiltin(calls, "negateInt") or
    usesBuiltin(calls, "divideInt") or usesBuiltin(calls, "floorDivideInt");
    outLine("const lite$intLines: readonly number[] = [" + frontend.lineStartCodes(source) + "];");
    outLine("const lite$intSource = " + tsLiteral.textLiteralCode(namePrefix) + ";");
    if needsRange { outLine("const lite$intMin = -(1n << 63n), lite$intMax = (1n << 63n) - 1n;"); }
    outLine("function lite$fault(category: string, at: number, message: string): never {");
    outLine("    let line = 0;");
    outLine("    while (line + 1 < lite$intLines.length && (lite$intLines[line + 1] ?? Infinity) <= at) line += 1;");
    outLine("    const column = at - (lite$intLines[line] ?? 0) + 1;");
    if usesAbruptUnwind(calls) {
        outLine("    return lite$throwAbruptFault(lite$intSource + (line + 1) + \":\" + column + \": \" + category + \": \" + message + \"\\n\");");
    } else {
        outLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, lite$intSource + (line + 1) + \":\" + column + \": \" + category + \": \" + message + \"\\n\");");
        outLine("    process.exit(1);");
    }
    outLine("}");
    if integers {
        outLine("function lite$intFault(at: number, message: string): never { return lite$fault(\"ArithmeticPanic\", at, message); }");
    }
    if needsRange {
        outLine("function lite$checkedInt(value: bigint, at: number): bigint {");
        outLine("    if (value < lite$intMin || value > lite$intMax) lite$intFault(at, \"integer outside Int range\");");
        outLine("    return value;");
        outLine("}");
    }
    if usesBuiltin(calls, "addInt") {
        outLine("function lite$addInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left + right, at); }");
    }
    if usesBuiltin(calls, "subtractInt") {
        outLine("function lite$subtractInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left - right, at); }");
    }
    if usesBuiltin(calls, "multiplyInt") {
        outLine("function lite$multiplyInt(left: bigint, right: bigint, at: number): bigint { return lite$checkedInt(left * right, at); }");
    }
    if usesBuiltin(calls, "negateInt") {
        outLine("function lite$negateInt(value: bigint, at: number): bigint { return lite$checkedInt(-value, at); }");
    }
    if usesBuiltin(calls, "checkedNarrowInt") {
        outLine("function lite$checkedNarrowInt(value: bigint, bits: bigint, name: string, at: number): bigint {");
        outLine("    const limit = 1n << (bits - 1n);");
        outLine("    if (value < -limit || value >= limit) lite$intFault(at, \"integer outside \" + name + \" range\");");
        outLine("    return value;");
        outLine("}");
    }
    outLine("");
}

/** Emits shared buffered byte input and strict incremental UTF-8 decoding for the temporary input helpers. */
emitInputHelpers := fn(calls: String): Unit {
    if not (usesBuiltin(calls, "inputAll") or usesBuiltin(calls, "inputLine") or usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat")) { return; }
    outLine("let lite$decoder = new TextDecoder(\"utf-8\", { fatal: true });");
    outLine("const lite$bytes = new Uint8Array(4096);");
    outLine("let lite$byteAt = 0, lite$byteEnd = 0;");
    outLine("let lite$ended = false;");
    outLine("let lite$pending: string | null | undefined;");
    outLine("function lite$resetInput(): void {");
    outLine("    lite$decoder = new TextDecoder(\"utf-8\", { fatal: true });");
    outLine("    lite$byteAt = 0;");
    outLine("    lite$byteEnd = 0;");
    outLine("    lite$ended = false;");
    outLine("    lite$pending = undefined;");
    outLine("}");
    outLine("function lite$inputFault(at: string, message: string): never {");
    if usesAbruptUnwind(calls) {
        outLine("    return lite$throwAbruptFault(at + message + \"\\n\");");
    } else {
        outLine("    process.getBuiltinModule(\"node:fs\").writeSync(2, at + message + \"\\n\");");
        outLine("    process.exit(1);");
    }
    outLine("}");
    outLine("function lite$prompt(text: string | undefined): void {");
    outLine("    if (text === undefined) return;");
    outLine("    process.getBuiltinModule(\"node:fs\").writeSync(1, lite$out.join(\"\") + text);");
    outLine("    lite$out = [];");
    outLine("}");
    outLine("function lite$peek(at: string): string | null {");
    outLine("    if (lite$pending !== undefined) return lite$pending;");
    outLine("    if (lite$ended) return null;");
    outLine("    try {");
    outLine("        while (true) {");
    outLine("            if (lite$byteAt === lite$byteEnd) {");
    outLine("                lite$byteEnd = process.getBuiltinModule(\"node:fs\").readSync(0, lite$bytes, 0, lite$bytes.length, null);");
    outLine("                lite$byteAt = 0;");
    outLine("                if (lite$byteEnd === 0) {");
    outLine("                    lite$ended = true;");
    outLine("                    lite$pending = lite$decoder.decode() || null;");
    outLine("                    return lite$pending;");
    outLine("                }");
    outLine("            }");
    outLine("            const text = lite$decoder.decode(lite$bytes.subarray(lite$byteAt, ++lite$byteAt), { stream: true });");
    outLine("            if (text !== \"\") { lite$pending = text; return text; }");
    outLine("        }");
    outLine("    } catch (error) {");
    outLine("        return lite$inputFault(at, \"cannot read input: \" + (error instanceof Error ? error.message : String(error)));");
    outLine("    }");
    outLine("}");
    outLine("function lite$take(at: string): string | null {");
    outLine("    const text = lite$peek(at); lite$pending = undefined; return text;");
    outLine("}");
    if usesBuiltin(calls, "inputInt") or usesBuiltin(calls, "inputFloat") {
        outLine("function lite$word(at: string): string | null {");
        outLine("    let ch = lite$peek(at);");
        outLine("    while (ch !== null && /\\s/u.test(ch)) { lite$take(at); ch = lite$peek(at); }");
        outLine("    if (ch === null) return null;");
        outLine("    let text = \"\";");
        outLine("    while (ch !== null && !/\\s/u.test(ch)) { text += lite$take(at); ch = lite$peek(at); }");
