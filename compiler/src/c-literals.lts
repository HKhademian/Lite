/* C backend for the temporary Lite compiler. */

integer := import "core/int";
numeric := import "./numeric-literals.lts";
diagLib := import "core/diag";
textLib := import "core/text";

/** Formats a checked Int value as a C signed 64-bit literal (`INT64_C`, `INT64_MIN`). */
pub intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == -9223372036854775808 { "INT64_MIN" }
    else if value == 0 { "INT64_C(0)" }
    else if negative { "(-INT64_C(" + digits + "))" }
    else { "INT64_C(" + digits + ")" }
}

/** Escapes a String as a readable C literal, including trigraph-safe `?`. */
pub textLiteralCode := fn(value: String): String {
    size := textLib.length(value);
    var encoded := "\"";
    var position := 0;
    loop position < size {
        ch := textLib.at(value, position);
        if ch == "\\" { encoded += "\\\\"; }
        else if ch == "\"" { encoded += "\\\""; }
        else if ch == "?" { encoded += "\\?"; }
        else if ch == "\n" { encoded += "\\n"; }
        else if ch == "\r" { encoded += "\\r"; }
        else if ch == "\t" { encoded += "\\t"; }
        else { encoded += ch; }
        position += 1;
    }
    encoded + "\""
}

/** Encodes a finite decimal Float token through the target's correctly rounded binary64 parser, preserving signed zero and gradual underflow. */
pub floatLiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "lt_float_literal(" + textLiteralCode(digits) + ")";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Encodes a finite decimal Float32 token parsed as binary32 float and promoted to binary64 storage for uniform C emission. */
pub float32LiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "((double)lt_float32_literal(" + textLiteralCode(digits) + "))";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Evaluates a Unit expression's effects while suppressing any target builtin return payload. */
pub unitEvaluationCode := fn(code: String): String { "((void)(" + code + "), 0)" }

/** Encodes the inert Unit value for C expression evaluation. */
pub unitLiteralCode := fn(): String { "0" }

/** Formats a checked Bool value as a C `stdbool.h` literal. */
pub boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Rejects the ordinary list value copy this backend does not implement; list values are unsupported in C. */
pub listCopyCode := fn(code: String): String {
    diagLib.fail("", "C backend does not support list values yet");
    code
}

/** Emits a checked UTF-8 byte concatenation call; the bootstrap C backend intentionally leaks each result. */
pub concatCode := fn(left: String, right: String): String {
    "lite_concat(" + left + ", " + right + ")"
}

/** Emits a C logical negation around one Bool expression. */
pub notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a C short-circuit `and`/`or` expression around two Bool expressions. */
pub logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware C comparison; String equality uses `strcmp` and not-less/not-more spellings invert the ordering. */
pub comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    if kind == "String" {
        if op == "==" { "strcmp(" + left + ", " + right + ") == 0" }
        else { "strcmp(" + left + ", " + right + ") != 0" }
    } else {
        operator := if op == "==" { "==" }
            else if op == "=!=" { "!=" }
            else if op == "<" { "<" }
            else if op == "<!" { ">=" }
            else if op == "<=" { "<=" }
            else if op == "<!=" { ">" }
            else if op == ">" { ">" }
            else if op == ">!" { "<=" }
            else if op == ">=" { ">=" }
            else { "<" };
        "(" + left + ") " + operator + " (" + right + ")"
    }
}

/** Converts an Int* operand only at a mixed Float operation, retaining original values for later comparison-chain pairs. */
pub floatOperandCode := fn(kind: String, code: String): String {
    if numeric.isIntKind(kind) { "((double)(" + code + "))" } else { code }
}

/** Converts an Int* or Float operand into a binary32 value (held as double) when targeting Float32. */
pub float32OperandCode := fn(kind: String, code: String): String {
    if numeric.isIntKind(kind) or kind == "Float" { "((double)((float)(" + code + ")))" } else { code }
}

/** Emits one numeric comparison using the pair's common family. */
comparisonPairCode := fn(op: String, leftKind: String, rightKind: String, left: String, right: String): String {
    if numeric.isFloatKind(leftKind) or numeric.isFloatKind(rightKind) {
        comparisonCode(op, "Float", floatOperandCode(leftKind, left), floatOperandCode(rightKind, right))
    } else { comparisonCode(op, leftKind, left, right) }
}

/** Encodes the arithmetic operator tag expected by runtime float helpers. */
floatOpTag := fn(op: String): String {
    if op == "+" { "0" } else if op == "-" { "1" } else if op == "*" { "2" } else { "3" }
}

/** Sequences operands into binary64 temporaries before the checked operation. */
floatBinaryCall := fn(helper: String, op: String, left: String, right: String, position: Int): String {
    id := integer.intText(position);
    "(lt_arg_f_left_" + id + " = " + left + ", lt_arg_f_right_" + id + " = " + right + ", " + helper + "(lt_arg_f_left_" + id + ", lt_arg_f_right_" + id + ", " + floatOpTag(op) + ", " + id + "))"
}

/** Sequences operands into binary64 temporaries before the checked binary64 operation. */
pub floatBinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float_op", op, left, right, position)
}

/** Sequences operands into temporaries before the checked binary32 operation. */
pub float32BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    floatBinaryCall("lt_float32_op", op, left, right, position)
}

/** Sequences both operands before the selected Float-default power checkpoint. */
pub floatPowerCode := fn(left: String, right: String, position: Int): String {
    id := integer.intText(position);
    "(lt_arg_f_left_" + id + " = " + left + ", lt_arg_f_right_" + id + " = " + right + ", lt_float_power(lt_arg_f_left_" + id + ", lt_arg_f_right_" + id + ", " + id + "))"
}

/** Emits an int64_t floor-division expression. */
pub floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? 1 : 0))"
}

/** Emits an int64_t floor-modulo expression. */
pub floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? " + right + " : 0))"
}

/** Emits a positioned Int helper call with operands evaluated once, from left to right. */
intBinaryCallCode := fn(name: String, left: String, right: String, position: Int): String {
    id := integer.intText(position);
    "(lt_arg_left_" + id + " = " + left + ", lt_arg_right_" + id + " = " + right + ", " + name + "(lt_arg_left_" + id + ", lt_arg_right_" + id + ", " + id + "))"
}

/** Emits a checked int64_t truncating division call. */
pub intDivideCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_divide_int", left, right, position)
}

/** Emits a checked int64_t remainder call. */
pub intRemainderCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_remainder_int", left, right, position)
}

/** Emits a checked int64_t floor-division call. */
pub intFloorDivideCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_floor_divide_int", left, right, position)
}

/** Emits a checked int64_t floor-modulo call. */
pub intFloorModuloCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lite_floor_modulo_int", left, right, position)
}

/** Emits checked Int64 addition, evaluating both operands once in source order. */
pub intAddCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_add", left, right, position)
}

/** Emits checked Int64 subtraction, evaluating both operands once in source order. */
pub intSubtractCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_subtract", left, right, position)
}

/** Emits checked Int64 multiplication, evaluating both operands once in source order. */
pub intMultiplyCode := fn(left: String, right: String, position: Int): String {
    intBinaryCallCode("lt_checked_multiply", left, right, position)
}

/** Emits checked Int64 negation, evaluating the operand once. */
pub intNegateCode := fn(value: String, position: Int): String {
    "lt_checked_negate(" + value + ", " + integer.intText(position) + ")"
}

/** Emits a checked signed range check for narrow integer arithmetic results. */
pub checkedNarrowIntCode := fn(kind: String, value: String, position: Int): String {
    "lt_checked_narrow_int(" + value + ", " + integer.intText(numeric.narrowIntBits(kind)) + ", " + textLiteralCode(kind) + ", " + integer.intText(position) + ")"
}

/** Names a typed, source-position-hygienic C comparison operand temporary. */
comparisonTemp := fn(kind: String, position: Int, index: Int): String {
    tag := if kind == "String" { "s" } else if kind == "Bool" { "b" } else if numeric.isFloatKind(kind) { "f" } else { "i" };
    "lt_cmp_" + tag + "_" + integer.intText(position) + "_" + integer.intText(index)
}

/** Represents Unit as zero, retaining unsupported/effectful code for C validation instead of dropping it. */
comparisonValueCode := fn(kind: String, code: String): String {
    if kind =!= "Unit" { return code; }
    var inner := code;
    loop textLib.length(inner) >= 2 and textLib.at(inner, 0) == "(" and textLib.at(inner, textLib.length(inner) - 1) == ")" {
        inner = textLib.slice(inner, 1, textLib.length(inner) - 1);
    }
    if inner == "undefined" { "0" } else { "(" + code + ", 0)" }
}

/** Emits portable comma/short-circuit sequencing so middle operands are evaluated once and later operands stay lazy. */
pub comparisonChainCode := fn(codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String {
    first := comparisonTemp(kinds[0], position, 0);
    second := comparisonTemp(kinds[1], position, 1);
    var result := "(" + first + " = " + comparisonValueCode(kinds[0], codes[0]) + ", " + second + " = " + comparisonValueCode(kinds[1], codes[1]) + ", " + comparisonPairCode(operators[0], kinds[0], kinds[1], first, second);
    var index := 2;
    loop index <= count {
        name := comparisonTemp(kinds[index], position, index);
        pair := comparisonPairCode(operators[index - 1], kinds[index - 1], kinds[index], comparisonTemp(kinds[index - 1], position, index - 1), name);
        result += " && (" + name + " = " + comparisonValueCode(kinds[index], codes[index]) + ", " + pair + ")";
        index += 1;
    }
    result + ")"
}
