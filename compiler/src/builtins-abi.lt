/** Core and external host module ABI tables, soft-builtin signatures, and `--builtin-mode` spec resolution. */

diagLib := import "core/diag";
ir := import "./frontend-ir";
types := import "./frontend-types";

/** One parsed item entry matching `frontend-ir.Item`. */
Item := alias (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := alias List<Item>;

/** True when `moduleIdentity` is a verified `lite.core.*`, `lite.external.*`, or `lite.extra.*` host module identity. */
pub isHostModuleIdentity := fn(moduleIdentity: String): Bool {
    moduleIdentity.startsWithAt(0, "lite.core.") or
    moduleIdentity.startsWithAt(0, "lite.external.") or
    moduleIdentity.startsWithAt(0, "lite.extra.")
};

/** Normalizes one canonical parameter/result kind for host ABI matching by unwrapping nominal `distinct` wrappers to `Name@BaseKind`. */
normalizeHostAbiKind := fn(kind: String): String {
    if types.isDistinctKind(kind) {
        return types.distinctDisplayName(kind) + "@" + types.distinctBaseKind(kind);
    }
    kind
};

/** Normalizes pipe-separated `name=kind` host ABI parameters with `normalizeHostAbiKind`. */
normalizeHostAbiParams := fn(rawParams: String): String {
    if rawParams == "" or rawParams == "...values" { return rawParams; }
    parts: mut List<String> = [];
    size := rawParams.length();
    var depth := 0;
    var start := 0;
    loop 0..size as i {
        ch := rawParams.at(i);
        if ch == "<" or ch == "(" or ch == "[" {
            depth += 1;
        } else if ch == ">" or ch == ")" or ch == "]" {
            depth -= 1;
        } else if ch == "|" and depth == 0 {
            mut parts.pushBack(rawParams.slice(start, i));
            start = i + 1;
        }
    }
    mut parts.pushBack(rawParams.slice(start, size));
    out: mut List<String> = [];
    loop parts as part {
        eq := part.indexOf("=", 0);
        if eq > 0 {
            pName := part.slice(0, eq);
            pKind := part.slice(eq + 1, part.length());
            mut out.pushBack(pName + "=" + normalizeHostAbiKind(pKind));
        } else {
            mut out.pushBack(part);
        }
    }
    out.join("|")
};

/** Resolves a bodyless `lib/extra/` declaration when its module identity and ABI match. */
extraHostFunction := fn(moduleIdentity: String, name: String, rawParams: String, rawResult: String): String {
    if moduleIdentity == "lite.extra.surface.v1" {
        params := normalizeHostAbiParams(rawParams);
        result := normalizeHostAbiKind(rawResult);
        pt := "(x:Float,y:Float)";
        rc := "(x:Float,y:Float,width:Float,height:Float)";
        inp := "(open:Bool,width:Int,height:Int,pointerX:Float,pointerY:Float,pointerDown:Bool,key:String,deltaMs:Int)";
        dSurf := "Surface@(handle:Int)";
        dTex := "Texture@(handle:Int,width:Int,height:Int)";
        dCol := "Color@(r:Float,g:Float,b:Float,a:Float)";
        if name == "Surface.open" and params == "title=String|width=Int|height=Int" and result == dSurf { "lite$extraCanvasOpen" }
        else if name == "Surface.poll" and params == "surface=" + dSurf and result == inp { "lite$extraCanvasPoll" }
        else if name == "Surface.present" and params == "surface=" + dSurf and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasPresent" }
        else if name == "Surface.close" and params == "surface=" + dSurf and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasClose" }
        else if name == "Surface.run" and params == "surface=" + dSurf + "|onFrame=fn(:" + inp + "):Bool" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasRun" }
        else if name == "Surface.clear" and params == "surface=" + dSurf + "|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasClear" }
        else if name == "Surface.fillRect" and params == "surface=" + dSurf + "|area=" + rc + "|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasFillRect" }
        else if name == "Surface.strokeRect" and params == "surface=" + dSurf + "|area=" + rc + "|lineWidth=Float|stroke=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasStrokeRect" }
        else if name == "Surface.fillCircle" and params == "surface=" + dSurf + "|center=" + pt + "|radius=Float|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasFillCircle" }
        else if name == "Surface.strokeLine" and params == "surface=" + dSurf + "|start=" + pt + "|finish=" + pt + "|lineWidth=Float|stroke=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasStrokeLine" }
        else if name == "Surface.drawText" and params == "surface=" + dSurf + "|content=String|at=" + pt + "|size=Float|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasDrawText" }
        else if name == "Surface.capture" and params == "surface=" + dSurf + "|outPath=String" and result == "(ok:Bool,error:String)" { "lite$extraCanvasCapture" }
        else if name == "Surface.setTargetFps" and params == "surface=" + dSurf + "|fps=Float" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasSetTargetFps" }
        else if name == "Surface.vitals" and params == "surface=" + dSurf and result == "(frameCount:Int,frameTimeMs:Float,avgFrameTimeMs:Float,fps:Float,targetFps:Float,cpuTimeMs:Float,memoryBytes:Int)" { "lite$extraCanvasVitals" }
        else if name == "Surface.playTone" and params == "surface=" + dSurf + "|frequency=Int|durationMs=Int|volume=Int" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasPlayTone" }
        else if name == "Surface.bounds" and params == "surface=" + dSurf and result == "(x:Int,y:Int,width:Int,height:Int,fullscreen:Bool)" { "lite$extraCanvasBounds" }
        else if name == "Surface.resize" and params == "surface=" + dSurf + "|width=Int|height=Int" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasResize" }
        else if name == "Surface.setFullscreen" and params == "surface=" + dSurf + "|enabled=Bool" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasSetFullscreen" }
        else if name == "Surface.isKeyDown" and params == "surface=" + dSurf + "|key=String" and result == ir.VALUE_KIND_BOOL { "lite$extraCanvasIsKeyDown" }
        else if name == "Surface.isKeyPressed" and params == "surface=" + dSurf + "|key=String" and result == ir.VALUE_KIND_BOOL { "lite$extraCanvasIsKeyPressed" }
        else if name == "Surface.isKeyReleased" and params == "surface=" + dSurf + "|key=String" and result == ir.VALUE_KIND_BOOL { "lite$extraCanvasIsKeyReleased" }
        else if name == "Surface.isPointerPressed" and params == "surface=" + dSurf and result == ir.VALUE_KIND_BOOL { "lite$extraCanvasIsPointerPressed" }
        else if name == "Surface.isPointerReleased" and params == "surface=" + dSurf and result == ir.VALUE_KIND_BOOL { "lite$extraCanvasIsPointerReleased" }
        else if name == "Surface.wheelDelta" and params == "surface=" + dSurf and result == ir.VALUE_KIND_FLOAT { "lite$extraCanvasWheelDelta" }
        else if name == "Surface.setClipRect" and params == "surface=" + dSurf + "|area=" + rc and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasSetClipRect" }
        else if name == "Surface.clearClipRect" and params == "surface=" + dSurf and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasClearClipRect" }
        else if name == "Surface.fillTriangle" and params == "surface=" + dSurf + "|a=" + pt + "|b=" + pt + "|c=" + pt + "|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasFillTriangle" }
        else if name == "Texture.create" and params == "width=Int|height=Int" and result == dTex { "lite$extraCanvasCreateTexture" }
        else if name == "Texture.setPixel" and params == "tex=" + dTex + "|x=Int|y=Int|fill=" + dCol and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasSetTexturePixel" }
        else if name == "Surface.blit" and params == "surface=" + dSurf + "|tex=" + dTex + "|at=" + pt and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasBlit" }
        else if name == "Surface.blitScaled" and params == "surface=" + dSurf + "|tex=" + dTex + "|dest=" + rc and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasBlitScaled" }
        else if name == "Texture.destroy" and params == "tex=" + dTex and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasDestroyTexture" }
        else if name == "scratchMark" and params == "" and result == ir.VALUE_KIND_INT { "lite$extraCanvasScratchMark" }
        else if name == "scratchRewind" and params == "mark=Int" and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasScratchRewind" }
        else { "" }
    } else {
        ""
    }
};

/** Resolves a bodyless external host declaration only when its `lib/external/` module identity and ABI match. */
externalHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.external.ts.v1" {
        if name == "stripTypes" and params == "source=String" and result == "(ok:Bool,code:String,error:String)" {
            "lite$extTsStripTypes"
        } else { "" }
    } else if moduleIdentity == "lite.external.http.v1" {
        if name == "fetchToFile" and params == "url=String|outPath=String|timeoutMs=Int|headers=List<String>" and
        result == "(ok:Bool,status:Int,byteCount:Int,retryAfter:String,error:String)" {
            "lite$extHttpFetchToFile"
        } else if name == "serveStatic" and params == "siteDir=String|brandDir=String|host=String|port=Int" and
        result == ir.VALUE_KIND_INT {
            "lite$extHttpServeStatic"
        } else { "" }
    } else if moduleIdentity == "lite.external.bench.v1" {
        if name == "measureCompilerArtifact" and
        params == "engine=String|artifactPath=String|sourceName=String|rootPath=String|metricsFile=String" and
        result == ir.VALUE_KIND_INT {
            "lite$extBenchMeasureCompiler"
        } else { "" }
    } else if moduleIdentity == "lite.external.pool.v1" {
        if name == "cpuCount" and params == "" and result == ir.VALUE_KIND_INT {
            "lite$extPoolCpuCount"
        } else if name == "runPoolJson" and
        params == "commands=List<String>|argListsJson=List<String>|cwd=String|maxJobs=Int" and
        result == ir.VALUE_KIND_STRING {
            "lite$extPoolRunJson"
        } else { "" }
    } else {
        ""
    }
};

/** Resolves a bodyless public core or external declaration only when its module identity and complete ABI are registered. */
pub coreHostFunction := fn(moduleIdentity: String, name: String, rawParams: String, rawResult: String): String {
    params := normalizeHostAbiParams(rawParams);
    result := normalizeHostAbiKind(rawResult);
    if moduleIdentity.startsWithAt(0, "lite.external.") {
        return externalHostFunction(moduleIdentity, name, params, result);
    }
    if moduleIdentity.startsWithAt(0, "lite.extra.") {
        return extraHostFunction(moduleIdentity, name, params, result);
    }
    if moduleIdentity == "lite.core.io.v1" {
        rd := "Reader@(kind:String,handle:Int)";
        wr := "Writer@(kind:String,handle:Int)";
        if params == "...values" and result == ir.VALUE_KIND_UNIT {
            if name == "output" { "lite$core$io$output:v1" }
            else if name == "outputLine" { "lite$core$io$outputLine:v1" }
            else { "" }
        } else if name == "errorLine" and params == "text=String" and result == ir.VALUE_KIND_UNIT { "lite$reportError" }
        else if name == "exit" and params == "status=Int" and result == ir.VALUE_KIND_UNIT { "lite$exit" }
        else if name == "inputArgs" and params == "" and result == "List<String>" { "lite$inputArgs" }
        else if params == "prompt=String" and result == ir.VALUE_KIND_STRING {
            if name == "inputAll" { "lite$inputAll" } else if name == "inputLine" { "lite$inputLine" } else { "" }
        } else if params == "prompt=String" and result == ir.VALUE_KIND_INT and name == "inputInt" { "lite$inputInt" }
        else if params == "prompt=String" and result == ir.VALUE_KIND_FLOAT and name == "inputFloat" { "lite$inputFloat" }
        else if name == "Reader.stdin" and params == "" and result == rd { "lite$ioStdinReader" }
        else if name == "Writer.stdout" and params == "" and result == wr { "lite$ioStdoutWriter" }
        else if name == "Writer.stderr" and params == "" and result == wr { "lite$ioStderrWriter" }
        else if name == "Reader.fromBytes" and params == "bytes=List<Int>" and result == rd { "lite$ioBufferReader" }
        else if name == "Writer.buffer" and params == "" and result == wr { "lite$ioBufferWriter" }
        else if name == "Writer.bytes" and params == "writer=" + wr and result == "List<Int>" { "lite$ioWriterBytes" }
        else if name == "Writer.text" and params == "writer=" + wr and result == "(ok:Bool,text:String,error:String)" { "lite$ioWriterText" }
        else if name == "Writer.clear" and params == "writer=" + wr and result == ir.VALUE_KIND_UNIT { "lite$ioClearWriter" }
        else if name == "Reader.ok" and params == "reader=" + rd and result == ir.VALUE_KIND_BOOL { "lite$ioReaderOk" }
        else if name == "Reader.atEof" and params == "reader=" + rd and result == ir.VALUE_KIND_BOOL { "lite$ioReaderAtEof" }
        else if name == "Reader.error" and params == "reader=" + rd and result == ir.VALUE_KIND_STRING { "lite$ioReaderError" }
        else if name == "Reader.read" and params == "reader=" + rd + "|maxBytes=Int" and result == "List<Int>" { "lite$ioRead" }
        else if name == "Reader.close" and params == "reader=" + rd and result == "(ok:Bool,error:String)" { "lite$ioCloseReader" }
        else if name == "Writer.ok" and params == "writer=" + wr and result == ir.VALUE_KIND_BOOL { "lite$ioWriterOk" }
        else if name == "Writer.error" and params == "writer=" + wr and result == ir.VALUE_KIND_STRING { "lite$ioWriterError" }
        else if name == "Writer.write" and params == "writer=" + wr + "|bytes=List<Int>" and result == "(ok:Bool,written:Int,error:String)" { "lite$ioWrite" }
        else if name == "Writer.flush" and params == "writer=" + wr and result == "(ok:Bool,error:String)" { "lite$ioFlush" }
        else if name == "Writer.close" and params == "writer=" + wr and result == "(ok:Bool,error:String)" { "lite$ioCloseWriter" }
        else { "" }
    } else if moduleIdentity == "lite.core.text.v1" {
        if name == "String.length" and params == "text=String" and result == ir.VALUE_KIND_INT { "lite$textLength" }
        else if name == "String.at" and params == "text=String|position=Int" and result == ir.VALUE_KIND_STRING { "lite$textAt" }
        else if name == "String.slice" and params == "text=String|start=Int|end=Int" and result == ir.VALUE_KIND_STRING { "lite$textSlice" }
        else if name == "String.toCodePoints" and params == "text=String" and result == "List<Int>" { "lite$unicodeToCodePoints" }
        else if name == "String.fromCodePoints" and params == "points=List<Int>" and result == "(ok:Bool,text:String,error:String)" { "lite$unicodeFromCodePoints" }
        else { "" }
    } else if moduleIdentity == "lite.core.list.v1" {
        if name == "List.pushBack" and params == "values=mut List<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$pushBack:v1" }
        else if name == "List.popBack" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popBack:v1" }
        else if name == "List.pushFront" and params == "values=mut List<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$pushFront:v1" }
        else if name == "List.popFront" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popFront:v1" }
        else if name == "List.length" and params == "values=List<T>" and result == ir.VALUE_KIND_INT { "lite$core$list$length:v1" }
        else if (name == "List.setAt" or name == "List.$setIndex") and params == "values=mut List<T>|index=Int|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$setAt:v1" }
        else if name == "List.$getIndex" and params == "values=List<T>|index=Int" and result == "T" { "lite$core$list$getIndex:v1" }
        else if name == "List.slice" and params == "values=List<T>|start=Int|end=Int" and result == "List<T>" { "lite$core$list$slice:v1" }
        else if name == "List.reverse" and params == "values=List<T>" and result == "List<T>" { "lite$core$list$reverse:v1" }
        else if name == "List.clear" and params == "values=mut List<T>" and result == ir.VALUE_KIND_UNIT { "lite$core$list$clear:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.array.v1" {
        if name == "Array.length" and params == "values=[T;N]" and result == ir.VALUE_KIND_INT { "lite$core$array$length:v1" }
        else if name == "Array.$getIndex" and params == "values=[T;N]|index=Int" and result == "T" { "lite$core$array$getIndex:v1" }
        else if name == "Array.$setIndex" and params == "values=mut [T;N]|index=Int|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$array$setIndex:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.map.v1" {
        if (name == "Map.set" or name == "Map.$setIndex") and params == "entries=mut Map<K,V>|key=K|value=V" and result == ir.VALUE_KIND_UNIT { "lite$core$map$set:v1" }
        else if name == "Map.$getIndex" and params == "entries=Map<K,V>|key=K" and result == "V" { "lite$core$map$getIndex:v1" }
        else if name == "Map.get" and params == "entries=Map<K,V>|key=K" and result == "(found:Bool,value:V)" { "lite$core$map$get:v1" }
        else if name == "Map.getOr" and params == "entries=Map<K,V>|key=K|fallback=V" and result == "V" { "lite$core$map$getOr:v1" }
        else if name == "Map.has" and params == "entries=Map<K,V>|key=K" and result == ir.VALUE_KIND_BOOL { "lite$core$map$has:v1" }
        else if name == "Map.remove" and params == "entries=mut Map<K,V>|key=K" and result == ir.VALUE_KIND_BOOL { "lite$core$map$remove:v1" }
        else if name == "Map.size" and params == "entries=Map<K,V>" and result == ir.VALUE_KIND_INT { "lite$core$map$size:v1" }
        else if name == "Map.clear" and params == "entries=mut Map<K,V>" and result == ir.VALUE_KIND_UNIT { "lite$core$map$clear:v1" }
        else if name == "Map.keys" and params == "entries=Map<K,V>" and result == "List<K>" { "lite$core$map$keys:v1" }
        else if name == "Map.values" and params == "entries=Map<K,V>" and result == "List<V>" { "lite$core$map$values:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.set.v1" {
        if name == "Set.add" and params == "s=mut Set<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$set$add:v1" }
        else if name == "Set.has" and params == "s=Set<T>|value=T" and result == ir.VALUE_KIND_BOOL { "lite$core$set$has:v1" }
        else if name == "Set.remove" and params == "s=mut Set<T>|value=T" and result == ir.VALUE_KIND_BOOL { "lite$core$set$remove:v1" }
        else if name == "Set.size" and params == "s=Set<T>" and result == ir.VALUE_KIND_INT { "lite$core$set$size:v1" }
        else if name == "Set.clear" and params == "s=mut Set<T>" and result == ir.VALUE_KIND_UNIT { "lite$core$set$clear:v1" }
        else if name == "Set.values" and params == "s=Set<T>" and result == "List<T>" { "lite$core$set$values:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.file.v1" {
        if name == "kind" and params == "path=String" and result == ir.VALUE_KIND_STRING { "lite$fileKind" }
        else if name == "openReader" and params == "path=String" and result == "Reader@(kind:String,handle:Int)" { "lite$fileOpenReader" }
        else if name == "openWriter" and params == "path=String" and result == "Writer@(kind:String,handle:Int)" { "lite$fileOpenWriter" }
        else if name == "openAppender" and params == "path=String" and result == "Writer@(kind:String,handle:Int)" { "lite$fileOpenAppender" }
        else if name == "listDir" and params == "path=String" and result == "List<String>" { "lite$fileListDir" }
        else if name == "makeDir" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileMakeDir" }
        else if name == "remove" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileRemove" }
        else if name == "copy" and params == "fromPath=String|toPath=String" and result == "(ok:Bool,error:String)" { "lite$fileCopy" }
        else if name == "symlink" and params == "targetPath=String|linkPath=String" and result == "(ok:Bool,error:String)" { "lite$fileSymlink" }
        else if name == "realPath" and params == "path=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileRealPath" }
        else if name == "makeTempDir" and params == "prefix=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileMakeTempDir" }
        else { "" }
    } else if moduleIdentity == "lite.core.process.v1" {
        if name == "cwd" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processCwd" }
        else if name == "execPath" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processExecPath" }
        else if name == "entryPath" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processEntryPath" }
        else if name == "platform" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processPlatform" }
        else if name == "arch" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processArch" }
        else if name == "runtimeVersion" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processRuntimeVersion" }
        else if name == "envGet" and params == "name=String" and result == "(found:Bool,value:String)" { "lite$processEnvGet" }
        else if name == "run" and params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|capture=Bool|stdinText=String" and
        result == "(status:Int,stdout:String,stderr:String,error:String)" { "lite$processRun" }
        else if name == "runBytes" and
        params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|timeoutMs=Int|stdinBytes=List<Int>|stdoutPath=String|stderrPath=String" and
        result == "(status:Int,error:String)" { "lite$processRunBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.crypto.v1" {
        if name == "randomBytes" and params == "count=Int" and result == "List<Int>" { "lite$cryptoRandomBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.time.v1" {
        if name == "monotonicNs" and params == "" and result == ir.VALUE_KIND_INT { "lite$timeMonotonicNs" }
        else if name == "epochNs" and params == "" and result == ir.VALUE_KIND_INT { "lite$timeEpochNs" }
        else if name == "sleepMs" and params == "ms=Int" and result == ir.VALUE_KIND_UNIT { "lite$timeSleepMs" }
        else if name == "localDate" and params == "" and result == ir.VALUE_KIND_STRING { "lite$timeLocalDate" }
        else { "" }
    } else {
        ""
    }
};

/** Maps a verified host core module identity to its soft-builtin logical path, or `""` outside soft-builtin stdlib modules. */
softBuiltinModuleForIdentity := fn(moduleIdentity: String): String {
    match {
        moduleIdentity == "lite.core.crypto.v1" { "lib/core/crypto" }
        moduleIdentity == "lite.core.file.v1" { "lib/core/file" }
        moduleIdentity == "lite.core.int.v1" { "lib/core/int" }
        moduleIdentity == "lite.core.list.v1" { "lib/core/list" }
        moduleIdentity == "lite.core.text.v1" { "lib/core/text" }
        moduleIdentity == "lite.core.io.v1" { "lib/core/io" }
        _ { "" }
    }
};

/** True when `moduleName` is a canonical core stdlib path with soft-builtin support. */
isSoftBuiltinModule := fn(moduleName: String): Bool {
    moduleName == "lib/core/crypto" or moduleName == "lib/core/file" or moduleName == "lib/core/int" or
    moduleName == "lib/core/list" or moduleName == "lib/core/text" or moduleName == "lib/core/io"
};

/** Returns the expected `(params, result)` ABI for a registered soft-builtin function, or empty fields when absent. */
softBuiltinAbi := fn(moduleName: String, name: String): (params: String, result: String) {
    if moduleName == "lib/core/crypto" {
        if name == "sha256Bytes" or name == "sha512Bytes" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "sha256Text" or name == "sha512Text" {
            return (params = "value=String", result = ir.VALUE_KIND_STRING);
        }
        if name == "sha256File" {
            return (params = "path=String", result = "(ok:Bool,hex:String,error:String)");
        }
        if name == "hmacSha256Bytes" {
            return (params = "key=List<Int>|data=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "isValidBase64" or name == "isValidHex" {
            return (params = "encoded=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "base64Encode" or name == "hexEncode" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "base64Decode" or name == "hexDecode" {
            return (params = "encoded=String", result = "List<Int>");
        }
    } else if moduleName == "lib/core/file" {
        if name == "readBytes" {
            return (params = "path=String", result = "List<Int>");
        }
        if name == "readText" {
            return (params = "path=String", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "writeBytes" or name == "appendBytes" {
            return (params = "path=String|bytes=List<Int>", result = "(ok:Bool,error:String)");
        }
        if name == "writeText" or name == "appendText" {
            return (params = "path=String|text=String", result = "(ok:Bool,error:String)");
        }
    } else if moduleName == "lib/core/int" {
        if name == "Int.toText" {
            return (params = "value=Int", result = ir.VALUE_KIND_STRING);
        }
    } else if moduleName == "lib/core/list" {
        if name == "List.join" {
            return (params = "values=List<String>|separator=String", result = ir.VALUE_KIND_STRING);
        }
    } else if moduleName == "lib/core/text" {
        if name == "String.skipSpaces" or name == "String.skipName" {
            return (params = "source=String|start=Int", result = ir.VALUE_KIND_INT);
        }
        if name == "String.indexOf" {
            return (params = "source=String|needle=String|start=Int", result = ir.VALUE_KIND_INT);
        }
        if name == "String.startsWithAt" {
            return (params = "source=String|position=Int|text=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.wordAt" {
            return (params = "source=String|position=Int|word=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.toInt" {
            return (params = "text=String", result = "(value:Int,ok:Bool)");
        }
        if name == "String.trimStart" or name == "String.trimEnd" or name == "String.trim" or name == "String.toLowerAscii" {
            return (params = "source=String", result = ir.VALUE_KIND_STRING);
        }
        if name == "String.endsWith" {
            return (params = "source=String|suffix=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.repeat" {
            return (params = "value=String|count=Int", result = ir.VALUE_KIND_STRING);
        }
        if name == "String.contains" {
            return (params = "source=String|needle=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.isDigit" {
            return (params = "text=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.isAsciiLetter" or name == "String.isNameStart" or name == "String.isNameContinue" or name == "String.isWhitespace" {
            return (params = "ch=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "String.utf8Encode" {
            return (params = "text=String", result = "List<Int>");
        }
        if name == "String.fromUtf8Strict" {
            return (params = "bytes=List<Int>", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "String.fromUtf8Lossy" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
    } else if moduleName == "lib/core/io" {
        if name == "Reader.fromText" {
            return (params = "text=String", result = "Reader@(kind:String,handle:Int)");
        }
        if name == "Reader.readAll" {
            return (params = "reader=Reader@(kind:String,handle:Int)", result = "List<Int>");
        }
        if name == "Reader.readAllText" {
            return (params = "reader=Reader@(kind:String,handle:Int)", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "Reader.readLine" {
            return (params = "reader=Reader@(kind:String,handle:Int)", result = "(ok:Bool,line:String,eof:Bool,error:String)");
        }
        if name == "Writer.writeText" or name == "Writer.writeLine" {
            return (params = "writer=Writer@(kind:String,handle:Int)|text=String", result = "(ok:Bool,error:String)");
        }
    }
    (params = "", result = "")
};

/** Returns the verified soft-builtin module path when `moduleIdentity`, `name`, `params`, and `result` match, else `""`. */
pub coreSoftBuiltin := fn(moduleIdentity: String, name: String, rawParams: String, rawResult: String): String {
    modName := softBuiltinModuleForIdentity(moduleIdentity);
    if modName == "" { return ""; }
    abi := softBuiltinAbi(modName, name);
    params := normalizeHostAbiParams(rawParams);
    result := normalizeHostAbiKind(rawResult);
    if abi.result =!= "" and abi.params == params and abi.result == result {
        return modName;
    }
    ""
};

/** Maps one registered output intrinsic identity to its source special-statement name. */
pub coreOutputName := fn(runtime: String): String {
    match {
        runtime == "lite$core$io$output:v1" { "output" }
        runtime == "lite$core$io$outputLine:v1" { "outputLine" }
        _ { "" }
    }
};

/** Normalizes and validates a canonical soft-builtin core module path (`core/<name>` or `lib/core/<name>[.lts]`), returning `""` outside stdlib bounds. */
normalizeBuiltinModule := fn(raw: String): String {
    if raw == "" { return ""; }
    if raw.indexOf("\\", 0) >= 0 or raw.indexOf(":", 0) >= 0 {
        return "";
    }
    if raw.startsWithAt(0, "/") or raw.indexOf("//", 0) >= 0 {
        return "";
    }
    rawLen := raw.length();
    if raw.at(rawLen - 1) == "/" { return ""; }
    var out := raw;
    if rawLen > 4 and raw.startsWithAt(rawLen - 4, ".lts") {
        out = raw.slice(0, rawLen - 4);
    } else if rawLen > 3 and raw.startsWithAt(rawLen - 3, ".lt") {
        out = raw.slice(0, rawLen - 3);
    }
    if out.indexOf(".", 0) >= 0 { return ""; }
    if out.startsWithAt(0, "core/") {
        out = "lib/" + out;
    }
    if not out.startsWithAt(0, "lib/core/") { return ""; }
    if not isSoftBuiltinModule(out) { return ""; }
    out
};

/** Parses one `--builtin-mode` spec (`pure`, `builtin`, `module=mode`, `module.fn=mode`). */
parseBuiltinModeSpec := fn(prefix: String, spec: String): Item {
    if spec == ir.BUILTIN_MODE_BUILTIN or spec == ir.BUILTIN_MODE_PURE {
        return (kind = ir.BUILTIN_RULE_PROJECT, name = "", runtime = spec, code = "", intValue = 0, textValue = "");
    }
    eq := spec.indexOf("=", 0);
    if eq <= 0 {
        diagLib.fail(prefix, "invalid --builtin-mode specification: " + spec);
    }
    target := spec.slice(0, eq);
    mode := spec.slice(eq + 1, spec.length());
    if mode =!= ir.BUILTIN_MODE_BUILTIN and mode =!= ir.BUILTIN_MODE_PURE {
        diagLib.fail(prefix, "invalid --builtin-mode value: " + mode);
    }
    tLen := target.length();
    colon := target.indexOf(":", 0);
    if colon > 0 and colon + 1 < tLen {
        modPart := target.slice(0, colon);
        fnPart := target.slice(colon + 1, tLen);
        normMod := normalizeBuiltinModule(modPart);
        if normMod =!= "" and softBuiltinAbi(normMod, fnPart).result =!= "" {
            return (kind = ir.BUILTIN_RULE_FN, name = normMod + "." + fnPart, runtime = mode,
            code = "", intValue = 0, textValue = "");
        }
        diagLib.fail(prefix, "invalid --builtin-mode function target: " + target);
    }
    isLtsFile := (tLen > 4 and target.startsWithAt(tLen - 4, ".lts")) or (tLen > 3 and target.startsWithAt(tLen - 3, ".lt"));
    var lastDot := -1;
    var scan := 0;
    loop true {
        found := target.indexOf(".", scan);
        if found < 0 { break; }
        lastDot = found;
        scan = found + 1;
    }
    if not isLtsFile and lastDot > 0 and target.indexOf("/", lastDot + 1) < 0 {
        modPart := target.slice(0, lastDot);
        fnPart := target.slice(lastDot + 1, tLen);
        if modPart.indexOf(".", 0) < 0 and fnPart =!= "" {
            normMod := normalizeBuiltinModule(modPart);
            if normMod =!= "" and softBuiltinAbi(normMod, fnPart).result =!= "" {
                return (kind = ir.BUILTIN_RULE_FN, name = normMod + "." + fnPart, runtime = mode,
                code = "", intValue = 0, textValue = "");
            }
        }
        diagLib.fail(prefix, "invalid --builtin-mode function target: " + target);
    }
    normMod := normalizeBuiltinModule(target);
    if normMod == "" {
        diagLib.fail(prefix, "invalid --builtin-mode module target: " + target);
    }
    (kind = ir.BUILTIN_RULE_MODULE, name = normMod, runtime = mode, code = "", intValue = 0, textValue = "")
};

/** Parses `--builtin-mode` specification strings passed down from the compiler entrypoint. */
pub parseBuiltinModeSpecs := fn(prefix: String, specs: List<String>): Items {
    rules: mut Items = [];
    loop specs as spec {
        mut rules.pushBack(parseBuiltinModeSpec(prefix, spec));
    }
    rules
};

/** Resolves effective builtin mode (`builtin` or `pure`) by precedence: function > module > project > default builtin. */
pub resolveBuiltinMode := fn(rules: Items, moduleName: String, fnName: String): String {
    var mode := ir.BUILTIN_MODE_BUILTIN;
    var precedence := 0;
    fnTarget := if moduleName == "" { "" } else { moduleName + "." + fnName };
    loop rules as rule {
        if rule.kind == ir.BUILTIN_RULE_PROJECT and precedence <= 1 {
            mode = rule.runtime;
            precedence = 1;
        } else if rule.kind == ir.BUILTIN_RULE_MODULE and rule.name == moduleName and precedence <= 2 {
            mode = rule.runtime;
            precedence = 2;
        } else if rule.kind == ir.BUILTIN_RULE_FN and fnTarget =!= "" and rule.name == fnTarget and precedence <= 3 {
            mode = rule.runtime;
            precedence = 3;
        }
    }
    mode
};
