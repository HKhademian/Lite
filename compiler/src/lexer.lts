/* Lite-written lexer for the bootstrap source subset. Declaration-only. */


/** One lexical token: kind, decoded text, source offset and 1-based line/column. */
Token := type (kind: String, text: String, offset: Int, line: Int, column: Int);

/** Tokens in source order, ending with one EOF token. */
Tokens := type List<Token>;

/* Token-kind spellings. Lite has no enum and top-level values cannot be
   captured by functions yet, so these are zero-argument accessors. */
/** Canonical token kind for ordinary names. */
TOKEN_KIND_NAME := fn(): String { "Name" }

/** Canonical token kind for keywords other than Bool literals. */
TOKEN_KIND_KEYWORD := fn(): String { "Keyword" }

/** Canonical token kind for Int literals. */
TOKEN_KIND_INT := fn(): String { "Int" }

/** Canonical token kind for String literals. */
TOKEN_KIND_STRING := fn(): String { "String" }

/** Canonical token kind for Bool literals. */
TOKEN_KIND_BOOL := fn(): String { "Bool" }

/** Canonical token kind for symbols and operators. */
TOKEN_KIND_SYMBOL := fn(): String { "Symbol" }

/** Canonical token kind for end of source. */
TOKEN_KIND_EOF := fn(): String { "EOF" }

/** Reports one source-positioned lexer diagnostic and exits 2. */
lexFail := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := lineColumn(source, position);
    fail(prefix, decimalText(place.line) + ":" + decimalText(place.column) + ": " + message);
}

/** True for Lite lexical whitespace. */
isLexWhitespace := fn(ch: String): Bool {
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"
}

/** Advances line/lineStart over `start..end`, counting newlines. */
advanceLines := fn(source: String, start: Int, end: Int, line: Int, lineStart: Int): (line: Int, lineStart: Int) {
    var currentLine := line;
    var currentStart := lineStart;
    var index := start;
    loop index < end {
        if textAt(source, index) == "\n" {
            currentLine = currentLine + 1;
            currentStart = index + 1;
        }
        index = index + 1;
    }
    (line = currentLine, lineStart = currentStart)
}

/** Returns the number of `#` characters in a raw comment opener at `position`, or 0 for ordinary. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not startsWithAt(source, position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < textLength(source) and textAt(source, index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := textLength(source);
    var cursor := position + 2 + fence;
    loop cursor < size {
        if textAt(source, cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and textAt(source, runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and startsWithAt(source, runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    lexFail(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    size := textLength(source);
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop true {
        if cursor >= size {
            lexFail(source, position, prefix, "unterminated comment");
        }
        if startsWithAt(source, cursor, "/*") {
            innerFence := rawFenceLength(source, cursor);
            if innerFence > 0 {
                cursor = skipRawComment(source, cursor, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = cursor + 2;
            }
        } else if startsWithAt(source, cursor, "*/") {
            depth = depth - 1;
            cursor = cursor + 2;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Skips whitespace and comments, returning the next position and updated line state. */
skipTrivia := fn(source: String, position: Int, line: Int, lineStart: Int, prefix: String): (position: Int, line: Int, lineStart: Int) {
    size := textLength(source);
    var cursor := position;
    var currentLine := line;
    var currentStart := lineStart;
    loop cursor < size {
        ch := textAt(source, cursor);
        if isLexWhitespace(ch) {
            if ch == "\n" {
                currentLine = currentLine + 1;
                currentStart = cursor + 1;
            }
            cursor = cursor + 1;
        } else if startsWithAt(source, cursor, "/*") {
            end := skipComment(source, cursor, prefix);
            advanced := advanceLines(source, cursor, end, currentLine, currentStart);
            cursor = end;
            currentLine = advanced.line;
            currentStart = advanced.lineStart;
        } else {
            break;
        }
    }
    (position = cursor, line = currentLine, lineStart = currentStart)
}

/** True for a Lite keyword other than the Bool literals. */
isKeyword := fn(name: String): Bool {
    name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or
    name == "import" or name == "using" or name == "record" or name == "type" or
    name == "and" or name == "or" or name == "not"
}

/** True for one selected single-character symbol. */
isSingleSymbol := fn(ch: String): Bool {
    ch == "(" or ch == ")" or ch == "{" or ch == "}" or ch == "[" or ch == "]" or
    ch == "," or ch == ";" or ch == ":" or ch == "." or ch == "?" or ch == "!" or
    ch == "=" or ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" or
    ch == "<" or ch == ">" or ch == "|" or ch == "&" or ch == "@"
}

/** Reads the longest selected symbol at `position`, or empty text when none starts there. */
readSymbol := fn(source: String, position: Int): String {
    if startsWithAt(source, position, "=!=") { "=!=" }
    else if startsWithAt(source, position, "<!=") { "<!=" }
    else if startsWithAt(source, position, ">!=") { ">!=" }
    else if startsWithAt(source, position, ":/=") { ":/=" }
    else if startsWithAt(source, position, ":%=") { ":%=" }
    else if startsWithAt(source, position, "**=") { "**=" }
    else if startsWithAt(source, position, ":=") { ":=" }
    else if startsWithAt(source, position, "==") { "==" }
    else if startsWithAt(source, position, "<=") { "<=" }
    else if startsWithAt(source, position, ">=") { ">=" }
    else if startsWithAt(source, position, "<!") { "<!" }
    else if startsWithAt(source, position, ">!") { ">!" }
    else if startsWithAt(source, position, ":/") { ":/" }
    else if startsWithAt(source, position, ":%") { ":%" }
    else if startsWithAt(source, position, "+=") { "+=" }
    else if startsWithAt(source, position, "-=") { "-=" }
    else if startsWithAt(source, position, "*=") { "*=" }
    else if startsWithAt(source, position, "/=") { "/=" }
    else if startsWithAt(source, position, "%=") { "%=" }
    else if startsWithAt(source, position, "**") { "**" }
    else {
        ch := textAt(source, position);
        if isSingleSymbol(ch) { ch } else { "" }
    }
}

/** Scans one double-quoted String token, decoding n/t/r/quote/backslash escapes. */
scanString := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := textLength(source);
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= size {
            lexFail(source, position, prefix, "unterminated string literal");
        }
        ch := textAt(source, cursor);
        if ch == "\"" {
            return (text = value, next = cursor + 1);
        }
        if ch == "\\" {
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= size {
                lexFail(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := textAt(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                lexFail(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    (text = value, next = size)
}

/** Escapes one token's text for a one-line deterministic dump. */
escapedTokenText := fn(text: String): String {
    var result := "";
    var index := 0;
    loop index < textLength(text) {
        ch := textAt(text, index);
        if ch == "\\" { result = result + "\\\\"; }
        else if ch == "\n" { result = result + "\\n"; }
        else if ch == "\r" { result = result + "\\r"; }
        else if ch == "\t" { result = result + "\\t"; }
        else { result = result + ch; }
        index = index + 1;
    }
    result
}

/** Formats one token as `kind@line:column:offset text`. */
dumpToken := fn(token: Token): String {
    token.kind + "@" + decimalText(token.line) + ":" + decimalText(token.column) + ":" +
        decimalText(token.offset) + " " + escapedTokenText(token.text)
}

/** Reports every token in order, one per line. */
dumpTokens := fn(tokens: Tokens): Unit {
    loop tokens as token {
        outputLine(dumpToken(token));
    }
}

/** Tokenizes one complete source, ending with an EOF token and exiting 2 on lexical failure. */
tokenize := fn(source: String, prefix: String): Tokens {
    size := textLength(source);
    tokens: mut List<Token> = [];
    var cursor := 0;
    var line := 1;
    var lineStart := 0;
    loop true {
        trivia := skipTrivia(source, cursor, line, lineStart, prefix);
        cursor = trivia.position;
        line = trivia.line;
        lineStart = trivia.lineStart;
        if cursor >= size {
            push_back(mut tokens, (kind = TOKEN_KIND_EOF(), text = "", offset = cursor, line = line, column = cursor - lineStart + 1));
            break;
        }
        start := cursor;
        startLine := line;
        startColumn := cursor - lineStart + 1;
        ch := textAt(source, cursor);
        var kind := "";
        var value := "";
        var next := cursor;
        if isNameStart(ch) {
            next = skipName(source, cursor);
            value = textSlice(source, cursor, next);
            if value == "true" or value == "false" { kind = TOKEN_KIND_BOOL(); }
            else if isKeyword(value) { kind = TOKEN_KIND_KEYWORD(); }
            else { kind = TOKEN_KIND_NAME(); }
        } else if isDigit(ch) {
            var digitsEnd := cursor;
            loop digitsEnd < size and isDigit(textAt(source, digitsEnd)) { digitsEnd = digitsEnd + 1; }
            value = textSlice(source, cursor, digitsEnd);
            negative := textToInt("-" + value);
            if not negative.ok {
                lexFail(source, cursor, prefix, "integer literal outside signed 64-bit range");
            }
            kind = TOKEN_KIND_INT();
            next = digitsEnd;
        } else if ch == "\"" {
            scanned := scanString(source, cursor, prefix);
            kind = TOKEN_KIND_STRING();
            value = scanned.text;
            next = scanned.next;
        } else {
            symbol := readSymbol(source, cursor);
            if symbol == "" {
                lexFail(source, cursor, prefix, "unsupported symbol: " + ch);
            }
            if startsWithAt(source, cursor, "=!") and not startsWithAt(source, cursor, "=!=") {
                lexFail(source, cursor, prefix, "incomplete operator =!; use =!=");
            }
            if startsWithAt(source, cursor, "&&") {
                lexFail(source, cursor, prefix, "unsupported operator &&; use and");
            }
            if startsWithAt(source, cursor, "||") {
                lexFail(source, cursor, prefix, "unsupported operator ||; use or");
            }
            kind = TOKEN_KIND_SYMBOL();
            value = symbol;
            next = cursor + textLength(symbol);
        }
        push_back(mut tokens, (kind = kind, text = value, offset = start, line = startLine, column = startColumn));
        advanced := advanceLines(source, start, next, line, lineStart);
        line = advanced.line;
        lineStart = advanced.lineStart;
        cursor = next;
    }
    tokens
}
