/* TypeScript backend for the temporary Lite compiler. */

numeric := import "./numeric-literals";
tb := import "util/text-builder";

/** Maps a restricted Lite scalar kind to its TypeScript type. */
pub tsScalarType := fn(kind: String): String {
    if numeric.isIntKind(kind) { "bigint" }
    else if kind == numeric.KIND_STRING { "string" }
    else if numeric.isFloatKind(kind) { "number" }
    else if kind == numeric.KIND_BOOL { "boolean" }
    else { "void" }
}

/** Formats a checked Int value as a TypeScript BigInt literal. */
pub intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == 0 { "0n" }
    else if negative { "(-" + digits + "n)" }
    else { digits + "n" }
}

/** Escapes a String as a readable TypeScript double-quoted literal. */
pub textLiteralCode := fn(value: String): String {
    size := value.length();
    out: mut tb.TextBuilder;
    mut out.append("\"");
    var runStart := 0;
    var position := 0;
    loop position < size {
        ch := value.at(position);
        var esc := "";
        if ch == "\\" { esc = "\\\\"; }
        else if ch == "\"" { esc = "\\\""; }
        else if ch == "\n" { esc = "\\n"; }
        else if ch == "\r" { esc = "\\r"; }
        else if ch == "\t" { esc = "\\t"; }
        if esc =!= "" {
            if position > runStart { mut out.append(value.slice(runStart, position)); }
            mut out.append(esc);
            runStart = position + 1;
        }
        position += 1;
    }
    if runStart == 0 { return "\"" + value + "\""; }
    if runStart < size { mut out.append(value.slice(runStart, size)); }
    mut out.append("\"");
    out.build()
}

/** Formats a checked unsigned Int value as a TypeScript BigInt literal. */
pub uintLiteralCode := fn(digits: String): String {
    if digits == "0" or digits == "" { "0n" } else { digits + "n" }
}

/** Encodes a finite decimal Float token through the target's correctly rounded binary64 parser, preserving signed zero and gradual underflow. */
pub floatLiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "Number(" + textLiteralCode(digits) + ")";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Encodes a finite decimal Float8 token rounded to OCP E4M3 precision, preserving signed zero. */
pub float8LiteralCode := fn(digits: String, negative: Bool): String {
    "lite$f8Round(" + floatLiteralCode(digits, negative) + ", 0)"
}

/** Encodes a finite decimal Float16 token rounded to IEEE-754 binary16 precision, preserving signed zero. */
pub float16LiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "Math.f16round(Number(" + textLiteralCode(digits) + "))";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Encodes a finite decimal Float32 token rounded to IEEE-754 binary32 precision, preserving signed zero. */
pub float32LiteralCode := fn(digits: String, negative: Bool): String {
    parsed := "Math.fround(Number(" + textLiteralCode(digits) + "))";
    if negative { "(-" + parsed + ")" } else { parsed }
}

/** Evaluates a Unit expression's effects while suppressing any target builtin return payload. */
pub unitEvaluationCode := fn(code: String): String { "(void (" + code + "))" }

/** Inert Unit value for TypeScript expression evaluation. */
pub unitLiteralCode := "undefined";

/** Formats a checked Bool value as a TypeScript literal. */
pub boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Emits one ordinary list value copy as a fresh TypeScript array so later mutation cannot reach the source. */
pub listCopyCode := fn(code: String): String {
    if code.startsWithAt(0, "[...(") and code.endsWith(")]") and
    code.indexOf(")]", 0) == code.length() - 2 {
        return code;
    }
    "[...(" + code + ")]"
}

/** Emits an ordinary TypeScript String concatenation whose operands evaluate left to right. */
pub concatCode := fn(left: String, right: String): String {
    "((" + left + ") + (" + right + "))"
}

/** Emits a TypeScript logical negation around one Bool expression. */
pub notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a TypeScript short-circuit `and`/`or` expression around two Bool expressions. */
pub logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware TypeScript comparison; equality uses strict operators and not-less/not-more spellings invert the ordering. Bool comparisons coerce through `Boolean` so literal-type narrowing cannot reject them. */
pub comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    operator := if op == "==" { "===" }
    else if op == "=!=" { "!==" }
    else if op == "<" { "<" }
    else if op == "<!" { ">=" }
    else if op == "<=" { "<=" }
    else if op == "<!=" { ">" }
    else if op == ">" { ">" }
    else if op == ">!" { "<=" }
    else if op == ">=" { ">=" }
    else { "<" };
    if kind == numeric.KIND_BOOL {
        "(Boolean(" + left + ") " + operator + " Boolean(" + right + "))"
    } else {
        "((" + left + ") " + operator + " (" + right + "))"
    }
}

/** Converts an Int* operand only at a mixed Float operation, retaining original values for later comparison-chain pairs. */
pub floatOperandCode := fn(kind: String, code: String): String {
    if numeric.isIntKind(kind) { "Number(" + code + ")" } else { code }
}

/** Converts an Int* or Float* operand into a Float8 (E4M3) value when targeting Float8. */
pub float8OperandCode := fn(kind: String, code: String): String {
    if kind == numeric.KIND_FLOAT8 { code } else { "lite$f8Round(" + floatOperandCode(kind, code) + ", 0)" }
}

/** Converts an Int* or Float* operand into a binary16 value when targeting Float16. */
pub float16OperandCode := fn(kind: String, code: String): String {
    if numeric.isIntKind(kind) { "Math.f16round(Number(" + code + "))" }
    else if kind == numeric.KIND_FLOAT or kind == numeric.KIND_FLOAT32 { "Math.f16round(" + code + ")" }
    else { code }
}

/** Converts an Int* or Float operand into a binary32 value when targeting Float32. */
pub float32OperandCode := fn(kind: String, code: String): String {
    if numeric.isIntKind(kind) { "Math.fround(Number(" + code + "))" }
    else if kind == numeric.KIND_FLOAT { "Math.fround(" + code + ")" }
    else { code }
}

/** Emits one numeric comparison using the pair's common family. */
comparisonPairCode := fn(op: String, leftKind: String, rightKind: String, left: String, right: String): String {
    if numeric.isFloatKind(leftKind) or numeric.isFloatKind(rightKind) {
        comparisonCode(op, numeric.KIND_FLOAT, floatOperandCode(leftKind, left), floatOperandCode(rightKind, right))
    } else { comparisonCode(op, leftKind, left, right) }
}

/** Encodes the arithmetic operator tag expected by runtime float helpers. */
floatOpTag := fn(op: String): String {
    if op == "+" { "0" } else if op == "-" { "1" } else if op == "*" { "2" } else { "3" }
}

/** Emits checked binary64 arithmetic; target calls evaluate operands once in source order. */
pub floatBinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    "lite$floatOp(" + left + ", " + right + ", " + floatOpTag(op) + ", " + position.toText() + ")"
}

/** Emits checked Float8 E4M3 arithmetic; target calls evaluate operands once in source order. */
pub float8BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    "lite$float8Op(" + left + ", " + right + ", " + floatOpTag(op) + ", " + position.toText() + ")"
}

/** Emits checked binary16 arithmetic; target calls evaluate operands once in source order. */
pub float16BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    "lite$float16Op(" + left + ", " + right + ", " + floatOpTag(op) + ", " + position.toText() + ")"
}

/** Emits checked binary32 arithmetic; target calls evaluate operands once in source order. */
pub float32BinaryCode := fn(op: String, left: String, right: String, position: Int): String {
    "lite$float32Op(" + left + ", " + right + ", " + floatOpTag(op) + ", " + position.toText() + ")"
}

/** Emits the selected Float-default, positive-exponent power checkpoint. */
pub floatPowerCode := fn(left: String, right: String, position: Int): String {
    "lite$floatPower(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits a BigInt floor-division expression without evaluating operands more than once in source semantics. */
pub floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0n) && (((" + left + " % " + right + ") < 0n) != (" + right + " < 0n))) ? 1n : 0n))"
}

/** Emits a BigInt floor-modulo expression. */
pub floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0n) && (((" + left + " % " + right + ") < 0n) != (" + right + " < 0n))) ? " + right + " : 0n))"
}

/** Emits a checked truncating BigInt division call. */
pub intDivideCode := fn(left: String, right: String, position: Int): String {
    "lite$divideInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits a checked BigInt remainder call. */
pub intRemainderCode := fn(left: String, right: String, position: Int): String {
    "lite$remainderInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits a checked BigInt floor-division call. */
pub intFloorDivideCode := fn(left: String, right: String, position: Int): String {
    "lite$floorDivideInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits a checked BigInt floor-modulo call. */
pub intFloorModuloCode := fn(left: String, right: String, position: Int): String {
    "lite$floorModuloInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits checked Int64 addition, evaluating both operands once in source order. */
pub intAddCode := fn(left: String, right: String, position: Int): String {
    "lite$addInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits checked Int64 subtraction, evaluating both operands once in source order. */
pub intSubtractCode := fn(left: String, right: String, position: Int): String {
    "lite$subtractInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits checked Int64 multiplication, evaluating both operands once in source order. */
pub intMultiplyCode := fn(left: String, right: String, position: Int): String {
    "lite$multiplyInt(" + left + ", " + right + ", " + position.toText() + ")"
}

/** Emits checked Int64 negation, evaluating the operand once. */
pub intNegateCode := fn(value: String, position: Int): String {
    "lite$negateInt(" + value + ", " + position.toText() + ")"
}

/** Emits checked unsigned BigInt arithmetic/division calls. */
pub uintBinaryCode := fn(operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { "lite$uaddInt(" + left + ", " + right + ", " + position.toText() + ")" }
    else if operator == "-" { "lite$usubInt(" + left + ", " + right + ", " + position.toText() + ")" }
    else if operator == "*" { "lite$umulInt(" + left + ", " + right + ", " + position.toText() + ")" }
    else if operator == "/" or operator == ":/" { "lite$udivInt(" + left + ", " + right + ", " + position.toText() + ")" }
    else { "lite$uremInt(" + left + ", " + right + ", " + position.toText() + ")" }
}

/** Emits a checked signed range check for narrow integer arithmetic results. */
pub checkedNarrowIntCode := fn(kind: String, value: String, position: Int): String {
    bits: Int = numeric.narrowIntBits(kind);
    "lite$checkedNarrowInt(" + value + ", " + bits.toText() + "n, " + textLiteralCode(kind) + ", " + position.toText() + ")"
}

/** Emits a checked unsigned range check for narrow unsigned integer arithmetic results. */
pub checkedNarrowUIntCode := fn(kind: String, value: String, position: Int): String {
    bits: Int = numeric.narrowIntBits(kind);
    "lite$checkedNarrowUInt(" + value + ", " + bits.toText() + "n, " + textLiteralCode(kind) + ", " + position.toText() + ")"
}

/** Emits a chain with one evaluation per operand and lazy later operands in a private expression scope. */
pub comparisonChainCode := fn(codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String {
    var result := "((): boolean => { ";
    var index := 0;
    loop index <= count {
        name := "lite$compare" + index.toText();
        result += "const " + name + ": " + tsScalarType(kinds[index]) + " = " + codes[index] + "; ";
        if index > 0 {
            pair := comparisonPairCode(operators[index - 1], kinds[index - 1], kinds[index], "lite$compare" + (index - 1).toText(), name);
            if index < count { result += "if (!(" + pair + ")) return false; "; }
            else { result += "return " + pair + "; "; }
        }
        index += 1;
    }
    result + "})()"
}


/** Returns the exact integer bit width for any signed or unsigned integer kind. */
castIntBits := fn(kind: String): Int {
    if kind == numeric.KIND_INT or kind == numeric.KIND_UINT64 { 64 }
    else { numeric.narrowIntBits(kind) }
}

/** Emits a checked TypeScript numeric conversion `cast<Dst>(src)` for integers or floats. */
pub numericCastCode := fn(dstKind: String, srcKind: String, code: String, position: Int): String {
    if dstKind == srcKind { return code; }
    posText := position.toText();
    if numeric.isIntKind(dstKind) and numeric.isIntKind(srcKind) {
        dstUnsigned := numeric.isUnsignedIntKind(dstKind);
        srcUnsigned := numeric.isUnsignedIntKind(srcKind);
        dstBits := castIntBits(dstKind);
        if srcUnsigned and not dstUnsigned {
            return "lite$castU2I(" + code + ", " + dstBits.toText() + "n, " + textLiteralCode(dstKind) + ", " + posText + ")";
        }
        if not srcUnsigned and dstUnsigned {
            return "lite$castI2U(" + code + ", " + dstBits.toText() + "n, " + textLiteralCode(dstKind) + ", " + posText + ")";
        }
        if numeric.numericWidens(dstKind, srcKind) {
            return code;
        }
        if dstUnsigned {
            return checkedNarrowUIntCode(dstKind, code, position);
        }
        return checkedNarrowIntCode(dstKind, code, position);
    }
    asNum := floatOperandCode(srcKind, code);
    if dstKind == numeric.KIND_FLOAT8 { return "lite$f8Round(" + asNum + ", " + posText + ")"; }
    if dstKind == numeric.KIND_FLOAT16 { return "lite$f16Round(" + asNum + ", " + posText + ")"; }
    if dstKind == numeric.KIND_FLOAT32 { return "lite$f32Round(" + asNum + ", " + posText + ")"; }
    asNum
}

/** Emits a checked TypeScript float-to-integer truncation `<IntType>.trunc(floatExpr)`. */
pub floatTruncCode := fn(dstIntKind: String, srcFloatKind: String, code: String, position: Int): String {
    asNum := floatOperandCode(srcFloatKind, code);
    bitsText := castIntBits(dstIntKind).toText();
    posText := position.toText();
    if numeric.isUnsignedIntKind(dstIntKind) {
        "lite$truncToUInt(" + asNum + ", " + bitsText + "n, " + textLiteralCode(dstIntKind) + ", " + posText + ")"
    } else {
        "lite$truncToInt(" + asNum + ", " + bitsText + "n, " + textLiteralCode(dstIntKind) + ", " + posText + ")"
    }
}
