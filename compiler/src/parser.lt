/* Lite-written parser core. */

lexer := import "./lexer";
numeric := import "./numeric-literals";
diag := import "core/diag";
io := import "core/io";
tb := import "util/text-builder";

/** One flat parse node: kind, name, detail text and source position. */
pub Node := alias (kind: String, name: String, detail: String, offset: Int, line: Int, column: Int);

/** Parse nodes in source order. */
pub Nodes := alias List<Node>;

/* Parse-node kind spellings (Lite has no enum in this bootstrap subset yet). */
/** Canonical node kind for one type alias. */
NODE_KIND_TYPE_ALIAS := "TypeAlias";

/** Canonical node kind for one declaration. */
NODE_KIND_DECLARATION := "Declaration";

/** Canonical node kind for a complete program. */
NODE_KIND_PROGRAM := "Program";

/** Reports one token-positioned parser diagnostic and exits 2. */
parseFail := fn(token: lexer.Token, prefix: String, message: String): Unit {
    diag.fail(prefix, token.line.toText() + ":" + token.column.toText() + ": " + message);
}

/** Number of tokens, including the final EOF token. */
pub tokenCount := fn(tokens: lexer.Tokens): Int {
    var count := 0;
    loop tokens as token {
        if token.kind == lexer.TOKEN_KIND_EOF { return count + 1; }
        count = count + 1;
    }
    count
}

/** Returns the token at `index`; the caller keeps `index` inside the counted list. */
pub tokenAt := fn(tokens: lexer.Tokens, index: Int): lexer.Token {
    tokens[index]
}

/** Reads one token field through a public scalar accessor for imported callers. */
pub tokenKindAt := fn(tokens: lexer.Tokens, index: Int): String { tokenAt(tokens, index).kind }
/** Reads one token field through a public scalar accessor for imported callers. */
pub tokenTextAt := fn(tokens: lexer.Tokens, index: Int): String { tokenAt(tokens, index).text }
/** Reads one token field through a public scalar accessor for imported callers. */
pub tokenLineAt := fn(tokens: lexer.Tokens, index: Int): Int { tokenAt(tokens, index).line }
/** Reads one token field through a public scalar accessor for imported callers. */
pub tokenColumnAt := fn(tokens: lexer.Tokens, index: Int): Int { tokenAt(tokens, index).column }
/** Reads one token field through a public scalar accessor for imported callers. */
pub tokenOffsetAt := fn(tokens: lexer.Tokens, index: Int): Int { tokenAt(tokens, index).offset }

/** True when the token is the exact symbol `text`. */
pub isSymbol := fn(token: lexer.Token, text: String): Bool {
    token.kind == lexer.TOKEN_KIND_SYMBOL and token.text == text
}

/** Consumes the exact symbol or reports a parser diagnostic. */
pub expectSymbol := fn(tokens: lexer.Tokens, index: Int, text: String, prefix: String): Int {
    token := tokenAt(tokens, index);
    if not isSymbol(token, text) {
        parseFail(token, prefix, "expected " + text);
    }
    index + 1
}

/** Consumes a simple-item separator, allowing EOF, a closing scope and a directly closed block token as implicit boundaries. */
pub consumeStatementEnd := fn(tokens: lexer.Tokens, index: Int, prefix: String): Int {
    token := tokenAt(tokens, index);
    if isSymbol(token, ";") { return index + 1; }
    if token.kind == lexer.TOKEN_KIND_EOF or isSymbol(token, "}") or
    (index > 0 and isSymbol(tokenAt(tokens, index - 1), "}")) { return index; }
    expectSymbol(tokens, index, ";", prefix)
}

/** Parses one type: a name, `List<T>` or a flat tuple with optional labels. */
pub parseType := fn(tokens: lexer.Tokens, index: Int, prefix: String): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    if token.kind == lexer.TOKEN_KIND_NAME {
        after := tokenAt(tokens, index + 1);
        if isSymbol(after, "<") {
            if token.text =!= "List" {
                parseFail(token, prefix, "unsupported generic type " + token.text);
            }
            inner := self(tokens, index + 2, prefix);
            closed := expectSymbol(tokens, inner.next, ">", prefix);
            return (next = closed, text = "List<" + inner.text + ">");
        }
        numericKind := numeric.numericAliasKind(token.text);
        return (next = index + 1, text = if numericKind == "" { token.text } else { numericKind });
    }
    if isSymbol(token, "(") {
        var cursor := index + 1;
        mut textBuf: tb.TextBuilder;
        mut textBuf.append("(");
        var first := true;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), ")") { break; }
            var label := "";
            if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), ":") {
                label = tokenAt(tokens, cursor).text + ": ";
                cursor = cursor + 2;
            }
            component := self(tokens, cursor, prefix);
            if not first { mut textBuf.append(", "); }
            mut textBuf.append(label);
            mut textBuf.append(component.text);
            first = false;
            cursor = component.next;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        closed := expectSymbol(tokens, cursor, ")", prefix);
        mut textBuf.append(")");
        return (next = closed, text = textBuf.build());
    }
    parseFail(token, prefix, "expected a type");
    (next = index, text = "")
}

/** Quotes one String value as valid normalized expression text. */
quotedText := fn(text: String): String {
    escaped := lexer.escapedTokenText(text);
    mut result: tb.TextBuilder;
    var index := 0;
    loop index < escaped.length() {
        ch := escaped.at(index);
        if ch == "\"" { mut result.append("\\\""); } else { mut result.append(ch); }
        index = index + 1;
    }
    result.build()
}

/** Precedence for one binary word or symbol, or 0 when it is not binary. */
binaryLevel := fn(text: String): Int {
    if text == "or" { 2 }
    else if text == "and" { 3 }
    else if text == "==" or text == "=!=" or text == "<" or text == "<!" or text == "<=" or
    text == "<!=" or text == ">" or text == ">!" or text == ">=" or text == ">!=" { 5 }
    else if text == "+" or text == "-" { 10 }
    else if text == "*" or text == "/" or text == "%" or text == ":/" or text == ":%" { 20 }
    else if text == "**" { 25 }
    else { 0 }
}

/** True when a token is a selected binary operator. */
isBinaryToken := fn(token: lexer.Token): Bool {
    if token.kind == lexer.TOKEN_KIND_KEYWORD and (token.text == "and" or token.text == "or") { return true; }
    token.kind == lexer.TOKEN_KIND_SYMBOL and binaryLevel(token.text) > 0
}

/** Returns the token index of the ungrouped `{` that ends a subjectless match arm header, or -1 when absent. */
pub scanMatchArmBrace := fn(tokens: lexer.Tokens, start: Int): Int {
    var cursor := start;
    var depth := 0;
    loop true {
        token := tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF { return -1; }
        if isSymbol(token, "(") or isSymbol(token, "[") {
            depth = depth + 1;
        } else if isSymbol(token, ")") or isSymbol(token, "]") {
            if depth > 0 { depth = depth - 1; }
        } else if isSymbol(token, "{") and depth == 0 {
            return cursor;
        }
        cursor = cursor + 1;
    }
    -1
}

/** Parses one expression and returns a fully parenthesized normalized text. */
pub parseExpression := fn(tokens: lexer.Tokens, index: Int, prefix: String, minimum: Int): (next: Int, text: String) {
    token := tokenAt(tokens, index);
    var cursor := index;
    var leftText := "";
    var firstLabel := false;
    if token.kind == lexer.TOKEN_KIND_KEYWORD and (token.text == "and" or token.text == "or") {
        operand := self(tokens, index + 1, prefix, 0);
        return (next = operand.next, text = operand.text);
    } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "not" {
        operand := self(tokens, index + 1, prefix, 5);
        leftText = "(not " + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "mut" {
        operand := self(tokens, index + 1, prefix, 35);
        leftText = "(mut " + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == lexer.TOKEN_KIND_SYMBOL and (token.text == "-" or token.text == "+") {
        operand := self(tokens, index + 1, prefix, 30);
        leftText = "(" + token.text + operand.text + ")";
        cursor = operand.next;
    } else if token.kind == lexer.TOKEN_KIND_INT or token.kind == lexer.TOKEN_KIND_FLOAT {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == lexer.TOKEN_KIND_STRING {
        mut valueBuf: tb.TextBuilder;
        mut valueBuf.append(token.text);
        cursor = index + 1;
        loop tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_STRING {
            mut valueBuf.append(tokenAt(tokens, cursor).text);
            cursor = cursor + 1;
        }
        leftText = "\"" + quotedText(valueBuf.build()) + "\"";
    } else if token.kind == lexer.TOKEN_KIND_BOOL {
        leftText = token.text;
        cursor = index + 1;
    } else if token.kind == lexer.TOKEN_KIND_NAME {
        leftText = token.text;
        cursor = index + 1;
        if isSymbol(tokenAt(tokens, cursor), "(") {
            mut argBuf: tb.TextBuilder;
            var argCount := 0;
            cursor = cursor + 1;
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                if argCount > 0 { mut argBuf.append(", "); }
                if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "mut" {
                    mut argBuf.append("mut ");
                    cursor = cursor + 1;
                }
                if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    mut argBuf.append(tokenAt(tokens, cursor).text);
                    mut argBuf.append(" = ");
                    cursor = cursor + 2;
                }
                arg := self(tokens, cursor, prefix, 0);
                mut argBuf.append(arg.text);
                cursor = arg.next;
                argCount = argCount + 1;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = leftText + "(" + argBuf.build() + ")";
        }
    } else if isSymbol(token, "(") {
        cursor = index + 1;
        var firstText := "";
        if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), "=") {
            firstText = tokenAt(tokens, cursor).text + " = ";
            firstLabel = true;
            cursor = cursor + 2;
        }
        first := self(tokens, cursor, prefix, 0);
        firstText = firstText + first.text;
        cursor = first.next;
        if firstLabel or isSymbol(tokenAt(tokens, cursor), ",") {
            mut tupleBuf: tb.TextBuilder;
            mut tupleBuf.append("(");
            mut tupleBuf.append(firstText);
            if isSymbol(tokenAt(tokens, cursor), ",") { cursor = cursor + 1; }
            loop true {
                if isSymbol(tokenAt(tokens, cursor), ")") { break; }
                mut tupleBuf.append(", ");
                if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), "=") {
                    mut tupleBuf.append(tokenAt(tokens, cursor).text);
                    mut tupleBuf.append(" = ");
                    cursor = cursor + 2;
                }
                component := self(tokens, cursor, prefix, 0);
                mut tupleBuf.append(component.text);
                cursor = component.next;
                if isSymbol(tokenAt(tokens, cursor), ",") {
                    cursor = cursor + 1;
                } else {
                    break;
                }
            }
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            mut tupleBuf.append(")");
            leftText = tupleBuf.build();
        } else {
            cursor = expectSymbol(tokens, cursor, ")", prefix);
            leftText = "(" + firstText + ")";
        }
    } else if isSymbol(token, "[") {
        cursor = index + 1;
        mut listBuf: tb.TextBuilder;
        mut listBuf.append("[");
        var itemCount := 0;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), "]") { break; }
            if itemCount > 0 { mut listBuf.append(", "); }
            item := self(tokens, cursor, prefix, 0);
            mut listBuf.append(item.text);
            cursor = item.next;
            itemCount = itemCount + 1;
            if isSymbol(tokenAt(tokens, cursor), ",") {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
        cursor = expectSymbol(tokens, cursor, "]", prefix);
        mut listBuf.append("]");
        leftText = listBuf.build();
    } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "if" {
        condition := self(tokens, index + 1, prefix, 0);
        opening := expectSymbol(tokens, condition.next, "{", prefix);
        branchValue := self(tokens, opening, prefix, 0);
        closing := expectSymbol(tokens, branchValue.next, "}", prefix);
        mut ifBuf: tb.TextBuilder;
        mut ifBuf.append("if ");
        mut ifBuf.append(condition.text);
        mut ifBuf.append(" { ");
        mut ifBuf.append(branchValue.text);
        mut ifBuf.append(" }");
        cursor = closing;
        loop true {
            if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "else" {
                afterElse := cursor + 1;
                if tokenAt(tokens, afterElse).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, afterElse).text == "if" {
                    elseCondition := self(tokens, afterElse + 1, prefix, 0);
                    elseOpening := expectSymbol(tokens, elseCondition.next, "{", prefix);
                    elseValue := self(tokens, elseOpening, prefix, 0);
                    elseClosing := expectSymbol(tokens, elseValue.next, "}", prefix);
                    mut ifBuf.append(" else if ");
                    mut ifBuf.append(elseCondition.text);
                    mut ifBuf.append(" { ");
                    mut ifBuf.append(elseValue.text);
                    mut ifBuf.append(" }");
                    cursor = elseClosing;
                } else {
                    elseOpening := expectSymbol(tokens, afterElse, "{", prefix);
                    elseValue := self(tokens, elseOpening, prefix, 0);
                    elseClosing := expectSymbol(tokens, elseValue.next, "}", prefix);
                    mut ifBuf.append(" else { ");
                    mut ifBuf.append(elseValue.text);
                    mut ifBuf.append(" }");
                    cursor = elseClosing;
                    break;
                }
            } else {
                break;
            }
        }
        leftText = ifBuf.build();
    } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "match" {
        if not isSymbol(tokenAt(tokens, index + 1), "{") {
            parseFail(token, prefix, "unsupported feature \"match\"");
        }
        cursor = index + 2;
        mut matchBuf: tb.TextBuilder;
        mut matchBuf.append("match {");
        var sawFallback := false;
        loop true {
            if isSymbol(tokenAt(tokens, cursor), ";") { cursor = cursor + 1; continue; }
            armToken := tokenAt(tokens, cursor);
            if armToken.kind == lexer.TOKEN_KIND_EOF {
                parseFail(armToken, prefix, "expected } to close match");
            }
            if isSymbol(armToken, "}") {
                if not sawFallback { parseFail(armToken, prefix, "subjectless match requires a final _ fallback arm"); }
                cursor = cursor + 1;
                break;
            }
            if sawFallback {
                parseFail(armToken, prefix, "match fallback _ must be the final arm");
            }
            isFallback := armToken.kind == lexer.TOKEN_KIND_NAME and armToken.text == "_" and
            isSymbol(tokenAt(tokens, cursor + 1), "{");
            var armHeaderText := "";
            var armOpen := -1;
            if isFallback {
                armHeaderText = "_";
                armOpen = cursor + 1;
                sawFallback = true;
            } else {
                brace := scanMatchArmBrace(tokens, cursor);
                if brace < 0 { parseFail(armToken, prefix, "expected { after match arm condition"); }
                if brace == cursor { parseFail(armToken, prefix, "match arm header requires grouping for { ... } expressions"); }
                condition := self(tokens, cursor, prefix, 0);
                if condition.next > brace {
                    parseFail(tokenAt(tokens, brace), prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                }
                armOpen = expectSymbol(tokens, condition.next, "{", prefix) - 1;
                armHeaderText = condition.text;
            }
            var bodyCursor := armOpen + 1;
            loop isSymbol(tokenAt(tokens, bodyCursor), ";") { bodyCursor = bodyCursor + 1; }
            var armBodyText := "";
            if isSymbol(tokenAt(tokens, bodyCursor), "}") {
                armBodyText = "Unit";
                bodyCursor = bodyCursor + 1;
            } else {
                armValue := self(tokens, bodyCursor, prefix, 0);
                bodyCursor = armValue.next;
                loop isSymbol(tokenAt(tokens, bodyCursor), ";") { bodyCursor = bodyCursor + 1; }
                bodyCursor = expectSymbol(tokens, bodyCursor, "}", prefix);
                armBodyText = armValue.text;
            }
            mut matchBuf.append(" ");
            mut matchBuf.append(armHeaderText);
            mut matchBuf.append(" { ");
            mut matchBuf.append(armBodyText);
            mut matchBuf.append(" }");
            cursor = bodyCursor;
        }
        mut matchBuf.append(" }");
        leftText = matchBuf.build();
    } else {
        parseFail(token, prefix, "expected an expression");
        return (next = index, text = "");
    }
    mut postfixBuf: tb.TextBuilder;
    mut postfixBuf.append(leftText);
    loop true {
        if cursor > 0 and isSymbol(tokenAt(tokens, cursor - 1), "}") { break; }
        current := tokenAt(tokens, cursor);
        if isSymbol(current, ".") {
            member := tokenAt(tokens, cursor + 1);
            if member.kind == lexer.TOKEN_KIND_NAME or member.kind == lexer.TOKEN_KIND_INT {
                mut postfixBuf.append(".");
                mut postfixBuf.append(member.text);
                cursor = cursor + 2;
            } else {
                parseFail(member, prefix, "expected a field name after .");
            }
        } else if isSymbol(current, "[") {
            indexExpr := self(tokens, cursor + 1, prefix, 0);
            closed := expectSymbol(tokens, indexExpr.next, "]", prefix);
            mut postfixBuf.append("[");
            mut postfixBuf.append(indexExpr.text);
            mut postfixBuf.append("]");
            cursor = closed;
        } else {
            break;
        }
    }
    leftText = postfixBuf.build();
    loop true {
        if cursor > 0 and isSymbol(tokenAt(tokens, cursor - 1), "}") { break; }
        operator := tokenAt(tokens, cursor);
        if not isBinaryToken(operator) { break; }
        level := binaryLevel(operator.text);
        if level < minimum { break; }
        if operator.text == "**" {
            var signIndex := index;
            loop isSymbol(tokenAt(tokens, signIndex), "+") or isSymbol(tokenAt(tokens, signIndex), "-") {
                if isSymbol(tokenAt(tokens, signIndex), "-") {
                    parseFail(operator, prefix, "group a negative power base as (-base) or negate the completed power as -(base ** exponent)");
                }
                signIndex = signIndex + 1;
            }
        }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(tokens, cursor + 1, prefix, rightMinimum);
        leftText = "(" + leftText + " " + operator.text + " " + right.text + ")";
        cursor = right.next;
    }
    (next = cursor, text = leftText)
}

/** Parses one declaration into scalar node fields. */
pub parseDeclaration := fn(tokens: lexer.Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    var cursor := index;
    var isVar := false;
    var isMut := false;
    if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "var" {
        isVar = true;
        cursor = cursor + 1;
        if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "var" {
            parseFail(tokenAt(tokens, cursor), prefix, "duplicate var qualifier");
        }
    }
    if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "mut" {
        isMut = true;
        cursor = cursor + 1;
        if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "mut" {
            parseFail(tokenAt(tokens, cursor), prefix, "duplicate mut qualifier");
        }
        if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "var" {
            parseFail(tokenAt(tokens, cursor), prefix, if isVar { "duplicate var qualifier" } else { "write var mut, not mut var" });
        }
    }
    token := tokenAt(tokens, cursor);
    if token.kind =!= lexer.TOKEN_KIND_NAME {
        parseFail(token, prefix, "expected a declaration name");
    }
    name := token.text;
    cursor = cursor + 1;
    declPrefix := if isVar and isMut { "var mut " } else if isVar { "var " } else if isMut { "mut " } else { "" };
    var detail := "";
    if isSymbol(tokenAt(tokens, cursor), ":=") {
        expression := parseExpression(tokens, cursor + 1, prefix, 0);
        detail = declPrefix + ":= " + expression.text;
        cursor = expression.next;
    } else if isSymbol(tokenAt(tokens, cursor), ":") {
        cursor = cursor + 1;
        if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "mut" {
            if isMut {
                parseFail(tokenAt(tokens, cursor), prefix, "duplicate mut qualifier");
            }
            parseFail(tokenAt(tokens, cursor), prefix, "place mut before the variable name (e.g. mut " + name + ": ...)");
        }
        parsedType := parseType(tokens, cursor, prefix);
        detail = (if isVar { "var " } else { "" }) +
        (if isMut { "mut " } else { "" }) + parsedType.text;
        cursor = parsedType.next;
        if isSymbol(tokenAt(tokens, cursor), "=") {
            if isSymbol(tokenAt(tokens, cursor + 1), "?") {
                detail = detail + " = ?";
                cursor = cursor + 2;
            } else {
                expression := parseExpression(tokens, cursor + 1, prefix, 0);
                detail = detail + " = " + expression.text;
                cursor = expression.next;
            }
        } else if isSymbol(tokenAt(tokens, cursor), "?") {
            detail = detail + " = ?";
            cursor = cursor + 1;
        }
    } else {
        parseFail(tokenAt(tokens, cursor), prefix, "expected := or : after declaration name");
    }
    ended := consumeStatementEnd(tokens, cursor, prefix);
    (next = ended, name = name, detail = detail, offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of declarations, ending at EOF. */
pub parseDeclarations := fn(tokens: lexer.Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    mut nodes: List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF { break; }
        parsed := parseDeclaration(tokens, cursor, prefix);
        mut nodes.pushBack((kind = NODE_KIND_DECLARATION, name = parsed.name, detail = parsed.detail,
        offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** True when `cursor` begins a variable declaration (`var ...`, `mut name :=/: ...`, `mut var ...`, or `name :=/: ...`), not a `mut recv.op()` call. */
pub isDeclarationStart := fn(tokens: lexer.Tokens, cursor: Int): Bool {
    t0 := tokenAt(tokens, cursor);
    if t0.kind == lexer.TOKEN_KIND_KEYWORD and t0.text == "var" { return true; }
    if t0.kind == lexer.TOKEN_KIND_KEYWORD and t0.text == "mut" {
        t1 := tokenAt(tokens, cursor + 1);
        if t1.kind == lexer.TOKEN_KIND_KEYWORD and t1.text == "var" { return true; }
        t2 := tokenAt(tokens, cursor + 2);
        return t1.kind == lexer.TOKEN_KIND_NAME and (isSymbol(t2, ":=") or isSymbol(t2, ":"));
    }
    t1 := tokenAt(tokens, cursor + 1);
    t0.kind == lexer.TOKEN_KIND_NAME and (isSymbol(t1, ":=") or isSymbol(t1, ":"))
};

/** Parses one `{ ... }` block or the whole source when `closed` is false into normalized text. */
pub parseBlock := fn(tokens: lexer.Tokens, index: Int, prefix: String, closed: Bool): (next: Int, text: String) {
    var cursor := index;
    if closed {
        cursor = expectSymbol(tokens, cursor, "{", prefix);
    }
    mut bodyBuf: tb.TextBuilder;
    var itemCount := 0;
    loop true {
        token := tokenAt(tokens, cursor);
        if closed and isSymbol(token, "}") {
            cursor = cursor + 1;
            break;
        }
        if token.kind == lexer.TOKEN_KIND_EOF {
            if closed { parseFail(token, prefix, "expected } before end of source"); }
            break;
        }
        if isSymbol(token, "}") {
            parseFail(token, prefix, "unexpected }");
        }
        if token.kind == lexer.TOKEN_KIND_KEYWORD and
        (token.text == "record" or token.text == "import" or
        token.text == "using" or token.text == "then" or token.text == "finally") {
            parseFail(token, prefix, "unsupported feature \"" + token.text + "\"");
        }
        if isSymbol(token, ";") { cursor = cursor + 1; continue; }
        var itemText := "";
        if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "if" {
            condition := parseExpression(tokens, cursor + 1, prefix, 0);
            if not isSymbol(tokenAt(tokens, condition.next), "{") {
                parseFail(tokenAt(tokens, condition.next), prefix, "expected { after if condition");
            }
            branch := self(tokens, condition.next, prefix, true);
            mut branchBuf: tb.TextBuilder;
            mut branchBuf.append("if ");
            mut branchBuf.append(condition.text);
            mut branchBuf.append(" ");
            mut branchBuf.append(branch.text);
            cursor = branch.next;
            loop true {
                if tokenAt(tokens, cursor).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor).text == "else" {
                    afterElse := cursor + 1;
                    if tokenAt(tokens, afterElse).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, afterElse).text == "if" {
                        elseCondition := parseExpression(tokens, afterElse + 1, prefix, 0);
                        if not isSymbol(tokenAt(tokens, elseCondition.next), "{") {
                            parseFail(tokenAt(tokens, elseCondition.next), prefix, "expected { after else if condition");
                        }
                        elseBranch := self(tokens, elseCondition.next, prefix, true);
                        mut branchBuf.append(" else if ");
                        mut branchBuf.append(elseCondition.text);
                        mut branchBuf.append(" ");
                        mut branchBuf.append(elseBranch.text);
                        cursor = elseBranch.next;
                    } else {
                        elseBranch := self(tokens, afterElse, prefix, true);
                        mut branchBuf.append(" else ");
                        mut branchBuf.append(elseBranch.text);
                        cursor = elseBranch.next;
                        break;
                    }
                } else {
                    break;
                }
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
            itemText = branchBuf.build();
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "match" {
            if not isSymbol(tokenAt(tokens, cursor + 1), "{") {
                parseFail(token, prefix, "unsupported feature \"match\"");
            }
            var armCursor := cursor + 2;
            mut armsBuf: tb.TextBuilder;
            var armCount := 0;
            var sawFallback := false;
            loop true {
                if isSymbol(tokenAt(tokens, armCursor), ";") { armCursor = armCursor + 1; continue; }
                armToken := tokenAt(tokens, armCursor);
                if armToken.kind == lexer.TOKEN_KIND_EOF {
                    parseFail(armToken, prefix, "expected } to close match");
                }
                if isSymbol(armToken, "}") {
                    if not sawFallback { parseFail(armToken, prefix, "subjectless match requires a final _ fallback arm"); }
                    armCursor = armCursor + 1;
                    break;
                }
                if sawFallback {
                    parseFail(armToken, prefix, "match fallback _ must be the final arm");
                }
                isFallback := armToken.kind == lexer.TOKEN_KIND_NAME and armToken.text == "_" and
                isSymbol(tokenAt(tokens, armCursor + 1), "{");
                var armHeaderText := "";
                var armOpen := -1;
                if isFallback {
                    armHeaderText = "_";
                    armOpen = armCursor + 1;
                    sawFallback = true;
                } else {
                    brace := scanMatchArmBrace(tokens, armCursor);
                    if brace < 0 { parseFail(armToken, prefix, "expected { after match arm condition"); }
                    if brace == armCursor { parseFail(armToken, prefix, "match arm header requires grouping for { ... } expressions"); }
                    condition := parseExpression(tokens, armCursor, prefix, 0);
                    if condition.next > brace {
                        parseFail(tokenAt(tokens, brace), prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                    }
                    armOpen = expectSymbol(tokens, condition.next, "{", prefix) - 1;
                    armHeaderText = condition.text;
                }
                armBranch := self(tokens, armOpen, prefix, true);
                if armCount > 0 { mut armsBuf.append(" "); }
                mut armsBuf.append(armHeaderText);
                mut armsBuf.append(" ");
                mut armsBuf.append(armBranch.text);
                armCount = armCount + 1;
                armCursor = armBranch.next;
            }
            cursor = consumeStatementEnd(tokens, armCursor, prefix);
            itemText = "match { " + armsBuf.build() + " }";
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "loop" {
            source := parseExpression(tokens, cursor + 1, prefix, 0);
            if tokenAt(tokens, source.next).kind == lexer.TOKEN_KIND_NAME and tokenAt(tokens, source.next).text == "as" {
                variable := tokenAt(tokens, source.next + 1);
                if variable.kind =!= lexer.TOKEN_KIND_NAME {
                    parseFail(variable, prefix, "expected a loop item name after as");
                }
                bodyBlock := self(tokens, source.next + 2, prefix, true);
                itemText = "loop " + source.text + " as " + variable.text + " " + bodyBlock.text;
                cursor = bodyBlock.next;
            } else {
                if not isSymbol(tokenAt(tokens, source.next), "{") {
                    parseFail(tokenAt(tokens, source.next), prefix, "expected { after loop source");
                }
                bodyBlock := self(tokens, source.next, prefix, true);
                itemText = "loop " + source.text + " " + bodyBlock.text;
                cursor = bodyBlock.next;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD and (token.text == "break" or token.text == "continue") {
            itemText = token.text;
            cursor = cursor + 1;
            if isSymbol(tokenAt(tokens, cursor), "@") {
                label := tokenAt(tokens, cursor + 1);
                if label.kind =!= lexer.TOKEN_KIND_NAME { parseFail(label, prefix, "expected a loop label after @"); }
                itemText = itemText + " @" + label.text;
                cursor = cursor + 2;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == lexer.TOKEN_KIND_KEYWORD and token.text == "return" {
            afterReturn := cursor + 1;
            if isSymbol(tokenAt(tokens, afterReturn), ";") or isSymbol(tokenAt(tokens, afterReturn), "}") or
            tokenAt(tokens, afterReturn).kind == lexer.TOKEN_KIND_EOF {
                itemText = "return";
                cursor = afterReturn;
            } else {
                value := parseExpression(tokens, afterReturn, prefix, 0);
                itemText = "return " + value.text;
                cursor = value.next;
            }
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == lexer.TOKEN_KIND_SYMBOL and token.text == "{" {
            blockText := self(tokens, cursor, prefix, true);
            itemText = blockText.text;
            cursor = consumeStatementEnd(tokens, blockText.next, prefix);
        } else if token.kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
        tokenAt(tokens, cursor + 2).kind == lexer.TOKEN_KIND_KEYWORD and tokenAt(tokens, cursor + 2).text == "fn" {
            name := token.text;
            var afterName := cursor + 3;
            afterName = expectSymbol(tokens, afterName, "(", prefix);
            mut parametersBuf: tb.TextBuilder;
            var parameterCount := 0;
            loop true {
                if isSymbol(tokenAt(tokens, afterName), ")") { break; }
                parameter := tokenAt(tokens, afterName);
                if parameter.kind =!= lexer.TOKEN_KIND_NAME { parseFail(parameter, prefix, "expected a parameter name"); }
                colon := expectSymbol(tokens, afterName + 1, ":", prefix);
                parameterType := parseType(tokens, colon, prefix);
                if parameterCount > 0 { mut parametersBuf.append(", "); }
                mut parametersBuf.append(parameter.text);
                mut parametersBuf.append(": ");
                mut parametersBuf.append(parameterType.text);
                parameterCount = parameterCount + 1;
                afterName = parameterType.next;
                if isSymbol(tokenAt(tokens, afterName), ",") {
                    afterName = afterName + 1;
                } else {
                    break;
                }
            }
            parameters := parametersBuf.build();
            afterName = expectSymbol(tokens, afterName, ")", prefix);
            resultColon := expectSymbol(tokens, afterName, ":", prefix);
            resultType := parseType(tokens, resultColon, prefix);
            if not isSymbol(tokenAt(tokens, resultType.next), "{") {
                parseFail(tokenAt(tokens, resultType.next), prefix, "expected { after function signature");
            }
            functionBody := self(tokens, resultType.next, prefix, true);
            itemText = name + " := fn(" + parameters + "): " + resultType.text + " " + functionBody.text;
            cursor = functionBody.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else if token.kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), ":=") and
        tokenAt(tokens, cursor + 2).kind == lexer.TOKEN_KIND_KEYWORD and
        (tokenAt(tokens, cursor + 2).text == "alias" or tokenAt(tokens, cursor + 2).text == "distinct") {
            assigned := expectSymbol(tokens, cursor + 1, ":=", prefix);
            typeWord := tokenAt(tokens, assigned);
            if typeWord.kind =!= lexer.TOKEN_KIND_KEYWORD or (typeWord.text =!= "alias" and typeWord.text =!= "distinct") {
                parseFail(typeWord, prefix, "expected alias or distinct after :=");
            }
            aliasType := parseType(tokens, assigned + 1, prefix);
            ended := consumeStatementEnd(tokens, aliasType.next, prefix);
            itemText = token.text + " := " + typeWord.text + " " + aliasType.text;
            cursor = ended;
        } else if isDeclarationStart(tokens, cursor) {
            declaration := parseDeclaration(tokens, cursor, prefix);
            itemText = declaration.name + " " + declaration.detail;
            cursor = declaration.next;
        } else if token.kind == lexer.TOKEN_KIND_NAME and isSymbol(tokenAt(tokens, cursor + 1), "=") {
            value := parseExpression(tokens, cursor + 2, prefix, 0);
            itemText = token.text + " = " + value.text;
            cursor = value.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        } else {
            expression := parseExpression(tokens, cursor, prefix, 0);
            itemText = expression.text;
            cursor = expression.next;
            cursor = consumeStatementEnd(tokens, cursor, prefix);
        }
        if itemCount > 0 { mut bodyBuf.append("; "); }
        mut bodyBuf.append(itemText);
        itemCount = itemCount + 1;
    }
    body := bodyBuf.build();
    (next = cursor, text = if closed { "{ " + body + " }" } else { body })
}

/** Parses a complete source as one Program node containing normalized item text. */
pub parseProgram := fn(tokens: lexer.Tokens, prefix: String): Nodes {
    parsed := parseBlock(tokens, 0, prefix, false);
    mut nodes: List<Node> = [];
    mut nodes.pushBack((kind = NODE_KIND_PROGRAM, name = "", detail = parsed.text, offset = 0, line = 1, column = 1));
    nodes
}

/** Parses one `Name := alias Type;` declaration into scalar node fields. */
pub parseTypeAlias := fn(tokens: lexer.Tokens, index: Int, prefix: String): (next: Int, name: String, detail: String, offset: Int, line: Int, column: Int) {
    token := tokenAt(tokens, index);
    if token.kind =!= lexer.TOKEN_KIND_NAME {
        parseFail(token, prefix, "expected a type alias name");
    }
    assigned := expectSymbol(tokens, index + 1, ":=", prefix);
    typeWord := tokenAt(tokens, assigned);
    if typeWord.kind =!= lexer.TOKEN_KIND_KEYWORD or (typeWord.text =!= "alias" and typeWord.text =!= "distinct") {
        parseFail(typeWord, prefix, "expected alias or distinct after :=");
    }
    parsed := parseType(tokens, assigned + 1, prefix);
    ended := consumeStatementEnd(tokens, parsed.next, prefix);
    (next = ended, name = token.text, detail = parsed.text,
    offset = token.offset, line = token.line, column = token.column)
}

/** Parses a source made only of type alias declarations, ending at EOF. */
pub parseTypeDeclarations := fn(tokens: lexer.Tokens, prefix: String): Nodes {
    count := tokenCount(tokens);
    mut nodes: List<Node> = [];
    var cursor := 0;
    loop cursor < count {
        token := tokenAt(tokens, cursor);
        if token.kind == lexer.TOKEN_KIND_EOF { break; }
        parsed := parseTypeAlias(tokens, cursor, prefix);
        mut nodes.pushBack((kind = NODE_KIND_TYPE_ALIAS, name = parsed.name, detail = parsed.detail,
        offset = parsed.offset, line = parsed.line, column = parsed.column));
        cursor = parsed.next;
    }
    nodes
}

/** Formats one parse node as `kind|name|detail|line:column|offset`. */
dumpNode := fn(node: Node): String {
    node.kind + "|" + node.name + "|" + node.detail + "|" + node.line.toText() + ":" +
    node.column.toText() + "|" + node.offset.toText()
}

/** Reports parsed nodes in source order, one per line. */
pub dumpNodes := fn(nodes: Nodes): Unit {
    loop nodes as node {
        io.outputLine(dumpNode(node));
    }
}

/** Runs the declaration parser and writes its deterministic node dump. */
pub testDumpDeclarations := fn(source: String, prefix: String): Unit {
    tokens := lexer.tokenize(source, prefix);
    dumpNodes(parseDeclarations(tokens, prefix));
}

/** Runs the type-alias parser and writes its deterministic node dump. */
pub testDumpTypeDeclarations := fn(source: String, prefix: String): Unit {
    tokens := lexer.tokenize(source, prefix);
    dumpNodes(parseTypeDeclarations(tokens, prefix));
}

/** Runs the whole-program parser and writes its deterministic node dump. */
pub testDumpProgram := fn(source: String, prefix: String): Unit {
    tokens := lexer.tokenize(source, prefix);
    dumpNodes(parseProgram(tokens, prefix));
}
