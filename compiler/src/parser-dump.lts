/* Type-declaration parser dump. Test helper, not a public command. */

importFlatAll "parser.lts";

var prefix := "";
var argCount := 0;
loop inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    reportError("expected at most one logical source name argument");
    exit(2);
}
tokens := tokenize(inputAll(), prefix);
dumpNodes(parseTypeDeclarations(tokens, prefix));
