/** Target helper call scanning, 32-bucket token sets, block-scoped pure dead-code pruning, and program reachability filtering. */

integer := import "core/int";
textLib := import "core/text";
tb := import "util/text-builder";
ir := import "./frontend-ir";
optCfg := import "./opt-config";
syntax := import "./frontend-syntax";
types := import "./frontend-types";
trace := import "./trace-safety";

/** One parsed item entry matching `frontend-ir.Item`. */
Item := alias (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := alias List<Item>;

/** Hash-indexed string set matching `frontend-ir.TokenBuckets`. */
TokenBuckets := alias Set<String>;

/** True when emitted target code calls `needle` outside quoted String literal text. */
pub codeUsesTextCall := fn(code: String, needle: String): Bool {
    if code.indexOf(needle, 0) < 0 { return false; }
    size := code.length();
    if size == 0 { return false; }
    width := needle.length();
    if width == 0 { return true; }
    first := needle.at(0);
    var cursor := 0;
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := code.at(cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if ch == first and code.startsWithAt(cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
};

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
};

/** True when emitted target code calls a checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(") or codeUsesTextCall(code, "lite$listPopFront(")
};

/** True when emitted target code contains a C list-copy placeholder outside quoted String literal text. */
pub codeUsesListCopy := fn(code: String): Bool {
    codeUsesTextCall(code, "lt_list_copy(")
};

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
};

/** Collects distinct target or user-function call tokens directly into `seen`, skipping quoted text and consuming whole identifiers. */
scanCodeCallsSet := fn(code: String, seen: mut Set<String>, userFnsOnly: Bool): Unit {
    var nextLite := code.indexOf("lite", 0);
    var nextLt := code.indexOf("lt_", 0);
    var nextFinally := if userFnsOnly { -1 } else { code.indexOf("finally", 0) };
    if nextLite < 0 and nextLt < 0 and nextFinally < 0 { return; }
    var nextQuote := code.indexOf("\"", 0);
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = code.indexOf("lt_", cursor); }
        if nextFinally >= 0 and nextFinally < cursor { nextFinally = code.indexOf("finally", cursor); }
        var hit := -1;
        if nextLite >= 0 { hit = nextLite; }
        if nextLt >= 0 and (hit < 0 or nextLt < hit) { hit = nextLt; }
        if nextFinally >= 0 and (hit < 0 or nextFinally < hit) { hit = nextFinally; }
        if hit < 0 { return; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := code.at(hit - 1);
            if prev == "$" or prev.isNameContinue() {
                cursor = code.skipName(hit + 3);
                loop cursor < size and code.at(cursor) == "$" {
                    cursor = code.skipName(cursor + 1);
                }
                continue;
            }
        }
        var endPos := code.skipName(hit);
        loop endPos < size and code.at(endPos) == "$" {
            endPos = code.skipName(endPos + 1);
        }
        name := code.slice(hit, endPos);
        if endPos < size and code.at(endPos) == "(" {
            matched := if userFnsOnly {
                name.startsWithAt(0, "lt_fn_") or name.startsWithAt(0, "liteFn$") or
                name.startsWithAt(0, "liteFn_")
            } else {
                (name.startsWithAt(0, "lite$") and not name.startsWithAt(0, "lite$m$")) or
                name.startsWithAt(0, "lite_") or
                (name.startsWithAt(0, "lt_") and not name.startsWithAt(0, "lt_fn_") and
                not name.startsWithAt(0, "lt_m_") and (not name.startsWithAt(0, "lt_s") or name.startsWithAt(0, "lt_s_") or name.startsWithAt(0, "lt_set_") or name.startsWithAt(0, "lt_str_") or name.startsWithAt(0, "lt_shl_") or name.startsWithAt(0, "lt_shr_") or name.startsWithAt(0, "lt_sadd_") or name.startsWithAt(0, "lt_ssub_") or name.startsWithAt(0, "lt_smul_")))
            };
            if matched {
                mut seen.add(name + "(");
            }
        } else if not userFnsOnly and name == "finally" {
            var afterFin := endPos;
            loop afterFin < size and (code.at(afterFin) == " " or code.at(afterFin) == "\t" or code.at(afterFin) == "\n") {
                afterFin = afterFin + 1;
            }
            if afterFin < size and code.at(afterFin) == "{" {
                mut seen.add("lite$finally(");
            }
        }
        cursor = endPos;
    }
};

/** Collects distinct target or user-function call tokens into a `|`-delimited string, skipping quoted text. */
scanCodeCalls := fn(code: String, existing: String, userFnsOnly: Bool): String {
    found: mut Set<String>;
    scanCodeCallsSet(code, mut found, userFnsOnly);
    if found.size() == 0 { return existing; }
    added: mut tb.TextBuilder;
    loop found as tok {
        entry := tok + "|";
        if existing.indexOf("|" + entry, 0) < 0 {
            mut added.append(entry);
        }
    }
    if added.count() == 0 { existing } else { existing + added.build() }
};

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, false)
};

/** Collects distinct user-function call tokens (`lt_fn_*(` / `liteFn...(`) from `code`, skipping quoted text. */
pub userFunctionCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, true)
};

/** Collects a program's target helper call names once as an O(1)-lookup `Set<String>`. */
pub targetHelperCallSet := fn(items: Items): Set<String> {
    calls: mut Set<String>;
    loop items as item { scanCodeCallsSet(item.code, mut calls, false); }
    calls
};

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCalls := fn(items: Items): String {
    flattenTokenBuckets(targetHelperCallSet(items))
};

/** True when `calls` already contains the pipe-delimited call token `needle`. */
pub hasHelperToken := fn(calls: String, needle: String): Bool {
    calls.indexOf("|" + needle + "|", 0) >= 0
};

/** Creates an empty token set. */
pub emptyTokenBuckets := fn(): TokenBuckets {
    empty: mut Set<String>;
    empty
};

/** True when `s` contains `needle`. */
pub tokenBucketHas := fn(s: TokenBuckets, needle: String): Bool {
    needle =!= "" and s.has(needle)
};

/** Inserts `needle` into `s` in place. */
pub tokenBucketAdd := fn(s: mut TokenBuckets, needle: String): Unit {
    if needle =!= "" { mut s.add(needle); }
};

/** Serializes all tokens in `s` into one `|`-delimited string. */
pub flattenTokenBuckets := fn(s: TokenBuckets): String {
    out: mut tb.TextBuilder;
    mut out.append("|");
    loop s as tok {
        mut out.append(tok);
        mut out.append("|");
    }
    out.build()
};

/** Collects distinct `lite*` / `lt_*` call or value identifier tokens from `code` into `tokens`, pushing newly added tokens onto `queue`. */
codeReachableTokensQueue := fn(code: String, tokens: mut TokenBuckets, queue: mut List<String>): Unit {
    var nextLite := code.indexOf("lite", 0);
    var nextLt := code.indexOf("lt_", 0);
    if nextLite < 0 and nextLt < 0 { return; }
    var nextQuote := code.indexOf("\"", 0);
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = code.indexOf("lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor {
                nextQuote = code.indexOf("\"", cursor);
            }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := code.at(hit - 1);
            if prev == "$" or prev.isNameContinue() {
                cursor = code.skipName(hit + 3);
                loop cursor < size and code.at(cursor) == "$" {
                    cursor = code.skipName(cursor + 1);
                }
                continue;
            }
        }
        var endPos := code.skipName(hit);
        loop endPos < size and code.at(endPos) == "$" {
            endPos = code.skipName(endPos + 1);
        }
        name := code.slice(hit, endPos);
        token := if name.startsWithAt(0, "lt_fn_") or name.startsWithAt(0, "liteFn$") or
        name.startsWithAt(0, "liteFn_") {
            name + "("
        } else {
            name
        };
        if not tokens.has(token) {
            mut tokens.add(token);
            mut queue.pushBack(token);
        }
        cursor = endPos;
    }
};

/** Propagates reachable tokens through top-level functions and pure globals in `graph` via an O(V + E) single-index BFS worklist. */
pub closeReachableGraph := fn(graph: Items, reachable: mut TokenBuckets, scanned: mut TokenBuckets): Unit {
    fnStarts: mut Map<String, Int>;
    fnEnds: mut Map<String, Int>;
    pureDeclIdx: mut Map<String, Int>;
    n := graph.length();
    var fnDepth := 0;
    var blockDepth := 0;
    var nextIsPure := false;
    var curFnTok := "";
    var curFnStart := -1;
    var i := 0;
    loop i < n {
        item := graph[i];
        if item.kind == ir.ITEM_KIND_MODULE_START {
            fnDepth = 0;
            blockDepth = 0;
            nextIsPure = false;
            curFnTok = "";
            curFnStart = -1;
        } else if item.kind == ir.ITEM_KIND_MODULE_END or item.kind == ir.ITEM_KIND_MODULE_VISITED or item.kind == ir.ITEM_KIND_MODULE_PROCESSED or
        item.kind == ir.ITEM_KIND_CORE_MODULE_META or item.kind == ir.ITEM_KIND_CORE_MODULE_SOURCE or item.kind == ir.ITEM_KIND_CORE_MODULE_IMPORT {
            nextIsPure = false;
        } else if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
            nextIsPure = true;
        } else if item.kind == ir.ITEM_KIND_FUNCTION_START {
            if fnDepth == 0 {
                curFnTok = item.runtime + "(";
                curFnStart = i + 1;
            }
            fnDepth = fnDepth + 1;
            nextIsPure = false;
        } else if item.kind == ir.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
            if fnDepth == 0 and curFnTok =!= "" {
                mut fnStarts.set(curFnTok, curFnStart);
                mut fnEnds.set(curFnTok, i);
                curFnTok = "";
                curFnStart = -1;
            }
            nextIsPure = false;
        } else if fnDepth > 0 {
            nextIsPure = false;
        } else {
            isPureDecl := blockDepth == 0 and nextIsPure;
            nextIsPure = false;
            if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
                blockDepth = blockDepth + 1;
            } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
                if blockDepth > 0 { blockDepth = blockDepth - 1; }
            } else if isPureDecl and item.runtime =!= "" {
                mut pureDeclIdx.set(item.runtime, i);
            }
        }
        i = i + 1;
    }
    queue: mut List<String> = [];
    loop reachable as tok {
        if not scanned.has(tok) {
            mut queue.pushBack(tok);
        }
    }
    var qHead := 0;
    loop qHead < queue.length() {
        tok := queue[qHead];
        qHead = qHead + 1;
        if scanned.has(tok) { continue; }
        fHit := fnStarts.get(tok);
        if fHit.found {
            mut scanned.add(tok);
            fEnd := fnEnds.get(tok).value;
            var j := fHit.value;
            loop j < fEnd {
                bItem := graph[j];
                codeReachableTokensQueue(bItem.code, mut reachable, mut queue);
                if bItem.kind.startsWithAt(0, "Assign") and bItem.runtime =!= "" {
                    if not reachable.has(bItem.runtime) {
                        mut reachable.add(bItem.runtime);
                        mut queue.pushBack(bItem.runtime);
                    }
                }
                j = j + 1;
            }
            continue;
        }
        pHit := pureDeclIdx.get(tok);
        if pHit.found {
            mut scanned.add(tok);
            codeReachableTokensQueue(graph[pHit.value].code, mut reachable, mut queue);
        }
    }
};

/** Collects distinct `lite*` / `lt_*` call or value identifier tokens from `code` into `tokens` in place. */
pub codeReachableTokensSet := fn(code: String, tokens: mut TokenBuckets): Unit {
    var nextLite := code.indexOf("lite", 0);
    var nextLt := code.indexOf("lt_", 0);
    if nextLite < 0 and nextLt < 0 { return; }
    var nextQuote := code.indexOf("\"", 0);
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = code.indexOf("lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor {
                nextQuote = code.indexOf("\"", cursor);
            }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := code.at(hit - 1);
            if prev == "$" or prev.isNameContinue() {
                cursor = code.skipName(hit + 3);
                loop cursor < size and code.at(cursor) == "$" {
                    cursor = code.skipName(cursor + 1);
                }
                continue;
            }
        }
        var endPos := code.skipName(hit);
        loop endPos < size and code.at(endPos) == "$" {
            endPos = code.skipName(endPos + 1);
        }
        name := code.slice(hit, endPos);
        token := if name.startsWithAt(0, "lt_fn_") or name.startsWithAt(0, "liteFn$") or
        name.startsWithAt(0, "liteFn_") {
            name + "("
        } else {
            name
        };
        mut tokens.add(token);
        cursor = endPos;
    }
};

/** True when `kind` represents a top-level value or mutable variable declaration item. */
isTopDeclKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_LOCAL_INT or kind == ir.ITEM_KIND_LOCAL_STRING or kind == ir.ITEM_KIND_LOCAL_BOOL or kind == ir.ITEM_KIND_LOCAL_FLOAT or
    kind == ir.ITEM_KIND_LOCAL_TUPLE or kind == ir.ITEM_KIND_LOCAL_RECORD or kind == ir.ITEM_KIND_LOCAL_LIST or kind == ir.ITEM_KIND_LOCAL_FN or kind == ir.ITEM_KIND_LOCAL_UNIT or
    kind == ir.ITEM_KIND_VAR_INT or kind == ir.ITEM_KIND_VAR_STRING or kind == ir.ITEM_KIND_VAR_BOOL or kind == ir.ITEM_KIND_VAR_FLOAT or
    kind == ir.ITEM_KIND_VAR_TUPLE or kind == ir.ITEM_KIND_VAR_RECORD or kind == ir.ITEM_KIND_VAR_LIST or kind == ir.ITEM_KIND_VAR_FN or kind == ir.ITEM_KIND_VAR_UNIT
};

/** True when `kind` and `code` only use scalar/unit features valid for scalar C dead-code pruning, preserving unsupported-type checks. */
pub isCSupportedKindAndCode := fn(kind: String, code: String): Bool {
    not types.isTupleKind(kind) and not types.isRecordKind(kind) and not types.isEnumKind(kind) and not types.isDistinctKind(kind) and not types.isMapKind(kind) and not types.isSetKind(kind) and not types.isListKind(kind) and not types.isArrayKind(kind) and not types.containsFnKind(kind) and
    not codeUsesValueIf(code) and not codeUsesListCopy(code) and not codeUsesListIndex(code) and not codeUsesListPop(code)
};

/** True when `item` uses a C-unsupported construct that must stay visible to `emitProgram` diagnostics. */
isCUnsupportedItem := fn(item: Item): Bool {
    item.kind == ir.ITEM_KIND_LOCAL_TUPLE or item.kind == ir.ITEM_KIND_VAR_TUPLE or item.kind == ir.ITEM_KIND_ASSIGN_TUPLE or
    item.kind == ir.ITEM_KIND_LOCAL_RECORD or item.kind == ir.ITEM_KIND_VAR_RECORD or item.kind == ir.ITEM_KIND_ASSIGN_RECORD or
    item.kind == ir.ITEM_KIND_LOCAL_LIST or item.kind == ir.ITEM_KIND_VAR_LIST or item.kind == ir.ITEM_KIND_ASSIGN_LIST or
    item.kind == ir.ITEM_KIND_LOCAL_FN or item.kind == ir.ITEM_KIND_VAR_FN or item.kind == ir.ITEM_KIND_ASSIGN_FN or
    (item.kind == ir.ITEM_KIND_DISCARD and (types.isTupleKind(item.name) or types.isRecordKind(item.name) or types.isEnumKind(item.name) or types.isDistinctKind(item.name) or types.isMapKind(item.name) or types.isSetKind(item.name) or types.isListKind(item.name) or
    types.isArrayKind(item.name) or types.containsFnKind(item.name))) or
    codeUsesValueIf(item.code) or codeUsesListCopy(item.code) or codeUsesListIndex(item.code) or codeUsesListPop(item.code)
};

/** True when `=` at `eqPos` in `stripped` is a comparison/arrow or an assignment to a local declared inside `stripped` itself. */
isInnerLocalAssignAt := fn(stripped: String, eqPos: Int): Bool {
    len := stripped.length();
    if eqPos < 0 or eqPos >= len or stripped.at(eqPos) =!= "=" { return false; }
    if eqPos + 1 < len {
        nx := stripped.at(eqPos + 1);
        if nx == "=" or nx == ">" { return true; }
    }
    if eqPos > 0 {
        pv := stripped.at(eqPos - 1);
        if pv == "=" or pv == "!" or pv == "<" or pv == ">" { return true; }
        if pv == "+" or pv == "-" or pv == "*" or pv == "/" or pv == "%" { return false; }
    }
    var scanBack := eqPos - 1;
    var bDepth := 0;
    loop scanBack >= 0 {
        sc := stripped.at(scanBack);
        if sc == ")" or sc == "]" or sc == "}" {
            bDepth = bDepth + 1;
        } else if sc == "(" or sc == "[" or sc == "{" {
            if bDepth == 0 {
                scanBack = scanBack + 1;
                break;
            }
            bDepth = bDepth - 1;
        } else if sc == ";" and bDepth == 0 {
            scanBack = scanBack + 1;
            break;
        }
        scanBack = scanBack - 1;
    }
    if scanBack < 0 { scanBack = 0; }
    stmtPos := trace.skipCodeSpaces(stripped, scanBack);
    if stripped.wordAt(stmtPos, "const") or stripped.wordAt(stmtPos, "let") {
        return true;
    }
    if stmtPos >= eqPos or not (stripped.at(stmtPos).isNameStart() or stripped.at(stmtPos) == "$") {
        return false;
    }
    var lhsEnd := stmtPos;
    loop lhsEnd < eqPos and trace.isTraceIdentChar(stripped.at(lhsEnd)) { lhsEnd = lhsEnd + 1; }
    if trace.skipCodeSpaces(stripped, lhsEnd) =!= eqPos { return false; }
    lhs := stripped.slice(stmtPos, lhsEnd);
    stripped.indexOf("let " + lhs + " ", 0) >= 0 or
    stripped.indexOf("let " + lhs + ":", 0) >= 0 or
    stripped.indexOf("let " + lhs + ";", 0) >= 0
};

/** True when `code` has no function calls, runtime panic helpers, loops, throws, or outer mutations after stripping uninvoked `fn` literals. */
pub isSideEffectFreeCode := fn(target: String, code: String): Bool {
    if code == "" { return true; }
    stripped := trace.stripDeferredFnBodies(code).code;
    size := stripped.length();
    var cursor := 0;
    loop cursor < size {
        ch := stripped.at(cursor);
        if ch == "\"" {
            cursor = trace.skipCodeString(stripped, cursor);
            continue;
        }
        if ch == "(" {
            if stripped.startsWithAt(cursor, "(function ") { return false; }
            closeEnd := trace.scanBalancedParenEnd(stripped, cursor);
            if trace.isIndirectUserCallParens(stripped, cursor, closeEnd) { return false; }
            if target == ir.TARGET_TS and closeEnd >= 0 {
                afterClose := trace.skipCodeSpaces(stripped, closeEnd);
                if afterClose < size and stripped.at(afterClose) == "(" and
                not trace.isCompilerArrowIife(stripped, cursor, closeEnd) {
                    return false;
                }
            }
            cursor = cursor + 1;
            continue;
        }
        if ch == "]" {
            afterBr := trace.skipCodeSpaces(stripped, cursor + 1);
            if afterBr < size and stripped.at(afterBr) == "(" { return false; }
            cursor = cursor + 1;
            continue;
        }
        if ch == "=" {
            if not isInnerLocalAssignAt(stripped, cursor) { return false; }
            cursor = cursor + 1;
            continue;
        }
        if ch.isNameStart() or ch == "$" {
            var endPos := cursor;
            loop endPos < size and trace.isTraceIdentChar(stripped.at(endPos)) { endPos = endPos + 1; }
            name := stripped.slice(cursor, endPos);
            prevIsDot := cursor > 0 and stripped.at(cursor - 1) == ".";
            if not prevIsDot and (name == "throw" or name == "while" or name == "for" or name == "try") {
                return false;
            }
            afterName := trace.skipCodeSpaces(stripped, endPos);
            if afterName < size and stripped.at(afterName) == "(" {
                isKeywordParen := not prevIsDot and (name == "if" or name == "return" or name == "void");
                isMathPrefix := cursor >= 5 and stripped.slice(cursor - 5, cursor) == "Math." and
                (cursor == 5 or not trace.isTraceIdentChar(stripped.at(cursor - 6)));
                isMathFround := name == "fround" and isMathPrefix;
                isPureWrapper := not prevIsDot and (
                name == "Boolean" or name == "Number" or name == "INT64_C" or
                name == "lt_float_literal" or name == "lt_float32_literal" or name == "strcmp" or
                name == "LT_STR_LIT" or name == "LT_STR_SSO" or name == "LT_ASTR" or name == "LT_STR" or name == "lt_text_eq"
                );
                if not isKeywordParen and not isMathFround and not isPureWrapper {
                    return false;
                }
            }
            cursor = endPos;
            continue;
        }
        cursor = cursor + 1;
    }
    true
};

/** True when a declaration or discarded expression of `kind` and `code` can be omitted on `target` without altering observable behavior or diagnostics. */
pub isPrunableExprForTarget := fn(target: String, kind: String, code: String): Bool {
    if target =!= ir.TARGET_TS and not isCSupportedKindAndCode(kind, code) { return false; }
    isSideEffectFreeCode(target, code)
};

/** Eliminates unreachable pure statements and local bindings inside one `{ ... }` block after its statements and tail are parsed. */
pub pruneBlockStatements := fn(stmts: List<String>, owners: List<String>, deps: List<String>, hasTail: Bool, tailCode: String): List<String> {
    var total := 0;
    var hasPrunable := false;
    loop stmts { total = total + 1; }
    if total == 0 {
        emptyOut: mut List<String> = [];
        return emptyOut;
    }
    var checkIdx := 0;
    loop checkIdx < total {
        if owners[checkIdx] =!= "" {
            hasPrunable = true;
            break;
        }
        checkIdx = checkIdx + 1;
    }
    if not hasPrunable { return stmts; }

    reachable: mut Set<String>;
    if hasTail {
        codeReachableTokensSet(tailCode, mut reachable);
    }
    var seedIdx := 0;
    loop seedIdx < total {
        if owners[seedIdx] == "" {
            codeReachableTokensSet(deps[seedIdx], mut reachable);
        }
        seedIdx = seedIdx + 1;
    }

    scannedIdxs: mut Set<Int>;
    loop true {
        beforeCount := reachable.size();
        var scanIdx := 0;
        loop scanIdx < total {
            ow := owners[scanIdx];
            if ow =!= "" and ow =!= "#discard" and reachable.has(ow) {
                if not scannedIdxs.has(scanIdx) {
                    mut scannedIdxs.add(scanIdx);
                    codeReachableTokensSet(deps[scanIdx], mut reachable);
                }
            }
            scanIdx = scanIdx + 1;
        }
        if reachable.size() == beforeCount { break; }
    }

    kept: mut List<String> = [];
    var outIdx := 0;
    loop outIdx < total {
        ow := owners[outIdx];
        if ow == "" or (ow =!= "#discard" and tokenBucketHas(reachable, ow)) {
            mut kept.pushBack(stmts[outIdx]);
        }
        outIdx = outIdx + 1;
    }
    kept
};

/** Returns ancestor depth (`0` for `startBlockId`) of `targetBlockId` in `startBlockId`'s chain, or `-1`. */
blockAncestorDistance := fn(targetBlockId: Int, startBlockId: Int, parentBlockIds: List<Int>): Int {
    var b := startBlockId;
    var dist := 0;
    loop b > 0 {
        if b == targetBlockId { return dist; }
        b = parentBlockIds[b];
        dist = dist + 1;
    }
    -1
};

/** Finds the innermost enclosing declaration index for `runtime` visible from `startBlockId`, or `-1`. */
findLocalDecl := fn(runtime: String, startBlockId: Int, declHead: Map<String, Int>, declBlockIds: List<Int>, parentBlockIds: List<Int>, declPrev: List<Int>): Int {
    var d := declHead.getOr(runtime, -1);
    if d < 0 { return -1; }
    var bestIdx := -1;
    var bestDist := -1;
    loop d >= 0 {
        dist := blockAncestorDistance(declBlockIds[d], startBlockId, parentBlockIds);
        if dist >= 0 and (bestDist < 0 or dist < bestDist) {
            bestIdx = d;
            bestDist = dist;
            if dist == 0 { return d; }
        }
        d = declPrev[d];
    }
    bestIdx
};

/** Collects declaration item indices referenced by `code` at `startBlockId`. */
collectLocalDeclDeps := fn(code: String, startBlockId: Int, declCount: Int, declHead: Map<String, Int>, declBlockIds: List<Int>, parentBlockIds: List<Int>, declPrev: List<Int>, declIdxs: List<Int>): List<Int> {
    found: mut List<Int> = [];
    if declCount <= 0 or startBlockId <= 0 or code == "" { return found; }
    var nextLite := code.indexOf("lite", 0);
    var nextLt := code.indexOf("lt_", 0);
    if nextLite < 0 and nextLt < 0 { return found; }
    var nextQuote := code.indexOf("\"", 0);
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = code.indexOf("lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return found; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := code.at(hit - 1);
            if prev == "$" or prev.isNameContinue() {
                cursor = code.skipName(hit + 3);
                loop cursor < size and code.at(cursor) == "$" {
                    cursor = code.skipName(cursor + 1);
                }
                continue;
            }
        }
        var endPos := code.skipName(hit);
        loop endPos < size and code.at(endPos) == "$" {
            endPos = code.skipName(endPos + 1);
        }
        tok := code.slice(hit, endPos);
        matchedDecl := findLocalDecl(tok, startBlockId, declHead, declBlockIds, parentBlockIds, declPrev);
        if matchedDecl >= 0 {
            mut found.pushBack(declIdxs[matchedDecl]);
        }
        cursor = endPos;
    }
    found
};

/** Eliminates dead pure locals, pure discarded expressions, and resulting empty scopes per lexical block using O(n + e) Map/Set reachability. */
pub pruneBlockScopedItems := fn(items: Items, target: String): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total == 0 { return items; }
    var hasPrunable := false;
    blockStack: mut List<Int> = [0];
    var stackLen := 1;
    parentBlockIds: mut List<Int> = [-1];
    var nextBlockId := 1;
    declHead: mut Map<String, Int>;
    declPrev: mut List<Int> = [];
    declBlockIds: mut List<Int> = [];
    declIdxs: mut List<Int> = [];
    declPrunables: mut List<Bool> = [];
    var declCount := 0;
    itemEvalBlocks: mut List<Int> = [];
    itemOwners: mut List<Int> = [];
    var idx := 0;
    loop idx < total {
        item := items[idx];
        curBlockId := blockStack[stackLen - 1];
        var evalBlockId := curBlockId;
        var owner := -1;
        if item.kind == ir.ITEM_KIND_ELSE_IF or item.kind == ir.ITEM_KIND_ELSE {
            if stackLen > 1 {
                _popArm := mut blockStack.popBack();
                stackLen = stackLen - 1;
            }
            parentId := blockStack[stackLen - 1];
            evalBlockId = parentId;
            newArmId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            mut parentBlockIds.pushBack(parentId);
            mut blockStack.pushBack(newArmId);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP or item.kind == ir.ITEM_KIND_FUNCTION_END {
            if stackLen > 1 {
                _popEnd := mut blockStack.popBack();
                stackLen = stackLen - 1;
            }
        } else if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_START or
        item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            newBlockId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            mut parentBlockIds.pushBack(curBlockId);
            mut blockStack.pushBack(newBlockId);
            stackLen = stackLen + 1;
            if item.kind == ir.ITEM_KIND_LOOP_SEQ and item.runtime =!= "" {
                prevD := declHead.getOr(item.runtime, -1);
                mut declPrev.pushBack(prevD);
                declHead[item.runtime] = declCount;
                mut declBlockIds.pushBack(newBlockId);
                mut declIdxs.pushBack(idx);
                mut declPrunables.pushBack(false);
                declCount = declCount + 1;
            }
        } else if item.kind == ir.ITEM_KIND_DISCARD {
            if (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code) {
                owner = -2;
                hasPrunable = true;
            }
        } else if evalBlockId > 0 and isTopDeclKind(item.kind) and item.runtime =!= "" {
            canPruneDecl := (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code);
            if canPruneDecl {
                owner = idx;
                hasPrunable = true;
            }
            prevD := declHead.getOr(item.runtime, -1);
            mut declPrev.pushBack(prevD);
            declHead[item.runtime] = declCount;
            mut declBlockIds.pushBack(evalBlockId);
            mut declIdxs.pushBack(idx);
            mut declPrunables.pushBack(canPruneDecl);
            declCount = declCount + 1;
        }
        (mut itemEvalBlocks).pushBack(evalBlockId);
        mut itemOwners.pushBack(owner);
        idx = idx + 1;
    }
    if not hasPrunable { return items; }

    depTargets: mut List<Int> = [];
    var depTotal := 0;
    depStarts: mut List<Int> = [];
    depEnds: mut List<Int> = [];

    resolvedOwners: mut List<Int> = [];
    ownerItemsHead: mut Map<Int, Int>;
    ownerItemsNext: mut List<Int> = [];
    var idx2 := 0;
    loop idx2 < total {
        item := items[idx2];
        evalBlock := itemEvalBlocks[idx2];
        var owner2 := itemOwners[idx2];
        mut depStarts.pushBack(depTotal);
        if owner2 == -2 {
            _skip := 0;
        } else if evalBlock > 0 and item.kind.startsWithAt(0, "Assign") and item.runtime =!= "" {
            matchedDecl := findLocalDecl(item.runtime, evalBlock, declHead, declBlockIds, parentBlockIds, declPrev);
            if matchedDecl >= 0 and declPrunables[matchedDecl] and (target == ir.TARGET_TS or not isCUnsupportedItem(item)) and
            isSideEffectFreeCode(target, item.code) {
                owner2 = declIdxs[matchedDecl];
                depsA := collectLocalDeclDeps(item.code, evalBlock, declCount, declHead, declBlockIds, parentBlockIds, declPrev, declIdxs);
                loop depsA as dt { mut depTargets.pushBack(dt); depTotal = depTotal + 1; }
            } else {
                depsB := collectLocalDeclDeps(item.runtime + " " + item.code, evalBlock, declCount, declHead, declBlockIds, parentBlockIds, declPrev, declIdxs);
                loop depsB as dt { mut depTargets.pushBack(dt); depTotal = depTotal + 1; }
            }
        } else {
            depsC := collectLocalDeclDeps(item.code, evalBlock, declCount, declHead, declBlockIds, parentBlockIds, declPrev, declIdxs);
            loop depsC as dt { mut depTargets.pushBack(dt); depTotal = depTotal + 1; }
        }
        (mut depEnds).pushBack(depTotal);
        mut resolvedOwners.pushBack(owner2);
        if owner2 >= 0 {
            prevOwnerItem := ownerItemsHead.getOr(owner2, -1);
            mut ownerItemsNext.pushBack(prevOwnerItem);
            ownerItemsHead[owner2] = idx2;
        } else {
            mut ownerItemsNext.pushBack(-1);
        }
        idx2 = idx2 + 1;
    }

    liveDecls: mut Set<Int>;
    queue: mut List<Int> = [];
    var qHead := 0;
    var qTail := 0;
    var seedIdx := 0;
    loop seedIdx < total {
        if resolvedOwners[seedIdx] == -1 {
            var dp := depStarts[seedIdx];
            dpEnd := depEnds[seedIdx];
            loop dp < dpEnd {
                dep := depTargets[dp];
                if not liveDecls.has(dep) {
                    mut liveDecls.add(dep);
                    mut queue.pushBack(dep);
                    qTail = qTail + 1;
                }
                dp = dp + 1;
            }
        }
        seedIdx = seedIdx + 1;
    }
    loop qHead < qTail {
        declItemIdx := queue[qHead];
        qHead = qHead + 1;
        var ownedItem := ownerItemsHead.getOr(declItemIdx, -1);
        loop ownedItem >= 0 {
            var dp := depStarts[ownedItem];
            dpEnd := depEnds[ownedItem];
            loop dp < dpEnd {
                dep := depTargets[dp];
                if not liveDecls.has(dep) {
                    mut liveDecls.add(dep);
                    mut queue.pushBack(dep);
                    qTail = qTail + 1;
                }
                dp = dp + 1;
            }
            ownedItem = ownerItemsNext[ownedItem];
        }
    }

    peeled: mut Items = [];
    var peeledLen := 0;
    var k := 0;
    loop k < total {
        ownk := resolvedOwners[k];
        keepItem := ownk == -1 or (ownk >= 0 and liveDecls.has(ownk));
        if keepItem {
            cur := items[k];
            if cur.kind == ir.ITEM_KIND_END_SCOPE and peeledLen > 0 and peeled[peeledLen - 1].kind == ir.ITEM_KIND_SCOPE {
                _dropScope := mut peeled.popBack();
                peeledLen = peeledLen - 1;
            } else {
                mut peeled.pushBack(cur);
                peeledLen = peeledLen + 1;
            }
        }
        k = k + 1;
    }
    peeled
};

/** Simplifies statement-level `if` / `else if` / `else` chains and `loop false` blocks with compile-time constant Bool conditions in a single O(n) pass. */
pub simplifyConstantBranches := fn(items: Items, target: String): Items {
    trueLit := ir.targetBoolLiteralCode(target, true);
    falseLit := ir.targetBoolLiteralCode(target, false);
    var hasConstBranch := false;
    var hasCUnsupported := false;
    var scanFnDepth := 0;
    var scanImportedFn := false;
    loop items as scanItem {
        if scanItem.kind == ir.ITEM_KIND_FUNCTION_START {
            if scanFnDepth == 0 {
                scanImportedFn = isImportedModuleFnRuntime(scanItem.runtime);
            }
            scanFnDepth = scanFnDepth + 1;
        } else if scanItem.kind == ir.ITEM_KIND_FUNCTION_END {
            if scanFnDepth > 0 { scanFnDepth = scanFnDepth - 1; }
            if scanFnDepth == 0 { scanImportedFn = false; }
        }
        if ((scanItem.kind == ir.ITEM_KIND_IF or scanItem.kind == ir.ITEM_KIND_ELSE_IF) and
        (scanItem.code == trueLit or scanItem.code == falseLit)) or
        (scanItem.kind == ir.ITEM_KIND_LOOP and scanItem.code == falseLit) {
            hasConstBranch = true;
        }
        if target =!= ir.TARGET_TS and not scanImportedFn and not isImportedModuleRuntime(scanItem.runtime) and isCUnsupportedItem(scanItem) {
            hasCUnsupported = true;
        }
    }
    if not hasConstBranch or hasCUnsupported { return items; }
    frameKinds: mut List<Int> = [];
    frameModes: mut List<Int> = [];
    frameTakens: mut List<Bool> = [];
    frameSkips: mut List<Bool> = [];
    frameParentSkips: mut List<Bool> = [];
    var stackLen := 0;
    out: mut Items = [];
    loop items as item {
        currentlySkipping := if stackLen > 0 { frameSkips[stackLen - 1] } else { false };
        if item.kind == ir.ITEM_KIND_IF {
            if currentlySkipping {
                mut frameKinds.pushBack(0);
                mut frameModes.pushBack(0);
                mut frameTakens.pushBack(false);
                mut frameSkips.pushBack(true);
                mut frameParentSkips.pushBack(true);
                stackLen = stackLen + 1;
            } else if item.code == falseLit {
                mut frameKinds.pushBack(1);
                mut frameModes.pushBack(0);
                mut frameTakens.pushBack(false);
                mut frameSkips.pushBack(true);
                mut frameParentSkips.pushBack(false);
                stackLen = stackLen + 1;
            } else if item.code == trueLit {
                mut out.pushBack((kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                mut frameKinds.pushBack(1);
                mut frameModes.pushBack(2);
                mut frameTakens.pushBack(true);
                mut frameSkips.pushBack(false);
                mut frameParentSkips.pushBack(false);
                stackLen = stackLen + 1;
            } else {
                mut out.pushBack(item);
                mut frameKinds.pushBack(1);
                mut frameModes.pushBack(1);
                mut frameTakens.pushBack(false);
                mut frameSkips.pushBack(false);
                mut frameParentSkips.pushBack(false);
                stackLen = stackLen + 1;
            }
        } else if item.kind == ir.ITEM_KIND_ELSE_IF {
            if stackLen > 0 and not frameParentSkips[stackLen - 1] and frameKinds[stackLen - 1] == 1 {
                mode := mut frameModes.popBack();
                taken := mut frameTakens.popBack();
                _prevSkip := mut frameSkips.popBack();
                var newMode := mode;
                var newTaken := taken;
                var newSkip := true;
                if taken {
                    newSkip = true;
                } else if item.code == falseLit {
                    newSkip = true;
                } else if item.code == trueLit {
                    if mode == 0 {
                        mut out.pushBack((kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                        newMode = 2;
                    } else {
                        mut out.pushBack((kind = ir.ITEM_KIND_ELSE, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                        newMode = 1;
                    }
                    newTaken = true;
                    newSkip = false;
                } else {
                    if mode == 0 {
                        mut out.pushBack((kind = ir.ITEM_KIND_IF, name = item.name, runtime = item.runtime, code = item.code, intValue = item.intValue, textValue = item.textValue));
                        newMode = 1;
                    } else {
                        mut out.pushBack(item);
                        newMode = 1;
                    }
                    newTaken = false;
                    newSkip = false;
                }
                (mut frameModes).pushBack(newMode);
                mut frameTakens.pushBack(newTaken);
                mut frameSkips.pushBack(newSkip);
            }
        } else if item.kind == ir.ITEM_KIND_ELSE {
            if stackLen > 0 and not frameParentSkips[stackLen - 1] and frameKinds[stackLen - 1] == 1 {
                mode := mut frameModes.popBack();
                taken := mut frameTakens.popBack();
                _prevSkip := mut frameSkips.popBack();
                var newMode := mode;
                var newTaken := true;
                var newSkip := true;
                if taken {
                    newSkip = true;
                } else if mode == 0 {
                    mut out.pushBack((kind = ir.ITEM_KIND_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                    newMode = 2;
                    newSkip = false;
                } else {
                    mut out.pushBack(item);
                    newMode = 1;
                    newSkip = false;
                }
                (mut frameModes).pushBack(newMode);
                mut frameTakens.pushBack(newTaken);
                mut frameSkips.pushBack(newSkip);
            }
        } else if item.kind == ir.ITEM_KIND_END_IF {
            if stackLen > 0 {
                kind := mut frameKinds.popBack();
                mode := mut frameModes.popBack();
                _taken := mut frameTakens.popBack();
                _skip := mut frameSkips.popBack();
                parentSkip := mut frameParentSkips.popBack();
                stackLen = stackLen - 1;
                if not parentSkip and kind == 1 {
                    if mode == 1 {
                        mut out.pushBack(item);
                    } else if mode == 2 {
                        mut out.pushBack((kind = ir.ITEM_KIND_END_SCOPE, name = "synthetic", runtime = "", code = "", intValue = 0, textValue = ""));
                    }
                }
            }
        } else if item.kind == ir.ITEM_KIND_LOOP and item.code == falseLit {
            mut frameKinds.pushBack(0);
            mut frameModes.pushBack(0);
            mut frameTakens.pushBack(false);
            mut frameSkips.pushBack(true);
            mut frameParentSkips.pushBack(true);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_START or
        item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            if not currentlySkipping { mut out.pushBack(item); }
            (mut frameKinds).pushBack(0);
            mut frameModes.pushBack(0);
            mut frameTakens.pushBack(false);
            mut frameSkips.pushBack(currentlySkipping);
            mut frameParentSkips.pushBack(currentlySkipping);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_FUNCTION_END or
        item.kind == ir.ITEM_KIND_END_LOOP {
            if stackLen > 0 {
                _kind := mut frameKinds.popBack();
                _mode := mut frameModes.popBack();
                _taken := mut frameTakens.popBack();
                _skip := mut frameSkips.popBack();
                parentSkip := mut frameParentSkips.popBack();
                stackLen = stackLen - 1;
                if not parentSkip { mut out.pushBack(item); }
            } else {
                mut out.pushBack(item);
            }
        } else {
            if not currentlySkipping { mut out.pushBack(item); }
        }
    }
    out
};

/** Unwraps synthetic scopes introduced by constant-branch simplification when they contain no direct local declarations, in O(n) time. */
unwrapSyntheticScopes := fn(items: Items): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total == 0 { return items; }
    openIdxs: mut List<Int> = [];
    isSynths: mut List<Bool> = [];
    hasDecls: mut List<Bool> = [];
    var stackLen := 0;
    dropSet: mut Set<Int>;
    var hasDrop := false;
    var hasAnySynth := false;
    var idx := 0;
    loop idx < total {
        item := items[idx];
        if item.kind == ir.ITEM_KIND_SCOPE {
            isSynth := item.name == "synthetic";
            if isSynth { hasAnySynth = true; }
            (mut openIdxs).pushBack(idx);
            mut isSynths.pushBack(isSynth);
            mut hasDecls.pushBack(false);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ or
        item.kind == ir.ITEM_KIND_FUNCTION_START {
            mut openIdxs.pushBack(idx);
            mut isSynths.pushBack(false);
            mut hasDecls.pushBack(false);
            stackLen = stackLen + 1;
        } else if item.kind == ir.ITEM_KIND_END_SCOPE {
            if stackLen > 0 {
                openIdx := mut openIdxs.popBack();
                isSynth := mut isSynths.popBack();
                hasDecl := mut hasDecls.popBack();
                stackLen = stackLen - 1;
                if isSynth and not hasDecl {
                    mut dropSet.add(openIdx);
                    mut dropSet.add(idx);
                    hasDrop = true;
                }
            }
        } else if item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP or
        item.kind == ir.ITEM_KIND_FUNCTION_END {
            if stackLen > 0 {
                _openIdx := mut openIdxs.popBack();
                _isSynth := mut isSynths.popBack();
                _hasDecl := mut hasDecls.popBack();
                stackLen = stackLen - 1;
            }
        } else if stackLen > 0 and isSynths[stackLen - 1] and not hasDecls[stackLen - 1] and
        (isTopDeclKind(item.kind) or item.kind == ir.ITEM_KIND_PURE_GLOBAL) {
            _oldDecl := mut hasDecls.popBack();
            mut hasDecls.pushBack(true);
        }
        idx = idx + 1;
    }
    if not hasAnySynth or not hasDrop { return items; }
    out: mut Items = [];
    var k := 0;
    loop k < total {
        if not dropSet.has(k) {
            mut out.pushBack(items[k]);
        }
        k = k + 1;
    }
    out
};

/** True when `kind` is a mutable scalar `var` declaration eligible for straight-line dead-store and constant propagation. */
isVarScalarKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_VAR_INT or kind == ir.ITEM_KIND_VAR_STRING or kind == ir.ITEM_KIND_VAR_BOOL or kind == ir.ITEM_KIND_VAR_FLOAT
};

/** True when `kind` is a scalar reassignment eligible for straight-line dead-store and constant propagation. */
isAssignScalarKind := fn(kind: String): Bool {
    kind == ir.ITEM_KIND_ASSIGN_INT or kind == ir.ITEM_KIND_ASSIGN_STRING or kind == ir.ITEM_KIND_ASSIGN_BOOL or kind == ir.ITEM_KIND_ASSIGN_FLOAT
};

/** True when `code` is an atomic TS scalar literal (`true`, `false`, `"..."`, `[0-9]+n`, or `(-[0-9]+n)`). */
isSimpleTsScalarLiteral := fn(code: String): Bool {
    if code == "true" or code == "false" { return true; }
    size := code.length();
    if size < 2 { return false; }
    first := code.at(0);
    if first == "\"" {
        if code.at(size - 1) =!= "\"" { return false; }
        var i := 1;
        loop i < size - 1 {
            ch := code.at(i);
            if ch == "\\" {
                i = i + 2;
                if i > size - 1 { return false; }
                continue;
            }
            if ch == "\"" { return false; }
            i = i + 1;
        }
        return true;
    }
    if code.at(size - 1) == "n" {
        var i := 0;
        loop i < size - 1 {
            if not code.at(i).isDigit() { return false; }
            i = i + 1;
        }
        return size >= 2;
    }
    if size >= 5 and code.startsWithAt(0, "(-") and code.at(size - 2) == "n" and code.at(size - 1) == ")" {
        var i := 2;
        loop i < size - 2 {
            if not code.at(i).isDigit() { return false; }
            i = i + 1;
        }
        return true;
    }
    false
};

/** Replaces one element at `index` in a bounded small list of Strings. */
setSmallTextAt := fn(values: List<String>, index: Int, value: String): List<String> {
    out: mut List<String> = [];
    var i := 0;
    loop values as item {
        mut out.pushBack(if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Replaces one element at `index` in a bounded small list of Ints. */
setSmallIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> {
    out: mut List<Int> = [];
    var i := 0;
    loop values as item {
        mut out.pushBack(if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Replaces one element at `index` in a bounded small list of Bools. */
setSmallBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> {
    out: mut List<Bool> = [];
    var i := 0;
    loop values as item {
        mut out.pushBack(if i == index { value } else { item });
        i = i + 1;
    }
    out
};

/** Finds `name` in bounded `activeNames` (size <= 64), or returns -1. */
findActiveVarSlot := fn(activeNames: List<String>, activeCount: Int, name: String): Int {
    var i := 0;
    loop i < activeCount {
        if activeNames[i] == name { return i; }
        i = i + 1;
    }
    -1
};

/** Substitutes active literal `var` identifiers in `code` (outside strings, property accesses, and arrow functions) in O(|code|) time, returning a pipe-bag of any remaining active slot indices read. */
rewriteAndMarkActiveReads := fn(code: String, activeSet: TokenBuckets, activeNames: List<String>, activeConstCodes: List<String>, activeRead: List<Bool>, activeCount: Int, allowSub: Bool): (code: String, readPipe: String, changed: Bool) {
    if activeCount == 0 or code == "" {
        return (code = code, readPipe = "", changed = false);
    }
    size := code.length();
    canSub := allowSub and code.indexOf("=>", 0) < 0 and
    code.indexOf("{", 0) < 0 and code.indexOf(" = ", 0) < 0 and
    code.indexOf("===", 0) < 0 and code.indexOf("!==", 0) < 0;
    parts: mut List<String> = [];
    var segStart := 0;
    var changed := false;
    var readPipe := "";
    var pos := 0;
    loop pos < size {
        ch := code.at(pos);
        if ch == "\"" {
            pos = pos + 1;
            loop pos < size {
                sCh := code.at(pos);
                if sCh == "\\" {
                    pos = pos + 2;
                    continue;
                }
                pos = pos + 1;
                if sCh == "\"" { break; }
            }
            continue;
        }
        if ch.isNameStart() {
            var end := pos + 1;
            loop end < size and (code.at(end).isNameContinue() or code.at(end) == "$") {
                end = end + 1;
            }
            isProp := pos > 0 and code.at(pos - 1) == ".";
            if not isProp {
                tok := code.slice(pos, end);
                if tokenBucketHas(activeSet, tok) {
                    slot := findActiveVarSlot(activeNames, activeCount, tok);
                    if slot >= 0 {
                        constVal := activeConstCodes[slot];
                        if canSub and constVal =!= "" {
                            if pos > segStart {
                                mut parts.pushBack(code.slice(segStart, pos));
                            }
                            (mut parts).pushBack(constVal);
                            segStart = end;
                            changed = true;
                        } else if not activeRead[slot] {
                            slotTag := "|" + slot.toText() + "|";
                            if readPipe.indexOf(slotTag, 0) < 0 {
                                readPipe = if readPipe == "" { slotTag } else { readPipe + slot.toText() + "|" };
                            }
                        }
                    }
                }
            }
            pos = end;
            continue;
        }
        pos = pos + 1;
    }
    if not changed {
        return (code = code, readPipe = readPipe, changed = false);
    }
    if segStart < size {
        mut parts.pushBack(code.slice(segStart, size));
    }
    (code = parts.join(""), readPipe = readPipe, changed = true)
};

/** True when `code` mentions identifier `targetName` outside string literals and property accesses, in O(|code|) time. */
codeMentionsIdent := fn(code: String, targetName: String): Bool {
    if code == "" or code.indexOf(targetName, 0) < 0 { return false; }
    size := code.length();
    var pos := 0;
    loop pos < size {
        ch := code.at(pos);
        if ch == "\"" {
            pos = pos + 1;
            loop pos < size {
                sCh := code.at(pos);
                if sCh == "\\" {
                    pos = pos + 2;
                    continue;
                }
                pos = pos + 1;
                if sCh == "\"" { break; }
            }
            continue;
        }
        if ch.isNameStart() {
            var end := pos + 1;
            loop end < size and (code.at(end).isNameContinue() or code.at(end) == "$") {
                end = end + 1;
            }
            if not (pos > 0 and code.at(pos - 1) == ".") and code.slice(pos, end) == targetName {
                return true;
            }
            pos = end;
            continue;
        }
        pos = pos + 1;
    }
    false
};

/** Performs straight-line basic-block dead-store elimination and scalar literal propagation on `var` bindings in O(n + B) time. */
pub optimizeStraightLineVars := fn(items: Items, target: String): Items {
    if target =!= ir.TARGET_TS { return items; }
    var total := 0;
    var hasVarOrAssign := false;
    loop items as scanItem {
        total = total + 1;
        if isVarScalarKind(scanItem.kind) or isAssignScalarKind(scanItem.kind) {
            hasVarOrAssign = true;
        }
    }
    if total == 0 or not hasVarOrAssign { return items; }

    var activeSet: mut Set<String>;
    var activeNames: List<String> = [];
    var activeDeclIdxs: List<Int> = [];
    var activeDeclMerged: List<Bool> = [];
    var activeDeclCodes: List<String> = [];
    var activeWriteIdxs: List<Int> = [];
    var activeWriteIsDecl: List<Bool> = [];
    var activeWritePure: List<Bool> = [];
    var activeRead: List<Bool> = [];
    var activeConstCodes: List<String> = [];
    var activeCount := 0;

    dropSet: mut Set<Int>;
    var hasDrops := false;
    overrideIdxs: mut List<Int> = [];
    overrideCodes: mut List<String> = [];
    var overrideCount := 0;
    var anyRewrite := false;
    outItems: mut Items = [];

    var idx := 0;
    loop idx < total {
        item := items[idx];
        kind := item.kind;
        if kind == ir.ITEM_KIND_SOURCE_LOC or kind == ir.ITEM_KIND_COMMENT {
            mut outItems.pushBack(item);
            idx = idx + 1;
            continue;
        }
        isBarrier := kind == ir.ITEM_KIND_IF or kind == ir.ITEM_KIND_ELSE_IF or kind == ir.ITEM_KIND_ELSE or kind == ir.ITEM_KIND_END_IF or
        kind == ir.ITEM_KIND_LOOP or kind == ir.ITEM_KIND_LOOP_SEQ or kind == ir.ITEM_KIND_END_LOOP or
        kind == ir.ITEM_KIND_SCOPE or kind == ir.ITEM_KIND_END_SCOPE or
        kind == ir.ITEM_KIND_FUNCTION_START or kind == ir.ITEM_KIND_FUNCTION_END or
        kind == ir.ITEM_KIND_RETURN or kind == ir.ITEM_KIND_BREAK or kind == ir.ITEM_KIND_CONTINUE or
        kind == ir.ITEM_KIND_UNREACHABLE or kind == ir.ITEM_KIND_MAIN_STOP or
        kind == ir.ITEM_KIND_CALL or kind == ir.ITEM_KIND_DISCARD or kind == ir.ITEM_KIND_END_OUTPUT;

        isPreFlushBarrier := kind == ir.ITEM_KIND_ELSE_IF or kind == ir.ITEM_KIND_ELSE or kind == ir.ITEM_KIND_END_IF or
        kind == ir.ITEM_KIND_LOOP or kind == ir.ITEM_KIND_END_LOOP or
        kind == ir.ITEM_KIND_SCOPE or kind == ir.ITEM_KIND_END_SCOPE or
        kind == ir.ITEM_KIND_FUNCTION_START or kind == ir.ITEM_KIND_FUNCTION_END or
        kind == ir.ITEM_KIND_DISCARD;
        rewritten := if isPreFlushBarrier {
            (code = item.code, readPipe = "", changed = false)
        } else {
            rewriteAndMarkActiveReads(item.code, activeSet, activeNames, activeConstCodes, activeRead, activeCount, true)
        };
        newCode := rewritten.code;
        if rewritten.readPipe =!= "" {
            nextReadFlags: mut List<Bool> = [];
            var rIdx := 0;
            loop rIdx < activeCount {
                tag := "|" + rIdx.toText() + "|";
                mut nextReadFlags.pushBack(activeRead[rIdx] or rewritten.readPipe.indexOf(tag, 0) >= 0);
                rIdx = rIdx + 1;
            }
            activeRead = nextReadFlags;
        }
        if rewritten.changed { anyRewrite = true; }
        codePure := isSideEffectFreeCode(target, newCode) and newCode.indexOf("=>", 0) < 0;
        updatedItem := if rewritten.changed {
            (kind = item.kind, name = item.name, runtime = item.runtime, code = newCode, intValue = item.intValue, textValue = item.textValue)
        } else {
            item
        };
        mut outItems.pushBack(updatedItem);

        if isBarrier or not codePure {
            var s := 0;
            loop s < activeCount {
                if activeDeclMerged[s] {
                    mut overrideIdxs.pushBack(activeDeclIdxs[s]);
                    mut overrideCodes.pushBack(activeDeclCodes[s]);
                    overrideCount = overrideCount + 1;
                }
                s = s + 1;
            }
            activeSet = emptyTokenBuckets();
            activeNames = [];
            activeDeclIdxs = [];
            activeDeclMerged = [];
            activeDeclCodes = [];
            activeWriteIdxs = [];
            activeWriteIsDecl = [];
            activeWritePure = [];
            activeRead = [];
            activeConstCodes = [];
            activeCount = 0;
        } else if isVarScalarKind(kind) and item.runtime =!= "" {
            litCode := if isSimpleTsScalarLiteral(newCode) { newCode } else { "" };
            if activeCount < 64 {
                mut activeSet.add(item.runtime);
                nextNames: mut List<String> = [];
                nextDeclIdxs: mut List<Int> = [];
                nextDeclMerged: mut List<Bool> = [];
                nextDeclCodes: mut List<String> = [];
                nextWriteIdxs: mut List<Int> = [];
                nextWriteIsDecl: mut List<Bool> = [];
                nextWritePure: mut List<Bool> = [];
                nextRead: mut List<Bool> = [];
                nextConstCodes: mut List<String> = [];
                var copyI := 0;
                loop copyI < activeCount {
                    mut nextNames.pushBack(activeNames[copyI]);
                    mut nextDeclIdxs.pushBack(activeDeclIdxs[copyI]);
                    mut nextDeclMerged.pushBack(activeDeclMerged[copyI]);
                    mut nextDeclCodes.pushBack(activeDeclCodes[copyI]);
                    mut nextWriteIdxs.pushBack(activeWriteIdxs[copyI]);
                    mut nextWriteIsDecl.pushBack(activeWriteIsDecl[copyI]);
                    mut nextWritePure.pushBack(activeWritePure[copyI]);
                    mut nextRead.pushBack(activeRead[copyI]);
                    mut nextConstCodes.pushBack(activeConstCodes[copyI]);
                    copyI = copyI + 1;
                }
                (mut nextNames).pushBack(item.runtime);
                mut nextDeclIdxs.pushBack(idx);
                mut nextDeclMerged.pushBack(false);
                mut nextDeclCodes.pushBack("");
                mut nextWriteIdxs.pushBack(idx);
                mut nextWriteIsDecl.pushBack(true);
                mut nextWritePure.pushBack(codePure);
                mut nextRead.pushBack(false);
                mut nextConstCodes.pushBack(litCode);
                activeNames = nextNames;
                activeDeclIdxs = nextDeclIdxs;
                activeDeclMerged = nextDeclMerged;
                activeDeclCodes = nextDeclCodes;
                activeWriteIdxs = nextWriteIdxs;
                activeWriteIsDecl = nextWriteIsDecl;
                activeWritePure = nextWritePure;
                activeRead = nextRead;
                activeConstCodes = nextConstCodes;
                activeCount = activeCount + 1;
            }
        } else if isAssignScalarKind(kind) and item.runtime =!= "" {
            litCode := if isSimpleTsScalarLiteral(newCode) { newCode } else { "" };
            slot := if activeSet.has(item.runtime) { findActiveVarSlot(activeNames, activeCount, item.runtime) } else { -1 };
            if slot >= 0 {
                canDropPrev := not activeRead[slot] and activeWritePure[slot] and not codeMentionsIdent(newCode, item.runtime);
                if canDropPrev and activeWriteIsDecl[slot] and (idx == activeWriteIdxs[slot] + 1 or litCode =!= "") {
                    activeDeclMerged = setSmallBoolAt(activeDeclMerged, slot, true);
                    activeDeclCodes = setSmallTextAt(activeDeclCodes, slot, newCode);
                    activeWritePure = setSmallBoolAt(activeWritePure, slot, codePure);
                    activeRead = setSmallBoolAt(activeRead, slot, false);
                    activeConstCodes = setSmallTextAt(activeConstCodes, slot, litCode);
                    mut dropSet.add(idx);
                    hasDrops = true;
                } else {
                    if canDropPrev and not activeWriteIsDecl[slot] {
                        mut dropSet.add(activeWriteIdxs[slot]);
                        hasDrops = true;
                    }
                    activeWriteIdxs = setSmallIntAt(activeWriteIdxs, slot, idx);
                    activeWriteIsDecl = setSmallBoolAt(activeWriteIsDecl, slot, false);
                    activeWritePure = setSmallBoolAt(activeWritePure, slot, codePure);
                    activeRead = setSmallBoolAt(activeRead, slot, false);
                    activeConstCodes = setSmallTextAt(activeConstCodes, slot, litCode);
                }
            } else if activeCount < 64 {
                mut activeSet.add(item.runtime);
                nextNames: mut List<String> = [];
                nextDeclIdxs: mut List<Int> = [];
                nextDeclMerged: mut List<Bool> = [];
                nextDeclCodes: mut List<String> = [];
                nextWriteIdxs: mut List<Int> = [];
                nextWriteIsDecl: mut List<Bool> = [];
                nextWritePure: mut List<Bool> = [];
                nextRead: mut List<Bool> = [];
                nextConstCodes: mut List<String> = [];
                var copyI := 0;
                loop copyI < activeCount {
                    mut nextNames.pushBack(activeNames[copyI]);
                    mut nextDeclIdxs.pushBack(activeDeclIdxs[copyI]);
                    mut nextDeclMerged.pushBack(activeDeclMerged[copyI]);
                    mut nextDeclCodes.pushBack(activeDeclCodes[copyI]);
                    mut nextWriteIdxs.pushBack(activeWriteIdxs[copyI]);
                    mut nextWriteIsDecl.pushBack(activeWriteIsDecl[copyI]);
                    mut nextWritePure.pushBack(activeWritePure[copyI]);
                    mut nextRead.pushBack(activeRead[copyI]);
                    mut nextConstCodes.pushBack(activeConstCodes[copyI]);
                    copyI = copyI + 1;
                }
                (mut nextNames).pushBack(item.runtime);
                mut nextDeclIdxs.pushBack(-1);
                mut nextDeclMerged.pushBack(false);
                mut nextDeclCodes.pushBack("");
                mut nextWriteIdxs.pushBack(idx);
                mut nextWriteIsDecl.pushBack(false);
                mut nextWritePure.pushBack(codePure);
                mut nextRead.pushBack(false);
                mut nextConstCodes.pushBack(litCode);
                activeNames = nextNames;
                activeDeclIdxs = nextDeclIdxs;
                activeDeclMerged = nextDeclMerged;
                activeDeclCodes = nextDeclCodes;
                activeWriteIdxs = nextWriteIdxs;
                activeWriteIsDecl = nextWriteIsDecl;
                activeWritePure = nextWritePure;
                activeRead = nextRead;
                activeConstCodes = nextConstCodes;
                activeCount = activeCount + 1;
            }
        }
        idx = idx + 1;
    }

    var sEnd := 0;
    loop sEnd < activeCount {
        if activeDeclMerged[sEnd] {
            mut overrideIdxs.pushBack(activeDeclIdxs[sEnd]);
            mut overrideCodes.pushBack(activeDeclCodes[sEnd]);
            overrideCount = overrideCount + 1;
        }
        sEnd = sEnd + 1;
    }

    if not anyRewrite and not hasDrops and overrideCount == 0 {
        return items;
    }

    finalItems: mut Items = [];
    var ovPos := 0;
    var k := 0;
    loop k < total {
        if hasDrops and dropSet.has(k) {
            k = k + 1;
            continue;
        }
        cur := outItems[k];
        if ovPos < overrideCount and overrideIdxs[ovPos] == k {
            mut finalItems.pushBack((kind = cur.kind, name = cur.name, runtime = cur.runtime,
            code = overrideCodes[ovPos], intValue = cur.intValue, textValue = cur.textValue));
            ovPos = ovPos + 1;
        } else {
            mut finalItems.pushBack(cur);
        }
        k = k + 1;
    }
    finalItems
};

/** Removes unreachable top-level function bodies and side-effect-free code across root and inner blocks for `target`. */
/** True when `arg` is a side-effect-free simple identifier or numeric/boolean literal safe to duplicate during `-O3` leaf inlining. */
isSimpleInlineArg := fn(arg: String): Bool {
    len := arg.length();
    if len == 0 { return false; }
    var i := 0;
    if arg.at(0) == "-" {
        if len == 1 { return false; }
        i = 1;
    }
    loop i < len {
        ch := arg.at(i);
        if not ch.isNameContinue() and ch =!= "$" and ch =!= "." { return false; }
        i = i + 1;
    }
    true
};

/** Replaces whole-token occurrences of `paramRt` with `argCode` outside quoted strings. */
replaceParamToken := fn(body: String, paramRt: String, argCode: String): String {
    if paramRt == "" { return body; }
    if body.indexOf(paramRt, 0) < 0 { return body; }
    pLen := paramRt.length();
    bLen := body.length();
    out: mut tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    loop cursor < bLen {
        ch := body.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = syntax.skipAliasString(body, cursor);
            continue;
        }
        if body.startsWithAt(cursor, paramRt) {
            prevOk := cursor == 0 or (not body.at(cursor - 1).isNameContinue() and body.at(cursor - 1) =!= "$");
            afterPos := cursor + pLen;
            nextOk := afterPos >= bLen or (not body.at(afterPos).isNameContinue() and body.at(afterPos) =!= "$");
            if prevOk and nextOk {
                if cursor > flushed { mut out.append(body.slice(flushed, cursor)); }
                mut out.append(argCode);
                cursor = afterPos;
                flushed = cursor;
                continue;
            }
        }
        cursor = cursor + 1;
    }
    if flushed == 0 { return body; }
    if flushed < bLen { mut out.append(body.slice(flushed, bLen)); }
    out.build()
};

/** Widens TS literal arguments (`2`, `2n`, `true`/`false`) when inlining so strict `tsc` does not flag `TS2367` on comparisons. */
widenInlineArgForTarget := fn(target: String, rawArg: String): String {
    if target =!= ir.TARGET_TS { return rawArg; }
    if rawArg == "true" or rawArg == "false" {
        return "(" + rawArg + " as boolean)";
    }
    first := rawArg.at(0);
    if first.isDigit() or first == "-" {
        if rawArg.endsWith("n") {
            return "(" + rawArg + " as bigint)";
        }
        return "(" + rawArg + " as number)";
    }
    rawArg
};

/** True when `runtime` is a host-invoked Play bridge export or callback that must retain its standalone function symbol at `-O3`. */
isHostPlayBridgeFn := fn(runtime: String): Bool {
    runtime.contains("litePlayCanvas") or
    runtime.contains("litePlayAudio") or
    runtime.contains("litePlayKeepalive") or
    runtime.endsWith("_onCanvasInit") or
    runtime.endsWith("_canvas_onInit") or
    runtime.endsWith("_onCanvasUpdate") or
    runtime.endsWith("_canvas_onUpdate") or
    runtime.endsWith("_onCanvasKeyDown") or
    runtime.endsWith("_canvas_onKeyDown") or
    runtime.endsWith("_onCanvasKeyUp") or
    runtime.endsWith("_canvas_onKeyUp") or
    runtime.endsWith("_onCanvasPointerMove") or
    runtime.endsWith("_canvas_onPointerMove") or
    runtime.endsWith("_onCanvasPointerDown") or
    runtime.endsWith("_canvas_onPointerDown") or
    runtime.endsWith("_onCanvasPointerUp") or
    runtime.endsWith("_canvas_onPointerUp")
};

/** Inlines small single-`RETURN` pure leaf functions (0, 1, or 2 parameters) at simple call sites up to `maxBodySize`. */
inlineSingleExprLeafFunctions := fn(items: Items, target: String, maxBodySize: Int): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total < 3 or maxBodySize <= 0 { return items; }
    paramPrefix := "lite_";
    leafBodies: mut Map<String, String>;
    leafParams1: mut Map<String, String>;
    leafParams2: mut Map<String, String>;
    var fnDepth := 0;
    var i := 0;
    loop i < total {
        it := items[i];
        if it.kind == ir.ITEM_KIND_FUNCTION_START {
            var bodyIdx := i + 1;
            loop bodyIdx < total and (items[bodyIdx].kind == ir.ITEM_KIND_SOURCE_LOC or items[bodyIdx].kind == ir.ITEM_KIND_COMMENT) {
                bodyIdx = bodyIdx + 1;
            }
            if bodyIdx < total and items[bodyIdx].kind == ir.ITEM_KIND_TRANSFER_TRY and items[bodyIdx].intValue == 0 {
                bodyIdx = bodyIdx + 1;
            }
            loop bodyIdx < total and (items[bodyIdx].kind == ir.ITEM_KIND_SOURCE_LOC or items[bodyIdx].kind == ir.ITEM_KIND_COMMENT) {
                bodyIdx = bodyIdx + 1;
            }
            var afterRetIdx := bodyIdx + 1;
            loop afterRetIdx < total and (items[afterRetIdx].kind == ir.ITEM_KIND_SOURCE_LOC or items[afterRetIdx].kind == ir.ITEM_KIND_COMMENT) {
                afterRetIdx = afterRetIdx + 1;
            }
            if fnDepth == 0 and not isHostPlayBridgeFn(it.runtime) and afterRetIdx < total and items[bodyIdx].kind == ir.ITEM_KIND_RETURN and items[afterRetIdx].kind == ir.ITEM_KIND_FUNCTION_END {
                retCode := items[bodyIdx].code;
                rLen := retCode.length();
                isPureLeaf := rLen > 0 and rLen <= maxBodySize and
                retCode.indexOf(it.runtime + "(", 0) < 0 and
                retCode.indexOf(";", 0) < 0 and
                retCode.indexOf("return ", 0) < 0 and
                retCode.indexOf("lite$fault", 0) < 0 and
                retCode.indexOf("lite$exit", 0) < 0;
                if isPureLeaf {
                    enc := it.textValue;
                    if enc == "" {
                        leafBodies[it.runtime] = retCode;
                        leafParams1[it.runtime] = "";
                        leafParams2[it.runtime] = "";
                    } else {
                        pipe1 := enc.indexOf("|", 0);
                        if pipe1 < 0 {
                            eqPos := enc.indexOf("=", 0);
                            if eqPos > 0 {
                                pName := enc.slice(0, eqPos);
                                leafBodies[it.runtime] = retCode;
                                leafParams1[it.runtime] = paramPrefix + pName;
                                leafParams2[it.runtime] = "";
                            }
                        } else if enc.indexOf("|", pipe1 + 1) < 0 {
                            part1 := enc.slice(0, pipe1);
                            part2 := enc.slice(pipe1 + 1, enc.length());
                            eq1 := part1.indexOf("=", 0);
                            eq2 := part2.indexOf("=", 0);
                            if eq1 > 0 and eq2 > 0 {
                                p1 := paramPrefix + part1.slice(0, eq1);
                                p2 := paramPrefix + part2.slice(0, eq2);
                                if p1 =!= p2 {
                                    leafBodies[it.runtime] = retCode;
                                    leafParams1[it.runtime] = p1;
                                    leafParams2[it.runtime] = p2;
                                }
                            }
                        }
                    }
                }
            }
            fnDepth = fnDepth + 1;
        } else if it.kind == ir.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
        }
        i = i + 1;
    }
    if leafBodies.size() == 0 { return items; }

    fnPrefix := if target == ir.TARGET_TS { "liteFn" } else { "lt_fn_" };
    rewritten: mut Items = [];
    loop items as it {
        newCode := if it.kind == ir.ITEM_KIND_FUNCTION_START or it.kind == ir.ITEM_KIND_FUNCTION_END or it.code == "" {
            it.code
        } else {
            inlineLeafCallsInCode(it.code, target, fnPrefix, leafBodies, leafParams1, leafParams2)
        };
        mut rewritten.pushBack((kind = it.kind, name = it.name, runtime = it.runtime, code = newCode, intValue = it.intValue, textValue = it.textValue));
    }
    rewritten
};

/** Rewrites eligible leaf function calls inside `code` using `leafBodies`/`leafParams1`/`leafParams2`. */
inlineLeafCallsInCode := fn(code: String, target: String, fnPrefix: String, leafBodies: Map<String, String>, leafParams1: Map<String, String>, leafParams2: Map<String, String>): String {
    firstHit := code.indexOf(fnPrefix, 0);
    if code == "" or firstHit < 0 { return code; }
    cLen := code.length();
    out: mut tb.TextBuilder;
    var copyFrom := 0;
    var cursor := 0;
    var nextFn := firstHit;
    var nextDQuote := code.indexOf("\"", 0);
    var nextSQuote := code.indexOf("'", 0);
    var changed := false;
    loop nextFn >= 0 {
        if nextDQuote >= 0 and nextDQuote < cursor { nextDQuote = code.indexOf("\"", cursor); }
        if nextSQuote >= 0 and nextSQuote < cursor { nextSQuote = code.indexOf("'", cursor); }
        var qHit := -1;
        if nextDQuote >= 0 and nextDQuote < nextFn { qHit = nextDQuote; }
        if nextSQuote >= 0 and nextSQuote < nextFn and (qHit < 0 or nextSQuote < qHit) { qHit = nextSQuote; }
        if qHit >= 0 {
            cursor = syntax.skipAliasString(code, qHit);
            if nextFn < cursor { nextFn = code.indexOf(fnPrefix, cursor); }
            continue;
        }
        prevOk := nextFn == 0 or (not code.at(nextFn - 1).isNameContinue() and code.at(nextFn - 1) =!= "$");
        if prevOk {
            var nameEnd := code.skipName(nextFn);
            loop nameEnd < cLen and code.at(nameEnd) == "$" {
                nameEnd = code.skipName(nameEnd + 1);
            }
            fnName := code.slice(nextFn, nameEnd);
            if nameEnd < cLen and code.at(nameEnd) == "(" and leafBodies.has(fnName) {
                var pDepth := 1;
                var scan := nameEnd + 1;
                var commaPos := -1;
                var commaCount := 0;
                loop scan < cLen and pDepth > 0 {
                    sc := code.at(scan);
                    if sc == "\"" or sc == "'" {
                        scan = syntax.skipAliasString(code, scan);
                        continue;
                    }
                    if sc == "(" { pDepth = pDepth + 1; }
                    else if sc == ")" { pDepth = pDepth - 1; }
                    else if sc == "," and pDepth == 1 {
                        commaPos = scan;
                        commaCount = commaCount + 1;
                    }
                    scan = scan + 1;
                }
                if pDepth == 0 {
                    rawArgs := code.slice(nameEnd + 1, scan - 1).trim();
                    p1 := leafParams1[fnName];
                    p2 := leafParams2[fnName];
                    body := leafBodies[fnName];
                    if p1 == "" and rawArgs == "" {
                        if nextFn > copyFrom { mut out.append(code.slice(copyFrom, nextFn)); }
                        mut out.append("(" + body + ")");
                        copyFrom = scan;
                        cursor = scan;
                        changed = true;
                        nextFn = code.indexOf(fnPrefix, cursor);
                        continue;
                    } else if p1 =!= "" and p2 == "" and commaCount == 0 and isSimpleInlineArg(rawArgs) {
                        subArg := widenInlineArgForTarget(target, rawArgs);
                        if nextFn > copyFrom { mut out.append(code.slice(copyFrom, nextFn)); }
                        mut out.append("(" + replaceParamToken(body, p1, subArg) + ")");
                        copyFrom = scan;
                        cursor = scan;
                        changed = true;
                        nextFn = code.indexOf(fnPrefix, cursor);
                        continue;
                    } else if p1 =!= "" and p2 =!= "" and commaCount == 1 and commaPos > nameEnd {
                        arg1 := code.slice(nameEnd + 1, commaPos).trim();
                        arg2 := code.slice(commaPos + 1, scan - 1).trim();
                        if isSimpleInlineArg(arg1) and isSimpleInlineArg(arg2) and
                        arg1.indexOf(p2, 0) < 0 {
                            sub1 := widenInlineArgForTarget(target, arg1);
                            sub2 := widenInlineArgForTarget(target, arg2);
                            step1 := replaceParamToken(body, p1, sub1);
                            step2 := replaceParamToken(step1, p2, sub2);
                            if nextFn > copyFrom { mut out.append(code.slice(copyFrom, nextFn)); }
                            mut out.append("(" + step2 + ")");
                            copyFrom = scan;
                            cursor = scan;
                            changed = true;
                            nextFn = code.indexOf(fnPrefix, cursor);
                            continue;
                        }
                    }
                }
            }
        }
        cursor = nextFn + 1;
        nextFn = code.indexOf(fnPrefix, cursor);
    }
    if not changed { return code; }
    if copyFrom < cLen { mut out.append(code.slice(copyFrom, cLen)); }
    out.build()
};

/** Extracts reachable runtime tokens (`lite...` / `lt_...`) from `code` outside quoted strings. */
extractReachableCodeTokens := fn(code: String): List<String> {
    out: mut List<String> = [];
    var nextLite := code.indexOf("lite", 0);
    var nextLt := code.indexOf("lt_", 0);
    if nextLite < 0 and nextLt < 0 { return out; }
    var nextQuote := code.indexOf("\"", 0);
    size := code.length();
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = code.indexOf("lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = code.indexOf("lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return out; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = code.indexOf("\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = syntax.skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := code.at(hit - 1);
            if prev == "$" or prev.isNameContinue() {
                cursor = code.skipName(hit + 3);
                loop cursor < size and code.at(cursor) == "$" {
                    cursor = code.skipName(cursor + 1);
                }
                continue;
            }
        }
        var endPos := code.skipName(hit);
        loop endPos < size and code.at(endPos) == "$" {
            endPos = code.skipName(endPos + 1);
        }
        name := code.slice(hit, endPos);
        token := if name.startsWithAt(0, "lt_fn_") or name.startsWithAt(0, "liteFn$") or
        name.startsWithAt(0, "liteFn_") {
            name + "("
        } else {
            name
        };
        mut out.pushBack(token);
        cursor = endPos;
    }
    out
};

/** True when `runtime` names an emitted imported-module value symbol. */
isImportedModuleRuntime := fn(runtime: String): Bool {
    runtime.startsWithAt(0, "lite$m$") or runtime.startsWithAt(0, "lt_m_")
};

/** True when `runtime` names an emitted imported-module function symbol. */
isImportedModuleFnRuntime := fn(runtime: String): Bool {
    runtime.startsWithAt(0, "liteFn$") or runtime.indexOf("__", 0) >= 0
};

/** Evaluates a pure constant emitted integer expression (`+`, `-`, `*`, parentheses) without overflow; returns `(ok = false, value = 0)` otherwise. */
evalConstIntAtom := fn(src: String, start: Int, target: String): (ok: Bool, value: Int, next: Int) {
    n := src.length();
    var p := start;
    loop p < n and src.at(p) == " " { p = p + 1; }
    if p >= n { return (ok = false, value = 0, next = p); }
    if src.at(p) == "(" {
        inner := evalConstIntAdd(src, p + 1, target);
        if not inner.ok { return (ok = false, value = 0, next = p); }
        var q := inner.next;
        loop q < n and src.at(q) == " " { q = q + 1; }
        if q < n and src.at(q) == ")" {
            return (ok = true, value = inner.value, next = q + 1);
        }
        return (ok = false, value = 0, next = p);
    }
    if target == ir.TARGET_C {
        if src.startsWithAt(p, "INT64_C(") {
            var q := p + 8;
            var neg := false;
            if q < n and src.at(q) == "-" { neg = true; q = q + 1; }
            dStart := q;
            loop q < n and src.at(q).isDigit() { q = q + 1; }
            if q > dStart and q < n and src.at(q) == ")" {
                parsed := src.slice(if neg { p + 8 } else { dStart }, q).toInt();
                if parsed.ok { return (ok = true, value = parsed.value, next = q + 1); }
            }
        }
        return (ok = false, value = 0, next = p);
    }
    var neg := false;
    var q := p;
    if q < n and src.at(q) == "-" { neg = true; q = q + 1; }
    dStart := q;
    loop q < n and src.at(q).isDigit() { q = q + 1; }
    if q > dStart and q < n and src.at(q) == "n" {
        parsed := src.slice(if neg { p } else { dStart }, q).toInt();
        if parsed.ok { return (ok = true, value = parsed.value, next = q + 1); }
    }
    (ok = false, value = 0, next = p)
};

/** Evaluates a multiplicative sequence of pure constant emitted integer atoms without overflow. */
evalConstIntMul := fn(src: String, start: Int, target: String): (ok: Bool, value: Int, next: Int) {
    n := src.length();
    var cur := evalConstIntAtom(src, start, target);
    if not cur.ok { return cur; }
    loop true {
        var p := cur.next;
        loop p < n and src.at(p) == " " { p = p + 1; }
        if p < n and src.at(p) == "*" {
            rhs := evalConstIntAtom(src, p + 1, target);
            if not rhs.ok { return (ok = false, value = 0, next = p); }
            prod := cur.value.checkedMul(rhs.value);
            if not prod.ok { return (ok = false, value = 0, next = p); }
            cur = (ok = true, value = prod.value, next = rhs.next);
        } else {
            break;
        }
    }
    cur
};

/** Evaluates an additive/subtractive sequence of pure constant emitted integer products without overflow. */
evalConstIntAdd := fn(src: String, start: Int, target: String): (ok: Bool, value: Int, next: Int) {
    n := src.length();
    var cur := evalConstIntMul(src, start, target);
    if not cur.ok { return cur; }
    loop true {
        var p := cur.next;
        loop p < n and src.at(p) == " " { p = p + 1; }
        if p < n and (src.at(p) == "+" or src.at(p) == "-") {
            isAdd := src.at(p) == "+";
            rhs := evalConstIntMul(src, p + 1, target);
            if not rhs.ok { return (ok = false, value = 0, next = p); }
            comb := if isAdd { cur.value.checkedAdd(rhs.value) } else { cur.value.checkedSub(rhs.value) };
            if not comb.ok { return (ok = false, value = 0, next = p); }
            cur = (ok = true, value = comb.value, next = rhs.next);
        } else {
            break;
        }
    }
    cur
};

/** Folds a pure constant integer expression string into a single target literal when overflow-free. */
foldPureConstIntCode := fn(code: String, target: String): String {
    trimmed := code.trim();
    if trimmed == "" { return code; }
    hasOp := trimmed.indexOf(" + ", 0) >= 0 or trimmed.indexOf(" - ", 0) >= 0 or trimmed.indexOf(" * ", 0) >= 0;
    if not hasOp { return code; }
    res := evalConstIntAdd(trimmed, 0, target);
    if not res.ok { return code; }
    var tail := res.next;
    loop tail < trimmed.length() and trimmed.at(tail) == " " { tail = tail + 1; }
    if tail =!= trimmed.length() { return code; }
    if target == ir.TARGET_C {
        if res.value == integer.intMin { "INT64_MIN" } else { "INT64_C(" + res.value.toText() + ")" }
    } else {
        res.value.toText() + "n"
    }
};

/** Constant-folds pure integer scalar local, assignment, and return expressions across `items`. */
foldConstantScalarItems := fn(items: Items, target: String): Items {
    out: mut Items = [];
    loop items as item {
        if item.kind == ir.ITEM_KIND_LOCAL_INT or item.kind == ir.ITEM_KIND_VAR_INT or item.kind == ir.ITEM_KIND_ASSIGN_INT or item.kind == ir.ITEM_KIND_RETURN {
            folded := foldPureConstIntCode(item.code, target);
            if folded =!= item.code {
                mut out.pushBack((kind = item.kind, name = item.name, runtime = item.runtime, code = folded, intValue = item.intValue, textValue = item.textValue));
                continue;
            }
        }
        (mut out).pushBack(item);
    }
    out
};

/** Drops `ITEM_KIND_COMMENT` items according to `preserveComments` and `preserveDocs`. */
filterCommentItems := fn(items: Items, preserveComments: Bool, preserveDocs: Bool): Items {
    if preserveComments and preserveDocs { return items; }
    var hasComment := false;
    loop items as it {
        if it.kind == ir.ITEM_KIND_COMMENT {
            hasComment = true;
            break;
        }
    }
    if not hasComment { return items; }
    out: mut Items = [];
    loop items as it {
        if it.kind == ir.ITEM_KIND_COMMENT {
            isDoc := it.intValue == 1;
            if (isDoc and preserveDocs) or (not isDoc and preserveComments) {
                mut out.pushBack(it);
            }
        } else {
            mut out.pushBack(it);
        }
    }
    out
};

/** Runs the composable per-pass optimization pipeline driven purely by `cfg` (`OptConfig`) and whole-program reachability DCE for `target`. */
pub filterReachableItemsWithConfig := fn(items: Items, target: String, cfg: optCfg.OptConfig): Items {
    var pruned := filterCommentItems(items, cfg.preserveComments, cfg.preserveDocs);
    if cfg.constFold {
        pruned = foldConstantScalarItems(pruned, target);
    }
    inlineLim := optCfg.effectiveInlineMaxSize(cfg);
    if inlineLim > 0 {
        pruned = inlineSingleExprLeafFunctions(pruned, target, inlineLim);
    }
    maxRounds := optCfg.effectiveOptRounds(cfg);
    if maxRounds > 0 {
        var round := 0;
        loop round < maxRounds {
            var beforeCount := 0;
            loop pruned { beforeCount = beforeCount + 1; }
            var cur := pruned;
            if cfg.branchSimplify {
                cur = unwrapSyntheticScopes(simplifyConstantBranches(cur, target));
            }
            if cfg.deadStore {
                cur = optimizeStraightLineVars(cur, target);
            }
            if cfg.blockPrune {
                cur = unwrapSyntheticScopes(pruneBlockScopedItems(cur, target));
            }
            pruned = cur;
            var afterCount := 0;
            loop pruned { afterCount = afterCount + 1; }
            round = round + 1;
            if round >= 1 and afterCount == beforeCount and maxRounds >= 2 {
                /* Already converged in size; stop after round 1 when no further shrinkage occurred. */
                if round == 1 { break; }
            }
        }
    }
    pruneUserDecls := cfg.dce;
    var hasPrunable := false;
    reachable: mut Set<String>;
    queue: mut List<String> = [];
    fnStarts: mut Map<String, Int>;
    fnEnds: mut Map<String, Int>;
    pureDeclIdx: mut Map<String, Int>;
    prunedCount := pruned.length();
    var fnDepth := 0;
    var blockDepth := 0;
    var nextIsPure := false;
    var curFnTok := "";
    var curFnStart := -1;
    var pIdx := 0;
    loop pIdx < prunedCount {
        item := pruned[pIdx];
        if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
            nextIsPure = true;
            pIdx = pIdx + 1;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_START {
            if fnDepth == 0 {
                curFnTok = item.runtime + "(";
                curFnStart = pIdx + 1;
                if not pruneUserDecls and not isImportedModuleFnRuntime(item.runtime) {
                    if not reachable.has(curFnTok) {
                        mut reachable.add(curFnTok);
                        mut queue.pushBack(curFnTok);
                    }
                } else {
                    hasPrunable = true;
                }
            }
            fnDepth = fnDepth + 1;
            nextIsPure = false;
            pIdx = pIdx + 1;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_END {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
            if fnDepth == 0 and curFnTok =!= "" {
                mut fnStarts.set(curFnTok, curFnStart);
                mut fnEnds.set(curFnTok, pIdx);
                curFnTok = "";
                curFnStart = -1;
            }
            nextIsPure = false;
            pIdx = pIdx + 1;
            continue;
        }
        if fnDepth > 0 {
            nextIsPure = false;
            pIdx = pIdx + 1;
            continue;
        }
        isTopDecl := blockDepth == 0 and isTopDeclKind(item.kind);
        canPruneDecl := pruneUserDecls or isImportedModuleRuntime(item.runtime);
        isPureDecl := isTopDecl and canPruneDecl and (nextIsPure or ((target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code)));
        nextIsPure = false;
        if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
            blockDepth = blockDepth + 1;
            codeReachableTokensQueue(item.code, mut reachable, mut queue);
        } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if isPureDecl {
            hasPrunable = true;
            mut pureDeclIdx.set(item.runtime, pIdx);
        } else if item.kind =!= ir.ITEM_KIND_IMPORT and item.kind =!= ir.ITEM_KIND_PUBLIC_FUNCTION and item.kind =!= ir.ITEM_KIND_PUBLIC_TYPE_OP and item.kind =!= ir.ITEM_KIND_PUBLIC_VALUE and
        item.kind =!= ir.ITEM_KIND_PUBLIC_TYPE and item.kind =!= ir.ITEM_KIND_NOOP and item.kind =!= ir.ITEM_KIND_SOURCE_LOC and item.kind =!= ir.ITEM_KIND_COMMENT {
            codeReachableTokensQueue(item.code, mut reachable, mut queue);
            if item.kind.startsWithAt(0, "Assign") and item.runtime =!= "" {
                if not reachable.has(item.runtime) {
                    mut reachable.add(item.runtime);
                    mut queue.pushBack(item.runtime);
                }
            }
        }
        pIdx = pIdx + 1;
    }
    if not hasPrunable { return pruned; }

    scanned: mut Set<String>;
    var qHead := 0;
    loop qHead < queue.length() {
        tok := queue[qHead];
        qHead = qHead + 1;
        if scanned.has(tok) { continue; }
        fHit := fnStarts.get(tok);
        if fHit.found {
            mut scanned.add(tok);
            fEnd := fnEnds.get(tok).value;
            var j := fHit.value;
            loop j < fEnd {
                bItem := pruned[j];
                codeReachableTokensQueue(bItem.code, mut reachable, mut queue);
                if bItem.kind.startsWithAt(0, "Assign") and bItem.runtime =!= "" {
                    if not reachable.has(bItem.runtime) {
                        mut reachable.add(bItem.runtime);
                        mut queue.pushBack(bItem.runtime);
                    }
                }
                j = j + 1;
            }
            continue;
        }
        pHit := pureDeclIdx.get(tok);
        if pHit.found {
            mut scanned.add(tok);
            codeReachableTokensQueue(pruned[pHit.value].code, mut reachable, mut queue);
        }
    }

    filtered: mut Items = [];
    var keepFnDepth := 0;
    var keepBlockDepth := 0;
    var keepFn := false;
    var nextDeclPure := false;
    loop pruned as item {
        if item.kind == ir.ITEM_KIND_PURE_GLOBAL {
            nextDeclPure = true;
            continue;
        }
        if item.kind == ir.ITEM_KIND_FUNCTION_START {
            nextDeclPure = false;
            if keepFnDepth == 0 { keepFn = reachable.has(item.runtime + "("); }
            keepFnDepth = keepFnDepth + 1;
            if keepFn { mut filtered.pushBack(item); }
        } else if item.kind == ir.ITEM_KIND_FUNCTION_END {
            nextDeclPure = false;
            wasKeeping := keepFn;
            if keepFnDepth > 0 { keepFnDepth = keepFnDepth - 1; }
            if keepFnDepth == 0 { keepFn = false; }
            if wasKeeping { mut filtered.pushBack(item); }
        } else if keepFnDepth > 0 {
            nextDeclPure = false;
            if keepFn { mut filtered.pushBack(item); }
        } else {
            dropDecl := keepBlockDepth == 0 and isTopDeclKind(item.kind) and
            (pruneUserDecls or isImportedModuleRuntime(item.runtime)) and
            (nextDeclPure or ((target == ir.TARGET_TS or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code))) and
            not reachable.has(item.runtime);
            nextDeclPure = false;
            if item.kind == ir.ITEM_KIND_SCOPE or item.kind == ir.ITEM_KIND_IF or item.kind == ir.ITEM_KIND_LOOP or item.kind == ir.ITEM_KIND_LOOP_SEQ {
                keepBlockDepth = keepBlockDepth + 1;
            } else if item.kind == ir.ITEM_KIND_END_SCOPE or item.kind == ir.ITEM_KIND_END_IF or item.kind == ir.ITEM_KIND_END_LOOP {
                if keepBlockDepth > 0 { keepBlockDepth = keepBlockDepth - 1; }
            }
            if not dropDecl { mut filtered.pushBack(item); }
        }
    }
    filtered
};
