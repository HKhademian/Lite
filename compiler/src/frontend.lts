                rootIndex := localIndex(locals, localName);
                if rootIndex >= 0 and locals[rootIndex].depth == 0 {
                    failAt(source, localStart, prefix, "duplicate top-level value " + localName);
                }
            }
            position = skipTrivia(source, position, prefix);
            var parsed := intParsed("", 0, true, position);
            var declInitState := "init";
            var rhsDiverged := false;
            if textLib.startsWithAt(source, position, ":=") {
                position = skipTrivia(source, position + 2, prefix);
                parsed = parseInitializerExpression(target, source, position, prefix, locals, functions, functionParams, currentName, "", stmtCtxs);
                rejectNonValueBinding(source, localStart, prefix, parsed.kind, localName);
                if declaredWritable and not isListKind(parsed.kind) {
                    failAt(source, localStart, prefix, "mut requires a List value, got " + displayKind(parsed.kind));
                }
            } else if position < size and textLib.at(source, position) == ":" {
                if declaredWritable { failAt(source, localStart, prefix, "var mut cannot be combined with explicit type annotation"); }
                typed := parseLocalType(source, position + 1, prefix, aliases);
                declaredWritable = typed.writable;
                position = skipTrivia(source, typed.next, prefix);
                if isSingleEquals(source, position) {
                    rhsStart := skipTrivia(source, position + 1, prefix);
                    reservedEnd := isReservedInitMarker(source, rhsStart, prefix);
                    zeroEnd := isZeroInitLiteral(source, rhsStart, prefix);
                    if reservedEnd >= 0 {
                        if isListKind(typed.kind) { failAt(source, localStart, prefix, "reserved storage is not supported for List"); }
                        declInitState = "uninit";
                        parsed = zeroParsed(target, typed.kind, reservedEnd);
                    } else if zeroEnd >= 0 and not numeric.isNumericKind(typed.kind) {
                        parsed = zeroParsed(target, typed.kind, zeroEnd);
                    } else {
                        parsed = parseInitializerExpression(target, source, rhsStart, prefix, locals, functions, functionParams, currentName, typed.kind, stmtCtxs);
                        if not isCompatibleKind(typed.kind, parsed.kind) {
                            failAt(source, localStart, prefix, "cannot initialize " + displayKind(typed.kind) + " with " + displayKind(parsed.kind));
                        }
                        rhsDiverged = parsed.kind == "Never";
                        converted := assignValueCode(target, typed.kind, parsed.kind, parsed.code);
                        parsed = (kind = typed.kind, code = converted, intValue = parsed.intValue, textValue = parsed.textValue, constant = parsed.constant, next = parsed.next);
                    }
                } else {
                    parsed = zeroParsed(target, typed.kind, position);
                }
            } else {
                failAt(source, position, prefix, "expected := or : after local name " + localName);
            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after local declaration " + localName); }
            position = statementNext;
            runtime := localRuntimeName(target, locals, localName, moduleKey, depth);
            listLib.pushBack(mut locals, (name = localName, runtime = runtime, kind = parsed.kind,
                mutable = true, writable = declaredWritable, depth = depth, constant = false, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue, initState = declInitState));
            if currentLive and not currentStopped {
                if rhsDiverged {
                    listLib.pushBack(mut items, (kind = expressionStatementKind("Never", false, "Call", currentResult), name = "", runtime = "",
                        code = parsed.code, intValue = 0, textValue = ""));
                    if codeHasRawTransfer(parsed.code) {
                        listLib.pushBack(mut transferCodes, parsed.code);
                        transferCount = transferCount + 1;
                    }
                } else {
                    itemCode := copiedValueCode(target, parsed.kind, parsed.code);
                    listLib.pushBack(mut items, (kind = "Var" + storageKind(parsed.kind), name = localName, runtime = runtime,
                        code = itemCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
                    if codeHasRawTransfer(itemCode) {
                        listLib.pushBack(mut transferCodes, itemCode);
                        transferCount = transferCount + 1;
                    }
                }
            }
            if rhsDiverged {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            continue;
        }
        if name == "else" {
            failAt(source, nameStart, prefix, "unexpected else");
        }
        if isReservedWord(name) { unsupportedFeature(source, nameStart, name, prefix); }
        if textLib.startsWithAt(source, position, ":=") and textLib.wordAt(source, afterDefinition, "type") {
            if blockCount =!= 0 or depth =!= 0 {
                failAt(source, nameStart, prefix, "type aliases are only allowed at top level");
            }
            var earlierAlias := false;
            loop aliases as alias {
                if alias.name == name and alias.at < nameStart { earlierAlias = true; }
            }
            if earlierAlias {
                failAt(source, nameStart, prefix, "duplicate type alias " + name);
            }
            typePosition := skipTrivia(source, position + 2, prefix);
            targetStart := skipTrivia(source, typePosition + 4, prefix);
            aliasIndex := aliasIndexAt(aliases, nameStart);
            if aliasIndex < 0 {
                unsupportedAliasTarget(source, targetStart, prefix, "target");
            }
            aliasEntry := aliases[aliasIndex];
            if aliasEntry.target == "" {
                unsupportedAliasTarget(source, targetStart, prefix, "target");
            }
            seenAliases: mut List<String> = [];
            resolvedType := resolveTypeText(source, targetStart, prefix, aliases, aliasEntry.target, seenAliases);
            if listLib.listContainsText(publishedTypes, name) {
                listLib.pushBack(mut items, (kind = "PublicType", name = name, runtime = "", code = resolvedType,
                    intValue = 0, textValue = ""));
            }
            afterTarget := consumeStatementEnd(source, aliasEntry.end, prefix);
            if afterTarget < 0 { unsupportedAliasTarget(source, aliasEntry.at, prefix, "target"); }
            position = afterTarget;
            continue;
        }
        if textLib.startsWithAt(source, position, ":=") {
            afterDeclare := skipTrivia(source, position + 2, prefix);
            if textLib.wordAt(source, afterDeclare, "fn") {
                if blockCount =!= 0 or depth =!= 0 {
                    failAt(source, nameStart, prefix, "function definitions are only allowed at top level");
                }
                if findFunction(functions, name) >= 0 {
                    failAt(source, nameStart, prefix, "duplicate function " + name);
                }
                rootIndex := localIndex(locals, name);
                if rootIndex >= 0 and locals[rootIndex].depth == 0 {
                    failAt(source, nameStart, prefix, "duplicate top-level value " + name);
                }
                position = skipTrivia(source, afterDeclare + 2, prefix);
                listIntrinsic := moduleIdentity == "lite.core.list.v1" and (name == "pushBack" or name == "popBack" or name == "pushFront" or name == "popFront");
                header := parseFunctionHeader(source, position, prefix, aliases, listIntrinsic);
                position = skipTrivia(source, header.next, prefix);
                rejectMisplacedTag(source, position, prefix, "unexpected block tag in function header");
                if position < size and textLib.at(source, position) == ";" {
                    hostRuntime := coreHostFunction(moduleIdentity, name, header.params, header.result);
                    if not listLib.listContainsText(publishedFunctions, name) or hostRuntime == "" {
                        failAt(source, nameStart, prefix, "bodyless function declaration has no matching core host binding");
                    }
                    position = skipTrivia(source, position + 1, prefix);
                    listLib.pushBack(mut functions, (name = name, runtime = hostRuntime, result = header.result,
                        first = parameterTotal, count = header.count));
                    if currentLive {
                        listLib.pushBack(mut items, (kind = "PublicFunction", name = name, runtime = hostRuntime, code = header.result,
                            intValue = header.count, textValue = header.params));
                    }
                    continue;
                }
                if header.count < 0 {
                    failAt(source, nameStart, prefix, "variadic parameters are reserved for registered core host declarations");
                }
                if header.genericType =!= "" {
                    failAt(source, nameStart, prefix, "generic function bodies are not supported");
                }
                position = expectSymbol(source, position, "{", prefix);
                functionRuntime := moduleFunctionRuntime(target, moduleKey, name);
                listLib.pushBack(mut functions, (name = name, runtime = functionRuntime, result = header.result,
                    first = parameterTotal, count = header.count));
                if listLib.listContainsText(publishedFunctions, name) {
                    listLib.pushBack(mut items, (kind = "PublicFunction", name = name, runtime = functionRuntime, code = header.result,
                        intValue = header.count, textValue = header.params));
                }
                if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = "FunctionStart", name = name, runtime = functionRuntime,
                    code = header.result, intValue = header.count, textValue = header.params)); }
                fnTryId := nextStmtCtxId;
                nextStmtCtxId = nextStmtCtxId + 1;
                fnTryKey = "";
                if target == "ts" and currentLive and not currentStopped {
                    fnTryKey = moduleKey + "#fn#" + integer.intText(fnTryId);
                    fnTransferStart = transferCount;
                    listLib.pushBack(mut items, (kind = "TransferTry", name = "", runtime = fnTryKey, code = "", intValue = 0, textValue = ""));
                }
                listLib.pushBack(mut stmtCtxs, (id = 0, tag = "", kind = "fn", phase = "body",
                    iifeDepth = 0, valKind = header.result, valVar = "", label = "",
                    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false));
                var entryStart := 0;
                var entryIndex := 0;
                loop futureValues as future {
                    if future.at > nameStart {
                        listLib.pushBack(mut locals, (name = future.name, runtime = future.runtime, kind = future.kind,
                            mutable = false, writable = false, depth = -1, constant = false, code = future.runtime,
                            intValue = 0, textValue = "", initState = "init"));
                    }
                }
                loop entryIndex < header.count {
                    separator := textLib.indexOfText(header.params, "|", entryStart);
                    var entryEnd := textLib.length(header.params);
                    if separator >= 0 { entryEnd = separator; }
                    entry := textLib.slice(header.params, entryStart, entryEnd);
                    parameterName := paramNameOf(entry);
                    parameterKind := paramKindOf(entry);
                    runtime := "lite_" + parameterName;
                    listLib.pushBack(mut functionParams, entry);
                    listLib.pushBack(mut locals, (name = parameterName, runtime = runtime, kind = parameterKind,
                        mutable = false, writable = false, depth = 1, constant = false, code = runtime,
                        intValue = 0, textValue = "", initState = "init"));
                    parameterTotal = parameterTotal + 1;
                    entryStart = entryEnd + 1;
                    entryIndex = entryIndex + 1;
                }
                currentName = name;
                currentResult = header.result;
                listLib.pushBack(mut savedStates, (returned = currentReturned, stopped = currentStopped,
                    branchesReturned = branchesReturned, branchesStopped = branchesStopped, hasElse = hasElse, loopForever = loopForever, live = currentLive,
                    preLocalsLen = localsCount(locals), liveBranchCount = liveBranchCount));
                liveBranchCount = 0;
                currentLive = currentLive and not currentStopped;
                currentReturned = false;
                currentStopped = false;
                branchesReturned = true;
                branchesStopped = true;
                hasElse = false;
                loopForever = false;
                listLib.pushBack(mut blocks, "function");
                blockCount = blockCount + 1;
                depth = depth + 1;
                position = skipTrivia(source, position, prefix);
                continue;
            }
            if depth == 0 and blockCount == 0 {
                rootIndex := localIndex(locals, name);
                if rootIndex >= 0 and locals[rootIndex].depth == 0 {
                    failAt(source, nameStart, prefix, "duplicate top-level value " + name);
                }
            }
            position = afterDeclare;
            parsed := parseInitializerExpression(target, source, position, prefix, locals, functions, functionParams, currentName, "", stmtCtxs);
            rejectNonValueBinding(source, nameStart, prefix, parsed.kind, name);
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after local declaration " + name); }
            position = statementNext;
            runtime := localRuntimeName(target, locals, name, moduleKey, depth);
            listLib.pushBack(mut locals, (name = name, runtime = runtime, kind = parsed.kind,
                mutable = false, writable = false, depth = depth, constant = parsed.constant, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue, initState = "init"));
            if depth == 0 and blockCount == 0 and listLib.listContainsText(publishedValues, name) {
                listLib.pushBack(mut items, (kind = "PublicValue", name = name, runtime = runtime, code = parsed.kind,
                    intValue = 0, textValue = ""));
            }
            if currentLive and not currentStopped {
                itemCode := copiedValueCode(target, parsed.kind, parsed.code);
                listLib.pushBack(mut items, (kind = "Local" + storageKind(parsed.kind), name = name, runtime = runtime,
                    code = itemCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
                if codeHasRawTransfer(itemCode) {
                    listLib.pushBack(mut transferCodes, itemCode);
                    transferCount = transferCount + 1;
                }
            }
            continue;
        }
        if position < size and textLib.at(source, position) == ":" and compoundAssignOp(source, position).width == 0 {
            if depth == 0 and blockCount == 0 {
                rootIndex := localIndex(locals, name);
                if rootIndex >= 0 and locals[rootIndex].depth == 0 {
                    failAt(source, nameStart, prefix, "duplicate top-level value " + name);
                }
            }
            typed := parseLocalType(source, position + 1, prefix, aliases);
            position = skipTrivia(source, typed.next, prefix);
            var parsed := zeroParsed(target, typed.kind, position);
            var declInitState := "init";
            if isSingleEquals(source, position) {
                rhsStart := skipTrivia(source, position + 1, prefix);
                reservedEnd := isReservedInitMarker(source, rhsStart, prefix);
                zeroEnd := isZeroInitLiteral(source, rhsStart, prefix);
                if reservedEnd >= 0 {
                    if isListKind(typed.kind) { failAt(source, nameStart, prefix, "reserved storage is not supported for List"); }
                    declInitState = "uninit";
                    parsed = zeroParsed(target, typed.kind, reservedEnd);
                } else if zeroEnd >= 0 and not numeric.isNumericKind(typed.kind) {
                    parsed = zeroParsed(target, typed.kind, zeroEnd);
                } else {
                    parsed = parseInitializerExpression(target, source, rhsStart, prefix, locals, functions, functionParams, currentName, typed.kind, stmtCtxs);
                    if not isCompatibleKind(typed.kind, parsed.kind) {
                        failAt(source, nameStart, prefix, "cannot initialize " + displayKind(typed.kind) + " with " + displayKind(parsed.kind));
                    }
                }
            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after local declaration " + name); }
            position = statementNext;
            runtime := localRuntimeName(target, locals, name, moduleKey, depth);
            rhsDiverged := parsed.kind == "Never";
            assignedCode := assignValueCode(target, typed.kind, parsed.kind, parsed.code);
            listLib.pushBack(mut locals, (name = name, runtime = runtime, kind = typed.kind,
                mutable = false, writable = typed.writable, depth = depth, constant = if declInitState == "init" and not numeric.isFloatKind(typed.kind) { parsed.constant } else { false },
                code = assignedCode, intValue = parsed.intValue, textValue = parsed.textValue, initState = declInitState));
            declItemPrefix := if declInitState == "init" { "Local" } else { "Var" };
            if currentLive and not currentStopped {
                if rhsDiverged {
                    listLib.pushBack(mut items, (kind = expressionStatementKind("Never", false, "Call", currentResult), name = "", runtime = "",
                        code = assignedCode, intValue = 0, textValue = ""));
                } else {
                    listLib.pushBack(mut items, (kind = declItemPrefix + storageKind(typed.kind), name = name, runtime = runtime,
                        code = assignedCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
                }
                if codeHasRawTransfer(assignedCode) {
                    listLib.pushBack(mut transferCodes, assignedCode);
                    transferCount = transferCount + 1;
                }
            }
            if rhsDiverged {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            continue;
        }
        if isSingleEquals(source, position) {
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            if entry.initState == "init" and not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            if entry.initState == "maybe" and not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to possibly initialized immutable local " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            partialItems := parsePartialAssignIf(target, source, position, prefix, locals, functions, functionParams, currentName, nameStart, entry.kind, name, entry.runtime, stmtCtxs);
            var partialCount := 0;
            loop partialItems as partialItem {
                partialCount = partialCount + 1;
                if partialItem.kind == "End" {
                    position = partialItem.intValue;
                } else if currentLive and not currentStopped {
                    listLib.pushBack(mut items, partialItem);
                    if codeHasRawTransfer(partialItem.code) {
                        listLib.pushBack(mut transferCodes, partialItem.code);
                        transferCount = transferCount + 1;
                    }
                }
            }
            if partialCount > 0 {
                listLib.pushBack(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                    mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = entry.runtime,
                    intValue = 0, textValue = "", initState = "init"));
                continue;
            }
            parsed := parseExpressionAsCtx(target, source, position, prefix, locals, functions, functionParams, currentName, entry.kind, stmtCtxs);
            if not isCompatibleKind(entry.kind, parsed.kind) {
                failAt(source, nameStart, prefix, "cannot assign " + displayKind(parsed.kind) + " to " + displayKind(entry.kind) + " local " + name);
            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after assignment to " + name); }
            position = statementNext;
            rhsDiverged := parsed.kind == "Never";
            assignedCode := assignValueCode(target, entry.kind, parsed.kind, parsed.code);
            listLib.pushBack(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = assignedCode,
                intValue = parsed.intValue, textValue = parsed.textValue, initState = "init"));
            if currentLive and not currentStopped {
                if rhsDiverged {
                    listLib.pushBack(mut items, (kind = expressionStatementKind("Never", false, "Call", currentResult), name = "", runtime = "",
                        code = assignedCode, intValue = 0, textValue = ""));
                } else {
                    listLib.pushBack(mut items, (kind = "Assign" + storageKind(entry.kind), name = name, runtime = entry.runtime,
                        code = assignedCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
                }
                if codeHasRawTransfer(assignedCode) {
                    listLib.pushBack(mut transferCodes, assignedCode);
                    transferCount = transferCount + 1;
                }
            }
            if rhsDiverged {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            continue;
        }
        if compoundAssignOp(source, position).width > 0 {
            compound := compoundAssignOp(source, position);
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            if entry.initState =!= "init" {
                failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
            }
            if not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            opPos := position;
            position = skipTrivia(source, position + compound.width, prefix);
            parsed := parseExpressionAsCtx(target, source, position, prefix, locals, functions, functionParams, currentName, entry.kind, stmtCtxs);
            assignedCode := compoundAssignCode(target, source, opPos, prefix, entry.kind, entry.runtime, compound.baseOp, parsed);
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after assignment to " + name); }
            position = statementNext;
            listLib.pushBack(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = assignedCode,
                intValue = 0, textValue = "", initState = "init"));
            if currentLive and not currentStopped {
                listLib.pushBack(mut items, (kind = "Assign" + storageKind(entry.kind), name = name, runtime = entry.runtime,
                    code = assignedCode, intValue = 0, textValue = ""));
                if codeHasRawTransfer(assignedCode) {
                    listLib.pushBack(mut transferCodes, assignedCode);
                    transferCount = transferCount + 1;
                }
            }
            continue;
        }
        expression := parseExpressionItem(target, source, nameStart, prefix, locals, functions, functionParams, currentName,
            currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs);
        if currentLive and not currentStopped {
            listLib.pushBack(mut items, (kind = expressionStatementKind(expression.valueKind, expression.returned, "Discard", currentResult), name = expression.valueKind,
                runtime = "", code = expression.code, intValue = 0, textValue = ""));
            if codeHasRawTransfer(expression.code) {
                listLib.pushBack(mut transferCodes, expression.code);
                transferCount = transferCount + 1;
            }
        }
        if expression.returned or expression.valueKind == "Never" {
            if not currentStopped { currentReturned = true; }
            currentStopped = true;
        }
        position = expression.next;
    }
    if blockCount > 0 {
        failAt(source, size, prefix, "expected } before end of source");
    }
    if currentStopped {
        listLib.pushBack(mut items, (kind = "MainStop", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
    }
    items
}

/** Transitional numeric-module-id adapter delegating to `parseProgramWithModule`. */
pub parseProgramWithIdentity := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int,
    moduleIdentity: String): Items {
    moduleKey := if moduleId == 0 { "" } else { "m" + integer.intText(moduleId) };
    parseProgramWithModule(target, source, prefix, exports, moduleKey, moduleIdentity)
}

/** Transitional five-argument graph adapter retained until source identities reach every compiler caller. */
pub parseProgramWithExports := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int): Items {
    parseProgramWithIdentity(target, source, prefix, exports, moduleId, "")
}

/** Parses one source without imported public symbols. */
pub parseProgram := fn(target: String, source: String, prefix: String): Items {
    parseProgramWithModule(target, source, prefix, [], "", "")
}

/** Encodes all line-start character offsets once for positioned runtime arithmetic faults. */
pub lineStartCodes := fn(source: String): String {
    var code := "0";
    var position := 0;
    loop position < textLib.length(source) {
        if textLib.at(source, position) == "\n" { code = code + ", " + integer.intText(position + 1); }
        position = position + 1;
    }
    code
}
