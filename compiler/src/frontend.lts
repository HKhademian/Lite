            } else if not insideLoop(blocks) {
                failAt(source, nameStart, prefix, name + " outside loop");
            }
            if target =!= "ts" and afterExit < size and textLib.at(source, afterExit) =!= ";" and textLib.at(source, afterExit) =!= "}" {
