formatLib := import "core/format";
listLib := import "core/list";
sourceLib := import "core/source";
diagLib := import "core/diag";
numeric := import "./numeric-literals.lts";
integer := import "core/int";
tsLiteral := import "./ts-literals.lts";
cLiteral := import "./c-literals.lts";
io := import "core/io";
textLib := import "core/text";

/** Selects the TS or C backend implementation for one emitted literal operation. */
targetBoolLiteralCode := fn(target: String, value: Bool): String { if target == "ts" { tsLiteral.boolLiteralCode(value) } else { cLiteral.boolLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonChainCode := fn(target: String, codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String { if target == "ts" { tsLiteral.comparisonChainCode(codes, kinds, operators, count, position) } else { cLiteral.comparisonChainCode(codes, kinds, operators, count, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonCode := fn(target: String, op: String, kind: String, left: String, right: String): String { if target == "ts" { tsLiteral.comparisonCode(op, kind, left, right) } else { cLiteral.comparisonCode(op, kind, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetConcatCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.concatCode(left, right) } else { cLiteral.concatCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatBinaryCode := fn(target: String, op: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatBinaryCode(op, left, right, position) } else { cLiteral.floatBinaryCode(op, left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatLiteralCode := fn(target: String, digits: String, negative: Bool): String { if target == "ts" { tsLiteral.floatLiteralCode(digits, negative) } else { cLiteral.floatLiteralCode(digits, negative) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatOperandCode := fn(target: String, kind: String, code: String): String { if target == "ts" { tsLiteral.floatOperandCode(kind, code) } else { cLiteral.floatOperandCode(kind, code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatPowerCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatPowerCode(left, right, position) } else { cLiteral.floatPowerCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorDivCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorDivCode(left, right) } else { cLiteral.floorDivCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorModCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorModCode(left, right) } else { cLiteral.floorModCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntAddCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intAddCode(left, right, position) } else { cLiteral.intAddCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intDivideCode(left, right, position) } else { cLiteral.intDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorDivideCode(left, right, position) } else { cLiteral.intFloorDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorModuloCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorModuloCode(left, right, position) } else { cLiteral.intFloorModuloCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntLiteralCode := fn(target: String, value: Int, negative: Bool, digits: String): String { if target == "ts" { tsLiteral.intLiteralCode(value, negative, digits) } else { cLiteral.intLiteralCode(value, negative, digits) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntMultiplyCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intMultiplyCode(left, right, position) } else { cLiteral.intMultiplyCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntNegateCode := fn(target: String, value: String, position: Int): String { if target == "ts" { tsLiteral.intNegateCode(value, position) } else { cLiteral.intNegateCode(value, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntRemainderCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intRemainderCode(left, right, position) } else { cLiteral.intRemainderCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntSubtractCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intSubtractCode(left, right, position) } else { cLiteral.intSubtractCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetListCopyCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.listCopyCode(code) } else { cLiteral.listCopyCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetLogicCode := fn(target: String, op: String, left: String, right: String): String { if target == "ts" { tsLiteral.logicCode(op, left, right) } else { cLiteral.logicCode(op, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetNotCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.notCode(value) } else { cLiteral.notCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetTextLiteralCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.textLiteralCode(value) } else { cLiteral.textLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitEvaluationCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.unitEvaluationCode(code) } else { cLiteral.unitEvaluationCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitLiteralCode := fn(target: String): String { if target == "ts" { tsLiteral.unitLiteralCode() } else { cLiteral.unitLiteralCode() } }
/* Shared restricted front-end. Not a standalone program: a target manifest
   places the target literal encoders before this file and the emitter/driver
   after it. */
/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements: source name, hygienic runtime name, value kind, binding reassignment permission, held-data write grant, declaration block depth, constant value and target code. */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String);
/** One program or module-graph item: a report stream entry, declaration, control-flow marker, import edge, public function signature or module visit boundary. */
pub Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Parsed module/compiler items returned by parseProgram and consumed by the module collector and backend emitters. */
pub Items := type List<Item>;
/** Completion facts saved while an inner block is parsed; earlier conditional arms are joined only after a final else. */
BlockState := type (returned: Bool, stopped: Bool, branchesReturned: Bool, branchesStopped: Bool, hasElse: Bool, loopForever: Bool, live: Bool);
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := type (text: String, width: Int);
/** One previously declared top-level function: source name, result kind, first parameter entry and parameter count. */
FunctionInfo := type (name: String, runtime: String, result: String, first: Int, count: Int);
/** A later top-level scalar definition visible only while checking a deferred function body. */
FutureValue := type (name: String, runtime: String, kind: String, at: Int, intValue: Int, textValue: String);
/** One top-level transparent type alias: source name, raw target type text, declaration position and the position just after that target. */
AliasDecl := type (name: String, target: String, at: Int, end: Int);

/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := sourceLib.lineColumn(source, position);
    diagLib.fail(prefix, formatLib.decimalText(place.line) + ":" + formatLib.decimalText(place.column) + ": " + message);
}

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLib.length(source) or textLib.at(source, position) =!= symbol {
        failAt(source, position, prefix, "expected " + symbol);
    }
    position + 1
}

/** Number of consecutive `#` characters after a comment opener; zero means an ordinary comment. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not textLib.startsWithAt(source, position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < textLib.length(source) and textLib.at(source, index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`; fails at the opener when its fence never closes. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := position + 2 + fence;
    loop cursor < size {
        if textLib.at(source, cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and textLib.at(source, runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and textLib.startsWithAt(source, runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    failAt(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop true {
        if cursor >= size {
            failAt(source, position, prefix, "unterminated comment");
        }
        if textLib.startsWithAt(source, cursor, "/*") {
            innerFence := rawFenceLength(source, cursor);
            if innerFence > 0 {
                cursor = skipRawComment(source, cursor, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = cursor + 2;
            }
        } else if textLib.startsWithAt(source, cursor, "*/") {
            depth = depth - 1;
            cursor = cursor + 2;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var position := start;
    loop position < size {
        ch := textLib.at(source, position);
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            position = position + 1;
        } else if textLib.startsWithAt(source, position, "/*") {
            position = skipComment(source, position, prefix);
        } else {
            break;
        }
    }
    position
}

/** Consumes an explicit separator or an implicit boundary at EOF, a closing scope or a directly closed block expression. Returns -1 when a simple item still needs a separator. */
consumeStatementEnd := fn(source: String, position: Int, prefix: String): Int {
    next := skipTrivia(source, position, prefix);
    if next < textLib.length(source) and textLib.at(source, next) == ";" { return skipTrivia(source, next + 1, prefix); }
    if next == textLib.length(source) or textLib.at(source, next) == "}" or
        (position > 0 and textLib.at(source, position - 1) == "}") { return next; }
    -1
}

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool {
    name == "pub" or name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or
    name == "import" or name == "using" or name == "record" or name == "type" or
    name == "and" or name == "or" or name == "not" or name == "true" or name == "false"
}

/** Returns the documentation path for one reserved Lite feature. */
featureDoc := fn(name: String): String {
    if name == "loop" { "docs/loops.md" }
    else if name == "if" or name == "else" or name == "and" or name == "or" or name == "not" or
        name == "true" or name == "false" { "docs/conditionals.md" }
    else if name == "var" or name == "mut" { "docs/declarations-and-assignment.md" }
    else if name == "fn" or name == "return" { "docs/functions.md" }
    else if name == "match" { "docs/match.md" }
    else if name == "pub" { "docs/modules-and-packages.md" }
    else if name == "import" or name == "using" { "docs/modules-and-packages.md" }
    else if name == "record" or name == "type" { "docs/types-and-inference.md" }
    else if name == "break" or name == "continue" { "docs/control-flow.md" }
    else if name == "then" or name == "finally" { "docs/finally.md" }
    else { "docs/grammar-sketch.md" }
}

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit {
    failAt(source, position, prefix, "unsupported feature \"" + name + "\": see " + featureDoc(name) +
        "; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only");
}

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int {
    var index := 0;
    loop functions as entry {
        if entry.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool {
    name == "List" or name == "Float" or name == "Double" or name == "Array" or
    name == "Option" or name == "Result" or name == "record" or name == "fn"
}

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit {
    failAt(source, position, prefix, "unsupported type alias " + target +
        "; only Int, Float, String, Bool, Unit, List<T>, flat named tuples and aliases are supported");
}

/** Returns the index of the first top-level alias named `name`, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    var index := 0;
    loop aliases as alias {
        if alias.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Reads one local or module-qualified type name. */
typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) {
    firstEnd := textLib.skipName(source, position);
    first := textLib.slice(source, position, firstEnd);
    afterFirst := skipTrivia(source, firstEnd, prefix);
    if afterFirst < textLib.length(source) and textLib.at(source, afterFirst) == "." {
        memberStart := skipTrivia(source, afterFirst + 1, prefix);
        if memberStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, memberStart)) {
            failAt(source, memberStart, prefix, "expected a type name after .");
        }
        memberEnd := textLib.skipName(source, memberStart);
        member := textLib.slice(source, memberStart, memberEnd);
        return (name = first + "." + member, next = memberEnd);
    }
    (name = first, next = firstEnd)
}

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int {
    var index := 0;
    loop aliases as alias {
        if alias.at == position { return index; }
        index = index + 1;
    }
    -1
}

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool {
    textLib.length(kind) > 0 and textLib.at(kind, 0) == "("
}

/** Returns the runtime JS property name for a tuple field (`_0` when unnamed, otherwise the field label). */
pub tupleRuntimeProp := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) } else { label }
}

/** Returns the JS/TS object-literal property key for a tuple field, quoting `__proto__` to avoid prototype mutation. */
pub tupleObjectKey := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) }
    else if label == "__proto__" { "[\"__proto__\"]" }
    else { label }
}

/** Returns the number of components in one canonical flat tuple kind. */
pub tupleComponentCount := fn(kind: String): Int {
    if not isTupleKind(kind) { return 0; }
    size := textLib.length(kind);
    var cursor := 1;
    var count := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        if textLib.at(kind, cursor) =!= ":" { cursor = textLib.skipName(kind, cursor); }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        cursor = textLib.skipName(kind, cursor);
        count = count + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    count
}

/** Returns the label, scalar kind and runtime property name of component `targetIndex` in a canonical tuple kind. */
pub tupleComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) {
    size := textLib.length(kind);
    var cursor := 1;
    var index := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        var label := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            label = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = textLib.skipName(kind, cursor);
        fieldKind := textLib.slice(kind, typeStart, cursor);
        if index == targetIndex {
            return (label = label, kind = fieldKind, prop = tupleRuntimeProp(label, index));
        }
        index = index + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    (label = "", kind = "", prop = "")
}

/** True when `expectedKind` and `actualKind` are tuples with identical component counts and positional component types. */
pub tupleShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if not isTupleKind(expectedKind) or not isTupleKind(actualKind) { return false; }
    count := tupleComponentCount(expectedKind);
    if count =!= tupleComponentCount(actualKind) { return false; }
    var index := 0;
    loop index < count {
        if tupleComponent(expectedKind, index).kind =!= tupleComponent(actualKind, index).kind {
            return false;
        }
        index = index + 1;
    }
    true
}

/** Converts one tuple expression to `expectedKind` by copying positional components into the receiving labels. */
pub convertTupleValue := fn(expectedKind: String, actualKind: String, actualCode: String): String {
    count := tupleComponentCount(expectedKind);
    var fields := "";
    var index := 0;
    loop index < count {
        expectedComp := tupleComponent(expectedKind, index);
        actualComp := tupleComponent(actualKind, index);
        if index > 0 { fields = fields + ", "; }
        fields = fields + tupleObjectKey(expectedComp.label, index) + ": lite$t." + actualComp.prop;
        index = index + 1;
    }
    "(() => { const lite$t = " + actualCode + "; return { " + fields + " }; })()"
}

/** True when `actualKind` is directly `expectedKind` or a tuple with matching positional component types. */
pub isCompatibleKind := fn(expectedKind: String, actualKind: String): Bool {
    expectedKind == actualKind or tupleShapeMatches(expectedKind, actualKind)
}

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
pub isListKind := fn(kind: String): Bool {
    textLib.length(kind) > 5 and textLib.startsWithAt(kind, 0, "List<") and textLib.at(kind, textLib.length(kind) - 1) == ">"
}

/** Returns the canonical element kind from `List<ElementKind>`. */
pub listElementKind := fn(kind: String): String {
    if not isListKind(kind) { return ""; }
    textLib.slice(kind, 5, textLib.length(kind) - 1)
}

/** True when emitted target code calls `needle` outside quoted String literal text. */
codeUsesTextCall := fn(code: String, needle: String): Bool {
    size := textLib.length(code);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := textLib.at(code, cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if textLib.startsWithAt(code, cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
}

/** True when emitted target code calls the checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(")
}

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
}

/** Returns the scalar kind of tuple field `label` in canonical `kind`, or empty text when the field is absent. */
tupleFieldKind := fn(kind: String, label: String): String {
    count := tupleComponentCount(kind);
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if comp.label =!= "" and comp.label == label { return comp.kind; }
        index = index + 1;
    }
    ""
}

/** Renders one canonical kind for diagnostics, adding spaces inside flat tuples and lists. */
displayKind := fn(kind: String): String {
    if isListKind(kind) { return "List<" + displayKind(listElementKind(kind)) + ">"; }
    if not isTupleKind(kind) { return kind; }
    count := tupleComponentCount(kind);
    var result := "(";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { result = result + ", "; }
        if comp.label == "" {
            result = result + displayKind(comp.kind);
        } else {
            result = result + comp.label + ": " + displayKind(comp.kind);
        }
        index = index + 1;
    }
    if count == 1 and tupleComponent(kind, 0).label == "" { result = result + ","; }
    result + ")"
}

/** Resolves one scalar or flat named-tuple type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String {
    size := textLib.length(text);
    var cursor := skipTrivia(text, 0, prefix);
    if cursor < size and textLib.at(text, cursor) == "(" {
        cursor = skipTrivia(text, cursor + 1, prefix);
        labels: mut List<String> = [];
        var kindText := "(";
        var count := 0;
        var hadComma := false;
        var singleLabel := "";
        var singleKind := "";
        loop true {
            if cursor >= size { failAt(source, position, prefix, "expected ) in tuple type"); }
            if textLib.at(text, cursor) == ")" {
                cursor = cursor + 1;
                break;
            }
            if textLib.at(text, cursor) == "(" {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            if not textLib.isNameStart(textLib.at(text, cursor)) {
                failAt(source, position, prefix, "expected a tuple field name");
            }
            firstStart := cursor;
            firstEnd := textLib.skipName(text, cursor);
            firstName := textLib.slice(text, firstStart, firstEnd);
            afterFirst := skipTrivia(text, firstEnd, prefix);
            var label := "";
            var componentName := "";
            if afterFirst < size and textLib.at(text, afterFirst) == ":" {
                label = firstName;
                if listLib.listContainsText(labels, label) {
                    failAt(source, position, prefix, "duplicate tuple field " + label);
                }
                listLib.pushBack(mut labels, label);
                cursor = skipTrivia(text, afterFirst + 1, prefix);
                if cursor < size and textLib.at(text, cursor) == "(" {
                    failAt(source, position, prefix, "nested tuple types are not supported");
                }
                if cursor >= size or not textLib.isNameStart(textLib.at(text, cursor)) {
                    failAt(source, position, prefix, "expected a tuple field type");
                }
                componentStart := cursor;
                cursor = textLib.skipName(text, cursor);
                componentName = textLib.slice(text, componentStart, cursor);
            } else {
                componentName = firstName;
                cursor = firstEnd;
            }
            componentKind := resolveTypeText(source, position, prefix, aliases, componentName, seen);
            if isTupleKind(componentKind) {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            if isListKind(componentKind) {
                failAt(source, position, prefix, "list types inside tuples are not supported");
            }
            if componentKind == "Unit" {
                failAt(source, position, prefix, "unsupported tuple component type Unit");
            }
            if count > 0 { kindText = kindText + ","; }
            kindText = kindText + label + ":" + componentKind;
            if count == 0 { singleLabel = label; singleKind = componentKind; }
            count = count + 1;
            cursor = skipTrivia(text, cursor, prefix);
            if cursor < size and textLib.at(text, cursor) == "," {
                hadComma = true;
                cursor = skipTrivia(text, cursor + 1, prefix);
            }
        }
        if count == 0 {
            failAt(source, position, prefix, "tuple type needs at least one field");
        }
        cursor = skipTrivia(text, cursor, prefix);
        if cursor < size {
            failAt(source, position, prefix, "unexpected text after tuple type");
        }
        if count == 1 and singleLabel == "" and not hadComma { return singleKind; }
        return kindText + ")";
    }
    parsedName := typeNameAt(text, cursor, prefix);
    after := parsedName.next;
    name := parsedName.name;
    afterTrivia := skipTrivia(text, after, prefix);
    if name == "List" and afterTrivia < size and textLib.at(text, afterTrivia) == "<" {
        innerStart := skipTrivia(text, afterTrivia + 1, prefix);
        if innerStart >= size or textLib.at(text, innerStart) == ">" {
            failAt(source, position, prefix, "expected a list element type");
        }
        var scan := innerStart;
        var depth := 0;
        var close := -1;
        loop scan < size {
            ch := textLib.at(text, scan);
            if ch == "<" {
                depth = depth + 1;
            } else if ch == ">" {
                if depth == 0 {
                    close = scan;
                    break;
                }
                depth = depth - 1;
            }
            scan = scan + 1;
        }
        if close < 0 {
            failAt(source, position, prefix, "expected > in list type");
        }
        innerText := textLib.slice(text, innerStart, close);
        innerKind := resolveTypeText(source, position, prefix, aliases, innerText, seen);
        if isListKind(innerKind) {
            failAt(source, position, prefix, "nested list types are not supported");
        }
        if innerKind == "Unit" {
            failAt(source, position, prefix, "unsupported list element type Unit");
        }
        afterList := skipTrivia(text, close + 1, prefix);
        if afterList < size {
            failAt(source, position, prefix, "unexpected text after list type");
        }
        return "List<" + innerKind + ">";
    }
    if afterTrivia < size {
        failAt(source, position, prefix, "unexpected text after type " + name);
    }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" { return name; }
    numericKind := numeric.numericAliasKind(name);
    if numericKind =!= "" { return numericKind; }
    if isUnsupportedAliasTarget(name) {
        unsupportedAliasTarget(source, position, prefix, name);
        return "";
    }
    index := findAlias(aliases, name);
    if index < 0 {
        failAt(source, position, prefix, "unknown type alias " + name);
        return "";
    }
    alias := aliases[index];
    if listLib.listContainsText(seen, name) {
        failAt(source, alias.at, prefix, "recursive type alias " + name);
        return "";
    }
    if alias.target == "" {
        unsupportedAliasTarget(source, alias.at, prefix, "target");
        return "";
    }
    nextSeen: mut List<String> = seen;
    listLib.pushBack(mut nextSeen, name);
    resolveTypeText(source, alias.at, prefix, aliases, alias.target, nextSeen)
}

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String {
    resolveTypeText(source, position, prefix, aliases, name, seen)
}

/** Parses one source-level flat named-tuple type `(label: Type, ...)`; components must resolve to Int, String or Bool. */
parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    labels: mut List<String> = [];
    var kindText := "(";
    var count := 0;
    var hadComma := false;
    var singleLabel := "";
    var singleKind := "";
    loop true {
        if cursor >= size { failAt(source, cursor, prefix, "expected ) in tuple type"); }
        if textLib.at(source, cursor) == ")" {
            cursor = cursor + 1;
            break;
        }
        if textLib.at(source, cursor) == "(" {
            failAt(source, cursor, prefix, "nested tuple types are not supported");
        }
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a tuple field name");
        }
        firstStart := cursor;
        firstEnd := textLib.skipName(source, cursor);
        firstName := textLib.slice(source, firstStart, firstEnd);
        afterFirst := skipTrivia(source, firstEnd, prefix);
        var label := "";
        var componentStart := firstStart;
        var componentName := firstName;
        if afterFirst < size and textLib.at(source, afterFirst) == ":" {
            label = firstName;
            if isReservedWord(label) { unsupportedFeature(source, firstStart, label, prefix); }
            if listLib.listContainsText(labels, label) {
                failAt(source, firstStart, prefix, "duplicate tuple field " + label);
            }
            listLib.pushBack(mut labels, label);
            cursor = skipTrivia(source, afterFirst + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == "(" {
                failAt(source, cursor, prefix, "nested tuple types are not supported");
            }
            if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a tuple field type");
            }
            componentStart = cursor;
            parsedComponent := typeNameAt(source, cursor, prefix);
            cursor = parsedComponent.next;
            componentName = parsedComponent.name;
        } else {
            parsedComponent := typeNameAt(source, firstStart, prefix);
            cursor = parsedComponent.next;
            componentName = parsedComponent.name;
        }
        var componentKind := "";
        if componentName == "Int" or componentName == "Float" or componentName == "String" or componentName == "Bool" or componentName == "Unit" {
            componentKind = componentName;
        } else {
            componentKind = numeric.numericAliasKind(componentName);
            if componentKind == "" {
                if findAlias(aliases, componentName) >= 0 {
                    seen: mut List<String> = [];
                    componentKind = resolveAliasKind(source, componentStart, prefix, aliases, componentName, seen);
                } else {
                    failAt(source, componentStart, prefix, "unsupported tuple field type " + componentName);
                }
            }
        }
        if isTupleKind(componentKind) {
            failAt(source, componentStart, prefix, "nested tuple types are not supported");
        }
        if isListKind(componentKind) {
            failAt(source, componentStart, prefix, "list types inside tuples are not supported");
        }
        if componentKind == "Unit" {
            failAt(source, componentStart, prefix, "unsupported tuple component type Unit");
        }
        if count > 0 { kindText = kindText + ","; }
        kindText = kindText + label + ":" + componentKind;
        if count == 0 { singleLabel = label; singleKind = componentKind; }
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
        }
    }
    if count == 0 {
        failAt(source, position, prefix, "tuple type needs at least one field");
    }
    if count == 1 and singleLabel == "" and not hadComma {
        return (kind = singleKind, next = cursor);
    }
    (kind = kindText + ")", next = cursor)
}

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple or `List<T>`. */
parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String): (kind: String, next: Int) {
    start := skipTrivia(source, position, prefix);
    if start < textLib.length(source) and textLib.at(source, start) == "(" {
        return parseTupleTypeAt(source, position, prefix, aliases);
    }
    parsedName := typeNameAt(source, start, prefix);
    after := parsedName.next;
    name := parsedName.name;
    afterName := skipTrivia(source, after, prefix);
    if name == "List" and afterName < textLib.length(source) and textLib.at(source, afterName) == "<" {
        innerStart := skipTrivia(source, afterName + 1, prefix);
        if innerStart >= textLib.length(source) or textLib.at(source, innerStart) == ">" {
            failAt(source, innerStart, prefix, "expected a list element type");
        }
        inner := parseTypeAt(source, innerStart, prefix, aliases, context, genericType);
        if isListKind(inner.kind) {
            failAt(source, innerStart, prefix, "nested list types are not supported");
        }
        if inner.kind == "Unit" {
            failAt(source, innerStart, prefix, "unsupported list element type Unit");
        }
        var close := skipTrivia(source, inner.next, prefix);
        close = expectSymbol(source, close, ">", prefix);
        return (kind = "List<" + inner.kind + ">", next = close);
    }
    if genericType =!= "" and name == genericType { return (kind = genericType, next = after); }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" {
        return (kind = name, next = after);
    }
    numericKind := numeric.numericAliasKind(name);
    if numericKind =!= "" { return (kind = numericKind, next = after); }
    if findAlias(aliases, name) >= 0 {
        seen: mut List<String> = [];
        return (kind = resolveAliasKind(source, start, prefix, aliases, name, seen), next = after);
    }
    if textLib.indexOfText(name, ".", 0) >= 0 {
        failAt(source, start, prefix, "unknown type alias " + name);
    }
    failAt(source, start, prefix, "unsupported " + context + " type " + name);
    (kind = "", next = after)
}

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (kind: String, next: Int) {
    parseTypeAt(source, position, prefix, aliases, "function", genericType)
}

/** Parses a function signature. The optional `T` binder is only enabled for the registered core list declarations. */
parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): (next: Int, result: String, params: String, count: Int, genericType: String) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    var genericType := "";
    if listIntrinsic {
        cursor = expectSymbol(source, cursor, "<", prefix);
        binderStart := skipTrivia(source, cursor, prefix);
        binder := typeNameAt(source, binderStart, prefix);
        if binder.name =!= "T" { failAt(source, binderStart, prefix, "core list intrinsic type parameter must be T"); }
        genericType = binder.name;
        cursor = expectSymbol(source, binder.next, ">", prefix);
        cursor = skipTrivia(source, cursor, prefix);
    }
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    names: mut List<String> = [];
    var encoded := "";
    var count := 0;
    if textLib.startsWithAt(source, cursor, "...") {
        cursor = skipTrivia(source, cursor + 3, prefix);
        if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a name after ... in host value-pack declaration");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        encoded = "..." + textLib.slice(source, nameStart, cursor);
        count = -1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            failAt(source, cursor, prefix, "host value-pack declaration must be its only parameter");
        }
    } else if cursor < size and textLib.at(source, cursor) =!= ")" {
        loop true {
            if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = textLib.skipName(source, cursor);
            parameterName := textLib.slice(source, nameStart, cursor);
            if isReservedWord(parameterName) { unsupportedFeature(source, nameStart, parameterName, prefix); }
            if listLib.listContainsText(names, parameterName) {
                failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            listLib.pushBack(mut names, parameterName);
            cursor = skipTrivia(source, cursor, prefix);
            cursor = expectSymbol(source, cursor, ":", prefix);
            cursor = skipTrivia(source, cursor, prefix);
            var access := "";
            if textLib.wordAt(source, cursor, "mut") {
                if not listIntrinsic { failAt(source, cursor, prefix, "mut parameter signatures are reserved for registered core declarations"); }
                access = "mut ";
                cursor = skipTrivia(source, cursor + 3, prefix);
            }
            typed := parseFunctionType(source, cursor, prefix, aliases, genericType);
            cursor = skipTrivia(source, typed.next, prefix);
            if count > 0 { encoded = encoded + "|"; }
            encoded = encoded + parameterName + "=" + access + typed.kind;
            count = count + 1;
            if cursor < size and textLib.at(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
    }
    cursor = expectSymbol(source, cursor, ")", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    cursor = expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, aliases, genericType);
    (next = resultType.next, result = resultType.kind, params = encoded, count = count, genericType = genericType)
}

/** Resolves a bodyless public core declaration only when its module identity and complete ABI are registered. */
coreHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.core.io.v1" {
        if params == "...values" and result == "Unit" {
            if name == "output" { "lite$core$io$output:v1" }
            else if name == "outputLine" { "lite$core$io$outputLine:v1" }
            else { "" }
        } else if name == "errorLine" and params == "text=String" and result == "Unit" { "lite$reportError" }
        else if name == "exit" and params == "status=Int" and result == "Unit" { "lite$exit" }
        else if name == "inputArgs" and params == "" and result == "List<String>" { "lite$inputArgs" }
        else if params == "prompt=String" and result == "String" {
            if name == "inputAll" { "lite$inputAll" } else if name == "inputLine" { "lite$inputLine" } else { "" }
        } else if params == "prompt=String" and result == "Int" and name == "inputInt" { "lite$inputInt" }
        else if params == "prompt=String" and result == "Float" and name == "inputFloat" { "lite$inputFloat" }
        else { "" }
    } else if moduleIdentity == "lite.core.text.v1" {
        if name == "length" and params == "text=String" and result == "Int" { "lite$textLength" }
        else if name == "at" and params == "text=String|position=Int" and result == "String" { "lite$textAt" }
        else if name == "slice" and params == "text=String|start=Int|end=Int" and result == "String" { "lite$textSlice" }
        else { "" }
    } else if moduleIdentity == "lite.core.list.v1" {
        if name == "pushBack" and params == "values=mut List<T>|value=T" and result == "Unit" { "lite$core$list$pushBack:v1" }
        else if name == "popBack" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popBack:v1" }
        else { "" }
    } else if moduleIdentity == "lite.compiler.source-reader.v1" and name == "read" and
        params == "importer=String|spec=String" and result == "(path:String,display:String,identity:String,text:String)" {
        "lite$readSource"
    } else {
        ""
    }
}

/** Maps one registered output intrinsic identity to its source special-statement name. */
coreOutputName := fn(runtime: String): String {
    if runtime == "lite$core$io$output:v1" { "output" }
    else if runtime == "lite$core$io$outputLine:v1" { "outputLine" }
    else { "" }
}

/** Returns the source name from one encoded `name=kind` function parameter entry. */
paramNameOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return entry; }
    textLib.slice(entry, 0, separator)
}

/** Returns the kind from one encoded `name=kind` function parameter entry. */
paramKindOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return ""; }
    textLib.slice(entry, separator + 1, textLib.length(entry))
}

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed {
    (kind = "Int", code = code, intValue = value, textValue = "", constant = constant, next = next)
}

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed {
    (kind = "String", code = code, intValue = 0, textValue = value, constant = constant, next = next)
}

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed {
    (kind = "Bool", code = code, intValue = if value { 1 } else { 0 }, textValue = "", constant = constant, next = next)
}

/** Tries a constant integer operation without raising a compile-time runtime fault. */
tryFoldInteger := fn(operator: String, left: Int, right: Int): (value: Int, ok: Bool) {
    if operator == "+" { return integer.intAdd(left, right); }
    if operator == "-" { return integer.intSubtract(left, right); }
    if operator == "*" { return integer.intMultiply(left, right); }
    if operator == "/" { return integer.intDivide(left, right); }
    if operator == "%" { return integer.intRemainder(left, right); }
    if operator == ":/" { return integer.intFloorDivide(left, right); }
    integer.intFloorModulo(left, right)
}

/** Lowers a checked integer operation whose result is not a safe constant, preserving evaluation and fault timing. */
runtimeIntegerCode := fn(target: String, operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { return targetIntAddCode(target, left, right, position); }
    if operator == "-" { return targetIntSubtractCode(target, left, right, position); }
    if operator == "*" { return targetIntMultiplyCode(target, left, right, position); }
    if operator == "/" { return targetIntDivideCode(target, left, right, position); }
    if operator == "%" { return targetIntRemainderCode(target, left, right, position); }
    if operator == ":/" { return targetIntFloorDivideCode(target, left, right, position); }
    targetIntFloorModuloCode(target, left, right, position)
}

/** Returns the index of the newest visible `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** Selects a fresh runtime name for a new binding, retaining the previous same-name binding while its initializer evaluates. */
localRuntimeName := fn(locals: List<Local>, name: String, position: Int, moduleId: Int): String {
    index := localIndex(locals, name);
    if moduleId == 0 {
        if index < 0 { return "lite_" + name; }
        return "lt_local_" + name + "_" + integer.intText(position);
    }
    if index < 0 { return "lite_m" + integer.intText(moduleId) + "_" + name; }
    "lt_local_m" + integer.intText(moduleId) + "_" + name + "_" + integer.intText(position)
}

/** True for the ten comparison spellings accepted by this checkpoint. */
isComparison := fn(operator: String): Bool {
    operator == "==" or operator == "=!=" or operator == "<" or operator == "<!" or
    operator == "<=" or operator == "<!=" or operator == ">" or operator == ">!" or
    operator == ">=" or operator == ">!="
}

/** Precedence level of a recognized binary operator; comparisons bind below arithmetic and logic binds below comparisons. */
operatorLevel := fn(operator: String): Int {
    if operator == "or" { 2 }
    else if operator == "and" { 3 }
    else if isComparison(operator) { 5 }
    else if operator == "+" or operator == "-" { 10 }
    else if operator == "*" or operator == "/" or operator == "%" or operator == ":/" or operator == ":%" { 20 }
    else if operator == "**" { 25 }
    else { 0 }
}

/** Reads an operator at `position`, preferring the longest spelling; returns empty text when none starts there. */
readOperator := fn(source: String, position: Int): Operator {
    ch := textLib.at(source, position);
    if ch == "*" {
        if textLib.startsWithAt(source, position, "**") { return (text = "**", width = 2); }
        return (text = "*", width = 1);
    }
    if textLib.startsWithAt(source, position, "=!=") { return (text = "=!=", width = 3); }
    if textLib.startsWithAt(source, position, "<!=") { return (text = "<!=", width = 3); }
    if textLib.startsWithAt(source, position, ">!=") { return (text = ">!=", width = 3); }
    if textLib.startsWithAt(source, position, "==") { return (text = "==", width = 2); }
    if textLib.startsWithAt(source, position, "<=") { return (text = "<=", width = 2); }
    if textLib.startsWithAt(source, position, ">=") { return (text = ">=", width = 2); }
    if textLib.startsWithAt(source, position, "<!") { return (text = "<!", width = 2); }
    if textLib.startsWithAt(source, position, ">!") { return (text = ">!", width = 2); }
    if ch == "<" { return (text = "<", width = 1); }
    if ch == ">" { return (text = ">", width = 1); }
    if ch == "+" or ch == "-" or ch == "/" or ch == "%" { return (text = ch, width = 1); }
    if textLib.startsWithAt(source, position, ":/") { return (text = ":/", width = 2); }
    if textLib.startsWithAt(source, position, ":%") { return (text = ":%", width = 2); }
    if textLib.isNameStart(ch) {
        after := textLib.skipName(source, position);
        word := textLib.slice(source, position, after);
        if word == "and" or word == "or" { return (text = word, width = after - position); }
    }
    (text = "", width = 0)
}

/** True when a parsed atom is followed by a binary operator belonging to this precedence-climbing invocation. */
binaryFollows := fn(source: String, next: Int, prefix: String, minimum: Int): Bool {
    cursor := skipTrivia(source, next, prefix);
    if cursor >= textLib.length(source) { return false; }
    operator := readOperator(source, cursor);
    operator.text =!= "" and operatorLevel(operator.text) >= minimum
}

/** Peeks only for a following comparison; the one-character filter avoids a full operator scan for ordinary delimiters and logic. */
comparisonOperatorAt := fn(source: String, position: Int): Operator {
    if position >= textLib.length(source) { return (text = "", width = 0); }
    ch := textLib.at(source, position);
    if ch == "=" or ch == "<" or ch == ">" { return readOperator(source, position); }
    (text = "", width = 0)
}

/** Folds one of the ten Int comparisons to a Bool. */
compareIntegers := fn(operator: String, left: Int, right: Int): Bool {
    if operator == "==" { left == right }
    else if operator == "=!=" { left =!= right }
    else if operator == "<" { left < right }
    else if operator == "<!" { left >= right }
    else if operator == "<=" { left <= right }
    else if operator == "<!=" { left > right }
    else if operator == ">" { left > right }
    else if operator == ">!" { left <= right }
    else if operator == ">=" { left >= right }
    else { left < right }
}

/** Folds String equality or inequality. */
compareTexts := fn(operator: String, left: String, right: String): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Folds Bool equality or inequality. */
compareBools := fn(operator: String, left: Bool, right: Bool): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
compareParsed := fn(target: String, source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed {
    if left.kind =!= right.kind {
        if (left.kind == "Int" or left.kind == "Float") and (right.kind == "Int" or right.kind == "Float") {
            codes: List<String> = [left.code, right.code];
            kinds: List<String> = [left.kind, right.kind];
            operators: List<String> = [operator];
            return boolParsed(targetComparisonChainCode(target, codes, kinds, operators, 1, at), false, false, right.next);
        }
        failAt(source, at, prefix, "cannot compare " + displayKind(left.kind) + " and " + displayKind(right.kind));
    }
    if isTupleKind(left.kind) {
        failAt(source, at, prefix, "cannot compare tuple values");
    }
    if isListKind(left.kind) {
        failAt(source, at, prefix, "cannot compare list values");
    }
    if left.kind == "Int" {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
        }
        return boolParsed(targetComparisonCode(target, operator, left.kind, left.code, right.code), false, false, right.next);
    }
    if left.kind == "Float" {
        codes: List<String> = [left.code, right.code];
        kinds: List<String> = [left.kind, right.kind];
        operators: List<String> = [operator];
        return boolParsed(targetComparisonChainCode(target, codes, kinds, operators, 1, at), false, false, right.next);
    }
    if operator =!= "==" and operator =!= "=!=" {
        failAt(source, at, prefix, "operator " + operator + " requires Int operands");
    }
    if left.constant and right.constant {
        value := if left.kind == "String" {
            compareTexts(operator, left.textValue, right.textValue)
        } else {
            compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
        };
        return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
    }
    boolParsed(targetComparisonCode(target, operator, left.kind, left.code, right.code), false, false, right.next)
}

/** Parses signed decimal Int/Float literals in one digit scan; finite/range admission happens after fractional/exponent classification. */
parseNumber := fn(target: String, source: String, position: Int, prefix: String): Parsed {
    var cursor := position;
    var negative := false;
    ch := textLib.at(source, cursor);
    if ch == "+" or ch == "-" {
        negative = ch == "-";
        cursor = skipTrivia(source, cursor + 1, prefix);
    }
    start := cursor;
    afterDigit := cursor + 1;
    following := if afterDigit < textLib.length(source) { textLib.at(source, afterDigit) } else { "" };
    if textLib.isDigit(textLib.at(source, cursor)) and not textLib.isDigit(following) and following =!= "." and following =!= "e" and following =!= "E" {
        /* A lone decimal digit is always an Int: avoid the general scanner record and range arithmetic on this hot path. */
        digit := textLib.digitValue(textLib.at(source, cursor));
        value := if negative { -digit } else { digit };
        return intParsed(targetIntLiteralCode(target, value, negative, textLib.slice(source, cursor, afterDigit)), value, true, afterDigit);
    }
    scanned := numeric.scanNumericLiteral(source, cursor);
    cursor = scanned.next;
    integerEnd := scanned.integerEnd;
    if start == integerEnd { failAt(source, position, prefix, "expected a decimal numeric literal"); }
    if scanned.exponentMissingAt >= 0 { failAt(source, scanned.exponentMissingAt, prefix, "expected exponent digits"); }
    var digitStart := start;
    loop digitStart + 1 < integerEnd and textLib.at(source, digitStart) == "0" { digitStart = digitStart + 1; }
    if scanned.floating {
        digits := textLib.slice(source, start, integerEnd) + textLib.slice(source, scanned.fractionStart, scanned.fractionEnd);
        if not numeric.finiteFloatDigits(digits, scanned.fractionEnd - scanned.fractionStart, scanned.exponent) {
            failAt(source, position, prefix, "floating literal is not finite");
        }
        raw := textLib.slice(source, digitStart, cursor);
        code := targetFloatLiteralCode(target, raw, negative);
        return (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = cursor);
    }
    if scanned.outsideInt or (not negative and scanned.magnitude == -9223372036854775808) {
        failAt(source, position, prefix, "integer literal outside signed 64-bit range");
    }
    value := if negative { scanned.magnitude } else { 0 - scanned.magnitude };
    code := targetIntLiteralCode(target, value, negative, textLib.slice(source, digitStart, cursor));
    intParsed(code, value, true, cursor)
}

/** Admits an exact integer literal into a Float context only when the atom is the complete expression, preserving ordinary binary operand typing. */
floatContextNumber := fn(target: String, source: String, start: Int, prefix: String, parsed: Parsed, minimum: Int): Parsed {
    if parsed.kind =!= "Int" or binaryFollows(source, parsed.next, prefix, minimum) { return parsed; }
    if not numeric.intExactlyFloat(parsed.intValue) {
        failAt(source, start, prefix, "integer literal is not exactly representable in Float");
    }
    (kind = "Float", code = targetFloatOperandCode(target, "Int", parsed.code), intValue = 0, textValue = "", constant = false, next = parsed.next)
}

/** Joins adjacent double-quoted literal tokens across trivia in one scan and encodes the complete value once. Escapes and malformed later tokens retain their own source positions. */
parseText := fn(target: String, source: String, position: Int, prefix: String): Parsed {
    var literalStart := position;
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= textLib.length(source) {
            failAt(source, literalStart, prefix, "unterminated string literal");
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            next := skipTrivia(source, cursor, prefix);
            if next < textLib.length(source) and textLib.at(source, next) == "\"" {
                literalStart = next;
                cursor = next + 1;
                continue;
            }
            break;
        }
        if ch == "\\" {
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= textLib.length(source) {
                failAt(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := textLib.at(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                failAt(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    textParsed(targetTextLiteralCode(target, value), value, true, cursor)
}

/** Returns the position after one string literal, or the source end when it does not close; alias collection leaves lexical diagnostics to the main pass. */
pub skipAliasString := fn(source: String, position: Int): Int {
    size := textLib.length(source);
    var cursor := position + 1;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\\" {
            cursor = cursor + 2;
        } else if ch == "\"" {
            return cursor + 1;
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String {
    if textLib.indexOfText(code, "lite", 0) < 0 and textLib.indexOfText(code, "lt_", 0) < 0 { return existing; }
    var calls := existing;
    var cursor := 0;
    loop cursor < textLib.length(code) {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = skipAliasString(code, cursor);
        } else if textLib.isNameStart(ch) {
            start := cursor;
            cursor = textLib.skipName(code, cursor);
            if cursor < textLib.length(code) and textLib.at(code, cursor) == "$" {
                cursor = textLib.skipName(code, cursor + 1);
            }
            if cursor < textLib.length(code) and textLib.at(code, cursor) == "(" {
                name := textLib.slice(code, start, cursor);
                if textLib.startsWithAt(name, 0, "lite$") or textLib.startsWithAt(name, 0, "lite_") or textLib.startsWithAt(name, 0, "lt_") {
                    token := name + "(|";
                    if textLib.indexOfText(calls, "|" + token, 0) < 0 { calls = calls + token; }
                }
            }
        } else { cursor = cursor + 1; }
    }
    calls
}

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCalls := fn(items: Items): String {
    var calls := "|";
    loop items as item { calls = targetCodeCalls(item.code, calls); }
    calls
}

/** Reads one raw alias target type from `position`, capturing a parenthesized tuple type or a generic `List<...>` application through its matching close, or a single name. */
collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start < size and textLib.at(source, start) == "(" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if textLib.startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "(" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textLib.slice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textLib.slice(source, start, size), next = size)
    } else {
        parsedName := typeNameAt(source, start, prefix);
        after := parsedName.next;
        afterName := skipTrivia(source, after, prefix);
        if afterName < size and textLib.at(source, afterName) == "<" {
            var cursor := afterName;
            var depth := 0;
            loop cursor < size {
                ch := textLib.at(source, cursor);
                if textLib.startsWithAt(source, cursor, "/*") {
                    cursor = skipComment(source, cursor, prefix);
                } else if ch == "<" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ">" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        return (text = textLib.slice(source, start, cursor), next = cursor);
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            (text = textLib.slice(source, start, size), next = size)
        } else {
            (text = textLib.slice(source, start, after), next = after)
        }
    }
}

/** Collects top-level `Name := type Target;` declarations before parsing so aliases may reference later aliases and cycles can be reported. */
collectAliases := fn(source: String, prefix: String): List<AliasDecl> {
    aliases: mut List<AliasDecl> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.isNameStart(ch) {
            nameStart := position;
            afterName := textLib.skipName(source, position);
            name := textLib.slice(source, nameStart, afterName);
            aliasPosition := skipTrivia(source, afterName, prefix);
            if textLib.startsWithAt(source, aliasPosition, ":=") {
                typePosition := skipTrivia(source, aliasPosition + 2, prefix);
                if textLib.wordAt(source, typePosition, "type") {
                    targetStart := skipTrivia(source, typePosition + 4, prefix);
                    target := collectTypeTarget(source, targetStart, prefix);
                    listLib.pushBack(mut aliases, (name = name, target = target.text, at = nameStart, end = target.next));
                    position = target.next;
                    continue;
                }
            }
            position = afterName;
        } else {
            position = position + 1;
        }
    }
    aliases
}

/** True for the single assignment/field equals token, excluding both equality and inequality operators. */
isSingleEquals := fn(source: String, position: Int): Bool {
    textLib.startsWithAt(source, position, "=") and not textLib.startsWithAt(source, position, "==") and not textLib.startsWithAt(source, position, "=!=")
}

/** True when the text after an opening `(` is a tuple literal (`label = ...`, `=name`, or contains a top-level `,`), rather than grouping. */
looksLikeTupleEntry := fn(source: String, position: Int, prefix: String): Bool {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start >= size { return false; }
    if isSingleEquals(source, start) { return true; }
    if textLib.isNameStart(textLib.at(source, start)) {
        afterName := skipTrivia(source, textLib.skipName(source, start), prefix);
        if isSingleEquals(source, afterName) { return true; }
    }
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 { return false; }
            depth = depth - 1;
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** Wraps target code in the backend's list-copy hook when `kind` is a List; every other kind is unchanged. */
copiedValueCode := fn(target: String, kind: String, code: String): String {
    if isListKind(kind) { targetListCopyCode(target, code) } else { code }
}

/** Converts compatible tuple shapes on assignment/call/return, or copies lists when needed. */
assignValueCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    if expectedKind =!= actualKind and tupleShapeMatches(expectedKind, actualKind) {
        convertTupleValue(expectedKind, actualKind, actualCode)
    } else {
        copiedValueCode(target, expectedKind, actualCode)
    }
}

/** Closes a call after at least one parsed argument, consuming at most one trailing comma and its trivia. */
expectNonemptyCallClose := fn(source: String, position: Int, prefix: String): Int {
    var cursor := skipTrivia(source, position, prefix);
    if cursor < textLib.length(source) and textLib.at(source, cursor) == "," { cursor = skipTrivia(source, cursor + 1, prefix); }
    expectSymbol(source, cursor, ")", prefix)
}

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := skipTrivia(source, open + 1, prefix);
    if not textLib.wordAt(source, cursor, "mut") {
        failAt(source, cursor, prefix, operation + " requires mut list argument");
    }
    cursor = skipTrivia(source, cursor + 3, prefix);
    if cursor >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, cursor)) {
        failAt(source, cursor, prefix, "expected a list name after mut");
    }
    nameEnd := textLib.skipName(source, cursor);
    listName := textLib.slice(source, cursor, nameEnd);
    index := localIndex(locals, listName);
    if index < 0 {
        failAt(source, cursor, prefix, "unknown value " + listName);
        return (runtime = "", kind = "", next = nameEnd);
    }
    entry := locals[index];
    if not isListKind(entry.kind) {
        failAt(source, cursor, prefix, operation + " requires a List value, got " + displayKind(entry.kind));
    }
    if not entry.writable {
        failAt(source, cursor, prefix, "cannot mutate list " + listName + " without mut");
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
}

/** Finds the end of a grouped atom without interpreting its values; strings and comments cannot close the group. */
scanParenEnd := fn(source: String, open: Int, prefix: String): Int {
    var cursor := open;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if ch == "(" { depth = depth + 1; cursor = cursor + 1; }
        else if ch == ")" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else { cursor = cursor + 1; }
    }
    -1
}

/** Builds the zero value for one flat tuple kind as a fresh object literal. */
tupleZeroParsed := fn(kind: String, next: Int): Parsed {
    count := tupleComponentCount(kind);
    var code := "{ ";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { code = code + ", "; }
        code = code + tupleObjectKey(comp.label, index) + ": ";
        if comp.kind == "Int" { code = code + "0n"; }
        else if comp.kind == "Float" { code = code + "0"; }
        else if comp.kind == "String" { code = code + "\"\""; }
        else { code = code + "false"; }
        index = index + 1;
    }
    (kind = kind, code = code + " }", intValue = 0, textValue = "", constant = false, next = next)
}

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object and an empty list. */
zeroParsed := fn(target: String, kind: String, next: Int): Parsed {
    if isTupleKind(kind) { tupleZeroParsed(kind, next) }
    else if isListKind(kind) { (kind = kind, code = "[]", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == "Int" { intParsed(targetIntLiteralCode(target, 0, false, "0"), 0, true, next) }
    else if kind == "Float" { (kind = "Float", code = "0", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == "String" { textParsed(targetTextLiteralCode(target, ""), "", true, next) }
    else { boolParsed(targetBoolLiteralCode(target, false), false, true, next) }
}

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) {
    start := skipTrivia(source, position, prefix);
    var cursor := start;
    var writable := false;
    if textLib.wordAt(source, cursor, "mut") {
        writable = true;
        cursor = skipTrivia(source, cursor + 3, prefix);
    }
    typed := parseTypeAt(source, cursor, prefix, aliases, "local", "");
    if typed.kind == "Unit" {
        name := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        failAt(source, cursor, prefix, "unsupported local type " + name);
    }
    if writable and not isListKind(typed.kind) {
        failAt(source, start, prefix, "mut requires a List type, got " + displayKind(typed.kind));
    }
    (kind = typed.kind, writable = writable, next = typed.next)
}

/** Skips empty item separators without changing the final ordinary item's result. */
skipItemSeparators := fn(source: String, position: Int, prefix: String): Int {
    var next := skipTrivia(source, position, prefix);
    loop next < textLib.length(source) and textLib.at(source, next) == ";" {
        next = skipTrivia(source, next + 1, prefix);
    }
    next
}

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`. Folds constants, lowers dynamic Int arithmetic, and exits 2 on mixed types, unsupported dynamic operations or range faults. `expected` supplies a contextual kind for empty list literals. self(..., 30) parses a unary operand without binary operators. */
parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    var start := skipTrivia(source, position, prefix);
    if start >= textLib.length(source) {
        failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    effectiveMinimum := if minimum < 0 { 0 } else { minimum };
    var leaderStart := -1;
    var leaderText := "";
    if effectiveMinimum == 0 and (textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or")) {
        leaderStart = start;
        leaderEnd := textLib.skipName(source, start);
        leaderText = textLib.slice(source, start, leaderEnd);
        start = skipTrivia(source, leaderEnd, prefix);
        if textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or") {
            failAt(source, start, prefix, "leading " + leaderText + " may appear only once");
        }
    }
    var left := intParsed("", 0, true, start);
    ch := textLib.at(source, start);
    if ch == "(" {
        if textLib.at(source, skipTrivia(source, start + 1, prefix)) == ")" {
            left = (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = skipTrivia(source, start + 1, prefix) + 1);
        } else if looksLikeTupleEntry(source, start + 1, prefix) {
            var cursor := skipTrivia(source, start + 1, prefix);
            labels: mut List<String> = [];
            codes: mut List<String> = [];
            kinds: mut List<String> = [];
            var count := 0;
            loop cursor < textLib.length(source) and textLib.at(source, cursor) =!= ")" {
                var label := "";
                var value := intParsed("", 0, true, cursor);
                if isSingleEquals(source, cursor) {
                    nameStart := skipTrivia(source, cursor + 1, prefix);
                    if nameStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, nameStart)) {
                        failAt(source, nameStart, prefix, "expected a tuple field name after =");
                    }
                    nameEnd := textLib.skipName(source, nameStart);
                    label = textLib.slice(source, nameStart, nameEnd);
                    if isReservedWord(label) { unsupportedFeature(source, nameStart, label, prefix); }
                    if listLib.listContainsText(labels, label) {
                        failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                    }
                    fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                    value = self(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30);
                } else if cursor < textLib.length(source) and textLib.isNameStart(textLib.at(source, cursor)) {
                    nameEnd := textLib.skipName(source, cursor);
                    afterName := skipTrivia(source, nameEnd, prefix);
                    if isSingleEquals(source, afterName) {
                        label = textLib.slice(source, cursor, nameEnd);
                        if isReservedWord(label) { unsupportedFeature(source, cursor, label, prefix); }
                        if listLib.listContainsText(labels, label) {
                            failAt(source, cursor, prefix, "duplicate tuple field " + label);
                        }
                        exprStart := skipTrivia(source, afterName + 1, prefix);
                        fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                        value = self(target, source, exprStart, prefix, locals, functions, params, currentName, fieldExpected, 0);
                    } else {
                        fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                        value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0);
                    }
                } else {
                    fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                    value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0);
                }
                if isTupleKind(value.kind) {
                    failAt(source, cursor, prefix, "nested tuple values are not supported");
                }
                if isListKind(value.kind) {
                    failAt(source, cursor, prefix, "list values inside tuples are not supported");
                }
                if value.kind == "Unit" {
                    failName := if label =!= "" { label } else { integer.intText(count) };
                    failAt(source, cursor, prefix, "tuple field " + failName + " cannot be Unit");
                }
                listLib.pushBack(mut labels, label);
                listLib.pushBack(mut codes, value.code);
                listLib.pushBack(mut kinds, value.kind);
                count = count + 1;
                cursor = skipTrivia(source, value.next, prefix);
                if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                } else {
                    break;
                }
            }
            cursor = expectSymbol(source, cursor, ")", prefix);
            var kindText := "(";
            var codeText := "{ ";
            var index := 0;
            loop index < count {
                if index > 0 {
                    kindText = kindText + ",";
                    codeText = codeText + ", ";
                }
                kindText = kindText + labels[index] + ":" + kinds[index];
                codeText = codeText + tupleObjectKey(labels[index], index) + ": " + codes[index];
                index = index + 1;
            }
            left = (kind = kindText + ")", code = codeText + " }", intValue = 0, textValue = "", constant = false, next = cursor);
        } else {
            var groupedExpected := expected;
            if expected == "Float" {
                groupEnd := scanParenEnd(source, start, prefix);
                if groupEnd >= 0 and binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
            }
            inner := self(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0);
            next := expectSymbol(source, skipTrivia(source, inner.next, prefix), ")", prefix);
            left = (kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next);
