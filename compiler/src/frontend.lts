            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after local declaration " + name); }
            position = statementNext;
            runtime := localRuntimeName(locals, name, nameStart, moduleId);
            assignedCode := assignValueCode(target, typed.kind, parsed.kind, parsed.code);
            listLib.pushBack(mut locals, (name = name, runtime = runtime, kind = typed.kind,
                mutable = false, writable = typed.writable, depth = depth, constant = parsed.constant, code = assignedCode,
                intValue = parsed.intValue, textValue = parsed.textValue));
            if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = "Local" + storageKind(typed.kind), name = name, runtime = runtime,
                code = assignedCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed))); }
            continue;
        }
        if isSingleEquals(source, position) {
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            if not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            partialItems := parsePartialAssignIf(target, source, position, prefix, locals, functions, functionParams, currentName, nameStart, entry.kind, name, entry.runtime);
            var partialCount := 0;
            loop partialItems as partialItem {
                partialCount = partialCount + 1;
                if partialItem.kind == "End" {
                    position = partialItem.intValue;
                } else if currentLive and not currentStopped {
                    listLib.pushBack(mut items, partialItem);
                }
            }
            if partialCount > 0 {
                listLib.pushBack(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                    mutable = true, writable = entry.writable, depth = entry.depth, constant = false, code = entry.runtime,
                    intValue = 0, textValue = ""));
                continue;
            }
            parsed := parseExpressionAs(target, source, position, prefix, locals, functions, functionParams, currentName, entry.kind);
            if not isCompatibleKind(entry.kind, parsed.kind) {
                failAt(source, nameStart, prefix, "cannot assign " + displayKind(parsed.kind) + " to " + displayKind(entry.kind) + " local " + name);
            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after assignment to " + name); }
            position = statementNext;
            assignedCode := assignValueCode(target, entry.kind, parsed.kind, parsed.code);
            listLib.pushBack(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                mutable = true, writable = entry.writable, depth = entry.depth, constant = false, code = assignedCode,
                intValue = parsed.intValue, textValue = parsed.textValue));
            if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = "Assign" + storageKind(entry.kind), name = name, runtime = entry.runtime,
                code = assignedCode, intValue = parsed.intValue, textValue = itemTextPayload(parsed))); }
            continue;
        }
        expression := parseExpressionItem(target, source, nameStart, prefix, locals, functions, functionParams, currentName,
            currentResult, atValueTail(blocks, blockCount) and not currentStopped);
        if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = if expression.returned { "Return" } else { "Discard" }, name = expression.valueKind,
            runtime = "", code = expression.code, intValue = 0, textValue = "")); }
        if expression.returned { currentReturned = true; currentStopped = true; }
        position = expression.next;
    }
    if blockCount > 0 {
        failAt(source, size, prefix, "expected } before end of source");
    }
    items
}

/** Transitional five-argument graph adapter retained until source identities reach every compiler caller. */
pub parseProgramWithExports := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int): Items {
    parseProgramWithIdentity(target, source, prefix, exports, moduleId, "")
}

/** Parses one source without imported public symbols. */
pub parseProgram := fn(target: String, source: String, prefix: String): Items {
    parseProgramWithIdentity(target, source, prefix, [], 0, "")
}

/** Encodes all line-start character offsets once for positioned runtime arithmetic faults. */
pub lineStartCodes := fn(source: String): String {
    var code := "0";
    var position := 0;
    loop position < textLib.length(source) {
        if textLib.at(source, position) == "\n" { code = code + ", " + integer.intText(position + 1); }
        position = position + 1;
    }
    code
}
