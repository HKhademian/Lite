formatLib := import "core/format";
listLib := import "core/list";
sourceLib := import "core/source";
diagLib := import "core/diag";
numeric := import "./numeric-literals.lts";
integer := import "core/int";
tsLiteral := import "./ts-literals.lts";
cLiteral := import "./c-literals.lts";
io := import "core/io";
textLib := import "core/text";

/** Selects the TS or C backend implementation for one emitted literal operation. */
targetBoolLiteralCode := fn(target: String, value: Bool): String { if target == "ts" { tsLiteral.boolLiteralCode(value) } else { cLiteral.boolLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonChainCode := fn(target: String, codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String { if target == "ts" { tsLiteral.comparisonChainCode(codes, kinds, operators, count, position) } else { cLiteral.comparisonChainCode(codes, kinds, operators, count, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonCode := fn(target: String, op: String, kind: String, left: String, right: String): String { if target == "ts" { tsLiteral.comparisonCode(op, kind, left, right) } else { cLiteral.comparisonCode(op, kind, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetConcatCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.concatCode(left, right) } else { cLiteral.concatCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatBinaryCode := fn(target: String, op: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatBinaryCode(op, left, right, position) } else { cLiteral.floatBinaryCode(op, left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32BinaryCode := fn(target: String, op: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.float32BinaryCode(op, left, right, position) } else { cLiteral.float32BinaryCode(op, left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatLiteralCode := fn(target: String, digits: String, negative: Bool): String { if target == "ts" { tsLiteral.floatLiteralCode(digits, negative) } else { cLiteral.floatLiteralCode(digits, negative) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32LiteralCode := fn(target: String, digits: String, negative: Bool): String { if target == "ts" { tsLiteral.float32LiteralCode(digits, negative) } else { cLiteral.float32LiteralCode(digits, negative) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatOperandCode := fn(target: String, kind: String, code: String): String { if target == "ts" { tsLiteral.floatOperandCode(kind, code) } else { cLiteral.floatOperandCode(kind, code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32OperandCode := fn(target: String, kind: String, code: String): String { if target == "ts" { tsLiteral.float32OperandCode(kind, code) } else { cLiteral.float32OperandCode(kind, code) } }
/** Selects the TS or C backend implementation for checked narrow integer arithmetic. */
targetCheckedNarrowIntCode := fn(target: String, kind: String, value: String, position: Int): String { if target == "ts" { tsLiteral.checkedNarrowIntCode(kind, value, position) } else { cLiteral.checkedNarrowIntCode(kind, value, position) } }
/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntScalarKind := fn(kind: String): Bool { numeric.isIntKind(kind) }
/** True when `kind` is one of the binary float scalar types (`Float32`, `Float`). */
pub isFloatScalarKind := fn(kind: String): Bool { numeric.isFloatKind(kind) }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatPowerCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatPowerCode(left, right, position) } else { cLiteral.floatPowerCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorDivCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorDivCode(left, right) } else { cLiteral.floorDivCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorModCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorModCode(left, right) } else { cLiteral.floorModCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntAddCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intAddCode(left, right, position) } else { cLiteral.intAddCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intDivideCode(left, right, position) } else { cLiteral.intDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorDivideCode(left, right, position) } else { cLiteral.intFloorDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorModuloCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorModuloCode(left, right, position) } else { cLiteral.intFloorModuloCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntLiteralCode := fn(target: String, value: Int, negative: Bool, digits: String): String { if target == "ts" { tsLiteral.intLiteralCode(value, negative, digits) } else { cLiteral.intLiteralCode(value, negative, digits) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntMultiplyCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intMultiplyCode(left, right, position) } else { cLiteral.intMultiplyCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntNegateCode := fn(target: String, value: String, position: Int): String { if target == "ts" { tsLiteral.intNegateCode(value, position) } else { cLiteral.intNegateCode(value, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntRemainderCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intRemainderCode(left, right, position) } else { cLiteral.intRemainderCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntSubtractCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intSubtractCode(left, right, position) } else { cLiteral.intSubtractCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetListCopyCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.listCopyCode(code) } else { cLiteral.listCopyCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetLogicCode := fn(target: String, op: String, left: String, right: String): String { if target == "ts" { tsLiteral.logicCode(op, left, right) } else { cLiteral.logicCode(op, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetNotCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.notCode(value) } else { cLiteral.notCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetTextLiteralCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.textLiteralCode(value) } else { cLiteral.textLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitEvaluationCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.unitEvaluationCode(code) } else { cLiteral.unitEvaluationCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitLiteralCode := fn(target: String): String { if target == "ts" { tsLiteral.unitLiteralCode } else { cLiteral.unitLiteralCode } }
/* Shared restricted front-end. Not a standalone program: a target manifest
   places the target literal encoders before this file and the emitter/driver
   after it. */
/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements: source name, hygienic runtime name, value kind, binding reassignment permission, held-data write grant, declaration block depth, constant value, target code, and definite-initialization state ("init", "uninit", or "maybe"). */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);
/** One program or module-graph item: a report stream entry, declaration, control-flow marker, import edge, public function signature or module visit boundary. */
pub Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Parsed module/compiler items returned by parseProgram and consumed by the module collector and backend emitters. */
pub Items := type List<Item>;
/** Completion facts saved while an inner block is parsed; earlier conditional arms are joined only after a final else. */
BlockState := type (returned: Bool, stopped: Bool, branchesReturned: Bool, branchesStopped: Bool, hasElse: Bool, loopForever: Bool, live: Bool, preLocalsLen: Int, liveBranchCount: Int);
/** Symbol declaration name owned directly by the block at `depth` for same-block uniqueness checks. */
BlockDecl := type (name: String, depth: Int);
/** One outer local initialization and callable-dependency update recorded at the end of a conditional branch. */
BranchUpdate := type (depth: Int, runtime: String, initState: String, code: String);
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := type (text: String, width: Int);
/** One previously declared top-level function: source name, result kind, first parameter entry and parameter count. */
FunctionInfo := type (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);
/** A later top-level scalar definition visible only while checking a deferred function body. */
FutureValue := type (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);
/** One transparent type alias: source name, raw target type text, declaration position, end position and enclosing block depth. */
AliasDecl := type (name: String, target: String, at: Int, end: Int, depth: Int);
/** Lexical control-flow and metadata context for an enclosing function, block, conditional, match, loop or finally scope. */
ConstructCtx := type (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool);
/** 32-bucket hashed string set for O(1) reachable-token membership checks across large module graphs. */
pub TokenBuckets := type (count: Int, b0: String, b1: String, b2: String, b3: String, b4: String, b5: String, b6: String, b7: String, b8: String, b9: String, b10: String, b11: String, b12: String, b13: String, b14: String, b15: String, b16: String, b17: String, b18: String, b19: String, b20: String, b21: String, b22: String, b23: String, b24: String, b25: String, b26: String, b27: String, b28: String, b29: String, b30: String, b31: String);

INIT_STATE_INIT := "init";
INIT_STATE_UNINIT := "uninit";
INIT_STATE_UNINIT_ASSIGNED := "uninit_assigned";
INIT_STATE_MAYBE := "maybe";

BLOCK_KIND_FUNCTION := "function";
BLOCK_KIND_SCOPE := "scope";
BLOCK_KIND_IF := "if";
BLOCK_KIND_IF_VALUE := "ifvalue";
BLOCK_KIND_ELSE := "else";
BLOCK_KIND_LOOP := "loop";
BLOCK_KIND_MATCH := "match";
BLOCK_KIND_MATCH_VALUE := "matchvalue";
BLOCK_KIND_MATCH_ELSE := "matchelse";
BLOCK_KIND_MATCH_ELSE_VALUE := "matchelseval";
BLOCK_KIND_MATCH_SINGLE := "matchsingle";
BLOCK_KIND_MATCH_SINGLE_VALUE := "matchsingleval";

/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := sourceLib.lineColumn(source, position);
    diagLib.fail(prefix, formatLib.decimalText(place.line) + ":" + formatLib.decimalText(place.column) + ": " + message);
}

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLib.length(source) or textLib.at(source, position) =!= symbol {
        failAt(source, position, prefix, "expected " + symbol);
    }
    position + 1
}

/** Number of consecutive `#` characters after a comment opener; zero means an ordinary comment. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not textLib.startsWithAt(source, position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < textLib.length(source) and textLib.at(source, index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`; fails at the opener when its fence never closes. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := position + 2 + fence;
    loop cursor < size {
        if textLib.at(source, cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and textLib.at(source, runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and textLib.startsWithAt(source, runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    failAt(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop depth > 0 {
        closeAt := textLib.indexOfText(source, "*/", cursor);
        if closeAt < 0 {
            failAt(source, position, prefix, "unterminated comment");
        }
        openAt := textLib.indexOfText(source, "/*", cursor);
        if openAt >= 0 and openAt < closeAt {
            innerFence := rawFenceLength(source, openAt);
            if innerFence > 0 {
                cursor = skipRawComment(source, openAt, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = openAt + 2;
            }
        } else {
            depth = depth - 1;
            cursor = closeAt + 2;
        }
    }
    cursor
}

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var position := start;
    loop position < size {
        ch := textLib.at(source, position);
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            position = position + 1;
        } else if ch == "/" and textLib.startsWithAt(source, position, "/*") {
            position = skipComment(source, position, prefix);
        } else {
            break;
        }
    }
    position
}

/** Consumes an explicit separator or an implicit boundary at EOF, a closing scope or a directly closed block expression. Returns -1 when a simple item still needs a separator. */
consumeStatementEnd := fn(source: String, position: Int, prefix: String): Int {
    next := skipTrivia(source, position, prefix);
    if next < textLib.length(source) and textLib.at(source, next) == ";" { return skipTrivia(source, next + 1, prefix); }
    if next == textLib.length(source) or textLib.at(source, next) == "}" or
    (position > 0 and textLib.at(source, position - 1) == "}") { return next; }
    -1
}

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool {
    name == "pub" or name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or
    name == "import" or name == "using" or name == "record" or name == "type" or
    name == "and" or name == "or" or name == "not" or name == "true" or name == "false"
}

/** Returns the documentation path for one reserved Lite feature. */
featureDoc := fn(name: String): String {
    match {
        name == "loop" { "docs/loops.md" }
        name == "if" or name == "else" or name == "and" or name == "or" or name == "not" or
        name == "true" or name == "false" { "docs/conditionals.md" }
        name == "var" or name == "mut" { "docs/declarations-and-assignment.md" }
        name == "fn" or name == "return" { "docs/functions.md" }
        name == "match" { "docs/match.md" }
        name == "pub" or name == "import" or name == "using" { "docs/modules-and-packages.md" }
        name == "record" or name == "type" { "docs/types-and-inference.md" }
        name == "break" or name == "continue" { "docs/control-flow.md" }
        name == "then" or name == "finally" { "docs/finally.md" }
        _ { "docs/grammar-sketch.md" }
    }
}

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit {
    failAt(source, position, prefix, "unsupported feature \"" + name + "\": see " + featureDoc(name) +
    "; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only");
}

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int {
    var index := 0;
    loop functions as entry {
        if entry.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool {
    name == "List" or name == "Float" or name == "Double" or name == "Array" or
    name == "Option" or name == "Result" or name == "record" or name == "fn"
}

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit {
    failAt(source, position, prefix, "unsupported type alias " + target +
    "; only Int, Float, String, Bool, Unit, List<T>, flat named tuples and aliases are supported");
}

/** Returns the index of the first visible alias named `name` at the innermost active block depth, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    var index := 0;
    var found := -1;
    var foundDepth := -1;
    loop aliases as alias {
        if alias.name == name and alias.depth > foundDepth {
            found = index;
            foundDepth = alias.depth;
        }
        index = index + 1;
    }
    found
}

/** Reads one local or module-qualified type name. */
typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) {
    firstEnd := textLib.skipName(source, position);
    first := textLib.slice(source, position, firstEnd);
    afterFirst := skipTrivia(source, firstEnd, prefix);
    if afterFirst < textLib.length(source) and textLib.at(source, afterFirst) == "." {
        memberStart := skipTrivia(source, afterFirst + 1, prefix);
        if memberStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, memberStart)) {
            failAt(source, memberStart, prefix, "expected a type name after .");
        }
        memberEnd := textLib.skipName(source, memberStart);
        member := textLib.slice(source, memberStart, memberEnd);
        return (name = first + "." + member, next = memberEnd);
    }
    (name = first, next = firstEnd)
}

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int {
    var index := 0;
    loop aliases as alias {
        if alias.at == position { return index; }
        index = index + 1;
    }
    -1
}

/** Returns the highest block depth present in `aliases`, or 0 when `aliases` is empty. */
maxAliasDepth := fn(aliases: List<AliasDecl>): Int {
    var highest := 0;
    loop aliases as alias {
        if alias.depth > highest { highest = alias.depth; }
    }
    highest
}

/** Drops aliases declared at block depth `depth` or deeper when exiting a block. */
popBlockAliases := fn(aliases: List<AliasDecl>, depth: Int): List<AliasDecl> {
    var hasDeeper := false;
    loop aliases as alias {
        if alias.depth >= depth {
            hasDeeper = true;
            break;
        }
    }
    if not hasDeeper { return aliases; }
    kept: mut List<AliasDecl> = [];
    loop aliases as alias {
        if alias.depth < depth { listLib.pushBack(mut kept, alias); }
    }
    kept
}

/** Filters `aliases` to declarations at or above `maxDepth` for lexical outer-alias expansion. */
aliasesUpToDepth := fn(aliases: List<AliasDecl>, maxDepth: Int): List<AliasDecl> {
    var hasDeeper := false;
    loop aliases as alias {
        if alias.depth > maxDepth {
            hasDeeper = true;
            break;
        }
    }
    if not hasDeeper { return aliases; }
    kept: mut List<AliasDecl> = [];
    loop aliases as alias {
        if alias.depth <= maxDepth { listLib.pushBack(mut kept, alias); }
    }
    kept
}

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool {
    textLib.length(kind) > 0 and textLib.at(kind, 0) == "("
}

/** Returns the runtime JS property name for a tuple field (`_0` when unnamed, otherwise the field label). */
pub tupleRuntimeProp := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) } else { label }
}

/** Returns the JS/TS object-literal property key for a tuple field, quoting `__proto__` to avoid prototype mutation. */
pub tupleObjectKey := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) }
    else if label == "__proto__" { "[\"__proto__\"]" }
    else { label }
}

/** Advances past one canonical type-kind token starting at `start` (scalar, `List<...>`, `[T;N]`, tuple, or `fn(...)`). */
skipKindToken := fn(kind: String, start: Int): Int {
    size := textLib.length(kind);
    if start >= size { return start; }
    if textLib.startsWithAt(kind, start, "fn(") {
        var cursor := start + 2;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(kind, cursor);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == ">" {
                depth = depth - 1;
                if depth == 0 { cursor = cursor + 1; break; }
            }
            cursor = cursor + 1;
        }
        if cursor < size and textLib.at(kind, cursor) == ":" {
            return self(kind, cursor + 1);
        }
        return cursor;
    }
    first := textLib.at(kind, start);
    if first == "(" or first == "[" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(kind, cursor);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == ">" {
                depth = depth - 1;
                if depth == 0 { return cursor + 1; }
            }
            cursor = cursor + 1;
        }
        return cursor;
    }
    var cursor := textLib.skipName(kind, start);
    if cursor < size and textLib.at(kind, cursor) == "<" {
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(kind, cursor);
            if ch == "<" or ch == "(" or ch == "[" { depth = depth + 1; }
            else if ch == ">" or ch == ")" or ch == "]" {
                depth = depth - 1;
                if depth == 0 { return cursor + 1; }
            }
            cursor = cursor + 1;
        }
    }
    cursor
}

/** Returns the index of the closing `)` matching the parameter tuple in `fn(...)`, or -1 when `kind` is not canonical. */
fnCloseParenIndex := fn(kind: String): Int {
    if not textLib.startsWithAt(kind, 0, "fn(") { return -1; }
    size := textLib.length(kind);
    var cursor := 2;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(kind, cursor);
        if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
        else if ch == ")" or ch == "]" or ch == ">" {
            depth = depth - 1;
            if depth == 0 {
                if cursor + 1 < size and textLib.at(kind, cursor + 1) == ":" { return cursor; }
                return -1;
            }
        }
        cursor = cursor + 1;
    }
    -1
}

/** True when `kind` is a canonical callable kind `fn(...):ResultKind`. */
pub isFnKind := fn(kind: String): Bool {
    fnCloseParenIndex(kind) >= 2
}

/** Returns the canonical return kind from `fn(...):ResultKind`. */
pub fnResultKind := fn(kind: String): String {
    close := fnCloseParenIndex(kind);
    if close < 2 { return ""; }
    textLib.slice(kind, close + 2, textLib.length(kind))
}

/** Parses `label:Kind` components inside a parameter list `fn(...)`; returns `(count = ...)` or `(label = ..., kind = ...)`. */
pub fnParamCount := fn(kind: String): Int {
    close := fnCloseParenIndex(kind);
    if close <= 3 { return 0; }
    var cursor := 3;
    var count := 0;
    loop cursor < close {
        if textLib.at(kind, cursor) =!= ":" { cursor = textLib.skipName(kind, cursor); }
        if cursor < close and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        cursor = skipKindToken(kind, cursor);
        count = count + 1;
        if cursor < close and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    count
}

/** Returns `(label, kind)` for parameter `targetIndex` of a canonical `fn(...):Ret` kind. */
pub fnParamComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String) {
    close := fnCloseParenIndex(kind);
    if close <= 3 { return (label = "", kind = ""); }
    var cursor := 3;
    var index := 0;
    loop cursor < close {
        var label := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            label = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < close and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        if index == targetIndex {
            return (label = label, kind = textLib.slice(kind, typeStart, cursor));
        }
        index = index + 1;
        if cursor < close and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    (label = "", kind = "")
}

/** Converts a canonical `fn(...):Ret` kind into `name=kind` parameter entries compatible with call routing. */
fnParamEntries := fn(kind: String): List<String> {
    entries: mut List<String> = [];
    close := fnCloseParenIndex(kind);
    if close <= 3 { return entries; }
    var cursor := 3;
    loop cursor < close {
        var label := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            label = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < close and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        listLib.pushBack(mut entries, label + "=" + textLib.slice(kind, typeStart, cursor));
        if cursor < close and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    entries
}

/** Removes parameter labels from a canonical `fn` kind when joining differently labeled callable branches. */
fnStripLabels := fn(kind: String): String {
    if not isFnKind(kind) { return kind; }
    count := fnParamCount(kind);
    var out := "fn(";
    var idx := 0;
    loop idx < count {
        if idx > 0 { out = out + ","; }
        comp := fnParamComponent(kind, idx);
        out = out + ":" + (if isFnKind(comp.kind) { self(comp.kind) } else { comp.kind });
        idx = idx + 1;
    }
    res := fnResultKind(kind);
    out + "):" + (if isFnKind(res) { self(res) } else { res })
}

/** Returns the number of components in one canonical flat tuple kind. */
pub tupleComponentCount := fn(kind: String): Int {
    if not isTupleKind(kind) { return 0; }
    size := textLib.length(kind);
    var cursor := 1;
    var count := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        if textLib.at(kind, cursor) =!= ":" { cursor = textLib.skipName(kind, cursor); }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        cursor = skipKindToken(kind, cursor);
        count = count + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    count
}

/** Returns the label, scalar kind and runtime property name of component `targetIndex` in a canonical tuple kind. */
pub tupleComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) {
    size := textLib.length(kind);
    var cursor := 1;
    var index := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        var label := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            label = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        fieldKind := textLib.slice(kind, typeStart, cursor);
        if index == targetIndex {
            return (label = label, kind = fieldKind, prop = tupleRuntimeProp(label, index));
        }
        index = index + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    (label = "", kind = "", prop = "")
}

/** Converts one tuple expression to `expectedKind` by copying positional components into the receiving labels. */
pub convertTupleValue := fn(expectedKind: String, actualKind: String, actualCode: String): String {
    count := tupleComponentCount(expectedKind);
    var fields := "";
    var index := 0;
    loop index < count {
        expectedComp := tupleComponent(expectedKind, index);
        actualComp := tupleComponent(actualKind, index);
        if index > 0 { fields = fields + ", "; }
        fields = fields + tupleObjectKey(expectedComp.label, index) + ": lite$t." + actualComp.prop;
        index = index + 1;
    }
    "(() => { const lite$t = " + actualCode + "; return { " + fields + " }; })()"
}

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
pub isListKind := fn(kind: String): Bool {
    textLib.length(kind) > 5 and textLib.startsWithAt(kind, 0, "List<") and textLib.at(kind, textLib.length(kind) - 1) == ">"
}

/** Returns the canonical element kind from `List<ElementKind>`. */
pub listElementKind := fn(kind: String): String {
    if not isListKind(kind) { return ""; }
    textLib.slice(kind, 5, textLib.length(kind) - 1)
}

/** Finds the top-level `;` inside `[ElementKind;Extent]`, or -1 when `kind` is not a canonical fixed-array kind. */
arraySemiIndex := fn(kind: String): Int {
    size := textLib.length(kind);
    if size < 5 or textLib.at(kind, 0) =!= "[" or textLib.at(kind, size - 1) =!= "]" { return -1; }
    var cursor := 1;
    var depth := 0;
    loop cursor < size - 1 {
        ch := textLib.at(kind, cursor);
        if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
        else if ch == ")" or ch == "]" or ch == ">" { depth = depth - 1; }
        else if ch == ";" and depth == 0 { return cursor; }
        cursor = cursor + 1;
    }
    -1
}

/** True when `kind` is this compiler's canonical fixed-array kind, written `[ElementKind;Extent]`. */
pub isArrayKind := fn(kind: String): Bool {
    arraySemiIndex(kind) > 1
}

/** Returns the canonical element kind from `[ElementKind;Extent]`. */
pub arrayElementKind := fn(kind: String): String {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return ""; }
    textLib.slice(kind, 1, semi)
}

/** Maps one ASCII decimal digit character to its integer value 0..9. */
decimalDigit := fn(ch: String): Int {
    match {
        ch == "0" { 0 }
        ch == "1" { 1 }
        ch == "2" { 2 }
        ch == "3" { 3 }
        ch == "4" { 4 }
        ch == "5" { 5 }
        ch == "6" { 6 }
        ch == "7" { 7 }
        ch == "8" { 8 }
        _ { 9 }
    }
}

/** Parses non-negative decimal digits in `text` from `start` to `end`. */
parseDigits := fn(text: String, start: Int, end: Int): Int {
    var result := 0;
    var cursor := start;
    loop cursor < end {
        result = result * 10 + decimalDigit(textLib.at(text, cursor));
        cursor = cursor + 1;
    }
    result
}

/** Returns the integer extent from `[ElementKind;Extent]`. */
pub arrayExtent := fn(kind: String): Int {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return 0; }
    parseDigits(kind, semi + 1, textLib.length(kind) - 1)
}

/** True when `expectedKind` and `actualKind` represent structurally identical kinds modulo callable/tuple parameter labels. */
exactShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if expectedKind == actualKind { return true; }
    if isFnKind(expectedKind) and isFnKind(actualKind) {
        count := fnParamCount(expectedKind);
        if count =!= fnParamCount(actualKind) { return false; }
        var idx := 0;
        loop idx < count {
            eComp := fnParamComponent(expectedKind, idx);
            aComp := fnParamComponent(actualKind, idx);
            if not self(eComp.kind, aComp.kind) { return false; }
            idx = idx + 1;
        }
        return self(fnResultKind(expectedKind), fnResultKind(actualKind));
    }
    if isListKind(expectedKind) and isListKind(actualKind) {
        return self(listElementKind(expectedKind), listElementKind(actualKind));
    }
    if isArrayKind(expectedKind) and isArrayKind(actualKind) {
        return arrayExtent(expectedKind) == arrayExtent(actualKind) and
        self(arrayElementKind(expectedKind), arrayElementKind(actualKind));
    }
    if isTupleKind(expectedKind) and isTupleKind(actualKind) {
        count := tupleComponentCount(expectedKind);
        if count =!= tupleComponentCount(actualKind) { return false; }
        var idx := 0;
        loop idx < count {
            if not self(tupleComponent(expectedKind, idx).kind, tupleComponent(actualKind, idx).kind) { return false; }
            idx = idx + 1;
        }
        return true;
    }
    false
}

/** True when `expectedKind` and `actualKind` are callable kinds with matching parameter and return shapes. */
pub fnShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    isFnKind(expectedKind) and isFnKind(actualKind) and exactShapeMatches(expectedKind, actualKind)
}

/** True when `kind` is or contains a callable function kind (for display and backend checks). */
pub containsFnKind := fn(kind: String): Bool {
    if isFnKind(kind) { return true; }
    if isListKind(kind) { return self(listElementKind(kind)); }
    if isArrayKind(kind) { return self(arrayElementKind(kind)); }
    if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var idx := 0;
        loop idx < count {
            if self(tupleComponent(kind, idx).kind) { return true; }
            idx = idx + 1;
        }
    }
    false
}

/** True when `expectedKind` and `actualKind` are tuples with identical component counts and positional component types. */
pub tupleShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if not isTupleKind(expectedKind) or not isTupleKind(actualKind) { return false; }
    expectedSize := textLib.length(expectedKind);
    actualSize := textLib.length(actualKind);
    var eCursor := 1;
    var aCursor := 1;
    loop eCursor < expectedSize and aCursor < actualSize {
        eChar := textLib.at(expectedKind, eCursor);
        aChar := textLib.at(actualKind, aCursor);
        if eChar == ")" or aChar == ")" {
            return eChar == ")" and aChar == ")";
        }
        if eChar =!= ":" { eCursor = textLib.skipName(expectedKind, eCursor); }
        if eCursor < expectedSize and textLib.at(expectedKind, eCursor) == ":" { eCursor = eCursor + 1; }
        eTypeStart := eCursor;
        eCursor = skipKindToken(expectedKind, eCursor);
        if aChar =!= ":" { aCursor = textLib.skipName(actualKind, aCursor); }
        if aCursor < actualSize and textLib.at(actualKind, aCursor) == ":" { aCursor = aCursor + 1; }
        aTypeStart := aCursor;
        aCursor = skipKindToken(actualKind, aCursor);
        eComp := textLib.slice(expectedKind, eTypeStart, eCursor);
        aComp := textLib.slice(actualKind, aTypeStart, aCursor);
        if eComp =!= aComp and not fnShapeMatches(eComp, aComp) {
            return false;
        }
        if eCursor < expectedSize and textLib.at(expectedKind, eCursor) == "," { eCursor = eCursor + 1; }
        if aCursor < actualSize and textLib.at(actualKind, aCursor) == "," { aCursor = aCursor + 1; }
    }
    eCursor >= expectedSize and aCursor >= actualSize
}

/** True when `actualKind` is directly `expectedKind`, `Never` into a known target, losslessly widens numerically, or matches a compatible tuple/callable shape. */
pub isCompatibleKind := fn(expectedKind: String, actualKind: String): Bool {
    (expectedKind =!= "" and actualKind == "Never") or expectedKind == actualKind or
    numeric.numericWidens(expectedKind, actualKind) or tupleShapeMatches(expectedKind, actualKind) or
    exactShapeMatches(expectedKind, actualKind)
}

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array, List or callable kind to its TypeScript type. */
pub tsFunctionType := fn(kind: String): String {
    if isListKind(kind) { self(listElementKind(kind)) + "[]" }
    else if isArrayKind(kind) { self(arrayElementKind(kind)) + "[]" }
    else if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var result := "{ ";
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            if index > 0 { result = result + "; "; }
            result = result + tupleObjectKey(comp.label, index) + ": " + self(comp.kind);
            index = index + 1;
        }
        result + " }"
    }
    else if isFnKind(kind) {
        count := fnParamCount(kind);
        var paramsText := "";
        var index := 0;
        loop index < count {
            comp := fnParamComponent(kind, index);
            if index > 0 { paramsText = paramsText + ", "; }
            paramLabel := if comp.label =!= "" { "lite_" + comp.label } else { "lite_arg" + integer.intText(index) };
            paramsText = paramsText + paramLabel + ": " + self(comp.kind);
            index = index + 1;
        }
        "((" + paramsText + ") => " + self(fnResultKind(kind)) + ")"
    }
    else { tsLiteral.tsScalarType(kind) }
}

/** Formats one canonical flat tuple kind as a TypeScript object type. */
pub tsTupleType := fn(kind: String): String {
    tsFunctionType(kind)
}

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
pub tsDisplayValueCode := fn(kind: String, code: String): String {
    if isIntScalarKind(kind) or isFloatScalarKind(kind) { return "(" + code + ").toString()"; }
    if kind == "Bool" { return "((" + code + ") ? \"true\" : \"false\")"; }
    if kind == "Unit" { return "((value: unknown): string => { void value; return \"Unit\"; })(" + code + ")"; }
    if isListKind(kind) or isArrayKind(kind) {
        element := if isListKind(kind) { listElementKind(kind) } else { arrayElementKind(kind) };
        return "(\"[\" + (" + code + ").map((value: " + tsFunctionType(element) + ") => " + self(element, "value") + ").join(\", \") + \"]\")";
    }
    if isTupleKind(kind) {
        var result := tsLiteral.textLiteralCode("(");
        count := tupleComponentCount(kind);
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            separator := if index == 0 { "" } else { ", " };
            prefixText := if comp.label == "" { separator } else { separator + comp.label + "=" };
            result = result + " + " + tsLiteral.textLiteralCode(prefixText) + " + " + self(comp.kind, "value." + comp.prop);
            index = index + 1;
        }
        ending := if count == 1 { ",)" } else { ")" };
        return "((value: " + tsFunctionType(kind) + "): string => " + result + " + " + tsLiteral.textLiteralCode(ending) + ")(" + code + ")";
    }
    code
}

/** True when emitted target code calls `needle` outside quoted String literal text. */
codeUsesTextCall := fn(code: String, needle: String): Bool {
    if textLib.indexOfText(code, needle, 0) < 0 { return false; }
    size := textLib.length(code);
    if size == 0 { return false; }
    width := textLib.length(needle);
    if width == 0 { return true; }
    first := textLib.at(needle, 0);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := textLib.at(code, cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if ch == first and textLib.startsWithAt(code, cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
}

/** True when emitted target code calls a checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(") or codeUsesTextCall(code, "lite$listPopFront(")
}

/** True when emitted target code contains a C list-copy placeholder outside quoted String literal text. */
pub codeUsesListCopy := fn(code: String): Bool {
    codeUsesTextCall(code, "lt_list_copy(")
}

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
}

/** Returns the scalar kind of tuple field `label` in canonical `kind`, or empty text when the field is absent. */
tupleFieldKind := fn(kind: String, label: String): String {
    if label == "" or textLib.indexOfText(kind, label + ":", 0) < 0 { return ""; }
    size := textLib.length(kind);
    var cursor := 1;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        var fieldLabel := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            fieldLabel = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipKindToken(kind, cursor);
        if fieldLabel =!= "" and fieldLabel == label {
            return textLib.slice(kind, typeStart, cursor);
        }
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    ""
}

/** Renders one canonical kind for diagnostics, adding spaces inside flat tuples, lists, and callable signatures. */
displayKind := fn(kind: String): String {
    if isListKind(kind) { return "List<" + self(listElementKind(kind)) + ">"; }
    if isArrayKind(kind) { return "[" + self(arrayElementKind(kind)) + "; " + integer.intText(arrayExtent(kind)) + "]"; }
    if isFnKind(kind) {
        count := fnParamCount(kind);
        var result := "fn(";
        var index := 0;
        loop index < count {
            comp := fnParamComponent(kind, index);
            if index > 0 { result = result + ", "; }
            if comp.label == "" {
                result = result + self(comp.kind);
            } else {
                result = result + comp.label + ": " + self(comp.kind);
            }
            index = index + 1;
        }
        return result + "): " + self(fnResultKind(kind));
    }
    if not isTupleKind(kind) { return kind; }
    count := tupleComponentCount(kind);
    var result := "(";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { result = result + ", "; }
        if comp.label == "" {
            result = result + self(comp.kind);
        } else {
            result = result + comp.label + ": " + self(comp.kind);
        }
        index = index + 1;
    }
    if count == 1 and tupleComponent(kind, 0).label == "" { result = result + ","; }
    result + ")"
}

/** Parses one source or alias type with cycle tracking `seen`, shared across annotations, aliases, tuple fields, lists, arrays, and callable types. */
parseTypeWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int) {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start < size and textLib.at(source, start) == "(" {
        var cursor := skipTrivia(source, start + 1, prefix);
        labels: mut List<String> = [];
        var kindText := "(";
        var count := 0;
        var hadComma := false;
        var singleLabel := "";
        var singleKind := "";
        var hadColon := false;
        loop true {
            if cursor >= size {
                failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected ) in tuple type");
            }
            if textLib.at(source, cursor) == ")" {
                cursor = cursor + 1;
                break;
            }
            if textLib.at(source, cursor) == "(" {
                failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "nested tuple types are not supported");
            }
            var label := "";
            var componentStart := cursor;
            if textLib.at(source, cursor) == ":" {
                hadColon = true;
                cursor = skipTrivia(source, cursor + 1, prefix);
                if cursor < size and textLib.at(source, cursor) == "(" {
                    failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "nested tuple types are not supported");
                }
                if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                    failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field type");
                }
                componentStart = cursor;
            } else {
                if not textLib.isNameStart(textLib.at(source, cursor)) {
                    failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field name");
                }
                firstStart := cursor;
                firstEnd := textLib.skipName(source, cursor);
                firstName := textLib.slice(source, firstStart, firstEnd);
                afterFirst := skipTrivia(source, firstEnd, prefix);
                if afterFirst < size and textLib.at(source, afterFirst) == ":" {
                    label = firstName;
                    if isReservedWord(label) {
                        unsupportedFeature(errSource, if useLocalErr { firstStart } else { errPos }, label, prefix);
                    }
                    if listLib.listContainsText(labels, label) {
                        failAt(errSource, if useLocalErr { firstStart } else { errPos }, prefix, "duplicate tuple field " + label);
                    }
                    listLib.pushBack(mut labels, label);
                    cursor = skipTrivia(source, afterFirst + 1, prefix);
                    if cursor < size and textLib.at(source, cursor) == "(" {
                        failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "nested tuple types are not supported");
                    }
                    if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                        failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected a tuple field type");
                    }
                    componentStart = cursor;
                }
            }
            parsedComponent := self(errSource, errPos, useLocalErr, source, componentStart, prefix, aliases, "tuple field", genericType, seen);
            componentKind := parsedComponent.kind;
            cursor = parsedComponent.next;
            diagPos := if useLocalErr { componentStart } else { errPos };
            if isTupleKind(componentKind) {
                failAt(errSource, diagPos, prefix, "nested tuple types are not supported");
            }
            if isListKind(componentKind) {
                failAt(errSource, diagPos, prefix, "list types inside tuples are not supported");
            }
            if componentKind == "Unit" {
                failAt(errSource, diagPos, prefix, "unsupported tuple component type Unit");
            }
            if count > 0 { kindText = kindText + ","; }
            kindText = kindText + label + ":" + componentKind;
            if count == 0 { singleLabel = label; singleKind = componentKind; }
            count = count + 1;
            cursor = skipTrivia(source, cursor, prefix);
            if cursor < size and textLib.at(source, cursor) == "," {
                hadComma = true;
                cursor = skipTrivia(source, cursor + 1, prefix);
            }
        }
        if count == 0 {
            failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "tuple type needs at least one field");
        }
        if count == 1 and singleLabel == "" and not hadComma {
            if hadColon {
                failAt(errSource, if useLocalErr { start } else { errPos }, prefix, "unnamed singleton tuple type needs trailing comma");
            }
            return (kind = singleKind, next = cursor);
        }
        return (kind = kindText + ")", next = cursor);
    }
    if start < size and textLib.at(source, start) == "[" {
        elemStart := skipTrivia(source, start + 1, prefix);
        inner := self(errSource, errPos, useLocalErr, source, elemStart, prefix, aliases, context, genericType, seen);
        if inner.kind == "Unit" {
            failAt(errSource, if useLocalErr { elemStart } else { errPos }, prefix, "unsupported array element type Unit");
        }
        afterElem := skipTrivia(source, inner.next, prefix);
        if afterElem >= size or textLib.at(source, afterElem) =!= ";" {
            failAt(errSource, if useLocalErr { afterElem } else { errPos }, prefix, if useLocalErr { "expected ;" } else { "expected [Type; Extent] in array type" });
        }
        extentStart := skipTrivia(source, afterElem + 1, prefix);
        var extentEnd := extentStart;
        loop extentEnd < size and textLib.isDigit(textLib.at(source, extentEnd)) {
            extentEnd = extentEnd + 1;
        }
        if extentEnd == extentStart {
            failAt(errSource, if useLocalErr { extentStart } else { errPos }, prefix, "expected positive integer extent in array type");
        }
        extent := parseDigits(source, extentStart, extentEnd);
        afterExtent := skipTrivia(source, extentEnd, prefix);
        if afterExtent >= size or textLib.at(source, afterExtent) =!= "]" {
            failAt(errSource, if useLocalErr { afterExtent } else { errPos }, prefix, if useLocalErr { "expected ]" } else { "expected [Type; Extent] in array type" });
        }
        return (kind = "[" + inner.kind + ";" + integer.intText(extent) + "]", next = afterExtent + 1);
    }
    if textLib.wordAt(source, start, "fn") {
        afterFn := skipTrivia(source, start + 2, prefix);
        if afterFn < size and textLib.at(source, afterFn) == "(" {
            var cursor := skipTrivia(source, afterFn + 1, prefix);
            paramLabels: mut List<String> = [];
            var encoded := "fn(";
            var count := 0;
            loop true {
                if cursor >= size {
                    failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected ) in function type");
                }
                if textLib.at(source, cursor) == ")" {
                    cursor = cursor + 1;
                    break;
                }
                var label := "";
                var paramStart := cursor;
                if textLib.isNameStart(textLib.at(source, cursor)) {
                    nameEnd := textLib.skipName(source, cursor);
                    firstName := textLib.slice(source, cursor, nameEnd);
                    afterName := skipTrivia(source, nameEnd, prefix);
                    if afterName < size and textLib.at(source, afterName) == ":" {
                        label = firstName;
                        if isReservedWord(label) {
                            unsupportedFeature(errSource, if useLocalErr { cursor } else { errPos }, label, prefix);
                        }
                        if listLib.listContainsText(paramLabels, label) {
                            failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "duplicate parameter " + label);
                        }
                        listLib.pushBack(mut paramLabels, label);
                        paramStart = skipTrivia(source, afterName + 1, prefix);
                    }
                }
                paramType := self(errSource, errPos, useLocalErr, source, paramStart, prefix, aliases, "function", genericType, seen);
                if count > 0 { encoded = encoded + ","; }
                encoded = encoded + label + ":" + paramType.kind;
                count = count + 1;
                cursor = skipTrivia(source, paramType.next, prefix);
                if cursor < size and textLib.at(source, cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                } else if cursor < size and textLib.at(source, cursor) == ")" {
                    cursor = cursor + 1;
                    break;
                } else {
                    failAt(errSource, if useLocalErr { cursor } else { errPos }, prefix, "expected , or ) in function type");
                }
            }
            afterClose := skipTrivia(source, cursor, prefix);
            if afterClose >= size or textLib.at(source, afterClose) =!= ":" {
                failAt(errSource, if useLocalErr { afterClose } else { errPos }, prefix, "expected : after function parameter types");
            }
            retType := self(errSource, errPos, useLocalErr, source, afterClose + 1, prefix, aliases, "function", genericType, seen);
            return (kind = encoded + "):" + retType.kind, next = retType.next);
        }
    }
    nameStart := if useLocalErr { start } else { errPos };
    parsedName := typeNameAt(source, start, prefix);
    after := parsedName.next;
    name := parsedName.name;
    afterName := skipTrivia(source, after, prefix);
    if name == "List" and afterName < size and textLib.at(source, afterName) == "<" {
        innerStart := skipTrivia(source, afterName + 1, prefix);
        if innerStart >= size or textLib.at(source, innerStart) == ">" {
            failAt(errSource, if useLocalErr { innerStart } else { errPos }, prefix, "expected a list element type");
        }
        inner := self(errSource, errPos, useLocalErr, source, innerStart, prefix, aliases, context, genericType, seen);
        if isListKind(inner.kind) {
            failAt(errSource, if useLocalErr { innerStart } else { errPos }, prefix, "nested list types are not supported");
        }
        close := skipTrivia(source, inner.next, prefix);
        if close >= size or textLib.at(source, close) =!= ">" {
            failAt(errSource, if useLocalErr { close } else { errPos }, prefix, if useLocalErr { "expected >" } else { "expected > in list type" });
        }
        return (kind = "List<" + inner.kind + ">", next = close + 1);
    }
    if genericType =!= "" and name == genericType { return (kind = genericType, next = after); }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" or numeric.isNarrowNumericKind(name) {
        return (kind = name, next = after);
    }
    numericKind := numeric.numericAliasKind(name);
    if numericKind =!= "" { return (kind = numericKind, next = after); }
    if not useLocalErr and isUnsupportedAliasTarget(name) {
        unsupportedAliasTarget(errSource, errPos, prefix, name);
        return (kind = "", next = after);
    }
    index := findAlias(aliases, name);
    if index >= 0 {
        alias := aliases[index];
        seenKey := integer.intText(alias.depth) + ":" + name;
        if listLib.listContainsText(seen, seenKey) {
            failAt(errSource, alias.at, prefix, "recursive type alias " + name);
            return (kind = "", next = after);
        }
        if alias.target == "" {
            unsupportedAliasTarget(errSource, alias.at, prefix, "target");
            return (kind = "", next = after);
        }
        nextSeen: mut List<String> = seen;
        listLib.pushBack(mut nextSeen, seenKey);
        scopedAliases := aliasesUpToDepth(aliases, alias.depth);
        resolved := self(errSource, alias.at, false, alias.target, 0, prefix, scopedAliases, "alias", "", nextSeen);
        trailing := skipTrivia(alias.target, resolved.next, prefix);
        if trailing < textLib.length(alias.target) {
            failAt(errSource, alias.at, prefix, "unexpected text after type");
        }
        return (kind = resolved.kind, next = after);
    }
    if textLib.indexOfText(name, ".", 0) >= 0 or not useLocalErr {
        failAt(errSource, nameStart, prefix, "unknown type alias " + name);
    } else {
        failAt(errSource, nameStart, prefix, "unsupported " + context + " type " + name);
    }
    (kind = "", next = after)
}

/** Resolves one scalar, flat named-tuple, array, list, or callable type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String {
    parsed := parseTypeWithSeen(source, position, false, text, 0, prefix, aliases, "alias", "", seen);
    after := skipTrivia(text, parsed.next, prefix);
    if after < textLib.length(text) {
        failAt(source, position, prefix, "unexpected text after type");
    }
    parsed.kind
}

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String {
    resolveTypeText(source, position, prefix, aliases, name, seen)
}

/** Parses one source-level flat named-tuple type `(label: Type, ...)`. */
parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    emptySeen: List<String> = [];
    parseTypeWithSeen(source, position, true, source, position, prefix, aliases, "tuple field", "", emptySeen)
}

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple, an array, a `List<T>`, or `fn(...): Return`. */
parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String): (kind: String, next: Int) {
    emptySeen: List<String> = [];
    parseTypeWithSeen(source, position, true, source, position, prefix, aliases, context, genericType, emptySeen)
}

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (kind: String, next: Int) {
    parseTypeAt(source, position, prefix, aliases, "function", genericType)
}

/** Parses a function signature. The optional `T` binder is only enabled for the registered core list declarations. */
parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): (next: Int, result: String, params: String, count: Int, genericType: String) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    var genericType := "";
    if listIntrinsic {
        cursor = expectSymbol(source, cursor, "<", prefix);
        binderStart := skipTrivia(source, cursor, prefix);
        binder := typeNameAt(source, binderStart, prefix);
        if binder.name =!= "T" { failAt(source, binderStart, prefix, "core list intrinsic type parameter must be T"); }
        genericType = binder.name;
        cursor = expectSymbol(source, binder.next, ">", prefix);
        cursor = skipTrivia(source, cursor, prefix);
    }
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    names: mut List<String> = [];
    var encoded := "";
    var count := 0;
    if textLib.startsWithAt(source, cursor, "...") {
        cursor = skipTrivia(source, cursor + 3, prefix);
        if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a name after ... in host value-pack declaration");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        encoded = "..." + textLib.slice(source, nameStart, cursor);
        count = -1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            failAt(source, cursor, prefix, "host value-pack declaration must be its only parameter");
        }
    } else if cursor < size and textLib.at(source, cursor) =!= ")" {
        loop true {
            if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = textLib.skipName(source, cursor);
            parameterName := textLib.slice(source, nameStart, cursor);
            if isReservedWord(parameterName) { unsupportedFeature(source, nameStart, parameterName, prefix); }
            if listLib.listContainsText(names, parameterName) {
                failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            listLib.pushBack(mut names, parameterName);
            cursor = skipTrivia(source, cursor, prefix);
            cursor = expectSymbol(source, cursor, ":", prefix);
            cursor = skipTrivia(source, cursor, prefix);
            var access := "";
            if textLib.wordAt(source, cursor, "mut") {
                if not listIntrinsic { failAt(source, cursor, prefix, "mut parameter signatures are reserved for registered core declarations"); }
                access = "mut ";
                cursor = skipTrivia(source, cursor + 3, prefix);
            }
            typed := parseFunctionType(source, cursor, prefix, aliases, genericType);
            cursor = skipTrivia(source, typed.next, prefix);
            if count > 0 { encoded = encoded + "|"; }
            encoded = encoded + parameterName + "=" + access + typed.kind;
            count = count + 1;
            if cursor < size and textLib.at(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
    }
    cursor = expectSymbol(source, cursor, ")", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    cursor = expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, aliases, genericType);
    (next = resultType.next, result = resultType.kind, params = encoded, count = count, genericType = genericType)
}

/** Resolves a bodyless public core declaration only when its module identity and complete ABI are registered. */
coreHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.core.io.v1" {
        if params == "...values" and result == "Unit" {
            if name == "output" { "lite$core$io$output:v1" }
            else if name == "outputLine" { "lite$core$io$outputLine:v1" }
            else { "" }
        } else if name == "errorLine" and params == "text=String" and result == "Unit" { "lite$reportError" }
        else if name == "exit" and params == "status=Int" and result == "Unit" { "lite$exit" }
        else if name == "inputArgs" and params == "" and result == "List<String>" { "lite$inputArgs" }
        else if params == "prompt=String" and result == "String" {
            if name == "inputAll" { "lite$inputAll" } else if name == "inputLine" { "lite$inputLine" } else { "" }
        } else if params == "prompt=String" and result == "Int" and name == "inputInt" { "lite$inputInt" }
        else if params == "prompt=String" and result == "Float" and name == "inputFloat" { "lite$inputFloat" }
        else if name == "stdinReader" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStdinReader" }
        else if name == "stdoutWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStdoutWriter" }
        else if name == "stderrWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStderrWriter" }
        else if name == "bufferReader" and params == "bytes=List<Int>" and result == "(kind:String,handle:Int)" { "lite$ioBufferReader" }
        else if name == "bufferWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioBufferWriter" }
        else if name == "writerBytes" and params == "writer=(kind:String,handle:Int)" and result == "List<Int>" { "lite$ioWriterBytes" }
        else if name == "writerText" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,text:String,error:String)" { "lite$ioWriterText" }
        else if name == "clearWriter" and params == "writer=(kind:String,handle:Int)" and result == "Unit" { "lite$ioClearWriter" }
        else if name == "readerOk" and params == "reader=(kind:String,handle:Int)" and result == "Bool" { "lite$ioReaderOk" }
        else if name == "readerAtEof" and params == "reader=(kind:String,handle:Int)" and result == "Bool" { "lite$ioReaderAtEof" }
        else if name == "readerError" and params == "reader=(kind:String,handle:Int)" and result == "String" { "lite$ioReaderError" }
        else if name == "read" and params == "reader=(kind:String,handle:Int)|maxBytes=Int" and result == "List<Int>" { "lite$ioRead" }
        else if name == "closeReader" and params == "reader=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioCloseReader" }
        else if name == "writerOk" and params == "writer=(kind:String,handle:Int)" and result == "Bool" { "lite$ioWriterOk" }
        else if name == "writerError" and params == "writer=(kind:String,handle:Int)" and result == "String" { "lite$ioWriterError" }
        else if name == "write" and params == "writer=(kind:String,handle:Int)|bytes=List<Int>" and result == "(ok:Bool,written:Int,error:String)" { "lite$ioWrite" }
        else if name == "flush" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioFlush" }
        else if name == "closeWriter" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioCloseWriter" }
        else { "" }
    } else if moduleIdentity == "lite.core.text.v1" {
        if name == "length" and params == "text=String" and result == "Int" { "lite$textLength" }
        else if name == "at" and params == "text=String|position=Int" and result == "String" { "lite$textAt" }
        else if name == "slice" and params == "text=String|start=Int|end=Int" and result == "String" { "lite$textSlice" }
        else { "" }
    } else if moduleIdentity == "lite.core.list.v1" {
        if name == "pushBack" and params == "values=mut List<T>|value=T" and result == "Unit" { "lite$core$list$pushBack:v1" }
        else if name == "popBack" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popBack:v1" }
        else if name == "pushFront" and params == "values=mut List<T>|value=T" and result == "Unit" { "lite$core$list$pushFront:v1" }
        else if name == "popFront" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popFront:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.file.v1" {
        if name == "kind" and params == "path=String" and result == "String" { "lite$fileKind" }
        else if name == "openReader" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenReader" }
        else if name == "openWriter" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenWriter" }
        else if name == "openAppender" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenAppender" }
        else if name == "listDir" and params == "path=String" and result == "List<String>" { "lite$fileListDir" }
        else if name == "makeDir" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileMakeDir" }
        else if name == "remove" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileRemove" }
        else if name == "copy" and params == "fromPath=String|toPath=String" and result == "(ok:Bool,error:String)" { "lite$fileCopy" }
        else if name == "symlink" and params == "targetPath=String|linkPath=String" and result == "(ok:Bool,error:String)" { "lite$fileSymlink" }
        else if name == "realPath" and params == "path=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileRealPath" }
        else if name == "makeTempDir" and params == "prefix=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileMakeTempDir" }
        else { "" }
    } else if moduleIdentity == "lite.core.process.v1" {
        if name == "cwd" and params == "" and result == "String" { "lite$processCwd" }
        else if name == "execPath" and params == "" and result == "String" { "lite$processExecPath" }
        else if name == "entryPath" and params == "" and result == "String" { "lite$processEntryPath" }
        else if name == "platform" and params == "" and result == "String" { "lite$processPlatform" }
        else if name == "arch" and params == "" and result == "String" { "lite$processArch" }
        else if name == "runtimeVersion" and params == "" and result == "String" { "lite$processRuntimeVersion" }
        else if name == "envGet" and params == "name=String" and result == "(found:Bool,value:String)" { "lite$processEnvGet" }
        else if name == "run" and params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|capture=Bool|stdinText=String" and
        result == "(status:Int,stdout:String,stderr:String,error:String)" { "lite$processRun" }
        else if name == "runBytes" and
        params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|timeoutMs=Int|stdinBytes=List<Int>|stdoutPath=String|stderrPath=String" and
        result == "(status:Int,error:String)" { "lite$processRunBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.crypto.v1" {
        if name == "randomBytes" and params == "count=Int" and result == "List<Int>" { "lite$cryptoRandomBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.time.v1" {
        if name == "monotonicNs" and params == "" and result == "Int" { "lite$timeMonotonicNs" }
        else if name == "epochNs" and params == "" and result == "Int" { "lite$timeEpochNs" }
        else if name == "sleepMs" and params == "ms=Int" and result == "Unit" { "lite$timeSleepMs" }
        else if name == "localDate" and params == "" and result == "String" { "lite$timeLocalDate" }
        else { "" }
    } else if moduleIdentity == "lite.core.unicode.v1" {
        if name == "toCodePoints" and params == "text=String" and result == "List<Int>" { "lite$unicodeToCodePoints" }
        else if name == "fromCodePoints" and params == "points=List<Int>" and result == "(ok:Bool,text:String,error:String)" { "lite$unicodeFromCodePoints" }
        else { "" }
    } else if moduleIdentity == "lite.compiler.source-reader.v1" and name == "read" and
    params == "importer=String|spec=String" and result == "(path:String,display:String,identity:String,text:String)" {
        "lite$readSource"
    } else {
        ""
    }
}

/** Maps a verified host core module identity to its soft-builtin logical path, or `""` outside soft-builtin stdlib modules. */
softBuiltinModuleForIdentity := fn(moduleIdentity: String): String {
    match {
        moduleIdentity == "lite.core.crypto.v1" { "lib/core/crypto" }
        moduleIdentity == "lite.core.file.v1" { "lib/core/file" }
        moduleIdentity == "lite.core.int.v1" { "lib/core/int" }
        moduleIdentity == "lite.core.text.v1" { "lib/core/text" }
        moduleIdentity == "lite.core.io.v1" { "lib/core/io" }
        moduleIdentity == "lite.core.unicode.v1" { "lib/core/unicode" }
        _ { "" }
    }
}

/** True when `moduleName` is a canonical core stdlib path with soft-builtin support. */
isSoftBuiltinModule := fn(moduleName: String): Bool {
    moduleName == "lib/core/crypto" or moduleName == "lib/core/file" or moduleName == "lib/core/int" or
    moduleName == "lib/core/text" or moduleName == "lib/core/io" or moduleName == "lib/core/unicode"
}

/** Returns the expected `(params, result)` ABI for a registered soft-builtin function, or empty fields when absent. */
softBuiltinAbi := fn(moduleName: String, name: String): (params: String, result: String) {
    if moduleName == "lib/core/crypto" {
        if name == "sha256Bytes" or name == "sha512Bytes" {
            return (params = "bytes=List<Int>", result = "String");
        }
        if name == "sha256Text" or name == "sha512Text" {
            return (params = "value=String", result = "String");
        }
        if name == "sha256File" {
            return (params = "path=String", result = "(ok:Bool,hex:String,error:String)");
        }
        if name == "hmacSha256Bytes" {
            return (params = "key=List<Int>|data=List<Int>", result = "String");
        }
        if name == "isValidBase64" or name == "isValidHex" {
            return (params = "encoded=String", result = "Bool");
        }
        if name == "base64Encode" or name == "hexEncode" {
            return (params = "bytes=List<Int>", result = "String");
        }
        if name == "base64Decode" or name == "hexDecode" {
            return (params = "encoded=String", result = "List<Int>");
        }
    } else if moduleName == "lib/core/file" {
        if name == "readBytes" {
            return (params = "path=String", result = "List<Int>");
        }
        if name == "readText" {
            return (params = "path=String", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "writeBytes" or name == "appendBytes" {
            return (params = "path=String|bytes=List<Int>", result = "(ok:Bool,error:String)");
        }
        if name == "writeText" or name == "appendText" {
            return (params = "path=String|text=String", result = "(ok:Bool,error:String)");
        }
    } else if moduleName == "lib/core/int" {
        if name == "intText" {
            return (params = "value=Int", result = "String");
        }
    } else if moduleName == "lib/core/text" {
        if name == "skipSpaces" or name == "skipName" {
            return (params = "source=String|start=Int", result = "Int");
        }
        if name == "indexOf" or name == "indexOfText" {
            return (params = "source=String|needle=String|start=Int", result = "Int");
        }
        if name == "startsWithAt" {
            return (params = "source=String|position=Int|text=String", result = "Bool");
        }
        if name == "wordAt" {
            return (params = "source=String|position=Int|word=String", result = "Bool");
        }
        if name == "joinTexts" {
            return (params = "values=List<String>|separator=String", result = "String");
        }
        if name == "textToInt" {
            return (params = "text=String", result = "(value:Int,ok:Bool)");
        }
        if name == "trimStart" or name == "trimEnd" or name == "trim" or name == "toLowerAscii" {
            return (params = "source=String", result = "String");
        }
        if name == "endsWith" {
            return (params = "source=String|suffix=String", result = "Bool");
        }
        if name == "repeatText" {
            return (params = "value=String|count=Int", result = "String");
        }
        if name == "containsText" {
            return (params = "source=String|needle=String", result = "Bool");
        }
        if name == "isDigit" {
            return (params = "text=String", result = "Bool");
        }
        if name == "isAsciiLetter" or name == "isNameStart" or name == "isNameContinue" or name == "isWhitespace" {
            return (params = "ch=String", result = "Bool");
        }
    } else if moduleName == "lib/core/io" {
        if name == "textReader" {
            return (params = "text=String", result = "(kind:String,handle:Int)");
        }
        if name == "readAll" {
            return (params = "reader=(kind:String,handle:Int)", result = "List<Int>");
        }
        if name == "readAllText" {
            return (params = "reader=(kind:String,handle:Int)", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "readLine" {
            return (params = "reader=(kind:String,handle:Int)", result = "(ok:Bool,line:String,eof:Bool,error:String)");
        }
        if name == "writeText" or name == "writeLine" {
            return (params = "writer=(kind:String,handle:Int)|text=String", result = "(ok:Bool,error:String)");
        }
    } else if moduleName == "lib/core/unicode" {
        if name == "utf8Encode" {
            return (params = "text=String", result = "List<Int>");
        }
        if name == "utf8DecodeStrict" {
            return (params = "bytes=List<Int>", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "utf8DecodeLossy" {
            return (params = "bytes=List<Int>", result = "String");
        }
    }
    (params = "", result = "")
}

/** Returns the verified soft-builtin module path when `moduleIdentity`, `name`, `params`, and `result` match, else `""`. */
coreSoftBuiltin := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    modName := softBuiltinModuleForIdentity(moduleIdentity);
    if modName == "" { return ""; }
    abi := softBuiltinAbi(modName, name);
    if abi.result =!= "" and abi.params == params and abi.result == result {
        return modName;
    }
    ""
}

/** Maps one registered output intrinsic identity to its source special-statement name. */
coreOutputName := fn(runtime: String): String {
    match {
        runtime == "lite$core$io$output:v1" { "output" }
        runtime == "lite$core$io$outputLine:v1" { "outputLine" }
        _ { "" }
    }
}

/** Returns the source name from one encoded `name=kind` function parameter entry. */
paramNameOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return entry; }
    textLib.slice(entry, 0, separator)
}

/** Returns the kind from one encoded `name=kind` function parameter entry. */
paramKindOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return ""; }
    textLib.slice(entry, separator + 1, textLib.length(entry))
}

/** Builds a canonical `fn(label:Kind,...):ResultKind` string from encoded parameter entries and a return kind. */
fnCanonicalKind := fn(params: List<String>, first: Int, count: Int, resultKind: String): String {
    var out := "fn(";
    var idx := 0;
    loop idx < count {
        if idx > 0 { out = out + ","; }
        entry := params[first + idx];
        out = out + paramNameOf(entry) + ":" + paramKindOf(entry);
        idx = idx + 1;
    }
    out + "):" + resultKind
}

/** Builds an integer parsed value with explicit scalar kind `kind`; `textValue` is empty. */
typedIntParsed := fn(kind: String, code: String, value: Int, constant: Bool, next: Int): Parsed {
    (kind = kind, code = code, intValue = value, textValue = "", constant = constant, next = next)
}

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed {
    typedIntParsed("Int", code, value, constant, next)
}

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed {
    (kind = "String", code = code, intValue = 0, textValue = value, constant = constant, next = next)
}

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed {
    (kind = "Bool", code = code, intValue = if value { 1 } else { 0 }, textValue = "", constant = constant, next = next)
}

/** Tries a constant integer operation without raising a compile-time runtime fault. */
tryFoldInteger := fn(operator: String, left: Int, right: Int): (value: Int, ok: Bool) {
    if operator == "+" { return integer.intAdd(left, right); }
    if operator == "-" { return integer.intSubtract(left, right); }
    if operator == "*" { return integer.intMultiply(left, right); }
    if operator == "/" { return integer.intDivide(left, right); }
    if operator == "%" { return integer.intRemainder(left, right); }
    if operator == ":/" { return integer.intFloorDivide(left, right); }
    integer.intFloorModulo(left, right)
}

/** Lowers a checked integer operation whose result is not a safe constant, preserving evaluation and fault timing. */
runtimeIntegerCode := fn(target: String, operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { return targetIntAddCode(target, left, right, position); }
    if operator == "-" { return targetIntSubtractCode(target, left, right, position); }
    if operator == "*" { return targetIntMultiplyCode(target, left, right, position); }
    if operator == "/" { return targetIntDivideCode(target, left, right, position); }
    if operator == "%" { return targetIntRemainderCode(target, left, right, position); }
    if operator == ":/" { return targetIntFloorDivideCode(target, left, right, position); }
    targetIntFloorModuloCode(target, left, right, position)
}

/** Lowers a checked integer operation at `kind`, adding a runtime range guard for narrow integer widths outside remainders. */
runtimeTypedIntegerCode := fn(target: String, kind: String, operator: String, left: String, right: String, position: Int): String {
    raw := runtimeIntegerCode(target, operator, left, right, position);
    if numeric.isNarrowIntKind(kind) and operator =!= "%" and operator =!= ":%" {
        return targetCheckedNarrowIntCode(target, kind, raw, position);
    }
    raw
}

/** Returns the index of the newest visible `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.depth >= -1 and local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** True when `locals` already binds runtime identifier `runtime` in scope or as a pre-scanned future placeholder. */
localsUseRuntime := fn(locals: List<Local>, runtime: String): Bool {
    loop locals as local {
        if local.runtime == runtime { return true; }
    }
    false
}

/** Returns the highest lexical block depth represented in `locals` (`depth <= -2` maps to `0 - 2 - depth`; `-1` maps to `0`). */
maxLocalLexDepth := fn(locals: List<Local>): Int {
    var best := 0;
    loop locals as entry {
        lexDepth := if entry.depth >= 0 { entry.depth }
        else if entry.depth <= -2 { 0 - 2 - entry.depth }
        else { 0 };
        if lexDepth > best { best = lexDepth; }
    }
    best
}

/** Returns the index of the latest reached or deferred local (`depth >= -1`) with runtime `runtime`, or -1 when unreached. */
latestActiveLocalByRuntime := fn(locals: List<Local>, runtime: String): Int {
    var i := 0;
    var found := -1;
    loop locals as local {
        if local.depth >= -1 and local.runtime == runtime { found = i; }
        i = i + 1;
    }
    found
}

/** True when `locals` already contains a reached declaration (`depth >= 0`) of `name` strictly deeper than `minExclusiveDepth`. */
localsHasDeeperReachedName := fn(locals: List<Local>, name: String, minExclusiveDepth: Int): Bool {
    loop locals as entry {
        if entry.depth > minExclusiveDepth and entry.name == name { return true; }
    }
    false
}

/** Returns the source name if `runtime` is a pre-scanned same/enclosing block placeholder not yet reached sequentially, or `""`. */
unreachedFutureLocalName := fn(locals: List<Local>, runtime: String): String {
    if runtime == "" or latestActiveLocalByRuntime(locals, runtime) >= 0 { return ""; }
    loop locals as entry {
        if entry.depth <= -2 and entry.runtime == runtime { return entry.name; }
    }
    ""
}

/** True when any unreached future placeholder (`depth <= -2`) or uninitialized reached binding (`depth >= 0`) exists in `locals`. */
localsHasAnyUnready := fn(locals: List<Local>): Bool {
    loop locals as entry {
        if entry.depth <= -2 {
            if latestActiveLocalByRuntime(locals, entry.runtime) < 0 { return true; }
        } else if entry.depth >= 0 {
            actIdx := latestActiveLocalByRuntime(locals, entry.runtime);
            if actIdx >= 0 and locals[actIdx].initState =!= INIT_STATE_INIT { return true; }
        }
    }
    false
}

/** Target runtime identifier for an imported module's top-level value, or a root value. */
moduleValueRuntime := fn(target: String, moduleKey: String, name: String): String {
    if moduleKey == "" { return "lite_" + name; }
    if target == "ts" { return "lite$m$" + moduleKey + "$" + name; }
    "lt_m_" + moduleKey + "__" + name
}

/** Target runtime identifier for a user-defined top-level function. */
moduleFunctionRuntime := fn(target: String, moduleKey: String, name: String): String {
    if moduleKey == "" {
        if target == "ts" { return "liteFn_" + name; }
        return "lt_fn__" + name;
    }
    if target == "ts" { return "liteFn$" + moduleKey + "$" + name; }
    "lt_fn_" + moduleKey + "__" + name
}

/** Allocates a collision-free compiler-internal temporary name scoped to `locals`. */
freshScopeTemp := fn(locals: List<Local>, prefix: String): String {
    if not localsUseRuntime(locals, prefix) { return prefix; }
    var suffix := 2;
    loop true {
        candidate := prefix + "$" + integer.intText(suffix);
        if not localsUseRuntime(locals, candidate) { return candidate; }
        suffix = suffix + 1;
    }
    prefix
}

/** Selects a target-safe runtime name for a binding, using `lite_<name>` when unshadowed and a scope-local shadow suffix when shadowed. */
localRuntimeName := fn(target: String, locals: List<Local>, name: String, moduleKey: String, depth: Int): String {
    if depth == 0 and moduleKey =!= "" {
        return moduleValueRuntime(target, moduleKey, name);
    }
    base := "lite_" + name;
    if not localsUseRuntime(locals, base) { return base; }
    var suffix := 2;
    loop true {
        candidate := if target == "ts" { "lite_" + name + "$" + integer.intText(suffix) }
        else { "lt_s" + integer.intText(suffix) + "_" + name };
        if not localsUseRuntime(locals, candidate) { return candidate; }
        suffix = suffix + 1;
    }
    base
}

/** Claims the pre-reserved runtime for `(lexDepth, name)` if pre-scanned, or allocates a collision-free runtime. */
claimOrMakeLocalRuntime := fn(target: String, locals: List<Local>, name: String, moduleKey: String, lexDepth: Int): String {
    if lexDepth == 0 and moduleKey =!= "" {
        return moduleValueRuntime(target, moduleKey, name);
    }
    placeholderDepth := 0 - 2 - lexDepth;
    loop locals as entry {
        if entry.depth == placeholderDepth and entry.name == name and entry.runtime =!= "" and
        latestActiveLocalByRuntime(locals, entry.runtime) < 0 {
            return entry.runtime;
        }
    }
    localRuntimeName(target, locals, name, moduleKey, lexDepth)
}

/** True for the ten comparison spellings accepted by this checkpoint. */
isComparison := fn(operator: String): Bool {
    operator == "==" or operator == "=!=" or operator == "<" or operator == "<!" or
    operator == "<=" or operator == "<!=" or operator == ">" or operator == ">!" or
    operator == ">=" or operator == ">!="
}

/** Precedence level of a recognized binary operator; comparisons bind below arithmetic and logic binds below comparisons. */
operatorLevel := fn(operator: String): Int {
    if operator == "or" { 2 }
    else if operator == "and" { 3 }
    else if isComparison(operator) { 5 }
    else if operator == "+" or operator == "-" { 10 }
    else if operator == "*" or operator == "/" or operator == "%" or operator == ":/" or operator == ":%" { 20 }
    else if operator == "**" { 25 }
    else { 0 }
}

/** Reads an operator at `position`, preferring the longest spelling; returns empty text when none starts there. */
readOperator := fn(source: String, position: Int): Operator {
    ch := textLib.at(source, position);
    if ch == "*" {
        if textLib.startsWithAt(source, position, "**") { return (text = "**", width = 2); }
        return (text = "*", width = 1);
    }
    if textLib.startsWithAt(source, position, "=!=") { return (text = "=!=", width = 3); }
    if textLib.startsWithAt(source, position, "<!=") { return (text = "<!=", width = 3); }
    if textLib.startsWithAt(source, position, ">!=") { return (text = ">!=", width = 3); }
    if textLib.startsWithAt(source, position, "==") { return (text = "==", width = 2); }
    if textLib.startsWithAt(source, position, "<=") { return (text = "<=", width = 2); }
    if textLib.startsWithAt(source, position, ">=") { return (text = ">=", width = 2); }
    if textLib.startsWithAt(source, position, "<!") { return (text = "<!", width = 2); }
    if textLib.startsWithAt(source, position, ">!") { return (text = ">!", width = 2); }
    if ch == "<" { return (text = "<", width = 1); }
    if ch == ">" { return (text = ">", width = 1); }
    if ch == "+" or ch == "-" or ch == "/" or ch == "%" { return (text = ch, width = 1); }
    if textLib.startsWithAt(source, position, ":/") { return (text = ":/", width = 2); }
    if textLib.startsWithAt(source, position, ":%") { return (text = ":%", width = 2); }
    if textLib.isNameStart(ch) {
        after := textLib.skipName(source, position);
        word := textLib.slice(source, position, after);
        if word == "and" or word == "or" { return (text = word, width = after - position); }
    }
    (text = "", width = 0)
}

/** True when a parsed atom is followed by a binary operator belonging to this precedence-climbing invocation. */
binaryFollows := fn(source: String, next: Int, prefix: String, minimum: Int): Bool {
    cursor := skipTrivia(source, next, prefix);
    if cursor >= textLib.length(source) { return false; }
    operator := readOperator(source, cursor);
    operator.text =!= "" and operatorLevel(operator.text) >= minimum
}

/** Peeks only for a following comparison; the one-character filter avoids a full operator scan for ordinary delimiters and logic. */
comparisonOperatorAt := fn(source: String, position: Int): Operator {
    if position >= textLib.length(source) { return (text = "", width = 0); }
    ch := textLib.at(source, position);
    if ch == "=" or ch == "<" or ch == ">" { return readOperator(source, position); }
    (text = "", width = 0)
}

/** Folds one of the ten Int comparisons to a Bool. */
compareIntegers := fn(operator: String, left: Int, right: Int): Bool {
    if operator == "==" { left == right }
    else if operator == "=!=" { left =!= right }
    else if operator == "<" { left < right }
    else if operator == "<!" { left >= right }
    else if operator == "<=" { left <= right }
    else if operator == "<!=" { left > right }
    else if operator == ">" { left > right }
    else if operator == ">!" { left <= right }
    else if operator == ">=" { left >= right }
    else { left < right }
}

/** Folds String equality or inequality. */
compareTexts := fn(operator: String, left: String, right: String): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Folds Bool equality or inequality. */
compareBools := fn(operator: String, left: Bool, right: Bool): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
compareParsed := fn(target: String, source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed {
    if numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind) {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
        }
        return boolParsed(targetComparisonCode(target, operator, "Int", left.code, right.code), false, false, right.next);
    }
    if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
        codes: List<String> = [left.code, right.code];
        kinds: List<String> = [left.kind, right.kind];
        operators: List<String> = [operator];
        return boolParsed(targetComparisonChainCode(target, codes, kinds, operators, 1, at), false, false, right.next);
    }
    if left.kind =!= right.kind {
        failAt(source, at, prefix, "cannot compare " + displayKind(left.kind) + " and " + displayKind(right.kind));
    }
    if left.kind == "Never" {
        failAt(source, at, prefix, "cannot compare Never values");
    }
    if isTupleKind(left.kind) {
        failAt(source, at, prefix, "cannot compare tuple values");
    }
    if isListKind(left.kind) {
        failAt(source, at, prefix, "cannot compare list values");
    }
    if isFnKind(left.kind) {
        failAt(source, at, prefix, "cannot compare function values");
    }
    if operator =!= "==" and operator =!= "=!=" {
        failAt(source, at, prefix, "operator " + operator + " requires Int operands");
    }
    if left.constant and right.constant {
        value := if left.kind == "String" {
            compareTexts(operator, left.textValue, right.textValue)
        } else {
            compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
        };
        return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
    }
    boolParsed(targetComparisonCode(target, operator, left.kind, left.code, right.code), false, false, right.next)
}

/** Admits an integer literal into a narrow Int or exact Float/Float32 storage context only when not followed by a binary operator at `minimum`. */
contextualIntegerParsed := fn(target: String, source: String, position: Int, prefix: String, expected: String, minimum: Int, value: Int, code: String, next: Int): Parsed {
    if expected =!= "" and expected =!= "Int" and not binaryFollows(source, next, prefix, minimum) {
        if numeric.isNarrowIntKind(expected) {
            if not numeric.intKindFits(expected, value) {
                failAt(source, position, prefix, "integer literal outside " + expected + " range");
            }
            return typedIntParsed(expected, code, value, true, next);
        }
        if expected == "Float32" {
            if not numeric.intExactlyFloat32(value) {
                failAt(source, position, prefix, "integer literal is not exactly representable in Float32");
            }
            return (kind = "Float32", code = targetFloat32OperandCode(target, "Int", code), intValue = 0, textValue = "", constant = false, next = next);
        }
        if expected == "Float" {
            if not numeric.intExactlyFloat(value) {
                failAt(source, position, prefix, "integer literal is not exactly representable in Float");
            }
            return (kind = "Float", code = targetFloatOperandCode(target, "Int", code), intValue = 0, textValue = "", constant = false, next = next);
        }
    }
    intParsed(code, value, true, next)
}

/** Parses signed decimal numeric literals in one scan, applying contextual narrow/Float width checks when the atom completes the expression. */
parseNumber := fn(target: String, source: String, position: Int, prefix: String, expected: String, minimum: Int): Parsed {
    var cursor := position;
    var negative := false;
    ch := textLib.at(source, cursor);
    if ch == "+" or ch == "-" {
        negative = ch == "-";
        cursor = skipTrivia(source, cursor + 1, prefix);
    }
    start := cursor;
    afterDigit := cursor + 1;
    following := if afterDigit < textLib.length(source) { textLib.at(source, afterDigit) } else { "" };
    if textLib.isDigit(textLib.at(source, cursor)) and not textLib.isDigit(following) and following =!= "." and following =!= "e" and following =!= "E" {
        /* A lone decimal digit is always small: skip the general scanner record on this hot path. */
        digit := textLib.digitValue(textLib.at(source, cursor));
        value := if negative { -digit } else { digit };
        code := targetIntLiteralCode(target, value, negative, textLib.slice(source, cursor, afterDigit));
        return contextualIntegerParsed(target, source, position, prefix, expected, minimum, value, code, afterDigit);
    }
    scanned := numeric.scanNumericLiteral(source, cursor);
    cursor = scanned.next;
    integerEnd := scanned.integerEnd;
    if start == integerEnd { failAt(source, position, prefix, "expected a decimal numeric literal"); }
    if scanned.exponentMissingAt >= 0 { failAt(source, scanned.exponentMissingAt, prefix, "expected exponent digits"); }
    var digitStart := start;
    loop digitStart + 1 < integerEnd and textLib.at(source, digitStart) == "0" { digitStart = digitStart + 1; }
    if scanned.floating {
        digits := textLib.slice(source, start, integerEnd) + textLib.slice(source, scanned.fractionStart, scanned.fractionEnd);
        fractionCount := scanned.fractionEnd - scanned.fractionStart;
        raw := textLib.slice(source, digitStart, cursor);
        if expected == "Float32" and not binaryFollows(source, cursor, prefix, minimum) {
            if not numeric.finiteFloat32Digits(digits, fractionCount, scanned.exponent) {
                failAt(source, position, prefix, "floating literal outside Float32 range");
            }
            return (kind = "Float32", code = targetFloat32LiteralCode(target, raw, negative), intValue = 0, textValue = "", constant = false, next = cursor);
        }
        if not numeric.finiteFloatDigits(digits, fractionCount, scanned.exponent) {
            failAt(source, position, prefix, "floating literal is not finite");
        }
        code := targetFloatLiteralCode(target, raw, negative);
        return (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = cursor);
    }
    if scanned.outsideInt or (not negative and scanned.magnitude == -9223372036854775808) {
        if numeric.isNarrowIntKind(expected) and not binaryFollows(source, cursor, prefix, minimum) {
            failAt(source, position, prefix, "integer literal outside " + expected + " range");
        }
        failAt(source, position, prefix, "integer literal outside signed 64-bit range");
    }
    value := if negative { scanned.magnitude } else { 0 - scanned.magnitude };
    code := targetIntLiteralCode(target, value, negative, textLib.slice(source, digitStart, cursor));
    contextualIntegerParsed(target, source, position, prefix, expected, minimum, value, code, cursor)
}

/** Joins adjacent double-quoted literal tokens across trivia in one scan and encodes the complete value once. Escapes and malformed later tokens retain their own source positions. */
parseText := fn(target: String, source: String, position: Int, prefix: String): Parsed {
    var literalStart := position;
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= textLib.length(source) {
            failAt(source, literalStart, prefix, "unterminated string literal");
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            next := skipTrivia(source, cursor, prefix);
            if next < textLib.length(source) and textLib.at(source, next) == "\"" {
                literalStart = next;
                cursor = next + 1;
                continue;
            }
            break;
        }
        if ch == "\\" {
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= textLib.length(source) {
                failAt(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := textLib.at(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                failAt(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    textParsed(targetTextLiteralCode(target, value), value, true, cursor)
}

/** Returns the position after one string literal, or the source end when it does not close; alias collection leaves lexical diagnostics to the main pass. */
pub skipAliasString := fn(source: String, position: Int): Int {
    var cursor := position + 1;
    loop true {
        quoteAt := textLib.indexOfText(source, "\"", cursor);
        if quoteAt < 0 { return textLib.length(source); }
        var unescaped := true;
        var check := quoteAt - 1;
        loop check >= cursor and textLib.at(source, check) == "\\" {
            unescaped = not unescaped;
            check = check - 1;
        }
        if unescaped { return quoteAt + 1; }
        cursor = quoteAt + 1;
    }
    textLib.length(source)
}

/** Collects distinct target or user-function call tokens, skipping quoted text and consuming whole identifiers. */
scanCodeCalls := fn(code: String, existing: String, userFnsOnly: Bool): String {
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    var nextFinally := if userFnsOnly { -1 } else { textLib.indexOfText(code, "finally", 0) };
    if nextLite < 0 and nextLt < 0 and nextFinally < 0 { return existing; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var calls := existing;
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        if nextFinally >= 0 and nextFinally < cursor { nextFinally = textLib.indexOfText(code, "finally", cursor); }
        var hit := -1;
        if nextLite >= 0 { hit = nextLite; }
        if nextLt >= 0 and (hit < 0 or nextLt < hit) { hit = nextLt; }
        if nextFinally >= 0 and (hit < 0 or nextFinally < hit) { hit = nextFinally; }
        if hit < 0 { return calls; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = textLib.indexOfText(code, "\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        name := textLib.slice(code, hit, endPos);
        if endPos < size and textLib.at(code, endPos) == "(" {
            matched := if userFnsOnly {
                textLib.startsWithAt(name, 0, "lt_fn_") or textLib.startsWithAt(name, 0, "liteFn$") or
                textLib.startsWithAt(name, 0, "liteFn_")
            } else {
                (textLib.startsWithAt(name, 0, "lite$") and not textLib.startsWithAt(name, 0, "lite$m$")) or
                textLib.startsWithAt(name, 0, "lite_") or
                (textLib.startsWithAt(name, 0, "lt_") and not textLib.startsWithAt(name, 0, "lt_fn_") and
                not textLib.startsWithAt(name, 0, "lt_m_") and not textLib.startsWithAt(name, 0, "lt_s"))
            };
            if matched {
                token := name + "(|";
                if textLib.indexOfText(calls, "|" + token, 0) < 0 { calls = calls + token; }
            }
        } else if not userFnsOnly and name == "finally" {
            var afterFin := endPos;
            loop afterFin < size and (textLib.at(code, afterFin) == " " or textLib.at(code, afterFin) == "\t" or textLib.at(code, afterFin) == "\n") {
                afterFin = afterFin + 1;
            }
            if afterFin < size and textLib.at(code, afterFin) == "{" {
                if textLib.indexOfText(calls, "|lite$finally(|", 0) < 0 { calls = calls + "lite$finally(|"; }
            }
        }
        cursor = endPos;
    }
    calls
}

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, false)
}

/** Collects distinct user-function call tokens (`lt_fn_*(` / `liteFn...(`) from `code`, skipping quoted text. */
pub userFunctionCalls := fn(code: String, existing: String): String {
    scanCodeCalls(code, existing, true)
}

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCalls := fn(items: Items): String {
    var calls := "|";
    loop items as item { calls = targetCodeCalls(item.code, calls); }
    calls
}

/** True when `calls` already contains the pipe-delimited call token `needle`. */
pub hasHelperToken := fn(calls: String, needle: String): Bool {
    textLib.indexOfText(calls, "|" + needle + "|", 0) >= 0
}

/** Creates an empty 32-bucket token set. */
pub emptyTokenBuckets := fn(): TokenBuckets {
    (count = 0, b0 = "|", b1 = "|", b2 = "|", b3 = "|", b4 = "|", b5 = "|", b6 = "|", b7 = "|",
    b8 = "|", b9 = "|", b10 = "|", b11 = "|", b12 = "|", b13 = "|", b14 = "|", b15 = "|",
    b16 = "|", b17 = "|", b18 = "|", b19 = "|", b20 = "|", b21 = "|", b22 = "|", b23 = "|",
    b24 = "|", b25 = "|", b26 = "|", b27 = "|", b28 = "|", b29 = "|", b30 = "|", b31 = "|")
}

/** Maps a token string to its 0..31 bucket index using its code-point length. */
tokenBucketSlot := fn(needle: String): Int {
    n := textLib.length(needle);
    n - (n / 32) * 32
}

/** Reads the bucket string stored at `slot` (0..31) in `s`. */
tokenBucketGet := fn(s: TokenBuckets, slot: Int): String {
    if slot < 16 {
        if slot < 8 {
            if slot == 0 { return s.b0; }
            if slot == 1 { return s.b1; }
            if slot == 2 { return s.b2; }
            if slot == 3 { return s.b3; }
            if slot == 4 { return s.b4; }
            if slot == 5 { return s.b5; }
            if slot == 6 { return s.b6; }
            return s.b7;
        }
        if slot == 8 { return s.b8; }
        if slot == 9 { return s.b9; }
        if slot == 10 { return s.b10; }
        if slot == 11 { return s.b11; }
        if slot == 12 { return s.b12; }
        if slot == 13 { return s.b13; }
        if slot == 14 { return s.b14; }
        return s.b15;
    }
    if slot < 24 {
        if slot == 16 { return s.b16; }
        if slot == 17 { return s.b17; }
        if slot == 18 { return s.b18; }
        if slot == 19 { return s.b19; }
        if slot == 20 { return s.b20; }
        if slot == 21 { return s.b21; }
        if slot == 22 { return s.b22; }
        return s.b23;
    }
    if slot == 24 { return s.b24; }
    if slot == 25 { return s.b25; }
    if slot == 26 { return s.b26; }
    if slot == 27 { return s.b27; }
    if slot == 28 { return s.b28; }
    if slot == 29 { return s.b29; }
    if slot == 30 { return s.b30; }
    s.b31
}

/** Returns a copy of `s` with bucket `slot` replaced by `val` and `count` incremented. */
withTokenBucket := fn(s: TokenBuckets, slot: Int, val: String): TokenBuckets {
    (count = s.count + 1,
    b0 = if slot == 0 { val } else { s.b0 }, b1 = if slot == 1 { val } else { s.b1 },
    b2 = if slot == 2 { val } else { s.b2 }, b3 = if slot == 3 { val } else { s.b3 },
    b4 = if slot == 4 { val } else { s.b4 }, b5 = if slot == 5 { val } else { s.b5 },
    b6 = if slot == 6 { val } else { s.b6 }, b7 = if slot == 7 { val } else { s.b7 },
    b8 = if slot == 8 { val } else { s.b8 }, b9 = if slot == 9 { val } else { s.b9 },
    b10 = if slot == 10 { val } else { s.b10 }, b11 = if slot == 11 { val } else { s.b11 },
    b12 = if slot == 12 { val } else { s.b12 }, b13 = if slot == 13 { val } else { s.b13 },
    b14 = if slot == 14 { val } else { s.b14 }, b15 = if slot == 15 { val } else { s.b15 },
    b16 = if slot == 16 { val } else { s.b16 }, b17 = if slot == 17 { val } else { s.b17 },
    b18 = if slot == 18 { val } else { s.b18 }, b19 = if slot == 19 { val } else { s.b19 },
    b20 = if slot == 20 { val } else { s.b20 }, b21 = if slot == 21 { val } else { s.b21 },
    b22 = if slot == 22 { val } else { s.b22 }, b23 = if slot == 23 { val } else { s.b23 },
    b24 = if slot == 24 { val } else { s.b24 }, b25 = if slot == 25 { val } else { s.b25 },
    b26 = if slot == 26 { val } else { s.b26 }, b27 = if slot == 27 { val } else { s.b27 },
    b28 = if slot == 28 { val } else { s.b28 }, b29 = if slot == 29 { val } else { s.b29 },
    b30 = if slot == 30 { val } else { s.b30 }, b31 = if slot == 31 { val } else { s.b31 })
}

/** True when `s` contains `needle`. */
pub tokenBucketHas := fn(s: TokenBuckets, needle: String): Bool {
    if needle == "" { return false; }
    textLib.indexOfText(tokenBucketGet(s, tokenBucketSlot(needle)), "|" + needle + "|", 0) >= 0
}

/** Returns `s` with `needle` inserted into its length-hashed bucket. */
pub tokenBucketAdd := fn(s: TokenBuckets, needle: String): TokenBuckets {
    if needle == "" { return s; }
    slot := tokenBucketSlot(needle);
    b := tokenBucketGet(s, slot);
    if textLib.indexOfText(b, "|" + needle + "|", 0) >= 0 { return s; }
    withTokenBucket(s, slot, b + needle + "|")
}

/** Serializes all 32 buckets into one `|`-delimited string. */
pub flattenTokenBuckets := fn(s: TokenBuckets): String {
    var out := "|";
    var i := 0;
    loop i < 32 {
        b := tokenBucketGet(s, i);
        bLen := textLib.length(b);
        if bLen > 1 { out = out + textLib.slice(b, 1, bLen); }
        i = i + 1;
    }
    out
}

/** Collects distinct `lite*` / `lt_*` call or value identifier tokens from `code` into `existing`. */
pub codeReachableTokensSet := fn(code: String, existing: TokenBuckets): TokenBuckets {
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    if nextLite < 0 and nextLt < 0 { return existing; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var tokens := existing;
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return tokens; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor {
                nextQuote = textLib.indexOfText(code, "\"", cursor);
            }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        name := textLib.slice(code, hit, endPos);
        token := if textLib.startsWithAt(name, 0, "lt_fn_") or textLib.startsWithAt(name, 0, "liteFn$") or
        textLib.startsWithAt(name, 0, "liteFn_") {
            name + "("
        } else {
            name
        };
        tokens = tokenBucketAdd(tokens, token);
        cursor = endPos;
    }
    tokens
}

/** True when `kind` represents a top-level value or mutable variable declaration item. */
isTopDeclKind := fn(kind: String): Bool {
    kind == "LocalInt" or kind == "LocalString" or kind == "LocalBool" or kind == "LocalFloat" or
    kind == "LocalTuple" or kind == "LocalList" or kind == "LocalFn" or kind == "LocalUnit" or
    kind == "VarInt" or kind == "VarString" or kind == "VarBool" or kind == "VarFloat" or
    kind == "VarTuple" or kind == "VarList" or kind == "VarFn" or kind == "VarUnit"
}

/** Removes unreachable top-level function bodies and side-effect-free code across root and inner blocks for `target`. */
pub filterReachableItemsForTarget := fn(items: Items, target: String): Items {
    pruned := pruneBlockScopedItems(items, target);
    var hasPrunable := false;
    var seedTokens := emptyTokenBuckets();
    var fnDepth := 0;
    var blockDepth := 0;
    var nextIsPure := false;
    pureDecls: mut List<String> = [];
    loop pruned as item {
        if item.kind == "PureGlobal" {
            nextIsPure = true;
            continue;
        }
        if item.kind == "FunctionStart" {
            hasPrunable = true;
            fnDepth = fnDepth + 1;
            nextIsPure = false;
            continue;
        }
        if item.kind == "FunctionEnd" {
            if fnDepth > 0 { fnDepth = fnDepth - 1; }
            nextIsPure = false;
            continue;
        }
        if fnDepth > 0 {
            nextIsPure = false;
            continue;
        }
        isTopDecl := blockDepth == 0 and isTopDeclKind(item.kind);
        isPureDecl := isTopDecl and (nextIsPure or ((target == "ts" or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code)));
        nextIsPure = false;
        if item.kind == "Scope" or item.kind == "If" or item.kind == "Loop" or item.kind == "LoopSeq" {
            blockDepth = blockDepth + 1;
            seedTokens = codeReachableTokensSet(item.code, seedTokens);
        } else if item.kind == "EndScope" or item.kind == "EndIf" or item.kind == "EndLoop" {
            if blockDepth > 0 { blockDepth = blockDepth - 1; }
        } else if isPureDecl {
            hasPrunable = true;
            listLib.pushBack(mut pureDecls, item.runtime);
        } else if item.kind =!= "Import" and item.kind =!= "PublicFunction" and item.kind =!= "PublicValue" and
        item.kind =!= "PublicType" and item.kind =!= "Noop" {
            seedTokens = codeReachableTokensSet(item.code, seedTokens);
            if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                seedTokens = tokenBucketAdd(seedTokens, item.runtime);
            }
        }
    }
    if not hasPrunable { return pruned; }

    var reachable := seedTokens;
    var scanned := emptyTokenBuckets();
    loop true {
        beforeCount := reachable.count;
        var scanFnDepth := 0;
        var scanBlockDepth := 0;
        var scanBody := false;
        loop pruned as item {
            if item.kind == "PureGlobal" {
                continue;
            } else if item.kind == "FunctionStart" {
                if scanFnDepth == 0 {
                    token := item.runtime + "(";
                    scanBody = tokenBucketHas(reachable, token) and not tokenBucketHas(scanned, token);
                    if scanBody { scanned = tokenBucketAdd(scanned, token); }
                }
                scanFnDepth = scanFnDepth + 1;
            } else if item.kind == "FunctionEnd" {
                if scanFnDepth > 0 { scanFnDepth = scanFnDepth - 1; }
                if scanFnDepth == 0 { scanBody = false; }
            } else if scanFnDepth > 0 {
                if scanBody {
                    reachable = codeReachableTokensSet(item.code, reachable);
                    if textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
                        reachable = tokenBucketAdd(reachable, item.runtime);
                    }
                }
            } else {
                if scanBlockDepth == 0 and isTopDeclKind(item.kind) {
                    if listLib.listContainsText(pureDecls, item.runtime) and tokenBucketHas(reachable, item.runtime) and
                    not tokenBucketHas(scanned, item.runtime) {
                        scanned = tokenBucketAdd(scanned, item.runtime);
                        reachable = codeReachableTokensSet(item.code, reachable);
                    }
                }
                if item.kind == "Scope" or item.kind == "If" or item.kind == "Loop" or item.kind == "LoopSeq" {
                    scanBlockDepth = scanBlockDepth + 1;
                } else if item.kind == "EndScope" or item.kind == "EndIf" or item.kind == "EndLoop" {
                    if scanBlockDepth > 0 { scanBlockDepth = scanBlockDepth - 1; }
                }
            }
        }
        if reachable.count == beforeCount { break; }
    }

    filtered: mut Items = [];
    var keepFnDepth := 0;
    var keepBlockDepth := 0;
    var keepFn := false;
    var nextDeclPure := false;
    loop pruned as item {
        if item.kind == "PureGlobal" {
            nextDeclPure = true;
            continue;
        }
        if item.kind == "FunctionStart" {
            nextDeclPure = false;
            if keepFnDepth == 0 { keepFn = tokenBucketHas(reachable, item.runtime + "("); }
            keepFnDepth = keepFnDepth + 1;
            if keepFn { listLib.pushBack(mut filtered, item); }
        } else if item.kind == "FunctionEnd" {
            nextDeclPure = false;
            wasKeeping := keepFn;
            if keepFnDepth > 0 { keepFnDepth = keepFnDepth - 1; }
            if keepFnDepth == 0 { keepFn = false; }
            if wasKeeping { listLib.pushBack(mut filtered, item); }
        } else if keepFnDepth > 0 {
            nextDeclPure = false;
            if keepFn { listLib.pushBack(mut filtered, item); }
        } else {
            dropDecl := keepBlockDepth == 0 and isTopDeclKind(item.kind) and
            (nextDeclPure or ((target == "ts" or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code))) and
            not tokenBucketHas(reachable, item.runtime);
            nextDeclPure = false;
            if item.kind == "Scope" or item.kind == "If" or item.kind == "Loop" or item.kind == "LoopSeq" {
                keepBlockDepth = keepBlockDepth + 1;
            } else if item.kind == "EndScope" or item.kind == "EndIf" or item.kind == "EndLoop" {
                if keepBlockDepth > 0 { keepBlockDepth = keepBlockDepth - 1; }
            }
            if not dropDecl { listLib.pushBack(mut filtered, item); }
        }
    }
    filtered
}

/** Removes unreachable top-level function bodies and side-effect-free declarations for TS emission. */
pub filterReachableItems := fn(items: Items): Items {
    filterReachableItemsForTarget(items, "ts")
}

/** Reads one raw alias target type from `position`, capturing a parenthesized tuple type or a generic `List<...>` application through its matching close, or a single name. */
collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start < size and textLib.at(source, start) == "(" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "(" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textLib.slice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textLib.slice(source, start, size), next = size)
    } else if start < size and textLib.at(source, start) == "[" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "[" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "]" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textLib.slice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textLib.slice(source, start, size), next = size)
    } else if textLib.wordAt(source, start, "fn") {
        afterFn := skipTrivia(source, start + 2, prefix);
        if afterFn < size and textLib.at(source, afterFn) == "(" {
            var cursor := afterFn;
            var depth := 0;
            var afterParen := -1;
            loop cursor < size {
                ch := textLib.at(source, cursor);
                if ch == "\"" {
                    cursor = skipAliasString(source, cursor);
                } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                    cursor = skipComment(source, cursor, prefix);
                } else if ch == "(" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ")" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        afterParen = cursor;
                        break;
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            if afterParen < 0 {
                return (text = textLib.slice(source, start, size), next = size);
            }
            afterClose := skipTrivia(source, afterParen, prefix);
            if afterClose < size and textLib.at(source, afterClose) == ":" {
                retTarget := self(source, afterClose + 1, prefix);
                return (text = textLib.slice(source, start, retTarget.next), next = retTarget.next);
            }
            return (text = textLib.slice(source, start, afterClose), next = afterClose);
        }
        parsedName := typeNameAt(source, start, prefix);
        (text = textLib.slice(source, start, parsedName.next), next = parsedName.next)
    } else {
        parsedName := typeNameAt(source, start, prefix);
        after := parsedName.next;
        afterName := skipTrivia(source, after, prefix);
        if afterName < size and textLib.at(source, afterName) == "<" {
            var cursor := afterName;
            var depth := 0;
            loop cursor < size {
                ch := textLib.at(source, cursor);
                if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                    cursor = skipComment(source, cursor, prefix);
                } else if ch == "<" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ">" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        return (text = textLib.slice(source, start, cursor), next = cursor);
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            (text = textLib.slice(source, start, size), next = size)
        } else {
            (text = textLib.slice(source, start, after), next = after)
        }
    }
}

/** True for the single assignment/field equals token, excluding both equality and inequality operators. */
isSingleEquals := fn(source: String, position: Int): Bool {
    textLib.startsWithAt(source, position, "=") and not textLib.startsWithAt(source, position, "==") and not textLib.startsWithAt(source, position, "=!=")
}

/** True when the text after an opening `(` is a tuple literal (`label = ...`, `=name`, or contains a top-level `,`), rather than grouping. */
looksLikeTupleEntry := fn(source: String, position: Int, prefix: String): Bool {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start >= size { return false; }
    if isSingleEquals(source, start) { return true; }
    if textLib.isNameStart(textLib.at(source, start)) {
        afterName := skipTrivia(source, textLib.skipName(source, start), prefix);
        if isSingleEquals(source, afterName) { return true; }
    }
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 { return false; }
            depth = depth - 1;
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** Wraps target code in the backend's list-copy hook when `kind` is a List; `Never` and other kinds are unchanged. */
copiedValueCode := fn(target: String, kind: String, code: String): String {
    if kind == "Never" { code }
    else if isListKind(kind) or isArrayKind(kind) { targetListCopyCode(target, code) }
    else { code }
}

/** Converts compatible tuples or widening integer-to-float values on assignment/call/return, or copies lists when needed; `Never` passes through unchanged. */
assignValueCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    if actualKind == "Never" {
        actualCode
    } else if expectedKind == "Float32" and numeric.isIntKind(actualKind) {
        targetFloat32OperandCode(target, actualKind, actualCode)
    } else if expectedKind == "Float" and numeric.isIntKind(actualKind) {
        targetFloatOperandCode(target, actualKind, actualCode)
    } else if expectedKind =!= actualKind and tupleShapeMatches(expectedKind, actualKind) {
        convertTupleValue(expectedKind, actualKind, actualCode)
    } else {
        copiedValueCode(target, expectedKind, actualCode)
    }
}

/** Rejects declarations inferred as non-storable `Unit` or `Never`. */
rejectNonValueBinding := fn(source: String, at: Int, prefix: String, kind: String, name: String): Unit {
    if kind == "Unit" or kind == "Never" {
        failAt(source, at, prefix, "cannot declare a " + displayKind(kind) + " local " + name);
    }
}

/** Chooses the emitted statement item kind, ensuring diverging items terminate non-Unit functions/main for strict TS control flow. */
expressionStatementKind := fn(valueKind: String, returned: Bool, defaultKind: String, currentResult: String): String {
    if valueKind == "Never" {
        if currentResult =!= "Unit" { "Return" } else { "Call" }
    } else if returned {
        "Return"
    } else {
        defaultKind
    }
}

/** Closes a call after at least one parsed argument, consuming at most one trailing comma and its trivia. */
expectNonemptyCallClose := fn(source: String, position: Int, prefix: String): Int {
    var cursor := skipTrivia(source, position, prefix);
    if cursor < textLib.length(source) and textLib.at(source, cursor) == "," { cursor = skipTrivia(source, cursor + 1, prefix); }
    expectSymbol(source, cursor, ")", prefix)
}

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := skipTrivia(source, open + 1, prefix);
    if not textLib.wordAt(source, cursor, "mut") {
        failAt(source, cursor, prefix, operation + " requires mut list argument");
    }
    cursor = skipTrivia(source, cursor + 3, prefix);
    if cursor >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, cursor)) {
        failAt(source, cursor, prefix, "expected a list name after mut");
    }
    nameEnd := textLib.skipName(source, cursor);
    listName := textLib.slice(source, cursor, nameEnd);
    index := localIndex(locals, listName);
    if index < 0 {
        failAt(source, cursor, prefix, "unknown value " + listName);
        return (runtime = "", kind = "", next = nameEnd);
    }
    entry := locals[index];
    if not isListKind(entry.kind) {
        failAt(source, cursor, prefix, operation + " requires a List value, got " + displayKind(entry.kind));
    }
    if not entry.writable {
        failAt(source, cursor, prefix, "cannot mutate list " + listName + " without mut");
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
}

/** Finds the end of a grouped atom without interpreting its values; strings and comments cannot close the group. */
scanParenEnd := fn(source: String, open: Int, prefix: String): Int {
    var cursor := open;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if ch == "(" { depth = depth + 1; cursor = cursor + 1; }
        else if ch == ")" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else { cursor = cursor + 1; }
    }
    -1
}

/** Returns the end position of a standalone `0` initializer literal (followed by `;`, `}`, or EOF), or -1 otherwise. */
isZeroInitLiteral := fn(source: String, position: Int, prefix: String): Int {
    start := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if start >= size or textLib.at(source, start) =!= "0" { return -1; }
    if start + 1 < size and (textLib.isDigit(textLib.at(source, start + 1)) or textLib.isNameStart(textLib.at(source, start + 1)) or textLib.at(source, start + 1) == ".") {
        return -1;
    }
    after := skipTrivia(source, start + 1, prefix);
    if after >= size or textLib.at(source, after) == ";" or textLib.at(source, after) == "}" {
        return start + 1;
    }
    -1
}

/** Returns the position after `?` when `position` starts a reserved-storage marker, or -1 otherwise. */
isReservedInitMarker := fn(source: String, position: Int, prefix: String): Int {
    start := skipTrivia(source, position, prefix);
    if start < textLib.length(source) and textLib.at(source, start) == "?" {
        return start + 1;
    }
    -1
}

/** Recognizes one compound assignment operator at `position`, returning empty fields when absent. */
compoundAssignOp := fn(source: String, position: Int): (op: String, baseOp: String, width: Int) {
    if textLib.startsWithAt(source, position, ":/=") { return (op = ":/=", baseOp = ":/", width = 3); }
    if textLib.startsWithAt(source, position, ":%=") { return (op = ":%=", baseOp = ":%", width = 3); }
    if textLib.startsWithAt(source, position, "+=") { return (op = "+=", baseOp = "+", width = 2); }
    if textLib.startsWithAt(source, position, "-=") { return (op = "-=", baseOp = "-", width = 2); }
    if textLib.startsWithAt(source, position, "*=") { return (op = "*=", baseOp = "*", width = 2); }
    if textLib.startsWithAt(source, position, "/=") { return (op = "/=", baseOp = "/", width = 2); }
    if textLib.startsWithAt(source, position, "%=") { return (op = "%=", baseOp = "%", width = 2); }
    (op = "", baseOp = "", width = 0)
}

/** Lowers a compound assignment RHS computation for Int*, Float*, or String (`+=`). */
compoundAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entryKind: String, lhsCode: String, baseOp: String, rhs: Parsed): String {
    if numeric.isIntKind(entryKind) and numeric.isIntKind(rhs.kind) and numeric.numericWidens(entryKind, rhs.kind) {
        return runtimeTypedIntegerCode(target, entryKind, baseOp, lhsCode, rhs.code, opPos);
    }
    if entryKind == "String" and rhs.kind == "String" and baseOp == "+" {
        return targetConcatCode(target, lhsCode, rhs.code);
    }
    if entryKind == "Float32" and (numeric.isIntKind(rhs.kind) or rhs.kind == "Float32") and
    (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return targetFloat32BinaryCode(target, baseOp, lhsCode, targetFloat32OperandCode(target, rhs.kind, rhs.code), opPos);
    }
    if entryKind == "Float" and numeric.isNumericKind(rhs.kind) and
    (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return targetFloatBinaryCode(target, baseOp, lhsCode, targetFloatOperandCode(target, rhs.kind, rhs.code), opPos);
    }
    failAt(source, opPos, prefix, "cannot apply " + baseOp + "= to " + displayKind(entryKind) + " and " + displayKind(rhs.kind));
    ""
}

/** Counts entries in `locals`. */
localsCount := fn(locals: List<Local>): Int {
    var count := 0;
    loop locals { count += 1; }
    count
}

/** Returns the prefix of `locals` up to `targetLen` entries. */
truncateLocals := fn(locals: List<Local>, targetLen: Int): List<Local> {
    kept: mut List<Local> = [];
    var idx := 0;
    loop locals as local {
        if idx < targetLen { listLib.pushBack(mut kept, local); }
        idx = idx + 1;
    }
    kept
}

/** Returns outer-local initialization and callable-dependency updates from `locals[preLen..)` appended to `updates` for `branchDepth`. */
recordBranchUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int, branchDepth: Int, updates: List<BranchUpdate>): List<BranchUpdate> {
    nextUpdates: mut List<BranchUpdate> = [];
    loop updates as existing { listLib.pushBack(mut nextUpdates, existing); }
    var idx := 0;
    branchRuntimes: mut List<String> = [];
    branchStates: mut List<String> = [];
    branchCodes: mut List<String> = [];
    loop locals as local {
        if idx >= preLen and local.depth >= 0 and local.depth <= maxDepth {
            listLib.pushBack(mut branchRuntimes, local.runtime);
            listLib.pushBack(mut branchStates, local.initState);
            listLib.pushBack(mut branchCodes, local.code);
        }
        idx = idx + 1;
    }
    emitted: mut List<String> = [];
    var rev := 0;
    loop branchRuntimes { rev += 1; }
    loop rev > 0 {
        rev = rev - 1;
        rt := branchRuntimes[rev];
        if not listLib.listContainsText(emitted, rt) {
            listLib.pushBack(mut emitted, rt);
            listLib.pushBack(mut nextUpdates, (depth = branchDepth, runtime = rt, initState = branchStates[rev], code = branchCodes[rev]));
        }
    }
    nextUpdates
}

/** Joins `branchUpdates` for `blockDepth` into `locals`, returning updated `locals`. */
joinBranchLocals := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>): List<Local> {
    here: mut List<BranchUpdate> = [];
    loop updates as u {
        if u.depth == blockDepth { listLib.pushBack(mut here, u); }
    }
    nextLocals: mut List<Local> = [];
    loop locals as l { listLib.pushBack(mut nextLocals, l); }
    if hasElse and liveBranchCount == 0 { return nextLocals; }
    seenRuntimes: mut List<String> = [];
    loop here as u {
        if not listLib.listContainsText(seenRuntimes, u.runtime) {
            listLib.pushBack(mut seenRuntimes, u.runtime);
        }
    }
    loop seenRuntimes as rt {
        var preEntryIdx := -1;
        var i := 0;
        loop locals as l {
            if i < preLen and l.runtime == rt { preEntryIdx = i; }
            i = i + 1;
        }
        if preEntryIdx >= 0 {
            pre := locals[preEntryIdx];
            trackFn := containsFnKind(pre.kind) or pre.name == "$tuple";
            var mergedCode := if trackFn { pre.code } else { "" };
            if trackFn {
                loop here as u {
                    if u.runtime == rt and u.code =!= "" {
                        mergedCode = mergeCallableLocalDeps(mergedCode, u.code);
                    }
                }
            }
            var joined := pre.initState;
            if pre.initState =!= INIT_STATE_INIT {
                joined = INIT_STATE_MAYBE;
                if hasElse {
                    var initCount := 0;
                    loop here as u {
                        if u.runtime == rt and u.initState == INIT_STATE_INIT { initCount = initCount + 1; }
                    }
                    if initCount == liveBranchCount { joined = INIT_STATE_INIT; }
                }
                if pre.mutable and pre.initState == INIT_STATE_UNINIT_ASSIGNED and joined == INIT_STATE_MAYBE {
                    joined = INIT_STATE_UNINIT_ASSIGNED;
                }
            }
            if joined =!= pre.initState or (trackFn and mergedCode =!= pre.code) {
                listLib.pushBack(mut nextLocals, (name = pre.name, runtime = pre.runtime, kind = pre.kind,
                mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                code = if trackFn { mergedCode } else { pre.code }, intValue = 0, textValue = "", initState = joined));
            }
        }
    }
    nextLocals
}

/** Removes `branchUpdates` entries at `blockDepth`. */
popBranchUpdates := fn(updates: List<BranchUpdate>, blockDepth: Int): List<BranchUpdate> {
    kept: mut List<BranchUpdate> = [];
    loop updates as u {
        if u.depth =!= blockDepth { listLib.pushBack(mut kept, u); }
    }
    kept
}

/** Transitions any outer uninit locals modified inside a loop and propagates callable-dependency updates after the loop. */
joinLoopUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int): List<Local> {
    updatedRuntimes: mut List<String> = [];
    var idx := 0;
    loop locals as l {
        if idx >= preLen and l.depth >= 0 and l.depth <= maxDepth {
            if not listLib.listContainsText(updatedRuntimes, l.runtime) {
                listLib.pushBack(mut updatedRuntimes, l.runtime);
            }
        }
        idx = idx + 1;
    }
    nextLocals: mut List<Local> = [];
    var k := 0;
    loop locals as l {
        if k < preLen { listLib.pushBack(mut nextLocals, l); }
        k = k + 1;
    }
    loop updatedRuntimes as rt {
        var preIdx := -1;
        var i := 0;
        loop nextLocals as l {
            if l.runtime == rt { preIdx = i; }
            i = i + 1;
        }
        if preIdx >= 0 {
            pre := nextLocals[preIdx];
            trackFn := containsFnKind(pre.kind) or pre.name == "$tuple";
            var mergedCode := if trackFn { pre.code } else { "" };
            if trackFn {
                var li := preLen;
                var totalLocals := 0;
                loop locals { totalLocals = totalLocals + 1; }
                loop li < totalLocals {
                    cand := locals[li];
                    if cand.runtime == rt and cand.depth >= 0 and cand.depth <= maxDepth and cand.code =!= "" {
                        mergedCode = mergeCallableLocalDeps(mergedCode, cand.code);
                    }
                    li = li + 1;
                }
            }
            nextInit := if pre.initState == INIT_STATE_UNINIT or (pre.initState == INIT_STATE_UNINIT_ASSIGNED and not pre.mutable) {
                INIT_STATE_MAYBE
            } else {
                pre.initState
            };
            if nextInit =!= pre.initState or (trackFn and mergedCode =!= pre.code) {
                listLib.pushBack(mut nextLocals, (name = pre.name, runtime = pre.runtime, kind = pre.kind,
                mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                code = if trackFn { mergedCode } else { pre.code }, intValue = 0, textValue = "", initState = nextInit));
            }
        }
    }
    nextLocals
}

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object, fixed array, callable stub, and an empty list. */
zeroParsed := fn(target: String, kind: String, next: Int): Parsed {
    if isTupleKind(kind) {
        count := tupleComponentCount(kind);
        var code := "{ ";
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            if index > 0 { code = code + ", "; }
            code = code + tupleObjectKey(comp.label, index) + ": " + self(target, comp.kind, next).code;
            index = index + 1;
        }
        (kind = kind, code = code + " }", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if isListKind(kind) { (kind = kind, code = "[]", intValue = 0, textValue = "", constant = false, next = next) }
    else if isArrayKind(kind) {
        elemKind := arrayElementKind(kind);
        extent := arrayExtent(kind);
        elemZero := self(target, elemKind, next).code;
        items: mut List<String> = [];
        var i := 0;
        loop i < extent {
            listLib.pushBack(mut items, elemZero);
            i = i + 1;
        }
        (kind = kind, code = "[" + textLib.joinTexts(items, ", ") + "]", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if isFnKind(kind) {
        paramCount := fnParamCount(kind);
        var paramsCode := "";
        var voidStmts := "";
        var idx := 0;
        loop idx < paramCount {
            comp := fnParamComponent(kind, idx);
            pName := "lite_" + integer.intText(idx);
            if idx > 0 { paramsCode = paramsCode + ", "; }
            paramsCode = paramsCode + pName + ": " + tsFunctionType(comp.kind);
            voidStmts = voidStmts + "void " + pName + "; ";
            idx = idx + 1;
        }
        retKind := fnResultKind(kind);
        retTs := tsFunctionType(retKind);
        bodyCode := if retKind == "Unit" {
            "{ " + voidStmts + "}"
        } else {
            "{ " + voidStmts + "return " + self(target, retKind, next).code + "; }"
        };
        (kind = kind, code = "((" + paramsCode + "): " + retTs + " => " + bodyCode + ")", intValue = 0, textValue = kind, constant = false, next = next)
    }
    else if numeric.isIntKind(kind) { typedIntParsed(kind, targetIntLiteralCode(target, 0, false, "0"), 0, true, next) }
    else if numeric.isFloatKind(kind) { (kind = kind, code = "0", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == "String" { textParsed(targetTextLiteralCode(target, ""), "", true, next) }
    else if kind == "Unit" { (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next) }
    else { boolParsed(targetBoolLiteralCode(target, false), false, true, next) }
}

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) {
    start := skipTrivia(source, position, prefix);
    var cursor := start;
    var writable := false;
    if textLib.wordAt(source, cursor, "mut") {
        writable = true;
        cursor = skipTrivia(source, cursor + 3, prefix);
    }
    typed := parseTypeAt(source, cursor, prefix, aliases, "local", "");
    if typed.kind == "Unit" {
        name := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        failAt(source, cursor, prefix, "unsupported local type " + name);
    }
    if writable and not isListKind(typed.kind) {
        failAt(source, start, prefix, "mut requires a List type, got " + displayKind(typed.kind));
    }
    (kind = typed.kind, writable = writable, next = typed.next)
}

/** Skips empty item separators without changing the final ordinary item's result. */
skipItemSeparators := fn(source: String, position: Int, prefix: String): Int {
    var next := skipTrivia(source, position, prefix);
    loop next < textLib.length(source) and textLib.at(source, next) == ";" {
        next = skipTrivia(source, next + 1, prefix);
    }
    next
}

/** Returns a copy of `values` with element `index` replaced by `value`. */
setIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> {
    updated: mut List<Int> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut updated, if i == index { value } else { item });
        i = i + 1;
    }
    updated
}

/** Returns a copy of `values` with element `index` replaced by `value`. */
setBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> {
    updated: mut List<Bool> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut updated, if i == index { value } else { item });
        i = i + 1;
    }
    updated
}

/** Returns the 0-based parameter slot index matching `label` in `[first, first + count)`, or -1 when absent. */
findParamSlot := fn(params: List<String>, first: Int, count: Int, label: String): Int {
    var i := 0;
    loop i < count {
        if paramNameOf(params[first + i]) == label { return i; }
        i = i + 1;
    }
    -1
}

/** Scans from `position` to the next top-level `,` or `)` at paren/bracket/brace depth 0. */
skipBalancedArgument := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := position;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" {
            if depth == 0 { return cursor; }
            depth = depth - 1;
            cursor = cursor + 1;
        } else if ch == "]" or ch == "}" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "," and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    cursor
}

/** Collects explicit `name = ...` and `=name` parameter labels present in a call argument list starting at `openParen`. */
collectExplicitCallLabels := fn(source: String, openParen: Int, prefix: String): List<String> {
    labels: mut List<String> = [];
    size := textLib.length(source);
    var cursor := skipTrivia(source, openParen + 1, prefix);
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if isSingleEquals(source, cursor) {
            nameStart := skipTrivia(source, cursor + 1, prefix);
            if nameStart < size and textLib.isNameStart(textLib.at(source, nameStart)) {
                nameEnd := textLib.skipName(source, nameStart);
                listLib.pushBack(mut labels, textLib.slice(source, nameStart, nameEnd));
            }
        } else if textLib.isNameStart(textLib.at(source, cursor)) {
            nameEnd := textLib.skipName(source, cursor);
            afterName := skipTrivia(source, nameEnd, prefix);
            if isSingleEquals(source, afterName) {
                listLib.pushBack(mut labels, textLib.slice(source, cursor, nameEnd));
            }
        }
        cursor = skipBalancedArgument(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == ")" { break; }
        } else {
            break;
        }
    }
    labels
}

/** Parses `()`, `(name)` or `(name1, name2, ...)` for tuple destructuring declarations, allowing empty or nested-scope rebinding. */
parseTupleDestructureTarget := fn(source: String, open: Int, prefix: String): (namesText: String, count: Int, grouped: Bool, next: Int) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, open + 1, prefix);
    names: mut List<String> = [];
    var count := 0;
    var hadComma := false;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a binding name in tuple destructuring");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        bindName := textLib.slice(source, nameStart, cursor);
        if isReservedWord(bindName) { unsupportedFeature(source, nameStart, bindName, prefix); }
        listLib.pushBack(mut names, bindName);
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    next := expectSymbol(source, cursor, ")", prefix);
    (namesText = textLib.joinTexts(names, ","), count = count, grouped = count == 1 and not hadComma, next = next)
}

/** Returns the position of the `{` that opens the branch after the condition starting at `start`, or -1 when absent. */
scanConditionOpen := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "{" and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** Locates an ordinary item's separator or enclosing close for contextual tail typing, without interpreting values. */
scanExpressionItemEnd := fn(source: String, start: Int, prefix: String): Int {
    var cursor := start;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if depth == 0 and (ch == ";" or ch == "}") { return cursor; }
        else {
            if ch == "(" or ch == "[" or ch == "{" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "}" and depth == 1 {
                depth = 0;
                cursor = cursor + 1;
                afterClose := skipTrivia(source, cursor, prefix);
                if afterClose >= size or (not textLib.wordAt(source, afterClose, "else") and
                not textLib.wordAt(source, afterClose, "then") and
                not textLib.wordAt(source, afterClose, "finally")) {
                    return cursor;
                }
            } else if ch == ")" or ch == "]" or ch == "}" {
                if depth > 0 { depth = depth - 1; }
                cursor = cursor + 1;
            } else {
                cursor = cursor + 1;
            }
        }
    }
    cursor
}

/** Extracts the loop context id encoded in a Pass 1 `"__loopVal:<id>"` placeholder kind, or returns -1. */
loopValMarkerId := fn(kind: String): Int {
    if not textLib.startsWithAt(kind, 0, "__loopVal:") { return -1; }
    suffix := textLib.slice(kind, 10, textLib.length(kind));
    if suffix == "" { return -1; }
    var value := 0;
    var index := 0;
    loop index < textLib.length(suffix) {
        ch := textLib.at(suffix, index);
        if not textLib.isDigit(ch) { return -1; }
        value = value * 10 + decimalDigit(ch);
        index = index + 1;
    }
    value
}

/** Unifies two conditional branch kinds when one is `Never`, both match, one is a Pass 1 loop `.value` placeholder, or one losslessly widens to the other. */
joinBranchKind := fn(current: String, nextKind: String): String {
    if current == "" or current == "Never" { return nextKind; }
    if nextKind == "Never" or nextKind == current { return current; }
    if loopValMarkerId(current) >= 0 { return nextKind; }
    if loopValMarkerId(nextKind) >= 0 { return current; }
    if numeric.numericWidens(current, nextKind) { return current; }
    if numeric.numericWidens(nextKind, current) { return nextKind; }
    if fnShapeMatches(current, nextKind) { return fnStripLabels(current); }
    ""
}

/** Builds a nested conditional expression while converting any branch that widens to `resultKind`. */
ternaryChainCode := fn(target: String, resultKind: String, conditionCodes: List<String>, branchCodes: List<String>, branchKinds: List<String>, branchCount: Int): String {
    var code := assignValueCode(target, resultKind, branchKinds[branchCount - 1], branchCodes[branchCount - 1]);
    var index := branchCount - 2;
    loop index >= 0 {
        branchCode := assignValueCode(target, resultKind, branchKinds[index], branchCodes[index]);
        code = "(Boolean(" + conditionCodes[index] + ") ? " + branchCode + " : " + code + ")";
        index = index - 1;
    }
    code
}

/** Formats one conditional branch statement for a lowered IIFE conditional (`if`, `else if`, `else`, or `match` arm). */
condBranchStmtCode := fn(target: String, valKind: String, valVar: String, branchKind: String, branchCode: String): String {
    if valKind == "Never" {
        "return (" + branchCode + ");"
    } else if branchKind == "Never" {
        "(" + branchCode + ");"
    } else if valKind == "Unit" {
        if branchCode == targetUnitLiteralCode(target) { "" } else { "void (" + branchCode + ");" }
    } else {
        valVar + " = " + assignValueCode(target, valKind, branchKind, branchCode) + ";"
    }
}

/** Returns the number of entries in `ctxs`. */
ctxCount := fn(ctxs: List<ConstructCtx>): Int {
    var count := 0;
    loop ctxs { count += 1; }
    count
}

/** Returns a copy of `ctxs` with `entry` appended at the end. */
appendCtx := fn(ctxs: List<ConstructCtx>, entry: ConstructCtx): List<ConstructCtx> {
    copy: mut List<ConstructCtx> = [];
    loop ctxs as existing { listLib.pushBack(mut copy, existing); }
    listLib.pushBack(mut copy, entry);
    copy
}

/** Returns one fresh positive construct identifier higher than any active id in `ctxs`. */
nextCtxId := fn(ctxs: List<ConstructCtx>): Int {
    var highest := 0;
    loop ctxs as existing {
        if existing.id > highest { highest = existing.id; }
    }
    highest + 1
}

/** Finds the innermost context in `ctxs` matching `tag`, or -1 when absent. */
findTaggedCtxIndex := fn(ctxs: List<ConstructCtx>, tag: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].tag == tag { return index; }
        index = index - 1;
    }
    -1
}

/** Finds the innermost context in `ctxs` matching `kind`, or -1 when absent. */
findCtxByKindIndex := fn(ctxs: List<ConstructCtx>, kind: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].kind == kind { return index; }
        index = index - 1;
    }
    -1
}

/** Returns the entries of `locals` declared below `depth` (including pre-scanned future placeholders below `depth`), preserving order. */
visibleLocals := fn(locals: List<Local>, depth: Int): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if (entry.depth >= -1 and entry.depth < depth) or
        (entry.depth <= -2 and (0 - 2 - entry.depth) < depth) {
            listLib.pushBack(mut kept, entry);
        }
    }
    kept
}

/** True when `name` is already declared directly inside the block at `depth`. */
hasBlockDecl := fn(decls: List<BlockDecl>, depth: Int, name: String): Bool {
    loop decls as entry {
        if entry.depth == depth and entry.name == name {
            return true;
        }
    }
    false
}

/** Drops current-block declaration records at or above `depth`, keeping enclosing blocks intact. */
popBlockDecls := fn(decls: List<BlockDecl>, depth: Int): List<BlockDecl> {
    kept: mut List<BlockDecl> = [];
    loop decls as entry {
        if entry.depth < depth {
            listLib.pushBack(mut kept, entry);
        }
    }
    kept
}

/** Rejects redeclaring `name` within the same file-root (`depth == 0`) or inner block. */
rejectDuplicateBlockDecl := fn(source: String, at: Int, prefix: String, decls: List<BlockDecl>, depth: Int, name: String): Unit {
    if hasBlockDecl(decls, depth, name) {
        if depth == 0 {
            failAt(source, at, prefix, "duplicate top-level value " + name);
        }
        failAt(source, at, prefix, "duplicate declaration " + name + " in block");
    }
}

/** Rejects redeclaring `name` inside the current `parseBinaryCtx` `{ ... }` block. */
rejectDuplicateInBlockNames := fn(source: String, at: Int, prefix: String, names: List<String>, name: String): Unit {
    if listLib.listContainsText(names, name) {
        failAt(source, at, prefix, "duplicate declaration " + name + " in block");
    }
}

/** Extracts header-bound symbol names (parameters or loop items) owned by the opening `{ ... }` block. */
seedBlockDeclaredNames := fn(bodySink: String): List<String> {
    seeded: mut List<String> = [];
    colonPos := textLib.indexOfText(bodySink, ":", 0);
    if colonPos < 0 { return seeded; }
    namesLen := textLib.length(bodySink);
    var cursor := colonPos + 1;
    loop cursor < namesLen {
        var endPos := cursor;
        loop endPos < namesLen and textLib.at(bodySink, endPos) =!= "," {
            endPos = endPos + 1;
        }
        if endPos > cursor {
            listLib.pushBack(mut seeded, textLib.slice(bodySink, cursor, endPos));
        }
        cursor = endPos + 1;
    }
    seeded
}

/** Joins a block's definite completion: scopes preserve it, loops require a true header, and conditionals require every arm plus a final else. */
blockCompletion := fn(kind: String, completed: Bool, branchesComplete: Bool, hasElse: Bool, loopForever: Bool): Bool {
    if kind == BLOCK_KIND_SCOPE or kind == BLOCK_KIND_MATCH_SINGLE or kind == BLOCK_KIND_MATCH_SINGLE_VALUE { completed }
    else if kind == BLOCK_KIND_LOOP { loopForever and completed }
    else { hasElse and branchesComplete and completed }
}

/** True when emitted target code contains a raw `lite$throwTransfer(` substring worth quote-aware inspection. */
codeHasRawTransfer := fn(code: String): Bool {
    code =!= "" and textLib.indexOfText(code, "lite$throwTransfer(", 0) >= 0
}

/** Parses one `@tag` token starting at `atPos`. */
parseTagAt := fn(source: String, atPos: Int, prefix: String): (tag: String, next: Int, at: Int) {
    size := textLib.length(source);
    nameStart := atPos + 1;
    if nameStart >= size or not textLib.isNameStart(textLib.at(source, nameStart)) {
        failAt(source, atPos, prefix, "expected tag name after @");
    }
    nameEnd := textLib.skipName(source, nameStart);
    tag := textLib.slice(source, nameStart, nameEnd);
    if isReservedWord(tag) {
        failAt(source, nameStart, prefix, "tag name cannot be reserved word " + tag);
    }
    (tag = tag, next = nameEnd, at = atPos)
}

/** Rejects a block `@tag` where a construct header, else/then/finally clause or opening brace cannot accept one. */
rejectMisplacedTag := fn(source: String, position: Int, prefix: String, message: String): Unit {
    pos := skipTrivia(source, position, prefix);
    if pos < textLib.length(source) and textLib.at(source, pos) == "@" {
        failAt(source, pos, prefix, message);
    }
}

/** Rejects an unparenthesized `@tag { ... }` at the start of a header condition while preserving `@tag.field` metadata reads. */
rejectHeaderBlockTag := fn(source: String, position: Int, prefix: String, constructName: String): Unit {
    pos := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if pos < size and textLib.at(source, pos) == "@" {
        parsed := parseTagAt(source, pos, prefix);
        afterTag := skipTrivia(source, parsed.next, prefix);
        if afterTag >= size or textLib.at(source, afterTag) =!= "." {
            failAt(source, pos, prefix, "unexpected block tag @" + parsed.tag + " in " + constructName + " header");
        }
    }
}

/** True when `parsed` encodes Pass 1 exit markers in `textValue`. */
hasMarkerPrefix := fn(parsed: Parsed): Bool {
    not parsed.constant and textLib.startsWithAt(parsed.textValue, 0, "__m:")
}

/** Appends Pass 1 exit markers encoded on `parsed` onto `current`. */
collectParsedMarkers := fn(current: String, parsed: Parsed): String {
    if hasMarkerPrefix(parsed) {
        return current + textLib.slice(parsed.textValue, 4, textLib.length(parsed.textValue));
    }
    current
}

/** Encodes raw marker lines for `Parsed.textValue`, or returns empty when none exist. */
wrapMarkers := fn(raw: String): String {
    if raw == "" { "" } else { "__m:" + raw }
}

/** Attaches raw Pass 1 exit markers onto `parsed` when non-empty. */
withMarkers := fn(parsed: Parsed, raw: String): Parsed {
    if raw == "" { return parsed; }
    (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
    textValue = "__m:" + raw, constant = false, next = parsed.next)
}

/** Retains all marker lines in `raw` whose target id is not `excludeId`. */
filterOtherMarkers := fn(raw: String, excludeId: Int): String {
    excludeKey := integer.intText(excludeId);
    size := textLib.length(raw);
    var cursor := 0;
    var kept := "";
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        if entryId =!= excludeKey {
            kept = kept + textLib.slice(raw, cursor, endPos) + "\n";
        }
        cursor = endPos + 1;
    }
    kept
}

/** Unifies all inferred exit kinds recorded for `targetId` in `raw` markers, failing on incompatible exit types. */
inferKindFromMarkers := fn(raw: String, targetId: Int, targetTag: String, source: String, at: Int, prefix: String, blockStopped: Bool): String {
    idKey := integer.intText(targetId);
    size := textLib.length(raw);
    var cursor := 0;
    var result := "";
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            if result == "" {
                result = entryKind;
            } else {
                joined := joinBranchKind(result, entryKind);
                if joined == "" {
                    failAt(source, at, prefix, "block @" + targetTag + " cannot return both " +
                    displayKind(result) + " and " + displayKind(entryKind));
                }
                result = joined;
            }
        }
        cursor = endPos + 1;
    }
    if result == "" {
        if blockStopped { "Never" } else { "Unit" }
    } else {
        result
    }
}

/** Returns true when a call argument list reorders or mismatches slots relative to the callee's declaration order. */
callReordersArgs := fn(source: String, openParen: Int, prefix: String, params: List<String>, firstParam: Int, paramCount: Int): Bool {
    size := textLib.length(source);
    var cursor := skipTrivia(source, openParen + 1, prefix);
    if cursor >= size or textLib.at(source, cursor) == ")" { return false; }
    var entryIdx := 0;
    var atArgStart := true;
    var depth := 0;
    loop cursor < size {
        if atArgStart and depth == 0 {
            if textLib.at(source, cursor) == ")" { break; }
            var label := "";
            if isSingleEquals(source, cursor) {
                nameStart := skipTrivia(source, cursor + 1, prefix);
                if nameStart < size and textLib.isNameStart(textLib.at(source, nameStart)) {
                    label = textLib.slice(source, nameStart, textLib.skipName(source, nameStart));
                }
            } else if textLib.isNameStart(textLib.at(source, cursor)) {
                nameEnd := textLib.skipName(source, cursor);
                afterName := skipTrivia(source, nameEnd, prefix);
                if isSingleEquals(source, afterName) {
                    label = textLib.slice(source, cursor, nameEnd);
                }
            }
            if label =!= "" and findParamSlot(params, firstParam, paramCount, label) =!= entryIdx {
                return true;
            }
            atArgStart = false;
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 and ch == ")" {
                entryIdx = entryIdx + 1;
                break;
            }
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            entryIdx = entryIdx + 1;
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == ")" { break; }
            atArgStart = true;
        } else {
            cursor = cursor + 1;
        }
    }
    entryIdx =!= paramCount
}

/** Scans from `start` with initial brace `depthStart`, skipping strings and comments; returns the end position or -1 when unclosed. */
scanBracedRange := fn(source: String, start: Int, depthStart: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := start;
    var depth := depthStart;
    var nextOpen := textLib.indexOfText(source, "{", start);
    var nextClose := textLib.indexOfText(source, "}", start);
    var nextQuote := textLib.indexOfText(source, "\"", start);
    var nextComment := textLib.indexOfText(source, "/*", start);
    loop cursor < size {
        if nextOpen >= 0 and nextOpen < cursor { nextOpen = textLib.indexOfText(source, "{", cursor); }
        if nextClose >= 0 and nextClose < cursor { nextClose = textLib.indexOfText(source, "}", cursor); }
        if nextQuote >= 0 and nextQuote < cursor { nextQuote = textLib.indexOfText(source, "\"", cursor); }
        if nextComment >= 0 and nextComment < cursor { nextComment = textLib.indexOfText(source, "/*", cursor); }
        var hit := size;
        var kind := 0;
        if nextQuote >= 0 and nextQuote < hit { hit = nextQuote; kind = 1; }
        if nextComment >= 0 and nextComment < hit { hit = nextComment; kind = 2; }
        if nextOpen >= 0 and nextOpen < hit { hit = nextOpen; kind = 3; }
        if nextClose >= 0 and nextClose < hit { hit = nextClose; kind = 4; }
        if kind == 0 { return -1; }
        if kind == 1 {
            cursor = skipAliasString(source, hit);
        } else if kind == 2 {
            cursor = skipComment(source, hit, prefix);
        } else if kind == 3 {
            depth = depth + 1;
            cursor = hit + 1;
        } else {
            depth = depth - 1;
            cursor = hit + 1;
            if depth == 0 { return cursor; }
        }
    }
    -1
}

/** Returns the position after the braced block starting at `open`, or -1 when it never closes. Strings and comments are skipped. */
scanBraceEnd := fn(source: String, open: Int, prefix: String): Int {
    scanBracedRange(source, open, 0, prefix)
}

/** True when the braced body from `open` to `close` is a nonempty single expression: no semicolon and no statement keyword first. */
valueIfBranchAt := fn(source: String, open: Int, close: Int, prefix: String): Bool {
    var cursor := skipTrivia(source, open + 1, prefix);
    if cursor >= close { return false; }
    if textLib.isNameStart(textLib.at(source, cursor)) {
        word := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        if word == "return" or word == "outputLine" or word == "output" or word == "var" or word == "loop" or
        word == "break" or word == "continue" or word == "else" {
            return false;
        }
    }
    var scan := cursor;
    var braceDepth := 0;
    loop scan < close {
        ch := textLib.at(source, scan);
        if ch == "\"" {
            scan = skipAliasString(source, scan);
        } else if ch == "/" and textLib.startsWithAt(source, scan, "/*") {
            scan = skipComment(source, scan, prefix);
        } else if ch == "{" {
            braceDepth = braceDepth + 1;
            scan = scan + 1;
        } else if ch == "}" {
            if braceDepth > 0 { braceDepth = braceDepth - 1; }
            scan = scan + 1;
        } else if braceDepth == 0 and (ch == ";" or (ch == "." and textLib.startsWithAt(source, scan, ".output"))) {
            return false;
        } else {
            scan = scan + 1;
        }
    }
    true
}

/** Skips an optional `@tag` prefix before `keyword` during speculative scanning, returning the keyword start or `position` when untagged (or -1 on non-matching `@`). */
skipOptionalScanTag := fn(source: String, position: Int, prefix: String, keyword: String): Int {
    cursor := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if cursor >= size or textLib.at(source, cursor) =!= "@" { return cursor; }
    nameStart := cursor + 1;
    if nameStart >= size or not textLib.isNameStart(textLib.at(source, nameStart)) { return -1; }
    afterTag := skipTrivia(source, textLib.skipName(source, nameStart), prefix);
    if afterTag < size and textLib.wordAt(source, afterTag, keyword) { afterTag } else { -1 }
}

/** Scans an optional trailing `then { ... }` clause; returns `position` if absent, `-1` if malformed or failing `requireThenValue`. */
scanTrailingThenEnd := fn(source: String, position: Int, prefix: String, requireThenValue: Bool): Int {
    size := textLib.length(source);
    after := skipTrivia(source, position, prefix);
    if after >= size or not textLib.wordAt(source, after, "then") { return -2; }
    thenOpen := skipTrivia(source, after + 4, prefix);
    if thenOpen >= size or textLib.at(source, thenOpen) =!= "{" { return -1; }
    thenEnd := scanBraceEnd(source, thenOpen, prefix);
    if thenEnd < 0 { return -1; }
    if requireThenValue and not valueIfBranchAt(source, thenOpen, thenEnd - 1, prefix) { return -1; }
    thenEnd
}

/** Scans an optional trailing `finally { ... }` clause; returns `position` if absent, or `-1` if malformed. */
scanTrailingFinallyEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    after := skipTrivia(source, position, prefix);
    if after >= size or not textLib.wordAt(source, after, "finally") { return position; }
    finOpen := skipTrivia(source, after + 7, prefix);
    if finOpen >= size or textLib.at(source, finOpen) =!= "{" { return -1; }
    scanBraceEnd(source, finOpen, prefix)
}

/** Scans the raw `[@tag] if ... [else ...]` header+branches ending before any `then` clause; returns -1 on mismatch. */
scanRawIfChainEnd := fn(source: String, position: Int, prefix: String, allowPartial: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "if");
    if cursor < 0 or not textLib.wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        after := skipTrivia(source, end, prefix);
        if not textLib.wordAt(source, after, "else") {
            return if allowPartial { end } else { -1 };
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if textLib.wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textLib.at(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            return finalEnd;
        }
    }
    -1
}

/** Scans a `[@tag] if` chain, optionally allowing a partial chain without a final `else` and an optional trailing `then { ... }`. */
scanIfChainEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool, allowPartial: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "if");
    if cursor < 0 or not textLib.wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    var allBranchesValue := true;
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        if requireValueBranches and not valueIfBranchAt(source, open, end - 1, prefix) { allBranchesValue = false; }
        after := skipTrivia(source, end, prefix);
        if not textLib.wordAt(source, after, "else") {
            if not allowPartial { return -1; }
            if textLib.wordAt(source, after, "then") { return -1; }
            if requireValueBranches and not allBranchesValue { return -1; }
            return scanTrailingFinallyEnd(source, end, prefix);
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if textLib.wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textLib.at(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            if finalEnd < 0 { return -1; }
            if requireValueBranches and not valueIfBranchAt(source, afterElse, finalEnd - 1, prefix) { allBranchesValue = false; }
            thenEnd := scanTrailingThenEnd(source, finalEnd, prefix, requireValueBranches);
            if thenEnd == -1 { return -1; }
            baseEnd := if thenEnd == -2 {
                if requireValueBranches and not allBranchesValue { -1 } else { finalEnd }
            } else {
                thenEnd
            };
            if baseEnd < 0 { return -1; }
            return scanTrailingFinallyEnd(source, baseEnd, prefix);
        }
    }
    -1
}

/** Scans a total `[@tag] if` chain ending with a final else block and optional `then { ... }`. */
scanValueIfEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int {
    scanIfChainEnd(source, position, prefix, requireValueBranches, false)
}

/** Scans the raw `[@tag] match { ... }` ending before any `then` clause; returns -1 on mismatch. */
scanRawMatchEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "match");
    if cursor < 0 or not textLib.wordAt(source, cursor, "match") { return -1; }
    openMatch := skipTrivia(source, cursor + 5, prefix);
    if openMatch >= size or textLib.at(source, openMatch) =!= "{" { return -1; }
    var armCursor := skipItemSeparators(source, openMatch + 1, prefix);
    loop armCursor < size {
        if textLib.at(source, armCursor) == "}" { return -1; }
        afterUnderscore := skipTrivia(source, armCursor + 1, prefix);
        isFallback := textLib.wordAt(source, armCursor, "_") and afterUnderscore < size and
        textLib.at(source, afterUnderscore) == "{";
        armOpen := if isFallback { afterUnderscore }
        else { scanConditionOpen(source, armCursor, prefix) };
        if armOpen < 0 or (not isFallback and armOpen == armCursor) { return -1; }
        armEnd := scanBraceEnd(source, armOpen, prefix);
        if armEnd < 0 { return -1; }
        afterArm := skipItemSeparators(source, armEnd, prefix);
        if isFallback {
            if afterArm < size and textLib.at(source, afterArm) == "}" {
                return afterArm + 1;
            }
            return -1;
        }
        armCursor = afterArm;
    }
    -1
}

/** Scans a subjectless Boolean `[@tag] match` ending with a final `_` fallback arm and optional `then { ... }`. */
scanValueMatchEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "match");
    if cursor < 0 or not textLib.wordAt(source, cursor, "match") { return -1; }
    openMatch := skipTrivia(source, cursor + 5, prefix);
    if openMatch >= size or textLib.at(source, openMatch) =!= "{" { return -1; }
    var allArmsValue := true;
    var armCursor := skipItemSeparators(source, openMatch + 1, prefix);
    loop armCursor < size {
        if textLib.at(source, armCursor) == "}" { return -1; }
        afterUnderscore := skipTrivia(source, armCursor + 1, prefix);
        isFallback := textLib.wordAt(source, armCursor, "_") and afterUnderscore < size and
        textLib.at(source, afterUnderscore) == "{";
        armOpen := if isFallback { afterUnderscore }
        else { scanConditionOpen(source, armCursor, prefix) };
        if armOpen < 0 or (not isFallback and armOpen == armCursor) { return -1; }
        armEnd := scanBraceEnd(source, armOpen, prefix);
        if armEnd < 0 { return -1; }
        if requireValueBranches and not valueIfBranchAt(source, armOpen, armEnd - 1, prefix) { allArmsValue = false; }
        afterArm := skipItemSeparators(source, armEnd, prefix);
        if isFallback {
            if afterArm < size and textLib.at(source, afterArm) == "}" {
                thenEnd := scanTrailingThenEnd(source, afterArm + 1, prefix, requireValueBranches);
                if thenEnd == -1 { return -1; }
                baseEnd := if thenEnd == -2 {
                    if requireValueBranches and not allArmsValue { -1 } else { afterArm + 1 }
                } else {
                    thenEnd
                };
                if baseEnd < 0 { return -1; }
                return scanTrailingFinallyEnd(source, baseEnd, prefix);
            }
            return -1;
        }
        armCursor = afterArm;
    }
    -1
}

/** Finds the innermost loop context for leading-dot metadata, stopping on conditional, cleanup, or function barriers (-2 conditional, -3 finally, -1 outside). */
findLeadingDotLoopIdx := fn(ctxs: List<ConstructCtx>): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        kind := ctxs[index].kind;
        if kind == "loop" { return index; }
        if kind == "if" or kind == "match" { return -2; }
        if kind == "finally" { return -3; }
        if kind == "fn" { return -1; }
        index = index - 1;
    }
    -1
}

/** Finds the innermost active enclosing loop context, skipping loops whose body already completed (`then` or `finally`) and stopping at `fn`. */
findActiveLoopCtxIndex := fn(ctxs: List<ConstructCtx>): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        entry := ctxs[index];
        if entry.kind == "fn" { return -1; }
        if entry.kind == "loop" and entry.phase =!= "then" and entry.phase =!= "finally" { return index; }
        index = index - 1;
    }
    -1
}

/** True when a cleanup `finally` barrier sits strictly above `targetIdx` on `ctxs`. */
hasFinallyAbove := fn(ctxs: List<ConstructCtx>, targetIdx: Int): Bool {
    var index := ctxCount(ctxs) - 1;
    loop index > targetIdx {
        if ctxs[index].kind == "finally" { return true; }
        index = index - 1;
    }
    false
}

/** Scans a raw `[@tag] loop [header] { body }` up to the end of its body `}`, before any `then` or `finally`; returns -1 on mismatch. */
scanRawLoopEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    cursor := skipOptionalScanTag(source, position, prefix, "loop");
    if cursor < 0 or not textLib.wordAt(source, cursor, "loop") { return -1; }
    afterLoop := skipTrivia(source, cursor + 4, prefix);
    if afterLoop >= size { return -1; }
    open := if textLib.at(source, afterLoop) == "{" {
        afterLoop
    } else {
        scanConditionOpen(source, afterLoop, prefix)
    };
    if open < 0 or open >= size or textLib.at(source, open) =!= "{" { return -1; }
    scanBraceEnd(source, open, prefix)
}

/** True when a statement-position loop uses tags, metadata, payload exits, `then`, or `finally` and must lower as an enhanced loop expression. */
loopNeedsExprLowering := fn(source: String, position: Int, prefix: String): Bool {
    size := textLib.length(source);
    trimmed := skipTrivia(source, position, prefix);
    if trimmed >= size { return false; }
    if textLib.at(source, trimmed) == "@" { return true; }
    rawEnd := scanRawLoopEnd(source, trimmed, prefix);
    if rawEnd < 0 { return false; }
    afterRaw := skipTrivia(source, rawEnd, prefix);
    if afterRaw < size and (textLib.wordAt(source, afterRaw, "then") or textLib.wordAt(source, afterRaw, "finally")) {
        return true;
    }
    var cursor := trimmed;
    var prevExpr := false;
    loop cursor < rawEnd {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
            prevExpr = true;
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            cursor = cursor + 1;
        } else if ch == "@" {
            return true;
        } else if ch == ")" or ch == "]" or ch == "}" {
            cursor = cursor + 1;
            prevExpr = true;
        } else if ch == "." {
            if not prevExpr { return true; }
            cursor = cursor + 1;
            prevExpr = false;
        } else if textLib.isDigit(ch) {
            cursor = textLib.skipName(source, cursor);
            prevExpr = true;
        } else if textLib.isNameStart(ch) {
            end := textLib.skipName(source, cursor);
            word := textLib.slice(source, cursor, end);
            if word == "break" or word == "continue" {
                afterWord := skipTrivia(source, end, prefix);
                if afterWord < rawEnd and textLib.at(source, afterWord) =!= ";" and textLib.at(source, afterWord) =!= "}" {
                    return true;
                }
            }
            prevExpr = word =!= "and" and word =!= "or" and word =!= "not" and word =!= "if" and
            word =!= "else" and word =!= "match" and word =!= "loop" and word =!= "then" and
            word =!= "finally" and word =!= "return" and word =!= "break" and word =!= "continue" and
            word =!= "as" and word =!= "var" and word =!= "mut";
            cursor = end;
        } else {
            cursor = cursor + 1;
            prevExpr = false;
        }
    }
    false
}

/** Resolves `.count`, `.value`, `.item`, or `.index` against one active loop context, handling Pass 1 inference markers cleanly. */
resolveLoopField := fn(target: String, ctx: ConstructCtx, fieldName: String, expected: String, source: String, fieldStart: Int, fieldEnd: Int, prefix: String): Parsed {
    if fieldName == "count" {
        return intParsed(ctx.countVar, 0, false, fieldEnd);
    }
    if fieldName == "value" {
        if ctx.valKind == "__infer__" {
            if expected =!= "" and expected =!= "Unit" and expected =!= "Never" and
            not textLib.startsWithAt(expected, 0, "TailList<") and not textLib.startsWithAt(expected, 0, "__loopVal:") {
                return withMarkers((kind = expected, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                integer.intText(ctx.id) + "=" + expected + "\n");
            }
            return withMarkers((kind = "__loopVal:" + integer.intText(ctx.id), code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
            if ctx.phase =!= "then" { integer.intText(ctx.id) + "=@read\n" } else { "" });
        }
        if textLib.startsWithAt(ctx.valKind, 0, "__infer__:") {
            hint := textLib.slice(ctx.valKind, 10, textLib.length(ctx.valKind));
            return withMarkers((kind = hint, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
            integer.intText(ctx.id) + "=" + hint + "\n");
        }
        if ctx.valKind == "Unit" {
            return (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.valKind, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "item" {
        if ctx.phase == "header" {
            failAt(source, fieldStart, prefix, ".item is not available in loop header");
        }
        if ctx.itemKind == "" or ctx.itemKind == "Unit" {
            return (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.itemKind, code = ctx.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "index" {
        if ctx.phase == "header" {
            failAt(source, fieldStart, prefix, ".index is not available in loop header");
        }
        if not ctx.hasIndex {
            failAt(source, fieldStart, prefix, "loop does not expose .index without a sequence source");
        }
        return intParsed(ctx.indexVar, 0, false, fieldEnd);
    }
    failAt(source, fieldStart, prefix, "unknown loop metadata field ." + fieldName);
    intParsed("", 0, false, fieldEnd)
}

/** Scans Pass 1 marker lines for `loopId`, reporting whether any marker or concrete type marker exists. */
scanLoopMarkers := fn(raw: String, loopId: Int): (hasAny: Bool, hasConcrete: Bool) {
    idKey := integer.intText(loopId);
    size := textLib.length(raw);
    var cursor := 0;
    var hasAny := false;
    var hasConcrete := false;
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            hasAny = true;
            if entryKind =!= "@read" and entryKind =!= "@break" and loopValMarkerId(entryKind) < 0 {
                hasConcrete = true;
            }
        }
        cursor = endPos + 1;
    }
    (hasAny = hasAny, hasConcrete = hasConcrete)
}

/** Resolves a loop's pre-`then` `.value` type `T` from Pass 1 markers, bidirectional hint, circular-read guard, and `Unit` default. */
inferLoopValueKind := fn(raw: String, loopId: Int, tagDisplay: String, source: String, at: Int, prefix: String, expectedHint: String): String {
    idKey := integer.intText(loopId);
    size := textLib.length(raw);
    var cursor := 0;
    var result := "";
    var sawRead := false;
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            if entryKind == "@read" {
                sawRead = true;
            } else if entryKind =!= "@break" and loopValMarkerId(entryKind) < 0 {
                if result == "" {
                    result = entryKind;
                } else {
                    joined := joinBranchKind(result, entryKind);
                    if joined == "" {
                        labelPrefix := if tagDisplay =!= "loop" { "loop @" + tagDisplay } else { "loop" };
                        failAt(source, at, prefix, labelPrefix + " cannot produce both " +
                        displayKind(result) + " and " + displayKind(entryKind));
                    }
                    result = joined;
                }
            }
        }
        cursor = endPos + 1;
    }
    if result =!= "" { return result; }
    if expectedHint =!= "" { return expectedHint; }
    if sawRead {
        failAt(source, at, prefix, "cannot infer loop .value type; add a type annotation");
    }
    "Unit"
}

/** Pre-collects shallow `Name := type Target` aliases inside the `{ ... }` block opening at `openBracePos`, skipping nested `{ ... }` blocks. */
collectBlockTypeAliases := fn(source: String, openBracePos: Int, prefix: String, blockDepth: Int, baseAliases: List<AliasDecl>): List<AliasDecl> {
    size := textLib.length(source);
    if openBracePos < 0 or openBracePos >= size or textLib.at(source, openBracePos) =!= "{" {
        return baseAliases;
    }
    var nextTypeHit := textLib.indexOfText(source, "type", openBracePos + 1);
    if nextTypeHit < 0 { return baseAliases; }
    found: mut List<AliasDecl> = [];
    var hasFound := false;
    var cursor := openBracePos + 1;
    var parenDepth := 0;
    loop cursor < size {
        cursor = skipTrivia(source, cursor, prefix);
        if cursor >= size { break; }
        if cursor > nextTypeHit {
            nextTypeHit = textLib.indexOfText(source, "type", cursor);
            if nextTypeHit < 0 { break; }
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "{" {
            closed := scanBraceEnd(source, cursor, prefix);
            if closed < 0 { break; }
            cursor = closed;
        } else if ch == "}" {
            if parenDepth == 0 { break; }
            parenDepth = parenDepth - 1;
            cursor = cursor + 1;
        } else if ch == "(" or ch == "[" {
            parenDepth = parenDepth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            cursor = cursor + 1;
        } else if parenDepth == 0 and textLib.isNameStart(ch) {
            nameStart := cursor;
            afterName := textLib.skipName(source, cursor);
            name := textLib.slice(source, nameStart, afterName);
            opPos := skipTrivia(source, afterName, prefix);
            if name =!= "pub" and not isReservedWord(name) and textLib.startsWithAt(source, opPos, ":=") {
                typePos := skipTrivia(source, opPos + 2, prefix);
                if textLib.wordAt(source, typePos, "type") {
                    targetStart := skipTrivia(source, typePos + 4, prefix);
                    aliasTarget := collectTypeTarget(source, targetStart, prefix);
                    listLib.pushBack(mut found, (name = name, target = aliasTarget.text, at = nameStart, end = aliasTarget.next, depth = blockDepth));
                    hasFound = true;
                    cursor = if aliasTarget.next > typePos + 4 { aliasTarget.next } else { typePos + 4 };
                    continue;
                }
            }
            cursor = opPos;
        } else {
            cursor = cursor + 1;
        }
    }
    if not hasFound { return baseAliases; }
    out: mut List<AliasDecl> = [];
    loop baseAliases as entry { listLib.pushBack(mut out, entry); }
    loop found as entry { listLib.pushBack(mut out, entry); }
    out
}

/** Non-failing counterpart to `parseTypeWithSeen` used by root pre-registration and expression kind inference. */
canResolveTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int): (ok: Bool, kind: String, next: Int) {
    if depthLeft <= 0 { return (ok = false, kind = "", next = position); }
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start >= size { return (ok = false, kind = "", next = start); }
    ch := textLib.at(source, start);
    if ch == "(" {
        var cursor := skipTrivia(source, start + 1, prefix);
        labels: mut List<String> = [];
        parts: mut List<String> = [];
        var count := 0;
        var hasNamed := false;
        var hadComma := false;
        loop cursor < size and textLib.at(source, cursor) =!= ")" {
            if textLib.at(source, cursor) == "(" { return (ok = false, kind = "", next = cursor); }
            var label := "";
            var fieldStart := cursor;
            if textLib.isNameStart(textLib.at(source, cursor)) {
                afterName := textLib.skipName(source, cursor);
                colonPos := skipTrivia(source, afterName, prefix);
                if colonPos < size and textLib.at(source, colonPos) == ":" {
                    candidate := textLib.slice(source, cursor, afterName);
                    if isReservedWord(candidate) or listLib.listContainsText(labels, candidate) {
                        return (ok = false, kind = "", next = cursor);
                    }
                    label = candidate;
                    hasNamed = true;
                    listLib.pushBack(mut labels, label);
                    fieldStart = skipTrivia(source, colonPos + 1, prefix);
                    if fieldStart >= size or textLib.at(source, fieldStart) == "(" {
                        return (ok = false, kind = "", next = fieldStart);
                    }
                }
            }
            parsedField := self(source, fieldStart, prefix, aliases, genericType, seen, depthLeft - 1);
            if not parsedField.ok { return (ok = false, kind = "", next = fieldStart); }
            if isTupleKind(parsedField.kind) or isListKind(parsedField.kind) or parsedField.kind == "Unit" {
                return (ok = false, kind = "", next = fieldStart);
            }
            listLib.pushBack(mut parts, label + ":" + parsedField.kind);
            count = count + 1;
            cursor = skipTrivia(source, parsedField.next, prefix);
            if cursor < size and textLib.at(source, cursor) == "," {
                hadComma = true;
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                hadComma = false;
                break;
            }
        }
        if cursor >= size or textLib.at(source, cursor) =!= ")" {
            return (ok = false, kind = "", next = cursor);
        }
        if count == 0 or (count == 1 and not hasNamed and not hadComma) {
            return (ok = false, kind = "", next = start);
        }
        return (ok = true, kind = "(" + textLib.joinTexts(parts, ",") + ")", next = cursor + 1);
    }
    if ch == "[" {
        elem := self(source, start + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elem.ok or elem.kind == "Unit" { return (ok = false, kind = "", next = start); }
        afterElem := skipTrivia(source, elem.next, prefix);
        if afterElem >= size or textLib.at(source, afterElem) =!= ";" {
            return (ok = false, kind = "", next = afterElem);
        }
        extentStart := skipTrivia(source, afterElem + 1, prefix);
        var extentEnd := extentStart;
        loop extentEnd < size and textLib.isDigit(textLib.at(source, extentEnd)) {
            extentEnd = extentEnd + 1;
        }
        if extentEnd == extentStart { return (ok = false, kind = "", next = extentStart); }
        extent := parseDigits(source, extentStart, extentEnd);
        if extent <= 0 { return (ok = false, kind = "", next = extentStart); }
        afterExtent := skipTrivia(source, extentEnd, prefix);
        if afterExtent >= size or textLib.at(source, afterExtent) =!= "]" {
            return (ok = false, kind = "", next = afterExtent);
        }
        return (ok = true, kind = "[" + elem.kind + ";" + integer.intText(extent) + "]", next = afterExtent + 1);
    }
    if textLib.wordAt(source, start, "fn") {
        afterFn := skipTrivia(source, start + 2, prefix);
        if afterFn >= size or textLib.at(source, afterFn) =!= "(" {
            return (ok = false, kind = "", next = afterFn);
        }
        var pCursor := skipTrivia(source, afterFn + 1, prefix);
        paramLabels: mut List<String> = [];
        paramParts: mut List<String> = [];
        loop pCursor < size and textLib.at(source, pCursor) =!= ")" {
            var pLabel := "";
            var pTypeStart := pCursor;
            if textLib.isNameStart(textLib.at(source, pCursor)) {
                afterPLabel := textLib.skipName(source, pCursor);
                pColon := skipTrivia(source, afterPLabel, prefix);
                if pColon < size and textLib.at(source, pColon) == ":" {
                    candidate := textLib.slice(source, pCursor, afterPLabel);
                    if isReservedWord(candidate) or listLib.listContainsText(paramLabels, candidate) {
                        return (ok = false, kind = "", next = pCursor);
                    }
                    pLabel = candidate;
                    listLib.pushBack(mut paramLabels, pLabel);
                    pTypeStart = skipTrivia(source, pColon + 1, prefix);
                }
            }
            parsedParam := self(source, pTypeStart, prefix, aliases, genericType, seen, depthLeft - 1);
            if not parsedParam.ok { return (ok = false, kind = "", next = pTypeStart); }
            listLib.pushBack(mut paramParts, pLabel + ":" + parsedParam.kind);
            pCursor = skipTrivia(source, parsedParam.next, prefix);
            if pCursor < size and textLib.at(source, pCursor) == "," {
                pCursor = skipTrivia(source, pCursor + 1, prefix);
            } else {
                break;
            }
        }
        if pCursor >= size or textLib.at(source, pCursor) =!= ")" {
            return (ok = false, kind = "", next = pCursor);
        }
        afterClose := skipTrivia(source, pCursor + 1, prefix);
        if afterClose >= size or textLib.at(source, afterClose) =!= ":" {
            return (ok = false, kind = "", next = afterClose);
        }
        retType := self(source, afterClose + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not retType.ok { return (ok = false, kind = "", next = afterClose + 1); }
        return (ok = true, kind = "fn(" + textLib.joinTexts(paramParts, ",") + "):" + retType.kind, next = retType.next);
    }
    if not textLib.isNameStart(ch) { return (ok = false, kind = "", next = start); }
    afterName := textLib.skipName(source, start);
    name := textLib.slice(source, start, afterName);
    if name == "List" {
        afterList := skipTrivia(source, afterName, prefix);
        if afterList >= size or textLib.at(source, afterList) =!= "<" {
            return (ok = false, kind = "", next = afterList);
        }
        elem := self(source, afterList + 1, prefix, aliases, genericType, seen, depthLeft - 1);
        if not elem.ok or isListKind(elem.kind) or elem.kind == "Unit" {
            return (ok = false, kind = "", next = afterList + 1);
        }
        close := skipTrivia(source, elem.next, prefix);
        if close >= size or textLib.at(source, close) =!= ">" {
            return (ok = false, kind = "", next = close);
        }
        return (ok = true, kind = "List<" + elem.kind + ">", next = close + 1);
    }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" {
        return (ok = true, kind = name, next = afterName);
    }
    if numeric.numericAliasKind(name) =!= "" {
        return (ok = true, kind = numeric.numericAliasKind(name), next = afterName);
    }
    if numeric.isNarrowNumericKind(name) {
        return (ok = true, kind = name, next = afterName);
    }
    if genericType =!= "" and name == genericType {
        return (ok = true, kind = genericType, next = afterName);
    }
    aliasIdx := findAlias(aliases, name);
    if aliasIdx < 0 { return (ok = false, kind = "", next = afterName); }
    alias := aliases[aliasIdx];
    seenKey := integer.intText(alias.depth) + ":" + name;
    if listLib.listContainsText(seen, seenKey) or alias.target == "" {
        return (ok = false, kind = "", next = afterName);
    }
    nextSeen: mut List<String> = [];
    loop seen as entry { listLib.pushBack(mut nextSeen, entry); }
    listLib.pushBack(mut nextSeen, seenKey);
    scopedAliases := aliasesUpToDepth(aliases, alias.depth);
    resolved := self(alias.target, 0, prefix, scopedAliases, "", nextSeen, depthLeft - 1);
    if not resolved.ok { return (ok = false, kind = "", next = afterName); }
    if skipTrivia(alias.target, resolved.next, prefix) < textLib.length(alias.target) {
        return (ok = false, kind = "", next = afterName);
    }
    (ok = true, kind = resolved.kind, next = afterName)
}

/** Non-failing guard checking whether `parseLocalType` can succeed at `position`. */
canPreResolveLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): Bool {
    var cursor := skipTrivia(source, position, prefix);
    if textLib.wordAt(source, cursor, "mut") {
        cursor = skipTrivia(source, cursor + 3, prefix);
    }
    emptySeen: List<String> = [];
    canResolveTypeAt(source, cursor, prefix, aliases, "", emptySeen, 32).ok
}

/** Non-failing guard checking whether `parseFunctionHeader` can succeed at `position` without triggering diagnostics. */
canPreParseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): Bool {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    var genericType := "";
    if cursor < size and textLib.at(source, cursor) == "<" {
        if not listIntrinsic { return false; }
        binderStart := skipTrivia(source, cursor + 1, prefix);
        if binderStart >= size or not textLib.isNameStart(textLib.at(source, binderStart)) { return false; }
        binderEnd := textLib.skipName(source, binderStart);
        binder := textLib.slice(source, binderStart, binderEnd);
        if binder =!= "T" { return false; }
        afterBinder := skipTrivia(source, binderEnd, prefix);
        if afterBinder >= size or textLib.at(source, afterBinder) =!= ">" { return false; }
        genericType = "T";
        cursor = skipTrivia(source, afterBinder + 1, prefix);
    }
    if cursor >= size or textLib.at(source, cursor) =!= "(" { return false; }
    cursor = skipTrivia(source, cursor + 1, prefix);
    names: mut List<String> = [];
    emptySeen: List<String> = [];
    var paramCount := 0;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if textLib.startsWithAt(source, cursor, "...") {
            if not listIntrinsic or paramCount > 0 { return false; }
            packStart := skipTrivia(source, cursor + 3, prefix);
            if packStart >= size or not textLib.isNameStart(textLib.at(source, packStart)) { return false; }
            packEnd := textLib.skipName(source, packStart);
            if isReservedWord(textLib.slice(source, packStart, packEnd)) { return false; }
            afterPack := skipTrivia(source, packEnd, prefix);
            if afterPack >= size or textLib.at(source, afterPack) =!= ":" { return false; }
            packType := canResolveTypeAt(source, afterPack + 1, prefix, aliases, genericType, emptySeen, 32);
            if not packType.ok { return false; }
            cursor = skipTrivia(source, packType.next, prefix);
            break;
        }
        if not textLib.isNameStart(textLib.at(source, cursor)) { return false; }
        nameStart := cursor;
        nameEnd := textLib.skipName(source, nameStart);
        pName := textLib.slice(source, nameStart, nameEnd);
        if isReservedWord(pName) or listLib.listContainsText(names, pName) { return false; }
        listLib.pushBack(mut names, pName);
        afterPName := skipTrivia(source, nameEnd, prefix);
        if afterPName >= size or textLib.at(source, afterPName) =!= ":" { return false; }
        cursor = skipTrivia(source, afterPName + 1, prefix);
        if textLib.wordAt(source, cursor, "mut") {
            if not listIntrinsic { return false; }
            cursor = skipTrivia(source, cursor + 3, prefix);
        }
        pType := canResolveTypeAt(source, cursor, prefix, aliases, genericType, emptySeen, 32);
        if not pType.ok { return false; }
        paramCount = paramCount + 1;
        cursor = skipTrivia(source, pType.next, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            cursor = skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if cursor >= size or textLib.at(source, cursor) =!= ")" { return false; }
    afterParen := skipTrivia(source, cursor + 1, prefix);
    if afterParen >= size or textLib.at(source, afterParen) =!= ":" { return false; }
    retType := canResolveTypeAt(source, afterParen + 1, prefix, aliases, genericType, emptySeen, 32);
    if not retType.ok { return false; }
    afterHeader := skipTrivia(source, retType.next, prefix);
    if afterHeader < size and textLib.at(source, afterHeader) == "@" { return false; }
    true
}

/** Non-failing counterpart to `parseTupleDestructureTarget` for root pre-collection. */
tryParseDestructureNames := fn(source: String, open: Int, prefix: String): (ok: Bool, namesText: String, count: Int, grouped: Bool) {
    size := textLib.length(source);
    if open < 0 or open >= size or textLib.at(source, open) =!= "(" {
        return (ok = false, namesText = "", count = 0, grouped = false);
    }
    var cursor := skipTrivia(source, open + 1, prefix);
    names: mut List<String> = [];
    var count := 0;
    var hadComma := false;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            return (ok = false, namesText = "", count = 0, grouped = false);
        }
        nameStart := cursor;
        nameEnd := textLib.skipName(source, nameStart);
        bindName := textLib.slice(source, nameStart, nameEnd);
        if isReservedWord(bindName) {
            return (ok = false, namesText = "", count = 0, grouped = false);
        }
        listLib.pushBack(mut names, bindName);
        count = count + 1;
        cursor = skipTrivia(source, nameEnd, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if cursor >= size or textLib.at(source, cursor) =!= ")" {
        return (ok = false, namesText = "", count = 0, grouped = false);
    }
    (ok = true, namesText = textLib.joinTexts(names, ","), count = count, grouped = count == 1 and not hadComma)
}

/** Finds the start position of the final expression inside `{ ... }` from `openBracePos` to `closeBracePos`, or -1 when empty. */
tryInferBlockTailStart := fn(source: String, openBracePos: Int, closeBracePos: Int, prefix: String): Int {
    limit := closeBracePos - 1;
    var cursor := skipTrivia(source, openBracePos + 1, prefix);
    if cursor >= limit { return -1; }
    var lastTailStart := cursor;
    var parenDepth := 0;
    loop cursor < limit {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" {
            parenDepth = parenDepth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            cursor = cursor + 1;
        } else if ch == "{" {
            closed := scanBraceEnd(source, cursor, prefix);
            if closed < 0 or closed > limit { return -1; }
            cursor = closed;
        } else if parenDepth == 0 and ch == ";" {
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor >= limit { return -1; }
            lastTailStart = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    lastTailStart
}

/** Best-effort non-failing expression kind inference for unannotated forward root declarations. */
tryInferRootExprKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, functions: List<FunctionInfo>, params: List<String>, locals: List<Local>, futureValues: List<FutureValue>, expected: String, minimum: Int, depthLeft: Int): (kind: String, next: Int) {
    if depthLeft <= 0 { return (kind = "", next = position); }
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start >= size { return (kind = "", next = start); }
    ch := textLib.at(source, start);
    var leftKind := "";
    var leftNext := start;
    var curFnIdx := -1;
    if ch == "+" or ch == "-" {
        if start + 1 < size and (textLib.at(source, start + 1) == ">" or textLib.at(source, start + 1) == "-") {
            return (kind = "", next = start);
        }
        operand := self(source, start + 1, prefix, aliases, functions, params, locals, futureValues, expected, 70, depthLeft - 1);
        if operand.kind == "" or not numeric.isNumericKind(operand.kind) {
            return (kind = "", next = start);
        }
        leftKind = operand.kind;
        leftNext = operand.next;
    } else if ch == "n" and textLib.wordAt(source, start, "not") {
        operand := self(source, start + 3, prefix, aliases, functions, params, locals, futureValues, "Bool", 70, depthLeft - 1);
        if operand.kind =!= "Bool" { return (kind = "", next = start); }
        leftKind = "Bool";
        leftNext = operand.next;
    } else if textLib.isDigit(ch) {
        scanned := numeric.scanNumericLiteral(source, start);
        if scanned.exponentMissingAt >= 0 { return (kind = "", next = start); }
        if scanned.floating {
            leftKind = if expected == "Float32" { "Float32" } else { "Float" };
        } else {
            leftKind = if numeric.isNarrowNumericKind(expected) or expected == "Float" or expected == "Float32" {
                expected
            } else {
                "Int"
            };
        }
        leftNext = scanned.next;
    } else if ch == "\"" {
        leftKind = "String";
        leftNext = skipAliasString(source, start);
    } else if ch == "t" and textLib.wordAt(source, start, "true") {
        leftKind = "Bool";
        leftNext = start + 4;
    } else if ch == "f" and textLib.wordAt(source, start, "false") {
        leftKind = "Bool";
        leftNext = start + 5;
    } else if ch == "[" {
        var cur := skipTrivia(source, start + 1, prefix);
        if cur < size and textLib.at(source, cur) == "]" {
            if isListKind(expected) {
                leftKind = expected;
                leftNext = cur + 1;
            } else {
                return (kind = "", next = start);
            }
        } else {
            elemExp := if isListKind(expected) { listElementKind(expected) } else if isArrayKind(expected) { arrayElementKind(expected) } else { "" };
            firstEl := self(source, cur, prefix, aliases, functions, params, locals, futureValues, elemExp, 0, depthLeft - 1);
            if firstEl.kind == "" or firstEl.kind == "Unit" { return (kind = "", next = start); }
            var elemCount := 1;
            cur = skipTrivia(source, firstEl.next, prefix);
            loop cur < size and textLib.at(source, cur) == "," {
                cur = skipTrivia(source, cur + 1, prefix);
                if cur < size and textLib.at(source, cur) == "]" { break; }
                nextEl := self(source, cur, prefix, aliases, functions, params, locals, futureValues, firstEl.kind, 0, depthLeft - 1);
                if nextEl.kind == "" { return (kind = "", next = start); }
                elemCount = elemCount + 1;
                cur = skipTrivia(source, nextEl.next, prefix);
            }
            if cur >= size or textLib.at(source, cur) =!= "]" { return (kind = "", next = start); }
            leftKind = if isListKind(expected) {
                "List<" + firstEl.kind + ">"
            } else {
                "[" + firstEl.kind + ";" + integer.intText(elemCount) + "]"
            };
            leftNext = cur + 1;
        }
    } else if ch == "(" {
        parenClose := scanParenEnd(source, start, prefix);
        if parenClose < 0 { return (kind = "", next = start); }
        innerPos := skipTrivia(source, start + 1, prefix);
        if innerPos >= parenClose - 1 {
            leftKind = "Unit";
            leftNext = parenClose;
        } else {
            if not looksLikeTupleEntry(source, innerPos, prefix) {
                grouped := self(source, innerPos, prefix, aliases, functions, params, locals, futureValues, expected, 0, depthLeft - 1);
                if grouped.kind =!= "" and skipTrivia(source, grouped.next, prefix) == parenClose - 1 {
                    leftKind = grouped.kind;
                    leftNext = parenClose;
                }
            }
            if leftKind == "" {
                tLabels: mut List<String> = [];
                tParts: mut List<String> = [];
                var tCur := innerPos;
                var tCount := 0;
                var tLabelCount := 0;
                var tHadComma := false;
                loop tCur < parenClose - 1 {
                    var fLabel := "";
                    var valStart := tCur;
                    if textLib.at(source, tCur) == "=" {
                        shStart := skipTrivia(source, tCur + 1, prefix);
                        if shStart < parenClose - 1 and textLib.isNameStart(textLib.at(source, shStart)) {
                            shEnd := textLib.skipName(source, shStart);
                            shName := textLib.slice(source, shStart, shEnd);
                            if isReservedWord(shName) or listLib.listContainsText(tLabels, shName) {
                                return (kind = "", next = start);
                            }
                            fLabel = shName;
                            tLabelCount = tLabelCount + 1;
                            listLib.pushBack(mut tLabels, shName);
                            valStart = shStart;
                        } else {
                            return (kind = "", next = start);
                        }
                    } else if textLib.isNameStart(textLib.at(source, tCur)) {
                        afterLbl := textLib.skipName(source, tCur);
                        eqPos := skipTrivia(source, afterLbl, prefix);
                        if eqPos < parenClose - 1 and isSingleEquals(source, eqPos) {
                            cand := textLib.slice(source, tCur, afterLbl);
                            if isReservedWord(cand) or listLib.listContainsText(tLabels, cand) {
                                return (kind = "", next = start);
                            }
                            fLabel = cand;
                            tLabelCount = tLabelCount + 1;
                            listLib.pushBack(mut tLabels, cand);
                            valStart = skipTrivia(source, eqPos + 1, prefix);
                        }
                    }
                    fVal := self(source, valStart, prefix, aliases, functions, params, locals, futureValues, "", 0, depthLeft - 1);
                    if fVal.kind == "" or isTupleKind(fVal.kind) or isListKind(fVal.kind) or fVal.kind == "Unit" {
                        return (kind = "", next = start);
                    }
                    listLib.pushBack(mut tParts, fLabel + ":" + fVal.kind);
                    tCount = tCount + 1;
                    tCur = skipTrivia(source, fVal.next, prefix);
                    if tCur < parenClose - 1 and textLib.at(source, tCur) == "," {
                        tHadComma = true;
                        tCur = skipTrivia(source, tCur + 1, prefix);
                    } else {
                        break;
                    }
                }
                if tCur =!= parenClose - 1 or tCount == 0 or (tCount == 1 and tLabelCount == 0 and not tHadComma) {
                    return (kind = "", next = start);
                }
                leftKind = "(" + textLib.joinTexts(tParts, ",") + ")";
                leftNext = parenClose;
            }
        }
    } else if ch == "{" {
        blockClose := scanBraceEnd(source, start, prefix);
        if blockClose < 0 { return (kind = "", next = start); }
        tailPos := tryInferBlockTailStart(source, start, blockClose, prefix);
        if tailPos < 0 {
            leftKind = "Unit";
        } else {
            tailParsed := self(source, tailPos, prefix, aliases, functions, params, locals, futureValues, expected, 0, depthLeft - 1);
            if tailParsed.kind == "" or skipTrivia(source, tailParsed.next, prefix) =!= blockClose - 1 {
                return (kind = "", next = start);
            }
            leftKind = tailParsed.kind;
        }
        var endAfterBlk := blockClose;
        afterBlk := skipTrivia(source, blockClose, prefix);
        if afterBlk < size and textLib.wordAt(source, afterBlk, "finally") {
            finOpen := skipTrivia(source, afterBlk + 7, prefix);
            if finOpen < size and textLib.at(source, finOpen) == "{" {
                finClose := scanBraceEnd(source, finOpen, prefix);
                if finClose < 0 { return (kind = "", next = start); }
                endAfterBlk = finClose;
            }
        }
        leftNext = endAfterBlk;
    } else if ch == "i" and textLib.wordAt(source, start, "if") {
        var curIf := start + 2;
        var accKind := "";
        var endPos := -1;
        var hasElseBranch := false;
        loop curIf < size {
            openBr := scanConditionOpen(source, curIf, prefix);
            if openBr < 0 { return (kind = "", next = start); }
            closeBr := scanBraceEnd(source, openBr, prefix);
            if closeBr < 0 { return (kind = "", next = start); }
            tailPos := tryInferBlockTailStart(source, openBr, closeBr, prefix);
            var brKind := "Unit";
            if tailPos >= 0 {
                tailParsed := self(source, tailPos, prefix, aliases, functions, params, locals, futureValues, expected, 0, depthLeft - 1);
                if tailParsed.kind == "" or skipTrivia(source, tailParsed.next, prefix) =!= closeBr - 1 {
                    return (kind = "", next = start);
                }
                brKind = tailParsed.kind;
            }
            accKind = if accKind == "" { brKind } else { joinBranchKind(accKind, brKind) };
            afterBr := skipTrivia(source, closeBr, prefix);
            if afterBr < size and textLib.wordAt(source, afterBr, "else") {
                afterElse := skipTrivia(source, afterBr + 4, prefix);
                if textLib.wordAt(source, afterElse, "if") {
                    curIf = afterElse + 2;
                    continue;
                }
                if afterElse < size and textLib.at(source, afterElse) == "{" {
                    elseClose := scanBraceEnd(source, afterElse, prefix);
                    if elseClose < 0 { return (kind = "", next = start); }
                    hasElseBranch = true;
                    elseTail := tryInferBlockTailStart(source, afterElse, elseClose, prefix);
                    var elseKind := "Unit";
                    if elseTail >= 0 {
                        elseParsed := self(source, elseTail, prefix, aliases, functions, params, locals, futureValues, expected, 0, depthLeft - 1);
                        if elseParsed.kind == "" or skipTrivia(source, elseParsed.next, prefix) =!= elseClose - 1 {
                            return (kind = "", next = start);
                        }
                        elseKind = elseParsed.kind;
                    }
                    accKind = joinBranchKind(accKind, elseKind);
                    endPos = elseClose;
                    break;
                }
                return (kind = "", next = start);
            }
            endPos = closeBr;
            break;
        }
        if endPos < 0 { return (kind = "", next = start); }
        afterIf := skipTrivia(source, endPos, prefix);
        if afterIf < size and (textLib.wordAt(source, afterIf, "then") or textLib.wordAt(source, afterIf, "finally")) {
            return (kind = "", next = start);
        }
        leftKind = if hasElseBranch { accKind } else { "Unit" };
        leftNext = endPos;
    } else if ch == "f" and textLib.wordAt(source, start, "fn") {
        hdrPos := skipTrivia(source, start + 2, prefix);
        if not canPreParseFunctionHeader(source, hdrPos, prefix, aliases, false) {
            return (kind = "", next = start);
        }
        if hdrPos >= size or textLib.at(source, hdrPos) =!= "(" {
            return (kind = "", next = start);
        }
        var pCur := skipTrivia(source, hdrPos + 1, prefix);
        fnParamParts: mut List<String> = [];
        emptySeen: List<String> = [];
        loop pCur < size and textLib.at(source, pCur) =!= ")" {
            pEnd := textLib.skipName(source, pCur);
            pName := textLib.slice(source, pCur, pEnd);
            afterPColon := skipTrivia(source, pEnd, prefix);
            pTyped := canResolveTypeAt(source, afterPColon + 1, prefix, aliases, "", emptySeen, 32);
            if not pTyped.ok or pTyped.kind == "Unit" { return (kind = "", next = start); }
            listLib.pushBack(mut fnParamParts, pName + ":" + pTyped.kind);
            pCur = skipTrivia(source, pTyped.next, prefix);
            if pCur < size and textLib.at(source, pCur) == "," { pCur = skipTrivia(source, pCur + 1, prefix); }
            else { break; }
        }
        afterFnClose := skipTrivia(source, pCur + 1, prefix);
        retTyped := canResolveTypeAt(source, afterFnClose + 1, prefix, aliases, "", emptySeen, 32);
        if not retTyped.ok { return (kind = "", next = start); }
        bodyOpen := skipTrivia(source, retTyped.next, prefix);
        if bodyOpen >= size or textLib.at(source, bodyOpen) =!= "{" { return (kind = "", next = start); }
        bodyClose := scanBraceEnd(source, bodyOpen, prefix);
        if bodyClose < 0 { return (kind = "", next = start); }
        leftKind = "fn(" + textLib.joinTexts(fnParamParts, ",") + "):" + retTyped.kind;
        leftNext = bodyClose;
    } else if textLib.isNameStart(ch) {
        afterName := textLib.skipName(source, start);
        name := textLib.slice(source, start, afterName);
        if isReservedWord(name) { return (kind = "", next = start); }
        locIdx := localIndex(locals, name);
        if locIdx >= 0 and locals[locIdx].kind == "Module" {
            afterDot := skipTrivia(source, afterName, prefix);
            if afterDot >= size or textLib.at(source, afterDot) =!= "." { return (kind = "", next = start); }
            memStart := skipTrivia(source, afterDot + 1, prefix);
            if memStart >= size or not textLib.isNameStart(textLib.at(source, memStart)) { return (kind = "", next = start); }
            memEnd := textLib.skipName(source, memStart);
            qualified := name + "." + textLib.slice(source, memStart, memEnd);
            qFnIdx := findFunction(functions, qualified);
            if qFnIdx >= 0 {
                curFnIdx = qFnIdx;
                leftKind = "$fn";
                leftNext = memEnd;
            } else {
                qLocIdx := localIndex(locals, qualified);
                if qLocIdx >= 0 {
                    leftKind = locals[qLocIdx].kind;
                    leftNext = memEnd;
                }
            }
        } else {
            var futPriorIdx := -1;
            var futAnyIdx := -1;
            var fi := 0;
            loop futureValues as fut {
                if fut.name == name and fut.kind =!= "" {
                    futAnyIdx = fi;
                    if fut.at >= 0 and fut.at < start { futPriorIdx = fi; }
                }
                fi = fi + 1;
            }
            if futPriorIdx >= 0 {
                leftKind = futureValues[futPriorIdx].kind;
                leftNext = afterName;
            } else if locIdx >= 0 {
                leftKind = locals[locIdx].kind;
                leftNext = afterName;
            } else if futAnyIdx >= 0 {
                leftKind = futureValues[futAnyIdx].kind;
                leftNext = afterName;
            } else {
                fnIdx := findFunction(functions, name);
                if fnIdx >= 0 {
                    curFnIdx = fnIdx;
                    leftKind = "$fn";
                    leftNext = afterName;
                }
            }
        }
    }
    if leftKind == "" { return (kind = "", next = start); }
    loop true {
        postPos := skipTrivia(source, leftNext, prefix);
        if curFnIdx >= 0 and (postPos >= size or textLib.at(source, postPos) =!= "(") {
            fnEntry := functions[curFnIdx];
            if fnEntry.count < 0 { return (kind = "", next = start); }
            fnParts: mut List<String> = [];
            var pi := 0;
            loop pi < fnEntry.count {
                pEntry := params[fnEntry.first + pi];
                listLib.pushBack(mut fnParts, paramNameOf(pEntry) + ":" + paramKindOf(pEntry));
                pi = pi + 1;
            }
            leftKind = "fn(" + textLib.joinTexts(fnParts, ",") + "):" + fnEntry.result;
            curFnIdx = -1;
        }
        if postPos >= size { break; }
        if curFnIdx >= 0 and textLib.at(source, postPos) == "(" {
            callClose := scanParenEnd(source, postPos, prefix);
            if callClose < 0 { return (kind = "", next = start); }
            leftKind = functions[curFnIdx].result;
            leftNext = callClose;
            curFnIdx = -1;
            continue;
        }
        postCh := textLib.at(source, postPos);
        if postCh == "(" and isFnKind(leftKind) {
            callClose := scanParenEnd(source, postPos, prefix);
            if callClose < 0 { return (kind = "", next = start); }
            leftKind = fnResultKind(leftKind);
            leftNext = callClose;
        } else if postCh == "[" and (isListKind(leftKind) or isArrayKind(leftKind)) {
            brClose := skipTrivia(source, postPos + 1, prefix);
            idxExpr := self(source, brClose, prefix, aliases, functions, params, locals, futureValues, "Int", 0, depthLeft - 1);
            afterIdx := skipTrivia(source, idxExpr.next, prefix);
            if afterIdx >= size or textLib.at(source, afterIdx) =!= "]" { return (kind = "", next = start); }
            leftKind = if isListKind(leftKind) { listElementKind(leftKind) } else { arrayElementKind(leftKind) };
            leftNext = afterIdx + 1;
        } else if postCh == "." {
            fStart := skipTrivia(source, postPos + 1, prefix);
            if fStart >= size { break; }
            if textLib.isDigit(textLib.at(source, fStart)) {
                var dEnd := fStart;
                var fIdx := 0;
                loop dEnd < size and textLib.isDigit(textLib.at(source, dEnd)) {
                    fIdx = fIdx * 10 + decimalDigit(textLib.at(source, dEnd));
                    dEnd = dEnd + 1;
                }
                if isArrayKind(leftKind) {
                    if fIdx >= arrayExtent(leftKind) { return (kind = "", next = start); }
                    leftKind = arrayElementKind(leftKind);
                    leftNext = dEnd;
                } else if isTupleKind(leftKind) {
                    comp := tupleComponent(leftKind, fIdx);
                    if comp.kind == "" { return (kind = "", next = start); }
                    leftKind = comp.kind;
                    leftNext = dEnd;
                } else {
                    break;
                }
            } else if textLib.isNameStart(textLib.at(source, fStart)) {
                fEnd := textLib.skipName(source, fStart);
                fName := textLib.slice(source, fStart, fEnd);
                if isTupleKind(leftKind) {
                    fKind := tupleFieldKind(leftKind, fName);
                    if fKind == "" { return (kind = "", next = start); }
                    leftKind = fKind;
                    leftNext = fEnd;
                } else {
                    break;
                }
            } else {
                break;
            }
        } else {
            break;
        }
    }
    loop true {
        opPos := skipTrivia(source, leftNext, prefix);
        if opPos >= size { break; }
        operator := readOperator(source, opPos);
        opLevel := operatorLevel(operator.text);
        if operator.text == "" or opLevel < minimum { break; }
        nextMinimum := if operator.text == "**" { opLevel } else { opLevel + 1 };
        right := self(source, opPos + operator.width, prefix, aliases, functions, params, locals, futureValues, "", nextMinimum, depthLeft - 1);
        if right.kind == "" { return (kind = "", next = start); }
        if operator.text == "and" or operator.text == "or" {
            if leftKind =!= "Bool" or right.kind =!= "Bool" { return (kind = "", next = start); }
            leftKind = "Bool";
            leftNext = right.next;
        } else if isComparison(operator.text) {
            var cmpNext := right.next;
            loop true {
                nextCmpPos := skipTrivia(source, cmpNext, prefix);
                nextCmp := comparisonOperatorAt(source, nextCmpPos);
                if nextCmp.text == "" { break; }
                chained := self(source, nextCmpPos + nextCmp.width, prefix, aliases, functions, params, locals, futureValues, "", operatorLevel(nextCmp.text) + 1, depthLeft - 1);
                if chained.kind == "" { return (kind = "", next = start); }
                cmpNext = chained.next;
            }
            leftKind = "Bool";
            leftNext = cmpNext;
        } else if operator.text == "+" and leftKind == "String" and right.kind == "String" {
            leftKind = "String";
            leftNext = right.next;
        } else if numeric.isNumericKind(leftKind) and numeric.isNumericKind(right.kind) {
            leftKind = if leftKind == right.kind { leftKind } else { numeric.promoteNumericKind(leftKind, right.kind) };
            leftNext = right.next;
        } else {
            return (kind = "", next = start);
        }
    }
    (kind = leftKind, next = leftNext)
}

/** True for characters allowed in compiler-generated runtime identifiers. */
isTraceIdentChar := fn(ch: String): Bool {
    textLib.isNameContinue(ch) or ch == "$"
}

/** True when `tok` names a user function, module function, or local/root variable runtime. */
tokenStartsWithRuntimePrefix := fn(tok: String): Bool {
    textLib.startsWithAt(tok, 0, "liteFn") or textLib.startsWithAt(tok, 0, "lt_fn_") or
    textLib.startsWithAt(tok, 0, "lite_") or textLib.startsWithAt(tok, 0, "lite$m$") or
    textLib.startsWithAt(tok, 0, "lt_m_")
}

/** True when `bag` contains `tok` in `"|a|b|"` form. */
tokenInPipeBag := fn(bag: String, tok: String): Bool {
    tok =!= "" and textLib.indexOfText(bag, "|" + tok + "|", 0) >= 0
}

/** Appends `tok` to a pipe-delimited token set `"|a|b|"` when absent. */
appendPipeBag := fn(bag: String, tok: String): String {
    if tok == "" or textLib.indexOfText(bag, "|" + tok + "|", 0) >= 0 { return bag; }
    if bag == "" { "|" + tok + "|" } else { bag + tok + "|" }
}

/** Merges every token in pipe bag `extra` into `base` without duplicates. */
mergePipeBags := fn(base: String, extra: String): String {
    if extra == "" { return base; }
    if base == "" { return extra; }
    var out := base;
    len := textLib.length(extra);
    var pos := 0;
    loop pos < len {
        if textLib.at(extra, pos) == "|" {
            pos = pos + 1;
            continue;
        }
        nextBar := textLib.indexOfText(extra, "|", pos);
        endPos := if nextBar < 0 { len } else { nextBar };
        if endPos > pos {
            out = appendPipeBag(out, textLib.slice(extra, pos, endPos));
        }
        pos = endPos + 1;
    }
    out
}

/** Extracts the `allBag` portion (`allBag + "\n" + readBag`) from encoded callable dependency metadata. */
fnDepsAll := fn(encoded: String): String {
    if encoded == "" { return ""; }
    nl := textLib.indexOfText(encoded, "\n", 0);
    if nl < 0 { encoded } else { textLib.slice(encoded, 0, nl) }
}

/** Extracts the `readBag` portion (`allBag + "\n" + readBag`) from encoded callable dependency metadata. */
fnDepsRead := fn(encoded: String): String {
    if encoded == "" { return ""; }
    nl := textLib.indexOfText(encoded, "\n", 0);
    if nl < 0 { encoded } else { textLib.slice(encoded, nl + 1, textLib.length(encoded)) }
}

/** Unions two `"allBag\nreadBag"` encoded dependency pairs. */
mergeCallableLocalDeps := fn(existingCode: String, newDeps: String): String {
    if existingCode == "" { return newDeps; }
    if newDeps == "" { return existingCode; }
    mergedAll := mergePipeBags(fnDepsAll(existingCode), fnDepsAll(newDeps));
    mergedRead := mergePipeBags(fnDepsRead(existingCode), fnDepsRead(newDeps));
    mergedAll + "\n" + mergedRead
}

/** Advances past ASCII spaces/newlines in emitted code strings. */
skipCodeSpaces := fn(code: String, pos: Int): Int {
    len := textLib.length(code);
    var p := pos;
    loop p < len {
        ch := textLib.at(code, p);
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" { p = p + 1; } else { break; }
    }
    p
}

/** Advances past a quoted string literal starting at `quotePos` inside emitted code. */
skipCodeString := fn(code: String, quotePos: Int): Int {
    len := textLib.length(code);
    var p := quotePos + 1;
    loop p < len {
        ch := textLib.at(code, p);
        if ch == "\\" {
            p = p + 2;
        } else if ch == "\"" {
            return p + 1;
        } else {
            p = p + 1;
        }
    }
    len
}

/** Collects referenced user/module/value runtime identifiers from emitted TS code, optionally skipping LHS declaration headers. */
extractCodeRuntimeTokens := fn(code: String, skipLhsDecls: Bool): String {
    var bag := "";
    len := textLib.length(code);
    var i := 0;
    loop i < len {
        ch := textLib.at(code, i);
        if ch == "\"" {
            i = skipCodeString(code, i);
            continue;
        }
        if skipLhsDecls and ch == "v" and textLib.wordAt(code, i, "void") {
            afterVoid := skipCodeSpaces(code, i + 4);
            if afterVoid < len and isTraceIdentChar(textLib.at(code, afterVoid)) {
                var vEnd := afterVoid;
                loop vEnd < len and isTraceIdentChar(textLib.at(code, vEnd)) { vEnd = vEnd + 1; }
                afterId := skipCodeSpaces(code, vEnd);
                if afterId < len and textLib.at(code, afterId) == ";" {
                    i = afterId + 1;
                    continue;
                }
            }
        }
        if skipLhsDecls and ((ch == "c" and textLib.wordAt(code, i, "const")) or (ch == "l" and textLib.wordAt(code, i, "let"))) {
            kwLen := if ch == "c" { 5 } else { 3 };
            afterKw := skipCodeSpaces(code, i + kwLen);
            if afterKw < len and isTraceIdentChar(textLib.at(code, afterKw)) {
                var idEnd := afterKw;
                loop idEnd < len and isTraceIdentChar(textLib.at(code, idEnd)) { idEnd = idEnd + 1; }
                var eqScan := idEnd;
                var foundEq := -1;
                var tDepth := 0;
                loop eqScan < len {
                    ec := textLib.at(code, eqScan);
                    if ec == "\"" {
                        eqScan = skipCodeString(code, eqScan);
                        continue;
                    }
                    if ec == "(" or ec == "[" or ec == "{" or ec == "<" {
                        tDepth = tDepth + 1;
                    } else if ec == ")" or ec == "]" or ec == "}" or ec == ">" {
                        if tDepth > 0 and not textLib.startsWithAt(code, eqScan - 1, "=>") { tDepth = tDepth - 1; }
                    } else if tDepth == 0 and ec == ";" {
                        break;
                    } else if ec == "=" and not textLib.startsWithAt(code, eqScan, "=>") and
                    not textLib.startsWithAt(code, eqScan, "==") and
                    (eqScan == 0 or (textLib.at(code, eqScan - 1) =!= "=" and textLib.at(code, eqScan - 1) =!= "!" and
                    textLib.at(code, eqScan - 1) =!= "<" and textLib.at(code, eqScan - 1) =!= ">")) {
                        foundEq = eqScan;
                        break;
                    }
                    eqScan = eqScan + 1;
                }
                if foundEq >= 0 {
                    i = foundEq + 1;
                    continue;
                }
            }
        }
        if textLib.isNameStart(ch) or ch == "$" {
            var tokEnd := i;
            loop tokEnd < len and isTraceIdentChar(textLib.at(code, tokEnd)) { tokEnd = tokEnd + 1; }
            tok := textLib.slice(code, i, tokEnd);
            if tokenStartsWithRuntimePrefix(tok) { bag = appendPipeBag(bag, tok); }
            i = tokEnd;
        } else {
            i = i + 1;
        }
    }
    bag
}

/** Returns the `lite_*` local runtime being bound immediately before `= (function ...)` at `fnPos`, or `""` when not a local binding. */
precedingAssignedLocalRuntime := fn(code: String, fnPos: Int): String {
    var k := fnPos - 1;
    loop k >= 0 {
        kc := textLib.at(code, k);
        if kc == " " or kc == "\t" or kc == "\n" or kc == "\r" { k = k - 1; } else { break; }
    }
    if k < 0 or textLib.at(code, k) =!= "=" { return ""; }
    if k > 0 {
        prev := textLib.at(code, k - 1);
        if prev == "=" or prev == "<" or prev == ">" or prev == "!" { return ""; }
    }
    var scanBack := k - 1;
    var depth := 0;
    loop scanBack >= 0 {
        sc := textLib.at(code, scanBack);
        if sc == ")" or sc == "]" or sc == "}" {
            depth = depth + 1;
        } else if sc == "(" or sc == "[" or sc == "{" {
            if depth == 0 {
                scanBack = scanBack + 1;
                break;
            }
            depth = depth - 1;
        } else if sc == ";" and depth == 0 {
            scanBack = scanBack + 1;
            break;
        }
        scanBack = scanBack - 1;
    }
    if scanBack < 0 { scanBack = 0; }
    stmtPos := skipCodeSpaces(code, scanBack);
    var lhsPos := stmtPos;
    if textLib.wordAt(code, lhsPos, "const") { lhsPos = skipCodeSpaces(code, lhsPos + 5); }
    else if textLib.wordAt(code, lhsPos, "let") { lhsPos = skipCodeSpaces(code, lhsPos + 3); }
    if lhsPos >= k or not (textLib.isNameStart(textLib.at(code, lhsPos)) or textLib.at(code, lhsPos) == "$") {
        return "";
    }
    var lhsEnd := lhsPos;
    loop lhsEnd < k and isTraceIdentChar(textLib.at(code, lhsEnd)) { lhsEnd = lhsEnd + 1; }
    lhs := textLib.slice(code, lhsPos, lhsEnd);
    if textLib.startsWithAt(lhs, 0, "lite_") or textLib.startsWithAt(lhs, 0, "lite$arg") or lhs == "lite$fn" { lhs } else { "" }
}

/** Finds the position just after the closing `)` matching the `(` at `openPos` in emitted code, or -1 if unclosed. */
scanBalancedParenEnd := fn(code: String, openPos: Int): Int {
    len := textLib.length(code);
    if openPos < 0 or openPos >= len or textLib.at(code, openPos) =!= "(" { return -1; }
    var p := openPos + 1;
    var depth := 1;
    loop p < len {
        ch := textLib.at(code, p);
        if ch == "\"" {
            p = skipCodeString(code, p);
        } else if ch == "(" {
            depth = depth + 1;
            p = p + 1;
        } else if ch == ")" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 { return p; }
        } else {
            p = p + 1;
        }
    }
    -1
}

/** True when `code[openPos..closeEnd]` is a compiler-synthesized arrow function `((params)[: Ret] => body)`. */
isCompilerArrowIife := fn(code: String, openPos: Int, closeEnd: Int): Bool {
    if closeEnd <= openPos + 2 { return false; }
    innerPos := skipCodeSpaces(code, openPos + 1);
    if innerPos >= closeEnd - 1 or textLib.at(code, innerPos) =!= "(" { return false; }
    paramsEnd := scanBalancedParenEnd(code, innerPos);
    if paramsEnd < 0 or paramsEnd >= closeEnd - 1 { return false; }
    afterParams := skipCodeSpaces(code, paramsEnd);
    if textLib.startsWithAt(code, afterParams, "=>") { return true; }
    afterParams < closeEnd - 1 and textLib.at(code, afterParams) == ":"
}

/** True when `code[openPos..closeEnd]` is a parenthesized user/local callable `<callee>` immediately followed by `(<args>)`. */
isIndirectUserCallParens := fn(code: String, openPos: Int, closeEnd: Int): Bool {
    len := textLib.length(code);
    if closeEnd < 0 or closeEnd > len { return false; }
    afterClose := skipCodeSpaces(code, closeEnd);
    if afterClose >= len or textLib.at(code, afterClose) =!= "(" { return false; }
    if isCompilerArrowIife(code, openPos, closeEnd) { return false; }
    calleeText := textLib.slice(code, openPos + 1, closeEnd - 1);
    textLib.indexOfText(calleeText, "lite", 0) >= 0 or
    textLib.indexOfText(calleeText, "(function ", 0) >= 0 or
    textLib.indexOfText(calleeText, "=>", 0) >= 0
}

/** Strips uninvoked `(function ...)` bodies into `"0"` while keeping immediately-invoked `fn` literals and call arguments intact. */
stripDeferredFnBodies := fn(exprCode: String): (code: String, pairsText: String) {
    len := textLib.length(exprCode);
    outParts: mut List<String> = [];
    pairParts: mut List<String> = [];
    parenIsUserCall: mut List<Int> = [];
    var stackCount := 0;
    var indirectArgOpenBag := "";
    var callDepth := 0;
    var sliceStart := 0;
    var pos := 0;
    loop pos < len {
        ch := textLib.at(exprCode, pos);
        if ch == "\"" {
            pos = skipCodeString(exprCode, pos);
            continue;
        }
        if ch == "(" {
            if textLib.startsWithAt(exprCode, pos, "(function ") {
                fnEnd := scanBalancedParenEnd(exprCode, pos);
                if fnEnd >= 0 {
                    var la := fnEnd;
                    loop true {
                        la = skipCodeSpaces(exprCode, la);
                        if la < len and textLib.at(exprCode, la) == ")" { la = la + 1; } else { break; }
                    }
                    la = skipCodeSpaces(exprCode, la);
                    isDirectCall := la < len and textLib.at(exprCode, la) == "(";
                    if callDepth == 0 and not isDirectCall {
                        lhsName := precedingAssignedLocalRuntime(exprCode, pos);
                        if lhsName =!= "lite$fn" and not textLib.startsWithAt(lhsName, 0, "lite$arg") {
                            if lhsName =!= "" {
                                fnDeps := extractFnLiteralDeps(textLib.slice(exprCode, pos, fnEnd));
                                listLib.pushBack(mut pairParts, lhsName + ":" + fnDeps.allBag + "\t" + fnDeps.readBag + "\n");
                            }
                            listLib.pushBack(mut outParts, textLib.slice(exprCode, sliceStart, pos));
                            listLib.pushBack(mut outParts, "0");
                            sliceStart = fnEnd;
                            pos = fnEnd;
                            continue;
                        }
                    }
                }
            }
            var prev := pos - 1;
            loop prev >= 0 {
                pc := textLib.at(exprCode, prev);
                if pc == " " or pc == "\t" or pc == "\n" or pc == "\r" { prev = prev - 1; } else { break; }
            }
            var isCall := 0;
            if prev >= 0 and isTraceIdentChar(textLib.at(exprCode, prev)) {
                var idStart := prev;
                loop idStart > 0 and isTraceIdentChar(textLib.at(exprCode, idStart - 1)) { idStart = idStart - 1; }
                ident := textLib.slice(exprCode, idStart, prev + 1);
                if tokenStartsWithRuntimePrefix(ident) or ident == "lite$fn" { isCall = 1; }
            }
            if isCall == 0 and tokenInPipeBag(indirectArgOpenBag, integer.intText(pos)) {
                isCall = 1;
            }
            if isCall == 0 {
                closeParenEnd := scanBalancedParenEnd(exprCode, pos);
                if isIndirectUserCallParens(exprCode, pos, closeParenEnd) {
                    isCall = 1;
                    indirectArgOpenBag = appendPipeBag(indirectArgOpenBag, integer.intText(skipCodeSpaces(exprCode, closeParenEnd)));
                }
            }
            listLib.pushBack(mut parenIsUserCall, isCall);
            stackCount = stackCount + 1;
            callDepth = callDepth + isCall;
            pos = pos + 1;
            continue;
        }
        if ch == ")" {
            if stackCount > 0 {
                popped := listLib.popBack(mut parenIsUserCall);
                stackCount = stackCount - 1;
                callDepth = callDepth - popped;
            }
            pos = pos + 1;
            continue;
        }
        pos = pos + 1;
    }
    listLib.pushBack(mut outParts, textLib.slice(exprCode, sliceStart, len));
    pairsBody := textLib.joinTexts(pairParts, "");
    pairsText := if pairsBody == "" { "" } else { "\n" + pairsBody };
    (code = textLib.joinTexts(outParts, ""), pairsText = pairsText)
}

/** True when stripped eager code invokes a user/local/module callable or still contains an active `(function ` literal. */
hasUserOrLocalCall := fn(eagerCode: String): Bool {
    len := textLib.length(eagerCode);
    var i := 0;
    loop i < len {
        ch := textLib.at(eagerCode, i);
        if ch == "\"" {
            i = skipCodeString(eagerCode, i);
            continue;
        }
        if ch == "(" {
            if textLib.startsWithAt(eagerCode, i, "(function ") {
                return true;
            }
            closeParenEnd := scanBalancedParenEnd(eagerCode, i);
            if isIndirectUserCallParens(eagerCode, i, closeParenEnd) {
                return true;
            }
        }
        if textLib.isNameStart(ch) or ch == "$" {
            var tokEnd := i;
            loop tokEnd < len and isTraceIdentChar(textLib.at(eagerCode, tokEnd)) { tokEnd = tokEnd + 1; }
            tok := textLib.slice(eagerCode, i, tokEnd);
            if tokenStartsWithRuntimePrefix(tok) or tok == "lite$fn" {
                var after := skipCodeSpaces(eagerCode, tokEnd);
                loop after < len and (textLib.at(eagerCode, after) == "." or textLib.at(eagerCode, after) == "[") {
                    if textLib.at(eagerCode, after) == "." {
                        var memEnd := skipCodeSpaces(eagerCode, after + 1);
                        loop memEnd < len and isTraceIdentChar(textLib.at(eagerCode, memEnd)) { memEnd = memEnd + 1; }
                        after = skipCodeSpaces(eagerCode, memEnd);
                    } else {
                        var bDepth := 1;
                        var bScan := after + 1;
                        loop bScan < len and bDepth > 0 {
                            bc := textLib.at(eagerCode, bScan);
                            if bc == "\"" { bScan = skipCodeString(eagerCode, bScan); continue; }
                            if bc == "[" { bDepth = bDepth + 1; }
                            else if bc == "]" { bDepth = bDepth - 1; }
                            bScan = bScan + 1;
                        }
                        after = skipCodeSpaces(eagerCode, bScan);
                    }
                }
                if after < len and textLib.at(eagerCode, after) == "(" { return true; }
            }
            if tok == "lite$listIndex" {
                openPos := skipCodeSpaces(eagerCode, tokEnd);
                if openPos < len and textLib.at(eagerCode, openPos) == "(" {
                    endIdxCall := scanBalancedParenEnd(eagerCode, openPos);
                    if endIdxCall >= 0 {
                        afterIdxCall := skipCodeSpaces(eagerCode, endIdxCall);
                        if afterIdxCall < len and textLib.at(eagerCode, afterIdxCall) == "(" { return true; }
                    }
                }
            }
            i = tokEnd;
        } else {
            i = i + 1;
        }
    }
    false
}

/** True when `kind` and `code` only use scalar/unit features valid for scalar C dead-code pruning, preserving unsupported-type checks. */
isCSupportedKindAndCode := fn(kind: String, code: String): Bool {
    not isTupleKind(kind) and not isListKind(kind) and not isArrayKind(kind) and not containsFnKind(kind) and
    not codeUsesValueIf(code) and not codeUsesListCopy(code) and not codeUsesListIndex(code) and not codeUsesListPop(code)
}

/** True when `item` uses a C-unsupported construct that must stay visible to `emitProgram` diagnostics. */
isCUnsupportedItem := fn(item: Item): Bool {
    item.kind == "LocalTuple" or item.kind == "VarTuple" or item.kind == "AssignTuple" or
    item.kind == "LocalList" or item.kind == "VarList" or item.kind == "AssignList" or
    item.kind == "LocalFn" or item.kind == "VarFn" or item.kind == "AssignFn" or
    (item.kind == "Discard" and (isTupleKind(item.name) or isListKind(item.name) or
    isArrayKind(item.name) or containsFnKind(item.name))) or
    codeUsesValueIf(item.code) or codeUsesListCopy(item.code) or codeUsesListIndex(item.code) or codeUsesListPop(item.code)
}

/** True when `=` at `eqPos` in `stripped` is a comparison/arrow or an assignment to a local declared inside `stripped` itself. */
isInnerLocalAssignAt := fn(stripped: String, eqPos: Int): Bool {
    len := textLib.length(stripped);
    if eqPos < 0 or eqPos >= len or textLib.at(stripped, eqPos) =!= "=" { return false; }
    if eqPos + 1 < len {
        nx := textLib.at(stripped, eqPos + 1);
        if nx == "=" or nx == ">" { return true; }
    }
    if eqPos > 0 {
        pv := textLib.at(stripped, eqPos - 1);
        if pv == "=" or pv == "!" or pv == "<" or pv == ">" { return true; }
        if pv == "+" or pv == "-" or pv == "*" or pv == "/" or pv == "%" { return false; }
    }
    var scanBack := eqPos - 1;
    var bDepth := 0;
    loop scanBack >= 0 {
        sc := textLib.at(stripped, scanBack);
        if sc == ")" or sc == "]" or sc == "}" {
            bDepth = bDepth + 1;
        } else if sc == "(" or sc == "[" or sc == "{" {
            if bDepth == 0 {
                scanBack = scanBack + 1;
                break;
            }
            bDepth = bDepth - 1;
        } else if sc == ";" and bDepth == 0 {
            scanBack = scanBack + 1;
            break;
        }
        scanBack = scanBack - 1;
    }
    if scanBack < 0 { scanBack = 0; }
    stmtPos := skipCodeSpaces(stripped, scanBack);
    if textLib.wordAt(stripped, stmtPos, "const") or textLib.wordAt(stripped, stmtPos, "let") {
        return true;
    }
    if stmtPos >= eqPos or not (textLib.isNameStart(textLib.at(stripped, stmtPos)) or textLib.at(stripped, stmtPos) == "$") {
        return false;
    }
    var lhsEnd := stmtPos;
    loop lhsEnd < eqPos and isTraceIdentChar(textLib.at(stripped, lhsEnd)) { lhsEnd = lhsEnd + 1; }
    if skipCodeSpaces(stripped, lhsEnd) =!= eqPos { return false; }
    lhs := textLib.slice(stripped, stmtPos, lhsEnd);
    textLib.indexOfText(stripped, "let " + lhs + " ", 0) >= 0 or
    textLib.indexOfText(stripped, "let " + lhs + ":", 0) >= 0 or
    textLib.indexOfText(stripped, "let " + lhs + ";", 0) >= 0
}

/** True when `code` has no function calls, runtime panic helpers, loops, throws, or outer mutations after stripping uninvoked `fn` literals. */
isSideEffectFreeCode := fn(target: String, code: String): Bool {
    if code == "" { return true; }
    stripped := stripDeferredFnBodies(code).code;
    size := textLib.length(stripped);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(stripped, cursor);
        if ch == "\"" {
            cursor = skipCodeString(stripped, cursor);
            continue;
        }
        if ch == "(" {
            if textLib.startsWithAt(stripped, cursor, "(function ") { return false; }
            closeEnd := scanBalancedParenEnd(stripped, cursor);
            if isIndirectUserCallParens(stripped, cursor, closeEnd) { return false; }
            if target == "ts" and closeEnd >= 0 {
                afterClose := skipCodeSpaces(stripped, closeEnd);
                if afterClose < size and textLib.at(stripped, afterClose) == "(" and
                not isCompilerArrowIife(stripped, cursor, closeEnd) {
                    return false;
                }
            }
            cursor = cursor + 1;
            continue;
        }
        if ch == "]" {
            afterBr := skipCodeSpaces(stripped, cursor + 1);
            if afterBr < size and textLib.at(stripped, afterBr) == "(" { return false; }
            cursor = cursor + 1;
            continue;
        }
        if ch == "=" {
            if not isInnerLocalAssignAt(stripped, cursor) { return false; }
            cursor = cursor + 1;
            continue;
        }
        if textLib.isNameStart(ch) or ch == "$" {
            var endPos := cursor;
            loop endPos < size and isTraceIdentChar(textLib.at(stripped, endPos)) { endPos = endPos + 1; }
            name := textLib.slice(stripped, cursor, endPos);
            prevIsDot := cursor > 0 and textLib.at(stripped, cursor - 1) == ".";
            if not prevIsDot and (name == "throw" or name == "while" or name == "for" or name == "try") {
                return false;
            }
            afterName := skipCodeSpaces(stripped, endPos);
            if afterName < size and textLib.at(stripped, afterName) == "(" {
                isKeywordParen := not prevIsDot and (name == "if" or name == "return" or name == "void");
                isMathPrefix := cursor >= 5 and textLib.slice(stripped, cursor - 5, cursor) == "Math." and
                (cursor == 5 or not isTraceIdentChar(textLib.at(stripped, cursor - 6)));
                isMathFround := name == "fround" and isMathPrefix;
                isPureWrapper := not prevIsDot and (
                name == "Boolean" or name == "Number" or name == "INT64_C" or
                name == "lt_float_literal" or name == "lt_float32_literal" or name == "strcmp"
                );
                if not isKeywordParen and not isMathFround and not isPureWrapper {
                    return false;
                }
            }
            cursor = endPos;
            continue;
        }
        cursor = cursor + 1;
    }
    true
}

/** True when a declaration or discarded expression of `kind` and `code` can be omitted on `target` without altering observable behavior or diagnostics. */
isPrunableExprForTarget := fn(target: String, kind: String, code: String): Bool {
    if target =!= "ts" and not isCSupportedKindAndCode(kind, code) { return false; }
    isSideEffectFreeCode(target, code)
}

/** True when `runtime` appears in `locals[0 .. limit)` (declared outside the current block). */
localsRangeUsesRuntime := fn(locals: List<Local>, limit: Int, runtime: String): Bool {
    var i := 0;
    loop i < limit {
        if locals[i].runtime == runtime { return true; }
        i = i + 1;
    }
    false
}

/** Eliminates unreachable pure statements and local bindings inside one `{ ... }` block after its statements and tail are parsed. */
pruneBlockStatements := fn(stmts: List<String>, owners: List<String>, deps: List<String>, hasTail: Bool, tailCode: String): List<String> {
    var total := 0;
    var hasPrunable := false;
    loop stmts { total = total + 1; }
    if total == 0 {
        emptyOut: mut List<String> = [];
        return emptyOut;
    }
    var checkIdx := 0;
    loop checkIdx < total {
        if owners[checkIdx] =!= "" {
            hasPrunable = true;
            break;
        }
        checkIdx = checkIdx + 1;
    }
    if not hasPrunable { return stmts; }

    var reachable := emptyTokenBuckets();
    if hasTail {
        reachable = codeReachableTokensSet(tailCode, reachable);
    }
    var seedIdx := 0;
    loop seedIdx < total {
        if owners[seedIdx] == "" {
            reachable = codeReachableTokensSet(deps[seedIdx], reachable);
        }
        seedIdx = seedIdx + 1;
    }

    var scannedBag := "";
    loop true {
        beforeCount := reachable.count;
        var scanIdx := 0;
        loop scanIdx < total {
            ow := owners[scanIdx];
            if ow =!= "" and ow =!= "#discard" and tokenBucketHas(reachable, ow) {
                key := integer.intText(scanIdx);
                if not tokenInPipeBag(scannedBag, key) {
                    scannedBag = appendPipeBag(scannedBag, key);
                    reachable = codeReachableTokensSet(deps[scanIdx], reachable);
                }
            }
            scanIdx = scanIdx + 1;
        }
        if reachable.count == beforeCount { break; }
    }

    kept: mut List<String> = [];
    var outIdx := 0;
    loop outIdx < total {
        ow := owners[outIdx];
        if ow == "" or (ow =!= "#discard" and tokenBucketHas(reachable, ow)) {
            listLib.pushBack(mut kept, stmts[outIdx]);
        }
        outIdx = outIdx + 1;
    }
    kept
}

/** Finds matching declaration index in `decl*` along the lexical parent chain from `startBlockId`, or -1. */
findDeclInBlockChain := fn(runtime: String, startBlockId: Int, parentBlockIds: List<Int>,
declRuntimes: List<String>, declBlockIds: List<Int>, declCount: Int): Int {
    var b := startBlockId;
    loop b > 0 {
        var d := declCount - 1;
        loop d >= 0 {
            if declBlockIds[d] == b and declRuntimes[d] == runtime {
                return d;
            }
            d = d - 1;
        }
        b = parentBlockIds[b];
    }
    -1
}

/** Maps runtime identifier references in `code` to matching declaration item indices along `startBlockId`'s lexical ancestor chain. */
resolveBlockLexicalDeps := fn(code: String, startBlockId: Int, parentBlockIds: List<Int>,
declRuntimes: List<String>, declBlockIds: List<Int>, declIdxs: List<Int>, declCount: Int): String {
    if declCount <= 0 or startBlockId <= 0 or code == "" { return ""; }
    var nextLite := textLib.indexOfText(code, "lite", 0);
    var nextLt := textLib.indexOfText(code, "lt_", 0);
    if nextLite < 0 and nextLt < 0 { return ""; }
    var nextQuote := textLib.indexOfText(code, "\"", 0);
    size := textLib.length(code);
    var bag := "";
    var cursor := 0;
    loop cursor < size {
        if nextLite >= 0 and nextLite < cursor { nextLite = textLib.indexOfText(code, "lite", cursor); }
        if nextLt >= 0 and nextLt < cursor { nextLt = textLib.indexOfText(code, "lt_", cursor); }
        var hit := -1;
        if nextLite >= 0 and (nextLt < 0 or nextLite < nextLt) {
            hit = nextLite;
        } else if nextLt >= 0 {
            hit = nextLt;
        }
        if hit < 0 { return bag; }
        if nextQuote >= 0 and nextQuote < hit {
            if nextQuote < cursor { nextQuote = textLib.indexOfText(code, "\"", cursor); }
            if nextQuote >= 0 and nextQuote < hit {
                cursor = skipAliasString(code, nextQuote);
                continue;
            }
        }
        if hit > 0 {
            prev := textLib.at(code, hit - 1);
            if prev == "$" or textLib.isNameContinue(prev) {
                cursor = textLib.skipName(code, hit + 3);
                loop cursor < size and textLib.at(code, cursor) == "$" {
                    cursor = textLib.skipName(code, cursor + 1);
                }
                continue;
            }
        }
        var endPos := textLib.skipName(code, hit);
        loop endPos < size and textLib.at(code, endPos) == "$" {
            endPos = textLib.skipName(code, endPos + 1);
        }
        tok := textLib.slice(code, hit, endPos);
        matchedDecl := findDeclInBlockChain(tok, startBlockId, parentBlockIds, declRuntimes, declBlockIds, declCount);
        if matchedDecl >= 0 {
            bag = appendPipeBag(bag, integer.intText(declIdxs[matchedDecl]));
        }
        cursor = endPos;
    }
    bag
}

/** Merges every index token in pipe-delimited `links` into `bag` without duplicates. */
mergeIndexPipeBag := fn(bag: String, links: String): String {
    if links == "" { return bag; }
    var out := bag;
    len := textLib.length(links);
    var pos := 0;
    loop pos < len {
        if textLib.at(links, pos) == "|" {
            pos = pos + 1;
            continue;
        }
        nextBar := textLib.indexOfText(links, "|", pos);
        endPos := if nextBar < 0 { len } else { nextBar };
        if endPos > pos {
            out = appendPipeBag(out, textLib.slice(links, pos, endPos));
        }
        pos = endPos + 1;
    }
    out
}

/** Eliminates dead pure locals, pure discarded expressions, and resulting empty scopes per lexical block (supporting forward same-block references). */
pruneBlockScopedItems := fn(items: Items, target: String): Items {
    var total := 0;
    loop items { total = total + 1; }
    if total == 0 { return items; }
    var hasPrunable := false;
    blockStack: mut List<Int> = [0];
    var stackLen := 1;
    parentBlockIds: mut List<Int> = [-1];
    var nextBlockId := 1;
    declRuntimes: mut List<String> = [];
    declBlockIds: mut List<Int> = [];
    declIdxs: mut List<Int> = [];
    declPrunables: mut List<Bool> = [];
    var declCount := 0;
    itemEvalBlocks: mut List<Int> = [];
    itemOwners: mut List<Int> = [];
    var idx := 0;
    loop idx < total {
        item := items[idx];
        curBlockId := blockStack[stackLen - 1];
        var evalBlockId := curBlockId;
        var owner := -1;
        if item.kind == "ElseIf" or item.kind == "Else" {
            if stackLen > 1 {
                _popArm := listLib.popBack(mut blockStack);
                stackLen = stackLen - 1;
            }
            parentId := blockStack[stackLen - 1];
            evalBlockId = parentId;
            newArmId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            listLib.pushBack(mut parentBlockIds, parentId);
            listLib.pushBack(mut blockStack, newArmId);
            stackLen = stackLen + 1;
        } else if item.kind == "EndScope" or item.kind == "EndIf" or item.kind == "EndLoop" or item.kind == "FunctionEnd" {
            if stackLen > 1 {
                _popEnd := listLib.popBack(mut blockStack);
                stackLen = stackLen - 1;
            }
        } else if item.kind == "Scope" or item.kind == "FunctionStart" or
        item.kind == "If" or item.kind == "Loop" or item.kind == "LoopSeq" {
            newBlockId := nextBlockId;
            nextBlockId = nextBlockId + 1;
            listLib.pushBack(mut parentBlockIds, curBlockId);
            listLib.pushBack(mut blockStack, newBlockId);
            stackLen = stackLen + 1;
            if item.kind == "LoopSeq" and item.runtime =!= "" {
                listLib.pushBack(mut declRuntimes, item.runtime);
                listLib.pushBack(mut declBlockIds, newBlockId);
                listLib.pushBack(mut declIdxs, idx);
                listLib.pushBack(mut declPrunables, false);
                declCount = declCount + 1;
            }
        } else if item.kind == "Discard" {
            if (target == "ts" or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code) {
                owner = -2;
                hasPrunable = true;
            }
        } else if evalBlockId > 0 and isTopDeclKind(item.kind) and item.runtime =!= "" {
            canPruneDecl := (target == "ts" or not isCUnsupportedItem(item)) and isSideEffectFreeCode(target, item.code);
            if canPruneDecl {
                owner = idx;
                hasPrunable = true;
            }
            listLib.pushBack(mut declRuntimes, item.runtime);
            listLib.pushBack(mut declBlockIds, evalBlockId);
            listLib.pushBack(mut declIdxs, idx);
            listLib.pushBack(mut declPrunables, canPruneDecl);
            declCount = declCount + 1;
        }
        listLib.pushBack(mut itemEvalBlocks, evalBlockId);
        listLib.pushBack(mut itemOwners, owner);
        idx = idx + 1;
    }
    if not hasPrunable { return items; }

    resolvedOwners: mut List<Int> = [];
    itemDeps: mut List<String> = [];
    var idx2 := 0;
    loop idx2 < total {
        item := items[idx2];
        evalBlock := itemEvalBlocks[idx2];
        var owner2 := itemOwners[idx2];
        var deps := "";
        if owner2 == -2 {
            deps = "";
        } else if evalBlock > 0 and textLib.startsWithAt(item.kind, 0, "Assign") and item.runtime =!= "" {
            matchedDecl := findDeclInBlockChain(item.runtime, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declCount);
            if matchedDecl >= 0 and declPrunables[matchedDecl] and (target == "ts" or not isCUnsupportedItem(item)) and
            isSideEffectFreeCode(target, item.code) {
                owner2 = declIdxs[matchedDecl];
                deps = resolveBlockLexicalDeps(item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
            } else {
                deps = resolveBlockLexicalDeps(item.runtime + " " + item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
            }
        } else {
            deps = resolveBlockLexicalDeps(item.code, evalBlock, parentBlockIds, declRuntimes, declBlockIds, declIdxs, declCount);
        }
        listLib.pushBack(mut resolvedOwners, owner2);
        listLib.pushBack(mut itemDeps, deps);
        idx2 = idx2 + 1;
    }

    var liveDeclBag := "";
    var seedIdx := 0;
    loop seedIdx < total {
        if resolvedOwners[seedIdx] == -1 {
            liveDeclBag = mergeIndexPipeBag(liveDeclBag, itemDeps[seedIdx]);
        }
        seedIdx = seedIdx + 1;
    }
    var scannedItemBag := "";
    loop true {
        beforeLen := textLib.length(liveDeclBag);
        var j := 0;
        loop j < total {
            own := resolvedOwners[j];
            if own >= 0 and tokenInPipeBag(liveDeclBag, integer.intText(own)) {
                key := integer.intText(j);
                if not tokenInPipeBag(scannedItemBag, key) {
                    scannedItemBag = appendPipeBag(scannedItemBag, key);
                    liveDeclBag = mergeIndexPipeBag(liveDeclBag, itemDeps[j]);
                }
            }
            j = j + 1;
        }
        if textLib.length(liveDeclBag) == beforeLen { break; }
    }

    peeled: mut Items = [];
    var peeledLen := 0;
    var k := 0;
    loop k < total {
        ownk := resolvedOwners[k];
        keepItem := ownk == -1 or (ownk >= 0 and tokenInPipeBag(liveDeclBag, integer.intText(ownk)));
        if keepItem {
            cur := items[k];
            if cur.kind == "EndScope" and peeledLen > 0 and peeled[peeledLen - 1].kind == "Scope" {
                _dropScope := listLib.popBack(mut peeled);
                peeledLen = peeledLen - 1;
            } else {
                listLib.pushBack(mut peeled, cur);
                peeledLen = peeledLen + 1;
            }
        }
        k = k + 1;
    }
    peeled
}

/** Finds the index of the function matching `runtime` in `functions`, or -1. */
findFunctionByRuntime := fn(functions: List<FunctionInfo>, runtime: String): Int {
    var i := 0;
    loop functions as info {
        if info.runtime == runtime { return i; }
        i = i + 1;
    }
    -1
}

/** Finds the latest `FutureValue` matching `runtime`, or -1. */
findFutureByRuntime := fn(futureValues: List<FutureValue>, runtime: String): Int {
    var i := 0;
    var found := -1;
    loop futureValues as fut {
        if fut.runtime == runtime { found = i; }
        i = i + 1;
    }
    found
}

/** Finds the position just after the closing `}` matching `{` at `openPos` in emitted TS code, or -1 if unclosed. */
scanCodeBraceEnd := fn(code: String, openPos: Int): Int {
    len := textLib.length(code);
    if openPos < 0 or openPos >= len or textLib.at(code, openPos) =!= "{" { return -1; }
    var p := openPos + 1;
    var depth := 1;
    loop p < len {
        ch := textLib.at(code, p);
        if ch == "\"" {
            p = skipCodeString(code, p);
        } else if ch == "{" {
            depth = depth + 1;
            p = p + 1;
        } else if ch == "}" {
            depth = depth - 1;
            p = p + 1;
            if depth == 0 { return p; }
        } else {
            p = p + 1;
        }
    }
    -1
}

/** Looks up all recorded `allBag` or `readBag` segments (`wantRead = true`) for `key` in `pairsText`. */
lookupPairsEntryBag := fn(pairsText: String, key: String, wantRead: Bool): String {
    if pairsText == "" or key == "" { return ""; }
    needle := "\n" + key + ":";
    pairsLen := textLib.length(pairsText);
    var result := "";
    var scanPos := 0;
    loop scanPos < pairsLen {
        hit := textLib.indexOfText(pairsText, needle, scanPos);
        if hit < 0 { break; }
        valStart := hit + textLib.length(needle);
        lineEnd := textLib.indexOfText(pairsText, "\n", valStart);
        nextEnd := if lineEnd >= 0 { lineEnd } else { pairsLen };
        tabPos := textLib.indexOfText(pairsText, "\t", valStart);
        var sliceStart := valStart;
        var sliceEnd := nextEnd;
        if tabPos >= 0 and tabPos < nextEnd {
            if wantRead { sliceStart = tabPos + 1; } else { sliceEnd = tabPos; }
        }
        if sliceEnd > sliceStart {
            result = mergePipeBags(result, textLib.slice(pairsText, sliceStart, sliceEnd));
        }
        scanPos = nextEnd;
    }
    result
}

/** True when `code` invokes runtime identifier `tok` via `tok(` or `(tok)(`. */
isTokenInvokedInCode := fn(code: String, tok: String): Bool {
    if code == "" or tok == "" { return false; }
    if textLib.indexOfText(code, tok, 0) < 0 { return false; }
    len := textLib.length(code);
    tokLen := textLib.length(tok);
    var pos := 0;
    loop pos < len {
        ch := textLib.at(code, pos);
        if ch == "\"" {
            pos = skipCodeString(code, pos);
            continue;
        }
        if textLib.startsWithAt(code, pos, tok) {
            beforeOk := pos == 0 or not isTraceIdentChar(textLib.at(code, pos - 1));
            afterTok := pos + tokLen;
            afterOk := afterTok >= len or not isTraceIdentChar(textLib.at(code, afterTok));
            if beforeOk and afterOk {
                var after := skipCodeSpaces(code, afterTok);
                if after < len and textLib.at(code, after) == "(" { return true; }
                loop after < len and textLib.at(code, after) == ")" {
                    after = skipCodeSpaces(code, after + 1);
                    if after < len and textLib.at(code, after) == "(" { return true; }
                }
            }
            pos = afterTok;
            continue;
        }
        pos = pos + 1;
    }
    false
}

/** Expands inner deferred `fn` calls from `rawBag` through `pairsText`, returning tokens minus `localDeclBag` and `writtenOuterBag`. */
expandInnerFnReadTokens := fn(rawBag: String, codeForInvoke: String, pairsText: String,
localDeclBag: String, writtenOuterBag: String): String {
    var outBag := "";
    if rawBag == "" { return outBag; }
    var seenPairs := "";
    innerQueue: mut List<String> = [];
    var qCount := 0;
    var pos := 0;
    len := textLib.length(rawBag);
    loop pos < len {
        if textLib.at(rawBag, pos) == "|" {
            sep := textLib.indexOfText(rawBag, "|", pos + 1);
            if sep > pos + 1 {
                tok := textLib.slice(rawBag, pos + 1, sep);
                if not tokenInPipeBag(localDeclBag, tok) and not tokenInPipeBag(writtenOuterBag, tok) {
                    outBag = appendPipeBag(outBag, tok);
                }
                if pairsText =!= "" and isTokenInvokedInCode(codeForInvoke, tok) and
                not tokenInPipeBag(seenPairs, tok) {
                    pairDeps := lookupPairsEntryBag(pairsText, tok, true);
                    if pairDeps =!= "" {
                        seenPairs = appendPipeBag(seenPairs, tok);
                        listLib.pushBack(mut innerQueue, tok);
                        qCount = qCount + 1;
                    }
                }
                pos = sep;
                continue;
            }
        }
        pos = pos + 1;
    }
    var qHead := 0;
    loop qHead < qCount {
        curFn := innerQueue[qHead];
        qHead = qHead + 1;
        deps := lookupPairsEntryBag(pairsText, curFn, true);
        var dp := 0;
        dLen := textLib.length(deps);
        loop dp < dLen {
            if textLib.at(deps, dp) == "|" {
                sep := textLib.indexOfText(deps, "|", dp + 1);
                if sep > dp + 1 {
                    dTok := textLib.slice(deps, dp + 1, sep);
                    if not tokenInPipeBag(localDeclBag, dTok) and not tokenInPipeBag(writtenOuterBag, dTok) {
                        outBag = appendPipeBag(outBag, dTok);
                    }
                    if pairsText =!= "" and not tokenInPipeBag(seenPairs, dTok) {
                        subDeps := lookupPairsEntryBag(pairsText, dTok, true);
                        if subDeps =!= "" {
                            seenPairs = appendPipeBag(seenPairs, dTok);
                            listLib.pushBack(mut innerQueue, dTok);
                            qCount = qCount + 1;
                        }
                    }
                    dp = sep;
                    continue;
                }
            }
            dp = dp + 1;
        }
    }
    outBag
}

/** Splits an emitted TS `(function ...)` literal into outer `allBag` references and `readBag` (outer tokens read before top-level unconditional write). */
extractFnLiteralDeps := fn(fnCode: String): (allBag: String, readBag: String) {
    len := textLib.length(fnCode);
    if not textLib.startsWithAt(fnCode, 0, "(function ") {
        toks := extractCodeRuntimeTokens(fnCode, false);
        return (allBag = toks, readBag = toks);
    }
    paramOpen := textLib.indexOfText(fnCode, "(", 1);
    if paramOpen < 0 {
        toks := extractCodeRuntimeTokens(fnCode, false);
        return (allBag = toks, readBag = toks);
    }
    paramClose := scanBalancedParenEnd(fnCode, paramOpen);
    if paramClose < 0 {
        toks := extractCodeRuntimeTokens(fnCode, false);
        return (allBag = toks, readBag = toks);
    }
    var localDeclBag := "";
    selfHeader := textLib.slice(fnCode, 10, paramOpen);
    if tokenStartsWithRuntimePrefix(selfHeader) {
        localDeclBag = appendPipeBag(localDeclBag, selfHeader);
    }
    var pCur := paramOpen + 1;
    var pDepth := 0;
    var expectParam := true;
    loop pCur < paramClose - 1 {
        pc := textLib.at(fnCode, pCur);
        if pc == "\"" {
            pCur = skipCodeString(fnCode, pCur);
            continue;
        }
        if pDepth == 0 and expectParam {
            pCur = skipCodeSpaces(fnCode, pCur);
            if pCur >= paramClose - 1 { break; }
            if textLib.isNameStart(textLib.at(fnCode, pCur)) or textLib.at(fnCode, pCur) == "$" {
                var pEnd := pCur;
                loop pEnd < paramClose - 1 and isTraceIdentChar(textLib.at(fnCode, pEnd)) { pEnd = pEnd + 1; }
                pTok := textLib.slice(fnCode, pCur, pEnd);
                if tokenStartsWithRuntimePrefix(pTok) { localDeclBag = appendPipeBag(localDeclBag, pTok); }
                expectParam = false;
                pCur = pEnd;
                continue;
            }
        }
        if pc == "(" or pc == "[" or pc == "{" {
            pDepth = pDepth + 1;
        } else if pc == ")" or pc == "]" or pc == "}" {
            if pDepth > 0 { pDepth = pDepth - 1; }
        } else if pc == "," and pDepth == 0 {
            expectParam = true;
        }
        pCur = pCur + 1;
    }
    var scan := paramClose;
    var rDepth := 0;
    var bodyOpen := -1;
    var bodyClose := -1;
    loop scan < len {
        sc := textLib.at(fnCode, scan);
        if sc == "\"" {
            scan = skipCodeString(fnCode, scan);
            continue;
        }
        if sc == "(" or sc == "[" { rDepth = rDepth + 1; }
        else if sc == ")" or sc == "]" { if rDepth > 0 { rDepth = rDepth - 1; } }
        else if sc == "{" and rDepth == 0 {
            candClose := scanCodeBraceEnd(fnCode, scan);
            if candClose < 0 { break; }
            afterCand := skipCodeSpaces(fnCode, candClose);
            if afterCand < len and textLib.at(fnCode, afterCand) == ")" and skipCodeSpaces(fnCode, afterCand + 1) >= len {
                bodyOpen = scan;
                bodyClose = candClose;
                break;
            }
            scan = candClose;
            continue;
        }
        scan = scan + 1;
    }
    if bodyOpen < 0 or bodyClose <= bodyOpen + 1 {
        toks := extractCodeRuntimeTokens(fnCode, false);
        return (allBag = toks, readBag = toks);
    }
    body := textLib.slice(fnCode, bodyOpen + 1, bodyClose - 1);
    bLen := textLib.length(body);
    var dPos := 0;
    loop dPos < bLen {
        dc := textLib.at(body, dPos);
        if dc == "\"" {
            dPos = skipCodeString(body, dPos);
            continue;
        }
        isDeclKw := ((dc == "c" and textLib.wordAt(body, dPos, "const")) or (dc == "l" and textLib.wordAt(body, dPos, "let"))) and
        (dPos == 0 or textLib.at(body, dPos - 1) =!= "$");
        if isDeclKw {
            kwLen := if dc == "c" { 5 } else { 3 };
            afterKw := skipCodeSpaces(body, dPos + kwLen);
            if afterKw < bLen and (textLib.isNameStart(textLib.at(body, afterKw)) or textLib.at(body, afterKw) == "$") {
                var idEnd := afterKw;
                loop idEnd < bLen and isTraceIdentChar(textLib.at(body, idEnd)) { idEnd = idEnd + 1; }
                idTok := textLib.slice(body, afterKw, idEnd);
                if tokenStartsWithRuntimePrefix(idTok) { localDeclBag = appendPipeBag(localDeclBag, idTok); }
                dPos = idEnd;
                continue;
            }
        }
        dPos = dPos + 1;
    }
    var allBag := "";
    rawAll := extractCodeRuntimeTokens(body, false);
    var aPos := 0;
    aLen := textLib.length(rawAll);
    loop aPos < aLen {
        if textLib.at(rawAll, aPos) == "|" {
            sep := textLib.indexOfText(rawAll, "|", aPos + 1);
            if sep > aPos + 1 {
                tok := textLib.slice(rawAll, aPos + 1, sep);
                if not tokenInPipeBag(localDeclBag, tok) {
                    allBag = appendPipeBag(allBag, tok);
                }
                aPos = sep;
                continue;
            }
        }
        aPos = aPos + 1;
    }
    var readBag := "";
    var writtenOuterBag := "";
    var innerPairs := "";
    var sPos := 0;
    loop sPos < bLen {
        sPos = skipCodeSpaces(body, sPos);
        if sPos >= bLen { break; }
        stmtStart := sPos;
        var isCompoundStmt := false;
        firstCh := textLib.at(body, stmtStart);
        if firstCh == "{" or
        ((firstCh == "i" and textLib.wordAt(body, stmtStart, "if")) or
        (firstCh == "w" and textLib.wordAt(body, stmtStart, "while")) or
        (firstCh == "f" and textLib.wordAt(body, stmtStart, "for")) or
        (firstCh == "t" and textLib.wordAt(body, stmtStart, "try"))) {
            isCompoundStmt = true;
        } else if textLib.startsWithAt(body, stmtStart, "lite$l") {
            var lblEnd := stmtStart;
            loop lblEnd < bLen and isTraceIdentChar(textLib.at(body, lblEnd)) { lblEnd = lblEnd + 1; }
            afterLbl := skipCodeSpaces(body, lblEnd);
            if afterLbl < bLen and textLib.at(body, afterLbl) == ":" { isCompoundStmt = true; }
        }
        var stmtEnd := sPos;
        var bDepth := 0;
        if isCompoundStmt {
            loop stmtEnd < bLen {
                bc := textLib.at(body, stmtEnd);
                if bc == "\"" {
                    stmtEnd = skipCodeString(body, stmtEnd);
                    continue;
                }
                if bc == "(" or bc == "[" or bc == "{" {
                    bDepth = bDepth + 1;
                    stmtEnd = stmtEnd + 1;
                } else if bc == ")" or bc == "]" {
                    if bDepth > 0 { bDepth = bDepth - 1; }
                    stmtEnd = stmtEnd + 1;
                } else if bc == "}" {
                    if bDepth > 0 { bDepth = bDepth - 1; }
                    stmtEnd = stmtEnd + 1;
                    if bDepth == 0 {
                        afterBlk := skipCodeSpaces(body, stmtEnd);
                        if not (textLib.wordAt(body, afterBlk, "else") or
                        textLib.wordAt(body, afterBlk, "catch") or
                        textLib.wordAt(body, afterBlk, "finally")) {
                            break;
                        }
                    }
                } else {
                    stmtEnd = stmtEnd + 1;
                }
            }
        } else {
            loop stmtEnd < bLen {
                bc := textLib.at(body, stmtEnd);
                if bc == "\"" {
                    stmtEnd = skipCodeString(body, stmtEnd);
                    continue;
                }
                if bc == "(" or bc == "[" or bc == "{" {
                    bDepth = bDepth + 1;
                } else if bc == ")" or bc == "]" or bc == "}" {
                    if bDepth > 0 { bDepth = bDepth - 1; }
                } else if bc == ";" and bDepth == 0 {
                    stmtEnd = stmtEnd + 1;
                    break;
                }
                stmtEnd = stmtEnd + 1;
            }
        }
        stmt := textLib.slice(body, stmtStart, stmtEnd);
        sPos = stmtEnd;
        if firstCh == "v" and textLib.wordAt(stmt, 0, "void") {
            afterVoid := skipCodeSpaces(stmt, 4);
            if afterVoid < textLib.length(stmt) and isTraceIdentChar(textLib.at(stmt, afterVoid)) {
                var vEnd := afterVoid;
                loop vEnd < textLib.length(stmt) and isTraceIdentChar(textLib.at(stmt, vEnd)) { vEnd = vEnd + 1; }
                afterVId := skipCodeSpaces(stmt, vEnd);
                if afterVId < textLib.length(stmt) and textLib.at(stmt, afterVId) == ";" {
                    continue;
                }
            }
        }
        stStripped := stripDeferredFnBodies(stmt);
        if stStripped.pairsText =!= "" {
            innerPairs = if innerPairs == "" { stStripped.pairsText }
            else { innerPairs + textLib.slice(stStripped.pairsText, 1, textLib.length(stStripped.pairsText)) };
        }
        var assignedOuter := "";
        var assignRhs := "";
        if not isCompoundStmt and (textLib.isNameStart(firstCh) or firstCh == "$") {
            stLen := textLib.length(stmt);
            var idEnd := 0;
            loop idEnd < stLen and isTraceIdentChar(textLib.at(stmt, idEnd)) { idEnd = idEnd + 1; }
            candLhs := textLib.slice(stmt, 0, idEnd);
            if tokenStartsWithRuntimePrefix(candLhs) and not tokenInPipeBag(localDeclBag, candLhs) {
                eqPos := skipCodeSpaces(stmt, idEnd);
                if eqPos < stLen and textLib.at(stmt, eqPos) == "=" and
                not textLib.startsWithAt(stmt, eqPos, "==") and not textLib.startsWithAt(stmt, eqPos, "=>") {
                    assignedOuter = candLhs;
                    strippedLen := textLib.length(stStripped.code);
                    var sEq := skipCodeSpaces(stStripped.code, idEnd);
                    if sEq < strippedLen and textLib.at(stStripped.code, sEq) == "=" {
                        assignRhs = textLib.slice(stStripped.code, sEq + 1, strippedLen);
                    }
                }
            }
        }
        if assignedOuter =!= "" {
            rhsToks := extractCodeRuntimeTokens(assignRhs, false);
            expanded := expandInnerFnReadTokens(rhsToks, assignRhs, innerPairs, localDeclBag, writtenOuterBag);
            readBag = mergePipeBags(readBag, expanded);
            writtenOuterBag = appendPipeBag(writtenOuterBag, assignedOuter);
        } else {
            stmtToks := extractCodeRuntimeTokens(stStripped.code, true);
            expanded := expandInnerFnReadTokens(stmtToks, stStripped.code, innerPairs, localDeclBag, writtenOuterBag);
            readBag = mergePipeBags(readBag, expanded);
        }
    }
    (allBag = allBag, readBag = readBag)
}

/** Extracts `allBag` and `readBag` from an arbitrary TS expression, decomposing `(function ...)` literals into exact `readBag`s. */
extractExprDepsPair := fn(exprCode: String, skipLhsDecls: Bool): (allBag: String, readBag: String) {
    if exprCode == "" { return (allBag = "", readBag = ""); }
    allBag := extractCodeRuntimeTokens(exprCode, skipLhsDecls);
    var readBag := "";
    outerParts: mut List<String> = [];
    len := textLib.length(exprCode);
    var sliceStart := 0;
    var pos := 0;
    loop pos < len {
        ch := textLib.at(exprCode, pos);
        if ch == "\"" {
            pos = skipCodeString(exprCode, pos);
            continue;
        }
        if ch == "(" and textLib.startsWithAt(exprCode, pos, "(function ") {
            fnEnd := scanBalancedParenEnd(exprCode, pos);
            if fnEnd >= 0 {
                fnDeps := extractFnLiteralDeps(textLib.slice(exprCode, pos, fnEnd));
                readBag = mergePipeBags(readBag, fnDeps.readBag);
                listLib.pushBack(mut outerParts, textLib.slice(exprCode, sliceStart, pos));
                listLib.pushBack(mut outerParts, "0");
                sliceStart = fnEnd;
                pos = fnEnd;
                continue;
            }
        }
        pos = pos + 1;
    }
    listLib.pushBack(mut outerParts, textLib.slice(exprCode, sliceStart, len));
    outerTokens := extractCodeRuntimeTokens(textLib.joinTexts(outerParts, ""), skipLhsDecls);
    readBag = mergePipeBags(readBag, outerTokens);
    (allBag = allBag, readBag = readBag)
}

/** Encodes `"allBag\nreadBag"` for storing on a `containsFnKind` local binding's `code` field. */
computeCallableRhsDeps := fn(rhsCode: String): String {
    if rhsCode == "" { return ""; }
    trimmedStart := skipCodeSpaces(rhsCode, 0);
    len := textLib.length(rhsCode);
    if trimmedStart < len and textLib.startsWithAt(rhsCode, trimmedStart, "(function ") {
        fnEnd := scanBalancedParenEnd(rhsCode, trimmedStart);
        if fnEnd >= 0 and skipCodeSpaces(rhsCode, fnEnd) >= len {
            d := extractFnLiteralDeps(textLib.slice(rhsCode, trimmedStart, fnEnd));
            return d.allBag + "\n" + d.readBag;
        }
    }
    p := extractExprDepsPair(rhsCode, false);
    p.allBag + "\n" + p.readBag
}

/** Propagates outer `equals` and `List.push`/`unshift` updates from emitted block/branch/loop JS `code` onto active `locals`. */
mergeOuterCallableUpdatesFromCode := fn(locals: List<Local>, code: String): List<Local> {
    if code == "" { return locals; }
    var hasCallable := false;
    loop locals as l {
        if l.depth >= -1 and (containsFnKind(l.kind) or l.name == "$tuple") {
            hasCallable = true;
            break;
        }
    }
    if not hasCallable { return locals; }
    nextLocals: mut List<Local> = [];
    loop locals as l { listLib.pushBack(mut nextLocals, l); }
    stripped := stripDeferredFnBodies(code);
    if stripped.pairsText =!= "" {
        pairsLen := textLib.length(stripped.pairsText);
        var pCur := 0;
        loop pCur < pairsLen {
            if textLib.at(stripped.pairsText, pCur) == "\n" {
                pCur = pCur + 1;
                continue;
            }
            colonPos := textLib.indexOfText(stripped.pairsText, ":", pCur);
            if colonPos < 0 { break; }
            nlPos := textLib.indexOfText(stripped.pairsText, "\n", colonPos + 1);
            lineEnd := if nlPos < 0 { pairsLen } else { nlPos };
            lhsRt := textLib.slice(stripped.pairsText, pCur, colonPos);
            actIdx := latestActiveLocalByRuntime(nextLocals, lhsRt);
            if actIdx >= 0 and (containsFnKind(nextLocals[actIdx].kind) or nextLocals[actIdx].name == "$tuple") {
                tabPos := textLib.indexOfText(stripped.pairsText, "\t", colonPos + 1);
                var depEncoded := "";
                if tabPos >= 0 and tabPos < lineEnd {
                    depEncoded = textLib.slice(stripped.pairsText, colonPos + 1, tabPos) + "\n" +
                    textLib.slice(stripped.pairsText, tabPos + 1, lineEnd);
                } else {
                    rawToks := textLib.slice(stripped.pairsText, colonPos + 1, lineEnd);
                    depEncoded = rawToks + "\n" + rawToks;
                }
                entry := nextLocals[actIdx];
                merged := mergeCallableLocalDeps(entry.code, depEncoded);
                if merged =!= entry.code {
                    listLib.pushBack(mut nextLocals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                    mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false,
                    code = merged, intValue = 0, textValue = "", initState = entry.initState));
                }
            }
            pCur = lineEnd + 1;
        }
    }
    codeLen := textLib.length(code);
    if textLib.indexOfText(code, ".push(", 0) >= 0 or textLib.indexOfText(code, ".unshift(", 0) >= 0 {
        var pos := 0;
        loop pos < codeLen {
            ch := textLib.at(code, pos);
            if ch == "\"" { pos = skipCodeString(code, pos); continue; }
            if textLib.startsWithAt(code, pos, "lite_") {
                var tokEnd := pos;
                loop tokEnd < codeLen and isTraceIdentChar(textLib.at(code, tokEnd)) { tokEnd = tokEnd + 1; }
                tok := textLib.slice(code, pos, tokEnd);
                afterTok := skipCodeSpaces(code, tokEnd);
                if afterTok < codeLen and textLib.at(code, afterTok) == "." {
                    mStart := skipCodeSpaces(code, afterTok + 1);
                    isPush := textLib.wordAt(code, mStart, "push") or textLib.wordAt(code, mStart, "unshift");
                    if isPush {
                        mLen := if textLib.wordAt(code, mStart, "push") { 4 } else { 7 };
                        openP := skipCodeSpaces(code, mStart + mLen);
                        if openP < codeLen and textLib.at(code, openP) == "(" {
                            closeP := scanBalancedParenEnd(code, openP);
                            if closeP >= 0 {
                                actIdx := latestActiveLocalByRuntime(nextLocals, tok);
                                if actIdx >= 0 and isListKind(nextLocals[actIdx].kind) and containsFnKind(nextLocals[actIdx].kind) {
                                    argsSlice := textLib.slice(code, openP + 1, closeP - 1);
                                    entry := nextLocals[actIdx];
                                    merged := mergeCallableLocalDeps(entry.code, computeCallableRhsDeps(argsSlice));
                                    if merged =!= entry.code {
                                        listLib.pushBack(mut nextLocals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                                        mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false,
                                        code = merged, intValue = 0, textValue = "", initState = entry.initState));
                                    }
                                }
                            }
                        }
                    }
                }
                pos = tokEnd;
                continue;
            }
            pos = pos + 1;
        }
    }
    sCode := stripped.code;
    sLen := textLib.length(sCode);
    var sp := 0;
    loop sp < sLen {
        sc := textLib.at(sCode, sp);
        if sc == "\"" { sp = skipCodeString(sCode, sp); continue; }
        if textLib.startsWithAt(sCode, sp, "lite_") {
            beforeOk := sp == 0 or not (isTraceIdentChar(textLib.at(sCode, sp - 1)) or textLib.at(sCode, sp - 1) == ".");
            var tokEnd := sp;
            loop tokEnd < sLen and isTraceIdentChar(textLib.at(sCode, tokEnd)) { tokEnd = tokEnd + 1; }
            if beforeOk {
                tok := textLib.slice(sCode, sp, tokEnd);
                afterTok := skipCodeSpaces(sCode, tokEnd);
                if afterTok < sLen and textLib.at(sCode, afterTok) == "=" and
                not textLib.startsWithAt(sCode, afterTok, "==") and not textLib.startsWithAt(sCode, afterTok, "=>") {
                    var preEnd := sp - 1;
                    loop preEnd >= 0 {
                        pc := textLib.at(sCode, preEnd);
                        if pc == " " or pc == "\t" or pc == "\n" or pc == "\r" { preEnd = preEnd - 1; } else { break; }
                    }
                    isDeclAssign := (preEnd >= 4 and textLib.slice(sCode, preEnd - 4, preEnd + 1) == "const" and
                    (preEnd == 4 or not isTraceIdentChar(textLib.at(sCode, preEnd - 5)))) or
                    (preEnd >= 2 and textLib.slice(sCode, preEnd - 2, preEnd + 1) == "let" and
                    (preEnd == 2 or not isTraceIdentChar(textLib.at(sCode, preEnd - 3))));
                    if not isDeclAssign {
                        actIdx := latestActiveLocalByRuntime(nextLocals, tok);
                        if actIdx >= 0 and containsFnKind(nextLocals[actIdx].kind) {
                            var rhsEnd := afterTok + 1;
                            var bDepth := 0;
                            loop rhsEnd < sLen {
                                rc := textLib.at(sCode, rhsEnd);
                                if rc == "\"" { rhsEnd = skipCodeString(sCode, rhsEnd); continue; }
                                if rc == "(" or rc == "[" or rc == "{" { bDepth = bDepth + 1; }
                                else if rc == ")" or rc == "]" or rc == "}" {
                                    if bDepth == 0 { break; }
                                    bDepth = bDepth - 1;
                                } else if rc == ";" and bDepth == 0 {
                                    break;
                                }
                                rhsEnd = rhsEnd + 1;
                            }
                            rhsSlice := textLib.slice(sCode, afterTok + 1, rhsEnd);
                            entry := nextLocals[actIdx];
                            merged := mergeCallableLocalDeps(entry.code, computeCallableRhsDeps(rhsSlice));
                            if merged =!= entry.code {
                                listLib.pushBack(mut nextLocals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                                mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false,
                                code = merged, intValue = 0, textValue = "", initState = entry.initState));
                            }
                        }
                    }
                }
            }
            sp = tokEnd;
            continue;
        }
        sp = sp + 1;
    }
    nextLocals
}

/** Extracts `"|lite_p1|lite_p2|"` parameter runtimes from a `FunctionStart` `textValue` payload. */
parseParamRuntimesList := fn(paramsPayload: String): String {
    var bag := "";
    if paramsPayload == "" { return bag; }
    len := textLib.length(paramsPayload);
    var start := 0;
    loop start < len {
        sep := textLib.indexOfText(paramsPayload, "|", start);
        end := if sep >= 0 { sep } else { len };
        entry := textLib.slice(paramsPayload, start, end);
        eqPos := textLib.indexOfText(entry, "=", 0);
        if eqPos > 0 {
            bag = appendPipeBag(bag, "lite_" + textLib.slice(entry, 0, eqPos));
        }
        start = end + 1;
    }
    bag
}

/** Finds the `FunctionStart` item index matching `runtime`, or -1 when absent. */
findFunctionStartItem := fn(items: Items, runtime: String): Int {
    var i := 0;
    loop items as item {
        if item.kind == "FunctionStart" and item.runtime == runtime { return i; }
        i = i + 1;
    }
    -1
}

/** Enforces execution-trace ordering and initialization safety across root and inner blocks before referenced bindings initialize. */
checkTraceSafety := fn(source: String, stmtAt: Int, prefix: String, exprCode: String, currentName: String, maxFutureAt: Int,
locals: List<Local>, functions: List<FunctionInfo>, futureValues: List<FutureValue>, items: Items): Unit {
    if exprCode == "" { return; }
    if (currentName =!= "" or stmtAt >= maxFutureAt) and not localsHasAnyUnready(locals) { return; }
    stripped := stripDeferredFnBodies(exprCode);
    eagerCode := stripped.code;
    if not hasUserOrLocalCall(eagerCode) { return; }
    seedPair := extractExprDepsPair(eagerCode, true);
    if seedPair.allBag == "" and seedPair.readBag == "" { return; }

    var totalItems := 0;
    loop items { totalItems = totalItems + 1; }

    allQueue: mut List<String> = [];
    var allVisitedBag := "";
    var allCount := 0;
    var aSeedPos := 0;
    aSeedLen := textLib.length(seedPair.allBag);
    loop aSeedPos < aSeedLen {
        if textLib.at(seedPair.allBag, aSeedPos) == "|" {
            sep := textLib.indexOfText(seedPair.allBag, "|", aSeedPos + 1);
            if sep > aSeedPos + 1 {
                tok := textLib.slice(seedPair.allBag, aSeedPos + 1, sep);
                if not tokenInPipeBag(allVisitedBag, tok) {
                    allVisitedBag = appendPipeBag(allVisitedBag, tok);
                    listLib.pushBack(mut allQueue, tok);
                    allCount = allCount + 1;
                }
                aSeedPos = sep;
                continue;
            }
        }
        aSeedPos = aSeedPos + 1;
    }

    var allHead := 0;
    loop allHead < allCount {
        curTok := allQueue[allHead];
        allHead = allHead + 1;
        unreachedName := unreachedFutureLocalName(locals, curTok);
        if unreachedName =!= "" {
            failAt(source, stmtAt, prefix, "cannot call before " + unreachedName + " is initialized");
        }
        if currentName == "" {
            futIdx := findFutureByRuntime(futureValues, curTok);
            if futIdx >= 0 and futureValues[futIdx].at > stmtAt {
                failAt(source, stmtAt, prefix, "cannot call before " + futureValues[futIdx].name + " is initialized");
            }
        }
        pairAll := lookupPairsEntryBag(stripped.pairsText, curTok, false);
        if pairAll =!= "" {
            var k := 0;
            pLen := textLib.length(pairAll);
            loop k < pLen {
                if textLib.at(pairAll, k) == "|" {
                    sep := textLib.indexOfText(pairAll, "|", k + 1);
                    if sep > k + 1 {
                        depTok := textLib.slice(pairAll, k + 1, sep);
                        if not tokenInPipeBag(allVisitedBag, depTok) {
                            allVisitedBag = appendPipeBag(allVisitedBag, depTok);
                            listLib.pushBack(mut allQueue, depTok);
                            allCount = allCount + 1;
                        }
                        k = sep;
                        continue;
                    }
                }
                k = k + 1;
            }
        }
        fnIdx := findFunctionByRuntime(functions, curTok);
        if fnIdx >= 0 {
            fnInfo := functions[fnIdx];
            if currentName == "" and fnInfo.declAt > stmtAt {
                failAt(source, stmtAt, prefix, "cannot call before " + fnInfo.name + " is initialized");
            }
            if currentName == "" {
                startItem := findFunctionStartItem(items, curTok);
                if startItem >= 0 {
                    paramBag := parseParamRuntimesList(items[startItem].textValue);
                    var scopeDepth := 0;
                    localShadowRuntimes: mut List<String> = [];
                    localShadowDepths: mut List<Int> = [];
                    var itIdx := startItem + 1;
                    loop itIdx < totalItems {
                        it := items[itIdx];
                        if it.kind == "FunctionEnd" and it.runtime == curTok { break; }
                        if it.kind == "If" or it.kind == "Loop" or it.kind == "LoopSeq" or it.kind == "Scope" {
                            scopeDepth = scopeDepth + 1;
                        } else if it.kind == "Else" or it.kind == "ElseIf" or
                        it.kind == "EndIf" or it.kind == "EndLoop" or it.kind == "EndScope" {
                            var keepCnt := 0;
                            loop localShadowDepths as sd {
                                if sd < scopeDepth { keepCnt = keepCnt + 1; } else { break; }
                            }
                            var curCnt := 0;
                            loop localShadowRuntimes { curCnt = curCnt + 1; }
                            loop curCnt > keepCnt {
                                _d1 := listLib.popBack(mut localShadowRuntimes);
                                _d2 := listLib.popBack(mut localShadowDepths);
                                curCnt = curCnt - 1;
                            }
                            if (it.kind == "EndIf" or it.kind == "EndLoop" or it.kind == "EndScope") and scopeDepth > 0 {
                                scopeDepth = scopeDepth - 1;
                            }
                        }
                        if it.code =!= "" {
                            itTokens := extractCodeRuntimeTokens(it.code, true);
                            var ik := 0;
                            itLen := textLib.length(itTokens);
                            loop ik < itLen {
                                if textLib.at(itTokens, ik) == "|" {
                                    sep := textLib.indexOfText(itTokens, "|", ik + 1);
                                    if sep > ik + 1 {
                                        depTok := textLib.slice(itTokens, ik + 1, sep);
                                        if not tokenInPipeBag(paramBag, depTok) and
                                        not listLib.listContainsText(localShadowRuntimes, depTok) {
                                            if not tokenInPipeBag(allVisitedBag, depTok) {
                                                allVisitedBag = appendPipeBag(allVisitedBag, depTok);
                                                listLib.pushBack(mut allQueue, depTok);
                                                allCount = allCount + 1;
                                            }
                                        }
                                        ik = sep;
                                        continue;
                                    }
                                }
                                ik = ik + 1;
                            }
                        }
                        if (textLib.startsWithAt(it.kind, 0, "Local") or textLib.startsWithAt(it.kind, 0, "Var")) and it.runtime =!= "" {
                            if not listLib.listContainsText(localShadowRuntimes, it.runtime) {
                                listLib.pushBack(mut localShadowRuntimes, it.runtime);
                                listLib.pushBack(mut localShadowDepths, scopeDepth);
                            }
                        } else if textLib.startsWithAt(it.kind, 0, "Assign") and it.runtime =!= "" {
                            if not tokenInPipeBag(paramBag, it.runtime) and not listLib.listContainsText(localShadowRuntimes, it.runtime) {
                                assignUnreached := unreachedFutureLocalName(locals, it.runtime);
                                if assignUnreached =!= "" {
                                    failAt(source, stmtAt, prefix, "cannot call before " + assignUnreached + " is initialized");
                                }
                                assignFutIdx := findFutureByRuntime(futureValues, it.runtime);
                                if assignFutIdx >= 0 and futureValues[assignFutIdx].at > stmtAt {
                                    failAt(source, stmtAt, prefix, "cannot call before " + futureValues[assignFutIdx].name + " is initialized");
                                }
                            }
                        }
                        itIdx = itIdx + 1;
                    }
                }
            }
        }
        actIdx := latestActiveLocalByRuntime(locals, curTok);
        if actIdx >= 0 and (containsFnKind(locals[actIdx].kind) or locals[actIdx].name == "$tuple") and locals[actIdx].code =!= "" {
            varDepsAll := fnDepsAll(locals[actIdx].code);
            var dk := 0;
            dLen := textLib.length(varDepsAll);
            loop dk < dLen {
                if textLib.at(varDepsAll, dk) == "|" {
                    sep := textLib.indexOfText(varDepsAll, "|", dk + 1);
                    if sep > dk + 1 {
                        depTok := textLib.slice(varDepsAll, dk + 1, sep);
                        if not tokenInPipeBag(allVisitedBag, depTok) {
                            allVisitedBag = appendPipeBag(allVisitedBag, depTok);
                            listLib.pushBack(mut allQueue, depTok);
                            allCount = allCount + 1;
                        }
                        dk = sep;
                        continue;
                    }
                }
                dk = dk + 1;
            }
        }
    }

    readQueue: mut List<String> = [];
    var readVisitedBag := "";
    var readCount := 0;
    var rSeedPos := 0;
    rSeedLen := textLib.length(seedPair.readBag);
    loop rSeedPos < rSeedLen {
        if textLib.at(seedPair.readBag, rSeedPos) == "|" {
            sep := textLib.indexOfText(seedPair.readBag, "|", rSeedPos + 1);
            if sep > rSeedPos + 1 {
                tok := textLib.slice(seedPair.readBag, rSeedPos + 1, sep);
                if not tokenInPipeBag(readVisitedBag, tok) {
                    readVisitedBag = appendPipeBag(readVisitedBag, tok);
                    listLib.pushBack(mut readQueue, tok);
                    readCount = readCount + 1;
                }
                rSeedPos = sep;
                continue;
            }
        }
        rSeedPos = rSeedPos + 1;
    }

    var rHead := 0;
    loop rHead < readCount {
        curTok := readQueue[rHead];
        rHead = rHead + 1;
        actIdx := latestActiveLocalByRuntime(locals, curTok);
        if actIdx >= 0 and locals[actIdx].depth >= 0 and locals[actIdx].initState =!= INIT_STATE_INIT {
            failAt(source, stmtAt, prefix, "cannot call before " + locals[actIdx].name + " is initialized");
        }
        pairRead := lookupPairsEntryBag(stripped.pairsText, curTok, true);
        if pairRead =!= "" {
            var rk := 0;
            prLen := textLib.length(pairRead);
            loop rk < prLen {
                if textLib.at(pairRead, rk) == "|" {
                    sep := textLib.indexOfText(pairRead, "|", rk + 1);
                    if sep > rk + 1 {
                        depTok := textLib.slice(pairRead, rk + 1, sep);
                        if not tokenInPipeBag(readVisitedBag, depTok) {
                            readVisitedBag = appendPipeBag(readVisitedBag, depTok);
                            listLib.pushBack(mut readQueue, depTok);
                            readCount = readCount + 1;
                        }
                        rk = sep;
                        continue;
                    }
                }
                rk = rk + 1;
            }
        }
        if currentName == "" {
            fnIdx := findFunctionByRuntime(functions, curTok);
            if fnIdx >= 0 {
                startItem := findFunctionStartItem(items, curTok);
                if startItem >= 0 {
                    paramBag := parseParamRuntimesList(items[startItem].textValue);
                    var bodyBranchDepth := 0;
                    var scopeDepth := 0;
                    localShadowRuntimes: mut List<String> = [];
                    localShadowDepths: mut List<Int> = [];
                    var defWrittenBag := "";
                    var itIdx := startItem + 1;
                    loop itIdx < totalItems {
                        it := items[itIdx];
                        if it.kind == "FunctionEnd" and it.runtime == curTok { break; }
                        if it.kind == "If" or it.kind == "Loop" or it.kind == "LoopSeq" {
                            bodyBranchDepth = bodyBranchDepth + 1;
                            scopeDepth = scopeDepth + 1;
                        } else if it.kind == "Scope" {
                            scopeDepth = scopeDepth + 1;
                        } else if it.kind == "Else" or it.kind == "ElseIf" {
                            var keepCnt := 0;
                            loop localShadowDepths as sd {
                                if sd < scopeDepth { keepCnt = keepCnt + 1; } else { break; }
                            }
                            var curCnt := 0;
                            loop localShadowRuntimes { curCnt = curCnt + 1; }
                            loop curCnt > keepCnt {
                                _d1 := listLib.popBack(mut localShadowRuntimes);
                                _d2 := listLib.popBack(mut localShadowDepths);
                                curCnt = curCnt - 1;
                            }
                        } else if it.kind == "EndIf" or it.kind == "EndLoop" {
                            var keepCnt := 0;
                            loop localShadowDepths as sd {
                                if sd < scopeDepth { keepCnt = keepCnt + 1; } else { break; }
                            }
                            var curCnt := 0;
                            loop localShadowRuntimes { curCnt = curCnt + 1; }
                            loop curCnt > keepCnt {
                                _d1 := listLib.popBack(mut localShadowRuntimes);
                                _d2 := listLib.popBack(mut localShadowDepths);
                                curCnt = curCnt - 1;
                            }
                            if scopeDepth > 0 { scopeDepth = scopeDepth - 1; }
                            if bodyBranchDepth > 0 { bodyBranchDepth = bodyBranchDepth - 1; }
                        } else if it.kind == "EndScope" {
                            var keepCnt := 0;
                            loop localShadowDepths as sd {
                                if sd < scopeDepth { keepCnt = keepCnt + 1; } else { break; }
                            }
                            var curCnt := 0;
                            loop localShadowRuntimes { curCnt = curCnt + 1; }
                            loop curCnt > keepCnt {
                                _d1 := listLib.popBack(mut localShadowRuntimes);
                                _d2 := listLib.popBack(mut localShadowDepths);
                                curCnt = curCnt - 1;
                            }
                            if scopeDepth > 0 { scopeDepth = scopeDepth - 1; }
                        }
                        if it.code =!= "" {
                            itStripped := stripDeferredFnBodies(it.code);
                            itReadPair := extractExprDepsPair(itStripped.code, true);
                            itReadToks := itReadPair.readBag;
                            var ik := 0;
                            itLen := textLib.length(itReadToks);
                            loop ik < itLen {
                                if textLib.at(itReadToks, ik) == "|" {
                                    sep := textLib.indexOfText(itReadToks, "|", ik + 1);
                                    if sep > ik + 1 {
                                        depTok := textLib.slice(itReadToks, ik + 1, sep);
                                        if not tokenInPipeBag(paramBag, depTok) and
                                        not listLib.listContainsText(localShadowRuntimes, depTok) and
                                        not tokenInPipeBag(defWrittenBag, depTok) {
                                            if not tokenInPipeBag(readVisitedBag, depTok) {
                                                readVisitedBag = appendPipeBag(readVisitedBag, depTok);
                                                listLib.pushBack(mut readQueue, depTok);
                                                readCount = readCount + 1;
                                            }
                                        }
                                        ik = sep;
                                        continue;
                                    }
                                }
                                ik = ik + 1;
                            }
                        }
                        if (textLib.startsWithAt(it.kind, 0, "Local") or textLib.startsWithAt(it.kind, 0, "Var")) and it.runtime =!= "" {
                            if not listLib.listContainsText(localShadowRuntimes, it.runtime) {
                                listLib.pushBack(mut localShadowRuntimes, it.runtime);
                                listLib.pushBack(mut localShadowDepths, scopeDepth);
                            }
                        } else if bodyBranchDepth == 0 and textLib.startsWithAt(it.kind, 0, "Assign") and it.runtime =!= "" {
                            if not tokenInPipeBag(paramBag, it.runtime) and not listLib.listContainsText(localShadowRuntimes, it.runtime) {
                                defWrittenBag = appendPipeBag(defWrittenBag, it.runtime);
                            }
                        }
                        itIdx = itIdx + 1;
                    }
                }
            }
        }
        if actIdx >= 0 and (containsFnKind(locals[actIdx].kind) or locals[actIdx].name == "$tuple") and locals[actIdx].code =!= "" {
            varDepsRead := fnDepsRead(locals[actIdx].code);
            var dk := 0;
            dLen := textLib.length(varDepsRead);
            loop dk < dLen {
                if textLib.at(varDepsRead, dk) == "|" {
                    sep := textLib.indexOfText(varDepsRead, "|", dk + 1);
                    if sep > dk + 1 {
                        depTok := textLib.slice(varDepsRead, dk + 1, sep);
                        if not tokenInPipeBag(readVisitedBag, depTok) {
                            readVisitedBag = appendPipeBag(readVisitedBag, depTok);
                            listLib.pushBack(mut readQueue, depTok);
                            readCount = readCount + 1;
                        }
                        dk = sep;
                        continue;
                    }
                }
                dk = dk + 1;
            }
        }
    }
}

/** Parses numeric lexical depth encoded in `ConstructCtx.iterLabel`, or returns `fallback`. */
parseLexDepthTag := fn(tag: String, fallback: Int): Int {
    len := textLib.length(tag);
    if len == 0 { return fallback; }
    var i := 0;
    loop i < len {
        if not textLib.isDigit(textLib.at(tag, i)) { return fallback; }
        i = i + 1;
    }
    parseDigits(tag, 0, len)
}

/** Rejects returning/breaking/continuing a function value that references uninitialized or skipped same-block symbols at `>= minExitedLexDepth`. */
checkEscapingFnSafety := fn(source: String, stmtAt: Int, prefix: String, rhsCode: String,
minExitedLexDepth: Int, locals: List<Local>): Unit {
    if rhsCode == "" or not localsHasAnyUnready(locals) { return; }
    deps := computeCallableRhsDeps(rhsCode);
    stripped := stripDeferredFnBodies(rhsCode);
    allBag := fnDepsAll(deps);
    readBag := fnDepsRead(deps);

    allQ: mut List<String> = [];
    var allVisited := "";
    var allCount := 0;
    var aPos := 0;
    aLen := textLib.length(allBag);
    loop aPos < aLen {
        if textLib.at(allBag, aPos) == "|" {
            sep := textLib.indexOfText(allBag, "|", aPos + 1);
            if sep > aPos + 1 {
                t := textLib.slice(allBag, aPos + 1, sep);
                if not tokenInPipeBag(allVisited, t) {
                    allVisited = appendPipeBag(allVisited, t);
                    listLib.pushBack(mut allQ, t);
                    allCount = allCount + 1;
                }
                aPos = sep;
                continue;
            }
        }
        aPos = aPos + 1;
    }
    var ah := 0;
    loop ah < allCount {
        tok := allQ[ah];
        ah = ah + 1;
        if latestActiveLocalByRuntime(locals, tok) < 0 {
            loop locals as entry {
                if entry.depth <= -2 and entry.runtime == tok and (0 - 2 - entry.depth) >= minExitedLexDepth {
                    failAt(source, stmtAt, prefix, "cannot call before " + entry.name + " is initialized");
                }
            }
        }
        pAll := lookupPairsEntryBag(stripped.pairsText, tok, false);
        if pAll =!= "" {
            var k := 0;
            pLen := textLib.length(pAll);
            loop k < pLen {
                if textLib.at(pAll, k) == "|" {
                    sep := textLib.indexOfText(pAll, "|", k + 1);
                    if sep > k + 1 {
                        d := textLib.slice(pAll, k + 1, sep);
                        if not tokenInPipeBag(allVisited, d) {
                            allVisited = appendPipeBag(allVisited, d);
                            listLib.pushBack(mut allQ, d);
                            allCount = allCount + 1;
                        }
                        k = sep;
                        continue;
                    }
                }
                k = k + 1;
            }
        }
        actIdx := latestActiveLocalByRuntime(locals, tok);
        if actIdx >= 0 and (containsFnKind(locals[actIdx].kind) or locals[actIdx].name == "$tuple") and locals[actIdx].code =!= "" {
            vAll := fnDepsAll(locals[actIdx].code);
            var vk := 0;
            vLen := textLib.length(vAll);
            loop vk < vLen {
                if textLib.at(vAll, vk) == "|" {
                    sep := textLib.indexOfText(vAll, "|", vk + 1);
                    if sep > vk + 1 {
                        d := textLib.slice(vAll, vk + 1, sep);
                        if not tokenInPipeBag(allVisited, d) {
                            allVisited = appendPipeBag(allVisited, d);
                            listLib.pushBack(mut allQ, d);
                            allCount = allCount + 1;
                        }
                        vk = sep;
                        continue;
                    }
                }
                vk = vk + 1;
            }
        }
    }

    readQ: mut List<String> = [];
    var readVisited := "";
    var readCount := 0;
    var rPos := 0;
    rLen := textLib.length(readBag);
    loop rPos < rLen {
        if textLib.at(readBag, rPos) == "|" {
            sep := textLib.indexOfText(readBag, "|", rPos + 1);
            if sep > rPos + 1 {
                t := textLib.slice(readBag, rPos + 1, sep);
                if not tokenInPipeBag(readVisited, t) {
                    readVisited = appendPipeBag(readVisited, t);
                    listLib.pushBack(mut readQ, t);
                    readCount = readCount + 1;
                }
                rPos = sep;
                continue;
            }
        }
        rPos = rPos + 1;
    }
    var rh := 0;
    loop rh < readCount {
        tok := readQ[rh];
        rh = rh + 1;
        actIdx := latestActiveLocalByRuntime(locals, tok);
        if actIdx >= 0 and locals[actIdx].depth >= minExitedLexDepth and locals[actIdx].initState =!= INIT_STATE_INIT {
            failAt(source, stmtAt, prefix, "cannot call before " + locals[actIdx].name + " is initialized");
        }
        pRead := lookupPairsEntryBag(stripped.pairsText, tok, true);
        if pRead =!= "" {
            var k := 0;
            pLen := textLib.length(pRead);
            loop k < pLen {
                if textLib.at(pRead, k) == "|" {
                    sep := textLib.indexOfText(pRead, "|", k + 1);
                    if sep > k + 1 {
                        d := textLib.slice(pRead, k + 1, sep);
                        if not tokenInPipeBag(readVisited, d) {
                            readVisited = appendPipeBag(readVisited, d);
                            listLib.pushBack(mut readQ, d);
                            readCount = readCount + 1;
                        }
                        k = sep;
                        continue;
                    }
                }
                k = k + 1;
            }
        }
        if actIdx >= 0 and (containsFnKind(locals[actIdx].kind) or locals[actIdx].name == "$tuple") and locals[actIdx].code =!= "" {
            vRead := fnDepsRead(locals[actIdx].code);
            var vk := 0;
            vLen := textLib.length(vRead);
            loop vk < vLen {
                if textLib.at(vRead, vk) == "|" {
                    sep := textLib.indexOfText(vRead, "|", vk + 1);
                    if sep > vk + 1 {
                        d := textLib.slice(vRead, vk + 1, sep);
                        if not tokenInPipeBag(readVisited, d) {
                            readVisited = appendPipeBag(readVisited, d);
                            listLib.pushBack(mut readQ, d);
                            readCount = readCount + 1;
                        }
                        vk = sep;
                        continue;
                    }
                }
                vk = vk + 1;
            }
        }
    }
}

/** Returns closing brace index if an inner `{ ... }` block contains `"fn"`, or -1 to fast-skip pre-scanning. */
blockHasInnerFn := fn(source: String, openBracePos: Int, prefix: String): Int {
    if openBracePos < 0 or openBracePos >= textLib.length(source) or textLib.at(source, openBracePos) =!= "{" {
        return -1;
    }
    fnHit := textLib.indexOfText(source, "fn", openBracePos + 1);
    if fnHit < 0 { return -1; }
    closeBracePos := scanBraceEnd(source, openBracePos, prefix);
    if closeBracePos <= openBracePos + 1 or fnHit >= closeBracePos { return -1; }
    closeBracePos
}

/** Pre-scans direct top-level statements inside `{ ... }` (`openBracePos .. closeBracePos - 1`) for direct `name = ...` assignments (`"|a|b|"`). */
scanInnerBlockAssignedBag := fn(target: String, source: String, openBracePos: Int, prefix: String, seedBag: String): String {
    if target =!= "ts" { return ""; }
    closeBracePos := blockHasInnerFn(source, openBracePos, prefix);
    if closeBracePos < 0 { return ""; }
    limit := closeBracePos - 1;
    var bag := "";
    var position := openBracePos + 1;
    var parenDepth := 0;
    loop position < limit {
        position = skipTrivia(source, position, prefix);
        if position >= limit { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            nestedEnd := scanBraceEnd(source, position, prefix);
            if nestedEnd >= 0 { position = nestedEnd; } else { position = position + 1; }
        } else if ch == "}" {
            break;
        } else if ch == "(" or ch == "[" {
            parenDepth = parenDepth + 1;
            position = position + 1;
        } else if ch == ")" or ch == "]" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            position = position + 1;
        } else if parenDepth == 0 and textLib.isNameStart(ch) {
            afterName := textLib.skipName(source, position);
            name := textLib.slice(source, position, afterName);
            if name == "var" or name == "mut" or name == "pub" {
                position = afterName;
                continue;
            }
            if isReservedWord(name) {
                position = afterName;
                continue;
            }
            afterTok := skipTrivia(source, afterName, prefix);
            if afterTok < limit and textLib.startsWithAt(source, afterTok, ":=") {
                rhsStart := skipTrivia(source, afterTok + 2, prefix);
                if textLib.wordAt(source, rhsStart, "fn") {
                    var fc := skipTrivia(source, rhsStart + 2, prefix);
                    var fp := 0;
                    loop fc < limit {
                        fc = skipTrivia(source, fc, prefix);
                        if fc >= limit { break; }
                        fch := textLib.at(source, fc);
                        if fch == "\"" { fc = skipAliasString(source, fc); }
                        else if fch == "(" or fch == "[" { fp = fp + 1; fc = fc + 1; }
                        else if fch == ")" or fch == "]" { if fp > 0 { fp = fp - 1; } fc = fc + 1; }
                        else if fp == 0 and fch == ";" { fc = fc + 1; break; }
                        else if fp == 0 and fch == "{" {
                            bodyEnd := scanBraceEnd(source, fc, prefix);
                            if bodyEnd >= 0 { fc = bodyEnd; } else { fc = limit; }
                            break;
                        } else { fc = fc + 1; }
                    }
                    position = fc;
                } else {
                    position = rhsStart;
                }
            } else if afterTok < limit and textLib.at(source, afterTok) == ":" and compoundAssignOp(source, afterTok).width == 0 {
                var ts := afterTok + 1;
                var tp := 0;
                loop ts < limit {
                    ts = skipTrivia(source, ts, prefix);
                    if ts >= limit { break; }
                    tc := textLib.at(source, ts);
                    if tc == "\"" { ts = skipAliasString(source, ts); }
                    else if tc == "(" or tc == "[" or tc == "<" { tp = tp + 1; ts = ts + 1; }
                    else if tc == ")" or tc == "]" or tc == ">" { if tp > 0 { tp = tp - 1; } ts = ts + 1; }
                    else if tc == "{" or tc == "}" { break; }
                    else if tp == 0 and tc == ";" { ts = ts + 1; break; }
                    else if tp == 0 and isSingleEquals(source, ts) { ts = ts + 1; break; }
                    else { ts = ts + 1; }
                }
                position = ts;
            } else if afterTok < limit and isSingleEquals(source, afterTok) {
                if not tokenInPipeBag(seedBag, name) {
                    bag = appendPipeBag(bag, name);
                }
                position = skipTrivia(source, afterTok + 1, prefix);
            } else {
                position = afterName;
            }
        } else {
            position = position + 1;
        }
    }
    bag
}

/** Pre-scans declarations in `{ ... }` (`openBracePos .. closeBracePos - 1`) and appends unreached `depth = 0 - 2 - blockLexDepth` placeholders to `locals`. */
appendBlockFutureLocals := fn(target: String, source: String, openBracePos: Int, prefix: String, blockLexDepth: Int,
seedBag: String, assignedBag: String, aliases: List<AliasDecl>, functions: List<FunctionInfo>,
functionParams: List<String>, locals: List<Local>): List<Local> {
    if target =!= "ts" { return locals; }
    closeBracePos := blockHasInnerFn(source, openBracePos, prefix);
    if closeBracePos < 0 { return locals; }
    limit := closeBracePos - 1;
    decls: mut List<Item> = [];
    var seenDeclBag := seedBag;
    var position := openBracePos + 1;
    var parenDepth := 0;
    loop position < limit {
        position = skipTrivia(source, position, prefix);
        if position >= limit { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            nestedEnd := scanBraceEnd(source, position, prefix);
            if nestedEnd >= 0 { position = nestedEnd; } else { position = position + 1; }
        } else if ch == "}" {
            break;
        } else if ch == "(" or ch == "[" {
            if ch == "(" and parenDepth == 0 {
                parenEnd := scanParenEnd(source, position, prefix);
                afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
                if afterParen >= 0 and afterParen < limit and textLib.startsWithAt(source, afterParen, ":=") {
                    rhsPos := skipTrivia(source, afterParen + 2, prefix);
                    listLib.pushBack(mut decls, (kind = "FutureDestr", name = "", runtime = "val", code = integer.intText(position),
                    intValue = position, textValue = integer.intText(rhsPos)));
                    position = rhsPos;
                    continue;
                }
            }
            parenDepth = parenDepth + 1;
            position = position + 1;
        } else if ch == ")" or ch == "]" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            position = position + 1;
        } else if parenDepth == 0 and textLib.isNameStart(ch) {
            nameStart := position;
            afterName := textLib.skipName(source, position);
            name := textLib.slice(source, nameStart, afterName);
            if name == "var" {
                afterVar := skipTrivia(source, afterName, prefix);
                if afterVar < limit and textLib.at(source, afterVar) == "(" {
                    parenEnd := scanParenEnd(source, afterVar, prefix);
                    afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
                    if afterParen >= 0 and afterParen < limit and textLib.startsWithAt(source, afterParen, ":=") {
                        rhsPos := skipTrivia(source, afterParen + 2, prefix);
                        listLib.pushBack(mut decls, (kind = "FutureDestr", name = "", runtime = "var", code = integer.intText(afterVar),
                        intValue = nameStart, textValue = integer.intText(rhsPos)));
                        position = rhsPos;
                        continue;
                    }
                }
                var isVarMut := false;
                var varLocalPos := afterVar;
                if textLib.wordAt(source, varLocalPos, "mut") {
                    isVarMut = true;
                    varLocalPos = skipTrivia(source, varLocalPos + 3, prefix);
                }
                if varLocalPos < limit and textLib.isNameStart(textLib.at(source, varLocalPos)) {
                    localStart := varLocalPos;
                    localEnd := textLib.skipName(source, localStart);
                    localName := textLib.slice(source, localStart, localEnd);
                    if not isReservedWord(localName) {
                        afterLocal := skipTrivia(source, localEnd, prefix);
                        if afterLocal < limit and textLib.startsWithAt(source, afterLocal, ":=") {
                            rhsPos := skipTrivia(source, afterLocal + 2, prefix);
                            if not tokenInPipeBag(seenDeclBag, localName) {
                                seenDeclBag = appendPipeBag(seenDeclBag, localName);
                                kindTag := if isVarMut { "varmut|" } else { "varval|" };
                                listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = "",
                                code = "", intValue = localStart, textValue = kindTag + integer.intText(rhsPos)));
                            }
                            position = rhsPos;
                            continue;
                        } else if not isVarMut and afterLocal < limit and textLib.at(source, afterLocal) == ":" and compoundAssignOp(source, afterLocal).width == 0 {
                            annStart := afterLocal + 1;
                            if not tokenInPipeBag(seenDeclBag, localName) {
                                seenDeclBag = appendPipeBag(seenDeclBag, localName);
                                listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = "",
                                code = "", intValue = localStart, textValue = "varann|" + integer.intText(annStart)));
                            }
                            var ts := annStart;
                            var tp := 0;
                            loop ts < limit {
                                ts = skipTrivia(source, ts, prefix);
                                if ts >= limit { break; }
                                tc := textLib.at(source, ts);
                                if tc == "\"" { ts = skipAliasString(source, ts); }
                                else if tc == "(" or tc == "[" or tc == "<" { tp = tp + 1; ts = ts + 1; }
                                else if tc == ")" or tc == "]" or tc == ">" { if tp > 0 { tp = tp - 1; } ts = ts + 1; }
                                else if tc == "{" or tc == "}" { break; }
                                else if tp == 0 and tc == ";" { ts = ts + 1; break; }
                                else if tp == 0 and isSingleEquals(source, ts) { ts = ts + 1; break; }
                                else { ts = ts + 1; }
                            }
                            position = ts;
                            continue;
                        }
                    }
                }
                position = afterName;
                continue;
            }
            if name == "mut" {
                localStart := skipTrivia(source, afterName, prefix);
                if localStart < limit and textLib.isNameStart(textLib.at(source, localStart)) {
                    localEnd := textLib.skipName(source, localStart);
                    localName := textLib.slice(source, localStart, localEnd);
                    afterLocal := skipTrivia(source, localEnd, prefix);
                    if not isReservedWord(localName) and afterLocal < limit and textLib.startsWithAt(source, afterLocal, ":=") {
                        rhsPos := skipTrivia(source, afterLocal + 2, prefix);
                        if not tokenInPipeBag(seenDeclBag, localName) {
                            seenDeclBag = appendPipeBag(seenDeclBag, localName);
                            listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = "",
                            code = "", intValue = localStart, textValue = "mutval|" + integer.intText(rhsPos)));
                        }
                        position = rhsPos;
                        continue;
                    }
                }
                position = afterName;
                continue;
            }
            if name == "else" or isReservedWord(name) {
                position = afterName;
                continue;
            }
            aliasPos := skipTrivia(source, afterName, prefix);
            if aliasPos < limit and textLib.startsWithAt(source, aliasPos, ":=") {
                valueStart := skipTrivia(source, aliasPos + 2, prefix);
                if textLib.wordAt(source, valueStart, "type") {
                    targetStart := skipTrivia(source, valueStart + 4, prefix);
                    aliasTarget := collectTypeTarget(source, targetStart, prefix);
                    position = if aliasTarget.next > valueStart { aliasTarget.next } else { valueStart + 4 };
                    continue;
                }
                if not textLib.wordAt(source, valueStart, "import") and not tokenInPipeBag(seenDeclBag, name) {
                    seenDeclBag = appendPipeBag(seenDeclBag, name);
                    listLib.pushBack(mut decls, (kind = "FutureDecl", name = name, runtime = "",
                    code = "", intValue = nameStart, textValue = "val|" + integer.intText(valueStart)));
                }
                if textLib.wordAt(source, valueStart, "fn") {
                    var fnCursor := skipTrivia(source, valueStart + 2, prefix);
                    var fnParen := 0;
                    loop fnCursor < limit {
                        fnCursor = skipTrivia(source, fnCursor, prefix);
                        if fnCursor >= limit { break; }
                        fc := textLib.at(source, fnCursor);
                        if fc == "\"" { fnCursor = skipAliasString(source, fnCursor); }
                        else if fc == "(" or fc == "[" { fnParen = fnParen + 1; fnCursor = fnCursor + 1; }
                        else if fc == ")" or fc == "]" { if fnParen > 0 { fnParen = fnParen - 1; } fnCursor = fnCursor + 1; }
                        else if fnParen == 0 and fc == ";" { fnCursor = fnCursor + 1; break; }
                        else if fnParen == 0 and fc == "{" {
                            fnBodyEnd := scanBraceEnd(source, fnCursor, prefix);
                            fnCursor = if fnBodyEnd >= 0 { fnBodyEnd } else { limit };
                            break;
                        } else if fnParen == 0 and fc == "}" { break; }
                        else { fnCursor = fnCursor + 1; }
                    }
                    position = fnCursor;
                    continue;
                }
                position = valueStart;
                continue;
            }
            if aliasPos < limit and textLib.at(source, aliasPos) == ":" and compoundAssignOp(source, aliasPos).width == 0 {
                annStart := aliasPos + 1;
                if not tokenInPipeBag(seenDeclBag, name) {
                    seenDeclBag = appendPipeBag(seenDeclBag, name);
                    listLib.pushBack(mut decls, (kind = "FutureDecl", name = name, runtime = "",
                    code = "", intValue = nameStart, textValue = "ann|" + integer.intText(annStart)));
                }
                var ts := annStart;
                var tp := 0;
                loop ts < limit {
                    ts = skipTrivia(source, ts, prefix);
                    if ts >= limit { break; }
                    tc := textLib.at(source, ts);
                    if tc == "\"" { ts = skipAliasString(source, ts); }
                    else if tc == "(" or tc == "[" or tc == "<" { tp = tp + 1; ts = ts + 1; }
                    else if tc == ")" or tc == "]" or tc == ">" { if tp > 0 { tp = tp - 1; } ts = ts + 1; }
                    else if tc == "{" or tc == "}" { break; }
                    else if tp == 0 and tc == ";" { ts = ts + 1; break; }
                    else if tp == 0 and isSingleEquals(source, ts) { ts = ts + 1; break; }
                    else { ts = ts + 1; }
                }
                position = ts;
                continue;
            }
            position = afterName;
        } else {
            position = position + 1;
        }
    }
    var declCount := 0;
    loop decls { declCount = declCount + 1; }
    if declCount == 0 { return locals; }

    scopedAliases := aliasesUpToDepth(aliases, blockLexDepth);
    futureValues: mut List<FutureValue> = [];
    var resolvedBag := "";
    var futurePass := 0;
    loop futurePass < 4 {
        var progressed := false;
        var declIdx := 0;
        loop decls as decl {
            keyText := integer.intText(declIdx);
            if not tokenInPipeBag(resolvedBag, keyText) {
                if decl.kind == "FutureDecl" {
                    sep := textLib.indexOfText(decl.textValue, "|", 0);
                    declTag := textLib.slice(decl.textValue, 0, sep);
                    posVal := parseDigits(decl.textValue, sep + 1, textLib.length(decl.textValue));
                    if declTag == "ann" or declTag == "varann" {
                        declMutable := declTag == "varann";
                        if canPreResolveLocalType(source, posVal, prefix, scopedAliases) {
                            typed := parseLocalType(source, posVal, prefix, scopedAliases);
                            if not (declMutable and typed.writable) {
                                afterType := skipTrivia(source, typed.next, prefix);
                                var futInit := INIT_STATE_INIT;
                                if isSingleEquals(source, afterType) {
                                    rhsStart := skipTrivia(source, afterType + 1, prefix);
                                    if isReservedInitMarker(source, rhsStart, prefix) >= 0 and not isListKind(typed.kind) {
                                        futInit = if tokenInPipeBag(assignedBag, decl.name) { INIT_STATE_INIT }
                                        else if declMutable { INIT_STATE_UNINIT }
                                        else { INIT_STATE_MAYBE };
                                    }
                                }
                                listLib.pushBack(mut futureValues, (name = decl.name, runtime = "", kind = typed.kind,
                                at = decl.intValue, mutable = declMutable, writable = typed.writable, initState = futInit));
                                resolvedBag = appendPipeBag(resolvedBag, keyText);
                                progressed = true;
                            }
                        }
                    } else {
                        declMutable := declTag == "varval" or declTag == "varmut";
                        declWritable := declTag == "varmut" or declTag == "mutval";
                        inferred := tryInferRootExprKind(source, posVal, prefix, scopedAliases, functions, functionParams, locals, futureValues, "", 0, 24);
                        if inferred.kind =!= "" and inferred.kind =!= "Unit" and (not declWritable or isListKind(inferred.kind)) {
                            listLib.pushBack(mut futureValues, (name = decl.name, runtime = "", kind = inferred.kind,
                            at = decl.intValue, mutable = declMutable, writable = declWritable, initState = INIT_STATE_INIT));
                            resolvedBag = appendPipeBag(resolvedBag, keyText);
                            progressed = true;
                        }
                    }
                } else if decl.kind == "FutureDestr" {
                    openPos := parseDigits(decl.code, 0, textLib.length(decl.code));
                    rhsPos := parseDigits(decl.textValue, 0, textLib.length(decl.textValue));
                    destr := tryParseDestructureNames(source, openPos, prefix);
                    if destr.ok and destr.count > 0 {
                        destrMutable := decl.runtime == "var";
                        inferred := tryInferRootExprKind(source, rhsPos, prefix, scopedAliases, functions, functionParams, locals, futureValues, "", 0, 24);
                        if destr.grouped {
                            if inferred.kind =!= "" and inferred.kind =!= "Unit" {
                                bindName := destr.namesText;
                                listLib.pushBack(mut futureValues, (name = bindName, runtime = "",
                                kind = inferred.kind, at = decl.intValue, mutable = destrMutable, writable = false, initState = INIT_STATE_INIT));
                                resolvedBag = appendPipeBag(resolvedBag, keyText);
                                progressed = true;
                            }
                        } else if isTupleKind(inferred.kind) and tupleComponentCount(inferred.kind) == destr.count {
                            var bindCursor := 0;
                            var bindIndex := 0;
                            namesLen := textLib.length(destr.namesText);
                            loop bindIndex < destr.count {
                                var bindEnd := bindCursor;
                                loop bindEnd < namesLen and textLib.at(destr.namesText, bindEnd) =!= "," {
                                    bindEnd = bindEnd + 1;
                                }
                                bindName := textLib.slice(destr.namesText, bindCursor, bindEnd);
                                bindCursor = bindEnd + 1;
                                comp := tupleComponent(inferred.kind, bindIndex);
                                listLib.pushBack(mut futureValues, (name = bindName, runtime = "",
                                kind = comp.kind, at = decl.intValue, mutable = destrMutable, writable = false, initState = INIT_STATE_INIT));
                                bindIndex = bindIndex + 1;
                            }
                            resolvedBag = appendPipeBag(resolvedBag, keyText);
                            progressed = true;
                        }
                    }
                }
            }
            declIdx = declIdx + 1;
        }
        if not progressed { break; }
        futurePass = futurePass + 1;
    }

    nextLocals: mut List<Local> = [];
    loop locals as entry { listLib.pushBack(mut nextLocals, entry); }
    placeholderDepth := 0 - 2 - blockLexDepth;
    pushedNames: mut List<String> = [];
    pushedAts: mut List<Int> = [];
    var pushedCount := 0;
    loop futureValues as fut {
        if not tokenInPipeBag(seedBag, fut.name) {
            var priorDiffAt := false;
            var pi := 0;
            loop pi < pushedCount {
                if pushedNames[pi] == fut.name and pushedAts[pi] =!= fut.at {
                    priorDiffAt = true;
                    break;
                }
                pi = pi + 1;
            }
            if not priorDiffAt {
                listLib.pushBack(mut pushedNames, fut.name);
                listLib.pushBack(mut pushedAts, fut.at);
                pushedCount = pushedCount + 1;
                rt := localRuntimeName(target, nextLocals, fut.name, "", blockLexDepth);
                listLib.pushBack(mut nextLocals, (name = fut.name, runtime = rt, kind = fut.kind,
                mutable = fut.mutable, writable = fut.writable, depth = placeholderDepth, constant = false,
                code = "", intValue = 0, textValue = "", initState = fut.initState));
            }
        }
    }
    nextLocals
}

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`, with construct context tracking. */
parseBinaryCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    sourceSize := textLib.length(source);
    var start := skipTrivia(source, position, prefix);
    if start >= sourceSize {
        failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    effectiveMinimum := if minimum < 0 { 0 } else { minimum };
    var leaderStart := -1;
    var leaderText := "";
    if effectiveMinimum == 0 and (textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or")) {
        leaderStart = start;
        leaderEnd := textLib.skipName(source, start);
        leaderText = textLib.slice(source, start, leaderEnd);
        start = skipTrivia(source, leaderEnd, prefix);
        if textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or") {
            failAt(source, start, prefix, "leading " + leaderText + " may appear only once");
        }
    }
    var left := intParsed("", 0, true, start);
    var condParseKind := "";
    var condParseStart := -1;
    var condParseTag := "";
    var condParseTagAt := -1;
    ch := textLib.at(source, start);
    if ch == "(" {
        if textLib.at(source, skipTrivia(source, start + 1, prefix)) == ")" {
            left = (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = skipTrivia(source, start + 1, prefix) + 1);
        } else if looksLikeTupleEntry(source, start + 1, prefix) {
            var cursor := skipTrivia(source, start + 1, prefix);
            labels: mut List<String> = [];
            codes: mut List<String> = [];
            kinds: mut List<String> = [];
            var tupleMarkers := "";
            var count := 0;
            loop cursor < sourceSize and textLib.at(source, cursor) =!= ")" {
                var label := "";
                var valueStart := cursor;
                var value := intParsed("", 0, true, cursor);
                if isSingleEquals(source, cursor) {
                    nameStart := skipTrivia(source, cursor + 1, prefix);
                    if nameStart >= sourceSize or not textLib.isNameStart(textLib.at(source, nameStart)) {
                        failAt(source, nameStart, prefix, "expected a tuple field name after =");
                    }
                    nameEnd := textLib.skipName(source, nameStart);
                    label = textLib.slice(source, nameStart, nameEnd);
                    if isReservedWord(label) { unsupportedFeature(source, nameStart, label, prefix); }
                    if listLib.listContainsText(labels, label) {
                        failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                    }
                    valueStart = nameStart;
                    fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                    value = self(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30, ctxs, iifeDepth, inferMode, "", aliases);
                } else if cursor < sourceSize and textLib.isNameStart(textLib.at(source, cursor)) {
                    nameEnd := textLib.skipName(source, cursor);
                    afterName := skipTrivia(source, nameEnd, prefix);
                    if isSingleEquals(source, afterName) {
                        label = textLib.slice(source, cursor, nameEnd);
                        if isReservedWord(label) { unsupportedFeature(source, cursor, label, prefix); }
                        if listLib.listContainsText(labels, label) {
                            failAt(source, cursor, prefix, "duplicate tuple field " + label);
                        }
                        valueStart = skipTrivia(source, afterName + 1, prefix);
                        fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                        value = self(target, source, valueStart, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                    } else {
                        fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                        value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                    }
                } else {
                    fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                    value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                }
                if inferMode { tupleMarkers = collectParsedMarkers(tupleMarkers, value); }
                if isTupleKind(value.kind) {
                    failAt(source, valueStart, prefix, "nested tuple values are not supported");
                }
                if isListKind(value.kind) {
                    failAt(source, valueStart, prefix, "list values inside tuples are not supported");
                }
                if value.kind == "Unit" or value.kind == "Never" {
                    failName := if label =!= "" { label } else { integer.intText(count) };
                    failAt(source, valueStart, prefix, "tuple field " + failName + " cannot be " + displayKind(value.kind));
                }
                listLib.pushBack(mut labels, label);
                listLib.pushBack(mut codes, value.code);
                listLib.pushBack(mut kinds, value.kind);
                count = count + 1;
                cursor = skipTrivia(source, value.next, prefix);
                if cursor < sourceSize and textLib.at(source, cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                } else {
                    break;
                }
            }
            cursor = expectSymbol(source, cursor, ")", prefix);
            var kindText := "(";
            var codeText := "{ ";
            var index := 0;
            loop index < count {
                if index > 0 {
                    kindText = kindText + ",";
                    codeText = codeText + ", ";
                }
                kindText = kindText + labels[index] + ":" + kinds[index];
                codeText = codeText + tupleObjectKey(labels[index], index) + ": " + codes[index];
                index = index + 1;
            }
            left = withMarkers((kind = kindText + ")", code = codeText + " }", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
        } else {
            var groupedExpected := expected;
            if numeric.isNumericKind(expected) {
                groupEnd := scanParenEnd(source, start, prefix);
                if groupEnd >= 0 and binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
            }
            inner := self(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
            next := expectSymbol(source, skipTrivia(source, inner.next, prefix), ")", prefix);
            left = withMarkers((kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next),
            if inferMode { collectParsedMarkers("", inner) } else { "" });
        }
    } else if ch == "+" or ch == "-" {
        after := skipTrivia(source, start + 1, prefix);
        if after < textLib.length(source) and textLib.isDigit(textLib.at(source, after)) {
            litExpected := if ch == "-" { expected } else { "" };
            left = parseNumber(target, source, start, prefix, litExpected, minimum);
        } else {
            operand := self(target, source, start + 1, prefix, locals, functions, params, currentName, "", 30, ctxs, iifeDepth, inferMode, "", aliases);
            operandLoopId := loopValMarkerId(operand.kind);
            if inferMode and operandLoopId >= 0 {
                if expected =!= "" and expected =!= "Unit" and expected =!= "Never" and numeric.isNumericKind(expected) {
                    left = withMarkers((kind = expected, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
                    collectParsedMarkers("", operand) + integer.intText(operandLoopId) + "=" + expected + "\n");
                } else {
                    left = withMarkers((kind = operand.kind, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
                    collectParsedMarkers("", operand));
                }
            } else {
                if not numeric.isNumericKind(operand.kind) {
                    failAt(source, start, prefix, "unary " + ch + " requires an Int or Float operand");
                }
                code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
                if numeric.isFloatKind(operand.kind) {
                    left = withMarkers((kind = operand.kind, code = code, intValue = 0, textValue = "", constant = false, next = operand.next),
                    if inferMode { collectParsedMarkers("", operand) } else { "" });
                } else if operand.constant {
                    folded := if ch == "-" { integer.intNegate(operand.intValue) } else { (value = operand.intValue, ok = true) };
                    if folded.ok and numeric.intKindFits(operand.kind, folded.value) {
                        left = typedIntParsed(operand.kind, code, folded.value, true, operand.next);
                    } else {
                        rawNeg := targetIntNegateCode(target, operand.code, start);
                        checkedNeg := if numeric.isNarrowIntKind(operand.kind) {
                            targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start)
                        } else { rawNeg };
                        left = typedIntParsed(operand.kind, checkedNeg, 0, false, operand.next);
                    }
                } else {
                    runtimeCode := if ch == "-" {
                        rawNeg := targetIntNegateCode(target, operand.code, start);
                        if numeric.isNarrowIntKind(operand.kind) {
                            targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start)
                        } else { rawNeg }
                    } else { code };
                    left = withMarkers(typedIntParsed(operand.kind, runtimeCode, 0, false, operand.next),
                    if inferMode { collectParsedMarkers("", operand) } else { "" });
                }
            }
        }
    } else if textLib.isDigit(ch) {
        left = parseNumber(target, source, start, prefix, expected, minimum);
    } else if ch == "\"" {
        left = parseText(target, source, start, prefix);
    } else if ch == "[" {
        var cursor := skipTrivia(source, start + 1, prefix);
        isTailList := textLib.startsWithAt(expected, 0, "TailList<");
        isListTarget := isListKind(expected) or isTailList;
        var elementKind := "";
        if isListKind(expected) { elementKind = listElementKind(expected); }
        else if isTailList { elementKind = listElementKind(textLib.slice(expected, 4, textLib.length(expected))); }
        else if isArrayKind(expected) { elementKind = arrayElementKind(expected); }
        elementCodes: mut List<String> = [];
        var listMarkers := "";
        var count := 0;
        loop true {
            if cursor >= textLib.length(source) {
                failAt(source, cursor, prefix, "expected ] in list literal");
            }
            if textLib.at(source, cursor) == "]" { break; }
            elementStart := cursor;
            element := self(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { listMarkers = collectParsedMarkers(listMarkers, element); }
            if element.kind == "Unit" and elementKind =!= "Unit" {
                failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " cannot be Unit");
            }
            if isListKind(element.kind) {
                failAt(source, elementStart, prefix, "nested list types are not supported");
            }
            if elementKind == "" {
                if element.kind =!= "Never" { elementKind = element.kind; }
            } else {
                compatible := if isListTarget { isCompatibleKind(elementKind, element.kind) }
                else { element.kind == "Never" or element.kind == elementKind or fnShapeMatches(elementKind, element.kind) };
                if not compatible {
                    failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " must be " +
                    displayKind(elementKind) + ", got " + displayKind(element.kind));
                }
            }
            listLib.pushBack(mut elementCodes, assignValueCode(target, elementKind, element.kind, element.code));
            count = count + 1;
            cursor = skipTrivia(source, element.next, prefix);
            if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = expectSymbol(source, cursor, "]", prefix);
        if count > 0 and elementKind == "" {
            failAt(source, start, prefix, "list element 1 cannot be Never");
        }
        if count == 0 and not isListKind(expected) and not isTailList and not isArrayKind(expected) {
            failAt(source, start, prefix, "empty list literal requires a List element type");
        }
        resultKind := if isListKind(expected) or (count == 0 and isTailList) {
            "List<" + elementKind + ">"
        } else {
            "[" + elementKind + ";" + integer.intText(count) + "]"
        };
        left = withMarkers((kind = resultKind, code = "[" + textLib.joinTexts(elementCodes, ", ") + "]",
        intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
    } else if ch == "@" {
        tagInfo := parseTagAt(source, start, prefix);
        afterTag := skipTrivia(source, tagInfo.next, prefix);
        tagSourceSize := textLib.length(source);
        if afterTag < tagSourceSize and textLib.at(source, afterTag) == "." {
            fieldStart := skipTrivia(source, afterTag + 1, prefix);
            if fieldStart >= tagSourceSize or not textLib.isNameStart(textLib.at(source, fieldStart)) {
                failAt(source, fieldStart, prefix, "expected field name after @" + tagInfo.tag + ".");
            }
            fieldEnd := textLib.skipName(source, fieldStart);
            fieldName := textLib.slice(source, fieldStart, fieldEnd);
            ctxIdx := findTaggedCtxIndex(ctxs, tagInfo.tag);
            if ctxIdx < 0 {
                failAt(source, start, prefix, "unknown block tag @" + tagInfo.tag);
            }
            if hasFinallyAbove(ctxs, ctxIdx) {
                failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
            }
            ctx := ctxs[ctxIdx];
            if ctx.kind == "if" or ctx.kind == "match" {
                if fieldName == "value" {
                    if ctx.phase =!= "then" {
                        failAt(source, fieldStart, prefix, "@" + tagInfo.tag + ".value is only available inside that conditional's then block");
                    }
                    if ctx.itemKind == "Unit" or ctx.itemKind == "Never" or ctx.itemKind == "" {
                        failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose .value for " +
                        displayKind(if ctx.itemKind == "" { "Unit" } else { ctx.itemKind }) + " conditional");
                    }
                    left = (kind = ctx.itemKind, code = ctx.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
                } else {
                    failAt(source, fieldStart, prefix, "conditional tag @" + tagInfo.tag + " only exposes .value, not ." + fieldName);
                }
            } else if ctx.kind == "loop" {
                if ctx.phase == "finally" {
                    failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
                }
                if target =!= "ts" {
                    failAt(source, start, prefix, "C backend does not support loop metadata yet");
                }
                left = resolveLoopField(target, ctx, fieldName, expected, source, fieldStart, fieldEnd, prefix);
            } else {
                failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose ." + fieldName);
            }
        } else if afterTag < tagSourceSize and textLib.at(source, afterTag) == "{" {
            if target =!= "ts" {
                failAt(source, start, prefix, "C backend does not support tagged blocks yet");
            }
            hintExpected := if expected == "Unit" or expected == "Never" {
                ""
            } else if textLib.startsWithAt(expected, 0, "TailList<") {
                "List<" + listElementKind(textLib.slice(expected, 4, textLib.length(expected))) + ">"
            } else {
                expected
            };
            blockId := nextCtxId(ctxs);
            blockLabel := "lite$b" + integer.intText(blockId);
            blockValVar := "lite$val" + integer.intText(blockId);
            taggedLexDepthStr := integer.intText(maxLocalLexDepth(locals) + 1);
            pass1ValKind := if hintExpected == "" { "__infer__" } else { "__infer__:" + hintExpected };
            pass1Ctx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "body",
            iifeDepth = iifeDepth + 1, valKind = pass1ValKind, valVar = blockValVar, label = blockLabel,
            iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
            pass1 := self(target, source, afterTag, prefix, locals, functions, params, currentName,
            hintExpected, 0, appendCtx(ctxs, pass1Ctx), iifeDepth + 1, true, "tagged", aliases);
            if inferMode {
                left = pass1;
            } else {
                inferredKind := pass1.kind;
                pass2Expected := if inferredKind == "Unit" or inferredKind == "Never" { "" } else { inferredKind };
                pass2Ctx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "body",
                iifeDepth = iifeDepth + 1, valKind = inferredKind, valVar = blockValVar, label = blockLabel,
                iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                left = self(target, source, afterTag, prefix, locals, functions, params, currentName,
                pass2Expected, 0, appendCtx(ctxs, pass2Ctx), iifeDepth + 1, false, "tagged", aliases);
            }
            afterTaggedClose := skipTrivia(source, left.next, prefix);
            if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "then") {
                failAt(source, afterTaggedClose, prefix, "then requires an if, match, or loop");
            }
            if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "finally") {
                afterFinKw := skipTrivia(source, afterTaggedClose + 7, prefix);
                rejectMisplacedTag(source, afterFinKw, prefix, "block tag cannot appear after finally");
                finOpen := expectSymbol(source, afterFinKw, "{", prefix);
                taggedFinCtx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "finally",
                iifeDepth = iifeDepth + 1, valKind = left.kind, valVar = blockValVar, label = blockLabel,
                iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                finBarrierCtx := (id = 0, tag = "", kind = "finally", phase = "finally",
                iifeDepth = iifeDepth + 1, valKind = "Unit", valVar = "", label = "",
                iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                finCtxs := appendCtx(appendCtx(ctxs, taggedFinCtx), finBarrierCtx);
                finParsed := self(target, source, finOpen - 1, prefix, locals, functions, params, currentName,
                "", 0, finCtxs, iifeDepth + 1, inferMode, "finally", aliases);
                afterFinClose := skipTrivia(source, finParsed.next, prefix);
                if afterFinClose < tagSourceSize and textLib.wordAt(source, afterFinClose, "then") {
                    failAt(source, afterFinClose, prefix, "then must appear before finally");
                }
                if afterFinClose < tagSourceSize and textLib.wordAt(source, afterFinClose, "finally") {
                    failAt(source, afterFinClose, prefix, "duplicate finally block");
                }
                finalTaggedKind := if finParsed.kind == "Never" { "Never" } else { left.kind };
                if inferMode {
