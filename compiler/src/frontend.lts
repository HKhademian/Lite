            }
        }
        var afterDefinition := position;
        if textLib.startsWithAt(source, position, ":=") {
            afterDefinition = skipTrivia(source, position + 2, prefix);
        }
        definition := blockCount == 0 and textLib.startsWithAt(source, position, ":=") and
            (textLib.wordAt(source, afterDefinition, "fn") or textLib.wordAt(source, afterDefinition, "type"));
        if name == "return" {
            if currentName == "" {
                failAt(source, nameStart, prefix, "return outside a function");
            }
            valueStart := position;
            if valueStart >= size or textLib.at(source, valueStart) == ";" or textLib.at(source, valueStart) == "}" {
