                    localEnd := textLib.skipName(source, localStart);
                    localName := textLib.slice(source, localStart, localEnd);
                    if isReservedWord(localName) { unsupportedFeature(source, localStart, localName, prefix); }
                    var afterLocal := skipTrivia(source, localEnd, prefix);
