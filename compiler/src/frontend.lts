                    }
                    statementNext := consumeStatementEnd(source, rhs.next, prefix);
                    if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                    tempRuntime := freshScopeTemp(blockLocals, "lite$tuple");
                    listLib.pushBack(mut blockLocals, (name = "$tuple", runtime = tempRuntime, kind = "Unit",
                        mutable = false, writable = false, depth = 1, constant = false, code = "",
                        intValue = 0, textValue = "", initState = "init"));
                    if not blockExits {
                        listLib.pushBack(mut statements, "const " + tempRuntime + " = " + rhs.code + "; void " + tempRuntime + ";");
                    }
