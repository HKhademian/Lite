                    position = expression.next;
                    continue;
                }
                if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = ITEM_KIND_SCOPE, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                listLib.pushBack(mut savedStates, (returned = currentReturned, stopped = currentStopped,
                branchesReturned = branchesReturned, branchesStopped = branchesStopped, hasElse = hasElse, loopForever = loopForever, live = currentLive,
                preLocalsLen = localsCount(locals), liveBranchCount = liveBranchCount));
                liveBranchCount = 0;
                currentLive = currentLive and not currentStopped;
                currentReturned = false;
                currentStopped = false;
                branchesReturned = true;
                branchesStopped = true;
                hasElse = false;
                loopForever = false;
                listLib.pushBack(mut blocks, BLOCK_KIND_SCOPE);
                blockCount = blockCount + 1;
                depth = depth + 1;
                if hasInnerAlias { aliases = collectBlockTypeAliases(source, position, prefix, depth, aliases); }
                scopeAssignedBag := scanInnerBlockAssignedBag(target, source, position, prefix, "");
                blockAssignedDecls = appendAssignedBagDecls(scopeAssignedBag, blockAssignedDecls, depth);
                locals = appendBlockFutureLocals(target, source, position, prefix, depth, "", scopeAssignedBag, aliases, functions, functionParams, locals);
