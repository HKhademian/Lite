                }
                rhs := self(target, source, skipTrivia(source, afterTarget + 2, prefix), prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "");
                if inferMode { blockMarkers = collectParsedMarkers(blockMarkers, rhs); }
