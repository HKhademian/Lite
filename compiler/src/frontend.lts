                }
                if rhs.kind =!= VALUE_KIND_UNIT {
                    failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + displayKind(rhs.kind));
                }
                statementNext := consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                position = statementNext;
                if currentLive and not currentStopped {
                    listLib.pushBack(mut items, (kind = ITEM_KIND_DISCARD, name = VALUE_KIND_UNIT, runtime = "",
                    code = rhs.code, intValue = 0, textValue = ""));
                    if codeHasRawTransfer(rhs.code) {
                        listLib.pushBack(mut transferCodes, rhs.code);
                        transferCount = transferCount + 1;
                    }
