            next := expectSymbol(source, close, "]", prefix);
            left = (kind = listElementKind(left.kind),
                code = "lite$listAt((" + left.code + "), " + index.code + ", " + integer.intText(indexStart) + ")",
                intValue = 0, textValue = "", constant = false, next = next);
        } else {
            break;
        }
    }
    if left.kind == "ModuleFunction" {
        info := functions[left.intValue];
        if info.runtime == "lite$core$list$pushBack:v1" {
            grant := parseListGrant(source, left.next, prefix, locals, "pushBack");
            var cursor := skipTrivia(source, grant.next, prefix);
            if cursor >= textLib.length(source) or textLib.at(source, cursor) =!= "," {
                failAt(source, cursor, prefix, "pushBack expects a value after the mut list");
            }
            valueStart := skipTrivia(source, cursor + 1, prefix);
            elementKind := listElementKind(grant.kind);
            value := self(target, source, valueStart, prefix, locals, functions, params, currentName, elementKind, 0);
            if value.kind =!= elementKind {
                failAt(source, valueStart, prefix, "pushBack element must be " + displayKind(elementKind) +
                    ", got " + displayKind(value.kind));
            }
            close := expectNonemptyCallClose(source, value.next, prefix);
            left = (kind = "Unit", code = grant.runtime + ".push(" + value.code + ")",
                intValue = 0, textValue = "", constant = false, next = close);
        } else if info.runtime == "lite$core$list$popBack:v1" {
            grant := parseListGrant(source, left.next, prefix, locals, "popBack");
            close := expectNonemptyCallClose(source, grant.next, prefix);
            left = (kind = listElementKind(grant.kind), code = "lite$listPopBack(" + grant.runtime + ", " + integer.intText(start) + ")",
                intValue = 0, textValue = "", constant = false, next = close);
        } else {
            if info.count < 0 {
                failAt(source, start, prefix, "host output functions are standalone statements");
            }
            callOpen := skipTrivia(source, left.next, prefix);
            if callOpen >= textLib.length(source) or textLib.at(source, callOpen) =!= "(" {
                failAt(source, start, prefix, "function " + left.textValue + " must be called");
            }
            var cursor := skipTrivia(source, callOpen + 1, prefix);
            argumentCodes: mut List<String> = [];
            var argumentCount := 0;
            if cursor < textLib.length(source) and textLib.at(source, cursor) =!= ")" {
                loop true {
                    if argumentCount >= info.count {
                        suffix := if info.count == 1 { " argument" } else { " arguments" };
                        failAt(source, start, prefix, "function " + left.textValue + " expects " + formatLib.decimalText(info.count) + suffix + ", got more");
                    }
                    expected := paramKindOf(params[info.first + argumentCount]);
                    argument := self(target, source, cursor, prefix, locals, functions, params, currentName, expected, 0);
                    if not isCompatibleKind(expected, argument.kind) {
                        failAt(source, cursor, prefix, "argument " + formatLib.decimalText(argumentCount + 1) + " of " + left.textValue +
                            " must be " + displayKind(expected) + ", got " + displayKind(argument.kind));
                    }
                    listLib.pushBack(mut argumentCodes, assignValueCode(target, expected, argument.kind, argument.code));
                    argumentCount = argumentCount + 1;
                    cursor = skipTrivia(source, argument.next, prefix);
                    if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
                        cursor = skipTrivia(source, cursor + 1, prefix);
                        if cursor < textLib.length(source) and textLib.at(source, cursor) == ")" { break; }
                    } else {
                        break;
                    }
                }
            }
            cursor = expectSymbol(source, cursor, ")", prefix);
            optionalPrompt := info.runtime == "lite$inputAll" or info.runtime == "lite$inputLine" or
                info.runtime == "lite$inputInt" or info.runtime == "lite$inputFloat";
            if argumentCount =!= info.count and not (optionalPrompt and argumentCount == 0) {
                suffix := if info.count == 1 { " argument" } else { " arguments" };
                failAt(source, start, prefix, "function " + left.textValue + " expects " + formatLib.decimalText(info.count) +
                    suffix + ", got " + formatLib.decimalText(argumentCount));
            }
            if optionalPrompt {
                if argumentCount == 0 { listLib.pushBack(mut argumentCodes, "undefined"); }
                place := sourceLib.lineColumn(source, start);
                location := (if prefix == "" { "" } else { prefix + ":" }) + formatLib.decimalText(place.line) + ":" +
                    formatLib.decimalText(place.column) + ": InputFault: ";
                listLib.pushBack(mut argumentCodes, targetTextLiteralCode(target, location));
            }
            if info.runtime == "lite$textAt" or info.runtime == "lite$textSlice" {
                listLib.pushBack(mut argumentCodes, integer.intText(start));
            }
            left = (kind = info.result, code = info.runtime + "(" + textLib.joinTexts(argumentCodes, ", ") + ")",
                intValue = 0, textValue = "", constant = false, next = cursor);
        }
    }
    loop true {
        if left.next > 0 and textLib.at(source, left.next - 1) == "}" { break; }
        operatorPosition := skipTrivia(source, left.next, prefix);
        if operatorPosition >= textLib.length(source) { break; }
        operator := readOperator(source, operatorPosition);
        if operator.text == "" { break; }
        level := operatorLevel(operator.text);
        if level < effectiveMinimum { break; }
        if operator.text == "**" {
            var signPosition := start;
            loop signPosition < textLib.length(source) and (textLib.at(source, signPosition) == "+" or textLib.at(source, signPosition) == "-") {
                if textLib.at(source, signPosition) == "-" {
                    failAt(source, operatorPosition, prefix, "group a negative power base as (-base) or negate the completed power as -(base ** exponent)");
                }
                signPosition = skipTrivia(source, signPosition + 1, prefix);
            }
        }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(target, source, operatorPosition + operator.width, prefix, locals, functions, params, currentName, "", rightMinimum);
        if operator.text == "and" or operator.text == "or" {
            if left.kind =!= "Bool" or right.kind =!= "Bool" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
            }
            if left.constant and right.constant {
                value := if operator.text == "and" {
                    left.intValue =!= 0 and right.intValue =!= 0
                } else {
                    left.intValue =!= 0 or right.intValue =!= 0
                };
                left = boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
            } else {
                left = boolParsed(targetLogicCode(target, operator.text, left.code, right.code), false, false, right.next);
            }
        } else if isComparison(operator.text) {
            firstPair := compareParsed(target, source, operatorPosition, operator.text, left, right, prefix);
            var nextPosition := skipTrivia(source, right.next, prefix);
            var nextOperator := comparisonOperatorAt(source, nextPosition);
            if not isComparison(nextOperator.text) {
                left = firstPair;
            } else {
                codes: mut List<String> = [left.code, right.code];
                kinds: mut List<String> = [left.kind, right.kind];
                operators: mut List<String> = [operator.text];
                var count := 1;
                var previous := right;
                var end := right.next;
                var constant := left.constant and right.constant;
                var value := firstPair.intValue =!= 0;
                loop isComparison(nextOperator.text) {
                    operand := self(target, source, nextPosition + nextOperator.width, prefix, locals, functions, params, currentName, "", level + 1);
                    pair := compareParsed(target, source, nextPosition, nextOperator.text, previous, operand, prefix);
                    listLib.pushBack(mut codes, operand.code);
                    listLib.pushBack(mut kinds, operand.kind);
                    listLib.pushBack(mut operators, nextOperator.text);
                    constant = constant and operand.constant;
                    if constant { value = value and pair.intValue =!= 0; }
                    count = count + 1;
                    previous = operand;
                    end = operand.next;
                    nextPosition = skipTrivia(source, end, prefix);
                    nextOperator = comparisonOperatorAt(source, nextPosition);
                }
                if constant { left = boolParsed(targetBoolLiteralCode(target, value), value, true, end); }
                else { left = boolParsed(targetComparisonChainCode(target, codes, kinds, operators, count, operatorPosition), false, false, end); }
            }
        } else if operator.text == "**" {
            if (left.kind =!= "Int" and left.kind =!= "Float") or (right.kind =!= "Int" and right.kind =!= "Float") {
                failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
            }
            code := targetFloatPowerCode(target, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition);
            left = (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if left.kind == "Int" and right.kind == "Int" {
            if left.constant and right.constant {
                folded := tryFoldInteger(operator.text, left.intValue, right.intValue);
                if folded.ok {
                    code := if (operator.text == "%" or operator.text == ":%") and left.intValue == integer.intMin() and right.intValue == -1 {
                            targetIntLiteralCode(target, 0, false, "0")
                        } else if operator.text == ":/" { targetFloorDivCode(target, left.code, right.code) }
                        else if operator.text == ":%" { targetFloorModCode(target, left.code, right.code) }
                        else { "(" + left.code + " " + operator.text + " " + right.code + ")" };
                    left = intParsed(code, folded.value, true, right.next);
                } else {
                    left = intParsed(runtimeIntegerCode(target, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
                }
            } else {
                left = intParsed(runtimeIntegerCode(target, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
            }
        } else if operator.text == "+" and left.kind == "String" and right.kind == "String" {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = textParsed(targetTextLiteralCode(target, combined), combined, true, right.next);
            } else {
                left = textParsed(targetConcatCode(target, left.code, right.code), "", false, right.next);
            }
        } else if (left.kind == "Int" or left.kind == "Float") and (right.kind == "Int" or right.kind == "Float") {
            if operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
            }
            code := targetFloatBinaryCode(target, operator.text, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition);
            left = (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if isListKind(left.kind) or isListKind(right.kind) {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if operator.text == "+" {
            failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
    }
    if leaderStart >= 0 and left.kind =!= "Bool" {
        failAt(source, leaderStart, prefix, "leading " + leaderText + " requires a Bool expression");
    }
    left
}

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, 0)
}

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, "", 0)
}

/** Reads the logical diagnostic name supplied by the compiler host. */
pub sourcePrefix := fn(): String {
    var prefix := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 0 { prefix = argument; }
        argumentIndex = argumentIndex + 1;
    }
    prefix
}

/** Reads the compiler-host verified identity of the root source module. */
pub sourceModuleIdentity := fn(): String {
    var identity := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 1 { identity = argument; }
        argumentIndex = argumentIndex + 1;
    }
    identity
}

/** Reads the canonical root path used to resolve language-level imports. */
pub sourceModulePath := fn(): String {
    var path := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 2 { path = argument; }
        argumentIndex = argumentIndex + 1;
    }
    path
}

/** Collapses a tuple or list kind to its `Tuple`/`List` item suffix while leaving scalar item kinds unchanged. */
storageKind := fn(kind: String): String {
    if isListKind(kind) { "List" }
    else if isTupleKind(kind) { "Tuple" }
    else { kind }
}

/** Returns the text payload stored with one local item: the canonical List kind for List items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String {
    if isListKind(parsed.kind) { parsed.kind } else { parsed.textValue }
}

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String): Items {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    if not textLib.wordAt(source, inner, "if") { return []; }
    result: mut List<Item> = [];
    var cursor := skipTrivia(source, inner + 2, prefix);
    var isFirst := true;
    loop true {
        conditionStart := cursor;
        condition := parseExpression(target, source, conditionStart, prefix, locals, functions, params, currentName);
        if condition.kind =!= "Bool" {
            failAt(source, conditionStart, prefix, "if condition must be Bool");
        }
        conditionCode := if condition.constant {
            targetBoolLiteralCode(target, condition.intValue =!= 0)
        } else {
            condition.code
        };
        open := expectSymbol(source, skipTrivia(source, condition.next, prefix), "{", prefix);
        branchStart := skipTrivia(source, open, prefix);
        branch := parseExpressionAs(target, source, branchStart, prefix, locals, functions, params, currentName, targetKind);
        if branch.kind =!= targetKind {
            failAt(source, targetAt, prefix, "cannot assign " + displayKind(branch.kind) + " to " + displayKind(targetKind) + " local " + targetName);
        }
        cursor = expectSymbol(source, skipTrivia(source, branch.next, prefix), "}", prefix);
        listLib.pushBack(mut result, (kind = if isFirst { "If" } else { "ElseIf" }, name = "", runtime = "", code = conditionCode,
            intValue = 0, textValue = ""));
        listLib.pushBack(mut result, (kind = "Assign" + storageKind(targetKind), name = targetName, runtime = targetRuntime,
            code = copiedValueCode(target, targetKind, branch.code), intValue = branch.intValue, textValue = itemTextPayload(branch)));
        isFirst = false;
        afterBranch := skipTrivia(source, cursor, prefix);
        if not textLib.wordAt(source, afterBranch, "else") {
            var end := afterBranch;
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            statementNext := if matched { consumeStatementEnd(source, end, prefix) } else { -1 };
            if statementNext < 0 {
                failAt(source, afterBranch, prefix, "value if requires a final else");
            }
            listLib.pushBack(mut result, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            listLib.pushBack(mut result, (kind = "End", name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
            return result;
        }
        afterElse := skipTrivia(source, afterBranch + 4, prefix);
        if not textLib.wordAt(source, afterElse, "if") {
            return [];
        }
        cursor = skipTrivia(source, afterElse + 2, prefix);
    }
    []
}

/** Returns the position after the braced block starting at `open`, or -1 when it never closes. Strings and comments are skipped. */
scanBraceEnd := fn(source: String, open: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := open;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** Returns the position of the `{` that opens the branch after the condition starting at `start`, or -1 when absent. */
scanConditionOpen := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "{" and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** True when the braced body from `open` to `close` is a nonempty single expression: no semicolon and no statement keyword first. */
valueIfBranchAt := fn(source: String, open: Int, close: Int, prefix: String): Bool {
    var cursor := skipTrivia(source, open + 1, prefix);
    if cursor >= close { return false; }
    if textLib.isNameStart(textLib.at(source, cursor)) {
        word := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        if word == "return" or word == "outputLine" or word == "output" or word == "var" or word == "loop" or
            word == "break" or word == "continue" or word == "else" or word == "fn" {
            return false;
        }
    }
    var scan := cursor;
    loop scan < close {
        ch := textLib.at(source, scan);
        if ch == "\"" {
            scan = skipAliasString(source, scan);
        } else if textLib.startsWithAt(source, scan, "/*") {
            scan = skipComment(source, scan, prefix);
        } else if ch == ";" {
            return false;
        } else {
            scan = scan + 1;
        }
    }
    true
}

/**
 * Returns the position after one complete value-if chain starting at `position`,
 * or -1 when it lacks a final else. With `requireValueBranches` every branch must
 * be a single expression; otherwise branches may hold statements before their
 * tail expression, which lets a function tail use an action-shaped if.
 */
/** Scans a value-if chain, optionally allowing a partial chain without a final else. */
scanIfChainEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool, allowPartial: Bool): Int {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    if not textLib.wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        if requireValueBranches and not valueIfBranchAt(source, open, end - 1, prefix) { return -1; }
        after := skipTrivia(source, end, prefix);
        if not textLib.wordAt(source, after, "else") {
            return if allowPartial { end } else { -1 };
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if textLib.wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textLib.at(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            if finalEnd < 0 { return -1; }
            if requireValueBranches and not valueIfBranchAt(source, afterElse, finalEnd - 1, prefix) { return -1; }
            return finalEnd;
        }
    }
    -1
}

/** Scans a total value-if chain ending with a final else block. */
scanValueIfEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int {
    scanIfChainEnd(source, position, prefix, requireValueBranches, false)
}

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    if textLib.wordAt(source, inner, "if") {
        scannedEnd := scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinary(target, source, inner, prefix, locals, functions, params, currentName, expected, -1);
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                    textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseExpressionAs(target, source, position, prefix, locals, functions, params, currentName, expected)
}

/** Returns the entries of `locals` declared below `depth`, preserving order, so current-block bindings are dropped even when an outer assignment was recorded after them. */
visibleLocals := fn(locals: List<Local>, depth: Int): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if entry.depth < depth {
            listLib.pushBack(mut kept, entry);
        }
    }
    kept
}

/**
 * True when the innermost block expects a value tail: a function body or one of
 * the value-if branches that complete one.
 */
atValueTail := fn(blocks: List<String>, blockCount: Int): Bool {
    if blockCount <= 0 { return false; }
    kind := blocks[blockCount - 1];
    kind == "function" or kind == "ifvalue"
}

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool {
    loop blocks as kind {
        if kind == "loop" { return true; }
    }
    false
}

/** Locates an ordinary item's separator or enclosing close for contextual tail typing, without interpreting values. */
scanExpressionItemEnd := fn(source: String, start: Int, prefix: String): Int {
    var cursor := start;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if depth == 0 and (ch == ";" or ch == "}") { return cursor; }
        else {
            if ch == "(" or ch == "[" or ch == "{" { depth = depth + 1; }
            else if ch == ")" or ch == "]" or ch == "}" { depth = depth - 1; }
            cursor = cursor + 1;
        }
    }
    cursor
}

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool): (next: Int, returned: Bool, code: String, valueKind: String) {
    var expected := currentResult;
    if currentResult == "Float" {
        expected = "";
        if valueTail {
            end := scanExpressionItemEnd(source, position, prefix);
            next := skipItemSeparators(source, end, prefix);
            if next < textLib.length(source) and textLib.at(source, next) == "}" { expected = "Float"; }
        }
    }
    parsed := parseExpressionAs(target, source, position, prefix, locals, functions, params, currentName, expected);
    ended := consumeStatementEnd(source, parsed.next, prefix);
    if ended < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after expression statement"); }
    next := skipItemSeparators(source, ended, prefix);
    returned := currentName =!= "" and valueTail and next < textLib.length(source) and textLib.at(source, next) == "}";
    if returned and not isCompatibleKind(currentResult, parsed.kind) {
        failAt(source, position, prefix, "cannot return " + displayKind(parsed.kind) + " from function " + currentName +
            " returning " + displayKind(currentResult));
    }
    (next = next, returned = returned, code = if returned { if parsed.kind == "Unit" { targetUnitEvaluationCode(target, parsed.code) } else { assignValueCode(target, currentResult, parsed.kind, parsed.code) } } else { parsed.code }, valueKind = parsed.kind)
}

/** Joins a block's definite completion: scopes preserve it, loops require a true header, and conditionals require every arm plus a final else. */
blockCompletion := fn(kind: String, completed: Bool, branchesComplete: Bool, hasElse: Bool, loopForever: Bool): Bool {
    if kind == "scope" { completed }
    else if kind == "loop" { loopForever and completed }
    else { hasElse and branchesComplete and completed }
}

/** Finds later root scalar definitions for deferred function-body name resolution; eager root expressions never receive this table. */
collectFutureValues := fn(target: String, source: String, prefix: String): List<FutureValue> {
    values: mut List<FutureValue> = [];
    size := textLib.length(source);
    var cursor := 0;
    var braceDepth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "{" {
            braceDepth = braceDepth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            if braceDepth > 0 { braceDepth = braceDepth - 1; }
            cursor = cursor + 1;
        } else if braceDepth == 0 and textLib.isNameStart(ch) {
            nameStart := cursor;
            nameEnd := textLib.skipName(source, cursor);
            afterName := skipTrivia(source, nameEnd, prefix);
            if textLib.startsWithAt(source, afterName, ":=") {
                valueStart := skipTrivia(source, afterName + 2, prefix);
                if not textLib.wordAt(source, valueStart, "fn") and not textLib.wordAt(source, valueStart, "type") {
                    valueCh := textLib.at(source, valueStart);
                    var kind := "";
                    var intValue := 0;
                    var textValue := "";
                    if textLib.isDigit(valueCh) or valueCh == "+" or valueCh == "-" {
                        parsed := parseNumber(target, source, valueStart, prefix);
                        kind = parsed.kind;
                        intValue = parsed.intValue;
                    } else if valueCh == "\"" {
                        parsed := parseText(target, source, valueStart, prefix);
                        kind = parsed.kind;
                        textValue = parsed.textValue;
                    } else if textLib.wordAt(source, valueStart, "true") or textLib.wordAt(source, valueStart, "false") {
                        kind = "Bool";
                        intValue = if textLib.wordAt(source, valueStart, "true") { 1 } else { 0 };
                    }
                    if kind =!= "" {
                        valueName := textLib.slice(source, nameStart, nameEnd);
                        listLib.pushBack(mut values, (name = valueName, runtime = "lite_" + valueName,
                            kind = kind, at = nameStart, intValue = intValue, textValue = textValue));
                    }
                }
                cursor = valueStart;
            } else {
                cursor = nameEnd;
            }
        } else {
            cursor = cursor + 1;
        }
    }
    values
}

/** Removes deferred-only entries after one function body has been checked. */
withoutFutureValues := fn(locals: List<Local>): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if entry.depth >= 0 { listLib.pushBack(mut kept, entry); }
    }
    kept
}

/** Parses one top-level aliased import and returns its next source position. */
parseImportClause := fn(target: String, source: String, position: Int, alias: String, prefix: String): Item {
    if alias == "" { failAt(source, position, prefix, "import requires a module alias"); }
    pathStart := skipTrivia(source, position + 6, prefix);
    if pathStart >= textLib.length(source) or textLib.at(source, pathStart) =!= "\"" {
        failAt(source, pathStart, prefix, "import requires a quoted source path");
    }
    path := parseText(target, source, pathStart, prefix);
    pathLength := textLib.length(path.textValue);
    var invalidPath := pathLength == 0;
    var pathIndex := 0;
    loop pathIndex < pathLength {
        if textLib.at(path.textValue, pathIndex) == "\\" { invalidPath = true; }
        pathIndex = pathIndex + 1;
    }
    if invalidPath {
        failAt(source, pathStart, prefix, "import path must be nonempty and use \"/\" separators");
    }
    statementNext := consumeStatementEnd(source, path.next, prefix);
    if statementNext < 0 {
        failAt(source, skipTrivia(source, path.next, prefix), prefix, "expected ; after import");
    }
    (kind = "Import", name = alias, runtime = "", code = "", intValue = statementNext, textValue = path.textValue)
}

/** Collects top-level import clauses before parsing so imported declarations can seed the importing file's symbol table. */
pub collectImportClauses := fn(target: String, source: String, prefix: String): Items {
    imports: mut Items = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.isNameStart(ch) {
            nameEnd := textLib.skipName(source, position);
            name := textLib.slice(source, position, nameEnd);
            if name == "import" {
                imported := parseImportClause(target, source, position, "", prefix);
                listLib.pushBack(mut imports, imported);
                position = imported.intValue;
            } else {
                afterName := skipTrivia(source, nameEnd, prefix);
                afterDeclare := skipTrivia(source, afterName + 2, prefix);
                if textLib.startsWithAt(source, afterName, ":=") and textLib.wordAt(source, afterDeclare, "import") {
                    imported := parseImportClause(target, source, afterDeclare, name, prefix);
                    listLib.pushBack(mut imports, imported);
                    position = imported.intValue;
                } else {
                    position = nameEnd;
                }
            }
        } else {
            position = position + 1;
        }
    }
    imports
}

/** Collects function names explicitly marked `pub`. */
collectPublishedFunctions := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                value := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and textLib.wordAt(source, value, "fn") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Collects immutable value names explicitly marked `pub`; imported type aliases remain pending. */
collectPublishedValues := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                value := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and
                    not textLib.wordAt(source, value, "fn") and not textLib.wordAt(source, value, "type") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Collects top-level transparent type aliases explicitly marked `pub`. */
collectPublishedTypes := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                typeStart := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and textLib.wordAt(source, typeStart, "type") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Parses one legacy or imported output statement into the same ordered argument group and ending marker. */
parseOutputStatement := fn(target: String, source: String, openPosition: Int, outputName: String, prefix: String,
    locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
    live: Bool): Items {
    var position := openPosition;
    if position >= textLib.length(source) or textLib.at(source, position) =!= "(" {
        failAt(source, position, prefix, "expected ( after " + outputName);
    }
    position = skipTrivia(source, position + 1, prefix);
    result: mut List<Item> = [];
    loop position < textLib.length(source) and textLib.at(source, position) =!= ")" {
        argument := parseExpression(target, source, position, prefix, locals, functions, params, currentName);
        if live { listLib.pushBack(mut result, (kind = argument.kind, name = "", runtime = "", code = argument.code,
            intValue = argument.intValue, textValue = argument.textValue)); }
        position = skipTrivia(source, argument.next, prefix);
        if position < textLib.length(source) and textLib.at(source, position) == "," {
            position = skipTrivia(source, position + 1, prefix);
        } else {
            break;
        }
    }
    position = expectSymbol(source, position, ")", prefix);
    statementNext := consumeStatementEnd(source, position, prefix);
    if statementNext < 0 { failAt(source, skipTrivia(source, position, prefix), prefix, "expected ; after " + outputName); }
    listLib.pushBack(mut result, (kind = if outputName == "outputLine" { "End" } else { "EndOutput" },
        name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
    result
}

/** Parses `(name1, name2, ...)` for tuple destructuring declarations, rejecting empty, reserved or duplicate bindings. */
parseTupleDestructureTarget := fn(source: String, open: Int, prefix: String): (namesText: String, count: Int, next: Int) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, open + 1, prefix);
    names: mut List<String> = [];
    var count := 0;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a binding name in tuple destructuring");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        bindName := textLib.slice(source, nameStart, cursor);
        if isReservedWord(bindName) { unsupportedFeature(source, nameStart, bindName, prefix); }
        if listLib.listContainsText(names, bindName) {
            failAt(source, nameStart, prefix, "duplicate tuple destructuring binding " + bindName);
        }
        listLib.pushBack(mut names, bindName);
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            cursor = skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if count == 0 {
        failAt(source, open, prefix, "tuple destructuring needs at least one binding");
    }
    next := expectSymbol(source, cursor, ")", prefix);
    (namesText = textLib.joinTexts(names, ","), count = count, next = next)
}

/** Parses complete source with imported public function signatures available in its root symbol table. Exits 2 on unsupported, malformed or faulting source. */
pub parseProgramWithIdentity := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int,
    moduleIdentity: String): Items {
    size := textLib.length(source);
    var position := skipTrivia(source, 0, prefix);
    items: mut Items = [];
    if position == size { return items; }
    aliases: mut List<AliasDecl> = [];
    loop exports as exported {
        if exported.kind == "PublicType" {
            listLib.pushBack(mut aliases, (name = exported.name, target = exported.code, at = -1, end = 0));
        }
    }
    loop collectAliases(source, prefix) as alias { listLib.pushBack(mut aliases, alias); }
    publishedFunctions := collectPublishedFunctions(source, prefix);
    publishedValues := collectPublishedValues(source, prefix);
    publishedTypes := collectPublishedTypes(source, prefix);
    futureValues := collectFutureValues(target, source, prefix);
    var locals: mut List<Local> = [];
    blocks: mut List<String> = [];
    functions: mut List<FunctionInfo> = [];
    functionParams: mut List<String> = [];
    declaredImportAliases: mut List<String> = [];
    var parameterTotal := 0;
    loop exports as exported {
        if exported.kind == "ModuleAlias" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported module name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = "", kind = "Module", mutable = false,
                writable = false, depth = 0, constant = false, code = "", intValue = exported.intValue,
                textValue = exported.name));
        } else if exported.kind == "PublicFunction" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            first := parameterTotal;
            var entryStart := 0;
            var entryIndex := 0;
            loop entryIndex < exported.intValue {
                separator := textLib.indexOfText(exported.textValue, "|", entryStart);
                var entryEnd := textLib.length(exported.textValue);
                if separator >= 0 { entryEnd = separator; }
                listLib.pushBack(mut functionParams, textLib.slice(exported.textValue, entryStart, entryEnd));
                parameterTotal = parameterTotal + 1;
                entryStart = entryEnd + 1;
                entryIndex = entryIndex + 1;
            }
            listLib.pushBack(mut functions, (name = exported.name, runtime = exported.runtime, result = exported.code,
                first = first, count = exported.intValue));
        } else if exported.kind == "PublicValue" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = exported.runtime, kind = exported.code,
                mutable = false, writable = false, depth = 0, constant = false, code = exported.runtime,
                intValue = 0, textValue = ""));
        } else if exported.kind == "PublicType" {
            if findAlias(aliases, exported.name) < 0 {
                diagLib.fail(prefix, "unknown imported public type " + exported.name);
            }
        }
    }
    var blockCount := 0;
    var depth := 0;
    var currentName := "";
    var currentResult := "";
    var currentReturned := false;
    var currentStopped := false;
    var branchesReturned := true;
    var branchesStopped := true;
    var hasElse := false;
    var loopForever := false;
    var currentLive := true;
    savedStates: mut List<BlockState> = [];
    loop position < size {
        ch := textLib.at(source, position);
        if ch == ";" {
            position = skipItemSeparators(source, position, prefix);
            continue;
        }
        if ch == "}" {
            if blockCount == 0 {
                failAt(source, position, prefix, "unexpected }");
            }
            blockKind := blocks[blockCount - 1];
            if blockKind == "ifvalue" and currentResult =!= "Unit" and not currentReturned {
                failAt(source, position, prefix, "branch of function " + currentName + " must return " + displayKind(currentResult));
            }
            after := skipTrivia(source, position + 1, prefix);
            if (blockKind == "if" or blockKind == "ifvalue") and after < size and textLib.wordAt(source, after, "else") {
                locals = visibleLocals(locals, depth);
                afterElse := skipTrivia(source, after + 4, prefix);
                branchesReturned = branchesReturned and currentReturned;
                branchesStopped = branchesStopped and currentStopped;
                currentReturned = false;
                currentStopped = false;
                hasElse = not textLib.wordAt(source, afterElse, "if");
                droppedIf := listLib.popBack(mut blocks);
                blockCount = blockCount - 1;
                if textLib.wordAt(source, afterElse, "if") {
                    conditionStart := skipTrivia(source, afterElse + 2, prefix);
                    condition := parseExpression(target, source, conditionStart, prefix, locals, functions, functionParams, currentName);
                    if condition.kind =!= "Bool" {
                        failAt(source, conditionStart, prefix, "else if condition must be Bool");
                    }
                    conditionCode := if condition.constant {
                        targetBoolLiteralCode(target, condition.intValue =!= 0)
                    } else {
                        condition.code
                    };
                    position = expectSymbol(source, skipTrivia(source, condition.next, prefix), "{", prefix);
                    if currentLive { listLib.pushBack(mut items, (kind = "ElseIf", name = "", runtime = "", code = conditionCode,
                        intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, blockKind);
                    blockCount = blockCount + 1;
                } else {
                    if currentLive { listLib.pushBack(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, if blockKind == "ifvalue" { "ifvalue" } else { "else" });
                    blockCount = blockCount + 1;
                    position = expectSymbol(source, afterElse, "{", prefix);
                }
                position = skipTrivia(source, position + 1, prefix);
                continue;
            }
            locals = visibleLocals(locals, depth);
            depth = depth - 1;
            if blockKind == "function" {
                locals = withoutFutureValues(locals);
                if currentResult =!= "Unit" and not currentReturned {
                    failAt(source, position, prefix, "function " + currentName + " must return " + currentResult);
                }
                functionRuntime := if moduleId == 0 { "liteFn_" + currentName }
                    else { "liteFn_m" + integer.intText(moduleId) + "_" + currentName };
                if currentLive { listLib.pushBack(mut items, (kind = "FunctionEnd", name = "", runtime = functionRuntime,
                    code = "", intValue = 0, textValue = "")); }
                currentName = "";
                currentResult = "";
                currentReturned = false;
            } else if blockKind == "loop" {
                if currentLive { listLib.pushBack(mut items, (kind = "EndLoop", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else if blockKind == "scope" {
                if currentLive { listLib.pushBack(mut items, (kind = "EndScope", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else {
                if currentLive { listLib.pushBack(mut items, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            }
            completedReturn := blockCompletion(blockKind, currentReturned, branchesReturned, hasElse, loopForever);
            completedStop := blockCompletion(blockKind, if blockKind == "loop" { currentReturned } else { currentStopped },
                branchesStopped, hasElse, loopForever);
            if blockKind == "loop" and completedReturn and currentLive {
                listLib.pushBack(mut items, (kind = "Unreachable", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            }
            parent := listLib.popBack(mut savedStates);
            currentReturned = parent.returned or (not parent.stopped and completedReturn and blockKind =!= "function");
            currentStopped = parent.stopped or (completedStop and blockKind =!= "function");
            branchesReturned = parent.branchesReturned;
            branchesStopped = parent.branchesStopped;
            hasElse = parent.hasElse;
            loopForever = parent.loopForever;
            currentLive = parent.live;
            droppedBlock := listLib.popBack(mut blocks);
            blockCount = blockCount - 1;
            position = skipTrivia(source, position + 1, prefix);
            if position < size and textLib.at(source, position) == ";" {
                position = skipTrivia(source, position + 1, prefix);
            }
            continue;
        }
        if ch == "{" {
            if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = "Scope", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            listLib.pushBack(mut savedStates, (returned = currentReturned, stopped = currentStopped,
                branchesReturned = branchesReturned, branchesStopped = branchesStopped, hasElse = hasElse, loopForever = loopForever, live = currentLive));
            currentLive = currentLive and not currentStopped;
            currentReturned = false;
            currentStopped = false;
            branchesReturned = true;
            branchesStopped = true;
            hasElse = false;
            loopForever = false;
            listLib.pushBack(mut blocks, "scope");
            blockCount = blockCount + 1;
            depth = depth + 1;
            position = skipTrivia(source, position + 1, prefix);
            continue;
        }
        var destructureOpen := -1;
        var destructureMutable := false;
        if ch == "(" {
            parenEnd := scanParenEnd(source, position, prefix);
            afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
            if afterParen >= 0 and textLib.startsWithAt(source, afterParen, ":=") {
                destructureOpen = position;
            }
        } else if ch == "v" and textLib.wordAt(source, position, "var") {
            afterVar := skipTrivia(source, position + 3, prefix);
            if afterVar < size and textLib.at(source, afterVar) == "(" {
                destructureOpen = afterVar;
                destructureMutable = true;
            }
        }
        if destructureOpen >= 0 {
            destructure := parseTupleDestructureTarget(source, destructureOpen, prefix);
            afterTarget := skipTrivia(source, destructure.next, prefix);
            if not textLib.startsWithAt(source, afterTarget, ":=") {
                failAt(source, afterTarget, prefix, "expected := after tuple destructuring target");
            }
            rhs := parseInitializerExpression(target, source, skipTrivia(source, afterTarget + 2, prefix), prefix, locals, functions, functionParams, currentName, "");
            if not isTupleKind(rhs.kind) {
                failAt(source, destructureOpen, prefix, "tuple destructuring requires a tuple value, got " + displayKind(rhs.kind));
            }
            if tupleComponentCount(rhs.kind) =!= destructure.count {
                failAt(source, destructureOpen, prefix, "tuple destructuring expected " + integer.intText(destructure.count) +
                    " fields, got " + integer.intText(tupleComponentCount(rhs.kind)));
            }
            statementNext := consumeStatementEnd(source, rhs.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
            position = statementNext;
            tempRuntime := "lite$tuple_" + integer.intText(destructureOpen);
            if currentLive and not currentStopped {
                listLib.pushBack(mut items, (kind = "LocalTuple", name = "", runtime = tempRuntime,
                    code = rhs.code, intValue = 0, textValue = ""));
            }
            var bindCursor := 0;
            var bindIndex := 0;
            namesLen := textLib.length(destructure.namesText);
            loop bindIndex < destructure.count {
                var bindEnd := bindCursor;
                loop bindEnd < namesLen and textLib.at(destructure.namesText, bindEnd) =!= "," {
                    bindEnd = bindEnd + 1;
                }
                bindName := textLib.slice(destructure.namesText, bindCursor, bindEnd);
                bindCursor = bindEnd + 1;
                if depth == 0 and blockCount == 0 {
                    rootIndex := localIndex(locals, bindName);
                    if rootIndex >= 0 and locals[rootIndex].depth == 0 {
                        failAt(source, destructureOpen, prefix, "duplicate top-level value " + bindName);
                    }
                }
                comp := tupleComponent(rhs.kind, bindIndex);
                bindRuntime := localRuntimeName(locals, bindName, destructureOpen + bindIndex + 1, moduleId);
                fieldCode := tempRuntime + "." + comp.prop;
                listLib.pushBack(mut locals, (name = bindName, runtime = bindRuntime, kind = comp.kind,
                    mutable = destructureMutable, writable = false, depth = depth, constant = false, code = fieldCode,
                    intValue = 0, textValue = ""));
                if currentLive and not currentStopped {
                    itemPrefix := if destructureMutable { "Var" } else { "Local" };
                    listLib.pushBack(mut items, (kind = itemPrefix + storageKind(comp.kind), name = bindName, runtime = bindRuntime,
                        code = fieldCode, intValue = 0, textValue = ""));
                }
                bindIndex = bindIndex + 1;
            }
            continue;
        }
        if textLib.isDigit(ch) or ch == "\"" or ch == "(" or ch == "[" or ch == "+" or ch == "-" or
            (ch == "a" and textLib.wordAt(source, position, "and")) or (ch == "o" and textLib.wordAt(source, position, "or")) or
            (ch == "n" and textLib.wordAt(source, position, "not")) or (ch == "t" and textLib.wordAt(source, position, "true")) or
            (ch == "f" and textLib.wordAt(source, position, "false")) {
            expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
                currentResult, atValueTail(blocks, blockCount) and not currentStopped);
            if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = if expression.returned { "Return" } else { "Discard" }, name = expression.valueKind,
