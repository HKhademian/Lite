/** Shared restricted front-end. */

/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntScalarKind := fn(kind: String): Bool { ir.isIntScalarKind(kind) }

/** True when `kind` is one of the binary float scalar types (`Float32`, `Float`). */
pub isFloatScalarKind := fn(kind: String): Bool { ir.isFloatScalarKind(kind) }

/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements. */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);
/** One program or module-graph item. */
pub Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Parsed module/compiler items returned by parseProgram and consumed by the module collector and backend emitters. */
pub Items := type List<Item>;
/** Completion facts saved while an inner block is parsed. */
BlockState := type (returned: Bool, stopped: Bool, branchesReturned: Bool, branchesStopped: Bool, hasElse: Bool, loopForever: Bool, live: Bool, preLocalsLen: Int, liveBranchCount: Int);
/** Symbol declaration name owned directly by the block at `depth` for same-block uniqueness checks. */
BlockDecl := type (name: String, depth: Int);
/** One outer local initialization and callable-dependency update recorded at the end of a conditional branch. */
BranchUpdate := type (depth: Int, runtime: String, initState: String, code: String);
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := type (text: String, width: Int);
/** One previously declared top-level function. */
FunctionInfo := type (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);
/** A later top-level scalar definition visible only while checking a deferred function body. */
FutureValue := type (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);
/** One transparent type alias. */
AliasDecl := type (name: String, target: String, at: Int, end: Int, depth: Int);
/** Lexical control-flow and metadata context for an enclosing construct. */
ConstructCtx := type (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool, colVar: String);
/** 32-bucket hashed string set for O(1) reachable-token membership checks across large module graphs. */
pub TokenBuckets := type (count: Int, b0: String, b1: String, b2: String, b3: String, b4: String, b5: String, b6: String, b7: String, b8: String, b9: String, b10: String, b11: String, b12: String, b13: String, b14: String, b15: String, b16: String, b17: String, b18: String, b19: String, b20: String, b21: String, b22: String, b23: String, b24: String, b25: String, b26: String, b27: String, b28: String, b29: String, b30: String, b31: String);

