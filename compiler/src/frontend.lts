            }
        } else if afterTag < tagSourceSize and textLib.wordAt(source, afterTag, "if") {
            condParseKind = "if";
            condParseStart = afterTag;
            condParseTag = tagInfo.tag;
            condParseTagAt = start;
        } else if afterTag < tagSourceSize and textLib.wordAt(source, afterTag, "match") {
            condParseKind = "match";
            condParseStart = afterTag;
            condParseTag = tagInfo.tag;
            condParseTagAt = start;
        } else if afterTag < tagSourceSize and textLib.wordAt(source, afterTag, "loop") {
            condParseKind = "loop";
            condParseStart = afterTag;
            condParseTag = tagInfo.tag;
            condParseTagAt = start;
        } else {
            failAt(source, afterTag, prefix, "expected {, if, match, loop or . after block tag @" + tagInfo.tag);
        }
    } else if ch == "{" {
        isTaggedBody := bodySink == "tagged";
        isLoopBody := bodySink == "loopBody";
        isStmtBody := bodySink == "stmt";
        isFinallyBody := bodySink == "finally";
        isBranchBody := bodySink == "branch";
        isStandaloneBlock := not isTaggedBody and not isLoopBody and not isStmtBody and not isFinallyBody and not isBranchBody;
        allowOutput := isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isBranchBody or (bodySink == "exprOut");
        bodyDepth := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody { iifeDepth } else { iifeDepth + 1 };
        stmtReturnPrefix := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody { "" } else { "return " };
        blockLocals: mut List<Local> = [];
        loop locals as entry { listLib.pushBack(mut blockLocals, entry); }
        statements: mut List<String> = [];
        var statementCount := 0;
        var blockMarkers := "";
        var cursor := skipItemSeparators(source, start + 1, prefix);
        var blockKind := "Unit";
        var blockCode := targetUnitLiteralCode(target);
        var blockInt := 0;
        var blockText := "";
        var blockConstant := true;
        var blockExits := false;
        var sawTailExpr := false;
        var lastPartialIfDiverges := false;
        blockSourceSize := textLib.length(source);
        loop true {
            cursor = skipItemSeparators(source, cursor, prefix);
            if cursor >= blockSourceSize {
                failAt(source, start, prefix, "expected }");
            }
            if textLib.at(source, cursor) == "}" {
                cursor = cursor + 1;
                break;
            }
            lastPartialIfDiverges = false;
            var isStatement := false;
            var destructureOpen := -1;
            var destructureMutable := false;
            chAtCursor := textLib.at(source, cursor);
            if chAtCursor == "(" {
                parenEnd := scanParenEnd(source, cursor, prefix);
                afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
                if afterParen >= 0 and textLib.startsWithAt(source, afterParen, ":=") {
                    destructureOpen = cursor;
                }
            } else if chAtCursor == "v" and textLib.wordAt(source, cursor, "var") {
                afterVar := skipTrivia(source, cursor + 3, prefix);
                if afterVar < blockSourceSize and textLib.at(source, afterVar) == "(" {
                    destructureOpen = afterVar;
                    destructureMutable = true;
                }
            }
            if destructureOpen >= 0 {
                isStatement = true;
                destructure := parseTupleDestructureTarget(source, destructureOpen, prefix);
                afterTarget := skipTrivia(source, destructure.next, prefix);
