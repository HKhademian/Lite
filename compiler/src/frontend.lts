            continue;
        }
        if textLib.isDigit(ch) or ch == "\"" or ch == "(" or ch == "[" or ch == "+" or ch == "-" or ch == "." or
            (ch == "a" and textLib.wordAt(source, position, "and")) or (ch == "o" and textLib.wordAt(source, position, "or")) or
            (ch == "n" and textLib.wordAt(source, position, "not")) or (ch == "t" and textLib.wordAt(source, position, "true")) or
            (ch == "f" and textLib.wordAt(source, position, "false")) {
            expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
                currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs);
            if currentLive and not currentStopped {
                listLib.pushBack(mut items, (kind = expressionStatementKind(expression.valueKind, expression.returned, "Discard", currentResult), name = expression.valueKind,
                    runtime = "", code = expression.code, intValue = 0, textValue = ""));
                if codeHasRawTransfer(expression.code) {
                    listLib.pushBack(mut transferCodes, expression.code);
                    transferCount = transferCount + 1;
                }
            }
            if expression.returned or expression.valueKind == "Never" {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            position = expression.next;
            continue;
        }
        if ch == "@" {
            tagInfo := parseTagAt(source, position, prefix);
            afterTag := skipTrivia(source, tagInfo.next, prefix);
            if afterTag >= size or (textLib.at(source, afterTag) =!= "{" and textLib.at(source, afterTag) =!= "." and
                not textLib.wordAt(source, afterTag, "if") and not textLib.wordAt(source, afterTag, "match") and
                not textLib.wordAt(source, afterTag, "loop")) {
                failAt(source, afterTag, prefix, "expected {, if, match, loop or . after block tag @" + tagInfo.tag);
            }
            expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
                currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs);
            if currentLive and not currentStopped {
                listLib.pushBack(mut items, (kind = expressionStatementKind(expression.valueKind, expression.returned, "Discard", currentResult), name = expression.valueKind,
                    runtime = "", code = expression.code, intValue = 0, textValue = ""));
                if codeHasRawTransfer(expression.code) {
                    listLib.pushBack(mut transferCodes, expression.code);
                    transferCount = transferCount + 1;
                }
            }
            if expression.returned or expression.valueKind == "Never" {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            position = expression.next;
            continue;
        }
        if not textLib.isNameStart(ch) {
            failAt(source, position, prefix, "expected a statement: output/outputLine, declaration, assignment, if or loop");
        }
        nameStart := position;
        position = textLib.skipName(source, position);
        name := textLib.slice(source, nameStart, position);
        if name == "import" {
            if blockCount =!= 0 {
                failAt(source, nameStart, prefix, "import is only allowed at top level");
            }
            failAt(source, nameStart, prefix, "import requires a module alias");
        }
        if name == "pub" {
            if blockCount =!= 0 {
                failAt(source, nameStart, prefix, "pub is only allowed on top-level declarations");
            }
            declarationStart := skipTrivia(source, position, prefix);
            if declarationStart >= size or not textLib.isNameStart(textLib.at(source, declarationStart)) {
                failAt(source, declarationStart, prefix, "expected a declaration after pub");
            }
            declarationEnd := textLib.skipName(source, declarationStart);
            declarationOperator := skipTrivia(source, declarationEnd, prefix);
            if not textLib.startsWithAt(source, declarationOperator, ":=") {
                failAt(source, declarationOperator, prefix, "expected := after published declaration name");
            }
            position = declarationStart;
            continue;
        }
        position = skipTrivia(source, position, prefix);
        if textLib.startsWithAt(source, position, ":=") {
            afterImport := skipTrivia(source, position + 2, prefix);
            if textLib.wordAt(source, afterImport, "import") {
                if blockCount =!= 0 {
                    failAt(source, nameStart, prefix, "import is only allowed at top level");
                }
