                                    failAt(source, cursor, prefix, "unknown parameter " + namedLabel + " in call to " + calleeDisplay);
                                }
                                if slotExplicit[slot] {
                                    failAt(source, cursor, prefix, "duplicate named argument " + namedLabel + " in call to " + calleeDisplay);
                                }
                                slotExplicit = setBoolAt(slotExplicit, slot, true);
                                slotEntry = setIntAt(slotEntry, slot, entryCount);
                                expected := paramKindOf(callParams[callFirst + slot]);
                                arg := self(=target, =source, position = rhsStart, =prefix, =locals, =functions, =params, =currentName, =expected, minimum = 0, =ctxs, iifeDepth = argIifeDepth, =inferMode, bodySink = "", =aliases);
                                if inferMode { callMarkers = collectParsedMarkers(callMarkers, arg); }
                                listLib.pushBack(mut entryPositions, rhsStart);
                                listLib.pushBack(mut entrySlots, slot);
                                listLib.pushBack(mut entryKinds, arg.kind);
                                listLib.pushBack(mut entryCodes, arg.code);
                                entryCount += 1;
                                cursor = skipTrivia(source, arg.next, prefix);
                            } else {
                                var nextSlot := -1;
                                var scan := 0;
                                loop scan < callCount {
                                    if slotEntry[scan] < 0 {
                                        nextSlot = scan;
                                        break;
                                    }
                                    scan += 1;
                                }
                                if nextSlot < 0 {
                                    suffix := if callCount == 1 { " argument" } else { " arguments" };
                                    failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(callCount) + suffix + ", got more");
                                }
                                slotName := paramNameOf(callParams[callFirst + nextSlot]);
                                posExpected := if listLib.listContainsText(explicitLabels, slotName) { "" } else { paramKindOf(callParams[callFirst + nextSlot]) };
                                slotEntry = setIntAt(slotEntry, nextSlot, entryCount);
                                arg := self(=target, =source, position = cursor, =prefix, =locals, =functions, =params, =currentName, expected = posExpected, minimum = 0, =ctxs, iifeDepth = argIifeDepth, =inferMode, bodySink = "", =aliases);
                                if inferMode { callMarkers = collectParsedMarkers(callMarkers, arg); }
                                listLib.pushBack(mut entryPositions, cursor);
                                listLib.pushBack(mut entrySlots, nextSlot);
                                listLib.pushBack(mut entryKinds, arg.kind);
                                listLib.pushBack(mut entryCodes, arg.code);
                                entryCount += 1;
                                cursor = skipTrivia(source, arg.next, prefix);
                            }
                        }
                        if cursor < size and textLib.at(source, cursor) == "," {
                            cursor = skipTrivia(source, cursor + 1, prefix);
                            if cursor < size and textLib.at(source, cursor) == ")" { break; }
                        } else {
                            break;
                        }
                    }
                }
                cursor = expectSymbol(source, cursor, ")", prefix);
                var filledCount := 0;
                var checkSlot := 0;
                loop checkSlot < callCount {
                    if slotEntry[checkSlot] >= 0 { filledCount += 1; }
                    checkSlot += 1;
                }
                if filledCount =!= callCount {
                    suffix := if callCount == 1 { " argument" } else { " arguments" };
                    failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(callCount) +
                    suffix + ", got " + formatLib.decimalText(filledCount));
                }
                var isIdentityOrder := entryCount == callCount;
                var slotIdx := 0;
                loop slotIdx < callCount {
                    k := slotEntry[slotIdx];
                    if k =!= slotIdx { isIdentityOrder = false; }
                    expected := paramKindOf(callParams[callFirst + slotIdx]);
                    if not isCompatibleKind(expected, entryKinds[k]) {
                        failAt(source, entryPositions[k], prefix, "argument " + formatLib.decimalText(slotIdx + 1) + " of " +
                        calleeDisplay + " must be " + displayKind(expected) + ", got " + displayKind(entryKinds[k]));
                    }
                    slotIdx += 1;
                }
                var emittedCode := "";
                var emittedResultKind := callResult;
                if isIdentityOrder {
                    finalArgs: mut List<String> = [];
                    var pIdx := 0;
                    loop pIdx < callCount {
                        expected := paramKindOf(callParams[callFirst + pIdx]);
                        listLib.pushBack(mut finalArgs, assignValueCode(target, expected, entryKinds[pIdx], entryCodes[pIdx]));
                        pIdx = pIdx + 1;
                    }
                    targetCallee := if isModuleFn { callRuntime } else { "(" + callRuntime + ")" };
                    emittedCode = targetCallee + "(" + textLib.joinTexts(finalArgs, ", ") + ")";
                } else {
                    if target =!= "ts" {
                        failAt(source, errPos, prefix, "C backend does not support named or reordered call arguments yet");
                    }
                    evalStmts: mut List<String> = [];
                    if not isModuleFn {
                        listLib.pushBack(mut evalStmts, "const lite$fn = " + callRuntime + ";");
                    }
                    var callDiverged := false;
                    var kIdx := 0;
                    loop kIdx < entryCount {
                        if not callDiverged {
                            targetSlot := entrySlots[kIdx];
                            if entryKinds[kIdx] == "Never" {
                                listLib.pushBack(mut evalStmts, "return " + entryCodes[kIdx] + ";");
                                callDiverged = true;
                            } else if slotEntry[targetSlot] == kIdx {
                                temp := "lite$arg" + integer.intText(kIdx);
                                expected := paramKindOf(callParams[callFirst + targetSlot]);
                                listLib.pushBack(mut evalStmts, "const " + temp + " = " + assignValueCode(target, expected, entryKinds[kIdx], entryCodes[kIdx]) + ";");
                            } else {
                                listLib.pushBack(mut evalStmts, "void (" + entryCodes[kIdx] + ");");
                            }
                        }
                        kIdx = kIdx + 1;
                    }
                    if callDiverged {
                        emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " })()";
                        emittedResultKind = "Never";
                    } else {
                        slotTemps: mut List<String> = [];
                        var sIdx := 0;
                        loop sIdx < callCount {
                            listLib.pushBack(mut slotTemps, "lite$arg" + integer.intText(slotEntry[sIdx]));
                            sIdx = sIdx + 1;
                        }
                        targetCallee := if isModuleFn { callRuntime } else { "lite$fn" };
                        callExpr := targetCallee + "(" + textLib.joinTexts(slotTemps, ", ") + ")";
                        retStmt := if callResult == "Unit" { "void (" + callExpr + "); return undefined;" } else { "return " + callExpr + ";" };
                        emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " " + retStmt + " })()";
                    }
                }
                left = withMarkers((kind = emittedResultKind, code = emittedCode, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers);
            }
        } else if postPosition < textLib.length(source) and textLib.at(source, postPosition) == "(" {
            failAt(source, postPosition, prefix, "cannot call non-function value of type " + displayKind(left.kind));
        } else {
            break;
        }
    }
    loop true {
        if left.next > 0 and textLib.at(source, left.next - 1) == "}" { break; }
        operatorPosition := skipTrivia(source, left.next, prefix);
        if operatorPosition >= textLib.length(source) { break; }
        operator := readOperator(source, operatorPosition);
        if operator.text == "" { break; }
        level := operatorLevel(operator.text);
        if level < effectiveMinimum { break; }
        if operator.text == "**" {
            var signPosition := start;
            loop signPosition < textLib.length(source) and (textLib.at(source, signPosition) == "+" or textLib.at(source, signPosition) == "-") {
                if textLib.at(source, signPosition) == "-" {
                    failAt(source, operatorPosition, prefix, "group a negative power base as (-base) or negate the completed power as -(base ** exponent)");
                }
                signPosition = skipTrivia(source, signPosition + 1, prefix);
            }
        }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(target, source, operatorPosition + operator.width, prefix, locals, functions, params, currentName, "", rightMinimum, ctxs, iifeDepth, inferMode, "", aliases);
        var opMarkers := if inferMode { collectParsedMarkers(collectParsedMarkers("", left), right) } else { "" };
        leftLoopId := loopValMarkerId(left.kind);
        rightLoopId := loopValMarkerId(right.kind);
        if inferMode and (leftLoopId >= 0 or rightLoopId >= 0) {
            if leftLoopId >= 0 and rightLoopId >= 0 {
                if operator.text == "and" or operator.text == "or" {
                    opMarkers = opMarkers + integer.intText(leftLoopId) + "=Bool\n" + integer.intText(rightLoopId) + "=Bool\n";
                    left = boolParsed("", false, false, right.next);
                } else if isComparison(operator.text) {
                    var chainEnd := right.next;
                    var nextPos := skipTrivia(source, chainEnd, prefix);
                    var nextOp := comparisonOperatorAt(source, nextPos);
                    loop isComparison(nextOp.text) {
                        operand := self(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                        opMarkers = collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = skipTrivia(source, chainEnd, prefix);
                        nextOp = comparisonOperatorAt(source, nextPos);
                    }
                    left = boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    left = (kind = "Float", code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else {
                    left = (kind = left.kind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                }
            } else {
                targetLoopId := if leftLoopId >= 0 { leftLoopId } else { rightLoopId };
                peerKind := if leftLoopId >= 0 { right.kind } else { left.kind };
                if operator.text == "and" or operator.text == "or" {
                    if peerKind =!= "Bool" {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=Bool\n";
                    left = boolParsed("", false, false, right.next);
                } else if isComparison(operator.text) {
                    if peerKind == "Never" { failAt(source, operatorPosition, prefix, "cannot compare Never values"); }
                    if isTupleKind(peerKind) { failAt(source, operatorPosition, prefix, "cannot compare tuple values"); }
                    if isListKind(peerKind) { failAt(source, operatorPosition, prefix, "cannot compare list values"); }
                    if isFnKind(peerKind) { failAt(source, operatorPosition, prefix, "cannot compare function values"); }
                    if operator.text =!= "==" and operator.text =!= "=!=" and not numeric.isNumericKind(peerKind) {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    var chainEnd := right.next;
                    var nextPos := skipTrivia(source, chainEnd, prefix);
                    var nextOp := comparisonOperatorAt(source, nextPos);
                    loop isComparison(nextOp.text) {
                        operand := self(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                        opMarkers = collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = skipTrivia(source, chainEnd, prefix);
                        nextOp = comparisonOperatorAt(source, nextPos);
                    }
                    left = boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    if not numeric.isNumericKind(peerKind) {
                        failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = "Float", code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if operator.text == "+" and peerKind == "String" {
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=String\n";
                    left = textParsed("", "", false, right.next);
                } else if numeric.isNumericKind(peerKind) {
                    if not numeric.isIntKind(peerKind) and operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = peerKind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if isListKind(peerKind) {
                    failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
                } else if operator.text == "+" {
                    failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
                } else {
                    failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                }
            }
        } else if operator.text == "and" or operator.text == "or" {
            if left.kind =!= "Bool" or right.kind =!= "Bool" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
            }
            if left.constant and right.constant {
                value := if operator.text == "and" {
                    left.intValue =!= 0 and right.intValue =!= 0
                } else {
                    left.intValue =!= 0 or right.intValue =!= 0
                };
                left = boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
            } else {
                left = boolParsed(targetLogicCode(target, operator.text, left.code, right.code), false, false, right.next);
            }
        } else if isComparison(operator.text) {
            firstPair := compareParsed(target, source, operatorPosition, operator.text, left, right, prefix);
            var nextPosition := skipTrivia(source, right.next, prefix);
            var nextOperator := comparisonOperatorAt(source, nextPosition);
            if not isComparison(nextOperator.text) {
                left = firstPair;
            } else {
                codes: mut List<String> = [left.code, right.code];
                kinds: mut List<String> = [left.kind, right.kind];
                operators: mut List<String> = [operator.text];
                var count := 1;
                var previous := right;
                var end := right.next;
                var constant := left.constant and right.constant;
                var value := firstPair.intValue =!= 0;
                loop isComparison(nextOperator.text) {
                    operand := self(target, source, nextPosition + nextOperator.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "", aliases);
                    if inferMode { opMarkers = collectParsedMarkers(opMarkers, operand); }
                    pair := compareParsed(target, source, nextPosition, nextOperator.text, previous, operand, prefix);
                    listLib.pushBack(mut codes, operand.code);
                    listLib.pushBack(mut kinds, operand.kind);
                    listLib.pushBack(mut operators, nextOperator.text);
                    constant = constant and operand.constant;
                    if constant { value = value and pair.intValue =!= 0; }
                    count = count + 1;
                    previous = operand;
                    end = operand.next;
                    nextPosition = skipTrivia(source, end, prefix);
                    nextOperator = comparisonOperatorAt(source, nextPosition);
                }
                if constant { left = boolParsed(targetBoolLiteralCode(target, value), value, true, end); }
                else { left = boolParsed(targetComparisonChainCode(target, codes, kinds, operators, count, operatorPosition), false, false, end); }
            }
        } else if operator.text == "**" {
            if not numeric.isNumericKind(left.kind) or not numeric.isNumericKind(right.kind) {
                failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
            }
            code := targetFloatPowerCode(target, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition);
            left = (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind) {
            promoted := numeric.promoteNumericKind(left.kind, right.kind);
            if left.constant and right.constant {
                folded := tryFoldInteger(operator.text, left.intValue, right.intValue);
                if folded.ok and numeric.intKindFits(promoted, folded.value) {
                    code := if (operator.text == "%" or operator.text == ":%") and left.intValue == integer.intMin and right.intValue == -1 {
                        targetIntLiteralCode(target, 0, false, "0")
                    } else if operator.text == ":/" { targetFloorDivCode(target, left.code, right.code) }
                    else if operator.text == ":%" { targetFloorModCode(target, left.code, right.code) }
                    else { "(" + left.code + " " + operator.text + " " + right.code + ")" };
                    left = typedIntParsed(promoted, code, folded.value, true, right.next);
                } else {
                    left = typedIntParsed(promoted, runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
                }
            } else {
                left = typedIntParsed(promoted, runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
            }
        } else if operator.text == "+" and left.kind == "String" and right.kind == "String" {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = textParsed(targetTextLiteralCode(target, combined), combined, true, right.next);
            } else {
                left = textParsed(targetConcatCode(target, left.code, right.code), "", false, right.next);
            }
        } else if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
            if operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
            }
            promotedFloat := numeric.promoteNumericKind(left.kind, right.kind);
            floatKind := if promotedFloat =!= "" { promotedFloat } else if numeric.isFloatKind(left.kind) { left.kind } else { right.kind };
            code := if floatKind == "Float32" {
                targetFloat32BinaryCode(target, operator.text, targetFloat32OperandCode(target, left.kind, left.code), targetFloat32OperandCode(target, right.kind, right.code), operatorPosition)
            } else {
                targetFloatBinaryCode(target, operator.text, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition)
            };
            left = (kind = floatKind, code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if isListKind(left.kind) or isListKind(right.kind) {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if operator.text == "+" {
            failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
        if inferMode and opMarkers =!= "" { left = withMarkers(left, opMarkers); }
    }
    if leaderStart >= 0 and left.kind =!= "Bool" {
        failAt(source, leaderStart, prefix, "leading " + leaderText + " requires a Bool expression");
    }
    left
}

/** Parses one expression with an empty construct context stack. */
parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    emptyAliases: List<AliasDecl> = [];
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, minimum, [], 0, false, "", emptyAliases)
}

/** Parses one complete expression at the lowest precedence with construct contexts and an optional contextual kind. */
parseExpressionAsCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, 0, ctxs, 0, false, "", aliases)
}

/** Parses one statement-level expression with construct contexts, allowing unit-producing tagged conditionals without else. */
parseStatementExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, -2, ctxs, 0, false, "", aliases)
}

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, 0)
}

/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, "", 0, ctxs, 0, false, "", aliases)
}

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, "", 0)
}

/** Reads the logical diagnostic name supplied by the compiler host. */
pub sourcePrefix := fn(): String {
    var prefix := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 0 { prefix = argument; }
        argumentIndex = argumentIndex + 1;
    }
    prefix
}

/** Reads the compiler-host verified identity of the root source module. */
pub sourceModuleIdentity := fn(): String {
    var identity := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 1 { identity = argument; }
        argumentIndex = argumentIndex + 1;
    }
    identity
}

/** Reads the canonical root path used to resolve language-level imports. */
pub sourceModulePath := fn(): String {
    var path := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 2 { path = argument; }
        argumentIndex = argumentIndex + 1;
    }
    path
}

/** Normalizes and validates a canonical soft-builtin core module path (`core/<name>` or `lib/core/<name>[.lts]`), returning `""` outside stdlib bounds. */
normalizeBuiltinModule := fn(raw: String): String {
    if raw == "" { return ""; }
    if textLib.indexOfText(raw, "\\", 0) >= 0 or textLib.indexOfText(raw, ":", 0) >= 0 {
        return "";
    }
    if textLib.startsWithAt(raw, 0, "/") or textLib.indexOfText(raw, "//", 0) >= 0 {
        return "";
    }
    rawLen := textLib.length(raw);
    if textLib.at(raw, rawLen - 1) == "/" { return ""; }
    var out := raw;
    if rawLen > 4 and textLib.startsWithAt(raw, rawLen - 4, ".lts") {
        out = textLib.slice(raw, 0, rawLen - 4);
    }
    if textLib.indexOfText(out, ".", 0) >= 0 { return ""; }
    if textLib.startsWithAt(out, 0, "core/") {
        out = "lib/" + out;
    }
    if not textLib.startsWithAt(out, 0, "lib/core/") { return ""; }
    if not isSoftBuiltinModule(out) { return ""; }
    out
}

/** Parses one `--builtin-mode` spec (`pure`, `builtin`, `module=mode`, `module.fn=mode`). */
parseBuiltinModeSpec := fn(prefix: String, spec: String): Item {
    if spec == "builtin" or spec == "pure" {
        return (kind = "project", name = "", runtime = spec, code = "", intValue = 0, textValue = "");
    }
    eq := textLib.indexOfText(spec, "=", 0);
    if eq <= 0 {
        diagLib.fail(prefix, "invalid --builtin-mode specification: " + spec);
    }
    target := textLib.slice(spec, 0, eq);
    mode := textLib.slice(spec, eq + 1, textLib.length(spec));
    if mode =!= "builtin" and mode =!= "pure" {
        diagLib.fail(prefix, "invalid --builtin-mode value: " + mode);
    }
    tLen := textLib.length(target);
    isLtsFile := tLen > 4 and textLib.startsWithAt(target, tLen - 4, ".lts");
    var lastDot := -1;
    var scan := 0;
    loop true {
        found := textLib.indexOfText(target, ".", scan);
        if found < 0 { break; }
        lastDot = found;
        scan = found + 1;
    }
    if not isLtsFile and lastDot > 0 and textLib.indexOfText(target, "/", lastDot + 1) < 0 {
        modPart := textLib.slice(target, 0, lastDot);
        fnPart := textLib.slice(target, lastDot + 1, tLen);
        if textLib.indexOfText(modPart, ".", 0) < 0 and fnPart =!= "" {
            normMod := normalizeBuiltinModule(modPart);
            if normMod =!= "" and softBuiltinAbi(normMod, fnPart).result =!= "" {
                return (kind = "fn", name = normMod + "." + fnPart, runtime = mode,
                code = "", intValue = 0, textValue = "");
            }
        }
        diagLib.fail(prefix, "invalid --builtin-mode function target: " + target);
    }
    normMod := normalizeBuiltinModule(target);
    if normMod == "" {
        diagLib.fail(prefix, "invalid --builtin-mode module target: " + target);
    }
    (kind = "module", name = normMod, runtime = mode, code = "", intValue = 0, textValue = "")
}

/** Parses compiler `--builtin-mode` flags from process arguments after host metadata. */
pub parseBuiltinModes := fn(prefix: String): Items {
    rules: mut Items = [];
    var argumentIndex := 0;
    var expectModeValue := false;
    loop io.inputArgs() as argument {
        if argumentIndex >= 3 {
            if expectModeValue {
                listLib.pushBack(mut rules, parseBuiltinModeSpec(prefix, argument));
                expectModeValue = false;
            } else if argument == "--builtin-mode" {
                expectModeValue = true;
            } else if textLib.startsWithAt(argument, 0, "--builtin-mode=") {
                listLib.pushBack(mut rules, parseBuiltinModeSpec(prefix, textLib.slice(argument, 15, textLib.length(argument))));
            } else {
                diagLib.fail(prefix, "unknown compiler option " + argument);
            }
        }
        argumentIndex = argumentIndex + 1;
    }
    if expectModeValue {
        diagLib.fail(prefix, "missing value for --builtin-mode");
    }
    rules
}

/** Resolves effective builtin mode (`builtin` or `pure`) by precedence: function > module > project > default builtin. */
pub resolveBuiltinMode := fn(rules: Items, moduleName: String, fnName: String): String {
    var mode := "builtin";
    var precedence := 0;
    fnTarget := if moduleName == "" { "" } else { moduleName + "." + fnName };
    loop rules as rule {
        if rule.kind == "project" and precedence <= 1 {
            mode = rule.runtime;
            precedence = 1;
        } else if rule.kind == "module" and rule.name == moduleName and precedence <= 2 {
            mode = rule.runtime;
            precedence = 2;
        } else if rule.kind == "fn" and fnTarget =!= "" and rule.name == fnTarget and precedence <= 3 {
            mode = rule.runtime;
            precedence = 3;
        }
    }
    mode
}

/** Collapses a numeric scalar, tuple or list kind to its canonical item suffix (`Int`, `Float`, `Tuple`, `List`) while leaving other scalar kinds unchanged. */
storageKind := fn(kind: String): String {
    match {
        isListKind(kind) or isArrayKind(kind) { "List" }
        isTupleKind(kind) { "Tuple" }
        isFnKind(kind) { "Fn" }
        numeric.isIntKind(kind) { "Int" }
        numeric.isFloatKind(kind) { "Float" }
        _ { kind }
    }
}

/** Returns the text payload for a storage item with explicit declared kind `kind`, falling back to `fallback`. */
storageTextPayload := fn(kind: String, fallback: String): String {
    if isListKind(kind) or isArrayKind(kind) or isFnKind(kind) { kind } else { fallback }
}

/** Returns the text payload stored with one local item: the canonical List/Array/Fn kind for List/Array/Fn items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String {
    storageTextPayload(parsed.kind, parsed.textValue)
}

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    if not textLib.wordAt(source, inner, "if") { return []; }
    result: mut List<Item> = [];
    var cursor := skipTrivia(source, inner + 2, prefix);
    var isFirst := true;
    loop true {
        rejectHeaderBlockTag(source, cursor, prefix, if isFirst { "if" } else { "else if" });
        conditionStart := cursor;
        condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, params, currentName, ctxs, aliases);
        if condition.kind =!= "Bool" {
            failAt(source, conditionStart, prefix, "if condition must be Bool");
        }
        conditionCode := if condition.constant {
            targetBoolLiteralCode(target, condition.intValue =!= 0)
        } else {
            condition.code
        };
        beforeOpen := skipTrivia(source, condition.next, prefix);
        rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in if");
        open := expectSymbol(source, beforeOpen, "{", prefix);
        branchStart := skipTrivia(source, open, prefix);
        branch := parseExpressionAsCtx(target, source, branchStart, prefix, locals, functions, params, currentName, targetKind, ctxs, aliases);
        if not isCompatibleKind(targetKind, branch.kind) {
            failAt(source, targetAt, prefix, "cannot assign " + displayKind(branch.kind) + " to " + displayKind(targetKind) + " local " + targetName);
        }
        cursor = expectSymbol(source, skipTrivia(source, branch.next, prefix), "}", prefix);
        listLib.pushBack(mut result, (kind = if isFirst { "If" } else { "ElseIf" }, name = "", runtime = "", code = conditionCode,
        intValue = 0, textValue = ""));
        listLib.pushBack(mut result, (kind = "Assign" + storageKind(targetKind), name = targetName, runtime = targetRuntime,
        code = assignValueCode(target, targetKind, branch.kind, branch.code), intValue = branch.intValue, textValue = storageTextPayload(targetKind, branch.textValue)));
        isFirst = false;
        afterBranch := skipTrivia(source, cursor, prefix);
        if not textLib.wordAt(source, afterBranch, "else") {
            var end := afterBranch;
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            statementNext := if matched { consumeStatementEnd(source, end, prefix) } else { -1 };
            if statementNext < 0 {
                failAt(source, afterBranch, prefix, "value if requires a final else");
            }
            listLib.pushBack(mut result, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            listLib.pushBack(mut result, (kind = "End", name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
            return result;
        }
        afterElse := skipTrivia(source, afterBranch + 4, prefix);
        rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
        if not textLib.wordAt(source, afterElse, "if") {
            return [];
        }
        cursor = skipTrivia(source, afterElse + 2, prefix);
    }
    []
}

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    ifKwPos := skipOptionalScanTag(source, inner, prefix, "if");
    if ifKwPos >= 0 and textLib.wordAt(source, ifKwPos, "if") {
        scannedEnd := scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinaryCtx(target, source, inner, prefix, locals, functions, params, currentName, expected, -1, ctxs, 0, false, "", aliases);
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseExpressionAsCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
}

/**
 * True when the innermost block expects a value tail: a function body or one of
 * the value-if branches that complete one.
 */
atValueTail := fn(blocks: List<String>, blockCount: Int): Bool {
    if blockCount <= 0 { return false; }
    kind := blocks[blockCount - 1];
    kind == BLOCK_KIND_FUNCTION or kind == BLOCK_KIND_IF_VALUE or kind == BLOCK_KIND_MATCH_VALUE or kind == BLOCK_KIND_MATCH_ELSE_VALUE or kind == BLOCK_KIND_MATCH_SINGLE_VALUE
}

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool {
    loop blocks as kind {
        if kind == BLOCK_KIND_LOOP { return true; }
    }
    false
}

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): (next: Int, returned: Bool, code: String, valueKind: String) {
    var isTailClose := false;
    if valueTail {
        end := scanExpressionItemEnd(source, position, prefix);
        nextCheck := skipItemSeparators(source, end, prefix);
        isTailClose = nextCheck < textLib.length(source) and textLib.at(source, nextCheck) == "}";
    }
    expected := if isTailClose {
        if isListKind(currentResult) { "Tail" + currentResult } else { currentResult }
    } else {
        ""
    };
    trimmedStart := skipTrivia(source, position, prefix);
    stmtSink := if trimmedStart < textLib.length(source) and textLib.at(source, trimmedStart) == "{" { "exprOut" } else { "" };
    stmtMin := if not isTailClose or currentResult == "Unit" { -2 } else { 0 };
    parsed := parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, stmtMin, ctxs, 0, false, stmtSink, aliases);
    ended := consumeStatementEnd(source, parsed.next, prefix);
    if ended < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after expression statement"); }
    next := skipItemSeparators(source, ended, prefix);
    returned := currentName =!= "" and valueTail and next < textLib.length(source) and textLib.at(source, next) == "}";
    if returned and not isCompatibleKind(currentResult, parsed.kind) {
        failAt(source, position, prefix, "cannot return " + displayKind(parsed.kind) + " from function " + currentName +
        " returning " + displayKind(currentResult));
    }
    (next = next, returned = returned, code = if returned { if parsed.kind == "Unit" { targetUnitEvaluationCode(target, parsed.code) } else { assignValueCode(target, currentResult, parsed.kind, parsed.code) } } else { parsed.code }, valueKind = parsed.kind)
}

/** Collects aliases, `pub` declarations, inner-alias hints, root functions, root values, and root assignments in a single pass over module source. */
collectModuleDecls := fn(target: String, source: String, prefix: String, moduleKey: String): Items {
    decls: mut List<Item> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    var parenDepth := 0;
    var hasInnerAlias := false;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            if depth == 0 {
                blockEnd := scanBraceEnd(source, position, prefix);
                if blockEnd >= 0 {
                    if not hasInnerAlias {
                        typeHit := textLib.indexOfText(source, "type", position + 1);
                        if typeHit >= 0 and typeHit < blockEnd {
                            hasInnerAlias = true;
                            listLib.pushBack(mut decls, (kind = "HasInnerAlias", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                        }
                    }
                    position = blockEnd;
                    continue;
                }
            }
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if ch == "(" or ch == "[" {
            if ch == "(" and depth == 0 and parenDepth == 0 {
                parenEnd := scanParenEnd(source, position, prefix);
                afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
                if afterParen >= 0 and textLib.startsWithAt(source, afterParen, ":=") {
                    rhsPos := skipTrivia(source, afterParen + 2, prefix);
                    listLib.pushBack(mut decls, (kind = "FutureDestr", name = "", runtime = "val", code = integer.intText(position),
                    intValue = position, textValue = integer.intText(rhsPos)));
                    position = rhsPos;
                    continue;
                }
            }
            if depth == 0 { parenDepth = parenDepth + 1; }
            position = position + 1;
        } else if ch == ")" or ch == "]" {
            if depth == 0 and parenDepth > 0 { parenDepth = parenDepth - 1; }
            position = position + 1;
        } else if depth == 0 and parenDepth == 0 and textLib.isNameStart(ch) {
            nameStart := position;
            afterName := textLib.skipName(source, position);
            name := textLib.slice(source, nameStart, afterName);
            if name == "pub" {
                declStart := skipTrivia(source, afterName, prefix);
                if declStart < size and textLib.isNameStart(textLib.at(source, declStart)) {
                    declEnd := textLib.skipName(source, declStart);
                    operator := skipTrivia(source, declEnd, prefix);
                    if textLib.startsWithAt(source, operator, ":=") {
                        valStart := skipTrivia(source, operator + 2, prefix);
                        declName := textLib.slice(source, declStart, declEnd);
                        if textLib.wordAt(source, valStart, "fn") {
                            listLib.pushBack(mut decls, (kind = "PubFn", name = declName, runtime = "", code = "", intValue = 0, textValue = ""));
                        } else if textLib.wordAt(source, valStart, "type") {
                            listLib.pushBack(mut decls, (kind = "PubType", name = declName, runtime = "", code = "", intValue = 0, textValue = ""));
                        } else {
                            listLib.pushBack(mut decls, (kind = "PubVal", name = declName, runtime = "", code = "", intValue = 0, textValue = ""));
                        }
                    }
                }
                position = afterName;
                continue;
            }
            if name == "var" {
                afterVar := skipTrivia(source, afterName, prefix);
                if afterVar < size and textLib.at(source, afterVar) == "(" {
                    parenEnd := scanParenEnd(source, afterVar, prefix);
                    afterParen := if parenEnd >= 0 { skipTrivia(source, parenEnd, prefix) } else { -1 };
                    if afterParen >= 0 and textLib.startsWithAt(source, afterParen, ":=") {
                        rhsPos := skipTrivia(source, afterParen + 2, prefix);
                        listLib.pushBack(mut decls, (kind = "FutureDestr", name = "", runtime = "var", code = integer.intText(afterVar),
                        intValue = nameStart, textValue = integer.intText(rhsPos)));
                        position = rhsPos;
                        continue;
                    }
                }
                var isVarMut := false;
                var varLocalPos := afterVar;
                if textLib.wordAt(source, varLocalPos, "mut") {
                    isVarMut = true;
                    varLocalPos = skipTrivia(source, varLocalPos + 3, prefix);
                }
                if varLocalPos < size and textLib.isNameStart(textLib.at(source, varLocalPos)) {
                    localStart := varLocalPos;
                    localEnd := textLib.skipName(source, localStart);
                    localName := textLib.slice(source, localStart, localEnd);
                    if not isReservedWord(localName) {
                        afterLocal := skipTrivia(source, localEnd, prefix);
                        if textLib.startsWithAt(source, afterLocal, ":=") {
                            rhsPos := skipTrivia(source, afterLocal + 2, prefix);
                            kindTag := if isVarMut { "varmut|" } else { "varval|" };
                            listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = moduleValueRuntime(target, moduleKey, localName),
                            code = "", intValue = localStart, textValue = kindTag + integer.intText(rhsPos)));
                            position = rhsPos;
                            continue;
                        } else if not isVarMut and afterLocal < size and textLib.at(source, afterLocal) == ":" and compoundAssignOp(source, afterLocal).width == 0 {
                            annStart := afterLocal + 1;
                            listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = moduleValueRuntime(target, moduleKey, localName),
                            code = "", intValue = localStart, textValue = "varann|" + integer.intText(annStart)));
                            var ts := annStart;
                            var tp := 0;
                            loop ts < size {
                                ts = skipTrivia(source, ts, prefix);
                                if ts >= size { break; }
                                tc := textLib.at(source, ts);
                                if tc == "\"" {
                                    ts = skipAliasString(source, ts);
                                } else if tc == "(" or tc == "[" or tc == "<" {
                                    tp = tp + 1;
                                    ts = ts + 1;
                                } else if tc == ")" or tc == "]" or tc == ">" {
                                    if tp > 0 { tp = tp - 1; }
                                    ts = ts + 1;
                                } else if tc == "{" or tc == "}" {
                                    break;
                                } else if tp == 0 and tc == ";" {
                                    ts = ts + 1;
                                    break;
                                } else if tp == 0 and isSingleEquals(source, ts) {
                                    ts = ts + 1;
                                    break;
                                } else {
                                    ts = ts + 1;
                                }
                            }
                            position = ts;
                            continue;
                        }
                    }
                }
                position = afterName;
                continue;
            }
            if name == "mut" {
                localStart := skipTrivia(source, afterName, prefix);
                if localStart < size and textLib.isNameStart(textLib.at(source, localStart)) {
                    localEnd := textLib.skipName(source, localStart);
                    localName := textLib.slice(source, localStart, localEnd);
                    afterLocal := skipTrivia(source, localEnd, prefix);
                    if not isReservedWord(localName) and textLib.startsWithAt(source, afterLocal, ":=") {
                        rhsPos := skipTrivia(source, afterLocal + 2, prefix);
                        listLib.pushBack(mut decls, (kind = "FutureDecl", name = localName, runtime = moduleValueRuntime(target, moduleKey, localName),
                        code = "", intValue = localStart, textValue = "mutval|" + integer.intText(rhsPos)));
                        position = rhsPos;
                        continue;
                    }
                }
                position = afterName;
                continue;
            }
            if name == "else" or isReservedWord(name) {
                position = afterName;
                continue;
            }
            aliasPosition := skipTrivia(source, afterName, prefix);
            if textLib.startsWithAt(source, aliasPosition, ":=") {
                valueStart := skipTrivia(source, aliasPosition + 2, prefix);
                if textLib.wordAt(source, valueStart, "type") {
                    targetStart := skipTrivia(source, valueStart + 4, prefix);
                    aliasTarget := collectTypeTarget(source, targetStart, prefix);
                    listLib.pushBack(mut decls, (kind = "Alias", name = name, runtime = "", code = aliasTarget.text,
                    intValue = nameStart, textValue = integer.intText(aliasTarget.next)));
                    position = aliasTarget.next;
                    continue;
                }
                if textLib.wordAt(source, valueStart, "fn") {
                    headerPos := skipTrivia(source, valueStart + 2, prefix);
                    listLib.pushBack(mut decls, (kind = "FutureFn", name = name, runtime = "", code = "",
                    intValue = nameStart, textValue = integer.intText(headerPos)));
                    var fnCursor := headerPos;
                    var fnParen := 0;
                    loop fnCursor < size {
                        fnCursor = skipTrivia(source, fnCursor, prefix);
                        if fnCursor >= size { break; }
                        fc := textLib.at(source, fnCursor);
                        if fc == "\"" {
                            fnCursor = skipAliasString(source, fnCursor);
                        } else if fc == "(" or fc == "[" {
                            fnParen = fnParen + 1;
                            fnCursor = fnCursor + 1;
                        } else if fc == ")" or fc == "]" {
                            if fnParen > 0 { fnParen = fnParen - 1; }
                            fnCursor = fnCursor + 1;
                        } else if fnParen == 0 and fc == ";" {
                            fnCursor = fnCursor + 1;
                            break;
                        } else if fnParen == 0 and fc == "{" {
                            fnBodyEnd := scanBraceEnd(source, fnCursor, prefix);
                            if fnBodyEnd >= 0 {
                                if not hasInnerAlias {
                                    fnTypeHit := textLib.indexOfText(source, "type", fnCursor + 1);
                                    if fnTypeHit >= 0 and fnTypeHit < fnBodyEnd {
                                        hasInnerAlias = true;
                                        listLib.pushBack(mut decls, (kind = "HasInnerAlias", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                                    }
                                }
                                fnCursor = fnBodyEnd;
                            } else {
                                fnCursor = size;
                            }
                            break;
                        } else if fnParen == 0 and fc == "}" {
                            break;
                        } else {
                            fnCursor = fnCursor + 1;
                        }
                    }
                    position = fnCursor;
                    continue;
                }
                if not textLib.wordAt(source, valueStart, "import") {
                    listLib.pushBack(mut decls, (kind = "FutureDecl", name = name, runtime = moduleValueRuntime(target, moduleKey, name),
                    code = "", intValue = nameStart, textValue = "val|" + integer.intText(valueStart)));
                }
                position = valueStart;
                continue;
            }
            if aliasPosition < size and textLib.at(source, aliasPosition) == ":" and compoundAssignOp(source, aliasPosition).width == 0 {
                annStart := aliasPosition + 1;
                listLib.pushBack(mut decls, (kind = "FutureDecl", name = name, runtime = moduleValueRuntime(target, moduleKey, name),
                code = "", intValue = nameStart, textValue = "ann|" + integer.intText(annStart)));
                var ts := annStart;
                var tp := 0;
                loop ts < size {
                    ts = skipTrivia(source, ts, prefix);
                    if ts >= size { break; }
                    tc := textLib.at(source, ts);
                    if tc == "\"" {
                        ts = skipAliasString(source, ts);
                    } else if tc == "(" or tc == "[" or tc == "<" {
                        tp = tp + 1;
                        ts = ts + 1;
                    } else if tc == ")" or tc == "]" or tc == ">" {
                        if tp > 0 { tp = tp - 1; }
                        ts = ts + 1;
                    } else if tc == "{" or tc == "}" {
                        break;
                    } else if tp == 0 and tc == ";" {
                        ts = ts + 1;
                        break;
                    } else if tp == 0 and isSingleEquals(source, ts) {
                        ts = ts + 1;
                        break;
                    } else {
                        ts = ts + 1;
                    }
                }
                position = ts;
                continue;
            }
            if isSingleEquals(source, aliasPosition) {
                listLib.pushBack(mut decls, (kind = "RootAssign", name = name, runtime = "", code = "", intValue = nameStart, textValue = ""));
                position = skipTrivia(source, aliasPosition + 1, prefix);
                continue;
            }
            position = afterName;
        } else {
            position = position + 1;
        }
    }
    decls
}

/** Appends `(name, depth)` entries to `decls` for every `|name|` token in `assignedBag`. */
appendAssignedBagDecls := fn(assignedBag: String, decls: List<BlockDecl>, depth: Int): List<BlockDecl> {
    if assignedBag == "" { return decls; }
    nextDecls: mut List<BlockDecl> = [];
    loop decls as existing { listLib.pushBack(mut nextDecls, existing); }
    len := textLib.length(assignedBag);
    var pos := 0;
    loop pos < len {
        if textLib.at(assignedBag, pos) == "|" {
            sep := textLib.indexOfText(assignedBag, "|", pos + 1);
            if sep > pos + 1 {
                nm := textLib.slice(assignedBag, pos + 1, sep);
                if not hasBlockDecl(nextDecls, depth, nm) {
                    listLib.pushBack(mut nextDecls, (name = nm, depth = depth));
                }
                pos = sep;
                continue;
            }
        }
        pos = pos + 1;
    }
    nextDecls
}

/** Removes deferred-only entries after one function body has been checked. */
withoutFutureValues := fn(locals: List<Local>): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if entry.depth >= 0 or entry.depth <= -2 { listLib.pushBack(mut kept, entry); }
    }
    kept
}

/** Parses one top-level aliased import and returns its next source position. */
parseImportClause := fn(target: String, source: String, position: Int, alias: String, prefix: String): Item {
    if alias == "" { failAt(source, position, prefix, "import requires a module alias"); }
    pathStart := skipTrivia(source, position + 6, prefix);
    if pathStart >= textLib.length(source) or textLib.at(source, pathStart) =!= "\"" {
        failAt(source, pathStart, prefix, "import requires a quoted source path");
    }
    path := parseText(target, source, pathStart, prefix);
    pathLength := textLib.length(path.textValue);
    var invalidPath := pathLength == 0;
    var pathIndex := 0;
    loop pathIndex < pathLength {
        if textLib.at(path.textValue, pathIndex) == "\\" { invalidPath = true; }
        pathIndex = pathIndex + 1;
    }
    if invalidPath {
        failAt(source, pathStart, prefix, "import path must be nonempty and use \"/\" separators");
    }
    statementNext := consumeStatementEnd(source, path.next, prefix);
    if statementNext < 0 {
        failAt(source, skipTrivia(source, path.next, prefix), prefix, "expected ; after import");
    }
    (kind = "Import", name = alias, runtime = "", code = "", intValue = statementNext, textValue = path.textValue)
}

/** Collects top-level import clauses before parsing so imported declarations can seed the importing file's symbol table. */
pub collectImportClauses := fn(target: String, source: String, prefix: String): Items {
    imports: mut Items = [];
    size := textLib.length(source);
    var position := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            closed := scanBraceEnd(source, position, prefix);
            if closed < 0 { break; }
            position = closed;
        } else if textLib.isNameStart(ch) {
            nameEnd := textLib.skipName(source, position);
            name := textLib.slice(source, position, nameEnd);
            if name == "import" {
                imported := parseImportClause(target, source, position, "", prefix);
                listLib.pushBack(mut imports, imported);
                position = imported.intValue;
            } else {
                afterName := skipTrivia(source, nameEnd, prefix);
                if textLib.startsWithAt(source, afterName, ":=") {
                    afterDeclare := skipTrivia(source, afterName + 2, prefix);
                    if textLib.wordAt(source, afterDeclare, "import") {
                        imported := parseImportClause(target, source, afterDeclare, name, prefix);
                        listLib.pushBack(mut imports, imported);
                        position = imported.intValue;
                    } else {
                        position = afterDeclare;
                    }
                } else {
                    position = nameEnd;
                }
            }
        } else {
            position = position + 1;
        }
    }
    imports
}

/** Parses one legacy or imported output statement into the same ordered argument group and ending marker. */
parseOutputStatement := fn(target: String, source: String, openPosition: Int, outputName: String, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
live: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    var position := openPosition;
    if position >= textLib.length(source) or textLib.at(source, position) =!= "(" {
        failAt(source, position, prefix, "expected ( after " + outputName);
    }
    position = skipTrivia(source, position + 1, prefix);
    result: mut List<Item> = [];
    loop position < textLib.length(source) and textLib.at(source, position) =!= ")" {
        argStart := position;
        argument := parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs, aliases);
        if containsFnKind(argument.kind) {
            failAt(source, argStart, prefix, "cannot output function value");
        }
        listLib.pushBack(mut result, (kind = argument.kind, name = "", runtime = "", code = argument.code,
        intValue = argument.intValue, textValue = argument.textValue));
        position = skipTrivia(source, argument.next, prefix);
        if position < textLib.length(source) and textLib.at(source, position) == "," {
            position = skipTrivia(source, position + 1, prefix);
        } else {
            break;
        }
    }
    position = expectSymbol(source, position, ")", prefix);
    statementNext := consumeStatementEnd(source, position, prefix);
    if statementNext < 0 { failAt(source, skipTrivia(source, position, prefix), prefix, "expected ; after " + outputName); }
    listLib.pushBack(mut result, (kind = if outputName == "outputLine" { "End" } else { "EndOutput" },
    name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
    result
}

/** Advances past one `{ ... }` function body while respecting strings and comments. */
skipBraceBlock := fn(source: String, afterOpen: Int, prefix: String): Int {
    end := scanBracedRange(source, afterOpen, 1, prefix);
    if end >= 0 { return end; }
    failAt(source, afterOpen, prefix, "expected } before end of source");
    textLib.length(source)
}

/** Parses complete source with selective function-body compilation (`neededFns = "*"` compiles every function). */
pub parseProgramWithModuleSelective := fn(target: String, source: String, prefix: String, exports: Items, moduleKey: String,
moduleIdentity: String, neededFns: String, skipSoftBuiltins: Bool): Items {
    size := textLib.length(source);
    var position := skipTrivia(source, 0, prefix);
    var items: mut Items = [];
    if position == size { return items; }
    var builtinRules: Items = [];
    if skipSoftBuiltins and target == "ts" and textLib.startsWithAt(moduleIdentity, 0, "lite.core.") {
        builtinRules = parseBuiltinModes(prefix);
    }
    var aliases: mut List<AliasDecl> = [];
    loop exports as exported {
        if exported.kind == "PublicType" {
            listLib.pushBack(mut aliases, (name = exported.name, target = exported.code, at = -1, end = 0, depth = 0));
        }
    }
    decls := collectModuleDecls(target, source, prefix, moduleKey);
    publishedFunctions: mut List<String> = [];
    publishedValues: mut List<String> = [];
    publishedTypes: mut List<String> = [];
    futureValues: mut List<FutureValue> = [];
    var hasInnerAlias := false;
    rootAssignedNames: mut List<String> = [];
    loop decls as decl {
        if decl.kind == "Alias" {
            endPos := parseDigits(decl.textValue, 0, textLib.length(decl.textValue));
            listLib.pushBack(mut aliases, (name = decl.name, target = decl.code, at = decl.intValue, end = endPos, depth = 0));
        } else if decl.kind == "PubFn" {
            listLib.pushBack(mut publishedFunctions, decl.name);
        } else if decl.kind == "PubVal" {
            listLib.pushBack(mut publishedValues, decl.name);
        } else if decl.kind == "PubType" {
            listLib.pushBack(mut publishedTypes, decl.name);
        } else if decl.kind == "HasInnerAlias" {
            hasInnerAlias = true;
        } else if decl.kind == "RootAssign" and not listLib.listContainsText(rootAssignedNames, decl.name) {
            listLib.pushBack(mut rootAssignedNames, decl.name);
        }
    }
    var locals: mut List<Local> = [];
    var blockDecls: mut List<BlockDecl> = [];
    var blockAssignedDecls: mut List<BlockDecl> = [];
    loop rootAssignedNames as rootAssigned {
        listLib.pushBack(mut blockAssignedDecls, (name = rootAssigned, depth = 0));
    }
    blocks: mut List<String> = [];
    functions: mut List<FunctionInfo> = [];
    functionParams: mut List<String> = [];
    declaredImportAliases: mut List<String> = [];
    var parameterTotal := 0;
    loop exports as exported {
        if exported.kind == "ModuleAlias" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported module name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = "", kind = "Module", mutable = false,
            writable = false, depth = 0, constant = false, code = "", intValue = exported.intValue,
            textValue = exported.name, initState = INIT_STATE_INIT));
        } else if exported.kind == "PublicFunction" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            first := parameterTotal;
            var entryStart := 0;
            var entryIndex := 0;
            loop entryIndex < exported.intValue {
                separator := textLib.indexOfText(exported.textValue, "|", entryStart);
                var entryEnd := textLib.length(exported.textValue);
                if separator >= 0 { entryEnd = separator; }
                listLib.pushBack(mut functionParams, textLib.slice(exported.textValue, entryStart, entryEnd));
                parameterTotal = parameterTotal + 1;
                entryStart = entryEnd + 1;
                entryIndex = entryIndex + 1;
            }
            listLib.pushBack(mut functions, (name = exported.name, runtime = exported.runtime, result = exported.code,
            first = first, count = exported.intValue, declAt = -1));
            if textLib.indexOfText(exported.name, ".", 0) < 0 {
                listLib.pushBack(mut blockDecls, (name = exported.name, depth = 0));
            }
        } else if exported.kind == "PublicValue" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = exported.runtime, kind = exported.code,
            mutable = false, writable = false, depth = 0, constant = false, code = exported.runtime,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if textLib.indexOfText(exported.name, ".", 0) < 0 {
                listLib.pushBack(mut blockDecls, (name = exported.name, depth = 0));
            }
        } else if exported.kind == "PublicType" {
            if findAlias(aliases, exported.name) < 0 {
                diagLib.fail(prefix, "unknown imported public type " + exported.name);
            }
            if textLib.indexOfText(exported.name, ".", 0) < 0 {
                listLib.pushBack(mut blockDecls, (name = exported.name, depth = 0));
            }
        }
    }
    loop decls as decl {
        if decl.kind == "FutureFn" {
            fnName := decl.name;
            fnAt := decl.intValue;
            if findFunction(functions, fnName) < 0 and localIndex(locals, fnName) < 0 {
                var shadowedBefore := false;
                loop decls as priorDecl {
                    if priorDecl.name == fnName and priorDecl.intValue < fnAt and
                    (priorDecl.kind == "Alias" or priorDecl.kind == "FutureDecl") {
                        shadowedBefore = true;
                        break;
                    }
                }
                if not shadowedBefore {
                    headerPos := parseDigits(decl.textValue, 0, textLib.length(decl.textValue));
                    fnListIntrinsic := moduleIdentity == "lite.core.list.v1" and
                    (fnName == "pushBack" or fnName == "popBack" or fnName == "pushFront" or fnName == "popFront");
                    if canPreParseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic) {
                        header := parseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic);
                        afterHdr := skipTrivia(source, header.next, prefix);
                        if afterHdr < size and textLib.at(source, afterHdr) == ";" {
                            hostRuntime := coreHostFunction(moduleIdentity, fnName, header.params, header.result);
                            if listLib.listContainsText(publishedFunctions, fnName) and hostRuntime =!= "" {
                                listLib.pushBack(mut functions, (name = fnName, runtime = hostRuntime, result = header.result,
                                first = parameterTotal, count = header.count, declAt = fnAt));
                                var hStart := 0;
                                var hIdx := 0;
                                loop hIdx < header.count {
                                    sep := textLib.indexOfText(header.params, "|", hStart);
                                    var hEnd := textLib.length(header.params);
                                    if sep >= 0 { hEnd = sep; }
                                    listLib.pushBack(mut functionParams, textLib.slice(header.params, hStart, hEnd));
                                    parameterTotal = parameterTotal + 1;
                                    hStart = hEnd + 1;
                                    hIdx = hIdx + 1;
                                }
                            }
                        } else if header.count >= 0 and header.genericType == "" and afterHdr < size and textLib.at(source, afterHdr) == "{" {
                            fnRuntime := moduleFunctionRuntime(target, moduleKey, fnName);
                            listLib.pushBack(mut functions, (name = fnName, runtime = fnRuntime, result = header.result,
                            first = parameterTotal, count = header.count, declAt = fnAt));
                            var pStart := 0;
                            var pIdx := 0;
                            loop pIdx < header.count {
                                sep := textLib.indexOfText(header.params, "|", pStart);
                                var pEnd := textLib.length(header.params);
                                if sep >= 0 { pEnd = sep; }
                                listLib.pushBack(mut functionParams, textLib.slice(header.params, pStart, pEnd));
                                parameterTotal = parameterTotal + 1;
                                pStart = pEnd + 1;
                                pIdx = pIdx + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    var resolvedDeclBag := "";
    var futurePass := 0;
    loop futurePass < 4 {
        var progressed := false;
        var declIdx := 0;
        loop decls as decl {
            keyText := integer.intText(declIdx);
            if not tokenInPipeBag(resolvedDeclBag, keyText) {
                if decl.kind == "FutureDecl" {
                    sep := textLib.indexOfText(decl.textValue, "|", 0);
                    declTag := textLib.slice(decl.textValue, 0, sep);
                    posVal := parseDigits(decl.textValue, sep + 1, textLib.length(decl.textValue));
                    if declTag == "ann" or declTag == "varann" {
                        declMutable := declTag == "varann";
                        if canPreResolveLocalType(source, posVal, prefix, aliases) {
                            typed := parseLocalType(source, posVal, prefix, aliases);
                            if not (declMutable and typed.writable) {
                                afterType := skipTrivia(source, typed.next, prefix);
                                var futInit := INIT_STATE_INIT;
                                if isSingleEquals(source, afterType) {
                                    rhsStart := skipTrivia(source, afterType + 1, prefix);
                                    if isReservedInitMarker(source, rhsStart, prefix) >= 0 and not isListKind(typed.kind) {
                                        futInit = if listLib.listContainsText(rootAssignedNames, decl.name) { INIT_STATE_INIT }
                                        else if declMutable { INIT_STATE_UNINIT }
                                        else { INIT_STATE_MAYBE };
                                    }
                                }
                                listLib.pushBack(mut futureValues, (name = decl.name, runtime = decl.runtime, kind = typed.kind,
                                at = decl.intValue, mutable = declMutable, writable = typed.writable, initState = futInit));
                                resolvedDeclBag = appendPipeBag(resolvedDeclBag, keyText);
                                progressed = true;
                            }
                        }
                    } else {
                        declMutable := declTag == "varval" or declTag == "varmut";
                        declWritable := declTag == "varmut" or declTag == "mutval";
                        inferred := tryInferRootExprKind(source, posVal, prefix, aliases, functions, functionParams, locals, futureValues, "", 0, 24);
                        if inferred.kind =!= "" and inferred.kind =!= "Unit" and (not declWritable or isListKind(inferred.kind)) {
                            listLib.pushBack(mut futureValues, (name = decl.name, runtime = decl.runtime, kind = inferred.kind,
                            at = decl.intValue, mutable = declMutable, writable = declWritable, initState = INIT_STATE_INIT));
                            resolvedDeclBag = appendPipeBag(resolvedDeclBag, keyText);
                            progressed = true;
                        }
                    }
                } else if decl.kind == "FutureDestr" {
                    openPos := parseDigits(decl.code, 0, textLib.length(decl.code));
                    rhsPos := parseDigits(decl.textValue, 0, textLib.length(decl.textValue));
                    destr := tryParseDestructureNames(source, openPos, prefix);
                    if destr.ok and destr.count > 0 {
                        destrMutable := decl.runtime == "var";
                        inferred := tryInferRootExprKind(source, rhsPos, prefix, aliases, functions, functionParams, locals, futureValues, "", 0, 24);
                        if destr.grouped {
                            if inferred.kind =!= "" and inferred.kind =!= "Unit" {
                                bindName := destr.namesText;
                                listLib.pushBack(mut futureValues, (name = bindName, runtime = moduleValueRuntime(target, moduleKey, bindName),
                                kind = inferred.kind, at = decl.intValue, mutable = destrMutable, writable = false, initState = INIT_STATE_INIT));
                                resolvedDeclBag = appendPipeBag(resolvedDeclBag, keyText);
                                progressed = true;
                            }
                        } else if isTupleKind(inferred.kind) and tupleComponentCount(inferred.kind) == destr.count {
                            var bindCursor := 0;
                            var bindIndex := 0;
                            namesLen := textLib.length(destr.namesText);
                            loop bindIndex < destr.count {
                                var bindEnd := bindCursor;
                                loop bindEnd < namesLen and textLib.at(destr.namesText, bindEnd) =!= "," {
                                    bindEnd = bindEnd + 1;
                                }
                                bindName := textLib.slice(destr.namesText, bindCursor, bindEnd);
                                bindCursor = bindEnd + 1;
                                comp := tupleComponent(inferred.kind, bindIndex);
                                listLib.pushBack(mut futureValues, (name = bindName, runtime = moduleValueRuntime(target, moduleKey, bindName),
                                kind = comp.kind, at = decl.intValue, mutable = destrMutable, writable = false, initState = INIT_STATE_INIT));
                                bindIndex = bindIndex + 1;
                            }
                            resolvedDeclBag = appendPipeBag(resolvedDeclBag, keyText);
                            progressed = true;
                        }
                    }
                }
            }
            declIdx = declIdx + 1;
        }
        if not progressed { break; }
        futurePass = futurePass + 1;
    }
    var placeholderNamesBag := "";
    loop futureValues as future {
        if localIndex(locals, future.name) < 0 and findFunction(functions, future.name) < 0 and
        not tokenInPipeBag(placeholderNamesBag, future.name) {
            placeholderNamesBag = appendPipeBag(placeholderNamesBag, future.name);
            listLib.pushBack(mut locals, (name = future.name, runtime = future.runtime, kind = future.kind,
            mutable = future.mutable, writable = future.writable, depth = -2, constant = false, code = "",
            intValue = 0, textValue = "", initState = future.initState));
        }
    }
    var maxFutureAt := -1;
    loop functions as info {
        if info.declAt > maxFutureAt { maxFutureAt = info.declAt; }
    }
    loop futureValues as future {
        if future.at > maxFutureAt { maxFutureAt = future.at; }
    }
    var blockCount := 0;
    var depth := 0;
    var currentName := "";
    var currentResult := "";
    var currentReturned := false;
    var currentStopped := false;
    var branchesReturned := true;
    var branchesStopped := true;
    var hasElse := false;
    var loopForever := false;
    var currentLive := true;
    var liveBranchCount := 0;
    savedStates: mut List<BlockState> = [];
    var branchUpdates: mut List<BranchUpdate> = [];
    var stmtCtxs: mut List<ConstructCtx> = [];
    var nextStmtCtxId := 1;
    transferCodes: mut List<String> = [];
    var transferCount := 0;
    var fnTryKey := "";
    var fnTransferStart := 0;
    loopIds: mut List<Int> = [];
    loopTryKeys: mut List<String> = [];
    loopTransferStarts: mut List<Int> = [];
    loop position < size {
        ch := textLib.at(source, position);
        if ch == ";" {
            position = skipItemSeparators(source, position, prefix);
            continue;
        }
        if ch == "}" {
            if blockCount == 0 {
                failAt(source, position, prefix, "unexpected }");
            }
            blockKind := blocks[blockCount - 1];
            if (blockKind == BLOCK_KIND_IF_VALUE or blockKind == BLOCK_KIND_MATCH_VALUE or blockKind == BLOCK_KIND_MATCH_ELSE_VALUE or blockKind == BLOCK_KIND_MATCH_SINGLE_VALUE) and
            currentResult =!= "Unit" and not currentReturned {
                failAt(source, position, prefix, "branch of function " + currentName + " must return " + displayKind(currentResult));
            }
            after := skipTrivia(source, position + 1, prefix);
            if (blockKind == BLOCK_KIND_IF or blockKind == BLOCK_KIND_IF_VALUE) and after < size and textLib.wordAt(source, after, "else") {
                locals = visibleLocals(locals, depth);
                keptDecls := popBlockDecls(blockDecls, depth);
                blockDecls = [];
                loop keptDecls as d { listLib.pushBack(mut blockDecls, d); }
                keptAssigned := popBlockDecls(blockAssignedDecls, depth);
                blockAssignedDecls = [];
                loop keptAssigned as ad { listLib.pushBack(mut blockAssignedDecls, ad); }
                aliases = popBlockAliases(aliases, depth);
                var stateCount := 0;
                loop savedStates { stateCount += 1; }
                branchPreLen := savedStates[stateCount - 1].preLocalsLen;
                if currentLive and not currentStopped {
                    nextBranchUpdates := recordBranchUpdates(locals, branchPreLen, depth - 1, blockCount, branchUpdates);
                    branchUpdates = [];
                    loop nextBranchUpdates as u { listLib.pushBack(mut branchUpdates, u); }
                    liveBranchCount = liveBranchCount + 1;
                }
                nextLocals := truncateLocals(locals, branchPreLen);
                locals = [];
                loop nextLocals as l { listLib.pushBack(mut locals, l); }
                afterElse := skipTrivia(source, after + 4, prefix);
                rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                branchesReturned = branchesReturned and currentReturned;
                branchesStopped = branchesStopped and currentStopped;
                currentReturned = false;
                currentStopped = false;
                hasElse = not textLib.wordAt(source, afterElse, "if");
                droppedIf := listLib.popBack(mut blocks);
                blockCount = blockCount - 1;
                var elseArmOpen := -1;
                if textLib.wordAt(source, afterElse, "if") {
                    conditionStart := skipTrivia(source, afterElse + 2, prefix);
                    rejectHeaderBlockTag(source, conditionStart, prefix, "else if");
                    condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, functionParams, currentName, stmtCtxs, aliases);
                    if condition.kind =!= "Bool" {
                        failAt(source, conditionStart, prefix, "else if condition must be Bool");
                    }
                    if target == "ts" and currentLive {
                        checkTraceSafety(source, conditionStart, prefix, condition.code, currentName, maxFutureAt, locals, functions, futureValues, items);
                        locals = mergeOuterCallableUpdatesFromCode(locals, condition.code);
                    }
                    conditionCode := if condition.constant {
                        targetBoolLiteralCode(target, condition.intValue =!= 0)
                    } else {
                        condition.code
                    };
                    beforeOpen := skipTrivia(source, condition.next, prefix);
                    rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in else if");
                    position = expectSymbol(source, beforeOpen, "{", prefix);
                    elseArmOpen = position - 1;
                    if currentLive {
                        listLib.pushBack(mut items, (kind = "ElseIf", name = "", runtime = "", code = conditionCode,
                        intValue = 0, textValue = ""));
                        if codeHasRawTransfer(conditionCode) {
                            listLib.pushBack(mut transferCodes, conditionCode);
                            transferCount = transferCount + 1;
                        }
                    }
                    listLib.pushBack(mut blocks, blockKind);
                    blockCount = blockCount + 1;
                } else {
                    if currentLive { listLib.pushBack(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, if blockKind == BLOCK_KIND_IF_VALUE { BLOCK_KIND_IF_VALUE } else { BLOCK_KIND_ELSE });
                    blockCount = blockCount + 1;
                    position = expectSymbol(source, afterElse, "{", prefix);
                    elseArmOpen = position - 1;
                }
                if hasInnerAlias { aliases = collectBlockTypeAliases(source, elseArmOpen, prefix, depth, aliases); }
                elseAssignedBag := scanInnerBlockAssignedBag(target, source, elseArmOpen, prefix, "");
                blockAssignedDecls = appendAssignedBagDecls(elseAssignedBag, blockAssignedDecls, depth);
                locals = appendBlockFutureLocals(target, source, elseArmOpen, prefix, depth, "", elseAssignedBag, aliases, functions, functionParams, locals);
                position = skipTrivia(source, position, prefix);
                continue;
            }
            if blockKind == BLOCK_KIND_MATCH or blockKind == BLOCK_KIND_MATCH_VALUE {
                nextArmStart := skipItemSeparators(source, position + 1, prefix);
                if nextArmStart >= size {
                    failAt(source, position + 1, prefix, "expected } to close match");
                }
                if textLib.at(source, nextArmStart) == "}" {
                    failAt(source, nextArmStart, prefix, "subjectless match requires a final _ fallback arm");
                }
                locals = visibleLocals(locals, depth);
                keptDecls := popBlockDecls(blockDecls, depth);
                blockDecls = [];
                loop keptDecls as d { listLib.pushBack(mut blockDecls, d); }
                keptAssigned := popBlockDecls(blockAssignedDecls, depth);
                blockAssignedDecls = [];
                loop keptAssigned as ad { listLib.pushBack(mut blockAssignedDecls, ad); }
                aliases = popBlockAliases(aliases, depth);
                var stateCount := 0;
                loop savedStates { stateCount += 1; }
                branchPreLen := savedStates[stateCount - 1].preLocalsLen;
                if currentLive and not currentStopped {
                    nextBranchUpdates := recordBranchUpdates(locals, branchPreLen, depth - 1, blockCount, branchUpdates);
                    branchUpdates = [];
                    loop nextBranchUpdates as u { listLib.pushBack(mut branchUpdates, u); }
                    liveBranchCount = liveBranchCount + 1;
                }
                nextLocals := truncateLocals(locals, branchPreLen);
                locals = [];
                loop nextLocals as l { listLib.pushBack(mut locals, l); }
                branchesReturned = branchesReturned and currentReturned;
                branchesStopped = branchesStopped and currentStopped;
                currentReturned = false;
                currentStopped = false;
                droppedMatch := listLib.popBack(mut blocks);
                blockCount = blockCount - 1;
                afterUnderscore := skipTrivia(source, nextArmStart + 1, prefix);
                if textLib.wordAt(source, nextArmStart, "_") {
                    rejectMisplacedTag(source, afterUnderscore, prefix, "block tag cannot appear after _ in match arm");
                }
                isFallback := textLib.wordAt(source, nextArmStart, "_") and afterUnderscore < size and
                textLib.at(source, afterUnderscore) == "{";
                var armOpen := -1;
                if isFallback {
                    armOpen = afterUnderscore;
                    hasElse = true;
                    if currentLive { listLib.pushBack(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, if blockKind == BLOCK_KIND_MATCH_VALUE { BLOCK_KIND_MATCH_ELSE_VALUE } else { BLOCK_KIND_MATCH_ELSE });
                    blockCount = blockCount + 1;
                } else {
                    armOpen = scanConditionOpen(source, nextArmStart, prefix);
                    if armOpen < 0 {
                        failAt(source, nextArmStart, prefix, "expected { after match arm condition");
                    }
                    if armOpen == nextArmStart {
                        failAt(source, nextArmStart, prefix, "match arm header requires grouping for { ... } expressions");
                    }
                    rejectHeaderBlockTag(source, nextArmStart, prefix, "match arm");
                    condition := parseExpressionCtx(target, source, nextArmStart, prefix, locals, functions, functionParams, currentName, stmtCtxs, aliases);
                    afterCond := skipTrivia(source, condition.next, prefix);
                    rejectMisplacedTag(source, afterCond, prefix, "block tag cannot appear before { in match arm");
                    if afterCond > armOpen {
                        failAt(source, armOpen, prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                    }
                    if afterCond =!= armOpen {
                        _ := expectSymbol(source, afterCond, "{", prefix);
                    }
                    if condition.kind =!= "Bool" {
                        failAt(source, nextArmStart, prefix, "match arm condition must be Bool");
