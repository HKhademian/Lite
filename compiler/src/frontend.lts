formatLib := import "core/format";
listLib := import "core/list";
sourceLib := import "core/source";
diagLib := import "core/diag";
numeric := import "./numeric-literals.lts";
integer := import "core/int";
tsLiteral := import "./ts-literals.lts";
cLiteral := import "./c-literals.lts";
io := import "core/io";
textLib := import "core/text";

/** Selects the TS or C backend implementation for one emitted literal operation. */
targetBoolLiteralCode := fn(target: String, value: Bool): String { if target == "ts" { tsLiteral.boolLiteralCode(value) } else { cLiteral.boolLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonChainCode := fn(target: String, codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String { if target == "ts" { tsLiteral.comparisonChainCode(codes, kinds, operators, count, position) } else { cLiteral.comparisonChainCode(codes, kinds, operators, count, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetComparisonCode := fn(target: String, op: String, kind: String, left: String, right: String): String { if target == "ts" { tsLiteral.comparisonCode(op, kind, left, right) } else { cLiteral.comparisonCode(op, kind, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetConcatCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.concatCode(left, right) } else { cLiteral.concatCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatBinaryCode := fn(target: String, op: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatBinaryCode(op, left, right, position) } else { cLiteral.floatBinaryCode(op, left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32BinaryCode := fn(target: String, op: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.float32BinaryCode(op, left, right, position) } else { cLiteral.float32BinaryCode(op, left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatLiteralCode := fn(target: String, digits: String, negative: Bool): String { if target == "ts" { tsLiteral.floatLiteralCode(digits, negative) } else { cLiteral.floatLiteralCode(digits, negative) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32LiteralCode := fn(target: String, digits: String, negative: Bool): String { if target == "ts" { tsLiteral.float32LiteralCode(digits, negative) } else { cLiteral.float32LiteralCode(digits, negative) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatOperandCode := fn(target: String, kind: String, code: String): String { if target == "ts" { tsLiteral.floatOperandCode(kind, code) } else { cLiteral.floatOperandCode(kind, code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloat32OperandCode := fn(target: String, kind: String, code: String): String { if target == "ts" { tsLiteral.float32OperandCode(kind, code) } else { cLiteral.float32OperandCode(kind, code) } }
/** Selects the TS or C backend implementation for checked narrow integer arithmetic. */
targetCheckedNarrowIntCode := fn(target: String, kind: String, value: String, position: Int): String { if target == "ts" { tsLiteral.checkedNarrowIntCode(kind, value, position) } else { cLiteral.checkedNarrowIntCode(kind, value, position) } }
/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntScalarKind := fn(kind: String): Bool { numeric.isIntKind(kind) }
/** True when `kind` is one of the binary float scalar types (`Float32`, `Float`). */
pub isFloatScalarKind := fn(kind: String): Bool { numeric.isFloatKind(kind) }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloatPowerCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.floatPowerCode(left, right, position) } else { cLiteral.floatPowerCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorDivCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorDivCode(left, right) } else { cLiteral.floorDivCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetFloorModCode := fn(target: String, left: String, right: String): String { if target == "ts" { tsLiteral.floorModCode(left, right) } else { cLiteral.floorModCode(left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntAddCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intAddCode(left, right, position) } else { cLiteral.intAddCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intDivideCode(left, right, position) } else { cLiteral.intDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorDivideCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorDivideCode(left, right, position) } else { cLiteral.intFloorDivideCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntFloorModuloCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intFloorModuloCode(left, right, position) } else { cLiteral.intFloorModuloCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntLiteralCode := fn(target: String, value: Int, negative: Bool, digits: String): String { if target == "ts" { tsLiteral.intLiteralCode(value, negative, digits) } else { cLiteral.intLiteralCode(value, negative, digits) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntMultiplyCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intMultiplyCode(left, right, position) } else { cLiteral.intMultiplyCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntNegateCode := fn(target: String, value: String, position: Int): String { if target == "ts" { tsLiteral.intNegateCode(value, position) } else { cLiteral.intNegateCode(value, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntRemainderCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intRemainderCode(left, right, position) } else { cLiteral.intRemainderCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetIntSubtractCode := fn(target: String, left: String, right: String, position: Int): String { if target == "ts" { tsLiteral.intSubtractCode(left, right, position) } else { cLiteral.intSubtractCode(left, right, position) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetListCopyCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.listCopyCode(code) } else { cLiteral.listCopyCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetLogicCode := fn(target: String, op: String, left: String, right: String): String { if target == "ts" { tsLiteral.logicCode(op, left, right) } else { cLiteral.logicCode(op, left, right) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetNotCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.notCode(value) } else { cLiteral.notCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetTextLiteralCode := fn(target: String, value: String): String { if target == "ts" { tsLiteral.textLiteralCode(value) } else { cLiteral.textLiteralCode(value) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitEvaluationCode := fn(target: String, code: String): String { if target == "ts" { tsLiteral.unitEvaluationCode(code) } else { cLiteral.unitEvaluationCode(code) } }
/** Selects the TS or C backend implementation for one emitted literal operation. */
targetUnitLiteralCode := fn(target: String): String { if target == "ts" { tsLiteral.unitLiteralCode() } else { cLiteral.unitLiteralCode() } }
/* Shared restricted front-end. Not a standalone program: a target manifest
   places the target literal encoders before this file and the emitter/driver
   after it. */
/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements: source name, hygienic runtime name, value kind, binding reassignment permission, held-data write grant, declaration block depth, constant value, target code, and definite-initialization state ("init", "uninit", or "maybe"). */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);
/** One program or module-graph item: a report stream entry, declaration, control-flow marker, import edge, public function signature or module visit boundary. */
pub Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Parsed module/compiler items returned by parseProgram and consumed by the module collector and backend emitters. */
pub Items := type List<Item>;
/** Completion facts saved while an inner block is parsed; earlier conditional arms are joined only after a final else. */
BlockState := type (returned: Bool, stopped: Bool, branchesReturned: Bool, branchesStopped: Bool, hasElse: Bool, loopForever: Bool, live: Bool, preLocalsLen: Int, liveBranchCount: Int);
/** One outer local initialization update recorded at the end of a conditional branch. */
BranchUpdate := type (depth: Int, runtime: String, initState: String);
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := type (text: String, width: Int);
/** One previously declared top-level function: source name, result kind, first parameter entry and parameter count. */
FunctionInfo := type (name: String, runtime: String, result: String, first: Int, count: Int);
/** A later top-level scalar definition visible only while checking a deferred function body. */
FutureValue := type (name: String, runtime: String, kind: String, at: Int, intValue: Int, textValue: String);
/** One top-level transparent type alias: source name, raw target type text, declaration position and the position just after that target. */
AliasDecl := type (name: String, target: String, at: Int, end: Int);
/** Lexical control-flow and metadata context for an enclosing function, block, conditional, match, loop or finally scope. */
ConstructCtx := type (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool);

/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := sourceLib.lineColumn(source, position);
    diagLib.fail(prefix, formatLib.decimalText(place.line) + ":" + formatLib.decimalText(place.column) + ": " + message);
}

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLib.length(source) or textLib.at(source, position) =!= symbol {
        failAt(source, position, prefix, "expected " + symbol);
    }
    position + 1
}

/** Number of consecutive `#` characters after a comment opener; zero means an ordinary comment. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not textLib.startsWithAt(source, position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < textLib.length(source) and textLib.at(source, index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`; fails at the opener when its fence never closes. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := position + 2 + fence;
    loop cursor < size {
        if textLib.at(source, cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and textLib.at(source, runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and textLib.startsWithAt(source, runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    failAt(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop true {
        if cursor >= size {
            failAt(source, position, prefix, "unterminated comment");
        }
        ch := textLib.at(source, cursor);
        if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            innerFence := rawFenceLength(source, cursor);
            if innerFence > 0 {
                cursor = skipRawComment(source, cursor, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = cursor + 2;
            }
        } else if ch == "*" and textLib.startsWithAt(source, cursor, "*/") {
            depth = depth - 1;
            cursor = cursor + 2;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var position := start;
    loop position < size {
        ch := textLib.at(source, position);
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            position = position + 1;
        } else if ch == "/" and textLib.startsWithAt(source, position, "/*") {
            position = skipComment(source, position, prefix);
        } else {
            break;
        }
    }
    position
}

/** Consumes an explicit separator or an implicit boundary at EOF, a closing scope or a directly closed block expression. Returns -1 when a simple item still needs a separator. */
consumeStatementEnd := fn(source: String, position: Int, prefix: String): Int {
    next := skipTrivia(source, position, prefix);
    if next < textLib.length(source) and textLib.at(source, next) == ";" { return skipTrivia(source, next + 1, prefix); }
    if next == textLib.length(source) or textLib.at(source, next) == "}" or
        (position > 0 and textLib.at(source, position - 1) == "}") { return next; }
    -1
}

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool {
    name == "pub" or name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or
    name == "import" or name == "using" or name == "record" or name == "type" or
    name == "and" or name == "or" or name == "not" or name == "true" or name == "false"
}

/** Returns the documentation path for one reserved Lite feature. */
featureDoc := fn(name: String): String {
    match {
        name == "loop" { "docs/loops.md" }
        name == "if" or name == "else" or name == "and" or name == "or" or name == "not" or
            name == "true" or name == "false" { "docs/conditionals.md" }
        name == "var" or name == "mut" { "docs/declarations-and-assignment.md" }
        name == "fn" or name == "return" { "docs/functions.md" }
        name == "match" { "docs/match.md" }
        name == "pub" or name == "import" or name == "using" { "docs/modules-and-packages.md" }
        name == "record" or name == "type" { "docs/types-and-inference.md" }
        name == "break" or name == "continue" { "docs/control-flow.md" }
        name == "then" or name == "finally" { "docs/finally.md" }
        _ { "docs/grammar-sketch.md" }
    }
}

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit {
    failAt(source, position, prefix, "unsupported feature \"" + name + "\": see " + featureDoc(name) +
        "; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only");
}

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int {
    var index := 0;
    loop functions as entry {
        if entry.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool {
    name == "List" or name == "Float" or name == "Double" or name == "Array" or
    name == "Option" or name == "Result" or name == "record" or name == "fn"
}

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit {
    failAt(source, position, prefix, "unsupported type alias " + target +
        "; only Int, Float, String, Bool, Unit, List<T>, flat named tuples and aliases are supported");
}

/** Returns the index of the first top-level alias named `name`, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    var index := 0;
    loop aliases as alias {
        if alias.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Reads one local or module-qualified type name. */
typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) {
    firstEnd := textLib.skipName(source, position);
    first := textLib.slice(source, position, firstEnd);
    afterFirst := skipTrivia(source, firstEnd, prefix);
    if afterFirst < textLib.length(source) and textLib.at(source, afterFirst) == "." {
        memberStart := skipTrivia(source, afterFirst + 1, prefix);
        if memberStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, memberStart)) {
            failAt(source, memberStart, prefix, "expected a type name after .");
        }
        memberEnd := textLib.skipName(source, memberStart);
        member := textLib.slice(source, memberStart, memberEnd);
        return (name = first + "." + member, next = memberEnd);
    }
    (name = first, next = firstEnd)
}

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int {
    var index := 0;
    loop aliases as alias {
        if alias.at == position { return index; }
        index = index + 1;
    }
    -1
}

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool {
    textLib.length(kind) > 0 and textLib.at(kind, 0) == "("
}

/** Returns the runtime JS property name for a tuple field (`_0` when unnamed, otherwise the field label). */
pub tupleRuntimeProp := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) } else { label }
}

/** Returns the JS/TS object-literal property key for a tuple field, quoting `__proto__` to avoid prototype mutation. */
pub tupleObjectKey := fn(label: String, index: Int): String {
    if label == "" { "_" + integer.intText(index) }
    else if label == "__proto__" { "[\"__proto__\"]" }
    else { label }
}

/** Returns the number of components in one canonical flat tuple kind. */
pub tupleComponentCount := fn(kind: String): Int {
    if not isTupleKind(kind) { return 0; }
    size := textLib.length(kind);
    var cursor := 1;
    var count := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        if textLib.at(kind, cursor) =!= ":" { cursor = textLib.skipName(kind, cursor); }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        cursor = textLib.skipName(kind, cursor);
        count = count + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    count
}

/** Returns the label, scalar kind and runtime property name of component `targetIndex` in a canonical tuple kind. */
pub tupleComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) {
    size := textLib.length(kind);
    var cursor := 1;
    var index := 0;
    loop cursor < size and textLib.at(kind, cursor) =!= ")" {
        var label := "";
        if textLib.at(kind, cursor) =!= ":" {
            nameStart := cursor;
            cursor = textLib.skipName(kind, cursor);
            label = textLib.slice(kind, nameStart, cursor);
        }
        if cursor < size and textLib.at(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = textLib.skipName(kind, cursor);
        fieldKind := textLib.slice(kind, typeStart, cursor);
        if index == targetIndex {
            return (label = label, kind = fieldKind, prop = tupleRuntimeProp(label, index));
        }
        index = index + 1;
        if cursor < size and textLib.at(kind, cursor) == "," { cursor = cursor + 1; }
    }
    (label = "", kind = "", prop = "")
}

/** True when `expectedKind` and `actualKind` are tuples with identical component counts and positional component types. */
pub tupleShapeMatches := fn(expectedKind: String, actualKind: String): Bool {
    if not isTupleKind(expectedKind) or not isTupleKind(actualKind) { return false; }
    count := tupleComponentCount(expectedKind);
    if count =!= tupleComponentCount(actualKind) { return false; }
    var index := 0;
    loop index < count {
        if tupleComponent(expectedKind, index).kind =!= tupleComponent(actualKind, index).kind {
            return false;
        }
        index = index + 1;
    }
    true
}

/** Converts one tuple expression to `expectedKind` by copying positional components into the receiving labels. */
pub convertTupleValue := fn(expectedKind: String, actualKind: String, actualCode: String): String {
    count := tupleComponentCount(expectedKind);
    var fields := "";
    var index := 0;
    loop index < count {
        expectedComp := tupleComponent(expectedKind, index);
        actualComp := tupleComponent(actualKind, index);
        if index > 0 { fields = fields + ", "; }
        fields = fields + tupleObjectKey(expectedComp.label, index) + ": lite$t." + actualComp.prop;
        index = index + 1;
    }
    "(() => { const lite$t = " + actualCode + "; return { " + fields + " }; })()"
}

/** True when `actualKind` is directly `expectedKind`, `Never` into a known target, losslessly widens numerically, or is a tuple with matching positional component types. */
pub isCompatibleKind := fn(expectedKind: String, actualKind: String): Bool {
    (expectedKind =!= "" and actualKind == "Never") or expectedKind == actualKind or
    numeric.numericWidens(expectedKind, actualKind) or tupleShapeMatches(expectedKind, actualKind)
}

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
pub isListKind := fn(kind: String): Bool {
    textLib.length(kind) > 5 and textLib.startsWithAt(kind, 0, "List<") and textLib.at(kind, textLib.length(kind) - 1) == ">"
}

/** Returns the canonical element kind from `List<ElementKind>`. */
pub listElementKind := fn(kind: String): String {
    if not isListKind(kind) { return ""; }
    textLib.slice(kind, 5, textLib.length(kind) - 1)
}

/** Finds the top-level `;` inside `[ElementKind;Extent]`, or -1 when `kind` is not a canonical fixed-array kind. */
arraySemiIndex := fn(kind: String): Int {
    size := textLib.length(kind);
    if size < 5 or textLib.at(kind, 0) =!= "[" or textLib.at(kind, size - 1) =!= "]" { return -1; }
    var cursor := 1;
    var depth := 0;
    loop cursor < size - 1 {
        ch := textLib.at(kind, cursor);
        if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
        else if ch == ")" or ch == "]" or ch == ">" { depth = depth - 1; }
        else if ch == ";" and depth == 0 { return cursor; }
        cursor = cursor + 1;
    }
    -1
}

/** True when `kind` is this compiler's canonical fixed-array kind, written `[ElementKind;Extent]`. */
pub isArrayKind := fn(kind: String): Bool {
    arraySemiIndex(kind) > 1
}

/** Returns the canonical element kind from `[ElementKind;Extent]`. */
pub arrayElementKind := fn(kind: String): String {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return ""; }
    textLib.slice(kind, 1, semi)
}

/** Maps one ASCII decimal digit character to its integer value 0..9. */
decimalDigit := fn(ch: String): Int {
    match {
        ch == "0" { 0 }
        ch == "1" { 1 }
        ch == "2" { 2 }
        ch == "3" { 3 }
        ch == "4" { 4 }
        ch == "5" { 5 }
        ch == "6" { 6 }
        ch == "7" { 7 }
        ch == "8" { 8 }
        _ { 9 }
    }
}

/** Parses non-negative decimal digits in `text` from `start` to `end`. */
parseDigits := fn(text: String, start: Int, end: Int): Int {
    var result := 0;
    var cursor := start;
    loop cursor < end {
        result = result * 10 + decimalDigit(textLib.at(text, cursor));
        cursor = cursor + 1;
    }
    result
}

/** Returns the integer extent from `[ElementKind;Extent]`. */
pub arrayExtent := fn(kind: String): Int {
    semi := arraySemiIndex(kind);
    if semi <= 1 { return 0; }
    parseDigits(kind, semi + 1, textLib.length(kind) - 1)
}

/** Formats one canonical flat tuple kind as a TypeScript object type. */
pub tsTupleType := fn(kind: String): String {
    count := tupleComponentCount(kind);
    var result := "{ ";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { result = result + "; "; }
        result = result + tupleObjectKey(comp.label, index) + ": " + tsLiteral.tsScalarType(comp.kind);
        index = index + 1;
    }
    result + " }"
}

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array or List kind to its TypeScript type. */
pub tsFunctionType := fn(kind: String): String {
    if isListKind(kind) { self(listElementKind(kind)) + "[]" }
    else if isArrayKind(kind) { self(arrayElementKind(kind)) + "[]" }
    else if isTupleKind(kind) { tsTupleType(kind) }
    else { tsLiteral.tsScalarType(kind) }
}

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
pub tsDisplayValueCode := fn(kind: String, code: String): String {
    if isIntScalarKind(kind) or isFloatScalarKind(kind) { return "(" + code + ").toString()"; }
    if kind == "Bool" { return "((" + code + ") ? \"true\" : \"false\")"; }
    if kind == "Unit" { return "((value: unknown): string => { void value; return \"Unit\"; })(" + code + ")"; }
    if isListKind(kind) or isArrayKind(kind) {
        element := if isListKind(kind) { listElementKind(kind) } else { arrayElementKind(kind) };
        return "(\"[\" + (" + code + ").map((value: " + tsFunctionType(element) + ") => " + self(element, "value") + ").join(\", \") + \"]\")";
    }
    if isTupleKind(kind) {
        var result := tsLiteral.textLiteralCode("(");
        count := tupleComponentCount(kind);
        var index := 0;
        loop index < count {
            comp := tupleComponent(kind, index);
            separator := if index == 0 { "" } else { ", " };
            prefixText := if comp.label == "" { separator } else { separator + comp.label + "=" };
            result = result + " + " + tsLiteral.textLiteralCode(prefixText) + " + " + self(comp.kind, "value." + comp.prop);
            index = index + 1;
        }
        ending := if count == 1 { ",)" } else { ")" };
        return "((value: " + tsFunctionType(kind) + "): string => " + result + " + " + tsLiteral.textLiteralCode(ending) + ")(" + code + ")";
    }
    code
}

/** True when emitted target code calls `needle` outside quoted String literal text. */
codeUsesTextCall := fn(code: String, needle: String): Bool {
    if textLib.indexOfText(code, needle, 0) < 0 { return false; }
    size := textLib.length(code);
    if size == 0 { return false; }
    width := textLib.length(needle);
    if width == 0 { return true; }
    first := textLib.at(needle, 0);
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := textLib.at(code, cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if ch == first and textLib.startsWithAt(code, cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
}

/** True when emitted target code calls a checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(") or codeUsesTextCall(code, "lite$listPopFront(")
}

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
}

/** Returns the scalar kind of tuple field `label` in canonical `kind`, or empty text when the field is absent. */
tupleFieldKind := fn(kind: String, label: String): String {
    count := tupleComponentCount(kind);
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if comp.label =!= "" and comp.label == label { return comp.kind; }
        index = index + 1;
    }
    ""
}

/** Renders one canonical kind for diagnostics, adding spaces inside flat tuples and lists. */
displayKind := fn(kind: String): String {
    if isListKind(kind) { return "List<" + displayKind(listElementKind(kind)) + ">"; }
    if isArrayKind(kind) { return "[" + displayKind(arrayElementKind(kind)) + "; " + integer.intText(arrayExtent(kind)) + "]"; }
    if not isTupleKind(kind) { return kind; }
    count := tupleComponentCount(kind);
    var result := "(";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { result = result + ", "; }
        if comp.label == "" {
            result = result + displayKind(comp.kind);
        } else {
            result = result + comp.label + ": " + displayKind(comp.kind);
        }
        index = index + 1;
    }
    if count == 1 and tupleComponent(kind, 0).label == "" { result = result + ","; }
    result + ")"
}

/** Resolves one scalar or flat named-tuple type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String {
    size := textLib.length(text);
    var cursor := skipTrivia(text, 0, prefix);
    if cursor < size and textLib.at(text, cursor) == "(" {
        cursor = skipTrivia(text, cursor + 1, prefix);
        labels: mut List<String> = [];
        var kindText := "(";
        var count := 0;
        var hadComma := false;
        var singleLabel := "";
        var singleKind := "";
        var hadColon := false;
        loop true {
            if cursor >= size { failAt(source, position, prefix, "expected ) in tuple type"); }
            if textLib.at(text, cursor) == ")" {
                cursor = cursor + 1;
                break;
            }
            if textLib.at(text, cursor) == "(" {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            var label := "";
            var componentName := "";
            if textLib.at(text, cursor) == ":" {
                hadColon = true;
                cursor = skipTrivia(text, cursor + 1, prefix);
                if cursor < size and textLib.at(text, cursor) == "(" {
                    failAt(source, position, prefix, "nested tuple types are not supported");
                }
                if cursor >= size or not textLib.isNameStart(textLib.at(text, cursor)) {
                    failAt(source, position, prefix, "expected a tuple field type");
                }
                componentStart := cursor;
                cursor = textLib.skipName(text, cursor);
                componentName = textLib.slice(text, componentStart, cursor);
            } else {
                if not textLib.isNameStart(textLib.at(text, cursor)) {
                    failAt(source, position, prefix, "expected a tuple field name");
                }
                firstStart := cursor;
                firstEnd := textLib.skipName(text, cursor);
                firstName := textLib.slice(text, firstStart, firstEnd);
                afterFirst := skipTrivia(text, firstEnd, prefix);
                if afterFirst < size and textLib.at(text, afterFirst) == ":" {
                    label = firstName;
                    if listLib.listContainsText(labels, label) {
                        failAt(source, position, prefix, "duplicate tuple field " + label);
                    }
                    listLib.pushBack(mut labels, label);
                    cursor = skipTrivia(text, afterFirst + 1, prefix);
                    if cursor < size and textLib.at(text, cursor) == "(" {
                        failAt(source, position, prefix, "nested tuple types are not supported");
                    }
                    if cursor >= size or not textLib.isNameStart(textLib.at(text, cursor)) {
                        failAt(source, position, prefix, "expected a tuple field type");
                    }
                    componentStart := cursor;
                    cursor = textLib.skipName(text, cursor);
                    componentName = textLib.slice(text, componentStart, cursor);
                } else {
                    componentName = firstName;
                    cursor = firstEnd;
                }
            }
            componentKind := resolveTypeText(source, position, prefix, aliases, componentName, seen);
            if isTupleKind(componentKind) {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            if isListKind(componentKind) {
                failAt(source, position, prefix, "list types inside tuples are not supported");
            }
            if componentKind == "Unit" {
                failAt(source, position, prefix, "unsupported tuple component type Unit");
            }
            if count > 0 { kindText = kindText + ","; }
            kindText = kindText + label + ":" + componentKind;
            if count == 0 { singleLabel = label; singleKind = componentKind; }
            count = count + 1;
            cursor = skipTrivia(text, cursor, prefix);
            if cursor < size and textLib.at(text, cursor) == "," {
                hadComma = true;
                cursor = skipTrivia(text, cursor + 1, prefix);
            }
        }
        if count == 0 {
            failAt(source, position, prefix, "tuple type needs at least one field");
        }
        cursor = skipTrivia(text, cursor, prefix);
        if cursor < size {
            failAt(source, position, prefix, "unexpected text after tuple type");
        }
        if count == 1 and singleLabel == "" and not hadComma {
            if hadColon { failAt(source, position, prefix, "unnamed singleton tuple type needs trailing comma"); }
            return singleKind;
        }
        return kindText + ")";
    }
    if textLib.at(text, cursor) == "[" {
        var scan := cursor + 1;
        var depth := 0;
        var semi := -1;
        var close := -1;
        loop scan < size {
            ch := textLib.at(text, scan);
            if ch == "(" or ch == "[" or ch == "<" { depth = depth + 1; }
            else if ch == ")" or ch == ">" { depth = depth - 1; }
            else if ch == "]" {
                if depth == 0 {
                    close = scan;
                    break;
                }
                depth = depth - 1;
            } else if ch == ";" and depth == 0 and semi < 0 {
                semi = scan;
            }
            scan = scan + 1;
        }
        if close < 0 or semi < 0 {
            failAt(source, position, prefix, "expected [Type; Extent] in array type");
            return "";
        }
        elemText := textLib.slice(text, cursor + 1, semi);
        elemKind := resolveTypeText(source, position, prefix, aliases, elemText, seen);
        if elemKind == "Unit" {
            failAt(source, position, prefix, "unsupported array element type Unit");
        }
        extentStart := skipTrivia(text, semi + 1, prefix);
        var extentEnd := extentStart;
        loop extentEnd < close and textLib.isDigit(textLib.at(text, extentEnd)) { extentEnd = extentEnd + 1; }
        if extentEnd == extentStart or skipTrivia(text, extentEnd, prefix) < close {
            failAt(source, position, prefix, "expected positive integer extent in array type");
        }
        extent := parseDigits(text, extentStart, extentEnd);
        afterArray := skipTrivia(text, close + 1, prefix);
        if afterArray < size {
            failAt(source, position, prefix, "unexpected text after array type");
        }
        return "[" + elemKind + ";" + integer.intText(extent) + "]";
    }
    parsedName := typeNameAt(text, cursor, prefix);
    after := parsedName.next;
    name := parsedName.name;
    afterTrivia := skipTrivia(text, after, prefix);
    if name == "List" and afterTrivia < size and textLib.at(text, afterTrivia) == "<" {
        innerStart := skipTrivia(text, afterTrivia + 1, prefix);
        if innerStart >= size or textLib.at(text, innerStart) == ">" {
            failAt(source, position, prefix, "expected a list element type");
        }
        var scan := innerStart;
        var depth := 0;
        var close := -1;
        loop scan < size {
            ch := textLib.at(text, scan);
            if ch == "<" {
                depth = depth + 1;
            } else if ch == ">" {
                if depth == 0 {
                    close = scan;
                    break;
                }
                depth = depth - 1;
            }
            scan = scan + 1;
        }
        if close < 0 {
            failAt(source, position, prefix, "expected > in list type");
        }
        innerText := textLib.slice(text, innerStart, close);
        innerKind := resolveTypeText(source, position, prefix, aliases, innerText, seen);
        if isListKind(innerKind) {
            failAt(source, position, prefix, "nested list types are not supported");
        }
        afterList := skipTrivia(text, close + 1, prefix);
        if afterList < size {
            failAt(source, position, prefix, "unexpected text after list type");
        }
        return "List<" + innerKind + ">";
    }
    if afterTrivia < size {
        failAt(source, position, prefix, "unexpected text after type " + name);
    }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" or numeric.isNarrowNumericKind(name) { return name; }
    numericKind := numeric.numericAliasKind(name);
    if numericKind =!= "" { return numericKind; }
    if isUnsupportedAliasTarget(name) {
        unsupportedAliasTarget(source, position, prefix, name);
        return "";
    }
    index := findAlias(aliases, name);
    if index < 0 {
        failAt(source, position, prefix, "unknown type alias " + name);
        return "";
    }
    alias := aliases[index];
    if listLib.listContainsText(seen, name) {
        failAt(source, alias.at, prefix, "recursive type alias " + name);
        return "";
    }
    if alias.target == "" {
        unsupportedAliasTarget(source, alias.at, prefix, "target");
        return "";
    }
    nextSeen: mut List<String> = seen;
    listLib.pushBack(mut nextSeen, name);
    resolveTypeText(source, alias.at, prefix, aliases, alias.target, nextSeen)
}

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String {
    resolveTypeText(source, position, prefix, aliases, name, seen)
}

/** Parses one source-level flat named-tuple type `(label: Type, ...)`; components must resolve to Int, String or Bool. */
parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    labels: mut List<String> = [];
    var kindText := "(";
    var count := 0;
    var hadComma := false;
    var singleLabel := "";
    var singleKind := "";
    var hadColon := false;
    loop true {
        if cursor >= size { failAt(source, cursor, prefix, "expected ) in tuple type"); }
        if textLib.at(source, cursor) == ")" {
            cursor = cursor + 1;
            break;
        }
        if textLib.at(source, cursor) == "(" {
            failAt(source, cursor, prefix, "nested tuple types are not supported");
        }
        var label := "";
        var componentStart := cursor;
        var componentName := "";
        if textLib.at(source, cursor) == ":" {
            hadColon = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == "(" {
                failAt(source, cursor, prefix, "nested tuple types are not supported");
            }
            if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a tuple field type");
            }
            componentStart = cursor;
            parsedComponent := typeNameAt(source, cursor, prefix);
            cursor = parsedComponent.next;
            componentName = parsedComponent.name;
        } else {
            if not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a tuple field name");
            }
            firstStart := cursor;
            firstEnd := textLib.skipName(source, cursor);
            firstName := textLib.slice(source, firstStart, firstEnd);
            afterFirst := skipTrivia(source, firstEnd, prefix);
            if afterFirst < size and textLib.at(source, afterFirst) == ":" {
                label = firstName;
                if isReservedWord(label) { unsupportedFeature(source, firstStart, label, prefix); }
                if listLib.listContainsText(labels, label) {
                    failAt(source, firstStart, prefix, "duplicate tuple field " + label);
                }
                listLib.pushBack(mut labels, label);
                cursor = skipTrivia(source, afterFirst + 1, prefix);
                if cursor < size and textLib.at(source, cursor) == "(" {
                    failAt(source, cursor, prefix, "nested tuple types are not supported");
                }
                if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                    failAt(source, cursor, prefix, "expected a tuple field type");
                }
                componentStart = cursor;
                parsedComponent := typeNameAt(source, cursor, prefix);
                cursor = parsedComponent.next;
                componentName = parsedComponent.name;
            } else {
                parsedComponent := typeNameAt(source, firstStart, prefix);
                cursor = parsedComponent.next;
                componentName = parsedComponent.name;
            }
        }
        var componentKind := "";
        if componentName == "Int" or componentName == "Float" or componentName == "String" or componentName == "Bool" or componentName == "Unit" or numeric.isNarrowNumericKind(componentName) {
            componentKind = componentName;
        } else {
            componentKind = numeric.numericAliasKind(componentName);
            if componentKind == "" {
                if findAlias(aliases, componentName) >= 0 {
                    seen: mut List<String> = [];
                    componentKind = resolveAliasKind(source, componentStart, prefix, aliases, componentName, seen);
                } else {
                    failAt(source, componentStart, prefix, "unsupported tuple field type " + componentName);
                }
            }
        }
        if isTupleKind(componentKind) {
            failAt(source, componentStart, prefix, "nested tuple types are not supported");
        }
        if isListKind(componentKind) {
            failAt(source, componentStart, prefix, "list types inside tuples are not supported");
        }
        if componentKind == "Unit" {
            failAt(source, componentStart, prefix, "unsupported tuple component type Unit");
        }
        if count > 0 { kindText = kindText + ","; }
        kindText = kindText + label + ":" + componentKind;
        if count == 0 { singleLabel = label; singleKind = componentKind; }
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
        }
    }
    if count == 0 {
        failAt(source, position, prefix, "tuple type needs at least one field");
    }
    if count == 1 and singleLabel == "" and not hadComma {
        if hadColon { failAt(source, position, prefix, "unnamed singleton tuple type needs trailing comma"); }
        return (kind = singleKind, next = cursor);
    }
    (kind = kindText + ")", next = cursor)
}

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple or `List<T>`. */
parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String): (kind: String, next: Int) {
    start := skipTrivia(source, position, prefix);
    if start < textLib.length(source) and textLib.at(source, start) == "(" {
        return parseTupleTypeAt(source, position, prefix, aliases);
    }
    if start < textLib.length(source) and textLib.at(source, start) == "[" {
        elemStart := skipTrivia(source, start + 1, prefix);
        inner := self(source, elemStart, prefix, aliases, context, genericType);
        if inner.kind == "Unit" {
            failAt(source, elemStart, prefix, "unsupported array element type Unit");
        }
        semi := expectSymbol(source, skipTrivia(source, inner.next, prefix), ";", prefix);
        extentStart := skipTrivia(source, semi, prefix);
        var extentEnd := extentStart;
        loop extentEnd < textLib.length(source) and textLib.isDigit(textLib.at(source, extentEnd)) {
            extentEnd = extentEnd + 1;
        }
        if extentEnd == extentStart {
            failAt(source, extentStart, prefix, "expected positive integer extent in array type");
        }
        extent := parseDigits(source, extentStart, extentEnd);
        close := expectSymbol(source, skipTrivia(source, extentEnd, prefix), "]", prefix);
        return (kind = "[" + inner.kind + ";" + integer.intText(extent) + "]", next = close);
    }
    parsedName := typeNameAt(source, start, prefix);
    after := parsedName.next;
    name := parsedName.name;
    afterName := skipTrivia(source, after, prefix);
    if name == "List" and afterName < textLib.length(source) and textLib.at(source, afterName) == "<" {
        innerStart := skipTrivia(source, afterName + 1, prefix);
        if innerStart >= textLib.length(source) or textLib.at(source, innerStart) == ">" {
            failAt(source, innerStart, prefix, "expected a list element type");
        }
        inner := parseTypeAt(source, innerStart, prefix, aliases, context, genericType);
        if isListKind(inner.kind) {
            failAt(source, innerStart, prefix, "nested list types are not supported");
        }
        var close := skipTrivia(source, inner.next, prefix);
        close = expectSymbol(source, close, ">", prefix);
        return (kind = "List<" + inner.kind + ">", next = close);
    }
    if genericType =!= "" and name == genericType { return (kind = genericType, next = after); }
    if name == "Int" or name == "Float" or name == "String" or name == "Bool" or name == "Unit" or numeric.isNarrowNumericKind(name) {
        return (kind = name, next = after);
    }
    numericKind := numeric.numericAliasKind(name);
    if numericKind =!= "" { return (kind = numericKind, next = after); }
    if findAlias(aliases, name) >= 0 {
        seen: mut List<String> = [];
        return (kind = resolveAliasKind(source, start, prefix, aliases, name, seen), next = after);
    }
    if textLib.indexOfText(name, ".", 0) >= 0 {
        failAt(source, start, prefix, "unknown type alias " + name);
    }
    failAt(source, start, prefix, "unsupported " + context + " type " + name);
    (kind = "", next = after)
}

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (kind: String, next: Int) {
    parseTypeAt(source, position, prefix, aliases, "function", genericType)
}

/** Parses a function signature. The optional `T` binder is only enabled for the registered core list declarations. */
parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): (next: Int, result: String, params: String, count: Int, genericType: String) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, position, prefix);
    var genericType := "";
    if listIntrinsic {
        cursor = expectSymbol(source, cursor, "<", prefix);
        binderStart := skipTrivia(source, cursor, prefix);
        binder := typeNameAt(source, binderStart, prefix);
        if binder.name =!= "T" { failAt(source, binderStart, prefix, "core list intrinsic type parameter must be T"); }
        genericType = binder.name;
        cursor = expectSymbol(source, binder.next, ">", prefix);
        cursor = skipTrivia(source, cursor, prefix);
    }
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    names: mut List<String> = [];
    var encoded := "";
    var count := 0;
    if textLib.startsWithAt(source, cursor, "...") {
        cursor = skipTrivia(source, cursor + 3, prefix);
        if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a name after ... in host value-pack declaration");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        encoded = "..." + textLib.slice(source, nameStart, cursor);
        count = -1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            failAt(source, cursor, prefix, "host value-pack declaration must be its only parameter");
        }
    } else if cursor < size and textLib.at(source, cursor) =!= ")" {
        loop true {
            if cursor >= size or not textLib.isNameStart(textLib.at(source, cursor)) {
                failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = textLib.skipName(source, cursor);
            parameterName := textLib.slice(source, nameStart, cursor);
            if isReservedWord(parameterName) { unsupportedFeature(source, nameStart, parameterName, prefix); }
            if listLib.listContainsText(names, parameterName) {
                failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            listLib.pushBack(mut names, parameterName);
            cursor = skipTrivia(source, cursor, prefix);
            cursor = expectSymbol(source, cursor, ":", prefix);
            cursor = skipTrivia(source, cursor, prefix);
            var access := "";
            if textLib.wordAt(source, cursor, "mut") {
                if not listIntrinsic { failAt(source, cursor, prefix, "mut parameter signatures are reserved for registered core declarations"); }
                access = "mut ";
                cursor = skipTrivia(source, cursor + 3, prefix);
            }
            typed := parseFunctionType(source, cursor, prefix, aliases, genericType);
            cursor = skipTrivia(source, typed.next, prefix);
            if count > 0 { encoded = encoded + "|"; }
            encoded = encoded + parameterName + "=" + access + typed.kind;
            count = count + 1;
            if cursor < size and textLib.at(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
    }
    cursor = expectSymbol(source, cursor, ")", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    cursor = expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, aliases, genericType);
    (next = resultType.next, result = resultType.kind, params = encoded, count = count, genericType = genericType)
}

/** Resolves a bodyless public core declaration only when its module identity and complete ABI are registered. */
coreHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.core.io.v1" {
        if params == "...values" and result == "Unit" {
            if name == "output" { "lite$core$io$output:v1" }
            else if name == "outputLine" { "lite$core$io$outputLine:v1" }
            else { "" }
        } else if name == "errorLine" and params == "text=String" and result == "Unit" { "lite$reportError" }
        else if name == "exit" and params == "status=Int" and result == "Unit" { "lite$exit" }
        else if name == "inputArgs" and params == "" and result == "List<String>" { "lite$inputArgs" }
        else if params == "prompt=String" and result == "String" {
            if name == "inputAll" { "lite$inputAll" } else if name == "inputLine" { "lite$inputLine" } else { "" }
        } else if params == "prompt=String" and result == "Int" and name == "inputInt" { "lite$inputInt" }
        else if params == "prompt=String" and result == "Float" and name == "inputFloat" { "lite$inputFloat" }
        else { "" }
    } else if moduleIdentity == "lite.core.text.v1" {
        if name == "length" and params == "text=String" and result == "Int" { "lite$textLength" }
        else if name == "at" and params == "text=String|position=Int" and result == "String" { "lite$textAt" }
        else if name == "slice" and params == "text=String|start=Int|end=Int" and result == "String" { "lite$textSlice" }
        else { "" }
    } else if moduleIdentity == "lite.core.list.v1" {
        if name == "pushBack" and params == "values=mut List<T>|value=T" and result == "Unit" { "lite$core$list$pushBack:v1" }
        else if name == "popBack" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popBack:v1" }
        else if name == "pushFront" and params == "values=mut List<T>|value=T" and result == "Unit" { "lite$core$list$pushFront:v1" }
        else if name == "popFront" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popFront:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.fs.v1" {
        if name == "kind" and params == "path=String" and result == "String" { "lite$fsKind" }
        else if name == "readText" and params == "path=String" and result == "(ok:Bool,text:String,error:String)" { "lite$fsReadText" }
        else if name == "writeText" and params == "path=String|text=String" and result == "(ok:Bool,error:String)" { "lite$fsWriteText" }
        else if name == "listDir" and params == "path=String" and result == "List<String>" { "lite$fsListDir" }
        else if name == "makeDir" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fsMakeDir" }
        else if name == "remove" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fsRemove" }
        else if name == "copy" and params == "fromPath=String|toPath=String" and result == "(ok:Bool,error:String)" { "lite$fsCopy" }
        else if name == "symlink" and params == "targetPath=String|linkPath=String" and result == "(ok:Bool,error:String)" { "lite$fsSymlink" }
        else if name == "realPath" and params == "path=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fsRealPath" }
        else if name == "makeTempDir" and params == "prefix=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fsMakeTempDir" }
        else { "" }
    } else if moduleIdentity == "lite.core.process.v1" {
        if name == "cwd" and params == "" and result == "String" { "lite$processCwd" }
        else if name == "execPath" and params == "" and result == "String" { "lite$processExecPath" }
        else if name == "entryPath" and params == "" and result == "String" { "lite$processEntryPath" }
        else if name == "platform" and params == "" and result == "String" { "lite$processPlatform" }
        else if name == "arch" and params == "" and result == "String" { "lite$processArch" }
        else if name == "runtimeVersion" and params == "" and result == "String" { "lite$processRuntimeVersion" }
        else if name == "envGet" and params == "name=String" and result == "(found:Bool,value:String)" { "lite$processEnvGet" }
        else if name == "run" and params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|capture=Bool|stdinText=String" and
            result == "(status:Int,stdout:String,stderr:String,error:String)" { "lite$processRun" }
        else { "" }
    } else if moduleIdentity == "lite.core.crypto.v1" {
        if name == "sha256Text" and params == "text=String" and result == "String" { "lite$cryptoSha256Text" }
        else if name == "sha256File" and params == "path=String" and result == "(ok:Bool,hex:String,error:String)" { "lite$cryptoSha256File" }
        else { "" }
    } else if moduleIdentity == "lite.core.time.v1" {
        if name == "monotonicNs" and params == "" and result == "Int" { "lite$timeMonotonicNs" }
        else if name == "utcIsoNow" and params == "" and result == "String" { "lite$timeUtcIsoNow" }
        else { "" }
    } else if moduleIdentity == "lite.compiler.source-reader.v1" and name == "read" and
        params == "importer=String|spec=String" and result == "(path:String,display:String,identity:String,text:String)" {
        "lite$readSource"
    } else {
        ""
    }
}

/** Maps one registered output intrinsic identity to its source special-statement name. */
coreOutputName := fn(runtime: String): String {
    match {
        runtime == "lite$core$io$output:v1" { "output" }
        runtime == "lite$core$io$outputLine:v1" { "outputLine" }
        _ { "" }
    }
}

/** Returns the source name from one encoded `name=kind` function parameter entry. */
paramNameOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return entry; }
    textLib.slice(entry, 0, separator)
}

/** Returns the kind from one encoded `name=kind` function parameter entry. */
paramKindOf := fn(entry: String): String {
    separator := textLib.indexOfText(entry, "=", 0);
    if separator < 0 { return ""; }
    textLib.slice(entry, separator + 1, textLib.length(entry))
}

/** Builds an integer parsed value with explicit scalar kind `kind`; `textValue` is empty. */
typedIntParsed := fn(kind: String, code: String, value: Int, constant: Bool, next: Int): Parsed {
    (kind = kind, code = code, intValue = value, textValue = "", constant = constant, next = next)
}

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed {
    typedIntParsed("Int", code, value, constant, next)
}

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed {
    (kind = "String", code = code, intValue = 0, textValue = value, constant = constant, next = next)
}

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed {
    (kind = "Bool", code = code, intValue = if value { 1 } else { 0 }, textValue = "", constant = constant, next = next)
}

/** Tries a constant integer operation without raising a compile-time runtime fault. */
tryFoldInteger := fn(operator: String, left: Int, right: Int): (value: Int, ok: Bool) {
    if operator == "+" { return integer.intAdd(left, right); }
    if operator == "-" { return integer.intSubtract(left, right); }
    if operator == "*" { return integer.intMultiply(left, right); }
    if operator == "/" { return integer.intDivide(left, right); }
    if operator == "%" { return integer.intRemainder(left, right); }
    if operator == ":/" { return integer.intFloorDivide(left, right); }
    integer.intFloorModulo(left, right)
}

/** Lowers a checked integer operation whose result is not a safe constant, preserving evaluation and fault timing. */
runtimeIntegerCode := fn(target: String, operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { return targetIntAddCode(target, left, right, position); }
    if operator == "-" { return targetIntSubtractCode(target, left, right, position); }
    if operator == "*" { return targetIntMultiplyCode(target, left, right, position); }
    if operator == "/" { return targetIntDivideCode(target, left, right, position); }
    if operator == "%" { return targetIntRemainderCode(target, left, right, position); }
    if operator == ":/" { return targetIntFloorDivideCode(target, left, right, position); }
    targetIntFloorModuloCode(target, left, right, position)
}

/** Lowers a checked integer operation at `kind`, adding a runtime range guard for narrow integer widths outside remainders. */
runtimeTypedIntegerCode := fn(target: String, kind: String, operator: String, left: String, right: String, position: Int): String {
    raw := runtimeIntegerCode(target, operator, left, right, position);
    if numeric.isNarrowIntKind(kind) and operator =!= "%" and operator =!= ":%" {
        return targetCheckedNarrowIntCode(target, kind, raw, position);
    }
    raw
}

/** Returns the index of the newest visible `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** True when `locals` already binds runtime identifier `runtime` in scope. */
localsUseRuntime := fn(locals: List<Local>, runtime: String): Bool {
    loop locals as local {
        if local.runtime == runtime { return true; }
    }
    false
}

/** Target runtime identifier for an imported module's top-level value, or a root value. */
moduleValueRuntime := fn(target: String, moduleKey: String, name: String): String {
    if moduleKey == "" { return "lite_" + name; }
    if target == "ts" { return "lite$m$" + moduleKey + "$" + name; }
    "lt_m_" + moduleKey + "__" + name
}

/** Target runtime identifier for a user-defined top-level function. */
moduleFunctionRuntime := fn(target: String, moduleKey: String, name: String): String {
    if moduleKey == "" {
        if target == "ts" { return "liteFn_" + name; }
        return "lt_fn__" + name;
    }
    if target == "ts" { return "liteFn$" + moduleKey + "$" + name; }
    "lt_fn_" + moduleKey + "__" + name
}

/** Allocates a collision-free compiler-internal temporary name scoped to `locals`. */
freshScopeTemp := fn(locals: List<Local>, prefix: String): String {
    if not localsUseRuntime(locals, prefix) { return prefix; }
    var suffix := 2;
    loop true {
        candidate := prefix + "$" + integer.intText(suffix);
        if not localsUseRuntime(locals, candidate) { return candidate; }
        suffix = suffix + 1;
    }
    prefix
}

/** Selects a target-safe runtime name for a binding, using `lite_<name>` when unshadowed and a scope-local shadow suffix when shadowed. */
localRuntimeName := fn(target: String, locals: List<Local>, name: String, moduleKey: String, depth: Int): String {
    if depth == 0 and moduleKey =!= "" {
        return moduleValueRuntime(target, moduleKey, name);
    }
    base := "lite_" + name;
    if not localsUseRuntime(locals, base) { return base; }
    var suffix := 2;
    loop true {
        candidate := if target == "ts" { "lite_" + name + "$" + integer.intText(suffix) }
            else { "lt_s" + integer.intText(suffix) + "_" + name };
        if not localsUseRuntime(locals, candidate) { return candidate; }
        suffix = suffix + 1;
    }
    base
}

/** True for the ten comparison spellings accepted by this checkpoint. */
isComparison := fn(operator: String): Bool {
    operator == "==" or operator == "=!=" or operator == "<" or operator == "<!" or
    operator == "<=" or operator == "<!=" or operator == ">" or operator == ">!" or
    operator == ">=" or operator == ">!="
}

/** Precedence level of a recognized binary operator; comparisons bind below arithmetic and logic binds below comparisons. */
operatorLevel := fn(operator: String): Int {
    if operator == "or" { 2 }
    else if operator == "and" { 3 }
    else if isComparison(operator) { 5 }
    else if operator == "+" or operator == "-" { 10 }
    else if operator == "*" or operator == "/" or operator == "%" or operator == ":/" or operator == ":%" { 20 }
    else if operator == "**" { 25 }
    else { 0 }
}

/** Reads an operator at `position`, preferring the longest spelling; returns empty text when none starts there. */
readOperator := fn(source: String, position: Int): Operator {
    ch := textLib.at(source, position);
    if ch == "*" {
        if textLib.startsWithAt(source, position, "**") { return (text = "**", width = 2); }
        return (text = "*", width = 1);
    }
    if textLib.startsWithAt(source, position, "=!=") { return (text = "=!=", width = 3); }
    if textLib.startsWithAt(source, position, "<!=") { return (text = "<!=", width = 3); }
    if textLib.startsWithAt(source, position, ">!=") { return (text = ">!=", width = 3); }
    if textLib.startsWithAt(source, position, "==") { return (text = "==", width = 2); }
    if textLib.startsWithAt(source, position, "<=") { return (text = "<=", width = 2); }
    if textLib.startsWithAt(source, position, ">=") { return (text = ">=", width = 2); }
    if textLib.startsWithAt(source, position, "<!") { return (text = "<!", width = 2); }
    if textLib.startsWithAt(source, position, ">!") { return (text = ">!", width = 2); }
    if ch == "<" { return (text = "<", width = 1); }
    if ch == ">" { return (text = ">", width = 1); }
    if ch == "+" or ch == "-" or ch == "/" or ch == "%" { return (text = ch, width = 1); }
    if textLib.startsWithAt(source, position, ":/") { return (text = ":/", width = 2); }
    if textLib.startsWithAt(source, position, ":%") { return (text = ":%", width = 2); }
    if textLib.isNameStart(ch) {
        after := textLib.skipName(source, position);
        word := textLib.slice(source, position, after);
        if word == "and" or word == "or" { return (text = word, width = after - position); }
    }
    (text = "", width = 0)
}

/** True when a parsed atom is followed by a binary operator belonging to this precedence-climbing invocation. */
binaryFollows := fn(source: String, next: Int, prefix: String, minimum: Int): Bool {
    cursor := skipTrivia(source, next, prefix);
    if cursor >= textLib.length(source) { return false; }
    operator := readOperator(source, cursor);
    operator.text =!= "" and operatorLevel(operator.text) >= minimum
}

/** Peeks only for a following comparison; the one-character filter avoids a full operator scan for ordinary delimiters and logic. */
comparisonOperatorAt := fn(source: String, position: Int): Operator {
    if position >= textLib.length(source) { return (text = "", width = 0); }
    ch := textLib.at(source, position);
    if ch == "=" or ch == "<" or ch == ">" { return readOperator(source, position); }
    (text = "", width = 0)
}

/** Folds one of the ten Int comparisons to a Bool. */
compareIntegers := fn(operator: String, left: Int, right: Int): Bool {
    if operator == "==" { left == right }
    else if operator == "=!=" { left =!= right }
    else if operator == "<" { left < right }
    else if operator == "<!" { left >= right }
    else if operator == "<=" { left <= right }
    else if operator == "<!=" { left > right }
    else if operator == ">" { left > right }
    else if operator == ">!" { left <= right }
    else if operator == ">=" { left >= right }
    else { left < right }
}

/** Folds String equality or inequality. */
compareTexts := fn(operator: String, left: String, right: String): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Folds Bool equality or inequality. */
compareBools := fn(operator: String, left: Bool, right: Bool): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
compareParsed := fn(target: String, source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed {
    if numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind) {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
        }
        return boolParsed(targetComparisonCode(target, operator, "Int", left.code, right.code), false, false, right.next);
    }
    if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
        codes: List<String> = [left.code, right.code];
        kinds: List<String> = [left.kind, right.kind];
        operators: List<String> = [operator];
        return boolParsed(targetComparisonChainCode(target, codes, kinds, operators, 1, at), false, false, right.next);
    }
    if left.kind =!= right.kind {
        failAt(source, at, prefix, "cannot compare " + displayKind(left.kind) + " and " + displayKind(right.kind));
    }
    if left.kind == "Never" {
        failAt(source, at, prefix, "cannot compare Never values");
    }
    if isTupleKind(left.kind) {
        failAt(source, at, prefix, "cannot compare tuple values");
    }
    if isListKind(left.kind) {
        failAt(source, at, prefix, "cannot compare list values");
    }
    if operator =!= "==" and operator =!= "=!=" {
        failAt(source, at, prefix, "operator " + operator + " requires Int operands");
    }
    if left.constant and right.constant {
        value := if left.kind == "String" {
            compareTexts(operator, left.textValue, right.textValue)
        } else {
            compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
        };
        return boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
    }
    boolParsed(targetComparisonCode(target, operator, left.kind, left.code, right.code), false, false, right.next)
}

/** Admits an integer literal into a narrow Int or exact Float/Float32 storage context only when not followed by a binary operator at `minimum`. */
contextualIntegerParsed := fn(target: String, source: String, position: Int, prefix: String, expected: String, minimum: Int, value: Int, code: String, next: Int): Parsed {
    if expected =!= "" and expected =!= "Int" and not binaryFollows(source, next, prefix, minimum) {
        if numeric.isNarrowIntKind(expected) {
            if not numeric.intKindFits(expected, value) {
                failAt(source, position, prefix, "integer literal outside " + expected + " range");
            }
            return typedIntParsed(expected, code, value, true, next);
        }
        if expected == "Float32" {
            if not numeric.intExactlyFloat32(value) {
                failAt(source, position, prefix, "integer literal is not exactly representable in Float32");
            }
            return (kind = "Float32", code = targetFloat32OperandCode(target, "Int", code), intValue = 0, textValue = "", constant = false, next = next);
        }
        if expected == "Float" {
            if not numeric.intExactlyFloat(value) {
                failAt(source, position, prefix, "integer literal is not exactly representable in Float");
            }
            return (kind = "Float", code = targetFloatOperandCode(target, "Int", code), intValue = 0, textValue = "", constant = false, next = next);
        }
    }
    intParsed(code, value, true, next)
}

/** Parses signed decimal numeric literals in one scan, applying contextual narrow/Float width checks when the atom completes the expression. */
parseNumber := fn(target: String, source: String, position: Int, prefix: String, expected: String, minimum: Int): Parsed {
    var cursor := position;
    var negative := false;
    ch := textLib.at(source, cursor);
    if ch == "+" or ch == "-" {
        negative = ch == "-";
        cursor = skipTrivia(source, cursor + 1, prefix);
    }
    start := cursor;
    afterDigit := cursor + 1;
    following := if afterDigit < textLib.length(source) { textLib.at(source, afterDigit) } else { "" };
    if textLib.isDigit(textLib.at(source, cursor)) and not textLib.isDigit(following) and following =!= "." and following =!= "e" and following =!= "E" {
        /* A lone decimal digit is always small: skip the general scanner record on this hot path. */
        digit := textLib.digitValue(textLib.at(source, cursor));
        value := if negative { -digit } else { digit };
        code := targetIntLiteralCode(target, value, negative, textLib.slice(source, cursor, afterDigit));
        return contextualIntegerParsed(target, source, position, prefix, expected, minimum, value, code, afterDigit);
    }
    scanned := numeric.scanNumericLiteral(source, cursor);
    cursor = scanned.next;
    integerEnd := scanned.integerEnd;
    if start == integerEnd { failAt(source, position, prefix, "expected a decimal numeric literal"); }
    if scanned.exponentMissingAt >= 0 { failAt(source, scanned.exponentMissingAt, prefix, "expected exponent digits"); }
    var digitStart := start;
    loop digitStart + 1 < integerEnd and textLib.at(source, digitStart) == "0" { digitStart = digitStart + 1; }
    if scanned.floating {
        digits := textLib.slice(source, start, integerEnd) + textLib.slice(source, scanned.fractionStart, scanned.fractionEnd);
        fractionCount := scanned.fractionEnd - scanned.fractionStart;
        raw := textLib.slice(source, digitStart, cursor);
        if expected == "Float32" and not binaryFollows(source, cursor, prefix, minimum) {
            if not numeric.finiteFloat32Digits(digits, fractionCount, scanned.exponent) {
                failAt(source, position, prefix, "floating literal outside Float32 range");
            }
            return (kind = "Float32", code = targetFloat32LiteralCode(target, raw, negative), intValue = 0, textValue = "", constant = false, next = cursor);
        }
        if not numeric.finiteFloatDigits(digits, fractionCount, scanned.exponent) {
            failAt(source, position, prefix, "floating literal is not finite");
        }
        code := targetFloatLiteralCode(target, raw, negative);
        return (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = cursor);
    }
    if scanned.outsideInt or (not negative and scanned.magnitude == -9223372036854775808) {
        if numeric.isNarrowIntKind(expected) and not binaryFollows(source, cursor, prefix, minimum) {
            failAt(source, position, prefix, "integer literal outside " + expected + " range");
        }
        failAt(source, position, prefix, "integer literal outside signed 64-bit range");
    }
    value := if negative { scanned.magnitude } else { 0 - scanned.magnitude };
    code := targetIntLiteralCode(target, value, negative, textLib.slice(source, digitStart, cursor));
    contextualIntegerParsed(target, source, position, prefix, expected, minimum, value, code, cursor)
}

/** Joins adjacent double-quoted literal tokens across trivia in one scan and encodes the complete value once. Escapes and malformed later tokens retain their own source positions. */
parseText := fn(target: String, source: String, position: Int, prefix: String): Parsed {
    var literalStart := position;
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= textLib.length(source) {
            failAt(source, literalStart, prefix, "unterminated string literal");
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            next := skipTrivia(source, cursor, prefix);
            if next < textLib.length(source) and textLib.at(source, next) == "\"" {
                literalStart = next;
                cursor = next + 1;
                continue;
            }
            break;
        }
        if ch == "\\" {
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= textLib.length(source) {
                failAt(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := textLib.at(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                failAt(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    textParsed(targetTextLiteralCode(target, value), value, true, cursor)
}

/** Returns the position after one string literal, or the source end when it does not close; alias collection leaves lexical diagnostics to the main pass. */
pub skipAliasString := fn(source: String, position: Int): Int {
    size := textLib.length(source);
    var cursor := position + 1;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\\" {
            cursor = cursor + 2;
        } else if ch == "\"" {
            return cursor + 1;
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String {
    if textLib.indexOfText(code, "lite", 0) < 0 and textLib.indexOfText(code, "lt_", 0) < 0 and
        textLib.indexOfText(code, "finally", 0) < 0 { return existing; }
    size := textLib.length(code);
    var calls := existing;
    var cursor := 0;
    loop cursor < size {
        ch := textLib.at(code, cursor);
        if ch == "\"" {
            cursor = skipAliasString(code, cursor);
        } else if textLib.isNameStart(ch) {
            start := cursor;
            cursor = textLib.skipName(code, cursor);
            loop cursor < size and textLib.at(code, cursor) == "$" {
                cursor = textLib.skipName(code, cursor + 1);
            }
            if ch == "l" or ch == "f" {
                name := textLib.slice(code, start, cursor);
                if cursor < size and textLib.at(code, cursor) == "(" {
                    if (textLib.startsWithAt(name, 0, "lite$") and not textLib.startsWithAt(name, 0, "lite$m$")) or
                        textLib.startsWithAt(name, 0, "lite_") or
                        (textLib.startsWithAt(name, 0, "lt_") and not textLib.startsWithAt(name, 0, "lt_fn_") and
                            not textLib.startsWithAt(name, 0, "lt_m_") and not textLib.startsWithAt(name, 0, "lt_s")) {
                        token := name + "(|";
                        if textLib.indexOfText(calls, "|" + token, 0) < 0 { calls = calls + token; }
                    }
                } else if name == "finally" {
                    var afterFin := cursor;
                    loop afterFin < size and (textLib.at(code, afterFin) == " " or textLib.at(code, afterFin) == "\t" or textLib.at(code, afterFin) == "\n") {
                        afterFin = afterFin + 1;
                    }
                    if afterFin < size and textLib.at(code, afterFin) == "{" {
                        if textLib.indexOfText(calls, "|lite$finally(|", 0) < 0 { calls = calls + "lite$finally(|"; }
                    }
                }
            }
        } else { cursor = cursor + 1; }
    }
    calls
}

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCalls := fn(items: Items): String {
    var calls := "|";
    loop items as item { calls = targetCodeCalls(item.code, calls); }
    calls
}

/** Reads one raw alias target type from `position`, capturing a parenthesized tuple type or a generic `List<...>` application through its matching close, or a single name. */
collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start < size and textLib.at(source, start) == "(" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "(" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textLib.slice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textLib.slice(source, start, size), next = size)
    } else if start < size and textLib.at(source, start) == "[" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textLib.at(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "[" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "]" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textLib.slice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textLib.slice(source, start, size), next = size)
    } else {
        parsedName := typeNameAt(source, start, prefix);
        after := parsedName.next;
        afterName := skipTrivia(source, after, prefix);
        if afterName < size and textLib.at(source, afterName) == "<" {
            var cursor := afterName;
            var depth := 0;
            loop cursor < size {
                ch := textLib.at(source, cursor);
                if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
                    cursor = skipComment(source, cursor, prefix);
                } else if ch == "<" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ">" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        return (text = textLib.slice(source, start, cursor), next = cursor);
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            (text = textLib.slice(source, start, size), next = size)
        } else {
            (text = textLib.slice(source, start, after), next = after)
        }
    }
}

/** Collects top-level `Name := type Target;` declarations before parsing so aliases may reference later aliases and cycles can be reported. */
collectAliases := fn(source: String, prefix: String): List<AliasDecl> {
    aliases: mut List<AliasDecl> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.isNameStart(ch) {
            nameStart := position;
            afterName := textLib.skipName(source, position);
            name := textLib.slice(source, nameStart, afterName);
            aliasPosition := skipTrivia(source, afterName, prefix);
            if textLib.startsWithAt(source, aliasPosition, ":=") {
                typePosition := skipTrivia(source, aliasPosition + 2, prefix);
                if textLib.wordAt(source, typePosition, "type") {
                    targetStart := skipTrivia(source, typePosition + 4, prefix);
                    target := collectTypeTarget(source, targetStart, prefix);
                    listLib.pushBack(mut aliases, (name = name, target = target.text, at = nameStart, end = target.next));
                    position = target.next;
                    continue;
                }
            }
            position = afterName;
        } else {
            position = position + 1;
        }
    }
    aliases
}

/** True for the single assignment/field equals token, excluding both equality and inequality operators. */
isSingleEquals := fn(source: String, position: Int): Bool {
    textLib.startsWithAt(source, position, "=") and not textLib.startsWithAt(source, position, "==") and not textLib.startsWithAt(source, position, "=!=")
}

/** True when the text after an opening `(` is a tuple literal (`label = ...`, `=name`, or contains a top-level `,`), rather than grouping. */
looksLikeTupleEntry := fn(source: String, position: Int, prefix: String): Bool {
    size := textLib.length(source);
    start := skipTrivia(source, position, prefix);
    if start >= size { return false; }
    if isSingleEquals(source, start) { return true; }
    if textLib.isNameStart(textLib.at(source, start)) {
        afterName := skipTrivia(source, textLib.skipName(source, start), prefix);
        if isSingleEquals(source, afterName) { return true; }
    }
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 { return false; }
            depth = depth - 1;
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** Wraps target code in the backend's list-copy hook when `kind` is a List; `Never` and other kinds are unchanged. */
copiedValueCode := fn(target: String, kind: String, code: String): String {
    if kind == "Never" { code }
    else if isListKind(kind) or isArrayKind(kind) { targetListCopyCode(target, code) }
    else { code }
}

/** Converts compatible tuples or widening integer-to-float values on assignment/call/return, or copies lists when needed; `Never` passes through unchanged. */
assignValueCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    if actualKind == "Never" {
        actualCode
    } else if expectedKind == "Float32" and numeric.isIntKind(actualKind) {
        targetFloat32OperandCode(target, actualKind, actualCode)
    } else if expectedKind == "Float" and numeric.isIntKind(actualKind) {
        targetFloatOperandCode(target, actualKind, actualCode)
    } else if expectedKind =!= actualKind and tupleShapeMatches(expectedKind, actualKind) {
        convertTupleValue(expectedKind, actualKind, actualCode)
    } else {
        copiedValueCode(target, expectedKind, actualCode)
    }
}

/** Rejects declarations inferred as non-storable `Unit` or `Never`. */
rejectNonValueBinding := fn(source: String, at: Int, prefix: String, kind: String, name: String): Unit {
    if kind == "Unit" or kind == "Never" {
        failAt(source, at, prefix, "cannot declare a " + displayKind(kind) + " local " + name);
    }
}

/** Chooses the emitted statement item kind, ensuring diverging items terminate non-Unit functions/main for strict TS control flow. */
expressionStatementKind := fn(valueKind: String, returned: Bool, defaultKind: String, currentResult: String): String {
    if valueKind == "Never" {
        if currentResult =!= "Unit" { "Return" } else { "Call" }
    } else if returned {
        "Return"
    } else {
        defaultKind
    }
}

/** Closes a call after at least one parsed argument, consuming at most one trailing comma and its trivia. */
expectNonemptyCallClose := fn(source: String, position: Int, prefix: String): Int {
    var cursor := skipTrivia(source, position, prefix);
    if cursor < textLib.length(source) and textLib.at(source, cursor) == "," { cursor = skipTrivia(source, cursor + 1, prefix); }
    expectSymbol(source, cursor, ")", prefix)
}

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := skipTrivia(source, open + 1, prefix);
    if not textLib.wordAt(source, cursor, "mut") {
        failAt(source, cursor, prefix, operation + " requires mut list argument");
    }
    cursor = skipTrivia(source, cursor + 3, prefix);
    if cursor >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, cursor)) {
        failAt(source, cursor, prefix, "expected a list name after mut");
    }
    nameEnd := textLib.skipName(source, cursor);
    listName := textLib.slice(source, cursor, nameEnd);
    index := localIndex(locals, listName);
    if index < 0 {
        failAt(source, cursor, prefix, "unknown value " + listName);
        return (runtime = "", kind = "", next = nameEnd);
    }
    entry := locals[index];
    if not isListKind(entry.kind) {
        failAt(source, cursor, prefix, operation + " requires a List value, got " + displayKind(entry.kind));
    }
    if not entry.writable {
        failAt(source, cursor, prefix, "cannot mutate list " + listName + " without mut");
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
}

/** Finds the end of a grouped atom without interpreting its values; strings and comments cannot close the group. */
scanParenEnd := fn(source: String, open: Int, prefix: String): Int {
    var cursor := open;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if ch == "(" { depth = depth + 1; cursor = cursor + 1; }
        else if ch == ")" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else { cursor = cursor + 1; }
    }
    -1
}

/** Builds the zero value for one flat tuple kind as a fresh object literal. */
tupleZeroParsed := fn(kind: String, next: Int): Parsed {
    count := tupleComponentCount(kind);
    var code := "{ ";
    var index := 0;
    loop index < count {
        comp := tupleComponent(kind, index);
        if index > 0 { code = code + ", "; }
        code = code + tupleObjectKey(comp.label, index) + ": ";
        if numeric.isIntKind(comp.kind) { code = code + "0n"; }
        else if numeric.isFloatKind(comp.kind) { code = code + "0"; }
        else if comp.kind == "String" { code = code + "\"\""; }
        else { code = code + "false"; }
        index = index + 1;
    }
    (kind = kind, code = code + " }", intValue = 0, textValue = "", constant = false, next = next)
}

/** Returns the end position of a standalone `0` initializer literal (followed by `;`, `}`, or EOF), or -1 otherwise. */
isZeroInitLiteral := fn(source: String, position: Int, prefix: String): Int {
    start := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if start >= size or textLib.at(source, start) =!= "0" { return -1; }
    if start + 1 < size and (textLib.isDigit(textLib.at(source, start + 1)) or textLib.isNameStart(textLib.at(source, start + 1)) or textLib.at(source, start + 1) == ".") {
        return -1;
    }
    after := skipTrivia(source, start + 1, prefix);
    if after >= size or textLib.at(source, after) == ";" or textLib.at(source, after) == "}" {
        return start + 1;
    }
    -1
}

/** Returns the position after `?` when `position` starts a reserved-storage marker, or -1 otherwise. */
isReservedInitMarker := fn(source: String, position: Int, prefix: String): Int {
    start := skipTrivia(source, position, prefix);
    if start < textLib.length(source) and textLib.at(source, start) == "?" {
        return start + 1;
    }
    -1
}

/** Recognizes one compound assignment operator at `position`, returning empty fields when absent. */
compoundAssignOp := fn(source: String, position: Int): (op: String, baseOp: String, width: Int) {
    if textLib.startsWithAt(source, position, ":/=") { return (op = ":/=", baseOp = ":/", width = 3); }
    if textLib.startsWithAt(source, position, ":%=") { return (op = ":%=", baseOp = ":%", width = 3); }
    if textLib.startsWithAt(source, position, "+=") { return (op = "+=", baseOp = "+", width = 2); }
    if textLib.startsWithAt(source, position, "-=") { return (op = "-=", baseOp = "-", width = 2); }
    if textLib.startsWithAt(source, position, "*=") { return (op = "*=", baseOp = "*", width = 2); }
    if textLib.startsWithAt(source, position, "/=") { return (op = "/=", baseOp = "/", width = 2); }
    if textLib.startsWithAt(source, position, "%=") { return (op = "%=", baseOp = "%", width = 2); }
    (op = "", baseOp = "", width = 0)
}

/** Lowers a compound assignment RHS computation for Int*, Float*, or String (`+=`). */
compoundAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entryKind: String, lhsCode: String, baseOp: String, rhs: Parsed): String {
    if numeric.isIntKind(entryKind) and numeric.isIntKind(rhs.kind) and numeric.numericWidens(entryKind, rhs.kind) {
        return runtimeTypedIntegerCode(target, entryKind, baseOp, lhsCode, rhs.code, opPos);
    }
    if entryKind == "String" and rhs.kind == "String" and baseOp == "+" {
        return targetConcatCode(target, lhsCode, rhs.code);
    }
    if entryKind == "Float32" and (numeric.isIntKind(rhs.kind) or rhs.kind == "Float32") and
        (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return targetFloat32BinaryCode(target, baseOp, lhsCode, targetFloat32OperandCode(target, rhs.kind, rhs.code), opPos);
    }
    if entryKind == "Float" and numeric.isNumericKind(rhs.kind) and
        (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return targetFloatBinaryCode(target, baseOp, lhsCode, targetFloatOperandCode(target, rhs.kind, rhs.code), opPos);
    }
    failAt(source, opPos, prefix, "cannot apply " + baseOp + "= to " + displayKind(entryKind) + " and " + displayKind(rhs.kind));
    ""
}

/** Counts entries in `locals`. */
localsCount := fn(locals: List<Local>): Int {
    var count := 0;
    loop locals { count += 1; }
    count
}

/** Returns the prefix of `locals` up to `targetLen` entries. */
truncateLocals := fn(locals: List<Local>, targetLen: Int): List<Local> {
    kept: mut List<Local> = [];
    var idx := 0;
    loop locals as local {
        if idx < targetLen { listLib.pushBack(mut kept, local); }
        idx = idx + 1;
    }
    kept
}

/** Returns outer-local initialization updates from `locals[preLen..)` appended to `updates` for `branchDepth`. */
recordBranchUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int, branchDepth: Int, updates: List<BranchUpdate>): List<BranchUpdate> {
    nextUpdates: mut List<BranchUpdate> = [];
    loop updates as existing { listLib.pushBack(mut nextUpdates, existing); }
    var idx := 0;
    branchRuntimes: mut List<String> = [];
    branchStates: mut List<String> = [];
    loop locals as local {
        if idx >= preLen and local.depth <= maxDepth {
            listLib.pushBack(mut branchRuntimes, local.runtime);
            listLib.pushBack(mut branchStates, local.initState);
        }
        idx = idx + 1;
    }
    emitted: mut List<String> = [];
    var rev := 0;
    loop branchRuntimes { rev += 1; }
    loop rev > 0 {
        rev = rev - 1;
        rt := branchRuntimes[rev];
        if not listLib.listContainsText(emitted, rt) {
            listLib.pushBack(mut emitted, rt);
            listLib.pushBack(mut nextUpdates, (depth = branchDepth, runtime = rt, initState = branchStates[rev]));
        }
    }
    nextUpdates
}

/** Joins `branchUpdates` for `blockDepth` into `locals`, returning updated `locals`. */
joinBranchLocals := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>): List<Local> {
    here: mut List<BranchUpdate> = [];
    loop updates as u {
        if u.depth == blockDepth { listLib.pushBack(mut here, u); }
    }
    nextLocals: mut List<Local> = [];
    loop locals as l { listLib.pushBack(mut nextLocals, l); }
    if hasElse and liveBranchCount == 0 { return nextLocals; }
    seenRuntimes: mut List<String> = [];
    loop here as u {
        if not listLib.listContainsText(seenRuntimes, u.runtime) {
            listLib.pushBack(mut seenRuntimes, u.runtime);
        }
    }
    loop seenRuntimes as rt {
        var preEntryIdx := -1;
        var i := 0;
        loop locals as l {
            if i < preLen and l.runtime == rt { preEntryIdx = i; }
            i = i + 1;
        }
        if preEntryIdx >= 0 {
            pre := locals[preEntryIdx];
            if pre.initState =!= "init" {
                var joined := "maybe";
                if hasElse {
                    var initCount := 0;
                    loop here as u {
                        if u.runtime == rt and u.initState == "init" { initCount = initCount + 1; }
                    }
                    if initCount == liveBranchCount { joined = "init"; }
                }
                listLib.pushBack(mut nextLocals, (name = pre.name, runtime = pre.runtime, kind = pre.kind,
                    mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                    code = pre.code, intValue = 0, textValue = "", initState = joined));
            }
        }
    }
    nextLocals
}

/** Removes `branchUpdates` entries at `blockDepth`. */
popBranchUpdates := fn(updates: List<BranchUpdate>, blockDepth: Int): List<BranchUpdate> {
    kept: mut List<BranchUpdate> = [];
    loop updates as u {
        if u.depth =!= blockDepth { listLib.pushBack(mut kept, u); }
    }
    kept
}

/** Transitions any outer uninit locals modified inside a loop to `maybe` after the loop. */
joinLoopUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int): List<Local> {
    updatedRuntimes: mut List<String> = [];
    var idx := 0;
    loop locals as l {
        if idx >= preLen and l.depth <= maxDepth {
            if not listLib.listContainsText(updatedRuntimes, l.runtime) {
                listLib.pushBack(mut updatedRuntimes, l.runtime);
            }
        }
        idx = idx + 1;
    }
    nextLocals: mut List<Local> = [];
    var k := 0;
    loop locals as l {
        if k < preLen { listLib.pushBack(mut nextLocals, l); }
        k = k + 1;
    }
    loop updatedRuntimes as rt {
        var preIdx := -1;
        var i := 0;
        loop nextLocals as l {
            if l.runtime == rt { preIdx = i; }
            i = i + 1;
        }
        if preIdx >= 0 {
            pre := nextLocals[preIdx];
            if pre.initState == "uninit" {
                listLib.pushBack(mut nextLocals, (name = pre.name, runtime = pre.runtime, kind = pre.kind,
                    mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                    code = pre.code, intValue = 0, textValue = "", initState = "maybe"));
            }
        }
    }
    nextLocals
}

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object, fixed array and an empty list. */
zeroParsed := fn(target: String, kind: String, next: Int): Parsed {
    if isTupleKind(kind) { tupleZeroParsed(kind, next) }
    else if isListKind(kind) { (kind = kind, code = "[]", intValue = 0, textValue = "", constant = false, next = next) }
    else if isArrayKind(kind) {
        elemKind := arrayElementKind(kind);
        extent := arrayExtent(kind);
        elemZero := self(target, elemKind, next).code;
        items: mut List<String> = [];
        var i := 0;
        loop i < extent {
            listLib.pushBack(mut items, elemZero);
            i = i + 1;
        }
        (kind = kind, code = "[" + textLib.joinTexts(items, ", ") + "]", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if numeric.isIntKind(kind) { typedIntParsed(kind, targetIntLiteralCode(target, 0, false, "0"), 0, true, next) }
    else if numeric.isFloatKind(kind) { (kind = kind, code = "0", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == "String" { textParsed(targetTextLiteralCode(target, ""), "", true, next) }
    else if kind == "Unit" { (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next) }
    else { boolParsed(targetBoolLiteralCode(target, false), false, true, next) }
}

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) {
    start := skipTrivia(source, position, prefix);
    var cursor := start;
    var writable := false;
    if textLib.wordAt(source, cursor, "mut") {
        writable = true;
        cursor = skipTrivia(source, cursor + 3, prefix);
    }
    typed := parseTypeAt(source, cursor, prefix, aliases, "local", "");
    if typed.kind == "Unit" {
        name := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        failAt(source, cursor, prefix, "unsupported local type " + name);
    }
    if writable and not isListKind(typed.kind) {
        failAt(source, start, prefix, "mut requires a List type, got " + displayKind(typed.kind));
    }
    (kind = typed.kind, writable = writable, next = typed.next)
}

/** Skips empty item separators without changing the final ordinary item's result. */
skipItemSeparators := fn(source: String, position: Int, prefix: String): Int {
    var next := skipTrivia(source, position, prefix);
    loop next < textLib.length(source) and textLib.at(source, next) == ";" {
        next = skipTrivia(source, next + 1, prefix);
    }
    next
}

/** Returns a copy of `values` with element `index` replaced by `value`. */
setIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> {
    updated: mut List<Int> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut updated, if i == index { value } else { item });
        i = i + 1;
    }
    updated
}

/** Returns a copy of `values` with element `index` replaced by `value`. */
setBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> {
    updated: mut List<Bool> = [];
    var i := 0;
    loop values as item {
        listLib.pushBack(mut updated, if i == index { value } else { item });
        i = i + 1;
    }
    updated
}

/** Returns the 0-based parameter slot index matching `label` in `[first, first + count)`, or -1 when absent. */
findParamSlot := fn(params: List<String>, first: Int, count: Int, label: String): Int {
    var i := 0;
    loop i < count {
        if paramNameOf(params[first + i]) == label { return i; }
        i = i + 1;
    }
    -1
}

/** Scans from `position` to the next top-level `,` or `)` at paren/bracket/brace depth 0. */
skipBalancedArgument := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := position;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" {
            if depth == 0 { return cursor; }
            depth = depth - 1;
            cursor = cursor + 1;
        } else if ch == "]" or ch == "}" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "," and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    cursor
}

/** Collects explicit `name = ...` and `=name` parameter labels present in a call argument list starting at `openParen`. */
collectExplicitCallLabels := fn(source: String, openParen: Int, prefix: String): List<String> {
    labels: mut List<String> = [];
    size := textLib.length(source);
    var cursor := skipTrivia(source, openParen + 1, prefix);
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if isSingleEquals(source, cursor) {
            nameStart := skipTrivia(source, cursor + 1, prefix);
            if nameStart < size and textLib.isNameStart(textLib.at(source, nameStart)) {
                nameEnd := textLib.skipName(source, nameStart);
                listLib.pushBack(mut labels, textLib.slice(source, nameStart, nameEnd));
            }
        } else if textLib.isNameStart(textLib.at(source, cursor)) {
            nameEnd := textLib.skipName(source, cursor);
            afterName := skipTrivia(source, nameEnd, prefix);
            if isSingleEquals(source, afterName) {
                listLib.pushBack(mut labels, textLib.slice(source, cursor, nameEnd));
            }
        }
        cursor = skipBalancedArgument(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == ")" { break; }
        } else {
            break;
        }
    }
    labels
}

/** Parses `()`, `(name)` or `(name1, name2, ...)` for tuple destructuring declarations, allowing empty or nested-scope rebinding. */
parseTupleDestructureTarget := fn(source: String, open: Int, prefix: String): (namesText: String, count: Int, grouped: Bool, next: Int) {
    size := textLib.length(source);
    var cursor := skipTrivia(source, open + 1, prefix);
    names: mut List<String> = [];
    var count := 0;
    var hadComma := false;
    loop cursor < size and textLib.at(source, cursor) =!= ")" {
        if not textLib.isNameStart(textLib.at(source, cursor)) {
            failAt(source, cursor, prefix, "expected a binding name in tuple destructuring");
        }
        nameStart := cursor;
        cursor = textLib.skipName(source, cursor);
        bindName := textLib.slice(source, nameStart, cursor);
        if isReservedWord(bindName) { unsupportedFeature(source, nameStart, bindName, prefix); }
        listLib.pushBack(mut names, bindName);
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textLib.at(source, cursor) == "," {
            hadComma = true;
            cursor = skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    next := expectSymbol(source, cursor, ")", prefix);
    (namesText = textLib.joinTexts(names, ","), count = count, grouped = count == 1 and not hadComma, next = next)
}

/** Returns the position of the `{` that opens the branch after the condition starting at `start`, or -1 when absent. */
scanConditionOpen := fn(source: String, start: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "{" and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** Locates an ordinary item's separator or enclosing close for contextual tail typing, without interpreting values. */
scanExpressionItemEnd := fn(source: String, start: Int, prefix: String): Int {
    var cursor := start;
    var depth := 0;
    size := textLib.length(source);
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" { cursor = skipAliasString(source, cursor); }
        else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") { cursor = skipComment(source, cursor, prefix); }
        else if depth == 0 and (ch == ";" or ch == "}") { return cursor; }
        else {
            if ch == "(" or ch == "[" or ch == "{" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == "}" and depth == 1 {
                depth = 0;
                cursor = cursor + 1;
                afterClose := skipTrivia(source, cursor, prefix);
                if afterClose >= size or (not textLib.wordAt(source, afterClose, "else") and
                    not textLib.wordAt(source, afterClose, "then") and
                    not textLib.wordAt(source, afterClose, "finally")) {
                    return cursor;
                }
            } else if ch == ")" or ch == "]" or ch == "}" {
                if depth > 0 { depth = depth - 1; }
                cursor = cursor + 1;
            } else {
                cursor = cursor + 1;
            }
        }
    }
    cursor
}

/** Extracts the loop context id encoded in a Pass 1 `"__loopVal:<id>"` placeholder kind, or returns -1. */
loopValMarkerId := fn(kind: String): Int {
    if not textLib.startsWithAt(kind, 0, "__loopVal:") { return -1; }
    suffix := textLib.slice(kind, 10, textLib.length(kind));
    if suffix == "" { return -1; }
    var value := 0;
    var index := 0;
    loop index < textLib.length(suffix) {
        ch := textLib.at(suffix, index);
        if not textLib.isDigit(ch) { return -1; }
        value = value * 10 + decimalDigit(ch);
        index = index + 1;
    }
    value
}

/** Unifies two conditional branch kinds when one is `Never`, both match, one is a Pass 1 loop `.value` placeholder, or one losslessly widens to the other. */
joinBranchKind := fn(current: String, nextKind: String): String {
    if current == "" or current == "Never" { return nextKind; }
    if nextKind == "Never" or nextKind == current { return current; }
    if loopValMarkerId(current) >= 0 { return nextKind; }
    if loopValMarkerId(nextKind) >= 0 { return current; }
    if numeric.numericWidens(current, nextKind) { return current; }
    if numeric.numericWidens(nextKind, current) { return nextKind; }
    ""
}

/** Builds a nested conditional expression while converting any branch that widens to `resultKind`. */
ternaryChainCode := fn(target: String, resultKind: String, conditionCodes: List<String>, branchCodes: List<String>, branchKinds: List<String>, branchCount: Int): String {
    var code := assignValueCode(target, resultKind, branchKinds[branchCount - 1], branchCodes[branchCount - 1]);
    var index := branchCount - 2;
    loop index >= 0 {
        branchCode := assignValueCode(target, resultKind, branchKinds[index], branchCodes[index]);
        code = "(Boolean(" + conditionCodes[index] + ") ? " + branchCode + " : " + code + ")";
        index = index - 1;
    }
    code
}

/** Formats one conditional branch statement for a lowered IIFE conditional (`if`, `else if`, `else`, or `match` arm). */
condBranchStmtCode := fn(target: String, valKind: String, valVar: String, branchKind: String, branchCode: String): String {
    if valKind == "Never" {
        "return (" + branchCode + ");"
    } else if branchKind == "Never" {
        "(" + branchCode + ");"
    } else if valKind == "Unit" {
        if branchCode == targetUnitLiteralCode(target) { "" } else { "void (" + branchCode + ");" }
    } else {
        valVar + " = " + assignValueCode(target, valKind, branchKind, branchCode) + ";"
    }
}

/** Returns the number of entries in `ctxs`. */
ctxCount := fn(ctxs: List<ConstructCtx>): Int {
    var count := 0;
    loop ctxs { count += 1; }
    count
}

/** Returns a copy of `ctxs` with `entry` appended at the end. */
appendCtx := fn(ctxs: List<ConstructCtx>, entry: ConstructCtx): List<ConstructCtx> {
    copy: mut List<ConstructCtx> = [];
    loop ctxs as existing { listLib.pushBack(mut copy, existing); }
    listLib.pushBack(mut copy, entry);
    copy
}

/** Returns one fresh positive construct identifier higher than any active id in `ctxs`. */
nextCtxId := fn(ctxs: List<ConstructCtx>): Int {
    var highest := 0;
    loop ctxs as existing {
        if existing.id > highest { highest = existing.id; }
    }
    highest + 1
}

/** Finds the innermost context in `ctxs` matching `tag`, or -1 when absent. */
findTaggedCtxIndex := fn(ctxs: List<ConstructCtx>, tag: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].tag == tag { return index; }
        index = index - 1;
    }
    -1
}

/** Finds the innermost context in `ctxs` matching `kind`, or -1 when absent. */
findCtxByKindIndex := fn(ctxs: List<ConstructCtx>, kind: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].kind == kind { return index; }
        index = index - 1;
    }
    -1
}

/** Returns the entries of `locals` declared below `depth`, preserving order, so current-block bindings are dropped even when an outer assignment was recorded after them. */
visibleLocals := fn(locals: List<Local>, depth: Int): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if entry.depth < depth {
            listLib.pushBack(mut kept, entry);
        }
    }
    kept
}

/** Joins a block's definite completion: scopes preserve it, loops require a true header, and conditionals require every arm plus a final else. */
blockCompletion := fn(kind: String, completed: Bool, branchesComplete: Bool, hasElse: Bool, loopForever: Bool): Bool {
    if kind == "scope" or kind == "matchsingle" or kind == "matchsingleval" { completed }
    else if kind == "loop" { loopForever and completed }
    else { hasElse and branchesComplete and completed }
}

/** True when emitted target code contains a raw `lite$throwTransfer(` substring worth quote-aware inspection. */
codeHasRawTransfer := fn(code: String): Bool {
    code =!= "" and textLib.indexOfText(code, "lite$throwTransfer(", 0) >= 0
}

/** Parses one `@tag` token starting at `atPos`. */
parseTagAt := fn(source: String, atPos: Int, prefix: String): (tag: String, next: Int, at: Int) {
    size := textLib.length(source);
    nameStart := atPos + 1;
    if nameStart >= size or not textLib.isNameStart(textLib.at(source, nameStart)) {
        failAt(source, atPos, prefix, "expected tag name after @");
    }
    nameEnd := textLib.skipName(source, nameStart);
    tag := textLib.slice(source, nameStart, nameEnd);
    if isReservedWord(tag) {
        failAt(source, nameStart, prefix, "tag name cannot be reserved word " + tag);
    }
    (tag = tag, next = nameEnd, at = atPos)
}

/** Rejects a block `@tag` where a construct header, else/then/finally clause or opening brace cannot accept one. */
rejectMisplacedTag := fn(source: String, position: Int, prefix: String, message: String): Unit {
    pos := skipTrivia(source, position, prefix);
    if pos < textLib.length(source) and textLib.at(source, pos) == "@" {
        failAt(source, pos, prefix, message);
    }
}

/** Rejects an unparenthesized `@tag { ... }` at the start of a header condition while preserving `@tag.field` metadata reads. */
rejectHeaderBlockTag := fn(source: String, position: Int, prefix: String, constructName: String): Unit {
    pos := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if pos < size and textLib.at(source, pos) == "@" {
        parsed := parseTagAt(source, pos, prefix);
        afterTag := skipTrivia(source, parsed.next, prefix);
        if afterTag >= size or textLib.at(source, afterTag) =!= "." {
            failAt(source, pos, prefix, "unexpected block tag @" + parsed.tag + " in " + constructName + " header");
        }
    }
}

/** True when `parsed` encodes Pass 1 exit markers in `textValue`. */
hasMarkerPrefix := fn(parsed: Parsed): Bool {
    not parsed.constant and textLib.startsWithAt(parsed.textValue, 0, "__m:")
}

/** Appends Pass 1 exit markers encoded on `parsed` onto `current`. */
collectParsedMarkers := fn(current: String, parsed: Parsed): String {
    if hasMarkerPrefix(parsed) {
        return current + textLib.slice(parsed.textValue, 4, textLib.length(parsed.textValue));
    }
    current
}

/** Encodes raw marker lines for `Parsed.textValue`, or returns empty when none exist. */
wrapMarkers := fn(raw: String): String {
    if raw == "" { "" } else { "__m:" + raw }
}

/** Attaches raw Pass 1 exit markers onto `parsed` when non-empty. */
withMarkers := fn(parsed: Parsed, raw: String): Parsed {
    if raw == "" { return parsed; }
    (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
        textValue = "__m:" + raw, constant = false, next = parsed.next)
}

/** Retains all marker lines in `raw` whose target id is not `excludeId`. */
filterOtherMarkers := fn(raw: String, excludeId: Int): String {
    excludeKey := integer.intText(excludeId);
    size := textLib.length(raw);
    var cursor := 0;
    var kept := "";
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        if entryId =!= excludeKey {
            kept = kept + textLib.slice(raw, cursor, endPos) + "\n";
        }
        cursor = endPos + 1;
    }
    kept
}

/** Unifies all inferred exit kinds recorded for `targetId` in `raw` markers, failing on incompatible exit types. */
inferKindFromMarkers := fn(raw: String, targetId: Int, targetTag: String, source: String, at: Int, prefix: String, blockStopped: Bool): String {
    idKey := integer.intText(targetId);
    size := textLib.length(raw);
    var cursor := 0;
    var result := "";
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            if result == "" {
                result = entryKind;
            } else {
                joined := joinBranchKind(result, entryKind);
                if joined == "" {
                    failAt(source, at, prefix, "block @" + targetTag + " cannot return both " +
                        displayKind(result) + " and " + displayKind(entryKind));
                }
                result = joined;
            }
        }
        cursor = endPos + 1;
    }
    if result == "" {
        if blockStopped { "Never" } else { "Unit" }
    } else {
        result
    }
}

/** Returns true when a call argument list reorders or mismatches slots relative to the callee's declaration order. */
callReordersArgs := fn(source: String, openParen: Int, prefix: String, params: List<String>, firstParam: Int, paramCount: Int): Bool {
    size := textLib.length(source);
    var cursor := skipTrivia(source, openParen + 1, prefix);
    if cursor >= size or textLib.at(source, cursor) == ")" { return false; }
    var entryIdx := 0;
    var atArgStart := true;
    var depth := 0;
    loop cursor < size {
        if atArgStart and depth == 0 {
            if textLib.at(source, cursor) == ")" { break; }
            var label := "";
            if isSingleEquals(source, cursor) {
                nameStart := skipTrivia(source, cursor + 1, prefix);
                if nameStart < size and textLib.isNameStart(textLib.at(source, nameStart)) {
                    label = textLib.slice(source, nameStart, textLib.skipName(source, nameStart));
                }
            } else if textLib.isNameStart(textLib.at(source, cursor)) {
                nameEnd := textLib.skipName(source, cursor);
                afterName := skipTrivia(source, nameEnd, prefix);
                if isSingleEquals(source, afterName) {
                    label = textLib.slice(source, cursor, nameEnd);
                }
            }
            if label =!= "" and findParamSlot(params, firstParam, paramCount, label) =!= entryIdx {
                return true;
            }
            atArgStart = false;
        }
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 and ch == ")" {
                entryIdx = entryIdx + 1;
                break;
            }
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            entryIdx = entryIdx + 1;
            cursor = skipTrivia(source, cursor + 1, prefix);
            if cursor < size and textLib.at(source, cursor) == ")" { break; }
            atArgStart = true;
        } else {
            cursor = cursor + 1;
        }
    }
    entryIdx =!= paramCount
}

/** Returns the position after the braced block starting at `open`, or -1 when it never closes. Strings and comments are skipped. */
scanBraceEnd := fn(source: String, open: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := open;
    var depth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** True when the braced body from `open` to `close` is a nonempty single expression: no semicolon and no statement keyword first. */
valueIfBranchAt := fn(source: String, open: Int, close: Int, prefix: String): Bool {
    var cursor := skipTrivia(source, open + 1, prefix);
    if cursor >= close { return false; }
    if textLib.isNameStart(textLib.at(source, cursor)) {
        word := textLib.slice(source, cursor, textLib.skipName(source, cursor));
        if word == "return" or word == "outputLine" or word == "output" or word == "var" or word == "loop" or
            word == "break" or word == "continue" or word == "else" or word == "fn" {
            return false;
        }
    }
    var scan := cursor;
    loop scan < close {
        ch := textLib.at(source, scan);
        if ch == "\"" {
            scan = skipAliasString(source, scan);
        } else if ch == "/" and textLib.startsWithAt(source, scan, "/*") {
            scan = skipComment(source, scan, prefix);
        } else if ch == ";" or (ch == "." and textLib.startsWithAt(source, scan, ".output")) {
            return false;
        } else {
            scan = scan + 1;
        }
    }
    true
}

/** Skips an optional `@tag` prefix before `keyword` during speculative scanning, returning the keyword start or `position` when untagged (or -1 on non-matching `@`). */
skipOptionalScanTag := fn(source: String, position: Int, prefix: String, keyword: String): Int {
    cursor := skipTrivia(source, position, prefix);
    size := textLib.length(source);
    if cursor >= size or textLib.at(source, cursor) =!= "@" { return cursor; }
    nameStart := cursor + 1;
    if nameStart >= size or not textLib.isNameStart(textLib.at(source, nameStart)) { return -1; }
    afterTag := skipTrivia(source, textLib.skipName(source, nameStart), prefix);
    if afterTag < size and textLib.wordAt(source, afterTag, keyword) { afterTag } else { -1 }
}

/** Scans an optional trailing `then { ... }` clause; returns `position` if absent, `-1` if malformed or failing `requireThenValue`. */
scanTrailingThenEnd := fn(source: String, position: Int, prefix: String, requireThenValue: Bool): Int {
    size := textLib.length(source);
    after := skipTrivia(source, position, prefix);
    if after >= size or not textLib.wordAt(source, after, "then") { return -2; }
    thenOpen := skipTrivia(source, after + 4, prefix);
    if thenOpen >= size or textLib.at(source, thenOpen) =!= "{" { return -1; }
    thenEnd := scanBraceEnd(source, thenOpen, prefix);
    if thenEnd < 0 { return -1; }
    if requireThenValue and not valueIfBranchAt(source, thenOpen, thenEnd - 1, prefix) { return -1; }
    thenEnd
}

/** Scans an optional trailing `finally { ... }` clause; returns `position` if absent, or `-1` if malformed. */
scanTrailingFinallyEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    after := skipTrivia(source, position, prefix);
    if after >= size or not textLib.wordAt(source, after, "finally") { return position; }
    finOpen := skipTrivia(source, after + 7, prefix);
    if finOpen >= size or textLib.at(source, finOpen) =!= "{" { return -1; }
    scanBraceEnd(source, finOpen, prefix)
}

/** Scans the raw `[@tag] if ... [else ...]` header+branches ending before any `then` clause; returns -1 on mismatch. */
scanRawIfChainEnd := fn(source: String, position: Int, prefix: String, allowPartial: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "if");
    if cursor < 0 or not textLib.wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        after := skipTrivia(source, end, prefix);
        if not textLib.wordAt(source, after, "else") {
            return if allowPartial { end } else { -1 };
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if textLib.wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textLib.at(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            return finalEnd;
        }
    }
    -1
}

/** Scans a `[@tag] if` chain, optionally allowing a partial chain without a final `else` and an optional trailing `then { ... }`. */
scanIfChainEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool, allowPartial: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "if");
    if cursor < 0 or not textLib.wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    var allBranchesValue := true;
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        if requireValueBranches and not valueIfBranchAt(source, open, end - 1, prefix) { allBranchesValue = false; }
        after := skipTrivia(source, end, prefix);
        if not textLib.wordAt(source, after, "else") {
            if not allowPartial { return -1; }
            if textLib.wordAt(source, after, "then") { return -1; }
            if requireValueBranches and not allBranchesValue { return -1; }
            return scanTrailingFinallyEnd(source, end, prefix);
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if textLib.wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textLib.at(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            if finalEnd < 0 { return -1; }
            if requireValueBranches and not valueIfBranchAt(source, afterElse, finalEnd - 1, prefix) { allBranchesValue = false; }
            thenEnd := scanTrailingThenEnd(source, finalEnd, prefix, requireValueBranches);
            if thenEnd == -1 { return -1; }
            baseEnd := if thenEnd == -2 {
                if requireValueBranches and not allBranchesValue { -1 } else { finalEnd }
            } else {
                thenEnd
            };
            if baseEnd < 0 { return -1; }
            return scanTrailingFinallyEnd(source, baseEnd, prefix);
        }
    }
    -1
}

/** Scans a total `[@tag] if` chain ending with a final else block and optional `then { ... }`. */
scanValueIfEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int {
    scanIfChainEnd(source, position, prefix, requireValueBranches, false)
}

/** Scans the raw `[@tag] match { ... }` ending before any `then` clause; returns -1 on mismatch. */
scanRawMatchEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "match");
    if cursor < 0 or not textLib.wordAt(source, cursor, "match") { return -1; }
    openMatch := skipTrivia(source, cursor + 5, prefix);
    if openMatch >= size or textLib.at(source, openMatch) =!= "{" { return -1; }
    var armCursor := skipItemSeparators(source, openMatch + 1, prefix);
    loop armCursor < size {
        if textLib.at(source, armCursor) == "}" { return -1; }
        afterUnderscore := skipTrivia(source, armCursor + 1, prefix);
        isFallback := textLib.wordAt(source, armCursor, "_") and afterUnderscore < size and
            textLib.at(source, afterUnderscore) == "{";
        armOpen := if isFallback { afterUnderscore }
            else { scanConditionOpen(source, armCursor, prefix) };
        if armOpen < 0 or (not isFallback and armOpen == armCursor) { return -1; }
        armEnd := scanBraceEnd(source, armOpen, prefix);
        if armEnd < 0 { return -1; }
        afterArm := skipItemSeparators(source, armEnd, prefix);
        if isFallback {
            if afterArm < size and textLib.at(source, afterArm) == "}" {
                return afterArm + 1;
            }
            return -1;
        }
        armCursor = afterArm;
    }
    -1
}

/** Scans a subjectless Boolean `[@tag] match` ending with a final `_` fallback arm and optional `then { ... }`. */
scanValueMatchEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int {
    size := textLib.length(source);
    var cursor := skipOptionalScanTag(source, position, prefix, "match");
    if cursor < 0 or not textLib.wordAt(source, cursor, "match") { return -1; }
    openMatch := skipTrivia(source, cursor + 5, prefix);
    if openMatch >= size or textLib.at(source, openMatch) =!= "{" { return -1; }
    var allArmsValue := true;
    var armCursor := skipItemSeparators(source, openMatch + 1, prefix);
    loop armCursor < size {
        if textLib.at(source, armCursor) == "}" { return -1; }
        afterUnderscore := skipTrivia(source, armCursor + 1, prefix);
        isFallback := textLib.wordAt(source, armCursor, "_") and afterUnderscore < size and
            textLib.at(source, afterUnderscore) == "{";
        armOpen := if isFallback { afterUnderscore }
            else { scanConditionOpen(source, armCursor, prefix) };
        if armOpen < 0 or (not isFallback and armOpen == armCursor) { return -1; }
        armEnd := scanBraceEnd(source, armOpen, prefix);
        if armEnd < 0 { return -1; }
        if requireValueBranches and not valueIfBranchAt(source, armOpen, armEnd - 1, prefix) { allArmsValue = false; }
        afterArm := skipItemSeparators(source, armEnd, prefix);
        if isFallback {
            if afterArm < size and textLib.at(source, afterArm) == "}" {
                thenEnd := scanTrailingThenEnd(source, afterArm + 1, prefix, requireValueBranches);
                if thenEnd == -1 { return -1; }
                baseEnd := if thenEnd == -2 {
                    if requireValueBranches and not allArmsValue { -1 } else { afterArm + 1 }
                } else {
                    thenEnd
                };
                if baseEnd < 0 { return -1; }
                return scanTrailingFinallyEnd(source, baseEnd, prefix);
            }
            return -1;
        }
        armCursor = afterArm;
    }
    -1
}

/** Finds the innermost loop context for leading-dot metadata, stopping on conditional, cleanup, or function barriers (-2 conditional, -3 finally, -1 outside). */
findLeadingDotLoopIdx := fn(ctxs: List<ConstructCtx>): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        kind := ctxs[index].kind;
        if kind == "loop" { return index; }
        if kind == "if" or kind == "match" { return -2; }
        if kind == "finally" { return -3; }
        if kind == "fn" { return -1; }
        index = index - 1;
    }
    -1
}

/** Finds the innermost active enclosing loop context, skipping loops whose body already completed (`then` or `finally`) and stopping at `fn`. */
findActiveLoopCtxIndex := fn(ctxs: List<ConstructCtx>): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        entry := ctxs[index];
        if entry.kind == "fn" { return -1; }
        if entry.kind == "loop" and entry.phase =!= "then" and entry.phase =!= "finally" { return index; }
        index = index - 1;
    }
    -1
}

/** True when a cleanup `finally` barrier sits strictly above `targetIdx` on `ctxs`. */
hasFinallyAbove := fn(ctxs: List<ConstructCtx>, targetIdx: Int): Bool {
    var index := ctxCount(ctxs) - 1;
    loop index > targetIdx {
        if ctxs[index].kind == "finally" { return true; }
        index = index - 1;
    }
    false
}

/** Scans a raw `[@tag] loop [header] { body }` up to the end of its body `}`, before any `then` or `finally`; returns -1 on mismatch. */
scanRawLoopEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLib.length(source);
    cursor := skipOptionalScanTag(source, position, prefix, "loop");
    if cursor < 0 or not textLib.wordAt(source, cursor, "loop") { return -1; }
    afterLoop := skipTrivia(source, cursor + 4, prefix);
    if afterLoop >= size { return -1; }
    open := if textLib.at(source, afterLoop) == "{" {
        afterLoop
    } else {
        scanConditionOpen(source, afterLoop, prefix)
    };
    if open < 0 or open >= size or textLib.at(source, open) =!= "{" { return -1; }
    scanBraceEnd(source, open, prefix)
}

/** True when a statement-position loop uses tags, metadata, payload exits, `then`, or `finally` and must lower as an enhanced loop expression. */
loopNeedsExprLowering := fn(source: String, position: Int, prefix: String): Bool {
    size := textLib.length(source);
    trimmed := skipTrivia(source, position, prefix);
    if trimmed >= size { return false; }
    if textLib.at(source, trimmed) == "@" { return true; }
    rawEnd := scanRawLoopEnd(source, trimmed, prefix);
    if rawEnd < 0 { return false; }
    afterRaw := skipTrivia(source, rawEnd, prefix);
    if afterRaw < size and (textLib.wordAt(source, afterRaw, "then") or textLib.wordAt(source, afterRaw, "finally")) {
        return true;
    }
    var cursor := trimmed;
    var prevExpr := false;
    loop cursor < rawEnd {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
            prevExpr = true;
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            cursor = cursor + 1;
        } else if ch == "@" {
            return true;
        } else if ch == ")" or ch == "]" or ch == "}" {
            cursor = cursor + 1;
            prevExpr = true;
        } else if ch == "." {
            if not prevExpr { return true; }
            cursor = cursor + 1;
            prevExpr = false;
        } else if textLib.isDigit(ch) {
            cursor = textLib.skipName(source, cursor);
            prevExpr = true;
        } else if textLib.isNameStart(ch) {
            end := textLib.skipName(source, cursor);
            word := textLib.slice(source, cursor, end);
            if word == "break" or word == "continue" {
                afterWord := skipTrivia(source, end, prefix);
                if afterWord < rawEnd and textLib.at(source, afterWord) =!= ";" and textLib.at(source, afterWord) =!= "}" {
                    return true;
                }
            }
            prevExpr = word =!= "and" and word =!= "or" and word =!= "not" and word =!= "if" and
                word =!= "else" and word =!= "match" and word =!= "loop" and word =!= "then" and
                word =!= "finally" and word =!= "return" and word =!= "break" and word =!= "continue" and
                word =!= "as" and word =!= "var" and word =!= "mut";
            cursor = end;
        } else {
            cursor = cursor + 1;
            prevExpr = false;
        }
    }
    false
}

/** Resolves `.count`, `.value`, `.item`, or `.index` against one active loop context, handling Pass 1 inference markers cleanly. */
resolveLoopField := fn(target: String, ctx: ConstructCtx, fieldName: String, expected: String, source: String, fieldStart: Int, fieldEnd: Int, prefix: String): Parsed {
    if fieldName == "count" {
        return intParsed(ctx.countVar, 0, false, fieldEnd);
    }
    if fieldName == "value" {
        if ctx.valKind == "__infer__" {
            if expected =!= "" and expected =!= "Unit" and expected =!= "Never" and
                not textLib.startsWithAt(expected, 0, "TailList<") and not textLib.startsWithAt(expected, 0, "__loopVal:") {
                return withMarkers((kind = expected, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                    integer.intText(ctx.id) + "=" + expected + "\n");
            }
            return withMarkers((kind = "__loopVal:" + integer.intText(ctx.id), code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                if ctx.phase =!= "then" { integer.intText(ctx.id) + "=@read\n" } else { "" });
        }
        if textLib.startsWithAt(ctx.valKind, 0, "__infer__:") {
            hint := textLib.slice(ctx.valKind, 10, textLib.length(ctx.valKind));
            return withMarkers((kind = hint, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                integer.intText(ctx.id) + "=" + hint + "\n");
        }
        if ctx.valKind == "Unit" {
            return (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.valKind, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "item" {
        if ctx.phase == "header" {
            failAt(source, fieldStart, prefix, ".item is not available in loop header");
        }
        if ctx.itemKind == "" or ctx.itemKind == "Unit" {
            return (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.itemKind, code = ctx.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "index" {
        if ctx.phase == "header" {
            failAt(source, fieldStart, prefix, ".index is not available in loop header");
        }
        if not ctx.hasIndex {
            failAt(source, fieldStart, prefix, "loop does not expose .index without a sequence source");
        }
        return intParsed(ctx.indexVar, 0, false, fieldEnd);
    }
    failAt(source, fieldStart, prefix, "unknown loop metadata field ." + fieldName);
    intParsed("", 0, false, fieldEnd)
}

/** Scans Pass 1 marker lines for `loopId`, reporting whether any marker or concrete type marker exists. */
scanLoopMarkers := fn(raw: String, loopId: Int): (hasAny: Bool, hasConcrete: Bool) {
    idKey := integer.intText(loopId);
    size := textLib.length(raw);
    var cursor := 0;
    var hasAny := false;
    var hasConcrete := false;
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            hasAny = true;
            if entryKind =!= "@read" and entryKind =!= "@break" and loopValMarkerId(entryKind) < 0 {
                hasConcrete = true;
            }
        }
        cursor = endPos + 1;
    }
    (hasAny = hasAny, hasConcrete = hasConcrete)
}

/** Resolves a loop's pre-`then` `.value` type `T` from Pass 1 markers, bidirectional hint, circular-read guard, and `Unit` default. */
inferLoopValueKind := fn(raw: String, loopId: Int, tagDisplay: String, source: String, at: Int, prefix: String, expectedHint: String): String {
    idKey := integer.intText(loopId);
    size := textLib.length(raw);
    var cursor := 0;
    var result := "";
    var sawRead := false;
    loop cursor < size {
        eqPos := textLib.indexOfText(raw, "=", cursor);
        if eqPos < 0 { break; }
        nlPos := textLib.indexOfText(raw, "\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := textLib.slice(raw, cursor, eqPos);
        entryKind := textLib.slice(raw, eqPos + 1, endPos);
        if entryId == idKey {
            if entryKind == "@read" {
                sawRead = true;
            } else if entryKind =!= "@break" and loopValMarkerId(entryKind) < 0 {
                if result == "" {
                    result = entryKind;
                } else {
                    joined := joinBranchKind(result, entryKind);
                    if joined == "" {
                        labelPrefix := if tagDisplay =!= "loop" { "loop @" + tagDisplay } else { "loop" };
                        failAt(source, at, prefix, labelPrefix + " cannot produce both " +
                            displayKind(result) + " and " + displayKind(entryKind));
                    }
                    result = joined;
                }
            }
        }
        cursor = endPos + 1;
    }
    if result =!= "" { return result; }
    if expectedHint =!= "" { return expectedHint; }
    if sawRead {
        failAt(source, at, prefix, "cannot infer loop .value type; add a type annotation");
    }
    "Unit"
}

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`, with construct context tracking. */
parseBinaryCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String): Parsed {
    var start := skipTrivia(source, position, prefix);
    if start >= textLib.length(source) {
        failAt(source, start, prefix, "expected an Int, Float, String or Bool expression");
    }
    effectiveMinimum := if minimum < 0 { 0 } else { minimum };
    var leaderStart := -1;
    var leaderText := "";
    if effectiveMinimum == 0 and (textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or")) {
        leaderStart = start;
        leaderEnd := textLib.skipName(source, start);
        leaderText = textLib.slice(source, start, leaderEnd);
        start = skipTrivia(source, leaderEnd, prefix);
        if textLib.wordAt(source, start, "and") or textLib.wordAt(source, start, "or") {
            failAt(source, start, prefix, "leading " + leaderText + " may appear only once");
        }
    }
    var left := intParsed("", 0, true, start);
    var condParseKind := "";
    var condParseStart := -1;
    var condParseTag := "";
    var condParseTagAt := -1;
    ch := textLib.at(source, start);
    if ch == "(" {
        if textLib.at(source, skipTrivia(source, start + 1, prefix)) == ")" {
            left = (kind = "Unit", code = targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = skipTrivia(source, start + 1, prefix) + 1);
        } else if looksLikeTupleEntry(source, start + 1, prefix) {
            var cursor := skipTrivia(source, start + 1, prefix);
            labels: mut List<String> = [];
            codes: mut List<String> = [];
            kinds: mut List<String> = [];
            var tupleMarkers := "";
            var count := 0;
            loop cursor < textLib.length(source) and textLib.at(source, cursor) =!= ")" {
                var label := "";
                var valueStart := cursor;
                var value := intParsed("", 0, true, cursor);
                if isSingleEquals(source, cursor) {
                    nameStart := skipTrivia(source, cursor + 1, prefix);
                    if nameStart >= textLib.length(source) or not textLib.isNameStart(textLib.at(source, nameStart)) {
                        failAt(source, nameStart, prefix, "expected a tuple field name after =");
                    }
                    nameEnd := textLib.skipName(source, nameStart);
                    label = textLib.slice(source, nameStart, nameEnd);
                    if isReservedWord(label) { unsupportedFeature(source, nameStart, label, prefix); }
                    if listLib.listContainsText(labels, label) {
                        failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                    }
                    valueStart = nameStart;
                    fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                    value = self(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30, ctxs, iifeDepth, inferMode, "");
                } else if cursor < textLib.length(source) and textLib.isNameStart(textLib.at(source, cursor)) {
                    nameEnd := textLib.skipName(source, cursor);
                    afterName := skipTrivia(source, nameEnd, prefix);
                    if isSingleEquals(source, afterName) {
                        label = textLib.slice(source, cursor, nameEnd);
                        if isReservedWord(label) { unsupportedFeature(source, cursor, label, prefix); }
                        if listLib.listContainsText(labels, label) {
                            failAt(source, cursor, prefix, "duplicate tuple field " + label);
                        }
                        valueStart = skipTrivia(source, afterName + 1, prefix);
                        fieldExpected := if isTupleKind(expected) { tupleFieldKind(expected, label) } else { "" };
                        value = self(target, source, valueStart, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "");
                    } else {
                        fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                        value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "");
                    }
                } else {
                    fieldExpected := if isTupleKind(expected) and count < tupleComponentCount(expected) { tupleComponent(expected, count).kind } else { "" };
                    value = self(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "");
                }
                if inferMode { tupleMarkers = collectParsedMarkers(tupleMarkers, value); }
                if isTupleKind(value.kind) {
                    failAt(source, valueStart, prefix, "nested tuple values are not supported");
                }
                if isListKind(value.kind) {
                    failAt(source, valueStart, prefix, "list values inside tuples are not supported");
                }
                if value.kind == "Unit" or value.kind == "Never" {
                    failName := if label =!= "" { label } else { integer.intText(count) };
                    failAt(source, valueStart, prefix, "tuple field " + failName + " cannot be " + displayKind(value.kind));
                }
                listLib.pushBack(mut labels, label);
                listLib.pushBack(mut codes, value.code);
                listLib.pushBack(mut kinds, value.kind);
                count = count + 1;
                cursor = skipTrivia(source, value.next, prefix);
                if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                } else {
                    break;
                }
            }
            cursor = expectSymbol(source, cursor, ")", prefix);
            var kindText := "(";
            var codeText := "{ ";
            var index := 0;
            loop index < count {
                if index > 0 {
                    kindText = kindText + ",";
                    codeText = codeText + ", ";
                }
                kindText = kindText + labels[index] + ":" + kinds[index];
                codeText = codeText + tupleObjectKey(labels[index], index) + ": " + codes[index];
                index = index + 1;
            }
            left = withMarkers((kind = kindText + ")", code = codeText + " }", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
        } else {
            var groupedExpected := expected;
            if numeric.isNumericKind(expected) {
                groupEnd := scanParenEnd(source, start, prefix);
                if groupEnd >= 0 and binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
            }
            inner := self(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0, ctxs, iifeDepth, inferMode, "");
            next := expectSymbol(source, skipTrivia(source, inner.next, prefix), ")", prefix);
            left = withMarkers((kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next),
                if inferMode { collectParsedMarkers("", inner) } else { "" });
        }
    } else if ch == "+" or ch == "-" {
        after := skipTrivia(source, start + 1, prefix);
        if after < textLib.length(source) and textLib.isDigit(textLib.at(source, after)) {
            litExpected := if ch == "-" { expected } else { "" };
            left = parseNumber(target, source, start, prefix, litExpected, minimum);
        } else {
            operand := self(target, source, start + 1, prefix, locals, functions, params, currentName, "", 30, ctxs, iifeDepth, inferMode, "");
            operandLoopId := loopValMarkerId(operand.kind);
            if inferMode and operandLoopId >= 0 {
                if expected =!= "" and expected =!= "Unit" and expected =!= "Never" and numeric.isNumericKind(expected) {
                    left = withMarkers((kind = expected, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
                        collectParsedMarkers("", operand) + integer.intText(operandLoopId) + "=" + expected + "\n");
                } else {
                    left = withMarkers((kind = operand.kind, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
                        collectParsedMarkers("", operand));
                }
            } else {
                if not numeric.isNumericKind(operand.kind) {
                    failAt(source, start, prefix, "unary " + ch + " requires an Int or Float operand");
                }
                code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
                if numeric.isFloatKind(operand.kind) {
                    left = withMarkers((kind = operand.kind, code = code, intValue = 0, textValue = "", constant = false, next = operand.next),
                        if inferMode { collectParsedMarkers("", operand) } else { "" });
                } else if operand.constant {
                    folded := if ch == "-" { integer.intNegate(operand.intValue) } else { (value = operand.intValue, ok = true) };
                    if folded.ok and numeric.intKindFits(operand.kind, folded.value) {
                        left = typedIntParsed(operand.kind, code, folded.value, true, operand.next);
                    } else {
                        rawNeg := targetIntNegateCode(target, operand.code, start);
                        checkedNeg := if numeric.isNarrowIntKind(operand.kind) {
                            targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start)
                        } else { rawNeg };
                        left = typedIntParsed(operand.kind, checkedNeg, 0, false, operand.next);
                    }
                } else {
                    runtimeCode := if ch == "-" {
                        rawNeg := targetIntNegateCode(target, operand.code, start);
                        if numeric.isNarrowIntKind(operand.kind) {
                            targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start)
                        } else { rawNeg }
                    } else { code };
                    left = withMarkers(typedIntParsed(operand.kind, runtimeCode, 0, false, operand.next),
                        if inferMode { collectParsedMarkers("", operand) } else { "" });
                }
            }
        }
    } else if textLib.isDigit(ch) {
        left = parseNumber(target, source, start, prefix, expected, minimum);
    } else if ch == "\"" {
        left = parseText(target, source, start, prefix);
    } else if ch == "[" {
        var cursor := skipTrivia(source, start + 1, prefix);
        isTailList := textLib.startsWithAt(expected, 0, "TailList<");
        isListTarget := isListKind(expected) or isTailList;
        var elementKind := "";
        if isListKind(expected) { elementKind = listElementKind(expected); }
        else if isTailList { elementKind = listElementKind(textLib.slice(expected, 4, textLib.length(expected))); }
        else if isArrayKind(expected) { elementKind = arrayElementKind(expected); }
        elementCodes: mut List<String> = [];
        var listMarkers := "";
        var count := 0;
        loop true {
            if cursor >= textLib.length(source) {
                failAt(source, cursor, prefix, "expected ] in list literal");
            }
            if textLib.at(source, cursor) == "]" { break; }
            elementStart := cursor;
            element := self(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "");
            if inferMode { listMarkers = collectParsedMarkers(listMarkers, element); }
            if element.kind == "Unit" and elementKind =!= "Unit" {
                failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " cannot be Unit");
            }
            if isListKind(element.kind) {
                failAt(source, elementStart, prefix, "nested list types are not supported");
            }
            if elementKind == "" {
                if element.kind =!= "Never" { elementKind = element.kind; }
            } else {
                compatible := if isListTarget { isCompatibleKind(elementKind, element.kind) }
                    else { element.kind == "Never" or element.kind == elementKind };
                if not compatible {
                    failAt(source, elementStart, prefix, "list element " + formatLib.decimalText(count + 1) + " must be " +
                        displayKind(elementKind) + ", got " + displayKind(element.kind));
                }
            }
            listLib.pushBack(mut elementCodes, assignValueCode(target, elementKind, element.kind, element.code));
            count = count + 1;
            cursor = skipTrivia(source, element.next, prefix);
            if cursor < textLib.length(source) and textLib.at(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = expectSymbol(source, cursor, "]", prefix);
        if count > 0 and elementKind == "" {
            failAt(source, start, prefix, "list element 1 cannot be Never");
        }
        if count == 0 and not isListKind(expected) and not isTailList and not isArrayKind(expected) {
            failAt(source, start, prefix, "empty list literal requires a List element type");
        }
        resultKind := if isListKind(expected) or (count == 0 and isTailList) {
            "List<" + elementKind + ">"
        } else {
            "[" + elementKind + ";" + integer.intText(count) + "]"
        };
        left = withMarkers((kind = resultKind, code = "[" + textLib.joinTexts(elementCodes, ", ") + "]",
            intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
    } else if ch == "@" {
        tagInfo := parseTagAt(source, start, prefix);
        afterTag := skipTrivia(source, tagInfo.next, prefix);
        tagSourceSize := textLib.length(source);
        if afterTag < tagSourceSize and textLib.at(source, afterTag) == "." {
            fieldStart := skipTrivia(source, afterTag + 1, prefix);
            if fieldStart >= tagSourceSize or not textLib.isNameStart(textLib.at(source, fieldStart)) {
                failAt(source, fieldStart, prefix, "expected field name after @" + tagInfo.tag + ".");
            }
            fieldEnd := textLib.skipName(source, fieldStart);
            fieldName := textLib.slice(source, fieldStart, fieldEnd);
            ctxIdx := findTaggedCtxIndex(ctxs, tagInfo.tag);
            if ctxIdx < 0 {
                failAt(source, start, prefix, "unknown block tag @" + tagInfo.tag);
            }
            if hasFinallyAbove(ctxs, ctxIdx) {
                failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
            }
            ctx := ctxs[ctxIdx];
            if ctx.kind == "if" or ctx.kind == "match" {
                if fieldName == "value" {
                    if ctx.phase =!= "then" {
                        failAt(source, fieldStart, prefix, "@" + tagInfo.tag + ".value is only available inside that conditional's then block");
                    }
                    if ctx.itemKind == "Unit" or ctx.itemKind == "Never" or ctx.itemKind == "" {
                        failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose .value for " +
                            displayKind(if ctx.itemKind == "" { "Unit" } else { ctx.itemKind }) + " conditional");
                    }
                    left = (kind = ctx.itemKind, code = ctx.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
                } else {
                    failAt(source, fieldStart, prefix, "conditional tag @" + tagInfo.tag + " only exposes .value, not ." + fieldName);
                }
            } else if ctx.kind == "loop" {
                if ctx.phase == "finally" {
                    failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
                }
                if target =!= "ts" {
                    failAt(source, start, prefix, "C backend does not support loop metadata yet");
                }
                left = resolveLoopField(target, ctx, fieldName, expected, source, fieldStart, fieldEnd, prefix);
            } else {
                failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose ." + fieldName);
            }
        } else if afterTag < tagSourceSize and textLib.at(source, afterTag) == "{" {
            if target =!= "ts" {
                failAt(source, start, prefix, "C backend does not support tagged blocks yet");
            }
            hintExpected := if expected == "Unit" or expected == "Never" {
                ""
            } else if textLib.startsWithAt(expected, 0, "TailList<") {
                "List<" + listElementKind(textLib.slice(expected, 4, textLib.length(expected))) + ">"
            } else {
                expected
            };
            blockId := nextCtxId(ctxs);
            blockLabel := "lite$b" + integer.intText(blockId);
            blockValVar := "lite$val" + integer.intText(blockId);
            pass1ValKind := if hintExpected == "" { "__infer__" } else { "__infer__:" + hintExpected };
            pass1Ctx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "body",
                iifeDepth = iifeDepth + 1, valKind = pass1ValKind, valVar = blockValVar, label = blockLabel,
                iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
            pass1 := self(target, source, afterTag, prefix, locals, functions, params, currentName,
                hintExpected, 0, appendCtx(ctxs, pass1Ctx), iifeDepth + 1, true, "tagged");
            if inferMode {
                left = pass1;
            } else {
                inferredKind := pass1.kind;
                pass2Expected := if inferredKind == "Unit" or inferredKind == "Never" { "" } else { inferredKind };
                pass2Ctx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "body",
                    iifeDepth = iifeDepth + 1, valKind = inferredKind, valVar = blockValVar, label = blockLabel,
                    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                left = self(target, source, afterTag, prefix, locals, functions, params, currentName,
                    pass2Expected, 0, appendCtx(ctxs, pass2Ctx), iifeDepth + 1, false, "tagged");
            }
            afterTaggedClose := skipTrivia(source, left.next, prefix);
            if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "then") {
                failAt(source, afterTaggedClose, prefix, "then requires an if, match, or loop");
            }
            if afterTaggedClose < tagSourceSize and textLib.wordAt(source, afterTaggedClose, "finally") {
                afterFinKw := skipTrivia(source, afterTaggedClose + 7, prefix);
                rejectMisplacedTag(source, afterFinKw, prefix, "block tag cannot appear after finally");
                finOpen := expectSymbol(source, afterFinKw, "{", prefix);
                taggedFinCtx := (id = blockId, tag = tagInfo.tag, kind = "block", phase = "finally",
                    iifeDepth = iifeDepth + 1, valKind = left.kind, valVar = blockValVar, label = blockLabel,
                    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                finBarrierCtx := (id = 0, tag = "", kind = "finally", phase = "finally",
                    iifeDepth = iifeDepth + 1, valKind = "Unit", valVar = "", label = "",
                    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                finCtxs := appendCtx(appendCtx(ctxs, taggedFinCtx), finBarrierCtx);
                finParsed := self(target, source, finOpen - 1, prefix, locals, functions, params, currentName,
                    "", 0, finCtxs, iifeDepth + 1, inferMode, "finally");
                afterFinClose := skipTrivia(source, finParsed.next, prefix);
                if afterFinClose < tagSourceSize and textLib.wordAt(source, afterFinClose, "then") {
                    failAt(source, afterFinClose, prefix, "then must appear before finally");
                }
                if afterFinClose < tagSourceSize and textLib.wordAt(source, afterFinClose, "finally") {
                    failAt(source, afterFinClose, prefix, "duplicate finally block");
                }
                finalTaggedKind := if finParsed.kind == "Never" { "Never" } else { left.kind };
                if inferMode {
                    mergedTaggedMarkers := collectParsedMarkers(collectParsedMarkers("", left), finParsed);
                    left = withMarkers((kind = finalTaggedKind, code = "", intValue = 0, textValue = "", constant = false, next = finParsed.next), mergedTaggedMarkers);
                } else {
                    taggedTryBody := if left.kind == "Unit" {
                        "void (" + left.code + "); return undefined;"
                    } else if left.kind == "Never" {
                        "(" + left.code + ");"
                    } else {
                        "return " + left.code + ";"
                    };
                    left = (kind = finalTaggedKind, code = "(() => { try { " + taggedTryBody + " } finally { " + finParsed.code + " } })()",
                        intValue = 0, textValue = "", constant = false, next = finParsed.next);
