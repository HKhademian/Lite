                        afterStmtFinClose := skipTrivia(source, stmtFin.next, prefix);
                        if afterStmtFinClose < blockSourceSize and textLib.wordAt(source, afterStmtFinClose, "then") {
                            failAt(source, afterStmtFinClose, prefix, "then must appear before finally");
                        }
                        if afterStmtFinClose < blockSourceSize and textLib.wordAt(source, afterStmtFinClose, "finally") {
                            failAt(source, afterStmtFinClose, prefix, "duplicate finally block");
