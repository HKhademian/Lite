            if not currentStopped { currentReturned = true; }
            currentStopped = true;
            continue;
        }
        if name == "break" or name == "continue" {
            var afterExit := position;
            if position < size and textLib.at(source, position) == "@" {
                exitTag := parseTagAt(source, position, prefix);
                afterDotCheck := skipTrivia(source, exitTag.next, prefix);
                if afterDotCheck < size and textLib.at(source, afterDotCheck) == "." {
