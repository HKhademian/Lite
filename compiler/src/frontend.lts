                        listLib.pushBack(mut pendingDestrNames, bindName);
                    }
                    bindRuntime := claimOrMakeLocalRuntime(target, locals, bindName, moduleKey, depth);
                    fieldCode := assignValueCode(target, bindKind, srcKind, propExpr);
                    fieldLocalCode := if target == TARGET_TS and containsFnKind(bindKind) { computeCallableRhsDeps(fieldCode) } else { fieldCode };
                    listLib.pushBack(mut locals, (name = bindName, runtime = bindRuntime, kind = bindKind,
                    mutable = destructureMutable, writable = false, depth = depth, constant = false, code = fieldLocalCode,
                    intValue = 0, textValue = "", initState = INIT_STATE_INIT));
                    if currentLive and not currentStopped {
