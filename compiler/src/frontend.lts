                            iifeDepth = bodyDepth, valKind = "Unit", valVar = "", label = "",
                            iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false);
                        stmtFin := self(target, source, stmtFinOpen - 1, prefix, blockLocals, functions, params, currentName,
