            if statementNext < 0 { failAt(source, position, prefix, "expected ; after " + name); }
            position = statementNext;
            if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = if name == "break" { "Break" } else { "Continue" }, name = "", runtime = "",
