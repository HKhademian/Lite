                    if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                    bindRuntime := localRuntimeName(target, blockLocals, bindName, "", 1);
                    listLib.pushBack(mut blockLocals, (name = bindName, runtime = bindRuntime, kind = rhs.kind,
                        mutable = destructureMutable, writable = false, depth = 1, constant = false, code = rhs.code,
                        intValue = rhs.intValue, textValue = rhs.textValue, initState = "init"));
                    if not blockExits {
                        declKw := if destructureMutable { "let " } else { "const " };
                        listLib.pushBack(mut statements, declKw + bindRuntime + " = " + copiedValueCode(target, rhs.kind, rhs.code) + "; void " + bindRuntime + ";");
                        statementCount = statementCount + 1;
                    }
                    blockConstant = false;
                    cursor = statementNext;
                } else {
