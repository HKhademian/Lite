                    hasTargetTag = true;
                    targetTagName = retTag.tag;
                }
            }
            if hasTargetTag {
                tagIdx := findTaggedCtxIndex(stmtCtxs, targetTagName);
                if tagIdx < 0 {
                    failAt(source, targetTagPos, prefix, "unknown block tag @" + targetTagName);
                }
                failAt(source, targetTagPos, prefix, "unknown block tag @" + targetTagName);
            }
            if currentName == "" {
                failAt(source, nameStart, prefix, "return outside a function");
            }
            valueStart := position;
            if valueStart >= size or textLib.at(source, valueStart) == ";" or textLib.at(source, valueStart) == "}" {
                if currentResult =!= "Unit" {
                    failAt(source, nameStart, prefix, "function " + currentName + " must return " + currentResult);
                }
                position = consumeStatementEnd(source, valueStart, prefix);
                if currentLive and not currentStopped { listLib.pushBack(mut items, (kind = "Return", name = "", runtime = "", code = "",
                    intValue = 0, textValue = "")); }
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
                continue;
            }
            if currentResult == "Unit" {
                failAt(source, nameStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
            }
            parsed := parseExpressionAsCtx(target, source, position, prefix, locals, functions, functionParams, currentName, currentResult, stmtCtxs);
            if not isCompatibleKind(currentResult, parsed.kind) {
                failAt(source, valueStart, prefix, "cannot return " + displayKind(parsed.kind) + " from function " +
                    currentName + " returning " + displayKind(currentResult));
            }
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after return"); }
            position = statementNext;
            retCode := assignValueCode(target, currentResult, parsed.kind, parsed.code);
            if currentLive and not currentStopped {
