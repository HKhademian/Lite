                    stmtBlock := self(target, source, cursor, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "stmt");
                    if inferMode { blockMarkers = collectParsedMarkers(blockMarkers, stmtBlock); }
                    afterStmtBlock := skipTrivia(source, stmtBlock.next, prefix);
