                                labelEnd := textLib.skipName(source, cursor);
                                afterLabel := skipTrivia(source, labelEnd, prefix);
                                if isSingleEquals(source, afterLabel) {
                                    namedLabel = textLib.slice(source, cursor, labelEnd);
                                    rhsStart = skipTrivia(source, afterLabel + 1, prefix);
                                }
                            }
                            if namedLabel =!= "" {
                                if isReservedWord(namedLabel) { unsupportedFeature(source, cursor, namedLabel, prefix); }
                                slot := findParamSlot(params, info.first, info.count, namedLabel);
                                if slot < 0 {
                                    failAt(source, cursor, prefix, "unknown parameter " + namedLabel + " in call to " + calleeDisplay);
                                }
                                if slotExplicit[slot] {
                                    failAt(source, cursor, prefix, "duplicate named argument " + namedLabel + " in call to " + calleeDisplay);
                                }
                                slotExplicit = setBoolAt(slotExplicit, slot, true);
                                slotEntry = setIntAt(slotEntry, slot, entryCount);
                                expected := paramKindOf(params[info.first + slot]);
                                arg := self(=target, =source, position = rhsStart, =prefix, =locals, =functions, =params, =currentName, =expected, minimum = 0, =ctxs, iifeDepth = argIifeDepth, =inferMode, bodySink = "");
                                if inferMode { callMarkers = collectParsedMarkers(callMarkers, arg); }
                                listLib.pushBack(mut entryPositions, rhsStart);
                                listLib.pushBack(mut entrySlots, slot);
                                listLib.pushBack(mut entryKinds, arg.kind);
                                listLib.pushBack(mut entryCodes, arg.code);
                                entryCount += 1;
                                cursor = skipTrivia(source, arg.next, prefix);
                            } else {
                                var nextSlot := -1;
                                var scan := 0;
                                loop scan < info.count {
                                    if slotEntry[scan] < 0 {
                                        nextSlot = scan;
                                        break;
                                    }
                                    scan += 1;
                                }
                                if nextSlot < 0 {
                                    suffix := if info.count == 1 { " argument" } else { " arguments" };
                                    failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(info.count) + suffix + ", got more");
                                }
                                slotName := paramNameOf(params[info.first + nextSlot]);
                                posExpected := if listLib.listContainsText(explicitLabels, slotName) { "" } else { paramKindOf(params[info.first + nextSlot]) };
                                slotEntry = setIntAt(slotEntry, nextSlot, entryCount);
                                arg := self(=target, =source, position = cursor, =prefix, =locals, =functions, =params, =currentName, expected = posExpected, minimum = 0, =ctxs, iifeDepth = argIifeDepth, =inferMode, bodySink = "");
                                if inferMode { callMarkers = collectParsedMarkers(callMarkers, arg); }
                                listLib.pushBack(mut entryPositions, cursor);
                                listLib.pushBack(mut entrySlots, nextSlot);
                                listLib.pushBack(mut entryKinds, arg.kind);
                                listLib.pushBack(mut entryCodes, arg.code);
                                entryCount += 1;
                                cursor = skipTrivia(source, arg.next, prefix);
                            }
                        }
                        if cursor < size and textLib.at(source, cursor) == "," {
                            cursor = skipTrivia(source, cursor + 1, prefix);
                            if cursor < size and textLib.at(source, cursor) == ")" { break; }
                        } else {
                            break;
                        }
                    }
                }
                cursor = expectSymbol(source, cursor, ")", prefix);
                var filledCount := 0;
                var checkSlot := 0;
                loop checkSlot < info.count {
                    if slotEntry[checkSlot] >= 0 { filledCount += 1; }
                    checkSlot += 1;
                }
                if filledCount =!= info.count {
                    suffix := if info.count == 1 { " argument" } else { " arguments" };
                    failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + formatLib.decimalText(info.count) +
                        suffix + ", got " + formatLib.decimalText(filledCount));
                }
                var isIdentityOrder := entryCount == info.count;
                var slotIdx := 0;
                loop slotIdx < info.count {
                    k := slotEntry[slotIdx];
                    if k =!= slotIdx { isIdentityOrder = false; }
                    expected := paramKindOf(params[info.first + slotIdx]);
                    if not isCompatibleKind(expected, entryKinds[k]) {
                        failAt(source, entryPositions[k], prefix, "argument " + formatLib.decimalText(slotIdx + 1) + " of " +
                            calleeDisplay + " must be " + displayKind(expected) + ", got " + displayKind(entryKinds[k]));
                    }
                    slotIdx += 1;
                }
                var emittedCode := "";
                var emittedResultKind := info.result;
                if isIdentityOrder {
                    finalArgs: mut List<String> = [];
                    var pIdx := 0;
                    loop pIdx < info.count {
                        expected := paramKindOf(params[info.first + pIdx]);
                        listLib.pushBack(mut finalArgs, assignValueCode(target, expected, entryKinds[pIdx], entryCodes[pIdx]));
                        pIdx = pIdx + 1;
                    }
                    emittedCode = info.runtime + "(" + textLib.joinTexts(finalArgs, ", ") + ")";
                } else {
                    if target =!= "ts" {
                        failAt(source, errPos, prefix, "C backend does not support named or reordered call arguments yet");
                    }
                    evalStmts: mut List<String> = [];
                    var callDiverged := false;
                    var kIdx := 0;
                    loop kIdx < entryCount {
                        if not callDiverged {
                            targetSlot := entrySlots[kIdx];
                            if entryKinds[kIdx] == "Never" {
                                listLib.pushBack(mut evalStmts, "return " + entryCodes[kIdx] + ";");
                                callDiverged = true;
                            } else if slotEntry[targetSlot] == kIdx {
                                temp := "lite$arg" + integer.intText(kIdx);
                                expected := paramKindOf(params[info.first + targetSlot]);
                                listLib.pushBack(mut evalStmts, "const " + temp + " = " + assignValueCode(target, expected, entryKinds[kIdx], entryCodes[kIdx]) + ";");
                            } else {
                                listLib.pushBack(mut evalStmts, "void (" + entryCodes[kIdx] + ");");
                            }
                        }
                        kIdx = kIdx + 1;
                    }
                    if callDiverged {
                        emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " })()";
                        emittedResultKind = "Never";
                    } else {
                        slotTemps: mut List<String> = [];
                        var sIdx := 0;
                        loop sIdx < info.count {
                            listLib.pushBack(mut slotTemps, "lite$arg" + integer.intText(slotEntry[sIdx]));
                            sIdx = sIdx + 1;
                        }
                        callExpr := info.runtime + "(" + textLib.joinTexts(slotTemps, ", ") + ")";
                        retStmt := if info.result == "Unit" { "void (" + callExpr + "); return undefined;" } else { "return " + callExpr + ";" };
                        emittedCode = "(() => { " + textLib.joinTexts(evalStmts, " ") + " " + retStmt + " })()";
                    }
                }
                left = withMarkers((kind = emittedResultKind, code = emittedCode, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers);
            }
        } else {
            break;
        }
    }
    loop true {
        if left.next > 0 and textLib.at(source, left.next - 1) == "}" { break; }
        operatorPosition := skipTrivia(source, left.next, prefix);
        if operatorPosition >= textLib.length(source) { break; }
        operator := readOperator(source, operatorPosition);
        if operator.text == "" { break; }
        level := operatorLevel(operator.text);
        if level < effectiveMinimum { break; }
        if operator.text == "**" {
            var signPosition := start;
            loop signPosition < textLib.length(source) and (textLib.at(source, signPosition) == "+" or textLib.at(source, signPosition) == "-") {
                if textLib.at(source, signPosition) == "-" {
                    failAt(source, operatorPosition, prefix, "group a negative power base as (-base) or negate the completed power as -(base ** exponent)");
                }
                signPosition = skipTrivia(source, signPosition + 1, prefix);
            }
        }
        rightMinimum := if operator.text == "**" { level } else { level + 1 };
        right := self(target, source, operatorPosition + operator.width, prefix, locals, functions, params, currentName, "", rightMinimum, ctxs, iifeDepth, inferMode, "");
        var opMarkers := if inferMode { collectParsedMarkers(collectParsedMarkers("", left), right) } else { "" };
        leftLoopId := loopValMarkerId(left.kind);
        rightLoopId := loopValMarkerId(right.kind);
        if inferMode and (leftLoopId >= 0 or rightLoopId >= 0) {
            if leftLoopId >= 0 and rightLoopId >= 0 {
                if operator.text == "and" or operator.text == "or" {
                    opMarkers = opMarkers + integer.intText(leftLoopId) + "=Bool\n" + integer.intText(rightLoopId) + "=Bool\n";
                    left = boolParsed("", false, false, right.next);
                } else if isComparison(operator.text) {
                    var chainEnd := right.next;
                    var nextPos := skipTrivia(source, chainEnd, prefix);
                    var nextOp := comparisonOperatorAt(source, nextPos);
                    loop isComparison(nextOp.text) {
                        operand := self(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "");
                        opMarkers = collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = skipTrivia(source, chainEnd, prefix);
                        nextOp = comparisonOperatorAt(source, nextPos);
                    }
                    left = boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    left = (kind = "Float", code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else {
                    left = (kind = left.kind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                }
            } else {
                targetLoopId := if leftLoopId >= 0 { leftLoopId } else { rightLoopId };
                peerKind := if leftLoopId >= 0 { right.kind } else { left.kind };
                if operator.text == "and" or operator.text == "or" {
                    if peerKind =!= "Bool" {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=Bool\n";
                    left = boolParsed("", false, false, right.next);
                } else if isComparison(operator.text) {
                    if peerKind == "Never" { failAt(source, operatorPosition, prefix, "cannot compare Never values"); }
                    if isTupleKind(peerKind) { failAt(source, operatorPosition, prefix, "cannot compare tuple values"); }
                    if isListKind(peerKind) { failAt(source, operatorPosition, prefix, "cannot compare list values"); }
                    if operator.text =!= "==" and operator.text =!= "=!=" and not numeric.isNumericKind(peerKind) {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    var chainEnd := right.next;
                    var nextPos := skipTrivia(source, chainEnd, prefix);
                    var nextOp := comparisonOperatorAt(source, nextPos);
                    loop isComparison(nextOp.text) {
                        operand := self(target, source, nextPos + nextOp.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "");
                        opMarkers = collectParsedMarkers(opMarkers, operand);
                        chainEnd = operand.next;
                        nextPos = skipTrivia(source, chainEnd, prefix);
                        nextOp = comparisonOperatorAt(source, nextPos);
                    }
                    left = boolParsed("", false, false, chainEnd);
                } else if operator.text == "**" {
                    if not numeric.isNumericKind(peerKind) {
                        failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = "Float", code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if operator.text == "+" and peerKind == "String" {
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=String\n";
                    left = textParsed("", "", false, right.next);
                } else if numeric.isNumericKind(peerKind) {
                    if not numeric.isIntKind(peerKind) and operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                        failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                    }
                    opMarkers = opMarkers + integer.intText(targetLoopId) + "=" + peerKind + "\n";
                    left = (kind = peerKind, code = "", intValue = 0, textValue = "", constant = false, next = right.next);
                } else if isListKind(peerKind) {
                    failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
                } else if operator.text == "+" {
                    failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
                } else {
                    failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
                }
            }
        } else if operator.text == "and" or operator.text == "or" {
            if left.kind =!= "Bool" or right.kind =!= "Bool" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
            }
            if left.constant and right.constant {
                value := if operator.text == "and" {
                    left.intValue =!= 0 and right.intValue =!= 0
                } else {
                    left.intValue =!= 0 or right.intValue =!= 0
                };
                left = boolParsed(targetBoolLiteralCode(target, value), value, true, right.next);
            } else {
                left = boolParsed(targetLogicCode(target, operator.text, left.code, right.code), false, false, right.next);
            }
        } else if isComparison(operator.text) {
            firstPair := compareParsed(target, source, operatorPosition, operator.text, left, right, prefix);
            var nextPosition := skipTrivia(source, right.next, prefix);
            var nextOperator := comparisonOperatorAt(source, nextPosition);
            if not isComparison(nextOperator.text) {
                left = firstPair;
            } else {
                codes: mut List<String> = [left.code, right.code];
                kinds: mut List<String> = [left.kind, right.kind];
                operators: mut List<String> = [operator.text];
                var count := 1;
                var previous := right;
                var end := right.next;
                var constant := left.constant and right.constant;
                var value := firstPair.intValue =!= 0;
                loop isComparison(nextOperator.text) {
                    operand := self(target, source, nextPosition + nextOperator.width, prefix, locals, functions, params, currentName, "", level + 1, ctxs, iifeDepth, inferMode, "");
                    if inferMode { opMarkers = collectParsedMarkers(opMarkers, operand); }
                    pair := compareParsed(target, source, nextPosition, nextOperator.text, previous, operand, prefix);
                    listLib.pushBack(mut codes, operand.code);
                    listLib.pushBack(mut kinds, operand.kind);
                    listLib.pushBack(mut operators, nextOperator.text);
                    constant = constant and operand.constant;
                    if constant { value = value and pair.intValue =!= 0; }
                    count = count + 1;
                    previous = operand;
                    end = operand.next;
                    nextPosition = skipTrivia(source, end, prefix);
                    nextOperator = comparisonOperatorAt(source, nextPosition);
                }
                if constant { left = boolParsed(targetBoolLiteralCode(target, value), value, true, end); }
                else { left = boolParsed(targetComparisonChainCode(target, codes, kinds, operators, count, operatorPosition), false, false, end); }
            }
        } else if operator.text == "**" {
            if not numeric.isNumericKind(left.kind) or not numeric.isNumericKind(right.kind) {
                failAt(source, operatorPosition, prefix, "power requires Int or Float operands");
            }
            code := targetFloatPowerCode(target, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition);
            left = (kind = "Float", code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind) {
            promoted := numeric.promoteNumericKind(left.kind, right.kind);
            if left.constant and right.constant {
                folded := tryFoldInteger(operator.text, left.intValue, right.intValue);
                if folded.ok and numeric.intKindFits(promoted, folded.value) {
                    code := if (operator.text == "%" or operator.text == ":%") and left.intValue == integer.intMin() and right.intValue == -1 {
                            targetIntLiteralCode(target, 0, false, "0")
                        } else if operator.text == ":/" { targetFloorDivCode(target, left.code, right.code) }
                        else if operator.text == ":%" { targetFloorModCode(target, left.code, right.code) }
                        else { "(" + left.code + " " + operator.text + " " + right.code + ")" };
                    left = typedIntParsed(promoted, code, folded.value, true, right.next);
                } else {
                    left = typedIntParsed(promoted, runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
                }
            } else {
                left = typedIntParsed(promoted, runtimeTypedIntegerCode(target, promoted, operator.text, left.code, right.code, operatorPosition), 0, false, right.next);
            }
        } else if operator.text == "+" and left.kind == "String" and right.kind == "String" {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = textParsed(targetTextLiteralCode(target, combined), combined, true, right.next);
            } else {
                left = textParsed(targetConcatCode(target, left.code, right.code), "", false, right.next);
            }
        } else if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
            if operator.text =!= "+" and operator.text =!= "-" and operator.text =!= "*" and operator.text =!= "/" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
            }
            promotedFloat := numeric.promoteNumericKind(left.kind, right.kind);
            floatKind := if promotedFloat =!= "" { promotedFloat } else if numeric.isFloatKind(left.kind) { left.kind } else { right.kind };
            code := if floatKind == "Float32" {
                targetFloat32BinaryCode(target, operator.text, targetFloat32OperandCode(target, left.kind, left.code), targetFloat32OperandCode(target, right.kind, right.code), operatorPosition)
            } else {
                targetFloatBinaryCode(target, operator.text, targetFloatOperandCode(target, left.kind, left.code), targetFloatOperandCode(target, right.kind, right.code), operatorPosition)
            };
            left = (kind = floatKind, code = code, intValue = 0, textValue = "", constant = false, next = right.next);
        } else if isListKind(left.kind) or isListKind(right.kind) {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if operator.text == "+" {
            failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
        if inferMode and opMarkers =!= "" { left = withMarkers(left, opMarkers); }
    }
    if leaderStart >= 0 and left.kind =!= "Bool" {
        failAt(source, leaderStart, prefix, "leading " + leaderText + " requires a Bool expression");
    }
    left
}

/** Parses one expression with an empty construct context stack. */
parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, minimum, [], 0, false, "")
}

/** Parses one complete expression at the lowest precedence with construct contexts and an optional contextual kind. */
parseExpressionAsCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, 0, ctxs, 0, false, "")
}

/** Parses one statement-level expression with construct contexts, allowing unit-producing tagged conditionals without else. */
parseStatementExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, -2, ctxs, 0, false, "")
}

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, 0)
}

/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>): Parsed {
    parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, "", 0, ctxs, 0, false, "")
}

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(target, source, position, prefix, locals, functions, params, currentName, "", 0)
}

/** Reads the logical diagnostic name supplied by the compiler host. */
pub sourcePrefix := fn(): String {
    var prefix := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 0 { prefix = argument; }
        argumentIndex = argumentIndex + 1;
    }
    prefix
}

/** Reads the compiler-host verified identity of the root source module. */
pub sourceModuleIdentity := fn(): String {
    var identity := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 1 { identity = argument; }
        argumentIndex = argumentIndex + 1;
    }
    identity
}

/** Reads the canonical root path used to resolve language-level imports. */
pub sourceModulePath := fn(): String {
    var path := "";
    var argumentIndex := 0;
    loop io.inputArgs() as argument {
        if argumentIndex == 2 { path = argument; }
        argumentIndex = argumentIndex + 1;
    }
    path
}

/** Collapses a numeric scalar, tuple or list kind to its canonical item suffix (`Int`, `Float`, `Tuple`, `List`) while leaving other scalar kinds unchanged. */
storageKind := fn(kind: String): String {
    match {
        isListKind(kind) or isArrayKind(kind) { "List" }
        isTupleKind(kind) { "Tuple" }
        numeric.isIntKind(kind) { "Int" }
        numeric.isFloatKind(kind) { "Float" }
        _ { kind }
    }
}

/** Returns the text payload stored with one local item: the canonical List/Array kind for List/Array items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String {
    if isListKind(parsed.kind) or isArrayKind(parsed.kind) { parsed.kind } else { parsed.textValue }
}

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>): Items {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    if not textLib.wordAt(source, inner, "if") { return []; }
    result: mut List<Item> = [];
    var cursor := skipTrivia(source, inner + 2, prefix);
    var isFirst := true;
    loop true {
        rejectHeaderBlockTag(source, cursor, prefix, if isFirst { "if" } else { "else if" });
        conditionStart := cursor;
        condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, params, currentName, ctxs);
        if condition.kind =!= "Bool" {
            failAt(source, conditionStart, prefix, "if condition must be Bool");
        }
        conditionCode := if condition.constant {
            targetBoolLiteralCode(target, condition.intValue =!= 0)
        } else {
            condition.code
        };
        beforeOpen := skipTrivia(source, condition.next, prefix);
        rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in if");
        open := expectSymbol(source, beforeOpen, "{", prefix);
        branchStart := skipTrivia(source, open, prefix);
        branch := parseExpressionAsCtx(target, source, branchStart, prefix, locals, functions, params, currentName, targetKind, ctxs);
        if not isCompatibleKind(targetKind, branch.kind) {
            failAt(source, targetAt, prefix, "cannot assign " + displayKind(branch.kind) + " to " + displayKind(targetKind) + " local " + targetName);
        }
        cursor = expectSymbol(source, skipTrivia(source, branch.next, prefix), "}", prefix);
        listLib.pushBack(mut result, (kind = if isFirst { "If" } else { "ElseIf" }, name = "", runtime = "", code = conditionCode,
            intValue = 0, textValue = ""));
        listLib.pushBack(mut result, (kind = "Assign" + storageKind(targetKind), name = targetName, runtime = targetRuntime,
            code = assignValueCode(target, targetKind, branch.kind, branch.code), intValue = branch.intValue, textValue = itemTextPayload(branch)));
        isFirst = false;
        afterBranch := skipTrivia(source, cursor, prefix);
        if not textLib.wordAt(source, afterBranch, "else") {
            var end := afterBranch;
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            statementNext := if matched { consumeStatementEnd(source, end, prefix) } else { -1 };
            if statementNext < 0 {
                failAt(source, afterBranch, prefix, "value if requires a final else");
            }
            listLib.pushBack(mut result, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            listLib.pushBack(mut result, (kind = "End", name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
            return result;
        }
        afterElse := skipTrivia(source, afterBranch + 4, prefix);
        rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
        if not textLib.wordAt(source, afterElse, "if") {
            return [];
        }
        cursor = skipTrivia(source, afterElse + 2, prefix);
    }
    []
}

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>): Parsed {
    var inner := skipTrivia(source, position, prefix);
    var parenCount := 0;
    loop inner < textLib.length(source) and textLib.at(source, inner) == "(" {
        parenCount = parenCount + 1;
        inner = skipTrivia(source, inner + 1, prefix);
    }
    ifKwPos := skipOptionalScanTag(source, inner, prefix, "if");
    if ifKwPos >= 0 and textLib.wordAt(source, ifKwPos, "if") {
        scannedEnd := scanIfChainEnd(source, inner, prefix, false, true);
        if scannedEnd >= 0 {
            var end := skipTrivia(source, scannedEnd, prefix);
            var remaining := parenCount;
            var matched := true;
            loop remaining > 0 {
                if end >= textLib.length(source) or textLib.at(source, end) =!= ")" {
                    matched = false;
                    break;
                }
                end = skipTrivia(source, end + 1, prefix);
                remaining = remaining - 1;
            }
            if matched and consumeStatementEnd(source, end, prefix) >= 0 {
                parsed := parseBinaryCtx(target, source, inner, prefix, locals, functions, params, currentName, expected, -1, ctxs, 0, false, "");
                return (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
                    textValue = parsed.textValue, constant = parsed.constant, next = end);
            }
        }
    }
    parseExpressionAsCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs)
}

/**
 * True when the innermost block expects a value tail: a function body or one of
 * the value-if branches that complete one.
 */
atValueTail := fn(blocks: List<String>, blockCount: Int): Bool {
    if blockCount <= 0 { return false; }
    kind := blocks[blockCount - 1];
    kind == "function" or kind == "ifvalue" or kind == "matchvalue" or kind == "matchelseval" or kind == "matchsingleval"
}

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool {
    loop blocks as kind {
        if kind == "loop" { return true; }
    }
    false
}

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>): (next: Int, returned: Bool, code: String, valueKind: String) {
    var isTailClose := false;
    if valueTail {
        end := scanExpressionItemEnd(source, position, prefix);
        nextCheck := skipItemSeparators(source, end, prefix);
        isTailClose = nextCheck < textLib.length(source) and textLib.at(source, nextCheck) == "}";
    }
    expected := if isTailClose {
        if isListKind(currentResult) { "Tail" + currentResult } else { currentResult }
    } else {
        ""
    };
    trimmedStart := skipTrivia(source, position, prefix);
    stmtSink := if trimmedStart < textLib.length(source) and textLib.at(source, trimmedStart) == "{" { "exprOut" } else { "" };
    stmtMin := if not isTailClose or currentResult == "Unit" { -2 } else { 0 };
    parsed := parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, stmtMin, ctxs, 0, false, stmtSink);
    ended := consumeStatementEnd(source, parsed.next, prefix);
    if ended < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after expression statement"); }
    next := skipItemSeparators(source, ended, prefix);
    returned := currentName =!= "" and valueTail and next < textLib.length(source) and textLib.at(source, next) == "}";
    if returned and not isCompatibleKind(currentResult, parsed.kind) {
        failAt(source, position, prefix, "cannot return " + displayKind(parsed.kind) + " from function " + currentName +
            " returning " + displayKind(currentResult));
    }
    (next = next, returned = returned, code = if returned { if parsed.kind == "Unit" { targetUnitEvaluationCode(target, parsed.code) } else { assignValueCode(target, currentResult, parsed.kind, parsed.code) } } else { parsed.code }, valueKind = parsed.kind)
}

/** Finds later root scalar definitions for deferred function-body name resolution; eager root expressions never receive this table. */
collectFutureValues := fn(target: String, source: String, prefix: String, moduleKey: String): List<FutureValue> {
    values: mut List<FutureValue> = [];
    size := textLib.length(source);
    var cursor := 0;
    var braceDepth := 0;
    loop cursor < size {
        ch := textLib.at(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if ch == "/" and textLib.startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "{" {
            braceDepth = braceDepth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            if braceDepth > 0 { braceDepth = braceDepth - 1; }
            cursor = cursor + 1;
        } else if braceDepth == 0 and textLib.isNameStart(ch) {
            nameStart := cursor;
            nameEnd := textLib.skipName(source, cursor);
            afterName := skipTrivia(source, nameEnd, prefix);
            if textLib.startsWithAt(source, afterName, ":=") {
                valueStart := skipTrivia(source, afterName + 2, prefix);
                if not textLib.wordAt(source, valueStart, "fn") and not textLib.wordAt(source, valueStart, "type") {
                    valueCh := textLib.at(source, valueStart);
                    var kind := "";
                    var intValue := 0;
                    var textValue := "";
                    if textLib.isDigit(valueCh) or valueCh == "+" or valueCh == "-" {
                        parsed := parseNumber(target, source, valueStart, prefix, "", 0);
                        kind = parsed.kind;
                        intValue = parsed.intValue;
                    } else if valueCh == "\"" {
                        parsed := parseText(target, source, valueStart, prefix);
                        kind = parsed.kind;
                        textValue = parsed.textValue;
                    } else if textLib.wordAt(source, valueStart, "true") or textLib.wordAt(source, valueStart, "false") {
                        kind = "Bool";
                        intValue = if textLib.wordAt(source, valueStart, "true") { 1 } else { 0 };
                    }
                    if kind =!= "" {
                        valueName := textLib.slice(source, nameStart, nameEnd);
                        futureRuntime := moduleValueRuntime(target, moduleKey, valueName);
                        listLib.pushBack(mut values, (name = valueName, runtime = futureRuntime,
                            kind = kind, at = nameStart, intValue = intValue, textValue = textValue));
                    }
                }
                cursor = valueStart;
            } else {
                cursor = nameEnd;
            }
        } else {
            cursor = cursor + 1;
        }
    }
    values
}

/** Removes deferred-only entries after one function body has been checked. */
withoutFutureValues := fn(locals: List<Local>): List<Local> {
    kept: mut List<Local> = [];
    loop locals as entry {
        if entry.depth >= 0 { listLib.pushBack(mut kept, entry); }
    }
    kept
}

/** Parses one top-level aliased import and returns its next source position. */
parseImportClause := fn(target: String, source: String, position: Int, alias: String, prefix: String): Item {
    if alias == "" { failAt(source, position, prefix, "import requires a module alias"); }
    pathStart := skipTrivia(source, position + 6, prefix);
    if pathStart >= textLib.length(source) or textLib.at(source, pathStart) =!= "\"" {
        failAt(source, pathStart, prefix, "import requires a quoted source path");
    }
    path := parseText(target, source, pathStart, prefix);
    pathLength := textLib.length(path.textValue);
    var invalidPath := pathLength == 0;
    var pathIndex := 0;
    loop pathIndex < pathLength {
        if textLib.at(path.textValue, pathIndex) == "\\" { invalidPath = true; }
        pathIndex = pathIndex + 1;
    }
    if invalidPath {
        failAt(source, pathStart, prefix, "import path must be nonempty and use \"/\" separators");
    }
    statementNext := consumeStatementEnd(source, path.next, prefix);
    if statementNext < 0 {
        failAt(source, skipTrivia(source, path.next, prefix), prefix, "expected ; after import");
    }
    (kind = "Import", name = alias, runtime = "", code = "", intValue = statementNext, textValue = path.textValue)
}

/** Collects top-level import clauses before parsing so imported declarations can seed the importing file's symbol table. */
pub collectImportClauses := fn(target: String, source: String, prefix: String): Items {
    imports: mut Items = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.isNameStart(ch) {
            nameEnd := textLib.skipName(source, position);
            name := textLib.slice(source, position, nameEnd);
            if name == "import" {
                imported := parseImportClause(target, source, position, "", prefix);
                listLib.pushBack(mut imports, imported);
                position = imported.intValue;
            } else {
                afterName := skipTrivia(source, nameEnd, prefix);
                afterDeclare := skipTrivia(source, afterName + 2, prefix);
                if textLib.startsWithAt(source, afterName, ":=") and textLib.wordAt(source, afterDeclare, "import") {
                    imported := parseImportClause(target, source, afterDeclare, name, prefix);
                    listLib.pushBack(mut imports, imported);
                    position = imported.intValue;
                } else {
                    position = nameEnd;
                }
            }
        } else {
            position = position + 1;
        }
    }
    imports
}

/** Collects function names explicitly marked `pub`. */
collectPublishedFunctions := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                value := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and textLib.wordAt(source, value, "fn") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Collects immutable value names explicitly marked `pub`; imported type aliases remain pending. */
collectPublishedValues := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                value := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and
                    not textLib.wordAt(source, value, "fn") and not textLib.wordAt(source, value, "type") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Collects top-level transparent type aliases explicitly marked `pub`. */
collectPublishedTypes := fn(source: String, prefix: String): List<String> {
    names: mut List<String> = [];
    size := textLib.length(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textLib.at(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and textLib.wordAt(source, position, "pub") {
            declarationStart := skipTrivia(source, position + 3, prefix);
            if declarationStart < size and textLib.isNameStart(textLib.at(source, declarationStart)) {
                nameEnd := textLib.skipName(source, declarationStart);
                operator := skipTrivia(source, nameEnd, prefix);
                typeStart := skipTrivia(source, operator + 2, prefix);
                if textLib.startsWithAt(source, operator, ":=") and textLib.wordAt(source, typeStart, "type") {
                    listLib.pushBack(mut names, textLib.slice(source, declarationStart, nameEnd));
                }
                position = nameEnd;
            } else {
                position = position + 3;
            }
        } else {
            position = position + 1;
        }
    }
    names
}

/** Parses one legacy or imported output statement into the same ordered argument group and ending marker. */
parseOutputStatement := fn(target: String, source: String, openPosition: Int, outputName: String, prefix: String,
    locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
    live: Bool, ctxs: List<ConstructCtx>): Items {
    var position := openPosition;
    if position >= textLib.length(source) or textLib.at(source, position) =!= "(" {
        failAt(source, position, prefix, "expected ( after " + outputName);
    }
    position = skipTrivia(source, position + 1, prefix);
    result: mut List<Item> = [];
    loop position < textLib.length(source) and textLib.at(source, position) =!= ")" {
        argument := parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs);
        listLib.pushBack(mut result, (kind = argument.kind, name = "", runtime = "", code = argument.code,
            intValue = argument.intValue, textValue = argument.textValue));
        position = skipTrivia(source, argument.next, prefix);
        if position < textLib.length(source) and textLib.at(source, position) == "," {
            position = skipTrivia(source, position + 1, prefix);
        } else {
            break;
        }
    }
    position = expectSymbol(source, position, ")", prefix);
    statementNext := consumeStatementEnd(source, position, prefix);
    if statementNext < 0 { failAt(source, skipTrivia(source, position, prefix), prefix, "expected ; after " + outputName); }
    listLib.pushBack(mut result, (kind = if outputName == "outputLine" { "End" } else { "EndOutput" },
        name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
    result
}

/** Parses complete source with imported public function signatures available in its root symbol table. Exits 2 on unsupported, malformed or faulting source. */
pub parseProgramWithModule := fn(target: String, source: String, prefix: String, exports: Items, moduleKey: String,
    moduleIdentity: String): Items {
    size := textLib.length(source);
    var position := skipTrivia(source, 0, prefix);
    var items: mut Items = [];
    if position == size { return items; }
    aliases: mut List<AliasDecl> = [];
    loop exports as exported {
        if exported.kind == "PublicType" {
            listLib.pushBack(mut aliases, (name = exported.name, target = exported.code, at = -1, end = 0));
        }
    }
    loop collectAliases(source, prefix) as alias { listLib.pushBack(mut aliases, alias); }
    publishedFunctions := collectPublishedFunctions(source, prefix);
    publishedValues := collectPublishedValues(source, prefix);
    publishedTypes := collectPublishedTypes(source, prefix);
    futureValues := collectFutureValues(target, source, prefix, moduleKey);
    var locals: mut List<Local> = [];
    blocks: mut List<String> = [];
    functions: mut List<FunctionInfo> = [];
    functionParams: mut List<String> = [];
    declaredImportAliases: mut List<String> = [];
    var parameterTotal := 0;
    loop exports as exported {
        if exported.kind == "ModuleAlias" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported module name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = "", kind = "Module", mutable = false,
                writable = false, depth = 0, constant = false, code = "", intValue = exported.intValue,
                textValue = exported.name, initState = "init"));
        } else if exported.kind == "PublicFunction" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            first := parameterTotal;
            var entryStart := 0;
            var entryIndex := 0;
            loop entryIndex < exported.intValue {
                separator := textLib.indexOfText(exported.textValue, "|", entryStart);
                var entryEnd := textLib.length(exported.textValue);
                if separator >= 0 { entryEnd = separator; }
                listLib.pushBack(mut functionParams, textLib.slice(exported.textValue, entryStart, entryEnd));
                parameterTotal = parameterTotal + 1;
                entryStart = entryEnd + 1;
                entryIndex = entryIndex + 1;
            }
            listLib.pushBack(mut functions, (name = exported.name, runtime = exported.runtime, result = exported.code,
                first = first, count = exported.intValue));
        } else if exported.kind == "PublicValue" {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            listLib.pushBack(mut locals, (name = exported.name, runtime = exported.runtime, kind = exported.code,
                mutable = false, writable = false, depth = 0, constant = false, code = exported.runtime,
                intValue = 0, textValue = "", initState = "init"));
        } else if exported.kind == "PublicType" {
            if findAlias(aliases, exported.name) < 0 {
                diagLib.fail(prefix, "unknown imported public type " + exported.name);
            }
        }
    }
    var blockCount := 0;
    var depth := 0;
    var currentName := "";
    var currentResult := "";
    var currentReturned := false;
    var currentStopped := false;
    var branchesReturned := true;
    var branchesStopped := true;
    var hasElse := false;
    var loopForever := false;
    var currentLive := true;
    var liveBranchCount := 0;
    savedStates: mut List<BlockState> = [];
    var branchUpdates: mut List<BranchUpdate> = [];
    var stmtCtxs: mut List<ConstructCtx> = [];
    var nextStmtCtxId := 1;
    transferCodes: mut List<String> = [];
    var transferCount := 0;
    var fnTryKey := "";
    var fnTransferStart := 0;
    loopIds: mut List<Int> = [];
    loopTryKeys: mut List<String> = [];
    loopTransferStarts: mut List<Int> = [];
    loop position < size {
        ch := textLib.at(source, position);
        if ch == ";" {
            position = skipItemSeparators(source, position, prefix);
            continue;
        }
        if ch == "}" {
            if blockCount == 0 {
                failAt(source, position, prefix, "unexpected }");
            }
            blockKind := blocks[blockCount - 1];
            if (blockKind == "ifvalue" or blockKind == "matchvalue" or blockKind == "matchelseval" or blockKind == "matchsingleval") and
                currentResult =!= "Unit" and not currentReturned {
                failAt(source, position, prefix, "branch of function " + currentName + " must return " + displayKind(currentResult));
            }
            after := skipTrivia(source, position + 1, prefix);
            if (blockKind == "if" or blockKind == "ifvalue") and after < size and textLib.wordAt(source, after, "else") {
                locals = visibleLocals(locals, depth);
                var stateCount := 0;
                loop savedStates { stateCount += 1; }
                branchPreLen := savedStates[stateCount - 1].preLocalsLen;
                if currentLive and not currentStopped {
                    nextBranchUpdates := recordBranchUpdates(locals, branchPreLen, depth - 1, blockCount, branchUpdates);
                    branchUpdates = [];
                    loop nextBranchUpdates as u { listLib.pushBack(mut branchUpdates, u); }
                    liveBranchCount = liveBranchCount + 1;
                }
                nextLocals := truncateLocals(locals, branchPreLen);
                locals = [];
                loop nextLocals as l { listLib.pushBack(mut locals, l); }
                afterElse := skipTrivia(source, after + 4, prefix);
                rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                branchesReturned = branchesReturned and currentReturned;
                branchesStopped = branchesStopped and currentStopped;
                currentReturned = false;
                currentStopped = false;
                hasElse = not textLib.wordAt(source, afterElse, "if");
                droppedIf := listLib.popBack(mut blocks);
                blockCount = blockCount - 1;
                if textLib.wordAt(source, afterElse, "if") {
                    conditionStart := skipTrivia(source, afterElse + 2, prefix);
                    rejectHeaderBlockTag(source, conditionStart, prefix, "else if");
                    condition := parseExpressionCtx(target, source, conditionStart, prefix, locals, functions, functionParams, currentName, stmtCtxs);
                    if condition.kind =!= "Bool" {
                        failAt(source, conditionStart, prefix, "else if condition must be Bool");
                    }
                    conditionCode := if condition.constant {
                        targetBoolLiteralCode(target, condition.intValue =!= 0)
                    } else {
                        condition.code
                    };
                    beforeOpen := skipTrivia(source, condition.next, prefix);
                    rejectMisplacedTag(source, beforeOpen, prefix, "block tag cannot appear before { in else if");
                    position = expectSymbol(source, beforeOpen, "{", prefix);
                    if currentLive {
                        listLib.pushBack(mut items, (kind = "ElseIf", name = "", runtime = "", code = conditionCode,
                            intValue = 0, textValue = ""));
                        if codeHasRawTransfer(conditionCode) {
                            listLib.pushBack(mut transferCodes, conditionCode);
                            transferCount = transferCount + 1;
                        }
                    }
                    listLib.pushBack(mut blocks, blockKind);
                    blockCount = blockCount + 1;
                } else {
                    if currentLive { listLib.pushBack(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, if blockKind == "ifvalue" { "ifvalue" } else { "else" });
                    blockCount = blockCount + 1;
                    position = expectSymbol(source, afterElse, "{", prefix);
                }
                position = skipTrivia(source, position, prefix);
                continue;
            }
            if blockKind == "match" or blockKind == "matchvalue" {
                nextArmStart := skipItemSeparators(source, position + 1, prefix);
                if nextArmStart >= size {
                    failAt(source, position + 1, prefix, "expected } to close match");
                }
                if textLib.at(source, nextArmStart) == "}" {
                    failAt(source, nextArmStart, prefix, "subjectless match requires a final _ fallback arm");
                }
                locals = visibleLocals(locals, depth);
                var stateCount := 0;
                loop savedStates { stateCount += 1; }
                branchPreLen := savedStates[stateCount - 1].preLocalsLen;
                if currentLive and not currentStopped {
                    nextBranchUpdates := recordBranchUpdates(locals, branchPreLen, depth - 1, blockCount, branchUpdates);
                    branchUpdates = [];
                    loop nextBranchUpdates as u { listLib.pushBack(mut branchUpdates, u); }
                    liveBranchCount = liveBranchCount + 1;
                }
                nextLocals := truncateLocals(locals, branchPreLen);
                locals = [];
                loop nextLocals as l { listLib.pushBack(mut locals, l); }
                branchesReturned = branchesReturned and currentReturned;
                branchesStopped = branchesStopped and currentStopped;
                currentReturned = false;
                currentStopped = false;
                droppedMatch := listLib.popBack(mut blocks);
                blockCount = blockCount - 1;
                afterUnderscore := skipTrivia(source, nextArmStart + 1, prefix);
                if textLib.wordAt(source, nextArmStart, "_") {
                    rejectMisplacedTag(source, afterUnderscore, prefix, "block tag cannot appear after _ in match arm");
                }
                isFallback := textLib.wordAt(source, nextArmStart, "_") and afterUnderscore < size and
                    textLib.at(source, afterUnderscore) == "{";
                var armOpen := -1;
                if isFallback {
                    armOpen = afterUnderscore;
                    hasElse = true;
                    if currentLive { listLib.pushBack(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                    listLib.pushBack(mut blocks, if blockKind == "matchvalue" { "matchelseval" } else { "matchelse" });
                    blockCount = blockCount + 1;
                } else {
                    armOpen = scanConditionOpen(source, nextArmStart, prefix);
                    if armOpen < 0 {
                        failAt(source, nextArmStart, prefix, "expected { after match arm condition");
                    }
                    if armOpen == nextArmStart {
                        failAt(source, nextArmStart, prefix, "match arm header requires grouping for { ... } expressions");
                    }
                    rejectHeaderBlockTag(source, nextArmStart, prefix, "match arm");
                    condition := parseExpressionCtx(target, source, nextArmStart, prefix, locals, functions, functionParams, currentName, stmtCtxs);
                    afterCond := skipTrivia(source, condition.next, prefix);
                    rejectMisplacedTag(source, afterCond, prefix, "block tag cannot appear before { in match arm");
                    if afterCond > armOpen {
                        failAt(source, armOpen, prefix, "ungrouped { in match arm header starts the arm body; parenthesize block or conditional expressions");
                    }
                    if afterCond =!= armOpen {
                        _ := expectSymbol(source, afterCond, "{", prefix);
                    }
                    if condition.kind =!= "Bool" {
                        failAt(source, nextArmStart, prefix, "match arm condition must be Bool");
                    }
                    conditionCode := if condition.constant {
                        targetBoolLiteralCode(target, condition.intValue =!= 0)
                    } else {
                        condition.code
                    };
                    if currentLive {
                        listLib.pushBack(mut items, (kind = "ElseIf", name = "", runtime = "", code = conditionCode,
                            intValue = 0, textValue = ""));
                        if codeHasRawTransfer(conditionCode) {
                            listLib.pushBack(mut transferCodes, conditionCode);
                            transferCount = transferCount + 1;
                        }
                    }
                    listLib.pushBack(mut blocks, blockKind);
                    blockCount = blockCount + 1;
                }
                position = skipTrivia(source, armOpen + 1, prefix);
                continue;
            }
            var closeBracePos := position;
            if blockKind == "matchelse" or blockKind == "matchelseval" or blockKind == "matchsingle" or blockKind == "matchsingleval" {
                afterFallback := skipItemSeparators(source, position + 1, prefix);
                if afterFallback >= size {
                    failAt(source, position + 1, prefix, "expected } to close match");
                }
                if textLib.at(source, afterFallback) =!= "}" {
                    failAt(source, afterFallback, prefix, "match fallback _ must be the final arm");
                }
                closeBracePos = afterFallback;
            }
            locals = visibleLocals(locals, depth);
            depth = depth - 1;
            if blockKind == "function" {
                locals = withoutFutureValues(locals);
                if currentResult =!= "Unit" and not currentReturned {
                    failAt(source, position, prefix, "function " + currentName + " must return " + currentResult);
                }
                droppedFnCtx := listLib.popBack(mut stmtCtxs);
                if fnTryKey =!= "" {
                    var hasFnTransfer := false;
                    var fnTi := fnTransferStart;
                    loop fnTi < transferCount {
                        if codeUsesTextCall(transferCodes[fnTi], "lite$throwTransfer(0,") {
                            hasFnTransfer = true;
                            break;
                        }
                        fnTi = fnTi + 1;
                    }
                    if hasFnTransfer and currentLive {
                        listLib.pushBack(mut items, (kind = "TransferCatch", name = "", runtime = fnTryKey, code = currentResult, intValue = 0, textValue = ""));
                    }
                    fnTryKey = "";
                }
                functionRuntime := moduleFunctionRuntime(target, moduleKey, currentName);
                if currentLive { listLib.pushBack(mut items, (kind = "FunctionEnd", name = "", runtime = functionRuntime,
                    code = "", intValue = 0, textValue = "")); }
                currentName = "";
                currentResult = "";
                currentReturned = false;
            } else if blockKind == "loop" {
                loopId := listLib.popBack(mut loopIds);
                loopTryKey := listLib.popBack(mut loopTryKeys);
                loopStartTransfers := listLib.popBack(mut loopTransferStarts);
                droppedLoopCtx := listLib.popBack(mut stmtCtxs);
                if loopTryKey =!= "" {
                    var hasLoopBreak := false;
                    var hasLoopCont := false;
                    if transferCount > loopStartTransfers {
                        brkNeedle := "lite$throwTransfer(" + integer.intText(loopId) + ",";
                        contNeedle := "lite$throwTransfer(" + integer.intText(0 - loopId) + ",";
                        var lpTi := loopStartTransfers;
                        loop lpTi < transferCount {
                            tCode := transferCodes[lpTi];
                            if not hasLoopBreak and codeUsesTextCall(tCode, brkNeedle) { hasLoopBreak = true; }
                            if not hasLoopCont and codeUsesTextCall(tCode, contNeedle) { hasLoopCont = true; }
                            if hasLoopBreak and hasLoopCont { break; }
                            lpTi = lpTi + 1;
                        }
                    }
                    if (hasLoopBreak or hasLoopCont) and currentLive {
                        listLib.pushBack(mut items, (kind = "LoopTransferCatch", name = "", runtime = loopTryKey, code = integer.intText(loopId),
                            intValue = loopId, textValue = integer.intText(0 - loopId)));
                    }
                    if hasLoopBreak {
                        currentReturned = false;
                        currentStopped = false;
                    }
                }
                if currentLive { listLib.pushBack(mut items, (kind = "EndLoop", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else if blockKind == "scope" {
                if currentLive { listLib.pushBack(mut items, (kind = "EndScope", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else if blockKind == "matchsingle" or blockKind == "matchsingleval" {
                droppedCondCtx := listLib.popBack(mut stmtCtxs);
                if currentLive { listLib.pushBack(mut items, (kind = "EndScope", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else {
                droppedCondCtx := listLib.popBack(mut stmtCtxs);
                if currentLive { listLib.pushBack(mut items, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            }
            completedReturn := blockCompletion(blockKind, currentReturned, branchesReturned, hasElse, loopForever);
            completedStop := blockCompletion(blockKind, if blockKind == "loop" { currentReturned } else { currentStopped },
                branchesStopped, hasElse, loopForever);
            if blockKind == "loop" and completedReturn and currentLive {
                listLib.pushBack(mut items, (kind = "Unreachable", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            }
            parent := listLib.popBack(mut savedStates);
            if blockKind == "if" or blockKind == "ifvalue" or blockKind == "else" or blockKind == "matchelse" or blockKind == "matchelseval" {
                if currentLive and not currentStopped {
                    nextBranchUpdates := recordBranchUpdates(locals, parent.preLocalsLen, depth, blockCount, branchUpdates);
                    branchUpdates = [];
                    loop nextBranchUpdates as u { listLib.pushBack(mut branchUpdates, u); }
                    liveBranchCount = liveBranchCount + 1;
                }
                truncated := truncateLocals(locals, parent.preLocalsLen);
                joinedLocals := joinBranchLocals(truncated, parent.preLocalsLen, blockCount, hasElse or blockKind == "else", liveBranchCount, branchUpdates);
                keptUpdates := popBranchUpdates(branchUpdates, blockCount);
                locals = [];
                loop joinedLocals as l { listLib.pushBack(mut locals, l); }
                branchUpdates = [];
                loop keptUpdates as u { listLib.pushBack(mut branchUpdates, u); }
            } else if blockKind == "loop" {
                loopJoined := joinLoopUpdates(locals, parent.preLocalsLen, depth);
                locals = [];
                loop loopJoined as l { listLib.pushBack(mut locals, l); }
            }
            liveBranchCount = parent.liveBranchCount;
            currentReturned = parent.returned or (not parent.stopped and completedReturn and blockKind =!= "function");
            currentStopped = parent.stopped or (completedStop and blockKind =!= "function");
            branchesReturned = parent.branchesReturned;
            branchesStopped = parent.branchesStopped;
            hasElse = parent.hasElse;
            loopForever = parent.loopForever;
            currentLive = parent.live;
            droppedBlock := listLib.popBack(mut blocks);
            blockCount = blockCount - 1;
            position = skipTrivia(source, closeBracePos + 1, prefix);
            if position < size and textLib.at(source, position) == ";" {
                position = skipTrivia(source, position + 1, prefix);
            }
            continue;
        }
        if ch == "{" {
            rawBraceEnd := scanBraceEnd(source, position, prefix);
            afterRawBrace := if rawBraceEnd >= 0 { skipTrivia(source, rawBraceEnd, prefix) } else { -1 };
            if afterRawBrace >= 0 and textLib.wordAt(source, afterRawBrace, "then") {
                failAt(source, afterRawBrace, prefix, "then requires an if, match, or loop");
            }
            if afterRawBrace >= 0 and textLib.wordAt(source, afterRawBrace, "finally") {
