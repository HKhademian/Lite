                        if not hasFnProp and types.isResultKind(currentResult) and codeUsesTextCall(tCode, "lite$throwProp(") {
                            hasFnProp = true;
                        }
                        if hasFnTransfer and (hasFnProp or not types.isResultKind(currentResult)) { break; }
                        fnTi = fnTi + 1;
                    }
                    if (hasFnTransfer or hasFnProp) and currentLive {
                        catchMode := if hasFnTransfer and hasFnProp { "both" } else if hasFnProp { "prop" } else { "" };
                        mut items.pushBack((kind = ITEM_KIND_TRANSFER_CATCH, name = catchMode, runtime = fnTryKey, code = currentResult, intValue = 0, textValue = ""));
                    }
                    fnTryKey = "";
                }
                if currentFnCtxKind =!= "" {
                    itemEnd := items.length();
                    loop contexts.parseCtxKindSlots(currentFnCtxKind) as ucs {
                        if not ucs.name.startsWithAt(0, "_") {
                            slotNeedle := if target == TARGET_C { "lite_ctx->slot_" + ir.safeTargetIdent(TARGET_C, ucs.name) } else { "lite$ctx." + ucs.name };
                            if not itemSpanUsesSlot(items, currentFnItemStart, itemEnd, slotNeedle) {
                                failAt(source, if currentFnDeclAt >= 0 { currentFnDeclAt } else { position }, prefix, "unused context slot '" + ucs.name + "' in function " + currentName + " (prefix with '_' to ignore)");
                            }
                        }
                    }
                }
                functionRuntime := if currentFnRuntime =!= "" { currentFnRuntime } else { moduleFunctionRuntime(target, moduleKey, currentName) };
                if currentLive { mut items.pushBack((kind = ITEM_KIND_FUNCTION_END, name = "", runtime = functionRuntime,
                    code = "", intValue = 0, textValue = "")); }
                currentName = "";
                currentFnRuntime = "";
                currentResult = "";
                currentFnDeclAt = -1;
                currentFnItemStart = 0;
                currentFnCtxKind = "";
                currentReturned = false;
            } else if blockKind == BLOCK_KIND_LOOP {
                loopId := mut loopIds.popBack();
                loopTryKey := mut loopTryKeys.popBack();
                loopStartTransfers := mut loopTransferStarts.popBack();
                droppedLoopCtx := mut stmtCtxs.popBack();
                if loopTryKey =!= "" {
                    var hasLoopBreak := false;
                    var hasLoopCont := false;
                    if transferCount > loopStartTransfers {
                        brkNeedle := "lite$throwTransfer(" + loopId.toText() + ",";
                        contNeedle := "lite$throwTransfer(" + (0 - loopId).toText() + ",";
                        var lpTi := loopStartTransfers;
                        loop lpTi < transferCount {
                            tCode := transferCodes[lpTi];
                            if not hasLoopBreak and codeUsesTextCall(tCode, brkNeedle) { hasLoopBreak = true; }
                            if not hasLoopCont and codeUsesTextCall(tCode, contNeedle) { hasLoopCont = true; }
                            if hasLoopBreak and hasLoopCont { break; }
                            lpTi = lpTi + 1;
                        }
                    }
                    if (hasLoopBreak or hasLoopCont) and currentLive {
                        mut items.pushBack((kind = ITEM_KIND_LOOP_TRANSFER_CATCH, name = "", runtime = loopTryKey, code = loopId.toText(),
                        intValue = loopId, textValue = (0 - loopId).toText()));
                    }
                    if hasLoopBreak {
                        currentReturned = false;
                        currentStopped = false;
                    }
                }
                if currentLive { mut items.pushBack((kind = ITEM_KIND_END_LOOP, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else if blockKind == BLOCK_KIND_SCOPE {
                if currentLive { mut items.pushBack((kind = ITEM_KIND_END_SCOPE, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else if blockKind == BLOCK_KIND_MATCH_SINGLE or blockKind == BLOCK_KIND_MATCH_SINGLE_VALUE or blockKind == BLOCK_KIND_COMPTIME_IF or blockKind == BLOCK_KIND_COMPTIME_IF_VALUE or blockKind == BLOCK_KIND_COMPTIME_MATCH or blockKind == BLOCK_KIND_COMPTIME_MATCH_VALUE {
                droppedCondCtx := mut stmtCtxs.popBack();
                if currentLive { mut items.pushBack((kind = ITEM_KIND_END_SCOPE, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            } else {
                droppedCondCtx := mut stmtCtxs.popBack();
                if currentLive { mut items.pushBack((kind = ITEM_KIND_END_IF, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
            }
            completedReturn := blockCompletion(blockKind, currentReturned, branchesReturned, hasElse, loopForever);
            completedStop := blockCompletion(blockKind, if blockKind == BLOCK_KIND_LOOP { currentReturned } else { currentStopped },
            branchesStopped, hasElse, loopForever);
            if blockKind == BLOCK_KIND_LOOP and completedReturn and currentLive {
                mut items.pushBack((kind = ITEM_KIND_UNREACHABLE, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            }
            parent := mut savedStates.popBack();
            if blockKind == BLOCK_KIND_IF or blockKind == BLOCK_KIND_IF_VALUE or blockKind == BLOCK_KIND_ELSE or blockKind == BLOCK_KIND_MATCH_ELSE or blockKind == BLOCK_KIND_MATCH_ELSE_VALUE {
                hasPredEnd := branchPredStack.length() > 0 and branchPredStack[branchPredStack.length() - 1].depth == blockCount - 1;
                var endPredRt := "";
                var endPredNeg := false;
                var endPredConds := 0;
                var endB1Live := false;
                var endB2Live := false;
                var endFalseFacts := "";
                if hasPredEnd {
                    ep := mut branchPredStack.popBack();
                    endPredRt = ep.predRt;
                    endPredNeg = ep.negated;
                    endPredConds = ep.condCount;
                    endB1Live = ep.b1Live;
                    endFalseFacts = ep.falseFacts;
                }
                endArmNum := if hasPredEnd and endPredConds == 1 {
                    if blockKind == BLOCK_KIND_ELSE { 2 } else { 1 }
                } else { 0 };
                if currentLive and not currentStopped {
                    branchUpdates = recordBranchUpdatesForArm(locals, parent.preLocalsLen, depth, blockCount, endArmNum, branchUpdates);
                    liveBranchCount = liveBranchCount + 1;
                    if endArmNum == 1 { endB1Live = true; }
                    else if endArmNum == 2 { endB2Live = true; }
                }
                truncated := truncateLocals(locals, parent.preLocalsLen);
                locals = joinBranchLocalsWithPred(truncated, parent.preLocalsLen, blockCount, hasElse or blockKind == BLOCK_KIND_ELSE, liveBranchCount, branchUpdates, endPredRt, endPredNeg, endPredConds, endB1Live, endB2Live);
                if (not hasElse) and blockKind == BLOCK_KIND_IF and currentStopped and endFalseFacts =!= "" {
                    locals = expr.applyUnionNarrowing(target, locals, endFalseFacts);
                }
                branchUpdates = popBranchUpdates(branchUpdates, blockCount);
            } else if blockKind == BLOCK_KIND_LOOP {
                locals = joinLoopUpdates(locals, parent.preLocalsLen, depth);
            } else if blockKind == BLOCK_KIND_FUNCTION {
                locals = truncateLocals(locals, parent.preLocalsLen);
            }
            liveBranchCount = parent.liveBranchCount;
            currentReturned = parent.returned or (not parent.stopped and completedReturn and blockKind =!= BLOCK_KIND_FUNCTION);
            currentStopped = parent.stopped or (completedStop and blockKind =!= BLOCK_KIND_FUNCTION);
            branchesReturned = parent.branchesReturned;
            branchesStopped = parent.branchesStopped;
            hasElse = parent.hasElse;
            loopForever = parent.loopForever;
            currentLive = parent.live;
            droppedBlock := mut blocks.popBack();
            blockCount = blockCount - 1;
            if monoInstIdx >= 0 and blockCount == 0 { break; }
            position = skipTrivia(source, nextAfterBlock, prefix);
            if position < size and source.at(position) == ";" {
                position = skipTrivia(source, position + 1, prefix);
            }
            continue;
        }
        if position > locCursor {
            loop locCursor < position {
                if source.at(locCursor) == "\n" {
                    locLine = locLine + 1;
                    locLineStart = locCursor + 1;
                }
                locCursor = locCursor + 1;
            }
        }
        if currentLive and rootCommentIdx < rootCommentCount {
            loop rootCommentIdx < rootCommentCount and rootComments[rootCommentIdx].endPos <= position {
                rc := rootComments[rootCommentIdx];
                mut items.pushBack((kind = ITEM_KIND_COMMENT, name = prefix, runtime = "", code = rc.text, intValue = if rc.isDoc { 1 } else { 0 }, textValue = ""));
                rootCommentIdx = rootCommentIdx + 1;
            }
        }
        if currentLive and locLine =!= lastEmittedLocLine {
            lastEmittedLocLine = locLine;
            locCol := (position - locLineStart) + 1;
            mut items.pushBack((kind = ITEM_KIND_SOURCE_LOC, name = prefix, runtime = "", code = locCol.toText(), intValue = locLine, textValue = ""));
        }
        if ch == "{" {
            rawBraceEnd := scanBraceEnd(source, position, prefix);
            afterRawBrace := if rawBraceEnd >= 0 { skipTrivia(source, rawBraceEnd, prefix) } else { -1 };
            if afterRawBrace >= 0 and source.startsWithAt(afterRawBrace, ":=") {
                /* Fall through to unified record destructuring below (`recDestructureOpen`). */
            } else {
                if isLtModule and blockCount == 0 {
                    failAt(source, position, prefix, "top-level runtime block is not allowed in .lt module");
                }
                if afterRawBrace >= 0 and source.wordAt(afterRawBrace, "then") {
                    failAt(source, afterRawBrace, prefix, "then requires an if, match, or loop");
                }
                if afterRawBrace >= 0 and source.wordAt(afterRawBrace, "finally") {
                    expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
                    currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs, aliases);
                    locals = checkStatementTrace(target, source, position, prefix, expression.code, expression.returned, currentResult,
                    currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
                    if currentLive and not currentStopped {
                        mut items.pushBack((kind = expressionStatementKind(expression.valueKind, expression.returned, ITEM_KIND_DISCARD, currentResult), name = expression.valueKind,
                        runtime = "", code = expression.code, intValue = 0, textValue = ""));
                        if codeHasRawTransfer(expression.code) {
                            mut transferCodes.pushBack(expression.code);
                            transferCount = transferCount + 1;
                        }
                    }
                    if expression.returned or expression.valueKind == VALUE_KIND_NEVER {
                        if not currentStopped { currentReturned = true; }
                        currentStopped = true;
                    }
                    position = expression.next;
                    continue;
                }
                if currentLive and not currentStopped { mut items.pushBack((kind = ITEM_KIND_SCOPE, name = "", runtime = "", code = "", intValue = 0, textValue = "")); }
                (mut savedStates).pushBack((returned = currentReturned, stopped = currentStopped,
                branchesReturned = branchesReturned, branchesStopped = branchesStopped, hasElse = hasElse, loopForever = loopForever, live = currentLive,
                preLocalsLen = localsCount(locals), liveBranchCount = liveBranchCount));
                liveBranchCount = 0;
                currentLive = currentLive and not currentStopped;
                currentReturned = false;
                currentStopped = false;
                branchesReturned = true;
                branchesStopped = true;
                hasElse = false;
                loopForever = false;
                mut blocks.pushBack(BLOCK_KIND_SCOPE);
                blockCount = blockCount + 1;
                depth = depth + 1;
                if hasInnerAlias { aliases = collectBlockTypeAliases(source, position, prefix, depth, aliases); }
                if hasInnerFn and blockHasInnerFn(source, position, prefix) >= 0 {
                    scopeAssignedBag := scanInnerBlockAssignedBag(target, source, position, prefix, "");
                    blockAssignedDecls = appendAssignedBagDecls(scopeAssignedBag, blockAssignedDecls, depth);
                    locals = appendBlockFutureLocals(target, source, position, prefix, depth, "", scopeAssignedBag, aliases, functions, functionParams, locals);
                }
                position = skipTrivia(source, position + 1, prefix);
                continue;
            }
        }
        scanDestr := expr.scanDestructureStart(source, position, size, prefix);
        destructureOpen := scanDestr.openPos;
        destructureMutable := scanDestr.isMutable;
        if destructureOpen >= 0 {
            destructure := expr.parseAggregatePattern(source, destructureOpen, prefix, aliases);
            afterTarget := skipTrivia(source, destructure.next, prefix);
            if not source.startsWithAt(afterTarget, ":=") {
                failAt(source, afterTarget, prefix, "expected := after " + destructure.shape + " destructuring target");
            }
            rhs := parseInitializerExpression(target, source, skipTrivia(source, afterTarget + 2, prefix), prefix, locals, functions, functionParams, currentName, "", stmtCtxs, aliases);
            if target == TARGET_TS and currentLive and not currentStopped {
                checkTraceSafety(source, destructureOpen, prefix, rhs.code, currentName, maxFutureAt, locals, functions, futureValues, items);
                locals = mergeOuterCallableUpdatesFromCode(locals, rhs.code);
            }
            if destructure.shape == "tuple" and destructure.count == 0 {
                if destructureMutable {
                    failAt(source, destructureOpen, prefix, "var tuple destructuring needs at least one binding");
                }
                if isTupleKind(rhs.kind) {
                    failAt(source, destructureOpen, prefix, "tuple destructuring expected 0 fields, got " + tupleComponentCount(rhs.kind).toText());
                }
                if rhs.kind =!= VALUE_KIND_UNIT {
                    failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + displayKind(rhs.kind));
                }
                statementNext := consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                position = statementNext;
                if currentLive and not currentStopped {
                    mut items.pushBack((kind = ITEM_KIND_DISCARD, name = VALUE_KIND_UNIT, runtime = "",
                    code = rhs.code, intValue = 0, textValue = ""));
                    if codeHasRawTransfer(rhs.code) {
                        mut transferCodes.pushBack(rhs.code);
                        transferCount = transferCount + 1;
                    }
                }
                continue;
            }
            if destructure.grouped {
                bindPart := types.decodeLengthPrefixedAt(destructure.encodedClauses, 0);
                bindName := bindPart.text;
                rejectNonValueBinding(source, destructureOpen, prefix, rhs.kind, bindName);
                var groupedBindKind := rhs.kind;
                if destructure.groupedType =!= "" {
                    if not isCompatibleKind(destructure.groupedType, rhs.kind) {
                        failAt(source, destructureOpen, prefix, "cannot bind " + displayKind(rhs.kind) + " to " + displayKind(destructure.groupedType));
                    }
                    groupedBindKind = destructure.groupedType;
                }
                statementNext := consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                position = statementNext;
                groupedSliceWritable := if types.isSliceKind(groupedBindKind) {
                    destructureMutable or sliceBorrows.sliceExprIsMutable(rhs.textValue)
                } else {
                    destructureMutable
                };
                groupedBorrow := sliceBorrows.borrowTagForBinding(groupedBindKind, groupedSliceWritable, rhs.textValue);
                if not groupedBorrow.ok { failAt(source, destructureOpen, prefix, groupedBorrow.error); }
                rejectDuplicateBlockDecl(source, destructureOpen, prefix, blockDecls, depth, bindName);
                mut blockDecls.pushBack((name = bindName, depth = depth));
                bindRuntime := claimOrMakeLocalRuntime(target, locals, bindName, moduleKey, depth);
                bindFnCode := if target == TARGET_TS and containsFnKind(groupedBindKind) { computeCallableRhsDeps(rhs.code) } else { rhs.code };
                mut locals.pushBack((name = bindName, runtime = bindRuntime, kind = groupedBindKind,
                mutable = destructureMutable, writable = if types.isSliceKind(groupedBindKind) { groupedSliceWritable } else { false }, depth = depth, constant = false, code = bindFnCode,
                intValue = rhs.intValue, textValue = groupedBorrow.textValue, initState = INIT_STATE_INIT));
                if currentLive and not currentStopped {
                    itemPrefix := if destructureMutable { ITEM_PREFIX_VAR } else { ITEM_PREFIX_LOCAL };
                    destrCode := assignValueCode(target, groupedBindKind, rhs.kind, rhs.code);
                    mut items.pushBack((kind = itemPrefix + storageKind(groupedBindKind), name = bindName, runtime = bindRuntime,
                    code = destrCode, intValue = rhs.intValue, textValue = storageTextPayload(groupedBindKind, rhs.textValue)));
                    if codeHasRawTransfer(destrCode) {
                        mut transferCodes.pushBack(destrCode);
                        transferCount = transferCount + 1;
                    }
                }
                continue;
            }
            tempPrefix := if destructure.shape == "record" { "lite$rec" } else if destructure.shape == "array" { "lite$arr" } else { "lite$tuple" };
            tempSlot := if destructure.shape == "record" { "$rec" } else if destructure.shape == "array" { "$arr" } else { "$tuple" };
            tempItemKind := if destructure.shape == "record" { ITEM_KIND_LOCAL_RECORD } else if destructure.shape == "array" { ITEM_KIND_LOCAL_LIST } else { ITEM_KIND_LOCAL_TUPLE };
            tempRuntime := freshScopeTemp(locals, tempPrefix);
            resolvedBindings := expr.resolveAggregateBindings(target, destructure.shape, destructure.count, destructure.encodedClauses, rhs.kind, tempRuntime, source, destructureOpen, prefix);
            statementNext := consumeStatementEnd(source, rhs.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + destructure.shape + " destructuring"); }
            position = statementNext;
            rhsProvKind := sliceBorrows.provenanceKind(rhs.textValue);
            isSplitTuple := (rhsProvKind == "mut_split" or rhsProvKind == "ro_split") and destructure.shape == "tuple" and destructure.count == 2;
            aggCode := if target == TARGET_TS and containsFnKind(rhs.kind) { computeCallableRhsDeps(rhs.code) } else { "" };
            mut locals.pushBack((name = tempSlot, runtime = tempRuntime, kind = VALUE_KIND_UNIT,
            mutable = false, writable = false, depth = depth, constant = false, code = aggCode,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if currentLive and not currentStopped {
                mut items.pushBack((kind = tempItemKind, name = "", runtime = tempRuntime,
                code = rhs.code, intValue = 0, textValue = storageTextPayload(rhs.kind, "")));
                if codeHasRawTransfer(rhs.code) {
                    mut transferCodes.pushBack(rhs.code);
                    transferCount = transferCount + 1;
                }
            }
            mut pendingDestrNames: List<String> = [];
            var bCursor := 0;
            var bIndex := 0;
            loop bIndex < destructure.count {
                bindPart := types.decodeLengthPrefixedAt(resolvedBindings, bCursor);
                propPart := types.decodeLengthPrefixedAt(resolvedBindings, bindPart.next);
                srcPart := types.decodeLengthPrefixedAt(resolvedBindings, propPart.next);
                tgtPart := types.decodeLengthPrefixedAt(resolvedBindings, srcPart.next);
                bCursor = tgtPart.next;
                bindName := bindPart.text;
                propExpr := propPart.text;
                srcKind := srcPart.text;
                bindKind := tgtPart.text;
                if not (destructure.shape == "record" and bindName == "_") {
                    rejectDuplicateBlockDecl(source, destructureOpen, prefix, blockDecls, depth, bindName);
                    if depth == 0 {
                        mut blockDecls.pushBack((name = bindName, depth = depth));
                    } else if not pendingDestrNames.contains(bindName) {
                        mut pendingDestrNames.pushBack(bindName);
                    }
                    bindRuntime := claimOrMakeLocalRuntime(target, locals, bindName, moduleKey, depth);
                    fieldCode := assignValueCode(target, bindKind, srcKind, propExpr);
                    fieldLocalCode := if target == TARGET_TS and containsFnKind(bindKind) { computeCallableRhsDeps(fieldCode) } else { fieldCode };
                    fieldWritable := if isSplitTuple { rhsProvKind == "mut_split" } else { false };
                    fieldText := if isSplitTuple { sliceBorrows.splitHalfProvenance(rhs.textValue, destructureOpen, bIndex == 0) } else { "" };
                    mut locals.pushBack((name = bindName, runtime = bindRuntime, kind = bindKind,
                    mutable = destructureMutable, writable = fieldWritable, depth = depth, constant = false, code = fieldLocalCode,
                    intValue = 0, textValue = fieldText, initState = INIT_STATE_INIT));
                    if currentLive and not currentStopped {
                        itemPrefix := if destructureMutable { ITEM_PREFIX_VAR } else { ITEM_PREFIX_LOCAL };
                        mut items.pushBack((kind = itemPrefix + storageKind(bindKind), name = bindName, runtime = bindRuntime,
                        code = fieldCode, intValue = 0, textValue = storageTextPayload(bindKind, "")));
                    }
                }
                bIndex = bIndex + 1;
            }
            loop pendingDestrNames as destrName {
                mut blockDecls.pushBack((name = destrName, depth = depth));
            }
            continue;
        }
        if ch.isDigit() or ch == "\"" or ch == "(" or ch == "[" or ch == "+" or ch == "-" or ch == "." or
        (ch == "a" and source.wordAt(position, "and")) or (ch == "o" and source.wordAt(position, "or")) or
        (ch == "n" and source.wordAt(position, "not")) or (ch == "t" and source.wordAt(position, "true")) or
        (ch == "f" and source.wordAt(position, "false")) {
            if isLtModule and blockCount == 0 {
                failAt(source, position, prefix, "top-level runtime statement is not allowed in .lt module");
            }
            expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
            currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs, aliases);
            locals = checkStatementTrace(target, source, position, prefix, expression.code, expression.returned, currentResult, currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
            if currentLive and not currentStopped {
                mut items.pushBack((kind = expressionStatementKind(expression.valueKind, expression.returned, ITEM_KIND_DISCARD, currentResult), name = expression.valueKind,
                runtime = "", code = expression.code, intValue = 0, textValue = ""));
                if codeHasRawTransfer(expression.code) {
                    mut transferCodes.pushBack(expression.code);
                    transferCount = transferCount + 1;
                }
            }
            if expression.returned or expression.valueKind == VALUE_KIND_NEVER {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            position = expression.next;
            continue;
        }
        if ch == "#" {
            leadAttr := types.parseTypeLayoutAttrs(source, position, prefix);
            if not leadAttr.ok {
                failAt(source, leadAttr.errPos, prefix, leadAttr.errMsg);
            }
            failAt(source, position, prefix, "layout attributes go after record/enum (for example 'record #packed { ... }' or 'enum #no_niche { ... }')");
        }
        if ch == "@" {
            tagInfo := parseTagAt(source, position, prefix);
            afterTag := skipTrivia(source, tagInfo.next, prefix);
            if afterTag >= size or (source.at(afterTag) =!= "{" and source.at(afterTag) =!= "." and
            not source.wordAt(afterTag, "do") and not source.wordAt(afterTag, "if") and
            not source.wordAt(afterTag, "match") and not source.wordAt(afterTag, "loop")) {
                if tagInfo.tag == "packed" or tagInfo.tag == "align" or tagInfo.tag == "no_niche" {
                    failAt(source, position, prefix, "leading @" + tagInfo.tag + " is no longer supported; write 'record #" + tagInfo.tag + " { ... }' or 'enum #" + tagInfo.tag + " { ... }' instead");
                }
                failAt(source, afterTag, prefix, "expected {, do, if, match, loop or . after block tag @" + tagInfo.tag);
            }
            if isLtModule and blockCount == 0 {
                failAt(source, position, prefix, "top-level runtime statement is not allowed in .lt module");
            }
            expression := parseExpressionItem(target, source, position, prefix, locals, functions, functionParams, currentName,
            currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs, aliases);
            locals = checkStatementTrace(target, source, position, prefix, expression.code, expression.returned, currentResult, currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
            if currentLive and not currentStopped {
                mut items.pushBack((kind = expressionStatementKind(expression.valueKind, expression.returned, ITEM_KIND_DISCARD, currentResult), name = expression.valueKind,
                runtime = "", code = expression.code, intValue = 0, textValue = ""));
                if codeHasRawTransfer(expression.code) {
                    mut transferCodes.pushBack(expression.code);
                    transferCount = transferCount + 1;
                }
            }
            if expression.returned or expression.valueKind == VALUE_KIND_NEVER {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            position = expression.next;
            continue;
        }
        if inImplBlock and blockCount == 0 {
            if not ch.isNameStart() {
                failAt(source, position, prefix, "expected method declaration or } inside impl block");
            }
            peekEnd := source.skipName(position);
            peekName := source.slice(position, peekEnd);
            var isImplAssoc := false;
            loop implAssocBindings as iab {
                if iab.name == peekName { isImplAssoc = true; break; }
            }
            if isImplAssoc {
                var sk := skipTrivia(source, peekEnd, prefix);
                var pDepth := 0;
                var bDepth := 0;
                var brDepth := 0;
                loop sk < size {
                    sc := source.at(sk);
                    if sc == "\"" { sk = skipAliasString(source, sk); continue; }
                    if sc == "(" { pDepth = pDepth + 1; }
                    else if sc == ")" and pDepth > 0 { pDepth = pDepth - 1; }
                    else if sc == "[" { bDepth = bDepth + 1; }
                    else if sc == "]" and bDepth > 0 { bDepth = bDepth - 1; }
                    else if sc == "{" { brDepth = brDepth + 1; }
                    else if sc == "}" and brDepth > 0 { brDepth = brDepth - 1; }
                    else if sc == ";" and pDepth == 0 and bDepth == 0 and brDepth == 0 {
                        sk = sk + 1;
                        break;
                    }
                    sk = sk + 1;
                }
                position = skipTrivia(source, sk, prefix);
                continue;
            }
            if implMethodNextIdx >= implMethodFnKeys.length() {
                failAt(source, position, prefix, "unexpected extra statement inside impl block");
            }
            mIdx := implMethodNextIdx;
            implMethodNextIdx = implMethodNextIdx + 1;
            mFnKey := implMethodFnKeys[mIdx];
