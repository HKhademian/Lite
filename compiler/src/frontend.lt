                mut items.pushBack((kind = ITEM_KIND_PUBLIC_IMPL, name = impParsed.implKey, runtime = impParsed.implKey,
                code = "", intValue = 0, textValue = interfaces.encodeImplMeta(impParsed.implDef)));
