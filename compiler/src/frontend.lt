                        }
                        sigKey := overloads.overloadSigKey(true, header.genericType, header.params, header.count);
                        existingCands := sym.findFunctions(functions, fnName);
                        var dupSig := false;
                        loop existingCands as eci {
                            if overloads.fnSigKeyFor(functions[eci].runtime) == sigKey { dupSig = true; break; }
