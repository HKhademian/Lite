            impParsed := parseImplHeaderAndValidate(source, implStart, afterImplKw, prefix, aliases, moduleKey, moduleIdentity, isPubPreImpl, functions, functionParams);
            interfaces.registerImpl(impParsed.implDef);
            if impParsed.methodNames.length() > 0 {
                var mi := 0;
                loop mi < impParsed.methodNames.length() {
                    mFnKey := impParsed.methodFnKeys[mi];
                    mName := impParsed.methodNames[mi];
                    mParams := impParsed.methodParams[mi];
                    mCount := impParsed.methodParamCounts[mi];
                    mResult := impParsed.methodResults[mi];
                    mGen := impParsed.methodGenerics[mi];
                    mDeclAt := impParsed.methodDeclAts[mi];
                    mSrc := impParsed.methodSources[mi];
                    mPref := impParsed.methodPrefixes[mi];
                    mIsDef := impParsed.methodIsDefault[mi];
                    var mRuntime := "";
                    if mGen =!= "" {
                        tplKey := moduleKey + "#" + mFnKey;
                        mRuntime = "$gen:" + tplKey;
                        generics.registerTemplate((
                            key = tplKey, qualName = "impl$" + mDeclAt.toText() + "$" + mName, typeOpKey = mFnKey,
                            moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                            prefix = mPref, source = mSrc,
                            bodyStart = impParsed.methodBodyStarts[mi], bodyEnd = impParsed.methodBodyEnds[mi], declAt = mDeclAt,
                            genericParams = mGen, params = mParams,
                            paramCount = mCount, result = mResult,
                            selfTarget = "$Kind:" + impParsed.targetKind, isPub = isPubPreImpl
