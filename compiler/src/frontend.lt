            locals = checkStatementTrace(target, source, position, prefix, expression.code, expression.returned, currentResult, currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
            if currentLive and not currentStopped {
                mut items.pushBack((kind = expressionStatementKind(expression.valueKind, expression.returned, ITEM_KIND_DISCARD, currentResult), name = expression.valueKind,
                runtime = "", code = expression.code, intValue = 0, textValue = ""));
                if codeHasRawTransfer(expression.code) {
