                                key = tplKey, qualName = "impl$" + mDeclAt.toText() + "$" + mName, typeOpKey = mFnKey,
                                moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                                prefix = mPref, source = mSrc,
                                bodyStart = impParsed.methodBodyStarts[mi], bodyEnd = impParsed.methodBodyEnds[mi], declAt = mDeclAt,
                                genericParams = "", params = mParams,
                                paramCount = mCount, result = mResult,
                                selfTarget = "$Kind:" + impParsed.targetKind, isPub = isPubPreImpl
                            ));
