                                comptimeEval.registerFnDef(hostRuntime, fnName, moduleKey, moduleIdentity, source, prefix, fnAt, afterHdr, header.params, header.count, header.result, true, aliases);
                                contexts.registerFnContext(hostRuntime, contexts.extractCtxKindFromParams(header.params));
                                overloads.registerFnSig(hostRuntime, sigKey, header.genericType, header.params);
                                mut functions.pushBack((name = fnName, runtime = hostRuntime, result = header.result,
                                first = parameterTotal, count = header.count, declAt = fnAt));
                                loop splitPipeEntries(header.params, header.count) as hp {
                                    mut functionParams.pushBack(hp);
                                    parameterTotal = parameterTotal + 1;
                                }
                            }
                        } else if not dupSig and header.count >= 0 and afterHdr < size and source.at(afterHdr) == "{" {
                            var fnRuntime := moduleFunctionRuntime(target, moduleKey, fnName + ovSuffix);
                            bodyEndFuture := skipBraceBlock(source, afterHdr + 1, prefix);
                            if header.genericType =!= "" {
                                tplKey := moduleKey + "#" + fnName + ovSuffix;
                                fnRuntime = "$gen:" + tplKey;
                                generics.registerTemplate((
                                    key = tplKey, qualName = fnName + ovSuffix, typeOpKey = "",
                                    moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                                    prefix = prefix, source = source,
                                    bodyStart = afterHdr + 1, bodyEnd = bodyEndFuture, declAt = fnAt,
                                    genericParams = header.genericType, params = header.params,
                                    paramCount = header.count, result = header.result,
                                    selfTarget = "", isPub = publishedFnAts.has(fnAt)
                                ));
                            }
                            comptimeEval.registerFnDef(fnRuntime, fnName, moduleKey, moduleIdentity, source, prefix, afterHdr + 1, bodyEndFuture - 1, header.params, header.count, header.result, false, aliases);
                            contexts.registerFnContext(fnRuntime, contexts.extractCtxKindFromParams(header.params));
                            overloads.registerFnSig(fnRuntime, sigKey, header.genericType, header.params);
                            (mut functions).pushBack((name = fnName, runtime = fnRuntime, result = header.result,
                            first = parameterTotal, count = header.count, declAt = fnAt));
                            loop splitPipeEntries(header.params, header.count) as hp {
                                mut functionParams.pushBack(hp);
                                parameterTotal = parameterTotal + 1;
                            }
                        }
                    }
                }
            }
        } else if decl.kind == DECL_KIND_FUTURE_TYPE_OP {
            qualName := decl.name;
            dotPos := qualName.indexOf(".", 0);
            if dotPos > 0 {
                tName := qualName.slice(0, dotPos);
                oName := qualName.slice(dotPos + 1, qualName.length());
                opAt := decl.intValue;
                owner := resolveOwnedTypeOpTarget(source, opAt, prefix, aliases, moduleIdentity, tName);
                if owner.ok {
                    headerPos := parseDigits(decl.textValue, 0, decl.textValue.length());
                    scopedSelf := types.withSelfAlias(aliases, owner.selfTarget, 0);
                    if canPreParseFunctionHeader(source, headerPos, prefix, scopedSelf, false) {
                        header := types.parseTypeOpHeader(source, headerPos, prefix, aliases, tName, oName, owner.selfTarget, owner.ownerKey, owner.isGenericOwner);
                        if types.containsSliceKind(header.result) and not isCoreSliceHostModule(moduleIdentity) {
                            failAt(source, opAt, prefix, "borrowed Slice<T> cannot escape via function return type");
                        }
                        if types.containsDynKind(header.result) {
                            failAt(source, opAt, prefix, "borrowed dyn Interface cannot escape via function return type");
                        }
                        typeOpKey := (if header.hasSelfRecv { "$typeop:" } else { "$statictypeop:" }) + owner.ownerKey + "." + oName;
                        sigKey := overloads.overloadSigKey(not header.hasSelfRecv, header.genericType, header.params, header.count);
                        existingOpCands := sym.findFunctions(functions, typeOpKey);
                        var dupOpSig := false;
                        loop existingOpCands as eoi {
                            if overloads.fnSigKeyFor(functions[eoi].runtime) == sigKey { dupOpSig = true; break; }
                        }
