                            var fnRuntime := moduleFunctionRuntime(target, moduleKey, qualName + ovSuffix);
                            opBodyEndFuture := skipBraceBlock(source, afterHdr + 1, prefix);
                            if header.genericType =!= "" {
                                tplKey := moduleKey + "#" + qualName + ovSuffix;
                                fnRuntime = "$gen:" + tplKey;
                                generics.registerTemplate((
                                    key = tplKey, qualName = qualName + ovSuffix, typeOpKey = typeOpKey,
                                    moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                                    prefix = prefix, source = source,
                                    bodyStart = afterHdr + 1, bodyEnd = opBodyEndFuture, declAt = opAt,
                                    genericParams = header.genericType, params = header.params,
                                    paramCount = header.count, result = header.result,
                                    selfTarget = owner.selfTarget, isPub = publishedTypeOpAts.has(opAt)
                                ));
                            }
                            comptimeEval.registerFnDef(fnRuntime, qualName, moduleKey, moduleIdentity, source, prefix, afterHdr + 1, opBodyEndFuture - 1, header.params, header.count, header.result, false, aliases);
                            contexts.registerFnContext(fnRuntime, contexts.extractCtxKindFromParams(header.params));
                            overloads.registerFnSig(fnRuntime, sigKey, header.genericType, header.params);
                            (mut functions).pushBack((name = typeOpKey, runtime = fnRuntime, result = header.result,
                            first = parameterTotal, count = header.count, declAt = opAt));
                            loop splitPipeEntries(header.params, header.count) as hp {
                                mut functionParams.pushBack(hp);
                                parameterTotal = parameterTotal + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    var aliasPass := 0;
    loop aliasPass < 16 {
        var aliasProgress := false;
        loop decls as decl {
            if decl.kind == DECL_KIND_ALIAS and decl.intValue >= 0 {
                aAt := decl.intValue;
                aAfterNm := source.skipName(aAt);
                aOpPos := skipTrivia(source, aAfterNm, prefix);
                if source.startsWithAt(aOpPos, ":=") {
                    aTypePos := skipTrivia(source, aOpPos + 2, prefix);
