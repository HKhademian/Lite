joinBranchLocals := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>): List<Local> { ctx.joinBranchLocals(locals, preLen, blockDepth, hasElse, liveBranchCount, updates) };
