/** Shared restricted front-end. */

/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntScalarKind := fn(kind: String): Bool { ir.isIntScalarKind(kind) }

/** True when `kind` is one of the binary float scalar types (`Float32`, `Float`). */
pub isFloatScalarKind := fn(kind: String): Bool { ir.isFloatScalarKind(kind) }

/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := alias (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements. */
Local := alias (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);
/** One program or module-graph item. */
pub Item := alias (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Parsed module/compiler items returned by parseProgram and consumed by the module collector and backend emitters. */
pub Items := alias List<Item>;
/** Completion facts saved while an inner block is parsed. */
BlockState := alias (returned: Bool, stopped: Bool, branchesReturned: Bool, branchesStopped: Bool, hasElse: Bool, loopForever: Bool, live: Bool, preLocalsLen: Int, liveBranchCount: Int);
/** Symbol declaration name owned directly by the block at `depth` for same-block uniqueness checks. */
BlockDecl := alias (name: String, depth: Int);
/** One outer local initialization and callable-dependency update recorded at the end of a conditional branch. */
BranchUpdate := alias (depth: Int, arm: Int, runtime: String, initState: String, code: String);
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := alias (text: String, width: Int);
/** One previously declared top-level function. */
FunctionInfo := alias (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);
/** A later top-level scalar definition visible only while checking a deferred function body. */
FutureValue := alias (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);
/** One transparent type alias. */
AliasDecl := alias (name: String, target: String, at: Int, end: Int, depth: Int);
/** Lexical control-flow and metadata context for an enclosing construct. */
ConstructCtx := alias (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool, colVar: String);
/** Hash-indexed string set for O(1) reachable-token membership checks across large module graphs. */
pub TokenBuckets := alias Set<String>;

