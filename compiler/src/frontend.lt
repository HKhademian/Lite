/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs, aliases)
};

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    expr.parseExpression(target, source, position, prefix, locals, functions, params, currentName)
};

/** Parses `--builtin-mode` specification strings passed down from the compiler entrypoint. */
pub parseBuiltinModeSpecs := fn(prefix: String, specs: List<String>): Items { builtinsAbi.parseBuiltinModeSpecs(prefix, specs) };

/** Resolves effective builtin mode (`builtin` or `pure`) by precedence: function > module > project > default builtin. */
pub resolveBuiltinMode := fn(rules: Items, moduleName: String, fnName: String): String { builtinsAbi.resolveBuiltinMode(rules, moduleName, fnName) };

/** Collapses a numeric scalar, tuple or list kind to its canonical item suffix (`Int`, `Float`, `Tuple`, `List`) while leaving other scalar kinds unchanged. */
storageKind := fn(kind: String): String { ctx.storageKind(kind) };

/** Returns the text payload for a storage item with explicit declared kind `kind`, falling back to `fallback`. */
storageTextPayload := fn(kind: String, fallback: String): String { ctx.storageTextPayload(kind, fallback) };

/** Returns the text payload stored with one local item: the canonical List/Array/Fn kind for List/Array/Fn items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String { ctx.itemTextPayload(parsed) };

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    expr.parsePartialAssignIf(target, source, position, prefix, locals, functions, params, currentName, targetAt, targetKind, targetName, targetRuntime, ctxs, aliases)
};

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseInitializerExpression(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** True when the innermost block expects a value tail: a function body or one of the value-if branches that complete one. */
atValueTail := fn(blocks: List<String>, blockCount: Int): Bool { ctx.atValueTail(blocks, blockCount) };

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool { ctx.insideLoop(blocks) };

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): (next: Int, returned: Bool, code: String, valueKind: String) {
    expr.parseExpressionItem(target, source, position, prefix, locals, functions, params, currentName, currentResult, valueTail, ctxs, aliases)
};

/** Collects aliases, `pub` declarations, inner-alias hints, root functions, root values, and root assignments in a single pass over module source. */
/** Resolves `typeName` as an owned nominal type declaration in the current module (or a verified core built-in owner). Rejects transparent aliases and foreign types. */
resolveOwnedTypeOpTarget := fn(source: String, nameStart: Int, prefix: String, aliases: List<AliasDecl>, moduleIdentity: String, typeName: String): (ok: Bool, ownerKind: String, ownerKey: String, selfTarget: String, isGenericOwner: Bool, error: String) {
    coreOwner := types.coreBuiltinOwnerType(moduleIdentity, typeName);
    if coreOwner =!= "" {
        isGen := types.isGenericCoreOwner(coreOwner);
        selfT := if isGen { "$Family:" + coreOwner } else { coreOwner };
        return (ok = true, ownerKind = coreOwner, ownerKey = coreOwner, selfTarget = selfT, isGenericOwner = isGen, error = "");
    }
    var foundIdx := -1;
    var i := 0;
    loop aliases as a {
        if a.name == typeName and a.depth == 0 {
            foundIdx = i;
        }
        i = i + 1;
    }
    if foundIdx < 0 {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to unknown or foreign type " + typeName + "; operations may only be attached in the owning module of a record, enum, or built-in type");
    }
    entry := aliases[foundIdx];
    if entry.at >= 0 and entry.target.startsWithAt(0, "@genraw:") {
        pDec := types.decodeLengthPrefixedAt(entry.target, 8);
        innerRaw := if pDec.next >= 0 { entry.target.slice(pDec.next, entry.target.length()) } else { "" };
        if not innerRaw.startsWithAt(0, "@recraw:") and not innerRaw.startsWithAt(0, "@enumraw:") and not innerRaw.startsWithAt(0, "@distraw:") {
            return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
            error = "cannot attach operation to alias or foreign type " + typeName + "; operations may only be attached to an owned record, enum, distinct, or built-in type");
        }
        emptySeen: List<String> = [];
        resolvedParams := types.resolveComptimeParamSpecs(source, nameStart, prefix, aliases, pDec.text);
        tplKind := types.resolveGenericTypeText(source, nameStart, prefix, aliases, innerRaw, resolvedParams, emptySeen);
        ownerKey := types.typeOpOwnerKey(tplKind);
        if ownerKey == "" {
            return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
            error = "cannot attach operation to non-nominal type " + typeName);
        }
        selfTarget := "@gentpl:" + types.encodeLengthPrefixedText(resolvedParams) + tplKind;
        return (ok = true, ownerKind = tplKind, ownerKey = ownerKey, selfTarget = selfTarget, isGenericOwner = true, error = "");
    }
    if entry.at < 0 or (not entry.target.startsWithAt(0, "@recraw:") and not entry.target.startsWithAt(0, "@enumraw:") and not entry.target.startsWithAt(0, "@distraw:")) {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to alias or foreign type " + typeName + "; operations may only be attached to an owned record, enum, distinct, or built-in type");
    }
    emptySeen: List<String> = [];
    ownerKind := resolveTypeText(source, nameStart, prefix, aliases, entry.target, emptySeen);
    ownerKey := types.typeOpOwnerKey(ownerKind);
    if ownerKey == "" {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to non-nominal type " + typeName);
    }
    (ok = true, ownerKind = ownerKind, ownerKey = ownerKey, selfTarget = ownerKind, isGenericOwner = false, error = "")
};

/** Parses and registers one `<Name> := interface[<TypeParams>] { ... }` definition. */
parseInterfaceDefAt := fn(source: String, nameStart: Int, afterInterfaceKw: Int, prefix: String,
aliases: List<AliasDecl>, moduleKey: String, name: String): (def: interfaces.InterfaceDef, resolvedCode: String, afterEnd: Int) {
    size := source.length();
    gp := types.scanComptimeTypeParams(source, afterInterfaceKw, prefix);
    if not gp.ok {
        failAt(source, gp.errPos, prefix, gp.errMsg);
    }
    genericParams := if gp.hasParams {
        types.resolveComptimeParamSpecs(source, afterInterfaceKw, prefix, aliases, gp.paramsCsv)
    } else {
        ""
    };
    ifaceKey := moduleKey + "#" + name;
    resolvedCode := if gp.hasParams {
        "@gentpl:" + types.encodeLengthPrefixedText(genericParams) + "Iface<" + ifaceKey + ";" + types.splitCommaNames(genericParams).join(",") + ">"
    } else {
        "Iface<" + ifaceKey + ">"
    };
    selfIfaceKind := if gp.hasParams {
        "Iface<" + ifaceKey + ";" + types.splitCommaNames(genericParams).join(",") + ">"
    } else {
        "Iface<" + ifaceKey + ">"
    };
    var cursor := skipTrivia(source, gp.next, prefix);
    cursor = expectSymbol(source, cursor, "{", prefix);
    mut scopedAliases: List<AliasDecl> = types.withSelfAlias(aliases, "$Kind:Self", 0);
    mut assocTypes: List<interfaces.InterfaceAssocType> = [];
    mut methods: List<interfaces.InterfaceMethod> = [];
    mut seenMemberNames: Set<String>;
    var isObjectSafe := true;
    var unsafeReason := "";
    loop true {
        cursor = skipTrivia(source, cursor, prefix);
        loop cursor < size and source.at(cursor) == ";" {
            cursor = skipTrivia(source, cursor + 1, prefix);
        }
        if cursor >= size {
            failAt(source, cursor, prefix, "expected } to close interface " + name);
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        if not source.at(cursor).isNameStart() {
            failAt(source, cursor, prefix, "expected method or associated type name in interface " + name);
        }
        mStart := cursor;
        mEnd := source.skipName(mStart);
        mName := source.slice(mStart, mEnd);
        if isReservedWord(mName) { unsupportedFeature(source, mStart, mName, prefix); }
        if seenMemberNames.has(mName) {
            failAt(source, mStart, prefix, "duplicate member " + mName + " in interface " + name);
        }
        mut seenMemberNames.add(mName);
        cursor = skipTrivia(source, mEnd, prefix);
        usedAssignOp := source.startsWithAt(cursor, ":=");
        if usedAssignOp {
            cursor = skipTrivia(source, cursor + 2, prefix);
        } else {
            cursor = expectSymbol(source, cursor, ":", prefix);
            cursor = skipTrivia(source, cursor, prefix);
        }
        if source.wordAt(cursor, "Type") {
            if usedAssignOp {
                failAt(source, cursor, prefix, "associated type " + name + "." + mName + " must use ':', not ':='");
            }
            cursor = skipTrivia(source, cursor + 4, prefix);
            var boundKind := "";
            if cursor < size and source.at(cursor) == "<" {
                cursor = skipTrivia(source, cursor + 1, prefix);
                mut bMembers: List<String> = [];
                loop true {
                    if cursor >= size or source.at(cursor) == ">" {
                        failAt(source, cursor, prefix, "expected constraint inside Type<...> for " + name + "." + mName);
                    }
                    bParsed := types.parseTypeWithSeen(source, cursor, true, source, cursor, prefix, scopedAliases, "constraint", genericParams, []);
                    mut bMembers.pushBack(bParsed.kind);
                    cursor = skipTrivia(source, bParsed.next, prefix);
                    if cursor < size and source.at(cursor) == "," {
                        cursor = skipTrivia(source, cursor + 1, prefix);
                        if cursor < size and source.at(cursor) == ">" { break; }
                    } else {
                        break;
                    }
                }
                cursor = expectSymbol(source, cursor, ">", prefix);
                cursor = skipTrivia(source, cursor, prefix);
                boundKind = if bMembers.length() == 1 { bMembers[0] } else { "All<" + bMembers.join(",") + ">" };
            }
            var defaultKind := "";
            if cursor < size and isSingleEquals(source, cursor) {
                defPos := skipTrivia(source, cursor + 1, prefix);
                defParsed := types.parseFunctionType(source, defPos, prefix, scopedAliases, genericParams);
                if boundKind =!= "" and not types.kindHasAnyGenericParam(genericParams + ",Self", defParsed.kind) and
                not types.kindHasAnyGenericParam(genericParams + ",Self", boundKind) {
                    if not types.typeSatisfiesConstraint(defParsed.kind, boundKind) {
                        failAt(source, defPos, prefix, "default type for " + name + "." + mName + " does not satisfy bound " + displayKind(boundKind));
                    }
                }
                defaultKind = defParsed.kind;
                cursor = skipTrivia(source, defParsed.next, prefix);
            }
            if cursor < size and source.at(cursor) == ";" {
                cursor = skipTrivia(source, cursor + 1, prefix);
            }
            mut assocTypes.pushBack(interfaces.InterfaceAssocType {
                name = mName,
                bound = boundKind,
                defaultKind = defaultKind
            });
            mut scopedAliases.pushBack((name = "$self_assoc:" + mName,
            target = "$Kind:$Assoc<Self;" + selfIfaceKind + ";" + mName + ">",
            at = mStart, end = cursor, depth = 0));
            if isObjectSafe {
                isObjectSafe = false;
                unsafeReason = "interface declares associated type " + mName;
            }
            continue;
        }
        if not source.wordAt(cursor, "fn") {
            failAt(source, cursor, prefix, "expected fn signature for interface method " + name + "." + mName);
        }
        cursor = skipTrivia(source, cursor + 2, prefix);
        if cursor < size and source.at(cursor) == "<" {
            failAt(source, cursor, prefix, "generic method type parameters on interface method " + name + "." + mName + " are not supported");
        }
        cursor = expectSymbol(source, cursor, "(", prefix);
        cursor = skipTrivia(source, cursor, prefix);
        mut pNames: List<String> = [];
        var mut nonRecvParams: List<String> = [];
        var pCount := 0;
        var recvMut := false;
        var hasValidRecv := false;
        if cursor < size and source.at(cursor) =!= ")" {
            loop true {
                if cursor >= size or not source.at(cursor).isNameStart() {
                    failAt(source, cursor, prefix, "expected parameter in interface method " + name + "." + mName);
                }
                pStart := cursor;
                pEnd := source.skipName(pStart);
                pWord := source.slice(pStart, pEnd);
                afterPWord := skipTrivia(source, pEnd, prefix);
                var pName := "";
                var pAccess := "";
                var pTypeStart := -1;
                if afterPWord < size and source.at(afterPWord) == ":" {
                    pName = pWord;
                    if isReservedWord(pName) { unsupportedFeature(source, pStart, pName, prefix); }
                    if pNames.contains(pName) {
                        failAt(source, pStart, prefix, "duplicate parameter " + pName + " in interface method " + name + "." + mName);
                    }
                    cursor = skipTrivia(source, afterPWord + 1, prefix);
                    if source.wordAt(cursor, "mut") {
                        pAccess = "mut ";
                        cursor = skipTrivia(source, cursor + 3, prefix);
                    }
                    pTypeStart = cursor;
                } else {
                    pName = "arg" + pCount.toText();
                    if pWord == "mut" {
                        pAccess = "mut ";
                        cursor = skipTrivia(source, afterPWord, prefix);
                        pTypeStart = cursor;
                    } else {
                        pTypeStart = pStart;
                    }
                }
                mut pNames.pushBack(pName);
                pTypeParsed := types.parseFunctionType(source, pTypeStart, prefix, scopedAliases, genericParams);
                if pCount == 0 {
                    if pTypeParsed.kind =!= "Self" {
                        failAt(source, pTypeStart, prefix, "interface method " + name + "." + mName + " first parameter must have type Self or mut Self");
                    }
                    recvMut = pAccess == "mut ";
                    hasValidRecv = true;
                } else {
                    if pAccess =!= "" and not types.isGenericParamName(genericParams, types.distinctBaseKind(pTypeParsed.kind)) and not types.isMutContainerKind(pTypeParsed.kind) {
                        failAt(source, pTypeStart, prefix, "mut parameter signatures are reserved for List, Map, Set, or record parameters");
                    }
                    if isObjectSafe and types.kindHasAnyGenericParam("Self", pTypeParsed.kind) {
                        isObjectSafe = false;
                        unsafeReason = "method " + mName + " takes Self outside receiver";
                    }
                    mut nonRecvParams.pushBack(pName + "=" + pAccess + pTypeParsed.kind);
                }
                pCount = pCount + 1;
                cursor = skipTrivia(source, pTypeParsed.next, prefix);
                if cursor < size and source.at(cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                    if cursor < size and source.at(cursor) == ")" { break; }
                } else {
                    break;
                }
            }
        }
        if not hasValidRecv {
            failAt(source, mStart, prefix, "interface method " + name + "." + mName + " must take Self or mut Self as first parameter");
        }
        cursor = expectSymbol(source, cursor, ")", prefix);
        cursor = skipTrivia(source, cursor, prefix);
        cursor = expectSymbol(source, cursor, ":", prefix);
        resParsed := types.parseFunctionType(source, cursor, prefix, scopedAliases, genericParams);
        if types.containsDynKind(resParsed.kind) {
            failAt(source, cursor, prefix, "borrowed dyn Interface cannot escape via interface method return type");
        }
        if isObjectSafe and types.kindHasAnyGenericParam("Self", resParsed.kind) {
            isObjectSafe = false;
            unsafeReason = "method " + mName + " returns Self";
        }
        cursor = skipTrivia(source, resParsed.next, prefix);
        var hasDefault := false;
        var defaultBody := "";
        var defaultPrefix := "";
        if cursor < size and source.at(cursor) == "{" {
            bodyEndPos := skipBraceBlock(source, cursor + 1, prefix);
            defaultBody = source.slice(cursor, bodyEndPos);
            hasDefault = true;
            defaultPrefix = prefix;
            cursor = skipTrivia(source, bodyEndPos, prefix);
        } else if usedAssignOp {
            failAt(source, mStart, prefix, "interface method " + name + "." + mName + " with := must provide a default { ... } body");
        }
        mut methods.pushBack(interfaces.InterfaceMethod {
            name = mName,
            recvName = if pNames.length() > 0 { pNames[0] } else { "self" },
            recvMut = recvMut,
            params = nonRecvParams.join("|"),
            paramCount = pCount - 1,
            result = resParsed.kind,
            hasDefault = hasDefault,
            defaultBody = defaultBody,
            defaultPrefix = defaultPrefix
        });
        if cursor < size and source.at(cursor) == ";" {
            cursor = skipTrivia(source, cursor + 1, prefix);
        }
    }
    def := interfaces.InterfaceDef {
        key = ifaceKey,
        name = name,
        moduleKey = moduleKey,
        genericParams = genericParams,
        assocTypes = assocTypes,
        methods = methods,
        isObjectSafe = isObjectSafe,
        unsafeReason = unsafeReason,
        declAt = nameStart
    };
    interfaces.registerInterface(def);
    afterEnd := skipTrivia(source, cursor, prefix);
    (def = def, resolvedCode = resolvedCode, afterEnd = afterEnd)
};

/** True when `targetOwnerKey` is owned by `(moduleKey, moduleIdentity)`. */
isImplTargetOwned := fn(moduleKey: String, moduleIdentity: String, targetOwnerKey: String): Bool {
    if targetOwnerKey == "" { return false; }
    if types.coreBuiltinOwnerType(moduleIdentity, targetOwnerKey) == targetOwnerKey { return true; }
    colonPos := targetOwnerKey.indexOf(":", 0);
    if colonPos <= 0 { return false; }
    tag := targetOwnerKey.slice(0, colonPos);
    if tag =!= "Record" and tag =!= "Enum" and tag =!= "Distinct" { return false; }
    subHdr := targetOwnerKey.slice(colonPos + 1, targetOwnerKey.length());
    subHdr.startsWithAt(0, moduleKey + "#")
};

/** Appends synthetic `$Kind:P` aliases for impl-level comptime parameters so inline method signatures resolve them. */
aliasesWithImplParams := fn(aliases: List<AliasDecl>, implParams: String, depth: Int): List<AliasDecl> {
    if implParams == "" { return aliases; }
    mut out: List<AliasDecl> = [];
    loop aliases as existing { mut out.pushBack(existing); }
    loop types.splitParamSpecs(implParams) as sp {
        mut out.pushBack((name = sp.name, target = "$Kind:" + sp.name, at = -1, end = 0, depth = depth));
    }
    out
};

/** Verifies two pipe-encoded parameter lists and result types match between impl method and instantiated interface method. */
verifyImplMethodSignature := fn(source: String, errPos: Int, prefix: String, ifaceName: String, targetKind: String,
reqMethod: interfaces.InterfaceMethod, actualParams: String, actualParamCount: Int, actualResult: String): Unit {
    if contexts.extractCtxKindFromParams(actualParams) =!= "" {
        failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " cannot declare context requirements omitted by interface " + ifaceName);
    }
    expectedTotal := reqMethod.paramCount + 1;
    if actualParamCount =!= expectedTotal {
        failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " expects " + expectedTotal.toText() + " parameter(s), got " + actualParamCount.toText());
    }
    actualEntries := splitPipeEntries(actualParams, actualParamCount);
    rawRecv := paramKindOf(actualEntries[0]);
    actRecvMut := rawRecv.startsWithAt(0, "mut ");
    actRecvKind := if actRecvMut { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
    if actRecvMut =!= reqMethod.recvMut {
        expStr := if reqMethod.recvMut { "mut Self" } else { "Self" };
        failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " receiver mutability mismatch (expected " + expStr + ")");
    }
    if actRecvKind =!= targetKind {
        failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " receiver must be Self (" + displayKind(targetKind) + "), got " + displayKind(actRecvKind));
    }
    emptyReqs: List<String> = [];
    reqEntries := if reqMethod.paramCount > 0 { splitPipeEntries(reqMethod.params, reqMethod.paramCount) } else { emptyReqs };
    var pi := 0;
    loop pi < reqMethod.paramCount {
        rawReq := paramKindOf(reqEntries[pi]);
        reqMut := rawReq.startsWithAt(0, "mut ");
        reqKind := if reqMut { rawReq.slice(4, rawReq.length()) } else { rawReq };
        rawAct := paramKindOf(actualEntries[pi + 1]);
        actMut := rawAct.startsWithAt(0, "mut ");
        actKind := if actMut { rawAct.slice(4, rawAct.length()) } else { rawAct };
        if reqMut =!= actMut or reqKind =!= actKind {
            failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " parameter " + (pi + 1).toText() + " mismatch: expected " + rawReq + ", got " + rawAct);
        }
        pi = pi + 1;
    }
    if actualResult =!= reqMethod.result {
        failAt(source, errPos, prefix, "impl method " + ifaceName + "." + reqMethod.name + " return type mismatch: expected " + displayKind(reqMethod.result) + ", got " + displayKind(actualResult));
    }
};

/** Validates one `impl` associated type binding against any `<Bound>` declared on the interface. */
validateImplAssocBound := fn(source: String, errPos: Int, prefix: String, ifaceDef: interfaces.InterfaceDef, ifaceParsedKind: String,
targetKind: String, implGenericParams: String, assoc: interfaces.InterfaceAssocType, actKind: String): Unit {
    if assoc.bound == "" { return; }
    args := types.ifaceArgsOf(ifaceParsedKind);
    pSpecs := types.splitParamSpecs(ifaceDef.genericParams);
    mut subMap: Map<String, String>;
    var bi := 0;
    loop bi < pSpecs.length() and bi < args.length() {
        mut subMap.set(pSpecs[bi].name, args[bi]);
        bi = bi + 1;
    }
    mut subMap.set("Self", targetKind);
    effGP := if ifaceDef.genericParams =!= "" { ifaceDef.genericParams + ",Self:Type" } else { "Self:Type" };
    effBound := types.substCanonicalKind(effGP, assoc.bound, subMap);
    if implGenericParams =!= "" and types.isGenericParamName(implGenericParams, actKind) {
        outerC := types.typeParamConstraintKind(implGenericParams, actKind);
        if outerC == "" or not types.constraintIsSubset(outerC, effBound) {
            failAt(source, errPos, prefix, "associated type " + assoc.name + " (" + displayKind(actKind) + ") does not satisfy bound " + displayKind(effBound));
        }
    } else if not types.kindHasAnyGenericParam(implGenericParams, actKind) and not types.kindHasAnyGenericParam(implGenericParams, effBound) {
        if not types.typeSatisfiesConstraint(actKind, effBound) {
            failAt(source, errPos, prefix, "associated type " + assoc.name + " (" + displayKind(actKind) + ") does not satisfy bound " + displayKind(effBound));
        }
    }
};

/** Substitutes `ifaceDef.genericParams` and `Self -> targetKind` into an associated type's `= Default` kind. */
substAssocDefaultForTarget := fn(ifaceDef: interfaces.InterfaceDef, ifaceParsedKind: String, targetKind: String, rawDefault: String, assocMap: Map<String, String>): String {
    args := types.ifaceArgsOf(ifaceParsedKind);
    pSpecs := types.splitParamSpecs(ifaceDef.genericParams);
    mut subMap: Map<String, String>;
    var bi := 0;
    loop bi < pSpecs.length() and bi < args.length() {
        mut subMap.set(pSpecs[bi].name, args[bi]);
        bi = bi + 1;
    }
    mut subMap.set("Self", targetKind);
    loop assocMap as kv {
        mut subMap.set("$assoc:" + kv.key, kv.value);
    }
    effGP := if ifaceDef.genericParams =!= "" { ifaceDef.genericParams + ",Self:Type" } else { "Self:Type" };
    types.substCanonicalKind(effGP, rawDefault, subMap)
};

/** Appends a synthesized default method body for `req` omitted by `impl` (`inline` or bodyless). */
appendSynthesizedDefaultMethod := fn(req: interfaces.InterfaceMethod, implKey: String, targetKind: String, implGenericParams: String,
implStart: Int, bindings: mut List<interfaces.ImplMethodBinding>,
mNames: mut List<String>, mFnKeys: mut List<String>, mRuntimes: mut List<String>, mParams: mut List<String>, mCounts: mut List<Int>,
mResults: mut List<String>, mGenerics: mut List<String>, mDeclAts: mut List<Int>, mBodyStarts: mut List<Int>, mBodyEnds: mut List<Int>,
mSources: mut List<String>, mPrefixes: mut List<String>, mIsDefaults: mut List<Bool>): Unit {
    fnKey := "$implop:" + implKey + "." + req.name;
    recvN := if req.recvName =!= "" { req.recvName } else { "self" };
    recvEntry := recvN + "=" + (if req.recvMut { "mut " } else { "" }) + targetKind;
    fullParams := if req.paramCount > 0 and req.params =!= "" { recvEntry + "|" + req.params } else { recvEntry };
    mut mNames.pushBack(req.name);
    mut mFnKeys.pushBack(fnKey);
    mut mRuntimes.pushBack("");
    mut mParams.pushBack(fullParams);
    mut mCounts.pushBack(req.paramCount + 1);
    mut mResults.pushBack(req.result);
    mut mGenerics.pushBack(implGenericParams);
    mut mDeclAts.pushBack(implStart);
    mut mBodyStarts.pushBack(1);
    mut mBodyEnds.pushBack(req.defaultBody.length());
    mut mSources.pushBack(req.defaultBody);
    mut mPrefixes.pushBack(req.defaultPrefix);
    mut mIsDefaults.pushBack(true);
    mut bindings.pushBack(interfaces.ImplMethodBinding { name = req.name, fnKey = fnKey, recvMut = req.recvMut });
};

/** Validated `impl` declaration header and pre-scanned method metadata. */
ParsedImplHeader := record {
    isInline: Bool;
    afterEnd: Int;
    bodyFirstPos: Int;
    braceEndPos: Int;
    implDef: interfaces.ImplDef;
    implKey: String;
    implGenericParams: String;
    targetKind: String;
    methodNames: List<String>;
    methodFnKeys: List<String>;
    methodRuntimes: List<String>;
    methodParams: List<String>;
    methodParamCounts: List<Int>;
    methodResults: List<String>;
    methodGenerics: List<String>;
    methodDeclAts: List<Int>;
    methodBodyStarts: List<Int>;
    methodBodyEnds: List<Int>;
    methodSources: List<String>;
    methodPrefixes: List<String>;
    methodIsDefault: List<Bool>;
};

/** Parses `[pub] impl[<Params>] Iface[<Args>] for Target[<Args>];` or `{ ... }`, returning updated position and body-compilation info. */
parseImplHeaderAndValidate := fn(source: String, implStart: Int, afterImplKw: Int, prefix: String,
aliases: List<AliasDecl>, moduleKey: String, moduleIdentity: String, isPub: Bool,
functions: List<FunctionInfo>, functionParams: List<String>): ParsedImplHeader {
    size := source.length();
    gp := types.scanComptimeTypeParams(source, afterImplKw, prefix);
    if not gp.ok {
        failAt(source, gp.errPos, prefix, gp.errMsg);
    }
    implGenericParams := if gp.hasParams {
        types.resolveComptimeParamSpecs(source, afterImplKw, prefix, aliases, gp.paramsCsv)
    } else {
        ""
    };
    ifaceStart := skipTrivia(source, gp.next, prefix);
    ifaceParsed := parseTypeWithSeen(source, ifaceStart, false, source, ifaceStart, prefix, aliases, "impl", implGenericParams, []);
    if not types.isInterfaceKind(ifaceParsed.kind) {
        failAt(source, ifaceStart, prefix, "expected an interface type in impl, got " + displayKind(ifaceParsed.kind));
    }
    ifaceKey := types.ifaceKeyOf(ifaceParsed.kind);
    ifaceIdx := interfaces.findInterface(ifaceKey);
    if ifaceIdx < 0 {
        failAt(source, ifaceStart, prefix, "unknown interface in impl");
    }
    ifaceDef := interfaces.getInterface(ifaceIdx);
    ifaceArgsCsv := types.ifaceArgsOf(ifaceParsed.kind).join(",");
    forPos := skipTrivia(source, ifaceParsed.next, prefix);
    if not source.wordAt(forPos, "for") {
        failAt(source, forPos, prefix, "expected 'for' after interface in impl");
    }
    targetStart := skipTrivia(source, forPos + 3, prefix);
    targetParsed := parseTypeWithSeen(source, targetStart, false, source, targetStart, prefix, aliases, "impl target", implGenericParams, []);
    targetKind := targetParsed.kind;
    if types.isDynKind(targetKind) or types.isSliceKind(targetKind) or types.isInterfaceKind(targetKind) or
    targetKind == VALUE_KIND_UNIT or targetKind == VALUE_KIND_NEVER {
        failAt(source, targetStart, prefix, "cannot implement interface for " + displayKind(targetKind));
    }
    if types.isGenericParamName(implGenericParams, targetKind) {
        failAt(source, targetStart, prefix, "blanket impl for generic parameter " + targetKind + " is not supported; name a concrete or generic nominal target type");
    }
    targetOwnerKey := types.typeOpOwnerKey(targetKind);
    if targetOwnerKey == "" {
        failAt(source, targetStart, prefix, "cannot implement interface for non-nominal type " + displayKind(targetKind));
    }
    targetOwned := isImplTargetOwned(moduleKey, moduleIdentity, targetOwnerKey);
    if ifaceDef.moduleKey =!= moduleKey and not targetOwned {
        failAt(source, implStart, prefix, "orphan impl: neither interface " + ifaceDef.name + " nor target type " + displayKind(targetKind) + " is owned by this module");
    }
    implKey := moduleKey + "#" + ifaceDef.key + "#" + targetKind + "#" + ifaceArgsCsv + "@" + implStart.toText();
    if interfaces.hasDuplicateImpl(ifaceDef.key, ifaceArgsCsv, targetOwnerKey, targetKind, implKey) {
        failAt(source, implStart, prefix, "duplicate impl of " + displayKind(ifaceParsed.kind) + " for " + displayKind(targetKind));
    }
    delimPos := skipTrivia(source, targetParsed.next, prefix);
    mut mNames: List<String> = [];
    mut mFnKeys: List<String> = [];
    mut mRuntimes: List<String> = [];
    mut mParams: List<String> = [];
    mut mCounts: List<Int> = [];
    mut mResults: List<String> = [];
    mut mGenerics: List<String> = [];
    mut mDeclAts: List<Int> = [];
    mut mBodyStarts: List<Int> = [];
    mut mBodyEnds: List<Int> = [];
    mut mSources: List<String> = [];
    mut mPrefixes: List<String> = [];
    mut mIsDefaults: List<Bool> = [];
    mut assocBindings: List<interfaces.ImplAssocBinding> = [];
    mut assocMap: Map<String, String>;
    mut bindings: List<interfaces.ImplMethodBinding> = [];
    if delimPos < size and source.at(delimPos) == ";" {
        loop ifaceDef.assocTypes as at {
            if at.defaultKind == "" {
                failAt(source, implStart, prefix, "impl of " + ifaceDef.name + " for " + displayKind(targetKind) + " is missing required associated type " + at.name + "; use inline impl { ... }");
            }
            defK := substAssocDefaultForTarget(ifaceDef, ifaceParsed.kind, targetKind, at.defaultKind, assocMap);
            validateImplAssocBound(source, implStart, prefix, ifaceDef, ifaceParsed.kind, targetKind, implGenericParams, at, defK);
            mut assocMap.set(at.name, defK);
            mut assocBindings.pushBack(interfaces.ImplAssocBinding { name = at.name, kind = defK });
        }
        reqMethods := types.instantiatedInterfaceMethodsForTarget(ifaceParsed.kind, targetKind, assocMap);
        loop reqMethods as req {
            opKey := "$typeop:" + targetOwnerKey + "." + req.name;
            opCands := sym.findFunctions(functions, opKey);
            if opCands.length() == 0 {
                if req.hasDefault {
                    appendSynthesizedDefaultMethod(req, implKey, targetKind, implGenericParams, implStart, mut bindings,
                    mut mNames, mut mFnKeys, mut mRuntimes, mut mParams, mut mCounts, mut mResults, mut mGenerics,
                    mut mDeclAts, mut mBodyStarts, mut mBodyEnds, mut mSources, mut mPrefixes, mut mIsDefaults);
                    continue;
                }
                failAt(source, implStart, prefix, "type " + displayKind(targetKind) + " is missing required operation " + req.name + " for " + ifaceDef.name);
            }
            var chosenIdx := opCands[0];
            var chosenEffParams := "";
            var chosenEffResult := "";
            var ci := 0;
            loop ci < opCands.length() {
                candIdx := opCands[ci];
                fInfo := functions[candIdx];
                mut actParts: List<String> = [];
                var ai := 0;
                loop ai < fInfo.count {
                    mut actParts.pushBack(functionParams[fInfo.first + ai]);
                    ai = ai + 1;
                }
                var effActParams := actParts.join("|");
                var effActResult := fInfo.result;
                if fInfo.count > 0 {
                    firstRaw := paramKindOf(actParts[0]);
                    firstType := if firstRaw.startsWithAt(0, "mut ") { firstRaw.slice(4, firstRaw.length()) } else { firstRaw };
                    ownerArgs := types.nominalTypeArgs(firstType);
                    tgtArgs := types.nominalTypeArgs(targetKind);
                    if ownerArgs.length() > 0 and ownerArgs.length() == tgtArgs.length() and firstType =!= targetKind {
                        mut ownerParamNames: List<String> = [];
                        mut subMap: Map<String, String>;
                        var oi := 0;
                        loop oi < ownerArgs.length() {
                            mut ownerParamNames.pushBack(ownerArgs[oi]);
                            mut subMap.set(ownerArgs[oi], tgtArgs[oi]);
                            oi = oi + 1;
                        }
                        oParamCsv := ownerParamNames.join(",");
                        mut newParts: List<String> = [];
                        loop actParts as ap {
                            pN := paramNameOf(ap);
                            pRK := paramKindOf(ap);
                            pAcc := if pRK.startsWithAt(0, "mut ") { "mut " } else { "" };
                            pTK := if pAcc =!= "" { pRK.slice(4, pRK.length()) } else { pRK };
                            mut newParts.pushBack(pN + "=" + pAcc + types.substCanonicalKind(oParamCsv, pTK, subMap));
                        }
                        effActParams = newParts.join("|");
                        effActResult = types.substCanonicalKind(oParamCsv, fInfo.result, subMap);
                    }
                }
                if ci == 0 {
                    chosenEffParams = effActParams;
                    chosenEffResult = effActResult;
                }
                if opCands.length() > 1 and contexts.extractCtxKindFromParams(effActParams) == "" and fInfo.count == req.paramCount + 1 {
                    cParts := splitPipeEntries(effActParams, fInfo.count);
                    cRecvRaw := paramKindOf(cParts[0]);
                    cRecvMut := cRecvRaw.startsWithAt(0, "mut ");
                    var allMatch := cRecvMut == req.recvMut and isCompatibleKind(req.result, effActResult);
                    if allMatch {
                        var pi := 0;
                        loop pi < req.paramCount {
                            rP := paramKindOf(splitPipeEntries(req.params, req.paramCount)[pi]);
                            aP := paramKindOf(cParts[pi + 1]);
                            if rP.startsWithAt(0, "mut ") =!= aP.startsWithAt(0, "mut ") or not isCompatibleKind(
                                (if rP.startsWithAt(0, "mut ") { rP.slice(4, rP.length()) } else { rP }),
                                (if aP.startsWithAt(0, "mut ") { aP.slice(4, aP.length()) } else { aP })
                            ) {
                                allMatch = false;
                                break;
                            }
                            pi = pi + 1;
                        }
                    }
                    if allMatch {
                        chosenIdx = candIdx;
                        chosenEffParams = effActParams;
                        chosenEffResult = effActResult;
                        break;
                    }
                }
                ci = ci + 1;
            }
            chosenInfo := functions[chosenIdx];
            verifyImplMethodSignature(source, implStart, prefix, ifaceDef.name, targetKind, req, chosenEffParams, chosenInfo.count, chosenEffResult);
            boundFnKey := if opCands.length() > 1 { "$rt:" + chosenInfo.runtime } else { opKey };
            mut bindings.pushBack(interfaces.ImplMethodBinding { name = req.name, fnKey = boundFnKey, recvMut = req.recvMut });
        }
        def := interfaces.ImplDef {
            key = implKey,
            ifaceKey = ifaceDef.key,
            ifaceArgsCsv = ifaceArgsCsv,
            targetOwnerKey = targetOwnerKey,
            targetPattern = targetKind,
            genericParams = implGenericParams,
            assocBindings = assocBindings,
            methods = bindings,
            isPub = isPub,
            declModule = moduleKey
        };
        afterSemi := skipTrivia(source, delimPos + 1, prefix);
        return ParsedImplHeader {
            isInline = false, afterEnd = afterSemi, bodyFirstPos = afterSemi, braceEndPos = -1,
            implDef = def, implKey = implKey, implGenericParams = implGenericParams, targetKind = targetKind,
            methodNames = mNames, methodFnKeys = mFnKeys, methodRuntimes = mRuntimes,
            methodParams = mParams, methodParamCounts = mCounts, methodResults = mResults,
            methodGenerics = mGenerics, methodDeclAts = mDeclAts,
            methodBodyStarts = mBodyStarts, methodBodyEnds = mBodyEnds,
            methodSources = mSources, methodPrefixes = mPrefixes, methodIsDefault = mIsDefaults
        };
    }
    if delimPos >= size or source.at(delimPos) =!= "{" {
        failAt(source, delimPos, prefix, "expected { or ; in impl declaration");
    }
    braceEndPos := scanBraceEnd(source, delimPos, prefix);
    firstInside := skipTrivia(source, delimPos + 1, prefix);
    mut scopedAliases: List<AliasDecl> = types.withSelfAlias(aliasesWithImplParams(aliases, implGenericParams, 99), "$Kind:" + targetKind, 0);
    /* Pass 1: collect associated type bindings so explicit method signatures see Self.Assoc */
    mut seenAssocNames: Set<String>;
    var pass1 := firstInside;
    loop pass1 < braceEndPos - 1 {
        loop pass1 < braceEndPos - 1 and source.at(pass1) == ";" {
            pass1 = skipTrivia(source, pass1 + 1, prefix);
        }
        if pass1 >= braceEndPos - 1 or source.at(pass1) == "}" { break; }
        if not source.at(pass1).isNameStart() {
            failAt(source, pass1, prefix, "expected member declaration inside impl block");
        }
        memStart := pass1;
        memEnd := source.skipName(memStart);
        memName := source.slice(memStart, memEnd);
        afterMemName := skipTrivia(source, memEnd, prefix);
        if not source.startsWithAt(afterMemName, ":=") {
            failAt(source, afterMemName, prefix, "expected := inside impl block after " + memName);
        }
        afterEq := skipTrivia(source, afterMemName + 2, prefix);
        assocHit := interfaces.findAssocInInterface(ifaceDef, memName);
        if assocHit.found {
            if seenAssocNames.has(memName) {
                failAt(source, memStart, prefix, "duplicate associated type " + memName + " in impl of " + ifaceDef.name);
            }
            mut seenAssocNames.add(memName);
            rhsPos := if source.wordAt(afterEq, "alias") { skipTrivia(source, afterEq + 5, prefix) } else { afterEq };
            aParsed := types.parseTypeWithSeen(source, rhsPos, true, source, rhsPos, prefix, scopedAliases, "alias", implGenericParams, []);
            validateImplAssocBound(source, rhsPos, prefix, ifaceDef, ifaceParsed.kind, targetKind, implGenericParams, assocHit.assoc, aParsed.kind);
            mut assocMap.set(memName, aParsed.kind);
            mut assocBindings.pushBack(interfaces.ImplAssocBinding { name = memName, kind = aParsed.kind });
            mut scopedAliases.pushBack((name = "$self_assoc:" + memName, target = "$Kind:" + aParsed.kind, at = memStart, end = aParsed.next, depth = 0));
            afterT := skipTrivia(source, aParsed.next, prefix);
            pass1 = expectSymbol(source, afterT, ";", prefix);
            pass1 = skipTrivia(source, pass1, prefix);
        } else {
            if not source.wordAt(afterEq, "fn") {
                failAt(source, afterEq, prefix, "associated type " + memName + " is not declared in interface " + ifaceDef.name);
            }
            var sk := skipTrivia(source, afterEq + 2, prefix);
            var pd := 0;
            var bd := 0;
            loop sk < braceEndPos {
                sc := source.at(sk);
                if sc == "\"" { sk = skipAliasString(source, sk); continue; }
                if sc == "(" { pd = pd + 1; }
                else if sc == ")" and pd > 0 { pd = pd - 1; }
                else if sc == "[" { bd = bd + 1; }
                else if sc == "]" and bd > 0 { bd = bd - 1; }
                else if sc == "{" and pd == 0 and bd == 0 { break; }
                sk = sk + 1;
            }
            if sk >= braceEndPos or source.at(sk) =!= "{" {
                failAt(source, sk, prefix, "impl method " + memName + " must have a function body");
            }
            pass1 = skipTrivia(source, skipBraceBlock(source, sk + 1, prefix), prefix);
        }
    }
    loop ifaceDef.assocTypes as at {
        if not seenAssocNames.has(at.name) {
            if at.defaultKind == "" {
                failAt(source, implStart, prefix, "impl of " + ifaceDef.name + " for " + displayKind(targetKind) + " is missing required associated type " + at.name);
            }
            defK := substAssocDefaultForTarget(ifaceDef, ifaceParsed.kind, targetKind, at.defaultKind, assocMap);
            validateImplAssocBound(source, implStart, prefix, ifaceDef, ifaceParsed.kind, targetKind, implGenericParams, at, defK);
            mut assocMap.set(at.name, defK);
            mut assocBindings.pushBack(interfaces.ImplAssocBinding { name = at.name, kind = defK });
            mut scopedAliases.pushBack((name = "$self_assoc:" + at.name, target = "$Kind:" + defK, at = -1, end = 0, depth = 0));
        }
    }
    reqMethods := types.instantiatedInterfaceMethodsForTarget(ifaceParsed.kind, targetKind, assocMap);
    /* Pass 2: validate explicit methods against instantiated requirements */
    var scan := firstInside;
    loop scan < braceEndPos - 1 {
        loop scan < braceEndPos - 1 and source.at(scan) == ";" {
            scan = skipTrivia(source, scan + 1, prefix);
        }
        if scan >= braceEndPos - 1 or source.at(scan) == "}" { break; }
        if not source.at(scan).isNameStart() {
            failAt(source, scan, prefix, "expected method declaration inside impl block");
        }
        mStart := scan;
        mEnd := source.skipName(mStart);
        mName := source.slice(mStart, mEnd);
        afterMName := skipTrivia(source, mEnd, prefix);
        afterColonEq := skipTrivia(source, afterMName + 2, prefix);
        if interfaces.findAssocInInterface(ifaceDef, mName).found {
            rhsPos := if source.wordAt(afterColonEq, "alias") { skipTrivia(source, afterColonEq + 5, prefix) } else { afterColonEq };
            aSkip := types.parseTypeWithSeen(source, rhsPos, true, source, rhsPos, prefix, scopedAliases, "alias", implGenericParams, []);
            afterT := skipTrivia(source, aSkip.next, prefix);
            scan = expectSymbol(source, afterT, ";", prefix);
            scan = skipTrivia(source, scan, prefix);
            continue;
        }
        if mNames.contains(mName) {
            failAt(source, mStart, prefix, "duplicate method " + mName + " in impl of " + ifaceDef.name);
        }
        var reqIdx := -1;
        var ri := 0;
        loop ri < reqMethods.length() {
            if reqMethods[ri].name == mName {
                reqIdx = ri;
                break;
            }
            ri = ri + 1;
        }
        if reqIdx < 0 {
            failAt(source, mStart, prefix, "method " + mName + " is not declared in interface " + ifaceDef.name);
        }
        mHdr := types.parseTypeOpHeader(source, skipTrivia(source, afterColonEq + 2, prefix), prefix, scopedAliases,
        ifaceDef.name, mName, "$Kind:" + targetKind, targetOwnerKey, false);
        req := reqMethods[reqIdx];
        verifyImplMethodSignature(source, mStart, prefix, ifaceDef.name, targetKind, req, mHdr.params, mHdr.count, mHdr.result);
        afterHdr := skipTrivia(source, mHdr.next, prefix);
        mBodyEnd := skipBraceBlock(source, afterHdr + 1, prefix);
        var effGeneric := implGenericParams;
        if mHdr.genericType =!= "" {
            loop types.splitParamSpecs(mHdr.genericType) as mp {
                if implGenericParams =!= "" and types.isAnyParamName(implGenericParams, mp.name) {
                    failAt(source, mStart, prefix, "impl method " + mName + " cannot redeclare impl type parameter " + mp.name);
                }
            }
            effGeneric = if effGeneric =!= "" { effGeneric + "," + mHdr.genericType } else { mHdr.genericType };
        }
        fnKey := "$implop:" + implKey + "." + mName;
        mut mNames.pushBack(mName);
        mut mFnKeys.pushBack(fnKey);
        mut mRuntimes.pushBack("");
        mut mParams.pushBack(mHdr.params);
        mut mCounts.pushBack(mHdr.count);
        mut mResults.pushBack(mHdr.result);
        mut mGenerics.pushBack(effGeneric);
        mut mDeclAts.pushBack(mStart);
        mut mBodyStarts.pushBack(afterHdr + 1);
        mut mBodyEnds.pushBack(mBodyEnd);
        mut mSources.pushBack(source);
        mut mPrefixes.pushBack(prefix);
        mut mIsDefaults.pushBack(false);
        mut bindings.pushBack(interfaces.ImplMethodBinding { name = mName, fnKey = fnKey, recvMut = req.recvMut });
        scan = skipTrivia(source, mBodyEnd, prefix);
    }
    loop reqMethods as req {
        if not mNames.contains(req.name) {
            if req.hasDefault {
                appendSynthesizedDefaultMethod(req, implKey, targetKind, implGenericParams, implStart, mut bindings,
                mut mNames, mut mFnKeys, mut mRuntimes, mut mParams, mut mCounts, mut mResults, mut mGenerics,
                mut mDeclAts, mut mBodyStarts, mut mBodyEnds, mut mSources, mut mPrefixes, mut mIsDefaults);
            } else {
                failAt(source, implStart, prefix, "impl of " + ifaceDef.name + " for " + displayKind(targetKind) + " is missing required method " + req.name);
            }
        }
    }
    def := interfaces.ImplDef {
        key = implKey,
        ifaceKey = ifaceDef.key,
        ifaceArgsCsv = ifaceArgsCsv,
        targetOwnerKey = targetOwnerKey,
        targetPattern = targetKind,
        genericParams = implGenericParams,
        assocBindings = assocBindings,
        methods = bindings,
        isPub = isPub,
        declModule = moduleKey
    };
    afterBlock := skipTrivia(source, braceEndPos, prefix);
    afterEnd := if afterBlock < size and source.at(afterBlock) == ";" { skipTrivia(source, afterBlock + 1, prefix) } else { afterBlock };
    ParsedImplHeader {
        isInline = true,
        afterEnd = afterEnd,
        bodyFirstPos = firstInside,
        braceEndPos = braceEndPos,
        implDef = def,
        implKey = implKey,
        implGenericParams = implGenericParams,
        targetKind = targetKind,
        methodNames = mNames,
        methodFnKeys = mFnKeys,
        methodRuntimes = mRuntimes,
        methodParams = mParams,
        methodParamCounts = mCounts,
        methodResults = mResults,
        methodGenerics = mGenerics,
        methodDeclAts = mDeclAts,
        methodBodyStarts = mBodyStarts,
        methodBodyEnds = mBodyEnds,
        methodSources = mSources,
        methodPrefixes = mPrefixes,
        methodIsDefault = mIsDefaults
    }
};

/** Collects top-level declarations for one module before full body parsing. */
collectModuleDecls := fn(target: String, source: String, prefix: String, moduleKey: String): Items { infer.collectModuleDecls(target, source, prefix, moduleKey) };

/** Appends `(name, depth)` entries to `decls` for every `|name|` token in `assignedBag`. */
appendAssignedBagDecls := fn(assignedBag: String, decls: List<BlockDecl>, depth: Int): List<BlockDecl> { infer.appendAssignedBagDecls(assignedBag, decls, depth) };

/** Removes deferred-only entries after one function body has been checked. */
withoutFutureValues := fn(locals: List<Local>): List<Local> { infer.withoutFutureValues(locals) };

/** Parses one top-level aliased import and returns its next source position. */
parseImportClause := fn(target: String, source: String, position: Int, modAlias: String, prefix: String): Item { infer.parseImportClause(target, source, position, modAlias, prefix) };

/** Collects top-level import clauses before parsing so imported declarations can seed the importing file's symbol table. */
pub collectImportClauses := fn(target: String, source: String, prefix: String): Items { infer.collectImportClauses(target, source, prefix) };

/** Parses one imported `io.output` / `io.outputLine` statement into its ordered argument group and ending marker. */
parseOutputStatement := fn(target: String, source: String, openPosition: Int, outputName: String, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
live: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    sourceLen := source.length();
    var position := openPosition;
    if position >= sourceLen or source.at(position) =!= "(" {
        failAt(source, position, prefix, "expected ( after " + outputName);
    }
    position = skipTrivia(source, position + 1, prefix);
    mut result: List<Item> = [];
    loop position < sourceLen and source.at(position) =!= ")" {
        argStart := position;
        argument := parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs, aliases);
        if containsFnKind(argument.kind) {
            failAt(source, argStart, prefix, "cannot output function value");
        }
        (mut result).pushBack((kind = argument.kind, name = "", runtime = "", code = argument.code,
        intValue = argument.intValue, textValue = argument.textValue));
        position = skipTrivia(source, argument.next, prefix);
        if position < sourceLen and source.at(position) == "," {
            position = skipTrivia(source, position + 1, prefix);
        } else {
            break;
        }
    }
    position = expectSymbol(source, position, ")", prefix);
    statementNext := consumeStatementEnd(source, position, prefix);
    if statementNext < 0 { failAt(source, skipTrivia(source, position, prefix), prefix, "expected ; after " + outputName); }
    (mut result).pushBack((kind = if outputName == "outputLine" { ITEM_KIND_END } else { ITEM_KIND_END_OUTPUT },
    name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
    result
}

/** Advances past one `{ ... }` function body while respecting strings and comments. */
skipBraceBlock := fn(source: String, afterOpen: Int, prefix: String): Int { syntax.skipBraceBlock(source, afterOpen, prefix) };

/** Splits up to `count` pipe-delimited substrings out of `encoded`, ignoring any trailing `$ctx=` entry. */
splitPipeEntries := fn(encoded: String, count: Int): List<String> {
    generics.splitPipeEntries(encoded, count)
};

/** Binds declared `Ctx<...>` slots of a function, method, or monomorphization at lexical depth 1. */
bindFunctionContextSlots := fn(target: String, source: String, errPos: Int, prefix: String, ctxKind: String,
ctxParamName: String, fnParamSeedBag: String, locals: mut List<Local>, blockDecls: mut List<BlockDecl>): Unit {
    if ctxKind == "" { return; }
    loop contexts.parseCtxKindSlots(ctxKind) as cs {
        if tokenInPipeBag(fnParamSeedBag, cs.name) {
            failAt(source, errPos, prefix, "context slot " + cs.name + " conflicts with parameter of the same name");
        }
        isSlice := types.isSliceKind(cs.kind);
        isDyn := types.isDynKind(cs.kind);
        isBorrowView := isSlice or isDyn;
        fieldName := if target == TARGET_C { "slot_" + ir.safeTargetIdent(TARGET_C, cs.name) } else { cs.name };
        fieldAccess := ctxParamName + (if target == TARGET_C { "->" } else { "." }) + fieldName;
        slotRuntime := if target == TARGET_C {
            if isBorrowView { fieldAccess }
            else if cs.isMut or types.cParamIsConstPtr(cs.kind) { "(*(" + fieldAccess + "))" }
            else { fieldAccess }
        } else {
            if isBorrowView or not cs.isMut { fieldAccess }
            else { fieldAccess + ".v" }
        };
        provText := if isBorrowView { "ctx_param:borrow" } else if cs.isMut { "ctx_param:mut" } else { "ctx_param:ro" };
        mut locals.pushBack((name = "$ctxslot:" + cs.name, runtime = slotRuntime, kind = cs.kind,
        mutable = cs.isMut and not isBorrowView, writable = cs.isMut, depth = 1, constant = false,
        code = "", intValue = 1, textValue = provText, initState = INIT_STATE_INIT));
        mut blockDecls.pushBack((name = cs.name, depth = 1));
        mut locals.pushBack((name = cs.name, runtime = slotRuntime, kind = cs.kind,
        mutable = cs.isMut and not isBorrowView, writable = cs.isMut, depth = 1, constant = false,
        code = slotRuntime, intValue = 0, textValue = provText, initState = INIT_STATE_INIT));
    }
};

/** Registers a C11 `NULL`-context ambient fallback initializer for `fnRuntime` when every slot in `ctxKind` has a compatible ambient default. */
registerFnAmbientDefaultInit := fn(target: String, source: String, errPos: Int, prefix: String, fnRuntime: String, ctxKind: String, locals: List<Local>, functions: List<FunctionInfo>): Unit {
    if target =!= TARGET_C or ctxKind == "" { return; }
    defInit := expr.tryBuildAmbientCtxDefaultInit(source, errPos, prefix, ctxKind, locals, functions);
    if defInit =!= "" {
        contexts.registerFnCtxDefaultInit(fnRuntime, defInit);
    }
};

/** Returns true when `needle` appears as a distinct token prefix in `code` or `textValue` of any item in `items[startIdx..endIdx)`. */
itemSpanUsesSlot := fn(items: Items, startIdx: Int, endIdx: Int, needle: String): Bool {
    hasInText := fn(s: String, sub: String): Bool {
        subLen := sub.length();
        sLen := s.length();
        var at := 0;
        var found := false;
        loop at < sLen {
            hit := s.indexOf(sub, at);
            if hit < 0 { break; }
            after := hit + subLen;
            if after >= sLen or not s.at(after).isNameContinue() {
                found = true;
                break;
            }
            at = hit + 1;
        }
        found
    };
    var idx := startIdx;
    loop idx < endIdx {
        it := items[idx];
        if hasInText(it.code, needle) or hasInText(it.textValue, needle) {
            return true;
        }
        idx = idx + 1;
    }
    false
};

/** Checks trace initialization safety, escaping callable safety (when `checkEscape`), and propagates outer callable updates. */
checkStatementTrace := fn(target: String, source: String, stmtAt: Int, prefix: String, exprCode: String,
checkEscape: Bool, escapeKind: String, currentName: String, maxFutureAt: Int,
locals: List<Local>, functions: List<FunctionInfo>, futureValues: List<FutureValue>, items: Items, active: Bool): List<Local> {
    if not active { return locals; }
    _t := target;
    checkTraceSafety(source, stmtAt, prefix, exprCode, currentName, maxFutureAt, locals, functions, futureValues, items);
    if checkEscape and containsFnKind(escapeKind) {
        checkEscapingFnSafety(source, stmtAt, prefix, exprCode, 1, locals);
    }
    mergeOuterCallableUpdatesFromCode(locals, exprCode)
};

/** Upgrades uninitialized root bindings and appends forward root `futureValues` visible inside a top-level function body. */
upgradeRootUninitLocalsForFn := fn(locals: List<Local>, rootAssignedNames: Set<String>, futureValues: List<FutureValue>, functions: List<FunctionInfo>, fnDeclAt: Int): List<Local> {
    mut nextLocals: List<Local> = locals;
    preLen := localsCount(locals);
    var upgradedRootBag := "";
    var rootIdx := 0;
    loop rootIdx < preLen {
        rootEntry := locals[rootIdx];
        if rootEntry.depth == 0 and rootEntry.initState =!= INIT_STATE_INIT and
        not tokenInPipeBag(upgradedRootBag, rootEntry.name) and localIndex(locals, rootEntry.name) == rootIdx {
            if rootEntry.initState == INIT_STATE_UNINIT_ASSIGNED or rootAssignedNames.has(rootEntry.name) {
                upgradedRootBag = appendPipeBag(upgradedRootBag, rootEntry.name);
                mut nextLocals.pushBack((name = rootEntry.name, runtime = rootEntry.runtime, kind = rootEntry.kind,
                mutable = rootEntry.mutable, writable = rootEntry.writable, depth = -1, constant = false, code = rootEntry.code,
                intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            } else if rootEntry.initState == INIT_STATE_UNINIT and not rootEntry.mutable {
                upgradedRootBag = appendPipeBag(upgradedRootBag, rootEntry.name);
                mut nextLocals.pushBack((name = rootEntry.name, runtime = rootEntry.runtime, kind = rootEntry.kind,
                mutable = rootEntry.mutable, writable = rootEntry.writable, depth = -1, constant = false, code = rootEntry.code,
                intValue = 0, textValue = "", initState = INIT_STATE_MAYBE));
            }
        }
        rootIdx = rootIdx + 1;
    }
    var pushedFutureBag := "";
    loop futureValues as future {
        if future.at > fnDeclAt and not tokenInPipeBag(pushedFutureBag, future.name) {
            existingLocalIdx := localIndex(locals, future.name);
            isShadowedLocal := existingLocalIdx >= 0 and locals[existingLocalIdx].depth >= 0;
            existingFnIdx := findFunction(functions, future.name);
            isShadowedFn := existingFnIdx >= 0 and functions[existingFnIdx].declAt < fnDeclAt;
            if not isShadowedLocal and not isShadowedFn {
                pushedFutureBag = appendPipeBag(pushedFutureBag, future.name);
                mut nextLocals.pushBack((name = future.name, runtime = future.runtime, kind = future.kind,
                mutable = future.mutable, writable = future.writable, depth = -1, constant = false, code = "",
                intValue = 0, textValue = "", initState = future.initState));
            }
        }
    }
    nextLocals
};

/** Parses and validates a Bool branch condition followed by `{` for `if`, `else if`, or `match` arms. */
parseBranchCondExpr := fn(target: String, source: String, condStart: Int, prefix: String, errMsg: String,
beforeOpenErr: String, ctxs: List<ConstructCtx>, locals: List<Local>, functions: List<FunctionInfo>,
functionParams: List<String>, currentName: String, aliases: List<AliasDecl>): (code: String, rawCode: String, textValue: String, openPos: Int, constant: Bool, boolValue: Bool) {
    condition := parseExpressionCtx(target, source, condStart, prefix, locals, functions, functionParams, currentName, ctxs, aliases);
    if condition.kind =!= VALUE_KIND_BOOL {
        failAt(source, condStart, prefix, errMsg);
    }
    conditionCode := if condition.constant {
        ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
    } else {
        condition.code
    };
    beforeOpen := skipTrivia(source, condition.next, prefix);
    rejectMisplacedTag(source, beforeOpen, prefix, beforeOpenErr);
    openPos := expectSymbol(source, beforeOpen, "{", prefix);
    (code = conditionCode, rawCode = condition.code, textValue = condition.textValue, openPos = openPos, constant = condition.constant, boolValue = condition.intValue =!= 0)
};

/** Skips any trailing `else if ... { ... }` and final `else { ... }` chain after a statically-true comptime branch `}`. */
skipTrailingElseChain := fn(source: String, afterBracePos: Int, prefix: String): Int {
    size := source.length();
    var curEnd := afterBracePos;
    loop true {
        after := skipTrivia(source, curEnd, prefix);
        if after >= size or not source.wordAt(after, "else") {
            return curEnd;
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if source.wordAt(afterElse, "if") {
            condStart := skipTrivia(source, afterElse + 2, prefix);
            openPos := scanConditionOpen(source, condStart, prefix);
            if openPos < 0 { return curEnd; }
            curEnd = scanBraceEnd(source, openPos, prefix);
        } else {
            openPos := skipTrivia(source, afterElse, prefix);
            if openPos >= size or source.at(openPos) =!= "{" { return curEnd; }
            return scanBraceEnd(source, openPos, prefix);
        }
    }
    curEnd
};

/** Skips any remaining subjectless `match` arms after a statically-true arm up to and including the closing `}`. */
skipRemainingMatchArms := fn(source: String, afterArmBrace: Int, prefix: String): Int {
    size := source.length();
    var cur := skipItemSeparators(source, afterArmBrace, prefix);
    loop cur < size and source.at(cur) =!= "}" {
        if source.wordAt(cur, "_") {
            afterU := skipTrivia(source, cur + 1, prefix);
            if afterU < size and source.at(afterU) == "{" {
                cur = skipItemSeparators(source, scanBraceEnd(source, afterU, prefix), prefix);
                continue;
            }
        }
        openPos := scanConditionOpen(source, cur, prefix);
        if openPos < 0 { break; }
        cur = skipItemSeparators(source, scanBraceEnd(source, openPos, prefix), prefix);
    }
    if cur < size and source.at(cur) == "}" { cur + 1 } else { cur }
};

/** Converts active immutable Locals into the metadata tuple shape accepted by `comptimeEval`. */
collectVisibleCtBindings := fn(locals: List<Local>): List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)> {
    mut out: List<(name: String, runtime: String, kind: String, constant: Bool, intValue: Int, textValue: String)> = [];
    loop locals as vb {
        if vb.initState == INIT_STATE_INIT and vb.name =!= "$inComptimeBlock" and vb.name =!= "$self_fn_rt" and
        vb.kind =!= VALUE_KIND_MODULE and vb.kind =!= VALUE_KIND_MODULE_FUNCTION and
        (vb.constant or comptimeEval.lookupLocalCtVal(vb.runtime) >= 0) {
            mut out.pushBack((name = vb.name, runtime = vb.runtime, kind = vb.kind, constant = vb.constant, intValue = vb.intValue, textValue = vb.textValue));
        }
    }
    out
};

/** Evaluates a Stage-1 `.lt` module initializer (rejecting bare effects/mutable globals before execution) and materializes its target value. */
stage1EvalTopLevelInit := fn(target: String, source: String, rhsStart: Int, prefix: String, moduleKey: String, expectedKind: String, rawParsed: Parsed, aliases: List<AliasDecl>, locals: List<Local>): Parsed {
    trimmedStart := skipTrivia(source, rhsStart, prefix);
    if source.wordAt(trimmedStart, "comptime") or containsFnKind(rawParsed.kind) or rawParsed.kind == VALUE_KIND_NEVER {
        return rawParsed;
    }
    if rawParsed.constant {
        return rawParsed;
    }
    eff := comptimeEval.checkExprEffects(source, trimmedStart, rawParsed.next, prefix, moduleKey);
    if not eff.pure {
        failAt(source, if eff.pos >= 0 { eff.pos } else { trimmedStart }, prefix, eff.reason);
    }
    dstKind := if expectedKind =!= "" { expectedKind } else { rawParsed.kind };
    if not comptimeEval.isMaterializableKind(dstKind) {
        failAt(source, trimmedStart, prefix, "module initializer type " + displayKind(dstKind) + " cannot be materialized at compile time");
    }
    ev := comptimeEval.evalExprPure(source, trimmedStart, rawParsed.next, prefix, moduleKey, dstKind, aliases, collectVisibleCtBindings(locals));
    if not ev.ok or ev.flow =!= "" {
        errMsg := if ev.error =!= "" { ev.error } else { "module initializer must be compile-time known" };
        failAt(source, trimmedStart, prefix, errMsg);
    }
    mat := comptimeEval.materializeValue(target, dstKind, ev.valId);
    comptimeEval.registerMaterializedCode(mat.code, ev.valId);
    (kind = dstKind, code = mat.code, intValue = mat.intValue, textValue = mat.textValue, constant = mat.constant, next = rawParsed.next)
};

/** Internal driver parsing either a complete module (`monoInstIdx < 0`) or one monomorphized generic instance body (`monoInstIdx >= 0`). */
parseProgramWithModuleInternal := fn(target: String, sourceIn: String, prefixIn: String, exports: Items, moduleKeyIn: String,
moduleIdentityIn: String, neededFns: String, skipSoftBuiltins: Bool, builtinSpecs: List<String>, monoInstIdx: Int): Items {
    sym.resetModule();
    var source := sourceIn;
    var prefix := prefixIn;
    var moduleKey := moduleKeyIn;
    var moduleIdentity := moduleIdentityIn;
    var size := source.length();
    var position := 0;
    var mut items: Items = [];
    isLtModule := prefix.endsWith(".lt");
    if monoInstIdx < 0 {
        contexts.clearAmbient();
        types.setActiveImplModuleKey(moduleKey);
        comptimeEval.setActiveModule(moduleKey);
        comptimeEval.registerModuleMeta(moduleKey, moduleIdentity, source, prefix);
        position = skipTrivia(source, 0, prefix);
        if position == size {
            contexts.saveModuleAmbient(moduleKey);
            return items;
        }
    }
    mut neededFnSet: Set<String>;
    if monoInstIdx < 0 and neededFns =!= "*" {
        nfLen := neededFns.length();
        var nfPos := 0;
        loop nfPos < nfLen {
            if neededFns.at(nfPos) == "|" {
                nfNext := neededFns.indexOf("|", nfPos + 1);
                if nfNext > nfPos + 1 {
                    mut neededFnSet.add(neededFns.slice(nfPos + 1, nfNext));
                    nfPos = nfNext;
                    continue;
                }
            }
            nfPos = nfPos + 1;
        }
    }
    var builtinRules: Items = [];
    if monoInstIdx < 0 and skipSoftBuiltins and target == TARGET_TS and moduleIdentity.startsWithAt(0, "lite.core.") {
        builtinRules = parseBuiltinModeSpecs(prefix, builtinSpecs);
    }
    var mut aliases: List<AliasDecl> = [];
    mut publishedFunctions: Set<String>;
    mut publishedFnAts: Set<Int>;
    mut publishedTypeOps: Set<String>;
    mut publishedTypeOpAts: Set<Int>;
    mut publishedValues: Set<String>;
    mut publishedTypes: Set<String>;
    mut declaredFnBlockNames: Set<String>;
    var hasInnerAlias := monoInstIdx >= 0;
    var hasInnerFn := monoInstIdx >= 0;
    mut rootAssignedNames: Set<String>;
    var mut locals: List<Local> = [];
    var mut blockDecls: List<BlockDecl> = [];
    var mut blockAssignedDecls: List<BlockDecl> = [];
    mut blocks: List<String> = [];
    mut functions: List<FunctionInfo> = [];
    mut functionParams: List<String> = [];
    mut declaredImportAliases: Set<String>;
    var parameterTotal := 0;
    var futureValues: List<FutureValue> = [];
    if monoInstIdx < 0 {
    loop exports as exported {
        if exported.kind == ITEM_KIND_PUBLIC_TYPE {
            mut aliases.pushBack((name = exported.name, target = exported.code, at = -1, end = 0, depth = 0));
            if exported.textValue =!= "" {
                if exported.textValue.startsWithAt(0, "@ifacedef:") {
                    decI := interfaces.decodeInterfaceMeta(exported.textValue);
                    if decI.ok { interfaces.registerInterface(decI.def); }
                } else {
                    defTarget := if exported.code.startsWithAt(0, "@gentpl:") {
                        pDec := types.decodeLengthPrefixedAt(exported.code, 8);
                        tplBody := if pDec.next >= 0 { exported.code.slice(pDec.next, exported.code.length()) } else { "" };
                        ownerK := types.typeOpOwnerKey(tplBody);
                        if ownerK =!= "" { ownerK } else { exported.code }
                    } else {
                        exported.code
                    };
                    aliases = types.appendEncodedRecordDefaults(aliases, defTarget, exported.textValue, 0);
                }
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_IMPL {
            decImp := interfaces.decodeImplMeta(exported.textValue);
            if decImp.ok { interfaces.registerImpl(decImp.def); }
        } else if exported.kind == ITEM_KIND_PUBLIC_CONTEXT {
            cMeta := contexts.decodeAmbientTextMeta(exported.textValue);
            contexts.registerAmbient(contexts.AmbientContext {
                name = exported.name,
                slotKind = exported.code,
                backingKind = cMeta.backingKind,
                runtime = exported.runtime,
                isMut = exported.intValue =!= 0,
                implKey = cMeta.implKey,
                isLocalModule = false
            });
        }
    }
    decls := collectModuleDecls(target, source, prefix, moduleKey);
    loop decls as decl {
        if decl.kind == DECL_KIND_ALIAS {
            endPos := parseDigits(decl.textValue, 0, decl.textValue.length());
            mut aliases.pushBack((name = decl.name, target = decl.code, at = decl.intValue, end = endPos, depth = 0));
        } else if decl.kind == DECL_KIND_PUB_FN {
            mut publishedFunctions.add(decl.name);
            if decl.intValue > 0 { mut publishedFnAts.add(decl.intValue); }
        } else if decl.kind == DECL_KIND_PUB_TYPE_OP {
            mut publishedTypeOps.add(decl.name);
            if decl.intValue > 0 { mut publishedTypeOpAts.add(decl.intValue); }
        } else if decl.kind == DECL_KIND_PUB_VAL {
            mut publishedValues.add(decl.name);
        } else if decl.kind == DECL_KIND_PUB_TYPE {
            mut publishedTypes.add(decl.name);
        } else if decl.kind == DECL_KIND_HAS_INNER_ALIAS {
            hasInnerAlias = true;
        } else if decl.kind == DECL_KIND_HAS_INNER_FN {
            hasInnerFn = true;
        } else if decl.kind == DECL_KIND_ROOT_ASSIGN {
            mut rootAssignedNames.add(decl.name);
        }
    }
    var aiIdx := 0;
    loop aiIdx < aliases.length() {
        aEntry := aliases[aiIdx];
        if aEntry.depth == 0 and aEntry.at >= 0 and
        (aEntry.target.startsWithAt(0, "Iface<") or (aEntry.target.startsWithAt(0, "@gentpl:") and aEntry.target.indexOf("Iface<", 0) >= 0)) {
            afterNameP := skipTrivia(source, source.skipName(aEntry.at), prefix);
            if source.startsWithAt(afterNameP, ":=") {
                afterEqP := skipTrivia(source, afterNameP + 2, prefix);
                if source.wordAt(afterEqP, "interface") {
                    ifaceRes := parseInterfaceDefAt(source, aEntry.at, afterEqP + 9, prefix, aliases, moduleKey, aEntry.name);
                    aliases[aiIdx] = (name = aEntry.name, target = ifaceRes.resolvedCode, at = aEntry.at, end = aEntry.end, depth = 0);
                }
            }
        }
        aiIdx = aiIdx + 1;
    }
    loop rootAssignedNames as rootAssigned {
        mut blockAssignedDecls.pushBack((name = rootAssigned, depth = 0));
    }
    loop exports as exported {
        if exported.kind == ITEM_KIND_MODULE_ALIAS {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported module name " + exported.name);
            }
            comptimeEval.registerModuleImport(moduleKey, exported.name, exported.runtime, exported.code);
            (mut locals).pushBack((name = exported.name, runtime = "", kind = VALUE_KIND_MODULE, mutable = false,
            writable = false, depth = 0, constant = false, code = "", intValue = exported.intValue,
            textValue = exported.name, initState = INIT_STATE_INIT));
        } else if exported.kind == ITEM_KIND_PUBLIC_FUNCTION {
            if localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            existingImpFns := sym.findFunctions(functions, exported.name);
            var alreadyImpFn := false;
            loop existingImpFns as efi {
                if functions[efi].runtime == exported.runtime { alreadyImpFn = true; break; }
            }
            if not alreadyImpFn {
                contexts.registerFnContext(exported.runtime, contexts.extractCtxKindFromParams(exported.textValue));
                impGenP := if exported.runtime.startsWithAt(0, "$gen:") {
                    tIdx := generics.findTemplate(exported.runtime.slice(5, exported.runtime.length()));
                    if tIdx >= 0 { generics.getTemplate(tIdx).genericParams } else { "" }
                } else { "" };
                impSig := overloads.overloadSigKey(exported.name.indexOf(".", 0) < 0 or exported.intValue == 0, impGenP, exported.textValue, exported.intValue);
                overloads.registerFnSig(exported.runtime, impSig, impGenP, exported.textValue);
                first := parameterTotal;
                loop splitPipeEntries(exported.textValue, exported.intValue) as expParam {
                    mut functionParams.pushBack(expParam);
                    parameterTotal = parameterTotal + 1;
                }
                (mut functions).pushBack((name = exported.name, runtime = exported.runtime, result = exported.code,
                first = first, count = exported.intValue, declAt = -1));
                if exported.name.indexOf(".", 0) < 0 and existingImpFns.length() == 0 {
                    mut blockDecls.pushBack((name = exported.name, depth = 0));
                }
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_TYPE_OP {
            existingImpOps := sym.findFunctions(functions, exported.name);
            var alreadyImpOp := false;
            loop existingImpOps as eoi {
                if functions[eoi].runtime == exported.runtime { alreadyImpOp = true; break; }
            }
            if not alreadyImpOp {
                contexts.registerFnContext(exported.runtime, contexts.extractCtxKindFromParams(exported.textValue));
                opGenP := if exported.runtime.startsWithAt(0, "$gen:") {
                    tIdx := generics.findTemplate(exported.runtime.slice(5, exported.runtime.length()));
                    if tIdx >= 0 { generics.getTemplate(tIdx).genericParams } else { "" }
                } else { "" };
                opSig := overloads.overloadSigKey(exported.name.startsWithAt(0, "$statictypeop:"), opGenP, exported.textValue, exported.intValue);
                overloads.registerFnSig(exported.runtime, opSig, opGenP, exported.textValue);
                first := parameterTotal;
                loop splitPipeEntries(exported.textValue, exported.intValue) as expParam {
                    mut functionParams.pushBack(expParam);
                    parameterTotal = parameterTotal + 1;
                }
                (mut functions).pushBack((name = exported.name, runtime = exported.runtime, result = exported.code,
                first = first, count = exported.intValue, declAt = -1));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_VALUE {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            if exported.intValue > 0 {
                impCtId := exported.intValue - 1;
                comptimeEval.registerLocalCtVal(exported.runtime, impCtId);
                ctTok := comptimeEval.comptimeValToken(exported.code, impCtId);
                if ctTok =!= "" {
                    mut aliases.pushBack((name = "$ctv:" + exported.name, target = ctTok, at = -1, end = 0, depth = 0));
                }
            }
            (mut locals).pushBack((name = exported.name, runtime = exported.runtime, kind = exported.code,
            mutable = false, writable = false, depth = 0, constant = false, code = exported.runtime,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if exported.name.indexOf(".", 0) < 0 {
                mut blockDecls.pushBack((name = exported.name, depth = 0));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_TYPE {
            if findAlias(aliases, exported.name) < 0 {
                diagLib.fail(prefix, "unknown imported public type " + exported.name);
            }
            if exported.name.indexOf(".", 0) < 0 {
                mut blockDecls.pushBack((name = exported.name, depth = 0));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_IMPL {
            /* Decoded before decl processing above. */
        }
    }
    loop decls as decl {
        if decl.kind == DECL_KIND_FUTURE_FN {
            fnName := decl.name;
            fnAt := decl.intValue;
            if localIndex(locals, fnName) < 0 {
                var shadowedBefore := false;
                loop decls as priorDecl {
                    if priorDecl.name == fnName and priorDecl.intValue < fnAt and
                    (priorDecl.kind == DECL_KIND_ALIAS or priorDecl.kind == DECL_KIND_FUTURE_DECL) {
                        shadowedBefore = true;
                        break;
                    }
                }
                if not shadowedBefore {
                    headerPos := parseDigits(decl.textValue, 0, decl.textValue.length());
                    fnListIntrinsic := (moduleIdentity == "lite.core.list.v1" and
                    (fnName == "pushBack" or fnName == "popBack" or fnName == "pushFront" or fnName == "popFront" or
                    fnName == "length" or fnName == "setAt" or fnName == "slice" or fnName == "reverse" or fnName == "clear")) or
                    (moduleIdentity == "lite.core.map.v1" and
                    (fnName == "set" or fnName == "get" or fnName == "getOr" or fnName == "has" or
                    fnName == "remove" or fnName == "size" or fnName == "clear" or fnName == "keys" or fnName == "values")) or
                    (moduleIdentity == "lite.core.set.v1" and
                    (fnName == "add" or fnName == "has" or fnName == "remove" or
                    fnName == "size" or fnName == "clear" or fnName == "values")) or
                    (moduleIdentity == "lite.core.rc.v1" and
                    (fnName == "create" or fnName == "get" or fnName == "share" or
                    fnName == "isEmpty" or fnName == "strongCount" or fnName == "ptrEqual" or
                    fnName == "makeUnique" or fnName == "replace" or fnName == "reset")) or
                    (moduleIdentity == "lite.core.slice.v1" and
                    (fnName == "length" or fnName == "isEmpty" or fnName == "uncheckedGet" or
                    fnName == "uncheckedSet" or fnName == "splitAt" or fnName == "toList" or
                    fnName == "$getIndex" or fnName == "$setIndex")) or
                    (moduleIdentity == "lite.core.simd.v1" and
                    (fnName == "splat" or fnName == "fromArray" or fnName == "load" or fnName == "nativeLanes" or
                    fnName == "lanes" or fnName == "toArray" or fnName == "get" or fnName == "$getIndex" or
                    fnName == "withLane" or fnName == "store" or fnName == "add" or fnName == "sub" or
                    fnName == "mul" or fnName == "div" or fnName == "neg" or fnName == "abs" or
                    fnName == "min" or fnName == "max" or fnName == "wrappingAdd" or fnName == "wrappingSub" or
                    fnName == "wrappingMul" or fnName == "bitAnd" or fnName == "bitOr" or fnName == "bitXor" or
                    fnName == "bitNot" or fnName == "fma" or fnName == "sqrt" or fnName == "reduceAdd" or
                    fnName == "wrappingReduceAdd" or fnName == "reduceMin" or fnName == "reduceMax" or
                    fnName == "dot" or fnName == "select")) or
                    (moduleIdentity == "lite.core.soa.v1" and
                    (fnName == "create" or fnName == "withCapacity" or fnName == "length" or fnName == "isEmpty" or
                    fnName == "reserve" or fnName == "clear" or fnName == "pushBack" or fnName == "popBack" or
                    fnName == "swapRemove" or fnName == "get" or fnName == "set" or fnName == "$getIndex" or
                    fnName == "$setIndex" or fnName == "uncheckedGet" or fnName == "uncheckedSet"));
                    if canPreParseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic) {
                        header := parseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic);
                        if types.containsSliceKind(header.result) and not isCoreSliceHostModule(moduleIdentity) {
                            failAt(source, fnAt, prefix, "borrowed Slice<T> cannot escape via function return type");
                        }
                        if types.containsDynKind(header.result) {
