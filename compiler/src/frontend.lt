                    blockAssignedDecls = appendAssignedBagDecls(scopeAssignedBag, blockAssignedDecls, depth);
                    locals = appendBlockFutureLocals(target, source, position, prefix, depth, "", scopeAssignedBag, aliases, functions, functionParams, locals);
                }
                position = skipTrivia(source, position + 1, prefix);
                continue;
            }
        }
        scanDestr := expr.scanDestructureStart(source, position, size, prefix);
        destructureOpen := scanDestr.openPos;
        destructureMutable := scanDestr.isMutable;
        if destructureOpen >= 0 {
            destructure := expr.parseAggregatePattern(source, destructureOpen, prefix, aliases);
            afterTarget := skipTrivia(source, destructure.next, prefix);
            if not source.startsWithAt(afterTarget, ":=") {
                failAt(source, afterTarget, prefix, "expected := after " + destructure.shape + " destructuring target");
            }
            rhs := parseInitializerExpression(target, source, skipTrivia(source, afterTarget + 2, prefix), prefix, locals, functions, functionParams, currentName, "", stmtCtxs, aliases);
            if target == TARGET_TS and currentLive and not currentStopped {
                checkTraceSafety(source, destructureOpen, prefix, rhs.code, currentName, maxFutureAt, locals, functions, futureValues, items);
                locals = mergeOuterCallableUpdatesFromCode(locals, rhs.code);
            }
            if destructure.shape == "tuple" and destructure.count == 0 {
                if destructureMutable {
                    failAt(source, destructureOpen, prefix, "var tuple destructuring needs at least one binding");
                }
                if isTupleKind(rhs.kind) {
                    failAt(source, destructureOpen, prefix, "tuple destructuring expected 0 fields, got " + tupleComponentCount(rhs.kind).toText());
                }
                if rhs.kind =!= VALUE_KIND_UNIT {
                    failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + displayKind(rhs.kind));
                }
                statementNext := consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                position = statementNext;
                if currentLive and not currentStopped {
                    mut items.pushBack((kind = ITEM_KIND_DISCARD, name = VALUE_KIND_UNIT, runtime = "",
                    code = rhs.code, intValue = 0, textValue = ""));
                    if codeHasRawTransfer(rhs.code) {
                        mut transferCodes.pushBack(rhs.code);
                        transferCount = transferCount + 1;
                    }
                }
                continue;
            }
            if destructure.grouped {
                bindPart := types.decodeLengthPrefixedAt(destructure.encodedClauses, 0);
                bindName := bindPart.text;
                rejectNonValueBinding(source, destructureOpen, prefix, rhs.kind, bindName);
                var groupedBindKind := rhs.kind;
                if destructure.groupedType =!= "" {
                    if not isCompatibleKind(destructure.groupedType, rhs.kind) {
                        failAt(source, destructureOpen, prefix, "cannot bind " + displayKind(rhs.kind) + " to " + displayKind(destructure.groupedType));
                    }
                    groupedBindKind = destructure.groupedType;
                }
                statementNext := consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                position = statementNext;
                rejectDuplicateBlockDecl(source, destructureOpen, prefix, blockDecls, depth, bindName);
                mut blockDecls.pushBack((name = bindName, depth = depth));
                bindRuntime := claimOrMakeLocalRuntime(target, locals, bindName, moduleKey, depth);
                bindFnCode := if target == TARGET_TS and containsFnKind(groupedBindKind) { computeCallableRhsDeps(rhs.code) } else { rhs.code };
                mut locals.pushBack((name = bindName, runtime = bindRuntime, kind = groupedBindKind,
                mutable = destructureMutable, writable = false, depth = depth, constant = false, code = bindFnCode,
                intValue = rhs.intValue, textValue = rhs.textValue, initState = INIT_STATE_INIT));
                if currentLive and not currentStopped {
                    itemPrefix := if destructureMutable { ITEM_PREFIX_VAR } else { ITEM_PREFIX_LOCAL };
                    destrCode := assignValueCode(target, groupedBindKind, rhs.kind, rhs.code);
                    mut items.pushBack((kind = itemPrefix + storageKind(groupedBindKind), name = bindName, runtime = bindRuntime,
                    code = destrCode, intValue = rhs.intValue, textValue = storageTextPayload(groupedBindKind, rhs.textValue)));
                    if codeHasRawTransfer(destrCode) {
                        mut transferCodes.pushBack(destrCode);
                        transferCount = transferCount + 1;
                    }
                }
                continue;
            }
            tempPrefix := if destructure.shape == "record" { "lite$rec" } else if destructure.shape == "array" { "lite$arr" } else { "lite$tuple" };
            tempSlot := if destructure.shape == "record" { "$rec" } else if destructure.shape == "array" { "$arr" } else { "$tuple" };
            tempItemKind := if destructure.shape == "record" { ITEM_KIND_LOCAL_RECORD } else if destructure.shape == "array" { ITEM_KIND_LOCAL_LIST } else { ITEM_KIND_LOCAL_TUPLE };
            tempRuntime := freshScopeTemp(locals, tempPrefix);
            resolvedBindings := expr.resolveAggregateBindings(target, destructure.shape, destructure.count, destructure.encodedClauses, rhs.kind, tempRuntime, source, destructureOpen, prefix);
            statementNext := consumeStatementEnd(source, rhs.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + destructure.shape + " destructuring"); }
            position = statementNext;
            aggCode := if target == TARGET_TS and containsFnKind(rhs.kind) { computeCallableRhsDeps(rhs.code) } else { "" };
            mut locals.pushBack((name = tempSlot, runtime = tempRuntime, kind = VALUE_KIND_UNIT,
            mutable = false, writable = false, depth = depth, constant = false, code = aggCode,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if currentLive and not currentStopped {
                mut items.pushBack((kind = tempItemKind, name = "", runtime = tempRuntime,
                code = rhs.code, intValue = 0, textValue = storageTextPayload(rhs.kind, "")));
                if codeHasRawTransfer(rhs.code) {
                    mut transferCodes.pushBack(rhs.code);
                    transferCount = transferCount + 1;
                }
            }
            pendingDestrNames: mut List<String> = [];
            var bCursor := 0;
            var bIndex := 0;
            loop bIndex < destructure.count {
                bindPart := types.decodeLengthPrefixedAt(resolvedBindings, bCursor);
                propPart := types.decodeLengthPrefixedAt(resolvedBindings, bindPart.next);
                srcPart := types.decodeLengthPrefixedAt(resolvedBindings, propPart.next);
                tgtPart := types.decodeLengthPrefixedAt(resolvedBindings, srcPart.next);
                bCursor = tgtPart.next;
                bindName := bindPart.text;
                propExpr := propPart.text;
                srcKind := srcPart.text;
                bindKind := tgtPart.text;
                if not (destructure.shape == "record" and bindName == "_") {
                    rejectDuplicateBlockDecl(source, destructureOpen, prefix, blockDecls, depth, bindName);
                    if depth == 0 {
                        mut blockDecls.pushBack((name = bindName, depth = depth));
                    } else if not listLib.listContainsText(pendingDestrNames, bindName) {
                        mut pendingDestrNames.pushBack(bindName);
                    }
                    bindRuntime := claimOrMakeLocalRuntime(target, locals, bindName, moduleKey, depth);
                    fieldCode := assignValueCode(target, bindKind, srcKind, propExpr);
                    fieldLocalCode := if target == TARGET_TS and containsFnKind(bindKind) { computeCallableRhsDeps(fieldCode) } else { fieldCode };
                    mut locals.pushBack((name = bindName, runtime = bindRuntime, kind = bindKind,
                    mutable = destructureMutable, writable = false, depth = depth, constant = false, code = fieldLocalCode,
                    intValue = 0, textValue = "", initState = INIT_STATE_INIT));
                    if currentLive and not currentStopped {
                        itemPrefix := if destructureMutable { ITEM_PREFIX_VAR } else { ITEM_PREFIX_LOCAL };
                        mut items.pushBack((kind = itemPrefix + storageKind(bindKind), name = bindName, runtime = bindRuntime,
