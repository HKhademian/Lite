                    scanPos = skipTrivia(source, fEnd, prefix);
                }
                recCompOp := if chainValid and scanPos < size { compoundAssignOp(source, scanPos) } else { (op = "", baseOp = "", width = 0) };
                chainLen := fieldChain.length();
                if chainValid and chainLen >= 1 and chainLen <= 2 and scanPos < size and (isSingleEquals(source, scanPos) or recCompOp.width > 0) {
                    if isLtModule and blockCount == 0 {
                        failAt(source, nameStart, prefix, "top-level assignment is not allowed in .lt module");
                    }
                    entry := locals[recLocalIdx];
                    if entry.initState =!= INIT_STATE_INIT {
                        failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
                    }
                    if not entry.mutable and not entry.writable {
                        failAt(source, nameStart, prefix, "cannot mutate field of immutable local " + name);
                    }
                    sliceBorrows.checkCanMutateBinding(locals, entry.runtime, name, source, nameStart, prefix);
                    if target =!= TARGET_TS and types.cStructTag(entry.kind) == "" {
                        failAt(source, nameStart, prefix, "C backend does not support record field assignment yet");
                    }
                    opPos := scanPos;
                    opWidth := if recCompOp.width > 0 { recCompOp.width } else { 1 };
                    rhsStart := skipTrivia(source, opPos + opWidth, prefix);
                    rhsParsed := parseExpressionAsCtx(target, source, rhsStart, prefix, locals, functions, functionParams, currentName, curKind, stmtCtxs, aliases);
                    if not types.isCompatibleKind(curKind, rhsParsed.kind) {
                        failAt(source, rhsStart, prefix, "cannot assign " + displayKind(rhsParsed.kind) + " to field of type " + displayKind(curKind));
                    }
                    f0 := fieldChain[0];
                    f0RawProp := if types.isRecordKind(entry.kind) { types.recordComponentProp(entry.kind, f0) } else { f0 };
                    f0Prop := if target == TARGET_C { types.cFieldName(f0RawProp) } else { f0RawProp };
                    stmtCode := if chainLen == 1 {
                        lhsPath := if target == TARGET_C { "(" + entry.runtime + ")." + f0Prop } else { types.tsRecordFieldAccess(entry.runtime, f0) };
                        rhsCode := if recCompOp.width > 0 {
                            compoundAssignCode(target, source, opPos, prefix, curKind, lhsPath, recCompOp.baseOp, rhsParsed)
                        } else {
                            assignValueCode(target, curKind, rhsParsed.kind, rhsParsed.code)
                        };
                        if target == TARGET_C {
                            fieldDrop := types.cDropFnForKind(curKind);
                            if fieldDrop =!= "" {
                                cFT := types.cValueType(curKind);
                                if rhsCode.startsWithAt(0, "/*@CBLK:") {
                                    tmpF := "lt_fv_" + opPos.toText();
                                    "{ /*c-stmt*/ " + cFT + " " + tmpF + "; " + ctx.cUnwrapIntoVar(tmpF, curKind, rhsCode) + " " + fieldDrop + "(&(" + entry.runtime + "." + f0Prop + ")); " + entry.runtime + "." + f0Prop + " = " + tmpF + "; }"
                                } else {
                                    "{ /*c-stmt*/ " + cFT + " lt_fv = " + rhsCode + "; " + fieldDrop + "(&(" + entry.runtime + "." + f0Prop + ")); " + entry.runtime + "." + f0Prop + " = lt_fv; }"
                                }
                            } else {
                                "(" + entry.runtime + "." + f0Prop + " = " + rhsCode + ")"
                            }
                        } else {
                            "(" + entry.runtime + " = { ...(" + entry.runtime + "), " + types.tsRecordPropKey(f0) + ": " + rhsCode + " })"
                        }
                    } else {
                        f1 := fieldChain[1];
                        f0Kind := if types.isRecordKind(entry.kind) { types.recordFieldKind(entry.kind, f0) } else { types.tupleFieldKind(entry.kind, f0) };
                        f1RawProp := if types.isRecordKind(f0Kind) { types.recordComponentProp(f0Kind, f1) } else { f1 };
                        f1Prop := if target == TARGET_C { types.cFieldName(f1RawProp) } else { f1RawProp };
                        subPath := if target == TARGET_C { "(" + entry.runtime + ")." + f0Prop } else { types.tsRecordFieldAccess(entry.runtime, f0) };
                        lhsPath := if target == TARGET_C { "(" + subPath + ")." + f1Prop } else { types.tsRecordFieldAccess(subPath, f1) };
                        rhsCode := if recCompOp.width > 0 {
                            compoundAssignCode(target, source, opPos, prefix, curKind, lhsPath, recCompOp.baseOp, rhsParsed)
                        } else {
                            assignValueCode(target, curKind, rhsParsed.kind, rhsParsed.code)
                        };
                        if target == TARGET_C {
                            fieldDrop := types.cDropFnForKind(curKind);
                            if fieldDrop =!= "" {
                                cFT := types.cValueType(curKind);
                                if rhsCode.startsWithAt(0, "/*@CBLK:") {
                                    tmpF := "lt_fv_" + opPos.toText();
                                    "{ /*c-stmt*/ " + cFT + " " + tmpF + "; " + ctx.cUnwrapIntoVar(tmpF, curKind, rhsCode) + " " + fieldDrop + "(&(" + entry.runtime + "." + f0Prop + "." + f1Prop + ")); " + entry.runtime + "." + f0Prop + "." + f1Prop + " = " + tmpF + "; }"
                                } else {
                                    "{ /*c-stmt*/ " + cFT + " lt_fv = " + rhsCode + "; " + fieldDrop + "(&(" + entry.runtime + "." + f0Prop + "." + f1Prop + ")); " + entry.runtime + "." + f0Prop + "." + f1Prop + " = lt_fv; }"
                                }
                            } else {
                                "(" + entry.runtime + "." + f0Prop + "." + f1Prop + " = " + rhsCode + ")"
                            }
                        } else {
                            "(" + entry.runtime + " = { ...(" + entry.runtime + "), " + types.tsRecordPropKey(f0) + ": { ...(" + subPath + "), " + types.tsRecordPropKey(f1) + ": " + rhsCode + " } })"
                        }
                    };
                    locals = checkStatementTrace(target, source, nameStart, prefix, stmtCode, false, "", currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
                    statementNext := consumeStatementEnd(source, rhsParsed.next, prefix);
                    if statementNext < 0 { failAt(source, skipTrivia(source, rhsParsed.next, prefix), prefix, "expected ; after field assignment"); }
                    position = statementNext;
                    if currentLive and not currentStopped {
                        mut items.pushBack((kind = ITEM_KIND_CALL, name = "", runtime = "", code = stmtCode, intValue = 0, textValue = ""));
                        if codeHasRawTransfer(stmtCode) {
                            mut transferCodes.pushBack(stmtCode);
                            transferCount = transferCount + 1;
                        }
                    }
                    continue;
                }
            }
        }
        if isSingleEquals(source, position) {
            if isLtModule and blockCount == 0 {
                failAt(source, nameStart, prefix, "top-level assignment is not allowed in .lt module");
            }
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            origEntryTop := expr.unwrapUnionOrigin(entry);
            assignRtTop := origEntryTop.rt;
            assignKTop := origEntryTop.kind;
            isUnarrowTop := entry.textValue.startsWithAt(0, "$unarrow:");
            if entry.initState == INIT_STATE_INIT and not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            partialItems := parsePartialAssignIf(target, source, position, prefix, locals, functions, functionParams, currentName, nameStart, assignKTop, name, assignRtTop, stmtCtxs, aliases);
            var partialCount := 0;
            var partialMeta := "";
            loop partialItems as piChk {
                partialCount = partialCount + 1;
                if piChk.kind == ITEM_KIND_END { partialMeta = piChk.textValue; }
            }
            if partialCount > 0 {
                if not ctx.partialAssignAllowedForImmutable(entry, partialMeta) {
                    failAt(source, nameStart, prefix, "cannot assign to possibly initialized immutable local " + name);
                }
                sliceBorrows.checkCanMutateBinding(locals, assignRtTop, name, source, nameStart, prefix);
                var partialFnDeps := entry.code;
                loop partialItems as partialItem {
                    if partialItem.kind == ITEM_KIND_END {
                        position = partialItem.intValue;
                    } else {
                        locals = checkStatementTrace(target, source, nameStart, prefix, partialItem.code, false, "", currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
                        if target == TARGET_TS and containsFnKind(assignKTop) and partialItem.code =!= "" {
                            partialFnDeps = mergeCallableLocalDeps(partialFnDeps, computeCallableRhsDeps(partialItem.code));
                        }
                        if currentLive and not currentStopped {
                            mut items.pushBack(partialItem);
                            if codeHasRawTransfer(partialItem.code) {
                                mut transferCodes.pushBack(partialItem.code);
                                transferCount = transferCount + 1;
                            }
                        }
                    }
                }
                partialLocalCode := if target == TARGET_TS and containsFnKind(assignKTop) { partialFnDeps } else { assignRtTop };
                nextPInit := ctx.computePartialAssignNextInitState(entry, partialMeta);
                mut locals.pushBack((name = entry.name, runtime = assignRtTop, kind = assignKTop,
                mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = partialLocalCode,
                intValue = 0, textValue = "", initState = nextPInit));
                continue;
            }
            if ir.isInitStateMaybe(entry.initState) and not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to possibly initialized immutable local " + name);
            }
            sliceBorrows.checkCanMutateBinding(locals, assignRtTop, name, source, nameStart, prefix);
            parsed := parseExpressionAsCtx(target, source, position, prefix, locals, functions, functionParams, currentName, assignKTop, stmtCtxs, aliases);
            var assignCode := parsed.code;
            var assignText := parsed.textValue;
            var wasDynAssign := false;
            if types.isDynKind(assignKTop) {
                mut dummyDrops: List<String> = [];
                dynC := expr.coerceToDynIfNeeded(target, source, nameStart, prefix, assignKTop, entry.writable, parsed.kind, parsed.code, parsed.textValue, false, locals, functions, mut dummyDrops);
                if dynC.matched {
                    wasDynAssign = true;
                    assignCode = dynC.code;
                    assignText = dynC.textValue;
                }
            }
            if not wasDynAssign and not isCompatibleKind(assignKTop, parsed.kind) {
                failAt(source, nameStart, prefix, "cannot assign " + displayKind(parsed.kind) + " to " + displayKind(assignKTop) + " local " + name);
            }
            sliceBorrows.checkSliceAssignDepth(assignKTop, entry.depth, assignText, source, nameStart, prefix);
            assignBorrow := sliceBorrows.borrowTagForBinding(assignKTop, entry.writable, assignText);
            if not assignBorrow.ok { failAt(source, nameStart, prefix, assignBorrow.error); }
            locals = checkStatementTrace(target, source, nameStart, prefix, assignCode, false, "", currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after assignment to " + name); }
            position = statementNext;
            rhsDiverged := parsed.kind == VALUE_KIND_NEVER;
            assignedCode := if wasDynAssign { assignCode } else { assignValueCode(target, assignKTop, parsed.kind, parsed.code) };
            assignLocalCode := if target == TARGET_TS and containsFnKind(assignKTop) {
                newDeps := computeCallableRhsDeps(parsed.code);
                if entry.depth == depth { newDeps } else { mergeCallableLocalDeps(entry.code, newDeps) }
            } else { assignedCode };
            mut locals.pushBack((name = entry.name, runtime = assignRtTop, kind = assignKTop,
            mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = assignLocalCode,
            intValue = parsed.intValue, textValue = if isUnarrowTop { "" } else { assignBorrow.textValue }, initState = INIT_STATE_INIT));
            if currentLive and not currentStopped {
                if rhsDiverged {
                    mut items.pushBack((kind = expressionStatementKind(VALUE_KIND_NEVER, false, ITEM_KIND_CALL, currentResult), name = "", runtime = "",
                    code = assignedCode, intValue = 0, textValue = ""));
                } else {
                    mut items.pushBack((kind = ITEM_PREFIX_ASSIGN + storageKind(assignKTop), name = name, runtime = assignRtTop,
                    code = assignedCode, intValue = parsed.intValue, textValue = storageTextPayload(assignKTop, parsed.textValue)));
                }
                if codeHasRawTransfer(assignedCode) {
                    mut transferCodes.pushBack(assignedCode);
                    transferCount = transferCount + 1;
                }
            }
            if rhsDiverged {
                if not currentStopped { currentReturned = true; }
                currentStopped = true;
            }
            continue;
        }
        if compoundAssignOp(source, position).width > 0 {
            if isLtModule and blockCount == 0 {
                failAt(source, nameStart, prefix, "top-level assignment is not allowed in .lt module");
            }
            compound := compoundAssignOp(source, position);
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            if entry.initState =!= INIT_STATE_INIT {
                failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
            }
            if not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            sliceBorrows.checkCanMutateBinding(locals, entry.runtime, name, source, nameStart, prefix);
            opPos := position;
            position = skipTrivia(source, position + compound.width, prefix);
            parsed := parseExpressionAsCtx(target, source, position, prefix, locals, functions, functionParams, currentName, entry.kind, stmtCtxs, aliases);
            locals = checkStatementTrace(target, source, nameStart, prefix, parsed.code, false, "", currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
            assignedCode := compoundAssignCode(target, source, opPos, prefix, entry.kind, entry.runtime, compound.baseOp, parsed);
            statementNext := consumeStatementEnd(source, parsed.next, prefix);
            if statementNext < 0 { failAt(source, skipTrivia(source, parsed.next, prefix), prefix, "expected ; after assignment to " + name); }
            position = statementNext;
            mut locals.pushBack((name = entry.name, runtime = entry.runtime, kind = entry.kind,
            mutable = entry.mutable, writable = entry.writable, depth = entry.depth, constant = false, code = assignedCode,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if currentLive and not currentStopped {
                mut items.pushBack((kind = ITEM_PREFIX_ASSIGN + storageKind(entry.kind), name = name, runtime = entry.runtime,
                code = assignedCode, intValue = 0, textValue = ""));
                if codeHasRawTransfer(assignedCode) {
                    mut transferCodes.pushBack(assignedCode);
                    transferCount = transferCount + 1;
                }
            }
            continue;
        }
        if isLtModule and blockCount == 0 {
            failAt(source, nameStart, prefix, "top-level runtime statement is not allowed in .lt module");
        }
        expression := parseExpressionItem(target, source, nameStart, prefix, locals, functions, functionParams, currentName,
        currentResult, atValueTail(blocks, blockCount) and not currentStopped, stmtCtxs, aliases);
        locals = checkStatementTrace(target, source, nameStart, prefix, expression.code, expression.returned, currentResult, currentName, maxFutureAt, locals, functions, futureValues, items, currentLive and not currentStopped);
        if currentLive and not currentStopped {
            mut items.pushBack((kind = expressionStatementKind(expression.valueKind, expression.returned, ITEM_KIND_DISCARD, currentResult), name = expression.valueKind,
            runtime = "", code = expression.code, intValue = 0, textValue = ""));
            if codeHasRawTransfer(expression.code) {
                mut transferCodes.pushBack(expression.code);
                transferCount = transferCount + 1;
            }
        }
        if expression.returned or expression.valueKind == VALUE_KIND_NEVER {
            if not currentStopped { currentReturned = true; }
            currentStopped = true;
        }
        position = expression.next;
    }
    if blockCount > 0 {
        failAt(source, size, prefix, "expected } before end of source");
    }
    if monoInstIdx < 0 {
        if currentStopped {
            mut items.pushBack((kind = ITEM_KIND_MAIN_STOP, name = "", runtime = "", code = "", intValue = 0, textValue = ""));
        }
        mut rootAssignedList: List<String> = [];
        loop rootAssignedNames as ra { mut rootAssignedList.pushBack(ra); }
        contexts.saveModuleAmbient(moduleKey);
        generics.saveModuleEnv(moduleKey, locals, functions, functionParams, aliases, futureValues, rootAssignedList);
    }
    items
}

/** Parses complete source with selective function-body compilation and explicit `--builtin-mode` specs. */
pub parseProgramWithModuleSelectiveSpecs := fn(target: String, source: String, prefix: String, exports: Items, moduleKey: String,
moduleIdentity: String, neededFns: String, skipSoftBuiltins: Bool, builtinSpecs: List<String>): Items {
    parseProgramWithModuleInternal(target, source, prefix, exports, moduleKey, moduleIdentity, neededFns, skipSoftBuiltins, builtinSpecs, -1)
}

/** Compiles one queued generic monomorphization instance into ordinary function IR items. */
pub compileGenericInstance := fn(target: String, instIdx: Int): Items {
    emptyExports: Items = [];
    emptySpecs: List<String> = [];
    parseProgramWithModuleInternal(target, "", "", emptyExports, "", "", "*", false, emptySpecs, instIdx)
}

/** Drains all pending generic monomorphizations to fixed point, returning flat items grouped by `ITEM_KIND_MONO_OWNER` markers. */
pub drainGenericInstances := fn(target: String): Items {
    mut out: Items = [];
    loop true {
        nextIdx := generics.nextUncompiledInstanceIndex();
        if nextIdx < 0 { break; }
        generics.markInstanceCompiled(nextIdx);
        inst := generics.getInstance(nextIdx);
        compiledItems := compileGenericInstance(target, nextIdx);
        mut out.pushBack((kind = ITEM_KIND_MONO_OWNER, name = "", runtime = inst.moduleKey, code = "", intValue = 0, textValue = ""));
        loop compiledItems as ci { mut out.pushBack(ci); }
    }
    out
}

/** Parses complete source with selective function-body compilation (`neededFns = "*"` compiles every function). */
pub parseProgramWithModuleSelective := fn(target: String, source: String, prefix: String, exports: Items, moduleKey: String,
moduleIdentity: String, neededFns: String, skipSoftBuiltins: Bool): Items {
    emptySpecs: List<String> = [];
    parseProgramWithModuleSelectiveSpecs(target, source, prefix, exports, moduleKey, moduleIdentity, neededFns, skipSoftBuiltins, emptySpecs)
}

/** Parses complete source with imported public function signatures available in its root symbol table. Exits 2 on unsupported, malformed or faulting source. */
pub parseProgramWithModule := fn(target: String, source: String, prefix: String, exports: Items, moduleKey: String,
moduleIdentity: String): Items {
    parseProgramWithModuleSelective(target, source, prefix, exports, moduleKey, moduleIdentity, "*", false)
}

/** Transitional numeric-module-id adapter delegating to `parseProgramWithModule`. */
pub parseProgramWithIdentity := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int,
moduleIdentity: String): Items {
    moduleKey := if moduleId == 0 { "" } else { "m" + moduleId.toText() };
    parseProgramWithModule(target, source, prefix, exports, moduleKey, moduleIdentity)
}

/** Transitional five-argument graph adapter retained until source identities reach every compiler caller. */
pub parseProgramWithExports := fn(target: String, source: String, prefix: String, exports: Items, moduleId: Int): Items {
    parseProgramWithIdentity(target, source, prefix, exports, moduleId, "")
}

/** Parses one source without imported public symbols. */
pub parseProgram := fn(target: String, source: String, prefix: String): Items {
    types.resetAll();
    generics.resetAll();
    interfaces.resetAll();
    contexts.resetAll();
    overloads.resetAll();
    base := parseProgramWithModule(target, source, prefix, [], "", "");
    monoItems := drainGenericInstances(target);
    if monoItems.length() == 0 { return base; }
    mut out: Items = [];
    loop base as item { mut out.pushBack(item); }
    loop monoItems as mi {
        if mi.kind =!= ITEM_KIND_MONO_OWNER { mut out.pushBack(mi); }
    }
    out
}

/** Encodes all line-start character offsets once for positioned runtime arithmetic faults. */
pub lineStartCodes := fn(source: String): String { syntax.lineStartCodes(source) };
