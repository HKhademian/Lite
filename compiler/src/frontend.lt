                        if not dupOpSig and afterHdr < size and source.at(afterHdr) == ";" {
                            hostRuntime := builtinsAbi.coreHostFunction(moduleIdentity, qualName, header.params, header.result);
                            if publishedTypeOps.has(qualName) and hostRuntime =!= "" {
                                comptimeEval.registerFnDef(hostRuntime, qualName, moduleKey, moduleIdentity, source, prefix, opAt, afterHdr, header.params, header.count, header.result, true, aliases);
                                contexts.registerFnContext(hostRuntime, contexts.extractCtxKindFromParams(header.params));
                                overloads.registerFnSig(hostRuntime, sigKey, header.genericType, header.params);
                                mut functions.pushBack((name = typeOpKey, runtime = hostRuntime, result = header.result,
                                first = parameterTotal, count = header.count, declAt = opAt));
