/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit { syntax.failAt(source, position, prefix, message); };

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int { syntax.expectSymbol(source, position, symbol, prefix) };

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int { syntax.skipComment(source, position, prefix) };

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int { syntax.skipTrivia(source, start, prefix) };

/** Consumes an explicit separator or an implicit boundary at EOF, a closing scope or a directly closed block expression. Returns -1 when a simple item still needs a separator. */
consumeStatementEnd := fn(source: String, position: Int, prefix: String): Int { syntax.consumeStatementEnd(source, position, prefix) };

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool { syntax.isReservedWord(name) };

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit { syntax.unsupportedFeature(source, position, name, prefix); };

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int { sym.findFunction(functions, name) };

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool { types.isUnsupportedAliasTarget(name) };

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit { types.unsupportedAliasTarget(source, position, prefix, target); };

/** Returns the index of the first visible alias named `name` at the innermost active block depth, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int { types.findAlias(aliases, name) };

/** Reads one local or module-qualified type name. */
typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) { types.typeNameAt(source, position, prefix) };

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int { types.aliasIndexAt(aliases, position) };

/** Returns the highest block depth present in `aliases`, or 0 when `aliases` is empty. */
maxAliasDepth := fn(aliases: List<AliasDecl>): Int { types.maxAliasDepth(aliases) };

/** Drops aliases declared at block depth `depth` or deeper when exiting a block. */
popBlockAliases := fn(aliases: List<AliasDecl>, depth: Int): List<AliasDecl> { types.popBlockAliases(aliases, depth) };

/** Filters `aliases` to declarations at or above `maxDepth` for lexical outer-alias expansion. */
aliasesUpToDepth := fn(aliases: List<AliasDecl>, maxDepth: Int): List<AliasDecl> { types.aliasesUpToDepth(aliases, maxDepth) };

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool { types.isTupleKind(kind) };

/** True when `kind` is this compiler's canonical nominal record kind `Record<id#at#DisplayName;f1:K1,...>`. */
pub isMapKind := fn(kind: String): Bool { types.isMapKind(kind) };
/** True when `kind` is a `Set<T>` type kind. */
pub isSetKind := fn(kind: String): Bool { types.isSetKind(kind) };
/** True when `kind` is a nominal `enum` type kind. */
pub isEnumKind := fn(kind: String): Bool { types.isEnumKind(kind) };
/** True when `kind` is a payload-bearing nominal `enum` type kind. */
pub isPayloadEnumKind := fn(kind: String): Bool { types.isPayloadEnumKind(kind) };
/** Returns the user-facing display name for an enum `kind`. */
pub enumDisplayName := fn(kind: String): String { types.enumDisplayName(kind) };
/** Returns the number of declared cases in an enum `kind`. */
pub enumCaseCount := fn(kind: String): Int { types.enumCaseCount(kind) };
/** Returns the case name at `index` in an enum `kind`. */
pub enumCaseNameAt := fn(kind: String, index: Int): String { types.enumCaseAt(kind, index).name };
/** Returns the number of payload fields attached to `caseIndex` of enum `kind`. */
pub enumCasePayloadCount := fn(kind: String, caseIndex: Int): Int { types.enumCasePayloadCount(kind, caseIndex) };
/** Returns canonical payload type kind at `(caseIndex, payloadIndex)` of payload enum `kind`. */
pub enumCasePayloadKind := fn(kind: String, caseIndex: Int, payloadIndex: Int): String { types.enumCasePayloadKind(kind, caseIndex, payloadIndex) };
/** Returns the C11 list typedef tag for element kind `elemKind`. */
pub cListTag := fn(elemKind: String): String { types.cListTag(elemKind) };
/** Returns the C11 element type name for list typedef `tag`. */
pub cListElemType := fn(tag: String): String { types.cListElemType(tag) };
/** Returns the C11 struct typedef tag for tuple or record `kind`. */
pub cStructTag := fn(kind: String): String { types.cStructTag(kind) };
/** Returns the C11 function-value typedef tag for callable `kind`. */
pub cFnTag := fn(kind: String): String { types.cFnTag(kind) };
/** Returns the C11 struct field identifier for Lite property `prop`. */
pub cFieldName := fn(prop: String): String { types.cFieldName(prop) };
/** Encodes a Lite identifier segment into a deterministic C11-safe identifier. */
pub cSafeIdent := fn(name: String): String { ir.cSafeIdent(name) };
/** True when C11 representation of `kind` contains a list field. */
pub cTypeHasListField := fn(kind: String): Bool { types.cTypeHasListField(kind) };
/** Returns the C11 tuple conversion helper name between `actualKind` and `expectedKind`. */
pub cTupleConvertName := fn(expectedKind: String, actualKind: String): String { types.cTupleConvertName(expectedKind, actualKind) };
/** Returns the C11 map key tag for `kKind`. */
pub cMapKeyTag := fn(kKind: String): String { types.cMapKeyTag(kKind) };
/** Returns the C11 map value tag for `vKind`. */
pub cMapValTag := fn(vKind: String): String { types.cMapValTag(vKind) };
/** Returns the C11 map typedef tag for `kind`. */
pub cMapTag := fn(kind: String): String { types.cMapTag(kind) };
/** Returns the C11 set typedef tag for `kind`. */
pub cSetTag := fn(kind: String): String { types.cSetTag(kind) };
/** Extracts the key kind from a `Map<K, V>` kind. */
pub mapKeyKind := fn(kind: String): String { types.mapKeyKind(kind) };
/** Extracts the value kind from a `Map<K, V>` kind. */
pub mapValueKind := fn(kind: String): String { types.mapValueKind(kind) };
/** Extracts the element kind from a `Set<T>` kind. */
pub setElementKind := fn(kind: String): String { types.setElementKind(kind) };
/** Returns the user-facing display name for a nominal record `kind`. */
pub recordDisplayName := fn(kind: String): String { types.recordDisplayName(kind) };
/** Returns the number of fields in a nominal record `kind`. */
pub recordComponentCount := fn(kind: String): Int { types.recordComponentCount(kind) };
/** Returns the field label, kind, and runtime prop at `targetIndex` of a nominal record `kind`. */
pub recordComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) { types.recordComponent(kind, targetIndex) };
/** True when `kind` is a nominal `record` type kind. */
pub isRecordKind := fn(kind: String): Bool { types.isRecordKind(kind) };
/** True when `kind` is a nominal `distinct` type kind. */
pub isDistinctKind := fn(kind: String): Bool { types.isDistinctKind(kind) };
/** Returns the user-facing display name for a nominal distinct `kind`. */
pub distinctDisplayName := fn(kind: String): String { types.distinctDisplayName(kind) };
/** Returns the 1-step underlying kind wrapped by a nominal distinct `kind`. */
pub distinctUnderlyingKind := fn(kind: String): String { types.distinctUnderlyingKind(kind) };
/** Unwraps nested nominal distinct kinds to the concrete representation kind. */
pub distinctBaseKind := fn(kind: String): String { types.distinctBaseKind(kind) };
/** True when `kind` is a nominal record or a distinct type whose base representation is a nominal record. */
pub isRecordOrDistinctRecord := fn(kind: String): Bool { types.isRecordOrDistinctRecord(kind) };

/** Returns the runtime JS property name for a tuple field (`_0` when unnamed, otherwise the field label). */
pub tupleRuntimeProp := fn(label: String, index: Int): String { types.tupleRuntimeProp(label, index) };

/** Returns the JS/TS object-literal property key for a tuple field, quoting `__proto__` to avoid prototype mutation. */
pub tupleObjectKey := fn(label: String, index: Int): String { types.tupleObjectKey(label, index) };

/** Advances past one canonical type-kind token starting at `start` (scalar, `List<...>`, `[T;N]`, tuple, or `fn(...)`). */
skipKindToken := fn(kind: String, start: Int): Int { types.skipKindToken(kind, start) };

/** True when `kind` is a canonical callable kind `fn(...):ResultKind`. */
pub isFnKind := fn(kind: String): Bool { types.isFnKind(kind) };

/** Returns the canonical return kind from `fn(...):ResultKind`. */
pub fnResultKind := fn(kind: String): String { types.fnResultKind(kind) };

/** Parses `label:Kind` components inside a parameter list `fn(...)`; returns parameter count. */
pub fnParamCount := fn(kind: String): Int { types.fnParamCount(kind) };

/** Returns `(label, kind)` for parameter `targetIndex` of a canonical `fn(...):Ret` kind. */
pub fnParamComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String) { types.fnParamComponent(kind, targetIndex) };

/** Converts a canonical `fn(...):Ret` kind into `name=kind` parameter entries compatible with call routing. */
fnParamEntries := fn(kind: String): List<String> { types.fnParamEntries(kind) };

/** Removes parameter labels from a canonical `fn` kind when joining differently labeled callable branches. */
fnStripLabels := fn(kind: String): String { types.fnStripLabels(kind) };

/** Returns the number of components in one canonical flat tuple kind. */
pub tupleComponentCount := fn(kind: String): Int { types.tupleComponentCount(kind) };

/** Returns the label, scalar kind and runtime property name of component `targetIndex` in a canonical tuple kind. */
pub tupleComponent := fn(kind: String, targetIndex: Int): (label: String, kind: String, prop: String) { types.tupleComponent(kind, targetIndex) };

/** Converts one tuple expression to `expectedKind` by copying positional components into the receiving labels. */
pub convertTupleValue := fn(expectedKind: String, actualKind: String, actualCode: String): String { types.convertTupleValue(expectedKind, actualKind, actualCode) };

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
pub isListKind := fn(kind: String): Bool { types.isListKind(kind) };

/** Returns the canonical element kind from `List<ElementKind>`. */
pub listElementKind := fn(kind: String): String { types.listElementKind(kind) };

/** True when `kind` is this compiler's canonical fixed-array kind, written `[ElementKind;Extent]`. */
pub isArrayKind := fn(kind: String): Bool { types.isArrayKind(kind) };

/** Returns the canonical element kind from `[ElementKind;Extent]`. */
pub arrayElementKind := fn(kind: String): String { types.arrayElementKind(kind) };

/** Parses non-negative decimal digits in `text` from `start` to `end`. */
parseDigits := fn(text: String, start: Int, end: Int): Int { syntax.parseDigits(text, start, end) };

/** Returns the integer extent from `[ElementKind;Extent]`. */
pub arrayExtent := fn(kind: String): Int { types.arrayExtent(kind) };

/** True when `expectedKind` and `actualKind` are callable kinds with matching parameter and return shapes. */
pub fnShapeMatches := fn(expectedKind: String, actualKind: String): Bool { types.fnShapeMatches(expectedKind, actualKind) };

/** True when `kind` is or contains a callable function kind (for display and backend checks). */
pub containsFnKind := fn(kind: String): Bool { types.containsFnKind(kind) };

/** True when `expectedKind` and `actualKind` are tuples with identical component counts and positional component types. */
pub tupleShapeMatches := fn(expectedKind: String, actualKind: String): Bool { types.tupleShapeMatches(expectedKind, actualKind) };

/** True when `actualKind` is directly `expectedKind`, `Never` into a known target, losslessly widens numerically, or matches a compatible tuple/callable shape. */
pub isCompatibleKind := fn(expectedKind: String, actualKind: String): Bool { types.isCompatibleKind(expectedKind, actualKind) };

/** Maps a restricted Lite scalar, flat named-tuple, fixed-array, List or callable kind to its TypeScript type. */
pub tsFunctionType := fn(kind: String): String { types.tsFunctionType(kind) };

/** Formats one canonical flat tuple kind as a TypeScript object type. */
pub tsTupleType := fn(kind: String): String { types.tsTupleType(kind) };

/** Formats an admitted output value using its static kind; aggregates evaluate once and retain tuple labels. */
pub tsDisplayValueCode := fn(kind: String, code: String): String { types.tsDisplayValueCode(kind, code) };

/** True when emitted target code calls `needle` outside quoted String literal text. */
codeUsesTextCall := fn(code: String, needle: String): Bool { reach.codeUsesTextCall(code, needle) };

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
pub codeUsesListIndex := fn(code: String): Bool { reach.codeUsesListIndex(code) };

/** True when emitted target code calls a checked list-pop helper outside quoted String literal text. */
pub codeUsesListPop := fn(code: String): Bool { reach.codeUsesListPop(code) };

/** True when emitted target code contains a C list-copy placeholder outside quoted String literal text. */
pub codeUsesListCopy := fn(code: String): Bool { reach.codeUsesListCopy(code) };

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
pub codeUsesValueIf := fn(code: String): Bool { reach.codeUsesValueIf(code) };

/** Returns the scalar kind of tuple field `label` in canonical `kind`, or empty text when the field is absent. */
tupleFieldKind := fn(kind: String, label: String): String { types.tupleFieldKind(kind, label) };

/** Renders one canonical kind for diagnostics, adding spaces inside flat tuples, lists, and callable signatures. */
displayKind := fn(kind: String): String { types.displayKind(kind) };

/** Parses one source or alias type with cycle tracking `seen`, shared across annotations, aliases, tuple fields, lists, arrays, and callable types. */
parseTypeWithSeen := fn(errSource: String, errPos: Int, useLocalErr: Bool, source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String, seen: List<String>): (kind: String, next: Int) { types.parseTypeWithSeen(errSource, errPos, useLocalErr, source, position, prefix, aliases, context, genericType, seen) };

/** Resolves one scalar, flat named-tuple, array, list, or callable type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String { types.resolveTypeText(source, position, prefix, aliases, text, seen) };

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String { types.resolveAliasKind(source, position, prefix, aliases, name, seen) };

/** Parses one source-level flat named-tuple type `(label: Type, ...)`. */
parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) { types.parseTupleTypeAt(source, position, prefix, aliases) };

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple, an array, a `List<T>`, or `fn(...): Return`. */
parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String, genericType: String): (kind: String, next: Int) { types.parseTypeAt(source, position, prefix, aliases, context, genericType) };

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String): (kind: String, next: Int) { types.parseFunctionType(source, position, prefix, aliases, genericType) };

/** Parses a function signature. The optional `T` binder is only enabled for the registered core list declarations. */
parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): (next: Int, result: String, params: String, count: Int, genericType: String) { types.parseFunctionHeader(source, position, prefix, aliases, listIntrinsic) };

/** True when `moduleIdentity` is a verified `lite.core.*` or `lite.external.*` host module identity. */
pub isHostModuleIdentity := fn(moduleIdentity: String): Bool { builtinsAbi.isHostModuleIdentity(moduleIdentity) };

/** Returns the source name from one encoded `name=kind` function parameter entry. */
paramNameOf := fn(entry: String): String { types.paramNameOf(entry) };

/** Returns the kind from one encoded `name=kind` function parameter entry. */
paramKindOf := fn(entry: String): String { types.paramKindOf(entry) };

/** Builds a canonical `fn(label:Kind,...):ResultKind` string from encoded parameter entries and a return kind. */
fnCanonicalKind := fn(params: List<String>, first: Int, count: Int, resultKind: String): String { types.fnCanonicalKind(params, first, count, resultKind) };

/** Builds an integer parsed value with explicit scalar kind `kind`; `textValue` is empty. */
typedIntParsed := fn(kind: String, code: String, value: Int, constant: Bool, next: Int): Parsed { ctx.typedIntParsed(kind, code, value, constant, next) };

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed { ctx.intParsed(code, value, constant, next) };

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed { ctx.textParsed(code, value, constant, next) };

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed { ctx.boolParsed(code, value, constant, next) };

/** Tries a constant integer operation without raising a compile-time runtime fault. */
tryFoldInteger := fn(operator: String, left: Int, right: Int): (value: Int, ok: Bool) { ctx.tryFoldInteger(operator, left, right) };

/** Lowers a checked integer operation whose result is not a safe constant, preserving evaluation and fault timing. */
runtimeIntegerCode := fn(target: String, operator: String, left: String, right: String, position: Int): String { ctx.runtimeIntegerCode(target, operator, left, right, position) };

/** Lowers a checked integer operation at `kind`, adding a runtime range guard for narrow integer widths outside remainders. */
runtimeTypedIntegerCode := fn(target: String, kind: String, operator: String, left: String, right: String, position: Int): String { ctx.runtimeTypedIntegerCode(target, kind, operator, left, right, position) };

/** Returns the index of the newest visible `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int { sym.localIndex(locals, name) };

/** True when `locals` already binds runtime identifier `runtime` in scope or as a pre-scanned future placeholder. */
localsUseRuntime := fn(locals: List<Local>, runtime: String): Bool { ir.localsUseRuntime(locals, runtime) };

/** Returns the highest lexical block depth represented in `locals` (`depth <= -2` maps to `0 - 2 - depth`; `-1` maps to `0`). */
maxLocalLexDepth := fn(locals: List<Local>): Int { ir.maxLocalLexDepth(locals) };

/** Returns the index of the latest reached or deferred local (`depth >= -1`) with runtime `runtime`, or -1 when unreached. */
latestActiveLocalByRuntime := fn(locals: List<Local>, runtime: String): Int { trace.latestActiveLocalByRuntime(locals, runtime) };

/** True when `locals` already contains a reached declaration (`depth >= 0`) of `name` strictly deeper than `minExclusiveDepth`. */
localsHasDeeperReachedName := fn(locals: List<Local>, name: String, minExclusiveDepth: Int): Bool { ir.localsHasDeeperReachedName(locals, name, minExclusiveDepth) };

/** Returns the source name if `runtime` is a pre-scanned same/enclosing block placeholder not yet reached sequentially, or `""`. */
unreachedFutureLocalName := fn(locals: List<Local>, runtime: String): String { trace.unreachedFutureLocalName(locals, runtime) };

/** True when any unreached future placeholder (`depth <= -2`) or uninitialized reached binding (`depth >= 0`) exists in `locals`. */
localsHasAnyUnready := fn(locals: List<Local>): Bool { trace.localsHasAnyUnready(locals) };

/** Target runtime identifier for an imported module's top-level value, or a root value. */
moduleValueRuntime := fn(target: String, moduleKey: String, name: String): String { ir.moduleValueRuntime(target, moduleKey, name) };

/** Target runtime identifier for a user-defined top-level function. */
moduleFunctionRuntime := fn(target: String, moduleKey: String, name: String): String { ir.moduleFunctionRuntime(target, moduleKey, name) };

/** Allocates a collision-free compiler-internal temporary name scoped to `locals`. */
freshScopeTemp := fn(locals: List<Local>, prefix: String): String { ir.freshScopeTemp(locals, prefix) };

/** Selects a target-safe runtime name for a binding, using `lite_<name>` when unshadowed and a scope-local shadow suffix when shadowed. */
localRuntimeName := fn(target: String, locals: List<Local>, name: String, moduleKey: String, depth: Int): String { ir.localRuntimeName(target, locals, name, moduleKey, depth) };

/** Claims the pre-reserved runtime for `(lexDepth, name)` if pre-scanned, or allocates a collision-free runtime. */
claimOrMakeLocalRuntime := fn(target: String, locals: List<Local>, name: String, moduleKey: String, lexDepth: Int): String { trace.claimOrMakeLocalRuntime(target, locals, name, moduleKey, lexDepth) };

/** True for the ten comparison spellings accepted by this checkpoint. */
isComparison := fn(operator: String): Bool { syntax.isComparison(operator) };

/** Precedence level of a recognized binary operator; comparisons bind below arithmetic and logic binds below comparisons. */
operatorLevel := fn(operator: String): Int { syntax.operatorLevel(operator) };

/** Reads an operator at `position`, preferring the longest spelling; returns empty text when none starts there. */
readOperator := fn(source: String, position: Int): Operator { syntax.readOperator(source, position) };

/** True when a parsed atom is followed by a binary operator belonging to this precedence-climbing invocation. */
binaryFollows := fn(source: String, next: Int, prefix: String, minimum: Int): Bool { syntax.binaryFollows(source, next, prefix, minimum) };

/** Peeks only for a following comparison; the one-character filter avoids a full operator scan for ordinary delimiters and logic. */
comparisonOperatorAt := fn(source: String, position: Int): Operator { syntax.comparisonOperatorAt(source, position) };

/** Folds one of the ten Int comparisons to a Bool. */
compareIntegers := fn(operator: String, left: Int, right: Int): Bool { ctx.compareIntegers(operator, left, right) };

/** Folds String equality or inequality. */
compareTexts := fn(operator: String, left: String, right: String): Bool { ctx.compareTexts(operator, left, right) };

/** Folds Bool equality or inequality. */
compareBools := fn(operator: String, left: Bool, right: Bool): Bool { ctx.compareBools(operator, left, right) };

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
compareParsed := fn(target: String, source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed { ctx.compareParsed(target, source, at, operator, left, right, prefix) };

/** Admits an integer literal into a narrow Int or exact Float/Float32 storage context only when not followed by a binary operator at `minimum`. */
/** Parses signed decimal numeric literals in one scan, applying contextual narrow/Float width checks when the atom completes the expression. */
parseNumber := fn(target: String, source: String, position: Int, prefix: String, expected: String, minimum: Int): Parsed { syntax.parseNumber(target, source, position, prefix, expected, minimum) };

/** Joins adjacent double-quoted literal tokens across trivia in one scan and encodes the complete value once. Escapes and malformed later tokens retain their own source positions. */
parseText := fn(target: String, source: String, position: Int, prefix: String): Parsed { syntax.parseText(target, source, position, prefix) };

/** Returns the position after one string literal, or the source end when it does not close; alias collection leaves lexical diagnostics to the main pass. */
pub skipAliasString := fn(source: String, position: Int): Int { syntax.skipAliasString(source, position) };

/** Collects distinct target helper call names, skipping quoted text and consuming whole identifiers. Existing names avoid duplicate work across items. */
pub targetCodeCalls := fn(code: String, existing: String): String { reach.targetCodeCalls(code, existing) };

/** Collects distinct user-function call tokens (`lt_fn_*(` / `liteFn...(`) from `code`, skipping quoted text. */
pub userFunctionCalls := fn(code: String, existing: String): String { reach.userFunctionCalls(code, existing) };

/** Collects a program's target helper requirements once, with a bounded distinct-name result. */
pub targetHelperCallSet := fn(items: Items): Set<String> { reach.targetHelperCallSet(items) };
pub targetHelperCalls := fn(items: Items): String { reach.targetHelperCalls(items) };

/** True when `calls` already contains the pipe-delimited call token `needle`. */
pub hasHelperToken := fn(calls: String, needle: String): Bool { reach.hasHelperToken(calls, needle) };

/** Creates an empty token set. */
pub emptyTokenBuckets := fn(): TokenBuckets { reach.emptyTokenBuckets() };

/** True when `s` contains `needle`. */
pub tokenBucketHas := fn(s: TokenBuckets, needle: String): Bool { reach.tokenBucketHas(s, needle) };

/** Inserts `needle` into `s` in place. */
pub tokenBucketAdd := fn(s: mut TokenBuckets, needle: String): Unit { reach.tokenBucketAdd(mut s, needle); };

/** Serializes all tokens in `s` into one `|`-delimited string. */
pub flattenTokenBuckets := fn(s: TokenBuckets): String { reach.flattenTokenBuckets(s) };

/** Collects distinct `lite*` / `lt_*` call or value identifier tokens from `code` into `existing` in place. */
pub codeReachableTokensSet := fn(code: String, existing: mut TokenBuckets): Unit { reach.codeReachableTokensSet(code, mut existing); };
pub closeReachableGraph := fn(graph: Items, reachable: mut TokenBuckets, scanned: mut TokenBuckets): Unit { reach.closeReachableGraph(graph, mut reachable, mut scanned); };

/** Removes unreachable top-level function bodies and side-effect-free code across root and inner blocks for `target`. */
pub OptClass := alias optCfg.OptClass;
pub OptConfig := alias optCfg.OptConfig;
pub filterReachableItemsWithConfig := fn(items: Items, target: String, cfg: optCfg.OptConfig): Items { reach.filterReachableItemsWithConfig(items, target, cfg) };

/** Reads one raw alias target type from `position`, capturing a parenthesized tuple type or a generic `List<...>` application through its matching close, or a single name. */
collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) { types.collectTypeTarget(source, position, prefix) };

/** True for the single assignment/field equals token, excluding both equality and inequality operators. */
isSingleEquals := fn(source: String, position: Int): Bool { syntax.isSingleEquals(source, position) };

/** True when the text after an opening `(` is a tuple literal (`label = ...`, `=name`, or contains a top-level `,`), rather than grouping. */
looksLikeTupleEntry := fn(source: String, position: Int, prefix: String): Bool { syntax.looksLikeTupleEntry(source, position, prefix) };

/** Wraps target code in the backend's list-copy hook when `kind` is a List; `Never` and other kinds are unchanged. */
copiedValueCode := fn(target: String, kind: String, code: String): String { ctx.copiedValueCode(target, kind, code) };

/** Converts compatible tuples or widening integer-to-float values on assignment/call/return, or copies lists when needed; `Never` passes through unchanged. */
assignValueCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String { ctx.assignValueCode(target, expectedKind, actualKind, actualCode) };

/** Rejects declarations inferred as non-storable `Unit` or `Never`. */
rejectNonValueBinding := fn(source: String, at: Int, prefix: String, kind: String, name: String): Unit { ctx.rejectNonValueBinding(source, at, prefix, kind, name); };

/** Chooses the emitted statement item kind, ensuring diverging items terminate non-Unit functions/main for strict TS control flow. */
expressionStatementKind := fn(valueKind: String, returned: Bool, defaultKind: String, currentResult: String): String { ctx.expressionStatementKind(valueKind, returned, defaultKind, currentResult) };

/** Closes a call after at least one parsed argument, consuming at most one trailing comma and its trivia. */
expectNonemptyCallClose := fn(source: String, position: Int, prefix: String): Int { ctx.expectNonemptyCallClose(source, position, prefix) };

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) { ctx.parseListGrant(source, open, prefix, locals, operation) };

/** Finds the end of a grouped atom without interpreting its values; strings and comments cannot close the group. */
scanParenEnd := fn(source: String, open: Int, prefix: String): Int { syntax.scanParenEnd(source, open, prefix) };

/** Returns the end position of a standalone `0` initializer literal (followed by `;`, `}`, or EOF), or -1 otherwise. */
isZeroInitLiteral := fn(source: String, position: Int, prefix: String): Int { syntax.isZeroInitLiteral(source, position, prefix) };

/** Returns the position after `?` when `position` starts a reserved-storage marker, or -1 otherwise. */
isReservedInitMarker := fn(source: String, position: Int, prefix: String): Int { syntax.isReservedInitMarker(source, position, prefix) };

/** Recognizes one compound assignment operator at `position`, returning empty fields when absent. */
compoundAssignOp := fn(source: String, position: Int): (op: String, baseOp: String, width: Int) { syntax.compoundAssignOp(source, position) };

/** Lowers a compound assignment RHS computation for Int*, Float*, or String (`+=`). */
compoundAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entryKind: String, lhsCode: String, baseOp: String, rhs: Parsed): String { ctx.compoundAssignCode(target, source, opPos, prefix, entryKind, lhsCode, baseOp, rhs) };

/** Counts entries in `locals`. */
localsCount := fn(locals: List<Local>): Int { ctx.localsCount(locals) };

/** Returns the prefix of `locals` up to `targetLen` entries. */
truncateLocals := fn(locals: List<Local>, targetLen: Int): List<Local> { ctx.truncateLocals(locals, targetLen) };

/** Returns outer-local initialization and callable-dependency updates from `locals[preLen..)` appended to `updates` for `branchDepth`. */
recordBranchUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int, branchDepth: Int, updates: List<BranchUpdate>): List<BranchUpdate> { ctx.recordBranchUpdates(locals, preLen, maxDepth, branchDepth, updates) };

/** Joins `branchUpdates` for `blockDepth` into `locals`, returning updated `locals`. */
joinBranchLocals := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>): List<Local> { ctx.joinBranchLocals(locals, preLen, blockDepth, hasElse, liveBranchCount, updates) };

/** Removes `branchUpdates` entries at `blockDepth`. */
popBranchUpdates := fn(updates: List<BranchUpdate>, blockDepth: Int): List<BranchUpdate> { ctx.popBranchUpdates(updates, blockDepth) };

/** Transitions any outer uninit locals modified inside a loop and propagates callable-dependency updates after the loop. */
joinLoopUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int): List<Local> { ctx.joinLoopUpdates(locals, preLen, maxDepth) };

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object, fixed array, callable stub, and an empty list. */
zeroParsed := fn(target: String, kind: String, next: Int): Parsed { ctx.zeroParsed(target, kind, next) };

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) { types.parseLocalType(source, position, prefix, aliases) };

/** Skips empty item separators without changing the final ordinary item's result. */
skipItemSeparators := fn(source: String, position: Int, prefix: String): Int { syntax.skipItemSeparators(source, position, prefix) };

/** Returns a copy of `values` with element `index` replaced by `value`. */
setIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> { ctx.setIntAt(values, index, value) };

/** Returns a copy of `values` with element `index` replaced by `value`. */
setBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> { ctx.setBoolAt(values, index, value) };

/** Returns the 0-based parameter slot index matching `label` in `[first, first + count)`, or -1 when absent. */
findParamSlot := fn(params: List<String>, first: Int, count: Int, label: String): Int { ctx.findParamSlot(params, first, count, label) };

/** Scans from `position` to the next top-level `,` or `)` at paren/bracket/brace depth 0. */
skipBalancedArgument := fn(source: String, position: Int, prefix: String): Int { syntax.skipBalancedArgument(source, position, prefix) };

/** Collects explicit `name = ...` and `=name` parameter labels present in a call argument list starting at `openParen`. */
collectExplicitCallLabels := fn(source: String, openParen: Int, prefix: String): List<String> { syntax.collectExplicitCallLabels(source, openParen, prefix) };

/** Returns the position of the `{` that opens the branch after the condition starting at `start`, or -1 when absent. */
scanConditionOpen := fn(source: String, start: Int, prefix: String): Int { syntax.scanConditionOpen(source, start, prefix) };

/** Locates an ordinary item's separator or enclosing close for contextual tail typing, without interpreting values. */
scanExpressionItemEnd := fn(source: String, start: Int, prefix: String): Int { syntax.scanExpressionItemEnd(source, start, prefix) };

/** Extracts the loop context id encoded in a Pass 1 `"__loopVal:<id>"` placeholder kind, or returns -1. */
loopValMarkerId := fn(kind: String): Int { types.loopValMarkerId(kind) };

/** Unifies two conditional branch kinds when one is `Never`, both match, one is a Pass 1 loop `.value` placeholder, or one losslessly widens to the other. */
joinBranchKind := fn(current: String, nextKind: String): String { types.joinBranchKind(current, nextKind) };

/** Builds a nested conditional expression while converting any branch that widens to `resultKind`. */
ternaryChainCode := fn(target: String, resultKind: String, conditionCodes: List<String>, branchCodes: List<String>, branchKinds: List<String>, branchCount: Int): String { ctx.ternaryChainCode(target, resultKind, conditionCodes, branchCodes, branchKinds, branchCount) };

/** Formats one conditional branch statement for a lowered IIFE conditional (`if`, `else if`, `else`, or `match` arm). */
condBranchStmtCode := fn(target: String, valKind: String, valVar: String, branchKind: String, branchCode: String): String { ctx.condBranchStmtCode(target, valKind, valVar, branchKind, branchCode) };

/** Returns the number of entries in `ctxs`. */
ctxCount := fn(ctxs: List<ConstructCtx>): Int { ctx.ctxCount(ctxs) };

/** Returns a copy of `ctxs` with `entry` appended at the end. */
appendCtx := fn(ctxs: List<ConstructCtx>, entry: ConstructCtx): List<ConstructCtx> { ctx.appendCtx(ctxs, entry) };

/** Returns one fresh positive construct identifier higher than any active id in `ctxs`. */
nextCtxId := fn(ctxs: List<ConstructCtx>): Int { ctx.nextCtxId(ctxs) };

/** Finds the innermost context in `ctxs` matching `tag`, or -1 when absent. */
findTaggedCtxIndex := fn(ctxs: List<ConstructCtx>, tag: String): Int { ctx.findTaggedCtxIndex(ctxs, tag) };

/** Finds the innermost context in `ctxs` matching `kind`, or -1 when absent. */
findCtxByKindIndex := fn(ctxs: List<ConstructCtx>, kind: String): Int { ctx.findCtxByKindIndex(ctxs, kind) };

/** Returns the entries of `locals` declared below `depth` (including pre-scanned future placeholders below `depth`), preserving order. */
visibleLocals := fn(locals: List<Local>, depth: Int): List<Local> { ctx.visibleLocals(locals, depth) };

/** True when `name` is already declared directly inside the block at `depth`. */
hasBlockDecl := fn(decls: List<BlockDecl>, depth: Int, name: String): Bool { ir.hasBlockDecl(decls, depth, name) };

/** Drops current-block declaration records at or above `depth`, keeping enclosing blocks intact. */
popBlockDecls := fn(decls: List<BlockDecl>, depth: Int): List<BlockDecl> { ctx.popBlockDecls(decls, depth) };

/** Rejects redeclaring `name` within the same file-root (`depth == 0`) or inner block. */
rejectDuplicateBlockDecl := fn(source: String, at: Int, prefix: String, decls: List<BlockDecl>, depth: Int, name: String): Unit { ctx.rejectDuplicateBlockDecl(source, at, prefix, decls, depth, name); };

/** Rejects redeclaring `name` inside the current `parseBinaryCtx` `{ ... }` block. */
rejectDuplicateInBlockNames := fn(source: String, at: Int, prefix: String, names: List<String>, name: String): Unit { ctx.rejectDuplicateInBlockNames(source, at, prefix, names, name); };

/** Extracts header-bound symbol names (parameters or loop items) owned by the opening `{ ... }` block. */
seedBlockDeclaredNames := fn(bodySink: String): List<String> { ctx.seedBlockDeclaredNames(bodySink) };

/** Joins a block's definite completion: scopes preserve it, loops require a true header, and conditionals require every arm plus a final else. */
blockCompletion := fn(kind: String, completed: Bool, branchesComplete: Bool, hasElse: Bool, loopForever: Bool): Bool { ctx.blockCompletion(kind, completed, branchesComplete, hasElse, loopForever) };

/** True when emitted target code contains a raw `lite$throwTransfer(` substring worth quote-aware inspection. */
codeHasRawTransfer := fn(code: String): Bool { ctx.codeHasRawTransfer(code) };

/** Parses one `@tag` token starting at `atPos`. */
parseTagAt := fn(source: String, atPos: Int, prefix: String): (tag: String, next: Int, at: Int) { syntax.parseTagAt(source, atPos, prefix) };

/** Rejects a block `@tag` where a construct header, else/then/finally clause or opening brace cannot accept one. */
rejectMisplacedTag := fn(source: String, position: Int, prefix: String, message: String): Unit { syntax.rejectMisplacedTag(source, position, prefix, message); };

/** Rejects an unparenthesized `@tag { ... }` at the start of a header condition while preserving `@tag.field` metadata reads. */
rejectHeaderBlockTag := fn(source: String, position: Int, prefix: String, constructName: String): Unit { syntax.rejectHeaderBlockTag(source, position, prefix, constructName); };

/** True when `parsed` encodes Pass 1 exit markers in `textValue`. */
hasMarkerPrefix := fn(parsed: Parsed): Bool { ctx.hasMarkerPrefix(parsed) };

/** Appends Pass 1 exit markers encoded on `parsed` onto `current`. */
collectParsedMarkers := fn(current: String, parsed: Parsed): String { ctx.collectParsedMarkers(current, parsed) };

/** Encodes raw marker lines for `Parsed.textValue`, or returns empty when none exist. */
wrapMarkers := fn(raw: String): String { ctx.wrapMarkers(raw) };

/** Attaches raw Pass 1 exit markers onto `parsed` when non-empty. */
withMarkers := fn(parsed: Parsed, raw: String): Parsed { ctx.withMarkers(parsed, raw) };

/** Retains all marker lines in `raw` whose target id is not `excludeId`. */
filterOtherMarkers := fn(raw: String, excludeId: Int): String { ctx.filterOtherMarkers(raw, excludeId) };

/** Unifies all inferred exit kinds recorded for `targetId` in `raw` markers, failing on incompatible exit types. */
inferKindFromMarkers := fn(raw: String, targetId: Int, targetTag: String, source: String, at: Int, prefix: String, blockStopped: Bool): String { ctx.inferKindFromMarkers(raw, targetId, targetTag, source, at, prefix, blockStopped) };

/** Returns true when a call argument list reorders or mismatches slots relative to the callee's declaration order. */
callReordersArgs := fn(source: String, openParen: Int, prefix: String, params: List<String>, firstParam: Int, paramCount: Int): Bool { ctx.callReordersArgs(source, openParen, prefix, params, firstParam, paramCount) };

/** Scans from `start` with initial brace `depthStart`, skipping strings and comments; returns the end position or -1 when unclosed. */
scanBracedRange := fn(source: String, start: Int, depthStart: Int, prefix: String): Int { syntax.scanBracedRange(source, start, depthStart, prefix) };

/** Returns the position after the braced block starting at `open`, or -1 when it never closes. Strings and comments are skipped. */
scanBraceEnd := fn(source: String, open: Int, prefix: String): Int { syntax.scanBraceEnd(source, open, prefix) };

/** True when the braced body from `open` to `close` is a nonempty single expression: no semicolon and no statement keyword first. */
valueIfBranchAt := fn(source: String, open: Int, close: Int, prefix: String): Bool { syntax.valueIfBranchAt(source, open, close, prefix) };

/** Scans the raw `[@tag] if ... [else ...]` header+branches ending before any `then` clause; returns -1 on mismatch. */
scanRawIfChainEnd := fn(source: String, position: Int, prefix: String, allowPartial: Bool): Int { syntax.scanRawIfChainEnd(source, position, prefix, allowPartial) };

/** Scans a `[@tag] if` chain, optionally allowing a partial chain without a final `else` and an optional trailing `then { ... }`. */
scanIfChainEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool, allowPartial: Bool): Int { syntax.scanIfChainEnd(source, position, prefix, requireValueBranches, allowPartial) };

/** Scans a total `[@tag] if` chain ending with a final else block and optional `then { ... }`. */
scanValueIfEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int { syntax.scanValueIfEnd(source, position, prefix, requireValueBranches) };

/** Scans the raw `[@tag] match { ... }` ending before any `then` clause; returns -1 on mismatch. */
scanRawMatchEnd := fn(source: String, position: Int, prefix: String): Int { syntax.scanRawMatchEnd(source, position, prefix) };

/** Scans a subjectless Boolean `[@tag] match` ending with a final `_` fallback arm and optional `then { ... }`. */
scanValueMatchEnd := fn(source: String, position: Int, prefix: String, requireValueBranches: Bool): Int { syntax.scanValueMatchEnd(source, position, prefix, requireValueBranches) };

/** Finds the innermost loop context for leading-dot metadata, stopping on conditional, cleanup, or function barriers (-2 conditional, -3 finally, -1 outside). */
findLeadingDotLoopIdx := fn(ctxs: List<ConstructCtx>, allowThroughCond: Bool): Int { ctx.findLeadingDotLoopIdx(ctxs, allowThroughCond) };

/** Finds the innermost active enclosing loop context, skipping loops whose body already completed (`then` or `finally`) and stopping at `fn`. */
findActiveLoopCtxIndex := fn(ctxs: List<ConstructCtx>): Int { ctx.findActiveLoopCtxIndex(ctxs) };

/** True when a cleanup `finally` barrier sits strictly above `targetIdx` on `ctxs`. */
hasFinallyAbove := fn(ctxs: List<ConstructCtx>, targetIdx: Int): Bool { ctx.hasFinallyAbove(ctxs, targetIdx) };

/** Scans a raw `[@tag] loop [header] { body }` up to the end of its body `}`, before any `then` or `finally`; returns -1 on mismatch. */
scanRawLoopEnd := fn(source: String, position: Int, prefix: String): Int { syntax.scanRawLoopEnd(source, position, prefix) };

/** True when a statement-position loop uses tags, metadata, payload exits, `then`, or `finally` and must lower as an enhanced loop expression. */
loopNeedsExprLowering := fn(source: String, position: Int, prefix: String): Bool { syntax.loopNeedsExprLowering(source, position, prefix) };

/** Resolves `.count`, `.value`, `.item`, or `.index` against one active loop context, handling Pass 1 inference markers cleanly. */
resolveLoopField := fn(target: String, c: ConstructCtx, fieldName: String, expected: String, source: String, fieldStart: Int, fieldEnd: Int, prefix: String): Parsed { ctx.resolveLoopField(target, c, fieldName, expected, source, fieldStart, fieldEnd, prefix) };

/** Scans Pass 1 marker lines for `loopId`, reporting whether any marker or concrete type marker exists. */
scanLoopMarkers := fn(raw: String, loopId: Int): (hasAny: Bool, hasConcrete: Bool) { infer.scanLoopMarkers(raw, loopId) };

/** Resolves a loop's pre-`then` `.value` type `T` from Pass 1 markers, bidirectional hint, circular-read guard, and `Unit` default. */
inferLoopValueKind := fn(raw: String, loopId: Int, tagDisplay: String, source: String, at: Int, prefix: String, expectedHint: String): String { infer.inferLoopValueKind(raw, loopId, tagDisplay, source, at, prefix, expectedHint) };

/** Pre-collects shallow `Name := alias Target` aliases inside the `{ ... }` block opening at `openBracePos`, skipping nested `{ ... }` blocks. */
collectBlockTypeAliases := fn(source: String, openBracePos: Int, prefix: String, blockDepth: Int, baseAliases: List<AliasDecl>): List<AliasDecl> { types.collectBlockTypeAliases(source, openBracePos, prefix, blockDepth, baseAliases) };

/** Non-failing counterpart to `parseTypeWithSeen` used by root pre-registration and expression kind inference. */
canResolveTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, genericType: String, seen: List<String>, depthLeft: Int): (ok: Bool, kind: String, next: Int) { types.canResolveTypeAt(source, position, prefix, aliases, genericType, seen, depthLeft) };

/** Non-failing guard checking whether `parseLocalType` can succeed at `position`. */
canPreResolveLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): Bool { types.canPreResolveLocalType(source, position, prefix, aliases) };

/** Non-failing guard checking whether `parseFunctionHeader` can succeed at `position` without triggering diagnostics. */
canPreParseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, listIntrinsic: Bool): Bool { types.canPreParseFunctionHeader(source, position, prefix, aliases, listIntrinsic) };

/** Finds the start position of the final expression inside `{ ... }` from `openBracePos` to `closeBracePos`, or -1 when empty. */
tryInferBlockTailStart := fn(source: String, openBracePos: Int, closeBracePos: Int, prefix: String): Int { infer.tryInferBlockTailStart(source, openBracePos, closeBracePos, prefix) };

/** Best-effort non-failing expression kind inference for unannotated forward root declarations. */
tryInferRootExprKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, functions: List<FunctionInfo>, params: List<String>, locals: List<Local>, futureValues: List<FutureValue>, expected: String, minimum: Int, depthLeft: Int): (kind: String, next: Int) {
    infer.tryInferRootExprKind(source, position, prefix, aliases, functions, params, locals, futureValues, expected, minimum, depthLeft)
};

/** True when `bag` contains `tok` in `"|a|b|"` form. */
tokenInPipeBag := fn(bag: String, tok: String): Bool { trace.tokenInPipeBag(bag, tok) };

/** Appends `tok` to a pipe-delimited token set `"|a|b|"` when absent. */
appendPipeBag := fn(bag: String, tok: String): String { trace.appendPipeBag(bag, tok) };

/** Extracts the `allBag` portion (`allBag + "\n" + readBag`) from encoded callable dependency metadata. */
fnDepsAll := fn(encoded: String): String { trace.fnDepsAll(encoded) };

/** Extracts the `readBag` portion (`allBag + "\n" + readBag`) from encoded callable dependency metadata. */
fnDepsRead := fn(encoded: String): String { trace.fnDepsRead(encoded) };

/** Unions two `"allBag\nreadBag"` encoded dependency pairs. */
mergeCallableLocalDeps := fn(existingCode: String, newDeps: String): String { trace.mergeCallableLocalDeps(existingCode, newDeps) };

/** True when a declaration or discarded expression of `kind` and `code` can be omitted on `target` without altering observable behavior or diagnostics. */
isPrunableExprForTarget := fn(target: String, kind: String, code: String): Bool { reach.isPrunableExprForTarget(target, kind, code) };

/** True when `runtime` appears in `locals[0 .. limit)` (declared outside the current block). */
localsRangeUsesRuntime := fn(locals: List<Local>, limit: Int, runtime: String): Bool { ir.localsRangeUsesRuntime(locals, limit, runtime) };

/** Eliminates unreachable pure statements and local bindings inside one `{ ... }` block after its statements and tail are parsed. */
pruneBlockStatements := fn(stmts: List<String>, owners: List<String>, deps: List<String>, hasTail: Bool, tailCode: String): List<String> { reach.pruneBlockStatements(stmts, owners, deps, hasTail, tailCode) };

/** Encodes `"allBag\nreadBag"` for storing on a `containsFnKind` local binding's `code` field. */
computeCallableRhsDeps := fn(rhsCode: String): String { trace.computeCallableRhsDeps(rhsCode) };

/** Propagates outer `equals` and `List.push`/`unshift` updates from emitted block/branch/loop JS `code` onto active `locals`. */
mergeOuterCallableUpdatesFromCode := fn(locals: List<Local>, code: String): List<Local> { trace.mergeOuterCallableUpdatesFromCode(locals, code) };

/** Enforces execution-trace ordering and initialization safety across root and inner blocks before referenced bindings initialize. */
checkTraceSafety := fn(source: String, stmtAt: Int, prefix: String, exprCode: String, currentName: String, maxFutureAt: Int,
locals: List<Local>, functions: List<FunctionInfo>, futureValues: List<FutureValue>, items: Items): Unit { trace.checkTraceSafety(source, stmtAt, prefix, exprCode, currentName, maxFutureAt, locals, functions, futureValues, items); };

/** Parses numeric lexical depth encoded in `ConstructCtx.iterLabel`, or returns `fallback`. */
parseLexDepthTag := fn(tag: String, fallback: Int): Int { trace.parseLexDepthTag(tag, fallback) };

/** Rejects returning/breaking/continuing a function value that references uninitialized or skipped same-block symbols at `>= minExitedLexDepth`. */
checkEscapingFnSafety := fn(source: String, stmtAt: Int, prefix: String, rhsCode: String,
minExitedLexDepth: Int, locals: List<Local>): Unit { trace.checkEscapingFnSafety(source, stmtAt, prefix, rhsCode, minExitedLexDepth, locals); };

/** Returns closing brace index if an inner `{ ... }` block contains `"fn"`, or -1 to fast-skip pre-scanning. */
blockHasInnerFn := fn(source: String, openBracePos: Int, prefix: String): Int { infer.blockHasInnerFn(source, openBracePos, prefix) };

/** Pre-scans direct top-level statements inside `{ ... }` (`openBracePos .. closeBracePos - 1`) for direct `name = ...` assignments (`"|a|b|"`). */
scanInnerBlockAssignedBag := fn(target: String, source: String, openBracePos: Int, prefix: String, seedBag: String): String { infer.scanInnerBlockAssignedBag(target, source, openBracePos, prefix, seedBag) };

/** Pre-scans declarations in `{ ... }` (`openBracePos .. closeBracePos - 1`) and appends unreached `depth = 0 - 2 - blockLexDepth` placeholders to `locals`. */
appendBlockFutureLocals := fn(target: String, source: String, openBracePos: Int, prefix: String, blockLexDepth: Int,
seedBag: String, assignedBag: String, aliases: List<AliasDecl>, functions: List<FunctionInfo>,
functionParams: List<String>, locals: List<Local>): List<Local> {
    infer.appendBlockFutureLocals(target, source, openBracePos, prefix, blockLexDepth, seedBag, assignedBag, aliases, functions, functionParams, locals)
};

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`, with construct context tracking. */
parseBinaryCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    expr.parseBinaryCtx(target, source, position, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, bodySink, aliases)
};

/** Parses one expression with an empty construct context stack. */
parseBinary := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    expr.parseBinary(target, source, position, prefix, locals, functions, params, currentName, expected, minimum)
};

/** Parses one complete expression at the lowest precedence with construct contexts and an optional contextual kind. */
parseExpressionAsCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseExpressionAsCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** Parses one statement-level expression with construct contexts, allowing unit-producing tagged conditionals without else. */
parseStatementExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseStatementExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
parseExpressionAs := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    expr.parseExpressionAs(target, source, position, prefix, locals, functions, params, currentName, expected)
};

/** Parses one complete expression at the lowest precedence with construct contexts and no contextual kind. */
parseExpressionCtx := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs, aliases)
};

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    expr.parseExpression(target, source, position, prefix, locals, functions, params, currentName)
};

/** Parses `--builtin-mode` specification strings passed down from the compiler entrypoint. */
pub parseBuiltinModeSpecs := fn(prefix: String, specs: List<String>): Items { builtinsAbi.parseBuiltinModeSpecs(prefix, specs) };

/** Resolves effective builtin mode (`builtin` or `pure`) by precedence: function > module > project > default builtin. */
pub resolveBuiltinMode := fn(rules: Items, moduleName: String, fnName: String): String { builtinsAbi.resolveBuiltinMode(rules, moduleName, fnName) };

/** Collapses a numeric scalar, tuple or list kind to its canonical item suffix (`Int`, `Float`, `Tuple`, `List`) while leaving other scalar kinds unchanged. */
storageKind := fn(kind: String): String { ctx.storageKind(kind) };

/** Returns the text payload for a storage item with explicit declared kind `kind`, falling back to `fallback`. */
storageTextPayload := fn(kind: String, fallback: String): String { ctx.storageTextPayload(kind, fallback) };

/** Returns the text payload stored with one local item: the canonical List/Array/Fn kind for List/Array/Fn items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String { ctx.itemTextPayload(parsed) };

/** Parses a direct or parenthesized partial if assignment into guarded Assign items; returns empty when total or not an if. */
parsePartialAssignIf := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, targetAt: Int, targetKind: String, targetName: String, targetRuntime: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    expr.parsePartialAssignIf(target, source, position, prefix, locals, functions, params, currentName, targetAt, targetKind, targetName, targetRuntime, ctxs, aliases)
};

/** Parses one declaration initializer, allowing a direct or parenthesized partial if to default to zero(T). */
parseInitializerExpression := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Parsed {
    expr.parseInitializerExpression(target, source, position, prefix, locals, functions, params, currentName, expected, ctxs, aliases)
};

/** True when the innermost block expects a value tail: a function body or one of the value-if branches that complete one. */
atValueTail := fn(blocks: List<String>, blockCount: Int): Bool { ctx.atValueTail(blocks, blockCount) };

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool { ctx.insideLoop(blocks) };

/** Parses an expression item once, retaining its evaluation and checking a function's final result across trailing separators. */
parseExpressionItem := fn(target: String, source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, currentResult: String, valueTail: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): (next: Int, returned: Bool, code: String, valueKind: String) {
    expr.parseExpressionItem(target, source, position, prefix, locals, functions, params, currentName, currentResult, valueTail, ctxs, aliases)
};

/** Collects aliases, `pub` declarations, inner-alias hints, root functions, root values, and root assignments in a single pass over module source. */
/** Resolves `typeName` as an owned nominal type declaration in the current module (or a verified core built-in owner). Rejects transparent aliases and foreign types. */
resolveOwnedTypeOpTarget := fn(source: String, nameStart: Int, prefix: String, aliases: List<AliasDecl>, moduleIdentity: String, typeName: String): (ok: Bool, ownerKind: String, ownerKey: String, selfTarget: String, isGenericOwner: Bool, error: String) {
    coreOwner := types.coreBuiltinOwnerType(moduleIdentity, typeName);
    if coreOwner =!= "" {
        isGen := types.isGenericCoreOwner(coreOwner);
        selfT := if isGen { "$Family:" + coreOwner } else { coreOwner };
        return (ok = true, ownerKind = coreOwner, ownerKey = coreOwner, selfTarget = selfT, isGenericOwner = isGen, error = "");
    }
    var foundIdx := -1;
    var i := 0;
    loop aliases as a {
        if a.name == typeName and a.depth == 0 {
            foundIdx = i;
        }
        i = i + 1;
    }
    if foundIdx < 0 {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to unknown or foreign type " + typeName + "; operations may only be attached in the owning module of a record, enum, or built-in type");
    }
    entry := aliases[foundIdx];
    if entry.at >= 0 and entry.target.startsWithAt(0, "@genraw:") {
        pDec := types.decodeLengthPrefixedAt(entry.target, 8);
        innerRaw := if pDec.next >= 0 { entry.target.slice(pDec.next, entry.target.length()) } else { "" };
        if not innerRaw.startsWithAt(0, "@recraw:") and not innerRaw.startsWithAt(0, "@enumraw:") and not innerRaw.startsWithAt(0, "@distraw:") {
            return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
            error = "cannot attach operation to alias or foreign type " + typeName + "; operations may only be attached to an owned record, enum, distinct, or built-in type");
        }
        emptySeen: List<String> = [];
        resolvedParams := types.resolveComptimeParamSpecs(source, nameStart, prefix, aliases, pDec.text);
        tplKind := types.resolveGenericTypeText(source, nameStart, prefix, aliases, innerRaw, resolvedParams, emptySeen);
        ownerKey := types.typeOpOwnerKey(tplKind);
        if ownerKey == "" {
            return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
            error = "cannot attach operation to non-nominal type " + typeName);
        }
        selfTarget := "@gentpl:" + types.encodeLengthPrefixedText(resolvedParams) + tplKind;
        return (ok = true, ownerKind = tplKind, ownerKey = ownerKey, selfTarget = selfTarget, isGenericOwner = true, error = "");
    }
    if entry.at < 0 or (not entry.target.startsWithAt(0, "@recraw:") and not entry.target.startsWithAt(0, "@enumraw:") and not entry.target.startsWithAt(0, "@distraw:")) {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to alias or foreign type " + typeName + "; operations may only be attached to an owned record, enum, distinct, or built-in type");
    }
    emptySeen: List<String> = [];
    ownerKind := resolveTypeText(source, nameStart, prefix, aliases, entry.target, emptySeen);
    ownerKey := types.typeOpOwnerKey(ownerKind);
    if ownerKey == "" {
        return (ok = false, ownerKind = "", ownerKey = "", selfTarget = "", isGenericOwner = false,
        error = "cannot attach operation to non-nominal type " + typeName);
    }
    (ok = true, ownerKind = ownerKind, ownerKey = ownerKey, selfTarget = ownerKind, isGenericOwner = false, error = "")
};

/** Collects top-level declarations for one module before full body parsing. */
collectModuleDecls := fn(target: String, source: String, prefix: String, moduleKey: String): Items { infer.collectModuleDecls(target, source, prefix, moduleKey) };

/** Appends `(name, depth)` entries to `decls` for every `|name|` token in `assignedBag`. */
appendAssignedBagDecls := fn(assignedBag: String, decls: List<BlockDecl>, depth: Int): List<BlockDecl> { infer.appendAssignedBagDecls(assignedBag, decls, depth) };

/** Removes deferred-only entries after one function body has been checked. */
withoutFutureValues := fn(locals: List<Local>): List<Local> { infer.withoutFutureValues(locals) };

/** Parses one top-level aliased import and returns its next source position. */
parseImportClause := fn(target: String, source: String, position: Int, modAlias: String, prefix: String): Item { infer.parseImportClause(target, source, position, modAlias, prefix) };

/** Collects top-level import clauses before parsing so imported declarations can seed the importing file's symbol table. */
pub collectImportClauses := fn(target: String, source: String, prefix: String): Items { infer.collectImportClauses(target, source, prefix) };

/** Parses one imported `io.output` / `io.outputLine` statement into its ordered argument group and ending marker. */
parseOutputStatement := fn(target: String, source: String, openPosition: Int, outputName: String, prefix: String,
locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String,
live: Bool, ctxs: List<ConstructCtx>, aliases: List<AliasDecl>): Items {
    sourceLen := source.length();
    var position := openPosition;
    if position >= sourceLen or source.at(position) =!= "(" {
        failAt(source, position, prefix, "expected ( after " + outputName);
    }
    position = skipTrivia(source, position + 1, prefix);
    result: mut List<Item> = [];
    loop position < sourceLen and source.at(position) =!= ")" {
        argStart := position;
        argument := parseExpressionCtx(target, source, position, prefix, locals, functions, params, currentName, ctxs, aliases);
        if containsFnKind(argument.kind) {
            failAt(source, argStart, prefix, "cannot output function value");
        }
        (mut result).pushBack((kind = argument.kind, name = "", runtime = "", code = argument.code,
        intValue = argument.intValue, textValue = argument.textValue));
        position = skipTrivia(source, argument.next, prefix);
        if position < sourceLen and source.at(position) == "," {
            position = skipTrivia(source, position + 1, prefix);
        } else {
            break;
        }
    }
    position = expectSymbol(source, position, ")", prefix);
    statementNext := consumeStatementEnd(source, position, prefix);
    if statementNext < 0 { failAt(source, skipTrivia(source, position, prefix), prefix, "expected ; after " + outputName); }
    (mut result).pushBack((kind = if outputName == "outputLine" { ITEM_KIND_END } else { ITEM_KIND_END_OUTPUT },
    name = "", runtime = "", code = "", intValue = statementNext, textValue = ""));
    result
}

/** Advances past one `{ ... }` function body while respecting strings and comments. */
skipBraceBlock := fn(source: String, afterOpen: Int, prefix: String): Int { syntax.skipBraceBlock(source, afterOpen, prefix) };

/** Splits up to `count` pipe-delimited substrings out of `encoded`. */
splitPipeEntries := fn(encoded: String, count: Int): List<String> {
    out: mut List<String> = [];
    var startPos := 0;
    var index := 0;
    loop index < count {
        sep := encoded.indexOf("|", startPos);
        endPos := if sep >= 0 { sep } else { encoded.length() };
        mut out.pushBack(encoded.slice(startPos, endPos));
        startPos = endPos + 1;
        index = index + 1;
    }
    out
};

/** Checks trace initialization safety, escaping callable safety (when `checkEscape`), and propagates outer callable updates. */
checkStatementTrace := fn(target: String, source: String, stmtAt: Int, prefix: String, exprCode: String,
checkEscape: Bool, escapeKind: String, currentName: String, maxFutureAt: Int,
locals: List<Local>, functions: List<FunctionInfo>, futureValues: List<FutureValue>, items: Items, active: Bool): List<Local> {
    if not active { return locals; }
    _t := target;
    checkTraceSafety(source, stmtAt, prefix, exprCode, currentName, maxFutureAt, locals, functions, futureValues, items);
    if checkEscape and containsFnKind(escapeKind) {
        checkEscapingFnSafety(source, stmtAt, prefix, exprCode, 1, locals);
    }
    mergeOuterCallableUpdatesFromCode(locals, exprCode)
};

/** Upgrades uninitialized root bindings and appends forward root `futureValues` visible inside a top-level function body. */
upgradeRootUninitLocalsForFn := fn(locals: List<Local>, rootAssignedNames: Set<String>, futureValues: List<FutureValue>, functions: List<FunctionInfo>, fnDeclAt: Int): List<Local> {
    nextLocals: mut List<Local> = locals;
    preLen := localsCount(locals);
    var upgradedRootBag := "";
    var rootIdx := 0;
    loop rootIdx < preLen {
        rootEntry := locals[rootIdx];
        if rootEntry.depth == 0 and rootEntry.initState =!= INIT_STATE_INIT and
        not tokenInPipeBag(upgradedRootBag, rootEntry.name) and localIndex(locals, rootEntry.name) == rootIdx {
            if rootEntry.initState == INIT_STATE_UNINIT_ASSIGNED or rootAssignedNames.has(rootEntry.name) {
                upgradedRootBag = appendPipeBag(upgradedRootBag, rootEntry.name);
                mut nextLocals.pushBack((name = rootEntry.name, runtime = rootEntry.runtime, kind = rootEntry.kind,
                mutable = rootEntry.mutable, writable = rootEntry.writable, depth = -1, constant = false, code = rootEntry.code,
                intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            } else if rootEntry.initState == INIT_STATE_UNINIT and not rootEntry.mutable {
                upgradedRootBag = appendPipeBag(upgradedRootBag, rootEntry.name);
                mut nextLocals.pushBack((name = rootEntry.name, runtime = rootEntry.runtime, kind = rootEntry.kind,
                mutable = rootEntry.mutable, writable = rootEntry.writable, depth = -1, constant = false, code = rootEntry.code,
                intValue = 0, textValue = "", initState = INIT_STATE_MAYBE));
            }
        }
        rootIdx = rootIdx + 1;
    }
    var pushedFutureBag := "";
    loop futureValues as future {
        if future.at > fnDeclAt and not tokenInPipeBag(pushedFutureBag, future.name) {
            existingLocalIdx := localIndex(locals, future.name);
            isShadowedLocal := existingLocalIdx >= 0 and locals[existingLocalIdx].depth >= 0;
            existingFnIdx := findFunction(functions, future.name);
            isShadowedFn := existingFnIdx >= 0 and functions[existingFnIdx].declAt < fnDeclAt;
            if not isShadowedLocal and not isShadowedFn {
                pushedFutureBag = appendPipeBag(pushedFutureBag, future.name);
                mut nextLocals.pushBack((name = future.name, runtime = future.runtime, kind = future.kind,
                mutable = future.mutable, writable = future.writable, depth = -1, constant = false, code = "",
                intValue = 0, textValue = "", initState = future.initState));
            }
        }
    }
    nextLocals
};

/** Parses and validates a Bool branch condition followed by `{` for `if`, `else if`, or `match` arms. */
parseBranchCondExpr := fn(target: String, source: String, condStart: Int, prefix: String, errMsg: String,
beforeOpenErr: String, ctxs: List<ConstructCtx>, locals: List<Local>, functions: List<FunctionInfo>,
functionParams: List<String>, currentName: String, aliases: List<AliasDecl>): (code: String, rawCode: String, openPos: Int, constant: Bool, boolValue: Bool) {
    condition := parseExpressionCtx(target, source, condStart, prefix, locals, functions, functionParams, currentName, ctxs, aliases);
    if condition.kind =!= VALUE_KIND_BOOL {
        failAt(source, condStart, prefix, errMsg);
    }
    conditionCode := if condition.constant {
        ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
    } else {
        condition.code
    };
    beforeOpen := skipTrivia(source, condition.next, prefix);
    rejectMisplacedTag(source, beforeOpen, prefix, beforeOpenErr);
    openPos := expectSymbol(source, beforeOpen, "{", prefix);
    (code = conditionCode, rawCode = condition.code, openPos = openPos, constant = condition.constant, boolValue = condition.intValue =!= 0)
};

/** Skips any trailing `else if ... { ... }` and final `else { ... }` chain after a statically-true comptime branch `}`. */
skipTrailingElseChain := fn(source: String, afterBracePos: Int, prefix: String): Int {
    size := source.length();
    var curEnd := afterBracePos;
    loop true {
        after := skipTrivia(source, curEnd, prefix);
        if after >= size or not source.wordAt(after, "else") {
            return curEnd;
        }
        afterElse := skipTrivia(source, after + 4, prefix);
        if source.wordAt(afterElse, "if") {
            condStart := skipTrivia(source, afterElse + 2, prefix);
            openPos := scanConditionOpen(source, condStart, prefix);
            if openPos < 0 { return curEnd; }
            curEnd = scanBraceEnd(source, openPos, prefix);
        } else {
            openPos := skipTrivia(source, afterElse, prefix);
            if openPos >= size or source.at(openPos) =!= "{" { return curEnd; }
            return scanBraceEnd(source, openPos, prefix);
        }
    }
    curEnd
};

/** Skips any remaining subjectless `match` arms after a statically-true arm up to and including the closing `}`. */
skipRemainingMatchArms := fn(source: String, afterArmBrace: Int, prefix: String): Int {
    size := source.length();
    var cur := skipItemSeparators(source, afterArmBrace, prefix);
    loop cur < size and source.at(cur) =!= "}" {
        if source.wordAt(cur, "_") {
            afterU := skipTrivia(source, cur + 1, prefix);
            if afterU < size and source.at(afterU) == "{" {
                cur = skipItemSeparators(source, scanBraceEnd(source, afterU, prefix), prefix);
                continue;
            }
        }
        openPos := scanConditionOpen(source, cur, prefix);
        if openPos < 0 { break; }
        cur = skipItemSeparators(source, scanBraceEnd(source, openPos, prefix), prefix);
    }
    if cur < size and source.at(cur) == "}" { cur + 1 } else { cur }
};

/** Internal driver parsing either a complete module (`monoInstIdx < 0`) or one monomorphized generic instance body (`monoInstIdx >= 0`). */
parseProgramWithModuleInternal := fn(target: String, sourceIn: String, prefixIn: String, exports: Items, moduleKeyIn: String,
moduleIdentityIn: String, neededFns: String, skipSoftBuiltins: Bool, builtinSpecs: List<String>, monoInstIdx: Int): Items {
    sym.resetModule();
    var source := sourceIn;
    var prefix := prefixIn;
    var moduleKey := moduleKeyIn;
    var moduleIdentity := moduleIdentityIn;
    var size := source.length();
    var position := 0;
    var items: mut Items = [];
    isLtModule := prefix.endsWith(".lt");
    if monoInstIdx < 0 {
        position = skipTrivia(source, 0, prefix);
        if position == size { return items; }
    }
    neededFnSet: mut Set<String>;
    if monoInstIdx < 0 and neededFns =!= "*" {
        nfLen := neededFns.length();
        var nfPos := 0;
        loop nfPos < nfLen {
            if neededFns.at(nfPos) == "|" {
                nfNext := neededFns.indexOf("|", nfPos + 1);
                if nfNext > nfPos + 1 {
                    mut neededFnSet.add(neededFns.slice(nfPos + 1, nfNext));
                    nfPos = nfNext;
                    continue;
                }
            }
            nfPos = nfPos + 1;
        }
    }
    var builtinRules: Items = [];
    if monoInstIdx < 0 and skipSoftBuiltins and target == TARGET_TS and moduleIdentity.startsWithAt(0, "lite.core.") {
        builtinRules = parseBuiltinModeSpecs(prefix, builtinSpecs);
    }
    var aliases: mut List<AliasDecl> = [];
    publishedFunctions: mut Set<String>;
    publishedTypeOps: mut Set<String>;
    publishedValues: mut Set<String>;
    publishedTypes: mut Set<String>;
    var hasInnerAlias := monoInstIdx >= 0;
    var hasInnerFn := monoInstIdx >= 0;
    rootAssignedNames: mut Set<String>;
    var locals: mut List<Local> = [];
    var blockDecls: mut List<BlockDecl> = [];
    var blockAssignedDecls: mut List<BlockDecl> = [];
    blocks: mut List<String> = [];
    functions: mut List<FunctionInfo> = [];
    functionParams: mut List<String> = [];
    declaredImportAliases: mut Set<String>;
    var parameterTotal := 0;
    var futureValues: List<FutureValue> = [];
    if monoInstIdx < 0 {
    loop exports as exported {
        if exported.kind == ITEM_KIND_PUBLIC_TYPE {
            mut aliases.pushBack((name = exported.name, target = exported.code, at = -1, end = 0, depth = 0));
            if exported.textValue =!= "" {
                defTarget := if exported.code.startsWithAt(0, "@gentpl:") {
                    pDec := types.decodeLengthPrefixedAt(exported.code, 8);
                    tplBody := if pDec.next >= 0 { exported.code.slice(pDec.next, exported.code.length()) } else { "" };
                    ownerK := types.typeOpOwnerKey(tplBody);
                    if ownerK =!= "" { ownerK } else { exported.code }
                } else {
                    exported.code
                };
                aliases = types.appendEncodedRecordDefaults(aliases, defTarget, exported.textValue, 0);
            }
        }
    }
    decls := collectModuleDecls(target, source, prefix, moduleKey);
    loop decls as decl {
        if decl.kind == DECL_KIND_ALIAS {
            endPos := parseDigits(decl.textValue, 0, decl.textValue.length());
            mut aliases.pushBack((name = decl.name, target = decl.code, at = decl.intValue, end = endPos, depth = 0));
        } else if decl.kind == DECL_KIND_PUB_FN {
            mut publishedFunctions.add(decl.name);
        } else if decl.kind == DECL_KIND_PUB_TYPE_OP {
            mut publishedTypeOps.add(decl.name);
        } else if decl.kind == DECL_KIND_PUB_VAL {
            mut publishedValues.add(decl.name);
        } else if decl.kind == DECL_KIND_PUB_TYPE {
            mut publishedTypes.add(decl.name);
        } else if decl.kind == DECL_KIND_HAS_INNER_ALIAS {
            hasInnerAlias = true;
        } else if decl.kind == DECL_KIND_HAS_INNER_FN {
            hasInnerFn = true;
        } else if decl.kind == DECL_KIND_ROOT_ASSIGN {
            mut rootAssignedNames.add(decl.name);
        }
    }
    loop rootAssignedNames as rootAssigned {
        mut blockAssignedDecls.pushBack((name = rootAssigned, depth = 0));
    }
    loop exports as exported {
        if exported.kind == ITEM_KIND_MODULE_ALIAS {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported module name " + exported.name);
            }
            (mut locals).pushBack((name = exported.name, runtime = "", kind = VALUE_KIND_MODULE, mutable = false,
            writable = false, depth = 0, constant = false, code = "", intValue = exported.intValue,
            textValue = exported.name, initState = INIT_STATE_INIT));
        } else if exported.kind == ITEM_KIND_PUBLIC_FUNCTION {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            first := parameterTotal;
            loop splitPipeEntries(exported.textValue, exported.intValue) as expParam {
                mut functionParams.pushBack(expParam);
                parameterTotal = parameterTotal + 1;
            }
            (mut functions).pushBack((name = exported.name, runtime = exported.runtime, result = exported.code,
            first = first, count = exported.intValue, declAt = -1));
            if exported.name.indexOf(".", 0) < 0 {
                mut blockDecls.pushBack((name = exported.name, depth = 0));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_TYPE_OP {
            if findFunction(functions, exported.name) < 0 {
                first := parameterTotal;
                loop splitPipeEntries(exported.textValue, exported.intValue) as expParam {
                    mut functionParams.pushBack(expParam);
                    parameterTotal = parameterTotal + 1;
                }
                (mut functions).pushBack((name = exported.name, runtime = exported.runtime, result = exported.code,
                first = first, count = exported.intValue, declAt = -1));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_VALUE {
            if findFunction(functions, exported.name) >= 0 or localIndex(locals, exported.name) >= 0 {
                diagLib.fail(prefix, "duplicate imported public name " + exported.name);
            }
            (mut locals).pushBack((name = exported.name, runtime = exported.runtime, kind = exported.code,
            mutable = false, writable = false, depth = 0, constant = false, code = exported.runtime,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
            if exported.name.indexOf(".", 0) < 0 {
                mut blockDecls.pushBack((name = exported.name, depth = 0));
            }
        } else if exported.kind == ITEM_KIND_PUBLIC_TYPE {
            if findAlias(aliases, exported.name) < 0 {
                diagLib.fail(prefix, "unknown imported public type " + exported.name);
            }
            if exported.name.indexOf(".", 0) < 0 {
                mut blockDecls.pushBack((name = exported.name, depth = 0));
            }
        }
    }
    loop decls as decl {
        if decl.kind == DECL_KIND_FUTURE_FN {
            fnName := decl.name;
            fnAt := decl.intValue;
            if findFunction(functions, fnName) < 0 and localIndex(locals, fnName) < 0 {
                var shadowedBefore := false;
                loop decls as priorDecl {
                    if priorDecl.name == fnName and priorDecl.intValue < fnAt and
                    (priorDecl.kind == DECL_KIND_ALIAS or priorDecl.kind == DECL_KIND_FUTURE_DECL) {
                        shadowedBefore = true;
                        break;
                    }
                }
                if not shadowedBefore {
                    headerPos := parseDigits(decl.textValue, 0, decl.textValue.length());
                    fnListIntrinsic := (moduleIdentity == "lite.core.list.v1" and
                    (fnName == "pushBack" or fnName == "popBack" or fnName == "pushFront" or fnName == "popFront" or
                    fnName == "length" or fnName == "setAt" or fnName == "slice" or fnName == "reverse" or fnName == "clear")) or
                    (moduleIdentity == "lite.core.map.v1" and
                    (fnName == "set" or fnName == "get" or fnName == "getOr" or fnName == "has" or
                    fnName == "remove" or fnName == "size" or fnName == "clear" or fnName == "keys" or fnName == "values")) or
                    (moduleIdentity == "lite.core.set.v1" and
                    (fnName == "add" or fnName == "has" or fnName == "remove" or
                    fnName == "size" or fnName == "clear" or fnName == "values"));
                    if canPreParseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic) {
                        header := parseFunctionHeader(source, headerPos, prefix, aliases, fnListIntrinsic);
                        afterHdr := skipTrivia(source, header.next, prefix);
                        if afterHdr < size and source.at(afterHdr) == ";" {
                            hostRuntime := builtinsAbi.coreHostFunction(moduleIdentity, fnName, header.params, header.result);
                            if publishedFunctions.has(fnName) and hostRuntime =!= "" {
                                mut functions.pushBack((name = fnName, runtime = hostRuntime, result = header.result,
                                first = parameterTotal, count = header.count, declAt = fnAt));
                                loop splitPipeEntries(header.params, header.count) as hp {
                                    mut functionParams.pushBack(hp);
                                    parameterTotal = parameterTotal + 1;
                                }
                            }
                        } else if header.count >= 0 and afterHdr < size and source.at(afterHdr) == "{" {
                            var fnRuntime := moduleFunctionRuntime(target, moduleKey, fnName);
                            if header.genericType =!= "" {
                                tplKey := moduleKey + "#" + fnName;
                                fnRuntime = "$gen:" + tplKey;
                                bodyEnd := skipBraceBlock(source, afterHdr + 1, prefix);
                                generics.registerTemplate((
                                    key = tplKey, qualName = fnName, typeOpKey = "",
                                    moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                                    prefix = prefix, source = source,
                                    bodyStart = afterHdr + 1, bodyEnd = bodyEnd, declAt = fnAt,
                                    genericParams = header.genericType, params = header.params,
                                    paramCount = header.count, result = header.result,
                                    selfTarget = "", isPub = publishedFunctions.has(fnName)
                                ));
                            }
                            (mut functions).pushBack((name = fnName, runtime = fnRuntime, result = header.result,
                            first = parameterTotal, count = header.count, declAt = fnAt));
                            loop splitPipeEntries(header.params, header.count) as hp {
                                mut functionParams.pushBack(hp);
                                parameterTotal = parameterTotal + 1;
                            }
                        }
                    }
                }
            }
        } else if decl.kind == DECL_KIND_FUTURE_TYPE_OP {
            qualName := decl.name;
            dotPos := qualName.indexOf(".", 0);
            if dotPos > 0 {
                tName := qualName.slice(0, dotPos);
                oName := qualName.slice(dotPos + 1, qualName.length());
                opAt := decl.intValue;
                owner := resolveOwnedTypeOpTarget(source, opAt, prefix, aliases, moduleIdentity, tName);
                if owner.ok {
                    typeOpKey := "$typeop:" + owner.ownerKey + "." + oName;
                    if findFunction(functions, typeOpKey) < 0 {
                        headerPos := parseDigits(decl.textValue, 0, decl.textValue.length());
                        scopedSelf := types.withSelfAlias(aliases, owner.selfTarget, 0);
                        if canPreParseFunctionHeader(source, headerPos, prefix, scopedSelf, false) {
                            header := types.parseTypeOpHeader(source, headerPos, prefix, aliases, tName, oName, owner.selfTarget, owner.ownerKey, owner.isGenericOwner);
                            afterHdr := skipTrivia(source, header.next, prefix);
                            if afterHdr < size and source.at(afterHdr) == ";" {
                                hostRuntime := builtinsAbi.coreHostFunction(moduleIdentity, qualName, header.params, header.result);
                                if publishedTypeOps.has(qualName) and hostRuntime =!= "" {
                                    mut functions.pushBack((name = typeOpKey, runtime = hostRuntime, result = header.result,
                                    first = parameterTotal, count = header.count, declAt = opAt));
                                    loop splitPipeEntries(header.params, header.count) as hp {
                                        mut functionParams.pushBack(hp);
                                        parameterTotal = parameterTotal + 1;
                                    }
                                }
                            } else if header.count >= 1 and afterHdr < size and source.at(afterHdr) == "{" {
                                var fnRuntime := moduleFunctionRuntime(target, moduleKey, qualName);
                                if header.genericType =!= "" {
                                    tplKey := moduleKey + "#" + qualName;
                                    fnRuntime = "$gen:" + tplKey;
                                    bodyEnd := skipBraceBlock(source, afterHdr + 1, prefix);
                                    generics.registerTemplate((
                                        key = tplKey, qualName = qualName, typeOpKey = typeOpKey,
                                        moduleKey = moduleKey, moduleIdentity = moduleIdentity,
                                        prefix = prefix, source = source,
                                        bodyStart = afterHdr + 1, bodyEnd = bodyEnd, declAt = opAt,
                                        genericParams = header.genericType, params = header.params,
                                        paramCount = header.count, result = header.result,
                                        selfTarget = owner.selfTarget, isPub = publishedTypeOps.has(qualName)
                                    ));
                                }
                                (mut functions).pushBack((name = typeOpKey, runtime = fnRuntime, result = header.result,
                                first = parameterTotal, count = header.count, declAt = opAt));
                                loop splitPipeEntries(header.params, header.count) as hp {
                                    mut functionParams.pushBack(hp);
                                    parameterTotal = parameterTotal + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    var rootAssignedBag := "|";
    loop rootAssignedNames as rootAssigned {
        rootAssignedBag = appendPipeBag(rootAssignedBag, rootAssigned);
    }
    futureValues = infer.resolveFutureDecls(target, source, prefix, moduleKey, true, decls, rootAssignedBag, aliases, functions, functionParams, locals);
    var placeholderNamesBag := "";
    loop futureValues as future {
        if localIndex(locals, future.name) < 0 and findFunction(functions, future.name) < 0 and
        not tokenInPipeBag(placeholderNamesBag, future.name) {
            placeholderNamesBag = appendPipeBag(placeholderNamesBag, future.name);
            mut locals.pushBack((name = future.name, runtime = future.runtime, kind = future.kind,
            mutable = future.mutable, writable = future.writable, depth = -2, constant = false, code = "",
            intValue = 0, textValue = "", initState = future.initState));
        }
    }
    }
    var maxFutureAt := -1;
    var blockCount := 0;
    var depth := 0;
    var currentName := "";
    var currentFnRuntime := "";
    var currentResult := "";
    var currentReturned := false;
    var currentStopped := false;
    var branchesReturned := true;
    var branchesStopped := true;
    var hasElse := false;
    var loopForever := false;
    var currentLive := true;
    var liveBranchCount := 0;
    savedStates: mut List<BlockState> = [];
    var branchUpdates: mut List<BranchUpdate> = [];
    var stmtCtxs: mut List<ConstructCtx> = [];
    var nextStmtCtxId := 1;
    transferCodes: mut List<String> = [];
    var transferCount := 0;
    var fnTryKey := "";
    monoTryPrefix := if monoInstIdx >= 0 { "#m" + monoInstIdx.toText() } else { "" };
    var fnTransferStart := 0;
    loopIds: mut List<Int> = [];
    loopTryKeys: mut List<String> = [];
    loopTransferStarts: mut List<Int> = [];
    var locCursor := 0;
    var locLine := 1;
    var locLineStart := 0;
    var lastEmittedLocLine := 0;
    if monoInstIdx >= 0 {
        inst := generics.getInstance(monoInstIdx);
        tpl := generics.getTemplate(generics.findTemplate(inst.templateKey));
        envIdx := generics.findModuleEnv(tpl.moduleKey);
        source = tpl.source;
        prefix = tpl.prefix;
        moduleKey = tpl.moduleKey;
        moduleIdentity = tpl.moduleIdentity;
        size = tpl.bodyEnd;
        position = skipTrivia(source, tpl.bodyStart, prefix);
        if envIdx >= 0 {
            rng := generics.getModuleEnvRange(envIdx);
            var ei := 0;
            loop ei < rng.localsCount {
                mut locals.pushBack(generics.getEnvLocal(rng.localsStart + ei));
                ei = ei + 1;
            }
            ei = 0;
            loop ei < rng.fnsCount {
                mut functions.pushBack(generics.getEnvFunction(rng.fnsStart + ei));
                ei = ei + 1;
            }
            ei = 0;
            loop ei < rng.paramsCount {
                mut functionParams.pushBack(generics.getEnvFnParam(rng.paramsStart + ei));
                parameterTotal = parameterTotal + 1;
                ei = ei + 1;
            }
            ei = 0;
            loop ei < rng.aliasesCount {
                mut aliases.pushBack(generics.getEnvAlias(rng.aliasesStart + ei));
                ei = ei + 1;
            }
            fvCopy: mut List<FutureValue> = [];
            ei = 0;
            loop ei < rng.futuresCount {
                mut fvCopy.pushBack(generics.getEnvFuture(rng.futuresStart + ei));
                ei = ei + 1;
            }
            futureValues = fvCopy;
            ei = 0;
            loop ei < rng.assignedCount {
                ra := generics.getEnvAssigned(rng.assignedStart + ei);
                mut rootAssignedNames.add(ra);
                mut blockAssignedDecls.pushBack((name = ra, depth = 0));
                ei = ei + 1;
            }
        }
        monoSelfName := "$mono:" + inst.runtime;
        monoFirst := parameterTotal;
        loop splitPipeEntries(inst.substParams, tpl.paramCount) as sp {
            mut functionParams.pushBack(sp);
            parameterTotal = parameterTotal + 1;
        }
        (mut functions).pushBack((name = monoSelfName, runtime = inst.runtime, result = inst.substResult,
        first = monoFirst, count = tpl.paramCount, declAt = tpl.declAt));
        mut items.pushBack((kind = ITEM_KIND_FUNCTION_START, name = tpl.qualName, runtime = inst.runtime,
        code = inst.substResult, intValue = tpl.paramCount, textValue = inst.substParams));
        fnTryId := nextStmtCtxId;
        nextStmtCtxId = nextStmtCtxId + 1;
        if target == TARGET_TS {
            fnTryKey = moduleKey + monoTryPrefix + "#mono#" + fnTryId.toText();
            fnTransferStart = transferCount;
            mut items.pushBack((kind = ITEM_KIND_TRANSFER_TRY, name = "", runtime = fnTryKey, code = "", intValue = 0, textValue = ""));
        }
        (mut stmtCtxs).pushBack((id = 0, tag = "", kind = CTX_KIND_FN, phase = CTX_PHASE_BODY,
        iifeDepth = 0, valKind = inst.substResult, valVar = "", label = "",
        iterLabel = "1", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
        fnPreLocalsLen := localsCount(locals);
        upgradedMonoLocals := upgradeRootUninitLocalsForFn(locals, rootAssignedNames, futureValues, functions, tpl.declAt);
        locals = [];
        loop upgradedMonoLocals as upg { mut locals.pushBack(upg); }
        var fnParamSeedBag := "";
        loop splitPipeEntries(inst.substParams, tpl.paramCount) as entry {
            parameterName := paramNameOf(entry);
            rawParamKind := paramKindOf(entry);
            isMutParam := rawParamKind.startsWithAt(0, "mut ");
            parameterKind := if isMutParam { rawParamKind.slice(4, rawParamKind.length()) } else { rawParamKind };
            pRuntime := ir.safeTargetIdent(target, parameterName);
            runtime := if isMutParam and target == TARGET_C { "(*lite_" + pRuntime + ")" }
            else if isMutParam and types.isRecordOrDistinctRecord(parameterKind) { "lite_" + pRuntime + ".v" }
            else { "lite_" + pRuntime };
            fnParamSeedBag = appendPipeBag(fnParamSeedBag, parameterName);
            mut blockDecls.pushBack((name = parameterName, depth = 1));
            mut locals.pushBack((name = parameterName, runtime = runtime, kind = parameterKind,
            mutable = false, writable = isMutParam, depth = 1, constant = false, code = runtime,
            intValue = 0, textValue = "", initState = INIT_STATE_INIT));
        }
        currentName = monoSelfName;
        currentFnRuntime = inst.runtime;
        currentResult = inst.substResult;
        mut savedStates.pushBack((returned = false, stopped = false,
        branchesReturned = true, branchesStopped = true, hasElse = false, loopForever = false, live = true,
        preLocalsLen = fnPreLocalsLen, liveBranchCount = 0));
        mut blocks.pushBack(BLOCK_KIND_FUNCTION);
        blockCount = 1;
        depth = 1;
        if tpl.selfTarget =!= "" {
            aliases = types.withSelfAlias(aliases, tpl.selfTarget, 1);
        }
        loop generics.decodeBindings(inst.bindingsEncoded) as b {
            if types.isComptimeValueToken(b.kind) {
                mut aliases.pushBack((name = b.name, target = "$Val:" + b.kind, at = tpl.declAt, end = tpl.declAt, depth = 1));
                valKind := types.comptimeValueTokenKind(b.kind);
                var valInt := 0;
                var valText := "";
                var valCode := "";
                if valKind == VALUE_KIND_INT {
