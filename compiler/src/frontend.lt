/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit { syntax.failAt(source, position, prefix, message); };

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int { syntax.expectSymbol(source, position, symbol, prefix) };

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int { syntax.skipComment(source, position, prefix) };

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int { syntax.skipTrivia(source, start, prefix) };

/** Consumes an explicit separator or an implicit boundary at EOF, a closing scope or a directly closed block expression. Returns -1 when a simple item still needs a separator. */
consumeStatementEnd := fn(source: String, position: Int, prefix: String): Int { syntax.consumeStatementEnd(source, position, prefix) };

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool { syntax.isReservedWord(name) };

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit { syntax.unsupportedFeature(source, position, name, prefix); };

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int { sym.findFunction(functions, name) };

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool { types.isUnsupportedAliasTarget(name) };

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit { types.unsupportedAliasTarget(source, position, prefix, target); };

/** Returns the index of the first visible alias named `name` at the innermost active block depth, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int { types.findAlias(aliases, name) };

/** Reads one local or module-qualified type name. */
typeNameAt := fn(source: String, position: Int, prefix: String): (name: String, next: Int) { types.typeNameAt(source, position, prefix) };

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int { types.aliasIndexAt(aliases, position) };

/** Returns the highest block depth present in `aliases`, or 0 when `aliases` is empty. */
maxAliasDepth := fn(aliases: List<AliasDecl>): Int { types.maxAliasDepth(aliases) };

/** Drops aliases declared at block depth `depth` or deeper when exiting a block. */
popBlockAliases := fn(aliases: List<AliasDecl>, depth: Int): List<AliasDecl> { types.popBlockAliases(aliases, depth) };

/** Filters `aliases` to declarations at or above `maxDepth` for lexical outer-alias expansion. */
aliasesUpToDepth := fn(aliases: List<AliasDecl>, maxDepth: Int): List<AliasDecl> { types.aliasesUpToDepth(aliases, maxDepth) };

/** True when `kind` is this compiler's canonical flat tuple kind, written `(label:Kind,:Kind)`. */
pub isTupleKind := fn(kind: String): Bool { types.isTupleKind(kind) };

/** True when `kind` is this compiler's canonical nominal record kind `Record<id#at#DisplayName;f1:K1,...>`. */
pub isMapKind := fn(kind: String): Bool { types.isMapKind(kind) };
/** True when `kind` is a `Set<T>` type kind. */
pub isSetKind := fn(kind: String): Bool { types.isSetKind(kind) };
/** True when `kind` is an `Rc<T>` type kind. */
pub isRcKind := fn(kind: String): Bool { types.isRcKind(kind) };
/** True when `kind` is a borrowed `Slice<T>` type kind. */
pub isSliceKind := fn(kind: String): Bool { types.isSliceKind(kind) };
/** Returns the element type of a borrowed `Slice<T>` type kind. */
pub sliceElementKind := fn(kind: String): String { types.sliceElementKind(kind) };
/** True when `kind` is `Slice<T>` or transitively contains one. */
pub containsSliceKind := fn(kind: String): Bool { types.containsSliceKind(kind) };
/** True when `kind` is a bit-packed fixed array whose storage cannot be sliced in Phase 7. */
pub isBitPackedArrayKind := fn(kind: String): Bool { types.isBitPackedArrayKind(kind) };
/** Returns the C11 slice helper tag (`lt_slice_<elem>`), or `""`. */
pub cSliceTag := fn(kind: String): String { types.cSliceTag(kind) };
/** True when `moduleIdentity` is a registered core module allowed to declare `Slice<T>` constructors. */
isCoreSliceHostModule := fn(moduleIdentity: String): Bool {
    moduleIdentity == "lite.core.list.v1" or moduleIdentity == "lite.core.array.v1" or
    moduleIdentity == "lite.core.text.v1" or moduleIdentity == "lite.core.slice.v1" or
    moduleIdentity == "lite.core.simd.v1"
};;
/** True when `kind` is canonical `Simd<T,N>`. */
pub isSimdKind := fn(kind: String): Bool { types.isSimdKind(kind) };
/** Returns element kind `T` from `Simd<T,N>`. */
pub simdElementKind := fn(kind: String): String { types.simdElementKind(kind) };
/** Returns integer lane count `N` from `Simd<T,N>`. */
pub simdLaneCount := fn(kind: String): Int { types.simdLaneCount(kind) };
/** Returns raw lane count text from `Simd<T,N>`. */
pub simdLaneCountText := fn(kind: String): String { types.simdLaneCountText(kind) };
/** True when `kind` is an admitted `Simd` lane scalar type. */
pub isSimdElemKind := fn(kind: String): Bool { types.isSimdElemKind(kind) };
/** Returns byte width of a `Simd` element kind. */
pub simdElemByteWidth := fn(kind: String): Int { types.simdElemByteWidth(kind) };
/** Returns target lane count for `SimdNative<T>`. */
pub simdNativeLaneCount := fn(kind: String): Int { types.simdNativeLaneCount(kind) };
/** Returns true when `(elemKind, lanes)` is valid for `Simd<T, N>`. */
pub isValidSimdLaneCount := fn(elemKind: String, lanes: Int): Bool { types.isValidSimdLaneCount(elemKind, lanes) };
/** Returns C11 typedef name `lt_simd_<tag>_<n>` or `""`. */
pub cSimdTag := fn(kind: String): String { types.cSimdTag(kind) };
/** True when `kind` is canonical `SoA<R>`. */
pub isSoaKind := fn(kind: String): Bool { types.isSoaKind(kind) };
/** Returns underlying record kind `R` from `SoA<R>`. */
pub soaRecordKind := fn(kind: String): String { types.soaRecordKind(kind) };
/** Returns C11 typedef name `lt_soa_<hash>` or `""`. */
pub cSoaTag := fn(kind: String): String { types.cSoaTag(kind) };
/** True when `kind` is canonical `Iface<key>` or `Iface<key;Args...>`. */
pub isInterfaceKind := fn(kind: String): Bool { types.isInterfaceKind(kind) };
/** Returns interface definition key `moduleKey#Name`. */
pub ifaceKeyOf := fn(kind: String): String { types.ifaceKeyOf(kind) };
/** Returns instantiated interface type arguments. */
pub ifaceArgsOf := fn(kind: String): List<String> { types.ifaceArgsOf(kind) };
/** True when `kind` is canonical borrowed dynamic view `Dyn<Iface<...>>`. */
pub isDynKind := fn(kind: String): Bool { types.isDynKind(kind) };
/** Returns inner `Iface<...>` from `Dyn<Iface<...>>`. */
pub dynInterfaceKind := fn(kind: String): String { types.dynInterfaceKind(kind) };
/** True when `kind` is `Dyn<...>` or transitively contains one. */
pub containsDynKind := fn(kind: String): Bool { types.containsDynKind(kind) };
/** Returns C11 16 B dyn fat-pointer struct typedef `lt_dyn_<hash>`. */
pub cDynTag := fn(kind: String): String { types.cDynTag(kind) };
pub isCtxKind := fn(kind: String): Bool { types.isCtxKind(kind) };
pub cCtxTag := fn(kind: String): String { types.cCtxTag(kind) };
pub fnParamIsOptional := fn(kind: String, targetIndex: Int): Bool { types.fnParamIsOptional(kind, targetIndex) };
pub fnHasOptionalParams := fn(kind: String): Bool { types.fnHasOptionalParams(kind) };
pub paramNameOf := fn(entry: String): String { types.paramNameOf(entry) };
pub paramIsOptional := fn(entry: String): Bool { types.paramIsOptional(entry) };
pub fnContextKind := fn(kind: String): String { types.fnContextKind(kind) };
/** Returns C11 vtable struct typedef `lt_vt_<hash>`. */
pub cVtableTag := fn(kind: String): String { types.cVtableTag(kind) };
/** Error message when storing borrowed types (`Slice<T>`, `dyn Iface`) in escaping positions, or `""`. */
pub borrowedStorageError := fn(kind: String): String { types.borrowedStorageError(kind) };
/** Returns interface methods with concrete interface type arguments substituted (`Self` preserved). */
pub instantiatedInterfaceMethods := fn(ifaceKind: String): List<interfaces.InterfaceMethod> { types.instantiatedInterfaceMethods(ifaceKind) };
/** Looks up a conformance matching `(actualKind, ifaceKind)` returning `(found, implIdx, bindingsEncoded)`. */
pub findImplForConcrete := fn(actualKind: String, ifaceKind: String): (found: Bool, implIdx: Int, bindingsEncoded: String) { types.findImplForConcrete(actualKind, ifaceKind) };
/** True when concrete `actualKind` satisfies `constraintKind` (exact, nominal family, union, interface, or `All<...>`). */
pub typeSatisfiesConstraint := fn(actualKind: String, constraintKind: String): Bool { types.typeSatisfiesConstraint(actualKind, constraintKind) };
/** Looks up an unambiguous `impl` method for concrete dot-call dispatch. */
pub findImplMethodForConcrete := fn(actualKind: String, methodName: String, allowedIfaceKinds: List<String>): (found: Bool, ambiguous: Bool, ifaceName: String, fnKey: String, implIdx: Int, bindingsEncoded: String, recvMut: Bool) {
    types.findImplMethodForConcrete(actualKind, methodName, allowedIfaceKinds)
};
/** True when `kind` is a canonical closed-union or runtime union type `Union<...>`. */
pub isUnionKind := fn(kind: String): Bool { types.isUnionKind(kind) };
/** Returns flat canonical members of `kind`. */
