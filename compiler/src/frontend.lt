            afterRawIf := if rawIfEnd >= 0 { skipTrivia(source, rawIfEnd, prefix) } else { -1 };
            if afterRawIf >= 0 and (source.wordAt(afterRawIf, "then") or source.wordAt(afterRawIf, "finally")) {
