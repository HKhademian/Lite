    }
    var maxFutureAt := -1;
    var blockCount := 0;
    var depth := 0;
    var currentName := "";
    var currentFnRuntime := "";
    var currentResult := "";
    var currentFnDeclAt := -1;
    var currentFnItemStart := 0;
    var currentFnCtxKind := "";
