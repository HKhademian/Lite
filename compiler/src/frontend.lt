ternaryChainCode := fn(target: String, resultKind: String, conditionCodes: List<String>, branchCodes: List<String>, branchKinds: List<String>, branchCount: Int): String { ctx.ternaryChainCode(target, resultKind, conditionCodes, branchCodes, branchKinds, branchCount) };

