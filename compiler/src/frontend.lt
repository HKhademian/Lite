                        (mut functions).pushBack((name = mFnKey, runtime = mRuntime, result = mResult,
                        first = parameterTotal, count = mCount, declAt = mDeclAt));
                        loop splitPipeEntries(mParams, mCount) as hp {
                            mut functionParams.pushBack(hp);
