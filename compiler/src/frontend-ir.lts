/** True when `kind` is one of the signed integer scalar types (`Int8`, `Int16`, `Int32`, `Int`). */
pub isIntScalarKind := fn(kind: String): Bool { numeric.isIntKind(kind) }

/** True when `kind` is one of the binary float scalar types (`Float32`, `Float`). */
pub isFloatScalarKind := fn(kind: String): Bool { numeric.isFloatKind(kind) }

/** Selects the TS or C backend implementation for one boolean literal. */
pub targetBoolLiteralCode := fn(target: String, value: Bool): String { if target == TARGET_TS { tsLiteral.boolLiteralCode(value) } else { cLiteral.boolLiteralCode(value) } }

/** Selects the TS or C backend implementation for one chained comparison. */
pub targetComparisonChainCode := fn(target: String, codes: List<String>, kinds: List<String>, operators: List<String>, count: Int, position: Int): String { if target == TARGET_TS { tsLiteral.comparisonChainCode(codes, kinds, operators, count, position) } else { cLiteral.comparisonChainCode(codes, kinds, operators, count, position) } }

/** Selects the TS or C backend implementation for one comparison operation. */
pub targetComparisonCode := fn(target: String, op: String, kind: String, left: String, right: String): String { if target == TARGET_TS { tsLiteral.comparisonCode(op, kind, left, right) } else { cLiteral.comparisonCode(op, kind, left, right) } }

/** Selects the TS or C backend implementation for string concatenation. */
pub targetConcatCode := fn(target: String, left: String, right: String): String { if target == TARGET_TS { tsLiteral.concatCode(left, right) } else { cLiteral.concatCode(left, right) } }

