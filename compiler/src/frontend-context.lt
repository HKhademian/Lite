/** Expression/block context tracking, branch/loop state joining, constant folding, value conversions, and loop-field resolution. */

integer := import "core/int";
listLib := import "core/list";
textLib := import "core/text";
tb := import "util/text-builder";
numeric := import "./numeric-literals";
ir := import "./frontend-ir";
sym := import "./symbol-table";
syntax := import "./frontend-syntax";
types := import "./frontend-types";
trace := import "./trace-safety";

/** One parsed expression matching `frontend-ir.Parsed`. */
Parsed := alias (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);

/** One local visible to later statements matching `frontend-ir.Local`. */
Local := alias (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);

/** Symbol declaration name owned directly by one block matching `frontend-ir.BlockDecl`. */
BlockDecl := alias (name: String, depth: Int);

/** One outer local initialization and callable-dependency update matching `frontend-ir.BranchUpdate`. */
BranchUpdate := alias (depth: Int, arm: Int, runtime: String, initState: String, code: String);

/** Lexical control-flow and metadata context matching `frontend-ir.ConstructCtx`. */
ConstructCtx := alias (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool, colVar: String);

/** Builds an integer parsed value with explicit scalar kind `kind`; `textValue` is empty. */
pub typedIntParsed := fn(kind: String, code: String, value: Int, constant: Bool, next: Int): Parsed {
    (kind = kind, code = code, intValue = value, textValue = "", constant = constant, next = next)
};

/** Builds an Int parsed value; `textValue` is empty. */
pub intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed {
    typedIntParsed(ir.VALUE_KIND_INT, code, value, constant, next)
};

/** Builds a String parsed value; `intValue` is zero. */
pub textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed {
    (kind = ir.VALUE_KIND_STRING, code = code, intValue = 0, textValue = value, constant = constant, next = next)
};

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
pub boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed {
    (kind = ir.VALUE_KIND_BOOL, code = code, intValue = if value { 1 } else { 0 }, textValue = "", constant = constant, next = next)
};

/** Tries a constant integer operation without raising a compile-time runtime fault. */
pub tryFoldInteger := fn(operator: String, left: Int, right: Int): (value: Int, ok: Bool) {
    if operator == "+" { return left.checkedAdd(right); }
    if operator == "-" { return left.checkedSub(right); }
    if operator == "*" { return left.checkedMul(right); }
    if operator == "/" { return left.checkedDiv(right); }
    if operator == "%" { return left.checkedRem(right); }
    if operator == ":/" { return left.floorDiv(right); }
    left.floorMod(right)
};

/** Lowers a checked integer operation whose result is not a safe constant, preserving evaluation and fault timing. */
pub runtimeIntegerCode := fn(target: String, operator: String, left: String, right: String, position: Int): String {
    if operator == "+" { return ir.targetIntAddCode(target, left, right, position); }
    if operator == "-" { return ir.targetIntSubtractCode(target, left, right, position); }
    if operator == "*" { return ir.targetIntMultiplyCode(target, left, right, position); }
    if operator == "/" { return ir.targetIntDivideCode(target, left, right, position); }
    if operator == "%" { return ir.targetIntRemainderCode(target, left, right, position); }
    if operator == ":/" { return ir.targetIntFloorDivideCode(target, left, right, position); }
    ir.targetIntFloorModuloCode(target, left, right, position)
};

/** Lowers a checked integer operation at `kind` (signed or unsigned), adding a runtime range guard for narrow integer widths outside divisions/remainders. */
pub runtimeTypedIntegerCode := fn(target: String, kind: String, operator: String, left: String, right: String, position: Int): String {
    if numeric.isUnsignedIntKind(kind) {
        rawU := ir.targetUIntBinaryCode(target, operator, left, right, position);
        if numeric.isNarrowUnsignedIntKind(kind) and operator =!= "%" and operator =!= ":%" and operator =!= "/" and operator =!= ":/" {
            return ir.targetCheckedNarrowUIntCode(target, kind, rawU, position);
        }
        return rawU;
    }
    raw := runtimeIntegerCode(target, operator, left, right, position);
    if numeric.isNarrowSignedIntKind(kind) and operator =!= "%" and operator =!= ":%" {
        return ir.targetCheckedNarrowIntCode(target, kind, raw, position);
    }
    raw
};

/** Folds one of the ten Int comparisons to a Bool. */
pub compareIntegers := fn(operator: String, left: Int, right: Int): Bool {
    if operator == "==" { left == right }
    else if operator == "=!=" { left =!= right }
    else if operator == "<" { left < right }
    else if operator == "<!" { left >= right }
    else if operator == "<=" { left <= right }
    else if operator == "<!=" { left > right }
    else if operator == ">" { left > right }
    else if operator == ">!" { left <= right }
    else if operator == ">=" { left >= right }
    else { left < right }
};

/** Folds String equality or inequality. */
pub compareTexts := fn(operator: String, left: String, right: String): Bool {
    if operator == "==" { left == right } else { left =!= right }
};

/** Folds Bool equality or inequality. */
pub compareBools := fn(operator: String, left: Bool, right: Bool): Bool {
    if operator == "==" { left == right } else { left =!= right }
};

/** Monotonic suffix counter for C11 union/result conversion temporaries. */
var cUnionTmpSeq := 0;

/** Returns true when `kind` supports `==` / `=!=` value comparison (including unions/results of comparable scalars). */
isEqualityComparableKind := fn(kind: String): Bool {
    base := types.distinctBaseKind(kind);
    if numeric.isNumericKind(base) or base == ir.VALUE_KIND_STRING or base == ir.VALUE_KIND_BOOL or base == ir.VALUE_KIND_UNIT or
    (types.isEnumKind(base) and not types.isPayloadEnumKind(base)) {
        return true;
    }
    if types.isUnionKind(base) {
        loop types.unionMembers(base) as m {
            if not self(m) { return false; }
        }
        return true;
    }
    if types.isResultKind(base) {
        return self(types.resultOkKind(base)) and self(types.resultErrKind(base));
    }
    false
};

/** Emits a TS or C11 `==` / `=!=` expression for two union or result expressions of identical canonical `kind`. */
unionOrResultEqExpr := fn(target: String, kind: String, leftCode: String, rightCode: String, negate: Bool): String {
    if target == ir.TARGET_C {
        tag := types.cStructTag(kind);
        if tag == "" { return if negate { "true" } else { "false" }; }
        if leftCode.startsWithAt(0, "/*@CBLK:") or rightCode.startsWithAt(0, "/*@CBLK:") {
            cUnionTmpSeq = cUnionTmpSeq + 1;
            sid := cUnionTmpSeq.toText();
            lVar := "lt_eql_" + sid;
            rVar := "lt_eqr_" + sid;
            resVar := "lt_eqb_" + sid;
            cT := types.cValueType(kind);
            lInit := if leftCode.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(lVar, kind, leftCode) } else { lVar + " = " + leftCode + ";" };
            rInit := if rightCode.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(rVar, kind, rightCode) } else { rVar + " = " + rightCode + ";" };
            dropFn := types.cDropFnForKind(kind);
            lDrop := if dropFn =!= "" and (leftCode.startsWithAt(0, "/*@CBLK:") or isCFreshOwnedExpr(leftCode)) { " " + dropFn + "(&" + lVar + ");" } else { "" };
            rDrop := if dropFn =!= "" and (rightCode.startsWithAt(0, "/*@CBLK:") or isCFreshOwnedExpr(rightCode)) { " " + dropFn + "(&" + rVar + ");" } else { "" };
            eqCall := tag + "_eq(" + lVar + ", " + rVar + ")";
            resAssign := resVar + " = " + (if negate { "!" + eqCall } else { eqCall }) + ";";
            return "/*@CBLK:" + resVar + "@*/bool " + resVar + "; { " + cT + " " + lVar + "; " + cT + " " + rVar + "; " + lInit + " " + rInit + " " + resAssign + lDrop + rDrop + " }";
        }
        rawEq := tag + "_eq(" + leftCode + ", " + rightCode + ")";
        return if negate { "(!" + rawEq + ")" } else { rawEq };
    }
    tsT := types.tsFunctionType(kind);
    if types.isUnionKind(kind) {
        mems := types.unionMembers(kind);
        mut casesBuf: tb.TextBuilder;
        var ui := 0;
        loop ui < mems.length() {
            m := mems[ui];
            mut casesBuf.append("case ");
            mut casesBuf.append(ui.toText());
            mut casesBuf.append(": return ");
            if m == ir.VALUE_KIND_UNIT {
                mut casesBuf.append("true");
            } else if types.isUnionKind(m) or types.isResultKind(m) {
                mut casesBuf.append(self(target, m, "(a as { _u: " + ui.toText() + "; _v: " + types.tsFunctionType(m) + " })._v", "(b as { _u: " + ui.toText() + "; _v: " + types.tsFunctionType(m) + " })._v", false));
            } else {
                mut casesBuf.append("((a as { _u: " + ui.toText() + "; _v: " + types.tsFunctionType(m) + " })._v === (b as { _u: " + ui.toText() + "; _v: " + types.tsFunctionType(m) + " })._v)");
            }
            mut casesBuf.append("; ");
            ui = ui + 1;
        }
        tsEq := "((a: " + tsT + ", b: " + tsT + "): boolean => { if (a._u !== b._u) return false; switch (a._u) { " + casesBuf.build() + "default: return false; } })(" + leftCode + ", " + rightCode + ")";
        return if negate { "(!" + tsEq + ")" } else { tsEq };
    }
    okK := types.resultOkKind(kind);
    errK := types.resultErrKind(kind);
    okEq := if okK == ir.VALUE_KIND_UNIT {
        "true"
    } else if types.isUnionKind(okK) or types.isResultKind(okK) {
        self(target, okK, "(a as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v", "(b as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v", false)
    } else {
        "((a as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v === (b as { _r: 0; _v: " + types.tsFunctionType(okK) + " })._v)"
    };
    errEq := if errK == ir.VALUE_KIND_UNIT {
        "true"
    } else if types.isUnionKind(errK) or types.isResultKind(errK) {
        self(target, errK, "(a as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e", "(b as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e", false)
    } else {
        "((a as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e === (b as { _r: 1; _e: " + types.tsFunctionType(errK) + " })._e)"
    };
    tsResEq := "((a: " + tsT + ", b: " + tsT + "): boolean => a._r === b._r && (a._r === 0 ? " + okEq + " : " + errEq + "))(" + leftCode + ", " + rightCode + ")";
    if negate { "(!" + tsResEq + ")" } else { tsResEq }
};

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
pub compareParsed := fn(target: String, source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed {
    if target == ir.TARGET_C and not (types.isUnionKind(left.kind) or types.isResultKind(left.kind) or types.isUnionKind(right.kind) or types.isResultKind(right.kind)) and (left.code.startsWithAt(0, "/*@CBLK:") or right.code.startsWithAt(0, "/*@CBLK:")) {
        cUnionTmpSeq = cUnionTmpSeq + 1;
        sid := cUnionTmpSeq.toText();
        lVar := "lt_cl_" + sid;
        rVar := "lt_cr_" + sid;
        resVar := "lt_cmp_" + sid;
        lSyn: Parsed = (kind = left.kind, code = lVar, intValue = left.intValue, textValue = left.textValue, constant = false, next = left.next);
        rSyn: Parsed = (kind = right.kind, code = rVar, intValue = right.intValue, textValue = right.textValue, constant = false, next = right.next);
        inner := self(target, source, at, operator, lSyn, rSyn, prefix);
        lInit := if left.code.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(lVar, left.kind, left.code) } else { lVar + " = " + left.code + ";" };
        rInit := if right.code.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(rVar, right.kind, right.code) } else { rVar + " = " + right.code + ";" };
        lDropFn := types.cDropFnForKind(left.kind);
        rDropFn := types.cDropFnForKind(right.kind);
        lDrop := if lDropFn =!= "" and (left.code.startsWithAt(0, "/*@CBLK:") or isCFreshOwnedExpr(left.code)) { " " + lDropFn + "(&" + lVar + ");" } else { "" };
        rDrop := if rDropFn =!= "" and (right.code.startsWithAt(0, "/*@CBLK:") or isCFreshOwnedExpr(right.code)) { " " + rDropFn + "(&" + rVar + ");" } else { "" };
        return boolParsed("/*@CBLK:" + resVar + "@*/bool " + resVar + "; { " + types.cValueType(left.kind) + " " + lVar + "; " + types.cValueType(right.kind) + " " + rVar + "; " + lInit + " " + rInit + " " + resVar + " = " + inner.code + ";" + lDrop + rDrop + " }", false, false, right.next);
    }
    if numeric.isSignedIntKind(left.kind) and numeric.isSignedIntKind(right.kind) {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            return boolParsed(ir.targetBoolLiteralCode(target, value), value, true, right.next);
        }
        return boolParsed(ir.targetComparisonCode(target, operator, ir.VALUE_KIND_INT, left.code, right.code), false, false, right.next);
    }
    if numeric.isUnsignedIntKind(left.kind) and numeric.isUnsignedIntKind(right.kind) {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            return boolParsed(ir.targetBoolLiteralCode(target, value), value, true, right.next);
        }
        return boolParsed(ir.targetComparisonCode(target, operator, ir.VALUE_KIND_UINT64,
        if target == ir.TARGET_C { "((uint64_t)(" + left.code + "))" } else { left.code },
        if target == ir.TARGET_C { "((uint64_t)(" + right.code + "))" } else { right.code }), false, false, right.next);
    }
    if (numeric.isIntKind(left.kind) and numeric.isIntKind(right.kind)) {
        syntax.failAt(source, at, prefix, "cannot mix signed and unsigned integers; use explicit cast");
    }
    if numeric.isNumericKind(left.kind) and numeric.isNumericKind(right.kind) {
        codes: List<String> = [left.code, right.code];
        kinds: List<String> = [left.kind, right.kind];
        operators: List<String> = [operator];
        return boolParsed(ir.targetComparisonChainCode(target, codes, kinds, operators, 1, at), false, false, right.next);
    }
    if left.kind =!= right.kind {
        if (types.isUnionKind(left.kind) or types.isResultKind(left.kind)) and types.isCompatibleKind(left.kind, right.kind) {
            if operator =!= "==" and operator =!= "=!=" {
                syntax.failAt(source, at, prefix, "operator " + operator + " requires Int operands");
            }
            if not isEqualityComparableKind(left.kind) {
                syntax.failAt(source, at, prefix, "cannot compare " + types.displayKind(left.kind) + " values containing non-comparable members");
            }
            promotedR := assignReadOnlyArgCode(target, left.kind, right.kind, right.code);
            return boolParsed(unionOrResultEqExpr(target, left.kind, left.code, promotedR, operator == "=!="), false, false, right.next);
        }
        if (types.isUnionKind(right.kind) or types.isResultKind(right.kind)) and types.isCompatibleKind(right.kind, left.kind) {
            if operator =!= "==" and operator =!= "=!=" {
                syntax.failAt(source, at, prefix, "operator " + operator + " requires Int operands");
            }
            if not isEqualityComparableKind(right.kind) {
                syntax.failAt(source, at, prefix, "cannot compare " + types.displayKind(right.kind) + " values containing non-comparable members");
            }
            promotedL := assignReadOnlyArgCode(target, right.kind, left.kind, left.code);
            return boolParsed(unionOrResultEqExpr(target, right.kind, promotedL, right.code, operator == "=!="), false, false, right.next);
        }
        syntax.failAt(source, at, prefix, "cannot compare " + types.displayKind(left.kind) + " and " + types.displayKind(right.kind));
    }
    if types.isDistinctKind(left.kind) {
        if operator =!= "==" and operator =!= "=!=" {
            syntax.failAt(source, at, prefix, "operator " + operator + " requires Int operands");
        }
        baseKind := types.distinctBaseKind(left.kind);
        if baseKind == ir.VALUE_KIND_NEVER { syntax.failAt(source, at, prefix, "cannot compare Never values"); }
        if types.isPayloadEnumKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare payload-bearing enum values; use match"); }
        if types.isTupleKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare tuple values"); }
        if types.isRecordKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare record values"); }
        if types.isListKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare list values"); }
        if types.isMapKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare map values"); }
        if types.isSetKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare set values"); }
        if types.isRcKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare Rc values"); }
        if types.isSoaKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare SoA values"); }
        if types.isFnKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare function values"); }
        if types.isDynKind(baseKind) { syntax.failAt(source, at, prefix, "cannot compare dyn interface values"); }
        if types.isSimdKind(baseKind) {
            cmpCode := if target == ir.TARGET_C {
                sTag := types.cSimdTag(baseKind);
                eqExpr := sTag + "_eq(" + left.code + ", " + right.code + ")";
                if operator == "=!=" { "(!" + eqExpr + ")" } else { eqExpr }
            } else {
                eqExpr := "lite$simdEq(" + left.code + ", " + right.code + ")";
                if operator == "=!=" { "(!" + eqExpr + ")" } else { eqExpr }
            };
            return boolParsed(cmpCode, false, false, right.next);
        }
        if numeric.isFloatKind(baseKind) {
            fCodes: List<String> = [left.code, right.code];
            fKinds: List<String> = [baseKind, baseKind];
            fOps: List<String> = [operator];
            return boolParsed(ir.targetComparisonChainCode(target, fCodes, fKinds, fOps, 1, at), false, false, right.next);
        }
        if left.constant and right.constant {
            value := if baseKind == ir.VALUE_KIND_STRING {
                compareTexts(operator, left.textValue, right.textValue)
            } else if numeric.isIntKind(baseKind) or types.isEnumKind(baseKind) {
                compareIntegers(operator, left.intValue, right.intValue)
            } else {
                compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
            };
            return boolParsed(ir.targetBoolLiteralCode(target, value), value, true, right.next);
        }
        cmpKind := if numeric.isIntKind(baseKind) or types.isEnumKind(baseKind) { ir.VALUE_KIND_INT } else { baseKind };
        return boolParsed(ir.targetComparisonCode(target, operator, cmpKind, left.code, right.code), false, false, right.next);
    }
    if left.kind == ir.VALUE_KIND_NEVER {
        syntax.failAt(source, at, prefix, "cannot compare Never values");
    }
    if types.isUnionKind(left.kind) or types.isResultKind(left.kind) {
        if operator =!= "==" and operator =!= "=!=" {
            syntax.failAt(source, at, prefix, "operator " + operator + " requires Int operands");
        }
        if not isEqualityComparableKind(left.kind) {
            syntax.failAt(source, at, prefix, "cannot compare " + types.displayKind(left.kind) + " values containing non-comparable members");
        }
        return boolParsed(unionOrResultEqExpr(target, left.kind, left.code, right.code, operator == "=!="), false, false, right.next);
    }
    if types.isPayloadEnumKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare payload-bearing enum values; use match");
    }
    if types.isTupleKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare tuple values");
    }
    if types.isRecordKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare record values");
    }
    if types.isListKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare list values");
    }
    if types.isMapKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare map values");
    }
    if types.isSetKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare set values");
    }
    if types.isRcKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare Rc values");
    }
    if types.isSoaKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare SoA values");
    }
    if types.isFnKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare function values");
    }
    if types.isDynKind(left.kind) {
        syntax.failAt(source, at, prefix, "cannot compare dyn interface values");
    }
    if operator =!= "==" and operator =!= "=!=" {
        syntax.failAt(source, at, prefix, "operator " + operator + " requires Int operands");
    }
    if types.isSimdKind(left.kind) {
        cmpCode := if target == ir.TARGET_C {
            sTag := types.cSimdTag(left.kind);
            eqExpr := sTag + "_eq(" + left.code + ", " + right.code + ")";
            if operator == "=!=" { "(!" + eqExpr + ")" } else { eqExpr }
        } else {
            eqExpr := "lite$simdEq(" + left.code + ", " + right.code + ")";
            if operator == "=!=" { "(!" + eqExpr + ")" } else { eqExpr }
        };
        return boolParsed(cmpCode, false, false, right.next);
    }
    if left.constant and right.constant {
        value := if left.kind == ir.VALUE_KIND_STRING {
            compareTexts(operator, left.textValue, right.textValue)
        } else if types.isEnumKind(left.kind) {
            compareIntegers(operator, left.intValue, right.intValue)
        } else {
            compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
        };
        return boolParsed(ir.targetBoolLiteralCode(target, value), value, true, right.next);
    }
    boolParsed(ir.targetComparisonCode(target, operator, left.kind, left.code, right.code), false, false, right.next)
};

/** True when C11 expression `code` already evaluates to a freshly created owned rvalue that needs no `_copy`. */
pub isCFreshOwnedExpr := fn(code: String): Bool {
    var c := code.trim();
    loop c.startsWithAt(0, "/*@T:") or c.startsWithAt(0, "/*@LTMP:") or c.startsWithAt(0, "/*@CSTK:") {
        endM := if c.startsWithAt(0, "/*@T:") { c.indexOf("@*/", 5) } else { c.indexOf("*/", 2) };
        if endM < 0 { break; }
        step := if c.startsWithAt(0, "/*@T:") { 3 } else { 2 };
        c = c.slice(endM + step, c.length()).trim();
    }
    if c.startsWithAt(0, "/*@CBLK:") { return true; }
    if not c.endsWith(")") { return false; }
    if c.startsWithAt(0, "((lt_or_") or
    c.startsWithAt(0, "((lt_s_") or c.startsWithAt(0, "((lt_arr_") or
    c.startsWithAt(0, "((lt_list_") or c.startsWithAt(0, "((lt_map_") or
    c.startsWithAt(0, "((lt_set_") or c.startsWithAt(0, "((lt_fnv_") or
    c.startsWithAt(0, "(lt_s_") or c.startsWithAt(0, "(lt_arr_") or
    c.startsWithAt(0, "(lt_list_") or c.startsWithAt(0, "(lt_map_") or
    c.startsWithAt(0, "(lt_set_") or c.startsWithAt(0, "(lt_fnv_") {
        return true;
    }
    if c.startsWithAt(0, "lt_fn_") or c.startsWithAt(0, "lt_fnv_") or
    c.startsWithAt(0, "lt_mk_") or c.startsWithAt(0, "lt_wrap_") or
    c.startsWithAt(0, "lt_list_") or c.startsWithAt(0, "lt_map_") or
    c.startsWithAt(0, "lt_set_") or c.startsWithAt(0, "lt_arr_") or
    c.startsWithAt(0, "lt_rc_") or c.startsWithAt(0, "(lt_rc_") or
    c.startsWithAt(0, "lt_s_") or c.startsWithAt(0, "lt_c_") {
        return true;
    }
    if c.startsWithAt(0, "lite$") {
        openP := c.indexOf("(", 0);
        dotP := c.indexOf(".", 0);
        if openP > 0 and (dotP < 0 or openP < dotP) {
            return true;
        }
    }
    false
};

/** Wraps target code in the backend's list-copy hook when `kind` is a List; `Never` and other kinds are unchanged. */
pub copiedValueCode := fn(target: String, kind: String, code: String): String {
    if types.isDistinctKind(kind) { return self(target, types.distinctBaseKind(kind), code); }
    if kind == ir.VALUE_KIND_NEVER or (target == ir.TARGET_C and (isCFreshOwnedExpr(code) or code.startsWithAt(0, "/*@CBLK:"))) { code }
    else if types.isArrayKind(kind) and target == ir.TARGET_C and types.cArrayTag(kind) =!= "" {
        if not types.cTypeNeedsDrop(kind) {
            code
        } else {
            aTag := types.cArrayTag(kind);
            if code.startsWithAt(0, aTag + "_copy(") or
            code.startsWithAt(0, aTag + "_move(") or
            code.startsWithAt(0, aTag + "_repeat(") or
            code.startsWithAt(0, "/*@T:") or
            code.startsWithAt(0, "((/*@T:" + kind + "@*/") or
            code.startsWithAt(0, "/*@CBLK:") {
                code
            } else {
                aTag + "_copy(" + code + ")"
            }
        }
    } else if types.isListKind(kind) or types.isArrayKind(kind) {
        if target == ir.TARGET_C {
            elKind := if types.isListKind(kind) { types.listElementKind(kind) } else { types.arrayElementKind(kind) };
            tag := types.cListTag(elKind);
            if tag =!= "" {
                if code.startsWithAt(0, "lt_list_" + tag + "_from(") or
                code.startsWithAt(0, "lt_list_" + tag + "_from_scope(") or
                code.startsWithAt(0, "lt_list_" + tag + "_repeat(") or
                code.startsWithAt(0, "/*@T:") or
                code.startsWithAt(0, "lt_list_" + tag + "_copy(") or
                code.startsWithAt(0, "lt_list_" + tag + "_move(") or
                code.startsWithAt(0, "lt_list_" + tag + "_slice(") or
                code.startsWithAt(0, "lt_list_" + tag + "_slice_from(") or
                code.startsWithAt(0, "lt_list_" + tag + "_reverse(") or
                code.startsWithAt(0, "lt_list_" + tag + "_pop_back(") or
                code.startsWithAt(0, "lt_list_" + tag + "_pop_front(") or
                code.startsWithAt(0, "lt_map_") or
                code.startsWithAt(0, "lt_set_") or
                (code.startsWithAt(0, "lt_arr_") and (code.indexOf("_slice(", 0) > 0 or code.indexOf("_slice_from(", 0) > 0)) or
                code.startsWithAt(0, "lite$inputArgs(") or
                code.startsWithAt(0, "lite$unicodeToCodePoints(") or
                code.startsWithAt(0, "lite$ioRead(") or
                code.startsWithAt(0, "lite$ioWriterBytes(") or
                code.startsWithAt(0, "lite$fileListDir(") or
                code.startsWithAt(0, "lite$cryptoRandomBytes(") or
                code.startsWithAt(0, "lt_c_utf8_encode(") or
                code.startsWithAt(0, "lt_c_io_read_all(") or
                code.startsWithAt(0, "/*@CBLK:") {
                    code
                } else {
                    "lt_list_" + tag + "_copy(" + code + ")"
                }
            } else {
                code
            }
        } else {
            elKind := if types.isListKind(kind) { types.listElementKind(kind) } else { types.arrayElementKind(kind) };
            if code == "[]" or code.startsWithAt(0, "[") {
                code
            } else if types.cTypeHasListField(elKind) {
                tsDeepCloneValueCode(kind, code)
            } else {
                ir.targetListCopyCode(target, code)
            }
        }
    }
    else if types.isMapKind(kind) {
        if target == ir.TARGET_C {
            mTag := types.cMapTag(kind);
            if mTag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, mTag + "_from(") and not code.startsWithAt(0, mTag + "_copy(") and not code.startsWithAt(0, mTag + "_move(") {
                mTag + "_copy(" + code + ")"
            } else {
                code
            }
        } else if target == ir.TARGET_TS and not code.startsWithAt(0, "new Map<") and not code.startsWithAt(0, "new Map(") {
            if types.cTypeHasListField(types.mapValueKind(kind)) {
                tsDeepCloneValueCode(kind, code)
            } else {
                "new Map(" + code + ")"
            }
        } else {
            code
        }
    }
    else if types.isSetKind(kind) {
        if target == ir.TARGET_C {
            sTag := types.cSetTag(kind);
            if sTag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, sTag + "_from(") and not code.startsWithAt(0, sTag + "_copy(") and not code.startsWithAt(0, sTag + "_move(") {
                sTag + "_copy(" + code + ")"
            } else {
                code
            }
        } else if target == ir.TARGET_TS and not code.startsWithAt(0, "new Set<") and not code.startsWithAt(0, "new Set(") {
            "new Set(" + code + ")"
        } else {
            code
        }
    }
    else if types.isRcKind(kind) {
        if target == ir.TARGET_C {
            rTag := types.cRcTag(kind);
            if rTag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, rTag + "_new(") and not code.startsWithAt(0, rTag + "_copy(") and not code.startsWithAt(0, rTag + "_move(") {
                rTag + "_copy(" + code + ")"
            } else {
                code
            }
        } else if target == ir.TARGET_TS and not code.startsWithAt(0, "lite$rcCreate(") and not code.startsWithAt(0, "lite$rcShare(") and not code.startsWithAt(0, "({ box: null }") and not code.startsWithAt(0, "/*@R*/") {
            "lite$rcShare(" + code + ")"
        } else {
            code
        }
    }
    else if types.isSoaKind(kind) {
        if target == ir.TARGET_C {
            sTag := types.cSoaTag(kind);
            if sTag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, sTag + "_with_cap(") and not code.startsWithAt(0, sTag + "_copy(") and not code.startsWithAt(0, sTag + "_move(") {
                sTag + "_copy(" + code + ")"
            } else {
                code
            }
        } else if target == ir.TARGET_TS and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, "{ ") {
            tsDeepCloneValueCode(kind, code)
        } else {
            code
        }
    }
    else if types.isSimdKind(kind) {
        if target == ir.TARGET_TS and not code.startsWithAt(0, "lite$simd") {
            "[" + "...(" + code + ")]"
        } else {
            code
        }
    }
    else if target == ir.TARGET_C and types.isFnKind(kind) {
        fTag := types.cFnTag(kind);
        if fTag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, "((/*@T:") and not code.startsWithAt(0, fTag + "_copy(") and not code.startsWithAt(0, fTag + "_move(") and not code.startsWithAt(0, "lt_mk_") {
            fTag + "_copy(" + code + ")"
        } else {
            code
        }
    }
    else if target == ir.TARGET_C and (types.isTupleKind(kind) or types.isRecordKind(kind) or types.isPayloadEnumKind(kind) or types.isUnionKind(kind) or types.isResultKind(kind)) and types.cTypeNeedsDrop(kind) {
        tag := types.cStructTag(kind);
        if tag =!= "" and not code.startsWithAt(0, "/*@T:") and not code.startsWithAt(0, tag + "_copy(") and not code.startsWithAt(0, tag + "_move(") {
            tag + "_copy(" + code + ")"
        } else {
            code
        }
    }
    else if target == ir.TARGET_TS and (types.isTupleKind(kind) or types.isRecordKind(kind) or types.isUnionKind(kind) or types.isResultKind(kind)) and types.cTypeHasListField(kind) {
        if not code.startsWithAt(0, "(((lite$rc:") and not code.startsWithAt(0, "{ ") and code =!= "{}" {
            tsDeepCloneValueCode(kind, code)
        } else {
            code
        }
    }
    else { code }
};

/** Clones mutable TS value containers recursively so repeated slots never alias. */
pub tsDeepCloneValueCode := fn(kind: String, expr: String): String {
    if types.isDistinctKind(kind) { return self(types.distinctBaseKind(kind), expr); }
    if types.isListKind(kind) or types.isArrayKind(kind) {
        elKind := if types.isListKind(kind) { types.listElementKind(kind) } else { types.arrayElementKind(kind) };
        elCloned := self(elKind, "lite$e");
        if elCloned =!= "lite$e" {
            return "((" + expr + ").map((lite$e: " + types.tsFunctionType(elKind) + ") => " + elCloned + "))";
        }
        return "[...(" + expr + ")]";
    }
    if types.isMapKind(kind) {
        keyKind := types.mapKeyKind(kind);
        valKind := types.mapValueKind(kind);
        valCloned := self(valKind, "lite$mv");
        if valCloned =!= "lite$mv" {
            return "new Map(Array.from(" + expr + ", ([lite$mk, lite$mv]: [" + types.tsFunctionType(keyKind) + ", " + types.tsFunctionType(valKind) + "]) => [lite$mk, " + valCloned + "]))";
        }
        return "new Map(" + expr + ")";
    }
    if types.isSetKind(kind) {
        return "new Set(" + expr + ")";
    }
    if types.isRcKind(kind) {
        return "lite$rcShare(" + expr + ")";
    }
    if types.isSimdKind(kind) {
        return "[...(" + expr + ")]";
    }
    if types.isSoaKind(kind) {
        recK := types.soaRecordKind(kind);
        fc := types.recordComponentCount(recK);
        mut colEntries: List<String> = [];
        var fi := 0;
        loop fi < fc {
            comp := types.recordComponent(recK, fi);
            fListCloned := self("List<" + comp.kind + ">", "(lite$soac." + comp.prop + ")");
            mut colEntries.pushBack(comp.prop + ": " + fListCloned);
            fi = fi + 1;
        }
        return "(((lite$soac: " + types.tsFunctionType(kind) + ") => ({ " + colEntries.join(", ") + " }))(" + expr + "))";
    }
    if types.isUnionKind(kind) {
        mems := types.unionMembers(kind);
        mut casesBuf: tb.TextBuilder;
        var hasClone := false;
        var ui := 0;
        loop ui < mems.length() {
            m := mems[ui];
            if m =!= ir.VALUE_KIND_UNIT {
                cloned := self(m, "lite$uv._v");
                if cloned =!= "lite$uv._v" {
                    hasClone = true;
                    mut casesBuf.append("case ");
                    mut casesBuf.append(ui.toText());
                    mut casesBuf.append(": return { _u: ");
                    mut casesBuf.append(ui.toText());
                    mut casesBuf.append(" as const, _v: ");
                    mut casesBuf.append(cloned);
                    mut casesBuf.append(" }; ");
                }
            }
            ui = ui + 1;
        }
        if not hasClone { return expr; }
        return "(((lite$uv: " + types.tsFunctionType(kind) + "): " + types.tsFunctionType(kind) + " => { switch (lite$uv._u) { " + casesBuf.build() + "default: return lite$uv; } })(" + expr + "))";
    }
    if types.isResultKind(kind) {
        okK := types.resultOkKind(kind);
        errK := types.resultErrKind(kind);
        okCloned := if okK == ir.VALUE_KIND_UNIT { "lite$rv._v" } else { self(okK, "lite$rv._v") };
        errCloned := if errK == ir.VALUE_KIND_UNIT { "lite$rv._e" } else { self(errK, "lite$rv._e") };
        if okCloned == "lite$rv._v" and errCloned == "lite$rv._e" { return expr; }
        okBranch := if okCloned == "lite$rv._v" { "lite$rv" } else { "{ _r: 0 as const, _v: " + okCloned + " }" };
        errBranch := if errCloned == "lite$rv._e" { "lite$rv" } else { "{ _r: 1 as const, _e: " + errCloned + " }" };
        return "(((lite$rv: " + types.tsFunctionType(kind) + "): " + types.tsFunctionType(kind) + " => (lite$rv._r === 0 ? " + okBranch + " : " + errBranch + "))(" + expr + "))";
    }
    if types.isRecordKind(kind) or types.isTupleKind(kind) {
        isRec := types.isRecordKind(kind);
        cnt := if isRec { types.recordComponentCount(kind) } else { types.tupleComponentCount(kind) };
        mut extraBuf: tb.TextBuilder;
        var idx := 0;
        loop idx < cnt {
            comp := if isRec { types.recordComponent(kind, idx) } else { types.tupleComponent(kind, idx) };
            fExpr := "lite$rc." + comp.prop;
            fCloned := self(comp.kind, fExpr);
            if fCloned =!= fExpr {
                mut extraBuf.append(", ");
                mut extraBuf.append(comp.prop);
                mut extraBuf.append(": ");
                mut extraBuf.append(fCloned);
            }
            idx = idx + 1;
        }
        if extraBuf.count() == 0 {
            return "({ ...(" + expr + ") })";
        }
        return "(((lite$rc: " + types.tsFunctionType(kind) + ") => ({ ...lite$rc" + extraBuf.build() + " }))(" + expr + "))";
    }
    expr
};

/** Converts single/narrower union or success/result values into `expectedKind`, preserving or copying ownership as requested by `copyOwned`. */
convertUnionOrResultCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String, copyOwned: Bool): String {
    if expectedKind == actualKind {
        return if copyOwned { copiedValueCode(target, expectedKind, actualCode) } else { actualCode };
    }
    if types.isUnionKind(expectedKind) {
        if not types.isUnionKind(actualKind) {
            idx := types.unionMemberIndex(expectedKind, actualKind);
            if idx < 0 { return actualCode; }
            if target == ir.TARGET_C {
                expTag := types.cStructTag(expectedKind);
                if actualKind == ir.VALUE_KIND_UNIT {
                    return if actualCode == "0" or actualCode == "/*@T:Unit@*/0" {
                        "/*@T:" + expectedKind + "@*/" + expTag + "_mk_" + idx.toText() + "()"
                    } else {
                        "/*@T:" + expectedKind + "@*/((void)(" + actualCode + "), " + expTag + "_mk_" + idx.toText() + "())"
                    };
                }
                vCode := if copyOwned { copiedValueCode(target, actualKind, actualCode) } else { actualCode };
                if vCode.startsWithAt(0, "/*@CBLK:") {
                    cUnionTmpSeq = cUnionTmpSeq + 1;
                    sid := cUnionTmpSeq.toText();
                    pVar := "lt_up_" + sid;
                    dVar := "lt_ud_" + sid;
                    return "/*@CBLK:" + dVar + "@*/" + expTag + " " + dVar + "; { " + types.cValueType(actualKind) + " " + pVar + "; " + cUnwrapIntoVar(pVar, actualKind, vCode) + " " + dVar + " = /*@T:" + expectedKind + "@*/" + expTag + "_mk_" + idx.toText() + "(" + pVar + "); }";
                }
                return "/*@T:" + expectedKind + "@*/" + expTag + "_mk_" + idx.toText() + "(" + vCode + ")";
            }
            tsT := types.tsFunctionType(expectedKind);
            if actualKind == ir.VALUE_KIND_UNIT {
                return "((() => { void (" + actualCode + "); return ({ _u: " + idx.toText() + " as const } as " + tsT + "); })())";
            }
            vCode := if copyOwned { copiedValueCode(target, actualKind, actualCode) } else { actualCode };
            return "({ _u: " + idx.toText() + " as const, _v: " + vCode + " } as " + tsT + ")";
        }
        actMems := types.unionMembers(actualKind);
        if target == ir.TARGET_C {
            expTag := types.cStructTag(expectedKind);
            actTag := types.cStructTag(actualKind);
            cUnionTmpSeq = cUnionTmpSeq + 1;
            sid := cUnionTmpSeq.toText();
            srcVar := "lt_uw_s_" + sid;
            dstVar := "lt_uw_d_" + sid;
            isFresh := isCFreshOwnedExpr(actualCode);
            mut swBuf: tb.TextBuilder;
            var ai := 0;
            loop ai < actMems.length() {
                am := actMems[ai];
                ti := types.unionMemberIndex(expectedKind, am);
                if ti >= 0 {
                    mut swBuf.append("case ");
                    mut swBuf.append(ai.toText());
                    mut swBuf.append(": ");
                    mut swBuf.append(dstVar);
                    mut swBuf.append(" = ");
                    mut swBuf.append(expTag);
                    mut swBuf.append("_mk_");
                    mut swBuf.append(ti.toText());
                    if am == ir.VALUE_KIND_UNIT {
                        mut swBuf.append("(); ");
                    } else {
                        fExpr := srcVar + ".u.m" + ai.toText();
                        argExpr := if copyOwned and not isFresh { copiedValueCode(target, am, fExpr) } else { fExpr };
                        mut swBuf.append("(");
                        mut swBuf.append(argExpr);
                        mut swBuf.append("); ");
                    }
                    mut swBuf.append("break; ");
                }
                ai = ai + 1;
            }
            srcUnwrap := if actualCode.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(srcVar, actualKind, actualCode) } else { srcVar + " = " + actualCode + ";" };
            return "/*@CBLK:" + dstVar + "@*/" + expTag + " " + dstVar + "; { " + actTag + " " + srcVar + "; " + srcUnwrap + " switch (" + srcVar + ".tag) { " + swBuf.build() + "default: " + dstVar + " = (" + expTag + "){ .tag = -1, .u = { ._empty = 0 } }; break; } }";
        }
        tsAct := types.tsFunctionType(actualKind);
        tsExp := types.tsFunctionType(expectedKind);
        mut casesBuf: tb.TextBuilder;
        var ai := 0;
        loop ai < actMems.length() {
            am := actMems[ai];
            ti := types.unionMemberIndex(expectedKind, am);
            if ti >= 0 {
                mut casesBuf.append("case ");
                mut casesBuf.append(ai.toText());
                mut casesBuf.append(": return { _u: ");
                mut casesBuf.append(ti.toText());
                if am == ir.VALUE_KIND_UNIT {
                    mut casesBuf.append(" as const }; ");
                } else {
                    rawV := "(lite$uw as { _u: " + ai.toText() + "; _v: " + types.tsFunctionType(am) + " })._v";
                    vCode := if copyOwned { copiedValueCode(target, am, rawV) } else { rawV };
                    mut casesBuf.append(" as const, _v: ");
                    mut casesBuf.append(vCode);
                    mut casesBuf.append(" }; ");
                }
            }
            ai = ai + 1;
        }
        return "((lite$uw: " + tsAct + "): " + tsExp + " => { switch (lite$uw._u) { " + casesBuf.build() + "default: return lite$uw as unknown as " + tsExp + "; } })(" + actualCode + ")";
    }
    if types.isResultKind(expectedKind) {
        okExp := types.resultOkKind(expectedKind);
        errExp := types.resultErrKind(expectedKind);
        if not types.isResultKind(actualKind) {
            if target == ir.TARGET_C {
                expTag := types.cStructTag(expectedKind);
                if okExp == ir.VALUE_KIND_UNIT {
                    return if actualCode == "0" or actualCode == "/*@T:Unit@*/0" {
                        "/*@T:" + expectedKind + "@*/" + expTag + "_ok()"
                    } else {
                        "/*@T:" + expectedKind + "@*/((void)(" + actualCode + "), " + expTag + "_ok())"
                    };
                }
                vCode := if copyOwned { convertValueWithCopy(target, okExp, actualKind, actualCode, true) } else { convertValueWithCopy(target, okExp, actualKind, actualCode, false) };
                if vCode.startsWithAt(0, "/*@CBLK:") {
                    cUnionTmpSeq = cUnionTmpSeq + 1;
                    sid := cUnionTmpSeq.toText();
                    pVar := "lt_rp_" + sid;
                    dVar := "lt_rd_" + sid;
                    return "/*@CBLK:" + dVar + "@*/" + expTag + " " + dVar + "; { " + types.cValueType(okExp) + " " + pVar + "; " + cUnwrapIntoVar(pVar, okExp, vCode) + " " + dVar + " = /*@T:" + expectedKind + "@*/" + expTag + "_ok(" + pVar + "); }";
                }
                return "/*@T:" + expectedKind + "@*/" + expTag + "_ok(" + vCode + ")";
            }
            tsExp := types.tsFunctionType(expectedKind);
            if okExp == ir.VALUE_KIND_UNIT {
                return "((() => { void (" + actualCode + "); return ({ _r: 0 as const } as " + tsExp + "); })())";
            }
            vCode := convertValueWithCopy(target, okExp, actualKind, actualCode, copyOwned);
            return "({ _r: 0 as const, _v: " + vCode + " } as " + tsExp + ")";
        }
        okAct := types.resultOkKind(actualKind);
        errAct := types.resultErrKind(actualKind);
        if target == ir.TARGET_C {
            expTag := types.cStructTag(expectedKind);
            actTag := types.cStructTag(actualKind);
            cUnionTmpSeq = cUnionTmpSeq + 1;
            sid := cUnionTmpSeq.toText();
            srcVar := "lt_rw_s_" + sid;
            dstVar := "lt_rw_d_" + sid;
            isFresh := isCFreshOwnedExpr(actualCode);
            okArg := if okExp == ir.VALUE_KIND_UNIT { "" } else {
                rawOk := if copyOwned and not isFresh and types.cCopyFnForKind(okAct) =!= "" and okAct == okExp {
                    types.cCopyFnForKind(okAct) + "(" + srcVar + ".u.ok)"
                } else {
                    convExpr := convertValueWithCopy(target, okExp, okAct, srcVar + ".u.ok", copyOwned and not isFresh);
                    convExpr
                };
                rawOk
            };
            errArg := if errExp == ir.VALUE_KIND_UNIT { "" } else {
                convertValueWithCopy(target, errExp, errAct, srcVar + ".u.err", copyOwned and not isFresh)
            };
            okAssign := if okArg.startsWithAt(0, "/*@CBLK:") {
                okTmp := "lt_rw_ov_" + sid;
                "{ " + types.cValueType(okExp) + " " + okTmp + "; " + cUnwrapIntoVar(okTmp, okExp, okArg) + " " + dstVar + " = " + expTag + "_ok(" + okTmp + "); }"
            } else if okExp == ir.VALUE_KIND_UNIT {
                dstVar + " = " + expTag + "_ok();"
            } else {
                dstVar + " = " + expTag + "_ok(" + okArg + ");"
            };
            errAssign := if errArg.startsWithAt(0, "/*@CBLK:") {
                errTmp := "lt_rw_ev_" + sid;
                "{ " + types.cValueType(errExp) + " " + errTmp + "; " + cUnwrapIntoVar(errTmp, errExp, errArg) + " " + dstVar + " = " + expTag + "_err(" + errTmp + "); }"
            } else if errExp == ir.VALUE_KIND_UNIT {
                dstVar + " = " + expTag + "_err();"
            } else {
                dstVar + " = " + expTag + "_err(" + errArg + ");"
            };
            srcResUnwrap := if actualCode.startsWithAt(0, "/*@CBLK:") { cUnwrapIntoVar(srcVar, actualKind, actualCode) } else { srcVar + " = " + actualCode + ";" };
            return "/*@CBLK:" + dstVar + "@*/" + expTag + " " + dstVar + "; { " + actTag + " " + srcVar + "; " + srcResUnwrap + " if (" + srcVar + ".tag == 0) { " + okAssign + " } else if (" + srcVar + ".tag == 1) { " + errAssign + " } else { " + dstVar + " = (" + expTag + "){ .tag = -1, .u = { ._empty = 0 } }; } }";
        }
        tsAct := types.tsFunctionType(actualKind);
        tsExp := types.tsFunctionType(expectedKind);
        okConv := if okExp == ir.VALUE_KIND_UNIT { "{ _r: 0 as const }" } else { "{ _r: 0 as const, _v: " + convertValueWithCopy(target, okExp, okAct, "(lite$rw as { _r: 0; _v: " + types.tsFunctionType(okAct) + " })._v", copyOwned) + " }" };
        errConv := if errExp == ir.VALUE_KIND_UNIT { "{ _r: 1 as const }" } else { "{ _r: 1 as const, _e: " + convertValueWithCopy(target, errExp, errAct, "(lite$rw as { _r: 1; _e: " + types.tsFunctionType(errAct) + " })._e", copyOwned) + " }" };
        return "((lite$rw: " + tsAct + "): " + tsExp + " => (lite$rw._r === 0 ? " + okConv + " : " + errConv + "))(" + actualCode + ")";
    }
    actualCode
};

/** Narrows a wider union value (`srcUnionKind`) to a narrower sub-union (`dstUnionKind`), copying owned payloads when needed. */
pub convertUnionNarrowCode := fn(target: String, dstUnionKind: String, srcUnionKind: String, srcCode: String): String {
    convertUnionOrResultCode(target, dstUnionKind, srcUnionKind, srcCode, true)
};

/** Shared scalar/tuple/union/result conversion helper parameterized by ownership copy (`copyOwned`). */
convertValueWithCopy := fn(target: String, expectedKind: String, actualKind: String, actualCode: String, copyOwned: Bool): String {
    if actualKind == ir.VALUE_KIND_NEVER {
        actualCode
    } else if types.isUnionKind(expectedKind) or types.isResultKind(expectedKind) {
        convertUnionOrResultCode(target, expectedKind, actualKind, actualCode, copyOwned)
    } else if expectedKind == ir.VALUE_KIND_FLOAT8 and actualKind =!= ir.VALUE_KIND_FLOAT8 and numeric.isNumericKind(actualKind) {
        ir.targetFloat8OperandCode(target, actualKind, actualCode)
    } else if expectedKind == ir.VALUE_KIND_FLOAT16 and actualKind =!= ir.VALUE_KIND_FLOAT16 and numeric.isNumericKind(actualKind) {
        ir.targetFloat16OperandCode(target, actualKind, actualCode)
    } else if expectedKind == ir.VALUE_KIND_FLOAT32 and (numeric.isIntKind(actualKind) or actualKind == ir.VALUE_KIND_FLOAT8 or actualKind == ir.VALUE_KIND_FLOAT16) {
        ir.targetFloat32OperandCode(target, actualKind, actualCode)
    } else if expectedKind == ir.VALUE_KIND_FLOAT and (numeric.isIntKind(actualKind) or actualKind == ir.VALUE_KIND_FLOAT8 or actualKind == ir.VALUE_KIND_FLOAT16 or actualKind == ir.VALUE_KIND_FLOAT32) {
        ir.targetFloatOperandCode(target, actualKind, actualCode)
    } else if expectedKind =!= actualKind and numeric.isIntKind(expectedKind) and numeric.isIntKind(actualKind) and target == ir.TARGET_C {
        "((" + types.cValueType(expectedKind) + ")(" + actualCode + "))"
    } else if expectedKind =!= actualKind and types.tupleShapeMatches(expectedKind, actualKind) {
        types.convertTupleValueForTarget(target, expectedKind, actualKind, actualCode)
    } else if copyOwned {
        copiedValueCode(target, expectedKind, actualCode)
    } else {
        actualCode
    }
};

/** Converts compatible tuples, unions, results, or widening numeric values on assignment/call/return, copying owned values when needed. */
pub assignValueCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    convertValueWithCopy(target, expectedKind, actualKind, actualCode, true)
};

/** Converts read-only call arguments without cloning (zero-copy immutable reference on both TS and C11; performs only scalar widening, tuple layout, union/result wrapping). */
pub assignReadOnlyArgCode := fn(target: String, expectedKind: String, actualKind: String, actualCode: String): String {
    convertValueWithCopy(target, expectedKind, actualKind, actualCode, false)
};

/** Converts read-only call arguments, emitting a snapshot (C11 CoW refcount bump or TS copy) only when `needsSnapshot` is true. */
pub readOnlyArgWithSnapshot := fn(target: String, expectedKind: String, actualKind: String, actualCode: String, needsSnapshot: Bool): String {
    if needsSnapshot {
        assignValueCode(target, expectedKind, actualKind, actualCode)
    } else {
        assignReadOnlyArgCode(target, expectedKind, actualKind, actualCode)
    }
};

/** Rejects declarations inferred as non-storable `Unit` or `Never`. */
pub rejectNonValueBinding := fn(source: String, at: Int, prefix: String, kind: String, name: String): Unit {
    if kind == ir.VALUE_KIND_UNIT or kind == ir.VALUE_KIND_NEVER {
        syntax.failAt(source, at, prefix, "cannot declare a " + types.displayKind(kind) + " local " + name);
    }
};

/** Chooses the emitted statement item kind, ensuring diverging items terminate non-Unit functions/main for strict TS control flow. */
pub expressionStatementKind := fn(valueKind: String, returned: Bool, defaultKind: String, currentResult: String): String {
    if valueKind == ir.VALUE_KIND_NEVER {
        if currentResult =!= ir.VALUE_KIND_UNIT { ir.ITEM_KIND_RETURN } else { ir.ITEM_KIND_CALL }
    } else if returned {
        ir.ITEM_KIND_RETURN
    } else {
        defaultKind
    }
};

/** Closes a call after at least one parsed argument, consuming at most one trailing comma and its trivia. */
pub expectNonemptyCallClose := fn(source: String, position: Int, prefix: String): Int {
    var cursor := syntax.skipTrivia(source, position, prefix);
    if cursor < source.length() and source.at(cursor) == "," { cursor = syntax.skipTrivia(source, cursor + 1, prefix); }
    syntax.expectSymbol(source, cursor, ")", prefix)
};

/** Parses the `mut name` grant after one map mutation opener, rejecting a missing grant, a non-map target and a binding without writable held data. */
pub parseMapGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := syntax.skipTrivia(source, open + 1, prefix);
    if not source.wordAt(cursor, "mut") {
        syntax.failAt(source, cursor, prefix, operation + " requires mut map argument");
    }
    nameStart := syntax.skipTrivia(source, cursor + 3, prefix);
    if nameStart >= source.length() or not source.at(nameStart).isNameStart() {
        syntax.failAt(source, nameStart, prefix, "expected map name after mut");
    }
    nameEnd := source.skipName(nameStart);
    mapName := source.slice(nameStart, nameEnd);
    index := sym.localIndex(locals, mapName);
    if index < 0 {
        syntax.failAt(source, cursor, prefix, "unknown value " + mapName);
    }
    entry := locals[index];
    if entry.initState =!= ir.INIT_STATE_INIT {
        syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + mapName);
    }
    if not types.isMapKind(entry.kind) {
        syntax.failAt(source, cursor, prefix, operation + " requires a Map<K, V> argument");
    }
    if not entry.writable {
        syntax.failAt(source, cursor, prefix, "cannot mutate immutable map " + mapName);
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
};

/** Parses the `mut name` grant after a `core/set` mutating call opener. */
pub parseSetGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    cursor := syntax.skipTrivia(source, open + 1, prefix);
    if not source.wordAt(cursor, "mut") {
        syntax.failAt(source, cursor, prefix, operation + " requires mut set argument");
    }
    nameStart := syntax.skipTrivia(source, cursor + 3, prefix);
    if nameStart >= source.length() or not source.at(nameStart).isNameStart() {
        syntax.failAt(source, nameStart, prefix, "expected set name after mut");
    }
    nameEnd := source.skipName(nameStart);
    setName := source.slice(nameStart, nameEnd);
    index := sym.localIndex(locals, setName);
    if index < 0 {
        syntax.failAt(source, cursor, prefix, "unknown value " + setName);
    }
    entry := locals[index];
    if entry.initState =!= ir.INIT_STATE_INIT {
        syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + setName);
    }
    if not types.isSetKind(entry.kind) {
        syntax.failAt(source, cursor, prefix, operation + " requires a Set<T> argument");
    }
    if not entry.writable {
        syntax.failAt(source, cursor, prefix, "cannot mutate immutable set " + setName);
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
};

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
pub parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := syntax.skipTrivia(source, open + 1, prefix);
    if not source.wordAt(cursor, "mut") {
        syntax.failAt(source, cursor, prefix, operation + " requires mut list argument");
    }
    cursor = syntax.skipTrivia(source, cursor + 3, prefix);
    if cursor >= source.length() or not source.at(cursor).isNameStart() {
        syntax.failAt(source, cursor, prefix, "expected a list name after mut");
    }
    nameEnd := source.skipName(cursor);
    listName := source.slice(cursor, nameEnd);
    index := sym.localIndex(locals, listName);
    if index < 0 {
        syntax.failAt(source, cursor, prefix, "unknown value " + listName);
        return (runtime = "", kind = "", next = nameEnd);
    }
    entry := locals[index];
    if not types.isListKind(entry.kind) {
        syntax.failAt(source, cursor, prefix, operation + " requires a List value, got " + types.displayKind(entry.kind));
    }
    if not entry.writable {
        syntax.failAt(source, cursor, prefix, "cannot mutate list " + listName + " without mut");
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
};

/** Lowers a compound assignment RHS computation for Int*, Float*, or String (`+=`). */
pub compoundAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entryKind: String, lhsCode: String, baseOp: String, rhs: Parsed): String {
    if numeric.isIntKind(entryKind) and numeric.isIntKind(rhs.kind) and numeric.numericWidens(entryKind, rhs.kind) {
        return runtimeTypedIntegerCode(target, entryKind, baseOp, lhsCode, rhs.code, opPos);
    }
    if entryKind == ir.VALUE_KIND_STRING and rhs.kind == ir.VALUE_KIND_STRING and baseOp == "+" {
        return ir.targetConcatCode(target, lhsCode, rhs.code);
    }
    if entryKind == ir.VALUE_KIND_FLOAT8 and (numeric.isIntKind(rhs.kind) or rhs.kind == ir.VALUE_KIND_FLOAT8) and
    numeric.numericWidens(entryKind, rhs.kind) and (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return ir.targetFloat8BinaryCode(target, baseOp, ir.targetFloatOperandCode(target, entryKind, lhsCode), ir.targetFloatOperandCode(target, rhs.kind, rhs.code), opPos);
    }
    if entryKind == ir.VALUE_KIND_FLOAT16 and (numeric.isIntKind(rhs.kind) or rhs.kind == ir.VALUE_KIND_FLOAT8 or rhs.kind == ir.VALUE_KIND_FLOAT16) and
    numeric.numericWidens(entryKind, rhs.kind) and (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return ir.targetFloat16BinaryCode(target, baseOp, ir.targetFloatOperandCode(target, entryKind, lhsCode), ir.targetFloatOperandCode(target, rhs.kind, rhs.code), opPos);
    }
    if entryKind == ir.VALUE_KIND_FLOAT32 and (numeric.isIntKind(rhs.kind) or rhs.kind == ir.VALUE_KIND_FLOAT8 or rhs.kind == ir.VALUE_KIND_FLOAT16 or rhs.kind == ir.VALUE_KIND_FLOAT32) and
    numeric.numericWidens(entryKind, rhs.kind) and (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return ir.targetFloat32BinaryCode(target, baseOp, ir.targetFloat32OperandCode(target, entryKind, lhsCode), ir.targetFloat32OperandCode(target, rhs.kind, rhs.code), opPos);
    }
    if entryKind == ir.VALUE_KIND_FLOAT and numeric.isNumericKind(rhs.kind) and
    (baseOp == "+" or baseOp == "-" or baseOp == "*" or baseOp == "/") {
        return ir.targetFloatBinaryCode(target, baseOp, lhsCode, ir.targetFloatOperandCode(target, rhs.kind, rhs.code), opPos);
    }
    syntax.failAt(source, opPos, prefix, "cannot apply " + baseOp + "= to " + types.displayKind(entryKind) + " and " + types.displayKind(rhs.kind));
    ""
};

/** Counts entries in `locals`. */
pub localsCount := fn(locals: List<Local>): Int {
    locals.length()
};

/** Returns the prefix of `locals` up to `targetLen` entries. */
pub truncateLocals := fn(locals: List<Local>, targetLen: Int): List<Local> {
    if targetLen >= locals.length() { return locals; }
    sym.rewindLocalsTo(targetLen);
    if targetLen <= 0 { return []; }
    locals.slice(0, targetLen)
};

/** Extracts partial-conditional initState tagged onto `textValue` (`"$pinit:<state>"`), or `INIT_STATE_INIT`. */
pub extractPartialInitState := fn(textValue: String): String {
    if textValue.startsWithAt(0, "$pinit:") {
        return textValue.slice(7, textValue.length());
    }
    ir.INIT_STATE_INIT
};

/** Strips `"$pinit:<state>"` metadata from `textValue`, returning ordinary borrow metadata unchanged. */
pub stripPartialInitTag := fn(textValue: String): String {
    if textValue.startsWithAt(0, "$pinit:") { return ""; }
    textValue
};

/** Computes updated `initState` after a partial assignment with metadata `metaText`. */
pub computePartialAssignNextInitState := fn(entry: Local, metaText: String): String {
    if metaText == "$noop" { return entry.initState; }
    if metaText.startsWithAt(0, "$pred_t:") {
        prt := metaText.slice(8, metaText.length());
        fState := narrowInitStateForPred(entry.initState, prt, false);
        return joinPredStates(prt, entry.initState, ir.INIT_STATE_INIT, true, fState, true);
    }
    if metaText.startsWithAt(0, "$pred_f:") {
        prt := metaText.slice(8, metaText.length());
        tState := narrowInitStateForPred(entry.initState, prt, true);
        return joinPredStates(prt, entry.initState, tState, true, ir.INIT_STATE_INIT, true);
    }
    if entry.initState == ir.INIT_STATE_INIT {
        ir.INIT_STATE_INIT
    } else if entry.mutable and entry.initState == ir.INIT_STATE_UNINIT_ASSIGNED {
        ir.INIT_STATE_UNINIT_ASSIGNED
    } else {
        ir.INIT_STATE_MAYBE
    }
};

/** True when an immutable binding in `entry.initState` is definitely uninitialized on every written branch of `metaText`. */
pub partialAssignAllowedForImmutable := fn(entry: Local, metaText: String): Bool {
    if entry.mutable { return true; }
    if ir.isInitStateUninit(entry.initState) { return true; }
    if entry.initState == ir.INIT_STATE_INIT { return false; }
    if metaText == "$noop" { return true; }
    if entry.initState.startsWithAt(0, ir.INIT_STATE_COND_T_PREFIX) and metaText.startsWithAt(0, "$pred_f:") {
        return entry.initState.slice(ir.INIT_STATE_COND_T_PREFIX.length(), entry.initState.length()) == metaText.slice(8, metaText.length());
    }
    if entry.initState.startsWithAt(0, ir.INIT_STATE_COND_F_PREFIX) and metaText.startsWithAt(0, "$pred_t:") {
        return entry.initState.slice(ir.INIT_STATE_COND_F_PREFIX.length(), entry.initState.length()) == metaText.slice(8, metaText.length());
    }
    false
};

/** Narrows `initState` when immutable Bool predicate `predRt` is known to hold (`predVal = true`) or not hold (`predVal = false`). */
pub narrowInitStateForPred := fn(initState: String, predRt: String, predVal: Bool): String {
    if predRt == "" { return initState; }
    if initState == ir.INIT_STATE_COND_T_PREFIX + predRt {
        return if predVal { ir.INIT_STATE_INIT } else { ir.INIT_STATE_UNINIT };
    }
    if initState == ir.INIT_STATE_COND_F_PREFIX + predRt {
        return if predVal { ir.INIT_STATE_UNINIT } else { ir.INIT_STATE_INIT };
    }
    initState
};

/** Appends narrowed `Local` entries for any reached bindings whose `initState` correlates with `(predRt, predVal)`. */
pub narrowLocalsForPredicate := fn(locals: List<Local>, predRt: String, predVal: Bool): List<Local> {
    if predRt == "" { return locals; }
    mut latestIdx: Map<String, Int>;
    var i := 0;
    loop locals as l {
        if l.depth >= 0 and l.runtime =!= "" {
            mut latestIdx.set(l.runtime, i);
        }
        i = i + 1;
    }
    mut out: List<Local> = locals;
    var j := 0;
    loop locals as l {
        if l.depth >= 0 and l.runtime =!= "" and latestIdx.getOr(l.runtime, -1) == j {
            narrowed := narrowInitStateForPred(l.initState, predRt, predVal);
            if narrowed =!= l.initState {
                mut out.pushBack((name = l.name, runtime = l.runtime, kind = l.kind,
                mutable = l.mutable, writable = l.writable, depth = l.depth, constant = l.constant,
                code = l.code, intValue = l.intValue, textValue = l.textValue, initState = narrowed));
            }
        }
        j = j + 1;
    }
    out
};

/** Joins true-path and false-path initialization states for an optional immutable Bool predicate `predRt`. */
pub joinPredStates := fn(predRt: String, preState: String, trueState: String, trueLive: Bool, falseState: String, falseLive: Bool): String {
    if not trueLive and not falseLive { return ir.INIT_STATE_INIT; }
    if trueLive and not falseLive { return trueState; }
    if falseLive and not trueLive { return falseState; }
    if trueState == ir.INIT_STATE_INIT and falseState == ir.INIT_STATE_INIT { return ir.INIT_STATE_INIT; }
    if ir.isInitStateUninit(trueState) and ir.isInitStateUninit(falseState) {
        return if ir.isInitStateUninit(preState) { preState } else { ir.INIT_STATE_UNINIT };
    }
    if predRt =!= "" and trueState == ir.INIT_STATE_INIT and ir.isInitStateUninit(falseState) {
        return ir.INIT_STATE_COND_T_PREFIX + predRt;
    }
    if predRt =!= "" and ir.isInitStateUninit(trueState) and falseState == ir.INIT_STATE_INIT {
        return ir.INIT_STATE_COND_F_PREFIX + predRt;
    }
    if trueState == falseState { return trueState; }
    ir.INIT_STATE_MAYBE
};

/** Returns outer-local initialization and callable-dependency updates from `locals[preLen..)` appended to `updates` for `(branchDepth, armIdx)`. */
pub recordBranchUpdatesForArm := fn(locals: List<Local>, preLen: Int, maxDepth: Int, branchDepth: Int, armIdx: Int, updates: List<BranchUpdate>): List<BranchUpdate> {
    mut nextUpdates: List<BranchUpdate> = updates;
    var idx := 0;
    mut branchRuntimes: List<String> = [];
    mut branchStates: List<String> = [];
    mut branchCodes: List<String> = [];
    loop locals as local {
        if idx >= preLen and local.depth >= 0 and local.depth <= maxDepth {
            mut branchRuntimes.pushBack(local.runtime);
            mut branchStates.pushBack(local.initState);
            mut branchCodes.pushBack(local.code);
        }
        idx = idx + 1;
    }
    mut emitted: List<String> = [];
    var rev := 0;
    loop branchRuntimes { rev += 1; }
    loop rev > 0 {
        rev = rev - 1;
        rt := branchRuntimes[rev];
        if not emitted.contains(rt) {
            mut emitted.pushBack(rt);
            mut nextUpdates.pushBack((depth = branchDepth, arm = armIdx, runtime = rt, initState = branchStates[rev], code = branchCodes[rev]));
        }
    }
    nextUpdates
};

/** Returns outer-local initialization and callable-dependency updates from `locals[preLen..)` appended to `updates` for `branchDepth`. */
pub recordBranchUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int, branchDepth: Int, updates: List<BranchUpdate>): List<BranchUpdate> {
    recordBranchUpdatesForArm(locals, preLen, maxDepth, branchDepth, 0, updates)
};

/** Joins `branchUpdates` for `blockDepth` into `locals`, preserving immutable Bool predicate correlations where sound. */
pub joinBranchLocalsWithPred := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>, predRt: String, predNegated: Bool, condCount: Int, b1Live: Bool, b2Live: Bool): List<Local> {
    mut here: List<BranchUpdate> = [];
    loop updates as u {
        if u.depth == blockDepth { mut here.pushBack(u); }
    }
    mut nextLocals: List<Local> = locals;
    if hasElse and liveBranchCount == 0 { return nextLocals; }
    mut seenRuntimes: List<String> = [];
    loop here as u {
        if not seenRuntimes.contains(u.runtime) {
            mut seenRuntimes.pushBack(u.runtime);
        }
    }
    isPredSplit := condCount == 1 and predRt =!= "";
    if isPredSplit {
        predT := ir.INIT_STATE_COND_T_PREFIX + predRt;
        predF := ir.INIT_STATE_COND_F_PREFIX + predRt;
        mut latestPre: Map<String, String>;
        var pi := 0;
        loop locals as pl {
            if pi < preLen and pl.depth >= 0 and pl.runtime =!= "" {
                mut latestPre.set(pl.runtime, pl.initState);
            }
            pi = pi + 1;
        }
        var pj := 0;
        loop locals as pl {
            if pj < preLen and pl.depth >= 0 and pl.runtime =!= "" {
                st := latestPre.getOr(pl.runtime, "");
                if (st == predT or st == predF) and not seenRuntimes.contains(pl.runtime) {
                    mut seenRuntimes.pushBack(pl.runtime);
                }
            }
            pj = pj + 1;
        }
    }
    loop seenRuntimes as rt {
        var preEntryIdx := -1;
        var i := 0;
        loop locals as l {
            if i < preLen and l.runtime == rt { preEntryIdx = i; }
            i = i + 1;
        }
        if preEntryIdx >= 0 {
            pre := locals[preEntryIdx];
            trackFn := types.containsFnKind(pre.kind) or pre.name == "$tuple";
            var mergedCode := if trackFn { pre.code } else { "" };
            if trackFn {
                loop here as u {
                    if u.runtime == rt and u.code =!= "" {
                        mergedCode = trace.mergeCallableLocalDeps(mergedCode, u.code);
                    }
                }
            }
            var joined := pre.initState;
            if pre.initState =!= ir.INIT_STATE_INIT {
                if isPredSplit {
                    var b1State := narrowInitStateForPred(pre.initState, predRt, not predNegated);
                    var b2State := narrowInitStateForPred(pre.initState, predRt, predNegated);
                    loop here as u {
                        if u.runtime == rt and u.arm == 1 { b1State = u.initState; }
                        else if u.runtime == rt and u.arm == 2 { b2State = u.initState; }
                    }
                    effB2Live := if hasElse { b2Live } else { true };
                    tState := if predNegated { b2State } else { b1State };
                    tLive := if predNegated { effB2Live } else { b1Live };
                    fState := if predNegated { b1State } else { b2State };
                    fLive := if predNegated { b1Live } else { effB2Live };
                    joined = joinPredStates(predRt, pre.initState, tState, tLive, fState, fLive);
                    if pre.mutable and pre.initState == ir.INIT_STATE_UNINIT_ASSIGNED and joined == ir.INIT_STATE_MAYBE {
                        joined = ir.INIT_STATE_UNINIT_ASSIGNED;
                    }
                } else {
                    joined = ir.INIT_STATE_MAYBE;
                    if hasElse {
                        var initCount := 0;
                        loop here as u {
                            if u.runtime == rt and u.initState == ir.INIT_STATE_INIT { initCount = initCount + 1; }
                        }
                        if initCount == liveBranchCount { joined = ir.INIT_STATE_INIT; }
                    }
                    if pre.mutable and pre.initState == ir.INIT_STATE_UNINIT_ASSIGNED and joined == ir.INIT_STATE_MAYBE {
                        joined = ir.INIT_STATE_UNINIT_ASSIGNED;
                    }
                }
            }
            if joined =!= pre.initState or (trackFn and mergedCode =!= pre.code) {
                mut nextLocals.pushBack((name = pre.name, runtime = pre.runtime, kind = pre.kind,
                mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                code = if trackFn { mergedCode } else { pre.code }, intValue = 0, textValue = "", initState = joined));
            }
        }
    }
    nextLocals
};

/** Joins `branchUpdates` for `blockDepth` into `locals`, returning updated `locals`. */
pub joinBranchLocals := fn(locals: List<Local>, preLen: Int, blockDepth: Int, hasElse: Bool, liveBranchCount: Int, updates: List<BranchUpdate>): List<Local> {
    joinBranchLocalsWithPred(locals, preLen, blockDepth, hasElse, liveBranchCount, updates, "", false, 0, false, false)
};

/** Removes `branchUpdates` entries at `blockDepth`. */
pub popBranchUpdates := fn(updates: List<BranchUpdate>, blockDepth: Int): List<BranchUpdate> {
    mut kept: List<BranchUpdate> = [];
    loop updates as u {
        if u.depth =!= blockDepth { mut kept.pushBack(u); }
    }
    kept
};

/** Transitions any outer uninit locals modified inside a loop and propagates callable-dependency updates after the loop. */
pub joinLoopUpdates := fn(locals: List<Local>, preLen: Int, maxDepth: Int): List<Local> {
    mut updatedRuntimes: List<String> = [];
    var idx := 0;
    loop locals as l {
        if idx >= preLen and l.depth >= 0 and l.depth <= maxDepth {
            if not updatedRuntimes.contains(l.runtime) {
                mut updatedRuntimes.pushBack(l.runtime);
            }
        }
        idx = idx + 1;
    }
    if updatedRuntimes.length() == 0 { return truncateLocals(locals, preLen); }
    mut nextLocals: List<Local> = truncateLocals(locals, preLen);
    loop updatedRuntimes as rt {
        var preIdx := -1;
        var i := 0;
        loop nextLocals as l {
            if l.runtime == rt { preIdx = i; }
            i = i + 1;
        }
        if preIdx >= 0 {
            pre := nextLocals[preIdx];
            trackFn := types.containsFnKind(pre.kind) or pre.name == "$tuple";
            var mergedCode := if trackFn { pre.code } else { "" };
            if trackFn {
                var li := preLen;
                var totalLocals := 0;
                loop locals { totalLocals = totalLocals + 1; }
                loop li < totalLocals {
                    cand := locals[li];
                    if cand.runtime == rt and cand.depth >= 0 and cand.depth <= maxDepth and cand.code =!= "" {
                        mergedCode = trace.mergeCallableLocalDeps(mergedCode, cand.code);
                    }
                    li = li + 1;
                }
            }
            nextInit := if pre.initState == ir.INIT_STATE_UNINIT or (pre.initState == ir.INIT_STATE_UNINIT_ASSIGNED and not pre.mutable) or ir.isInitStateMaybe(pre.initState) {
                ir.INIT_STATE_MAYBE
            } else {
                pre.initState
            };
            if nextInit =!= pre.initState or (trackFn and mergedCode =!= pre.code) {
                mut nextLocals.pushBack((name = pre.name, runtime = pre.runtime, kind = pre.kind,
                mutable = pre.mutable, writable = pre.writable, depth = pre.depth, constant = false,
                code = if trackFn { mergedCode } else { pre.code }, intValue = 0, textValue = "", initState = nextInit));
            }
        }
    }
    nextLocals
};

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object, fixed array, callable stub, and an empty list. */
pub zeroParsed := fn(target: String, kind: String, next: Int): Parsed {
    if types.isDistinctKind(kind) {
        base := self(target, types.distinctBaseKind(kind), next);
        return (kind = kind, code = base.code, intValue = base.intValue, textValue = base.textValue, constant = base.constant, next = base.next);
    }
    if types.isTupleKind(kind) {
        count := types.tupleComponentCount(kind);
        if target == ir.TARGET_C and types.cStructTag(kind) =!= "" {
            tag := types.cStructTag(kind);
            if count == 0 {
                return (kind = kind, code = "/*@T:" + kind + "@*/((" + tag + "){ ._empty = 0 })", intValue = 0, textValue = "", constant = false, next = next);
            }
            mut cCodeBuf: tb.TextBuilder;
            var index := 0;
            loop index < count {
                comp := types.tupleComponent(kind, index);
                if index > 0 { mut cCodeBuf.append(", "); }
                mut cCodeBuf.append(".");
                mut cCodeBuf.append(types.cFieldName(comp.prop));
                mut cCodeBuf.append(" = ");
                mut cCodeBuf.append(self(target, comp.kind, next).code);
                index = index + 1;
            }
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + tag + "){ " + cCodeBuf.build() + " })", intValue = 0, textValue = "", constant = false, next = next);
        }
        mut codeBuf: tb.TextBuilder;
        mut codeBuf.append("{ ");
        var index := 0;
        loop index < count {
            comp := types.tupleComponent(kind, index);
            if index > 0 { mut codeBuf.append(", "); }
            mut codeBuf.append(types.tupleObjectKey(comp.label, index));
            mut codeBuf.append(": ");
            mut codeBuf.append(self(target, comp.kind, next).code);
            index = index + 1;
        }
        mut codeBuf.append(" }");
        (kind = kind, code = codeBuf.build(), intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isMapKind(kind) {
        if target == ir.TARGET_C and types.cMapTag(kind) =!= "" {
            return (kind = kind, code = "/*@T:" + kind + "@*/" + types.cMapTag(kind) + "_from(0, NULL)", intValue = 0, textValue = "", constant = false, next = next);
        }
        kTs := types.tsFunctionType(types.mapKeyKind(kind));
        vTs := types.tsFunctionType(types.mapValueKind(kind));
        (kind = kind, code = "new Map<" + kTs + ", " + vTs + ">()", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isSetKind(kind) {
        if target == ir.TARGET_C and types.cSetTag(kind) =!= "" {
            return (kind = kind, code = "/*@T:" + kind + "@*/" + types.cSetTag(kind) + "_from(0, NULL)", intValue = 0, textValue = "", constant = false, next = next);
        }
        eTs := types.tsFunctionType(types.setElementKind(kind));
        (kind = kind, code = "new Set<" + eTs + ">()", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isRcKind(kind) {
        if target == ir.TARGET_C and types.cRcTag(kind) =!= "" {
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + types.cRcTag(kind) + "){ .box = NULL })", intValue = 0, textValue = "", constant = false, next = next);
        }
        elTs := types.tsFunctionType(types.rcElementKind(kind));
        (kind = kind, code = "({ box: null } as { box: { count: number; value: " + elTs + " } | null })", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isSliceKind(kind) {
        if target == ir.TARGET_C and types.cSliceTag(kind) =!= "" {
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + types.cSliceTag(kind) + "){ .data = NULL, .len = 0 })", intValue = 0, textValue = "", constant = false, next = next);
        }
        elTs := types.tsFunctionType(types.sliceElementKind(kind));
        (kind = kind, code = "({ data: ([] as " + elTs + "[]), off: 0, len: 0 })", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isSimdKind(kind) {
        elKind := types.simdElementKind(kind);
        n := types.simdLaneCount(kind);
        if target == ir.TARGET_C and types.cSimdTag(kind) =!= "" {
            zEl := self(target, elKind, next).code;
            return (kind = kind, code = "/*@T:" + kind + "@*/" + types.cSimdTag(kind) + "_splat(" + zEl + ")", intValue = 0, textValue = "", constant = false, next = next);
        }
        zEl := self(target, elKind, next).code;
        return (kind = kind, code = "lite$simdSplat(" + zEl + ", " + n.toText() + ")", intValue = 0, textValue = "", constant = false, next = next);
    }
    else if types.isSoaKind(kind) {
        recK := types.soaRecordKind(kind);
        if target == ir.TARGET_C and types.cSoaTag(kind) =!= "" {
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + types.cSoaTag(kind) + "){ .len = 0 })", intValue = 0, textValue = "", constant = false, next = next);
        }
        fc := types.recordComponentCount(recK);
        mut cols: List<String> = [];
        var fi := 0;
        loop fi < fc {
            comp := types.recordComponent(recK, fi);
            mut cols.pushBack(comp.prop + ": []");
            fi = fi + 1;
        }
        return (kind = kind, code = "({ " + cols.join(", ") + " } as " + types.tsFunctionType(kind) + ")", intValue = 0, textValue = "", constant = false, next = next);
    }
    else if types.isUnionKind(kind) {
        if target == ir.TARGET_C {
            tag := types.cStructTag(kind);
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + tag + "){ .tag = -1, .u = { ._empty = 0 } })", intValue = 0, textValue = "", constant = false, next = next);
        }
        mem0 := types.unionMembers(kind)[0];
        tsT := types.tsFunctionType(kind);
        zCode := if mem0 == ir.VALUE_KIND_UNIT {
            "({ _u: 0 as const } as " + tsT + ")"
        } else {
            "({ _u: 0 as const, _v: " + self(target, mem0, next).code + " } as " + tsT + ")"
        };
        (kind = kind, code = zCode, intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isResultKind(kind) {
        okK := types.resultOkKind(kind);
        if target == ir.TARGET_C {
            tag := types.cStructTag(kind);
            if okK == ir.VALUE_KIND_UNIT {
                return (kind = kind, code = "/*@T:" + kind + "@*/" + tag + "_ok()", intValue = 0, textValue = "", constant = false, next = next);
            }
            return (kind = kind, code = "/*@T:" + kind + "@*/" + tag + "_ok(" + self(target, okK, next).code + ")", intValue = 0, textValue = "", constant = false, next = next);
        }
        tsT := types.tsFunctionType(kind);
        zCode := if okK == ir.VALUE_KIND_UNIT {
            "({ _r: 0 as const } as " + tsT + ")"
        } else {
            "({ _r: 0 as const, _v: " + self(target, okK, next).code + " } as " + tsT + ")"
        };
        (kind = kind, code = zCode, intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isPayloadEnumKind(kind) {
        ps := types.enumCasePayloads(kind, 0);
        if target == ir.TARGET_C {
            tag := types.cStructTag(kind);
            if ps.length() == 0 {
                return (kind = kind, code = "/*@T:" + kind + "@*/" + tag + "_mk_0()", intValue = 0, textValue = "", constant = false, next = next);
            }
            mut zeroArgs: List<String> = [];
            var pi := 0;
            loop pi < ps.length() {
                mut zeroArgs.pushBack(self(target, ps[pi], next).code);
                pi = pi + 1;
            }
            return (kind = kind, code = "/*@T:" + kind + "@*/" + tag + "_mk_0(" + zeroArgs.join(", ") + ")", intValue = 0, textValue = "", constant = false, next = next);
        }
        tsT := types.tsFunctionType(kind);
        mut tsInitBuf: tb.TextBuilder;
        mut tsInitBuf.append("_t: 0 as const");
        var pi := 0;
        loop pi < ps.length() {
            mut tsInitBuf.append(", _");
            mut tsInitBuf.append(pi.toText());
            mut tsInitBuf.append(": ");
            mut tsInitBuf.append(self(target, ps[pi], next).code);
            pi = pi + 1;
        }
        (kind = kind, code = "({ " + tsInitBuf.build() + " } as " + tsT + ")", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isEnumKind(kind) {
        (kind = kind, code = "0", intValue = 0, textValue = "", constant = true, next = next)
    }
    else if types.isRecordKind(kind) {
        count := types.recordComponentCount(kind);
        if target == ir.TARGET_C and types.cStructTag(kind) =!= "" {
            tag := types.cStructTag(kind);
            if count == 0 {
                return (kind = kind, code = "/*@T:" + kind + "@*/((" + tag + "){ ._empty = 0 })", intValue = 0, textValue = "", constant = false, next = next);
            }
            mut cCodeBuf: tb.TextBuilder;
            var index := 0;
            loop index < count {
                comp := types.recordComponent(kind, index);
                if index > 0 { mut cCodeBuf.append(", "); }
                mut cCodeBuf.append(".");
                mut cCodeBuf.append(types.cFieldName(comp.prop));
                mut cCodeBuf.append(" = ");
                mut cCodeBuf.append(self(target, comp.kind, next).code);
                index = index + 1;
            }
            return (kind = kind, code = "/*@T:" + kind + "@*/((" + tag + "){ " + cCodeBuf.build() + " })", intValue = 0, textValue = "", constant = false, next = next);
        }
        if count == 0 { return (kind = kind, code = "{}", intValue = 0, textValue = "", constant = false, next = next); }
        mut codeBuf: tb.TextBuilder;
        mut codeBuf.append("{ ");
        var index := 0;
        loop index < count {
            comp := types.recordComponent(kind, index);
            if index > 0 { mut codeBuf.append(", "); }
            mut codeBuf.append(types.tupleObjectKey(comp.label, index));
            mut codeBuf.append(": ");
            mut codeBuf.append(self(target, comp.kind, next).code);
            index = index + 1;
        }
        mut codeBuf.append(" }");
        (kind = kind, code = codeBuf.build(), intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isListKind(kind) {
        if target == ir.TARGET_C and types.cListTag(types.listElementKind(kind)) =!= "" {
            cTag := types.cListTag(types.listElementKind(kind));
            return (kind = kind, code = "lt_list_" + cTag + "_from(0, NULL)", intValue = 0, textValue = "", constant = false, next = next);
        }
        (kind = kind, code = "[]", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isArrayKind(kind) {
        elemKind := types.arrayElementKind(kind);
        extent := types.arrayExtent(kind);
        if target == ir.TARGET_C and types.cArrayTag(kind) =!= "" {
            aTag := types.cArrayTag(kind);
            if extent == 0 {
                return (kind = kind, code = "((/*@T:" + kind + "@*/" + aTag + "){ 0 })", intValue = 0, textValue = "", constant = false, next = next);
            }
            if numeric.isIntKind(elemKind) or numeric.isFloatKind(elemKind) or elemKind == ir.VALUE_KIND_BOOL or (types.isEnumKind(elemKind) and not types.isPayloadEnumKind(elemKind)) {
                return (kind = kind, code = "((/*@T:" + kind + "@*/" + aTag + "){ { 0 } })", intValue = 0, textValue = "", constant = false, next = next);
            }
            elemZero := self(target, elemKind, next).code;
            if extent <= 16 {
                mut items: List<String> = [];
                var i := 0;
                loop i < extent {
                    mut items.pushBack(elemZero);
                    i = i + 1;
                }
                return (kind = kind, code = "((/*@T:" + kind + "@*/" + aTag + "){ { " + items.join(", ") + " } })", intValue = 0, textValue = "", constant = false, next = next);
            }
            return (kind = kind, code = "/*@T:" + kind + "@*/" + aTag + "_repeat(" + elemZero + ")", intValue = 0, textValue = "", constant = false, next = next);
        }
        elemZero := self(target, elemKind, next).code;
        mut items: List<String> = [];
        var i := 0;
        loop i < extent {
            mut items.pushBack(elemZero);
            i = i + 1;
        }
        if target == ir.TARGET_C and types.cListTag(elemKind) =!= "" {
            cTag := types.cListTag(elemKind);
            if extent == 0 {
                return (kind = kind, code = "lt_list_" + cTag + "_from(0, NULL)", intValue = 0, textValue = "", constant = false, next = next);
            }
            cArrType := "const " + types.cListElemType(cTag);
            return (kind = kind, code = "lt_list_" + cTag + "_from(" + extent.toText() + ", (" + cArrType + "[]){" + items.join(", ") + "})", intValue = 0, textValue = "", constant = false, next = next);
        }
        (kind = kind, code = "[" + items.join(", ") + "]", intValue = 0, textValue = "", constant = false, next = next)
    }
    else if types.isFnKind(kind) {
        if target == ir.TARGET_C {
            fTag := types.cFnTag(kind);
            return (kind = kind, code = "((/*@T:" + kind + "@*/" + fTag + "){ NULL, NULL })", intValue = 0, textValue = "", constant = false, next = next);
        }
        paramCount := types.fnParamCount(kind);
        mut paramsCodeBuf: tb.TextBuilder;
        mut voidStmtsBuf: tb.TextBuilder;
        var idx := 0;
        loop idx < paramCount {
            comp := types.fnParamComponent(kind, idx);
            pName := "lite_" + idx.toText();
            if idx > 0 { mut paramsCodeBuf.append(", "); }
            mut paramsCodeBuf.append(pName);
            mut paramsCodeBuf.append(": ");
            mut paramsCodeBuf.append(types.tsFunctionType(comp.kind));
            mut voidStmtsBuf.append("void ");
            mut voidStmtsBuf.append(pName);
            mut voidStmtsBuf.append("; ");
            idx = idx + 1;
        }
        paramsCode := paramsCodeBuf.build();
        voidStmts := voidStmtsBuf.build();
        retKind := types.fnResultKind(kind);
        retTs := types.tsFunctionType(retKind);
        bodyCode := if retKind == ir.VALUE_KIND_UNIT {
            "{ " + voidStmts + "}"
        } else {
            "{ " + voidStmts + "return " + self(target, retKind, next).code + "; }"
        };
        (kind = kind, code = "((" + paramsCode + "): " + retTs + " => " + bodyCode + ")", intValue = 0, textValue = kind, constant = false, next = next)
    }
    else if numeric.isIntKind(kind) { typedIntParsed(kind, ir.targetIntLiteralCode(target, 0, false, "0"), 0, true, next) }
    else if numeric.isFloatKind(kind) { (kind = kind, code = "0", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == ir.VALUE_KIND_STRING { textParsed(ir.targetTextLiteralCode(target, ""), "", true, next) }
    else if kind == ir.VALUE_KIND_UNIT { (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next) }
    else { boolParsed(ir.targetBoolLiteralCode(target, false), false, true, next) }
};

/** Returns a copy of `values` with element `index` replaced by `value`. */
pub setIntAt := fn(values: List<Int>, index: Int, value: Int): List<Int> {
    mut updated: List<Int> = [];
    var i := 0;
    loop values as item {
        mut updated.pushBack(if i == index { value } else { item });
        i = i + 1;
    }
    updated
};

/** Returns a copy of `values` with element `index` replaced by `value`. */
pub setBoolAt := fn(values: List<Bool>, index: Int, value: Bool): List<Bool> {
    mut updated: List<Bool> = [];
    var i := 0;
    loop values as item {
        mut updated.pushBack(if i == index { value } else { item });
        i = i + 1;
    }
    updated
};

/** Returns the 0-based parameter slot index matching `label` in `[first, first + count)`, or -1 when absent. */
pub findParamSlot := fn(params: List<String>, first: Int, count: Int, label: String): Int {
    var i := 0;
    loop i < count {
        if types.paramNameOf(params[first + i]) == label { return i; }
        i = i + 1;
    }
    -1
};

/** Normalizes a conditional ternary branch for TS or C (promoting Unit/Never cleanly for C11 `?:`). */
ternaryBranchCode := fn(target: String, resultKind: String, branchKind: String, branchCode: String): String {
    if target == ir.TARGET_TS {
        return assignValueCode(target, resultKind, branchKind, branchCode);
    }
    if resultKind == ir.VALUE_KIND_UNIT {
        if branchCode == "0" { "0" } else { ir.targetUnitEvaluationCode(target, branchCode) }
    } else if branchKind == ir.VALUE_KIND_NEVER {
        "(" + branchCode + ", " + zeroParsed(target, resultKind, 0).code + ")"
    } else {
        assignValueCode(target, resultKind, branchKind, branchCode)
    }
};

/** Unwraps a C11 expression (possibly `/*@CBLK:<ret>@*/<body>`) into a statement assigning `varName` (or discarding for Unit/Never). */
pub cUnwrapIntoVar := fn(varName: String, kind: String, code: String): String {
    if code.startsWithAt(0, "/*@CBLK:") {
        endHdr := code.indexOf("@*/", 8);
        retVar := code.slice(8, endHdr);
        blkBody := code.slice(endHdr + 3, code.length());
        if varName == "" or kind == ir.VALUE_KIND_NEVER or kind == ir.VALUE_KIND_UNIT {
            if retVar =!= "" and retVar =!= "0" {
                "{ " + blkBody + " (void)" + retVar + "; }"
            } else {
                "{ " + blkBody + " }"
            }
        } else {
            "{ " + blkBody + " " + varName + " = " + retVar + "; }"
        }
    } else if kind == ir.VALUE_KIND_NEVER {
        "(void)(" + code + ");"
    } else if varName == "" or kind == ir.VALUE_KIND_UNIT {
        if code == "0" { "" } else { "(void)(" + code + ");" }
    } else {
        varName + " = " + code + ";"
    }
};

/** Builds a nested conditional expression while converting any branch that widens to `resultKind`. */
pub ternaryChainCode := fn(target: String, resultKind: String, conditionCodes: List<String>, branchCodes: List<String>, branchKinds: List<String>, branchCount: Int): String {
    if target == ir.TARGET_C {
        var hasCBlk := false;
        var bi := 0;
        loop bi < branchCount {
            if branchCodes[bi].startsWithAt(0, "/*@CBLK:") {
                hasCBlk = true;
                break;
            }
            bi = bi + 1;
        }
        if hasCBlk {
            if branchCount == 1 {
                return branchCodes[0];
            }
            cVar := if resultKind == ir.VALUE_KIND_UNIT or resultKind == ir.VALUE_KIND_NEVER { "" } else { "lt_cval_" + (branchCodes[0].length() + branchCount).toText() };
            var declPrefix := if cVar == "" { "" } else { types.cValueType(resultKind) + " " + cVar + "; " };
            mut stmtBuf: tb.TextBuilder;
            var ci := 0;
            loop ci < branchCount {
                bCode := if branchKinds[ci] == ir.VALUE_KIND_NEVER or resultKind == ir.VALUE_KIND_UNIT or branchCodes[ci].startsWithAt(0, "/*@CBLK:") {
                    branchCodes[ci]
                } else {
                    assignValueCode(target, resultKind, branchKinds[ci], branchCodes[ci])
                };
                bStmt := cUnwrapIntoVar(cVar, branchKinds[ci], bCode);
                if ci == 0 {
                    mut stmtBuf.append("if (");
                    mut stmtBuf.append(conditionCodes[0]);
                    mut stmtBuf.append(") { ");
                    mut stmtBuf.append(bStmt);
                    mut stmtBuf.append(" }");
                } else if ci < branchCount - 1 {
                    mut stmtBuf.append(" else if (");
                    mut stmtBuf.append(conditionCodes[ci]);
                    mut stmtBuf.append(") { ");
                    mut stmtBuf.append(bStmt);
                    mut stmtBuf.append(" }");
                } else {
                    mut stmtBuf.append(" else { ");
                    mut stmtBuf.append(bStmt);
                    mut stmtBuf.append(" }");
                }
                ci = ci + 1;
            }
            retTok := if cVar == "" { "0" } else { cVar };
            return "/*@CBLK:" + retTok + "@*/" + declPrefix + stmtBuf.build();
        }
    }
    var code := ternaryBranchCode(target, resultKind, branchKinds[branchCount - 1], branchCodes[branchCount - 1]);
    var index := branchCount - 2;
    loop index >= 0 {
        branchCode := ternaryBranchCode(target, resultKind, branchKinds[index], branchCodes[index]);
        condExpr := if target == ir.TARGET_TS { "Boolean(" + conditionCodes[index] + ")" } else { "(" + conditionCodes[index] + ")" };
        code = "(" + condExpr + " ? " + branchCode + " : " + code + ")";
        index = index - 1;
    }
    if target == ir.TARGET_C and branchCount >= 2 and types.cDropFnForKind(resultKind) =!= "" {
        return "/*@T:" + resultKind + "@*/" + code;
    }
    if target == ir.TARGET_TS and branchCount >= 2 and types.isRcKind(resultKind) {
        return "/*@R*/" + code;
    }
    code
};

/** Reduces a conditional expression chain in O(k) by dropping constant-false arms and stopping at the first constant-true arm, propagating the winning branch's constant value when statically selected. */
pub reduceTernaryResult := fn(
target: String,
resultKind: String,
conditionCodes: List<String>,
conditionStates: List<Int>,
branchCodes: List<String>,
branchKinds: List<String>,
branchConsts: List<Bool>,
branchIntValues: List<Int>,
branchTextValues: List<String>,
branchCount: Int,
next: Int
): Parsed {
    mut keptCondCodes: List<String> = [];
    mut keptBranchCodes: List<String> = [];
    mut keptBranchKinds: List<String> = [];
    var keptCondCount := 0;
    var selectedIndex := -1;
    var hitTrue := false;
    var index := 0;
    condCount := branchCount - 1;
    loop index < condCount {
        state := conditionStates[index];
        if state == 1 {
            mut keptBranchCodes.pushBack(branchCodes[index]);
            mut keptBranchKinds.pushBack(branchKinds[index]);
            if keptCondCount == 0 { selectedIndex = index; }
            hitTrue = true;
            break;
        }
        if state =!= 0 {
            mut keptCondCodes.pushBack(conditionCodes[index]);
            mut keptBranchCodes.pushBack(branchCodes[index]);
            mut keptBranchKinds.pushBack(branchKinds[index]);
            keptCondCount = keptCondCount + 1;
        }
        index = index + 1;
    }
    if not hitTrue {
        lastIdx := branchCount - 1;
        mut keptBranchCodes.pushBack(branchCodes[lastIdx]);
        mut keptBranchKinds.pushBack(branchKinds[lastIdx]);
        if keptCondCount == 0 { selectedIndex = lastIdx; }
    }
    code := ternaryChainCode(target, resultKind, keptCondCodes, keptBranchCodes, keptBranchKinds, keptCondCount + 1);
    if selectedIndex >= 0 and branchConsts[selectedIndex] and
    (branchKinds[selectedIndex] == resultKind or (numeric.isIntKind(resultKind) and numeric.isIntKind(branchKinds[selectedIndex]))) {
        return (kind = resultKind, code = code, intValue = branchIntValues[selectedIndex],
        textValue = branchTextValues[selectedIndex], constant = true, next = next);
    }
    (kind = resultKind, code = code, intValue = 0, textValue = "", constant = false, next = next)
};

/** Formats one conditional branch statement for a lowered IIFE conditional (`if`, `else if`, `else`, or `match` arm). */
pub condBranchStmtCode := fn(target: String, valKind: String, valVar: String, branchKind: String, branchCode: String): String {
    if target == ir.TARGET_C {
        if valKind == ir.VALUE_KIND_NEVER or branchKind == ir.VALUE_KIND_NEVER or valKind == ir.VALUE_KIND_UNIT {
            cUnwrapIntoVar("", branchKind, branchCode)
        } else {
            cUnwrapIntoVar(valVar, valKind, assignValueCode(target, valKind, branchKind, branchCode))
        }
    } else if valKind == ir.VALUE_KIND_NEVER {
        "return (" + branchCode + ");"
    } else if branchKind == ir.VALUE_KIND_NEVER {
        "(" + branchCode + ");"
    } else if valKind == ir.VALUE_KIND_UNIT {
        if branchCode == ir.targetUnitLiteralCode(target) { "" } else { "void (" + branchCode + ");" }
    } else {
        valVar + " = " + assignValueCode(target, valKind, branchKind, branchCode) + ";"
    }
};

/** Rewrites `return ...;` and outer `goto <label>;` inside C11 `tryCode` so `{ finCode }` runs before every early exit. */
pub cRewriteFinallyExits := fn(tryCode: String, finCode: String, fnRetKind: String, finId: Int): String {
    if finCode == "" { return tryCode; }
    if tryCode.indexOf("return", 0) < 0 and tryCode.indexOf("goto ", 0) < 0 {
        return tryCode;
    }
    size := tryCode.length();
    mut out: tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    var rSeq := 0;
    loop cursor < size {
        ch := tryCode.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := tryCode.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == "/" and tryCode.startsWithAt(cursor, "/*@CFN_START:") {
            cursor = cursor + 13;
            var fnDepth := 1;
            loop cursor < size and fnDepth > 0 {
                fc := tryCode.at(cursor);
                if fc == "\"" {
                    cursor = syntax.skipAliasString(tryCode, cursor);
                } else if fc == "/" and tryCode.startsWithAt(cursor, "/*@CFN_START:") {
                    fnDepth = fnDepth + 1;
                    cursor = cursor + 13;
                } else if fc == "/" and tryCode.startsWithAt(cursor, "/*@CFN_END@*/") {
                    fnDepth = fnDepth - 1;
                    cursor = cursor + 13;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if ch == "/" and tryCode.startsWithAt(cursor, "/*") {
            endC := tryCode.indexOf("*/", cursor + 2);
            cursor = if endC >= 0 { endC + 2 } else { size };
        } else if ch == "g" and tryCode.startsWithAt(cursor, "goto ") and
        (cursor == 0 or not tryCode.at(cursor - 1).isNameContinue()) {
            lblStart := cursor + 5;
            semi := tryCode.indexOf(";", lblStart);
            if semi > lblStart {
                lbl := tryCode.slice(lblStart, semi).trim();
                if tryCode.indexOf(lbl + ":", 0) < 0 {
                    if cursor > flushed { mut out.append(tryCode.slice(flushed, cursor)); }
                    mut out.append("{ { " + finCode + " } goto " + lbl + "; }");
                    cursor = semi + 1;
                    flushed = cursor;
                    continue;
                }
            }
            cursor = cursor + 1;
        } else if ch == "r" and tryCode.startsWithAt(cursor, "return") and
        (cursor == 0 or not tryCode.at(cursor - 1).isNameContinue()) and
        (cursor + 6 >= size or not tryCode.at(cursor + 6).isNameContinue()) {
            var scan := cursor + 6;
            var depth := 0;
            var semi := -1;
            loop scan < size {
                sc := tryCode.at(scan);
                if sc == "\"" or sc == "'" {
                    scan = scan + 1;
                    loop scan < size {
                        s2 := tryCode.at(scan);
                        if s2 == "\\" { scan = scan + 2; }
                        else if s2 == sc { scan = scan + 1; break; }
                        else { scan = scan + 1; }
                    }
                } else if sc == "/" and tryCode.startsWithAt(scan, "/*") {
                    endC := tryCode.indexOf("*/", scan + 2);
                    scan = if endC >= 0 { endC + 2 } else { size };
                } else if sc == "(" or sc == "{" or sc == "[" {
                    depth = depth + 1; scan = scan + 1;
                } else if sc == ")" or sc == "}" or sc == "]" {
                    if depth > 0 { depth = depth - 1; }
                    scan = scan + 1;
                } else if sc == ";" and depth == 0 {
                    semi = scan; break;
                } else {
                    scan = scan + 1;
                }
            }
            if semi >= 0 {
                retExpr := tryCode.slice(cursor + 6, semi).trim();
                if cursor > flushed { mut out.append(tryCode.slice(flushed, cursor)); }
                if retExpr == "" or fnRetKind == "" or fnRetKind == ir.VALUE_KIND_UNIT or fnRetKind == ir.VALUE_KIND_NEVER {
                    mut out.append("{ { " + finCode + " } return; }");
                } else {
                    rSeq = rSeq + 1;
                    tmpVar := "lt_fr_" + finId.toText() + "_" + rSeq.toText();
                    mut out.append("{ " + types.cValueType(fnRetKind) + " " + tmpVar + " = (" + retExpr + "); { " + finCode + " } return " + tmpVar + "; }");
                }
                cursor = semi + 1;
                flushed = cursor;
                continue;
            }
            cursor = cursor + 1;
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { return tryCode; }
    if flushed < size { mut out.append(tryCode.slice(flushed, size)); }
    out.build()
};

/** Replaces whole-word occurrences of C identifier `ident` outside quoted strings with `replacement`. */
pub cReplaceIdentToken := fn(code: String, ident: String, replacement: String): String {
    if ident == "" or code.indexOf(ident, 0) < 0 { return code; }
    size := code.length();
    idLen := ident.length();
    firstCh := ident.at(0);
    mut out: tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := code.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == firstCh and code.startsWithAt(cursor, ident) and
        (cursor == 0 or not code.at(cursor - 1).isNameContinue()) and
        (cursor + idLen >= size or not code.at(cursor + idLen).isNameContinue()) {
            if cursor > flushed { mut out.append(code.slice(flushed, cursor)); }
            mut out.append(replacement);
            cursor = cursor + idLen;
            flushed = cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { return code; }
    if flushed < size { mut out.append(code.slice(flushed, size)); }
    out.build()
};

/** Replaces exact occurrences of C expression snippet `needle` outside quoted strings and `/*@CFN_START:...*/` blocks with `replacement`. */
pub cReplaceExactToken := fn(code: String, needle: String, replacement: String): String {
    if needle == "" or code.indexOf(needle, 0) < 0 { return code; }
    size := code.length();
    nLen := needle.length();
    firstCh := needle.at(0);
    mut out: tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    loop cursor < size {
        ch := code.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := code.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == "/" and code.startsWithAt(cursor, "/*@CFN_START:") {
            cursor = cursor + 13;
            var fnDepth := 1;
            loop cursor < size and fnDepth > 0 {
                fc := code.at(cursor);
                if fc == "\"" { cursor = syntax.skipAliasString(code, cursor); }
                else if fc == "/" and code.startsWithAt(cursor, "/*@CFN_START:") { fnDepth += 1; cursor += 13; }
                else if fc == "/" and code.startsWithAt(cursor, "/*@CFN_END@*/") { fnDepth -= 1; cursor += 13; }
                else { cursor += 1; }
            }
        } else if ch == firstCh and code.startsWithAt(cursor, needle) {
            endBoundOk := cursor + nLen >= size or not needle.at(nLen - 1).isNameContinue() or not code.at(cursor + nLen).isNameContinue();
            if endBoundOk {
                if cursor > flushed { mut out.append(code.slice(flushed, cursor)); }
                mut out.append(replacement);
                cursor = cursor + nLen;
                flushed = cursor;
            } else {
                cursor = cursor + 1;
            }
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { return code; }
    if flushed < size { mut out.append(code.slice(flushed, size)); }
    out.build()
};

/** Injects `retDropStmt` before `return` / outer `goto` exits and optional `loopDropStmt` before `break`/`continue` at loop depth 0 in C11 block code. */
pub cRewriteExitDrops := fn(bodyCode: String, retDropStmt: String, loopDropStmt: String, fnRetKind: String, rewriteId: Int): String {
    if retDropStmt == "" and loopDropStmt == "" { return bodyCode; }
    size := bodyCode.length();
    mut out: tb.TextBuilder;
    var cursor := 0;
    var flushed := 0;
    var rSeq := 0;
    var innerLoopDepth := 0;
    mut loopBraceStack: List<Int> = [];
    var braceDepth := 0;
    loop cursor < size {
        ch := bodyCode.at(cursor);
        if ch == "\"" or ch == "'" {
            cursor = cursor + 1;
            loop cursor < size {
                c2 := bodyCode.at(cursor);
                if c2 == "\\" { cursor = cursor + 2; }
                else if c2 == ch { cursor = cursor + 1; break; }
                else { cursor = cursor + 1; }
            }
        } else if ch == "/" and bodyCode.startsWithAt(cursor, "/*@CFN_START:") {
            cursor = cursor + 13;
            var fnDepth := 1;
            loop cursor < size and fnDepth > 0 {
                fc := bodyCode.at(cursor);
                if fc == "\"" { cursor = syntax.skipAliasString(bodyCode, cursor); }
                else if fc == "/" and bodyCode.startsWithAt(cursor, "/*@CFN_START:") { fnDepth += 1; cursor += 13; }
                else if fc == "/" and bodyCode.startsWithAt(cursor, "/*@CFN_END@*/") { fnDepth -= 1; cursor += 13; }
                else { cursor += 1; }
            }
        } else if ch == "/" and bodyCode.startsWithAt(cursor, "/*") {
            endC := bodyCode.indexOf("*/", cursor + 2);
            cursor = if endC >= 0 { endC + 2 } else { size };
        } else if ch == "{" {
            braceDepth = braceDepth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            if loopBraceStack.length() > 0 and loopBraceStack[loopBraceStack.length() - 1] == braceDepth {
                _popped := mut loopBraceStack.popBack();
                if innerLoopDepth > 0 { innerLoopDepth -= 1; }
            }
            if braceDepth > 0 { braceDepth = braceDepth - 1; }
            cursor = cursor + 1;
        } else if ((ch == "f" and bodyCode.startsWithAt(cursor, "for (")) or (ch == "w" and bodyCode.startsWithAt(cursor, "while ("))) and
        (cursor == 0 or not bodyCode.at(cursor - 1).isNameContinue()) {
            var pScan := cursor + (if ch == "f" { 4 } else { 6 });
            var pDepth := 0;
            loop pScan < size {
                pc := bodyCode.at(pScan);
                if pc == "\"" or pc == "'" {
                    pScan += 1;
                    loop pScan < size {
                        p2 := bodyCode.at(pScan);
                        if p2 == "\\" { pScan += 2; }
                        else if p2 == pc { pScan += 1; break; }
                        else { pScan += 1; }
                    }
                } else if pc == "(" { pDepth += 1; pScan += 1; }
                else if pc == ")" {
                    pDepth -= 1; pScan += 1;
                    if pDepth == 0 { break; }
                } else { pScan += 1; }
            }
            loop pScan < size and (bodyCode.at(pScan) == " " or bodyCode.at(pScan) == "\t" or bodyCode.at(pScan) == "\n") { pScan += 1; }
            if pScan < size and bodyCode.at(pScan) == "{" {
                braceDepth = braceDepth + 1;
                mut loopBraceStack.pushBack(braceDepth);
                innerLoopDepth = innerLoopDepth + 1;
                cursor = pScan + 1;
            } else {
                cursor = cursor + 1;
            }
        } else if loopDropStmt =!= "" and innerLoopDepth == 0 and ch == "b" and bodyCode.startsWithAt(cursor, "break;") and
        (cursor == 0 or not bodyCode.at(cursor - 1).isNameContinue()) {
            if cursor > flushed { mut out.append(bodyCode.slice(flushed, cursor)); }
            mut out.append("{ " + loopDropStmt + " break; }");
            cursor = cursor + 6;
            flushed = cursor;
        } else if loopDropStmt =!= "" and innerLoopDepth == 0 and ch == "c" and bodyCode.startsWithAt(cursor, "continue;") and
        (cursor == 0 or not bodyCode.at(cursor - 1).isNameContinue()) {
            if cursor > flushed { mut out.append(bodyCode.slice(flushed, cursor)); }
            mut out.append("{ " + loopDropStmt + " continue; }");
            cursor = cursor + 9;
            flushed = cursor;
        } else if retDropStmt =!= "" and ch == "g" and bodyCode.startsWithAt(cursor, "goto ") and
        (cursor == 0 or not bodyCode.at(cursor - 1).isNameContinue()) {
            lblStart := cursor + 5;
            semi := bodyCode.indexOf(";", lblStart);
            if semi > lblStart {
                lbl := bodyCode.slice(lblStart, semi).trim();
                if bodyCode.indexOf(lbl + ":", 0) < 0 {
                    if cursor > flushed { mut out.append(bodyCode.slice(flushed, cursor)); }
                    mut out.append("{ " + retDropStmt + " goto " + lbl + "; }");
                    cursor = semi + 1;
                    flushed = cursor;
                    continue;
                }
            }
            cursor = cursor + 1;
        } else if retDropStmt =!= "" and ch == "r" and bodyCode.startsWithAt(cursor, "return") and
        (cursor == 0 or not bodyCode.at(cursor - 1).isNameContinue()) and
        (cursor + 6 >= size or not bodyCode.at(cursor + 6).isNameContinue()) {
            var scan := cursor + 6;
            var depth := 0;
            var semi := -1;
            loop scan < size {
                sc := bodyCode.at(scan);
                if sc == "\"" or sc == "'" {
                    scan = scan + 1;
                    loop scan < size {
                        s2 := bodyCode.at(scan);
                        if s2 == "\\" { scan = scan + 2; }
                        else if s2 == sc { scan = scan + 1; break; }
                        else { scan = scan + 1; }
                    }
                } else if sc == "/" and bodyCode.startsWithAt(scan, "/*") {
                    endC := bodyCode.indexOf("*/", scan + 2);
                    scan = if endC >= 0 { endC + 2 } else { size };
                } else if sc == "(" or sc == "{" or sc == "[" {
                    depth = depth + 1; scan = scan + 1;
                } else if sc == ")" or sc == "}" or sc == "]" {
                    if depth > 0 { depth = depth - 1; }
                    scan = scan + 1;
                } else if sc == ";" and depth == 0 {
                    semi = scan; break;
                } else {
                    scan = scan + 1;
                }
            }
            if semi >= 0 {
                retExpr := bodyCode.slice(cursor + 6, semi).trim();
                if cursor > flushed { mut out.append(bodyCode.slice(flushed, cursor)); }
                if retExpr == "" or fnRetKind == "" or fnRetKind == ir.VALUE_KIND_UNIT or fnRetKind == ir.VALUE_KIND_NEVER {
                    mut out.append("{ " + retDropStmt + " return; }");
                } else {
                    rSeq = rSeq + 1;
                    tmpVar := "lt_exr_" + rewriteId.toText() + "_" + rSeq.toText();
                    mut out.append("{ " + types.cValueType(fnRetKind) + " " + tmpVar + " = (" + retExpr + "); " + retDropStmt + " return " + tmpVar + "; }");
                }
                cursor = semi + 1;
                flushed = cursor;
                continue;
            }
            cursor = cursor + 1;
        } else {
            cursor = cursor + 1;
        }
    }
    if flushed == 0 { return bodyCode; }
    if flushed < size { mut out.append(bodyCode.slice(flushed, size)); }
    out.build()
};

/** Returns the number of entries in `ctxs`. */
pub ctxCount := fn(ctxs: List<ConstructCtx>): Int {
    var count := 0;
    loop ctxs { count += 1; }
    count
};

/** Returns a copy of `ctxs` with `entry` appended at the end. */
pub appendCtx := fn(ctxs: List<ConstructCtx>, entry: ConstructCtx): List<ConstructCtx> {
    mut copy: List<ConstructCtx> = ctxs;
    mut copy.pushBack(entry);
    copy
};

/** Returns one fresh positive construct identifier higher than any active id in `ctxs`. */
pub nextCtxId := fn(ctxs: List<ConstructCtx>): Int {
    var highest := 0;
    loop ctxs as existing {
        if existing.id > highest { highest = existing.id; }
    }
    highest + 1
};

/** Finds the innermost context in `ctxs` matching `tag`, or -1 when absent. */
pub findTaggedCtxIndex := fn(ctxs: List<ConstructCtx>, tag: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].tag == tag { return index; }
        index = index - 1;
    }
    -1
};

/** Finds the innermost context in `ctxs` matching `kind`, or -1 when absent. */
pub findCtxByKindIndex := fn(ctxs: List<ConstructCtx>, kind: String): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        if ctxs[index].kind == kind { return index; }
        index = index - 1;
    }
    -1
};

/** Returns the entries of `locals` declared below `depth` (including pre-scanned future placeholders below `depth`), preserving order. */
pub visibleLocals := fn(locals: List<Local>, depth: Int): List<Local> {
    var dropped := false;
    var firstDrop := -1;
    var keptAfterDrop := false;
    var idx := 0;
    loop locals as entry {
        keep := (entry.depth >= -1 and entry.depth < depth) or
        (entry.depth <= -2 and (0 - 2 - entry.depth) < depth);
        if not keep {
            if not dropped { dropped = true; firstDrop = idx; }
        } else if dropped {
            keptAfterDrop = true;
            break;
        }
        idx = idx + 1;
    }
    if not dropped { return locals; }
    sym.rewindLocalsTo(firstDrop);
    if not keptAfterDrop {
        if firstDrop <= 0 { return []; }
        return locals.slice(0, firstDrop);
    }
    mut kept: List<Local> = [];
    loop locals as entry {
        if (entry.depth >= -1 and entry.depth < depth) or
        (entry.depth <= -2 and (0 - 2 - entry.depth) < depth) {
            mut kept.pushBack(entry);
        }
    }
    kept
};

/** Drops current-block declaration records at or above `depth`, keeping enclosing blocks intact. */
pub popBlockDecls := fn(decls: List<BlockDecl>, depth: Int): List<BlockDecl> {
    var dropped := false;
    var firstDrop := -1;
    var keptAfterDrop := false;
    var idx := 0;
    loop decls as entry {
        if entry.depth >= depth {
            if not dropped { dropped = true; firstDrop = idx; }
        } else if dropped {
            keptAfterDrop = true;
            break;
        }
        idx = idx + 1;
    }
    if not dropped { return decls; }
    if not keptAfterDrop {
        if firstDrop <= 0 { return []; }
        return decls.slice(0, firstDrop);
    }
    mut kept: List<BlockDecl> = [];
    loop decls as entry {
        if entry.depth < depth {
            mut kept.pushBack(entry);
        }
    }
    kept
};

/** Rejects redeclaring `name` within the same file-root (`depth == 0`) or inner block. */
pub rejectDuplicateBlockDecl := fn(source: String, at: Int, prefix: String, decls: List<BlockDecl>, depth: Int, name: String): Unit {
    if ir.hasBlockDecl(decls, depth, name) {
        if depth == 0 {
            syntax.failAt(source, at, prefix, "duplicate top-level value " + name);
        }
        syntax.failAt(source, at, prefix, "duplicate declaration " + name + " in block");
    }
};

/** Rejects redeclaring `name` inside the current `{ ... }` block. */
pub rejectDuplicateInBlockNames := fn(source: String, at: Int, prefix: String, names: List<String>, name: String): Unit {
    if names.contains(name) {
        syntax.failAt(source, at, prefix, "duplicate declaration " + name + " in block");
    }
};

/** Extracts header-bound symbol names (parameters or loop items) owned by the opening `{ ... }` block. */
pub seedBlockDeclaredNames := fn(bodySink: String): List<String> {
    mut seeded: List<String> = [];
    colonPos := bodySink.indexOf(":", 0);
    if colonPos < 0 { return seeded; }
    namesLen := bodySink.length();
    var cursor := colonPos + 1;
    loop cursor < namesLen {
        var endPos := cursor;
        loop endPos < namesLen and bodySink.at(endPos) =!= "," {
            endPos = endPos + 1;
        }
        if endPos > cursor {
            mut seeded.pushBack(bodySink.slice(cursor, endPos));
        }
        cursor = endPos + 1;
    }
    seeded
};

/** Joins a block's definite completion: scopes preserve it, loops require a true header, and conditionals require every arm plus a final else. */
pub blockCompletion := fn(kind: String, completed: Bool, branchesComplete: Bool, hasElse: Bool, loopForever: Bool): Bool {
    if kind == ir.BLOCK_KIND_SCOPE or kind == ir.BLOCK_KIND_MATCH_SINGLE or kind == ir.BLOCK_KIND_MATCH_SINGLE_VALUE or kind == ir.BLOCK_KIND_COMPTIME_IF or kind == ir.BLOCK_KIND_COMPTIME_IF_VALUE or kind == ir.BLOCK_KIND_COMPTIME_MATCH or kind == ir.BLOCK_KIND_COMPTIME_MATCH_VALUE { completed }
    else if kind == ir.BLOCK_KIND_LOOP { loopForever and completed }
    else { hasElse and branchesComplete and completed }
};

/** True when emitted target code contains a raw `lite$throwTransfer(` or `lite$throwProp(` substring worth quote-aware inspection. */
pub codeHasRawTransfer := fn(code: String): Bool {
    code =!= "" and (code.indexOf("lite$throwTransfer(", 0) >= 0 or code.indexOf("lite$throwProp(", 0) >= 0)
};

/** True when `parsed` encodes Pass 1 exit markers in `textValue`. */
pub hasMarkerPrefix := fn(parsed: Parsed): Bool {
    not parsed.constant and parsed.textValue.startsWithAt(0, "__m:")
};

/** Appends Pass 1 exit markers encoded on `parsed` onto `current`. */
pub collectParsedMarkers := fn(current: String, parsed: Parsed): String {
    if hasMarkerPrefix(parsed) {
        return current + parsed.textValue.slice(4, parsed.textValue.length());
    }
    current
};

/** Encodes raw marker lines for `Parsed.textValue`, or returns empty when none exist. */
pub wrapMarkers := fn(raw: String): String {
    if raw == "" { "" } else { "__m:" + raw }
};

/** Attaches raw Pass 1 exit markers onto `parsed` when non-empty. */
pub withMarkers := fn(parsed: Parsed, raw: String): Parsed {
    if raw == "" { return parsed; }
    (kind = parsed.kind, code = parsed.code, intValue = parsed.intValue,
    textValue = "__m:" + raw, constant = false, next = parsed.next)
};

/** Retains all marker lines in `raw` whose target id is not `excludeId`. */
pub filterOtherMarkers := fn(raw: String, excludeId: Int): String {
    excludeKey := excludeId.toText();
    size := raw.length();
    var cursor := 0;
    mut kept: tb.TextBuilder;
    loop cursor < size {
        eqPos := raw.indexOf("=", cursor);
        if eqPos < 0 { break; }
        nlPos := raw.indexOf("\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := raw.slice(cursor, eqPos);
        if entryId =!= excludeKey {
            mut kept.appendLine(raw.slice(cursor, endPos));
        }
        cursor = endPos + 1;
    }
    kept.build()
};

/** Unifies all inferred exit kinds recorded for `targetId` in `raw` markers, failing on incompatible exit types. */
pub inferKindFromMarkers := fn(raw: String, targetId: Int, targetTag: String, source: String, at: Int, prefix: String, blockStopped: Bool): String {
    idKey := targetId.toText();
    size := raw.length();
    var cursor := 0;
    var result := "";
    loop cursor < size {
        eqPos := raw.indexOf("=", cursor);
        if eqPos < 0 { break; }
        nlPos := raw.indexOf("\n", eqPos + 1);
        endPos := if nlPos < 0 { size } else { nlPos };
        entryId := raw.slice(cursor, eqPos);
        entryKind := raw.slice(eqPos + 1, endPos);
        if entryId == idKey {
            if result == "" {
                result = entryKind;
            } else {
                joined := types.joinBranchKind(result, entryKind);
                if joined == "" {
                    syntax.failAt(source, at, prefix, "block @" + targetTag + " cannot return both " +
                    types.displayKind(result) + " and " + types.displayKind(entryKind));
                }
                result = joined;
            }
        }
        cursor = endPos + 1;
    }
    if result == "" {
        if blockStopped { ir.VALUE_KIND_NEVER } else { ir.VALUE_KIND_UNIT }
    } else {
        result
    }
};

/** Returns true when a call argument list reorders or mismatches slots relative to the callee's declaration order. */
pub callReordersArgs := fn(source: String, openParen: Int, prefix: String, params: List<String>, firstParam: Int, paramCount: Int): Bool {
    size := source.length();
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    if cursor >= size or source.at(cursor) == ")" { return false; }
    var entryIdx := 0;
    var atArgStart := true;
    var depth := 0;
    loop cursor < size {
        if atArgStart and depth == 0 {
            if source.at(cursor) == ")" { break; }
            var label := "";
            if syntax.isSingleEquals(source, cursor) {
                nameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if nameStart < size and source.at(nameStart).isNameStart() {
                    label = source.slice(nameStart, source.skipName(nameStart));
                }
            } else if source.at(cursor).isNameStart() {
                nameEnd := source.skipName(cursor);
                afterName := syntax.skipTrivia(source, nameEnd, prefix);
                if syntax.isSingleEquals(source, afterName) {
                    label = source.slice(cursor, nameEnd);
                }
            }
            if label =!= "" and findParamSlot(params, firstParam, paramCount, label) =!= entryIdx {
                return true;
            }
            atArgStart = false;
        }
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = syntax.skipAliasString(source, cursor);
        } else if ch == "/" and source.startsWithAt(cursor, "/*") {
            cursor = syntax.skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" or ch == "}" {
            if depth == 0 and ch == ")" {
                entryIdx = entryIdx + 1;
                break;
            }
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if depth == 0 and ch == "," {
            entryIdx = entryIdx + 1;
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            if cursor < size and source.at(cursor) == ")" { break; }
            atArgStart = true;
        } else {
            cursor = cursor + 1;
        }
    }
    entryIdx =!= paramCount
};

/** Finds the innermost loop context for leading-dot metadata, stopping on conditional (unless `allowThroughCond`), cleanup, or function barriers (-2 conditional, -3 finally, -1 outside). */
pub findLeadingDotLoopIdx := fn(ctxs: List<ConstructCtx>, allowThroughCond: Bool): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        kind := ctxs[index].kind;
        if kind == ir.CTX_KIND_LOOP { return index; }
        if (kind == ir.CTX_KIND_IF or kind == ir.CTX_KIND_MATCH) and not allowThroughCond { return ir.DOT_LOOP_IN_CONDITIONAL; }
        if kind == ir.CTX_KIND_FINALLY { return ir.DOT_LOOP_IN_FINALLY; }
        if kind == ir.CTX_KIND_FN { return ir.DOT_LOOP_OUTSIDE; }
        index = index - 1;
    }
    ir.DOT_LOOP_OUTSIDE
};

/** Finds the innermost active enclosing loop context, skipping loops whose body already completed (`then` or `finally`) and stopping at `fn`. */
pub findActiveLoopCtxIndex := fn(ctxs: List<ConstructCtx>): Int {
    var index := ctxCount(ctxs) - 1;
    loop index >= 0 {
        entry := ctxs[index];
        if entry.kind == ir.CTX_KIND_FN { return -1; }
        if entry.kind == ir.CTX_KIND_LOOP and entry.phase =!= ir.CTX_PHASE_THEN and entry.phase =!= ir.CTX_PHASE_FINALLY { return index; }
        index = index - 1;
    }
    -1
};

/** True when a cleanup `finally` barrier sits strictly above `targetIdx` on `ctxs`. */
pub hasFinallyAbove := fn(ctxs: List<ConstructCtx>, targetIdx: Int): Bool {
    var index := ctxCount(ctxs) - 1;
    loop index > targetIdx {
        if ctxs[index].kind == ir.CTX_KIND_FINALLY { return true; }
        index = index - 1;
    }
    false
};

/** Resolves `.count`, `.value`, `.item`, or `.index` against one active loop context, handling Pass 1 inference markers cleanly. */
pub resolveLoopField := fn(target: String, ctx: ConstructCtx, fieldName: String, expected: String, source: String, fieldStart: Int, fieldEnd: Int, prefix: String): Parsed {
    if fieldName == "count" {
        return intParsed(ctx.countVar, 0, false, fieldEnd);
    }
    if fieldName == "value" {
        if ctx.valKind == ir.VAL_KIND_INFER {
            if expected =!= "" and expected =!= ir.VALUE_KIND_UNIT and expected =!= ir.VALUE_KIND_NEVER and
            not expected.startsWithAt(0, "TailList<") and not expected.startsWithAt(0, "__loopVal:") {
                return withMarkers((kind = expected, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                ctx.id.toText() + "=" + expected + "\n");
            }
            return withMarkers((kind = "__loopVal:" + ctx.id.toText(), code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
            if ctx.phase =!= ir.CTX_PHASE_THEN { ctx.id.toText() + "=@read\n" } else { "" });
        }
        if ctx.valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":")) {
            hint := ctx.valKind.slice(10, ctx.valKind.length());
            return withMarkers((kind = hint, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
            ctx.id.toText() + "=" + hint + "\n");
        }
        if ctx.valKind == ir.VALUE_KIND_UNIT {
            return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.valKind, code = ctx.valVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "item" {
        if ctx.phase == ir.CTX_PHASE_HEADER {
            syntax.failAt(source, fieldStart, prefix, ".item is not available in loop header");
        }
        if ctx.itemKind == "" or ctx.itemKind == ir.VALUE_KIND_UNIT {
            return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = fieldEnd);
        }
        return (kind = ctx.itemKind, code = ctx.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    if fieldName == "index" {
        if ctx.phase == ir.CTX_PHASE_HEADER {
            syntax.failAt(source, fieldStart, prefix, ".index is not available in loop header");
        }
        if not ctx.hasIndex {
            syntax.failAt(source, fieldStart, prefix, "loop does not expose .index without a sequence source");
        }
        return intParsed(ctx.indexVar, 0, false, fieldEnd);
    }
    if fieldName == "collected" {
        if ctx.phase =!= ir.CTX_PHASE_THEN {
            syntax.failAt(source, fieldStart, prefix, ".collected is only available in a loop's then block or as a loop suffix");
        }
        if ctx.valKind == ir.VAL_KIND_INFER {
            if types.isListKind(expected) {
                elemExp := types.listElementKind(expected);
                if elemExp =!= "" and elemExp =!= ir.VALUE_KIND_UNIT and elemExp =!= ir.VALUE_KIND_NEVER and
                not elemExp.startsWithAt(0, "TailList<") and not elemExp.startsWithAt(0, "__loopVal:") {
                    return withMarkers((kind = expected, code = ctx.colVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
                    ctx.id.toText() + "=" + elemExp + "\n");
                }
            }
            return (kind = "List<__loopVal:" + ctx.id.toText() + ">", code = ctx.colVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
        }
        if ctx.valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":")) {
            hint := ctx.valKind.slice(10, ctx.valKind.length());
            return withMarkers((kind = "List<" + hint + ">", code = ctx.colVar, intValue = 0, textValue = "", constant = false, next = fieldEnd),
            ctx.id.toText() + "=" + hint + "\n");
        }
        if ctx.valKind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, fieldStart, prefix, "loop producing Unit does not expose .collected");
        }
        if ctx.valKind == ir.VALUE_KIND_NEVER {
            syntax.failAt(source, fieldStart, prefix, "diverging loop does not expose .collected");
        }
        return (kind = "List<" + ctx.valKind + ">", code = ctx.colVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
    }
    syntax.failAt(source, fieldStart, prefix, "unknown loop metadata field ." + fieldName);
    intParsed("", 0, false, fieldEnd)
};

/** Collapses a numeric scalar, tuple or list kind to its canonical item suffix (`Int`, `Float`, `Tuple`, `List`, `Fn`) while leaving other scalar kinds unchanged. */
pub storageKind := fn(kind: String): String {
    match {
        types.isListKind(kind) or types.isArrayKind(kind) { "List" }
        types.isTupleKind(kind) { "Tuple" }
        types.isRecordKind(kind) or types.isEnumKind(kind) or types.isDistinctKind(kind) or types.isMapKind(kind) or types.isSetKind(kind) or types.isRcKind(kind) or types.isSliceKind(kind) or types.isDynKind(kind) or types.isSimdKind(kind) or types.isSoaKind(kind) or types.isUnionKind(kind) or types.isResultKind(kind) { "Record" }
        types.isFnKind(kind) { "Fn" }
        numeric.isIntKind(kind) { ir.VALUE_KIND_INT }
        numeric.isFloatKind(kind) { ir.VALUE_KIND_FLOAT }
        _ { kind }
    }
};

/** Returns the text payload for a storage item with explicit declared kind `kind`, falling back to `fallback`. */
pub storageTextPayload := fn(kind: String, fallback: String): String {
    if types.isListKind(kind) or types.isArrayKind(kind) or types.isFnKind(kind) or types.isRecordKind(kind) or types.isTupleKind(kind) or types.isEnumKind(kind) or types.isDistinctKind(kind) or types.isMapKind(kind) or types.isSetKind(kind) or types.isRcKind(kind) or types.isSliceKind(kind) or types.isDynKind(kind) or types.isSimdKind(kind) or types.isSoaKind(kind) or types.isUnionKind(kind) or types.isResultKind(kind) or numeric.isNarrowNumericKind(kind) { kind } else { fallback }
};

/** Returns the text payload stored with one local item: the canonical List/Array/Fn kind for List/Array/Fn items, otherwise the parsed literal text. */
pub itemTextPayload := fn(parsed: Parsed): String {
    storageTextPayload(parsed.kind, parsed.textValue)
};

/** True when the innermost block expects a value tail: a function body or one of the value branches that complete one. */
pub atValueTail := fn(blocks: List<String>, blockCount: Int): Bool {
    if blockCount <= 0 { return false; }
    kind := blocks[blockCount - 1];
    kind == ir.BLOCK_KIND_FUNCTION or kind == ir.BLOCK_KIND_IF_VALUE or kind == ir.BLOCK_KIND_MATCH_VALUE or kind == ir.BLOCK_KIND_MATCH_ELSE_VALUE or kind == ir.BLOCK_KIND_MATCH_SINGLE_VALUE or kind == ir.BLOCK_KIND_COMPTIME_IF_VALUE or kind == ir.BLOCK_KIND_COMPTIME_MATCH_VALUE
};

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
pub insideLoop := fn(blocks: List<String>): Bool {
    loop blocks as kind {
        if kind == ir.BLOCK_KIND_LOOP { return true; }
    }
    false
};
