/** Generic function template registry, type unification/substitution, and on-demand monomorphization queue. */

textLib := import "core/text";
numeric := import "./numeric-literals";
ir := import "./frontend-ir";
types := import "./frontend-types";

/** Local alias for `ir.Item`. */
Item := alias ir.Item;
/** Local alias for `ir.Items`. */
Items := alias ir.Items;
/** Local alias for `ir.Local`. */
Local := alias ir.Local;
/** Local alias for `ir.FunctionInfo`. */
FunctionInfo := alias ir.FunctionInfo;
/** Local alias for `ir.AliasDecl`. */
AliasDecl := alias ir.AliasDecl;
/** Local alias for `ir.FutureValue`. */
FutureValue := alias ir.FutureValue;

/** Registered uninstantiated generic function or type-attached operation template. */
pub GenericTemplate := alias (
    key: String,
    qualName: String,
    typeOpKey: String,
    moduleKey: String,
    moduleIdentity: String,
    prefix: String,
    source: String,
    bodyStart: Int,
    bodyEnd: Int,
    declAt: Int,
    genericParams: String,
    params: String,
    paramCount: Int,
    result: String,
    selfTarget: String,
    isPub: Bool
);

/** Index slice into flat environment tables for one parsed module. */
pub ModuleEnvRange := alias (
    moduleKey: String,
    localsStart: Int, localsCount: Int,
    fnsStart: Int, fnsCount: Int,
    paramsStart: Int, paramsCount: Int,
    aliasesStart: Int, aliasesCount: Int,
    futuresStart: Int, futuresCount: Int,
    assignedStart: Int, assignedCount: Int
);

/** One requested concrete monomorphization of a `GenericTemplate`. */
pub GenericInstance := alias (
    templateKey: String,
    bindingsEncoded: String,
    substParams: String,
    substResult: String,
    runtime: String,
    moduleKey: String,
    compiled: Bool
);

templates: mut List<GenericTemplate> = [];
templateByKey: mut Map<String, Int>;

envRanges: mut List<ModuleEnvRange> = [];
moduleEnvByKey: mut Map<String, Int>;
envLocalsPool: mut List<Local> = [];
envFunctionsPool: mut List<FunctionInfo> = [];
envFnParamsPool: mut List<String> = [];
envAliasesPool: mut List<AliasDecl> = [];
envFuturesPool: mut List<FutureValue> = [];
envAssignedPool: mut List<String> = [];

instances: mut List<GenericInstance> = [];
instanceByKey: mut Map<String, Int>;

/** Resets all generic template, module-environment, and monomorphization state before a fresh compilation. */
pub resetAll := fn(): Unit {
    mut templates.clear();
    mut templateByKey.clear();
    mut envRanges.clear();
    mut moduleEnvByKey.clear();
    mut envLocalsPool.clear();
    mut envFunctionsPool.clear();
    mut envFnParamsPool.clear();
    mut envAliasesPool.clear();
    mut envFuturesPool.clear();
    mut envAssignedPool.clear();
    mut instances.clear();
    mut instanceByKey.clear();
};

/** Registers or refreshes one `GenericTemplate` keyed by `tpl.key`. */
pub registerTemplate := fn(tpl: GenericTemplate): Unit {
    existing := templateByKey.getOr(tpl.key, -1);
    if existing >= 0 {
        templates[existing] = tpl;
        return;
    }
    idx := templates.length();
    mut templates.pushBack(tpl);
    mut templateByKey.set(tpl.key, idx);
};

/** Returns the index of the registered template for `key`, or -1. */
pub findTemplate := fn(key: String): Int {
    templateByKey.getOr(key, -1)
};

/** Returns the `GenericTemplate` at `idx`. */
pub getTemplate := fn(idx: Int): GenericTemplate {
    templates[idx]
};

/** Saves or replaces the depth-0 environment snapshot for `moduleKey` in flat pools. */
pub saveModuleEnv := fn(moduleKey: String, locals: List<Local>, functions: List<FunctionInfo>,
functionParams: List<String>, aliases: List<AliasDecl>, futureValues: List<FutureValue>, rootAssigned: List<String>): Unit {
    lStart := envLocalsPool.length();
    loop locals as l { mut envLocalsPool.pushBack(l); }
    lCount := envLocalsPool.length() - lStart;

    fStart := envFunctionsPool.length();
    loop functions as f { mut envFunctionsPool.pushBack(f); }
    fCount := envFunctionsPool.length() - fStart;

    pStart := envFnParamsPool.length();
    loop functionParams as p { mut envFnParamsPool.pushBack(p); }
    pCount := envFnParamsPool.length() - pStart;

    aStart := envAliasesPool.length();
    loop aliases as a { mut envAliasesPool.pushBack(a); }
    aCount := envAliasesPool.length() - aStart;

    fvStart := envFuturesPool.length();
    loop futureValues as fv { mut envFuturesPool.pushBack(fv); }
    fvCount := envFuturesPool.length() - fvStart;

    rStart := envAssignedPool.length();
    loop rootAssigned as ra { mut envAssignedPool.pushBack(ra); }
    rCount := envAssignedPool.length() - rStart;

    rng: ModuleEnvRange = (
        moduleKey = moduleKey,
        localsStart = lStart, localsCount = lCount,
        fnsStart = fStart, fnsCount = fCount,
        paramsStart = pStart, paramsCount = pCount,
        aliasesStart = aStart, aliasesCount = aCount,
        futuresStart = fvStart, futuresCount = fvCount,
        assignedStart = rStart, assignedCount = rCount
    );
    existing := moduleEnvByKey.getOr(moduleKey, -1);
    if existing >= 0 {
        envRanges[existing] = rng;
        return;
    }
    idx := envRanges.length();
    mut envRanges.pushBack(rng);
    mut moduleEnvByKey.set(moduleKey, idx);
};

/** Returns the index of the saved `ModuleEnvRange` for `moduleKey`, or -1. */
pub findModuleEnv := fn(moduleKey: String): Int {
    moduleEnvByKey.getOr(moduleKey, -1)
};

/** Returns the `ModuleEnvRange` at `idx`. */
pub getModuleEnvRange := fn(idx: Int): ModuleEnvRange {
    envRanges[idx]
};

/** Returns pooled `Local` at `poolIdx`. */
pub getEnvLocal := fn(poolIdx: Int): Local { envLocalsPool[poolIdx] };

/** Returns pooled `FunctionInfo` at `poolIdx`. */
pub getEnvFunction := fn(poolIdx: Int): FunctionInfo { envFunctionsPool[poolIdx] };

/** Returns pooled function parameter entry at `poolIdx`. */
pub getEnvFnParam := fn(poolIdx: Int): String { envFnParamsPool[poolIdx] };

/** Returns pooled `AliasDecl` at `poolIdx`. */
pub getEnvAlias := fn(poolIdx: Int): AliasDecl { envAliasesPool[poolIdx] };

/** Returns pooled `FutureValue` at `poolIdx`. */
pub getEnvFuture := fn(poolIdx: Int): FutureValue { envFuturesPool[poolIdx] };

/** Returns pooled root-assigned name at `poolIdx`. */
pub getEnvAssigned := fn(poolIdx: Int): String { envAssignedPool[poolIdx] };

/** Splits a `|`-delimited parameter encoding into `count` entries. */
pub splitPipeEntries := fn(encoded: String, count: Int): List<String> {
    out: mut List<String> = [];
    if count <= 0 { return out; }
    size := encoded.length();
    var start := 0;
    loop start <= size {
        bar := encoded.indexOf("|", start);
        end := if bar < 0 { size } else { bar };
        mut out.pushBack(encoded.slice(start, end));
        if bar < 0 { break; }
        start = bar + 1;
    }
    out
};

/** Splits a comma-separated comptime parameter list (`"T,N=Int"`) into parameter names. */
pub splitGenericParams := fn(genericParams: String): List<String> {
    types.splitCommaNames(genericParams)
};

/** True when `name` matches any comptime parameter name (`Type` or value) in `genericParams`. */
pub isGenericParam := fn(genericParams: String, name: String): Bool {
    types.isAnyParamName(genericParams, name)
};

/** Deterministic collision-resistant hash token of `text` for TS/C11-safe identifier mangling. */
hashHex32 := fn(text: String): String {
    table := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_():,;<>#[]!@$-./=|";
    var h1 := 5381;
    var h2 := 216613626;
    size := text.length();
    var i := 0;
    loop i < size {
        ch := text.at(i);
        idx := table.indexOf(ch, 0);
        v := if idx >= 0 { idx + 1 } else { 97 + ch.codePointAt(0) };
        h1 = (h1 * 131 + v) % 1000000007;
        h2 = (h2 * 137 + v) % 1000000009;
        i = i + 1;
    }
    h1.toText() + "_" + h2.toText()
};

/** Produces a readable, TS/C11-safe deterministic mangled token for one concrete canonical type kind. */
mangleOneKind := fn(kind: String): String {
    if numeric.isNumericKind(kind) or kind == ir.VALUE_KIND_STRING or
    kind == ir.VALUE_KIND_BOOL or kind == ir.VALUE_KIND_UNIT {
        return kind;
    }
    if types.isListKind(kind) {
        return "L_" + self(types.listElementKind(kind)) + "_E";
    }
    if types.isSetKind(kind) {
        return "S_" + self(types.setElementKind(kind)) + "_E";
    }
    if types.isRcKind(kind) {
        return "R_" + self(types.rcElementKind(kind)) + "_E";
    }
    if types.isSliceKind(kind) {
        return "Sl_" + self(types.sliceElementKind(kind)) + "_E";
    }
    if types.isSimdKind(kind) {
        return "D_" + self(types.simdElementKind(kind)) + "_" + types.simdLaneCountText(kind) + "_E";
    }
    if types.isSimdNativeKind(kind) {
        return "Dn_" + self(types.simdNativeElementKind(kind)) + "_E";
    }
    if types.isSoaKind(kind) {
        return "O_" + self(types.soaRecordKind(kind)) + "_E";
    }
    if types.isDynKind(kind) {
        return "Y_" + hashHex32(types.dynInterfaceKind(kind)) + "_E";
    }
    if types.isInterfaceKind(kind) {
        return "I_" + hashHex32(kind) + "_E";
    }
    if types.isMapKind(kind) {
        return "M_" + self(types.mapKeyKind(kind)) + "_" + self(types.mapValueKind(kind)) + "_E";
    }
    if types.isComptimeIntToken(kind) {
        v := types.comptimeIntValue(kind);
        return if v == -9223372036854775808 { "VI_min" } else if v < 0 { "VI_n" + (0 - v).toText() } else { "VI_" + v.toText() };
    }
    if types.isComptimeBoolToken(kind) {
        return if types.comptimeBoolValue(kind) { "VB_1" } else { "VB_0" };
    }
    if types.isComptimeStringToken(kind) {
        return "VS_" + hashHex32(kind);
    }
    if types.isComptimeEnumToken(kind) {
        return "VE_" + hashHex32(kind);
    }
    if types.isArrayKind(kind) {
        ext := types.arrayExtent(kind);
        extPart := if ext > 0 { ext.toText() } else { "w" };
        return "A" + extPart + "_" + self(types.arrayElementKind(kind)) + "_E";
    }
    "K_" + hashHex32(kind)
};

/** Encodes `bindings` in `genericParams` declaration order as `T=Int|U=String`. */
pub encodeBindings := fn(genericParams: String, bindings: Map<String, String>): String {
    parts: mut List<String> = [];
    loop splitGenericParams(genericParams) as p {
        mut parts.pushBack(p + "=" + bindings.getOr(p, ""));
    }
    parts.join("|")
};

/** Encodes only currently bound entries of `bindings` in `genericParams` order as `T=Int`. */
pub encodePartialBindings := fn(genericParams: String, bindings: Map<String, String>): String {
    parts: mut List<String> = [];
    loop splitGenericParams(genericParams) as p {
        if bindings.has(p) {
            mut parts.pushBack(p + "=" + bindings.getOr(p, ""));
        }
    }
    parts.join("|")
};

/** Decodes `"T=Int|U=String"` into a list of `(name, kind)` pairs. */
pub decodeBindings := fn(bindingsEncoded: String): List<(name: String, kind: String)> {
    out: mut List<(name: String, kind: String)> = [];
    size := bindingsEncoded.length();
    if size == 0 { return out; }
    var start := 0;
    loop start <= size {
        bar := bindingsEncoded.indexOf("|", start);
        end := if bar < 0 { size } else { bar };
        entry := bindingsEncoded.slice(start, end);
        eq := entry.indexOf("=", 0);
        if eq > 0 {
            mut out.pushBack((name = entry.slice(0, eq), kind = entry.slice(eq + 1, entry.length())));
        }
        if bar < 0 { break; }
        start = bar + 1;
    }
    out
};

/** Builds a TS/C11-safe deterministic suffix for encoded generic bindings. */
mangleBindings := fn(bindingsEncoded: String): String {
    parts: mut List<String> = [];
    loop decodeBindings(bindingsEncoded) as b {
        mut parts.pushBack(mangleOneKind(b.kind));
    }
    joined := parts.join("__");
    if joined.length() > 64 {
        return "H_" + hashHex32(bindingsEncoded);
    }
    joined
};

/** Requests (or reuses cached) concrete monomorphization of `templateKey` for `bindingsEncoded`, returning its target runtime name. */
pub requestInstance := fn(target: String, templateKey: String, bindingsEncoded: String, substParams: String, substResult: String): String {
    cacheKey := templateKey + "|" + bindingsEncoded;
    existing := instanceByKey.getOr(cacheKey, -1);
    if existing >= 0 {
        return instances[existing].runtime;
    }
    tplIdx := findTemplate(templateKey);
    tpl := templates[tplIdx];
    mangled := mangleBindings(bindingsEncoded);
    instRuntime := ir.moduleFunctionRuntime(target, tpl.moduleKey, tpl.qualName + "__G_" + mangled);
    idx := instances.length();
    mut instances.pushBack((
        templateKey = templateKey,
        bindingsEncoded = bindingsEncoded,
        substParams = substParams,
        substResult = substResult,
        runtime = instRuntime,
        moduleKey = tpl.moduleKey,
        compiled = false
    ));
    mut instanceByKey.set(cacheKey, idx);
    instRuntime
};

/** Returns the index of the next uncompiled `GenericInstance`, or -1 when the queue is drained. */
pub nextUncompiledInstanceIndex := fn(): Int {
    var i := 0;
    n := instances.length();
    loop i < n {
        if not instances[i].compiled { return i; }
        i = i + 1;
    }
    -1
};

/** Returns the `GenericInstance` at `idx`. */
pub getInstance := fn(idx: Int): GenericInstance {
    instances[idx]
};

/** Marks the `GenericInstance` at `idx` as compiled. */
pub markInstanceCompiled := fn(idx: Int): Unit {
    cur := instances[idx];
    instances[idx] = (
        templateKey = cur.templateKey,
        bindingsEncoded = cur.bindingsEncoded,
        substParams = cur.substParams,
        substResult = cur.substResult,
        runtime = cur.runtime,
        moduleKey = cur.moduleKey,
        compiled = true
    );
};

/** True when `kind` still contains any unbound generic type parameter from `genericParams`. */
pub kindHasUnboundGeneric := fn(genericParams: String, kind: String, bindings: Map<String, String>): Bool {
    if isGenericParam(genericParams, kind) {
        return not bindings.has(kind);
    }
    if types.isListKind(kind) {
        return self(genericParams, types.listElementKind(kind), bindings);
    }
    if types.isSetKind(kind) {
        return self(genericParams, types.setElementKind(kind), bindings);
    }
    if types.isRcKind(kind) {
        return self(genericParams, types.rcElementKind(kind), bindings);
    }
    if types.isSliceKind(kind) {
        return self(genericParams, types.sliceElementKind(kind), bindings);
    }
    if types.isSimdKind(kind) {
        nTxt := types.simdLaneCountText(kind);
        if types.valueParamKind(genericParams, nTxt) =!= "" and not bindings.has(nTxt) {
            return true;
        }
        return self(genericParams, types.simdElementKind(kind), bindings);
    }
    if types.isSimdNativeKind(kind) {
        return self(genericParams, types.simdNativeElementKind(kind), bindings);
    }
    if types.isSoaKind(kind) {
        return self(genericParams, types.soaRecordKind(kind), bindings);
    }
    if types.isDynKind(kind) {
        return self(genericParams, types.dynInterfaceKind(kind), bindings);
    }
    if types.isInterfaceKind(kind) {
        loop types.ifaceArgsOf(kind) as ia {
            if self(genericParams, ia, bindings) { return true; }
        }
        return false;
    }
    if types.isMapKind(kind) {
        return self(genericParams, types.mapKeyKind(kind), bindings) or self(genericParams, types.mapValueKind(kind), bindings);
    }
    if types.isArrayKind(kind) {
        pExtText := types.arrayExtentText(kind);
        if types.valueParamKind(genericParams, pExtText) =!= "" and not bindings.has(pExtText) {
            return true;
        }
        return self(genericParams, types.arrayElementKind(kind), bindings);
    }
    if types.isTupleKind(kind) {
        n := types.tupleComponentCount(kind);
        var i := 0;
        loop i < n {
            if self(genericParams, types.tupleComponent(kind, i).kind, bindings) { return true; }
            i = i + 1;
        }
        return false;
    }
    if types.isFnKind(kind) {
        n := types.fnParamCount(kind);
        var i := 0;
        loop i < n {
            if self(genericParams, types.fnParamComponent(kind, i).kind, bindings) { return true; }
            i = i + 1;
        }
        return self(genericParams, types.fnResultKind(kind), bindings);
    }
    nomArgs := types.nominalTypeArgs(kind);
    loop nomArgs as na {
        if self(genericParams, na, bindings) { return true; }
    }
    if types.isRecordKind(kind) {
        fc := types.recordComponentCount(kind);
        var fi := 0;
        loop fi < fc {
            if self(genericParams, types.recordComponent(kind, fi).kind, bindings) { return true; }
            fi = fi + 1;
        }
    } else if types.isDistinctKind(kind) {
        return self(genericParams, types.distinctUnderlyingKind(kind), bindings);
    }
    false
};

/** Substitutes bound generic parameters from `bindings` into canonical `pattern`. */
pub substKind := fn(genericParams: String, pattern: String, bindings: Map<String, String>): String {
    types.substCanonicalKind(genericParams, pattern, bindings)
};

/** Substitutes `bindings` into `pattern` to produce an expected-type hint for parsing an argument (returns `""` if still partially generic, or `fn(...):$InferRet` when only a callback's return type is unbound). */
pub substKindForExpected := fn(genericParams: String, pattern: String, bindings: Map<String, String>): String {
    if not kindHasUnboundGeneric(genericParams, pattern, bindings) {
        return substKind(genericParams, pattern, bindings);
    }
    if types.isListKind(pattern) {
        return "$ListAny";
    }
    if types.isFnKind(pattern) {
        n := types.fnParamCount(pattern);
        parts: mut List<String> = [];
        var i := 0;
        loop i < n {
            comp := types.fnParamComponent(pattern, i);
            if kindHasUnboundGeneric(genericParams, comp.kind, bindings) {
                return "";
            }
            (mut parts).pushBack(comp.label + ":" + substKind(genericParams, comp.kind, bindings));
            i = i + 1;
        }
        rawRet := types.fnResultKind(pattern);
        retHint := if kindHasUnboundGeneric(genericParams, rawRet, bindings) {
            "$InferRet"
        } else {
            substKind(genericParams, rawRet, bindings)
        };
        return "fn(" + parts.join(",") + "):" + retHint;
    }
    ""
};

/** Recursively unifies generic `pattern` against concrete `actual`, updating `bindings` in place and returning `""` on success or an error message. */
pub unifyKindMut := fn(genericParams: String, pattern: String, actual: String, bindings: mut Map<String, String>): String {
    if actual == ir.VALUE_KIND_NEVER { return ""; }
    if isGenericParam(genericParams, pattern) {
        if types.valueParamKind(genericParams, pattern) =!= "" {
            if not types.isComptimeValueToken(actual) and not types.isAnyParamName(genericParams, actual) {
                return "expected comptime value for " + pattern + ", got " + types.displayKind(actual);
            }
            if bindings.has(pattern) {
                existing := bindings.getOr(pattern, "");
                if existing =!= actual {
                    return "conflicting comptime value bindings for " + pattern + ": " + types.displayKind(existing) + " vs " + types.displayKind(actual);
                }
                return "";
            }
            (mut bindings).set(pattern, actual);
            return "";
        }
        if bindings.has(pattern) {
            existing := bindings.getOr(pattern, "");
            if not types.isCompatibleKind(existing, actual) {
                return "conflicting type bindings for " + pattern + ": " + types.displayKind(existing) + " vs " + types.displayKind(actual);
            }
            return "";
        }
        (mut bindings).set(pattern, actual);
        return "";
    }
    if types.isListKind(pattern) {
        if not types.isListKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.listElementKind(pattern), types.listElementKind(actual), mut bindings);
    }
    if types.isSetKind(pattern) {
        if not types.isSetKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.setElementKind(pattern), types.setElementKind(actual), mut bindings);
    }
    if types.isRcKind(pattern) {
        if not types.isRcKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.rcElementKind(pattern), types.rcElementKind(actual), mut bindings);
    }
    if types.isSliceKind(pattern) {
        if not types.isSliceKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.sliceElementKind(pattern), types.sliceElementKind(actual), mut bindings);
    }
    if types.isSimdKind(pattern) {
        if not types.isSimdKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        pLanesText := types.simdLaneCountText(pattern);
        aLanes := types.simdLaneCount(actual);
        if types.valueParamKind(genericParams, pLanesText) == ir.VALUE_KIND_INT {
            if aLanes <= 1 {
                return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
            }
            laneTok := types.comptimeIntToken(aLanes);
            if bindings.has(pLanesText) {
                existingLanes := bindings.getOr(pLanesText, "");
                if existingLanes =!= laneTok {
                    return "conflicting bindings for " + pLanesText + ": " + types.displayKind(existingLanes) + " vs " + types.displayKind(laneTok);
                }
            } else {
                (mut bindings).set(pLanesText, laneTok);
            }
        } else if types.simdLaneCount(pattern) =!= aLanes {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.simdElementKind(pattern), types.simdElementKind(actual), mut bindings);
    }
    if types.isSimdNativeKind(pattern) {
        if not types.isSimdKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        elAct := types.simdElementKind(actual);
        if not types.isSimdElemKind(elAct) or types.simdLaneCount(actual) =!= types.simdNativeLaneCount(elAct) {
            return "expected SimdNative<" + types.simdNativeElementKind(pattern) + ">, got " + types.displayKind(actual);
        }
        return self(genericParams, types.simdNativeElementKind(pattern), elAct, mut bindings);
    }
    if types.isSoaKind(pattern) {
        if not types.isSoaKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.soaRecordKind(pattern), types.soaRecordKind(actual), mut bindings);
    }
    if types.isDynKind(pattern) {
        if not types.isDynKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.dynInterfaceKind(pattern), types.dynInterfaceKind(actual), mut bindings);
    }
    if types.isInterfaceKind(pattern) {
        if not types.isInterfaceKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        if types.ifaceKeyOf(pattern) =!= types.ifaceKeyOf(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        pIArgs := types.ifaceArgsOf(pattern);
        aIArgs := types.ifaceArgsOf(actual);
        if pIArgs.length() =!= aIArgs.length() {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        var ii := 0;
        loop ii < pIArgs.length() {
            iErr := self(genericParams, pIArgs[ii], aIArgs[ii], mut bindings);
            if iErr =!= "" { return iErr; }
            ii = ii + 1;
        }
        return "";
    }
    if types.isMapKind(pattern) {
        if not types.isMapKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        kErr := self(genericParams, types.mapKeyKind(pattern), types.mapKeyKind(actual), mut bindings);
        if kErr =!= "" { return kErr; }
        return self(genericParams, types.mapValueKind(pattern), types.mapValueKind(actual), mut bindings);
    }
    if types.isArrayKind(pattern) {
        if not types.isArrayKind(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        pExtText := types.arrayExtentText(pattern);
        if pExtText == "*" {
            /* wildcard extent accepts any fixed or wildcard array */
        } else if types.valueParamKind(genericParams, pExtText) == ir.VALUE_KIND_INT {
            aExt := types.arrayExtent(actual);
            if aExt <= 0 {
                return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
            }
            extTok := types.comptimeIntToken(aExt);
            if bindings.has(pExtText) {
                existingExt := bindings.getOr(pExtText, "");
                if existingExt =!= extTok {
                    return "conflicting bindings for " + pExtText + ": " + types.displayKind(existingExt) + " vs " + types.displayKind(extTok);
                }
            } else {
                (mut bindings).set(pExtText, extTok);
            }
        } else if types.arrayExtent(pattern) =!= types.arrayExtent(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        return self(genericParams, types.arrayElementKind(pattern), types.arrayElementKind(actual), mut bindings);
    }
    if types.isTupleKind(pattern) {
        if not types.isTupleKind(actual) or types.tupleComponentCount(pattern) =!= types.tupleComponentCount(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        n := types.tupleComponentCount(pattern);
        var i := 0;
        loop i < n {
            pc := types.tupleComponent(pattern, i);
            ac := types.tupleComponent(actual, i);
            if pc.label =!= ac.label {
                return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
            }
            cErr := self(genericParams, pc.kind, ac.kind, mut bindings);
            if cErr =!= "" { return cErr; }
            i = i + 1;
        }
        return "";
    }
    if types.isFnKind(pattern) {
        if not types.isFnKind(actual) or types.fnParamCount(pattern) =!= types.fnParamCount(actual) {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        n := types.fnParamCount(pattern);
        var i := 0;
        loop i < n {
            pErr := self(genericParams, types.fnParamComponent(pattern, i).kind, types.fnParamComponent(actual, i).kind, mut bindings);
            if pErr =!= "" { return pErr; }
            i = i + 1;
        }
        return self(genericParams, types.fnResultKind(pattern), types.fnResultKind(actual), mut bindings);
    }
    pArgs := types.nominalTypeArgs(pattern);
    if pArgs.length() > 0 {
        pOwner := types.typeOpOwnerKey(pattern);
        aOwner := types.typeOpOwnerKey(actual);
        aArgs := types.nominalTypeArgs(actual);
        if pOwner =!= aOwner or pArgs.length() =!= aArgs.length() {
            return "expected " + types.displayKind(substKind(genericParams, pattern, bindings)) + ", got " + types.displayKind(actual);
        }
        var ai := 0;
        loop ai < pArgs.length() {
            aErr := self(genericParams, pArgs[ai], aArgs[ai], mut bindings);
            if aErr =!= "" { return aErr; }
            ai = ai + 1;
        }
        return "";
    }
    if not types.isCompatibleKind(pattern, actual) {
        return "expected " + types.displayKind(pattern) + ", got " + types.displayKind(actual);
    }
    ""
};

/** Validates map key / set element / nested collection constraints across a substituted concrete type, returning `""` if valid. */
pub validateSubstitutedKind := fn(kind: String): String {
    types.validateCanonicalKind(kind, "")
};
