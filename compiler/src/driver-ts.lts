frontend := import "./frontend.lts";
modules := import "./modules.lts";
emitter := import "./emit-ts.lts";
io := import "core/io";

/** Runs the TypeScript compiler entry after its graph dependencies are loaded. */
pub run := fn(): Unit {
    prefix := frontend.sourcePrefix();
    source := io.inputAll();
    if frontend.sourceModulePath() =!= "" {
        graph := modules.visitSourceModule(target = "ts", path = frontend.sourceModulePath(), display = prefix,
            identity = frontend.sourceModuleIdentity(), =source, initialGraph = []);
        emitter.emitProgram(items = modules.moduleItems(graph), =source, =prefix);
    } else {
        emitter.emitProgram(items = frontend.parseProgram(target = "ts", =source, =prefix), =source, =prefix);
    }
}
