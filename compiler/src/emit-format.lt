/** Shared token-aware structured formatter for emitted TypeScript and C11 target code. */

tb := import "util/text-builder";

/** True when `name` is a clean ASCII target identifier that cannot collide with JS/TS/C keywords or standard headers. */
pub isSafeTargetIdent := fn(name: String, isC: Bool): Bool {
    n := name.length();
    if n == 0 or n > 48 { return false; }
    var i := 0;
    loop i < n {
        ch := name.at(i);
        if i == 0 and not ch.isNameStart() { return false; }
        if not ch.isNameContinue() { return false; }
        i = i + 1;
    }
    if name.startsWithAt(0, "_") or name.startsWithAt(0, "lite") or name.startsWithAt(0, "lt_") {
        return false;
    }
    sharedBlocked := "|break|case|catch|class|const|continue|debugger|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|let|new|null|return|super|switch|this|throw|true|try|typeof|undefined|var|void|while|with|yield|await|async|implements|interface|package|private|protected|public|static|arguments|eval|main|status|out|emit|write|string|number|boolean|bigint|symbol|object|any|unknown|never|type|as|from|of|";
    if sharedBlocked.indexOf("|" + name + "|", 0) >= 0 { return false; }
    if isC {
        cBlocked := "|auto|char|double|extern|float|goto|int|long|register|restrict|short|signed|sizeof|struct|typedef|union|unsigned|volatile|inline|bool|FILE|EOF|NULL|errno|stdin|stdout|stderr|argc|argv|index|rindex|time|sin|cos|tan|log|exp|pow|sqrt|abs|labs|div|ldiv|exit|free|malloc|calloc|realloc|read|write|open|close|stat|link|unlink|pipe|fork|wait|exec|kill|signal|printf|fprintf|sprintf|snprintf|puts|fputs|strlen|strcmp|strcpy|memcpy|memmove|memset|strtod|strtof|strtoll|";
        if cBlocked.indexOf("|" + name + "|", 0) >= 0 { return false; }
    }
    true
};

/** Returns `n` spaces for 4-space indentation levels. */
indentSpaces := fn(level: Int): String {
    out: mut tb.TextBuilder;
    var i := 0;
    loop i < level {
        mut out.append("    ");
        i = i + 1;
    }
    out.build()
};

/** Skips a quoted string or char literal starting at `start`, returning index after closing quote. */
skipQuoted := fn(s: String, start: Int): Int {
    n := s.length();
    quote := s.at(start);
    var i := start + 1;
    loop i < n {
        ch := s.at(i);
        if ch == "\\" {
            i = i + 2;
        } else if ch == quote {
            return i + 1;
        } else {
            i = i + 1;
        }
    }
    n
};

/** Skips a C/TS block comment starting at `/*`, returning index after `*/`. */
skipBlockComment := fn(s: String, start: Int): Int {
    endPos := s.indexOf("*/", start + 2);
    if endPos < 0 { s.length() } else { endPos + 2 }
};

/** True when `code` mentions identifier `ident` as a standalone token outside quoted strings and `.prop`/`->prop` accesses. */
pub codeUsesIdent := fn(code: String, ident: String): Bool {
    if code == "" or ident == "" { return false; }
    if code.indexOf(ident, 0) < 0 { return false; }
    n := code.length();
    m := ident.length();
    var i := 0;
    loop i < n {
        ch := code.at(i);
        if ch == "\"" or ch == "'" or ch == "`" {
            i = skipQuoted(code, i);
            continue;
        }
        if code.startsWithAt(i, ident) {
            beforeOk := i == 0 or (
            not code.at(i - 1).isNameContinue() and
            code.at(i - 1) =!= "$" and
            code.at(i - 1) =!= "." and
            not (i >= 2 and code.at(i - 2) == "-" and code.at(i - 1) == ">")
            );
            afterPos := i + m;
            afterOk := afterPos >= n or (
            not code.at(afterPos).isNameContinue() and
            code.at(afterPos) =!= "$"
            );
            if beforeOk and afterOk { return true; }
        }
        i = i + 1;
    }
    false
};

/** Replaces every standalone identifier occurrence of `ident` with `replacement`, skipping quoted strings and `.prop`/`->prop` accesses. */
pub replaceIdentToken := fn(code: String, ident: String, replacement: String): String {
    if code == "" or ident == "" or ident == replacement { return code; }
    if code.indexOf(ident, 0) < 0 { return code; }
    n := code.length();
    m := ident.length();
    out: mut tb.TextBuilder;
    var flushed := 0;
    var i := 0;
    loop i < n {
        ch := code.at(i);
        if ch == "\"" or ch == "'" or ch == "`" {
            i = skipQuoted(code, i);
            continue;
        }
        if code.startsWithAt(i, ident) {
            beforeOk := i == 0 or (
            not code.at(i - 1).isNameContinue() and
            code.at(i - 1) =!= "$" and
            code.at(i - 1) =!= "." and
            not (i >= 2 and code.at(i - 2) == "-" and code.at(i - 1) == ">")
            );
            afterPos := i + m;
            afterOk := afterPos >= n or (
            not code.at(afterPos).isNameContinue() and
            code.at(afterPos) =!= "$"
            );
            if beforeOk and afterOk {
                if i > flushed { mut out.append(code.slice(flushed, i)); }
                mut out.append(replacement);
                i = afterPos;
                flushed = i;
                continue;
            }
        }
        i = i + 1;
    }
    if flushed == 0 { return code; }
    if flushed < n { mut out.append(code.slice(flushed, n)); }
    out.build()
};

/** Finds the first `;` at or after `start` outside quotes, comments, and balanced `()`/`[]`/`{}`, or -1 when absent. */
pub findTopLevelSemi := fn(s: String, start: Int): Int {
    n := s.length();
    var pDepth := 0;
    var bDepth := 0;
    var kDepth := 0;
    var i := start;
    loop i < n {
        ch := s.at(i);
        if ch == "\"" or ch == "'" or ch == "`" {
            i = skipQuoted(s, i);
        } else if ch == "/" and i + 1 < n and s.at(i + 1) == "*" {
            i = skipBlockComment(s, i);
        } else if ch == "(" {
            pDepth = pDepth + 1;
            i = i + 1;
        } else if ch == ")" {
            if pDepth > 0 { pDepth = pDepth - 1; }
            i = i + 1;
        } else if ch == "[" {
            kDepth = kDepth + 1;
            i = i + 1;
        } else if ch == "]" {
            if kDepth > 0 { kDepth = kDepth - 1; }
            i = i + 1;
        } else if ch == "{" {
            bDepth = bDepth + 1;
            i = i + 1;
        } else if ch == "}" {
            if bDepth > 0 { bDepth = bDepth - 1; }
            i = i + 1;
        } else if ch == ";" and pDepth == 0 and bDepth == 0 and kDepth == 0 {
            return i;
        } else {
            i = i + 1;
        }
    }
    -1
};

/** True when `stmt` is a single self-contained `for (...) { ... }`, `while (...) { ... }`, or `{ ... }` block statement that cannot leak declarations. */
pub isSingleScopedLoopStmt := fn(stmt: String): Bool {
    trimmed := stmt.trim();
    n := trimmed.length();
    var braceStart := -1;
    if trimmed.startsWithAt(0, "{") {
        braceStart = 0;
    } else if trimmed.startsWithAt(0, "for (") or trimmed.startsWithAt(0, "while (") {
        openParen := trimmed.indexOf("(", 0);
        var pDepth := 1;
        var p := openParen + 1;
        loop p < n and pDepth > 0 {
            ch := trimmed.at(p);
            if ch == "\"" or ch == "'" or ch == "`" {
                p = skipQuoted(trimmed, p);
            } else if ch == "/" and p + 1 < n and trimmed.at(p + 1) == "*" {
                p = skipBlockComment(trimmed, p);
            } else if ch == "(" {
                pDepth = pDepth + 1;
                p = p + 1;
            } else if ch == ")" {
                pDepth = pDepth - 1;
                p = p + 1;
            } else {
                p = p + 1;
            }
        }
        if pDepth =!= 0 { return false; }
        loop p < n and (trimmed.at(p) == " " or trimmed.at(p) == "\t") { p = p + 1; }
        if p >= n or trimmed.at(p) =!= "{" { return false; }
        braceStart = p;
    } else {
        return false;
    }
    var bDepth := 1;
    var i := braceStart + 1;
    loop i < n and bDepth > 0 {
        ch := trimmed.at(i);
        if ch == "\"" or ch == "'" or ch == "`" {
            i = skipQuoted(trimmed, i);
        } else if ch == "/" and i + 1 < n and trimmed.at(i + 1) == "*" {
            i = skipBlockComment(trimmed, i);
        } else if ch == "{" {
            bDepth = bDepth + 1;
            i = i + 1;
        } else if ch == "}" {
            bDepth = bDepth - 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    bDepth == 0 and i == n
};

/** True when `s[bracePos]` (`{`) opens a statement block rather than a data/type/struct literal. */
isStatementBlockOpen := fn(s: String, bracePos: Int): Bool {
    n := s.length();
    /* Scan ahead at brace depth 1 to see if this brace contains a top-level `;` or is an empty block after control syntax. */
    var p := bracePos - 1;
    loop p >= 0 and (s.at(p) == " " or s.at(p) == "\t") { p = p - 1; }
    prevCh := if p >= 0 { s.at(p) } else { "" };
    /* Data literals immediately follow `=`, `,`, `(`, `[`, `?`, or C compound literal `(Type){`. */
    if prevCh == "=" or prevCh == "," or prevCh == "(" or prevCh == "[" or prevCh == "?" {
        return false;
    }
    /* Check if preceded by a keyword or control header (`else`, `try`, `do`, `finally`, `=>`, `)`). */
    afterWord := prevCh == ")" or prevCh == ";" or prevCh == "{" or prevCh == "" or
    (prevCh == ">" and p > 0 and s.at(p - 1) == "=");
    var isCtrlKw := false;
    var headerKw := "";
    if p >= 0 and prevCh.isNameContinue() {
        var wStart := p;
        loop wStart > 0 and s.at(wStart - 1).isNameContinue() { wStart = wStart - 1; }
        word := s.slice(wStart, p + 1);
        headerKw = word;
        isCtrlKw = word == "else" or word == "try" or word == "do" or word == "finally";
    }
    if not afterWord and not isCtrlKw {
        return false;
    }
    /* For `)` distinguish `if/for/while/catch/switch (...) {` from C compound literal `(Type){ .f = 1 }`. */
    if prevCh == ")" {
        var depth := 1;
        var q := p - 1;
        loop q >= 0 and depth > 0 {
            c := s.at(q);
            if c == ")" { depth = depth + 1; }
            else if c == "(" { depth = depth - 1; }
            q = q - 1;
        }
        loop q >= 0 and (s.at(q) == " " or s.at(q) == "\t") { q = q - 1; }
        if q < 0 or not s.at(q).isNameContinue() {
            return false;
        }
        var kwStart := q;
        loop kwStart > 0 and s.at(kwStart - 1).isNameContinue() { kwStart = kwStart - 1; }
        kw := s.slice(kwStart, q + 1);
        headerKw = kw;
        if kw =!= "for" and kw =!= "while" and kw =!= "if" and kw =!= "catch" and kw =!= "switch" {
            return false;
        }
    }
    /* Verify the matching `}` exists on this line and the body is either empty or statement-oriented (has `;` or nested `{`). */
    var bDepth := 1;
    var pDepth := 0;
    var semiCount := 0;
    var hasNestedBrace := false;
    var hasNonSpace := false;
    var k := bracePos + 1;
    loop k < n and bDepth > 0 {
        c := s.at(k);
        if c == "\"" or c == "'" or c == "`" {
            hasNonSpace = true;
            k = skipQuoted(s, k);
        } else if c == "/" and k + 1 < n and s.at(k + 1) == "*" {
            k = skipBlockComment(s, k);
        } else if c == "(" {
            hasNonSpace = true;
            pDepth = pDepth + 1;
            k = k + 1;
        } else if c == ")" {
            if pDepth > 0 { pDepth = pDepth - 1; }
            k = k + 1;
        } else if c == "{" {
            hasNonSpace = true;
            if bDepth == 1 and pDepth == 0 { hasNestedBrace = true; }
            bDepth = bDepth + 1;
            k = k + 1;
        } else if c == "}" {
            bDepth = bDepth - 1;
            k = k + 1;
        } else if c == ";" {
            hasNonSpace = true;
            if bDepth == 1 and pDepth == 0 { semiCount = semiCount + 1; }
            k = k + 1;
        } else {
            if c =!= " " and c =!= "\t" { hasNonSpace = true; }
            k = k + 1;
        }
    }
    if bDepth =!= 0 { return false; }
    /* Keep short single-statement `if (...) { stmt; }` concise on one line when there is no nested block or trailing clause. */
    if headerKw == "if" and not hasNestedBrace and semiCount == 1 and k == n and n <= 96 {
        return false;
    }
    /* Keep empty arrow bodies `() => {}` inline. */
    if prevCh == ">" and p > 0 and s.at(p - 1) == "=" {
        return semiCount > 0 or hasNestedBrace;
    }
    semiCount > 0 or hasNestedBrace or not hasNonSpace
};

/** True when `s[pos]` is preceded (skipping spaces/tabs) by `=>`. */
isPrecededByArrow := fn(s: String, pos: Int): Bool {
    var p := pos - 1;
    loop p >= 0 and (s.at(p) == " " or s.at(p) == "\t") { p = p - 1; }
    p > 0 and s.at(p) == ">" and s.at(p - 1) == "="
};

/** Expands a single-line lowered statement containing inline statement blocks (`for (...) { ... }`, `(() => { ... })()`, etc.) into 4-space indented lines. */
pub formatEmittedLine := fn(rawLine: String): String {
    if rawLine.indexOf("{", 0) < 0 { return rawLine; }
    trimmed := rawLine.trimStart();
    if trimmed == "" or trimmed.startsWithAt(0, "#") or trimmed.startsWithAt(0, "//") or trimmed.startsWithAt(0, "/*") {
        return rawLine;
    }
    /* Fast path: already a normal block header (`if (...) {`) or single-line without inline body statements. */
    hasInline := trimmed.indexOf("; ", 0) >= 0 or trimmed.indexOf("{ ", 0) >= 0 or trimmed.indexOf(" }", 0) >= 0;
    if not hasInline { return rawLine; }

    baseSpaces := rawLine.length() - trimmed.length();
    baseIndent := rawLine.slice(0, baseSpaces);
    n := trimmed.length();
    out: mut tb.TextBuilder;
    var blockDepth := 0;
    var parenDepth := 0;
    /* Parallel stacks for open `{`: braceKind (1 = expanded statement block, 0 = inline data/type brace) and parenDepth at open. */
    braceStack: mut List<Int> = [];
    braceParenStack: mut List<Int> = [];
    var i := 0;
    var atLineStart := true;
    var changed := false;

    loop i < n {
        ch := trimmed.at(i);
        if atLineStart {
            if ch == " " or ch == "\t" {
                i = i + 1;
                continue;
            }
            if ch == "}" and braceStack.length() > 0 and braceStack[braceStack.length() - 1] == 1 {
                _pop := mut braceStack.popBack();
                _popP := mut braceParenStack.popBack();
                if blockDepth > 0 { blockDepth = blockDepth - 1; }
                mut out.append(baseIndent + indentSpaces(blockDepth) + "}");
                i = i + 1;
                atLineStart = false;
                /* Check if `else` or `catch` or `finally` or `;` follows on same line. */
                var peek := i;
                loop peek < n and trimmed.at(peek) == " " { peek = peek + 1; }
                if peek < n and (trimmed.wordAt(peek, "else") or trimmed.wordAt(peek, "catch") or trimmed.wordAt(peek, "finally")) {
                    mut out.append(" ");
                    i = peek;
                } else if peek < n and (trimmed.at(peek) == ";" or trimmed.at(peek) == ")" or trimmed.at(peek) == ",") {
                    i = peek;
                } else if peek < n {
                    mut out.append("\n");
                    atLineStart = true;
                    i = peek;
                }
                continue;
            }
            mut out.append(baseIndent + indentSpaces(blockDepth));
            atLineStart = false;
        }
        if ch == "\"" or ch == "'" or ch == "`" {
            endQ := skipQuoted(trimmed, i);
            mut out.append(trimmed.slice(i, endQ));
            i = endQ;
        } else if ch == "/" and i + 1 < n and trimmed.at(i + 1) == "*" {
            endC := skipBlockComment(trimmed, i);
            mut out.append(trimmed.slice(i, endC));
            i = endC;
        } else if ch == "(" {
            parenDepth = parenDepth + 1;
            mut out.append("(");
            i = i + 1;
        } else if ch == ")" {
            if parenDepth > 0 { parenDepth = parenDepth - 1; }
            mut out.append(")");
            i = i + 1;
        } else if ch == "{" {
            topIdx := braceStack.length() - 1;
            inExpandedAtParen := topIdx >= 0 and braceStack[topIdx] == 1 and braceParenStack[topIdx] == parenDepth;
            canExpandHere := parenDepth == 0 or inExpandedAtParen or isPrecededByArrow(trimmed, i);
            expand := canExpandHere and isStatementBlockOpen(trimmed, i);
            if expand {
                /* Check for empty block `{  }`. */
                var nextNonWs := i + 1;
                loop nextNonWs < n and (trimmed.at(nextNonWs) == " " or trimmed.at(nextNonWs) == "\t") {
                    nextNonWs = nextNonWs + 1;
                }
                if nextNonWs < n and trimmed.at(nextNonWs) == "}" {
                    changed = true;
                    mut out.append("{\n" + baseIndent + indentSpaces(blockDepth) + "}");
                    i = nextNonWs + 1;
                    var afterEmpty := i;
                    loop afterEmpty < n and trimmed.at(afterEmpty) == " " { afterEmpty = afterEmpty + 1; }
                    if afterEmpty < n and (trimmed.wordAt(afterEmpty, "else") or trimmed.wordAt(afterEmpty, "catch") or trimmed.wordAt(afterEmpty, "finally")) {
                        mut out.append(" ");
                        i = afterEmpty;
                    } else if afterEmpty < n and (trimmed.at(afterEmpty) == ";" or trimmed.at(afterEmpty) == ")" or trimmed.at(afterEmpty) == ",") {
                        i = afterEmpty;
                    } else if afterEmpty < n {
                        mut out.append("\n");
                        atLineStart = true;
                        i = afterEmpty;
                    }
                } else {
                    changed = true;
                    mut braceStack.pushBack(1);
                    mut braceParenStack.pushBack(parenDepth);
                    blockDepth = blockDepth + 1;
                    mut out.append("{\n");
                    atLineStart = true;
                    i = nextNonWs;
                }
            } else {
                mut braceStack.pushBack(0);
                mut braceParenStack.pushBack(parenDepth);
                mut out.append("{");
                i = i + 1;
            }
        } else if ch == "}" {
            isExpanded := braceStack.length() > 0 and braceStack[braceStack.length() - 1] == 1;
            if braceStack.length() > 0 {
                _pop := mut braceStack.popBack();
                _popP := mut braceParenStack.popBack();
            }
            if isExpanded {
                changed = true;
                if blockDepth > 0 { blockDepth = blockDepth - 1; }
                mut out.append("\n" + baseIndent + indentSpaces(blockDepth) + "}");
                i = i + 1;
                var peek := i;
                loop peek < n and trimmed.at(peek) == " " { peek = peek + 1; }
                if peek < n and (trimmed.wordAt(peek, "else") or trimmed.wordAt(peek, "catch") or trimmed.wordAt(peek, "finally")) {
                    mut out.append(" ");
                    i = peek;
                } else if peek < n and (trimmed.at(peek) == ";" or trimmed.at(peek) == ")" or trimmed.at(peek) == ",") {
                    i = peek;
                } else if peek < n {
                    mut out.append("\n");
                    atLineStart = true;
                    i = peek;
                }
            } else {
                mut out.append("}");
                i = i + 1;
            }
        } else if ch == ";" and blockDepth > 0 and braceStack.length() > 0 and braceStack[braceStack.length() - 1] == 1 and parenDepth == braceParenStack[braceParenStack.length() - 1] {
            mut out.append(";");
            i = i + 1;
            var peek := i;
            loop peek < n and trimmed.at(peek) == " " { peek = peek + 1; }
            if peek < n {
                changed = true;
                mut out.append("\n");
                atLineStart = true;
                i = peek;
            }
        } else {
            mut out.append(ch);
            i = i + 1;
        }
    }
    if changed { out.build() } else { rawLine }
};
