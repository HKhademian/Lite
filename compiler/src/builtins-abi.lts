/** Core and external host module ABI tables, soft-builtin signatures, and `--builtin-mode` spec resolution. */

diagLib := import "core/diag";
listLib := import "core/list";
textLib := import "core/text";
ir := import "./frontend-ir.lts";

/** One parsed item entry matching `frontend-ir.Item`. */
Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := type List<Item>;

/** True when `moduleIdentity` is a verified `lite.core.*`, `lite.external.*`, or `lite.extra.*` host module identity. */
pub isHostModuleIdentity := fn(moduleIdentity: String): Bool {
    textLib.startsWithAt(moduleIdentity, 0, "lite.core.") or
    textLib.startsWithAt(moduleIdentity, 0, "lite.external.") or
    textLib.startsWithAt(moduleIdentity, 0, "lite.extra.")
};

/** Resolves a bodyless `lib/extra/` declaration when its module identity and ABI match. */
extraHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.extra.canvas.v1" {
        surf := "(handle:Int)";
        col := "(r:Float,g:Float,b:Float,a:Float)";
        pt := "(x:Float,y:Float)";
        rc := "(x:Float,y:Float,width:Float,height:Float)";
        inp := "(open:Bool,width:Int,height:Int,pointerX:Float,pointerY:Float,pointerDown:Bool,key:String,deltaMs:Int)";
        if name == "open" and params == "title=String|width=Int|height=Int" and result == surf { "lite$extraCanvasOpen" }
        else if name == "poll" and params == "surface=" + surf and result == inp { "lite$extraCanvasPoll" }
        else if name == "present" and params == "surface=" + surf and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasPresent" }
        else if name == "close" and params == "surface=" + surf and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasClose" }
        else if name == "clear" and params == "surface=" + surf + "|fill=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasClear" }
        else if name == "fillRect" and params == "surface=" + surf + "|area=" + rc + "|fill=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasFillRect" }
        else if name == "strokeRect" and params == "surface=" + surf + "|area=" + rc + "|lineWidth=Float|stroke=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasStrokeRect" }
        else if name == "fillCircle" and params == "surface=" + surf + "|center=" + pt + "|radius=Float|fill=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasFillCircle" }
        else if name == "strokeLine" and params == "surface=" + surf + "|start=" + pt + "|finish=" + pt + "|lineWidth=Float|stroke=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasStrokeLine" }
        else if name == "drawText" and params == "surface=" + surf + "|content=String|at=" + pt + "|size=Float|fill=" + col and result == ir.VALUE_KIND_UNIT { "lite$extraCanvasDrawText" }
        else if name == "capture" and params == "surface=" + surf + "|outPath=String" and result == "(ok:Bool,error:String)" { "lite$extraCanvasCapture" }
        else { "" }
    } else {
        ""
    }
};

/** Resolves a bodyless external host declaration only when its `lib/external/` module identity and ABI match. */
externalHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if moduleIdentity == "lite.external.ts.v1" {
        if name == "stripTypes" and params == "source=String" and result == "(ok:Bool,code:String,error:String)" {
            "lite$extTsStripTypes"
        } else { "" }
    } else if moduleIdentity == "lite.external.http.v1" {
        if name == "fetchToFile" and params == "url=String|outPath=String|timeoutMs=Int|headers=List<String>" and
        result == "(ok:Bool,status:Int,byteCount:Int,retryAfter:String,error:String)" {
            "lite$extHttpFetchToFile"
        } else if name == "serveStatic" and params == "siteDir=String|brandDir=String|host=String|port=Int" and
        result == ir.VALUE_KIND_INT {
            "lite$extHttpServeStatic"
        } else { "" }
    } else if moduleIdentity == "lite.external.bench.v1" {
        if name == "measureCompilerArtifact" and
        params == "engine=String|artifactPath=String|sourceName=String|rootPath=String|metricsFile=String" and
        result == ir.VALUE_KIND_INT {
            "lite$extBenchMeasureCompiler"
        } else { "" }
    } else if moduleIdentity == "lite.external.pool.v1" {
        if name == "cpuCount" and params == "" and result == ir.VALUE_KIND_INT {
            "lite$extPoolCpuCount"
        } else if name == "runPoolJson" and
        params == "commands=List<String>|argListsJson=List<String>|cwd=String|maxJobs=Int" and
        result == ir.VALUE_KIND_STRING {
            "lite$extPoolRunJson"
        } else { "" }
    } else {
        ""
    }
};

/** Resolves a bodyless public core or external declaration only when its module identity and complete ABI are registered. */
pub coreHostFunction := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    if textLib.startsWithAt(moduleIdentity, 0, "lite.external.") {
        return externalHostFunction(moduleIdentity, name, params, result);
    }
    if textLib.startsWithAt(moduleIdentity, 0, "lite.extra.") {
        return extraHostFunction(moduleIdentity, name, params, result);
    }
    if moduleIdentity == "lite.core.io.v1" {
        if params == "...values" and result == ir.VALUE_KIND_UNIT {
            if name == "output" { "lite$core$io$output:v1" }
            else if name == "outputLine" { "lite$core$io$outputLine:v1" }
            else { "" }
        } else if name == "errorLine" and params == "text=String" and result == ir.VALUE_KIND_UNIT { "lite$reportError" }
        else if name == "exit" and params == "status=Int" and result == ir.VALUE_KIND_UNIT { "lite$exit" }
        else if name == "inputArgs" and params == "" and result == "List<String>" { "lite$inputArgs" }
        else if params == "prompt=String" and result == ir.VALUE_KIND_STRING {
            if name == "inputAll" { "lite$inputAll" } else if name == "inputLine" { "lite$inputLine" } else { "" }
        } else if params == "prompt=String" and result == ir.VALUE_KIND_INT and name == "inputInt" { "lite$inputInt" }
        else if params == "prompt=String" and result == ir.VALUE_KIND_FLOAT and name == "inputFloat" { "lite$inputFloat" }
        else if name == "stdinReader" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStdinReader" }
        else if name == "stdoutWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStdoutWriter" }
        else if name == "stderrWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioStderrWriter" }
        else if name == "bufferReader" and params == "bytes=List<Int>" and result == "(kind:String,handle:Int)" { "lite$ioBufferReader" }
        else if name == "bufferWriter" and params == "" and result == "(kind:String,handle:Int)" { "lite$ioBufferWriter" }
        else if name == "writerBytes" and params == "writer=(kind:String,handle:Int)" and result == "List<Int>" { "lite$ioWriterBytes" }
        else if name == "writerText" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,text:String,error:String)" { "lite$ioWriterText" }
        else if name == "clearWriter" and params == "writer=(kind:String,handle:Int)" and result == ir.VALUE_KIND_UNIT { "lite$ioClearWriter" }
        else if name == "readerOk" and params == "reader=(kind:String,handle:Int)" and result == ir.VALUE_KIND_BOOL { "lite$ioReaderOk" }
        else if name == "readerAtEof" and params == "reader=(kind:String,handle:Int)" and result == ir.VALUE_KIND_BOOL { "lite$ioReaderAtEof" }
        else if name == "readerError" and params == "reader=(kind:String,handle:Int)" and result == ir.VALUE_KIND_STRING { "lite$ioReaderError" }
        else if name == "read" and params == "reader=(kind:String,handle:Int)|maxBytes=Int" and result == "List<Int>" { "lite$ioRead" }
        else if name == "closeReader" and params == "reader=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioCloseReader" }
        else if name == "writerOk" and params == "writer=(kind:String,handle:Int)" and result == ir.VALUE_KIND_BOOL { "lite$ioWriterOk" }
        else if name == "writerError" and params == "writer=(kind:String,handle:Int)" and result == ir.VALUE_KIND_STRING { "lite$ioWriterError" }
        else if name == "write" and params == "writer=(kind:String,handle:Int)|bytes=List<Int>" and result == "(ok:Bool,written:Int,error:String)" { "lite$ioWrite" }
        else if name == "flush" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioFlush" }
        else if name == "closeWriter" and params == "writer=(kind:String,handle:Int)" and result == "(ok:Bool,error:String)" { "lite$ioCloseWriter" }
        else { "" }
    } else if moduleIdentity == "lite.core.text.v1" {
        if name == "length" and params == "text=String" and result == ir.VALUE_KIND_INT { "lite$textLength" }
        else if name == "at" and params == "text=String|position=Int" and result == ir.VALUE_KIND_STRING { "lite$textAt" }
        else if name == "slice" and params == "text=String|start=Int|end=Int" and result == ir.VALUE_KIND_STRING { "lite$textSlice" }
        else { "" }
    } else if moduleIdentity == "lite.core.list.v1" {
        if name == "pushBack" and params == "values=mut List<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$pushBack:v1" }
        else if name == "popBack" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popBack:v1" }
        else if name == "pushFront" and params == "values=mut List<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$pushFront:v1" }
        else if name == "popFront" and params == "values=mut List<T>" and result == "T" { "lite$core$list$popFront:v1" }
        else if name == "length" and params == "values=List<T>" and result == ir.VALUE_KIND_INT { "lite$core$list$length:v1" }
        else if name == "setAt" and params == "values=mut List<T>|index=Int|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$list$setAt:v1" }
        else if name == "slice" and params == "values=List<T>|start=Int|end=Int" and result == "List<T>" { "lite$core$list$slice:v1" }
        else if name == "reverse" and params == "values=List<T>" and result == "List<T>" { "lite$core$list$reverse:v1" }
        else if name == "clear" and params == "values=mut List<T>" and result == ir.VALUE_KIND_UNIT { "lite$core$list$clear:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.map.v1" {
        if name == "set" and params == "entries=mut Map<K,V>|key=K|value=V" and result == ir.VALUE_KIND_UNIT { "lite$core$map$set:v1" }
        else if name == "get" and params == "entries=Map<K,V>|key=K" and result == "(found:Bool,value:V)" { "lite$core$map$get:v1" }
        else if name == "getOr" and params == "entries=Map<K,V>|key=K|fallback=V" and result == "V" { "lite$core$map$getOr:v1" }
        else if name == "has" and params == "entries=Map<K,V>|key=K" and result == ir.VALUE_KIND_BOOL { "lite$core$map$has:v1" }
        else if name == "remove" and params == "entries=mut Map<K,V>|key=K" and result == ir.VALUE_KIND_BOOL { "lite$core$map$remove:v1" }
        else if name == "size" and params == "entries=Map<K,V>" and result == ir.VALUE_KIND_INT { "lite$core$map$size:v1" }
        else if name == "clear" and params == "entries=mut Map<K,V>" and result == ir.VALUE_KIND_UNIT { "lite$core$map$clear:v1" }
        else if name == "keys" and params == "entries=Map<K,V>" and result == "List<K>" { "lite$core$map$keys:v1" }
        else if name == "values" and params == "entries=Map<K,V>" and result == "List<V>" { "lite$core$map$values:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.set.v1" {
        if name == "add" and params == "s=mut Set<T>|value=T" and result == ir.VALUE_KIND_UNIT { "lite$core$set$add:v1" }
        else if name == "has" and params == "s=Set<T>|value=T" and result == ir.VALUE_KIND_BOOL { "lite$core$set$has:v1" }
        else if name == "remove" and params == "s=mut Set<T>|value=T" and result == ir.VALUE_KIND_BOOL { "lite$core$set$remove:v1" }
        else if name == "size" and params == "s=Set<T>" and result == ir.VALUE_KIND_INT { "lite$core$set$size:v1" }
        else if name == "clear" and params == "s=mut Set<T>" and result == ir.VALUE_KIND_UNIT { "lite$core$set$clear:v1" }
        else if name == "values" and params == "s=Set<T>" and result == "List<T>" { "lite$core$set$values:v1" }
        else { "" }
    } else if moduleIdentity == "lite.core.file.v1" {
        if name == "kind" and params == "path=String" and result == ir.VALUE_KIND_STRING { "lite$fileKind" }
        else if name == "openReader" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenReader" }
        else if name == "openWriter" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenWriter" }
        else if name == "openAppender" and params == "path=String" and result == "(kind:String,handle:Int)" { "lite$fileOpenAppender" }
        else if name == "listDir" and params == "path=String" and result == "List<String>" { "lite$fileListDir" }
        else if name == "makeDir" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileMakeDir" }
        else if name == "remove" and params == "path=String" and result == "(ok:Bool,error:String)" { "lite$fileRemove" }
        else if name == "copy" and params == "fromPath=String|toPath=String" and result == "(ok:Bool,error:String)" { "lite$fileCopy" }
        else if name == "symlink" and params == "targetPath=String|linkPath=String" and result == "(ok:Bool,error:String)" { "lite$fileSymlink" }
        else if name == "realPath" and params == "path=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileRealPath" }
        else if name == "makeTempDir" and params == "prefix=String" and result == "(ok:Bool,path:String,error:String)" { "lite$fileMakeTempDir" }
        else { "" }
    } else if moduleIdentity == "lite.core.process.v1" {
        if name == "cwd" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processCwd" }
        else if name == "execPath" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processExecPath" }
        else if name == "entryPath" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processEntryPath" }
        else if name == "platform" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processPlatform" }
        else if name == "arch" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processArch" }
        else if name == "runtimeVersion" and params == "" and result == ir.VALUE_KIND_STRING { "lite$processRuntimeVersion" }
        else if name == "envGet" and params == "name=String" and result == "(found:Bool,value:String)" { "lite$processEnvGet" }
        else if name == "run" and params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|capture=Bool|stdinText=String" and
        result == "(status:Int,stdout:String,stderr:String,error:String)" { "lite$processRun" }
        else if name == "runBytes" and
        params == "command=String|args=List<String>|cwd=String|envOverrides=List<String>|timeoutMs=Int|stdinBytes=List<Int>|stdoutPath=String|stderrPath=String" and
        result == "(status:Int,error:String)" { "lite$processRunBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.crypto.v1" {
        if name == "randomBytes" and params == "count=Int" and result == "List<Int>" { "lite$cryptoRandomBytes" }
        else { "" }
    } else if moduleIdentity == "lite.core.time.v1" {
        if name == "monotonicNs" and params == "" and result == ir.VALUE_KIND_INT { "lite$timeMonotonicNs" }
        else if name == "epochNs" and params == "" and result == ir.VALUE_KIND_INT { "lite$timeEpochNs" }
        else if name == "sleepMs" and params == "ms=Int" and result == ir.VALUE_KIND_UNIT { "lite$timeSleepMs" }
        else if name == "localDate" and params == "" and result == ir.VALUE_KIND_STRING { "lite$timeLocalDate" }
        else { "" }
    } else if moduleIdentity == "lite.core.unicode.v1" {
        if name == "toCodePoints" and params == "text=String" and result == "List<Int>" { "lite$unicodeToCodePoints" }
        else if name == "fromCodePoints" and params == "points=List<Int>" and result == "(ok:Bool,text:String,error:String)" { "lite$unicodeFromCodePoints" }
        else { "" }
    } else {
        ""
    }
};

/** Maps a verified host core module identity to its soft-builtin logical path, or `""` outside soft-builtin stdlib modules. */
softBuiltinModuleForIdentity := fn(moduleIdentity: String): String {
    match {
        moduleIdentity == "lite.core.crypto.v1" { "lib/core/crypto" }
        moduleIdentity == "lite.core.file.v1" { "lib/core/file" }
        moduleIdentity == "lite.core.int.v1" { "lib/core/int" }
        moduleIdentity == "lite.core.text.v1" { "lib/core/text" }
        moduleIdentity == "lite.core.io.v1" { "lib/core/io" }
        moduleIdentity == "lite.core.unicode.v1" { "lib/core/unicode" }
        _ { "" }
    }
};

/** True when `moduleName` is a canonical core stdlib path with soft-builtin support. */
isSoftBuiltinModule := fn(moduleName: String): Bool {
    moduleName == "lib/core/crypto" or moduleName == "lib/core/file" or moduleName == "lib/core/int" or
    moduleName == "lib/core/text" or moduleName == "lib/core/io" or moduleName == "lib/core/unicode"
};

/** Returns the expected `(params, result)` ABI for a registered soft-builtin function, or empty fields when absent. */
softBuiltinAbi := fn(moduleName: String, name: String): (params: String, result: String) {
    if moduleName == "lib/core/crypto" {
        if name == "sha256Bytes" or name == "sha512Bytes" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "sha256Text" or name == "sha512Text" {
            return (params = "value=String", result = ir.VALUE_KIND_STRING);
        }
        if name == "sha256File" {
            return (params = "path=String", result = "(ok:Bool,hex:String,error:String)");
        }
        if name == "hmacSha256Bytes" {
            return (params = "key=List<Int>|data=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "isValidBase64" or name == "isValidHex" {
            return (params = "encoded=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "base64Encode" or name == "hexEncode" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
        if name == "base64Decode" or name == "hexDecode" {
            return (params = "encoded=String", result = "List<Int>");
        }
    } else if moduleName == "lib/core/file" {
        if name == "readBytes" {
            return (params = "path=String", result = "List<Int>");
        }
        if name == "readText" {
            return (params = "path=String", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "writeBytes" or name == "appendBytes" {
            return (params = "path=String|bytes=List<Int>", result = "(ok:Bool,error:String)");
        }
        if name == "writeText" or name == "appendText" {
            return (params = "path=String|text=String", result = "(ok:Bool,error:String)");
        }
    } else if moduleName == "lib/core/int" {
        if name == "intText" {
            return (params = "value=Int", result = ir.VALUE_KIND_STRING);
        }
    } else if moduleName == "lib/core/text" {
        if name == "skipSpaces" or name == "skipName" {
            return (params = "source=String|start=Int", result = ir.VALUE_KIND_INT);
        }
        if name == "indexOf" or name == "indexOfText" {
            return (params = "source=String|needle=String|start=Int", result = ir.VALUE_KIND_INT);
        }
        if name == "startsWithAt" {
            return (params = "source=String|position=Int|text=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "wordAt" {
            return (params = "source=String|position=Int|word=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "joinTexts" {
            return (params = "values=List<String>|separator=String", result = ir.VALUE_KIND_STRING);
        }
        if name == "textToInt" {
            return (params = "text=String", result = "(value:Int,ok:Bool)");
        }
        if name == "trimStart" or name == "trimEnd" or name == "trim" or name == "toLowerAscii" {
            return (params = "source=String", result = ir.VALUE_KIND_STRING);
        }
        if name == "endsWith" {
            return (params = "source=String|suffix=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "repeatText" {
            return (params = "value=String|count=Int", result = ir.VALUE_KIND_STRING);
        }
        if name == "containsText" {
            return (params = "source=String|needle=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "isDigit" {
            return (params = "text=String", result = ir.VALUE_KIND_BOOL);
        }
        if name == "isAsciiLetter" or name == "isNameStart" or name == "isNameContinue" or name == "isWhitespace" {
            return (params = "ch=String", result = ir.VALUE_KIND_BOOL);
        }
    } else if moduleName == "lib/core/io" {
        if name == "textReader" {
            return (params = "text=String", result = "(kind:String,handle:Int)");
        }
        if name == "readAll" {
            return (params = "reader=(kind:String,handle:Int)", result = "List<Int>");
        }
        if name == "readAllText" {
            return (params = "reader=(kind:String,handle:Int)", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "readLine" {
            return (params = "reader=(kind:String,handle:Int)", result = "(ok:Bool,line:String,eof:Bool,error:String)");
        }
        if name == "writeText" or name == "writeLine" {
            return (params = "writer=(kind:String,handle:Int)|text=String", result = "(ok:Bool,error:String)");
        }
    } else if moduleName == "lib/core/unicode" {
        if name == "utf8Encode" {
            return (params = "text=String", result = "List<Int>");
        }
        if name == "utf8DecodeStrict" {
            return (params = "bytes=List<Int>", result = "(ok:Bool,text:String,error:String)");
        }
        if name == "utf8DecodeLossy" {
            return (params = "bytes=List<Int>", result = ir.VALUE_KIND_STRING);
        }
    }
    (params = "", result = "")
};

/** Returns the verified soft-builtin module path when `moduleIdentity`, `name`, `params`, and `result` match, else `""`. */
pub coreSoftBuiltin := fn(moduleIdentity: String, name: String, params: String, result: String): String {
    modName := softBuiltinModuleForIdentity(moduleIdentity);
    if modName == "" { return ""; }
    abi := softBuiltinAbi(modName, name);
    if abi.result =!= "" and abi.params == params and abi.result == result {
        return modName;
    }
    ""
};

/** Maps one registered output intrinsic identity to its source special-statement name. */
pub coreOutputName := fn(runtime: String): String {
    match {
        runtime == "lite$core$io$output:v1" { "output" }
        runtime == "lite$core$io$outputLine:v1" { "outputLine" }
        _ { "" }
    }
};

/** Normalizes and validates a canonical soft-builtin core module path (`core/<name>` or `lib/core/<name>[.lts]`), returning `""` outside stdlib bounds. */
normalizeBuiltinModule := fn(raw: String): String {
    if raw == "" { return ""; }
    if textLib.indexOfText(raw, "\\", 0) >= 0 or textLib.indexOfText(raw, ":", 0) >= 0 {
        return "";
    }
    if textLib.startsWithAt(raw, 0, "/") or textLib.indexOfText(raw, "//", 0) >= 0 {
        return "";
    }
    rawLen := textLib.length(raw);
    if textLib.at(raw, rawLen - 1) == "/" { return ""; }
    var out := raw;
    if rawLen > 4 and textLib.startsWithAt(raw, rawLen - 4, ".lts") {
        out = textLib.slice(raw, 0, rawLen - 4);
    }
    if textLib.indexOfText(out, ".", 0) >= 0 { return ""; }
    if textLib.startsWithAt(out, 0, "core/") {
        out = "lib/" + out;
    }
    if not textLib.startsWithAt(out, 0, "lib/core/") { return ""; }
    if not isSoftBuiltinModule(out) { return ""; }
    out
};

/** Parses one `--builtin-mode` spec (`pure`, `builtin`, `module=mode`, `module.fn=mode`). */
parseBuiltinModeSpec := fn(prefix: String, spec: String): Item {
    if spec == ir.BUILTIN_MODE_BUILTIN or spec == ir.BUILTIN_MODE_PURE {
        return (kind = ir.BUILTIN_RULE_PROJECT, name = "", runtime = spec, code = "", intValue = 0, textValue = "");
    }
    eq := textLib.indexOfText(spec, "=", 0);
    if eq <= 0 {
        diagLib.fail(prefix, "invalid --builtin-mode specification: " + spec);
    }
    target := textLib.slice(spec, 0, eq);
    mode := textLib.slice(spec, eq + 1, textLib.length(spec));
    if mode =!= ir.BUILTIN_MODE_BUILTIN and mode =!= ir.BUILTIN_MODE_PURE {
        diagLib.fail(prefix, "invalid --builtin-mode value: " + mode);
    }
    tLen := textLib.length(target);
    isLtsFile := tLen > 4 and textLib.startsWithAt(target, tLen - 4, ".lts");
    var lastDot := -1;
    var scan := 0;
    loop true {
        found := textLib.indexOfText(target, ".", scan);
        if found < 0 { break; }
        lastDot = found;
        scan = found + 1;
    }
    if not isLtsFile and lastDot > 0 and textLib.indexOfText(target, "/", lastDot + 1) < 0 {
        modPart := textLib.slice(target, 0, lastDot);
        fnPart := textLib.slice(target, lastDot + 1, tLen);
        if textLib.indexOfText(modPart, ".", 0) < 0 and fnPart =!= "" {
            normMod := normalizeBuiltinModule(modPart);
            if normMod =!= "" and softBuiltinAbi(normMod, fnPart).result =!= "" {
                return (kind = ir.BUILTIN_RULE_FN, name = normMod + "." + fnPart, runtime = mode,
                code = "", intValue = 0, textValue = "");
            }
        }
        diagLib.fail(prefix, "invalid --builtin-mode function target: " + target);
    }
    normMod := normalizeBuiltinModule(target);
    if normMod == "" {
        diagLib.fail(prefix, "invalid --builtin-mode module target: " + target);
    }
    (kind = ir.BUILTIN_RULE_MODULE, name = normMod, runtime = mode, code = "", intValue = 0, textValue = "")
};

/** Parses `--builtin-mode` specification strings passed down from the compiler entrypoint. */
pub parseBuiltinModeSpecs := fn(prefix: String, specs: List<String>): Items {
    rules: mut Items = [];
    loop specs as spec {
        listLib.pushBack(mut rules, parseBuiltinModeSpec(prefix, spec));
    }
    rules
};

/** Resolves effective builtin mode (`builtin` or `pure`) by precedence: function > module > project > default builtin. */
pub resolveBuiltinMode := fn(rules: Items, moduleName: String, fnName: String): String {
    var mode := ir.BUILTIN_MODE_BUILTIN;
    var precedence := 0;
    fnTarget := if moduleName == "" { "" } else { moduleName + "." + fnName };
    loop rules as rule {
        if rule.kind == ir.BUILTIN_RULE_PROJECT and precedence <= 1 {
            mode = rule.runtime;
            precedence = 1;
        } else if rule.kind == ir.BUILTIN_RULE_MODULE and rule.name == moduleName and precedence <= 2 {
            mode = rule.runtime;
            precedence = 2;
        } else if rule.kind == ir.BUILTIN_RULE_FN and fnTarget =!= "" and rule.name == fnTarget and precedence <= 3 {
            mode = rule.runtime;
            precedence = 3;
        }
    }
    mode
};
