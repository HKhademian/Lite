                            else if loopCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                            else { ctx.assignValueCode(target, loopCtx.valKind, rhs.kind, rhs.code) };
                            if target == ir.TARGET_C {
