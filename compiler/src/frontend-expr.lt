                        blockExits = true;
                    }
                }
                statementCount = statementCount + 1;
                blockConstant = false;
                cursor = exitNext;
            } else if itemName == "else" {
                syntax.failAt(source, itemStart, prefix, "unexpected else");
            } else if itemName == "if" {
                rawStmtIfEnd := syntax.scanRawIfChainEnd(source, itemStart, prefix, true);
                afterRawStmtIf := if rawStmtIfEnd >= 0 { syntax.skipTrivia(source, rawStmtIfEnd, prefix) } else { -1 };
                stmtIfHasThen := afterRawStmtIf >= 0 and (source.wordAt(afterRawStmtIf, "then") or source.wordAt(afterRawStmtIf, "finally"));
                var useValueIf := stmtIfHasThen;
                if (not isStmtBody) and not useValueIf {
                    valIfEnd := syntax.scanValueIfEnd(source, itemStart, prefix, false);
                    if valIfEnd >= 0 {
                        afterValIf := syntax.skipItemSeparators(source, valIfEnd, prefix);
                        if afterValIf < blockSourceSize and source.at(afterValIf) == "}" {
                            useValueIf = true;
                        }
                    }
                }
                if not useValueIf {
                    isStatement = true;
                    afterRawIfTail := if rawStmtIfEnd >= 0 { syntax.skipItemSeparators(source, rawStmtIfEnd, prefix) } else { -1 };
                    isLoopTailPartialIf := isLoopBody and afterRawIfTail >= 0 and afterRawIfTail < blockSourceSize and source.at(afterRawIfTail) == "}";
                    ifBranchSink := if isLoopTailPartialIf { "loopBody" } else { "stmt" };
                    ifBranchExpected := if isLoopTailPartialIf { expected } else { "" };
                    ifPartsBuf: mut tb.TextBuilder;
                    var allBranchesExit := true;
                    var hasElseBranch := false;
                    var ifCursor := afterItemName;
                    var isFirstIf := true;
                    ifBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_IF, phase = ir.CTX_PHASE_BODY,
                    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
                    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
                    loop true {
                        syntax.rejectHeaderBlockTag(source, ifCursor, prefix, if isFirstIf { "if" } else { "else if" });
                        condParsed := parseBinaryCtx(target, source, ifCursor, prefix, blockLocals, functions, params, currentName, "", 0, ifBarrierCtxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, condParsed); }
                        if condParsed.kind =!= ir.VALUE_KIND_BOOL {
                            syntax.failAt(source, ifCursor, prefix, if isFirstIf { "if condition must be Bool" } else { "else if condition must be Bool" });
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, ifCursor, prefix, condParsed.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        }
                        condCode := if condParsed.constant {
                            litB := ir.targetBoolLiteralCode(target, condParsed.intValue =!= 0);
                            if target == ir.TARGET_C { litB } else { "Boolean(" + litB + ")" }
                        } else {
                            condParsed.code
                        };
                        beforeOpen := syntax.skipTrivia(source, condParsed.next, prefix);
                        syntax.rejectMisplacedTag(source, beforeOpen, prefix, if isFirstIf { "block tag cannot appear before { in if" } else { "block tag cannot appear before { in else if" });
                        openPos := syntax.expectSymbol(source, beforeOpen, "{", prefix);
                        branch := parseBinaryCtx(target, source, openPos - 1, prefix, blockLocals, functions, params, currentName, ifBranchExpected, 0, ifBarrierCtxs, bodyDepth, inferMode, ifBranchSink, blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, branch); }
                        if branch.kind =!= ir.VALUE_KIND_NEVER { allBranchesExit = false; }
                        prefixKw := if isFirstIf { "if (" } else { " else if (" };
                        mut ifPartsBuf.append(prefixKw);
                        mut ifPartsBuf.append(condCode);
                        mut ifPartsBuf.append(") { ");
                        mut ifPartsBuf.append(branch.code);
                        mut ifPartsBuf.append(" }");
                        ifCursor = branch.next;
                        isFirstIf = false;
                        afterBranch := syntax.skipTrivia(source, ifCursor, prefix);
                        if afterBranch < blockSourceSize and source.wordAt(afterBranch, "else") {
