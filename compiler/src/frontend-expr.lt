                                } else if loopCtx.colVar =!= "" {
                                    colTagPay := types.cListTag(loopCtx.valKind);
                                    mut statements.pushBack(ctx.cUnwrapIntoVar(loopCtx.valVar, loopCtx.valKind, payCode) + " lt_list_" + colTagPay + "_push_back(&" + loopCtx.colVar + ", " + loopCtx.valVar + "); " + cJump);
                                } else {
                                    mut statements.pushBack(ctx.cUnwrapIntoVar(loopCtx.valVar, loopCtx.valKind, payCode) + " " + cJump);
                                }
                            } else if loopCtx.iifeDepth == bodyDepth {
                                jumpStmt := if loopCtx.label =!= "" and targetLoopIdx < ctx.findActiveLoopCtxIndex(ctxs) {
                                    itemName + " " + loopCtx.label + ";"
                                } else {
                                    itemName + ";"
                                };
                                if loopCtx.valKind == ir.VALUE_KIND_UNIT {
                                    mut statements.pushBack("void (" + payCode + "); " + jumpStmt);
                                } else if loopCtx.colVar =!= "" {
