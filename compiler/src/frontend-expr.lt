                        left = ctx.withMarkers((kind = backing, code = emittedValCode, intValue = evInt, textValue = "", constant = evConst, next = labelEnd),
                        if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                    } else {
                        cCount := types.enumCaseCount(left.kind);
