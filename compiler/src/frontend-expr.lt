                    }
                }
            } else if not lastPartialIfDiverges and topLoopValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "loop body must produce " + types.displayKind(topLoopValKind));
            }
        }
        loopBodyJoined := statements.join(" ");
        return ctx.withMarkers((kind = if blockExits { ir.VALUE_KIND_NEVER } else { topLoopValKind }, code = loopBodyJoined,
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topLoopId) } else { "" });
    }
    if isTaggedBody {
        topCtx := ctxs[ctx.ctxCount(ctxs) - 1];
        topId := topCtx.id;
        topTag := topCtx.tag;
        topValKind := topCtx.valKind;
        topValVar := topCtx.valVar;
        topLabel := topCtx.label;
        if isInferPlaceholderKind(topValKind) {
            if not blockExits {
                if sawTailExpr {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        blockMarkers = blockMarkers + topId.toText() + "=" + blockKind + "\n";
                    }
                } else {
                    blockMarkers = blockMarkers + topId.toText() + "=Unit\n";
                }
            }
            inferredKind := ctx.inferKindFromMarkers(blockMarkers, topId, topTag, source, start, prefix, blockExits);
            outerMarkers := ctx.filterOtherMarkers(blockMarkers, topId);
            return ctx.withMarkers((kind = inferredKind, code = "", intValue = if blockExits { 1 } else { 0 },
            textValue = "", constant = false, next = cursor), outerMarkers);
        }
        if not blockExits {
            if sawTailExpr {
                if topValKind == ir.VALUE_KIND_UNIT {
                    if blockKind =!= ir.VALUE_KIND_UNIT and blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "block @" + topTag + " returns Unit and cannot return a value");
                    }
                } else if topValKind == ir.VALUE_KIND_NEVER {
                    if blockKind =!= ir.VALUE_KIND_NEVER {
                        syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning Never");
                    }
                } else if not types.isCompatibleKind(topValKind, blockKind) {
                    syntax.failAt(source, start, prefix, "cannot return " + types.displayKind(blockKind) + " from block @" + topTag + " returning " + types.displayKind(topValKind));
                }
            } else if topValKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, start, prefix, "block @" + topTag + " must return " + types.displayKind(topValKind));
            }
        }
        if not blockExits and sawTailExpr {
            if blockKind == ir.VALUE_KIND_NEVER {
                if target == ir.TARGET_C {
                    mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, blockCode));
                } else {
                    mut statements.pushBack("(" + blockCode + ");");
                }
                blockExits = true;
            } else if topValKind == ir.VALUE_KIND_UNIT {
                if blockCode =!= ir.targetUnitLiteralCode(target) {
                    mut statements.pushBack(if target == ir.TARGET_C { ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, blockCode) } else { "void (" + blockCode + ");" });
                }
            } else {
                tailCode := ctx.assignValueCode(target, topValKind, blockKind, blockCode);
                if target == ir.TARGET_C {
                    mut statements.pushBack(ctx.cUnwrapIntoVar(topValVar, topValKind, tailCode));
                } else {
                    mut statements.pushBack(topValVar + " = " + tailCode + ";");
                }
            }
        }
        bodyJoined := statements.join(" ");
        if target == ir.TARGET_C {
            needsCLbl := reach.codeUsesTextCall(bodyJoined, "goto " + topLabel + ";");
            cBodyWithLbl := if needsCLbl { bodyJoined + " " + topLabel + ": ;" } else { bodyJoined };
            if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER {
                return ctx.withMarkers((kind = topValKind, code = "/*@CBLK:0@*/{ " + cBodyWithLbl + " }", intValue = 0, textValue = "", constant = false, next = cursor),
                if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
            }
            return ctx.withMarkers((kind = topValKind,
            code = "/*@CBLK:" + topValVar + "@*/" + types.cValueType(topValKind) + " " + topValVar + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; { " + cBodyWithLbl + " }",
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
        }
        needsLabel := reach.codeUsesTextCall(bodyJoined, "break " + topLabel + ";");
        needsTry := reach.codeUsesTextCall(bodyJoined, "lite$throwTransfer(" + topId.toText() + ",");
        labeledBody := if needsLabel { topLabel + ": { " + bodyJoined + " }" } else { bodyJoined };
        wrappedBody := if needsTry {
            catchAssign := if topValKind == ir.VALUE_KIND_UNIT or topValKind == ir.VALUE_KIND_NEVER { "" } else { topValVar + " = lite$transferVal;" };
            tryInner := if needsLabel { labeledBody } else { "{ " + labeledBody + " }" };
            "try { " + tryInner + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " + topId.toText() + ")) { " + catchAssign + " } else { throw lite$err; } }"
        } else {
            labeledBody
        };
        finalIife := if topValKind == ir.VALUE_KIND_UNIT {
            "(() => { " + wrappedBody + (if wrappedBody =!= "" { " " } else { "" }) + "return undefined; })()"
        } else if topValKind == ir.VALUE_KIND_NEVER {
            "(() => { " + wrappedBody + " })()"
        } else {
            "(() => { let " + topValVar + ": " + types.tsFunctionType(topValKind) + " = " + ctx.zeroParsed(target, topValKind, 0).code + "; " + wrappedBody + " return " + topValVar + "; })()"
        };
        return ctx.withMarkers((kind = topValKind, code = finalIife, intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { ctx.filterOtherMarkers(blockMarkers, topId) } else { "" });
    }
    if isStandaloneBlock {
        afterUntaggedClose := syntax.skipTrivia(source, cursor, prefix);
        if afterUntaggedClose < blockSourceSize and source.wordAt(afterUntaggedClose, "then") {
            syntax.failAt(source, afterUntaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterUntaggedClose < blockSourceSize and source.wordAt(afterUntaggedClose, "finally") {
            finParsed := parseFinallyClause(target, source, afterUntaggedClose, prefix, locals, functions, params, currentName, ctxs, bodyDepth, inferMode, aliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, finParsed); }
            stmtsJoined := statements.join(" ");
            if target == ir.TARGET_C {
                tryBlockC := if blockExits {
                    "/*@CBLK:0@*/" + stmtsJoined
                } else if blockKind == ir.VALUE_KIND_UNIT or blockKind == ir.VALUE_KIND_NEVER {
                    tailC := ctx.cUnwrapIntoVar("", blockKind, blockCode);
                    "/*@CBLK:0@*/" + stmtsJoined + (if tailC =!= "" { " " + tailC } else { "" })
                } else {
                    blkVar := "lt_blk_" + start.toText();
                    tailValC := ctx.copiedValueCode(target, blockKind, blockCode);
                    tailAssignC := ctx.cUnwrapIntoVar(blkVar, blockKind, tailValC);
                    "/*@CBLK:" + blkVar + "@*/" + types.cValueType(blockKind) + " " + blkVar + "; { " + stmtsJoined + " " + tailAssignC + " }"
                };
                normKindC := if blockExits { ir.VALUE_KIND_NEVER } else { blockKind };
                dummyBaseC := (kind = normKindC, code = "", intValue = 0, textValue = "", constant = false, next = cursor);
                return ctx.withMarkers(finishFinallyC(tryBlockC, finParsed, normKindC, dummyBaseC, inferMode, ctxs, afterUntaggedClose),
                if inferMode { blockMarkers } else { "" });
            }
            standaloneTryBody := if blockExits {
                stmtsJoined
            } else if blockKind == ir.VALUE_KIND_UNIT {
                unitRet := if blockCode == ir.targetUnitLiteralCode(target) {
                    "return undefined;"
                } else {
                    "void (" + blockCode + "); return undefined;"
                };
                if stmtsJoined == "" { unitRet } else { stmtsJoined + " " + unitRet }
            } else if blockKind == ir.VALUE_KIND_NEVER {
                if stmtsJoined == "" { "return " + blockCode + ";" } else { stmtsJoined + " return " + blockCode + ";" }
            } else {
                valRet := "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";";
                if stmtsJoined == "" { valRet } else { stmtsJoined + " " + valRet }
            };
            finalStandaloneKind := if blockExits or finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { blockKind };
            return ctx.withMarkers((kind = finalStandaloneKind,
            code = "(() => { try { " + standaloneTryBody + " } finally { " + finParsed.code + " } })()",
            intValue = 0, textValue = "", constant = false, next = finParsed.next),
            if inferMode { blockMarkers } else { "" });
        }
    }
    if blockExits {
        if target == ir.TARGET_C {
            return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + statements.join(" "),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_NEVER, code = "(() => { " + statements.join(" ") + " })()",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    if statementCount == 0 {
        baseBlock := (kind = blockKind, code = blockCode, intValue = blockInt, textValue = blockText, constant = blockConstant, next = cursor);
        return if inferMode and blockMarkers =!= "" { ctx.withMarkers(baseBlock, blockMarkers) } else { baseBlock };
    }
    if target == ir.TARGET_C {
        stmtsJoinedC := statements.join(" ");
        if blockKind == ir.VALUE_KIND_UNIT or blockKind == ir.VALUE_KIND_NEVER {
            tailC := ctx.cUnwrapIntoVar("", blockKind, blockCode);
            return ctx.withMarkers((kind = blockKind, code = "/*@CBLK:0@*/" + stmtsJoinedC + (if tailC =!= "" { " " + tailC } else { "" }),
            intValue = 0, textValue = "", constant = false, next = cursor),
            if inferMode { blockMarkers } else { "" });
        }
        blkVar := "lt_blk_" + start.toText();
        tailValC := ctx.copiedValueCode(target, blockKind, blockCode);
        tailAssignC := ctx.cUnwrapIntoVar(blkVar, blockKind, tailValC);
        return ctx.withMarkers((kind = blockKind,
        code = "/*@CBLK:" + blkVar + "@*/" + types.cValueType(blockKind) + " " + blkVar + "; { " + stmtsJoinedC + " " + tailAssignC + " }",
        intValue = 0, textValue = "", constant = false, next = cursor),
        if inferMode { blockMarkers } else { "" });
    }
    returnCode := if blockKind == ir.VALUE_KIND_UNIT {
        if blockCode == ir.targetUnitLiteralCode(target) { "return undefined;" }
        else { "void (" + blockCode + "); return undefined;" }
    } else if blockKind == ir.VALUE_KIND_NEVER {
        "return " + blockCode + ";"
    } else {
        "return " + ctx.copiedValueCode(target, blockKind, blockCode) + ";"
    };
    ctx.withMarkers((kind = blockKind, code = "(() => { " + statements.join(" ") + " " + returnCode + " })()",
    intValue = 0, textValue = "", constant = false, next = cursor),
    if inferMode { blockMarkers } else { "" })
};

/** Parses `[@tag] loop [header] { ... } [then { ... }] [finally { ... }]` expressions. */
parseLoopExpr := fn(target: String, source: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    rawLoopEnd := syntax.scanRawLoopEnd(source, condParseStart, prefix);
    afterRawLoop := if rawLoopEnd >= 0 { syntax.skipTrivia(source, rawLoopEnd, prefix) } else { -1 };
    hasActualThen := afterRawLoop >= 0 and source.wordAt(afterRawLoop, "then");
    var suffixField := "";
    var suffixFieldAt := -1;
    var suffixEnd := rawLoopEnd;
    if not hasActualThen and afterRawLoop >= 0 and afterRawLoop < source.length() and source.at(afterRawLoop) == "." and
    source.slice(rawLoopEnd, afterRawLoop).indexOf("\n", 0) < 0 {
        sFieldStart := syntax.skipTrivia(source, afterRawLoop + 1, prefix);
        if sFieldStart < source.length() and source.at(sFieldStart).isNameStart() {
            sFieldEnd := source.skipName(sFieldStart);
            sName := source.slice(sFieldStart, sFieldEnd);
            if sName == "collected" or sName == "count" or sName == "value" {
                suffixField = sName;
                suffixFieldAt = sFieldStart;
                suffixEnd = sFieldEnd;
            }
        }
    }
    afterOptLoopThen := if hasActualThen { syntax.scanTrailingThenEnd(source, rawLoopEnd, prefix, false) } else { suffixEnd };
    afterOptLoopThenTrivia := if afterOptLoopThen >= 0 { syntax.skipTrivia(source, afterOptLoopThen, prefix) } else { -1 };
    isCLoop := target == ir.TARGET_C;
    loopId := ctx.nextCtxId(ctxs);
    loopIdStr := loopId.toText();
    idSuffix := if loopId == 1 { "" } else { loopIdStr };
    loopValVar := if isCLoop { "_val" + idSuffix } else { "_val" + idSuffix };
    loopColVar := if isCLoop { "_collected" + idSuffix } else { "_collected" + idSuffix };
    loopCountVar := if isCLoop { "_count" + idSuffix } else { "_count" + idSuffix };
    loopItemMetaVar := if isCLoop { "_item" + idSuffix } else { "_item" + idSuffix };
    loopIdxVar := if isCLoop { "_idx" + idSuffix } else { "_idx" + idSuffix };
    loopLabel := if isCLoop { "lt_l_" + loopIdStr } else { "loop_" + loopIdStr };
    loopDepth := if isCLoop { iifeDepth } else { iifeDepth + 1 };
    normExpected := normalizeExpectedValueKind(expected);
    loopHintExpected := if hasActualThen or suffixField == "count" {
        ""
    } else if suffixField == "collected" {
        if types.isListKind(normExpected) { types.listElementKind(normExpected) } else { "" }
    } else {
        normExpected
    };
    wantsCollected := if suffixField == "collected" {
        true
    } else if hasActualThen and afterOptLoopThen > rawLoopEnd {
        source.slice(rawLoopEnd, afterOptLoopThen).indexOf("collected", 0) >= 0
    } else {
        false
    };
    loopTagDisplay := if condParseTag =!= "" { condParseTag } else { "loop" };
    passCount := if inferMode { 1 } else { 2 };
    var resolvedPreThenKind := "";
    var loopOuterMarkers := "";
    var loopEndCursor := condParseStart;
    var loopStmtCode := "";
    var finalIsSeqLoop := false;
    var finalSeqItemKind := "";
    var finalNeedsCount := false;
    var finalNeedsIdx := false;
    var finalNeedsItemMeta := false;
    thenMetaSrc := if hasActualThen and afterOptLoopThen > rawLoopEnd {
        source.slice(rawLoopEnd, afterOptLoopThen)
    } else { "" };
    hasTrailingFinally := afterOptLoopThenTrivia >= 0 and afterOptLoopThenTrivia < source.length() and source.wordAt(afterOptLoopThenTrivia, "finally");
    var pass := 1;
    loop pass <= passCount {
        isPass1 := pass == 1;
        passInfer := isPass1 or inferMode;
        passEmitCollected := not isPass1 and wantsCollected and resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER;
        passColVar := if passEmitCollected { loopColVar } else { "" };
        passCtxValKind := if isPass1 {
            if loopHintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + loopHintExpected }
        } else {
            resolvedPreThenKind
        };
        passBodyExpected := if isPass1 {
            loopHintExpected
        } else if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            resolvedPreThenKind
        };
        headerCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_HEADER,
        iifeDepth = loopDepth, valKind = passCtxValKind, valVar = loopValVar, label = loopLabel,
        iterLabel = loopLabel, countVar = loopCountVar, itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = passColVar);
        headerCtxs := ctx.appendCtx(ctxs, headerCtx);
        hdrStart := syntax.skipTrivia(source, condParseStart + 4, prefix);
        syntax.rejectHeaderBlockTag(source, hdrStart, prefix, "loop");
        var passMarkers := "";
        var isSeqLoop := false;
        var isRangeLoop := false;
        var isRangeInclusive := false;
        var rangeEndConst := false;
        var rangeStartCode := "";
        var rangeEndCode := "";
        var isUncond := false;
        var condCode := "true";
        var seqCode := "";
        var seqItemName := "";
        var seqItemKind := "";
        var beforeLoopOpen := hdrStart;
        if hdrStart < source.length() and source.at(hdrStart) == "{" {
            isUncond = true;
        } else {
            hdr := parseBinaryCtx(target, source, hdrStart, prefix, locals, functions, params, currentName, "", 0, headerCtxs, loopDepth, passInfer, "", aliases);
            if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, hdr); }
            afterHdr := syntax.skipTrivia(source, hdr.next, prefix);
            if source.startsWithAt(afterHdr, "..") {
                if not numeric.isIntKind(hdr.kind) {
                    syntax.failAt(source, hdrStart, prefix, "range loop start must be Int, got " + types.displayKind(hdr.kind));
                }
                isRangeInclusive = source.startsWithAt(afterHdr, "..=");
                endStart := syntax.skipTrivia(source, afterHdr + (if isRangeInclusive { 3 } else { 2 }), prefix);
                endHdr := parseBinaryCtx(target, source, endStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, headerCtxs, loopDepth, passInfer, "", aliases);
                if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, endHdr); }
                if not numeric.isIntKind(endHdr.kind) {
                    syntax.failAt(source, endStart, prefix, "range loop end must be Int, got " + types.displayKind(endHdr.kind));
                }
                isRangeLoop = true;
                isSeqLoop = true;
                rangeEndConst = endHdr.constant;
                seqItemKind = ir.VALUE_KIND_INT;
                rangeStartCode = ctx.assignValueCode(target, ir.VALUE_KIND_INT, hdr.kind, hdr.code);
                rangeEndCode = ctx.assignValueCode(target, ir.VALUE_KIND_INT, endHdr.kind, endHdr.code);
                afterEnd := syntax.skipTrivia(source, endHdr.next, prefix);
                if source.wordAt(afterEnd, "as") {
                    itemNameStart := syntax.skipTrivia(source, afterEnd + 2, prefix);
                    if itemNameStart >= source.length() or not source.at(itemNameStart).isNameStart() {
                        syntax.failAt(source, itemNameStart, prefix, "expected an item name after as");
                    }
                    itemNameEnd := source.skipName(itemNameStart);
                    seqItemName = source.slice(itemNameStart, itemNameEnd);
                    if syntax.isReservedWord(seqItemName) { syntax.unsupportedFeature(source, itemNameStart, seqItemName, prefix); }
                    beforeLoopOpen = syntax.skipTrivia(source, itemNameEnd, prefix);
                } else {
                    beforeLoopOpen = afterEnd;
                }
            } else if source.wordAt(afterHdr, "as") {
                if not types.isListKind(hdr.kind) and not types.isArrayKind(hdr.kind) and not types.isMapKind(hdr.kind) and not types.isSetKind(hdr.kind) {
                    syntax.failAt(source, hdrStart, prefix, "loop sequence must be a List, Array, Map, or Set, got " + types.displayKind(hdr.kind));
                }
                itemNameStart := syntax.skipTrivia(source, afterHdr + 2, prefix);
                if itemNameStart >= source.length() or not source.at(itemNameStart).isNameStart() {
                    syntax.failAt(source, itemNameStart, prefix, "expected an item name after as");
                }
                itemNameEnd := source.skipName(itemNameStart);
                seqItemName = source.slice(itemNameStart, itemNameEnd);
                if syntax.isReservedWord(seqItemName) { syntax.unsupportedFeature(source, itemNameStart, seqItemName, prefix); }
                isSeqLoop = true;
                if types.isMapKind(hdr.kind) {
                    seqItemKind = "(key:" + types.mapKeyKind(hdr.kind) + ",value:" + types.mapValueKind(hdr.kind) + ")";
                    seqCode = "Array.from((" + hdr.code + ").entries(), ([lite$mk, lite$mv]) => ({ key: lite$mk, value: lite$mv }))";
                } else if types.isSetKind(hdr.kind) {
                    seqItemKind = types.setElementKind(hdr.kind);
                    seqCode = "Array.from((" + hdr.code + ").values())";
                } else {
                    seqCode = hdr.code;
                    seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
                }
                beforeLoopOpen = syntax.skipTrivia(source, itemNameEnd, prefix);
            } else if types.isListKind(hdr.kind) or types.isArrayKind(hdr.kind) or types.isMapKind(hdr.kind) or types.isSetKind(hdr.kind) {
                isSeqLoop = true;
                if types.isMapKind(hdr.kind) {
                    seqItemKind = "(key:" + types.mapKeyKind(hdr.kind) + ",value:" + types.mapValueKind(hdr.kind) + ")";
                    seqCode = "Array.from((" + hdr.code + ").entries(), ([lite$mk, lite$mv]) => ({ key: lite$mk, value: lite$mv }))";
                } else if types.isSetKind(hdr.kind) {
                    seqItemKind = types.setElementKind(hdr.kind);
                    seqCode = "Array.from((" + hdr.code + ").values())";
                } else {
                    seqCode = hdr.code;
                    seqItemKind = if types.isListKind(hdr.kind) { types.listElementKind(hdr.kind) } else { types.arrayElementKind(hdr.kind) };
                }
                beforeLoopOpen = afterHdr;
            } else {
                if hdr.kind =!= ir.VALUE_KIND_BOOL {
                    syntax.failAt(source, hdrStart, prefix, "loop condition must be Bool");
                }
                if hdr.constant {
                    if hdr.intValue == 0 {
                        condCode = "false";
                    } else {
                        condCode = "true";
                        isUncond = true;
                    }
                } else {
                    condCode = hdr.code;
                }
                beforeLoopOpen = afterHdr;
            }
        }
        syntax.rejectMisplacedTag(source, beforeLoopOpen, prefix, "block tag cannot appear before { in loop");
        loopOpen := syntax.expectSymbol(source, beforeLoopOpen, "{", prefix);
        loopLocals: mut List<Local> = locals;
        var loopIterVar := "_i" + idSuffix;
        if isSeqLoop and seqItemName =!= "" {
            var nameTaken := not emitFmt.isSafeTargetIdent(seqItemName, isCLoop);
            if not nameTaken {
                loop locals as exLoc {
                    if exLoc.runtime == seqItemName { nameTaken = true; break; }
                }
            }
            loopIterVar = if not nameTaken { seqItemName } else { seqItemName + "_" + loopIdStr };
        }
        loopItemLexDepth := ir.maxLocalLexDepth(loopLocals) + 1;
        if isSeqLoop and seqItemName =!= "" {
            if seqItemKind == ir.VALUE_KIND_UNIT {
                mut loopLocals.pushBack((name = seqItemName, runtime = ir.targetUnitLiteralCode(target), kind = ir.VALUE_KIND_UNIT,
                mutable = false, writable = false, depth = loopItemLexDepth, constant = true, code = ir.targetUnitLiteralCode(target),
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
            } else {
                seqItemCode := if target == ir.TARGET_TS and not passInfer and types.containsFnKind(seqItemKind) { trace.computeCallableRhsDeps(seqCode) } else { loopIterVar };
                mut loopLocals.pushBack((name = seqItemName, runtime = loopIterVar, kind = seqItemKind,
                mutable = false, writable = false, depth = loopItemLexDepth, constant = false, code = seqItemCode,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
            }
        }
        loopBodyLexDepthStr := (ir.maxLocalLexDepth(loopLocals) + 1).toText();
        bodyCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_BODY,
        iifeDepth = loopDepth, valKind = passCtxValKind, valVar = loopValVar, label = loopLabel,
        iterLabel = loopBodyLexDepthStr, countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = seqItemKind,
        indexVar = loopIdxVar, hasIndex = isSeqLoop, colVar = passColVar);
        bodyCtxs := ctx.appendCtx(ctxs, bodyCtx);
        loopBodySink := if isSeqLoop and seqItemName =!= "" { "loopBody:" + seqItemName } else { "loopBody" };
        lpExprMark := sym.localMark();
        bodyParsed := parseBinaryCtx(target, source, loopOpen - 1, prefix, loopLocals, functions, params, currentName,
        passBodyExpected, 0, bodyCtxs, loopDepth, passInfer, loopBodySink, aliases);
        sym.rewindLocalsTo(lpExprMark);
        if passInfer { passMarkers = ctx.collectParsedMarkers(passMarkers, bodyParsed); }
        if isPass1 {
            loopEndCursor = bodyParsed.next;
            finalIsSeqLoop = isSeqLoop;
            finalSeqItemKind = seqItemKind;
            loopOuterMarkers = ctx.filterOtherMarkers(passMarkers, loopId);
            markerScan := infer.scanLoopMarkers(passMarkers, loopId);
            if isUncond and bodyParsed.kind == ir.VALUE_KIND_NEVER and not markerScan.hasAny {
                resolvedPreThenKind = ir.VALUE_KIND_NEVER;
            } else {
                if hasActualThen and not markerScan.hasConcrete {
                    probeThenKw := syntax.skipTrivia(source, loopEndCursor, prefix);
                    probeAfterThen := syntax.skipTrivia(source, probeThenKw + 4, prefix);
                    syntax.rejectMisplacedTag(source, probeAfterThen, prefix, "block tag cannot appear after then");
                    probeThenOpen := syntax.expectSymbol(source, probeAfterThen, "{", prefix);
                    thenProbeCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_THEN,
                    iifeDepth = loopDepth, valKind = ir.VAL_KIND_INFER, valVar = loopValVar, label = loopLabel,
                    iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = seqItemKind,
                    indexVar = loopIdxVar, hasIndex = isSeqLoop, colVar = "");
                    thenProbe := parseBinaryCtx(target, source, probeThenOpen - 1, prefix, locals, functions, params, currentName,
                    normExpected, 0, ctx.appendCtx(ctxs, thenProbeCtx), iifeDepth, true, "exprOut", aliases);
                    passMarkers = ctx.collectParsedMarkers(passMarkers, thenProbe);
                }
                resolvedPreThenKind = infer.inferLoopValueKind(passMarkers, loopId, loopTagDisplay, source, condParseTagAt, prefix, loopHintExpected);
            }
            if suffixField == "collected" and resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                syntax.failAt(source, suffixFieldAt, prefix, "loop producing Unit does not expose .collected");
            }
        } else {
            hdrCheckText := if isRangeLoop { rangeStartCode + " " + rangeEndCode } else if isSeqLoop { seqCode } else { condCode };
            usesIdx := isSeqLoop and (emitFmt.codeUsesIdent(bodyParsed.code, loopIdxVar) or thenMetaSrc.indexOf(".index", 0) >= 0);
            usesCount := suffixField == "count" or usesIdx or emitFmt.codeUsesIdent(bodyParsed.code, loopCountVar) or emitFmt.codeUsesIdent(hdrCheckText, loopCountVar) or thenMetaSrc.indexOf(".count", 0) >= 0;
            usesItemMeta := isSeqLoop and seqItemKind =!= "" and seqItemKind =!= ir.VALUE_KIND_UNIT and (emitFmt.codeUsesIdent(bodyParsed.code, loopItemMetaVar) or thenMetaSrc.indexOf(".item", 0) >= 0);
            finalNeedsCount = usesCount;
            finalNeedsIdx = usesIdx;
            finalNeedsItemMeta = usesItemMeta;
            var metaStep := "";
            if isCLoop {
                if usesIdx { metaStep = metaStep + loopIdxVar + " = " + loopCountVar + "; "; }
                if usesCount { metaStep = metaStep + loopCountVar + " += 1; "; }
                if usesItemMeta { metaStep = metaStep + loopItemMetaVar + " = " + loopIterVar + "; "; }
            } else {
                if usesIdx { metaStep = metaStep + loopIdxVar + " = " + loopCountVar + "; "; }
                if usesCount { metaStep = metaStep + loopCountVar + " = " + loopCountVar + " + 1n; "; }
                if usesItemMeta { metaStep = metaStep + loopItemMetaVar + " = " + loopIterVar + "; "; }
            }
            brkPayId := loopIdStr;
            contPayId := (0 - loopId).toText();
            brkBareId := (1000000 + loopId).toText();
            contBareId := (0 - 1000000 - loopId).toText();
            hasPayCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contPayId + ",");
            hasBareCont := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + contBareId + ",");
            hasPayBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkPayId + ",");
            hasBareBrk := reach.codeUsesTextCall(bodyParsed.code, "lite$throwTransfer(" + brkBareId + ",");
            valAssign := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER { "" }
            else if passEmitCollected { loopValVar + " = lite$transferVal; " + loopColVar + ".push(" + loopValVar + "); " }
            else { loopValVar + " = lite$transferVal; " };
            var wrappedBody := bodyParsed.code;
            if hasPayCont or hasBareCont or hasPayBrk or hasBareBrk {
                catchClauses: mut List<String> = [];
                if hasPayCont {
                    mut catchClauses.pushBack("if (lite$hasTransfer(lite$err, " + contPayId + ")) { " + valAssign + "continue; }");
                }
                if hasBareCont {
                    mut catchClauses.pushBack("if (lite$hasTransfer(lite$err, " + contBareId + ")) { continue; }");
                }
                if hasPayBrk {
                    mut catchClauses.pushBack("if (lite$hasTransfer(lite$err, " + brkPayId + ")) { " + valAssign + "break; }");
                }
                if hasBareBrk {
                    mut catchClauses.pushBack("if (lite$hasTransfer(lite$err, " + brkBareId + ")) { break; }");
                }
                wrappedBody = "try { " + bodyParsed.code + " } catch (lite$err) { " +
                catchClauses.join(" else ") + " else { throw lite$err; } }";
            }
            cContLbl := "lt_cont_" + loopIdStr;
            cBrkLbl := "lt_brk_" + loopIdStr;
            cBodyWithCont := if isCLoop and reach.codeUsesTextCall(wrappedBody, "goto " + cContLbl + ";") {
                wrappedBody + " " + cContLbl + ": ;"
            } else {
                wrappedBody
            };
            iterUsedInBody := usesItemMeta or emitFmt.codeUsesIdent(wrappedBody, loopIterVar);
            rawLoopStmt := if isCLoop {
                if isRangeLoop {
                    rangeCmp := if isRangeInclusive { "<=" } else { "<" };
                    if rangeEndConst {
                        "for (int64_t " + loopIterVar + " = " + rangeStartCode + "; " +
                        loopIterVar + " " + rangeCmp + " " + rangeEndCode + "; " + loopIterVar + " += 1) { " + metaStep + cBodyWithCont + " }"
                    } else {
                        rangeEndVar := "_end" + idSuffix;
                        "for (int64_t " + loopIterVar + " = " + rangeStartCode + ", " + rangeEndVar + " = " + rangeEndCode + "; " +
                        loopIterVar + " " + rangeCmp + " " + rangeEndVar + "; " + loopIterVar + " += 1) { " + metaStep + cBodyWithCont + " }"
                    }
                } else if isSeqLoop {
                    seqTag := types.cListTag(seqItemKind);
                    seqVar := "lt_lseq_" + loopIdStr;
                    seqI := "lt_lsi_" + loopIdStr;
                    elemDecl := if iterUsedInBody {
                        types.cListElemType(seqTag) + " " + loopIterVar + " = " + seqVar + ".data[" + seqI + "]; "
                    } else { "" };
                    "{ lt_list_" + seqTag + " " + seqVar + " = lt_list_" + seqTag + "_copy(" + seqCode + "); " +
                    "for (int64_t " + seqI + " = 0; " + seqI + " < " + seqVar + ".len; " + seqI + " += 1) { " +
                    elemDecl + metaStep + cBodyWithCont + " } }"
                } else {
                    "while (" + condCode + ") { " + metaStep + cBodyWithCont + " }"
                }
            } else if isRangeLoop {
                rangeCmp := if isRangeInclusive { "<=" } else { "<" };
                if rangeEndConst {
                    "for (let " + loopIterVar + ": bigint = " + rangeStartCode + "; " +
                    loopIterVar + " " + rangeCmp + " " + rangeEndCode + "; " + loopIterVar + " += 1n) { " + metaStep + wrappedBody + " }"
                } else {
                    rangeEndVar := "_end" + idSuffix;
                    "for (let " + loopIterVar + ": bigint = " + rangeStartCode + ", " + rangeEndVar + ": bigint = " + rangeEndCode + "; " +
                    loopIterVar + " " + rangeCmp + " " + rangeEndVar + "; " + loopIterVar + " += 1n) { " + metaStep + wrappedBody + " }"
                }
            } else if isSeqLoop {
                iterVoid := if not iterUsedInBody { "void " + loopIterVar + "; " } else { "" };
                "for (const " + loopIterVar + " of " + ir.targetListCopyCode(target, seqCode) + ") { " + iterVoid + metaStep + wrappedBody + " }"
            } else {
                whileCond := if condCode == "true" or condCode == "false" { "Boolean(" + condCode + ")" } else { condCode };
                "while (" + whileCond + ") { " + metaStep + wrappedBody + " }"
            };
            needsLoopLabel := not isCLoop and (reach.codeUsesTextCall(rawLoopStmt, "break " + loopLabel + ";") or
            reach.codeUsesTextCall(rawLoopStmt, "continue " + loopLabel + ";"));
            labeledLoop := if isCLoop and reach.codeUsesTextCall(rawLoopStmt, "goto " + cBrkLbl + ";") {
                rawLoopStmt + " " + cBrkLbl + ": ;"
            } else if needsLoopLabel {
                loopLabel + ": " + rawLoopStmt
            } else {
                rawLoopStmt
            };
            hdrHasPayBrk := reach.codeUsesTextCall(hdrCheckText, "lite$throwTransfer(" + brkPayId + ",");
            hdrHasBareBrk := reach.codeUsesTextCall(hdrCheckText, "lite$throwTransfer(" + brkBareId + ",");
            if hdrHasPayBrk or hdrHasBareBrk {
                hdrClauses: mut List<String> = [];
                if hdrHasPayBrk {
                    mut hdrClauses.pushBack("if (lite$hasTransfer(lite$err, " + brkPayId + ")) { " + valAssign + "}");
                }
                if hdrHasBareBrk {
                    mut hdrClauses.pushBack("if (lite$hasTransfer(lite$err, " + brkBareId + ")) { }");
                }
                loopStmtCode = "try { " + labeledLoop + " } catch (lite$err) { " +
                hdrClauses.join(" else ") + " else { throw lite$err; } }";
            } else {
                loopStmtCode = labeledLoop;
            }
        }
        pass = pass + 1;
    }
    emitCollected := wantsCollected and resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER;
    finalColVar := if emitCollected { loopColVar } else { "" };
    var decls := "";
    if not inferMode {
        if isCLoop {
            if finalNeedsCount {
                decls = decls + "int64_t " + loopCountVar + " = 0; ";
            }
            if finalNeedsIdx {
                decls = decls + "int64_t " + loopIdxVar + " = 0; ";
            }
            if finalNeedsItemMeta {
                decls = decls + types.cValueType(finalSeqItemKind) + " " + loopItemMetaVar + " = " +
                ctx.zeroParsed(target, finalSeqItemKind, 0).code + "; ";
            }
            if resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER {
                valVoid := if hasActualThen or suffixField =!= "" { " (void)" + loopValVar + ";" } else { "" };
                decls = decls + types.cValueType(resolvedPreThenKind) + " " + loopValVar + " = " +
                ctx.zeroParsed(target, resolvedPreThenKind, 0).code + ";" + valVoid + " ";
            }
            if emitCollected {
                colTag := types.cListTag(resolvedPreThenKind);
                colVoid := if hasActualThen or suffixField =!= "collected" { " (void)" + loopColVar + ";" } else { "" };
                decls = decls + "lt_list_" + colTag + " " + loopColVar + " = lt_list_" + colTag + "_from(0, NULL);" + colVoid + " ";
            }
        } else {
            if finalNeedsCount {
                decls = decls + "let " + loopCountVar + ": bigint = 0n; ";
            }
            if finalNeedsIdx {
                decls = decls + "let " + loopIdxVar + ": bigint = 0n; ";
            }
            if finalNeedsItemMeta {
                decls = decls + "let " + loopItemMetaVar + ": " + types.tsFunctionType(finalSeqItemKind) + " = " +
                ctx.zeroParsed(target, finalSeqItemKind, 0).code + "; ";
            }
            if resolvedPreThenKind =!= ir.VALUE_KIND_UNIT and resolvedPreThenKind =!= ir.VALUE_KIND_NEVER {
                valVoid := if hasActualThen or suffixField =!= "" { " void " + loopValVar + ";" } else { "" };
                decls = decls + "let " + loopValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " +
                ctx.zeroParsed(target, resolvedPreThenKind, 0).code + ";" + valVoid + " ";
            }
            if emitCollected {
                colVoid := if hasActualThen or suffixField =!= "collected" { " void " + loopColVar + ";" } else { "" };
                decls = decls + "const " + loopColVar + ": (" + types.tsFunctionType(resolvedPreThenKind) + ")[] = [];" + colVoid + " ";
            }
        }
    }
    var loopIifeBody := "";
    var left := ctx.intParsed("", 0, true, condParseStart);
    if hasActualThen {
        thenKwPos := syntax.skipTrivia(source, loopEndCursor, prefix);
        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        loopThenCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_THEN,
        iifeDepth = loopDepth, valKind = resolvedPreThenKind, valVar = loopValVar, label = loopLabel,
        iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = finalSeqItemKind,
        indexVar = loopIdxVar, hasIndex = finalIsSeqLoop, colVar = finalColVar);
        thenParsed := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, loopThenCtx), iifeDepth, inferMode, "branch", aliases);
        if inferMode {
            thenMarkers := loopOuterMarkers + ctx.collectParsedMarkers("", thenParsed);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenParsed.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenParsed.next), thenMarkers);
        } else if isCLoop {
            if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                left = (kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + decls + loopStmtCode,
                intValue = 0, textValue = "", constant = false, next = thenParsed.next);
            } else if thenParsed.kind == ir.VALUE_KIND_UNIT or thenParsed.kind == ir.VALUE_KIND_NEVER {
                thenC := ctx.cUnwrapIntoVar("", thenParsed.kind, thenParsed.code);
                left = (kind = thenParsed.kind, code = "/*@CBLK:0@*/" + decls + loopStmtCode + " " + thenC,
                intValue = 0, textValue = "", constant = false, next = thenParsed.next);
            } else {
                thenVarC := "lt_lthen_" + loopIdStr;
                thenAssignC := ctx.cUnwrapIntoVar(thenVarC, thenParsed.kind, thenParsed.code);
                left = (kind = thenParsed.kind, code = "/*@CBLK:" + thenVarC + "@*/" + types.cValueType(thenParsed.kind) + " " + thenVarC + "; { " + decls + loopStmtCode + " " + thenAssignC + " }",
                intValue = 0, textValue = "", constant = false, next = thenParsed.next);
            }
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            loopIifeBody = decls + loopStmtCode + " throw new Error(\"unreachable\");";
            left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        } else {
            thenRet := if thenParsed.kind == ir.VALUE_KIND_UNIT {
                "void (" + thenParsed.code + "); return undefined;"
            } else if thenParsed.kind == ir.VALUE_KIND_NEVER {
                "(" + thenParsed.code + "); throw new Error(\"unreachable\");"
            } else {
                "return " + thenParsed.code + ";"
            };
            loopIifeBody = decls + loopStmtCode + " " + thenRet;
            left = (kind = thenParsed.kind, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = thenParsed.next);
        }
    } else if inferMode {
        resultNext := if suffixField =!= "" { suffixEnd } else { loopEndCursor };
        resultKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ir.VALUE_KIND_NEVER
        } else if suffixField == "collected" {
            "List<" + resolvedPreThenKind + ">"
        } else if suffixField == "count" {
            ir.VALUE_KIND_INT
        } else {
            resolvedPreThenKind
        };
        left = ctx.withMarkers((kind = resultKind, code = "", intValue = 0, textValue = "", constant = false, next = resultNext), loopOuterMarkers);
    } else {
        resultNext := if suffixField =!= "" { suffixEnd } else { loopEndCursor };
        resultKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ir.VALUE_KIND_NEVER
        } else if suffixField == "collected" {
            "List<" + resolvedPreThenKind + ">"
        } else if suffixField == "count" {
            ir.VALUE_KIND_INT
        } else {
            resolvedPreThenKind
        };
        if isCLoop {
            if resultKind == ir.VALUE_KIND_UNIT {
                left = (kind = resultKind, code = "{ /*c-stmt*/ " + decls + loopStmtCode + " }",
                intValue = 0, textValue = "", constant = false, next = resultNext);
            } else if resultKind == ir.VALUE_KIND_NEVER {
                left = (kind = resultKind, code = "/*@CBLK:0@*/" + decls + loopStmtCode,
                intValue = 0, textValue = "", constant = false, next = resultNext);
            } else {
                cRetVar := if suffixField == "collected" { loopColVar }
                else if suffixField == "count" { loopCountVar }
                else { loopValVar };
                left = (kind = resultKind, code = "/*@CBLK:" + cRetVar + "@*/" + decls + loopStmtCode,
                intValue = 0, textValue = "", constant = false, next = resultNext);
            }
        } else {
            finalRet := if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                " throw new Error(\"unreachable\");"
            } else if suffixField == "collected" {
                " return " + loopColVar + ";"
            } else if suffixField == "count" {
                " return " + loopCountVar + ";"
            } else if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                " return undefined;"
            } else {
                " return " + loopValVar + ";"
            };
            loopIifeBody = decls + loopStmtCode + finalRet;
            left = (kind = resultKind, code = "(() => { " + loopIifeBody + " })()",
            intValue = 0, textValue = "", constant = false, next = resultNext);
        }
    }
    afterLoopConstruct := syntax.skipTrivia(source, left.next, prefix);
    if hasActualThen and afterLoopConstruct < source.length() and source.wordAt(afterLoopConstruct, "then") {
        syntax.failAt(source, afterLoopConstruct, prefix, "duplicate then block");
    }
    if afterLoopConstruct < source.length() and source.wordAt(afterLoopConstruct, "finally") {
        loopFinCtx := (id = loopId, tag = condParseTag, kind = ir.CTX_KIND_LOOP, phase = ir.CTX_PHASE_FINALLY,
        iifeDepth = loopDepth, valKind = resolvedPreThenKind, valVar = loopValVar, label = loopLabel,
        iterLabel = "", countVar = loopCountVar, itemVar = loopItemMetaVar, itemKind = finalSeqItemKind,
        indexVar = loopIdxVar, hasIndex = finalIsSeqLoop, colVar = finalColVar);
        finParsed := parseFinallyClause(target, source, afterLoopConstruct, prefix, locals, functions, params, currentName,
        ctx.appendCtx(ctxs, loopFinCtx), loopDepth, inferMode, aliases);
        if isCLoop {
            left = finishFinallyC(left.code, finParsed, left.kind, left, inferMode, ctxs, loopId);
        } else {
            left = finishFinallyIife(loopIifeBody, finParsed, left.kind, left, inferMode);
        }
    }
    left
};

/** One parsed subject-match pattern result (condition, tab-delimited bindings, irrefutability, Bool coverage mask, covered enum case pipe-bag, next offset, markers). */
PatResult := alias (cond: String, bindings: String, irrefutable: Bool, boolMask: Int, enumCases: String, next: Int, markers: String);

/** Merges pipe-delimited enum case indices from `add` into `acc` (`|0|1|`), returning the updated bag and count of newly added cases. */
mergeEnumCaseBag := fn(acc: String, add: String): (bag: String, added: Int) {
    if add == "" { return (bag = acc, added = 0); }
    baseAcc := if acc == "" { "|" } else { acc };
    outBuf: mut tb.TextBuilder;
    mut outBuf.append(baseAcc);
    seen: mut Set<String>;
    var added := 0;
    size := add.length();
    var pos := 0;
    loop pos < size {
        if add.at(pos) == "|" {
            pos = pos + 1;
            continue;
        }
        nextPipe := add.indexOf("|", pos);
        end := if nextPipe < 0 { size } else { nextPipe };
        if end > pos {
            tok := add.slice(pos, end);
            tag := "|" + tok + "|";
            if baseAcc.indexOf(tag, 0) < 0 and not seen.has(tok) {
                mut seen.add(tok);
                mut outBuf.append(tok);
                mut outBuf.append("|");
                added = added + 1;
            }
        }
        pos = end + 1;
    }
    (bag = outBuf.build(), added = added)
};

/** Checks whether a pattern type annotation matches a subject or component type kind. */
patternTypeMatches := fn(actualKind: String, expectedKind: String): Bool {
    actualKind == expectedKind or
    (types.isTupleKind(expectedKind) and types.tupleShapeMatches(expectedKind, actualKind)) or
    (types.isFnKind(expectedKind) and types.fnShapeMatches(expectedKind, actualKind))
};

/** Combines two JS boolean pattern conditions with short-circuiting `&&`. */
combinePatCond := fn(left: String, right: String): String {
    if left == "false" or right == "false" { return "false"; }
    if left == "" or left == "true" { return right; }
    if right == "" or right == "true" { return left; }
    "(" + left + " && " + right + ")"
};

/** Combines two 2-bit Bool exhaustiveness masks (1 = true, 2 = false, 3 = both). */
combineBoolMask := fn(left: Int, right: Int): Int {
    if left == 3 or right == 3 or (left == 1 and right == 2) or (left == 2 and right == 1) { 3 }
    else if left > 0 { left }
    else { right }
};

/** Finds the type kind of `name` in tab-delimited pattern bindings (`name\tkind\texpr\n`), or `""` if absent. */
patBindingKindOf := fn(bindings: String, name: String): String {
    size := bindings.length();
    var pos := 0;
    loop pos < size {
        nl := bindings.indexOf("\n", pos);
        lineEnd := if nl < 0 { size } else { nl };
        t1 := bindings.indexOf("\t", pos);
        if t1 > pos and t1 < lineEnd {
            entryName := bindings.slice(pos, t1);
            if entryName == name {
                t2 := bindings.indexOf("\t", t1 + 1);
                if t2 > t1 and t2 < lineEnd {
                    return bindings.slice(t1 + 1, t2);
                }
            }
        }
        pos = lineEnd + 1;
    }
    ""
};

/** Appends `added` bindings to `base`, rejecting duplicate non-`_` names within one pattern. */
mergePatBindings := fn(base: String, added: String, source: String, errPos: Int, prefix: String): String {
    var result := base;
    size := added.length();
    var pos := 0;
    loop pos < size {
        nl := added.indexOf("\n", pos);
        lineEnd := if nl < 0 { size } else { nl };
        t1 := added.indexOf("\t", pos);
        if t1 > pos and t1 < lineEnd {
            entryName := added.slice(pos, t1);
            if entryName == "_" {
                if patBindingKindOf(result, "_") == "" {
                    result = result + added.slice(pos, lineEnd) + "\n";
                }
            } else {
                if patBindingKindOf(result, entryName) =!= "" {
                    syntax.failAt(source, errPos, prefix, "duplicate pattern binding " + entryName);
                }
                result = result + added.slice(pos, lineEnd) + "\n";
            }
        }
        pos = lineEnd + 1;
    }
    result
};

/** Checks whether two `or` alternatives bind the exact same non-`_` names with matching types. */
patBindingsCompatible := fn(left: String, right: String): Bool {
    leftSize := left.length();
    var lPos := 0;
    loop lPos < leftSize {
        nl := left.indexOf("\n", lPos);
        lineEnd := if nl < 0 { leftSize } else { nl };
        t1 := left.indexOf("\t", lPos);
        t2 := if t1 >= 0 { left.indexOf("\t", t1 + 1) } else { -1 };
        if t1 > lPos and t2 > t1 and t2 < lineEnd {
            name := left.slice(lPos, t1);
            if name =!= "_" {
                lKind := left.slice(t1 + 1, t2);
                rKind := patBindingKindOf(right, name);
                if rKind =!= lKind { return false; }
            }
        }
        lPos = lineEnd + 1;
    }
    rightSize := right.length();
    var rPos := 0;
    loop rPos < rightSize {
        nl := right.indexOf("\n", rPos);
        lineEnd := if nl < 0 { rightSize } else { nl };
        t1 := right.indexOf("\t", rPos);
        if t1 > rPos and t1 < lineEnd {
            name := right.slice(rPos, t1);
            if name =!= "_" and patBindingKindOf(left, name) == "" { return false; }
        }
        rPos = lineEnd + 1;
    }
    true
};

/** Checks whether `bindings` contains any non-`_` binding name. */
patHasNamedBindings := fn(bindings: String): Bool {
    size := bindings.length();
    var pos := 0;
    loop pos < size {
        nl := bindings.indexOf("\n", pos);
        lineEnd := if nl < 0 { size } else { nl };
        t1 := bindings.indexOf("\t", pos);
        if t1 > pos and t1 < lineEnd {
            if bindings.slice(pos, t1) =!= "_" { return true; }
        }
        pos = lineEnd + 1;
    }
    false
};

/** Emits JS assignment statements for all bindings in `bindings` using deterministic arm runtime names. */
emitPatAssignments := fn(target: String, baseLocals: List<Local>, armDepth: Int, bindings: String): String {
    out: mut tb.TextBuilder;
    size := bindings.length();
    var pos := 0;
    loop pos < size {
        nl := bindings.indexOf("\n", pos);
        lineEnd := if nl < 0 { size } else { nl };
        t1 := bindings.indexOf("\t", pos);
        t2 := if t1 >= 0 { bindings.indexOf("\t", t1 + 1) } else { -1 };
        if t1 > pos and t2 > t1 and t2 < lineEnd {
            name := bindings.slice(pos, t1);
            exprCode := bindings.slice(t2 + 1, lineEnd);
            rt := ir.localRuntimeName(target, baseLocals, name, "", armDepth);
            mut out.append(rt);
            mut out.append(" = ");
            mut out.append(exprCode);
            mut out.append("; ");
        }
        pos = lineEnd + 1;
    }
    out.build()
};

/** Scans inside a record pattern clause for a top-level single `=` before `,` or `}`, returning its index or -1. */
scanRecordClauseEquals := fn(source: String, start: Int, prefix: String): Int {
    size := source.length();
    var cursor := start;
    loop cursor < size {
        cursor = syntax.skipTrivia(source, cursor, prefix);
        if cursor >= size { return -1; }
        ch := source.at(cursor);
        if ch == "," or ch == "}" { return -1; }
        if ch == "(" {
            end := syntax.scanParenEnd(source, cursor, prefix);
            if end < 0 { return -1; }
            cursor = end;
            continue;
        }
        if ch == "[" {
            end := syntax.scanBracketEnd(source, cursor, prefix);
            if end < 0 { return -1; }
            cursor = end;
            continue;
        }
        if ch == "{" {
            end := syntax.scanBraceEnd(source, cursor, prefix);
            if end < 0 { return -1; }
            cursor = end;
            continue;
        }
        if ch == "\"" {
            end := syntax.skipAliasString(source, cursor);
            if end <= cursor { return -1; }
            cursor = end;
            continue;
        }
        if syntax.isSingleEquals(source, cursor) { return cursor; }
        cmp := syntax.comparisonOperatorAt(source, cursor);
        if cmp.width > 0 {
            cursor = cursor + cmp.width;
            continue;
        }
        cursor = cursor + 1;
    }
    -1
};

/** Scans inside `(...)` to decide whether it is a tuple pattern (has top-level `,` or single `=`) vs a grouped pattern. */
parenIsTuplePattern := fn(source: String, openPos: Int, prefix: String): Bool {
    size := source.length();
    var cursor := openPos + 1;
    loop cursor < size {
        cursor = syntax.skipTrivia(source, cursor, prefix);
        if cursor >= size { return false; }
        ch := source.at(cursor);
        if ch == ")" { return false; }
        if ch == "," { return true; }
        if ch == "(" {
            end := syntax.scanParenEnd(source, cursor, prefix);
            if end < 0 { return false; }
            cursor = end;
            continue;
        }
        if ch == "[" {
            end := syntax.scanBracketEnd(source, cursor, prefix);
            if end < 0 { return false; }
            cursor = end;
            continue;
        }
        if ch == "{" {
            end := syntax.scanBraceEnd(source, cursor, prefix);
            if end < 0 { return false; }
            cursor = end;
            continue;
        }
        if ch == "\"" {
            end := syntax.skipAliasString(source, cursor);
            if end <= cursor { return false; }
            cursor = end;
            continue;
        }
        if syntax.isSingleEquals(source, cursor) { return true; }
        cmp := syntax.comparisonOperatorAt(source, cursor);
        if cmp.width > 0 {
            cursor = cursor + cmp.width;
            continue;
        }
        cursor = cursor + 1;
    }
    false
};

/** Parses one comparison-pattern RHS (arithmetic/postfix/grouped; stops before `or`/`and`/comparisons/`if`/`{`). */
parseComparisonPatternRhs := fn(target: String, source: String, opPos: Int, opText: String, opWidth: Int, prefix: String, subjKind: String, subjCode: String, subjConst: Parsed, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): PatResult {
    rhsStart := syntax.skipTrivia(source, opPos + opWidth, prefix);
    size := source.length();
    if rhsStart >= size {
        syntax.failAt(source, rhsStart, prefix, "expected expression after comparison pattern operator " + opText);
    }
    rhsCh := source.at(rhsStart);
    if rhsCh == "{" or source.wordAt(rhsStart, "if") or source.wordAt(rhsStart, "match") or
    source.wordAt(rhsStart, "loop") or source.wordAt(rhsStart, "not") {
        syntax.failAt(source, rhsStart, prefix, "parenthesize complex right operand after comparison pattern operator " + opText);
    }
    rhs := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, subjKind, 10, ctxs, iifeDepth, inferMode, "", aliases);
    afterRhs := syntax.skipTrivia(source, rhs.next, prefix);
    nextCmp := syntax.comparisonOperatorAt(source, afterRhs);
    if syntax.isComparison(nextCmp.text) {
        syntax.failAt(source, afterRhs, prefix, "comparison pattern cannot be chained; bind the value and use an if guard");
    }
    leftFake := (kind = subjKind, code = subjCode, intValue = subjConst.intValue, textValue = subjConst.textValue, constant = subjConst.constant, next = opPos);
    cmp := ctx.compareParsed(target, source, opPos, opText, leftFake, rhs, prefix);
    markers := if inferMode { ctx.collectParsedMarkers("", rhs) } else { "" };
    (cond = cmp.code, bindings = "", irrefutable = false, boolMask = 0, enumCases = "", next = rhs.next, markers = markers)
};

/** Parses a plain or payload-bearing enum case pattern (`.Case[(p0, ...)]` or `Enum.Case[(p0, ...)]`). */
parseEnumCasePattern := fn(target: String, source: String, patPos: Int, caseStart: Int, caseEnd: Int, cName: String, enumKind: String, caseIdx: Int, prefix: String, subjKind: String, subjCode: String, subjConst: Parsed, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>, armDepth: Int): PatResult {
    size := source.length();
    afterCase := syntax.skipTrivia(source, caseEnd, prefix);
    if not types.isPayloadEnumKind(enumKind) {
        if afterCase < size and source.at(afterCase) == "(" {
            syntax.failAt(source, afterCase, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + cName + " has no payload");
        }
        lit := (kind = subjKind, code = caseIdx.toText(), intValue = caseIdx, textValue = "", constant = true, next = caseEnd);
        leftFake := (kind = subjKind, code = subjCode, intValue = subjConst.intValue, textValue = subjConst.textValue, constant = subjConst.constant, next = patPos);
        cmp := ctx.compareParsed(target, source, patPos, "==", leftFake, lit, prefix);
        return (cond = cmp.code, bindings = "", irrefutable = false, boolMask = 0, enumCases = "|" + caseIdx.toText() + "|", next = caseEnd, markers = "");
    }
    payloads := types.enumCasePayloads(enumKind, caseIdx);
    tagCond := if target == ir.TARGET_C {
        "(" + subjCode + ").tag == " + caseIdx.toText()
    } else {
        "(" + subjCode + ")._t === " + caseIdx.toText()
    };
    if afterCase >= size or source.at(afterCase) =!= "(" {
        return (cond = tagCond, bindings = "", irrefutable = false, boolMask = 0, enumCases = "|" + caseIdx.toText() + "|", next = caseEnd, markers = "");
    }
    if payloads.length() == 0 {
        syntax.failAt(source, afterCase, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + cName + " has no payload");
    }
    var pCursor := syntax.skipTrivia(source, afterCase + 1, prefix);
    var payCond := tagCond;
    var payBindings := "";
    var allPayIrref := true;
    var payMarkers := "";
    var pi := 0;
    loop pCursor < size and source.at(pCursor) =!= ")" {
        if pi >= payloads.length() {
            syntax.failAt(source, pCursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + cName + " expects " + payloads.length().toText() + " payload pattern(s)");
        }
        pk := payloads[pi];
        payloadExpr := if target == ir.TARGET_C {
            "((" + subjCode + ").u.c" + caseIdx.toText() + ".f" + pi.toText() + ")"
        } else {
            "(((" + subjCode + ") as { readonly _t: " + caseIdx.toText() + "; readonly _" + pi.toText() + ": " + types.tsFunctionType(pk) + " })._" + pi.toText() + ")"
        };
        subNonConst := (kind = pk, code = payloadExpr, intValue = 0, textValue = "", constant = false, next = 0);
        sub := parseMatchPattern(target, source, pCursor, prefix, pk, payloadExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
        payCond = combinePatCond(payCond, sub.cond);
        payBindings = mergePatBindings(payBindings, sub.bindings, source, pCursor, prefix);
        if not sub.irrefutable { allPayIrref = false; }
        if inferMode { payMarkers = payMarkers + sub.markers; }
        pi = pi + 1;
        pCursor = syntax.skipTrivia(source, sub.next, prefix);
        if pCursor < size and source.at(pCursor) == "," {
            pCursor = syntax.skipTrivia(source, pCursor + 1, prefix);
        } else {
            break;
        }
    }
    if pCursor >= size or source.at(pCursor) =!= ")" {
        syntax.failAt(source, pCursor, prefix, "expected ) after enum payload pattern");
    }
    if pi =!= payloads.length() {
        syntax.failAt(source, pCursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + cName + " expects " + payloads.length().toText() + " payload pattern(s), got " + pi.toText());
    }
    enumBag := if allPayIrref { "|" + caseIdx.toText() + "|" } else { "" };
    (cond = payCond, bindings = payBindings, irrefutable = false, boolMask = 0, enumCases = enumBag, next = pCursor + 1, markers = payMarkers)
};

/** Parses one atomic subject-match pattern (without top-level `or` alternatives). */
parseMatchPatternAtom := fn(target: String, source: String, start: Int, prefix: String, subjKind: String, subjCode: String, subjConst: Parsed, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>, armDepth: Int): PatResult {
    pos := syntax.skipTrivia(source, start, prefix);
    size := source.length();
    if pos >= size {
        syntax.failAt(source, pos, prefix, "expected match pattern");
    }
    cmpOp := syntax.comparisonOperatorAt(source, pos);
    if syntax.isComparison(cmpOp.text) {
        return parseComparisonPatternRhs(target, source, pos, cmpOp.text, cmpOp.width, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    ch := source.at(pos);
    if ch == "." {
        if not types.isEnumKind(subjKind) {
            syntax.failAt(source, pos, prefix, "leading-dot case pattern requires an enum subject, got " + types.displayKind(subjKind));
        }
        cStart := syntax.skipTrivia(source, pos + 1, prefix);
        if cStart >= size or not source.at(cStart).isNameStart() {
            syntax.failAt(source, cStart, prefix, "expected enum case name after .");
        }
        cEnd := source.skipName(cStart);
        cName := source.slice(cStart, cEnd);
        caseIdx := types.enumCaseIndex(subjKind, cName);
        if caseIdx < 0 {
            syntax.failAt(source, cStart, prefix, "enum " + types.enumDisplayName(subjKind) + " has no case " + cName);
        }
        return parseEnumCasePattern(target, source, pos, cStart, cEnd, cName, subjKind, caseIdx, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
    }
    if ch == ":" {
        ty := types.parseTypeAt(source, pos + 1, prefix, aliases, "pattern type", "");
        if not patternTypeMatches(subjKind, ty.kind) {
            syntax.failAt(source, pos, prefix, "pattern type " + types.displayKind(ty.kind) + " does not match " + types.displayKind(subjKind));
        }
        return (cond = "true", bindings = "", irrefutable = true, boolMask = 0, enumCases = "", next = ty.next, markers = "");
    }
    if ch == "\"" {
        lit := syntax.parseText(target, source, pos, prefix);
        leftFake := (kind = subjKind, code = subjCode, intValue = subjConst.intValue, textValue = subjConst.textValue, constant = subjConst.constant, next = pos);
        cmp := ctx.compareParsed(target, source, pos, "==", leftFake, lit, prefix);
        return (cond = cmp.code, bindings = "", irrefutable = false, boolMask = 0, enumCases = "", next = lit.next, markers = "");
    }
    if ch.isDigit() or ((ch == "-" or ch == "+") and pos + 1 < size and source.at(syntax.skipTrivia(source, pos + 1, prefix)).isDigit()) {
        isNeg := ch == "-";
        numPos := if ch == "-" or ch == "+" { syntax.skipTrivia(source, pos + 1, prefix) } else { pos };
        lit := syntax.parseNumber(target, source, numPos, prefix, subjKind, 10);
        signedLit := if isNeg {
            (kind = lit.kind, code = "(-(" + lit.code + "))", intValue = 0 - lit.intValue, textValue = lit.textValue, constant = lit.constant, next = lit.next)
        } else {
            lit
        };
        leftFake := (kind = subjKind, code = subjCode, intValue = subjConst.intValue, textValue = subjConst.textValue, constant = subjConst.constant, next = pos);
        cmp := ctx.compareParsed(target, source, pos, "==", leftFake, signedLit, prefix);
        return (cond = cmp.code, bindings = "", irrefutable = false, boolMask = 0, enumCases = "", next = signedLit.next, markers = "");
    }
    if ch == "{" {
        if not types.isRecordKind(subjKind) {
            syntax.failAt(source, pos, prefix, "record pattern requires a record value, got " + types.displayKind(subjKind));
        }
        var cCursor := syntax.skipTrivia(source, pos + 1, prefix);
        var recCond := "true";
        var recBindings := "";
        var recIrref := true;
        var recMarkers := "";
        loop true {
            cCursor = syntax.skipTrivia(source, cCursor, prefix);
            if cCursor >= size { syntax.failAt(source, pos, prefix, "expected } to close record pattern"); }
            if source.at(cCursor) == "}" {
                return (cond = recCond, bindings = recBindings, irrefutable = recIrref, boolMask = 0, enumCases = "", next = cCursor + 1, markers = recMarkers);
            }
            if syntax.isSingleEquals(source, cCursor) {
                fStart := syntax.skipTrivia(source, cCursor + 1, prefix);
                if fStart >= size or not source.at(fStart).isNameStart() {
                    syntax.failAt(source, fStart, prefix, "expected field name after = in record pattern");
                }
                fEnd := source.skipName(fStart);
                fieldName := source.slice(fStart, fEnd);
                if fieldName == "_" { syntax.failAt(source, fStart, prefix, "use _ = sourceField to discard a field"); }
                fieldKind := types.recordFieldKind(subjKind, fieldName);
                if fieldKind == "" {
                    syntax.failAt(source, fStart, prefix, "record " + types.recordDisplayName(subjKind) + " has no field " + fieldName);
                }
                var afterField := syntax.skipTrivia(source, fEnd, prefix);
                if afterField < size and source.at(afterField) == ":" {
                    ty := types.parseTypeAt(source, afterField + 1, prefix, aliases, "record pattern field", "");
                    if not patternTypeMatches(fieldKind, ty.kind) {
                        syntax.failAt(source, fStart, prefix, "record field " + fieldName + " has type " + types.displayKind(fieldKind) + ", expected " + types.displayKind(ty.kind));
                    }
                    afterField = syntax.skipTrivia(source, ty.next, prefix);
                }
                recProp1 := types.recordComponentProp(subjKind, fieldName);
                propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(recProp1) } else { recProp1 });
                recBindings = mergePatBindings(recBindings, fieldName + "\t" + fieldKind + "\t" + propExpr + "\n", source, fStart, prefix);
                cCursor = afterField;
            } else {
                eqPos := scanRecordClauseEquals(source, cCursor, prefix);
                if eqPos >= 0 {
                    srcStart := syntax.skipTrivia(source, eqPos + 1, prefix);
                    if srcStart >= size or not source.at(srcStart).isNameStart() {
                        syntax.failAt(source, srcStart, prefix, "expected source field name after = in record pattern");
                    }
                    srcEnd := source.skipName(srcStart);
                    srcField := source.slice(srcStart, srcEnd);
                    fieldKind := types.recordFieldKind(subjKind, srcField);
                    if fieldKind == "" {
                        syntax.failAt(source, srcStart, prefix, "record " + types.recordDisplayName(subjKind) + " has no field " + srcField);
                    }
                    recProp2 := types.recordComponentProp(subjKind, srcField);
                    propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(recProp2) } else { recProp2 });
                    subNonConst := (kind = fieldKind, code = propExpr, intValue = 0, textValue = "", constant = false, next = 0);
                    sub := parseMatchPattern(target, source, cCursor, prefix, fieldKind, propExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
                    afterSub := syntax.skipTrivia(source, sub.next, prefix);
                    if afterSub =!= eqPos {
                        syntax.failAt(source, afterSub, prefix, "expected = before source field " + srcField + " in record pattern");
                    }
                    recCond = combinePatCond(recCond, sub.cond);
                    recBindings = mergePatBindings(recBindings, sub.bindings, source, cCursor, prefix);
                    if not sub.irrefutable { recIrref = false; }
                    if inferMode { recMarkers = recMarkers + sub.markers; }
                    cCursor = syntax.skipTrivia(source, srcEnd, prefix);
                } else {
                    if not source.at(cCursor).isNameStart() {
                        syntax.failAt(source, cCursor, prefix, "expected record pattern clause");
                    }
                    nEnd := source.skipName(cCursor);
                    fieldName := source.slice(cCursor, nEnd);
                    afterName := syntax.skipTrivia(source, nEnd, prefix);
                    fieldCmp := syntax.comparisonOperatorAt(source, afterName);
                    if syntax.isComparison(fieldCmp.text) {
                        fieldKind := types.recordFieldKind(subjKind, fieldName);
                        if fieldKind == "" {
                            syntax.failAt(source, cCursor, prefix, "record " + types.recordDisplayName(subjKind) + " has no field " + fieldName);
                        }
                        recProp1 := types.recordComponentProp(subjKind, fieldName);
                        propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(recProp1) } else { recProp1 });
                        subNonConst := (kind = fieldKind, code = propExpr, intValue = 0, textValue = "", constant = false, next = 0);
                        sub := parseComparisonPatternRhs(target, source, afterName, fieldCmp.text, fieldCmp.width, prefix, fieldKind, propExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
                        recCond = combinePatCond(recCond, sub.cond);
                        recIrref = false;
                        if inferMode { recMarkers = recMarkers + sub.markers; }
                        cCursor = syntax.skipTrivia(source, sub.next, prefix);
                    } else if afterName < size and source.at(afterName) == ":" {
                        fieldKind := types.recordFieldKind(subjKind, fieldName);
                        if fieldKind == "" {
                            syntax.failAt(source, cCursor, prefix, "record " + types.recordDisplayName(subjKind) + " has no field " + fieldName);
                        }
                        ty := types.parseTypeAt(source, afterName + 1, prefix, aliases, "record pattern field", "");
                        if not patternTypeMatches(fieldKind, ty.kind) {
                            syntax.failAt(source, cCursor, prefix, "record field " + fieldName + " has type " + types.displayKind(fieldKind) + ", expected " + types.displayKind(ty.kind));
                        }
                        recProp1 := types.recordComponentProp(subjKind, fieldName);
                        propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(recProp1) } else { recProp1 });
                        recBindings = mergePatBindings(recBindings, fieldName + "\t" + fieldKind + "\t" + propExpr + "\n", source, cCursor, prefix);
                        cCursor = syntax.skipTrivia(source, ty.next, prefix);
                    } else {
                        syntax.failAt(source, afterName, prefix, "expected = sourceField or : Type in record pattern clause " + fieldName);
                    }
                }
            }
            if cCursor < size and source.at(cCursor) == "," {
                cCursor = cCursor + 1;
                continue;
            }
            if cCursor < size and source.at(cCursor) == "}" { continue; }
            syntax.failAt(source, cCursor, prefix, "expected , or } in record pattern");
        }
    }
    if ch == "(" {
        afterOpen := syntax.skipTrivia(source, pos + 1, prefix);
        if afterOpen < size and source.at(afterOpen) == ")" {
            if subjKind =!= ir.VALUE_KIND_UNIT {
                syntax.failAt(source, pos, prefix, "unit pattern () requires Unit, got " + types.displayKind(subjKind));
            }
            return (cond = "true", bindings = "", irrefutable = true, boolMask = 0, enumCases = "", next = afterOpen + 1, markers = "");
        }
        if not types.isTupleKind(subjKind) or not parenIsTuplePattern(source, pos, prefix) {
            inner := parseMatchPattern(target, source, afterOpen, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
            closePos := syntax.skipTrivia(source, inner.next, prefix);
            afterClose := syntax.expectSymbol(source, closePos, ")", prefix);
            return (cond = inner.cond, bindings = inner.bindings, irrefutable = inner.irrefutable, boolMask = inner.boolMask, enumCases = inner.enumCases, next = afterClose, markers = inner.markers);
        }
        tupleCount := types.tupleComponentCount(subjKind);
        var tCursor := afterOpen;
        var tupCond := "true";
        var tupBindings := "";
        var tupIrref := true;
        var tupMarkers := "";
        usedSlots: mut Set<Int>;
        var itemCount := 0;
        loop true {
            tCursor = syntax.skipTrivia(source, tCursor, prefix);
            if tCursor >= size { syntax.failAt(source, pos, prefix, "expected ) to close tuple pattern"); }
            if source.at(tCursor) == ")" {
                if itemCount =!= tupleCount {
                    syntax.failAt(source, pos, prefix, "tuple pattern expected " + itemCount.toText() + " fields, got " + tupleCount.toText());
                }
                return (cond = tupCond, bindings = tupBindings, irrefutable = tupIrref, boolMask = 0, enumCases = "", next = tCursor + 1, markers = tupMarkers);
            }
            if syntax.isSingleEquals(source, tCursor) {
                fStart := syntax.skipTrivia(source, tCursor + 1, prefix);
                if fStart >= size or not source.at(fStart).isNameStart() {
                    syntax.failAt(source, fStart, prefix, "expected field name after = in tuple pattern");
                }
                fEnd := source.skipName(fStart);
                fieldName := source.slice(fStart, fEnd);
                if fieldName == "_" { syntax.failAt(source, fStart, prefix, "use _ = sourceField to discard a field"); }
                slotIdx := types.tupleComponentIndexByLabel(subjKind, fieldName);
                if slotIdx < 0 {
                    syntax.failAt(source, fStart, prefix, "tuple has no field " + fieldName);
                }
                if usedSlots.has(slotIdx) {
                    syntax.failAt(source, fStart, prefix, "duplicate selection of tuple field " + fieldName);
                }
                mut usedSlots.add(slotIdx);
                comp := types.tupleComponent(subjKind, slotIdx);
                var afterField := syntax.skipTrivia(source, fEnd, prefix);
                if afterField < size and source.at(afterField) == ":" {
                    ty := types.parseTypeAt(source, afterField + 1, prefix, aliases, "tuple pattern field", "");
                    if not patternTypeMatches(comp.kind, ty.kind) {
                        syntax.failAt(source, fStart, prefix, "tuple field " + fieldName + " has type " + types.displayKind(comp.kind) + ", expected " + types.displayKind(ty.kind));
                    }
                    afterField = syntax.skipTrivia(source, ty.next, prefix);
                }
                propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop });
                tupBindings = mergePatBindings(tupBindings, fieldName + "\t" + comp.kind + "\t" + propExpr + "\n", source, fStart, prefix);
                itemCount = itemCount + 1;
                tCursor = afterField;
            } else {
                /* Scan for top-level single `=` before `,` or `)` for named clause `pat = field`. */
                var scanPos := tCursor;
                var eqPos := -1;
                loop scanPos < size {
                    scanPos = syntax.skipTrivia(source, scanPos, prefix);
                    if scanPos >= size { break; }
                    sc := source.at(scanPos);
                    if sc == "," or sc == ")" { break; }
                    if sc == "(" {
                        end := syntax.scanParenEnd(source, scanPos, prefix);
                        if end < 0 { break; }
                        scanPos = end;
                        continue;
                    }
                    if sc == "[" {
                        end := syntax.scanBracketEnd(source, scanPos, prefix);
                        if end < 0 { break; }
                        scanPos = end;
                        continue;
                    }
                    if sc == "{" {
                        end := syntax.scanBraceEnd(source, scanPos, prefix);
                        if end < 0 { break; }
                        scanPos = end;
                        continue;
                    }
                    if sc == "\"" {
                        end := syntax.skipAliasString(source, scanPos);
                        if end <= scanPos { break; }
                        scanPos = end;
                        continue;
                    }
                    if syntax.isSingleEquals(source, scanPos) {
                        eqPos = scanPos;
                        break;
                    }
                    cmpScan := syntax.comparisonOperatorAt(source, scanPos);
                    if cmpScan.width > 0 {
                        scanPos = scanPos + cmpScan.width;
                        continue;
                    }
                    scanPos = scanPos + 1;
                }
                var slotIdx := -1;
                var afterClause := tCursor;
                if eqPos >= 0 {
                    srcStart := syntax.skipTrivia(source, eqPos + 1, prefix);
                    if srcStart >= size or not source.at(srcStart).isNameStart() {
                        syntax.failAt(source, srcStart, prefix, "expected field name after = in tuple pattern");
                    }
                    srcEnd := source.skipName(srcStart);
                    srcField := source.slice(srcStart, srcEnd);
                    slotIdx = types.tupleComponentIndexByLabel(subjKind, srcField);
                    if slotIdx < 0 {
                        syntax.failAt(source, srcStart, prefix, "tuple has no field " + srcField);
                    }
                    if usedSlots.has(slotIdx) {
                        syntax.failAt(source, srcStart, prefix, "duplicate selection of tuple field " + srcField);
                    }
                    mut usedSlots.add(slotIdx);
                    comp := types.tupleComponent(subjKind, slotIdx);
                    propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop });
                    subNonConst := (kind = comp.kind, code = propExpr, intValue = 0, textValue = "", constant = false, next = 0);
                    sub := parseMatchPattern(target, source, tCursor, prefix, comp.kind, propExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
                    afterSub := syntax.skipTrivia(source, sub.next, prefix);
                    if afterSub =!= eqPos {
                        syntax.failAt(source, afterSub, prefix, "expected = before tuple field " + srcField);
                    }
                    tupCond = combinePatCond(tupCond, sub.cond);
                    tupBindings = mergePatBindings(tupBindings, sub.bindings, source, tCursor, prefix);
                    if not sub.irrefutable { tupIrref = false; }
                    if inferMode { tupMarkers = tupMarkers + sub.markers; }
                    afterClause = syntax.skipTrivia(source, srcEnd, prefix);
                } else {
                    var findIdx := 0;
                    loop findIdx < tupleCount {
                        if not usedSlots.has(findIdx) {
                            slotIdx = findIdx;
                            break;
                        }
                        findIdx = findIdx + 1;
                    }
                    if slotIdx < 0 {
                        syntax.failAt(source, tCursor, prefix, "tuple pattern has too many fields for " + types.displayKind(subjKind));
                    }
                    mut usedSlots.add(slotIdx);
                    comp := types.tupleComponent(subjKind, slotIdx);
                    propExpr := "(" + subjCode + ")." + (if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop });
                    subNonConst := (kind = comp.kind, code = propExpr, intValue = 0, textValue = "", constant = false, next = 0);
                    sub := parseMatchPattern(target, source, tCursor, prefix, comp.kind, propExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
                    tupCond = combinePatCond(tupCond, sub.cond);
                    tupBindings = mergePatBindings(tupBindings, sub.bindings, source, tCursor, prefix);
                    if not sub.irrefutable { tupIrref = false; }
                    if inferMode { tupMarkers = tupMarkers + sub.markers; }
                    afterClause = syntax.skipTrivia(source, sub.next, prefix);
                }
                itemCount = itemCount + 1;
                tCursor = afterClause;
            }
            if tCursor < size and source.at(tCursor) == "," {
                tCursor = tCursor + 1;
                continue;
            }
            if tCursor < size and source.at(tCursor) == ")" { continue; }
            syntax.failAt(source, tCursor, prefix, "expected , or ) in tuple pattern");
        }
    }
    if ch == "[" {
        if types.isListKind(subjKind) {
            syntax.failAt(source, pos, prefix, "cannot match runtime-sized " + types.displayKind(subjKind) + " with fixed-array pattern; fixed array required");
        }
        if not types.isArrayKind(subjKind) {
            syntax.failAt(source, pos, prefix, "array pattern requires a fixed array, got " + types.displayKind(subjKind));
        }
        elemKind := types.arrayElementKind(subjKind);
        expectedLen := types.arrayExtent(subjKind);
        var aCursor := syntax.skipTrivia(source, pos + 1, prefix);
        var arrCond := "true";
        var arrBindings := "";
        var arrIrref := true;
        var arrMarkers := "";
        var elemIdx := 0;
        loop true {
            aCursor = syntax.skipTrivia(source, aCursor, prefix);
            if aCursor >= size { syntax.failAt(source, pos, prefix, "expected ] to close array pattern"); }
            if source.at(aCursor) == "]" {
                if elemIdx =!= expectedLen {
                    syntax.failAt(source, pos, prefix, "array pattern expected " + elemIdx.toText() + " elements, got " + expectedLen.toText());
                }
                return (cond = arrCond, bindings = arrBindings, irrefutable = arrIrref, boolMask = 0, enumCases = "", next = aCursor + 1, markers = arrMarkers);
            }
            elemExpr := if target == ir.TARGET_C and types.cListTag(elemKind) =!= "" {
                "lt_list_" + types.cListTag(elemKind) + "_at(" + subjCode + ", " + elemIdx.toText() + ", " + pos.toText() + ")"
            } else {
                "(" + subjCode + ")[" + elemIdx.toText() + "]!"
            };
            subNonConst := (kind = elemKind, code = elemExpr, intValue = 0, textValue = "", constant = false, next = 0);
            sub := parseMatchPattern(target, source, aCursor, prefix, elemKind, elemExpr, subNonConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
            arrCond = combinePatCond(arrCond, sub.cond);
            arrBindings = mergePatBindings(arrBindings, sub.bindings, source, aCursor, prefix);
            if not sub.irrefutable { arrIrref = false; }
            if inferMode { arrMarkers = arrMarkers + sub.markers; }
            elemIdx = elemIdx + 1;
            aCursor = syntax.skipTrivia(source, sub.next, prefix);
            if aCursor < size and source.at(aCursor) == "," {
                aCursor = aCursor + 1;
                continue;
            }
            if aCursor < size and source.at(aCursor) == "]" { continue; }
            syntax.failAt(source, aCursor, prefix, "expected , or ] in array pattern");
        }
    }
    if ch.isNameStart() {
        nameEnd := source.skipName(pos);
        word := source.slice(pos, nameEnd);
        if word == "true" or word == "false" {
            lit := ctx.boolParsed(ir.targetBoolLiteralCode(target, word == "true"), word == "true", true, nameEnd);
            leftFake := (kind = subjKind, code = subjCode, intValue = subjConst.intValue, textValue = subjConst.textValue, constant = subjConst.constant, next = pos);
            cmp := ctx.compareParsed(target, source, pos, "==", leftFake, lit, prefix);
            mask := if word == "true" { 1 } else { 2 };
            return (cond = cmp.code, bindings = "", irrefutable = false, boolMask = mask, enumCases = "", next = nameEnd, markers = "");
        }
        if word =!= "_" and syntax.isReservedWord(word) {
            syntax.failAt(source, pos, prefix, "unexpected keyword " + word + " in match pattern");
        }
        var endPos := nameEnd;
        afterWord := syntax.skipTrivia(source, nameEnd, prefix);
        if afterWord < size and (source.at(afterWord) == "." or source.at(afterWord) == "<") {
            var resolvedEnum := "";
            var caseDotPos := afterWord;
            if types.findAlias(aliases, word) >= 0 {
                if source.at(afterWord) == "<" {
                    parsedPatType := types.parseTypeAt(source, pos, prefix, aliases, "enum pattern", "");
                    resolvedEnum = parsedPatType.kind;
                    caseDotPos = syntax.skipTrivia(source, parsedPatType.next, prefix);
                } else {
                    emptySeen: List<String> = [];
                    resolvedEnum = types.resolveAliasKind(source, pos, prefix, aliases, word, emptySeen);
                }
            } else if source.at(afterWord) == "." {
                modIdx := sym.localIndex(locals, word);
                if modIdx >= 0 and locals[modIdx].kind == ir.VALUE_KIND_MODULE {
                    tStart := syntax.skipTrivia(source, afterWord + 1, prefix);
                    if tStart < size and source.at(tStart).isNameStart() {
                        tEnd := source.skipName(tStart);
                        qual := locals[modIdx].textValue + "." + source.slice(tStart, tEnd);
                        if types.findAlias(aliases, qual) >= 0 {
                            afterQual := syntax.skipTrivia(source, tEnd, prefix);
                            if afterQual < size and source.at(afterQual) == "<" {
                                parsedPatType := types.parseTypeAt(source, pos, prefix, aliases, "enum pattern", "");
                                resolvedEnum = parsedPatType.kind;
                                caseDotPos = syntax.skipTrivia(source, parsedPatType.next, prefix);
                            } else {
                                emptySeen: List<String> = [];
                                resolvedEnum = types.resolveAliasKind(source, tStart, prefix, aliases, qual, emptySeen);
                                caseDotPos = afterQual;
                            }
                        }
                    }
                }
            }
            if resolvedEnum =!= "" and types.isEnumKind(resolvedEnum) and caseDotPos < size and source.at(caseDotPos) == "." {
                if resolvedEnum =!= subjKind {
                    syntax.failAt(source, pos, prefix, "enum case pattern " + types.displayKind(resolvedEnum) + " does not match " + types.displayKind(subjKind));
                }
                cStart := syntax.skipTrivia(source, caseDotPos + 1, prefix);
                if cStart >= size or not source.at(cStart).isNameStart() {
                    syntax.failAt(source, cStart, prefix, "expected enum case name after .");
                }
                cEnd := source.skipName(cStart);
                cName := source.slice(cStart, cEnd);
                caseIdx := types.enumCaseIndex(resolvedEnum, cName);
                if caseIdx < 0 {
                    syntax.failAt(source, cStart, prefix, "enum " + types.enumDisplayName(resolvedEnum) + " has no case " + cName);
                }
                return parseEnumCasePattern(target, source, pos, cStart, cEnd, cName, resolvedEnum, caseIdx, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
            }
        }
        if afterWord < size and source.at(afterWord) == ":" {
            ty := types.parseTypeAt(source, afterWord + 1, prefix, aliases, "pattern type", "");
            if not patternTypeMatches(subjKind, ty.kind) {
                syntax.failAt(source, pos, prefix, "pattern type " + types.displayKind(ty.kind) + " does not match " + types.displayKind(subjKind));
            }
            endPos = ty.next;
        }
        return (cond = "true", bindings = word + "\t" + subjKind + "\t" + subjCode + "\n", irrefutable = true, boolMask = 0, enumCases = "", next = endPos, markers = "");
    }
    syntax.failAt(source, pos, prefix, "expected match pattern");
    (cond = "false", bindings = "", irrefutable = false, boolMask = 0, enumCases = "", next = pos + 1, markers = "")
};

/** Parses one match pattern with optional leading `or` and `or` alternatives (`[or] pat (or pat)*`). */
parseMatchPattern := fn(target: String, source: String, start: Int, prefix: String, subjKind: String, subjCode: String, subjConst: Parsed, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>, armDepth: Int): PatResult {
    var pos := syntax.skipTrivia(source, start, prefix);
    if source.wordAt(pos, "or") {
        pos = syntax.skipTrivia(source, pos + 2, prefix);
        if source.wordAt(pos, "or") {
            syntax.failAt(source, pos, prefix, "duplicate leading or in match pattern");
        }
    }
    first := parseMatchPatternAtom(target, source, pos, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
    var nextPos := syntax.skipTrivia(source, first.next, prefix);
    if not source.wordAt(nextPos, "or") {
        return first;
    }
    altConds: mut List<String> = [first.cond];
    altBindings: mut List<String> = [first.bindings];
    var altCount := 1;
    var anyIrref := first.irrefutable;
    var combinedMask := first.boolMask;
    var combinedEnumCases := first.enumCases;
    var combinedMarkers := first.markers;
    var lastEnd := first.next;
    loop source.wordAt(nextPos, "or") {
        altStart := syntax.skipTrivia(source, nextPos + 2, prefix);
        alt := parseMatchPatternAtom(target, source, altStart, prefix, subjKind, subjCode, subjConst, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
        if not patBindingsCompatible(first.bindings, alt.bindings) {
            syntax.failAt(source, altStart, prefix, "or pattern alternatives must bind the same names with matching types");
        }
        (mut altConds).pushBack(alt.cond);
        mut altBindings.pushBack(alt.bindings);
        altCount = altCount + 1;
        if alt.irrefutable { anyIrref = true; }
        combinedMask = combineBoolMask(combinedMask, alt.boolMask);
        combinedEnumCases = mergeEnumCaseBag(combinedEnumCases, alt.enumCases).bag;
        if inferMode { combinedMarkers = combinedMarkers + alt.markers; }
        lastEnd = alt.next;
        nextPos = syntax.skipTrivia(source, lastEnd, prefix);
    }
    if not patHasNamedBindings(first.bindings) {
        var orCond := "";
        var i := 0;
        loop i < altCount {
            part := if altConds[i] == "" { "true" } else { altConds[i] };
            if part == "true" {
                return (cond = "true", bindings = first.bindings, irrefutable = anyIrref, boolMask = combinedMask, enumCases = combinedEnumCases, next = lastEnd, markers = combinedMarkers);
            }
            if part =!= "false" {
                orCond = if orCond == "" { "(" + part + ")" } else { orCond + " || (" + part + ")" };
            }
            i = i + 1;
        }
        finalOrCond := if orCond == "" { "false" } else { "(" + orCond + ")" };
        return (cond = finalOrCond, bindings = first.bindings, irrefutable = anyIrref, boolMask = combinedMask, enumCases = combinedEnumCases, next = lastEnd, markers = combinedMarkers);
    }
    /* Binding-producing `or` alternatives: emit a short-circuiting check assigning the shared arm bindings on first match. */
    var orCondCode := "";
    if target == ir.TARGET_C {
        cOrBuf: mut tb.TextBuilder;
        mut cOrBuf.append("/*@COR@*/bool lt_or = false; ");
        var i := 0;
        loop i < altCount {
            c := if altConds[i] == "" { "true" } else { altConds[i] };
            assigns := emitPatAssignments(target, locals, armDepth, altBindings[i]);
            mut cOrBuf.append("if (!lt_or && (");
            mut cOrBuf.append(c);
            mut cOrBuf.append(")) { ");
            mut cOrBuf.append(assigns);
            mut cOrBuf.append("lt_or = true; } ");
            i = i + 1;
        }
        orCondCode = cOrBuf.build();
    } else {
        iifeBuf: mut tb.TextBuilder;
        mut iifeBuf.append("(() => { ");
        var i := 0;
        loop i < altCount {
            c := if altConds[i] == "" { "true" } else { altConds[i] };
            assigns := emitPatAssignments(target, locals, armDepth, altBindings[i]);
            mut iifeBuf.append("if (");
            mut iifeBuf.append(c);
            mut iifeBuf.append(") { ");
            mut iifeBuf.append(assigns);
            mut iifeBuf.append("return true; } ");
            i = i + 1;
        }
        mut iifeBuf.append("return false; })()");
        orCondCode = iifeBuf.build();
    }
    /* Preserve binding declarations (names + kinds) with empty per-binding expr sentinel so arm header emits `let rt!: T;` once. */
    declBindingsBuf: mut tb.TextBuilder;
    bSize := first.bindings.length();
    var bPos := 0;
    loop bPos < bSize {
        nl := first.bindings.indexOf("\n", bPos);
        lineEnd := if nl < 0 { bSize } else { nl };
        t1 := first.bindings.indexOf("\t", bPos);
        t2 := if t1 >= 0 { first.bindings.indexOf("\t", t1 + 1) } else { -1 };
        if t1 > bPos and t2 > t1 and t2 < lineEnd {
            mut declBindingsBuf.append(first.bindings.slice(bPos, t2));
            mut declBindingsBuf.append("\t\n");
        }
        bPos = lineEnd + 1;
    }
    (cond = orCondCode, bindings = declBindingsBuf.build(), irrefutable = anyIrref, boolMask = combinedMask, enumCases = combinedEnumCases, next = lastEnd, markers = combinedMarkers)
};

/** Parses a subject-based `match <subject> { ... }` body for value, statement, or tagged/then/finally IIFE lowering. */
parseSubjectMatchBody := fn(target: String, source: String, matchStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, mode: String, condValVar: String, resolvedValKind: String, aliases: List<AliasDecl>): (code: String, kind: String, allNever: Bool, next: Int, markers: String, isDirect: Bool, constant: Bool, intValue: Int, textValue: String) {
    size := source.length();
    subjStart := syntax.skipTrivia(source, matchStart + 5, prefix);
    syntax.rejectHeaderBlockTag(source, subjStart, prefix, "match");
    subjOpen := syntax.scanConditionOpen(source, subjStart, prefix);
    if subjOpen < 0 or subjOpen == subjStart {
        syntax.failAt(source, subjStart, prefix, "expected { after match subject");
    }
    subj := parseBinaryCtx(target, source, subjStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    afterSubj := syntax.skipTrivia(source, subj.next, prefix);
    syntax.rejectMisplacedTag(source, afterSubj, prefix, "block tag cannot appear before { in match");
    if afterSubj > subjOpen {
        syntax.failAt(source, subjOpen, prefix, "ungrouped { in match subject starts the arm list; parenthesize block or conditional expressions");
    }
    if afterSubj =!= subjOpen {
        _ := syntax.expectSymbol(source, afterSubj, "{", prefix);
    }
    matchId := ctx.nextCtxId(ctxs) + matchStart;
    subjIsSimpleIdent := {
        sLen := subj.code.length();
        var okId := sLen > 0 and subj.code.at(0).isNameStart();
        var si := 1;
        loop okId and si < sLen {
            ch := subj.code.at(si);
            if not ch.isNameContinue() and ch =!= "$" and (target =!= ir.TARGET_C or ch =!= ".") { okId = false; }
            si = si + 1;
        }
        okId
    };
    isCTarget := target == ir.TARGET_C;
    var canTernary := not inferMode and mode == "value" and (subjIsSimpleIdent or (isCTarget and subj.constant));
    subjVar := if canTernary { subj.code } else if isCTarget { "lt_subj_" + matchId.toText() } else { "lite$subj" + matchId.toText() };
    doneVar := if isCTarget { "lt_done_" + matchId.toText() } else { "lite$done" + matchId.toText() };
    cMatchValVar := "lt_mval_" + matchId.toText();
    subjTsType := if types.needsTsTypeAnnotation(subj.kind) { ": " + types.tsFunctionType(subj.kind) } else { "" };
    armDepth := ir.maxLocalLexDepth(locals) + 1;
    var matchMarkers := if inferMode { ctx.collectParsedMarkers("", subj) } else { "" };
    armsCodeBuf: mut tb.TextBuilder;
    if isCTarget {
        if not canTernary {
            mut armsCodeBuf.append(types.cValueType(subj.kind));
            mut armsCodeBuf.append(" ");
            mut armsCodeBuf.append(subjVar);
            mut armsCodeBuf.append(" = ");
            mut armsCodeBuf.append(subj.code);
            mut armsCodeBuf.append("; (void)");
            mut armsCodeBuf.append(subjVar);
            mut armsCodeBuf.append("; bool ");
            mut armsCodeBuf.append(doneVar);
            mut armsCodeBuf.append(" = false; ");
        }
    } else if canTernary {
        mut armsCodeBuf.append("let ");
        mut armsCodeBuf.append(doneVar);
        mut armsCodeBuf.append(": boolean = false; ");
    } else {
        mut armsCodeBuf.append("const ");
        mut armsCodeBuf.append(subjVar);
        mut armsCodeBuf.append(subjTsType);
        mut armsCodeBuf.append(" = ");
        mut armsCodeBuf.append(subj.code);
        mut armsCodeBuf.append("; void ");
        mut armsCodeBuf.append(subjVar);
        mut armsCodeBuf.append("; let ");
        mut armsCodeBuf.append(doneVar);
        mut armsCodeBuf.append(": boolean = false; ");
    }
    ternaryConds: mut List<String> = [];
    ternaryVals: mut List<String> = [];
    ternaryKinds: mut List<String> = [];
    var ternaryCount := 0;
    isStmtLike := mode == "stmt" or mode == "loopTail";
    var cursor := syntax.skipItemSeparators(source, subjOpen + 1, prefix);
    var resultKind := if isStmtLike { ir.VALUE_KIND_UNIT } else { "" };
    var allNever := true;
    var sawIrrefutable := false;
    var boolMask := 0;
    var coveredEnumBag := "|";
    var coveredEnumCount := 0;
    enumTotalCases := if types.isEnumKind(subj.kind) { types.enumCaseCount(subj.kind) } else { -1 };
    var armCount := 0;
    var emittedRuntimeArms := 0;
    var staticallyMatched := false;
    var hasDirectWin := false;
    var winBranchCode := "";
    var winBranchKind := "";
    var winBranchConst := false;
    var winBranchInt := 0;
    var winBranchText := "";
    var winDeclStmts := "";
    var winAssignStmts := "";
    var winVoidStmts := "";
    isComptimeSubjMatch := sym.localIndex(locals, "$comptimeActive") >= 0;
    loop true {
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= size {
            syntax.failAt(source, subjOpen, prefix, "expected } to close match");
        }
        if source.at(cursor) == "}" {
            isExhaustive := sawIrrefutable or (subj.kind == ir.VALUE_KIND_BOOL and boolMask == 3) or
            (enumTotalCases > 0 and coveredEnumCount == enumTotalCases);
            if not isExhaustive and mode =!= "loopTail" {
                syntax.failAt(source, cursor, prefix, "match requires an exhaustive fallback arm");
            }
            if not isExhaustive { allNever = false; }
            cursor = cursor + 1;
            break;
        }
        if sawIrrefutable or (subj.kind == ir.VALUE_KIND_BOOL and boolMask == 3) or
        (enumTotalCases > 0 and coveredEnumCount == enumTotalCases) {
            syntax.failAt(source, cursor, prefix, "unreachable match arm after exhaustive arm");
        }
        armStart := cursor;
        pat := parseMatchPattern(target, source, armStart, prefix, subj.kind, subjVar, subj, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases, armDepth);
        if inferMode { matchMarkers = matchMarkers + pat.markers; }
        patCond0 := if pat.cond == "" { "true" } else { pat.cond };
        afterPat := syntax.skipTrivia(source, pat.next, prefix);
        if isComptimeSubjMatch and (staticallyMatched or patCond0 == "false") {
            var deadArmOpen := -1;
            if source.wordAt(afterPat, "if") {
                deadGuardStart := syntax.skipTrivia(source, afterPat + 2, prefix);
                syntax.rejectHeaderBlockTag(source, deadGuardStart, prefix, "match guard");
                deadArmOpen = syntax.scanConditionOpen(source, deadGuardStart, prefix);
                if deadArmOpen < 0 or deadArmOpen == deadGuardStart {
                    syntax.failAt(source, deadGuardStart, prefix, "expected { after match guard");
                }
            } else {
                syntax.rejectMisplacedTag(source, afterPat, prefix, "block tag cannot appear before { in match arm");
                if afterPat >= size or source.at(afterPat) =!= "{" {
                    syntax.failAt(source, afterPat, prefix, "expected { after match arm pattern");
                }
                deadArmOpen = afterPat;
                if pat.irrefutable { sawIrrefutable = true; }
                boolMask = combineBoolMask(boolMask, pat.boolMask);
                if enumTotalCases > 0 and pat.enumCases =!= "" {
                    mergedEnum := mergeEnumCaseBag(coveredEnumBag, pat.enumCases);
                    coveredEnumBag = mergedEnum.bag;
                    coveredEnumCount = coveredEnumCount + mergedEnum.added;
                }
            }
            armCount = armCount + 1;
            cursor = syntax.scanBraceEnd(source, deadArmOpen, prefix);
            continue;
        }
        /* Build arm-local scope with pattern bindings. */
        armLocals: mut List<Local> = locals;
        declStmtsBuf: mut tb.TextBuilder;
        assignStmtsBuf: mut tb.TextBuilder;
        voidStmtsBuf: mut tb.TextBuilder;
        bSize := pat.bindings.length();
        var bPos := 0;
        loop bPos < bSize {
            nl := pat.bindings.indexOf("\n", bPos);
            lineEnd := if nl < 0 { bSize } else { nl };
            t1 := pat.bindings.indexOf("\t", bPos);
            t2 := if t1 >= 0 { pat.bindings.indexOf("\t", t1 + 1) } else { -1 };
            if t1 > bPos and t2 > t1 and t2 < lineEnd {
                bName := pat.bindings.slice(bPos, t1);
                bKind := pat.bindings.slice(t1 + 1, t2);
                bExpr := pat.bindings.slice(t2 + 1, lineEnd);
                bRt := ir.localRuntimeName(target, locals, bName, "", armDepth);
                if isCTarget and canTernary and bExpr =!= "" {
                    bindIsConst := subj.constant and bExpr == subjVar;
                    mut armLocals.pushBack((name = bName, runtime = bExpr, kind = bKind, mutable = false, writable = false,
                    depth = armDepth, constant = bindIsConst, code = bExpr, intValue = if bindIsConst { subj.intValue } else { 0 },
                    textValue = if bindIsConst { subj.textValue } else { "" }, initState = ir.INIT_STATE_INIT));
                } else {
                    if isCTarget {
                        bCType := types.cValueType(bKind);
                        mut declStmtsBuf.append(bCType);
                        mut declStmtsBuf.append(" ");
                        mut declStmtsBuf.append(bRt);
                        if bExpr == "" {
                            bZero := ctx.zeroParsed(ir.TARGET_C, bKind, 0).code;
                            mut declStmtsBuf.append(" = ");
                            mut declStmtsBuf.append(bZero);
                            mut declStmtsBuf.append("; ");
                        } else {
                            mut declStmtsBuf.append("; ");
                            mut assignStmtsBuf.append(bRt);
                            mut assignStmtsBuf.append(" = ");
                            mut assignStmtsBuf.append(bExpr);
                            mut assignStmtsBuf.append("; ");
                        }
                        mut voidStmtsBuf.append("(void)");
                        mut voidStmtsBuf.append(bRt);
                        mut voidStmtsBuf.append("; ");
                    } else {
                        bTsType := types.tsFunctionType(bKind);
                        mut declStmtsBuf.append("let ");
                        mut declStmtsBuf.append(bRt);
                        mut declStmtsBuf.append("!: ");
                        mut declStmtsBuf.append(bTsType);
                        mut declStmtsBuf.append("; ");
                        if bExpr =!= "" {
                            mut assignStmtsBuf.append(bRt);
                            mut assignStmtsBuf.append(" = ");
                            mut assignStmtsBuf.append(bExpr);
                            mut assignStmtsBuf.append("; ");
                        }
                        mut voidStmtsBuf.append("void ");
                        mut voidStmtsBuf.append(bRt);
                        mut voidStmtsBuf.append("; ");
                    }
                    bindIsConst := subj.constant and bExpr == subjVar;
                    mut armLocals.pushBack((name = bName, runtime = bRt, kind = bKind, mutable = false, writable = false,
                    depth = armDepth, constant = bindIsConst, code = bRt, intValue = if bindIsConst { subj.intValue } else { 0 },
                    textValue = if bindIsConst { subj.textValue } else { "" }, initState = ir.INIT_STATE_INIT));
                }
            }
            bPos = lineEnd + 1;
        }
        declStmts := declStmtsBuf.build();
        assignStmts := assignStmtsBuf.build();
        voidStmts := voidStmtsBuf.build();
        var hasGuard := false;
        var guardCode := "";
        var armOpen := -1;
        armLocMark := sym.localMark();
        if source.wordAt(afterPat, "if") {
            hasGuard = true;
            guardStart := syntax.skipTrivia(source, afterPat + 2, prefix);
            syntax.rejectHeaderBlockTag(source, guardStart, prefix, "match guard");
            armOpen = syntax.scanConditionOpen(source, guardStart, prefix);
            if armOpen < 0 or armOpen == guardStart {
                syntax.failAt(source, guardStart, prefix, "expected { after match guard");
            }
            guardParsed := parseBinaryCtx(target, source, guardStart, prefix, armLocals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { matchMarkers = ctx.collectParsedMarkers(matchMarkers, guardParsed); }
            if guardParsed.kind =!= ir.VALUE_KIND_BOOL {
                syntax.failAt(source, guardStart, prefix, "match guard must be Bool");
            }
            afterGuard := syntax.skipTrivia(source, guardParsed.next, prefix);
            syntax.rejectMisplacedTag(source, afterGuard, prefix, "block tag cannot appear before { in match arm");
            if afterGuard > armOpen {
                syntax.failAt(source, armOpen, prefix, "ungrouped { in match guard starts the arm body; parenthesize block or conditional expressions");
            }
            if afterGuard =!= armOpen {
                _ := syntax.expectSymbol(source, afterGuard, "{", prefix);
            }
            guardCode = if guardParsed.constant { ir.targetBoolLiteralCode(target, guardParsed.intValue =!= 0) } else { guardParsed.code };
        } else {
            syntax.rejectMisplacedTag(source, afterPat, prefix, "block tag cannot appear before { in match arm");
            if afterPat >= size or source.at(afterPat) =!= "{" {
                syntax.failAt(source, afterPat, prefix, "expected { after match arm pattern");
            }
            armOpen = afterPat;
        }
        if not hasGuard {
            if pat.irrefutable { sawIrrefutable = true; }
            boolMask = combineBoolMask(boolMask, pat.boolMask);
            if enumTotalCases > 0 and pat.enumCases =!= "" {
                mergedEnum := mergeEnumCaseBag(coveredEnumBag, pat.enumCases);
                coveredEnumBag = mergedEnum.bag;
                coveredEnumCount = coveredEnumCount + mergedEnum.added;
            }
        }
        if isComptimeSubjMatch and (hasGuard and guardCode == "false") {
            sym.rewindLocalsTo(armLocMark);
            armCount = armCount + 1;
            cursor = syntax.scanBraceEnd(source, armOpen, prefix);
            continue;
        }
        armBodyStart := syntax.skipTrivia(source, armOpen + 1, prefix);
        bodySink := if mode == "loopTail" { "loopBody" } else if mode == "stmt" { "stmt" } else { "branch" };
        armExpected := if mode == "stmt" { "" } else { expected };
        branch := parseBinaryCtx(target, source, armOpen, prefix, armLocals, functions, params, currentName, armExpected, 0, ctxs, iifeDepth, inferMode, bodySink, aliases);
        sym.rewindLocalsTo(armLocMark);
        if inferMode { matchMarkers = ctx.collectParsedMarkers(matchMarkers, branch); }
        if branch.kind =!= ir.VALUE_KIND_NEVER { allNever = false; }
        if not isStmtLike {
            joinedKind := types.joinBranchKind(resultKind, branch.kind);
            if joinedKind == "" {
                syntax.failAt(source, armBodyStart, prefix, "value match arms must have the same kind, got " +
                types.displayKind(resultKind) + " and " + types.displayKind(branch.kind));
            }
            resultKind = joinedKind;
        }
        var bodyEmit := "";
        if isStmtLike {
            bodyEmit = branch.code;
        } else if mode == "iife" {
            bodyEmit = ctx.condBranchStmtCode(target, resolvedValKind, condValVar, branch.kind, branch.code);
        } else if isCTarget {
            bodyEmit = ctx.cUnwrapIntoVar(cMatchValVar, branch.kind, branch.code);
        } else {
            if branch.kind == ir.VALUE_KIND_NEVER {
                bodyEmit = "void (" + branch.code + ");";
            } else {
                bodyEmit = "return (" + branch.code + ");";
            }
        }
        if isCTarget and branch.code.startsWithAt(0, "/*@CBLK:") {
            canTernary = false;
        }
        patCond := if pat.cond == "" { "true" } else { pat.cond };
        armDead := staticallyMatched or patCond == "false" or (hasGuard and guardCode == "false");
        armAlwaysMatches := not armDead and patCond == "true" and (not hasGuard or guardCode == "true");
        if armAlwaysMatches {
            staticallyMatched = true;
            if emittedRuntimeArms == 0 {
                hasDirectWin = true;
                winBranchCode = branch.code;
                winBranchKind = branch.kind;
                winBranchConst = branch.constant;
                winBranchInt = branch.intValue;
                winBranchText = branch.textValue;
                winDeclStmts = declStmts;
                winAssignStmts = assignStmts;
                winVoidStmts = voidStmts;
            } else {
                mut armsCodeBuf.append("if (!");
                mut armsCodeBuf.append(doneVar);
                mut armsCodeBuf.append(") { ");
                mut armsCodeBuf.append(declStmts);
                mut armsCodeBuf.append(assignStmts);
                mut armsCodeBuf.append(voidStmts);
                mut armsCodeBuf.append(doneVar);
                mut armsCodeBuf.append(" = true; ");
                mut armsCodeBuf.append(bodyEmit);
                mut armsCodeBuf.append(" } ");
                if canTernary {
                    if declStmts =!= "" or branch.kind == ir.VALUE_KIND_NEVER {
                        canTernary = false;
                    } else {
                        mut ternaryConds.pushBack("true");
                        mut ternaryVals.pushBack(branch.code);
                        mut ternaryKinds.pushBack(branch.kind);
                        ternaryCount = ternaryCount + 1;
                    }
                }
            }
        } else if not armDead {
            var innerMatch := "";
            if hasGuard and guardCode =!= "true" {
                gCheck := if isCTarget { guardCode } else { "Boolean(" + guardCode + ")" };
                innerMatch = assignStmts + voidStmts + "if (" + gCheck + ") { " + doneVar + " = true; " + bodyEmit + " }";
            } else {
                innerMatch = assignStmts + voidStmts + doneVar + " = true; " + bodyEmit;
            }
            armCheck := if patCond == "true" {
                innerMatch
            } else if isCTarget and patCond.startsWithAt(0, "/*@COR@*/") {
                canTernary = false;
                patCond.slice(9, patCond.length()) + "if (lt_or) { " + innerMatch + " }"
            } else {
                pCheck := if isCTarget { patCond } else { "Boolean(" + patCond + ")" };
                "if (" + pCheck + ") { " + innerMatch + " }"
            };
            mut armsCodeBuf.append("if (!");
            mut armsCodeBuf.append(doneVar);
            mut armsCodeBuf.append(") { ");
            mut armsCodeBuf.append(declStmts);
            mut armsCodeBuf.append(armCheck);
            mut armsCodeBuf.append(" } ");
            emittedRuntimeArms = emittedRuntimeArms + 1;
            if canTernary {
                if declStmts =!= "" or branch.kind == ir.VALUE_KIND_NEVER {
                    canTernary = false;
                } else {
                    tCond := if hasGuard and guardCode =!= "true" {
                        if patCond == "true" { guardCode } else { "((" + patCond + ") && (" + guardCode + "))" }
                    } else {
                        patCond
                    };
                    mut ternaryConds.pushBack(tCond);
                    mut ternaryVals.pushBack(branch.code);
                    mut ternaryKinds.pushBack(branch.kind);
                    ternaryCount = ternaryCount + 1;
                }
            }
        }
        armCount = armCount + 1;
        cursor = branch.next;
    }
    finalKind := if isStmtLike {
        if allNever { ir.VALUE_KIND_NEVER } else { ir.VALUE_KIND_UNIT }
    } else {
        resultKind
    };
    if hasDirectWin {
        if winDeclStmts == "" and (subj.constant or (isCTarget and canTernary)) {
            if mode == "value" {
                directCode := ctx.assignValueCode(target, finalKind, winBranchKind, winBranchCode);
                directConst := subj.constant and winBranchConst and (winBranchKind == finalKind or (numeric.isIntKind(finalKind) and numeric.isIntKind(winBranchKind)));
                return (code = directCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
                isDirect = true, constant = directConst, intValue = if directConst { winBranchInt } else { 0 },
                textValue = if directConst { winBranchText } else { "" });
            }
            if isStmtLike {
                return (code = winBranchCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
                isDirect = true, constant = false, intValue = 0, textValue = "");
            }
            directStmt := ctx.condBranchStmtCode(target, resolvedValKind, condValVar, winBranchKind, winBranchCode);
            return (code = directStmt, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
            isDirect = true, constant = false, intValue = 0, textValue = "");
        }
        directBody := if isStmtLike {
            winBranchCode
        } else if mode == "iife" {
            ctx.condBranchStmtCode(target, resolvedValKind, condValVar, winBranchKind, winBranchCode)
        } else if isCTarget {
            ctx.cUnwrapIntoVar(cMatchValVar, winBranchKind, ctx.assignValueCode(target, finalKind, winBranchKind, winBranchCode))
        } else {
            "return (" + ctx.assignValueCode(target, finalKind, winBranchKind, winBranchCode) + ");"
        };
        subjPrefix := if subj.constant and winDeclStmts == "" { "" }
        else if isCTarget { if subjVar == subj.code { "" } else { types.cValueType(subj.kind) + " " + subjVar + " = " + subj.code + "; (void)" + subjVar + "; " } }
        else { if subjVar == subj.code { "" } else { "const " + subjVar + subjTsType + " = " + subj.code + "; void " + subjVar + "; " } };
        winArmsCode := subjPrefix + winDeclStmts + winAssignStmts + winVoidStmts + directBody + " ";
        if mode == "value" {
            if isCTarget {
                cDecl := if finalKind == ir.VALUE_KIND_UNIT or finalKind == ir.VALUE_KIND_NEVER { "" } else { types.cValueType(finalKind) + " " + cMatchValVar + "; " };
                cRetTok := if finalKind == ir.VALUE_KIND_UNIT or finalKind == ir.VALUE_KIND_NEVER { "0" } else { cMatchValVar };
                return (code = "/*@CBLK:" + cRetTok + "@*/" + cDecl + winArmsCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
                isDirect = true, constant = false, intValue = 0, textValue = "");
            }
            retType := types.tsFunctionType(finalKind);
            return (code = "(((): " + retType + " => { " + winArmsCode + "})())", kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
            isDirect = true, constant = false, intValue = 0, textValue = "");
        }
        return (code = winArmsCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers, isDirect = false, constant = false, intValue = 0, textValue = "");
    }
    armsCode := armsCodeBuf.build();
    if canTernary and ternaryCount >= 1 {
        var tExpr := ctx.assignValueCode(target, finalKind, ternaryKinds[ternaryCount - 1], ternaryVals[ternaryCount - 1]);
        var ti := ternaryCount - 2;
        loop ti >= 0 {
            tVal := ctx.assignValueCode(target, finalKind, ternaryKinds[ti], ternaryVals[ti]);
            tExpr = "((" + ternaryConds[ti] + ") ? (" + tVal + ") : (" + tExpr + "))";
            ti = ti - 1;
        }
        return (code = tExpr, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
        isDirect = true, constant = false, intValue = 0, textValue = "");
    }
    if isCTarget and mode == "value" {
        cDecl := if finalKind == ir.VALUE_KIND_UNIT or finalKind == ir.VALUE_KIND_NEVER { "" } else {
            types.cValueType(finalKind) + " " + cMatchValVar + " = " + ctx.zeroParsed(ir.TARGET_C, finalKind, 0).code + "; "
        };
        cRetTok := if finalKind == ir.VALUE_KIND_UNIT or finalKind == ir.VALUE_KIND_NEVER { "0" } else { cMatchValVar };
        cSubjLead := if armsCode.startsWithAt(0, types.cValueType(subj.kind) + " " + subjVar) { "" }
        else if subjVar == subj.code { "bool " + doneVar + " = false; " }
        else { types.cValueType(subj.kind) + " " + subjVar + " = " + subj.code + "; (void)" + subjVar + "; bool " + doneVar + " = false; " };
        return (code = "/*@CBLK:" + cRetTok + "@*/" + cDecl + cSubjLead + armsCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers,
        isDirect = true, constant = false, intValue = 0, textValue = "");
    }
    (code = armsCode, kind = finalKind, allNever = allNever, next = cursor, markers = matchMarkers, isDirect = false, constant = false, intValue = 0, textValue = "")
};

/** Parses a loop-tail subject-based `match <subject> { ... }` where matching arms commit to the loop and non-matching iterations leave `.value`/`.collected` untouched. */
parseSubjectMatchLoopTail := fn(target: String, source: String, matchStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    matchBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_MATCH, phase = ir.CTX_PHASE_BODY,
    iifeDepth = iifeDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
    res := parseSubjectMatchBody(target, source, matchStart, prefix, locals, functions, params, currentName, expected, matchBarrierCtxs, iifeDepth, inferMode, "loopTail", "", "", aliases);
    stmtCode := if res.isDirect {
        if res.code == "" { "" } else { "{ " + res.code + " }" }
    } else {
        "{ " + res.code + "}"
    };
    ctx.withMarkers((kind = res.kind, code = stmtCode, intValue = 0, textValue = "", constant = false, next = res.next), res.markers)
};

/** Parses a statement-position subject-based `match <subject> { ... }` (used from `frontend.lts` and `parseBlockExpr`). */
pub parseSubjectMatchStmt := fn(target: String, source: String, matchStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    matchBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = ir.CTX_KIND_MATCH, phase = ir.CTX_PHASE_BODY,
    iifeDepth = iifeDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "", iterLabel = "",
    countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
    res := parseSubjectMatchBody(target, source, matchStart, prefix, locals, functions, params, currentName, "", matchBarrierCtxs, iifeDepth, inferMode, "stmt", "", "", aliases);
    stmtCode := if target == ir.TARGET_C {
        if res.code == "" { "" } else { "{ /*c-stmt*/ " + res.code + " }" }
    } else if res.isDirect {
        if res.code == "" { "" } else { "{ " + res.code + " }" }
    } else {
        "{ " + res.code + "}"
    };
    ctx.withMarkers((kind = res.kind, code = stmtCode, intValue = 0, textValue = "", constant = false, next = res.next), res.markers)
};

/** Parses `[@tag] if ... [else ...]` and `[@tag] match [subject] { ... }` value expressions with optional `then` and `finally`. */
parseCondExpr := fn(target: String, source: String, condParseKind: String, condParseStart: Int, condParseTag: String, condParseTagAt: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    isSubjectMatch := if condParseKind == ir.CTX_KIND_MATCH {
        openMatchCheck := syntax.skipTrivia(source, condParseStart + 5, prefix);
        syntax.rejectMisplacedTag(source, openMatchCheck, prefix, "block tag cannot appear before { in match");
        openMatchCheck < source.length() and source.at(openMatchCheck) =!= "{"
    } else {
        false
    };
    rawCondEnd := if condParseKind == ir.CTX_KIND_IF {
        syntax.scanRawIfChainEnd(source, condParseStart, prefix, true)
    } else {
        syntax.scanRawMatchEnd(source, condParseStart, prefix)
    };
    afterRawCond := if rawCondEnd >= 0 { syntax.skipTrivia(source, rawCondEnd, prefix) } else { -1 };
    hasActualThen := afterRawCond >= 0 and source.wordAt(afterRawCond, "then");
    afterOptThen := if hasActualThen { syntax.scanTrailingThenEnd(source, rawCondEnd, prefix, false) } else { rawCondEnd };
    afterOptThenTrivia := if afterOptThen >= 0 { syntax.skipTrivia(source, afterOptThen, prefix) } else { -1 };
    hasActualFinally := afterOptThenTrivia >= 0 and source.wordAt(afterOptThenTrivia, "finally");
    useIifeCond := condParseTag =!= "" or hasActualThen or hasActualFinally;
    if not useIifeCond {
        isComptimeExpr := sym.localIndex(locals, "$comptimeActive") >= 0;
        condBarrierCtxs := ctx.appendCtx(ctxs, (id = 0, tag = "", kind = condParseKind, phase = ir.CTX_PHASE_BODY,
        iifeDepth = iifeDepth, valKind = "", valVar = "", label = "", iterLabel = "",
        countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = ""));
        if condParseKind == ir.CTX_KIND_IF {
            var cursor := syntax.skipTrivia(source, condParseStart + 2, prefix);
            var ifMarkers := "";
            syntax.rejectHeaderBlockTag(source, cursor, prefix, "if");
            conditionStart := cursor;
            condition := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, "", 0, condBarrierCtxs, iifeDepth, inferMode, "", aliases);
            if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, condition); }
            if condition.kind =!= ir.VALUE_KIND_BOOL {
                syntax.failAt(source, conditionStart, prefix, "if condition must be Bool");
            }
            conditionCode := if condition.constant {
                ir.targetBoolLiteralCode(target, condition.intValue =!= 0)
            } else {
                condition.code
            };
            conditionState := if condition.constant { if condition.intValue =!= 0 { 1 } else { 0 } } else { -1 };
            beforeFirstOpen := syntax.skipTrivia(source, condition.next, prefix);
            syntax.rejectMisplacedTag(source, beforeFirstOpen, prefix, "block tag cannot appear before { in if");
            cursor = syntax.expectSymbol(source, beforeFirstOpen, "{", prefix);
            conditionCodes: mut List<String> = [];
            conditionStates: mut List<Int> = [];
            branchCodes: mut List<String> = [];
            branchKinds: mut List<String> = [];
            branchConsts: mut List<Bool> = [];
            branchIntValues: mut List<Int> = [];
            branchTextValues: mut List<String> = [];
            var resultKind := "";
            var branchCount := 0;
            var comptimeWon := false;
            if isComptimeExpr and conditionState == 0 {
                cursor = syntax.scanBraceEnd(source, cursor - 1, prefix);
            } else {
                first := parseBinaryCtx(target, source, cursor - 1, prefix, locals, functions, params, currentName, expected, 0, condBarrierCtxs, iifeDepth, inferMode, "branch", aliases);
                if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, first); }
                cursor = first.next;
                resultKind = first.kind;
                mut branchCodes.pushBack(first.code);
                mut branchKinds.pushBack(first.kind);
                mut branchConsts.pushBack(first.constant);
                mut branchIntValues.pushBack(first.intValue);
                mut branchTextValues.pushBack(first.textValue);
                branchCount = 1;
                if isComptimeExpr and conditionState == 1 {
                    comptimeWon = true;
                } else {
                    mut conditionCodes.pushBack(conditionCode);
                    mut conditionStates.pushBack(conditionState);
                }
            }
            loop true {
                afterBranch := syntax.skipTrivia(source, cursor, prefix);
                if not source.wordAt(afterBranch, "else") {
                    if branchCount == 0 {
                        if minimum >= 0 {
                            syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
                        }
                        return ctx.withMarkers(ctx.zeroParsed(target, ir.VALUE_KIND_UNIT, cursor), ifMarkers);
                    }
                    if comptimeWon and conditionCodes.length() == 0 and branchCount == 1 {
                        break;
                    }
                    if minimum >= 0 or (minimum == -2 and resultKind =!= ir.VALUE_KIND_UNIT) {
                        syntax.failAt(source, afterBranch, prefix, "value if requires a final else");
                    }
                    if resultKind == ir.VALUE_KIND_NEVER {
                        if expected == "" or expected.startsWithAt(0, "TailList<") {
                            syntax.failAt(source, condParseStart, prefix, "partial conditional declaration needs a normally completing value branch; add else");
                        }
                        resultKind = expected;
                    }
                    fallback := ctx.zeroParsed(target, resultKind, cursor);
                    mut branchCodes.pushBack(fallback.code);
                    mut branchKinds.pushBack(resultKind);
                    mut branchConsts.pushBack(fallback.constant);
                    mut branchIntValues.pushBack(fallback.intValue);
                    mut branchTextValues.pushBack(fallback.textValue);
                    branchCount = branchCount + 1;
                    break;
                }
                afterElse := syntax.skipTrivia(source, afterBranch + 4, prefix);
                syntax.rejectMisplacedTag(source, afterElse, prefix, "block tag cannot appear after else");
                if source.wordAt(afterElse, "if") {
                    elseConditionStart := syntax.skipTrivia(source, afterElse + 2, prefix);
                    syntax.rejectHeaderBlockTag(source, elseConditionStart, prefix, "else if");
                    if isComptimeExpr and comptimeWon {
                        elseOpen := syntax.scanConditionOpen(source, elseConditionStart, prefix);
                        if elseOpen < 0 or elseOpen == elseConditionStart {
                            syntax.failAt(source, elseConditionStart, prefix, "expected { after else if");
                        }
                        cursor = syntax.scanBraceEnd(source, elseOpen, prefix);
                        continue;
                    }
                    elseCondition := parseBinaryCtx(target, source, elseConditionStart, prefix, locals, functions, params, currentName, "", 0, condBarrierCtxs, iifeDepth, inferMode, "", aliases);
                    if inferMode { ifMarkers = ctx.collectParsedMarkers(ifMarkers, elseCondition); }
                    if elseCondition.kind =!= ir.VALUE_KIND_BOOL {
                        syntax.failAt(source, elseConditionStart, prefix, "if condition must be Bool");
                    }
                    elseConditionCode := if elseCondition.constant {
                        ir.targetBoolLiteralCode(target, elseCondition.intValue =!= 0)
                    } else {
                        elseCondition.code
                    };
                    elseConditionState := if elseCondition.constant { if elseCondition.intValue =!= 0 { 1 } else { 0 } } else { -1 };
                    beforeElseIfOpen := syntax.skipTrivia(source, elseCondition.next, prefix);
                    syntax.rejectMisplacedTag(source, beforeElseIfOpen, prefix, "block tag cannot appear before { in else if");
                    open := syntax.expectSymbol(source, beforeElseIfOpen, "{", prefix);
