/** Expression, block, conditional, loop, call, and operator precedence parser and lowering for TS and C targets. */

listLib := import "core/list";
sourceLib := import "core/source";
numeric := import "./numeric-literals";
integer := import "core/int";
cLiteral := import "./c-literals";
tsLiteral := import "./ts-literals";
emitFmt := import "./emit-format";
ir := import "./frontend-ir";
sym := import "./symbol-table";
builtinsAbi := import "./builtins-abi";
syntax := import "./frontend-syntax";
types := import "./frontend-types";
generics := import "./generics";
trace := import "./trace-safety";
reach := import "./reachability";
infer := import "./frontend-inference";
ctx := import "./frontend-context";
textLib := import "core/text";
tb := import "util/text-builder";

/** One parsed expression matching `frontend-ir.Parsed`. */
Parsed := alias (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);

/** One local visible to later statements matching `frontend-ir.Local`. */
Local := alias (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String, initState: String);

/** One program or module-graph item matching `frontend-ir.Item`. */
Item := alias (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);

/** Collection of items matching `frontend-ir.Items`. */
Items := alias List<Item>;

/** One previously declared top-level function matching `frontend-ir.FunctionInfo`. */
FunctionInfo := alias (name: String, runtime: String, result: String, first: Int, count: Int, declAt: Int);

/** A later top-level scalar definition matching `frontend-ir.FutureValue`. */
FutureValue := alias (name: String, runtime: String, kind: String, at: Int, mutable: Bool, writable: Bool, initState: String);

/** One transparent type alias matching `frontend-ir.AliasDecl`. */
AliasDecl := alias (name: String, target: String, at: Int, end: Int, depth: Int);

/** Lexical control-flow and metadata context matching `frontend-ir.ConstructCtx`. */
ConstructCtx := alias (id: Int, tag: String, kind: String, phase: String, iifeDepth: Int, valKind: String, valVar: String, label: String, iterLabel: String, countVar: String, itemVar: String, itemKind: String, indexVar: String, hasIndex: Bool, colVar: String);

/** Normalizes expected contextual value kind by erasing non-value sentinels and unwrapping `TailList<T>`. */
normalizeExpectedValueKind := fn(expected: String): String {
    if expected == ir.VALUE_KIND_UNIT or expected == ir.VALUE_KIND_NEVER {
        ""
    } else if expected.startsWithAt(0, "TailList<") {
        "List<" + types.listElementKind(expected.slice(4, expected.length())) + ">"
    } else {
        expected
    }
};

/** Normalizes inferred block/conditional exit kind hints passed from an enclosing context. */
inferHintKind := fn(valKind: String): String {
    if valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":")) {
        valKind.slice(10, valKind.length())
    } else if valKind == ir.VAL_KIND_INFER or valKind == ir.VALUE_KIND_UNIT or valKind == ir.VALUE_KIND_NEVER {
        ""
    } else {
        valKind
    }
};

/** True when `valKind` is a Pass 1 placeholder awaiting exit type inference. */
isInferPlaceholderKind := fn(valKind: String): Bool {
    valKind == ir.VAL_KIND_INFER or valKind.startsWithAt(0, (ir.VAL_KIND_INFER + ":"))
};

/** Parses a trailing `finally { ... }` block and validates ordering against `then` and duplicate `finally`. */
parseFinallyClause := fn(target: String, source: String, afterFinWordPos: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ownerCtxs: List<ConstructCtx>, bodyDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    afterFinKw := syntax.skipTrivia(source, afterFinWordPos + 7, prefix);
    syntax.rejectMisplacedTag(source, afterFinKw, prefix, "block tag cannot appear after finally");
    finOpen := syntax.expectSymbol(source, afterFinKw, "{", prefix);
    finBarrierCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FINALLY, phase = ir.CTX_PHASE_FINALLY,
    iifeDepth = bodyDepth, valKind = ir.VALUE_KIND_UNIT, valVar = "", label = "",
    iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
    finParsed := parseBinaryCtx(target, source, finOpen - 1, prefix, locals, functions, params, currentName,
    "", 0, ctx.appendCtx(ownerCtxs, finBarrierCtx), bodyDepth, inferMode, "finally", aliases);
    afterFinClose := syntax.skipTrivia(source, finParsed.next, prefix);
    size := source.length();
    if afterFinClose < size and source.wordAt(afterFinClose, "then") {
        syntax.failAt(source, afterFinClose, prefix, "then must appear before finally");
    }
    if afterFinClose < size and source.wordAt(afterFinClose, "finally") {
        syntax.failAt(source, afterFinClose, prefix, "duplicate finally block");
    }
    finParsed
};

/** Emits a `try { ... } finally { ... }` IIFE result for Pass 1 (marker-carrying) or Pass 2 codegen. */
finishFinallyIife := fn(tryBody: String, finParsed: Parsed, normalKind: String, leftForMarkers: Parsed, inferMode: Bool): Parsed {
    finalKind := if finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { normalKind };
    if inferMode {
        merged := ctx.collectParsedMarkers(ctx.collectParsedMarkers("", leftForMarkers), finParsed);
        return ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = finParsed.next), merged);
    }
    (kind = finalKind, code = "(() => { try { " + tryBody + " } finally { " + finParsed.code + " } })()",
    intValue = 0, textValue = "", constant = false, next = finParsed.next)
};

/** Wraps a C11 expression/block with a `finally` clause, rewriting early `return` and outer `goto` exits to run `finParsed.code`. */
finishFinallyC := fn(tryCode: String, finParsed: Parsed, normalKind: String, leftForMarkers: Parsed, inferMode: Bool, ctxs: List<ConstructCtx>, finId: Int): Parsed {
    finalKind := if finParsed.kind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { normalKind };
    if inferMode {
        merged := ctx.collectParsedMarkers(ctx.collectParsedMarkers("", leftForMarkers), finParsed);
        return ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = finParsed.next), merged);
    }
    fnIdx := ctx.findCtxByKindIndex(ctxs, "fn");
    fnRetKind := if fnIdx >= 0 { ctxs[fnIdx].valKind } else { "" };
    if normalKind == ir.VALUE_KIND_UNIT or normalKind == ir.VALUE_KIND_NEVER {
        unwrapped := ctx.cUnwrapIntoVar("", normalKind, tryCode);
        rewritten := ctx.cRewriteFinallyExits(unwrapped, finParsed.code, fnRetKind, finId);
        return (kind = finalKind, code = "/*@CBLK:0@*/{ " + rewritten + " { " + finParsed.code + " } }",
        intValue = 0, textValue = "", constant = false, next = finParsed.next);
    }
    finVar := "lt_finv_" + finId.toText();
    unwrapped := ctx.cUnwrapIntoVar(finVar, normalKind, tryCode);
    rewritten := ctx.cRewriteFinallyExits(unwrapped, finParsed.code, fnRetKind, finId);
    (kind = finalKind, code = "/*@CBLK:" + finVar + "@*/" + types.cValueType(normalKind) + " " + finVar + " = " +
    ctx.zeroParsed(ir.TARGET_C, normalKind, 0).code + "; { " + rewritten + " { " + finParsed.code + " } }",
    intValue = 0, textValue = "", constant = false, next = finParsed.next)
};

/** Attempts to parse an optionally parenthesized `mut` binding lease (`mut x`, `(mut x)`, `(((((mut x)))))`, `mut (x)`, `(((mut ((x)))))`). */
tryParseGroupedMutLease := fn(source: String, start: Int, prefix: String, requireOuterParen: Bool): (matched: Bool, sawMut: Bool, mutStart: Int, nameStart: Int, nameEnd: Int, next: Int) {
    sourceSize := source.length();
    var cur := start;
    var openCount := 0;
    loop cur < sourceSize and source.at(cur) == "(" {
        openCount += 1;
        cur = syntax.skipTrivia(source, cur + 1, prefix);
    }
    if requireOuterParen and openCount == 0 {
        return (matched = false, sawMut = false, mutStart = 0, nameStart = 0, nameEnd = 0, next = start);
    }
    if not source.wordAt(cur, "mut") {
        return (matched = false, sawMut = false, mutStart = 0, nameStart = 0, nameEnd = 0, next = start);
    }
    mutStart := cur;
    var nameCur := syntax.skipTrivia(source, cur + 3, prefix);
    var recvOpen := 0;
    loop nameCur < sourceSize and source.at(nameCur) == "(" {
        recvOpen += 1;
        nameCur = syntax.skipTrivia(source, nameCur + 1, prefix);
    }
    if nameCur >= sourceSize or not source.at(nameCur).isNameStart() {
        return (matched = false, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = nameCur, next = start);
    }
    mNameEnd := source.skipName(nameCur);
    var closeCur := syntax.skipTrivia(source, mNameEnd, prefix);
    needClose := recvOpen + openCount;
    var closed := 0;
    loop closed < needClose {
        if closeCur >= sourceSize or source.at(closeCur) =!= ")" {
            return (matched = false, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = mNameEnd, next = start);
        }
        closed += 1;
        closeCur = syntax.skipTrivia(source, closeCur + 1, prefix);
    }
    (matched = true, sawMut = true, mutStart = mutStart, nameStart = nameCur, nameEnd = mNameEnd, next = closeCur)
};

/** Parses `()`, a parenthesized expression, or a named/positional flat tuple literal starting at `start`. */
parseParenOrTupleExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    sourceSize := source.length();
    if source.at(syntax.skipTrivia(source, start + 1, prefix)) == ")" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = syntax.skipTrivia(source, start + 1, prefix) + 1);
    }
    mutLease := tryParseGroupedMutLease(source, start, prefix, true);
    if mutLease.matched {
        return parseMutReceiverCallExpr(target, source, mutLease.mutStart, mutLease.nameStart, mutLease.nameEnd, mutLease.next, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if syntax.looksLikeTupleEntry(source, start + 1, prefix) {
        var cursor := syntax.skipTrivia(source, start + 1, prefix);
        labels: mut List<String> = [];
        codes: mut List<String> = [];
        kinds: mut List<String> = [];
        var tupleMarkers := "";
        var count := 0;
        loop cursor < sourceSize and source.at(cursor) =!= ")" {
            var label := "";
            var valueStart := cursor;
            var value := ctx.intParsed("", 0, true, cursor);
            if syntax.isSingleEquals(source, cursor) {
                nameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if nameStart >= sourceSize or not source.at(nameStart).isNameStart() {
                    syntax.failAt(source, nameStart, prefix, "expected a tuple field name after =");
                }
                nameEnd := source.skipName(nameStart);
                label = source.slice(nameStart, nameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, nameStart, label, prefix); }
                if labels.contains(label) {
                    syntax.failAt(source, nameStart, prefix, "duplicate tuple field " + label);
                }
                valueStart = nameStart;
                fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                value = parseBinaryCtx(target, source, nameStart, prefix, locals, functions, params, currentName, fieldExpected, 30, ctxs, iifeDepth, inferMode, "", aliases);
            } else if cursor < sourceSize and source.at(cursor).isNameStart() {
                nameEnd := source.skipName(cursor);
                afterName := syntax.skipTrivia(source, nameEnd, prefix);
                if syntax.isSingleEquals(source, afterName) {
                    label = source.slice(cursor, nameEnd);
                    if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, cursor, label, prefix); }
                    if labels.contains(label) {
                        syntax.failAt(source, cursor, prefix, "duplicate tuple field " + label);
                    }
                    valueStart = syntax.skipTrivia(source, afterName + 1, prefix);
                    fieldExpected := if types.isTupleKind(expected) { types.tupleFieldKind(expected, label) } else { "" };
                    value = parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                } else {
                    fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                    value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
                }
            } else {
                fieldExpected := if types.isTupleKind(expected) and count < types.tupleComponentCount(expected) { types.tupleComponent(expected, count).kind } else { "" };
                value = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, fieldExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
            }
            if inferMode { tupleMarkers = ctx.collectParsedMarkers(tupleMarkers, value); }
            if types.isTupleKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "nested tuple values are not supported");
            }
            if types.isListKind(value.kind) {
                syntax.failAt(source, valueStart, prefix, "list values inside tuples are not supported");
            }
            if value.kind == ir.VALUE_KIND_UNIT or value.kind == ir.VALUE_KIND_NEVER {
                failName := if label =!= "" { label } else { count.toText() };
                syntax.failAt(source, valueStart, prefix, "tuple field " + failName + " cannot be " + types.displayKind(value.kind));
            }
            (mut labels).pushBack(label);
            mut codes.pushBack(value.code);
            mut kinds.pushBack(value.kind);
            count = count + 1;
            cursor = syntax.skipTrivia(source, value.next, prefix);
            if cursor < sourceSize and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = syntax.expectSymbol(source, cursor, ")", prefix);
        kindTextBuf: mut tb.TextBuilder;
        mut kindTextBuf.append("(");
        var index := 0;
        loop index < count {
            if index > 0 { mut kindTextBuf.append(","); }
            mut kindTextBuf.append(labels[index]);
            mut kindTextBuf.append(":");
            mut kindTextBuf.append(kinds[index]);
            index = index + 1;
        }
        mut kindTextBuf.append(")");
        tupleKind := kindTextBuf.build();
        if target == ir.TARGET_C and types.cStructTag(tupleKind) =!= "" {
            tag := types.cStructTag(tupleKind);
            if count == 0 {
                return ctx.withMarkers((kind = tupleKind, code = "/*@T:" + tupleKind + "@*/((" + tag + "){ ._empty = 0 })", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
            }
            cCodeBuf: mut tb.TextBuilder;
            var ci := 0;
            loop ci < count {
                if ci > 0 { mut cCodeBuf.append(", "); }
                mut cCodeBuf.append(".");
                mut cCodeBuf.append(types.cFieldName(types.tupleRuntimeProp(labels[ci], ci)));
                mut cCodeBuf.append(" = ");
                mut cCodeBuf.append(codes[ci]);
                ci = ci + 1;
            }
            return ctx.withMarkers((kind = tupleKind, code = "/*@T:" + tupleKind + "@*/((" + tag + "){ " + cCodeBuf.build() + " })", intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
        }
        codeBuf: mut tb.TextBuilder;
        mut codeBuf.append("{ ");
        var ti := 0;
        loop ti < count {
            if ti > 0 { mut codeBuf.append(", "); }
            mut codeBuf.append(types.tupleObjectKey(labels[ti], ti));
            mut codeBuf.append(": ");
            mut codeBuf.append(codes[ti]);
            ti = ti + 1;
        }
        mut codeBuf.append(" }");
        return ctx.withMarkers((kind = tupleKind, code = codeBuf.build(), intValue = 0, textValue = "", constant = false, next = cursor), tupleMarkers);
    }
    var groupedExpected := expected;
    if numeric.isNumericKind(expected) {
        groupEnd := syntax.scanParenEnd(source, start, prefix);
        if groupEnd >= 0 and syntax.binaryFollows(source, groupEnd, prefix, minimum) { groupedExpected = ""; }
    }
    inner := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, groupedExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
    next := syntax.expectSymbol(source, syntax.skipTrivia(source, inner.next, prefix), ")", prefix);
    ctx.withMarkers((kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next),
    if inferMode { ctx.collectParsedMarkers("", inner) } else { "" })
};

/** Parses prefix unary `+` or `-` (numeric literals or general runtime operands). */
parseUnarySignExpr := fn(target: String, source: String, start: Int, ch: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    after := syntax.skipTrivia(source, start + 1, prefix);
    if after < source.length() and source.at(after).isDigit() {
        litExpected := if ch == "-" { expected } else { "" };
        return syntax.parseNumber(target, source, start, prefix, litExpected, minimum);
    }
    operand := parseBinaryCtx(target, source, start + 1, prefix, locals, functions, params, currentName, "", 30, ctxs, iifeDepth, inferMode, "", aliases);
    operandLoopId := types.loopValMarkerId(operand.kind);
    if inferMode and operandLoopId >= 0 {
        if expected =!= "" and expected =!= ir.VALUE_KIND_UNIT and expected =!= ir.VALUE_KIND_NEVER and numeric.isNumericKind(expected) {
            return ctx.withMarkers((kind = expected, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
            ctx.collectParsedMarkers("", operand) + operandLoopId.toText() + "=" + expected + "\n");
        }
        return ctx.withMarkers((kind = operand.kind, code = "", intValue = 0, textValue = "", constant = false, next = operand.next),
        ctx.collectParsedMarkers("", operand));
    }
    if not numeric.isNumericKind(operand.kind) {
        syntax.failAt(source, start, prefix, "unary " + ch + " requires an Int or Float operand");
    }
    code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
    if numeric.isFloatKind(operand.kind) {
        return ctx.withMarkers((kind = operand.kind, code = code, intValue = 0, textValue = "", constant = false, next = operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if operand.constant {
        folded := if ch == "-" { operand.intValue.checkedNeg() } else { (value = operand.intValue, ok = true) };
        if folded.ok and numeric.intKindFits(operand.kind, folded.value) {
            return ctx.typedIntParsed(operand.kind, code, folded.value, true, operand.next);
        }
    }
    runtimeCode := if ch == "-" {
        rawNeg := ir.targetIntNegateCode(target, operand.code, start);
        if numeric.isNarrowIntKind(operand.kind) { ir.targetCheckedNarrowIntCode(target, operand.kind, rawNeg, start) } else { rawNeg }
    } else {
        code
    };
    ctx.withMarkers(ctx.typedIntParsed(operand.kind, runtimeCode, 0, false, operand.next),
    if inferMode { ctx.collectParsedMarkers("", operand) } else { "" })
};

/** Parses `[a, b, ...]` list/array/set literals and `[k = v, ...]` map literals starting at `start`. */
parseListOrArrayExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var cursor := syntax.skipTrivia(source, start + 1, prefix);
    isTailList := expected.startsWithAt(0, "TailList<");
    isListAny := expected == "$ListAny";
    isMapTarget := types.isMapKind(expected);
    isSetTarget := types.isSetKind(expected);
    isListTarget := types.isListKind(expected) or isTailList or isListAny;

    /* Empty bracket literal `[]` with Map<K, V> or Set<T> expected type */
    if cursor < source.length() and source.at(cursor) == "]" {
        if isMapTarget {
            close := syntax.expectSymbol(source, cursor, "]", prefix);
            if target == ir.TARGET_C {
                mTag := types.cMapTag(expected);
                if mTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Map yet"); }
                return (kind = expected, code = "/*@T:" + expected + "@*/" + mTag + "_from(0, NULL)",
                intValue = 0, textValue = "", constant = false, next = close);
            }
            kKind := types.mapKeyKind(expected);
            vKind := types.mapValueKind(expected);
            return (kind = expected, code = "new Map<" + types.tsFunctionType(kKind) + ", " + types.tsFunctionType(vKind) + ">()",
            intValue = 0, textValue = "", constant = false, next = close);
        }
        if isSetTarget {
            close := syntax.expectSymbol(source, cursor, "]", prefix);
            if target == ir.TARGET_C {
                sTag := types.cSetTag(expected);
                if sTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Set yet"); }
                return (kind = expected, code = "/*@T:" + expected + "@*/" + sTag + "_from(0, NULL)",
                intValue = 0, textValue = "", constant = false, next = close);
            }
            eKind := types.setElementKind(expected);
            return (kind = expected, code = "new Set<" + types.tsFunctionType(eKind) + ">()",
            intValue = 0, textValue = "", constant = false, next = close);
        }
    }

    var elementKind := "";
    if types.isListKind(expected) { elementKind = types.listElementKind(expected); }
    else if isTailList { elementKind = types.listElementKind(expected.slice(4, expected.length())); }
    else if types.isArrayKind(expected) { elementKind = types.arrayElementKind(expected); }
    else if isSetTarget { elementKind = types.setElementKind(expected); }
    else if isMapTarget { elementKind = types.mapKeyKind(expected); }

    /* Non-empty bracket literal: peek after first element for `=` to distinguish Map `[k = v, ...]` from List/Array/Set `[a, b, ...]`. */
    if cursor < source.length() and source.at(cursor) =!= "]" {
        firstStart := cursor;
        firstElem := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        afterFirst := syntax.skipTrivia(source, firstElem.next, prefix);
        if afterFirst < source.length() and syntax.isSingleEquals(source, afterFirst) {
            var keyKind := if isMapTarget { types.mapKeyKind(expected) } else { "" };
            var valKind := if isMapTarget { types.mapValueKind(expected) } else { "" };
            entryCodes: mut List<String> = [];
            cEntryCodes: mut List<String> = [];
            var mapMarkers := "";
            var entryCount := 0;
            var curKeyStart := firstStart;
            var curKey := firstElem;
            var curEq := afterFirst;
            loop true {
                if inferMode { mapMarkers = ctx.collectParsedMarkers(mapMarkers, curKey); }
                if not types.isMapKeyKind(curKey.kind) {
                    syntax.failAt(source, curKeyStart, prefix, "unsupported map key type " + types.displayKind(curKey.kind));
                }
                if keyKind == "" {
                    keyKind = curKey.kind;
                } else if not types.isCompatibleKind(keyKind, curKey.kind) {
                    syntax.failAt(source, curKeyStart, prefix, "map entry " + (entryCount + 1).toText() + " key must be " +
                    types.displayKind(keyKind) + ", got " + types.displayKind(curKey.kind));
                }
                valStart := syntax.skipTrivia(source, curEq + 1, prefix);
                valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, valKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
                if inferMode { mapMarkers = ctx.collectParsedMarkers(mapMarkers, valParsed); }
                if valParsed.kind == ir.VALUE_KIND_UNIT or valParsed.kind == ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, valStart, prefix, "map entry " + (entryCount + 1).toText() + " value cannot be " + types.displayKind(valParsed.kind));
                }
                if valKind == "" {
                    valKind = valParsed.kind;
                } else if not types.isCompatibleKind(valKind, valParsed.kind) {
                    syntax.failAt(source, valStart, prefix, "map entry " + (entryCount + 1).toText() + " value must be " +
                    types.displayKind(valKind) + ", got " + types.displayKind(valParsed.kind));
                }
                kCode := ctx.assignValueCode(target, keyKind, curKey.kind, curKey.code);
                vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
                mut entryCodes.pushBack("[" + kCode + ", " + vCode + "]");
                mut cEntryCodes.pushBack("{ " + kCode + ", " + vCode + " }");
                entryCount = entryCount + 1;
                cursor = syntax.skipTrivia(source, valParsed.next, prefix);
                if cursor < source.length() and source.at(cursor) == "," {
                    cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                    if cursor < source.length() and source.at(cursor) == "]" { break; }
                    curKeyStart = cursor;
                    curKey = parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, keyKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
                    curEq = syntax.skipTrivia(source, curKey.next, prefix);
                    if curEq >= source.length() or not syntax.isSingleEquals(source, curEq) {
                        syntax.failAt(source, curEq, prefix, "expected = after map key");
                    }
                } else {
                    break;
                }
            }
            cursor = syntax.expectSymbol(source, cursor, "]", prefix);
            mapKind := "Map<" + keyKind + "," + valKind + ">";
            if target == ir.TARGET_C {
                mTag := types.cMapTag(mapKind);
                if mTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Map yet"); }
                return ctx.withMarkers((kind = mapKind,
                code = "/*@T:" + mapKind + "@*/" + mTag + "_from(" + entryCount.toText() + ", (const " + mTag + "_entry[]){" + cEntryCodes.join(", ") + "})",
                intValue = 0, textValue = "", constant = false, next = cursor), mapMarkers);
            }
            return ctx.withMarkers((kind = mapKind,
            code = "new Map<" + types.tsFunctionType(keyKind) + ", " + types.tsFunctionType(valKind) + ">([" + entryCodes.join(", ") + "])",
            intValue = 0, textValue = "", constant = false, next = cursor), mapMarkers);
        }
        if isMapTarget {
            syntax.failAt(source, afterFirst, prefix, "expected = after map key in Map literal");
        }
    }

    elementCodes: mut List<String> = [];
    var listMarkers := "";
    var count := 0;
    loop true {
        if cursor >= source.length() {
            syntax.failAt(source, cursor, prefix, "expected ] in list literal");
        }
        if source.at(cursor) == "]" { break; }
        elementStart := cursor;
        element := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { listMarkers = ctx.collectParsedMarkers(listMarkers, element); }
        if element.kind == ir.VALUE_KIND_UNIT and elementKind =!= ir.VALUE_KIND_UNIT {
            syntax.failAt(source, elementStart, prefix, "list element " + (count + 1).toText() + " cannot be Unit");
        }
        if types.isListKind(element.kind) {
            syntax.failAt(source, elementStart, prefix, "nested list types are not supported");
        }
        if elementKind == "" {
            if element.kind =!= ir.VALUE_KIND_NEVER { elementKind = element.kind; }
        } else {
            compatible := if isListTarget or isSetTarget { types.isCompatibleKind(elementKind, element.kind) }
            else { element.kind == ir.VALUE_KIND_NEVER or element.kind == elementKind or types.fnShapeMatches(elementKind, element.kind) };
            if not compatible {
                syntax.failAt(source, elementStart, prefix, "list element " + (count + 1).toText() + " must be " +
                types.displayKind(elementKind) + ", got " + types.displayKind(element.kind));
            }
        }
        (mut elementCodes).pushBack(ctx.assignValueCode(target, elementKind, element.kind, element.code));
        count = count + 1;
        cursor = syntax.skipTrivia(source, element.next, prefix);
        if count == 1 and cursor < source.length() and source.at(cursor) == ";" {
            if isSetTarget {
                syntax.failAt(source, cursor, prefix, "repeat literal [val; N] is not valid for Set");
            }
            if elementKind == "" {
                syntax.failAt(source, elementStart, prefix, "repeat array element cannot be Never");
            }
            countStart := syntax.skipTrivia(source, cursor + 1, prefix);
            countExpr := parseBinaryCtx(target, source, countStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { listMarkers = ctx.collectParsedMarkers(listMarkers, countExpr); }
            if not countExpr.constant or not numeric.isIntKind(countExpr.kind) {
                syntax.failAt(source, countStart, prefix, "repeat array count must be a compile-time Int constant");
            }
            if countExpr.intValue < 0 {
                syntax.failAt(source, countStart, prefix, "repeat array count cannot be negative");
            }
            if countExpr.intValue > 65536 {
                syntax.failAt(source, countStart, prefix, "repeat array count exceeds maximum 65536");
            }
            repEnd := syntax.expectSymbol(source, syntax.skipTrivia(source, countExpr.next, prefix), "]", prefix);
            repeatCount := countExpr.intValue;
            repResultKind := if types.isListKind(expected) or isListAny {
                "List<" + elementKind + ">"
            } else {
                "[" + elementKind + ";" + repeatCount.toText() + "]"
            };
            elemValCode := elementCodes[0];
            repCode := if target == ir.TARGET_C and types.cListTag(elementKind) =!= "" {
                cTag := types.cListTag(elementKind);
                if repeatCount == 0 {
                    if element.constant {
                        "/*@T:" + repResultKind + "@*/lt_list_" + cTag + "_from(0, NULL)"
                    } else {
                        "/*@T:" + repResultKind + "@*/((void)(" + elemValCode + "), lt_list_" + cTag + "_from(0, NULL))"
                    }
                } else {
                    "/*@T:" + repResultKind + "@*/lt_list_" + cTag + "_repeat(" + repeatCount.toText() + ", " + elemValCode + ")"
                }
            } else {
                tsElem := types.tsFunctionType(elementKind);
                tsSlot := ctx.tsDeepCloneValueCode(elementKind, "lite$v");
                if repeatCount == 0 {
                    if element.constant {
                        "[]"
                    } else {
                        "((lite$v: " + tsElem + "): " + tsElem + "[] => { void lite$v; return []; })(" + elemValCode + ")"
                    }
                } else if element.constant and tsSlot == "lite$v" and repeatCount <= 32 {
                    repBuf: mut tb.TextBuilder;
                    mut repBuf.append("[");
                    var ri := 0;
                    loop ri < repeatCount {
                        if ri > 0 { mut repBuf.append(", "); }
                        mut repBuf.append(elemValCode);
                        ri = ri + 1;
                    }
                    mut repBuf.append("]");
                    repBuf.build()
                } else {
                    "((lite$v: " + tsElem + "): " + tsElem + "[] => { const lite$a: " + tsElem + "[] = []; for (let lite$i = 0; lite$i < " + repeatCount.toText() + "; lite$i += 1) { lite$a.push(" + tsSlot + "); } return lite$a; })(" + elemValCode + ")"
                }
            };
            return ctx.withMarkers((kind = repResultKind, code = repCode, intValue = 0, textValue = "", constant = false, next = repEnd), listMarkers);
        }
        if cursor < source.length() and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    cursor = syntax.expectSymbol(source, cursor, "]", prefix);
    if isSetTarget {
        if target == ir.TARGET_C {
            sTag := types.cSetTag(expected);
            if sTag == "" { syntax.failAt(source, start, prefix, "C backend does not support Set yet"); }
            kTag := types.cMapKeyTag(elementKind);
            cArrType := "const " + types.cListElemType(kTag);
            sCode := if count == 0 {
                "/*@T:" + expected + "@*/" + sTag + "_from(0, NULL)"
            } else {
                "/*@T:" + expected + "@*/" + sTag + "_from(" + count.toText() + ", (" + cArrType + "[]){" + elementCodes.join(", ") + "})"
            };
            return ctx.withMarkers((kind = expected, code = sCode, intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
        }
        return ctx.withMarkers((kind = expected,
        code = "new Set<" + types.tsFunctionType(elementKind) + ">([" + elementCodes.join(", ") + "])",
        intValue = 0, textValue = "", constant = false, next = cursor), listMarkers);
    }
    if count > 0 and elementKind == "" {
        syntax.failAt(source, start, prefix, "list element 1 cannot be Never");
    }
    if count == 0 and not types.isListKind(expected) and not isTailList and not types.isArrayKind(expected) {
        syntax.failAt(source, start, prefix, "empty list literal requires a List element type");
    }
    resultKind := if types.isListKind(expected) or isListAny or (count == 0 and isTailList) {
        "List<" + elementKind + ">"
    } else {
        "[" + elementKind + ";" + count.toText() + "]"
    };
    listCode := if target == ir.TARGET_C and types.cListTag(elementKind) =!= "" {
        cTag := types.cListTag(elementKind);
        if count == 0 {
            "lt_list_" + cTag + "_from(0, NULL)"
        } else {
            cArrType := "const " + types.cListElemType(cTag);
            "lt_list_" + cTag + "_from(" + count.toText() + ", (" + cArrType + "[]){" + elementCodes.join(", ") + "})"
        }
    } else {
        "[" + elementCodes.join(", ") + "]"
    };
    ctx.withMarkers((kind = resultKind, code = listCode,
    intValue = 0, textValue = "", constant = false, next = cursor), listMarkers)
};

/** Parses `@tag.field`, `@tag { ... }`, and `@tag if/match/loop` prefixes. */
parseTagPrefixExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    tagInfo := syntax.parseTagAt(source, start, prefix);
    afterTag := syntax.skipTrivia(source, tagInfo.next, prefix);
    tagSourceSize := source.length();
    if afterTag < tagSourceSize and source.at(afterTag) == "." {
        fieldStart := syntax.skipTrivia(source, afterTag + 1, prefix);
        if fieldStart >= tagSourceSize or not source.at(fieldStart).isNameStart() {
            syntax.failAt(source, fieldStart, prefix, "expected field name after @" + tagInfo.tag + ".");
        }
        fieldEnd := source.skipName(fieldStart);
        fieldName := source.slice(fieldStart, fieldEnd);
        ctxIdx := ctx.findTaggedCtxIndex(ctxs, tagInfo.tag);
        if ctxIdx < 0 {
            syntax.failAt(source, start, prefix, "unknown block tag @" + tagInfo.tag);
        }
        if ctx.hasFinallyAbove(ctxs, ctxIdx) {
            syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
        }
        c := ctxs[ctxIdx];
        if c.kind == ir.CTX_KIND_IF or c.kind == ir.CTX_KIND_MATCH {
            if fieldName =!= "value" {
                syntax.failAt(source, fieldStart, prefix, "conditional tag @" + tagInfo.tag + " only exposes .value, not ." + fieldName);
            }
            if c.phase =!= ir.CTX_PHASE_THEN {
                syntax.failAt(source, fieldStart, prefix, "@" + tagInfo.tag + ".value is only available inside that conditional's then block");
            }
            if c.itemKind == ir.VALUE_KIND_UNIT or c.itemKind == ir.VALUE_KIND_NEVER or c.itemKind == "" {
                syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose .value for " +
                types.displayKind(if c.itemKind == "" { ir.VALUE_KIND_UNIT } else { c.itemKind }) + " conditional");
            }
            return (kind = c.itemKind, code = c.itemVar, intValue = 0, textValue = "", constant = false, next = fieldEnd);
        }
        if c.kind == ir.CTX_KIND_LOOP {
            if c.phase == ir.CTX_PHASE_FINALLY {
                syntax.failAt(source, fieldStart, prefix, "metadata for @" + tagInfo.tag + " is not available in finally");
            }
            return ctx.resolveLoopField(target, c, fieldName, expected, source, fieldStart, fieldEnd, prefix);
        }
        syntax.failAt(source, fieldStart, prefix, "block tag @" + tagInfo.tag + " does not expose ." + fieldName);
    }
    if afterTag < tagSourceSize and source.at(afterTag) == "{" {
        isCTagBlk := target == ir.TARGET_C;
        hintExpected := normalizeExpectedValueKind(expected);
        blockId := ctx.nextCtxId(ctxs);
        blockLabel := if isCTagBlk { "lt_b_" + blockId.toText() } else { "lite$b" + blockId.toText() };
        blockValVar := if isCTagBlk { "lt_bval_" + blockId.toText() } else { "lite$val" + blockId.toText() };
        tagDepth := if isCTagBlk { iifeDepth } else { iifeDepth + 1 };
        taggedLexDepthStr := (ir.maxLocalLexDepth(locals) + 1).toText();
        pass1ValKind := if hintExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + hintExpected };
        pass1Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
        iifeDepth = tagDepth, valKind = pass1ValKind, valVar = blockValVar, label = blockLabel,
        iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        pass1 := parseBinaryCtx(target, source, afterTag, prefix, locals, functions, params, currentName,
        hintExpected, 0, ctx.appendCtx(ctxs, pass1Ctx), tagDepth, true, "tagged", aliases);
        var result := pass1;
        if not inferMode {
            inferredKind := pass1.kind;
            pass2Expected := if inferredKind == ir.VALUE_KIND_UNIT or inferredKind == ir.VALUE_KIND_NEVER { "" } else { inferredKind };
            pass2Ctx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_BODY,
            iifeDepth = tagDepth, valKind = inferredKind, valVar = blockValVar, label = blockLabel,
            iterLabel = taggedLexDepthStr, countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
            result = parseBinaryCtx(target, source, afterTag, prefix, locals, functions, params, currentName,
            pass2Expected, 0, ctx.appendCtx(ctxs, pass2Ctx), tagDepth, false, "tagged", aliases);
        }
        afterTaggedClose := syntax.skipTrivia(source, result.next, prefix);
        if afterTaggedClose < tagSourceSize and source.wordAt(afterTaggedClose, "then") {
            syntax.failAt(source, afterTaggedClose, prefix, "then requires an if, match, or loop");
        }
        if afterTaggedClose < tagSourceSize and source.wordAt(afterTaggedClose, "finally") {
            taggedFinCtx := (id = blockId, tag = tagInfo.tag, kind = ir.CTX_KIND_BLOCK, phase = ir.CTX_PHASE_FINALLY,
            iifeDepth = tagDepth, valKind = result.kind, valVar = blockValVar, label = blockLabel,
            iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
            finParsed := parseFinallyClause(target, source, afterTaggedClose, prefix, locals, functions, params, currentName,
            ctx.appendCtx(ctxs, taggedFinCtx), tagDepth, inferMode, aliases);
            if isCTagBlk {
                result = finishFinallyC(result.code, finParsed, result.kind, result, inferMode, ctxs, blockId);
            } else {
                taggedTryBody := if result.kind == ir.VALUE_KIND_UNIT {
                    "void (" + result.code + "); return undefined;"
                } else if result.kind == ir.VALUE_KIND_NEVER {
                    "(" + result.code + ");"
                } else {
                    "return " + result.code + ";"
                };
                result = finishFinallyIife(taggedTryBody, finParsed, result.kind, result, inferMode);
            }
        }
        return result;
    }
    if afterTag < tagSourceSize and (source.wordAt(afterTag, "if") or source.wordAt(afterTag, "match")) {
        condKind := if source.wordAt(afterTag, "if") { ir.CTX_KIND_IF } else { ir.CTX_KIND_MATCH };
        return parseCondExpr(target, source, condKind, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if afterTag < tagSourceSize and source.wordAt(afterTag, "loop") {
        return parseLoopExpr(target, source, afterTag, tagInfo.tag, start, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    syntax.failAt(source, afterTag, prefix, "expected {, if, match, loop or . after block tag @" + tagInfo.tag);
    ctx.intParsed("", 0, true, start)
};

/** Parses a `fn(...) { ... }` anonymous/closure function literal expression starting after `fn`. */
parseFnLiteralExpr := fn(target: String, source: String, nameStart: Int, afterKw: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    isCFnLit := target == ir.TARGET_C;
    size := source.length();
    var cursor := syntax.expectSymbol(source, syntax.skipTrivia(source, afterKw, prefix), "(", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    hasExpectedFn := types.isFnKind(expected);
    expectedParamCount := if hasExpectedFn { types.fnParamCount(expected) } else { 0 };
    paramNames: mut List<String> = [];
    paramKinds: mut List<String> = [];
    encodedKindBuf: mut tb.TextBuilder;
    mut encodedKindBuf.append("fn(");
    var paramIdx := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        pStart := cursor;
        if not source.at(pStart).isNameStart() {
            syntax.failAt(source, pStart, prefix, "expected a parameter name");
        }
        pEnd := source.skipName(pStart);
        pName := source.slice(pStart, pEnd);
        if syntax.isReservedWord(pName) { syntax.unsupportedFeature(source, pStart, pName, prefix); }
        if paramNames.contains(pName) {
            syntax.failAt(source, pStart, prefix, "duplicate parameter " + pName);
        }
        (mut paramNames).pushBack(pName);
        cursor = syntax.skipTrivia(source, pEnd, prefix);
        var pKind := "";
        if cursor < size and source.at(cursor) == ":" {
            typedParam := types.parseFunctionType(source, cursor + 1, prefix, aliases, "");
            pKind = typedParam.kind;
            cursor = syntax.skipTrivia(source, typedParam.next, prefix);
        } else if hasExpectedFn and paramIdx < expectedParamCount {
            pKind = types.fnParamComponent(expected, paramIdx).kind;
        } else {
            syntax.failAt(source, pStart, prefix, "expected : Type for parameter " + pName);
        }
        if pKind == ir.VALUE_KIND_UNIT {
            syntax.failAt(source, pStart, prefix, "function parameter " + pName + " cannot have type Unit");
        }
        (mut paramKinds).pushBack(pKind);
        if paramIdx > 0 { mut encodedKindBuf.append(","); }
        mut encodedKindBuf.append(pName);
        mut encodedKindBuf.append(":");
        mut encodedKindBuf.append(pKind);
        paramIdx = paramIdx + 1;
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    encodedKind := encodedKindBuf.build();
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    cursor = syntax.skipTrivia(source, cursor, prefix);
    var retKind := "";
    if cursor < size and source.at(cursor) == ":" {
        typedRet := types.parseFunctionType(source, cursor + 1, prefix, aliases, "");
        retKind = typedRet.kind;
        cursor = syntax.skipTrivia(source, typedRet.next, prefix);
    } else if hasExpectedFn {
        retKind = types.fnResultKind(expected);
    } else {
        syntax.failAt(source, cursor, prefix, "expected : ReturnType in function expression");
    }
    if cursor >= size or source.at(cursor) =!= "{" {
        syntax.failAt(source, cursor, prefix, "expected { for function body");
    }
    var fnKind := encodedKind + "):" + retKind;
    fnLexDepth := ir.maxLocalLexDepth(locals) + 1;
    fnLocals: mut List<Local> = [];
    selfRuntime := if isCFnLit { "lt_self_" + nameStart.toText() } else { ir.freshScopeTemp(locals, "lite$self") };
    mut fnLocals.pushBack((name = "$self", runtime = selfRuntime, kind = fnKind,
    mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
    intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
    loop locals as outerEntry {
        if outerEntry.name =!= "$self" and outerEntry.depth >= -1 {
            capturedInit := if outerEntry.initState == ir.INIT_STATE_UNINIT_ASSIGNED { ir.INIT_STATE_INIT }
            else if outerEntry.initState == ir.INIT_STATE_UNINIT and not outerEntry.mutable { ir.INIT_STATE_MAYBE }
            else { outerEntry.initState };
            capturedConst := if outerEntry.mutable or outerEntry.writable { false } else { outerEntry.constant };
            mut fnLocals.pushBack((name = outerEntry.name, runtime = outerEntry.runtime, kind = outerEntry.kind,
            mutable = outerEntry.mutable, writable = outerEntry.writable, depth = outerEntry.depth, constant = capturedConst,
            code = outerEntry.code, intValue = outerEntry.intValue, textValue = outerEntry.textValue, initState = capturedInit));
        }
    }
    loop locals as outerEntry {
        if outerEntry.depth <= -2 {
            futLexDepth := 0 - 2 - outerEntry.depth;
            if trace.latestActiveLocalByRuntime(locals, outerEntry.runtime) < 0 and
            not ir.localsHasDeeperReachedName(locals, outerEntry.name, futLexDepth) {
                mut fnLocals.pushBack((name = outerEntry.name, runtime = outerEntry.runtime, kind = outerEntry.kind,
                mutable = outerEntry.mutable, writable = outerEntry.writable, depth = -1, constant = false,
                code = outerEntry.code, intValue = 0, textValue = "", initState = outerEntry.initState));
            }
        }
    }
    tsParamsBuf: mut tb.TextBuilder;
    cParamsBuf: mut tb.TextBuilder;
    mut cParamsBuf.append("void *_env");
    paramVoidBuf: mut tb.TextBuilder;
    paramRuntimes: mut List<String> = [];
    var pBindIdx := 0;
    loop pBindIdx < paramIdx {
        pName := paramNames[pBindIdx];
        pKind := paramKinds[pBindIdx];
        pRuntime := ir.localRuntimeName(target, fnLocals, pName, "", fnLexDepth);
        mut paramRuntimes.pushBack(pRuntime);
        mut fnLocals.pushBack((name = pName, runtime = pRuntime, kind = pKind,
        mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
        if pBindIdx > 0 { mut tsParamsBuf.append(", "); }
        mut tsParamsBuf.append(pRuntime);
        mut tsParamsBuf.append(": ");
        mut tsParamsBuf.append(types.tsFunctionType(pKind));
        mut cParamsBuf.append(", ");
        mut cParamsBuf.append(types.cValueType(pKind));
        mut cParamsBuf.append(" ");
        mut cParamsBuf.append(pRuntime);
        mut paramVoidBuf.append(if isCFnLit { "(void)" } else { "void " });
        mut paramVoidBuf.append(pRuntime);
        mut paramVoidBuf.append("; ");
        pBindIdx = pBindIdx + 1;
    }
    tsParamsCode := tsParamsBuf.build();
    cParamsCode := cParamsBuf.build();
    paramVoidStmts := paramVoidBuf.build();
    fnBodyDepth := if isCFnLit { iifeDepth } else { iifeDepth + 1 };
    if retKind == "$InferRet" {
        inferFnCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FN, phase = ir.CTX_PHASE_BODY, iifeDepth = fnBodyDepth,
        valKind = "", valVar = "", label = "", iterLabel = fnLexDepth.toText(), countVar = "", itemVar = "",
        itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        emptyInferCtxs: List<ConstructCtx> = [];
        inferCtxs := ctx.appendCtx(emptyInferCtxs, inferFnCtx);
        sym.invalidateLocals();
        inferredBody := parseBinaryCtx(target, source, cursor, prefix, fnLocals, functions, params, "<fn>",
        "", 0, inferCtxs, fnBodyDepth, true, "", aliases);
        sym.invalidateLocals();
        if inferredBody.kind == "" {
            syntax.failAt(source, cursor, prefix, "could not infer return type of function expression");
        }
        retKind = inferredBody.kind;
        fnKind = encodedKind + "):" + retKind;
        fnLocals[0] = (name = "$self", runtime = selfRuntime, kind = fnKind,
        mutable = false, writable = false, depth = fnLexDepth, constant = false, code = "",
        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT);
    }
    fnCtx := (id = 0, tag = "", kind = ir.CTX_KIND_FN, phase = ir.CTX_PHASE_BODY, iifeDepth = fnBodyDepth,
    valKind = retKind, valVar = "", label = "", iterLabel = fnLexDepth.toText(), countVar = "", itemVar = "",
    itemKind = "", indexVar = "", hasIndex = false, colVar = "");
    emptyFnCtxs: List<ConstructCtx> = [];
    fnCtxs := ctx.appendCtx(emptyFnCtxs, fnCtx);
    var fnBodySink := "fnBody";
    if paramIdx > 0 {
        fnBodySink = "fnBody:" + paramNames.join(",");
    }
    sym.invalidateLocals();
    fnBody := parseBinaryCtx(target, source, cursor, prefix, fnLocals, functions, params, "<fn>",
    retKind, 0, fnCtxs, fnBodyDepth, inferMode, fnBodySink, aliases);
    sym.invalidateLocals();
    usesSelf := reach.codeUsesTextCall(fnBody.code, selfRuntime);
    if isCFnLit {
        if inferMode {
            return ctx.withMarkers((kind = fnKind, code = "", intValue = 0, textValue = fnKind, constant = false, next = fnBody.next),
            ctx.collectParsedMarkers("", fnBody));
        }
        cFnTag := types.cFnTag(fnKind);
        cid := nameStart.toText() + "_" + paramIdx.toText();
        clName := "lt_cl_" + cid;
        envType := "lt_env_" + cid;
        cRetType := types.cValueType(retKind);
        capRuntimes: mut List<String> = [];
        capKinds: mut List<String> = [];
        capMutables: mut List<Bool> = [];
        var locScanIdx := 0;
        loop locals as le { locScanIdx = locScanIdx + 1; }
        var ri := locScanIdx - 1;
        loop ri >= 0 {
            le := locals[ri];
            isCell := le.runtime.startsWithAt(0, "(*lt_cell_");
            scanTok := if isCell { le.runtime.slice(2, le.runtime.length() - 1) } else { le.runtime };
            if (le.depth > 0 or isCell) and le.name =!= "$self" and scanTok =!= "" and
            not paramRuntimes.contains(le.runtime) and
            not capRuntimes.contains(le.runtime) and
            reach.codeUsesTextCall(fnBody.code, scanTok) {
                mut capRuntimes.pushBack(le.runtime);
                mut capKinds.pushBack(le.kind);
                mut capMutables.pushBack(le.mutable or le.writable);
            }
            ri = ri - 1;
        }
        capCount := capRuntimes.length();
        selfBind := if usesSelf { cFnTag + " " + selfRuntime + " = { " + clName + ", _env }; (void)" + selfRuntime + "; " } else { "" };
        if capCount == 0 {
            cFnDef := "static " + cRetType + " " + clName + "(" + cParamsCode + ") { (void)_env; /*@CFN_TEMPS@*/" + selfBind + paramVoidStmts + fnBody.code + " }";
            cExpr := "/*@T:" + fnKind + "@*//*@CFN_START:" + clName + "@*/" + cFnDef + "/*@CFN_END@*/((" + cFnTag + "){ " + clName + ", NULL })";
            return (kind = fnKind, code = cExpr, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next);
        }
        envFieldsBuf: mut tb.TextBuilder;
        envUnpackBuf: mut tb.TextBuilder;
        mkParamsBuf: mut tb.TextBuilder;
        mkInitsBuf: mut tb.TextBuilder;
        mkArgsBuf: mut tb.TextBuilder;
        var bodyRewritten := fnBody.code;
        var ci := 0;
        loop ci < capCount {
            cRt := capRuntimes[ci];
            cK := capKinds[ci];
            cM := capMutables[ci];
            cT := types.cValueType(cK);
            isCell := cRt.startsWithAt(0, "(*lt_cell_");
            fName := "f_" + ci.toText();
            pName := "a_" + ci.toText();
            if ci > 0 {
                mut mkParamsBuf.append(", ");
                mut mkArgsBuf.append(", ");
            }
            if isCell {
                cellPtr := cRt.slice(2, cRt.length() - 1);
                mut envFieldsBuf.append(cT);
                mut envFieldsBuf.append(" *");
                mut envFieldsBuf.append(fName);
                mut envFieldsBuf.append("; ");
                mut mkParamsBuf.append(cT);
                mut mkParamsBuf.append(" *");
                mut mkParamsBuf.append(pName);
                mut mkArgsBuf.append(cellPtr);
                mut mkInitsBuf.append("e->");
                mut mkInitsBuf.append(fName);
                mut mkInitsBuf.append(" = ");
                mut mkInitsBuf.append(pName);
                mut mkInitsBuf.append("; ");
                mut envUnpackBuf.append(cT);
                mut envUnpackBuf.append(" *");
                mut envUnpackBuf.append(cellPtr);
                mut envUnpackBuf.append(" = ((");
                mut envUnpackBuf.append(envType);
                mut envUnpackBuf.append(" *)_env)->");
                mut envUnpackBuf.append(fName);
                mut envUnpackBuf.append("; (void)");
                mut envUnpackBuf.append(cellPtr);
                mut envUnpackBuf.append("; ");
            } else {
                mut envFieldsBuf.append(cT);
                mut envFieldsBuf.append(" ");
                mut envFieldsBuf.append(fName);
                mut envFieldsBuf.append("; ");
                mut mkParamsBuf.append(cT);
                mut mkParamsBuf.append(" ");
                mut mkParamsBuf.append(pName);
                mut mkArgsBuf.append(ctx.copiedValueCode(target, cK, cRt));
                mut mkInitsBuf.append("e->");
                mut mkInitsBuf.append(fName);
                mut mkInitsBuf.append(" = ");
                mut mkInitsBuf.append(pName);
                mut mkInitsBuf.append("; ");
                if cM {
                    bodyRewritten = ctx.cReplaceIdentToken(bodyRewritten, cRt, "(((" + envType + " *)_env)->" + fName + ")");
                } else {
                    mut envUnpackBuf.append(cT);
                    mut envUnpackBuf.append(" ");
                    mut envUnpackBuf.append(cRt);
                    mut envUnpackBuf.append(" = ((");
                    mut envUnpackBuf.append(envType);
                    mut envUnpackBuf.append(" *)_env)->");
                    mut envUnpackBuf.append(fName);
                    mut envUnpackBuf.append("; (void)");
                    mut envUnpackBuf.append(cRt);
                    mut envUnpackBuf.append("; ");
                }
            }
            ci = ci + 1;
        }
        envFields := envFieldsBuf.build();
        envUnpack := envUnpackBuf.build();
        mkParams := mkParamsBuf.build();
        mkInits := mkInitsBuf.build();
        mkArgs := mkArgsBuf.build();
        mkName := "lt_mk_" + cid;
        cFnDef := "typedef struct { " + envFields + "} " + envType + ";\nstatic " + cRetType + " " + clName + "(" + cParamsCode + ") { (void)_env; /*@CFN_TEMPS@*/" + selfBind + envUnpack + paramVoidStmts + bodyRewritten + " }\nstatic " + cFnTag + " " + mkName + "(" + mkParams + ") { " + envType + " *e = malloc(sizeof(" + envType + ")); if (e == NULL) { fprintf(stderr, \"MemoryFault\\n\"); exit(1); } " + mkInits + "return (" + cFnTag + "){ " + clName + ", e }; }";
        cExpr := "/*@T:" + fnKind + "@*//*@CFN_START:" + clName + "@*/" + cFnDef + "/*@CFN_END@*/" + mkName + "(" + mkArgs + ")";
        return (kind = fnKind, code = cExpr, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next);
    }
    fnPrefix := if usesSelf { "(function " + selfRuntime } else { "(function " };
    fnFullCode := fnPrefix + "(" + tsParamsCode + "): " + types.tsFunctionType(retKind) + " { " + paramVoidStmts + fnBody.code + " })";
    ctx.withMarkers((kind = fnKind, code = fnFullCode, intValue = 0, textValue = fnKind, constant = false, next = fnBody.next),
    if inferMode { ctx.collectParsedMarkers("", fnBody) } else { "" })
};

/** Returns an error diagnostic if any bound parameter in `bindings` violates its `Type<...>` constraint, or `""`. */
findGenericConstraintError := fn(genericParams: String, bindings: Map<String, String>, calleeSuffix: String): String {
    loop generics.splitGenericParams(genericParams) as gp {
        if bindings.has(gp) {
            gpConstraint := types.typeParamConstraintKind(genericParams, gp);
            if gpConstraint =!= "" {
                boundEntry := bindings.get(gp);
                boundKind := boundEntry.value;
                if not types.typeSatisfiesConstraint(boundKind, gpConstraint) {
                    return "type " + types.displayKind(boundKind) + " does not satisfy constraint " + types.displayKind(gpConstraint) + " for parameter " + gp + calleeSuffix;
                }
            }
        }
    }
    ""
};

/** Ensures `$recpop:<recordKind>` and `$recdef:...` entries exist in `aliases`, lazily resolving forward-declared local records when needed. */
ensureRecordDefaults := fn(target: String, source: String, recordKind: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): List<AliasDecl> {
    if types.findAlias(aliases, "$recpop:" + recordKind) >= 0 { return aliases; }
    ownerKey := types.typeOpOwnerKey(recordKind);
    if ownerKey =!= "" and types.findAlias(aliases, "$recpop:" + ownerKey) >= 0 { return aliases; }
    declAt := types.recordDeclAt(recordKind);
    if declAt < 0 { return aliases; }
    aliasIdx := types.aliasIndexAt(aliases, declAt);
    if aliasIdx < 0 { return aliases; }
    aliasEntry := aliases[aliasIdx];
    isRawRec := aliasEntry.target.startsWithAt(0, "@recraw:");
    isGenRawRec := aliasEntry.target.startsWithAt(0, "@genraw:") and aliasEntry.target.indexOf("@recraw:", 8) >= 0;
    if aliasEntry.at < 0 or (not isRawRec and not isGenRawRec) { return aliases; }
    afterName := source.skipName(aliasEntry.at);
    opPos := syntax.skipTrivia(source, afterName, prefix);
    if not source.startsWithAt(opPos, ":=") { return aliases; }
    recPos := syntax.skipTrivia(source, opPos + 2, prefix);
    if not source.wordAt(recPos, "record") { return aliases; }
    seedKey := if isGenRawRec and ownerKey =!= "" { ownerKey } else { recordKind };
    seeded := types.appendEncodedRecordDefaults(aliases, seedKey, "", aliasEntry.depth);
    parsedRec := parseRecordDecl(target, source, recPos, aliasEntry.at, aliasEntry.name, aliasEntry.depth, prefix, locals, functions, params, currentName, ctxs, iifeDepth, false, seeded);
    types.appendEncodedRecordDefaults(aliases, seedKey, parsedRec.encodedDefaults, aliasEntry.depth)
};

/** Parses `{ field = expr, ... }` or `{}` for an explicit or contextual nominal `recordKind`, resolving omitted fields from defaults then zero. */
parseRecordLiteral := fn(target: String, source: String, braceStart: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, recordKind: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    recAliases := ensureRecordDefaults(target, source, recordKind, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    recName := types.recordDisplayName(recordKind);
    suppliedKeys: mut List<String> = [];
    suppliedCodes: mut List<String> = [];
    var recMarkers := "";
    var cursor := syntax.skipTrivia(source, braceStart + 1, prefix);
    loop true {
        if cursor >= size {
            syntax.failAt(source, braceStart, prefix, "expected } in record construction");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        var labelStart := cursor;
        var label := "";
        var valStart := cursor;
        var valMin := 0;
        if syntax.isSingleEquals(source, cursor) {
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not source.at(shStart).isNameStart() {
                syntax.failAt(source, shStart, prefix, "expected field name after = in record construction");
            }
            shEnd := source.skipName(shStart);
            labelStart = shStart;
            label = source.slice(shStart, shEnd);
            valStart = shStart;
            valMin = 30;
        } else {
            if not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, "expected field name in record construction");
            }
            labelEnd := source.skipName(labelStart);
            label = source.slice(labelStart, labelEnd);
            afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
            if not syntax.isSingleEquals(source, afterLabel) {
                syntax.failAt(source, afterLabel, prefix, "expected = after record field " + label);
            }
            valStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
        }
        if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, labelStart, label, prefix); }
        fieldKind := types.recordFieldKind(recordKind, label);
        if fieldKind == "" {
            syntax.failAt(source, labelStart, prefix, "record " + recName + " has no field " + label);
        }
        if suppliedKeys.contains(label) {
            syntax.failAt(source, labelStart, prefix, "duplicate record field " + label);
        }
        zeroEnd := syntax.isZeroInitLiteral(source, valStart, prefix);
        var valNext := valStart;
        var valCode := "";
        var checkZero := false;
        if valMin == 0 and zeroEnd >= 0 and not numeric.isNumericKind(fieldKind) {
            afterZero := syntax.skipTrivia(source, zeroEnd, prefix);
            if afterZero < size and (source.at(afterZero) == "," or source.at(afterZero) == "}") {
                checkZero = true;
            }
        }
        if checkZero {
            z := ctx.zeroParsed(target, fieldKind, zeroEnd);
            valCode = z.code;
            valNext = z.next;
        } else {
            valParsed := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, fieldKind, valMin, ctxs, iifeDepth, inferMode, "", recAliases);
            if inferMode { recMarkers = ctx.collectParsedMarkers(recMarkers, valParsed); }
            if not types.isCompatibleKind(fieldKind, valParsed.kind) {
                syntax.failAt(source, valStart, prefix, "cannot initialize " + types.displayKind(fieldKind) + " field " + label + " with " + types.displayKind(valParsed.kind));
            }
            valCode = ctx.assignValueCode(target, fieldKind, valParsed.kind, valParsed.code);
            valNext = valParsed.next;
        }
        (mut suppliedKeys).pushBack(label);
        mut suppliedCodes.pushBack(valCode);
        afterVal := syntax.skipTrivia(source, valNext, prefix);
        if afterVal < size and source.at(afterVal) == "," {
            cursor = syntax.skipTrivia(source, afterVal + 1, prefix);
        } else if afterVal < size and source.at(afterVal) == "}" {
            cursor = afterVal + 1;
            break;
        } else {
            syntax.failAt(source, afterVal, prefix, "expected , or } after record field " + label);
        }
    }
    compCount := types.recordComponentCount(recordKind);
    cRecTag := if target == ir.TARGET_C { types.cStructTag(recordKind) } else { "" };
    if compCount == 0 {
        emptyRecCode := if cRecTag =!= "" { "/*@T:" + recordKind + "@*/((" + cRecTag + "){ ._empty = 0 })" } else { "{}" };
        return ctx.withMarkers((kind = recordKind, code = emptyRecCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers);
    }
    encodedSupplied := types.encodeRecordPairs(suppliedKeys, suppliedCodes);
    fieldExprs: mut List<String> = [];
    var compIdx := 0;
    loop compIdx < compCount {
        comp := types.recordComponent(recordKind, compIdx);
        var chosen := "";
        var supIdx := 0;
        var supFound := false;
        loop suppliedKeys as sKey {
            if sKey == comp.label {
                chosen = suppliedCodes[supIdx];
                supFound = true;
                break;
            }
            supIdx = supIdx + 1;
        }
        if not supFound {
            defCode := types.findRecordDefaultCode(recAliases, recordKind, comp.label);
            if defCode =!= "" {
                chosen = defCode;
            } else {
                chosen = ctx.zeroParsed(target, comp.kind, cursor).code;
            }
        }
        if cRecTag =!= "" {
            mut fieldExprs.pushBack("." + types.cFieldName(comp.prop) + " = " + chosen);
        } else {
            mut fieldExprs.pushBack(types.tupleObjectKey(comp.label, compIdx) + ": " + chosen);
        }
        compIdx = compIdx + 1;
    }
    _unused := encodedSupplied;
    recCode := if cRecTag =!= "" {
        "/*@T:" + recordKind + "@*/((" + cRecTag + "){ " + fieldExprs.join(", ") + " })"
    } else {
        "{ " + fieldExprs.join(", ") + " }"
    };
    ctx.withMarkers((kind = recordKind, code = recCode, intValue = 0, textValue = "", constant = false, next = cursor), recMarkers)
};

/** Detects a leading `(...) :=`, `{...} :=`, `[...] :=` (or `var ...`) destructuring pattern, rejecting construction-shaped `Name {...} :=` headers. */
pub scanDestructureStart := fn(source: String, cursor: Int, limit: Int, prefix: String): (openPos: Int, isMutable: Bool) {
    if cursor >= limit { return (openPos = -1, isMutable = false); }
    ch := source.at(cursor);
    if ch == "(" or ch == "{" or ch == "[" {
        endPos := if ch == "(" { syntax.scanParenEnd(source, cursor, prefix) } else if ch == "{" { syntax.scanBraceEnd(source, cursor, prefix) } else { syntax.scanBracketEnd(source, cursor, prefix) };
        afterEnd := if endPos >= 0 { syntax.skipTrivia(source, endPos, prefix) } else { -1 };
        if afterEnd >= 0 and afterEnd < limit and source.startsWithAt(afterEnd, ":=") {
            return (openPos = cursor, isMutable = false);
        }
        return (openPos = -1, isMutable = false);
    }
    if ch == "v" and source.wordAt(cursor, "var") {
        afterVar := syntax.skipTrivia(source, cursor + 3, prefix);
        if afterVar < limit {
            vCh := source.at(afterVar);
            if vCh == "(" or vCh == "{" or vCh == "[" {
                return (openPos = afterVar, isMutable = true);
            }
            if vCh.isNameStart() {
                varPatEnd := syntax.skipTrivia(source, source.skipName(afterVar), prefix);
                if varPatEnd < limit and source.at(varPatEnd) == "{" {
                    patBraceEnd := syntax.scanBraceEnd(source, varPatEnd, prefix);
                    afterPatBrace := if patBraceEnd >= 0 { syntax.skipTrivia(source, patBraceEnd, prefix) } else { -1 };
                    if afterPatBrace >= 0 and source.startsWithAt(afterPatBrace, ":=") {
                        syntax.failAt(source, afterVar, prefix, "construction-shaped record pattern is not allowed; omit the type name");
                    }
                }
            }
        }
    }
    (openPos = -1, isMutable = false)
};

/** Parses `{ ... }`, `( ... )`, or `[ ... ]` destructuring clauses uniformly, including `= name` shorthand, `bind = field`, `: Type`, and `_`. */
pub parseAggregatePattern := fn(source: String, openPos: Int, prefix: String, aliases: List<AliasDecl>): (shape: String, count: Int, grouped: Bool, groupedType: String, encodedClauses: String, next: Int) {
    size := source.length();
    openDelim := source.at(openPos);
    shape := if openDelim == "{" { "record" } else if openDelim == "(" { "tuple" } else { "array" };
    closeDelim := if openDelim == "{" { "}" } else if openDelim == "(" { ")" } else { "]" };
    var cursor := syntax.skipTrivia(source, openPos + 1, prefix);
    seenRecBinds: mut List<String> = [];
    encodedBuf: mut tb.TextBuilder;
    var count := 0;
    var hadComma := false;
    var lastMode := "pos";
    var lastExpected := "";
    loop cursor < size and source.at(cursor) =!= closeDelim {
        var bindName := "";
        var sourceField := "";
        var expectedKind := "";
        var clauseMode := "pos";
        var clauseEnd := cursor;
        if syntax.isSingleEquals(source, cursor) {
            if shape == "array" {
                syntax.failAt(source, cursor, prefix, "array destructuring does not support = selector");
            }
            shStart := syntax.skipTrivia(source, cursor + 1, prefix);
            if shStart >= size or not source.at(shStart).isNameStart() {
                syntax.failAt(source, shStart, prefix, "expected field name after = in " + shape + " destructuring");
            }
            shEnd := source.skipName(shStart);
            shName := source.slice(shStart, shEnd);
            if syntax.isReservedWord(shName) { syntax.unsupportedFeature(source, shStart, shName, prefix); }
            if shName == "_" {
                syntax.failAt(source, shStart, prefix, "use _ = sourceField to discard a field");
            }
            if shape == "record" and seenRecBinds.contains(shName) {
                syntax.failAt(source, shStart, prefix, "duplicate record pattern binding " + shName);
            }
            bindName = shName;
            sourceField = shName;
            clauseMode = "named";
            afterSh := syntax.skipTrivia(source, shEnd, prefix);
            clauseEnd = afterSh;
            if afterSh < size and source.at(afterSh) == ":" {
                typed := types.parseLocalType(source, afterSh + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterSh, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                clauseEnd = syntax.skipTrivia(source, typed.next, prefix);
            }
        } else {
            if not source.at(cursor).isNameStart() {
                syntax.failAt(source, cursor, prefix, if shape == "record" { "expected binding name in record pattern" } else { "expected a binding name in " + shape + " destructuring" });
            }
            bindStart := cursor;
            bindEnd := source.skipName(bindStart);
            bindName = source.slice(bindStart, bindEnd);
            if syntax.isReservedWord(bindName) { syntax.unsupportedFeature(source, bindStart, bindName, prefix); }
            if shape == "record" and bindName =!= "_" and seenRecBinds.contains(bindName) {
                syntax.failAt(source, bindStart, prefix, "duplicate record pattern binding " + bindName);
            }
            afterBind := syntax.skipTrivia(source, bindEnd, prefix);
            var checkEqPos := afterBind;
            if afterBind < size and source.at(afterBind) == ":" {
                typed := types.parseLocalType(source, afterBind + 1, prefix, aliases);
                if typed.writable { syntax.failAt(source, afterBind, prefix, "mut is not supported in pattern type constraints"); }
                expectedKind = typed.kind;
                checkEqPos = syntax.skipTrivia(source, typed.next, prefix);
            }
            clauseEnd = checkEqPos;
            if syntax.isSingleEquals(source, checkEqPos) {
                if shape == "array" {
                    syntax.failAt(source, checkEqPos, prefix, "array destructuring patterns do not use =");
                }
                fieldStart := syntax.skipTrivia(source, checkEqPos + 1, prefix);
                if fieldStart >= size or not source.at(fieldStart).isNameStart() {
                    syntax.failAt(source, fieldStart, prefix, "expected source field name after =");
                }
                fieldEnd := source.skipName(fieldStart);
                sourceField = source.slice(fieldStart, fieldEnd);
                if syntax.isReservedWord(sourceField) { syntax.unsupportedFeature(source, fieldStart, sourceField, prefix); }
                clauseMode = "named";
                clauseEnd = syntax.skipTrivia(source, fieldEnd, prefix);
            } else if shape == "record" {
                if expectedKind =!= "" {
                    if bindName == "_" { syntax.failAt(source, bindStart, prefix, "expected = sourceField after _"); }
                    sourceField = bindName;
                    clauseMode = "named";
                } else {
                    syntax.failAt(source, checkEqPos, prefix, "expected = sourceField or : Type in record pattern clause " + bindName);
                }
            }
        }
        if shape == "record" and bindName =!= "_" { mut seenRecBinds.pushBack(bindName); }
        mut encodedBuf.append(types.encodeLengthPrefixedText(bindName));
        mut encodedBuf.append(types.encodeLengthPrefixedText(sourceField));
        mut encodedBuf.append(types.encodeLengthPrefixedText(expectedKind));
        mut encodedBuf.append(types.encodeLengthPrefixedText(clauseMode));
        lastMode = clauseMode;
        lastExpected = expectedKind;
        count = count + 1;
        cursor = clauseEnd;
        if cursor < size and source.at(cursor) == "," {
            hadComma = true;
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    encoded := encodedBuf.build();
    next := syntax.expectSymbol(source, cursor, closeDelim, prefix);
    if count == 0 and shape == "record" {
        syntax.failAt(source, openPos, prefix, "record destructuring needs at least one field clause");
    }
    if count == 0 and shape == "array" {
        syntax.failAt(source, openPos, prefix, "array destructuring needs at least one binding");
    }
    grouped := shape == "tuple" and count == 1 and not hadComma and lastMode == "pos";
    (shape = shape, count = count, grouped = grouped, groupedType = if grouped { lastExpected } else { "" }, encodedClauses = encoded, next = next)
};

/** Validates `rhsKind` against a parsed aggregate destructuring pattern and resolves each clause to `(bindName, propExpr, srcKind, targetKind)`. */
pub resolveAggregateBindings := fn(target: String, shape: String, count: Int, encodedClauses: String, rhsKind: String, tempRuntime: String, source: String, openPos: Int, prefix: String): String {
    if shape == "record" and not types.isRecordKind(rhsKind) {
        syntax.failAt(source, openPos, prefix, "record destructuring requires a record value, got " + types.displayKind(rhsKind));
    }
    if shape == "tuple" {
        if not types.isTupleKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "tuple destructuring requires a tuple value, got " + types.displayKind(rhsKind));
        }
        if types.tupleComponentCount(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "tuple destructuring expected " + count.toText() +
            " fields, got " + types.tupleComponentCount(rhsKind).toText());
        }
    }
    if shape == "array" {
        if types.isListKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "cannot destructure runtime-sized List<" + types.displayKind(types.listElementKind(rhsKind)) + ">; fixed array required");
        }
        if not types.isArrayKind(rhsKind) {
            syntax.failAt(source, openPos, prefix, "array destructuring requires an array value, got " + types.displayKind(rhsKind));
        }
        if types.arrayExtent(rhsKind) =!= count {
            syntax.failAt(source, openPos, prefix, "array destructuring expected " + count.toText() +
            " elements, got " + types.arrayExtent(rhsKind).toText());
        }
    }
    var claimedBag := "";
    out: mut tb.TextBuilder;
    var clCursor := 0;
    var clIndex := 0;
    loop clIndex < count {
        bindPart := types.decodeLengthPrefixedAt(encodedClauses, clCursor);
        fieldPart := types.decodeLengthPrefixedAt(encodedClauses, bindPart.next);
        typePart := types.decodeLengthPrefixedAt(encodedClauses, fieldPart.next);
        modePart := types.decodeLengthPrefixedAt(encodedClauses, typePart.next);
        clCursor = modePart.next;
        bindName := bindPart.text;
        sourceField := fieldPart.text;
        expectedKind := typePart.text;
        clauseMode := modePart.text;
        var srcKind := "";
        var propExpr := "";
        if shape == "record" {
            srcKind = types.recordFieldKind(rhsKind, sourceField);
            if srcKind == "" {
                syntax.failAt(source, openPos, prefix, "record " + types.recordDisplayName(rhsKind) + " has no field " + sourceField);
            }
            recProp := types.recordComponentProp(rhsKind, sourceField);
            propExpr = tempRuntime + "." + (if target == ir.TARGET_C { types.cFieldName(recProp) } else { recProp });
        } else if shape == "tuple" {
            var compIdx := -1;
            if clauseMode == "named" {
                compIdx = types.tupleComponentIndexByLabel(rhsKind, sourceField);
                if compIdx < 0 {
                    syntax.failAt(source, openPos, prefix, "tuple has no field " + sourceField);
                }
                idxTok := compIdx.toText();
                if trace.tokenInPipeBag(claimedBag, idxTok) {
                    syntax.failAt(source, openPos, prefix, "duplicate selection of tuple field " + sourceField);
                }
                claimedBag = trace.appendPipeBag(claimedBag, idxTok);
            } else {
                var probe := 0;
                loop probe < count {
                    idxTok := probe.toText();
                    if not trace.tokenInPipeBag(claimedBag, idxTok) {
                        compIdx = probe;
                        claimedBag = trace.appendPipeBag(claimedBag, idxTok);
                        break;
                    }
                    probe = probe + 1;
                }
            }
            comp := types.tupleComponent(rhsKind, compIdx);
            srcKind = comp.kind;
            propExpr = tempRuntime + "." + (if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop });
        } else {
            srcKind = types.arrayElementKind(rhsKind);
            if target == ir.TARGET_C and types.cListTag(srcKind) =!= "" {
                propExpr = "lt_list_" + types.cListTag(srcKind) + "_at(" + tempRuntime + ", " + clIndex.toText() + ", " + openPos.toText() + ")";
            } else {
                propExpr = tempRuntime + "[" + clIndex.toText() + "]!";
            }
        }
        var targetKind := srcKind;
        if expectedKind =!= "" {
            if not types.isCompatibleKind(expectedKind, srcKind) {
                syntax.failAt(source, openPos, prefix, "cannot bind " + types.displayKind(srcKind) + " to " + types.displayKind(expectedKind));
            }
            targetKind = expectedKind;
        }
        mut out.append(types.encodeLengthPrefixedText(bindName));
        mut out.append(types.encodeLengthPrefixedText(propExpr));
        mut out.append(types.encodeLengthPrefixedText(srcKind));
        mut out.append(types.encodeLengthPrefixedText(targetKind));
        clIndex = clIndex + 1;
    }
    out.build()
};

/** Parses name-headed primaries: `Unit`, `true`/`false`, `not`, `if`/`match`/`loop`, `fn`, `self`, locals, module functions, and list intrinsics. */
parseNamedPrimaryExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    nameStart := start;
    next := source.skipName(start);
    name := source.slice(nameStart, next);
    if name == "Unit" {
        return (kind = ir.VALUE_KIND_UNIT, code = ir.targetUnitLiteralCode(target), intValue = 0, textValue = "", constant = true, next = next);
    }
    if name == "true" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, true), true, true, next);
    }
    if name == "false" {
        return ctx.boolParsed(ir.targetBoolLiteralCode(target, false), false, true, next);
    }
    if name == "not" {
        operand := parseBinaryCtx(target, source, next, prefix, locals, functions, params, currentName, "", 5, ctxs, iifeDepth, inferMode, "", aliases);
        operandLoopId := types.loopValMarkerId(operand.kind);
        if inferMode and operandLoopId >= 0 {
            return ctx.withMarkers(ctx.boolParsed("", false, false, operand.next),
            ctx.collectParsedMarkers("", operand) + operandLoopId.toText() + "=Bool\n");
        }
        if operand.kind =!= ir.VALUE_KIND_BOOL {
            syntax.failAt(source, nameStart, prefix, "not requires a Bool operand");
        }
        if operand.constant {
            value := operand.intValue == 0;
            return ctx.boolParsed(ir.targetBoolLiteralCode(target, value), value, true, operand.next);
        }
        return ctx.withMarkers(ctx.boolParsed(ir.targetNotCode(target, operand.code), false, false, operand.next),
        if inferMode { ctx.collectParsedMarkers("", operand) } else { "" });
    }
    if name == "if" or name == "match" {
        return parseCondExpr(target, source, name, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, minimum, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "loop" {
        return parseLoopExpr(target, source, nameStart, "", nameStart, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "fn" {
        return parseFnLiteralExpr(target, source, nameStart, next, prefix, locals, functions, params, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if name == "mut" {
        mutLease := tryParseGroupedMutLease(source, nameStart, prefix, false);
        if not mutLease.matched {
            if mutLease.nameEnd > mutLease.nameStart {
                syntax.failAt(source, mutLease.nameEnd, prefix, "expected ) after mut " + source.slice(mutLease.nameStart, mutLease.nameEnd));
            }
            syntax.failAt(source, mutLease.nameStart, prefix, "expected a binding name after mut");
        }
        return parseMutReceiverCallExpr(target, source, mutLease.mutStart, mutLease.nameStart, mutLease.nameEnd, mutLease.next, prefix, locals, functions, params, currentName, expected, ctxs, iifeDepth, inferMode, aliases);
    }
    if syntax.isReservedWord(name) { syntax.unsupportedFeature(source, nameStart, name, prefix); }
    afterName := syntax.skipTrivia(source, next, prefix);
    isCallSite := afterName < source.length() and source.at(afterName) == "(";
    if name == "self" {
        selfLocalIdx := sym.localIndex(locals, "$self");
        if selfLocalIdx >= 0 {
            selfEntry := locals[selfLocalIdx];
            return (kind = selfEntry.kind, code = selfEntry.runtime, intValue = 0, textValue = "", constant = false, next = next);
        }
        if currentName == "" { syntax.failAt(source, nameStart, prefix, "self is only available inside a function"); }
        selfIndex := sym.findFunction(functions, currentName);
        if selfIndex >= 0 {
            return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = nameStart.toText(), intValue = selfIndex, textValue = currentName, constant = false, next = next);
        }
        syntax.failAt(source, nameStart, prefix, "unknown value " + name);
        return ctx.intParsed("", 0, true, start);
    }
    index := sym.localIndex(locals, name);
    hasLocalShadow := index >= 0 and locals[index].depth >= -1;
    if hasLocalShadow {
        entry := locals[index];
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        return (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, constant = entry.constant, next = next);
    }
    callableIndex := sym.findFunction(functions, name);
    if callableIndex >= 0 {
        if currentName == "" and functions[callableIndex].declAt > nameStart {
            syntax.failAt(source, nameStart, prefix, "cannot access " + name + " before initialization");
        }
        return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = nameStart.toText(), intValue = callableIndex, textValue = name, constant = false, next = next);
    }
    if index >= 0 {
        entry := locals[index];
        if entry.initState =!= ir.INIT_STATE_INIT {
            syntax.failAt(source, nameStart, prefix, "cannot read uninitialized local " + name);
        }
        return (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, constant = entry.constant, next = next);
    }
    if name == "cast" and afterName < source.length() and (source.at(afterName) == "<" or source.at(afterName) == "(") {
        size := source.length();
        var targetKind := "";
        var openParen := afterName;
        if source.at(afterName) == "<" {
            typeStart := syntax.skipTrivia(source, afterName + 1, prefix);
            if inferMode {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, typeStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                targetKind = canRes.kind;
                afterTarget := syntax.skipTrivia(source, canRes.next, prefix);
                if afterTarget >= size or source.at(afterTarget) =!= ">" {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                openParen = syntax.skipTrivia(source, afterTarget + 1, prefix);
                if openParen >= size or source.at(openParen) =!= "(" {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
            } else {
                parsedTarget := types.parseTypeAt(source, typeStart, prefix, aliases, "cast target", "");
                targetKind = parsedTarget.kind;
                afterTarget := syntax.skipTrivia(source, parsedTarget.next, prefix);
                if afterTarget >= size or source.at(afterTarget) =!= ">" {
                    syntax.failAt(source, afterTarget, prefix, "expected > after cast target type");
                }
                openParen = syntax.skipTrivia(source, afterTarget + 1, prefix);
                if openParen >= size or source.at(openParen) =!= "(" {
                    syntax.failAt(source, openParen, prefix, "expected ( after cast<" + types.displayKind(targetKind) + ">");
                }
            }
        } else if expected =!= "" {
            targetKind = expected;
        }
        argStart := syntax.skipTrivia(source, openParen + 1, prefix);
        if argStart < size and source.at(argStart) == ")" {
            if inferMode {
                return (kind = targetKind, code = "", intValue = 0, textValue = "", constant = false, next = argStart + 1);
            }
            syntax.failAt(source, argStart, prefix, "cast expects exactly one argument");
        }
        argExpected := if targetKind =!= "" and types.isDistinctKind(targetKind) { types.distinctUnderlyingKind(targetKind) } else { "" };
        arg := parseBinaryCtx(target, source, argStart, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, iifeDepth, inferMode, "", aliases);
        argMarkers := if inferMode { ctx.collectParsedMarkers("", arg) } else { "" };
        afterArg := syntax.skipTrivia(source, arg.next, prefix);
        if afterArg < size and source.at(afterArg) == "," {
            if not inferMode {
                syntax.failAt(source, afterArg, prefix, "cast expects exactly one argument");
            }
        }
        closeParen := if inferMode and (afterArg >= size or source.at(afterArg) =!= ")") {
            next
        } else {
            syntax.expectSymbol(source, afterArg, ")", prefix)
        };
        if targetKind == "" {
            if inferMode {
                return ctx.withMarkers((kind = "", code = "", intValue = 0, textValue = "", constant = false, next = closeParen), argMarkers);
            }
            syntax.failAt(source, nameStart, prefix, "cast requires an explicit type argument cast<Type>(value) or an expected target type");
        }
        if not inferMode {
            isWrap := types.isDistinctKind(targetKind) and types.distinctUnderlyingKind(targetKind) == arg.kind;
            isUnwrap := types.isDistinctKind(arg.kind) and types.distinctUnderlyingKind(arg.kind) == targetKind;
            if not isWrap and not isUnwrap {
                syntax.failAt(source, nameStart, prefix, "cannot cast " + types.displayKind(arg.kind) + " to " + types.displayKind(targetKind) + "; cast only converts directly between a distinct type and its underlying type");
            }
        }
        castCode := if target == ir.TARGET_C and (arg.code.startsWithAt(0, "/*@CBLK:") or arg.code.startsWithAt(0, "/*@T:")) {
            arg.code
        } else {
            "(" + arg.code + ")"
        };
        return ctx.withMarkers((kind = targetKind, code = castCode, intValue = arg.intValue, textValue = arg.textValue, constant = arg.constant, next = closeParen), argMarkers);
    }
    if afterName < source.length() and (source.at(afterName) == "." or source.at(afterName) == "<") and
    (types.findAlias(aliases, name) >= 0 or name == "List" or name == "Map" or name == "Set" or name == "Array" or (source.at(afterName) == "." and (name == "String" or name == "Int"))) {
        var resolvedType := "";
        var typeOwnerKey := "";
        var aliasParamsCsv := "";
        var aliasTplKind := "";
        var dotPos := afterName;
        isTypeApp := source.at(afterName) == "<";
        if isTypeApp {
            if inferMode {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                resolvedType = canRes.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
                dotPos = syntax.skipTrivia(source, canRes.next, prefix);
            } else {
                parsedType := types.parseTypeAt(source, nameStart, prefix, aliases, "type expression", "");
                resolvedType = parsedType.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
                dotPos = syntax.skipTrivia(source, parsedType.next, prefix);
            }
            if dotPos < source.length() and source.at(dotPos) == "{" {
                if not types.isRecordKind(resolvedType) {
                    if inferMode {
                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                    }
                    syntax.failAt(source, nameStart, prefix, "record construction requires a record type, got " + types.displayKind(resolvedType));
                }
                return parseRecordLiteral(target, source, dotPos, prefix, locals, functions, params, currentName, resolvedType, ctxs, iifeDepth, inferMode, aliases);
            }
            if dotPos >= source.length() or source.at(dotPos) =!= "." {
                if inferMode {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                syntax.failAt(source, dotPos, prefix, "expected { or . after type " + types.displayKind(resolvedType));
            }
        } else if name == "List" or name == "Map" or name == "Set" or name == "Array" or name == "String" or name == "Int" {
            typeOwnerKey = name;
        } else if inferMode {
            genInfo := types.genericAliasTemplateInfo(source, nameStart, prefix, aliases, name);
            if genInfo.ownerKey =!= "" {
                typeOwnerKey = genInfo.ownerKey;
                aliasParamsCsv = genInfo.paramsCsv;
                aliasTplKind = genInfo.tplKind;
            } else {
                emptySeen: List<String> = [];
                canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
                if not canRes.ok or (not types.isEnumKind(canRes.kind) and not types.isRecordKind(canRes.kind) and not types.isDistinctKind(canRes.kind) and types.typeOpOwnerKey(canRes.kind) == "") {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                resolvedType = canRes.kind;
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
            }
        } else {
            genInfo := types.genericAliasTemplateInfo(source, nameStart, prefix, aliases, name);
            if genInfo.ownerKey =!= "" {
                typeOwnerKey = genInfo.ownerKey;
                aliasParamsCsv = genInfo.paramsCsv;
                aliasTplKind = genInfo.tplKind;
            } else {
                emptySeen: List<String> = [];
                resolvedType = types.resolveAliasKind(source, nameStart, prefix, aliases, name, emptySeen);
                typeOwnerKey = types.typeOpOwnerKey(resolvedType);
                if not types.isEnumKind(resolvedType) and not types.isRecordKind(resolvedType) and not types.isDistinctKind(resolvedType) and typeOwnerKey == "" {
                    syntax.failAt(source, nameStart, prefix, "enum case access requires an enum type, got " + types.displayKind(resolvedType));
                }
            }
        }
        memberStart := syntax.skipTrivia(source, dotPos + 1, prefix);
        if memberStart < source.length() and source.at(memberStart) == "$" {
            hookEnd := if memberStart + 1 < source.length() and source.at(memberStart + 1).isNameStart() {
                source.skipName(memberStart + 1)
            } else {
                memberStart + 1
            };
            syntax.failAt(source, memberStart, prefix, "compiler hook " + source.slice(memberStart, hookEnd) + " cannot be referenced directly; use [...] indexing");
        }
        if memberStart >= source.length() or not source.at(memberStart).isNameStart() {
            syntax.failAt(source, memberStart, prefix, "expected member name after " + name + ".");
        }
        memberEnd := source.skipName(memberStart);
        memberName := source.slice(memberStart, memberEnd);
        if types.isEnumKind(resolvedType) {
            caseIdx := types.enumCaseIndex(resolvedType, memberName);
            if caseIdx >= 0 {
                return parseEnumCaseConstruct(target, source, resolvedType, memberName, caseIdx, memberEnd, memberStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
            }
        }
        if typeOwnerKey =!= "" {
            opIdx := findTypeOp(functions, typeOwnerKey, memberName);
            if opIdx >= 0 {
                opRes := resolveTypeQualifiedOp(
                source, memberStart, prefix, opIdx, memberName, typeOwnerKey,
                resolvedType, aliasParamsCsv, aliasTplKind, functions, params, inferMode
                );
                if not opRes.ok {
                    return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
                }
                dispType := if resolvedType =!= "" { types.displayKind(resolvedType) } else { name };
                opCode := nameStart.toText() + (if opRes.initBindings =!= "" { "|" + opRes.initBindings } else { "" });
                return (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = opCode, intValue = opIdx,
                textValue = dispType + "." + memberName, constant = false, next = memberEnd);
            }
        }
        if types.isEnumKind(resolvedType) {
            syntax.failAt(source, memberStart, prefix, "enum " + types.enumDisplayName(resolvedType) + " has no case " + memberName);
        }
        if not isTypeApp and typeOwnerKey.startsWithAt(0, "Enum:") {
            syntax.failAt(source, nameStart, prefix, "generic type " + name + " requires explicit type arguments");
        }
        syntax.failAt(source, memberStart, prefix, "type " + name + " has no operation " + memberName);
    }
    if afterName < source.length() and source.at(afterName) == "{" and types.findAlias(aliases, name) >= 0 {
        var resolvedRec := "";
        if inferMode {
            emptySeen: List<String> = [];
            canRes := types.canResolveTypeAt(source, nameStart, prefix, aliases, "", emptySeen, 32);
            if not canRes.ok or not types.isRecordKind(canRes.kind) {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = start);
            }
            resolvedRec = canRes.kind;
        } else {
            emptySeen: List<String> = [];
            resolvedRec = types.resolveAliasKind(source, nameStart, prefix, aliases, name, emptySeen);
            if not types.isRecordKind(resolvedRec) {
                syntax.failAt(source, nameStart, prefix, "record construction requires a record type, got " + types.displayKind(resolvedRec));
            }
        }
        return parseRecordLiteral(target, source, afterName, prefix, locals, functions, params, currentName, resolvedRec, ctxs, iifeDepth, inferMode, aliases);
    }
    syntax.failAt(source, nameStart, prefix, "unknown value " + name);
    ctx.intParsed("", 0, true, start)
};

/** Emits TS or C11 tagged-union value code for payload-bearing enum case `caseIdx`. */
emitPayloadEnumValue := fn(target: String, enumKind: String, caseIdx: Int, argCodes: List<String>): String {
    if target == ir.TARGET_C {
        tag := types.cStructTag(enumKind);
        if argCodes.length() == 0 {
            return "/*@T:" + enumKind + "@*/((" + tag + "){ .tag = " + caseIdx.toText() + ", .u = { ._empty = 0 } })";
        }
        fieldsInitBuf: mut tb.TextBuilder;
        var pi := 0;
        loop pi < argCodes.length() {
            if pi > 0 { mut fieldsInitBuf.append(", "); }
            mut fieldsInitBuf.append(".f");
            mut fieldsInitBuf.append(pi.toText());
            mut fieldsInitBuf.append(" = ");
            mut fieldsInitBuf.append(argCodes[pi]);
            pi = pi + 1;
        }
        return "/*@T:" + enumKind + "@*/((" + tag + "){ .tag = " + caseIdx.toText() + ", .u = { .c" + caseIdx.toText() + " = { " + fieldsInitBuf.build() + " } } })";
    }
    tsT := types.tsFunctionType(enumKind);
    objBuf: mut tb.TextBuilder;
    mut objBuf.append("_t: ");
    mut objBuf.append(caseIdx.toText());
    mut objBuf.append(" as const");
    var pi := 0;
    loop pi < argCodes.length() {
        mut objBuf.append(", _");
        mut objBuf.append(pi.toText());
        mut objBuf.append(": ");
        mut objBuf.append(argCodes[pi]);
        pi = pi + 1;
    }
    "({ " + objBuf.build() + " } as " + tsT + ")"
};

/** Parses plain or payload-bearing enum case construction (`Enum.Case` / `.Case(...)`), validating payload count and types. */
parseEnumCaseConstruct := fn(target: String, source: String, enumKind: String, caseName: String, caseIdx: Int, caseEnd: Int, errPos: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    afterCase := syntax.skipTrivia(source, caseEnd, prefix);
    isPayload := types.isPayloadEnumKind(enumKind);
    emptyPayloads: List<String> = [];
    payloads := if isPayload { types.enumCasePayloads(enumKind, caseIdx) } else { emptyPayloads };
    if payloads.length() == 0 {
        if afterCase < size and source.at(afterCase) == "(" {
            syntax.failAt(source, afterCase, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " takes no payload arguments");
        }
        if isPayload {
            emptyArgs: List<String> = [];
            return (kind = enumKind, code = emitPayloadEnumValue(target, enumKind, caseIdx, emptyArgs), intValue = caseIdx, textValue = "", constant = false, next = caseEnd);
        }
        return (kind = enumKind, code = caseIdx.toText(), intValue = caseIdx, textValue = "", constant = true, next = caseEnd);
    }
    if afterCase >= size or source.at(afterCase) =!= "(" {
        syntax.failAt(source, errPos, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " requires " + payloads.length().toText() + " payload argument(s)");
    }
    var cursor := syntax.skipTrivia(source, afterCase + 1, prefix);
    argCodes: mut List<String> = [];
    var markers := "";
    var ai := 0;
    loop cursor < size and source.at(cursor) =!= ")" {
        if ai >= payloads.length() {
            syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " expects " + payloads.length().toText() + " payload argument(s)");
        }
        expKind := payloads[ai];
        arg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, expKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, arg); }
        if not types.isCompatibleKind(expKind, arg.kind) {
            syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " argument " + (ai + 1).toText() + " must be " + types.displayKind(expKind) + ", got " + types.displayKind(arg.kind));
        }
        mut argCodes.pushBack(ctx.assignValueCode(target, expKind, arg.kind, arg.code));
        ai = ai + 1;
        cursor = syntax.skipTrivia(source, arg.next, prefix);
        if cursor < size and source.at(cursor) == "," {
            cursor = syntax.skipTrivia(source, cursor + 1, prefix);
        } else {
            break;
        }
    }
    if cursor >= size or source.at(cursor) =!= ")" {
        syntax.failAt(source, cursor, prefix, "expected ) after enum payload arguments");
    }
    if argCodes.length() =!= payloads.length() {
        syntax.failAt(source, cursor, prefix, "enum case " + types.enumDisplayName(enumKind) + "." + caseName + " expects " + payloads.length().toText() + " payload argument(s), got " + argCodes.length().toText());
    }
    ctx.withMarkers((kind = enumKind, code = emitPayloadEnumValue(target, enumKind, caseIdx, argCodes), intValue = caseIdx, textValue = "", constant = false, next = cursor + 1), markers)
};

/** Resolves leading-dot enum case shorthand (`.Case`) or loop metadata expressions (`.count`, `.value`, `.item`, `.index`). */
resolveLeadingDotExpr := fn(target: String, source: String, start: Int, prefix: String, expected: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    fieldStart := syntax.skipTrivia(source, start + 1, prefix);
    size := source.length();
    if fieldStart >= size or not source.at(fieldStart).isNameStart() {
        syntax.failAt(source, fieldStart, prefix, "expected metadata field name after .");
    }
    fieldEnd := source.skipName(fieldStart);
    fieldName := source.slice(fieldStart, fieldEnd);
    allowThroughCond := fieldName == "item" or fieldName == "index" or fieldName == "count";
    loopIdx := ctx.findLeadingDotLoopIdx(ctxs, allowThroughCond);
    normExp := normalizeExpectedValueKind(expected);
    if types.isEnumKind(normExp) {
        isLoopMetaName := fieldName == "count" or fieldName == "value" or fieldName == "item" or fieldName == "index" or fieldName == "collected";
        if loopIdx >= 0 and isLoopMetaName {
            syntax.failAt(source, start, prefix, "ambiguous leading-dot ." + fieldName + "; qualify as " +
            types.enumDisplayName(normExp) + "." + fieldName + " or @tag." + fieldName);
        }
        caseIdx := types.enumCaseIndex(normExp, fieldName);
        if caseIdx < 0 {
            syntax.failAt(source, fieldStart, prefix, "enum " + types.enumDisplayName(normExp) + " has no case " + fieldName);
        }
        return parseEnumCaseConstruct(target, source, normExp, fieldName, caseIdx, fieldEnd, fieldStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    if loopIdx == ir.DOT_LOOP_IN_CONDITIONAL {
        syntax.failAt(source, start, prefix, "leading-dot ." + fieldName + " is not available inside a conditional; use an explicit loop @tag");
    } else if loopIdx == ir.DOT_LOOP_IN_FINALLY {
        syntax.failAt(source, start, prefix, "loop metadata is not available in finally");
    } else if loopIdx < 0 {
        syntax.failAt(source, start, prefix, "." + fieldName + " outside loop");
    }
    if target =!= ir.TARGET_TS and target =!= ir.TARGET_C {
        syntax.failAt(source, start, prefix, "C backend does not support loop metadata yet");
    }
    ctx.resolveLoopField(target, ctxs[loopIdx], fieldName, expected, source, fieldStart, fieldEnd, prefix)
};

/** Parses `{ ... }` block expressions, statement blocks, function bodies, loop bodies, finally blocks, and conditional branches. */
/** Emits one local declaration statement for TS or C11, unwrapping `/*@CBLK:<ret>@*/<body>` cleanly on C11. */
blockDeclStmt := fn(target: String, declKw: String, runtime: String, kind: String, tsTypeAnn: String, initCode: String): String {
    if target == ir.TARGET_C {
        if runtime.startsWithAt(0, "(*lt_cell_") {
            if initCode.startsWithAt(0, "/*@CBLK:") {
                endHdr := initCode.indexOf("@*/", 8);
                retVar := initCode.slice(8, endHdr);
                blkBody := initCode.slice(endHdr + 3, initCode.length());
                "{ " + blkBody + " " + runtime + " = " + retVar + "; }"
            } else {
                runtime + " = " + initCode + ";"
            }
        } else {
            cType := types.cValueType(kind);
            if initCode.startsWithAt(0, "/*@CBLK:") {
                endHdr := initCode.indexOf("@*/", 8);
                retVar := initCode.slice(8, endHdr);
                blkBody := initCode.slice(endHdr + 3, initCode.length());
                cType + " " + runtime + "; { " + blkBody + " " + runtime + " = " + retVar + "; } (void)" + runtime + ";"
            } else {
                cType + " " + runtime + " = " + initCode + "; (void)" + runtime + ";"
            }
        }
    } else {
        declKw + runtime + tsTypeAnn + " = " + initCode + "; void " + runtime + ";"
    }
};

/** Emits one assignment statement inside a block for TS or C11, unwrapping `/*@CBLK:<ret>@*/<body>` cleanly on C11. */
blockAssignStmt := fn(target: String, runtime: String, valCode: String): String {
    if target == ir.TARGET_C and valCode.startsWithAt(0, "/*@CBLK:") {
        endHdr := valCode.indexOf("@*/", 8);
        retVar := valCode.slice(8, endHdr);
        blkBody := valCode.slice(endHdr + 3, valCode.length());
        "{ " + blkBody + " " + runtime + " = " + retVar + "; }"
    } else {
        runtime + " = " + valCode + ";"
    }
};

/** Parses a braced block expression `{ ... }` and returns its evaluated target expression. */
parseBlockExpr := fn(target: String, source: String, start: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, bodySink: String, aliases: List<AliasDecl>): Parsed {
    isTaggedBody := bodySink == "tagged";
    isLoopBody := bodySink == "loopBody" or bodySink.startsWithAt(0, "loopBody:");
    isStmtBody := bodySink == "stmt" or bodySink.startsWithAt(0, "stmt:");
    isFinallyBody := bodySink == "finally";
    isBranchBody := bodySink == "branch";
    isFnBody := bodySink == "fnBody" or bodySink.startsWithAt(0, "fnBody:");
    isStandaloneBlock := not isTaggedBody and not isLoopBody and not isStmtBody and not isFinallyBody and not isBranchBody and not isFnBody;
    allowOutput := isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isBranchBody or isFnBody or (bodySink == "exprOut");
    bodyDepth := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { iifeDepth } else { iifeDepth + 1 };
    stmtReturnPrefix := if isTaggedBody or isLoopBody or isStmtBody or isFinallyBody or isFnBody { "" } else { "return " };
    var blockLocals: mut List<Local> = locals;
    outerLocalsLen := ctx.localsCount(blockLocals);
    blockLexDepth := ir.maxLocalLexDepth(blockLocals) + 1;
    emptyFuturesHere: List<FutureValue> = [];
    emptyItemsHere: List<Item> = [];
    nextAliasDepth := types.maxAliasDepth(aliases) + 1;
    blkFlags := syntax.scanBlockFastFlags(source, start, prefix);
    var blockAliases := if blkFlags.hasAliasKw {
        types.collectBlockTypeAliases(source, start, prefix, nextAliasDepth, aliases)
    } else {
        aliases
    };
    declaredInBlock: mut List<String> = [];
    var seedBag := "";
    loop ctx.seedBlockDeclaredNames(bodySink) as seededName {
        mut declaredInBlock.pushBack(seededName);
        seedBag = trace.appendPipeBag(seedBag, seededName);
    }
    hasFnInBlock := blkFlags.hasFn;
    hasReservedInBlock := blkFlags.hasReserved;
    blockAssignedBag := if hasReservedInBlock or hasFnInBlock {
        infer.scanInnerBlockAssignedBag(target, source, start, prefix, seedBag)
    } else {
        ""
    };
    statements: mut List<String> = [];
    if hasFnInBlock {
        preScannedLocals := infer.appendBlockFutureLocals(target, source, start, prefix, blockLexDepth, seedBag, blockAssignedBag, blockAliases, functions, params, blockLocals);
        if target == ir.TARGET_C {
            placeholderDepthC := 0 - 2 - blockLexDepth;
            boxedLocals: mut List<Local> = [];
            loop preScannedLocals as entry {
                if entry.depth == placeholderDepthC and entry.kind =!= "" and entry.kind =!= ir.VALUE_KIND_UNIT and entry.kind =!= ir.VALUE_KIND_NEVER {
                    cT := types.cValueType(entry.kind);
                    if cT =!= "" and cT =!= "void" {
                        cellPtr := "lt_cell_" + entry.runtime;
                        cellRt := "(*" + cellPtr + ")";
                        mut statements.pushBack("/*@T:" + entry.kind + "@*/" + cT + " *" + cellPtr + " = calloc(1, sizeof(" + cT + ")); if (" + cellPtr + " == NULL) { fprintf(stderr, \"MemoryFault\\n\"); exit(1); } (void)" + cellPtr + ";");
                        mut boxedLocals.pushBack((name = entry.name, runtime = cellRt, kind = entry.kind,
                        mutable = entry.mutable, writable = entry.writable, depth = entry.depth,
                        constant = entry.constant, code = entry.code, intValue = entry.intValue,
                        textValue = entry.textValue, initState = entry.initState));
                    } else {
                        mut boxedLocals.pushBack(entry);
                    }
                } else {
                    mut boxedLocals.pushBack(entry);
                }
            }
            blockLocals = boxedLocals;
        } else {
            blockLocals = preScannedLocals;
        }
    }
    stmtOwners: mut List<String> = [];
    stmtDeps: mut List<String> = [];
    var trackedStmtCount := 0;
    var statementCount := 0;
    var blockMarkers := "";
    var cursor := syntax.skipItemSeparators(source, start + 1, prefix);
    var blockKind := ir.VALUE_KIND_UNIT;
    var blockCode := ir.targetUnitLiteralCode(target);
    var blockInt := 0;
    var blockText := "";
    var blockConstant := true;
    var blockExits := false;
    var sawTailExpr := false;
    var lastPartialIfDiverges := false;
    blockSourceSize := source.length();
    loop true {
        var syncLen := 0;
        loop statements { syncLen = syncLen + 1; }
        loop trackedStmtCount < syncLen {
            mut stmtOwners.pushBack("");
            mut stmtDeps.pushBack(statements[trackedStmtCount]);
            trackedStmtCount = trackedStmtCount + 1;
        }
        cursor = syntax.skipItemSeparators(source, cursor, prefix);
        if cursor >= blockSourceSize {
            syntax.failAt(source, start, prefix, "expected }");
        }
        if source.at(cursor) == "}" {
            cursor = cursor + 1;
            break;
        }
        lastPartialIfDiverges = false;
        var isStatement := false;
        chAtCursor := source.at(cursor);
        scanDestr := scanDestructureStart(source, cursor, blockSourceSize, prefix);
        destructureOpen := scanDestr.openPos;
        destructureMutable := scanDestr.isMutable;
        if destructureOpen >= 0 {
            isStatement = true;
            destructure := parseAggregatePattern(source, destructureOpen, prefix, blockAliases);
            afterTarget := syntax.skipTrivia(source, destructure.next, prefix);
            if not source.startsWithAt(afterTarget, ":=") {
                syntax.failAt(source, afterTarget, prefix, "expected := after " + destructure.shape + " destructuring target");
            }
            rhs := parseBinaryCtx(target, source, syntax.skipTrivia(source, afterTarget + 2, prefix), prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
            if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
            if target == ir.TARGET_TS and not inferMode and not blockExits {
                trace.checkTraceSafety(source, destructureOpen, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
            }
            if destructure.shape == "tuple" and destructure.count == 0 {
                if destructureMutable {
                    syntax.failAt(source, destructureOpen, prefix, "var tuple destructuring needs at least one binding");
                }
                if types.isTupleKind(rhs.kind) {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring expected 0 fields, got " + types.tupleComponentCount(rhs.kind).toText());
                }
                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                    syntax.failAt(source, destructureOpen, prefix, "tuple destructuring requires Unit for (), got " + types.displayKind(rhs.kind));
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if not blockExits {
                    if rhs.kind == ir.VALUE_KIND_NEVER {
                        mut statements.pushBack(stmtReturnPrefix + "(" + rhs.code + ");");
                        blockExits = true;
                    } else {
                        mut statements.pushBack(if target == ir.TARGET_C { "(void)(" + rhs.code + ");" } else { "void (" + rhs.code + ");" });
                        if reach.isPrunableExprForTarget(target, ir.VALUE_KIND_UNIT, rhs.code) {
                            mut stmtOwners.pushBack("#discard");
                            mut stmtDeps.pushBack("");
                        } else {
                            mut stmtOwners.pushBack("");
                            mut stmtDeps.pushBack(rhs.code);
                        }
                        trackedStmtCount = trackedStmtCount + 1;
                    }
                    statementCount = statementCount + 1;
                }
                if target == ir.TARGET_TS and not inferMode {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                blockConstant = false;
                cursor = statementNext;
            } else if destructure.grouped {
                bindPart := types.decodeLengthPrefixedAt(destructure.encodedClauses, 0);
                bindName := bindPart.text;
                ctx.rejectNonValueBinding(source, destructureOpen, prefix, rhs.kind, bindName);
                ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                var groupedBindKind := rhs.kind;
                if destructure.groupedType =!= "" {
                    if not types.isCompatibleKind(destructure.groupedType, rhs.kind) {
                        syntax.failAt(source, destructureOpen, prefix, "cannot bind " + types.displayKind(rhs.kind) + " to " + types.displayKind(destructure.groupedType));
                    }
                    groupedBindKind = destructure.groupedType;
                }
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after tuple destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                bindFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(groupedBindKind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                mut declaredInBlock.pushBack(bindName);
                mut blockLocals.pushBack((name = bindName, runtime = bindRuntime, kind = groupedBindKind,
                mutable = destructureMutable, writable = false, depth = blockLexDepth, constant = false, code = bindFnDeps,
                intValue = rhs.intValue, textValue = rhs.textValue, initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    declKw := if destructureMutable { "let " } else { "const " };
                    tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(groupedBindKind) { ": " + types.tsFunctionType(groupedBindKind) } else { "" };
                    groupedCode := ctx.assignValueCode(target, groupedBindKind, rhs.kind, rhs.code);
                    mut statements.pushBack(blockDeclStmt(target, declKw, bindRuntime, groupedBindKind, tsTypeAnn, groupedCode));
                    mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, groupedBindKind, groupedCode) { bindRuntime } else { "" });
                    mut stmtDeps.pushBack(groupedCode);
                    trackedStmtCount = trackedStmtCount + 1;
                    statementCount = statementCount + 1;
                }
                blockConstant = false;
                cursor = statementNext;
            } else {
                tempPrefix := if destructure.shape == "record" { "lite$rec" } else if destructure.shape == "array" { "lite$arr" } else { "lite$tuple" };
                tempSlot := if destructure.shape == "record" { "$rec" } else if destructure.shape == "array" { "$arr" } else { "$tuple" };
                tempRuntime := ir.freshScopeTemp(blockLocals, tempPrefix);
                resolvedBindings := resolveAggregateBindings(target, destructure.shape, destructure.count, destructure.encodedClauses, rhs.kind, tempRuntime, source, destructureOpen, prefix);
                statementNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                if statementNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after " + destructure.shape + " destructuring"); }
                if target == ir.TARGET_TS and not inferMode and not blockExits {
                    blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, rhs.code);
                }
                aggFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(rhs.kind) { trace.computeCallableRhsDeps(rhs.code) } else { "" };
                mut blockLocals.pushBack((name = tempSlot, runtime = tempRuntime, kind = ir.VALUE_KIND_UNIT,
                mutable = false, writable = false, depth = blockLexDepth, constant = false, code = aggFnDeps,
                intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                if not blockExits {
                    mut statements.pushBack(blockDeclStmt(target, "const ", tempRuntime, rhs.kind, "", rhs.code));
                    mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, rhs.kind, rhs.code) { tempRuntime } else { "" });
                    mut stmtDeps.pushBack(rhs.code);
                    trackedStmtCount = trackedStmtCount + 1;
                }
                pendingDestrNames: mut List<String> = [];
                var bCursor := 0;
                var bIndex := 0;
                loop bIndex < destructure.count {
                    bindPart := types.decodeLengthPrefixedAt(resolvedBindings, bCursor);
                    propPart := types.decodeLengthPrefixedAt(resolvedBindings, bindPart.next);
                    srcPart := types.decodeLengthPrefixedAt(resolvedBindings, propPart.next);
                    tgtPart := types.decodeLengthPrefixedAt(resolvedBindings, srcPart.next);
                    bCursor = tgtPart.next;
                    bindName := bindPart.text;
                    propExpr := propPart.text;
                    srcKind := srcPart.text;
                    bindKind := tgtPart.text;
                    if not (destructure.shape == "record" and bindName == "_") {
                        ctx.rejectDuplicateInBlockNames(source, destructureOpen, prefix, declaredInBlock, bindName);
                        if not pendingDestrNames.contains(bindName) {
                            mut pendingDestrNames.pushBack(bindName);
                        }
                        bindRuntime := trace.claimOrMakeLocalRuntime(target, blockLocals, bindName, "", blockLexDepth);
                        fieldCode := ctx.assignValueCode(target, bindKind, srcKind, propExpr);
                        fieldFnDeps := if target == ir.TARGET_TS and not inferMode and types.containsFnKind(bindKind) {
                            "|" + tempRuntime + "|\n|" + tempRuntime + "|"
                        } else {
                            ""
                        };
                        mut blockLocals.pushBack((name = bindName, runtime = bindRuntime, kind = bindKind,
                        mutable = destructureMutable, writable = false, depth = blockLexDepth, constant = false, code = fieldFnDeps,
                        intValue = 0, textValue = "", initState = ir.INIT_STATE_INIT));
                        if not blockExits {
                            declKw := if destructureMutable { "let " } else { "const " };
                            tsTypeAnn := if target == ir.TARGET_TS and types.needsTsTypeAnnotation(bindKind) { ": " + types.tsFunctionType(bindKind) } else { "" };
                            mut statements.pushBack(blockDeclStmt(target, declKw, bindRuntime, bindKind, tsTypeAnn, fieldCode));
                            mut stmtOwners.pushBack(if reach.isPrunableExprForTarget(target, bindKind, fieldCode) { bindRuntime } else { "" });
                            mut stmtDeps.pushBack(fieldCode);
                            trackedStmtCount = trackedStmtCount + 1;
                        }
                    }
                    bIndex = bIndex + 1;
                }
                loop pendingDestrNames as destrName {
                    mut declaredInBlock.pushBack(destrName);
                }
                if not blockExits { statementCount = statementCount + 1; }
                blockConstant = false;
                cursor = statementNext;
            }
        } else if chAtCursor == "{" {
            braceEnd := syntax.scanBraceEnd(source, cursor, prefix);
            fullBraceEnd := if braceEnd >= 0 { syntax.scanTrailingFinallyEnd(source, braceEnd, prefix) } else { -1 };
            afterBrace := if fullBraceEnd >= 0 { syntax.skipItemSeparators(source, fullBraceEnd, prefix) } else { -1 };
            atTailBrace := (not isStmtBody) and afterBrace >= 0 and afterBrace < blockSourceSize and source.at(afterBrace) == "}";
            if not atTailBrace {
                isStatement = true;
                stmtBlock := parseBinaryCtx(target, source, cursor, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "stmt", blockAliases);
                if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtBlock); }
                afterStmtBlock := syntax.skipTrivia(source, stmtBlock.next, prefix);
                if afterStmtBlock < blockSourceSize and source.wordAt(afterStmtBlock, "then") {
                    syntax.failAt(source, afterStmtBlock, prefix, "then requires an if, match, or loop");
                }
                var stmtEndPos := stmtBlock.next;
                if afterStmtBlock < blockSourceSize and source.wordAt(afterStmtBlock, "finally") {
                    stmtFin := parseFinallyClause(target, source, afterStmtBlock, prefix, blockLocals, functions, params, currentName, ctxs, bodyDepth, inferMode, blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, stmtFin); }
                    if not blockExits {
                        if target == ir.TARGET_C {
                            fnIdxSF := ctx.findCtxByKindIndex(ctxs, "fn");
                            fnRetSF := if fnIdxSF >= 0 { ctxs[fnIdxSF].valKind } else { "" };
                            rewrittenSF := ctx.cRewriteFinallyExits(stmtBlock.code, stmtFin.code, fnRetSF, afterStmtBlock);
                            mut statements.pushBack("{ { " + rewrittenSF + " } { " + stmtFin.code + " } }");
                        } else {
                            mut statements.pushBack("try { " + stmtBlock.code + " } finally { " + stmtFin.code + " }");
                        }
                        if stmtBlock.kind == ir.VALUE_KIND_NEVER or stmtFin.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                        statementCount = statementCount + 1;
                    }
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtFin.code);
                    }
                    stmtEndPos = stmtFin.next;
                } else if not blockExits {
                    if stmtBlock.code =!= "" {
                        mut statements.pushBack("{ " + stmtBlock.code + " }");
                    }
                    if stmtBlock.kind == ir.VALUE_KIND_NEVER { blockExits = true; }
                    statementCount = statementCount + 1;
                    if target == ir.TARGET_TS and not inferMode {
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, stmtBlock.code);
                    }
                }
                blockConstant = false;
                stmtNext := syntax.consumeStatementEnd(source, stmtEndPos, prefix);
                cursor = if stmtNext >= 0 { stmtNext } else { stmtEndPos };
            }
        } else if chAtCursor == "@" {
            tagPeek := syntax.parseTagAt(source, cursor, prefix);
            afterPeek := syntax.skipTrivia(source, tagPeek.next, prefix);
            if afterPeek >= blockSourceSize or (source.at(afterPeek) =!= "{" and source.at(afterPeek) =!= "." and
            not source.wordAt(afterPeek, "if") and not source.wordAt(afterPeek, "match") and
            not source.wordAt(afterPeek, "loop")) {
                syntax.failAt(source, afterPeek, prefix, "expected {, if, match, loop or . after block tag @" + tagPeek.tag);
            }
        } else if chAtCursor.isNameStart() {
            itemStart := cursor;
            itemEnd := source.skipName(itemStart);
            itemName := source.slice(itemStart, itemEnd);
            afterItemName := syntax.skipTrivia(source, itemEnd, prefix);
            var blockOutputName := "";
            var blockOutputOpen := afterItemName;
            blockModIdx := sym.localIndex(blockLocals, itemName);
            if blockModIdx >= 0 and blockLocals[blockModIdx].kind == ir.VALUE_KIND_MODULE and
            afterItemName < blockSourceSize and source.at(afterItemName) == "." {
                memberStart := syntax.skipTrivia(source, afterItemName + 1, prefix);
                memberEnd := source.skipName(memberStart);
                if memberEnd > memberStart {
                    fnIdx := sym.findFunction(functions, itemName + "." + source.slice(memberStart, memberEnd));
                    if fnIdx >= 0 {
                        blockOutputName = builtinsAbi.coreOutputName(functions[fnIdx].runtime);
                        blockOutputOpen = syntax.skipTrivia(source, memberEnd, prefix);
                    }
                }
            }
            if blockOutputName =!= "" {
                isStatement = true;
                if not allowOutput {
                    syntax.failAt(source, itemStart, prefix, "host output functions are standalone statements");
                }
                var outPos := syntax.expectSymbol(source, blockOutputOpen, "(", prefix);
                outPos = syntax.skipTrivia(source, outPos, prefix);
                outParts: mut List<String> = [];
                var outArgCount := 0;
                var outDiverged := false;
                loop outPos < blockSourceSize and source.at(outPos) =!= ")" {
                    outArgStart := outPos;
                    outArg := parseBinaryCtx(target, source, outPos, prefix, blockLocals, functions, params, currentName, "", 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                    if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, outArg); }
                    if target == ir.TARGET_TS and not inferMode and not blockExits {
                        trace.checkTraceSafety(source, outArgStart, prefix, outArg.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                        blockLocals = trace.mergeOuterCallableUpdatesFromCode(blockLocals, outArg.code);
                    }
                    if types.containsFnKind(outArg.kind) {
                        syntax.failAt(source, outArgStart, prefix, "cannot output function value");
                    }
                    if not outDiverged {
                        if outArg.kind == ir.VALUE_KIND_NEVER {
                            if not blockExits {
                                mut statements.pushBack(stmtReturnPrefix + "(" + outArg.code + ");");
                                blockExits = true;
                            }
                            outDiverged = true;
                        } else if target == ir.TARGET_C {
                            baseOutKind := types.distinctBaseKind(outArg.kind);
                            cPr := if baseOutKind == ir.VALUE_KIND_UNIT {
                                if outArg.code == "0" { "printf(\"Unit\");" } else { "((void)(" + outArg.code + "), printf(\"Unit\"));" }
                            } else if types.isEnumKind(baseOutKind) and not types.isPayloadEnumKind(baseOutKind) {
                                dName := types.enumDisplayName(baseOutKind);
                                cCount := types.enumCaseCount(baseOutKind);
                                enumLabels: mut List<String> = [];
                                var eci := 0;
                                loop eci < cCount {
                                    mut enumLabels.pushBack(cLiteral.textLiteralCode(dName + "." + types.enumCaseAt(baseOutKind, eci).name));
                                    eci = eci + 1;
                                }
                                "printf(\"%s\", ((const char *const[]){" + enumLabels.join(", ") + "}[" + outArg.code + "]));"
                            } else if baseOutKind == ir.VALUE_KIND_BOOL {
                                "printf(\"%s\", (" + outArg.code + ") ? \"true\" : \"false\");"
                            } else if baseOutKind == ir.VALUE_KIND_STRING {
                                "lt_print_str(" + outArg.code + ");"
                            } else if numeric.isIntKind(baseOutKind) {
                                "printf(\"%\" PRId64, (int64_t)(" + outArg.code + "));"
                            } else if numeric.isFloatKind(baseOutKind) {
                                "/*@P:" + baseOutKind + "@*/lt_print_float(" + outArg.code + ");"
                            } else if types.isListKind(baseOutKind) or types.isArrayKind(baseOutKind) {
                                elK := if types.isListKind(baseOutKind) { types.listElementKind(baseOutKind) } else { types.arrayElementKind(baseOutKind) };
                                "/*@P:" + baseOutKind + "@*/lt_list_" + types.cListTag(elK) + "_print(" + outArg.code + ");"
                            } else if types.isMapKind(baseOutKind) {
                                "/*@P:" + baseOutKind + "@*/" + types.cMapTag(baseOutKind) + "_print(" + outArg.code + ");"
                            } else if types.isSetKind(baseOutKind) {
                                "/*@P:" + baseOutKind + "@*/" + types.cSetTag(baseOutKind) + "_print(" + outArg.code + ");"
                            } else if types.cStructTag(baseOutKind) =!= "" {
                                "/*@P:" + baseOutKind + "@*/" + types.cStructTag(baseOutKind) + "_print(" + outArg.code + ");"
                            } else {
                                "printf(\"%\" PRId64, (int64_t)(" + outArg.code + "));"
                            };
                            mut outParts.pushBack(cPr);
                        } else {
                            mut outParts.pushBack(types.tsDisplayValueCode(outArg.kind, outArg.code));
                        }
                    }
                    outArgCount = outArgCount + 1;
                    outPos = syntax.skipTrivia(source, outArg.next, prefix);
                    if outPos < blockSourceSize and source.at(outPos) == "," {
                        outPos = syntax.skipTrivia(source, outPos + 1, prefix);
                    } else {
                        break;
                    }
                }
                outPos = syntax.expectSymbol(source, outPos, ")", prefix);
                stmtNext := syntax.consumeStatementEnd(source, outPos, prefix);
                if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, outPos, prefix), prefix, "expected ; after " + blockOutputName); }
                if not outDiverged and not blockExits {
                    if target == ir.TARGET_C {
                        cOutBody := outParts.join(" printf(\" \"); ");
                        cNewline := if blockOutputName == "outputLine" { " printf(\"\\n\");" } else { "" };
                        mut statements.pushBack("{ " + cOutBody + cNewline + " }");
                    } else {
                        lineCode := if outArgCount == 0 {
                            tsLiteral.textLiteralCode(if blockOutputName == "outputLine" { "\n" } else { "" })
                        } else {
                            joinedArgs := outParts.join(" + \" \" + ");
                            ending := if blockOutputName == "outputLine" { " + \"\\n\"" } else { "" };
                            if ending =!= "" { "(" + joinedArgs + ")" + ending } else { joinedArgs }
                        };
                        mut statements.pushBack("lite$emit(" + lineCode + ");");
                    }
                }
                if not blockExits or outDiverged { statementCount = statementCount + 1; }
                blockConstant = false;
                cursor = stmtNext;
            } else if itemName == "return" {
                isStatement = true;
                var hasTargetTag := false;
                var targetTagName := "";
                var targetTagPos := afterItemName;
                var retValStart := afterItemName;
                if afterItemName < blockSourceSize and source.at(afterItemName) == "@" {
                    retTag := syntax.parseTagAt(source, afterItemName, prefix);
                    afterRetTag := syntax.skipTrivia(source, retTag.next, prefix);
                    if afterRetTag >= blockSourceSize or source.at(afterRetTag) =!= "." {
                        hasTargetTag = true;
                        targetTagName = retTag.tag;
                        retValStart = afterRetTag;
                    }
                }
                if hasTargetTag {
                    targetIdx := ctx.findTaggedCtxIndex(ctxs, targetTagName);
                    if targetIdx < 0 {
                        syntax.failAt(source, targetTagPos, prefix, "unknown block tag @" + targetTagName);
                    }
                    targetCtx := ctxs[targetIdx];
                    if targetCtx.phase == ir.CTX_PHASE_THEN {
                        syntax.failAt(source, itemStart, prefix, "cannot return to @" + targetCtx.tag + " from inside its own then block");
                    }
                    if ctx.hasFinallyAbove(ctxs, targetIdx) {
                        syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                    }
                    isInferTarget := isInferPlaceholderKind(targetCtx.valKind);
                    if retValStart >= blockSourceSize or source.at(retValStart) == ";" or source.at(retValStart) == "}" {
                        if not isInferTarget and targetCtx.valKind =!= ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns " +
                            types.displayKind(targetCtx.valKind) + " and cannot return Unit");
                        }
                        stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                        if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                        if inferMode {
                            blockMarkers = blockMarkers + targetCtx.id.toText() + "=Unit\n";
                        }
                        if not blockExits {
                            if target == ir.TARGET_C {
                                mut statements.pushBack("goto " + targetCtx.label + ";");
                            } else if targetCtx.iifeDepth == bodyDepth {
                                mut statements.pushBack("break " + targetCtx.label + ";");
                            } else {
                                mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + targetCtx.id.toText() + ", undefined);");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    } else {
                        retExpected := inferHintKind(targetCtx.valKind);
                        rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, retExpected, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            if types.containsFnKind(rhs.kind) {
                                tagExitDepth := trace.parseLexDepthTag(targetCtx.iterLabel, blockLexDepth);
                                trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, tagExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                        if not isInferTarget {
                            if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                if rhs.kind =!= ir.VALUE_KIND_UNIT and rhs.kind =!= ir.VALUE_KIND_NEVER {
                                    syntax.failAt(source, itemStart, prefix, "block @" + targetCtx.tag + " returns Unit and cannot return a value");
                                }
                            } else if rhs.kind =!= ir.VALUE_KIND_NEVER and not types.isCompatibleKind(targetCtx.valKind, rhs.kind) {
                                syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                                " from block @" + targetCtx.tag + " returning " + types.displayKind(targetCtx.valKind));
                            }
                        }
                        if inferMode and rhs.kind =!= ir.VALUE_KIND_NEVER and types.loopValMarkerId(rhs.kind) < 0 {
                            blockMarkers = blockMarkers + targetCtx.id.toText() + "=" + rhs.kind + "\n";
                        }
                        if not blockExits {
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                mut statements.pushBack(stmtReturnPrefix + "(" + rhs.code + ");");
                            } else {
                                retValCode := if isInferTarget { rhs.code }
                                else if targetCtx.valKind == ir.VALUE_KIND_UNIT { ir.targetUnitEvaluationCode(target, rhs.code) }
                                else { ctx.assignValueCode(target, targetCtx.valKind, rhs.kind, rhs.code) };
                                if target == ir.TARGET_C {
                                    if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                        mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_UNIT, retValCode) + " goto " + targetCtx.label + ";");
                                    } else {
                                        mut statements.pushBack(ctx.cUnwrapIntoVar(targetCtx.valVar, targetCtx.valKind, retValCode) + " goto " + targetCtx.label + ";");
                                    }
                                } else if targetCtx.iifeDepth == bodyDepth {
                                    if targetCtx.valKind == ir.VALUE_KIND_UNIT {
                                        mut statements.pushBack("void (" + retValCode + "); break " + targetCtx.label + ";");
                                    } else {
                                        mut statements.pushBack(targetCtx.valVar + " = " + retValCode + "; break " + targetCtx.label + ";");
                                    }
                                } else {
                                    mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + targetCtx.id.toText() + ", " + retValCode + ");");
                                }
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    }
                } else {
                    fnIdx := ctx.findCtxByKindIndex(ctxs, "fn");
                    if fnIdx < 0 {
                        if ctx.hasFinallyAbove(ctxs, -1) {
                            syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                        }
                        syntax.failAt(source, itemStart, prefix, "return outside a function");
                    }
                    if ctx.hasFinallyAbove(ctxs, fnIdx) {
                        syntax.failAt(source, itemStart, prefix, "cannot return out of finally block");
                    }
                    fnCtx := ctxs[fnIdx];
                    fnResult := fnCtx.valKind;
                    if retValStart >= blockSourceSize or source.at(retValStart) == ";" or source.at(retValStart) == "}" {
                        if fnResult =!= ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "function " + currentName + " must return " + types.displayKind(fnResult));
                        }
                        stmtNext := syntax.consumeStatementEnd(source, retValStart, prefix);
                        if stmtNext < 0 { syntax.failAt(source, retValStart, prefix, "expected ; after return"); }
                        if not blockExits {
                            if fnCtx.iifeDepth == bodyDepth or target == ir.TARGET_C {
