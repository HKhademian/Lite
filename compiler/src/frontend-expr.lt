                            itemVal := if target == ir.TARGET_C and numeric.isIntKind(backing) and rawVal.length() >= 2 and rawVal.at(rawVal.length() - 1) == "n" {
                                rawVal.slice(0, rawVal.length() - 1)
                            } else if target == ir.TARGET_C and numeric.isIntKind(backing) and rawVal.length() >= 4 and rawVal.startsWithAt(0, "(-") and rawVal.startsWithAt(rawVal.length() - 2, "n)") {
                                rawVal.slice(0, rawVal.length() - 2) + ")"
                            } else if target == ir.TARGET_C and numeric.isFloatKind(backing) and rawVal.startsWithAt(0, "Number(\"") and rawVal.length() > 10 {
