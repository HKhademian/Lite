                            } else {
                                mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(0, undefined);");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    } else {
                        if fnResult == ir.VALUE_KIND_UNIT {
                            syntax.failAt(source, itemStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
                        }
                        rhs := parseBinaryCtx(target, source, retValStart, prefix, blockLocals, functions, params, currentName, fnResult, 0, ctxs, bodyDepth, inferMode, "", blockAliases);
                        if inferMode { blockMarkers = ctx.collectParsedMarkers(blockMarkers, rhs); }
                        if not types.isCompatibleKind(fnResult, rhs.kind) {
                            syntax.failAt(source, retValStart, prefix, "cannot return " + types.displayKind(rhs.kind) +
                            " from function " + currentName + " returning " + types.displayKind(fnResult));
                        }
                        if target == ir.TARGET_TS and not inferMode and not blockExits {
                            trace.checkTraceSafety(source, retValStart, prefix, rhs.code, currentName, -1, blockLocals, functions, emptyFuturesHere, emptyItemsHere);
                            if types.containsFnKind(rhs.kind) {
                                fnExitDepth := trace.parseLexDepthTag(fnCtx.iterLabel, 1);
                                trace.checkEscapingFnSafety(source, retValStart, prefix, rhs.code, fnExitDepth, blockLocals);
                            }
                        }
                        stmtNext := syntax.consumeStatementEnd(source, rhs.next, prefix);
                        if stmtNext < 0 { syntax.failAt(source, syntax.skipTrivia(source, rhs.next, prefix), prefix, "expected ; after return"); }
                        if not blockExits {
                            retValCode := ctx.assignValueCode(target, fnResult, rhs.kind, rhs.code);
                            if rhs.kind == ir.VALUE_KIND_NEVER {
                                if target == ir.TARGET_C {
                                    mut statements.pushBack(ctx.cUnwrapIntoVar("", ir.VALUE_KIND_NEVER, retValCode));
                                } else {
                                    mut statements.pushBack(stmtReturnPrefix + "(" + retValCode + ");");
                                }
                            } else if target == ir.TARGET_C {
                                if retValCode.startsWithAt(0, "/*@CBLK:") {
                                    endHdrR := retValCode.indexOf("@*/", 8);
                                    retVarR := retValCode.slice(8, endHdrR);
                                    blkBodyR := retValCode.slice(endHdrR + 3, retValCode.length());
                                    if retVarR == "0" {
                                        mut statements.pushBack("{ " + blkBodyR + " }");
                                    } else {
                                        mut statements.pushBack("{ " + types.cValueType(fnResult) + " lt_ret; " + blkBodyR + " lt_ret = " + retVarR + "; return lt_ret; }");
                                    }
                                } else {
                                    mut statements.pushBack("return " + retValCode + ";");
                                }
                            } else if fnCtx.iifeDepth == bodyDepth {
                                mut statements.pushBack("return " + retValCode + ";");
                            } else {
                                mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(0, " + retValCode + ");");
                            }
                            blockExits = true;
                        }
                        statementCount = statementCount + 1;
                        blockConstant = false;
                        cursor = stmtNext;
                    }
                }
            } else if itemName == "break" or itemName == "continue" {
                isStatement = true;
                var targetLoopIdx := -1;
                var afterExit := afterItemName;
                if afterItemName < blockSourceSize and source.at(afterItemName) == "@" {
                    exitTag := syntax.parseTagAt(source, afterItemName, prefix);
                    afterDotCheck := syntax.skipTrivia(source, exitTag.next, prefix);
                    if afterDotCheck < blockSourceSize and source.at(afterDotCheck) == "." {
                        syntax.failAt(source, afterDotCheck, prefix, itemName + " @" + exitTag.tag + " followed by . is ambiguous; wrap the payload in parentheses");
                    }
                    foundIdx := ctx.findTaggedCtxIndex(ctxs, exitTag.tag);
                    if foundIdx < 0 {
                        syntax.failAt(source, afterItemName, prefix, "unknown block tag @" + exitTag.tag);
                    }
                    if ctxs[foundIdx].kind =!= ir.CTX_KIND_LOOP {
                        syntax.failAt(source, afterItemName, prefix, itemName + " @" + exitTag.tag + " requires an enclosing loop");
                    }
                    if ctxs[foundIdx].phase == ir.CTX_PHASE_THEN {
                        syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " @" + exitTag.tag + " from inside its own then block");
                    }
                    targetLoopIdx = foundIdx;
                    afterExit = afterDotCheck;
                } else {
                    targetLoopIdx = ctx.findActiveLoopCtxIndex(ctxs);
                    if targetLoopIdx < 0 {
                        if ctx.hasFinallyAbove(ctxs, -1) {
                            syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                        }
                        syntax.failAt(source, itemStart, prefix, itemName + " outside loop");
                    }
                }
                if ctx.hasFinallyAbove(ctxs, targetLoopIdx) {
                    syntax.failAt(source, itemStart, prefix, "cannot " + itemName + " out of finally block");
                }
