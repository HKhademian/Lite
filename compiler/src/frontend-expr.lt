                        stmtPart := ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[cIdx], passBranchCodes[cIdx]);
                        if emittedCondCount == 0 {
                            mut rawIfBuf.append(stmtPart);
                        } else {
                            mut rawIfBuf.append(" else { ");
                            mut rawIfBuf.append(stmtPart);
                            mut rawIfBuf.append(" }");
                        }
                        hitConstTrue = true;
                        break;
                    }
                    if cState =!= 0 {
                        kwPrefix := if emittedCondCount == 0 { "if (" } else { " else if (" };
                        stmtPart := ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[cIdx], passBranchCodes[cIdx]);
                        condExprWrap := if isCCond { passCondCodes[cIdx] } else { "Boolean(" + passCondCodes[cIdx] + ")" };
                        mut rawIfBuf.append(kwPrefix);
                        mut rawIfBuf.append(condExprWrap);
                        mut rawIfBuf.append(") { ");
                        mut rawIfBuf.append(stmtPart);
                        mut rawIfBuf.append(" }");
                        emittedCondCount = emittedCondCount + 1;
                    }
                    cIdx = cIdx + 1;
                }
                if not hitConstTrue and passHasElse {
                    elsePart := ctx.condBranchStmtCode(target, resolvedPreThenKind, condValVar, passBranchKinds[passBranchCount - 1], passBranchCodes[passBranchCount - 1]);
                    if emittedCondCount == 0 {
                        mut rawIfBuf.append(elsePart);
                    } else {
                        mut rawIfBuf.append(" else { ");
                        mut rawIfBuf.append(elsePart);
                        mut rawIfBuf.append(" }");
                    }
                }
                rawIfStmt = rawIfBuf.build();
            }
            needsCondTry := not isCCond and condParseTag =!= "" and reach.codeUsesTextCall(rawIfStmt, "lite$throwTransfer(" + condId.toText() + ",");
            if isCCond and condParseTag =!= "" and reach.codeUsesTextCall(rawIfStmt, "goto " + condLabel + ";") {
                condStmtCode = rawIfStmt + " " + condLabel + ": ;";
            } else if needsCondTry {
                catchAssign := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER { "" }
                else { condValVar + " = lite$transferVal;" };
                condStmtCode = "try { " + rawIfStmt + " } catch (lite$err) { if (lite$hasTransfer(lite$err, " +
                condId.toText() + ")) { " + catchAssign + " } else { throw lite$err; } }";
            } else {
                condStmtCode = rawIfStmt;
            }
        }
        pass = pass + 1;
    }
    var condIifeBody := "";
    var left := ctx.intParsed("", 0, true, condParseStart);
    if hasActualThen {
        thenKwPos := syntax.skipTrivia(source, condEndCursor, prefix);
        afterThenKw := syntax.skipTrivia(source, thenKwPos + 4, prefix);
        syntax.rejectMisplacedTag(source, afterThenKw, prefix, "block tag cannot appear after then");
        thenOpen := syntax.expectSymbol(source, afterThenKw, "{", prefix);
        thenId := condId + 1;
        thenValVar := if isCCond { "lt_cthen_" + thenId.toText() } else { "lite$val" + thenId.toText() };
        thenLabel := if isCCond { "lt_cb_" + thenId.toText() } else { "lite$b" + thenId.toText() };
        thenPass1ValKind := if normExpected == "" { ir.VAL_KIND_INFER } else { (ir.VAL_KIND_INFER + ":") + normExpected };
        thenPass1Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
        iifeDepth = condDepth, valKind = thenPass1ValKind, valVar = thenValVar, label = thenLabel,
        iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false, colVar = "");
        thenPass1 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
        normExpected, 0, ctx.appendCtx(ctxs, thenPass1Ctx), condDepth, true, "tagged", aliases);
        if inferMode {
            thenMarkers := condOuterMarkers + ctx.collectParsedMarkers("", thenPass1);
            finalKind := if resolvedPreThenKind == ir.VALUE_KIND_NEVER { ir.VALUE_KIND_NEVER } else { thenPass1.kind };
            left = ctx.withMarkers((kind = finalKind, code = "", intValue = 0, textValue = "", constant = false, next = thenPass1.next), thenMarkers);
        } else {
            thenValKind := thenPass1.kind;
            thenPass2Expected := if thenValKind == ir.VALUE_KIND_UNIT or thenValKind == ir.VALUE_KIND_NEVER { "" } else { thenValKind };
            thenPass2Ctx := (id = thenId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_THEN,
            iifeDepth = condDepth, valKind = thenValKind, valVar = thenValVar, label = thenLabel,
            iterLabel = "", countVar = "", itemVar = condValVar, itemKind = resolvedPreThenKind, indexVar = "", hasIndex = false, colVar = "");
            thenPass2 := parseBinaryCtx(target, source, thenOpen - 1, prefix, locals, functions, params, currentName,
            thenPass2Expected, 0, ctx.appendCtx(ctxs, thenPass2Ctx), condDepth, false, "tagged", aliases);
            if isCCond {
                if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                    left = (kind = ir.VALUE_KIND_NEVER, code = "/*@CBLK:0@*/" + condStmtCode,
                    intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                } else {
                    cValDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                        ""
                    } else {
                        types.cValueType(resolvedPreThenKind) + " " + condValVar + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; (void)" + condValVar + "; "
                    };
                    if thenValKind == ir.VALUE_KIND_UNIT or thenValKind == ir.VALUE_KIND_NEVER {
                        cThenBody := ctx.cUnwrapIntoVar("", thenValKind, thenPass2.code);
                        left = (kind = thenValKind, code = "/*@CBLK:0@*/{ " + cValDecl + condStmtCode + " " + cThenBody + " }",
                        intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                    } else {
                        cThenRes := "lt_ctres_" + thenId.toText();
                        cThenAssign := ctx.cUnwrapIntoVar(cThenRes, thenValKind, thenPass2.code);
                        left = (kind = thenValKind,
                        code = "/*@CBLK:" + cThenRes + "@*/" + types.cValueType(thenValKind) + " " + cThenRes + "; { " + cValDecl + condStmtCode + " " + cThenAssign + " }",
                        intValue = 0, textValue = "", constant = false, next = thenPass2.next);
                    }
                }
            } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
                condIifeBody = condStmtCode;
                left = (kind = ir.VALUE_KIND_NEVER, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            } else {
                valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
                    ""
                } else {
                    "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; void " + condValVar + "; "
                };
                thenRet := if thenValKind == ir.VALUE_KIND_UNIT {
                    "void (" + thenPass2.code + "); return undefined;"
                } else {
                    "return " + thenPass2.code + ";"
                };
                condIifeBody = valDecl + condStmtCode + " " + thenRet;
                left = (kind = thenValKind, code = "(() => { " + condIifeBody + " })()",
                intValue = 0, textValue = "", constant = false, next = thenPass2.next);
            }
        }
    } else if inferMode {
        left = ctx.withMarkers((kind = resolvedPreThenKind, code = "", intValue = 0, textValue = "", constant = false, next = condEndCursor), condOuterMarkers);
    } else if isCCond {
        if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            left = (kind = resolvedPreThenKind, code = "/*@CBLK:0@*/{ " + condStmtCode + " }",
            intValue = 0, textValue = "", constant = false, next = condEndCursor);
        } else {
            left = (kind = resolvedPreThenKind,
            code = "/*@CBLK:" + condValVar + "@*/" + types.cValueType(resolvedPreThenKind) + " " + condValVar + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; { " + condStmtCode + " }",
            intValue = 0, textValue = "", constant = false, next = condEndCursor);
        }
    } else {
        valDecl := if resolvedPreThenKind == ir.VALUE_KIND_UNIT or resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            "let " + condValVar + ": " + types.tsFunctionType(resolvedPreThenKind) + " = " + ctx.zeroParsed(target, resolvedPreThenKind, 0).code + "; "
        };
        finalRet := if resolvedPreThenKind == ir.VALUE_KIND_UNIT {
            " return undefined;"
        } else if resolvedPreThenKind == ir.VALUE_KIND_NEVER {
            ""
        } else {
            " return " + condValVar + ";"
        };
        condIifeBody = valDecl + condStmtCode + finalRet;
        left = (kind = resolvedPreThenKind, code = "(() => { " + condIifeBody + " })()",
        intValue = 0, textValue = "", constant = false, next = condEndCursor);
    }
    afterCondConstruct := syntax.skipTrivia(source, left.next, prefix);
    if hasActualThen and afterCondConstruct < source.length() and source.wordAt(afterCondConstruct, "then") {
        syntax.failAt(source, afterCondConstruct, prefix, "duplicate then block");
    }
    if afterCondConstruct < source.length() and source.wordAt(afterCondConstruct, "finally") {
        condFinCtx := (id = condId, tag = condParseTag, kind = condParseKind, phase = ir.CTX_PHASE_FINALLY,
        iifeDepth = condDepth, valKind = resolvedPreThenKind, valVar = condValVar, label = condLabel,
        iterLabel = "", countVar = "", itemVar = "", itemKind = "", indexVar = "", hasIndex = false, colVar = "");
        finParsed := parseFinallyClause(target, source, afterCondConstruct, prefix, locals, functions, params, currentName,
        ctx.appendCtx(ctxs, condFinCtx), condDepth, inferMode, aliases);
        if isCCond {
            left = finishFinallyC(left.code, finParsed, left.kind, left, inferMode, ctxs, condId);
        } else {
            left = finishFinallyIife(condIifeBody, finParsed, left.kind, left, inferMode);
        }
    }
    left
};

/** Parses list push/pop intrinsic operations (`push_back`, `pop_back`, `push_front`, `pop_front`). */
parseListIntrinsicCall := fn(target: String, source: String, start: Int, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "length" or opName == "reverse" or opName == "slice" {
        open := syntax.expectSymbol(source, argOpen, "(", prefix);
        listStart := syntax.skipTrivia(source, open, prefix);
        lst := parseBinaryCtx(target, source, listStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isListKind(lst.kind) {
            syntax.failAt(source, listStart, prefix, opDisplay + " expects a List, got " + types.displayKind(lst.kind));
        }
        if opName == "length" {
            close := ctx.expectNonemptyCallClose(source, lst.next, prefix);
            lenCode := if target == ir.TARGET_C { "((" + lst.code + ").len)" } else { "BigInt((" + lst.code + ").length)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lenCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", lst) } else { "" });
        }
        if opName == "reverse" {
            close := ctx.expectNonemptyCallClose(source, lst.next, prefix);
            revTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(lst.kind)) } else { "" };
            revCode := if revTag =!= "" { "lt_list_" + revTag + "_reverse(" + lst.code + ")" } else { "[...(" + lst.code + ")].reverse()" };
            return ctx.withMarkers((kind = lst.kind, code = revCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", lst) } else { "" });
        }
        comma1 := syntax.skipTrivia(source, lst.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects start index after the list");
        }
        sStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        sArg := parseBinaryCtx(target, source, sStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(sArg.kind) {
            syntax.failAt(source, sStart, prefix, opDisplay + " start index must be Int, got " + types.displayKind(sArg.kind));
        }
        comma2 := syntax.skipTrivia(source, sArg.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects end index after start");
        }
        eStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        eArg := parseBinaryCtx(target, source, eStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(eArg.kind) {
            syntax.failAt(source, eStart, prefix, opDisplay + " end index must be Int, got " + types.displayKind(eArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, eArg.next, prefix);
        sCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, sArg.kind, sArg.code);
        eCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, eArg.kind, eArg.code);
        mk := if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers(ctx.collectParsedMarkers("", lst), sArg), eArg) } else { "" };
        slTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(lst.kind)) } else { "" };
        slCode := if slTag =!= "" {
            "lt_list_" + slTag + "_slice(" + lst.code + ", " + sCode + ", " + eCode + ", " + start.toText() + ")"
        } else {
            "lite$listSlice(" + lst.code + ", " + sCode + ", " + eCode + ", " + start.toText() + ")"
        };
        return ctx.withMarkers((kind = lst.kind, code = slCode,
        intValue = 0, textValue = "", constant = false, next = close), mk);
    }
    grant := ctx.parseListGrant(source, argOpen, prefix, locals, opDisplay);
    grantTag := if target == ir.TARGET_C { types.cListTag(types.listElementKind(grant.kind)) } else { "" };
    if opName == "clear" {
        close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
        clrCode := if grantTag =!= "" { "lt_list_" + grantTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").length = 0, undefined)" };
        return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
        intValue = 0, textValue = "", constant = false, next = close);
    }
    if opName == "set_at" {
        comma1 := syntax.skipTrivia(source, grant.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects an index after the mut list");
        }
        idxStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        idxArg := parseBinaryCtx(target, source, idxStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not numeric.isIntKind(idxArg.kind) {
            syntax.failAt(source, idxStart, prefix, opDisplay + " index must be Int, got " + types.displayKind(idxArg.kind));
        }
        comma2 := syntax.skipTrivia(source, idxArg.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects a value after the index");
        }
        valStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        elementKind := types.listElementKind(grant.kind);
        valArg := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elementKind, valArg.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elementKind) + ", got " + types.displayKind(valArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
        idxCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
        valCode := ctx.assignValueCode(target, elementKind, valArg.kind, valArg.code);
        mk := if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", idxArg), valArg) } else { "" };
        setCode := if grantTag =!= "" {
            "lt_list_" + grantTag + "_set(&" + grant.runtime + ", " + idxCode + ", " + valCode + ", " + start.toText() + ")"
        } else {
            "lite$listSet(" + grant.runtime + ", " + idxCode + ", " + valCode + ", " + start.toText() + ")"
        };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode,
        intValue = 0, textValue = "", constant = false, next = close), mk);
    }
    if opName == "push_back" or opName == "push_front" {
        cursor := syntax.skipTrivia(source, grant.next, prefix);
        if cursor >= source.length() or source.at(cursor) =!= "," {
            syntax.failAt(source, cursor, prefix, opDisplay + " expects a value after the mut list");
        }
        valueStart := syntax.skipTrivia(source, cursor + 1, prefix);
        elementKind := types.listElementKind(grant.kind);
        value := parseBinaryCtx(target, source, valueStart, prefix, locals, functions, params, currentName, elementKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elementKind, value.kind) {
            syntax.failAt(source, valueStart, prefix, opDisplay + " element must be " + types.displayKind(elementKind) +
            ", got " + types.displayKind(value.kind));
        }
        close := ctx.expectNonemptyCallClose(source, value.next, prefix);
        vCode := ctx.assignValueCode(target, elementKind, value.kind, value.code);
        pushCode := if grantTag =!= "" {
            "lt_list_" + grantTag + "_" + opName + "(&" + grant.runtime + ", " + vCode + ")"
        } else {
            method := if opName == "push_back" { ".push(" } else { ".unshift(" };
            grant.runtime + method + vCode + ")"
        };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = pushCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", value) } else { "" });
    }
    close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
    popCode := if grantTag =!= "" {
        "lt_list_" + grantTag + "_" + opName + "(&" + grant.runtime + ", " + start.toText() + ")"
    } else {
        helper := if opName == "pop_back" { "lite$listPopBack(" } else { "lite$listPopFront(" };
        helper + grant.runtime + ", " + start.toText() + ")"
    };
    (kind = types.listElementKind(grant.kind), code = popCode,
    intValue = 0, textValue = "", constant = false, next = close)
};

/** Parses and lowers a `core/map` generic intrinsic call (`set`, `get`, `getOr`, `has`, `remove`, `size`, `clear`, `keys`, `values`). */
parseMapIntrinsicCall := fn(target: String, source: String, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "set" or opName == "remove" or opName == "clear" {
        grant := ctx.parseMapGrant(source, argOpen, prefix, locals, opDisplay);
        kKind := types.mapKeyKind(grant.kind);
        vKind := types.mapValueKind(grant.kind);
        mTag := if target == ir.TARGET_C { types.cMapTag(grant.kind) } else { "" };
        if opName == "clear" {
            close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
            clrCode := if mTag =!= "" { mTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").clear(), undefined)" };
            return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
            intValue = 0, textValue = "", constant = false, next = close);
        }
        comma1 := syntax.skipTrivia(source, grant.next, prefix);
        if comma1 >= source.length() or source.at(comma1) =!= "," {
            syntax.failAt(source, comma1, prefix, opDisplay + " expects a key after the mut map");
        }
        keyStart := syntax.skipTrivia(source, comma1 + 1, prefix);
        key := parseBinaryCtx(target, source, keyStart, prefix, locals, functions, params, currentName, kKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(kKind, key.kind) {
            syntax.failAt(source, keyStart, prefix, opDisplay + " key must be " + types.displayKind(kKind) + ", got " + types.displayKind(key.kind));
        }
        keyCode := ctx.assignValueCode(target, kKind, key.kind, key.code);
        if opName == "remove" {
            close := ctx.expectNonemptyCallClose(source, key.next, prefix);
            rmCode := if mTag =!= "" { mTag + "_remove(&" + grant.runtime + ", " + keyCode + ")" } else { "((" + grant.runtime + ").delete(" + keyCode + "))" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", key) } else { "" });
        }
        comma2 := syntax.skipTrivia(source, key.next, prefix);
        if comma2 >= source.length() or source.at(comma2) =!= "," {
            syntax.failAt(source, comma2, prefix, opDisplay + " expects a value after the key");
        }
        valStart := syntax.skipTrivia(source, comma2 + 1, prefix);
        val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, vKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(vKind, val.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " value must be " + types.displayKind(vKind) + ", got " + types.displayKind(val.kind));
        }
        close := ctx.expectNonemptyCallClose(source, val.next, prefix);
        valCode := ctx.assignValueCode(target, vKind, val.kind, val.code);
        setCode := if mTag =!= "" { mTag + "_set(&" + grant.runtime + ", " + keyCode + ", " + valCode + ")" } else { "((" + grant.runtime + ").set(" + keyCode + ", " + valCode + "), undefined)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers(ctx.collectParsedMarkers("", key), val) } else { "" });
    }
    open := syntax.expectSymbol(source, argOpen, "(", prefix);
    mapStart := syntax.skipTrivia(source, open, prefix);
    m := parseBinaryCtx(target, source, mapStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not types.isMapKind(m.kind) {
        syntax.failAt(source, mapStart, prefix, opDisplay + " expects a Map, got " + types.displayKind(m.kind));
    }
    kKind := types.mapKeyKind(m.kind);
    vKind := types.mapValueKind(m.kind);
    mTag := if target == ir.TARGET_C { types.cMapTag(m.kind) } else { "" };
    var markers := if inferMode { ctx.collectParsedMarkers("", m) } else { "" };
    if opName == "size" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        szCode := if mTag =!= "" { "((" + m.code + ").len)" } else { "BigInt((" + m.code + ").size)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "keys" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        kListCode := if mTag =!= "" { mTag + "_keys(" + m.code + ")" } else { "Array.from((" + m.code + ").keys())" };
        return ctx.withMarkers((kind = "List<" + kKind + ">", code = kListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "values" {
        close := ctx.expectNonemptyCallClose(source, m.next, prefix);
        vListCode := if mTag =!= "" { mTag + "_values(" + m.code + ")" } else { "Array.from((" + m.code + ").values())" };
        return ctx.withMarkers((kind = "List<" + vKind + ">", code = vListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma1 := syntax.skipTrivia(source, m.next, prefix);
    if comma1 >= source.length() or source.at(comma1) =!= "," {
        syntax.failAt(source, comma1, prefix, opDisplay + " expects a key after the map");
    }
    keyStart := syntax.skipTrivia(source, comma1 + 1, prefix);
    key := parseBinaryCtx(target, source, keyStart, prefix, locals, functions, params, currentName, kKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, key); }
    if not types.isCompatibleKind(kKind, key.kind) {
        syntax.failAt(source, keyStart, prefix, opDisplay + " key must be " + types.displayKind(kKind) + ", got " + types.displayKind(key.kind));
    }
    keyCode := ctx.assignValueCode(target, kKind, key.kind, key.code);
    if opName == "has" {
        close := ctx.expectNonemptyCallClose(source, key.next, prefix);
        hasCode := if mTag =!= "" { mTag + "_has(" + m.code + ", " + keyCode + ")" } else { "((" + m.code + ").has(" + keyCode + "))" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    tsV := types.tsFunctionType(vKind);
    needsCopy := ctx.copiedValueCode(target, vKind, "lite$v") =!= "lite$v";
    if opName == "get" {
        close := ctx.expectNonemptyCallClose(source, key.next, prefix);
        zeroVal := ctx.zeroParsed(target, vKind, close).code;
        resTupleKind := "(found:Bool,value:" + vKind + ")";
        code := if mTag =!= "" {
            "/*@T:" + resTupleKind + "@*/" + mTag + "_get(" + m.code + ", " + keyCode + ", " + zeroVal + ")"
        } else if not needsCopy {
            "lite$mapGet((" + m.code + "), " + keyCode + ", " + zeroVal + ")"
        } else {
            copied := ctx.copiedValueCode(target, vKind, "lite$v");
            "((lite$v: " + tsV + " | undefined): { found: boolean; value: " + tsV + " } => lite$v !== undefined ? { found: true, value: " + copied + " } : { found: false, value: " + zeroVal + " })((" + m.code + ").get(" + keyCode + "))"
        };
        return ctx.withMarkers((kind = resTupleKind, code = code,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma2 := syntax.skipTrivia(source, key.next, prefix);
    if comma2 >= source.length() or source.at(comma2) =!= "," {
        syntax.failAt(source, comma2, prefix, opDisplay + " expects a fallback value after the key");
    }
    fbStart := syntax.skipTrivia(source, comma2 + 1, prefix);
    fb := parseBinaryCtx(target, source, fbStart, prefix, locals, functions, params, currentName, vKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, fb); }
    if not types.isCompatibleKind(vKind, fb.kind) {
        syntax.failAt(source, fbStart, prefix, opDisplay + " fallback must be " + types.displayKind(vKind) + ", got " + types.displayKind(fb.kind));
    }
    close := ctx.expectNonemptyCallClose(source, fb.next, prefix);
    fbCode := ctx.assignValueCode(target, vKind, fb.kind, fb.code);
    code := if mTag =!= "" {
        mTag + "_get_or(" + m.code + ", " + keyCode + ", " + fbCode + ")"
    } else if not needsCopy {
        "lite$mapGetOr((" + m.code + "), " + keyCode + ", " + fbCode + ")"
    } else {
        copied := ctx.copiedValueCode(target, vKind, "lite$v");
        "((lite$v: " + tsV + " | undefined, lite$fb: " + tsV + "): " + tsV + " => lite$v !== undefined ? " + copied + " : lite$fb)((" + m.code + ").get(" + keyCode + "), " + fbCode + ")"
    };
    ctx.withMarkers((kind = vKind, code = code, intValue = 0, textValue = "", constant = false, next = close), markers)
};

/** Parses and lowers a `core/set` generic intrinsic call (`add`, `has`, `remove`, `size`, `clear`, `values`). */
parseSetIntrinsicCall := fn(target: String, source: String, argOpen: Int, opName: String, opDisplay: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if opName == "add" or opName == "remove" or opName == "clear" {
        grant := ctx.parseSetGrant(source, argOpen, prefix, locals, opDisplay);
        elemKind := types.setElementKind(grant.kind);
        sTag := if target == ir.TARGET_C { types.cSetTag(grant.kind) } else { "" };
        if opName == "clear" {
            close := ctx.expectNonemptyCallClose(source, grant.next, prefix);
            clrCode := if sTag =!= "" { sTag + "_clear(&" + grant.runtime + ")" } else { "((" + grant.runtime + ").clear(), undefined)" };
            return (kind = ir.VALUE_KIND_UNIT, code = clrCode,
            intValue = 0, textValue = "", constant = false, next = close);
        }
        comma := syntax.skipTrivia(source, grant.next, prefix);
        if comma >= source.length() or source.at(comma) =!= "," {
            syntax.failAt(source, comma, prefix, opDisplay + " expects a value after the mut set");
        }
        valStart := syntax.skipTrivia(source, comma + 1, prefix);
        val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elemKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if not types.isCompatibleKind(elemKind, val.kind) {
            syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elemKind) + ", got " + types.displayKind(val.kind));
        }
        close := ctx.expectNonemptyCallClose(source, val.next, prefix);
        valCode := ctx.assignValueCode(target, elemKind, val.kind, val.code);
        if opName == "add" {
            addCode := if sTag =!= "" { sTag + "_add(&" + grant.runtime + ", " + valCode + ")" } else { "((" + grant.runtime + ").add(" + valCode + "), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = addCode,
            intValue = 0, textValue = "", constant = false, next = close),
            if inferMode { ctx.collectParsedMarkers("", val) } else { "" });
        }
        rmCode := if sTag =!= "" { sTag + "_remove(&" + grant.runtime + ", " + valCode + ")" } else { "((" + grant.runtime + ").delete(" + valCode + "))" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode,
        intValue = 0, textValue = "", constant = false, next = close),
        if inferMode { ctx.collectParsedMarkers("", val) } else { "" });
    }
    open := syntax.expectSymbol(source, argOpen, "(", prefix);
    setStart := syntax.skipTrivia(source, open, prefix);
    s := parseBinaryCtx(target, source, setStart, prefix, locals, functions, params, currentName, "", 0, ctxs, iifeDepth, inferMode, "", aliases);
    if not types.isSetKind(s.kind) {
        syntax.failAt(source, setStart, prefix, opDisplay + " expects a Set, got " + types.displayKind(s.kind));
    }
    elemKind := types.setElementKind(s.kind);
    sTag := if target == ir.TARGET_C { types.cSetTag(s.kind) } else { "" };
    var markers := if inferMode { ctx.collectParsedMarkers("", s) } else { "" };
    if opName == "size" {
        close := ctx.expectNonemptyCallClose(source, s.next, prefix);
        szCode := if sTag =!= "" { "((" + s.code + ").len)" } else { "BigInt((" + s.code + ").size)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if opName == "values" {
        close := ctx.expectNonemptyCallClose(source, s.next, prefix);
        valListCode := if sTag =!= "" { sTag + "_values(" + s.code + ")" } else { "Array.from((" + s.code + ").values())" };
        return ctx.withMarkers((kind = "List<" + elemKind + ">", code = valListCode,
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    comma := syntax.skipTrivia(source, s.next, prefix);
    if comma >= source.length() or source.at(comma) =!= "," {
        syntax.failAt(source, comma, prefix, opDisplay + " expects a value after the set");
    }
    valStart := syntax.skipTrivia(source, comma + 1, prefix);
    val := parseBinaryCtx(target, source, valStart, prefix, locals, functions, params, currentName, elemKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
    if inferMode { markers = ctx.collectParsedMarkers(markers, val); }
    if not types.isCompatibleKind(elemKind, val.kind) {
        syntax.failAt(source, valStart, prefix, opDisplay + " element must be " + types.displayKind(elemKind) + ", got " + types.displayKind(val.kind));
    }
    close := ctx.expectNonemptyCallClose(source, val.next, prefix);
    valCode := ctx.assignValueCode(target, elemKind, val.kind, val.code);
    hasCode := if sTag =!= "" { sTag + "_has(" + s.code + ", " + valCode + ")" } else { "((" + s.code + ").has(" + valCode + "))" };
    ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode,
    intValue = 0, textValue = "", constant = false, next = close), markers)
};

/** True when `kind` has a `$getIndex` or `$setIndex` operator hook registered in `functions`. */
pub hasIndexHook := fn(kind: String, opName: String, functions: List<FunctionInfo>): Bool {
    ownerKey := types.typeOpOwnerKey(kind);
    if ownerKey == "" { return false; }
    sym.findFunction(functions, "$typeop:" + ownerKey + "." + opName) >= 0
};

/** Resolves a `$getIndex` or `$setIndex` operator hook on `receiverKind`, instantiating generics on demand when `not inferMode`. */
pub resolveIndexHookOp := fn(target: String, source: String, errPos: Int, prefix: String, receiverKind: String, opName: String, functions: List<FunctionInfo>, params: List<String>, inferMode: Bool): (found: Bool, runtime: String, keyKind: String, valKind: String, resultKind: String) {
    ownerKey := types.typeOpOwnerKey(receiverKind);
    if ownerKey == "" {
        return (found = false, runtime = "", keyKind = "", valKind = "", resultKind = "");
    }
    opIdx := sym.findFunction(functions, "$typeop:" + ownerKey + "." + opName);
    if opIdx < 0 {
        return (found = false, runtime = "", keyKind = "", valKind = "", resultKind = "");
    }
    info := functions[opIdx];
    rawRecv := types.paramKindOf(params[info.first]);
    recvBase := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
    rawKey := types.paramKindOf(params[info.first + 1]);
    rawVal := if opName == "$setIndex" { types.paramKindOf(params[info.first + 2]) } else { info.result };
    if info.runtime == "lite$core$list$getIndex:v1" or info.runtime == "lite$core$list$setAt:v1" {
        if not types.isListKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires List, got " + types.displayKind(receiverKind));
        }
        elK := types.listElementKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { elK });
    }
    if info.runtime == "lite$core$array$getIndex:v1" or info.runtime == "lite$core$array$setIndex:v1" {
        if not types.isArrayKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires Array, got " + types.displayKind(receiverKind));
        }
        elK := types.arrayElementKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = ir.VALUE_KIND_INT, valKind = elK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { elK });
    }
    if info.runtime == "lite$core$map$getIndex:v1" or info.runtime == "lite$core$map$set:v1" {
        if not types.isMapKind(receiverKind) {
            syntax.failAt(source, errPos, prefix, opName + " requires Map, got " + types.displayKind(receiverKind));
        }
        kK := types.mapKeyKind(receiverKind);
        vK := types.mapValueKind(receiverKind);
        return (found = true, runtime = info.runtime, keyKind = kK, valKind = vK, resultKind = if opName == "$setIndex" { ir.VALUE_KIND_UNIT } else { vK });
    }
    if info.runtime.startsWithAt(0, "$gen:") {
        tplKey := info.runtime.slice(5, info.runtime.length());
        tplIdx := generics.findTemplate(tplKey);
        if tplIdx < 0 {
            syntax.failAt(source, errPos, prefix, "internal error: missing generic template " + tplKey);
        }
        tpl := generics.getTemplate(tplIdx);
        bindings: mut Map<String, String>;
        uErr := generics.unifyKindMut(tpl.genericParams, recvBase, receiverKind, mut bindings);
        if uErr =!= "" {
            syntax.failAt(source, errPos, prefix, opName + " requires " + types.displayKind(recvBase) + ", got " + types.displayKind(receiverKind));
        }
        loop generics.splitGenericParams(tpl.genericParams) as gp {
            if not bindings.has(gp) {
                syntax.failAt(source, errPos, prefix, "cannot infer type parameter " + gp + " for " + opName + " on " + types.displayKind(receiverKind));
            }
        }
        cErr := findGenericConstraintError(tpl.genericParams, bindings, "");
        if cErr =!= "" {
            syntax.failAt(source, errPos, prefix, cErr);
        }
        concKey := generics.substKind(tpl.genericParams, rawKey, bindings);
        concVal := generics.substKind(tpl.genericParams, rawVal, bindings);
        concRes := generics.substKind(tpl.genericParams, info.result, bindings);
        var effRuntime := info.runtime;
        if not inferMode {
            allSubstParts: mut List<String> = [];
            loop generics.splitPipeEntries(tpl.params, tpl.paramCount) as tpEntry {
                tpName := types.paramNameOf(tpEntry);
                tpRaw := types.paramKindOf(tpEntry);
                tpIsMut := tpRaw.startsWithAt(0, "mut ");
                tpBase := if tpIsMut { tpRaw.slice(4, tpRaw.length()) } else { tpRaw };
                tpConc := generics.substKind(tpl.genericParams, tpBase, bindings);
                mut allSubstParts.pushBack(tpName + "=" + (if tpIsMut { "mut " } else { "" }) + tpConc);
            }
            effRuntime = generics.requestInstance(target, tplKey, generics.encodeBindings(tpl.genericParams, bindings), allSubstParts.join("|"), concRes);
        }
        return (found = true, runtime = effRuntime, keyKind = concKey, valKind = concVal, resultKind = concRes);
    }
    if not types.isCompatibleKind(recvBase, receiverKind) {
        syntax.failAt(source, errPos, prefix, opName + " requires " + types.displayKind(recvBase) + ", got " + types.displayKind(receiverKind));
    }
    (found = true, runtime = info.runtime, keyKind = rawKey, valKind = rawVal, resultKind = info.result)
};

/** Emits TS or C11 read expression for `$getIndex` (both user hooks and hard-builtin core hooks). */
emitHookIndexReadCode := fn(target: String, errPos: Int, recvKind: String, recvCode: String, getRuntime: String, keyCode: String): String {
    if getRuntime == "lite$core$list$getIndex:v1" or getRuntime == "lite$core$array$getIndex:v1" {
        elKind := if types.isListKind(recvKind) { types.listElementKind(recvKind) } else { types.arrayElementKind(recvKind) };
        if target == ir.TARGET_C {
            return "lt_list_" + types.cListTag(elKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$listAt(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
    }
    if getRuntime == "lite$core$map$getIndex:v1" {
        if target == ir.TARGET_C {
            return types.cMapTag(recvKind) + "_at(" + recvCode + ", " + keyCode + ", " + errPos.toText() + ")";
        }
        return "lite$mapAt((" + recvCode + "), " + keyCode + ", " + errPos.toText() + ")";
    }
    getRuntime + "(" + recvCode + ", " + keyCode + ")"
};

/** Emits TS or C11 statement code for `entry[key] = val` or single-evaluation compound `entry[key] op= val` via `$setIndex` (and `$getIndex`). */
pub emitHookIndexAssignCode := fn(target: String, source: String, opPos: Int, prefix: String, entry: Local, setRuntime: String, getRuntime: String, keyKind: String, valKind: String, keyCode: String, compBaseOp: String, valParsed: Parsed): String {
    isCompound := compBaseOp =!= "";
    if setRuntime == "lite$core$list$setAt:v1" or setRuntime == "lite$core$array$setIndex:v1" {
        elKind := if types.isListKind(entry.kind) { types.listElementKind(entry.kind) } else { types.arrayElementKind(entry.kind) };
        if target == ir.TARGET_C {
            cTag := types.cListTag(elKind);
            if isCompound {
                cValType := types.cValueType(elKind);
                curRead := "lt_list_" + cTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, "lt_cv", compBaseOp, valParsed);
                return "{ /*c-stmt*/ int64_t lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; lt_list_" + cTag + "_set(&" + entry.runtime + ", lt_ck, " + nextVal + ", " + opPos.toText() + "); }";
            }
            vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
            return "lt_list_" + cTag + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
        }
        if isCompound {
            curRead := "lite$listAt(" + entry.runtime + ", lite$ci, " + opPos.toText() + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, elKind, curRead, compBaseOp, valParsed);
            return "((lite$ci: bigint) => lite$listSet(" + entry.runtime + ", lite$ci, " + nextVal + ", " + opPos.toText() + "))(" + keyCode + ")";
        }
        vCode := ctx.assignValueCode(target, elKind, valParsed.kind, valParsed.code);
        return "lite$listSet(" + entry.runtime + ", " + keyCode + ", " + vCode + ", " + opPos.toText() + ")";
    }
    if setRuntime == "lite$core$map$set:v1" {
        if target == ir.TARGET_C {
            mTag := types.cMapTag(entry.kind);
            if isCompound {
                cKeyType := types.cValueType(keyKind);
                cValType := types.cValueType(valKind);
                curRead := mTag + "_at(" + entry.runtime + ", lt_ck, " + opPos.toText() + ")";
                nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lt_cv", compBaseOp, valParsed);
                return "{ /*c-stmt*/ " + cKeyType + " lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + mTag + "_set(&" + entry.runtime + ", lt_ck, " + nextVal + "); }";
            }
            vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
            return mTag + "_set(&" + entry.runtime + ", " + keyCode + ", " + vCode + ")";
        }
        if isCompound {
            curRead := "lite$mapAt(" + entry.runtime + ", lite$ck, " + opPos.toText() + ")";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, curRead, compBaseOp, valParsed);
            return "((lite$ck: " + types.tsFunctionType(keyKind) + ") => (" + entry.runtime + ").set(lite$ck, " + nextVal + "))(" + keyCode + ")";
        }
        vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
        return "(" + entry.runtime + ").set(" + keyCode + ", " + vCode + ")";
    }
    if target == ir.TARGET_C {
        if isCompound {
            cKeyType := types.cValueType(keyKind);
            cValType := types.cValueType(valKind);
            curRead := getRuntime + "(" + entry.runtime + ", lt_ck)";
            nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lt_cv", compBaseOp, valParsed);
            return "{ /*c-stmt*/ " + cKeyType + " lt_ck = " + keyCode + "; " + cValType + " lt_cv = " + curRead + "; " + setRuntime + "(&" + entry.runtime + ", lt_ck, " + nextVal + "); }";
        }
        vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
        return setRuntime + "(&" + entry.runtime + ", " + keyCode + ", " + vCode + ")";
    }
    isRec := types.isRecordKind(entry.kind);
    alreadyBoxed := isRec and entry.runtime.endsWith(".v");
    boxExpr := if alreadyBoxed { entry.runtime.slice(0, entry.runtime.length() - 2) } else { "" };
    if isCompound {
        tsKeyType := types.tsFunctionType(keyKind);
        curRead := getRuntime + "(" + entry.runtime + ", lite$ck)";
        nextVal := ctx.compoundAssignCode(target, source, opPos, prefix, valKind, "lite$cv", compBaseOp, valParsed);
        if isRec and not alreadyBoxed {
            return "(() => { const lite$ck: " + tsKeyType + " = " + keyCode + "; const lite$cv = " + curRead + "; const lite$ib = { v: " + entry.runtime + " }; " + setRuntime + "(lite$ib, lite$ck, " + nextVal + "); " + entry.runtime + " = lite$ib.v; })()";
        }
        recvArg := if alreadyBoxed { boxExpr } else { entry.runtime };
        return "(() => { const lite$ck: " + tsKeyType + " = " + keyCode + "; const lite$cv = " + curRead + "; " + setRuntime + "(" + recvArg + ", lite$ck, " + nextVal + "); })()";
    }
    vCode := ctx.assignValueCode(target, valKind, valParsed.kind, valParsed.code);
    if isRec and not alreadyBoxed {
        return "(() => { const lite$ib = { v: " + entry.runtime + " }; " + setRuntime + "(lite$ib, " + keyCode + ", " + vCode + "); " + entry.runtime + " = lite$ib.v; })()";
    }
    recvArg := if alreadyBoxed { boxExpr } else { entry.runtime };
    setRuntime + "(" + recvArg + ", " + keyCode + ", " + vCode + ")"
};

/** True when the bracket expression starting at `openBracket` contains a top-level `..` range slice separator before `]`. */
isBracketRangeSlice := fn(source: String, openBracket: Int, prefix: String): Bool {
    size := source.length();
    var cursor := syntax.skipTrivia(source, openBracket + 1, prefix);
    var depth := 0;
    loop cursor < size {
        ch := source.at(cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                sc := source.at(cursor);
                if sc == "\\" { cursor = cursor + 2; continue; }
                if sc == "\"" { cursor = cursor + 1; break; }
                cursor = cursor + 1;
            }
            continue;
        }
        if ch == "[" or ch == "(" or ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
            continue;
        }
        if ch == "]" {
            if depth == 0 { return false; }
            depth = depth - 1;
            cursor = cursor + 1;
            continue;
        }
        if ch == ")" or ch == "}" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
            continue;
        }
        if depth == 0 and source.startsWithAt(cursor, "..") {
            return true;
        }
        cursor = cursor + 1;
    }
    false
};

/** Finds the innermost local in `locals` whose runtime identifier matches `runtime`, or -1. */
findLocalIndexByRuntime := fn(locals: List<Local>, runtime: String): Int {
    if runtime == "" { return -1; }
    var i := locals.length() - 1;
    loop i >= 0 {
        if locals[i].runtime == runtime { return i; }
        i = i - 1;
    }
    -1
};

/** True when any local callable binding exists in scope (which could capture and mutate a local `mut` binding during a call). */
localsHasLocalClosure := fn(locals: List<Local>): Bool {
    loop locals as l {
        if l.depth >= 1 and l.name =!= "$self" and types.containsFnKind(l.kind) {
            return true;
        }
    }
    false
};

/** True when passing `argCode` to a read-only parameter requires a snapshot (C11 CoW RC bump or TS clone) to guard against aliasing or mutation during the call. */
readOnlyArgNeedsSnapshot := fn(argCode: String, locals: List<Local>, mutArgRuntimes: List<String>, hasClosureHazard: Bool): Bool {
    locIdx := findLocalIndexByRuntime(locals, argCode);
    if locIdx < 0 { return true; }
    loc := locals[locIdx];
    if not loc.writable { return false; }
    if loc.depth <= 0 { return true; }
    if loc.code == loc.runtime { return true; }
    if mutArgRuntimes.contains(loc.runtime) { return true; }
    selfIdx := sym.localIndex(locals, "$self");
    if selfIdx >= 0 and loc.depth < locals[selfIdx].depth { return true; }
    if hasClosureHazard { return true; }
    false
};

/** Builds a structural TS writeback assignment statement updating nested field `fieldPathCsv` inside `rootRt`. */
tsFieldWritebackStmt := fn(rootRt: String, fieldPathCsv: String, valueExpr: String): String {
    fields := fieldPathCsv.split(".");
    var prefixes: mut List<String> = [rootRt];
    var i := 0;
    loop i + 1 < fields.length() {
        mut prefixes.pushBack("(" + prefixes[i] + ")." + fields[i]);
        i += 1;
    }
    var acc := valueExpr;
    var j := fields.length() - 1;
    loop j >= 0 {
        acc = "{ ...(" + prefixes[j] + "), " + fields[j] + ": " + acc + " }";
        j -= 1;
    }
    rootRt + " = " + acc + ";"
};

/** Parses user, type-operation, and indirect function calls with positional, named, and `=name` shorthand arguments, plus optional prepended receiver, generic unification/monomorphization, and TS `mut Record` COW writeback. */
parseUserOrIndirectCallWithRecv := fn(target: String, source: String, openParen: Int, errPos: Int, isModuleFn: Bool, calleeDisplay: String, callRuntime: String, callParams: List<String>, callFirst: Int, callCount: Int, callResult: String, hasRecv: Bool, recvCode: String, recvWritebackLocal: String, recvWritebackBox: String, recvWritebackStmt: String, recvRootRuntime: String, initGenBindings: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    isGenericCall := isModuleFn and callRuntime.startsWithAt(0, "$gen:");
    genTplKey := if isGenericCall { callRuntime.slice(5, callRuntime.length()) } else { "" };
    var genParams := "";
    var genTplParamsRaw := "";
    var genTplParamCount := 0;
    genBindings: mut Map<String, String>;
    if isGenericCall {
        genTplIdx := generics.findTemplate(genTplKey);
        if genTplIdx < 0 {
            syntax.failAt(source, errPos, prefix, "internal error: missing generic template " + genTplKey);
        }
        genTpl := generics.getTemplate(genTplIdx);
        genParams = genTpl.genericParams;
        genTplParamsRaw = genTpl.params;
        genTplParamCount = genTpl.paramCount;
        loop generics.decodeBindings(initGenBindings) as initB {
            if initB.kind =!= "" {
                mut genBindings.set(initB.name, initB.kind);
            }
        }
    }
    explicitLabels := syntax.collectExplicitCallLabels(source, openParen, prefix);
    argIifeDepth := if target == ir.TARGET_TS and ctx.callReordersArgs(source, openParen, prefix, callParams, callFirst, callCount) {
        iifeDepth + 1
    } else {
        iifeDepth
    };
    var callMarkers := "";
    var slotEntry: List<Int> = [];
    var slotExplicit: List<Bool> = [];
    initSlots: mut List<Int> = [];
    initExplicit: mut List<Bool> = [];
    var initIdx := 0;
    loop initIdx < callCount {
        mut initSlots.pushBack(-1);
        mut initExplicit.pushBack(false);
        initIdx = initIdx + 1;
    }
    slotEntry = initSlots;
    slotExplicit = initExplicit;
    entryPositions: mut List<Int> = [];
    entrySlots: mut List<Int> = [];
    entryKinds: mut List<String> = [];
    entryCodes: mut List<String> = [];
    mutRecBoxNames: mut List<String> = [];
    mutRecLocalRuntimes: mut List<String> = [];
    mutRecWritebackStmts: mut List<String> = [];
    mutArgRuntimes: mut List<String> = [];
    if hasRecv and callFirst > 0 and types.paramKindOf(callParams[callFirst - 1]).startsWithAt(0, "mut ") {
        if recvRootRuntime =!= "" {
            mut mutArgRuntimes.pushBack(recvRootRuntime);
            if not recvRootRuntime.endsWith(".v") {
                mut mutArgRuntimes.pushBack(recvRootRuntime + ".v");
            }
        }
        if recvWritebackLocal =!= "" {
            mut mutArgRuntimes.pushBack(recvWritebackLocal);
        } else if recvCode.startsWithAt(0, "&") {
            mut mutArgRuntimes.pushBack(recvCode.slice(1, recvCode.length()));
        } else {
            mut mutArgRuntimes.pushBack(recvCode);
            mut mutArgRuntimes.pushBack(recvCode + ".v");
        }
    }
    if target == ir.TARGET_TS and hasRecv and recvWritebackLocal =!= "" and recvWritebackBox =!= "" {
        mut mutRecBoxNames.pushBack(recvWritebackBox);
        mut mutRecLocalRuntimes.pushBack(recvWritebackLocal);
        mut mutRecWritebackStmts.pushBack(recvWritebackStmt);
    }
    var entryCount := 0;
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    if cursor < size and source.at(cursor) =!= ")" {
        loop true {
            if syntax.isSingleEquals(source, cursor) {
                argNameStart := syntax.skipTrivia(source, cursor + 1, prefix);
                if argNameStart >= size or not source.at(argNameStart).isNameStart() {
                    syntax.failAt(source, argNameStart, prefix, "expected parameter name after =");
                }
                argNameEnd := source.skipName(argNameStart);
                label := source.slice(argNameStart, argNameEnd);
                if syntax.isReservedWord(label) { syntax.unsupportedFeature(source, argNameStart, label, prefix); }
                afterIdent := syntax.skipTrivia(source, argNameEnd, prefix);
                if afterIdent < size and source.at(afterIdent) =!= "," and source.at(afterIdent) =!= ")" {
                    syntax.failAt(source, afterIdent, prefix, "shorthand argument requires a bare identifier");
                }
                slot := ctx.findParamSlot(callParams, callFirst, callCount, label);
                if slot < 0 {
                    syntax.failAt(source, argNameStart, prefix, "unknown parameter " + label + " in call to " + calleeDisplay);
                }
                if slotExplicit[slot] {
                    syntax.failAt(source, argNameStart, prefix, "duplicate named argument " + label + " in call to " + calleeDisplay);
                }
                slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                rawArgExpected := types.paramKindOf(callParams[callFirst + slot]);
                argExpected := if isGenericCall {
                    generics.substKindForExpected(genParams, rawArgExpected, genBindings)
                } else {
                    rawArgExpected
                };
                arg := parseBinaryCtx(target, source, argNameStart, prefix, locals, functions, params, currentName, argExpected, 30, ctxs, argIifeDepth, inferMode, "", aliases);
                if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                if isGenericCall {
                    uErr := generics.unifyKindMut(genParams, rawArgExpected, arg.kind, mut genBindings);
                    if uErr =!= "" {
                        syntax.failAt(source, argNameStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                    }
                }
                (mut entryPositions).pushBack(argNameStart);
                mut entrySlots.pushBack(slot);
                mut entryKinds.pushBack(arg.kind);
                mut entryCodes.pushBack(arg.code);
                entryCount += 1;
                cursor = syntax.skipTrivia(source, arg.next, prefix);
            } else {
                var namedLabel := "";
                var rhsStart := -1;
                if cursor < size and source.at(cursor).isNameStart() {
                    labelEnd := source.skipName(cursor);
                    afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
                    if syntax.isSingleEquals(source, afterLabel) {
                        namedLabel = source.slice(cursor, labelEnd);
                        rhsStart = syntax.skipTrivia(source, afterLabel + 1, prefix);
                    }
                }
                if namedLabel =!= "" {
                    if syntax.isReservedWord(namedLabel) { syntax.unsupportedFeature(source, cursor, namedLabel, prefix); }
                    slot := ctx.findParamSlot(callParams, callFirst, callCount, namedLabel);
                    if slot < 0 {
                        syntax.failAt(source, cursor, prefix, "unknown parameter " + namedLabel + " in call to " + calleeDisplay);
                    }
                    if slotExplicit[slot] {
                        syntax.failAt(source, cursor, prefix, "duplicate named argument " + namedLabel + " in call to " + calleeDisplay);
                    }
                    slotExplicit = ctx.setBoolAt(slotExplicit, slot, true);
                    slotEntry = ctx.setIntAt(slotEntry, slot, entryCount);
                    rawArgExpected := types.paramKindOf(callParams[callFirst + slot]);
                    if rawArgExpected.startsWithAt(0, "mut ") {
                        lease := tryParseGroupedMutLease(source, rhsStart, prefix, false);
                        if not lease.matched {
                            if lease.sawMut {
                                if lease.nameEnd > lease.nameStart {
                                    syntax.failAt(source, lease.nameEnd, prefix, "expected ) after mut " + source.slice(lease.nameStart, lease.nameEnd));
                                }
                                syntax.failAt(source, lease.nameStart, prefix, "expected a binding name after mut");
                            }
                            syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + " requires mut argument");
                        }
                        mNameStart := lease.nameStart;
                        mNameEnd := lease.nameEnd;
                        mListName := source.slice(mNameStart, mNameEnd);
                        mIdx := sym.localIndex(locals, mListName);
                        if mIdx < 0 { syntax.failAt(source, mNameStart, prefix, "unknown value " + mListName); }
                        mEntry := locals[mIdx];
                        if not types.isMutContainerKind(mEntry.kind) {
                            syntax.failAt(source, mNameStart, prefix, calleeDisplay + " requires a List, Map, Set, or record value, got " + types.displayKind(mEntry.kind));
                        }
                        if not mEntry.writable {
                            syntax.failAt(source, mNameStart, prefix, "cannot mutate " + mListName + " without mut");
                        }
                        if isGenericCall {
                            rawBaseMut := rawArgExpected.slice(4, rawArgExpected.length());
                            uErr := generics.unifyKindMut(genParams, rawBaseMut, mEntry.kind, mut genBindings);
                            if uErr =!= "" {
                                syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                            }
                        }
                        var mCode := if target == ir.TARGET_C { "&" + mEntry.runtime } else { mEntry.runtime };
                        if target == ir.TARGET_TS and types.isRecordOrDistinctRecord(mEntry.kind) {
                            if mEntry.runtime.endsWith(".v") {
                                mCode = mEntry.runtime.slice(0, mEntry.runtime.length() - 2);
                            } else {
                                boxName := "lite$mb" + mutRecBoxNames.length().toText();
                                mut mutRecBoxNames.pushBack(boxName);
                                mut mutRecLocalRuntimes.pushBack(mEntry.runtime);
                                mut mutRecWritebackStmts.pushBack("");
                                mCode = boxName;
                            }
                        }
                        (mut mutArgRuntimes).pushBack(mEntry.runtime);
                        mut entryPositions.pushBack(rhsStart);
                        mut entrySlots.pushBack(slot);
                        mut entryKinds.pushBack("mut " + mEntry.kind);
                        mut entryCodes.pushBack(mCode);
                        entryCount += 1;
                        cursor = syntax.skipTrivia(source, lease.next, prefix);
                    } else {
                        argExpected := if isGenericCall {
                            generics.substKindForExpected(genParams, rawArgExpected, genBindings)
                        } else {
                            rawArgExpected
                        };
                        arg := parseBinaryCtx(target, source, rhsStart, prefix, locals, functions, params, currentName, argExpected, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                        if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                        if isGenericCall {
                            uErr := generics.unifyKindMut(genParams, rawArgExpected, arg.kind, mut genBindings);
                            if uErr =!= "" {
                                syntax.failAt(source, rhsStart, prefix, "argument " + (slot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                            }
                        }
                        (mut entryPositions).pushBack(rhsStart);
                        mut entrySlots.pushBack(slot);
                        mut entryKinds.pushBack(arg.kind);
                        mut entryCodes.pushBack(arg.code);
                        entryCount += 1;
                        cursor = syntax.skipTrivia(source, arg.next, prefix);
                    }
                } else {
                    var nextSlot := -1;
                    var scan := 0;
                    loop scan < callCount {
                        if slotEntry[scan] < 0 {
                            nextSlot = scan;
                            break;
                        }
                        scan += 1;
                    }
                    if nextSlot < 0 {
                        suffix := if callCount == 1 { " argument" } else { " arguments" };
                        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + callCount.toText() + suffix + ", got more");
                    }
                    slotName := types.paramNameOf(callParams[callFirst + nextSlot]);
                    isOverwrittenPos := explicitLabels.contains(slotName);
                    rawPosExpected := if isOverwrittenPos { "" } else { types.paramKindOf(callParams[callFirst + nextSlot]) };
                    slotEntry = ctx.setIntAt(slotEntry, nextSlot, entryCount);
                    if rawPosExpected.startsWithAt(0, "mut ") {
                        lease := tryParseGroupedMutLease(source, cursor, prefix, false);
                        if not lease.matched {
                            if lease.sawMut {
                                if lease.nameEnd > lease.nameStart {
                                    syntax.failAt(source, lease.nameEnd, prefix, "expected ) after mut " + source.slice(lease.nameStart, lease.nameEnd));
                                }
                                syntax.failAt(source, lease.nameStart, prefix, "expected a binding name after mut");
                            }
                            syntax.failAt(source, cursor, prefix, "argument " + (nextSlot + 1).toText() + " of " + calleeDisplay + " requires mut argument");
                        }
                        mNameStart := lease.nameStart;
                        mNameEnd := lease.nameEnd;
                        mListName := source.slice(mNameStart, mNameEnd);
                        mIdx := sym.localIndex(locals, mListName);
                        if mIdx < 0 { syntax.failAt(source, mNameStart, prefix, "unknown value " + mListName); }
                        mEntry := locals[mIdx];
                        if not types.isMutContainerKind(mEntry.kind) {
                            syntax.failAt(source, mNameStart, prefix, calleeDisplay + " requires a List, Map, Set, or record value, got " + types.displayKind(mEntry.kind));
                        }
                        if not mEntry.writable {
                            syntax.failAt(source, mNameStart, prefix, "cannot mutate " + mListName + " without mut");
                        }
                        if isGenericCall {
                            rawBaseMut := rawPosExpected.slice(4, rawPosExpected.length());
                            uErr := generics.unifyKindMut(genParams, rawBaseMut, mEntry.kind, mut genBindings);
                            if uErr =!= "" {
                                syntax.failAt(source, cursor, prefix, "argument " + (nextSlot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                            }
                        }
                        var mCode := if target == ir.TARGET_C { "&" + mEntry.runtime } else { mEntry.runtime };
                        if target == ir.TARGET_TS and types.isRecordOrDistinctRecord(mEntry.kind) {
                            if mEntry.runtime.endsWith(".v") {
                                mCode = mEntry.runtime.slice(0, mEntry.runtime.length() - 2);
                            } else {
                                boxName := "lite$mb" + mutRecBoxNames.length().toText();
                                mut mutRecBoxNames.pushBack(boxName);
                                mut mutRecLocalRuntimes.pushBack(mEntry.runtime);
                                mut mutRecWritebackStmts.pushBack("");
                                mCode = boxName;
                            }
                        }
                        (mut mutArgRuntimes).pushBack(mEntry.runtime);
                        mut entryPositions.pushBack(cursor);
                        mut entrySlots.pushBack(nextSlot);
                        mut entryKinds.pushBack("mut " + mEntry.kind);
                        mut entryCodes.pushBack(mCode);
                        entryCount += 1;
                        cursor = syntax.skipTrivia(source, lease.next, prefix);
                    } else {
                        posExpected := if isGenericCall and rawPosExpected =!= "" {
                            generics.substKindForExpected(genParams, rawPosExpected, genBindings)
                        } else {
                            rawPosExpected
                        };
                        arg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, posExpected, 0, ctxs, argIifeDepth, inferMode, "", aliases);
                        if inferMode { callMarkers = ctx.collectParsedMarkers(callMarkers, arg); }
                        if isGenericCall and not isOverwrittenPos {
                            uErr := generics.unifyKindMut(genParams, rawPosExpected, arg.kind, mut genBindings);
                            if uErr =!= "" {
                                syntax.failAt(source, cursor, prefix, "argument " + (nextSlot + 1).toText() + " of " + calleeDisplay + ": " + uErr);
                            }
                        }
                        (mut entryPositions).pushBack(cursor);
                        mut entrySlots.pushBack(nextSlot);
                        mut entryKinds.pushBack(arg.kind);
                        mut entryCodes.pushBack(arg.code);
                        entryCount += 1;
                        cursor = syntax.skipTrivia(source, arg.next, prefix);
                    }
                }
            }
            if cursor < size and source.at(cursor) == "," {
                cursor = syntax.skipTrivia(source, cursor + 1, prefix);
                if cursor < size and source.at(cursor) == ")" { break; }
            } else {
                break;
            }
        }
    }
    cursor = syntax.expectSymbol(source, cursor, ")", prefix);
    var filledCount := 0;
    var checkSlot := 0;
    loop checkSlot < callCount {
        if slotEntry[checkSlot] >= 0 { filledCount += 1; }
        checkSlot += 1;
    }
    if filledCount =!= callCount {
        suffix := if callCount == 1 { " argument" } else { " arguments" };
        syntax.failAt(source, errPos, prefix, "function " + calleeDisplay + " expects " + callCount.toText() +
        suffix + ", got " + filledCount.toText());
    }
    var effRuntime := callRuntime;
    var effResult := callResult;
    substSlotKinds: mut List<String> = [];
    if isGenericCall {
        if callExpectedRet =!= "" and generics.kindHasUnboundGeneric(genParams, callResult, genBindings) {
            _retUnify := generics.unifyKindMut(genParams, callResult, callExpectedRet, mut genBindings);
        }
        loop generics.splitGenericParams(genParams) as gp {
            if not genBindings.has(gp) {
                if types.valueParamKind(genParams, gp) =!= "" {
                    syntax.failAt(source, errPos, prefix, "cannot infer comptime value parameter " + gp + " in call to " + calleeDisplay);
                }
                syntax.failAt(source, errPos, prefix, "cannot infer type parameter " + gp + " in call to " + calleeDisplay);
            }
        }
        cErr := findGenericConstraintError(genParams, genBindings, " in call to " + calleeDisplay);
        if cErr =!= "" {
            if inferMode {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = openParen);
            }
            syntax.failAt(source, errPos, prefix, cErr);
        }
        effResult = generics.substKind(genParams, callResult, genBindings);
        retValErr := generics.validateSubstitutedKind(effResult);
        if retValErr =!= "" {
            syntax.failAt(source, errPos, prefix, retValErr);
        }
        allSubstParts: mut List<String> = [];
        rawTplEntries := generics.splitPipeEntries(genTplParamsRaw, genTplParamCount);
        var tpIdx := 0;
        loop rawTplEntries as tpEntry {
            tpName := types.paramNameOf(tpEntry);
            tpRaw := types.paramKindOf(tpEntry);
            tpIsMut := tpRaw.startsWithAt(0, "mut ");
            tpBase := if tpIsMut { tpRaw.slice(4, tpRaw.length()) } else { tpRaw };
            tpConcrete := generics.substKind(genParams, tpBase, genBindings);
            tpValErr := generics.validateSubstitutedKind(tpConcrete);
            if tpValErr =!= "" {
                syntax.failAt(source, errPos, prefix, tpValErr);
            }
            if tpIsMut and not types.isMutContainerKind(tpConcrete) {
                syntax.failAt(source, errPos, prefix, "mut parameter " + tpName + " of " + calleeDisplay + " requires List, Map, Set, or record type, got " + types.displayKind(tpConcrete));
            }
            tpFull := (if tpIsMut { "mut " } else { "" }) + tpConcrete;
            mut allSubstParts.pushBack(tpName + "=" + tpFull);
            if not hasRecv or tpIdx > 0 {
                mut substSlotKinds.pushBack(tpFull);
            }
            tpIdx = tpIdx + 1;
        }
        if not inferMode {
            bindingsEnc := generics.encodeBindings(genParams, genBindings);
            substParamsPipe := allSubstParts.join("|");
            effRuntime = generics.requestInstance(target, genTplKey, bindingsEnc, substParamsPipe, effResult);
        }
    }
    var isIdentityOrder := entryCount == callCount;
    var slotIdx := 0;
    loop slotIdx < callCount {
        k := slotEntry[slotIdx];
        if k =!= slotIdx { isIdentityOrder = false; }
        argExpected := if isGenericCall { substSlotKinds[slotIdx] } else { types.paramKindOf(callParams[callFirst + slotIdx]) };
        isMutExp := argExpected.startsWithAt(0, "mut ");
        isMutAct := entryKinds[k].startsWithAt(0, "mut ");
        chkExp := if isMutExp { argExpected.slice(4, argExpected.length()) } else { argExpected };
        chkAct := if isMutAct { entryKinds[k].slice(4, entryKinds[k].length()) } else { entryKinds[k] };
        if isMutExp =!= isMutAct or not types.isCompatibleKind(chkExp, chkAct) {
            syntax.failAt(source, entryPositions[k], prefix, "argument " + (slotIdx + 1).toText() + " of " +
            calleeDisplay + " must be " + types.displayKind(argExpected) + ", got " + types.displayKind(entryKinds[k]));
        }
        slotIdx += 1;
    }
    var callHasFnArg := not isModuleFn;
    var ckIdx := 0;
    loop ckIdx < entryCount {
        if types.containsFnKind(entryKinds[ckIdx]) {
            callHasFnArg = true;
            break;
        }
        ckIdx += 1;
    }
    callClosureHazard := callHasFnArg or localsHasLocalClosure(locals);
    var emittedCode := "";
    var emittedResultKind := effResult;
    if isIdentityOrder {
        finalArgs: mut List<String> = [];
        if hasRecv { mut finalArgs.pushBack(recvCode); }
        var pIdx := 0;
        loop pIdx < callCount {
            argExpected := if isGenericCall { substSlotKinds[pIdx] } else { types.paramKindOf(callParams[callFirst + pIdx]) };
            if argExpected.startsWithAt(0, "mut ") {
                mut finalArgs.pushBack(entryCodes[pIdx]);
            } else {
                needsSnap := readOnlyArgNeedsSnapshot(entryCodes[pIdx], locals, mutArgRuntimes, callClosureHazard);
                mut finalArgs.pushBack(ctx.readOnlyArgWithSnapshot(target, argExpected, entryKinds[pIdx], entryCodes[pIdx], needsSnap));
            }
            pIdx = pIdx + 1;
        }
        targetCallee := if isModuleFn { effRuntime } else { "(" + effRuntime + ")" };
        if target == ir.TARGET_C and not isModuleFn {
            callFnKind := types.fnCanonicalKind(callParams, callFirst, callCount, effResult);
            callFnTag := types.cFnTag(callFnKind);
            cCallArgs := if callCount > 0 { effRuntime + ", " + finalArgs.join(", ") } else { effRuntime };
            emittedCode = "/*@T:" + callFnKind + "@*/" + callFnTag + "_call(" + cCallArgs + ")";
        } else {
            emittedCode = targetCallee + "(" + finalArgs.join(", ") + ")";
        }
    } else if target =!= ir.TARGET_TS {
        discarded: mut List<String> = [];
        var kIdx := 0;
        loop kIdx < entryCount {
            targetSlot := entrySlots[kIdx];
            if slotEntry[targetSlot] =!= kIdx {
                mut discarded.pushBack("(void)(" + entryCodes[kIdx] + ")");
            }
            kIdx = kIdx + 1;
        }
        reorderedArgs: mut List<String> = [];
        if hasRecv { mut reorderedArgs.pushBack(recvCode); }
        var sIdx := 0;
        loop sIdx < callCount {
            k := slotEntry[sIdx];
            argExpected := if isGenericCall { substSlotKinds[sIdx] } else { types.paramKindOf(callParams[callFirst + sIdx]) };
            if argExpected.startsWithAt(0, "mut ") {
                mut reorderedArgs.pushBack(entryCodes[k]);
            } else {
                needsSnap := readOnlyArgNeedsSnapshot(entryCodes[k], locals, mutArgRuntimes, callClosureHazard);
                mut reorderedArgs.pushBack(ctx.readOnlyArgWithSnapshot(target, argExpected, entryKinds[k], entryCodes[k], needsSnap));
            }
            sIdx = sIdx + 1;
        }
        callExpr := if not isModuleFn {
            callFnKind := types.fnCanonicalKind(callParams, callFirst, callCount, effResult);
            callFnTag := types.cFnTag(callFnKind);
            cCallArgs := if callCount > 0 { effRuntime + ", " + reorderedArgs.join(", ") } else { effRuntime };
            "/*@T:" + callFnKind + "@*/" + callFnTag + "_call(" + cCallArgs + ")"
        } else {
            effRuntime + "(" + reorderedArgs.join(", ") + ")"
        };
        emittedCode = if discarded.length() > 0 {
            "(" + discarded.join(", ") + ", " + callExpr + ")"
        } else {
            callExpr
        };
    } else {
        evalStmts: mut List<String> = [];
        if not isModuleFn {
            mut evalStmts.pushBack("const lite$fn = " + effRuntime + ";");
        }
        if hasRecv {
            mut evalStmts.pushBack("const lite$recv = " + recvCode + ";");
        }
        var callDiverged := false;
        var kIdx := 0;
        loop kIdx < entryCount {
            if not callDiverged {
                targetSlot := entrySlots[kIdx];
                if entryKinds[kIdx] == ir.VALUE_KIND_NEVER {
                    mut evalStmts.pushBack("return " + entryCodes[kIdx] + ";");
                    callDiverged = true;
                } else if slotEntry[targetSlot] == kIdx {
                    temp := "lite$arg" + kIdx.toText();
                    argExpected := if isGenericCall { substSlotKinds[targetSlot] } else { types.paramKindOf(callParams[callFirst + targetSlot]) };
                    argRhs := if argExpected.startsWithAt(0, "mut ") {
                        entryCodes[kIdx]
                    } else {
                        needsSnap := readOnlyArgNeedsSnapshot(entryCodes[kIdx], locals, mutArgRuntimes, callClosureHazard);
                        ctx.readOnlyArgWithSnapshot(target, argExpected, entryKinds[kIdx], entryCodes[kIdx], needsSnap)
                    };
                    mut evalStmts.pushBack("const " + temp + " = " + argRhs + ";");
                } else {
                    mut evalStmts.pushBack("void (" + entryCodes[kIdx] + ");");
                }
            }
            kIdx = kIdx + 1;
        }
        if callDiverged {
            emittedCode = "(() => { " + evalStmts.join(" ") + " })()";
            emittedResultKind = ir.VALUE_KIND_NEVER;
        } else {
            slotTemps: mut List<String> = [];
            if hasRecv { mut slotTemps.pushBack("lite$recv"); }
            var sIdx := 0;
            loop sIdx < callCount {
                mut slotTemps.pushBack("lite$arg" + slotEntry[sIdx].toText());
                sIdx = sIdx + 1;
            }
            targetCallee := if isModuleFn { effRuntime } else { "lite$fn" };
            callExpr := targetCallee + "(" + slotTemps.join(", ") + ")";
            retStmt := if effResult == ir.VALUE_KIND_UNIT { "void (" + callExpr + "); return undefined;" } else { "return " + callExpr + ";" };
            emittedCode = "(() => { " + evalStmts.join(" ") + " " + retStmt + " })()";
        }
    }
    if target == ir.TARGET_TS and mutRecBoxNames.length() > 0 and emittedResultKind =!= ir.VALUE_KIND_NEVER {
        wbSetup: mut List<String> = [];
        wbAssign: mut List<String> = [];
        var bi := 0;
        bCount := mutRecBoxNames.length();
        loop bi < bCount {
            bName := mutRecBoxNames[bi];
            bLoc := mutRecLocalRuntimes[bi];
            wbStmt := mutRecWritebackStmts[bi];
            mut wbSetup.pushBack("const " + bName + " = { v: " + bLoc + " };");
            mut wbAssign.pushBack(if wbStmt =!= "" { wbStmt } else { bLoc + " = " + bName + ".v;" });
            bi = bi + 1;
        }
        if emittedResultKind == ir.VALUE_KIND_UNIT {
            emittedCode = "(() => { " + wbSetup.join(" ") + " void (" + emittedCode + "); " + wbAssign.join(" ") + " return undefined; })()";
        } else {
            emittedCode = "(((): " + types.tsFunctionType(emittedResultKind) + " => { " + wbSetup.join(" ") + " const lite$mr = " + emittedCode + "; " + wbAssign.join(" ") + " return lite$mr; })())";
        }
    }
    ctx.withMarkers((kind = emittedResultKind, code = emittedCode, intValue = 0, textValue = "", constant = false, next = cursor), callMarkers)
};

/** Parses user and indirect function calls with positional, named, and `=name` shorthand arguments. */
parseUserOrIndirectCall := fn(target: String, source: String, openParen: Int, errPos: Int, isModuleFn: Bool, calleeDisplay: String, callRuntime: String, callParams: List<String>, callFirst: Int, callCount: Int, callResult: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    parseUserOrIndirectCallWithRecv(target, source, openParen, errPos, isModuleFn, calleeDisplay, callRuntime, callParams, callFirst, callCount, callResult, false, "", "", "", "", "", "", callExpectedRet, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases)
};

/** Parses and lowers a hard-builtin type-attached dot call (`List.*`, `Array.*`, `Map.*`, `Set.*`, `String.length/at/slice`). */
parseCoreTypeOpHardCall := fn(target: String, source: String, labelStart: Int, openParen: Int, receiver: Parsed, recvLocalIdx: Int, runtime: String, opLabel: String, isMutRecv: Bool, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    if isMutRecv and (recvLocalIdx < 0 or not locals[recvLocalIdx].writable) {
        syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
    }
    mutRt := if isMutRecv { receiver.code } else { "" };
    var cursor := syntax.skipTrivia(source, openParen + 1, prefix);
    var markers := if inferMode { ctx.collectParsedMarkers("", receiver) } else { "" };
    if runtime == "lite$textLength" {
        close := syntax.expectSymbol(source, cursor, ")", prefix);
        if receiver.constant {
            n := receiver.textValue.length();
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = ir.targetIntLiteralCode(target, n, false, n.toText()),
            intValue = n, textValue = "", constant = true, next = close), markers);
        }
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = "lite$textLength(" + receiver.code + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime == "lite$textAt" {
        pArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, pArg); }
        if not numeric.isIntKind(pArg.kind) {
            syntax.failAt(source, cursor, prefix, "String.at position must be Int, got " + types.displayKind(pArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, pArg.next, prefix);
        pCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, pArg.kind, pArg.code);
        return ctx.withMarkers((kind = ir.VALUE_KIND_STRING, code = "lite$textAt(" + receiver.code + ", " + pCode + ", " + labelStart.toText() + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime == "lite$textSlice" {
        sArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, sArg); }
        if not numeric.isIntKind(sArg.kind) {
            syntax.failAt(source, cursor, prefix, "String.slice start must be Int, got " + types.displayKind(sArg.kind));
        }
        comma := syntax.expectSymbol(source, syntax.skipTrivia(source, sArg.next, prefix), ",", prefix);
        eStart := syntax.skipTrivia(source, comma, prefix);
        eArg := parseBinaryCtx(target, source, eStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, eArg); }
        if not numeric.isIntKind(eArg.kind) {
            syntax.failAt(source, eStart, prefix, "String.slice end must be Int, got " + types.displayKind(eArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, eArg.next, prefix);
        sCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, sArg.kind, sArg.code);
        eCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, eArg.kind, eArg.code);
        return ctx.withMarkers((kind = ir.VALUE_KIND_STRING, code = "lite$textSlice(" + receiver.code + ", " + sCode + ", " + eCode + ", " + labelStart.toText() + ")",
        intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime == "lite$core$array$length:v1" {
        close := syntax.expectSymbol(source, cursor, ")", prefix);
        ext := types.arrayExtent(receiver.kind);
        if ext >= 0 {
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = ir.targetIntLiteralCode(target, ext, false, ext.toText()),
            intValue = ext, textValue = "", constant = true, next = close), markers);
        }
        lenCode := if target == ir.TARGET_C { "((" + receiver.code + ").len)" } else { "BigInt((" + receiver.code + ").length)" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lenCode, intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime.startsWithAt(0, "lite$core$list$") {
        elKind := types.listElementKind(receiver.kind);
        cTag := if target == ir.TARGET_C { types.cListTag(elKind) } else { "" };
        if runtime == "lite$core$list$length:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            lenCode := if target == ir.TARGET_C { "((" + receiver.code + ").len)" } else { "BigInt((" + receiver.code + ").length)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = lenCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$reverse:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            revCode := if cTag =!= "" { "lt_list_" + cTag + "_reverse(" + receiver.code + ")" } else { "[...(" + receiver.code + ")].reverse()" };
            return ctx.withMarkers((kind = receiver.kind, code = revCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$clear:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            clrCode := if cTag =!= "" { "lt_list_" + cTag + "_clear(&" + mutRt + ")" } else { "((" + mutRt + ").length = 0, undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = clrCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$popBack:v1" or runtime == "lite$core$list$popFront:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            isBack := runtime == "lite$core$list$popBack:v1";
            popCode := if cTag =!= "" {
                "lt_list_" + cTag + "_" + (if isBack { "pop_back" } else { "pop_front" }) + "(&" + mutRt + ", " + labelStart.toText() + ")"
            } else {
                (if isBack { "lite$listPopBack(" } else { "lite$listPopFront(" }) + mutRt + ", " + labelStart.toText() + ")"
            };
            return ctx.withMarkers((kind = elKind, code = popCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$pushBack:v1" or runtime == "lite$core$list$pushFront:v1" {
            valArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, valArg); }
            if not types.isCompatibleKind(elKind, valArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " element must be " + types.displayKind(elKind) + ", got " + types.displayKind(valArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
            vCode := ctx.assignValueCode(target, elKind, valArg.kind, valArg.code);
            isBack := runtime == "lite$core$list$pushBack:v1";
            pushCode := if cTag =!= "" {
                "lt_list_" + cTag + "_" + (if isBack { "push_back" } else { "push_front" }) + "(&" + mutRt + ", " + vCode + ")"
            } else {
                mutRt + (if isBack { ".push(" } else { ".unshift(" }) + vCode + ")"
            };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = pushCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$setAt:v1" {
            idxArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, idxArg); }
            if not numeric.isIntKind(idxArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " index must be Int, got " + types.displayKind(idxArg.kind));
            }
            comma := syntax.expectSymbol(source, syntax.skipTrivia(source, idxArg.next, prefix), ",", prefix);
            vStart := syntax.skipTrivia(source, comma, prefix);
            valArg := parseBinaryCtx(target, source, vStart, prefix, locals, functions, params, currentName, elKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, valArg); }
            if not types.isCompatibleKind(elKind, valArg.kind) {
                syntax.failAt(source, vStart, prefix, opLabel + " element must be " + types.displayKind(elKind) + ", got " + types.displayKind(valArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
            iCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, idxArg.kind, idxArg.code);
            vCode := ctx.assignValueCode(target, elKind, valArg.kind, valArg.code);
            setCode := if cTag =!= "" {
                "lt_list_" + cTag + "_set(&" + mutRt + ", " + iCode + ", " + vCode + ", " + labelStart.toText() + ")"
            } else {
                "lite$listSet(" + mutRt + ", " + iCode + ", " + vCode + ", " + labelStart.toText() + ")"
            };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$list$slice:v1" {
            sArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, sArg); }
            if not numeric.isIntKind(sArg.kind) {
                syntax.failAt(source, cursor, prefix, opLabel + " start index must be Int, got " + types.displayKind(sArg.kind));
            }
            comma := syntax.expectSymbol(source, syntax.skipTrivia(source, sArg.next, prefix), ",", prefix);
            eStart := syntax.skipTrivia(source, comma, prefix);
            eArg := parseBinaryCtx(target, source, eStart, prefix, locals, functions, params, currentName, ir.VALUE_KIND_INT, 0, ctxs, iifeDepth, inferMode, "", aliases);
            if inferMode { markers = ctx.collectParsedMarkers(markers, eArg); }
            if not numeric.isIntKind(eArg.kind) {
                syntax.failAt(source, eStart, prefix, opLabel + " end index must be Int, got " + types.displayKind(eArg.kind));
            }
            close := ctx.expectNonemptyCallClose(source, eArg.next, prefix);
            sCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, sArg.kind, sArg.code);
            eCode := ctx.assignValueCode(target, ir.VALUE_KIND_INT, eArg.kind, eArg.code);
            slCode := if cTag =!= "" {
                "lt_list_" + cTag + "_slice(" + receiver.code + ", " + sCode + ", " + eCode + ", " + labelStart.toText() + ")"
            } else {
                "lite$listSlice(" + receiver.code + ", " + sCode + ", " + eCode + ", " + labelStart.toText() + ")"
            };
            return ctx.withMarkers((kind = receiver.kind, code = slCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
    }
    if runtime.startsWithAt(0, "lite$core$map$") {
        kKind := types.mapKeyKind(receiver.kind);
        vKind := types.mapValueKind(receiver.kind);
        mTag := if target == ir.TARGET_C { types.cMapTag(receiver.kind) } else { "" };
        if runtime == "lite$core$map$size:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            szCode := if mTag =!= "" { "((" + receiver.code + ").len)" } else { "BigInt((" + receiver.code + ").size)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$map$clear:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            clrCode := if mTag =!= "" { mTag + "_clear(&" + mutRt + ")" } else { "((" + mutRt + ").clear(), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = clrCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$map$keys:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            kListCode := if mTag =!= "" { mTag + "_keys(" + receiver.code + ")" } else { "Array.from((" + receiver.code + ").keys())" };
            return ctx.withMarkers((kind = "List<" + kKind + ">", code = kListCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$map$values:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            vListCode := if mTag =!= "" { mTag + "_values(" + receiver.code + ")" } else { "Array.from((" + receiver.code + ").values())" };
            return ctx.withMarkers((kind = "List<" + vKind + ">", code = vListCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        keyArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, kKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, keyArg); }
        if not types.isCompatibleKind(kKind, keyArg.kind) {
            syntax.failAt(source, cursor, prefix, opLabel + " key must be " + types.displayKind(kKind) + ", got " + types.displayKind(keyArg.kind));
        }
        keyCode := ctx.assignValueCode(target, kKind, keyArg.kind, keyArg.code);
        if runtime == "lite$core$map$has:v1" {
            close := ctx.expectNonemptyCallClose(source, keyArg.next, prefix);
            hasCode := if mTag =!= "" { mTag + "_has(" + receiver.code + ", " + keyCode + ")" } else { "((" + receiver.code + ").has(" + keyCode + "))" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$map$remove:v1" {
            close := ctx.expectNonemptyCallClose(source, keyArg.next, prefix);
            rmCode := if mTag =!= "" { mTag + "_remove(&" + mutRt + ", " + keyCode + ")" } else { "((" + mutRt + ").delete(" + keyCode + "))" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        tsV := types.tsFunctionType(vKind);
        needsCopy := ctx.copiedValueCode(target, vKind, "lite$v") =!= "lite$v";
        if runtime == "lite$core$map$get:v1" {
            close := ctx.expectNonemptyCallClose(source, keyArg.next, prefix);
            zeroVal := ctx.zeroParsed(target, vKind, close).code;
            resTupleKind := "(found:Bool,value:" + vKind + ")";
            getCode := if mTag =!= "" {
                "/*@T:" + resTupleKind + "@*/" + mTag + "_get(" + receiver.code + ", " + keyCode + ", " + zeroVal + ")"
            } else if not needsCopy {
                "lite$mapGet((" + receiver.code + "), " + keyCode + ", " + zeroVal + ")"
            } else {
                copied := ctx.copiedValueCode(target, vKind, "lite$v");
                "((lite$v: " + tsV + " | undefined): { found: boolean; value: " + tsV + " } => lite$v !== undefined ? { found: true, value: " + copied + " } : { found: false, value: " + zeroVal + " })((" + receiver.code + ").get(" + keyCode + "))"
            };
            return ctx.withMarkers((kind = resTupleKind, code = getCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        comma := syntax.expectSymbol(source, syntax.skipTrivia(source, keyArg.next, prefix), ",", prefix);
        vStart := syntax.skipTrivia(source, comma, prefix);
        valArg := parseBinaryCtx(target, source, vStart, prefix, locals, functions, params, currentName, vKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, valArg); }
        if not types.isCompatibleKind(vKind, valArg.kind) {
            syntax.failAt(source, vStart, prefix, opLabel + " value must be " + types.displayKind(vKind) + ", got " + types.displayKind(valArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
        valCode := ctx.assignValueCode(target, vKind, valArg.kind, valArg.code);
        if runtime == "lite$core$map$set:v1" {
            setCode := if mTag =!= "" { mTag + "_set(&" + mutRt + ", " + keyCode + ", " + valCode + ")" } else { "((" + mutRt + ").set(" + keyCode + ", " + valCode + "), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = setCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        getOrCode := if mTag =!= "" {
            mTag + "_get_or(" + receiver.code + ", " + keyCode + ", " + valCode + ")"
        } else if not needsCopy {
            "lite$mapGetOr((" + receiver.code + "), " + keyCode + ", " + valCode + ")"
        } else {
            copied := ctx.copiedValueCode(target, vKind, "lite$v");
            "((lite$v: " + tsV + " | undefined, lite$fb: " + tsV + "): " + tsV + " => lite$v !== undefined ? " + copied + " : lite$fb)((" + receiver.code + ").get(" + keyCode + "), " + valCode + ")"
        };
        return ctx.withMarkers((kind = vKind, code = getOrCode, intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    if runtime.startsWithAt(0, "lite$core$set$") {
        elemKind := types.setElementKind(receiver.kind);
        sTag := if target == ir.TARGET_C { types.cSetTag(receiver.kind) } else { "" };
        if runtime == "lite$core$set$size:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            szCode := if sTag =!= "" { "((" + receiver.code + ").len)" } else { "BigInt((" + receiver.code + ").size)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_INT, code = szCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$set$clear:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            clrCode := if sTag =!= "" { sTag + "_clear(&" + mutRt + ")" } else { "((" + mutRt + ").clear(), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = clrCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$set$values:v1" {
            close := syntax.expectSymbol(source, cursor, ")", prefix);
            valListCode := if sTag =!= "" { sTag + "_values(" + receiver.code + ")" } else { "Array.from((" + receiver.code + ").values())" };
            return ctx.withMarkers((kind = "List<" + elemKind + ">", code = valListCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        valArg := parseBinaryCtx(target, source, cursor, prefix, locals, functions, params, currentName, elemKind, 0, ctxs, iifeDepth, inferMode, "", aliases);
        if inferMode { markers = ctx.collectParsedMarkers(markers, valArg); }
        if not types.isCompatibleKind(elemKind, valArg.kind) {
            syntax.failAt(source, cursor, prefix, opLabel + " element must be " + types.displayKind(elemKind) + ", got " + types.displayKind(valArg.kind));
        }
        close := ctx.expectNonemptyCallClose(source, valArg.next, prefix);
        valCode := ctx.assignValueCode(target, elemKind, valArg.kind, valArg.code);
        if runtime == "lite$core$set$add:v1" {
            addCode := if sTag =!= "" { sTag + "_add(&" + mutRt + ", " + valCode + ")" } else { "((" + mutRt + ").add(" + valCode + "), undefined)" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_UNIT, code = addCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        if runtime == "lite$core$set$remove:v1" {
            rmCode := if sTag =!= "" { sTag + "_remove(&" + mutRt + ", " + valCode + ")" } else { "((" + mutRt + ").delete(" + valCode + "))" };
            return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = rmCode, intValue = 0, textValue = "", constant = false, next = close), markers);
        }
        hasCode := if sTag =!= "" { sTag + "_has(" + receiver.code + ", " + valCode + ")" } else { "((" + receiver.code + ").has(" + valCode + "))" };
        return ctx.withMarkers((kind = ir.VALUE_KIND_BOOL, code = hasCode, intValue = 0, textValue = "", constant = false, next = close), markers);
    }
    syntax.failAt(source, labelStart, prefix, "unsupported hard builtin type operation " + opLabel);
    ctx.intParsed("", 0, false, openParen)
};

/** Finds an instance or static type-attached operation registered for `ownerKey.opName`, or -1. */
findTypeOp := fn(functions: List<FunctionInfo>, ownerKey: String, opName: String): Int {
    inst := sym.findFunction(functions, "$typeop:" + ownerKey + "." + opName);
    if inst >= 0 { return inst; }
    sym.findFunction(functions, "$statictypeop:" + ownerKey + "." + opName)
};

/** True when a type-attached operation is static/type-level (declared without an explicit `Self` receiver first parameter). */
isStaticTypeOp := fn(opInfo: FunctionInfo): Bool {
    opInfo.name.startsWithAt(0, "$statictypeop:")
};

/** Validates a type-qualified `Type.op` or `Alias.op` reference and extracts pre-bound generic arguments. */
resolveTypeQualifiedOp := fn(
source: String, memberStart: Int, prefix: String,
opIdx: Int, memberName: String, typeOwnerKey: String,
resolvedType: String, aliasParamsCsv: String, aliasTplKind: String,
functions: List<FunctionInfo>, params: List<String>, inferMode: Bool
): (ok: Bool, initBindings: String) {
    opInfo := functions[opIdx];
    targetKind := if resolvedType =!= "" { resolvedType } else { aliasTplKind };
    targetParamsCsv := if resolvedType =!= "" { "" } else { aliasParamsCsv };
    if targetKind == "" { return (ok = true, initBindings = ""); }
    isStatic := isStaticTypeOp(opInfo);
    if opInfo.runtime.startsWithAt(0, "$gen:") {
        tpl := generics.getTemplate(generics.findTemplate(opInfo.runtime.slice(5, opInfo.runtime.length())));
        rawB: mut Map<String, String>;
        if not isStatic {
            rawRecv := types.paramKindOf(params[opInfo.first]);
            baseRecv := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
            if generics.unifyKindMut(tpl.genericParams, baseRecv, targetKind, mut rawB) =!= "" {
                if targetParamsCsv == "" {
                    if inferMode { return (ok = false, initBindings = ""); }
                    syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(baseRecv) + ", got " + types.displayKind(targetKind));
                }
            }
        } else if types.typeOpOwnerKey(opInfo.result) == typeOwnerKey {
            if generics.unifyKindMut(tpl.genericParams, opInfo.result, targetKind, mut rawB) =!= "" {
                if targetParamsCsv == "" {
                    if inferMode { return (ok = false, initBindings = ""); }
                    syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(opInfo.result) + ", got " + types.displayKind(targetKind));
                }
            }
        } else if tpl.selfTarget.startsWithAt(0, "@gentpl:") {
            pDec := types.decodeLengthPrefixedAt(tpl.selfTarget, 8);
            ownerParamsCsv := pDec.text;
            ownerTplKind := tpl.selfTarget.slice(pDec.next, tpl.selfTarget.length());
            ownerB: mut Map<String, String>;
            _oErr := generics.unifyKindMut(ownerParamsCsv, ownerTplKind, targetKind, mut ownerB);
            loop types.splitParamSpecs(tpl.genericParams) as sp {
                if ownerB.has(sp.name) {
                    mut rawB.set(sp.name, ownerB.getOr(sp.name, ""));
                }
            }
        }
        cleanB: mut Map<String, String>;
        loop types.splitParamSpecs(tpl.genericParams) as sp {
            if rawB.has(sp.name) {
                boundVal := rawB.getOr(sp.name, "");
                if targetParamsCsv == "" or not types.kindHasAnyGenericParam(targetParamsCsv, boundVal) {
                    mut cleanB.set(sp.name, boundVal);
                }
            }
        }
        cErr := findGenericConstraintError(tpl.genericParams, cleanB, "");
        if cErr =!= "" {
            if inferMode { return (ok = false, initBindings = ""); }
            syntax.failAt(source, memberStart, prefix, cErr);
        }
        return (ok = true, initBindings = generics.encodePartialBindings(tpl.genericParams, cleanB));
    }
    if resolvedType =!= "" and not inferMode {
        if not isStatic {
            rawRecv := types.paramKindOf(params[opInfo.first]);
            baseRecv := if rawRecv.startsWithAt(0, "mut ") { rawRecv.slice(4, rawRecv.length()) } else { rawRecv };
            if not types.isCompatibleKind(baseRecv, resolvedType) {
                syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(baseRecv) + ", got " + types.displayKind(resolvedType));
            }
        } else if types.typeOpOwnerKey(opInfo.result) == typeOwnerKey and not types.isCompatibleKind(opInfo.result, resolvedType) {
            syntax.failAt(source, memberStart, prefix, "operation " + memberName + " requires " + types.displayKind(opInfo.result) + ", got " + types.displayKind(resolvedType));
        }
    }
    (ok = true, initBindings = "")
};

/** True when a `lite$*` type-operation runtime is lowered inline by `parseCoreTypeOpHardCall` rather than called as a regular host function. */
isHardBuiltinTypeOpRuntime := fn(runtime: String): Bool {
    runtime == "lite$textLength" or runtime == "lite$textAt" or runtime == "lite$textSlice" or
    runtime.startsWithAt(0, "lite$core$array$") or
    runtime.startsWithAt(0, "lite$core$list$") or
    runtime.startsWithAt(0, "lite$core$map$") or
    runtime.startsWithAt(0, "lite$core$set$")
};

/** Parses a type-attached dot call `receiver.op(args...)`, validating explicit call-site `mut` lease, `mut Self` permission, unifying generic receivers, and forwarding receiver as argument 0. */
parseTypeOpDotCall := fn(target: String, source: String, labelStart: Int, openParen: Int, receiver: Parsed, recvLocalIdx: Int, opIdx: Int, opLabel: String, explicitMut: Bool, recvFieldPath: String, callExpectedRet: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    info := functions[opIdx];
    if isStaticTypeOp(info) {
        syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " is a type-level operation with no Self receiver; call it on the type instead");
    }
    recvExpected := types.paramKindOf(params[info.first]);
    isMutRecv := recvExpected.startsWithAt(0, "mut ");
    baseExpected := if isMutRecv { recvExpected.slice(4, recvExpected.length()) } else { recvExpected };
    if isMutRecv and not explicitMut {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
        }
        syntax.failAt(source, labelStart, prefix, "mutating operation " + types.displayKind(receiver.kind) + "." + opLabel + " requires mut at call site");
    }
    if not isMutRecv and explicitMut {
        syntax.failAt(source, labelStart, prefix, "operation " + types.displayKind(receiver.kind) + "." + opLabel + " does not mutate its receiver; remove mut");
    }
    if isHardBuiltinTypeOpRuntime(info.runtime) {
        return parseCoreTypeOpHardCall(target, source, labelStart, openParen, receiver, recvLocalIdx, info.runtime, opLabel, isMutRecv, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    isGenOp := info.runtime.startsWithAt(0, "$gen:");
    var initGenBindings := "";
    var concreteRecvExpected := baseExpected;
    if isGenOp {
        tplKey := info.runtime.slice(5, info.runtime.length());
        tplIdx := generics.findTemplate(tplKey);
        if tplIdx < 0 {
            syntax.failAt(source, labelStart, prefix, "internal error: missing generic template " + tplKey);
        }
        tpl := generics.getTemplate(tplIdx);
        recvBindings: mut Map<String, String>;
        uErr := generics.unifyKindMut(tpl.genericParams, baseExpected, receiver.kind, mut recvBindings);
        if uErr =!= "" {
            syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " requires " + types.displayKind(baseExpected) + ", got " + types.displayKind(receiver.kind));
        }
        cErr := findGenericConstraintError(tpl.genericParams, recvBindings, "");
        if cErr =!= "" {
            if inferMode {
                return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = labelStart);
            }
            syntax.failAt(source, labelStart, prefix, cErr);
        }
        initGenBindings = generics.encodePartialBindings(tpl.genericParams, recvBindings);
        concreteRecvExpected = generics.substKind(tpl.genericParams, baseExpected, recvBindings);
    } else {
        if not types.isCompatibleKind(baseExpected, receiver.kind) {
            syntax.failAt(source, labelStart, prefix, "operation " + opLabel + " requires " + types.displayKind(baseExpected) + ", got " + types.displayKind(receiver.kind));
        }
    }
    var recvCode := "";
    var recvWritebackLocal := "";
    var recvWritebackBox := "";
    var recvWritebackStmt := "";
    var recvRootRt := "";
    if isMutRecv {
        if recvLocalIdx < 0 or not locals[recvLocalIdx].writable {
            syntax.failAt(source, labelStart, prefix, "cannot call mutating operation " + opLabel + " on read-only value");
        }
        locEntry := locals[recvLocalIdx];
        recvRootRt = locEntry.runtime;
        if target == ir.TARGET_C {
            recvCode = if recvFieldPath == "" { "&" + locEntry.runtime } else { "&(" + receiver.code + ")" };
        } else if types.isRecordOrDistinctRecord(receiver.kind) {
            if recvFieldPath =!= "" {
                recvWritebackBox = "lite$mb_recv";
                recvWritebackLocal = receiver.code;
                recvWritebackStmt = tsFieldWritebackStmt(locEntry.runtime, recvFieldPath, recvWritebackBox + ".v");
                recvCode = recvWritebackBox;
            } else if locEntry.runtime.endsWith(".v") {
                recvCode = locEntry.runtime.slice(0, locEntry.runtime.length() - 2);
            } else {
                recvWritebackBox = "lite$mb_recv";
                recvWritebackLocal = locEntry.runtime;
                recvCode = recvWritebackBox;
            }
        } else {
            recvCode = receiver.code;
        }
    } else {
        var recvParamHazard := localsHasLocalClosure(locals);
        var rpIdx := 1;
        loop rpIdx < info.count {
            rpKind := types.paramKindOf(params[info.first + rpIdx]);
            if rpKind.startsWithAt(0, "mut ") or types.containsFnKind(rpKind) {
                recvParamHazard = true;
                break;
            }
            rpIdx += 1;
        }
        emptyMutRts: List<String> = [];
        recvNeedsSnap := readOnlyArgNeedsSnapshot(receiver.code, locals, emptyMutRts, recvParamHazard);
        recvCode = ctx.readOnlyArgWithSnapshot(target, concreteRecvExpected, receiver.kind, receiver.code, recvNeedsSnap);
    }
    calleeDisp := types.displayKind(receiver.kind) + "." + opLabel;
    callRes := parseUserOrIndirectCallWithRecv(target, source, openParen, labelStart, true, calleeDisp, info.runtime, params, info.first + 1, info.count - 1, info.result, true, recvCode, recvWritebackLocal, recvWritebackBox, recvWritebackStmt, recvRootRt, initGenBindings, callExpectedRet, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    if inferMode {
        return ctx.withMarkers(callRes, ctx.collectParsedMarkers(ctx.collectParsedMarkers("", receiver), callRes));
    }
    callRes
};

/** Parses an explicit mutating dot call `mut receiver(.field)*.op(args...)` or `(mut receiver).op(args...)`, enforcing root receiver mutability and `mut Self` signature. */
parseMutReceiverCallExpr := fn(target: String, source: String, mutStart: Int, mNameStart: Int, mNameEnd: Int, afterRecv: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    size := source.length();
    recvName := source.slice(mNameStart, mNameEnd);
    if syntax.isReservedWord(recvName) { syntax.unsupportedFeature(source, mNameStart, recvName, prefix); }
    recvIdx := sym.localIndex(locals, recvName);
    if recvIdx < 0 {
        syntax.failAt(source, mNameStart, prefix, "unknown value " + recvName);
    }
    entry := locals[recvIdx];
    if entry.initState =!= ir.INIT_STATE_INIT {
        syntax.failAt(source, mNameStart, prefix, "cannot read uninitialized local " + recvName);
    }
    _mutPos := mutStart;
    var curKind := entry.kind;
    var curCode := entry.runtime;
    fieldPath: mut List<String> = [];
    var pos := afterRecv;
    loop true {
        dotPos := syntax.skipTrivia(source, pos, prefix);
        if dotPos >= size or source.at(dotPos) =!= "." {
            if fieldPath.length() == 0 {
                syntax.failAt(source, dotPos, prefix, "expected .operation(...) after mut " + recvName);
            }
            syntax.failAt(source, dotPos, prefix, "expected .operation(...) after mut " + recvName + "." + fieldPath.join("."));
        }
        labelStart := syntax.skipTrivia(source, dotPos + 1, prefix);
        if labelStart < size and source.at(labelStart) == "$" {
            hookEnd := if labelStart + 1 < size and source.at(labelStart + 1).isNameStart() {
                source.skipName(labelStart + 1)
            } else {
                labelStart + 1
            };
            syntax.failAt(source, labelStart, prefix, "compiler hook " + source.slice(labelStart, hookEnd) + " cannot be called directly; use [...] indexing");
        }
        if labelStart >= size or not source.at(labelStart).isNameStart() {
            if fieldPath.length() == 0 {
                syntax.failAt(source, labelStart, prefix, "expected operation name after mut " + recvName + ".");
            }
            syntax.failAt(source, labelStart, prefix, "expected operation name after mut " + recvName + "." + fieldPath.join(".") + ".");
        }
        labelEnd := source.skipName(labelStart);
        label := source.slice(labelStart, labelEnd);
        afterLabel := syntax.skipTrivia(source, labelEnd, prefix);
        if afterLabel < size and source.at(afterLabel) == "." {
            if not types.isRecordKind(curKind) and not types.isTupleKind(curKind) {
                syntax.failAt(source, labelStart, prefix, "cannot access field " + label + " on " + types.displayKind(curKind));
            }
            nextKind := if types.isRecordKind(curKind) { types.recordFieldKind(curKind, label) } else { types.tupleFieldKind(curKind, label) };
            if nextKind == "" {
                syntax.failAt(source, labelStart, prefix, "type " + types.displayKind(curKind) + " has no field " + label);
            }
            if target == ir.TARGET_C and types.cStructTag(curKind) == "" {
                syntax.failAt(source, labelStart, prefix, "C backend does not support record field mutation on " + types.displayKind(curKind));
            }
            fProp := if target == ir.TARGET_C { types.cFieldName(label) } else { label };
            curCode = "(" + curCode + ")." + fProp;
            curKind = nextKind;
            mut fieldPath.pushBack(label);
            pos = afterLabel;
            continue;
        }
        ownerKey := types.typeOpOwnerKey(curKind);
        opIdx := if ownerKey =!= "" { findTypeOp(functions, ownerKey, label) } else { -1 };
        if opIdx < 0 {
            syntax.failAt(source, labelStart, prefix, "type " + types.displayKind(curKind) + " has no operation " + label);
        }
        if afterLabel >= size or source.at(afterLabel) =!= "(" {
            syntax.failAt(source, labelStart, prefix, "type operation " + types.displayKind(curKind) + "." + label + " must be called with (...)");
        }
        recvParsed := (kind = curKind, code = curCode, intValue = entry.intValue, textValue = entry.textValue, constant = false, next = pos);
        return parseTypeOpDotCall(target, source, labelStart, afterLabel, recvParsed, recvIdx, opIdx, label, true, fieldPath.join("."), expected, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
    }
    ctx.intParsed("", 0, false, afterRecv)
};

/** Parses postfix `.field`, `[index]`, list-intrinsic operations, type-attached dot calls, and function/indirect calls on `initialLeft`. */
parsePostfixChain := fn(target: String, source: String, exprStart: Int, initialLeft: Parsed, expected: String, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, ctxs: List<ConstructCtx>, iifeDepth: Int, inferMode: Bool, aliases: List<AliasDecl>): Parsed {
    var left := initialLeft;
    var recvLocalIdx := findLocalIndexByRuntime(locals, left.code);
    loop true {
        if left.next > 0 and source.at(left.next - 1) == "}" { break; }
        postPosition := syntax.skipTrivia(source, left.next, prefix);
        sourceLen := source.length();
        if postPosition < sourceLen and source.at(postPosition) == "." {
            curRecvLocalIdx := recvLocalIdx;
            recvLocalIdx = -1;
            labelStart := syntax.skipTrivia(source, postPosition + 1, prefix);
            if labelStart < sourceLen and source.at(labelStart).isDigit() {
                var end := labelStart;
                var fieldIndex := 0;
                loop end < sourceLen and source.at(end).isDigit() {
                    fieldIndex = fieldIndex * 10 + syntax.decimalDigit(source.at(end));
                    end = end + 1;
                }
                if types.isArrayKind(left.kind) {
                    if fieldIndex >= types.arrayExtent(left.kind) {
                        syntax.failAt(source, labelStart, prefix, "array index " + source.slice(labelStart, end) + " out of bounds");
                    }
                    arrElKind := types.arrayElementKind(left.kind);
                    arrElemCode := if target == ir.TARGET_C and types.cListTag(arrElKind) =!= "" {
                        "lt_list_" + types.cListTag(arrElKind) + "_at(" + left.code + ", " + fieldIndex.toText() + ", " + postPosition.toText() + ")"
                    } else {
                        "(" + left.code + ")[" + fieldIndex.toText() + "]!"
                    };
                    left = ctx.withMarkers((kind = arrElKind, code = arrElemCode,
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                } else if types.isEnumKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "enum values do not support positional field access ." + source.slice(labelStart, end));
                } else if types.isRecordKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "record values do not support positional field access ." + source.slice(labelStart, end));
                } else if not types.isTupleKind(left.kind) {
                    syntax.failAt(source, postPosition, prefix, "field access requires a tuple or module value");
                } else {
                    comp := types.tupleComponent(left.kind, fieldIndex);
                    if comp.kind == "" {
                        syntax.failAt(source, labelStart, prefix, "tuple has no field " + source.slice(labelStart, end));
                    }
                    tProp := if target == ir.TARGET_C { types.cFieldName(comp.prop) } else { comp.prop };
                    left = ctx.withMarkers((kind = comp.kind, code = "(" + left.code + ")." + tProp,
                    intValue = 0, textValue = "", constant = false, next = end),
                    if inferMode { ctx.collectParsedMarkers("", left) } else { "" });
                }
            } else if labelStart < source.length() and source.at(labelStart) == "$" {
                hookEnd := if labelStart + 1 < source.length() and source.at(labelStart + 1).isNameStart() {
                    source.skipName(labelStart + 1)
                } else {
                    labelStart + 1
                };
                syntax.failAt(source, labelStart, prefix, "compiler hook " + source.slice(labelStart, hookEnd) + " cannot be called directly; use [...] indexing");
            } else if labelStart >= source.length() or not source.at(labelStart).isNameStart() {
                break;
            } else {
                labelEnd := source.skipName(labelStart);
                label := source.slice(labelStart, labelEnd);
                if left.kind == ir.VALUE_KIND_MODULE {
                    qualified := left.textValue + "." + label;
                    functionIndex := sym.findFunction(functions, qualified);
                    if functionIndex >= 0 {
                        left = (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = exprStart.toText(), intValue = functionIndex, textValue = qualified,
                        constant = false, next = labelEnd);
                    } else {
                        afterMemberLabel := syntax.skipTrivia(source, labelEnd, prefix);
                        if afterMemberLabel < source.length() and (source.at(afterMemberLabel) == "." or source.at(afterMemberLabel) == "{" or source.at(afterMemberLabel) == "<") and types.findAlias(aliases, qualified) >= 0 {
                            var modTypeKind := "";
                            var modTypeOwnerKey := "";
                            var modAliasParamsCsv := "";
                            var modAliasTplKind := "";
                            var modDotOrBracePos := afterMemberLabel;
                            isModTypeApp := source.at(afterMemberLabel) == "<";
                            if isModTypeApp {
                                if inferMode {
                                    emptySeen: List<String> = [];
                                    canRes := types.canResolveTypeAt(source, exprStart, prefix, aliases, "", emptySeen, 32);
                                    if not canRes.ok {
                                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                    }
                                    modTypeKind = canRes.kind;
                                    modTypeOwnerKey = types.typeOpOwnerKey(modTypeKind);
                                    modDotOrBracePos = syntax.skipTrivia(source, canRes.next, prefix);
                                } else {
                                    parsedModType := types.parseTypeAt(source, exprStart, prefix, aliases, "type expression", "");
                                    modTypeKind = parsedModType.kind;
                                    modTypeOwnerKey = types.typeOpOwnerKey(modTypeKind);
                                    modDotOrBracePos = syntax.skipTrivia(source, parsedModType.next, prefix);
                                }
                            } else if source.at(afterMemberLabel) == "." {
                                genInfo := types.genericAliasTemplateInfo(source, labelStart, prefix, aliases, qualified);
                                if genInfo.ownerKey =!= "" {
                                    modTypeOwnerKey = genInfo.ownerKey;
                                    modAliasParamsCsv = genInfo.paramsCsv;
                                    modAliasTplKind = genInfo.tplKind;
                                } else if inferMode {
                                    emptySeen: List<String> = [];
                                    canRes := types.canResolveTypeAt(qualified, 0, prefix, aliases, "", emptySeen, 32);
                                    if not canRes.ok or (not types.isEnumKind(canRes.kind) and not types.isRecordKind(canRes.kind) and not types.isDistinctKind(canRes.kind) and types.typeOpOwnerKey(canRes.kind) == "") {
                                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                    }
                                    modTypeKind = canRes.kind;
                                    modTypeOwnerKey = types.typeOpOwnerKey(modTypeKind);
                                } else {
                                    emptySeen: List<String> = [];
                                    modTypeKind = types.resolveAliasKind(source, labelStart, prefix, aliases, qualified, emptySeen);
                                    modTypeOwnerKey = types.typeOpOwnerKey(modTypeKind);
                                    if not types.isEnumKind(modTypeKind) and not types.isRecordKind(modTypeKind) and not types.isDistinctKind(modTypeKind) and modTypeOwnerKey == "" {
                                        syntax.failAt(source, labelStart, prefix, "enum case access requires an enum type, got " + types.displayKind(modTypeKind));
                                    }
                                }
                            } else {
                                if inferMode {
                                    emptySeen: List<String> = [];
                                    canRes := types.canResolveTypeAt(qualified, 0, prefix, aliases, "", emptySeen, 32);
                                    if not canRes.ok or not types.isRecordKind(canRes.kind) {
                                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                    }
                                    modTypeKind = canRes.kind;
                                } else {
                                    emptySeen: List<String> = [];
                                    modTypeKind = types.resolveAliasKind(source, labelStart, prefix, aliases, qualified, emptySeen);
                                    if not types.isRecordKind(modTypeKind) {
                                        syntax.failAt(source, labelStart, prefix, "record construction requires a record type, got " + types.displayKind(modTypeKind));
                                    }
                                }
                            }
                            if modDotOrBracePos < source.length() and source.at(modDotOrBracePos) == "{" {
                                if not types.isRecordKind(modTypeKind) {
                                    if inferMode {
                                        return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                    }
                                    syntax.failAt(source, labelStart, prefix, "record construction requires a record type, got " + types.displayKind(modTypeKind));
                                }
                                left = parseRecordLiteral(target, source, modDotOrBracePos, prefix, locals, functions, params, currentName, modTypeKind, ctxs, iifeDepth, inferMode, aliases);
                            } else if modDotOrBracePos < source.length() and source.at(modDotOrBracePos) == "." {
                                caseStart := syntax.skipTrivia(source, modDotOrBracePos + 1, prefix);
                                if caseStart < source.length() and source.at(caseStart) == "$" {
                                    hookEnd := if caseStart + 1 < source.length() and source.at(caseStart + 1).isNameStart() {
                                        source.skipName(caseStart + 1)
                                    } else {
                                        caseStart + 1
                                    };
                                    syntax.failAt(source, caseStart, prefix, "compiler hook " + source.slice(caseStart, hookEnd) + " cannot be referenced directly; use [...] indexing");
                                }
                                if caseStart >= source.length() or not source.at(caseStart).isNameStart() {
                                    syntax.failAt(source, caseStart, prefix, "expected member name after " + qualified + ".");
                                }
                                caseEnd := source.skipName(caseStart);
                                caseName := source.slice(caseStart, caseEnd);
                                var handledModMember := false;
                                if types.isEnumKind(modTypeKind) {
                                    caseIdx := types.enumCaseIndex(modTypeKind, caseName);
                                    if caseIdx >= 0 {
                                        left = parseEnumCaseConstruct(target, source, modTypeKind, caseName, caseIdx, caseEnd, caseStart, prefix, locals, functions, params, currentName, ctxs, iifeDepth, inferMode, aliases);
                                        handledModMember = true;
                                    }
                                }
                                if not handledModMember {
                                    modOpIdx := if modTypeOwnerKey =!= "" { findTypeOp(functions, modTypeOwnerKey, caseName) } else { -1 };
                                    if modOpIdx >= 0 {
                                        modOpRes := resolveTypeQualifiedOp(
                                        source, caseStart, prefix, modOpIdx, caseName, modTypeOwnerKey,
                                        modTypeKind, modAliasParamsCsv, modAliasTplKind, functions, params, inferMode
                                        );
                                        if not modOpRes.ok {
                                            return (kind = "", code = "", intValue = 0, textValue = "", constant = false, next = exprStart);
                                        }
                                        modOpCode := exprStart.toText() + (if modOpRes.initBindings =!= "" { "|" + modOpRes.initBindings } else { "" });
                                        left = (kind = ir.VALUE_KIND_MODULE_FUNCTION, code = modOpCode, intValue = modOpIdx,
                                        textValue = (if modTypeKind =!= "" { types.displayKind(modTypeKind) } else { qualified }) + "." + caseName, constant = false, next = caseEnd);
                                        handledModMember = true;
                                    }
                                }
                                if not handledModMember {
                                    if types.isEnumKind(modTypeKind) {
                                        syntax.failAt(source, caseStart, prefix, "enum " + types.enumDisplayName(modTypeKind) + " has no case " + caseName);
                                    }
