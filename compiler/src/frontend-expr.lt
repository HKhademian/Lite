                                } else {
                                    mut statements.pushBack(loopCtx.valVar + " = " + payCode + "; " + jumpStmt);
                                }
                            } else {
                                payTransferId := if itemName == "break" { loopCtx.id } else { 0 - loopCtx.id };
                                mut statements.pushBack(stmtReturnPrefix + "lite$throwTransfer(" + payTransferId.toText() + ", " + payCode + ");");
                            }
