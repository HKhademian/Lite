/** Scoped O(1) symbol-table index with undo-stack lexical shadowing and trace-safety invariants. */

ir := import "./frontend-ir";

/** Local alias for `ir.Local`. */
Local := alias ir.Local;
/** Local alias for `ir.FunctionInfo`. */
FunctionInfo := alias ir.FunctionInfo;
/** Local alias for `ir.AliasDecl`. */
AliasDecl := alias ir.AliasDecl;

/** One undo entry recording the prior indexed state before `locals[i]` was pushed. */
LocalUndo := alias (
    name: String,
    runtime: String,
    depth: Int,
    initState: String,
    prevNameIdx: Int,
    prevRtIdx: Int,
    wasUnready: Bool,
    wasCallable: Bool,
    wasFuture: Bool
);

/** One undo entry recording the prior indexed state before `aliases[i]` was pushed. */
AliasUndo := alias (
    name: String,
    depth: Int,
    prevIdx: Int,
    prevDepth: Int,
    changed: Bool
);

/* --- Active module-scoped O(1) indexes --- */

localByName: mut Map<String, Int>;
runtimeByName: mut Map<String, Int>;
unreadyRuntimes: mut Set<String>;
localUndo: mut List<LocalUndo> = [];
var indexedLocalLen := 0;
var callableLocalCount := 0;
var futureLocalCount := 0;

aliasByName: mut Map<String, Int>;
aliasDepthByName: mut Map<String, Int>;
aliasUndo: mut List<AliasUndo> = [];
var indexedAliasLen := 0;

fnByName: mut Map<String, Int>;
fnTailByName: mut Map<String, Int>;
fnOverloadNext: mut List<Int> = [];
fnByRuntime: mut Map<String, Int>;
fnIndexedNames: mut List<String> = [];
var indexedFnLen := 0;

/** True when `a` matches the local state recorded in undo entry `u`. */
sameLocalSlot := fn(a: Local, u: LocalUndo): Bool {
    a.depth == u.depth and a.runtime == u.runtime and a.name == u.name and a.initState == u.initState
};

/** Pushes `locals[idx]` into the O(1) local index and records its undo entry. */
pushLocalSlot := fn(idx: Int, entry: Local): Unit {
    isActive := entry.depth >= -1;
    prevNameIdx := if isActive { localByName.getOr(entry.name, -1) } else { -1 };
    prevRtIdx := if isActive { runtimeByName.getOr(entry.runtime, -1) } else { -1 };
    wasUnready := unreadyRuntimes.has(entry.runtime);
    wasCallable := isActive and (entry.kind.indexOf("fn(", 0) >= 0 or entry.name == "$tuple");
    wasFuture := entry.depth <= -2;
    if isActive {
        mut localByName.set(entry.name, idx);
        mut runtimeByName.set(entry.runtime, idx);
        if entry.depth >= 0 and entry.initState =!= ir.INIT_STATE_INIT {
            mut unreadyRuntimes.add(entry.runtime);
        } else if wasUnready {
            _rm := mut unreadyRuntimes.remove(entry.runtime);
        }
        if wasCallable { callableLocalCount = callableLocalCount + 1; }
    } else {
        futureLocalCount = futureLocalCount + 1;
        if not runtimeByName.has(entry.runtime) {
            mut unreadyRuntimes.add(entry.runtime);
        }
    }
    (mut localUndo).pushBack((
        name = entry.name,
        runtime = entry.runtime,
        depth = entry.depth,
        initState = entry.initState,
        prevNameIdx = prevNameIdx,
        prevRtIdx = prevRtIdx,
        wasUnready = wasUnready,
        wasCallable = wasCallable,
        wasFuture = wasFuture
    ));
    indexedLocalLen = indexedLocalLen + 1;
};

/** Reverts the most recently pushed local index entry using the undo stack. */
popLocalSlot := fn(): Unit {
    if indexedLocalLen <= 0 { return; }
    u := mut localUndo.popBack();
    indexedLocalLen = indexedLocalLen - 1;
    if u.depth >= -1 {
        if u.prevNameIdx >= 0 {
            mut localByName.set(u.name, u.prevNameIdx);
        } else {
            _rmN := mut localByName.remove(u.name);
        }
        if u.prevRtIdx >= 0 {
            mut runtimeByName.set(u.runtime, u.prevRtIdx);
        } else {
            _rmR := mut runtimeByName.remove(u.runtime);
        }
        if u.wasCallable { callableLocalCount = callableLocalCount - 1; }
    } else {
        futureLocalCount = futureLocalCount - 1;
    }
    if u.wasUnready {
        mut unreadyRuntimes.add(u.runtime);
    } else {
        _rmU := mut unreadyRuntimes.remove(u.runtime);
    }
};

/** Clears all local indexes (e.g., on module start or full-list rebuild). */
pub invalidateLocals := fn(): Unit {
    if indexedLocalLen == 0 { return; }
    (mut localByName).clear();
    mut runtimeByName.clear();
    mut unreadyRuntimes.clear();
    mut localUndo.clear();
    indexedLocalLen = 0;
    callableLocalCount = 0;
    futureLocalCount = 0;
};

/** Unwinds local undo entries down to `targetLen` in O(indexedLocalLen - targetLen). */
pub rewindLocalsTo := fn(targetLen: Int): Unit {
    if targetLen <= 0 {
        invalidateLocals();
        return;
    }
    loop indexedLocalLen > targetLen {
        popLocalSlot();
    }
};

/** Returns the currently indexed local count as a scope rewind mark. */
pub localMark := fn(): Int { indexedLocalLen };

/** Synchronizes the O(1) local index incrementally with `locals`. */
pub syncLocals := fn(locals: List<Local>): Unit {
    n := locals.length();
    if n == 0 {
        invalidateLocals();
        return;
    }
    if n == indexedLocalLen and sameLocalSlot(locals[n - 1], localUndo[n - 1]) {
        return;
    }
    if n > indexedLocalLen and (indexedLocalLen == 0 or sameLocalSlot(locals[indexedLocalLen - 1], localUndo[indexedLocalLen - 1])) {
        var i := indexedLocalLen;
        loop i < n {
            pushLocalSlot(i, locals[i]);
            i = i + 1;
        }
        return;
    }
    if n < indexedLocalLen and sameLocalSlot(locals[n - 1], localUndo[n - 1]) {
        rewindLocalsTo(n);
        return;
    }
    /* Interior divergence (e.g., filtered future values or boxed placeholders): find common prefix. */
    limit := if n < indexedLocalLen { n } else { indexedLocalLen };
    var common := 0;
    loop common < limit and sameLocalSlot(locals[common], localUndo[common]) {
        common = common + 1;
    }
    if common == 0 {
        invalidateLocals();
    } else {
        rewindLocalsTo(common);
    }
    var j := indexedLocalLen;
    loop j < n {
        pushLocalSlot(j, locals[j]);
        j = j + 1;
    }
};

/** O(1) lookup of the newest visible (`depth >= -1`) local named `name`, or -1. */
pub localIndex := fn(locals: List<Local>, name: String): Int {
    syncLocals(locals);
    localByName.getOr(name, -1)
};

/** O(1) lookup of the newest active (`depth >= -1`) local matching `runtime`, or -1. */
pub latestActiveLocalByRuntime := fn(locals: List<Local>, runtime: String): Int {
    syncLocals(locals);
    runtimeByName.getOr(runtime, -1)
};

/** O(1) check whether any unreached future placeholder or uninitialized reached local exists in `locals`. */
pub localsHasAnyUnready := fn(locals: List<Local>): Bool {
    syncLocals(locals);
    unreadyRuntimes.size() > 0
};

/** O(1) check whether any active local in `locals` has a callable `fn(...)` type or `$tuple` carrier. */
pub hasCallableLocal := fn(locals: List<Local>): Bool {
    syncLocals(locals);
    callableLocalCount > 0
};

/** O(1) check whether any unreached future placeholder (`depth <= -2`) exists in `locals`. */
pub hasFutureLocal := fn(locals: List<Local>): Bool {
    syncLocals(locals);
    futureLocalCount > 0
};

/* --- Alias O(1) index with block-depth shadowing undo log --- */

/** Pushes `aliases[idx]` into the O(1) alias index and records its undo entry. */
pushAliasSlot := fn(idx: Int, entry: AliasDecl): Unit {
    prevIdx := aliasByName.getOr(entry.name, -1);
    prevDepth := if prevIdx >= 0 { aliasDepthByName.getOr(entry.name, -1) } else { -1 };
    changed := entry.depth > prevDepth;
    if changed {
        mut aliasByName.set(entry.name, idx);
        mut aliasDepthByName.set(entry.name, entry.depth);
    }
    (mut aliasUndo).pushBack((
        name = entry.name,
        depth = entry.depth,
        prevIdx = prevIdx,
        prevDepth = prevDepth,
        changed = changed
    ));
    indexedAliasLen = indexedAliasLen + 1;
};

/** Reverts the most recently pushed alias index entry using the undo stack. */
popAliasSlot := fn(): Unit {
    if indexedAliasLen <= 0 { return; }
    u := mut aliasUndo.popBack();
    indexedAliasLen = indexedAliasLen - 1;
    if u.changed {
        if u.prevIdx >= 0 {
            mut aliasByName.set(u.name, u.prevIdx);
            mut aliasDepthByName.set(u.name, u.prevDepth);
        } else {
            _rmA := mut aliasByName.remove(u.name);
            _rmD := mut aliasDepthByName.remove(u.name);
        }
    }
};

/** Clears all alias indexes. */
pub invalidateAliases := fn(): Unit {
    if indexedAliasLen == 0 { return; }
    (mut aliasByName).clear();
    mut aliasDepthByName.clear();
    mut aliasUndo.clear();
    indexedAliasLen = 0;
};

/** Unwinds alias undo entries down to `targetLen`. */
pub rewindAliasesTo := fn(targetLen: Int): Unit {
    if targetLen <= 0 {
        invalidateAliases();
        return;
    }
    loop indexedAliasLen > targetLen {
        popAliasSlot();
    }
};

/** Returns the currently indexed alias count as a scope rewind mark. */
pub aliasMark := fn(): Int { indexedAliasLen };

/** True when `a` matches the alias state recorded in undo entry `u`. */
sameAliasSlot := fn(a: AliasDecl, u: AliasUndo): Bool {
    a.depth == u.depth and a.name == u.name
};

/** Synchronizes the O(1) alias index incrementally with `aliases`. */
pub syncAliases := fn(aliases: List<AliasDecl>): Unit {
    n := aliases.length();
    if n == 0 {
        invalidateAliases();
        return;
    }
    if n == indexedAliasLen and sameAliasSlot(aliases[n - 1], aliasUndo[n - 1]) {
        return;
    }
    if n > indexedAliasLen and (indexedAliasLen == 0 or sameAliasSlot(aliases[indexedAliasLen - 1], aliasUndo[indexedAliasLen - 1])) {
        var i := indexedAliasLen;
        loop i < n {
            pushAliasSlot(i, aliases[i]);
            i = i + 1;
        }
        return;
    }
    if n < indexedAliasLen and sameAliasSlot(aliases[n - 1], aliasUndo[n - 1]) {
        rewindAliasesTo(n);
        return;
    }
    limit := if n < indexedAliasLen { n } else { indexedAliasLen };
    var common := 0;
    loop common < limit and sameAliasSlot(aliases[common], aliasUndo[common]) {
        common = common + 1;
    }
    if common == 0 {
        invalidateAliases();
    } else {
        rewindAliasesTo(common);
    }
    var j := indexedAliasLen;
    loop j < n {
        pushAliasSlot(j, aliases[j]);
        j = j + 1;
    }
};

/** O(1) lookup of the first visible alias named `name` at the innermost active block depth, or -1. */
pub findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    syncAliases(aliases);
    aliasByName.getOr(name, -1)
};

/* --- Monotonic top-level function O(1) index --- */

/** Clears all top-level function indexes. */
pub invalidateFunctions := fn(): Unit {
    if indexedFnLen == 0 { return; }
    (mut fnByName).clear();
    (mut fnTailByName).clear();
    mut fnOverloadNext.clear();
    mut fnByRuntime.clear();
    mut fnIndexedNames.clear();
    indexedFnLen = 0;
};

/** Appends one function index `idx` (`name`, `runtime`) to the linked-list overload table. */
pushFunctionSlot := fn(idx: Int, name: String, runtime: String): Unit {
    mut fnOverloadNext.pushBack(-1);
    prevTail := fnTailByName.getOr(name, -1);
    if prevTail >= 0 {
        fnOverloadNext[prevTail] = idx;
    } else {
        mut fnByName.set(name, idx);
    }
    mut fnTailByName.set(name, idx);
    if runtime =!= "" and not fnByRuntime.has(runtime) {
        mut fnByRuntime.set(runtime, idx);
    }
    (mut fnIndexedNames).pushBack(name);
};

/** Synchronizes the O(1) function index incrementally with `functions`. */
pub syncFunctions := fn(functions: List<FunctionInfo>): Unit {
    n := functions.length();
    if n == 0 {
        invalidateFunctions();
        return;
    }
    if n == indexedFnLen and functions[n - 1].name == fnIndexedNames[n - 1] {
        return;
    }
    if n > indexedFnLen and (indexedFnLen == 0 or functions[indexedFnLen - 1].name == fnIndexedNames[indexedFnLen - 1]) {
        var i := indexedFnLen;
        loop i < n {
            entry := functions[i];
            pushFunctionSlot(i, entry.name, entry.runtime);
            i = i + 1;
        }
        indexedFnLen = n;
        return;
    }
    invalidateFunctions();
    var j := 0;
    loop j < n {
        entry := functions[j];
        pushFunctionSlot(j, entry.name, entry.runtime);
        j = j + 1;
    }
    indexedFnLen = n;
};

/** O(1) lookup of the first declared function named `name`, or -1. */
pub findFunction := fn(functions: List<FunctionInfo>, name: String): Int {
    syncFunctions(functions);
    fnByName.getOr(name, -1)
};

/** Returns all function indices declared under `name` in declaration order. */
pub findFunctions := fn(functions: List<FunctionInfo>, name: String): List<Int> {
    out: mut List<Int> = [];
    syncFunctions(functions);
    var cur := fnByName.getOr(name, -1);
    loop cur >= 0 {
        mut out.pushBack(cur);
        cur = fnOverloadNext[cur];
    }
    out
};

/** True when more than one overload is registered under `name`. */
pub hasOverloads := fn(functions: List<FunctionInfo>, name: String): Bool {
    syncFunctions(functions);
    first := fnByName.getOr(name, -1);
    first >= 0 and fnOverloadNext[first] >= 0
};

/** Finds the function index matching `(name, declAt)`, or -1 if none. */
pub findFunctionAt := fn(functions: List<FunctionInfo>, name: String, declAt: Int): Int {
    syncFunctions(functions);
    var cur := fnByName.getOr(name, -1);
    loop cur >= 0 {
        if functions[cur].declAt == declAt { return cur; }
        cur = fnOverloadNext[cur];
    }
    -1
};

/** O(1) lookup of the first declared function matching `runtime`, or -1. */
pub findFunctionByRuntime := fn(functions: List<FunctionInfo>, runtime: String): Int {
    if runtime == "" { return -1; }
    syncFunctions(functions);
    fnByRuntime.getOr(runtime, -1)
};

/** Resets all active symbol-table indexes at the start of a module parse. */
pub resetModule := fn(): Unit {
    invalidateLocals();
    invalidateAliases();
    invalidateFunctions();
};
