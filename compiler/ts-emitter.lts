/* TypeScript backend for the temporary Lite compiler. */
/** Formats a checked Int value as a TypeScript BigInt literal. */
intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == 0 { "0n" }
    else if negative { "(-" + digits + "n)" }
    else { digits + "n" }
}

/** Escapes a String as a readable TypeScript double-quoted literal. */
textLiteralCode := fn(value: String): String {
    size := textLength(value);
    var encoded := "\"";
    var position := 0;
    loop position < size {
        ch := textAt(value, position);
        if ch == "\\" { encoded = encoded + "\\\\"; }
        else if ch == "\"" { encoded = encoded + "\\\""; }
        else if ch == "\n" { encoded = encoded + "\\n"; }
        else if ch == "\r" { encoded = encoded + "\\r"; }
        else if ch == "\t" { encoded = encoded + "\\t"; }
        else { encoded = encoded + ch; }
        position = position + 1;
    }
    encoded + "\""
}

/** Formats a checked Bool value as a TypeScript literal. */
boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Emits a TypeScript logical negation around one Bool expression. */
notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a TypeScript short-circuit `and`/`or` expression around two Bool expressions. */
logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware TypeScript comparison; equality uses strict operators and not-less/not-more spellings invert the ordering. Bool comparisons coerce through `Boolean` so literal-type narrowing cannot reject them. */
comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    operator := if op == "==" { "===" }
        else if op == "=!=" { "!==" }
        else if op == "<" { "<" }
        else if op == "<!" { ">=" }
        else if op == "<=" { "<=" }
        else if op == "<!=" { ">" }
        else if op == ">" { ">" }
        else if op == ">!" { "<=" }
        else if op == ">=" { ">=" }
        else { "<" };
    if kind == "Bool" {
        "(Boolean(" + left + ") " + operator + " Boolean(" + right + "))"
    } else {
        "((" + left + ") " + operator + " (" + right + "))"
    }
}

/** Emits a BigInt floor-division expression without evaluating operands more than once in source semantics. */
floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0n) && (((" + left + " % " + right + ") < 0n) != (" + right + " < 0n))) ? 1n : 0n))"
}

/** Emits a BigInt floor-modulo expression. */
floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0n) && (((" + left + " % " + right + ") < 0n) != (" + right + " < 0n))) ? " + right + " : 0n))"
}

importFlatAll "frontend.lts";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Formats one report argument as a TypeScript string expression. */
reportArgumentCode := fn(item: Item): String {
    if item.kind == "Int" { "(" + item.code + ").toString()" }
    else if item.kind == "Bool" { "((" + item.code + ") ? \"true\" : \"false\")" }
    else { item.code }
}

/** Emits the TS module from the flat item stream. Locals become const/let declarations, control flow becomes braces, and reports append to and return `lite_out`. */
emitProgram := fn(items: Items): Unit {
    report("export function main(): string {");
    report("    let lite_out = \"\";");
    var indent := "    ";
    var line := "";
    var count := 0;
    loop items as item {
        if item.kind == "LocalInt" or item.kind == "LocalString" or item.kind == "LocalBool" {
            report(indent + "const " + item.runtime + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "VarInt" or item.kind == "VarString" or item.kind == "VarBool" {
            report(indent + "let " + item.runtime + " = " + item.code + ";");
            report(indent + "void " + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" {
            report(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "If" {
            condition := if item.code == "true" or item.code == "false" {
                "Boolean(" + item.code + ")"
            } else {
                item.code
            };
            report(indent + "if (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            report(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "Boolean(true)" }
                else if item.code == "false" { "Boolean(false)" }
                else { item.code };
            report(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "End" {
            report(indent + "lite_out += " + line + " + \"\\n\";");
            line = "";
            count = 0;
        } else {
            if count > 0 { line = line + " + \" \" + "; }
            line = line + reportArgumentCode(item);
            count = count + 1;
        }
    }
    report("    return lite_out;");
    report("}");
}

prefix := sourcePrefix();
source := inputAll();
emitProgram(parseProgram(source, prefix));
