/* Provisional bootstrap checked-integer support. Not an official standard library. */

/** Returns the smallest signed 64-bit value. */
intMin := fn(): Int { -9223372036854775808 }

/** Returns the largest signed 64-bit value. */
intMax := fn(): Int { 9223372036854775807 }

/** Checked signed 64-bit addition; `ok` is false instead of evaluating an overflow. */
intAdd := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right > 0 and left > intMax() - right { return (value = 0, ok = false); }
    if right < 0 and left < intMin() - right { return (value = 0, ok = false); }
    (value = left + right, ok = true)
}

/** Checked signed 64-bit subtraction; `ok` is false instead of evaluating an overflow. */
intSubtract := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right < 0 and left > intMax() + right { return (value = 0, ok = false); }
    if right > 0 and left < intMin() + right { return (value = 0, ok = false); }
    (value = left - right, ok = true)
}

/** Checked signed 64-bit multiplication; `ok` is false instead of evaluating an overflow. */
intMultiply := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if left == 0 or right == 0 { return (value = 0, ok = true); }
    if left > 0 {
        if right > 0 {
            if left > intMax() / right { return (value = 0, ok = false); }
        } else if right < intMin() / left {
            return (value = 0, ok = false);
        }
    } else if right > 0 {
        if left < intMin() / right { return (value = 0, ok = false); }
    } else if right < intMax() / left {
        return (value = 0, ok = false);
    }
    (value = left * right, ok = true)
}

/** Checked truncating signed division; `ok` is false on zero or the signed-minimum overflow. */
intDivide := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right == 0 { return (value = 0, ok = false); }
    if left == intMin() and right == -1 { return (value = 0, ok = false); }
    (value = left / right, ok = true)
}

/** Checked truncating signed remainder; `ok` is false on zero or the signed-minimum overflow. */
intRemainder := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right == 0 { return (value = 0, ok = false); }
    if left == intMin() and right == -1 { return (value = 0, ok = false); }
    (value = left % right, ok = true)
}

/** Checked floor division; `ok` is false on zero or the signed-minimum overflow. */
intFloorDivide := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right == 0 { return (value = 0, ok = false); }
    if left == intMin() and right == -1 { return (value = 0, ok = false); }
    quotient := left / right;
    if left % right =!= 0 and (left < 0) =!= (right < 0) {
        (value = quotient - 1, ok = true)
    } else {
        (value = quotient, ok = true)
    }
}

/** Checked floor modulo; `ok` is false only on a zero divisor. */
intFloorModulo := fn(left: Int, right: Int): (value: Int, ok: Bool) {
    if right == 0 { return (value = 0, ok = false); }
    remainder := left % right;
    if remainder =!= 0 and (remainder < 0) =!= (right < 0) {
        (value = remainder + right, ok = true)
    } else {
        (value = remainder, ok = true)
    }
}

/** Checked unary negation; `ok` is false for the signed minimum. */
intNegate := fn(value: Int): (value: Int, ok: Bool) {
    if value == intMin() { return (value = 0, ok = false); }
    (value = 0 - value, ok = true)
}

/** Formats one signed 64-bit Int as decimal text. */
intText := fn(value: Int): String {
    if value == 0 { return "0"; }
    if value == intMin() { return "-9223372036854775808"; }
    if value < 0 { return "-" + intText(0 - value); }
    var remaining := value;
    var digits := "";
    loop remaining > 0 {
        digit := remaining % 10;
        digits = textAt("0123456789", digit) + digits;
        remaining = remaining / 10;
    }
    digits
}
/* Provisional bootstrap text support. Not an official standard library. */


/** True when `text` is exactly one ASCII decimal digit. */
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

/** Numeric value of one checked ASCII decimal digit. */
digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

/** True for one ASCII letter, `a`-`z` or `A`-`Z`. */
isAsciiLetter := fn(ch: String): Bool {
    letters := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    size := textLength(letters);
    var position := 0;
    loop position < size {
        if textAt(letters, position) == ch { return true; }
        position = position + 1;
    }
    false
}

/** True for an ASCII identifier start or underscore accepted by the compiler subset. */
isNameStart := fn(ch: String): Bool {
    isAsciiLetter(ch) or ch == "_"
}

/** True for an identifier continuation character. */
isNameContinue := fn(ch: String): Bool {
    isNameStart(ch) or isDigit(ch)
}

/** Returns the first position at or after `start` that is not Lite whitespace. */
skipSpaces := fn(source: String, start: Int): Int {
    size := textLength(source);
    var position := start;
    loop position < size and (textAt(source, position) == " " or textAt(source, position) == "\t" or textAt(source, position) == "\r" or textAt(source, position) == "\n") {
        position = position + 1;
    }
    position
}

/** Returns the position after the identifier run starting at `start`. */
skipName := fn(source: String, start: Int): Int {
    size := textLength(source);
    var position := start;
    loop position < size and isNameContinue(textAt(source, position)) {
        position = position + 1;
    }
    position
}

/** True when `text` occurs at `position` and stays inside `source`. */
startsWithAt := fn(source: String, position: Int, text: String): Bool {
    width := textLength(text);
    if position < 0 or position + width > textLength(source) { return false; }
    textSlice(source, position, position + width) == text
}

/** True when the whole identifier `word` occurs at `position`, not a longer identifier that merely starts with it. */
wordAt := fn(source: String, position: Int, word: String): Bool {
    if not startsWithAt(source, position, word) { return false; }
    after := position + textLength(word);
    after >= textLength(source) or not isNameContinue(textAt(source, after))
}

/** Returns the first index at or after `start` where `needle` occurs, or -1 when absent. */
indexOfText := fn(source: String, needle: String, start: Int): Int {
    size := textLength(source);
    width := textLength(needle);
    var position := start;
    if position < 0 or position > size { return -1; }
    if width == 0 { return position; }
    loop position + width <= size {
        if startsWithAt(source, position, needle) { return position; }
        position = position + 1;
    }
    -1
}

/** Joins text values in list order with `separator` between adjacent values. */
joinTexts := fn(values: List<String>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = value;
            first = false;
        } else {
            result = result + separator + value;
        }
    }
    result
}

/** Parses optional-sign decimal Int64 text; `ok` is false for empty, malformed or out-of-range text. */
textToInt := fn(text: String): (value: Int, ok: Bool) {
    size := textLength(text);
    if size == 0 { return (value = 0, ok = false); }
    var position := 0;
    var negative := false;
    if textAt(text, 0) == "-" {
        negative = true;
        position = 1;
    } else if textAt(text, 0) == "+" {
        position = 1;
    }
    if position >= size { return (value = 0, ok = false); }
    var value := 0;
    loop position < size {
        ch := textAt(text, position);
        if not isDigit(ch) { return (value = 0, ok = false); }
        digit := digitValue(ch);
        if negative {
            if value < (intMin() + digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 - digit;
        } else {
            if value > (intMax() - digit) / 10 { return (value = 0, ok = false); }
            value = value * 10 + digit;
        }
        position = position + 1;
    }
    (value = value, ok = true)
}
/* Provisional bootstrap source-position support. Not an official standard library. */

/** Clamps one offset into the inclusive range `0..textLength(source)`. */
clampPosition := fn(source: String, position: Int): Int {
    size := textLength(source);
    if position < 0 { return 0; }
    if position > size { return size; }
    position
}

/** One-based line and column of a source offset, clamping at both ends. */
lineColumn := fn(source: String, position: Int): (line: Int, column: Int) {
    cursor := clampPosition(source, position);
    var line := 1;
    var lineStart := 0;
    var index := 0;
    loop index < cursor {
        if textAt(source, index) == "\n" {
            line = line + 1;
            lineStart = index + 1;
        }
        index = index + 1;
    }
    (line = line, column = cursor - lineStart + 1)
}

/** Number of source lines, counting the empty source as one line. */
lineCount := fn(source: String): Int {
    size := textLength(source);
    var count := 1;
    var index := 0;
    loop index < size {
        if textAt(source, index) == "\n" { count = count + 1; }
        index = index + 1;
    }
    count
}

/** Offset of the first character on one-based `line`, or text length when absent. */
lineStartOffset := fn(source: String, line: Int): Int {
    size := textLength(source);
    if line <= 1 { return 0; }
    var current := 2;
    var index := 0;
    loop index < size {
        if textAt(source, index) == "\n" {
            if current == line { return index + 1; }
            current = current + 1;
        }
        index = index + 1;
    }
    size
}

/** Offset just before the line terminator of one-based `line`. */
lineEndOffset := fn(source: String, line: Int): Int {
    size := textLength(source);
    start := lineStartOffset(source, line);
    var index := start;
    loop index < size and textAt(source, index) =!= "\n" {
        index = index + 1;
    }
    index
}
/* Provisional bootstrap diagnostic support. Not an official standard library. */

/** Returns the process status used for source, type and unsupported-feature diagnostics. */
diagnosticExit := fn(): Int { 2 }

/** Category text used by the igniter for source-shape failures. */
sourceErrorCategory := "SourceError";

/** Category text used by the igniter for type failures. */
typeErrorCategory := "TypeError";

/** Reports `message`, prefixed by `prefix:` when nonempty, then exits 2. */
fail := fn(prefix: String, message: String): Unit {
    if prefix == "" {
        reportError(message);
    } else {
        reportError(prefix + ":" + message);
    }
    exit(diagnosticExit());
}

/** Reports `message` through `fail` unless `condition` is true. */
expect := fn(prefix: String, condition: Bool, message: String): Unit {
    if not condition { fail(prefix, message); } else { }
}
/* Provisional bootstrap formatting support. Not an official standard library. */


/** Formats one signed 64-bit Int as decimal text. */
decimalText := fn(value: Int): String {
    intText(value)
}

/** Left-pads `value` with spaces to at least `width` characters. */
padLeftText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = " " + result;
        index = index + 1;
    }
    result
}

/** Right-pads `value` with spaces to at least `width` characters. */
padRightText := fn(value: String, width: Int): String {
    size := textLength(value);
    var result := value;
    var index := size;
    loop index < width {
        result = result + " ";
        index = index + 1;
    }
    result
}

/** Formats an Int and left-pads it with spaces to at least `width` characters. */
padLeftInt := fn(value: Int, width: Int): String {
    padLeftText(intText(value), width)
}

/** Formats an Int and right-pads it with spaces to at least `width` characters. */
padRightInt := fn(value: Int, width: Int): String {
    padRightText(intText(value), width)
}

/** Joins Int values in list order with `separator` between adjacent values. */
joinIntTexts := fn(values: List<Int>, separator: String): String {
    var result := "";
    var first := true;
    loop values as value {
        if first {
            result = intText(value);
            first = false;
        } else {
            result = result + separator + intText(value);
        }
    }
    result
}
/* Provisional bootstrap list-search support. Not an official standard library. */

/** Returns the index of `target` in `values`, or -1 when absent. */
listIndexOfText := fn(values: List<String>, target: String): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index = index + 1;
    }
    -1
}

/** True when `values` contains `target`. */
listContainsText := fn(values: List<String>, target: String): Bool {
    listIndexOfText(values, target) >= 0
}

/** Returns the index of `target` in `values`, or -1 when absent. */
listIndexOfInt := fn(values: List<Int>, target: Int): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index = index + 1;
    }
    -1
}

/** True when `values` contains `target`. */
listContainsInt := fn(values: List<Int>, target: Int): Bool {
    listIndexOfInt(values, target) >= 0
}

/** Returns the index of `target` in `values`, or -1 when absent. */
listIndexOfBool := fn(values: List<Bool>, target: Bool): Int {
    var index := 0;
    loop values as value {
        if value == target { return index; }
        index = index + 1;
    }
    -1
}

/** True when `values` contains `target`. */
listContainsBool := fn(values: List<Bool>, target: Bool): Bool {
    listIndexOfBool(values, target) >= 0
}
/* C backend for the temporary Lite compiler. */
/** Formats a checked Int value as a C signed 64-bit literal (`INT64_C`, `INT64_MIN`). */
intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == -9223372036854775808 { "INT64_MIN" }
    else if value == 0 { "INT64_C(0)" }
    else if negative { "(-INT64_C(" + digits + "))" }
    else { "INT64_C(" + digits + ")" }
}

/** Escapes a String as a readable C literal, including trigraph-safe `?`. */
textLiteralCode := fn(value: String): String {
    size := textLength(value);
    var encoded := "\"";
    var position := 0;
    loop position < size {
        ch := textAt(value, position);
        if ch == "\\" { encoded = encoded + "\\\\"; }
        else if ch == "\"" { encoded = encoded + "\\\""; }
        else if ch == "?" { encoded = encoded + "\\?"; }
        else if ch == "\n" { encoded = encoded + "\\n"; }
        else if ch == "\r" { encoded = encoded + "\\r"; }
        else if ch == "\t" { encoded = encoded + "\\t"; }
        else { encoded = encoded + ch; }
        position = position + 1;
    }
    encoded + "\""
}

/** Formats a checked Bool value as a C `stdbool.h` literal. */
boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Rejects the ordinary list value copy this backend does not implement; list values are unsupported in C. */
listCopyCode := fn(code: String): String {
    fail("", "C backend does not support list values yet");
    code
}

/** Emits a checked UTF-8 byte concatenation call; the bootstrap C backend intentionally leaks each result. */
concatCode := fn(left: String, right: String): String {
    "lite_concat(" + left + ", " + right + ")"
}

/** Emits a C logical negation around one Bool expression. */
notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a C short-circuit `and`/`or` expression around two Bool expressions. */
logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware C comparison; String equality uses `strcmp` and not-less/not-more spellings invert the ordering. */
comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    if kind == "String" {
        if op == "==" { "strcmp(" + left + ", " + right + ") == 0" }
        else { "strcmp(" + left + ", " + right + ") != 0" }
    } else {
        operator := if op == "==" { "==" }
            else if op == "=!=" { "!=" }
            else if op == "<" { "<" }
            else if op == "<!" { ">=" }
            else if op == "<=" { "<=" }
            else if op == "<!=" { ">" }
            else if op == ">" { ">" }
            else if op == ">!" { "<=" }
            else if op == ">=" { ">=" }
            else { "<" };
        "(" + left + ") " + operator + " (" + right + ")"
    }
}

/** Emits an int64_t floor-division expression. */
floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? 1 : 0))"
}

/** Emits an int64_t floor-modulo expression. */
floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? " + right + " : 0))"
}

/** Emits a checked int64_t truncating division call. */
intDivideCode := fn(left: String, right: String): String {
    "lite_divide_int(" + left + ", " + right + ")"
}

/** Emits a checked int64_t remainder call. */
intRemainderCode := fn(left: String, right: String): String {
    "lite_remainder_int(" + left + ", " + right + ")"
}

/** Emits a checked int64_t floor-division call. */
intFloorDivideCode := fn(left: String, right: String): String {
    "lite_floor_divide_int(" + left + ", " + right + ")"
}

/** Emits a checked int64_t floor-modulo call. */
intFloorModuloCode := fn(left: String, right: String): String {
    "lite_floor_modulo_int(" + left + ", " + right + ")"
}
/* Shared restricted front-end. Not a standalone program: a target manifest
   places the target literal encoders before this file and the emitter/driver
   after it. */
/** One parsed expression: target `code`, checked compile-time value, whether that value is a constant, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, constant: Bool, next: Int);
/** One local visible to later statements: source name, hygienic runtime name, value kind, binding reassignment permission, held-data write grant, declaration block depth, constant value and target code. */
Local := type (name: String, runtime: String, kind: String, mutable: Bool, writable: Bool, depth: Int, constant: Bool, code: String, intValue: Int, textValue: String);
/** One entry in the flat program stream: a report argument or boundary, a local declaration or assignment, an if/loop/function block marker, a break/continue target, a return or a function call statement. */
Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Flat program stream returned by parseProgram and consumed by a backend emitter. */
Items := type List<Item>;
/** One recognized binary operator spelling and the number of source bytes it occupies. */
Operator := type (text: String, width: Int);
/** One previously declared top-level function: source name, result kind, first parameter entry and parameter count. */
FunctionInfo := type (name: String, result: String, first: Int, count: Int);
/** One top-level transparent type alias: source name, raw target type text, declaration position and the position just after that target. */
AliasDecl := type (name: String, target: String, at: Int, end: Int);

/** Reports one source-positioned diagnostic as `name:line:column: message`, or `line:column: message` when `prefix` is empty, then exits 2. */
failAt := fn(source: String, position: Int, prefix: String, message: String): Unit {
    place := lineColumn(source, position);
    fail(prefix, decimalText(place.line) + ":" + decimalText(place.column) + ": " + message);
}

/** Consumes the exact `symbol` at `position`, or reports a source-positioned diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLength(source) or textAt(source, position) =!= symbol {
        failAt(source, position, prefix, "expected " + symbol);
    }
    position + 1
}

/** Number of consecutive `#` characters after a comment opener; zero means an ordinary comment. */
rawFenceLength := fn(source: String, position: Int): Int {
    if not startsWithAt(source, position, "/*") { return 0; }
    var index := position + 2;
    var count := 0;
    loop index < textLength(source) and textAt(source, index) == "#" {
        count = count + 1;
        index = index + 1;
    }
    count
}

/** Returns the position after one raw comment whose opener starts at `position`; fails at the opener when its fence never closes. */
skipRawComment := fn(source: String, position: Int, fence: Int, prefix: String): Int {
    size := textLength(source);
    var cursor := position + 2 + fence;
    loop cursor < size {
        if textAt(source, cursor) == "#" {
            runStart := cursor;
            var runEnd := cursor;
            loop runEnd < size and textAt(source, runEnd) == "#" { runEnd = runEnd + 1; }
            if runEnd - runStart == fence and startsWithAt(source, runEnd, "*/") {
                return runEnd + 2;
            }
            cursor = runEnd;
        } else {
            cursor = cursor + 1;
        }
    }
    failAt(source, position, prefix, "unterminated raw comment");
    size
}

/** Returns the position after one ordinary comment, including nested comments and embedded raw comments. */
skipComment := fn(source: String, position: Int, prefix: String): Int {
    size := textLength(source);
    fence := rawFenceLength(source, position);
    if fence > 0 { return skipRawComment(source, position, fence, prefix); }
    var cursor := position + 2;
    var depth := 1;
    loop true {
        if cursor >= size {
            failAt(source, position, prefix, "unterminated comment");
        }
        if startsWithAt(source, cursor, "/*") {
            innerFence := rawFenceLength(source, cursor);
            if innerFence > 0 {
                cursor = skipRawComment(source, cursor, innerFence, prefix);
            } else {
                depth = depth + 1;
                cursor = cursor + 2;
            }
        } else if startsWithAt(source, cursor, "*/") {
            depth = depth - 1;
            cursor = cursor + 2;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Returns the first position at or after `start` that is neither whitespace nor a comment; comments separate tokens as whitespace does. */
skipTrivia := fn(source: String, start: Int, prefix: String): Int {
    size := textLength(source);
    var position := start;
    loop position < size {
        ch := textAt(source, position);
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            position = position + 1;
        } else if startsWithAt(source, position, "/*") {
            position = skipComment(source, position, prefix);
        } else {
            break;
        }
    }
    position
}

/** True for a Lite keyword that this restricted compiler does not implement. */
isReservedWord := fn(name: String): Bool {
    name == "var" or name == "mut" or name == "fn" or name == "loop" or
    name == "break" or name == "continue" or name == "return" or name == "if" or
    name == "else" or name == "then" or name == "finally" or name == "match" or
    name == "import" or name == "using" or name == "record" or name == "type" or
    name == "and" or name == "or" or name == "not" or name == "true" or name == "false"
}

/** Returns the documentation path for one reserved Lite feature. */
featureDoc := fn(name: String): String {
    if name == "loop" { "docs/loops.md" }
    else if name == "if" or name == "else" or name == "and" or name == "or" or name == "not" or
        name == "true" or name == "false" { "docs/conditionals.md" }
    else if name == "var" or name == "mut" { "docs/declarations-and-assignment.md" }
    else if name == "fn" or name == "return" { "docs/functions.md" }
    else if name == "match" { "docs/match.md" }
    else if name == "import" or name == "using" { "docs/modules-and-packages.md" }
    else if name == "record" or name == "type" { "docs/types-and-inference.md" }
    else if name == "break" or name == "continue" { "docs/control-flow.md" }
    else if name == "then" or name == "finally" { "docs/finally.md" }
    else { "docs/grammar-sketch.md" }
}

/** Reports a reserved Lite feature this compiler checkpoint cannot translate, with its documentation reference, then exits 2. */
unsupportedFeature := fn(source: String, position: Int, name: String, prefix: String): Unit {
    failAt(source, position, prefix, "unsupported feature \"" + name + "\": see " + featureDoc(name) +
        "; the restricted compiler accepts Int/String/Bool expressions, locals, report, if/else and loop only");
}

/** Returns the index of the previously declared function named `name`, or -1. */
findFunction := fn(functions: List<FunctionInfo>, name: String): Int {
    var index := 0;
    loop functions as entry {
        if entry.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** True for type-constructor names that later slices will admit, not scalar, flat named-tuple or List aliases yet. */
isUnsupportedAliasTarget := fn(name: String): Bool {
    name == "List" or name == "Float" or name == "Double" or name == "Array" or
    name == "Option" or name == "Result" or name == "record" or name == "fn"
}

/** Reports one unsupported transparent-alias target, naming a known type constructor when possible. */
unsupportedAliasTarget := fn(source: String, position: Int, prefix: String, target: String): Unit {
    failAt(source, position, prefix, "unsupported type alias " + target +
        "; only Int, String, Bool, Unit, List<T>, flat named tuples and aliases are supported");
}

/** Returns the index of the first top-level alias named `name`, or -1 when absent. */
findAlias := fn(aliases: List<AliasDecl>, name: String): Int {
    var index := 0;
    loop aliases as alias {
        if alias.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Returns the index of the alias declared at `position`, or -1 when absent. */
aliasIndexAt := fn(aliases: List<AliasDecl>, position: Int): Int {
    var index := 0;
    loop aliases as alias {
        if alias.at == position { return index; }
        index = index + 1;
    }
    -1
}

/** True when `kind` is this compiler's canonical flat named-tuple kind, written `(label:Kind,label:Kind)`. */
isTupleKind := fn(kind: String): Bool {
    textLength(kind) > 0 and textAt(kind, 0) == "("
}

/** True when `kind` is this compiler's canonical one-argument list kind, written `List<ElementKind>`. */
isListKind := fn(kind: String): Bool {
    textLength(kind) > 5 and startsWithAt(kind, 0, "List<") and textAt(kind, textLength(kind) - 1) == ">"
}

/** Returns the canonical element kind from `List<ElementKind>`. */
listElementKind := fn(kind: String): String {
    if not isListKind(kind) { return ""; }
    textSlice(kind, 5, textLength(kind) - 1)
}

/** True when emitted target code calls `needle` outside quoted String literal text. */
codeUsesTextCall := fn(code: String, needle: String): Bool {
    size := textLength(code);
    var cursor := 0;
    loop cursor < size {
        ch := textAt(code, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            loop cursor < size {
                escaped := textAt(code, cursor);
                if escaped == "\\" {
                    cursor = cursor + 2;
                } else if escaped == "\"" {
                    cursor = cursor + 1;
                    break;
                } else {
                    cursor = cursor + 1;
                }
            }
        } else if startsWithAt(code, cursor, needle) {
            return true;
        } else {
            cursor = cursor + 1;
        }
    }
    false
}

/** True when emitted target code calls the checked list-index helper outside quoted String literal text. */
codeUsesListIndex := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listAt(")
}

/** True when emitted target code calls the checked list-pop helper outside quoted String literal text. */
codeUsesListPop := fn(code: String): Bool {
    codeUsesTextCall(code, "lite$listPopBack(")
}

/** True when emitted target code contains a value-if conditional expression outside quoted String literal text. */
codeUsesValueIf := fn(code: String): Bool {
    codeUsesTextCall(code, "Boolean(")
}

/** Returns the scalar kind of tuple field `label` in canonical `kind`, or empty text when the field is absent. */
tupleFieldKind := fn(kind: String, label: String): String {
    size := textLength(kind);
    var cursor := 1;
    loop cursor < size and textAt(kind, cursor) =!= ")" {
        nameStart := cursor;
        cursor = skipName(kind, cursor);
        fieldName := textSlice(kind, nameStart, cursor);
        if cursor < size and textAt(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipName(kind, cursor);
        fieldKind := textSlice(kind, typeStart, cursor);
        if fieldName == label { return fieldKind; }
        if cursor < size and textAt(kind, cursor) == "," { cursor = cursor + 1; }
    }
    ""
}

/** Renders one canonical kind for diagnostics, adding spaces inside flat named tuples and lists. */
displayKind := fn(kind: String): String {
    if isListKind(kind) { return "List<" + displayKind(listElementKind(kind)) + ">"; }
    if not isTupleKind(kind) { return kind; }
    size := textLength(kind);
    var cursor := 1;
    var result := "(";
    var count := 0;
    loop cursor < size and textAt(kind, cursor) =!= ")" {
        nameStart := cursor;
        cursor = skipName(kind, cursor);
        fieldName := textSlice(kind, nameStart, cursor);
        if cursor < size and textAt(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipName(kind, cursor);
        fieldKind := textSlice(kind, typeStart, cursor);
        if count > 0 { result = result + ", "; }
        result = result + fieldName + ": " + displayKind(fieldKind);
        count = count + 1;
        if cursor < size and textAt(kind, cursor) == "," { cursor = cursor + 1; }
    }
    result + ")"
}

/** Resolves one scalar or flat named-tuple type text, following transparent aliases and rejecting unknown names, nested tuples, unsupported targets and cycles. */
resolveTypeText := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, text: String, seen: List<String>): String {
    size := textLength(text);
    var cursor := skipTrivia(text, 0, prefix);
    if cursor < size and textAt(text, cursor) == "(" {
        cursor = skipTrivia(text, cursor + 1, prefix);
        labels: mut List<String> = [];
        var kindText := "(";
        var count := 0;
        loop true {
            if cursor >= size { failAt(source, position, prefix, "expected ) in tuple type"); }
            if textAt(text, cursor) == ")" {
                cursor = cursor + 1;
                break;
            }
            if not isNameStart(textAt(text, cursor)) {
                failAt(source, position, prefix, "expected a tuple field name");
            }
            labelStart := cursor;
            cursor = skipName(text, cursor);
            label := textSlice(text, labelStart, cursor);
            if listContainsText(labels, label) {
                failAt(source, position, prefix, "duplicate tuple field " + label);
            }
            push_back(mut labels, label);
            cursor = skipTrivia(text, cursor, prefix);
            if cursor >= size or textAt(text, cursor) =!= ":" {
                failAt(source, position, prefix, "expected : after tuple field " + label);
            }
            cursor = skipTrivia(text, cursor + 1, prefix);
            if cursor < size and textAt(text, cursor) == "(" {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            if cursor >= size or not isNameStart(textAt(text, cursor)) {
                failAt(source, position, prefix, "expected a tuple field type");
            }
            componentStart := cursor;
            cursor = skipName(text, cursor);
            componentName := textSlice(text, componentStart, cursor);
            componentKind := resolveTypeText(source, position, prefix, aliases, componentName, seen);
            if isTupleKind(componentKind) {
                failAt(source, position, prefix, "nested tuple types are not supported");
            }
            if isListKind(componentKind) {
                failAt(source, position, prefix, "list types inside tuples are not supported");
            }
            if componentKind == "Unit" {
                failAt(source, position, prefix, "unsupported tuple component type Unit");
            }
            if count > 0 { kindText = kindText + ","; }
            kindText = kindText + label + ":" + componentKind;
            count = count + 1;
            cursor = skipTrivia(text, cursor, prefix);
            if cursor < size and textAt(text, cursor) == "," {
                cursor = skipTrivia(text, cursor + 1, prefix);
            }
        }
        if count == 0 {
            failAt(source, position, prefix, "tuple type needs at least one field");
        }
        cursor = skipTrivia(text, cursor, prefix);
        if cursor < size {
            failAt(source, position, prefix, "unexpected text after tuple type");
        }
        return kindText + ")";
    }
    after := skipName(text, cursor);
    name := textSlice(text, cursor, after);
    afterTrivia := skipTrivia(text, after, prefix);
    if name == "List" and afterTrivia < size and textAt(text, afterTrivia) == "<" {
        innerStart := skipTrivia(text, afterTrivia + 1, prefix);
        if innerStart >= size or textAt(text, innerStart) == ">" {
            failAt(source, position, prefix, "expected a list element type");
        }
        var scan := innerStart;
        var depth := 0;
        var close := -1;
        loop scan < size {
            ch := textAt(text, scan);
            if ch == "<" {
                depth = depth + 1;
            } else if ch == ">" {
                if depth == 0 {
                    close = scan;
                    break;
                }
                depth = depth - 1;
            }
            scan = scan + 1;
        }
        if close < 0 {
            failAt(source, position, prefix, "expected > in list type");
        }
        innerText := textSlice(text, innerStart, close);
        innerKind := resolveTypeText(source, position, prefix, aliases, innerText, seen);
        if isListKind(innerKind) {
            failAt(source, position, prefix, "nested list types are not supported");
        }
        if innerKind == "Unit" {
            failAt(source, position, prefix, "unsupported list element type Unit");
        }
        afterList := skipTrivia(text, close + 1, prefix);
        if afterList < size {
            failAt(source, position, prefix, "unexpected text after list type");
        }
        return "List<" + innerKind + ">";
    }
    if afterTrivia < size {
        failAt(source, position, prefix, "unexpected text after type " + name);
    }
    if name == "Int" or name == "String" or name == "Bool" or name == "Unit" { return name; }
    if isUnsupportedAliasTarget(name) {
        unsupportedAliasTarget(source, position, prefix, name);
        return "";
    }
    index := findAlias(aliases, name);
    if index < 0 {
        failAt(source, position, prefix, "unknown type alias " + name);
        return "";
    }
    alias := aliases[index];
    if listContainsText(seen, name) {
        failAt(source, alias.at, prefix, "recursive type alias " + name);
        return "";
    }
    if alias.target == "" {
        unsupportedAliasTarget(source, alias.at, prefix, "target");
        return "";
    }
    nextSeen: mut List<String> = seen;
    push_back(mut nextSeen, name);
    resolveTypeText(source, alias.at, prefix, aliases, alias.target, nextSeen)
}

/** Resolves one transparent alias name to its scalar or flat named-tuple kind. */
resolveAliasKind := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, name: String, seen: List<String>): String {
    resolveTypeText(source, position, prefix, aliases, name, seen)
}

/** Parses one source-level flat named-tuple type `(label: Type, ...)`; components must resolve to Int, String or Bool. */
parseTupleTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    size := textLength(source);
    var cursor := skipTrivia(source, position, prefix);
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    labels: mut List<String> = [];
    var kindText := "(";
    var count := 0;
    loop true {
        if cursor >= size { failAt(source, cursor, prefix, "expected ) in tuple type"); }
        if textAt(source, cursor) == ")" {
            cursor = cursor + 1;
            break;
        }
        if not isNameStart(textAt(source, cursor)) {
            failAt(source, cursor, prefix, "expected a tuple field name");
        }
        labelStart := cursor;
        cursor = skipName(source, cursor);
        label := textSlice(source, labelStart, cursor);
        if isReservedWord(label) { unsupportedFeature(source, labelStart, label, prefix); }
        if listContainsText(labels, label) {
            failAt(source, labelStart, prefix, "duplicate tuple field " + label);
        }
        push_back(mut labels, label);
        cursor = skipTrivia(source, cursor, prefix);
        if cursor >= size or textAt(source, cursor) =!= ":" {
            failAt(source, cursor, prefix, "expected : after tuple field " + label);
        }
        cursor = skipTrivia(source, cursor + 1, prefix);
        if cursor < size and textAt(source, cursor) == "(" {
            failAt(source, cursor, prefix, "nested tuple types are not supported");
        }
        if cursor >= size or not isNameStart(textAt(source, cursor)) {
            failAt(source, cursor, prefix, "expected a tuple field type");
        }
        componentStart := cursor;
        cursor = skipName(source, cursor);
        componentName := textSlice(source, componentStart, cursor);
        var componentKind := "";
        if componentName == "Int" or componentName == "String" or componentName == "Bool" or componentName == "Unit" {
            componentKind = componentName;
        } else if findAlias(aliases, componentName) >= 0 {
            seen: mut List<String> = [];
            componentKind = resolveAliasKind(source, componentStart, prefix, aliases, componentName, seen);
        } else {
            failAt(source, componentStart, prefix, "unsupported tuple field type " + componentName);
        }
        if isTupleKind(componentKind) {
            failAt(source, componentStart, prefix, "nested tuple types are not supported");
        }
        if isListKind(componentKind) {
            failAt(source, componentStart, prefix, "list types inside tuples are not supported");
        }
        if componentKind == "Unit" {
            failAt(source, componentStart, prefix, "unsupported tuple component type Unit");
        }
        if count > 0 { kindText = kindText + ","; }
        kindText = kindText + label + ":" + componentKind;
        count = count + 1;
        cursor = skipTrivia(source, cursor, prefix);
        if cursor < size and textAt(source, cursor) == "," {
            cursor = skipTrivia(source, cursor + 1, prefix);
        }
    }
    if count == 0 {
        failAt(source, position, prefix, "tuple type needs at least one field");
    }
    (kind = kindText + ")", next = cursor)
}

/** Parses one source-level type: a scalar name, a transparent alias, a flat named tuple or `List<T>`. */
parseTypeAt := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>, context: String): (kind: String, next: Int) {
    start := skipTrivia(source, position, prefix);
    if start < textLength(source) and textAt(source, start) == "(" {
        return parseTupleTypeAt(source, position, prefix, aliases);
    }
    after := skipName(source, start);
    name := textSlice(source, start, after);
    afterName := skipTrivia(source, after, prefix);
    if name == "List" and afterName < textLength(source) and textAt(source, afterName) == "<" {
        innerStart := skipTrivia(source, afterName + 1, prefix);
        if innerStart >= textLength(source) or textAt(source, innerStart) == ">" {
            failAt(source, innerStart, prefix, "expected a list element type");
        }
        inner := parseTypeAt(source, innerStart, prefix, aliases, context);
        if isListKind(inner.kind) {
            failAt(source, innerStart, prefix, "nested list types are not supported");
        }
        if inner.kind == "Unit" {
            failAt(source, innerStart, prefix, "unsupported list element type Unit");
        }
        var close := skipTrivia(source, inner.next, prefix);
        close = expectSymbol(source, close, ">", prefix);
        (kind = "List<" + inner.kind + ">", next = close)
    } else if name == "Int" or name == "String" or name == "Bool" or name == "Unit" {
        (kind = name, next = after)
    } else if findAlias(aliases, name) >= 0 {
        seen: mut List<String> = [];
        (kind = resolveAliasKind(source, start, prefix, aliases, name, seen), next = after)
    } else {
        failAt(source, start, prefix, "unsupported " + context + " type " + name);
        (kind = "", next = after)
    }
}

/** Parses one function parameter or result type, including flat named tuples and transparent aliases. */
parseFunctionType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, next: Int) {
    parseTypeAt(source, position, prefix, aliases, "function")
}

/** Parses `(name: Type, ...): ResultType` after a top-level `fn`. Returns the next position, result kind, `|`-separated `name=kind` parameters and their count. */
parseFunctionHeader := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (next: Int, result: String, params: String, count: Int) {
    size := textLength(source);
    var cursor := skipTrivia(source, position, prefix);
    cursor = expectSymbol(source, cursor, "(", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    names: mut List<String> = [];
    var encoded := "";
    var count := 0;
    if cursor < size and textAt(source, cursor) =!= ")" {
        loop true {
            if cursor >= size or not isNameStart(textAt(source, cursor)) {
                failAt(source, cursor, prefix, "expected a parameter name");
            }
            nameStart := cursor;
            cursor = skipName(source, cursor);
            parameterName := textSlice(source, nameStart, cursor);
            if isReservedWord(parameterName) { unsupportedFeature(source, nameStart, parameterName, prefix); }
            if listContainsText(names, parameterName) {
                failAt(source, nameStart, prefix, "duplicate parameter " + parameterName);
            }
            push_back(mut names, parameterName);
            cursor = skipTrivia(source, cursor, prefix);
            cursor = expectSymbol(source, cursor, ":", prefix);
            typed := parseFunctionType(source, cursor, prefix, aliases);
            cursor = skipTrivia(source, typed.next, prefix);
            if count > 0 { encoded = encoded + "|"; }
            encoded = encoded + parameterName + "=" + typed.kind;
            count = count + 1;
            if cursor < size and textAt(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
    }
    cursor = expectSymbol(source, cursor, ")", prefix);
    cursor = skipTrivia(source, cursor, prefix);
    cursor = expectSymbol(source, cursor, ":", prefix);
    resultType := parseFunctionType(source, cursor, prefix, aliases);
    (next = resultType.next, result = resultType.kind, params = encoded, count = count)
}

/** Returns the source name from one encoded `name=kind` function parameter entry. */
paramNameOf := fn(entry: String): String {
    separator := indexOfText(entry, "=", 0);
    if separator < 0 { return entry; }
    textSlice(entry, 0, separator)
}

/** Returns the kind from one encoded `name=kind` function parameter entry. */
paramKindOf := fn(entry: String): String {
    separator := indexOfText(entry, "=", 0);
    if separator < 0 { return ""; }
    textSlice(entry, separator + 1, textLength(entry))
}

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, constant: Bool, next: Int): Parsed {
    (kind = "Int", code = code, intValue = value, textValue = "", constant = constant, next = next)
}

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, constant: Bool, next: Int): Parsed {
    (kind = "String", code = code, intValue = 0, textValue = value, constant = constant, next = next)
}

/** Builds a Bool parsed value; `intValue` is 1 for true and 0 for false. */
boolParsed := fn(code: String, value: Bool, constant: Bool, next: Int): Parsed {
    (kind = "Bool", code = code, intValue = if value { 1 } else { 0 }, textValue = "", constant = constant, next = next)
}

/* Checked compile-time evaluation keeps every emitted operation in signed 64-bit range. */
/** Checked signed 64-bit addition; reports at `at` and exits 2 on overflow. */
addIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intAdd(left, right);
    if not result.ok { failAt(source, at, prefix, "integer expression outside signed 64-bit range"); }
    result.value
}

/** Checked signed 64-bit subtraction; reports at `at` and exits 2 on overflow. */
subtractIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intSubtract(left, right);
    if not result.ok { failAt(source, at, prefix, "integer expression outside signed 64-bit range"); }
    result.value
}

/** Checked signed 64-bit multiplication; reports at `at` and exits 2 on overflow. */
multiplyIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intMultiply(left, right);
    if not result.ok { failAt(source, at, prefix, "integer expression outside signed 64-bit range"); }
    result.value
}

/** Truncating signed 64-bit division; reports at `at` and exits 2 on zero or MIN divided by -1. */
divideIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intDivide(left, right);
    if not result.ok {
        if right == 0 { failAt(source, at, prefix, "division by zero in integer expression"); }
        failAt(source, at, prefix, "integer expression outside signed 64-bit range");
    }
    result.value
}

/** Checked truncating Int remainder; reports at `at` and exits 2 on zero divisor or signed overflow. */
remainderIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intRemainder(left, right);
    if not result.ok {
        if right == 0 { failAt(source, at, prefix, "remainder by zero in integer expression"); }
        failAt(source, at, prefix, "integer expression outside signed 64-bit range");
    }
    result.value
}

/** Checked floor division; reports at `at` and exits 2 on zero or signed overflow. */
floorDivideIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intFloorDivide(left, right);
    if not result.ok {
        if right == 0 { failAt(source, at, prefix, "division by zero in integer expression"); }
        failAt(source, at, prefix, "integer expression outside signed 64-bit range");
    }
    result.value
}

/** Checked floor modulo; reports at `at` and exits 2 on zero. */
floorModuloIntegers := fn(source: String, at: Int, left: Int, right: Int, prefix: String): Int {
    result := intFloorModulo(left, right);
    if not result.ok { failAt(source, at, prefix, "modulo by zero in integer expression"); }
    result.value
}

/** Checked unary negation; reports at `at` and exits 2 for the signed minimum. */
negateInteger := fn(source: String, at: Int, value: Int, prefix: String): Int {
    result := intNegate(value);
    if not result.ok { failAt(source, at, prefix, "integer expression outside signed 64-bit range"); }
    result.value
}

/** Returns the index of the newest visible `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int {
    var index := 0;
    var found := -1;
    loop locals as local {
        if local.name == name { found = index; }
        index = index + 1;
    }
    found
}

/** True when `name` is already declared directly in the block at `depth`, so shadowing an outer block remains allowed. */
localSameBlock := fn(locals: List<Local>, name: String, depth: Int): Bool {
    index := localIndex(locals, name);
    if index < 0 { return false; }
    locals[index].depth == depth
}

/** True for the ten comparison spellings accepted by this checkpoint. */
isComparison := fn(operator: String): Bool {
    operator == "==" or operator == "=!=" or operator == "<" or operator == "<!" or
    operator == "<=" or operator == "<!=" or operator == ">" or operator == ">!" or
    operator == ">=" or operator == ">!="
}

/** Precedence level of a recognized binary operator; comparisons bind below arithmetic and logic binds below comparisons. */
operatorLevel := fn(operator: String): Int {
    if operator == "or" { 2 }
    else if operator == "and" { 3 }
    else if isComparison(operator) { 5 }
    else if operator == "+" or operator == "-" { 10 }
    else if operator == "*" or operator == "/" or operator == "%" or operator == ":/" or operator == ":%" { 20 }
    else { 0 }
}

/** Reads an operator at `position`, preferring the longest spelling; returns empty text when none starts there. */
readOperator := fn(source: String, position: Int): Operator {
    if startsWithAt(source, position, "=!=") { return (text = "=!=", width = 3); }
    if startsWithAt(source, position, "<!=") { return (text = "<!=", width = 3); }
    if startsWithAt(source, position, ">!=") { return (text = ">!=", width = 3); }
    if startsWithAt(source, position, "==") { return (text = "==", width = 2); }
    if startsWithAt(source, position, "<=") { return (text = "<=", width = 2); }
    if startsWithAt(source, position, ">=") { return (text = ">=", width = 2); }
    if startsWithAt(source, position, "<!") { return (text = "<!", width = 2); }
    if startsWithAt(source, position, ">!") { return (text = ">!", width = 2); }
    ch := textAt(source, position);
    if ch == "<" { return (text = "<", width = 1); }
    if ch == ">" { return (text = ">", width = 1); }
    if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" { return (text = ch, width = 1); }
    if startsWithAt(source, position, ":/") { return (text = ":/", width = 2); }
    if startsWithAt(source, position, ":%") { return (text = ":%", width = 2); }
    if isNameStart(ch) {
        after := skipName(source, position);
        word := textSlice(source, position, after);
        if word == "and" or word == "or" { return (text = word, width = after - position); }
    }
    (text = "", width = 0)
}

/** Folds one of the ten Int comparisons to a Bool. */
compareIntegers := fn(operator: String, left: Int, right: Int): Bool {
    if operator == "==" { left == right }
    else if operator == "=!=" { left =!= right }
    else if operator == "<" { left < right }
    else if operator == "<!" { left >= right }
    else if operator == "<=" { left <= right }
    else if operator == "<!=" { left > right }
    else if operator == ">" { left > right }
    else if operator == ">!" { left <= right }
    else if operator == ">=" { left >= right }
    else { left < right }
}

/** Folds String equality or inequality. */
compareTexts := fn(operator: String, left: String, right: String): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Folds Bool equality or inequality. */
compareBools := fn(operator: String, left: Bool, right: Bool): Bool {
    if operator == "==" { left == right } else { left =!= right }
}

/** Checks and folds or lowers one comparison expression at operator offset `at`, then returns its Bool parsed value. */
compareParsed := fn(source: String, at: Int, operator: String, left: Parsed, right: Parsed, prefix: String): Parsed {
    if left.kind =!= right.kind {
        failAt(source, at, prefix, "cannot compare " + displayKind(left.kind) + " and " + displayKind(right.kind));
    }
    if isTupleKind(left.kind) {
        failAt(source, at, prefix, "cannot compare tuple values");
    }
    if isListKind(left.kind) {
        failAt(source, at, prefix, "cannot compare list values");
    }
    if left.kind == "Int" {
        if left.constant and right.constant {
            value := compareIntegers(operator, left.intValue, right.intValue);
            boolParsed(boolLiteralCode(value), value, true, right.next)
        } else {
            boolParsed(comparisonCode(operator, left.kind, left.code, right.code), false, false, right.next)
        }
    } else {
        if operator =!= "==" and operator =!= "=!=" {
            failAt(source, at, prefix, "operator " + operator + " requires Int operands");
        }
        if left.constant and right.constant {
            value := if left.kind == "String" {
                compareTexts(operator, left.textValue, right.textValue)
            } else {
                compareBools(operator, left.intValue =!= 0, right.intValue =!= 0)
            };
            boolParsed(boolLiteralCode(value), value, true, right.next)
        } else {
            boolParsed(comparisonCode(operator, left.kind, left.code, right.code), false, false, right.next)
        }
    }
}

/** Parses a signed decimal literal, allowing whitespace after the sign. Returns target code, checked value and next position; exits 2 on malformed or out-of-range input. */
parseInteger := fn(source: String, position: Int, prefix: String): Parsed {
    var cursor := position;
    var negative := false;
    ch := textAt(source, cursor);
    if ch == "+" or ch == "-" {
        negative = ch == "-";
        cursor = skipTrivia(source, cursor + 1, prefix);
    }
    start := cursor;
    var magnitude := 0;
    loop cursor < textLength(source) and isDigit(textAt(source, cursor)) {
        digit := digitValue(textAt(source, cursor));
        if magnitude < (-9223372036854775808 + digit) / 10 {
            failAt(source, position, prefix, "integer literal outside signed 64-bit range");
        }
        magnitude = magnitude * 10 - digit;
        cursor = cursor + 1;
    }
    if start == cursor {
        failAt(source, position, prefix, "expected a decimal integer literal");
    }
    if not negative and magnitude == -9223372036854775808 {
        failAt(source, position, prefix, "integer literal outside signed 64-bit range");
    }
    value := if negative { magnitude } else { 0 - magnitude };
    raw := textSlice(source, start, cursor);
    var digitStart := 0;
    loop digitStart + 1 < textLength(raw) and textAt(raw, digitStart) == "0" {
        digitStart = digitStart + 1;
    }
    digits := textSlice(raw, digitStart, textLength(raw));
    code := intLiteralCode(value, negative, digits);
    intParsed(code, value, true, cursor)
}

/** Parses one double-quoted literal with n/t/r/quote/backslash escapes. Returns escaped target code, text value and next position; exits 2 on malformed input. */
parseText := fn(source: String, position: Int, prefix: String): Parsed {
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= textLength(source) {
            failAt(source, position, prefix, "unterminated string literal");
        }
        ch := textAt(source, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            break;
        }
        if ch == "\\" {
            escapeStart := cursor;
            cursor = cursor + 1;
            if cursor >= textLength(source) {
                failAt(source, escapeStart, prefix, "unterminated string escape");
            }
            escaped := textAt(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                failAt(source, escapeStart, prefix, "unsupported string escape \\" + escaped);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    textParsed(textLiteralCode(value), value, true, cursor)
}

/** Returns the position after one string literal, or the source end when it does not close; alias collection leaves lexical diagnostics to the main pass. */
skipAliasString := fn(source: String, position: Int): Int {
    size := textLength(source);
    var cursor := position + 1;
    loop cursor < size {
        ch := textAt(source, cursor);
        if ch == "\\" {
            cursor = cursor + 2;
        } else if ch == "\"" {
            return cursor + 1;
        } else {
            cursor = cursor + 1;
        }
    }
    size
}

/** Reads one raw alias target type from `position`, capturing a parenthesized tuple type or a generic `List<...>` application through its matching close, or a single name. */
collectTypeTarget := fn(source: String, position: Int, prefix: String): (text: String, next: Int) {
    size := textLength(source);
    start := skipTrivia(source, position, prefix);
    if start < size and textAt(source, start) == "(" {
        var cursor := start;
        var depth := 0;
        loop cursor < size {
            ch := textAt(source, cursor);
            if ch == "\"" {
                cursor = skipAliasString(source, cursor);
            } else if startsWithAt(source, cursor, "/*") {
                cursor = skipComment(source, cursor, prefix);
            } else if ch == "(" {
                depth = depth + 1;
                cursor = cursor + 1;
            } else if ch == ")" {
                depth = depth - 1;
                cursor = cursor + 1;
                if depth == 0 {
                    return (text = textSlice(source, start, cursor), next = cursor);
                }
            } else {
                cursor = cursor + 1;
            }
        }
        (text = textSlice(source, start, size), next = size)
    } else {
        after := skipName(source, start);
        afterName := skipTrivia(source, after, prefix);
        if afterName < size and textAt(source, afterName) == "<" {
            var cursor := afterName;
            var depth := 0;
            loop cursor < size {
                ch := textAt(source, cursor);
                if startsWithAt(source, cursor, "/*") {
                    cursor = skipComment(source, cursor, prefix);
                } else if ch == "<" {
                    depth = depth + 1;
                    cursor = cursor + 1;
                } else if ch == ">" {
                    depth = depth - 1;
                    cursor = cursor + 1;
                    if depth == 0 {
                        return (text = textSlice(source, start, cursor), next = cursor);
                    }
                } else {
                    cursor = cursor + 1;
                }
            }
            (text = textSlice(source, start, size), next = size)
        } else {
            (text = textSlice(source, start, after), next = after)
        }
    }
}

/** Collects top-level `Name := type Target;` declarations before parsing so aliases may reference later aliases and cycles can be reported. */
collectAliases := fn(source: String, prefix: String): List<AliasDecl> {
    aliases: mut List<AliasDecl> = [];
    size := textLength(source);
    var position := 0;
    var depth := 0;
    loop position < size {
        position = skipTrivia(source, position, prefix);
        if position >= size { break; }
        ch := textAt(source, position);
        if ch == "\"" {
            position = skipAliasString(source, position);
        } else if ch == "{" {
            depth = depth + 1;
            position = position + 1;
        } else if ch == "}" {
            if depth > 0 { depth = depth - 1; }
            position = position + 1;
        } else if depth == 0 and isNameStart(ch) {
            nameStart := position;
            afterName := skipName(source, position);
            name := textSlice(source, nameStart, afterName);
            aliasPosition := skipTrivia(source, afterName, prefix);
            if startsWithAt(source, aliasPosition, ":=") {
                typePosition := skipTrivia(source, aliasPosition + 2, prefix);
                if wordAt(source, typePosition, "type") {
                    targetStart := skipTrivia(source, typePosition + 4, prefix);
                    target := collectTypeTarget(source, targetStart, prefix);
                    push_back(mut aliases, (name = name, target = target.text, at = nameStart, end = target.next));
                    position = target.next;
                    continue;
                }
            }
            position = afterName;
        } else {
            position = position + 1;
        }
    }
    aliases
}

/** True when the text after an opening `(` starts a named tuple entry `label = ...`, rather than grouping. */
looksLikeTupleEntry := fn(source: String, position: Int, prefix: String): Bool {
    start := skipTrivia(source, position, prefix);
    if start >= textLength(source) or not isNameStart(textAt(source, start)) { return false; }
    afterName := skipTrivia(source, skipName(source, start), prefix);
    if afterName >= textLength(source) or textAt(source, afterName) =!= "=" { return false; }
    not startsWithAt(source, afterName, "==")
}

/** Wraps target code in the backend's list-copy hook when `kind` is a List; every other kind is unchanged. */
copiedValueCode := fn(kind: String, code: String): String {
    if isListKind(kind) { listCopyCode(code) } else { code }
}

/** True for the zero-argument or checked I/O and text builtins this compiler admits. */
isAdmittedBuiltin := fn(name: String): Bool {
    name == "inputArgs" or name == "inputAll" or name == "reportError" or name == "exit" or
    name == "textLength" or name == "textAt" or name == "textSlice"
}

/** Number of positional arguments one admitted builtin requires. */
builtinArity := fn(name: String): Int {
    if name == "inputArgs" or name == "inputAll" { 0 }
    else if name == "textAt" { 2 }
    else if name == "textSlice" { 3 }
    else { 1 }
}

/** Required kind of argument `index` for one admitted builtin. */
builtinParameterKind := fn(name: String, index: Int): String {
    if name == "reportError" or name == "textLength" { "String" }
    else if name == "textAt" or name == "textSlice" {
        if index == 0 { "String" } else { "Int" }
    } else { "Int" }
}

/** Result kind of one admitted builtin. */
builtinResultKind := fn(name: String): String {
    if name == "inputArgs" { "List<String>" }
    else if name == "inputAll" or name == "textAt" or name == "textSlice" { "String" }
    else if name == "textLength" { "Int" }
    else { "Unit" }
}

/** Parses the `mut name` grant after one list end-operation opener, rejecting a missing grant, a non-list target and a binding without writable held data. */
parseListGrant := fn(source: String, open: Int, prefix: String, locals: List<Local>, operation: String): (runtime: String, kind: String, next: Int) {
    var cursor := skipTrivia(source, open + 1, prefix);
    if not wordAt(source, cursor, "mut") {
        failAt(source, cursor, prefix, operation + " requires mut list argument");
    }
    cursor = skipTrivia(source, cursor + 3, prefix);
    if cursor >= textLength(source) or not isNameStart(textAt(source, cursor)) {
        failAt(source, cursor, prefix, "expected a list name after mut");
    }
    nameEnd := skipName(source, cursor);
    listName := textSlice(source, cursor, nameEnd);
    index := localIndex(locals, listName);
    if index < 0 {
        failAt(source, cursor, prefix, "unknown value " + listName);
        return (runtime = "", kind = "", next = nameEnd);
    }
    entry := locals[index];
    if not isListKind(entry.kind) {
        failAt(source, cursor, prefix, operation + " requires a List value, got " + displayKind(entry.kind));
    }
    if not entry.writable {
        failAt(source, cursor, prefix, "cannot mutate list " + listName + " without mut");
    }
    (runtime = entry.runtime, kind = entry.kind, next = nameEnd)
}

/** Precedence-climbing parser for arithmetic, comparisons, `and`/`or`, parentheses, named tuple and list values, field access, indexing, calls, unary signs and `not`. Folds constants, lowers dynamic Int arithmetic, and exits 2 on mixed types, unsupported dynamic operations or range faults. `expected` supplies a contextual kind for empty list literals. self(..., 30) parses a unary operand without binary operators. */
parseBinary := fn(source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String, minimum: Int): Parsed {
    start := skipTrivia(source, position, prefix);
    if start >= textLength(source) {
        failAt(source, start, prefix, "expected an Int, String or Bool expression");
    }
    var left := intParsed("", 0, true, start);
    ch := textAt(source, start);
    if ch == "(" {
        if looksLikeTupleEntry(source, start + 1, prefix) {
            var cursor := skipTrivia(source, start + 1, prefix);
            labels: mut List<String> = [];
            codes: mut List<String> = [];
            kinds: mut List<String> = [];
            var count := 0;
            loop true {
                if cursor >= textLength(source) or not isNameStart(textAt(source, cursor)) {
                    failAt(source, cursor, prefix, "expected a tuple field name");
                }
                labelStart := cursor;
                cursor = skipName(source, cursor);
                label := textSlice(source, labelStart, cursor);
                if isReservedWord(label) { unsupportedFeature(source, labelStart, label, prefix); }
                if listContainsText(labels, label) {
                    failAt(source, labelStart, prefix, "duplicate tuple field " + label);
                }
                push_back(mut labels, label);
                cursor = skipTrivia(source, cursor, prefix);
                if cursor >= textLength(source) or textAt(source, cursor) =!= "=" or startsWithAt(source, cursor, "==") {
                    failAt(source, cursor, prefix, "expected = after tuple field " + label);
                }
                cursor = skipTrivia(source, cursor + 1, prefix);
                value := self(source, cursor, prefix, locals, functions, params, currentName, "", 0);
                if isTupleKind(value.kind) {
                    failAt(source, cursor, prefix, "nested tuple values are not supported");
                }
                if isListKind(value.kind) {
                    failAt(source, cursor, prefix, "list values inside tuples are not supported");
                }
                if value.kind == "Unit" {
                    failAt(source, cursor, prefix, "tuple field " + label + " cannot be Unit");
                }
                push_back(mut codes, value.code);
                push_back(mut kinds, value.kind);
                count = count + 1;
                cursor = skipTrivia(source, value.next, prefix);
                if cursor < textLength(source) and textAt(source, cursor) == "," {
                    cursor = skipTrivia(source, cursor + 1, prefix);
                } else {
                    break;
                }
            }
            cursor = expectSymbol(source, cursor, ")", prefix);
            var kindText := "(";
            var codeText := "{ ";
            var index := 0;
            loop index < count {
                if index > 0 {
                    kindText = kindText + ",";
                    codeText = codeText + ", ";
                }
                kindText = kindText + labels[index] + ":" + kinds[index];
                codeText = codeText + labels[index] + ": " + codes[index];
                index = index + 1;
            }
            left = (kind = kindText + ")", code = codeText + " }", intValue = 0, textValue = "", constant = false, next = cursor);
        } else {
            inner := self(source, start + 1, prefix, locals, functions, params, currentName, expected, 0);
            next := expectSymbol(source, skipTrivia(source, inner.next, prefix), ")", prefix);
            left = (kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, constant = inner.constant, next = next);
        }
    } else if ch == "+" or ch == "-" {
        after := skipTrivia(source, start + 1, prefix);
        if after < textLength(source) and isDigit(textAt(source, after)) {
            left = parseInteger(source, start, prefix);
        } else {
            operand := self(source, start + 1, prefix, locals, functions, params, currentName, "", 30);
            if operand.kind =!= "Int" {
                failAt(source, start, prefix, "unary " + ch + " requires an Int operand");
            }
            code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
            if operand.constant {
                value := if ch == "-" { negateInteger(source, start, operand.intValue, prefix) } else { operand.intValue };
                left = intParsed(code, value, true, operand.next);
            } else {
                left = intParsed(code, 0, false, operand.next);
            }
        }
    } else if isDigit(ch) {
        left = parseInteger(source, start, prefix);
    } else if ch == "\"" {
        left = parseText(source, start, prefix);
    } else if ch == "[" {
        var cursor := skipTrivia(source, start + 1, prefix);
        var elementKind := "";
        if isListKind(expected) { elementKind = listElementKind(expected); }
        elementCodes: mut List<String> = [];
        var count := 0;
        loop true {
            if cursor >= textLength(source) {
                failAt(source, cursor, prefix, "expected ] in list literal");
            }
            if textAt(source, cursor) == "]" { break; }
            elementStart := cursor;
            element := self(source, cursor, prefix, locals, functions, params, currentName, elementKind, 0);
            if element.kind == "Unit" {
                failAt(source, elementStart, prefix, "list element " + decimalText(count + 1) + " cannot be Unit");
            }
            if isListKind(element.kind) {
                failAt(source, elementStart, prefix, "nested list types are not supported");
            }
            if elementKind == "" {
                elementKind = element.kind;
            } else if element.kind =!= elementKind {
                failAt(source, elementStart, prefix, "list element " + decimalText(count + 1) + " must be " +
                    displayKind(elementKind) + ", got " + displayKind(element.kind));
            }
            push_back(mut elementCodes, element.code);
            count = count + 1;
            cursor = skipTrivia(source, element.next, prefix);
            if cursor < textLength(source) and textAt(source, cursor) == "," {
                cursor = skipTrivia(source, cursor + 1, prefix);
            } else {
                break;
            }
        }
        cursor = expectSymbol(source, cursor, "]", prefix);
        if count == 0 and elementKind == "" {
            failAt(source, start, prefix, "empty list literal requires a List element type");
        }
        left = (kind = "List<" + elementKind + ">", code = "[" + joinTexts(elementCodes, ", ") + "]",
            intValue = 0, textValue = "", constant = false, next = cursor);
    } else if isNameStart(ch) {
        nameStart := start;
        next := skipName(source, start);
        name := textSlice(source, nameStart, next);
        if name == "true" {
            left = boolParsed(boolLiteralCode(true), true, true, next);
        } else if name == "false" {
            left = boolParsed(boolLiteralCode(false), false, true, next);
        } else if name == "not" {
            operand := self(source, next, prefix, locals, functions, params, currentName, "", 5);
            if operand.kind =!= "Bool" {
                failAt(source, nameStart, prefix, "not requires a Bool operand");
            }
            if operand.constant {
                value := operand.intValue == 0;
                left = boolParsed(boolLiteralCode(value), value, true, operand.next);
            } else {
                left = boolParsed(notCode(operand.code), false, false, operand.next);
            }
        } else if name == "if" {
            var cursor := skipTrivia(source, next, prefix);
            conditionStart := cursor;
            condition := self(source, cursor, prefix, locals, functions, params, currentName, "", 0);
            if condition.kind =!= "Bool" {
                failAt(source, conditionStart, prefix, "if condition must be Bool");
            }
            conditionCode := if condition.constant {
                boolLiteralCode(condition.intValue =!= 0)
            } else {
                condition.code
            };
            cursor = expectSymbol(source, skipTrivia(source, condition.next, prefix), "{", prefix);
            branchStart := skipTrivia(source, cursor + 1, prefix);
            first := self(source, branchStart, prefix, locals, functions, params, currentName, expected, 0);
            cursor = expectSymbol(source, skipTrivia(source, first.next, prefix), "}", prefix);
            conditionCodes: mut List<String> = [];
            branchCodes: mut List<String> = [];
            push_back(mut conditionCodes, conditionCode);
            push_back(mut branchCodes, first.code);
            var resultKind := first.kind;
            var branchCount := 1;
            loop true {
                afterBranch := skipTrivia(source, cursor, prefix);
                if not wordAt(source, afterBranch, "else") {
                    failAt(source, afterBranch, prefix, "value if requires a final else");
                }
                afterElse := skipTrivia(source, afterBranch + 4, prefix);
                if wordAt(source, afterElse, "if") {
                    elseConditionStart := skipTrivia(source, afterElse + 2, prefix);
                    elseCondition := self(source, elseConditionStart, prefix, locals, functions, params, currentName, "", 0);
                    if elseCondition.kind =!= "Bool" {
                        failAt(source, elseConditionStart, prefix, "if condition must be Bool");
                    }
                    elseConditionCode := if elseCondition.constant {
                        boolLiteralCode(elseCondition.intValue =!= 0)
                    } else {
                        elseCondition.code
                    };
                    open := expectSymbol(source, skipTrivia(source, elseCondition.next, prefix), "{", prefix);
                    elseBranchStart := skipTrivia(source, open + 1, prefix);
                    branch := self(source, elseBranchStart, prefix, locals, functions, params, currentName, expected, 0);
                    if branch.kind =!= resultKind {
                        failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                            displayKind(resultKind) + " and " + displayKind(branch.kind));
                    }
                    cursor = expectSymbol(source, skipTrivia(source, branch.next, prefix), "}", prefix);
                    push_back(mut conditionCodes, elseConditionCode);
                    push_back(mut branchCodes, branch.code);
                    branchCount = branchCount + 1;
                } else {
                    open := expectSymbol(source, afterElse, "{", prefix);
                    elseBranchStart := skipTrivia(source, open + 1, prefix);
                    branch := self(source, elseBranchStart, prefix, locals, functions, params, currentName, expected, 0);
                    if branch.kind =!= resultKind {
                        failAt(source, elseBranchStart, prefix, "value if branches must have the same kind, got " +
                            displayKind(resultKind) + " and " + displayKind(branch.kind));
                    }
                    cursor = expectSymbol(source, skipTrivia(source, branch.next, prefix), "}", prefix);
                    push_back(mut branchCodes, branch.code);
                    branchCount = branchCount + 1;
                    break;
                }
            }
            var code := branchCodes[branchCount - 1];
            var index := branchCount - 2;
            loop index >= 0 {
                code = "(Boolean(" + conditionCodes[index] + ") ? " + branchCodes[index] + " : " + code + ")";
                index = index - 1;
            }
            left = (kind = resultKind, code = code, intValue = 0, textValue = "", constant = false, next = cursor);
        } else {
            if isReservedWord(name) { unsupportedFeature(source, nameStart, name, prefix); }
            afterName := skipTrivia(source, next, prefix);
            var callableIndex := findFunction(functions, name);
            var calleeName := name;
            if name == "self" {
                if currentName == "" {
                    failAt(source, nameStart, prefix, "self is only available inside a function");
                }
                calleeName = currentName;
                callableIndex = findFunction(functions, currentName);
            }
            if callableIndex >= 0 and afterName < textLength(source) and textAt(source, afterName) == "(" {
                info := functions[callableIndex];
                var cursor := skipTrivia(source, afterName + 1, prefix);
                argumentCodes: mut List<String> = [];
                var argumentCount := 0;
                if cursor < textLength(source) and textAt(source, cursor) =!= ")" {
                    loop true {
                        if argumentCount >= info.count {
                            suffix := if info.count == 1 { " argument" } else { " arguments" };
                            failAt(source, nameStart, prefix, "function " + calleeName + " expects " + decimalText(info.count) + suffix + ", got more");
                        }
                        expected := paramKindOf(params[info.first + argumentCount]);
                        argument := self(source, cursor, prefix, locals, functions, params, currentName, expected, 0);
                        if argument.kind =!= expected {
                            failAt(source, cursor, prefix, "argument " + decimalText(argumentCount + 1) + " of " +
                                calleeName + " must be " + displayKind(expected) + ", got " + displayKind(argument.kind));
                        }
                        push_back(mut argumentCodes, copiedValueCode(argument.kind, argument.code));
                        argumentCount = argumentCount + 1;
                        cursor = skipTrivia(source, argument.next, prefix);
                        if cursor < textLength(source) and textAt(source, cursor) == "," {
                            cursor = skipTrivia(source, cursor + 1, prefix);
                        } else {
                            break;
                        }
                    }
                }
                cursor = expectSymbol(source, cursor, ")", prefix);
                if argumentCount =!= info.count {
                    suffix := if info.count == 1 { " argument" } else { " arguments" };
                    failAt(source, nameStart, prefix, "function " + calleeName + " expects " + decimalText(info.count) +
                        suffix + ", got " + decimalText(argumentCount));
                }
                left = (kind = info.result, code = "liteFn_" + calleeName + "(" + joinTexts(argumentCodes, ", ") + ")",
                    intValue = 0, textValue = "", constant = false, next = cursor);
            } else if callableIndex >= 0 {
                failAt(source, nameStart, prefix, "function " + calleeName + " must be called");
            } else if isAdmittedBuiltin(name) {
                if afterName >= textLength(source) or textAt(source, afterName) =!= "(" {
                    failAt(source, nameStart, prefix, name + " must be called");
                }
                var builtinCursor := skipTrivia(source, afterName + 1, prefix);
                builtinArityCount := builtinArity(name);
                builtinCodes: mut List<String> = [];
                var builtinCount := 0;
                if builtinArityCount == 0 {
                    if builtinCursor < textLength(source) and textAt(source, builtinCursor) =!= ")" {
                        failAt(source, nameStart, prefix, name + " expects no arguments");
                    }
                } else {
                    if builtinCursor < textLength(source) and textAt(source, builtinCursor) =!= ")" {
                        loop true {
                            if builtinCount >= builtinArityCount {
                                suffix := if builtinArityCount == 1 { " argument" } else { " arguments" };
                                failAt(source, nameStart, prefix, name + " expects " + decimalText(builtinArityCount) +
                                    suffix + ", got more");
                            }
                            builtinExpected := builtinParameterKind(name, builtinCount);
                            builtinStart := builtinCursor;
                            builtinValue := self(source, builtinCursor, prefix, locals, functions, params, currentName, builtinExpected, 0);
                            if builtinValue.kind =!= builtinExpected {
                                failAt(source, builtinStart, prefix, "argument " + decimalText(builtinCount + 1) + " of " +
                                    name + " must be " + displayKind(builtinExpected) + ", got " + displayKind(builtinValue.kind));
                            }
                            push_back(mut builtinCodes, builtinValue.code);
                            builtinCount = builtinCount + 1;
                            builtinCursor = skipTrivia(source, builtinValue.next, prefix);
                            if builtinCursor < textLength(source) and textAt(source, builtinCursor) == "," {
                                builtinCursor = skipTrivia(source, builtinCursor + 1, prefix);
                            } else {
                                break;
                            }
                        }
                    }
                }
                builtinCursor = expectSymbol(source, builtinCursor, ")", prefix);
                if builtinCount =!= builtinArityCount {
                    suffix := if builtinArityCount == 1 { " argument" } else { " arguments" };
                    failAt(source, nameStart, prefix, name + " expects " + decimalText(builtinArityCount) + suffix +
                        ", got " + decimalText(builtinCount));
                }
                left = (kind = builtinResultKind(name), code = "lite$" + name + "(" + joinTexts(builtinCodes, ", ") + ")",
                    intValue = 0, textValue = "", constant = false, next = builtinCursor);
            } else if name == "push_back" and afterName < textLength(source) and textAt(source, afterName) == "(" {
                grant := parseListGrant(source, afterName, prefix, locals, "push_back");
                var cursor := skipTrivia(source, grant.next, prefix);
                if cursor >= textLength(source) or textAt(source, cursor) =!= "," {
                    failAt(source, cursor, prefix, "push_back expects a value after the mut list");
                }
                valueStart := skipTrivia(source, cursor + 1, prefix);
                elementKind := listElementKind(grant.kind);
                value := self(source, valueStart, prefix, locals, functions, params, currentName, elementKind, 0);
                if value.kind =!= elementKind {
                    failAt(source, valueStart, prefix, "push_back element must be " + displayKind(elementKind) +
                        ", got " + displayKind(value.kind));
                }
                close := expectSymbol(source, skipTrivia(source, value.next, prefix), ")", prefix);
                left = (kind = "Unit", code = grant.runtime + ".push(" + value.code + ")",
                    intValue = 0, textValue = "", constant = false, next = close);
            } else if name == "pop_back" and afterName < textLength(source) and textAt(source, afterName) == "(" {
                grant := parseListGrant(source, afterName, prefix, locals, "pop_back");
                close := expectSymbol(source, skipTrivia(source, grant.next, prefix), ")", prefix);
                left = (kind = listElementKind(grant.kind), code = "lite$listPopBack(" + grant.runtime + ")",
                    intValue = 0, textValue = "", constant = false, next = close);
            } else {
                index := localIndex(locals, name);
                if index < 0 {
                    failAt(source, nameStart, prefix, "unknown value " + name);
                }
                entry := locals[index];
                left = (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, constant = entry.constant, next = next);
            }
        }
    } else {
        failAt(source, start, prefix, "expected an Int, String or Bool expression");
    }
    loop true {
        postPosition := skipTrivia(source, left.next, prefix);
        if postPosition < textLength(source) and textAt(source, postPosition) == "." {
            labelStart := skipTrivia(source, postPosition + 1, prefix);
            if labelStart >= textLength(source) or not isNameStart(textAt(source, labelStart)) {
                break;
            }
            if not isTupleKind(left.kind) {
                failAt(source, postPosition, prefix, "field access requires a tuple value");
            }
            labelEnd := skipName(source, labelStart);
            label := textSlice(source, labelStart, labelEnd);
            fieldKind := tupleFieldKind(left.kind, label);
            if fieldKind == "" {
                failAt(source, labelStart, prefix, "tuple has no field " + label);
            }
            left = (kind = fieldKind, code = "(" + left.code + ")." + label, intValue = 0, textValue = "", constant = false, next = labelEnd);
        } else if postPosition < textLength(source) and textAt(source, postPosition) == "[" {
            if not isListKind(left.kind) {
                failAt(source, postPosition, prefix, "indexing requires a list value");
            }
            indexStart := skipTrivia(source, postPosition + 1, prefix);
            index := self(source, indexStart, prefix, locals, functions, params, currentName, "", 0);
            if index.kind =!= "Int" {
                failAt(source, indexStart, prefix, "list index must be Int, got " + displayKind(index.kind));
            }
            close := skipTrivia(source, index.next, prefix);
            next := expectSymbol(source, close, "]", prefix);
            left = (kind = listElementKind(left.kind),
                code = "lite$listAt((" + left.code + "), " + index.code + ")",
                intValue = 0, textValue = "", constant = false, next = next);
        } else {
            break;
        }
    }
    loop true {
        operatorPosition := skipTrivia(source, left.next, prefix);
        if operatorPosition >= textLength(source) { break; }
        operator := readOperator(source, operatorPosition);
        if operator.text == "" { break; }
        level := operatorLevel(operator.text);
        if level < minimum { break; }
        right := self(source, operatorPosition + operator.width, prefix, locals, functions, params, currentName, "", level + 1);
        if operator.text == "and" or operator.text == "or" {
            if left.kind =!= "Bool" or right.kind =!= "Bool" {
                failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Bool operands");
            }
            if left.constant and right.constant {
                value := if operator.text == "and" {
                    left.intValue =!= 0 and right.intValue =!= 0
                } else {
                    left.intValue =!= 0 or right.intValue =!= 0
                };
                left = boolParsed(boolLiteralCode(value), value, true, right.next);
            } else {
                left = boolParsed(logicCode(operator.text, left.code, right.code), false, false, right.next);
            }
        } else if isComparison(operator.text) {
            left = compareParsed(source, operatorPosition, operator.text, left, right, prefix);
        } else if left.kind == "Int" and right.kind == "Int" {
            if left.constant and right.constant {
                folded := if operator.text == "+" { addIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else if operator.text == "-" { subtractIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else if operator.text == "*" { multiplyIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else if operator.text == "%" { remainderIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else if operator.text == ":/" { floorDivideIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else if operator.text == ":%" { floorModuloIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) }
                    else { divideIntegers(source, operatorPosition, left.intValue, right.intValue, prefix) };
                code := if operator.text == ":/" { floorDivCode(left.code, right.code) }
                    else if operator.text == ":%" { floorModCode(left.code, right.code) }
                    else { "(" + left.code + " " + operator.text + " " + right.code + ")" };
                left = intParsed(code, folded, true, right.next);
            } else if operator.text == "/" {
                left = intParsed(intDivideCode(left.code, right.code), 0, false, right.next);
            } else if operator.text == "%" {
                left = intParsed(intRemainderCode(left.code, right.code), 0, false, right.next);
            } else if operator.text == ":/" {
                left = intParsed(intFloorDivideCode(left.code, right.code), 0, false, right.next);
            } else if operator.text == ":%" {
                left = intParsed(intFloorModuloCode(left.code, right.code), 0, false, right.next);
            } else {
                left = intParsed("(" + left.code + " " + operator.text + " " + right.code + ")", 0, false, right.next);
            }
        } else if operator.text == "+" and left.kind == "String" and right.kind == "String" {
            if left.constant and right.constant {
                combined := left.textValue + right.textValue;
                left = textParsed(textLiteralCode(combined), combined, true, right.next);
            } else {
                left = textParsed(concatCode(left.code, right.code), "", false, right.next);
            }
        } else if isListKind(left.kind) or isListKind(right.kind) {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " is not supported for list values");
        } else if operator.text == "+" {
            failAt(source, operatorPosition, prefix, "cannot mix Int and String operands");
        } else {
            failAt(source, operatorPosition, prefix, "operator " + operator.text + " requires Int operands");
        }
    }
    left
}

/** Parses one complete expression at the lowest precedence with an optional contextual kind for empty list literals. */
parseExpressionAs := fn(source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String, expected: String): Parsed {
    parseBinary(source, position, prefix, locals, functions, params, currentName, expected, 0)
}

/** Parses one complete expression at the lowest precedence without a contextual kind. */
parseExpression := fn(source: String, position: Int, prefix: String, locals: List<Local>, functions: List<FunctionInfo>, params: List<String>, currentName: String): Parsed {
    parseBinary(source, position, prefix, locals, functions, params, currentName, "", 0)
}

/** Reads the optional logical source name from inputArgs. Returns the name without a separator, or empty text; exits 2 for more than one argument. */
sourcePrefix := fn(): String {
    var prefix := "";
    var argumentCountValue := 0;
    loop inputArgs() as argument {
        if argumentCountValue == 0 { prefix = argument; }
        argumentCountValue = argumentCountValue + 1;
    }
    if argumentCountValue > 1 {
        reportError("expected at most one logical source name argument");
        exit(2);
    }
    prefix
}

/** Parses one local type annotation: an optional `mut` list grant, then a scalar, a transparent alias or a flat named tuple; Unit has no local zero value. */
parseLocalType := fn(source: String, position: Int, prefix: String, aliases: List<AliasDecl>): (kind: String, writable: Bool, next: Int) {
    start := skipTrivia(source, position, prefix);
    var cursor := start;
    var writable := false;
    if wordAt(source, cursor, "mut") {
        writable = true;
        cursor = skipTrivia(source, cursor + 3, prefix);
    }
    typed := parseTypeAt(source, cursor, prefix, aliases, "local");
    if typed.kind == "Unit" {
        name := textSlice(source, cursor, skipName(source, cursor));
        failAt(source, cursor, prefix, "unsupported local type " + name);
    }
    if writable and not isListKind(typed.kind) {
        failAt(source, start, prefix, "mut requires a List type, got " + displayKind(typed.kind));
    }
    (kind = typed.kind, writable = writable, next = typed.next)
}

/** Builds the zero value for one flat named-tuple kind as a fresh object literal. */
tupleZeroParsed := fn(kind: String, next: Int): Parsed {
    size := textLength(kind);
    var cursor := 1;
    var code := "{ ";
    var count := 0;
    loop cursor < size and textAt(kind, cursor) =!= ")" {
        nameStart := cursor;
        cursor = skipName(kind, cursor);
        label := textSlice(kind, nameStart, cursor);
        if cursor < size and textAt(kind, cursor) == ":" { cursor = cursor + 1; }
        typeStart := cursor;
        cursor = skipName(kind, cursor);
        fieldKind := textSlice(kind, typeStart, cursor);
        if count > 0 { code = code + ", "; }
        code = code + label + ": ";
        if fieldKind == "Int" { code = code + "0n"; }
        else if fieldKind == "String" { code = code + "\"\""; }
        else { code = code + "false"; }
        count = count + 1;
        if cursor < size and textAt(kind, cursor) == "," { cursor = cursor + 1; }
    }
    (kind = kind, code = code + " }", intValue = 0, textValue = "", constant = false, next = next)
}

/** Builds the zero value for one supported local type, including a fresh flat named-tuple object and an empty list. */
zeroParsed := fn(kind: String, next: Int): Parsed {
    if isTupleKind(kind) { tupleZeroParsed(kind, next) }
    else if isListKind(kind) { (kind = kind, code = "[]", intValue = 0, textValue = "", constant = false, next = next) }
    else if kind == "Int" { intParsed(intLiteralCode(0, false, "0"), 0, true, next) }
    else if kind == "String" { textParsed(textLiteralCode(""), "", true, next) }
    else { boolParsed(boolLiteralCode(false), false, true, next) }
}

/** Collapses a tuple or list kind to its `Tuple`/`List` item suffix while leaving scalar item kinds unchanged. */
storageKind := fn(kind: String): String {
    if isListKind(kind) { "List" }
    else if isTupleKind(kind) { "Tuple" }
    else { kind }
}

/** Returns the text payload stored with one local item: the canonical List kind for List items, otherwise the parsed literal text. */
itemTextPayload := fn(parsed: Parsed): String {
    if isListKind(parsed.kind) { parsed.kind } else { parsed.textValue }
}

/** Returns the position after the braced block starting at `open`, or -1 when it never closes. Strings and comments are skipped. */
scanBraceEnd := fn(source: String, open: Int, prefix: String): Int {
    size := textLength(source);
    var cursor := open;
    var depth := 0;
    loop cursor < size {
        ch := textAt(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "{" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == "}" {
            depth = depth - 1;
            cursor = cursor + 1;
            if depth == 0 { return cursor; }
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** Returns the position of the `{` that opens the branch after the condition starting at `start`, or -1 when absent. */
scanConditionOpen := fn(source: String, start: Int, prefix: String): Int {
    size := textLength(source);
    var cursor := start;
    var depth := 0;
    loop cursor < size {
        ch := textAt(source, cursor);
        if ch == "\"" {
            cursor = skipAliasString(source, cursor);
        } else if startsWithAt(source, cursor, "/*") {
            cursor = skipComment(source, cursor, prefix);
        } else if ch == "(" or ch == "[" {
            depth = depth + 1;
            cursor = cursor + 1;
        } else if ch == ")" or ch == "]" {
            if depth > 0 { depth = depth - 1; }
            cursor = cursor + 1;
        } else if ch == "{" and depth == 0 {
            return cursor;
        } else {
            cursor = cursor + 1;
        }
    }
    -1
}

/** True when the braced body from `open` to `close` is a nonempty single expression: no semicolon and no statement keyword first. */
valueIfBranchAt := fn(source: String, open: Int, close: Int, prefix: String): Bool {
    var cursor := skipTrivia(source, open + 1, prefix);
    if cursor >= close { return false; }
    if isNameStart(textAt(source, cursor)) {
        word := textSlice(source, cursor, skipName(source, cursor));
        if word == "return" or word == "report" or word == "var" or word == "loop" or
            word == "break" or word == "continue" or word == "else" or word == "fn" {
            return false;
        }
    }
    var scan := cursor;
    loop scan < close {
        ch := textAt(source, scan);
        if ch == "\"" {
            scan = skipAliasString(source, scan);
        } else if startsWithAt(source, scan, "/*") {
            scan = skipComment(source, scan, prefix);
        } else if ch == ";" {
            return false;
        } else {
            scan = scan + 1;
        }
    }
    true
}

/** Returns the position after one complete value-if chain starting at `position`, or -1 when it lacks a final else or has statement-shaped branches. */
scanValueIfEnd := fn(source: String, position: Int, prefix: String): Int {
    size := textLength(source);
    var cursor := skipTrivia(source, position, prefix);
    if not wordAt(source, cursor, "if") { return -1; }
    cursor = skipTrivia(source, cursor + 2, prefix);
    loop true {
        open := scanConditionOpen(source, cursor, prefix);
        if open < 0 { return -1; }
        end := scanBraceEnd(source, open, prefix);
        if end < 0 { return -1; }
        if not valueIfBranchAt(source, open, end - 1, prefix) { return -1; }
        after := skipTrivia(source, end, prefix);
        if not wordAt(source, after, "else") { return -1; }
        afterElse := skipTrivia(source, after + 4, prefix);
        if wordAt(source, afterElse, "if") {
            cursor = skipTrivia(source, afterElse + 2, prefix);
        } else {
            if afterElse >= size or textAt(source, afterElse) =!= "{" { return -1; }
            finalEnd := scanBraceEnd(source, afterElse, prefix);
            if finalEnd < 0 { return -1; }
            if not valueIfBranchAt(source, afterElse, finalEnd - 1, prefix) { return -1; }
            return finalEnd;
        }
    }
    -1
}

/** True when `blocks` contains an enclosing loop body, so a bare break or continue has a nearest loop to target. */
insideLoop := fn(blocks: List<String>): Bool {
    loop blocks as kind {
        if kind == "loop" { return true; }
    }
    false
}

/** Parses complete source into a flat Items stream with an iterative block stack, dropping block-local declarations on `}`. Exits 2 on unsupported, malformed or faulting source. */
parseProgram := fn(source: String, prefix: String): Items {
    size := textLength(source);
    aliases := collectAliases(source, prefix);
    locals: mut List<Local> = [];
    items: mut Items = [];
    blocks: mut List<String> = [];
    functions: mut List<FunctionInfo> = [];
    functionParams: mut List<String> = [];
    var localCount := 0;
    var blockCount := 0;
    var depth := 0;
    var parameterTotal := 0;
    var currentName := "";
    var currentResult := "";
    var currentReturned := false;
    var seenStatement := false;
    var position := skipTrivia(source, 0, prefix);
    if position == size {
        failAt(source, position, prefix, "expected a statement: report, declaration, assignment, if or loop");
    }
    loop position < size {
        ch := textAt(source, position);
        if ch == "}" {
            if blockCount == 0 {
                failAt(source, position, prefix, "unexpected }");
            }
            blockKind := blocks[blockCount - 1];
            after := skipTrivia(source, position + 1, prefix);
            if blockKind == "if" and after < size and wordAt(source, after, "else") {
                loop localCount > 0 and locals[localCount - 1].depth >= depth {
                    droppedLocal := pop_back(mut locals);
                    localCount = localCount - 1;
                }
                push_back(mut items, (kind = "Else", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
                droppedIf := pop_back(mut blocks);
                blockCount = blockCount - 1;
                push_back(mut blocks, "else");
                blockCount = blockCount + 1;
                position = skipTrivia(source, after + 4, prefix);
                position = expectSymbol(source, position, "{", prefix);
                position = skipTrivia(source, position + 1, prefix);
                continue;
            }
            loop localCount > 0 and locals[localCount - 1].depth >= depth {
                droppedLocal := pop_back(mut locals);
                localCount = localCount - 1;
            }
            depth = depth - 1;
            if blockKind == "function" {
                if currentResult =!= "Unit" and not currentReturned {
                    failAt(source, position, prefix, "function " + currentName + " must return " + currentResult);
                }
                push_back(mut items, (kind = "FunctionEnd", name = "", runtime = "liteFn_" + currentName,
                    code = "", intValue = 0, textValue = ""));
                currentName = "";
                currentResult = "";
                currentReturned = false;
            } else if blockKind == "loop" {
                push_back(mut items, (kind = "EndLoop", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            } else {
                push_back(mut items, (kind = "EndIf", name = "", runtime = "", code = "", intValue = 0, textValue = ""));
            }
            droppedBlock := pop_back(mut blocks);
            blockCount = blockCount - 1;
            position = skipTrivia(source, position + 1, prefix);
            if position < size and textAt(source, position) == ";" {
                position = skipTrivia(source, position + 1, prefix);
            }
            continue;
        }
        if currentName =!= "" and (isDigit(ch) or ch == "\"" or ch == "(" or ch == "[" or ch == "+" or ch == "-") {
            tail := parseExpressionAs(source, position, prefix, locals, functions, functionParams, currentName, currentResult);
            afterTail := skipTrivia(source, tail.next, prefix);
            if afterTail < size and textAt(source, afterTail) == "}" and blockCount > 0 and
                blocks[blockCount - 1] == "function" {
                if currentResult == "Unit" {
                    push_back(mut items, (kind = "Return", name = "", runtime = "", code = "",
                        intValue = 0, textValue = ""));
                } else {
                    if tail.kind =!= currentResult {
                        failAt(source, position, prefix, "cannot return " + displayKind(tail.kind) + " from function " +
                            currentName + " returning " + displayKind(currentResult));
                    }
                    push_back(mut items, (kind = "Return", name = "", runtime = "", code = copiedValueCode(currentResult, tail.code),
                        intValue = 0, textValue = ""));
                }
                currentReturned = true;
                position = afterTail;
                continue;
            }
            failAt(source, afterTail, prefix, "expected ; after expression statement");
        }
        if not isNameStart(ch) {
            failAt(source, position, prefix, "expected a statement: report, declaration, assignment, if or loop");
        }
        nameStart := position;
        position = skipName(source, position);
        name := textSlice(source, nameStart, position);
        position = skipTrivia(source, position, prefix);
        var afterDefinition := position;
        if startsWithAt(source, position, ":=") {
            afterDefinition = skipTrivia(source, position + 2, prefix);
        }
        definition := blockCount == 0 and startsWithAt(source, position, ":=") and
            (wordAt(source, afterDefinition, "fn") or wordAt(source, afterDefinition, "type"));
        if blockCount == 0 and not definition { seenStatement = true; }
        if name == "return" {
            if currentName == "" {
                failAt(source, nameStart, prefix, "return outside a function");
            }
            valueStart := position;
            if valueStart < size and textAt(source, valueStart) == ";" {
                if currentResult =!= "Unit" {
                    failAt(source, nameStart, prefix, "function " + currentName + " must return " + currentResult);
                }
                position = skipTrivia(source, valueStart + 1, prefix);
                push_back(mut items, (kind = "Return", name = "", runtime = "", code = "",
                    intValue = 0, textValue = ""));
                currentReturned = true;
                continue;
            }
            if currentResult == "Unit" {
                failAt(source, nameStart, prefix, "function " + currentName + " returns Unit and cannot return a value");
            }
            parsed := parseExpressionAs(source, position, prefix, locals, functions, functionParams, currentName, currentResult);
            if parsed.kind =!= currentResult {
                failAt(source, valueStart, prefix, "cannot return " + displayKind(parsed.kind) + " from function " +
                    currentName + " returning " + displayKind(currentResult));
            }
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after return");
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut items, (kind = "Return", name = "", runtime = "", code = copiedValueCode(currentResult, parsed.code),
                intValue = 0, textValue = ""));
            currentReturned = true;
            continue;
        }
        if name == "break" or name == "continue" {
            if not insideLoop(blocks) {
                failAt(source, nameStart, prefix, name + " outside loop");
            }
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut items, (kind = if name == "break" { "Break" } else { "Continue" }, name = "", runtime = "",
                code = "", intValue = 0, textValue = ""));
            continue;
        }
        var callableIndex := findFunction(functions, name);
        var callName := name;
        if name == "self" {
            if currentName == "" {
                failAt(source, nameStart, prefix, "self is only available inside a function");
            }
            callName = currentName;
            callableIndex = findFunction(functions, currentName);
        }
        if callableIndex >= 0 and position < size and textAt(source, position) == "(" {
            parsed := parseExpression(source, nameStart, prefix, locals, functions, functionParams, currentName);
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after function call");
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut items, (kind = "Call", name = callName, runtime = "", code = parsed.code,
                intValue = 0, textValue = ""));
            continue;
        }
        if (name == "push_back" or name == "pop_back") and position < size and textAt(source, position) == "(" {
            parsed := parseExpression(source, nameStart, prefix, locals, functions, functionParams, currentName);
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut items, (kind = "Call", name = "", runtime = "", code = parsed.code,
                intValue = 0, textValue = ""));
            continue;
        }
        if (name == "reportError" or name == "exit") and position < size and textAt(source, position) == "(" {
            parsed := parseExpression(source, nameStart, prefix, locals, functions, functionParams, currentName);
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut items, (kind = "Call", name = "", runtime = "", code = parsed.code,
                intValue = 0, textValue = ""));
            continue;
        }
        if name == "report" {
            if position >= size or textAt(source, position) =!= "(" {
                failAt(source, position, prefix, "expected ( after report");
            }
            position = skipTrivia(source, position + 1, prefix);
            loop true {
                argument := parseExpression(source, position, prefix, locals, functions, functionParams, currentName);
                if argument.kind == "Unit" {
                    failAt(source, position, prefix, "report does not accept a Unit value");
                }
                if isTupleKind(argument.kind) {
                    failAt(source, position, prefix, "report does not accept a tuple value");
                }
                if isListKind(argument.kind) {
                    failAt(source, position, prefix, "report does not accept a list value");
                }
                push_back(mut items, (kind = argument.kind, name = "", runtime = "", code = argument.code,
                    intValue = argument.intValue, textValue = argument.textValue));
                position = skipTrivia(source, argument.next, prefix);
                if position < size and textAt(source, position) == "," {
                    position = skipTrivia(source, position + 1, prefix);
                } else {
                    break;
                }
            }
            position = expectSymbol(source, position, ")", prefix);
            position = skipTrivia(source, position, prefix);
            if position < size and textAt(source, position) == ";" {
                position = skipTrivia(source, position + 1, prefix);
            }
            push_back(mut items, (kind = "End", name = "", runtime = "", code = "",
                intValue = 0, textValue = ""));
            continue;
        }
        if name == "if" {
            if currentName =!= "" and blockCount > 0 and blocks[blockCount - 1] == "function" {
                valueEnd := scanValueIfEnd(source, nameStart, prefix);
                if valueEnd >= 0 {
                    afterChain := skipTrivia(source, valueEnd, prefix);
                    if afterChain < size and textAt(source, afterChain) == "}" {
                        tail := parseExpressionAs(source, nameStart, prefix, locals, functions, functionParams, currentName, currentResult);
                        if currentResult == "Unit" {
                            push_back(mut items, (kind = "Return", name = "", runtime = "", code = "",
                                intValue = 0, textValue = ""));
                        } else {
                            if tail.kind =!= currentResult {
                                failAt(source, nameStart, prefix, "cannot return " + displayKind(tail.kind) + " from function " +
                                    currentName + " returning " + displayKind(currentResult));
                            }
                            push_back(mut items, (kind = "Return", name = "", runtime = "", code = copiedValueCode(currentResult, tail.code),
                                intValue = 0, textValue = ""));
                        }
                        currentReturned = true;
                        position = afterChain;
                        continue;
                    }
                }
            }
            conditionStart := position;
            condition := parseExpression(source, position, prefix, locals, functions, functionParams, currentName);
            if condition.kind =!= "Bool" {
                failAt(source, conditionStart, prefix, "if condition must be Bool");
            }
            conditionCode := if condition.constant {
                boolLiteralCode(condition.intValue =!= 0)
            } else {
                condition.code
            };
            position = expectSymbol(source, skipTrivia(source, condition.next, prefix), "{", prefix);
            push_back(mut items, (kind = "If", name = "", runtime = "", code = conditionCode,
                intValue = 0, textValue = ""));
            push_back(mut blocks, "if");
            blockCount = blockCount + 1;
            depth = depth + 1;
            position = skipTrivia(source, position + 1, prefix);
            continue;
        }
        if name == "loop" {
            var conditionCode := "";
            var sequenceCode := "";
            var itemName := "";
            var itemKind := "";
            if position < size and textAt(source, position) =!= "{" {
                parsed := parseExpression(source, position, prefix, locals, functions, functionParams, currentName);
                afterParsed := skipTrivia(source, parsed.next, prefix);
                if wordAt(source, afterParsed, "as") {
                    if not isListKind(parsed.kind) {
                        failAt(source, position, prefix, "loop sequence must be a List, got " + displayKind(parsed.kind));
                    }
                    itemStart := skipTrivia(source, afterParsed + 2, prefix);
                    if itemStart >= size or not isNameStart(textAt(source, itemStart)) {
                        failAt(source, itemStart, prefix, "expected an item name after as");
                    }
                    itemEnd := skipName(source, itemStart);
                    itemName = textSlice(source, itemStart, itemEnd);
                    if isReservedWord(itemName) { unsupportedFeature(source, itemStart, itemName, prefix); }
                    if localSameBlock(locals, itemName, depth + 1) {
                        failAt(source, itemStart, prefix, "duplicate local " + itemName);
                    }
                    itemKind = listElementKind(parsed.kind);
                    sequenceCode = parsed.code;
                    position = skipTrivia(source, itemEnd, prefix);
                } else {
                    if parsed.kind =!= "Bool" {
                        failAt(source, position, prefix, "loop condition must be Bool");
                    }
                    if parsed.constant {
                        if parsed.intValue == 0 { conditionCode = "false"; }
                    } else {
                        conditionCode = parsed.code;
                    }
                    position = skipTrivia(source, parsed.next, prefix);
                }
            }
            position = expectSymbol(source, position, "{", prefix);
            if itemName =!= "" {
                runtime := "lite_" + itemName;
                push_back(mut locals, (name = itemName, runtime = runtime, kind = itemKind,
                    mutable = false, writable = false, depth = depth + 1, constant = false, code = runtime,
                    intValue = 0, textValue = ""));
                localCount = localCount + 1;
                push_back(mut items, (kind = "LoopSeq", name = itemName, runtime = runtime, code = sequenceCode,
                    intValue = 0, textValue = itemKind));
            } else {
                push_back(mut items, (kind = "Loop", name = "", runtime = "", code = conditionCode,
                    intValue = 0, textValue = ""));
            }
            push_back(mut blocks, "loop");
            blockCount = blockCount + 1;
            depth = depth + 1;
            position = skipTrivia(source, position + 1, prefix);
            continue;
        }
        if name == "var" {
            position = skipTrivia(source, position, prefix);
            if position >= size or not isNameStart(textAt(source, position)) {
                failAt(source, position, prefix, "expected local name after var");
            }
            localStart := position;
            position = skipName(source, position);
            localName := textSlice(source, localStart, position);
            if isReservedWord(localName) { unsupportedFeature(source, localStart, localName, prefix); }
            position = skipTrivia(source, position, prefix);
            var parsed := intParsed("", 0, true, position);
            var declaredWritable := false;
            if startsWithAt(source, position, ":=") {
                position = skipTrivia(source, position + 2, prefix);
                parsed = parseExpression(source, position, prefix, locals, functions, functionParams, currentName);
                if parsed.kind == "Unit" {
                    failAt(source, localStart, prefix, "cannot declare a Unit local " + localName);
                }
            } else if position < size and textAt(source, position) == ":" {
                typed := parseLocalType(source, position + 1, prefix, aliases);
                declaredWritable = typed.writable;
                position = skipTrivia(source, typed.next, prefix);
                if position < size and textAt(source, position) == "=" and not startsWithAt(source, position, "==") {
                    parsed = parseExpressionAs(source, skipTrivia(source, position + 1, prefix), prefix, locals, functions, functionParams, currentName, typed.kind);
                    if parsed.kind =!= typed.kind {
                        failAt(source, localStart, prefix, "cannot initialize " + displayKind(typed.kind) + " with " + displayKind(parsed.kind));
                    }
                } else {
                    parsed = zeroParsed(typed.kind, position);
                }
            } else {
                failAt(source, position, prefix, "expected := or : after local name " + localName);
            }
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after local declaration " + localName);
            }
            position = skipTrivia(source, position + 1, prefix);
            if localSameBlock(locals, localName, depth) {
                failAt(source, localStart, prefix, "duplicate local " + localName);
            }
            runtime := "lite_" + localName;
            push_back(mut locals, (name = localName, runtime = runtime, kind = parsed.kind,
                mutable = true, writable = declaredWritable, depth = depth, constant = false, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue));
            localCount = localCount + 1;
            push_back(mut items, (kind = "Var" + storageKind(parsed.kind), name = localName, runtime = runtime,
                code = copiedValueCode(parsed.kind, parsed.code), intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
            continue;
        }
        if name == "else" {
            failAt(source, nameStart, prefix, "unexpected else");
        }
        if isReservedWord(name) { unsupportedFeature(source, nameStart, name, prefix); }
        if startsWithAt(source, position, ":=") and wordAt(source, afterDefinition, "type") {
            if blockCount =!= 0 or depth =!= 0 {
                failAt(source, nameStart, prefix, "type aliases are only allowed at top level");
            }
            var earlierAlias := false;
            loop aliases as alias {
                if alias.name == name and alias.at < nameStart { earlierAlias = true; }
            }
            if earlierAlias {
                failAt(source, nameStart, prefix, "duplicate type alias " + name);
            }
            typePosition := skipTrivia(source, position + 2, prefix);
            targetStart := skipTrivia(source, typePosition + 4, prefix);
            aliasIndex := aliasIndexAt(aliases, nameStart);
            if aliasIndex < 0 {
                unsupportedAliasTarget(source, targetStart, prefix, "target");
            }
            aliasEntry := aliases[aliasIndex];
            if aliasEntry.target == "" {
                unsupportedAliasTarget(source, targetStart, prefix, "target");
            }
            seenAliases: mut List<String> = [];
            resolveTypeText(source, targetStart, prefix, aliases, aliasEntry.target, seenAliases);
            afterTarget := skipTrivia(source, aliasEntry.end, prefix);
            if afterTarget < size and textAt(source, afterTarget) =!= ";" {
                unsupportedAliasTarget(source, aliasEntry.at, prefix, "target");
            }
            if afterTarget >= size {
                failAt(source, afterTarget, prefix, "expected ; after type alias " + name);
            }
            position = skipTrivia(source, afterTarget + 1, prefix);
            continue;
        }
        if startsWithAt(source, position, ":=") {
            afterDeclare := skipTrivia(source, position + 2, prefix);
            if wordAt(source, afterDeclare, "fn") {
                if blockCount =!= 0 or depth =!= 0 {
                    failAt(source, nameStart, prefix, "function definitions are only allowed at top level");
                }
                if seenStatement {
                    failAt(source, nameStart, prefix, "function definitions must precede statements");
                }
                if findFunction(functions, name) >= 0 {
                    failAt(source, nameStart, prefix, "duplicate function " + name);
                }
                position = skipTrivia(source, afterDeclare + 2, prefix);
                header := parseFunctionHeader(source, position, prefix, aliases);
                position = skipTrivia(source, header.next, prefix);
                position = expectSymbol(source, position, "{", prefix);
                push_back(mut functions, (name = name, result = header.result, first = parameterTotal, count = header.count));
                push_back(mut items, (kind = "FunctionStart", name = name, runtime = "liteFn_" + name,
                    code = header.result, intValue = header.count, textValue = header.params));
                var entryStart := 0;
                var entryIndex := 0;
                loop entryIndex < header.count {
                    separator := indexOfText(header.params, "|", entryStart);
                    var entryEnd := textLength(header.params);
                    if separator >= 0 { entryEnd = separator; }
                    entry := textSlice(header.params, entryStart, entryEnd);
                    parameterName := paramNameOf(entry);
                    parameterKind := paramKindOf(entry);
                    runtime := "lite_" + parameterName;
                    push_back(mut functionParams, entry);
                    push_back(mut locals, (name = parameterName, runtime = runtime, kind = parameterKind,
                        mutable = false, writable = false, depth = 1, constant = false, code = runtime,
                        intValue = 0, textValue = ""));
                    localCount = localCount + 1;
                    parameterTotal = parameterTotal + 1;
                    entryStart = entryEnd + 1;
                    entryIndex = entryIndex + 1;
                }
                currentName = name;
                currentResult = header.result;
                currentReturned = false;
                push_back(mut blocks, "function");
                blockCount = blockCount + 1;
                depth = depth + 1;
                position = skipTrivia(source, position, prefix);
                continue;
            }
            position = afterDeclare;
            parsed := parseExpression(source, position, prefix, locals, functions, functionParams, currentName);
            if parsed.kind == "Unit" {
                failAt(source, nameStart, prefix, "cannot declare a Unit local " + name);
            }
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after local declaration " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            if localSameBlock(locals, name, depth) {
                failAt(source, nameStart, prefix, "duplicate local " + name);
            }
            runtime := "lite_" + name;
            push_back(mut locals, (name = name, runtime = runtime, kind = parsed.kind,
                mutable = false, writable = false, depth = depth, constant = parsed.constant, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue));
            localCount = localCount + 1;
            push_back(mut items, (kind = "Local" + storageKind(parsed.kind), name = name, runtime = runtime,
                code = copiedValueCode(parsed.kind, parsed.code), intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
            continue;
        }
        if position < size and textAt(source, position) == ":" {
            typed := parseLocalType(source, position + 1, prefix, aliases);
            position = skipTrivia(source, typed.next, prefix);
            var parsed := zeroParsed(typed.kind, position);
            if position < size and textAt(source, position) == "=" and not startsWithAt(source, position, "==") {
                parsed = parseExpressionAs(source, skipTrivia(source, position + 1, prefix), prefix, locals, functions, functionParams, currentName, typed.kind);
                if parsed.kind =!= typed.kind {
                    failAt(source, nameStart, prefix, "cannot initialize " + displayKind(typed.kind) + " with " + displayKind(parsed.kind));
                }
            }
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after local declaration " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            if localSameBlock(locals, name, depth) {
                failAt(source, nameStart, prefix, "duplicate local " + name);
            }
            runtime := "lite_" + name;
            push_back(mut locals, (name = name, runtime = runtime, kind = typed.kind,
                mutable = false, writable = typed.writable, depth = depth, constant = parsed.constant, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue));
            localCount = localCount + 1;
            push_back(mut items, (kind = "Local" + storageKind(typed.kind), name = name, runtime = runtime,
                code = copiedValueCode(typed.kind, parsed.code), intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
            continue;
        }
        if position < size and textAt(source, position) == "=" and not startsWithAt(source, position, "==") {
            index := localIndex(locals, name);
            if index < 0 {
                failAt(source, nameStart, prefix, "unknown value " + name);
            }
            entry := locals[index];
            if not entry.mutable {
                failAt(source, nameStart, prefix, "cannot assign to immutable local " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            parsed := parseExpressionAs(source, position, prefix, locals, functions, functionParams, currentName, entry.kind);
            if parsed.kind =!= entry.kind {
                failAt(source, nameStart, prefix, "cannot assign " + displayKind(parsed.kind) + " to " + displayKind(entry.kind) + " local " + name);
            }
            position = skipTrivia(source, parsed.next, prefix);
            if position >= size or textAt(source, position) =!= ";" {
                failAt(source, position, prefix, "expected ; after assignment to " + name);
            }
            position = skipTrivia(source, position + 1, prefix);
            push_back(mut locals, (name = entry.name, runtime = entry.runtime, kind = entry.kind,
                mutable = true, writable = entry.writable, depth = entry.depth, constant = false, code = parsed.code,
                intValue = parsed.intValue, textValue = parsed.textValue));
            localCount = localCount + 1;
            push_back(mut items, (kind = "Assign" + storageKind(entry.kind), name = name, runtime = entry.runtime,
                code = copiedValueCode(entry.kind, parsed.code), intValue = parsed.intValue, textValue = itemTextPayload(parsed)));
            continue;
        }
        if currentName =!= "" {
            tail := parseExpressionAs(source, nameStart, prefix, locals, functions, functionParams, currentName, currentResult);
            afterTail := skipTrivia(source, tail.next, prefix);
            if afterTail < size and textAt(source, afterTail) == "}" and blockCount > 0 and
                blocks[blockCount - 1] == "function" {
                if currentResult == "Unit" {
                    push_back(mut items, (kind = "Return", name = "", runtime = "", code = "",
                        intValue = 0, textValue = ""));
                } else {
                    if tail.kind =!= currentResult {
                        failAt(source, nameStart, prefix, "cannot return " + displayKind(tail.kind) + " from function " +
                            currentName + " returning " + displayKind(currentResult));
                    }
                    push_back(mut items, (kind = "Return", name = "", runtime = "", code = copiedValueCode(currentResult, tail.code),
                        intValue = 0, textValue = ""));
                }
                currentReturned = true;
                position = afterTail;
                continue;
            }
            failAt(source, afterTail, prefix, "expected ; after expression statement");
        }
        failAt(source, position, prefix, "expected := or = after local name " + name);
    }
    if blockCount > 0 {
        failAt(source, size, prefix, "expected } before end of source");
    }
    items
}
/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Builds one checked printf call for an Int, String or Bool report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    if kind == "Int" {
        "printf(\"%\" PRId64, (int64_t)(" + code + "))"
    } else if kind == "Bool" {
        "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))"
    } else {
        "printf(\"%s\", " + code + ")"
    }
}

/** Returns the C rejection message for one emitted expression that calls an unsupported I/O or text builtin, or empty text. */
unsupportedBuiltinCode := fn(code: String): String {
    if codeUsesTextCall(code, "lite$inputArgs(") or codeUsesTextCall(code, "lite$inputAll(") {
        "C backend does not support input builtins yet"
    } else if codeUsesTextCall(code, "lite$reportError(") or codeUsesTextCall(code, "lite$exit(") {
        "C backend does not support reportError or exit yet"
    } else if codeUsesTextCall(code, "lite$textLength(") or codeUsesTextCall(code, "lite$textAt(") or
        codeUsesTextCall(code, "lite$textSlice(") {
        "C backend does not support text builtins yet"
    } else {
        ""
    }
}

/** True when any emitted item calls the checked Int division-family helper `name`. */
usesIntHelper := fn(items: Items, name: String): Bool {
    loop items as item {
        if codeUsesTextCall(item.code, name) { return true; }
    }
    false
}

/** True when any emitted item needs one of the checked Int division helpers. */
usesIntDivision := fn(items: Items): Bool {
    usesIntHelper(items, "lite_divide_int(") or usesIntHelper(items, "lite_remainder_int(") or
    usesIntHelper(items, "lite_floor_divide_int(") or usesIntHelper(items, "lite_floor_modulo_int(")
}

/** True when any emitted item concatenates dynamic Strings through the checked helper. */
usesStringConcat := fn(items: Items): Bool {
    usesIntHelper(items, "lite_concat(")
}

/** Emits the checked truncating int64_t division helper. */
emitIntDivideHelper := fn(): Unit {
    report("static int64_t lite_divide_int(int64_t left, int64_t right) {");
    report("    if (right == 0) {");
    report("        fprintf(stderr, \"ArithmeticPanic: division by zero in integer expression\\n\");");
    report("        exit(1);");
    report("    }");
    report("    if (left == INT64_MIN && right == -1) {");
    report("        fprintf(stderr, \"ArithmeticPanic: integer expression outside signed 64-bit range\\n\");");
    report("        exit(1);");
    report("    }");
    report("    return left / right;");
    report("}");
    report("");
}

/** Emits the checked int64_t remainder helper. */
emitIntRemainderHelper := fn(): Unit {
    report("static int64_t lite_remainder_int(int64_t left, int64_t right) {");
    report("    if (right == 0) {");
    report("        fprintf(stderr, \"ArithmeticPanic: remainder by zero in integer expression\\n\");");
    report("        exit(1);");
    report("    }");
    report("    if (left == INT64_MIN && right == -1) {");
    report("        fprintf(stderr, \"ArithmeticPanic: integer expression outside signed 64-bit range\\n\");");
    report("        exit(1);");
    report("    }");
    report("    return left % right;");
    report("}");
    report("");
}

/** Emits the checked int64_t floor-division helper. */
emitIntFloorDivideHelper := fn(): Unit {
    report("static int64_t lite_floor_divide_int(int64_t left, int64_t right) {");
    report("    const int64_t quotient = lite_divide_int(left, right);");
    report("    const int64_t remainder = left % right;");
    report("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? quotient - 1 : quotient;");
    report("}");
    report("");
}

/** Emits the checked int64_t floor-modulo helper. */
emitIntFloorModuloHelper := fn(): Unit {
    report("static int64_t lite_floor_modulo_int(int64_t left, int64_t right) {");
    report("    if (right == 0) {");
    report("        fprintf(stderr, \"ArithmeticPanic: modulo by zero in integer expression\\n\");");
    report("        exit(1);");
    report("    }");
    report("    if (left == INT64_MIN && right == -1) { return 0; }");
    report("    const int64_t remainder = left % right;");
    report("    return remainder != 0 && ((remainder < 0) != (right < 0)) ? remainder + right : remainder;");
    report("}");
    report("");
}

/** Emits every checked Int division-family helper the program reads. */
emitIntDivisionHelpers := fn(items: Items): Unit {
    if usesIntHelper(items, "lite_divide_int(") or usesIntHelper(items, "lite_floor_divide_int(") {
        emitIntDivideHelper();
    }
    if usesIntHelper(items, "lite_remainder_int(") { emitIntRemainderHelper(); }
    if usesIntHelper(items, "lite_floor_divide_int(") { emitIntFloorDivideHelper(); }
    if usesIntHelper(items, "lite_floor_modulo_int(") { emitIntFloorModuloHelper(); }
    return;
}

/** Emits the checked UTF-8 byte concatenation helper; each allocated result is intentionally leaked by this bootstrap backend. */
emitStringConcatHelper := fn(): Unit {
    report("static const char *lite_concat(const char *left, const char *right) {");
    report("    const size_t left_length = strlen(left);");
    report("    const size_t right_length = strlen(right);");
    report("    char *combined = malloc(left_length + right_length + 1);");
    report("    if (combined == NULL) {");
    report("        fprintf(stderr, \"MemoryFault: cannot allocate concatenated text\\n\");");
    report("        exit(1);");
    report("    }");
    report("    memcpy(combined, left, left_length);");
    report("    memcpy(combined + left_length, right, right_length + 1);");
    report("    return combined;");
    report("}");
    report("");
}

/** Emits the C program from the flat item stream. Locals become int64_t, const char pointer or bool declarations, control flow becomes braces, and every report printf keeps the shared write-failure status. */
emitProgram := fn(items: Items): Unit {
    loop items as item {
        if item.kind == "FunctionStart" {
            fail("", "C backend does not support top-level functions yet");
        }
        unsupported := unsupportedBuiltinCode(item.code);
        if unsupported =!= "" {
            fail("", unsupported);
        }
        if item.kind == "LocalTuple" or item.kind == "VarTuple" or item.kind == "AssignTuple" {
            fail("", "C backend does not support tuple values yet");
        }
        if item.kind == "LocalList" or item.kind == "VarList" or item.kind == "AssignList" {
            fail("", "C backend does not support list values yet");
        }
        if item.kind == "LoopSeq" {
            fail("", "C backend does not support list traversal yet");
        }
        if codeUsesListIndex(item.code) or codeUsesListPop(item.code) {
            fail("", "C backend does not support list values yet");
        }
        if codeUsesValueIf(item.code) {
            fail("", "C backend does not support value if expressions yet");
        }
    }
    report("#include <stdio.h>");
    if usesIntDivision(items) or usesStringConcat(items) { report("#include <stdlib.h>"); }
    report("#include <inttypes.h>");
    report("#include <stdbool.h>");
    report("#include <string.h>");
    emitIntDivisionHelpers(items);
    if usesStringConcat(items) { emitStringConcatHelper(); }
    report("int main(void) {");
    report("    int status = 0;");
    var indent := "    ";
    var count := 0;
    loop items as item {
        if item.kind == "LocalInt" or item.kind == "VarInt" {
            report(indent + "int64_t " + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalString" or item.kind == "VarString" {
            report(indent + "const char *" + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalBool" or item.kind == "VarBool" {
            report(indent + "bool " + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" {
            report(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "Break" {
            report(indent + "break;");
        } else if item.kind == "Continue" {
            report(indent + "continue;");
        } else if item.kind == "If" {
            report(indent + "if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            report(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "true" } else { item.code };
            report(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "End" {
            report(indent + "if (printf(\"\\n\") < 0) { status = 1; }");
            count = 0;
        } else {
            if count > 0 { report(indent + "if (printf(\" \") < 0) { status = 1; }"); }
            report(indent + "if (" + cCall(item.kind, item.code) + " < 0) { status = 1; }");
            count = count + 1;
        }
    }
    report("    return status;");
    report("}");
}
prefix := sourcePrefix();
source := inputAll();
emitProgram(parseProgram(source, prefix));
