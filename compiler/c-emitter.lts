/* C backend for the temporary Lite compiler. */
/** Formats a checked Int value as a C signed 64-bit literal (`INT64_C`, `INT64_MIN`). */
intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == -9223372036854775808 { "INT64_MIN" }
    else if value == 0 { "INT64_C(0)" }
    else if negative { "(-INT64_C(" + digits + "))" }
    else { "INT64_C(" + digits + ")" }
}

/** Escapes a String as a readable C literal, including trigraph-safe `?`. */
textLiteralCode := fn(value: String): String {
    size := textLength(value);
    var encoded := "\"";
    var position := 0;
    loop position < size {
        ch := textAt(value, position);
        if ch == "\\" { encoded = encoded + "\\\\"; }
        else if ch == "\"" { encoded = encoded + "\\\""; }
        else if ch == "?" { encoded = encoded + "\\?"; }
        else if ch == "\n" { encoded = encoded + "\\n"; }
        else if ch == "\r" { encoded = encoded + "\\r"; }
        else if ch == "\t" { encoded = encoded + "\\t"; }
        else { encoded = encoded + ch; }
        position = position + 1;
    }
    encoded + "\""
}

/** Formats a checked Bool value as a C `stdbool.h` literal. */
boolLiteralCode := fn(value: Bool): String {
    if value { "true" } else { "false" }
}

/** Emits a C logical negation around one Bool expression. */
notCode := fn(value: String): String {
    "(!(" + value + "))"
}

/** Emits a C short-circuit `and`/`or` expression around two Bool expressions. */
logicCode := fn(op: String, left: String, right: String): String {
    if op == "and" { "((" + left + ") && (" + right + "))" }
    else { "((" + left + ") || (" + right + "))" }
}

/** Emits a kind-aware C comparison; String equality uses `strcmp` and not-less/not-more spellings invert the ordering. */
comparisonCode := fn(op: String, kind: String, left: String, right: String): String {
    if kind == "String" {
        if op == "==" { "strcmp(" + left + ", " + right + ") == 0" }
        else { "strcmp(" + left + ", " + right + ") != 0" }
    } else {
        operator := if op == "==" { "==" }
            else if op == "=!=" { "!=" }
            else if op == "<" { "<" }
            else if op == "<!" { ">=" }
            else if op == "<=" { "<=" }
            else if op == "<!=" { ">" }
            else if op == ">" { ">" }
            else if op == ">!" { "<=" }
            else if op == ">=" { ">=" }
            else { "<" };
        "(" + left + ") " + operator + " (" + right + ")"
    }
}

/** Emits an int64_t floor-division expression. */
floorDivCode := fn(left: String, right: String): String {
    "(" + left + " / " + right + " - ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? 1 : 0))"
}

/** Emits an int64_t floor-modulo expression. */
floorModCode := fn(left: String, right: String): String {
    "(" + left + " % " + right + " + ((((" + left + " % " + right + ") != 0) && (((" + left + " % " + right + ") < 0) != (" + right + " < 0))) ? " + right + " : 0))"
}

importFlatAll "frontend.lts";

/** Removes one four-space indentation level from `indent`. */
dedent := fn(indent: String): String {
    textSlice(indent, 0, textLength(indent) - 4)
}

/** Builds one checked printf call for an Int, String or Bool report value without a trailing newline. */
cCall := fn(kind: String, code: String): String {
    if kind == "Int" {
        "printf(\"%\" PRId64, (int64_t)(" + code + "))"
    } else if kind == "Bool" {
        "printf(\"%s\", ((" + code + ") ? \"true\" : \"false\"))"
    } else {
        "printf(\"%s\", " + code + ")"
    }
}

/** Emits the C program from the flat item stream. Locals become int64_t, const char pointer or bool declarations, control flow becomes braces, and every report printf keeps the shared write-failure status. */
emitProgram := fn(items: Items): Unit {
    report("#include <stdio.h>");
    report("#include <inttypes.h>");
    report("#include <stdbool.h>");
    report("#include <string.h>");
    report("int main(void) {");
    report("    int status = 0;");
    var indent := "    ";
    var count := 0;
    loop items as item {
        if item.kind == "LocalInt" or item.kind == "VarInt" {
            report(indent + "int64_t " + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalString" or item.kind == "VarString" {
            report(indent + "const char *" + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "LocalBool" or item.kind == "VarBool" {
            report(indent + "bool " + item.runtime + " = " + item.code + ";");
            report(indent + "(void)" + item.runtime + ";");
        } else if item.kind == "AssignInt" or item.kind == "AssignString" or item.kind == "AssignBool" {
            report(indent + item.runtime + " = " + item.code + ";");
        } else if item.kind == "If" {
            report(indent + "if (" + item.code + ") {");
            indent = indent + "    ";
        } else if item.kind == "Else" {
            indent = dedent(indent);
            report(indent + "} else {");
            indent = indent + "    ";
        } else if item.kind == "EndIf" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "Loop" {
            condition := if item.code == "" { "true" } else { item.code };
            report(indent + "while (" + condition + ") {");
            indent = indent + "    ";
        } else if item.kind == "EndLoop" {
            indent = dedent(indent);
            report(indent + "}");
        } else if item.kind == "End" {
            report(indent + "if (printf(\"\\n\") < 0) { status = 1; }");
            count = 0;
        } else {
            if count > 0 { report(indent + "if (printf(\" \") < 0) { status = 1; }"); }
            report(indent + "if (" + cCall(item.kind, item.code) + " < 0) { status = 1; }");
            count = count + 1;
        }
    }
    report("    return status;");
    report("}");
}

prefix := sourcePrefix();
source := inputAll();
emitProgram(parseProgram(source, prefix));
