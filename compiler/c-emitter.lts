/* C backend for the temporary Lite compiler. */
/** Formats a checked Int value as a C signed 64-bit literal (`INT64_C`, `INT64_MIN`). */
intLiteralCode := fn(value: Int, negative: Bool, digits: String): String {
    if value == -9223372036854775808 { "INT64_MIN" }
    else if value == 0 { "INT64_C(0)" }
    else if negative { "(-INT64_C(" + digits + "))" }
    else { "INT64_C(" + digits + ")" }
}

/** Escapes a String as a readable C literal, including trigraph-safe `?`. */
textLiteralCode := fn(value: String): String {
    size := textLength(value);
    var encoded := "\"";
    var position := 0;
    loop position < size {
        ch := textAt(value, position);
        if ch == "\\" { encoded = encoded + "\\\\"; }
        else if ch == "\"" { encoded = encoded + "\\\""; }
        else if ch == "?" { encoded = encoded + "\\?"; }
        else if ch == "\n" { encoded = encoded + "\\n"; }
        else if ch == "\r" { encoded = encoded + "\\r"; }
        else if ch == "\t" { encoded = encoded + "\\t"; }
        else { encoded = encoded + ch; }
        position = position + 1;
    }
    encoded + "\""
}

importFlatAll "frontend.lts";

/** Builds one checked printf call for an Int or String report value; newline controls the trailing newline in the format. */
cCall := fn(kind: String, code: String, newline: Bool): String {
    if kind == "Int" {
        if newline {
            "printf(\"%\" PRId64 \"\\n\", (int64_t)(" + code + "))"
        } else {
            "printf(\"%\" PRId64, (int64_t)(" + code + "))"
        }
    } else {
        if newline {
            "printf(\"%s\\n\", " + code + ")"
        } else {
            "printf(\"%s\", " + code + ")"
        }
    }
}

/** Emits the C program from the flat item stream. Locals become int64_t or const char readings; report segments become checked printf calls with a shared write-failure status. */
emitProgram := fn(items: Items): Unit {
    report("#include <stdio.h>");
    report("#include <inttypes.h>");
    report("int main(void) {");
    report("    int status = 0;");
    var firstKind := "";
    var firstCode := "";
    var rest := "";
    var count := 0;
    loop items as item {
        if item.kind == "LocalInt" {
            report("    int64_t " + item.runtime + " = " + item.code + ";");
            report("    (void)" + item.runtime + ";");
        } else if item.kind == "LocalString" {
            report("    const char *" + item.runtime + " = " + item.code + ";");
            report("    (void)" + item.runtime + ";");
        } else if item.kind == "End" {
            if count == 1 {
                report("    if (" + cCall(firstKind, firstCode, true) + " < 0) { status = 1; }");
            } else {
                var block := "    if (" + cCall(firstKind, firstCode, false) + " < 0) { status = 1; }";
                block = block + rest + "\n    if (printf(\"\\n\") < 0) { status = 1; }";
                report(block);
            }
            firstKind = "";
            firstCode = "";
            rest = "";
            count = 0;
        } else {
            if count == 0 {
                firstKind = item.kind;
                firstCode = item.code;
            } else {
                rest = rest + "\n    if (printf(\" \") < 0) { status = 1; }";
                rest = rest + "\n    if (" + cCall(item.kind, item.code, false) + " < 0) { status = 1; }";
            }
            count = count + 1;
        }
    }
    report("    return status;");
    report("}");
}

prefix := sourcePrefix();
source := inputAll();
emitProgram(parseProgram(source, prefix));
