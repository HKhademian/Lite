/* Shared restricted front-end. Not a standalone program: a backend defines
   intLiteralCode/textLiteralCode and includes this file with importFlatAll. */
/** One parsed Int or String expression: target `code`, its checked compile-time value, and the next source position. */
Parsed := type (kind: String, code: String, intValue: Int, textValue: String, next: Int);
/** An immutable local visible to later expressions: source name, hygienic runtime name, value kind, target code and compile-time value. */
Local := type (name: String, runtime: String, kind: String, code: String, intValue: Int, textValue: String);
/** One entry in the flat program stream: an Int/String report argument, an End report boundary, or a LocalInt/LocalString declaration. */
Item := type (kind: String, name: String, runtime: String, code: String, intValue: Int, textValue: String);
/** Flat program stream returned by parseProgram and consumed by a backend emitter. */
Items := type List<Item>;

/** True when `text` is exactly one ASCII decimal digit. */
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

/** Numeric value of one checked ASCII decimal digit. */
digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

/** Returns the first position at or after `start` that is not Lite whitespace. */
skipSpaces := fn(source: String, start: Int): Int {
    size := textLength(source);
    var position := start;
    loop position < size and (textAt(source, position) == " " or textAt(source, position) == "\t" or textAt(source, position) == "\r" or textAt(source, position) == "\n") {
        position = position + 1;
    }
    position
}

/** Consumes the exact `symbol` at `position`, or reports a prefixed diagnostic and exits 2. */
expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLength(source) or textAt(source, position) =!= symbol {
        reportError(prefix + "expected " + symbol);
        exit(2);
    }
    position + 1
}

/** True for an ASCII identifier start or underscore accepted by the compiler subset. */
isNameStart := fn(ch: String): Bool {
    starts := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    size := textLength(starts);
    var position := 0;
    loop position < size {
        if textAt(starts, position) == ch { return true; }
        position = position + 1;
    }
    false
}

/** True for an identifier continuation character. */
isNameContinue := fn(ch: String): Bool {
    isNameStart(ch) or isDigit(ch)
}

/** Returns the position after the identifier run starting at `start`. */
skipName := fn(source: String, start: Int): Int {
    size := textLength(source);
    var position := start;
    loop position < size and isNameContinue(textAt(source, position)) {
        position = position + 1;
    }
    position
}

/** Builds an Int parsed value; `textValue` is empty. */
intParsed := fn(code: String, value: Int, next: Int): Parsed {
    (kind = "Int", code = code, intValue = value, textValue = "", next = next)
}

/** Builds a String parsed value; `intValue` is zero. */
textParsed := fn(code: String, value: String, next: Int): Parsed {
    (kind = "String", code = code, intValue = 0, textValue = value, next = next)
}

/* Checked compile-time evaluation keeps every emitted operation in signed 64-bit range. */
/** Checked signed 64-bit addition; reports and exits 2 on overflow. */
addIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right > 0 and left > 9223372036854775807 - right {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    if right < 0 and left < -9223372036854775808 - right {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    left + right
}

/** Checked signed 64-bit subtraction; reports and exits 2 on overflow. */
subtractIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right < 0 and left > 9223372036854775807 + right {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    if right > 0 and left < -9223372036854775808 + right {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    left - right
}

/** Checked signed 64-bit multiplication; reports and exits 2 on overflow. */
multiplyIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if left == 0 or right == 0 { return 0; }
    if left > 0 {
        if right > 0 {
            if left > 9223372036854775807 / right {
                reportError(prefix + "integer expression outside signed 64-bit range");
                exit(2);
            }
        } else {
            if right < -9223372036854775808 / left {
                reportError(prefix + "integer expression outside signed 64-bit range");
                exit(2);
            }
        }
    } else {
        if right > 0 {
            if left < -9223372036854775808 / right {
                reportError(prefix + "integer expression outside signed 64-bit range");
                exit(2);
            }
        } else {
            if right < 9223372036854775807 / left {
                reportError(prefix + "integer expression outside signed 64-bit range");
                exit(2);
            }
        }
    }
    left * right
}

/** Truncating signed 64-bit division; reports and exits 2 on zero or MIN divided by -1. */
divideIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right == 0 {
        reportError(prefix + "division by zero in integer expression");
        exit(2);
    }
    if left == -9223372036854775808 and right == -1 {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    left / right
}

/** Checked truncating Int remainder; reports and exits 2 on zero divisor or signed overflow. */
remainderIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right == 0 {
        reportError(prefix + "remainder by zero in integer expression");
        exit(2);
    }
    if left == -9223372036854775808 and right == -1 {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    left % right
}

/** Checked floor division; reports and exits 2 on zero or signed overflow. */
floorDivideIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right == 0 {
        reportError(prefix + "division by zero in integer expression");
        exit(2);
    }
    if left == -9223372036854775808 and right == -1 {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    quotient := left / right;
    if left % right =!= 0 and (left < 0) =!= (right < 0) { quotient - 1 } else { quotient }
}

/** Checked floor modulo; reports and exits 2 on zero. */
floorModuloIntegers := fn(left: Int, right: Int, prefix: String): Int {
    if right == 0 {
        reportError(prefix + "modulo by zero in integer expression");
        exit(2);
    }
    remainder := left % right;
    if remainder =!= 0 and (remainder < 0) =!= (right < 0) { remainder + right } else { remainder }
}

/** Checked unary negation; reports and exits 2 for the signed minimum. */
negateInteger := fn(value: Int, prefix: String): Int {
    if value == -9223372036854775808 {
        reportError(prefix + "integer expression outside signed 64-bit range");
        exit(2);
    }
    0 - value
}

/** Returns the index of `name` in `locals`, or -1 when it is not visible. */
localIndex := fn(locals: List<Local>, name: String): Int {
    var index := 0;
    loop locals as local {
        if local.name == name { return index; }
        index = index + 1;
    }
    -1
}

/** Parses a signed decimal literal, allowing whitespace after the sign. Returns target code, checked value and next position; exits 2 on malformed or out-of-range input. */
parseInteger := fn(source: String, position: Int, prefix: String): Parsed {
    var cursor := position;
    var negative := false;
    ch := textAt(source, cursor);
    if ch == "+" or ch == "-" {
        negative = ch == "-";
        cursor = skipSpaces(source, cursor + 1);
    }
    start := cursor;
    var magnitude := 0;
    loop cursor < textLength(source) and isDigit(textAt(source, cursor)) {
        digit := digitValue(textAt(source, cursor));
        if magnitude < (-9223372036854775808 + digit) / 10 {
            reportError(prefix + "integer literal outside signed 64-bit range");
            exit(2);
        }
        magnitude = magnitude * 10 - digit;
        cursor = cursor + 1;
    }
    if start == cursor {
        reportError(prefix + "expected a decimal integer literal");
        exit(2);
    }
    if not negative and magnitude == -9223372036854775808 {
        reportError(prefix + "integer literal outside signed 64-bit range");
        exit(2);
    }
    value := if negative { magnitude } else { 0 - magnitude };
    raw := textSlice(source, start, cursor);
    var digitStart := 0;
    loop digitStart + 1 < textLength(raw) and textAt(raw, digitStart) == "0" {
        digitStart = digitStart + 1;
    }
    digits := textSlice(raw, digitStart, textLength(raw));
    code := intLiteralCode(value, negative, digits);
    intParsed(code, value, cursor)
}

/** Parses one double-quoted literal with n/t/r/quote/backslash escapes. Returns escaped target code, text value and next position; exits 2 on malformed input. */
parseText := fn(source: String, position: Int, prefix: String): Parsed {
    var cursor := position + 1;
    var value := "";
    loop true {
        if cursor >= textLength(source) {
            reportError(prefix + "unterminated string literal");
            exit(2);
        }
        ch := textAt(source, cursor);
        if ch == "\"" {
            cursor = cursor + 1;
            break;
        }
        if ch == "\\" {
            cursor = cursor + 1;
            if cursor >= textLength(source) {
                reportError(prefix + "unterminated string escape");
                exit(2);
            }
            escaped := textAt(source, cursor);
            if escaped == "n" { value = value + "\n"; }
            else if escaped == "t" { value = value + "\t"; }
            else if escaped == "r" { value = value + "\r"; }
            else if escaped == "\"" { value = value + "\""; }
            else if escaped == "\\" { value = value + "\\"; }
            else {
                reportError(prefix + "unsupported string escape \\" + escaped);
                exit(2);
            }
            cursor = cursor + 1;
        } else {
            value = value + ch;
            cursor = cursor + 1;
        }
    }
    textParsed(textLiteralCode(value), value, cursor)
}

/** Precedence-climbing parser for + - * / % :/ :%, parentheses and unary signs. Folds Int arithmetic and String concatenation, and exits 2 on mixed-type or range faults. self(..., 30) parses a unary operand without binary operators. */
parseBinary := fn(source: String, position: Int, prefix: String, locals: List<Local>, minimum: Int): Parsed {
    start := skipSpaces(source, position);
    if start >= textLength(source) {
        reportError(prefix + "expected an integer or string expression");
        exit(2);
    }
    var left := intParsed("", 0, start);
    ch := textAt(source, start);
    if ch == "(" {
        inner := self(source, start + 1, prefix, locals, 0);
        next := expectSymbol(source, skipSpaces(source, inner.next), ")", prefix);
        left = (kind = inner.kind, code = "(" + inner.code + ")", intValue = inner.intValue, textValue = inner.textValue, next = next);
    } else if ch == "+" or ch == "-" {
        after := skipSpaces(source, start + 1);
        if after < textLength(source) and isDigit(textAt(source, after)) {
            left = parseInteger(source, start, prefix);
        } else {
            operand := self(source, start + 1, prefix, locals, 30);
            if operand.kind =!= "Int" {
                reportError(prefix + "unary " + ch + " requires an Int operand");
                exit(2);
            }
            value := if ch == "-" { negateInteger(operand.intValue, prefix) } else { operand.intValue };
            code := if ch == "-" { "(-" + operand.code + ")" } else { "(" + operand.code + ")" };
            left = intParsed(code, value, operand.next);
        }
    } else if isDigit(ch) {
        left = parseInteger(source, start, prefix);
    } else if ch == "\"" {
        left = parseText(source, start, prefix);
    } else if isNameStart(ch) {
        nameStart := start;
        next := skipName(source, start);
        name := textSlice(source, nameStart, next);
        index := localIndex(locals, name);
        if index < 0 {
            reportError(prefix + "unknown value " + name);
            exit(2);
        }
        entry := locals[index];
        left = (kind = entry.kind, code = entry.runtime, intValue = entry.intValue, textValue = entry.textValue, next = next);
    } else {
        reportError(prefix + "expected an integer or string expression");
        exit(2);
    }
    loop true {
        operatorPosition := skipSpaces(source, left.next);
        if operatorPosition >= textLength(source) { break; }
        var operator := textAt(source, operatorPosition);
        var operatorWidth := 1;
        if operator == ":" and operatorPosition + 1 < textLength(source) {
            next := textAt(source, operatorPosition + 1);
            if next == "/" or next == "%" {
                operator = operator + next;
                operatorWidth = 2;
            }
        }
        if operator =!= "+" and operator =!= "-" and operator =!= "*" and operator =!= "/" and
           operator =!= "%" and operator =!= ":/" and operator =!= ":%" { break; }
        level := if operator == "+" or operator == "-" { 10 } else { 20 };
        if level < minimum { break; }
        right := self(source, operatorPosition + operatorWidth, prefix, locals, level + 1);
        if operator == "+" and left.kind == "String" and right.kind == "String" {
            combined := left.textValue + right.textValue;
            left = textParsed(textLiteralCode(combined), combined, right.next);
        } else if left.kind == "Int" and right.kind == "Int" {
            folded := if operator == "+" { addIntegers(left.intValue, right.intValue, prefix) }
                else if operator == "-" { subtractIntegers(left.intValue, right.intValue, prefix) }
                else if operator == "*" { multiplyIntegers(left.intValue, right.intValue, prefix) }
                else if operator == "%" { remainderIntegers(left.intValue, right.intValue, prefix) }
                else if operator == ":/" { floorDivideIntegers(left.intValue, right.intValue, prefix) }
                else if operator == ":%" { floorModuloIntegers(left.intValue, right.intValue, prefix) }
                else { divideIntegers(left.intValue, right.intValue, prefix) };
            code := if operator == ":/" { floorDivCode(left.code, right.code) }
                else if operator == ":%" { floorModCode(left.code, right.code) }
                else { "(" + left.code + " " + operator + " " + right.code + ")" };
            left = intParsed(code, folded, right.next);
        } else if operator == "+" {
            reportError(prefix + "cannot mix Int and String operands");
            exit(2);
        } else {
            reportError(prefix + "operator " + operator + " requires Int operands");
            exit(2);
        }
    }
    left
}

/** Parses one complete expression at the lowest precedence. */
parseExpression := fn(source: String, position: Int, prefix: String, locals: List<Local>): Parsed {
    parseBinary(source, position, prefix, locals, 0)
}

/** Reads the optional logical source name from inputArgs. Returns 'name: ' or empty text; exits 2 for more than one argument. */
sourcePrefix := fn(): String {
    var prefix := "";
    var argumentCountValue := 0;
    loop inputArgs() as argument {
        if argumentCountValue == 0 { prefix = argument + ": "; }
        argumentCountValue = argumentCountValue + 1;
    }
    if argumentCountValue > 1 {
        reportError("expected at most one logical source name argument");
        exit(2);
    }
    prefix
}

/** Parses complete source into a flat Items stream while keeping one visible-local list. Exits 2 on unsupported, malformed or faulting source. */
parseProgram := fn(source: String, prefix: String): Items {
    size := textLength(source);
    locals: mut List<Local> = [];
    items: mut Items = [];
    var position := skipSpaces(source, 0);
    if position == size {
        reportError(prefix + "expected report(integer or string) or an immutable local declaration");
        exit(2);
    }
    loop position < size {
        nameStart := position;
        if not isNameStart(textAt(source, position)) {
            reportError(prefix + "expected report(integer or string) or an immutable local declaration");
            exit(2);
        }
        position = skipName(source, position);
        name := textSlice(source, nameStart, position);
        position = skipSpaces(source, position);
        if name == "report" {
            if position >= size or textAt(source, position) =!= "(" {
                reportError(prefix + "expected ( after report");
                exit(2);
            }
            position = skipSpaces(source, position + 1);
            loop true {
                argument := parseExpression(source, position, prefix, locals);
                push_back(mut items, (kind = argument.kind, name = "", runtime = "", code = argument.code,
                    intValue = argument.intValue, textValue = argument.textValue));
                position = skipSpaces(source, argument.next);
                if position < size and textAt(source, position) == "," {
                    position = skipSpaces(source, position + 1);
                } else {
                    break;
                }
            }
            position = expectSymbol(source, position, ")", prefix);
            position = skipSpaces(source, position);
            if position < size and textAt(source, position) == ";" {
                position = skipSpaces(source, position + 1);
            }
            push_back(mut items, (kind = "End", name = "", runtime = "", code = "",
                intValue = 0, textValue = ""));
        } else {
            if position + 2 > size or textSlice(source, position, position + 2) =!= ":=" {
                reportError(prefix + "expected := after local name " + name);
                exit(2);
            }
            position = skipSpaces(source, position + 2);
            parsed := parseExpression(source, position, prefix, locals);
            position = skipSpaces(source, parsed.next);
            if position >= size or textAt(source, position) =!= ";" {
                reportError(prefix + "expected ; after local declaration " + name);
                exit(2);
            }
            position = skipSpaces(source, position + 1);
            if localIndex(locals, name) >= 0 {
                reportError(prefix + "duplicate local " + name);
                exit(2);
            }
            runtime := "lite_" + name;
            push_back(mut locals, (name = name, runtime = runtime, kind = parsed.kind,
                code = parsed.code, intValue = parsed.intValue, textValue = parsed.textValue));
            push_back(mut items, (kind = "Local" + parsed.kind, name = name, runtime = runtime,
                code = parsed.code, intValue = parsed.intValue, textValue = parsed.textValue));
        }
    }
    items
}
