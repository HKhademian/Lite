/* Full-program parser dump. Test helper, not a public command. */

parser := import "../../src/parser.lts";

var prefix := "";
var argCount := 0;
loop inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    reportError("expected at most one logical source name argument");
    exit(2);
}
    parser.testDumpProgram(inputAll(), prefix);
