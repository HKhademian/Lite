/* Checker phase regression suite migrated from igniter/test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

sel := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + sel.error, sel.ok);

contracts := compilerTest.readProcessContracts(root);
parserProgRel := "compiler/tests/parser/parser-program-dump.lts";
checkerRel := "compiler/tests/checker/checker-dump.lts";

progDriver := compilerTest.prepareDriver(root, sel.path, parserProgRel);
checkerDriver := compilerTest.prepareDriver(root, sel.path, checkerRel);

/* Lite checker collects value bindings and rejects unsupported duplicate symbols */
symSrc := fs.readText(path.join(root, "compiler/tests/checker/symbols.lts"));
symExp := fs.readText(path.join(root, "compiler/tests/checker/symbols.symbols"));
test.check("read symbols fixture", symSrc.ok and symExp.ok);
compilerTest.assertDriver(checkerDriver, "symbols exact", symSrc.text, 0, symExp.text, "");

badCheckCases: List<String> = [
"f := fn(a: Int): Int { a }\nf := fn(): Int { 1 }\n",
"var x := 1; x := 2; x = 3;\n",
"x: Missing = 1;\n",
"A := alias B;\nB := alias A;\n",
"f := fn(a: Int, a: Int): Int { a }\n",
"f := fn(a: Int): Int { a = 2; a }\n",
"f := fn(): Int { y = 2; 1 }\n",
"f := fn(): Int { if true { x := 1; } x = 2; 1 }\n",
"f := fn(a: Int, b: Int): Int { a + b }\ng := fn(): Int { f(1) }\n",
"x: Int = \"bad\";\n",
"f := fn(): Int { var x := 1; x = \"bad\"; x }\n",
"f := fn(): Int { if 1 { 2 } else { 3 } }\n",
"f := fn(): Int { loop 1 { return 2; } 3 }\n",
"f := fn(a: Int): Int { a } g := fn(): Int { f(\"bad\") }\n",
"f := fn(): Int { return; }\n",
"f := fn(): Int { break; 1 }\n",
"f := fn(): String { return 1; }\n",
"Pair := alias (a: Int, b: String); p: Pair = (a = 1, b = \"x\"); x: Int = p.b;\n",
"values: List<Int> = [1, 2]; x: String = values[0];\n",
"values: List<Int> = [\"bad\"];\n",
"values: List<Int> = []; push_back(mut values, 1);\n",
];
badCheckErrs: List<String> = [
"2:1: duplicate top-level name f\n",
"1:21: cannot assign to immutable local x\n",
"1:1: unknown type Missing\n",
"2:1: recursive type alias B\n",
"1:17: duplicate parameter a\n",
"1:24: cannot assign to immutable local a\n",
"1:18: unknown local y\n",
"1:38: unknown local x\n",
"2:18: function f expects 2 arguments, got 1\n",
"1:1: cannot initialize Int with String\n",
"1:30: cannot assign String to Int local x\n",
"1:18: if condition must be Bool\n",
"1:18: loop condition must be Bool\n",
"1:45: argument 1 of f expects Int, got String\n",
"1:18: return requires a value\n",
"1:18: break outside loop\n",
"1:21: cannot return Int from function returning String\n",
"1:64: cannot initialize Int with String\n",
"1:29: cannot initialize String with Int\n",
"1:1: cannot initialize List<Int> with List<String>\n",
"1:39: cannot mutate list values without mut\n",
];
var bi := 0;
loop bi < 21 {
    _recBad := compilerTest.assertRecordedContract(root, contracts, checkerRel, "checker bad: " + badCheckCases[bi], badCheckCases[bi], 2, "", badCheckErrs[bi], true);
    bi = bi + 1;
}
mutDeclRes := compilerTest.runDriver(checkerDriver, "mut values: List<Int> = [];\n");
test.checkInt("checker prefix mut status: " + mutDeclRes.stderr, 0, mutDeclRes.status);
test.checkText("checker prefix mut stdout", "value|values|mut List<Int> = []|1:5|4\n", mutDeclRes.stdout);
test.checkText("checker prefix mut stderr", "", mutDeclRes.stderr);

goodCheckCases: List<String> = [
"f := fn(): Int { var x := 1; x = 2; x }\n",
"f := fn(x: Int): Int { var y := x; y = y + 1; y }\n",
"f := fn(value: Int): (value: Int, ok: Bool) { (value = value, ok = true) }\n",
"f := fn(a: Int, b: Int): Int { a + b }\ng := fn(): Int { f(1, 2) }\n",
"f := fn(): Int { 1 }\ng := fn(): Int { f() }\n",
"values: List<Int> = [1, 2];\nf := fn(): Int { loop values as value { outputLine(value); } 1 }\n",
"x: Int = 42;\n",
"f := fn(a: Int): Int { a }\ng := fn(): Int { f(1) }\n",
"f := fn(a: String): Int { 1 }\ng := fn(): Int { f(\"ok\") }\n",
"f := fn(): Int { loop true { break; } 1 }\n",
"f := fn(): Unit { return; }\n",
"Pair := alias (a: Int, b: String); p: Pair = (a = 1, b = \"x\"); x: String = p.b;\n",
"values: List<Int> = [1, 2]; x: Int = values[0];\n",
"values: List<String> = [\"ok\", \"yes\"];\n",
"values: List<Int> = [];\n",
"x := 1; x := 2;\n",
"x := 1; x := \"value\";\n",
"f := fn(): Int { x := 1; x := 2; x }\n",
"f := fn(n: Int): Int { var n := n; n = n + 1; return n; }\n",
"values: List<Int> = [1]; loop values as item { item: Int = 2; }\n",
];
loop goodCheckCases as good {
    recGood := compilerTest.assertRecordedContract(root, contracts, checkerRel, "checker good: " + good, good, 0, "", "", false);
    test.check("checker good non-empty: " + good, recGood.stdout =!= "");
    test.checkText("checker good stderr: " + good, "", recGood.stderr);
}

roundtripGood: List<String> = [
"x := 1; x := 2;",
"f := fn(n: Int): Int { var n := n; n = n + 1; return n; }",
"values: List<Int> = [1]; loop values as item { item: Int = 2; }",
"; ;",
"x := 1; x + 2;;",
];
loop roundtripGood as src {
    compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "checker roundtrip good: " + src, src, 0);
}
compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "checker roundtrip bad", "var x := 1; x := 2; x = 3;", 2);

/* Lite parser and checker support subjectless Boolean match */
pv := compilerTest.runDriver(progDriver, "x := match { a == 1 { 10 } _ { 20 } };\n");
test.checkInt("match value parse status", 0, pv.status);
test.check("match value parse output", pv.stdout.contains("Program||x := match { (a == 1) { 10 } _ { 20 } }|"));

pa := compilerTest.runDriver(progDriver, "match { true { outputLine(1); } _ { outputLine(2); } }\n");
test.checkInt("match action parse status", 0, pa.status);
test.check("match action parse output", pa.stdout.contains("Program||match { true { outputLine(1) } _ { outputLine(2) } }|"));

matchParseBadSrc: List<String> = [
"match x { _ => 1 }\n",
"match { true { outputLine(1); } }\n",
"match { _ { outputLine(1); } true { outputLine(2); } }\n",
"x := match { { true } { 1 } _ { 2 } };\n",
];
matchParseBadPat: List<String> = [
"1:1: unsupported feature \"match\"",
"subjectless match requires a final _ fallback arm",
"match fallback _ must be the final arm",
"match arm header requires grouping",
];
var mi := 0;
loop mi < 4 {
    mr := compilerTest.runDriver(progDriver, matchParseBadSrc[mi]);
    test.checkInt("match parse bad status", 2, mr.status);
    test.check("match parse bad msg: " + mr.stderr, mr.stderr.contains(matchParseBadPat[mi]));
    mi = mi + 1;
}

mcSrc :=
"label := match { true { \"yes\" } _ { \"no\" } };\n" +
"classify := fn(n: Int): Int {\n" +
"    match {\n" +
"        n > 0 { a := 1; return a; }\n" +
"        _ { a := 2; return a; }\n" +
"    }\n" +
"}\n" +
"match { (if true { false } else { true }) { b := 1; } _ { b := 2; } }";
mc := compilerTest.runDriver(checkerDriver, mcSrc);
test.checkInt("match check status", 0, mc.status);
test.check("match check value", mc.stdout.contains("value|label|:= match { true { \"yes\" } _ { \"no\" } }|"));
test.check("match check classify", mc.stdout.contains("function|classify|(n: Int): Int|"));

matchCheckBadSrc: List<String> = [
"match x { _ => 1 }\n",
"match { true { x := 1; } }\n",
"match { _ { x := 1; } true { y := 2; } }\n",
"match { 1 { x := 2; } _ { y := 3; } }\n",
"x := match { 1 { 2 } _ { 3 } };\n",
"f := fn(): Int { return match { 1 { 2 } _ { 3 } }; }\n",
"f := fn(): String { return match { true { 1 } _ { 2 } }; }\n",
"x: String = match { true { 1 } _ { 2 } };\n",
];
matchCheckBadPat: List<String> = [
"1:1: unsupported feature \"match\"",
"subjectless match requires a final _ fallback arm",
"match fallback _ must be the final arm",
"match arm condition must be Bool",
"match arm condition must be Bool",
"match arm condition must be Bool",
"cannot return Int from function returning String",
"cannot initialize String with Int",
];
var mci := 0;
loop mci < 8 {
    mcr := compilerTest.runDriver(checkerDriver, matchCheckBadSrc[mci]);
    test.checkInt("match check bad status", 2, mcr.status);
    test.check("match check bad msg: " + mcr.stderr, mcr.stderr.contains(matchCheckBadPat[mci]));
    mci = mci + 1;
}

/* Lite parser and checker support narrow numeric widths and literal contexts */
npSrc :=
"Byte := alias Int8;\n" +
"a: Int8 = -128;\n" +
"b: Int16 = 32767;\n" +
"c: Int32 = 2147483647;\n" +
"f: Float32 = 0.5;\n" +
"widen := fn(x: Byte): Float32 { x }\n" +
"xs: List<Int8> = [1, 2];";
np := compilerTest.runDriver(progDriver, npSrc);
test.checkInt("narrow parse status", 0, np.status);
test.check("narrow Byte", np.stdout.contains("Byte := alias Int8"));
test.check("narrow a", np.stdout.contains("a Int8 = (-128)"));
test.check("narrow b", np.stdout.contains("b Int16 = 32767"));
test.check("narrow c", np.stdout.contains("c Int32 = 2147483647"));
test.check("narrow f", np.stdout.contains("f Float32 = 0.5"));
test.check("narrow widen", np.stdout.contains("widen := fn(x: Byte): Float32 { x }"));
test.check("narrow xs", np.stdout.contains("xs List<Int8> = [1, 2]"));

ncSrc :=
"a: Int8 = -128;\n" +
"b: Int16 = 32767;\n" +
"c: Int32 = 2147483647;\n" +
"f: Float32 = 16777216;\n" +
"x: Int16 = a;\n" +
"y: Float32 = b;\n" +
"z: Float = c;\n" +
"s: Int16 = a + b;\n" +
"m: Float32 = a + f;\n" +
"p: Float = a ** 2;\n" +
"xs: List<Int8> = [1, -2];";
nc := compilerTest.runDriver(checkerDriver, ncSrc);
test.checkInt("narrow check status", 0, nc.status);
test.check("narrow check a", nc.stdout.contains("value|a|Int8 = (-128)|"));
test.check("narrow check m", nc.stdout.contains("value|m|Float32 = (a + f)|"));
test.check("narrow check xs", nc.stdout.contains("value|xs|List<Int8> = [1, (-2)]|"));

narrowBadSrc: List<String> = [
"x: Int8 = 128;\n",
"f: Float32 = 16777217;\n",
"f: Float32 = 1e39;\n",
"a: Int16 = 1; b: Int8 = a;\n",
"c: Int32 = 1; f: Float32 = c;\n",
"x: Int8 = +1;\n",
"x: Int8 = -(1);\n",
"x: Int8 = 1 + 2;\n",
"xs: List<Int8> = [1]; ys: List<Int16> = xs;\n",
];
narrowBadPat: List<String> = [
"cannot initialize Int8 with Int",
"cannot initialize Float32 with Int",
"cannot initialize Float32 with Float",
"cannot initialize Int8 with Int16",
"cannot initialize Float32 with Int32",
"cannot initialize Int8 with Int",
"cannot initialize Int8 with Int",
"cannot initialize Int8 with Int",
"cannot initialize List<Int16> with List<Int8>",
];
var ni := 0;
loop ni < 9 {
    nr := compilerTest.runDriver(checkerDriver, narrowBadSrc[ni]);
    test.checkInt("narrow bad status", 2, nr.status);
    test.check("narrow bad msg: " + nr.stderr, nr.stderr.contains(narrowBadPat[ni]));
    ni = ni + 1;
}

/* Lite numeric alias phases normalize built-in synonyms across annotations and signatures */
aliasGood: List<String> = [
"i: Int64 = 2; f: Float64 = 0.5; d: Double = 1.5;",
"Count := alias Int64; f := fn(n: Count, x: Double): Float64 { return x; } y := f(2, 0.5);",
"p: (i: Int64, f: Double) = (i = 2, f = 0.5); xs: List<Int64> = [1, 2];",
];
loop aliasGood as src {
    compilerTest.assertDriverMatchesContract(root, contracts, parserProgRel, progDriver, "alias parser: " + src, src, 0);
    compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "alias checker: " + src, src, 0);
}
aliasBad: List<String> = ["x: Int64 = \"x\";", "x: Double = false;", "f := fn(): Int64 { return 0.5; }"];
loop aliasBad as src {
    compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "alias checker bad: " + src, src, 2);
}

/* Lite checker admits exact scalar integer literals in Float contexts without widening values */
floatLitGood: List<String> = [
"f: Float = 2; d: Double = -3; g: Float64 = ((4));",
"var f: Float = 2; f = -4;",
"f := fn(): Float { return (-2); } x := f();",
"f := fn(n: Float): Float { return n; } x := f(2);",
"f: Float = -9223372036854775808;",
];
floatLitBad: List<String> = [
"f: Float = 9007199254740993;",
"i := 2; f: Float = i;",
"f: Float = 2 + 3;",
"f: Float = +2;",
"f: Float = -(2);",
"f := fn(): Float { return 9007199254740993; }",
];
loop floatLitGood as src {
    compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "float lit good: " + src, src, 0);
}
loop floatLitBad as src {
    compilerTest.assertDriverMatchesContract(root, contracts, checkerRel, checkerDriver, "float lit bad: " + src, src, 2);
}

compilerTest.disposeDriver(progDriver);
compilerTest.disposeDriver(checkerDriver);
