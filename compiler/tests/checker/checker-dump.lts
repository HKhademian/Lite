/* Top-level checker dump. Test helper, not a public command. */

checker := import "../../src/check.lts";
io := import "core/io";

var prefix := "";
var argCount := 0;
loop io.inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    io.errorLine("expected at most one logical source name argument");
    io.exit(2);
}
checker.testDumpSymbols(io.inputAll(), prefix);
