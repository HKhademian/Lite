/* Top-level checker dump. Test helper, not a public command. */

checker := import "../../src/check.lts";

var prefix := "";
var argCount := 0;
loop inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    reportError("expected at most one logical source name argument");
    exit(2);
}
checker.testDumpSymbols(inputAll(), prefix);
