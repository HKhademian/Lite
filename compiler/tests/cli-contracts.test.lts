    test.checkInt("verify --all status: " + verified.stderr, 0, verified.status);
    test.check("verify signed-arithmetic", text.containsText(verified.stdout, "PASS feature.numeric.integers.signed-arithmetic/precedence-and-division"));
    test.check("verify double-sum", text.containsText(verified.stdout, "PASS example.foundations.io.double-sum/seven-and-five"));
    test.check("verify ts", text.containsText(verified.stdout, "[ts]"));
    test.check("verify no T00", not text.containsText(verified.stdout, "T00 reference"));
    test.check("verify c", text.containsText(verified.stdout, "[c]"));
    test.check("verify match", text.containsText(verified.stdout, "PASS feature.control.branching.subjectless-match/first-true-and-fallback [ts]"));
    test.check("verify widths", text.containsText(verified.stdout, "PASS feature.numeric.widths.sized-promotion/widths [ts]"));
    test.check("verify fn values", text.containsText(verified.stdout, "PASS feature.functions.callables.function-values/double-five [ts]"));
    test.check("verify blocks", text.containsText(verified.stdout, "PASS feature.blocks.wiring.parallel-symbol-wiring/even-four [ts]"));
    test.check("verify showcase", text.containsText(verified.stdout, "PASS showcase.foundations.bindings.bindings-and-mutability/bindings-and-mutability [ts]"));
    test.check("verify counts", text.containsText(verified.stdout, "verification passed:") and text.containsText(verified.stdout, "executed, 0 cached"));

    covered := runCmd(liteBin, ["verify", "--coverage"], root, vEnv, "");
    test.checkInt("verify --coverage status", 0, covered.status);
    test.check("coverage features", text.containsText(covered.stdout, "features: 58 registered, 58 cases"));
    test.check("coverage examples", text.containsText(covered.stdout, "examples: 32/32 manifests"));
    test.check("coverage samples", text.containsText(covered.stdout, "samples: 28/28 manifests"));
    test.check("coverage showcases", text.containsText(covered.stdout, "showcases: 23/23 manifests"));

    firstV := runCmd(liteBin, ["verify", "--all", "--filter", "features/numeric/integers/signed-arithmetic.json"], root, vEnv, "");
    test.checkInt("verify cache 1", 0, firstV.status);
    test.check("verify cache 1 count", text.containsText(firstV.stdout, "0 cached"));
    secondV := runCmd(liteBin, ["verify", "--all", "--filter", "features/numeric/integers/signed-arithmetic.json"], root, vEnv, "");
    test.checkInt("verify cache 2", 0, secondV.status);
    test.check("verify cache 2 count", text.containsText(secondV.stdout, "0 executed, "));
    test.check("verify cache 2 label", text.containsText(secondV.stdout, "(cached)"));
    shardedV := runCmd(liteBin, ["verify", "--all", "--filter", "features/numeric/integers/signed-arithmetic.json", "--shard", "2/2", "--no-cache"], root, vEnv, "");
    test.checkInt("verify shard", 0, shardedV.status);
    test.check("verify shard no cache", text.containsText(shardedV.stdout, "0 cached"));
    _rmV := fs.remove(vTmp);
}

