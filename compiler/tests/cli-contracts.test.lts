/* CLI, launcher, source-name, doc-comment, reference adapter, and determinism suites migrated from igniter/test.ts. */

crypto := import "core/crypto";
fs := import "core/file";
integer := import "core/int";
list := import "core/list";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
text := import "core/text";
unicode := import "core/unicode";
cases := import "util/cases";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

heavyEnv := proc.envGet("LITE_SKIP_HEAVY");
skipHeavy := heavyEnv.found and heavyEnv.value == "1";

tsComp := compilerBuild.selectCompilerPath(root, "ts").path;
cComp := compilerBuild.selectCompilerPath(root, "c").path;
test.check("ts & c compiler paths resolved", tsComp =!= "" and cComp =!= "");

runCmd := fn(exe: String, args: List<String>, cwd: String, envOver: List<String>, stdinStr: String): (status: Int, stdout: String, stderr: String) {
    tmpRes := fs.makeTempDir("lite-cli-cmd-");
    test.check("runCmd makeTempDir", tmpRes.ok);
    outP := path.join(tmpRes.path, "out");
    errP := path.join(tmpRes.path, "err");
    res := proc.runBytes(exe, args, cwd, envOver, 180000, unicode.utf8Encode(stdinStr), outP, errP);
    test.check("runCmd error: " + res.error, res.error == "");
    outText := fs.readText(outP).text;
    errText := fs.readText(errP).text;
    _rm := fs.remove(tmpRes.path);
    (status = res.status, stdout = outText, stderr = errText)
};

emptyEnv := fn(): List<String> {
    res: List<String> = [];
    res
};

/* compiler applications preserve optional logical source names in their own diagnostics only */
comps: List<String> = [tsComp, cComp];
labels: List<String> = ["", "a b.lts", "سلام🙂.lts", "quote\";\\\nname.lts"];
loop comps as comp {
    expectedOut := compilerTest.compileStdin(root, comp, "io := import \"core/io\"; io.outputLine(42);", "").stdout;
    loop labels as label {
        okRes := compilerTest.compileStdin(root, comp, "io := import \"core/io\"; io.outputLine(42);", label);
        test.checkInt("label ok status " + label, 0, okRes.status);
        test.checkText("label ok out " + label, expectedOut, okRes.stdout);
        test.checkText("label ok err " + label, "", okRes.stderr);

        pfx := if label == "" { "" } else { label + ":" };
        badRes := compilerTest.compileStdin(root, comp, "io := import \"core/io\"; io.outputLine(1 +);", label);
        test.checkInt("label bad status " + label, 2, badRes.status);
        test.checkText("label bad out " + label, "", badRes.stdout);
        test.checkText("label bad err " + label, pfx + "1:42: expected an Int, Float, String or Bool expression\n", badRes.stderr);
    }
    firstRes := compilerTest.compileStdin(root, comp, "x := 1 +;", "first.lts");
    test.checkInt("first.lts status", 2, firstRes.status);
    test.checkText("first.lts err", "first.lts:1:9: expected an Int, Float, String or Bool expression\n", firstRes.stderr);
}

