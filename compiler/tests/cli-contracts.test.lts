test.checkText("run-report.ts out", "42\n", repRes.stdout);
test.checkText("run-report.ts err", "", repRes.stderr);

/* source graph artifacts are deterministic and leak no timestamps or host paths */
detSrc := "io := import \"core/io\"; x := 1;\nio.outputLine(x + 1);\n";
d1 := compilerTest.compileStdin(root, tsComp, detSrc, "");
d2 := compilerTest.compileStdin(root, tsComp, detSrc, "");
test.checkInt("det 1 status", 0, d1.status);
test.checkText("det identical", crypto.sha256Text(d1.stdout), crypto.sha256Text(d2.stdout));
test.checkText("det err", crypto.sha256Text(d1.stderr), crypto.sha256Text(d2.stderr));
test.check("no root leaked", not text.containsText(d1.stdout, root));
test.check("no cwd leaked", not text.containsText(d1.stdout, proc.cwd()));
test.check("no tmp leaked", not text.containsText(d1.stdout, "/tmp"));
test.check("no timestamp Z leaked", not text.containsText(d1.stdout, "T00:00:00"));
