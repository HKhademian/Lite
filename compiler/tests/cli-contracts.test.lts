/* whole-source TS and C compilers reject later statements and decoding failures before artifact output */
rejDir := fs.makeTempDir("litec-reject-").path;
rejSrc := path.join(rejDir, "source.lts");
rejBadInputs: List<String> = [" \n}", "io := import \"core/io\"; io.outputLine(42);\nunsupported();\n", "io := import \"core/io\"; io.outputLine(42);\nprocess.io.exit(7);\n"];
var ti := 0;
loop ti < 2 {
    isTs := ti == 0;
    _wRejE := fs.writeText(rejSrc, "");
    emptyOut := if isTs { runCmd(path.join(root, "bin/lite-compile-ts"), [rejSrc], root, emptyEnv(), "") } else { runCmd(proc.execPath(), [cComp, rejSrc], root, emptyEnv(), "") };
    test.checkInt("whole empty status", 0, emptyOut.status);
    test.check("whole empty out", emptyOut.stdout =!= "");
    test.checkText("whole empty err", "", emptyOut.stderr);

    loop rejBadInputs as badIn {
        _wRejB := fs.writeText(rejSrc, badIn);
        badOut := if isTs { runCmd(path.join(root, "bin/lite-compile-ts"), [rejSrc], root, emptyEnv(), "") } else { runCmd(proc.execPath(), [cComp, rejSrc], root, emptyEnv(), "") };
        test.checkInt("whole bad status", 2, badOut.status);
        test.checkText("whole bad out", "", badOut.stdout);
        test.check("whole bad err", badOut.stderr =!= "");
    }

    badUtf8: mut List<Int> = unicode.utf8Encode("io := import \"core/io\"; io.outputLine(42);\n");
    list.pushBack(mut badUtf8, 255);
    _wUtf := fs.writeBytes(rejSrc, badUtf8);
    utfOut := if isTs { runCmd(path.join(root, "bin/lite-compile-ts"), [rejSrc], root, emptyEnv(), "") } else { runCmd(proc.execPath(), [cComp, rejSrc], root, emptyEnv(), "") };
    test.checkInt("whole utf8 status", 1, utfOut.status);
    test.checkText("whole utf8 out", "", utfOut.stdout);
    test.check("whole utf8 err", text.containsText(utfOut.stderr, "InputFault: cannot read input"));
    ti = ti + 1;
}
_rmRej := fs.remove(rejDir);

/* checked-in TS output and explicit Node adapter typecheck and reproduce the reference bytes */
