/* compiler, L0 and lexer declarations carry doc comments */
splitLines := fn(content: String): List<String> {
    lines: mut List<String> = [];
    size := text.length(content);
    var start := 0;
    var i := 0;
    loop i <= size {
        if i == size or text.at(content, i) == "\n" {
            list.pushBack(mut lines, text.slice(content, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    lines
};
isDocDeclLine := fn(line: String): Bool {
    trimmed := text.trimStart(line);
    if text.startsWithAt(line, 0, " ") or text.startsWithAt(line, 0, "\t") { return false; }
    colEq := text.indexOfText(trimmed, " := fn", 0);
    colEqT := text.indexOfText(trimmed, " := type", 0);
    if colEq < 0 and colEqT < 0 { return false; }
    text.indexOfText(trimmed, " ", 0) == colEq or text.indexOfText(trimmed, " ", 0) == colEqT
};
docDirs: List<String> = [path.join(root, "lib/core"), path.join(root, "compiler/src")];
docFiles := path.collectFiles(root, docDirs, ".lts", [], false);
loop docFiles as docFile {
    content := fs.readText(docFile).text;
    docLines := splitLines(content);
    lineCnt := list.listCountText(docLines);
    var dli := 0;
    loop dli < lineCnt {
        if isDocDeclLine(docLines[dli]) {
            var prev := dli - 1;
            loop prev >= 0 and text.trim(docLines[prev]) == "" {
                prev = prev - 1;
            }
            var documented := false;
            if prev >= 0 {
                lastTrim := text.trim(docLines[prev]);
                if text.startsWithAt(lastTrim, 0, "/**") and text.endsWith(lastTrim, "*/") {
                    documented = true;
                } else if text.endsWith(lastTrim, "*/") {
                    var start := prev;
                    loop start >= 0 {
                        stTrim := text.trim(docLines[start]);
                        if text.startsWithAt(stTrim, 0, "/**") {
                            documented = true;
                            break;
                        }
                        if text.startsWithAt(stTrim, 0, "/*") { break; }
                        start = start - 1;
                    }
                }
            }
            test.check(docFile + ":" + integer.intText(dli + 1) + ": missing doc comment", documented);
        }
        dli = dli + 1;
    }
}

