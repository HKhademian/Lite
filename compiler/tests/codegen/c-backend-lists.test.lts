/* End-to-end C11 execution tests for Phase C3: Fixed Arrays [T; N], Growable List<T>, slicing, core/list, and loop traversal. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

ccInfo := compilerTest.probeCc();
test.check("cc available", ccInfo.cc =!= "");

listProg :=
"io := import \"core/io\";\n" +
"list := import \"core/list\";\n" +
"sumList := fn(xs: List<Int>): Int {\n" +
"    var total := 0;\n" +
"    loop xs as x { total += x; }\n" +
"    total\n" +
"};\n" +
"arr := [10, 20, 30, 40];\n" +
"nums: mut List<Int> = [2, 3];\n" +
"list.pushFront(mut nums, 1);\n" +
"list.pushBack(mut nums, 4);\n" +
"saved: List<Int> = nums;\n" +
"nums[0] = 9;\n" +
"nums[1] += 10;\n" +
"back := list.popBack(mut nums);\n" +
"front := list.popFront(mut nums);\n" +
"rev := list.reverse(saved);\n" +
"sl := saved[1..3];\n" +
"slOpen := saved[2..];\n" +
"words: List<String> = [\"lite\", \"c11\"];\n" +
"flags: List<Bool> = [true, false];\n" +
"vals: List<Float> = [1.5, 2.5];\n" +
"io.outputLine(arr.length, arr.isEmpty, arr[1], arr[1..3]);\n" +
"io.outputLine(saved, sumList(saved), rev, sl, slOpen);\n" +
"io.outputLine(front, back, nums, nums.length);\n" +
"io.outputLine(words, words.length, flags, vals);\n";

cRes := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, listProg, "", "");
test.checkInt("C lists run: " + cRes.stderr, 0, cRes.status);
tsRes := compilerTest.compileCheckRunTs(root, tsComp, listProg, "");
test.checkInt("TS lists run: " + tsRes.stderr, 0, tsRes.status);
test.checkText("C/TS list stdout parity", tsRes.stdout, cRes.stdout);
test.checkText("C list exact stdout",
"4 false 20 [20, 30]\n[1, 2, 3, 4] 10 [4, 3, 2, 1] [2, 3] [3, 4]\n9 4 [12, 3] 2\n[lite, c11] 2 [true, false] [1.5, 2.5]\n",
cRes.stdout);

test.done("c-backend-lists");
