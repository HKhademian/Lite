/* Control-flow codegen and diagnostic tests migrated from igniter/test.ts. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

loopCase0 :=
"io := import \"core/io\";\n" +
"var i := 0;\n" +
"var total := 0;\n" +
"loop i < 10 {\n" +
"    i = i + 1;\n" +
"    if i == 3 { continue; }\n" +
"    if i == 6 { break; }\n" +
"    total = total + i;\n" +
"}\n" +
"io.outputLine(total);";
loopCase1 :=
"io := import \"core/io\";\n" +
"var n := 0;\n" +
"loop {\n" +
"    n = n + 1;\n" +
"    if n == 2 { continue; }\n" +
"    if n == 4 { break; }\n" +
"    io.outputLine(n);\n" +
"}\n" +
"io.outputLine(n);";
loopCase2 :=
"io := import \"core/io\";\n" +
"var outer := 0;\n" +
"var visits := 0;\n" +
"loop outer < 2 {\n" +
"    outer = outer + 1;\n" +
"    var inner := 0;\n" +
"    loop true {\n" +
"        inner = inner + 1;\n" +
"        if inner == 2 { continue; }\n" +
"        if inner == 4 { break; }\n" +
"        visits = visits + 1;\n" +
"    }\n" +
"    io.outputLine(outer, inner);\n" +
"    visits = visits + 10;\n" +
"}\n" +
"io.outputLine(visits);";
loopCase3 :=
"io := import \"core/io\";\n" +
"values: List<Int> = [1, 2, 3, 4, 5];\n" +
"loop values as value {\n" +
"    if value == 2 { continue; }\n" +
"    if value == 5 { break; }\n" +
"    io.outputLine(value);\n" +
"}";

loopSources: List<String> = [loopCase0, loopCase1, loopCase2, loopCase3];
loopOuts: List<String> = ["12\n", "1\n3\n4\n", "1 4\n2 4\n24\n", "1\n3\n4\n"];

/* restricted compiler lowers bare break and continue to runnable TS */
var li := 0;
loop li < 4 {
    tsOut := compilerTest.compileStdin(root, tsComp, loopSources[li], "");
    test.checkInt("loop TS compile", 0, tsOut.status);
    test.check("loop TS contains break/continue", tsOut.stdout.contains("break;") or tsOut.stdout.contains("continue;"));
    compilerTest.assertCompileRunTs(root, tsComp, "loop TS " + loopOuts[li], loopSources[li], loopOuts[li]);
    li = li + 1;
}

/* restricted compiler lowers bare break and continue to runnable C */
if ccInfo.available {
    var ci := 0;
    loop ci < 3 {
        cCompRes := compilerTest.compileStdin(root, cComp, loopSources[ci], "");
        test.checkInt("loop C compile", 0, cCompRes.status);
        test.check("loop C contains break/continue", cCompRes.stdout.contains("break;") or cCompRes.stdout.contains("continue;"));
        cRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, loopSources[ci], "", "");
        test.checkInt("loop C run status", 0, cRun.status);
        test.checkText("loop C stdout", loopOuts[ci], cRun.stdout);
        test.checkText("loop C stderr", "", cRun.stderr);
        ci = ci + 1;
    }
}

/* restricted compiler diagnoses break and continue outside loops */
loopBadSrc: List<String> = [
"break;\n",
"continue;\n",
"if true { break; }\n",
"var i := 0;\nloop i < 1 { i = i + 1; }\nbreak;\n",
"var i := 0;\nloop i < 1 { i = i + 1; }\ncontinue;\n",
"io := import \"core/io\"; f := fn(): Int { loop true { break; } break; 1 }\nio.outputLine(f());\n",
"loop true { continue @outer; }\n",
];
loopBadErr: List<String> = [
"1:1: break outside loop\n",
"1:1: continue outside loop\n",
"1:11: break outside loop\n",
"3:1: break outside loop\n",
"3:1: continue outside loop\n",
"1:63: break outside loop\n",
"1:22: unknown block tag @outer\n",
];
var lbi := 0;
loop lbi < 7 {
    compilerTest.assertCompileError(root, tsComp, "loop bad TS " + loopBadSrc[lbi], loopBadSrc[lbi], loopBadErr[lbi]);
    compilerTest.assertCompileError(root, cComp, "loop bad C " + loopBadSrc[lbi], loopBadSrc[lbi], loopBadErr[lbi]);
    lbi = lbi + 1;
}
cLoopPay := compilerTest.compileStdin(root, cComp, "loop true { break 1; }\n", "");
test.checkInt("loop payload C compiles: " + cLoopPay.stderr, 0, cLoopPay.status);

/* restricted compiler accepts one optional leading and/or in Bool expressions for TS */
leadTsSrc :=
"io := import \"core/io\";\n" +
"pick := fn(flag: Bool, other: Bool): Bool { or flag and other }\n" +
"explicit := fn(flag: Bool): Bool { return and flag; }\n" +
"var n := 0;\n" +
"loop and n < 3 {\n    n = n + 1;\n}\n" +
"ready := or n == 3 or n == 4;\n" +
"single := and ready;\n" +
"var flag := true;\n" +
"flag = and ready and not false;\n" +
"io.outputLine(ready, single, flag);\n" +
"if or ready and flag {\n    io.outputLine(\"or-if\");\n}\n" +
"if and ready {\n    io.outputLine(\"and-if\");\n}\n" +
"io.outputLine(pick(or ready and flag, and flag), explicit(or ready));\n" +
"value := if and ready { 7 } else { 9 };\n" +
"io.outputLine(value);\n" +
"io.outputLine(and (or ready or false) and flag);\n" +
"io.outputLine(and true, or false);\n";
leadTsCompiled := compilerTest.compileStdin(root, tsComp, leadTsSrc, "");
test.checkInt("lead TS compile", 0, leadTsCompiled.status);
test.check("lead TS contains && or ||", leadTsCompiled.stdout.contains("&&") or leadTsCompiled.stdout.contains("||"));
compilerTest.assertCompileRunTs(root, tsComp, "lead TS", leadTsSrc, "true true true\nor-if\nand-if\ntrue true\n7\ntrue\ntrue false\n");

/* restricted compiler accepts one optional leading and/or in Bool expressions for C */
leadCSrc :=
"io := import \"core/io\";\n" +
"var n := 0;\n" +
"loop and n < 3 { n = n + 1; }\n" +
"ready := or n == 3 or n == 4;\n" +
"single := and ready;\n" +
"var flag := true;\n" +
"flag = and ready and not false;\n" +
"io.outputLine(ready, single, flag);\n" +
"if or ready and flag { io.outputLine(\"or-if\"); }\n" +
"if and ready { io.outputLine(\"and-if\"); }\n" +
"io.outputLine(and (or ready or false) and flag);\n" +
"io.outputLine(and true, or false);\n";
if ccInfo.available {
    leadCComp := compilerTest.compileStdin(root, cComp, leadCSrc, "");
    test.checkInt("lead C compile", 0, leadCComp.status);
    test.check("lead C contains && or ||", leadCComp.stdout.contains("&&") or leadCComp.stdout.contains("||"));
    leadCRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, leadCSrc, "", "");
    test.checkInt("lead C run", 0, leadCRun.status);
    test.checkText("lead C stdout", "true true true\nor-if\nand-if\ntrue\ntrue false\n", leadCRun.stdout);
}

/* restricted compiler diagnoses invalid leading and/or forms */
condMsg := "unsupported feature";
leadBadSrc: List<String> = [
"x := and 1;",
"x := or [1];",
"flag := or \"text\";",
"io := import \"core/io\"; if and (1) { io.outputLine(1); }",
"loop and 1 { }",
"x := and and true;",
"io := import \"core/io\"; if or and ready { io.outputLine(1); }",
"x := true and;",
"io := import \"core/io\"; if true or { io.outputLine(1); }",
"x := or;",
"x := true and or false;",
"x := not and true;",
];
leadBadErr: List<String> = [
"1:6: leading and requires a Bool expression\n",
"1:6: leading or requires a Bool expression\n",
"1:9: leading or requires a Bool expression\n",
"1:28: leading and requires a Bool expression\n",
"1:6: leading and requires a Bool expression\n",
"1:10: leading and may appear only once\n",
"1:31: leading or may appear only once\n",
"1:14: expected an Int, Float, String or Bool expression\n",
"1:38: host output functions are standalone statements\n",
"1:8: expected an Int, Float, String or Bool expression\n",
"1:15: " + condMsg + " \"or\": see docs/conditionals.md; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only\n",
"1:10: " + condMsg + " \"and\": see docs/conditionals.md; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only\n",
];
var ldi := 0;
loop ldi < 12 {
    compilerTest.assertCompileError(root, tsComp, "lead bad TS " + leadBadSrc[ldi], leadBadSrc[ldi], leadBadErr[ldi]);
    compilerTest.assertCompileError(root, cComp, "lead bad C " + leadBadSrc[ldi], leadBadSrc[ldi], leadBadErr[ldi]);
    ldi = ldi + 1;
}

/* restricted compiler compiles action else-if chains to runnable TS */
elseIfTsSrc :=
"io := import \"core/io\";\n" +
"classify := fn (n: Int): String {\n" +
"    if n < 0 {\n        return \"negative\";\n    } else if n == 0 {\n        return \"zero\";\n    } else if n < 10 {\n        return \"small\";\n    } else {\n        return \"large\";\n    }\n}\n" +
"noFinal := fn (n: Int): String {\n" +
"    if n < 0 { return \"negative\"; }\n" +
"    else if n == 0 { return \"zero\"; }\n" +
"    return \"positive\";\n}\n" +
"nested := fn (a: Int, b: Bool): String {\n" +
"    if a < 0 {\n        if b { return \"negative-flagged\"; }\n        else if a < -10 { return \"very-negative\"; }\n        else { return \"negative\"; }\n    } else if b {\n        return \"flagged\";\n    } else {\n        return \"plain\";\n    }\n}\n" +
"loopReport := fn (limit: Int): Unit {\n" +
"    var index := 0;\n" +
"    loop index < limit {\n" +
"        if index == 0 {\n            io.outputLine(\"loop-zero\", index);\n        } else if index == 1 {\n            io.outputLine(\"loop-one\", index);\n        } else if index == 2 {\n            io.outputLine(\"loop-two\", index);\n        } else {\n            io.outputLine(\"loop-many\", index);\n        }\n" +
"        index = index + 1;\n    }\n}\n" +
"x := 2;\n" +
"io.outputLine(classify(-1), classify(0), classify(5), classify(50));\n" +
"io.outputLine(noFinal(-1), noFinal(0), noFinal(5));\n" +
"io.outputLine(nested(-1, true), nested(-20, false), nested(-5, false), nested(1, true), nested(1, false));\n" +
"io.outputLine(\"before\");\n" +
"if x == 1 { io.outputLine(\"one\"); }\n" +
"else if x == 2 { io.outputLine(\"two-first\"); io.outputLine(\"two-second\"); }\n" +
"else if x == 3 { io.outputLine(\"three\"); }\n" +
"else { io.outputLine(\"other\"); }\n" +
"io.outputLine(\"after\");\n" +
"loopReport(4);\n" +
"var total := 0;\n" +
"if true { armLocal := 1; total = total + armLocal; }\n" +
"else if false { armLocal := 2; total = total + armLocal; }\n" +
"else { armLocal := 3; total = total + armLocal; }\n" +
"io.outputLine(total, x);\n" +
"io.outputLine(\"end\");";
elseIfTsComp := compilerTest.compileStdin(root, tsComp, elseIfTsSrc, "");
test.checkInt("else-if TS compile", 0, elseIfTsComp.status);
test.check("else-if TS emitted", elseIfTsComp.stdout.contains("    } else if ("));
elseIfTsExp :=
"negative zero small large\nnegative zero positive\nnegative-flagged very-negative negative flagged plain\n" +
"before\ntwo-first\ntwo-second\nafter\nloop-zero 0\nloop-one 1\nloop-two 2\nloop-many 3\n1 2\nend\n";
compilerTest.assertCompileRunTs(root, tsComp, "else-if TS run", elseIfTsSrc, elseIfTsExp);

/* restricted compiler compiles action else-if chains to runnable C */
elseIfCSrc :=
"io := import \"core/io\";\n" +
"var index := 0;\n" +
"loop index < 3 {\n" +
"    if index == 0 { io.outputLine(\"zero\", index); }\n" +
"    else if index == 1 { io.outputLine(\"one\", index); }\n" +
"    else if index == 2 { io.outputLine(\"two\", index); }\n" +
"    else { io.outputLine(\"many\", index); }\n" +
"    index = index + 1;\n}\n" +
"var x := 2;\n" +
"if x == 1 { io.outputLine(\"one\"); }\n" +
"else if x == 2 {\n" +
"    if index == 3 {\n        io.outputLine(\"nested\", x);\n    } else if index == 4 {\n        io.outputLine(\"nested-four\", x);\n    } else {\n        io.outputLine(\"nested-other\", x);\n    }\n" +
"} else { io.outputLine(\"other\"); }\n" +
"if x == 1 { io.outputLine(\"skip\"); }\n" +
"else if x == 2 { io.outputLine(\"two-arm\"); }\n" +
"if x == 1 { io.outputLine(\"a\"); }\n" +
"else if x == 3 { io.outputLine(\"b\"); }\n" +
"io.outputLine(\"done\");";
elseIfCComp := compilerTest.compileStdin(root, cComp, elseIfCSrc, "");
test.checkInt("else-if C compile", 0, elseIfCComp.status);
test.check("else-if C emitted", elseIfCComp.stdout.contains("    } else if ("));
if ccInfo.available {
    elseIfCRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, elseIfCSrc, "", "");
    test.checkInt("else-if C run", 0, elseIfCRun.status);
    test.checkText("else-if C stdout", "zero 0\none 1\ntwo 2\nnested 2\ntwo-arm\ndone\n", elseIfCRun.stdout);
}

/* restricted compiler diagnoses invalid action else-if chains */
elseIfBadSrc: List<String> = [
"io := import \"core/io\"; if true { io.outputLine(1); } else if 1 { io.outputLine(2); }\n",
"io := import \"core/io\"; if true { io.outputLine(1); } else if true io.outputLine(2);\n",
"io := import \"core/io\"; if true { io.outputLine(1); } else if { io.outputLine(2); }\n",
"io := import \"core/io\"; if true { io.outputLine(1); } else { io.outputLine(2); } else { io.outputLine(3); }\n",
"io := import \"core/io\"; else if true { io.outputLine(1); }\n",
"io := import \"core/io\"; if true { hidden := 1; } else if hidden == 1 { io.outputLine(2); }\n",
"io := import \"core/io\"; if true { io.outputLine(1); } else if false { io.outputLine(hidden); }\n",
"io := import \"core/io\"; var total := 0;\nif false { hidden := 1; total = total + hidden; } else if hidden == 1 { io.outputLine(2); }\n",
"io := import \"core/io\"; var total := 0;\nif true { hidden := 1; total = total + hidden; }\nio.outputLine(hidden);\n",
];
elseIfBadErr: List<String> = [
"1:63: else if condition must be Bool\n",
"1:68: expected {\n",
"1:65: host output functions are standalone statements\n",
"1:82: unexpected else\n",
"1:25: unexpected else\n",
"1:58: unknown value hidden\n",
"1:85: unknown value hidden\n",
"2:59: unknown value hidden\n",
"3:15: unknown value hidden\n",
];
var ei := 0;
loop ei < 9 {
    compilerTest.assertCompileError(root, tsComp, "else-if bad TS " + elseIfBadSrc[ei], elseIfBadSrc[ei], elseIfBadErr[ei]);
    compilerTest.assertCompileError(root, cComp, "else-if bad C " + elseIfBadSrc[ei], elseIfBadSrc[ei], elseIfBadErr[ei]);
    ei = ei + 1;
}

/* constant branch simplification eliminates dead arms and unwraps constant-true branches */
constBranchSrc :=
"io := import \"core/io\";\n" +
"score := 84;\n" +
"label := if score >= 90 { \"honors\" } else if score >= 60 { \"pass\" } else { \"retry\" };\n" +
"var note := \"none\";\n" +
"if score >= 80 {\n" +
"    note = \"merit\";\n" +
"}\n" +
"io.outputLine(label, note);\n";
constBranchTs := compilerTest.compileStdin(root, tsComp, constBranchSrc, "");
test.checkInt("const branch TS compile", 0, constBranchTs.status);
test.check("const branch TS drops ternary", not constBranchTs.stdout.contains("? \"honors\""));
test.check("const branch TS drops dead honors", not constBranchTs.stdout.contains("\"honors\""));
test.check("const branch TS drops dead retry", not constBranchTs.stdout.contains("\"retry\""));
test.check("const branch TS drops if(true)", not constBranchTs.stdout.contains("if (Boolean(true))"));
compilerTest.assertCompileRunTs(root, tsComp, "const branch TS run", constBranchSrc, "pass merit\n");

/* constant expression if and subjectless match propagate folded constants */
constPropSrc :=
"io := import \"core/io\";\n" +
"a := if 1 < 2 { 10 } else { 20 };\n" +
"b := a + 5;\n" +
"c := if b == 15 { \"folded\" } else { \"unfolded\" };\n" +
"m := match {\n" +
"    false { \"no\" }\n" +
"    true { \"yes\" }\n" +
"    _ { \"fallback\" }\n" +
"};\n" +
"io.outputLine(c, m);\n";
constPropTs := compilerTest.compileStdin(root, tsComp, constPropSrc, "");
test.checkInt("const prop TS compile", 0, constPropTs.status);
test.check("const prop TS propagates folded if into next branch", not constPropTs.stdout.contains("\"unfolded\""));
test.check("const prop TS drops dead match arms", not constPropTs.stdout.contains("\"no\"") and not constPropTs.stdout.contains("\"fallback\""));
compilerTest.assertCompileRunTs(root, tsComp, "const prop TS run", constPropSrc, "folded yes\n");

/* mixed runtime and constant arms keep runtime guards and prune dead arms */
mixedBranchSrc :=
"io := import \"core/io\";\n" +
"var flag := false;\n" +
"exprVal := if flag { \"a\" } else if false { \"dead1\" } else if true { \"b\" } else { \"dead2\" };\n" +
"var stmtVal := \"init\";\n" +
"if false {\n" +
"    stmtVal = \"dead3\";\n" +
"} else if flag {\n" +
"    stmtVal = \"flag\";\n" +
"} else if true {\n" +
"    stmtVal = \"picked\";\n" +
"} else {\n" +
"    stmtVal = \"dead4\";\n" +
"}\n" +
"io.outputLine(exprVal, stmtVal);\n";
mixedBranchTs := compilerTest.compileStdin(root, tsComp, mixedBranchSrc, "");
test.checkInt("mixed branch TS compile", 0, mixedBranchTs.status);
test.check("mixed branch TS drops dead1..4",
not mixedBranchTs.stdout.contains("\"dead1\"") and
not mixedBranchTs.stdout.contains("\"dead2\"") and
not mixedBranchTs.stdout.contains("\"dead3\"") and
not mixedBranchTs.stdout.contains("\"dead4\""));
compilerTest.assertCompileRunTs(root, tsComp, "mixed branch TS run", mixedBranchSrc, "b picked\n");

/* unwrapped constant-true branches preserve block scope when declaring locals */
scopedConstIfSrc :=
"io := import \"core/io\";\n" +
"if true { var x := 1; x = x + 1; io.outputLine(x); }\n" +
"if true { var x := 10; x = x + 2; io.outputLine(x); }\n";
compilerTest.assertCompileRunTs(root, tsComp, "scoped const-if TS run", scopedConstIfSrc, "2\n12\n");
if ccInfo.available {
    scopedConstIfC := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, scopedConstIfSrc, "", "");
    test.checkInt("scoped const-if C run status", 0, scopedConstIfC.status);
    test.checkText("scoped const-if C stdout", "2\n12\n", scopedConstIfC.stdout);
}

/* dead arms in constant conditionals are still type-checked */
compilerTest.assertCompileError(root, tsComp, "dead arm type mismatch TS",
"io := import \"core/io\"; v := if false { 1 } else if true { \"ok\" } else { 2 }; io.outputLine(v);\n",
"1:60: value if branches must have the same kind, got Int and String\n");

/* constant loop false is eliminated in TS and C while preserving following statements */
loopFalseSrc :=
"io := import \"core/io\";\n" +
"var n := 1;\n" +
"loop false {\n" +
"    n = 99;\n" +
"    if n == 99 { break; }\n" +
"    io.outputLine(\"dead-loop\");\n" +
"}\n" +
"io.outputLine(n);\n";
loopFalseTs := compilerTest.compileStdin(root, tsComp, loopFalseSrc, "");
test.checkInt("loop false TS compile", 0, loopFalseTs.status);
test.check("loop false TS drops dead loop", not loopFalseTs.stdout.contains("while (Boolean(false))") and not loopFalseTs.stdout.contains("dead-loop"));
compilerTest.assertCompileRunTs(root, tsComp, "loop false TS run", loopFalseSrc, "1\n");
if ccInfo.available {
    loopFalseC := compilerTest.compileStdin(root, cComp, loopFalseSrc, "");
    test.checkInt("loop false C compile", 0, loopFalseC.status);
    test.check("loop false C drops dead loop", not loopFalseC.stdout.contains("dead-loop"));
    loopFalseCRun := compilerTest.compileAndRunC(loopFalseC.stdout, ccInfo.cc, "");
    test.checkInt("loop false C run status", 0, loopFalseCRun.status);
    test.checkText("loop false C stdout", "1\n", loopFalseCRun.stdout);
}

/* straight-line var dead-store elimination and scalar literal propagation */
test.check("const branch TS eliminates dead var note", not constBranchTs.stdout.contains("\"none\"") and not constBranchTs.stdout.contains("lite_note"));

deadStoreSrc :=
"io := import \"core/io\";\n" +
"var x := 1;\n" +
"x = 2;\n" +
"x = 3;\n" +
"io.outputLine(x);\n";
deadStoreTs := compilerTest.compileStdin(root, tsComp, deadStoreSrc, "");
test.checkInt("dead store TS compile", 0, deadStoreTs.status);
test.check("dead store TS drops overwritten literals", not deadStoreTs.stdout.contains("1n") and not deadStoreTs.stdout.contains("2n"));
compilerTest.assertCompileRunTs(root, tsComp, "dead store TS run", deadStoreSrc, "3\n");

readBeforeOverwriteSrc :=
"io := import \"core/io\";\n" +
"var a := 10;\n" +
"var b := a + 5;\n" +
"a = 20;\n" +
"io.outputLine(a, b);\n";
compilerTest.assertCompileRunTs(root, tsComp, "read-before-overwrite TS run", readBeforeOverwriteSrc, "20 15\n");

closureBarrierSrc :=
"io := import \"core/io\";\n" +
"var count := 0;\n" +
"bump := fn(): Unit { count = count + 1; };\n" +
"count = 5;\n" +
"bump();\n" +
"io.outputLine(count);\n";
compilerTest.assertCompileRunTs(root, tsComp, "closure barrier TS run", closureBarrierSrc, "6\n");

noHoistNonLiteralSrc :=
"io := import \"core/io\";\n" +
"var x := 0;\n" +
"var y := 1;\n" +
"y = y + 2;\n" +
"x = y;\n" +
"io.outputLine(x);\n";
compilerTest.assertCompileRunTs(root, tsComp, "no-hoist non-literal TS run", noHoistNonLiteralSrc, "3\n");

elseIfNoLeakSrc :=
"io := import \"core/io\";\n" +
"var p := 0;\n" +
"var flag := false;\n" +
"if flag {\n" +
"    p = 1;\n" +
"} else if p == 0 {\n" +
"    p = 2;\n" +
"}\n" +
"io.outputLine(p);\n";
compilerTest.assertCompileRunTs(root, tsComp, "else-if pre-flush barrier TS run", elseIfNoLeakSrc, "2\n");
