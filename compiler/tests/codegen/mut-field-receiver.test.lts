/* Dual-target (TS + C11) tests for nested `mut` field receiver dot calls and COW isolation. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

src :=
"io := import \"core/io\";\n" +
"\n" +
"Counter := record { value: Int; };\n" +
"Counter.bump := fn(c: mut Self, step: Int): Int {\n" +
"    c.value += step;\n" +
"    c.value\n" +
"};\n" +
"\n" +
"Inner := record {\n" +
"    items: List<String>;\n" +
"    counter: Counter;\n" +
"};\n" +
"\n" +
"Box := record {\n" +
"    chunks: List<String>;\n" +
"    counts: Map<String, Int>;\n" +
"    tags: Set<String>;\n" +
"    inner: Inner;\n" +
"};\n" +
"\n" +
"Box.appendChunk := fn(b: mut Self, s: String): Unit {\n" +
"    mut b.chunks.pushBack(s);\n" +
"};\n" +
"\n" +
"Box.bumpInner := fn(b: mut Self, step: Int): Int {\n" +
"    mut b.inner.items.pushBack(step.toText());\n" +
"    mut b.inner.counter.bump(step)\n" +
"};\n" +
"\n" +
"var b: mut Box;\n" +
"mut b.chunks.pushBack(\"a\");\n" +
"mut b.chunks.pushBack(\"b\");\n" +
"mut b.chunks.setAt(1, \"B\");\n" +
"mut b.counts.set(\"x\", 10);\n" +
"mut b.tags.add(\"t1\");\n" +
"v1 := mut b.inner.counter.bump(3);\n" +
"mut b.inner.items.pushBack(\"init\");\n" +
"snap := b;\n" +
"mut b.appendChunk(\"c\");\n" +
"popped := mut b.chunks.popBack();\n" +
"mut b.counts.set(\"y\", 20);\n" +
"removed := mut b.counts.remove(\"x\");\n" +
"mut b.tags.add(\"t2\");\n" +
"tagRm := mut b.tags.remove(\"t1\");\n" +
"v2 := mut b.bumpInner(4);\n" +
"\n" +
"io.outputLine(snap.chunks.join(\",\"), snap.counts.size(), snap.counts.getOr(\"x\", -1), snap.tags.has(\"t1\"), snap.tags.has(\"t2\"), snap.inner.counter.value, snap.inner.items.join(\",\"));\n" +
"io.outputLine(b.chunks.join(\",\"), popped, b.counts.size(), b.counts.has(\"x\"), b.counts.getOr(\"y\", -1), removed, b.tags.has(\"t1\"), b.tags.has(\"t2\"), tagRm, v1, v2, b.inner.items.join(\",\"));\n" +
"\n" +
"mut b.chunks.clear();\n" +
"io.outputLine(b.chunks.length(), snap.chunks.length());\n";

expected :=
"a,B 1 10 true false 3 init\n" +
"a,B c 1 false 20 true false true true 3 7 init,4\n" +
"0 2\n";

tsRes := compilerTest.compileCheckRunTs(root, tsComp, src, "");
test.checkInt("ts status: " + tsRes.stderr, 0, tsRes.status);
test.checkText("ts stderr", "", tsRes.stderr);
test.checkText("ts stdout", expected, tsRes.stdout);

if ccInfo.available {
    cRes := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, src, "", "");
    test.checkInt("c status: " + cRes.stderr, 0, cRes.status);
    test.checkText("c stderr", "", cRes.stderr);
    test.checkText("c stdout parity", tsRes.stdout, cRes.stdout);
}

/* Compile-time rejections on both TS and C */
roSrc :=
"Box := record { chunks: List<String>; };\n" +
"b := Box { chunks = [\"a\"] };\n" +
"mut b.chunks.pushBack(\"x\");\n";
compilerTest.assertCompileErrorContains(root, tsComp, "read-only root record rejected (ts)", roSrc, "cannot call mutating operation pushBack on read-only value");
compilerTest.assertCompileErrorContains(root, cComp, "read-only root record rejected (c)", roSrc, "cannot call mutating operation pushBack on read-only value");

varSrc :=
"Box := record { chunks: List<String>; };\n" +
"var b := Box { chunks = [\"a\"] };\n" +
"mut b.chunks.pushBack(\"x\");\n";
compilerTest.assertCompileErrorContains(root, tsComp, "var non-mut root record rejected (ts)", varSrc, "cannot call mutating operation pushBack on read-only value");
compilerTest.assertCompileErrorContains(root, cComp, "var non-mut root record rejected (c)", varSrc, "cannot call mutating operation pushBack on read-only value");

missingMutSrc :=
"Box := record { chunks: List<String>; };\n" +
"b: mut Box;\n" +
"b.chunks.pushBack(\"x\");\n";
compilerTest.assertCompileErrorContains(root, tsComp, "missing mut on field dot call (ts)", missingMutSrc, "cannot call mutating operation pushBack on read-only value");
compilerTest.assertCompileErrorContains(root, cComp, "missing mut on field dot call (c)", missingMutSrc, "cannot call mutating operation pushBack on read-only value");

nonMutOpSrc :=
"Box := record { chunks: List<String>; };\n" +
"b: mut Box;\n" +
"_n := mut b.chunks.length();\n";
compilerTest.assertCompileErrorContains(root, tsComp, "mut on non-mutating field op (ts)", nonMutOpSrc, "does not mutate its receiver; remove mut");
compilerTest.assertCompileErrorContains(root, cComp, "mut on non-mutating field op (c)", nonMutOpSrc, "does not mutate its receiver; remove mut");

badFieldSrc :=
"Box := record { chunks: List<String>; };\n" +
"b: mut Box;\n" +
"mut b.nope.pushBack(\"x\");\n";
compilerTest.assertCompileErrorContains(root, tsComp, "missing field on mut path (ts)", badFieldSrc, "type Box has no field nope");
compilerTest.assertCompileErrorContains(root, cComp, "missing field on mut path (c)", badFieldSrc, "type Box has no field nope");

/* Completed writes through `mut` record grants remain visible during panic unwinds, callbacks, and Never calls */
cellDecl :=
"io := import \"core/io\";\n" +
"Cell := record { step: Int; };\n" +
"Cell.advance := fn(c: mut Self, d: Int): Int {\n" +
"    c.step += 1;\n" +
"    10 / d\n" +
"};\n" +
"Cell.advanceWithHook := fn(c: mut Self, hook: fn(): Unit): Unit {\n" +
"    c.step += 1;\n" +
"    hook();\n" +
"};\n" +
"Cell.failAfterBump := fn(c: mut Self): Unit {\n" +
"    c.step += 1;\n" +
"    io.exit(7);\n" +
"};\n" +
"Board := record { cell: Cell; };\n" +
"Board.advanceCell := fn(b: mut Self, d: Int): Int {\n" +
"    mut b.cell.advance(d)\n" +
"};\n" +
"bumpAndPanic := fn(c: mut Cell, d: Int): Int {\n" +
"    c.step += 1;\n" +
"    10 / d\n" +
"};\n";

reproSrc := cellDecl +
"mut board := Board { cell = Cell { step = 4 } };\n" +
"snap := board;\n" +
"{\n" +
"    _v := mut board.cell.advance(0);\n" +
"} finally {\n" +
"    io.outputLine(\"finally\", board.cell.step, snap.cell.step);\n" +
"}\n";
reproRun := compilerTest.compileCheckRunTs(root, tsComp, reproSrc, "");
test.checkInt("mut-field panic repro status", 1, reproRun.status);
test.checkText("mut-field panic repro stdout", "finally 5 4\n", reproRun.stdout);
test.check("mut-field panic repro stderr", reproRun.stderr.contains("ArithmeticPanic: division by zero"));

fwdSrc := cellDecl +
"mut board := Board { cell = Cell { step = 4 } };\n" +
"{\n" +
"    _v := mut board.advanceCell(0);\n" +
"} finally {\n" +
"    io.outputLine(\"fwd-finally\", board.cell.step);\n" +
"}\n";
fwdRun := compilerTest.compileCheckRunTs(root, tsComp, fwdSrc, "");
test.checkInt("mut-field forwarded panic status", 1, fwdRun.status);
test.checkText("mut-field forwarded panic stdout", "fwd-finally 5\n", fwdRun.stdout);
test.check("mut-field forwarded panic stderr", fwdRun.stderr.contains("ArithmeticPanic: division by zero"));

directRecvSrc := cellDecl +
"mut c := Cell { step = 4 };\n" +
"{\n" +
"    _v := mut c.advance(0);\n" +
"} finally {\n" +
"    io.outputLine(\"direct-finally\", c.step);\n" +
"}\n";
directRun := compilerTest.compileCheckRunTs(root, tsComp, directRecvSrc, "");
test.checkInt("mut-local receiver panic status", 1, directRun.status);
test.checkText("mut-local receiver panic stdout", "direct-finally 5\n", directRun.stdout);
test.check("mut-local receiver panic stderr", directRun.stderr.contains("ArithmeticPanic: division by zero"));

posArgSrc := cellDecl +
"mut c := Cell { step = 4 };\n" +
"{\n" +
"    _v := bumpAndPanic(mut c, 0);\n" +
"} finally {\n" +
"    io.outputLine(\"pos-finally\", c.step);\n" +
"}\n";
posRun := compilerTest.compileCheckRunTs(root, tsComp, posArgSrc, "");
test.checkInt("mut-pos arg panic status", 1, posRun.status);
test.checkText("mut-pos arg panic stdout", "pos-finally 5\n", posRun.stdout);
test.check("mut-pos arg panic stderr", posRun.stderr.contains("ArithmeticPanic: division by zero"));

namedArgSrc := cellDecl +
"mut c := Cell { step = 4 };\n" +
"{\n" +
"    _v := bumpAndPanic(d = 0, c = mut c);\n" +
"} finally {\n" +
"    io.outputLine(\"named-finally\", c.step);\n" +
"}\n";
namedRun := compilerTest.compileCheckRunTs(root, tsComp, namedArgSrc, "");
test.checkInt("mut-named arg panic status", 1, namedRun.status);
test.checkText("mut-named arg panic stdout", "named-finally 5\n", namedRun.stdout);
test.check("mut-named arg panic stderr", namedRun.stderr.contains("ArithmeticPanic: division by zero"));

hookSrc := cellDecl +
"mut board := Board { cell = Cell { step = 4 } };\n" +
"mut board.cell.advanceWithHook(fn(): Unit { io.outputLine(\"hook\", board.cell.step); });\n";
compilerTest.assertCompileRunTs(root, tsComp, "mut-field live callback", hookSrc, "hook 5\n");

neverSrc := cellDecl +
"mut board := Board { cell = Cell { step = 4 } };\n" +
"{\n" +
"    mut board.cell.failAfterBump();\n" +
"} finally {\n" +
"    io.outputLine(\"never-finally\", board.cell.step);\n" +
"}\n";
neverRun := compilerTest.compileCheckRunTs(root, tsComp, neverSrc, "");
test.checkInt("mut-field exit callee status", 7, neverRun.status);
test.checkText("mut-field exit callee stdout", "never-finally 5\n", neverRun.stdout);
test.checkText("mut-field exit callee stderr", "", neverRun.stderr);

divArgSrc := cellDecl +
"mut c := Cell { step = 4 };\n" +
"{\n" +
"    _v := bumpAndPanic(c = mut c, d = io.exit(9));\n" +
"} finally {\n" +
"    io.outputLine(\"divarg-finally\", c.step);\n" +
"}\n";
divArgRun := compilerTest.compileCheckRunTs(root, tsComp, divArgSrc, "");
test.checkInt("mut-arg divergent arg status", 9, divArgRun.status);
test.checkText("mut-arg divergent arg stdout", "divarg-finally 4\n", divArgRun.stdout);
test.checkText("mut-arg divergent arg stderr", "", divArgRun.stderr);

test.done("mut-field-receiver");
