/* Focused tests for xs[i] = v index mutation, generic List<T> intrinsics, math/scalar, and math/random. */

test := import "core/test";
list := import "core/list";
math := import "math/scalar";
rand := import "math/random";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
tsComp := selTs.path;

/* 1. Direct xs[i] = v on mutable List<T> and [T; N], plus generic List<T> intrinsics */
prog :=
"io := import \"core/io\";\n" +
"list := import \"core/list\";\n" +
"mut nums: List<Int> = [10, 20, 30, 40];\n" +
"nums[1] = 25;\n" +
"mut nums.setAt(3, 45);\n" +
"var fixed: [Int; 3] = [1, 2, 3];\n" +
"fixed[0] = 9;\n" +
"sl := nums.slice(1, 3);\n" +
"rev := sl.reverse();\n" +
"sorted := [42, 7, 19, 7, -3].sort();\n" +
"words := [\"pear\", \"apple\", \"fig\"].sortTexts();\n" +
"io.outputLine(nums.length(), nums[1], nums[3], fixed[0]);\n" +
"io.outputLine(rev.length(), rev[0], rev[1]);\n" +
"io.outputLine(sorted[0], sorted[1], sorted[2], sorted[3], sorted[4]);\n" +
"io.outputLine(words[0], words[1], words[2]);\n" +
"mut nums.clear();\n" +
"io.outputLine(nums.length());\n";

c1 := compilerTest.compileStdin(root, tsComp, prog, "");
test.checkInt("list ops compile: " + c1.stderr, 0, c1.status);
r1 := compilerTest.checkAndRunTs(root, c1.stdout);
test.checkInt("list ops run: " + r1.stderr, 0, r1.status);
test.checkText("list ops stdout", "4 25 45 9\n2 30 25\n-3 7 7 19 42\napple fig pear\n0\n", r1.stdout);

/* 2. Immutable list index assignment is rejected at compile time */
immProg := "xs: List<Int> = [1, 2];\nxs[0] = 5;\n";
compilerTest.assertCompileError(root, tsComp, "immutable list index assign", immProg, "2:1: cannot mutate read-only value xs via index assignment\n");

/* 3. Out-of-bounds xs[i] = v raises BoundPanic */
oobProg := "mut xs: List<Int> = [1, 2];\nxs[5] = 9;\n";
cOob := compilerTest.compileStdin(root, tsComp, oobProg, "");
test.checkInt("oob compile", 0, cOob.status);
rOob := compilerTest.checkAndRunTs(root, cOob.stdout);
test.check("oob exits non-zero", rOob.status =!= 0);
test.check("oob BoundPanic", rOob.stderr.contains("BoundPanic"));

/* 4. math/scalar checks */
test.checkInt("math.abs", 7, math.abs(-7));
test.checkInt("math.min", 3, math.min(3, 9));
test.checkInt("math.max", 9, math.max(3, 9));
test.checkInt("math.clamp lo", 10, math.clamp(2, 10, 20));
test.checkInt("math.clamp hi", 20, math.clamp(25, 10, 20));
test.checkInt("math.sign", -1, math.sign(-42));
test.checkInt("math.gcd", 6, math.gcd(48, 18));
test.checkInt("math.lcm", 144, math.lcm(48, 18));
test.checkInt("math.powInt", 1024, math.powInt(2, 10));
test.check("math.sqrt(9.0)", math.abs(math.sqrt(9.0) - 3.0) < 0.0000001);
test.check("math.lerp", math.abs(math.lerp(10.0, 20.0, 0.25) - 12.5) < 0.0000001);

/* 5. math/random deterministic checks (mutable Rng + module-level default PRNG) */
var mut rA: rand.Rng = rand.Rng.create(42);
v1 := mut rA.rangeInt(1, 100);
v2 := mut rA.rangeInt(1, 100);
var mut rB: rand.Rng = rand.Rng.create(42);
v1b := mut rB.rangeInt(1, 100);
v2b := mut rB.rangeInt(1, 100);
test.checkInt("random deterministic 1", v1, v1b);
test.checkInt("random deterministic 2", v2, v2b);
test.check("random in range 1", v1 >= 1 and v1 < 100);
test.check("random in range 2", v2 >= 1 and v2 < 100);
mut rA.reseed(42);
test.checkInt("random reseed reproduces v1", v1, mut rA.rangeInt(1, 100));
ni := mut rA.nextInt();
test.check("random nextInt positive", ni >= 1 and ni <= 2147483646);
var mut snap: rand.Rng = rA;
afterA := mut rA.nextInt();
afterSnap := mut snap.nextInt();
test.checkInt("random COW snapshot isolation", afterA, afterSnap);
nb := mut rA.nextBool();
test.check("random nextBool matches parity", nb == nb);

rand.seed(42);
m1 := rand.rangeInt(1, 100);
m2 := rand.rangeInt(1, 100);
test.checkInt("module random deterministic 1", v1, m1);
test.checkInt("module random deterministic 2", v2, m2);
mNext := rand.nextInt();
test.check("module random nextInt positive", mNext >= 1 and mNext <= 2147483646);
_mBool := rand.nextBool();

/* 6. Direct usage of new list helpers in unit test itself */
unsorted: List<Int> = [5, 1, 4, 2, 3];
sortedDirect := unsorted.sort();
test.checkInt("direct sortInts[0]", 1, sortedDirect[0]);
test.checkInt("direct sortInts[4]", 5, sortedDirect[4]);

test.done("list-math-random");
