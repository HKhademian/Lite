/* Multi-level optimization flags: -O0, -O1 (default), -O2, -O3, and --opt=0..3 on TS and C compilers. */

test := import "core/test";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

src :=
"io := import \"core/io\";\n" +
"State := enum { Idle; Active; Done; };\n" +
"nextState := fn(s: State): State {\n" +
"    match s {\n" +
"        .Idle { .Active }\n" +
"        .Active { .Done }\n" +
"        .Done { .Idle }\n" +
"    }\n" +
"};\n" +
"inc := fn(x: Int): Int { x + 1 };\n" +
"var dead := 10;\n" +
"dead = 20;\n" +
"if false {\n" +
"    io.outputLine(\"never-printed\");\n" +
"}\n" +
"var st: State = .Idle;\n" +
"st = nextState(st);\n" +
"io.outputLine(inc(dead), st);\n";

o0 := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", ["-O0"]);
test.checkInt("-O0 compiles", 0, o0.status);
test.check("-O0 keeps constant-false branch", o0.stdout.contains("never-printed"));
test.check("-O0 keeps leaf function inc", o0.stdout.contains("function liteFn_inc"));

o1 := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", ["-O1"]);
test.checkInt("-O1 compiles", 0, o1.status);
test.check("-O1 eliminates constant-false branch", not o1.stdout.contains("never-printed"));
test.check("-O1 keeps leaf function inc", o1.stdout.contains("function liteFn_inc"));

o2 := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", ["-O2"]);
test.checkInt("-O2 compiles", 0, o2.status);
test.check("-O2 eliminates constant-false branch", not o2.stdout.contains("never-printed"));

o3 := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", ["-O3"]);
test.checkInt("-O3 compiles", 0, o3.status);
test.check("-O3 inlines and removes inc", not o3.stdout.contains("function liteFn_inc"));
test.check("-O3 inlines and removes nextState", not o3.stdout.contains("function liteFn_nextState"));

optEq3 := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", ["--opt=3"]);
test.checkInt("--opt=3 compiles", 0, optEq3.status);
test.check("--opt=3 matches -O3 output", optEq3.stdout == o3.stdout);

/* All four levels produce identical runtime output and pass strict TS checking */
r0 := compilerTest.checkAndRunTs(root, o0.stdout);
r1 := compilerTest.checkAndRunTs(root, o1.stdout);
r2 := compilerTest.checkAndRunTs(root, o2.stdout);
r3 := compilerTest.checkAndRunTs(root, o3.stdout);
test.checkInt("-O0 runs", 0, r0.status);
test.checkInt("-O1 runs", 0, r1.status);
test.checkInt("-O2 runs", 0, r2.status);
test.checkInt("-O3 runs", 0, r3.status);
test.check("all levels match stdout", r0.stdout == "21 State.Active\n" and r1.stdout == r0.stdout and r2.stdout == r0.stdout and r3.stdout == r0.stdout);

/* C backend accepts -O0..-O3 */
cSrc := "io := import \"core/io\";\ninc := fn(x: Int): Int { x + 1 };\nio.outputLine(inc(41));\n";
co3 := compilerTest.compileStdinWithOpts(root, cComp, root, cSrc, "", "", ["-O3"]);
test.checkInt("C backend -O3 compiles", 0, co3.status);
test.check("C backend -O3 inlines inc", not co3.stdout.contains("lt_fn_inc("));

/* 2-argument leaf inlining at -O3 and zero-copy immutable list loop + no double [...([...(...)])] */
twoArgSrc :=
"io := import \"core/io\";\n" +
"addPair := fn(a: Int, b: Int): Int { a + b };\n" +
"nums: List<Int> = [1, 2, 3];\n" +
"var sum := 0;\n" +
"loop nums as n { sum = addPair(sum, n); }\n" +
"io.outputLine(sum);\n";
t3 := compilerTest.compileStdinWithOpts(root, tsComp, root, twoArgSrc, "", "", ["-O3"]);
test.checkInt("2-arg -O3 compiles", 0, t3.status);
test.check("-O3 inlines 2-arg leaf addPair", not t3.stdout.contains("function liteFn_addPair"));
test.check("no double array spread clone", not t3.stdout.contains("[...([...("));
test.check("immutable list loop avoids array spread copy", t3.stdout.contains("for (const lite_n of (lite_nums))"));
rt3 := compilerTest.checkAndRunTs(root, t3.stdout);
test.checkInt("2-arg -O3 runs", 0, rt3.status);
test.checkText("2-arg -O3 stdout", "6\n", rt3.stdout);

/* Invalid optimization level is rejected cleanly */
badO4 := compilerTest.compileStdinWithOpts(root, tsComp, root, cSrc, "", "", ["-O4"]);
test.check("rejects -O4", badO4.status == 2);
test.check("-O4 diagnostic: " + badO4.stderr, badO4.stderr.contains("unsupported optimization flag -O4"));

badOpt := compilerTest.compileStdinWithOpts(root, tsComp, root, cSrc, "", "", ["--opt", "9"]);
test.check("rejects --opt 9", badOpt.status == 2);
test.check("--opt 9 diagnostic: " + badOpt.stderr, badOpt.stderr.contains("unsupported optimization level 9"));

test.done("opt-levels");
