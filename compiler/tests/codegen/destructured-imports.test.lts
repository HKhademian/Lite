/* End-to-end TS, C11, comptime, re-export, and diagnostic tests for destructured module imports (`[pub] { ... } := import "..."`). */

test := import "core/test";
fs := import "core/file";
path := import "core/path";
proc := import "core/process";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

emptyBytes := fn(): List<Int> {
    xs: List<Int> = [];
    xs
};

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();
test.check("cc available", ccInfo.cc =!= "");

/* 1. Multi-module destructuring: bare, =shorthand, Local = Exported, overloads, constants, records, enums, aliases, interfaces, pub re-export chain, comptime, TS + C11 + ASan/UBSan + leak check */
tmpDir := fs.makeTempDir("lite-destr-imp-");
test.check("makeTempDir: " + tmpDir.error, tmpDir.ok);

_wBase := fs.writeText(path.join(tmpDir.path, "base.lt"),
"pub SCALE := 10;\n" +
"pub Point := record { x: Int; y: Int; };\n" +
"pub Pair := alias (first: Int, second: Int);\n" +
"pub Mode := enum : Int { Fast = 1; Safe = 2; };\n" +
"pub Labelled := interface { label: fn(self: Self): String; };\n" +
"pub impl Labelled for Point {\n" +
"    label := fn(self: Point): String { \"(\" + self.x.toText() + \",\" + self.y.toText() + \")\" };\n" +
"};\n" +
"pub combine := fn(a: Int, b: Int): Int { (a + b) * SCALE };\n" +
"pub combine := fn(a: Int): Int { a * SCALE };\n" +
"pub helper := fn(n: Int): Int { n + 1 };\n" +
"hidden := fn(): Int { 999 };\n"
);

_wReexp := fs.writeText(path.join(tmpDir.path, "reexport.lt"),
"pub { Point, =Mode, LocalScale = SCALE, bump = helper } := import \"./base\";\n"
);

mainPath := path.join(tmpDir.path, "main.lts");
_wMain := fs.writeText(mainPath,
"{ outputLine } := import \"core/io\";\n" +
"{ combine, =SCALE, plusOne = helper, Point, RunMode = Mode, Coord = Pair, Labelled, } := import \"./base\";\n" +
"{ LocalScale, bump, Mode } := import \"./reexport\";\n" +
"reMod := import \"./reexport\";\n" +
"showLabel := fn<T: Type<Labelled>>(v: T): String { v.label() };\n" +
"p := Point { x = 2, y = 3 };\n" +
"c: Coord = (first = 4, second = 5);\n" +
"m: RunMode = .Safe;\n" +
"rm: reMod.Point = { x = 7, y = 8 };\n" +
"ct := comptime { combine(1, 2) + combine(3) + SCALE + plusOne(4) + LocalScale + bump(5) };\n" +
"outputLine(combine(2, 3), combine(4), SCALE, plusOne(6), showLabel(p), c.first + c.second, m.value, Mode.Fast.value, reMod.bump(9), rm.x, ct);\n"
);

expectedOut := "50 40 10 7 (2,3) 9 2 1 10 7 91\n";

tsCompRes := compilerTest.compileFile(tsComp, tmpDir.path, [mainPath]);
test.checkInt("destr import TS compile: " + tsCompRes.stderr, 0, tsCompRes.status);
tsRunRes := compilerTest.checkAndRunTs(root, tsCompRes.stdout);
test.checkInt("destr import TS run: " + tsRunRes.stderr, 0, tsRunRes.status);
test.checkText("destr import TS stdout", expectedOut, tsRunRes.stdout);

cCompRes := compilerTest.compileFile(cComp, tmpDir.path, [mainPath]);
test.checkInt("destr import C compile: " + cCompRes.stderr, 0, cCompRes.status);
cPath := path.join(tmpDir.path, "prog.c");
_wC := fs.writeText(cPath, cCompRes.stdout);
sanBin := path.join(tmpDir.path, "prog_san");
ccOut := path.join(tmpDir.path, "cc.out");
ccErr := path.join(tmpDir.path, "cc.err");
ccRun := proc.runBytes(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-fsanitize=address,undefined", "-DLITE_ALLOC_SYSTEM", cPath, "-o", sanBin, "-lm"], tmpDir.path, [], 30000, emptyBytes(), ccOut, ccErr);
test.checkInt("destr import C cc: " + fs.readText(ccErr).text, 0, ccRun.status);
runOut := path.join(tmpDir.path, "run.out");
runErr := path.join(tmpDir.path, "run.err");
sanRun := proc.runBytes(sanBin, [], tmpDir.path, ["LITE_CHECK_LEAKS=1"], 10000, emptyBytes(), runOut, runErr);
test.checkInt("destr import C san run: " + fs.readText(runErr).text, 0, sanRun.status);
test.checkText("destr import C san stderr", "", fs.readText(runErr).text);
test.checkText("destr import C stdout parity", expectedOut, fs.readText(runOut).text);

/* 2. Negative diagnostics (missing export, duplicate across imports, collision with local decl, syntax errors) */
assertMultiFileErr := fn(label: String, mainSrc: String, errSub: String): Unit {
    badMain := path.join(tmpDir.path, "bad.lts");
    _wb := fs.writeText(badMain, mainSrc);
    tsBad := compilerTest.compileFile(tsComp, tmpDir.path, [badMain]);
    test.checkInt(label + " TS status", 2, tsBad.status);
    test.check(label + " TS stderr: " + tsBad.stderr, tsBad.stderr.contains(errSub));
    cBad := compilerTest.compileFile(cComp, tmpDir.path, [badMain]);
    test.checkInt(label + " C status", 2, cBad.status);
    test.check(label + " C stderr: " + cBad.stderr, cBad.stderr.contains(errSub));
};

assertMultiFileErr("missing export", "{ missing } := import \"./base\";", "has no public export missing");
assertMultiFileErr("private export rejected", "{ hidden } := import \"./base\";", "has no public export hidden");
assertMultiFileErr("duplicate across two imports", "{ SCALE } := import \"./base\";\n{ SCALE = LocalScale } := import \"./reexport\";", "duplicate imported public name SCALE");
assertMultiFileErr("local shadows destructured import", "{ SCALE } := import \"./base\";\nSCALE := 99;", "duplicate top-level value SCALE");

_rm := fs.remove(tmpDir.path);

badSingleSrc: List<String> = [
"{} := import \"core/io\";",
"{ _ } := import \"core/io\";",
"{ a = output, a = outputLine } := import \"core/io\";",
"var { outputLine } := import \"core/io\";",
"f := fn(): Unit { { outputLine } := import \"core/io\"; };",
"pub import \"core/io\";"
];
badSingleErr: List<String> = [
"requires at least one binding",
"cannot use wildcard _",
"duplicate import binding a",
"import cannot use var",
"only allowed at top level",
"only allowed in $preload.lt"
];
var bi := 0;
loop bi < 6 {
    compilerTest.assertCompileErrorContains(root, tsComp, "bad destr import: " + badSingleSrc[bi], badSingleSrc[bi], badSingleErr[bi]);
    bi = bi + 1;
}

test.done("destructured-imports");
