/* Focused tests for collection and string metadata operations (.length(), .size(), .isEmpty()). */

test := import "core/test";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

/* 1. List, Array, Map, Set, String operations (non-empty, empty, Unicode, chained with loop .collected) */
propsProg :=
"io := import \"core/io\";\n" +
"xs: List<Int> = [10, 20, 30];\n" +
"emptyXs: List<Int> = [];\n" +
"arr := [1, 2, 3, 4];\n" +
"m := [\"a\" = 1, \"b\" = 2];\n" +
"emptyM: Map<String, Int> = [];\n" +
"s: Set<String> = [\"x\", \"y\", \"x\"];\n" +
"emptyS: Set<String> = [];\n" +
"txt := \"hello\";\n" +
"emoji := \"a🚀b\";\n" +
"emptyTxt := \"\";\n" +
"chainedLen := loop xs { .item * 2 }.collected.length();\n" +
"chainedEmpty := loop emptyXs { .item * 2 }.collected.isEmpty();\n" +
"io.outputLine(xs.length(), xs.isEmpty(), emptyXs.length(), emptyXs.isEmpty());\n" +
"io.outputLine(arr.length(), arr.isEmpty());\n" +
"io.outputLine(m.size(), m.isEmpty(), emptyM.size(), emptyM.isEmpty());\n" +
"io.outputLine(s.size(), s.isEmpty(), emptyS.size(), emptyS.isEmpty());\n" +
"io.outputLine(txt.length(), txt.isEmpty(), emoji.length(), emptyTxt.length(), emptyTxt.isEmpty());\n" +
"io.outputLine(chainedLen, chainedEmpty);\n";

optFlags := ["-O0", "-O1", "-O2", "-O3"];
loop optFlags as flag {
    cProps := compilerTest.compileStdin(root, tsComp, propsProg, flag);
    test.checkInt("collection props compile " + flag + ": " + cProps.stderr, 0, cProps.status);
    rProps := compilerTest.checkAndRunTs(root, cProps.stdout);
    test.checkInt("collection props run " + flag + ": " + rProps.stderr, 0, rProps.status);
    test.checkText("collection props stdout " + flag,
    "3 false 0 true\n4 false\n2 false 0 true\n2 false 0 true\n5 false 3 0 true\n3 true\n",
    rProps.stdout);
}

/* 2. Dynamic String.isEmpty() & String.length() (non-constant runtime string, without importing type/string) */
dynStrProg :=
"io := import \"core/io\";\n" +
"describe := fn(s: String): String {\n" +
"    if s.isEmpty() { \"empty\" } else { \"nonempty\" }\n" +
"};\n" +
"io.outputLine(describe(\"\"), describe(\"hi\"), \"abc\".length());\n";

cDyn := compilerTest.compileStdin(root, tsComp, dynStrProg, "");
test.checkInt("dynamic string props compile: " + cDyn.stderr, 0, cDyn.status);
rDyn := compilerTest.checkAndRunTs(root, cDyn.stdout);
test.checkInt("dynamic string props run: " + rDyn.stderr, 0, rDyn.status);
test.checkText("dynamic string props stdout", "empty nonempty 3\n", rDyn.stdout);

/* 3. Compile-time rejections: unknown operations and bare dot-op without () */
compilerTest.assertCompileErrorContains(root, tsComp, "List rejects .size()",
"xs: List<Int> = [1];\nn := xs.size();\n",
"has no operation size");
compilerTest.assertCompileErrorContains(root, tsComp, "List rejects bare .length",
"xs: List<Int> = [1];\nn := xs.length;\n",
"must be called with (...)");
compilerTest.assertCompileErrorContains(root, tsComp, "Array rejects .size()",
"arr := [1, 2];\nn := arr.size();\n",
"has no operation size");
compilerTest.assertCompileErrorContains(root, tsComp, "Map rejects .length()",
"m := [\"a\" = 1];\nn := m.length();\n",
"has no operation length");
compilerTest.assertCompileErrorContains(root, tsComp, "Set rejects .length()",
"s: Set<Int> = [1];\nn := s.length();\n",
"has no operation length");
compilerTest.assertCompileErrorContains(root, tsComp, "String rejects .size()",
"s := \"hi\";\nn := s.size();\n",
"has no operation size");
cListProp := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; xs := [1, 2]; io.outputLine(xs.length(), xs.isEmpty());\n", "");
test.checkInt("C compiles list collection operations: " + cListProp.stderr, 0, cListProp.status);
cMapProp := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; m := [\"a\" = 1]; io.outputLine(m.size(), m.isEmpty());\n", "");
test.checkInt("C compiles map collection operations: " + cMapProp.stderr, 0, cMapProp.status);

test.done("collection-props");
