/* Tuple shapes, fixed arrays, mutability/lists, storage updates, call routing, out hygiene, tuple destructuring, and scope-local counter tests migrated from compiler/tests/host.test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
text := import "core/text";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

ccProbe := compilerTest.probeCc();

assertRejectsAny := fn(label: String, cases: List<(bad: String, m1: String, m2: String)>): Unit {
    loop cases as item {
        res := compilerTest.compileStdin(root, tsComp, item.bad, "");
        test.checkInt(label + " status (" + item.bad + ")", 2, res.status);
        ok := res.stderr.contains(item.m1) and (item.m2 == "" or res.stderr.contains(item.m2));
        test.check(label + " msg (" + item.bad + ") got: " + res.stderr, ok);
    }
};

/* tuple shapes support unnamed/mixed/singleton, shorthand, positional reads, destructuring, receiving labels, and __proto__ */
tupleSrc := [
    "io := import \"core/io\";",
    "kind := \"number\";",
    "token := (=kind, value = 12);",
    "io.outputLine(token.kind, token.value);",
    "mixed := (1, name = \"first\", false);",
    "io.outputLine(mixed.0, mixed.name, mixed.2);",
    "stored := (r = 20, l = 10);",
    "renamed: (l: Int, r: Int) = stored;",
    "io.outputLine(renamed.l, renamed.r);",
    "pos := (x = 1, y = 2);",
    "io.outputLine(pos.0);",
    "(a, b) := (1, 2);",
    "var (c, d) := (10, 20);",
    "c = c + 1;",
    "io.outputLine(a + b, c, d);",
    "io.outputLine(Unit, (), (1,), (1, 2), (1, left = 2, right = 3, 4));",
    "p := (__proto__ = 7);",
    "io.outputLine(p.__proto__, p);"
].join("\n");
compilerTest.assertCompileRunTs(
    root,
    tsComp,
    "tuple-shapes",
    tupleSrc,
    "number 12\n1 first false\n20 10\n1\n3 11 20\nUnit Unit (1,) (1, 2) (1, left=2, right=3, 4)\n7 (__proto__=7,)\n"
);
tupleRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "A := alias ();", m1 = "tuple type needs at least one field", m2 = ""),
    (bad = "x: (Int, String) = (1, 2);", m1 = "cannot initialize (Int, String) with (Int, Int)", m2 = ""),
    (bad = "(a, b) := 1;", m1 = "tuple destructuring requires a tuple value", m2 = ""),
    (bad = "(a, b) := (1, 2, 3);", m1 = "tuple destructuring expected 2 fields, got 3", m2 = ""),
    (bad = "io := import \"core/io\"; p := (1, 2); io.outputLine(p.2);", m1 = "tuple has no field 2", m2 = "")
];
assertRejectsAny("tuple-shapes", tupleRej);

/* fixed arrays support inferred/explicit extents, aliases, functions, zero values, dot/bracket/loop access, and List tail distinction */
arraySrc := [
    "io := import \"core/io\";",
    "Pair := alias [Int; 2];",
    "make := fn(): [Int; 2] { [1, 2] }",
    "sum := fn(a: Pair): Int { a[0] + a.1 }",
    "inferred := [10, 20, 30];",
    "explicit: [Int; 2] = [4, 5];",
    "aliased: Pair = make();",
    "zeroed: [Int; 3];",
    "emptyArr: [Int; 0] = [];",
    "emptyZero: [Int; 0];",
    "var total := 0;",
    "loop inferred as item { total = total + item; }",
    "io.outputLine(inferred[0], inferred.2, sum(explicit), aliased, zeroed, emptyArr, emptyZero, total);"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "fixed-arrays", arraySrc, "10 30 9 [1, 2] [0, 0, 0] [] [] 60\n");
arrayRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "f := fn(): List<Int> { [1, 2] }", m1 = "cannot return [Int; 2] from function f returning List<Int>", m2 = ""),
    (bad = "x: [Int; 3] = [1, 2];", m1 = "cannot initialize [Int; 3] with [Int; 2]", m2 = ""),
    (bad = "x: [Int; 2] = [];", m1 = "cannot initialize [Int; 2] with [Int; 0]", m2 = ""),
    (bad = "io := import \"core/io\"; a := [1, 2]; io.outputLine(a.2);", m1 = "array index 2 out of bounds", m2 = "")
];
assertRejectsAny("fixed-arrays", arrayRej);

/* mutability and lists support inferred mut/var mut, front/back ops, List<Unit>, tuple copies, and rejections */
mutListSrc := [
    "io := import \"core/io\";",
    "mut values: List<Int> = [1, 2];",
    "mut values.pushFront(0);",
    "mut values.pushBack(3);",
    "front := mut values.popFront();",
    "back := mut values.popBack();",
    "mut values.pushFront(9);",
    "front2 := mut values.popFront();",
    "io.outputLine(front, back, front2, values);",
    "mut args := io.inputArgs();",
    "mut args.pushBack(\"z\");",
    "var mut other := io.inputArgs();",
    "other = io.inputArgs();",
    "mut other.pushFront(\"a\");",
    "io.outputLine(args, other);",
    "mut units: List<Unit> = [Unit];",
    "mut units.pushBack(Unit);",
    "io.outputLine(mut units.popFront(), mut units.popBack(), units);",
    "mut tuples: List<(name: String, n: Int)> = [(name = \"a\", n = 1)];",
    "item := mut tuples.popBack();",
    "io.outputLine(item.name, item.n, tuples);"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "mut-lists", mutListSrc, "0 3 9 [1, 2]\n[z] [a]\nUnit Unit []\na 1 []\n");
emptyOps: List<(call: String, msg: String)> = [
    (call = "popFront", msg = "pop_front"),
    (call = "popBack", msg = "pop_back")
];
loop emptyOps as op {
    pSrc := "io := import \"core/io\";\nmut empty: List<Unit> = [];\nio.outputLine(mut empty." + op.call + "());";
    pRun := compilerTest.compileCheckRunTs(root, tsComp, pSrc, "");
    test.checkInt("mut-lists empty " + op.call + " status", 1, pRun.status);
    test.check("mut-lists empty " + op.call + " panic: " + pRun.stderr, pRun.stderr.contains("BoundPanic") and pRun.stderr.contains(op.msg + " on an empty list"));
}
mutListRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "mut x := 1;", m1 = "mut requires a List, Map, Set, or record value, got Int", m2 = ""),
    (bad = "mut var x: List<Int> = [];", m1 = "write var mut, not mut var", m2 = ""),
    (bad = "mut values: List<Int> = [1]; List.popFront(values);", m1 = "popFront requires mut list argument", m2 = ""),
    (bad = "mut values: List<Int> = [1]; List.pushFront(values, 2);", m1 = "pushFront requires mut list argument", m2 = "")
];
assertRejectsAny("mut-lists", mutListRej);

/* storage and updates support compound assignments, zero init, reserved storage, control-flow joins, and rejections */
storageSrc := [
    "io := import \"core/io\";",
    "var n := 10;",
    "n += 5; n -= 3; n *= 2; n /= 4; n %= 3;",
    "var f := -7;",
    "f :/= 2; f :%= 3;",
    "var s := \"a\";",
    "s += \"b\";",
    "var fl := 1.5;",
    "fl += 2;",
    "z0: (:Int, :String) = 0;",
    "z1: [Int; 2] = 0;",
    "r: Int = ?;",
    "r = 42;",
    "c: Int = ?;",
    "if n == 0 { c = 10; } else { c = 20; }",
    "io.outputLine(n, f, s, fl, z0.0, z0.1, z1, r, c);"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "storage-updates", storageSrc, "0 2 ab 3.5 0  [0, 0] 42 10\n");
storageRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "io := import \"core/io\"; a: Int = ?; io.outputLine(a);", m1 = "cannot read uninitialized local a", m2 = ""),
    (bad = "a: Int = ?; a = 1; a = 2;", m1 = "cannot assign to immutable local a", m2 = ""),
    (bad = "a: Int = ?; if true { a = 1; } a = 2;", m1 = "cannot assign to possibly initialized immutable local a", m2 = ""),
    (bad = "io := import \"core/io\"; a: Int = ?; if true { a = 1; } io.outputLine(a);", m1 = "cannot read uninitialized local a", m2 = ""),
    (bad = "io := import \"core/io\"; a: Int = ?; loop false { a = 1; } io.outputLine(a);", m1 = "cannot read uninitialized local a", m2 = ""),
    (bad = "x := 1; x += 2;", m1 = "cannot assign to immutable local x", m2 = ""),
    (bad = "x: (:Int);", m1 = "unnamed singleton tuple type needs trailing comma", m2 = "")
];
assertRejectsAny("storage-updates", storageRej);

/* call routing supports named, positional, shorthand, replacement, recursion, trailing commas, module functions, and rejections */
callRoutingSrc := [
    "io := import \"core/io\";",
    "step := fn(label: String, n: Int): Int { io.outputLine(label, n); n };",
    "tag := fn(label: String): String { io.outputLine(label); label };",
    "digits := fn(a: Int, b: Int, c: Int): Int { a * 100 + b * 10 + c };",
    "a := 5; b := 2; c := 6;",
    "r1 := digits(c = 3, 1, =b);",
    "r2 := digits(9, a = 1, 2, 3,);",
    "r3 := digits(tag(\"skip\"), 2, a = step(\"keep\", 1), c = step(\"tail\", 3));",
    "r4 := digits(tag(\"over\"), 2, =a, =c,);",
    "logUnit := fn(x: Int, y: String): Unit { io.outputLine(x, y); };",
    "logUnit(y = \"done\", 7,);",
    "sumDown := fn(n: Int, total: Int): Int {",
    "  if n == 0 { total } else { self(total = total + n, n = n - 1) }",
    "};",
    "length := fn(text: String): Int { 4 };",
    "io.outputLine(r1, r2, r3, r4, sumDown(4, 0), length(text = \"abcd\"));"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "call-routing", callRoutingSrc, "skip\nkeep 1\ntail 3\nover\n7 done\n123 123 123 526 10 4\n");

tmpCallDir := fs.makeTempDir("lite-call-routing-");
test.check("call-routing makeTempDir", tmpCallDir.ok);
callDir := tmpCallDir.path;
appCallPath := path.join(callDir, "app.lts");
_wCallMod := fs.writeText(path.join(callDir, "mod.lts"), "pub pick := fn(a: Int, b: Int, c: Int): Int { a * 100 + b * 10 + c }\n");
appCallSrc := "io := import \"core/io\"; m := import \"./mod.lts\"; b := 2; io.outputLine(m.pick(\"x\", 9, a = 1, =b, 3,));\n";
_wCallApp := fs.writeText(appCallPath, appCallSrc);
realCallApp := fs.realPath(appCallPath);
test.check("call-routing realPath", realCallApp.ok);
compilerTest.assertCompileRunTsNamed(root, tsComp, "call-routing mod", appCallSrc, realCallApp.path, "123\n");
_rmCall := fs.remove(callDir);

callRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(a = 1, a = 2, b = 3);", m1 = "duplicate named argument a", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; a := 1; f(a = 1, =a, b = 3);", m1 = "duplicate named argument a", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(1, z = 2);", m1 = "unknown parameter z", m2 = ""),
    (bad = "f := fn(a: Int, b: Int, c: Int): Int { a + b + c }; f(c = 3, 1);", m1 = "function f expects 3 arguments, got 2", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(1, 2, 3);", m1 = "function f expects 2 arguments, got more", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(a = 1, 2, 3);", m1 = "function f expects 2 arguments, got more", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; b := 2; f(1, =b + 1);", m1 = "shorthand argument requires a bare identifier", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(1, b = \"two\");", m1 = "must be Int, got String", m2 = ""),
    (bad = "f := fn(a: Int, b: Int): Int { a + b }; f(\"superseded\", a = \"bad\", 2);", m1 = "must be Int, got String", m2 = ""),
    (bad = "io := import \"core/io\"; io.inputInt(prompt = \"n: \");", m1 = "named arguments are not supported for host function io.inputInt", m2 = ""),
    (bad = "io := import \"core/io\"; text := \"hi\"; io.errorLine(=text);", m1 = "named arguments are not supported for host function io.errorLine", m2 = ""),
    (bad = "String.length(text = \"hi\");", m1 = "named arguments are not supported for host function String.length", m2 = ""),
    (bad = "String.trim(s = \"hi\");", m1 = "unknown parameter s in call to String.trim", m2 = ""),
    (bad = "io := import \"core/io\"; var x := 0; io.outputLine(x = 1);", m1 = "expected )", m2 = "")
];
assertRejectsAny("call-routing", callRej);

/* out local hygiene avoids main accumulator collisions at root, nested, and imported module scopes */
outSrc := [
    "io := import \"core/io\";",
    "out := \"ok\";",
    "io.outputLine(out);",
    "{ var out := \"a\"; out += \"b\"; io.outputLine(out); }",
    "laterOut := fn(): Int { deferredOut };",
    "deferredOut := 7;",
    "f := fn(): Int { out2 };",
    "out2 := 9;",
    "io.outputLine(laterOut(), f());"
].join("\n");
outComp := compilerTest.compileStdin(root, tsComp, outSrc, "");
test.checkInt("out-hygiene compile", 0, outComp.status);
test.check("out-hygiene const lite_out", outComp.stdout.contains("const lite_out = \"ok\";"));
test.check("out-hygiene let lite_out$2", outComp.stdout.contains("let lite_out$2 = "));
test.check("out-hygiene return lite$out", outComp.stdout.contains("return lite$out.join(\"\");"));
outRun := compilerTest.checkAndRunTs(root, outComp.stdout);
test.checkInt("out-hygiene run status", 0, outRun.status);
test.checkText("out-hygiene run stdout", "ok\nab\n7 9\n", outRun.stdout);

deferredOutSrc := "io := import \"core/io\";\nreadOut := fn(): Int { out };\nout := 17;\nio.outputLine(readOut());";
compilerTest.assertCompileRunTs(root, tsComp, "out-hygiene deferred", deferredOutSrc, "17\n");

tmpOutDir := fs.makeTempDir("lite-out-hygiene-");
test.check("out-hygiene makeTempDir", tmpOutDir.ok);
outDir := tmpOutDir.path;
appOutPath := path.join(outDir, "app.lts");
_wOutMod := fs.writeText(path.join(outDir, "mod.lts"), "pub readK := fn(): Int { K }\npub K := 9;\npub out := \"mod-out\";\n");
appOutSrc := "io := import \"core/io\"; m := import \"./mod.lts\"; out := \"root-out\"; io.outputLine(m.readK(), m.out, out);\n";
_wOutApp := fs.writeText(appOutPath, appOutSrc);
realOutApp := fs.realPath(appOutPath);
test.check("out-hygiene realPath", realOutApp.ok);
compilerTest.assertCompileRunTsNamed(root, tsComp, "out-hygiene mod", appOutSrc, realOutApp.path, "9 mod-out root-out\n");
_rmOut := fs.remove(outDir);

/* tuple destructuring supports empty (), grouped (x), var (x), singleton (x,), nested shadowing, value blocks, and rejections */
destrSrc := [
    "io := import \"core/io\";",
    "var ticks := 0;",
    "bump := fn(): Unit { ticks += 1; };",
    "() := ();",
    "() := Unit;",
    "() := bump();",
    "(x) := 42;",
    "var (y) := 10;",
    "y += 5;",
    "(z,) := (99,);",
    "{ (a, a) := (1, 2); (_, _) := (3, 4); io.outputLine(a); }",
    "v := { () := bump(); (p) := 3; var (q) := 4; q += 1; (r, s) := (q, p * 2); r + s };",
    "io.outputLine(ticks, x, y, z, v);"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "tuple-destructuring", destrSrc, "2\n2 42 15 99 11\n");
destrRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "() := 42;", m1 = "tuple destructuring requires Unit for (), got Int", m2 = ""),
    (bad = "() := (1, 2);", m1 = "tuple destructuring expected 0 fields, got 2", m2 = ""),
    (bad = "io := import \"core/io\"; () := io.exit(1);", m1 = "tuple destructuring requires Unit for (), got Never", m2 = ""),
    (bad = "var () := ();", m1 = "var tuple destructuring needs at least one binding", m2 = ""),
    (bad = "(x,) := 42;", m1 = "tuple destructuring requires a tuple value, got Int", m2 = ""),
    (bad = "(x) := ();", m1 = "cannot declare a Unit local x", m2 = ""),
    (bad = "io := import \"core/io\"; (x) := io.exit(1);", m1 = "cannot declare a Never local x", m2 = ""),
    (bad = "(dup, dup) := (1, 2);", m1 = "duplicate top-level value dup", m2 = ""),
    (bad = "{ var x := { () := 1; x }; }", m1 = "tuple destructuring requires Unit for (), got Int", m2 = "")
];
assertRejectsAny("tuple-destructuring", destrRej);

/* named/mixed/shorthand/typed tuple destructuring and fixed-array [a, b] := arr destructuring */
namedArrDestrSrc := [
    "io := import \"core/io\";",
    "readForward := fn(): Int { fwdA + fwdB };",
    "stored := (r = 20, l = 10);",
    "(left = l, right = r) := stored;",
    "(= l: Int, = r) := stored;",
    "(= fruit) := (fruit = 30);",
    "mixed := (1, mid = \"m\", last = true);",
    "(head, = last, m: String = mid) := mixed;",
    "arr: [Int; 3] = [100, 200, 300];",
    "[a0, a1: Int, _] := arr;",
    "var [fwdA, fwdB] := [4, 5];",
    "fwdB += 1;",
    "innerArr := {",
    "    var (= r) := (r = 7);",
    "    r += 2;",
    "    [x, x] := [11, 22];",
    "    r + x",
    "};",
    "io.outputLine(left, right, l, r, fruit, head, m, last, a0, a1, readForward(), innerArr);"
].join("\n");
compilerTest.assertCompileRunTs(root, tsComp, "named-tuple-and-array-destructuring", namedArrDestrSrc, "10 20 10 20 30 1 m true 100 200 10 31\n");
namedArrDestrRej: List<(bad: String, m1: String, m2: String)> = [
    (bad = "(= a) := (b = 1);", m1 = "tuple has no field a", m2 = ""),
    (bad = "(x = a, = a) := (a = 1, b = 2);", m1 = "duplicate selection of tuple field a", m2 = ""),
    (bad = "(x, y = first) := (first = 1, second = 2);", m1 = "duplicate selection of tuple field first", m2 = ""),
    (bad = "(= a: String) := (a = 1);", m1 = "cannot bind Int to String", m2 = ""),
    (bad = "[] := [1];", m1 = "array destructuring needs at least one binding", m2 = ""),
    (bad = "[a, b] := [1];", m1 = "array destructuring expected 2 elements, got 1", m2 = ""),
    (bad = "xs: List<Int> = [1, 2]; [a, b] := xs;", m1 = "cannot destructure runtime-sized List<Int>; fixed array required", m2 = ""),
    (bad = "[a, b] := 42;", m1 = "array destructuring requires an array value, got Int", m2 = ""),
    (bad = "[a: String, b] := [1, 2];", m1 = "cannot bind Int to String", m2 = ""),
    (bad = "[a = b] := [1];", m1 = "array destructuring patterns do not use =", m2 = ""),
    (bad = "[= a] := [1];", m1 = "array destructuring does not support = selector", m2 = "")
];
assertRejectsAny("named-tuple-and-array-destructuring", namedArrDestrRej);
arrDestrCRes := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; [a, b] := [1, 2]; io.outputLine(a, b);\n", "c_arr_destr.lts");
test.checkInt("C arr destructuring compiles: " + arrDestrCRes.stderr, 0, arrDestrCRes.status);

/* scope-local counters avoid source-offset churn in functions, destructuring, loops, and C shadows */
workBody := [
    "io := import \"core/io\";",
    "pick := fn(first: String, second: String): String { first + \"-\" + second };",
    "work := fn(x: String): String {",
    "  var acc := x;",
    "  {",
    "    x := pick(second = \"2\", first = \"1\");",
    "    { x := \"3\"; acc = acc + \":\" + x; }",
    "    acc = acc + \":\" + x;",
    "  }",
    "  (p, q) := (\"a\", \"b\");",
    "  loop [\"u\", \"v\"] { acc = acc + \".\"; }",
    "  acc + \":\" + p + q",
    "};",
    "io.outputLine(work(\"0\"));"
].join("\n");
shiftedHeader := "/* extra top comment line 1\n   extra top comment line 2\n   extra top comment line 3 */\nunusedBanner := \"header\";\n\n";
baseComp := compilerTest.compileStdin(root, tsComp, workBody, "");
shiftedComp := compilerTest.compileStdin(root, tsComp, shiftedHeader + workBody, "");
test.checkInt("counters base compile", 0, baseComp.status);
test.checkInt("counters shifted compile", 0, shiftedComp.status);
extractWork := fn(srcText: String): String {
    sPos := srcText.indexOf("function liteFn_work(", 0);
    ePos := srcText.indexOf("void liteFn_work;", sPos);
    test.check("extractWork bounds", sPos >= 0 and ePos >= 0);
    srcText.slice(sPos, ePos)
};
workTs := extractWork(baseComp.stdout);
test.checkText("counters offset-invariant workTs", workTs, extractWork(shiftedComp.stdout));
test.check("counters lite_x$2", workTs.contains("const lite_x$2 ="));
test.check("counters lite_x$3", workTs.contains("const lite_x$3 ="));
test.check("counters lite$tuple", workTs.contains("const lite$tuple ="));
test.check("counters for lite$item", workTs.contains("for (const lite$item of"));
test.check("counters lite$arg0", workTs.contains("const lite$arg0 ="));
legacyTokens: List<String> = ["lt_local_", "lite$tuple_", "lite$item_", "lite$arg_", "lite$report"];
loop legacyTokens as tok {
    test.check("counters omits legacy " + tok, not baseComp.stdout.contains(tok));
}
workRun := compilerTest.checkAndRunTs(root, baseComp.stdout);
test.checkInt("counters work run status", 0, workRun.status);
test.checkText("counters work run stdout", "0:3:1-2..:ab\n", workRun.stdout);

cShadowBase := "io := import \"core/io\";\n{ x := \"one\"; { x := \"two\"; io.outputLine(x); } io.outputLine(x); }\n";
cBase := compilerTest.compileStdin(root, cComp, cShadowBase, "");
cShifted := compilerTest.compileStdin(root, cComp, "/* shift */\n/* shift */\n" + cShadowBase, "");
test.checkInt("counters c base compile", 0, cBase.status);
test.checkInt("counters c shifted compile", 0, cShifted.status);
test.checkText("counters c offset-invariant", cBase.stdout, cShifted.stdout);
test.check("counters c lite_x", cBase.stdout.contains("lt_str lite_x ="));
test.check("counters c lt_s2_x", cBase.stdout.contains("lt_str lt_s2_x ="));
if ccProbe.available {
    cShadowRun := compilerTest.compileAndRunC(cBase.stdout, ccProbe.cc, "");
    test.checkInt("counters c shadow status", 0, cShadowRun.status);
    test.checkText("counters c shadow stdout", "two\none\n", cShadowRun.stdout);
}

test.done("data-storage-calls");
