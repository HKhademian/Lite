/* Set<T>: typed value sets, core/set intrinsics, iteration, value semantics, enum elements, and diagnostics. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

/* 1. Core Set<String>, Set<Int>, and Set<Enum> operations */
basicSetSrc :=
"io := import \"core/io\";\n" +
"set := import \"core/set\";\n" +
"Flag := enum { Read; Write; Exec; }\n" +
"tags: mut Set<String>;\n" +
"set.add(mut tags, \"lite\");\n" +
"set.add(mut tags, \"fast\");\n" +
"set.add(mut tags, \"lite\");\n" +
"io.outputLine(set.size(tags));\n" +
"io.outputLine(set.has(tags, \"lite\"));\n" +
"io.outputLine(set.has(tags, \"slow\"));\n" +
"io.outputLine(tags);\n" +
"loop tags as tag {\n" +
"    io.outputLine(tag);\n" +
"}\n" +
"io.outputLine(set.values(tags));\n" +
"io.outputLine(set.remove(mut tags, \"lite\"));\n" +
"io.outputLine(set.remove(mut tags, \"lite\"));\n" +
"io.outputLine(set.size(tags));\n" +
"set.clear(mut tags);\n" +
"io.outputLine(set.size(tags));\n" +
"perms: mut Set<Flag>;\n" +
"set.add(mut perms, .Read);\n" +
"set.add(mut perms, .Exec);\n" +
"io.outputLine(set.has(perms, .Read), set.has(perms, .Write), perms);\n";

basicExpected :=
"2\ntrue\nfalse\n{lite, fast}\nlite\nfast\n[lite, fast]\ntrue\nfalse\n1\n0\ntrue false {Flag.Read, Flag.Exec}\n";
compilerTest.assertCompileRunTs(root, tsComp, "basic set operations TS", basicSetSrc, basicExpected);

/* 2. Value-copy semantics, functions, block expressions, mut inference, and Set inside Map */
valueSemSrc :=
"io := import \"core/io\";\n" +
"set := import \"core/set\";\n" +
"map := import \"core/map\";\n" +
"makeNums := fn(): Set<Int> {\n" +
"    s: mut Set<Int>;\n" +
"    set.add(mut s, 10);\n" +
"    set.add(mut s, 20);\n" +
"    s\n" +
"};\n" +
"sumSet := fn(s: Set<Int>): Int {\n" +
"    var total := 0;\n" +
"    loop s as n {\n" +
"        total += n;\n" +
"    }\n" +
"    total\n" +
"};\n" +
"mut s1 := makeNums();\n" +
"copy := s1;\n" +
"set.add(mut s1, 30);\n" +
"set.remove(mut s1, 10);\n" +
"io.outputLine(sumSet(copy), sumSet(s1));\n" +
"var mut s2 := makeNums();\n" +
"set.add(mut s2, 5);\n" +
"io.outputLine(set.size(s2));\n" +
"groups: mut Map<String, Set<Int>>;\n" +
"groups[\"evens\"] = copy;\n" +
"io.outputLine(set.has(groups[\"evens\"], 20));\n";

compilerTest.assertCompileRunTs(root, tsComp, "value semantics and nested set TS", valueSemSrc, "30 50\n3\ntrue\n");

/* 3. Compile-time rejections */
badSrc: List<String> = [
"s: Set<List<Int>>;\n",
"s: Set<Unit>;\n",
"set := import \"core/set\";\ns: Set<String>;\nset.add(mut s, \"a\");\n",
"set := import \"core/set\";\ns: mut Set<String>;\nset.add(s, \"a\");\n",
"set := import \"core/set\";\ns: mut Set<String>;\nset.add(mut s, 42);\n",
"io := import \"core/io\";\na: Set<String>;\nb: Set<String>;\nio.outputLine(a == b);\n",
"s: Set<String> = ?;\n"
];
badErr: List<String> = [
"unsupported set element type",
"unsupported set element type",
"cannot mutate immutable set",
"requires mut set argument",
"add element must be String",
"cannot compare set values",
"reserved storage is not supported for Set"
];
var bi := 0;
loop bi < 7 {
    compilerTest.assertCompileErrorContains(root, tsComp, "bad set " + badSrc[bi], badSrc[bi], badErr[bi]);
    bi = bi + 1;
}

/* 4. C backend rejection */
compilerTest.assertCompileErrorContains(root, cComp, "set C backend rejection",
"set := import \"core/set\";\ns: mut Set<String>;\nset.add(mut s, \"a\");\n",
"C backend does not support set values yet");

test.done("set");
