/* Dual-target (TS + C11) parity tests for Phase 5 core built-in type operations under `--builtin-mode=builtin` and `--builtin-mode=pure`. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

runWithModes := fn(label: String, src: String, expected: String, extraArgs: List<String>): Unit {
    tsCompRes := compilerTest.compileStdinWithOpts(root, tsComp, root, src, "", "", extraArgs);
    test.checkInt(label + " ts compile: " + tsCompRes.stderr, 0, tsCompRes.status);
    tsRun := compilerTest.checkAndRunTs(root, tsCompRes.stdout);
    test.checkInt(label + " ts status: " + tsRun.stderr, 0, tsRun.status);
    test.checkText(label + " ts stdout", expected, tsRun.stdout);
    if ccInfo.available {
        cCompRes := compilerTest.compileStdinWithOpts(root, cComp, root, src, "", "", extraArgs);
        test.checkInt(label + " c compile: " + cCompRes.stderr, 0, cCompRes.status);
        cRun := compilerTest.compileAndRunC(cCompRes.stdout, ccInfo.cc, "");
        test.checkInt(label + " c status: " + cRun.stderr, 0, cRun.status);
        test.checkText(label + " c stdout parity", tsRun.stdout, cRun.stdout);
    }
};

/* 1. Zero-import ergonomic dot operations across List, Array, Map, Set, String, Int + $getIndex/$setIndex hooks. */
coreOpsSrc :=
"io := import \"core/io\";\n" +
"\n" +
"mut xs: List<Int> = [10, 20];\n" +
"mut xs.pushBack(30);\n" +
"mut xs.pushFront(5);\n" +
"xs[1] += 2;\n" +
"xs[2] = 25;\n" +
"popped := mut xs.popBack();\n" +
"rev := xs.reverse();\n" +
"doubled := xs.map(fn(n) { n * 2 });\n" +
"big := doubled.filter(fn(n) { n >= 20 });\n" +
"words: List<String> = [\"a\", \"b\", \"c\"];\n" +
"mut words2: List<String> = [\"ok\"];\n" +
"(mut words2).pushBack(\"hello\");\n" +
"(((((mut words2))))).pushBack(\"world\");\n" +
"mut (words2).pushBack(\"!\");\n" +
"poppedBangLen := (((mut ((words2))))).popBack().length();\n" +
"poppedWorldLen := ((mut words2).popBack()).length();\n" +
"poppedWordLen := mut words2.popBack().length();\n" +
"io.outputLine(xs.length(), xs.isEmpty(), popped, rev[0], big.length(), big[0], words.join(\"-\"), poppedWordLen, poppedWorldLen, poppedBangLen, words2.length());\n" +
"\n" +
"var arr := [3, 6, 9];\n" +
"arr[1] += 4;\n" +
"io.outputLine(arr.length(), arr.isEmpty(), arr[0], arr[1], arr[2]);\n" +
"\n" +
"mut m: Map<String, Int>;\n" +
"mut m.set(\"a\", 1);\n" +
"m[\"b\"] = 2;\n" +
"m[\"b\"] += 5;\n" +
"g1 := m.get(\"a\");\n" +
"io.outputLine(m.size(), m.isEmpty(), m.has(\"a\"), g1.found, g1.value, m.getOr(\"z\", 99), m[\"b\"]);\n" +
"\n" +
"mut s: Set<String>;\n" +
"mut s.add(\"x\");\n" +
"mut s.add(\"y\");\n" +
"rm := mut s.remove(\"x\");\n" +
"io.outputLine(s.size(), s.isEmpty(), rm, s.has(\"x\"), s.has(\"y\"));\n" +
"\n" +
"raw := \"  Hello_42  \";\n" +
"tr := raw.trim();\n" +
"parsed := \"-123\".toInt();\n" +
"io.outputLine(\"abc\".length(), \"\".isEmpty(), tr.length(), tr.isEmpty(), tr.toLowerAscii(), tr.startsWith(\"Hel\"), tr.endsWith(\"42\"), tr.contains(\"lo_\"));\n" +
"io.outputLine(\"ab\".repeat(3), parsed.ok, parsed.value, (42).toText(), (-7).toText());\n";

expectedOut :=
"3 false 30 25 2 24 a-b-c 5 5 1 1\n" +
"3 false 3 10 9\n" +
"2 false true true 1 99 7\n" +
"1 false true false true\n" +
"3 true 8 false hello_42 true true true\n" +
"ababab true -123 42 -7\n";

/* Run under default builtin mode, full pure mode, and targeted TypeName.op pure override! */
builtinArgs: List<String> = ["--builtin-mode=builtin"];
pureArgs: List<String> = ["--builtin-mode=pure"];
targetedArgs: List<String> = ["--builtin-mode=core/text:String.trim=pure", "--builtin-mode=core/int:Int.toText=pure"];

runWithModes("core-type-ops-builtin", coreOpsSrc, expectedOut, builtinArgs);
runWithModes("core-type-ops-pure", coreOpsSrc, expectedOut, pureArgs);
runWithModes("core-type-ops-targeted", coreOpsSrc, expectedOut, targetedArgs);

/* 2. Zero DCE overhead check: minimal program emits no unused core type ops. */
minSrc := "io := import \"core/io\";\nio.outputLine(42);\n";
emptyArgs: List<String> = [];
minTs := compilerTest.compileStdinWithOpts(root, tsComp, root, minSrc, "", "", emptyArgs);
test.checkInt("min ts compile", 0, minTs.status);
test.check("min ts omits unused String.trim", not minTs.stdout.contains("tp_String_op_trim"));
test.check("min ts omits unused Int.toText", not minTs.stdout.contains("tp_Int_op_toText"));
test.check("min ts omits unused List.map", not minTs.stdout.contains("tp_List_op_map"));

/* 3. Removed free-function shims and ambient push_back/pop_back are rejected, while dot ops and TypeName.op succeed on TS and C11. */
rejectSources: List<String> = [
    "list := import \"core/list\"; mut xs: List<Int> = [1]; _ := list.popBack(mut xs);\n",
    "mut xs: List<Int> = [1]; push_back(mut xs, 2);\n",
    "mut xs: List<Int> = [1]; _ := pop_back(mut xs);\n"
];
loop rejectSources as rejSrc {
    tsRej := compilerTest.compileStdin(root, tsComp, rejSrc, "");
    test.checkInt("removed shim ts reject: " + rejSrc, 2, tsRej.status);
    test.checkText("removed shim ts stdout", "", tsRej.stdout);
    cRej := compilerTest.compileStdin(root, cComp, rejSrc, "");
    test.checkInt("removed shim c reject: " + rejSrc, 2, cRej.status);
    test.checkText("removed shim c stdout", "", cRej.stdout);
}

acceptBothSrc :=
"io := import \"core/io\";\n" +
"mut xs: List<Int> = [1, 2];\n" +
"mut xs.pushBack(3);\n" +
"a := mut xs.popBack();\n" +
"List.pushBack(mut xs, 4);\n" +
"b := List.popBack(mut xs);\n" +
"io.outputLine(a, b, xs);\n";
runWithModes("removed-shim-replacements", acceptBothSrc, "3 4 [1, 2]\n", emptyArgs);

/* 4. Scalar .toText() across all 8 built-in primitive scalar types, String.padLeftWith/padRightWith/compare, and C11 io/UTF-8 fast paths. */
scalarToTextSrc :=
"io := import \"core/io\";\n" +
"i64Min: Int = -9223372036854775808;\n" +
"i64Max: Int = 9223372036854775807;\n" +
"i8Min: Int8 = -128;\n" +
"i8Zero: Int8 = 0;\n" +
"i8Max: Int8 = 127;\n" +
"i16Min: Int16 = -32768;\n" +
"i16Zero: Int16 = 0;\n" +
"i16Max: Int16 = 32767;\n" +
"i32Min: Int32 = -2147483648;\n" +
"i32Zero: Int32 = 0;\n" +
"i32Max: Int32 = 2147483647;\n" +
"bT := true;\n" +
"bF := false;\n" +
"fZero: Float = 0.0;\n" +
"fNegZero: Float = -0.0;\n" +
"fVal: Float = 3.5;\n" +
"fNeg: Float = -12.25;\n" +
"fSum: Float = 0.1 + 0.2;\n" +
"f32Zero: Float32 = 0.0;\n" +
"f32NegZero: Float32 = -0.0;\n" +
"f32Val: Float32 = 1.5;\n" +
"f32Tenth: Float32 = 0.1;\n" +
"io.outputLine((0).toText(), (-42).toText(), i64Min.toText(), i64Max.toText());\n" +
"io.outputLine(i8Min.toText(), i8Zero.toText(), i8Max.toText(), i16Min.toText(), i16Zero.toText(), i16Max.toText());\n" +
"io.outputLine(i32Min.toText(), i32Zero.toText(), i32Max.toText());\n" +
"io.outputLine(bT.toText(), bF.toText(), \"\".toText() == \"\", \"abc\".toText());\n" +
"io.outputLine(fZero.toText(), fNegZero.toText(), fVal.toText(), fNeg.toText(), fSum.toText() == \"0.30000000000000004\");\n" +
"io.outputLine(f32Zero.toText(), f32NegZero.toText(), f32Val.toText(), f32Tenth.toText());\n" +
"io.outputLine(\"7\".padLeftWith(3, \"0\"), \"7\".padLeftWith(4, \"ab\"), \"7\".padLeftWith(1, \"0\"), \"7\".padLeftWith(3, \"\"));\n" +
"io.outputLine(\"7\".padRightWith(3, \"0\"), \"7\".padRightWith(4, \"ab\"), \"7\".padRightWith(1, \"0\"), \"7\".padRightWith(3, \"\"));\n" +
"io.outputLine(\"abc\".compare(\"abd\"), \"abc\".compare(\"abc\"), \"abd\".compare(\"abc\"), \"é\".compare(\"ü\"));\n";

scalarToTextExpected :=
"0 -42 -9223372036854775808 9223372036854775807\n" +
"-128 0 127 -32768 0 32767\n" +
"-2147483648 0 2147483647\n" +
"true false true abc\n" +
"0 0 3.5 -12.25 true\n" +
"0 0 1.5 0.10000000149011612\n" +
"007 aba7 7 7\n" +
"700 7aba 7 7\n" +
"-1 0 1 -1\n";

runWithModes("scalar-toText-builtin", scalarToTextSrc, scalarToTextExpected, builtinArgs);
runWithModes("scalar-toText-pure", scalarToTextSrc, scalarToTextExpected, pureArgs);

ioUtf8Src :=
"io := import \"core/io\";\n" +
"rd1 := io.Reader.fromText(\"alpha\\r\\nbeta\\n\\ngamma\");\n" +
"l1 := rd1.readLine();\n" +
"l2 := rd1.readLine();\n" +
"l3 := rd1.readLine();\n" +
"l4 := rd1.readLine();\n" +
"l5 := rd1.readLine();\n" +
"io.outputLine(l1.ok, l1.line, l1.eof, l2.ok, l2.line, l2.eof);\n" +
"io.outputLine(l3.ok, l3.line == \"\", l3.eof, l4.ok, l4.line, l4.eof, l5.ok, l5.line == \"\", l5.eof);\n" +
"rd2 := io.Reader.fromText(\"hello \\\"Lite\\\"!\\nline2\");\n" +
"ra := rd2.readAllText();\n" +
"io.outputLine(ra.ok, ra.text.length(), rd2.readAll().length());\n" +
"bw := io.Writer.buffer();\n" +
"wt1 := bw.writeLine(\"one\");\n" +
"wt2 := bw.writeText(\"two\");\n" +
"bwt := bw.text();\n" +
"io.outputLine(wt1.ok, wt2.ok, bwt.ok, bwt.text == \"one\\ntwo\");\n" +
"u := \"Aé🙂\".utf8Encode();\n" +
"stOk := String.fromUtf8Strict(u);\n" +
"stBadLead := String.fromUtf8Strict([255]);\n" +
"stBadCont := String.fromUtf8Strict([194, 65]);\n" +
"stTrunc := String.fromUtf8Strict([226, 130]);\n" +
"stOob := String.fromUtf8Strict([256]);\n" +
"io.outputLine(u.length(), stOk.ok, stOk.text, stBadLead.ok, stBadCont.ok, stTrunc.ok, stOob.ok);\n" +
"rep := String.fromCodePoint(65533).text;\n" +
"io.outputLine(String.fromUtf8Lossy([65, 255, 194, 66, 226, 130, 256]) == (\"A\" + rep + rep + \"B\" + rep + rep));\n";

ioUtf8Expected :=
"true alpha false true beta false\n" +
"true true false true gamma false true true true\n" +
"true 19 0\n" +
"true true true true\n" +
"7 true Aé🙂 false false false false\n" +
"true\n";

runWithModes("io-utf8-builtin", ioUtf8Src, ioUtf8Expected, builtinArgs);
runWithModes("io-utf8-pure", ioUtf8Src, ioUtf8Expected, pureArgs);

test.done("core-type-operations");
