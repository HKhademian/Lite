/* Arithmetic, division/remainder, string concatenation, and deterministic emission tests migrated from igniter/test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
text := import "core/text";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();
contracts := compilerTest.readProcessContracts(root);

/* artifact runner typechecks emitted TS and compiles C with warnings as errors */
artSrc := "io := import \"core/io\"; x := 2 * 3;\nio.outputLine(x);\n";
compilerTest.assertCompileRunTs(root, tsComp, "artifact runner TS", artSrc, "6\n");
if ccInfo.available {
    artC := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, artSrc, "", "");
    test.checkInt("artifact runner C status", 0, artC.status);
    test.checkText("artifact runner C stdout", "6\n", artC.stdout);
    test.checkText("artifact runner C stderr", "", artC.stderr);
}

/* restricted C compiler emits the readable reference and sequences reports */
ref42C := fs.readText(path.join(root, "compiler/tests/references/generated/report-42.c")).text;
c42 := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; io.outputLine(42);", "");
test.checkInt("c 42", 0, c42.status);
test.checkText("c 42 out", ref42C, c42.stdout);
cSeq := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; io.outputLine(42);\nio.outputLine(9);", "");
test.checkInt("c seq", 0, cSeq.status);
expCSeq :=
"#include <stdio.h>\n#include <inttypes.h>\n#include <stdbool.h>\n#include <string.h>\nint main(void) {\n    int status = 0;\n" +
"    if (printf(\"%\" PRId64, (int64_t)(INT64_C(42))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    if (printf(\"%\" PRId64, (int64_t)(INT64_C(9))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    return status;\n}\n";
test.checkText("c seq out", expCSeq, cSeq.stdout);

/* Lite-written TS emitter produces a deterministic readable reference with no extra source */
ref42Ts := fs.readText(path.join(root, "compiler/tests/references/generated/report-42.ts")).text;
ts42 := compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(42);", "");
ts42b := compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(42);", "");
test.checkInt("ts 42", 0, ts42.status);
test.checkText("ts 42 ref", ref42Ts, ts42.stdout);
test.checkText("ts 42 det", ts42.stdout, ts42b.stdout);
test.checkText("ts +42 norm", ref42Ts, compilerTest.compileStdin(root, tsComp, "io := import \"core/io\";  io.outputLine( +00042 ) ; ", "").stdout);
expNegZero :=
"export function main(lite$write?: (text: string) => void): string {\n    const lite$out: string[] = [];\n    function lite$emit(text: string): void {\n        if (lite$write === undefined) lite$out.push(text);\n        else lite$write(text);\n    }\n    lite$emit((0n).toString() + \"\\n\");\n    return lite$out.join(\"\");\n}\n";
test.checkText("ts -000", expNegZero, compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(-000);", "").stdout);

/* Lite-written TS and C compilers sequence multiple report statements deterministically */
seqProg := "io := import \"core/io\"; io.outputLine(10);\nio.outputLine(20);\nio.outputLine(-30);\n";
seqTs := compilerTest.compileStdin(root, tsComp, seqProg, "");
test.checkInt("seq ts", 0, seqTs.status);
test.checkText("seq ts err", "", seqTs.stderr);
expSeqTs :=
"export function main(lite$write?: (text: string) => void): string {\n    const lite$out: string[] = [];\n    function lite$emit(text: string): void {\n        if (lite$write === undefined) lite$out.push(text);\n        else lite$write(text);\n    }\n    lite$emit((10n).toString() + \"\\n\");\n    lite$emit((20n).toString() + \"\\n\");\n    lite$emit(((-30n)).toString() + \"\\n\");\n    return lite$out.join(\"\");\n}\n";
test.checkText("seq ts out", expSeqTs, seqTs.stdout);

seqC := compilerTest.compileStdin(root, cComp, seqProg, "");
test.checkInt("seq c", 0, seqC.status);
test.checkText("seq c err", "", seqC.stderr);
expSeqC :=
"#include <stdio.h>\n#include <inttypes.h>\n#include <stdbool.h>\n#include <string.h>\nint main(void) {\n    int status = 0;\n" +
"    if (printf(\"%\" PRId64, (int64_t)(INT64_C(10))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    if (printf(\"%\" PRId64, (int64_t)(INT64_C(20))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    if (printf(\"%\" PRId64, (int64_t)((-INT64_C(30)))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    return status;\n}\n";
test.checkText("seq c out", expSeqC, seqC.stdout);

/* Lite-written TS and C compilers lower arithmetic expressions and immutable locals deterministically */
arithProg := "io := import \"core/io\"; x := 2 * (3 - 4);\nio.outputLine(x + 10);\nio.outputLine(-x);\n";
arithTs := compilerTest.compileStdin(root, tsComp, arithProg, "");
test.checkInt("arith ts", 0, arithTs.status);
test.checkText("arith ts err", "", arithTs.stderr);
expArithTs :=
"export function main(lite$write?: (text: string) => void): string {\n    const lite$out: string[] = [];\n    function lite$emit(text: string): void {\n        if (lite$write === undefined) lite$out.push(text);\n        else lite$write(text);\n    }\n" +
"    const lite_x = (2n * ((3n - 4n)));\n" +
"    void lite_x;\n" +
"    lite$emit(((lite_x + 10n)).toString() + \"\\n\");\n" +
"    lite$emit(((-lite_x)).toString() + \"\\n\");\n" +
"    return lite$out.join(\"\");\n}\n";
test.checkText("arith ts out", expArithTs, arithTs.stdout);

arithC := compilerTest.compileStdin(root, cComp, arithProg, "");
test.checkInt("arith c", 0, arithC.status);
test.checkText("arith c err", "", arithC.stderr);
expArithC :=
"#include <stdio.h>\n#include <inttypes.h>\n#include <stdbool.h>\n#include <string.h>\nint main(void) {\n" +
"    int status = 0;\n" +
"    int64_t lite_x = (INT64_C(2) * ((INT64_C(3) - INT64_C(4))));\n" +
"    (void)lite_x;\n" +
"    if (printf(\"%\" PRId64, (int64_t)((lite_x + INT64_C(10)))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    if (printf(\"%\" PRId64, (int64_t)((-lite_x))) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    return status;\n}\n";
test.checkText("arith c out", expArithC, arithC.stdout);

/* restricted compiler lowers dynamic Int division and remainder with checked semantics */
divTsSrc :=
"io := import \"core/io\";\n" +
"var a := -7;\n" +
"var b := 2;\n" +
"var c := -2;\n" +
"io.outputLine(a / b, a % b, a :/ b, a :% b);\n" +
"io.outputLine(a / c, a % c, a :/ c, a :% c);\n" +
"io.outputLine(7 / c, 7 % c, 7 :/ c, 7 :% c);\n" +
"var m := -9223372036854775808;\n" +
"var n := -1;\n" +
"io.outputLine(m % n, m :% n);";
compilerTest.assertCompileRunTs(root, tsComp, "dynamic div TS", divTsSrc, "-3 -1 -4 1\n3 -1 3 -1\n-3 1 -4 -1\n0 0\n");

/* restricted compiler lowers dynamic Int division and remainder to runnable C */
divFaultSrcs: List<String> = [
"io := import \"core/io\"; var x := 1; var y := 0; io.outputLine(x / y);",
"io := import \"core/io\"; var x := 1; var y := 0; io.outputLine(x % y);",
"io := import \"core/io\"; var x := 1; var y := 0; io.outputLine(x :/ y);",
"io := import \"core/io\"; var x := 1; var y := 0; io.outputLine(x :% y);",
"io := import \"core/io\"; var x := -9223372036854775808; io.outputLine(x / -1);",
"io := import \"core/io\"; var x := -9223372036854775808; io.outputLine(x :/ -1);",
];
if ccInfo.available {
    divCSrc :=
    "io := import \"core/io\";\n" +
    "var a := -7;\n" +
    "var b := 2;\n" +
    "var c := -2;\n" +
    "io.outputLine(a / b, a % b, a :/ b, a :% b);\n" +
    "io.outputLine(a / c, a % c, a :/ c, a :% c);\n" +
    "io.outputLine(7 / c, 7 % c, 7 :/ c, 7 :% c);\n" +
    "var m := -9223372036854775808;\n" +
    "var n := -1;\n" +
    "io.outputLine(m :% n);";
    divCRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, divCSrc, "", "");
    test.checkInt("div C status", 0, divCRun.status);
    test.checkText("div C stdout", "-3 -1 -4 1\n3 -1 3 -1\n-3 1 -4 -1\n0\n", divCRun.stdout);
    test.checkText("div C stderr", "", divCRun.stderr);

    loop divFaultSrcs as faultSrc {
        cF := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, faultSrc, "", "");
        compilerTest.assertRunMatchesContract(contracts, "div fault C: " + faultSrc, faultSrc, "", 1, cF);
    }
}

/* restricted compiler division faults preserve zero divisor and minimum/-1 status and stderr */
loop divFaultSrcs as faultSrc {
    tsF := compilerTest.compileCheckRunTs(root, tsComp, faultSrc, "");
    compilerTest.assertRunMatchesContract(contracts, "div fault TS: " + faultSrc, faultSrc, "", 1, tsF);
}

/* restricted compiler lowers dynamic String concatenation with left-to-right TS evaluation */
strTsSrc :=
"io := import \"core/io\";\n" +
"join := fn (a: String, b: String): String { return a + b; }\n" +
"var prefix := \"lit\";\n" +
"name := \"er\";\n" +
"pair := (left = \"tu\", right = \"ple\");\n" +
"values := [\"li\", \"st\"];\n" +
"io.outputLine(prefix + name);\n" +
"io.outputLine(join(\"fun\", \"ction\"));\n" +
"io.outputLine(pair.left + pair.right);\n" +
"io.outputLine(values[0] + values[1]);\n" +
"io.outputLine(\"\" + prefix + \"\" + name);\n" +
"io.outputLine(\"snow🙂\" + \"man\");\n" +
"io.outputLine(\"line\\n\" + \"break\");\n" +
"io.outputLine(\"tab\\t\" + \"stop\");\n" +
"io.outputLine(\"quote\\\"\" + \"back\\\\slash\");";
strTsComp := compilerTest.compileStdin(root, tsComp, strTsSrc, "");
test.checkInt("str concat TS", 0, strTsComp.status);
test.check("str concat no lite_concat", not text.containsText(strTsComp.stdout, "lite_concat"));
compilerTest.assertCompileRunTs(root, tsComp, "str concat TS run", strTsSrc, "liter\nfunction\ntuple\nlist\nliter\nsnow🙂man\nline\nbreak\ntab\tstop\nquote\"back\\slash\n");

ordRes := compilerTest.compileCheckRunTs(root, tsComp, "text := import \"core/text\"; io := import \"core/io\"; io.outputLine(text.at(\"a\", 9) + text.slice(\"a\", 0, 9));", "");
test.check("str concat order nonzero", ordRes.status =!= 0);
test.check("str concat order panic", text.containsText(ordRes.stderr, "BoundPanic: textAt index outside text"));

/* restricted compiler lowers dynamic String concatenation to runnable C */
if ccInfo.available {
    strCSrc :=
    "io := import \"core/io\";\n" +
    "var prefix := \"lit\";\n" +
    "name := \"er\";\n" +
    "io.outputLine(prefix + name);\n" +
    "io.outputLine(prefix + name + \"!\");\n" +
    "io.outputLine(\"\" + prefix + \"\");\n" +
    "io.outputLine(\"snow🙂\" + \"man\");\n" +
    "io.outputLine(\"line\\n\" + \"break\");\n" +
    "io.outputLine(\"tab\\t\" + \"stop\");\n" +
    "io.outputLine(\"quote\\\"\" + \"back\\\\slash\");";
    strCComp := compilerTest.compileStdin(root, cComp, strCSrc, "");
    test.checkInt("str concat C", 0, strCComp.status);
    test.check("str concat C stdlib", text.containsText(strCComp.stdout, "#include <stdlib.h>"));
    test.check("str concat C helper", text.containsText(strCComp.stdout, "static const char *lite_concat(const char *left, const char *right)"));
    strCRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, strCSrc, "", "");
    test.checkInt("str concat C run", 0, strCRun.status);
    test.checkText("str concat C stdout", "liter\nliter!\nlit\nsnow🙂man\nline\nbreak\ntab\tstop\nquote\"back\\slash\n", strCRun.stdout);

    plainC := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; s := \"a\";\nio.outputLine(s);\n", "");
    test.checkInt("plain C", 0, plainC.status);
    test.check("plain C no lite_concat", not text.containsText(plainC.stdout, "lite_concat"));
    test.check("plain C no stdlib", not text.containsText(plainC.stdout, "#include <stdlib.h>"));
}

/* Lite-written TS and C compilers lower String values and multi-value reports deterministically */
strValProg := "io := import \"core/io\"; s := \"a\\\"b\";\nio.outputLine(s);\nio.outputLine(1, s, 2);\n";
strValTs := compilerTest.compileStdin(root, tsComp, strValProg, "");
test.checkInt("strVal ts", 0, strValTs.status);
test.checkText("strVal ts err", "", strValTs.stderr);
expStrValTs :=
"export function main(lite$write?: (text: string) => void): string {\n    const lite$out: string[] = [];\n    function lite$emit(text: string): void {\n        if (lite$write === undefined) lite$out.push(text);\n        else lite$write(text);\n    }\n" +
"    const lite_s = \"a\\\"b\";\n" +
"    void lite_s;\n" +
"    lite$emit(lite_s + \"\\n\");\n" +
"    lite$emit((1n).toString() + \" \" + lite_s + \" \" + (2n).toString() + \"\\n\");\n" +
"    return lite$out.join(\"\");\n}\n";
test.checkText("strVal ts out", expStrValTs, strValTs.stdout);

strValC := compilerTest.compileStdin(root, cComp, strValProg, "");
test.checkInt("strVal c", 0, strValC.status);
test.checkText("strVal c err", "", strValC.stderr);
expStrValC :=
"#include <stdio.h>\n#include <inttypes.h>\n#include <stdbool.h>\n#include <string.h>\nint main(void) {\n" +
"    int status = 0;\n" +
"    const char *lite_s = \"a\\\"b\";\n" +
"    (void)lite_s;\n" +
"    if (printf(\"%s\", lite_s) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    int64_t lt_output_0 = INT64_C(1);\n" +
"    const char * lt_output_1 = lite_s;\n" +
"    int64_t lt_output_2 = INT64_C(2);\n" +
"    if (printf(\"%\" PRId64, (int64_t)(lt_output_0)) < 0) { status = 1; }\n" +
"    if (printf(\" \") < 0) { status = 1; }\n" +
"    if (printf(\"%s\", lt_output_1) < 0) { status = 1; }\n" +
"    if (printf(\" \") < 0) { status = 1; }\n" +
"    if (printf(\"%\" PRId64, (int64_t)(lt_output_2)) < 0) { status = 1; }\n" +
"    if (printf(\"\\n\") < 0) { status = 1; }\n" +
"    return status;\n}\n";
test.checkText("strVal c out", expStrValC, strValC.stdout);

/* restricted TS compiler emits a deterministic report sequence */
expRepSeq :=
"export function main(lite$write?: (text: string) => void): string {\n    const lite$out: string[] = [];\n    function lite$emit(text: string): void {\n        if (lite$write === undefined) lite$out.push(text);\n        else lite$write(text);\n    }\n    lite$emit((42n).toString() + \"\\n\");\n    lite$emit((9n).toString() + \"\\n\");\n    return lite$out.join(\"\");\n}\n";
test.checkText("report seq ts", expRepSeq, compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(42);\nio.outputLine(9);", "").stdout);
