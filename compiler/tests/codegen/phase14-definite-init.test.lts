/* Phase 14 verification: definite initialization for partial expressions, immutable Bool predicate correlation, dynamic 1-byte C11 init/drop guards only for maybe-initialized owned locals, uninitialized-array slice rejection, TS strict + C11 -Werror + ASan/LSan/UBSan + LITE_CHECK_LEAKS=1 parity, and rejection matrix. */

test := import "core/test";
fs := import "core/file";
path := import "core/path";
proc := import "core/process";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

emptyBytes := fn(): List<Int> {
    xs: List<Int> = [];
    xs
};

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.buildCompiler(root, "ts");
test.check("build TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.buildCompiler(root, "c");
test.check("build C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccProbe := compilerTest.probeCc();

runAll := fn(label: String, src: String, expectedOut: String): String {
    tsCompRes := compilerTest.compileStdin(root, tsComp, src, "");
    test.checkInt(label + " ts compile: " + tsCompRes.stderr, 0, tsCompRes.status);
    tsChk := compilerTest.checkTsCode(root, tsCompRes.stdout);
    test.check(label + " tsc --strict: " + tsChk.error, tsChk.ok);
    tsRun := compilerTest.checkAndRunTs(root, tsCompRes.stdout);
    test.checkInt(label + " ts run status: " + tsRun.stderr, 0, tsRun.status);
    test.checkText(label + " ts stdout", expectedOut, tsRun.stdout);

    if not ccProbe.available {
        return "";
    }
    cCompRes := compilerTest.compileStdin(root, cComp, src, "");
    test.checkInt(label + " c compile: " + cCompRes.stderr, 0, cCompRes.status);
    tmpDir := fs.makeTempDir("lite-p14-");
    test.check(label + " makeTempDir", tmpDir.ok);
    cPath := path.join(tmpDir.path, "prog.c");
    wC := fs.writeText(cPath, cCompRes.stdout);
    test.check(label + " write prog.c", wC.ok);

    vmBin := path.join(tmpDir.path, "prog_vm");
    ccVmOut := path.join(tmpDir.path, "cc_vm.out");
    ccVmErr := path.join(tmpDir.path, "cc_vm.err");
    ccVm := proc.runBytes(ccProbe.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", cPath, "-o", vmBin, "-lm"], tmpDir.path, [], 30000, emptyBytes(), ccVmOut, ccVmErr);
    test.checkInt(label + " cc vm: " + fs.readText(ccVmErr).text, 0, ccVm.status);
    runVmOut := path.join(tmpDir.path, "run_vm.out");
    runVmErr := path.join(tmpDir.path, "run_vm.err");
    runVm := proc.runBytes(vmBin, [], tmpDir.path, ["LITE_CHECK_LEAKS=1"], 10000, emptyBytes(), runVmOut, runVmErr);
    test.checkInt(label + " vm status: " + fs.readText(runVmErr).text, 0, runVm.status);
    test.checkText(label + " vm stderr", "", fs.readText(runVmErr).text);
    test.checkText(label + " vm stdout parity", expectedOut, fs.readText(runVmOut).text);

    sanBin := path.join(tmpDir.path, "prog_san");
    ccSanOut := path.join(tmpDir.path, "cc_san.out");
    ccSanErr := path.join(tmpDir.path, "cc_san.err");
    ccSan := proc.runBytes(ccProbe.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-fsanitize=address,undefined", "-DLITE_ALLOC_SYSTEM", cPath, "-o", sanBin, "-lm"], tmpDir.path, [], 30000, emptyBytes(), ccSanOut, ccSanErr);
    test.checkInt(label + " cc san: " + fs.readText(ccSanErr).text, 0, ccSan.status);
    runSanOut := path.join(tmpDir.path, "run_san.out");
    runSanErr := path.join(tmpDir.path, "run_san.err");
    runSan := proc.runBytes(sanBin, [], tmpDir.path, ["LITE_CHECK_LEAKS=1"], 10000, emptyBytes(), runSanOut, runSanErr);
    test.checkInt(label + " san status: " + fs.readText(runSanErr).text, 0, runSan.status);
    test.checkText(label + " san stderr", "", fs.readText(runSanErr).text);
    test.checkText(label + " san stdout parity", expectedOut, fs.readText(runSanOut).text);

    _rm := fs.remove(tmpDir.path);
    cCompRes.stdout
};

rejectBoth := fn(label: String, src: String, expectedMsg: String): Unit {
    tsErr := compilerTest.compileStdin(root, tsComp, src, "");
    test.checkInt(label + " ts reject status", 2, tsErr.status);
    test.check(label + " ts msg got: " + tsErr.stderr, tsErr.stderr.contains(expectedMsg));
    cErr := compilerTest.compileStdin(root, cComp, src, "");
    test.checkInt(label + " c reject status", 2, cErr.status);
    test.check(label + " c msg got: " + cErr.stderr, cErr.stderr.contains(expectedMsg));
};

/* 1. Partial expression forms, Bool predicate correlation, flow narrowing & joins, loop tails */
corrSrc := [
    "io := import \"core/io\";",
    "dynBool := fn(n: Int): Bool { n > 0 };",
    "",
    "/* Positive, negated, else { ? }, if { ? } else { val }, widening */",
    "basicCorr := fn(n: Int): Int {",
    "    flag := dynBool(n);",
    "    a := if flag { 40 };",
    "    b: Int = if flag { 2 } else { ? };",
    "    c := if flag { ? } else { 100 };",
    "    d := if not flag { 7 };",
    "    if not flag { a = 1; b = 3; }",
    "    if flag { c = 50; d = 8; }",
    "    a + b + c + d",
    "};",
    "",
    "/* Early return / diverging guard proves remainder path */",
    "earlyBail := fn(n: Int): Int {",
    "    ready := dynBool(n);",
    "    x := if ready { n * 3 };",
    "    if not ready { return -1; }",
    "    x + 1",
    "};",
    "",
    "/* Preserved correlation across unrelated statements & value conditional reads */",
    "preservedCorr := fn(n: Int): Int {",
    "    ok := dynBool(n);",
    "    v: Float = if ok { 10 };",
    "    note := \"unrelated\";",
    "    if note == \"other\" { return 0; }",
    "    half := if ok { v } else { 0.0 };",
    "    var out := 0;",
    "    if ok { out = if v > 5.0 { 1 } else { 2 }; }",
    "    out + (if half > 0.0 { 10 } else { 20 })",
    "};",
    "",
    "/* Statement-form correlation & exhaustive match join */",
    "stmtAndMatch := fn(n: Int): Int {",
    "    flag := dynBool(n);",
    "    x: Int = ?;",
    "    if flag { x = 11; }",
    "    if not flag { x = 22; }",
    "    y: Int = ?;",
    "    match flag {",
    "        true { y = 100; }",
    "        false { y = 200; }",
    "    }",
    "    z: Int = ?;",
    "    match {",
    "        flag { z = 3; }",
    "        _ { z = 4; }",
    "    }",
    "    x + y + z",
    "};",
    "",
    "/* Guarded assignment & var replacement vs fixed single-write */",
    "guardedAssign := fn(n: Int): String {",
    "    flag := dynBool(n);",
    "    var x := 10;",
    "    x = if flag { 99 };",
    "    var y := 5;",
    "    y = if not flag { ? } else { 77 };",
    "    z := if flag { 1 } else { ? };",
    "    z = if not flag { 2 } else { ? };",
    "    x.toText() + \":\" + y.toText() + \":\" + z.toText()",
    "};",
    "",
    "/* Loop tail with else { ? } + nested block partial init */",
    "loopTailAndBlock := fn(xs: List<Int>): Int {",
    "    found := @lp loop xs as item {",
    "        if item > 10 { break item; } else { ? }",
    "    } then { if @lp.value > 0 { @lp.value } else { -1 } };",
    "    blk := do {",
    "        f := xs.length() > 1;",
    "        r := if f { found } else { ? };",
    "        if not f { r = 0; }",
    "        r",
    "    };",
    "    found + blk",
    "};",
    "",
    "/* Top-level constant-bound Bool correlation & finally-wrapped partial cond */",
    "topFlag := false;",
    "topX := if topFlag { 10 };",
    "if not topFlag { topX = 25; }",
    "topFin := (if topFlag { 7 } finally { io.outputLine(\"fin-top\"); });",
    "if not topFlag { topFin = 9; }",
    "",
    "io.outputLine(basicCorr(1), basicCorr(0));",
    "io.outputLine(earlyBail(4), earlyBail(0));",
    "io.outputLine(preservedCorr(5), preservedCorr(0));",
    "io.outputLine(stmtAndMatch(1), stmtAndMatch(-1));",
    "io.outputLine(guardedAssign(1), guardedAssign(0));",
    "io.outputLine(loopTailAndBlock([3, 15, 2]), loopTailAndBlock([1]));",
    "io.outputLine(topX, topFin);"
].join("\n");

corrOut := [
    "fin-top",
    "100 111",
    "13 -1",
    "11 20",
    "114 226",
    "99:77:1 10:5:2",
    "30 -1",
    "25 9"
].join("\n") + "\n";
_cCorr := runAll("predicate correlation & partial forms", corrSrc, corrOut);

/* 2. Owned values (List, Map, Record with List/Rc) under ASan/UBSan + LITE_CHECK_LEAKS=1, plus C11 init-guard check */
ownedSrc := [
    "io := import \"core/io\";",
    "rc := import \"core/rc\";",
    "",
    "Box := record {",
    "    label: String;",
    "    nums: List<Int>;",
    "    shared: rc.Rc<Int>;",
    "};",
    "",
    "dynFlag := fn(n: Int): Bool { n > 0 };",
    "",
    "mkMap2 := fn(k1: String, v1: Int, k2: String, v2: Int): Map<String, Int> {",
    "    mut m: Map<String, Int>;",
    "    m[k1] = v1;",
    "    m[k2] = v2;",
    "    m",
    "};",
    "mkMap3 := fn(k1: String, v1: Int, k2: String, v2: Int, k3: String, v3: Int): Map<String, Int> {",
    "    mut m: Map<String, Int>;",
    "    m[k1] = v1;",
    "    m[k2] = v2;",
    "    m[k3] = v3;",
    "    m",
    "};",
    "",
    "checkListsAndMaps := fn(n: Int): Int {",
    "    flag := dynFlag(n);",
    "    xs: List<Int> = if flag { [10, 20, 30] };",
    "    if not flag { xs = [40, 50]; }",
    "    mut ms: Map<String, Int> = if not flag { mkMap2(\"a\", 7, \"b\", 8) } else { ? };",
    "    if flag { ms = mkMap3(\"a\", 1, \"b\", 2, \"c\", 3); }",
    "    if flag and n == 2 {",
    "        /* early exit while owned maybe-init locals in nested do are only partially set */",
    "        inner: List<Int> = if dynFlag(n - 10) { [999] };",
    "        return xs.length() + ms.size();",
    "    }",
    "    xs[0] + ms.getOr(\"b\", 0) + ms.size()",
    "};",
    "",
    "checkVarOverwriteAndRecord := fn(n: Int): Int {",
    "    flag := dynFlag(n);",
    "    var mut owned: List<Int> = if flag { [1, 2, 3] };",
    "    if flag {",
    "        mut owned.pushBack(4);",
    "    }",
    "    /* Overwrite var owned local in both live (true) and uninit (false) states */",
    "    owned = [100, 200];",
    "",
    "    /* Conditional early return while box is uninitialized on false branch and initialized on true */",
    "    box := if flag { Box { label = \"owned-long-string-payload\", nums = [5, 6], shared = rc.Rc<Int>.create(77) } };",
    "    if n < 0 { return -9; }",
    "    if not flag {",
    "        box = Box { label = \"fallback-long-string\", nums = [8], shared = rc.Rc<Int>.create(11) };",
    "    }",
    "",
    "    /* Explicit reserved owned record */",
    "    resBox: Box = ?;",
    "    if flag {",
    "        resBox = Box { label = \"res-true-long-string\", nums = [1], shared = rc.Rc<Int>.create(2) };",
    "    } else {",
    "        resBox = Box { label = \"res-false-long-string\", nums = [3, 4], shared = rc.Rc<Int>.create(5) };",
    "    }",
    "",
    "    owned[0] + owned[1] + box.nums[0] + box.shared.get() + resBox.shared.get()",
    "};",
    "",
    "/* Block-local mut ys := if flag ... with List<Int> */",
    "makePairList := fn(): List<Int> { res: List<Int> = [11, 22]; res };",
    "blockPartialOwned := fn(n: Int): Int {",
    "    do {",
    "        flag := dynFlag(n);",
    "        mut ys := if flag { makePairList() };",
    "        if not flag { ys = [33]; }",
    "        mut ys.pushBack(44);",
    "        ys.length() + ys[0]",
    "    }",
    "};",
    "",
    "/* Separate helper that must NOT emit uint8_t lt_init_ */",
    "noGuardHelper := fn(flag: Bool): Int {",
    "    alwaysInit: List<Int> = if flag { [1, 2] } else { [3, 4] };",
    "    plain: List<Int> = [5, 6];",
    "    scalarPartial := if flag { 12 };",
    "    if not flag { scalarPartial = 20; }",
    "    alwaysInit[0] + plain[1] + scalarPartial",
    "};",
    "",
    "io.outputLine(checkListsAndMaps(1), checkListsAndMaps(2), checkListsAndMaps(0));",
    "io.outputLine(checkVarOverwriteAndRecord(1), checkVarOverwriteAndRecord(0), checkVarOverwriteAndRecord(-1));",
    "io.outputLine(blockPartialOwned(1), blockPartialOwned(0));",
    "io.outputLine(noGuardHelper(true), noGuardHelper(false));"
].join("\n");

ownedOut := [
    "15 6 50",
    "384 324 -9",
    "14 35",
    "19 29"
].join("\n") + "\n";
cOwnedCode := runAll("owned partial values + ASan/LSan + leaks", ownedSrc, ownedOut);

if ccProbe.available {
    /* Verify 1-byte uint8_t lt_init_ is emitted ONLY for dynamically maybe-initialized owned locals */
    test.check("C11 emits uint8_t lt_init_ for maybe-initialized owned locals", cOwnedCode.contains("uint8_t lt_init_"));
    noGuardIdx := cOwnedCode.indexOf("noGuardHelper", 0);
    test.check("C11 contains noGuardHelper", noGuardIdx >= 0);
    tailAfterHelper := cOwnedCode.slice(noGuardIdx, cOwnedCode.length());
    nextFnSemi := tailAfterHelper.indexOf("static int64_t", 14);
    helperBody := if nextFnSemi >= 0 { tailAfterHelper.slice(0, nextFnSemi) } else { tailAfterHelper };
    test.check("C11 omits lt_init_ for total owned locals and scalar partial locals: " + helperBody, not helperBody.contains("lt_init_"));
}

/* 3. Valid uninitialized-array slice AFTER initialization or inside correlated branch */
validArrSliceSrc := [
    "io := import \"core/io\";",
    "dynFlag := fn(n: Int): Bool { n > 0 };",
    "useArr := fn(n: Int): Int {",
    "    flag := dynFlag(n);",
    "    nums := if flag { [5, 6, 7, 8] };",
    "    if flag {",
    "        sv := nums[1..3];",
    "        return sv[0] + sv[1];",
    "    }",
    "    0",
    "};",
    "arr: [Int; 4] = ?;",
    "arr = [10, 20, 30, 40];",
    "s1 := arr[1..3];",
    "io.outputLine(s1[0], s1[1], useArr(1), useArr(0));"
].join("\n");
_cArr := runAll("valid array slice after init & correlated branch", validArrSliceSrc, "20 30 13 0\n");

/* 4. Complete negative / rejection matrix (18 cases checked on BOTH TS and C11) */
rejCases: List<(label: String, src: String, msg: String)> = [
    (label = "uncorrelated read after partial if", src = "io := import \"core/io\"; f := fn(flag: Bool): Int { a := if flag { 42 }; a };", msg = "cannot read uninitialized local a"),
    (label = "uncorrelated read after else ?", src = "f := fn(flag: Bool): Int { a := if flag { 42 } else { ? }; a };", msg = "cannot read uninitialized local a"),
    (label = "uncorrelated read after if ?", src = "f := fn(flag: Bool): Int { a := if flag { ? } else { 42 }; a };", msg = "cannot read uninitialized local a"),
    (label = "mutable var Bool does NOT correlate", src = "f := fn(initFlag: Bool): Int { var flag := initFlag; a := if flag { 42 }; if flag { return a; } 0 };", msg = "cannot read uninitialized local a"),
    (label = "wrong polarity read guard", src = "f := fn(flag: Bool): Int { a := if flag { 42 }; if not flag { return a; } 0 };", msg = "cannot read uninitialized local a"),
    (label = "reassign fixed partial on already-init branch", src = "f := fn(flag: Bool): Int { a := if flag { 42 }; if flag { a = 99; } 0 };", msg = "cannot assign to immutable local a"),
    (label = "unconditional second write to fixed partial", src = "f := fn(flag: Bool): Int { a := if flag { 42 }; a = 99; a };", msg = "cannot assign to possibly initialized immutable local a"),
    (label = "second write inside uncovered branch to fixed partial", src = "f := fn(flag: Bool): Int { a := if flag { 42 }; if not flag { a = 1; a = 2; } a };", msg = "cannot assign to immutable local a"),
    (label = "partial if in return value context", src = "f := fn(flag: Bool): Int { return if flag { 1 }; };", msg = "value if requires a final else"),
    (label = "else ? in return value context", src = "f := fn(flag: Bool): Int { return if flag { 1 } else { ? }; };", msg = "partial conditional with ? requires a declaration or assignment target"),
    (label = "partial if in call arg context", src = "io := import \"core/io\"; f := fn(flag: Bool): Unit { io.outputLine(if flag { 1 }); };", msg = "value if requires a final else"),
    (label = "partial Slice binding", src = "f := fn(flag: Bool): Int { arr := [1, 2, 3]; s := if flag { arr[0..2] }; 0 };", msg = "cannot leave Slice<Int> binding uninitialized in partial conditional"),
    (label = "direct = ? for List still rejected", src = "xs: List<Int> = ?;", msg = "reserved storage is not supported for List"),
    (label = "direct = ? for Map still rejected", src = "m: Map<String, Int> = ?;", msg = "reserved storage is not supported for Map"),
    (label = "direct = ? for Set still rejected", src = "s: Set<Int> = ?;", msg = "reserved storage is not supported for Set"),
    (label = "direct = ? for Rc still rejected", src = "rc := import \"core/rc\"; r: rc.Rc<Int> = ?;", msg = "reserved storage is not supported for Rc"),
    (label = "direct = ? for Slice still rejected", src = "s: Slice<Int> = ?;", msg = "reserved storage is not supported for Slice"),
    (label = "slice uninit fixed array", src = "arr: [Int; 4] = ?; s := arr[0..2];", msg = "cannot read uninitialized local arr"),
    (label = "mut slice uninit fixed array", src = "mut arr: [Int; 4] = ?; s := mut arr[0..2];", msg = "cannot read uninitialized local arr"),
    (label = "slice partial fixed array", src = "f := fn(flag: Bool): Int { arr := if flag { [1, 2, 3, 4] }; s := arr[0..2]; 0 };", msg = "cannot read uninitialized local arr"),
    (label = "capture maybe-init local in closure", src = "f := fn(flag: Bool): Int { a := if flag { 42 }; g := fn(): Int { a }; g() };", msg = "cannot read uninitialized local a")
];
loop rejCases as rc {
    rejectBoth(rc.label, rc.src, rc.msg);
}

test.done("phase14-definite-init");
