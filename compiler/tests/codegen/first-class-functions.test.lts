/* First-class non-capturing function values, callable types, contextual inference, self recursion, DCE, and rejections migrated from compiler/tests/host.test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
text := import "core/text";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

/* first-class non-capturing function values, callable types, contextual inference, self recursion, and DCE work in TS */
tmpFn := fs.makeTempDir("lite-fn-values-");
test.check("fn-values makeTempDir", tmpFn.ok);
fnDir := tmpFn.path;
_wOps := fs.writeText(path.join(fnDir, "ops.lts"), text.joinTexts([
    "helper := fn(n: Int): Int { n * 2 };",
    "pub double := fn(x: Int): Int { helper(x) };",
    "pub unusedPub := fn(x: Int): Int { x + 999 };"
], "\n"));
appFnPath := path.join(fnDir, "app.lts");
appFnSrc := text.joinTexts([
    "io := import \"core/io\";",
    "list := import \"core/list\";",
    "opsMod := import \"./ops.lts\";",
    "Op := type fn(Int): Int;",
    "Combine := type fn(Int, String): String;",
    "ZeroThunk := type fn(): Int;",
    "PairOp := type (op: Op, offset: Int);",
    "apply := fn(op: Op, x: Int): Int { op(x) };",
    "applyPair := fn(p: PairOp): Int { p.op(p.offset) };",
    "applyCombine := fn(f: Combine, n: Int, s: String): String { f(n, s) };",
    "incByTen := fn(x: Int): Int { x + 10 };",
    "bump := fn(x: Int): Int { x + 1 };",
    "makeStep := fn(kind: Int): Op {",
    "  if kind == 0 { fn(x) { x + 2 } } else { fn(x) { x * 3 } }",
    "};",
    "runNested := fn(flag: Bool): Int {",
    "  localAdd := fn(a: Int, b: Int, c: Int): Int { a * 100 + b * 10 + c };",
    "  b := 2; c := 3;",
    "  routed := localAdd(9, a = 1, =b, =c);",
    "  pair := (op = fn(n: Int): Int { n + 5 }, offset = 4);",
    "  (extracted, offsetVal) := pair;",
    "  matched := match { flag { fn(a: Int): Int { a + 1 } } _ { fn(b2: Int): Int { b2 * 10 } } };",
    "  {",
    "    bump := fn(x: Int): Int { x * 10 };",
    "    io.outputLine(\"shadow\", bump(3));",
    "  }",
    "  io.outputLine(\"outer\", bump(3), routed, applyPair(pair), pair.0(1), extracted(offsetVal), matched(4));",
    "  routed",
    "};",
    "orderTest := fn(): Unit {",
    "  pick := fn(): fn(Int, Int): Int {",
    "    io.outputLine(\"callee\");",
    "    fn(a: Int, b: Int): Int { io.outputLine(\"body\", a, b); a - b }",
    "  };",
    "  arg := fn(tag: String, v: Int): Int { io.outputLine(tag); v };",
    "  io.outputLine((pick())(arg(\"first\", 10), arg(\"second\", 3)));",
    "};",
    "var zf: fn(Int): Int;",
    "var zt: ZeroThunk;",
    "var zu: fn(): Unit;",
    "var zs: fn(Int): String;",
    "var zarr: [Op; 2];",
    "var rf: fn(Int): Int = ?;",
    "zu();",
    "rf = fn(x) { x + 50 };",
    "io.outputLine(\"zero\", zf(9), zt(), zs(1), zarr[0](5), rf(7));",
    "zf = fn(x) { x + 100 };",
    "io.outputLine(\"reassigned\", zf(7));",
    "var dyn: fn(Int): Int = fn(n) { if n <= 1 { 1 } else { n * self(n - 1) } };",
    "io.outputLine(\"rec\", dyn(5), apply(fn(n) { if n <= 0 { 0 } else { n + self(n - 1) } }, 4));",
    "dyn = fn(n) { n * 2 };",
    "io.outputLine(\"reassigned2\", dyn(6), apply(incByTen, 5), apply(opsMod.double, 7));",
    "io.outputLine(\"step\", makeStep(0)(10), makeStep(1)(10));",
    "io.outputLine(\"comb\", applyCombine(fn(n, s) { s + \":\" }, 3, \"k\"));",
    "arr: [Op; 2] = [fn(x) { x + 1 }, incByTen];",
    "opList: mut List<Op> = [fn(x) { x * 2 }, opsMod.double];",
    "list.pushBack(mut opList, fn(x) { x - 1 });",
    "io.outputLine(\"colls\", arr[0](4), arr[1](4), opList[0](5), opList[1](5), opList[2](5));",
    "var sink: fn(Int): Unit = fn(n: Int): Unit { io.outputLine(\"sink\", n); };",
    "sink(42);",
    "_ := runNested(false);",
    "orderTest();"
], "\n");
_wApp := fs.writeText(appFnPath, appFnSrc);
realAppPath := fs.realPath(appFnPath);
test.check("fn-values realPath", realAppPath.ok);

appComp := compilerTest.compileStdin(root, tsComp, appFnSrc, realAppPath.path);
test.checkInt("fn-values compile: " + appComp.stderr, 0, appComp.status);
test.check("fn-values prunes unusedPub", not text.containsText(appComp.stdout, "unusedPub"));
appRun := compilerTest.checkAndRunTs(root, appComp.stdout);
test.checkInt("fn-values run status: " + appRun.stderr, 0, appRun.status);
test.checkText("fn-values run stdout", text.joinTexts([
    "zero 0 0  0 57",
    "reassigned 107",
    "rec 120 10",
    "reassigned2 12 15 14",
    "step 12 30",
    "comb k:",
    "colls 5 14 10 10 4",
    "sink 42",
    "shadow 30",
    "outer 4 123 9 6 9 40",
    "callee",
    "first",
    "second",
    "body 10 3",
    "7"
], "\n") + "\n", appRun.stdout);
_rmFn := fs.remove(fnDir);

neverFnSrc := text.joinTexts([
    "io := import \"core/io\";",
    "die := fn(code: Int): Int { io.exit(code); };",
    "runExit := fn(f: fn(Int): Int): Int { f(4) };",
    "io.outputLine(runExit(die));"
], "\n");
neverFnRun := compilerTest.compileCheckRunTs(root, tsComp, neverFnSrc, "");
test.checkInt("fn-values never status", 4, neverFnRun.status);
test.checkText("fn-values never stdout", "", neverFnRun.stdout);

neverArgSrc := text.joinTexts([
    "io := import \"core/io\";",
    "badB := fn(): Int { io.outputLine(\"should-not-run\"); 9 };",
    "localAdd := fn(a: Int, b: Int): Int { a + b };",
    "io.outputLine(localAdd(io.exit(5), badB()));"
], "\n");
neverArgRun := compilerTest.compileCheckRunTs(root, tsComp, neverArgSrc, "");
test.checkInt("fn-values never-arg status", 5, neverArgRun.status);
test.checkText("fn-values never-arg stdout", "", neverArgRun.stdout);

/* first-class function rejections cover non-function calls, tags, comparisons, cyclic aliases, and C backend */
fnTsRej: List<(src: String, m1: String, m2: String)> = [
    (src = "io := import \"core/io\"; f := fn(): Int { 1 }; { f := 2; io.outputLine(f()); }", m1 = "cannot call non-function value of type Int", m2 = ""),
    (src = "x := \"hi\"; x();", m1 = "cannot call non-function value of type String", m2 = ""),
    (src = "v := @outer { f := fn(): Int { return @outer 5; 1 }; _ := f(); 0 };", m1 = "unknown block tag @outer", m2 = ""),
    (src = "@outer loop true { f := fn(): Unit { break @outer; }; f(); break; }", m1 = "unknown block tag @outer", m2 = ""),
    (src = "var rf: fn(Int): Int = ?; _ := rf(1);", m1 = "cannot read uninitialized local rf", m2 = ""),
    (src = "io := import \"core/io\"; f := fn(x: Int): Int { x }; g := fn(x: Int): Int { x }; io.outputLine(f == g);", m1 = "cannot compare function values", m2 = ""),
    (src = "io := import \"core/io\"; f := fn(x: Int): Int { x }; g := fn(x: Int): Int { x }; io.outputLine(f =!= g);", m1 = "cannot compare function values", m2 = ""),
    (src = "io := import \"core/io\"; f := fn(x: Int): Int { x }; io.outputLine(f);", m1 = "cannot output function value", m2 = ""),
    (src = "Bad := type fn(Bad): Int; var f: Bad = ?;", m1 = "recursive type alias Bad", m2 = ""),
    (src = "f: fn(Int): Int = fn(x, y) { x + y };", m1 = "expected : Type for parameter y", m2 = ""),
    (src = "f: fn(Int): Int = fn(x: Int, y: Int): Int { x + y };", m1 = "cannot initialize", m2 = ""),
    (src = "f: fn(Int): Int = fn(x) { \"bad\" };", m1 = "cannot return String from function", m2 = ""),
    (src = "f := fn(x: Int): Unit { }; n: Int = f(1);", m1 = "cannot initialize Int with Unit", m2 = "cannot assign"),
    (src = "f := fn(a: Int): Int { a }; f(z = 1);", m1 = "unknown parameter z", m2 = ""),
    (src = "io := import \"core/io\"; io.outputLine(io.inputArgs);", m1 = "function io.inputArgs must be called", m2 = "")
];
loop fnTsRej as rj {
    res := compilerTest.compileStdin(root, tsComp, rj.src, "");
    test.checkInt("fn-rej ts status: " + rj.src, 2, res.status);
    ok := text.containsText(res.stderr, rj.m1) or (rj.m2 =!= "" and text.containsText(res.stderr, rj.m2));
    test.check("fn-rej ts msg (" + rj.src + ") got: " + res.stderr, ok);
}

fnCRej: List<(src: String, msg: String)> = [
    (src = "{ f := fn(): Int { 1 }; _ := f(); }", msg = "C backend does not support function values yet"),
    (src = "var f: fn(Int): Int;", msg = "C backend does not support function values yet"),
    (src = "inc := fn(x: Int): Int { x + 1 }; ops: List<fn(Int): Int> = [inc];", msg = "function inc must be called"),
    (src = "inc := fn(x: Int): Int { x + 1 }; apply := fn(op: fn(Int): Int): Int { op(1) }; _ := apply(inc);", msg = "C backend does not support indirect function calls yet")
];
loop fnCRej as cr {
    compilerTest.assertCompileErrorContains(root, cComp, "fn-rej c", cr.src, cr.msg);
}

test.done("first-class-functions");
