/* Dual-target (TS + C11) tests for Slice 1A type-attached operations (`TypeName.op := fn(recv: [mut] Self, ...)`). */

test := import "core/test";
file := import "core/file";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

runBoth := fn(label: String, src: String, expected: String): Unit {
    tsRes := compilerTest.compileCheckRunTs(root, tsComp, src, "");
    test.checkInt(label + " ts status: " + tsRes.stderr, 0, tsRes.status);
    test.checkText(label + " ts stderr", "", tsRes.stderr);
    test.checkText(label + " ts stdout", expected, tsRes.stdout);
    if ccInfo.available {
        cRes := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, src, "", "");
        test.checkInt(label + " c status: " + cRes.stderr, 0, cRes.status);
        test.checkText(label + " c stderr", "", cRes.stderr);
        test.checkText(label + " c stdout parity", tsRes.stdout, cRes.stdout);
    }
};

expectRejectBoth := fn(label: String, src: String, expectedMsg: String): Unit {
    compilerTest.assertCompileErrorContains(root, tsComp, label + " ts", src, expectedMsg);
    if ccInfo.available {
        compilerTest.assertCompileErrorContains(root, cComp, label + " c", src, expectedMsg);
    }
};

/* 1. Records, chaining, named args, Self in body, forward calls, recursion via self(...), type-qualified calls & fn values. */
recSrc :=
"io := import \"core/io\";\n" +
"\n" +
"Vec2 := record {\n" +
"    x: Int;\n" +
"    y: Int;\n" +
"}\n" +
"\n" +
"Vec2.sumTwice := fn(v: Self): Int {\n" +
"    v.sum() * 2\n" +
"};\n" +
"\n" +
"Vec2.sum := fn(v: Self): Int {\n" +
"    v.x + v.y\n" +
"};\n" +
"\n" +
"Vec2.add := fn(a: Self, b: Self): Self {\n" +
"    Self { x = a.x + b.x, y = a.y + b.y }\n" +
"};\n" +
"\n" +
"Vec2.scale := fn(v: Self, factor: Int): Self {\n" +
"    Self { x = v.x * factor, y = v.y * factor }\n" +
"};\n" +
"\n" +
"Vec2.stepAdd := fn(v: Self, n: Int): Self {\n" +
"    if n <= 0 { v } else { self(Self { x = v.x + 1, y = v.y + 2 }, n - 1) }\n" +
"};\n" +
"\n" +
"a := Vec2 { x = 2, y = 3 };\n" +
"b := Vec2 { x = 4, y = 5 };\n" +
"c := a.add(b).scale(factor = 3);\n" +
"d := Vec2.add(a, b);\n" +
"adder := Vec2.add;\n" +
"e := adder(a, d);\n" +
"f := a.stepAdd(3);\n" +
"io.outputLine(c.x, c.y, c.sum(), c.sumTwice());\n" +
"io.outputLine(d.x, d.y, e.x, e.y);\n" +
"io.outputLine(f.x, f.y);\n";

runBoth("record-ops", recSrc, "18 24 42 84\n6 8 8 11\n5 9\n");

/* 2. mut Self on records: COW snapshot isolation, nested mut forwarding, early return, inside functions & top level. */
mutRecSrc :=
"io := import \"core/io\";\n" +
"\n" +
"Player := record {\n" +
"    hp: Int;\n" +
"    armor: Int;\n" +
"}\n" +
"\n" +
"Player.takeDamage := fn(p: mut Self, dmg: Int): Int {\n" +
"    if dmg <= 0 { return p.hp; }\n" +
"    p.hp -= dmg;\n" +
"    p.hp\n" +
"};\n" +
"\n" +
"Player.heal := fn(p: mut Self, amount: Int): Unit {\n" +
"    p.hp += amount;\n" +
"};\n" +
"\n" +
"Player.rest := fn(p: mut Self): Int {\n" +
"    mut p.heal(15);\n" +
"    p.armor += 2;\n" +
"    p.hp\n" +
"};\n" +
"\n" +
"Player.drain := fn(p: mut Self, steps: Int): Int {\n" +
"    if steps <= 0 { p.hp } else { p.hp -= 1; self(mut p, steps - 1) }\n" +
"};\n" +
"\n" +
"runBattle := fn(): Int {\n" +
"    mut hero := Player { hp = 50, armor = 1 };\n" +
"    snap := hero;\n" +
"    _r1 := mut hero.takeDamage(20);\n" +
"    _r2 := (mut hero).rest();\n" +
"    _r3 := mut hero.drain(3);\n" +
"    io.outputLine(snap.hp, snap.armor, hero.hp, hero.armor);\n" +
"    hero.hp\n" +
"};\n" +
"\n" +
"mut player := Player { hp = 100, armor = 5 };\n" +
"snapshot := player;\n" +
"rem := mut player.takeDamage(10);\n" +
"afterRest := mut player.rest();\n" +
"Player.heal(mut player, 5);\n" +
"io.outputLine(snapshot.hp, snapshot.armor, rem, afterRest, player.hp, player.armor);\n" +
"io.outputLine(runBattle());\n";

runBoth("mut-record-cow", mutRecSrc, "100 5 90 105 110 7\n50 1 42 3\n42\n");

/* 3. Plain and value-backed enums with type-attached operations alongside .value. */
enumSrc :=
"io := import \"core/io\";\n" +
"\n" +
"Status := enum: Int {\n" +
"    Ok = 200,\n" +
"    NotFound = 404,\n" +
"    Err = 500,\n" +
"}\n" +
"\n" +
"Status.isOk := fn(s: Self): Bool {\n" +
"    s == Self.Ok\n" +
"};\n" +
"\n" +
"Status.codePlus := fn(s: Self, delta: Int): Int {\n" +
"    s.value + delta\n" +
"};\n" +
"\n" +
"s1 := Status.Ok;\n" +
"s2 := Status.NotFound;\n" +
"io.outputLine(s1.isOk(), s2.isOk(), s1.codePlus(1), Status.codePlus(s2, 10));\n";

runBoth("enum-ops", enumSrc, "true false 201 414\n");

/* 3b. Arbitrary grouping parentheses around mut leases on dot calls and mut args. */
groupedMutSrc :=
"io := import \"core/io\";\n" +
"P := record { hp: Int; }\n" +
"P.hit := fn(p: mut Self): Unit { p.hp -= 1; };\n" +
"P.getHp := fn(p: Self): Int { p.hp };\n" +
"bump := fn(p: mut P): Unit { p.hp += 2; };\n" +
"mut p := P { hp = 10 };\n" +
"(((((mut p))))).hit();\n" +
"mut (p).hit();\n" +
"bump(((((mut p)))));\n" +
"bump(p = ((mut p)));\n" +
"io.outputLine(p.getHp());\n";
runBoth("grouped-mut-leases", groupedMutSrc, "12\n");

/* 4. Rejections: mut on read-only, missing call-site mut, stray mut on read-only op, rvalue, missing receiver, non-Self receiver, alias attachment, field collision, duplicate op, bare x.op, unknown $hook. */
expectRejectBoth("mut-on-readonly",
"P := record { hp: Int; }\n" +
"P.hit := fn(p: mut Self): Unit { p.hp -= 1; };\n" +
"p := P { hp = 10 };\n" +
"mut p.hit();\n",
"cannot call mutating operation hit on read-only value");

expectRejectBoth("missing-call-site-mut",
"P := record { hp: Int; }\n" +
"P.hit := fn(p: mut Self): Unit { p.hp -= 1; };\n" +
"mut p := P { hp = 10 };\n" +
"p.hit();\n",
"mutating operation P.hit requires mut at call site");

expectRejectBoth("stray-mut-on-readonly-op",
"P := record { hp: Int; }\n" +
"P.getHp := fn(p: Self): Int { p.hp };\n" +
"mut p := P { hp = 10 };\n" +
"_x := mut p.getHp();\n",
"operation P.getHp does not mutate its receiver; remove mut");

expectRejectBoth("grouped-stray-mut-on-readonly-op",
"P := record { hp: Int; }\n" +
"P.getHp := fn(p: Self): Int { p.hp };\n" +
"mut p := P { hp = 10 };\n" +
"_x := (((((mut p))))).getHp();\n",
"operation P.getHp does not mutate its receiver; remove mut");

expectRejectBoth("mut-arg-to-readonly-io",
"io := import \"core/io\";\n" +
"mut xs: List<Int> = [1];\n" +
"io.outputLine(mut xs);\n",
"expected .operation(...) after mut xs");

expectRejectBoth("grouped-mut-arg-to-readonly-io",
"io := import \"core/io\";\n" +
"mut xs: List<Int> = [1];\n" +
"io.outputLine((mut xs));\n",
"expected .operation(...) after mut xs");

expectRejectBoth("mut-parenthesized-call-rejected",
"P := record { hp: Int; }\n" +
"P.hit := fn(p: mut Self): Unit { p.hp -= 1; };\n" +
"mut p := P { hp = 10 };\n" +
"mut (p.hit());\n",
"expected ) after mut p");

expectRejectBoth("mut-on-rvalue",
"P := record { hp: Int; }\n" +
"P.hit := fn(p: mut Self): Unit { p.hp -= 1; };\n" +
"make := fn(): P { P { hp = 10 } };\n" +
"make().hit();\n",
"cannot call mutating operation hit on read-only value");

expectRejectBoth("static-called-on-value",
"P := record { hp: Int; }\n" +
"P.zero := fn(): Self { Self { hp = 0 } };\n" +
"p := P { hp = 1 };\n" +
"z := p.zero();\n",
"is a type-level operation with no Self receiver");

expectRejectBoth("static-mut-called-on-value",
"P := record { hp: Int; }\n" +
"P.zero := fn(): Self { Self { hp = 0 } };\n" +
"mut p := P { hp = 1 };\n" +
"z := mut p.zero();\n",
"is a type-level operation with no Self receiver");

expectRejectBoth("static-alias-arg-mismatch",
"Vec := record<T: Type, N: Int> { data: [T; N]; }\n" +
"IVec2 := alias Vec<Int, 2>;\n" +
"Vec.splat := fn<T: Type, N: Int>(val: T): Self<T, N> { Self<T, N> { data = [val; N] } };\n" +
"bad := IVec2.splat(1.5);\n",
"conflicting type bindings for T: Int vs Float");

expectRejectBoth("static-specialized-dim-mismatch",
"Mat := record<T: Type, R: Int, C: Int> { rows: [[T; C]; R]; }\n" +
"Mat.id := fn<N: Int>(): Self<Float, N, N> {\n" +
"    out: [[Float; N]; N];\n" +
"    Self<Float, N, N> { rows = out }\n" +
"};\n" +
"bad := Mat<Float, 2, 3>.id();\n",
"operation id requires");

expectRejectBoth("static-dollar-hook-rejected",
"P := record { hp: Int; }\n" +
"P.$getIndex := fn(a: Int, idx: Int): Int { a + idx };\n",
"$getIndex receiver on P must have Self type");

expectRejectBoth("concrete-owner-dollar-hook-rejected",
"P := record { hp: Int; }\n" +
"P.$getIndex := fn(p: P, idx: Int): Int { p.hp + idx };\n",
"$getIndex receiver on P must have Self type");

expectRejectBoth("non-self-concrete-first-param-is-static",
"P := record { hp: Int; }\n" +
"P.createFrom := fn(v: P, bonus: Int): Self { Self { hp = v.hp + bonus } };\n" +
"p := P { hp = 10 };\n" +
"q := p.createFrom(5);\n",
"is a type-level operation with no Self receiver");

expectRejectBoth("generic-concrete-first-param-is-static",
"Box := record<T: Type> { val: T; }\n" +
"Box.createFrom := fn<T: Type>(v: Box<T>, extra: Int): Self<T> { _e := extra; v };\n" +
"b := Box<Int> { val = 7 };\n" +
"q := b.createFrom(1);\n",
"is a type-level operation with no Self receiver");

expectRejectBoth("alias-attachment",
"P := record { hp: Int; }\n" +
"AliasP := alias P;\n" +
"AliasP.get := fn(p: Self): Int { p.hp };\n",
"cannot attach operation to alias or foreign type AliasP");

expectRejectBoth("field-collision",
"P := record { hp: Int; }\n" +
"P.hp := fn(p: Self): Int { p.hp };\n",
"collides with record field hp");

expectRejectBoth("enum-value-collision",
"S := enum: Int { Ok = 1 }\n" +
"S.value := fn(s: Self): Int { 1 };\n",
"collides with enum backing value");

expectRejectBoth("duplicate-op",
"P := record { hp: Int; }\n" +
"P.get := fn(p: Self): Int { p.hp };\n" +
"P.get := fn(p: Self): Int { p.hp + 1 };\n",
"duplicate type operation P.get");

expectRejectBoth("bare-dot-op-no-parens",
"P := record { hp: Int; }\n" +
"P.get := fn(p: Self): Int { p.hp };\n" +
"p := P { hp = 1 };\n" +
"f := p.get;\n",
"must be called with (...)");

expectRejectBoth("unknown-dollar-hook",
"P := record { hp: Int; }\n" +
"P.$bogus := fn(p: Self): Int { p.hp };\n",
"unknown compiler hook $bogus");

/* 5. Cross-module pub + transitive visibility + private op isolation. */
tmpDir := file.makeTempDir("lite-type-ops-");
test.check("makeTempDir: " + tmpDir.error, tmpDir.ok);
modAPath := tmpDir.path + "/vec.lts";
modBPath := tmpDir.path + "/factory.lts";
modTransPath := tmpDir.path + "/app_trans.lts";
modCPath := tmpDir.path + "/app.lts";
modPrivPath := tmpDir.path + "/app_priv.lts";

modASrc :=
"pub Vec2 := record { x: Int; y: Int; }\n" +
"Vec2.secret := fn(v: Self): Int { v.x * 10 + v.y };\n" +
"pub Vec2.add := fn(a: Self, b: Self): Self { Self { x = a.x + b.x, y = a.y + b.y } };\n" +
"pub Vec2.score := fn(v: Self): Int { v.secret() + 1 };\n" +
"pub Vec := record<T: Type, N: Int> { data: [T; N]; }\n" +
"pub IVec2 := alias Vec<Int, 2>;\n" +
"pub PairVec := alias<E: Type> Vec<E, 2>;\n" +
"pub Vec.zeroed := fn<T: Type, N: Int>(): Self<T, N> { res: Self<T, N>; res };\n" +
"pub Vec.splat := fn<T: Type, N: Int>(val: T): Self<T, N> { Self<T, N> { data = [val; N] } };\n" +
"pub Vec.rank := fn<T: Type, N: Int>(): Int { N };\n" +
"pub Vec.tag := fn<T: Type, N: Int, U: Type>(x: U): U { x };\n" +
"pub Vec.fromZero := fn<N: Int>(v: Self<Float, N>): Self<Float, N> { _u := v; Self<Float, N>.zeroed() };\n";

modBSrc :=
"v := import \"./vec.lts\";\n" +
"pub make := fn(x: Int, y: Int): v.Vec2 { v.Vec2 { x = x, y = y } };\n";

modTransSrc :=
"io := import \"core/io\";\n" +
"f := import \"./factory.lts\";\n" +
"p := f.make(2, 3);\n" +
"q := f.make(4, 5);\n" +
"r := p.add(q);\n" +
"io.outputLine(r.x, r.y, r.score());\n";

modCSrc :=
"io := import \"core/io\";\n" +
"v := import \"./vec.lts\";\n" +
"f := import \"./factory.lts\";\n" +
"p := f.make(2, 3);\n" +
"q := f.make(4, 5);\n" +
"r := p.add(q);\n" +
"r2 := v.Vec2.add(p, q);\n" +
"fnRef := v.Vec2.add;\n" +
"r3 := fnRef(p, q);\n" +
"zI := v.IVec2.zeroed();\n" +
"sI := v.IVec2.splat(9);\n" +
"sF := v.PairVec.splat(3.5);\n" +
"zI2 := v.PairVec<Int>.zeroed();\n" +
"zExplicit := v.PairVec.zeroed<Int>();\n" +
"rk := v.IVec2.rank();\n" +
"tg := v.IVec2.tag<String>(\"ok\");\n" +
"fz := v.Vec<Float, 2>.fromZero(v.PairVec.splat(1.0));\n" +
"io.outputLine(r.x, r.y, r.score(), r2.x, r2.y, r3.x, r3.y, zI.data[1], sI.data[0], sF.data[1], zI2.data[0], zExplicit.data[0], rk, tg, fz.data[0]);\n";

modPrivSrc :=
"f := import \"./factory.lts\";\n" +
"p := f.make(2, 3);\n" +
"x := p.secret();\n";

_wA := file.writeText(modAPath, modASrc);
_wB := file.writeText(modBPath, modBSrc);
_wT := file.writeText(modTransPath, modTransSrc);
_wC := file.writeText(modCPath, modCSrc);
_wP := file.writeText(modPrivPath, modPrivSrc);

tsTransComp := compilerTest.compileFile(tsComp, tmpDir.path, [modTransPath]);
test.checkInt("pure-transitive ts compile status: " + tsTransComp.stderr, 0, tsTransComp.status);
tsTransRes := compilerTest.checkAndRunTs(root, tsTransComp.stdout);
test.checkInt("pure-transitive ts status: " + tsTransRes.stderr, 0, tsTransRes.status);
test.checkText("pure-transitive ts stdout", "6 8 69\n", tsTransRes.stdout);
if ccInfo.available {
    cTransComp := compilerTest.compileFile(cComp, tmpDir.path, [modTransPath]);
    test.checkInt("pure-transitive c compile status: " + cTransComp.stderr, 0, cTransComp.status);
    cTransRes := compilerTest.compileAndRunC(cTransComp.stdout, ccInfo.cc, "");
    test.checkInt("pure-transitive c status: " + cTransRes.stderr, 0, cTransRes.status);
    test.checkText("pure-transitive c stdout parity", tsTransRes.stdout, cTransRes.stdout);
}

tsModComp := compilerTest.compileFile(tsComp, tmpDir.path, [modCPath]);
test.checkInt("transitive ts compile status: " + tsModComp.stderr, 0, tsModComp.status);
tsModRes := compilerTest.checkAndRunTs(root, tsModComp.stdout);
test.checkInt("transitive ts status: " + tsModRes.stderr, 0, tsModRes.status);
test.checkText("transitive ts stdout", "6 8 69 6 8 6 8 0 9 3.5 0 0 2 ok 0\n", tsModRes.stdout);
if ccInfo.available {
    cModComp := compilerTest.compileFile(cComp, tmpDir.path, [modCPath]);
    test.checkInt("transitive c compile status: " + cModComp.stderr, 0, cModComp.status);
    cModRes := compilerTest.compileAndRunC(cModComp.stdout, ccInfo.cc, "");
    test.checkInt("transitive c status: " + cModRes.stderr, 0, cModRes.status);
    test.checkText("transitive c stdout parity", tsModRes.stdout, cModRes.stdout);
}

tsPrivComp := compilerTest.compileFile(tsComp, tmpDir.path, [modPrivPath]);
test.check("private op hidden from importer (ts)", tsPrivComp.status =!= 0);
if ccInfo.available {
    cPrivComp := compilerTest.compileFile(cComp, tmpDir.path, [modPrivPath]);
    test.check("private op hidden from importer (c)", cPrivComp.status =!= 0);
}

_rm := file.remove(tmpDir.path);

/* 6. Local non-generic and generic static type operations + alias propagation. */
staticLocalSrc :=
"io := import \"core/io\";\n" +
"P := record { hp: Int; }\n" +
"P.zero := fn(): Self { Self { hp = 0 } };\n" +
"P.from := fn(hp: Int): Self { Self { hp = hp } };\n" +
"P.createFrom := fn(v: P, bonus: Int): Self { Self { hp = v.hp + bonus } };\n" +
"P.cloneSelf := fn(v: Self): Self { Self { hp = v.hp } };\n" +
"Box := record<T: Type> { val: T; }\n" +
"IntBox := alias Box<Int>;\n" +
"Box.createFrom := fn<T: Type>(v: Box<T>, extra: T): Self<T> { Self<T> { val = extra } };\n" +
"Vec := record<T: Type, N: Int> { data: [T; N]; }\n" +
"Mat := record<T: Type, R: Int, C: Int> { rows: [Vec<T, C>; R]; }\n" +
"Mat.id := fn<N: Int>(): Self<Float, N, N> {\n" +
"    out: [Vec<Float, N>; N];\n" +
"    Self<Float, N, N> { rows = out }\n" +
"};\n" +
"FMat3 := alias Mat<Float, 3, 3>;\n" +
"p0 := P.zero();\n" +
"ctor := P.from;\n" +
"p1 := ctor(42);\n" +
"p2 := P.createFrom(p1, 8);\n" +
"p3 := p2.cloneSelf();\n" +
"bx := IntBox.createFrom(Box<Int> { val = 1 }, 99);\n" +
"m3 := FMat3.id();\n" +
"m2 := Mat<Float, 2, 2>.id();\n" +
"m4 := Mat.id<4>();\n" +
"io.outputLine(p0.hp, p1.hp, p2.hp, p3.hp, bx.val, m3.rows.length(), m2.rows.length(), m4.rows.length());\n";
runBoth("static-type-ops-local", staticLocalSrc, "0 42 50 50 99 3 2 4\n");

/* 7. Array<T, N> equivalence with [T; N], concrete/generic aliases, and 1-arg Array<T> rejection. */
arraySyntaxSrc :=
"io := import \"core/io\";\n" +
"Row := alias<T: Type> Array<T, 4>;\n" +
"Bytes4 := alias Array<Int, 4>;\n" +
"Box := record<T: Type, N: Int> { items: Array<T, N>; }\n" +
"sum4 := fn(xs: Array<Int, 4>): Int { xs[0] + xs[1] + xs[2] + xs[3] };\n" +
"a: Array<Int, 4> = [1, 2, 3, 4];\n" +
"b: [Int; 4] = a;\n" +
"c: Bytes4 = b;\n" +
"r: Row<Int> = c;\n" +
"e: Array<Int, 0> = [];\n" +
"bx := Box<Int, 3> { items = [10, 20, 30] };\n" +
"f1 := Array<Int, 4>.filled(9);\n" +
"f2 := Array.filled<Int, 3>(1);\n" +
"z1 := Array<Float, 3>.zeroed();\n" +
"z2 := Array.zeroed<Int, 4>();\n" +
"af := Bytes4.filled(7);\n" +
"az := Bytes4.zeroed();\n" +
"rf := Row.filled(8);\n" +
"rz := Row.zeroed<Float>();\n" +
"io.outputLine(sum4(a), sum4(b), sum4(c), r[2], bx.items.length(), bx.items[1], e.length(), f1[3], f2[2], z1[1], z2[0], af[2], az[3], rf[1], rz[2]);\n";
runBoth("array-two-arg-type-syntax", arraySyntaxSrc, "10 10 10 3 3 20 0 9 1 0 0 7 0 8 0\n");

expectRejectBoth("reject-one-arg-array-type",
"bad: Array<Int> = [1, 2];\n",
"Array requires two arguments: Array<T, N>");

expectRejectBoth("reject-array-unit-elem",
"bad: Array<Unit, 3>;\n",
"unsupported array element type Unit");

expectRejectBoth("reject-array-generic-zero-extent",
"Buf := alias<N: Int> Array<Int, N>;\n" +
"bad: Buf<0>;\n",
"array extent must be a positive integer");

test.done("type-operations");
