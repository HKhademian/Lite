/* End-to-end C11 execution tests for Phase C5b: Map<K, V> and Set<T> literals, indexing, core/map & core/set intrinsics, value-copy, loops, and output formatting. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

src :=
"io := import \"core/io\";\n" +
"\n" +
"scores: mut Map<String, Int> = [\"alice\" = 10];\n" +
"mut scores.set(\"bob\", 25);\n" +
"scores[\"alice\"] += 8;\n" +
"scores[\"carol\"] = 40;\n" +
"snapM: Map<String, Int> = scores;\n" +
"removed := mut scores.remove(\"bob\");\n" +
"io.outputLine(\"scores:\", scores, \"removed:\", removed, \"size:\", scores.size(), scores.isEmpty());\n" +
"io.outputLine(\"alice:\", scores[\"alice\"], \"has bob:\", scores.has(\"bob\"), \"getOr:\", scores.getOr(\"bob\", -1));\n" +
"g1 := scores.get(\"alice\");\n" +
"g2 := scores.get(\"bob\");\n" +
"io.outputLine(\"g1:\", g1.found, g1.value, \"g2:\", g2.found, g2.value);\n" +
"io.outputLine(\"keys:\", snapM.keys(), \"vals:\", snapM.values());\n" +
"loop snapM as entry { io.outputLine(\"m:\", entry.key, entry.value); }\n" +
"mut scores.clear();\n" +
"io.outputLine(\"cleared:\", scores.size(), scores.isEmpty());\n" +
"\n" +
"tags: mut Set<String> = [\"lite\", \"typed\", \"lite\"];\n" +
"mut tags.add(\"c11\");\n" +
"snapS: Set<String> = tags;\n" +
"sRem := mut tags.remove(\"lite\");\n" +
"io.outputLine(\"tags:\", tags, \"sRem:\", sRem, \"has lite:\", tags.has(\"lite\"), \"size:\", tags.size(), tags.isEmpty());\n" +
"io.outputLine(\"snapS vals:\", snapS.values(), \"snapS size:\", snapS.size());\n" +
"loop snapS as tag { io.outputLine(\"s:\", tag); }\n" +
"mut tags.clear();\n" +
"io.outputLine(\"s cleared:\", tags.size(), tags.isEmpty());\n";

tsRes := compilerTest.compileCheckRunTs(root, tsComp, src, "");
test.checkInt("ts status: " + tsRes.stderr, 0, tsRes.status);
test.checkText("ts stderr", "", tsRes.stderr);

if ccInfo.available {
    cRes := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, src, "", "");
    test.checkInt("c status: " + cRes.stderr, 0, cRes.status);
    test.checkText("c stdout parity", tsRes.stdout, cRes.stdout);
    test.checkText("c stderr", "", cRes.stderr);

    panicSrc := "io := import \"core/io\"; m: Map<String, Int> = [\"a\" = 1]; io.outputLine(m[\"missing\"]);\n";
    cPanic := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, panicSrc, "", "");
    test.checkInt("c map missing key panic status", 1, cPanic.status);
    test.check("c map missing key panic msg: " + cPanic.stderr, cPanic.stderr.contains("BoundPanic: map key not found"));

    tombSrc := "io := import \"core/io\";\n" +
        "text := import \"core/text\";\n" +
        "m: mut Map<String, Int>;\n" +
        "mut m.set(\"a\", 1); mut m.set(\"b\", 2); mut m.set(\"c\", 3); mut m.set(\"d\", 4);\n" +
        "snap := m;\n" +
        "_r1 := mut m.remove(\"a\"); _r2 := mut m.remove(\"c\");\n" +
        "mut m.set(\"a\", 10);\n" +
        "var sum := 0; loop m as e { sum += e.value; }\n" +
        "io.outputLine(m.keys().join(\",\"), snap.size(), sum);\n" +
        "s: mut Set<String>;\n" +
        "mut s.add(\"x\"); mut s.add(\"y\"); mut s.add(\"z\");\n" +
        "_rs := mut s.remove(\"x\"); mut s.add(\"x\");\n" +
        "lv: mut List<String> = []; loop s as v { mut lv.pushBack(v); }\n" +
        "io.outputLine(lv.join(\",\"));\n" +
        "bigM: mut Map<Int, Int>; bigS: mut Set<Int>;\n" +
        "loop 0..5000 as i { mut bigM.set(i, i * 2); mut bigS.add(i); }\n" +
        "loop 0..4995 as i { _dm := mut bigM.remove(i); _ds := mut bigS.remove(i); }\n" +
        "io.outputLine(bigM.size(), bigS.size(), bigM.getOr(4999, -1), bigS.has(4999), bigS.has(100));\n";
    tsTomb := compilerTest.compileCheckRunTs(root, tsComp, tombSrc, "");
    test.checkInt("ts tombstone parity status: " + tsTomb.stderr, 0, tsTomb.status);
    cTomb := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, tombSrc, "", "");
    test.checkInt("c tombstone parity status: " + cTomb.stderr, 0, cTomb.status);
    test.checkText("tombstone TS/C stdout parity", tsTomb.stdout, cTomb.stdout);
    test.checkText("tombstone expected stdout", "b,d,a 4 16\ny,z,x\n5 5 9998 true false\n", cTomb.stdout);
} else {
    cOnly := compilerTest.compileStdin(root, cComp, src, "");
    test.checkInt("c compile status: " + cOnly.stderr, 0, cOnly.status);
}

test.done("c-backend-maps-sets");
