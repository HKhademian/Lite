/* Core os/fs/process/crypto/time/unicode/external host bindings, standalone CLI execution, and C backend rejections migrated from compiler/tests/host.test.ts. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
text := import "core/text";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
json := import "data/json";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

fixtureName := path.join(root, "compiler/tests/fixtures/core-host-os.lts");

emptyArgs := fn(): List<String> {
    res: List<String> = [];
    res
};

/* core os/fs/process/crypto/time host bindings */
coreHostSrc := [
"fs := import \"core/file\";",
"pathLib := import \"core/path\";",
"proc := import \"core/process\";",
"crypto := import \"core/crypto\";",
"time := import \"core/time\";",
"io := import \"core/io\";",
"writeTwoLines := fn(w: io.Writer, a: String, b: String): Bool {",
"    r1 := w.writeLine(a);",
"    r2 := w.writeLine(b);",
"    r1.ok and r2.ok",
"};",
"collectAllLines := fn(r: io.Reader): String {",
"    var out := \"\";",
"    loop true {",
"        res := r.readLine();",
"        if not res.ok or res.eof { break; }",
"        if out =!= \"\" { out = out + \"|\"; }",
"        out = out + res.line;",
"    }",
"    out",
"};",
"bw := io.Writer.buffer();",
"bwOk := writeTwoLines(bw, \"alpha\", \"beta\");",
"bwTxt := bw.text();",
"trLines := collectAllLines(io.Reader.fromText(\"alpha\\r\\nbeta\\ngamma\"));",
"tmp := fs.makeTempDir(\"lite-os-host-\");",
"if not tmp.ok { io.outputLine(\"mkdir-temp-fail\", tmp.error); io.exit(1); }",
"dir := tmp.path;",
"sub := dir + \"/sub\";",
"made := fs.makeDir(sub);",
"file := sub + \"/target.txt\";",
"wrote := fs.writeText(file, \"hello world\\n\");",
"readOk := fs.readText(file);",
"appFile := sub + \"/append.txt\";",
"fw := fs.openWriter(appFile);",
"fwOk := writeTwoLines(fw, \"first\", \"second\");",
"_fwFlush := fw.flush();",
"_fwClose := fw.close();",
"appRes := fs.appendText(appFile, \"third\\n\");",
"fr := fs.openReader(appFile);",
"frLines := collectAllLines(fr);",
"_frClose := fr.close();",
"badOpen := fs.openReader(dir + \"/absent.txt\");",
"rawFile := sub + \"/raw.bin\";",
"rawBytes: List<Int> = [0, 65, 255, 13, 10];",
"wroteRaw := fs.writeBytes(rawFile, rawBytes);",
"readRaw := fs.readBytes(rawFile);",
"emptyFile := sub + \"/empty.bin\";",
"wroteEmpty := fs.writeBytes(emptyFile, []);",
"readEmpty := fs.readBytes(emptyFile);",
"badByteHigh := fs.writeBytes(dir + \"/bad-high.bin\", [256]);",
"badByteNeg := fs.writeBytes(dir + \"/bad-neg.bin\", [-1]);",
"badRead := fs.readText(dir + \"/missing.txt\");",
"subCopy := dir + \"/sub-copy\";",
"copied := fs.copy(sub, subCopy);",
"entries := fs.listDir(dir);",
"linkPath := dir + \"/link.txt\";",
"linked := fs.symlink(\"sub/target.txt\", linkPath);",
"real := fs.realPath(linkPath);",
"removed := fs.remove(subCopy);",
"removedMissing := fs.remove(subCopy);",
"unsetEnv := proc.envGet(\"LITE_DEFINITELY_UNSET_XYZ\");",
"homeEnv := proc.envGet(\"PATH\");",
"childOk := proc.run(proc.execPath(), [\"-e\", \"process.stdout.write(process.env.LITE_ENV_CHILD + ':' + process.getBuiltinModule('node:fs').readFileSync(0,'utf8'))\"], dir, [\"LITE_ENV_CHILD=ok\"], true, \"ping\");",
"childFail := proc.run(\"/no/such/binary-lite-xyz\", [], \"\", [], true, \"\");",
"bytesOutPath := dir + \"/child-out.bin\";",
"bytesErrPath := dir + \"/child-err.bin\";",
"childBytes := proc.runBytes(proc.execPath(), [\"-e\", \"const b = process.getBuiltinModule('node:fs').readFileSync(0); process.stdout.write(b); process.stderr.write(Buffer.from([b.length, 42])); process.exit(3);\"], dir, [], 5000, rawBytes, bytesOutPath, bytesErrPath);",
"childTimeout := proc.runBytes(proc.execPath(), [\"-e\", \"setTimeout(() => {}, 2000)\"], dir, [], 50, [], dir + \"/t-out.bin\", dir + \"/t-err.bin\");",
"utfBytes := \"A€\".utf8Encode();",
"hashText := crypto.sha256Text(\"hello\");",
"hashBytes := crypto.sha256Bytes(rawBytes);",
"hashEmptyBytes := crypto.sha256Bytes([]);",
"hashRawFile := crypto.sha256File(rawFile);",
"hashFile := crypto.sha256File(file);",
"hashMissing := crypto.sha256File(dir + \"/missing.txt\");",
"t0 := time.monotonicNs();",
"t1 := time.monotonicNs();",
"iso := time.utcIsoNow();",
"io.outputLine(fs.kind(dir), fs.kind(file), fs.kind(linkPath), fs.kind(dir + \"/missing.txt\"), pathLib.isDirectory(dir), pathLib.isFile(file), not pathLib.exists(dir + \"/missing.txt\"), pathLib.stem(file), pathLib.withExt(file, \"md\") == sub + \"/target.md\");",
"io.outputLine(bwOk, bwTxt.ok, bwTxt.text == \"alpha\\nbeta\\n\", trLines, fwOk, appRes.ok, frLines, not badOpen.ok(), badOpen.error() =!= \"\");",
"io.outputLine(made.ok, wrote.ok, readOk.ok, readOk.text == \"hello world\\n\", not badRead.ok, copied.ok);",
"io.outputLine(wroteRaw.ok, readRaw, wroteEmpty.ok, readEmpty, not badByteHigh.ok, fs.kind(dir + \"/bad-high.bin\"), not badByteNeg.ok);",
"io.outputLine(entries, linked.ok, real.ok, real.path == fs.realPath(file).path, removed.ok, removedMissing.ok);",
"io.outputLine(proc.cwd() =!= \"\", proc.execPath() =!= \"\", proc.platform() =!= \"\", proc.arch() =!= \"\", proc.runtimeVersion() =!= \"\", not unsetEnv.found, unsetEnv.value == \"\", homeEnv.found);",
"io.outputLine(childOk.status, childOk.stdout, childOk.stderr == \"\", childOk.error == \"\", childFail.status, childFail.error =!= \"\");",
"io.outputLine(childBytes.status, childBytes.error == \"\", fs.readBytes(bytesOutPath), fs.readBytes(bytesErrPath), childTimeout.status, childTimeout.error =!= \"\", utfBytes, \"\".utf8Encode());",
"io.outputLine(hashText == \"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\", hashBytes == hashRawFile.hex, hashEmptyBytes == crypto.sha256Text(\"\"), hashFile.ok, hashFile.hex == crypto.sha256Text(\"hello world\\n\"), not hashMissing.ok);",
"io.outputLine(t1 >= t0, iso =!= \"\");",
"clean := fs.remove(dir);",
"io.outputLine(clean.ok, fs.kind(dir));"
].join("\n");
coreHostExpected := [
"dir file file missing true true true target true",
"true true true alpha|beta|gamma true true first|second|third true true",
"true true true true true true",
"true [0, 65, 255, 13, 10] true [] true missing true",
"[sub, sub-copy] true true true true true",
"true true true true true true true true",
"0 ok:ping true true -1 true",
"3 true [0, 65, 255, 13, 10] [5, 42] -1 true [65, 226, 130, 172] []",
"true true true true true true",
"true true",
"true missing"
].join("\n") + "\n";
compilerTest.assertCompileRunTsNamed(root, tsComp, "core-host-os", coreHostSrc, fixtureName, coreHostExpected);

/* core/text unicode scalar length/at */
compilerTest.assertCompileRunTsNamed(
root,
tsComp,
"core-text-scalar",
"io := import \"core/io\"; io.outputLine(\"A🙂\".length(), \"A🙂\".at(1));",
fixtureName,
"2 🙂\n"
);

/* extended core crypto, time, and unicode */
extCoreSrc := [
"crypto := import \"core/crypto\";",
"list := import \"core/list\";",
"text := import \"core/text\";",
"time := import \"core/time\";",
"io := import \"core/io\";",
"raw: List<Int> = [0, 65, 255];",
"b64 := crypto.base64Encode(raw);",
"b64Ok := crypto.isValidBase64(b64);",
"b64Dec := crypto.base64Decode(b64);",
"b64Bad1 := crypto.isValidBase64(\"not-base64!\");",
"b64Bad2 := crypto.isValidBase64(\"YWJj=\");",
"hex := crypto.hexEncode(raw);",
"hexOk := crypto.isValidHex(\"0041FF\");",
"hexDec := crypto.hexDecode(\"0041FF\");",
"hexBadOdd := crypto.isValidHex(\"abc\");",
"hexBadChar := crypto.isValidHex(\"zz\");",
"sha512 := crypto.sha512Text(\"abc\");",
"sha512b := crypto.sha512Bytes([97, 98, 99]);",
"hmac := crypto.hmacSha256Bytes([107, 101, 121], [97, 98, 99]);",
"var mut longKey: List<Int> = [];",
"loop longKey.length() < 80 { mut longKey.pushBack(170); }",
"hmacLong := crypto.hmacSha256Bytes(longKey, [84, 101, 115, 116]);",
"rand0 := crypto.randomBytes(0);",
"rand16 := crypto.randomBytes(16);",
"ms0 := time.epochMs();",
"ns0 := time.epochNs();",
"isoNow := time.utcIsoNow();",
"mono0 := time.monotonicNs();",
"time.sleepMs(15);",
"mono1 := time.monotonicNs();",
"ldate := time.localDate();",
"u8 := \"A€🙂\".utf8Encode();",
"u8Ok := String.fromUtf8Strict(u8);",
"u8Bad := String.fromUtf8Strict([255]);",
"u8Overlong := String.fromUtf8Strict([192, 175]);",
"u8Surrogate := String.fromUtf8Strict([237, 160, 128]);",
"u8BadVal := String.fromUtf8Strict([256]);",
"u8Lossy := String.fromUtf8Lossy([65, 255, 66]);",
"u8LossyEdge := String.fromUtf8Lossy([65, 224, 128, 66, 226, 130]);",
"u16 := \"A🙂\".utf16Encode();",
"u16Ok := String.fromUtf16Strict(u16);",
"u16BadHigh := String.fromUtf16Strict([55357]);",
"u16BadLow := String.fromUtf16Strict([56898]);",
"u16BadRange := String.fromUtf16Strict([65536]);",
"cps := \"A€🙂\".toCodePoints();",
"cpOk := String.fromCodePoints(cps);",
"cpBadSur := String.fromCodePoints([55296]);",
"cpBadHi := String.fromCodePoints([1114112]);",
"oneCp := String.fromCodePoint(128578);",
"io.outputLine(b64, b64Ok, b64Dec, not b64Bad1, not b64Bad2);",
"io.outputLine(hex, hexOk, hexDec, not hexBadOdd, not hexBadChar);",
"io.outputLine(sha512 == \"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f\", sha512 == sha512b);",
"io.outputLine(hmac, hmacLong, rand0.length(), rand16.length());",
"io.outputLine(ms0 > 1700000000000, ns0 >= ms0 * 1000000, mono1 > mono0, ldate, isoNow);",
"io.outputLine(u8, u8Ok.ok, u8Ok.text == \"A€🙂\", not u8Bad.ok, not u8Overlong.ok, not u8Surrogate.ok, not u8BadVal.ok, u8Lossy, u8LossyEdge);",
"io.outputLine(String.isValidUtf8(u8), not String.isValidUtf8([255]), \"A🙂\".utf16Length(), u16, u16Ok.ok, u16Ok.text == \"A🙂\");",
"io.outputLine(not u16BadHigh.ok, not u16BadLow.ok, not u16BadRange.ok);",
"io.outputLine(cps, cpOk.ok, cpOk.text == \"A€🙂\", not cpBadSur.ok, not cpBadHi.ok);",
"io.outputLine(oneCp.ok, oneCp.text == \"🙂\", \"A€🙂\".codePointAt(2), text.isValidScalar(65), not text.isValidScalar(55296), not text.isValidScalar(1114112));"
].join("\n");
extRun := compilerTest.compileCheckRunTs(root, tsComp, extCoreSrc, fixtureName);
test.checkInt("ext-core status", 0, extRun.status);
mut extLines: List<String> = [];
var lineStart := 0;
var extPos := 0;
extLen := extRun.stdout.length();
loop extPos < extLen {
    if extRun.stdout.at(extPos) == "\n" {
        mut extLines.pushBack(extRun.stdout.slice(lineStart, extPos));
        lineStart = extPos + 1;
    }
    extPos = extPos + 1;
}
var extLineCount := 0;
loop extLines as _l { extLineCount = extLineCount + 1; }
test.checkInt("ext-core line count", 10, extLineCount);
test.checkText("ext-core line 0", "AEH/ true [0, 65, 255] true true", extLines[0]);
test.checkText("ext-core line 1", "0041ff true [0, 65, 255] true true", extLines[1]);
test.checkText("ext-core line 2", "true true", extLines[2]);
test.checkText("ext-core line 3", "9c196e32dc0175f86f4b1cb89289d6619de6bee699e4c378e68309ed97a1a6ab 1afc6ca6c0ce1afa0ffeebf214fd763101957961e5f70cfac3b5d005e8fd5625 0 16", extLines[3]);
test.check("ext-core line 4 time markers: " + extLines[4], extLines[4].startsWithAt(0, "true true true ") and extLines[4].endsWith("Z") and extLines[4].contains("T"));
fffd := String.fromCodePoint(65533).text;
test.checkText("ext-core line 5", "[65, 226, 130, 172, 240, 159, 153, 130] true true true true true true A" + fffd + "B A" + fffd + fffd + "B" + fffd, extLines[5]);
test.checkText("ext-core line 6", "true true 3 [65, 55357, 56898] true true", extLines[6]);
test.checkText("ext-core line 7", "true true true", extLines[7]);
test.checkText("ext-core line 8", "[65, 8364, 128578] true true true true", extLines[8]);
test.checkText("ext-core line 9", "true true 128578 true true true", extLines[9]);

/* unicode-only builtin vs pure emitter */
uniOnlySrc := "io := import \"core/io\"; io.outputLine(String.fromUtf8Strict(\"hi\".utf8Encode()).text, \"🙂\".toCodePoints());";
uniDefaultComp := compilerTest.compileStdin(root, tsComp, uniOnlySrc, fixtureName);
test.checkInt("uni-only default compile", 0, uniDefaultComp.status);
test.check("uni-only default check", compilerTest.checkTsCode(root, uniDefaultComp.stdout).ok);
test.check("uni-only default utf8Encode", uniDefaultComp.stdout.contains("lite$unicodeUtf8Encode("));
test.check("uni-only default utf8DecodeStrict", uniDefaultComp.stdout.contains("lite$unicodeUtf8DecodeStrict("));
test.check("uni-only default no node", not uniDefaultComp.stdout.contains("node:buffer") and not uniDefaultComp.stdout.contains("node:crypto"));
uniDefaultRun := compilerTest.checkAndRunTs(root, uniDefaultComp.stdout);
test.checkInt("uni-only default run", 0, uniDefaultRun.status);
test.checkText("uni-only default out", "hi [128578]\n", uniDefaultRun.stdout);

pureOpts: List<String> = ["--builtin-mode", "pure"];
uniPureComp := compilerTest.compileStdinWithOpts(root, tsComp, root, uniOnlySrc, fixtureName, "", pureOpts);
test.checkInt("uni-only pure compile", 0, uniPureComp.status);
test.check("uni-only pure check", compilerTest.checkTsCode(root, uniPureComp.stdout).ok);
test.check("uni-only pure no host decoder", not uniPureComp.stdout.contains("TextEncoder") and not uniPureComp.stdout.contains("TextDecoder") and not uniPureComp.stdout.contains("node:buffer") and not uniPureComp.stdout.contains("node:crypto"));
uniPureRun := compilerTest.checkAndRunTs(root, uniPureComp.stdout);
test.checkInt("uni-only pure run", 0, uniPureRun.status);
test.checkText("uni-only pure out", "hi [128578]\n", uniPureRun.stdout);

/* crypto invalid decode runtime exit status 2 */
badDecode1 := compilerTest.compileCheckRunTs(root, tsComp, "c := import \"core/crypto\"; _ := c.base64Decode(\"abc\");", fixtureName);
test.checkInt("bad base64 status", 2, badDecode1.status);
test.check("bad base64 stderr", badDecode1.stderr.contains("invalid base64 input"));
badDecode2 := compilerTest.compileCheckRunTs(root, tsComp, "c := import \"core/crypto\"; _ := c.hexDecode(\"abc\");", fixtureName);
test.checkInt("bad hex status", 2, badDecode2.status);
test.check("bad hex stderr", badDecode2.stderr.contains("invalid hex input"));

/* standalone generated TS script execution */
standaloneSrc := [
"fs := import \"core/file\";",
"proc := import \"core/process\";",
"io := import \"core/io\";",
"if proc.entryPath() == \"\" { _in := io.inputAll(\"\"); _txt := fs.readText(\".\"); }",
"io.outputLine(proc.entryPath() =!= \"\", io.inputArgs());"
].join("\n");
standaloneComp := compilerTest.compileStdin(root, tsComp, standaloneSrc, fixtureName);
test.checkInt("standalone compile", 0, standaloneComp.status);
test.check("standalone tsc", compilerTest.checkTsCode(root, standaloneComp.stdout).ok);
tmpStandalone := fs.makeTempDir("lite-standalone-cli-");
test.check("standalone makeTempDir", tmpStandalone.ok);
toolScript := path.join(tmpStandalone.path, "tool.ts");
_wtTool := fs.writeText(toolScript, standaloneComp.stdout);
standaloneRun := proc.run(proc.execPath(), [toolScript, "alpha", "beta"], tmpStandalone.path, emptyArgs(), true, "");
test.checkInt("standalone run status", 0, standaloneRun.status);
test.checkText("standalone run stdout", "true [alpha, beta]\n", standaloneRun.stdout);
_rmStandalone := fs.remove(tmpStandalone.path);

/* proc.runStreams + crypto.sha256Reader + Reader.copyTo + Writer.writeAndClose */
streamChildSrc := [
"io := import \"core/io\";",
"bytes := io.Reader.stdin().readAll();",
"out := io.Writer.stdout();",
"err := io.Writer.stderr();",
"_w1 := out.write(bytes);",
"_w2 := out.writeText(\"|done\");",
"_f1 := out.flush();",
"_w3 := err.writeLine(\"warn\");",
"_f2 := err.flush();"
].join("\n");
streamChildComp := compilerTest.compileStdin(root, tsComp, streamChildSrc, fixtureName);
test.checkInt("stream-child compile", 0, streamChildComp.status);
test.check("stream-child tsc", compilerTest.checkTsCode(root, streamChildComp.stdout).ok);
tmpStream := fs.makeTempDir("lite-proc-streams-test-");
test.check("stream makeTempDir", tmpStream.ok);
childScript := path.join(tmpStream.path, "echo-stream.ts");
multiBin := path.join(tmpStream.path, "multi-chunk.bin");
_wtChild := fs.writeText(childScript, streamChildComp.stdout);
parentSrc := [
"crypto := import \"core/crypto\";",
"file := import \"core/file\";",
"io := import \"core/io\";",
"proc := import \"core/process\";",
"outW := io.Writer.buffer();",
"errW := io.Writer.buffer();",
"res := proc.runStreams(proc.execPath(), [" + json.quoteString(childScript) + "], \"\", [], 10000, io.Reader.fromBytes([65, 0, 66]), outW, errW);",
"outBytes := outW.bytes();",
"errTxt := errW.text();",
"bigFile := " + json.quoteString(multiBin) + ";",
"var mut big: List<Int> = [];",
"loop big.length() < 20000 { mut big.pushBack((big.length() * 13) % 256); }",
"_wb := file.writeBytes(bigFile, big);",
"rBig := file.openReader(bigFile);",
"hStreamFile := crypto.sha256Reader(rBig);",
"_rc := rBig.close();",
"hFastFile := crypto.sha256File(bigFile);",
"hStream := crypto.sha256Reader(io.Reader.fromText(\"hello\"));",
"h512 := crypto.sha512Text(\"abc\");",
"ioW := io.Writer.buffer();",
"ioCopied := io.Reader.fromText(\"via-io\").copyTo(ioW);",
"ioWTxt := ioW.text();",
"wcWriter := io.Writer.buffer();",
"wcRes := wcWriter.writeAndClose([120, 121]);",
"wcBytes := wcWriter.bytes();",
"wcClosed := wcWriter.ok();",
"io.outputLine(res.status, res.error == \"\", outBytes, errTxt.ok, errTxt.text == \"warn\\n\", hStreamFile.ok, hStreamFile.hex == hFastFile.hex, hStream.ok, hStream.hex == crypto.sha256Text(\"hello\"), h512 == crypto.sha512Text(\"abc\"), ioCopied.ok, ioCopied.copied, ioWTxt.ok, ioWTxt.text, wcRes.ok, wcBytes, wcClosed);"
].join("\n");
compilerTest.assertCompileRunTsNamed(
root,
tsComp,
"proc-streams-parent",
parentSrc,
fixtureName,
"0 true [65, 0, 66, 124, 100, 111, 110, 101] true true true true true true true true 6 true via-io true [120, 121] false\n"
);
_rmStream := fs.remove(tmpStream.path);

compilerTest.assertCompileErrorContainsNamed(
root,
tsComp,
"removed file.copyStream",
"file := import \"core/file\"; io := import \"core/io\"; _ := file.copyStream(io.Reader.fromText(\"a\"), io.Writer.buffer());",
fixtureName,
"unknown module member file.copyStream"
);

/* unbound host declaration rejections */
tmpUnbound := fs.makeTempDir("lite-core-os-unbound-");
test.check("unbound makeTempDir", tmpUnbound.ok);
_wu1 := fs.writeText(path.join(tmpUnbound.path, "file.lts"), "pub kind := fn(path: String): String;\n");
appUnbPath := path.join(tmpUnbound.path, "app.lts");
appUnbSrc := "file := import \"./file.lts\"; x := file.kind(\".\");\n";
_wu2 := fs.writeText(appUnbPath, appUnbSrc);
realUnbApp := fs.realPath(appUnbPath);
test.check("unbound realPath", realUnbApp.ok);
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "unbound relative", appUnbSrc, realUnbApp.path, "bodyless function declaration has no matching core host binding");
_rmUnbound := fs.remove(tmpUnbound.path);

compilerTest.assertCompileErrorContainsNamed(root, tsComp, "bad file abi", "pub kind := fn(path: String): Int;", "lib/core/file.lt", "bodyless function declaration has no matching core host binding");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "bad ext-ts abi", "pub stripTypes := fn(source: String): String;", "lib/external/ts.lt", "bodyless function declaration has no matching core host binding");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "bad ext-pool abi", "pub cpuCount := fn(): String;", "lib/external/pool.lt", "bodyless function declaration has no matching core host binding");

/* external/ts, external/pool, external/http, external/bench */
extTsRun := compilerTest.compileCheckRunTs(
root,
tsComp,
"io := import \"core/io\"; extTs := import \"external/ts\"; good := extTs.stripTypes(\"const x: number = 42;\"); io.outputLine(good.ok, good.code);",
fixtureName
);
test.checkInt("external-ts status", 0, extTsRun.status);
test.checkText("external-ts stdout", "true const x         = 42;\n", extTsRun.stdout);

extPoolSrc := "io := import \"core/io\"; pool := import \"external/pool\"; procs := pool.cpuCount(); empty := pool.runPoolJson([], [], \"\", 2); out := pool.runPoolJson([\"node\", \"node\"], [\"[\\\"-e\\\",\\\"process.stdout.write('one')\\\"]\", \"[\\\"-e\\\",\\\"process.stdout.write('two');process.exit(3)\\\"]\"], \"\", 2); io.outputLine(procs >= 1, empty, out);";
extPoolRun := compilerTest.compileCheckRunTs(root, tsComp, extPoolSrc, fixtureName);
test.checkInt("ext-pool status", 0, extPoolRun.status);
test.check("ext-pool prefix", extPoolRun.stdout.startsWithAt(0, "true [] ["));
poolJsonText := extPoolRun.stdout.slice("true [] ".length(), extPoolRun.stdout.length() - 1);
test.check("ext-pool json valid", json.validate(poolJsonText).ok);
poolElems := json.arrayOffsets(poolJsonText, 0);
test.checkInt("ext-pool len", 2, poolElems.length());
test.checkInt("ext-pool 0 status", 0, json.readFieldInt(poolJsonText, poolElems[0], "status").value);
test.checkText("ext-pool 0 stdout", "one", json.readFieldString(poolJsonText, poolElems[0], "stdout").value);
test.checkText("ext-pool 0 stderr", "", json.readFieldString(poolJsonText, poolElems[0], "stderr").value);
test.checkText("ext-pool 0 error", "", json.readFieldString(poolJsonText, poolElems[0], "error").value);
test.checkInt("ext-pool 1 status", 3, json.readFieldInt(poolJsonText, poolElems[1], "status").value);
test.checkText("ext-pool 1 stdout", "two", json.readFieldString(poolJsonText, poolElems[1], "stdout").value);
test.checkText("ext-pool 1 stderr", "", json.readFieldString(poolJsonText, poolElems[1], "stderr").value);
test.checkText("ext-pool 1 error", "", json.readFieldString(poolJsonText, poolElems[1], "error").value);

extProbes: List<String> = [
"extHttp := import \"external/http\"; res := extHttp.fetchToFile(\"http://127.0.0.1:1/\", \"\", 50, []); if res.ok { _ := res.status; }",
"extHttp := import \"external/http\"; if false { _ := extHttp.serveStatic(\".\", \"\", \"127.0.0.1\", 0); }",
"extBench := import \"external/bench\"; if false { _ := extBench.measureCompilerArtifact(\"T11\", \"a\", \"b\", \"c\", \"d\"); }",
"pool := import \"external/pool\"; if false { _a := pool.cpuCount(); _b := pool.runPoolJson([], [], \"\", 0); }"
];
loop extProbes as probe {
    pComp := compilerTest.compileStdin(root, tsComp, probe, fixtureName);
    test.checkInt("ext-probe compile", 0, pComp.status);
    test.check("ext-probe tsc", compilerTest.checkTsCode(root, pComp.stdout).ok);
}

/* C backend top-level/module functions parity and dead-fn DCE */
reachableCComp := compilerTest.compileStdin(root, cComp, "unused := fn(): List<Int> { xs: List<Int> = [1, 2]; xs }; io := import \"core/io\"; io.outputLine(42);", fixtureName);
test.checkInt("reachable-c status", 0, reachableCComp.status);
test.check("reachable-c emits 42", reachableCComp.stdout.contains("42"));

ccInfo := compilerTest.probeCc();
cFnParityCases: List<(label: String, src: String, expectedOut: String)> = [
(
label = "basic scalar fn",
src = "unused := fn(): Int { 1 }; used := fn(a: Int, b: Int): Int { a + b * 2 }; io := import \"core/io\"; io.outputLine(used(10, 5));",
expectedOut = "20\n"
),
(
label = "mutual recursion and forward call",
src = "isEven := fn(n: Int): Bool { if n == 0 { return true; } isOdd(n - 1) }; isOdd := fn(n: Int): Bool { if n == 0 { return false; } isEven(n - 1) }; fact := fn(n: Int): Int { if n <= 1 { return 1; } n * fact(n - 1) }; io := import \"core/io\"; io.outputLine(isEven(6), isOdd(6), fact(5));",
expectedOut = "true false 120\n"
),
(
label = "unit fn output and mixed scalars",
src = "io := import \"core/io\"; say := fn(tag: String): Unit { io.outputLine(\"say\", tag); }; greet := fn(name: String, n: Int, f: Float, b: Bool): String { if b { return name + \":ok\"; } name + \":no\" }; io.outputLine(say(\"first\"), greet(\"x\", 1, 1.5, true), 42);",
expectedOut = "say first\nUnit x:ok 42\n"
),
(
label = "captured globals and future init",
src = "base := 10; var acc := 1; addFuture := fn(x: Int): Int { x + base + later }; bump := fn(d: Int): Int { acc = acc + d; acc }; later := 5; io := import \"core/io\"; io.outputLine(addFuture(2), bump(4), acc);",
expectedOut = "17 5 5\n"
)
];
loop cFnParityCases as cfn {
    tsFnRun := compilerTest.compileCheckRunTs(root, tsComp, cfn.src, fixtureName);
    test.checkInt("ts-fn status " + cfn.label, 0, tsFnRun.status);
    test.checkText("ts-fn stdout " + cfn.label, cfn.expectedOut, tsFnRun.stdout);
    if ccInfo.available {
        cFnRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, cfn.src, fixtureName, "");
        test.checkInt("c-fn status " + cfn.label, 0, cFnRun.status);
        test.checkText("c-fn stdout " + cfn.label, cfn.expectedOut, cFnRun.stdout);
        test.checkText("c-fn stderr " + cfn.label, "", cFnRun.stderr);
    } else {
        cFnOnly := compilerTest.compileStdin(root, cComp, cfn.src, fixtureName);
        test.checkInt("c-fn compile " + cfn.label, 0, cFnOnly.status);
    }
}
modTmp := fs.makeTempDir("lite-c-mod-fn-");
test.check("makeTempDir c-mod-fn", modTmp.ok);
_wm1 := fs.writeText(path.join(modTmp.path, "helper.lts"), "pub factor := 3;\npub triplePlus := fn(x: Int): Int { x * factor + 1 };\n");
modMain := path.join(modTmp.path, "main.lts");
_wm2 := fs.writeText(modMain, "h := import \"./helper.lts\"; io := import \"core/io\"; io.outputLine(h.triplePlus(4), h.factor);\n");
cModCompile := compilerTest.compileFile(cComp, modTmp.path, ["--root", modTmp.path, modMain]);
test.checkInt("c-mod-fn status", 0, cModCompile.status);
test.checkText("c-mod-fn stderr", "", cModCompile.stderr);
if ccInfo.available {
    cModRun := compilerTest.compileAndRunC(cModCompile.stdout, ccInfo.cc, "");
    test.checkInt("c-mod-fn run status", 0, cModRun.status);
    test.checkText("c-mod-fn run stdout", "13 3\n", cModRun.stdout);
}
_rmMod := fs.remove(modTmp.path);

/* C backend trace safety and signature rejections */
compilerTest.assertCompileErrorContainsNamed(root, cComp, "c trace pre-init", "f := fn(): Int { late }; early := f(); late := 1;", fixtureName, "cannot call before late is initialized");

cRejCases: List<(src: String, sub: String)> = [
(src = "extTs := import \"external/ts\"; x := extTs.stripTypes(\"const a: number = 1;\");", sub = "external host builtins"),
(src = "extHttp := import \"external/http\"; x := extHttp.serveStatic(\".\", \"\", \"127.0.0.1\", 0);", sub = "external host builtins"),
(src = "extBench := import \"external/bench\"; x := extBench.measureCompilerArtifact(\"T11\", \"a\", \"b\", \"c\", \"d\");", sub = "external host builtins")
];
loop cRejCases as cr {
    cR := compilerTest.compileStdin(root, cComp, cr.src, fixtureName);
    test.checkInt("c-reject status: " + cr.src, 2, cR.status);
    test.check("c-reject msg: " + cr.src + " -> " + cR.stderr, cR.stderr.contains(cr.sub) or cR.stderr.contains("list values") or cR.stderr.contains("tuple values") or cR.stderr.contains("text builtins"));
}

/* C11 external/pool (cpuCount & runPoolJson) and symlink-preserving proc.entryPath() */
cPoolSrc := "io := import \"core/io\"; pool := import \"external/pool\"; procs := pool.cpuCount(); empty := pool.runPoolJson([], [], \"\", 2); out := pool.runPoolJson([\"sh\", \"sh\"], [\"[\\\"-c\\\",\\\"printf one\\\"]\", \"[\\\"-c\\\",\\\"printf two; printf err2 >&2; exit 3\\\"]\"], \"\", 2); io.outputLine(procs >= 1, empty, out);";
if ccInfo.available {
    cPoolRun := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, cPoolSrc, fixtureName, "");
    test.checkInt("c-ext-pool status: " + cPoolRun.stderr, 0, cPoolRun.status);
    test.checkText("c-ext-pool stderr", "", cPoolRun.stderr);
    test.check("c-ext-pool prefix", cPoolRun.stdout.startsWithAt(0, "true [] ["));
    cPoolJsonText := cPoolRun.stdout.slice("true [] ".length(), cPoolRun.stdout.length() - 1);
    test.check("c-ext-pool json valid", json.validate(cPoolJsonText).ok);
    cPoolElems := json.arrayOffsets(cPoolJsonText, 0);
    test.checkInt("c-ext-pool len", 2, cPoolElems.length());
    test.checkInt("c-ext-pool 0 status", 0, json.readFieldInt(cPoolJsonText, cPoolElems[0], "status").value);
    test.checkText("c-ext-pool 0 stdout", "one", json.readFieldString(cPoolJsonText, cPoolElems[0], "stdout").value);
    test.checkText("c-ext-pool 0 stderr", "", json.readFieldString(cPoolJsonText, cPoolElems[0], "stderr").value);
    test.checkText("c-ext-pool 0 error", "", json.readFieldString(cPoolJsonText, cPoolElems[0], "error").value);
    test.checkInt("c-ext-pool 1 status", 3, json.readFieldInt(cPoolJsonText, cPoolElems[1], "status").value);
    test.checkText("c-ext-pool 1 stdout", "two", json.readFieldString(cPoolJsonText, cPoolElems[1], "stdout").value);
    test.checkText("c-ext-pool 1 stderr", "err2", json.readFieldString(cPoolJsonText, cPoolElems[1], "stderr").value);
    test.checkText("c-ext-pool 1 error", "", json.readFieldString(cPoolJsonText, cPoolElems[1], "error").value);

    cCpuOnly := compilerTest.compileStdin(root, cComp, "io := import \"core/io\"; pool := import \"external/pool\"; io.outputLine(pool.cpuCount() >= 1);", fixtureName);
    test.checkInt("c-ext-pool cpuOnly status", 0, cCpuOnly.status);
    cCpuRun := compilerTest.compileAndRunC(cCpuOnly.stdout, ccInfo.cc, "");
    test.checkInt("c-ext-pool cpuOnly run", 0, cCpuRun.status);
    test.checkText("c-ext-pool cpuOnly stdout", "true\n", cCpuRun.stdout);

    entrySrc := "io := import \"core/io\"; p := import \"core/process\"; io.outputLine(p.entryPath()); io.outputLine(p.execPath());";
    cEntry := compilerTest.compileStdin(root, cComp, entrySrc, fixtureName);
    test.checkInt("c-entry compile status", 0, cEntry.status);
    entryTmp := fs.makeTempDir("lite-c-entry-symlink-");
    test.check("makeTempDir c-entry", entryTmp.ok);
    entryC := path.join(entryTmp.path, "entry.c");
    entryBin := path.join(entryTmp.path, "real-bin");
    entryLink := path.join(entryTmp.path, "sym-alias");
    test.check("write c-entry", fs.writeText(entryC, cEntry.stdout).ok);
    emptyEnv: List<String> = [];
    ccEntry := proc.run(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", entryC, "-o", entryBin], entryTmp.path, emptyEnv, true, "");
    test.checkInt("cc c-entry: " + ccEntry.stderr, 0, ccEntry.status);
    test.check("symlink c-entry", fs.symlink(entryBin, entryLink).ok);
    linkRun := proc.run(entryLink, [], entryTmp.path, emptyEnv, true, "");
    test.checkInt("run symlink c-entry", 0, linkRun.status);
    nlIdx := linkRun.stdout.indexOf("\n", 0);
    test.check("c-entry has newline", nlIdx > 0);
    entryOut := linkRun.stdout.slice(0, nlIdx);
    execOut := linkRun.stdout.slice(nlIdx + 1, linkRun.stdout.length()).trimEnd();
    test.checkText("c-entry preserves symlink basename", "sym-alias", path.baseName(entryOut));
    test.checkText("c-entry execPath resolves real target", "real-bin", path.baseName(execOut));

    copySrc := "fs := import \"core/file\"; io := import \"core/io\"; args := io.inputArgs(); r := fs.copy(args[0], args[1]); if not r.ok { io.errorLine(r.error); io.exit(1); }";
    cCopyComp := compilerTest.compileStdin(root, cComp, copySrc, fixtureName);
    test.checkInt("c-copy compile status", 0, cCopyComp.status);
    copyC := path.join(entryTmp.path, "copier.c");
    copyTool := path.join(entryTmp.path, "copier");
    test.check("write c-copy", fs.writeText(copyC, cCopyComp.stdout).ok);
    ccCopy := proc.run(ccInfo.cc, ["-std=c11", "-Wall", "-Wextra", "-Werror", copyC, "-o", copyTool], entryTmp.path, emptyEnv, true, "");
    test.checkInt("cc c-copy: " + ccCopy.stderr, 0, ccCopy.status);
    copiedBin := path.join(entryTmp.path, "copied-bin");
    copyRun := proc.run(copyTool, [entryBin, copiedBin], entryTmp.path, emptyEnv, true, "");
    test.checkInt("run c-copy tool: " + copyRun.stderr, 0, copyRun.status);
    copiedExec := proc.run(copiedBin, [], entryTmp.path, emptyEnv, true, "");
    test.checkInt("execute c-copied binary: " + copiedExec.error + copiedExec.stderr, 0, copiedExec.status);

    _rmEntry := fs.remove(entryTmp.path);
}

/* Reject #host declarations in user code */
hostRejectCases: List<(label: String, src: String, expectedErr: String)> = [
(label = "user top-level #host fn", src = "pub f := fn(): Int #host;\n", expectedErr = "#host declarations are only allowed"),
(label = "user #host type op", src = "Box := record { x: Int; };\npub Box.get := fn(b: Self): Int #host;\n", expectedErr = "#host declarations are only allowed"),
(label = "local #host fn literal", src = "f := fn(): Int { g := fn(): Int #host;\n0 };\n", expectedErr = "#host declarations are only allowed"),
(label = "unknown fn attribute", src = "pub f := fn(): Int #bogus;\n", expectedErr = "unknown function attribute #bogus")
];
loop hostRejectCases as hrc {
    tsRej := compilerTest.compileStdin(root, tsComp, hrc.src, fixtureName);
    test.check("ts reject " + hrc.label, tsRej.status =!= 0);
    tsMsg := tsRej.stderr + tsRej.stdout;
    test.check("ts reject msg " + hrc.label + " got: " + tsMsg, tsMsg.contains(hrc.expectedErr));
    cRej := compilerTest.compileStdin(root, cComp, hrc.src, fixtureName);
    test.check("c reject " + hrc.label, cRej.status =!= 0);
    cMsg := cRej.stderr + cRej.stdout;
    test.check("c reject msg " + hrc.label + " got: " + cMsg, cMsg.contains(hrc.expectedErr));
}

test.done("core-host-bindings");
