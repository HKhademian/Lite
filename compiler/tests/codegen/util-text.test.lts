/* Dual-target (TS + C11) tests for `type/string` (`startsWith`, `split`, `splitLines`, `replaceAll`, `padLeft`, `padRight`, `lessOrEqual`) and `List.join`. */

test := import "core/test";
compilerBuild := import "../../../tools/src/internal/compiler-build";
compilerTest := import "../../../tools/src/internal/compiler-test";
project := import "../../../tools/src/internal/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;
ccInfo := compilerTest.probeCc();

src :=
"io := import \"core/io\";\n" +
"text := import \"type/string\";\n" +
"\n" +
"io.outputLine(\"hello world\".startsWith(\"hello\"), \"hello\".startsWith(\"world\"), \"\".startsWith(\"\"));\n" +
"parts := \"a,b,,c\".split(\",\");\n" +
"io.outputLine(parts.length(), parts.join(\"|\"));\n" +
"chars := \"abc\".split(\"\");\n" +
"io.outputLine(chars.length(), chars.join(\"-\"));\n" +
"lines := \"one\\r\\ntwo\\nthree\\n\".splitLines();\n" +
"io.outputLine(lines.length(), lines.join(\"/\"));\n" +
"io.outputLine(\"foo bar foo baz foo\".replaceAll(\"foo\", \"QUX\"));\n" +
"io.outputLine(\"no match\".replaceAll(\"xyz\", \"123\"));\n" +
"io.outputLine(\"abcXYZ\".toLowerAscii(), \"abcXYZ\".toUpperAscii());\n" +
"io.outputLine(\"[\"+ \"hi\".padLeft(4) +\"]\", \"[\" + \"hi\".padRight(4) + \"]\", \"actual\".lessOrEqual(\"book\"), \"é\".lessOrEqual(\"ü\"));\n" +
"io.outputLine(text.earliestIndex(-1, -2), text.earliestIndex(-1, -1), text.earliestIndex(-1, 5), text.earliestIndex(5, -1), text.earliestIndex(3, 5), text.earliestIndex(5, 3), text.earliestIndex(0, 4));\n" +
"emptyNeedles: List<String> = [];\n" +
"io.outputLine(\"hello<world>&!\".indexOfAny([\"&\", \"<\", \">\"], 0), \"hello<world>&!\".indexOfAny([\"&\", \"<\", \">\"], 6), \"hello\".indexOfAny([\"&\", \"<\"], 0), \"hello\".indexOfAny(emptyNeedles, 0));\n";

expected :=
"true false true\n" +
"4 a|b||c\n" +
"3 a-b-c\n" +
"3 one/two/three\n" +
"QUX bar QUX baz QUX\n" +
"no match\n" +
"abcxyz ABCXYZ\n" +
"[  hi] [hi  ] true true\n" +
"-1 -1 5 5 3 3 0\n" +
"5 11 -1 -1\n";

tsRes := compilerTest.compileCheckRunTs(root, tsComp, src, "");
test.checkInt("ts status: " + tsRes.stderr, 0, tsRes.status);
test.checkText("ts stderr", "", tsRes.stderr);
test.checkText("ts stdout", expected, tsRes.stdout);

if ccInfo.available {
    cRes := compilerTest.compileCheckRunC(root, cComp, ccInfo.cc, src, "", "");
    test.checkInt("c status: " + cRes.stderr, 0, cRes.status);
    test.checkText("c stderr", "", cRes.stderr);
    test.checkText("c stdout parity", tsRes.stdout, cRes.stdout);
}

test.done("util-text");
