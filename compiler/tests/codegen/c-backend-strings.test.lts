/* Tests length-prefixed fat `lt_str` C11 string semantics: ASCII, multi-byte UTF-8, default zero-init, collections, and string-backed enums. */

io := import "core/io";
text := import "core/text";
diag := import "core/diag";

assert := fn(cond: Bool, msg: String): Unit {
    if not cond { diag.fail("", "c-backend-strings failed: " + msg); }
};

Holder := record { label: String; tag: String; count: Int; };

Color := enum : String { Red = "red", Green = "grün", Rocket = "🚀" };

/* 1. Default zero-initialized record String fields and empty strings. */
var h: Holder;
assert(h.label == "", "default record String equals empty");
assert(h.label.length() == 0, "default record String length is 0");
assert(h.label + "ok" == "ok", "concat with default empty left");
assert("ok" + h.tag == "ok", "concat with default empty right");

/* 2. ASCII fast paths: length, at, slice, indexOfText, startsWithAt, endsWith, trim, repeat, lower, join. */
ascii := "Hello, LiteScript!";
assert(ascii.length() == 18, "ascii length");
assert(ascii.at(0) == "H", "ascii at 0");
assert(ascii.at(17) == "!", "ascii at 17");
assert(ascii.slice(7, 17) == "LiteScript", "ascii slice");
assert(ascii.indexOf("Lite", 0) == 7, "ascii indexOfText multi");
assert(ascii.indexOf(",", 0) == 5, "ascii indexOfText single byte");
assert(ascii.indexOf("z", 0) == -1, "ascii indexOfText miss");
assert(ascii.startsWithAt(7, "Lite"), "ascii startsWithAt hit");
assert(not ascii.startsWithAt(8, "Lite"), "ascii startsWithAt miss");
assert(ascii.endsWith("Script!"), "ascii endsWith");
assert("  \t hi \n ".trim() == "hi", "ascii trim");
assert("ab".repeat(3) == "ababab", "ascii repeat");
assert("AbC123".toLowerAscii() == "abc123", "ascii toLower");
parts: List<String> = ["a", "bb", "ccc"];
assert(parts.join("-") == "a-bb-ccc", "ascii joinTexts");

/* 3. Multi-byte UTF-8 (2-byte accented, 3-byte em-dash, 4-byte emoji). */
utf8 := "café—🚀!";
assert(utf8.length() == 7, "utf8 cp length");
assert(utf8.at(3) == "é", "utf8 at 3");
assert(utf8.at(4) == "—", "utf8 at 4");
assert(utf8.at(5) == "🚀", "utf8 at 5");
assert(utf8.at(6) == "!", "utf8 at 6");
assert(utf8.slice(3, 6) == "é—🚀", "utf8 slice");
assert(utf8.indexOf("🚀", 0) == 5, "utf8 indexOfText emoji");
assert(utf8.indexOf("!", 4) == 6, "utf8 indexOfText after multibyte");
assert(utf8.startsWithAt(4, "—🚀"), "utf8 startsWithAt");
assert(utf8.endsWith("🚀!"), "utf8 endsWith");
assert("  café🚀 \n".trim() == "café🚀", "utf8 trim");
assert("  café🚀 \n".trim().length() == 5, "utf8 trim cp length");
assert(("a" + "🚀" + "é").length() == 3, "utf8 concat cp length");
assert("🚀".repeat(3).length() == 3, "utf8 repeat cp length");

/* 4. Unicode round-trip. */
cps := utf8.toCodePoints();
assert(cps.length() == 7, "unicode toCodePoints length");
rt := String.fromCodePoints(cps);
assert(rt.ok and rt.text == utf8 and rt.text.length() == 7, "unicode fromCodePoints roundtrip");

/* 5. Map<String, Int> and Set<String> (including long keys > 8 bytes and UTF-8 keys). */
m: mut Map<String, Int>;
longKeyA := "Record<123#456#CompilerState;items:List<Item>,locals:List<Local>,functions:List<FunctionInfo>>";
longKeyB := "Record<123#456#CompilerState;items:List<Item>,locals:List<Local>,functions:List<FunctionInfo>2>";
mut m.set(longKeyA, 10);
mut m.set(longKeyB, 20);
mut m.set("🚀", 30);
mut m.set("", 40);
assert(m.get(longKeyA).value == 10, "map long key A");
assert(m.get(longKeyB).value == 20, "map long key B");
assert(m.get("🚀").value == 30, "map utf8 key");
assert(m.get("").value == 40, "map empty key");
assert(m.get(h.label).value == 40, "map default-empty key lookup");

s: mut Set<String>;
mut s.add(longKeyA);
mut s.add("🚀");
mut s.add("");
assert(s.has(longKeyA), "set long key");
assert(not s.has(longKeyB), "set miss long key");
assert(s.has("🚀"), "set utf8 key");
assert(s.has(h.label), "set default-empty key");

/* 6. String-backed enums (constant and dynamic lookup). */
assert(Color.Red.value == "red", "const enum string value");
assert(Color.Rocket.value == "🚀", "const enum utf8 string value");
assert(Color.Rocket.value.length() == 1, "const enum utf8 cp length");
var dynColor := Color.Green;
if ascii.length() > 100 { dynColor = Color.Red; }
assert(dynColor.value == "grün", "dynamic enum utf8 string value");
assert(dynColor.value.length() == 4, "dynamic enum utf8 cp length");

io.outputLine("c-backend-strings: ok");
