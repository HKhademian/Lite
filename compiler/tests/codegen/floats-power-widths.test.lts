/* Float literals, mixed Float arithmetic, power precedence/exponents, numeric aliases/contexts, and narrow numeric widths tests migrated from compiler/tests/host.test.ts. */

list := import "core/list";
proc := import "core/process";
test := import "core/test";
text := import "core/text";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

ccProbe := compilerTest.probeCc();
heavyEnv := proc.envGet("LITE_SKIP_HEAVY");
skipHeavy := heavyEnv.found and heavyEnv.value == "1";

contractsJson := compilerTest.readProcessContracts(root);

emptyArgs := fn(): List<String> {
    res: List<String> = [];
    res
};

checkTsAndCContract := fn(label: String, source: String, logicalName: String, stdinText: String, expectedStatus: Int): Unit {
    resTs := compilerTest.compileCheckRunTsWithInput(root, tsComp, source, logicalName, stdinText, emptyArgs());
    compilerTest.assertRunMatchesNamedContract(contractsJson, label + " ts", source, logicalName, stdinText, expectedStatus, resTs);
    compiledC := compilerTest.compileStdin(root, cComp, source, logicalName);
    test.checkInt(label + " c compile: " + compiledC.stderr, 0, compiledC.status);
    if ccProbe.available {
        resC := compilerTest.compileAndRunC(compiledC.stdout, ccProbe.cc, "");
        compilerTest.assertRunMatchesNamedContract(contractsJson, label + " c", source, logicalName, stdinText, expectedStatus, resC);
    }
};

checkTsOnlyContract := fn(label: String, source: String, logicalName: String, stdinText: String, expectedStatus: Int, requireCReject: Bool): Unit {
    resTs := compilerTest.compileCheckRunTsWithInput(root, tsComp, source, logicalName, stdinText, emptyArgs());
    compilerTest.assertRunMatchesNamedContract(contractsJson, label + " ts", source, logicalName, stdinText, expectedStatus, resTs);
    if requireCReject {
        cRej := compilerTest.compileStdin(root, cComp, source, logicalName);
        test.checkInt(label + " c reject", 2, cRej.status);
        test.checkText(label + " c reject stdout", "", cRej.stdout);
    }
};

checkInvalidBoth := fn(label: String, source: String, logicalName: String, requiredLinePrefix: String): Unit {
    rec := compilerTest.assertContractStatus(contractsJson, label, source, "", "", 1);
    test.checkText(label + " contract stdout empty", "", rec.stdout);
    cTs := compilerTest.compileStdin(root, tsComp, source, logicalName);
    test.checkInt(label + " ts reject", 2, cTs.status);
    test.checkText(label + " ts reject stdout", "", cTs.stdout);
    cC := compilerTest.compileStdin(root, cComp, source, logicalName);
    test.checkInt(label + " c reject", 2, cC.status);
    test.checkText(label + " c reject stdout", "", cC.stdout);
    if requiredLinePrefix =!= "" {
        test.check(label + " ts prefix: " + cTs.stderr, text.startsWithAt(cTs.stderr, 0, requiredLinePrefix));
        test.check(label + " c prefix: " + cC.stderr, text.startsWithAt(cC.stderr, 0, requiredLinePrefix));
    }
};

/* narrow numeric widths support bounds, promotions, widening, Float32 rounding, and panics across TS and C */
parityLines: List<String> = [
    "io := import \"core/io\";",
    "aMin: Int8 = -128;",
    "aMax: Int8 = 127;",
    "bMin: Int16 = -32768;",
    "bMax: Int16 = 32767;",
    "cMin: Int32 = -2147483648;",
    "cMax: Int32 = 2147483647;",
    "fRound: Float32 = 0.1;",
    "fExact: Float32 = 16777216;",
    "var z8: Int8;",
    "var zf: Float32;",
    "w16: Int16 = aMax;",
    "w32: Int32 = bMax;",
    "w64: Int = cMax;",
    "wf32a: Float32 = aMin;",
    "wf32b: Float32 = bMax;",
    "wf64: Float = cMin;",
    "wff: Float = fRound;",
    "bTen: Int16 = 10;",
    "cTen: Int32 = 10;",
    "p16 := aMax + bTen;",
    "p32 := bMax + cTen;",
    "pMix := aMax + fRound;",
    "pMix32 := cMax + wf32b;",
    "pPow := aMax ** 2;",
    "var acc: Int8 = 10;",
    "d8: Int8 = 120;",
    "acc += aMax - d8;",
    "acc -= 3;",
    "acc *= 2;",
    "acc /= 3;",
    "acc %= 5;",
    "acc :/= 2;",
    "acc :%= 3;",
    "var facc: Float32 = 1.5;",
    "facc += 2.5;",
    "facc *= 0.5;",
    "exactCheck := (16777217 == fExact);",
    "cmpWide := aMin < bMax and wf32b <= wff + 40000.0 and cMax > 0;",
    "io.outputLine(aMin, aMax, bMin, bMax, cMin, cMax);",
    "io.outputLine(fRound, z8, zf, w16, w32, w64, wf32a, wf32b, wf64);",
    "io.outputLine(p16, p32, pMix, pMix32, pPow, acc, facc, exactCheck, cmpWide);"
];
paritySource := text.joinTexts(parityLines, "\n");
parityExpectedOut := "-128 127 -32768 32767 -2147483648 2147483647\n0.10000000149011612 0 0 127 32767 2147483647 -128 32767 -2147483648\n137 32777 127.0999984741211 2147516416 16129 2 2 false true\n";
compilerTest.assertCompileRunTs(root, tsComp, "narrow-parity-ts", paritySource, parityExpectedOut);
cParityCompiled := compilerTest.compileStdin(root, cComp, paritySource, "");
test.checkInt("narrow-parity-c compile", 0, cParityCompiled.status);
if ccProbe.available {
    cParityRun := compilerTest.compileAndRunC(cParityCompiled.stdout, ccProbe.cc, "");
    test.checkInt("narrow-parity-c status", 0, cParityRun.status);
    test.checkText("narrow-parity-c stdout", parityExpectedOut, cParityRun.stdout);
}

narrowPanics: List<(body: String, msg: String)> = [
    (body = "var a: Int8 = 127; a += 1; io.outputLine(a);", msg = "ArithmeticPanic: integer outside Int8 range"),
    (body = "var a: Int8 = -128; io.outputLine(-a);", msg = "ArithmeticPanic: integer outside Int8 range"),
    (body = "a: Int8 = 127; b: Int16 = 32767; io.outputLine(a + b);", msg = "ArithmeticPanic: integer outside Int16 range"),
    (body = "a: Int16 = 32767; b: Int16 = 1; io.outputLine(a + b);", msg = "ArithmeticPanic: integer outside Int16 range"),
    (body = "a: Int32 = 2147483647; b: Int32 = 1; io.outputLine(a + b);", msg = "ArithmeticPanic: integer outside Int32 range"),
    (body = "a: Float32 = 3.4e38; b: Float32 = 2.0; io.outputLine(a * b);", msg = "ArithmeticPanic: non-finite floating value"),
    (body = "a: Float32 = 1.0; b: Float32 = 0.0; io.outputLine(a / b);", msg = "ArithmeticPanic: division by zero")
];
loop narrowPanics as pc {
    pSrc := "io := import \"core/io\";\nio.outputLine(\"before\");\n" + pc.body + "\n";
    tsRun := compilerTest.compileCheckRunTs(root, tsComp, pSrc, "");
    test.checkInt("narrow-panic ts status: " + pc.body, 1, tsRun.status);
    test.checkText("narrow-panic ts stdout: " + pc.body, "before\n", tsRun.stdout);
    test.check("narrow-panic ts stderr (" + pc.body + "): " + tsRun.stderr, text.containsText(tsRun.stderr, pc.msg));
    cCompP := compilerTest.compileStdin(root, cComp, pSrc, "");
    test.checkInt("narrow-panic c compile: " + pc.body, 0, cCompP.status);
    if ccProbe.available {
        cRun := compilerTest.compileAndRunC(cCompP.stdout, ccProbe.cc, "");
        test.checkInt("narrow-panic c status: " + pc.body, 1, cRun.status);
        test.checkText("narrow-panic c stdout: " + pc.body, "before\n", cRun.stdout);
        test.check("narrow-panic c stderr (" + pc.body + "): " + cRun.stderr, text.containsText(cRun.stderr, pc.msg));
    }
}

narrowTsOnly := "io := import \"core/io\";\nByte := type Int8;\nHalf := type Float32;\nwiden := fn(x: Int16): Int32 { one: Int16 = 1; x + one }\ntoHalf := fn(x: Byte): Half { x }\na8: Byte = 5;\nb16: Int16 = 300;\nf32: Half = 0.25;\nifJoined := if true { a8 } else { b16 };\nmatchJoined := match { false { a8 } _ { f32 } };\nbytes: List<Int8> = [1, -128, 127];\nblankPair: (a: Int8, b: Float32);\nio.outputLine(widen(a8), toHalf(a8), ifJoined, matchJoined, bytes, blankPair);\n";
compilerTest.assertCompileRunTs(root, tsComp, "narrow-ts-only", narrowTsOnly, "6 5 5 0.25 [1, -128, 127] (a=0, b=0)\n");

narrowRejects: List<(bad: String, m1: String, m2: String, checkC: Bool)> = [
    (bad = "x: Int8 = 128;", m1 = "integer literal outside Int8 range", m2 = "cannot initialize Int8", checkC = true),
    (bad = "x: Int8 = -129;", m1 = "integer literal outside Int8 range", m2 = "cannot initialize Int8", checkC = true),
    (bad = "x: Int16 = 32768;", m1 = "integer literal outside Int16 range", m2 = "cannot initialize Int16", checkC = true),
    (bad = "x: Int32 = 2147483648;", m1 = "integer literal outside Int32 range", m2 = "cannot initialize Int32", checkC = true),
    (bad = "f: Float32 = 1e39;", m1 = "outside Float32 range", m2 = "cannot initialize Float32", checkC = true),
    (bad = "f: Float32 = 16777217;", m1 = "integer literal is not exactly representable in Float32", m2 = "integer literal is not exactly representable in Float32", checkC = true),
    (bad = "x: Int8 = +1;", m1 = "cannot initialize Int8 with Int", m2 = "cannot initialize Int8 with Int", checkC = true),
    (bad = "x: Int8 = -(1);", m1 = "cannot initialize Int8 with Int", m2 = "cannot initialize Int8 with Int", checkC = true),
    (bad = "x: Int8 = 1 + 2;", m1 = "cannot initialize Int8 with Int", m2 = "cannot initialize Int8 with Int", checkC = true),
    (bad = "var acc: Int8 = 10; a8: Int8 = 127; acc += a8 - 120;", m1 = "cannot apply += to Int8 and Int", m2 = "cannot apply += to Int8 and Int", checkC = true),
    (bad = "a: Int16 = 1; b: Int8 = a;", m1 = "cannot initialize Int8 with Int16", m2 = "cannot initialize Int8 with Int16", checkC = true),
    (bad = "c: Int32 = 1; f: Float32 = c;", m1 = "cannot initialize Float32 with Int32", m2 = "cannot initialize Float32 with Int32", checkC = true),
    (bad = "g: Float = 1.0; h: Float32 = g;", m1 = "cannot initialize Float32 with Float", m2 = "cannot initialize Float32 with Float", checkC = true),
    (bad = "a32: Int32 = 1; f32: Float32 = 2.0; x := if true { a32 } else { f32 };", m1 = "value if branches must have the same kind", m2 = "value if branches must have the same kind", checkC = false),
    (bad = "xs: List<Int8> = [1]; ys: List<Int16> = xs;", m1 = "cannot initialize List<Int16> with List<Int8>", m2 = "cannot initialize List<Int16> with List<Int8>", checkC = false),
    (bad = "a8: Int8 = 1; b16: Int16 = 2; arr := [a8, b16];", m1 = "list element 2 must be Int8, got Int16", m2 = "list element 2 must be Int8, got Int16", checkC = false),
    (bad = "xs := [10, 20]; i: Int8 = 0; y := xs[i];", m1 = "array index must be Int", m2 = "index must be Int", checkC = false)
];
loop narrowRejects as nr {
    rTs := compilerTest.compileStdin(root, tsComp, nr.bad, "");
    test.checkInt("narrow-reject ts status: " + nr.bad, 2, rTs.status);
    test.check("narrow-reject ts msg: " + nr.bad + " -> " + rTs.stderr, text.containsText(rTs.stderr, nr.m1) or text.containsText(rTs.stderr, nr.m2));
    if nr.checkC {
        rC := compilerTest.compileStdin(root, cComp, nr.bad, "");
        test.checkInt("narrow-reject c status: " + nr.bad, 2, rC.status);
        test.check("narrow-reject c msg: " + nr.bad + " -> " + rC.stderr, text.containsText(rC.stderr, nr.m1) or text.containsText(rC.stderr, nr.m2));
    }
}

if not skipHeavy {
    /* finite Float literals retain binary64 values, display and same-family comparisons on TS and C */
    midMinus1 := "";
    midExact := "";
    floatLiterals: List<String> = [
        "0.0", "-0.0", "1.5", "+1.5", "0001.2500", "1e2", "2.5E-2", "1E+21",
        "0.000001", "0.0000001", "1000000000000000100.0", "1.7976931348623158e308",
        "5e-324", "2e-324", "1e-99999", "0e" + text.repeatText("9", 120),
        "0." + text.repeatText("0", 400) + "1e401", "999999999999999999999999999999.0",
        "- /* comment */ 1.5",
        midMinus1 + ".0"
    ];
    floatBoth: List<String> = [
        "io := import \"core/io\"; io.outputLine(" + text.joinTexts(floatLiterals, ", ") + ");",
        "io := import \"core/io\"; var n: Float = 0.1; saved := n; n = 0.2; n = -n; io.outputLine(saved, n, +n, -(-n));",
        "io := import \"core/io\"; zero: Float; io.outputLine(zero, zero == 0.0, -zero, +zero);",
        "io := import \"core/io\"; a := 1.5; b := 2.5; io.outputLine(a == b, a =!= b, a < b, a <! b, a <= b, a <!= b, a > b, a >! b, a >= b, a >!= b);",
        "io := import \"core/io\"; a := 1.5; b := 2.5; c := 3.5; io.outputLine(a < b < c, c > b > a, a > b < c);",
        "io := import \"core/io\"; var n := 1.5; { n := -n; io.outputLine(n); } io.outputLine(n);",
        "io := import \"core/io\"; var flag := true; var n := 1.5; loop flag { io.outputLine(n); n = 2.5; flag = false; } io.outputLine(n);",
        "io := import \"core/io\"; 1.5; -0.0; 1e-9999; io.outputLine(\"after\");",
        "io := import \"core/io\"; io.output(\"before\", 0.1); io.outputLine(1e21, -5e-324, 0.000001);",
        "io := import \"core/io\"; f := fn(n: Float): Float { n } io.outputLine(f(0.1), f(-0.0));",
        "io := import \"core/io\"; f := fn(n: Float): Float { if n < 0.0 { return -n; } n } io.outputLine(f(-1.5));",
        "io := import \"core/io\"; echo := fn(n: Float): Float { io.outputLine(\"call\", n); n } io.outputLine(echo(1.5) < echo(2.5) < echo(3.5), echo(3.5) < echo(2.5) < echo(1.5));",
        "io := import \"core/io\"; f := fn(flag: Bool): Float { if flag { 0.1 } else { 2.5 } } io.outputLine(f(true), f(false));"
    ];
    floatTsOnly: List<String> = [
        "io := import \"core/io\"; p := (n = 0.1, label = \"value\"); values: List<Float> = [0.1, 1e21]; io.outputLine(p, values);"
    ];
    loop floatBoth as src { checkTsAndCContract("float-both", src, "", "", 0); }
    loop floatTsOnly as src { checkTsOnlyContract("float-ts", src, "", "", 0, true); }

    vecTokens: List<String> = [
        "0.0", "-0.0", "5e-324", "1.7976931348623157e+308", "0.1", "0.2", "0.3", "0.000001", "1e-7", "100000000000000000000.0", "1e+21", "1e+23", "5e-324", "-5e-324", "0.0", "1e-323",
        "2.2250738585072014e-308", "-2.2250738585072014e-308", "2.225073858507201e-308", "2.225073858507202e-308", "7.888609052210118e-31", "-7.888609052210118e-31", "7.888609052210117e-31", "7.88860905221012e-31",
        "1.1102230246251565e-16", "-1.1102230246251565e-16", "1.1102230246251564e-16", "1.1102230246251568e-16", "0.5", "-0.5", "0.49999999999999994", "0.5000000000000001",
        "1.0", "-1.0", "0.9999999999999999", "1.0000000000000002", "2.0", "-2.0", "1.9999999999999998", "2.0000000000000004",
        "1024.0", "-1024.0", "1023.9999999999999", "1024.0000000000002", "9007199254740992.0", "-9007199254740992.0", "9007199254740991.0", "9007199254740994.0",
        "1.2676506002282294e+30", "-1.2676506002282294e+30", "1.2676506002282293e+30", "1.2676506002282297e+30", "8.98846567431158e+307", "-8.98846567431158e+307", "8.988465674311579e+307", "8.988465674311582e+307",
        "1.838639451725799e-92", "-9.084938291167941e+48", "-1.7257423766123035e-279", "-2.6778909169587644e+164", "-2.832911260854019e+29", "3.404283677272497e-288", "-5.393859848927963e+266", "-2.611040628554583e+117",
        "1.549197886606312e-250", "2.3560094091984846e-241", "-4.8976830634895363e+173", "-4.727729718970044e-37", "7.84046789284113e+260", "5.074274142550697e-35", "3.8474773167913083e+304", "4.85473395791945e-16",
