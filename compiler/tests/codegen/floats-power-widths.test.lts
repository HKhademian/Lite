        "-1.0716302021238523e+254", "5.346439456191239e-266", "1.559931028996521e-24", "-1.8643461097454687e+168", "1.8439537146811364e-75", "4.921000369700283e+243", "1549724612.0261784", "1.7704948590126477e-200",
        "3.956691583269147e+48", "-2.9782516767525787e+85", "3.0323454425303517e-117", "-5.6319125614739974e-288", "-9.07636238066995e+116", "8.158701629498534e+234", "-1.5948352242454308e+245", "-5.822289006201805e+182",
        "3.099711264854821e-53", "1.4996955474190841e-9", "-1.4593674821141787e-265", "-6.976508162653506e+54", "1.0014082596188545e-122", "-4.5987292632378835e+255", "-1.6929154319427528e-161", "-5.787953857773648e-24",
        "-4.2883271663986633e+145", "-5.0896043503957816e+182", "1.0537636375342792e+167", "2.481594789877794e-234", "-2.4602082970748975e+131", "-1.105037379945838e+107", "-1.5154544023817104e-169", "-1.0661254327367788e-177",
        "-4.819584543557167e+208", "2.6162085458440182e-76", "-1.0546658370735707e+270", "1.032915525113405e+290", "1.8301206756457788e+83", "3.056728009969806e+250", "1.998703848380332e+145", "-4.1651342815338613e-256"
    ];
    vecProgLines: mut List<String> = ["io := import \"core/io\";"];
    vecOutLines: mut List<String> = [];
    loop vecTokens as tok {
        list.pushBack(mut vecProgLines, "io.outputLine(" + tok + ");");
        outTok := if tok == "-0.0" or tok == "0.0" { "0" }
            else if text.endsWith(tok, ".0") and not text.containsText(tok, "e") and not text.containsText(tok, "E") { text.slice(tok, 0, text.length(tok) - 2) }
            else { tok };
        list.pushBack(mut vecOutLines, outTok);
    }
    vecProgram := text.joinTexts(vecProgLines, "\n");
    vecRec := compilerTest.assertContractStatus(contractsJson, "binary64-vectors", vecProgram, "", "", 0);
    test.checkText("binary64-vectors contract stdout", text.joinTexts(vecOutLines, "\n") + "\n", vecRec.stdout);
    checkTsAndCContract("binary64-vectors", vecProgram, "", "", 0);

    floatInvalid: List<String> = [
        "io.outputLine(.5);",
        "io.outputLine(1.);",
        "io.outputLine(1e);",
        "io.outputLine(1e+);",
        "io.outputLine(1e-);",
        "io.outputLine(1.2e);",
        "io.outputLine(1ee2);",
        "io.outputLine(1.2.3);",
        "io.outputLine(1e2.5);",
        "io.outputLine(1e+ 2);",
        "io.outputLine(1e309);",
        "io.outputLine(-1e309);",
        "io.outputLine(" + midExact + ".0);",
        "if false { io.outputLine(1e99999); }",
        "var x: Float = \"wrong\";",
        "io.outputLine(1.5 == \"wrong\");"
    ];
    loop floatInvalid as srcTail {
        badSrc := "io := import \"core/io\"; io.outputLine(\"before\");\r\n" + srcTail;
        checkInvalidBoth("float-bad", badSrc, "float سلام.lts", "float سلام.lts:2:");
    }
    floatFaults: List<String> = [
        "io := import \"core/io\"; io.outputLine(\"before\"); var zero := 0; io.outputLine(0.1, 1 / zero);",
        "io := import \"core/io\"; io.outputLine(\"before\"); io.outputLine(0.1, 9223372036854775807 + 1);"
    ];
    loop floatFaults as src { checkTsAndCContract("float-fault", src, "float سلام.lts", "", 1); }
    checkTsOnlyContract("float-stdin", "io := import \"core/io\"; io.outputLine(0.1 < io.inputFloat(\"middle? \") < io.inputFloat(\"last? \"));", "", "0.0 bad", 0, false);

    /* mixed Float arithmetic and comparisons preserve values, effects and positioned faults on generated targets */
    mixedBoth: List<String> = [
        "io := import \"core/io\"; io.outputLine(1.5 + 2.5, 1.5 - 2.5, 1.5 * 2.5, 1.5 / 2.5);",
        "io := import \"core/io\"; io.outputLine(2 + 0.5, 0.5 + 2, 2 - 0.5, 0.5 - 2, 2 * 0.5, 0.5 * 2, 2 / 0.5, 0.5 / 2);",
        "io := import \"core/io\"; var x := 2; var y := 0.25; io.outputLine(x + y * 2, (x + y) * 2, -(x / y), +y);",
        "io := import \"core/io\"; io.outputLine(-0.0 * 2, 1e-300 * 1e-30, 5e-324 / 2, 5e-324 * 2, 1e308 / 1e308);",
        "io := import \"core/io\"; io.outputLine(9223372036854775807 + 0.0, -9223372036854775808 / 1.0);",
        "io := import \"core/io\"; io.outputLine(2 < 2.5, 2.5 > 2, 2 == 2.0, 2.0 =!= 3, 2 <! 2.0, 2.0 >! 2, 2 <!= 1.0, 1.0 >!= 2);",
        "io := import \"core/io\"; io.outputLine(9007199254740992.0 == 9007199254740993 > 9007199254740992, 9007199254740992 < 9007199254740993 == 9007199254740992.0);",
        "io := import \"core/io\"; io.outputLine(3.5 < 2 < (1.0 / 0.0), 1 < 2.5 < 3, 3 > 2.5 > 1);",
        "io := import \"core/io\"; var x := 0.0; var n := 0; loop n < 3 { x = x + 0.5; n = n + 1; } io.outputLine(x);",
        "io := import \"core/io\"; if false { io.outputLine(1.0 / 0); } loop false { io.outputLine(1e308 * 2); } io.outputLine(false and (1.0 / 0 > 1), true or (1e308 * 2 > 1));",
        "io := import \"core/io\"; io.outputLine(1.0 < 2.0, 2.0 == 2.0, 3.0 > 2.0);",
        "io := import \"core/io\"; echo := fn(n: Float): Float { io.outputLine(\"call\", n); n } io.outputLine(echo(1.5) + echo(2.5) * echo(3.5));",
        "io := import \"core/io\"; i := fn(): Int { io.outputLine(\"int\"); 2 } f := fn(): Float { io.outputLine(\"float\"); 0.5 } io.outputLine(i() / f(), f() - i());",
        "io := import \"core/io\"; echo := fn(n: Float): Float { io.outputLine(\"call\", n); n } io.outputLine(1 < echo(2.5) < 3, echo(3.5) < 2 < echo(1.5));"
    ];
    mixedTsOnly: List<String> = [
        "io := import \"core/io\"; f := fn(n: Int, x: Float): Float { n * x + 0.25 } p := (value = f(2, 0.5)); values: List<Float> = [p.value, f(3, 0.5)]; io.outputLine(p, values);"
    ];
    loop mixedBoth as src { checkTsAndCContract("mixed-both", src, "", "", 0); }
    loop mixedTsOnly as src { checkTsOnlyContract("mixed-ts", src, "", "", 0, true); }

    mixedFaultTails: List<String> = [
        "io.outputLine(1.0 / 0);",
        "io.outputLine(1 / -0.0);",
        "io.outputLine(0.0 / 0.0);",
        "io.outputLine(1e308 + 1e308);",
        "io.outputLine(-1e308 - 1e308);",
        "io.outputLine(1e308 * 2);",
        "io.outputLine(1e308 / 1e-308);",
        "io.outputLine((1.0 / 0) + (1e308 * 2));",
        "io.outputLine((1e308 * 2) < (1.0 / 0));",
        "io.outputLine(1.0, 1.0 / 0);",
        "var zero := 0.0; io.outputLine(1 / zero);"
    ];
    loop mixedFaultTails as tail {
        fSrc := "io := import \"core/io\"; io.outputLine(\"before\");\r\n" + tail;
        fRec := compilerTest.assertContractStatus(contractsJson, "mixed-fault", fSrc, "mixed-float سلام.lts", "", 1);
        test.checkText("mixed-fault stdout", "before\n", fRec.stdout);
        test.check("mixed-fault msg", text.containsText(fRec.stderr, "ArithmeticPanic: division by zero") or text.containsText(fRec.stderr, "ArithmeticPanic: non-finite floating value"));
        checkTsAndCContract("mixed-fault", fSrc, "mixed-float سلام.lts", "", 1);
    }
    mixedInvalidTails: List<String> = [
        "io.outputLine(1.5 % 2);",
        "io.outputLine(1 :/ 2.5);",
        "io.outputLine(1.5 :% 2.5);",
        "io.outputLine(1.5 + \"x\");",
        "io.outputLine(true * 1.5);",
        "io.outputLine(Unit / 1.5);",
        "io.outputLine(1.5 < \"x\");",
        "io.outputLine(1 < 2.5 < true);",
        "var x: Int = 1.5 + 2;"
    ];
    loop mixedInvalidTails as tail {
        checkInvalidBoth("mixed-bad", "io := import \"core/io\"; io.outputLine(\"before\"); " + tail, "", "");
    }
    checkTsOnlyContract("mixed-stdin", "io := import \"core/io\"; io.outputLine(io.inputInt(\"int? \") / io.inputFloat(\"float? \"));", "", "3 2.0", 0, false);

    /* power preserves right association and explicit negative-base grouping */
    powBoth: List<String> = [
        "io := import \"core/io\"; io.outputLine(2 ** 3, 2 ** 3 ** 2, (2 ** 3) ** 2, 2 ** (3 ** 2));",
        "io := import \"core/io\"; io.outputLine(4 ** 0.5, 2.5 ** 2, 2 ** 3.0, 1.5 ** 2.0);",
        "io := import \"core/io\"; io.outputLine(1.1 ** 3, 10 ** 0.1, 27 ** (1.0 / 3.0), 0.1 ** 0.2);",
        "io := import \"core/io\"; io.outputLine((-2) ** 2, (-2) ** 3, -(2 ** 2), +(-2) ** 2, (- /* c */ 2) ** 3);",
        "io := import \"core/io\"; io.outputLine(2 ** 3 * 2, 2 * 3 ** 2, 2 ** (3 * 2), 1 + 2 ** 3 * 2, (1 + 2) ** 2);",
        "io := import \"core/io\"; var base := 2; var exponent := 3; var value: Float = base ** exponent; io.outputLine(value, value + 0.5, value == 8);",
        "io := import \"core/io\"; io.outputLine(0 ** 2, (-0.0) ** 3, 1e-200 ** 2, 9223372036854775807 ** 1);",
        "io := import \"core/io\"; if false { io.outputLine(2 ** 0); } loop false { io.outputLine(2 ** -1); } io.outputLine(false and (2 ** 0 > 1), true or (1e308 ** 2 > 1), 3 < 2 < 2 ** 0);",
        "io := import \"core/io\"; var n := 1; loop n <= 3 { io.outputLine(2 ** n); n = n + 1; }",
        "io := import \"core/io\"; echo := fn(n: Int): Int { io.outputLine(\"call\", n); n } io.outputLine(echo(2) ** echo(3) ** echo(2));",
        "io := import \"core/io\"; unused := fn(): Float { 2 ** 0 } f := fn(flag: Bool): Float { if flag { return 2 ** 3; } 3 ** 2 } io.outputLine(f(true), f(false));"
    ];
    powTsOnly: List<String> = [
        "io := import \"core/io\"; f := fn(base: Float, exponent: Int): Float { base ** exponent } p := (n = f(2.5, 2)); xs: List<Float> = [p.n, f(1.5, 2)]; io.outputLine(p, xs);"
    ];
    loop powBoth as src { checkTsAndCContract("pow-both", src, "", "", 0); }
    loop powTsOnly as src { checkTsOnlyContract("pow-ts", src, "", "", 0, true); }
    powFaultTails: List<String> = ["io.outputLine(1e308 ** 2);", "io.outputLine((-2) ** 0.5);"];
    loop powFaultTails as tail {
        checkTsAndCContract("pow-fault", "io := import \"core/io\"; io.outputLine(\"before\");\r\n" + tail, "power سلام.lts", "", 1);
    }
    powInvalidTails: List<String> = [
        "io.outputLine(-2 ** 2);",
        "io.outputLine(- /* c */ 2 ** 3);",
        "base := 2; io.outputLine(-base ** 2);",
        "io.outputLine((-2 ** 2));",
        "io.outputLine(-(2) ** 2);",
        "io.outputLine(2 ** -1 ** 2);",
        "io.outputLine(\"x\" ** 2);",
        "io.outputLine(2 ** false);",
        "io.outputLine(Unit ** 2);",
        "var x: Int = 2 ** 3;",
        "io.outputLine(2 *** 3);",
        "io.outputLine(2 **);",
        "io.outputLine(** 2);",
        "var x := 2; x **= 2;",
        "io.outputLine(2 ^ 3);"
    ];
    loop powInvalidTails as tail {
        checkInvalidBoth("pow-bad", "io := import \"core/io\"; io.outputLine(\"before\"); " + tail, "", "");
    }
    powPlusMinus: List<String> = ["+-2 ** 2", "+ - /* c */ 2 ** 3", "+-+2 ** 2"];
    loop powPlusMinus as expr {
        pmSrc := "io := import \"core/io\"; io.outputLine(\"before\"); io.outputLine(" + expr + ");";
        compilerTest.assertCompileErrorContains(root, tsComp, "pow-pm-ts", pmSrc, "group a negative power base");
        compilerTest.assertCompileErrorContains(root, cComp, "pow-pm-c", pmSrc, "group a negative power base");
    }
    checkTsOnlyContract("pow-stdin", "io := import \"core/io\"; io.outputLine(io.inputInt(\"base? \") ** io.inputFloat(\"exponent? \"));", "", "4 0.5", 0, false);

    /* power accepts zero and negative exponents and panics on zero to a negative power */
    powNegOk := "io := import \"core/io\"; var e := -1; io.outputLine(2 ** 0, 0 ** 0, 2 ** -0.0, 2 ** -3, (-2) ** -3, (-2) ** -4, 4 ** e, 2 ** (2 ** 0)); if false { io.outputLine(0 ** -1); }";
    compilerTest.assertCompileRunTsNamed(root, tsComp, "pow-neg-ok ts", powNegOk, "power-case.lts", "1 1 1 0.125 -0.125 0.0625 0.25 2\n");
    cPowNegOk := compilerTest.compileStdin(root, cComp, powNegOk, "power-case.lts");
    test.checkInt("pow-neg-ok c compile", 0, cPowNegOk.status);
    if ccProbe.available {
        rCPowOk := compilerTest.compileAndRunC(cPowNegOk.stdout, ccProbe.cc, "");
        test.checkInt("pow-neg-ok c status", 0, rCPowOk.status);
        test.checkText("pow-neg-ok c stdout", "1 1 1 0.125 -0.125 0.0625 0.25 2\n", rCPowOk.stdout);
    }
    powNegFaults: List<String> = [
        "io.outputLine(0 ** -1, \"after\");",
        "var base := 0; var exponent := -2; io.outputLine(base ** exponent);"
    ];
    loop powNegFaults as tail {
        pfSrc := "io := import \"core/io\"; io.outputLine(\"before\");\n" + tail;
        rTs := compilerTest.compileCheckRunTs(root, tsComp, pfSrc, "power-case.lts");
        test.checkInt("pow-neg-fault ts status", 1, rTs.status);
        test.checkText("pow-neg-fault ts stdout", "before\n", rTs.stdout);
        test.check("pow-neg-fault ts msg", text.startsWithAt(rTs.stderr, 0, "power-case.lts:2:") and text.containsText(rTs.stderr, "ArithmeticPanic: zero cannot be raised to a negative power\n"));
        cPf := compilerTest.compileStdin(root, cComp, pfSrc, "power-case.lts");
        test.checkInt("pow-neg-fault c compile", 0, cPf.status);
        if ccProbe.available {
            rC := compilerTest.compileAndRunC(cPf.stdout, ccProbe.cc, "");
            test.checkInt("pow-neg-fault c status", 1, rC.status);
            test.checkText("pow-neg-fault c stdout", "before\n", rC.stdout);
            test.check("pow-neg-fault c msg", text.startsWithAt(rC.stderr, 0, "power-case.lts:2:") and text.containsText(rC.stderr, "ArithmeticPanic: zero cannot be raised to a negative power\n"));
        }
    }
    powEffSrc := "io := import \"core/io\"; f := fn(n: Int): Int { io.outputLine(n); n } io.outputLine(f(0) ** f(-1), f(9));";
    rPowEff := compilerTest.compileCheckRunTs(root, tsComp, powEffSrc, "power-effects.lts");
    test.checkInt("pow-effects status", 1, rPowEff.status);
    test.checkText("pow-effects stdout", "0\n-1\n", rPowEff.stdout);
    test.check("pow-effects msg", text.endsWith(rPowEff.stderr, "ArithmeticPanic: zero cannot be raised to a negative power\n"));
    powFnSrc := "io := import \"core/io\"; power := fn(base: Float, exponent: Int): Float { base ** exponent } value: Float = power(2, -3); io.outputLine(value, power(9, 0), power(4, -1));";
    compilerTest.assertCompileRunTs(root, tsComp, "pow-fn", powFnSrc, "0.125 1 0.25\n");

    /* Int64, Float64 and Double normalize across admitted numeric annotations and contracts */
    aliasBoth: List<String> = [
        "io := import \"core/io\"; i: Int64 = 5; f: Float64 = 2.5; d: Double = 3.5; io.outputLine(i, f, d);",
        "io := import \"core/io\"; i: Int64; f: Float64; d: Double; io.outputLine(i, f, d);",
        "io := import \"core/io\"; var i: Int64 = 2; var f: Double = 0.5; i = i + 1; f = i * f; io.outputLine(i, f);",
        "io := import \"core/io\"; Count := type Int64; SavedCount := type Count; Amount := type Double; a: SavedCount = 7; b: Amount = 0.25; io.outputLine(a, b, a + b);",
        "io := import \"core/io\"; var i: Int64 = 7; { i: Int64 = -i; io.outputLine(i); } io.outputLine(i);",
        "io := import \"core/io\"; low: Int64 = -9223372036854775808; high: Int64 = 9223372036854775807; io.outputLine(low, high);",
        "io := import \"core/io\"; var total: Float64 = 0.0; var n: Int64 = 0; loop n < 3 { total = total + 0.5; n = n + 1; } io.outputLine(total);",
        "io := import \"core/io\"; x: Double = 2 ** 3; io.outputLine(x, x == 8, x / 2);",
        "io := import \"core/io\"; f := fn(n: Int64, x: Float64): Double { n * x } io.outputLine(f(3, 0.5));",
        "io := import \"core/io\"; Count := type Int64; Amount := type Float64; f := fn(n: Count, x: Amount): Double { if n > 0 { return x; } -x } io.outputLine(f(2, 0.5), f(0, 0.5));"
    ];
    aliasTsOnly: List<String> = [
        "io := import \"core/io\"; p: (i: Int64, f: Double) = (i = 2, f = 0.5); io.outputLine(p, p.i, p.f);",
        "io := import \"core/io\"; Pair := type (i: Int64, f: Float64); f := fn(p: Pair): Double { p.i * p.f } p: Pair = (i = 3, f = 0.5); io.outputLine(f(p));",
        "list := import \"core/list\"; io := import \"core/io\"; xs: mut List<Int64> = [1, 2]; ys: List<Float64> = [0.5, 1.5]; list.pushBack(mut xs, 3); io.outputLine(xs, ys, xs[1]);"
    ];
    loop aliasBoth as src { checkTsAndCContract("alias-both", src, "", "", 0); }
    loop aliasTsOnly as src { checkTsOnlyContract("alias-ts", src, "", "", 0, true); }
    aliasInvalid: List<String> = [
        "var x: Int64 = \"x\";",
        "var x: Float64 = false;",
        "var x: Double = Unit;",
        "var x: Int64 = 0.5;",
        "var x: Int64 = 2 ** 3;",
        "var x: Double = 0.5; x = true;",
        "f := fn(n: Int64): Int64 { n } io.outputLine(f(0.5));",
        "f := fn(n: Double): Double { n } i: Int64 = 2; io.outputLine(f(i));",
        "var x: Int64 = 9223372036854775808;",
        "var x: Float64 = 1e309;",
        "x: List<Int64> = [0.5];",
        "x: (n: Int64) = (n = 0.5);"
    ];
    loop aliasInvalid as tail {
        checkInvalidBoth("alias-bad", "io := import \"core/io\"; io.outputLine(\"before\"); " + tail, "", "");
    }
    aliasFaults: List<String> = [
        "var x: Int64 = 9223372036854775807; io.outputLine(x + 1);",
        "var x: Double = 1e308; io.outputLine(x * 2);"
    ];
    loop aliasFaults as tail {
        checkTsAndCContract("alias-fault", "io := import \"core/io\"; io.outputLine(\"before\");\r\n" + tail, "numeric-alias سلام.lts", "", 1);
    }
    synAlias := "io := import \"core/io\"; i: Int64 = 2; f: Float64 = 0.5; d: Double = 1.5; io.outputLine(i, f, d);";
    synCanon := "io := import \"core/io\"; i: Int = 2; f: Float = 0.5; d: Float = 1.5; io.outputLine(i, f, d);";
    aTs := compilerTest.compileStdin(root, tsComp, synAlias, "");
    cTs2 := compilerTest.compileStdin(root, tsComp, synCanon, "");
    test.checkInt("alias-eq ts a", 0, aTs.status);
    test.checkText("alias-eq ts output", cTs2.stdout, aTs.stdout);
    aC := compilerTest.compileStdin(root, cComp, synAlias, "");
    cC2 := compilerTest.compileStdin(root, cComp, synCanon, "");
    test.checkInt("alias-eq c a", 0, aC.status);
    test.checkText("alias-eq c output", cC2.stdout, aC.stdout);
    checkTsOnlyContract("alias-stdin", "io := import \"core/io\"; i: Int64 = io.inputInt(\"int? \"); f: Double = io.inputFloat(\"float? \"); io.outputLine(i * f);", "", "3 0.5", 0, false);

    /* Float contexts admit exact integer literals without widening values or changing binary arithmetic */
    ctxBoth: List<String> = [
        "io := import \"core/io\"; f: Float = 2; d: Double = -3; g: Float64 = (4); io.outputLine(f, d, g);",
        "io := import \"core/io\"; a: Float = 9007199254740992; b: Float = 9007199254740994; c: Float = 18014398509481984; d: Float = -9223372036854775808; io.outputLine(a, b, c, d);",
        "io := import \"core/io\"; a: Float = ((-9007199254740992)); b: Float = (/* before */ 2 /* after */); io.outputLine(a, b);",
        "io := import \"core/io\"; var f: Float = 2; f = -4; io.outputLine(f); f = ((8)); io.outputLine(f);",
        "io := import \"core/io\"; f: Float = 2; g: Float = f; io.outputLine(f, g);",
        "io := import \"core/io\"; f: Float = 9007199254740993 + 0.5; g: Float = (9007199254740993) + 0.5; io.outputLine(f, g);",
        "io := import \"core/io\"; var f: Float = 2; loop f < 5 { f = f + 1; } io.outputLine(f);",
        "io := import \"core/io\"; Amount := type Double; var f: Amount = 2; f = (4); io.outputLine(f);",
        "io := import \"core/io\"; f: Float = (2.0 + 3.0); g: Float = -(2.5); io.outputLine(f, g);",
        "io := import \"core/io\"; f: Float = (-9007199254740993) * 0.5; io.outputLine(f);",
        "io := import \"core/io\"; f := fn(n: Float): Float { n } io.outputLine(f(2), f(-3), f((4)));",
        "io := import \"core/io\"; f := fn(): Float { 2 } g := fn(): Double { ((-3)) } io.outputLine(f(), g());",
        "io := import \"core/io\"; f := fn(flag: Bool): Float { if flag { return 2; } return 3; } io.outputLine(f(true), f(false));",
        "io := import \"core/io\"; f := fn(): Float { 9007199254740993; 2 } io.outputLine(f());",
        "io := import \"core/io\"; var flag := true; f: Float = if flag{2}else{3.5}; io.outputLine(f);",
        "io := import \"core/io\"; var flag := false; f: Float = (if (if flag{true}else{false}) {2}else if false{3}else{4.5}); io.outputLine(f);",
        "io := import \"core/io\"; f := fn(n: Float): Float { n } io.outputLine(f(if true{2}else{3.5}));",
        "io := import \"core/io\"; f: Float = (if true{9007199254740993}else{2}) + 0.5; io.outputLine(f);",
        "io := import \"core/io\"; f: Float = if true{2}else{3} + 0.5; io.outputLine(f);",
        "io := import \"core/io\"; io.outputLine(if true{12}else{34}); x := if true {1}else {2} +3; io.outputLine(x);"
    ];
    ctxTsOnly: List<String> = [
        "io := import \"core/io\"; xs: List<Float> = [1, -2, 9007199254740994]; io.outputLine(xs);",
        "io := import \"core/io\"; p: (n: Float, m: Double) = (n = 2, m = -3); io.outputLine(p);",
        "io := import \"core/io\"; Pair := type (n: Float); f := fn(): Pair { (n = 2) } io.outputLine(f());",
        "io := import \"core/io\"; xs: List<(n: Float)> = [(n = 2), (n = -3)]; io.outputLine(xs);"
    ];
    loop ctxBoth as src { checkTsAndCContract("float-ctx-both", src, "", "", 0); }
    loop ctxTsOnly as src { checkTsOnlyContract("float-ctx-ts", src, "", "", 0, true); }
    ctxInvalid: List<String> = [
        "f: Float = 9007199254740993;",
        "f: Float = -9007199254740993;",
        "f: Float = 18014398509481986;",
        "f: Float = 9223372036854775807;",
        "f: Float = 9223372036854775808;",
        "i := 2; f: Float = i;",
        "f: Float = 2 + 3;",
        "f: Float = (2) + 3;",
        "f: Float = 2 + (3);",
        "f: Float = (2 + 3);",
        "f: Float = +2;",
        "f: Float = -(2);",
        "f := fn(): Float { 2 + 3 } io.outputLine(f());",
        "f := fn(n: Float): Float { n } io.outputLine(f(2 + 3));",
        "xs: List<Float> = [1 + 1];",
        "i := 2; p: (n: Float) = (n = i);",
        "f: Float = if false{9007199254740993}else{2};",
        "f := fn(): Float { 9007199254740993 }",
        "p: (n: Float) = (n = 9007199254740993);",
        "io.outputLine(if true{1}else{2}+3);"
    ];
    loop ctxInvalid as tail {
        checkInvalidBoth("float-ctx-bad", "io := import \"core/io\"; io.outputLine(\"before\"); " + tail, "", "");
    }
    ctxFaults: List<String> = [
        "var f: Float = 2; io.outputLine(f / 0);",
        "var f: Float = 0; io.outputLine(1 / f);",
        "var f: Float = 2; io.outputLine(f * 1e308);"
    ];
    loop ctxFaults as tail {
        checkTsAndCContract("float-ctx-fault", "io := import \"core/io\"; io.outputLine(\"before\");\r\n" + tail, "float-context سلام.lts", "", 1);
    }
    deadTail := "io := import \"core/io\"; f := fn(): Float { return 2; 9007199254740993; } io.outputLine(f());";
    compilerTest.assertCompileRunTs(root, tsComp, "float-ctx-dead-tail", deadTail, "2\n");
}

test.done("floats-power-widths");
