/* Map<K, V>: typed key-value maps, indexing, core/map intrinsics, iteration, value semantics, and diagnostics. */

test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

/* 1. Core Map<String, Int>, Map<Int, String>, and Map<Enum, String> operations */
basicMapSrc :=
"io := import \"core/io\";\n" +
"State := enum { Idle; Active; Done; }\n" +
"scores: mut Map<String, Int>;\n" +
"scores[\"alice\"] = 10;\n" +
"mut scores.set(\"bob\", 20);\n" +
"scores[\"alice\"] = 15;\n" +
"io.outputLine(scores[\"alice\"]);\n" +
"io.outputLine(scores[\"bob\"]);\n" +
"io.outputLine(scores.size());\n" +
"io.outputLine(scores.has(\"alice\"));\n" +
"io.outputLine(scores.has(\"carol\"));\n" +
"g1 := scores.get(\"bob\");\n" +
"g2 := scores.get(\"carol\");\n" +
"io.outputLine(g1.found);\n" +
"io.outputLine(g1.value);\n" +
"io.outputLine(g2.found);\n" +
"io.outputLine(g2.value);\n" +
"io.outputLine(scores.getOr(\"alice\", 99));\n" +
"io.outputLine(scores.getOr(\"carol\", 99));\n" +
"io.outputLine(scores);\n" +
"loop scores as entry {\n" +
"    io.outputLine(entry.key, entry.value);\n" +
"}\n" +
"ks := scores.keys();\n" +
"vs := scores.values();\n" +
"io.outputLine(ks);\n" +
"io.outputLine(vs);\n" +
"io.outputLine(mut scores.remove(\"alice\"));\n" +
"io.outputLine(mut scores.remove(\"alice\"));\n" +
"io.outputLine(scores.size());\n" +
"mut scores.clear();\n" +
"io.outputLine(scores.size());\n" +
"labels: mut Map<State, String>;\n" +
"labels[.Idle] = \"waiting\";\n" +
"mut labels.set(.Active, \"running\");\n" +
"io.outputLine(labels[.Idle]);\n" +
"io.outputLine(labels.getOr(.Done, \"finished\"));\n" +
"io.outputLine(labels.has(.Active));\n";

basicExpected :=
"15\n20\n2\ntrue\nfalse\ntrue\n20\nfalse\n0\n15\n99\n{alice: 15, bob: 20}\n" +
"alice 15\nbob 20\n[alice, bob]\n[15, 20]\ntrue\nfalse\n1\n0\nwaiting\nfinished\ntrue\n";
compilerTest.assertCompileRunTs(root, tsComp, "basic map operations TS", basicMapSrc, basicExpected);

/* 2. Value-copy semantics, functions, block expressions, mut inference, and nested Map<String, List<Int>> */
valueSemSrc :=
"io := import \"core/io\";\n" +
"makeCounts := fn(): Map<String, Int> {\n" +
"    m: mut Map<String, Int>;\n" +
"    m[\"a\"] = 1;\n" +
"    m[\"b\"] = 2;\n" +
"    m\n" +
"};\n" +
"sumValues := fn(m: Map<String, Int>): Int {\n" +
"    var total := 0;\n" +
"    loop m as e {\n" +
"        total = total + e.value;\n" +
"    }\n" +
"    total\n" +
"};\n" +
"mut m1 := makeCounts();\n" +
"copy := m1;\n" +
"m1[\"a\"] = 100;\n" +
"m1[\"c\"] = 3;\n" +
"io.outputLine(copy[\"a\"]);\n" +
"io.outputLine(copy.size());\n" +
"io.outputLine(sumValues(copy));\n" +
"io.outputLine(sumValues(m1));\n" +
"var mut m2 := makeCounts();\n" +
"m2[\"b\"] = 20;\n" +
"io.outputLine(m2[\"b\"]);\n" +
"nested: mut Map<String, List<Int>>;\n" +
"xs: mut List<Int> = [1, 2];\n" +
"nested[\"nums\"] = xs;\n" +
"mut xs.pushBack(3);\n" +
"io.outputLine(nested[\"nums\"]);\n";

compilerTest.assertCompileRunTs(root, tsComp, "value semantics and nested map TS", valueSemSrc, "1\n2\n3\n105\n20\n[1, 2]\n");

/* 3. Missing key runtime fault on indexing */
missingKeySrc :=
"io := import \"core/io\";\n" +
"m: mut Map<String, Int>;\n" +
"m[\"a\"] = 1;\n" +
"io.outputLine(m[\"missing\"]);\n";
missingRun := compilerTest.compileCheckRunTs(root, tsComp, missingKeySrc, "");
test.check("missing key index faults at runtime", missingRun.status =!= 0);
test.check("missing key mentions KeyPanic: " + missingRun.stderr, missingRun.stderr.contains("KeyPanic"));

/* 4. Compile-time rejections */
badSrc: List<String> = [
"m: Map<List<Int>, Int>;\n",
"m: Map<String, Unit>;\n",
"m: Map<String, Int>;\nm[\"a\"] = 1;\n",
"m: Map<String, Int>;\nmut m.set(\"a\", 1);\n",
"m: mut Map<String, Int>;\nMap.set(m, \"a\", 1);\n",
"m: mut Map<String, Int>;\nm[42] = 1;\n",
"io := import \"core/io\";\na: Map<String, Int>;\nb: Map<String, Int>;\nio.outputLine(a == b);\n",
"m: Map<String, Int> = ?;\n"
];
badErr: List<String> = [
"unsupported map key type",
"unsupported map value type",
"cannot mutate read-only value m via index assignment",
"cannot call mutating operation set on read-only value",
"requires mut",
"index must be String",
"cannot compare map values",
"reserved storage is not supported for Map"
];
var bi := 0;
loop bi < 8 {
    compilerTest.assertCompileErrorContains(root, tsComp, "bad map " + badSrc[bi], badSrc[bi], badErr[bi]);
    bi = bi + 1;
}

/* 5. C backend compiles Map values cleanly */
cMapRes := compilerTest.compileStdin(root, cComp,
"io := import \"core/io\";\nm: mut Map<String, Int>;\nm[\"a\"] = 1;\nio.outputLine(m[\"a\"]);\n", "");
test.checkInt("map C compiles: " + cMapRes.stderr, 0, cMapRes.status);

test.done("map");
