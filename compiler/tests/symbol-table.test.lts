/** Dual-target tests for `compiler/src/symbol-table.lts` O(1) scoped lookups and undo-stack shadowing. */

test := import "core/test";
ir := import "../src/frontend-ir";
sym := import "../src/symbol-table";

makeLocal := fn(name: String, rt: String, kind: String, depth: Int, initState: String): ir.Local {
    (name = name, runtime = rt, kind = kind, mutable = false, writable = false,
    depth = depth, constant = false, code = "", intValue = 0, textValue = "", initState = initState)
};

/* 1. Scoped local shadowing, undo rewind, and sibling block isolation */
sym.resetModule();
var mut locals: List<ir.Local> = [];
mut locals.pushBack(makeLocal("x", "lite_x", "Int", 0, ir.INIT_STATE_INIT));
mut locals.pushBack(makeLocal("y", "lite_y", "String", 0, ir.INIT_STATE_INIT));
test.checkInt("root x", 0, sym.localIndex(locals, "x"));
test.checkInt("root y", 1, sym.localIndex(locals, "y"));
test.checkInt("missing z", -1, sym.localIndex(locals, "z"));
test.check("initially ready", not sym.localsHasAnyUnready(locals));
test.check("initially no callable", not sym.hasCallableLocal(locals));

/* Enter inner block shadowing x with an uninit var and adding a callable */
mark := sym.localMark();
mut locals.pushBack(makeLocal("x", "lite_x_1", "Int", 1, ir.INIT_STATE_UNINIT));
mut locals.pushBack(makeLocal("cb", "lite_cb", "fn(Int):Int", 1, ir.INIT_STATE_INIT));
test.checkInt("shadowed x", 2, sym.localIndex(locals, "x"));
test.checkInt("callable cb", 3, sym.localIndex(locals, "cb"));
test.check("uninit x marks unready", sym.localsHasAnyUnready(locals));
test.check("cb marks callable", sym.hasCallableLocal(locals));

/* Upgrade x to init */
mut locals.pushBack(makeLocal("x", "lite_x_1", "Int", 1, ir.INIT_STATE_INIT));
test.checkInt("upgraded x", 4, sym.localIndex(locals, "x"));
test.check("upgraded x clears unready", not sym.localsHasAnyUnready(locals));
test.checkInt("latest runtime lite_x_1", 4, sym.latestActiveLocalByRuntime(locals, "lite_x_1"));

/* Exit inner block via rewind: outer x restored, callable cleared */
_p1 := mut locals.popBack();
_p2 := mut locals.popBack();
_p3 := mut locals.popBack();
sym.rewindLocalsTo(mark);
test.checkInt("restored outer x", 0, sym.localIndex(locals, "x"));
test.checkInt("popped cb absent", -1, sym.localIndex(locals, "cb"));
test.check("restored no callable", not sym.hasCallableLocal(locals));
test.check("restored ready", not sym.localsHasAnyUnready(locals));

/* 2. Future placeholder (depth <= -2) becomes ready when reached */
mut locals.pushBack(makeLocal("f", "lite_f", "Int", -3, ir.INIT_STATE_INIT));
test.checkInt("future f invisible to localIndex", -1, sym.localIndex(locals, "f"));
test.check("future f marks unready", sym.localsHasAnyUnready(locals));
test.check("future f marks hasFutureLocal", sym.hasFutureLocal(locals));
mut locals.pushBack(makeLocal("f", "lite_f", "Int", 1, ir.INIT_STATE_INIT));
test.checkInt("reached f visible", 3, sym.localIndex(locals, "f"));
test.check("reached f clears unready", not sym.localsHasAnyUnready(locals));

/* 3. Alias shadowing: strictly deeper shadows, same-depth first wins, pop restores */
var mut aliases: List<ir.AliasDecl> = [];
mut aliases.pushBack((name = "T", target = "Int", at = 0, end = 10, depth = 0));
mut aliases.pushBack((name = "T", target = "String", at = 12, end = 20, depth = 0));
test.checkInt("same-depth first alias wins", 0, sym.findAlias(aliases, "T"));
aliasMark := sym.aliasMark();
mut aliases.pushBack((name = "T", target = "Bool", at = 30, end = 40, depth = 1));
test.checkInt("deeper alias shadows", 2, sym.findAlias(aliases, "T"));
_pa := mut aliases.popBack();
sym.rewindAliasesTo(aliasMark);
test.checkInt("popped alias restores depth 0", 0, sym.findAlias(aliases, "T"));

/* 4. Monotonic function index by name and runtime */
var mut fns: List<ir.FunctionInfo> = [];
mut fns.pushBack((name = "add", runtime = "lt_fn_add", result = "Int", first = 0, count = 2, declAt = 0));
mut fns.pushBack((name = "sub", runtime = "lt_fn_sub", result = "Int", first = 2, count = 2, declAt = 20));
test.checkInt("findFunction add", 0, sym.findFunction(fns, "add"));
test.checkInt("findFunction sub", 1, sym.findFunction(fns, "sub"));
test.checkInt("findFunctionByRuntime lt_fn_sub", 1, sym.findFunctionByRuntime(fns, "lt_fn_sub"));
test.checkInt("findFunction missing", -1, sym.findFunction(fns, "mul"));

test.done("symbol-table");
