/* Lexer and numeric-literal phase regression suite migrated from igniter/test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

sel := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + sel.error, sel.ok);

contracts := compilerTest.readProcessContracts(root);
lexerDriverRel := "compiler/tests/lexer/lexer-dump.lts";
parserProgDriverRel := "compiler/tests/parser/parser-program-dump.lts";
checkerDriverRel := "compiler/tests/checker/checker-dump.lts";

lexerDriver := compilerTest.prepareDriver(root, sel.path, lexerDriverRel);

/* Lite lexer tokenizes lexical fixtures exactly */
fixtureNames: List<String> = ["tokens", "symbols", "comments", "strings", "int"];
loop fixtureNames as name {
    src := fs.readText(path.join(root, "compiler/tests/lexer/" + name + ".lts"));
    exp := fs.readText(path.join(root, "compiler/tests/lexer/" + name + ".tokens"));
    test.check("read fixture " + name, src.ok and exp.ok);
    compilerTest.assertDriver(lexerDriver, "lexer fixture " + name, src.text, 0, exp.text, "");
}

/* Lite lexer rejects malformed lexical input with positioned diagnostics */
badInputs: List<String> = [
"outputLine(\"bad \\q\");",
"outputLine(\"unterminated);",
"/* unterminated",
"/*# unterminated",
"outputLine(9223372036854775809);",
"outputLine(🙂);",
"a =! b;",
"a && b;",
"a || b;",
];
badErrors: List<String> = [
"1:17: unsupported string escape \\q\n",
"1:12: unterminated string literal\n",
"1:1: unterminated comment\n",
"1:1: unterminated raw comment\n",
"1:12: integer literal outside signed 64-bit range\n",
"1:12: unsupported symbol: 🙂\n",
"1:3: incomplete operator =!; use =!=\n",
"1:3: unsupported operator &&; use and\n",
"1:3: unsupported operator ||; use or\n",
];
var bi := 0;
loop bi < 9 {
    compilerTest.assertDriver(lexerDriver, "lexer bad " + badInputs[bi], badInputs[bi], 2, "", badErrors[bi]);
    bi = bi + 1;
}

/* Lite numeric literal phases share Float spelling and finite-range checks */
parserProgDriver := compilerTest.prepareDriver(root, sel.path, parserProgDriverRel);
checkerDriver := compilerTest.prepareDriver(root, sel.path, checkerDriverRel);

floatGood: List<String> = [
"a := 0.1; b := 1e2; c := -0.0; d := 5e-324;",
"var n: Float = 0.1; n = 2.5;",
"f := fn(n: Float): Float { -n } x := f(1.5);",
];
floatBad: List<String> = ["x := 1e;", "x := 1e309;"];

loop floatGood as snippet {
    compilerTest.assertDriverMatchesContract(root, contracts, lexerDriverRel, lexerDriver, "float good lexer: " + snippet, snippet, 0);
    compilerTest.assertDriverMatchesContract(root, contracts, parserProgDriverRel, parserProgDriver, "float good parser: " + snippet, snippet, 0);
    compilerTest.assertDriverMatchesContract(root, contracts, checkerDriverRel, checkerDriver, "float good checker: " + snippet, snippet, 0);
}
loop floatBad as snippet {
    compilerTest.assertDriverMatchesContract(root, contracts, lexerDriverRel, lexerDriver, "float bad lexer: " + snippet, snippet, 2);
    compilerTest.assertDriverMatchesContract(root, contracts, parserProgDriverRel, parserProgDriver, "float bad parser: " + snippet, snippet, 2);
    compilerTest.assertDriverMatchesContract(root, contracts, checkerDriverRel, checkerDriver, "float bad checker: " + snippet, snippet, 2);
}

compilerTest.disposeDriver(lexerDriver);
compilerTest.disposeDriver(parserProgDriver);
compilerTest.disposeDriver(checkerDriver);
