/* Token-dump driver for the Lite-written lexer. Test helper, not a public command. */

importFlatAll "../../../lib/core/int.lts";
importFlatAll "../../../lib/core/text.lts";
importFlatAll "../../../lib/core/source.lts";
importFlatAll "../../../lib/core/diag.lts";
importFlatAll "../../../lib/core/format.lts";
importFlatAll "../../src/numeric-literals.lts";
importFlatAll "../../src/lexer.lts";

var prefix := "";
var argCount := 0;
loop inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    reportError("expected at most one logical source name argument");
    exit(2);
}
dumpTokens(tokenize(inputAll(), prefix));
