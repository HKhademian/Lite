/* Token-dump driver for the Lite-written lexer. Test helper, not a public command. */

lexer := import "../../src/lexer.lts";
io := import "core/io";

var prefix := "";
var argCount := 0;
loop io.inputArgs() as argument {
    if argCount == 0 { prefix = argument; }
    argCount = argCount + 1;
}
if argCount > 1 {
    io.errorLine("expected at most one logical source name argument");
    io.exit(2);
}
    lexer.dumpTokens(lexer.tokenize(io.inputAll(), prefix));
