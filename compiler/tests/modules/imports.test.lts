/* Module import paths, cycle visits, visibility, public types, and host source-read tests migrated from compiler/tests/host.test.ts. */

fs := import "core/file";
path := import "core/path";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
json := import "util/json";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select TS compiler: " + selTs.error, selTs.ok);
selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select C compiler: " + selC.error, selC.ok);
tsComp := selTs.path;
cComp := selC.path;

emptyArgs := fn(): List<String> {
    res: List<String> = [];
    res
};

/* standalone generated compiler CLI performs strict-UTF-8 source reads directly via core/file */
tmpSrcRes := fs.makeTempDir("lite-source-provider-");
test.check("makeTempDir source-provider", tmpSrcRes.ok);
srcDir := tmpSrcRes.path;
importer := path.join(srcDir, "app.lts");
dependency := path.join(srcDir, "dep.lts");
_wd1 := fs.writeText(dependency, "pub answer := 42;\n");
_wi1 := fs.writeText(importer, "dep := import \"./dep.lts\"; io := import \"core/io\"; io.outputLine(dep.answer);\n");
outFile := path.join(srcDir, "out.ts");
traceFile := path.join(srcDir, "trace.json");
cliArgs1: List<String> = ["--out", outFile, "--trace-json", traceFile, importer];
compiled1 := compilerTest.compileFile(tsComp, srcDir, cliArgs1);
test.checkInt("cli trace compile status", 0, compiled1.status);
test.checkText("cli trace compile stderr", "", compiled1.stderr);
test.checkText("cli trace compile stdout", "", compiled1.stdout);

traceText := fs.readText(traceFile).text;
realDep := fs.realPath(dependency).path;
filesField := json.findObjectField(traceText, 0, "files");
test.check("trace files field", filesField.found);
var foundDepFile := false;
loop json.arrayElementOffsets(traceText, filesField.valuePos) as fPos {
    pVal := json.readObjectString(traceText, fPos, "path");
    if pVal.found and pVal.ok and pVal.value == realDep { foundDepFile = true; }
}
test.check("trace includes dependency realpath", foundDepFile);
edgesField := json.findObjectField(traceText, 0, "edges");
test.check("trace edges field", edgesField.found);
var foundDepEdge := false;
loop json.arrayElementOffsets(traceText, edgesField.valuePos) as ePos {
    sVal := json.readObjectString(traceText, ePos, "spec");
    pVal := json.readObjectString(traceText, ePos, "path");
    if sVal.found and sVal.ok and pVal.found and pVal.ok and sVal.value == "./dep.lts" and pVal.value == realDep {
        foundDepEdge = true;
    }
}
test.check("trace includes dependency edge", foundDepEdge);
outFileRun := compilerTest.checkAndRunTs(root, fs.readText(outFile).text);
test.checkInt("outFile run status", 0, outFileRun.status);
test.checkText("outFile run stdout", "42\n", outFileRun.stdout);

_wb := fs.writeBytes(dependency, [255]);
invalidUtf8 := compilerTest.compileFile(tsComp, srcDir, [importer]);
test.checkInt("invalid utf8 dep status", 2, invalidUtf8.status);
test.check("invalid utf8 dep stderr", invalidUtf8.stderr.contains("imported source ./dep.lts is not valid UTF-8"));

_wi2 := fs.writeText(importer, "dep := import \"\";\n");
emptyImport := compilerTest.compileFile(tsComp, srcDir, [importer]);
test.checkInt("empty import status", 2, emptyImport.status);
test.check("empty import stderr", emptyImport.stderr.contains("import path must be nonempty and use \"/\" separators"));

_wi3 := fs.writeText(importer, "dep := import \"./missing.lts\";\n");
missingImport := compilerTest.compileFile(tsComp, srcDir, [importer]);
test.checkInt("missing import status", 2, missingImport.status);
test.checkText("missing import stdout", "", missingImport.stdout);
test.check("missing import stderr", missingImport.stderr.contains("cannot read imported source ./missing.lts (ENOENT)"));
_rmSrc := fs.remove(srcDir);

/* Lite import paths resolve relative, absolute and through the library root */
tmpPathRes := fs.makeTempDir("lite-import-paths-");
test.check("makeTempDir import-paths", tmpPathRes.ok);
pathDir := tmpPathRes.path;
nestedDir := path.join(pathDir, "nested");
_mkNested := fs.makeDir(nestedDir);
appPath := path.join(pathDir, "app.lts");
basePath := path.join(pathDir, "base.lt");
nestedMath := path.join(nestedDir, "math.lt");
_wb1 := fs.writeText(basePath, "pub twice := fn(value: Int): Int { value * 2 };\n");
_wm1 := fs.writeText(nestedMath, "base := import \"../base\"; pub answer := fn(): Int { base.twice(21) };\n");

relComp := compilerTest.compileStdinWithOpts(root, tsComp, pathDir, "math := import \"./nested/math\"; io := import \"core/io\"; io.outputLine(math.answer());", appPath, appPath, emptyArgs());
test.checkInt("relative import compile", 0, relComp.status);
relRun := compilerTest.checkAndRunTs(root, relComp.stdout);
test.checkInt("relative import run", 0, relRun.status);
test.checkText("relative import out", "42\n", relRun.stdout);

baseStem := basePath.slice(0, basePath.length() - 3);
absSrc := "math := import " + json.quoteString(baseStem) + "; io := import \"core/io\"; io.outputLine(math.twice(10));";
absComp := compilerTest.compileStdinWithOpts(root, tsComp, pathDir, absSrc, appPath, appPath, emptyArgs());
test.checkInt("absolute import compile", 0, absComp.status);
absRun := compilerTest.checkAndRunTs(root, absComp.stdout);
test.checkText("absolute import out", "20\n", absRun.stdout);
_rmPath := fs.remove(pathDir);

/* Lite import path resolution is independent of the caller working directory */
tmpCwdRes := fs.makeTempDir("lite-import-cwd-");
tmpOutCwdRes := fs.makeTempDir("lite-outside-cwd-");
test.check("makeTempDir cwd", tmpCwdRes.ok and tmpOutCwdRes.ok);
elsewhere := tmpCwdRes.path;
outsideCwd := tmpOutCwdRes.path;
_mkElse := fs.makeDir(path.join(elsewhere, "nested"));
_we1 := fs.writeText(path.join(elsewhere, "base.lt"), "pub twice := fn(v: Int): Int { v * 2 };\n");
_we2 := fs.writeText(path.join(elsewhere, "nested/math.lt"), "base := import \"../base\"; pub answer := fn(): Int { base.twice([\"a\", \"b\"].join(\"\").length()) };\n");
mainFile := path.join(elsewhere, "nested/main.lts");
_we3 := fs.writeText(mainFile, "math := import \"./math\"; io := import \"core/io\"; io.outputLine(math.answer());\n");
cwdComp := compilerTest.compileFile(tsComp, outsideCwd, [mainFile]);
test.checkInt("cwd independent compile", 0, cwdComp.status);
cwdRun := compilerTest.checkAndRunTs(root, cwdComp.stdout);
test.checkText("cwd independent out", "4\n", cwdRun.stdout);
_rmElse := fs.remove(elsewhere);
_rmOutCwd := fs.remove(outsideCwd);

/* host operations and source reads are not available as unqualified globals */
unqualifiedCases: List<String> = [
"outputLine(1);",
"output(\"x\");",
"reportError(\"x\");",
"inputArgs();",
"inputAll();",
"inputLine();",
"inputInt();",
"inputFloat();",
"exit(0);",
"textLength(\"x\");",
"textAt(\"x\", 0);",
"textSlice(\"x\", 0, 1);",
"readSource(\"main.lts\", \"./dep\");",
"values: mut List<Int> = []; pushBack(mut values, 1);",
"values: mut List<Int> = []; popBack(mut values);",
];
loop unqualifiedCases as uSrc {
    compilerTest.assertCompileErrorContains(root, tsComp, "unqualified " + uSrc, uSrc, "unknown value");
}
compilerTest.assertCompileErrorContains(root, tsComp, "unaliased host import", "import \"core/io\"; inputArgs();", "import requires a module alias");

/* core list mutations preserve element and mutability checks */
listSrc := fs.readText(path.join(root, "lib/core/list.lt")).text;
test.check("core/list pushBack signature", listSrc.contains("pub List.pushBack := fn<T>(values: mut Self<T>, value: T): Unit;"));
test.check("core/list popBack signature", listSrc.contains("pub List.popBack := fn<T>(values: mut Self<T>): T;"));
test.check("core/list not variadic", not listSrc.contains("pub List.pushBack := fn(..."));
test.check("core/list popBack not variadic", not listSrc.contains("pub List.popBack := fn(..."));

listProg := "io := import \"core/io\"; values: mut List<Int> = [1]; mut values.pushBack(2); io.outputLine(mut values.popBack(), values);";
compilerTest.assertCompileRunTs(root, tsComp, "core/list valid", listProg, "2 [1]\n");
cListProgRes := compilerTest.compileStdin(root, cComp, listProg, "");
test.checkInt("core/list C compiles: " + cListProgRes.stderr, 0, cListProgRes.status);
invalidListCases: List<String> = [
"values: mut List<Int> = []; mut values.pushBack(\"x\");",
"values: List<Int> = []; mut values.pushBack(1);",
"values: List<Int> = []; mut values.popBack();",
"values: mut List<Int> = []; pushBack(mut values, 1);",
];
loop invalidListCases as invSrc {
    resInv := compilerTest.compileStdin(root, tsComp, invSrc, "");
    test.checkInt("invalid core/list status", 2, resInv.status);
    test.checkText("invalid core/list stdout", "", resInv.stdout);
}

/* pub marks a top-level declaration without changing current visibility behavior */
compilerTest.assertCompileRunTs(root, tsComp, "pub top-level fn", "io := import \"core/io\"; pub twice := fn(x: Int): Int { x * 2 }; io.outputLine(twice(4));", "8\n");
lexerDumpPath := fs.realPath(path.join(root, "compiler/tests/lexer/lexer-dump.lts")).path;
lexerDriver := compilerTest.prepareDriver(root, tsComp, lexerDumpPath);
lexerPubRes := compilerTest.runDriver(lexerDriver, "pub twice := fn() { 2 }");
test.checkInt("lexer pub status", 0, lexerPubRes.status);
test.check("lexer pub token", lexerPubRes.stdout.startsWithAt(0, "Keyword@1:1:0 pub\n"));
compilerTest.disposeDriver(lexerDriver);
compilerTest.assertCompileErrorContains(root, tsComp, "nested pub rejected", "if true { pub hidden := fn() { 1 }; }", "pub is only allowed on top-level declarations");

/* imports require a namespace alias and are recognized only at top level */
tmpAliasReqRes := fs.makeTempDir("lite-import-alias-required-");
test.check("makeTempDir alias-required", tmpAliasReqRes.ok);
aliasReqDir := tmpAliasReqRes.path;
_war := fs.writeText(path.join(aliasReqDir, "math.lt"), "pub twice := fn(value: Int): Int { value * 2 };\n");
aliasReqApp := path.join(aliasReqDir, "app.lts");
aliasReqComp := compilerTest.compileStdinWithOpts(root, tsComp, aliasReqDir, "math := import \"./math\"; io := import \"core/io\"; io.outputLine(math.twice(21));", aliasReqApp, aliasReqApp, emptyArgs());
test.checkInt("alias-required compile", 0, aliasReqComp.status);
test.checkText("alias-required stderr", "", aliasReqComp.stderr);
aliasReqRun := compilerTest.checkAndRunTs(root, aliasReqComp.stdout);
test.checkInt("alias-required run", 0, aliasReqRun.status);
test.checkText("alias-required out", "42\n", aliasReqRun.stdout);
_rmAliasReq := fs.remove(aliasReqDir);

badImportSrcs: List<String> = [
"if true { import \"./math.lts\"; }",
"import \"./math.lts\";",
"math := import \"../math.lts\" io.outputLine(1);",
"math := import \"\";",
"math := import \"math\\\\math.lts\";",
];
badImportErrs: List<String> = [
"import is only allowed at top level",
"import requires a module alias",
"expected ; after import",
"import path must be nonempty and use \"/\" separators",
"import path must be nonempty and use \"/\" separators",
];
var bii := 0;
loop bii < 5 {
    compilerTest.assertCompileErrorContains(root, tsComp, "bad import " + badImportSrcs[bii], badImportSrcs[bii], badImportErrs[bii]);
    bii = bii + 1;
}
unnamedMissing := compilerTest.compileStdin(root, tsComp, "missing := import \"./not-there.lts\";", "");
test.checkInt("unnamed missing status", 2, unnamedMissing.status);
test.checkText("unnamed missing stdout", "", unnamedMissing.stdout);
test.checkText("unnamed missing stderr", "cannot read imported source ./not-there.lts (ENOENT)\n", unnamedMissing.stderr);

/* the Lite TypeScript driver visits imported source units once across cycles */
tmpGraphRes := fs.makeTempDir("lite-import-graph-");
test.check("makeTempDir graph", tmpGraphRes.ok);
graphDir := tmpGraphRes.path;
gRoot := fs.realPath(graphDir).path + "/app.lts";
gChild := fs.realPath(graphDir).path + "/math.lts";
_wg1 := fs.writeText(gRoot, "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.twice(21));\n");
_wg2 := fs.writeText(gChild, "app := import \"./app.lts\"; pub twice := fn(x: Int): Int { x * 2 };\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "cycle graph", fs.readText(gRoot).text, gRoot, "42\n");

_wg3 := fs.writeText(gChild, "io := import \"core/io\"; io.outputLine(1 +);\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "cycle error in child", fs.readText(gRoot).text, gRoot, "math.lts:1:");

_wg4 := fs.writeText(gRoot, "io := import \"core/io\"; missing := import \"./missing.lts\"; io.outputLine(42);\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "missing in graph", fs.readText(gRoot).text, gRoot, "cannot read imported source ./missing.lts");
_rmGraph := fs.remove(graphDir);

/* namespace imports expose only public functions and emit their module bodies */
tmpPubRes := fs.makeTempDir("lite-import-pub-");
test.check("makeTempDir pub", tmpPubRes.ok);
pubDir := fs.realPath(tmpPubRes.path).path;
pRoot := path.join(pubDir, "app.lts");
pMath := path.join(pubDir, "math.lts");
_wp1 := fs.writeText(pRoot, "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.twice(21));\n");
_wp2 := fs.writeText(pMath, "privateDouble := fn(x: Int): Int { x * 2 }; pub twice := fn(x: Int): Int { privateDouble(x) };\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "pub fn basic", fs.readText(pRoot).text, pRoot, "42\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "private fn rejected", "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.privateDouble(21));", pRoot, "unknown module member math.privateDouble");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "pub fn arg type", "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.twice(\"21\"));", pRoot, "argument 1 of math.twice must be Int, got String");

_wp3 := fs.writeText(pRoot, "io := import \"core/io\"; math1 := import \"./math.lts\"; math2 := import \"./math.lts\"; io.outputLine(math1.twice(21), math2.twice(21));\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "repeated import", fs.readText(pRoot).text, pRoot, "42 42\n");

pOther := path.join(pubDir, "other.lts");
_wp4 := fs.writeText(pOther, "pub twice := fn(x: Int): Int { x + x };\n");
_wp5 := fs.writeText(pRoot, "io := import \"core/io\"; math := import \"./math.lts\"; other := import \"./other.lts\"; io.outputLine(math.twice(21), other.twice(21));\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "duplicate pub name across modules", fs.readText(pRoot).text, pRoot, "42 42\n");
_rmPub := fs.remove(pubDir);

/* separate imported modules retain distinct private function and value identities */
tmpIdRes := fs.makeTempDir("lite-import-identities-");
test.check("makeTempDir identities", tmpIdRes.ok);
idDir := fs.realPath(tmpIdRes.path).path;
idRoot := path.join(idDir, "app.lts");
_wiId1 := fs.writeText(idRoot, "io := import \"core/io\"; first := import \"./first.lts\"; second := import \"./second.lts\"; io.outputLine(first.twice(20), second.plusFive(20));\n");
_wiId2 := fs.writeText(path.join(idDir, "first.lts"), "scale := 2; helper := fn(x: Int): Int { x * scale }; pub twice := fn(x: Int): Int { helper(x) };\n");
_wiId3 := fs.writeText(path.join(idDir, "second.lts"), "scale := 1; helper := fn(x: Int): Int { x + 5 * scale }; pub plusFive := fn(x: Int): Int { helper(x) };\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "distinct private identities", fs.readText(idRoot).text, idRoot, "40 25\n");
_rmId := fs.remove(idDir);

/* nested imports resolve exported functions without re-exporting dependencies */
tmpNestRes := fs.makeTempDir("lite-import-nested-");
test.check("makeTempDir nested", tmpNestRes.ok);
nestDir := fs.realPath(tmpNestRes.path).path;
nestRoot := path.join(nestDir, "app.lts");
_wn1 := fs.writeText(nestRoot, "io := import \"core/io\"; facade := import \"./facade.lts\"; io.outputLine(facade.timesSix(7));\n");
_wn2 := fs.writeText(path.join(nestDir, "facade.lts"), "base := import \"./base.lts\"; pub timesSix := fn(x: Int): Int { base.triple(x) * 2 };\n");
_wn3 := fs.writeText(path.join(nestDir, "base.lts"), "pub triple := fn(x: Int): Int { x * 3 };\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "nested import ok", fs.readText(nestRoot).text, nestRoot, "42\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "transitive member rejected", "io := import \"core/io\"; facade := import \"./facade.lts\"; io.outputLine(facade.triple(7));", nestRoot, "unknown module member facade.triple");
_rmNest := fs.remove(nestDir);

/* namespace imports resolve public functions and immutable values through aliases */
tmpAlRes := fs.makeTempDir("lite-import-alias-");
test.check("makeTempDir alias", tmpAlRes.ok);
alDir := fs.realPath(tmpAlRes.path).path;
alRoot := path.join(alDir, "app.lts");
alMath := path.join(alDir, "math.lts");
_wa1 := fs.writeText(alMath, "hidden := 9; pub factor := 2; pub twice := fn(x: Int): Int { x * factor }\n");
_wa2 := fs.writeText(alRoot, "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.twice(21), math.factor);\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "alias fn + val", fs.readText(alRoot).text, alRoot, "42 2\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "alias statement call", "io := import \"core/io\"; math := import \"./math.lts\"; math.twice(10); io.outputLine(1);", alRoot, "1\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "alias hidden member", "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.hidden);", alRoot, "unknown module member math.hidden");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "alias wrong arg", "io := import \"core/io\"; math := import \"./math.lts\"; io.outputLine(math.twice(\"21\"));", alRoot, "argument 1 of math.twice must be Int, got String");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "alias immutable member", "math := import \"./math.lts\"; math.factor = 5;", alRoot, "module members are immutable");

_wa3 := fs.writeText(alRoot, "io := import \"core/io\"; left := import \"./math.lts\"; right := import \"./math.lts\"; io.outputLine(left.twice(10), right.twice(11));\n");
repAliasComp := compilerTest.compileStdin(root, tsComp, fs.readText(alRoot).text, alRoot);
test.checkInt("repeated alias compile", 0, repAliasComp.status);
firstEmitPos := repAliasComp.stdout.indexOf("function liteFn$math$twice(", 0);
test.check("repeated alias emitted once (first)", firstEmitPos >= 0);
secondEmitPos := repAliasComp.stdout.indexOf("function liteFn$math$twice(", firstEmitPos + 1);
test.check("repeated alias emitted once (no second)", secondEmitPos < 0);
repAliasRun := compilerTest.checkAndRunTs(root, repAliasComp.stdout);
test.checkInt("repeated alias run status", 0, repAliasRun.status);
test.checkText("repeated alias run out", "20 22\n", repAliasRun.stdout);

compilerTest.assertCompileErrorContainsNamed(root, tsComp, "duplicate module alias", "math := import \"./math.lts\"; math := import \"./math.lts\";", alRoot, "duplicate module alias math");
_rmAl := fs.remove(alDir);

/* namespace imports work in imported modules and preserve direct-only visibility */
tmpAlNestRes := fs.makeTempDir("lite-import-alias-nested-");
test.check("makeTempDir alias-nested", tmpAlNestRes.ok);
anDir := fs.realPath(tmpAlNestRes.path).path;
anRoot := path.join(anDir, "app.lts");
_wan1 := fs.writeText(anRoot, "io := import \"core/io\"; facade := import \"./facade.lts\"; io.outputLine(facade.timesSix(7));\n");
_wan2 := fs.writeText(path.join(anDir, "facade.lts"), "math := import \"./math.lts\"; pub timesSix := fn(x: Int): Int { math.twice(x) * 3 };\n");
_wan3 := fs.writeText(path.join(anDir, "math.lts"), "pub twice := fn(x: Int): Int { x * 2 };\n");
compilerTest.assertCompileRunTsNamed(root, tsComp, "alias nested ok", fs.readText(anRoot).text, anRoot, "42\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "alias nested not reexported", "io := import \"core/io\"; facade := import \"./facade.lts\"; io.outputLine(facade.twice(3));", anRoot, "unknown module member facade.twice");
_rmAn := fs.remove(anDir);

/* namespace imports expose public types for qualified annotations and signatures */
tmpPubTypeRes := fs.makeTempDir("lite-import-public-types-");
test.check("makeTempDir public-types", tmpPubTypeRes.ok);
ptDir := fs.realPath(tmpPubTypeRes.path).path;
ptRoot := path.join(ptDir, "app.lts");
ptTypes := path.join(ptDir, "types.lts");
_wpt1 := fs.writeText(ptTypes,
"InternalCount := alias Int;\n" +
"pub Count := alias InternalCount;\n" +
"pub Point := alias (x: Int, y: Int);\n" +
"pub shift := fn(point: Point, dx: Int): Point { (x = point.x + dx, y = point.y) }\n"
);
_wpt2 := fs.writeText(ptRoot,
"io := import \"core/io\"; types := import \"./types.lts\";\n" +
"point: types.Point = (x = 40, y = 2);\n" +
"shifted: types.Point = types.shift(point, 2);\n" +
"count: types.Count = 42;\n" +
"io.outputLine(shifted.x, count);\n"
);
compilerTest.assertCompileRunTsNamed(root, tsComp, "public types ok", fs.readText(ptRoot).text, ptRoot, "42 42\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "hidden type rejected", "types := import \"./types.lts\"; hidden: types.InternalCount = 1;", ptRoot, "unknown type alias types.InternalCount");
malType := compilerTest.compileStdin(root, tsComp, "types := import \"./types.lts\"; point: types.Point = (x = 1, y = \"two\");", ptRoot);
test.checkInt("malformed qualified tuple status", 2, malType.status);
test.checkText("malformed qualified tuple stdout", "", malType.stdout);
_rmPt := fs.remove(ptDir);

/* strict .lt/.lts import rules and declaration-only .lt top level */
tmpStrictRes := fs.makeTempDir("lite-import-strict-lt-");
test.check("makeTempDir strict-lt", tmpStrictRes.ok);
strictDir := fs.realPath(tmpStrictRes.path).path;
strictApp := path.join(strictDir, "app.lts");
_ws1 := fs.writeText(path.join(strictDir, "only-script.lts"), "pub val := 7;\n");
_ws2 := fs.writeText(path.join(strictDir, "pure-mod.lt"), "pub base := 1 + 2;\nvar cache := \"init\";\npub readBase := fn(): Int { base };\npub readCache := fn(): String { cache };\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "extensionless skips .lts", "s := import \"./only-script\";", strictApp, "cannot read imported source ./only-script (ENOENT)");
compilerTest.assertCompileRunTsNamed(root, tsComp, "explicit .lts ok in .lts", "s := import \"./only-script.lts\"; io := import \"core/io\"; io.outputLine(s.val);", strictApp, "7\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, "explicit .lt rejected", "m := import \"./pure-mod.lt\";", strictApp, "module import must omit the .lt extension");
_ws3 := fs.writeText(path.join(strictDir, "bad-importer.lt"), "s := import \"./only-script.lts\";\npub v := fn(): Int { s.val };\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, ".lt cannot import .lts", "m := import \"./bad-importer\";", strictApp, "cannot import .lts script ./only-script.lts from .lt module");
compilerTest.assertCompileRunTsNamed(root, tsComp, ".lt comptime and var decls ok", "m := import \"./pure-mod\"; io := import \"core/io\"; io.outputLine(m.base, m.readBase(), m.readCache());", strictApp, "3 3 init\n");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, ".lt rejects top-level assignment", "var cache := \"\";\ncache = \"x\";\n", path.join(strictDir, "bad-assign.lt"), "top-level assignment is not allowed in .lt module");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, ".lt rejects top-level call", "io := import \"core/io\";\nio.outputLine(1);\n", path.join(strictDir, "bad-call.lt"), "top-level runtime statement is not allowed in .lt module");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, ".lt rejects top-level if", "if true { x := 1; }\n", path.join(strictDir, "bad-if.lt"), "top-level runtime statement is not allowed in .lt module");
compilerTest.assertCompileErrorContainsNamed(root, tsComp, ".lt rejects top-level block", "{\n  x := 1;\n}\n", path.join(strictDir, "bad-block.lt"), "top-level runtime block is not allowed in .lt module");
_rmStrict := fs.remove(strictDir);

test.done("modules/imports");
