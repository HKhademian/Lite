/* Compiler corpus, manifest graph, and TS/C/native parity suite migrated from igniter/test.ts. */

crypto := import "core/crypto";
fs := import "core/file";
list := import "core/list";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
pool := import "external/pool";
compilerBuild := import "../../tools/src/internal/compiler-build";
compilerTest := import "../../tools/src/internal/compiler-test";
corpus := import "../../tools/src/internal/corpus";
json := import "data/json";
project := import "../../tools/src/internal/project";
streams := import "../../tools/src/internal/streams";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

heavyEnv := proc.envGet("LITE_SKIP_HEAVY");
skipHeavy := heavyEnv.found and heavyEnv.value == "1";

builtTs := compilerBuild.buildCompiler(root, "ts");
test.check("build TS compiler: " + builtTs.error, builtTs.ok);
builtC := compilerBuild.buildCompiler(root, "c");
test.check("build C compiler: " + builtC.error, builtC.ok);
tsComp := builtTs.path;
cComp := builtC.path;

tsDepsField := json.findField(builtTs.jsonText, 0, "dependencies");
test.check("ts deps present", tsDepsField.found);
tsDeps := corpus.readStringListAt(builtTs.jsonText, tsDepsField.valuePos);
cDepsField := json.findField(builtC.jsonText, 0, "dependencies");
test.check("c deps present", cDepsField.found);
cDeps := corpus.readStringListAt(builtC.jsonText, cDepsField.valuePos);

/* compiler manifests name graph roots and no flattened source bundle */
tsManifestSrc := fs.readText(path.join(root, "compiler/manifests/ts.json")).text;
cManifestSrc := fs.readText(path.join(root, "compiler/manifests/c.json")).text;
test.checkText("ts manifest target", "ts", json.readFieldString(tsManifestSrc, 0, "target").value);
test.checkText("c manifest target", "c", json.readFieldString(cManifestSrc, 0, "target").value);
test.checkInt("ts manifest 1 file", 1, corpus.readStringListAt(tsManifestSrc, json.findField(tsManifestSrc, 0, "files").valuePos).length());
test.checkInt("c manifest 1 file", 1, corpus.readStringListAt(cManifestSrc, json.findField(cManifestSrc, 0, "files").valuePos).length());
test.check("ts deps > 1", tsDeps.length() > 1);
test.check("c deps > 1", cDeps.length() > 1);
test.checkText("ts root dep", "lib/lite/compiler/ts-root.lts", tsDeps[0]);
test.checkText("c root dep", "lib/lite/compiler/c-root.lts", cDeps[0]);
test.check("ts deps include frontend", tsDeps.contains("lib/lite/compiler/frontend.lt"));
test.check("c deps include frontend", cDeps.contains("lib/lite/compiler/frontend.lt"));
frontendModules: List<String> = [
    "lib/lite/compiler/frontend-ir.lt",
    "lib/lite/compiler/builtins-abi.lt",
    "lib/lite/compiler/frontend-syntax.lt",
    "lib/lite/compiler/frontend-types.lt",
    "lib/lite/compiler/trace-safety.lt",
    "lib/lite/compiler/reachability.lt",
    "lib/lite/compiler/frontend-inference.lt",
    "lib/lite/compiler/frontend-context.lt",
    "lib/lite/compiler/frontend-expr.lt",
    "lib/lite/compiler/comptime-eval.lt",
];
loop frontendModules as modPath {
    test.check("ts deps include " + modPath, tsDeps.contains(modPath));
    test.check("c deps include " + modPath, cDeps.contains(modPath));
}

/* compiler verification cases are well-formed and cover both categories */
/* restricted compiler corpus keeps 69 program and 25 rejection cases */
compDir := path.join(root, "igniter/tests/compiler");
fixFiles := path.collectFiles(compDir, [compDir], ".json", [], false);
fixCount := fixFiles.length();
test.checkInt("corpus fixture count", 94, fixCount);

refJson := fs.readText(path.join(root, "compiler/tests/references/generated/current-artifacts.json")).text;
refArtField := json.findField(refJson, 0, "artifacts");
refArtOffsets := json.arrayOffsets(refJson, refArtField.valuePos);

mut fixNames: List<String> = [];
mut fixCats: List<String> = [];
mut fixSlugs: List<String> = [];
mut fixCaseKeys: List<String> = [];
var progCount := 0;
var rejCount := 0;

tmpWorkRes := fs.makeTempDir("lite-corpus-test-");
test.check("makeTempDir", tmpWorkRes.ok);
workDir := tmpWorkRes.path;

mut progStdinFiles: List<String> = [];
mut progExpOuts: List<String> = [];
mut progExpErrs: List<String> = [];
mut progExpExits: List<Int> = [];
emptyBytes: List<Int> = [];

var fi := 0;
loop fi < fixCount {
    absFix := fixFiles[fi];
    fileName := path.baseName(absFix);
    pFn := corpus.parseFixtureFilename(fileName);
    test.check("valid fixture filename: " + fileName, pFn.ok);
    fixJson := fs.readText(absFix).text;
    srcField := json.findField(fixJson, 0, "source");
    srcText := String.fromUtf8Strict(streams.readStreamBytes(fixJson, srcField.valuePos, compDir));
    test.check("fixture UTF-8 source: " + fileName, srcText.ok);

    mut fixNames.pushBack(fileName);
    mut fixCats.pushBack(pFn.category);
    mut fixSlugs.pushBack(pFn.slug);

    cField := json.findField(fixJson, 0, "cases");
    cOffs := json.arrayOffsets(fixJson, cField.valuePos);
    test.check("cases array non-empty: " + fileName, cOffs.length() > 0);
    c0 := cOffs[0];
    cName := json.readFieldString(fixJson, c0, "name").value;
    caseKey := fileName + "/" + cName;
    test.check("unique case key: " + caseKey, not fixCaseKeys.contains(caseKey));
    mut fixCaseKeys.pushBack(caseKey);

    srcTmp := path.join(workDir, "src-" + fi.toText() + ".lts");
    _ws := fs.writeText(srcTmp, srcText.text);

    inField := json.findField(fixJson, c0, "input");
    outField := json.findField(fixJson, c0, "stdout");
    errField := json.findField(fixJson, c0, "stderr");
    expExit := json.readFieldInt(fixJson, c0, "exitCode").value;
    expOut := if outField.found { String.fromUtf8Strict(streams.readStreamBytes(fixJson, outField.valuePos, compDir)).text } else { "" };
    expErr := if errField.found { String.fromUtf8Strict(streams.readStreamBytes(fixJson, errField.valuePos, compDir)).text } else { "" };
    inPath := path.join(workDir, "in-" + fi.toText() + ".bin");
    inBytes := if inField.found { streams.readStreamBytes(fixJson, inField.valuePos, compDir) } else { emptyBytes };
    _wi := fs.writeBytes(inPath, inBytes);

    if pFn.category == "program" {
        progCount = progCount + 1;
        mut progStdinFiles.pushBack(inPath);
        mut progExpOuts.pushBack(expOut);
        mut progExpErrs.pushBack(expErr);
        mut progExpExits.pushBack(expExit);
    } else {
        rejCount = rejCount + 1;
    }
    fi = fi + 1;
}
test.checkInt("program fixtures count", 69, progCount);
test.checkInt("rejection fixtures count", 25, rejCount);

/* bundle compilers reproduce every compiler case with exact artifacts and diagnostics */
/* emitted TS and igniter outputs match byte for byte across the admitted compiler corpus */
valTs := corpus.validateCorpusArtifact(root, tsComp, builtTs.sourceSha256);
test.check("validateCorpusArtifact TS failed: " + valTs.error + " " + valTs.firstMismatch, valTs.ok);
test.checkInt("corpus cases count", 94, valTs.cases);
test.checkInt("corpus programs count", 69, valTs.programs);
test.checkInt("corpus rejections count", 25, valTs.rejections);

mut cCmds: List<String> = [];
mut cArgs: List<String> = [];
var ciAll := 0;
loop ciAll < fixCount {
    mut cCmds.pushBack(proc.execPath());
    mut cArgs.pushBack("[" + json.quoteString(cComp) + ",\"--name\",\"\"," + json.quoteString(path.join(workDir, "src-" + ciAll.toText() + ".lts")) + "]");
    ciAll = ciAll + 1;
}
jobs := pool.cpuCount();
cRaw := pool.runPoolJson(cCmds, cArgs, root, jobs);
cOffs := json.arrayOffsets(cRaw, 0);
test.checkInt("c corpus compile count", fixCount, cOffs.length());

ccInfo := compilerTest.probeCc();
mut ccCmds: List<String> = [];
mut ccArgs: List<String> = [];
mut exePaths: List<String> = [];

var ri := 0;
var pSeq := 0;
loop ri < fixCount {
    pos := cOffs[ri];
    st := json.readFieldInt(cRaw, pos, "status").value;
    out := json.readFieldString(cRaw, pos, "stdout").value;
    err := json.readFieldString(cRaw, pos, "stderr").value;
    if fixCats[ri] == "rejected" {
        fixJson := fs.readText(fixFiles[ri]).text;
        cOff0 := json.arrayOffsets(fixJson, json.findField(fixJson, 0, "cases").valuePos)[0];
        outF := json.findField(fixJson, cOff0, "stdout");
        errF := json.findField(fixJson, cOff0, "stderr");
        expEx := json.readFieldInt(fixJson, cOff0, "exitCode").value;
        expOut := if outF.found { String.fromUtf8Strict(streams.readStreamBytes(fixJson, outF.valuePos, compDir)).text } else { "" };
        expErr := if errF.found { String.fromUtf8Strict(streams.readStreamBytes(fixJson, errF.valuePos, compDir)).text } else { "" };
        test.checkInt("c reject exit " + fixNames[ri], expEx, st);
        test.checkText("c reject out " + fixNames[ri], expOut, out);
        test.checkText("c reject err " + fixNames[ri], expErr, err);
    } else {
        test.checkInt("c program status " + fixNames[ri], 0, st);
        test.checkText("c program err " + fixNames[ri], "", err);
        slug := fixSlugs[ri];
        var expCHash := "";
        loop refArtOffsets as aPos {
            if json.readFieldString(refJson, aPos, "name").value == slug {
                expCHash = json.readFieldString(refJson, aPos, "c").value;
                break;
            }
        }
        test.checkText("c baseline hash " + slug, expCHash, "sha256:" + crypto.sha256Text(out));
        if ccInfo.available and not skipHeavy {
            cFile := path.join(workDir, "prog-" + pSeq.toText() + ".c");
            exeFile := path.join(workDir, "prog-" + pSeq.toText());
            _wc := fs.writeText(cFile, out);
            mut exePaths.pushBack(exeFile);
            mut ccCmds.pushBack(ccInfo.cc);
            mut ccArgs.pushBack("[\"-std=c11\",\"-Wall\",\"-Wextra\",\"-Werror\"," + json.quoteString(cFile) + ",\"-o\"," + json.quoteString(exeFile) + ",\"-lm\"]");
        }
        pSeq = pSeq + 1;
    }
    ri = ri + 1;
}

/* Lite-generated native C, TS and igniter programs have identical output bytes and status */
if ccInfo.available and not skipHeavy {
    ccRaw := pool.runPoolJson(ccCmds, ccArgs, workDir, jobs);
    ccOffs := json.arrayOffsets(ccRaw, 0);
    test.checkInt("cc pool count", progCount, ccOffs.length());
    var cci := 0;
    loop cci < progCount {
        ccSt := json.readFieldInt(ccRaw, ccOffs[cci], "status").value;
        ccErr := json.readFieldString(ccRaw, ccOffs[cci], "stderr").value;
        test.checkInt("cc compile " + cci.toText() + ": " + ccErr, 0, ccSt);

        inBytes := fs.readBytes(progStdinFiles[cci]);
        outFile := path.join(workDir, "native-" + cci.toText() + ".out");
        errFile := path.join(workDir, "native-" + cci.toText() + ".err");
        emptyEnv: List<String> = [];
        nRun := proc.runBytes(exePaths[cci], emptyEnv, workDir, emptyEnv, 5000, inBytes, outFile, errFile);
        test.check("native run err: " + nRun.error, nRun.error == "");
        test.checkInt("native status " + cci.toText(), progExpExits[cci], nRun.status);
        test.checkText("native stdout " + cci.toText(), progExpOuts[cci], fs.readText(outFile).text);
        test.checkText("native stderr " + cci.toText(), progExpErrs[cci], fs.readText(errFile).text);
        cci = cci + 1;
    }
}

/* compiler applications reject fixture sources with exact diagnostics, positions and docs before artifact output */
recErr := "1:1: unsupported feature \"record\": see docs/types-and-inference.md; the restricted compiler accepts Int/Float/String/Bool expressions, locals, output/outputLine, if/else and loop only\n";
compilerTest.assertCompileError(root, tsComp, "record TS", "record Foo { };", recErr);
compilerTest.assertCompileError(root, cComp, "record C", "record Foo { };", recErr);
missErr := "2:6: expected an Int, Float, String or Bool expression\n";
compilerTest.assertCompileError(root, tsComp, "missing TS", "x := 1;\ny := ;\n", missErr);
compilerTest.assertCompileError(root, cComp, "missing C", "x := 1;\ny := ;\n", missErr);
loopOk := compilerTest.compileStdin(root, cComp, "x := loop { break 1 };", "");
test.checkInt("loop expr C status", 0, loopOk.status);
test.checkText("loop expr C err", "", loopOk.stderr);

namedOk := compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(42);", "named source.lts");
ref42 := fs.readText(path.join(root, "compiler/tests/references/generated/report-42.ts")).text;
test.checkInt("named valid status", 0, namedOk.status);
test.checkText("named valid out", ref42, namedOk.stdout);
test.checkText("named valid err", "", namedOk.stderr);
namedBad := compilerTest.compileStdin(root, tsComp, "io := import \"core/io\"; io.outputLine(1 +);", "named source.lts");
test.checkInt("named err status", 2, namedBad.status);
test.checkText("named err out", "", namedBad.stdout);
test.checkText("named err stderr", "named source.lts:1:42: expected an Int, Float, String or Bool expression\n", namedBad.stderr);

_rm := fs.remove(workDir);
