/* The same restricted report compiler, emitting standalone C. */
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

skipSpaces := fn(source: String, start: Int): Int {
    size := textLength(source);
    var position := start;
    loop position < size and (textAt(source, position) == " " or textAt(source, position) == "\t" or textAt(source, position) == "\r" or textAt(source, position) == "\n") {
        position = position + 1;
    }
    position
}

expectSymbol := fn(source: String, position: Int, symbol: String, prefix: String): Int {
    if position >= textLength(source) or textAt(source, position) =!= symbol {
        reportError(prefix + "expected " + symbol);
        exit(2);
    }
    position + 1
}

normalizeInteger := fn(digits: String, negative: Bool, prefix: String): String {
    size := textLength(digits);
    var start := 0;
    loop start + 1 < size and textAt(digits, start) == "0" {
        start = start + 1;
    }
    magnitude := textSlice(digits, start, size);
    count := textLength(magnitude);
    limit := if negative { "9223372036854775808" } else { "9223372036854775807" }
    if count > 19 {
        reportError(prefix + "integer literal outside signed 64-bit range");
        exit(2);
    }
    if count == 19 {
        var position := 0;
        loop position < count {
            value := digitValue(textAt(magnitude, position));
            maximum := digitValue(textAt(limit, position));
            if value < maximum { break; }
            if value > maximum {
                reportError(prefix + "integer literal outside signed 64-bit range");
                exit(2);
            }
            position = position + 1;
        }
    }
    if negative and magnitude =!= "0" { "-" + magnitude } else { magnitude }
}

var prefix := "";
var argumentCount := 0;
loop inputArgs() as argument {
    if argumentCount == 0 { prefix = argument + ": "; }
    argumentCount = argumentCount + 1;
}
if argumentCount > 1 {
    reportError("expected at most one logical source name argument");
    exit(2);
}
source := inputAll();
size := textLength(source);
integers: mut List<String> = [];
var position := skipSpaces(source, 0);
if position == size {
    reportError(prefix + "expected report(integer)");
    exit(2);
}
loop position < size {
    if position + 6 > size or textSlice(source, position, position + 6) =!= "report" {
        reportError(prefix + "expected report(integer)");
        exit(2);
    }
    position = skipSpaces(source, position + 6);
    position = expectSymbol(source, position, "(", prefix);
    position = skipSpaces(source, position);
    var negative := false;
    if position < size and (textAt(source, position) == "+" or textAt(source, position) == "-") {
        negative = textAt(source, position) == "-";
        position = skipSpaces(source, position + 1);
    }
    start := position;
    loop position < size and isDigit(textAt(source, position)) {
        position = position + 1;
    }
    if start == position {
        reportError(prefix + "expected a decimal integer literal");
        exit(2);
    }
    digits := textSlice(source, start, position);
    position = skipSpaces(source, position);
    position = expectSymbol(source, position, ")", prefix);
    position = skipSpaces(source, position);
    if position < size and textAt(source, position) == ";" {
        position = skipSpaces(source, position + 1);
    }
    push_back(mut integers, normalizeInteger(digits, negative, prefix));
}
report("#include <stdio.h>");
report("int main(void) {");
var content := "";
loop integers as item {
    content = content + item + "\\n";
}
report("    return fputs(\"" + content + "\", stdout) == EOF ? 1 : 0;");
report("}");
