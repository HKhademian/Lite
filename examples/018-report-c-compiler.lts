/* The same restricted report compiler, emitting standalone C. */
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

digitValue := fn(text: String): Int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    9
}

skipSpaces := fn(line: String, start: Int): Int {
    size := textLength(line);
    var position := start;
    loop position < size and (textAt(line, position) == " " or textAt(line, position) == "\t") {
        position = position + 1;
    }
    position
}

expectSymbol := fn(line: String, position: Int, symbol: String): Int {
    if position >= textLength(line) or textAt(line, position) =!= symbol {
        reportError("expected " + symbol);
        exit(2);
    }
    position + 1
}

normalizeInteger := fn(digits: String, negative: Bool): String {
    size := textLength(digits);
    var start := 0;
    loop start + 1 < size and textAt(digits, start) == "0" {
        start = start + 1;
    }
    magnitude := textSlice(digits, start, size);
    count := textLength(magnitude);
    limit := if negative { "9223372036854775808" } else { "9223372036854775807" }
    if count > 19 {
        reportError("integer literal outside signed 64-bit range");
        exit(2);
    }
    if count == 19 {
        var position := 0;
        loop position < count {
            value := digitValue(textAt(magnitude, position));
            maximum := digitValue(textAt(limit, position));
            if value < maximum { break; }
            if value > maximum {
                reportError("integer literal outside signed 64-bit range");
                exit(2);
            }
            position = position + 1;
        }
    }
    if negative and magnitude =!= "0" { "-" + magnitude } else { magnitude }
}

line := inputLine();
size := textLength(line);
var position := skipSpaces(line, 0);
if position + 6 > size or textSlice(line, position, position + 6) =!= "report" {
    reportError("expected report(integer)");
    exit(2);
}
position = skipSpaces(line, position + 6);
position = expectSymbol(line, position, "(");
position = skipSpaces(line, position);
var negative := false;
if position < size and (textAt(line, position) == "+" or textAt(line, position) == "-") {
    negative = textAt(line, position) == "-";
    position = skipSpaces(line, position + 1);
}
start := position;
loop position < size and isDigit(textAt(line, position)) {
    position = position + 1;
}
if start == position {
    reportError("expected a decimal integer literal");
    exit(2);
}
digits := textSlice(line, start, position);
position = skipSpaces(line, position);
position = expectSymbol(line, position, ")");
position = skipSpaces(line, position);
if position < size and textAt(line, position) == ";" {
    position = skipSpaces(line, position + 1);
}
if position =!= size {
    reportError("unsupported trailing source");
    exit(2);
}
integer := normalizeInteger(digits, negative);
report("#include <stdio.h>");
report("int main(void) {");
report("    return fputs(\"" + integer + "\\n\", stdout) == EOF ? 1 : 0;");
report("}");
