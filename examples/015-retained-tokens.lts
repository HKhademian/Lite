/* Tokenize first, then traverse the retained tokens. */
isDigit := fn(text: String): Bool {
    or text == "0" or text == "1" or text == "2" or text == "3" or text == "4"
    or text == "5" or text == "6" or text == "7" or text == "8" or text == "9"
}

tokenize := fn(line: String): List<(kind: String, text: String)> {
    tokens: mut List<(kind: String, text: String)> = [];
    size := textLength(line);
    var position := 0;
    loop position < size {
        ch := textAt(line, position);
        if ch == " " or ch == "\t" {
            position = position + 1;
            continue;
        }
        if isDigit(ch) {
            start := position;
            position = position + 1;
            loop position < size and isDigit(textAt(line, position)) {
                position = position + 1;
            }
            push_back(mut tokens, (kind = "number", text = textSlice(line, start, position)));
            continue;
        }
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "(" or ch == ")" {
            push_back(mut tokens, (kind = "symbol", text = ch));
            position = position + 1;
            continue;
        }
        reportError("unsupported symbol: " + ch);
        exit(2);
    }
    tokens
}

report("Arithmetic expression:");
tokens := tokenize(inputLine());
loop tokens as token {
    report(token.kind, token.text);
}
