{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite.lang/schemas/gym.schema.json",
  "title": "Language Gym Exercise Catalog",
  "type": "object",
  "required": ["schemaVersion", "title", "description", "exercises"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "mode",
          "belt",
          "domain",
          "subGroup",
          "promptFile",
          "starterFile",
          "solutionFile",
          "brokenStarterSyntax",
          "expectedStarterFailure",
          "hints",
          "relatedDocs",
          "relatedLessons",
          "visibleCases",
          "hiddenCases"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["drill", "kata"] },
          "belt": { "type": "string", "enum": ["white", "amber", "emerald", "obsidian"] },
          "domain": { "type": "string", "minLength": 1 },
          "subGroup": { "type": "string", "minLength": 1 },
          "promptFile": { "type": "string", "minLength": 1 },
          "starterFile": { "type": "string", "minLength": 1 },
          "solutionFile": { "type": "string", "minLength": 1 },
          "brokenStarterSyntax": { "type": "boolean" },
          "expectedStarterFailure": { "type": "string", "enum": ["compile-error", "wrong-output"] },
          "hints": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "relatedDocs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "relatedLessons": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "visibleCases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/testCase" }
          },
          "hiddenCases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/testCase" }
          }
        }
      }
    }
  },
  "$defs": {
    "testCase": {
      "type": "object",
      "required": ["name", "stdin", "args", "expectedStdout"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "stdin": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "expectedStdout": { "type": "string" }
      }
    }
  }
}
