{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite.lang/schemas/learn.schema.json",
  "title": "Language Learn Curriculum Catalog",
  "type": "object",
  "required": ["schemaVersion", "title", "description", "tracks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "summary", "lessons"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "slug",
                "title",
                "kind",
                "domain",
                "subGroup",
                "environment",
                "guideFile",
                "sourceFile",
                "helperModules",
                "stdin",
                "args",
                "teaches",
                "docs"
              ],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
                "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["lesson", "tutorial"] },
                "domain": { "type": "string", "minLength": 1 },
                "subGroup": { "type": "string", "minLength": 1 },
                "environment": { "type": "string", "enum": ["universal", "play", "cli"] },
                "guideFile": { "type": "string", "minLength": 1 },
                "sourceFile": { "type": "string", "minLength": 1 },
                "helperModules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["spec", "file"],
                    "additionalProperties": false,
                    "properties": {
                      "spec": { "type": "string", "minLength": 1 },
                      "file": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "stdin": { "type": "string" },
                "args": { "type": "array", "items": { "type": "string" } },
                "teaches": { "type": "array", "items": { "type": "string" } },
                "docs": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
