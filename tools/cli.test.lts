/** Routed aliases and direct operation commands must share behavior. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
pool := import "external/pool";
compilerBuild := import "./src/internal/compiler-build";
compilerTest := import "./src/internal/compiler-test";
json := import "data/json";
project := import "./src/internal/project";

rawRoot := project.findRepoRoot();
test.check("repo root found", rawRoot =!= "");
root := fs.realPath(rawRoot).path;

CmdResult := alias (status: Int, stdout: String, stderr: String);

runIn := fn(exe: String, args: List<String>, cwd: String, timeoutMs: Int): CmdResult {
    tmpRes := fs.makeTempDir("lite-cli-t-");
    test.check("runIn makeTempDir: " + tmpRes.error, tmpRes.ok);
    outPath := path.join(tmpRes.path, "out");
    errPath := path.join(tmpRes.path, "err");
    emptyEnv: List<String> = [];
    emptyBytes: List<Int> = [];
    res := proc.runBytes(exe, args, cwd, emptyEnv, timeoutMs, emptyBytes, outPath, errPath);
    test.check("runIn process error: " + res.error, res.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    _rm := fs.remove(tmpRes.path);
    (status = res.status, stdout = outText, stderr = errText)
};

command := fn(name: String, args: List<String>): CmdResult {
    mut cmdArgs: List<String> = [path.join(path.join(root, "bin"), name)];
    loop args as a {
        mut cmdArgs.pushBack(a);
    }
    runIn(proc.execPath(), cmdArgs, root, 60000)
};

assertSameCmd := fn(label: String, expected: CmdResult, actual: CmdResult): Unit {
    test.checkInt(label + " status (expected err=" + expected.stderr + ", actual err=" + actual.stderr + ")", expected.status, actual.status);
    test.checkText(label + " stdout", expected.stdout, actual.stdout);
    test.checkText(label + " stderr", expected.stderr, actual.stderr);
};

isHex12 := fn(s: String): Bool {
    if s.length() =!= 12 { return false; }
    var i := 0;
    loop i < 12 {
        ch := s.at(i);
        if "0123456789abcdef".indexOf(ch, 0) < 0 { return false; }
        i = i + 1;
    }
    true
};

stripShebang := fn(s: String): String {
    if not s.startsWithAt(0, "#!") { return s; }
    nl := s.indexOf("\n", 0);
    if nl < 0 { return ""; }
    s.slice(nl + 1, s.length())
};

copyRepoTree := fn(dstRoot: String, relPath: String): Unit {
    mut stack: List<String> = [relPath];
    loop stack.length() > 0 {
        rel := mut stack.popBack();
        src := path.join(root, rel);
        dst := path.join(dstRoot, rel);
        rp := fs.realPath(src);
        if rp.ok and rp.path =!= src {
            test.check("mkdir symlink parent " + rel, fs.makeDir(path.parentDir(dst)).ok);
            relTarget := path.relative(path.parentDir(src), rp.path);
            sl := fs.symlink(relTarget, dst);
            test.check("symlink " + rel + ": " + sl.error, sl.ok);
        } else if fs.kind(src) == fs.FILE_KIND_DIR {
            test.check("mkdir dir " + rel, fs.makeDir(dst).ok);
            entries := fs.listDir(src);
            loop entries as entry {
                mut stack.pushBack(rel + "/" + entry);
            }
        } else {
            test.check("mkdir file parent " + rel, fs.makeDir(path.parentDir(dst)).ok);
            cp := fs.copy(src, dst);
            test.check("copy " + rel + ": " + cp.error, cp.ok);
        }
    }
};

/* 1. lite compile routes through the compiler router to its TypeScript target */
sample := "language/examples/foundations/io/double-sum.lts";
expectedTs := command("lite-compile-ts", [sample]);
assertSameCmd("lite compile", expectedTs, command("lite", ["compile", sample]));
assertSameCmd("lite --compile", expectedTs, command("lite", ["--compile", sample]));
assertSameCmd("lite-compile", expectedTs, command("lite-compile", [sample]));
assertSameCmd("lite-compile ts", expectedTs, command("lite-compile", ["ts", sample]));
assertSameCmd("lite-compile --target ts", expectedTs, command("lite-compile", ["--target", "ts", sample]));
assertSameCmd("lite-compile --target=ts", expectedTs, command("lite-compile", ["--target=ts", sample]));
assertSameCmd("lite-compile-ts --target ts", expectedTs, command("lite-compile-ts", ["--target", "ts", sample]));
assertSameCmd("lite-compile-ts --target=ts", expectedTs, command("lite-compile-ts", ["--target=ts", sample]));

expectedC := command("lite-compile-c", [sample]);
assertSameCmd("lite-compile --target c", expectedC, command("lite-compile", ["--target", "c", sample]));
assertSameCmd("lite-compile --target=c", expectedC, command("lite-compile", ["--target=c", sample]));

/* 2. lite verify routes case manifests to the verifier command */
assertSameCmd(
"lite verify",
command("lite-verify", ["tools/cases/tooling/fixtures/proposal.fixture.json"]),
command("lite", ["verify", "tools/cases/tooling/fixtures/proposal.fixture.json"])
);

/* 3. lite test routes case mode to the tester command */
assertSameCmd(
"lite test --cases",
command("lite-test", ["--cases", "tools/cases/tooling/fixtures/proposal.fixture.json"]),
command("lite", ["test", "--cases", "tools/cases/tooling/fixtures/proposal.fixture.json"])
);

/* 4. lite test --unit runs parallel .test.lts unit tests and validates flags */
unitRes := command("lite", ["test", "--unit", "--jobs", "2", "--verbose", "compiler-smoke"]);
test.checkInt("lite test --unit status: " + unitRes.stderr, 0, unitRes.status);
test.check("lite test --unit PASS line", unitRes.stdout.indexOf("PASS compiler/tests/compiler-smoke.test.lts", 0) >= 0);
test.check("lite test --unit summary", unitRes.stdout.indexOf("Unit tests: 1 passed, 0 failed.", 0) >= 0);
assertSameCmd(
"lite test --unit --mute",
command("lite-test", ["--unit", "--mute", "compiler-smoke"]),
command("lite", ["test", "--unit", "--mute", "compiler-smoke"])
);
badJobs := command("lite", ["test", "--unit", "--jobs", "0"]);
test.checkInt("lite test --unit --jobs 0 status", 2, badJobs.status);
test.check("lite test --unit --jobs 0 usage", badJobs.stderr.startsWithAt(0, "Usage: ./bin/lite test --unit"));

/* 5. lite doctor routes to the standalone repository checker */
assertSameCmd("lite doctor --docs", command("lite-doctor", ["--docs"]), command("lite", ["doctor", "--docs"]));

/* 6. component versions belong to their tool commands */
assertSameCmd("verify --version", command("lite-verify", ["--version"]), command("lite", ["verify", "--version"]));
assertSameCmd("doctor --version", command("lite-doctor", ["--version"]), command("lite", ["doctor", "--version"]));
assertSameCmd("check --version", command("lite-check", ["--version"]), command("lite", ["check", "--version"]));
assertSameCmd("docs --version", command("lite-docs", ["--version"]), command("lite", ["docs", "--version"]));
assertSameCmd("bench --version", command("lite-bench", ["--version"]), command("lite", ["bench", "--version"]));
assertSameCmd("bootstrap --version", command("lite-bootstrap", ["--version"]), command("lite", ["bootstrap", "--version"]));
assertSameCmd("bootstrap --help", command("lite-bootstrap", ["--help"]), command("lite", ["bootstrap", "--help"]));

/* 7. lite check routes through ./bin/lite to the standalone checker */
checkExpected := command("lite-check", [sample]);
assertSameCmd("lite check", checkExpected, command("lite", ["check", sample]));
test.checkInt("lite-check status", 0, checkExpected.status);

/* 8. ignited tool artifacts match their Lite sources and pass strict TS checking */
ignitedAllRes := runIn(proc.execPath(), [path.join(root, "bin/lite-ignite"), "--check", "--json"], root, 180000);
test.checkInt("lite-ignite --check --json status: " + ignitedAllRes.stderr, 0, ignitedAllRes.status);
chkField := json.readFieldBool(ignitedAllRes.stdout, 0, "checked");
test.check("igniteAllTools checked == true", chkField.found and chkField.ok and chkField.value);

tsComp := compilerBuild.selectCompilerPath(root, "ts");
test.check("select ts compiler", tsComp.ok);
toolNames: List<String> = [
"cli", "compile", "compile-c", "compile-ts", "checker", "check", "run",
"run-ts-artifact", "verify", "test-runner", "test", "bench", "bootstrap", "ci", "release", "ignite"
];
o3DirRes := fs.makeTempDir("lite-cli-o3-");
test.check("o3Dir makeTempDir: " + o3DirRes.error, o3DirRes.ok);
o3Dir := o3DirRes.path;
mut o3Cmds: List<String> = [];
mut o3ArgsJson: List<String> = [];
mut o3OutFiles: List<String> = [];
loop toolNames as name {
    srcRel := "tools/src/" + name + ".lts";
    outTs := path.join(o3Dir, name + ".ts");
    mut o3OutFiles.pushBack(outTs);
    mut o3Cmds.pushBack(proc.execPath());
    argJson := "["
    + json.quoteString(tsComp.path) + ","
    + "\"-O3\","
    + json.quoteString(srcRel) + ","
    + "\"--out\","
    + json.quoteString(outTs)
    + "]";
    mut o3ArgsJson.pushBack(argJson);
}
o3Raw := pool.runPoolJson(o3Cmds, o3ArgsJson, root, pool.cpuCount());
o3Offsets := json.arrayOffsets(o3Raw, 0);
o3Count := toolNames.length();
test.checkInt("o3 pool count", o3Count, o3Offsets.length());
var compiledIgniteTs := "";
var ti := 0;
loop ti < o3Count {
    name := toolNames[ti];
    srcRel := "tools/src/" + name + ".lts";
    elemPos := o3Offsets[ti];
    stRes := json.readFieldInt(o3Raw, elemPos, "status");
    errRes := json.readFieldString(o3Raw, elemPos, "stderr");
    pErrRes := json.readFieldString(o3Raw, elemPos, "error");
    pErr := if pErrRes.found and pErrRes.ok { pErrRes.value } else { "" };
    cErr := if errRes.found and errRes.ok { errRes.value } else { "" };
    cStatus := if stRes.found and stRes.ok { stRes.value } else { -1 };
    test.check("o3 pool error " + srcRel + ": " + pErr, pErr == "");
    test.checkInt("compile " + srcRel + ": " + cErr, 0, cStatus);
    outRead := fs.readText(o3OutFiles[ti]);
    test.check("read compiled " + srcRel, outRead.ok);
    if name == "ignite" { compiledIgniteTs = outRead.text; }
    hasC := fs.kind(path.join(root, "dist/tools/" + name)) == fs.FILE_KIND_FILE;
    hasTs := fs.kind(path.join(root, "dist/tools/" + name + ".ts")) == fs.FILE_KIND_FILE;
    test.check("ignited artifact exists for " + name, hasC or hasTs);
    if hasTs {
        genRead := fs.readText(path.join(root, "dist/tools/" + name + ".ts"));
        test.check("read dist/tools/" + name + ".ts", genRead.ok);
        test.checkText(name + " artifact out of date", outRead.text, genRead.text);
    }
    ti = ti + 1;
}
_rmO3 := fs.remove(o3Dir);
trackedIgniter := stripShebang(fs.readText(path.join(root, "compiler/bootstrap/igniter.ts")).text);
test.checkText("compiler/bootstrap/igniter.ts out of date", compiledIgniteTs, trackedIgniter);

/* 9. lite router help, version, and unknown command handling match exit and output contracts */
help := command("lite", ["help"]);
test.checkInt("lite help status", 0, help.status);
test.check("lite help usage", help.stdout.startsWithAt(0, "Usage: ./bin/lite <command> [options]"));
assertSameCmd("lite --help", help, command("lite", ["--help"]));
assertSameCmd("lite -h", help, command("lite", ["-h"]));

missing := command("lite", []);
test.checkInt("lite missing status", 2, missing.status);
test.checkText("lite missing stdout", "", missing.stdout);
test.checkText("lite missing stderr", help.stdout, missing.stderr);

cliIsC := fs.kind(path.join(root, "dist/tools/cli")) == fs.FILE_KIND_FILE;
version := command("lite", ["--version"]);
test.checkInt("lite --version status", 0, version.status);
test.check("lite --version header", version.stdout.startsWithAt(0, "lite cli "));
test.check("lite --version kind", version.stdout.indexOf(if cliIsC { "\nkind: ignited-c (target: c)\n" } else { "\nkind: ignited-ts (target: ts)\n" }, 0) >= 0);
vArtNeedle := if cliIsC { "artifact: dist/tools/cli (sha256: " } else { "artifact: dist/tools/cli.ts (sha256: " };
vArtIdx := version.stdout.indexOf(vArtNeedle, 0);
test.check("lite --version artifact", vArtIdx >= 0);
test.check("lite --version sha12", isHex12(version.stdout.slice(vArtIdx + vArtNeedle.length(), vArtIdx + vArtNeedle.length() + 12)));
test.check("lite --version source", version.stdout.indexOf("source: tools/src/cli.lts (", 0) >= 0);
test.check("lite --version built-by", version.stdout.indexOf(" modules, built-by: ", 0) >= 0);
test.check("lite --version host", version.stdout.indexOf(if cliIsC { "host: c11 (" } else { "host: node v" }, 0) >= 0);

versionJson := command("lite", ["--version", "--json"]);
test.checkInt("lite --version --json status: " + versionJson.stderr, 0, versionJson.status);
test.checkText("version json command", "lite cli", json.readFieldString(versionJson.stdout, 0, "command").value);
test.checkText("version json component", "cli", json.readFieldString(versionJson.stdout, 0, "component").value);
test.checkText("version json kind", if cliIsC { "ignited-c" } else { "ignited-ts" }, json.readFieldString(versionJson.stdout, 0, "kind").value);
test.checkText("version json artifact", if cliIsC { "dist/tools/cli" } else { "dist/tools/cli.ts" }, json.readFieldString(versionJson.stdout, 0, "artifact").value);
test.checkText("version json source", "tools/src/cli.lts", json.readFieldString(versionJson.stdout, 0, "source").value);

igniterVer := command("lite-ignite", ["--version"]);
test.checkInt("lite-ignite --version status: " + igniterVer.stderr, 0, igniterVer.status);
test.check("lite-ignite --version header", igniterVer.stdout.startsWithAt(0, "lite-ignite "));
test.check("lite-ignite --version kind", igniterVer.stdout.indexOf("\nkind: bootstrap-igniter-ts (target: ts)\n", 0) >= 0);
iArtNeedle := "artifact: compiler/bootstrap/igniter.ts (sha256: ";
iArtIdx := igniterVer.stdout.indexOf(iArtNeedle, 0);
test.check("lite-ignite --version artifact", iArtIdx >= 0);
test.check("lite-ignite --version sha12", isHex12(igniterVer.stdout.slice(iArtIdx + iArtNeedle.length(), iArtIdx + iArtNeedle.length() + 12)));

/* 10. munching routers, flag aliases, and direct generated entrypoints converge on identical output */
fmtTarget := "tools/src/fmt.lts";
expectedFmt := command("lite-fmt", ["--check", fmtTarget]);
test.checkInt("lite-fmt --check status", 0, expectedFmt.status);
assertSameCmd("lite fmt --check", expectedFmt, command("lite", ["fmt", "--check", fmtTarget]));
assertSameCmd("lite --fmt --check", expectedFmt, command("lite", ["--fmt", "--check", fmtTarget]));
assertSameCmd("lite -- fmt --check", expectedFmt, command("lite", ["--", "fmt", "--check", fmtTarget]));
directFmt := if fs.kind(path.join(root, "dist/tools/fmt")) == fs.FILE_KIND_FILE {
    runIn(path.join(root, "dist/tools/fmt"), ["--check", fmtTarget], root, 60000)
} else {
    runIn(proc.execPath(), [path.join(root, "dist/tools/fmt.ts"), "--check", fmtTarget], root, 60000)
};
assertSameCmd("direct dist/tools/fmt", expectedFmt, directFmt);

/* 11. ignition rebuilds missing, tampered, and dependency-changed tools into dist/tools */
test.check("no tools/generated dir", fs.kind(path.join(root, "tools/generated")) == fs.FILE_KIND_MISSING);
probeDirRes := fs.makeTempDir("lite-ignite-probe-");
test.check("probeDir makeTempDir", probeDirRes.ok);
probeDir := probeDirRes.path;
probePaths: List<String> = [
"package.json", "config/versions.json", "bin/lite", "bin/lite-fmt", "bin/lite-ignite",
"compiler/package.json", "lib/lite", "compiler/manifests",
"compiler/bootstrap/igniter", "compiler/bootstrap/igniter.ts", "compiler/bootstrap/seed.ts",
"igniter/artifacts.ts", "igniter/package.json", "igniter/tsconfig.json",
"tools/src/cli.lts", "tools/src/fmt.lts", "tools/src/internal", "lib/$preload.lt", "lib/type", "lib/core", "lib/data"
];
loop probePaths as rel {
    copyRepoTree(probeDir, rel);
}

checkToolsRebuilt := fn(label: String, jsonText: String, expCli: Bool, expFmt: Bool): Unit {
    toolsField := json.findField(jsonText, 0, "tools");
    test.check(label + " has tools", toolsField.found);
    offs := json.arrayOffsets(jsonText, toolsField.valuePos);
    test.checkInt(label + " tool count", 2, offs.length());
    test.checkText(label + " [0].name", "cli", json.readFieldString(jsonText, offs[0], "name").value);
    test.check(label + " [0].rebuilt", json.readFieldBool(jsonText, offs[0], "rebuilt").value == expCli);
    test.checkText(label + " [1].name", "fmt", json.readFieldString(jsonText, offs[1], "name").value);
    test.check(label + " [1].rebuilt", json.readFieldBool(jsonText, offs[1], "rebuilt").value == expFmt);
};

firstIg := runIn(proc.execPath(), [path.join(probeDir, "compiler/bootstrap/igniter.ts"), "--json", "cli", "fmt"], probeDir, 60000);
test.checkInt("first ignite: " + firstIg.stderr, 0, firstIg.status);
checkToolsRebuilt("first ignite", firstIg.stdout, true, true);
test.check("dist/tools/fmt.ts created", fs.kind(path.join(probeDir, "dist/tools/fmt.ts")) == fs.FILE_KIND_FILE);

secondIg := runIn(proc.execPath(), [path.join(probeDir, "compiler/bootstrap/igniter.ts"), "--json", "cli", "fmt"], probeDir, 60000);
test.checkInt("second ignite: " + secondIg.stderr, 0, secondIg.status);
checkToolsRebuilt("second ignite", secondIg.stdout, false, false);

test.check("tamper fmt.ts", fs.writeText(path.join(probeDir, "dist/tools/fmt.ts"), "// tampered\n").ok);
repaired := runIn(proc.execPath(), [path.join(probeDir, "bin/lite"), "fmt", "--check", "tools/src/fmt.lts"], probeDir, 60000);
test.checkInt("repaired fmt: " + repaired.stderr, 0, repaired.status);
test.check("tamper removed", fs.readText(path.join(probeDir, "dist/tools/fmt.ts")).text.indexOf("// tampered", 0) < 0);

cliLibPath := path.join(probeDir, "tools/src/internal/cli.lt");
test.check("touch cli.lt", fs.writeText(cliLibPath, fs.readText(cliLibPath).text + "\n").ok);
afterDep := runIn(proc.execPath(), [path.join(probeDir, "compiler/bootstrap/igniter.ts"), "--json", "cli", "fmt"], probeDir, 60000);
test.checkInt("afterDep ignite: " + afterDep.stderr, 0, afterDep.status);
checkToolsRebuilt("afterDep ignite", afterDep.stdout, true, false);

projLibPath := path.join(probeDir, "tools/src/internal/project.lt");
test.check("touch project.lt", fs.writeText(projLibPath, fs.readText(projLibPath).text + "\n").ok);
afterShared := runIn(proc.execPath(), [path.join(probeDir, "compiler/bootstrap/igniter.ts"), "--json", "cli", "fmt"], probeDir, 60000);
test.checkInt("afterShared ignite: " + afterShared.stderr, 0, afterShared.status);
checkToolsRebuilt("afterShared ignite", afterShared.stdout, true, true);

_rmDist := fs.remove(path.join(probeDir, "dist"));
igAllProbe := runIn(proc.execPath(), [path.join(probeDir, "bin/lite-ignite"), "--json"], probeDir, 60000);
test.checkInt("lite-ignite all: " + igAllProbe.stderr, 0, igAllProbe.status);
test.check("dist/bootstrap/compiler.ts created", fs.kind(path.join(probeDir, "dist/bootstrap/compiler.ts")) == fs.FILE_KIND_FILE);
test.check("dist/tools/cli.ts created", fs.kind(path.join(probeDir, "dist/tools/cli.ts")) == fs.FILE_KIND_FILE);
test.check("dist/tools/fmt.ts created after rm", fs.kind(path.join(probeDir, "dist/tools/fmt.ts")) == fs.FILE_KIND_FILE);
_rmProbe := fs.remove(probeDir);

/* 12. lite-wipe removes untracked/ignored files in a Git checkout and re-ignites dist artifacts */
wipeDirRes := fs.makeTempDir("lite-wipe-probe-");
test.check("wipeDir makeTempDir", wipeDirRes.ok);
wipeDir := wipeDirRes.path;
wipePaths: List<String> = [
".gitignore", "config", "compiler/manifests", "compiler/bootstrap",
"lib", "site/src", "tools/src", "bin/lite", "bin/lite-ignite", "bin/lite-wipe"
];
loop wipePaths as rel {
    copyRepoTree(wipeDir, rel);
}

test.check("write stray.txt", fs.writeText(path.join(wipeDir, "stray.txt"), "keep").ok);
nonGit := runIn(proc.execPath(), [path.join(wipeDir, "bin/lite-wipe"), "--no-install"], wipeDir, 60000);
test.check("nonGit wipe fails", nonGit.status =!= 0);
test.check("nonGit wipe msg: " + nonGit.stderr, nonGit.stderr.indexOf("--wipe requires a Git checkout", 0) >= 0);
test.check("stray.txt kept", fs.kind(path.join(wipeDir, "stray.txt")) == fs.FILE_KIND_FILE);

_rmStray := fs.remove(path.join(wipeDir, "stray.txt"));
test.checkInt("git init", 0, runIn("git", ["init"], wipeDir, 30000).status);
test.checkInt("git email", 0, runIn("git", ["config", "user.email", "test@example.com"], wipeDir, 30000).status);
test.checkInt("git name", 0, runIn("git", ["config", "user.name", "Test"], wipeDir, 30000).status);
test.checkInt("git add", 0, runIn("git", ["add", "-A"], wipeDir, 30000).status);
test.checkInt("git commit", 0, runIn("git", ["-c", "commit.gpgsign=false", "commit", "-m", "initial"], wipeDir, 30000).status);

test.check("write untracked stray.txt", fs.writeText(path.join(wipeDir, "stray.txt"), "untracked").ok);
test.check("mkdir .cache", fs.makeDir(path.join(wipeDir, ".cache")).ok);
test.check("write .cache/old.txt", fs.writeText(path.join(wipeDir, ".cache/old.txt"), "stale").ok);
test.check("mkdir dist/stale", fs.makeDir(path.join(wipeDir, "dist/stale")).ok);
test.check("write dist/stale/old.txt", fs.writeText(path.join(wipeDir, "dist/stale/old.txt"), "stale").ok);
test.check("mkdir tmp", fs.makeDir(path.join(wipeDir, "tmp")).ok);
test.check("write tmp/scratch.txt", fs.writeText(path.join(wipeDir, "tmp/scratch.txt"), "stale").ok);
test.check("mkdir igniter/node_modules/pkg", fs.makeDir(path.join(wipeDir, "igniter/node_modules/pkg")).ok);
test.check("write igniter/node_modules/pkg/index.js", fs.writeText(path.join(wipeDir, "igniter/node_modules/pkg/index.js"), "stale").ok);

wiped := runIn(proc.execPath(), [path.join(wipeDir, "bin/lite-wipe"), "--no-install", "--json"], wipeDir, 120000);
test.checkInt("lite-wipe status: " + wiped.stderr, 0, wiped.status);
test.check("stray.txt deleted", fs.kind(path.join(wipeDir, "stray.txt")) == fs.FILE_KIND_MISSING);
test.check(".cache deleted", fs.kind(path.join(wipeDir, ".cache")) == fs.FILE_KIND_MISSING);
test.check("dist/stale deleted", fs.kind(path.join(wipeDir, "dist/stale")) == fs.FILE_KIND_MISSING);
test.check("tmp deleted", fs.kind(path.join(wipeDir, "tmp")) == fs.FILE_KIND_MISSING);
test.check("igniter/node_modules deleted", fs.kind(path.join(wipeDir, "igniter/node_modules")) == fs.FILE_KIND_MISSING);
test.check("wipe compiler.ts", fs.kind(path.join(wipeDir, "dist/bootstrap/compiler.ts")) == fs.FILE_KIND_FILE);
test.check("wipe cli artifact", fs.kind(path.join(wipeDir, "dist/tools/cli")) == fs.FILE_KIND_FILE or fs.kind(path.join(wipeDir, "dist/tools/cli.ts")) == fs.FILE_KIND_FILE);
test.check("wipe ignite artifact", fs.kind(path.join(wipeDir, "dist/tools/ignite")) == fs.FILE_KIND_FILE or fs.kind(path.join(wipeDir, "dist/tools/ignite.ts")) == fs.FILE_KIND_FILE);

wipeChecked := json.readFieldBool(wiped.stdout, 0, "checked");
test.check("wipe checked == false", wipeChecked.found and wipeChecked.ok and not wipeChecked.value);
wipeToolsField := json.findField(wiped.stdout, 0, "tools");
test.check("wipe has tools", wipeToolsField.found);
wipeToolOffs := json.arrayOffsets(wiped.stdout, wipeToolsField.valuePos);
test.check("wipe tools count > 0", wipeToolOffs.length() > 0);
loop wipeToolOffs as tOff {
    reb := json.readFieldBool(wiped.stdout, tOff, "rebuilt");
    test.check("wipe tool rebuilt", reb.found and reb.ok and reb.value);
}
_rmWipe := fs.remove(wipeDir);

/* 13. zero-Node C-only ignition probe via single-igniter symlink indirection */
ccEnv := proc.envGet("CC");
ccBin := if ccEnv.found and ccEnv.value =!= "" { ccEnv.value } else { "cc" };
ccProbe := runIn(ccBin, ["--version"], root, 15000);
if ccProbe.status == 0 {
    cProbeDirRes := fs.makeTempDir("lite-c-only-probe-");
    test.check("cProbeDir makeTempDir", cProbeDirRes.ok);
    cProbeDir := cProbeDirRes.path;
    cProbePaths: List<String> = [
    "package.json", "config/versions.json", "lib/lite", "compiler/manifests",
    "compiler/bootstrap/compiler.c", "compiler/bootstrap/seed.ts",
    "tools/src/ignite.lts", "tools/src/cli.lts", "tools/src/fmt.lts",
    "lib/$preload.lt", "lib/type", "lib/core", "lib/data", "tools/src/internal", "lib/external"
    ];
    loop cProbePaths as rel {
        copyRepoTree(cProbeDir, rel);
    }
    test.check("c-only probe omits igniter.ts", fs.kind(path.join(cProbeDir, "compiler/bootstrap/igniter.ts")) == fs.FILE_KIND_MISSING);

    distBootDir := path.join(cProbeDir, "dist/bootstrap");
    test.check("mkdir c-only dist/bootstrap", fs.makeDir(distBootDir).ok);
    cBootCompiler := path.join(distBootDir, "compiler-c");
    cBootBuild := runIn(ccBin, ["-std=c11", "-O0", path.join(cProbeDir, "compiler/bootstrap/compiler.c"), "-o", cBootCompiler, "-lm"], cProbeDir, 60000);
    test.checkInt("compile c-only bootstrap compiler: " + cBootBuild.stderr, 0, cBootBuild.status);

    cIgniteSrc := path.join(distBootDir, "igniter-c.c");
    cEmitIgnite := runIn(cBootCompiler, ["-O1", path.join(cProbeDir, "tools/src/ignite.lts"), "--out", cIgniteSrc], cProbeDir, 60000);
    test.checkInt("emit c-only igniter: " + cEmitIgnite.stderr, 0, cEmitIgnite.status);

    cIgniterBin := path.join(distBootDir, "igniter-c");
    cCompileIgnite := runIn(ccBin, ["-std=c11", "-O1", cIgniteSrc, "-o", cIgniterBin, "-lm"], cProbeDir, 60000);
    test.checkInt("compile c-only igniter: " + cCompileIgnite.stderr, 0, cCompileIgnite.status);
    _rmCIgnSrc := fs.remove(cIgniteSrc);

    slBoot := fs.symlink("../../dist/bootstrap/igniter-c", path.join(cProbeDir, "compiler/bootstrap/igniter"));
    test.check("symlink c-only igniter: " + slBoot.error, slBoot.ok);
    test.check("mkdir c-only bin", fs.makeDir(path.join(cProbeDir, "bin")).ok);
    slLite := fs.symlink("../compiler/bootstrap/igniter", path.join(cProbeDir, "bin/lite"));
    test.check("symlink c-only bin/lite: " + slLite.error, slLite.ok);
    slFmt := fs.symlink("../compiler/bootstrap/igniter", path.join(cProbeDir, "bin/lite-fmt"));
    test.check("symlink c-only bin/lite-fmt: " + slFmt.error, slFmt.ok);
    slIgn := fs.symlink("../compiler/bootstrap/igniter", path.join(cProbeDir, "bin/lite-ignite"));
    test.check("symlink c-only bin/lite-ignite: " + slIgn.error, slIgn.ok);

    cVer := runIn(path.join(cProbeDir, "bin/lite-ignite"), ["--version"], cProbeDir, 30000);
    test.checkInt("c-only lite-ignite --version: " + cVer.stderr, 0, cVer.status);
    test.check("c-only --version reports bootstrap-igniter-c: " + cVer.stdout, cVer.stdout.contains("bootstrap-igniter-c"));
    test.check("c-only --version reports target c: " + cVer.stdout, cVer.stdout.contains("(target: c)"));

    cIg := runIn(path.join(cProbeDir, "bin/lite-ignite"), ["--target", "c", "--json", "cli", "fmt"], cProbeDir, 120000);
    test.checkInt("c-only lite-ignite cli fmt: " + cIg.stderr, 0, cIg.status);
    checkToolsRebuilt("c-only ignite", cIg.stdout, true, true);
    test.check("c-only dist/tools/cli exists", fs.kind(path.join(cProbeDir, "dist/tools/cli")) == fs.FILE_KIND_FILE);
    test.check("c-only dist/tools/fmt exists", fs.kind(path.join(cProbeDir, "dist/tools/fmt")) == fs.FILE_KIND_FILE);
    test.check("c-only dist/tools/cli.ts absent", fs.kind(path.join(cProbeDir, "dist/tools/cli.ts")) == fs.FILE_KIND_MISSING);
    test.check("c-only dist/tools/fmt.ts absent", fs.kind(path.join(cProbeDir, "dist/tools/fmt.ts")) == fs.FILE_KIND_MISSING);
    test.check("c-only dist/bootstrap/compiler.ts absent", fs.kind(path.join(cProbeDir, "dist/bootstrap/compiler.ts")) == fs.FILE_KIND_MISSING);

    cFmt := runIn(path.join(cProbeDir, "bin/lite"), ["fmt", "--check", "tools/src/fmt.lts"], cProbeDir, 60000);
    test.checkInt("c-only bin/lite fmt --check: " + cFmt.stderr, 0, cFmt.status);

    _rmCProbe := fs.remove(cProbeDir);
}
