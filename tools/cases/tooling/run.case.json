{
  "id": "tooling.run",
  "kind": "tool",
  "tool": "lite-run",
  "features": [
    "tooling.run"
  ],
  "cases": [
    {
      "name": "interactive-input",
      "args": [
        "language/examples/001-double-sum.lts"
      ],
      "stdin": {
        "text": "7\n5\n"
      },
      "stdout": {
        "text": "First integer: Second integer: 24\n"
      },
      "stderr": {
        "text": ""
      },
      "exitCode": 0
    },
    {
      "name": "forwarded-arguments",
      "args": [
        "language/examples/020-script-arguments.lts",
        "--",
        "a b",
        "",
        "--check"
      ],
      "stdin": {
        "text": ""
      },
      "stdout": {
        "text": "a b\n\n--check\n"
      },
      "stderr": {
        "text": ""
      },
      "exitCode": 0
    },
    {
      "name": "propagated-status",
      "args": [
        "language/examples/004-factorial.lts"
      ],
      "stdin": {
        "text": "-1\n"
      },
      "stdout": {
        "text": "Nonnegative integer: "
      },
      "stderr": {
        "text": "expected a nonnegative integer\n"
      },
      "exitCode": 2
    },
    {
      "name": "rejection",
      "args": [
        "language/cases/reject-effects.lts"
      ],
      "stdin": {
        "text": ""
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": "language/cases/reject-effects.lts:4:1: unknown value unknown_name\n"
      },
      "exitCode": 2
    },
    {
      "name": "missing-source",
      "args": [
        "tools/cases/absent.lts"
      ],
      "stdin": {
        "text": ""
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": "lite run: cannot read tools/cases/absent.lts\n"
      },
      "exitCode": 2
    },
    {
      "name": "non-script-source",
      "args": [
        "README.md"
      ],
      "stdin": {
        "text": ""
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": "lite run: source must be a .lts file\n"
      },
      "exitCode": 2
    },
    {
      "name": "check-hint",
      "args": [
        "--check",
        "language/examples/001-double-sum.lts"
      ],
      "stdin": {
        "text": ""
      },
      "stdout": {
        "text": ""
      },
      "stderr": {
        "text": "lite run: --check is ./bin/lite check file.lts\n"
      },
      "exitCode": 2
    }
  ]
}
