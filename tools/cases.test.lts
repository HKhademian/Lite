/** Shared schema boundaries and the maintained declarative command suite. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
json := import "util/json";
project := import "util/project";

root := project.findRepoRoot();
test.check("repo root found", root =!= "");

/* declarative tool and language cases preserve their recorded contracts */
workRes := fs.makeTempDir("lite-test-summary-");
test.check("makeTempDir: " + workRes.error, workRes.ok);
work := workRes.path;
summaryPath := path.join(work, "summary.json");
outPath := path.join(work, "out");
errPath := path.join(work, "err");

emptyBytes: List<Int> = [];
args: List<String> = [path.join(root, "bin/lite-test"), "--cases"];
envOver: List<String> = ["LITE_TEST_SUMMARY_FILE=" + summaryPath];
res := proc.runBytes(proc.execPath(), args, root, envOver, 180000, emptyBytes, outPath, errPath);
test.check("lite-test --cases process error: " + res.error, res.error == "");

sumRead := fs.readText(summaryPath);
test.check("summary.json created (exit status " + json.quoteString(fs.readText(errPath).text) + ")", sumRead.ok);

failuresRes := json.readObjectInt(sumRead.text, 0, "failures");
countRes := json.readObjectInt(sumRead.text, 0, "count");
test.check("summary has failures", failuresRes.found and failuresRes.ok);
test.check("summary has count", countRes.found and countRes.ok);
test.checkInt("declarative case failures", 0, failuresRes.value);
test.check("declarative case count > 0", countRes.value > 0);
test.checkInt("declarative cases exit status", 0, res.status);

_rm := fs.remove(work);
