/** CLI routing, argument validation, and dual-target compilation tests for `lite bootstrap`. */

fs := import "core/file";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
compilerBuild := import "util/compiler-build";
compilerTest := import "util/compiler-test";
project := import "util/project";

rawRoot := project.findRepoRoot();
test.check("repo root found", rawRoot =!= "");
root := fs.realPath(rawRoot).path;

CmdResult := type (status: Int, stdout: String, stderr: String);

runCmd := fn(args: List<String>): CmdResult {
    tmpRes := fs.makeTempDir("lite-boot-test-");
    test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
    outPath := path.join(tmpRes.path, "out");
    errPath := path.join(tmpRes.path, "err");
    emptyEnv: List<String> = [];
    emptyBytes: List<Int> = [];
    res := proc.runBytes(project.nodeExecPath(), args, root, emptyEnv, 60000, emptyBytes, outPath, errPath);
    test.check("process error: " + res.error, res.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    _rm := fs.remove(tmpRes.path);
    (status = res.status, stdout = outText, stderr = errText)
};

runBin := fn(binName: String, subArgs: List<String>): CmdResult {
    args: mut List<String> = [path.join(path.join(root, "bin"), binName)];
    loop subArgs as a {
        mut args.pushBack(a);
    }
    runCmd(args)
};

assertSameCmd := fn(label: String, expected: CmdResult, actual: CmdResult): Unit {
    test.checkInt(label + " status", expected.status, actual.status);
    test.checkText(label + " stdout", expected.stdout, actual.stdout);
    test.checkText(label + " stderr", expected.stderr, actual.stderr);
};

/* 1. Help variants succeed on stdout and match between lite-bootstrap and lite bootstrap */
helpDirect := runBin("lite-bootstrap", ["--help"]);
test.checkInt("lite-bootstrap --help status: " + helpDirect.stderr, 0, helpDirect.status);
test.check("usage header", helpDirect.stdout.contains("Usage: ./bin/lite bootstrap <verify|promote>"));
test.check("usage mentions verify", helpDirect.stdout.contains("verify"));
test.check("usage mentions promote", helpDirect.stdout.contains("promote"));
test.checkText("lite-bootstrap --help stderr", "", helpDirect.stderr);

assertSameCmd("lite bootstrap --help", helpDirect, runBin("lite", ["bootstrap", "--help"]));
assertSameCmd("lite bootstrap -h", helpDirect, runBin("lite", ["bootstrap", "-h"]));
assertSameCmd("lite bootstrap help", helpDirect, runBin("lite", ["bootstrap", "help"]));

/* 2. Version parity between direct symlink and router */
verDirect := runBin("lite-bootstrap", ["--version"]);
test.checkInt("lite-bootstrap --version status: " + verDirect.stderr, 0, verDirect.status);
test.check("version contains lite-bootstrap", verDirect.stdout.contains("lite-bootstrap"));
assertSameCmd("lite bootstrap --version", verDirect, runBin("lite", ["bootstrap", "--version"]));

/* 3. Argument validation rejections exit 2 with usage on stderr */
missingSub := runBin("lite", ["bootstrap"]);
test.checkInt("missing subcommand status", 2, missingSub.status);
test.check("missing subcommand stderr", missingSub.stderr.contains("subcommand required"));

unknownSub := runBin("lite", ["bootstrap", "bogus"]);
test.checkInt("unknown subcommand status", 2, unknownSub.status);
test.check("unknown subcommand stderr", unknownSub.stderr.contains("unknown subcommand bogus"));

unknownFlag := runBin("lite", ["bootstrap", "verify", "--nope"]);
test.checkInt("unknown flag status", 2, unknownFlag.status);
test.check("unknown flag stderr", unknownFlag.stderr.contains("unknown option --nope"));

missingCc := runBin("lite", ["bootstrap", "verify", "--cc"]);
test.checkInt("missing --cc value status", 2, missingCc.status);
test.check("missing --cc value stderr", missingCc.stderr.contains("missing compiler path after --cc"));

/* 4. tools/src/bootstrap.lts compiles cleanly on both TS and C11 compilers */
srcFile := path.join(root, "tools/src/bootstrap.lts");
selTs := compilerBuild.selectCompilerPath(root, "ts");
test.check("select ts compiler: " + selTs.error, selTs.ok);
tsRes := compilerTest.compileFile(selTs.path, root, [srcFile]);
test.checkInt("compile bootstrap.lts to ts: " + tsRes.stderr, 0, tsRes.status);

selC := compilerBuild.selectCompilerPath(root, "c");
test.check("select c compiler: " + selC.error, selC.ok);
cRes := compilerTest.compileFile(selC.path, root, [srcFile]);
test.checkInt("compile bootstrap.lts to c: " + cRes.stderr, 0, cRes.status);

test.done("bootstrap");
