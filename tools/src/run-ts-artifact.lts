/** Strict-typechecks and runs an emitted TS artifact with fixed stdin and no timeout (`compiler/scripts/run-ts-artifact.ts`). */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
path := import "core/path";
json := import "data/json";
project := import "util/project";
cases := import "util/cases";

splitNonEmptyCsv := fn(raw: String): List<String> {
    mut out: List<String> = [];
    size := raw.length();
    if size == 0 { return out; }
    var start := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        if atEnd or raw.at(i) == "," {
            if i > start {
                mut out.pushBack(raw.slice(start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    out
};

run := fn(rawArgs: List<String>): Unit {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        io.exit(1);
    }

    mut args: List<String> = rawArgs;
    if args.length() > 0 and args[0] == "--" {
        _sep := mut args.popFront();
    }

    var hasArt := false;
    var artVal := "";
    var hasOut := false;
    var outVal := "";
    var hasSrc := false;
    var srcVal := "";
    var hasErr := false;
    var errVal := "";
    var hasArgs := false;
    var argsVal := "";
    var noCheck := false;

    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--no-check" {
            noCheck = true;
        } else if arg == "--artifact" {
            if hasArt or args.length() == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasArt = true;
            artVal = mut args.popFront();
        } else if arg == "--out" {
            if hasOut or args.length() == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasOut = true;
            outVal = mut args.popFront();
        } else if arg == "--source" {
            if hasSrc or args.length() == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasSrc = true;
            srcVal = mut args.popFront();
        } else if arg == "--err" {
            if hasErr or args.length() == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasErr = true;
            errVal = mut args.popFront();
        } else if arg == "--args" {
            if hasArgs or args.length() == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasArgs = true;
            argsVal = mut args.popFront();
        } else {
            io.errorLine("unexpected argument: " + arg);
            io.exit(64);
        }
    }

    if not hasArt {
        io.errorLine("missing --artifact");
        io.exit(64);
    }
    if not hasOut {
        io.errorLine("missing --out");
        io.exit(64);
    }

    cwd := proc.cwd();
    artifact := path.resolve(cwd, artVal);
    outPath := path.resolve(cwd, outVal);
    errPath := if hasErr { path.resolve(cwd, errVal) } else { outPath + ".err" };
    extraArgs := if hasArgs { splitNonEmptyCsv(argsVal) } else { args };

    tmpRes := fs.makeTempDir("lite-self-host-");
    if not tmpRes.ok {
        io.errorLine(tmpRes.error);
        io.exit(1);
    }
    work := tmpRes.path;

    artifactPath := path.join(work, "artifact.ts");
    copyArt := fs.copy(artifact, artifactPath);
    if not copyArt.ok {
        _rm := fs.remove(work);
        io.errorLine(copyArt.error);
        io.exit(1);
    }
    pkgWrite := fs.writeText(path.join(work, "package.json"), "{\"type\":\"module\"}\n");
    if not pkgWrite.ok {
        _rm := fs.remove(work);
        io.errorLine(pkgWrite.error);
        io.exit(1);
    }
    runnerPath := path.join(work, "runner.ts");
    runnerCode := "import { main } from './artifact.ts';\nimport { writeSync } from 'node:fs';\nconst tok = {}; let code = 0; const origExit = process.exit;\n(process as unknown as { exit: (c?: number) => never }).exit = (c?: number): never => { code = c ?? 0; throw tok; };\ntry { process.stdout.write(main((text: string): void => { writeSync(1, text); })); }\ncatch (e) { if (e === tok) process.exitCode = code; else throw e; }\nfinally { process.exit = origExit; }\n";
    runWrite := fs.writeText(runnerPath, runnerCode);
    if not runWrite.ok {
        _rm := fs.remove(work);
        io.errorLine(runWrite.error);
        io.exit(1);
    }

    if not noCheck {
        checked := cases.checkTsArtifactFileWithStatus(root, artifactPath, path.join(work, "tsc"), 0);
        if not checked.ok {
            _wErr := fs.writeText(errPath, checked.error);
            _rm := fs.remove(work);
            exitStatus := if checked.status > 0 { checked.status } else { 1 };
            io.errorLine("{\"phase\":\"typecheck\",\"status\":" + exitStatus.toText() + ",\"err\":" + json.quoteString(errPath) + "}");
            io.exit(exitStatus);
        }
    }

    emptyBytes: List<Int> = [];
    stdinBytes := if hasSrc { fs.readBytes(path.resolve(cwd, srcVal)) } else { emptyBytes };
    mut cmdArgs: List<String> = [runnerPath];
    loop extraArgs as a {
        mut cmdArgs.pushBack(a);
    }
    tempOutPath := path.join(work, "run.stdout");
    tempErrPath := path.join(work, "run.stderr");
    emptyEnv: List<String> = [];

    runRes := proc.runBytes(project.nodeExecPath(), cmdArgs, "", emptyEnv, 0, stdinBytes, tempOutPath, tempErrPath);
    if runRes.error =!= "" {
        _rm := fs.remove(work);
        io.errorLine(runRes.error);
        io.exit(1);
    }

    outBytesCount := fs.readBytes(tempOutPath).length();
    errBytesCount := fs.readBytes(tempErrPath).length();
    cpOut := fs.copy(tempOutPath, outPath);
    if not cpOut.ok {
        _rm := fs.remove(work);
        io.errorLine(cpOut.error);
        io.exit(1);
    }
    cpErr := fs.copy(tempErrPath, errPath);
    if not cpErr.ok {
        _rm := fs.remove(work);
        io.errorLine(cpErr.error);
        io.exit(1);
    }
    _rm := fs.remove(work);

    summary := "{\"phase\":\"run\",\"status\":" + runRes.status.toText()
    + ",\"signal\":null,\"out\":" + json.quoteString(outPath)
    + ",\"outBytes\":" + outBytesCount.toText()
    + ",\"err\":" + json.quoteString(errPath)
    + ",\"errBytes\":" + errBytesCount.toText() + "}";
    io.errorLine(summary);
    io.exit(runRes.status);
};

run(io.inputArgs());
