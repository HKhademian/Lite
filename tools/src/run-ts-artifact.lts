/** Strict-typechecks and runs an emitted TS artifact with fixed stdin and no timeout (`compiler/scripts/run-ts-artifact.ts`). */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
integer := import "core/int";
text := import "core/text";
list := import "core/list";
path := import "core/path";
json := import "util/json";
project := import "util/project";
cases := import "util/cases";

splitNonEmptyCsv := fn(raw: String): List<String> {
    out: mut List<String> = [];
    size := text.length(raw);
    if size == 0 { return out; }
    var start := 0;
    var i := 0;
    loop i <= size {
        atEnd := i == size;
        if atEnd or text.at(raw, i) == "," {
            if i > start {
                list.pushBack(mut out, text.slice(raw, start, i));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    out
};

run := fn(rawArgs: List<String>): Unit {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        io.exit(1);
    }

    args: mut List<String> = rawArgs;
    if list.listCountText(args) > 0 and args[0] == "--" {
        _sep := list.popFront(mut args);
    }

    var hasArt := false;
    var artVal := "";
    var hasOut := false;
    var outVal := "";
    var hasSrc := false;
    var srcVal := "";
    var hasErr := false;
    var errVal := "";
    var hasArgs := false;
    var argsVal := "";
    var noCheck := false;

    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--no-check" {
            noCheck = true;
        } else if arg == "--artifact" {
            if hasArt or list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasArt = true;
            artVal = list.popFront(mut args);
        } else if arg == "--out" {
            if hasOut or list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasOut = true;
            outVal = list.popFront(mut args);
        } else if arg == "--source" {
            if hasSrc or list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasSrc = true;
            srcVal = list.popFront(mut args);
        } else if arg == "--err" {
            if hasErr or list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasErr = true;
            errVal = list.popFront(mut args);
        } else if arg == "--args" {
            if hasArgs or list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("invalid option value");
                io.exit(64);
            }
            hasArgs = true;
            argsVal = list.popFront(mut args);
        } else {
            io.errorLine("unexpected argument: " + arg);
            io.exit(64);
        }
    }

    if not hasArt {
        io.errorLine("missing --artifact");
        io.exit(64);
    }
    if not hasOut {
        io.errorLine("missing --out");
        io.exit(64);
    }

    cwd := proc.cwd();
    artifact := path.resolve(cwd, artVal);
    outPath := path.resolve(cwd, outVal);
    errPath := if hasErr { path.resolve(cwd, errVal) } else { outPath + ".err" };
    extraArgs := if hasArgs { splitNonEmptyCsv(argsVal) } else { args };

    tmpRes := fs.makeTempDir("lite-self-host-");
    if not tmpRes.ok {
        io.errorLine(tmpRes.error);
        io.exit(1);
    }
    work := tmpRes.path;

    artifactPath := path.join(work, "artifact.ts");
    copyArt := fs.copy(artifact, artifactPath);
    if not copyArt.ok {
        _rm := fs.remove(work);
        io.errorLine(copyArt.error);
        io.exit(1);
    }
    pkgWrite := fs.writeText(path.join(work, "package.json"), "{\"type\":\"module\"}\n");
    if not pkgWrite.ok {
        _rm := fs.remove(work);
        io.errorLine(pkgWrite.error);
        io.exit(1);
    }
    runnerPath := path.join(work, "runner.ts");
    runnerCode := "import { main } from './artifact.ts';\nimport { writeSync } from 'node:fs';\nprocess.stdout.write(main((text: string): void => { writeSync(1, text); }));\n";
    runWrite := fs.writeText(runnerPath, runnerCode);
    if not runWrite.ok {
        _rm := fs.remove(work);
        io.errorLine(runWrite.error);
        io.exit(1);
    }

    if not noCheck {
        checked := cases.checkTsArtifactFileWithStatus(root, artifactPath, path.join(work, "tsc"), 0);
        if not checked.ok {
            _wErr := fs.writeText(errPath, checked.error);
            _rm := fs.remove(work);
            exitStatus := if checked.status > 0 { checked.status } else { 1 };
            io.errorLine("{\"phase\":\"typecheck\",\"status\":" + integer.intText(exitStatus) + ",\"err\":" + json.quoteString(errPath) + "}");
            io.exit(exitStatus);
        }
    }

    emptyBytes: List<Int> = [];
    stdinBytes := if hasSrc { fs.readBytes(path.resolve(cwd, srcVal)) } else { emptyBytes };
    cmdArgs: mut List<String> = [runnerPath];
    loop extraArgs as a {
        list.pushBack(mut cmdArgs, a);
    }
    tempOutPath := path.join(work, "run.stdout");
    tempErrPath := path.join(work, "run.stderr");
    emptyEnv: List<String> = [];

    runRes := proc.runBytes(project.nodeExecPath(), cmdArgs, "", emptyEnv, 0, stdinBytes, tempOutPath, tempErrPath);
    if runRes.error =!= "" {
        _rm := fs.remove(work);
        io.errorLine(runRes.error);
        io.exit(1);
    }

    outBytesCount := list.listCountInt(fs.readBytes(tempOutPath));
    errBytesCount := list.listCountInt(fs.readBytes(tempErrPath));
    cpOut := fs.copy(tempOutPath, outPath);
    if not cpOut.ok {
        _rm := fs.remove(work);
        io.errorLine(cpOut.error);
        io.exit(1);
    }
    cpErr := fs.copy(tempErrPath, errPath);
    if not cpErr.ok {
        _rm := fs.remove(work);
        io.errorLine(cpErr.error);
        io.exit(1);
    }
    _rm := fs.remove(work);

    summary := "{\"phase\":\"run\",\"status\":" + integer.intText(runRes.status)
    + ",\"signal\":null,\"out\":" + json.quoteString(outPath)
    + ",\"outBytes\":" + integer.intText(outBytesCount)
    + ",\"err\":" + json.quoteString(errPath)
    + ",\"errBytes\":" + integer.intText(errBytesCount) + "}";
    io.errorLine(summary);
    io.exit(runRes.status);
};

run(io.inputArgs());
