/** Standalone declarative case test runner (`lite test --cases` / `lite verify FILE.json`). */

io := import "core/io";
project := import "./internal/project";
cases := import "./internal/cases";

run := fn(rawArgs: List<String>): Unit {
    io.exit(cases.runCaseCli(project.findRepoRoot(), rawArgs));
};

run(io.inputArgs());
