/** Challenge benchmark dataset validator (`benchmark/challenges/tools/validate_benchmark.ts`). */

io := import "core/io";
project := import "./internal/project";
challenges := import "./internal/challenges";

run := fn(): Int {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    challenges.runValidateBenchmarkCommand(root)
};

io.exit(run());
