/** CLI entrypoint generating `/learn/` section pages, payloads, and search entries JSON (`site/learn-pages.ts`). */

io := import "core/io";
siteLearn := import "../../site/src/learn";

run := fn(): Unit {
    stdinRes := io.readAllText(io.stdinReader());
    if not stdinRes.ok {
        io.errorLine(stdinRes.error);
        io.exit(1);
    }
    res := siteLearn.buildLearnPayloadJson(stdinRes.text);
    if not res.ok {
        io.errorLine(res.error);
        io.exit(1);
    }
    io.output(res.jsonText);
};

run();
