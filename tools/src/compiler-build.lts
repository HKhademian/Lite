/** Selects and builds generated TS compiler and TS-hosted C emitter metadata (`compiler/scripts/build.ts`). */

io := import "core/io";
project := import "./internal/project";
compilerBuild := import "./internal/compiler-build";
corpus := import "./internal/corpus";

run := fn(rawArgs: List<String>): Int {
    mut args: List<String> = rawArgs;
    var root := "";
    var target := "";
    var manifestPath := "";
    var hasTarget := false;
    var hasManifest := false;

    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--root" {
            if args.length() == 0 {
                io.errorLine("Usage: compiler-build [--root DIR] [--target ts|c | --manifest FILE]");
                return 2;
            }
            root = mut args.popFront();
        } else if arg == "--target" {
            if args.length() == 0 or hasManifest {
                io.errorLine("Usage: compiler-build [--root DIR] [--target ts|c | --manifest FILE]");
                return 2;
            }
            target = mut args.popFront();
            hasTarget = true;
        } else if arg == "--manifest" {
            if args.length() == 0 or hasTarget {
                io.errorLine("Usage: compiler-build [--root DIR] [--target ts|c | --manifest FILE]");
                return 2;
            }
            manifestPath = mut args.popFront();
            hasManifest = true;
        } else {
            io.errorLine("Usage: compiler-build [--root DIR] [--target ts|c | --manifest FILE]");
            return 2;
        }
    }

    if hasManifest {
        man := compilerBuild.validateManifestFile(manifestPath);
        if not man.ok {
            io.errorLine(man.error);
            return 1;
        }
        io.outputLine(man.jsonText);
        return 0;
    }

    resolvedRoot := if root =!= "" { root } else { project.findRepoRoot() };
    if resolvedRoot == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    if hasTarget {
        built := compilerBuild.buildCompiler(resolvedRoot, target);
        if not built.ok {
            io.errorLine(built.error);
            return 1;
        }
        io.outputLine(built.jsonText);
        return 0;
    }
    corpus.runCompilerBuildCommand(resolvedRoot)
};

io.exit(run(io.inputArgs()));
