/** Standalone TS compiler command (`lite-compile-ts`); selects the active compiler and invokes it directly. */

io := import "core/io";
fs := import "core/file";
list := import "core/list";
text := import "core/text";
cli := import "util/cli";
project := import "util/project";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite-compile-ts [--builtin-mode SPEC]... file.lts");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    if list.listCountText(rawArgs) == 1 and cli.head(rawArgs) == "--version" {
        io.outputLine("lite-compile-ts " + project.readComponentVersion("compiler"));
        io.exit(0);
    }

    if not cli.validCompilerOptions(rawArgs, false) {
        usageExit();
    }

    var args := cli.withoutCompilerOptions(rawArgs, false);
    if list.listCountText(args) >= 2 and args[0] == "--target" and args[1] == "ts" {
        args = cli.rest(args, 2);
    } else if cli.head(args) == "--target=ts" {
        args = cli.rest(args, 1);
    }

    args = cli.stripLeadingSeparator(args);
    if list.listCountText(args) =!= 1 {
        usageExit();
    }
    source := args[0];
    if not text.endsWith(source, ".lts") {
        usageExit();
    }
    if fs.kind(source) =!= fs.FILE_KIND_FILE {
        io.errorLine("lite-compile-ts: cannot read " + source);
        io.exit(2);
    }

    sel := project.selectCompilerPath(project.findRepoRoot(), "ts");
    if not sel.ok {
        io.errorLine("lite-compile-ts: " + sel.error);
        io.exit(1);
    }
    forwardArgs: mut List<String> = [];
    loop cli.compilerOptions(rawArgs, false) as opt {
        list.pushBack(mut forwardArgs, opt);
    }
    list.pushBack(mut forwardArgs, source);
    io.exit(project.runCompilerArtifact(sel.path, forwardArgs));
};

run(io.inputArgs());
