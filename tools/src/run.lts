/** Compile one script to a temporary artifact, execute it with the Node entry, and forward its status. */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
text := import "core/text";
list := import "core/list";
path := import "core/path";
project := import "util/project";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite run [--builtin-mode SPEC]... file.lts [-- argument ...]");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    args: mut List<String> = rawArgs;
    builtinOpts: mut List<String> = [];
    var scriptPath := "";
    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--" {
            if list.listCountText(args) == 0 { usageExit(); }
            scriptPath = list.popFront(mut args);
            break;
        } else if arg == "--builtin-mode" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            list.pushBack(mut builtinOpts, arg);
            list.pushBack(mut builtinOpts, list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--builtin-mode=") {
            list.pushBack(mut builtinOpts, arg);
        } else {
            scriptPath = arg;
            break;
        }
    }

    if scriptPath == "" {
        usageExit();
    }
    if scriptPath == "--check" {
        io.errorLine("lite run: --check is ./bin/lite check file.lts");
        io.exit(2);
    }
    if text.startsWithAt(scriptPath, 0, "-") {
        io.errorLine("lite run: unknown option " + scriptPath);
        usageExit();
    }
    if not text.endsWith(scriptPath, ".lts") {
        io.errorLine("lite run: source must be a .lts file");
        io.exit(2);
    }

    if list.listCountText(args) > 0 and args[0] == "--" {
        _sep := list.popFront(mut args);
    }
    if fs.kind(scriptPath) =!= fs.FILE_KIND_FILE {
        io.errorLine("lite run: cannot read " + scriptPath);
        io.exit(2);
    }

    root := project.findRepoRoot();
    sel := project.selectCompilerPath(root, "ts");
    if not sel.ok {
        io.errorLine("lite run: " + sel.error);
        io.exit(1);
    }
    emptyEnv: List<String> = [];

    compileArgs: mut List<String> = [sel.path];
    loop builtinOpts as opt {
        list.pushBack(mut compileArgs, opt);
    }
    list.pushBack(mut compileArgs, scriptPath);
    compiled := proc.run(proc.execPath(), compileArgs, "", emptyEnv, true, "");
    if compiled.error =!= "" {
        io.errorLine("lite run: " + compiled.error);
        io.exit(1);
    }
    if compiled.status =!= 0 {
        project.errorText(compiled.stderr);
        io.exit(compiled.status);
    }

    tempDir := fs.makeTempDir("lite-run-");
    if not tempDir.ok {
        io.errorLine("lite run: " + tempDir.error);
        io.exit(1);
    }

    base := path.baseName(scriptPath);
    baseNoExt := text.slice(base, 0, text.length(base) - 4);
    artifact := path.join(tempDir.path, baseNoExt + ".ts");
    writeRes := fs.writeText(artifact, compiled.stdout);
    if not writeRes.ok {
        fs.remove(tempDir.path);
        io.errorLine("lite run: " + writeRes.error);
        io.exit(1);
    }

    runnerPath := path.join(tempDir.path, "runner.ts");
    runnerCode :=
    "import { writeSync } from 'node:fs';\n" +
    "import { main } from './" + baseNoExt + ".ts';\n" +
    "process.argv = [process.execPath, process.argv[1]!, ...process.argv.slice(2)];\n" +
    "const out = main((text: string): void => { writeSync(1, text); });\n" +
    "if (typeof out === 'string' && out.length > 0) writeSync(1, out);\n";
    runWr := fs.writeText(runnerPath, runnerCode);
    if not runWr.ok {
        fs.remove(tempDir.path);
        io.errorLine("lite run: " + runWr.error);
        io.exit(1);
    }

    entryArgs: mut List<String> = [runnerPath];
    loop args as arg {
        list.pushBack(mut entryArgs, arg);
    }
    execRes := proc.run(proc.execPath(), entryArgs, "", emptyEnv, false, "");
    fs.remove(tempDir.path);

    if execRes.error =!= "" {
        io.errorLine("lite run: " + execRes.error);
        io.exit(1);
    }
    io.exit(execRes.status);
};

run(io.inputArgs());
