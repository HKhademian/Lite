/** Compile one script to a temporary artifact, execute it with the Node entry, and forward its status. */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
text := import "core/text";
integer := import "core/int";
list := import "core/list";
path := import "core/path";
project := import "util/project";
compilerBuild := import "util/compiler-build";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite run [--target ts|c] [-O0|-O1|-O2|-O3] [--builtin-mode SPEC]... [--play [--scale N] [--fps N|--uncap] [--capture PNG]] file.lts [-- argument ...]");
    io.exit(2);
};

parsePosInt := fn(raw: String): Int {
    n := text.length(raw);
    if n == 0 { return 0; }
    var acc := 0;
    var i := 0;
    loop i < n {
        ch := text.at(raw, i);
        d := if ch == "0" { 0 } else if ch == "1" { 1 } else if ch == "2" { 2 }
        else if ch == "3" { 3 } else if ch == "4" { 4 } else if ch == "5" { 5 }
        else if ch == "6" { 6 } else if ch == "7" { 7 } else if ch == "8" { 8 }
        else if ch == "9" { 9 } else { -1 };
        if d < 0 { return 0; }
        acc = (acc * 10) + d;
        i += 1;
    }
    acc
};

escapeLiteString := fn(raw: String): String {
    var out := "";
    n := text.length(raw);
    var i := 0;
    loop i < n {
        ch := text.at(raw, i);
        if ch == "\\" { out = out + "\\\\"; }
        else if ch == "\"" { out = out + "\\\""; }
        else { out = out + ch; }
        i += 1;
    }
    out
};

splitLines := fn(source: String): List<String> {
    out: mut List<String> = [];
    n := text.length(source);
    var pos := 0;
    loop pos <= n {
        nl := text.indexOfText(source, "\n", pos);
        if nl < 0 {
            list.pushBack(mut out, text.slice(source, pos, n));
            break;
        }
        list.pushBack(mut out, text.slice(source, pos, nl));
        pos = nl + 1;
    }
    out
};

findModuleAlias := fn(source: String, modulePath: String): String {
    needle := "\"" + modulePath + "\"";
    lines := splitLines(source);
    loop lines as rawLine {
        line := text.trim(rawLine);
        if text.containsText(line, needle) and text.containsText(line, "import") and text.containsText(line, ":=") {
            var work := line;
            if text.startsWithAt(work, 0, "pub ") {
                work = text.trim(text.slice(work, 4, text.length(work)));
            }
            colonIdx := text.indexOfText(work, ":=", 0);
            if colonIdx > 0 {
                alias := text.trim(text.slice(work, 0, colonIdx));
                if alias =!= "" and not text.containsText(alias, " ") {
                    return alias;
                }
            }
        }
    }
    ""
};

findCanvasAlias := fn(source: String): String {
    findModuleAlias(source, "extra/canvas")
};

findAudioAlias := fn(source: String): String {
    findModuleAlias(source, "extra/audio")
};

hasTopLevelFn := fn(source: String, fnName: String): Bool {
    lines := splitLines(source);
    loop lines as rawLine {
        line := text.trim(rawLine);
        var work := line;
        if text.startsWithAt(work, 0, "pub ") {
            work = text.trim(text.slice(work, 4, text.length(work)));
        }
        if text.startsWithAt(work, 0, fnName) {
            rest := text.trim(text.slice(work, text.length(fnName), text.length(work)));
            if text.startsWithAt(rest, 0, ":=") {
                after := text.trim(text.slice(rest, 2, text.length(rest)));
                if text.startsWithAt(after, 0, "fn") {
                    return true;
                }
            }
        }
    }
    false
};

buildPlayWrapper := fn(source: String, canvasAlias: String, audioAlias: String, scale: Int, fps: Int, uncap: Bool, debugHud: Bool, showBar: Bool, capturePath: String): String {
    hasInit := hasTopLevelFn(source, "onCanvasInit");
    hasUpdate := hasTopLevelFn(source, "onCanvasUpdate");
    hasKeyDown := hasTopLevelFn(source, "onCanvasKeyDown");
    hasKeyUp := hasTopLevelFn(source, "onCanvasKeyUp");
    hasPtrMove := hasTopLevelFn(source, "onCanvasPointerMove");
    hasPtrDown := hasTopLevelFn(source, "onCanvasPointerDown");
    hasPtrUp := hasTopLevelFn(source, "onCanvasPointerUp");
    hasResize := hasTopLevelFn(source, "onSurfaceResize");

    header :=
    "__lpSurf := import \"extra/surface\";\n" +
    "__lpColor := import \"extra/color\";\n" +
    "__lpList := import \"core/list\";\n" +
    "__lpIo := import \"core/io\";\n" +
    "__lpInt := import \"core/int\";\n" +
    "__lpTime := import \"core/time\";\n";

    var footer := "\n/* --- Desktop Play host driver (extra/canvas + extra/audio -> extra/surface) --- */\n";
    footer = footer +
    "__lpDecodeColor := fn(argb: Int): __lpSurf.Color {\n" +
    "    a0 := (argb / 16777216) % 256;\n" +
    "    r0 := (argb / 65536) % 256;\n" +
    "    g0 := (argb / 256) % 256;\n" +
    "    b0 := argb % 256;\n" +
    "    a := if a0 < 0 { a0 + 256 } else { a0 };\n" +
    "    r := if r0 < 0 { r0 + 256 } else { r0 };\n" +
    "    g := if g0 < 0 { g0 + 256 } else { g0 };\n" +
    "    b := if b0 < 0 { b0 + 256 } else { b0 };\n" +
    "    __lpColor.fromRgba8(r, g, b, a)\n" +
    "};\n" +
    "__lpFloorInt := fn(v: Float): Int {\n" +
    "    if v <= 0.0 { return 0; }\n" +
    "    var hi := 1;\n" +
    "    loop hi < 1000000 and hi <= v { hi = hi * 2; }\n" +
    "    var lo := 0;\n" +
    "    loop lo < hi {\n" +
    "        mid := (lo + hi + 1) / 2;\n" +
    "        if mid <= v { lo = mid; } else { hi = mid - 1; }\n" +
    "    }\n" +
    "    lo\n" +
    "};\n" +
    "__lpFmt1 := fn(tenths: Int): String {\n" +
    "    whole := tenths / 10;\n" +
    "    frac := tenths % 10;\n" +
    "    __lpInt.intText(whole) + \".\" + __lpInt.intText(if frac < 0 { 0 } else { frac })\n" +
    "};\n" +
    "__lpApplyFps := fn(win: __lpSurf.Surface, mode: Int): Unit {\n" +
    "    if mode == 0 { __lpSurf.setTargetFps(win, 60.0); }\n" +
    "    else if mode == 1 { __lpSurf.setTargetFps(win, 30.0); }\n" +
    "    else if mode == 2 { __lpSurf.setTargetFps(win, 120.0); }\n" +
    "    else { __lpSurf.uncapFrameRate(win); }\n" +
    "};\n" +
    "__lpDrawStageBar := fn(win: __lpSurf.Surface, winW: Int, barY: Int, barH: Int, visible: Bool, paused: Bool, muted: Bool, fpsMode: Int, debugOn: Bool, hudFps: Int): Unit {\n" +
    "    if barH <= 0 { return; }\n" +
    "    by := barY * 1.0;\n" +
    "    if not visible {\n" +
    "        __lpSurf.fillRect(win, __lpSurf.rect(0.0, by, winW * 1.0, barH * 1.0), __lpSurf.rgb(0.04, 0.05, 0.08));\n" +
    "        return;\n" +
    "    }\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(0.0, by, winW * 1.0, barH * 1.0), __lpSurf.rgba(0.08, 0.10, 0.14, 0.92));\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(0.0, by, winW * 1.0, 1.0), __lpSurf.rgb(0.22, 0.27, 0.36));\n" +
    "    pillBg := __lpSurf.rgb(0.15, 0.19, 0.26);\n" +
    "    amberBg := __lpSurf.rgb(0.65, 0.42, 0.12);\n" +
    "    coralBg := __lpSurf.rgb(0.62, 0.20, 0.24);\n" +
    "    cyanBg := __lpSurf.rgb(0.14, 0.44, 0.56);\n" +
    "    mintBg := __lpSurf.rgb(0.14, 0.46, 0.34);\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(6.0, by + 4.0, 62.0, 20.0), if paused { amberBg } else { pillBg });\n" +
    "    __lpSurf.drawText(win, if paused { \"PLAY\" } else { \"PAUSE\" }, __lpSurf.point(12.0, by + 10.0), 8.0, __lpSurf.WHITE);\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(74.0, by + 4.0, 44.0, 20.0), pillBg);\n" +
    "    __lpSurf.drawText(win, \"RST\", __lpSurf.point(82.0, by + 10.0), 8.0, __lpSurf.WHITE);\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(124.0, by + 4.0, 62.0, 20.0), if muted { coralBg } else { pillBg });\n" +
    "    __lpSurf.drawText(win, if muted { \"MUTED\" } else { \"SOUND\" }, __lpSurf.point(130.0, by + 10.0), 8.0, __lpSurf.WHITE);\n" +
    "    fpsLabel := if fpsMode == 0 { \"60FPS\" } else if fpsMode == 1 { \"30FPS\" } else if fpsMode == 2 { \"120FP\" } else { \"UNCAP\" };\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(192.0, by + 4.0, 64.0, 20.0), if fpsMode == 3 { cyanBg } else { pillBg });\n" +
    "    __lpSurf.drawText(win, fpsLabel, __lpSurf.point(198.0, by + 10.0), 8.0, __lpSurf.WHITE);\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(262.0, by + 4.0, 44.0, 20.0), if debugOn { mintBg } else { pillBg });\n" +
    "    __lpSurf.drawText(win, \"DBG\", __lpSurf.point(270.0, by + 10.0), 8.0, __lpSurf.WHITE);\n" +
    "    if winW >= 420 {\n" +
    "        stat := __lpInt.intText(hudFps) + \" FPS\";\n" +
    "        __lpSurf.drawText(win, stat, __lpSurf.point((winW - 84) * 1.0, by + 10.0), 8.0, __lpSurf.rgb(0.68, 0.76, 0.86));\n" +
    "    }\n" +
    "};\n" +
    "__lpDrawDebugHud := fn(win: __lpSurf.Surface, hudFps: Int, hudMsT: Int, hudCpuT: Int, hudRssT: Int, hudFrames: Int, fpsMode: Int, paused: Bool, muted: Bool): Unit {\n" +
    "    __lpSurf.fillRect(win, __lpSurf.rect(8.0, 8.0, 296.0, 42.0), __lpSurf.rgba(0.04, 0.06, 0.10, 0.82));\n" +
    "    __lpSurf.strokeRect(win, __lpSurf.rect(8.0, 8.0, 296.0, 42.0), 1.0, __lpSurf.rgba(0.45, 0.78, 0.90, 0.65));\n" +
    "    capTxt := if fpsMode == 0 { \"60\" } else if fpsMode == 1 { \"30\" } else if fpsMode == 2 { \"120\" } else { \"UNCAP\" };\n" +
    "    stTxt := (if paused { \" PAUSED\" } else { \"\" }) + (if muted { \" MUTED\" } else { \"\" });\n" +
    "    l1 := \"FPS \" + __lpInt.intText(hudFps) + \"  MS \" + __lpFmt1(hudMsT) + \"  CAP \" + capTxt + stTxt;\n" +
    "    l2 := \"RSS \" + __lpFmt1(hudRssT) + \"MB  CPU \" + __lpFmt1(hudCpuT) + \"MS  FRM \" + __lpInt.intText(hudFrames);\n" +
    "    __lpSurf.drawText(win, l1, __lpSurf.point(14.0, 14.0), 8.0, __lpSurf.WHITE);\n" +
    "    __lpSurf.drawText(win, l2, __lpSurf.point(14.0, 30.0), 8.0, __lpSurf.rgb(0.55, 0.88, 0.76));\n" +
    "};\n" +
    "__lpFlush := fn(win: __lpSurf.Surface, scale: Int, canvasW: Int, canvasH: Int, lastDrawCount: Int, muted: Bool): Int {\n" +
    "    snap := " + canvasAlias + ".litePlayCanvasSnapshot();\n" +
    "    scaleF := scale * 1.0;\n" +
    "    var nextDraw := lastDrawCount;\n" +
    "    px := " + canvasAlias + ".litePlayCanvasPixels();\n" +
    "    pxLen := __lpList.length(px);\n" +
    "    if pxLen > 0 and pxLen == snap.width * snap.height and snap.drawCount =!= lastDrawCount {\n" +
    "        nextDraw = snap.drawCount;\n" +
    "        var py := 0;\n" +
    "        loop py < snap.height {\n" +
    "            rowOff := py * snap.width;\n" +
    "            var pxIdx := 0;\n" +
    "            loop pxIdx < snap.width {\n" +
    "                colVal := px[rowOff + pxIdx];\n" +
    "                var runEnd := pxIdx + 1;\n" +
    "                loop runEnd < snap.width and px[rowOff + runEnd] == colVal {\n" +
    "                    runEnd += 1;\n" +
    "                }\n" +
    "                __lpSurf.fillRect(win, __lpSurf.rect(pxIdx * scaleF, py * scaleF, (runEnd - pxIdx) * scaleF, scaleF), __lpDecodeColor(colVal));\n" +
    "                pxIdx = runEnd;\n" +
    "            }\n" +
    "            py += 1;\n" +
    "        }\n" +
    "    }\n" +
    "    ops := " + canvasAlias + ".litePlayCanvasTakeOps();\n" +
    "    n := __lpList.length(ops);\n" +
    "    var i := 0;\n" +
    "    loop i < n {\n" +
    "        op := ops[i];\n" +
    "        if op == 1 and i + 1 < n {\n" +
    "            __lpSurf.fillRect(win, __lpSurf.rect(0.0, 0.0, canvasW * 1.0, canvasH * 1.0), __lpDecodeColor(ops[i + 1]));\n" +
    "            i += 2;\n" +
    "        } else if op == 2 and i + 5 < n {\n" +
    "            __lpSurf.fillRect(win, __lpSurf.rect(ops[i + 1] * scaleF, ops[i + 2] * scaleF, ops[i + 3] * scaleF, ops[i + 4] * scaleF), __lpDecodeColor(ops[i + 5]));\n" +
    "            i += 6;\n" +
    "        } else {\n" +
    "            break;\n" +
    "        }\n" +
    "    }\n";
    if audioAlias =!= "" {
        footer = footer +
        "    tones := " + audioAlias + ".litePlayAudioDrain();\n" +
        "    if not muted {\n" +
        "        tn := __lpList.length(tones);\n" +
        "        var ti := 0;\n" +
        "        loop ti + 2 < tn {\n" +
        "            __lpSurf.playTone(win, tones[ti], tones[ti + 1], tones[ti + 2]);\n" +
        "            ti += 3;\n" +
        "        }\n" +
        "    }\n";
    }
    footer = footer +
    "    nextDraw\n" +
    "};\n" +
    "__lpRunPlay := fn(): Unit {\n" +
    "    snap := " + canvasAlias + ".litePlayCanvasSnapshot();\n" +
    "    if snap.width <= 0 or snap.height <= 0 { return; }\n" +
    "    reqScale := " + integer.intText(scale) + ";\n" +
    "    scale := if reqScale > 0 { reqScale } else if snap.width <= 240 { 3 } else if snap.width <= 480 { 2 } else { 1 };\n" +
    "    canvasW := snap.width * scale;\n" +
    "    canvasH := snap.height * scale;\n" +
    "    barH := " + (if (capturePath == "" or debugHud) and showBar { "28" } else { "0" }) + ";\n" +
    "    win := __lpSurf.open(snap.title, canvasW, canvasH + barH);\n";

    initFpsMode := if uncap { 3 } else if fps == 30 { 1 } else if fps == 120 { 2 } else { 0 };
    if uncap {
        footer = footer + "    __lpSurf.uncapFrameRate(win);\n";
    } else if fps > 0 {
        footer = footer + "    __lpSurf.setTargetFps(win, " + integer.intText(fps) + ".0);\n";
    }

    footer = footer + "    var lastDraw := -1;\n";
    if hasInit {
        footer = footer + "    onCanvasInit();\n";
    }
    footer = footer + "    lastDraw = __lpFlush(win, scale, canvasW, canvasH, lastDraw, false);\n";
    if capturePath =!= "" {
        if hasUpdate {
            footer = footer +
            "    _capSt := onCanvasUpdate(0.025);\n" +
            "    lastDraw = __lpFlush(win, scale, canvasW, canvasH, lastDraw, false);\n";
        }
        if debugHud {
            footer = footer +
            "    vtCap := __lpSurf.vitals(win);\n" +
            "    __lpDrawStageBar(win, canvasW, canvasH, barH, barH > 0, false, false, " + integer.intText(initFpsMode) + ", true, 60);\n" +
            "    __lpDrawDebugHud(win, 60, 166, 12, __lpFloorInt(((vtCap.memoryBytes / 1048576.0) * 10.0) + 0.5), vtCap.frameCount, " + integer.intText(initFpsMode) + ", false, false);\n";
        }
        footer = footer +
        "    __lpSurf.present(win);\n" +
        "    _capRes := __lpSurf.capture(win, \"" + escapeLiteString(capturePath) + "\");\n" +
        "    __lpSurf.close(win);\n" +
        "    return;\n" +
        "};\n" +
        "__lpRunPlay();\n";
        return header + source + footer;
    }

    footer = footer +
    "    var paused := false;\n" +
    "    var muted := false;\n" +
    "    var debugOn := " + (if debugHud { "true" } else { "false" }) + ";\n" +
    "    var barVisible := " + (if showBar { "true" } else { "false" }) + ";\n" +
    "    var fpsMode := " + integer.intText(initFpsMode) + ";\n" +
    "    var hudFps := 60;\n" +
    "    var hudMsT := 166;\n" +
    "    var hudCpuT := 0;\n" +
    "    var hudRssT := 0;\n" +
    "    var hudFrames := 0;\n" +
    "    var nextHudNs := 0;\n" +
    "    drawBarH := if barH > 0 { barH } else if barVisible { 28 } else { 0 };\n" +
    "    drawBarY := if barH > 0 { canvasH } else { canvasH - 28 };\n" +
    "    __lpDrawStageBar(win, canvasW, drawBarY, drawBarH, barVisible, paused, muted, fpsMode, debugOn, hudFps);\n" +
    "    if debugOn { __lpDrawDebugHud(win, hudFps, hudMsT, hudCpuT, hudRssT, hudFrames, fpsMode, paused, muted); }\n" +
    "    __lpSurf.present(win);\n" +
    "    var prevKey := \"\";\n" +
    "    var prevDown := false;\n" +
    "    var prevCol := -1;\n" +
    "    var prevRow := -1;\n" +
    "    var prevWinW := canvasW;\n" +
    "    var prevWinH := canvasH + barH;\n" +
    "    var curWinW := canvasW;\n" +
    "    var curWinH := canvasH + barH;\n" +
    "    var curScale := scale;\n" +
    "    loop true {\n" +
    "        inp := __lpSurf.poll(win);\n" +
    "        if not inp.open or inp.key == \"Escape\" { break; }\n" +
    "        if inp.width > 0 and inp.height > 0 and (inp.width =!= prevWinW or inp.height =!= prevWinH) {\n" +
    "            prevWinW = inp.width;\n" +
    "            prevWinH = inp.height;\n" +
    "            curWinW = inp.width;\n" +
    "            curWinH = inp.height;\n" +
    "            availH := if barH > 0 and curWinH > barH { curWinH - barH } else { curWinH };\n" +
    "            sx := curWinW / snap.width;\n" +
    "            sy := availH / snap.height;\n" +
    "            fitS := if sx < sy { sx } else { sy };\n" +
    "            curScale = if fitS < 1 { 1 } else { fitS };\n" +
    "            __lpSurf.clear(win, __lpSurf.rgb(0.04, 0.05, 0.08));\n" +
    (if hasResize { "            onSurfaceResize(curWinW, availH);\n" } else { "" }) +
    "        }\n" +
    "        var handledKey := false;\n" +
    "        if inp.key == \"F12\" {\n" +
    "            barVisible = not barVisible;\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"F11\" {\n" +
    "            __lpSurf.toggleFullscreen(win);\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"p\" or inp.key == \"P\" {\n" +
    "            paused = not paused;\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"m\" or inp.key == \"M\" {\n" +
    "            muted = not muted;\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"f\" or inp.key == \"F\" {\n" +
    "            fpsMode = (fpsMode + 1) % 4;\n" +
    "            __lpApplyFps(win, fpsMode);\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"v\" or inp.key == \"V\" {\n" +
    "            debugOn = not debugOn;\n" +
    "            handledKey = true;\n" +
    "        } else if inp.key == \"r\" or inp.key == \"R\" {\n" +
    "            __lpSurf.close(win);\n" +
    "            __lpIo.exit(42);\n" +
    "        }\n";

    if hasKeyDown {
        footer = footer +
        "        if not handledKey and inp.key =!= \"\" and not paused { onCanvasKeyDown(inp.key); }\n";
    }
    if hasKeyUp {
        footer = footer +
        "        if prevKey =!= \"\" and inp.key == \"\" and not paused { onCanvasKeyUp(prevKey); }\n";
    }
    footer = footer +
    "        prevKey = if handledKey { \"\" } else { inp.key };\n" +
    "        curCanvasH := if barH > 0 and curWinH > barH { curWinH - barH } else { curWinH };\n" +
    "        activeBarY := if barH > 0 { curCanvasH } else { curWinH - 28 };\n" +
    "        inBar := barVisible and inp.pointerY >= (activeBarY * 1.0);\n" +
    "        if inBar and inp.pointerDown and not prevDown {\n" +
    "            px := inp.pointerX;\n" +
    "            if px >= 6.0 and px <= 68.0 { paused = not paused; }\n" +
    "            else if px >= 74.0 and px <= 118.0 { __lpSurf.close(win); __lpIo.exit(42); }\n" +
    "            else if px >= 124.0 and px <= 186.0 { muted = not muted; }\n" +
    "            else if px >= 192.0 and px <= 256.0 { fpsMode = (fpsMode + 1) % 4; __lpApplyFps(win, fpsMode); }\n" +
    "            else if px >= 262.0 and px <= 306.0 { debugOn = not debugOn; }\n" +
    "        }\n" +
    "        col := __lpFloorInt(inp.pointerX / (curScale * 1.0));\n" +
    "        row := __lpFloorInt(inp.pointerY / (curScale * 1.0));\n";

    if hasPtrMove {
        footer = footer +
        "        if not inBar and not paused and (col =!= prevCol or row =!= prevRow) { onCanvasPointerMove(col, row); }\n";
    }
    if hasPtrDown {
        footer = footer +
        "        if not inBar and not paused and inp.pointerDown and not prevDown { onCanvasPointerDown(col, row, 0); }\n";
    }
    if hasPtrUp {
        footer = footer +
        "        if not inBar and not paused and not inp.pointerDown and prevDown { onCanvasPointerUp(col, row, 0); }\n";
    }
    footer = footer +
    "        prevCol = col;\n" +
    "        prevRow = row;\n" +
    "        prevDown = inp.pointerDown;\n";

    if hasUpdate {
        footer = footer +
        "        if not paused {\n" +
        "            rawDt := inp.deltaMs / 1000.0;\n" +
        "            dt := if rawDt > 0.05 { 0.05 } else if rawDt <= 0.0 { 0.016 } else { rawDt };\n" +
        "            st := onCanvasUpdate(dt);\n" +
        "            if st =!= 0 { break; }\n" +
        "        }\n";
    }

    footer = footer +
    "        lastDraw = __lpFlush(win, curScale, curWinW, curCanvasH, lastDraw, muted);\n" +
    "        nowNs := __lpTime.monotonicNs();\n" +
    "        if nowNs >= nextHudNs {\n" +
    "            nextHudNs = nowNs + 250000000;\n" +
    "            vt := __lpSurf.vitals(win);\n" +
    "            hudFps = __lpFloorInt(vt.fps + 0.5);\n" +
    "            hudMsT = __lpFloorInt((vt.avgFrameTimeMs * 10.0) + 0.5);\n" +
    "            hudCpuT = __lpFloorInt((vt.cpuTimeMs * 10.0) + 0.5);\n" +
    "            hudRssT = __lpFloorInt(((vt.memoryBytes / 1048576.0) * 10.0) + 0.5);\n" +
    "            hudFrames = vt.frameCount;\n" +
    "        }\n" +
    "        curBarH := if barH > 0 { barH } else if barVisible { 28 } else { 0 };\n" +
    "        __lpDrawStageBar(win, curWinW, activeBarY, curBarH, barVisible, paused, muted, fpsMode, debugOn, hudFps);\n" +
    "        if debugOn { __lpDrawDebugHud(win, hudFps, hudMsT, hudCpuT, hudRssT, hudFrames, fpsMode, paused, muted); }\n" +
    "        __lpSurf.present(win);\n" +
    "    }\n" +
    "    __lpSurf.close(win);\n" +
    "};\n" +
    "__lpRunPlay();\n";

    header + source + footer
};

run := fn(rawArgs: List<String>): Unit {
    args: mut List<String> = rawArgs;
    builtinOpts: mut List<String> = [];
    var target := "ts";
    var targetSet := false;
    var playMode := false;
    var playScale := 0;
    var playFps := 60;
    var playUncap := false;
    var playDebug := false;
    var playBar := true;
    var playCapture := "";
    var scriptPath := "";
    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--" {
            if list.listCountText(args) == 0 { usageExit(); }
            scriptPath = list.popFront(mut args);
            break;
        } else if arg == "--play" {
            playMode = true;
        } else if arg == "--uncap" {
            playUncap = true;
        } else if arg == "--debug" or arg == "--hud" {
            playDebug = true;
        } else if arg == "--no-bar" or arg == "--hide-bar" {
            playBar = false;
        } else if arg == "--scale" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            playScale = parsePosInt(list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--scale=") {
            playScale = parsePosInt(text.slice(arg, 8, text.length(arg)));
        } else if arg == "--fps" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            playFps = parsePosInt(list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--fps=") {
            playFps = parsePosInt(text.slice(arg, 6, text.length(arg)));
        } else if arg == "--capture" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            playCapture = list.popFront(mut args);
        } else if text.startsWithAt(arg, 0, "--capture=") {
            playCapture = text.slice(arg, 10, text.length(arg));
        } else if arg == "--target" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            target = list.popFront(mut args);
            targetSet = true;
        } else if text.startsWithAt(arg, 0, "--target=") {
            target = text.slice(arg, 9, text.length(arg));
            targetSet = true;
        } else if arg == "--builtin-mode" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            list.pushBack(mut builtinOpts, arg);
            list.pushBack(mut builtinOpts, list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--builtin-mode=") {
            list.pushBack(mut builtinOpts, arg);
        } else if arg == "-O0" or arg == "-O1" or arg == "-O2" or arg == "-O3" or arg == "-Os" or text.startsWithAt(arg, 0, "--opt=") {
            list.pushBack(mut builtinOpts, arg);
        } else if arg == "--opt" {
            if list.listCountText(args) == 0 or args[0] == "--" { usageExit(); }
            list.pushBack(mut builtinOpts, arg);
            list.pushBack(mut builtinOpts, list.popFront(mut args));
        } else {
            scriptPath = arg;
            break;
        }
    }

    if playMode and not targetSet {
        target = "c";
    }

    if target =!= "ts" and target =!= "c" {
        io.errorLine("lite run: unknown target " + target + " (expected ts or c)");
        usageExit();
    }
    if scriptPath == "" {
        usageExit();
    }
    if scriptPath == "--check" {
        io.errorLine("lite run: --check is ./bin/lite check file.lts");
        io.exit(2);
    }
    if text.startsWithAt(scriptPath, 0, "-") {
        io.errorLine("lite run: unknown option " + scriptPath);
        usageExit();
    }
    if not text.endsWith(scriptPath, ".lts") {
        io.errorLine("lite run: source must be a .lts file");
        io.exit(2);
    }

    if list.listCountText(args) > 0 and args[0] == "--" {
        _sep := list.popFront(mut args);
    }
    if fs.kind(scriptPath) =!= fs.FILE_KIND_FILE {
        io.errorLine("lite run: cannot read " + scriptPath);
        io.exit(2);
    }

    root := project.findRepoRoot();
    sel := compilerBuild.selectCompilerPath(root, target);
    if not sel.ok {
        io.errorLine("lite run: " + sel.error);
        io.exit(1);
    }
    emptyEnv: List<String> = [];

    tempDir := fs.makeTempDir("lite-run-");
    if not tempDir.ok {
        io.errorLine("lite run: " + tempDir.error);
        io.exit(1);
    }

    var compileInput := scriptPath;
    if playMode {
        srcRead := fs.readText(scriptPath);
        if not srcRead.ok {
            fs.remove(tempDir.path);
            io.errorLine("lite run: " + srcRead.error);
            io.exit(1);
        }
        canvasAlias := findCanvasAlias(srcRead.text);
        audioAlias := findAudioAlias(srcRead.text);
        if canvasAlias =!= "" {
            resolvedCapture := if playCapture == "" { "" } else { path.resolve(proc.cwd(), playCapture) };
            wrapped := buildPlayWrapper(srcRead.text, canvasAlias, audioAlias, playScale, playFps, playUncap, playDebug, playBar, resolvedCapture);
            wrappedPath := path.join(tempDir.path, "play-entry.lts");
            wRes := fs.writeText(wrappedPath, wrapped);
            if not wRes.ok {
                fs.remove(tempDir.path);
                io.errorLine("lite run: " + wRes.error);
                io.exit(1);
            }
            compileInput = wrappedPath;
        }
    }

    compileArgs: mut List<String> = [sel.path];
    loop builtinOpts as opt {
        list.pushBack(mut compileArgs, opt);
    }
    list.pushBack(mut compileArgs, compileInput);
    compiled := proc.run(project.nodeExecPath(), compileArgs, "", emptyEnv, true, "");
    if compiled.error =!= "" {
        fs.remove(tempDir.path);
        io.errorLine("lite run: " + compiled.error);
        io.exit(1);
    }
    if compiled.status =!= 0 {
        fs.remove(tempDir.path);
        project.errorText(compiled.stderr);
        io.exit(compiled.status);
    }

    runEnv: mut List<String> = [];
    if playCapture =!= "" {
        list.pushBack(mut runEnv, "LITE_CANVAS_HEADLESS=1");
    }

    base := path.baseName(scriptPath);
    baseNoExt := text.slice(base, 0, text.length(base) - 4);
    if target == "c" {
        cArtifact := path.join(tempDir.path, baseNoExt + ".c");
        cWrite := fs.writeText(cArtifact, compiled.stdout);
        if not cWrite.ok {
            fs.remove(tempDir.path);
            io.errorLine("lite run: " + cWrite.error);
            io.exit(1);
        }
        binPath := path.join(tempDir.path, baseNoExt);
        ccArgs: mut List<String> = ["-std=c11", "-O1", cArtifact, "-o", binPath, "-lm"];
        if proc.platform() == "darwin" and text.containsText(compiled.stdout, "LITE_LINK_FRAMEWORKS: Cocoa CoreGraphics") {
            list.pushBack(mut ccArgs, "-framework");
            list.pushBack(mut ccArgs, "Cocoa");
            list.pushBack(mut ccArgs, "-framework");
            list.pushBack(mut ccArgs, "CoreGraphics");
        }
        ccRes := proc.run("cc", ccArgs, tempDir.path, emptyEnv, true, "");
        if ccRes.error =!= "" {
            fs.remove(tempDir.path);
            io.errorLine("lite run: cc failed: " + ccRes.error);
            io.exit(1);
        }
        if ccRes.status =!= 0 {
            fs.remove(tempDir.path);
            project.errorText(ccRes.stderr);
            io.exit(ccRes.status);
        }
        var cStatus := 0;
        var cErr := "";
        loop true {
            cExecRes := proc.run(binPath, args, "", runEnv, false, "");
            cStatus = cExecRes.status;
            cErr = cExecRes.error;
            if playMode and cErr == "" and cStatus == 42 {
                continue;
            }
            break;
        }
        fs.remove(tempDir.path);
        if cErr =!= "" {
            io.errorLine("lite run: " + cErr);
            io.exit(1);
        }
        io.exit(cStatus);
    }
    artifact := path.join(tempDir.path, baseNoExt + ".ts");
    writeRes := fs.writeText(artifact, compiled.stdout);
    if not writeRes.ok {
        fs.remove(tempDir.path);
        io.errorLine("lite run: " + writeRes.error);
        io.exit(1);
    }

    runnerPath := path.join(tempDir.path, "runner.ts");
    runnerCode :=
    "import { writeSync } from 'node:fs';\n" +
    "import { main } from './" + baseNoExt + ".ts';\n" +
    "process.argv = [process.execPath, process.argv[1]!, ...process.argv.slice(2)];\n" +
    "const out = main((text: string): void => { writeSync(1, text); });\n" +
    "if (typeof out === 'string' && out.length > 0) writeSync(1, out);\n";
    runWr := fs.writeText(runnerPath, runnerCode);
    if not runWr.ok {
        fs.remove(tempDir.path);
        io.errorLine("lite run: " + runWr.error);
        io.exit(1);
    }

    entryArgs: mut List<String> = [runnerPath];
    loop args as arg {
        list.pushBack(mut entryArgs, arg);
    }
    var tsStatus := 0;
    var tsErr := "";
    loop true {
        execRes := proc.run(project.nodeExecPath(), entryArgs, "", runEnv, false, "");
        tsStatus = execRes.status;
        tsErr = execRes.error;
        if playMode and tsErr == "" and tsStatus == 42 {
            continue;
        }
        break;
    }
    fs.remove(tempDir.path);

    if tsErr =!= "" {
        io.errorLine("lite run: " + tsErr);
        io.exit(1);
    }
    io.exit(tsStatus);
};

run(io.inputArgs());
