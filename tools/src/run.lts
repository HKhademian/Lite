/** Compile one script to a temporary artifact, execute it with the selected runtime target, and forward its status. */

io := import "core/io";
runner := import "lite/runner";
project := import "util/project";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite run [--target ts|c] [-O0|-O1|-O2|-O3] [--builtin-mode SPEC]... [--play [--scale N] [--fps N|--uncap] [--capture PNG]] file.lts [-- argument ...]");
    io.exit(2);
};

parsePosInt := fn(raw: String): Int {
    n := raw.length();
    if n == 0 { return 0; }
    var acc := 0;
    var i := 0;
    loop i < n {
        ch := raw.at(i);
        d := if ch == "0" { 0 } else if ch == "1" { 1 } else if ch == "2" { 2 }
        else if ch == "3" { 3 } else if ch == "4" { 4 } else if ch == "5" { 5 }
        else if ch == "6" { 6 } else if ch == "7" { 7 } else if ch == "8" { 8 }
        else if ch == "9" { 9 } else { -1 };
        if d < 0 { return 0; }
        acc = (acc * 10) + d;
        i += 1;
    }
    acc
};

run := fn(rawArgs: List<String>): Unit {
    mut args: List<String> = rawArgs;
    mut compileOpts: List<String> = [];
    var targetRaw := "ts";
    var targetSet := false;
    var sanitize := false;
    var debugPreset := false;
    var explicitDebugSet := false;
    var explicitDebugVal := false;
    var playMode := false;
    var playScale := 0;
    var playFps := 60;
    var playUncap := false;
    var playDebug := false;
    var playBar := true;
    var playFullscreen := false;
    var playCapture := "";
    var scriptPath := "";

    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--" {
            if args.length() == 0 { usageExit(); }
            scriptPath = mut args.popFront();
            break;
        } else if arg == "--play" {
            playMode = true;
        } else if arg == "--uncap" {
            playUncap = true;
        } else if arg == "--fullscreen" {
            playFullscreen = true;
        } else if arg == "--debug" or arg == "--hud" {
            playDebug = true;
        } else if arg == "--no-bar" or arg == "--hide-bar" {
            playBar = false;
        } else if arg == "--scale" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            playScale = parsePosInt(mut args.popFront());
        } else if arg.startsWithAt(0, "--scale=") {
            playScale = parsePosInt(arg.slice(8, arg.length()));
        } else if arg == "--fps" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            playFps = parsePosInt(mut args.popFront());
        } else if arg.startsWithAt(0, "--fps=") {
            playFps = parsePosInt(arg.slice(6, arg.length()));
        } else if arg == "--capture" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            playCapture = mut args.popFront();
        } else if arg.startsWithAt(0, "--capture=") {
            playCapture = arg.slice(10, arg.length());
        } else if arg == "--target" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            targetRaw = mut args.popFront();
            targetSet = true;
        } else if arg.startsWithAt(0, "--target=") {
            targetRaw = arg.slice(9, arg.length());
            targetSet = true;
        } else if arg == "--builtin-mode" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(mut args.popFront());
        } else if arg.startsWithAt(0, "--builtin-mode=") {
            mut compileOpts.pushBack(arg);
        } else if arg == "--emit-format" or arg == "--source-map" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(mut args.popFront());
        } else if arg == "--sanitize" {
            sanitize = true;
            mut compileOpts.pushBack(arg);
        } else if arg == "-fdebug-info" {
            explicitDebugSet = true;
            explicitDebugVal = true;
            mut compileOpts.pushBack(arg);
        } else if arg == "-fno-debug-info" {
            explicitDebugSet = true;
            explicitDebugVal = false;
            mut compileOpts.pushBack(arg);
        } else if arg.startsWithAt(0, "--emit-format=") or arg.startsWithAt(0, "--source-map=") or arg.startsWithAt(0, "-f") {
            mut compileOpts.pushBack(arg);
        } else if arg == "-O0" or arg == "-O1" or arg == "-O2" or arg == "-O3" or arg == "-Os" or arg == "-Oc" or arg.startsWithAt(0, "--opt=") {
            debugPreset = arg == "-O0" or arg == "--opt=0";
            mut compileOpts.pushBack(arg);
        } else if arg == "--opt" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            optVal := mut args.popFront();
            debugPreset = optVal == "0";
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(optVal);
        } else {
            scriptPath = arg;
            break;
        }
    }

    if playMode and not targetSet {
        targetRaw = "c";
    }
    if targetRaw =!= "ts" and targetRaw =!= "c" {
        io.errorLine("lite run: unknown target " + targetRaw + " (expected ts or c)");
        usageExit();
    }
    if scriptPath == "" {
        usageExit();
    }
    if scriptPath == "--check" {
        io.errorLine("lite run: --check is ./bin/lite check file.lts");
        io.exit(2);
    }
    if scriptPath.startsWithAt(0, "-") {
        io.errorLine("lite run: unknown option " + scriptPath);
        usageExit();
    }

    if args.length() > 0 and args[0] == "--" {
        _sep := mut args.popFront();
    }

    playOpts := runner.PlayOptions {
        enabled = playMode,
        scale = playScale,
        fps = playFps,
        uncap = playUncap,
        debugHud = playDebug,
        showBar = playBar,
        startFullscreen = playFullscreen,
        capturePath = playCapture
    };
    runTarget := if targetRaw == "c" { runner.RunTarget.C } else { runner.RunTarget.Ts };
    opts := runner.RunOptions {
        =scriptPath,
        target = runTarget,
        =compileOpts,
        =sanitize,
        =debugPreset,
        =explicitDebugSet,
        =explicitDebugVal,
        play = playOpts,
        scriptArgs = args
    };
    res := runner.runScript(opts);
    if res.error =!= "" { io.errorLine(res.error); }
    if res.stderr =!= "" { project.errorText(res.stderr); }
    io.exit(res.status);
};

run(io.inputArgs());
