/** CLI entrypoint generating `/`, `/gallery/`, and `/playground/` page bodies JSON (`site/build.ts`). */

io := import "core/io";
sitePages := import "../../site/src/pages.lts";

run := fn(): Unit {
    stdinRes := io.readAllText(io.stdinReader());
    if not stdinRes.ok {
        io.errorLine(stdinRes.error);
        io.exit(1);
    }
    res := sitePages.buildSitePagesJson(stdinRes.text);
    if not res.ok {
        io.errorLine(res.error);
        io.exit(1);
    }
    io.output(res.jsonText);
};

run();
