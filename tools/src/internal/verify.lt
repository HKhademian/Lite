/** Provisional feature, example, sample, and showcase verification engine (`lite verify`). */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
project := import "./project";
crypto := import "core/crypto";
text := import "core/text";
time := import "core/time";
list := import "core/list";
path := import "core/path";
json := import "data/json";
streams := import "./streams";
cases := import "./cases";
compilerBuild := import "./compiler-build";
pool := import "external/pool";

KIND_FEATURE := "feature";
KIND_EXAMPLE := "example";
KIND_SAMPLE := "sample";
KIND_SHOWCASE := "showcase";

/** Returns the CLI usage text for `lite verify`. */
pub usageText := fn(): String {
    "Usage: ./bin/lite verify [--all] [--update] [--coverage] [--pedantic] [--jobs n] [--shard i/n] [--filter id-or-path] [--no-cache] [--quiet]"
};

checkStringArrayField := fn(source: String, objPos: Int, key: String, label: String): (found: Bool, ok: Bool, error: String) {
    field := json.findField(source, objPos, key);
    if not field.found {
        return (found = false, ok = true, error = "");
    }
    if json.kindAt(source, field.valuePos) =!= .Array {
        return (found = true, ok = false, error = label + "." + key + ": expected an array of strings");
    }
    loop json.arrayOffsets(source, field.valuePos) as elPos {
        s := json.readStringAt(source, elPos);
        if not s.ok {
            return (found = true, ok = false, error = label + "." + key + ": expected an array of strings");
        }
    }
    (found = true, ok = true, error = "")
};

readStringArrayField := fn(source: String, objPos: Int, key: String): List<String> {
    mut out: List<String> = [];
    field := json.findField(source, objPos, key);
    if not field.found or json.kindAt(source, field.valuePos) =!= .Array {
        return out;
    }
    loop json.arrayOffsets(source, field.valuePos) as elPos {
        s := json.readStringAt(source, elPos);
        if s.ok {
            mut out.pushBack(s.value);
        }
    }
    out
};

parsePositiveInt := fn(raw: String): (ok: Bool, value: Int) {
    if raw == "" { return (ok = false, value = 0); }
    var i := 0;
    size := raw.length();
    loop i < size {
        if not raw.at(i).isDigit() { return (ok = false, value = 0); }
        i = i + 1;
    }
    parsed := raw.toInt();
    if not parsed.ok or parsed.value <= 0 { return (ok = false, value = 0); }
    (ok = true, value = parsed.value)
};

parseShardSpec := fn(raw: String): (ok: Bool, index: Int, count: Int) {
    slash := raw.indexOf("/", 0);
    if slash <= 0 { return (ok = false, index = 0, count = 0); }
    if raw.indexOf("/", slash + 1) >= 0 { return (ok = false, index = 0, count = 0); }
    left := parsePositiveInt(raw.slice(0, slash));
    right := parsePositiveInt(raw.slice(slash + 1, raw.length()));
    if not left.ok or not right.ok { return (ok = false, index = 0, count = 0); }
    (ok = true, index = left.value, count = right.value)
};

/** Parses `lite verify` CLI options without consulting or executing manifests. */
pub parseVerifyArgs := fn(args: List<String>): (
ok: Bool, help: Bool, update: Bool, coverage: Bool, pedantic: Bool, changed: Bool, cache: Bool, quiet: Bool,
jobs: Int, hasFilter: Bool, filter: String, hasShard: Bool, shardIndex: Int, shardCount: Int, shardResult: String, error: String
) {
    var update := false;
    var coverage := false;
    var pedantic := false;
    var changed := true;
    var cache := true;
    var quiet := false;
    var jobs := 0;
    var hasFilter := false;
    var filter := "";
    var hasShard := false;
    var shardIndex := 0;
    var shardCount := 0;
    var shardResult := "";

    count := args.length();
    var i := 0;
    loop i < count {
        flag := args[i];
        if flag == "--update" {
            update = true;
        } else if flag == "--coverage" {
            coverage = true;
        } else if flag == "--pedantic" {
            pedantic = true;
            changed = false;
            cache = false;
        } else if flag == "--changed" {
            changed = true;
        } else if flag == "--all" {
            changed = false;
        } else if flag == "--no-cache" {
            cache = false;
        } else if flag == "--quiet" {
            quiet = true;
        } else if flag == "--help" or flag == "-h" {
            return (
            ok = true, help = true, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
            jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "", error = ""
            );
        } else if flag == "--jobs" {
            if i + 1 >= count {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--jobs requires a positive integer"
                );
            }
            parsedJobs := parsePositiveInt(args[i + 1]);
            if not parsedJobs.ok {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--jobs requires a positive integer"
                );
            }
            jobs = parsedJobs.value;
            i = i + 1;
        } else if flag == "--filter" {
            if i + 1 >= count {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--filter requires a value"
                );
            }
            hasFilter = true;
            filter = args[i + 1];
            i = i + 1;
        } else if flag == "--shard" {
            if i + 1 >= count {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--shard requires i/n"
                );
            }
            parsed := parseShardSpec(args[i + 1]);
            if not parsed.ok {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--shard requires i/n"
                );
            }
            if parsed.index < 1 or parsed.count < 1 or parsed.index > parsed.count {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--shard requires 1 <= i <= n"
                );
            }
            hasShard = true;
            shardIndex = parsed.index;
            shardCount = parsed.count;
            i = i + 1;
        } else if flag == "--shard-result" {
            if i + 1 >= count {
                return (
                ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
                jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
                error = "--shard-result requires a path"
                );
            }
            shardResult = args[i + 1];
            i = i + 1;
        } else {
            return (
            ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
            jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
            error = "unknown argument " + flag
            );
        }
        i = i + 1;
    }

    if pedantic and update {
        return (
        ok = false, help = false, update = false, coverage = false, pedantic = false, changed = true, cache = true, quiet = false,
        jobs = 0, hasFilter = false, filter = "", hasShard = false, shardIndex = 0, shardCount = 0, shardResult = "",
        error = "--pedantic cannot be combined with --update"
        );
    }

    (
    ok = true, help = false, update = update, coverage = coverage, pedantic = pedantic, changed = changed, cache = cache, quiet = quiet,
    jobs = jobs, hasFilter = hasFilter, filter = filter, hasShard = hasShard, shardIndex = shardIndex, shardCount = shardCount, shardResult = shardResult, error = ""
    )
};

pathInsideDir := fn(baseDir: String, candidate: String): Bool {
    resolvedBase := path.normalize(baseDir);
    resolvedTarget := path.normalize(candidate);
    if resolvedTarget == resolvedBase { return true; }
    s := path.sep();
    prefix := if resolvedBase.endsWith(s) { resolvedBase } else { resolvedBase + s };
    resolvedTarget.startsWithAt(0, prefix)
};

checkVerifyStream := fn(source: String, streamPos: Int, baseDir: String, label: String, checkHash: Bool, allowOutsideDir: Bool): (ok: Bool, kind: String, error: String) {
    if json.kindAt(source, streamPos) =!= .Object {
        return (ok = false, kind = "", error = label + ": expected an object");
    }
    fileField := json.findField(source, streamPos, "file");
    if fileField.found {
        fStr := json.readStringAt(source, fileField.valuePos);
        if not fStr.ok {
            return (ok = false, kind = "", error = label + ".file: expected a string");
        }
        if path.isAbsolute(fStr.value) {
            return (ok = false, kind = "", error = label + ".file: expected a relative path");
        }
        resolvedFile := path.resolve(baseDir, fStr.value);
        if not allowOutsideDir and not pathInsideDir(baseDir, resolvedFile) {
            return (ok = false, kind = "", error = label + ".file: path escapes its directory");
        }
    }
    checked := streams.validateStream(source, streamPos, baseDir, label, false, false, checkHash);
    if not checked.ok {
        if checked.error == label + ".hash does not match content" {
            return (ok = false, kind = "", error = label + ".hash: content changed; run ./bin/lite verify --update");
        }
        return (ok = false, kind = "", error = checked.error);
    }
    (ok = true, kind = checked.kind, error = "")
};

validateRegistry := fn(rootDir: String): (ok: Bool, text: String, error: String) {
    verDir := path.join(rootDir, "language/verifications");
    regPath := path.join(verDir, "features.json");
    regRead := fs.readText(regPath);
    if not regRead.ok {
        return (ok = false, text = "", error = regRead.error);
    }
    src := regRead.text;
    validJson := json.validate(src);
    if not validJson.ok or json.kindAt(src, 0) =!= .Object {
        return (ok = false, text = "", error = "language/verifications/features.json: expected an object");
    }
    topKeys := json.objectKeys(src, 0);
    loop topKeys as k {
        if k =!= "features" {
            return (ok = false, text = "", error = "language/verifications/features.json: unexpected key " + k);
        }
    }
    featField := json.findField(src, 0, "features");
    if not featField.found or json.kindAt(src, featField.valuePos) =!= .Array {
        return (ok = false, text = "", error = "language/verifications/features.json: features must be an array");
    }

    mut ids: Set<String>;
    offsets := json.arrayOffsets(src, featField.valuePos);
    var idx := 0;
    loop offsets as itemPos {
        label := "language/verifications/features.json: features[" + idx.toText() + "]";
        if json.kindAt(src, itemPos) =!= .Object {
            return (ok = false, text = "", error = label + ": expected an object");
        }
        allowed: List<String> = ["id", "summary", "case", "status", "docs"];
        loop json.objectKeys(src, itemPos) as ik {
            if not allowed.contains(ik) {
                return (ok = false, text = "", error = label + ": unexpected key " + ik);
            }
        }
        idRes := json.readFieldString(src, itemPos, "id");
        if not idRes.found or not idRes.ok {
            return (ok = false, text = "", error = label + ".id: expected a string");
        }
        if ids.has(idRes.value) {
            return (ok = false, text = "", error = label + ": duplicate feature " + idRes.value);
        }
        sumRes := json.readFieldString(src, itemPos, "summary");
        if not sumRes.found or not sumRes.ok {
            return (ok = false, text = "", error = label + ".summary: expected a string");
        }
        stRes := json.readFieldString(src, itemPos, "status");
        if not stRes.found or not stRes.ok or (stRes.value =!= "verified" and stRes.value =!= "pending") {
            return (ok = false, text = "", error = label + ".status: expected verified or pending");
        }
        caseRes := json.readFieldString(src, itemPos, "case");
        if not caseRes.found or not caseRes.ok {
            return (ok = false, text = "", error = label + ".case: expected a string");
        }
        if fs.kind(path.resolve(verDir, caseRes.value)) == fs.FILE_KIND_MISSING {
            return (ok = false, text = "", error = label + ".case: missing " + caseRes.value);
        }
        docsCheck := checkStringArrayField(src, itemPos, "docs", label);
        if not docsCheck.ok {
            return (ok = false, text = "", error = docsCheck.error);
        }
        loop readStringArrayField(src, itemPos, "docs") as docRel {
            if fs.kind(path.resolve(rootDir, docRel)) == fs.FILE_KIND_MISSING {
                return (ok = false, text = "", error = label + ".docs: missing " + docRel);
            }
        }
        (mut ids).add(idRes.value);
        idx = idx + 1;
    }
    (ok = true, text = src, error = "")
};

registryFeatureIds := fn(regSrc: String, verifiedOnly: Bool): List<String> {
    mut out: List<String> = [];
    featField := json.findField(regSrc, 0, "features");
    loop json.arrayOffsets(regSrc, featField.valuePos) as itemPos {
        if not verifiedOnly or json.readFieldString(regSrc, itemPos, "status").value == "verified" {
            mut out.pushBack(json.readFieldString(regSrc, itemPos, "id").value);
        }
    }
    out
};

failManifestText := fn(err: String): (
ok: Bool, id: String, hasSourceFile: Bool, sourceFile: String, sourcePath: String,
sourceHashField: String, hasAppend: Bool, appendText: String, text: String, error: String
) {
    (
    ok = false, id = "", hasSourceFile = false, sourceFile = "", sourcePath = "",
    sourceHashField = "", hasAppend = false, appendText = "", text = "", error = err
    )
};

validateManifestText := fn(rootDir: String, file: String, expectedKind: String, featureIdSet: Set<String>): (
ok: Bool, id: String, hasSourceFile: Bool, sourceFile: String, sourcePath: String,
sourceHashField: String, hasAppend: Bool, appendText: String, text: String, error: String
) {
    label := path.relative(rootDir, file);
    readRes := fs.readText(file);
    if not readRes.ok { return failManifestText(label + ": " + readRes.error); }
    src := readRes.text;
    validJson := json.validate(src);
    if not validJson.ok or json.kindAt(src, 0) =!= .Object {
        return failManifestText(label + ": expected an object");
    }

    allowedTop: List<String> = ["id", "kind", "source", "features", "guideline", "description", "append", "targets", "cases"];
    loop json.objectKeys(src, 0) as k {
        if not allowedTop.contains(k) {
            return failManifestText(label + ": unexpected key " + k);
        }
    }
    kindRes := json.readFieldString(src, 0, "kind");
    if not kindRes.found or not kindRes.ok or kindRes.value =!= expectedKind {
        return failManifestText(label + ": kind must be " + expectedKind);
    }
    idRes := json.readFieldString(src, 0, "id");
    if not idRes.found or not idRes.ok {
        return failManifestText(label + ".id: expected a string");
    }
    manifestId := idRes.value;

    sourceField := json.findField(src, 0, "source");
    if not sourceField.found or json.kindAt(src, sourceField.valuePos) =!= .Object {
        return failManifestText(label + ".source: expected an object");
    }
    fileDir := path.parentDir(file);
    srcStream := checkVerifyStream(src, sourceField.valuePos, fileDir, label + ".source", false, true);
    if not srcStream.ok { return failManifestText(srcStream.error); }

    var hasSourceFile := false;
    var sourceFile := "";
    var sourcePath := "";
    if srcStream.kind == "file" {
        hasSourceFile = true;
        sourceFile = json.readFieldString(src, sourceField.valuePos, "file").value;
        sourcePath = path.resolve(fileDir, sourceFile);
    }
    srcHashRes := json.readFieldString(src, sourceField.valuePos, "hash");
    sourceHashField := if srcHashRes.found { srcHashRes.value } else { "" };

    featCheck := checkStringArrayField(src, 0, "features", label);
    if not featCheck.found or not featCheck.ok {
        return failManifestText(if featCheck.error =!= "" { featCheck.error } else { label + ".features: expected an array of strings" });
    }
    featItems := readStringArrayField(src, 0, "features");
    if featItems.length() == 0 {
        return failManifestText(label + ".features: at least one feature is required");
    }
    loop featItems as featName {
        if not featureIdSet.has(featName) {
            return failManifestText(label + ".features: unknown feature " + featName);
        }
    }
    if expectedKind == KIND_FEATURE and not featItems.contains(manifestId) {
        return failManifestText(label + ".features: feature case must include its own id");
    }

    targetsCheck := checkStringArrayField(src, 0, "targets", label);
    if targetsCheck.found {
        if not targetsCheck.ok { return failManifestText(targetsCheck.error); }
        targetItems := readStringArrayField(src, 0, "targets");
        if targetItems.length() == 0 {
            return failManifestText(label + ".targets: expected unique target names");
        }
        mut seenTargets: List<String> = [];
        loop targetItems as t {
            if t =!= "ts" and t =!= "c" {
                return failManifestText(label + ".targets: unknown target " + t);
            }
            if seenTargets.contains(t) {
                return failManifestText(label + ".targets: expected unique target names");
            }
            (mut seenTargets).pushBack(t);
        }
    }

    guideField := json.findField(src, 0, "guideline");
    if guideField.found {
        gStr := json.readStringAt(src, guideField.valuePos);
        if not gStr.ok { return failManifestText(label + ".guideline: expected a string"); }
    } else if expectedKind == KIND_FEATURE {
        return failManifestText(label + ".guideline: feature cases require a guideline");
    }

    descField := json.findField(src, 0, "description");
    if descField.found {
        dStr := json.readStringAt(src, descField.valuePos);
        if not dStr.ok { return failManifestText(label + ".description: expected a string"); }
    }

    var hasAppend := false;
    var appendText := "";
    appField := json.findField(src, 0, "append");
    if appField.found {
        aStr := json.readStringAt(src, appField.valuePos);
        if not aStr.ok { return failManifestText(label + ".append: expected a string"); }
        hasAppend = true;
        appendText = aStr.value;
    }

    casesField := json.findField(src, 0, "cases");
    if not casesField.found or json.kindAt(src, casesField.valuePos) =!= .Array {
        return failManifestText(label + ".cases: at least one case is required");
    }
    caseOffsets := json.arrayOffsets(src, casesField.valuePos);
    if caseOffsets.length() == 0 {
        return failManifestText(label + ".cases: at least one case is required");
    }

    mut seenNames: Set<String>;
    allowedScenario: List<String> = ["name", "args", "stdin", "stdout", "stderr", "exitCode"];
    var idx := 0;
    loop caseOffsets as sPos {
        sLabel := label + ".cases[" + idx.toText() + "]";
        if json.kindAt(src, sPos) =!= .Object {
            return failManifestText(sLabel + ": expected an object");
        }
        loop json.objectKeys(src, sPos) as sk {
            if not allowedScenario.contains(sk) {
                return failManifestText(sLabel + ": unexpected key " + sk);
            }
        }
        sNameRes := json.readFieldString(src, sPos, "name");
        if not sNameRes.found or not sNameRes.ok {
            return failManifestText(sLabel + ".name: expected a string");
        }
        if seenNames.has(sNameRes.value) {
            return failManifestText(label + ": duplicate case name " + sNameRes.value);
        }
        (mut seenNames).add(sNameRes.value);

        sArgsCheck := checkStringArrayField(src, sPos, "args", sLabel);
        if sArgsCheck.found and not sArgsCheck.ok { return failManifestText(sArgsCheck.error); }

        exitRes := json.readFieldInt(src, sPos, "exitCode");
        if not exitRes.found or not exitRes.ok or exitRes.value < 0 or exitRes.value > 255 {
            return failManifestText(sLabel + ".exitCode: expected a byte");
        }
        stdinField := json.findField(src, sPos, "stdin");
        if stdinField.found {
            st1 := checkVerifyStream(src, stdinField.valuePos, fileDir, sLabel + ".stdin", false, false);
            if not st1.ok { return failManifestText(st1.error); }
        }
        stdoutField := json.findField(src, sPos, "stdout");
        if stdoutField.found {
            st2 := checkVerifyStream(src, stdoutField.valuePos, fileDir, sLabel + ".stdout", false, false);
            if not st2.ok { return failManifestText(st2.error); }
        }
        stderrField := json.findField(src, sPos, "stderr");
        if stderrField.found {
            st3 := checkVerifyStream(src, stderrField.valuePos, fileDir, sLabel + ".stderr", false, false);
            if not st3.ok { return failManifestText(st3.error); }
        }
        idx = idx + 1;
    }

    (
    ok = true, id = manifestId, hasSourceFile = hasSourceFile, sourceFile = sourceFile, sourcePath = sourcePath,
    sourceHashField = sourceHashField, hasAppend = hasAppend, appendText = appendText, text = src, error = ""
    )
};

manifestKindDir := fn(kind: String): String {
    if kind == KIND_FEATURE { return "features"; }
    if kind == KIND_EXAMPLE { return "artifacts/examples"; }
    if kind == KIND_SAMPLE { return "artifacts/samples"; }
    "artifacts/showcases"
};

collectKindManifests := fn(rootDir: String, kind: String): List<String> {
    dirPath := path.join(path.join(rootDir, "language/verifications"), manifestKindDir(kind));
    if fs.kind(dirPath) =!= fs.FILE_KIND_DIR {
        empty: List<String> = [];
        return empty;
    }
    ignored: List<String> = ["helpers"];
    path.collectFiles(dirPath, [dirPath], ".json", ignored, true)
};

validateAllManifests := fn(rootDir: String, featureIdSet: Set<String>, verifiedIds: List<String>): (ok: Bool, error: String) {
    dirKinds: List<String> = [KIND_FEATURE, KIND_EXAMPLE, KIND_SAMPLE, KIND_SHOWCASE];
    mut ids: Set<String>;
    mut featureManifestIds: Set<String>;

    loop dirKinds as kind {
        loop collectKindManifests(rootDir, kind) as f {
            checked := validateManifestText(rootDir, f, kind, featureIdSet);
            if not checked.ok {
                return (ok = false, error = checked.error);
            }
            if ids.has(checked.id) {
                return (ok = false, error = checked.id + ": duplicate manifest id");
            }
            (mut ids).add(checked.id);
            if kind == KIND_FEATURE {
                mut featureManifestIds.add(checked.id);
            }
        }
    }
    loop verifiedIds as vId {
        if not featureManifestIds.has(vId) {
            return (ok = false, error = "feature " + vId + ": no verification case");
        }
    }
    (ok = true, error = "")
};

countSourcesIn := fn(rootDir: String, relDir: String): Int {
    target := path.join(rootDir, relDir);
    if fs.kind(target) =!= fs.FILE_KIND_DIR { return 0; }
    ignored: List<String> = ["helpers"];
    path.collectFiles(target, [target], ".lts", ignored, false).length()
};

readManifestSourceName := fn(file: String): String {
    srcText := fs.readText(file).text;
    sf := json.findField(srcText, 0, "source");
    fRes := json.readFieldString(srcText, sf.valuePos, "file");
    if fRes.found { fRes.value } else { "(inline text)" }
};

runCoverage := fn(rootDir: String, featureIds: List<String>): Int {
    featureFiles := collectKindManifests(rootDir, KIND_FEATURE);
    exampleFiles := collectKindManifests(rootDir, KIND_EXAMPLE);
    sampleFiles := collectKindManifests(rootDir, KIND_SAMPLE);
    showcaseFiles := collectKindManifests(rootDir, KIND_SHOWCASE);

    featureCount := featureFiles.length();
    exampleCount := exampleFiles.length();
    sampleCount := sampleFiles.length();
    showcaseCount := showcaseFiles.length();

    mut coveredExamples: List<String> = [];
    loop exampleFiles as ef {
        mut coveredExamples.pushBack(readManifestSourceName(ef));
    }
    mut coveredSamples: List<String> = [];
    loop sampleFiles as sf {
        mut coveredSamples.pushBack(readManifestSourceName(sf));
    }

    regTotal := featureIds.length();
    exTotal := countSourcesIn(rootDir, "language/examples");
    smTotal := countSourcesIn(rootDir, "language/samples");
    shTotal := countSourcesIn(rootDir, "language/showcases");

    io.outputLine("features: " + regTotal.toText() + " registered, " + featureCount.toText() + " cases");
    io.outputLine("examples: " + exampleCount.toText() + "/" + exTotal.toText() + " manifests");
    io.outputLine("samples: " + sampleCount.toText() + "/" + smTotal.toText() + " manifests");
    io.outputLine("showcases: " + showcaseCount.toText() + "/" + shTotal.toText() + " manifests");
    exJoined := if coveredExamples.length() > 0 { coveredExamples.join(", ") } else { "(none)" };
    smJoined := if coveredSamples.length() > 0 { coveredSamples.join(", ") } else { "(none)" };
    io.outputLine("covered examples: " + exJoined);
    io.outputLine("covered samples: " + smJoined);

    if featureCount =!= regTotal or exampleCount =!= exTotal or sampleCount =!= smTotal or showcaseCount =!= shTotal {
        io.outputLine("coverage incomplete: every feature, example and sample needs a manifest");
        return 1;
    }
    0
};

resolveCompilerBuild := fn(rootDir: String): (ok: Bool, compilerPath: String, seedArtifact: String, metaJson: String, error: String) {
    seedRead := fs.readText(path.join(rootDir, "compiler/bootstrap/seed.ts"));
    var seedArtifact := "compiler.ts";
    if seedRead.ok {
        artRes := json.readFieldString(seedRead.text, seedRead.text.indexOf("{", 0), "artifact");
        if artRes.found and artRes.ok { seedArtifact = artRes.value; }
    }
    built := compilerBuild.buildCompiler(rootDir, "ts");
    if not built.ok {
        return (ok = false, compilerPath = "", seedArtifact = seedArtifact, metaJson = "", error = built.error);
    }
    depsCheck := checkStringArrayField(built.jsonText, 0, "dependencies", "buildCompiler");
    if not depsCheck.ok {
        return (ok = false, compilerPath = "", seedArtifact = seedArtifact, metaJson = "", error = "invalid buildCompiler metadata");
    }
    (ok = true, compilerPath = built.path, seedArtifact = seedArtifact, metaJson = built.jsonText, error = "")
};

computeRuntimeHash := fn(rootDir: String, compilerDeps: List<String>): (ok: Bool, hex: String, error: String) {
    mut parts: List<String> = [];
    staticFiles: List<String> = [
    "igniter/artifacts.ts",
    "igniter/tsconfig.json",
    "igniter/package-lock.json",
    "tools/src/ignite.lts",
    "tools/src/verify.lts",
    "tools/src/internal/verify.lt",
    "tools/src/internal/cases.lt",
    "tools/src/internal/streams.lt",
    "lib/data/json.lt",
    "tools/src/internal/compiler-build.lt",
    "tools/src/compiler-build.lts",
    "compiler/bootstrap/igniter.ts",
    "compiler/bootstrap/seed.ts"
    ];
    loop staticFiles as rel {
        full := path.join(rootDir, rel);
        if fs.kind(full) =!= fs.FILE_KIND_FILE {
            return (ok = false, hex = "", error = "missing runtime hash file: " + rel);
        }
        hStatic := crypto.sha256File(full);
        if not hStatic.ok { return (ok = false, hex = "", error = hStatic.error); }
        (mut parts).pushBack("[" + json.quoteString(rel) + "," + json.quoteString(hStatic.hex) + "]");
    }
    mut depParts: List<String> = [];
    loop compilerDeps as dep {
        full := path.join(rootDir, dep);
        hRes := crypto.sha256File(full);
        if not hRes.ok { return (ok = false, hex = "", error = hRes.error); }
        (mut depParts).pushBack("[" + json.quoteString(dep) + "," + json.quoteString(hRes.hex) + "]");
    }
    (mut parts).pushBack("[" + depParts.join(",") + "]");
    mut parts.pushBack(proc.runtimeVersion());
    (ok = true, hex = crypto.sha256Bytes(parts.join("\n").utf8Encode()), error = "")
};

loadVerifyCache := fn(cacheFile: String, enabled: Bool): Set<String> {
    mut passed: Set<String>;
    if not enabled or fs.kind(cacheFile) =!= fs.FILE_KIND_FILE { return passed; }
    readRes := fs.readText(cacheFile);
    if not readRes.ok or not json.validate(readRes.text).ok or json.kindAt(readRes.text, 0) =!= .Object {
        return passed;
    }
    verRes := json.readFieldInt(readRes.text, 0, "version");
    if not verRes.found or not verRes.ok or verRes.value =!= 1 { return passed; }
    passedField := json.findField(readRes.text, 0, "passed");
    if not passedField.found or json.kindAt(readRes.text, passedField.valuePos) =!= .Object {
        return passed;
    }
    loop json.objectKeys(readRes.text, passedField.valuePos) as key {
        val := json.readFieldBool(readRes.text, passedField.valuePos, key);
        if val.found and val.ok and val.value {
            mut passed.add(key);
        }
    }
    passed
};

saveVerifyCache := fn(cacheFile: String, passedKeys: Set<String>): Unit {
    mkRes := fs.makeDir(path.parentDir(cacheFile));
    if not mkRes.ok { return; }
    mut entries: List<String> = [];
    loop passedKeys as k {
        mut entries.pushBack(json.quoteString(k) + ":true");
    }
    body := "{\"version\":1,\"passed\":{" + entries.join(",") + "}}\n";
    _w := fs.writeText(cacheFile, body);
};

quotedListJson := fn(items: List<String>): String {
    if items.length() == 0 { return "[]"; }
    mut parts: List<String> = [];
    loop items as item {
        mut parts.pushBack(json.quoteString(item));
    }
    "[" + parts.join(",") + "]"
};

writeShardResult := fn(resultPath: String, executed: Int, cached: Int, failures: Int, added: List<String>, removed: List<String>): Unit {
    body := "{\"executed\":" + executed.toText() + ",\"cached\":" + cached.toText() + ",\"failures\":" + failures.toText() + ",\"added\":" + quotedListJson(added) + ",\"removed\":" + quotedListJson(removed) + "}\n";
    _w := fs.writeText(resultPath, body);
};

isManifestSelected := fn(
rootDir: String, mFile: String, mId: String, mText: String,
hasSourceFile: Bool, sourcePath: String,
hasFilter: Bool, filter: String,
hasGitChanges: Bool, invalidateAll: Bool,
gitPaths: Set<String>, changedFeatures: Set<String>
): Bool {
    if not manifestMatchesFilter(rootDir, mFile, mId, mText, hasFilter, filter) {
        return false;
    }
    if not hasGitChanges or invalidateAll {
        return true;
    }
    relMan := path.relative(rootDir, mFile);
    if gitPaths.has(relMan) { return true; }
    if hasSourceFile and gitPaths.has(path.relative(rootDir, sourcePath)) { return true; }
    loop readStringArrayField(mText, 0, "features") as fId {
        if changedFeatures.has(fId) { return true; }
    }
    false
};

finishVerificationSummary := fn(verifyStartNs: Int, failures: Int, executed: Int, cached: Int, updateMode: Bool): Int {
    elapsedMs := (time.monotonicNs() - verifyStartNs) / 1000000;
    elapsedTenths := (elapsedMs + 50) / 100;
    elapsedWhole := elapsedTenths / 10;
    elapsedFrac := elapsedTenths - elapsedWhole * 10;
    elapsedTag := " (" + elapsedWhole.toText() + "." + elapsedFrac.toText() + "s)";
    if failures > 0 {
        io.outputLine("verification failed: " + failures.toText() + " failing scenario(s), " + executed.toText() + " executed, " + cached.toText() + " cached" + elapsedTag);
        return 1;
    }
    if not updateMode {
        if executed == 0 and cached == 0 {
            io.outputLine("verification passed: no selected scenarios");
        } else {
            io.outputLine("verification passed: " + executed.toText() + " executed, " + cached.toText() + " cached" + elapsedTag);
        }
    }
    0
};

runParallelShards := fn(
rootDir: String,
changed: Bool,
cache: Bool,
quiet: Bool,
hasFilter: Bool,
filter: String,
uncachedManifests: Int,
workerBudget: Int,
verifyStartNs: Int,
cacheFile: String,
passedKeysIn: Set<String>
): Int {
    mut passedKeys: Set<String> = passedKeysIn;
    workerCount := if uncachedManifests < workerBudget { uncachedManifests } else { workerBudget };
    shardTmp := fs.makeTempDir("lite-verify-shards-");
    if not shardTmp.ok {
        io.errorLine("lite verify: " + shardTmp.error);
        return 1;
    }

    isNative := proc.runtimeVersion() == "c11";
    workerBin := if isNative { proc.execPath() } else { project.nodeExecPath() };
    binLitePath := path.join(rootDir, "bin/lite");
    mut workerCmds: List<String> = [];
    mut workerArgsJson: List<String> = [];
    mut shardResultFiles: List<String> = [];

    var w := 1;
    loop w <= workerCount {
        mut wArgs: List<String> = [];
        if not isNative {
            mut wArgs.pushBack(json.quoteString(binLitePath));
            mut wArgs.pushBack(json.quoteString("verify"));
        }
        mut wArgs.pushBack(if changed { "\"--changed\"" } else { "\"--all\"" });
        if not cache { mut wArgs.pushBack("\"--no-cache\""); }
        if quiet { mut wArgs.pushBack("\"--quiet\""); }
        if hasFilter {
            mut wArgs.pushBack("\"--filter\"");
            mut wArgs.pushBack(json.quoteString(filter));
        }
        mut wArgs.pushBack("\"--jobs\"");
        mut wArgs.pushBack("\"1\"");
        mut wArgs.pushBack("\"--shard\"");
        mut wArgs.pushBack(json.quoteString(w.toText() + "/" + workerCount.toText()));
        resFile := path.join(shardTmp.path, "shard-" + w.toText() + ".json");
        mut wArgs.pushBack("\"--shard-result\"");
        mut wArgs.pushBack(json.quoteString(resFile));

        (mut workerCmds).pushBack(workerBin);
        mut workerArgsJson.pushBack("[" + wArgs.join(",") + "]");
        mut shardResultFiles.pushBack(resFile);
        w = w + 1;
    }

    poolRaw := pool.runPoolJson(workerCmds, workerArgsJson, rootDir, workerCount);
    poolOffsets := json.arrayOffsets(poolRaw, 0);
    if poolOffsets.length() =!= workerCount {
        _rmErr := fs.remove(shardTmp.path);
        io.errorLine("lite verify: parallel worker pool returned malformed result count");
        return 1;
    }

    var failures := 0;
    var executed := 0;
    var cached := 0;
    var cacheDirty := false;

    var idx := 0;
    loop idx < workerCount {
        elemPos := poolOffsets[idx];
        statusRes := json.readFieldInt(poolRaw, elemPos, "status");
        outRes := json.readFieldString(poolRaw, elemPos, "stdout");
        errRes := json.readFieldString(poolRaw, elemPos, "stderr");
        errorRes := json.readFieldString(poolRaw, elemPos, "error");
        wStatus := if statusRes.found and statusRes.ok { statusRes.value } else { -1 };
        wErr := if errorRes.found and errorRes.ok { errorRes.value } else { "" };
        wOut := if outRes.found and outRes.ok { outRes.value } else { "" };
        wStderr := if errRes.found and errRes.ok { errRes.value } else { "" };

        trimmedOut := wOut.trimEnd();
        if trimmedOut =!= "" {
            io.outputLine(trimmedOut);
        }
        trimmedErr := wStderr.trimEnd();
        if trimmedErr =!= "" {
            io.errorLine(trimmedErr);
        }

        var shardFailures := 0;
        var hasShardReport := false;
        shardRead := fs.readText(shardResultFiles[idx]);
        if shardRead.ok and json.validate(shardRead.text).ok and json.kindAt(shardRead.text, 0) == .Object {
            hasShardReport = true;
            execRes := json.readFieldInt(shardRead.text, 0, "executed");
            if execRes.found and execRes.ok { executed = executed + execRes.value; }
            cachRes := json.readFieldInt(shardRead.text, 0, "cached");
            if cachRes.found and cachRes.ok { cached = cached + cachRes.value; }
            failRes := json.readFieldInt(shardRead.text, 0, "failures");
            if failRes.found and failRes.ok { shardFailures = failRes.value; }
            failures = failures + shardFailures;
            loop readStringArrayField(shardRead.text, 0, "added") as ak {
                mut passedKeys.add(ak);
                cacheDirty = true;
            }
            loop readStringArrayField(shardRead.text, 0, "removed") as rk {
                _rmk := mut passedKeys.remove(rk);
                cacheDirty = true;
            }
        }

        if (wStatus =!= 0 or wErr =!= "") and (not hasShardReport or shardFailures == 0) {
            if wErr =!= "" {
                io.errorLine("lite verify: shard " + (idx + 1).toText() + " failed: " + wErr);
            } else if trimmedErr == "" {
                io.errorLine("lite verify: shard " + (idx + 1).toText() + " exited with status " + wStatus.toText());
            }
            failures = failures + 1;
        }
        idx = idx + 1;
    }

    _rmTmp := fs.remove(shardTmp.path);
    if cacheDirty and cache {
        saveVerifyCache(cacheFile, passedKeys);
    }
    finishVerificationSummary(verifyStartNs, failures, executed, cached, false)
};

shardMatches := fn(manifestId: String, scenarioName: String, hasShard: Bool, shardIndex: Int, shardCount: Int): Bool {
    if not hasShard { return true; }
    digest := crypto.sha256Text(manifestId + "/" + scenarioName);
    var val := 0;
    var i := 0;
    loop i < 8 {
        ch := digest.at(i);
        d := if ch.isDigit() {
            ch.digitValue()
        } else if ch == "a" { 10 } else if ch == "b" { 11 } else if ch == "c" { 12 } else if ch == "d" { 13 } else if ch == "e" { 14 } else { 15 };
        val = val * 16 + d;
        i = i + 1;
    }
    (val % shardCount) == (shardIndex - 1)
};

readGitStatus := fn(rootDir: String): (ok: Bool, stdout: String) {
    gitArgs: List<String> = ["status", "--porcelain"];
    emptyEnv: List<String> = [];
    res := proc.run("git", gitArgs, rootDir, emptyEnv, true, "");
    if res.error =!= "" or res.status =!= 0 {
        return (ok = false, stdout = "");
    }
    (ok = true, stdout = res.stdout)
};

lastIndexOfText := fn(haystack: String, needle: String): Int {
    var last := -1;
    var pos := 0;
    loop true {
        idx := haystack.indexOf(needle, pos);
        if idx < 0 { break; }
        last = idx;
        pos = idx + 1;
    }
    last
};

parseGitStatusPaths := fn(stdout: String): List<String> {
    mut paths: List<String> = [];
    size := stdout.length();
    var pos := 0;
    loop pos < size {
        nl := stdout.indexOf("\n", pos);
        end := if nl < 0 { size } else { nl };
        line := stdout.slice(pos, end);
        if line.trim() =!= "" and line.length() > 3 {
            var p := line.slice(3, line.length()).trim();
            arrow := lastIndexOfText(p, " -> ");
            if arrow >= 0 {
                p = p.slice(arrow + 4, p.length());
            }
            if p.length() >= 2 and p.startsWithAt(0, "\"") and p.endsWith("\"") {
                p = p.slice(1, p.length() - 1);
            }
            (mut paths).pushBack(p);
        }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    paths
};

invalidatesVerification := fn(relPath: String): Bool {
    exact: List<String> = [
    "igniter/artifacts.ts",
    "igniter/tsconfig.json",
    "igniter/package-lock.json",
    "language/verifications/features.json",
    "language/verifications/schema/verification.schema.json",
    "tools/src/internal/compiler-build.lt",
    "tools/src/compiler-build.lts",
    "tools/src/ignite.lts",
    "tools/src/verify.lts",
    "tools/src/internal/verify.lt",
    "tools/src/internal/cases.lt",
    "tools/src/internal/streams.lt",
    "lib/data/json.lt"
    ];
    if exact.contains(relPath) { return true; }
    prefixes: List<String> = [
    "lib/lite/compiler/",
    "compiler/bootstrap/",
    "compiler/manifests/",
    "lib/core/",
    "lib/external/"
    ];
    loop prefixes as prefix {
        if relPath.startsWithAt(0, prefix) { return true; }
    }
    false
};

manifestMatchesFilter := fn(rootDir: String, file: String, manifestId: String, srcText: String, hasFilter: Bool, filter: String): Bool {
    if not hasFilter { return true; }
    relFile := path.relative(rootDir, file);
    if cases.globMatch(manifestId, filter) or cases.globMatch(relFile, filter) { return true; }
    loop readStringArrayField(srcText, 0, "features") as feat {
        if cases.globMatch(feat, filter) { return true; }
    }
    false
};

caseCacheKey := fn(runtimeHash: String, manifestId: String, kind: String, sourceHash: String, appendText: String, srcText: String, sPos: Int): String {
    stdinField := json.findField(srcText, sPos, "stdin");
    stdoutField := json.findField(srcText, sPos, "stdout");
    stderrField := json.findField(srcText, sPos, "stderr");
    argsField := json.findField(srcText, sPos, "args");
    exitCode := json.readFieldInt(srcText, sPos, "exitCode").value;

    stdinPart := if stdinField.found {
        sp := json.valueSpan(srcText, stdinField.valuePos);
        "\"stdin\":" + srcText.slice(sp.start, sp.end) + ","
    } else { "" };
    argsPart := if argsField.found {
        ap := json.valueSpan(srcText, argsField.valuePos);
        "\"args\":" + srcText.slice(ap.start, ap.end) + ","
    } else { "" };
    stdoutPart := if stdoutField.found {
        op := json.valueSpan(srcText, stdoutField.valuePos);
        "\"stdout\":" + srcText.slice(op.start, op.end) + ","
    } else { "" };
    stderrPart := if stderrField.found {
        ep := json.valueSpan(srcText, stderrField.valuePos);
        "\"stderr\":" + srcText.slice(ep.start, ep.end) + ","
    } else { "" };
    payload := "{" + stdinPart + argsPart + stdoutPart + stderrPart + "\"exitCode\":" + exitCode.toText() + "}";
    crypto.sha256Text(runtimeHash + "ts" + manifestId + kind + sourceHash + appendText + payload)
};

formatStringArrayJson := fn(items: List<String>, indent: String): String {
    if items.length() == 0 { return "[]"; }
    mut quoted: List<String> = [];
    loop items as item {
        mut quoted.pushBack(indent + "  " + json.quoteString(item));
    }
    "[\n" + quoted.join(",\n") + "\n" + indent + "]"
};

formatBytesArrayJson := fn(bytes: List<Int>, indent: String): String {
    if bytes.length() == 0 { return "[]"; }
    mut parts: List<String> = [];
    loop bytes as b {
        mut parts.pushBack(indent + "  " + b.toText());
    }
    "[\n" + parts.join(",\n") + "\n" + indent + "]"
};

formatStreamJson := fn(srcText: String, streamPos: Int, baseDir: String, indent: String, hasActual: Bool, actualBytes: List<Int>, isInput: Bool): String {
    if not hasActual and isInput {
        if json.findField(srcText, streamPos, "file").found {
            f := json.readFieldString(srcText, streamPos, "file").value;
            h := "sha256:" + crypto.sha256Bytes(streams.readStreamBytes(srcText, streamPos, baseDir));
            return "{\n" + indent + "  \"file\": " + json.quoteString(f) + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}";
        }
        if json.findField(srcText, streamPos, "bytes").found {
            bs := streams.readStreamBytes(srcText, streamPos, baseDir);
            h := "sha256:" + crypto.sha256Bytes(bs);
            return "{\n" + indent + "  \"bytes\": " + formatBytesArrayJson(bs, indent + "  ") + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}";
        }
        t := json.readFieldString(srcText, streamPos, "text").value;
        h := "sha256:" + crypto.sha256Text(t);
        return "{\n" + indent + "  \"text\": " + json.quoteString(t) + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}";
    }
    h := "sha256:" + crypto.sha256Bytes(actualBytes);
    if streamPos >= 0 and json.findField(srcText, streamPos, "file").found {
        f := json.readFieldString(srcText, streamPos, "file").value;
        _w := fs.writeBytes(path.resolve(baseDir, f), actualBytes);
        return "{\n" + indent + "  \"file\": " + json.quoteString(f) + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}";
    }
    if streamPos >= 0 and json.findField(srcText, streamPos, "bytes").found {
        return "{\n" + indent + "  \"bytes\": " + formatBytesArrayJson(actualBytes, indent + "  ") + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}";
    }
    decoded := String.fromUtf8Lossy(actualBytes);
    "{\n" + indent + "  \"text\": " + json.quoteString(decoded) + ",\n" + indent + "  \"hash\": " + json.quoteString(h) + "\n" + indent + "}"
};

formatScenarioSpanJson := fn(srcText: String, sPos: Int): String {
    sp := json.valueSpan(srcText, sPos);
    srcText.slice(sp.start, sp.end)
};

formatUpdatedScenarioJson := fn(
srcText: String, sPos: Int, baseDir: String,
actualStdout: List<Int>, actualStderr: List<Int>, actualExit: Int
): String {
    emptyBytes: List<Int> = [];
    mut fields: List<String> = [];
    sName := json.readFieldString(srcText, sPos, "name").value;
    mut fields.pushBack("      \"name\": " + json.quoteString(sName));

    argsField := json.findField(srcText, sPos, "args");
    if argsField.found {
        mut fields.pushBack("      \"args\": " + formatStringArrayJson(readStringArrayField(srcText, sPos, "args"), "      "));
    }
    stdinField := json.findField(srcText, sPos, "stdin");
    if stdinField.found {
        mut fields.pushBack("      \"stdin\": " + formatStreamJson(srcText, stdinField.valuePos, baseDir, "      ", false, emptyBytes, true));
    }
    stdoutField := json.findField(srcText, sPos, "stdout");
    if stdoutField.found or actualStdout.length() > 0 {
        outPos := if stdoutField.found { stdoutField.valuePos } else { -1 };
        mut fields.pushBack("      \"stdout\": " + formatStreamJson(srcText, outPos, baseDir, "      ", true, actualStdout, false));
    }
    stderrField := json.findField(srcText, sPos, "stderr");
    if stderrField.found or actualStderr.length() > 0 {
        errPos := if stderrField.found { stderrField.valuePos } else { -1 };
        mut fields.pushBack("      \"stderr\": " + formatStreamJson(srcText, errPos, baseDir, "      ", true, actualStderr, false));
    }
    (mut fields).pushBack("      \"exitCode\": " + actualExit.toText());
    "    {\n" + fields.join(",\n") + "\n    }"
};

formatUpdatedManifestJson := fn(srcText: String, sourceHash: String, scenariosJson: List<String>): String {
    mut fields: List<String> = [];
    idVal := json.readFieldString(srcText, 0, "id").value;
    kindVal := json.readFieldString(srcText, 0, "kind").value;
    mut fields.pushBack("  \"id\": " + json.quoteString(idVal));
    mut fields.pushBack("  \"kind\": " + json.quoteString(kindVal));

    sourceField := json.findField(srcText, 0, "source");
    mut srcParts: List<String> = [];
    if json.findField(srcText, sourceField.valuePos, "file").found {
        mut srcParts.pushBack("    \"file\": " + json.quoteString(json.readFieldString(srcText, sourceField.valuePos, "file").value));
    } else if json.findField(srcText, sourceField.valuePos, "text").found {
        mut srcParts.pushBack("    \"text\": " + json.quoteString(json.readFieldString(srcText, sourceField.valuePos, "text").value));
    } else {
        bField := json.findField(srcText, sourceField.valuePos, "bytes");
        emptyDir := "";
        bs := streams.readStreamBytes(srcText, sourceField.valuePos, emptyDir);
        _unused := bField.found;
        mut srcParts.pushBack("    \"bytes\": " + formatBytesArrayJson(bs, "    "));
    }
    (mut srcParts).pushBack("    \"hash\": " + json.quoteString(sourceHash));
    mut fields.pushBack("  \"source\": {\n" + srcParts.join(",\n") + "\n  }");

    mut fields.pushBack("  \"features\": " + formatStringArrayJson(readStringArrayField(srcText, 0, "features"), "  "));

    guideField := json.findField(srcText, 0, "guideline");
    if guideField.found {
        mut fields.pushBack("  \"guideline\": " + json.quoteString(json.readStringAt(srcText, guideField.valuePos).value));
    }
    descField := json.findField(srcText, 0, "description");
    if descField.found {
        mut fields.pushBack("  \"description\": " + json.quoteString(json.readStringAt(srcText, descField.valuePos).value));
    }
    appField := json.findField(srcText, 0, "append");
    if appField.found {
        mut fields.pushBack("  \"append\": " + json.quoteString(json.readStringAt(srcText, appField.valuePos).value));
    }
    targetsField := json.findField(srcText, 0, "targets");
    if targetsField.found {
        mut fields.pushBack("  \"targets\": " + formatStringArrayJson(readStringArrayField(srcText, 0, "targets"), "  "));
    }
    (mut fields).pushBack("  \"cases\": [\n" + scenariosJson.join(",\n") + "\n  ]");
    "{\n" + fields.join(",\n") + "\n}\n"
};

describeBytes := fn(bytes: List<Int>): String {
    json.quoteString(String.fromUtf8Lossy(bytes))
};

compileManifestArtifactOpt := fn(
rootDir: String, compilerPath: String, workDir: String,
sourceText: String, hasSourceFile: Bool, sourcePath: String, optLevel: Int
): (ok: Bool, artifactPath: String, compileNs: Int, emittedBytes: Int, error: String) {
    displayName := if hasSourceFile { path.relative(rootDir, sourcePath) } else { "" };
    absRootPath := if hasSourceFile { sourcePath } else { path.join(rootDir, "__lite_stdin__.lts") };
    lvText := optLevel.toText();
    outTsPath := path.join(workDir, "artifact-O" + lvText + ".ts");
    errPath := path.join(workDir, "compile-O" + lvText + ".stderr");
    emptyEnv: List<String> = [];
    compArgs: List<String> = [compilerPath, "--stdin", "--name", displayName, "--root", absRootPath, "-O" + lvText];
    startNs := time.monotonicNs();
    compiled := proc.runBytes(project.nodeExecPath(), compArgs, rootDir, emptyEnv, 0, sourceText.utf8Encode(), outTsPath, errPath);
    elapsedNs := time.monotonicNs() - startNs;
    if compiled.error =!= "" {
        return (ok = false, artifactPath = "", compileNs = elapsedNs, emittedBytes = 0, error = compiled.error);
    }
    if compiled.status =!= 0 {
        errRead := fs.readText(errPath);
        diag := if errRead.ok { errRead.text.trim() } else { "compilation error" };
        return (ok = false, artifactPath = "", compileNs = elapsedNs, emittedBytes = 0, error = "compiler -O" + lvText + " exited " + compiled.status.toText() + ": " + diag);
    }
    emittedBytes := fs.readBytes(outTsPath).length();
    (ok = true, artifactPath = outTsPath, compileNs = elapsedNs, emittedBytes = emittedBytes, error = "")
};

formatTenthMs := fn(ns: Int): String {
    tenths := (ns + 50000) / 100000;
    whole := tenths / 10;
    frac := tenths % 10;
    whole.toText() + "." + frac.toText()
};

padRight := fn(s: String, width: Int): String {
    var out := s;
    loop out.length() < width {
        out = out + " ";
    }
    out
};

printPedanticBenchmark := fn(
manifestCount: Int, scenarioCount: Int,
totalCompileNs: List<Int>, totalRunNs: List<Int>, totalBytes: List<Int>
): Unit {
    io.outputLine("");
    io.outputLine("Pedantic optimization benchmark (" + manifestCount.toText() + " manifest(s), " + scenarioCount.toText() + " scenario(s) x 4 levels):");
    io.outputLine("  " + padRight("Level", 8) + padRight("Compile(ms)", 14) + padRight("AvgComp(ms)", 14) + padRight("Run(ms)", 12) + padRight("AvgRun(ms)", 12) + "Emitted(bytes)");
    var lv := 0;
    loop lv < 4 {
        cNs := totalCompileNs[lv];
        rNs := totalRunNs[lv];
        avgComp := if manifestCount > 0 { cNs / manifestCount } else { 0 };
        avgRun := if scenarioCount > 0 { rNs / scenarioCount } else { 0 };
        io.outputLine(
        "  "
        + padRight("-O" + lv.toText(), 8)
        + padRight(formatTenthMs(cNs), 14)
        + padRight(formatTenthMs(avgComp), 14)
        + padRight(formatTenthMs(rNs), 12)
        + padRight(formatTenthMs(avgRun), 12)
        + totalBytes[lv].toText()
        );
        lv = lv + 1;
    }
};

probeCcBin := fn(): String {
    emptyEnv: List<String> = [];
    res := proc.run("cc", ["--version"], proc.cwd(), emptyEnv, true, "");
    if res.error == "" and res.status == 0 { "cc" } else { "" }
};

manifestIncludesC := fn(mText: String): Bool {
    targetsField := json.findField(mText, 0, "targets");
    if not targetsField.found { return true; }
    readStringArrayField(mText, 0, "targets").contains("c")
};

compileManifestArtifactC := fn(
rootDir: String, cCompilerPath: String, ccBin: String, workDir: String,
sourceText: String, hasSourceFile: Bool, sourcePath: String
): (ok: Bool, binaryPath: String, error: String) {
    displayName := if hasSourceFile { path.relative(rootDir, sourcePath) } else { "" };
    absRootPath := if hasSourceFile { sourcePath } else { path.join(rootDir, "__lite_stdin__.lts") };
    outCPath := path.join(workDir, "artifact.c");
    errCPath := path.join(workDir, "compile-c.stderr");
    emptyEnv: List<String> = [];
    compArgs: List<String> = [cCompilerPath, "--stdin", "--name", displayName, "--root", absRootPath, "-O1"];
    compiled := proc.runBytes(project.nodeExecPath(), compArgs, rootDir, emptyEnv, 0, sourceText.utf8Encode(), outCPath, errCPath);
    if compiled.error =!= "" {
        return (ok = false, binaryPath = "", error = compiled.error);
    }
    if compiled.status =!= 0 {
        errRead := fs.readText(errCPath);
        diag := if errRead.ok { errRead.text.trim() } else { "C compilation error" };
        return (ok = false, binaryPath = "", error = "C compiler exited " + compiled.status.toText() + ": " + diag);
    }
    outBinPath := path.join(workDir, "program-c");
    ccOutPath := path.join(workDir, "cc.stdout");
    ccErrPath := path.join(workDir, "cc.stderr");
    emptyBytes: List<Int> = [];
    ccArgs: List<String> = ["-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", outCPath, "-o", outBinPath, "-lm"];
    ccRes := proc.runBytes(ccBin, ccArgs, workDir, emptyEnv, 30000, emptyBytes, ccOutPath, ccErrPath);
    if ccRes.error =!= "" {
        return (ok = false, binaryPath = "", error = ccRes.error);
    }
    if ccRes.status =!= 0 {
        errRead := fs.readText(ccErrPath);
        diag := if errRead.ok { errRead.text.trim() } else { "cc error" };
        return (ok = false, binaryPath = "", error = "cc -std=c11 -Wall -Wextra -Werror exited " + ccRes.status.toText() + ":\n" + diag);
    }
    (ok = true, binaryPath = outBinPath, error = "")
};

runCArtifactScenario := fn(
binaryPath: String, workDir: String,
stdinBytes: List<Int>, scenarioArgs: List<String>, idx: Int
): (ok: Bool, outPath: String, errPath: String, exitCode: Int, error: String) {
    outPath := path.join(workDir, "run-c-" + idx.toText() + ".stdout");
    errPath := path.join(workDir, "run-c-" + idx.toText() + ".stderr");
    emptyEnv: List<String> = [];
    res := proc.runBytes(binaryPath, scenarioArgs, workDir, emptyEnv, 10000, stdinBytes, outPath, errPath);
    if res.error =!= "" {
        return (ok = false, outPath = outPath, errPath = errPath, exitCode = res.status, error = res.error);
    }
    (ok = true, outPath = outPath, errPath = errPath, exitCode = res.status, error = "")
};

compileManifestArtifact := fn(
rootDir: String, compilerPath: String, workDir: String,
sourceText: String, hasSourceFile: Bool, sourcePath: String
): (ok: Bool, artifactPath: String, error: String) {
    displayName := if hasSourceFile { path.relative(rootDir, sourcePath) } else { "" };
    absRootPath := if hasSourceFile { sourcePath } else { path.join(rootDir, "__lite_stdin__.lts") };
    outTsPath := path.join(workDir, "artifact.ts");
    errPath := path.join(workDir, "compile.stderr");
    emptyEnv: List<String> = [];
    compArgs: List<String> = [compilerPath, "--stdin", "--name", displayName, "--root", absRootPath];
    compiled := proc.runBytes(project.nodeExecPath(), compArgs, rootDir, emptyEnv, 0, sourceText.utf8Encode(), outTsPath, errPath);
    if compiled.error =!= "" {
        return (ok = false, artifactPath = "", error = compiled.error);
    }
    if compiled.status =!= 0 {
        errRead := fs.readText(errPath);
        diag := if errRead.ok { errRead.text.trim() } else { "compilation error" };
        return (ok = false, artifactPath = "", error = "compiler exited " + compiled.status.toText() + ": " + diag);
    }
    tsChecked := cases.checkTsArtifactFile(rootDir, outTsPath, path.join(workDir, "tsc"));
    if not tsChecked.ok {
        return (ok = false, artifactPath = "", error = "generated TS failed strict checking:\n" + tsChecked.error);
    }
    wPkg := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    if not wPkg.ok {
        return (ok = false, artifactPath = "", error = wPkg.error);
    }
    (ok = true, artifactPath = outTsPath, error = "")
};

runArtifactScenario := fn(
rootDir: String, artifactPath: String, workDir: String,
stdinBytes: List<Int>, scenarioArgs: List<String>, idx: Int
): (ok: Bool, outPath: String, errPath: String, exitCode: Int, error: String) {
    runnerPath := path.join(workDir, "runner.ts");
    _wRun := cases.writeTsRunner(runnerPath);
    mut runArgs: List<String> = [runnerPath, artifactPath];
    loop scenarioArgs as arg {
        mut runArgs.pushBack(arg);
    }
    outPath := path.join(workDir, "run-" + idx.toText() + ".stdout");
    errPath := path.join(workDir, "run-" + idx.toText() + ".stderr");
    emptyEnv: List<String> = [];
    res := proc.runBytes(project.nodeExecPath(), runArgs, workDir, emptyEnv, 10000, stdinBytes, outPath, errPath);
    if res.error =!= "" {
        return (ok = false, outPath = outPath, errPath = errPath, exitCode = -1, error = "generated TS artifact failed: " + res.error);
    }
    if res.status < 0 {
        return (ok = false, outPath = outPath, errPath = errPath, exitCode = -1, error = "generated TS artifact failed: terminated");
    }
    (ok = true, outPath = outPath, errPath = errPath, exitCode = res.status, error = "")
};

/** Executes `lite verify` over `language/verifications` under `rootDir` and returns process exit status. */
pub runVerification := fn(rootDir: String, args: List<String>): Int {
    verifyStartNs := time.monotonicNs();
    opts := parseVerifyArgs(args);
    if not opts.ok {
        io.errorLine("lite verify: " + opts.error);
        io.errorLine(usageText());
        return 2;
    }
    if opts.help {
        io.outputLine(usageText());
        return 0;
    }

    isWorker := opts.shardResult =!= "";
    reg := validateRegistry(rootDir);
    if not reg.ok {
        io.errorLine("lite verify: " + reg.error);
        return 2;
    }
    featureIds := registryFeatureIds(reg.text, false);
    mut featureIdSet: Set<String>;
    loop featureIds as fid { mut featureIdSet.add(fid); }
    verifiedIds := registryFeatureIds(reg.text, true);
    if not isWorker {
        allCheck := validateAllManifests(rootDir, featureIdSet, verifiedIds);
        if not allCheck.ok {
            io.errorLine("lite verify: " + allCheck.error);
            return 2;
        }
    }

    if opts.coverage {
        return runCoverage(rootDir, featureIds);
    }

    compBuild := resolveCompilerBuild(rootDir);
    if not compBuild.ok {
        io.errorLine("lite verify: " + compBuild.error);
        return 1;
    }
    ccBin := probeCcBin();
    var cCompPath := "";
    if ccBin =!= "" and not opts.update and not opts.pedantic {
        cBuilt := compilerBuild.buildCompiler(rootDir, "c");
        if not cBuilt.ok {
            io.errorLine("lite verify: C compiler build failed: " + cBuilt.error);
            return 1;
        }
        cCompPath = cBuilt.path;
    }
    compilerDeps := readStringArrayField(compBuild.metaJson, 0, "dependencies");
    rtHash := computeRuntimeHash(rootDir, compilerDeps);
    if not rtHash.ok {
        io.errorLine("lite verify: " + rtHash.error);
        return 1;
    }

    cacheEnv := proc.envGet("LITE_VERIFY_CACHE");
    cacheFile := if cacheEnv.found and cacheEnv.value =!= "" {
        path.resolve(proc.cwd(), cacheEnv.value)
    } else {
        path.join(rootDir, "dist/verifications.json")
    };
    mut passedKeys: Set<String> = loadVerifyCache(cacheFile, not opts.update and opts.cache);
    var cacheDirty := false;

    var hasGitChanges := false;
    mut gitPaths: Set<String>;
    var invalidateAll := false;
    mut changedFeatures: Set<String>;
    if opts.changed {
        gitRes := readGitStatus(rootDir);
        if gitRes.ok {
            hasGitChanges = true;
            loop parseGitStatusPaths(gitRes.stdout) as gp {
                mut gitPaths.add(gp);
                if invalidatesVerification(gp) {
                    invalidateAll = true;
                }
            }
            if not invalidateAll {
                loop collectKindManifests(rootDir, KIND_FEATURE) as fFile {
                    relMan := path.relative(rootDir, fFile);
                    fText := fs.readText(fFile).text;
                    fId := json.readFieldString(fText, 0, "id").value;
                    sf := json.findField(fText, 0, "source");
                    sFileRes := json.readFieldString(fText, sf.valuePos, "file");
                    srcHit := sFileRes.found and gitPaths.has(path.relative(rootDir, path.resolve(path.parentDir(fFile), sFileRes.value)));
                    if gitPaths.has(relMan) or srcHit {
                        mut changedFeatures.add(fId);
                    }
                }
            }
        }
    }

    var failures := 0;
    var executed := 0;
    var cached := 0;
    var pedanticManifests := 0;
    var pedanticScenarios := 0;
    mut pedanticCompileNs: List<Int> = [0, 0, 0, 0];
    mut pedanticRunNs: List<Int> = [0, 0, 0, 0];
    mut pedanticBytes: List<Int> = [0, 0, 0, 0];

    dirKinds: List<String> = [KIND_FEATURE, KIND_EXAMPLE, KIND_SAMPLE, KIND_SHOWCASE];
    workerBudget := if opts.jobs > 0 { opts.jobs } else { pool.cpuCount() };
    if not isWorker and not opts.hasShard and not opts.update and not opts.pedantic and workerBudget > 1 {
        var uncachedManifests := 0;
        loop dirKinds as mKind {
            if uncachedManifests >= workerBudget { break; }
            loop collectKindManifests(rootDir, mKind) as mFile {
                meta := validateManifestText(rootDir, mFile, mKind, featureIdSet);
                mId := meta.id;
                mText := meta.text;
                mDir := path.parentDir(mFile);
                if not isManifestSelected(rootDir, mFile, mId, mText, meta.hasSourceFile, meta.sourcePath, opts.hasFilter, opts.filter, hasGitChanges, invalidateAll, gitPaths, changedFeatures) {
                    continue;
                }
                casesField := json.findField(mText, 0, "cases");
                allScenarios := json.arrayOffsets(mText, casesField.valuePos);
                if allScenarios.length() == 0 { continue; }
                if not opts.cache {
                    uncachedManifests = uncachedManifests + 1;
                } else {
                    sourceField := json.findField(mText, 0, "source");
                    sourceBytes := if meta.hasSourceFile {
                        fs.readBytes(meta.sourcePath)
                    } else {
                        streams.readStreamBytes(mText, sourceField.valuePos, mDir)
                    };
                    sourceHash := "sha256:" + crypto.sha256Bytes(sourceBytes);
                    if meta.sourceHashField =!= sourceHash {
                        uncachedManifests = uncachedManifests + 1;
                    } else {
                        hasC := manifestIncludesC(mText) and cCompPath =!= "" and ccBin =!= "";
                        var manUncached := false;
                        loop allScenarios as sPos {
                            kTs := caseCacheKey(rtHash.hex, mId, mKind, sourceHash, meta.appendText, mText, sPos);
                            if not passedKeys.has(kTs) {
                                manUncached = true;
                                break;
                            }
                            if hasC {
                                kC := caseCacheKey(rtHash.hex + "|c", mId, mKind, sourceHash, meta.appendText, mText, sPos);
                                if not passedKeys.has(kC) {
                                    manUncached = true;
                                    break;
                                }
                            }
                        }
                        if manUncached { uncachedManifests = uncachedManifests + 1; }
                    }
                }
                if uncachedManifests >= workerBudget { break; }
            }
        }
        if uncachedManifests >= 4 {
            return runParallelShards(
            rootDir, opts.changed, opts.cache, opts.quiet, opts.hasFilter, opts.filter,
            uncachedManifests, workerBudget, verifyStartNs, cacheFile, passedKeys
            );
        }
    }

    mut passedAdded: List<String> = [];
    mut passedRemoved: List<String> = [];

    loop dirKinds as mKind {
        loop collectKindManifests(rootDir, mKind) as mFile {
            meta := validateManifestText(rootDir, mFile, mKind, featureIdSet);
            mId := meta.id;
            mText := meta.text;
            mDir := path.parentDir(mFile);

            selectedManifest := isManifestSelected(
            rootDir, mFile, mId, mText, meta.hasSourceFile, meta.sourcePath,
            opts.hasFilter, opts.filter, hasGitChanges, invalidateAll, gitPaths, changedFeatures
            );

            if selectedManifest {
                casesField := json.findField(mText, 0, "cases");
                allScenarios := json.arrayOffsets(mText, casesField.valuePos);
                mut selectedOffsets: List<Int> = [];
                loop allScenarios as sPos {
                    sName := json.readFieldString(mText, sPos, "name").value;
                    if shardMatches(mId, sName, opts.hasShard, opts.shardIndex, opts.shardCount) {
                        mut selectedOffsets.pushBack(sPos);
                    }
                }

                if selectedOffsets.length() > 0 {
                    failuresBefore := failures;
                    sourceField := json.findField(mText, 0, "source");
                    sourceBytes := if meta.hasSourceFile {
                        fs.readBytes(meta.sourcePath)
                    } else {
                        streams.readStreamBytes(mText, sourceField.valuePos, mDir)
                    };
                    sourceHash := "sha256:" + crypto.sha256Bytes(sourceBytes);
                    fullSource := String.fromUtf8Lossy(sourceBytes) + (if meta.hasAppend { "\n" + meta.appendText } else { "" });

                    if not opts.update and meta.sourceHashField =!= sourceHash {
                        io.outputLine("FAIL " + mId + ": source hash changed; run ./bin/lite verify --update");
                        failures = failures + 1;
                    } else {
                        var needsArtifact := opts.update;
                        if not needsArtifact {
                            loop selectedOffsets as sPos {
                                k := caseCacheKey(rtHash.hex, mId, mKind, sourceHash, meta.appendText, mText, sPos);
                                if not opts.cache or not passedKeys.has(k) {
                                    needsArtifact = true;
                                    break;
                                }
                            }
                        }

                        var workDir := "";
                        var compileOk := true;
                        var compileError := "";
                        var artifactPath := "";
                        mut pedanticArtifacts: List<String> = [];
                        if needsArtifact {
                            tmpRes := fs.makeTempDir("lite-verify-");
                            if not tmpRes.ok {
                                compileOk = false;
                                compileError = tmpRes.error;
                            } else {
                                workDir = tmpRes.path;
                                if opts.pedantic {
                                    pedanticManifests = pedanticManifests + 1;
                                    var lv := 0;
                                    loop lv < 4 {
                                        cOpt := compileManifestArtifactOpt(rootDir, compBuild.compilerPath, workDir, fullSource, meta.hasSourceFile, meta.sourcePath, lv);
                                        pedanticCompileNs[lv] += cOpt.compileNs;
                                        if not cOpt.ok {
                                            compileOk = false;
                                            compileError = cOpt.error;
                                            break;
                                        }
                                        pedanticBytes[lv] += cOpt.emittedBytes;
                                        mut pedanticArtifacts.pushBack(cOpt.artifactPath);
                                        lv = lv + 1;
                                    }
                                    if compileOk {
                                        tsBatch := cases.checkTsArtifactFilesWithStatus(rootDir, pedanticArtifacts, path.join(workDir, "tsc"), 0);
                                        if not tsBatch.ok {
                                            compileOk = false;
                                            compileError = "generated TS (-O0..-O3) failed strict checking:\n" + tsBatch.error;
                                        } else {
                                            wPkg := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
                                            if not wPkg.ok {
                                                compileOk = false;
                                                compileError = wPkg.error;
                                            }
                                        }
                                    }
                                } else {
                                    compRes := compileManifestArtifact(rootDir, compBuild.compilerPath, workDir, fullSource, meta.hasSourceFile, meta.sourcePath);
                                    if not compRes.ok {
                                        compileOk = false;
                                        compileError = compRes.error;
                                    } else {
                                        artifactPath = compRes.artifactPath;
                                    }
                                }
                            }
                        }

                        mut updatedScenarios: Map<String, String>;
                        var runSeq := 0;

                        loop selectedOffsets as sPos {
                            sName := json.readFieldString(mText, sPos, "name").value;
                            label := mId + "/" + sName + " [ts]";
                            cKey := caseCacheKey(rtHash.hex, mId, mKind, sourceHash, meta.appendText, mText, sPos);

                            if not opts.update and opts.cache and passedKeys.has(cKey) {
                                cached = cached + 1;
                                if not opts.quiet { io.outputLine("PASS " + label + " (cached)"); }
                            } else {
                                emptyBytes: List<Int> = [];
                                var streamsOk := true;
                                var expStdout := emptyBytes;
                                var expStderr := emptyBytes;
                                var inBytes := emptyBytes;

                                stdinField := json.findField(mText, sPos, "stdin");
                                if stdinField.found {
                                    stIn := checkVerifyStream(mText, stdinField.valuePos, mDir, "stdin", not opts.update, false);
                                    if not stIn.ok {
                                        streamsOk = false;
                                        io.outputLine("FAIL " + mId + "/" + sName + ": " + stIn.error);
                                        failures = failures + 1;
                                    } else {
                                        inBytes = streams.readStreamBytes(mText, stdinField.valuePos, mDir);
                                    }
                                }
                                if streamsOk and not opts.update {
                                    stdoutField := json.findField(mText, sPos, "stdout");
                                    if stdoutField.found {
                                        stOut := checkVerifyStream(mText, stdoutField.valuePos, mDir, mId + "/" + sName + "/stdout", true, false);
                                        if not stOut.ok {
                                            streamsOk = false;
                                            io.outputLine("FAIL " + mId + "/" + sName + ": " + stOut.error);
                                            failures = failures + 1;
                                        } else {
                                            expStdout = streams.readStreamBytes(mText, stdoutField.valuePos, mDir);
                                        }
                                    }
                                }
                                if streamsOk and not opts.update {
                                    stderrField := json.findField(mText, sPos, "stderr");
                                    if stderrField.found {
                                        stErr := checkVerifyStream(mText, stderrField.valuePos, mDir, mId + "/" + sName + "/stderr", true, false);
                                        if not stErr.ok {
                                            streamsOk = false;
                                            io.outputLine("FAIL " + mId + "/" + sName + ": " + stErr.error);
                                            failures = failures + 1;
                                        } else {
                                            expStderr = streams.readStreamBytes(mText, stderrField.valuePos, mDir);
                                        }
                                    }
                                }

                                if streamsOk {
                                    executed = executed + 1;
                                    if not compileOk {
                                        if not opts.update {
                                            _rmKey := mut passedKeys.remove(cKey);
                                            mut passedRemoved.pushBack(cKey);
                                            cacheDirty = true;
                                            io.outputLine("FAIL " + label + ": " + compileError);
                                        } else {
                                            io.outputLine("FAIL " + mId + "/" + sName + ": " + compileError);
                                        }
                                        failures = failures + 1;
                                    } else if opts.pedantic {
                                        pedanticScenarios = pedanticScenarios + 1;
                                        scenarioArgs := readStringArrayField(mText, sPos, "args");
                                        expExit := json.readFieldInt(mText, sPos, "exitCode").value;
                                        var allLevelsOk := true;
                                        var baseOutBytes := emptyBytes;
                                        var baseErrBytes := emptyBytes;
                                        var baseExitCode := 0;
                                        mut levelMsParts: List<String> = [];
                                        var lv := 0;
                                        loop lv < 4 {
                                            lvLabel := mId + "/" + sName + " [ts -O" + lv.toText() + "]";
                                            rStart := time.monotonicNs();
                                            ran := runArtifactScenario(rootDir, pedanticArtifacts[lv], workDir, inBytes, scenarioArgs, runSeq);
                                            rElapsed := time.monotonicNs() - rStart;
                                            runSeq = runSeq + 1;
                                            pedanticRunNs[lv] += rElapsed;
                                            if not ran.ok {
                                                io.outputLine("FAIL " + lvLabel + ": " + ran.error);
                                                allLevelsOk = false;
                                            } else {
                                                stdoutBytes := fs.readBytes(ran.outPath);
                                                stderrBytes := fs.readBytes(ran.errPath);
                                                if lv == 0 {
                                                    baseOutBytes = stdoutBytes;
                                                    baseErrBytes = stderrBytes;
                                                    baseExitCode = ran.exitCode;
                                                }
                                                sameOut := streams.equalBytes(stdoutBytes, expStdout);
                                                sameErr := streams.equalBytes(stderrBytes, expStderr);
                                                sameExit := ran.exitCode == expExit;
                                                sameAsO0 := lv == 0 or (
                                                streams.equalBytes(stdoutBytes, baseOutBytes)
                                                and streams.equalBytes(stderrBytes, baseErrBytes)
                                                and ran.exitCode == baseExitCode
                                                );
                                                if not sameOut or not sameErr or not sameExit or not sameAsO0 {
                                                    io.outputLine("FAIL " + lvLabel);
                                                    if not sameOut {
                                                        io.outputLine("  stdout expected " + describeBytes(expStdout) + " got " + describeBytes(stdoutBytes));
                                                    }
                                                    if not sameErr {
                                                        io.outputLine("  stderr expected " + describeBytes(expStderr) + " got " + describeBytes(stderrBytes));
                                                    }
                                                    if not sameExit {
                                                        io.outputLine("  exitCode expected " + expExit.toText() + " got " + ran.exitCode.toText());
                                                    }
                                                    if not sameAsO0 {
                                                        io.outputLine("  diverged from -O0 result");
                                                    }
                                                    allLevelsOk = false;
                                                } else {
                                                    mut levelMsParts.pushBack("O" + lv.toText() + ":" + formatTenthMs(rElapsed) + "ms");
                                                }
                                            }
                                            lv = lv + 1;
                                        }
                                        if not allLevelsOk {
                                            failures = failures + 1;
                                        } else if not opts.quiet {
                                            io.outputLine("PASS " + mId + "/" + sName + " [" + levelMsParts.join(" ") + "]");
                                        }
                                    } else {
                                        scenarioArgs := readStringArrayField(mText, sPos, "args");
                                        ran := runArtifactScenario(rootDir, artifactPath, workDir, inBytes, scenarioArgs, runSeq);
                                        runSeq = runSeq + 1;
                                        if not ran.ok {
                                            if not opts.update {
                                                _rmKey := mut passedKeys.remove(cKey);
                                                mut passedRemoved.pushBack(cKey);
                                                cacheDirty = true;
                                                io.outputLine("FAIL " + label + ": " + ran.error);
                                            } else {
                                                io.outputLine("FAIL " + mId + "/" + sName + ": " + ran.error);
                                            }
                                            failures = failures + 1;
                                        } else {
                                            stdoutBytes := fs.readBytes(ran.outPath);
                                            stderrBytes := fs.readBytes(ran.errPath);
                                            if opts.update {
                                                updatedScenarios[sName] = formatUpdatedScenarioJson(mText, sPos, mDir, stdoutBytes, stderrBytes, ran.exitCode);
                                            } else {
                                                expExit := json.readFieldInt(mText, sPos, "exitCode").value;
                                                sameOut := streams.equalBytes(stdoutBytes, expStdout);
                                                sameErr := streams.equalBytes(stderrBytes, expStderr);
                                                sameExit := ran.exitCode == expExit;
                                                if not sameOut or not sameErr or not sameExit {
                                                    _rmKey := mut passedKeys.remove(cKey);
                                                    mut passedRemoved.pushBack(cKey);
                                                    cacheDirty = true;
                                                    io.outputLine("FAIL " + label);
                                                    if not sameOut {
                                                        io.outputLine("  stdout expected " + describeBytes(expStdout) + " got " + describeBytes(stdoutBytes));
                                                    }
                                                    if not sameErr {
                                                        io.outputLine("  stderr expected " + describeBytes(expStderr) + " got " + describeBytes(stderrBytes));
                                                    }
                                                    if not sameExit {
                                                        io.outputLine("  exitCode expected " + expExit.toText() + " got " + ran.exitCode.toText());
                                                    }
                                                    failures = failures + 1;
                                                } else {
                                                    mut passedKeys.add(cKey);
                                                    mut passedAdded.pushBack(cKey);
                                                    cacheDirty = true;
                                                    if not opts.quiet { io.outputLine("PASS " + label); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if manifestIncludesC(mText) and cCompPath =!= "" and ccBin =!= "" and not opts.update and not opts.pedantic {
                            var needsCArtifact := false;
                            loop selectedOffsets as sPos {
                                kC := caseCacheKey(rtHash.hex + "|c", mId, mKind, sourceHash, meta.appendText, mText, sPos);
                                if not opts.cache or not passedKeys.has(kC) {
                                    needsCArtifact = true;
                                    break;
                                }
                            }
                            var cCompileOk := true;
                            var cCompileError := "";
                            var cBinaryPath := "";
                            if needsCArtifact {
                                if workDir == "" {
                                    tmpCRes := fs.makeTempDir("lite-verify-c-");
                                    if not tmpCRes.ok {
                                        cCompileOk = false;
                                        cCompileError = tmpCRes.error;
                                    } else {
                                        workDir = tmpCRes.path;
                                    }
                                }
                                if cCompileOk {
                                    cCompRes := compileManifestArtifactC(rootDir, cCompPath, ccBin, workDir, fullSource, meta.hasSourceFile, meta.sourcePath);
                                    if not cCompRes.ok {
                                        cCompileOk = false;
                                        cCompileError = cCompRes.error;
                                    } else {
                                        cBinaryPath = cCompRes.binaryPath;
                                    }
                                }
                            }
                            loop selectedOffsets as sPos {
                                sName := json.readFieldString(mText, sPos, "name").value;
                                cLabel := mId + "/" + sName + " [c]";
                                cKeyC := caseCacheKey(rtHash.hex + "|c", mId, mKind, sourceHash, meta.appendText, mText, sPos);
                                if opts.cache and passedKeys.has(cKeyC) {
                                    cached = cached + 1;
                                    if not opts.quiet { io.outputLine("PASS " + cLabel + " (cached)"); }
                                } else {
                                    emptyBytesC: List<Int> = [];
                                    var cStreamsOk := true;
                                    var cExpStdout := emptyBytesC;
                                    var cExpStderr := emptyBytesC;
                                    var cInBytes := emptyBytesC;
                                    cStdinF := json.findField(mText, sPos, "stdin");
                                    if cStdinF.found {
                                        cInBytes = streams.readStreamBytes(mText, cStdinF.valuePos, mDir);
                                    }
                                    cStdoutF := json.findField(mText, sPos, "stdout");
                                    if cStdoutF.found {
                                        cExpStdout = streams.readStreamBytes(mText, cStdoutF.valuePos, mDir);
                                    }
                                    cStderrF := json.findField(mText, sPos, "stderr");
                                    if cStderrF.found {
                                        cExpStderr = streams.readStreamBytes(mText, cStderrF.valuePos, mDir);
                                    }
                                    if cStreamsOk {
                                        executed = executed + 1;
                                        if not cCompileOk {
                                            _rmKeyC := mut passedKeys.remove(cKeyC);
                                            mut passedRemoved.pushBack(cKeyC);
                                            cacheDirty = true;
                                            io.outputLine("FAIL " + cLabel + ": " + cCompileError);
                                            failures = failures + 1;
                                        } else {
                                            cScenarioArgs := readStringArrayField(mText, sPos, "args");
                                            cRan := runCArtifactScenario(cBinaryPath, workDir, cInBytes, cScenarioArgs, runSeq);
                                            runSeq = runSeq + 1;
                                            if not cRan.ok {
                                                _rmKeyC := mut passedKeys.remove(cKeyC);
                                                mut passedRemoved.pushBack(cKeyC);
                                                cacheDirty = true;
                                                io.outputLine("FAIL " + cLabel + ": " + cRan.error);
                                                failures = failures + 1;
                                            } else {
                                                cStdoutBytes := fs.readBytes(cRan.outPath);
                                                cStderrBytes := fs.readBytes(cRan.errPath);
                                                cExpExit := json.readFieldInt(mText, sPos, "exitCode").value;
                                                cSameOut := streams.equalBytes(cStdoutBytes, cExpStdout);
                                                cSameErr := streams.equalBytes(cStderrBytes, cExpStderr);
                                                cSameExit := cRan.exitCode == cExpExit;
                                                if not cSameOut or not cSameErr or not cSameExit {
                                                    _rmKeyC := mut passedKeys.remove(cKeyC);
                                                    mut passedRemoved.pushBack(cKeyC);
                                                    cacheDirty = true;
                                                    io.outputLine("FAIL " + cLabel);
                                                    if not cSameOut {
                                                        io.outputLine("  stdout expected " + describeBytes(cExpStdout) + " got " + describeBytes(cStdoutBytes));
                                                    }
                                                    if not cSameErr {
                                                        io.outputLine("  stderr expected " + describeBytes(cExpStderr) + " got " + describeBytes(cStderrBytes));
                                                    }
                                                    if not cSameExit {
                                                        io.outputLine("  exitCode expected " + cExpExit.toText() + " got " + cRan.exitCode.toText());
                                                    }
                                                    failures = failures + 1;
                                                } else {
                                                    mut passedKeys.add(cKeyC);
                                                    mut passedAdded.pushBack(cKeyC);
                                                    cacheDirty = true;
                                                    if not opts.quiet { io.outputLine("PASS " + cLabel); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if workDir =!= "" {
                            _rm := fs.remove(workDir);
                        }

                        if opts.update and failures == failuresBefore {
                            mut finalScenarios: List<String> = [];
                            loop allScenarios as sPos {
                                sName := json.readFieldString(mText, sPos, "name").value;
                                upd := updatedScenarios.get(sName);
                                if upd.found {
                                    mut finalScenarios.pushBack(upd.value);
                                } else {
                                    mut finalScenarios.pushBack("    " + formatScenarioSpanJson(mText, sPos));
                                }
                            }
                            newManifest := formatUpdatedManifestJson(mText, sourceHash, finalScenarios);
                            wMan := fs.writeText(mFile, newManifest);
                            if not wMan.ok {
                                io.errorLine("lite verify: " + wMan.error);
                                return 1;
                            }
                            io.outputLine("updated " + path.relative(rootDir, mFile));
                        }
                    }
                }
            }
        }
    }

    if isWorker {
        writeShardResult(opts.shardResult, executed, cached, failures, passedAdded, passedRemoved);
        return if failures > 0 { 1 } else { 0 };
    }
    if cacheDirty and not opts.update and opts.cache {
        saveVerifyCache(cacheFile, passedKeys);
    }
    if opts.pedantic {
        printPedanticBenchmark(pedanticManifests, pedanticScenarios, pedanticCompileNs, pedanticRunNs, pedanticBytes);
    }
    finishVerificationSummary(verifyStartNs, failures, executed, cached, opts.update)
};
