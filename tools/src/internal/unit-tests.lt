/** Parallel unit test discovery and execution utilities for `.test.lts` files. */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
project := import "./project";
path := import "core/path";
pool := import "external/pool";
cases := import "./cases";
compilerBuild := import "./compiler-build";
json := import "data/json";

unitTestUsage := fn(): String {
    "Usage: ./bin/lite test --unit [--jobs N] [--verbose|--mute|--silence] [FILTER]"
};

isPositiveIntText := fn(raw: String): (ok: Bool, value: Int) {
    size := raw.length();
    if size == 0 { return (ok = false, value = 0); }
    var i := 0;
    loop i < size {
        ch := raw.at(i);
        if "0123456789".indexOf(ch, 0) < 0 { return (ok = false, value = 0); }
        i = i + 1;
    }
    parsed := json.readIntAt(raw, 0);
    if not parsed.ok or parsed.value < 1 { return (ok = false, value = 0); }
    (ok = true, value = parsed.value)
};

readWorkerFailureText := fn(errPath: String, outPath: String, fallback: String): String {
    errRes := fs.readText(errPath);
    if errRes.ok and errRes.text.trim() =!= "" { return errRes.text; }
    outRes := fs.readText(outPath);
    if outRes.ok and outRes.text.trim() =!= "" { return outRes.text; }
    fallback
};

/** Executes a single `--unit-worker <taskJson>` unit test compilation, strict TS check, and run. */
pub runUnitWorker := fn(taskJson: String): Int {
    valid := json.validate(taskJson);
    if not valid.ok {
        io.errorLine("unit worker: invalid task JSON: " + valid.error);
        return 1;
    }
    rootRes := json.readFieldString(taskJson, 0, "root");
    compRes := json.readFieldString(taskJson, 0, "compiler");
    fileRes := json.readFieldString(taskJson, 0, "file");
    if not rootRes.found or not rootRes.ok or not compRes.found or not compRes.ok or not fileRes.found or not fileRes.ok {
        io.errorLine("unit worker: task JSON requires root, compiler, and file");
        return 1;
    }

    rootDir := rootRes.value;
    compilerPath := compRes.value;
    relFile := fileRes.value;

    tmpRes := fs.makeTempDir("lite-unit-");
    if not tmpRes.ok {
        io.errorLine("unit worker: " + tmpRes.error);
        return 1;
    }
    workDir := tmpRes.path;

    pkgRes := fs.writeText(path.join(workDir, "package.json"), "{\"type\":\"module\"}\n");
    if not pkgRes.ok {
        _rmPkg := fs.remove(workDir);
        io.errorLine(pkgRes.error);
        return 1;
    }

    outTsPath := path.join(workDir, "unit.ts");
    compErrPath := path.join(workDir, "compile.stderr");
    emptyEnv: List<String> = [];
    emptyBytes: List<Int> = [];
    compArgs: List<String> = [compilerPath, relFile];
    comp := proc.runBytes(project.nodeExecPath(), compArgs, rootDir, emptyEnv, 60000, emptyBytes, outTsPath, compErrPath);
    if comp.error =!= "" or comp.status =!= 0 {
        msg := if comp.error =!= "" { comp.error } else { readWorkerFailureText(compErrPath, outTsPath, "compilation failed") };
        _rmComp := fs.remove(workDir);
        io.errorLine(msg.trimEnd());
        return if comp.status > 0 { comp.status } else { 1 };
    }

    checked := cases.checkTsArtifactFileWithStatus(rootDir, outTsPath, path.join(workDir, "tsc"), 60000);
    if not checked.ok {
        _rmChk := fs.remove(workDir);
        io.errorLine(checked.error.trimEnd());
        return 1;
    }

    runnerPath := path.join(workDir, "runner.ts");
    wRunner := cases.writeTsRunner(runnerPath);
    if not wRunner.ok {
        _rmWr := fs.remove(workDir);
        io.errorLine(wRunner.error);
        return 1;
    }

    runOutPath := path.join(workDir, "run.stdout");
    runErrPath := path.join(workDir, "run.stderr");
    runArgs: List<String> = [runnerPath, outTsPath];
    ran := proc.runBytes(project.nodeExecPath(), runArgs, rootDir, emptyEnv, 600000, emptyBytes, runOutPath, runErrPath);
    if ran.error =!= "" or ran.status =!= 0 {
        msg := if ran.error =!= "" { ran.error } else { readWorkerFailureText(runErrPath, runOutPath, "unit test failed") };
        _rmRun := fs.remove(workDir);
        if msg.trim() =!= "" {
            io.errorLine(msg.trimEnd());
        }
        return if ran.status > 0 { ran.status } else { 1 };
    }

    _rmOk := fs.remove(workDir);
    0
};

/** True when `relFile` spawns nested CLI/smoke suites and must run serially after parallel unit tests. */
isSerialUnitTest := fn(relFile: String): Bool {
    relFile == "tools/cli.test.lts" or relFile == "compiler/tests/cli-contracts.test.lts"
};

/** Executes one batch of `.test.lts` files through `external/pool` with concurrency `batchJobs`. */
runUnitBatch := fn(
rootDir: String, compilerPath: String, runnerScript: String, batchRel: List<String>, batchJobs: Int, outputMode: String
): (ok: Bool, passed: Int, failed: Int) {
    count := batchRel.length();
    if count == 0 {
        return (ok = true, passed = 0, failed = 0);
    }

    rpRunner := fs.realPath(runnerScript);
    isNodeRunner := if rpRunner.ok {
        rpRunner.path.endsWith(".ts") or rpRunner.path.endsWith(".js")
    } else {
        runnerScript.endsWith(".ts") or runnerScript.endsWith(".js")
    };
    mut commands: List<String> = [];
    mut argListsJson: List<String> = [];
    loop batchRel as relFile {
        taskJson := "{\"root\":" + json.quoteString(rootDir)
        + ",\"compiler\":" + json.quoteString(compilerPath)
        + ",\"file\":" + json.quoteString(relFile) + "}";
        if isNodeRunner {
            argJson := "[" + json.quoteString(runnerScript) + ",\"--unit-worker\"," + json.quoteString(taskJson) + "]";
            mut commands.pushBack(project.nodeExecPath());
            mut argListsJson.pushBack(argJson);
        } else {
            argJson := "[\"--unit-worker\"," + json.quoteString(taskJson) + "]";
            mut commands.pushBack(runnerScript);
            mut argListsJson.pushBack(argJson);
        }
    }

    jobs := if batchJobs > 0 { batchJobs } else { pool.cpuCount() };
    rawResults := pool.runPoolJson(commands, argListsJson, rootDir, jobs);
    offsets := json.arrayOffsets(rawResults, 0);
    if offsets.length() =!= count {
        if outputMode =!= "--silence" {
            io.errorLine("unit test pool returned malformed result count");
        }
        return (ok = false, passed = 0, failed = 0);
    }

    var passed := 0;
    var failed := 0;
    var idx := 0;
    loop idx < count {
        elemPos := offsets[idx];
        statusRes := json.readFieldInt(rawResults, elemPos, "status");
        outRes := json.readFieldString(rawResults, elemPos, "stdout");
        errRes := json.readFieldString(rawResults, elemPos, "stderr");
        errorRes := json.readFieldString(rawResults, elemPos, "error");
        status := if statusRes.found and statusRes.ok { statusRes.value } else { -1 };
        errText := if errorRes.found and errorRes.ok { errorRes.value } else { "" };
        if status == 0 and errText == "" {
            passed = passed + 1;
            if outputMode == "--verbose" {
                io.outputLine("PASS " + batchRel[idx]);
            }
        } else {
            failed = failed + 1;
            if outputMode =!= "--silence" {
                io.errorLine("FAIL " + batchRel[idx] + " (exit " + status.toText() + ")");
                if errText =!= "" { io.errorLine(errText.trimEnd()); }
                if outRes.found and outRes.ok and outRes.value.trim() =!= "" {
                    io.errorLine(outRes.value.trimEnd());
                }
                if errRes.found and errRes.ok and errRes.value.trim() =!= "" {
                    io.errorLine(errRes.value.trimEnd());
                }
            }
        }
        idx = idx + 1;
    }
    (ok = true, passed = passed, failed = failed)
};

/** Runs an explicit list of repository-relative `.test.lts` files, isolating nested-CLI suites serially after parallel workers. */
pub runUnitTestFiles := fn(rootDir: String, selectedRel: List<String>, maxJobs: Int, outputMode: String): Int {
    count := selectedRel.length();
    if count == 0 {
        if outputMode =!= "--silence" and outputMode =!= "--mute" {
            io.outputLine("Unit tests: 0 passed, 0 failed.");
        }
        return 0;
    }

    sel := compilerBuild.selectCompilerPath(rootDir, "ts");
    if not sel.ok {
        if outputMode =!= "--silence" {
            io.errorLine(sel.error);
        }
        return 1;
    }
    selC := compilerBuild.selectCompilerPath(rootDir, "c");
    if not selC.ok {
        if outputMode =!= "--silence" {
            io.errorLine(selC.error);
        }
        return 1;
    }

    nativeRunner := path.join(rootDir, "dist/tools/test-runner");
    tsRunner := path.join(rootDir, "dist/tools/test-runner.ts");
    runnerScript := if fs.kind(nativeRunner) == fs.FILE_KIND_FILE {
        nativeRunner
    } else if fs.kind(tsRunner) == fs.FILE_KIND_FILE {
        tsRunner
    } else {
        path.join(rootDir, "bin/lite-test")
    };

    mut parallelRel: List<String> = [];
    mut serialRel: List<String> = [];
    loop selectedRel as relFile {
        if isSerialUnitTest(relFile) {
            mut serialRel.pushBack(relFile);
        } else {
            mut parallelRel.pushBack(relFile);
        }
    }

    var passed := 0;
    var failed := 0;
    parRes := runUnitBatch(rootDir, sel.path, runnerScript, parallelRel, maxJobs, outputMode);
    if not parRes.ok { return 1; }
    passed = passed + parRes.passed;
    failed = failed + parRes.failed;

    loop serialRel as sRel {
        one: List<String> = [sRel];
        serRes := runUnitBatch(rootDir, sel.path, runnerScript, one, 1, outputMode);
        if not serRes.ok { return 1; }
        passed = passed + serRes.passed;
        failed = failed + serRes.failed;
    }

    if failed > 0 {
        if outputMode =!= "--silence" {
            io.errorLine("Unit tests: " + passed.toText() + " passed, " + failed.toText() + " failed.");
        }
        return 1;
    }
    if outputMode =!= "--silence" {
        if outputMode == "--mute" {
            io.outputLine("Unit tests passed (" + passed.toText() + ").");
        } else {
            io.outputLine("Unit tests: " + passed.toText() + " passed, 0 failed.");
        }
    }
    0
};

/** Discovers `.test.lts` files matching `filter` and runs them in parallel using `external/pool`. */
pub runUnitTests := fn(rootDir: String, filter: String, maxJobs: Int, outputMode: String): Int {
    ignored: List<String> = ["node_modules", "dist", "tmp", "build"];
    targets: List<String> = [rootDir];
    absFiles := path.collectFiles(rootDir, targets, ".test.lts", ignored, true);

    mut selectedRel: List<String> = [];
    loop absFiles as absFile {
        rel := path.relative(rootDir, absFile);
        if cases.matchesCaseFilter(rel, filter) {
            mut selectedRel.pushBack(rel);
        }
    }

    count := selectedRel.length();
    if count == 0 and filter =!= "" {
        if outputMode =!= "--silence" {
            io.errorLine("No unit test files matched \"" + filter + "\".");
        }
        return 1;
    }
    runUnitTestFiles(rootDir, selectedRel, maxJobs, outputMode)
};

/** Parses CLI flags for `lite test --unit` and dispatches execution. */
pub runUnitCli := fn(rootDir: String, rawArgs: List<String>): Int {
    if rootDir == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    mut args: List<String> = rawArgs;
    var jobs := 0;
    var outputMode := "";
    var filter := "";
    var hasFilter := false;

    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--" {
            if args.length() > 1 or hasFilter {
                io.errorLine(unitTestUsage());
                return 2;
            }
            if args.length() == 1 {
                filter = mut args.popFront();
                hasFilter = true;
            }
            break;
        } else if arg == "--jobs" or arg == "-j" {
            if args.length() == 0 {
                io.errorLine(unitTestUsage());
                return 2;
            }
            parsed := isPositiveIntText(mut args.popFront());
            if not parsed.ok {
                io.errorLine(unitTestUsage());
                return 2;
            }
            jobs = parsed.value;
        } else if arg.startsWithAt(0, "--jobs=") {
            parsed := isPositiveIntText(arg.slice(7, arg.length()));
            if not parsed.ok {
                io.errorLine(unitTestUsage());
                return 2;
            }
            jobs = parsed.value;
        } else if arg == "--verbose" or arg == "--mute" or arg == "--silence" {
            if outputMode =!= "" {
                io.errorLine(unitTestUsage());
                return 2;
            }
            outputMode = arg;
        } else if arg.startsWithAt(0, "-") or hasFilter {
            io.errorLine(unitTestUsage());
            return 2;
        } else {
            filter = arg;
            hasFilter = true;
        }
    }

    runUnitTests(rootDir, filter, jobs, outputMode)
};
