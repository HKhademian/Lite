/** Builds the VS Code extension JS artifacts into `dist/vscode/` (`editors/vscode/scripts/build.ts`). */

io := import "core/io";
fs := import "core/file";
path := import "core/path";
text := import "core/text";
extTs := import "external/ts";
project := import "util/project";

replaceAll := fn(haystack: String, needle: String, replacement: String): String {
    nLen := needle.length();
    if needle.isEmpty() { return haystack; }
    mut parts: List<String> = [];
    var pos := 0;
    size := haystack.length();
    loop pos <= size {
        found := haystack.indexOf(needle, pos);
        if found < 0 {
            mut parts.pushBack(haystack.slice(pos, size));
            break;
        }
        (mut parts).pushBack(haystack.slice(pos, found));
        mut parts.pushBack(replacement);
        pos = found + nLen;
    }
    parts.join("")
};

buildExtensionFile := fn(extRoot: String, distDir: String, name: String): (ok: Bool, error: String) {
    srcPath := path.join(extRoot, "src/" + name + ".ts");
    srcRead := fs.readText(srcPath);
    if not srcRead.ok { return (ok = false, error = srcRead.error); }
    stripped := extTs.stripTypes(srcRead.text);
    if not stripped.ok { return (ok = false, error = stripped.error); }
    jsText := if name == "extension" {
        replaceAll(stripped.code, "from './helpers.ts'", "from './helpers.js'")
    } else {
        stripped.code
    };
    wRes := fs.writeText(path.join(distDir, name + ".js"), jsText);
    if not wRes.ok { return (ok = false, error = wRes.error); }
    (ok = true, error = "")
};

run := fn(): Int {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    extRoot := path.join(root, "editors/vscode");
    distDir := path.join(root, "dist/vscode");
    mkRes := fs.makeDir(distDir);
    if not mkRes.ok {
        io.errorLine(mkRes.error);
        return 1;
    }
    names: List<String> = ["helpers", "extension"];
    loop names as name {
        built := buildExtensionFile(extRoot, distDir, name);
        if not built.ok {
            io.errorLine("vscode-build: " + built.error);
            return 1;
        }
    }
    0
};

io.exit(run());
