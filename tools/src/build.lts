/** Compile one Lite script into a standalone native executable (`--platform native|headless`) or single-file HTML5 app (`--platform web`). */

io := import "core/io";
builder := import "lite/builder";
project := import "./internal/project";

usageText := fn(): String {
    "Usage: ./bin/lite build [--platform native|macos|linux|windows|headless|web] [--web] [--headless] [-O0|-O1|-O2|-O3|-Os] [--cc-opt -O0|-O1|-O2|-O3|-Os] [--sanitize] [--builtin-mode SPEC]... [-o OUTPUT] [--keep-c] [--keep-ts] [--quiet] file.lts"
};

usageExit := fn(): Unit {
    io.errorLine(usageText());
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    mut args: List<String> = rawArgs;
    mut compileOpts: List<String> = [];
    var outPath := "";
    var ccOpt := "-O2";
    var explicitCcOpt := false;
    var sizeOpt := false;
    var sanitize := false;
    var debugPreset := false;
    var explicitDebugSet := false;
    var explicitDebugVal := false;
    var keepC := false;
    var keepTs := false;
    var quiet := false;
    var hasOpt := false;
    var platformRaw := "native";
    var scriptPath := "";

    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "-h" or arg == "--help" {
            io.outputLine(usageText());
            io.exit(0);
        } else if arg == "--" {
            if args.length() == 0 { usageExit(); }
            scriptPath = mut args.popFront();
            break;
        } else if arg == "-o" or arg == "--out" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            outPath = mut args.popFront();
        } else if arg.startsWithAt(0, "--out=") {
            outPath = arg.slice(6, arg.length());
        } else if arg == "--platform" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            platformRaw = mut args.popFront();
        } else if arg.startsWithAt(0, "--platform=") {
            platformRaw = arg.slice(11, arg.length());
        } else if arg == "--web" {
            platformRaw = "web";
        } else if arg == "--headless" {
            platformRaw = "headless";
        } else if arg == "--cc-opt" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            ccOpt = mut args.popFront();
            explicitCcOpt = true;
        } else if arg.startsWithAt(0, "--cc-opt=") {
            ccOpt = arg.slice(9, arg.length());
            explicitCcOpt = true;
        } else if arg == "--sanitize" {
            sanitize = true;
            mut compileOpts.pushBack(arg);
        } else if arg == "--keep-c" {
            keepC = true;
        } else if arg == "--keep-ts" {
            keepTs = true;
        } else if arg == "--quiet" or arg == "-q" {
            quiet = true;
        } else if arg == "--builtin-mode" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(mut args.popFront());
        } else if arg.startsWithAt(0, "--builtin-mode=") {
            mut compileOpts.pushBack(arg);
        } else if arg == "--emit-format" or arg == "--source-map" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(mut args.popFront());
        } else if arg == "-fdebug-info" {
            explicitDebugSet = true;
            explicitDebugVal = true;
            mut compileOpts.pushBack(arg);
        } else if arg == "-fno-debug-info" {
            explicitDebugSet = true;
            explicitDebugVal = false;
            mut compileOpts.pushBack(arg);
        } else if arg.startsWithAt(0, "--emit-format=") or arg.startsWithAt(0, "--source-map=") or arg.startsWithAt(0, "-f") {
            mut compileOpts.pushBack(arg);
        } else if arg == "-O0" or arg == "-O1" or arg == "-O2" or arg == "-O3" or arg == "-Os" or arg == "-Oc" or arg.startsWithAt(0, "--opt=") {
            hasOpt = true;
            sizeOpt = arg == "-Os" or arg == "--opt=s" or arg == "--opt=S";
            debugPreset = arg == "-O0" or arg == "--opt=0";
            (mut compileOpts).pushBack(arg);
        } else if arg == "--opt" {
            if args.length() == 0 or args[0] == "--" { usageExit(); }
            hasOpt = true;
            optVal := mut args.popFront();
            sizeOpt = optVal == "s" or optVal == "S";
            debugPreset = optVal == "0";
            (mut compileOpts).pushBack(arg);
            mut compileOpts.pushBack(optVal);
        } else if arg.startsWithAt(0, "-") {
            io.errorLine("lite build: unknown option " + arg);
            usageExit();
        } else {
            if scriptPath =!= "" { usageExit(); }
            scriptPath = arg;
        }
    }

    parsedPlat := builder.parsePlatform(platformRaw);
    if not parsedPlat.ok {
        io.errorLine("lite build: unsupported platform " + platformRaw + " (expected native, macos, linux, windows, headless, or web)");
        io.exit(2);
    }
    if scriptPath == "" {
        usageExit();
    }

    opts := builder.BuildOptions {
        =scriptPath,
        outputPath = outPath,
        platform = parsedPlat.value,
        =compileOpts,
        =hasOpt,
        =sizeOpt,
        =ccOpt,
        =explicitCcOpt,
        =sanitize,
        =debugPreset,
        =explicitDebugSet,
        =explicitDebugVal,
        =keepC,
        =keepTs
    };
    res := builder.buildScript(opts);
    if res.error =!= "" { io.errorLine(res.error); }
    if res.stderr =!= "" { project.errorText(res.stderr); }
    if not res.ok { io.exit(res.status); }
    if not quiet {
        io.outputLine(res.outputPath);
    }
};

run(io.inputArgs());
