/** CLI entrypoint validating all built site references in `dist/site/` (`site/lite-uri.ts`). */

cli := import "./internal/cli";
io := import "core/io";
siteValidate := import "../../site/src/validate";

run := fn(rawArgs: List<String>): Unit {
    args := cli.stripLeadingSeparator(rawArgs);
    if args.length() =!= 1 {
        io.errorLine("Usage: site-validate <site-dir>");
        io.exit(2);
    }
    io.output(siteValidate.validateBuiltSiteReferencesJson(args[0]));
};

run(io.inputArgs());
