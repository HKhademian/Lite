/** Caches official sample pages for CSES, AtCoder, and Rosalind challenges. */

fs := import "core/file";
io := import "core/io";
path := import "core/path";
cfetch := import "util/challenge-fetch";
challenges := import "util/challenges";
json := import "util/json";
project := import "util/project";

run := fn(rawArgs: List<String>): Int {
    loop rawArgs as arg {
        if arg == "--help" or arg == "-h" {
            io.outputLine("Usage: node tools/fetch_tests.ts");
            return 0;
        }
    }
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("FAIL: could not locate LiteScript repository root");
        return 1;
    }
    challRoot := path.join(root, "benchmark/challenges");
    cacheDir := path.join(challRoot, ".cache");
    dataPath := path.join(challRoot, "data/challenges.jsonl");
    rawRead := fs.readText(dataPath);
    if not rawRead.ok {
        io.errorLine("FAIL: " + rawRead.error);
        return 1;
    }

    csesUrls: mut List<String> = [];
    csesPaths: mut List<String> = [];
    atcUrls: mut List<String> = [];
    atcPaths: mut List<String> = [];
    rosUrls: mut List<String> = [];
    rosPaths: mut List<String> = [];

    lines := challenges.splitJsonLines(rawRead.text);
    loop lines as line {
        srcF := json.readObjectString(line, 0, "source");
        urlF := json.readObjectString(line, 0, "url");
        idF := json.readObjectString(line, 0, "id");
        if srcF.found and srcF.ok and urlF.found and urlF.ok and idF.found and idF.ok {
            src := srcF.value;
            outFile := path.join(cacheDir, "tests/" + src + "/" + idF.value + ".html");
            if src == "cses" {
                mut csesUrls.pushBack(urlF.value);
                mut csesPaths.pushBack(outFile);
            } else if src == "atcoder" {
                reqUrl := if urlF.value.contains("?") { urlF.value } else { urlF.value + "?lang=en" };
                mut atcUrls.pushBack(reqUrl);
                mut atcPaths.pushBack(outFile);
            } else if src == "rosalind" {
                mut rosUrls.pushBack(urlF.value);
                mut rosPaths.pushBack(outFile);
            }
        }
    }

    totalCount := csesUrls.length() + atcUrls.length() + rosUrls.length();
    io.outputLine("fetching " + totalCount.toText() + " sample pages");
    var failed := 0;

    if csesUrls.length() > 0 {
        io.outputLine("  cses: " + csesUrls.length().toText() + " page(s), 5 worker(s)");
        r1 := cfetch.downloadBatch(csesUrls, csesPaths, false, 5, 45000, 0, false, true, 50);
        failed = failed + r1.failures;
    }
    if atcUrls.length() > 0 {
        io.outputLine("  atcoder: " + atcUrls.length().toText() + " page(s), 1 worker(s)");
        r2 := cfetch.downloadBatch(atcUrls, atcPaths, false, 5, 45000, 1200, false, true, 50);
        failed = failed + r2.failures;
    }
    if rosUrls.length() > 0 {
        io.outputLine("  rosalind: " + rosUrls.length().toText() + " page(s), 5 worker(s)");
        r3 := cfetch.downloadBatch(rosUrls, rosPaths, false, 5, 45000, 0, false, true, 50);
        failed = failed + r3.failures;
    }

    io.outputLine("cached " + path.join(cacheDir, "tests"));
    if failed > 0 {
        io.errorLine("warning: " + failed.toText() + " page(s) failed; those challenges will have no tests");
    }
    0
};

status := run(io.inputArgs());
if status =!= 0 { io.exit(status); }
