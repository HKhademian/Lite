/** CLI entrypoint emitting `/tools/` body HTML and search entries JSON (`site/tools-page.ts`). */

cli := import "util/cli";
io := import "core/io";
siteTools := import "../../site/src/tools.lts";

run := fn(rawArgs: List<String>): Unit {
    args := cli.stripLeadingSeparator(rawArgs);
    repoUrl := if args.length() > 0 { args[0] } else { "" };
    io.output(siteTools.buildToolsPayloadJson(repoUrl));
};

run(io.inputArgs());
