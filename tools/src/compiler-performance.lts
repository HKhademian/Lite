/** Host entrypoint target for compiler performance measurements (`benchmark/compiler-performance.ts`). */

io := import "core/io";
cli := import "util/cli";
project := import "util/project";
benchUtil := import "util/benchmark";

run := fn(): Int {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    args := cli.stripLeadingSeparator(io.inputArgs());
    benchUtil.runCompilerPerformanceCommand(root, args)
};

io.exit(run());
