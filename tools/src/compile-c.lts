/** Standalone C11 compiler command (`lite-compile-c`); selects the active C compiler and invokes it directly. */

io := import "core/io";
fs := import "core/file";
project := import "./internal/project";
compilerBuild := import "./internal/compiler-build";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite-compile-c [-O0|-O1|-O2|-O3|-Os] [--builtin-mode SPEC]... file.lts");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    project.handleNamedVersionFlag(rawArgs, "compiler", "lite-compile-c");

    mut args: List<String> = rawArgs;
    mut forwardArgs: List<String> = [];
    mut positional: List<String> = [];
    var seenTarget := false;
    loop args.length() > 0 {
        arg := mut args.popFront();
        if arg == "--" {
            loop args.length() > 0 {
                mut positional.pushBack(mut args.popFront());
            }
            break;
        } else if arg == "--emit-format" or arg == "--source-map" {
            if args.length() == 0 or args[0] == "--" {
                usageExit();
            }
            (mut forwardArgs).pushBack(arg);
            mut forwardArgs.pushBack(mut args.popFront());
        } else if arg.startsWithAt(0, "--emit-format=") or arg.startsWithAt(0, "--source-map=") {
            mut forwardArgs.pushBack(arg);
        } else if arg == "--builtin-mode" {
            if args.length() == 0 or args[0] == "--" {
                usageExit();
            }
            (mut forwardArgs).pushBack(arg);
            mut forwardArgs.pushBack(mut args.popFront());
        } else if arg.startsWithAt(0, "--builtin-mode=") {
            mut forwardArgs.pushBack(arg);
        } else if arg == "-O0" or arg == "-O1" or arg == "-O2" or arg == "-O3" or arg == "-Os" or arg == "-Oc" or arg.startsWithAt(0, "--opt=") or arg.startsWithAt(0, "-f") {
            mut forwardArgs.pushBack(arg);
        } else if arg == "--opt" {
            if args.length() == 0 or args[0] == "--" {
                usageExit();
            }
            (mut forwardArgs).pushBack(arg);
            mut forwardArgs.pushBack(mut args.popFront());
        } else if not seenTarget and positional.length() == 0 and arg == "--target" {
            if args.length() == 0 or (mut args).popFront() =!= "c" {
                usageExit();
            }
            seenTarget = true;
        } else if not seenTarget and positional.length() == 0 and arg == "--target=c" {
            seenTarget = true;
        } else {
            mut positional.pushBack(arg);
        }
    }

    if positional.length() =!= 1 {
        usageExit();
    }
    source := positional[0];
    if not source.endsWith(".lts") and not source.endsWith(".lt") {
        usageExit();
    }
    if fs.kind(source) =!= fs.FILE_KIND_FILE {
        io.errorLine("lite-compile-c: cannot read " + source);
        io.exit(2);
    }

    sel := compilerBuild.selectCompilerPath(project.findRepoRoot(), "c");
    if not sel.ok {
        io.errorLine("lite-compile-c: " + sel.error);
        io.exit(1);
    }
    (mut forwardArgs).pushBack(source);
    io.exit(project.runCompilerArtifact(sel.path, forwardArgs));
};

run(io.inputArgs());
