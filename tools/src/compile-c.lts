/** Standalone C11 compiler command (`lite-compile-c`); selects the active C compiler and invokes it directly. */

io := import "core/io";
fs := import "core/file";
list := import "core/list";
text := import "core/text";
project := import "util/project";
compilerBuild := import "util/compiler-build";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite-compile-c [-O0|-O1|-O2|-O3] [--builtin-mode SPEC]... file.lts");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    project.handleNamedVersionFlag(rawArgs, "compiler", "lite-compile-c");

    args: mut List<String> = rawArgs;
    forwardArgs: mut List<String> = [];
    positional: mut List<String> = [];
    var seenTarget := false;
    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--" {
            loop list.listCountText(args) > 0 {
                list.pushBack(mut positional, list.popFront(mut args));
            }
            break;
        } else if arg == "--builtin-mode" {
            if list.listCountText(args) == 0 or args[0] == "--" {
                usageExit();
            }
            list.pushBack(mut forwardArgs, arg);
            list.pushBack(mut forwardArgs, list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--builtin-mode=") {
            list.pushBack(mut forwardArgs, arg);
        } else if arg == "-O0" or arg == "-O1" or arg == "-O2" or arg == "-O3" or text.startsWithAt(arg, 0, "--opt=") {
            list.pushBack(mut forwardArgs, arg);
        } else if arg == "--opt" {
            if list.listCountText(args) == 0 or args[0] == "--" {
                usageExit();
            }
            list.pushBack(mut forwardArgs, arg);
            list.pushBack(mut forwardArgs, list.popFront(mut args));
        } else if not seenTarget and list.listCountText(positional) == 0 and arg == "--target" {
            if list.listCountText(args) == 0 or list.popFront(mut args) =!= "c" {
                usageExit();
            }
            seenTarget = true;
        } else if not seenTarget and list.listCountText(positional) == 0 and arg == "--target=c" {
            seenTarget = true;
        } else {
            list.pushBack(mut positional, arg);
        }
    }

    if list.listCountText(positional) =!= 1 {
        usageExit();
    }
    source := positional[0];
    if not text.endsWith(source, ".lts") {
        usageExit();
    }
    if fs.kind(source) =!= fs.FILE_KIND_FILE {
        io.errorLine("lite-compile-c: cannot read " + source);
        io.exit(2);
    }

    sel := compilerBuild.selectCompilerPath(project.findRepoRoot(), "c");
    if not sel.ok {
        io.errorLine("lite-compile-c: " + sel.error);
        io.exit(1);
    }
    list.pushBack(mut forwardArgs, source);
    io.exit(project.runCompilerArtifact(sel.path, forwardArgs));
};

run(io.inputArgs());
