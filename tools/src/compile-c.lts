/** Reserved C compiler target command (`lite-compile-c`); defers C output until post-TS migration. */

io := import "core/io";
list := import "core/list";
project := import "util/project";

run := fn(rawArgs: List<String>): Unit {
    project.handleNamedVersionFlag(rawArgs, "compiler", "lite-compile-c");
    io.errorLine("lite-compile-c: C output is deferred until after the TS compiler migration");
    io.exit(2);
};

run(io.inputArgs());
