/** Standalone compiler router (`lite-compile`); munches target selection and forwards to `bin/lite-compile-<target>`. */

io := import "core/io";
list := import "core/list";
text := import "core/text";
project := import "util/project";

TARGET_TS := "ts";
TARGET_C := "c";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite-compile [--target ts|c] [--builtin-mode SPEC]... file.lts");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    project.handleNamedVersionFlag(rawArgs, "compiler", "lite-compile");

    var target := TARGET_TS;
    args: mut List<String> = rawArgs;
    if list.listCountText(args) > 0 {
        first := args[0];
        if first == TARGET_TS or first == TARGET_C {
            target = list.popFront(mut args);
        } else if first == "--target" {
            _flag := list.popFront(mut args);
            if list.listCountText(args) == 0 {
                usageExit();
            }
            target = list.popFront(mut args);
        } else if text.startsWithAt(first, 0, "--target=") {
            _flag := list.popFront(mut args);
            target = text.slice(first, 9, text.length(first));
        }
    }

    if target =!= TARGET_TS and target =!= TARGET_C {
        usageExit();
    }
    project.forwardNode("bin/lite-compile-" + target, args);
};

run(io.inputArgs());
