/** Standalone compiler router (`lite-compile`); munches target selection and forwards to `bin/lite-compile-<target>`. */

io := import "core/io";
project := import "./internal/project";

TARGET_TS := "ts";
TARGET_C := "c";

usageExit := fn(): Unit {
    io.errorLine("Usage: ./bin/lite-compile [--target ts|c] [-O0|-O1|-O2|-O3] [--builtin-mode SPEC]... file.lts");
    io.exit(2);
};

run := fn(rawArgs: List<String>): Unit {
    project.handleNamedVersionFlag(rawArgs, "compiler", "lite-compile");

    var target := TARGET_TS;
    mut args: List<String> = rawArgs;
    if args.length() > 0 {
        first := args[0];
        if first == TARGET_TS or first == TARGET_C {
            target = mut args.popFront();
        } else if first == "--target" {
            _flag := mut args.popFront();
            if args.length() == 0 {
                usageExit();
            }
            target = mut args.popFront();
        } else if first.startsWithAt(0, "--target=") {
            _flag := mut args.popFront();
            target = first.slice(9, first.length());
        }
    }

    if target =!= TARGET_TS and target =!= TARGET_C {
        usageExit();
    }
    project.forwardNode("bin/lite-compile-" + target, args);
};

run(io.inputArgs());
