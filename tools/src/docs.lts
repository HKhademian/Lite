/** Offline documentation discovery, rendering, module API extraction, and local Markdown integrity checks. */

fs := import "core/file";
io := import "core/io";
path := import "core/path";
proc := import "core/process";
text := import "core/text";
docgen := import "lite/docgen";
docsUtil := import "./internal/docs";
mdHtml := import "data/markdown-html";
project := import "./internal/project";

splitNonEmptyLines := fn(raw: String): List<String> {
    mut lines: List<String> = [];
    size := raw.length();
    var pos := 0;
    loop pos <= size {
        nl := raw.indexOf("\n", pos);
        end := if nl < 0 { size } else { nl };
        trimmed := raw.slice(pos, end).trim();
        if trimmed =!= "" {
            mut lines.pushBack(trimmed);
        }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    lines
};

renderSelectedJson := fn(rootDir: String, targets: List<String>): String {
    mut entries: List<String> = [];
    loop targets as rel {
        fullFile := path.resolve(rootDir, rel);
        readRes := fs.readText(fullFile);
        if not readRes.ok {
            io.errorLine(rel + ": " + readRes.error);
            io.exit(1);
        }
        relPath := path.relative(rootDir, fullFile);
        mut entries.pushBack(mdHtml.renderMarkdownJson(readRes.text, relPath));
    }
    if entries.length() == 0 { return "[]"; }
    "[\n  " + entries.join(",\n  ") + "\n]"
};

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "docs", "docs");
    mut args: List<String> = rawArgs;

    envRoot := proc.envGet("LITE_DOCS_ROOT");
    rootDir := if envRoot.found and envRoot.value =!= "" { envRoot.value } else { project.findRepoRoot() };

    if args.length() == 1 and args[0] == "--check" {
        failures := docsUtil.checkDocuments(rootDir);
        if failures.length() > 0 {
            io.errorLine(failures.join("\n"));
            io.exit(1);
        }
        io.outputLine("Documentation links, fragments and fences passed.");
        io.exit(0);
    }

    if args.length() == 1 and args[0] == "--modules-json" {
        io.outputLine(docgen.extractAllModulesJson(rootDir));
        io.exit(0);
    }

    if args.length() > 0 and args[0] == "--render-json" {
        _flag := mut args.popFront();
        if args.length() > 0 {
            io.outputLine(renderSelectedJson(rootDir, args));
            io.exit(0);
        }
        stdinPaths := splitNonEmptyLines(io.inputAll(""));
        if stdinPaths.length() > 0 {
            io.outputLine(renderSelectedJson(rootDir, stdinPaths));
            io.exit(0);
        }
        allDocFiles := docsUtil.listDocFiles(rootDir);
        mut relDocFiles: List<String> = [];
        loop allDocFiles as fullDoc {
            mut relDocFiles.pushBack(path.relative(rootDir, fullDoc));
        }
        io.outputLine(renderSelectedJson(rootDir, relDocFiles));
        io.exit(0);
    }

    var isJson := false;
    if args.length() > 0 and args[0] == "--json" {
        _flag := mut args.popFront();
        isJson = true;
    }
    query := args.join(" ");

    if isJson {
        io.outputLine(docsUtil.docsJson(rootDir, query));
        io.exit(0);
    }

    if query == "" {
        nav := docsUtil.navigationSummary(rootDir);
        if not nav.ok {
            io.errorLine(nav.error);
            io.exit(1);
        }
        io.outputLine(nav.text);
        io.exit(0);
    }

    searched := docsUtil.searchDocsText(rootDir, query);
    if searched.count == 0 {
        io.errorLine("no documentation matches: " + query.toLowerAscii());
        io.exit(1);
    }
    io.outputLine(searched.text);
};

run(io.inputArgs());
