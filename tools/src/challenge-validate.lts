/** Challenge corpus validator (`benchmark/challenges/tools/validate.ts`). */

io := import "core/io";
project := import "util/project";
challenges := import "util/challenges";

run := fn(): Int {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    challenges.runValidateCorpusCommand(root)
};

io.exit(run());
