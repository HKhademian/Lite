/** CLI entrypoint for `/docs/` discovery, Markdown rendering, and portal page generation (`site/docs-pages.ts`). */

io := import "core/io";
project := import "util/project";
siteDocs := import "../../site/src/docs";

run := fn(rawArgs: List<String>): Unit {
    args: mut List<String> = rawArgs;
    if args.length() > 0 and args[0] == "--" {
        _sep := mut args.popFront();
    }
    if args.length() > 0 and (args[0] == "--out-map" or args[0] == "--discover") {
        cmd := mut args.popFront();
        includeRendered := cmd == "--discover";
        root := if args.length() > 0 { args[0] } else { project.findRepoRoot() };
        if root == "" {
            io.errorLine("lite site-docs: could not locate repository root");
            io.exit(1);
        }
        res := siteDocs.discoverDocsPayloadJson(root, includeRendered);
        if not res.ok {
            io.errorLine(res.error);
            io.exit(1);
        }
        io.output(res.jsonText);
        io.exit(0);
    }

    stdinRes := io.Reader.stdin().readAllText();
    if not stdinRes.ok {
        io.errorLine(stdinRes.error);
        io.exit(1);
    }
    res := siteDocs.buildDocsPayloadJson(stdinRes.text);
    if not res.ok {
        io.errorLine(res.error);
        io.exit(1);
    }
    io.output(res.jsonText);
};

run(io.inputArgs());
