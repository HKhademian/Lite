/** Format Lite (.lts) source files with canonical indentation and spacing. */

io := import "core/io";
fs := import "core/fs";
proc := import "core/process";
text := import "core/text";
list := import "core/list";
fsUtil := import "util/fs";
project := import "util/project";

scanLineBraces := fn(line: String, startInBlock: Bool): (leadingCloses: Int, netChange: Int, normalized: String, inBlockComment: Bool) {
    var inBlock := startInBlock;
    var inString := "";
    var leadingCloses := 0;
    var sawCode := false;
    var netChange := 0;
    var out := "";
    var lastChar := "";
    lineLen := text.length(line);
    var i := 0;

    loop i < lineLen {
        ch := text.at(line, i);
        if inBlock {
            out = out + ch;
            lastChar = ch;
            if ch == "*" and i + 1 < lineLen and text.at(line, i + 1) == "/" {
                out = out + "/";
                lastChar = "/";
                inBlock = false;
                i = i + 2;
            } else {
                i = i + 1;
            }
        } else if inString =!= "" {
            out = out + ch;
            lastChar = ch;
            if ch == "\\" and i + 1 < lineLen {
                nextCh := text.at(line, i + 1);
                out = out + nextCh;
                lastChar = nextCh;
                i = i + 2;
            } else {
                if ch == inString { inString = ""; }
                i = i + 1;
            }
        } else if ch == "/" and i + 1 < lineLen and text.at(line, i + 1) == "/" {
            out = out + text.slice(line, i, lineLen);
            break;
        } else if ch == "/" and i + 1 < lineLen and text.at(line, i + 1) == "*" {
            out = out + "/*";
            lastChar = "*";
            inBlock = true;
            sawCode = true;
            i = i + 2;
        } else if ch == "\"" or ch == "'" {
            inString = ch;
            sawCode = true;
            out = out + ch;
            lastChar = ch;
            i = i + 1;
        } else if ch == "}" {
            if not sawCode { leadingCloses = leadingCloses + 1; } else { netChange = netChange - 1; }
            out = out + "}";
            lastChar = "}";
            sawCode = true;
            if i + 1 < lineLen and text.isAsciiLetter(text.at(line, i + 1)) {
                out = out + " ";
                lastChar = " ";
            }
            i = i + 1;
        } else if ch == "{" {
            if lastChar =!= "" and not text.isWhitespace(lastChar) and lastChar =!= "(" and lastChar =!= "[" {
                out = out + " ";
            }
            netChange = netChange + 1;
            out = out + "{";
            lastChar = "{";
            sawCode = true;
            i = i + 1;
        } else {
            if not text.isWhitespace(ch) { sawCode = true; }
            out = out + ch;
            lastChar = ch;
            i = i + 1;
        }
    }

    totalNet := netChange - leadingCloses;
    (leadingCloses = leadingCloses, netChange = totalNet, normalized = text.trimEnd(out), inBlockComment = inBlock)
}

/** Formats Lite source text cleanly and idempotently (4-space indentation, LF, single trailing newline). */
pub formatLite := fn(source: String): String {
    formatted: mut List<String> = [];
    var formattedCount := 0;
    var depth := 0;
    var inBlockComment := false;
    var blankRun := 0;
    size := text.length(source);
    var pos := 0;
    var done := false;

    loop not done {
        var lineEnd := pos;
        loop lineEnd < size {
            ch := text.at(source, lineEnd);
            if ch == "\n" or ch == "\r" { break; }
            lineEnd = lineEnd + 1;
        }
        rawLine := text.slice(source, pos, lineEnd);
        if lineEnd >= size {
            done = true;
        } else if text.at(source, lineEnd) == "\r" and lineEnd + 1 < size and text.at(source, lineEnd + 1) == "\n" {
            pos = lineEnd + 2;
        } else {
            pos = lineEnd + 1;
        }

        trimmed := text.trimEnd(rawLine);
        if text.trimStart(trimmed) == "" {
            if formattedCount > 0 and blankRun == 0 {
                list.pushBack(mut formatted, "");
                formattedCount = formattedCount + 1;
                blankRun = 1;
            }
        } else if inBlockComment {
            list.pushBack(mut formatted, trimmed);
            formattedCount = formattedCount + 1;
            scanned := scanLineBraces(trimmed, true);
            inBlockComment = scanned.inBlockComment;
            blankRun = 0;
        } else {
            body := text.trimStart(trimmed);
            scanned := scanLineBraces(body, false);
            var lineDepth := depth - scanned.leadingCloses;
            if lineDepth < 0 { lineDepth = 0; }
            list.pushBack(mut formatted, text.repeatText("    ", lineDepth) + scanned.normalized);
            formattedCount = formattedCount + 1;
            depth = depth + scanned.netChange;
            if depth < 0 { depth = 0; }
            inBlockComment = scanned.inBlockComment;
            blankRun = 0;
        }
    }

    loop formattedCount > 0 and formatted[formattedCount - 1] == "" {
        list.popBack(mut formatted);
        formattedCount = formattedCount - 1;
    }
    if formattedCount == 0 { return ""; }
    text.joinTexts(formatted, "\n") + "\n"
}

args := io.inputArgs();
project.handleVersionFlag(args, "formatter", "fmt");

var checkOnly := false;
targets: mut List<String> = [];
var targetCount := 0;
loop args as arg {
    if arg == "--help" or arg == "-h" {
        io.output(
        "Usage: ./bin/lite fmt [--check] [FILE_OR_DIR... | -]\n\n" +
        "Options:\n" +
        "  --check   Exit with status 1 if any file is not formatted\n"
        );
        io.exit(0);
    } else if arg == "--check" {
        checkOnly = true;
    } else if arg =!= "--write" {
        list.pushBack(mut targets, arg);
        targetCount = targetCount + 1;
    }
}

if targetCount == 0 {
    io.errorLine("Usage: ./bin/lite fmt [--check] [FILE_OR_DIR... | -]");
    io.exit(2);
}

if targetCount == 1 and targets[0] == "-" {
    input := io.inputAll("");
    output := formatLite(input);
    if checkOnly {
        if input == output { io.exit(0); } else { io.exit(1); }
    }
    io.output(output);
    io.exit(0);
}

files := fsUtil.collectFiles(proc.cwd(), targets, ".lts", fsUtil.defaultIgnoredDirs(), true);

var dirty := 0;
loop files as file {
    readRes := fs.readText(file);
    if not readRes.ok {
        io.errorLine(file + ": " + readRes.error);
        io.exit(1);
    }
    after := formatLite(readRes.text);
    if readRes.text =!= after {
        dirty = dirty + 1;
        if checkOnly {
            io.outputLine(file);
        } else {
            writeRes := fs.writeText(file, after);
            if not writeRes.ok {
                io.errorLine(file + ": " + writeRes.error);
                io.exit(1);
            }
        }
    }
}

if checkOnly and dirty > 0 { io.exit(1); }
