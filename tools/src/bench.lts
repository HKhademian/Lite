/** Standalone declarative benchmark runner (`lite bench OUTPUT [FILTER]`). */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
crypto := import "core/crypto";
text := import "type/string";
time := import "core/time";
path := import "core/path";
project := import "./internal/project";
json := import "data/json";
cases := import "./internal/cases";
release := import "./internal/release";

formatNsAsMsJson := fn(nsRaw: Int): String {
    ns := if nsRaw < 0 { 0 } else { nsRaw };
    wholeMs := ns / 1000000;
    micros := (ns - wholeMs * 1000000) / 1000;
    var frac := micros.toText();
    if micros < 10 {
        frac = "00" + frac;
    } else if micros < 100 {
        frac = "0" + frac;
    }
    wholeMs.toText() + "." + frac
};

sortInts := fn(items: List<Int>): List<Int> {
    mut out: List<Int> = [];
    mut rem: List<Int> = [];
    var remCount := 0;
    loop items as item {
        mut rem.pushBack(item);
        remCount = remCount + 1;
    }
    loop remCount > 0 {
        var bestIdx := 0;
        var i := 1;
        loop i < remCount {
            if rem[i] < rem[bestIdx] {
                bestIdx = i;
            }
            i = i + 1;
        }
        (mut out).pushBack(rem[bestIdx]);
        mut next: List<Int> = [];
        var j := 0;
        loop j < remCount {
            if j =!= bestIdx {
                mut next.pushBack(rem[j]);
            }
            j = j + 1;
        }
        loop remCount > 0 {
            _dropped := mut rem.popBack();
            remCount = remCount - 1;
        }
        loop next as kept {
            mut rem.pushBack(kept);
            remCount = remCount + 1;
        }
    }
    out
};

computeToolingHash := fn(rootDir: String): String {
    mut digestBytes: List<Int> = [];
    var first := true;

    dirs: List<String> = ["tools/", "tools/src/", "tools/src/internal/", "dist/tools/"];
    loop dirs as prefix {
        dirPath := path.join(rootDir, prefix);
        ext := if prefix == "tools/src/" { ".lts" } else if prefix == "tools/src/internal/" { ".lt" } else { ".ts" };
        if fs.kind(dirPath) == fs.FILE_KIND_DIR {
            entries := fs.listDir(dirPath);
            loop entries as entry {
                full := path.join(dirPath, entry);
                if entry.endsWith(ext) and fs.kind(full) == fs.FILE_KIND_FILE {
                    if not first {
                        mut digestBytes.pushBack(0);
                    }
                    first = false;
                    loop (prefix + entry).utf8Encode() as b {
                        mut digestBytes.pushBack(b);
                    }
                    (mut digestBytes).pushBack(0);
                    loop fs.readBytes(full) as b {
                        mut digestBytes.pushBack(b);
                    }
                }
            }
        }
    }
    crypto.sha256Bytes(digestBytes)
};

readCompilerJson := fn(rootDir: String): (ok: Bool, jsonText: String, error: String) {
    emptyEnv: List<String> = [];
    args: List<String> = [path.join(rootDir, "compiler/scripts/build.ts")];
    built := proc.run(project.nodeExecPath(), args, rootDir, emptyEnv, true, "");
    if built.error =!= "" { return (ok = false, jsonText = "", error = built.error); }
    if built.status =!= 0 { return (ok = false, jsonText = "", error = built.stdout + built.stderr); }
    tsField := json.findField(built.stdout, 0, "ts");
    if not tsField.found { return (ok = false, jsonText = "", error = "missing ts compiler metadata"); }
    srcHash := json.readFieldString(built.stdout, tsField.valuePos, "sourceSha256");
    artHash := json.readFieldString(built.stdout, tsField.valuePos, "artifactSha256");
    bldHash := json.readFieldString(built.stdout, tsField.valuePos, "builderSha256");
    if not srcHash.found or not artHash.found or not bldHash.found {
        return (ok = false, jsonText = "", error = "incomplete ts compiler digest metadata");
    }
    body := "{\"source\":" + json.quoteString(srcHash.value)
    + ",\"artifact\":" + json.quoteString(artHash.value)
    + ",\"builder\":" + json.quoteString(bldHash.value) + "}";
    (ok = true, jsonText = body, error = "")
};

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "benchmark", "bench");
    mut args: List<String> = rawArgs;
    if args.length() > 0 and args[0] == "--" {
        _sep := mut args.popFront();
    }
    if args.length() < 1 or args.length() > 2 {
        io.errorLine("usage: lite bench OUTPUT [FILTER]");
        io.exit(1);
    }

    output := path.resolve(proc.cwd(), mut args.popFront());
    filter := if args.length() > 0 { mut args.popFront() } else { "" };
    if fs.kind(output) =!= fs.FILE_KIND_MISSING {
        io.errorLine("benchmark output already exists; choose a new report path");
        io.exit(1);
    }

    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        io.exit(1);
    }

    checkedSet := cases.validateCaseSet(root, filter);
    if not checkedSet.ok {
        io.errorLine(checkedSet.error);
        io.exit(1);
    }
    caseFiles := cases.selectCaseFiles(root, filter);

    mut resultsJson: List<String> = [];
    loop caseFiles as caseFile {
        meta := cases.readCaseMeta(root, caseFile);
        if not meta.ok {
            io.errorLine(meta.error);
            io.exit(1);
        }
        if meta.hasBenchmark {
            if meta.hasPending {
                io.errorLine(meta.id + ": pending: " + meta.pending);
                io.exit(1);
            }
            ident := cases.caseIdentityJson(root, caseFile);
            if not ident.ok {
                io.errorLine(ident.error);
                io.exit(1);
            }
            var sIdx := 0;
            loop sIdx < meta.scenarioCount {
                sName := cases.readScenarioName(caseFile, sIdx);
                var w := 0;
                loop w < meta.warmups {
                    wRes := cases.verifyCaseScenario(root, caseFile, sIdx);
                    if not wRes.ok {
                        io.errorLine(wRes.error);
                        io.exit(1);
                    }
                    w = w + 1;
                }
                mut samplesNs: List<Int> = [];
                var s := 0;
                loop s < meta.samples {
                    t0 := time.monotonicNs();
                    sRes := cases.verifyCaseScenario(root, caseFile, sIdx);
                    t1 := time.monotonicNs();
                    if not sRes.ok {
                        io.errorLine(sRes.error);
                        io.exit(1);
                    }
                    (mut samplesNs).pushBack(t1 - t0);
                    s = s + 1;
                }
                sorted := sortInts(samplesNs);
                medianNs := sorted[sorted.length() / 2];

                mut msFields: List<String> = [];
                loop samplesNs as sampleNs {
                    mut msFields.pushBack(formatNsAsMsJson(sampleNs));
                }

                entry := "{"
                + "\"id\":" + json.quoteString(meta.id)
                + ",\"scenario\":" + json.quoteString(sName)
                + ",\"kind\":" + json.quoteString(meta.kind)
                + ",\"identity\":" + ident.jsonText
                + ",\"warmups\":" + meta.warmups.toText()
                + ",\"milliseconds\":[" + msFields.join(",") + "]"
                + ",\"medianMilliseconds\":" + formatNsAsMsJson(medianNs)
                + "}";
                mut resultsJson.pushBack(entry);
                sIdx = sIdx + 1;
            }
        }
    }

    resultCount := resultsJson.length();
    if resultCount == 0 {
        io.errorLine("no benchmark cases selected");
        io.exit(1);
    }

    emptyEnv: List<String> = [];
    hasGit := fs.kind(path.join(root, ".git")) =!= fs.FILE_KIND_MISSING;
    var commitJson := "null";
    var dirtyJson := "null";
    if hasGit {
        revArgs: List<String> = ["rev-parse", "HEAD"];
        revRes := proc.run("git", revArgs, root, emptyEnv, true, "");
        if revRes.error =!= "" or revRes.status =!= 0 {
            io.errorLine("git rev-parse HEAD failed: " + revRes.stdout + revRes.stderr + revRes.error);
            io.exit(1);
        }
        commitJson = json.quoteString(revRes.stdout.trim());

        statArgs: List<String> = ["status", "--porcelain"];
        statRes := proc.run("git", statArgs, root, emptyEnv, true, "");
        if statRes.error =!= "" or statRes.status =!= 0 {
            io.errorLine("git status failed: " + statRes.stdout + statRes.stderr + statRes.error);
            io.exit(1);
        }
        dirtyJson = if statRes.stdout.length() > 0 { "true" } else { "false" };
    }

    verRes := release.versionsJson(root);
    if not verRes.ok {
        io.errorLine(verRes.error);
        io.exit(1);
    }
    compRes := readCompilerJson(root);
    if not compRes.ok {
        io.errorLine(compRes.error);
        io.exit(1);
    }
    toolingHash := computeToolingHash(root);

    mkOut := fs.makeDir(path.parentDir(output));
    if not mkOut.ok {
        io.errorLine(mkOut.error);
        io.exit(1);
    }
    if fs.kind(output) =!= fs.FILE_KIND_MISSING {
        io.errorLine("benchmark output already exists; choose a new report path");
        io.exit(1);
    }

    scopeText := "fresh-process wall time including startup, IO, verification, and compilation for program cases";
    report := "{\n"
    + "  \"commit\": " + commitJson + ",\n"
    + "  \"dirty\": " + dirtyJson + ",\n"
    + "  \"versions\": " + verRes.jsonText + ",\n"
    + "  \"compiler\": " + compRes.jsonText + ",\n"
    + "  \"tooling\": " + json.quoteString(toolingHash) + ",\n"
    + "  \"scope\": " + json.quoteString(scopeText) + ",\n"
    + "  \"results\": [\n    " + resultsJson.join(",\n    ") + "\n  ]\n"
    + "}\n";

    wrote := fs.writeText(output, report);
    if not wrote.ok {
        io.errorLine(wrote.error);
        io.exit(1);
    }
    io.outputLine("Wrote " + resultCount.toText() + " benchmark results to " + output);
};

run(io.inputArgs());
