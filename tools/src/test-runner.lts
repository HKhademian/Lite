/** Standalone generated test runner (`lite-test`); handles smoke/fast/full suites and `--cases`. */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
text := import "core/text";
list := import "core/list";
path := import "core/path";
cases := import "util/cases";
project := import "util/project";
unitTests := import "util/unit-tests";

smokeTestFiles := fn(): List<String> {
    files: List<String> = [
    "../site/features.test.ts",
    "../site/build.test.ts"
    ];
    files
};

smokeUnitTestFiles := fn(): List<String> {
    files: List<String> = [
    "compiler/scripts/release-streams.test.lts",
    "igniter/source-files.test.lts",
    "tools/cli.test.lts",
    "tools/docs.test.lts",
    "tools/release.test.lts",
    "tools/run.test.lts"
    ];
    files
};

readGeneratedTestFiles := fn(root: String): List<String> {
    files: mut List<String> = [];
    readRes := fs.readText(path.resolve(root, "igniter/test-suites.ts"));
    if not readRes.ok {
        io.errorLine(readRes.error);
        io.exit(1);
    }
    source := readRes.text;
    openBracket := text.indexOfText(source, "[", 0);
    closeBracket := text.indexOfText(source, "]", openBracket + 1);
    if openBracket < 0 or closeBracket < 0 {
        io.errorLine("igniter/test-suites.ts: missing generatedTestFiles list");
        io.exit(1);
    }
    var pos := openBracket + 1;
    loop pos < closeBracket {
        q1 := text.indexOfText(source, "'", pos);
        if q1 < 0 or q1 >= closeBracket { break; }
        q2 := text.indexOfText(source, "'", q1 + 1);
        if q2 < 0 or q2 >= closeBracket { break; }
        list.pushBack(mut files, text.slice(source, q1 + 1, q2));
        pos = q2 + 1;
    }
    files
};

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "tester", "test");
    args: mut List<String> = rawArgs;
    if list.listCountText(args) > 0 and args[0] == "--unit-worker" {
        _flag := list.popFront(mut args);
        if list.listCountText(args) =!= 1 {
            io.errorLine("Usage: ./bin/lite test --unit-worker TASK_JSON");
            io.exit(2);
        }
        io.exit(unitTests.runUnitWorker(args[0]));
    }
    if list.listCountText(args) > 0 and args[0] == "--cases" {
        _flag := list.popFront(mut args);
        io.exit(cases.runCaseCli(project.findRepoRoot(), args));
    }
    if list.listCountText(args) > 0 and args[0] == "--unit" {
        _flag := list.popFront(mut args);
        io.exit(unitTests.runUnitCli(project.findRepoRoot(), args));
    }

    var mode := "";
    var outputMode := "";
    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--smoke" or arg == "--fast" or arg == "--full" {
            if mode =!= "" {
                io.errorLine("Usage: ./bin/lite test [--smoke|--fast|--full] [--verbose|--mute|--silence]");
                io.exit(2);
            }
            mode = arg;
        } else if arg == "--verbose" or arg == "--mute" or arg == "--silence" {
            if outputMode =!= "" {
                io.errorLine("Usage: ./bin/lite test [--smoke|--fast|--full] [--verbose|--mute|--silence]");
                io.exit(2);
            }
            outputMode = arg;
        } else {
            io.errorLine("Usage: ./bin/lite test [--smoke|--fast|--full] [--verbose|--mute|--silence]");
            io.exit(2);
        }
    }

    if mode == "" { mode = "--smoke"; }
    reporter := if outputMode == "--verbose" { "spec" } else { "dot" };
    quiet := outputMode == "--mute" or outputMode == "--silence";

    envOverrides: mut List<String> = ["=NODE_TEST_CONTEXT"];
    nativeVar := proc.envGet("LITE_TEST_NATIVE");
    if not nativeVar.found or nativeVar.value =!= "1" {
        list.pushBack(mut envOverrides, "LITE_SKIP_NATIVE=1");
    }
    heavyVar := proc.envGet("LITE_TEST_HEAVY");
    if mode == "--fast" and (not heavyVar.found or heavyVar.value =!= "1") {
        list.pushBack(mut envOverrides, "LITE_SKIP_HEAVY=1");
    }

    root := project.findRepoRoot();
    suites := if mode == "--smoke" { smokeTestFiles() } else { readGeneratedTestFiles(root) };
    nodeArgs: mut List<String> = ["--test", "--test-reporter=" + reporter];
    loop suites as suite {
        list.pushBack(mut nodeArgs, suite);
    }
    igniterDir := if root == "" { "igniter" } else { path.resolve(root, "igniter") };
    res := proc.run(proc.execPath(), nodeArgs, igniterDir, envOverrides, quiet, "");
    if res.error =!= "" {
        if outputMode =!= "--silence" {
            io.errorLine(res.error);
        }
        io.exit(1);
    }
    if outputMode == "--mute" {
        if res.status == 0 {
            io.outputLine("Tests passed.");
        } else {
            io.output(res.stdout);
            project.errorText(res.stderr);
        }
    }
    if res.status =!= 0 {
        io.exit(res.status);
    }
    if mode == "--smoke" {
        smokeUnitExit := unitTests.runUnitTestFiles(root, smokeUnitTestFiles(), 0, outputMode);
        if smokeUnitExit =!= 0 {
            io.exit(smokeUnitExit);
        }
    } else {
        unitExit := unitTests.runUnitTests(root, "", 0, outputMode);
        if unitExit =!= 0 {
            io.exit(unitExit);
        }
    }
    io.exit(res.status);
};

run(io.inputArgs());
