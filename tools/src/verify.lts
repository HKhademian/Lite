/** Standalone verifier command (`lite-verify`); forwards compiler cases or declarative manifests. */

io := import "core/io";
list := import "core/list";
text := import "core/text";
cli := import "util/cli";
project := import "util/project";

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "verifier", "verify");
    args := cli.stripLeadingSeparator(rawArgs);
    if list.listCountText(args) == 1 and text.endsWith(cli.head(args), ".json") {
        project.forwardNode("tools/test.ts", args);
    } else {
        project.forwardNode("igniter/verify.ts", args);
    }
};

run(io.inputArgs());
