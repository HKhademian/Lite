/** Standalone verifier command (`lite-verify`); verifies declarative manifests or `language/verifications`. */

io := import "core/io";
cli := import "./internal/cli";
project := import "./internal/project";
cases := import "./internal/cases";
verify := import "./internal/verify";

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "verifier", "verify");
    args := cli.stripLeadingSeparator(rawArgs);
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("lite verify: could not locate repository root");
        io.exit(1);
    }
    if args.length() == 1 and args[0].endsWith(".json") {
        io.exit(cases.runCaseCli(root, args));
    } else {
        io.exit(verify.runVerification(root, args));
    }
};

run(io.inputArgs());
