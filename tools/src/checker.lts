/** Standalone source-check command (`lite check`); compiles directly via generated TS compiler and strict-typechecks emitted TS. */

io := import "core/io";
fs := import "core/file";
proc := import "core/process";
integer := import "core/int";
text := import "core/text";
list := import "core/list";
path := import "core/path";
project := import "util/project";
cases := import "util/cases";

run := fn(rawArgs: List<String>): Unit {
    project.handleVersionFlag(rawArgs, "checker", "check");
    args: mut List<String> = rawArgs;
    builtinOpts: mut List<String> = [];
    positional: mut List<String> = [];
    loop list.listCountText(args) > 0 {
        arg := list.popFront(mut args);
        if arg == "--" {
            loop list.listCountText(args) > 0 {
                list.pushBack(mut positional, list.popFront(mut args));
            }
            break;
        } else if arg == "--builtin-mode" {
            if list.listCountText(args) == 0 or args[0] == "--" {
                io.errorLine("Usage: ./bin/lite check [--builtin-mode SPEC]... file.lts");
                io.exit(2);
            }
            list.pushBack(mut builtinOpts, arg);
            list.pushBack(mut builtinOpts, list.popFront(mut args));
        } else if text.startsWithAt(arg, 0, "--builtin-mode=") {
            list.pushBack(mut builtinOpts, arg);
        } else {
            list.pushBack(mut positional, arg);
        }
    }
    if list.listCountText(positional) =!= 1 {
        io.errorLine("Usage: ./bin/lite check [--builtin-mode SPEC]... file.lts");
        io.exit(2);
    }

    target := positional[0];
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("lite check: could not locate LiteScript repository root");
        io.exit(1);
    }

    tmpRes := fs.makeTempDir("lite-check-");
    if not tmpRes.ok {
        io.errorLine("lite check: " + tmpRes.error);
        io.exit(1);
    }
    work := tmpRes.path;

    sel := project.selectCompilerPath(root, "ts");
    if not sel.ok {
        _rm := fs.remove(work);
        io.errorLine("lite check: " + sel.error);
        io.exit(1);
    }
    compArgs: mut List<String> = [sel.path];
    loop builtinOpts as opt {
        list.pushBack(mut compArgs, opt);
    }
    list.pushBack(mut compArgs, target);
    outTsPath := path.join(work, "artifact.ts");
    errPath := path.join(work, "compile.stderr");
    emptyBytes: List<Int> = [];
    emptyEnv: List<String> = [];

    compiled := proc.runBytes(proc.execPath(), compArgs, "", emptyEnv, 0, emptyBytes, outTsPath, errPath);
    if compiled.error =!= "" {
        _rm := fs.remove(work);
        io.errorLine(target + ": " + compiled.error);
        io.exit(1);
    }
    if compiled.status =!= 0 {
        errRead := fs.readText(errPath);
        errBytes := fs.readBytes(errPath);
        _rm := fs.remove(work);
        if errRead.ok {
            project.errorText(errRead.text);
        } else {
            io.errorLine(target + ": compilation failed (" + integer.intText(list.listCountInt(errBytes)) + " stderr bytes)");
        }
        io.exit(1);
    }

    checked := cases.checkTsArtifactFile(root, outTsPath, path.join(work, "tsc"));
    _rm := fs.remove(work);
    if not checked.ok {
        io.errorLine(target + ": generated TS failed strict checking");
        project.errorText(checked.error);
        io.exit(1);
    }
};

run(io.inputArgs());
