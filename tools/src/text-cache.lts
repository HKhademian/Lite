/** Host entrypoint target for text-cache artifact comparison (`benchmark/text-cache.ts`). */

io := import "core/io";
cli := import "./internal/cli";
project := import "./internal/project";
benchUtil := import "./internal/benchmark";

run := fn(): Int {
    root := project.findRepoRoot();
    if root == "" {
        io.errorLine("could not locate LiteScript repository root");
        return 1;
    }
    args := cli.stripLeadingSeparator(io.inputArgs());
    benchUtil.runTextCacheCommand(root, args)
};

io.exit(run());
