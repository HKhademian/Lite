/** Lite CLI router (`./bin/lite`); delegates subcommands to the dedicated tool entrypoints. */

io := import "core/io";
cli := import "util/cli";
project := import "util/project";

usageText := fn(): String {
    "Usage: ./bin/lite <command> [options]\n\nCommands:\n" +
    "  check [--builtin-mode SPEC] file.lts     Check source only\n" +
    "  fmt [--check] [FILE_OR_DIR... | -]        Format Lite source files\n" +
    "  compile [--target ts|c] [-O0|-O1|-O2|-O3] [--builtin-mode SPEC] file.lts  Compile to a TS or C11 artifact\n" +
    "  build [--platform native|web|headless] [-O0|-O1|-O2|-O3] [--cc-opt -O2] [-o OUTPUT] [--keep-c] file.lts  Build a native binary or standalone HTML5 app\n" +
    "  run [--target ts|c] [-O0|-O1|-O2|-O3] [--builtin-mode SPEC] file.lts [-- argument ...]  Compile to a temporary artifact and execute it\n" +
    "  play [--target c|ts] [--scale N] [--fps N|--uncap] [--fullscreen] [--debug|--hide-bar] [--capture PNG] file.lts  Run a Play (`extra/canvas`) sample in a desktop window (F=fullscreen, F12=bar)\n" +
    "  verify [--all|--update|--coverage|--pedantic]  Verify generated TS artifacts\n" +
    "  test [--smoke|--fast|--full] [--verbose|--mute|--silence]  Fast, quiet smoke by default\n" +
    "  test --pedantic [--filter ID] [--shard i/n]  Verify & benchmark all cases across -O0..-O3\n" +
    "  docs [QUERY|--json|--check]               Browse and search documentation\n" +
    "  doctor [--docs]                           Check repository consistency\n" +
    "  test --cases [FILTER|FILE.case.json]      Run declarative cases\n" +
    "  test --unit [--jobs N] [FILTER]           Run parallel .test.lts unit tests\n" +
    "  verify FILE.case.json                     Verify one declarative manifest\n" +
    "  bench OUTPUT [FILTER]                     Benchmark verified cases\n" +
    "  release OUTPUT [TAG]                      Package a verified source snapshot\n" +
    "  bootstrap <verify|promote> [--cc CC] [--json]  Verify or promote 3-gen TS & C11 bootstrap seeds\n" +
    "  wipe [--no-install] [--no-check] [--verify]  Wipe untracked/ignored files and re-ignite\n" +
    "  help                                      Show this help\n\n" +
    "Compiler entry points: ./bin/lite-compile, ./bin/lite compile\n" +
    "Target commands: ./bin/lite-compile-ts, ./bin/lite-compile-c\n" +
    "Reserved names: ./ltl/lite link"
};

ROUTE_TARGETS: Map<String, String> = [
"check" = "lite-check",
"fmt" = "lite-fmt",
"compile" = "lite-compile",
"build" = "lite-build",
"run" = "lite-run",
"play" = "lite-run",
"verify" = "lite-verify",
"test" = "lite-test",
"docs" = "lite-docs",
"doctor" = "lite-doctor",
"bench" = "lite-bench",
"release" = "lite-release",
"bootstrap" = "lite-bootstrap",
"wipe" = "lite-wipe",
];

supportedCommands := fn(): List<String> {
    ROUTE_TARGETS.keys()
};

routeTarget := fn(command: String): String {
    ROUTE_TARGETS.getOr(command, "")
};

run := fn(rawArgs: List<String>): Unit {
    args: mut List<String> = rawArgs;
    if args.length() > 0 and args[0] == "--" {
        _sep := mut args.popFront();
    }
    project.handleVersionFlag(args, "cli", "cli");
    if args.length() == 0 {
        io.errorLine(usageText());
        io.exit(2);
    }
    commandToken := mut args.popFront();
    if commandToken == "help" or commandToken == "--help" or commandToken == "-h" {
        io.outputLine(usageText());
        io.exit(0);
    }
    command := cli.normalizeSubcommand(commandToken, supportedCommands());
    target := routeTarget(command);
    if target == "" {
        io.errorLine(usageText());
        io.exit(2);
    }
    if command == "play" {
        playArgs: mut List<String> = ["--play"];
        loop args as a {
            mut playArgs.pushBack(a);
        }
        project.forwardNode("bin/" + target, playArgs);
        return;
    }
    project.forwardNode("bin/" + target, args);
};

run(io.inputArgs());
