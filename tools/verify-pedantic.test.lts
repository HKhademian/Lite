/** Focused tests for `lite verify --pedantic` and `lite test --pedantic` across `-O0..-O3`. */

fs := import "core/file";
list := import "core/list";
path := import "core/path";
proc := import "core/process";
test := import "core/test";
text := import "core/text";
project := import "util/project";

rawRoot := project.findRepoRoot();
test.check("repo root found", rawRoot =!= "");
root := fs.realPath(rawRoot).path;

CmdResult := type (status: Int, stdout: String, stderr: String);

runLite := fn(args: List<String>): CmdResult {
    tmpRes := fs.makeTempDir("lite-ped-t-");
    test.check("makeTempDir: " + tmpRes.error, tmpRes.ok);
    outPath := path.join(tmpRes.path, "out");
    errPath := path.join(tmpRes.path, "err");
    cmdArgs: mut List<String> = [path.join(path.join(root, "bin"), "lite")];
    loop args as a {
        list.pushBack(mut cmdArgs, a);
    }
    emptyEnv: List<String> = [];
    emptyBytes: List<Int> = [];
    res := proc.runBytes(proc.execPath(), cmdArgs, root, emptyEnv, 120000, emptyBytes, outPath, errPath);
    test.check("process error: " + res.error, res.error == "");
    outText := fs.readText(outPath).text;
    errText := fs.readText(errPath).text;
    _rm := fs.remove(tmpRes.path);
    (status = res.status, stdout = outText, stderr = errText)
};

/* 1. `lite verify --pedantic --filter ...` runs all 4 opt levels and prints the benchmark summary */
vArgs: List<String> = ["verify", "--pedantic", "--filter", "feature.types.collections.typed-maps"];
vRes := runLite(vArgs);
test.checkInt("verify --pedantic exit 0", 0, vRes.status);
test.check("verify --pedantic PASS with O0..O3", text.containsText(vRes.stdout, "PASS feature.types.collections.typed-maps/map-ops-and-snapshot [O0:"));
test.check("verify --pedantic has O3 timing", text.containsText(vRes.stdout, "O3:"));
test.check("verify --pedantic prints benchmark header", text.containsText(vRes.stdout, "Pedantic optimization benchmark (") and text.containsText(vRes.stdout, "x 4 levels):"));
test.check("verify --pedantic table has -O0", text.containsText(vRes.stdout, "  -O0 "));
test.check("verify --pedantic table has -O1", text.containsText(vRes.stdout, "  -O1 "));
test.check("verify --pedantic table has -O2", text.containsText(vRes.stdout, "  -O2 "));
test.check("verify --pedantic table has -O3", text.containsText(vRes.stdout, "  -O3 "));

/* 2. `lite test --pedantic --filter ...` delegates to the pedantic runner */
tArgs: List<String> = ["test", "--pedantic", "--filter", "feature.types.collections.typed-sets"];
tRes := runLite(tArgs);
test.checkInt("test --pedantic exit 0", 0, tRes.status);
test.check("test --pedantic PASS", text.containsText(tRes.stdout, "PASS feature.types.collections.typed-sets/set-ops-and-snapshot [O0:"));
test.check("test --pedantic prints benchmark header", text.containsText(tRes.stdout, "Pedantic optimization benchmark (") and text.containsText(tRes.stdout, "x 4 levels):"));

/* 3. `lite verify --pedantic --update` is rejected cleanly */
badArgs: List<String> = ["verify", "--pedantic", "--update"];
badRes := runLite(badArgs);
test.checkInt("verify --pedantic --update rejected", 2, badRes.status);
test.check("verify --pedantic --update error message", text.containsText(badRes.stderr, "--pedantic cannot be combined with --update"));
