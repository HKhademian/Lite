{
  "name": "lite",
  "displayName": "Lite",
  "description": "Syntax highlighting, diagnostics, formatting, and run support for Lite (.lt, .lts, .lite) files.",
  "version": "0.1.1",
  "publisher": "lite-local",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:lite"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lite",
        "aliases": [
          "Lite",
          "lite"
        ],
        "extensions": [
          ".lt",
          ".lts",
          ".lite"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lite-light.svg",
          "dark": "./icons/lite-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "lite",
        "scopeName": "source.lite",
        "path": "./syntaxes/lite.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lite.checkFile",
        "title": "Lite: Check Current File"
      },
      {
        "command": "lite.runFile",
        "title": "Lite: Run Current File"
      }
    ],
    "configuration": {
      "title": "Lite",
      "properties": {
        "lite.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the lite CLI executable. Defaults to workspace ./bin/lite or lite on PATH."
        },
        "lite.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run lite check automatically when saving Lite source files."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "npm run build && node --test test/grammar.test.ts test/extension.test.ts",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out lite-0.1.1.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "type": "module"
}
